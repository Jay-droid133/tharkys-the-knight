+; BC = A * C (8x8 -> 16). Preserva DE, HL. (SP alterno: CALL/PUSH validos)
+.lbsMul:
+    PUSH HL
+    LD HL, 0
+    LD B, H
+    OR A
+    JR Z, .lbsMulEnd
+.lbsMulLoop:
+    ADD HL, BC
+    DEC A
+    JR NZ, .lbsMulLoop
+.lbsMulEnd:
