+    ; HouseIdList entera en cada sprite (~70 ids: ~2.000 T por sprite).
     PUSH AF
     PUSH HL
     PUSH BC
-
-    LD B, A                     ; B = id buscado
-
-    XOR A
-    LD (BgSpriteIsHouse), A     ; Default: no es house
-
-    LD HL, HouseIdList
-.checkLoop:
-    LD A, (HL)
-    CP $FF
-    JR Z, .checkDone            ; Terminador: no encontrado
-    CP B
-    JR Z, .checkFound
-    INC HL
-    JR .checkLoop
-
-.checkFound:
+    CALL HouseBitAddr           ; HL = &HouseBits[id >> 3], A = mascara
+    AND (HL)
