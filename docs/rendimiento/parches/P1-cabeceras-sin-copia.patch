-    CALL LoadBgSpriteToBuffer   ; preserva BC
+    CALL LoadBgSpriteHeader     ; P1: solo H/W; preserva BC
     POP HL                      ; HL @ charX
     ; Append a cache: IX = PickupRectCache + idx*4
     PUSH HL                     ; save HL @ charX
