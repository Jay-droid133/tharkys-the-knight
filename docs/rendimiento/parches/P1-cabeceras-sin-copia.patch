diff --git a/code/paging.asm b/code/paging.asm
index eed7bc0..9f12249 100644
--- a/code/paging.asm
+++ b/code/paging.asm
@@ -278,6 +278,46 @@ LoadBgSpriteToBuffer:
 .lbsBankSave: DEFB 0
 .lbsSavedSP:  DEFW 0
 
+; ==============================================================================
+; LoadBgSpriteHeader - Copia solo la cabecera (H, W|RLE) de un BgGfx_* a
+; BgSpriteBuffer+0/+1
+; ==============================================================================
+; Para quien solo necesita las dimensiones (BuildCollisionMap, CheckLockBump,
+; CheckPickupCollect, BuildPickupRectCache). ~200 T frente a los 5.000-22.000 T
+; de LoadBgSpriteToBuffer (que copia el sprite entero, 830 B si es RLE).
+; Mismo patron: SP alterno (slot 1) durante la ventana, sin DI.
+; IN:  HL = puntero al sprite ($C000-$FFFF), A = bank
+; OUT: BgSpriteBuffer+0 = height_px, +1 = width_bytes|RLE
+; Destruye: A, HL. Preserva BC, DE, IX, IY.
+; ==============================================================================
+LoadBgSpriteHeader:
+    PUSH BC
+    PUSH DE
+    LD (.lbhSavedSP), SP
+    LD SP, PagingAltStackTop
+    AND $07
+    LD E, A
+    LD A, (CurrentPaging)
+    AND $F8
+    LD D, A                         ; D = paging con bank 0
+    OR E
+    LD (CurrentPaging), A
+    LD BC, $7FFD
+    OUT (C), A
+    LD A, (HL)
+    LD (BgSpriteBuffer), A
+    INC HL
+    LD A, (HL)
+    LD (BgSpriteBuffer + 1), A
+    LD A, D
+    LD (CurrentPaging), A
+    OUT (C), A                      ; BC sigue siendo $7FFD
+    LD SP, (.lbhSavedSP)
+    POP DE
+    POP BC
+    RET
+.lbhSavedSP: DEFW 0
+
 ; ==============================================================================
 ; LoadPlazaClockPixels - Copia los 32 B de pixel data del reloj de plaza a RAM fija
 ; ==============================================================================
diff --git a/code/screen_system.asm b/code/screen_system.asm
index 48389a8..a9ce802 100644
--- a/code/screen_system.asm
+++ b/code/screen_system.asm
@@ -1507,7 +1507,7 @@ BuildCollisionMap:
     ; Cargar sprite al buffer (bank variable) para leer sus dimensiones
     EX DE, HL                   ; HL = BgGfx ptr
     LD A, (CurrentBgSpriteBank)
-    CALL LoadBgSpriteToBuffer
+    CALL LoadBgSpriteHeader   ; P1: solo H/W
     LD HL, BgSpriteBuffer
     POP BC                      ; B = x_char, C = y_char
 
@@ -1564,7 +1564,7 @@ BuildCollisionMap:
     PUSH BC                     ; charX, charY
