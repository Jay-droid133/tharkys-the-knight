 643+ E0E1              ; ---- Phase 19: HAND_OPEN_IN — anim scripted + hold + cobro ----
 644+ E0E1              ; Tabla BCS_OpenHandSeq dicta la secuencia visible (1 byte por estado:
 645+ E0E1              ; 0=frame 1, 1=frame 2). NoIdx = nº de slots COMPLETADOS hasta ahora; al
 646+ E0E1              ; entrar HAND_OPEN_IN el slot 0 (seq[0]) ya esta dibujado por PRE_HAND.
 647+ E0E1              ;
 648+ E0E1              ; Cada tick (timer=0):
 649+ E0E1              ;   - NoIdx >= LEN: hold expirado -> cobro
 650+ E0E1              ;   - NoIdx <  LEN: avanzar al siguiente slot:
 651+ E0E1              ;       leer seq[NoIdx], swap al frame indicado si != HandFrame
 652+ E0E1              ;       NoIdx++
 653+ E0E1              ;       si NoIdx == LEN: timer = HOLD (ultimo slot ya dibujado, hold estatico)
 654+ E0E1              ;       si NoIdx <  LEN: timer = SWAP
 655+ E0E1              ;
 656+ E0E1              ; Cobro: clink -> CurrentKey=0 -> erase mano -> cierra puerta -> chof
 657+ E0E1              ;   -> BCP_HAND_OPEN_OUT.
 658+ E0E1              .bcPhHandOpenIn:
 659+ E0E1 CD BC E2         CALL BankCutsceneDecTimer
 660+ E0E4 C0               RET NZ
 661+ E0E5 3A D5 82         LD A, (BankCutsceneNoIdx)
 662+ E0E8 FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 663+ E0EA 30 32            JR NC, .bcOpenInCobro                   ; anim + hold acabados -> cobro
 664+ E0EC                  ; Avanzar al siguiente slot. NoIdx ya esta en A.
