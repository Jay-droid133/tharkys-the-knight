4921+ B9EA              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4922+ B9EA              ; ==============================================================================
4923+ B9EA              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4924+ B9EA              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4925+ B9EA              ; ==============================================================================
4926+ B9EA              KillAllActiveNasties:
4927+ B9EA DD 21 0E 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4928+ B9EE 06 04            LD B, NUM_NASTIES
4929+ B9F0              .kanLoop:
4930+ B9F0 C5               PUSH BC
4931+ B9F1 DD 7E 01         LD A, (IX+ENT_TYPE)
4932+ B9F4 B7               OR A
4933+ B9F5 28 26            JR Z, .kanSkip                  ; slot vacio
4934+ B9F7 FE 03            CP TYPE_NASTY
4935+ B9F9 20 22            JR NZ, .kanSkip                 ; no es nasty
4936+ B9FB DD 7E 02         LD A, (IX+ENT_STATE)
4937+ B9FE FE 03            CP STATE_DYING
4938+ BA00 28 1B            JR Z, .kanSkip                  ; ya muriendo
4939+ BA02                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4940+ BA02                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4941+ BA02                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4942+ BA02                  ; del nasty: peDying paintea el rect del puff con ese color)
4943+ BA02 CD 26 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4944+ BA05 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4945+ BA09 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4946+ BA0D DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4947+ BA11 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4948+ BA15 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4949+ BA19 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4950+ BA1D              .kanSkip:
4951+ BA1D 11 10 00         LD DE, ENT_SIZE
4952+ BA20 DD 19            ADD IX, DE
4953+ BA22 C1               POP BC
4954+ BA23 10 CB            DJNZ .kanLoop
4955+ BA25 C9               RET
4956+ BA26
4957+ BA26              ; ==============================================================================
4958+ BA26              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4959+ BA26              ; ==============================================================================
4960+ BA26              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4961+ BA26              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4962+ BA26              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4963+ BA26              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4964+ BA26              ; deja la posicion original (puff puede asomar levemente, raro).
4965+ BA26              ; IN:  IX = nasty entity.
4966+ BA26              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4967+ BA26              ; Destruye: AF, BC, DE, HL.
4968+ BA26              ; ==============================================================================
4969+ BA26              SnapPuffPos:
4970+ BA26 DD 7E 03         LD A, (IX+ENT_POSX)
4971+ BA29 32 9C BA         LD (.sppOrigX), A
4972+ BA2C E6 F8            AND $F8
4973+ BA2E 32 9E BA         LD (.sppBaseX), A                   ; base char-aligned X
4974+ BA31 DD 7E 04         LD A, (IX+ENT_POSY)
4975+ BA34 32 9D BA         LD (.sppOrigY), A
4976+ BA37 E6 F8            AND $F8
4977+ BA39 32 9F BA         LD (.sppBaseY), A                   ; base char-aligned Y
4978+ BA3C
4979+ BA3C                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4980+ BA3C CD 70 BA         CALL .sppCheckFit
4981+ BA3F C8               RET Z
4982+ BA40
4983+ BA40                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4984+ BA40                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4985+ BA40 21 A0 BA         LD HL, .sppShifts
4986+ BA43              .sppLoop:
4987+ BA43 7E               LD A, (HL)
4988+ BA44 23               INC HL
4989+ BA45 47               LD B, A                             ; dx (signed)
4990+ BA46 7E               LD A, (HL)
4991+ BA47 23               INC HL
4992+ BA48 FE 80            CP $80
4993+ BA4A 28 17            JR Z, .sppFail                      ; sentinel
4994+ BA4C 4F               LD C, A                             ; dy (signed)
4995+ BA4D
4996+ BA4D 3A 9E BA         LD A, (.sppBaseX)
4997+ BA50 80               ADD A, B
4998+ BA51 DD 77 03         LD (IX+ENT_POSX), A
4999+ BA54 3A 9F BA         LD A, (.sppBaseY)
5000+ BA57 81               ADD A, C
5001+ BA58 DD 77 04         LD (IX+ENT_POSY), A
5002+ BA5B
5003+ BA5B E5               PUSH HL
5004+ BA5C CD 70 BA         CALL .sppCheckFit
5005+ BA5F E1               POP HL
5006+ BA60 C8               RET Z                               ; encontrado
5007+ BA61 18 E0            JR .sppLoop
5008+ BA63
5009+ BA63              .sppFail:
5010+ BA63 3A 9C BA         LD A, (.sppOrigX)
5011+ BA66 DD 77 03         LD (IX+ENT_POSX), A
5012+ BA69 3A 9D BA         LD A, (.sppOrigY)
5013+ BA6C DD 77 04         LD (IX+ENT_POSY), A
5014+ BA6F C9               RET
5015+ BA70
5016+ BA70              ; --- .sppCheckFit ---
5017+ BA70              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5018+ BA70              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5019+ BA70              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5020+ BA70              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5021+ BA70              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5022+ BA70              .sppCheckFit:
5023+ BA70                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5024+ BA70 DD 7E 03         LD A, (IX+ENT_POSX)
5025+ BA73 FE D1            CP SCREEN_MAX_X - 23
5026+ BA75 30 21            JR NC, .sppOutOfBounds
5027+ BA77 DD 7E 04         LD A, (IX+ENT_POSY)
5028+ BA7A FE 10            CP SCREEN_MIN_Y
5029+ BA7C 38 1A            JR C, .sppOutOfBounds
5030+ BA7E FE 91            CP SCREEN_MAX_Y - 23
5031+ BA80 30 16            JR NC, .sppOutOfBounds
5032+ BA82                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5033+ BA82 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5034+ BA85 32 9B BA         LD (.sppSpritIdSave), A
5035+ BA88 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5036+ BA8C CD 7A B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5037+ BA8F F5               PUSH AF
5038+ BA90 3A 9B BA         LD A, (.sppSpritIdSave)
5039+ BA93 DD 77 00         LD (IX+ENT_SPRITEID), A
5040+ BA96 F1               POP AF
5041+ BA97 C9               RET
5042+ BA98              .sppOutOfBounds:
5043+ BA98 F6 01            OR 1                                ; NZ
5044+ BA9A C9               RET
5045+ BA9B
5046+ BA9B 00           .sppSpritIdSave: DEFB 0
5047+ BA9C
5048+ BA9C 00           .sppOrigX: DEFB 0
5049+ BA9D 00           .sppOrigY: DEFB 0
5050+ BA9E 00           .sppBaseX: DEFB 0
5051+ BA9F 00           .sppBaseY: DEFB 0
5052+ BAA0              .sppShifts:
5053+ BAA0                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5054+ BAA0                  ; Distancia creciente. Sentinel: dy=$80.
5055+ BAA0 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5056+ BAA2 00 F8            DEFB 0,   -8                        ; arriba 8
5057+ BAA4 00 08            DEFB 0,    8                        ; abajo 8
5058+ BAA6 F8 00            DEFB -8,   0                        ; izq 8
5059+ BAA8 08 00            DEFB 8,    0                        ; der 8
5060+ BAAA 00 F0            DEFB 0,  -16                        ; arriba 16
5061+ BAAC 00 10            DEFB 0,   16                        ; abajo 16
5062+ BAAE F8 F8            DEFB -8,  -8
5063+ BAB0 08 F8            DEFB 8,   -8
5064+ BAB2 F8 08            DEFB -8,   8
5065+ BAB4 08 08            DEFB 8,    8
5066+ BAB6 00 80            DEFB 0,  $80                        ; sentinel
