1061+ A4C3              ; ==============================================================================
1062+ A4C3              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A4C3              ; ==============================================================================
1064+ A4C3              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A4C3              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A4C3              ; ==============================================================================
1067+ A4C3              GetSpriteAddr:
1068+ A4C3                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A4C3                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A4C3 3A 82 8D         LD A, (CurrentPaging)
1071+ A4C6 E6 F8            AND $F8
1072+ A4C8 F6 06            OR 6
1073+ A4CA 32 82 8D         LD (CurrentPaging), A
1074+ A4CD 01 FD 7F         LD BC, $7FFD
1075+ A4D0 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A4D2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A4D5 6F               LD L, A
1078+ A4D6 26 00            LD H, 0
1079+ A4D8 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A4D9 11 B7 E7         LD DE, SpriteFrameTable
1081+ A4DC 19               ADD HL, DE
1082+ A4DD 5E               LD E, (HL)
1083+ A4DE 23               INC HL
1084+ A4DF 56               LD D, (HL)
1085+ A4E0 ED 53 F2 A4      LD (SpriteAddrTemp), DE
1086+ A4E4 3A 82 8D         LD A, (CurrentPaging)
1087+ A4E7 E6 F8            AND $F8
1088+ A4E9 32 82 8D         LD (CurrentPaging), A
1089+ A4EC 01 FD 7F         LD BC, $7FFD
1090+ A4EF ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A4F1 C9               RET
1092+ A4F2
1093+ A4F2 00 00        SpriteAddrTemp: DEFW 0
1094+ A4F4
1095+ A4F4              ; ==============================================================================
1096+ A4F4              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1097+ A4F4              ; ==============================================================================
1098+ A4F4              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1099+ A4F4              ; Salida:   DE = puntero al sprite data
1100+ A4F4              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1101+ A4F4              ; Preserva: IX
1102+ A4F4              ; Destruye: A, HL
1103+ A4F4              ; ==============================================================================
1104+ A4F4              GetOldSpriteAddr:
1105+ A4F4                  ; Paging inline (ver GetSpriteAddr)
1106+ A4F4 3A 82 8D         LD A, (CurrentPaging)
1107+ A4F7 E6 F8            AND $F8
1108+ A4F9 F6 06            OR 6
1109+ A4FB 32 82 8D         LD (CurrentPaging), A
1110+ A4FE 01 FD 7F         LD BC, $7FFD
1111+ A501 ED 79            OUT (C), A
1112+ A503 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1113+ A506 6F               LD L, A
1114+ A507 26 00            LD H, 0
1115+ A509 29               ADD HL, HL
1116+ A50A 11 B7 E7         LD DE, SpriteFrameTable
1117+ A50D 19               ADD HL, DE
1118+ A50E 5E               LD E, (HL)
1119+ A50F 23               INC HL
1120+ A510 56               LD D, (HL)
1121+ A511 ED 53 7C A4      LD (OldSprAddr), DE
1122+ A515 3A 82 8D         LD A, (CurrentPaging)
1123+ A518 E6 F8            AND $F8
1124+ A51A 32 82 8D         LD (CurrentPaging), A
1125+ A51D 01 FD 7F         LD BC, $7FFD
1126+ A520 ED 79            OUT (C), A
1127+ A522 C9               RET
1128+ A523
1129+ A523              ; ==============================================================================
1130+ A523              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A523              ; ==============================================================================
1132+ A523              ; Entrada: A = SpriteID
1133+ A523              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A523              ; Destruye: A, DE, HL
1135+ A523              ; ==============================================================================
1136+ A523              GetSpriteDims:
1137+ A523                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A523                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A523 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A524 26 00            LD H, 0
1141+ A526 3A 82 8D         LD A, (CurrentPaging)
1142+ A529 E6 F8            AND $F8
1143+ A52B F6 06            OR 6
1144+ A52D 32 82 8D         LD (CurrentPaging), A
1145+ A530 01 FD 7F         LD BC, $7FFD
1146+ A533 ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A535 29               ADD HL, HL
1148+ A536 11 B7 E7         LD DE, SpriteFrameTable
1149+ A539 19               ADD HL, DE
1150+ A53A 5E               LD E, (HL)
1151+ A53B 23               INC HL
1152+ A53C 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A53D 1A               LD A, (DE)                  ; width_bytes
1154+ A53E 87               ADD A, A
1155+ A53F 87               ADD A, A
1156+ A540 87               ADD A, A                    ; × 8 = width_px
1157+ A541 47               LD B, A
1158+ A542 13               INC DE
1159+ A543 1A               LD A, (DE)                  ; height_px
1160+ A544 4F               LD C, A
1161+ A545                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A545 78               LD A, B
1163+ A546 32 63 A5         LD (GsdSavedB), A
