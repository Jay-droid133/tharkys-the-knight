 192  6DC8
 193  6DC8                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 194  6DC8                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 195  6DC8                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 196  6DC8                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 197  6DC8                  ;
 198  6DC8                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 199  6DC8                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 200  6DC8                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 201  6DC8                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 202  6DC8                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 203  6DC8                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 204  6DC8                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 6DC8              ; ==============================================================================
   2+ 6DC8              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 6DC8              ; ==============================================================================
   4+ 6DC8              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 6DC8              ; Mientras MagicCompassTimer>0:
   6+ 6DC8              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 6DC8              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 6DC8              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 6DC8              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 6DC8              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 6DC8              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 6DC8              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 6DC8              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 6DC8              ;
  15+ 6DC8              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 6DC8              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 6DC8              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 6DC8              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 6DC8              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 6DC8              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 6DC8              ;
  22+ 6DC8              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 6DC8              ; ==============================================================================
  24+ 6DC8
  25+ 6DC8              ; ==============================================================================
  26+ 6DC8              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 6DC8              ; ==============================================================================
  28+ 6DC8              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 6DC8              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 6DC8              ; Destruye: AF, HL.
  31+ 6DC8              ; ==============================================================================
  32+ 6DC8              ApplyMagicCompassBuff:
  33+ 6DC8 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 6DCB 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 6DCE 3E 01            LD A, 1
  36+ 6DD0 32 C3 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 6DD3 AF               XOR A
  38+ 6DD4 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 6DD7 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 6DD9 32 C5 5F         LD (MagicCompassTickCounter), A
  41+ 6DDC                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  42+ 6DDC                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  43+ 6DDC                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  44+ 6DDC                  ; el futuro se quiere reactivar.
  45+ 6DDC 3E FF            LD A, $FF
  46+ 6DDE 32 C6 5F         LD (MagicCompassJingleIdx), A
  47+ 6DE1                  ; SFX al recoger: sweep ascendente AY canal B. Lasting tiene PIN extra.
  48+ 6DE1 3A C7 82         LD A, (MagicCompassPermanent)
  49+ 6DE4 B7               OR A
  50+ 6DE5 C2 DB 6B         JP NZ, AY_PlayLastingPickup         ; lasting: sweep largo + PIN (~1.12s)
  51+ 6DE8 C3 D0 6B         JP AY_PlayCompassPickup             ; random: sweep corto (~640ms)
  52+ 6DEB
  53+ 6DEB              ; ==============================================================================
  54+ 6DEB              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  55+ 6DEB              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  56+ 6DEB              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  57+ 6DEB              ; ==============================================================================
  58+ 6DEB              ; Entry points:
  59+ 6DEB              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  60+ 6DEB              ;                           muerte / hito cumplido / llegar a sala destino,
  61+ 6DEB              ;                           sites que no saben si la brujula estaba activa.
  62+ 6DEB              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  63+ 6DEB              ;                           por el branch del timeout natural (Timer ya es 0
  64+ 6DEB              ;                           tras el DEC, asi que el check daria RET Z falso
  65+ 6DEB              ;                           positivo y se saltaria el cleanup).
  66+ 6DEB              ; ==============================================================================
  67+ 6DEB              CancelMagicCompass:
  68+ 6DEB 3A C7 82         LD A, (MagicCompassPermanent)
  69+ 6DEE B7               OR A
  70+ 6DEF C0               RET NZ                               ; lasting compass: nunca cancelar
  71+ 6DF0 3A BF 5F         LD A, (MagicCompassTimer)
  72+ 6DF3 47               LD B, A
  73+ 6DF4 3A C0 5F         LD A, (MagicCompassTimer + 1)
  74+ 6DF7 B0               OR B
  75+ 6DF8 C8               RET Z                                ; ya inactivo
  76+ 6DF9                  ; fall through al cleanup compartido
  77+ 6DF9              _DoCancelMagicCompass:
  78+ 6DF9 AF               XOR A
  79+ 6DFA 32 BF 5F         LD (MagicCompassTimer), A
  80+ 6DFD 32 C0 5F         LD (MagicCompassTimer + 1), A
  81+ 6E00 32 C5 5F         LD (MagicCompassTickCounter), A
  82+ 6E03 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  83+ 6E06 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  84+ 6E09 3E FF            LD A, $FF
  85+ 6E0B 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  86+ 6E0E 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  87+ 6E11 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  88+ 6E14 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  89+ 6E17 32 BC 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  90+ 6E1A                                                       ; frame: DrawCompass detecta $FF y
  91+ 6E1A                                                       ; entra a .dcRedraw, sustituyendo el
  92+ 6E1A                                                       ; sprite_compass_magic stale por la
  93+ 6E1A                                                       ; brujula clasica (8 flechas + X).
  94+ 6E1A C9               RET
