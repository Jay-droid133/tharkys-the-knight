 423+ F134              ; ==============================================================================
 424+ F134              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F134              ; ==============================================================================
 426+ F134              ; Formato:
 427+ F134              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F134              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F134              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F134              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F134              ; ==============================================================================
 432+ F134              DrawMilestoneHUD:
 433+ F134 3A BF 82         LD A, (CurrentObjective)
 434+ F137 FE 0B            CP 11
 435+ F139 28 26            JR Z, .mhAllDone
 436+ F13B 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F13C 06 00            LD B, 0                     ; B = decenas
 438+ F13E              .mhDivLoop:
 439+ F13E FE 0A            CP 10
 440+ F140 38 05            JR C, .mhDivDone
 441+ F142 D6 0A            SUB 10
 442+ F144 04               INC B
 443+ F145 18 F7            JR .mhDivLoop
 444+ F147              .mhDivDone:
 445+ F147 F5               PUSH AF                     ; A = unidades
 446+ F148 78               LD A, B
 447+ F149 B7               OR A
 448+ F14A 20 04            JR NZ, .mhTensDigit
 449+ F14C 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F14E 18 02            JR .mhWriteTens
 451+ F150              .mhTensDigit:
 452+ F150 C6 30            ADD A, '0'
 453+ F152              .mhWriteTens:
 454+ F152 1E 1E            LD E, 30
 455+ F154 CD 3A E7         CALL DrawHudCharRow0
 456+ F157 F1               POP AF                      ; A = unidades
 457+ F158 C6 30            ADD A, '0'
 458+ F15A 1E 1F            LD E, 31
 459+ F15C CD 3A E7         CALL DrawHudCharRow0
 460+ F15F 18 0E            JR .mhAttrs
 461+ F161              .mhAllDone:
 462+ F161 3E 4F            LD A, 'O'
 463+ F163 1E 1E            LD E, 30
 464+ F165 CD 3A E7         CALL DrawHudCharRow0
 465+ F168 3E 4B            LD A, 'K'
 466+ F16A 1E 1F            LD E, 31
 467+ F16C CD 3A E7         CALL DrawHudCharRow0
 468+ F16F              .mhAttrs:
 469+ F16F 3E 47            LD A, $47                   ; bright white
 470+ F171 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F174 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F177 C9               RET
