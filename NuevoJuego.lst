1165+ E253 F9 FF F8 FF      DEFB $F9,$FF, $F8,$FF, $FC,$7F, $FE,$FF
1165+ E257 FC 7F FE FF
1166+ E25B F9 BF F8 9F      DEFB $F9,$BF, $F8,$9F, $E4,$8F, $E3,$CF
1166+ E25F E4 8F E3 CF
1167+ E263 F3 0F FC 1F      DEFB $F3,$0F, $FC,$1F, $F8,$1F, $FC,$3F
1167+ E267 F8 1F FC 3F
1168+ E26B FF FF F0 17      DEFB $FF,$FF, $F0,$17, $F0,$0F, $FF,$FF
1168+ E26F F0 0F FF FF
1169+ E273
1170+ E273              BgGfx_BankHandFrame1:
