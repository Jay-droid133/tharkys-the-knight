1821+ F88B
1822+ F88B              ; ==============================================================================
1823+ F88B              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1824+ F88B              ;                     debe salir (magic compass activa).
1825+ F88B              ; ==============================================================================
1826+ F88B              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1827+ F88B              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1828+ F88B              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1829+ F88B              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1830+ F88B              ; el viejo porque DrawScreen ya repinta BG limpio.
1831+ F88B              ;
1832+ F88B              ; Llamada cada frame desde MainLoop tras DrawCompass.
1833+ F88B              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1834+ F88B              ; ==============================================================================
1835+ F88B              DrawCompassGapHint:
1836+ F88B                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1837+ F88B                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1838+ F88B                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1839+ F88B                  ; produciendo el parpadeo sincronizado con el tic AY.
1840+ F88B 2A BF 5F         LD HL, (MagicCompassTimer)
1841+ F88E 7C               LD A, H
1842+ F88F B5               OR L
1843+ F890 28 7B            JR Z, .dcghHide
1844+ F892 3A C1 5F         LD A, (MagicCompassPathDir)
1845+ F895 3C               INC A                               ; A=0 si era $FF
1846+ F896 28 75            JR Z, .dcghHide
1847+ F898 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1848+ F89B B7               OR A
1849+ F89C 28 6F            JR Z, .dcghHide
1850+ F89E
1851+ F89E                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1852+ F89E 21 C1 F9         LD HL, HintLastDir
1853+ F8A1 7E               LD A, (HL)
1854+ F8A2 47               LD B, A
1855+ F8A3 3A C1 5F         LD A, (MagicCompassPathDir)
1856+ F8A6 B8               CP B
1857+ F8A7 20 1A            JR NZ, .dcghDraw
1858+ F8A9 23               INC HL
1859+ F8AA 7E               LD A, (HL)
1860+ F8AB 47               LD B, A
1861+ F8AC 3A C2 5F         LD A, (MagicCompassPathCoord)
1862+ F8AF B8               CP B
1863+ F8B0 20 11            JR NZ, .dcghDraw
1864+ F8B2 23               INC HL
1865+ F8B3 7E               LD A, (HL)
1866+ F8B4 47               LD B, A
1867+ F8B5 3A 10 83         LD A, (CurrentScreenX)
1868+ F8B8 B8               CP B
1869+ F8B9 20 08            JR NZ, .dcghDraw
1870+ F8BB 23               INC HL
1871+ F8BC 7E               LD A, (HL)
1872+ F8BD 47               LD B, A
1873+ F8BE 3A 11 83         LD A, (CurrentScreenY)
1874+ F8C1 B8               CP B
1875+ F8C2 C8               RET Z                               ; sin cambio -> nada que hacer
1876+ F8C3
1877+ F8C3              .dcghDraw:
1878+ F8C3                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1879+ F8C3                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1880+ F8C3 3A C1 F9         LD A, (HintLastDir)
1881+ F8C6 FE FF            CP $FF
1882+ F8C8 28 1F            JR Z, .dcghDrawNew
1883+ F8CA 3A C3 F9         LD A, (HintLastScreenX)
1884+ F8CD 47               LD B, A
1885+ F8CE 3A 10 83         LD A, (CurrentScreenX)
1886+ F8D1 B8               CP B
1887+ F8D2 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1888+ F8D4 3A C4 F9         LD A, (HintLastScreenY)
1889+ F8D7 47               LD B, A
1890+ F8D8 3A 11 83         LD A, (CurrentScreenY)
1891+ F8DB B8               CP B
1892+ F8DC 20 0B            JR NZ, .dcghDrawNew
1893+ F8DE 3A C1 F9         LD A, (HintLastDir)
1894+ F8E1 47               LD B, A
1895+ F8E2 3A C2 F9         LD A, (HintLastCoord)
1896+ F8E5 4F               LD C, A
1897+ F8E6 CD 64 F9         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1898+ F8E9              .dcghDrawNew:
1899+ F8E9 3A C1 5F         LD A, (MagicCompassPathDir)
1900+ F8EC 47               LD B, A
1901+ F8ED 3A C2 5F         LD A, (MagicCompassPathCoord)
1902+ F8F0 4F               LD C, A
1903+ F8F1 CD 57 F9         CALL DrawHintAtPos
1904+ F8F4                  ; Update cache
1905+ F8F4 3A C1 5F         LD A, (MagicCompassPathDir)
1906+ F8F7 32 C1 F9         LD (HintLastDir), A
1907+ F8FA 3A C2 5F         LD A, (MagicCompassPathCoord)
1908+ F8FD 32 C2 F9         LD (HintLastCoord), A
1909+ F900 3A 10 83         LD A, (CurrentScreenX)
1910+ F903 32 C3 F9         LD (HintLastScreenX), A
1911+ F906 3A 11 83         LD A, (CurrentScreenY)
1912+ F909 32 C4 F9         LD (HintLastScreenY), A
1913+ F90C C9               RET
1914+ F90D
1915+ F90D              .dcghHide:
1916+ F90D                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1917+ F90D 3A C1 F9         LD A, (HintLastDir)
1918+ F910 FE FF            CP $FF
1919+ F912 C8               RET Z
1920+ F913 3A C3 F9         LD A, (HintLastScreenX)
1921+ F916 47               LD B, A
1922+ F917 3A 10 83         LD A, (CurrentScreenX)
1923+ F91A B8               CP B
1924+ F91B 20 15            JR NZ, .dcghHideInvalidate
1925+ F91D 3A C4 F9         LD A, (HintLastScreenY)
1926+ F920 47               LD B, A
1927+ F921 3A 11 83         LD A, (CurrentScreenY)
1928+ F924 B8               CP B
1929+ F925 20 0B            JR NZ, .dcghHideInvalidate
1930+ F927 3A C1 F9         LD A, (HintLastDir)
1931+ F92A 47               LD B, A
1932+ F92B 3A C2 F9         LD A, (HintLastCoord)
1933+ F92E 4F               LD C, A
1934+ F92F CD 64 F9         CALL EraseHintAtPos                 ; XOR + restore attrs
1935+ F932              .dcghHideInvalidate:
1936+ F932 3E FF            LD A, $FF
1937+ F934 32 C1 F9         LD (HintLastDir), A
1938+ F937 C9               RET
1939+ F938
1940+ F938              ; ==============================================================================
1941+ F938              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1942+ F938              ; ==============================================================================
1943+ F938              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1944+ F938              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1945+ F938              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1946+ F938              ;
1947+ F938              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1948+ F938              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1949+ F938              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1950+ F938              ; la zona de atributos ($5800+).
1951+ F938              ; Destruye: A.
1952+ F938              ; ==============================================================================
1953+ F938              ComputeHintPos:
1954+ F938 78               LD A, B
1955+ F939 B7               OR A
1956+ F93A 28 0A            JR Z, .chpNorth                     ; 0 = N
1957+ F93C 3D               DEC A
1958+ F93D 28 0B            JR Z, .chpSouth                     ; 1 = S
1959+ F93F 3D               DEC A
1960+ F940 28 0C            JR Z, .chpWest                      ; 2 = W
1961+ F942                  ; Fall-through: 3 = E
1962+ F942 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1963+ F944 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1964+ F946              .chpNorth:
1965+ F946 41               LD B, C                             ; charX = coord
1966+ F947 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1967+ F949 C9               RET
1968+ F94A              .chpSouth:
1969+ F94A 41               LD B, C
1970+ F94B 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1971+ F94D C9               RET
1972+ F94E              .chpWest:
1973+ F94E 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1974+ F950                  ; fall-through a .chpVertShift
1975+ F950              .chpVertShift:
1976+ F950                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1977+ F950                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1978+ F950                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1979+ F950 79               LD A, C
1980+ F951 FE 07            CP 7
1981+ F953 D8               RET C                               ; coord < 7: gap superior, charY = coord
