 697+ A508                  ; --- Shake ---
 698+ A508 CD 39 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 699+ A50B 5F               LD E, A
 700+ A50C 16 00            LD D, 0
 701+ A50E 21 93 90         LD HL, MonsterAiFlags
 702+ A511 19               ADD HL, DE
 703+ A512 7E               LD A, (HL)
 704+ A513 CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 705+ A515 20 15            JR NZ, .peShakeActive
 706+ A517                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 707+ A517 F6 08            OR MAI_FLAG_SHAKE_SAVED
 708+ A519 77               LD (HL), A
 709+ A51A 21 97 5F         LD HL, MonsterShakeOrigX
 710+ A51D 19               ADD HL, DE
 711+ A51E DD 7E 03         LD A, (IX+ENT_POSX)
 712+ A521 77               LD (HL), A
 713+ A522 21 9A 5F         LD HL, MonsterShakeOrigY
 714+ A525 19               ADD HL, DE
