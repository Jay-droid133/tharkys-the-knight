1574+ 9B3F
1575+ 9B3F                  ; Timer expirado → avanzar frame
1576+ 9B3F DD 71 09         LD (IX+ENT_ANIMTIMER), C    ; Reset timer
1577+ 9B42
1578+ 9B42                  ; Paso: si el player esta corriendo, reproducir "tic-tac" alternado
1579+ 9B42 DD 7E 02         LD A, (IX+ENT_STATE)
1580+ 9B45 FE 01            CP STATE_RUNNING
