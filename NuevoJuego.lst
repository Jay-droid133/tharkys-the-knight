 437+ E4AB                  ; --- ',' en col 2 ---
 438+ E4AB 3E 2C            LD A, ','
 439+ E4AD 1E 02            LD E, 2
 440+ E4AF CD 4E E6         CALL DrawHudChar
 441+ E4B2
 442+ E4B2                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E4B2 3A 09 83         LD A, (CurrentScreenY)
 444+ E4B5 1E 03            LD E, 3
 445+ E4B7 CD 06 E5         CALL .drawDec2
 446+ E4BA
 447+ E4BA                  ; --- ':' en col 5 ---
 448+ E4BA 3E 3A            LD A, ':'
 449+ E4BC 1E 05            LD E, 5
 450+ E4BE CD 4E E6         CALL DrawHudChar
 451+ E4C1
 452+ E4C1                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E4C1 3A 09 83         LD A, (CurrentScreenY)
 454+ E4C4 6F               LD L, A
 455+ E4C5 26 00            LD H, 0
 456+ E4C7 29               ADD HL, HL
 457+ E4C8 29               ADD HL, HL
 458+ E4C9 29               ADD HL, HL
 459+ E4CA 29               ADD HL, HL                  ; HL = Y * 16
 460+ E4CB 3A 08 83         LD A, (CurrentScreenX)
 461+ E4CE 5F               LD E, A
 462+ E4CF 16 00            LD D, 0
 463+ E4D1 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E4D2 11 EA DD         LD DE, MapTable
 465+ E4D5 19               ADD HL, DE
 466+ E4D6 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E4D7 F5               PUSH AF                     ; guardar room index
 468+ E4D8
 469+ E4D8                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E4D8 F5               PUSH AF
 471+ E4D9 0F               RRCA
 472+ E4DA 0F               RRCA
 473+ E4DB 0F               RRCA
 474+ E4DC 0F               RRCA
 475+ E4DD E6 0F            AND $0F
 476+ E4DF CD 24 E5         CALL .hexToAscii
 477+ E4E2 1E 06            LD E, 6
 478+ E4E4 CD 4E E6         CALL DrawHudChar
 479+ E4E7 F1               POP AF
 480+ E4E8 E6 0F            AND $0F
 481+ E4EA CD 24 E5         CALL .hexToAscii
 482+ E4ED 1E 07            LD E, 7
 483+ E4EF CD 4E E6         CALL DrawHudChar
