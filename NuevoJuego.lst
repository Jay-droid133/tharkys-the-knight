4841+ BC6C 32 F6 82         LD (LastSpawnDirSigns), A
4842+ BC6F
4843+ BC6F                  ; Inicializar old pos = pos actual
4844+ BC6F DD 7E 03         LD A, (IX+ENT_POSX)
