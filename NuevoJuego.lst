  89+ 6E78 DD E7            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  90+ 6E7A 06 E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  91+ 6E7C 23 F1            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
