2571+ D9C7 32 D8 E2         LD (BgSpriteIsHouse), A
2572+ D9CA CD 25 DC         CALL DrawBgAttrOnly
2573+ D9CD C1               POP BC
2574+ D9CE E1               POP HL                          ; HL en ptr_lo
2575+ D9CF                  ; Forzar medianoche al abrir iglesia: garantizar que la transicion a N2
2576+ D9CF                  ; (bells + windows off + monster spawn + statue blink) sucede SIEMPRE,
2577+ D9CF                  ; incluso si BellsTriggered=1 por bells naturales de noches anteriores.
2578+ D9CF                  ; Antes condicionabamos por BellsTriggered, lo que hacia que abrir la
2579+ D9CF                  ; iglesia en dia 2+ solo encendiese la statue sin re-disparar la noche.
2580+ D9CF E5               PUSH HL
2581+ D9D0 3A D3 E2         LD A, (CurrentTimeOfDay)
2582+ D9D3 FE 04            CP 4
2583+ D9D5 28 09            JR Z, .cbtChurchAlreadyN2           ; ya en N2 (bells sonaron esta noche): solo statue blink
2584+ D9D7 AF               XOR A
2585+ D9D8 32 B9 82         LD (BellsTriggered), A              ; reset para forzar re-trigger fresh
2586+ D9DB CD 28 E3         CALL TriggerChurchMidnight          ; warp a 00:00 + bells + UpdateBellsDoneTimer encadena el resto
2587+ D9DE 18 03            JR .cbtChurchTriggerDone
2588+ D9E0              .cbtChurchAlreadyN2:
2589+ D9E0 CD FF F2         CALL StartStatueBlink               ; bells naturales ya sonaron + estamos en N2: encender ya
2590+ D9E3              .cbtChurchTriggerDone:
2591+ D9E3 E1               POP HL
2592+ D9E4 C3 E7 D9         JP .cbtAdvanceAfterAction
2593+ D9E7              .cbtAdvanceAfterAction:
2594+ D9E7                  ; HL en ptr_lo. Skip 5 (ptr+charX+charY+tint = next mapX).
2595+ D9E7 11 05 00         LD DE, 5
2596+ D9EA 19               ADD HL, DE
2597+ D9EB C3 98 D8         JP .cbtLoop
2598+ D9EE              .cbtPopNext:
2599+ D9EE E1               POP HL                          ; recuperar entry pointer (ptr_lo)
2600+ D9EF              .cbtSkipPtr:
2601+ D9EF                  ; HL en ptr_lo. Skip 5 al siguiente mapX.
2602+ D9EF 11 05 00         LD DE, 5
2603+ D9F2 19               ADD HL, DE
2604+ D9F3 C3 98 D8         JP .cbtLoop
2605+ D9F6              .cbtSkipMapY:
2606+ D9F6                  ; HL en mapY. Skip 6 al siguiente mapX.
2607+ D9F6 11 06 00         LD DE, 6
2608+ D9F9 19               ADD HL, DE
2609+ D9FA C3 98 D8         JP .cbtLoop
2610+ D9FD              .cbtSkipInactive:
