 967+ 9209              ; MaiGetEntrySide
 968+ 9209              ; ==============================================================================
 969+ 9209              ; Traduce ScreenTransition (direccion en la que se movio el player al cruzar
 970+ 9209              ; el borde) al side de ENTRADA en el nuevo room (el borde opuesto).
 971+ 9209              ;
 972+ 9209              ;   DIR_N (player fue al norte) → SIDE_S (entro por el sur del nuevo room)
 973+ 9209              ;   DIR_S → SIDE_N
 974+ 9209              ;   DIR_E → SIDE_W
 975+ 9209              ;   DIR_W → SIDE_E
 976+ 9209              ;
 977+ 9209              ; OUT: A = MAI_SIDE_N/S/W/E o $FF si no hay transicion activa.
 978+ 9209              ; ==============================================================================
