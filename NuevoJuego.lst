# file closed: milestones.asm
 495  F750                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 496  F750                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F750              ; ==============================================================================
   2+ F750              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F750              ; ==============================================================================
   4+ F750              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F750              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F750              ;
   7+ F750              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F750              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F750              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F750              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F750              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F750              ; ==============================================================================
  13+ F750
  14+ F750              ; ==============================================================================
  15+ F750              ; PlaySFX - Reproduce un efecto de sonido
  16+ F750              ; ==============================================================================
  17+ F750              ; Entrada: HL = puntero a datos del efecto
  18+ F750              ; Modifica: AF, BC, DE, HL
  19+ F750              ; ==============================================================================
  20+ F750              PlaySFX:
  21+ F750 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F751 3A 83 8D         LD A, (CurrentBorderColor)
  23+ F754 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F756 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F757
  26+ F757              .nextStep:
  27+ F757 7E               LD A, (HL)                  ; Leer duration
  28+ F758 B7               OR A
  29+ F759 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F75B
  31+ F75B 47               LD B, A                     ; B = duration (bucle externo)
  32+ F75C 23               INC HL
  33+ F75D 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F75E 23               INC HL
  35+ F75F 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F760 23               INC HL
  37+ F761 7E               LD A, (HL)                  ; A = flags
  38+ F762 23               INC HL
  39+ F763 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F764 CB 47            BIT 0, A
  41+ F766 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F768
  43+ F768              ; --- Bucle de tono normal ---
  44+ F768              .toneLoop:
  45+ F768                  ; Semi-periodo HIGH
  46+ F768 7B               LD A, E
  47+ F769 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F76B D3 FE            OUT ($FE), A
  49+ F76D 79               LD A, C                     ; A = pitch actual
  50+ F76E              .toneDelayHi:
  51+ F76E 3D               DEC A
  52+ F76F 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F771
  54+ F771                  ; Semi-periodo LOW
  55+ F771 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F772 D3 FE            OUT ($FE), A
  57+ F774 79               LD A, C
  58+ F775              .toneDelayLo:
  59+ F775 3D               DEC A
  60+ F776 20 FD            JR NZ, .toneDelayLo
  61+ F778
  62+ F778                  ; Aplicar pitch sweep
  63+ F778 79               LD A, C
  64+ F779 82               ADD A, D                    ; pitch += pitchDelta
  65+ F77A 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F77C FA 84 F7         JP M, .toneClamp            ; evitar pitch negativo
  67+ F77F 4F               LD C, A
  68+ F780              .toneAfterClamp:
  69+ F780 10 E6            DJNZ .toneLoop
  70+ F782 18 30            JR .stepDone
  71+ F784
  72+ F784              .toneClamp:
  73+ F784 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F786 18 F8            JR .toneAfterClamp
  75+ F788
  76+ F788              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F788              .noiseLoop:
  78+ F788                  ; Semi-periodo HIGH con ruido
  79+ F788 7B               LD A, E
  80+ F789 F6 10            OR $10
  81+ F78B D3 FE            OUT ($FE), A
  82+ F78D ED 5F            LD A, R                     ; R register como PRNG
  83+ F78F A9               XOR C                       ; mezclar con pitch base
  84+ F790 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F792 F6 01            OR $01                      ; minimo 1
  86+ F794              .noiseDelayHi:
  87+ F794 3D               DEC A
  88+ F795 20 FD            JR NZ, .noiseDelayHi
  89+ F797
  90+ F797                  ; Semi-periodo LOW
  91+ F797 7B               LD A, E
  92+ F798 D3 FE            OUT ($FE), A
  93+ F79A ED 5F            LD A, R
  94+ F79C A9               XOR C
  95+ F79D E6 1F            AND $1F
  96+ F79F F6 01            OR $01
  97+ F7A1              .noiseDelayLo:
  98+ F7A1 3D               DEC A
  99+ F7A2 20 FD            JR NZ, .noiseDelayLo
 100+ F7A4
 101+ F7A4                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F7A4 79               LD A, C
 103+ F7A5 82               ADD A, D
 104+ F7A6 28 08            JR Z, .noiseClamp
 105+ F7A8 FA B0 F7         JP M, .noiseClamp
 106+ F7AB 4F               LD C, A
 107+ F7AC              .noiseAfterClamp:
 108+ F7AC 10 DA            DJNZ .noiseLoop
 109+ F7AE 18 04            JR .stepDone
 110+ F7B0
 111+ F7B0              .noiseClamp:
 112+ F7B0 0E 01            LD C, 1
 113+ F7B2 18 F8            JR .noiseAfterClamp
 114+ F7B4
 115+ F7B4              .stepDone:
 116+ F7B4 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F7B5 18 A0            JR .nextStep
 118+ F7B7
 119+ F7B7              .done:
 120+ F7B7 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F7B8 D3 FE            OUT ($FE), A
 122+ F7BA FB               EI
 123+ F7BB C9               RET
 124+ F7BC
 125+ F7BC              ; ==============================================================================
 126+ F7BC              ; DATOS DE EFECTOS DE SONIDO
 127+ F7BC              ; ==============================================================================
