 124+ EC94              ; UpdateGameClock
 125+ EC94              ; ==============================================================================
 126+ EC94              UpdateGameClock:
 127+ EC94 3A 57 82         LD A, (TimeFrozen)
 128+ EC97 B7               OR A
 129+ EC98 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EC99 21 FA EA         LD HL, GameSubMinute
 131+ EC9C 34               INC (HL)
 132+ EC9D 3A FD EA         LD A, (SubMinuteMax)
 133+ ECA0 BE               CP (HL)
 134+ ECA1 C0               RET NZ
 135+ ECA2
 136+ ECA2 AF               XOR A
 137+ ECA3 32 FA EA         LD (GameSubMinute), A
 138+ ECA6 21 FB EA         LD HL, GameMinutes
 139+ ECA9 34               INC (HL)
 140+ ECAA                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ ECAA                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ ECAA 3A FB EA         LD A, (GameMinutes)
 143+ ECAD FE 3C            CP 60
 144+ ECAF C0               RET NZ
 145+ ECB0
 146+ ECB0 AF               XOR A
 147+ ECB1 32 FB EA         LD (GameMinutes), A
 148+ ECB4 21 FC EA         LD HL, GameHours
 149+ ECB7 34               INC (HL)
 150+ ECB8 7E               LD A, (HL)
 151+ ECB9 FE 18            CP 24
 152+ ECBB 20 04            JR NZ, .checkPhase
 153+ ECBD AF               XOR A
 154+ ECBE 32 FC EA         LD (GameHours), A
 155+ ECC1
 156+ ECC1              .checkPhase:
 157+ ECC1 3A FC EA         LD A, (GameHours)
 158+ ECC4 21 06 EB         LD HL, PhaseTable
 159+ ECC7 06 07            LD B, 7
 160+ ECC9              .phaseLoop:
 161+ ECC9 BE               CP (HL)
 162+ ECCA 28 05            JR Z, .phaseFound
 163+ ECCC 23               INC HL
 164+ ECCD 23               INC HL
 165+ ECCE 10 F9            DJNZ .phaseLoop
 166+ ECD0 C9               RET
 167+ ECD1              .phaseFound:
 168+ ECD1 23               INC HL
 169+ ECD2 7E               LD A, (HL)
 170+ ECD3 F5               PUSH AF
 171+ ECD4 CD 9F E4         CALL SetTimeOfDay
 172+ ECD7 F1               POP AF
 173+ ECD8 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ ECDA C0               RET NZ
 175+ ECDB                  ; Nuevo dia: incrementar ciclo
 176+ ECDB 21 D3 BF         LD HL, DayCycleCount
 177+ ECDE 34               INC (HL)
 178+ ECDF C9               RET
 179+ ECE0
 180+ ECE0              ; ==============================================================================
