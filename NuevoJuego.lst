4340+ BAA6                  ; Color segun tipo (cada tipo tiene color fijo)
4341+ BAA6 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4342+ BAA9 21 69 BD         LD HL, NastyColorTable
4343+ BAAC D5               PUSH DE
4344+ BAAD 11 20 00         LD DE, SPRID_ENEMY_0
4345+ BAB0 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4346+ BAB1 CB 3F            SRL A
4347+ BAB3 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4348+ BAB5 5F               LD E, A
4349+ BAB6 16 00            LD D, 0
4350+ BAB8 19               ADD HL, DE
4351+ BAB9 7E               LD A, (HL)
4352+ BABA D1               POP DE
