 329+ 7427                  ; Tick sonando: override del char activo a MAGIC_COMPASS_ACTIVE_ATTR
 330+ 7427                  ; ($47 = white bright). Los pixels del sprite los pinta el editor;
 331+ 7427                  ; para que la silueta no se "invierta" al cambiar paper/ink, diseña
 332+ 7427                  ; el char correspondiente con paper black + ink negro (la silueta vive
 333+ 7427                  ; en los píxeles encendidos, que pasan a ink white bright en el flash).
 334+ 7427 3A C1 5F         LD A, (MagicCompassPathDir)
 335+ 742A 5F               LD E, A
 336+ 742B 16 00            LD D, 0
 337+ 742D 21 3D 74         LD HL, .pmcaDirToOffset
 338+ 7430 19               ADD HL, DE
 339+ 7431 7E               LD A, (HL)
 340+ 7432 5F               LD E, A
 341+ 7433 16 00            LD D, 0
 342+ 7435 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 343+ 7438 19               ADD HL, DE                           ; HL = addr del char activo (attr area)
 344+ 7439 3E 47            LD A, MAGIC_COMPASS_ACTIVE_ATTR
 345+ 743B 77               LD (HL), A
