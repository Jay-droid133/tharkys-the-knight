4912+ BA22              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4913+ BA22              ; ==============================================================================
4914+ BA22              UpdateEnemySpeed:
4915+ BA22 3A 24 BD         LD A, (DayCycleCount)
4916+ BA25 3D               DEC A                               ; 0-based index
4917+ BA26 FE 0A            CP 10
4918+ BA28 38 02            JR C, .uesOk
4919+ BA2A 3E 09            LD A, 9                             ; Cap en indice 9
4920+ BA2C              .uesOk:
4921+ BA2C F5               PUSH AF                             ; Guardar indice para tabla de anim
4922+ BA2D 21 50 BA         LD HL, EnemySpeedTable
4923+ BA30 5F               LD E, A
4924+ BA31 16 00            LD D, 0
4925+ BA33 19               ADD HL, DE
4926+ BA34 7E               LD A, (HL)                          ; A = velocidad × 2
4927+ BA35                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4928+ BA35 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4929+ BA37 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4930+ BA39                  ; Hay fraccion .5: alternar +1 en frames impares
4931+ BA39 47               LD B, A                             ; B = parte entera
4932+ BA3A 3A A0 81         LD A, (GameFrameCounter)
4933+ BA3D E6 01            AND 1                               ; 0 en par, 1 en impar
4934+ BA3F 80               ADD A, B                            ; Sumar 0 o 1
4935+ BA40              .uesNoFrac:
4936+ BA40 32 5D 8D         LD (CurrentEnemySpeed), A
4937+ BA43                  ; Leer delay de animacion para este ciclo
4938+ BA43 F1               POP AF                              ; A = indice 0-based
4939+ BA44 21 5A BA         LD HL, EnemyAnimDelayTable
4940+ BA47 5F               LD E, A
4941+ BA48 16 00            LD D, 0
4942+ BA4A 19               ADD HL, DE
4943+ BA4B 7E               LD A, (HL)
4944+ BA4C 32 5E 8D         LD (CurrentEnemyAnimDelay), A
4945+ BA4F C9               RET
4946+ BA50
4947+ BA50              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4948+ BA50              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4949+ BA50              EnemySpeedTable:
4950+ BA50 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4951+ BA51 05               DEFB 5                              ; Ciclo 2: 2.5px
4952+ BA52 06               DEFB 6                              ; Ciclo 3: 3px
4953+ BA53 07               DEFB 7                              ; Ciclo 4: 3.5px
4954+ BA54 08               DEFB 8                              ; Ciclo 5: 4px
4955+ BA55 09               DEFB 9                              ; Ciclo 6: 4.5px
4956+ BA56 0A               DEFB 10                             ; Ciclo 7: 5px
4957+ BA57 0B               DEFB 11                             ; Ciclo 8: 5.5px
4958+ BA58 0C               DEFB 12                             ; Ciclo 9: 6px
4959+ BA59 0E               DEFB 14                             ; Ciclo 10: 7px
4960+ BA5A
4961+ BA5A              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4962+ BA5A              ; La rata usara la mitad de estos valores
4963+ BA5A              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4964+ BA5A 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4965+ BA5B 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4966+ BA5C 03               DEFB 3                              ; Ciclo 3 (era 6)
4967+ BA5D 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4968+ BA5E 02               DEFB 2                              ; Ciclo 5 (era 4)
4969+ BA5F 02               DEFB 2                              ; Ciclo 6 (era 4)
4970+ BA60 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4971+ BA61 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4972+ BA62 01               DEFB 1                              ; Ciclo 9 (era 2)
4973+ BA63 01               DEFB 1                              ; Ciclo 10 (era 2)
