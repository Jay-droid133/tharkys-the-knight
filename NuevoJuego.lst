4702+ B90F DD 21 C0 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4703+ B913 06 03            LD B, MONSTERS_TO_SPAWN
4704+ B915 0E 00            LD C, 0
4705+ B917              .smLoop:
4706+ B917 C5               PUSH BC
4707+ B918 DD 7E 01         LD A, (IX+ENT_TYPE)
4708+ B91B B7               OR A
