4383+ B6FB              ; ==============================================================================
4384+ B6FB              ; CountActiveNasties / CountActiveMonsters
4385+ B6FB              ; ==============================================================================
4386+ B6FB              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4387+ B6FB              ; Ambas usan _CountSlots internamente.
4388+ B6FB              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4389+ B6FB              ; ==============================================================================
4390+ B6FB              CountActiveNasties:
4391+ B6FB 21 0C 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4392+ B6FE 06 04            LD B, NUM_NASTIES
4393+ B700 18 05            JR _CountSlots
4394+ B702
4395+ B702              CountActiveMonsters:
4396+ B702 21 AC 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4397+ B705 06 06            LD B, NUM_MONSTERS
