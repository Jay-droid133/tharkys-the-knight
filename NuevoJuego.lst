1387+ A9D7              ; ==============================================================================
1388+ A9D7              ; UpdatePlayerMovement - Fiel a Sabre Wulf: mueve cada N frames
1389+ A9D7              ; ==============================================================================
1390+ A9D7              ; El original usa turns_per_player_move=2: el player se mueve cada 2 frames.
1391+ A9D7              ; Desplazamiento por turno: SPEED_RUN_X horizontal, SPEED_RUN_Y vertical.
1392+ A9D7              ; ==============================================================================
1393+ A9D7              UpdatePlayerMovement:
1394+ A9D7                  ; Fiel a Sabre Wulf: mueve solo cada PLAYER_MOVE_TURNS frames
1395+ A9D7 3A 79 82         LD A, (PlayerMoveTimer)
1396+ A9DA 3D               DEC A
1397+ A9DB 32 79 82         LD (PlayerMoveTimer), A
1398+ A9DE C0               RET NZ                      ; No es el turno de moverse
1399+ A9DF AF               XOR A
1400+ A9E0 32 F9 AA         LD (.skipVertical), A       ; reset flag por frame
1401+ A9E3 3E 01            LD A, PLAYER_MOVE_TURNS
