1061+ A4BC              ; ==============================================================================
1062+ A4BC              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A4BC              ; ==============================================================================
1064+ A4BC              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A4BC              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A4BC              ; ==============================================================================
1067+ A4BC              GetSpriteAddr:
1068+ A4BC                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A4BC                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A4BC 3A 7B 8D         LD A, (CurrentPaging)
1071+ A4BF E6 F8            AND $F8
1072+ A4C1 F6 06            OR 6
1073+ A4C3 32 7B 8D         LD (CurrentPaging), A
1074+ A4C6 01 FD 7F         LD BC, $7FFD
1075+ A4C9 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A4CB DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A4CE 6F               LD L, A
1078+ A4CF 26 00            LD H, 0
1079+ A4D1 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A4D2 11 B7 E7         LD DE, SpriteFrameTable
1081+ A4D5 19               ADD HL, DE
1082+ A4D6 5E               LD E, (HL)
1083+ A4D7 23               INC HL
1084+ A4D8 56               LD D, (HL)
1085+ A4D9 ED 53 EB A4      LD (SpriteAddrTemp), DE
1086+ A4DD 3A 7B 8D         LD A, (CurrentPaging)
1087+ A4E0 E6 F8            AND $F8
1088+ A4E2 32 7B 8D         LD (CurrentPaging), A
1089+ A4E5 01 FD 7F         LD BC, $7FFD
1090+ A4E8 ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A4EA C9               RET
1092+ A4EB
1093+ A4EB 00 00        SpriteAddrTemp: DEFW 0
1094+ A4ED
