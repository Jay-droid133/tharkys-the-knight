2242+ 989A              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2243+ 989A              ; ==============================================================================
2244+ 989A              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2245+ 989A              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2246+ 989A              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2247+ 989A              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2248+ 989A              ; ==============================================================================
2249+ 989A              UpdateMonster:
2250+ 989A                  ; --- Stun: knockback + pausa tras golpe del player ---
2251+ 989A DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
