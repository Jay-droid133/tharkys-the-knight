4309+ BAC8              ; ==============================================================================
4310+ BAC8              ; CountActiveNasties / CountActiveMonsters
4311+ BAC8              ; ==============================================================================
4312+ BAC8              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4313+ BAC8              ; Ambas usan _CountSlots internamente.
4314+ BAC8              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4315+ BAC8              ; ==============================================================================
4316+ BAC8              CountActiveNasties:
4317+ BAC8 21 A7 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4318+ BACB 06 04            LD B, NUM_NASTIES
4319+ BACD 18 05            JR _CountSlots
4320+ BACF
4321+ BACF              CountActiveMonsters:
4322+ BACF 21 47 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4323+ BAD2 06 06            LD B, NUM_MONSTERS
4324+ BAD4
4325+ BAD4              _CountSlots:
4326+ BAD4 0E 00            LD C, 0                         ; Contador
4327+ BAD6              .countLoop:
4328+ BAD6 7E               LD A, (HL)
4329+ BAD7 B7               OR A
4330+ BAD8 28 16            JR Z, .countNext                ; Slot vacio: no contar
4331+ BADA                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4332+ BADA D5               PUSH DE
4333+ BADB 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4334+ BADE 19               ADD HL, DE
4335+ BADF 7E               LD A, (HL)
4336+ BAE0 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4337+ BAE2 D1               POP DE
4338+ BAE3 FE 03            CP STATE_DYING
4339+ BAE5 28 09            JR Z, .countNext
4340+ BAE7 FE 04            CP STATE_SPAWNING
4341+ BAE9 28 05            JR Z, .countNext
4342+ BAEB FE 05            CP STATE_SCARED
4343+ BAED 28 01            JR Z, .countNext
4344+ BAEF 0C               INC C
4345+ BAF0              .countNext:
4346+ BAF0 11 10 00         LD DE, ENT_SIZE
4347+ BAF3 19               ADD HL, DE
4348+ BAF4 10 E0            DJNZ .countLoop
4349+ BAF6 79               LD A, C
4350+ BAF7 C9               RET
4351+ BAF8
4352+ BAF8              ; ==============================================================================
4353+ BAF8              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4354+ BAF8              ; ==============================================================================
4355+ BAF8              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4356+ BAF8              ; ==============================================================================
4357+ BAF8              TrySpawnNasty:
4358+ BAF8                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4359+ BAF8                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4360+ BAF8 3A 6F 82         LD A, (DeathBorderPhase)
4361+ BAFB B7               OR A
4362+ BAFC C0               RET NZ
4363+ BAFD                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4364+ BAFD                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4365+ BAFD                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4366+ BAFD 3A 73 82         LD A, (PlayerRespawnPhase)
4367+ BB00 FE 01            CP 1
4368+ BB02 C8               RET Z
4369+ BB03                  ; Cooldown tras cambio de pantalla / inicio
4370+ BB03 3A 7D 82         LD A, (SpawnTimer)
4371+ BB06 B7               OR A
4372+ BB07 28 05            JR Z, .spawnReady
4373+ BB09 3D               DEC A
4374+ BB0A 32 7D 82         LD (SpawnTimer), A
4375+ BB0D C9               RET
4376+ BB0E              .spawnReady:
4377+ BB0E                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4378+ BB0E 3A 75 B9         LD A, (ScareTimer)
4379+ BB11 B7               OR A
4380+ BB12 C0               RET NZ
4381+ BB13                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4382+ BB13                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4383+ BB13                  ; rellenamos con nasties crepusculares hasta A2.
4384+ BB13 3A 58 82         LD A, (MonsterTrappedFlags)
4385+ BB16 E6 07            AND $07
4386+ BB18 FE 07            CP $07
4387+ BB1A 28 0E            JR Z, .spawnIgnoreNightBlocks
4388+ BB1C                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4389+ BB1C                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4390+ BB1C                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4391+ BB1C                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4392+ BB1C 3A DF B6         LD A, (MonstersActive)
4393+ BB1F B7               OR A
4394+ BB20 C0               RET NZ
4395+ BB21                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4396+ BB21 3A 93 E4         LD A, (CurrentTimeOfDay)
4397+ BB24 FE 04            CP 4                        ; N2
4398+ BB26 C8               RET Z
4399+ BB27 FE 05            CP 5                        ; A1
4400+ BB29 C8               RET Z
4401+ BB2A              .spawnIgnoreNightBlocks:
4402+ BB2A                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4403+ BB2A                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4404+ BB2A                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4405+ BB2A                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4406+ BB2A DD 21 A6 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4407+ BB2E 06 04            LD B, NUM_NASTIES
4408+ BB30              .spawnLoop:
4409+ BB30 C5               PUSH BC
4410+ BB31 DD 7E 01         LD A, (IX+ENT_TYPE)
4411+ BB34 B7               OR A
4412+ BB35 20 12            JR NZ, .spawnNextSlot
4413+ BB37 CD 52 BB         CALL SpawnOneNasty
4414+ BB3A DD 7E 01         LD A, (IX+ENT_TYPE)
4415+ BB3D B7               OR A
4416+ BB3E 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4417+ BB40                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4418+ BB40                  ; (un poco de irregularidad en la cadencia de aparicion).
4419+ BB40 ED 5F            LD A, R
4420+ BB42 E6 07            AND $07
4421+ BB44 32 7D 82         LD (SpawnTimer), A
4422+ BB47 C1               POP BC
4423+ BB48 C9               RET
4424+ BB49              .spawnNextSlot:
4425+ BB49 11 10 00         LD DE, ENT_SIZE
4426+ BB4C DD 19            ADD IX, DE
4427+ BB4E C1               POP BC
4428+ BB4F 10 DF            DJNZ .spawnLoop
4429+ BB51 C9               RET
4430+ BB52
4431+ BB52              ; ==============================================================================
4432+ BB52              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4433+ BB52              ; ==============================================================================
4434+ BB52              SpawnOneNasty:
4435+ BB52                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4436+ BB52 ED 5F            LD A, R
4437+ BB54 E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4438+ BB56 6F               LD L, A
4439+ BB57 26 00            LD H, 0
4440+ BB59 ED 5B 70 C0      LD DE, (CurrentNastyTable)
4441+ BB5D 19               ADD HL, DE
4442+ BB5E 7E               LD A, (HL)
4443+ BB5F
4444+ BB5F                  ; Configurar entidad base
4445+ BB5F DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4446+ BB62 DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4447+ BB66 DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4448+ BB6A                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4449+ BB6A                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4450+ BB6A 3A 70 C0         LD A, (CurrentNastyTable)
4451+ BB6D FE 57            CP LOW CrepuscularTypeTable
4452+ BB6F 20 0B            JR NZ, .spnDay
4453+ BB71 3A 71 C0         LD A, (CurrentNastyTable + 1)
4454+ BB74 FE C0            CP HIGH CrepuscularTypeTable
4455+ BB76 20 04            JR NZ, .spnDay
4456+ BB78 3E 68            LD A, SPRID_SPAWN_NIGHT
4457+ BB7A 18 02            JR .spnSet
4458+ BB7C              .spnDay:
4459+ BB7C 3E 46            LD A, SPRID_SPAWN
4460+ BB7E              .spnSet:
4461+ BB7E DD 77 00         LD (IX+ENT_SPRITEID), A
4462+ BB81 DD 77 08         LD (IX+ENT_ANIMBASE), A
4463+ BB84 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4464+ BB88 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4465+ BB8C
4466+ BB8C                  ; Color segun tipo (cada tipo tiene color fijo)
4467+ BB8C DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4468+ BB8F 21 5B C0         LD HL, NastyColorTable
4469+ BB92 D5               PUSH DE
4470+ BB93 11 20 00         LD DE, SPRID_ENEMY_0
4471+ BB96 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4472+ BB97 CB 3F            SRL A
4473+ BB99 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4474+ BB9B 5F               LD E, A
4475+ BB9C 16 00            LD D, 0
4476+ BB9E 19               ADD HL, DE
4477+ BB9F 7E               LD A, (HL)
4478+ BBA0 D1               POP DE
4479+ BBA1              .setAttr:
4480+ BBA1 DD 77 05         LD (IX+ENT_ATTR), A
4481+ BBA4
4482+ BBA4                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4483+ BBA4                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4484+ BBA4                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4485+ BBA4                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4486+ BBA4                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4487+ BBA4                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4488+ BBA4 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4489+ BBA6 32 04 BD         LD (.spawnW1), A
4490+ BBA9 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4491+ BBAB 32 05 BD         LD (.spawnH1), A
4492+ BBAE
4493+ BBAE                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4494+ BBAE                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4495+ BBAE                  ; Sin rebuild aqui = sin lag por spawn.)
4496+ BBAE                  ; Posicion aleatoria (con reintentos)
4497+ BBAE 3E 08            LD A, 8                             ; mas reintentos: ahora tambien hay min-distance check
4498+ BBB0 32 02 BD         LD (.spawnTries), A
4499+ BBB3 AF               XOR A
4500+ BBB4 32 03 BD         LD (.spawnIgnoreZone), A            ; primera ronda respeta zona del player
4501+ BBB7
4502+ BBB7              .spawnRetry:
4503+ BBB7                  ; Picker: si .spawnIgnoreZone=0 y la lista de celdas alcanzables tiene
4504+ BBB7                  ; entradas, elegir aleatorio de la lista (garantiza zona del player).
