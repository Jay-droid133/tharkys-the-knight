 315+ 6F96              ; UpdateRandomPickup - room-enter hook
 316+ 6F96              ; ==============================================================================
 317+ 6F96              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 318+ 6F96              ; Early-out si ScreenDirty=0 (no transition).
 319+ 6F96              ;
 320+ 6F96              ; En transition:
 321+ 6F96              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 322+ 6F96              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 323+ 6F96              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 324+ 6F96              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 325+ 6F96              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 326+ 6F96              ;
 327+ 6F96              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 328+ 6F96              ; fijos (id, charX, charY, v) terminados con id=$FF.
 329+ 6F96              ;
 330+ 6F96              ; Destruye AF, BC, DE, HL.
 331+ 6F96              ; ==============================================================================
 332+ 6F96              UpdateRandomPickup:
 333+ 6F96 3A 10 83         LD A, (ScreenDirty)
 334+ 6F99 B7               OR A
 335+ 6F9A C8               RET Z
 336+ 6F9B
 337+ 6F9B                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 338+ 6F9B 3E FE            LD A, $FE
 339+ 6F9D 32 B4 5F         LD (RandomSynthMapX), A
 340+ 6FA0 AF               XOR A
 341+ 6FA1 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 342+ 6FA4
 343+ 6FA4                  ; --- Scan BG stream, build SlotList ---
 344+ 6FA4 AF               XOR A
 345+ 6FA5 32 AB 5F         LD (RandomSlotCount), A
 346+ 6FA8 2A 0A 83         LD HL, (CurrentScreenAddr)
 347+ 6FAB              .urpScanLoop:
 348+ 6FAB 7E               LD A, (HL)                          ; A = id
 349+ 6FAC FE FF            CP $FF
 350+ 6FAE 28 2A            JR Z, .urpScanDone
 351+ 6FB0 FE D2            CP RANDOM_SLOT_MARKER
 352+ 6FB2 20 20            JR NZ, .urpSkipEntry
 353+ 6FB4                  ; Es marker. Cap reached?
 354+ 6FB4 3A AB 5F         LD A, (RandomSlotCount)
 355+ 6FB7 FE 04            CP RANDOM_SLOT_MAX
 356+ 6FB9 30 19            JR NC, .urpSkipEntry
 357+ 6FBB                  ; SlotList[count*2] = charX, [count*2+1] = charY
 358+ 6FBB 23               INC HL                              ; HL @ charX
 359+ 6FBC 46               LD B, (HL)                          ; B = charX
 360+ 6FBD 23               INC HL                              ; HL @ charY
 361+ 6FBE 4E               LD C, (HL)                          ; C = charY
 362+ 6FBF E5               PUSH HL                             ; save HL @ charY
 363+ 6FC0 87               ADD A, A                            ; A = count*2
 364+ 6FC1 6F               LD L, A
 365+ 6FC2 26 00            LD H, 0
 366+ 6FC4 11 AC 5F         LD DE, RandomSlotList
 367+ 6FC7 19               ADD HL, DE
 368+ 6FC8 70               LD (HL), B                          ; charX
 369+ 6FC9 23               INC HL
 370+ 6FCA 71               LD (HL), C                          ; charY
 371+ 6FCB 21 AB 5F         LD HL, RandomSlotCount
 372+ 6FCE 34               INC (HL)
 373+ 6FCF E1               POP HL                              ; HL @ charY
 374+ 6FD0 23               INC HL                              ; HL @ v
 375+ 6FD1 23               INC HL                              ; HL @ next id
 376+ 6FD2 18 D7            JR .urpScanLoop
 377+ 6FD4              .urpSkipEntry:
 378+ 6FD4                  ; Skip entry: 4 bytes (id, charX, charY, v).
 379+ 6FD4 23               INC HL
 379+ 6FD5 23             INC HL
 379+ 6FD6 23             INC HL
 379+ 6FD7 23             INC HL
 380+ 6FD8 18 D1            JR .urpScanLoop
 381+ 6FDA              .urpScanDone:
