 102  8B1C                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 8B1C              ; ==============================================================================
   2+ 8B1C              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 8B1C              ; ==============================================================================
   4+ 8B1C              ; - Estructura de entidad de 12 bytes (universal)
   5+ 8B1C              ; - Game loop per-entity: erase → update → draw
   6+ 8B1C              ; - Movimiento 8-bit (sin subpixel)
   7+ 8B1C              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 8B1C              ; - XOR draw/erase (una sola rutina)
   9+ 8B1C              ; ==============================================================================
  10+ 8B1C
  11+ 8B1C              ; ==============================================================================
  12+ 8B1C              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 8B1C              ; ==============================================================================
  14+ 8B1C              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 8B1C              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 8B1C              ; ==============================================================================
  17+ 8B1C              ReadInput:
  18+ 8B1C 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 8B1E 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 8B20
  21+ 8B20                  ; -- 1. QAOP --
  22+ 8B20 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 8B23 ED 78            IN A, (C)
  24+ 8B25 CB 47            BIT 0, A            ; Q = Arriba
  25+ 8B27 20 02            JR NZ, .no_q
  26+ 8B29 CB C2            SET 0, D
  27+ 8B2B              .no_q:
  28+ 8B2B 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 8B2E ED 78            IN A, (C)
  30+ 8B30 CB 47            BIT 0, A            ; A = Abajo
  31+ 8B32 20 02            JR NZ, .no_a
  32+ 8B34 CB CA            SET 1, D
  33+ 8B36              .no_a:
  34+ 8B36 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 8B39 ED 78            IN A, (C)
  36+ 8B3B CB 4F            BIT 1, A            ; O = Izquierda
  37+ 8B3D 20 02            JR NZ, .no_o
  38+ 8B3F CB DA            SET 3, D
  39+ 8B41              .no_o:
  40+ 8B41 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 8B43 20 02            JR NZ, .no_p
  42+ 8B45 CB D2            SET 2, D
  43+ 8B47              .no_p:
  44+ 8B47
  45+ 8B47                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 8B47                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 8B47 DB 1F            IN A, (31)
  48+ 8B49 4F               LD C, A             ; guardar para fire
  49+ 8B4A CB 5F            BIT 3, A            ; Up
  50+ 8B4C 28 02            JR Z, .no_k_up
  51+ 8B4E CB C2            SET 0, D
  52+ 8B50              .no_k_up:
  53+ 8B50 CB 57            BIT 2, A            ; Down
  54+ 8B52 28 02            JR Z, .no_k_down
  55+ 8B54 CB CA            SET 1, D
  56+ 8B56              .no_k_down:
  57+ 8B56 CB 4F            BIT 1, A            ; Left
  58+ 8B58 28 02            JR Z, .no_k_left
  59+ 8B5A CB DA            SET 3, D
  60+ 8B5C              .no_k_left:
  61+ 8B5C CB 47            BIT 0, A            ; Right
  62+ 8B5E 28 02            JR Z, .no_k_right
  63+ 8B60 CB D2            SET 2, D
  64+ 8B62              .no_k_right:
  65+ 8B62 CB 61            BIT 4, C            ; Kempston Fire
  66+ 8B64 28 02            JR Z, .no_k_fire
  67+ 8B66 CB C3            SET 0, E
  68+ 8B68              .no_k_fire:
  69+ 8B68
  70+ 8B68                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 8B68                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 8B68 01 FE F7         LD BC, $F7FE
  73+ 8B6B ED 78            IN A, (C)
  74+ 8B6D CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 8B6F 20 02            JR NZ, .no_s1_up
  76+ 8B71 CB C2            SET 0, D
  77+ 8B73              .no_s1_up:
  78+ 8B73 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 8B75 20 02            JR NZ, .no_s1_down
  80+ 8B77 CB CA            SET 1, D
  81+ 8B79              .no_s1_down:
  82+ 8B79 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 8B7B 20 02            JR NZ, .no_s1_left
  84+ 8B7D CB DA            SET 3, D
  85+ 8B7F              .no_s1_left:
  86+ 8B7F CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 8B81 20 02            JR NZ, .no_s1_right
  88+ 8B83 CB D2            SET 2, D
  89+ 8B85              .no_s1_right:
  90+ 8B85 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 8B87 20 02            JR NZ, .no_s1_fire
  92+ 8B89 CB C3            SET 0, E
  93+ 8B8B              .no_s1_fire:
  94+ 8B8B
  95+ 8B8B                  ; -- 4. SPACE = Fire (teclado) --
  96+ 8B8B 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 8B8E ED 78            IN A, (C)
  98+ 8B90 CB 47            BIT 0, A            ; SPACE
  99+ 8B92 20 02            JR NZ, .no_space
 100+ 8B94 CB C3            SET 0, E
 101+ 8B96              .no_space:
 102+ 8B96
 103+ 8B96                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 8B96 7B               LD A, E
 105+ 8B97 32 96 81         LD (InputFire), A
 106+ 8B9A
 107+ 8B9A                  ; -- 6. Cancelar opuestos --
 108+ 8B9A 7A               LD A, D
 109+ 8B9B 47               LD B, A
 110+ 8B9C E6 03            AND DIR_N | DIR_S
 111+ 8B9E FE 03            CP DIR_N | DIR_S
 112+ 8BA0 20 04            JR NZ, .noVC
 113+ 8BA2 78               LD A, B
 114+ 8BA3 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ 8BA5 47               LD B, A
 116+ 8BA6              .noVC:
 117+ 8BA6 78               LD A, B
 118+ 8BA7 E6 0C            AND DIR_E | DIR_W
 119+ 8BA9 FE 0C            CP DIR_E | DIR_W
 120+ 8BAB 20 04            JR NZ, .noHC
 121+ 8BAD 78               LD A, B
 122+ 8BAE E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ 8BB0 47               LD B, A
 124+ 8BB1              .noHC:
 125+ 8BB1 78               LD A, B
 126+ 8BB2 32 95 81         LD (InputDirection), A
 127+ 8BB5 C9               RET
 128+ 8BB6
 129+ 8BB6              ; ==============================================================================
 130+ 8BB6              ; InitEntities - Inicializa la tabla de entidades
 131+ 8BB6              ; ==============================================================================
 132+ 8BB6              ; Limpia todos los slots y configura el slot 0 como player.
 133+ 8BB6              ; ==============================================================================
 134+ 8BB6              InitEntities:
 135+ 8BB6                  ; Limpiar toda la tabla a ceros
 136+ 8BB6 21 85 80         LD HL, EntityTable
 137+ 8BB9 11 86 80         LD DE, EntityTable + 1
 138+ 8BBC 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ 8BBF AF               XOR A
 140+ 8BC0 77               LD (HL), A
 141+ 8BC1 ED B0            LDIR
 142+ 8BC3
 143+ 8BC3                  ; Limpiar tabla de atributos salvados
 144+ 8BC3 21 39 89         LD HL, SavedAttrTable
 145+ 8BC6 11 3A 89         LD DE, SavedAttrTable + 1
 146+ 8BC9 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ 8BCC AF               XOR A
 148+ 8BCD 77               LD (HL), A
 149+ 8BCE ED B0            LDIR
 150+ 8BD0
 151+ 8BD0                  ; Configurar slot 0: Player
 152+ 8BD0 DD 21 85 80      LD IX, EntityTable
 153+ 8BD4 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ 8BD8 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ 8BDC DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ 8BE0 DD 36 03 80      LD (IX+ENT_POSX), START_PLAYER_X
 157+ 8BE4 DD 36 04 80      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ 8BE8 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ 8BEC DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ 8BF0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ 8BF4 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ 8BF8 DD 36 09 14      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ 8BFC DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ 8C00 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ 8C04 DD 36 0C 80      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ 8C08 DD 36 0D 80      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ 8C0C DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ 8C10 DD 36 0F 80      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ 8C14
 170+ 8C14                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ 8C14 3E 32            LD A, SPAWN_INTERVAL
 172+ 8C16 32 98 81         LD (SpawnTimer), A
 173+ 8C19 AF               XOR A
 174+ 8C1A 32 99 81         LD (EnemyStepIdx), A
 175+ 8C1D 32 9F 81         LD (PendingEraseCount), A
 176+ 8C20 C9               RET
 177+ 8C21
 178+ 8C21              ; ==============================================================================
 179+ 8C21              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 180+ 8C21              ; ==============================================================================
 181+ 8C21              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 182+ 8C21              ; ==============================================================================
 183+ 8C21              ProcessPlayer:
 184+ 8C21 DD 21 85 80      LD IX, EntityTable
 185+ 8C25
 186+ 8C25                  ; --- Fresh check ---
 187+ 8C25 3A B6 81         LD A, (ScreenJustRedrawn)
 188+ 8C28 B7               OR A
 189+ 8C29 C2 FB 8C         JP NZ, .plFresh
 190+ 8C2C DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 191+ 8C30 C2 FB 8C         JP NZ, .plFresh
 192+ 8C33
 193+ 8C33                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 194+ 8C33 CD B3 90         CALL UpdatePlayer
 195+ 8C36 CD 45 90         CALL CalcDrawX
 196+ 8C39
 197+ 8C39                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 198+ 8C39 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 199+ 8C3C DD BE 0C         CP (IX+ENT_OLDX)
 200+ 8C3F 20 45            JR NZ, .plDoErase
 201+ 8C41 DD 7E 04         LD A, (IX+ENT_POSY)
 202+ 8C44 DD BE 0D         CP (IX+ENT_OLDY)
 203+ 8C47 20 3D            JR NZ, .plDoErase
 204+ 8C49 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 205+ 8C4C DD BE 0E         CP (IX+ENT_OLDSPRID)
 206+ 8C4F 20 35            JR NZ, .plDoErase
 207+ 8C51                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
