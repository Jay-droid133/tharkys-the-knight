 760+ E5A3              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 761+ E5A3              ; A = codigo ASCII, E = columna (0-31)
 762+ E5A3              DrawHudChar:
 763+ E5A3                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 764+ E5A3 6F               LD L, A
 765+ E5A4 26 00            LD H, 0
 766+ E5A6 29               ADD HL, HL
 767+ E5A7 29               ADD HL, HL
 768+ E5A8 29               ADD HL, HL
 769+ E5A9 01 00 3C         LD BC, $3C00
 770+ E5AC 09               ADD HL, BC                  ; HL = font data
 771+ E5AD
 772+ E5AD                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 773+ E5AD 16 40            LD D, $40                   ; Tercio 0, scan line 0
 774+ E5AF 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 775+ E5B1 83               ADD A, E
 776+ E5B2 5F               LD E, A                     ; DE = dir VRAM
 777+ E5B3
 778+ E5B3 06 08            LD B, 8
