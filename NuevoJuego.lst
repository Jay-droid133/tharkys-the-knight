4146+ B5D9              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
4147+ B5D9              ; ==============================================================================
4148+ B5D9              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
4149+ B5D9              ; ==============================================================================
4150+ B5D9              SchedulePendingErase:
4151+ B5D9 3A 7B 5F         LD A, (PendingEraseCount)
4152+ B5DC FE 03            CP 3
4153+ B5DE D0               RET NC                              ; Buffer lleno (no deberia pasar)
4154+ B5DF                  ; Calcular posicion en buffer: count × 5
4155+ B5DF 6F               LD L, A
4156+ B5E0 26 00            LD H, 0
4157+ B5E2 29               ADD HL, HL
4158+ B5E3 29               ADD HL, HL
4159+ B5E4 29               ADD HL, HL                          ; count × 8 (simplificado)
4160+ B5E5                  ; Corregir: count × 5 = count × 4 + count
4161+ B5E5 6F               LD L, A
4162+ B5E6 26 00            LD H, 0
4163+ B5E8 54               LD D, H
4164+ B5E9 5D               LD E, L
4165+ B5EA 29               ADD HL, HL
4166+ B5EB 29               ADD HL, HL                          ; count × 4
4167+ B5EC 19               ADD HL, DE                          ; count × 5
4168+ B5ED 11 7C 5F         LD DE, PendingEraseSlots
4169+ B5F0 19               ADD HL, DE
