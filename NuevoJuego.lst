# file closed: room_routes_bank7.asm
 583  DB7B                  ; --- Game Over tumba 2x — body (~538 B) ---
 584  DB7B                  ; Cold path one-shot. Llamado via thunk en slot 1 (game_over_tomb_thunk.asm).
 585  DB7B                  ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
 586  DB7B                  ; al final → bank 7 desapareceria con el body ejecutandose). El thunk hace
 587  DB7B                  ; la carga del sprite ANTES de paginar bank 7 y llamar al body.
 588  DB7B                  INCLUDE "game_over_tomb.asm"
# file opened: game_over_tomb.asm
   1+ DB7B              ; ==============================================================================
   2+ DB7B              ; GAME OVER — TUMBA DEL JUGADOR A 2x (BODY, vive en BANK 7)
   3+ DB7B              ; ==============================================================================
   4+ DB7B              ; Cuerpo de la rutina. Vive en bank 7 (slot 3 cuando paged) por estar
   5+ DB7B              ; "holgado": tras bg_gfx_c (~$D226) y antes del storage de tombstones ($E000+),
   6+ DB7B              ; quedan ~3.5 KB libres. Bank 0 estaba al 96 % y este código es one-shot.
   7+ DB7B              ;
   8+ DB7B              ; Llamado por DrawTombstone2xCentered (thunk en slot 1) DESPUÉS de que el
   9+ DB7B              ; thunk haya cargado el sprite en BgSpriteBuffer y paginado bank 7 en slot 3.
  10+ DB7B              ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
  11+ DB7B              ; en slot 3 al final → bank 7 desaparece → crash).
  12+ DB7B              ;
  13+ DB7B              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
  14+ DB7B              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
  15+ DB7B              ; Game Over. La muerte hace moonwalk justo encima del techo.
  16+ DB7B              ;
  17+ DB7B              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  18+ DB7B              ;
  19+ DB7B              ; Algoritmo (precondición: BgSpriteBuffer ya tiene el sprite cargado):
  20+ DB7B              ;   1. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  21+ DB7B              ;      planos en TombDecodedPixels (en bank 7 RAM). Salva src ptr post-pixels.
  22+ DB7B              ;   2. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  23+ DB7B              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  24+ DB7B              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  25+ DB7B              ;   3. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  26+ DB7B              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  27+ DB7B              ;
  28+ DB7B              ; Coste: ~30K T-states one-shot. Invisible.
  29+ DB7B              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch + 2 B var = ~538 B en bank 7.
  30+ DB7B              ;
  31+ DB7B              ; Capas:
  32+ DB7B              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  33+ DB7B              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba.
  34+ DB7B              ; ==============================================================================
  35+ DB7B
  36+ DB7B              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  37+ DB7B              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  38+ DB7B              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  39+ DB7B              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  40+ DB7B              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  41+ DB7B              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  42+ DB7B              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  43+ DB7B              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  44+ DB7B              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  45+ DB7B
  46+ DB7B              ; ==============================================================================
  47+ DB7B              ; DrawTombstone2xBody - entry point del body en bank 7
  48+ DB7B              ; ==============================================================================
  49+ DB7B              ; Precondición: bank 7 paginado en slot 3 + BgSpriteBuffer ya cargado con
  50+ DB7B              ; el sprite (lo hace el thunk antes de llamar a esta rutina).
  51+ DB7B              ;
  52+ DB7B              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  53+ DB7B              ; directamente a VRAM sin XOR.
  54+ DB7B              ;
  55+ DB7B              ; Destruye: AF, BC, DE, HL, IX.
  56+ DB7B              ; ==============================================================================
  57+ DB7B              DrawTombstone2xBody:
  58+ DB7B                  ; --- 1. Decodificar pixeles RLE+CPL → flat buffer ---
  59+ DB7B CD 84 DB         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  60+ DB7E
  61+ DB7E                  ; --- 2. Dibujar pixeles 2x desde flat buffer ---
  62+ DB7E CD E1 DB         CALL DrawTombPixels2x
  63+ DB81
  64+ DB81                  ; --- 3. Dibujar attrs 2x desde BgSpriteBuffer ---
  65+ DB81 C3 6A DC         JP DrawTombAttrs2x              ; tail-call
  66+ DB84
  67+ DB84              ; ==============================================================================
  68+ DB84              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  69+ DB84              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  70+ DB84              ; ==============================================================================
  71+ DB84              ; Formato RLE (mismo que DrawBgGfxSprite):
  72+ DB84              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  73+ DB84              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  74+ DB84              ;
  75+ DB84              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  76+ DB84              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  77+ DB84              ;
  78+ DB84              ; Destruye: AF, BC, DE, HL.
  79+ DB84              ; ==============================================================================
  80+ DB84              DecodeTombRLEPixels:
  81+ DB84 21 FF 86         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  82+ DB87 11 B1 DC         LD DE, TombDecodedPixels
  83+ DB8A 01 F0 00         LD BC, TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes a emitir
  84+ DB8D AF               XOR A
  85+ DB8E 32 DF DB         LD (.drlPending), A
  86+ DB91              .drlLoop:
  87+ DB91 78               LD A, B
  88+ DB92 B1               OR C
  89+ DB93 28 43            JR Z, .drlDone                  ; remaining == 0 → done
  90+ DB95 3A DF DB         LD A, (.drlPending)
  91+ DB98 B7               OR A
  92+ DB99 28 22            JR Z, .drlNewToken
  93+ DB9B FA AE DB         JP M, .drlLitEmit
  94+ DB9E                  ; pending > 0 → run en curso
  95+ DB9E              .drlRunEmit:
  96+ DB9E 3A E0 DB         LD A, (.drlValue)
  97+ DBA1 2F               CPL
  98+ DBA2 12               LD (DE), A
  99+ DBA3 13               INC DE
 100+ DBA4 0B               DEC BC
 101+ DBA5 3A DF DB         LD A, (.drlPending)
 102+ DBA8 3D               DEC A
 103+ DBA9 32 DF DB         LD (.drlPending), A
 104+ DBAC 18 E3            JR .drlLoop
 105+ DBAE
 106+ DBAE              .drlLitEmit:
 107+ DBAE 7E               LD A, (HL)
 108+ DBAF 23               INC HL
 109+ DBB0 2F               CPL
 110+ DBB1 12               LD (DE), A
 111+ DBB2 13               INC DE
 112+ DBB3 0B               DEC BC
 113+ DBB4 3A DF DB         LD A, (.drlPending)
 114+ DBB7 3C               INC A                           ; hacia 0
 115+ DBB8 32 DF DB         LD (.drlPending), A
 116+ DBBB 18 D4            JR .drlLoop
 117+ DBBD
 118+ DBBD              .drlNewToken:
 119+ DBBD 7E               LD A, (HL)
 120+ DBBE 23               INC HL
 121+ DBBF CB 7F            BIT 7, A
 122+ DBC1 20 07            JR NZ, .drlNewRun
 123+ DBC3                  ; Literal group: pending = -count
 124+ DBC3 ED 44            NEG
 125+ DBC5 32 DF DB         LD (.drlPending), A
 126+ DBC8 18 C7            JR .drlLoop
 127+ DBCA
 128+ DBCA              .drlNewRun:
 129+ DBCA E6 7F            AND $7F
 130+ DBCC C6 02            ADD A, 2
 131+ DBCE 32 DF DB         LD (.drlPending), A
 132+ DBD1 7E               LD A, (HL)
 133+ DBD2 23               INC HL
 134+ DBD3 32 E0 DB         LD (.drlValue), A
 135+ DBD6 18 B9            JR .drlLoop
 136+ DBD8
 137+ DBD8              .drlDone:
 138+ DBD8                  ; HL apunta al byte tras los pixeles RLE = tint byte.
 139+ DBD8                  ; attrs comienzan en HL + 3 (skip tint + AH + AW).
 140+ DBD8 23               INC HL
 141+ DBD9 23               INC HL
 142+ DBDA 23               INC HL
 143+ DBDB 22 A1 DD         LD (TombAttrSrcPtr), HL
 144+ DBDE C9               RET
 145+ DBDF
 146+ DBDF 00           .drlPending:    DEFB 0
 147+ DBE0 00           .drlValue:      DEFB 0
 148+ DBE1
 149+ DBE1              ; ==============================================================================
 150+ DBE1              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 151+ DBE1              ; ==============================================================================
 152+ DBE1              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 153+ DBE1              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 154+ DBE1              ; pareja de bytes — vertical doubling).
 155+ DBE1              ;
 156+ DBE1              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 157+ DBE1              ; Destruye: AF, BC, DE, HL.
 158+ DBE1              ; ==============================================================================
 159+ DBE1              DrawTombPixels2x:
 160+ DBE1 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 161+ DBE3 32 62 DC         LD (.dpxRowsLeft), A
 162+ DBE6 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
 163+ DBE8 32 63 DC         LD (.dpxDstY), A
 164+ DBEB 21 B1 DC         LD HL, TombDecodedPixels
 165+ DBEE 22 64 DC         LD (.dpxSrcPtr), HL
 166+ DBF1
 167+ DBF1              .dpxNextRow:
 168+ DBF1                  ; Calc dst top addr at (TOMB_2X_DST_PIXEL_X, dstY)
 169+ DBF1 3A 63 DC         LD A, (.dpxDstY)
 170+ DBF4 57               LD D, A
 171+ DBF5 1E 50            LD E, TOMB_2X_DST_PIXEL_X
 172+ DBF7 CD 62 9D         CALL CalcPixelAddr
 173+ DBFA 22 66 DC         LD (.dpxDstTop), HL
 174+ DBFD
 175+ DBFD                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 176+ DBFD CD CE 9A         CALL NextPixelLine
 177+ DC00 22 68 DC         LD (.dpxDstBot), HL
 178+ DC03
 179+ DC03                  ; Procesar 6 src bytes para esta src row
 180+ DC03 2A 64 DC         LD HL, (.dpxSrcPtr)
 181+ DC06 06 06            LD B, TOMB_SRC_W_BYTES
 182+ DC08              .dpxByteLoop:
 183+ DC08 7E               LD A, (HL)
 184+ DC09 23               INC HL
 185+ DC0A 4F               LD C, A                         ; C = src byte original
 186+ DC0B E5               PUSH HL                         ; save src ptr
 187+ DC0C C5               PUSH BC                         ; save count + src byte
 188+ DC0D
 189+ DC0D                  ; --- High nibble doubled ---
 190+ DC0D E6 F0            AND $F0
 191+ DC0F 0F               RRCA
 191+ DC10 0F             RRCA
 191+ DC11 0F             RRCA
 191+ DC12 0F             RRCA       ; high nibble en posición baja
 192+ DC13 5F               LD E, A
 193+ DC14 16 00            LD D, 0
 194+ DC16 21 A1 DC         LD HL, NibbleDoubleLUT
 195+ DC19 19               ADD HL, DE
 196+ DC1A 7E               LD A, (HL)                      ; A = high doubled
 197+ DC1B 2A 66 DC         LD HL, (.dpxDstTop)
 198+ DC1E 77               LD (HL), A
 199+ DC1F 23               INC HL
 200+ DC20 22 66 DC         LD (.dpxDstTop), HL
 201+ DC23 2A 68 DC         LD HL, (.dpxDstBot)
 202+ DC26 77               LD (HL), A
 203+ DC27 23               INC HL
 204+ DC28 22 68 DC         LD (.dpxDstBot), HL
 205+ DC2B
 206+ DC2B                  ; --- Low nibble doubled ---
 207+ DC2B C1               POP BC                          ; recover src byte (en C)
 208+ DC2C C5               PUSH BC
 209+ DC2D 79               LD A, C
 210+ DC2E E6 0F            AND $0F
 211+ DC30 5F               LD E, A
 212+ DC31 16 00            LD D, 0
 213+ DC33 21 A1 DC         LD HL, NibbleDoubleLUT
 214+ DC36 19               ADD HL, DE
 215+ DC37 7E               LD A, (HL)                      ; A = low doubled
 216+ DC38 2A 66 DC         LD HL, (.dpxDstTop)
 217+ DC3B 77               LD (HL), A
 218+ DC3C 23               INC HL
 219+ DC3D 22 66 DC         LD (.dpxDstTop), HL
 220+ DC40 2A 68 DC         LD HL, (.dpxDstBot)
 221+ DC43 77               LD (HL), A
 222+ DC44 23               INC HL
 223+ DC45 22 68 DC         LD (.dpxDstBot), HL
 224+ DC48
 225+ DC48 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 226+ DC49 E1               POP HL                          ; src ptr
 227+ DC4A 10 BC            DJNZ .dpxByteLoop
 228+ DC4C
 229+ DC4C                  ; Avanzar a siguiente src row
 230+ DC4C 22 64 DC         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 231+ DC4F 3A 63 DC         LD A, (.dpxDstY)
 232+ DC52 C6 02            ADD A, 2                        ; 2 dst rows por 1 src row
 233+ DC54 32 63 DC         LD (.dpxDstY), A
 234+ DC57 3A 62 DC         LD A, (.dpxRowsLeft)
 235+ DC5A 3D               DEC A
 236+ DC5B 32 62 DC         LD (.dpxRowsLeft), A
 237+ DC5E C2 F1 DB         JP NZ, .dpxNextRow
 238+ DC61 C9               RET
 239+ DC62
 240+ DC62 00           .dpxRowsLeft:   DEFB 0
 241+ DC63 00           .dpxDstY:       DEFB 0
 242+ DC64 00 00        .dpxSrcPtr:     DEFW 0
 243+ DC66 00 00        .dpxDstTop:     DEFW 0
 244+ DC68 00 00        .dpxDstBot:     DEFW 0
 245+ DC6A
 246+ DC6A              ; ==============================================================================
 247+ DC6A              ; DrawTombAttrs2x - 30 src attrs (6×5) → 120 dst attrs (12×10) en attr VRAM
 248+ DC6A              ; ==============================================================================
 249+ DC6A              ; Cada src attr se replica en bloque 2×2 chars en dst.
 250+ DC6A              ; Src ptr en TombAttrSrcPtr (set por DecodeTombRLEPixels).
 251+ DC6A              ; Dst start: $5800 + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X.
 252+ DC6A              ;
 253+ DC6A              ; Destruye: AF, BC, DE, HL.
 254+ DC6A              ; ==============================================================================
 255+ DC6A              DrawTombAttrs2x:
 256+ DC6A 2A A1 DD         LD HL, (TombAttrSrcPtr)         ; HL = src attrs (en BgSpriteBuffer)
 257+ DC6D 11 4A 59         LD DE, ATTR_BASE + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X
 258+ DC70 3E 05            LD A, TOMB_SRC_ATTR_H           ; 5 src rows
 259+ DC72              .daxRow:
 260+ DC72 32 A0 DC         LD (.daxRowsLeft), A
 261+ DC75 D5               PUSH DE                         ; guardar dst row top start
 262+ DC76 06 06            LD B, TOMB_SRC_ATTR_W           ; 6 src attrs por row
 263+ DC78              .daxCol:
 264+ DC78 7E               LD A, (HL)
 265+ DC79 23               INC HL
 266+ DC7A 12               LD (DE), A                      ; dst top col 2N
 267+ DC7B 13               INC DE
 268+ DC7C 12               LD (DE), A                      ; dst top col 2N+1
 269+ DC7D 13               INC DE
 270+ DC7E 10 F8            DJNZ .daxCol
 271+ DC80                  ; Replicar la dst row top a dst row top+1 (= +32 bytes)
 272+ DC80 D1               POP DE                          ; DE = dst row top start
 273+ DC81 E5               PUSH HL                         ; save src ptr
 274+ DC82 62               LD H, D
 275+ DC83 6B               LD L, E                         ; HL = dst row top start
 276+ DC84 7B               LD A, E
 277+ DC85 C6 20            ADD A, 32
 278+ DC87 5F               LD E, A
 279+ DC88 30 01            JR NC, .daxNoCarry1
 280+ DC8A 14               INC D
 281+ DC8B              .daxNoCarry1:
 282+ DC8B                  ; HL = top row start, DE = bot row start. LDIR 12 bytes.
 283+ DC8B 01 0C 00         LD BC, TOMB_SRC_ATTR_W * 2      ; 12
 284+ DC8E ED B0            LDIR                            ; copy 12 attrs from top row to bot row
 285+ DC90                  ; DE ahora apunta al char tras la última col de bot row.
 286+ DC90                  ; Necesitamos resetear DE al inicio de la siguiente "row top" = +32 desde
 287+ DC90                  ; donde estamos. Calculemos: bot row inició en (top + 32). Tras LDIR de 12
 288+ DC90                  ; bytes, DE = top + 32 + 12. Próxima top row = top + 64.
 289+ DC90                  ; → DE += 32 - 12 = +20.
 290+ DC90 7B               LD A, E
 291+ DC91 C6 14            ADD A, 32 - TOMB_SRC_ATTR_W * 2
 292+ DC93 5F               LD E, A
 293+ DC94 30 01            JR NC, .daxNoCarry2
 294+ DC96 14               INC D
 295+ DC97              .daxNoCarry2:
 296+ DC97 E1               POP HL                          ; restore src ptr
 297+ DC98 3A A0 DC         LD A, (.daxRowsLeft)
 298+ DC9B 3D               DEC A
 299+ DC9C C2 72 DC         JP NZ, .daxRow
 300+ DC9F C9               RET
 301+ DCA0
 302+ DCA0 00           .daxRowsLeft:   DEFB 0
 303+ DCA1
 304+ DCA1              ; ==============================================================================
 305+ DCA1              ; LUT: nibble (4 bits abcd) → byte doblado (aabbccdd)
 306+ DCA1              ; ==============================================================================
 307+ DCA1              NibbleDoubleLUT:
 308+ DCA1 00               DEFB %00000000  ; 0000 → 00000000
 309+ DCA2 03               DEFB %00000011  ; 0001 → 00000011
 310+ DCA3 0C               DEFB %00001100  ; 0010 → 00001100
 311+ DCA4 0F               DEFB %00001111  ; 0011 → 00001111
 312+ DCA5 30               DEFB %00110000  ; 0100 → 00110000
 313+ DCA6 33               DEFB %00110011  ; 0101 → 00110011
 314+ DCA7 3C               DEFB %00111100  ; 0110 → 00111100
 315+ DCA8 3F               DEFB %00111111  ; 0111 → 00111111
 316+ DCA9 C0               DEFB %11000000  ; 1000 → 11000000
 317+ DCAA C3               DEFB %11000011  ; 1001 → 11000011
 318+ DCAB CC               DEFB %11001100  ; 1010 → 11001100
 319+ DCAC CF               DEFB %11001111  ; 1011 → 11001111
 320+ DCAD F0               DEFB %11110000  ; 1100 → 11110000
 321+ DCAE F3               DEFB %11110011  ; 1101 → 11110011
 322+ DCAF FC               DEFB %11111100  ; 1110 → 11111100
 323+ DCB0 FF               DEFB %11111111  ; 1111 → 11111111
 324+ DCB1
 325+ DCB1              ; ==============================================================================
 326+ DCB1              ; Buffer plano de pixeles decodificados (240 B). Cold storage en slot 1.
 327+ DCB1              ; Vivirá en .lst después del code; sjasmplus lo ubica donde el ORG actual.
 328+ DCB1              ; ==============================================================================
 329+ DCB1              TombDecodedPixels:
 330+ DCB1 00 00 00...      DEFS TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes
 331+ DDA1
 332+ DDA1              ; ==============================================================================
 333+ DDA1              ; Variable global: ptr a la sección de attrs en BgSpriteBuffer (set por
 334+ DDA1              ; DecodeTombRLEPixels). 16-bit, en slot 1 (cold).
 335+ DDA1              ; ==============================================================================
 336+ DDA1              TombAttrSrcPtr:
 337+ DDA1 00 00            DEFW 0
 338+ DDA3
# file closed: game_over_tomb.asm
 589  DDA3
 590  DDA3                  ; --- Bank cutscene body (M9, ~1.7 KB con wrappers) ---
 591  DDA3                  ; Movido aqui desde bank 0 para descongestionar el main code (que estaba
 592  DDA3                  ; a 3 B libres). Los entry points (CheckBankTriggerBg / UpdateBankCutscene)
 593  DDA3                  ; viven como thunks en slot 1 (bank_cutscene_thunks.asm). El body usa
 594  DDA3                  ; _PageBank0 / _PageBank7 (slot 1, always-visible) para envolver cada
 595  DDA3                  ; CALL externo: el body no puede llamar directamente a rutinas bank 0
 596  DDA3                  ; porque slot 3 esta paginado a bank 7 mientras el body ejecuta.
 597  DDA3                  INCLUDE "bank_cutscene.asm"
# file opened: bank_cutscene.asm
   1+ DDA3              ; ==============================================================================
   2+ DDA3              ; bank_cutscene.asm - Cutscene del banco (M9 propuesto)
   3+ DDA3              ; ==============================================================================
   4+ DDA3              ; Placement actual: **bank 7** (PAGE 7, slot 3 cuando paginado).
   5+ DDA3              ;
   6+ DDA3              ; Historia: originalmente en bank 0 default cuando habia ~1.4 KB libres en
   7+ DDA3              ; main code. Tras la presion de slot 1 / bank 0 (ambos al limite) en mayo
   8+ DDA3              ; 2026, movido a bank 7 (que tenia ~8 KB libres). Los 2 entry points
   9+ DDA3              ; (CheckBankTriggerBg / UpdateBankCutscene) viven como thunks en slot 1
  10+ DDA3              ; (bank_cutscene_thunks.asm) que paginan bank 7 antes del body y restauran
  11+ DDA3              ; bank 0 al volver. Cada CALL externo dentro del body usa el patron
  12+ DDA3              ; `CALL _PageBank0 / CALL func / CALL _PageBank7` para que las rutinas
  13+ DDA3              ; bank 0 (DrawBgSpriteXOR, PlaySFX, etc.) y slot 1 que internamente tocan
  14+ DDA3              ; bank 0 (TownGateRedrawPlayer -> RestoreOldAttr) sean visibles durante su
  15+ DDA3              ; ejecucion.
  16+ DDA3              ;
  17+ DDA3              ; Diseno doc: docs/bank_cutscene.md.
  18+ DDA3              ;
  19+ DDA3              ; Disparada al chocar contra la puerta del banco (sprite Bank id 39, en
  20+ DDA3              ; sala (8,8)) llevando el cheque (BankCheck id 44, key id 7).
  21+ DDA3              ;
  22+ DDA3              ; Phase machine indexada por BankCutscenePhase. Cuando != 0, MainLoop salta
  23+ DDA3              ; el bloque normal de gameplay y llama UpdateBankCutscene cada frame.
  24+ DDA3              ;
  25+ DDA3              ; Esquema de fases:
  26+ DDA3              ;   0  IDLE              no en cutscene
  27+ DDA3              ;   1  LOCK              snap player a anchor, facing N, pausa breve
  28+ DDA3              ;   2  KNOCKS_1          3 toques (sub-state HIT/GAP)
  29+ DDA3              ;   3  WAIT_1            espera silenciosa tras grupo 1
  30+ DDA3              ;   4  KNOCKS_2          3 toques mas
  31+ DDA3              ;   5  WAIT_2            espera tras grupo 2
  32+ DDA3              ;   6  TURN_TO_CAM       player gira a S (cara camara)
  33+ DDA3              ;   7  TURN_TO_DOOR      player vuelve a N
  34+ DDA3              ;   8  KNOCKS_3          6 toques
  35+ DDA3              ;   9  WAIT_3            pausa antes de aparecer la mano
  36+ DDA3              ;  10  PRE_HAND          hold corto; la puerta NO se abre (mano sale por la
  37+ DDA3              ;                        rendija de la puerta cerrada)
  38+ DDA3              ;  11  HAND_IN           aparece mano (frame 0) sobre la puerta cerrada
  39+ DDA3              ;  12  HAND_NO_NO        anim swaps frame 0/1, BCS_NO_SWAPS_TOTAL veces
  40+ DDA3              ;  13  HAND_OUT          erase mano
  41+ DDA3              ;  14  KEY_DROP          BankKeySpawned=1 + RedrawPickupByPtr
  42+ DDA3              ;  15  PLAYER_TURN_CAM   player mira a camara un instante
  43+ DDA3              ;  16  DONE              sentinel; setear phase=IDLE devuelve control
  44+ DDA3              ;  17  WAIT_NASTIES      pre-LOCK: nasties + death animan puff antes de LOCK
  45+ DDA3              ;                        (mismo patron que TGP_WAIT_NASTIES de town_gate;
  46+ DDA3              ;                        MainLoop ramifica especial para mantener
  47+ DDA3              ;                        ProcessEnemies + ProcessDeath corriendo).
  48+ DDA3              ;
  49+ DDA3              ; NOTA visual: la mano se dibuja con XOR sobre la puerta cerrada del banco.
  50+ DDA3              ; Hereda los attrs de la facade (no pinta los suyos), asi que XOR self-cancel
  51+ DDA3              ; en HAND_OUT deja la facade intacta. Por eso el draft inline +
  52+ DDA3              ; DrawBgSprite16XorAtPixel es el match exacto: cero gestion de attrs.
  53+ DDA3              ;
  54+ DDA3              ; Patron de cross-bank tras el move a bank 7:
  55+ DDA3              ;   - Body bank 7 ejecuta con bank 7 paginado en slot 3.
  56+ DDA3              ;   - CALLs a slot 1/slot 2/bank 2 (always-visible): sin wrap, directas.
  57+ DDA3              ;   - CALLs a bank 0 o a slot 1 que internamente toca bank 0: wrap con
  58+ DDA3              ;     `CALL _PageBank0 / CALL func / CALL _PageBank7` (helpers en slot 1).
  59+ DDA3              ;   - CALL LoadBgSpriteToBuffer: pagina bank 3 internamente y deja bank 0
  60+ DDA3              ;     paginado al RET. Repaginar bank 7 manualmente tras la llamada.
  61+ DDA3              ; ==============================================================================
  62+ DDA3
  63+ DDA3              ; ==============================================================================
  64+ DDA3              ; Phase enum
  65+ DDA3              ; ==============================================================================
  66+ DDA3              BCP_IDLE                EQU 0
  67+ DDA3              BCP_LOCK                EQU 1
  68+ DDA3              BCP_KNOCKS_1            EQU 2
  69+ DDA3              BCP_WAIT_1              EQU 3
  70+ DDA3              BCP_KNOCKS_2            EQU 4
  71+ DDA3              BCP_WAIT_2              EQU 5
  72+ DDA3              BCP_TURN_TO_CAM         EQU 6
  73+ DDA3              BCP_TURN_TO_DOOR        EQU 7
  74+ DDA3              BCP_KNOCKS_3            EQU 8
  75+ DDA3              BCP_WAIT_3              EQU 9
  76+ DDA3              BCP_PRE_HAND            EQU 10      ; antes BCP_DOOR_OPEN; ahora puerta no se abre
  77+ DDA3              BCP_HAND_IN             EQU 11
  78+ DDA3              BCP_HAND_NO_NO          EQU 12
  79+ DDA3              BCP_HAND_OUT            EQU 13
  80+ DDA3              BCP_KEY_DROP            EQU 14
  81+ DDA3              BCP_PLAYER_TURN_CAM     EQU 15
  82+ DDA3              BCP_DONE                EQU 16
  83+ DDA3              BCP_WAIT_NASTIES        EQU 17
  84+ DDA3              BCP_DOOR_CLOSED         EQU 18      ; pausa con puerta visible cerrada antes del key drop
  85+ DDA3              ; --- Beats nuevos: la mano abierta "coge" el cheque antes del "no no" ---
  86+ DDA3              BCP_HAND_OPEN_IN        EQU 19      ; mano abierta visible (espera) -> al expirar:
  87+ DDA3                                                  ;   clink + consume cheque + erase mano + cierra puerta
  88+ DDA3                                                  ;   -> entra DOOR_REPAUSE (BCP_HAND_OPEN_OUT)
  89+ DDA3              BCP_HAND_OPEN_OUT       EQU 21      ; puerta cerrada, pausa -> al expirar:
  90+ DDA3                                                  ;   reabre puerta + creak + dibuja "no no" frame 0 -> HAND_NO_NO
  91+ DDA3                                                  ; (BCP_HAND_OPEN_TAKE 20 deprecado — era pausa intermedia
  92+ DDA3                                                  ; con cheque ya tomado pero mano aun visible. Ahora la mano
  93+ DDA3                                                  ; desaparece al instante de cobrar el cheque.)
  94+ DDA3
  95+ DDA3              ; Sub-states del knock-loop (BankCutsceneSubState)
  96+ DDA3              BCS_KNOCK_HIT           EQU 0
  97+ DDA3              BCS_KNOCK_GAP           EQU 1
  98+ DDA3
  99+ DDA3              ; ==============================================================================
 100+ DDA3              ; Timings (frames a 50 Hz). Ajustables sin tocar logica.
 101+ DDA3              ; ==============================================================================
 102+ DDA3              BCS_T_LOCK              EQU 30      ; 1.2s lock inicial
 103+ DDA3              BCS_T_KNOCK_HIT         EQU 4       ; cada hit (door shake + sfx) — was 6
 104+ DDA3              BCS_T_KNOCK_GAP         EQU 5       ; gap entre toques — was 8
 105+ DDA3              BCS_T_GROUP_WAIT        EQU 50      ; 2s espera silenciosa tras cada grupo
 106+ DDA3              BCS_T_TURN_CAM          EQU 40      ; 1.6s mid-cutscene mirando camara
 107+ DDA3              BCS_T_TURN_BACK         EQU 10      ; transicion rapida de vuelta
 108+ DDA3              BCS_T_PRE_HAND          EQU 30      ; pausa tras los 6 toques antes de la mano
 109+ DDA3              BCS_T_PRE_HAND_HOLD     EQU 20      ; hold corto antes de hacer aparecer la mano
 110+ DDA3              BCS_T_HAND_IN           EQU 20      ; pause tras aparecer mano
 111+ DDA3              BCS_T_NO_FRAME          EQU 12      ; cada swap de "no no"
 112+ DDA3              BCS_T_HAND_HOLD         EQU 15      ; pausa tras ultimo swap
 113+ DDA3              ; (BCS_T_HAND_OUT eliminado: ahora HAND_OUT erase + key spawn van juntos.)
 114+ DDA3              BCS_T_DOOR_CLOSED_HOLD  EQU 30      ; pausa con puerta cerrada antes del key drop
 115+ DDA3              ; --- Anim de la mano abierta (HAND_OPEN_IN) ---
 116+ DDA3              ; Secuencia visible scripted: 1 1 2 1 2 1 1 (7 estados), termina en frame 1.
 117+ DDA3              ; Cada estado dura BCS_T_OPEN_HAND_SWAP. Tras el ultimo estado, hold estatico
 118+ DDA3              ; en frame 1 durante BCS_T_OPEN_HAND_HOLD antes del cobro.
 119+ DDA3              ; Tabla con bytes (0=frame 1, 1=frame 2): ver BCS_OpenHandSeq abajo.
 120+ DDA3              ; Total ~ SEQ_LEN*SWAP + HOLD frames.
 121+ DDA3              BCS_T_OPEN_HAND_SWAP    EQU 10      ; 0.4s por estado durante la anim
 122+ DDA3              BCS_OPEN_HAND_SEQ_LEN   EQU 7       ; longitud de la secuencia visible
 123+ DDA3              BCS_T_OPEN_HAND_HOLD    EQU 30      ; 1.2s hold estatico en el ultimo frame antes del cobro
 124+ DDA3              BCS_T_HAND_OPEN_OUT     EQU 75      ; 3.0s con puerta cerrada antes de reabrirse para "no no"
 125+ DDA3                                                  ; (subido de 50 -> 75; respiro mas largo entre cobro y "no no")
 126+ DDA3              BCS_T_KEY_HOLD          EQU 30      ; pausa tras drop antes de turn-cam
 127+ DDA3              BCS_T_PLAYER_TURN_FINAL EQU 30      ; 1.2s mirando camara antes de devolver control
 128+ DDA3              BCS_T_PUFF_WAIT         EQU 100     ; safety timeout WAIT_NASTIES (transicion real
 129+ DDA3                                                  ; es por check dinamico de "all nasties dead").
 130+ DDA3
 131+ DDA3              ; Cuentas
 132+ DDA3              BCS_GROUP1_KNOCKS       EQU 3
 133+ DDA3              BCS_GROUP2_KNOCKS       EQU 3
 134+ DDA3              BCS_GROUP3_KNOCKS       EQU 6
 135+ DDA3              BCS_NO_SWAPS_TOTAL      EQU 8       ; 4 "no" × 2 swaps = 8 transiciones
 136+ DDA3
 137+ DDA3              ; SFX "no no" — dos tonos alternos en canal B, tipo "uh-oh" cartoonish.
 138+ DDA3              ; Period AY = 1.7734 MHz / (16 * freq). Tercera mayor descendente Mi→Do.
 139+ DDA3              ; AY_PlayBeep recibe HL = period, B = duracion frames.
 140+ DDA3              BCS_NO_PERIOD_HI        EQU $0150   ; Mi (E4, ~330 Hz) — nota aguda
 141+ DDA3              BCS_NO_PERIOD_LO        EQU $01A8   ; Do (C4, ~262 Hz) — nota grave
 142+ DDA3              BCS_NO_DUR_FRAMES       EQU 6       ; ~240ms staccato (gap antes del proximo swap @12f)
 143+ DDA3
 144+ DDA3              ; ==============================================================================
 145+ DDA3              ; Sala + posiciones (placeholders; verificar in-game)
 146+ DDA3              ; ==============================================================================
 147+ DDA3              BCS_BANK_ROOM_X         EQU 8       ; sala del banco (norte del ayuntamiento)
 148+ DDA3              BCS_BANK_ROOM_Y         EQU 8
 149+ DDA3
 150+ DDA3              ; Anchor del player durante la cinematica — siempre centrado horizontalmente
 151+ DDA3              ; con la puerta (chars 15-16, centro X = 128; player 16 px ancho → POSX = 120).
 152+ DDA3              ;
 153+ DDA3              ; Y depende de la sub-fase:
 154+ DDA3              ;   KNOCK   → 1 px de hueco bajo la puerta (door_bottom 63 → POSY 65; px 64 vacio).
 155+ DDA3              ;   RETREAT → 1 char (8 px) bajo la puerta (POSY 72; px 64-71 vacios).
 156+ DDA3              BCS_PLAYER_ANCHOR_X     EQU 120
 157+ DDA3              BCS_PLAYER_ANCHOR_Y     EQU 65      ; KNOCK: 1 px hueco bajo la puerta
 158+ DDA3              BCS_PLAYER_RETREAT_Y    EQU 72      ; RETREAT: 1 char (8 px) hueco
 159+ DDA3              BCS_PLAYER_BACKOFF_Y    EQU 80      ; BACKOFF: 2 char (16 px) hueco — reaccion al portazo final
 160+ DDA3                                                  ; (player baja 1 char extra vs RETREAT al cierre tras "no no")
 161+ DDA3
 162+ DDA3              ; Posicion de la puerta del banco — confirmada por el usuario en el editor:
 163+ DDA3              ; Cell (8,8), char (15, 4). Asumo tamaño 2x2 chars (16x16 px) — mismo
 164+ DDA3              ; tamaño que el sprite de la mano. Si el sprite real BankDoorOpen es
 165+ DDA3              ; mas grande (e.g. 3x3 o 4x4), ajustar BCS_DOOR_CHAR_W/H.
 166+ DDA3              ;
 167+ DDA3              ; Bank facade en char (12, 0), 64x48 px → (12-19, 0-5). Door en (15, 4)
 168+ DDA3              ; cae en la mitad inferior central de la facade. Pixel coords con
 169+ DDA3              ; BG_Y_OFFSET=2: top-left = (15*8, (4+2)*8) = (120, 48).
 170+ DDA3              BCS_DOOR_CHARX          EQU 15
 171+ DDA3              BCS_DOOR_CHARY          EQU 4
 172+ DDA3              BCS_DOOR_CHAR_W         EQU 2       ; ancho en chars (16 px)
 173+ DDA3              BCS_DOOR_CHAR_H         EQU 2       ; alto en chars (16 px)
 174+ DDA3
 175+ DDA3              ; AABB en pixels (derivado de char coords)
 176+ DDA3              BCS_DOOR_PX_LEFT        EQU 120     ; 15*8
 177+ DDA3              BCS_DOOR_PX_RIGHT       EQU 135     ; 120 + 16 - 1
 178+ DDA3              BCS_DOOR_PX_TOP         EQU 48      ; (4+2)*8
 179+ DDA3              BCS_DOOR_PX_BOTTOM      EQU 63      ; 48 + 16 - 1
 180+ DDA3              BCS_DOOR_TOLERANCE      EQU 4       ; mismo margen que CheckTownGateTriggerBg
 181+ DDA3
 182+ DDA3              ; Posicion de la mano cuando asoma (centrada en el hueco de la puerta)
 183+ DDA3              BCS_HAND_PX_X           EQU 120     ; mismo X que la puerta (16x16 sprite)
 184+ DDA3              BCS_HAND_PX_Y           EQU 48      ; mismo Y que la puerta
 185+ DDA3
 186+ DDA3              ; Posicion (char) donde se dibuja BankKey al final — placeholder
 187+ DDA3              ; (suelo justo delante de la puerta)
 188+ DDA3              BCS_KEY_DROP_CHARX      EQU 15
 189+ DDA3              BCS_KEY_DROP_CHARY      EQU 7
 190+ DDA3
 191+ DDA3              ; Trigger requirements
 192+ DDA3              BCS_REQUIRED_KEY        EQU 7       ; BankCheck (slot 7 en KeyLockTable, NUEVO)
 193+ DDA3
 194+ DDA3              ; ==============================================================================
 195+ DDA3              ; CheckBankTriggerBg - bump-trigger del banco (BG sprite, no en PickupTable)
 196+ DDA3              ; ==============================================================================
 197+ DDA3              ; Llamada cada frame desde MainLoop tras CheckBumpTriggers (gemelo de
 198+ DDA3              ; CheckTownGateTriggerBg). Mismo test AABB ±BCS_DOOR_TOLERANCE.
 199+ DDA3              ;
 200+ DDA3              ; Dispara: BankCutscenePhase==0, CurrentKey==7 (BankCheck), sala (8,8),
 201+ DDA3              ; player AABB (16x21) overlapea rect de la puerta. HIT → StartBankCutscene
 202+ DDA3              ; + CheckMilestoneTrigger(4) (avanza M9).
 203+ DDA3              ; Destruye: AF, BC, DE, HL, IX.
 204+ DDA3              ;
 205+ DDA3              ; NOTA: llamado a traves del thunk CheckBankTriggerBg (slot 1), que pagina
 206+ DDA3              ; bank 7 antes de saltar aqui. Por eso este label es ...Body (el nombre publico
 207+ DDA3              ; sin sufijo lo lleva el thunk).
 208+ DDA3              ; ==============================================================================
 209+ DDA3              CheckBankTriggerBgBody:
 210+ DDA3 3A D1 82         LD A, (BankCutscenePhase)
 211+ DDA6 B7               OR A
 212+ DDA7 C0               RET NZ                              ; ya en cutscene
 213+ DDA8 3A B6 82         LD A, (CurrentKey)
 214+ DDAB FE 07            CP BCS_REQUIRED_KEY
 215+ DDAD C0               RET NZ                              ; sin cheque
 216+ DDAE 3A 10 83         LD A, (CurrentScreenX)
 217+ DDB1 FE 08            CP BCS_BANK_ROOM_X
 218+ DDB3 C0               RET NZ
 219+ DDB4 3A 11 83         LD A, (CurrentScreenY)
 220+ DDB7 FE 08            CP BCS_BANK_ROOM_Y
 221+ DDB9 C0               RET NZ
 222+ DDBA                  ; --- Horizontal AABB ---
 223+ DDBA 3A A6 81         LD A, (EntityTable + ENT_POSX)
 224+ DDBD 4F               LD C, A                             ; C = player_left
 225+ DDBE C6 10            ADD A, 16
 226+ DDC0 57               LD D, A                             ; D = player_right
 227+ DDC1 3E 78            LD A, BCS_DOOR_PX_LEFT
 228+ DDC3 D6 04            SUB BCS_DOOR_TOLERANCE
 229+ DDC5 30 01            JR NC, .cbtNoUnderL
 230+ DDC7 AF               XOR A
 231+ DDC8              .cbtNoUnderL:
 232+ DDC8 BA               CP D
 233+ DDC9 D0               RET NC
 234+ DDCA 3E 87            LD A, BCS_DOOR_PX_RIGHT
 235+ DDCC C6 04            ADD A, BCS_DOOR_TOLERANCE
 236+ DDCE 30 02            JR NC, .cbtNoOverR
 237+ DDD0 3E FF            LD A, $FF
 238+ DDD2              .cbtNoOverR:
 239+ DDD2 B9               CP C
 240+ DDD3 D8               RET C
 241+ DDD4                  ; --- Vertical AABB (player rect 16x21) ---
 242+ DDD4 3A A7 81         LD A, (EntityTable + ENT_POSY)
 243+ DDD7 4F               LD C, A
 244+ DDD8 C6 15            ADD A, 21
 245+ DDDA 57               LD D, A
 246+ DDDB 3E 30            LD A, BCS_DOOR_PX_TOP
 247+ DDDD D6 04            SUB BCS_DOOR_TOLERANCE
 248+ DDDF 30 01            JR NC, .cbtNoUnderT
 249+ DDE1 AF               XOR A
 250+ DDE2              .cbtNoUnderT:
 251+ DDE2 BA               CP D
 252+ DDE3 D0               RET NC
 253+ DDE4 3E 3F            LD A, BCS_DOOR_PX_BOTTOM
 254+ DDE6 C6 04            ADD A, BCS_DOOR_TOLERANCE
 255+ DDE8 30 02            JR NC, .cbtNoOverB
 256+ DDEA 3E FF            LD A, $FF
 257+ DDEC              .cbtNoOverB:
 258+ DDEC B9               CP C
 259+ DDED D8               RET C
 260+ DDEE                  ; HIT
 261+ DDEE CD F6 DD         CALL StartBankCutscene
 262+ DDF1 3E 04            LD A, 4                             ; action 4 = BankDoor
 263+ DDF3 C3 4D 6D         JP CheckMilestoneTrigger_B7         ; tail-call al thunk slot 1 (que repagina bank 7 antes de RET)
 264+ DDF6
 265+ DDF6              ; ==============================================================================
 266+ DDF6              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 267+ DDF6              ; ==============================================================================
 268+ DDF6              ; 1. NO consume cheque aqui — se consume despues, en la transicion
 269+ DDF6              ;    HAND_OPEN_IN -> HAND_OPEN_TAKE (la mano abierta "coge" el cheque
 270+ DDF6              ;    visualmente). El bloqueo del re-trigger lo da el check de phase != 0
 271+ DDF6              ;    en CheckBankTriggerBg.
 272+ DDF6              ; 2. Snap player a anchor frente a la puerta, facing N.
 273+ DDF6              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 274+ DDF6              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 275+ DDF6              ;    para limpiar la pantalla durante la cutscene.
 276+ DDF6              ; Destruye: AF, BC, DE, HL, IX.
 277+ DDF6              ; ==============================================================================
 278+ DDF6              StartBankCutscene:
 279+ DDF6 AF               XOR A
 280+ DDF7 32 D4 82         LD (BankCutsceneKnockIdx), A
 281+ DDFA 32 D3 82         LD (BankCutsceneSubState), A
 282+ DDFD 32 D5 82         LD (BankCutsceneNoIdx), A
 283+ DE00 32 D6 82         LD (BankCutsceneHandFrame), A
 284+ DE03                  ; Resetea el color del player al default (WHITE | $40 = $47). Si el player
 285+ DE03                  ; tenia color de un buff (speed, mushroom...) o de un hit (BLUE flash), se
 286+ DE03                  ; pierde aqui. Sino el player aparece tintado durante toda la cinematica.
 287+ DE03 3E 47            LD A, WHITE | $40
 288+ DE05 32 A8 81         LD (EntityTable + ENT_ATTR), A
 289+ DE08 CD 65 6D         CALL KillAllActiveNasties_B7           ; nasties → STATE_DYING + puff anim
 290+ DE0B CD 6B 6D         CALL KillDeathIfActive_B7               ; muerte (slot 11) → puff y despawn
 291+ DE0E                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 292+ DE0E                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 293+ DE0E                  ; cambiamos el sprite a facing N para preparar.
 294+ DE0E CD 91 DE         CALL BankCutsceneFacingNRedraw
 295+ DE11 CD 19 E2         CALL SFX_Bank_OnStart
 296+ DE14                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 297+ DE14                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 298+ DE14                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 299+ DE14 3E 64            LD A, BCS_T_PUFF_WAIT
 300+ DE16 32 D2 82         LD (BankCutsceneTimer), A
 301+ DE19 3E 11            LD A, BCP_WAIT_NASTIES
 302+ DE1B 32 D1 82         LD (BankCutscenePhase), A
 303+ DE1E C9               RET
 304+ DE1F
 305+ DE1F              ; ==============================================================================
 306+ DE1F              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 307+ DE1F              ; ==============================================================================
 308+ DE1F              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 309+ DE1F              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 310+ DE1F              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 311+ DE1F              BankCutsceneSnapToDoor:
 312+ DE1F DD 21 A3 81      LD IX, EntityTable
 313+ DE23 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 314+ DE27 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 315+ DE2B DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 316+ DE2F 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 317+ DE31 32 E4 82         LD (PlayerDrawY), A
 318+ DE34 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 319+ DE36 DD 77 00         LD (IX+ENT_SPRITEID), A
 320+ DE39 3E 0A            LD A, SPRID_WALK_N
 321+ DE3B DD 77 08         LD (IX+ENT_ANIMBASE), A
 322+ DE3E AF               XOR A
 323+ DE3F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 324+ DE42 C3 56 6D         JP TownGateRedrawPlayer_B7
 325+ DE45
 326+ DE45              ; ==============================================================================
 327+ DE45              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 328+ DE45              ; ==============================================================================
 329+ DE45              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 330+ DE45              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 331+ DE45              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 332+ DE45              BankCutsceneSnapToRetreat:
 333+ DE45 DD 21 A3 81      LD IX, EntityTable
 334+ DE49 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 335+ DE4D DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 336+ DE51 DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 337+ DE55 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 338+ DE57 32 E4 82         LD (PlayerDrawY), A
 339+ DE5A 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 340+ DE5C DD 77 00         LD (IX+ENT_SPRITEID), A
 341+ DE5F 3E 0A            LD A, SPRID_WALK_N
 342+ DE61 DD 77 08         LD (IX+ENT_ANIMBASE), A
 343+ DE64 AF               XOR A
 344+ DE65 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 345+ DE68 C3 56 6D         JP TownGateRedrawPlayer_B7
 346+ DE6B
 347+ DE6B              ; ==============================================================================
 348+ DE6B              ; BankCutsceneSnapToBackOff - teleport player a anchor BACKOFF (centrado + 2 char hueco)
 349+ DE6B              ; ==============================================================================
 350+ DE6B              ; Llamado al cerrarse la puerta tras el "no no" (.bcPhHandOut). El player baja
 351+ DE6B              ; 1 char extra respecto a RETREAT como reaccion al portazo final.
 352+ DE6B              ; Mismo X que los demas anchors (centrado con la puerta), Y=80 (door bottom 63,
 353+ DE6B              ; 16 px de hueco, top del player en 80). Sigue facing N.
 354+ DE6B              BankCutsceneSnapToBackOff:
 355+ DE6B DD 21 A3 81      LD IX, EntityTable
 356+ DE6F DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 357+ DE73 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 358+ DE77 DD 36 04 50      LD (IX+ENT_POSY), BCS_PLAYER_BACKOFF_Y
 359+ DE7B 3E 50            LD A, BCS_PLAYER_BACKOFF_Y
 360+ DE7D 32 E4 82         LD (PlayerDrawY), A
 361+ DE80 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 362+ DE82 DD 77 00         LD (IX+ENT_SPRITEID), A
 363+ DE85 3E 0A            LD A, SPRID_WALK_N
 364+ DE87 DD 77 08         LD (IX+ENT_ANIMBASE), A
 365+ DE8A AF               XOR A
 366+ DE8B DD 77 09         LD (IX+ENT_ANIMTIMER), A
 367+ DE8E C3 56 6D         JP TownGateRedrawPlayer_B7
 368+ DE91
 369+ DE91              ; ==============================================================================
 370+ DE91              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 371+ DE91              ; ==============================================================================
 372+ DE91              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 373+ DE91              ; para asegurar que el player mira a la puerta antes del primer snap.
 374+ DE91              BankCutsceneFacingNRedraw:
 375+ DE91 DD 21 A3 81      LD IX, EntityTable
 376+ DE95 DD 7E 04         LD A, (IX+ENT_POSY)
 377+ DE98 32 E4 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 378+ DE9B 3E 0B            LD A, SPRID_WALK_N + 1
 379+ DE9D DD 77 00         LD (IX+ENT_SPRITEID), A
 380+ DEA0 3E 0A            LD A, SPRID_WALK_N
 381+ DEA2 DD 77 08         LD (IX+ENT_ANIMBASE), A
 382+ DEA5 AF               XOR A
 383+ DEA6 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 384+ DEA9 C3 56 6D         JP TownGateRedrawPlayer_B7
 385+ DEAC
 386+ DEAC              ; ==============================================================================
 387+ DEAC              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 388+ DEAC              ; ==============================================================================
 389+ DEAC              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 390+ DEAC              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 391+ DEAC              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 392+ DEAC              ; resuelve KillAllActiveNasties de StartBankCutscene).
 393+ DEAC              ; Destruye: AF, BC, DE, HL, IX.
 394+ DEAC              ; ==============================================================================
 395+ DEAC              UpdateBankCutsceneBody:
 396+ DEAC 3A D1 82         LD A, (BankCutscenePhase)
 397+ DEAF FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 398+ DEB1 CA 04 DF         JP Z, .bcPhWaitNasties
 399+ DEB4 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 400+ DEB6 CA 0E E1         JP Z, .bcPhDoorClosed
 401+ DEB9 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 402+ DEBB                                                      ;   clink + consume cheque + erase mano + cierra puerta
 403+ DEBB CA 35 E0         JP Z, .bcPhHandOpenIn
 404+ DEBE FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 405+ DEC0 CA 94 E0         JP Z, .bcPhHandOpenOut
 406+ DEC3 3D               DEC A
 407+ DEC4 CA 1E DF         JP Z, .bcPhLock
 408+ DEC7 3D               DEC A
 409+ DEC8 CA 3C DF         JP Z, .bcPhKnocks1
 410+ DECB 3D               DEC A
 411+ DECC CA 51 DF         JP Z, .bcPhWait1
 412+ DECF 3D               DEC A
 413+ DED0 CA 72 DF         JP Z, .bcPhKnocks2
 414+ DED3 3D               DEC A
 415+ DED4 CA 87 DF         JP Z, .bcPhWait2
 416+ DED7 3D               DEC A
 417+ DED8 CA A9 DF         JP Z, .bcPhTurnToCam
 418+ DEDB 3D               DEC A
 419+ DEDC CA CD DF         JP Z, .bcPhTurnToDoor
 420+ DEDF 3D               DEC A
 421+ DEE0 CA EF DF         JP Z, .bcPhKnocks3
 422+ DEE3 3D               DEC A
 423+ DEE4 CA 04 E0         JP Z, .bcPhWait3
 424+ DEE7 3D               DEC A
 425+ DEE8 CA 16 E0         JP Z, .bcPhPreHand
 426+ DEEB 3D               DEC A
 427+ DEEC CA B3 E0         JP Z, .bcPhHandIn
 428+ DEEF 3D               DEC A
 429+ DEF0 CA C2 E0         JP Z, .bcPhHandNoNo
 430+ DEF3 3D               DEC A
 431+ DEF4 CA F3 E0         JP Z, .bcPhHandOut
 432+ DEF7 3D               DEC A
 433+ DEF8 CA 2E E1         JP Z, .bcPhKeyDrop
 434+ DEFB 3D               DEC A
 435+ DEFC CA 53 E1         JP Z, .bcPhPlayerTurnCam
 436+ DEFF                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 437+ DEFF AF               XOR A
 438+ DF00 32 D1 82         LD (BankCutscenePhase), A
 439+ DF03 C9               RET
 440+ DF04
 441+ DF04              ; ---- Phase 17: WAIT_NASTIES ----
 442+ DF04              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 443+ DF04              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 444+ DF04              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 445+ DF04              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 446+ DF04              ;
 447+ DF04              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 448+ DF04              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 449+ DF04              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 450+ DF04              .bcPhWaitNasties:
 451+ DF04 CD 65 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 452+ DF07 CD 21 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 453+ DF0A 28 04            JR Z, .bcWaitNastiesDone
 454+ DF0C CD 10 E2         CALL BankCutsceneDecTimer           ; safety timeout
 455+ DF0F C0               RET NZ
 456+ DF10              .bcWaitNastiesDone:
 457+ DF10 CD 1F DE         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 458+ DF13 3E 1E            LD A, BCS_T_LOCK
 459+ DF15 32 D2 82         LD (BankCutsceneTimer), A
 460+ DF18 3E 01            LD A, BCP_LOCK
 461+ DF1A 32 D1 82         LD (BankCutscenePhase), A
 462+ DF1D C9               RET
 463+ DF1E
 464+ DF1E              ; ---- Phase 1: lock + facing UP ----
 465+ DF1E              .bcPhLock:
 466+ DF1E CD 10 E2         CALL BankCutsceneDecTimer
 467+ DF21 C0               RET NZ
 468+ DF22                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DF22 AF               XOR A
 470+ DF23 32 D4 82         LD (BankCutsceneKnockIdx), A
 471+ DF26 32 D7 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DF29 3E 00            LD A, BCS_KNOCK_HIT
 473+ DF2B 32 D3 82         LD (BankCutsceneSubState), A
 474+ DF2E 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DF30 32 D2 82         LD (BankCutsceneTimer), A
 476+ DF33 CD 98 E1         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DF36 3E 02            LD A, BCP_KNOCKS_1
 478+ DF38 32 D1 82         LD (BankCutscenePhase), A
 479+ DF3B C9               RET
 480+ DF3C
 481+ DF3C              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 482+ DF3C              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 483+ DF3C              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 484+ DF3C              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 485+ DF3C              .bcPhKnocks1:
 486+ DF3C 3E 03            LD A, BCS_GROUP1_KNOCKS
 487+ DF3E CD 5D E1         CALL BankCutsceneTickKnockGroup
 488+ DF41 B7               OR A
