 223+ DAC1 22 E4 DA         LD (.dpxDstBot), HL
 224+ DAC4
 225+ DAC4 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 226+ DAC5 E1               POP HL                          ; src ptr
 227+ DAC6 10 BC            DJNZ .dpxByteLoop
 228+ DAC8
 229+ DAC8                  ; Avanzar a siguiente src row
 230+ DAC8 22 E0 DA         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 231+ DACB 3A DF DA         LD A, (.dpxDstY)
 232+ DACE C6 02            ADD A, 2                        ; 2 dst rows por 1 src row
 233+ DAD0 32 DF DA         LD (.dpxDstY), A
 234+ DAD3 3A DE DA         LD A, (.dpxRowsLeft)
 235+ DAD6 3D               DEC A
 236+ DAD7 32 DE DA         LD (.dpxRowsLeft), A
 237+ DADA C2 6D DA         JP NZ, .dpxNextRow
 238+ DADD C9               RET
 239+ DADE
 240+ DADE 00           .dpxRowsLeft:   DEFB 0
 241+ DADF 00           .dpxDstY:       DEFB 0
 242+ DAE0 00 00        .dpxSrcPtr:     DEFW 0
 243+ DAE2 00 00        .dpxDstTop:     DEFW 0
 244+ DAE4 00 00        .dpxDstBot:     DEFW 0
 245+ DAE6
 246+ DAE6              ; ==============================================================================
 247+ DAE6              ; DrawTombAttrs2x - 30 src attrs (6×5) → 120 dst attrs (12×10) en attr VRAM
 248+ DAE6              ; ==============================================================================
 249+ DAE6              ; Cada src attr se replica en bloque 2×2 chars en dst.
 250+ DAE6              ; Src ptr en TombAttrSrcPtr (set por DecodeTombRLEPixels).
 251+ DAE6              ; Dst start: $5800 + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X.
 252+ DAE6              ;
 253+ DAE6              ; Destruye: AF, BC, DE, HL.
 254+ DAE6              ; ==============================================================================
 255+ DAE6              DrawTombAttrs2x:
 256+ DAE6 2A 1D DC         LD HL, (TombAttrSrcPtr)         ; HL = src attrs (en BgSpriteBuffer)
 257+ DAE9 11 4A 59         LD DE, ATTR_BASE + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X
 258+ DAEC 3E 05            LD A, TOMB_SRC_ATTR_H           ; 5 src rows
 259+ DAEE              .daxRow:
 260+ DAEE 32 1C DB         LD (.daxRowsLeft), A
 261+ DAF1 D5               PUSH DE                         ; guardar dst row top start
 262+ DAF2 06 06            LD B, TOMB_SRC_ATTR_W           ; 6 src attrs por row
 263+ DAF4              .daxCol:
 264+ DAF4 7E               LD A, (HL)
 265+ DAF5 23               INC HL
 266+ DAF6 12               LD (DE), A                      ; dst top col 2N
 267+ DAF7 13               INC DE
 268+ DAF8 12               LD (DE), A                      ; dst top col 2N+1
 269+ DAF9 13               INC DE
 270+ DAFA 10 F8            DJNZ .daxCol
 271+ DAFC                  ; Replicar la dst row top a dst row top+1 (= +32 bytes)
 272+ DAFC D1               POP DE                          ; DE = dst row top start
 273+ DAFD E5               PUSH HL                         ; save src ptr
 274+ DAFE 62               LD H, D
 275+ DAFF 6B               LD L, E                         ; HL = dst row top start
 276+ DB00 7B               LD A, E
 277+ DB01 C6 20            ADD A, 32
 278+ DB03 5F               LD E, A
 279+ DB04 30 01            JR NC, .daxNoCarry1
 280+ DB06 14               INC D
 281+ DB07              .daxNoCarry1:
 282+ DB07                  ; HL = top row start, DE = bot row start. LDIR 12 bytes.
 283+ DB07 01 0C 00         LD BC, TOMB_SRC_ATTR_W * 2      ; 12
 284+ DB0A ED B0            LDIR                            ; copy 12 attrs from top row to bot row
 285+ DB0C                  ; DE ahora apunta al char tras la última col de bot row.
 286+ DB0C                  ; Necesitamos resetear DE al inicio de la siguiente "row top" = +32 desde
 287+ DB0C                  ; donde estamos. Calculemos: bot row inició en (top + 32). Tras LDIR de 12
 288+ DB0C                  ; bytes, DE = top + 32 + 12. Próxima top row = top + 64.
 289+ DB0C                  ; → DE += 32 - 12 = +20.
 290+ DB0C 7B               LD A, E
 291+ DB0D C6 14            ADD A, 32 - TOMB_SRC_ATTR_W * 2
 292+ DB0F 5F               LD E, A
 293+ DB10 30 01            JR NC, .daxNoCarry2
 294+ DB12 14               INC D
 295+ DB13              .daxNoCarry2:
 296+ DB13 E1               POP HL                          ; restore src ptr
 297+ DB14 3A 1C DB         LD A, (.daxRowsLeft)
 298+ DB17 3D               DEC A
 299+ DB18 C2 EE DA         JP NZ, .daxRow
 300+ DB1B C9               RET
 301+ DB1C
 302+ DB1C 00           .daxRowsLeft:   DEFB 0
 303+ DB1D
 304+ DB1D              ; ==============================================================================
 305+ DB1D              ; LUT: nibble (4 bits abcd) → byte doblado (aabbccdd)
 306+ DB1D              ; ==============================================================================
 307+ DB1D              NibbleDoubleLUT:
 308+ DB1D 00               DEFB %00000000  ; 0000 → 00000000
 309+ DB1E 03               DEFB %00000011  ; 0001 → 00000011
 310+ DB1F 0C               DEFB %00001100  ; 0010 → 00001100
 311+ DB20 0F               DEFB %00001111  ; 0011 → 00001111
 312+ DB21 30               DEFB %00110000  ; 0100 → 00110000
 313+ DB22 33               DEFB %00110011  ; 0101 → 00110011
 314+ DB23 3C               DEFB %00111100  ; 0110 → 00111100
 315+ DB24 3F               DEFB %00111111  ; 0111 → 00111111
 316+ DB25 C0               DEFB %11000000  ; 1000 → 11000000
 317+ DB26 C3               DEFB %11000011  ; 1001 → 11000011
 318+ DB27 CC               DEFB %11001100  ; 1010 → 11001100
 319+ DB28 CF               DEFB %11001111  ; 1011 → 11001111
 320+ DB29 F0               DEFB %11110000  ; 1100 → 11110000
 321+ DB2A F3               DEFB %11110011  ; 1101 → 11110011
 322+ DB2B FC               DEFB %11111100  ; 1110 → 11111100
 323+ DB2C FF               DEFB %11111111  ; 1111 → 11111111
 324+ DB2D
 325+ DB2D              ; ==============================================================================
 326+ DB2D              ; Buffer plano de pixeles decodificados (240 B). Cold storage en slot 1.
 327+ DB2D              ; Vivirá en .lst después del code; sjasmplus lo ubica donde el ORG actual.
 328+ DB2D              ; ==============================================================================
 329+ DB2D              TombDecodedPixels:
 330+ DB2D 00 00 00...      DEFS TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes
 331+ DC1D
 332+ DC1D              ; ==============================================================================
 333+ DC1D              ; Variable global: ptr a la sección de attrs en BgSpriteBuffer (set por
 334+ DC1D              ; DecodeTombRLEPixels). 16-bit, en slot 1 (cold).
 335+ DC1D              ; ==============================================================================
 336+ DC1D              TombAttrSrcPtr:
 337+ DC1D 00 00            DEFW 0
