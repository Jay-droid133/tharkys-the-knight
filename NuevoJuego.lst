 369+ EC43 21 2D 58         LD HL, $582D
 370+ EC46 DD 7E 06         LD A, (IX+6)
 370+ EC49 CD 3B E4       CALL ApplyDayCycleRemap
 370+ EC4C 77             LD (HL), A
 370+ EC4D 23             INC HL
 371+ EC4E DD 7E 07         LD A, (IX+7)
 371+ EC51 CD 3B E4       CALL ApplyDayCycleRemap
 371+ EC54 77             LD (HL), A
 371+ EC55 23             INC HL
 372+ EC56 DD 7E 08         LD A, (IX+8)
 372+ EC59 77                                       LD (HL), A
 372+ EC5A 23             INC HL  ; esfera
