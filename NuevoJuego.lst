 505+ EC7F C9               RET
 506+ EC80
 507+ EC80              ; ==============================================================================
 508+ EC80              ; ApplyRayoBuff - speed boost 1.5x durante 15s (color via cycler)
 509+ EC80              ; ==============================================================================
 510+ EC80              ; "Last wins": llamar de nuevo resetea timer + override estado actual.
 511+ EC80              ; ==============================================================================
 512+ EC80              ApplyRayoBuff:
 513+ EC80 3E 06            LD A, SPEED_BUFF_RAYO_RUN
 514+ EC82 32 DA 82         LD (PlayerSpeedRun), A
 515+ EC85 3E 03            LD A, SPEED_BUFF_RAYO_FIGHT
 516+ EC87 32 DB 82         LD (PlayerSpeedFight), A
 517+ EC8A 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 518+ EC8D 22 DC 82         LD (SpeedBuffTimer), HL
 519+ EC90 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 520+ EC92 32 DE 82         LD (SpeedBuffType), A
 521+ EC95                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 522+ EC95 C9               RET
 523+ EC96
 524+ EC96              ; ==============================================================================
 525+ EC96              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 526+ EC96              ; ==============================================================================
 527+ EC96              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 528+ EC96              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 529+ EC96              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 530+ EC96              ; ==============================================================================
 531+ EC96              ApplyMushroomBuff:
 532+ EC96 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 533+ EC99 22 DF 82         LD (MushroomLockTimer), HL
 534+ EC9C                  ; Antagonista 'last wins': SETA cancela ESPADA (ambos tocan can-attack).
 535+ EC9C 21 00 00         LD HL, 0
 536+ EC9F 22 DA 5F         LD (EspadaTimer), HL
 537+ ECA2                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 538+ ECA2 C9               RET
 539+ ECA3
 540+ ECA3              ; ==============================================================================
 541+ ECA3              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 542+ ECA3              ; ==============================================================================
 543+ ECA3              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 544+ ECA3              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 545+ ECA3              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 546+ ECA3              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 547+ ECA3              ; si no, restaura WHITE | $40.
 548+ ECA3              ; ==============================================================================
 549+ ECA3              UpdateMushroomBuffBody:
 550+ ECA3 2A DF 82         LD HL, (MushroomLockTimer)
 551+ ECA6 7C               LD A, H
 552+ ECA7 B5               OR L
 553+ ECA8 C8               RET Z                               ; sin debuff
 554+ ECA9 2B               DEC HL
 555+ ECAA 22 DF 82         LD (MushroomLockTimer), HL
 556+ ECAD C9               RET                                 ; (color lo pinta el cycler segun timer)
 557+ ECAE
 558+ ECAE              ; ==============================================================================
 559+ ECAE              ; ApplyEspadaBuff - ESPADA (no consume stamina + ataca a 0 + cancela cooldown)
 560+ ECAE              ; ==============================================================================
 561+ ECAE              ; Duracion: ESPADA_BUFF_FRAMES (12s). Player rojo bright (color via cycler).
 562+ ECAE              ; Antagonista 'last wins' con SETA — cancela MushroomLockTimer al activarse.
 563+ ECAE              ; Gates en logic_game.asm: SelectSwordMode fuerza mode 2, stamina drain skip,
 564+ ECAE              ; AttackCooldown set skip.
 565+ ECAE              ; ==============================================================================
 566+ ECAE              ApplyEspadaBuff:
 567+ ECAE 21 2C 01         LD HL, ESPADA_BUFF_FRAMES
 568+ ECB1 22 DA 5F         LD (EspadaTimer), HL
 569+ ECB4 21 00 00         LD HL, 0
 570+ ECB7 22 DF 82         LD (MushroomLockTimer), HL          ; antagonista last wins
 571+ ECBA C9               RET
 572+ ECBB
 573+ ECBB              ; ==============================================================================
 574+ ECBB              ; UpdateEspadaBuffBody - tick 16-bit EspadaTimer
 575+ ECBB              ; ==============================================================================
 576+ ECBB              UpdateEspadaBuffBody:
 577+ ECBB 2A DA 5F         LD HL, (EspadaTimer)
 578+ ECBE 7C               LD A, H
 579+ ECBF B5               OR L
 580+ ECC0 C8               RET Z
 581+ ECC1 2B               DEC HL
 582+ ECC2 22 DA 5F         LD (EspadaTimer), HL
 583+ ECC5 C9               RET                                 ; (color via cycler, gates via logic_game)
 584+ ECC6
 585+ ECC6              ; ==============================================================================
 586+ ECC6              ; ApplyEscudoBuff - ESCUDO (invuln nasti/monster, knockback persiste)
 587+ ECC6              ; ==============================================================================
 588+ ECC6              ; Duracion: ESCUDO_BUFF_FRAMES (15s). Player amarillo bright (color via cycler).
 589+ ECC6              ; Gate en CheckPlayerEnemyCollision: skip HP decrement si EscudoTimer > 0.
 590+ ECC6              ; ==============================================================================
 591+ ECC6              ApplyEscudoBuff:
 592+ ECC6 21 77 01         LD HL, ESCUDO_BUFF_FRAMES
 593+ ECC9 22 DC 5F         LD (EscudoTimer), HL
 594+ ECCC C9               RET
 595+ ECCD
 596+ ECCD              ; ==============================================================================
 597+ ECCD              ; UpdateEscudoBuffBody - tick 16-bit EscudoTimer
 598+ ECCD              ; ==============================================================================
 599+ ECCD              UpdateEscudoBuffBody:
 600+ ECCD 2A DC 5F         LD HL, (EscudoTimer)
 601+ ECD0 7C               LD A, H
 602+ ECD1 B5               OR L
 603+ ECD2 C8               RET Z
 604+ ECD3 2B               DEC HL
 605+ ECD4 22 DC 5F         LD (EscudoTimer), HL
 606+ ECD7 C9               RET
 607+ ECD8
 608+ ECD8              ; ==============================================================================
 609+ ECD8              ; ApplyEscudoRayoBuff - combo ESCUDO + RAYO (atajo)
 610+ ECD8              ; ==============================================================================
 611+ ECD8              ; Es un solo pickup raro (categoria 'Especiales') que setea ambos timers a su
 612+ ECD8              ; duracion completa. El cycler ve dos timers activos -> cycla CYAN + YELLOW.
 613+ ECD8              ; ==============================================================================
 614+ ECD8              ApplyEscudoRayoBuff:
 615+ ECD8 21 77 01         LD HL, ESCUDO_BUFF_FRAMES
 616+ ECDB 22 DC 5F         LD (EscudoTimer), HL
 617+ ECDE C3 80 EC         JP ApplyRayoBuff                    ; tail call intra-body (set RAYO timer + type)
 618+ ECE1
 619+ ECE1              ; ==============================================================================
 620+ ECE1              ; ApplyReverseBuff - REVERSE (controles Q<->A, O<->P invertidos durante 7s)
 621+ ECE1              ; ==============================================================================
 622+ ECE1              ; Player azul oscuro bright (color via cycler). Sin antagonistas — REVERSE
 623+ ECE1              ; no comparte eje con ningun otro buff (toca solo input direction).
 624+ ECE1              ; Gate en ReadInput de logic_game.asm: swap bits N<->S y E<->W si timer > 0.
 625+ ECE1              ; ==============================================================================
 626+ ECE1              ApplyReverseBuff:
 627+ ECE1 21 AF 00         LD HL, REVERSE_BUFF_FRAMES
 628+ ECE4 22 DE 5F         LD (ReverseTimer), HL
 629+ ECE7 C9               RET
 630+ ECE8
 631+ ECE8              ; ==============================================================================
 632+ ECE8              ; UpdateReverseBuffBody - tick 16-bit ReverseTimer
 633+ ECE8              ; ==============================================================================
 634+ ECE8              UpdateReverseBuffBody:
 635+ ECE8 2A DE 5F         LD HL, (ReverseTimer)
 636+ ECEB 7C               LD A, H
 637+ ECEC B5               OR L
 638+ ECED C8               RET Z
 639+ ECEE 2B               DEC HL
 640+ ECEF 22 DE 5F         LD (ReverseTimer), HL
 641+ ECF2 C9               RET                                 ; (color via cycler, gate via ReadInput)
 642+ ECF3
 643+ ECF3              ; ==============================================================================
 644+ ECF3              ; ApplyCaracolBuff - speed slow 0.5x durante 10s + player GREEN | $40
 645+ ECF3              ; ==============================================================================
 646+ ECF3              ApplyCaracolBuff:
 647+ ECF3 3E 02            LD A, SPEED_BUFF_CARACOL_RUN
 648+ ECF5 32 DA 82         LD (PlayerSpeedRun), A
 649+ ECF8 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 650+ ECFA 32 DB 82         LD (PlayerSpeedFight), A
 651+ ECFD 21 7D 00         LD HL, SPEED_BUFF_CARACOL_FRAMES
 652+ ED00 22 DC 82         LD (SpeedBuffTimer), HL
 653+ ED03 3E 02            LD A, SPEED_BUFF_TYPE_CARACOL
 654+ ED05 32 DE 82         LD (SpeedBuffType), A
 655+ ED08                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 656+ ED08 C9               RET
 657+ ED09
 658+ ED09              ; ==============================================================================
 659+ ED09              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 660+ ED09              ; ==============================================================================
 661+ ED09              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 662+ ED09              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 663+ ED09              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 664+ ED09              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 665+ ED09              ; ==============================================================================
 666+ ED09              UpdateSpeedBuffBody:
 667+ ED09 3A DE 82         LD A, (SpeedBuffType)
 668+ ED0C B7               OR A
 669+ ED0D C8               RET Z                               ; sin buff activo
 670+ ED0E                  ; Tick 16-bit timer.
 671+ ED0E 2A DC 82         LD HL, (SpeedBuffTimer)
 672+ ED11 2B               DEC HL
 673+ ED12 22 DC 82         LD (SpeedBuffTimer), HL
 674+ ED15 7C               LD A, H
 675+ ED16 B5               OR L
 676+ ED17 C0               RET NZ                              ; buff aun activo (color via cycler)
 677+ ED18                  ; Buff terminado: reset speeds + clear type. Color lo pinta el cycler.
 678+ ED18 3E 04            LD A, SPEED_RUN
 679+ ED1A 32 DA 82         LD (PlayerSpeedRun), A
 680+ ED1D 3E 02            LD A, SPEED_FIGHT
 681+ ED1F 32 DB 82         LD (PlayerSpeedFight), A
 682+ ED22 AF               XOR A
 683+ ED23 32 DE 82         LD (SpeedBuffType), A
 684+ ED26 C9               RET
 685+ ED27
 686+ ED27              ; ==============================================================================
 687+ ED27              ; UpdateRandomPickup - room-enter hook
 688+ ED27              ; ==============================================================================
 689+ ED27              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 690+ ED27              ; Early-out si ScreenDirty=0 (no transition).
 691+ ED27              ;
 692+ ED27              ; En transition:
 693+ ED27              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 694+ ED27              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 695+ ED27              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 696+ ED27              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 697+ ED27              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 698+ ED27              ;
 699+ ED27              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 700+ ED27              ; fijos (id, charX, charY, v) terminados con id=$FF.
 701+ ED27              ;
 702+ ED27              ; Destruye AF, BC, DE, HL.
 703+ ED27              ; ==============================================================================
 704+ ED27              UpdateRandomPickupBody:
 705+ ED27 3A 15 83         LD A, (ScreenDirty)
 706+ ED2A B7               OR A
 707+ ED2B C8               RET Z
 708+ ED2C
 709+ ED2C                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 710+ ED2C 3E FE            LD A, $FE
 711+ ED2E 32 B4 5F         LD (RandomSynthMapX), A
 712+ ED31 AF               XOR A
 713+ ED32 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 714+ ED35
 715+ ED35                  ; --- Scan BG stream, build SlotList ---
 716+ ED35 AF               XOR A
 717+ ED36 32 AB 5F         LD (RandomSlotCount), A
 718+ ED39 2A 0F 83         LD HL, (CurrentScreenAddr)
 719+ ED3C              .urpScanLoop:
 720+ ED3C 7E               LD A, (HL)                          ; A = id
 721+ ED3D FE FF            CP $FF
 722+ ED3F 28 2A            JR Z, .urpScanDone
 723+ ED41 FE D2            CP RANDOM_SLOT_MARKER
 724+ ED43 20 20            JR NZ, .urpSkipEntry
 725+ ED45                  ; Es marker. Cap reached?
 726+ ED45 3A AB 5F         LD A, (RandomSlotCount)
 727+ ED48 FE 04            CP RANDOM_SLOT_MAX
 728+ ED4A 30 19            JR NC, .urpSkipEntry
 729+ ED4C                  ; SlotList[count*2] = charX, [count*2+1] = charY
 730+ ED4C 23               INC HL                              ; HL @ charX
 731+ ED4D 46               LD B, (HL)                          ; B = charX
 732+ ED4E 23               INC HL                              ; HL @ charY
 733+ ED4F 4E               LD C, (HL)                          ; C = charY
 734+ ED50 E5               PUSH HL                             ; save HL @ charY
 735+ ED51 87               ADD A, A                            ; A = count*2
 736+ ED52 6F               LD L, A
 737+ ED53 26 00            LD H, 0
 738+ ED55 11 AC 5F         LD DE, RandomSlotList
 739+ ED58 19               ADD HL, DE
 740+ ED59 70               LD (HL), B                          ; charX
 741+ ED5A 23               INC HL
 742+ ED5B 71               LD (HL), C                          ; charY
 743+ ED5C 21 AB 5F         LD HL, RandomSlotCount
 744+ ED5F 34               INC (HL)
 745+ ED60 E1               POP HL                              ; HL @ charY
 746+ ED61 23               INC HL                              ; HL @ v
 747+ ED62 23               INC HL                              ; HL @ next id
 748+ ED63 18 D7            JR .urpScanLoop
 749+ ED65              .urpSkipEntry:
 750+ ED65                  ; Skip entry: 4 bytes (id, charX, charY, v).
 751+ ED65 23               INC HL
 751+ ED66 23             INC HL
 751+ ED67 23             INC HL
 751+ ED68 23             INC HL
 752+ ED69 18 D1            JR .urpScanLoop
 753+ ED6B              .urpScanDone:
 754+ ED6B
 755+ ED6B                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 756+ ED6B 3A AB 5F         LD A, (RandomSlotCount)
 757+ ED6E B7               OR A
 758+ ED6F CA 18 EF         JP Z, .urpZeroAndRotate
 759+ ED72
 760+ ED72                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 761+ ED72                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 762+ ED72                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 763+ ED72 3A 0E 83         LD A, (CurrentScreenY)
 764+ ED75 07               RLCA
 764+ ED76 07             RLCA
 764+ ED77 07             RLCA
 764+ ED78 07             RLCA           ; Y*16
 765+ ED79 21 0D 83         LD HL, CurrentScreenX
 766+ ED7C 86               ADD A, (HL)                         ; A = newSid
 767+ ED7D 47               LD B, A                             ; B = newSid (preservar)
 768+ ED7E 3A D1 5F         LD A, (RP_PrevSid)
 769+ ED81 B8               CP B
 770+ ED82 20 1A            JR NZ, .urpCacheMiss
 771+ ED84                  ; HIT prev. Validar slot < count.
 772+ ED84 3A D2 5F         LD A, (RP_PrevSlot)
 773+ ED87 4F               LD C, A                             ; C = cached slot
 774+ ED88 3A AB 5F         LD A, (RandomSlotCount)
 775+ ED8B B9               CP C
 776+ ED8C 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 777+ ED8E 38 0E            JR C, .urpCacheMiss
 778+ ED90                  ; Restaurar: usar cached slot + cached rolled.
 779+ ED90 79               LD A, C
 780+ ED91 32 D4 5F         LD (RP_TmpSlot), A
 781+ ED94 3A D3 5F         LD A, (RP_PrevRolled)
 782+ ED97 32 D5 5F         LD (RP_TmpRolled), A
 783+ ED9A 79               LD A, C                             ; A = slot
 784+ ED9B C3 01 EE         JP .urpReadSlotAndDispatchCache
 785+ ED9E
 786+ ED9E              .urpCacheMiss:
 787+ ED9E 3A AB 5F         LD A, (RandomSlotCount)
 788+ EDA1                  ; --- Pick slot via R mod count ---
 789+ EDA1 47               LD B, A                             ; B = count
 790+ EDA2 ED 5F            LD A, R
 791+ EDA4              .urpModLoop:
 792+ EDA4 90               SUB B
 793+ EDA5 30 FD            JR NC, .urpModLoop
 794+ EDA7 80               ADD A, B                            ; A = R mod count, [0..count-1]
 795+ EDA8 32 D4 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
 796+ EDAB
 797+ EDAB                  ; --- Read SlotList[A*2] = (charX, charY) ---
 798+ EDAB 87               ADD A, A
 799+ EDAC 5F               LD E, A
 800+ EDAD 16 00            LD D, 0
 801+ EDAF 21 AC 5F         LD HL, RandomSlotList
 802+ EDB2 19               ADD HL, DE
 803+ EDB3 7E               LD A, (HL)                          ; charX
 804+ EDB4 32 B8 5F         LD (RandomSynthCharX), A
 805+ EDB7 23               INC HL
 806+ EDB8 7E               LD A, (HL)                          ; charY
 807+ EDB9 32 B9 5F         LD (RandomSynthCharY), A
 808+ EDBC
 809+ EDBC                  ; --- Roll type usando R XOR SYS_FRAMES ---
 810+ EDBC                  IF DEBUG_FORCE_COMPASS
 811+ EDBC ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 812+ EDBC ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 813+ EDBC ~                    JP .urpDoCompass
 814+ EDBC                  ENDIF
 815+ EDBC                  IF DEBUG_FORCE_MUSHROOM
 816+ EDBC ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 817+ EDBC ~                    JP .urpDoMushroom
 818+ EDBC                  ENDIF
 819+ EDBC                  IF DEBUG_FORCE_ROULETTE
 820+ EDBC ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 821+ EDBC ~                    JP .urpDoRoulette
 822+ EDBC                  ENDIF
 823+ EDBC                  IF DEBUG_FORCE_COLOR_CHANGER
 824+ EDBC ~                    ; DEBUG: rotar entre RAYO/CARACOL/MUSHROOM al 33% para testar el color
 825+ EDBC ~                    ; cycler. R XOR SYS_FRAMES da pseudo-random uniform 0..255, partido en
 826+ EDBC ~                    ; 3 bandas de 85.3 c/u.
 827+ EDBC ~                    LD A, R
 828+ EDBC ~                    LD HL, $5C78
 829+ EDBC ~                    XOR (HL)
 830+ EDBC ~                    CP 85
 831+ EDBC ~                    JP C, .urpDoRayo
 832+ EDBC ~                    CP 170
 833+ EDBC ~                    JP C, .urpDoCaracol
 834+ EDBC ~                    JP .urpDoMushroom
 835+ EDBC                  ENDIF
 836+ EDBC                  IF DEBUG_FORCE_NEW_BUFFS
 837+ EDBC ~                    ; DEBUG: rotar entre ESPADA/ESCUDO/ESCUDO_RAYO al 33% para testar
 838+ EDBC ~                    ; fase 3 (buffs nuevos).
 839+ EDBC ~                    LD A, R
 840+ EDBC ~                    LD HL, $5C78
 841+ EDBC ~                    XOR (HL)
 842+ EDBC ~                    CP 85
 843+ EDBC ~                    JP C, .urpDoEspada
 844+ EDBC ~                    CP 170
 845+ EDBC ~                    JP C, .urpDoEscudo
 846+ EDBC ~                    JP .urpDoEscudoRayo
 847+ EDBC                  ENDIF
 848+ EDBC                  IF DEBUG_FORCE_REVERSE
 849+ EDBC ~                    ; DEBUG: forzar siempre REVERSE para testar fase 4.
 850+ EDBC ~                    JP .urpDoReverse
 851+ EDBC                  ENDIF
 852+ EDBC ED 5F            LD A, R
 853+ EDBE 21 78 5C         LD HL, $5C78
 854+ EDC1 AE               XOR (HL)
 855+ EDC2                  ; Bands cumulativos. Orden de chequeo en codigo NO afecta las
 856+ EDC2                  ; probabilidades — solo importa los valores de PROB_*_END. Aqui van
 857+ EDC2                  ; agrupados por categoria (Recursos, Especiales, Buffs, Debuffs, Meta).
 858+ EDC2                  ; JP C (no JR C) por rango con cache hit dispatch.
 859+ EDC2                  ; --- Recursos ---
 860+ EDC2 FE 14            CP PROB_HEALTH_END
 860+ EDC4 DA 6C EE       JP C, .urpDoHealth
 861+ EDC7 FE 28            CP PROB_STAMINA_END
 861+ EDC9 DA 7A EE       JP C, .urpDoStamina
 862+ EDCC                  ; --- Especiales ---
 863+ EDCC FE 2C            CP PROB_LIFE_END
 863+ EDCE DA 61 EE       JP C, .urpDoLife
 864+ EDD1 FE 30            CP PROB_COMPASS_END
 864+ EDD3 DA A9 EE       JP C, .urpDoCompass
 865+ EDD6 FE 35            CP PROB_ESCUDORAYO_END
 865+ EDD8 DA CA EE       JP C, .urpDoEscudoRayo
 866+ EDDB                  ; --- Buffs ---
 867+ EDDB FE 3E            CP PROB_RAYO_END
 867+ EDDD DA 88 EE       JP C, .urpDoRayo
 868+ EDE0 FE 46            CP PROB_ESPADA_END
 868+ EDE2 DA B4 EE       JP C, .urpDoEspada
 869+ EDE5 FE 4E            CP PROB_ESCUDO_END
 869+ EDE7 DA BF EE       JP C, .urpDoEscudo
 870+ EDEA                  ; --- Debuffs ---
 871+ EDEA FE 5A            CP PROB_MUSHROOM_END
 871+ EDEC DA 9E EE       JP C, .urpDoMushroom
 872+ EDEF FE 66            CP PROB_CARACOL_END
 872+ EDF1 DA 93 EE       JP C, .urpDoCaracol
 873+ EDF4 FE 72            CP PROB_REVERSE_END
 873+ EDF6 DA D5 EE       JP C, .urpDoReverse
 874+ EDF9                  ; --- Meta ---
 875+ EDF9 FE 86            CP PROB_ROULETTE_END
 875+ EDFB DA E0 EE       JP C, .urpDoRoulette
 876+ EDFE C3 18 EF         JP .urpZeroAndRotate                ; tipo nada, RandomSynthMapX ya esta a $FE
 877+ EE01
 878+ EE01              ; ==============================================================================
 879+ EE01              ; .urpReadSlotAndDispatchCache — path del cache HIT
 880+ EE01              ; ==============================================================================
 881+ EE01              ; Entrada: A = slot cached, RP_TmpRolled = tipo cached (ya setado).
 882+ EE01              ; Lee SlotList[A*2] → CharX/Y, luego dispatcha al .urpDoXxx correspondiente.
 883+ EE01              ; ROLLED_NONE → JP .urpZeroAndRotate (no spawn pero rota cache).
 884+ EE01              ; ==============================================================================
 885+ EE01              .urpReadSlotAndDispatchCache:
 886+ EE01 87               ADD A, A
 887+ EE02 5F               LD E, A
 888+ EE03 16 00            LD D, 0
 889+ EE05 21 AC 5F         LD HL, RandomSlotList
 890+ EE08 19               ADD HL, DE
 891+ EE09 7E               LD A, (HL)
 892+ EE0A 32 B8 5F         LD (RandomSynthCharX), A
 893+ EE0D 23               INC HL
 894+ EE0E 7E               LD A, (HL)
 895+ EE0F 32 B9 5F         LD (RandomSynthCharY), A
 896+ EE12
 897+ EE12 3A D5 5F         LD A, (RP_TmpRolled)
 898+ EE15 B7               OR A
 899+ EE16 CA 18 EF         JP Z, .urpZeroAndRotate             ; ROLLED_NONE (consumido) → no spawn
 900+ EE19 3D               DEC A
 901+ EE1A CA 61 EE         JP Z, .urpDoLife                    ; ROLLED_LIFE
 902+ EE1D 3D               DEC A
 903+ EE1E 28 26            JR Z, .urpDoHealthFromCache         ; ROLLED_HEALTH: reusa variant cacheada
 904+ EE20 3D               DEC A
 905+ EE21 28 2A            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 906+ EE23 3D               DEC A
 907+ EE24 CA 88 EE         JP Z, .urpDoRayo
 908+ EE27 3D               DEC A
 909+ EE28 CA 93 EE         JP Z, .urpDoCaracol
 910+ EE2B 3D               DEC A
 911+ EE2C CA E0 EE         JP Z, .urpDoRoulette
 912+ EE2F 3D               DEC A
 913+ EE30 CA 9E EE         JP Z, .urpDoMushroom
 914+ EE33 3D               DEC A
 915+ EE34 CA A9 EE         JP Z, .urpDoCompass                 ; ROLLED_COMPASS
 916+ EE37 3D               DEC A
 917+ EE38 CA B4 EE         JP Z, .urpDoEspada                  ; ROLLED_ESPADA
 918+ EE3B 3D               DEC A
 919+ EE3C CA BF EE         JP Z, .urpDoEscudo                  ; ROLLED_ESCUDO
 920+ EE3F 3D               DEC A
 921+ EE40 CA CA EE         JP Z, .urpDoEscudoRayo              ; ROLLED_ESCUDO_RAYO
 922+ EE43 C3 D5 EE         JP .urpDoReverse                    ; ROLLED_REVERSE (resto)
 923+ EE46
 924+ EE46              ; ==============================================================================
 925+ EE46              ; .urpDoHealthFromCache / .urpDoStaminaFromCache - cache hit path
 926+ EE46              ; ==============================================================================
 927+ EE46              ; Llamadas solo desde .urpReadSlotAndDispatchCache. Restauran la variante exacta
 928+ EE46              ; que el player vio la última vez en esta sala (vía RP_PrevVariant) en lugar de
 929+ EE46              ; re-rollear con PickRandomVariantPtr. El usuario ve consistencia visual.
 930+ EE46              ;
 931+ EE46              ; Comparten .urpDoVariantFromCache: HL ya cargado con la tabla, A con ROLLED_*.
 932+ EE46              ; ==============================================================================
 933+ EE46              .urpDoHealthFromCache:
 934+ EE46 3E 02            LD A, ROLLED_HEALTH
 935+ EE48 21 DA F0         LD HL, HealthVariantPtrs
 936+ EE4B 18 05            JR .urpDoVariantFromCache
 937+ EE4D              .urpDoStaminaFromCache:
 938+ EE4D 3E 03            LD A, ROLLED_STAMINA
 939+ EE4F 21 E5 F0         LD HL, StaminaVariantPtrs
 940+ EE52              .urpDoVariantFromCache:
 941+ EE52 32 D5 5F         LD (RP_TmpRolled), A
 942+ EE55 3A D7 5F         LD A, (RP_PrevVariant)
 943+ EE58 32 D8 5F         LD (RP_TmpVariant), A               ; restore: la próxima rotación lo lleva a Cur
 944+ EE5B CD F9 F0         CALL LookupVariantPtrByIdx          ; HL = tabla, A = idx → HL = sprite ptr
 945+ EE5E C3 02 EF         JP .urpActivate
 946+ EE61
 947+ EE61              .urpDoLife:
 948+ EE61 3E 01            LD A, ROLLED_LIFE
 949+ EE63 32 D5 5F         LD (RP_TmpRolled), A
 950+ EE66 21 84 CC         LD HL, BgGfx_life
 951+ EE69 C3 02 EF         JP .urpActivate
 952+ EE6C              .urpDoHealth:
 953+ EE6C 3E 02            LD A, ROLLED_HEALTH
 954+ EE6E 32 D5 5F         LD (RP_TmpRolled), A
 955+ EE71 21 DA F0         LD HL, HealthVariantPtrs             ; variantes 72/74/75/254
 956+ EE74 CD EE F0         CALL PickRandomVariantPtr             ; OUT: HL = sprite ptr (raw)
 957+ EE77 C3 02 EF         JP .urpActivate
 958+ EE7A              .urpDoStamina:
