4762+ B935                  ; --- Solapamiento con player (AABB ambos ejes < 24 px = overlap real) ---
4763+ B935                  ; Antes el check era OR (cualquiera de los ejes < 24 → block). Eso es una
4764+ B935                  ; CRUZ de exclusion: si player en el pasillo, TODA la fila del pasillo se
4765+ B935                  ; rechaza por Y cercana → nunca aparecen nasties en el pasillo. AND es
4766+ B935                  ; correcto: solo bloquear si los rectangulos solapan en 2D.
4767+ B935 3A A6 81         LD A, (EntityTable + ENT_POSX)
4768+ B938 DD 96 03         SUB (IX+ENT_POSX)
4769+ B93B 30 02            JR NC, .spAbsX
4770+ B93D ED 44            NEG
4771+ B93F              .spAbsX:
4772+ B93F FE 18            CP 24
4773+ B941 30 0E            JR NC, .spPlayerOk                  ; |dx| >= 24 → no overlap posible, skip Y
4774+ B943 3A A7 81         LD A, (EntityTable + ENT_POSY)
4775+ B946 DD 96 04         SUB (IX+ENT_POSY)
4776+ B949 30 02            JR NC, .spAbsY
4777+ B94B ED 44            NEG
4778+ B94D              .spAbsY:
4779+ B94D FE 18            CP 24
4780+ B94F 38 44            JR C, .spawnBlocked                 ; |dx| < 24 AND |dy| < 24 → demasiado cerca
4781+ B951              .spPlayerOk:
4782+ B951                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4783+ B951                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4784+ B951 DD E5            PUSH IX
4785+ B953 E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4786+ B954 FD 21 13 82      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4787+ B958 06 03            LD B, NUM_NASTIES
4788+ B95A              .spDistLoop:
4789+ B95A C5               PUSH BC
4790+ B95B E5               PUSH HL
4791+ B95C FD E5            PUSH IY
4792+ B95E D1               POP DE                              ; DE = ptr al slot vecino
4793+ B95F B7               OR A
4794+ B960 ED 52            SBC HL, DE                          ; HL == 0 → mismo slot, skip
4795+ B962 E1               POP HL
4796+ B963 28 25            JR Z, .spDistNext
