1196+ CFFB                  ; Recorrer tokens RLE hasta consumir HL pixeles
1197+ CFFB              .spRleLoop:
1198+ CFFB 7C               LD A, H
1199+ CFFC B5               OR L
1200+ CFFD C8               RET Z                       ; 0 pixeles restantes → IX en posicion correcta
1201+ CFFE DD 7E 00         LD A, (IX+0)
1202+ D001 DD 23            INC IX
1203+ D003 CB 7F            BIT 7, A
1204+ D005 20 0C            JR NZ, .spRleRun
1205+ D007                  ; Literal group: consume A bytes de datos (A = count 1-127)
1206+ D007 5F               LD E, A
1207+ D008 16 00            LD D, 0
1208+ D00A ED 52            SBC HL, DE                  ; HL -= count
1209+ D00C                  ; Saltar los bytes literales
1210+ D00C 43               LD B, E
1211+ D00D              .spRleLitSkip:
1212+ D00D DD 23            INC IX
1213+ D00F 10 FC            DJNZ .spRleLitSkip
1214+ D011 18 E8            JR .spRleLoop
1215+ D013              .spRleRun:
1216+ D013                  ; Run: consume (A & $7F)+2 pixeles, saltar 1 byte valor
1217+ D013 E6 7F            AND $7F
1218+ D015 C6 02            ADD A, 2
1219+ D017 5F               LD E, A
1220+ D018 16 00            LD D, 0
1221+ D01A ED 52            SBC HL, DE                  ; HL -= count
1222+ D01C DD 23            INC IX                      ; saltar byte valor
1223+ D01E 18 DB            JR .spRleLoop
