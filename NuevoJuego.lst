 350+ F20A              ; ==============================================================================
 351+ F20A              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 352+ F20A              ; ==============================================================================
 353+ F20A              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 354+ F20A              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 355+ F20A              ; third). El brujula se redibuja solo cuando:
 356+ F20A              ;   - cambias de pantalla (LastCompassScreen != Current)
 357+ F20A              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 358+ F20A              ; En reposo es un no-op barato (solo unas comparaciones).
 359+ F20A              ;
 360+ F20A              ; Color (atributo de las 4 celdas):
 361+ F20A              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 362+ F20A              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 363+ F20A              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 364+ F20A              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 365+ F20A              ;
 366+ F20A              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 367+ F20A              ; ==============================================================================
 368+ F20A
 369+ F20A              COMPASS_COL     EQU 24
 370+ F20A              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 371+ F20A
 372+ F20A              ; ==============================================================================
 373+ F20A              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 374+ F20A              ; ==============================================================================
 375+ F20A              DrawCompass:
 376+ F20A                  ; Sin objetivo resuelto -> limpiar y salir
 377+ F20A 3A 67 82         LD A, (ObjectiveScreenX)
 378+ F20D FE FF            CP $FF
 379+ F20F CA A3 F3         JP Z, ClearCompass
 380+ F212
 381+ F212                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 382+ F212                  ; magic compass activo (que necesita redibujar para el blink y para
 383+ F212                  ; reflejar la dir del path al cambiar de sala).
 384+ F212 3A AD 82         LD A, (CurrentScreenX)
 385+ F215 47               LD B, A
 386+ F216 3A 6A 82         LD A, (LastCompassScreenX)
 387+ F219 B8               CP B
 388+ F21A C2 40 F2         JP NZ, .dcRedrawNewScreen
 389+ F21D 3A AE 82         LD A, (CurrentScreenY)
 390+ F220 47               LD B, A
 391+ F221 3A 6B 82         LD A, (LastCompassScreenY)
 392+ F224 B8               CP B
 393+ F225 C2 40 F2         JP NZ, .dcRedrawNewScreen
 394+ F228 3A 69 82         LD A, (PreviousObjectiveDistance)
 395+ F22B FE FF            CP $FF
 396+ F22D 28 16            JR Z, .dcRedraw
 397+ F22F 3A 6C 82         LD A, (CompassWobbleCounter)
 398+ F232 B7               OR A
 399+ F233 20 10            JR NZ, .dcRedraw
 400+ F235                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 401+ F235                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 402+ F235 3A BF 5F         LD A, (MagicCompassTimer)
 403+ F238 47               LD B, A
 404+ F239 3A C0 5F         LD A, (MagicCompassTimer + 1)
 405+ F23C B0               OR B
 406+ F23D C8               RET Z                               ; sin cambios + sin wobble + sin magic
 407+ F23E 18 05            JR .dcRedraw
 408+ F240
 409+ F240              .dcRedrawNewScreen:
 410+ F240                  ; Cambio de sala: marcar el path del magic compass como dirty para que
 411+ F240                  ; UpdateMagicCompass recalcule la flecha en el próximo update. El BFS no
 412+ F240                  ; corre aquí (UpdateMagicCompass se llama desde MainLoop antes que esto).
 413+ F240 3E 01            LD A, 1
 414+ F242 32 C2 5F         LD (MagicCompassPathDirty), A
 415+ F245                  ; fall through a .dcRedraw
 416+ F245
 417+ F245              .dcRedraw:
 418+ F245                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 419+ F245 3A 67 82         LD A, (ObjectiveScreenX)
 420+ F248 47               LD B, A
 421+ F249 3A AD 82         LD A, (CurrentScreenX)
 422+ F24C 4F               LD C, A
 423+ F24D 78               LD A, B
 424+ F24E 91               SUB C                               ; A = dx (signed)
 425+ F24F                  ; abs(dx) -> H, sign(dx)+1 -> L
 426+ F24F F2 59 F2         JP P, .dcDxNonNeg
 427+ F252 ED 44            NEG
 428+ F254 67               LD H, A                             ; abs(dx)
 429+ F255 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 430+ F257 18 0A            JR .dcDxDone
 431+ F259              .dcDxNonNeg:
 432+ F259 67               LD H, A
 433+ F25A B7               OR A
 434+ F25B 20 04            JR NZ, .dcDxPositive
 435+ F25D 2E 01            LD L, 1                             ; dx == 0
 436+ F25F 18 02            JR .dcDxDone
 437+ F261              .dcDxPositive:
 438+ F261 2E 02            LD L, 2
 439+ F263              .dcDxDone:
 440+ F263 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 441+ F264
 442+ F264                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 443+ F264 3A 68 82         LD A, (ObjectiveScreenY)
 444+ F267 47               LD B, A
 445+ F268 3A AE 82         LD A, (CurrentScreenY)
 446+ F26B 4F               LD C, A
 447+ F26C 78               LD A, B
 448+ F26D 91               SUB C
 449+ F26E F2 78 F2         JP P, .dcDyNonNeg
 450+ F271 ED 44            NEG
 451+ F273 67               LD H, A
 452+ F274 2E 00            LD L, 0
 453+ F276 18 0A            JR .dcDyDone
 454+ F278              .dcDyNonNeg:
 455+ F278 67               LD H, A
 456+ F279 B7               OR A
 457+ F27A 20 04            JR NZ, .dcDyPositive
 458+ F27C 2E 01            LD L, 1
 459+ F27E 18 02            JR .dcDyDone
 460+ F280              .dcDyPositive:
 461+ F280 2E 02            LD L, 2
 462+ F282              .dcDyDone:
 463+ F282                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 464+ F282 D1               POP DE                              ; D = abs_dx, E = signdx+1
 465+ F283                  ; idx = (signdy+1)*3 + (signdx+1)
 466+ F283 7D               LD A, L
 467+ F284 87               ADD A, A
 468+ F285 85               ADD A, L                            ; A = (signdy+1)*3
 469+ F286 83               ADD A, E                            ; A = idx (0..8)
 470+ F287 32 70 F3         LD (.dcSpriteIdx), A
