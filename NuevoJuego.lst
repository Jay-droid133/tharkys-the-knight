 155+ E4D5              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E4D5              ; ==============================================================================
 157+ E4D5              CheckDebugKeys:
 158+ E4D5 3E FB            LD A, $FB
 159+ E4D7 DB FE            IN A, ($FE)
 160+ E4D9 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E4DB 20 1C            JR NZ, .notPressed
 162+ E4DD
 163+ E4DD                  ; Tecla pulsada: comprobar debounce
 164+ E4DD 3A 4A E4         LD A, (DebugKeyDebounce)
 165+ E4E0 B7               OR A
 166+ E4E1 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E4E2
 168+ E4E2                  ; Primera pulsacion: ciclar
 169+ E4E2 3E 01            LD A, 1
 170+ E4E4 32 4A E4         LD (DebugKeyDebounce), A
 171+ E4E7
