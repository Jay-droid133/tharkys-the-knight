 124+ ED07              ; UpdateGameClock
 125+ ED07              ; ==============================================================================
 126+ ED07              UpdateGameClock:
 127+ ED07 3A B3 82         LD A, (TimeFrozen)
 128+ ED0A B7               OR A
 129+ ED0B C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ ED0C 21 6D EB         LD HL, GameSubMinute
 131+ ED0F 34               INC (HL)
 132+ ED10 3A 70 EB         LD A, (SubMinuteMax)
 133+ ED13 BE               CP (HL)
 134+ ED14 C0               RET NZ
 135+ ED15
 136+ ED15 AF               XOR A
 137+ ED16 32 6D EB         LD (GameSubMinute), A
 138+ ED19 21 6E EB         LD HL, GameMinutes
 139+ ED1C 34               INC (HL)
 140+ ED1D                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ ED1D                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ ED1D 3A 6E EB         LD A, (GameMinutes)
 143+ ED20 FE 3C            CP 60
 144+ ED22 C0               RET NZ
 145+ ED23
 146+ ED23 AF               XOR A
 147+ ED24 32 6E EB         LD (GameMinutes), A
 148+ ED27 21 6F EB         LD HL, GameHours
 149+ ED2A 34               INC (HL)
 150+ ED2B 7E               LD A, (HL)
 151+ ED2C FE 18            CP 24
 152+ ED2E 20 04            JR NZ, .checkPhase
 153+ ED30 AF               XOR A
 154+ ED31 32 6F EB         LD (GameHours), A
 155+ ED34
 156+ ED34              .checkPhase:
 157+ ED34 3A 6F EB         LD A, (GameHours)
 158+ ED37 21 79 EB         LD HL, PhaseTable
 159+ ED3A 06 07            LD B, 7
 160+ ED3C              .phaseLoop:
 161+ ED3C BE               CP (HL)
 162+ ED3D 28 05            JR Z, .phaseFound
 163+ ED3F 23               INC HL
 164+ ED40 23               INC HL
 165+ ED41 10 F9            DJNZ .phaseLoop
 166+ ED43 C9               RET
 167+ ED44              .phaseFound:
 168+ ED44 23               INC HL
 169+ ED45 7E               LD A, (HL)
 170+ ED46 F5               PUSH AF
