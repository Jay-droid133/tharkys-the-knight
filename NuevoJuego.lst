 443+ ECEB              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ ECEB              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ ECEB              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ ECEB              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ ECEB              ; las (16-C) superiores con $00 (vacio/negro)
 448+ ECEB              .drawBar:
 449+ ECEB 7D               LD A, L
 450+ ECEC 32 37 ED         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ ECEF 7B               LD A, E
 452+ ECF0 32 38 ED         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ ECF3 06 10            LD B, 16                            ; 16 scanlines totales
 454+ ECF5 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ ECF7                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ ECF7 3E 10            LD A, 16
 457+ ECF9 91               SUB C
 458+ ECFA 5F               LD E, A                             ; E = primera scanline llena
 459+ ECFB              .dbLoop:
 460+ ECFB                  ; Calcular direccion VRAM
 461+ ECFB 7A               LD A, D
 462+ ECFC FE 08            CP 8
 463+ ECFE 30 09            JR NC, .dbCalcR1
 464+ ED00                  ; Char row 0
 465+ ED00 67               LD H, A
 466+ ED01 CB F4            SET 6, H
 467+ ED03 3A 37 ED         LD A, (.dbCol)
 468+ ED06 6F               LD L, A
 469+ ED07 18 09            JR .dbWrite
 470+ ED09              .dbCalcR1:
 471+ ED09                  ; Char row 1
 472+ ED09 D6 08            SUB 8
 473+ ED0B 67               LD H, A
 474+ ED0C CB F4            SET 6, H
 475+ ED0E 3A 38 ED         LD A, (.dbCol1)
 476+ ED11 6F               LD L, A
 477+ ED12              .dbWrite:
 478+ ED12                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ ED12 7A               LD A, D
 480+ ED13 BB               CP E
 481+ ED14 30 0B            JR NC, .dbFull
 482+ ED16                  ; Marchito: copiar sprite decayed
 483+ ED16 FD 7E 00         LD A, (IY+0)
 484+ ED19 77               LD (HL), A
 485+ ED1A 23               INC HL
 486+ ED1B FD 7E 01         LD A, (IY+1)
 487+ ED1E 77               LD (HL), A
 488+ ED1F 18 09            JR .dbAdvanceSpr
 489+ ED21              .dbFull:
 490+ ED21                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ ED21 DD 7E 00         LD A, (IX+0)
 492+ ED24 77               LD (HL), A
 493+ ED25 23               INC HL
 494+ ED26 DD 7E 01         LD A, (IX+1)
 495+ ED29 77               LD (HL), A
 496+ ED2A              .dbAdvanceSpr:
 497+ ED2A                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ ED2A D5               PUSH DE
 499+ ED2B 11 06 00         LD DE, 6
 500+ ED2E DD 19            ADD IX, DE
 501+ ED30 FD 19            ADD IY, DE
 502+ ED32 D1               POP DE
 503+ ED33 14               INC D
 504+ ED34 10 C5            DJNZ .dbLoop
 505+ ED36 C9               RET
 506+ ED37
 507+ ED37 00           .dbCol:  DEFB 0
 508+ ED38 00           .dbCol1: DEFB 0
 509+ ED39
 510+ ED39              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ ED39              .levelToColor:
 512+ ED39 FE 0C            CP 12
 513+ ED3B 30 11            JR NC, .lcGreen
 514+ ED3D FE 07            CP 7
 515+ ED3F 30 0A            JR NC, .lcCyan
 516+ ED41 FE 03            CP 3
 517+ ED43 30 03            JR NC, .lcYellow
 518+ ED45 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ ED47 C9               RET
 520+ ED48              .lcYellow:
 521+ ED48 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ ED4A C9               RET
 523+ ED4B              .lcCyan:
 524+ ED4B 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ ED4D C9               RET
 526+ ED4E              .lcGreen:
