1712+ F72C              ; ==============================================================================
1713+ F72C              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1714+ F72C              ; ==============================================================================
1715+ F72C              ; Indice (CompassSprites[idx]):
1716+ F72C              ;   0 = NW    1 = N    2 = NE
1717+ F72C              ;   3 = W     4 = X    5 = E
1718+ F72C              ;   6 = SW    7 = S    8 = SE
1719+ F72C              ; ==============================================================================
1720+ F72C              CompassSprites:
1721+ F72C 4B F8            DEFW Sprite_Compass_NW
1722+ F72E 6B F7            DEFW Sprite_Compass_N
1723+ F730 8B F7            DEFW Sprite_Compass_NE
1724+ F732 2B F8            DEFW Sprite_Compass_W
1725+ F734 6B F8            DEFW Sprite_Compass_X
1726+ F736 AB F7            DEFW Sprite_Compass_E
1727+ F738 0B F8            DEFW Sprite_Compass_SW
1728+ F73A EB F7            DEFW Sprite_Compass_S
1729+ F73C CB F7            DEFW Sprite_Compass_SE
1730+ F73E
1731+ F73E              ; ==============================================================================
1732+ F73E              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1733+ F73E              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1734+ F73E              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1735+ F73E              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1736+ F73E              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1737+ F73E              ; ==============================================================================
1738+ F73E              CompassWobbleTable:
1739+ F73E 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1740+ F742 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1741+ F746 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1742+ F74A 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1743+ F74E 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1744+ F752 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1745+ F756 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1746+ F75A 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1747+ F75E 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1748+ F762
1749+ F762              ; ==============================================================================
1750+ F762              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1751+ F762              ; Indexada por (counter-1) -> 0..8. Valor:
1752+ F762              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1753+ F762              ; Con counter inicial 9 y decremento por frame:
1754+ F762              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1755+ F762              ;   counter 8 -> phase 7 -> prev
1756+ F762              ;   counter 7 -> phase 6 -> target
1757+ F762              ;   counter 6 -> phase 5 -> next
1758+ F762              ;   counter 5 -> phase 4 -> next2
1759+ F762              ;   counter 4 -> phase 3 -> prev
1760+ F762              ;   counter 3 -> phase 2 -> target
1761+ F762              ;   counter 2 -> phase 1 -> prev
1762+ F762              ;   counter 1 -> phase 0 -> target (estado final, settle)
1763+ F762              ; ==============================================================================
1764+ F762              WobblePhaseTable:
1765+ F762 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1765+ F766 04 03 02 01
1765+ F76A 00
