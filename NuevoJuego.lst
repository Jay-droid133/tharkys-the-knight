 411+ 68BB 19               ADD HL, DE                              ; *3
 412+ 68BC 11 0A E2         LD DE, BgGfxPtrById
 413+ 68BF 19               ADD HL, DE
 414+ 68C0 5E               LD E, (HL)
 415+ 68C1 23               INC HL
 416+ 68C2 56               LD D, (HL)                              ; DE = ptr
 417+ 68C3 23               INC HL
