 362+ EC20 77             LD (HL), A
 362+ EC21 23             INC HL
 363+ EC22 DD 7E 01         LD A, (IX+1)
 363+ EC25 CD 3B E4       CALL ApplyDayCycleRemap
 363+ EC28 77             LD (HL), A
 363+ EC29 23             INC HL
 364+ EC2A DD 7E 02         LD A, (IX+2)
 364+ EC2D 77                                       LD (HL), A
 364+ EC2E 23             INC HL  ; esfera
 365+ EC2F DD 7E 03         LD A, (IX+3)
 365+ EC32 77                                       LD (HL), A
 365+ EC33 23             INC HL  ; esfera
 366+ EC34 DD 7E 04         LD A, (IX+4)
 366+ EC37 CD 3B E4       CALL ApplyDayCycleRemap
 366+ EC3A 77             LD (HL), A
 366+ EC3B 23             INC HL
 367+ EC3C DD 7E 05         LD A, (IX+5)
 367+ EC3F CD 3B E4       CALL ApplyDayCycleRemap
 367+ EC42 77             LD (HL), A
