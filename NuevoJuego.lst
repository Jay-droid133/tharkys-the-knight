1809+ AC50              ; ==============================================================================
1810+ AC50              ; UpdatePlayerAnimation - Animacion por SpriteID
1811+ AC50              ; ==============================================================================
1812+ AC50              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
1813+ AC50              ; ==============================================================================
1814+ AC50              UpdatePlayerAnimation:
1815+ AC50                  ; Determinar animacion segun estado y direccion
1816+ AC50 DD 7E 02         LD A, (IX+ENT_STATE)
1817+ AC53 FE 02            CP STATE_FIGHTING
1818+ AC55 28 0C            JR Z, .animFight
1819+ AC57 FE 01            CP STATE_RUNNING
1820+ AC59 28 21            JR Z, .animRun
1821+ AC5B
1822+ AC5B                  ; --- IDLE ---
1823+ AC5B 16 00            LD D, SPRID_IDLE
1824+ AC5D 1E 02            LD E, ANIM_FRAMES_IDLE
1825+ AC5F 0E 0A            LD C, ANIM_DELAY_IDLE
1826+ AC61 18 44            JR .applyAnim
1827+ AC63
1828+ AC63              .animFight:
1829+ AC63                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1830+ AC63 DD 7E 0A         LD A, (IX+ENT_DIR)
1831+ AC66 0F               RRCA
1832+ AC67 0F               RRCA
1833+ AC68 0F               RRCA
1834+ AC69 0F               RRCA
1835+ AC6A E6 0F            AND $0F                     ; lastHDir
1836+ AC6C FE 08            CP DIR_W
1837+ AC6E 28 04            JR Z, .fightW
1838+ AC70 16 16            LD D, SPRID_ATTACK_EAST
1839+ AC72 18 02            JR .fightSet
1840+ AC74              .fightW:
1841+ AC74 16 1B            LD D, SPRID_ATTACK_WEST
1842+ AC76              .fightSet:
