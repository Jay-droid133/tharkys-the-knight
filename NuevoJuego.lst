1519+ F6F9              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1520+ F6F9              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1521+ F6F9              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1522+ F6F9              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1523+ F6F9              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1524+ F6F9              ; ==============================================================================
1525+ F6F9              CompassWobbleTable:
1526+ F6F9 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1527+ F6FD 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1528+ F701 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1529+ F705 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1530+ F709 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1531+ F70D 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1532+ F711 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1533+ F715 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1534+ F719 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
