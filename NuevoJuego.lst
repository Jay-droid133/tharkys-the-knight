1490+ F6D4              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1491+ F6D4
1492+ F6D4              ; ==============================================================================
1493+ F6D4              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1494+ F6D4              ; ==============================================================================
1495+ F6D4              ; Indice (CompassSprites[idx]):
1496+ F6D4              ;   0 = NW    1 = N    2 = NE
1497+ F6D4              ;   3 = W     4 = X    5 = E
1498+ F6D4              ;   6 = SW    7 = S    8 = SE
1499+ F6D4              ; ==============================================================================
1500+ F6D4              CompassSprites:
1501+ F6D4 F3 F7            DEFW Sprite_Compass_NW
1502+ F6D6 13 F7            DEFW Sprite_Compass_N
1503+ F6D8 33 F7            DEFW Sprite_Compass_NE
1504+ F6DA D3 F7            DEFW Sprite_Compass_W
1505+ F6DC 13 F8            DEFW Sprite_Compass_X
1506+ F6DE 53 F7            DEFW Sprite_Compass_E
1507+ F6E0 B3 F7            DEFW Sprite_Compass_SW
1508+ F6E2 93 F7            DEFW Sprite_Compass_S
1509+ F6E4 73 F7            DEFW Sprite_Compass_SE
1510+ F6E6
1511+ F6E6              ; ==============================================================================
1512+ F6E6              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1513+ F6E6              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1514+ F6E6              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1515+ F6E6              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1516+ F6E6              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1517+ F6E6              ; ==============================================================================
1518+ F6E6              CompassWobbleTable:
1519+ F6E6 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1520+ F6EA 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1521+ F6EE 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1522+ F6F2 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1523+ F6F6 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1524+ F6FA 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1525+ F6FE 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1526+ F702 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1527+ F706 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1528+ F70A
1529+ F70A              ; ==============================================================================
1530+ F70A              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1531+ F70A              ; Indexada por (counter-1) -> 0..8. Valor:
1532+ F70A              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1533+ F70A              ; Con counter inicial 9 y decremento por frame:
1534+ F70A              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1535+ F70A              ;   counter 8 -> phase 7 -> prev
1536+ F70A              ;   counter 7 -> phase 6 -> target
1537+ F70A              ;   counter 6 -> phase 5 -> next
1538+ F70A              ;   counter 5 -> phase 4 -> next2
1539+ F70A              ;   counter 4 -> phase 3 -> prev
1540+ F70A              ;   counter 3 -> phase 2 -> target
1541+ F70A              ;   counter 2 -> phase 1 -> prev
1542+ F70A              ;   counter 1 -> phase 0 -> target (estado final, settle)
1543+ F70A              ; ==============================================================================
1544+ F70A              WobblePhaseTable:
1545+ F70A 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1545+ F70E 04 03 02 01
1545+ F712 00
