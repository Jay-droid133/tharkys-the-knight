 609+ 6969 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 610+ 696B                  ; Leer charX (HL+4) y charY (HL+5) en BC
 611+ 696B E5               PUSH HL                                 ; save mapX ptr
 612+ 696C 01 04 00         LD BC, 4
 613+ 696F 09               ADD HL, BC
 614+ 6970 46               LD B, (HL)                              ; B = charX
 615+ 6971 23               INC HL
 616+ 6972 4E               LD C, (HL)                              ; C = charY
 617+ 6973 E1               POP HL                                  ; HL = mapX ptr
 618+ 6974                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 619+ 6974 E5               PUSH HL
 620+ 6975 C5               PUSH BC
 621+ 6976 21 1E E3         LD HL, BgGfx_old_church_door_open
 622+ 6979 3E 03            LD A, 3
 623+ 697B CD 7A 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 624+ 697E C1               POP BC
 625+ 697F C5               PUSH BC
 626+ 6980 DD 21 9A 89      LD IX, BgSpriteBuffer
 627+ 6984 CD 1A DE         CALL DrawBgSpriteXOR                    ; borra
