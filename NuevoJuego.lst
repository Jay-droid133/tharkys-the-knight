 560+ 692A              ; ==============================================================================
 561+ 692A              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 562+ 692A              ; ==============================================================================
 563+ 692A              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 564+ 692A              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 565+ 692A              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 566+ 692A              ;   2. Leer charX/charY de la entry
 567+ 692A              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 568+ 692A              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 569+ 692A              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 570+ 692A              ;   6. ChurchDoorOpen = 0
 571+ 692A              ; ==============================================================================
 572+ 692A              CloseChurchDoor:
 573+ 692A                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
 574+ 692A                  ; ambos sentidos). Suena ANTES del cambio visual.
 575+ 692A 21 10 F2         LD HL, SFX_ChurchDoorOpen
 576+ 692D CD 1E F1         CALL PlaySFX
 577+ 6930 11 BA E2         LD DE, BgGfx_old_church_door_open
 578+ 6933 CD BD 69         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 579+ 6936 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 580+ 6938                  ; Leer charX (HL+4) y charY (HL+5) en BC
 581+ 6938 E5               PUSH HL                                 ; save mapX ptr
 582+ 6939 01 04 00         LD BC, 4
 583+ 693C 09               ADD HL, BC
 584+ 693D 46               LD B, (HL)                              ; B = charX
 585+ 693E 23               INC HL
 586+ 693F 4E               LD C, (HL)                              ; C = charY
 587+ 6940 E1               POP HL                                  ; HL = mapX ptr
 588+ 6941                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 589+ 6941 E5               PUSH HL
 590+ 6942 C5               PUSH BC
 591+ 6943 21 BA E2         LD HL, BgGfx_old_church_door_open
 592+ 6946 3E 03            LD A, 3
 593+ 6948 CD D2 90         CALL LoadBgSpriteToBuffer               ; preserva BC
 594+ 694B C1               POP BC
 595+ 694C C5               PUSH BC
 596+ 694D DD 21 0A 89      LD IX, BgSpriteBuffer
 597+ 6951 CD D9 D6         CALL DrawBgSpriteXOR                    ; borra
 598+ 6954 C1               POP BC
 599+ 6955 E1               POP HL
 600+ 6956                  ; --- Patch ptr: open -> closed ---
 601+ 6956 23               INC HL
 601+ 6957 23             INC HL                         ; -> ptr_lo
 602+ 6958 3E 01            LD A, LOW BgGfx_old_church_door_closed
 603+ 695A 77               LD (HL), A
 604+ 695B 23               INC HL
 605+ 695C 3E E2            LD A, HIGH BgGfx_old_church_door_closed
 606+ 695E 77               LD (HL), A
 607+ 695F                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 608+ 695F C5               PUSH BC
 609+ 6960 21 01 E2         LD HL, BgGfx_old_church_door_closed
 610+ 6963 3E 03            LD A, 3
 611+ 6965 CD D2 90         CALL LoadBgSpriteToBuffer
 612+ 6968 C1               POP BC
 613+ 6969 C5               PUSH BC
 614+ 696A DD 21 0A 89      LD IX, BgSpriteBuffer
 615+ 696E CD D9 D6         CALL DrawBgSpriteXOR
 616+ 6971 C1               POP BC
 617+ 6972 DD 21 0A 89      LD IX, BgSpriteBuffer
 618+ 6976 AF               XOR A
 619+ 6977 32 89 DD         LD (BgSpriteIsHouse), A
 620+ 697A CD 1E D7         CALL DrawBgAttrOnly
 621+ 697D              .ccdFlag:
 622+ 697D AF               XOR A
 623+ 697E 32 F2 81         LD (ChurchDoorOpen), A
 624+ 6981 C9               RET
 625+ 6982
 626+ 6982              ; ==============================================================================
 627+ 6982              ; RespawnChurchKeyAtAlt - patch PickupTable entry de church_key con coords AltN
 628+ 6982              ; ==============================================================================
 629+ 6982              ; Lee ChurchKeyAltSpawnIdx (1 o 2) y patchea con CHURCH_KEY_ALT[1|2]_* coords.
 630+ 6982              ; ==============================================================================
 631+ 6982              RespawnChurchKeyAtAlt:
