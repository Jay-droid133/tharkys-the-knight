 515+ 6931              ; ==============================================================================
 516+ 6931              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 517+ 6931              ; ==============================================================================
 518+ 6931              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 519+ 6931              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 520+ 6931              ;
 521+ 6931              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 522+ 6931              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 523+ 6931              ;     E = pixel X (0-255).
 524+ 6931              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 525+ 6931              ; Solo XOR de pixels (no toca attrs).
 526+ 6931              ; Destruye: AF, BC, DE, HL, IX.
 527+ 6931              ; ==============================================================================
 528+ 6931              DrawBgSprite16XorAtPixel:
 529+ 6931 DD 21 F5 89      LD IX, BgSpriteBuffer
 530+ 6935 DD 7E 00         LD A, (IX+0)                            ; height_px
 531+ 6938 B7               OR A
 532+ 6939 C8               RET Z
 533+ 693A 32 9D 69         LD (.dbsHeight), A
 534+ 693D DD 23            INC IX
 535+ 693F DD 23            INC IX                                  ; -> pixel data
 536+ 6941                  ; Shift = E & 7 ; aligned X = E & ~7
 537+ 6941 7B               LD A, E
 538+ 6942 E6 07            AND $07
 539+ 6944 32 9E 69         LD (.dbsShift), A
 540+ 6947 7B               LD A, E
 541+ 6948 E6 F8            AND $F8
 542+ 694A 5F               LD E, A
 543+ 694B CD 40 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
 544+ 694E              .dbsRow:
 545+ 694E E5               PUSH HL                                 ; save row start
 546+ 694F                  ; --- Byte 0 del sprite ---
 547+ 694F DD 7E 00         LD A, (IX+0)
 548+ 6952 2F               CPL                                     ; un-invert
 549+ 6953 57               LD D, A                                 ; D = sprite byte
 550+ 6954 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 551+ 6956 3A 9E 69         LD A, (.dbsShift)
 552+ 6959 B7               OR A
 553+ 695A 28 07            JR Z, .dbsNoShift0
 554+ 695C 47               LD B, A
 555+ 695D              .dbsShift0Loop:
 556+ 695D CB 3A            SRL D
 557+ 695F CB 1B            RR E
 558+ 6961 10 FA            DJNZ .dbsShift0Loop
 559+ 6963              .dbsNoShift0:
 560+ 6963 7A               LD A, D
 561+ 6964 AE               XOR (HL)
 562+ 6965 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 563+ 6966 23               INC HL
 564+ 6967 4B               LD C, E                                 ; C = carry para siguiente byte
 565+ 6968                  ; --- Byte 1 del sprite ---
 566+ 6968 DD 7E 01         LD A, (IX+1)
 567+ 696B 2F               CPL
 568+ 696C 57               LD D, A
 569+ 696D 1E 00            LD E, 0
 570+ 696F 3A 9E 69         LD A, (.dbsShift)
 571+ 6972 B7               OR A
 572+ 6973 28 07            JR Z, .dbsNoShift1
 573+ 6975 47               LD B, A
 574+ 6976              .dbsShift1Loop:
 575+ 6976 CB 3A            SRL D
 576+ 6978 CB 1B            RR E
 577+ 697A 10 FA            DJNZ .dbsShift1Loop
 578+ 697C              .dbsNoShift1:
 579+ 697C 7A               LD A, D
 580+ 697D B1               OR C                                    ; combinar con carry de byte 0
 581+ 697E AE               XOR (HL)
 582+ 697F 77               LD (HL), A
 583+ 6980 23               INC HL
 584+ 6981 4B               LD C, E                                 ; carry para byte final
 585+ 6982                  ; --- Byte final (solo si shift>0) ---
 586+ 6982 3A 9E 69         LD A, (.dbsShift)
 587+ 6985 B7               OR A
 588+ 6986 28 03            JR Z, .dbsNoFinal
 589+ 6988 79               LD A, C
 590+ 6989 AE               XOR (HL)
 591+ 698A 77               LD (HL), A
 592+ 698B              .dbsNoFinal:
 593+ 698B E1               POP HL                                  ; restore row start
 594+ 698C CD AC 9D         CALL NextPixelLine
 595+ 698F DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 596+ 6991 DD 23            INC IX
 597+ 6993 3A 9D 69         LD A, (.dbsHeight)
 598+ 6996 3D               DEC A
 599+ 6997 32 9D 69         LD (.dbsHeight), A
 600+ 699A 20 B2            JR NZ, .dbsRow
 601+ 699C C9               RET
 602+ 699D 00           .dbsHeight: DEFB 0
 603+ 699E 00           .dbsShift:  DEFB 0
 604+ 699F
 605+ 699F              ; ==============================================================================
 606+ 699F              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 607+ 699F              ; ==============================================================================
 608+ 699F              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 609+ 699F              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 610+ 699F              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 611+ 699F              ;   2. Leer charX/charY de la entry
 612+ 699F              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 613+ 699F              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 614+ 699F              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 615+ 699F              ;   6. ChurchDoorOpen = 0
 616+ 699F              ; ==============================================================================
 617+ 699F              CloseChurchDoor:
 618+ 699F                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
 619+ 699F                  ; ambos sentidos). Suena ANTES del cambio visual.
 620+ 699F 21 3A FA         LD HL, SFX_ChurchDoorOpen
 621+ 69A2 CD 23 F9         CALL PlaySFX
 622+ 69A5 11 26 DF         LD DE, BgGfx_old_church_door_open
 623+ 69A8 CD 32 6A         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 624+ 69AB 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 625+ 69AD                  ; Leer charX (HL+4) y charY (HL+5) en BC
 626+ 69AD E5               PUSH HL                                 ; save mapX ptr
 627+ 69AE 01 04 00         LD BC, 4
 628+ 69B1 09               ADD HL, BC
 629+ 69B2 46               LD B, (HL)                              ; B = charX
 630+ 69B3 23               INC HL
 631+ 69B4 4E               LD C, (HL)                              ; C = charY
 632+ 69B5 E1               POP HL                                  ; HL = mapX ptr
 633+ 69B6                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 634+ 69B6 E5               PUSH HL
 635+ 69B7 C5               PUSH BC
 636+ 69B8 21 26 DF         LD HL, BgGfx_old_church_door_open
 637+ 69BB 3E 03            LD A, 3
 638+ 69BD CD BC 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 639+ 69C0 C1               POP BC
 640+ 69C1 C5               PUSH BC
 641+ 69C2 DD 21 F5 89      LD IX, BgSpriteBuffer
 642+ 69C6 CD 17 DE         CALL DrawBgSpriteXOR                    ; borra
 643+ 69C9 C1               POP BC
 644+ 69CA E1               POP HL
 645+ 69CB                  ; --- Patch ptr: open -> closed ---
