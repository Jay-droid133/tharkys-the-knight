 657+ 65C7              ; ==============================================================================
 658+ 65C7              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 659+ 65C7              ; ==============================================================================
 660+ 65C7              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 661+ 65C7              ;    al haberse dibujado ya en el render normal de la sala).
 662+ 65C7              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 65C7              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 65C7              ; Bank 3 para ambos (sprites baseline town).
 665+ 65C7              ; Destruye: AF, BC, DE, HL, IX.
 666+ 65C7              ; ==============================================================================
 667+ 65C7              TownGateOpenDoor:
 668+ 65C7 11 A8 E2         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 65CA CD 0E D8         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 65CD                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 65CD
 672+ 65CD              ; ==============================================================================
 673+ 65CD              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 65CD              ; ==============================================================================
 675+ 65CD              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 65CD              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 65CD              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 65CD              ; ==============================================================================
 679+ 65CD              TownGateRedrawOpenDoor:
 680+ 65CD 21 67 E6         LD HL, BgGfx_town_gate_door_open
 681+ 65D0 3E 03            LD A, 3
 682+ 65D2 CD C2 6C         CALL LoadBgSpriteToBuffer
 683+ 65D5 DD 21 F5 86      LD IX, BgSpriteBuffer
 684+ 65D9 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 65DB 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 65DD AF               XOR A
 687+ 65DE 32 D5 E2         LD (BgSpriteIsHouse), A
 688+ 65E1 32 74 D2         LD (CurrentTintVar), A
 689+ 65E4 C3 6A D1         JP DrawBgGfxSprite
 690+ 65E7
 691+ 65E7              ; ==============================================================================
 692+ 65E7              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 65E7              ; ==============================================================================
 694+ 65E7              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 65E7              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 65E7              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 65E7              ; Destruye: A, BC, DE, IX.
 698+ 65E7              ; ==============================================================================
 699+ 65E7              TownGateAllNastiesDeadCheck:
 700+ 65E7 DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 65EB 06 03            LD B, NUM_NASTIES
 702+ 65ED              .tgandcLoop:
 703+ 65ED DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 65F0 B7               OR A
 705+ 65F1 C0               RET NZ                              ; algun nasty aun activo
 706+ 65F2 11 10 00         LD DE, ENT_SIZE
 707+ 65F5 DD 19            ADD IX, DE
 708+ 65F7 10 F4            DJNZ .tgandcLoop
 709+ 65F9 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 65FA C9               RET
 711+ 65FB
 712+ 65FB              ; ==============================================================================
 713+ 65FB              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 65FB              ; ==============================================================================
 715+ 65FB              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 65FB              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 65FB              ; y abajo se dibujan normal (XOR).
 718+ 65FB              ;
 719+ 65FB              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 65FB              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 65FB              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 65FB              ;   inferiores que pasan tras el lintel skipped.
 723+ 65FB              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 65FB              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 65FB              ;   lintel skipped.
 726+ 65FB              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 65FB              ;
 728+ 65FB              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 65FB              ;     Bank 6 paginado al entrar (caller).
 730+ 65FB              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 65FB              ; Destruye: AF, BC, DE, HL, IY.
 732+ 65FB              ; ==============================================================================
 733+ 65FB              PLAYER_H_PX              EQU 21
 734+ 65FB
 735+ 65FB              TownGatePlayerXOR_BiClip:
 736+ 65FB FD 23            INC IY
 737+ 65FD FD 23            INC IY                              ; skip header
 738+ 65FF D5               PUSH DE
 739+ 6600 CD 5A 9D         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 6603 D1               POP DE
 741+ 6604 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 6606 4A               LD C, D                             ; C = current pixel Y
 743+ 6607              .tgpxbcRow:
 744+ 6607 79               LD A, C
 745+ 6608 FE C0            CP 192
 746+ 660A 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 660C                                                      ; (sin este clip, NextPixelLine lleva
 748+ 660C                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 660C                                                      ; corrompe attrs como flashes raros).
 750+ 660C FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 660E 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 6610 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 6612 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 6614                  ; In [120, 151] → skip pixels en esta row
 755+ 6614 18 0C            JR .tgpxbcAdvance
 756+ 6616              .tgpxbcDraw:
 757+ 6616                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 6616                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 6616 FD 7E 00         LD A, (IY+0)
 760+ 6619 AE               XOR (HL)
 761+ 661A 77               LD (HL), A
 762+ 661B 23               INC HL
 763+ 661C FD 7E 01         LD A, (IY+1)
 764+ 661F AE               XOR (HL)
 765+ 6620 77               LD (HL), A
 766+ 6621 2B               DEC HL                              ; back to row start
 767+ 6622              .tgpxbcAdvance:
 768+ 6622 FD 23            INC IY
 769+ 6624 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 6626 0C               INC C                               ; pixel Y += 1
 771+ 6627 C5               PUSH BC
 772+ 6628 CD C6 9A         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 662B C1               POP BC
 774+ 662C 10 D9            DJNZ .tgpxbcRow
 775+ 662E C9               RET
 776+ 662F
 777+ 662F              ; ==============================================================================
 778+ 662F              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 662F              ; ==============================================================================
 780+ 662F              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 662F              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 662F              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 662F              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 662F              ; ==============================================================================
 785+ 662F              TownGatePlayerSlideErase:
 786+ 662F DD 21 9B 81      LD IX, EntityTable
 787+ 6633 DD E5            PUSH IX
 788+ 6635 CD F4 A4         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6638 DD E1            POP IX
 790+ 663A 3A 82 8D         LD A, (CurrentPaging)
 791+ 663D E6 F8            AND $F8
 792+ 663F F6 06            OR 6
 793+ 6641 32 82 8D         LD (CurrentPaging), A
 794+ 6644 01 FD 7F         LD BC, $7FFD
 795+ 6647 ED 79            OUT (C), A
 796+ 6649 FD 2A 7C A4      LD IY, (OldSprAddr)
 797+ 664D DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 6650 DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 6653 5F               LD E, A
 800+ 6654 CD FB 65         CALL TownGatePlayerXOR_BiClip
 801+ 6657 3A 82 8D         LD A, (CurrentPaging)
 802+ 665A E6 F8            AND $F8
 803+ 665C 32 82 8D         LD (CurrentPaging), A
 804+ 665F 01 FD 7F         LD BC, $7FFD
 805+ 6662 ED 79            OUT (C), A
 806+ 6664 C9               RET
 807+ 6665
 808+ 6665              TownGatePlayerSlideDraw:
 809+ 6665 DD 21 9B 81      LD IX, EntityTable
 810+ 6669 DD E5            PUSH IX
 811+ 666B CD C3 A4         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 666E DD E1            POP IX
 813+ 6670 3A 82 8D         LD A, (CurrentPaging)
 814+ 6673 E6 F8            AND $F8
 815+ 6675 F6 06            OR 6
 816+ 6677 32 82 8D         LD (CurrentPaging), A
 817+ 667A 01 FD 7F         LD BC, $7FFD
 818+ 667D ED 79            OUT (C), A
 819+ 667F FD 2A F2 A4      LD IY, (SpriteAddrTemp)
 820+ 6683 3A DC 82         LD A, (PlayerDrawY)
 821+ 6686 57               LD D, A
 822+ 6687 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 668A 5F               LD E, A
 824+ 668B CD FB 65         CALL TownGatePlayerXOR_BiClip
 825+ 668E 3A 82 8D         LD A, (CurrentPaging)
 826+ 6691 E6 F8            AND $F8
 827+ 6693 32 82 8D         LD (CurrentPaging), A
 828+ 6696 01 FD 7F         LD BC, $7FFD
 829+ 6699 ED 79            OUT (C), A
 830+ 669B                  ; Update OLD = current
 831+ 669B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 669E DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 66A1 3A DC 82         LD A, (PlayerDrawY)
 834+ 66A4 DD 77 0D         LD (IX+ENT_OLDY), A
