 246+ E4AD              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 247+ E4AD              DrawSwordModeHUD:
 248+ E4AD 3A 85 B3         LD A, (SwordMode)
 249+ E4B0 21 E0 E4         LD HL, .modeChars
 250+ E4B3 5F               LD E, A
 251+ E4B4 16 00            LD D, 0
 252+ E4B6 19               ADD HL, DE
 253+ E4B7 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E4B8                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E4B8 21 00 40         LD HL, $4000
 256+ E4BB                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E4BB 5F               LD E, A
 258+ E4BC 16 00            LD D, 0
 259+ E4BE 42               LD B, D                             ; B = 0
 260+ E4BF CB 23            SLA E
 260+ E4C1 CB 12          RL D                        ; *2
 261+ E4C3 CB 23            SLA E
 261+ E4C5 CB 12          RL D                        ; *4
 262+ E4C7 CB 23            SLA E
 262+ E4C9 CB 12          RL D                        ; *8
 263+ E4CB E5               PUSH HL
 264+ E4CC 21 00 3C         LD HL, $3C00
 265+ E4CF 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E4D0 EB               EX DE, HL                           ; DE = glyph
 267+ E4D1 E1               POP HL                              ; HL = VRAM
 268+ E4D2 06 08            LD B, 8
 269+ E4D4              .drawChar:
 270+ E4D4 1A               LD A, (DE)
 271+ E4D5 77               LD (HL), A
 272+ E4D6 13               INC DE
 273+ E4D7 24               INC H                               ; siguiente scan line
 274+ E4D8 10 FA            DJNZ .drawChar
 275+ E4DA                  ; Attr: fila 0, col 0 = $5800
 276+ E4DA 3E 47            LD A, $47                           ; blanco bright
 277+ E4DC 32 00 58         LD ($5800), A
 278+ E4DF C9               RET
 279+ E4E0
 280+ E4E0 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 281+ E4E3
 282+ E4E3              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 283+ E4E3              DrawNoclipHUD:
 284+ E4E3 3A B2 82         LD A, (NoclipMode)
 285+ E4E6 B7               OR A
 286+ E4E7 20 0E            JR NZ, .ncOn
 287+ E4E9 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 288+ E4EB 1E 1E            LD E, 30
 289+ E4ED CD 18 E7         CALL DrawHudChar
 290+ E4F0 3E 20            LD A, 32
 291+ E4F2 1E 1F            LD E, 31
 292+ E4F4 C3 18 E7         JP DrawHudChar
 293+ E4F7              .ncOn:
 294+ E4F7 3E 4E            LD A, 'N'
 295+ E4F9 1E 1E            LD E, 30
