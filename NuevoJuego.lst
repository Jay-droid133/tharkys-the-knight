1187+ A89D              ; ==============================================================================
1188+ A89D              ; UpdatePlayerState - Determina estado y direccion desde input
1189+ A89D              ; ==============================================================================
1190+ A89D              UpdatePlayerState:
1191+ A89D 3A 4F 82         LD A, (InputDirection)
1192+ A8A0 47               LD B, A
1193+ A8A1 3A 50 82         LD A, (InputFire)
1194+ A8A4 4F               LD C, A
1195+ A8A5
1196+ A8A5                  ; Sin input → idle (salvo si ataque en curso)
1197+ A8A5 78               LD A, B
1198+ A8A6 B1               OR C
1199+ A8A7 20 17            JR NZ, .notIdle
1200+ A8A9                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1201+ A8A9 3A 33 B6         LD A, (AttackTimer)
1202+ A8AC B7               OR A
1203+ A8AD 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1204+ A8AF DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1205+ A8B3                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1206+ A8B3 DD 7E 0A         LD A, (IX+ENT_DIR)
1207+ A8B6 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1208+ A8B8 DD 77 0A         LD (IX+ENT_DIR), A
1209+ A8BB                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1210+ A8BB AF               XOR A
1211+ A8BC 32 35 B6         LD (AttackDebounce), A
1212+ A8BF C9               RET
1213+ A8C0
1214+ A8C0              .notIdle:
1215+ A8C0                  ; Guardar direccion actual en bits 0-3
1216+ A8C0 DD 7E 0A         LD A, (IX+ENT_DIR)
1217+ A8C3 E6 F0            AND $F0                     ; Mantener lastHDir
1218+ A8C5 B0               OR B                        ; Añadir dir actual
1219+ A8C6 DD 77 0A         LD (IX+ENT_DIR), A
1220+ A8C9
1221+ A8C9                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1222+ A8C9 3A 33 B6         LD A, (AttackTimer)
1223+ A8CC B7               OR A
1224+ A8CD 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1225+ A8CF 78               LD A, B
1226+ A8D0 E6 0C            AND DIR_E | DIR_W
1227+ A8D2 28 0E            JR Z, .noHorizUpdate
1228+ A8D4                  ; Guardar en bits 4-7
1229+ A8D4 07               RLCA
1230+ A8D5 07               RLCA
1231+ A8D6 07               RLCA
1232+ A8D7 07               RLCA                        ; Shift a bits 4-7
1233+ A8D8 4F               LD C, A                     ; C = lastHDir en bits 4-7
1234+ A8D9 DD 7E 0A         LD A, (IX+ENT_DIR)
1235+ A8DC E6 0F            AND $0F                     ; Mantener dir actual
1236+ A8DE B1               OR C                        ; Añadir lastHDir
1237+ A8DF DD 77 0A         LD (IX+ENT_DIR), A
1238+ A8E2              .noHorizUpdate:
