 139+ 9D51              .alignedLine:
 140+ 9D51 3A A8 9D         LD A, (.widthSave)
 141+ 9D54 47               LD B, A                     ; B = ancho en bytes
 142+ 9D55 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9D56
 144+ 9D56              .alignedByte:
