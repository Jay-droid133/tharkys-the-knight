 389+ A405              ; ==============================================================================
 390+ A405              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 391+ A405              ; ==============================================================================
 392+ A405              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 393+ A405              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 394+ A405              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 395+ A405              ; ==============================================================================
 396+ A405              ProcessEnemies:
 397+ A405 3E 00            LD A, 0
 398+ A407 32 50 A4         LD (.peCount), A
 399+ A40A 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 400+ A40C
 401+ A40C              .peLoop:
 402+ A40C C5               PUSH BC
 403+ A40D
 404+ A40D                  ; Calcular IX desde EnemyStepIdx
 405+ A40D 3A 17 82         LD A, (EnemyStepIdx)
 406+ A410 C6 01            ADD A, SLOT_MONSTER0
 407+ A412 6F               LD L, A
 408+ A413 26 00            LD H, 0
 409+ A415 29               ADD HL, HL
 410+ A416 29               ADD HL, HL
 411+ A417 29               ADD HL, HL
 412+ A418 29               ADD HL, HL                          ; × ENT_SIZE (16)
 413+ A419 11 DC 80         LD DE, EntityTable
 414+ A41C 19               ADD HL, DE
 415+ A41D E5               PUSH HL
 416+ A41E DD E1            POP IX
 417+ A420
 418+ A420                  ; Avanzar indice round-robin
 419+ A420 3A 17 82         LD A, (EnemyStepIdx)
 420+ A423 3C               INC A
 421+ A424 FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 422+ A426 38 01            JR C, .peNoWrap
 423+ A428 AF               XOR A
 424+ A429              .peNoWrap:
 425+ A429 32 17 82         LD (EnemyStepIdx), A
 426+ A42C
 427+ A42C                  ; Slot activo?
 428+ A42C DD 7E 01         LD A, (IX+ENT_TYPE)
 429+ A42F B7               OR A
 430+ A430 28 16            JR Z, .peSkip
 431+ A432
 432+ A432                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 433+ A432 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 434+ A436 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 435+ A437
 436+ A437                  ; Procesar esta entidad completa (erase + logic + draw)
 437+ A437 CD 51 A4         CALL ProcessOneEnemy
 438+ A43A
 439+ A43A                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 440+ A43A F1               POP AF
 441+ A43B 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 442+ A43D
 443+ A43D                  ; Budget check
 444+ A43D 3A 50 A4         LD A, (.peCount)
 445+ A440 3C               INC A
 446+ A441 32 50 A4         LD (.peCount), A
 447+ A444 FE 02            CP MAX_ENEMIES_PER_FRAME
 448+ A446 30 06            JR NC, .peDone
