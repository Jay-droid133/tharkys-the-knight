 108  EA00                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ EA00              ; ==============================================================================
   2+ EA00              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ EA00              ; ==============================================================================
   4+ EA00              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ EA00              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ EA00              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ EA00              ; ==============================================================================
   8+ EA00
   9+ EA00              ; --- Constantes ---
  10+ EA00              NUM_TIME_MOMENTS    EQU 7
  11+ EA00
  12+ EA00              ; --- Variables ---
  13+ EA00 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ EA01 79 ED        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ EA03 79 ED        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ EA05 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ EA06 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ EA07
  19+ EA07              ; ==============================================================================
  20+ EA07              ; SetTimeOfDay - Cambia el momento del dia
  21+ EA07              ; ==============================================================================
  22+ EA07              ; Entrada: A = momento (0-6)
  23+ EA07              ; ==============================================================================
  24+ EA07              SetTimeOfDay:
  25+ EA07 32 00 EA         LD (CurrentTimeOfDay), A
  26+ EA0A
  27+ EA0A                  ; DY (fase 0): incrementar ciclo de dia
  28+ EA0A B7               OR A
  29+ EA0B 20 04            JR NZ, .notNewCycle
  30+ EA0D 21 C9 A2         LD HL, DayCycleCount
  31+ EA10 34               INC (HL)
  32+ EA11              .notNewCycle:
  33+ EA11
  34+ EA11                  ; N2 (medianoche): campanadas primero, remap al terminar
  35+ EA11 FE 04            CP 4
  36+ EA13 28 13            JR Z, .bellsFirst
  37+ EA15
  38+ EA15                  ; Amanecer temprano (fase 5): despawnear monsters
  39+ EA15 FE 05            CP 5
  40+ EA17 20 03            JR NZ, .noDespawn
  41+ EA19 CD E3 A2         CALL ScareAllMonsters
  42+ EA1C              .noDespawn:
  43+ EA1C
  44+ EA1C                  ; Actualizar tablas de remap y tabla de nasties
  45+ EA1C CD 2C EA         CALL UpdateRemapTables
  46+ EA1F CD CC A2         CALL UpdateNastyTable
  47+ EA22
  48+ EA22                  ; Forzar remap de atributos (sin redibujar pixeles)
  49+ EA22 3E 01            LD A, 1
  50+ EA24 32 B5 81         LD (AttrsDirty), A
  51+ EA27 C9               RET
  52+ EA28
  53+ EA28              .bellsFirst:
  54+ EA28                  ; NO actualizar tablas: mantener colores de N1 durante campanadas
  55+ EA28 CD 02 F5         CALL StartBellChimes
  56+ EA2B C9               RET
  57+ EA2C
  58+ EA2C              ; ==============================================================================
  59+ EA2C              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
  60+ EA2C              ; ==============================================================================
  61+ EA2C              UpdateRemapTables:
  62+ EA2C 3A 00 EA         LD A, (CurrentTimeOfDay)
  63+ EA2F 21 4D ED         LD HL, RemapTablePtrs
  64+ EA32 5F               LD E, A
  65+ EA33 16 00            LD D, 0
  66+ EA35 19               ADD HL, DE
  67+ EA36 19               ADD HL, DE
  68+ EA37 5E               LD E, (HL)
  69+ EA38 23               INC HL
  70+ EA39 56               LD D, (HL)
  71+ EA3A ED 53 01 EA      LD (CurrentRemapTable), DE
  72+ EA3E
  73+ EA3E 3A 00 EA         LD A, (CurrentTimeOfDay)
  74+ EA41 21 5B ED         LD HL, RemapHouseTablePtrs
  75+ EA44 5F               LD E, A
  76+ EA45 16 00            LD D, 0
  77+ EA47 19               ADD HL, DE
  78+ EA48 19               ADD HL, DE
  79+ EA49 5E               LD E, (HL)
  80+ EA4A 23               INC HL
  81+ EA4B 56               LD D, (HL)
  82+ EA4C ED 53 03 EA      LD (CurrentHouseRemapTable), DE
  83+ EA50 C9               RET
  84+ EA51
  85+ EA51              ; ==============================================================================
  86+ EA51              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
  87+ EA51              ; ==============================================================================
  88+ EA51              CheckDebugKeys:
  89+ EA51 3E FB            LD A, $FB
  90+ EA53 DB FE            IN A, ($FE)
  91+ EA55 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
  92+ EA57 20 1C            JR NZ, .notPressed
  93+ EA59
  94+ EA59                  ; Tecla pulsada: comprobar debounce
  95+ EA59 3A 06 EA         LD A, (DebugKeyDebounce)
  96+ EA5C B7               OR A
  97+ EA5D C0               RET NZ                  ; Ya estaba pulsada, ignorar
  98+ EA5E
  99+ EA5E                  ; Primera pulsacion: ciclar
 100+ EA5E 3E 01            LD A, 1
 101+ EA60 32 06 EA         LD (DebugKeyDebounce), A
 102+ EA63
 103+ EA63 3A 00 EA         LD A, (CurrentTimeOfDay)
 104+ EA66 3C               INC A
 105+ EA67 FE 07            CP NUM_TIME_MOMENTS
 106+ EA69 38 01            JR C, .noWrap
 107+ EA6B AF               XOR A                   ; Volver a 0 (Dia)
 108+ EA6C              .noWrap:
 109+ EA6C F5               PUSH AF
 110+ EA6D CD 07 EA         CALL SetTimeOfDay
 111+ EA70 F1               POP AF
 112+ EA71 CD C9 F0         CALL SetClockToPhaseHour
 113+ EA74 C9               RET
 114+ EA75
 115+ EA75              .notPressed:
 116+ EA75 AF               XOR A
 117+ EA76 32 06 EA         LD (DebugKeyDebounce), A
 118+ EA79
 119+ EA79                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 120+ EA79 3E FD            LD A, $FD
 121+ EA7B DB FE            IN A, ($FE)
 122+ EA7D 4F               LD C, A                 ; C = estado semi-fila $FDFE
 123+ EA7E CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 124+ EA80 20 13            JR NZ, .sNotPressed
 125+ EA82 3A B1 EA         LD A, (SpeedKeyDebounce)
 126+ EA85 B7               OR A
 127+ EA86 C0               RET NZ
 128+ EA87 3E 01            LD A, 1
 129+ EA89 32 B1 EA         LD (SpeedKeyDebounce), A
 130+ EA8C 21 C9 A2         LD HL, DayCycleCount
 131+ EA8F 7E               LD A, (HL)
 132+ EA90 FE 0A            CP 10
 133+ EA92 D0               RET NC                  ; Ya en maximo
 134+ EA93 34               INC (HL)
 135+ EA94 C9               RET
 136+ EA95              .sNotPressed:
 137+ EA95                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 138+ EA95 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 139+ EA97 20 13            JR NZ, .dNotPressed
 140+ EA99 3A B1 EA         LD A, (SpeedKeyDebounce)
 141+ EA9C B7               OR A
 142+ EA9D C0               RET NZ
 143+ EA9E 3E 01            LD A, 1
 144+ EAA0 32 B1 EA         LD (SpeedKeyDebounce), A
 145+ EAA3 21 C9 A2         LD HL, DayCycleCount
 146+ EAA6 7E               LD A, (HL)
 147+ EAA7 FE 01            CP 1
 148+ EAA9 C8               RET Z                   ; Ya en minimo
 149+ EAAA 35               DEC (HL)
 150+ EAAB C9               RET
 151+ EAAC              .dNotPressed:
 152+ EAAC AF               XOR A
 153+ EAAD 32 B1 EA         LD (SpeedKeyDebounce), A
 154+ EAB0 C9               RET
 155+ EAB1
 156+ EAB1 00           SpeedKeyDebounce: DEFB 0
 157+ EAB2
 158+ EAB2              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 159+ EAB2              DrawSwordModeHUD:
 160+ EAB2 3A 43 9D         LD A, (SwordMode)
 161+ EAB5 21 E5 EA         LD HL, .modeChars
 162+ EAB8 5F               LD E, A
 163+ EAB9 16 00            LD D, 0
 164+ EABB 19               ADD HL, DE
 165+ EABC 7E               LD A, (HL)                          ; A = ASCII del modo
 166+ EABD                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 167+ EABD 21 00 40         LD HL, $4000
 168+ EAC0                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 169+ EAC0 5F               LD E, A
 170+ EAC1 16 00            LD D, 0
 171+ EAC3 42               LD B, D                             ; B = 0
 172+ EAC4 CB 23            SLA E
 172+ EAC6 CB 12          RL D                        ; *2
 173+ EAC8 CB 23            SLA E
 173+ EACA CB 12          RL D                        ; *4
 174+ EACC CB 23            SLA E
 174+ EACE CB 12          RL D                        ; *8
 175+ EAD0 E5               PUSH HL
 176+ EAD1 21 00 3C         LD HL, $3C00
 177+ EAD4 19               ADD HL, DE                          ; HL = direccion del glyph
 178+ EAD5 EB               EX DE, HL                           ; DE = glyph
 179+ EAD6 E1               POP HL                              ; HL = VRAM
 180+ EAD7 06 08            LD B, 8
 181+ EAD9              .drawChar:
 182+ EAD9 1A               LD A, (DE)
 183+ EADA 77               LD (HL), A
 184+ EADB 13               INC DE
 185+ EADC 24               INC H                               ; siguiente scan line
 186+ EADD 10 FA            DJNZ .drawChar
 187+ EADF                  ; Attr: fila 0, col 0 = $5800
 188+ EADF 3E 47            LD A, $47                           ; blanco bright
 189+ EAE1 32 00 58         LD ($5800), A
 190+ EAE4 C9               RET
 191+ EAE5
 192+ EAE5 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 193+ EAE8
 194+ EAE8              ; ==============================================================================
 195+ EAE8              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 196+ EAE8              ; ==============================================================================
 197+ EAE8              ; Entrada: A = attr original
 198+ EAE8              ; Salida:  A = attr transformado
 199+ EAE8              ; Preserva: HL, DE, BC, IX
 200+ EAE8              ; ==============================================================================
 201+ EAE8              ApplyDayCycleRemap:
 202+ EAE8 E5               PUSH HL
 203+ EAE9 67               LD H, A                     ; H = attr (temp save)
 204+ EAEA 3A 00 EA         LD A, (CurrentTimeOfDay)
 205+ EAED B7               OR A
 206+ EAEE 20 03            JR NZ, .doRemap
 207+ EAF0 7C               LD A, H                     ; Dia: devolver sin cambio
 208+ EAF1 E1               POP HL
 209+ EAF2 C9               RET
 210+ EAF3
 211+ EAF3              .doRemap:
 212+ EAF3 D5               PUSH DE
 213+ EAF4 C5               PUSH BC
 214+ EAF5
 215+ EAF5 7C               LD A, H                     ; A = attr original
 216+ EAF6 4F               LD C, A                     ; C = attr original
 217+ EAF7
 218+ EAF7                  ; Guardar flash + ink (bits 7, 2-0)
 219+ EAF7 E6 87            AND $87                     ; A = F000_0III
 220+ EAF9 47               LD B, A                     ; B = flash | ink
 221+ EAFA
 222+ EAFA                  ; Extraer paper+bright como indice 0-15
 223+ EAFA 79               LD A, C
 224+ EAFB E6 78            AND $78                     ; A = 0BPPP000
 225+ EAFD 0F               RRCA
 226+ EAFE 0F               RRCA
 227+ EAFF 0F               RRCA                        ; A = 0000BPPP = indice
 228+ EB00
 229+ EB00                  ; Elegir tabla segun tipo de sprite
 230+ EB00 5F               LD E, A
 231+ EB01 16 00            LD D, 0
 232+ EB03 3A 05 EA         LD A, (BgSpriteIsHouse)
 233+ EB06 B7               OR A
 234+ EB07 28 05            JR Z, .useStdTable
 235+ EB09 2A 03 EA         LD HL, (CurrentHouseRemapTable)
 236+ EB0C 18 03            JR .doLookup
 237+ EB0E              .useStdTable:
 238+ EB0E 2A 01 EA         LD HL, (CurrentRemapTable)
 239+ EB11              .doLookup:
 240+ EB11 19               ADD HL, DE
 241+ EB12 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 242+ EB13
 243+ EB13                  ; Reconstruir atributo
 244+ EB13 07               RLCA
 245+ EB14 07               RLCA
 246+ EB15 07               RLCA                        ; A = 0BPPP000
 247+ EB16 B0               OR B                        ; A = FBPPPIII
 248+ EB17
 249+ EB17 C1               POP BC
 250+ EB18 D1               POP DE
 251+ EB19 E1               POP HL
 252+ EB1A C9               RET
 253+ EB1B
 254+ EB1B              ; ==============================================================================
 255+ EB1B              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 256+ EB1B              ; ==============================================================================
 257+ EB1B              ; Entrada: DE = direccion datos del sprite
 258+ EB1B              ; Setea BgSpriteIsHouse (0 o 1)
 259+ EB1B              ; Preserva: DE, IX
 260+ EB1B              ; ==============================================================================
 261+ EB1B              CheckIfHouseSprite:
 262+ EB1B E5               PUSH HL
 263+ EB1C C5               PUSH BC
 264+ EB1D
 265+ EB1D AF               XOR A
 266+ EB1E 32 05 EA         LD (BgSpriteIsHouse), A     ; Default: no es house
 267+ EB21
 268+ EB21 21 3C CE         LD HL, HouseSpriteList
 269+ EB24              .checkLoop:
 270+ EB24 4E               LD C, (HL)
 271+ EB25 23               INC HL
 272+ EB26 46               LD B, (HL)
 273+ EB27 23               INC HL                      ; BC = direccion sprite house
 274+ EB28 78               LD A, B
 275+ EB29 B1               OR C
 276+ EB2A 28 0D            JR Z, .checkDone            ; Terminador: no encontrado
 277+ EB2C
 278+ EB2C 78               LD A, B
 279+ EB2D BA               CP D
 280+ EB2E 20 F4            JR NZ, .checkLoop
 281+ EB30 79               LD A, C
 282+ EB31 BB               CP E
 283+ EB32 20 F0            JR NZ, .checkLoop
 284+ EB34
 285+ EB34                  ; Encontrado: es house
 286+ EB34 3E 01            LD A, 1
 287+ EB36 32 05 EA         LD (BgSpriteIsHouse), A
 288+ EB39
 289+ EB39              .checkDone:
 290+ EB39 C1               POP BC
 291+ EB3A E1               POP HL
 292+ EB3B C9               RET
 293+ EB3C
 294+ EB3C              ; ==============================================================================
 295+ EB3C              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 296+ EB3C              ; ==============================================================================
 297+ EB3C              ; Formato: XX,YY:NN nombre_room     DY
 298+ EB3C              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 299+ EB3C              ; ==============================================================================
 300+ EB3C              DrawRoomInfo:
 301+ EB3C                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 302+ EB3C 1E 00            LD E, 0
 303+ EB3E 06 0D            LD B, 13
 304+ EB40              .clearLoop:
 305+ EB40 C5               PUSH BC
 306+ EB41 D5               PUSH DE
 307+ EB42 3E 20            LD A, ' '
 308+ EB44 CD 5B EC         CALL DrawHudChar
 309+ EB47 D1               POP DE
 310+ EB48 C1               POP BC
 311+ EB49 1C               INC E
 312+ EB4A 10 F4            DJNZ .clearLoop
 313+ EB4C
 314+ EB4C                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 315+ EB4C 3A AF 81         LD A, (CurrentScreenX)
 316+ EB4F 1E 00            LD E, 0
 317+ EB51 CD AF EB         CALL .drawDec2
 318+ EB54
 319+ EB54                  ; --- ',' en col 2 ---
 320+ EB54 3E 2C            LD A, ','
 321+ EB56 1E 02            LD E, 2
 322+ EB58 CD 5B EC         CALL DrawHudChar
 323+ EB5B
 324+ EB5B                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 325+ EB5B 3A B0 81         LD A, (CurrentScreenY)
 326+ EB5E 1E 03            LD E, 3
 327+ EB60 CD AF EB         CALL .drawDec2
 328+ EB63
 329+ EB63                  ; --- ':' en col 5 ---
 330+ EB63 3E 3A            LD A, ':'
 331+ EB65 1E 05            LD E, 5
 332+ EB67 CD 5B EC         CALL DrawHudChar
 333+ EB6A
 334+ EB6A                  ; --- Obtener room index de MapTable[Y*16+X] ---
 335+ EB6A 3A B0 81         LD A, (CurrentScreenY)
 336+ EB6D 6F               LD L, A
 337+ EB6E 26 00            LD H, 0
 338+ EB70 29               ADD HL, HL
 339+ EB71 29               ADD HL, HL
 340+ EB72 29               ADD HL, HL
 341+ EB73 29               ADD HL, HL                  ; HL = Y * 16
 342+ EB74 3A AF 81         LD A, (CurrentScreenX)
 343+ EB77 5F               LD E, A
 344+ EB78 16 00            LD D, 0
 345+ EB7A 19               ADD HL, DE                  ; HL = Y*16 + X
 346+ EB7B 11 2E B7         LD DE, MapTable
 347+ EB7E 19               ADD HL, DE
 348+ EB7F 7E               LD A, (HL)                  ; A = room index (0-47)
 349+ EB80 F5               PUSH AF                     ; guardar room index
 350+ EB81
 351+ EB81                  ; --- Room index como 2 hex en cols 6-7 ---
 352+ EB81 F5               PUSH AF
 353+ EB82 0F               RRCA
 354+ EB83 0F               RRCA
 355+ EB84 0F               RRCA
 356+ EB85 0F               RRCA
 357+ EB86 E6 0F            AND $0F
 358+ EB88 CD CD EB         CALL .hexToAscii
 359+ EB8B 1E 06            LD E, 6
 360+ EB8D CD 5B EC         CALL DrawHudChar
 361+ EB90 F1               POP AF
 362+ EB91 E6 0F            AND $0F
 363+ EB93 CD CD EB         CALL .hexToAscii
 364+ EB96 1E 07            LD E, 7
 365+ EB98 CD 5B EC         CALL DrawHudChar
 366+ EB9B
 367+ EB9B                  ; --- Espacio en col 8 ---
 368+ EB9B 3E 20            LD A, ' '
 369+ EB9D 1E 08            LD E, 8
 370+ EB9F CD 5B EC         CALL DrawHudChar
 371+ EBA2
 372+ EBA2                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 373+ EBA2 F1               POP AF                      ; A = room index (descartar)
 374+ EBA3
 375+ EBA3                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 376+ EBA3 21 20 58         LD HL, ATTR_BASE + 1 * 32
 377+ EBA6 3E 47            LD A, $47                   ; bright white on black
 378+ EBA8 06 0D            LD B, 13
 379+ EBAA              .attrLoop:
 380+ EBAA 77               LD (HL), A
 381+ EBAB 23               INC HL
 382+ EBAC 10 FC            DJNZ .attrLoop
 383+ EBAE C9               RET
 384+ EBAF
 385+ EBAF              ; --- Helpers ---
 386+ EBAF              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 387+ EBAF              .drawDec2:
 388+ EBAF 4B               LD C, E                     ; guardar columna inicial
 389+ EBB0 06 00            LD B, 0                     ; decenas
 390+ EBB2              .divLoop:
 391+ EBB2 FE 0A            CP 10
 392+ EBB4 38 05            JR C, .divDone
 393+ EBB6 D6 0A            SUB 10
 394+ EBB8 04               INC B
 395+ EBB9 18 F7            JR .divLoop
 396+ EBBB              .divDone:
 397+ EBBB                  ; B = decenas, A = unidades
 398+ EBBB F5               PUSH AF                     ; guardar unidades
 399+ EBBC 78               LD A, B
 400+ EBBD C6 30            ADD A, '0'
 401+ EBBF 59               LD E, C
 402+ EBC0 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 403+ EBC1 CD 5B EC         CALL DrawHudChar
 404+ EBC4 C1               POP BC                      ; restaurar C
 405+ EBC5 F1               POP AF
 406+ EBC6 C6 30            ADD A, '0'
 407+ EBC8 59               LD E, C
 408+ EBC9 1C               INC E
 409+ EBCA C3 5B EC         JP DrawHudChar              ; tail call
 410+ EBCD
 411+ EBCD              .hexToAscii:
 412+ EBCD FE 0A            CP 10
 413+ EBCF 38 03            JR C, .isDigit
 414+ EBD1 C6 37            ADD A, 'A' - 10
 415+ EBD3 C9               RET
 416+ EBD4              .isDigit:
 417+ EBD4 C6 30            ADD A, '0'
 418+ EBD6 C9               RET
 419+ EBD7
 420+ EBD7              ; ==============================================================================
 421+ EBD7              ; DrawDayCycleHUD - Muestra numero de dia en HUD (fila 1, col 28-29)
 422+ EBD7              ; ==============================================================================
 423+ EBD7              DrawDayCycleHUD:
 424+ EBD7                  ; "D" en columna 28
 425+ EBD7 3E 44            LD A, 'D'
 426+ EBD9 1E 1C            LD E, 28
 427+ EBDB CD 5B EC         CALL DrawHudChar
 428+ EBDE                  ; Numero del ciclo en columna 29 (1-9, luego letras)
 429+ EBDE 3A C9 A2         LD A, (DayCycleCount)
 430+ EBE1 FE 0A            CP 10
 431+ EBE3 38 02            JR C, .dchDigit
 432+ EBE5 3E 09            LD A, 9                             ; Cap visual en 9
 433+ EBE7              .dchDigit:
 434+ EBE7 C6 30            ADD A, '0'                          ; Convertir a ASCII
 435+ EBE9 1E 1D            LD E, 29
 436+ EBEB CD 5B EC         CALL DrawHudChar
 437+ EBEE                  ; Atributos (bright white)
 438+ EBEE 3E 47            LD A, $47
 439+ EBF0 32 3C 58         LD (ATTR_BASE + 1 * 32 + 28), A
 440+ EBF3 32 3D 58         LD (ATTR_BASE + 1 * 32 + 29), A
 441+ EBF6 C9               RET
 442+ EBF7
 443+ EBF7              ; ==============================================================================
 444+ EBF7              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 445+ EBF7              ; ==============================================================================
 446+ EBF7              DrawPlayerSpeedHUD:
 447+ EBF7 3A A3 87         LD A, (PlayerCurrentSpeed)
 448+ EBFA C6 30            ADD A, '0'
 449+ EBFC 1E 02            LD E, 2
 450+ EBFE CD 21 EC         CALL DrawHudCharRow0
 451+ EC01                  ; Atributo (bright white)
 452+ EC01 3E 47            LD A, $47
 453+ EC03 32 02 58         LD (ATTR_BASE + 2), A
 454+ EC06 C9               RET
 455+ EC07
 456+ EC07              ; ==============================================================================
 457+ EC07              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 458+ EC07              ; ==============================================================================
 459+ EC07              DrawEnemySpeedHUD:
 460+ EC07                  ; "V" en columna 30
 461+ EC07 3E 56            LD A, 'V'
 462+ EC09 1E 1E            LD E, 30
 463+ EC0B CD 21 EC         CALL DrawHudCharRow0
 464+ EC0E                  ; Numero de velocidad en columna 31
 465+ EC0E 3A 77 87         LD A, (CurrentEnemySpeed)
 466+ EC11 C6 30            ADD A, '0'
 467+ EC13 1E 1F            LD E, 31
 468+ EC15 CD 21 EC         CALL DrawHudCharRow0
 469+ EC18                  ; Atributos (bright white)
 470+ EC18 3E 47            LD A, $47
 471+ EC1A 32 1E 58         LD (ATTR_BASE + 30), A
 472+ EC1D 32 1F 58         LD (ATTR_BASE + 31), A
 473+ EC20 C9               RET
 474+ EC21
 475+ EC21              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 476+ EC21              ; A = codigo ASCII, E = columna (0-31)
 477+ EC21              DrawHudCharRow0:
 478+ EC21 6F               LD L, A
 479+ EC22 26 00            LD H, 0
 480+ EC24 29               ADD HL, HL
 481+ EC25 29               ADD HL, HL
 482+ EC26 29               ADD HL, HL
 483+ EC27 01 00 3C         LD BC, $3C00
 484+ EC2A 09               ADD HL, BC                  ; HL = font data
 485+ EC2B 16 40            LD D, $40                   ; Tercio 0, scan line 0
 486+ EC2D 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 487+ EC2E 5F               LD E, A                     ; DE = dir VRAM
 488+ EC2F 06 08            LD B, 8
 489+ EC31              .row0Char:
 490+ EC31 7E               LD A, (HL)
 491+ EC32 12               LD (DE), A
 492+ EC33 23               INC HL
 493+ EC34 14               INC D                       ; siguiente scan line
 494+ EC35 10 FA            DJNZ .row0Char
 495+ EC37 C9               RET
 496+ EC38
 497+ EC38              ; ==============================================================================
 498+ EC38              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 499+ EC38              ; ==============================================================================
 500+ EC38              DrawTimeIndicator:
 501+ EC38                  ; Calcular puntero al label de 2 chars
 502+ EC38 3A 00 EA         LD A, (CurrentTimeOfDay)
 503+ EC3B 87               ADD A, A                    ; A = momento * 2
 504+ EC3C 5F               LD E, A
 505+ EC3D 16 00            LD D, 0
 506+ EC3F 21 3F ED         LD HL, TimeLabels
 507+ EC42 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 508+ EC43
 509+ EC43                  ; Primer caracter en columna 30
 510+ EC43 7E               LD A, (HL)
 511+ EC44 E5               PUSH HL
 512+ EC45 1E 1E            LD E, 30
 513+ EC47 CD 5B EC         CALL DrawHudChar
 514+ EC4A E1               POP HL
 515+ EC4B
 516+ EC4B                  ; Segundo caracter en columna 31
 517+ EC4B 23               INC HL
 518+ EC4C 7E               LD A, (HL)
 519+ EC4D 1E 1F            LD E, 31
 520+ EC4F CD 5B EC         CALL DrawHudChar
 521+ EC52
 522+ EC52                  ; Atributos del indicador (bright white on black)
 523+ EC52 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 524+ EC55 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 525+ EC57 77               LD (HL), A
 526+ EC58 23               INC HL
 527+ EC59 77               LD (HL), A
 528+ EC5A C9               RET
 529+ EC5B
 530+ EC5B              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 531+ EC5B              ; A = codigo ASCII, E = columna (0-31)
 532+ EC5B              DrawHudChar:
 533+ EC5B                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 534+ EC5B 6F               LD L, A
 535+ EC5C 26 00            LD H, 0
 536+ EC5E 29               ADD HL, HL
 537+ EC5F 29               ADD HL, HL
 538+ EC60 29               ADD HL, HL
 539+ EC61 01 00 3C         LD BC, $3C00
 540+ EC64 09               ADD HL, BC                  ; HL = font data
 541+ EC65
 542+ EC65                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 543+ EC65 16 40            LD D, $40                   ; Tercio 0, scan line 0
 544+ EC67 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 545+ EC69 83               ADD A, E
 546+ EC6A 5F               LD E, A                     ; DE = dir VRAM
 547+ EC6B
 548+ EC6B 06 08            LD B, 8
 549+ EC6D              .hudCharLoop:
 550+ EC6D 7E               LD A, (HL)
 551+ EC6E 12               LD (DE), A
 552+ EC6F 23               INC HL
 553+ EC70 14               INC D                       ; Siguiente scan line
 554+ EC71 10 FA            DJNZ .hudCharLoop
 555+ EC73 C9               RET
