 158+ 9D65                  ; ==================================================================
 159+ 9D65                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9D65                  ; ==================================================================
 161+ 9D65                  ; A = shift amount (1-7) al llegar aqui
 162+ 9D65              .shifted:
 163+ 9D65                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9D65 3D               DEC A                       ; 0-6
 165+ 9D66 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9D67 E6 0E            AND $0E
 167+ 9D69 C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9D6B 32 AA 9D         LD (.tablePage), A
 169+ 9D6E
 170+ 9D6E                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9D6E DD E5            PUSH IX
 172+ 9D70 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9D71 D5               PUSH DE                     ; Guardar sprite data ptr en stack
