5389+ BC8B              NUM_NASTY_TYPES EQU 4
5390+ BC8B              DiurnalTypeTable:                       ; DY, C1, A2
5391+ BC8B 30               DEFB SPRID_ENEMY_4          ; Eagle
5392+ BC8C 20               DEFB SPRID_ENEMY_0          ; Spider
5393+ BC8D 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5394+ BC8E 2C               DEFB SPRID_ENEMY_3          ; Snake
5395+ BC8F              CrepuscularTypeTable:                   ; C2, N1
5396+ BC8F 34               DEFB SPRID_ENEMY_5          ; Rat
5397+ BC90 28               DEFB SPRID_ENEMY_2          ; Bat
5398+ BC91 24               DEFB SPRID_ENEMY_1          ; Scorpion
5399+ BC92 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5400+ BC93
5401+ BC93              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5402+ BC93              NastyColorTable:
5403+ BC93 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5404+ BC94 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5405+ BC95 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5406+ BC96 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5407+ BC97 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5408+ BC98 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5409+ BC99 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5410+ BC9A 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5411+ BC9B
5412+ BC9B              ; --- Tabla de comportamiento depredador ---
5413+ BC9B              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5414+ BC9B              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5415+ BC9B              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5416+ BC9B              PredatorTable:
5417+ BC9B 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5418+ BC9C 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5419+ BC9D 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5420+ BC9E 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5421+ BC9F 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5422+ BCA0 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5423+ BCA1 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5424+ BCA2 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
