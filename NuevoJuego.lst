6806+ C85D DD BE 04         CP (IX+ENT_POSY)
6807+ C860 20 11            JR NZ, .udMoved
6808+ C862                  ; No movio: incrementar BFS counter
6809+ C862 3A A3 82         LD A, (DeathStuckCounter)
6810+ C865 3C               INC A
6811+ C866 32 A3 82         LD (DeathStuckCounter), A
6812+ C869 FE 06            CP DEATH_STUCK_THRESHOLD
6813+ C86B D8               RET C
6814+ C86C AF               XOR A
6815+ C86D 32 A3 82         LD (DeathStuckCounter), A
6816+ C870 C3 38 CA         JP DeathBfsRescue
6817+ C873              .udMoved:
6818+ C873 AF               XOR A
6819+ C874 32 A3 82         LD (DeathStuckCounter), A
6820+ C877 C9               RET
