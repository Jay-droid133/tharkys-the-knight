   5+ 77D2              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 77D2              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 77D2              ;
   8+ 77D2              ; Estrategia:
   9+ 77D2              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 77D2              ;      bank 0 paginado en slot 3.
  11+ 77D2              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 77D2              ;      seguro hacer la conmutación aquí).
  13+ 77D2              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 77D2              ;   4. Body retorna → restauramos bank 0.
  15+ 77D2              ;
  16+ 77D2              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 77D2              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 77D2              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 77D2              ; ==============================================================================
  20+ 77D2
  21+ 77D2              DrawTombstone2xCentered:
  22+ 77D2                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 77D2 21 72 D9         LD HL, BgGfx_little_house_cemetery
  24+ 77D5 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 77D7 CD BC 6A         CALL LoadBgSpriteToBuffer
  26+ 77DA
  27+ 77DA                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 77DA F3               DI
  29+ 77DB 3A 82 90         LD A, (CurrentPaging)
  30+ 77DE E6 F8            AND $F8
  31+ 77E0 F6 07            OR 7
  32+ 77E2 32 82 90         LD (CurrentPaging), A
  33+ 77E5 01 FD 7F         LD BC, $7FFD
  34+ 77E8 ED 79            OUT (C), A
  35+ 77EA
  36+ 77EA                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 77EA CD F7 D9         CALL DrawTombstone2xBody
  38+ 77ED
  39+ 77ED                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 77ED 3A 82 90         LD A, (CurrentPaging)
  41+ 77F0 E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 77F2 32 82 90         LD (CurrentPaging), A
  43+ 77F5 01 FD 7F         LD BC, $7FFD
  44+ 77F8 ED 79            OUT (C), A
  45+ 77FA
  46+ 77FA                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 77FA 3A 9A 81         LD A, (StartupComplete)
  48+ 77FD B7               OR A
  49+ 77FE C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 77FF FB               EI
  51+ 7800 C9               RET
