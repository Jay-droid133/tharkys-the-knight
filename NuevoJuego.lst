 383+ 702A                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 384+ 702A 3A AB 5F         LD A, (RandomSlotCount)
 385+ 702D B7               OR A
 386+ 702E CA 56 71         JP Z, .urpZeroAndRotate
 387+ 7031
 388+ 7031                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 389+ 7031                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 390+ 7031                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 391+ 7031 3A 0C 83         LD A, (CurrentScreenY)
 392+ 7034 07               RLCA
 392+ 7035 07             RLCA
 392+ 7036 07             RLCA
 392+ 7037 07             RLCA           ; Y*16
 393+ 7038 21 0B 83         LD HL, CurrentScreenX
 394+ 703B 86               ADD A, (HL)                         ; A = newSid
 395+ 703C 47               LD B, A                             ; B = newSid (preservar)
 396+ 703D 3A D0 5F         LD A, (RP_PrevSid)
 397+ 7040 B8               CP B
 398+ 7041 20 1A            JR NZ, .urpCacheMiss
 399+ 7043                  ; HIT prev. Validar slot < count.
