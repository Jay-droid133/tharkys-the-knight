 153+ E58D              ; ==============================================================================
 154+ E58D              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 155+ E58D              ; ==============================================================================
 156+ E58D              CheckDebugKeys:
 157+ E58D 3E FB            LD A, $FB
 158+ E58F DB FE            IN A, ($FE)
 159+ E591 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 160+ E593 20 1C            JR NZ, .notPressed
 161+ E595
 162+ E595                  ; Tecla pulsada: comprobar debounce
 163+ E595 3A 05 E5         LD A, (DebugKeyDebounce)
 164+ E598 B7               OR A
 165+ E599 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 166+ E59A
 167+ E59A                  ; Primera pulsacion: ciclar
 168+ E59A 3E 01            LD A, 1
 169+ E59C 32 05 E5         LD (DebugKeyDebounce), A
 170+ E59F
 171+ E59F 3A FE E4         LD A, (CurrentTimeOfDay)
 172+ E5A2 3C               INC A
 173+ E5A3 FE 07            CP NUM_TIME_MOMENTS
 174+ E5A5 38 01            JR C, .noWrap
 175+ E5A7 AF               XOR A                   ; Volver a 0 (Dia)
 176+ E5A8              .noWrap:
 177+ E5A8 F5               PUSH AF
 178+ E5A9 CD 06 E5         CALL SetTimeOfDay
 179+ E5AC F1               POP AF
 180+ E5AD CD 47 ED         CALL SetClockToPhaseHour
 181+ E5B0 C9               RET
 182+ E5B1
 183+ E5B1              .notPressed:
 184+ E5B1 AF               XOR A
 185+ E5B2 32 05 E5         LD (DebugKeyDebounce), A
 186+ E5B5
 187+ E5B5                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 188+ E5B5 3E FD            LD A, $FD
 189+ E5B7 DB FE            IN A, ($FE)
 190+ E5B9 4F               LD C, A                 ; C = estado semi-fila $FDFE
 191+ E5BA CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 192+ E5BC 20 13            JR NZ, .sNotPressed
 193+ E5BE 3A 0C E6         LD A, (SpeedKeyDebounce)
 194+ E5C1 B7               OR A
 195+ E5C2 C0               RET NZ
 196+ E5C3 3E 01            LD A, 1
 197+ E5C5 32 0C E6         LD (SpeedKeyDebounce), A
 198+ E5C8 21 07 C0         LD HL, DayCycleCount
 199+ E5CB 7E               LD A, (HL)
 200+ E5CC FE 0A            CP 10
 201+ E5CE D0               RET NC                  ; Ya en maximo
 202+ E5CF 34               INC (HL)
 203+ E5D0 C9               RET
 204+ E5D1              .sNotPressed:
 205+ E5D1                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 206+ E5D1 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 207+ E5D3 20 13            JR NZ, .dNotPressed
 208+ E5D5 3A 0C E6         LD A, (SpeedKeyDebounce)
 209+ E5D8 B7               OR A
 210+ E5D9 C0               RET NZ
 211+ E5DA 3E 01            LD A, 1
 212+ E5DC 32 0C E6         LD (SpeedKeyDebounce), A
 213+ E5DF 21 07 C0         LD HL, DayCycleCount
 214+ E5E2 7E               LD A, (HL)
 215+ E5E3 FE 01            CP 1
 216+ E5E5 C8               RET Z                   ; Ya en minimo
 217+ E5E6 35               DEC (HL)
 218+ E5E7 C9               RET
 219+ E5E8              .dNotPressed:
 220+ E5E8 AF               XOR A
 221+ E5E9 32 0C E6         LD (SpeedKeyDebounce), A
 222+ E5EC
 223+ E5EC                  ; --- Tecla N: togglea NoclipMode (debug) ---
 224+ E5EC 3E 7F            LD A, $7F
 225+ E5EE DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 226+ E5F0 CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 227+ E5F2 20 13            JR NZ, .nNotPressed
 228+ E5F4 3A 0D E6         LD A, (NoclipKeyDebounce)
 229+ E5F7 B7               OR A
 230+ E5F8 C0               RET NZ
 231+ E5F9 3E 01            LD A, 1
 232+ E5FB 32 0D E6         LD (NoclipKeyDebounce), A
 233+ E5FE 3A 5D 82         LD A, (NoclipMode)
 234+ E601 EE 01            XOR 1
 235+ E603 32 5D 82         LD (NoclipMode), A
 236+ E606 C9               RET
 237+ E607              .nNotPressed:
 238+ E607 AF               XOR A
 239+ E608 32 0D E6         LD (NoclipKeyDebounce), A
 240+ E60B C9               RET
