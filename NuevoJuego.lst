3671+ A0CD              ; CountActiveNasties / CountActiveMonsters
3672+ A0CD              ; ==============================================================================
3673+ A0CD              ; Cuentan enemigos vivos por tipo (excluyen DYING y SPAWNING).
3674+ A0CD              ; Ambas usan _CountSlots internamente.
3675+ A0CD              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
3676+ A0CD              ; ==============================================================================
3677+ A0CD              CountActiveNasties:
3678+ A0CD 21 F6 80         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
3679+ A0D0 06 03            LD B, NUM_NASTIES
3680+ A0D2 18 05            JR _CountSlots
3681+ A0D4
3682+ A0D4              CountActiveMonsters:
3683+ A0D4 21 96 80         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
3684+ A0D7 06 06            LD B, NUM_MONSTERS
3685+ A0D9
3686+ A0D9              _CountSlots:
3687+ A0D9 0E 00            LD C, 0                         ; Contador
3688+ A0DB              .countLoop:
3689+ A0DB 7E               LD A, (HL)
3690+ A0DC B7               OR A
3691+ A0DD 28 12            JR Z, .countNext                ; Slot vacio: no contar
3692+ A0DF                  ; Comprobar estado: excluir DYING y SPAWNING
3693+ A0DF D5               PUSH DE
3694+ A0E0 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
3695+ A0E3 19               ADD HL, DE
3696+ A0E4 7E               LD A, (HL)
3697+ A0E5 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
3698+ A0E7 D1               POP DE
3699+ A0E8 FE 03            CP STATE_DYING
3700+ A0EA 28 05            JR Z, .countNext
3701+ A0EC FE 04            CP STATE_SPAWNING
3702+ A0EE 28 01            JR Z, .countNext
3703+ A0F0 0C               INC C
3704+ A0F1              .countNext:
3705+ A0F1 11 10 00         LD DE, ENT_SIZE
3706+ A0F4 19               ADD HL, DE
3707+ A0F5 10 E4            DJNZ .countLoop
3708+ A0F7 79               LD A, C
3709+ A0F8 C9               RET
