 757+ EFBA                  ; --- Calcular scanLine (0-15) ---
 758+ EFBA 78               LD A, B
 759+ EFBB E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EFBD CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EFBF 28 02            JR Z, .pxIsTop
 762+ EFC1 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EFC3              .pxIsTop:
 764+ EFC3                  ; A = scanLine (0-15)
 765+ EFC3
 766+ EFC3                  ; --- Calcular colOffset (0 o 1) ---
 767+ EFC3 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EFC4 79               LD A, C
 769+ EFC5 E6 1F            AND $1F                     ; extraer columna
 770+ EFC7 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EFC9 4F               LD C, A                     ; C = colOffset
