 468  F923                  INCLUDE "sound.asm"
# file opened: code/sound.asm
   1+ F923              ; ==============================================================================
   2+ F923              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F923              ; ==============================================================================
   4+ F923              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F923              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F923              ;
   7+ F923              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F923              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F923              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F923              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F923              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F923              ; ==============================================================================
  13+ F923
  14+ F923              ; ==============================================================================
  15+ F923              ; PlaySFX - Reproduce un efecto de sonido
  16+ F923              ; ==============================================================================
  17+ F923              ; Entrada: HL = puntero a datos del efecto
  18+ F923              ; Modifica: AF, BC, DE, HL
  19+ F923              ; ==============================================================================
  20+ F923              PlaySFX:
  21+ F923 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F924 3A 83 90         LD A, (CurrentBorderColor)
  23+ F927 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F929 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F92A
  26+ F92A              .nextStep:
  27+ F92A 7E               LD A, (HL)                  ; Leer duration
  28+ F92B B7               OR A
  29+ F92C 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F92E
  31+ F92E 47               LD B, A                     ; B = duration (bucle externo)
  32+ F92F 23               INC HL
  33+ F930 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F931 23               INC HL
  35+ F932 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F933 23               INC HL
  37+ F934 7E               LD A, (HL)                  ; A = flags
  38+ F935 23               INC HL
  39+ F936 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F937 CB 47            BIT 0, A
  41+ F939 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F93B
  43+ F93B              ; --- Bucle de tono normal ---
  44+ F93B              .toneLoop:
  45+ F93B                  ; Semi-periodo HIGH
  46+ F93B 7B               LD A, E
  47+ F93C F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F93E D3 FE            OUT ($FE), A
  49+ F940 79               LD A, C                     ; A = pitch actual
  50+ F941              .toneDelayHi:
  51+ F941 3D               DEC A
  52+ F942 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F944
  54+ F944                  ; Semi-periodo LOW
  55+ F944 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F945 D3 FE            OUT ($FE), A
  57+ F947 79               LD A, C
  58+ F948              .toneDelayLo:
  59+ F948 3D               DEC A
  60+ F949 20 FD            JR NZ, .toneDelayLo
  61+ F94B
  62+ F94B                  ; Aplicar pitch sweep
  63+ F94B 79               LD A, C
  64+ F94C 82               ADD A, D                    ; pitch += pitchDelta
  65+ F94D 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F94F FA 57 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F952 4F               LD C, A
  68+ F953              .toneAfterClamp:
  69+ F953 10 E6            DJNZ .toneLoop
  70+ F955 18 30            JR .stepDone
  71+ F957
  72+ F957              .toneClamp:
  73+ F957 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F959 18 F8            JR .toneAfterClamp
  75+ F95B
  76+ F95B              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F95B              .noiseLoop:
  78+ F95B                  ; Semi-periodo HIGH con ruido
  79+ F95B 7B               LD A, E
  80+ F95C F6 10            OR $10
  81+ F95E D3 FE            OUT ($FE), A
  82+ F960 ED 5F            LD A, R                     ; R register como PRNG
  83+ F962 A9               XOR C                       ; mezclar con pitch base
  84+ F963 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F965 F6 01            OR $01                      ; minimo 1
  86+ F967              .noiseDelayHi:
  87+ F967 3D               DEC A
  88+ F968 20 FD            JR NZ, .noiseDelayHi
  89+ F96A
  90+ F96A                  ; Semi-periodo LOW
  91+ F96A 7B               LD A, E
  92+ F96B D3 FE            OUT ($FE), A
  93+ F96D ED 5F            LD A, R
  94+ F96F A9               XOR C
  95+ F970 E6 1F            AND $1F
  96+ F972 F6 01            OR $01
  97+ F974              .noiseDelayLo:
  98+ F974 3D               DEC A
  99+ F975 20 FD            JR NZ, .noiseDelayLo
 100+ F977
 101+ F977                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F977 79               LD A, C
 103+ F978 82               ADD A, D
 104+ F979 28 08            JR Z, .noiseClamp
 105+ F97B FA 83 F9         JP M, .noiseClamp
