 173+ AF44 0E 10            LD C, SCREEN_MIN_Y
 174+ AF46 CD 67 B4         CALL IsPointBlocked
 175+ AF49 C2 60 AF         JP NZ, .noNorth
 176+ AF4C 3A C9 81         LD A, (CurrentScreenY)
 177+ AF4F 3D               DEC A
 178+ AF50 32 C9 81         LD (CurrentScreenY), A
 179+ AF53 3E 01            LD A, DIR_N
 180+ AF55 32 CC 81         LD (ScreenTransition), A
 181+ AF58 3E AB            LD A, SCREEN_MAX_Y
 182+ AF5A 32 A2 80         LD (EntityTable + ENT_POSY), A
 183+ AF5D C3 B1 AF         JP .doTransition
