 420+ 65C0 54               LD D, H
 421+ 65C1 5D               LD E, L
 422+ 65C2 29               ADD HL, HL                              ; *2
 423+ 65C3 19               ADD HL, DE                              ; *3
 424+ 65C4 11 86 E0         LD DE, BgGfxPtrById
 425+ 65C7 19               ADD HL, DE
 426+ 65C8 5E               LD E, (HL)
 427+ 65C9 23               INC HL
 428+ 65CA 56               LD D, (HL)                              ; DE = ptr
 429+ 65CB 23               INC HL
