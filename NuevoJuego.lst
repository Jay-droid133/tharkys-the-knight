 253+ 8DC7              ; LoadPlazaClockPixels - Copia los 32 B de pixel data del reloj de plaza a RAM fija
 254+ 8DC7              ; ==============================================================================
 255+ 8DC7              ; Se llama una vez al cargar pantalla cuando se detecta BgGfx_reloj_plaza.
 256+ 8DC7              ; DrawPlazaClock lee PlazaClockPixels cada frame sin tocar paginacion.
 257+ 8DC7              ; ==============================================================================
 258+ 8DC7              LoadPlazaClockPixels:
 259+ 8DC7 C5               PUSH BC
 260+ 8DC8 ED 57            LD A, I
 261+ 8DCA F5               PUSH AF
 262+ 8DCB F3               DI
 263+ 8DCC                  ; Page bank 3 inline
 264+ 8DCC 3A DC 8C         LD A, (CurrentPaging)
 265+ 8DCF E6 F8            AND $F8
 266+ 8DD1 F6 03            OR 3
 267+ 8DD3 32 DC 8C         LD (CurrentPaging), A
 268+ 8DD6 01 FD 7F         LD BC, $7FFD
 269+ 8DD9 ED 79            OUT (C), A
 270+ 8DDB                  ; Copia 32 bytes (16 rows * 2 bytes) desde BgGfx_reloj_plaza+2
 271+ 8DDB 21 81 CD         LD HL, BgGfx_reloj_plaza + 2
 272+ 8DDE 11 93 89         LD DE, PlazaClockPixels
 273+ 8DE1 01 20 00         LD BC, 32
 274+ 8DE4 ED B0            LDIR
 275+ 8DE6                  ; Page bank 0 inline
 276+ 8DE6 3A DC 8C         LD A, (CurrentPaging)
 277+ 8DE9 E6 F8            AND $F8
 278+ 8DEB 32 DC 8C         LD (CurrentPaging), A
 279+ 8DEE 01 FD 7F         LD BC, $7FFD
 280+ 8DF1 ED 79            OUT (C), A
 281+ 8DF3 F1               POP AF
 282+ 8DF4 E2 F8 8D         JP PO, .lpcpNoEI
 283+ 8DF7 FB               EI
 284+ 8DF8              .lpcpNoEI:
 285+ 8DF8 C1               POP BC
 286+ 8DF9 C9               RET
