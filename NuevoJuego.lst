1101+ 6601 21 55 66         LD HL, TownGateCreditsData
1102+ 6604              .tgdcLoop:
1103+ 6604 7E               LD A, (HL)
1104+ 6605 FE FF            CP $FF
1105+ 6607 C8               RET Z
1106+ 6608 57               LD D, A                             ; D = row
1107+ 6609 23               INC HL
1108+ 660A 7E               LD A, (HL)
1109+ 660B 5F               LD E, A                             ; E = col
1110+ 660C 23               INC HL                              ; HL → string
1111+ 660D CD 12 66         CALL PrintStringFontAt
1112+ 6610 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1113+ 6612
1114+ 6612              ; ==============================================================================
1115+ 6612              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1116+ 6612              ; ==============================================================================
1117+ 6612              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1118+ 6612              ; siguiente byte tras el 0 (para que el caller siga iterando).
1119+ 6612              ; Destruye: AF, BC, DE, HL.
1120+ 6612              ; OUT: HL apunta al byte tras el 0 terminador.
1121+ 6612              ; ==============================================================================
1122+ 6612              PrintStringFontAt:
1123+ 6612              .psfaCharLoop:
1124+ 6612 7E               LD A, (HL)
1125+ 6613 23               INC HL
1126+ 6614 B7               OR A
1127+ 6615 C8               RET Z                               ; fin de string
1128+ 6616 E5               PUSH HL
1129+ 6617 D5               PUSH DE
1130+ 6618 CD 20 66         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1131+ 661B D1               POP DE
1132+ 661C E1               POP HL
1133+ 661D 1C               INC E                               ; siguiente columna
1134+ 661E 18 F2            JR .psfaCharLoop
1135+ 6620
1136+ 6620              ; ==============================================================================
1137+ 6620              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1138+ 6620              ; ==============================================================================
1139+ 6620              ; D = row (0..23), E = col (0..31), A = ASCII char.
1140+ 6620              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1141+ 6620              ;   y = row * 8, x = col * 8
1142+ 6620              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1143+ 6620              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1144+ 6620              ; Destruye: AF, BC, DE, HL.
1145+ 6620              ; ==============================================================================
1146+ 6620              DrawCharFontAt:
1147+ 6620 D5               PUSH DE
1148+ 6621                  ; HL = $3C00 + char * 8
1149+ 6621 6F               LD L, A
1150+ 6622 26 00            LD H, 0
1151+ 6624 29               ADD HL, HL
1152+ 6625 29               ADD HL, HL
1153+ 6626 29               ADD HL, HL
1154+ 6627 01 00 3C         LD BC, $3C00
1155+ 662A 09               ADD HL, BC
1156+ 662B D1               POP DE
1157+ 662C                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1158+ 662C E5               PUSH HL                             ; save font ptr
1159+ 662D 7A               LD A, D
1160+ 662E 87               ADD A, A
1161+ 662F 87               ADD A, A
1162+ 6630 87               ADD A, A                            ; A = row * 8 = pixel Y
1163+ 6631 57               LD D, A
1164+ 6632 7B               LD A, E
1165+ 6633 87               ADD A, A
1166+ 6634 87               ADD A, A
1167+ 6635 87               ADD A, A                            ; A = col * 8 = pixel X
1168+ 6636 5F               LD E, A
1169+ 6637 CD A6 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
1170+ 663A EB               EX DE, HL                           ; DE = VRAM addr
1171+ 663B E1               POP HL                              ; HL = font ptr
1172+ 663C 06 08            LD B, 8
1173+ 663E              .dcfaLoop:
1174+ 663E 7E               LD A, (HL)
1175+ 663F 12               LD (DE), A
1176+ 6640 23               INC HL
1177+ 6641 14               INC D                               ; siguiente scan line (within char)
1178+ 6642 10 FA            DJNZ .dcfaLoop
1179+ 6644 C9               RET
1180+ 6645
