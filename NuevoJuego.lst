 214  7FCF
 215  7FCF                  ; ==========================================================================
 216  7FCF                  ; ORG $8000 - codigo principal (no-contended)
 217  7FCF                  ; ==========================================================================
 218  7FCF                  ORG ORIGIN_ADDRESS
 219  8000
 220  8000              ; ==============================================================================
 221  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 222  8000              ; ==============================================================================
 223  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 224  8000              ;   erase viejo → AI/movimiento → draw nuevo
 225  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 226  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 227  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 228  8000              ; ==============================================================================
 229  8000              MainLoop:
 230  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 231  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 232  8003 47               LD B, A                     ; B = tick actual
 233  8004
 234  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 235  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 236  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 237  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 238  8004 78               LD A, B
 239  8005 21 9F 81         LD HL, .frameStart
 240  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 241  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 242  800A 21 EA 99         LD HL, TickRemainder
 243  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 244  800E 4F               LD C, A
 245  800F E6 01            AND $01
 246  8011 77               LD (HL), A                  ; new remainder = total mod 2
 247  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 248  8014 79               LD A, C
 249  8015 32 E9 99         LD (FramesElapsed), A
 250  8018
 251  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 252  8018 CD D0 CB         CALL UpdateDeathBorder
 253  801B CD A1 CB         CALL UpdateDeathAnim
 254  801E                  ; Music tick: ahora vive en MusicIrqHandler (slot 1, cada 2 IRQs = 25 Hz).
 255  801E                  ; Auditoria de concurrencia AY confirmada: todos los AY writes desde
 256  801E                  ; MainLoop estan envueltos en DI/EI (ay_sound_thunks + sfx_player_hit_ay).
 257  801E                  ; UpdateMusicImpl sigue vivo como catchup-fallback no llamado por defecto.
 258  801E
 259  801E                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 260  801E 3A E7 82         LD A, (GameOver)
 261  8021 B7               OR A
 262  8022 28 23            JR Z, .notGameOver
 263  8024 FE 02            CP 2
 264  8026 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 265  8028                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 266  8028 CD 2B CC         CALL PaintGameOverScreen
 267  802B 3E 02            LD A, 2
 268  802D 32 E7 82         LD (GameOver), A
 269  8030 C3 8F 81         JP .frameSync
 270  8033              .gameOverWaitInput:
 271  8033 CD 67 CC         CALL UpdateGameOverAnim     ; Death moonwalkea por la pantalla negra
 272  8036 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 273  8039 ED 78            IN A, (C)
 274  803B CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 275  803D C2 8F 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 276  8040                  ; SPACE pulsado: reset total -> JP Inicio
 277  8040 F3               DI
 278  8041 31 58 FF         LD SP, SP_ADDRESS
 279  8044 C3 00 60         JP Inicio
