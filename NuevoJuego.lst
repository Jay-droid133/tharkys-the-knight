 348+ 73ED              .pmcaDirToOffset:
 349+ 73ED 01               DEFB $01                             ; 0 (N) → col 2 row 1 → +1
 350+ 73EE 20               DEFB $20                             ; 1 (S) → col 1 row 2 → +$20
 351+ 73EF 00               DEFB $00                             ; 2 (W) → col 1 row 1 → +0
 352+ 73F0 21               DEFB $21                             ; 3 (E) → col 2 row 2 → +$21
