 353+ DF19              ; ==============================================================================
 354+ DF19              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 355+ DF19              ; ==============================================================================
 356+ DF19              ; Entrada: A = sprite ID
 357+ DF19              ; Setea BgSpriteIsHouse (0 o 1)
 358+ DF19              ; Preserva: A, DE, IX
 359+ DF19              ;
 360+ DF19              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 361+ DF19              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 362+ DF19              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 363+ DF19              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 364+ DF19              ; ==============================================================================
 365+ DF19              CheckIfHouseSprite:
 366+ DF19 F5               PUSH AF
 367+ DF1A E5               PUSH HL
 368+ DF1B C5               PUSH BC
 369+ DF1C
 370+ DF1C 47               LD B, A                     ; B = id buscado
 371+ DF1D
 372+ DF1D AF               XOR A
 373+ DF1E 32 89 DD         LD (BgSpriteIsHouse), A     ; Default: no es house
 374+ DF21
 375+ DF21 21 51 DA         LD HL, HouseIdList
 376+ DF24              .checkLoop:
 377+ DF24 7E               LD A, (HL)
 378+ DF25 FE FF            CP $FF
 379+ DF27 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 380+ DF29 B8               CP B
 381+ DF2A 28 03            JR Z, .checkFound
 382+ DF2C 23               INC HL
 383+ DF2D 18 F5            JR .checkLoop
 384+ DF2F
 385+ DF2F              .checkFound:
 386+ DF2F 3E 01            LD A, 1
 387+ DF31 32 89 DD         LD (BgSpriteIsHouse), A
 388+ DF34
 389+ DF34              .checkDone:
 390+ DF34 C1               POP BC
 391+ DF35 E1               POP HL
 392+ DF36 F1               POP AF
 393+ DF37 C9               RET
 394+ DF38
