 255+ 69DB FF FF FF FF
 256+ 69DF FB FF FD FF      DEFB $FB,$FF, $FD,$FF, $FE,$7F, $FF,$BF
 256+ 69E3 FE 7F FF BF
 257+ 69E7 FF BF FF BF      DEFB $FF,$BF, $FF,$BF, $FE,$7F, $FD,$FF
