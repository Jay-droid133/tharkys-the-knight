5438+ C032              ; ==============================================================================
5439+ C032              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5440+ C032              ; ==============================================================================
5441+ C032              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5442+ C032              ; ==============================================================================
5443+ C032
5444+ C032              ; ==============================================================================
5445+ C032              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5446+ C032              ; ==============================================================================
5447+ C032              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5448+ C032              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5449+ C032              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5450+ C032              ; ==============================================================================
5451+ C032              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5452+ C032              ; ==============================================================================
5453+ C032              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5454+ C032              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5455+ C032              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5456+ C032              ; ==============================================================================
5457+ C032              MONSTERS_TO_SPAWN   EQU 3
5458+ C032              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5459+ C032              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
