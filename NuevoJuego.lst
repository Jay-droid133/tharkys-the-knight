 390+ 7E45              .upmiTickOnce:
 391+ 7E45 3A A5 7B         LD A, (MusicTimer)
 392+ 7E48 B7               OR A
 393+ 7E49 C8               RET Z                           ; inactivo
 394+ 7E4A 3D               DEC A
 395+ 7E4B 32 A5 7B         LD (MusicTimer), A
 396+ 7E4E C0               RET NZ                          ; aun en la nota actual
 397+ 7E4F                  ; Hora de la siguiente nota (fall-through a MusicAdvanceNote)
 398+ 7E4F
 399+ 7E4F              ; ==============================================================================
 400+ 7E4F              ; MusicAdvanceNote - lee siguiente nota y aplica al AY. Despacha por MusicMode.
 401+ 7E4F              ; ==============================================================================
 402+ 7E4F              ; Poly2 entry (5 B): periodA(2) + periodC(2) + duration(1)
 403+ 7E4F              ; Poly3 entry (7 B): periodA(2) + periodB(2) + periodC(2) + duration(1)
 404+ 7E4F              ; period=$0000 en un canal = mute (vol=0) durante esa nota.
 405+ 7E4F              ; duration=$00 (con todos los periods=0) = terminator → loop o stop.
 406+ 7E4F              ; ==============================================================================
 407+ 7E4F              MusicAdvanceNote:
 408+ 7E4F 3A A9 7B         LD A, (MusicMode)
 409+ 7E52 FE 03            CP 3
 410+ 7E54 28 72            JR Z, MusicAdvancePoly3
 411+ 7E56                  ; fall-through a MusicAdvancePoly2
 412+ 7E56
 413+ 7E56              ; --- Poly2 (5 B/entry): periodA, periodC, duration -----------------------------
 414+ 7E56              MusicAdvancePoly2:
 415+ 7E56 2A A3 7B         LD HL, (MusicPtr)
 416+ 7E59                  ; Leer periodA (HL+0..1)
 417+ 7E59 5E               LD E, (HL)
 418+ 7E5A 23               INC HL
 419+ 7E5B 56               LD D, (HL)
 420+ 7E5C 23               INC HL
 421+ 7E5D ED 53 AA 7B      LD (MusicPeriodA), DE
 422+ 7E61                  ; Leer periodC (HL+2..3) y guardarlo via BC para no clobbearlo
 423+ 7E61 4E               LD C, (HL)
 424+ 7E62 23               INC HL
 425+ 7E63 46               LD B, (HL)
 426+ 7E64 23               INC HL
 427+ 7E65 ED 43 AE 7B      LD (MusicPeriodC), BC
 428+ 7E69                  ; Duration (HL+4)
 429+ 7E69 7E               LD A, (HL)
 430+ 7E6A 23               INC HL
 431+ 7E6B B7               OR A
 432+ 7E6C 28 57            JR Z, .map2End                  ; duration=0 → terminator
 433+ 7E6E 22 A3 7B         LD (MusicPtr), HL
 434+ 7E71 CD 6A 7F         CALL ApplyMusicSpeedShift       ; A in/out: A = duration ajustada
 435+ 7E74 32 A5 7B         LD (MusicTimer), A
 436+ 7E77                  ; --- Aplicar canal A: si period != 0 escribir R0/R1 + R8=vol; si =0, R8=0 ---
 437+ 7E77 2A AA 7B         LD HL, (MusicPeriodA)
 438+ 7E7A 7C               LD A, H
 439+ 7E7B B5               OR L
 440+ 7E7C 20 09            JR NZ, .map2NoteA
 441+ 7E7E 3E 08            LD A, 8
 442+ 7E80 1E 00            LD E, 0
