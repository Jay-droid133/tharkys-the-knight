# file closed: monster_ai.asm
 489  9851                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 490  9851                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 491  9851                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9851              ; ==============================================================================
   2+ 9851              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9851              ; ==============================================================================
   4+ 9851              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9851              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9851              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9851              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9851              ;
   9+ 9851              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9851              ; fallo en el intento previo):
  11+ 9851              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9851              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9851              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9851              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9851              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9851              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9851              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9851              ;
  19+ 9851              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9851              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9851              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9851              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9851              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9851              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9851              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9851              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9851              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9851              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9851              ; ==============================================================================
  30+ 9851
  31+ 9851              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9851              AY_Init:
  33+ 9851 F3               DI
  34+ 9852 3A 7B 8D         LD A, (CurrentPaging)
  35+ 9855 E6 F8            AND $F8
  36+ 9857 F6 04            OR 4
  37+ 9859 32 7B 8D         LD (CurrentPaging), A
  38+ 985C 01 FD 7F         LD BC, $7FFD
  39+ 985F ED 79            OUT (C), A
  40+ 9861 CD 7A E7         CALL AY_InitImpl
  41+ 9864 3A 7B 8D         LD A, (CurrentPaging)
  42+ 9867 E6 F8            AND $F8
  43+ 9869 32 7B 8D         LD (CurrentPaging), A
  44+ 986C 01 FD 7F         LD BC, $7FFD
  45+ 986F ED 79            OUT (C), A
  46+ 9871 3A 93 81         LD A, (StartupComplete)
  47+ 9874 B7               OR A
  48+ 9875 C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9876 FB               EI
  50+ 9877 C9               RET
  51+ 9878
  52+ 9878              ; --- AY_UpdateBell: cada frame ---
  53+ 9878              ; SP alterno (slot 1) durante el page switch para no enmascarar IRQs. DI corto
  54+ 9878              ; SOLO alrededor del Impl (que hace varios OUTs AY que deben ser atomicos
  55+ 9878              ; respecto al handler IRQ que tambien escribe AY). Ver project_paging_alt_stack.
