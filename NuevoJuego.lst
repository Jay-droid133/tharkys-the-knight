 504+ FA5E              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 505+ FA5E              .bcPhTurnToDoor:
 506+ FA5E CD 09 FC         CALL BankCutsceneDecTimer
 507+ FA61 C0               RET NZ
 508+ FA62                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 509+ FA62 CD E0 F8         CALL BankCutsceneSnapToDoor
 510+ FA65 AF               XOR A
 511+ FA66 32 CF 82         LD (BankCutsceneKnockIdx), A
 512+ FA69 3E 01            LD A, 1
 513+ FA6B 32 D2 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 514+ FA6E AF               XOR A
 515+ FA6F 32 CE 82         LD (BankCutsceneSubState), A        ; HIT
 516+ FA72 3E 04            LD A, BCS_T_KNOCK_HIT
 517+ FA74 32 CD 82         LD (BankCutsceneTimer), A
 518+ FA77 CD A8 FB         CALL BankCutsceneEmitKnockHit
 519+ FA7A 3E 08            LD A, BCP_KNOCKS_3
 520+ FA7C 32 CC 82         LD (BankCutscenePhase), A
 521+ FA7F C9               RET
 522+ FA80
 523+ FA80              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 524+ FA80              .bcPhKnocks3:
 525+ FA80 3E 06            LD A, BCS_GROUP3_KNOCKS
 526+ FA82 CD 6D FB         CALL BankCutsceneTickKnockGroup
 527+ FA85 B7               OR A
 528+ FA86 C8               RET Z
 529+ FA87                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 530+ FA87                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 531+ FA87                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 532+ FA87 CD 06 F9         CALL BankCutsceneSnapToRetreat
 533+ FA8A 3E 1E            LD A, BCS_T_PRE_HAND
 534+ FA8C 32 CD 82         LD (BankCutsceneTimer), A
 535+ FA8F 3E 09            LD A, BCP_WAIT_3
 536+ FA91 32 CC 82         LD (BankCutscenePhase), A
 537+ FA94 C9               RET
 538+ FA95
 539+ FA95              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 540+ FA95              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 541+ FA95              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 542+ FA95              .bcPhWait3:
 543+ FA95 CD 09 FC         CALL BankCutsceneDecTimer
 544+ FA98 C0               RET NZ
 545+ FA99 CD 23 FC         CALL SFX_Bank_OnDoorCreak
 546+ FA9C 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 547+ FA9E 32 CD 82         LD (BankCutsceneTimer), A
 548+ FAA1 3E 0A            LD A, BCP_PRE_HAND
 549+ FAA3 32 CC 82         LD (BankCutscenePhase), A
 550+ FAA6 C9               RET
 551+ FAA7
 552+ FAA7              ; ---- Phase 10: hold corto antes de la mano ----
 553+ FAA7              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 554+ FAA7              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 555+ FAA7              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 556+ FAA7              .bcPhPreHand:
 557+ FAA7 CD 09 FC         CALL BankCutsceneDecTimer
 558+ FAAA C0               RET NZ
 559+ FAAB AF               XOR A
 560+ FAAC 32 D1 82         LD (BankCutsceneHandFrame), A
 561+ FAAF 32 D0 82         LD (BankCutsceneNoIdx), A
 562+ FAB2 CD AB FB         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 563+ FAB5 CD E9 FB         CALL BankCutsceneDrawHand           ; frame 0 sobre area en negro
 564+ FAB8 CD 24 FC         CALL SFX_Bank_OnHandIn
 565+ FABB                  ; HAND_IN saltado — la mano arranca el ciclo "no no" inmediatamente
 566+ FABB                  ; tras aparecer (sin pausa quieta). Para revertir: usar BCS_T_HAND_IN
 567+ FABB                  ; + BCP_HAND_IN aqui en vez de NO_FRAME + HAND_NO_NO.
 568+ FABB 3E 0C            LD A, BCS_T_NO_FRAME
 569+ FABD 32 CD 82         LD (BankCutsceneTimer), A
 570+ FAC0 3E 0C            LD A, BCP_HAND_NO_NO
 571+ FAC2 32 CC 82         LD (BankCutscenePhase), A
 572+ FAC5 C9               RET
 573+ FAC6
 574+ FAC6              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 575+ FAC6              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 576+ FAC6              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 577+ FAC6              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 578+ FAC6              .bcPhHandIn:
 579+ FAC6 CD 09 FC         CALL BankCutsceneDecTimer
 580+ FAC9 C0               RET NZ
 581+ FACA 3E 0C            LD A, BCS_T_NO_FRAME
 582+ FACC 32 CD 82         LD (BankCutsceneTimer), A
 583+ FACF 3E 0C            LD A, BCP_HAND_NO_NO
 584+ FAD1 32 CC 82         LD (BankCutscenePhase), A
 585+ FAD4 C9               RET
 586+ FAD5
 587+ FAD5              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 588+ FAD5              .bcPhHandNoNo:
 589+ FAD5 CD 09 FC         CALL BankCutsceneDecTimer
 590+ FAD8 C0               RET NZ
 591+ FAD9                  ; Swap frame: erase actual + draw el otro.
 592+ FAD9 CD 06 FC         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 593+ FADC 3A D1 82         LD A, (BankCutsceneHandFrame)
 594+ FADF EE 01            XOR 1
 595+ FAE1 32 D1 82         LD (BankCutsceneHandFrame), A
 596+ FAE4 CD E9 FB         CALL BankCutsceneDrawHand           ; draw frame nuevo
 597+ FAE7 CD 2A FC         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 598+ FAEA                  ; Increment swap idx, check completion.
 599+ FAEA 3A D0 82         LD A, (BankCutsceneNoIdx)
 600+ FAED 3C               INC A
 601+ FAEE 32 D0 82         LD (BankCutsceneNoIdx), A
 602+ FAF1 FE 08            CP BCS_NO_SWAPS_TOTAL
 603+ FAF3 38 0B            JR C, .bcNoNoMoreSwaps
 604+ FAF5                  ; Todos los swaps hechos — pausa antes de erase mano.
 605+ FAF5 3E 0F            LD A, BCS_T_HAND_HOLD
 606+ FAF7 32 CD 82         LD (BankCutsceneTimer), A
 607+ FAFA                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 608+ FAFA                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 609+ FAFA 3E 0D            LD A, BCP_HAND_OUT
 610+ FAFC 32 CC 82         LD (BankCutscenePhase), A
 611+ FAFF C9               RET
 612+ FB00              .bcNoNoMoreSwaps:
 613+ FB00 3E 0C            LD A, BCS_T_NO_FRAME
 614+ FB02 32 CD 82         LD (BankCutsceneTimer), A
 615+ FB05 C9               RET
 616+ FB06
 617+ FB06              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 618+ FB06              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 619+ FB06              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 620+ FB06              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 621+ FB06              ; del pickup dormant).
 622+ FB06              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 623+ FB06              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 624+ FB06              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 625+ FB06              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 626+ FB06              ; de la llave.
 627+ FB06              .bcPhHandOut:
 628+ FB06 CD 09 FC         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 629+ FB09 C0               RET NZ
 630+ FB0A CD 06 FC         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 631+ FB0D CD CD FB         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 632+ FB10 CD 3D FC         CALL SFX_Bank_OnHandOut             ; SFX cierre de puerta (placeholder hoy)
 633+ FB13 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 634+ FB15 32 CD 82         LD (BankCutsceneTimer), A
 635+ FB18 3E 12            LD A, BCP_DOOR_CLOSED
 636+ FB1A 32 CC 82         LD (BankCutscenePhase), A
 637+ FB1D C9               RET
 638+ FB1E
 639+ FB1E              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 640+ FB1E              .bcPhDoorClosed:
 641+ FB1E CD 09 FC         CALL BankCutsceneDecTimer
 642+ FB21 C0               RET NZ
 643+ FB22                  ; --- Spawn de la llave de la ciudad ---
 644+ FB22 3E 01            LD A, 1
