1287+ D356                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1288+ D356                  ; Total pixeles = height_px * (width_bytes & $7F)
1289+ D356              .spSkipRle:
1290+ D356 7B               LD A, E
1291+ D357 E6 7F            AND $7F                     ; width_bytes real
1292+ D359                  ; Calcular total = D * A (height * width)
1293+ D359 42               LD B, D                     ; B = height
1294+ D35A 21 00 00         LD HL, 0
1295+ D35D 16 00            LD D, 0
1296+ D35F 5F               LD E, A                     ; DE = width
