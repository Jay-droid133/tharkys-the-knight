2359+ ABD0 77               LD (HL), A
2360+ ABD1 23               INC HL
2361+ ABD2 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2362+ ABD4 77               LD (HL), A
2363+ ABD5 E1               POP HL
2364+ ABD6                  ; CleanAttrMap
2365+ ABD6 11 5D 8A         LD DE, CleanAttrMap
2366+ ABD9 19               ADD HL, DE
2367+ ABDA 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2368+ ABDC 77               LD (HL), A
2369+ ABDD 23               INC HL
2370+ ABDE 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2371+ ABE0 77               LD (HL), A
2372+ ABE1 C9               RET
