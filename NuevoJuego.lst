4323+ B6AE 0F               RRCA
4324+ B6AF 0F               RRCA
4325+ B6B0 E6 1F            AND $1F
4326+ B6B2 D6 02            SUB BG_Y_OFFSET
4327+ B6B4 47               LD B, A                         ; B = charYhi
4328+ B6B5 3A F8 B6         LD A, (.ecYlo)
