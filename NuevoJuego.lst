 334+ E579                  ; Extraer paper+bright como indice 0-15
 335+ E579 79               LD A, C
 336+ E57A E6 78            AND $78                     ; A = 0BPPP000
 337+ E57C 0F               RRCA
 338+ E57D 0F               RRCA
 339+ E57E 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E57F
 341+ E57F                  ; Elegir tabla segun tipo de sprite
 342+ E57F 5F               LD E, A
 343+ E580 16 00            LD D, 0
 344+ E582 3A FB E3         LD A, (BgSpriteIsHouse)
