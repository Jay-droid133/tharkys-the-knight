1316+ 97F3              ; ==============================================================================
1317+ 97F3              ; CheckPlayerZoneAtChar - test si la celda (D=cy, E=cx) es alcanzable
1318+ 97F3              ; ==============================================================================
1319+ 97F3              ; Lee FlowField (bank 6) en offset cy*32+cx. FlowField se actualiza al cambiar
1320+ 97F3              ; de sala via MaiComputeFlowField llamado desde DrawScreen.
1321+ 97F3              ; OUT: Z si NO alcanzable (FlowField == $FF), NZ si alcanzable.
1322+ 97F3              ; Destruye: AF, BC, HL.
1323+ 97F3              ; ==============================================================================
1324+ 97F3              CheckPlayerZoneAtChar:
1325+ 97F3                  ; offset = cy*32 + cx
1326+ 97F3 26 00            LD H, 0
1327+ 97F5 6A               LD L, D
1328+ 97F6 29               ADD HL, HL
1329+ 97F7 29               ADD HL, HL
1330+ 97F8 29               ADD HL, HL
1331+ 97F9 29               ADD HL, HL
1332+ 97FA 29               ADD HL, HL                              ; HL = cy * 32
1333+ 97FB 7B               LD A, E
1334+ 97FC 85               ADD A, L
1335+ 97FD 6F               LD L, A
1336+ 97FE 30 01            JR NC, .cpzaNoCarry
1337+ 9800 24               INC H
1338+ 9801              .cpzaNoCarry:
1339+ 9801 01 ED C9         LD BC, FlowField
1340+ 9804 09               ADD HL, BC                              ; HL = FlowField + offset
1341+ 9805 E5               PUSH HL
1342+ 9806 F3               DI
1343+ 9807 3A 57 90         LD A, (CurrentPaging)
1344+ 980A E6 F8            AND $F8
1345+ 980C F6 06            OR 6
1346+ 980E 32 57 90         LD (CurrentPaging), A
1347+ 9811 01 FD 7F         LD BC, $7FFD
1348+ 9814 ED 79            OUT (C), A
1349+ 9816 E1               POP HL
1350+ 9817 7E               LD A, (HL)                              ; FlowField byte
1351+ 9818 F5               PUSH AF
1352+ 9819 3A 57 90         LD A, (CurrentPaging)
1353+ 981C E6 F8            AND $F8
1354+ 981E 32 57 90         LD (CurrentPaging), A
1355+ 9821 01 FD 7F         LD BC, $7FFD
1356+ 9824 ED 79            OUT (C), A
1357+ 9826 3A DB 80         LD A, (StartupComplete)
1358+ 9829 B7               OR A
1359+ 982A 28 01            JR Z, .cpzaNoEI
1360+ 982C FB               EI
1361+ 982D              .cpzaNoEI:
1362+ 982D F1               POP AF
1363+ 982E 3C               INC A                                   ; $FF -> 0 (Z = unreachable), else NZ (reachable)
1364+ 982F C9               RET
