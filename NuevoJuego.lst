 145+ 9922 ED 79            OUT (C), A
 146+ 9924 01 FD BF         LD BC, $BFFD
 147+ 9927 ED 59            OUT (C), E
 148+ 9929 5C               LD E, H
 149+ 992A 3E 03            LD A, 3
 150+ 992C 01 FD FF         LD BC, $FFFD
 151+ 992F ED 79            OUT (C), A
 152+ 9931 01 FD BF         LD BC, $BFFD
 153+ 9934 ED 59            OUT (C), E
 154+ 9936                  ; R4/R5 (canal C)
 155+ 9936 5D               LD E, L
 156+ 9937 3E 04            LD A, 4
 157+ 9939 01 FD FF         LD BC, $FFFD
 158+ 993C ED 79            OUT (C), A
 159+ 993E 01 FD BF         LD BC, $BFFD
 160+ 9941 ED 59            OUT (C), E
 161+ 9943 5C               LD E, H
 162+ 9944 3E 05            LD A, 5
 163+ 9946 01 FD FF         LD BC, $FFFD
 164+ 9949 ED 79            OUT (C), A
 165+ 994B 01 FD BF         LD BC, $BFFD
 166+ 994E ED 59            OUT (C), E
 167+ 9950 FB               EI
 168+ 9951 C9               RET
 169+ 9952
 170+ 9952              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 171+ 9952              ; HL = period (12-bit), B = duracion (10ms units).
 172+ 9952              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 173+ 9952              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 174+ 9952              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 175+ 9952              ; cambiaramos de bank en slot 3 entre el push y el pop).
 176+ 9952              AY_PlayToneBlocking:
 177+ 9952 F3               DI
 178+ 9953                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 9953                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 9953 5C               LD E, H                     ; E = period high
 181+ 9954 3E 01            LD A, 1
 182+ 9956 01 FD FF         LD BC, $FFFD
 183+ 9959 ED 79            OUT (C), A
 184+ 995B 01 FD BF         LD BC, $BFFD
 185+ 995E ED 59            OUT (C), E
 186+ 9960                  ; R0 = period low
 187+ 9960 5D               LD E, L                     ; E = period low
 188+ 9961 3E 00            LD A, 0
 189+ 9963 01 FD FF         LD BC, $FFFD
 190+ 9966 ED 79            OUT (C), A
 191+ 9968 01 FD BF         LD BC, $BFFD
 192+ 996B ED 59            OUT (C), E
 193+ 996D                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 194+ 996D 3E 09            LD A, 9
 195+ 996F 01 FD FF         LD BC, $FFFD
 196+ 9972 ED 79            OUT (C), A
 197+ 9974 01 FD BF         LD BC, $BFFD
 198+ 9977 AF               XOR A
 199+ 9978 ED 79            OUT (C), A
 200+ 997A                  ; R10 = 0 (silenciar canal C)
 201+ 997A 3E 0A            LD A, 10
 202+ 997C 01 FD FF         LD BC, $FFFD
 203+ 997F ED 79            OUT (C), A
 204+ 9981 01 FD BF         LD BC, $BFFD
 205+ 9984 AF               XOR A
 206+ 9985 ED 79            OUT (C), A
 207+ 9987                  ; R7 = $3E (mixer: solo tono A activo)
 208+ 9987 3E 07            LD A, 7
 209+ 9989 01 FD FF         LD BC, $FFFD
 210+ 998C ED 79            OUT (C), A
 211+ 998E 01 FD BF         LD BC, $BFFD
 212+ 9991 3E 3E            LD A, $3E
 213+ 9993 ED 79            OUT (C), A
 214+ 9995                  ; R8 = 13 (volumen A alto)
 215+ 9995 3E 08            LD A, 8
 216+ 9997 01 FD FF         LD BC, $FFFD
 217+ 999A ED 79            OUT (C), A
 218+ 999C 01 FD BF         LD BC, $BFFD
 219+ 999F 3E 0D            LD A, 13
 220+ 99A1 ED 79            OUT (C), A
