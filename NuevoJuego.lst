1888+ AD36              ; UpdateEnemy - AI patrol + bounce (estilo Sabre Wulf)
1889+ AD36              ; ==============================================================================
1890+ AD36              ; Cada frame: posicion += delta. Si choca con borde o fondo, invierte delta.
1891+ AD36              ; Animacion: cicla SpriteID dentro del rango del tipo.
1892+ AD36              ; IX = puntero a la entidad enemiga.
1893+ AD36              ; ==============================================================================
1894+ AD36              ; ==============================================================================
1895+ AD36              ; CheckPredatorAttack - Comprueba si nasty debe lanzarse como depredador
1896+ AD36              ; ==============================================================================
1897+ AD36              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
1898+ AD36              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
1899+ AD36              ; ==============================================================================
1900+ AD36              ; ==============================================================================
1901+ AD36              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1902+ AD36              ; ==============================================================================
1903+ AD36              UpdateStamina:
1904+ AD36                  ; --- Regenerar salud (siempre, lento) ---
1905+ AD36 3A 10 B6         LD A, (PlayerHealth)
1906+ AD39 FE 10            CP HEALTH_MAX
1907+ AD3B 28 12            JR Z, .usHealthFull
1908+ AD3D 21 14 B6         LD HL, HealthRegenCtr
1909+ AD40 34               INC (HL)
1910+ AD41 7E               LD A, (HL)
1911+ AD42 FE 32            CP HEALTH_REGEN_RATE
1912+ AD44 38 09            JR C, .usHealthFull
1913+ AD46 36 00            LD (HL), 0
1914+ AD48 3A 10 B6         LD A, (PlayerHealth)
1915+ AD4B 3C               INC A
1916+ AD4C 32 10 B6         LD (PlayerHealth), A
1917+ AD4F              .usHealthFull:
1918+ AD4F                  ; --- Stamina: consumir o regenerar ---
1919+ AD4F DD 7E 02         LD A, (IX+ENT_STATE)
1920+ AD52 FE 02            CP STATE_FIGHTING
1921+ AD54 28 18            JR Z, .usDrain
1922+ AD56                  ; No atacando: regenerar
1923+ AD56 3A 11 B6         LD A, (PlayerStamina)
1924+ AD59 FE 10            CP STAMINA_MAX
1925+ AD5B C8               RET Z                               ; Ya al maximo
1926+ AD5C 21 13 B6         LD HL, StaminaRegenCtr
1927+ AD5F 34               INC (HL)
1928+ AD60 7E               LD A, (HL)
1929+ AD61 FE 19            CP STAMINA_REGEN_RATE
1930+ AD63 D8               RET C                               ; Aun no toca
1931+ AD64 36 00            LD (HL), 0                          ; Reset counter
1932+ AD66 3A 11 B6         LD A, (PlayerStamina)
1933+ AD69 3C               INC A
1934+ AD6A 32 11 B6         LD (PlayerStamina), A
1935+ AD6D C9               RET
1936+ AD6E              .usDrain:
1937+ AD6E                  ; Atacando: consumir stamina
1938+ AD6E 3A 11 B6         LD A, (PlayerStamina)
1939+ AD71 B7               OR A
1940+ AD72 C8               RET Z                               ; Ya vacia
1941+ AD73 21 12 B6         LD HL, StaminaDrainCtr
1942+ AD76 34               INC (HL)
1943+ AD77 7E               LD A, (HL)
1944+ AD78 FE 0D            CP STAMINA_DRAIN_RATE
1945+ AD7A D8               RET C
1946+ AD7B 36 00            LD (HL), 0
1947+ AD7D 3A 11 B6         LD A, (PlayerStamina)
1948+ AD80 3D               DEC A
1949+ AD81 32 11 B6         LD (PlayerStamina), A
1950+ AD84                  ; Si stamina llega a 0, dar 1 punto tras cooldown
1951+ AD84 B7               OR A
1952+ AD85 C0               RET NZ
1953+ AD86 3E 01            LD A, 1
1954+ AD88 32 11 B6         LD (PlayerStamina), A               ; Minimo 1 para un swing
1955+ AD8B C9               RET
1956+ AD8C
1957+ AD8C              ; ==============================================================================
1958+ AD8C              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
1959+ AD8C              ; ==============================================================================
1960+ AD8C              SelectSwordMode:
1961+ AD8C 3A 11 B6         LD A, (PlayerStamina)
1962+ AD8F FE 0C            CP STAMINA_THRESHOLD_HIGH
1963+ AD91 38 04            JR C, .smNotHigh
1964+ AD93 3E 02            LD A, 2                             ; Libre (continuo)
1965+ AD95 18 09            JR .smSet
1966+ AD97              .smNotHigh:
1967+ AD97 FE 07            CP STAMINA_THRESHOLD_MID
1968+ AD99 38 04            JR C, .smNotMid
1969+ AD9B 3E 01            LD A, 1                             ; Fixed swing
1970+ AD9D 18 01            JR .smSet
1971+ AD9F              .smNotMid:
1972+ AD9F AF               XOR A                               ; Cooldown (0)
1973+ ADA0              .smSet:
1974+ ADA0 32 0F B6         LD (SwordMode), A
1975+ ADA3 C9               RET
1976+ ADA4
1977+ ADA4              ; ==============================================================================
1978+ ADA4              ; GetStaminaColor - Devuelve color del player segun estado actual
1979+ ADA4              ; ==============================================================================
1980+ ADA4              ; Salida: A = atributo de color (bright)
1981+ ADA4              ; ==============================================================================
1982+ ADA4              GetStaminaColor:
1983+ ADA4 3A 0F B6         LD A, (SwordMode)
1984+ ADA7 B7               OR A
1985+ ADA8 20 09            JR NZ, .gscWhite                   ; Modo C o libre → blanco
1986+ ADAA 3A 0C B6         LD A, (AttackCooldown)
1987+ ADAD B7               OR A
1988+ ADAE 28 03            JR Z, .gscWhite
1989+ ADB0 3E 41            LD A, BLUE | $40                    ; Modo B + cooldown activo → azul
1990+ ADB2 C9               RET
1991+ ADB3              .gscWhite:
1992+ ADB3 3E 47            LD A, WHITE | $40                   ; Normal → blanco
1993+ ADB5 C9               RET
1994+ ADB6
1995+ ADB6              ; ==============================================================================
1996+ ADB6              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
1997+ ADB6              ; ==============================================================================
1998+ ADB6              CheckWellPickup:
1999+ ADB6 3A 2C 90         LD A, (WellActive)
2000+ ADB9 B7               OR A
2001+ ADBA C8               RET Z                               ; No hay pozo en esta pantalla
2002+ ADBB                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2003+ ADBB 2A 30 90         LD HL, (WellCooldownTimer)
2004+ ADBE 7C               LD A, H
2005+ ADBF B5               OR L
2006+ ADC0 C0               RET NZ                              ; timer > 0 → skip
2007+ ADC1                  ; Ya esta al maximo? No hacer nada
2008+ ADC1 3A 10 B6         LD A, (PlayerHealth)
2009+ ADC4 FE 10            CP HEALTH_MAX
2010+ ADC6 20 06            JR NZ, .cwDoCheck
2011+ ADC8 3A 11 B6         LD A, (PlayerStamina)
2012+ ADCB FE 10            CP STAMINA_MAX
2013+ ADCD C8               RET Z                               ; Ambos al maximo → nada
2014+ ADCE              .cwDoCheck:
2015+ ADCE                  ; AABB con margen de 8px (1 celda) por cada lado:
2016+ ADCE                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2017+ ADCE                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2018+ ADCE                  ; --- Check X ---
2019+ ADCE 3A 2D 90         LD A, (WellPosX)
2020+ ADD1 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2021+ ADD3 4F               LD C, A
2022+ ADD4 3A DF 80         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2023+ ADD7 B9               CP C                                ; playerX < wellRight+margen?
2024+ ADD8 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2025+ ADDA 3A DF 80         LD A, (EntityTable + ENT_POSX)
2026+ ADDD C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2027+ ADDF 4F               LD C, A
2028+ ADE0 3A 2D 90         LD A, (WellPosX)                    ; A = wellX
2029+ ADE3 B9               CP C                                ; wellX < playerRight+margen?
2030+ ADE4 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2031+ ADE6                  ; --- Check Y ---
2032+ ADE6 3A 2E 90         LD A, (WellPosY)
2033+ ADE9 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2034+ ADEB 4F               LD C, A
2035+ ADEC 3A E0 80         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2036+ ADEF B9               CP C                                ; playerY < wellBottom+margen?
2037+ ADF0 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2038+ ADF2 3A E0 80         LD A, (EntityTable + ENT_POSY)
2039+ ADF5 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2040+ ADF7 4F               LD C, A
2041+ ADF8 3A 2E 90         LD A, (WellPosY)                    ; A = wellY
2042+ ADFB B9               CP C                                ; wellY < playerBottom+margen?
2043+ ADFC 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2044+ ADFE                  ; --- Overlap! Recuperar salud y stamina ---
2045+ ADFE 3E 10            LD A, HEALTH_MAX
2046+ AE00 32 10 B6         LD (PlayerHealth), A
2047+ AE03 3E 10            LD A, STAMINA_MAX
2048+ AE05 32 11 B6         LD (PlayerStamina), A
2049+ AE08                  ; Flash HUD y SFX
2050+ AE08 3E 0A            LD A, 10                            ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
2051+ AE0A 32 2F 90         LD (WellFlashTimer), A
2052+ AE0D                  ; Arrancar cooldown: capturar attrs originales + pintar blanco
2053+ AE0D CD 17 AE         CALL StartWellCooldown
2054+ AE10 21 D5 F1         LD HL, SFX_WellRecover
2055+ AE13 CD 1E F1         CALL PlaySFX
2056+ AE16              .cwNoOverlap:
2057+ AE16 C9               RET
2058+ AE17
2059+ AE17              ; ==============================================================================
2060+ AE17              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2061+ AE17              ; ==============================================================================
2062+ AE17              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2063+ AE17              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2064+ AE17              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2065+ AE17              ; ==============================================================================
2066+ AE17              StartWellCooldown:
2067+ AE17 CD 44 AE         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2068+ AE1A E5               PUSH HL
2069+ AE1B 11 2A 8D         LD DE, CleanAttrMap
2070+ AE1E 19               ADD HL, DE
2071+ AE1F 7E               LD A, (HL)
2072+ AE20 32 32 90         LD (WellOrigAttr0), A
2073+ AE23 23               INC HL
2074+ AE24 7E               LD A, (HL)
2075+ AE25 32 33 90         LD (WellOrigAttr1), A
2076+ AE28 E1               POP HL
2077+ AE29 CD 5E AE         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
