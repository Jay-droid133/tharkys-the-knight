2743+ DA81 FE FE            CP $FE
2744+ DA83 28 7E            JR Z, .bprcInactive
2745+ DA85 47               LD B, A                     ; B = mapX
2746+ DA86 23               INC HL
2747+ DA87 4E               LD C, (HL)                  ; C = mapY
2748+ DA88 23               INC HL                      ; HL -> ptr_lo
2749+ DA89 3A 01 83         LD A, (CurrentScreenX)
2750+ DA8C B8               CP B
