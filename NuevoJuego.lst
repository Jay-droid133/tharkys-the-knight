 314+ 6FE6              ; ==============================================================================
 315+ 6FE6              ; UpdateRandomPickup - room-enter hook
 316+ 6FE6              ; ==============================================================================
 317+ 6FE6              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 318+ 6FE6              ; Early-out si ScreenDirty=0 (no transition).
 319+ 6FE6              ;
 320+ 6FE6              ; En transition:
 321+ 6FE6              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 322+ 6FE6              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 323+ 6FE6              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 324+ 6FE6              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 325+ 6FE6              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 326+ 6FE6              ;
 327+ 6FE6              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 328+ 6FE6              ; fijos (id, charX, charY, v) terminados con id=$FF.
 329+ 6FE6              ;
 330+ 6FE6              ; Destruye AF, BC, DE, HL.
 331+ 6FE6              ; ==============================================================================
 332+ 6FE6              UpdateRandomPickup:
 333+ 6FE6 3A 13 83         LD A, (ScreenDirty)
 334+ 6FE9 B7               OR A
 335+ 6FEA C8               RET Z
 336+ 6FEB
 337+ 6FEB                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 338+ 6FEB 3E FE            LD A, $FE
 339+ 6FED 32 B4 5F         LD (RandomSynthMapX), A
 340+ 6FF0 AF               XOR A
 341+ 6FF1 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 342+ 6FF4
 343+ 6FF4                  ; --- Scan BG stream, build SlotList ---
 344+ 6FF4 AF               XOR A
 345+ 6FF5 32 AB 5F         LD (RandomSlotCount), A
 346+ 6FF8 2A 0D 83         LD HL, (CurrentScreenAddr)
 347+ 6FFB              .urpScanLoop:
 348+ 6FFB 7E               LD A, (HL)                          ; A = id
 349+ 6FFC FE FF            CP $FF
 350+ 6FFE 28 2A            JR Z, .urpScanDone
 351+ 7000 FE D2            CP RANDOM_SLOT_MARKER
 352+ 7002 20 20            JR NZ, .urpSkipEntry
 353+ 7004                  ; Es marker. Cap reached?
 354+ 7004 3A AB 5F         LD A, (RandomSlotCount)
 355+ 7007 FE 04            CP RANDOM_SLOT_MAX
 356+ 7009 30 19            JR NC, .urpSkipEntry
 357+ 700B                  ; SlotList[count*2] = charX, [count*2+1] = charY
 358+ 700B 23               INC HL                              ; HL @ charX
 359+ 700C 46               LD B, (HL)                          ; B = charX
 360+ 700D 23               INC HL                              ; HL @ charY
 361+ 700E 4E               LD C, (HL)                          ; C = charY
 362+ 700F E5               PUSH HL                             ; save HL @ charY
 363+ 7010 87               ADD A, A                            ; A = count*2
 364+ 7011 6F               LD L, A
 365+ 7012 26 00            LD H, 0
 366+ 7014 11 AC 5F         LD DE, RandomSlotList
 367+ 7017 19               ADD HL, DE
 368+ 7018 70               LD (HL), B                          ; charX
 369+ 7019 23               INC HL
 370+ 701A 71               LD (HL), C                          ; charY
 371+ 701B 21 AB 5F         LD HL, RandomSlotCount
 372+ 701E 34               INC (HL)
 373+ 701F E1               POP HL                              ; HL @ charY
 374+ 7020 23               INC HL                              ; HL @ v
 375+ 7021 23               INC HL                              ; HL @ next id
 376+ 7022 18 D7            JR .urpScanLoop
 377+ 7024              .urpSkipEntry:
 378+ 7024                  ; Skip entry: 4 bytes (id, charX, charY, v).
 379+ 7024 23               INC HL
 379+ 7025 23             INC HL
 379+ 7026 23             INC HL
 379+ 7027 23             INC HL
 380+ 7028 18 D1            JR .urpScanLoop
 381+ 702A              .urpScanDone:
