2719+ ADE2              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2720+ ADE2              ; ==============================================================================
2721+ ADE2              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2722+ ADE2              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2723+ ADE2              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2724+ ADE2              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2725+ ADE2              ; ==============================================================================
2726+ ADE2              UpdateMonster:
2727+ ADE2                  ; --- Stun: knockback + pausa tras golpe del player ---
2728+ ADE2 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2729+ ADE5 B7               OR A
2730+ ADE6 CA 1B B0         JP Z, .moNormal
2731+ ADE9 DD 35 0A         DEC (IX+ENT_DIR)
2732+ ADEC 20 0B            JR NZ, .moStunActive
2733+ ADEE                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2734+ ADEE DD 36 06 00      LD (IX+ENT_DELTAX), 0
2735+ ADF2 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2736+ ADF6 C3 1B B0         JP .moNormal
2737+ ADF9
2738+ ADF9              .moStunActive:
2739+ ADF9                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2740+ ADF9 FE 06            CP MONSTER_STUN_PAUSE
2741+ ADFB DA AC B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2742+ ADFE                  ; Knockback: aplicar movimiento con collision check
2743+ ADFE DD 56 06         LD D, (IX+ENT_DELTAX)
2744+ AE01 DD 5E 07         LD E, (IX+ENT_DELTAY)
2745+ AE04 7A               LD A, D
2746+ AE05 B3               OR E
2747+ AE06 CA AC B1         JP Z, .moAnimate
