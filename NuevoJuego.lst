2984+ B2DE                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2985+ B2DE                  ;
2986+ B2DE                  ; Doble comportamiento:
2987+ B2DE                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2988+ B2DE                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2989+ B2DE                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2990+ B2DE                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2991+ B2DE                  ;   y lo activa).
2992+ B2DE                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2993+ B2DE                  ;   El monster queda en destino (memoria) hasta que el player visite.
2994+ B2DE                  ;
2995+ B2DE                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2996+ B2DE                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2997+ B2DE DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2998+ B2E1 32 22 B3         LD (.moKbSavedDir), A
2999+ B2E4 3E 01            LD A, 1
3000+ B2E6 32 6D B6         LD (MonsterKbDespawn), A
