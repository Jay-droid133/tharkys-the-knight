7368+ C813              ; --- bfsTryNbr: probar vecino (B=nx, C=ny, A=step_dir). Si valido, encolar
7369+ C813              ; y actualizar best. ---
7370+ C813              .bfsTryNbr:
7371+ C813 32 7A 5F         LD (DBfsTryDir), A
7372+ C816 78               LD A, B
7373+ C817 32 78 5F         LD (DBfsTryCx), A
7374+ C81A 79               LD A, C
7375+ C81B 32 79 5F         LD (DBfsTryCy), A
7376+ C81E                  ; Bounds: nx <= FFZ_MAX_CX, ny <= FFZ_MAX_CY (sprite cabe sin wrap/HUD)
7377+ C81E 3A 78 5F         LD A, (DBfsTryCx)
7378+ C821 FE 1E            CP FFZ_MAX_CX + 1
7379+ C823 D0               RET NC
7380+ C824 3A 79 5F         LD A, (DBfsTryCy)
7381+ C827 FE 11            CP FFZ_MAX_CY + 1
