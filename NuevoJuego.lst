1903+ ACD4 28 34            JR Z, .noPushBackPop
1904+ ACD6              .doPushBackWest:
1905+ ACD6 DD 7E 03         LD A, (IX+ENT_POSX)
1906+ ACD9 C6 08            ADD A, 8
1907+ ACDB DD 77 03         LD (IX+ENT_POSX), A
1908+ ACDE 18 2A            JR .noPushBackPop
1909+ ACE0
1910+ ACE0                  ; Attack east: comprobar X+23 en fila superior E inferior → mover -8
1911+ ACE0              .pushBackEast:
1912+ ACE0 D5               PUSH DE
1913+ ACE1 C5               PUSH BC
1914+ ACE2 DD 7E 03         LD A, (IX+ENT_POSX)
1915+ ACE5 C6 17            ADD A, 23
1916+ ACE7 47               LD B, A
1917+ ACE8 DD 7E 04         LD A, (IX+ENT_POSY)
1918+ ACEB 4F               LD C, A
1919+ ACEC CD 5B D8         CALL IsPointBlocked
1920+ ACEF 20 11            JR NZ, .doPushBackEast
1921+ ACF1 DD 7E 03         LD A, (IX+ENT_POSX)
1922+ ACF4 C6 17            ADD A, 23
1923+ ACF6 47               LD B, A
1924+ ACF7 DD 7E 04         LD A, (IX+ENT_POSY)
1925+ ACFA C6 14            ADD A, 20
1926+ ACFC 4F               LD C, A
1927+ ACFD CD 5B D8         CALL IsPointBlocked
1928+ AD00 28 08            JR Z, .noPushBackPop
1929+ AD02              .doPushBackEast:
1930+ AD02 DD 7E 03         LD A, (IX+ENT_POSX)
1931+ AD05 D6 08            SUB 8
1932+ AD07 DD 77 03         LD (IX+ENT_POSX), A
1933+ AD0A              .noPushBackPop:
1934+ AD0A C1               POP BC
1935+ AD0B D1               POP DE
1936+ AD0C              .noPushBack:
1937+ AD0C                  ; Si es animacion de ataque → SFX al inicio del primer swing
1938+ AD0C 7A               LD A, D
1939+ AD0D FE 16            CP SPRID_ATTACK_EAST
1940+ AD0F 28 04            JR Z, .newAnimAttackSfx
1941+ AD11 FE 1B            CP SPRID_ATTACK_WEST
1942+ AD13 20 0F            JR NZ, .newAnimNoSfx
1943+ AD15              .newAnimAttackSfx:
1944+ AD15 3E 01            LD A, 1
1945+ AD17 32 66 B6         LD (AttackSfxPlayed), A         ; Marcar: ya sono este ciclo
1946+ AD1A C5               PUSH BC
1947+ AD1B D5               PUSH DE
1948+ AD1C 21 C5 F9         LD HL, SFX_Attack
1949+ AD1F CD 4F F9         CALL PlaySFX
1950+ AD22 D1               POP DE
1951+ AD23 C1               POP BC
1952+ AD24              .newAnimNoSfx:
