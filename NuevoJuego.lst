 485+ 8FBB              ; MaiPickRandomGap
 486+ 8FBB              ; ==============================================================================
 487+ 8FBB              ; Selecciona un opening aleatorio del screen actual (ScreenGaps en bank 6) y
 488+ 8FBB              ; traduce (side, coord) a posicion pixel con MAI_ENTRY_OFFSET aplicado.
 489+ 8FBB              ;
 490+ 8FBB              ; Output:
 491+ 8FBB              ;   A = 0 exito; (MaiSpawnX), (MaiSpawnY) contienen posicion spawn
 492+ 8FBB              ;   A = 1 no hay gaps validos; el caller debe usar fallback (LastEntryPos)
 493+ 8FBB              ; Destruye: AF, BC, DE, HL
 494+ 8FBB              ; ==============================================================================
 495+ 8FBB              MaiPickRandomGap:
 496+ 8FBB                  ; screen_id = Y * 16 + X
 497+ 8FBB 3A 0C 83         LD A, (CurrentScreenY)
 498+ 8FBE 07               RLCA
 499+ 8FBF 07               RLCA
 500+ 8FC0 07               RLCA
 501+ 8FC1 07               RLCA
 502+ 8FC2 21 0B 83         LD HL, CurrentScreenX
 503+ 8FC5 86               ADD A, (HL)
 504+ 8FC6 32 BD 97         LD (MaiGapScreenId), A
 505+ 8FC9
 506+ 8FC9                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 507+ 8FC9 F3               DI
 508+ 8FCA
 509+ 8FCA                  ; Inline page bank 6
 510+ 8FCA 3A 85 8D         LD A, (CurrentPaging)
 511+ 8FCD E6 F8            AND $F8
 512+ 8FCF F6 06            OR 6
 513+ 8FD1 32 85 8D         LD (CurrentPaging), A
 514+ 8FD4 01 FD 7F         LD BC, $7FFD
