 967+ 954D              ; MaiGetEntrySide
 968+ 954D              ; ==============================================================================
 969+ 954D              ; Traduce ScreenTransition (direccion en la que se movio el player al cruzar
 970+ 954D              ; el borde) al side de ENTRADA en el nuevo room (el borde opuesto).
 971+ 954D              ;
 972+ 954D              ;   DIR_N (player fue al norte) → SIDE_S (entro por el sur del nuevo room)
 973+ 954D              ;   DIR_S → SIDE_N
 974+ 954D              ;   DIR_E → SIDE_W
 975+ 954D              ;   DIR_W → SIDE_E
 976+ 954D              ;
 977+ 954D              ; OUT: A = MAI_SIDE_N/S/W/E o $FF si no hay transicion activa.
