 641+ 9071              ; ==============================================================================
 642+ 9071              ; MaiPickRandomGapOnSide
 643+ 9071              ; ==============================================================================
 644+ 9071              ; Variante de MaiPickRandomGap que filtra por side concreto (N/S/W/E).
 645+ 9071              ; Usado por Regla 2 (follow al cambiar room) para que los monsters entren
 646+ 9071              ; por el mismo borde que uso el player.
 647+ 9071              ;
 648+ 9071              ; IN:  A = side deseado (MAI_SIDE_N/S/W/E)
 649+ 9071              ; OUT: A = 0 ok (MaiSpawnX/Y llenos); A = 1 sin gaps en ese side → fallback
 650+ 9071              ; ==============================================================================
 651+ 9071              MaiPickRandomGapOnSide:
 652+ 9071 32 B7 97         LD (MaiGapWantSide), A
 653+ 9074
 654+ 9074                  ; screen_id
 655+ 9074 3A 02 83         LD A, (CurrentScreenY)
 656+ 9077 07               RLCA
 657+ 9078 07               RLCA
 658+ 9079 07               RLCA
 659+ 907A 07               RLCA
 660+ 907B 21 01 83         LD HL, CurrentScreenX
 661+ 907E 86               ADD A, (HL)
 662+ 907F 32 B3 97         LD (MaiGapScreenId), A
 663+ 9082
 664+ 9082                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 665+ 9082 F3               DI
 666+ 9083
 667+ 9083 3A 7B 8D         LD A, (CurrentPaging)
 668+ 9086 E6 F8            AND $F8
 669+ 9088 F6 06            OR 6
 670+ 908A 32 7B 8D         LD (CurrentPaging), A
 671+ 908D 01 FD 7F         LD BC, $7FFD
 672+ 9090 ED 79            OUT (C), A
 673+ 9092
 674+ 9092                  ; HL = pointer al record
 675+ 9092 3A B3 97         LD A, (MaiGapScreenId)
 676+ 9095 6F               LD L, A
 677+ 9096 26 00            LD H, 0
