6822+ C878              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6823+ C878              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6824+ C878              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6825+ C878              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6826+ C878              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6827+ C878              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6828+ C878              DeathGhostChase:
6829+ C878                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6830+ C878 3A 4E 81         LD A, (EntityTable + ENT_POSX)
6831+ C87B DD 96 03         SUB (IX+ENT_POSX)
6832+ C87E 30 02            JR NC, .udgAbsDxOk
6833+ C880 ED 44            NEG
6834+ C882              .udgAbsDxOk:
6835+ C882 47               LD B, A                             ; B = |dx|
6836+ C883 3A 4F 81         LD A, (EntityTable + ENT_POSY)
6837+ C886 DD 96 04         SUB (IX+ENT_POSY)
6838+ C889 30 02            JR NC, .udgAbsDyOk
6839+ C88B ED 44            NEG
6840+ C88D              .udgAbsDyOk:
6841+ C88D                  ; A = |dy|, B = |dx|
6842+ C88D B8               CP B
6843+ C88E 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6844+ C890
6845+ C890                  ; --- Eje X primario ---
6846+ C890 AF               XOR A
6847+ C891 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6848+ C894 3A 4E 81         LD A, (EntityTable + ENT_POSX)
6849+ C897 DD 96 03         SUB (IX+ENT_POSX)
6850+ C89A 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6851+ C89C 3E 04            LD A, DEATH_GHOST_SPEED
6852+ C89E 30 02            JR NC, .udgXSet
6853+ C8A0 3E FC            LD A, -DEATH_GHOST_SPEED
6854+ C8A2              .udgXSet:
6855+ C8A2 DD 77 06         LD (IX+ENT_DELTAX), A
6856+ C8A5 DD 86 03         ADD A, (IX+ENT_POSX)
6857+ C8A8 DD 77 03         LD (IX+ENT_POSX), A
6858+ C8AB 18 1B            JR .udgAnim
6859+ C8AD
6860+ C8AD                  ; --- Eje Y primario ---
6861+ C8AD              .udgVertPrim:
6862+ C8AD AF               XOR A
6863+ C8AE DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6864+ C8B1 3A 4F 81         LD A, (EntityTable + ENT_POSY)
6865+ C8B4 DD 96 04         SUB (IX+ENT_POSY)
6866+ C8B7 28 0F            JR Z, .udgAnim
6867+ C8B9 3E 04            LD A, DEATH_GHOST_SPEED
6868+ C8BB 30 02            JR NC, .udgYSet
6869+ C8BD 3E FC            LD A, -DEATH_GHOST_SPEED
6870+ C8BF              .udgYSet:
6871+ C8BF DD 77 07         LD (IX+ENT_DELTAY), A
6872+ C8C2 DD 86 04         ADD A, (IX+ENT_POSY)
6873+ C8C5 DD 77 04         LD (IX+ENT_POSY), A
6874+ C8C8              .udgAnim:
6875+ C8C8                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6876+ C8C8                  ; ser despawneada por una de tres condiciones externas:
6877+ C8C8                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6878+ C8C8                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6879+ C8C8                  ;   3. Player cambia de pantalla (screen_system reset)
6880+ C8C8                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6881+ C8C8                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6882+ C8C8                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6883+ C8C8 C3 CB C8         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6884+ C8CB
6885+ C8CB              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6886+ C8CB              ; Llamada por:
6887+ C8CB              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6888+ C8CB              ;   - UpdateDeath en frame skip (sin movimiento).
6889+ C8CB              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6890+ C8CB              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6891+ C8CB              DeathAnimate:
6892+ C8CB DD 7E 06         LD A, (IX+ENT_DELTAX)
6893+ C8CE B7               OR A
6894+ C8CF 28 0A            JR Z, .daKeepDir
6895+ C8D1 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6896+ C8D3 CB 7F            BIT 7, A
6897+ C8D5 28 0D            JR Z, .daDir
6898+ C8D7 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6899+ C8D9 18 09            JR .daDir
6900+ C8DB              .daKeepDir:
