 641+ 907A              ; ==============================================================================
 642+ 907A              ; MaiPickRandomGapOnSide
 643+ 907A              ; ==============================================================================
 644+ 907A              ; Variante de MaiPickRandomGap que filtra por side concreto (N/S/W/E).
 645+ 907A              ; Usado por Regla 2 (follow al cambiar room) para que los monsters entren
 646+ 907A              ; por el mismo borde que uso el player.
 647+ 907A              ;
 648+ 907A              ; IN:  A = side deseado (MAI_SIDE_N/S/W/E)
 649+ 907A              ; OUT: A = 0 ok (MaiSpawnX/Y llenos); A = 1 sin gaps en ese side → fallback
 650+ 907A              ; ==============================================================================
 651+ 907A              MaiPickRandomGapOnSide:
 652+ 907A 32 C0 97         LD (MaiGapWantSide), A
 653+ 907D
 654+ 907D                  ; screen_id
 655+ 907D 3A 0B 83         LD A, (CurrentScreenY)
 656+ 9080 07               RLCA
 657+ 9081 07               RLCA
 658+ 9082 07               RLCA
 659+ 9083 07               RLCA
 660+ 9084 21 0A 83         LD HL, CurrentScreenX
 661+ 9087 86               ADD A, (HL)
 662+ 9088 32 BC 97         LD (MaiGapScreenId), A
 663+ 908B
 664+ 908B                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 665+ 908B F3               DI
 666+ 908C
 667+ 908C 3A 84 8D         LD A, (CurrentPaging)
 668+ 908F E6 F8            AND $F8
 669+ 9091 F6 06            OR 6
 670+ 9093 32 84 8D         LD (CurrentPaging), A
 671+ 9096 01 FD 7F         LD BC, $7FFD
 672+ 9099 ED 79            OUT (C), A
 673+ 909B
 674+ 909B                  ; HL = pointer al record
 675+ 909B 3A BC 97         LD A, (MaiGapScreenId)
 676+ 909E 6F               LD L, A
 677+ 909F 26 00            LD H, 0
