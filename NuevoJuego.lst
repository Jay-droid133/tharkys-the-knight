2385+ D928              ; ==============================================================================
2386+ D928              ; CheckBumpTriggers - cada frame, si player AABB toca un sprite bump-trigger
2387+ D928              ; ==============================================================================
2388+ D928              ; en la pantalla actual y tiene la key correcta, dispara la acción.
2389+ D928              ; Player AABB = 16×16 en (EntityTable[ENT_POSX/POSY]).
2390+ D928              ; Sprite AABB se extiende +1 pixel en cada lado para detectar "pegado".
2391+ D928              ; Como los chars del sprite son walls (vía WallAlwaysTable), el player nunca
2392+ D928              ; se solapa físicamente con él — solo puede estar pegado por algún borde.
2393+ D928              ; ==============================================================================
2394+ D928              CheckBumpTriggers:
2395+ D928 21 96 E0         LD HL, PickupTable
2396+ D92B              .cbtLoop:
2397+ D92B 7E               LD A, (HL)
2398+ D92C FE FF            CP $FF
2399+ D92E C8               RET Z
2400+ D92F FE FE            CP $FE
2401+ D931 CA 90 DA         JP Z, .cbtSkipInactive
2402+ D934 47               LD B, A                         ; mapX
2403+ D935 23               INC HL
2404+ D936 3A 10 83         LD A, (CurrentScreenX)
2405+ D939 B8               CP B
2406+ D93A C2 89 DA         JP NZ, .cbtSkipMapY
2407+ D93D 4E               LD C, (HL)                      ; mapY
2408+ D93E 23               INC HL
2409+ D93F 3A 11 83         LD A, (CurrentScreenY)
2410+ D942 B9               CP C
2411+ D943 C2 82 DA         JP NZ, .cbtSkipPtr
2412+ D946                  ; Pantalla actual: leer ptr
2413+ D946 E5               PUSH HL                         ; entry en ptr_lo
2414+ D947 5E               LD E, (HL)
2415+ D948 23               INC HL
2416+ D949 56               LD D, (HL)                      ; DE = ptr
2417+ D94A CD 86 D8         CALL LookupBumpTrigger          ; A = action, C = key
2418+ D94D B7               OR A
2419+ D94E CA 81 DA         JP Z, .cbtPopNext               ; no es bump-trigger
2420+ D951 32 9B DA         LD (.cbtAction), A              ; salvar action (B se reusa abajo)
2421+ D954 3A B6 82         LD A, (CurrentKey)
2422+ D957 B9               CP C
2423+ D958 C2 81 DA         JP NZ, .cbtPopNext              ; sin la key correcta
2424+ D95B                  ; Match: cargar sprite para conocer dimensiones y testear AABB.
