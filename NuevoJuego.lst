2633+ B0BF 47               LD B, A
2634+ B0C0 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2635+ B0C3 FE 34            CP SPRID_ENEMY_5
2636+ B0C5 78               LD A, B
2637+ B0C6 20 06            JR NZ, .eAnimDelaySet
2638+ B0C8 CB 3F            SRL A                               ; Rata: mitad del delay
2639+ B0CA B7               OR A
2640+ B0CB 20 01            JR NZ, .eAnimDelaySet
2641+ B0CD 3C               INC A                               ; Minimo 1
2642+ B0CE              .eAnimDelaySet:
2643+ B0CE DD 77 09         LD (IX+ENT_ANIMTIMER), A
