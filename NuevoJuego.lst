5509+ BD58 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5510+ BD59 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5511+ BD5A 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5512+ BD5B 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5513+ BD5C 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5514+ BD5D 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5515+ BD5E 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5516+ BD5F
5517+ BD5F              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5518+ BD5F              PredatorSpeedTable:
5519+ BD5F 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5520+ BD60 02               DEFB 2                              ; Ciclo 1: lento
5521+ BD61 03               DEFB 3                              ; Ciclo 2: intermedio
5522+ BD62 04               DEFB 4                              ; Ciclo 3+: rapido
5523+ BD63
5524+ BD63 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5525+ BD64
5526+ BD64 47 BD        CurrentNastyTable: DEFW DiurnalTypeTable
