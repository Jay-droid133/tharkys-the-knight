1266+ F040 C1               POP BC                              ; B=charX, C=charY
1267+ F041
1268+ F041                  ; Restore attrs: D=height_chars, E=width_chars
1269+ F041 21 FD 86         LD HL, BgSpriteBuffer
1270+ F044 7E               LD A, (HL)                          ; height_px
1271+ F045 0F               RRCA
1271+ F046 0F             RRCA
1271+ F047 0F             RRCA
1272+ F048 E6 1F            AND $1F
1273+ F04A 57               LD D, A
1274+ F04B 23               INC HL
1275+ F04C 7E               LD A, (HL)
1276+ F04D E6 7F            AND $7F
1277+ F04F 5F               LD E, A
1278+ F050 CD 5E 6C         CALL RestorePickupAttrs_B7
1279+ F053
1280+ F053                  ; Mark inactive
1281+ F053 3E FE            LD A, $FE
1282+ F055 32 B4 5F         LD (RandomSynthMapX), A
1283+ F058
1284+ F058                  ; Dispatch semantico via RP_CurRolled. Guardamos su valor ANTES de
1285+ F058                  ; resetear (la lista de variantes de health/stamina hace que el ptr
1286+ F058                  ; ya no sea univoco para identificar el tipo).
1287+ F058 3A D0 5F         LD A, (RP_CurRolled)
1288+ F05B 47               LD B, A                             ; B = rolled type saved
1289+ F05C                  ; Invalidar memoria cache: pickup consumido en esta sala. Al volver
1290+ F05C                  ; (cache hit en prev) restauraremos rolled=NONE → no respawnea.
1291+ F05C AF               XOR A
