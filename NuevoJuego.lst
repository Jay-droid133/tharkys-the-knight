4575+ BB64 11 01 5D         LD DE, ZoneCellList
4576+ BB67 19               ADD HL, DE
4577+ BB68 7E               LD A, (HL)                          ; cx (ya filtrado Manhattan en BuildZoneCellList)
4578+ BB69 87               ADD A, A
4579+ BB6A 87               ADD A, A
4580+ BB6B 87               ADD A, A                            ; cx*8
4581+ BB6C DD 77 03         LD (IX+ENT_POSX), A
4582+ BB6F 23               INC HL
4583+ BB70 7E               LD A, (HL)                          ; cy
4584+ BB71 87               ADD A, A
4585+ BB72 87               ADD A, A
4586+ BB73 87               ADD A, A                            ; cy*8
4587+ BB74 C6 10            ADD A, SCREEN_MIN_Y
4588+ BB76 DD 77 04         LD (IX+ENT_POSY), A
4589+ BB79 18 32            JR .spwPosSet
4590+ BB7B              .spwRandomXY:
4591+ BB7B                  ; Mezclar R con semilla rotante para dispersar posiciones entre spawns
4592+ BB7B 3A 9A BC         LD A, (.spawnSeed)
4593+ BB7E C6 49            ADD A, 73                   ; Avanzar semilla (primo, buena dispersion)
4594+ BB80 32 9A BC         LD (.spawnSeed), A
4595+ BB83 47               LD B, A
4596+ BB84 ED 5F            LD A, R
4597+ BB86 A8               XOR B                       ; Mezclar semilla con R
4598+ BB87 E6 F8            AND $F8                     ; Multiplos de 8
4599+ BB89 C6 10            ADD A, 16
4600+ BB8B FE D8            CP SCREEN_MAX_X - 16
