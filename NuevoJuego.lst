 115+ 84A6              .shiftedByte:
 116+ 84A6                  ; === Inner loop fiel al original ($BA0D) ===
 117+ 84A6 1A               LD A, (DE)                  ; Leer byte de sprite
 118+ 84A7 4F               LD C, A                     ; C = byte value (indice en tabla)
 119+ 84A8 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 120+ 84A9 AE               XOR (HL)                    ; XOR con VRAM
 121+ 84AA 77               LD (HL), A                  ; Escribir
 122+ 84AB 2C               INC L                       ; Siguiente columna VRAM
 123+ 84AC 04               INC B                       ; Pagina overflow
 124+ 84AD 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 125+ 84AE AE               XOR (HL)                    ; XOR con VRAM
 126+ 84AF 77               LD (HL), A                  ; Escribir
 127+ 84B0 05               DEC B                       ; Restaurar pagina high
 128+ 84B1 13               INC DE                      ; Siguiente byte de sprite
 129+ 84B2                  ; Siguiente byte de ancho
 130+ 84B2 3A CE 84         LD A, (.widthCount)
 131+ 84B5 3D               DEC A
 132+ 84B6 32 CE 84         LD (.widthCount), A
 133+ 84B9 20 EB            JR NZ, .shiftedByte
