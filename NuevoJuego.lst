 540+ ECA8 7E               LD A, (HL)
 541+ ECA9 23               INC HL
 542+ ECAA 66               LD H, (HL)
 543+ ECAB 6F               LD L, A             ; HL = puntero a datos de línea
 544+ ECAC
 545+ ECAC              .pixLoop:
 546+ ECAC 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ ECAD B7               OR A
 548+ ECAE C8               RET Z
 549+ ECAF 57               LD D, A
 550+ ECB0 23               INC HL
 551+ ECB1 7E               LD A, (HL)          ; VRAM L
 552+ ECB2 23               INC HL
 553+ ECB3 5F               LD E, A
 554+ ECB4 7E               LD A, (HL)          ; mask
 555+ ECB5 23               INC HL
