3778+ A7BA 79               LD A, C
3779+ A7BB 3D               DEC A
3780+ A7BC 32 6D A8         LD (.spawnH1), A
3781+ A7BF
3782+ A7BF                  ; Posicion aleatoria (con reintentos)
3783+ A7BF 3E 03            LD A, 3
3784+ A7C1 32 6B A8         LD (.spawnTries), A
3785+ A7C4
3786+ A7C4              .spawnRetry:
3787+ A7C4                  ; Mezclar R con semilla rotante para dispersar posiciones entre spawns
3788+ A7C4 3A 6E A8         LD A, (.spawnSeed)
3789+ A7C7 C6 49            ADD A, 73                   ; Avanzar semilla (primo, buena dispersion)
3790+ A7C9 32 6E A8         LD (.spawnSeed), A
3791+ A7CC 47               LD B, A
3792+ A7CD ED 5F            LD A, R
3793+ A7CF A8               XOR B                       ; Mezclar semilla con R
3794+ A7D0 E6 F8            AND $F8                     ; Multiplos de 8
3795+ A7D2 C6 10            ADD A, 16
