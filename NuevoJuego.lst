 376  A106                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A106              ; ==============================================================================
   2+ A106              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A106              ; ==============================================================================
   4+ A106              ; - Estructura de entidad de 12 bytes (universal)
   5+ A106              ; - Game loop per-entity: erase → update → draw
   6+ A106              ; - Movimiento 8-bit (sin subpixel)
   7+ A106              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A106              ; - XOR draw/erase (una sola rutina)
   9+ A106              ; ==============================================================================
  10+ A106
  11+ A106              ; ==============================================================================
  12+ A106              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A106              ; ==============================================================================
  14+ A106              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A106              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A106              ; ==============================================================================
  17+ A106              ReadInput:
  18+ A106 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A108 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A10A
  21+ A10A                  ; -- 1. QAOP --
  22+ A10A 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A10D ED 78            IN A, (C)
  24+ A10F CB 47            BIT 0, A            ; Q = Arriba
  25+ A111 20 02            JR NZ, .no_q
  26+ A113 CB C2            SET 0, D
  27+ A115              .no_q:
  28+ A115 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A118 ED 78            IN A, (C)
  30+ A11A CB 47            BIT 0, A            ; A = Abajo
  31+ A11C 20 02            JR NZ, .no_a
  32+ A11E CB CA            SET 1, D
  33+ A120              .no_a:
  34+ A120 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A123 ED 78            IN A, (C)
  36+ A125 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A127 20 02            JR NZ, .no_o
  38+ A129 CB DA            SET 3, D
  39+ A12B              .no_o:
  40+ A12B CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A12D 20 02            JR NZ, .no_p
  42+ A12F CB D2            SET 2, D
  43+ A131              .no_p:
  44+ A131
  45+ A131                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A131                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A131 DB 1F            IN A, (31)
  48+ A133 4F               LD C, A             ; guardar para fire
  49+ A134 CB 5F            BIT 3, A            ; Up
  50+ A136 28 02            JR Z, .no_k_up
  51+ A138 CB C2            SET 0, D
  52+ A13A              .no_k_up:
  53+ A13A CB 57            BIT 2, A            ; Down
  54+ A13C 28 02            JR Z, .no_k_down
  55+ A13E CB CA            SET 1, D
  56+ A140              .no_k_down:
  57+ A140 CB 4F            BIT 1, A            ; Left
  58+ A142 28 02            JR Z, .no_k_left
  59+ A144 CB DA            SET 3, D
  60+ A146              .no_k_left:
  61+ A146 CB 47            BIT 0, A            ; Right
  62+ A148 28 02            JR Z, .no_k_right
  63+ A14A CB D2            SET 2, D
  64+ A14C              .no_k_right:
  65+ A14C CB 61            BIT 4, C            ; Kempston Fire
  66+ A14E 28 02            JR Z, .no_k_fire
  67+ A150 CB C3            SET 0, E
  68+ A152              .no_k_fire:
  69+ A152
  70+ A152                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A152                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A152 01 FE F7         LD BC, $F7FE
  73+ A155 ED 78            IN A, (C)
  74+ A157 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A159 20 02            JR NZ, .no_s1_up
  76+ A15B CB C2            SET 0, D
  77+ A15D              .no_s1_up:
  78+ A15D CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A15F 20 02            JR NZ, .no_s1_down
  80+ A161 CB CA            SET 1, D
  81+ A163              .no_s1_down:
  82+ A163 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A165 20 02            JR NZ, .no_s1_left
  84+ A167 CB DA            SET 3, D
  85+ A169              .no_s1_left:
  86+ A169 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A16B 20 02            JR NZ, .no_s1_right
  88+ A16D CB D2            SET 2, D
  89+ A16F              .no_s1_right:
  90+ A16F CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A171 20 02            JR NZ, .no_s1_fire
  92+ A173 CB C3            SET 0, E
  93+ A175              .no_s1_fire:
  94+ A175
  95+ A175                  ; -- 4. SPACE = Fire (teclado) --
  96+ A175 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A178 ED 78            IN A, (C)
  98+ A17A CB 47            BIT 0, A            ; SPACE
  99+ A17C 20 02            JR NZ, .no_space
 100+ A17E CB C3            SET 0, E
 101+ A180              .no_space:
 102+ A180
 103+ A180                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A180 7B               LD A, E
 105+ A181 32 5C 82         LD (InputFire), A
 106+ A184
 107+ A184                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ A184 21 80 82         LD HL, MushroomLockTimer
 109+ A187 7E               LD A, (HL)
 110+ A188 23               INC HL
 111+ A189 B6               OR (HL)
 112+ A18A 28 21            JR Z, .noMushLock
 113+ A18C AF               XOR A
 114+ A18D 32 5C 82         LD (InputFire), A
 115+ A190                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ A190                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ A190 7B               LD A, E
 118+ A191 B7               OR A
 119+ A192 28 15            JR Z, .resetNoSwordFlag
 120+ A194 3A 65 82         LD A, (NoSwordSoundFlag)
 121+ A197 B7               OR A
 122+ A198 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ A19A 3E 01            LD A, 1
 124+ A19C 32 65 82         LD (NoSwordSoundFlag), A
 125+ A19F D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ A1A0 21 88 FA         LD HL, SFX_NoSwordError
 127+ A1A3 CD 4F F9         CALL PlaySFX
 128+ A1A6 D1               POP DE
 129+ A1A7 18 04            JR .noMushLock
 130+ A1A9              .resetNoSwordFlag:
 131+ A1A9 AF               XOR A
 132+ A1AA 32 65 82         LD (NoSwordSoundFlag), A
 133+ A1AD              .noMushLock:
 134+ A1AD
 135+ A1AD                  ; -- 6. Cancelar opuestos --
 136+ A1AD 7A               LD A, D
 137+ A1AE 47               LD B, A
 138+ A1AF E6 03            AND DIR_N | DIR_S
 139+ A1B1 FE 03            CP DIR_N | DIR_S
 140+ A1B3 20 04            JR NZ, .noVC
 141+ A1B5 78               LD A, B
 142+ A1B6 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ A1B8 47               LD B, A
 144+ A1B9              .noVC:
 145+ A1B9 78               LD A, B
 146+ A1BA E6 0C            AND DIR_E | DIR_W
 147+ A1BC FE 0C            CP DIR_E | DIR_W
 148+ A1BE 20 04            JR NZ, .noHC
 149+ A1C0 78               LD A, B
 150+ A1C1 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ A1C3 47               LD B, A
 152+ A1C4              .noHC:
 153+ A1C4 78               LD A, B
 154+ A1C5 32 5B 82         LD (InputDirection), A
 155+ A1C8 C9               RET
 156+ A1C9
 157+ A1C9              ; ==============================================================================
 158+ A1C9              ; InitEntities - Inicializa la tabla de entidades
 159+ A1C9              ; ==============================================================================
 160+ A1C9              ; Limpia todos los slots y configura el slot 0 como player.
 161+ A1C9              ; ==============================================================================
 162+ A1C9              InitEntities:
 163+ A1C9                  ; Limpiar toda la tabla a ceros
 164+ A1C9 21 4B 81         LD HL, EntityTable
 165+ A1CC 11 4C 81         LD DE, EntityTable + 1
 166+ A1CF 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ A1D2 AF               XOR A
 168+ A1D3 77               LD (HL), A
 169+ A1D4 ED B0            LDIR
 170+ A1D6
 171+ A1D6                  ; Limpiar tabla de atributos salvados
 172+ A1D6 21 23 9F         LD HL, SavedAttrTable
 173+ A1D9 11 24 9F         LD DE, SavedAttrTable + 1
 174+ A1DC 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ A1DF AF               XOR A
 176+ A1E0 77               LD (HL), A
 177+ A1E1 ED B0            LDIR
 178+ A1E3
 179+ A1E3                  ; Configurar slot 0: Player
 180+ A1E3 DD 21 4B 81      LD IX, EntityTable
 181+ A1E7 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ A1EB DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ A1EF DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ A1F3 DD 36 03 A0      LD (IX+ENT_POSX), START_PLAYER_X
 185+ A1F7 DD 36 04 40      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ A1FB DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ A1FF DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ A203 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ A207 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ A20B DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ A20F DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ A213 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ A217 DD 36 0C A0      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ A21B DD 36 0D 40      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ A21F DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ A223 DD 36 0F A0      LD (IX+ENT_DRAWX), START_PLAYER_X
 197+ A227
 198+ A227                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ A227 3E 0C            LD A, SPAWN_INTERVAL
 200+ A229 32 9B 82         LD (SpawnTimer), A
 201+ A22C AF               XOR A
 202+ A22D 32 A8 82         LD (EnemyStepIdx), A
 203+ A230 32 7B 5F         LD (PendingEraseCount), A
 204+ A233 C9               RET
 205+ A234
 206+ A234              ; ==============================================================================
 207+ A234              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ A234              ; ==============================================================================
 209+ A234              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ A234              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ A234              ; que los pies parezcan hundirse en el suelo.
 212+ A234              ; ==============================================================================
 213+ A234              ComputePlayerDrawY:
 214+ A234 3A 4E 81         LD A, (EntityTable + ENT_POSX)
 215+ A237 C6 08            ADD A, 8                    ; center X del player
 216+ A239 47               LD B, A
 217+ A23A 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 218+ A23D 4F               LD C, A
 219+ A23E 32 82 82         LD (PlayerDrawY), A         ; default: sin offset
 220+ A241 B7               OR A
 221+ A242 C8               RET Z
 222+ A243 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 223+ A244 CD 5B D8         CALL IsPointBlocked
 224+ A247 C8               RET Z                       ; libre → sin offset
 225+ A248 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 226+ A24B 3C               INC A
 227+ A24C 32 82 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 228+ A24F C9               RET
 229+ A250
 230+ A250              ; ==============================================================================
 231+ A250              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 232+ A250              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 233+ A250              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 234+ A250              ; no parecer que se hunde en el techo.
 235+ A250              ; Preserva: IX. Destruye: AF, BC.
 236+ A250              ; ==============================================================================
 237+ A250              ComputeEnemyDrawY:
 238+ A250 DD 7E 04         LD A, (IX+ENT_POSY)
 239+ A253 32 83 82         LD (EnemyDrawY), A          ; default = POSY
 240+ A256 DD 7E 01         LD A, (IX+ENT_TYPE)
 241+ A259 FE 02            CP TYPE_MONSTER
 242+ A25B C0               RET NZ                      ; no monster → sin offset
 243+ A25C DD 7E 03         LD A, (IX+ENT_POSX)
 244+ A25F C6 08            ADD A, 8                    ; center X
 245+ A261 47               LD B, A
 246+ A262 DD 7E 04         LD A, (IX+ENT_POSY)
 247+ A265 4F               LD C, A
 248+ A266 B7               OR A
 249+ A267 C8               RET Z
 250+ A268 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 251+ A269 CD 5B D8         CALL IsPointBlocked
 252+ A26C C8               RET Z                       ; libre → sin offset
 253+ A26D DD 7E 04         LD A, (IX+ENT_POSY)
 254+ A270 3C               INC A
 255+ A271 32 83 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 256+ A274 C9               RET
 257+ A275
 258+ A275              ; ==============================================================================
 259+ A275              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 260+ A275              ; ==============================================================================
 261+ A275              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 262+ A275              ; ==============================================================================
 263+ A275              ProcessPlayer:
 264+ A275 DD 21 4B 81      LD IX, EntityTable
 265+ A279
 266+ A279                  ; --- Fresh check ---
 267+ A279 3A B8 82         LD A, (ScreenJustRedrawn)
 268+ A27C B7               OR A
 269+ A27D C2 49 A3         JP NZ, .plFresh
 270+ A280 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 271+ A284 C2 49 A3         JP NZ, .plFresh
 272+ A287
 273+ A287                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 274+ A287                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 275+ A287                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 276+ A287                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 277+ A287                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 278+ A287                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 279+ A287                  ; y UpdatePlayerAnimation lo sobrescribiria.
 280+ A287 3A 8D 82         LD A, (DeathBorderPhase)
 281+ A28A B7               OR A
 282+ A28B 20 0A            JR NZ, .plSkipUpdate
 283+ A28D 3A 91 82         LD A, (PlayerRespawnPhase)
 284+ A290 FE 01            CP 1
 285+ A292 28 03            JR Z, .plSkipUpdate
 286+ A294 CD 9F A8         CALL UpdatePlayer
 287+ A297              .plSkipUpdate:
 288+ A297 CD B8 A7         CALL CalcDrawX
 289+ A29A CD 34 A2         CALL ComputePlayerDrawY
 290+ A29D
 291+ A29D                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 292+ A29D DD 7E 0F         LD A, (IX+ENT_DRAWX)
 293+ A2A0 DD BE 0C         CP (IX+ENT_OLDX)
 294+ A2A3 20 3C            JR NZ, .plDoErase
 295+ A2A5 3A 82 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 296+ A2A8 DD BE 0D         CP (IX+ENT_OLDY)
 297+ A2AB 20 34            JR NZ, .plDoErase
 298+ A2AD DD 7E 00         LD A, (IX+ENT_SPRITEID)
 299+ A2B0 DD BE 0E         CP (IX+ENT_OLDSPRID)
 300+ A2B3 20 2C            JR NZ, .plDoErase
 301+ A2B5                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 302+ A2B5 3A 00 C8         LD A, (PlayerHitTimer)
 303+ A2B8 B7               OR A
 304+ A2B9 20 01            JR NZ, .plRepaintAttr
