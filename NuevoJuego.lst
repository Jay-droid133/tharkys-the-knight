6884+ C566              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6885+ C566              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6886+ C566              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6887+ C566              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6888+ C566              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6889+ C566              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6890+ C566              DeathGhostChase:
6891+ C566                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6892+ C566 3A 9E 81         LD A, (EntityTable + ENT_POSX)
6893+ C569 DD 96 03         SUB (IX+ENT_POSX)
6894+ C56C 30 02            JR NC, .udgAbsDxOk
6895+ C56E ED 44            NEG
6896+ C570              .udgAbsDxOk:
6897+ C570 47               LD B, A                             ; B = |dx|
6898+ C571 3A 9F 81         LD A, (EntityTable + ENT_POSY)
6899+ C574 DD 96 04         SUB (IX+ENT_POSY)
6900+ C577 30 02            JR NC, .udgAbsDyOk
6901+ C579 ED 44            NEG
6902+ C57B              .udgAbsDyOk:
6903+ C57B                  ; A = |dy|, B = |dx|
6904+ C57B B8               CP B
6905+ C57C 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6906+ C57E
6907+ C57E                  ; --- Eje X primario ---
