  89+ 9D7B C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9D7C D8               RET C                       ; Idem
  91+ 9D7D 32 0F 9E         LD (.heightSave), A
  92+ 9D80                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9D80 3A 0E 9E         LD A, (.widthSave)
  94+ 9D83 4F               LD C, A
  95+ 9D84              .clipSkipRow:
  96+ 9D84 79               LD A, C
  97+ 9D85              .clipSkipByte:
  98+ 9D85 DD 23            INC IX
