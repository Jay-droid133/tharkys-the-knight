 276+ 732A              ; ==============================================================================
 277+ 732A              ; PaintMagicCompassAttrs - Pinta los 4 chars del HUD compass en modo magic
 278+ 732A              ; ==============================================================================
 279+ 732A              ; Color base lo decide el editor (sprite id 36, attrBytes). El runtime lo
 280+ 732A              ; lee de MagicCompassBaseAttrs (auto-importado por import_magic_compass_hud.py
 281+ 732A              ; con bit 6 BRIGHT clearado) y aplica BRIGHT solo al char correspondiente
 282+ 732A              ; a la PathDir. Durante los últimos 5 s ese bright parpadea on/off a ~6 Hz.
 283+ 732A              ;
 284+ 732A              ; Mapping diagonal de las 4 esquinas del 2x2:
 285+ 732A              ;   col1   col2
 286+ 732A              ;     W      N    (row 1, top)     ← idx 0 (1,1) | idx 1 (2,1)
 287+ 732A              ;     S      E    (row 2, bottom)  ← idx 2 (1,2) | idx 3 (2,2)
 288+ 732A              ;
 289+ 732A              ;   PathDir 0 (N) → idx 1 → offset +1
 290+ 732A              ;   PathDir 1 (S) → idx 2 → offset +$20
 291+ 732A              ;   PathDir 2 (W) → idx 0 → offset +0
 292+ 732A              ;   PathDir 3 (E) → idx 3 → offset +$21
 293+ 732A              ;
 294+ 732A              ; Destruye: AF, BC, DE, HL.
 295+ 732A              ; ==============================================================================
 296+ 732A              PaintMagicCompassAttrs:
 297+ 732A                  ; Pintar 4 chars con MagicCompassBaseAttrs (orden: 1,1 / 2,1 / 1,2 / 2,2)
 298+ 732A 11 3B 76         LD DE, MagicCompassBaseAttrs
 299+ 732D 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
