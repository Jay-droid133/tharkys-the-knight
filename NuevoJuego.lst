 474+ F055              ; ==============================================================================
 475+ F055              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F055              ; ==============================================================================
 477+ F055              DrawCompass:
 478+ F055                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F055 3A BB 82         LD A, (ObjectiveScreenX)
 480+ F058 FE FF            CP $FF
 481+ F05A CA FC F1         JP Z, ClearCompass
 482+ F05D
 483+ F05D                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F05D                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F05D                  ; reflejar la dir del path al cambiar de sala).
 486+ F05D 3A 0B 83         LD A, (CurrentScreenX)
 487+ F060 47               LD B, A
 488+ F061 3A BE 82         LD A, (LastCompassScreenX)
 489+ F064 B8               CP B
 490+ F065 C2 8B F0         JP NZ, .dcRedrawNewScreen
 491+ F068 3A 0C 83         LD A, (CurrentScreenY)
 492+ F06B 47               LD B, A
 493+ F06C 3A BF 82         LD A, (LastCompassScreenY)
 494+ F06F B8               CP B
 495+ F070 C2 8B F0         JP NZ, .dcRedrawNewScreen
 496+ F073 3A BD 82         LD A, (PreviousObjectiveDistance)
 497+ F076 FE FF            CP $FF
 498+ F078 28 16            JR Z, .dcRedraw
 499+ F07A 3A C0 82         LD A, (CompassWobbleCounter)
 500+ F07D B7               OR A
 501+ F07E 20 10            JR NZ, .dcRedraw
 502+ F080                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F080                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F080 3A BF 5F         LD A, (MagicCompassTimer)
