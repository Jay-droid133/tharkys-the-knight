 503  F924                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 504  F924                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F924              ; ==============================================================================
   2+ F924              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F924              ; ==============================================================================
   4+ F924              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F924              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F924              ;
   7+ F924              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F924              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F924              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F924              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F924              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F924              ; ==============================================================================
  13+ F924
  14+ F924              ; ==============================================================================
  15+ F924              ; PlaySFX - Reproduce un efecto de sonido
  16+ F924              ; ==============================================================================
  17+ F924              ; Entrada: HL = puntero a datos del efecto
  18+ F924              ; Modifica: AF, BC, DE, HL
  19+ F924              ; ==============================================================================
  20+ F924              PlaySFX:
  21+ F924 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F925 3A 7C 8D         LD A, (CurrentBorderColor)
  23+ F928 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F92A 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F92B
  26+ F92B              .nextStep:
  27+ F92B 7E               LD A, (HL)                  ; Leer duration
  28+ F92C B7               OR A
  29+ F92D 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F92F
  31+ F92F 47               LD B, A                     ; B = duration (bucle externo)
  32+ F930 23               INC HL
  33+ F931 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F932 23               INC HL
  35+ F933 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F934 23               INC HL
  37+ F935 7E               LD A, (HL)                  ; A = flags
  38+ F936 23               INC HL
  39+ F937 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F938 CB 47            BIT 0, A
  41+ F93A 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F93C
  43+ F93C              ; --- Bucle de tono normal ---
  44+ F93C              .toneLoop:
  45+ F93C                  ; Semi-periodo HIGH
  46+ F93C 7B               LD A, E
  47+ F93D F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F93F D3 FE            OUT ($FE), A
  49+ F941 79               LD A, C                     ; A = pitch actual
  50+ F942              .toneDelayHi:
  51+ F942 3D               DEC A
  52+ F943 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F945
  54+ F945                  ; Semi-periodo LOW
  55+ F945 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F946 D3 FE            OUT ($FE), A
  57+ F948 79               LD A, C
  58+ F949              .toneDelayLo:
  59+ F949 3D               DEC A
  60+ F94A 20 FD            JR NZ, .toneDelayLo
  61+ F94C
  62+ F94C                  ; Aplicar pitch sweep
  63+ F94C 79               LD A, C
  64+ F94D 82               ADD A, D                    ; pitch += pitchDelta
  65+ F94E 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F950 FA 58 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F953 4F               LD C, A
  68+ F954              .toneAfterClamp:
  69+ F954 10 E6            DJNZ .toneLoop
  70+ F956 18 30            JR .stepDone
  71+ F958
  72+ F958              .toneClamp:
  73+ F958 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F95A 18 F8            JR .toneAfterClamp
  75+ F95C
  76+ F95C              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F95C              .noiseLoop:
  78+ F95C                  ; Semi-periodo HIGH con ruido
  79+ F95C 7B               LD A, E
  80+ F95D F6 10            OR $10
  81+ F95F D3 FE            OUT ($FE), A
  82+ F961 ED 5F            LD A, R                     ; R register como PRNG
  83+ F963 A9               XOR C                       ; mezclar con pitch base
  84+ F964 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F966 F6 01            OR $01                      ; minimo 1
  86+ F968              .noiseDelayHi:
  87+ F968 3D               DEC A
  88+ F969 20 FD            JR NZ, .noiseDelayHi
  89+ F96B
  90+ F96B                  ; Semi-periodo LOW
  91+ F96B 7B               LD A, E
  92+ F96C D3 FE            OUT ($FE), A
  93+ F96E ED 5F            LD A, R
  94+ F970 A9               XOR C
  95+ F971 E6 1F            AND $1F
  96+ F973 F6 01            OR $01
  97+ F975              .noiseDelayLo:
  98+ F975 3D               DEC A
  99+ F976 20 FD            JR NZ, .noiseDelayLo
 100+ F978
 101+ F978                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F978 79               LD A, C
 103+ F979 82               ADD A, D
 104+ F97A 28 08            JR Z, .noiseClamp
 105+ F97C FA 84 F9         JP M, .noiseClamp
 106+ F97F 4F               LD C, A
 107+ F980              .noiseAfterClamp:
 108+ F980 10 DA            DJNZ .noiseLoop
 109+ F982 18 04            JR .stepDone
 110+ F984
 111+ F984              .noiseClamp:
 112+ F984 0E 01            LD C, 1
 113+ F986 18 F8            JR .noiseAfterClamp
 114+ F988
 115+ F988              .stepDone:
 116+ F988 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F989 18 A0            JR .nextStep
 118+ F98B
 119+ F98B              .done:
 120+ F98B 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F98C D3 FE            OUT ($FE), A
 122+ F98E FB               EI
 123+ F98F C9               RET
 124+ F990
 125+ F990              ; ==============================================================================
 126+ F990              ; DATOS DE EFECTOS DE SONIDO
 127+ F990              ; ==============================================================================
 128+ F990
 129+ F990              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F990              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F990              SFX_FootstepTic:
 132+ F990 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F994 00               DEFB 0                      ; fin
