 791+ F263              ; ==============================================================================
 792+ F263              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 793+ F263              ; ==============================================================================
 794+ F263              ; IN: DE = ptr a 16 filas x 2 bytes
 795+ F263              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 796+ F263              ; Destruye: AF, B, HL.
 797+ F263              ; ==============================================================================
 798+ F263              DrawCompassSprite:
 799+ F263                  ; Char row 0 (rows 0-7 del sprite)
 800+ F263 26 40            LD H, $40
 801+ F265 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 802+ F267 06 08            LD B, 8
 803+ F269              .dcsRow0:
 804+ F269 1A               LD A, (DE)
 805+ F26A 77               LD (HL), A
 806+ F26B 13               INC DE
 807+ F26C 23               INC HL
 808+ F26D 1A               LD A, (DE)
 809+ F26E 77               LD (HL), A
 810+ F26F 13               INC DE
 811+ F270 2B               DEC HL
 812+ F271 24               INC H
 813+ F272 10 F5            DJNZ .dcsRow0
 814+ F274                  ; Char row 1 (rows 8-15 del sprite)
 815+ F274 26 40            LD H, $40
 816+ F276 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F278 06 08            LD B, 8
 818+ F27A              .dcsRow1:
 819+ F27A 1A               LD A, (DE)
 820+ F27B 77               LD (HL), A
 821+ F27C 13               INC DE
 822+ F27D 23               INC HL
 823+ F27E 1A               LD A, (DE)
 824+ F27F 77               LD (HL), A
 825+ F280 13               INC DE
 826+ F281 2B               DEC HL
 827+ F282 24               INC H
 828+ F283 10 F5            DJNZ .dcsRow1
 829+ F285 C9               RET
 830+ F286
 831+ F286              ; ==============================================================================
 832+ F286              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
