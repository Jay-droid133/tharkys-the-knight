 616+ 9DA6 26 00            LD H, 0
 617+ 9DA8 29               ADD HL, HL
 618+ 9DA9 29               ADD HL, HL
 619+ 9DAA 29               ADD HL, HL
 620+ 9DAB 01 00 3C         LD BC, $3C00
 621+ 9DAE 09               ADD HL, BC
 622+ 9DAF
 623+ 9DAF 16 40            LD D, $40
 624+ 9DB1 06 08            LD B, 8
 625+ 9DB3              .charLoop:
 626+ 9DB3 7E               LD A, (HL)
 627+ 9DB4 12               LD (DE), A
 628+ 9DB5 23               INC HL
 629+ 9DB6 14               INC D
 630+ 9DB7 10 FA            DJNZ .charLoop
 631+ 9DB9 C9               RET
