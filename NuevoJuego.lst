 597+ 8B77              ; ==============================================================================
 598+ 8B77              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 599+ 8B77              ; ==============================================================================
 600+ 8B77              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 601+ 8B77              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 602+ 8B77              ; ==============================================================================
 603+ 8B77              GetSpriteAddr:
 604+ 8B77 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 605+ 8B7A 6F               LD L, A
 606+ 8B7B 26 00            LD H, 0
 607+ 8B7D 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 608+ 8B7E 11 98 AD         LD DE, SpriteFrameTable
 609+ 8B81 19               ADD HL, DE
 610+ 8B82 5E               LD E, (HL)
 611+ 8B83 23               INC HL
 612+ 8B84 56               LD D, (HL)
 613+ 8B85 ED 53 8A 8B      LD (SpriteAddrTemp), DE
 614+ 8B89 C9               RET
 615+ 8B8A
 616+ 8B8A 00 00        SpriteAddrTemp: DEFW 0
