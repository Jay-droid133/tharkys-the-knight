 194+ 69A9              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 195+ 69A9              ; ==============================================================================
 196+ 69A9              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 197+ 69A9              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 198+ 69A9              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 199+ 69A9              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 200+ 69A9              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 201+ 69A9              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 202+ 69A9              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 203+ 69A9              ; ==============================================================================
 204+ 69A9              StatueIdTable:
 205+ 69A9 D5               DEFB 213        ; type idx 0: statue_zombi
 206+ 69AA E1               DEFB 225        ; type idx 1: statue_skeleton
 207+ 69AB D3               DEFB 211        ; type idx 2: statue_ghost
