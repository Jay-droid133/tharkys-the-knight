1609+ 90E0
1610+ 90E0 DD 21 62 80      LD IX, EntityTable + (SLOT_IMMORTAL0 * ENT_SIZE)  ; Empezar en slot 1
1611+ 90E4 06 09            LD B, NUM_IMMORTALS + NUM_NASTIES       ; Slots 1-12
1612+ 90E6
1613+ 90E6              .checkLoop:
1614+ 90E6 DD 7E 01         LD A, (IX+ENT_TYPE)
1615+ 90E9 B7               OR A
1616+ 90EA 28 7F            JR Z, .nextEnemy
1617+ 90EC
1618+ 90EC                  ; Skip enemigos muriendo o spawneando (no colisionan)
1619+ 90EC DD 7E 02         LD A, (IX+ENT_STATE)
1620+ 90EF FE 03            CP STATE_DYING
1621+ 90F1 28 78            JR Z, .nextEnemy
1622+ 90F3 FE 04            CP STATE_SPAWNING
1623+ 90F5 28 74            JR Z, .nextEnemy
1624+ 90F7
1625+ 90F7                  ; Obtener dims del enemigo
1626+ 90F7 C5               PUSH BC                     ; salvar loop counter
1627+ 90F8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1628+ 90FB CD 8C 8B         CALL GetSpriteDims          ; B=enemyW, C=enemyH
1629+ 90FE
1630+ 90FE                  ; AABB X: playerX < enemyX + enemyW AND enemyX < playerX + playerW
1631+ 90FE DD 7E 03         LD A, (IX+ENT_POSX)
1632+ 9101 80               ADD A, B                    ; enemyX + enemyW
1633+ 9102 38 07            JR C, .xCheck2             ; overflow → condicion siempre true
1634+ 9104 57               LD D, A
1635+ 9105 3A 55 80         LD A, (EntityTable + ENT_POSX)
1636+ 9108 BA               CP D
1637+ 9109 30 5F            JR NC, .nextEnemyPop       ; playerX >= enemyX + enemyW → no overlap
1638+ 910B
1639+ 910B              .xCheck2:
1640+ 910B 3A 55 80         LD A, (EntityTable + ENT_POSX)
1641+ 910E 57               LD D, A
1642+ 910F 3A 80 91         LD A, (.plW)
1643+ 9112 82               ADD A, D                    ; playerX + playerW
1644+ 9113 38 07            JR C, .yCheck1             ; overflow → condicion siempre true
1645+ 9115 57               LD D, A
1646+ 9116 DD 7E 03         LD A, (IX+ENT_POSX)
1647+ 9119 BA               CP D
1648+ 911A 30 4E            JR NC, .nextEnemyPop       ; enemyX >= playerX + playerW → no overlap
1649+ 911C
1650+ 911C              .yCheck1:
1651+ 911C                  ; AABB Y: playerY < enemyY + enemyH AND enemyY < playerY + playerH
1652+ 911C DD 7E 04         LD A, (IX+ENT_POSY)
1653+ 911F 81               ADD A, C                    ; enemyY + enemyH
1654+ 9120 38 07            JR C, .yCheck2             ; overflow → condicion siempre true
1655+ 9122 57               LD D, A
1656+ 9123 3A 56 80         LD A, (EntityTable + ENT_POSY)
1657+ 9126 BA               CP D
1658+ 9127 30 41            JR NC, .nextEnemyPop       ; playerY >= enemyY + enemyH → no overlap
1659+ 9129
1660+ 9129              .yCheck2:
1661+ 9129 3A 56 80         LD A, (EntityTable + ENT_POSY)
1662+ 912C 57               LD D, A
1663+ 912D 3A 81 91         LD A, (.plH)
1664+ 9130 82               ADD A, D                    ; playerY + playerH
1665+ 9131 38 07            JR C, .collision           ; overflow → condicion siempre true
1666+ 9133 57               LD D, A
1667+ 9134 DD 7E 04         LD A, (IX+ENT_POSY)
1668+ 9137 BA               CP D
1669+ 9138 30 30            JR NC, .nextEnemyPop       ; enemyY >= playerY + playerH → no overlap
1670+ 913A
1671+ 913A              .collision:
1672+ 913A                  ; Colision detectada!
1673+ 913A                  ; Si player esta atacando y enemigo es destructible → matar enemigo
1674+ 913A 3A 54 80         LD A, (EntityTable + ENT_STATE)         ; player state
1675+ 913D FE 02            CP STATE_FIGHTING
1676+ 913F 20 24            JR NZ, .playerHit
1677+ 9141
1678+ 9141                  ; Player atacando → destruir enemigo
1679+ 9141 DD CB 0B 56      BIT ENTF_DESTRUCT, (IX+ENT_FLAGS)
1680+ 9145 28 1E            JR Z, .playerHit               ; No destructible (immortal)
1681+ 9147
1682+ 9147                  ; Matar nasty: iniciar animacion puff
1683+ 9147 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
1684+ 914B DD 36 08 38      LD (IX+ENT_ANIMBASE), SPRID_PUFF
1685+ 914F DD 36 00 38      LD (IX+ENT_SPRITEID), SPRID_PUFF
1686+ 9153 DD 36 09 03      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
1687+ 9157 DD 36 06 00      LD (IX+ENT_DELTAX), 0          ; Parar movimiento
1688+ 915B DD 36 07 00      LD (IX+ENT_DELTAY), 0
1689+ 915F DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40  ; Blanco brillante para el puff
1690+ 9163 18 05            JR .nextEnemyPop
1691+ 9165
1692+ 9165              .playerHit:
1693+ 9165                  ; Enemigo toca al player → flash atributo (feedback visual basico)
1694+ 9165 3E 42            LD A, RED | $40
1695+ 9167 32 57 80         LD (EntityTable + ENT_ATTR), A
1696+ 916A
1697+ 916A              .nextEnemyPop:
