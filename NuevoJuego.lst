7254+ C766              ; ==============================================================================
7255+ C766              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7256+ C766              ; ==============================================================================
7257+ C766              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7258+ C766              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7259+ C766              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7260+ C766              ; el primer paso (N/S/W/E) desde el inicio.
7261+ C766              ;
7262+ C766              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7263+ C766              ; consistente con CheckEnemyCollision en cell-aligned positions).
7264+ C766              ;
7265+ C766              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7266+ C766              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7267+ C766              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7268+ C766              ; paso pero permite llegar a una celda mas profunda con dist menor).
7269+ C766              ;
7270+ C766              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7271+ C766              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7272+ C766              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7273+ C766              ;
7274+ C766              ; IX = SLOT_DEATH al entrar.
7275+ C766              ; ==============================================================================
7276+ C766              DeathBfsRescue:
7277+ C766                  ; --- Celda inicial = celda actual de Death ---
7278+ C766 DD 7E 03         LD A, (IX+ENT_POSX)
7279+ C769 0F               RRCA
7280+ C76A 0F               RRCA
7281+ C76B 0F               RRCA
7282+ C76C E6 1F            AND $1F
7283+ C76E 32 74 5F         LD (DBfsCurCx), A
7284+ C771 DD 7E 04         LD A, (IX+ENT_POSY)
7285+ C774 D6 10            SUB SCREEN_MIN_Y
7286+ C776 0F               RRCA
7287+ C777 0F               RRCA
7288+ C778 0F               RRCA
7289+ C779 E6 1F            AND $1F
7290+ C77B 32 75 5F         LD (DBfsCurCy), A
7291+ C77E                  ; --- Celda del player ---
7292+ C77E 3A A6 81         LD A, (EntityTable + ENT_POSX)
7293+ C781 0F               RRCA
7294+ C782 0F               RRCA
7295+ C783 0F               RRCA
7296+ C784 E6 1F            AND $1F
7297+ C786 32 72 5F         LD (DBfsPlayerCx), A
7298+ C789 3A A7 81         LD A, (EntityTable + ENT_POSY)
7299+ C78C D6 10            SUB SCREEN_MIN_Y
7300+ C78E 0F               RRCA
7301+ C78F 0F               RRCA
7302+ C790 0F               RRCA
7303+ C791 E6 1F            AND $1F
7304+ C793 32 73 5F         LD (DBfsPlayerCy), A
7305+ C796                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7306+ C796 21 FF 5E         LD HL, DBfsQueue
7307+ C799 22 6B 5F         LD (DBfsQHead), HL
7308+ C79C 3A 74 5F         LD A, (DBfsCurCx)
7309+ C79F 77               LD (HL), A
7310+ C7A0 23               INC HL
7311+ C7A1 3A 75 5F         LD A, (DBfsCurCy)
7312+ C7A4 77               LD (HL), A
7313+ C7A5 23               INC HL
7314+ C7A6 36 FF            LD (HL), MAI_DIR_NONE
7315+ C7A8 23               INC HL
7316+ C7A9 36 00            LD (HL), 0
7317+ C7AB 23               INC HL
7318+ C7AC 22 6D 5F         LD (DBfsQTail), HL
