 431  8187                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 432  8187              .frameSync:
 433  8187 76               HALT                        ; Dormir hasta siguiente interrupt
 434  8188 3A 97 81         LD A, (.frameStart)
 435  818B 47               LD B, A
 436  818C 3A 78 5C         LD A, ($5C78)
 437  818F 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 438  8190 FE 02            CP 2
 439  8192 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
