 955+ A760              ; ==============================================================================
 956+ A760              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 957+ A760              ; ==============================================================================
 958+ A760              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 959+ A760              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 960+ A760              ; ==============================================================================
 961+ A760              GetSpriteAddr:
 962+ A760                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
 963+ A760                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
 964+ A760 3A 8F 90         LD A, (CurrentPaging)
 965+ A763 E6 F8            AND $F8
 966+ A765 F6 06            OR 6
 967+ A767 32 8F 90         LD (CurrentPaging), A
 968+ A76A 01 FD 7F         LD BC, $7FFD
 969+ A76D ED 79            OUT (C), A                  ; bank 6 paginado
 970+ A76F DD 7E 00         LD A, (IX+ENT_SPRITEID)
 971+ A772 6F               LD L, A
 972+ A773 26 00            LD H, 0
 973+ A775 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 974+ A776 11 03 E3         LD DE, SpriteFrameTable
 975+ A779 19               ADD HL, DE
 976+ A77A 5E               LD E, (HL)
 977+ A77B 23               INC HL
 978+ A77C 56               LD D, (HL)
 979+ A77D ED 53 8F A7      LD (SpriteAddrTemp), DE
 980+ A781 3A 8F 90         LD A, (CurrentPaging)
 981+ A784 E6 F8            AND $F8
 982+ A786 32 8F 90         LD (CurrentPaging), A
 983+ A789 01 FD 7F         LD BC, $7FFD
 984+ A78C ED 79            OUT (C), A                  ; bank 0 de vuelta
 985+ A78E C9               RET
 986+ A78F
 987+ A78F 00 00        SpriteAddrTemp: DEFW 0
 988+ A791
 989+ A791              ; ==============================================================================
 990+ A791              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
 991+ A791              ; ==============================================================================
 992+ A791              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
 993+ A791              ; Salida:   DE = puntero al sprite data
 994+ A791              ;           OldSprAddr = mismo puntero (conveniencia para caller)
 995+ A791              ; Preserva: IX
 996+ A791              ; Destruye: A, HL
 997+ A791              ; ==============================================================================
 998+ A791              GetOldSpriteAddr:
 999+ A791                  ; Paging inline (ver GetSpriteAddr)
1000+ A791 3A 8F 90         LD A, (CurrentPaging)
1001+ A794 E6 F8            AND $F8
1002+ A796 F6 06            OR 6
1003+ A798 32 8F 90         LD (CurrentPaging), A
1004+ A79B 01 FD 7F         LD BC, $7FFD
1005+ A79E ED 79            OUT (C), A
1006+ A7A0 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1007+ A7A3 6F               LD L, A
1008+ A7A4 26 00            LD H, 0
1009+ A7A6 29               ADD HL, HL
1010+ A7A7 11 03 E3         LD DE, SpriteFrameTable
1011+ A7AA 19               ADD HL, DE
1012+ A7AB 5E               LD E, (HL)
1013+ A7AC 23               INC HL
1014+ A7AD 56               LD D, (HL)
1015+ A7AE ED 53 19 A7      LD (OldSprAddr), DE
1016+ A7B2 3A 8F 90         LD A, (CurrentPaging)
1017+ A7B5 E6 F8            AND $F8
1018+ A7B7 32 8F 90         LD (CurrentPaging), A
1019+ A7BA 01 FD 7F         LD BC, $7FFD
1020+ A7BD ED 79            OUT (C), A
1021+ A7BF C9               RET
1022+ A7C0
1023+ A7C0              ; ==============================================================================
1024+ A7C0              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1025+ A7C0              ; ==============================================================================
1026+ A7C0              ; Entrada: A = SpriteID
1027+ A7C0              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1028+ A7C0              ; Destruye: A, DE, HL
1029+ A7C0              ; ==============================================================================
1030+ A7C0              GetSpriteDims:
1031+ A7C0                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1032+ A7C0                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1033+ A7C0 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1034+ A7C1 26 00            LD H, 0
1035+ A7C3 3A 8F 90         LD A, (CurrentPaging)
1036+ A7C6 E6 F8            AND $F8
1037+ A7C8 F6 06            OR 6
1038+ A7CA 32 8F 90         LD (CurrentPaging), A
1039+ A7CD 01 FD 7F         LD BC, $7FFD
1040+ A7D0 ED 79            OUT (C), A                  ; bank 6 paginado
1041+ A7D2 29               ADD HL, HL
1042+ A7D3 11 03 E3         LD DE, SpriteFrameTable
1043+ A7D6 19               ADD HL, DE
1044+ A7D7 5E               LD E, (HL)
1045+ A7D8 23               INC HL
1046+ A7D9 56               LD D, (HL)                  ; DE = ptr al sprite data
1047+ A7DA 1A               LD A, (DE)                  ; width_bytes
1048+ A7DB 87               ADD A, A
1049+ A7DC 87               ADD A, A
1050+ A7DD 87               ADD A, A                    ; × 8 = width_px
1051+ A7DE 47               LD B, A
1052+ A7DF 13               INC DE
1053+ A7E0 1A               LD A, (DE)                  ; height_px
1054+ A7E1 4F               LD C, A
1055+ A7E2                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1056+ A7E2 78               LD A, B
1057+ A7E3 32 00 A8         LD (GsdSavedB), A
1058+ A7E6 79               LD A, C
1059+ A7E7 32 01 A8         LD (GsdSavedC), A
1060+ A7EA 3A 8F 90         LD A, (CurrentPaging)
1061+ A7ED E6 F8            AND $F8
1062+ A7EF 32 8F 90         LD (CurrentPaging), A
1063+ A7F2 01 FD 7F         LD BC, $7FFD
1064+ A7F5 ED 79            OUT (C), A                  ; bank 0 de vuelta
1065+ A7F7 3A 00 A8         LD A, (GsdSavedB)
1066+ A7FA 47               LD B, A
1067+ A7FB 3A 01 A8         LD A, (GsdSavedC)
1068+ A7FE 4F               LD C, A
1069+ A7FF C9               RET
1070+ A800
1071+ A800 00           GsdSavedB: DEFB 0
1072+ A801 00           GsdSavedC: DEFB 0
1073+ A802
1074+ A802              ; ==============================================================================
1075+ A802              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1076+ A802              ; ==============================================================================
1077+ A802              ; IX = puntero a la entidad del player (slot 0)
1078+ A802              ; ==============================================================================
1079+ A802              UpdatePlayer:
1080+ A802 CD 0C A8         CALL UpdatePlayerState
1081+ A805 CD 27 A9         CALL UpdatePlayerMovement
1082+ A808 CD 8C AB         CALL UpdatePlayerAnimation
1083+ A80B C9               RET
1084+ A80C
1085+ A80C              ; ==============================================================================
1086+ A80C              ; UpdatePlayerState - Determina estado y direccion desde input
1087+ A80C              ; ==============================================================================
1088+ A80C              UpdatePlayerState:
1089+ A80C 3A 24 82         LD A, (InputDirection)
1090+ A80F 47               LD B, A
1091+ A810 3A 25 82         LD A, (InputFire)
1092+ A813 4F               LD C, A
1093+ A814
1094+ A814                  ; Sin input → idle (salvo si ataque en curso)
1095+ A814 78               LD A, B
1096+ A815 B1               OR C
1097+ A816 20 17            JR NZ, .notIdle
1098+ A818                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1099+ A818 3A 94 B5         LD A, (AttackTimer)
1100+ A81B B7               OR A
1101+ A81C 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1102+ A81E DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1103+ A822                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1104+ A822 DD 7E 0A         LD A, (IX+ENT_DIR)
1105+ A825 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1106+ A827 DD 77 0A         LD (IX+ENT_DIR), A
1107+ A82A                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1108+ A82A AF               XOR A
1109+ A82B 32 96 B5         LD (AttackDebounce), A
1110+ A82E C9               RET
1111+ A82F
1112+ A82F              .notIdle:
1113+ A82F                  ; Guardar direccion actual en bits 0-3
1114+ A82F DD 7E 0A         LD A, (IX+ENT_DIR)
1115+ A832 E6 F0            AND $F0                     ; Mantener lastHDir
1116+ A834 B0               OR B                        ; Añadir dir actual
1117+ A835 DD 77 0A         LD (IX+ENT_DIR), A
1118+ A838
1119+ A838                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1120+ A838 3A 94 B5         LD A, (AttackTimer)
1121+ A83B B7               OR A
1122+ A83C 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1123+ A83E 78               LD A, B
1124+ A83F E6 0C            AND DIR_E | DIR_W
1125+ A841 28 0E            JR Z, .noHorizUpdate
1126+ A843                  ; Guardar en bits 4-7
1127+ A843 07               RLCA
1128+ A844 07               RLCA
1129+ A845 07               RLCA
1130+ A846 07               RLCA                        ; Shift a bits 4-7
1131+ A847 4F               LD C, A                     ; C = lastHDir en bits 4-7
1132+ A848 DD 7E 0A         LD A, (IX+ENT_DIR)
1133+ A84B E6 0F            AND $0F                     ; Mantener dir actual
1134+ A84D B1               OR C                        ; Añadir lastHDir
1135+ A84E DD 77 0A         LD (IX+ENT_DIR), A
1136+ A851              .noHorizUpdate:
1137+ A851
1138+ A851                  ; --- Consumir/regenerar stamina ---
1139+ A851 CD BF AC         CALL UpdateStamina
1140+ A854                  ; --- Auto-select sword mode segun stamina ---
1141+ A854 CD 15 AD         CALL SelectSwordMode
1142+ A857                  ; --- Dispatch segun SwordMode ---
1143+ A857 3A 98 B5         LD A, (SwordMode)
1144+ A85A B7               OR A
1145+ A85B 28 09            JR Z, .swordModeB
1146+ A85D FE 01            CP 1
1147+ A85F 28 3F            JR Z, .swordModeC
1148+ A861 FE 02            CP 2
1149+ A863 CA C9 A8         JP Z, .swordModeFree
1150+ A866
1151+ A866                  ; === MODO B: Cooldown fijo tras atacar ===
1152+ A866              .swordModeB:
1153+ A866 3A 95 B5         LD A, (AttackCooldown)
1154+ A869 B7               OR A
1155+ A86A 28 0D            JR Z, .bNoCooldown
1156+ A86C 3D               DEC A
1157+ A86D 32 95 B5         LD (AttackCooldown), A
1158+ A870 C2 17 A9         JP NZ, .running                     ; En cooldown: no puede atacar
1159+ A873                  ; Cooldown terminado: restaurar color blanco
1160+ A873 CD F0 A8         CALL .setPlayerWhite
1161+ A876 C3 17 A9         JP .running
1162+ A879              .bNoCooldown:
1163+ A879 3A 94 B5         LD A, (AttackTimer)
1164+ A87C B7               OR A
1165+ A87D 28 13            JR Z, .bNoActive
1166+ A87F 3D               DEC A
1167+ A880 32 94 B5         LD (AttackTimer), A
1168+ A883 20 08            JR NZ, .bActive
1169+ A885                  ; Swing terminado: iniciar cooldown + color azul
1170+ A885 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1171+ A887 32 95 B5         LD (AttackCooldown), A
1172+ A88A CD E5 A8         CALL .setPlayerBlue
1173+ A88D              .bActive:
1174+ A88D DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1175+ A891 C9               RET
1176+ A892              .bNoActive:
1177+ A892 3A 25 82         LD A, (InputFire)
1178+ A895 B7               OR A
1179+ A896 CA 17 A9         JP Z, .running
1180+ A899 3E 05            LD A, ATTACK_SWING_FRAMES
1181+ A89B 32 94 B5         LD (AttackTimer), A
1182+ A89E 18 5B            JR .startAttack
1183+ A8A0
1184+ A8A0                  ; === MODO C: Swing fijo con debounce ===
1185+ A8A0              .swordModeC:
1186+ A8A0 3A 94 B5         LD A, (AttackTimer)
