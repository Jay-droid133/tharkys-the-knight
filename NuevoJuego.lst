 764+ ED78              ; ==============================================================================
 765+ ED78              ; .urpReadSlotAndDispatchCache — path del cache HIT
 766+ ED78              ; ==============================================================================
 767+ ED78              ; Entrada: A = slot cached, RP_TmpRolled = tipo cached (ya setado).
 768+ ED78              ; Lee SlotList[A*2] → CharX/Y, luego dispatcha al .urpDoXxx correspondiente.
 769+ ED78              ; ROLLED_NONE → JP .urpZeroAndRotate (no spawn pero rota cache).
 770+ ED78              ; ==============================================================================
 771+ ED78              .urpReadSlotAndDispatchCache:
 772+ ED78 87               ADD A, A
 773+ ED79 5F               LD E, A
 774+ ED7A 16 00            LD D, 0
 775+ ED7C 21 AC 5F         LD HL, RandomSlotList
 776+ ED7F 19               ADD HL, DE
 777+ ED80 7E               LD A, (HL)
 778+ ED81 32 B8 5F         LD (RandomSynthCharX), A
 779+ ED84 23               INC HL
 780+ ED85 7E               LD A, (HL)
 781+ ED86 32 B9 5F         LD (RandomSynthCharY), A
 782+ ED89
 783+ ED89 3A D5 5F         LD A, (RP_TmpRolled)
 784+ ED8C B7               OR A
 785+ ED8D CA 80 EE         JP Z, .urpZeroAndRotate             ; ROLLED_NONE (consumido) → no spawn
 786+ ED90 3D               DEC A
 787+ ED91 CA D4 ED         JP Z, .urpDoLife                    ; ROLLED_LIFE
 788+ ED94 3D               DEC A
 789+ ED95 28 22            JR Z, .urpDoHealthFromCache         ; ROLLED_HEALTH: reusa variant cacheada
 790+ ED97 3D               DEC A
 791+ ED98 28 26            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 792+ ED9A 3D               DEC A
 793+ ED9B CA FB ED         JP Z, .urpDoRayo
 794+ ED9E 3D               DEC A
 795+ ED9F CA 06 EE         JP Z, .urpDoCaracol
 796+ EDA2 3D               DEC A
 797+ EDA3 CA 48 EE         JP Z, .urpDoRoulette
 798+ EDA6 3D               DEC A
 799+ EDA7 CA 11 EE         JP Z, .urpDoMushroom
 800+ EDAA 3D               DEC A
 801+ EDAB CA 1C EE         JP Z, .urpDoCompass                 ; ROLLED_COMPASS
 802+ EDAE 3D               DEC A
 803+ EDAF CA 27 EE         JP Z, .urpDoEspada                  ; ROLLED_ESPADA
