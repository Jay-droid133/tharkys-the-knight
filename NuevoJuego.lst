 374+ 9E9D              _SaveEntityAttrImpl:
 375+ 9E9D                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9E9D DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9EA0 47               LD B, A
 378+ 9EA1 7B               LD A, E                     ; X pixel (raw)
 379+ 9EA2 E6 07            AND 7
 380+ 9EA4 28 01            JR Z, .noExtraW
