 280+ FC4C                  ; HL = top row start, DE = bot row start. LDIR 12 bytes.
 281+ FC4C 01 0C 00         LD BC, TOMB_SRC_ATTR_W * 2      ; 12
 282+ FC4F ED B0            LDIR                            ; copy 12 attrs from top row to bot row
