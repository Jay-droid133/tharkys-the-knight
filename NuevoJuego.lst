4929+ BD83              ; ==============================================================================
4930+ BD83              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4931+ BD83              ; ==============================================================================
4932+ BD83              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4933+ BD83              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4934+ BD83              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4935+ BD83              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4936+ BD83              ; deja la posicion original (puff puede asomar levemente, raro).
4937+ BD83              ; IN:  IX = nasty entity.
4938+ BD83              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4939+ BD83              ; Destruye: AF, BC, DE, HL.
4940+ BD83              ; ==============================================================================
4941+ BD83              SnapPuffPos:
4942+ BD83 DD 7E 03         LD A, (IX+ENT_POSX)
4943+ BD86 32 F9 BD         LD (.sppOrigX), A
4944+ BD89 E6 F8            AND $F8
4945+ BD8B 32 FB BD         LD (.sppBaseX), A                   ; base char-aligned X
4946+ BD8E DD 7E 04         LD A, (IX+ENT_POSY)
4947+ BD91 32 FA BD         LD (.sppOrigY), A
4948+ BD94 E6 F8            AND $F8
4949+ BD96 32 FC BD         LD (.sppBaseY), A                   ; base char-aligned Y
4950+ BD99
4951+ BD99                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4952+ BD99 CD CD BD         CALL .sppCheckFit
4953+ BD9C C8               RET Z
4954+ BD9D
4955+ BD9D                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4956+ BD9D                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4957+ BD9D 21 FD BD         LD HL, .sppShifts
4958+ BDA0              .sppLoop:
4959+ BDA0 7E               LD A, (HL)
4960+ BDA1 23               INC HL
4961+ BDA2 47               LD B, A                             ; dx (signed)
4962+ BDA3 7E               LD A, (HL)
4963+ BDA4 23               INC HL
4964+ BDA5 FE 80            CP $80
4965+ BDA7 28 17            JR Z, .sppFail                      ; sentinel
4966+ BDA9 4F               LD C, A                             ; dy (signed)
4967+ BDAA
4968+ BDAA 3A FB BD         LD A, (.sppBaseX)
4969+ BDAD 80               ADD A, B
4970+ BDAE DD 77 03         LD (IX+ENT_POSX), A
4971+ BDB1 3A FC BD         LD A, (.sppBaseY)
4972+ BDB4 81               ADD A, C
4973+ BDB5 DD 77 04         LD (IX+ENT_POSY), A
4974+ BDB8
4975+ BDB8 E5               PUSH HL
4976+ BDB9 CD CD BD         CALL .sppCheckFit
4977+ BDBC E1               POP HL
4978+ BDBD C8               RET Z                               ; encontrado
4979+ BDBE 18 E0            JR .sppLoop
4980+ BDC0
4981+ BDC0              .sppFail:
4982+ BDC0 3A F9 BD         LD A, (.sppOrigX)
4983+ BDC3 DD 77 03         LD (IX+ENT_POSX), A
4984+ BDC6 3A FA BD         LD A, (.sppOrigY)
4985+ BDC9 DD 77 04         LD (IX+ENT_POSY), A
4986+ BDCC C9               RET
4987+ BDCD
4988+ BDCD              ; --- .sppCheckFit ---
4989+ BDCD              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
4990+ BDCD              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
4991+ BDCD              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
4992+ BDCD              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
4993+ BDCD              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
4994+ BDCD              .sppCheckFit:
4995+ BDCD                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
4996+ BDCD DD 7E 03         LD A, (IX+ENT_POSX)
4997+ BDD0 FE D1            CP SCREEN_MAX_X - 23
4998+ BDD2 30 21            JR NC, .sppOutOfBounds
4999+ BDD4 DD 7E 04         LD A, (IX+ENT_POSY)
5000+ BDD7 FE 10            CP SCREEN_MIN_Y
5001+ BDD9 38 1A            JR C, .sppOutOfBounds
5002+ BDDB FE 91            CP SCREEN_MAX_Y - 23
5003+ BDDD 30 16            JR NC, .sppOutOfBounds
5004+ BDDF                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5005+ BDDF DD 7E 00         LD A, (IX+ENT_SPRITEID)
5006+ BDE2 32 F8 BD         LD (.sppSpritIdSave), A
5007+ BDE5 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5008+ BDE9 CD D6 B9         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5009+ BDEC F5               PUSH AF
5010+ BDED 3A F8 BD         LD A, (.sppSpritIdSave)
5011+ BDF0 DD 77 00         LD (IX+ENT_SPRITEID), A
5012+ BDF3 F1               POP AF
5013+ BDF4 C9               RET
5014+ BDF5              .sppOutOfBounds:
5015+ BDF5 F6 01            OR 1                                ; NZ
5016+ BDF7 C9               RET
5017+ BDF8
5018+ BDF8 00           .sppSpritIdSave: DEFB 0
5019+ BDF9
5020+ BDF9 00           .sppOrigX: DEFB 0
5021+ BDFA 00           .sppOrigY: DEFB 0
5022+ BDFB 00           .sppBaseX: DEFB 0
5023+ BDFC 00           .sppBaseY: DEFB 0
5024+ BDFD              .sppShifts:
5025+ BDFD                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5026+ BDFD                  ; Distancia creciente. Sentinel: dy=$80.
5027+ BDFD 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5028+ BDFF 00 F8            DEFB 0,   -8                        ; arriba 8
5029+ BE01 00 08            DEFB 0,    8                        ; abajo 8
5030+ BE03 F8 00            DEFB -8,   0                        ; izq 8
5031+ BE05 08 00            DEFB 8,    0                        ; der 8
5032+ BE07 00 F0            DEFB 0,  -16                        ; arriba 16
5033+ BE09 00 10            DEFB 0,   16                        ; abajo 16
5034+ BE0B F8 F8            DEFB -8,  -8
5035+ BE0D 08 F8            DEFB 8,   -8
5036+ BE0F F8 08            DEFB -8,   8
5037+ BE11 08 08            DEFB 8,    8
5038+ BE13 00 80            DEFB 0,  $80                        ; sentinel
5039+ BE15
5040+ BE15              ; ==============================================================================
5041+ BE15              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5042+ BE15              ; ==============================================================================
5043+ BE15              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5044+ BE15              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5045+ BE15              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5046+ BE15              ; DeathSpawned. No-op si la muerte no esta activa.
5047+ BE15              ; ==============================================================================
5048+ BE15              SilentKillDeath:
5049+ BE15 DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5050+ BE19 DD 7E 01         LD A, (IX+ENT_TYPE)
5051+ BE1C B7               OR A
5052+ BE1D 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5053+ BE1F CD 19 CA         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5054+ BE22 AF               XOR A
5055+ BE23 DD 77 01         LD (IX+ENT_TYPE), A
5056+ BE26 32 9F 82         LD (DeathSpawned), A
5057+ BE29              .skdResetTimer:
5058+ BE29                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5059+ BE29                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5060+ BE29 21 00 00         LD HL, 0
5061+ BE2C 22 9C 82         LD (DeathScreenTimer), HL
5062+ BE2F                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5063+ BE2F                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5064+ BE2F                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5065+ BE2F                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5066+ BE2F                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5067+ BE2F C9               RET
5068+ BE30
5069+ BE30              ; ==============================================================================
5070+ BE30              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5071+ BE30              ; ==============================================================================
5072+ BE30              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5073+ BE30              ; no DYING ni SPAWNING):
5074+ BE30              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5075+ BE30              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5076+ BE30              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5077+ BE30              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5078+ BE30              ;     Si tampoco, deja el monster donde estaba.
5079+ BE30              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5080+ BE30              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5081+ BE30              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5082+ BE30              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5083+ BE30              ; ==============================================================================
5084+ BE30              FreezeMonstersFacingCorpse:
5085+ BE30                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5086+ BE30 3A 4E 81         LD A, (EntityTable + ENT_POSX)
5087+ BE33 32 96 82         LD (CorpseX), A
5088+ BE36 3A 4F 81         LD A, (EntityTable + ENT_POSY)
5089+ BE39 32 97 82         LD (CorpseY), A
5090+ BE3C                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5091+ BE3C                  ; ya skipea; no aplica aqui pero por simetria)
5092+ BE3C 3E 01            LD A, 1
5093+ BE3E 32 95 82         LD (MonstersFrozen), A
5094+ BE41 DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5095+ BE45 06 06            LD B, NUM_MONSTERS
5096+ BE47              .fmcLoop:
5097+ BE47 C5               PUSH BC
5098+ BE48 DD 7E 01         LD A, (IX+ENT_TYPE)
5099+ BE4B FE 02            CP TYPE_MONSTER
5100+ BE4D 20 0E            JR NZ, .fmcNext
5101+ BE4F DD 7E 02         LD A, (IX+ENT_STATE)
5102+ BE52 FE 03            CP STATE_DYING
5103+ BE54 28 07            JR Z, .fmcNext
5104+ BE56 FE 04            CP STATE_SPAWNING
5105+ BE58 28 03            JR Z, .fmcNext
5106+ BE5A CD 66 BE         CALL FreezeOneMonster
5107+ BE5D              .fmcNext:
5108+ BE5D C1               POP BC
5109+ BE5E 11 10 00         LD DE, ENT_SIZE
5110+ BE61 DD 19            ADD IX, DE
5111+ BE63 10 E2            DJNZ .fmcLoop
5112+ BE65 C9               RET
5113+ BE66
5114+ BE66              ; --- FreezeOneMonster ---
5115+ BE66              ; IX = monster slot pointer.
5116+ BE66              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5117+ BE66              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5118+ BE66              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5119+ BE66              FreezeOneMonster:
5120+ BE66                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5121+ BE66                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5122+ BE66                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5123+ BE66 DD 7E 03         LD A, (IX+ENT_POSX)
5124+ BE69 47               LD B, A
5125+ BE6A 3A 96 82         LD A, (CorpseX)
5126+ BE6D B8               CP B
5127+ BE6E 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5128+ BE70 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5129+ BE72              .fomFaceE:
5130+ BE72 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5131+ BE75 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5132+ BE77 DD 77 00         LD (IX+ENT_SPRITEID), A
5133+ BE7A 18 08            JR .fomFaceDone
5134+ BE7C              .fomFaceW:
5135+ BE7C DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5136+ BE7F C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5137+ BE81 DD 77 00         LD (IX+ENT_SPRITEID), A
5138+ BE84              .fomFaceDone:
5139+ BE84
5140+ BE84                  ; --- 2) Computar |dx| y |dy| ---
5141+ BE84 3A 96 82         LD A, (CorpseX)
5142+ BE87 4F               LD C, A
5143+ BE88 DD 7E 03         LD A, (IX+ENT_POSX)
5144+ BE8B 91               SUB C                           ; A = posX - corpseX (signed)
5145+ BE8C 30 02            JR NC, .fomDxPos
5146+ BE8E ED 44            NEG
5147+ BE90              .fomDxPos:
5148+ BE90 32 E1 BE         LD (.fomAdx), A
5149+ BE93 3A 97 82         LD A, (CorpseY)
5150+ BE96 4F               LD C, A
5151+ BE97 DD 7E 04         LD A, (IX+ENT_POSY)
5152+ BE9A 91               SUB C
5153+ BE9B 30 02            JR NC, .fomDyPos
5154+ BE9D ED 44            NEG
5155+ BE9F              .fomDyPos:
5156+ BE9F 32 E2 BE         LD (.fomAdy), A
5157+ BEA2
5158+ BEA2                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5159+ BEA2 3A E1 BE         LD A, (.fomAdx)
5160+ BEA5 FE 10            CP 16
5161+ BEA7 D2 D0 BE         JP NC, .fomFreeze
5162+ BEAA 3A E2 BE         LD A, (.fomAdy)
5163+ BEAD FE 10            CP 16
5164+ BEAF D2 D0 BE         JP NC, .fomFreeze
5165+ BEB2
5166+ BEB2                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5167+ BEB2 3A E1 BE         LD A, (.fomAdx)
5168+ BEB5 47               LD B, A
5169+ BEB6 3A E2 BE         LD A, (.fomAdy)
5170+ BEB9 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5171+ BEBA 38 0C            JR C, .fomTryX
5172+ BEBC 28 0A            JR Z, .fomTryX
5173+ BEBE                  ; |dy| > |dx| -> intentar Y primero
5174+ BEBE CD 16 BF         CALL TryBackoffY
5175+ BEC1 28 0D            JR Z, .fomFreeze                ; ok
5176+ BEC3 CD E3 BE         CALL TryBackoffX
5177+ BEC6 18 08            JR .fomFreeze
5178+ BEC8              .fomTryX:
5179+ BEC8 CD E3 BE         CALL TryBackoffX
5180+ BECB 28 03            JR Z, .fomFreeze
5181+ BECD CD 16 BF         CALL TryBackoffY
5182+ BED0
5183+ BED0              .fomFreeze:
5184+ BED0                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5185+ BED0                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5186+ BED0 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5187+ BED4 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5188+ BED8 DD 36 0A 00      LD (IX+ENT_DIR), 0
5189+ BEDC DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5190+ BEE0 C9               RET
5191+ BEE1
5192+ BEE1 00           .fomAdx: DEFB 0
5193+ BEE2 00           .fomAdy: DEFB 0
5194+ BEE3
5195+ BEE3              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5196+ BEE3              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5197+ BEE3              TryBackoffX:
5198+ BEE3 DD 7E 03         LD A, (IX+ENT_POSX)
5199+ BEE6 32 15 BF         LD (.tbxSavePos), A
5200+ BEE9 47               LD B, A
5201+ BEEA 3A 96 82         LD A, (CorpseX)
5202+ BEED B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5203+ BEEE DD 7E 03         LD A, (IX+ENT_POSX)
5204+ BEF1 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5205+ BEF3 C6 10            ADD A, 16
5206+ BEF5 18 02            JR .tbxApply
5207+ BEF7              .tbxNeg:
5208+ BEF7 D6 10            SUB 16
5209+ BEF9              .tbxApply:
5210+ BEF9                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5211+ BEF9 DD 77 03         LD (IX+ENT_POSX), A
5212+ BEFC FE E8            CP SCREEN_MAX_X
5213+ BEFE 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5214+ BF00 CD D6 B9         CALL CheckEnemyCollision
5215+ BF03 20 07            JR NZ, .tbxFail
5216+ BF05 CD 4D BF         CALL CheckMonsterOverlap
5217+ BF08 20 02            JR NZ, .tbxFail
5218+ BF0A AF               XOR A                           ; Z = ok
5219+ BF0B C9               RET
5220+ BF0C              .tbxFail:
5221+ BF0C 3A 15 BF         LD A, (.tbxSavePos)
5222+ BF0F DD 77 03         LD (IX+ENT_POSX), A
5223+ BF12 F6 01            OR 1                            ; NZ
5224+ BF14 C9               RET
5225+ BF15 00           .tbxSavePos: DEFB 0
5226+ BF16
5227+ BF16              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5228+ BF16              TryBackoffY:
5229+ BF16 DD 7E 04         LD A, (IX+ENT_POSY)
5230+ BF19 32 4C BF         LD (.tbySavePos), A
5231+ BF1C 47               LD B, A
5232+ BF1D 3A 97 82         LD A, (CorpseY)
5233+ BF20 B8               CP B
5234+ BF21 DD 7E 04         LD A, (IX+ENT_POSY)
5235+ BF24 30 04            JR NC, .tbyNeg
5236+ BF26 C6 10            ADD A, 16
5237+ BF28 18 02            JR .tbyApply
5238+ BF2A              .tbyNeg:
5239+ BF2A D6 10            SUB 16
5240+ BF2C              .tbyApply:
5241+ BF2C DD 77 04         LD (IX+ENT_POSY), A
5242+ BF2F FE 10            CP SCREEN_MIN_Y
5243+ BF31 38 10            JR C, .tbyFail
5244+ BF33 FE A8            CP SCREEN_MAX_Y
5245+ BF35 30 0C            JR NC, .tbyFail
5246+ BF37 CD D6 B9         CALL CheckEnemyCollision
5247+ BF3A 20 07            JR NZ, .tbyFail
5248+ BF3C CD 4D BF         CALL CheckMonsterOverlap
5249+ BF3F 20 02            JR NZ, .tbyFail
5250+ BF41 AF               XOR A
5251+ BF42 C9               RET
5252+ BF43              .tbyFail:
5253+ BF43 3A 4C BF         LD A, (.tbySavePos)
5254+ BF46 DD 77 04         LD (IX+ENT_POSY), A
5255+ BF49 F6 01            OR 1
5256+ BF4B C9               RET
5257+ BF4C 00           .tbySavePos: DEFB 0
5258+ BF4D
5259+ BF4D              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5260+ BF4D              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5261+ BF4D              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5262+ BF4D              CheckMonsterOverlap:
5263+ BF4D C5               PUSH BC
5264+ BF4E FD E5            PUSH IY
5265+ BF50 FD 21 5B 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5266+ BF54 06 06            LD B, NUM_MONSTERS
5267+ BF56              .cmoLoop:
5268+ BF56                  ; Skip self (IY == IX)
5269+ BF56 DD E5            PUSH IX
5270+ BF58 E1               POP HL
5271+ BF59 FD E5            PUSH IY
5272+ BF5B D1               POP DE
5273+ BF5C B7               OR A
5274+ BF5D ED 52            SBC HL, DE
5275+ BF5F 28 3D            JR Z, .cmoNext                  ; same slot
5276+ BF61
5277+ BF61 FD 7E 01         LD A, (IY+ENT_TYPE)
5278+ BF64 FE 02            CP TYPE_MONSTER
5279+ BF66 20 36            JR NZ, .cmoNext
5280+ BF68
5281+ BF68                  ; AABB overlap (rect 16x21 cada uno):
5282+ BF68                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5283+ BF68                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5284+ BF68 DD 7E 03         LD A, (IX+ENT_POSX)
5285+ BF6B C6 10            ADD A, 16
5286+ BF6D 4F               LD C, A
5287+ BF6E FD 7E 03         LD A, (IY+ENT_POSX)
5288+ BF71 B9               CP C                            ; iy.x cmp ix.x+16
5289+ BF72 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5290+ BF74 FD 7E 03         LD A, (IY+ENT_POSX)
5291+ BF77 C6 10            ADD A, 16
5292+ BF79 4F               LD C, A
5293+ BF7A DD 7E 03         LD A, (IX+ENT_POSX)
5294+ BF7D B9               CP C
5295+ BF7E 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5296+ BF80 DD 7E 04         LD A, (IX+ENT_POSY)
5297+ BF83 C6 15            ADD A, 21
5298+ BF85 4F               LD C, A
5299+ BF86 FD 7E 04         LD A, (IY+ENT_POSY)
5300+ BF89 B9               CP C
5301+ BF8A 30 12            JR NC, .cmoNext
5302+ BF8C FD 7E 04         LD A, (IY+ENT_POSY)
5303+ BF8F C6 15            ADD A, 21
5304+ BF91 4F               LD C, A
5305+ BF92 DD 7E 04         LD A, (IX+ENT_POSY)
5306+ BF95 B9               CP C
5307+ BF96 30 06            JR NC, .cmoNext
5308+ BF98                  ; Overlap en ambos ejes
5309+ BF98 FD E1            POP IY
5310+ BF9A C1               POP BC
5311+ BF9B F6 01            OR 1                            ; NZ
5312+ BF9D C9               RET
5313+ BF9E              .cmoNext:
5314+ BF9E 11 10 00         LD DE, ENT_SIZE
5315+ BFA1 FD 19            ADD IY, DE
5316+ BFA3 10 B1            DJNZ .cmoLoop
5317+ BFA5 FD E1            POP IY
5318+ BFA7 C1               POP BC
5319+ BFA8 AF               XOR A                           ; Z = no overlap
5320+ BFA9 C9               RET
5321+ BFAA
5322+ BFAA              ; ==============================================================================
5323+ BFAA              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5324+ BFAA              ; ==============================================================================
5325+ BFAA              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5326+ BFAA              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5327+ BFAA              ; ==============================================================================
5328+ BFAA              KillAllActiveMonsters:
5329+ BFAA AF               XOR A
5330+ BFAB 32 71 B6         LD (MonstersActive), A              ; No respawnear mas
5331+ BFAE DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5332+ BFB2 06 06            LD B, NUM_MONSTERS
5333+ BFB4              .kamLoop:
5334+ BFB4 C5               PUSH BC
5335+ BFB5 DD 7E 01         LD A, (IX+ENT_TYPE)
5336+ BFB8 B7               OR A
5337+ BFB9 28 27            JR Z, .kamSkip                      ; slot vacio
5338+ BFBB FE 02            CP TYPE_MONSTER
5339+ BFBD 20 23            JR NZ, .kamSkip                     ; no es monster
5340+ BFBF DD 7E 02         LD A, (IX+ENT_STATE)
5341+ BFC2 FE 03            CP STATE_DYING
5342+ BFC4 28 1C            JR Z, .kamSkip
5343+ BFC6 FE 04            CP STATE_SPAWNING
5344+ BFC8 28 18            JR Z, .kamSkip
5345+ BFCA DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5346+ BFCE DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5347+ BFD2 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5348+ BFD6 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5349+ BFDA DD 36 06 00      LD (IX+ENT_DELTAX), 0
5350+ BFDE DD 36 07 00      LD (IX+ENT_DELTAY), 0
5351+ BFE2                  ; ENT_ATTR conservado: puff hereda color del monster
5352+ BFE2              .kamSkip:
5353+ BFE2 11 10 00         LD DE, ENT_SIZE
5354+ BFE5 DD 19            ADD IX, DE
5355+ BFE7 C1               POP BC
5356+ BFE8 10 CA            DJNZ .kamLoop
5357+ BFEA C9               RET
5358+ BFEB
5359+ BFEB              ; --- Tabla de tipos de nasty (SpriteID base) ---
5360+ BFEB              ; --- Tablas de nasties por momento del dia ---
5361+ BFEB              NUM_NASTY_TYPES EQU 4
5362+ BFEB              DiurnalTypeTable:                       ; DY, C1, A2
5363+ BFEB 30               DEFB SPRID_ENEMY_4          ; Eagle
5364+ BFEC 20               DEFB SPRID_ENEMY_0          ; Spider
5365+ BFED 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5366+ BFEE 2C               DEFB SPRID_ENEMY_3          ; Snake
5367+ BFEF              CrepuscularTypeTable:                   ; C2, N1
5368+ BFEF 34               DEFB SPRID_ENEMY_5          ; Rat
5369+ BFF0 28               DEFB SPRID_ENEMY_2          ; Bat
5370+ BFF1 24               DEFB SPRID_ENEMY_1          ; Scorpion
5371+ BFF2 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5372+ BFF3
5373+ BFF3              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5374+ BFF3              NastyColorTable:
5375+ BFF3 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5376+ BFF4 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5377+ BFF5 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5378+ BFF6 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5379+ BFF7 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5380+ BFF8 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5381+ BFF9 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5382+ BFFA 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5383+ BFFB
5384+ BFFB              ; --- Tabla de comportamiento depredador ---
5385+ BFFB              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5386+ BFFB              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5387+ BFFB              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5388+ BFFB              PredatorTable:
5389+ BFFB 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5390+ BFFC 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5391+ BFFD 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5392+ BFFE 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5393+ BFFF 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5394+ C000 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5395+ C001 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5396+ C002 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5397+ C003
5398+ C003              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5399+ C003              PredatorSpeedTable:
5400+ C003 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5401+ C004 02               DEFB 2                              ; Ciclo 1: lento
5402+ C005 03               DEFB 3                              ; Ciclo 2: intermedio
5403+ C006 04               DEFB 4                              ; Ciclo 3+: rapido
5404+ C007
5405+ C007 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5406+ C008
5407+ C008 EB BF        CurrentNastyTable: DEFW DiurnalTypeTable
5408+ C00A
5409+ C00A              ; ==============================================================================
5410+ C00A              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5411+ C00A              ; ==============================================================================
5412+ C00A              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5413+ C00A              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5414+ C00A              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5415+ C00A              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5416+ C00A              ;   pantalla, no diurnos.
5417+ C00A              ; ==============================================================================
5418+ C00A              UpdateNastyTable:
5419+ C00A 3A FE E4         LD A, (CurrentTimeOfDay)
