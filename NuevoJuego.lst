# file closed: room_routes_bank7.asm
 590  DC27                  ; --- Game Over tumba 2x — body (~538 B) ---
 591  DC27                  ; Cold path one-shot. Llamado via thunk en slot 1 (game_over_tomb_thunk.asm).
 592  DC27                  ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
 593  DC27                  ; al final → bank 7 desapareceria con el body ejecutandose). El thunk hace
 594  DC27                  ; la carga del sprite ANTES de paginar bank 7 y llamar al body.
 595  DC27                  INCLUDE "game_over_tomb.asm"
# file opened: game_over_tomb.asm
   1+ DC27              ; ==============================================================================
   2+ DC27              ; GAME OVER — TUMBA DEL JUGADOR A 2x (BODY, vive en BANK 7)
   3+ DC27              ; ==============================================================================
   4+ DC27              ; Cuerpo de la rutina. Vive en bank 7 (slot 3 cuando paged) por estar
   5+ DC27              ; "holgado": tras bg_gfx_c (~$D226) y antes del storage de tombstones ($E000+),
   6+ DC27              ; quedan ~3.5 KB libres. Bank 0 estaba al 96 % y este código es one-shot.
   7+ DC27              ;
   8+ DC27              ; Llamado por DrawTombstone2xCentered (thunk en slot 1) DESPUÉS de que el
   9+ DC27              ; thunk haya cargado el sprite en BgSpriteBuffer y paginado bank 7 en slot 3.
  10+ DC27              ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
  11+ DC27              ; en slot 3 al final → bank 7 desaparece → crash).
  12+ DC27              ;
  13+ DC27              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
  14+ DC27              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
  15+ DC27              ; Game Over. La muerte hace moonwalk justo encima del techo.
  16+ DC27              ;
  17+ DC27              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  18+ DC27              ;
  19+ DC27              ; Algoritmo (precondición: BgSpriteBuffer ya tiene el sprite cargado):
  20+ DC27              ;   1. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  21+ DC27              ;      planos en TombDecodedPixels (en bank 7 RAM). Salva src ptr post-pixels.
  22+ DC27              ;   2. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  23+ DC27              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  24+ DC27              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  25+ DC27              ;   3. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  26+ DC27              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  27+ DC27              ;
  28+ DC27              ; Coste: ~30K T-states one-shot. Invisible.
  29+ DC27              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch + 2 B var = ~538 B en bank 7.
  30+ DC27              ;
  31+ DC27              ; Capas:
  32+ DC27              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  33+ DC27              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba.
  34+ DC27              ; ==============================================================================
  35+ DC27
  36+ DC27              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  37+ DC27              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  38+ DC27              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  39+ DC27              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  40+ DC27              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  41+ DC27              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  42+ DC27              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  43+ DC27              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  44+ DC27              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  45+ DC27
  46+ DC27              ; ==============================================================================
  47+ DC27              ; DrawTombstone2xBody - entry point del body en bank 7
  48+ DC27              ; ==============================================================================
  49+ DC27              ; Precondición: bank 7 paginado en slot 3 + BgSpriteBuffer ya cargado con
  50+ DC27              ; el sprite (lo hace el thunk antes de llamar a esta rutina).
  51+ DC27              ;
  52+ DC27              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  53+ DC27              ; directamente a VRAM sin XOR.
  54+ DC27              ;
  55+ DC27              ; Destruye: AF, BC, DE, HL, IX.
  56+ DC27              ; ==============================================================================
  57+ DC27              DrawTombstone2xBody:
  58+ DC27                  ; --- 1. Decodificar pixeles RLE+CPL → flat buffer ---
  59+ DC27 CD 30 DC         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  60+ DC2A
  61+ DC2A                  ; --- 2. Dibujar pixeles 2x desde flat buffer ---
  62+ DC2A CD 8D DC         CALL DrawTombPixels2x
  63+ DC2D
  64+ DC2D                  ; --- 3. Dibujar attrs 2x desde BgSpriteBuffer ---
  65+ DC2D C3 16 DD         JP DrawTombAttrs2x              ; tail-call
  66+ DC30
  67+ DC30              ; ==============================================================================
  68+ DC30              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  69+ DC30              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  70+ DC30              ; ==============================================================================
  71+ DC30              ; Formato RLE (mismo que DrawBgGfxSprite):
  72+ DC30              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  73+ DC30              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  74+ DC30              ;
  75+ DC30              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  76+ DC30              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  77+ DC30              ;
  78+ DC30              ; Destruye: AF, BC, DE, HL.
  79+ DC30              ; ==============================================================================
  80+ DC30              DecodeTombRLEPixels:
  81+ DC30 21 FF 86         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  82+ DC33 11 5D DD         LD DE, TombDecodedPixels
  83+ DC36 01 F0 00         LD BC, TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes a emitir
  84+ DC39 AF               XOR A
  85+ DC3A 32 8B DC         LD (.drlPending), A
  86+ DC3D              .drlLoop:
  87+ DC3D 78               LD A, B
  88+ DC3E B1               OR C
  89+ DC3F 28 43            JR Z, .drlDone                  ; remaining == 0 → done
  90+ DC41 3A 8B DC         LD A, (.drlPending)
  91+ DC44 B7               OR A
  92+ DC45 28 22            JR Z, .drlNewToken
  93+ DC47 FA 5A DC         JP M, .drlLitEmit
  94+ DC4A                  ; pending > 0 → run en curso
  95+ DC4A              .drlRunEmit:
  96+ DC4A 3A 8C DC         LD A, (.drlValue)
  97+ DC4D 2F               CPL
  98+ DC4E 12               LD (DE), A
  99+ DC4F 13               INC DE
 100+ DC50 0B               DEC BC
 101+ DC51 3A 8B DC         LD A, (.drlPending)
 102+ DC54 3D               DEC A
 103+ DC55 32 8B DC         LD (.drlPending), A
 104+ DC58 18 E3            JR .drlLoop
 105+ DC5A
 106+ DC5A              .drlLitEmit:
 107+ DC5A 7E               LD A, (HL)
 108+ DC5B 23               INC HL
 109+ DC5C 2F               CPL
 110+ DC5D 12               LD (DE), A
 111+ DC5E 13               INC DE
 112+ DC5F 0B               DEC BC
 113+ DC60 3A 8B DC         LD A, (.drlPending)
 114+ DC63 3C               INC A                           ; hacia 0
 115+ DC64 32 8B DC         LD (.drlPending), A
 116+ DC67 18 D4            JR .drlLoop
 117+ DC69
 118+ DC69              .drlNewToken:
 119+ DC69 7E               LD A, (HL)
 120+ DC6A 23               INC HL
 121+ DC6B CB 7F            BIT 7, A
 122+ DC6D 20 07            JR NZ, .drlNewRun
 123+ DC6F                  ; Literal group: pending = -count
 124+ DC6F ED 44            NEG
 125+ DC71 32 8B DC         LD (.drlPending), A
 126+ DC74 18 C7            JR .drlLoop
 127+ DC76
 128+ DC76              .drlNewRun:
 129+ DC76 E6 7F            AND $7F
 130+ DC78 C6 02            ADD A, 2
 131+ DC7A 32 8B DC         LD (.drlPending), A
 132+ DC7D 7E               LD A, (HL)
 133+ DC7E 23               INC HL
 134+ DC7F 32 8C DC         LD (.drlValue), A
 135+ DC82 18 B9            JR .drlLoop
 136+ DC84
 137+ DC84              .drlDone:
 138+ DC84                  ; HL apunta al byte tras los pixeles RLE = tint byte.
 139+ DC84                  ; attrs comienzan en HL + 3 (skip tint + AH + AW).
 140+ DC84 23               INC HL
 141+ DC85 23               INC HL
 142+ DC86 23               INC HL
 143+ DC87 22 4D DE         LD (TombAttrSrcPtr), HL
 144+ DC8A C9               RET
 145+ DC8B
 146+ DC8B 00           .drlPending:    DEFB 0
 147+ DC8C 00           .drlValue:      DEFB 0
 148+ DC8D
 149+ DC8D              ; ==============================================================================
 150+ DC8D              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 151+ DC8D              ; ==============================================================================
 152+ DC8D              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 153+ DC8D              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 154+ DC8D              ; pareja de bytes — vertical doubling).
 155+ DC8D              ;
 156+ DC8D              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 157+ DC8D              ; Destruye: AF, BC, DE, HL.
 158+ DC8D              ; ==============================================================================
 159+ DC8D              DrawTombPixels2x:
 160+ DC8D 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 161+ DC8F 32 0E DD         LD (.dpxRowsLeft), A
 162+ DC92 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
 163+ DC94 32 0F DD         LD (.dpxDstY), A
 164+ DC97 21 5D DD         LD HL, TombDecodedPixels
 165+ DC9A 22 10 DD         LD (.dpxSrcPtr), HL
 166+ DC9D
 167+ DC9D              .dpxNextRow:
 168+ DC9D                  ; Calc dst top addr at (TOMB_2X_DST_PIXEL_X, dstY)
 169+ DC9D 3A 0F DD         LD A, (.dpxDstY)
 170+ DCA0 57               LD D, A
 171+ DCA1 1E 50            LD E, TOMB_2X_DST_PIXEL_X
 172+ DCA3 CD 62 9D         CALL CalcPixelAddr
 173+ DCA6 22 12 DD         LD (.dpxDstTop), HL
