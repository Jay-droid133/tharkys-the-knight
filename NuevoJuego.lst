 715+ 6A0D E5               PUSH HL
 716+ 6A0E 23               INC HL
 716+ 6A0F 23             INC HL                         ; -> ptr_lo
 717+ 6A10 7E               LD A, (HL)
 718+ 6A11 BB               CP E
 719+ 6A12 20 08            JR NZ, .fpeNoMatch
 720+ 6A14 23               INC HL
 721+ 6A15 7E               LD A, (HL)
 722+ 6A16 BA               CP D
 723+ 6A17 20 03            JR NZ, .fpeNoMatch
 724+ 6A19 E1               POP HL
 725+ 6A1A AF               XOR A                                   ; Z = encontrado
 726+ 6A1B C9               RET
 727+ 6A1C              .fpeNoMatch:
 728+ 6A1C E1               POP HL
 729+ 6A1D C5               PUSH BC
 730+ 6A1E 01 07 00         LD BC, 7
 731+ 6A21 09               ADD HL, BC
 732+ 6A22 C1               POP BC
 733+ 6A23 18 E3            JR .fpeLoop
 734+ 6A25              .fpeNotFound:
 735+ 6A25 F6 01            OR 1                                    ; NZ
 736+ 6A27 C9               RET
