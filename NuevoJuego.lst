 454  E8AB                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ E8AB              ; ==============================================================================
   2+ E8AB              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ E8AB              ; ==============================================================================
   4+ E8AB              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ E8AB              ; Para cada shift S:
   6+ E8AB              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ E8AB              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ E8AB              ;
   9+ E8AB              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ E8AB              ;
  11+ E8AB              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ E8AB              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ E8AB              ;
  14+ E8AB              ; Calculo de B desde X%8:
  15+ E8AB              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ E8AB              ; ==============================================================================
  17+ E8AB
  18+ E8AB 00 00 00...      ALIGN 256
  19+ E900              ShiftTables:
  20+ E900                  LUA ALLPASS
  21+ E900 ~                for shift = 1, 7 do
  22+ E900 ~                    -- High part: byte >> shift
  23+ E900 ~                    for i = 0, 255 do
  24+ E900 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ E900 ~                    end
  26+ E900 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ E900 ~                    for i = 0, 255 do
  28+ E900 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ E900 ~                    end
  30+ E900 ~                end
