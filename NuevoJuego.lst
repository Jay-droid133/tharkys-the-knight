 325+ 725D              ; UpdateRandomPickup - room-enter hook
 326+ 725D              ; ==============================================================================
 327+ 725D              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 328+ 725D              ; Early-out si ScreenDirty=0 (no transition).
 329+ 725D              ;
 330+ 725D              ; En transition:
 331+ 725D              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 332+ 725D              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 333+ 725D              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 334+ 725D              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 335+ 725D              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 336+ 725D              ;
 337+ 725D              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 338+ 725D              ; fijos (id, charX, charY, v) terminados con id=$FF.
 339+ 725D              ;
 340+ 725D              ; Destruye AF, BC, DE, HL.
 341+ 725D              ; ==============================================================================
 342+ 725D              UpdateRandomPickup:
 343+ 725D 3A 10 83         LD A, (ScreenDirty)
 344+ 7260 B7               OR A
 345+ 7261 C8               RET Z
 346+ 7262
 347+ 7262                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 348+ 7262 3E FE            LD A, $FE
 349+ 7264 32 B4 5F         LD (RandomSynthMapX), A
 350+ 7267 AF               XOR A
 351+ 7268 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
