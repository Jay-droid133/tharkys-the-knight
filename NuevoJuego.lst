 148+ 9E6B 20 04            JR NZ, .noHC
 149+ 9E6D 78               LD A, B
 150+ 9E6E E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ 9E70 47               LD B, A
 152+ 9E71              .noHC:
