 582+ 7F6A              ; --- ApplyMusicSpeedShift: A=duration in/out. SRL N veces, clamp a 1 ----------
 583+ 7F6A              ; MusicSpeedShift = 0 → no-op. Mantiene el comportamiento "tempo / 2^N".
 584+ 7F6A              ApplyMusicSpeedShift:
 585+ 7F6A 47               LD B, A
 586+ 7F6B 3A E0 99         LD A, (MusicSpeedShift)
 587+ 7F6E B7               OR A
 588+ 7F6F 78               LD A, B
 589+ 7F70 C8               RET Z
 590+ 7F71 3A E0 99         LD A, (MusicSpeedShift)
