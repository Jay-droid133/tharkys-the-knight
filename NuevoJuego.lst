 668+ A53D                  ; === STATE_SCARED: pausa dramatica + huida ===
 669+ A53D              .peScared:
 670+ A53D DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 671+ A541 C2 06 A6         JP NZ, .peScaredFresh
 672+ A544
 673+ A544                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 674+ A544 3A 04 B9         LD A, (ScareTimer)
 675+ A547 FE 33            CP SCARE_FLEE_THRESHOLD + 1
 676+ A549 DA E9 A5         JP C, .peScaredFlee
 677+ A54C                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 678+ A54C                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 679+ A54C DD 36 06 00      LD (IX+ENT_DELTAX), 0
 680+ A550 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 681+ A554                  ; Shake monster-only (nasties durante bells no se agitan)
 682+ A554 DD 7E 01         LD A, (IX+ENT_TYPE)
 683+ A557 FE 02            CP TYPE_MONSTER
 684+ A559 C2 CF A5         JP NZ, .peScaredSpriteToggle
 685+ A55C                  ; --- Shake ---
 686+ A55C CD 9F 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 687+ A55F 5F               LD E, A
 688+ A560 16 00            LD D, 0
 689+ A562 21 F9 90         LD HL, MonsterAiFlags
 690+ A565 19               ADD HL, DE
 691+ A566 7E               LD A, (HL)
 692+ A567 CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 693+ A569 20 15            JR NZ, .peShakeActive
 694+ A56B                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 695+ A56B F6 08            OR MAI_FLAG_SHAKE_SAVED
 696+ A56D 77               LD (HL), A
 697+ A56E 21 97 5F         LD HL, MonsterShakeOrigX
 698+ A571 19               ADD HL, DE
 699+ A572 DD 7E 03         LD A, (IX+ENT_POSX)
 700+ A575 77               LD (HL), A
 701+ A576 21 9A 5F         LD HL, MonsterShakeOrigY
 702+ A579 19               ADD HL, DE
