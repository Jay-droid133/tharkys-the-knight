1616+ F57B              ; ==============================================================================
1617+ F57B              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1618+ F57B              ; ==============================================================================
1619+ F57B              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1620+ F57B              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1621+ F57B              ; suficiente para corromper visualmente).
1622+ F57B              ; IN: IX = entity ptr.
1623+ F57B              ; ==============================================================================
1624+ F57B              RedrawTrappedMonster:
1625+ F57B                  ; --- Erase viejo en (OLDX, OLDY) ---
1626+ F57B CD F4 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1627+ F57E DD 7E 0D         LD A, (IX+ENT_OLDY)
1628+ F581 57               LD D, A
1629+ F582 DD 7E 0C         LD A, (IX+ENT_OLDX)
1630+ F585 5F               LD E, A
1631+ F586 DD E5            PUSH IX
1632+ F588 DD 2A 7C A4      LD IX, (OldSprAddr)
1633+ F58C CD E7 99         CALL DrawSprite
1634+ F58F DD E1            POP IX
1635+ F591                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1636+ F591                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1637+ F591 DD 56 0D         LD D, (IX+ENT_OLDY)
1638+ F594 DD 5E 0C         LD E, (IX+ENT_OLDX)
1639+ F597 CD 1C D3         CALL RestoreOldAttr
1640+ F59A                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1641+ F59A                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1642+ F59A                  ; reponer attrs de pickups que el flujo de entidades pisa con
1643+ F59A                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1644+ F59A                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1645+ F59A                  ; estar bajo el monster.
1646+ F59A DD E5            PUSH IX
1647+ F59C CD 26 DA         CALL RefreshPickupAttrs
1648+ F59F DD E1            POP IX
1649+ F5A1                  ; --- Compute new draw pos ---
1650+ F5A1 CD 7E A4         CALL CalcDrawX
1651+ F5A4 CD 16 9F         CALL ComputeEnemyDrawY
1652+ F5A7                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1653+ F5A7 CD C3 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1654+ F5AA 3A DD 82         LD A, (EnemyDrawY)
1655+ F5AD 57               LD D, A
1656+ F5AE DD 7E 0F         LD A, (IX+ENT_DRAWX)
1657+ F5B1 5F               LD E, A
1658+ F5B2 DD E5            PUSH IX
1659+ F5B4 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
1660+ F5B8 CD 04 9B         CALL CalcEntityAttrSize
1661+ F5BB DD E1            POP IX
1662+ F5BD 3A DD 82         LD A, (EnemyDrawY)
1663+ F5C0 57               LD D, A
1664+ F5C1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1665+ F5C4 5F               LD E, A
1666+ F5C5 DD 7E 05         LD A, (IX+ENT_ATTR)
1667+ F5C8 CD D7 9A         CALL SetEntityAttr
1668+ F5CB                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1669+ F5CB 3A DD 82         LD A, (EnemyDrawY)
1670+ F5CE 57               LD D, A
1671+ F5CF DD 7E 0F         LD A, (IX+ENT_DRAWX)
1672+ F5D2 5F               LD E, A
1673+ F5D3 DD E5            PUSH IX
1674+ F5D5 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
1675+ F5D9 CD E7 99         CALL DrawSprite
1676+ F5DC DD E1            POP IX
1677+ F5DE                  ; --- Save OLD = current ---
1678+ F5DE DD 7E 0F         LD A, (IX+ENT_DRAWX)
1679+ F5E1 DD 77 0C         LD (IX+ENT_OLDX), A
1680+ F5E4 3A DD 82         LD A, (EnemyDrawY)
1681+ F5E7 DD 77 0D         LD (IX+ENT_OLDY), A
1682+ F5EA DD 7E 00         LD A, (IX+ENT_SPRITEID)
1683+ F5ED DD 77 0E         LD (IX+ENT_OLDSPRID), A
1684+ F5F0 C9               RET
