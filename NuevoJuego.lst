3612+ B66B 00           StaminaRegenCtr:  DEFB 0             ; Sub-counter para regeneracion
3613+ B66C 00           HealthRegenCtr:   DEFB 0             ; Sub-counter para regeneracion de salud
3614+ B66D 00           MonsterKbDespawn: DEFB 0            ; Flag: monster salio de pantalla por knockback
3615+ B66E 00           MonstersActive:   DEFB 0            ; Flag: monsters han sido invocados (00:30+)
3616+ B66F 00 00 00     MonsterReturnTimer: DEFB 0, 0, 0    ; Timer de regreso por monster (0=inactivo)
