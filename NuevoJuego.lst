 123+ E560              UpdateGameClock:
 124+ E560 3A DF 81         LD A, (TimeFrozen)
 125+ E563 B7               OR A
 126+ E564 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 127+ E565 21 C6 E3         LD HL, GameSubMinute
 128+ E568 34               INC (HL)
 129+ E569 3A C9 E3         LD A, (SubMinuteMax)
 130+ E56C BE               CP (HL)
 131+ E56D C0               RET NZ
 132+ E56E
 133+ E56E AF               XOR A
 134+ E56F 32 C6 E3         LD (GameSubMinute), A
 135+ E572 21 C7 E3         LD HL, GameMinutes
 136+ E575 34               INC (HL)
 137+ E576                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 138+ E576                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 139+ E576 3A C7 E3         LD A, (GameMinutes)
 140+ E579 FE 3C            CP 60
 141+ E57B C0               RET NZ
 142+ E57C
 143+ E57C AF               XOR A
 144+ E57D 32 C7 E3         LD (GameMinutes), A
 145+ E580 21 C8 E3         LD HL, GameHours
 146+ E583 34               INC (HL)
 147+ E584 7E               LD A, (HL)
 148+ E585 FE 18            CP 24
 149+ E587 20 04            JR NZ, .checkPhase
 150+ E589 AF               XOR A
 151+ E58A 32 C8 E3         LD (GameHours), A
