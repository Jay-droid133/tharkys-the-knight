  90+ 732E              ; ==============================================================================
  91+ 732E              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
  92+ 732E              ; ==============================================================================
  93+ 732E              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
  94+ 732E              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
  95+ 732E              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
  96+ 732E              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
  97+ 732E              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
  98+ 732E              ; direccion vieja (de la sala anterior).
  99+ 732E              ;
 100+ 732E              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 101+ 732E              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 102+ 732E              ; solo en transiciones — nunca en frames de gameplay normal.
 103+ 732E              ;
 104+ 732E              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 105+ 732E              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 106+ 732E              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 107+ 732E              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 108+ 732E              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 109+ 732E              ;
 110+ 732E              ; Destruye: AF, BC, DE, HL.
 111+ 732E              ; ==============================================================================
 112+ 732E              ForceComputeMagicCompassPath:
 113+ 732E AF               XOR A
 114+ 732F 32 CC 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 115+ 7332              .fcmcpLoop:
 116+ 7332 CD 4D 74         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 117+ 7335                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 118+ 7335 3A CC 5F         LD A, (MagicCompassBfsState)
 119+ 7338 B7               OR A
 120+ 7339 20 F7            JR NZ, .fcmcpLoop                    ; aun en progreso → otro chunk
 121+ 733B AF               XOR A
 122+ 733C 32 C2 5F         LD (MagicCompassPathDirty), A        ; ya recalculado, no necesita rerun
 123+ 733F                  ; Forzar tick INMEDIATO en la nueva sala: TickCounter=0 hace que
 124+ 733F                  ; UpdateMagicCompass dispare .umcTickFire en el siguiente frame, sin
 125+ 733F                  ; esperar a que el contador llegue a 0 de forma natural (que podia
 126+ 733F                  ; tardar hasta 50 frames = 1 segundo). El player ve flash + suena AY
 127+ 733F                  ; al instante de cruzar, con la flecha correcta.
 128+ 733F                  ; TickActiveFrames=0 mata cualquier flash residual del tick que estaba
 129+ 733F                  ; en curso en la sala anterior — evita 1-2 frames de bright apuntando
 130+ 733F                  ; a la dir vieja entre el cruce y el nuevo tick.
 131+ 733F 32 C4 5F         LD (MagicCompassTickCounter), A
 132+ 7342 32 C3 5F         LD (MagicCompassTickActiveFrames), A
 133+ 7345 C9               RET
