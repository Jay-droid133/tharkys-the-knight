 821+ E128 3E 0E            LD A, BCP_KEY_DROP
 822+ E12A 32 CC 82         LD (BankCutscenePhase), A
 823+ E12D C9               RET
 824+ E12E
 825+ E12E              ; ---- Phase 14: pausa con la llave visible → giro a camara ----
 826+ E12E              .bcPhKeyDrop:
 827+ E12E CD 19 E2         CALL BankCutsceneDecTimer
 828+ E131 C0               RET NZ
 829+ E132                  ; Player gira a camara final.
 830+ E132 DD 21 9E 81      LD IX, EntityTable
 831+ E136 3E 00            LD A, SPRID_IDLE
 832+ E138 DD 77 00         LD (IX+ENT_SPRITEID), A
 833+ E13B DD 77 08         LD (IX+ENT_ANIMBASE), A
 834+ E13E AF               XOR A
 835+ E13F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 836+ E142 CD 07 76         CALL TownGateRedrawPlayer_B7
