1096+ A4F2              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1097+ A4F2              ; ==============================================================================
1098+ A4F2              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1099+ A4F2              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1100+ A4F2              ; ==============================================================================
1101+ A4F2              GetSpriteAddr:
1102+ A4F2                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1103+ A4F2                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1104+ A4F2 3A 8A 8D         LD A, (CurrentPaging)
1105+ A4F5 E6 F8            AND $F8
1106+ A4F7 F6 06            OR 6
1107+ A4F9 32 8A 8D         LD (CurrentPaging), A
1108+ A4FC 01 FD 7F         LD BC, $7FFD
1109+ A4FF ED 79            OUT (C), A                  ; bank 6 paginado
1110+ A501 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1111+ A504 6F               LD L, A
1112+ A505 26 00            LD H, 0
1113+ A507 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1114+ A508 11 B7 E7         LD DE, SpriteFrameTable
1115+ A50B 19               ADD HL, DE
1116+ A50C 5E               LD E, (HL)
1117+ A50D 23               INC HL
1118+ A50E 56               LD D, (HL)
1119+ A50F ED 53 21 A5      LD (SpriteAddrTemp), DE
1120+ A513 3A 8A 8D         LD A, (CurrentPaging)
1121+ A516 E6 F8            AND $F8
1122+ A518 32 8A 8D         LD (CurrentPaging), A
1123+ A51B 01 FD 7F         LD BC, $7FFD
1124+ A51E ED 79            OUT (C), A                  ; bank 0 de vuelta
1125+ A520 C9               RET
1126+ A521
1127+ A521 00 00        SpriteAddrTemp: DEFW 0
1128+ A523
1129+ A523              ; ==============================================================================
1130+ A523              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1131+ A523              ; ==============================================================================
1132+ A523              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1133+ A523              ; Salida:   DE = puntero al sprite data
1134+ A523              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1135+ A523              ; Preserva: IX
1136+ A523              ; Destruye: A, HL
1137+ A523              ; ==============================================================================
1138+ A523              GetOldSpriteAddr:
1139+ A523                  ; Paging inline (ver GetSpriteAddr)
1140+ A523 3A 8A 8D         LD A, (CurrentPaging)
1141+ A526 E6 F8            AND $F8
1142+ A528 F6 06            OR 6
1143+ A52A 32 8A 8D         LD (CurrentPaging), A
1144+ A52D 01 FD 7F         LD BC, $7FFD
1145+ A530 ED 79            OUT (C), A
1146+ A532 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1147+ A535 6F               LD L, A
1148+ A536 26 00            LD H, 0
1149+ A538 29               ADD HL, HL
1150+ A539 11 B7 E7         LD DE, SpriteFrameTable
1151+ A53C 19               ADD HL, DE
1152+ A53D 5E               LD E, (HL)
1153+ A53E 23               INC HL
1154+ A53F 56               LD D, (HL)
1155+ A540 ED 53 AB A4      LD (OldSprAddr), DE
1156+ A544 3A 8A 8D         LD A, (CurrentPaging)
1157+ A547 E6 F8            AND $F8
1158+ A549 32 8A 8D         LD (CurrentPaging), A
1159+ A54C 01 FD 7F         LD BC, $7FFD
1160+ A54F ED 79            OUT (C), A
1161+ A551 C9               RET
1162+ A552
1163+ A552              ; ==============================================================================
1164+ A552              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1165+ A552              ; ==============================================================================
1166+ A552              ; Entrada: A = SpriteID
1167+ A552              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1168+ A552              ; Destruye: A, DE, HL
1169+ A552              ; ==============================================================================
1170+ A552              GetSpriteDims:
1171+ A552                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1172+ A552                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1173+ A552 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1174+ A553 26 00            LD H, 0
1175+ A555 3A 8A 8D         LD A, (CurrentPaging)
1176+ A558 E6 F8            AND $F8
1177+ A55A F6 06            OR 6
1178+ A55C 32 8A 8D         LD (CurrentPaging), A
1179+ A55F 01 FD 7F         LD BC, $7FFD
1180+ A562 ED 79            OUT (C), A                  ; bank 6 paginado
1181+ A564 29               ADD HL, HL
1182+ A565 11 B7 E7         LD DE, SpriteFrameTable
1183+ A568 19               ADD HL, DE
1184+ A569 5E               LD E, (HL)
1185+ A56A 23               INC HL
1186+ A56B 56               LD D, (HL)                  ; DE = ptr al sprite data
1187+ A56C 1A               LD A, (DE)                  ; width_bytes
1188+ A56D 87               ADD A, A
1189+ A56E 87               ADD A, A
1190+ A56F 87               ADD A, A                    ; × 8 = width_px
1191+ A570 47               LD B, A
1192+ A571 13               INC DE
1193+ A572 1A               LD A, (DE)                  ; height_px
1194+ A573 4F               LD C, A
1195+ A574                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1196+ A574 78               LD A, B
1197+ A575 32 92 A5         LD (GsdSavedB), A
1198+ A578 79               LD A, C
1199+ A579 32 93 A5         LD (GsdSavedC), A
1200+ A57C 3A 8A 8D         LD A, (CurrentPaging)
1201+ A57F E6 F8            AND $F8
1202+ A581 32 8A 8D         LD (CurrentPaging), A
1203+ A584 01 FD 7F         LD BC, $7FFD
1204+ A587 ED 79            OUT (C), A                  ; bank 0 de vuelta
1205+ A589 3A 92 A5         LD A, (GsdSavedB)
1206+ A58C 47               LD B, A
1207+ A58D 3A 93 A5         LD A, (GsdSavedC)
1208+ A590 4F               LD C, A
1209+ A591 C9               RET
1210+ A592
1211+ A592 00           GsdSavedB: DEFB 0
1212+ A593 00           GsdSavedC: DEFB 0
1213+ A594
1214+ A594              ; ==============================================================================
1215+ A594              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1216+ A594              ; ==============================================================================
1217+ A594              ; IX = puntero a la entidad del player (slot 0)
1218+ A594              ; ==============================================================================
1219+ A594              UpdatePlayer:
1220+ A594 CD BC A5         CALL UpdatePlayerState
1221+ A597 CD DA A6         CALL UpdatePlayerMovement
1222+ A59A CD 53 A9         CALL UpdatePlayerAnimation
1223+ A59D                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1224+ A59D                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1225+ A59D                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1226+ A59D                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1227+ A59D                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1228+ A59D                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1229+ A59D                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1230+ A59D                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1231+ A59D                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1232+ A59D                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1233+ A59D                  ; tickea a tiempo y reescribe SPRITEID).
1234+ A59D 3A F4 82         LD A, (PlayerRespawnTimer)
1235+ A5A0 B7               OR A
1236+ A5A1 C8               RET Z
1237+ A5A2 3A A0 81         LD A, (GameFrameCounter)
1238+ A5A5 E6 02            AND 2
1239+ A5A7 28 0D            JR Z, .pblOffFrame
1240+ A5A9                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1241+ A5A9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1242+ A5AC FE 74            CP SPRID_PLAYER_BLANK
1243+ A5AE C0               RET NZ                              ; sprite válido (anim viva) → keep
1244+ A5AF DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1245+ A5B2 DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1246+ A5B5 C9               RET
1247+ A5B6              .pblOffFrame:
1248+ A5B6 3E 74            LD A, SPRID_PLAYER_BLANK
1249+ A5B8 32 A3 81         LD (EntityTable), A
1250+ A5BB C9               RET
1251+ A5BC
1252+ A5BC              ; ==============================================================================
1253+ A5BC              ; UpdatePlayerState - Determina estado y direccion desde input
1254+ A5BC              ; ==============================================================================
1255+ A5BC              UpdatePlayerState:
1256+ A5BC 3A B3 82         LD A, (InputDirection)
1257+ A5BF 47               LD B, A
1258+ A5C0 3A B4 82         LD A, (InputFire)
1259+ A5C3 4F               LD C, A
1260+ A5C4
1261+ A5C4                  ; Sin input → idle (salvo si ataque en curso)
1262+ A5C4 78               LD A, B
1263+ A5C5 B1               OR C
1264+ A5C6 20 17            JR NZ, .notIdle
1265+ A5C8                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1266+ A5C8 3A 84 B3         LD A, (AttackTimer)
1267+ A5CB B7               OR A
1268+ A5CC 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1269+ A5CE DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1270+ A5D2                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1271+ A5D2 DD 7E 0A         LD A, (IX+ENT_DIR)
1272+ A5D5 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1273+ A5D7 DD 77 0A         LD (IX+ENT_DIR), A
1274+ A5DA                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1275+ A5DA AF               XOR A
1276+ A5DB 32 86 B3         LD (AttackDebounce), A
1277+ A5DE C9               RET
1278+ A5DF
1279+ A5DF              .notIdle:
1280+ A5DF                  ; Guardar direccion actual en bits 0-3
1281+ A5DF DD 7E 0A         LD A, (IX+ENT_DIR)
1282+ A5E2 E6 F0            AND $F0                     ; Mantener lastHDir
1283+ A5E4 B0               OR B                        ; Añadir dir actual
1284+ A5E5 DD 77 0A         LD (IX+ENT_DIR), A
1285+ A5E8
1286+ A5E8                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1287+ A5E8 3A 84 B3         LD A, (AttackTimer)
1288+ A5EB B7               OR A
1289+ A5EC 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1290+ A5EE 78               LD A, B
1291+ A5EF E6 0C            AND DIR_E | DIR_W
1292+ A5F1 28 0E            JR Z, .noHorizUpdate
1293+ A5F3                  ; Guardar en bits 4-7
1294+ A5F3 07               RLCA
1295+ A5F4 07               RLCA
1296+ A5F5 07               RLCA
1297+ A5F6 07               RLCA                        ; Shift a bits 4-7
1298+ A5F7 4F               LD C, A                     ; C = lastHDir en bits 4-7
1299+ A5F8 DD 7E 0A         LD A, (IX+ENT_DIR)
1300+ A5FB E6 0F            AND $0F                     ; Mantener dir actual
1301+ A5FD B1               OR C                        ; Añadir lastHDir
1302+ A5FE DD 77 0A         LD (IX+ENT_DIR), A
1303+ A601              .noHorizUpdate:
1304+ A601
1305+ A601                  ; --- Consumir/regenerar stamina ---
1306+ A601 CD 86 AA         CALL UpdateStamina
1307+ A604                  ; --- Auto-select sword mode segun stamina ---
