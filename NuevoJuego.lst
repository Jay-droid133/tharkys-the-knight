2705+ B07F              ; ==============================================================================
2706+ B07F              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2707+ B07F              ; ==============================================================================
2708+ B07F              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2709+ B07F              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2710+ B07F              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2711+ B07F              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2712+ B07F              ; ==============================================================================
2713+ B07F              UpdateMonster:
2714+ B07F                  ; --- Stun: knockback + pausa tras golpe del player ---
2715+ B07F DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2716+ B082 B7               OR A
2717+ B083 CA B8 B2         JP Z, .moNormal
2718+ B086 DD 35 0A         DEC (IX+ENT_DIR)
2719+ B089 20 0B            JR NZ, .moStunActive
2720+ B08B                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2721+ B08B DD 36 06 00      LD (IX+ENT_DELTAX), 0
2722+ B08F DD 36 07 00      LD (IX+ENT_DELTAY), 0
2723+ B093 C3 B8 B2         JP .moNormal
2724+ B096
2725+ B096              .moStunActive:
2726+ B096                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2727+ B096 FE 06            CP MONSTER_STUN_PAUSE
2728+ B098 DA 49 B4         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2729+ B09B                  ; Knockback: aplicar movimiento con collision check
2730+ B09B DD 56 06         LD D, (IX+ENT_DELTAX)
2731+ B09E DD 5E 07         LD E, (IX+ENT_DELTAY)
2732+ B0A1 7A               LD A, D
2733+ B0A2 B3               OR E
2734+ B0A3 CA 49 B4         JP Z, .moAnimate
2735+ B0A6                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2736+ B0A6 D5               PUSH DE
2737+ B0A7 DD 7E 03         LD A, (IX+ENT_POSX)
2738+ B0AA 32 E1 B5         LD (.moSvX), A
2739+ B0AD DD 7E 04         LD A, (IX+ENT_POSY)
2740+ B0B0 32 E2 B5         LD (.moSvY), A
2741+ B0B3                  ; Calcular nueva posicion
2742+ B0B3 DD 7E 03         LD A, (IX+ENT_POSX)
