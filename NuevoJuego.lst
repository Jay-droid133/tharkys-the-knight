 615+ E0C2              ; ---- Phase 10: hold corto antes de la mano ----
 616+ E0C2              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 617+ E0C2              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 618+ E0C2              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 619+ E0C2              ;
 620+ E0C2              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 621+ E0C2              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 622+ E0C2              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 623+ E0C2              ; mano "no no" aparece (HAND_NO_NO).
 624+ E0C2              ;
 625+ E0C2              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 626+ E0C2              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 627+ E0C2              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 628+ E0C2              .bcPhPreHand:
 629+ E0C2 CD BC E2         CALL BankCutsceneDecTimer
 630+ E0C5 C0               RET NZ
