 106  CB3F                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ CB3F              ; ==============================================================================
   2+ CB3F              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ CB3F              ; ==============================================================================
   4+ CB3F              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ CB3F              ; Para cada shift S:
   6+ CB3F              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ CB3F              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ CB3F              ;
   9+ CB3F              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ CB3F              ;
  11+ CB3F              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ CB3F              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ CB3F              ;
  14+ CB3F              ; Calculo de B desde X%8:
  15+ CB3F              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / OR SHIFT_TABLE_BASE
  16+ CB3F              ; ==============================================================================
  17+ CB3F
  18+ CB3F 00 00 00...      ALIGN 4096
  19+ D000              ShiftTables:
  20+ D000                  LUA ALLPASS
  21+ D000 ~                for shift = 1, 7 do
  22+ D000 ~                    -- High part: byte >> shift
  23+ D000 ~                    for i = 0, 255 do
  24+ D000 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ D000 ~                    end
  26+ D000 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ D000 ~                    for i = 0, 255 do
  28+ D000 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ D000 ~                    end
  30+ D000 ~                end
  31+ D000 00 00 01 01      ENDLUA
