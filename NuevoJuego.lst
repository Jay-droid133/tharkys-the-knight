 525+ 8FE4                  ; Leer puntero record
 526+ 8FE4 5E               LD E, (HL)
 527+ 8FE5 23               INC HL
 528+ 8FE6 56               LD D, (HL)
 529+ 8FE7 EB               EX DE, HL                       ; HL = record ptr
 530+ 8FE8
 531+ 8FE8 7E               LD A, (HL)
