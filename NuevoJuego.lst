 272+ 6A1F              ; ==============================================================================
 273+ 6A1F              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 274+ 6A1F              ; ==============================================================================
 275+ 6A1F              ; IN: A = frame idx (0..2)
 276+ 6A1F              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 277+ 6A1F              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 278+ 6A1F              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 279+ 6A1F              ; Destruye: AF, BC, DE, HL, IX.
 280+ 6A1F              ; ==============================================================================
 281+ 6A1F              DrawSmokeFrameXor:
 282+ 6A1F 87               ADD A, A                                ; *2 (entries de 2 bytes)
 283+ 6A20 6F               LD L, A
 284+ 6A21 26 00            LD H, 0
 285+ 6A23 11 19 6A         LD DE, SmokeFramePtrTable
 286+ 6A26 19               ADD HL, DE
 287+ 6A27 5E               LD E, (HL)
 288+ 6A28 23               INC HL
 289+ 6A29 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 290+ 6A2A                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 291+ 6A2A                  ; Source y destino accesibles sin paging (milestones bank 0,
 292+ 6A2A                  ; BgSpriteBuffer en RAM principal).
 293+ 6A2A EB               EX DE, HL                               ; HL = source
 294+ 6A2B 11 F5 86         LD DE, BgSpriteBuffer
 295+ 6A2E 01 22 00         LD BC, 34
 296+ 6A31 ED B0            LDIR
 297+ 6A33                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 298+ 6A33 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 299+ 6A36 57               LD D, A
 300+ 6A37 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 301+ 6A3A 5F               LD E, A
 302+ 6A3B C3 31 6B         JP DrawBgSprite16XorAtPixel
 303+ 6A3E
 304+ 6A3E              ; ==============================================================================
 305+ 6A3E              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 306+ 6A3E              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 307+ 6A3E              ; ==============================================================================
 308+ 6A3E              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 309+ 6A3E              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 310+ 6A3E              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 311+ 6A3E              ; uniformemente negro -- el efecto que pidio el usuario.
 312+ 6A3E              ;
 313+ 6A3E              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 314+ 6A3E              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 315+ 6A3E              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 316+ 6A3E              ; Destruye: AF, BC, DE, HL.
 317+ 6A3E              ; ==============================================================================
 318+ 6A3E              ClearSmokeAttrs:
 319+ 6A3E                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 320+ 6A3E 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 321+ 6A41 CB 3F            SRL A
 321+ 6A43 CB 3F          SRL A
 321+ 6A45 CB 3F          SRL A                   ; A = char Y (post-HUD)
 322+ 6A47 26 00            LD H, 0
 323+ 6A49 6F               LD L, A
 324+ 6A4A 29               ADD HL, HL                              ; *2
 325+ 6A4B 29               ADD HL, HL                              ; *4
 326+ 6A4C 29               ADD HL, HL                              ; *8
 327+ 6A4D 29               ADD HL, HL                              ; *16
 328+ 6A4E 29               ADD HL, HL                              ; *32
 329+ 6A4F 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 330+ 6A52 CB 3F            SRL A
 330+ 6A54 CB 3F          SRL A
 330+ 6A56 CB 3F          SRL A                   ; A = char X
 331+ 6A58 5F               LD E, A
 332+ 6A59 16 00            LD D, 0
 333+ 6A5B 19               ADD HL, DE
 334+ 6A5C 11 00 58         LD DE, $5800
 335+ 6A5F 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 336+ 6A60 AF               XOR A                                   ; paper black, ink black
 337+ 6A61 77               LD (HL), A                              ; (charY, charX)
 338+ 6A62 23               INC HL
 339+ 6A63 77               LD (HL), A                              ; (charY, charX+1)
 340+ 6A64 11 1F 00         LD DE, 31
 341+ 6A67 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 342+ 6A68 77               LD (HL), A
 343+ 6A69 23               INC HL
 344+ 6A6A 77               LD (HL), A                              ; (charY+1, charX+1)
 345+ 6A6B C9               RET
