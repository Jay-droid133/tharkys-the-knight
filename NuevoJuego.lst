2060+ AA54              ; ==============================================================================
2061+ AA54              UpdateStamina:
2062+ AA54                  ; --- Regenerar salud (siempre, lento) ---
2063+ AA54                  ; Regen-por-tiempo de salud desactivada para subir dificultad.
2064+ AA54                  ; Salud solo se recupera por pozo / pickups. Reactivar quitando los `;`
2065+ AA54                  ; (candidato a difficulty level "fácil" en el futuro).
2066+ AA54                  ; LD A, (PlayerHealth)
2067+ AA54                  ; CP HEALTH_MAX
2068+ AA54                  ; JR Z, .usHealthFull
2069+ AA54                  ; LD HL, HealthRegenCtr
2070+ AA54                  ; INC (HL)
2071+ AA54                  ; LD A, (HL)
2072+ AA54                  ; CP HEALTH_REGEN_RATE
2073+ AA54                  ; JR C, .usHealthFull
2074+ AA54                  ; LD (HL), 0
2075+ AA54                  ; LD A, (PlayerHealth)
2076+ AA54                  ; INC A
2077+ AA54                  ; LD (PlayerHealth), A
2078+ AA54              .usHealthFull:
2079+ AA54                  ; --- Stamina: consumir o regenerar ---
2080+ AA54 DD 7E 02         LD A, (IX+ENT_STATE)
2081+ AA57 FE 02            CP STATE_FIGHTING
2082+ AA59 28 01            JR Z, .usDrain
2083+ AA5B                  ; No atacando: regenerar
2084+ AA5B                  ; Regen-por-tiempo de stamina desactivada para subir dificultad.
2085+ AA5B                  ; Stamina solo se recupera por pozo / pickups. Reactivar quitando los `;`
2086+ AA5B                  ; y eliminando el RET justo debajo (candidato a difficulty level "fácil").
2087+ AA5B C9               RET
2088+ AA5C                  ; LD A, (PlayerStamina)
2089+ AA5C                  ; CP STAMINA_MAX
2090+ AA5C                  ; RET Z                               ; Ya al maximo
2091+ AA5C                  ; LD HL, StaminaRegenCtr
2092+ AA5C                  ; INC (HL)
2093+ AA5C                  ; LD A, (HL)
2094+ AA5C                  ; CP STAMINA_REGEN_RATE
2095+ AA5C                  ; RET C                               ; Aun no toca
2096+ AA5C                  ; LD (HL), 0                          ; Reset counter
2097+ AA5C                  ; LD A, (PlayerStamina)
2098+ AA5C                  ; INC A
2099+ AA5C                  ; LD (PlayerStamina), A
2100+ AA5C                  ; RET
2101+ AA5C              .usDrain:
