 831+ F2B7              ; ==============================================================================
 832+ F2B7              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 833+ F2B7              ; ==============================================================================
 834+ F2B7              SetCompassAttrs:
 835+ F2B7 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 836+ F2BA 77               LD (HL), A
 837+ F2BB 23               INC HL
 838+ F2BC 77               LD (HL), A
 839+ F2BD 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 840+ F2C0 77               LD (HL), A
 841+ F2C1 23               INC HL
 842+ F2C2 77               LD (HL), A
 843+ F2C3 C9               RET
