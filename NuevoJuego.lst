 626+ E7E3              ; Limpia 8 scan lines en VRAM (DE)
 627+ E7E3              .clearChar:
 628+ E7E3 06 08            LD B, 8
 629+ E7E5 AF               XOR A
 630+ E7E6              .clearLoop:
 631+ E7E6 12               LD (DE), A
 632+ E7E7 14               INC D
 633+ E7E8 10 FC            DJNZ .clearLoop
 634+ E7EA C9               RET
