 453+ A084
 454+ A084              ; ==============================================================================
 455+ A084              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 456+ A084              ; ==============================================================================
 457+ A084              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 458+ A084              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 459+ A084              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 460+ A084              ; ==============================================================================
 461+ A084              ProcessEnemies:
 462+ A084 3E 00            LD A, 0
 463+ A086 32 CF A0         LD (.peCount), A
 464+ A089 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 465+ A08B
 466+ A08B              .peLoop:
 467+ A08B C5               PUSH BC
 468+ A08C
 469+ A08C                  ; Calcular IX desde EnemyStepIdx
 470+ A08C 3A 0A 83         LD A, (EnemyStepIdx)
 471+ A08F C6 01            ADD A, SLOT_MONSTER0
 472+ A091 6F               LD L, A
 473+ A092 26 00            LD H, 0
 474+ A094 29               ADD HL, HL
 475+ A095 29               ADD HL, HL
 476+ A096 29               ADD HL, HL
 477+ A097 29               ADD HL, HL                          ; × ENT_SIZE (16)
 478+ A098 11 A3 81         LD DE, EntityTable
 479+ A09B 19               ADD HL, DE
 480+ A09C E5               PUSH HL
 481+ A09D DD E1            POP IX
 482+ A09F
 483+ A09F                  ; Avanzar indice round-robin
 484+ A09F 3A 0A 83         LD A, (EnemyStepIdx)
 485+ A0A2 3C               INC A
 486+ A0A3 FE 09            CP NUM_MONSTERS + NUM_NASTIES
 487+ A0A5 38 01            JR C, .peNoWrap
 488+ A0A7 AF               XOR A
 489+ A0A8              .peNoWrap:
 490+ A0A8 32 0A 83         LD (EnemyStepIdx), A
 491+ A0AB
 492+ A0AB                  ; Slot activo?
 493+ A0AB DD 7E 01         LD A, (IX+ENT_TYPE)
 494+ A0AE B7               OR A
 495+ A0AF 28 16            JR Z, .peSkip
 496+ A0B1
 497+ A0B1                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 498+ A0B1 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 499+ A0B5 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 500+ A0B6
 501+ A0B6                  ; Procesar esta entidad completa (erase + logic + draw)
 502+ A0B6 CD D0 A0         CALL ProcessOneEnemy
 503+ A0B9
 504+ A0B9                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 505+ A0B9 F1               POP AF
 506+ A0BA 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 507+ A0BC
 508+ A0BC                  ; Budget check
 509+ A0BC 3A CF A0         LD A, (.peCount)
 510+ A0BF 3C               INC A
 511+ A0C0 32 CF A0         LD (.peCount), A
 512+ A0C3 FE 02            CP MAX_ENEMIES_PER_FRAME
 513+ A0C5 30 06            JR NC, .peDone
 514+ A0C7
 515+ A0C7              .peSkip:
 516+ A0C7 C1               POP BC
 517+ A0C8 05               DEC B
 518+ A0C9 C2 8B A0         JP NZ, .peLoop
 519+ A0CC C9               RET
 520+ A0CD
 521+ A0CD              .peDone:
 522+ A0CD C1               POP BC
 523+ A0CE C9               RET
 524+ A0CF
 525+ A0CF 00           .peCount: DEFB 0
 526+ A0D0
 527+ A0D0              ; ==============================================================================
 528+ A0D0              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 529+ A0D0              ; ==============================================================================
 530+ A0D0              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 531+ A0D0              ; ==============================================================================
 532+ A0D0              ProcessOneEnemy:
 533+ A0D0                  ; --- Frozen monster gate (durante muerte del player) ---
 534+ A0D0                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 535+ A0D0                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 536+ A0D0                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 537+ A0D0 3A F8 82         LD A, (MonstersFrozen)
 538+ A0D3 B7               OR A
 539+ A0D4 28 08            JR Z, .peDispatch
 540+ A0D6 DD 7E 01         LD A, (IX+ENT_TYPE)
 541+ A0D9 FE 02            CP TYPE_MONSTER
 542+ A0DB CA 43 A1         JP Z, .peCalcAndDraw
 543+ A0DE              .peDispatch:
 544+ A0DE                  ; --- Dispatch segun estado ---
 545+ A0DE DD 7E 02         LD A, (IX+ENT_STATE)
 546+ A0E1 FE 03            CP STATE_DYING
 547+ A0E3 CA 55 A3         JP Z, .peDying
 548+ A0E6 FE 04            CP STATE_SPAWNING
 549+ A0E8 CA 0A A4         JP Z, .peSpawning
 550+ A0EB FE 05            CP STATE_SCARED
 551+ A0ED CA 32 A2         JP Z, .peScared
 552+ A0F0 FE 06            CP STATE_ATTACKING
 553+ A0F2 CA 25 A2         JP Z, .peAttacking
 554+ A0F5
 555+ A0F5                  ; === STATE_RUNNING ===
 556+ A0F5                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 557+ A0F5 3A 25 B6         LD A, (ScareTimer)
 558+ A0F8 B7               OR A
 559+ A0F9 28 1E            JR Z, .peRunning
 560+ A0FB DD 7E 01         LD A, (IX+ENT_TYPE)
 561+ A0FE FE 03            CP TYPE_NASTY
 562+ A100 28 08            JR Z, .peDoScare
 563+ A102 FE 02            CP TYPE_MONSTER
 564+ A104 20 13            JR NZ, .peRunning
 565+ A106                  ; Monster: limpiar stun antes de asustar
 566+ A106 DD 36 0A 00      LD (IX+ENT_DIR), 0
 567+ A10A              .peDoScare:
 568+ A10A DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 569+ A10E DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 570+ A112 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 571+ A116 C3 32 A2         JP .peScared
 572+ A119              .peRunning:
 573+ A119 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 574+ A11D C2 C9 A1         JP NZ, .peFresh
