6969+ C5D8 20 16            JR NZ, .daFrameSet
6970+ C5DA DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6971+ C5DE DD 7E 00         LD A, (IX+ENT_SPRITEID)
6972+ C5E1 47               LD B, A
6973+ C5E2 DD 96 08         SUB (IX+ENT_ANIMBASE)
6974+ C5E5 E6 01            AND 1
6975+ C5E7 20 03            JR NZ, .daFrameDec
6976+ C5E9 04               INC B
6977+ C5EA 18 01            JR .daFrameStore
6978+ C5EC              .daFrameDec:
6979+ C5EC 05               DEC B
