 357+ 9F2C              ; ==============================================================================
 358+ 9F2C              SaveEntityAttr:
 359+ 9F2C                  ; Paging inline (ver nota en DrawSprite)
 360+ 9F2C 3A C9 90         LD A, (CurrentPaging)
 361+ 9F2F E6 F8            AND $F8
 362+ 9F31 F6 06            OR 6
 363+ 9F33 32 C9 90         LD (CurrentPaging), A
 364+ 9F36 01 FD 7F         LD BC, $7FFD
 365+ 9F39 ED 79            OUT (C), A
 366+ 9F3B CD 4C 9F         CALL _SaveEntityAttrImpl
 367+ 9F3E 3A C9 90         LD A, (CurrentPaging)
 368+ 9F41 E6 F8            AND $F8
 369+ 9F43 32 C9 90         LD (CurrentPaging), A
 370+ 9F46 01 FD 7F         LD BC, $7FFD
 371+ 9F49 ED 79            OUT (C), A
 372+ 9F4B C9               RET
 373+ 9F4C
 374+ 9F4C              _SaveEntityAttrImpl:
 375+ 9F4C                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9F4C DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9F4F 47               LD B, A
 378+ 9F50 7B               LD A, E                     ; X pixel (raw)
 379+ 9F51 E6 07            AND 7
 380+ 9F53 28 01            JR Z, .noExtraW
 381+ 9F55 04               INC B                       ; +1 columna si no alineado
 382+ 9F56              .noExtraW:
 383+ 9F56 78               LD A, B
 384+ 9F57 32 BC 9F         LD (EntityAttrW), A
 385+ 9F5A
 386+ 9F5A                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9F5A 7A               LD A, D                     ; Y pixel (raw)
 388+ 9F5B E6 07            AND 7                       ; Y offset dentro del char
 389+ 9F5D 4F               LD C, A
 390+ 9F5E DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9F61 81               ADD A, C                    ; + Y offset
 392+ 9F62 C6 07            ADD A, 7
 393+ 9F64 0F               RRCA
 394+ 9F65 0F               RRCA
 395+ 9F66 0F               RRCA
 396+ 9F67 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9F69 32 BD 9F         LD (EntityAttrH), A
 398+ 9F6C
 399+ 9F6C CD 26 A1         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9F6F 11 AC 9F         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9F72
 402+ 9F72 3A BD 9F         LD A, (EntityAttrH)
 403+ 9F75 4F               LD C, A                     ; C = filas
 404+ 9F76              .saveRow:
 405+ 9F76 3A BC 9F         LD A, (EntityAttrW)
 406+ 9F79 47               LD B, A                     ; B = columnas
 407+ 9F7A E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9F7B              .saveCol:
 409+ 9F7B 7E               LD A, (HL)
 410+ 9F7C 12               LD (DE), A
 411+ 9F7D 23               INC HL
 412+ 9F7E 13               INC DE
 413+ 9F7F 10 FA            DJNZ .saveCol
 414+ 9F81 E1               POP HL
 415+ 9F82                  ; Siguiente fila attr: HL += 32
 416+ 9F82 D5               PUSH DE
 417+ 9F83 11 20 00         LD DE, 32
 418+ 9F86 19               ADD HL, DE
 419+ 9F87 D1               POP DE
 420+ 9F88 0D               DEC C
 421+ 9F89 20 EB            JR NZ, .saveRow
 422+ 9F8B C9               RET
 423+ 9F8C
 424+ 9F8C              ; ==============================================================================
 425+ 9F8C              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9F8C              ; ==============================================================================
 427+ 9F8C              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9F8C              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9F8C              ;
 430+ 9F8C              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9F8C              ; ==============================================================================
 432+ 9F8C              RestoreEntityAttr:
 433+ 9F8C CD 26 A1         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9F8F 11 AC 9F         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9F92
 436+ 9F92 3A BD 9F         LD A, (EntityAttrH)
 437+ 9F95 4F               LD C, A
 438+ 9F96              .restRow:
 439+ 9F96 3A BC 9F         LD A, (EntityAttrW)
 440+ 9F99 47               LD B, A
 441+ 9F9A E5               PUSH HL
 442+ 9F9B              .restCol:
 443+ 9F9B 1A               LD A, (DE)
 444+ 9F9C 77               LD (HL), A
 445+ 9F9D 23               INC HL
 446+ 9F9E 13               INC DE
 447+ 9F9F 10 FA            DJNZ .restCol
 448+ 9FA1 E1               POP HL
 449+ 9FA2 D5               PUSH DE
 450+ 9FA3 11 20 00         LD DE, 32
 451+ 9FA6 19               ADD HL, DE
 452+ 9FA7 D1               POP DE
 453+ 9FA8 0D               DEC C
 454+ 9FA9 20 EB            JR NZ, .restRow
 455+ 9FAB C9               RET
 456+ 9FAC
 457+ 9FAC              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9FAC              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9FAC              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9FAC              ; ---
 461+ 9FAC 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9FBC 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9FBD 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9FBE 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ A0F0 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ A0F1
 467+ A0F1              ; ==============================================================================
 468+ A0F1              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A0F1              ; ==============================================================================
 470+ A0F1              ; Entrada: A = indice de entidad (0-16)
 471+ A0F1              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A0F1              ; ==============================================================================
 473+ A0F1              SetAttrSlot:
 474+ A0F1 32 F0 A0         LD (CurrentAttrSlot), A
 475+ A0F4                  ; Calcular offset: A * 18
 476+ A0F4 6F               LD L, A
 477+ A0F5 26 00            LD H, 0
 478+ A0F7 29               ADD HL, HL                  ; x2
 479+ A0F8 54               LD D, H
 480+ A0F9 5D               LD E, L                     ; DE = x2
 481+ A0FA 29               ADD HL, HL                  ; x4
 482+ A0FB 29               ADD HL, HL                  ; x8
 483+ A0FC 29               ADD HL, HL                  ; x16
 484+ A0FD 19               ADD HL, DE                  ; x18
 485+ A0FE 11 BE 9F         LD DE, SavedAttrTable
 486+ A101 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A102                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A102 11 AC 9F         LD DE, EntitySavedAttr
 489+ A105 01 12 00         LD BC, 18
 490+ A108 ED B0            LDIR
 491+ A10A C9               RET
 492+ A10B
 493+ A10B              ; ==============================================================================
 494+ A10B              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A10B              ; ==============================================================================
 496+ A10B              FlushAttrSlot:
 497+ A10B 3A F0 A0         LD A, (CurrentAttrSlot)
 498+ A10E 6F               LD L, A
 499+ A10F 26 00            LD H, 0
 500+ A111 29               ADD HL, HL                  ; x2
 501+ A112 54               LD D, H
 502+ A113 5D               LD E, L
 503+ A114 29               ADD HL, HL                  ; x4
 504+ A115 29               ADD HL, HL                  ; x8
 505+ A116 29               ADD HL, HL                  ; x16
 506+ A117 19               ADD HL, DE                  ; x18
 507+ A118 11 BE 9F         LD DE, SavedAttrTable
 508+ A11B 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A11C EB               EX DE, HL                   ; DE = destino
 510+ A11D 21 AC 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A120 01 12 00         LD BC, 18
 512+ A123 ED B0            LDIR
 513+ A125 C9               RET
 514+ A126
 515+ A126              ; ==============================================================================
 516+ A126              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A126              ; ==============================================================================
 518+ A126              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A126              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A126              ; ==============================================================================
 521+ A126              CalcAttrAddr:
 522+ A126 7A               LD A, D
 523+ A127 0F               RRCA
 524+ A128 0F               RRCA
 525+ A129 0F               RRCA
 526+ A12A E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A12C 6F               LD L, A
 528+ A12D 26 00            LD H, 0
 529+ A12F 29               ADD HL, HL
 530+ A130 29               ADD HL, HL
 531+ A131 29               ADD HL, HL
 532+ A132 29               ADD HL, HL
 533+ A133 29               ADD HL, HL                  ; HL = fila * 32
 534+ A134 7B               LD A, E
 535+ A135 0F               RRCA
 536+ A136 0F               RRCA
 537+ A137 0F               RRCA
 538+ A138 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A13A B5               OR L
 540+ A13B 6F               LD L, A
 541+ A13C 01 00 58         LD BC, ATTR_BASE
 542+ A13F 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A140 C9               RET
 544+ A141
 545+ A141              ; ==============================================================================
 546+ A141              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A141              ; ==============================================================================
 548+ A141              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A141              ; Salida: HL=direccion en VRAM
 550+ A141              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A141              ; ==============================================================================
 552+ A141              CalcPixelAddr:
 553+ A141 7A               LD A, D
 554+ A142 E6 C0            AND $C0                     ; Y7 Y6
 555+ A144 1F               RRA
 556+ A145 1F               RRA
 557+ A146 1F               RRA                         ; >> 3
 558+ A147 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A149 67               LD H, A
 560+ A14A
 561+ A14A 7A               LD A, D
 562+ A14B E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A14D B4               OR H
 564+ A14E 67               LD H, A
 565+ A14F
 566+ A14F 7A               LD A, D
 567+ A150 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A152 87               ADD A, A
 569+ A153 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A154 6F               LD L, A
 571+ A155
 572+ A155 7B               LD A, E
 573+ A156 1F               RRA
 574+ A157 1F               RRA
 575+ A158 1F               RRA
 576+ A159 E6 1F            AND $1F                     ; X / 8 = columna
 577+ A15B B5               OR L
 578+ A15C 6F               LD L, A
 579+ A15D C9               RET
 580+ A15E
 581+ A15E              ; ==============================================================================
 582+ A15E              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A15E              ; ==============================================================================
 584+ A15E              DrawDebugInfo:
 585+ A15E 3A 8F 82         LD A, (CurrentScreenX)
 586+ A161 1E 00            LD E, 0
 587+ A163 CD 80 A1         CALL .drawHexDigit
 588+ A166
 589+ A166 3E 2C            LD A, ','
 590+ A168 1E 01            LD E, 1
 591+ A16A CD 8C A1         CALL .drawChar
 592+ A16D
 593+ A16D 3A 90 82         LD A, (CurrentScreenY)
 594+ A170 1E 02            LD E, 2
 595+ A172 CD 80 A1         CALL .drawHexDigit
 596+ A175
 597+ A175 21 00 58         LD HL, ATTR_BASE
 598+ A178 3E 47            LD A, WHITE | $40
 599+ A17A 77               LD (HL), A
 600+ A17B 23               INC HL
 601+ A17C 77               LD (HL), A
 602+ A17D 23               INC HL
 603+ A17E 77               LD (HL), A
 604+ A17F C9               RET
 605+ A180
 606+ A180              .drawHexDigit:
 607+ A180 E6 0F            AND $0F
 608+ A182 FE 0A            CP 10
 609+ A184 38 04            JR C, .isNum
 610+ A186 C6 37            ADD A, 'A' - 10
 611+ A188 18 02            JR .drawChar
 612+ A18A              .isNum:
 613+ A18A C6 30            ADD A, '0'
 614+ A18C              .drawChar:
 615+ A18C 6F               LD L, A
 616+ A18D 26 00            LD H, 0
 617+ A18F 29               ADD HL, HL
 618+ A190 29               ADD HL, HL
 619+ A191 29               ADD HL, HL
 620+ A192 01 00 3C         LD BC, $3C00
 621+ A195 09               ADD HL, BC
 622+ A196
 623+ A196 16 40            LD D, $40
 624+ A198 06 08            LD B, 8
 625+ A19A              .charLoop:
 626+ A19A 7E               LD A, (HL)
 627+ A19B 12               LD (DE), A
 628+ A19C 23               INC HL
 629+ A19D 14               INC D
 630+ A19E 10 FA            DJNZ .charLoop
 631+ A1A0 C9               RET
