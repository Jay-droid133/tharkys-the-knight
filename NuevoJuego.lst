 365+ 8D68                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 366+ 8D68 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 367+ 8D6C F5               PUSH AF                             ; Guardar flags (Z=no fresh)
