 454+ A081              ; ==============================================================================
 455+ A081              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 456+ A081              ; ==============================================================================
 457+ A081              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 458+ A081              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 459+ A081              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 460+ A081              ; ==============================================================================
 461+ A081              ProcessEnemies:
 462+ A081 3E 00            LD A, 0
 463+ A083 32 CC A0         LD (.peCount), A
 464+ A086 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 465+ A088
 466+ A088              .peLoop:
 467+ A088 C5               PUSH BC
 468+ A089
 469+ A089                  ; Calcular IX desde EnemyStepIdx
 470+ A089 3A 07 83         LD A, (EnemyStepIdx)
 471+ A08C C6 01            ADD A, SLOT_MONSTER0
 472+ A08E 6F               LD L, A
 473+ A08F 26 00            LD H, 0
 474+ A091 29               ADD HL, HL
 475+ A092 29               ADD HL, HL
 476+ A093 29               ADD HL, HL
 477+ A094 29               ADD HL, HL                          ; × ENT_SIZE (16)
 478+ A095 11 A0 81         LD DE, EntityTable
 479+ A098 19               ADD HL, DE
 480+ A099 E5               PUSH HL
 481+ A09A DD E1            POP IX
 482+ A09C
 483+ A09C                  ; Avanzar indice round-robin
 484+ A09C 3A 07 83         LD A, (EnemyStepIdx)
 485+ A09F 3C               INC A
 486+ A0A0 FE 09            CP NUM_MONSTERS + NUM_NASTIES
 487+ A0A2 38 01            JR C, .peNoWrap
 488+ A0A4 AF               XOR A
 489+ A0A5              .peNoWrap:
 490+ A0A5 32 07 83         LD (EnemyStepIdx), A
 491+ A0A8
 492+ A0A8                  ; Slot activo?
 493+ A0A8 DD 7E 01         LD A, (IX+ENT_TYPE)
 494+ A0AB B7               OR A
 495+ A0AC 28 16            JR Z, .peSkip
 496+ A0AE
 497+ A0AE                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 498+ A0AE DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 499+ A0B2 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 500+ A0B3
 501+ A0B3                  ; Procesar esta entidad completa (erase + logic + draw)
 502+ A0B3 CD CD A0         CALL ProcessOneEnemy
