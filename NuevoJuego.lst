7114+ C6A9 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7115+ C6AD DD 7E 01         LD A, (IX+ENT_TYPE)
7116+ C6B0 B7               OR A
7117+ C6B1 C8               RET Z
7118+ C6B2                  ; Invulnerable SOLO durante el countdown phase 1 (sin control). NO durante
7119+ C6B2                  ; phase 2 (grace post-respawn O post-nasty-hit) — la phase 2 se setea tambien
7120+ C6B2                  ; al recibir un hit de nasty (EnterGracePhase desde .pHpDmgNotZero), y eso
7121+ C6B2                  ; daba 1s en el que Death te seguia pegada sin matarte. Death es instakill
7122+ C6B2                  ; sin importar inmunidades temporales. En el path post-respawn legitimo,
7123+ C6B2                  ; SilentKillDeath ya la despawneo, asi que no hay riesgo de instakill al
7124+ C6B2                  ; recuperar control.
7125+ C6B2 3A EB 82         LD A, (PlayerRespawnPhase)
7126+ C6B5 FE 01            CP 1
7127+ C6B7 C8               RET Z
7128+ C6B8
7129+ C6B8                  ; Player rect canonico: 16w x 21h (no usar GetSpriteDims — algunos frames
7130+ C6B8                  ; de animacion tienen altura menor y el AABB Y-axis fallaria). Ver
7131+ C6B8                  ; project_player_collision_rect.md.
7132+ C6B8 3E 15            LD A, 21
7133+ C6BA 32 05 C7         LD (.cdtPH), A
7134+ C6BD
7135+ C6BD                  ; --- AABB X: deathX..deathX+23 vs playerX..playerX+15 ---
7136+ C6BD                  ; cond1: deathX + 24 > playerX
7137+ C6BD DD 7E 03         LD A, (IX+ENT_POSX)
7138+ C6C0 C6 18            ADD A, 24
7139+ C6C2 38 06            JR C, .cdtX2                        ; overflow → asume verdad
7140+ C6C4 57               LD D, A
7141+ C6C5 3A 9E 81         LD A, (EntityTable + ENT_POSX)
7142+ C6C8 BA               CP D
7143+ C6C9 D0               RET NC                              ; playerX >= deathX+24 → no overlap
7144+ C6CA              .cdtX2:
7145+ C6CA                  ; cond2: playerX + 16 > deathX
7146+ C6CA 3A 9E 81         LD A, (EntityTable + ENT_POSX)
7147+ C6CD C6 10            ADD A, 16
7148+ C6CF 38 06            JR C, .cdtY1
7149+ C6D1 57               LD D, A
7150+ C6D2 DD 7E 03         LD A, (IX+ENT_POSX)
7151+ C6D5 BA               CP D
7152+ C6D6 D0               RET NC                              ; deathX >= playerX+16 → no overlap
7153+ C6D7
7154+ C6D7              .cdtY1:
7155+ C6D7                  ; cond3: deathY + 24 > playerY
7156+ C6D7 DD 7E 04         LD A, (IX+ENT_POSY)
7157+ C6DA C6 18            ADD A, 24
7158+ C6DC 38 06            JR C, .cdtY2
7159+ C6DE 57               LD D, A
7160+ C6DF 3A 9F 81         LD A, (EntityTable + ENT_POSY)
7161+ C6E2 BA               CP D
7162+ C6E3 D0               RET NC
7163+ C6E4
7164+ C6E4              .cdtY2:
7165+ C6E4                  ; cond4: playerY + pH > deathY
7166+ C6E4 3A 9F 81         LD A, (EntityTable + ENT_POSY)
7167+ C6E7 47               LD B, A
7168+ C6E8 3A 05 C7         LD A, (.cdtPH)
7169+ C6EB 80               ADD A, B
7170+ C6EC 38 06            JR C, .cdtTouched
7171+ C6EE 57               LD D, A
7172+ C6EF DD 7E 04         LD A, (IX+ENT_POSY)
7173+ C6F2 BA               CP D
7174+ C6F3 D0               RET NC
7175+ C6F4
7176+ C6F4              .cdtTouched:
7177+ C6F4                  ; Drenar HP completo
7178+ C6F4 AF               XOR A
7179+ C6F5 32 52 B3         LD (PlayerHealth), A
7180+ C6F8                  ; Erase sprite de la muerte
7181+ C6F8 CD 06 C7         CALL EraseDeathSprite
7182+ C6FB                  ; Despawn
7183+ C6FB AF               XOR A
7184+ C6FC DD 77 01         LD (IX+ENT_TYPE), A
