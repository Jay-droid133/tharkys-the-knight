 378+ F955              ; ---- Phase 17: WAIT_NASTIES ----
 379+ F955              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 380+ F955              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 381+ F955              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 382+ F955              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 383+ F955              ;
 384+ F955              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 385+ F955              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 386+ F955              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 387+ F955              .bcPhWaitNasties:
 388+ F955 CD E7 B9         CALL KillAllActiveNasties           ; cazar spawnings recien terminados
 389+ F958 CD E7 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 390+ F95B 28 04            JR Z, .bcWaitNastiesDone
 391+ F95D CD C9 FB         CALL BankCutsceneDecTimer           ; safety timeout
 392+ F960 C0               RET NZ
 393+ F961              .bcWaitNastiesDone:
 394+ F961 CD A0 F8         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 395+ F964 3E 1E            LD A, BCS_T_LOCK
 396+ F966 32 CA 82         LD (BankCutsceneTimer), A
 397+ F969 3E 01            LD A, BCP_LOCK
 398+ F96B 32 C9 82         LD (BankCutscenePhase), A
 399+ F96E C9               RET
 400+ F96F
 401+ F96F              ; ---- Phase 1: lock + facing UP ----
 402+ F96F              .bcPhLock:
 403+ F96F CD C9 FB         CALL BankCutsceneDecTimer
 404+ F972 C0               RET NZ
 405+ F973                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 406+ F973 AF               XOR A
 407+ F974 32 CC 82         LD (BankCutsceneKnockIdx), A
 408+ F977 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 409+ F97A 3E 00            LD A, BCS_KNOCK_HIT
 410+ F97C 32 CB 82         LD (BankCutsceneSubState), A
 411+ F97F 3E 04            LD A, BCS_T_KNOCK_HIT
 412+ F981 32 CA 82         LD (BankCutsceneTimer), A
 413+ F984 CD 68 FB         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 414+ F987 3E 02            LD A, BCP_KNOCKS_1
 415+ F989 32 C9 82         LD (BankCutscenePhase), A
 416+ F98C C9               RET
 417+ F98D
 418+ F98D              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 419+ F98D              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 420+ F98D              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 421+ F98D              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 422+ F98D              .bcPhKnocks1:
 423+ F98D 3E 03            LD A, BCS_GROUP1_KNOCKS
 424+ F98F CD 2D FB         CALL BankCutsceneTickKnockGroup
 425+ F992 B7               OR A
 426+ F993 C8               RET Z                               ; sigue
 427+ F994                  ; grupo 1 terminado → retirarse a ORIG + wait
 428+ F994 CD C6 F8         CALL BankCutsceneSnapToRetreat
 429+ F997 3E 32            LD A, BCS_T_GROUP_WAIT
 430+ F999 32 CA 82         LD (BankCutsceneTimer), A
 431+ F99C 3E 03            LD A, BCP_WAIT_1
 432+ F99E 32 C9 82         LD (BankCutscenePhase), A
 433+ F9A1 C9               RET
