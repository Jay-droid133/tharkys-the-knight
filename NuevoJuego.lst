4225+ B9A5 47               LD B, A
4226+ B9A6 DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de spawn
4227+ B9A9 FE 06            CP ANIM_FRAMES_SPAWN            ; >= 6 → animacion terminada
4228+ B9AB 38 25            JR C, .spFrameOk
4229+ B9AD                  ; Spawn terminado: transicionar a STATE_RUNNING
4230+ B9AD DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
4231+ B9B1 DD 7E 0A         LD A, (IX+ENT_DIR)              ; Recuperar ANIMBASE real del enemigo
4232+ B9B4 DD 77 08         LD (IX+ENT_ANIMBASE), A
4233+ B9B7 DD 77 00         LD (IX+ENT_SPRITEID), A
4234+ B9BA DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
4235+ B9BE                  ; Monsters: breve pausa antes de empezar a perseguir
4236+ B9BE DD 7E 01         LD A, (IX+ENT_TYPE)
4237+ B9C1 FE 02            CP TYPE_MONSTER
4238+ B9C3 20 0C            JR NZ, .spNotMonster
4239+ B9C5 DD 36 0A 06      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE ; Pausa sin knockback (deltas=0)
4240+ B9C9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4241+ B9CD DD 36 07 00      LD (IX+ENT_DELTAY), 0
4242+ B9D1              .spNotMonster:
