 379+ EF4C              ; ==============================================================================
 380+ EF4C              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 381+ EF4C              ; ==============================================================================
 382+ EF4C              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 383+ EF4C              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 384+ EF4C              ; third). El brujula se redibuja solo cuando:
 385+ EF4C              ;   - cambias de pantalla (LastCompassScreen != Current)
 386+ EF4C              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 387+ EF4C              ; En reposo es un no-op barato (solo unas comparaciones).
 388+ EF4C              ;
 389+ EF4C              ; Color (atributo de las 4 celdas):
 390+ EF4C              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 391+ EF4C              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 392+ EF4C              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 393+ EF4C              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 394+ EF4C              ;
 395+ EF4C              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 396+ EF4C              ; ==============================================================================
 397+ EF4C
 398+ EF4C              COMPASS_COL     EQU 24
 399+ EF4C              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 400+ EF4C
 401+ EF4C              ; ==============================================================================
 402+ EF4C              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 403+ EF4C              ; ==============================================================================
 404+ EF4C              DrawCompass:
 405+ EF4C                  ; Sin objetivo resuelto -> limpiar y salir
 406+ EF4C 3A BB 82         LD A, (ObjectiveScreenX)
 407+ EF4F FE FF            CP $FF
 408+ EF51 CA F3 F0         JP Z, ClearCompass
 409+ EF54
 410+ EF54                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 411+ EF54                  ; magic compass activo (que necesita redibujar para el blink y para
 412+ EF54                  ; reflejar la dir del path al cambiar de sala).
 413+ EF54 3A 0B 83         LD A, (CurrentScreenX)
 414+ EF57 47               LD B, A
 415+ EF58 3A BE 82         LD A, (LastCompassScreenX)
 416+ EF5B B8               CP B
 417+ EF5C C2 82 EF         JP NZ, .dcRedrawNewScreen
 418+ EF5F 3A 0C 83         LD A, (CurrentScreenY)
 419+ EF62 47               LD B, A
 420+ EF63 3A BF 82         LD A, (LastCompassScreenY)
 421+ EF66 B8               CP B
 422+ EF67 C2 82 EF         JP NZ, .dcRedrawNewScreen
 423+ EF6A 3A BD 82         LD A, (PreviousObjectiveDistance)
 424+ EF6D FE FF            CP $FF
 425+ EF6F 28 16            JR Z, .dcRedraw
 426+ EF71 3A C0 82         LD A, (CompassWobbleCounter)
 427+ EF74 B7               OR A
 428+ EF75 20 10            JR NZ, .dcRedraw
 429+ EF77                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 430+ EF77                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 431+ EF77 3A BF 5F         LD A, (MagicCompassTimer)
 432+ EF7A 47               LD B, A
 433+ EF7B 3A C0 5F         LD A, (MagicCompassTimer + 1)
 434+ EF7E B0               OR B
 435+ EF7F C8               RET Z                               ; sin cambios + sin wobble + sin magic
 436+ EF80 18 05            JR .dcRedraw
 437+ EF82
 438+ EF82              .dcRedrawNewScreen:
 439+ EF82                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 440+ EF82                  ; sincronicamente en CheckScreenTransition.doTransition (via
 441+ EF82                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 442+ EF82                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 443+ EF82                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 444+ EF82                  ;
 445+ EF82                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 446+ EF82                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 447+ EF82                  ; hay que volver a dibujar el sprite minimo una vez.
 448+ EF82 3E FF            LD A, $FF
 449+ EF84 32 CB 5F         LD (LastMagicCompassDrawn), A
 450+ EF87                  ; fall through a .dcRedraw
 451+ EF87
 452+ EF87              .dcRedraw:
 453+ EF87                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 454+ EF87 3A BB 82         LD A, (ObjectiveScreenX)
 455+ EF8A 47               LD B, A
 456+ EF8B 3A 0B 83         LD A, (CurrentScreenX)
 457+ EF8E 4F               LD C, A
 458+ EF8F 78               LD A, B
 459+ EF90 91               SUB C                               ; A = dx (signed)
 460+ EF91                  ; abs(dx) -> H, sign(dx)+1 -> L
 461+ EF91 F2 9B EF         JP P, .dcDxNonNeg
 462+ EF94 ED 44            NEG
 463+ EF96 67               LD H, A                             ; abs(dx)
 464+ EF97 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 465+ EF99 18 0A            JR .dcDxDone
 466+ EF9B              .dcDxNonNeg:
 467+ EF9B 67               LD H, A
 468+ EF9C B7               OR A
 469+ EF9D 20 04            JR NZ, .dcDxPositive
 470+ EF9F 2E 01            LD L, 1                             ; dx == 0
 471+ EFA1 18 02            JR .dcDxDone
 472+ EFA3              .dcDxPositive:
 473+ EFA3 2E 02            LD L, 2
 474+ EFA5              .dcDxDone:
 475+ EFA5 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 476+ EFA6
 477+ EFA6                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 478+ EFA6 3A BC 82         LD A, (ObjectiveScreenY)
 479+ EFA9 47               LD B, A
 480+ EFAA 3A 0C 83         LD A, (CurrentScreenY)
 481+ EFAD 4F               LD C, A
 482+ EFAE 78               LD A, B
 483+ EFAF 91               SUB C
 484+ EFB0 F2 BA EF         JP P, .dcDyNonNeg
 485+ EFB3 ED 44            NEG
 486+ EFB5 67               LD H, A
 487+ EFB6 2E 00            LD L, 0
 488+ EFB8 18 0A            JR .dcDyDone
 489+ EFBA              .dcDyNonNeg:
 490+ EFBA 67               LD H, A
 491+ EFBB B7               OR A
 492+ EFBC 20 04            JR NZ, .dcDyPositive
 493+ EFBE 2E 01            LD L, 1
 494+ EFC0 18 02            JR .dcDyDone
 495+ EFC2              .dcDyPositive:
 496+ EFC2 2E 02            LD L, 2
 497+ EFC4              .dcDyDone:
 498+ EFC4                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 499+ EFC4 D1               POP DE                              ; D = abs_dx, E = signdx+1
 500+ EFC5                  ; idx = (signdy+1)*3 + (signdx+1)
 501+ EFC5 7D               LD A, L
 502+ EFC6 87               ADD A, A
 503+ EFC7 85               ADD A, L                            ; A = (signdy+1)*3
 504+ EFC8 83               ADD A, E                            ; A = idx (0..8)
 505+ EFC9 32 C0 F0         LD (.dcSpriteIdx), A
 506+ EFCC                  ; distance = abs_dx + abs_dy
 507+ EFCC 7A               LD A, D
 508+ EFCD 84               ADD A, H
 509+ EFCE 32 C1 F0         LD (.dcDistance), A
 510+ EFD1
 511+ EFD1                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 512+ EFD1                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 513+ EFD1                  ; Sprite_Compass_Magic (no oscila); el wobble logic solo gastaría CPU
 514+ EFD1                  ; durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 515+ EFD1                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 516+ EFD1                  ; cuando el frame de transición está apretado.
 517+ EFD1 3A BF 5F         LD A, (MagicCompassTimer)
 518+ EFD4 47               LD B, A
 519+ EFD5 3A C0 5F         LD A, (MagicCompassTimer + 1)
 520+ EFD8 B0               OR B
 521+ EFD9 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 522+ EFDB AF               XOR A
 523+ EFDC 32 C0 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 524+ EFDF 18 53            JR .dcWobbleEnd
 525+ EFE1              .dcWobbleStartNormal:
 526+ EFE1                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 527+ EFE1                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 528+ EFE1                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 529+ EFE1                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 530+ EFE1                  ; nuevo idx.
 531+ EFE1                  ; Counter == 0 -> sin override, idx = target.
 532+ EFE1 3A C0 F0         LD A, (.dcSpriteIdx)
 533+ EFE4 FE 04            CP 4
 534+ EFE6 20 06            JR NZ, .dcWobbleNotX
 535+ EFE8                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 536+ EFE8                  ; frame no redibuje innecesariamente.
 537+ EFE8 AF               XOR A
 538+ EFE9 32 C0 82         LD (CompassWobbleCounter), A
 539+ EFEC 18 46            JR .dcWobbleEnd
 540+ EFEE              .dcWobbleNotX:
 541+ EFEE                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 542+ EFEE 3A 0B 83         LD A, (CurrentScreenX)
 543+ EFF1 47               LD B, A
 544+ EFF2 3A BE 82         LD A, (LastCompassScreenX)
 545+ EFF5 B8               CP B
 546+ EFF6 20 0A            JR NZ, .dcWobbleStart
 547+ EFF8 3A 0C 83         LD A, (CurrentScreenY)
 548+ EFFB 47               LD B, A
 549+ EFFC 3A BF 82         LD A, (LastCompassScreenY)
 550+ EFFF B8               CP B
 551+ F000 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 552+ F002              .dcWobbleStart:
 553+ F002 3E 09            LD A, 9
 554+ F004 32 C0 82         LD (CompassWobbleCounter), A
 555+ F007              .dcWobbleResolve:
 556+ F007 3A C0 82         LD A, (CompassWobbleCounter)
 557+ F00A B7               OR A
 558+ F00B 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 559+ F00D 3D               DEC A
 560+ F00E 32 C0 82         LD (CompassWobbleCounter), A
 561+ F011                                                      ; A = phase 0..8 (1 frame por fase)
 562+ F011 21 19 F5         LD HL, WobblePhaseTable
 563+ F014 5F               LD E, A
 564+ F015 16 00            LD D, 0
 565+ F017 19               ADD HL, DE
 566+ F018 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 567+ F019 FE 02            CP 2
 568+ F01B 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 569+ F01D                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 570+ F01D                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 571+ F01D FE 03            CP 3
 572+ F01F 38 01            JR C, .dcWobbleOffsetReady
 573+ F021 3D               DEC A
 574+ F022              .dcWobbleOffsetReady:
 575+ F022 5F               LD E, A
 576+ F023 3A C0 F0         LD A, (.dcSpriteIdx)
 577+ F026 87               ADD A, A                            ; idx*2
 578+ F027 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 579+ F028 83               ADD A, E                            ; +offset
 580+ F029 21 F5 F4         LD HL, CompassWobbleTable
 581+ F02C 5F               LD E, A
 582+ F02D 16 00            LD D, 0
 583+ F02F 19               ADD HL, DE
 584+ F030 7E               LD A, (HL)
 585+ F031 32 C0 F0         LD (.dcSpriteIdx), A                ; override
 586+ F034
 587+ F034              .dcWobbleEnd:
 588+ F034
 589+ F034                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 590+ F034                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 591+ F034                  ; sin bright + char activo white bright; en warning el char activo
 592+ F034                  ; parpadea bright on/off a ~6 Hz).
 593+ F034                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 594+ F034                  ; blanca se mantiene tal cual.
 595+ F034 3A BF 5F         LD A, (MagicCompassTimer)
 596+ F037 47               LD B, A
 597+ F038 3A C0 5F         LD A, (MagicCompassTimer + 1)
 598+ F03B B0               OR B
 599+ F03C 28 29            JR Z, .dcMagicOff
 600+ F03E 3A C0 F0         LD A, (.dcSpriteIdx)
 601+ F041 FE 04            CP 4
 602+ F043 28 22            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 603+ F045 3A C1 5F         LD A, (MagicCompassPathDir)
 604+ F048 FE FF            CP $FF
 605+ F04A 28 1B            JR Z, .dcMagicOff                   ; sin path → render normal
 606+ F04C                  ; --- MAGIC HUD ---
 607+ F04C                  ; Cache: el sprite Sprite_Compass_Magic es siempre el mismo; sólo se
 608+ F04C                  ; redibuja cuando cambia PathDir (o no estaba dibujado todavía). El
 609+ F04C                  ; resto de frames basta con repintar los 4 attrs (ultra-barato), lo que
 610+ F04C                  ; libera CPU durante el wobble post-transición y evita que las agujas
 611+ F04C                  ; del reloj queden parcialmente actualizadas en frames con poco margen.
 612+ F04C 3A C1 5F         LD A, (MagicCompassPathDir)
 613+ F04F 47               LD B, A
 614+ F050 3A CB 5F         LD A, (LastMagicCompassDrawn)
 615+ F053 B8               CP B
 616+ F054 28 0C            JR Z, .dcMagicAttrsOnly             ; mismo path → solo attrs
 617+ F056 11 1B 77         LD DE, Sprite_Compass_Magic
 618+ F059 CD C3 F0         CALL DrawCompassSprite
 619+ F05C 3A C1 5F         LD A, (MagicCompassPathDir)
 620+ F05F 32 CB 5F         LD (LastMagicCompassDrawn), A
 621+ F062              .dcMagicAttrsOnly:
 622+ F062 CD 03 74         CALL PaintMagicCompassAttrs
 623+ F065 18 40            JR .dcDrawDone
 624+ F067
 625+ F067              .dcMagicOff:
 626+ F067                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 627+ F067                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 628+ F067 3E FF            LD A, $FF
 629+ F069 32 CB 5F         LD (LastMagicCompassDrawn), A
 630+ F06C
 631+ F06C                  ; --- Color normal ---
 632+ F06C                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 633+ F06C 3A C0 F0         LD A, (.dcSpriteIdx)
 634+ F06F FE 04            CP 4
 635+ F071 28 18            JR Z, .dcWhite
 636+ F073 3A BD 82         LD A, (PreviousObjectiveDistance)
 637+ F076 FE FF            CP $FF
 638+ F078 28 11            JR Z, .dcWhite
 639+ F07A 47               LD B, A
 640+ F07B 3A C1 F0         LD A, (.dcDistance)
 641+ F07E B8               CP B
 642+ F07F 28 0A            JR Z, .dcWhite                      ; igual = blanco
 643+ F081 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 644+ F083 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 645+ F085 18 06            JR .dcColorDone
 646+ F087              .dcGreen:
 647+ F087 3E 44            LD A, GREEN | $40
 648+ F089 18 02            JR .dcColorDone
 649+ F08B              .dcWhite:
 650+ F08B 3E 47            LD A, WHITE | $40
 651+ F08D              .dcColorDone:
 652+ F08D 32 C2 F0         LD (.dcAttr), A
 653+ F090
 654+ F090                  ; --- Sprite ptr de CompassSprites[idx] ---
 655+ F090 3A C0 F0         LD A, (.dcSpriteIdx)
 656+ F093 87               ADD A, A                            ; *2
 657+ F094 6F               LD L, A
 658+ F095 26 00            LD H, 0
 659+ F097 11 E3 F4         LD DE, CompassSprites
 660+ F09A 19               ADD HL, DE
 661+ F09B 5E               LD E, (HL)
 662+ F09C 23               INC HL
 663+ F09D 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 664+ F09E CD C3 F0         CALL DrawCompassSprite
 665+ F0A1
 666+ F0A1                  ; --- Attrs ---
 667+ F0A1 3A C2 F0         LD A, (.dcAttr)
 668+ F0A4 CD E6 F0         CALL SetCompassAttrs
 669+ F0A7
 670+ F0A7              .dcDrawDone:
 671+ F0A7
 672+ F0A7                  ; --- Cachear estado ---
 673+ F0A7                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 674+ F0A7                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 675+ F0A7                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 676+ F0A7                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 677+ F0A7                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 678+ F0A7                  ; el wobble y la comparacion sigue siendo correcta.
 679+ F0A7 3A C0 82         LD A, (CompassWobbleCounter)
 680+ F0AA B7               OR A
 681+ F0AB 20 06            JR NZ, .dcSkipPrevDistSave
 682+ F0AD 3A C1 F0         LD A, (.dcDistance)
 683+ F0B0 32 BD 82         LD (PreviousObjectiveDistance), A
 684+ F0B3              .dcSkipPrevDistSave:
 685+ F0B3 3A 0B 83         LD A, (CurrentScreenX)
 686+ F0B6 32 BE 82         LD (LastCompassScreenX), A
 687+ F0B9 3A 0C 83         LD A, (CurrentScreenY)
 688+ F0BC 32 BF 82         LD (LastCompassScreenY), A
 689+ F0BF C9               RET
 690+ F0C0
 691+ F0C0 00           .dcSpriteIdx: DEFB 0
 692+ F0C1 00           .dcDistance:  DEFB 0
 693+ F0C2 00           .dcAttr:      DEFB 0
 694+ F0C3
 695+ F0C3              ; ==============================================================================
 696+ F0C3              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 697+ F0C3              ; ==============================================================================
 698+ F0C3              ; IN: DE = ptr a 16 filas x 2 bytes
 699+ F0C3              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 700+ F0C3              ; Destruye: AF, B, HL.
 701+ F0C3              ; ==============================================================================
 702+ F0C3              DrawCompassSprite:
 703+ F0C3                  ; Char row 0 (rows 0-7 del sprite)
 704+ F0C3 26 40            LD H, $40
 705+ F0C5 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 706+ F0C7 06 08            LD B, 8
 707+ F0C9              .dcsRow0:
 708+ F0C9 1A               LD A, (DE)
 709+ F0CA 77               LD (HL), A
 710+ F0CB 13               INC DE
 711+ F0CC 23               INC HL
 712+ F0CD 1A               LD A, (DE)
 713+ F0CE 77               LD (HL), A
 714+ F0CF 13               INC DE
 715+ F0D0 2B               DEC HL
 716+ F0D1 24               INC H
 717+ F0D2 10 F5            DJNZ .dcsRow0
 718+ F0D4                  ; Char row 1 (rows 8-15 del sprite)
 719+ F0D4 26 40            LD H, $40
 720+ F0D6 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 721+ F0D8 06 08            LD B, 8
 722+ F0DA              .dcsRow1:
 723+ F0DA 1A               LD A, (DE)
 724+ F0DB 77               LD (HL), A
 725+ F0DC 13               INC DE
 726+ F0DD 23               INC HL
 727+ F0DE 1A               LD A, (DE)
 728+ F0DF 77               LD (HL), A
 729+ F0E0 13               INC DE
 730+ F0E1 2B               DEC HL
 731+ F0E2 24               INC H
 732+ F0E3 10 F5            DJNZ .dcsRow1
 733+ F0E5 C9               RET
 734+ F0E6
 735+ F0E6              ; ==============================================================================
 736+ F0E6              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 737+ F0E6              ; ==============================================================================
 738+ F0E6              SetCompassAttrs:
 739+ F0E6 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 740+ F0E9 77               LD (HL), A
 741+ F0EA 23               INC HL
 742+ F0EB 77               LD (HL), A
 743+ F0EC 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 744+ F0EF 77               LD (HL), A
 745+ F0F0 23               INC HL
 746+ F0F1 77               LD (HL), A
 747+ F0F2 C9               RET
 748+ F0F3
 749+ F0F3              ; ==============================================================================
 750+ F0F3              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 751+ F0F3              ; ==============================================================================
 752+ F0F3              ClearCompass:
 753+ F0F3 26 40            LD H, $40
 754+ F0F5 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 755+ F0F7 06 08            LD B, 8
 756+ F0F9 AF               XOR A
 757+ F0FA              .ccRow0:
 758+ F0FA 77               LD (HL), A
 759+ F0FB 23               INC HL
 760+ F0FC 77               LD (HL), A
 761+ F0FD 2B               DEC HL
 762+ F0FE 24               INC H
 763+ F0FF 10 F9            DJNZ .ccRow0
 764+ F101 26 40            LD H, $40
 765+ F103 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 766+ F105 06 08            LD B, 8
 767+ F107 AF               XOR A
 768+ F108              .ccRow1:
 769+ F108 77               LD (HL), A
 770+ F109 23               INC HL
 771+ F10A 77               LD (HL), A
 772+ F10B 2B               DEC HL
 773+ F10C 24               INC H
 774+ F10D 10 F9            DJNZ .ccRow1
 775+ F10F AF               XOR A                               ; attr 0 (negro/negro, invisible)
 776+ F110 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 777+ F113 77               LD (HL), A
 778+ F114 23               INC HL
 779+ F115 77               LD (HL), A
 780+ F116 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 781+ F119 77               LD (HL), A
 782+ F11A 23               INC HL
 783+ F11B 77               LD (HL), A
 784+ F11C C9               RET
 785+ F11D
 786+ F11D              ; ==============================================================================
 787+ F11D              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 788+ F11D              ; ==============================================================================
 789+ F11D              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 790+ F11D              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 791+ F11D              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 792+ F11D              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 793+ F11D              ; monstruo cae alli con la puerta abierta:
 794+ F11D              ;   - Bit slot en MonsterTrappedFlags
 795+ F11D              ;   - Despawn del monstruo (puff)
 796+ F11D              ;   - Puerta se re-cierra (sprite + flag)
 797+ F11D              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 798+ F11D              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 799+ F11D              ;
 800+ F11D              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 801+ F11D              ; auto-generadas por el level editor segun la posicion de la puerta y los
 802+ F11D              ; markers AltKey1/AltKey2.
 803+ F11D              ; ==============================================================================
 804+ F11D
 805+ F11D              ; ==============================================================================
 806+ F11D              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 807+ F11D              ; ==============================================================================
 808+ F11D              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 809+ F11D              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 810+ F11D              ; Destruye: AF, BC.
 811+ F11D              ; ==============================================================================
 812+ F11D              CheckChurchTrap:
 813+ F11D                  ; --- Solo en pantalla de la iglesia ---
 814+ F11D 3A 0B 83         LD A, (CurrentScreenX)
 815+ F120 FE 0F            CP CHURCH_TRAP_SCREEN_X
 816+ F122 20 5D            JR NZ, .cctNoTrap
 817+ F124 3A 0C 83         LD A, (CurrentScreenY)
 818+ F127 FE 06            CP CHURCH_TRAP_SCREEN_Y
 819+ F129 20 56            JR NZ, .cctNoTrap
 820+ F12B                  ; --- Solo con la puerta abierta ---
 821+ F12B 3A B4 82         LD A, (ChurchDoorOpen)
 822+ F12E B7               OR A
 823+ F12F 28 50            JR Z, .cctNoTrap
 824+ F131                  ; --- Solo si el knockback es DIRECTO del player ---
 825+ F131                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 826+ F131                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 827+ F131                  ; espada y se clear cuando se hereda kb por colision.
 828+ F131 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 829+ F135 28 4A            JR Z, .cctNoTrap
 830+ F137                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 831+ F137                  ; (acepta sprites de 16, 21 o 24 px de alto)
 832+ F137 DD 7E 04         LD A, (IX+ENT_POSY)
 833+ F13A CB 3F            SRL A
 834+ F13C CB 3F            SRL A
 835+ F13E CB 3F            SRL A                                   ; A = top charY del monster
 836+ F140 47               LD B, A
 837+ F141 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 838+ F143 90               SUB B                                   ; A = trap_charY - mon_charY
 839+ F144 FE 03            CP 3
 840+ F146 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 841+ F148                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 842+ F148 DD 7E 03         LD A, (IX+ENT_POSX)
 843+ F14B CB 3F            SRL A
 844+ F14D CB 3F            SRL A
 845+ F14F CB 3F            SRL A
 846+ F151 47               LD B, A                                 ; B = left charX del monster
 847+ F152 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 848+ F154 3C               INC A                                   ; A = LO_X + 1
 849+ F155 90               SUB B                                   ; A = LO_X+1 - charX
 850+ F156 FE 03            CP 3
 851+ F158 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 852+ F15A                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 853+ F15A                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 854+ F15A DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 855+ F15D D6 4C            SUB SPRID_MONSTER_0
 856+ F15F CB 3F            SRL A
 857+ F161 CB 3F            SRL A
 858+ F163 CB 3F            SRL A                                   ; A = type idx 0..2
 859+ F165 47               LD B, A
 860+ F166                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 861+ F166 3A C2 82         LD A, (NextChurchTrapStep)
 862+ F169 FE 03            CP 3
 863+ F16B 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 864+ F16D 21 83 F1         LD HL, ChurchTrapOrderTable
 865+ F170 5F               LD E, A
 866+ F171 16 00            LD D, 0
 867+ F173 19               ADD HL, DE
 868+ F174 7E               LD A, (HL)                              ; A = type esperado
 869+ F175 B8               CP B
 870+ F176 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 871+ F178                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 872+ F178 CD 1B F2         CALL TriggerChurchTrap
 873+ F17B 3E 01            LD A, 1
 874+ F17D C9               RET
 875+ F17E              .cctBlockAsWall:
 876+ F17E                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 877+ F17E                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 878+ F17E 3E 02            LD A, 2
 879+ F180 C9               RET
 880+ F181              .cctNoTrap:
 881+ F181 AF               XOR A
 882+ F182 C9               RET
 883+ F183
 884+ F183              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 885+ F183              ChurchTrapOrderTable:
 886+ F183 00 02 01         DEFB 0, 2, 1
 887+ F186
 888+ F186              ; ==============================================================================
 889+ F186              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 890+ F186              ; blanco brillante sobre paper negro ($47).
 891+ F186              ; ==============================================================================
 892+ F186              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 893+ F186              ; - No-op fuera de la sala de la iglesia.
 894+ F186              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 895+ F186              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 896+ F186              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 897+ F186              ;   aun no toca) conservan sus attrs originales del sprite.
 898+ F186              ; Destruye: AF, BC, DE, HL.
 899+ F186              ; ==============================================================================
 900+ F186              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 901+ F186              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 902+ F186              HighlightExpectedStatue:
 903+ F186 3E 47            LD A, $47
 904+ F188 18 00            JR PaintExpectedStatueAttr
 905+ F18A
 906+ F18A              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 907+ F18A              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 908+ F18A              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 909+ F18A              PaintExpectedStatueAttr:
 910+ F18A 32 F4 F1         LD (.hesAttr), A
 911+ F18D                  ; --- Solo en la sala de la iglesia ---
 912+ F18D 3A 0B 83         LD A, (CurrentScreenX)
 913+ F190 FE 0F            CP CHURCH_TRAP_SCREEN_X
 914+ F192 C0               RET NZ
 915+ F193 3A 0C 83         LD A, (CurrentScreenY)
 916+ F196 FE 06            CP CHURCH_TRAP_SCREEN_Y
 917+ F198 C0               RET NZ
 918+ F199                  ; --- Solo tras abrir la iglesia 1a vez ---
 919+ F199                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 920+ F199                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 921+ F199                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 922+ F199                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 923+ F199                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 924+ F199 3A B5 82         LD A, (ChurchEverOpened)
 925+ F19C B7               OR A
 926+ F19D C8               RET Z
 927+ F19E                  ; --- Solo si quedan monstruos por atrapar ---
 928+ F19E 3A C2 82         LD A, (NextChurchTrapStep)
 929+ F1A1 FE 03            CP 3
 930+ F1A3 D0               RET NC
 931+ F1A4                  ; --- Type esperado -> statue id ---
 932+ F1A4 21 83 F1         LD HL, ChurchTrapOrderTable
 933+ F1A7 5F               LD E, A
 934+ F1A8 16 00            LD D, 0
 935+ F1AA 19               ADD HL, DE
 936+ F1AB 7E               LD A, (HL)                              ; type idx esperado
 937+ F1AC 21 A9 67         LD HL, StatueIdTable
 938+ F1AF 5F               LD E, A
 939+ F1B0 16 00            LD D, 0
 940+ F1B2 19               ADD HL, DE
 941+ F1B3 7E               LD A, (HL)                              ; A = statue id
 942+ F1B4 B7               OR A
 943+ F1B5 C8               RET Z
 944+ F1B6 32 F5 F1         LD (.hesTargetId), A
 945+ F1B9                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 946+ F1B9 2A 0D 83         LD HL, (CurrentScreenAddr)
 947+ F1BC              .hesLoop:
 948+ F1BC 7E               LD A, (HL)
 949+ F1BD FE FF            CP $FF
 950+ F1BF C8               RET Z                                   ; estatua no en esta sala
 951+ F1C0 47               LD B, A
 952+ F1C1 3A F5 F1         LD A, (.hesTargetId)
 953+ F1C4 B8               CP B
 954+ F1C5 28 06            JR Z, .hesFound
 955+ F1C7 11 04 00         LD DE, 4
 956+ F1CA 19               ADD HL, DE
 957+ F1CB 18 EF            JR .hesLoop
 958+ F1CD              .hesFound:
 959+ F1CD 23               INC HL
 960+ F1CE 7E               LD A, (HL)                              ; charX
 961+ F1CF 47               LD B, A
 962+ F1D0 23               INC HL
 963+ F1D1 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 964+ F1D2 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 965+ F1D4 4F               LD C, A                                 ; C = charY (post-HUD)
 966+ F1D5                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 967+ F1D5 26 00            LD H, 0
 968+ F1D7 69               LD L, C
 969+ F1D8 29               ADD HL, HL
 970+ F1D9 29               ADD HL, HL
 971+ F1DA 29               ADD HL, HL
 972+ F1DB 29               ADD HL, HL
 973+ F1DC 29               ADD HL, HL                              ; HL = charY * 32
 974+ F1DD 58               LD E, B
 975+ F1DE 16 00            LD D, 0
 976+ F1E0 19               ADD HL, DE                              ; + charX
 977+ F1E1 11 00 58         LD DE, $5800
 978+ F1E4 19               ADD HL, DE                              ; HL = attr addr top-left
 979+ F1E5                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 980+ F1E5                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 981+ F1E5                  ; no hace falta sincronizar CleanAttrMap.
 982+ F1E5 3A F4 F1         LD A, (.hesAttr)
 983+ F1E8 06 03            LD B, 3                                 ; 3 filas de chars
 984+ F1EA              .hesRow:
 985+ F1EA 77               LD (HL), A
 986+ F1EB 23               INC HL
 987+ F1EC 77               LD (HL), A                              ; (charX+1)
 988+ F1ED 11 1F 00         LD DE, 31
 989+ F1F0 19               ADD HL, DE                              ; siguiente fila col 0
 990+ F1F1 10 F7            DJNZ .hesRow
 991+ F1F3 C9               RET
 992+ F1F4 00           .hesAttr:     DEFB 0
 993+ F1F5 00           .hesTargetId: DEFB 0
 994+ F1F6
 995+ F1F6              ; ==============================================================================
 996+ F1F6              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 997+ F1F6              ; ==============================================================================
 998+ F1F6              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 999+ F1F6              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1000+ F1F6              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1001+ F1F6              ; + ON final settle): 8 ciclos de ON-OFF en total.
1002+ F1F6              ; ==============================================================================
1003+ F1F6              STATUE_BLINK_FRAMES   EQU 32
1004+ F1F6
1005+ F1F6              StartStatueBlink:
1006+ F1F6                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1007+ F1F6                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1008+ F1F6                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1009+ F1F6                  ; (caso A), .cbtActChurchDoor (caso B).
1010+ F1F6 3E 20            LD A, STATUE_BLINK_FRAMES
1011+ F1F8 32 C3 82         LD (StatueBlinkCounter), A
1012+ F1FB C3 86 F1         JP HighlightExpectedStatue              ; initial ON paint
1013+ F1FE
1014+ F1FE              UpdateStatueBlink:
1015+ F1FE                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1016+ F1FE 3A C3 82         LD A, (StatueBlinkCounter)
1017+ F201 B7               OR A
1018+ F202 C8               RET Z
1019+ F203 3D               DEC A
1020+ F204 32 C3 82         LD (StatueBlinkCounter), A
1021+ F207 20 03            JR NZ, .usbInProgress
1022+ F209                  ; Counter recien llego a 0: settle ON
1023+ F209 C3 86 F1         JP HighlightExpectedStatue
1024+ F20C              .usbInProgress:
1025+ F20C                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1026+ F20C                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1027+ F20C CB 3F            SRL A
1028+ F20E E6 01            AND $01
1029+ F210 28 05            JR Z, .usbOff
1030+ F212 3E 47            LD A, $47
1031+ F214 C3 8A F1         JP PaintExpectedStatueAttr
1032+ F217              .usbOff:
1033+ F217 AF               XOR A
1034+ F218 C3 8A F1         JP PaintExpectedStatueAttr
1035+ F21B
1036+ F21B              ; ==============================================================================
1037+ F21B              ; CUTSCENE - parametros ajustables
1038+ F21B              ; ==============================================================================
1039+ F21B              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1040+ F21B              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1041+ F21B              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1042+ F21B              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1043+ F21B
1044+ F21B              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1045+ F21B              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1046+ F21B              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1047+ F21B
1048+ F21B              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1049+ F21B              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1050+ F21B              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1051+ F21B              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1052+ F21B              ;   tick 12 -> erase smoke[2], pasar a DONE
1053+ F21B              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1054+ F21B              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1055+ F21B
1056+ F21B              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1057+ F21B              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1058+ F21B              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1059+ F21B              ; centrado dentro del vano de la puerta.
1060+ F21B              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1061+ F21B              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1062+ F21B              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1063+ F21B              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1064+ F21B
1065+ F21B              ; ==============================================================================
1066+ F21B              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1067+ F21B              ; ==============================================================================
1068+ F21B              ; IN: IX = monster atrapado.
1069+ F21B              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1070+ F21B              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1071+ F21B              ; en ApplyChurchTrapEffects al final del cutscene.
1072+ F21B              ; ==============================================================================
1073+ F21B              TriggerChurchTrap:
1074+ F21B                  ; --- 1. Calcular slot 0..2 ---
1075+ F21B DD E5            PUSH IX
1076+ F21D E1               POP HL
1077+ F21E 11 AE 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1078+ F221 B7               OR A
1079+ F222 ED 52            SBC HL, DE
1080+ F224 CB 3D            SRL L
1081+ F226 CB 3D            SRL L
1082+ F228 CB 3D            SRL L
1083+ F22A CB 3D            SRL L                                   ; L = slot 0..2
1084+ F22C 7D               LD A, L
1085+ F22D 32 9E 5F         LD (ChurchCutsceneSlot), A
1086+ F230                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1087+ F230 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1088+ F233 D6 4C            SUB SPRID_MONSTER_0
1089+ F235 CB 3F            SRL A
1090+ F237 CB 3F            SRL A
1091+ F239 CB 3F            SRL A                                   ; A = type idx
1092+ F23B 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1093+ F23E                  ; --- 2. Mover monster al centro del vano ---
1094+ F23E 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1095+ F240 DD 77 03         LD (IX+ENT_POSX), A
1096+ F243 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1097+ F245 DD 77 04         LD (IX+ENT_POSY), A
1098+ F248 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1099+ F24C DD 36 07 00      LD (IX+ENT_DELTAY), 0
1100+ F250 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1101+ F254                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1102+ F254                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1103+ F254                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1104+ F254                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1105+ F254                  ; temblor se vea con ink blanco brillante sobre paper negro.
1106+ F254 AF               XOR A
1107+ F255 32 C3 82         LD (StatueBlinkCounter), A              ; parar blink
1108+ F258 DD E5            PUSH IX
1109+ F25A CD 86 F1         CALL HighlightExpectedStatue            ; pintar $47
1110+ F25D                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1111+ F25D                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1112+ F25D                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1113+ F25D                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1114+ F25D CD B8 BA         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1115+ F260 3E FF            LD A, $FF
1116+ F262 CD BD 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1117+ F265 DD E1            POP IX
1118+ F267                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1119+ F267 3E 01            LD A, 1
1120+ F269 32 C9 82         LD (ChurchCutscenePhase), A
1121+ F26C AF               XOR A
1122+ F26D 32 9D 5F         LD (ChurchCutsceneFrame), A
1123+ F270 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1124+ F272 32 A4 5F         LD (ChurchCutsceneLookCount), A
1125+ F275 C9               RET
1126+ F276
1127+ F276              ; ==============================================================================
1128+ F276              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1129+ F276              ; ==============================================================================
1130+ F276              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1131+ F276              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1132+ F276              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1133+ F276              ; ==============================================================================
1134+ F276              UpdateChurchCutscene:
1135+ F276 3A C9 82         LD A, (ChurchCutscenePhase)
1136+ F279 B7               OR A
1137+ F27A C8               RET Z
1138+ F27B 3D               DEC A
1139+ F27C 28 12            JR Z, .ucsLookPhase
1140+ F27E 3D               DEC A
1141+ F27F 28 38            JR Z, .ucsShakeStatuePhase
1142+ F281 3D               DEC A
1143+ F282 CA 0B F3         JP Z, .ucsSmokePhase
1144+ F285                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1145+ F285 CD 05 67         CALL ApplyChurchTrapDone
1146+ F288 AF               XOR A
1147+ F289 32 C9 82         LD (ChurchCutscenePhase), A
1148+ F28C 32 9D 5F         LD (ChurchCutsceneFrame), A
1149+ F28F C9               RET
1150+ F290
1151+ F290              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1152+ F290              .ucsLookPhase:
1153+ F290                  ; Frame counter (para detectar fin de fase)
1154+ F290 21 9D 5F         LD HL, ChurchCutsceneFrame
1155+ F293 34               INC (HL)
1156+ F294                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1157+ F294 21 A4 5F         LD HL, ChurchCutsceneLookCount
1158+ F297 35               DEC (HL)
1159+ F298 20 06            JR NZ, .ucsLookCheckEnd
1160+ F29A 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1161+ F29C 77               LD (HL), A
1162+ F29D CD 59 F3         CALL ChurchCutsceneToggleMonsterDir
1163+ F2A0              .ucsLookCheckEnd:
1164+ F2A0 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1165+ F2A3 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1166+ F2A5 D8               RET C                                   ; sigue mirando
1167+ F2A6                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1168+ F2A6                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1169+ F2A6                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1170+ F2A6 CD E1 66         CALL EraseChurchTrappedMonster
1171+ F2A9 CD 9F 69         CALL CloseChurchDoor
1172+ F2AC CD 7E F3         CALL ChurchCutsceneInitStatueShake
1173+ F2AF 3E 02            LD A, 2
1174+ F2B1 32 C9 82         LD (ChurchCutscenePhase), A
1175+ F2B4 AF               XOR A
1176+ F2B5 32 9D 5F         LD (ChurchCutsceneFrame), A
1177+ F2B8 C9               RET
1178+ F2B9
1179+ F2B9              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1180+ F2B9              .ucsShakeStatuePhase:
1181+ F2B9 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1182+ F2BC FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1183+ F2BE 30 35            JR NC, .ucsShakeStatueDone
1184+ F2C0                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1185+ F2C0                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1186+ F2C0                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1187+ F2C0                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1188+ F2C0                  ;
1189+ F2C0                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1190+ F2C0                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1191+ F2C0 ED 5F            LD A, R
1192+ F2C2 E6 03            AND $03
1193+ F2C4 21 F1 F2         LD HL, .ucsShakeJitterTable
1194+ F2C7 5F               LD E, A
1195+ F2C8 16 00            LD D, 0
1196+ F2CA 19               ADD HL, DE
1197+ F2CB 7E               LD A, (HL)
1198+ F2CC 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1199+ F2CD                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1200+ F2CD 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1201+ F2D0 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1202+ F2D2 21 A9 67         LD HL, StatueIdTable
1203+ F2D5 38 03            JR C, .ucsShakeTablePicked
1204+ F2D7 21 AC 67         LD HL, StatueBrokenIdTable
1205+ F2DA              .ucsShakeTablePicked:
1206+ F2DA 78               LD A, B                                 ; restore jitter para la llamada
1207+ F2DB CD E8 F3         CALL ChurchCutsceneShakeStatueByteShift
1208+ F2DE                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1209+ F2DE                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1210+ F2DE                  ; y al salir de la fase forzamos borde a negro explicitamente.
1211+ F2DE 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1212+ F2E1 E6 01            AND $01
1213+ F2E3 28 04            JR Z, .ucsShakeBorderBlack
1214+ F2E5 3E 07            LD A, WHITE
1215+ F2E7 18 01            JR .ucsShakeBorderOut
1216+ F2E9              .ucsShakeBorderBlack:
1217+ F2E9 AF               XOR A                                   ; BLACK
1218+ F2EA              .ucsShakeBorderOut:
1219+ F2EA D3 FE            OUT (254), A
1220+ F2EC 21 9D 5F         LD HL, ChurchCutsceneFrame
1221+ F2EF 34               INC (HL)
1222+ F2F0 C9               RET
1223+ F2F1              .ucsShakeJitterTable:
1224+ F2F1 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1225+ F2F5              .ucsShakeStatueDone:
1226+ F2F5                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1227+ F2F5 AF               XOR A
1228+ F2F6 D3 FE            OUT (254), A
1229+ F2F8                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1230+ F2F8                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1231+ F2F8                  ; directo a 0 garantiza que no queden residuos.)
1232+ F2F8 CD 53 F4         CALL ChurchCutsceneEraseStatueDirect
1233+ F2FB 21 C1 F6         LD HL, SFX_EnemyDeath
1234+ F2FE CD 42 F6         CALL PlaySFX
1235+ F301 3E 03            LD A, 3
1236+ F303 32 C9 82         LD (ChurchCutscenePhase), A
1237+ F306 AF               XOR A
1238+ F307 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1239+ F30A C9               RET
1240+ F30B
1241+ F30B              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1242+ F30B              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1243+ F30B              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1244+ F30B              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1245+ F30B              ; Entre transiciones, solo incrementa frame counter.
1246+ F30B              .ucsSmokePhase:
1247+ F30B 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1248+ F30E B7               OR A
1249+ F30F 28 0E            JR Z, .ucsSmokeEntry
1250+ F311 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1251+ F313 28 16            JR Z, .ucsSmokeStep1
1252+ F315 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1253+ F317 28 1D            JR Z, .ucsSmokeStep2
1254+ F319 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1255+ F31B 28 25            JR Z, .ucsSmokeEnd
1256+ F31D 18 35            JR .ucsSmokeIncFrame
1257+ F31F              .ucsSmokeEntry:
1258+ F31F                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1259+ F31F 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1260+ F322 CD D4 68         CALL DrawRemainsForType
1261+ F325                  ; Dibujar smoke[0] (XOR)
1262+ F325 AF               XOR A
1263+ F326 CD 1F 68         CALL DrawSmokeFrameXor
1264+ F329 18 29            JR .ucsSmokeIncFrame
1265+ F32B              .ucsSmokeStep1:
1266+ F32B AF               XOR A
1267+ F32C CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1268+ F32F 3E 01            LD A, 1
1269+ F331 CD 1F 68         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1270+ F334 18 1E            JR .ucsSmokeIncFrame
1271+ F336              .ucsSmokeStep2:
1272+ F336 3E 01            LD A, 1
1273+ F338 CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1274+ F33B 3E 02            LD A, 2
1275+ F33D CD 1F 68         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1276+ F340 18 12            JR .ucsSmokeIncFrame
1277+ F342              .ucsSmokeEnd:
1278+ F342 3E 02            LD A, 2
1279+ F344 CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1280+ F347 CD 3E 68         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1281+ F34A 3E 04            LD A, 4
1282+ F34C 32 C9 82         LD (ChurchCutscenePhase), A
1283+ F34F AF               XOR A
1284+ F350 32 9D 5F         LD (ChurchCutsceneFrame), A
1285+ F353 C9               RET
1286+ F354              .ucsSmokeIncFrame:
1287+ F354 21 9D 5F         LD HL, ChurchCutsceneFrame
1288+ F357 34               INC (HL)
1289+ F358 C9               RET
1290+ F359
1291+ F359              ; ==============================================================================
1292+ F359              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1293+ F359              ; ==============================================================================
1294+ F359              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1295+ F359              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1296+ F359              ; ==============================================================================
1297+ F359              ChurchCutsceneToggleMonsterDir:
1298+ F359                  ; IX = trapped monster
1299+ F359 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1300+ F35C 3C               INC A
1301+ F35D 6F               LD L, A
1302+ F35E 26 00            LD H, 0
1303+ F360 29               ADD HL, HL
1304+ F361 29               ADD HL, HL
1305+ F362 29               ADD HL, HL
1306+ F363 29               ADD HL, HL
1307+ F364 11 9E 81         LD DE, EntityTable
1308+ F367 19               ADD HL, DE
1309+ F368 E5               PUSH HL
1310+ F369 DD E1            POP IX
1311+ F36B                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1312+ F36B DD 7E 00         LD A, (IX+ENT_SPRITEID)
1313+ F36E DD 96 08         SUB (IX+ENT_ANIMBASE)
1314+ F371 EE 04            XOR 4
1315+ F373 47               LD B, A
1316+ F374 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1317+ F377 80               ADD A, B
1318+ F378 DD 77 00         LD (IX+ENT_SPRITEID), A
1319+ F37B C3 6D F4         JP RedrawTrappedMonster
1320+ F37E
1321+ F37E              ; ==============================================================================
1322+ F37E              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1323+ F37E              ; ==============================================================================
1324+ F37E              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1325+ F37E              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1326+ F37E              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1327+ F37E              ; ==============================================================================
1328+ F37E              ChurchCutsceneInitStatueShake:
1329+ F37E 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1330+ F381 21 A9 67         LD HL, StatueIdTable
1331+ F384 5F               LD E, A
1332+ F385 16 00            LD D, 0
1333+ F387 19               ADD HL, DE
1334+ F388 7E               LD A, (HL)                              ; A = statue id
1335+ F389 B7               OR A
1336+ F38A C8               RET Z                                   ; sin estatua
1337+ F38B 32 BB F3         LD (.cisTargetId), A
1338+ F38E                  ; Buscar en CurrentScreenBuffer
1339+ F38E 2A 0D 83         LD HL, (CurrentScreenAddr)
1340+ F391              .cisLoop:
1341+ F391 7E               LD A, (HL)
1342+ F392 FE FF            CP $FF
1343+ F394 C8               RET Z                                   ; no encontrada (no se hace shake)
1344+ F395 47               LD B, A
1345+ F396 3A BB F3         LD A, (.cisTargetId)
1346+ F399 B8               CP B
1347+ F39A 28 06            JR Z, .cisFound
1348+ F39C 11 04 00         LD DE, 4
1349+ F39F 19               ADD HL, DE
1350+ F3A0 18 EF            JR .cisLoop
1351+ F3A2              .cisFound:
1352+ F3A2 23               INC HL
1353+ F3A3 7E               LD A, (HL)                              ; charX
1354+ F3A4                  ; Pixel X = charX * 8
1355+ F3A4 87               ADD A, A
1356+ F3A5 87               ADD A, A
1357+ F3A6 87               ADD A, A
1358+ F3A7 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1359+ F3AA 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1360+ F3AD 23               INC HL
1361+ F3AE 7E               LD A, (HL)                              ; charY
1362+ F3AF                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1363+ F3AF C6 02            ADD A, BG_Y_OFFSET
1364+ F3B1 87               ADD A, A
1365+ F3B2 87               ADD A, A
1366+ F3B3 87               ADD A, A
1367+ F3B4 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1368+ F3B7 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1369+ F3BA C9               RET
