3651+ B696 3E E8            LD A, SCREEN_MAX_X
3652+ B698 DD 96 03         SUB (IX+ENT_POSX)              ; A = distRight
3653+ B69B B8               CP B
3654+ B69C 30 07            JR NC, .flLeftNear
3655+ B69E 47               LD B, A
3656+ B69F 3A BB 90         LD A, (CurrentEnemySpeed)
3657+ B6A2 4F               LD C, A                         ; → derecha
3658+ B6A3 18 06            JR .flHDone
3659+ B6A5              .flLeftNear:
3660+ B6A5 3A BB 90         LD A, (CurrentEnemySpeed)
