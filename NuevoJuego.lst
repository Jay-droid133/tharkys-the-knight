 618+ E040              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 619+ E040              ; ==============================================================================
 620+ E040              ; Llamar cada frame desde el main loop.
 621+ E040              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 622+ E040              ; ==============================================================================
 623+ E040              DrawPlazaClock:
 624+ E040 3A B9 8C         LD A, (PlazaClockActive)
 625+ E043 B7               OR A
 626+ E044 C8               RET Z
 627+ E045
 628+ E045                  ; --- Calcular posicion actual de las agujas ---
 629+ E045 3A C7 DB         LD A, (GameHours)
 630+ E048 FE 0C            CP 12
 631+ E04A 38 02            JR C, .pCalcHourOk
 632+ E04C D6 0C            SUB 12
 633+ E04E              .pCalcHourOk:
 634+ E04E 57               LD D, A                     ; D = display hour (0-11)
 635+ E04F 3A C6 DB         LD A, (GameMinutes)
 636+ E052 1E 00            LD E, 0
 637+ E054              .pCalcDiv5:
 638+ E054 FE 05            CP 5
 639+ E056 38 05            JR C, .pCalcMinOk
 640+ E058 D6 05            SUB 5
 641+ E05A 1C               INC E
 642+ E05B 18 F7            JR .pCalcDiv5
 643+ E05D              .pCalcMinOk:
 644+ E05D                  ; D = hour pos (0-11), E = minute pos (0-11)
 645+ E05D
 646+ E05D                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 647+ E05D 3A B1 E0         LD A, (PlazaLastHour)
 648+ E060 BA               CP D
 649+ E061 20 05            JR NZ, .pNeedsRedraw
 650+ E063 3A B2 E0         LD A, (PlazaLastMin)
 651+ E066 BB               CP E
 652+ E067 C8               RET Z                       ; sin cambio → no redibujar
 653+ E068
 654+ E068              .pNeedsRedraw:
 655+ E068 7A               LD A, D
 656+ E069 32 B1 E0         LD (PlazaLastHour), A
 657+ E06C 7B               LD A, E
 658+ E06D 32 B2 E0         LD (PlazaLastMin), A
 659+ E070
 660+ E070                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 661+ E070                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 662+ E070 DD 21 93 89      LD IX, PlazaClockPixels
 663+ E074 FD 21 BC 8C      LD IY, PlazaScanAddrs
 664+ E078 06 10            LD B, 16
 665+ E07A              .faceRow:
 666+ E07A FD 6E 00         LD L, (IY+0)
 667+ E07D FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 668+ E080 DD 7E 00         LD A, (IX+0)
 669+ E083 2F               CPL                         ; des-invertir (dato CPL'd)
 670+ E084 77               LD (HL), A                  ; byte izquierdo
 671+ E085 23               INC HL
 672+ E086 DD 7E 01         LD A, (IX+1)
 673+ E089 2F               CPL
 674+ E08A 77               LD (HL), A                  ; byte derecho
 675+ E08B DD 23            INC IX
 676+ E08D DD 23            INC IX
 677+ E08F FD 23            INC IY
 678+ E091 FD 23            INC IY
 679+ E093 10 E5            DJNZ .faceRow
 680+ E095
 681+ E095                  ; --- Aguja de horas ---
 682+ E095 3A B1 E0         LD A, (PlazaLastHour)
 683+ E098 21 C3 DC         LD HL, HourHandPtrs
 684+ E09B CD B3 E0         CALL DrawPlazaHandLine
 685+ E09E
 686+ E09E                  ; --- Aguja de minutos ---
 687+ E09E 3A B2 E0         LD A, (PlazaLastMin)
 688+ E0A1 21 DF DB         LD HL, MinHandPtrs
 689+ E0A4 CD B3 E0         CALL DrawPlazaHandLine
 690+ E0A7
 691+ E0A7                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 692+ E0A7 21 CA 8C         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 693+ E0AA 7E               LD A, (HL)
 694+ E0AB 23               INC HL
 695+ E0AC 66               LD H, (HL)
 696+ E0AD 6F               LD L, A                     ; HL = dir VRAM scan line 7
 697+ E0AE CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 698+ E0B0 C9               RET
 699+ E0B1
 700+ E0B1              ; Variables locales reloj plaza
 701+ E0B1 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 702+ E0B2 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 703+ E0B3
 704+ E0B3              ; ==============================================================================
 705+ E0B3              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 706+ E0B3              ; ==============================================================================
 707+ E0B3              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 708+ E0B3              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 709+ E0B3              ; a posiciones relativas y las busca en PlazaScanAddrs.
 710+ E0B3              ; ==============================================================================
 711+ E0B3              DrawPlazaHandLine:
 712+ E0B3                  ; Indexar en tabla de punteros
 713+ E0B3 87               ADD A, A
 714+ E0B4 4F               LD C, A
 715+ E0B5 06 00            LD B, 0
 716+ E0B7 09               ADD HL, BC
 717+ E0B8 7E               LD A, (HL)
 718+ E0B9 23               INC HL
 719+ E0BA 66               LD H, (HL)
 720+ E0BB 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 721+ E0BC
 722+ E0BC              .pxLoop:
 723+ E0BC 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 724+ E0BD B7               OR A
 725+ E0BE C8               RET Z
 726+ E0BF
 727+ E0BF                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 728+ E0BF 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 729+ E0C0 23               INC HL
 730+ E0C1 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 731+ E0C2 23               INC HL
 732+ E0C3 56               LD D, (HL)                  ; D = mask
 733+ E0C4 23               INC HL
 734+ E0C5 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 735+ E0C6
 736+ E0C6                  ; --- Calcular scanLine (0-15) ---
 737+ E0C6 78               LD A, B
 738+ E0C7 E6 07            AND $07                     ; scan dentro del char row (0-7)
 739+ E0C9 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 740+ E0CB 28 02            JR Z, .pxIsTop
 741+ E0CD C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 742+ E0CF              .pxIsTop:
 743+ E0CF                  ; A = scanLine (0-15)
 744+ E0CF
 745+ E0CF                  ; --- Calcular colOffset (0 o 1) ---
 746+ E0CF 5F               LD E, A                     ; E = scanLine (guardar)
 747+ E0D0 79               LD A, C
 748+ E0D1 E6 1F            AND $1F                     ; extraer columna
 749+ E0D3 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 750+ E0D5 4F               LD C, A                     ; C = colOffset
 751+ E0D6
 752+ E0D6                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 753+ E0D6 7B               LD A, E                     ; A = scanLine
 754+ E0D7 87               ADD A, A                    ; *2 (word index)
 755+ E0D8 21 BC 8C         LD HL, PlazaScanAddrs
 756+ E0DB 85               ADD A, L
 757+ E0DC 6F               LD L, A
 758+ E0DD 30 01            JR NC, .pxNC
 759+ E0DF 24               INC H
 760+ E0E0              .pxNC:
 761+ E0E0 7E               LD A, (HL)
 762+ E0E1 23               INC HL
 763+ E0E2 66               LD H, (HL)
 764+ E0E3 81               ADD A, C                    ; sumar colOffset
 765+ E0E4 6F               LD L, A                     ; HL = dir VRAM destino
 766+ E0E5
 767+ E0E5                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 768+ E0E5 7A               LD A, D
 769+ E0E6 2F               CPL
 770+ E0E7 A6               AND (HL)
 771+ E0E8 77               LD (HL), A
 772+ E0E9
 773+ E0E9 E1               POP HL                      ; restaurar puntero datos
 774+ E0EA 18 D0            JR .pxLoop
 775+ E0EC
