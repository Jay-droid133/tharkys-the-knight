4438+ B7EE              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4439+ B7EE              ; ==============================================================================
4440+ B7EE              UpdateEnemySpeed:
4441+ B7EE 3A D2 B8         LD A, (DayCycleCount)
4442+ B7F1 3D               DEC A                               ; 0-based index
4443+ B7F2 FE 0A            CP 10
4444+ B7F4 38 02            JR C, .uesOk
4445+ B7F6 3E 09            LD A, 9                             ; Cap en indice 9
4446+ B7F8              .uesOk:
4447+ B7F8 F5               PUSH AF                             ; Guardar indice para tabla de anim
4448+ B7F9 21 1C B8         LD HL, EnemySpeedTable
4449+ B7FC 5F               LD E, A
4450+ B7FD 16 00            LD D, 0
4451+ B7FF 19               ADD HL, DE
4452+ B800 7E               LD A, (HL)                          ; A = velocidad × 2
4453+ B801                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4454+ B801 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4455+ B803 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4456+ B805                  ; Hay fraccion .5: alternar +1 en frames impares
4457+ B805 47               LD B, A                             ; B = parte entera
4458+ B806 3A AE 80         LD A, (GameFrameCounter)
4459+ B809 E6 01            AND 1                               ; 0 en par, 1 en impar
4460+ B80B 80               ADD A, B                            ; Sumar 0 o 1
4461+ B80C              .uesNoFrac:
4462+ B80C 32 CE 8F         LD (CurrentEnemySpeed), A
4463+ B80F                  ; Leer delay de animacion para este ciclo
4464+ B80F F1               POP AF                              ; A = indice 0-based
4465+ B810 21 26 B8         LD HL, EnemyAnimDelayTable
4466+ B813 5F               LD E, A
4467+ B814 16 00            LD D, 0
4468+ B816 19               ADD HL, DE
4469+ B817 7E               LD A, (HL)
4470+ B818 32 CF 8F         LD (CurrentEnemyAnimDelay), A
4471+ B81B C9               RET
4472+ B81C
4473+ B81C              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4474+ B81C              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4475+ B81C              EnemySpeedTable:
4476+ B81C 02               DEFB 2                              ; Ciclo 1: 1px
4477+ B81D 03               DEFB 3                              ; Ciclo 2: 1.5px
4478+ B81E 04               DEFB 4                              ; Ciclo 3: 2px
