1239+ A5E6                  ; Timer = ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT (fijo, 25fps constante)
1240+ A5E6 3E 05            LD A, ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT
1241+ A5E8 32 58 B2         LD (AttackTimer), A
