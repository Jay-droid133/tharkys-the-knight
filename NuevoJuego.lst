 538+ E648              ; ==============================================================================
 539+ E648              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E648              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E648              ; ==============================================================================
 542+ E648              DrawDayCycleHUD:
 543+ E648                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E648 21 06 E9         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E64B 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E64E CD BD E6         CALL .drawChar
 547+ E651 21 0E E9         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E654 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E657 CD BD E6         CALL .drawChar
 550+ E65A 21 16 E9         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E65D 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E660 CD BD E6         CALL .drawChar
 553+ E663                  ; Col 7 = espacio (limpiar)
 554+ E663 11 07 40         LD DE, $4007
 555+ E666 CD C6 E6         CALL .clearChar
 556+ E669
 557+ E669                  ; --- Digito decenas (col 8) ---
 558+ E669 3A 24 BD         LD A, (DayCycleCount)
 559+ E66C FE 0A            CP 10
 560+ E66E 38 20            JR C, .singleDigit
 561+ E670                  ; Dos digitos: dividir A / 10
 562+ E670 06 00            LD B, 0
 563+ E672              .divLoop:
 564+ E672 D6 0A            SUB 10
 565+ E674 04               INC B
 566+ E675 FE 0A            CP 10
 567+ E677 30 F9            JR NC, .divLoop
 568+ E679                  ; B = decenas, A = unidades
 569+ E679 F5               PUSH AF                             ; Guardar unidades
 570+ E67A 78               LD A, B
 571+ E67B CD B0 E6         CALL .getDigitFont
 572+ E67E 11 08 40         LD DE, $4008                        ; Col 8
 573+ E681 CD BD E6         CALL .drawChar
 574+ E684 F1               POP AF                              ; Recuperar unidades
 575+ E685 CD B0 E6         CALL .getDigitFont
 576+ E688 11 09 40         LD DE, $4009                        ; Col 9
 577+ E68B CD BD E6         CALL .drawChar
 578+ E68E 18 14            JR .setAttrs
 579+ E690
 580+ E690              .singleDigit:
 581+ E690                  ; Una cifra: decena = 0, unidad = A
 582+ E690 F5               PUSH AF
 583+ E691 21 1E E9         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E694 11 08 40         LD DE, $4008                        ; Col 8
 585+ E697 CD BD E6         CALL .drawChar
 586+ E69A F1               POP AF
 587+ E69B CD B0 E6         CALL .getDigitFont
 588+ E69E 11 09 40         LD DE, $4009                        ; Col 9
 589+ E6A1 CD BD E6         CALL .drawChar
 590+ E6A4
 591+ E6A4              .setAttrs:
 592+ E6A4                  ; Atributos: bright white en cols 4-9
 593+ E6A4 3E 47            LD A, $47
 594+ E6A6 21 04 58         LD HL, ATTR_BASE + 4
 595+ E6A9 06 06            LD B, 6
 596+ E6AB              .attrLoop:
 597+ E6AB 77               LD (HL), A
 598+ E6AC 23               INC HL
 599+ E6AD 10 FC            DJNZ .attrLoop
 600+ E6AF C9               RET
 601+ E6B0
 602+ E6B0              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E6B0              ; A se destruye
 604+ E6B0              .getDigitFont:
 605+ E6B0 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E6B2 6F               LD L, A
 607+ E6B3 26 00            LD H, 0
 608+ E6B5 29               ADD HL, HL
 609+ E6B6 29               ADD HL, HL
 610+ E6B7 29               ADD HL, HL                          ; HL = indice * 8
 611+ E6B8 01 06 E9         LD BC, DayHudFont
 612+ E6BB 09               ADD HL, BC
 613+ E6BC C9               RET
 614+ E6BD
 615+ E6BD              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 616+ E6BD              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 617+ E6BD              .drawChar:
 618+ E6BD 06 08            LD B, 8
 619+ E6BF              .charLoop:
 620+ E6BF 7E               LD A, (HL)
 621+ E6C0 12               LD (DE), A
 622+ E6C1 23               INC HL
 623+ E6C2 14               INC D
 624+ E6C3 10 FA            DJNZ .charLoop
 625+ E6C5 C9               RET
 626+ E6C6
 627+ E6C6              ; Limpia 8 scan lines en VRAM (DE)
 628+ E6C6              .clearChar:
 629+ E6C6 06 08            LD B, 8
 630+ E6C8 AF               XOR A
 631+ E6C9              .clearLoop:
 632+ E6C9 12               LD (DE), A
 633+ E6CA 14               INC D
 634+ E6CB 10 FC            DJNZ .clearLoop
 635+ E6CD C9               RET
 636+ E6CE
 637+ E6CE              ; ==============================================================================
 638+ E6CE              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 639+ E6CE              ; ==============================================================================
 640+ E6CE              DrawPlayerSpeedHUD:
 641+ E6CE 3A 8E 8D         LD A, (PlayerCurrentSpeed)
 642+ E6D1 C6 30            ADD A, '0'
 643+ E6D3 1E 02            LD E, 2
 644+ E6D5 CD 2E E7         CALL DrawHudCharRow0
 645+ E6D8                  ; Atributo (bright white)
 646+ E6D8 3E 47            LD A, $47
 647+ E6DA 32 02 58         LD (ATTR_BASE + 2), A
 648+ E6DD C9               RET
 649+ E6DE
 650+ E6DE              ; ==============================================================================
 651+ E6DE              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 652+ E6DE              ; ==============================================================================
 653+ E6DE              DrawZoneCountHUD:
 654+ E6DE 3A 00 5D         LD A, (ZoneCellCount)
 655+ E6E1                  ; Hi nibble
 656+ E6E1 47               LD B, A
 657+ E6E2 CB 3F            SRL A
 658+ E6E4 CB 3F            SRL A
 659+ E6E6 CB 3F            SRL A
 660+ E6E8 CB 3F            SRL A
 661+ E6EA FE 0A            CP 10
 662+ E6EC 38 04            JR C, .dzcHiDigit
 663+ E6EE C6 37            ADD A, 'A' - 10
 664+ E6F0 18 02            JR .dzcHiOut
 665+ E6F2              .dzcHiDigit:
 666+ E6F2 C6 30            ADD A, '0'
 667+ E6F4              .dzcHiOut:
 668+ E6F4 1E 0B            LD E, 11
 669+ E6F6 CD 2E E7         CALL DrawHudCharRow0
 670+ E6F9                  ; Lo nibble
 671+ E6F9 78               LD A, B
 672+ E6FA E6 0F            AND $0F
 673+ E6FC FE 0A            CP 10
 674+ E6FE 38 04            JR C, .dzcLoDigit
 675+ E700 C6 37            ADD A, 'A' - 10
 676+ E702 18 02            JR .dzcLoOut
 677+ E704              .dzcLoDigit:
 678+ E704 C6 30            ADD A, '0'
 679+ E706              .dzcLoOut:
 680+ E706 1E 0C            LD E, 12
 681+ E708 CD 2E E7         CALL DrawHudCharRow0
 682+ E70B 3E 47            LD A, $47
 683+ E70D 32 0B 58         LD (ATTR_BASE + 11), A
 684+ E710 32 0C 58         LD (ATTR_BASE + 12), A
 685+ E713 C9               RET
 686+ E714
 687+ E714              ; ==============================================================================
 688+ E714              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 689+ E714              ; ==============================================================================
 690+ E714              DrawEnemySpeedHUD:
 691+ E714                  ; "V" en columna 30
 692+ E714 3E 56            LD A, 'V'
 693+ E716 1E 1E            LD E, 30
 694+ E718 CD 2E E7         CALL DrawHudCharRow0
 695+ E71B                  ; Numero de velocidad en columna 31
 696+ E71B 3A 5D 8D         LD A, (CurrentEnemySpeed)
 697+ E71E C6 30            ADD A, '0'
 698+ E720 1E 1F            LD E, 31
 699+ E722 CD 2E E7         CALL DrawHudCharRow0
 700+ E725                  ; Atributos (bright white)
 701+ E725 3E 47            LD A, $47
 702+ E727 32 1E 58         LD (ATTR_BASE + 30), A
 703+ E72A 32 1F 58         LD (ATTR_BASE + 31), A
 704+ E72D C9               RET
 705+ E72E
 706+ E72E              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 707+ E72E              ; A = codigo ASCII, E = columna (0-31)
 708+ E72E              DrawHudCharRow0:
 709+ E72E 6F               LD L, A
 710+ E72F 26 00            LD H, 0
 711+ E731 29               ADD HL, HL
 712+ E732 29               ADD HL, HL
 713+ E733 29               ADD HL, HL
 714+ E734 01 00 3C         LD BC, $3C00
 715+ E737 09               ADD HL, BC                  ; HL = font data
 716+ E738 16 40            LD D, $40                   ; Tercio 0, scan line 0
 717+ E73A 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 718+ E73B 5F               LD E, A                     ; DE = dir VRAM
 719+ E73C 06 08            LD B, 8
 720+ E73E              .row0Char:
 721+ E73E 7E               LD A, (HL)
 722+ E73F 12               LD (DE), A
 723+ E740 23               INC HL
 724+ E741 14               INC D                       ; siguiente scan line
 725+ E742 10 FA            DJNZ .row0Char
 726+ E744 C9               RET
