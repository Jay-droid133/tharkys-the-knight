2382+ D846 32 5A D9         LD (.cbtSpY), A
2383+ D849                  ; AABB overlap test con extensión +SPEED_RUN pixels en cada lado.
2384+ D849                  ; Motivo: el motor revierte el movimiento al chocar, dejando al player
2385+ D849                  ; hasta 4 px del wall. Sin esta tolerancia, el bump nunca dispararía.
2386+ D849                  ; Horizontal: ext_left = max(0, sprite_left - 4), ext_right = min(255, sprite_right + 4).
2387+ D849 3A 9E 81         LD A, (EntityTable + ENT_POSX)
2388+ D84C 4F               LD C, A                         ; C = player_left
2389+ D84D C6 10            ADD A, 16                       ; A = player_right
2390+ D84F 57               LD D, A
2391+ D850                  ; ext_left: sprite_left - 4 con clamp inferior (sin underflow)
