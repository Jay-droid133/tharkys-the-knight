 367+ E3CA              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E3CA              ; ==============================================================================
 369+ E3CA              ; Entrada: A = sprite ID
 370+ E3CA              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E3CA              ; Preserva: A, DE, IX
 372+ E3CA              ;
 373+ E3CA              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E3CA              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E3CA              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E3CA              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E3CA              ; ==============================================================================
 378+ E3CA              CheckIfHouseSprite:
 379+ E3CA F5               PUSH AF
 380+ E3CB E5               PUSH HL
 381+ E3CC C5               PUSH BC
 382+ E3CD
 383+ E3CD 47               LD B, A                     ; B = id buscado
 384+ E3CE
 385+ E3CE AF               XOR A
 386+ E3CF 32 2B E2         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E3D2
 388+ E3D2 21 E3 DE         LD HL, HouseIdList
 389+ E3D5              .checkLoop:
 390+ E3D5 7E               LD A, (HL)
 391+ E3D6 FE FF            CP $FF
 392+ E3D8 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E3DA B8               CP B
 394+ E3DB 28 03            JR Z, .checkFound
 395+ E3DD 23               INC HL
 396+ E3DE 18 F5            JR .checkLoop
 397+ E3E0
 398+ E3E0              .checkFound:
 399+ E3E0 3E 01            LD A, 1
 400+ E3E2 32 2B E2         LD (BgSpriteIsHouse), A
 401+ E3E5
 402+ E3E5              .checkDone:
 403+ E3E5 C1               POP BC
 404+ E3E6 E1               POP HL
 405+ E3E7 F1               POP AF
 406+ E3E8 C9               RET
 407+ E3E9
 408+ E3E9              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E3E9              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E3E9              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E3E9
 412+ E3E9              ; ==============================================================================
 413+ E3E9              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 414+ E3E9              ; ==============================================================================
 415+ E3E9              ; Formato: XX,YY:NN nombre_room     DY
 416+ E3E9              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 417+ E3E9              ; ==============================================================================
 418+ E3E9              DrawRoomInfo:
 419+ E3E9                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E3E9 1E 00            LD E, 0
 421+ E3EB 06 0D            LD B, 13
 422+ E3ED              .clearLoop:
 423+ E3ED C5               PUSH BC
 424+ E3EE D5               PUSH DE
 425+ E3EF 3E 20            LD A, ' '
 426+ E3F1 CD A4 E5         CALL DrawHudChar
 427+ E3F4 D1               POP DE
 428+ E3F5 C1               POP BC
 429+ E3F6 1C               INC E
 430+ E3F7 10 F4            DJNZ .clearLoop
 431+ E3F9
 432+ E3F9                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 433+ E3F9 3A 0B 83         LD A, (CurrentScreenX)
 434+ E3FC 1E 00            LD E, 0
 435+ E3FE CD 5C E4         CALL .drawDec2
 436+ E401
 437+ E401                  ; --- ',' en col 2 ---
 438+ E401 3E 2C            LD A, ','
 439+ E403 1E 02            LD E, 2
 440+ E405 CD A4 E5         CALL DrawHudChar
 441+ E408
 442+ E408                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E408 3A 0C 83         LD A, (CurrentScreenY)
 444+ E40B 1E 03            LD E, 3
 445+ E40D CD 5C E4         CALL .drawDec2
 446+ E410
 447+ E410                  ; --- ':' en col 5 ---
 448+ E410 3E 3A            LD A, ':'
 449+ E412 1E 05            LD E, 5
 450+ E414 CD A4 E5         CALL DrawHudChar
 451+ E417
 452+ E417                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E417 3A 0C 83         LD A, (CurrentScreenY)
 454+ E41A 6F               LD L, A
 455+ E41B 26 00            LD H, 0
 456+ E41D 29               ADD HL, HL
 457+ E41E 29               ADD HL, HL
 458+ E41F 29               ADD HL, HL
 459+ E420 29               ADD HL, HL                  ; HL = Y * 16
 460+ E421 3A 0B 83         LD A, (CurrentScreenX)
 461+ E424 5F               LD E, A
 462+ E425 16 00            LD D, 0
 463+ E427 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E428 11 40 DD         LD DE, MapTable
 465+ E42B 19               ADD HL, DE
 466+ E42C 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E42D F5               PUSH AF                     ; guardar room index
 468+ E42E
 469+ E42E                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E42E F5               PUSH AF
 471+ E42F 0F               RRCA
 472+ E430 0F               RRCA
 473+ E431 0F               RRCA
 474+ E432 0F               RRCA
 475+ E433 E6 0F            AND $0F
 476+ E435 CD 7A E4         CALL .hexToAscii
 477+ E438 1E 06            LD E, 6
 478+ E43A CD A4 E5         CALL DrawHudChar
 479+ E43D F1               POP AF
 480+ E43E E6 0F            AND $0F
 481+ E440 CD 7A E4         CALL .hexToAscii
 482+ E443 1E 07            LD E, 7
 483+ E445 CD A4 E5         CALL DrawHudChar
 484+ E448
 485+ E448                  ; --- Espacio en col 8 ---
 486+ E448 3E 20            LD A, ' '
 487+ E44A 1E 08            LD E, 8
 488+ E44C CD A4 E5         CALL DrawHudChar
 489+ E44F
 490+ E44F                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E44F F1               POP AF                      ; A = room index (descartar)
 492+ E450
 493+ E450                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E450 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E453 3E 47            LD A, $47                   ; bright white on black
 496+ E455 06 0D            LD B, 13
 497+ E457              .attrLoop:
 498+ E457 77               LD (HL), A
 499+ E458 23               INC HL
 500+ E459 10 FC            DJNZ .attrLoop
 501+ E45B C9               RET
 502+ E45C
 503+ E45C              ; --- Helpers ---
 504+ E45C              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E45C              .drawDec2:
 506+ E45C 4B               LD C, E                     ; guardar columna inicial
 507+ E45D 06 00            LD B, 0                     ; decenas
 508+ E45F              .divLoop:
 509+ E45F FE 0A            CP 10
 510+ E461 38 05            JR C, .divDone
 511+ E463 D6 0A            SUB 10
 512+ E465 04               INC B
 513+ E466 18 F7            JR .divLoop
 514+ E468              .divDone:
 515+ E468                  ; B = decenas, A = unidades
 516+ E468 F5               PUSH AF                     ; guardar unidades
 517+ E469 78               LD A, B
 518+ E46A C6 30            ADD A, '0'
 519+ E46C 59               LD E, C
 520+ E46D C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E46E CD A4 E5         CALL DrawHudChar
 522+ E471 C1               POP BC                      ; restaurar C
 523+ E472 F1               POP AF
 524+ E473 C6 30            ADD A, '0'
 525+ E475 59               LD E, C
 526+ E476 1C               INC E
 527+ E477 C3 A4 E5         JP DrawHudChar              ; tail call
 528+ E47A
 529+ E47A              .hexToAscii:
 530+ E47A FE 0A            CP 10
 531+ E47C 38 03            JR C, .isDigit
 532+ E47E C6 37            ADD A, 'A' - 10
 533+ E480 C9               RET
 534+ E481              .isDigit:
 535+ E481 C6 30            ADD A, '0'
 536+ E483 C9               RET
