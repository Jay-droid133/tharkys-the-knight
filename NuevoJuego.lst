7262+ CBEB              .bfsTryNbr:
7263+ CBEB 32 7A 5F         LD (DBfsTryDir), A
7264+ CBEE 78               LD A, B
7265+ CBEF 32 78 5F         LD (DBfsTryCx), A
7266+ CBF2 79               LD A, C
7267+ CBF3 32 79 5F         LD (DBfsTryCy), A
7268+ CBF6                  ; Bounds: nx <= FFZ_MAX_CX, ny <= FFZ_MAX_CY (sprite cabe sin wrap/HUD)
7269+ CBF6 3A 78 5F         LD A, (DBfsTryCx)
7270+ CBF9 FE 1E            CP FFZ_MAX_CX + 1
7271+ CBFB D0               RET NC
7272+ CBFC 3A 79 5F         LD A, (DBfsTryCy)
7273+ CBFF FE 11            CP FFZ_MAX_CY + 1
7274+ CC01 D0               RET NC
