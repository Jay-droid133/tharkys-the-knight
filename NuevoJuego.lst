 148+ 6734 D5               DEFB 213        ; type idx 0: statue_zombi
 149+ 6735 E1               DEFB 225        ; type idx 1: statue_skeleton
 150+ 6736 D3               DEFB 211        ; type idx 2: statue_ghost
