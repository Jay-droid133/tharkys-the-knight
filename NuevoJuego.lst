1254+ EE83              ; ==============================================================================
1255+ EE83              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1256+ EE83              ; ==============================================================================
1257+ EE83              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1258+ EE83              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1259+ EE83              ; ==============================================================================
1260+ EE83              ChurchCutsceneEraseStatueAtLast:
1261+ EE83              ChurchCutsceneDrawStatueAtLast:
1262+ EE83 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1263+ EE86 21 07 67         LD HL, StatueIdTable
1264+ EE89 5F               LD E, A
1265+ EE8A 16 00            LD D, 0
1266+ EE8C 19               ADD HL, DE
1267+ EE8D 7E               LD A, (HL)                              ; A = statue id
1268+ EE8E B7               OR A
1269+ EE8F C8               RET Z
1270+ EE90                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1271+ EE90 6F               LD L, A
1272+ EE91 26 00            LD H, 0
1273+ EE93 54               LD D, H
1274+ EE94 5D               LD E, L
1275+ EE95 29               ADD HL, HL
1276+ EE96 19               ADD HL, DE                              ; HL = id*3
1277+ EE97 11 7E DA         LD DE, BgGfxPtrById
1278+ EE9A 19               ADD HL, DE
1279+ EE9B 5E               LD E, (HL)
1280+ EE9C 23               INC HL
1281+ EE9D 56               LD D, (HL)                              ; DE = sprite ptr
1282+ EE9E 23               INC HL
1283+ EE9F 7E               LD A, (HL)                              ; A = bank
1284+ EEA0 EB               EX DE, HL                               ; HL = sprite ptr
1285+ EEA1 CD BD 90         CALL LoadBgSpriteToBuffer               ; preserva BC
1286+ EEA4                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1287+ EEA4 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1288+ EEA7 57               LD D, A
1289+ EEA8 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1290+ EEAB 5F               LD E, A
1291+ EEAC C3 8F 68         JP DrawBgSprite16XorAtPixel
1292+ EEAF
1293+ EEAF              ; ==============================================================================
1294+ EEAF              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1295+ EEAF              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1296+ EEAF              ;     A  = jitter signed (-1, 0, +1) en bits.
1297+ EEAF              ; ==============================================================================
1298+ EEAF              ; IN: A = jitter signed (-1, 0, +1) en bits.
1299+ EEAF              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1300+ EEAF              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1301+ EEAF              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1302+ EEAF              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1303+ EEAF              ; version shifted, sin XOR.
1304+ EEAF              ;
1305+ EEAF              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1306+ EEAF              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1307+ EEAF              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1308+ EEAF              ; estatua se perdio cuando la estatua se pinto la primera vez con
1309+ EEAF              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1310+ EEAF              ; de la estatua, el wall perdido no se ve.
1311+ EEAF              ;
1312+ EEAF              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1313+ EEAF              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1314+ EEAF              ; shift de 1 bit no pierde pixels visibles.
1315+ EEAF              ; Destruye: AF, BC, DE, HL, IX.
1316+ EEAF              ; ==============================================================================
1317+ EEAF              ChurchCutsceneShakeStatueByteShift:
1318+ EEAF 32 19 EF         LD (.csbsJitter), A
1319+ EEB2                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1320+ EEB2 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1321+ EEB5 5F               LD E, A
1322+ EEB6 16 00            LD D, 0
1323+ EEB8 19               ADD HL, DE
1324+ EEB9 7E               LD A, (HL)
1325+ EEBA B7               OR A
1326+ EEBB C8               RET Z                                   ; sin estatua
1327+ EEBC 6F               LD L, A
1328+ EEBD 26 00            LD H, 0
1329+ EEBF 54               LD D, H
1330+ EEC0 5D               LD E, L
1331+ EEC1 29               ADD HL, HL
1332+ EEC2 19               ADD HL, DE                              ; HL = id*3
1333+ EEC3 11 7E DA         LD DE, BgGfxPtrById
1334+ EEC6 19               ADD HL, DE
1335+ EEC7 5E               LD E, (HL)
1336+ EEC8 23               INC HL
1337+ EEC9 56               LD D, (HL)                              ; DE = sprite ptr
1338+ EECA 23               INC HL
1339+ EECB 7E               LD A, (HL)                              ; A = bank
1340+ EECC EB               EX DE, HL                               ; HL = sprite ptr
1341+ EECD CD BD 90         CALL LoadBgSpriteToBuffer               ; preserva BC
1342+ EED0                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1343+ EED0 DD 21 F5 88      LD IX, BgSpriteBuffer
1344+ EED4 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1345+ EED7 B7               OR A
1346+ EED8 C8               RET Z
1347+ EED9 47               LD B, A                                 ; B = row counter
1348+ EEDA DD 23            INC IX
1349+ EEDC DD 23            INC IX                                  ; IX -> pixel data
1350+ EEDE                  ; Calcular addr VRAM en (origX, origY)
1351+ EEDE 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1352+ EEE1 57               LD D, A
1353+ EEE2 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1354+ EEE5 5F               LD E, A
1355+ EEE6 CD 1C A1         CALL CalcPixelAddr                      ; HL = VRAM addr
1356+ EEE9              .csbsRow:
1357+ EEE9 C5               PUSH BC
1358+ EEEA E5               PUSH HL                                 ; save inicio fila VRAM
1359+ EEEB                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1360+ EEEB DD 7E 00         LD A, (IX+0)
1361+ EEEE 2F               CPL
1362+ EEEF 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1363+ EEF0 DD 7E 01         LD A, (IX+1)
1364+ EEF3 2F               CPL
1365+ EEF4 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1366+ EEF5                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1367+ EEF5 3A 19 EF         LD A, (.csbsJitter)
1368+ EEF8 B7               OR A
1369+ EEF9 28 0D            JR Z, .csbsWrite                        ; sin shift
1370+ EEFB FA 04 EF         JP M, .csbsLeft                         ; A < 0 -> shift left
1371+ EEFE                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1372+ EEFE CB 3A            SRL D
1373+ EF00 CB 1B            RR E
1374+ EF02 18 04            JR .csbsWrite
1375+ EF04              .csbsLeft:
1376+ EF04 CB 23            SLA E
1377+ EF06 CB 12            RL D
1378+ EF08              .csbsWrite:
1379+ EF08 7A               LD A, D
1380+ EF09 77               LD (HL), A
1381+ EF0A 23               INC HL
1382+ EF0B 7B               LD A, E
1383+ EF0C 77               LD (HL), A
1384+ EF0D E1               POP HL
1385+ EF0E CD 88 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1386+ EF11 DD 23            INC IX
1387+ EF13 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1388+ EF15 C1               POP BC
1389+ EF16 10 D1            DJNZ .csbsRow
1390+ EF18 C9               RET
1391+ EF19 00           .csbsJitter: DEFB 0
1392+ EF1A
1393+ EF1A              ; ==============================================================================
1394+ EF1A              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1395+ EF1A              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1396+ EF1A              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1397+ EF1A              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1398+ EF1A              ; Destruye: AF, BC, HL.
1399+ EF1A              ; ==============================================================================
1400+ EF1A              ChurchCutsceneEraseStatueDirect:
1401+ EF1A 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1402+ EF1D 57               LD D, A
1403+ EF1E 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1404+ EF21 5F               LD E, A
1405+ EF22 CD 1C A1         CALL CalcPixelAddr
1406+ EF25 06 18            LD B, 24                                ; statues son 24 px de alto
1407+ EF27              .csedRow:
1408+ EF27 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1409+ EF28 77               LD (HL), A
1410+ EF29 23               INC HL
1411+ EF2A 77               LD (HL), A
1412+ EF2B 2B               DEC HL                                  ; volver a inicio fila
1413+ EF2C C5               PUSH BC
1414+ EF2D CD 88 9E         CALL NextPixelLine
1415+ EF30 C1               POP BC
1416+ EF31 10 F4            DJNZ .csedRow
1417+ EF33 C9               RET
1418+ EF34
1419+ EF34              ; ==============================================================================
1420+ EF34              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1421+ EF34              ; ==============================================================================
1422+ EF34              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1423+ EF34              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1424+ EF34              ; suficiente para corromper visualmente).
1425+ EF34              ; IN: IX = entity ptr.
1426+ EF34              ; ==============================================================================
1427+ EF34              RedrawTrappedMonster:
1428+ EF34                  ; --- Erase viejo en (OLDX, OLDY) ---
1429+ EF34 CD F3 A7         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1430+ EF37 DD 7E 0D         LD A, (IX+ENT_OLDY)
1431+ EF3A 57               LD D, A
1432+ EF3B DD 7E 0C         LD A, (IX+ENT_OLDX)
1433+ EF3E 5F               LD E, A
1434+ EF3F DD E5            PUSH IX
1435+ EF41 DD 2A 7B A7      LD IX, (OldSprAddr)
1436+ EF45 CD A9 9D         CALL DrawSprite
1437+ EF48 DD E1            POP IX
1438+ EF4A                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1439+ EF4A                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1440+ EF4A DD 56 0D         LD D, (IX+ENT_OLDY)
1441+ EF4D DD 5E 0C         LD E, (IX+ENT_OLDX)
1442+ EF50 CD 21 CF         CALL RestoreOldAttr
1443+ EF53                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1444+ EF53                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1445+ EF53                  ; reponer attrs de pickups que el flujo de entidades pisa con
1446+ EF53                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1447+ EF53                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1448+ EF53                  ; estar bajo el monster.
1449+ EF53 DD E5            PUSH IX
1450+ EF55 CD 85 D5         CALL RefreshPickupAttrs
1451+ EF58 DD E1            POP IX
1452+ EF5A                  ; --- Compute new draw pos ---
1453+ EF5A CD 7D A7         CALL CalcDrawX
1454+ EF5D CD 9D A2         CALL ComputeEnemyDrawY
1455+ EF60                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1456+ EF60 CD C2 A7         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1457+ EF63 3A F6 81         LD A, (EnemyDrawY)
1458+ EF66 57               LD D, A
1459+ EF67 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1460+ EF6A 5F               LD E, A
1461+ EF6B DD E5            PUSH IX
1462+ EF6D DD 2A F1 A7      LD IX, (SpriteAddrTemp)
1463+ EF71 CD C6 9E         CALL CalcEntityAttrSize
1464+ EF74 DD E1            POP IX
1465+ EF76 3A F6 81         LD A, (EnemyDrawY)
1466+ EF79 57               LD D, A
1467+ EF7A DD 7E 0F         LD A, (IX+ENT_DRAWX)
1468+ EF7D 5F               LD E, A
1469+ EF7E DD 7E 05         LD A, (IX+ENT_ATTR)
1470+ EF81 CD 99 9E         CALL SetEntityAttr
1471+ EF84                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1472+ EF84 3A F6 81         LD A, (EnemyDrawY)
1473+ EF87 57               LD D, A
1474+ EF88 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1475+ EF8B 5F               LD E, A
1476+ EF8C DD E5            PUSH IX
1477+ EF8E DD 2A F1 A7      LD IX, (SpriteAddrTemp)
1478+ EF92 CD A9 9D         CALL DrawSprite
1479+ EF95 DD E1            POP IX
1480+ EF97                  ; --- Save OLD = current ---
1481+ EF97 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1482+ EF9A DD 77 0C         LD (IX+ENT_OLDX), A
1483+ EF9D 3A F6 81         LD A, (EnemyDrawY)
1484+ EFA0 DD 77 0D         LD (IX+ENT_OLDY), A
1485+ EFA3 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1486+ EFA6 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1487+ EFA9 C9               RET
