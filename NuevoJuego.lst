 108+ 9C4B              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 109+ 9C4B              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 110+ 9C4B              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 111+ 9C4B              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 112+ 9C4B              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 113+ 9C4B              AY_OverrideBellPeriod:
 114+ 9C4B F3               DI
 115+ 9C4C                  ; R0 = period low (canal A)
 116+ 9C4C 5D               LD E, L
 117+ 9C4D 3E 00            LD A, 0
 118+ 9C4F 01 FD FF         LD BC, $FFFD
 119+ 9C52 ED 79            OUT (C), A
 120+ 9C54 01 FD BF         LD BC, $BFFD
 121+ 9C57 ED 59            OUT (C), E
 122+ 9C59                  ; R1 = period high (canal A)
 123+ 9C59 5C               LD E, H
 124+ 9C5A 3E 01            LD A, 1
 125+ 9C5C 01 FD FF         LD BC, $FFFD
 126+ 9C5F ED 79            OUT (C), A
 127+ 9C61 01 FD BF         LD BC, $BFFD
 128+ 9C64 ED 59            OUT (C), E
 129+ 9C66                  ; R2/R3 (canal B)
 130+ 9C66 5D               LD E, L
 131+ 9C67 3E 02            LD A, 2
 132+ 9C69 01 FD FF         LD BC, $FFFD
 133+ 9C6C ED 79            OUT (C), A
 134+ 9C6E 01 FD BF         LD BC, $BFFD
 135+ 9C71 ED 59            OUT (C), E
 136+ 9C73 5C               LD E, H
 137+ 9C74 3E 03            LD A, 3
 138+ 9C76 01 FD FF         LD BC, $FFFD
 139+ 9C79 ED 79            OUT (C), A
 140+ 9C7B 01 FD BF         LD BC, $BFFD
 141+ 9C7E ED 59            OUT (C), E
 142+ 9C80                  ; R4/R5 (canal C)
 143+ 9C80 5D               LD E, L
 144+ 9C81 3E 04            LD A, 4
 145+ 9C83 01 FD FF         LD BC, $FFFD
 146+ 9C86 ED 79            OUT (C), A
 147+ 9C88 01 FD BF         LD BC, $BFFD
 148+ 9C8B ED 59            OUT (C), E
 149+ 9C8D 5C               LD E, H
 150+ 9C8E 3E 05            LD A, 5
 151+ 9C90 01 FD FF         LD BC, $FFFD
 152+ 9C93 ED 79            OUT (C), A
 153+ 9C95 01 FD BF         LD BC, $BFFD
 154+ 9C98 ED 59            OUT (C), E
 155+ 9C9A FB               EI
 156+ 9C9B C9               RET
