 656+ D4EA              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 657+ D4EA              ; A = codigo ASCII, E = columna (0-31)
 658+ D4EA              DrawHudChar:
 659+ D4EA                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 660+ D4EA 6F               LD L, A
 661+ D4EB 26 00            LD H, 0
 662+ D4ED 29               ADD HL, HL
 663+ D4EE 29               ADD HL, HL
 664+ D4EF 29               ADD HL, HL
 665+ D4F0 01 00 3C         LD BC, $3C00
 666+ D4F3 09               ADD HL, BC                  ; HL = font data
 667+ D4F4
 668+ D4F4                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 669+ D4F4 16 40            LD D, $40                   ; Tercio 0, scan line 0
 670+ D4F6 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 671+ D4F8 83               ADD A, E
 672+ D4F9 5F               LD E, A                     ; DE = dir VRAM
 673+ D4FA
 674+ D4FA 06 08            LD B, 8
