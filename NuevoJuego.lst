5727+ BE74              ; ==============================================================================
5728+ BE74              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5729+ BE74              ; ==============================================================================
5730+ BE74              TryRespawnMonsters:
5731+ BE74                  IF DEBUG_NO_ENEMIES
5732+ BE74 ~                RET
5733+ BE74                  ENDIF
5734+ BE74 3A 9A E3         LD A, (CurrentTimeOfDay)
5735+ BE77 FE 03            CP 3
5736+ BE79 28 05            JR Z, .rmNight
5737+ BE7B FE 04            CP 4
5738+ BE7D 28 01            JR Z, .rmNight
5739+ BE7F C9               RET
5740+ BE80              .rmNight:
5741+ BE80 3A 8C B3         LD A, (MonstersActive)
5742+ BE83 B7               OR A
5743+ BE84 C8               RET Z
5744+ BE85 CD 5C BF         CALL .rmUpdateReturnTimers
5745+ BE88 3A 58 BF         LD A, (.rmTimer)
5746+ BE8B B7               OR A
5747+ BE8C 28 05            JR Z, .rmCheckSlots
5748+ BE8E 3D               DEC A
5749+ BE8F 32 58 BF         LD (.rmTimer), A
5750+ BE92 C9               RET
5751+ BE93              .rmCheckSlots:
5752+ BE93 DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5753+ BE97 06 03            LD B, MONSTERS_TO_SPAWN
5754+ BE99 0E 00            LD C, 0
5755+ BE9B              .rmLoop:
5756+ BE9B C5               PUSH BC
5757+ BE9C DD 7E 01         LD A, (IX+ENT_TYPE)
5758+ BE9F B7               OR A
5759+ BEA0 C2 4C BF         JP NZ, .rmSkip
5760+ BEA3                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5761+ BEA3                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5762+ BEA3                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5763+ BEA3 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5764+ BEA6 B7               OR A
5765+ BEA7 20 09            JR NZ, .rmHasTypeForTrap
5766+ BEA9                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5767+ BEA9 79               LD A, C
5768+ BEAA 21 6E BE         LD HL, MonsterTypeTable
5769+ BEAD 5F               LD E, A
5770+ BEAE 16 00            LD D, 0
5771+ BEB0 19               ADD HL, DE
5772+ BEB1 7E               LD A, (HL)
5773+ BEB2              .rmHasTypeForTrap:
5774+ BEB2 D6 4C            SUB SPRID_MONSTER_0
5775+ BEB4 CB 3F            SRL A
5776+ BEB6 CB 3F            SRL A
5777+ BEB8 CB 3F            SRL A                               ; A = type idx 0..2
5778+ BEBA 21 59 BF         LD HL, .rmTrapBits
5779+ BEBD 5F               LD E, A
5780+ BEBE 16 00            LD D, 0
5781+ BEC0 19               ADD HL, DE
5782+ BEC1 7E               LD A, (HL)
5783+ BEC2 21 C3 82         LD HL, MonsterTrappedFlags
5784+ BEC5 A6               AND (HL)
5785+ BEC6 C2 4C BF         JP NZ, .rmSkip
5786+ BEC9                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5787+ BEC9                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5788+ BEC9                  ; que el player visite su room.
5789+ BEC9 79               LD A, C
5790+ BECA 6F               LD L, A
5791+ BECB 26 00            LD H, 0
5792+ BECD 11 8C 8D         LD DE, MonsterRoomId
5793+ BED0 19               ADD HL, DE
5794+ BED1 7E               LD A, (HL)
5795+ BED2 5F               LD E, A                             ; E = room_id del slot
5796+ BED3 CD B2 8E         CALL MaiGetCurrentScreenId          ; A = current screen_id
5797+ BED6 BB               CP E
5798+ BED7 C2 4C BF         JP NZ, .rmSkip                      ; distinto room → skip
5799+ BEDA                  ; === Activar SIN tocar POSX/POSY ===
5800+ BEDA                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5801+ BEDA                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5802+ BEDA                  ;   - RepositionMonstersAtEntry: gap en entry side
5803+ BEDA                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5804+ BEDA DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5805+ BEDD B7               OR A
5806+ BEDE 20 18            JR NZ, .rmHasType
5807+ BEE0 79               LD A, C
5808+ BEE1 21 6E BE         LD HL, MonsterTypeTable
5809+ BEE4 5F               LD E, A
5810+ BEE5 16 00            LD D, 0
5811+ BEE7 19               ADD HL, DE
5812+ BEE8 7E               LD A, (HL)
5813+ BEE9 DD 77 08         LD (IX+ENT_ANIMBASE), A
5814+ BEEC 79               LD A, C
5815+ BEED 21 71 BE         LD HL, MonsterColorTable
5816+ BEF0 5F               LD E, A
5817+ BEF1 16 00            LD D, 0
5818+ BEF3 19               ADD HL, DE
5819+ BEF4 7E               LD A, (HL)
5820+ BEF5 DD 77 05         LD (IX+ENT_ATTR), A
5821+ BEF8              .rmHasType:
5822+ BEF8 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5823+ BEFB DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5824+ BEFF DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5825+ BF03                  ; Facing
5826+ BF03 57               LD D, A
5827+ BF04 3A A3 81         LD A, (EntityTable + ENT_POSX)
5828+ BF07 DD BE 03         CP (IX+ENT_POSX)
5829+ BF0A 30 05            JR NC, .rmFaceR
5830+ BF0C 7A               LD A, D
5831+ BF0D C6 04            ADD A, MONSTER_FRAMES_LEFT
5832+ BF0F 18 01            JR .rmFaceSet
5833+ BF11              .rmFaceR:
5834+ BF11 7A               LD A, D
5835+ BF12              .rmFaceSet:
5836+ BF12 DD 77 00         LD (IX+ENT_SPRITEID), A
5837+ BF15 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5838+ BF19 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5839+ BF1D DD 36 0A 00      LD (IX+ENT_DIR), 0
5840+ BF21 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5841+ BF25 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5842+ BF29 DD 7E 03         LD A, (IX+ENT_POSX)
5843+ BF2C DD 77 0C         LD (IX+ENT_OLDX), A
5844+ BF2F DD 77 0F         LD (IX+ENT_DRAWX), A
5845+ BF32 DD 7E 04         LD A, (IX+ENT_POSY)
5846+ BF35 DD 77 0D         LD (IX+ENT_OLDY), A
5847+ BF38 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5848+ BF3B DD 77 0E         LD (IX+ENT_OLDSPRID), A
5849+ BF3E                  ; Solo UNO por frame
5850+ BF3E C1               POP BC
5851+ BF3F 3E 14            LD A, MONSTER_ENTRY_GAP
5852+ BF41 32 58 BF         LD (.rmTimer), A
5853+ BF44                  ; Arrancar MonstersMusic la PRIMERA vez que un monster aparece visible.
5854+ BF44                  ; Step=$FF (sentinel inactivo) -> aun no ha sonado nunca esta noche.
5855+ BF44                  ; Tras StartMonstersMusic, Step=0 -> no re-arranca en respawns posteriores.
5856+ BF44                  ; StopMonstersMusic en sunrise restaura Step=$FF para la siguiente noche.
5857+ BF44 3A 99 FB         LD A, (MonstersMusicStep)
5858+ BF47 3C               INC A
5859+ BF48 C0               RET NZ                              ; Step != $FF -> ya arranco, salir
5860+ BF49 C3 5B FB         JP StartMonstersMusic               ; tail-call: arranca el secuencer
5861+ BF4C              .rmSkip:
