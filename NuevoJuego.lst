 248  C999                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ C999              ; ==============================================================================
   2+ C999              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ C999              ; ==============================================================================
   4+ C999              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ C999              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ C999              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ C999              ; ==============================================================================
   8+ C999
   9+ C999              ; ==============================================================================
  10+ C999              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ C999              ; ==============================================================================
  12+ C999              InitScreenSystem:
  13+ C999 3E 07            LD A, START_SCREEN_X
  14+ C99B 32 1D 82         LD (CurrentScreenX), A
  15+ C99E 3E 0F            LD A, START_SCREEN_Y
  16+ C9A0 32 1E 82         LD (CurrentScreenY), A
  17+ C9A3 3E 01            LD A, 1
  18+ C9A5 32 25 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ C9A8 AF               XOR A
  20+ C9A9 32 21 82         LD (ScreenTransition), A
  21+ C9AC CD B0 C9         CALL CalcScreenAddress
  22+ C9AF C9               RET
  23+ C9B0
  24+ C9B0              ; ==============================================================================
  25+ C9B0              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ C9B0              ; ==============================================================================
  27+ C9B0              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ C9B0              ; ==============================================================================
  29+ C9B0              CalcScreenAddress:
  30+ C9B0 3A 1E 82         LD A, (CurrentScreenY)
  31+ C9B3 6F               LD L, A
  32+ C9B4 26 00            LD H, 0
  33+ C9B6 29               ADD HL, HL                  ; x2
  34+ C9B7 29               ADD HL, HL                  ; x4
  35+ C9B8 29               ADD HL, HL                  ; x8
  36+ C9B9 29               ADD HL, HL                  ; x16
  37+ C9BA 3A 1D 82         LD A, (CurrentScreenX)
  38+ C9BD 5F               LD E, A
  39+ C9BE 16 00            LD D, 0
  40+ C9C0 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ C9C1 11 E6 D8         LD DE, MapTable
  42+ C9C4 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ C9C5 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ C9C6                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ C9C6 6F               LD L, A
  46+ C9C7 26 00            LD H, 0
  47+ C9C9 29               ADD HL, HL                  ; index * 2
  48+ C9CA 11 B4 D7         LD DE, RoomTable
  49+ C9CD 19               ADD HL, DE
  50+ C9CE 5E               LD E, (HL)
  51+ C9CF 23               INC HL
  52+ C9D0 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ C9D1                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ C9D1 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ C9D2 CD 88 90         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ C9D5                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ C9D5 11 0A 85         LD DE, CurrentScreenBuffer
  58+ C9D8 ED 53 1F 82      LD (CurrentScreenAddr), DE
  59+ C9DC C9               RET
  60+ C9DD
  61+ C9DD              ; ==============================================================================
  62+ C9DD              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ C9DD              ; ==============================================================================
  64+ C9DD              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ C9DD              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ C9DD              ; por estar atrapado cerca del borde.
  67+ C9DD              ; ==============================================================================
  68+ C9DD              CheckScreenTransition:
  69+ C9DD AF               XOR A
  70+ C9DE 32 21 82         LD (ScreenTransition), A
  71+ C9E1
  72+ C9E1                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ C9E1                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ C9E1                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ C9E1                  ; dispararia transicion sur en plena animacion.
  76+ C9E1 3A 04 82         LD A, (TownGatePhase)
  77+ C9E4 B7               OR A
  78+ C9E5 C0               RET NZ
  79+ C9E6
  80+ C9E6                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ C9E6                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ C9E6                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ C9E6                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ C9E6                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ C9E6                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ C9E6 3A F4 81         LD A, (TimeFrozen)
  87+ C9E9 B7               OR A
  88+ C9EA 28 23            JR Z, .cstNotFrozen
  89+ C9EC 3A EC 81         LD A, (InputDirection)
  90+ C9EF CB 4F            BIT 1, A                    ; S
  91+ C9F1 28 17            JR Z, .cstClearBlockFlag
  92+ C9F3 3A E0 80         LD A, (EntityTable + ENT_POSY)
  93+ C9F6 FE A8            CP SCREEN_MAX_Y
  94+ C9F8 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ C9FA                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ C9FA 3A F5 81         LD A, (BlockedExitSoundFlag)
  97+ C9FD B7               OR A
  98+ C9FE C0               RET NZ                      ; ya sonó, esperar release o move
  99+ C9FF 3E 01            LD A, 1
 100+ CA01 32 F5 81         LD (BlockedExitSoundFlag), A
 101+ CA04 21 1D F2         LD HL, SFX_BlockedExit
 102+ CA07 C3 1E F1         JP PlaySFX                  ; tail call
 103+ CA0A              .cstClearBlockFlag:
 104+ CA0A AF               XOR A
 105+ CA0B 32 F5 81         LD (BlockedExitSoundFlag), A
 106+ CA0E C9               RET
 107+ CA0F              .cstNotFrozen:
 108+ CA0F                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CA0F AF               XOR A
 110+ CA10 32 F5 81         LD (BlockedExitSoundFlag), A
