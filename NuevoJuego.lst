1052+ A800
1053+ A800              ; ==============================================================================
1054+ A800              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1055+ A800              ; ==============================================================================
1056+ A800              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1057+ A800              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1058+ A800              ; ==============================================================================
1059+ A800              GetSpriteAddr:
1060+ A800                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1061+ A800                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1062+ A800 3A E7 90         LD A, (CurrentPaging)
1063+ A803 E6 F8            AND $F8
1064+ A805 F6 06            OR 6
1065+ A807 32 E7 90         LD (CurrentPaging), A
1066+ A80A 01 FD 7F         LD BC, $7FFD
1067+ A80D ED 79            OUT (C), A                  ; bank 6 paginado
1068+ A80F DD 7E 00         LD A, (IX+ENT_SPRITEID)
1069+ A812 6F               LD L, A
1070+ A813 26 00            LD H, 0
1071+ A815 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1072+ A816 11 C1 E7         LD DE, SpriteFrameTable
1073+ A819 19               ADD HL, DE
1074+ A81A 5E               LD E, (HL)
1075+ A81B 23               INC HL
1076+ A81C 56               LD D, (HL)
1077+ A81D ED 53 2F A8      LD (SpriteAddrTemp), DE
1078+ A821 3A E7 90         LD A, (CurrentPaging)
1079+ A824 E6 F8            AND $F8
1080+ A826 32 E7 90         LD (CurrentPaging), A
1081+ A829 01 FD 7F         LD BC, $7FFD
1082+ A82C ED 79            OUT (C), A                  ; bank 0 de vuelta
1083+ A82E C9               RET
1084+ A82F
1085+ A82F 00 00        SpriteAddrTemp: DEFW 0
1086+ A831
1087+ A831              ; ==============================================================================
1088+ A831              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1089+ A831              ; ==============================================================================
1090+ A831              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1091+ A831              ; Salida:   DE = puntero al sprite data
1092+ A831              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1093+ A831              ; Preserva: IX
1094+ A831              ; Destruye: A, HL
1095+ A831              ; ==============================================================================
1096+ A831              GetOldSpriteAddr:
1097+ A831                  ; Paging inline (ver GetSpriteAddr)
1098+ A831 3A E7 90         LD A, (CurrentPaging)
1099+ A834 E6 F8            AND $F8
1100+ A836 F6 06            OR 6
1101+ A838 32 E7 90         LD (CurrentPaging), A
1102+ A83B 01 FD 7F         LD BC, $7FFD
1103+ A83E ED 79            OUT (C), A
1104+ A840 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1105+ A843 6F               LD L, A
1106+ A844 26 00            LD H, 0
1107+ A846 29               ADD HL, HL
1108+ A847 11 C1 E7         LD DE, SpriteFrameTable
1109+ A84A 19               ADD HL, DE
1110+ A84B 5E               LD E, (HL)
1111+ A84C 23               INC HL
1112+ A84D 56               LD D, (HL)
1113+ A84E ED 53 B9 A7      LD (OldSprAddr), DE
1114+ A852 3A E7 90         LD A, (CurrentPaging)
1115+ A855 E6 F8            AND $F8
1116+ A857 32 E7 90         LD (CurrentPaging), A
1117+ A85A 01 FD 7F         LD BC, $7FFD
1118+ A85D ED 79            OUT (C), A
1119+ A85F C9               RET
1120+ A860
1121+ A860              ; ==============================================================================
1122+ A860              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1123+ A860              ; ==============================================================================
1124+ A860              ; Entrada: A = SpriteID
1125+ A860              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1126+ A860              ; Destruye: A, DE, HL
1127+ A860              ; ==============================================================================
1128+ A860              GetSpriteDims:
1129+ A860                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1130+ A860                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1131+ A860 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1132+ A861 26 00            LD H, 0
1133+ A863 3A E7 90         LD A, (CurrentPaging)
1134+ A866 E6 F8            AND $F8
1135+ A868 F6 06            OR 6
1136+ A86A 32 E7 90         LD (CurrentPaging), A
1137+ A86D 01 FD 7F         LD BC, $7FFD
1138+ A870 ED 79            OUT (C), A                  ; bank 6 paginado
1139+ A872 29               ADD HL, HL
1140+ A873 11 C1 E7         LD DE, SpriteFrameTable
1141+ A876 19               ADD HL, DE
1142+ A877 5E               LD E, (HL)
1143+ A878 23               INC HL
1144+ A879 56               LD D, (HL)                  ; DE = ptr al sprite data
1145+ A87A 1A               LD A, (DE)                  ; width_bytes
1146+ A87B 87               ADD A, A
1147+ A87C 87               ADD A, A
1148+ A87D 87               ADD A, A                    ; × 8 = width_px
1149+ A87E 47               LD B, A
1150+ A87F 13               INC DE
1151+ A880 1A               LD A, (DE)                  ; height_px
1152+ A881 4F               LD C, A
1153+ A882                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1154+ A882 78               LD A, B
1155+ A883 32 A0 A8         LD (GsdSavedB), A
1156+ A886 79               LD A, C
1157+ A887 32 A1 A8         LD (GsdSavedC), A
1158+ A88A 3A E7 90         LD A, (CurrentPaging)
1159+ A88D E6 F8            AND $F8
1160+ A88F 32 E7 90         LD (CurrentPaging), A
1161+ A892 01 FD 7F         LD BC, $7FFD
1162+ A895 ED 79            OUT (C), A                  ; bank 0 de vuelta
1163+ A897 3A A0 A8         LD A, (GsdSavedB)
1164+ A89A 47               LD B, A
1165+ A89B 3A A1 A8         LD A, (GsdSavedC)
1166+ A89E 4F               LD C, A
1167+ A89F C9               RET
1168+ A8A0
1169+ A8A0 00           GsdSavedB: DEFB 0
1170+ A8A1 00           GsdSavedC: DEFB 0
1171+ A8A2
1172+ A8A2              ; ==============================================================================
1173+ A8A2              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1174+ A8A2              ; ==============================================================================
1175+ A8A2              ; IX = puntero a la entidad del player (slot 0)
1176+ A8A2              ; ==============================================================================
1177+ A8A2              UpdatePlayer:
1178+ A8A2 CD BC A8         CALL UpdatePlayerState
1179+ A8A5 CD D7 A9         CALL UpdatePlayerMovement
1180+ A8A8 CD 50 AC         CALL UpdatePlayerAnimation
1181+ A8AB                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1182+ A8AB                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1183+ A8AB                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1184+ A8AB                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1185+ A8AB                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1186+ A8AB                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1187+ A8AB 3A 91 82         LD A, (PlayerRespawnTimer)
