4547+ BAA6 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4548+ BAAA
4549+ BAAA                  ; Color segun tipo (cada tipo tiene color fijo)
4550+ BAAA DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4551+ BAAD 21 79 BF         LD HL, NastyColorTable
