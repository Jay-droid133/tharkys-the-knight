 524+ F1A7
 525+ F1A7              .dcRedraw:
 526+ F1A7                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F1A7 3A C0 82         LD A, (ObjectiveScreenX)
 528+ F1AA 47               LD B, A
 529+ F1AB 3A 10 83         LD A, (CurrentScreenX)
 530+ F1AE 4F               LD C, A
 531+ F1AF 78               LD A, B
 532+ F1B0 91               SUB C                               ; A = dx (signed)
 533+ F1B1                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F1B1 F2 BB F1         JP P, .dcDxNonNeg
 535+ F1B4 ED 44            NEG
 536+ F1B6 67               LD H, A                             ; abs(dx)
 537+ F1B7 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F1B9 18 0A            JR .dcDxDone
 539+ F1BB              .dcDxNonNeg:
 540+ F1BB 67               LD H, A
 541+ F1BC B7               OR A
 542+ F1BD 20 04            JR NZ, .dcDxPositive
 543+ F1BF 2E 01            LD L, 1                             ; dx == 0
 544+ F1C1 18 02            JR .dcDxDone
 545+ F1C3              .dcDxPositive:
 546+ F1C3 2E 02            LD L, 2
 547+ F1C5              .dcDxDone:
 548+ F1C5 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F1C6
 550+ F1C6                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F1C6 3A C1 82         LD A, (ObjectiveScreenY)
 552+ F1C9 47               LD B, A
 553+ F1CA 3A 11 83         LD A, (CurrentScreenY)
 554+ F1CD 4F               LD C, A
 555+ F1CE 78               LD A, B
 556+ F1CF 91               SUB C
 557+ F1D0 F2 DA F1         JP P, .dcDyNonNeg
 558+ F1D3 ED 44            NEG
 559+ F1D5 67               LD H, A
 560+ F1D6 2E 00            LD L, 0
 561+ F1D8 18 0A            JR .dcDyDone
 562+ F1DA              .dcDyNonNeg:
 563+ F1DA 67               LD H, A
 564+ F1DB B7               OR A
 565+ F1DC 20 04            JR NZ, .dcDyPositive
 566+ F1DE 2E 01            LD L, 1
 567+ F1E0 18 02            JR .dcDyDone
 568+ F1E2              .dcDyPositive:
 569+ F1E2 2E 02            LD L, 2
 570+ F1E4              .dcDyDone:
