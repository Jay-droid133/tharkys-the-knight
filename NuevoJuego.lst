 224  E18E                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ E18E              ; ==============================================================================
   2+ E18E              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ E18E              ; ==============================================================================
   4+ E18E              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ E18E              ; Para cada shift S:
   6+ E18E              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ E18E              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ E18E              ;
   9+ E18E              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ E18E              ;
  11+ E18E              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ E18E              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ E18E              ;
  14+ E18E              ; Calculo de B desde X%8:
  15+ E18E              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ E18E              ; ==============================================================================
  17+ E18E
  18+ E18E 00 00 00...      ALIGN 256
  19+ E200              ShiftTables:
  20+ E200                  LUA ALLPASS
  21+ E200 ~                for shift = 1, 7 do
  22+ E200 ~                    -- High part: byte >> shift
  23+ E200 ~                    for i = 0, 255 do
  24+ E200 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ E200 ~                    end
  26+ E200 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ E200 ~                    for i = 0, 255 do
  28+ E200 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ E200 ~                    end
  30+ E200 ~                end
  31+ E200 00 00 01 01      ENDLUA
