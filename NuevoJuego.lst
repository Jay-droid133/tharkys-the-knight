4779+ B94A FE 18            CP 24
4780+ B94C 38 44            JR C, .spawnBlocked                 ; |dx| < 24 AND |dy| < 24 → demasiado cerca
4781+ B94E              .spPlayerOk:
4782+ B94E                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4783+ B94E                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4784+ B94E DD E5            PUSH IX
4785+ B950 E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4786+ B951 FD 21 10 82      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4787+ B955 06 03            LD B, NUM_NASTIES
4788+ B957              .spDistLoop:
4789+ B957 C5               PUSH BC
4790+ B958 E5               PUSH HL
4791+ B959 FD E5            PUSH IY
4792+ B95B D1               POP DE                              ; DE = ptr al slot vecino
4793+ B95C B7               OR A
4794+ B95D ED 52            SBC HL, DE                          ; HL == 0 → mismo slot, skip
4795+ B95F E1               POP HL
4796+ B960 28 25            JR Z, .spDistNext
4797+ B962 FD 7E 01         LD A, (IY+ENT_TYPE)
4798+ B965 B7               OR A
