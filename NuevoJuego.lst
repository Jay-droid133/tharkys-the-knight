2721+ B13A DD 7E 03         LD A, (IX+ENT_POSX)
2722+ B13D FE E8            CP SCREEN_MAX_X
2723+ B13F 30 30            JR NC, .moKbPreOffscreen
2724+ B141 FE 04            CP MONSTER_KB_SPEED
2725+ B143 38 20            JR C, .moKbPreOffscreenMaybeX
2726+ B145              .moKbPreBorderXOk:
2727+ B145 DD 7E 04         LD A, (IX+ENT_POSY)
2728+ B148 FE A8            CP SCREEN_MAX_Y
2729+ B14A 30 25            JR NC, .moKbPreOffscreen
2730+ B14C FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2731+ B14E 38 1B            JR C, .moKbPreOffscreenMaybeY
2732+ B150              .moKbPreBorderOk:
2733+ B150                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2734+ B150                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2735+ B150                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2736+ B150                  ; CheckEnemyCollision.
2737+ B150                  ; CheckChurchTrap retorna:
2738+ B150                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2739+ B150                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2740+ B150                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2741+ B150 CD CD F3         CALL CheckChurchTrap
2742+ B153 B7               OR A
2743+ B154 28 07            JR Z, .moKbCollCheck
2744+ B156 FE 02            CP 2
2745+ B158 CA 09 B2         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2746+ B15B D1               POP DE                              ; limpiar PUSH DE previo
2747+ B15C C9               RET                                 ; cutscene activa, salir
2748+ B15D              .moKbCollCheck:
2749+ B15D                  ; Dentro de pantalla: comprobar colision con paredes
2750+ B15D CD D6 B9         CALL CheckEnemyCollision
2751+ B160 C2 09 B2         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2752+ B163 18 1C            JR .moKbNotBlocked
