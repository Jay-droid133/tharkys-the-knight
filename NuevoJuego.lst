5395+ BFED              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5396+ BFED              ; ==============================================================================
5397+ BFED              ScareAllMonsters:
5398+ BFED AF               XOR A
5399+ BFEE 32 3E B6         LD (MonstersActive), A              ; No respawnear mas
5400+ BFF1                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5401+ BFF1                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5402+ BFF1                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5403+ BFF1 21 E5 90         LD HL, MonsterAiFlags
5404+ BFF4 06 03            LD B, 3
5405+ BFF6              .samClearLoop:
5406+ BFF6 7E               LD A, (HL)
5407+ BFF7 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5408+ BFF9 77               LD (HL), A
5409+ BFFA 23               INC HL
5410+ BFFB 10 F9            DJNZ .samClearLoop
5411+ BFFD 3E 7D            LD A, SCARE_TIMER_DAWN
5412+ BFFF 32 D4 B8         LD (ScareTimer), A
5413+ C002                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5414+ C002                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5415+ C002                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5416+ C002                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5417+ C002 DD 21 4F 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5418+ C006 06 06            LD B, NUM_MONSTERS
5419+ C008              .samStateLoop:
5420+ C008 DD 7E 01         LD A, (IX+ENT_TYPE)
