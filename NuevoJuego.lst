 388+ E70D FD 21 57 E3      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 389+ E711 CD 88 E7         CALL .drawBar
 390+ E714
 391+ E714                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 392+ E714 3A FC B5         LD A, (PlayerStamina)
