# file opened: code/day_cycle.asm
   1+ E228              ; ==============================================================================
   2+ E228              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E228              ; ==============================================================================
   4+ E228              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E228              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E228              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E228              ; ==============================================================================
   8+ E228
   9+ E228              ; --- Constantes ---
  10+ E228              NUM_TIME_MOMENTS    EQU 7
  11+ E228
  12+ E228              ; --- Variables ---
  13+ E228 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E229 C1 E6        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E22B C1 E6        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E22D 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E22E 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E22F 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E230
  20+ E230              ; ==============================================================================
  21+ E230              ; SetTimeOfDay - Cambia el momento del dia
  22+ E230              ; ==============================================================================
  23+ E230              ; Entrada: A = momento (0-6)
  24+ E230              ; ==============================================================================
  25+ E230              SetTimeOfDay:
  26+ E230 32 28 E2         LD (CurrentTimeOfDay), A
  27+ E233
  28+ E233                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E233 FE 04            CP 4
  30+ E235 20 06            JR NZ, .notNewCycle
  31+ E237 21 A7 BC         LD HL, DayCycleCount
  32+ E23A 34               INC (HL)
  33+ E23B 18 04            JR .skipBellsReset
  34+ E23D              .notNewCycle:
  35+ E23D                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E23D                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E23D                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E23D AF               XOR A
  39+ E23E 32 B6 82         LD (BellsTriggered), A
  40+ E241              .skipBellsReset:
  41+ E241 3A 28 E2         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E244
  43+ E244                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E244 FE 04            CP 4
  45+ E246 28 21            JR Z, .bellsFirst
  46+ E248
  47+ E248                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E248 FE 05            CP 5
  49+ E24A 20 0A            JR NZ, .noScareMon
  50+ E24C CD C1 BC         CALL ScareAllMonsters
  51+ E24F                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  52+ E24F                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  53+ E24F                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  54+ E24F                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  55+ E24F 3E 01            LD A, 1                         ; track 1 = Sunrise
  56+ E251 CD BA 99         CALL StartMusic
  57+ E254 18 07            JR .noKillMon
  58+ E256              .noScareMon:
  59+ E256                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  60+ E256 FE 06            CP 6
  61+ E258 20 03            JR NZ, .noKillMon
  62+ E25A CD 4A BC         CALL KillAllActiveMonsters
  63+ E25D              .noKillMon:
  64+ E25D
  65+ E25D                  ; Actualizar tablas de remap y tabla de nasties
  66+ E25D CD 92 E2         CALL UpdateRemapTables
  67+ E260 CD AA BC         CALL UpdateNastyTable
  68+ E263
  69+ E263                  ; Forzar remap de atributos (sin redibujar pixeles)
  70+ E263 3E 01            LD A, 1
  71+ E265 32 11 83         LD (AttrsDirty), A
  72+ E268 C9               RET
  73+ E269
  74+ E269              .bellsFirst:
  75+ E269                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  76+ E269                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  77+ E269                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  78+ E269                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  79+ E269                  ; que sean nocturnos (Crepuscular), no diurnos.
  80+ E269 CD AA BC         CALL UpdateNastyTable
  81+ E26C                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  82+ E26C                  ; antes de medianoche natural y forzo el evento), saltamos.
  83+ E26C 3A B6 82         LD A, (BellsTriggered)
  84+ E26F B7               OR A
  85+ E270 C0               RET NZ
  86+ E271 3E 01            LD A, 1
  87+ E273 32 B6 82         LD (BellsTriggered), A
  88+ E276 CD A9 F7         CALL StartBellChimes
  89+ E279 C9               RET
  90+ E27A
  91+ E27A              ; ==============================================================================
  92+ E27A              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  93+ E27A              ; ==============================================================================
  94+ E27A              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  95+ E27A              ;   - Salta reloj a 00:00.
  96+ E27A              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  97+ E27A              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  98+ E27A              ;     campanadas como hace el path natural). El usuario quiere que la
  99+ E27A              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 100+ E27A              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 101+ E27A              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 102+ E27A              ;     pero ya esta en N2 -> no-op visual.
 103+ E27A              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 104+ E27A              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 105+ E27A              ;
 106+ E27A              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 107+ E27A              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 108+ E27A              ; aqui no re-dispara nada.
 109+ E27A              ; ==============================================================================
 110+ E27A              TriggerChurchMidnight:
 111+ E27A 3A B6 82         LD A, (BellsTriggered)
 112+ E27D B7               OR A
 113+ E27E C0               RET NZ                              ; bells ya sonaron -> no-op
 114+ E27F 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 115+ E281 CD 71 EA         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 116+ E284 3E 04            LD A, 4
 117+ E286 CD 30 E2         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 118+ E289                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 119+ E289                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 120+ E289                  ; diurnos durante chimes). En este path queremos lo contrario.
 121+ E289 CD 92 E2         CALL UpdateRemapTables
 122+ E28C 3E 01            LD A, 1
 123+ E28E 32 11 83         LD (AttrsDirty), A
 124+ E291 C9               RET
