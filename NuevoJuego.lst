 466  8185                  ; Incrementar contador de frames
 467  8185 3A 9D 81         LD A, (GameFrameCounter)
 468  8188 3C               INC A
 469  8189 32 9D 81         LD (GameFrameCounter), A
 470  818C
 471  818C                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 472  818C              .frameSync:
 473  818C 76               HALT                        ; Dormir hasta siguiente interrupt
 474  818D 3A 9C 81         LD A, (.frameStart)
 475  8190 47               LD B, A
 476  8191 3A 78 5C         LD A, ($5C78)
 477  8194 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 478  8195 FE 02            CP 2
 479  8197 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
 480  8199
 481  8199 C3 00 80         JP MainLoop
