2772+ AE38 38 1B            JR C, .moKbPreOffscreenMaybeY
2773+ AE3A              .moKbPreBorderOk:
2774+ AE3A                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2775+ AE3A                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2776+ AE3A                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2777+ AE3A                  ; CheckEnemyCollision.
2778+ AE3A                  ; CheckChurchTrap retorna:
2779+ AE3A                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2780+ AE3A                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2781+ AE3A                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2782+ AE3A CD 26 F2         CALL CheckChurchTrap
2783+ AE3D B7               OR A
2784+ AE3E 28 07            JR Z, .moKbCollCheck
2785+ AE40 FE 02            CP 2
2786+ AE42 CA F3 AE         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2787+ AE45 D1               POP DE                              ; limpiar PUSH DE previo
2788+ AE46 C9               RET                                 ; cutscene activa, salir
2789+ AE47              .moKbCollCheck:
