1910+ F144              ; ==============================================================================
1911+ F144              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
1912+ F144              ; ==============================================================================
1913+ F144              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
1914+ F144              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
1915+ F144              ; OUT: -
1916+ F144              ; Destruye: AF, BC, DE, HL, IX.
1917+ F144              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
1918+ F144              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
1919+ F144              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
1920+ F144              ; ==============================================================================
1921+ F144              DrawBgSpriteByIdAtChar:
1922+ F144 B7               OR A
1923+ F145 C8               RET Z                                   ; id 0 = no sprite, salir
1924+ F146 C5               PUSH BC
1925+ F147 6F               LD L, A
1926+ F148 26 00            LD H, 0
1927+ F14A 54               LD D, H
1928+ F14B 5D               LD E, L                                 ; DE = id
1929+ F14C 29               ADD HL, HL                              ; *2
1930+ F14D 19               ADD HL, DE                              ; *3
1931+ F14E 11 23 DA         LD DE, BgGfxPtrById
1932+ F151 19               ADD HL, DE
1933+ F152 5E               LD E, (HL)
1934+ F153 23               INC HL
1935+ F154 56               LD D, (HL)                              ; DE = ptr
1936+ F155 23               INC HL
1937+ F156 7E               LD A, (HL)                              ; A = bank
1938+ F157 32 25 CE         LD (CurrentBgSpriteBank), A
1939+ F15A EB               EX DE, HL                               ; HL = ptr
1940+ F15B CD 0A 91         CALL LoadBgSpriteToBuffer               ; preserva BC
1941+ F15E DD 21 42 89      LD IX, BgSpriteBuffer
1942+ F162 C1               POP BC
1943+ F163 C3 19 CD         JP DrawBgGfxSprite                      ; tail call
