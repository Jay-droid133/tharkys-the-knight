 408+ A38F              ; ==============================================================================
 409+ A38F              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 410+ A38F              ; ==============================================================================
 411+ A38F              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 412+ A38F              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 413+ A38F              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 414+ A38F              ; ==============================================================================
 415+ A38F              ProcessEnemies:
 416+ A38F 3E 00            LD A, 0
 417+ A391 32 DA A3         LD (.peCount), A
 418+ A394 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 419+ A396
 420+ A396              .peLoop:
 421+ A396 C5               PUSH BC
 422+ A397
 423+ A397                  ; Calcular IX desde EnemyStepIdx
 424+ A397 3A A8 82         LD A, (EnemyStepIdx)
 425+ A39A C6 01            ADD A, SLOT_MONSTER0
 426+ A39C 6F               LD L, A
 427+ A39D 26 00            LD H, 0
 428+ A39F 29               ADD HL, HL
 429+ A3A0 29               ADD HL, HL
 430+ A3A1 29               ADD HL, HL
 431+ A3A2 29               ADD HL, HL                          ; × ENT_SIZE (16)
 432+ A3A3 11 4B 81         LD DE, EntityTable
 433+ A3A6 19               ADD HL, DE
 434+ A3A7 E5               PUSH HL
 435+ A3A8 DD E1            POP IX
 436+ A3AA
 437+ A3AA                  ; Avanzar indice round-robin
 438+ A3AA 3A A8 82         LD A, (EnemyStepIdx)
 439+ A3AD 3C               INC A
 440+ A3AE FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 441+ A3B0 38 01            JR C, .peNoWrap
 442+ A3B2 AF               XOR A
 443+ A3B3              .peNoWrap:
 444+ A3B3 32 A8 82         LD (EnemyStepIdx), A
 445+ A3B6
 446+ A3B6                  ; Slot activo?
 447+ A3B6 DD 7E 01         LD A, (IX+ENT_TYPE)
 448+ A3B9 B7               OR A
 449+ A3BA 28 16            JR Z, .peSkip
 450+ A3BC
 451+ A3BC                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 452+ A3BC DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 453+ A3C0 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 454+ A3C1
 455+ A3C1                  ; Procesar esta entidad completa (erase + logic + draw)
 456+ A3C1 CD DB A3         CALL ProcessOneEnemy
 457+ A3C4
 458+ A3C4                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 459+ A3C4 F1               POP AF
 460+ A3C5 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 461+ A3C7
 462+ A3C7                  ; Budget check
 463+ A3C7 3A DA A3         LD A, (.peCount)
 464+ A3CA 3C               INC A
 465+ A3CB 32 DA A3         LD (.peCount), A
 466+ A3CE FE 02            CP MAX_ENEMIES_PER_FRAME
 467+ A3D0 30 06            JR NC, .peDone
