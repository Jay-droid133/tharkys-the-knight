 246+ E556              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 247+ E556              DrawSwordModeHUD:
 248+ E556 3A C7 B3         LD A, (SwordMode)
 249+ E559 21 89 E5         LD HL, .modeChars
 250+ E55C 5F               LD E, A
 251+ E55D 16 00            LD D, 0
 252+ E55F 19               ADD HL, DE
 253+ E560 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E561                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E561 21 00 40         LD HL, $4000
 256+ E564                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E564 5F               LD E, A
 258+ E565 16 00            LD D, 0
 259+ E567 42               LD B, D                             ; B = 0
 260+ E568 CB 23            SLA E
