 606+ ED2F CD 51 EF         CALL PickRandomVariantPtr             ; OUT: HL = sprite ptr (raw)
 607+ ED32 18 57            JR .urpActivate
 608+ ED34              .urpDoStamina:
 609+ ED34 3E 03            LD A, ROLLED_STAMINA
 610+ ED36 32 D5 5F         LD (RP_TmpRolled), A
 611+ ED39 21 4C EF         LD HL, StaminaVariantPtrs            ; variantes 73/255
 612+ ED3C CD 51 EF         CALL PickRandomVariantPtr
 613+ ED3F 18 4A            JR .urpActivate
 614+ ED41              .urpDoRayo:
 615+ ED41 3E 04            LD A, ROLLED_RAYO
 616+ ED43 32 D5 5F         LD (RP_TmpRolled), A
 617+ ED46 21 9B EA         LD HL, BgGfx_pickup_ray
 618+ ED49 18 40            JR .urpActivate
 619+ ED4B              .urpDoCaracol:
