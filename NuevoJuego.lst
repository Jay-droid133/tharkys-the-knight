 538+ E484              ; ==============================================================================
 539+ E484              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E484              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E484              ; ==============================================================================
 542+ E484              DrawDayCycleHUD:
 543+ E484                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E484 21 42 E7         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E487 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E48A CD F9 E4         CALL .drawChar
 547+ E48D 21 4A E7         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E490 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E493 CD F9 E4         CALL .drawChar
 550+ E496 21 52 E7         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E499 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E49C CD F9 E4         CALL .drawChar
 553+ E49F                  ; Col 7 = espacio (limpiar)
 554+ E49F 11 07 40         LD DE, $4007
 555+ E4A2 CD 02 E5         CALL .clearChar
 556+ E4A5
 557+ E4A5                  ; --- Digito decenas (col 8) ---
 558+ E4A5 3A AA BC         LD A, (DayCycleCount)
 559+ E4A8 FE 0A            CP 10
 560+ E4AA 38 20            JR C, .singleDigit
 561+ E4AC                  ; Dos digitos: dividir A / 10
 562+ E4AC 06 00            LD B, 0
 563+ E4AE              .divLoop:
 564+ E4AE D6 0A            SUB 10
 565+ E4B0 04               INC B
 566+ E4B1 FE 0A            CP 10
 567+ E4B3 30 F9            JR NC, .divLoop
 568+ E4B5                  ; B = decenas, A = unidades
 569+ E4B5 F5               PUSH AF                             ; Guardar unidades
 570+ E4B6 78               LD A, B
 571+ E4B7 CD EC E4         CALL .getDigitFont
 572+ E4BA 11 08 40         LD DE, $4008                        ; Col 8
 573+ E4BD CD F9 E4         CALL .drawChar
 574+ E4C0 F1               POP AF                              ; Recuperar unidades
 575+ E4C1 CD EC E4         CALL .getDigitFont
 576+ E4C4 11 09 40         LD DE, $4009                        ; Col 9
 577+ E4C7 CD F9 E4         CALL .drawChar
 578+ E4CA 18 14            JR .setAttrs
 579+ E4CC
 580+ E4CC              .singleDigit:
 581+ E4CC                  ; Una cifra: decena = 0, unidad = A
 582+ E4CC F5               PUSH AF
 583+ E4CD 21 5A E7         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E4D0 11 08 40         LD DE, $4008                        ; Col 8
 585+ E4D3 CD F9 E4         CALL .drawChar
 586+ E4D6 F1               POP AF
 587+ E4D7 CD EC E4         CALL .getDigitFont
 588+ E4DA 11 09 40         LD DE, $4009                        ; Col 9
 589+ E4DD CD F9 E4         CALL .drawChar
 590+ E4E0
 591+ E4E0              .setAttrs:
 592+ E4E0                  ; Atributos: bright white en cols 4-9
 593+ E4E0 3E 47            LD A, $47
 594+ E4E2 21 04 58         LD HL, ATTR_BASE + 4
 595+ E4E5 06 06            LD B, 6
 596+ E4E7              .attrLoop:
 597+ E4E7 77               LD (HL), A
 598+ E4E8 23               INC HL
 599+ E4E9 10 FC            DJNZ .attrLoop
 600+ E4EB C9               RET
 601+ E4EC
 602+ E4EC              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E4EC              ; A se destruye
 604+ E4EC              .getDigitFont:
 605+ E4EC C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E4EE 6F               LD L, A
 607+ E4EF 26 00            LD H, 0
 608+ E4F1 29               ADD HL, HL
 609+ E4F2 29               ADD HL, HL
 610+ E4F3 29               ADD HL, HL                          ; HL = indice * 8
 611+ E4F4 01 42 E7         LD BC, DayHudFont
 612+ E4F7 09               ADD HL, BC
 613+ E4F8 C9               RET
 614+ E4F9
 615+ E4F9              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 616+ E4F9              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 617+ E4F9              .drawChar:
 618+ E4F9 06 08            LD B, 8
 619+ E4FB              .charLoop:
 620+ E4FB 7E               LD A, (HL)
 621+ E4FC 12               LD (DE), A
 622+ E4FD 23               INC HL
 623+ E4FE 14               INC D
 624+ E4FF 10 FA            DJNZ .charLoop
 625+ E501 C9               RET
 626+ E502
 627+ E502              ; Limpia 8 scan lines en VRAM (DE)
 628+ E502              .clearChar:
 629+ E502 06 08            LD B, 8
 630+ E504 AF               XOR A
 631+ E505              .clearLoop:
 632+ E505 12               LD (DE), A
 633+ E506 14               INC D
 634+ E507 10 FC            DJNZ .clearLoop
 635+ E509 C9               RET
