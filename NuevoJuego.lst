 955+ A7C2              ; ==============================================================================
 956+ A7C2              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 957+ A7C2              ; ==============================================================================
 958+ A7C2              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 959+ A7C2              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 960+ A7C2              ; ==============================================================================
 961+ A7C2              GetSpriteAddr:
 962+ A7C2                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
 963+ A7C2                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
 964+ A7C2 3A 42 90         LD A, (CurrentPaging)
 965+ A7C5 E6 F8            AND $F8
 966+ A7C7 F6 06            OR 6
 967+ A7C9 32 42 90         LD (CurrentPaging), A
 968+ A7CC 01 FD 7F         LD BC, $7FFD
 969+ A7CF ED 79            OUT (C), A                  ; bank 6 paginado
 970+ A7D1 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 971+ A7D4 6F               LD L, A
 972+ A7D5 26 00            LD H, 0
 973+ A7D7 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 974+ A7D8 11 03 E3         LD DE, SpriteFrameTable
 975+ A7DB 19               ADD HL, DE
 976+ A7DC 5E               LD E, (HL)
 977+ A7DD 23               INC HL
 978+ A7DE 56               LD D, (HL)
 979+ A7DF ED 53 F1 A7      LD (SpriteAddrTemp), DE
 980+ A7E3 3A 42 90         LD A, (CurrentPaging)
 981+ A7E6 E6 F8            AND $F8
 982+ A7E8 32 42 90         LD (CurrentPaging), A
 983+ A7EB 01 FD 7F         LD BC, $7FFD
 984+ A7EE ED 79            OUT (C), A                  ; bank 0 de vuelta
 985+ A7F0 C9               RET
 986+ A7F1
 987+ A7F1 00 00        SpriteAddrTemp: DEFW 0
 988+ A7F3
 989+ A7F3              ; ==============================================================================
 990+ A7F3              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
 991+ A7F3              ; ==============================================================================
 992+ A7F3              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
 993+ A7F3              ; Salida:   DE = puntero al sprite data
 994+ A7F3              ;           OldSprAddr = mismo puntero (conveniencia para caller)
 995+ A7F3              ; Preserva: IX
 996+ A7F3              ; Destruye: A, HL
 997+ A7F3              ; ==============================================================================
 998+ A7F3              GetOldSpriteAddr:
 999+ A7F3                  ; Paging inline (ver GetSpriteAddr)
1000+ A7F3 3A 42 90         LD A, (CurrentPaging)
1001+ A7F6 E6 F8            AND $F8
1002+ A7F8 F6 06            OR 6
1003+ A7FA 32 42 90         LD (CurrentPaging), A
1004+ A7FD 01 FD 7F         LD BC, $7FFD
1005+ A800 ED 79            OUT (C), A
1006+ A802 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1007+ A805 6F               LD L, A
1008+ A806 26 00            LD H, 0
1009+ A808 29               ADD HL, HL
1010+ A809 11 03 E3         LD DE, SpriteFrameTable
1011+ A80C 19               ADD HL, DE
1012+ A80D 5E               LD E, (HL)
1013+ A80E 23               INC HL
1014+ A80F 56               LD D, (HL)
1015+ A810 ED 53 7B A7      LD (OldSprAddr), DE
1016+ A814 3A 42 90         LD A, (CurrentPaging)
1017+ A817 E6 F8            AND $F8
1018+ A819 32 42 90         LD (CurrentPaging), A
1019+ A81C 01 FD 7F         LD BC, $7FFD
1020+ A81F ED 79            OUT (C), A
1021+ A821 C9               RET
1022+ A822
1023+ A822              ; ==============================================================================
1024+ A822              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1025+ A822              ; ==============================================================================
1026+ A822              ; Entrada: A = SpriteID
1027+ A822              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1028+ A822              ; Destruye: A, DE, HL
1029+ A822              ; ==============================================================================
1030+ A822              GetSpriteDims:
1031+ A822                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1032+ A822                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1033+ A822 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1034+ A823 26 00            LD H, 0
1035+ A825 3A 42 90         LD A, (CurrentPaging)
1036+ A828 E6 F8            AND $F8
1037+ A82A F6 06            OR 6
1038+ A82C 32 42 90         LD (CurrentPaging), A
1039+ A82F 01 FD 7F         LD BC, $7FFD
1040+ A832 ED 79            OUT (C), A                  ; bank 6 paginado
1041+ A834 29               ADD HL, HL
1042+ A835 11 03 E3         LD DE, SpriteFrameTable
1043+ A838 19               ADD HL, DE
1044+ A839 5E               LD E, (HL)
1045+ A83A 23               INC HL
1046+ A83B 56               LD D, (HL)                  ; DE = ptr al sprite data
1047+ A83C 1A               LD A, (DE)                  ; width_bytes
1048+ A83D 87               ADD A, A
1049+ A83E 87               ADD A, A
1050+ A83F 87               ADD A, A                    ; × 8 = width_px
1051+ A840 47               LD B, A
1052+ A841 13               INC DE
1053+ A842 1A               LD A, (DE)                  ; height_px
1054+ A843 4F               LD C, A
1055+ A844                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1056+ A844 78               LD A, B
1057+ A845 32 62 A8         LD (GsdSavedB), A
1058+ A848 79               LD A, C
1059+ A849 32 63 A8         LD (GsdSavedC), A
1060+ A84C 3A 42 90         LD A, (CurrentPaging)
1061+ A84F E6 F8            AND $F8
1062+ A851 32 42 90         LD (CurrentPaging), A
1063+ A854 01 FD 7F         LD BC, $7FFD
1064+ A857 ED 79            OUT (C), A                  ; bank 0 de vuelta
1065+ A859 3A 62 A8         LD A, (GsdSavedB)
1066+ A85C 47               LD B, A
1067+ A85D 3A 63 A8         LD A, (GsdSavedC)
1068+ A860 4F               LD C, A
1069+ A861 C9               RET
1070+ A862
1071+ A862 00           GsdSavedB: DEFB 0
1072+ A863 00           GsdSavedC: DEFB 0
1073+ A864
1074+ A864              ; ==============================================================================
1075+ A864              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1076+ A864              ; ==============================================================================
1077+ A864              ; IX = puntero a la entidad del player (slot 0)
1078+ A864              ; ==============================================================================
1079+ A864              UpdatePlayer:
1080+ A864 CD 6E A8         CALL UpdatePlayerState
1081+ A867 CD 89 A9         CALL UpdatePlayerMovement
1082+ A86A CD EE AB         CALL UpdatePlayerAnimation
