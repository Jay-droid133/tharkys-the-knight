 248+ E611 21 41 E6         LD HL, .modeChars
 249+ E614 5F               LD E, A
 250+ E615 16 00            LD D, 0
 251+ E617 19               ADD HL, DE
 252+ E618 7E               LD A, (HL)                          ; A = ASCII del modo
 253+ E619                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 254+ E619 21 00 40         LD HL, $4000
 255+ E61C                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 256+ E61C 5F               LD E, A
 257+ E61D 16 00            LD D, 0
