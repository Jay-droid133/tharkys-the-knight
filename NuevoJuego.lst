 205  F3E9                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ F3E9              ; ==============================================================================
   2+ F3E9              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ F3E9              ; ==============================================================================
   4+ F3E9              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ F3E9              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ F3E9              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ F3E9              ;
   8+ F3E9              ; Esquema de fases:
   9+ F3E9              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ F3E9              ;   2 ARM_IN       arm aparece, pausa
  11+ F3E9              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ F3E9              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ F3E9              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ F3E9              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ F3E9              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ F3E9              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ F3E9              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ F3E9              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ F3E9              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ F3E9              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ F3E9              ;  13 END_HOLD     "The End" sprite hold
  22+ F3E9              ;  14 BLACK        wipe a negro + hold
  23+ F3E9              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ F3E9              ;
  25+ F3E9              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ F3E9              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ F3E9              ; ==============================================================================
  28+ F3E9
  29+ F3E9              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ F3E9              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ F3E9              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ F3E9              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ F3E9              TGCS_T_SHAKE           EQU 90      ; Shake 2D rabioso
  34+ F3E9              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ F3E9              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ F3E9              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ F3E9              TGCS_T_PLAYER_FRAMED   EQU 60      ; Player premece en la puerta
  38+ F3E9              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  39+ F3E9              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  40+ F3E9              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  41+ F3E9
  42+ F3E9              ; --- Posiciones (pixel) ---
  43+ F3E9              TGCS_ANCHOR1_X         EQU 120     ; char (15,10)
  44+ F3E9              TGCS_ANCHOR1_Y         EQU 80
  45+ F3E9              TGCS_ANCHOR2_X         EQU 120     ; char (15,20)
  46+ F3E9              TGCS_ANCHOR2_Y         EQU 160
  47+ F3E9              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  48+ F3E9              TGCS_END_CHARY         EQU 4
  49+ F3E9              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  50+ F3E9
  51+ F3E9              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  52+ F3E9              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  53+ F3E9              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  54+ F3E9              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  55+ F3E9              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  56+ F3E9              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  57+ F3E9              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  58+ F3E9              TGCS_ARM_PX_X          EQU 136
  59+ F3E9              TGCS_ARM_PX_Y          EQU 64
  60+ F3E9              TGCS_FINGER_PX_X       EQU 136
  61+ F3E9              TGCS_FINGER_PX_Y       EQU 56
  62+ F3E9
  63+ F3E9              ; --- Phase enum ---
  64+ F3E9              TGP_IDLE               EQU 0
  65+ F3E9              TGP_LOCK               EQU 1
  66+ F3E9              TGP_ARM_IN             EQU 2
  67+ F3E9              TGP_FINGER_IN          EQU 3
  68+ F3E9              TGP_SHAKE              EQU 4
  69+ F3E9              TGP_FINGER_PULSE       EQU 5
  70+ F3E9              TGP_FINGER_OUT         EQU 6
  71+ F3E9              TGP_ARM_HOLD           EQU 7
  72+ F3E9              TGP_ARM_OUT            EQU 8
  73+ F3E9              TGP_PLAYER_TURN        EQU 9
  74+ F3E9              TGP_PLAYER_HIDE        EQU 10
  75+ F3E9              TGP_PLAYER_FRAMED      EQU 11
  76+ F3E9              TGP_PLAYER_EXIT        EQU 12
  77+ F3E9              TGP_END_HOLD           EQU 13
  78+ F3E9              TGP_BLACK              EQU 14
  79+ F3E9              TGP_CREDITS            EQU 15
  80+ F3E9
  81+ F3E9              ; --- Rect del arco (BG sprite) para el bump-trigger custom ---
  82+ F3E9              ; Placement en screen_rooms.asm Room_T14 (mundo 7,15): DEFB 244, 11, 14
  83+ F3E9              ; (BgGfx_town_gate_v2). DrawScreen suma BG_Y_OFFSET=2 a charY → pixel Y =
  84+ F3E9              ; (14+2)*8 = 128. Tamano sprite 88x64 → rect (88-175, 128-191).
  85+ F3E9              TGCS_ARCH_PX_LEFT      EQU 88        ; 11 * 8
  86+ F3E9              TGCS_ARCH_PX_TOP       EQU 128       ; (14 + 2) * 8
  87+ F3E9              TGCS_ARCH_PX_RIGHT     EQU 175       ; 88 + 88 - 1
  88+ F3E9              TGCS_ARCH_PX_BOTTOM    EQU 191       ; 128 + 64 - 1
  89+ F3E9              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
  90+ F3E9              TGCS_ARCH_ROOM_X       EQU 7
  91+ F3E9              TGCS_ARCH_ROOM_Y       EQU 15
  92+ F3E9              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
  93+ F3E9
  94+ F3E9              ; ==============================================================================
  95+ F3E9              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
  96+ F3E9              ; ==============================================================================
  97+ F3E9              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
  98+ F3E9              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
  99+ F3E9              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 100+ F3E9              ;
 101+ F3E9              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 102+ F3E9              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 103+ F3E9              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 104+ F3E9              ; Destruye: AF, BC, DE, HL, IX.
 105+ F3E9              ; ==============================================================================
 106+ F3E9              CheckTownGateTriggerBg:
 107+ F3E9 3A 3C 82         LD A, (TownGatePhase)
 108+ F3EC B7               OR A
 109+ F3ED C0               RET NZ                              ; ya en cutscene
 110+ F3EE 3A 27 82         LD A, (CurrentKey)
 111+ F3F1 FE 06            CP TGCS_ARCH_KEY_ID
 112+ F3F3 C0               RET NZ                              ; sin la key correcta
 113+ F3F4 3A 55 82         LD A, (CurrentScreenX)
 114+ F3F7 FE 07            CP TGCS_ARCH_ROOM_X
 115+ F3F9 C0               RET NZ
 116+ F3FA 3A 56 82         LD A, (CurrentScreenY)
 117+ F3FD FE 0F            CP TGCS_ARCH_ROOM_Y
 118+ F3FF C0               RET NZ
 119+ F400                  ; --- Horizontal AABB ---
 120+ F400 3A 17 81         LD A, (EntityTable + ENT_POSX)
 121+ F403 4F               LD C, A                             ; C = player_left
 122+ F404 C6 10            ADD A, 16
 123+ F406 57               LD D, A                             ; D = player_right
 124+ F407 3E 58            LD A, TGCS_ARCH_PX_LEFT
 125+ F409 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 126+ F40B 30 01            JR NC, .ctgtNoUnderL
 127+ F40D AF               XOR A
 128+ F40E              .ctgtNoUnderL:
 129+ F40E BA               CP D
 130+ F40F D0               RET NC                              ; ext_left >= player_right
 131+ F410 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 132+ F412 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 133+ F414 30 02            JR NC, .ctgtNoOverR
 134+ F416 3E FF            LD A, $FF
 135+ F418              .ctgtNoOverR:
 136+ F418 B9               CP C
 137+ F419 D8               RET C                               ; ext_right < player_left
 138+ F41A                  ; --- Vertical AABB ---
 139+ F41A                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 140+ F41A                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 141+ F41A                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 142+ F41A                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 143+ F41A                  ; con la altura real del rect.
 144+ F41A 3A 18 81         LD A, (EntityTable + ENT_POSY)
 145+ F41D 4F               LD C, A                             ; C = player_top
 146+ F41E C6 15            ADD A, 21
 147+ F420 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 148+ F421 3E 80            LD A, TGCS_ARCH_PX_TOP
 149+ F423 D6 04            SUB TGCS_ARCH_TOLERANCE
 150+ F425 30 01            JR NC, .ctgtNoUnderT
 151+ F427 AF               XOR A
 152+ F428              .ctgtNoUnderT:
 153+ F428 BA               CP D
 154+ F429 D0               RET NC
 155+ F42A 3E BF            LD A, TGCS_ARCH_PX_BOTTOM
 156+ F42C C6 04            ADD A, TGCS_ARCH_TOLERANCE
 157+ F42E 30 02            JR NC, .ctgtNoOverB
 158+ F430 3E FF            LD A, $FF
 159+ F432              .ctgtNoOverB:
 160+ F432 B9               CP C
 161+ F433 D8               RET C
 162+ F434                  ; HIT
 163+ F434 CD 85 F4         CALL StartTownGateCutscene
 164+ F437 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 165+ F439 C3 F6 E8         JP CheckMilestoneTrigger            ; tail call
 166+ F43C
 167+ F43C              ; ==============================================================================
 168+ F43C              ; TownGateWipeAllEnemies - erase XOR + clear de nastys/monsters/death
 169+ F43C              ; ==============================================================================
 170+ F43C              ; Itera slots 1..NUM_ENTITIES-1 (slot 0 = player, lo dejamos). Para cada
 171+ F43C              ; entidad activa que NO sea TYPE_OBJECT/PLAYER: erase via OldSprite XOR +
 172+ F43C              ; RestoreOldAttr + TYPE_NONE. Igual al pattern de despawn limpio en
 173+ F43C              ; .peScaredDespawn de logic_game.asm.
 174+ F43C              ;
 175+ F43C              ; Llamado desde StartTownGateCutscene antes del snap del player. Asi el
 176+ F43C              ; mundo queda en silencio durante el cutscene final, sin enemigos
 177+ F43C              ; congelados (skip de ProcessEnemies durante cutscene los dejaria pintados
 178+ F43C              ; en su ultima posicion para siempre).
 179+ F43C              ; Destruye: AF, BC, DE, HL, IX.
 180+ F43C              ; ==============================================================================
 181+ F43C              TownGateWipeAllEnemies:
 182+ F43C DD 21 24 81      LD IX, EntityTable + ENT_SIZE       ; slot 1 (skip player)
 183+ F440 06 10            LD B, NUM_ENTITIES - 1
 184+ F442              .tgwaeLoop:
 185+ F442 DD 7E 01         LD A, (IX+ENT_TYPE)
 186+ F445 B7               OR A
 187+ F446 28 31            JR Z, .tgwaeNext                    ; TYPE_NONE: nada que borrar
 188+ F448 FE 04            CP TYPE_OBJECT
 189+ F44A 28 2D            JR Z, .tgwaeNext                    ; objetos coleccionables: respetar
 190+ F44C FE 01            CP TYPE_PLAYER
 191+ F44E 28 29            JR Z, .tgwaeNext                    ; (defensivo)
 192+ F450 C5               PUSH BC                             ; preservar B (loop counter)
 193+ F451 DD E5            PUSH IX                             ; preservar slot ptr
 194+ F453 CD 91 A7         CALL GetOldSpriteAddr               ; OldSprAddr setado, IX intacto
 195+ F456 DD 7E 0D         LD A, (IX+ENT_OLDY)
 196+ F459 57               LD D, A
 197+ F45A DD 7E 0C         LD A, (IX+ENT_OLDX)
 198+ F45D 5F               LD E, A
 199+ F45E DD 2A 19 A7      LD IX, (OldSprAddr)
 200+ F462 CD 47 9D         CALL DrawSprite                     ; XOR erase
 201+ F465 DD E1            POP IX                              ; recuperar slot ptr
 202+ F467 DD 56 0D         LD D, (IX+ENT_OLDY)
 203+ F46A DD 5E 0C         LD E, (IX+ENT_OLDX)
 204+ F46D CD BF CE         CALL RestoreOldAttr                 ; restaurar attrs del fondo
 205+ F470 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 206+ F474 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 207+ F478 C1               POP BC
 208+ F479              .tgwaeNext:
 209+ F479 11 10 00         LD DE, ENT_SIZE
 210+ F47C DD 19            ADD IX, DE
 211+ F47E 10 C2            DJNZ .tgwaeLoop
 212+ F480                  ; Limpiar tambien la cola de pending erases para que EraseDeadSprites
 213+ F480                  ; no intente procesar slots que ya hemos borrado (frame en curso).
 214+ F480 AF               XOR A
 215+ F481 32 7B 5F         LD (PendingEraseCount), A
 216+ F484 C9               RET
 217+ F485
 218+ F485              ; ==============================================================================
 219+ F485              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 220+ F485              ; ==============================================================================
 221+ F485              ; Wipe enemigos (silencio dramatico) + erase puerta cerrada (revela hueco
 222+ F485              ; del arco al instante) + snap player a anchor1 mirando UP.
 223+ F485              ; Set TownGatePhase=1 + TownGateTimer=TGCS_T_LOCK. Consume la TownGateKey.
 224+ F485              ; Destruye: AF, BC, DE, HL, IX.
 225+ F485              ; ==============================================================================
 226+ F485              StartTownGateCutscene:
 227+ F485 AF               XOR A
 228+ F486 32 27 82         LD (CurrentKey), A
 229+ F489 CD 3C F4         CALL TownGateWipeAllEnemies
 230+ F48C CD 00 F7         CALL TownGateEraseDoor              ; puerta cerrada off al disparar trigger
 231+ F48F                  ; Erase player en su posicion actual (XOR redraw del sprite viejo)
 232+ F48F DD 21 14 81      LD IX, EntityTable
 233+ F493 DD E5            PUSH IX
 234+ F495 CD 91 A7         CALL GetOldSpriteAddr
 235+ F498 DD 56 0D         LD D, (IX+ENT_OLDY)
 236+ F49B DD 7E 0C         LD A, (IX+ENT_OLDX)
 237+ F49E 5F               LD E, A
 238+ F49F DD 2A 19 A7      LD IX, (OldSprAddr)
 239+ F4A3 CD 47 9D         CALL DrawSprite
 240+ F4A6 DD E1            POP IX
 241+ F4A8 DD 56 0D         LD D, (IX+ENT_OLDY)
 242+ F4AB DD 5E 0C         LD E, (IX+ENT_OLDX)
 243+ F4AE CD BF CE         CALL RestoreOldAttr
 244+ F4B1                  ; Snap player a anchor1, sprite WALK_N
 245+ F4B1 3E 78            LD A, TGCS_ANCHOR1_X
 246+ F4B3 DD 77 03         LD (IX+ENT_POSX), A
 247+ F4B6 DD 77 0F         LD (IX+ENT_DRAWX), A
 248+ F4B9 3E 50            LD A, TGCS_ANCHOR1_Y
 249+ F4BB DD 77 04         LD (IX+ENT_POSY), A
 250+ F4BE 32 42 82         LD (PlayerDrawY), A
 251+ F4C1 3E 0A            LD A, SPRID_WALK_N
 252+ F4C3 DD 77 00         LD (IX+ENT_SPRITEID), A
 253+ F4C6 DD 77 08         LD (IX+ENT_ANIMBASE), A
 254+ F4C9 AF               XOR A
 255+ F4CA DD 77 09         LD (IX+ENT_ANIMTIMER), A
 256+ F4CD                  ; Draw player en su nueva pose + attrs
 257+ F4CD CD 85 F6         CALL TownGateDrawPlayerHere
 258+ F4D0 CD 9E F8         CALL SFX_TownGate_OnStart
 259+ F4D3 3E 01            LD A, TGP_LOCK
 260+ F4D5 32 3C 82         LD (TownGatePhase), A
 261+ F4D8 3E 3C            LD A, TGCS_T_LOCK
 262+ F4DA 32 A5 5F         LD (TownGateTimer), A
 263+ F4DD C9               RET
 264+ F4DE
 265+ F4DE              ; ==============================================================================
 266+ F4DE              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 267+ F4DE              ; ==============================================================================
 268+ F4DE              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 269+ F4DE              ; transicion a la siguiente.
 270+ F4DE              ; Destruye: AF, BC, DE, HL, IX.
 271+ F4DE              ; ==============================================================================
 272+ F4DE              UpdateTownGateCutscene:
 273+ F4DE 3A 3C 82         LD A, (TownGatePhase)
 274+ F4E1 3D               DEC A
 275+ F4E2 CA 1A F5         JP Z, .tgPhLock
 276+ F4E5 3D               DEC A
 277+ F4E6 CA 32 F5         JP Z, .tgPhArmIn
 278+ F4E9 3D               DEC A
 279+ F4EA CA 4A F5         JP Z, .tgPhFingerIn
 280+ F4ED 3D               DEC A
 281+ F4EE CA 63 F5         JP Z, .tgPhShake
 282+ F4F1 3D               DEC A
 283+ F4F2 CA 7B F5         JP Z, .tgPhFingerPulse
 284+ F4F5 3D               DEC A
 285+ F4F6 CA 93 F5         JP Z, .tgPhFingerOut
 286+ F4F9 3D               DEC A
 287+ F4FA CA A2 F5         JP Z, .tgPhArmHold
 288+ F4FD 3D               DEC A
 289+ F4FE CA BA F5         JP Z, .tgPhArmOut
 290+ F501 3D               DEC A
 291+ F502 CA DF F5         JP Z, .tgPhPlayerTurn
 292+ F505 3D               DEC A
 293+ F506 CA F1 F5         JP Z, .tgPhPlayerHide
 294+ F509 3D               DEC A
 295+ F50A CA 26 F6         JP Z, .tgPhPlayerFramed
 296+ F50D 3D               DEC A
 297+ F50E CA 3C F6         JP Z, .tgPhPlayerExit
 298+ F511 3D               DEC A
 299+ F512 CA 5A F6         JP Z, .tgPhEndHold
 300+ F515 3D               DEC A
 301+ F516 CA 6C F6         JP Z, .tgPhBlack
 302+ F519                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 303+ F519 C9               RET
 304+ F51A
 305+ F51A              ; ---- Phase 1: lock + facing UP ----
 306+ F51A              .tgPhLock:
 307+ F51A CD 7C F6         CALL TownGateDecTimer
 308+ F51D C0               RET NZ
 309+ F51E 11 D6 E5         LD DE, BgGfx_arm
 310+ F521 CD 13 D3         CALL RedrawPickupByPtr
