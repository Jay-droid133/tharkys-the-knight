1186+ 6632 C9           SFX_TownGate_OnFingerIn:        RET
1187+ 6633 C9           SFX_TownGate_OnShake:           RET
1188+ 6634 C9           SFX_TownGate_OnFingerPulse:     RET
1189+ 6635 C9           SFX_TownGate_OnFingerOut:       RET
1190+ 6636 C9           SFX_TownGate_OnArmOut:          RET
1191+ 6637 C9           SFX_TownGate_OnPlayerTurn:      RET
1192+ 6638 C9           SFX_TownGate_OnPlayerFramed:    RET
1193+ 6639 C9           SFX_TownGate_OnPlayerExit:      RET
