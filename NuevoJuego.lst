 420+ A04E              ; ==============================================================================
 421+ A04E              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A04E              ; ==============================================================================
 423+ A04E              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A04E              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A04E              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A04E              ; ==============================================================================
 427+ A04E              ProcessEnemies:
 428+ A04E 3E 00            LD A, 0
 429+ A050 32 99 A0         LD (.peCount), A
 430+ A053 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A055
 432+ A055              .peLoop:
 433+ A055 C5               PUSH BC
 434+ A056
 435+ A056                  ; Calcular IX desde EnemyStepIdx
 436+ A056 3A FB 82         LD A, (EnemyStepIdx)
 437+ A059 C6 01            ADD A, SLOT_MONSTER0
 438+ A05B 6F               LD L, A
 439+ A05C 26 00            LD H, 0
 440+ A05E 29               ADD HL, HL
 441+ A05F 29               ADD HL, HL
 442+ A060 29               ADD HL, HL
 443+ A061 29               ADD HL, HL                          ; × ENT_SIZE (16)
 444+ A062 11 94 81         LD DE, EntityTable
 445+ A065 19               ADD HL, DE
 446+ A066 E5               PUSH HL
 447+ A067 DD E1            POP IX
 448+ A069
 449+ A069                  ; Avanzar indice round-robin
 450+ A069 3A FB 82         LD A, (EnemyStepIdx)
 451+ A06C 3C               INC A
 452+ A06D FE 09            CP NUM_MONSTERS + NUM_NASTIES
 453+ A06F 38 01            JR C, .peNoWrap
 454+ A071 AF               XOR A
 455+ A072              .peNoWrap:
 456+ A072 32 FB 82         LD (EnemyStepIdx), A
 457+ A075
 458+ A075                  ; Slot activo?
 459+ A075 DD 7E 01         LD A, (IX+ENT_TYPE)
 460+ A078 B7               OR A
 461+ A079 28 16            JR Z, .peSkip
 462+ A07B
 463+ A07B                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 464+ A07B DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 465+ A07F F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 466+ A080
 467+ A080                  ; Procesar esta entidad completa (erase + logic + draw)
 468+ A080 CD 9A A0         CALL ProcessOneEnemy
 469+ A083
 470+ A083                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 471+ A083 F1               POP AF
 472+ A084 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 473+ A086
 474+ A086                  ; Budget check
 475+ A086 3A 99 A0         LD A, (.peCount)
 476+ A089 3C               INC A
 477+ A08A 32 99 A0         LD (.peCount), A
 478+ A08D FE 02            CP MAX_ENEMIES_PER_FRAME
 479+ A08F 30 06            JR NC, .peDone
 480+ A091
 481+ A091              .peSkip:
 482+ A091 C1               POP BC
 483+ A092 05               DEC B
 484+ A093 C2 55 A0         JP NZ, .peLoop
 485+ A096 C9               RET
 486+ A097
 487+ A097              .peDone:
 488+ A097 C1               POP BC
 489+ A098 C9               RET
 490+ A099
 491+ A099 00           .peCount: DEFB 0
 492+ A09A
 493+ A09A              ; ==============================================================================
 494+ A09A              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 495+ A09A              ; ==============================================================================
 496+ A09A              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 497+ A09A              ; ==============================================================================
 498+ A09A              ProcessOneEnemy:
 499+ A09A                  ; --- Frozen monster gate (durante muerte del player) ---
 500+ A09A                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 501+ A09A                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 502+ A09A                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 503+ A09A 3A E9 82         LD A, (MonstersFrozen)
 504+ A09D B7               OR A
 505+ A09E 28 08            JR Z, .peDispatch
 506+ A0A0 DD 7E 01         LD A, (IX+ENT_TYPE)
 507+ A0A3 FE 02            CP TYPE_MONSTER
 508+ A0A5 CA 0D A1         JP Z, .peCalcAndDraw
 509+ A0A8              .peDispatch:
 510+ A0A8                  ; --- Dispatch segun estado ---
 511+ A0A8 DD 7E 02         LD A, (IX+ENT_STATE)
 512+ A0AB FE 03            CP STATE_DYING
 513+ A0AD CA 1F A3         JP Z, .peDying
 514+ A0B0 FE 04            CP STATE_SPAWNING
 515+ A0B2 CA D4 A3         JP Z, .peSpawning
 516+ A0B5 FE 05            CP STATE_SCARED
 517+ A0B7 CA FC A1         JP Z, .peScared
 518+ A0BA FE 06            CP STATE_ATTACKING
 519+ A0BC CA EF A1         JP Z, .peAttacking
 520+ A0BF
 521+ A0BF                  ; === STATE_RUNNING ===
 522+ A0BF                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 523+ A0BF 3A E7 B5         LD A, (ScareTimer)
 524+ A0C2 B7               OR A
 525+ A0C3 28 1E            JR Z, .peRunning
 526+ A0C5 DD 7E 01         LD A, (IX+ENT_TYPE)
 527+ A0C8 FE 03            CP TYPE_NASTY
 528+ A0CA 28 08            JR Z, .peDoScare
 529+ A0CC FE 02            CP TYPE_MONSTER
 530+ A0CE 20 13            JR NZ, .peRunning
 531+ A0D0                  ; Monster: limpiar stun antes de asustar
 532+ A0D0 DD 36 0A 00      LD (IX+ENT_DIR), 0
 533+ A0D4              .peDoScare:
 534+ A0D4 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 535+ A0D8 DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 536+ A0DC DD 36 07 00      LD (IX+ENT_DELTAY), 0
 537+ A0E0 C3 FC A1         JP .peScared
 538+ A0E3              .peRunning:
 539+ A0E3 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 540+ A0E7 C2 93 A1         JP NZ, .peFresh
 541+ A0EA
 542+ A0EA                  ; --- Logica: AI + movimiento + animacion ---
 543+ A0EA DD 7E 01         LD A, (IX+ENT_TYPE)
 544+ A0ED FE 05            CP TYPE_DEATH
 545+ A0EF 28 14            JR Z, .peDeathAI
 546+ A0F1 FE 02            CP TYPE_MONSTER
 547+ A0F3 20 15            JR NZ, .peNormalAI
 548+ A0F5 AF               XOR A
 549+ A0F6 32 50 B3         LD (MonsterKbDespawn), A        ; Reset flag
 550+ A0F9 CD D8 AD         CALL UpdateMonster
 551+ A0FC 3A 50 B3         LD A, (MonsterKbDespawn)
 552+ A0FF B7               OR A
 553+ A100 C2 F7 A2         JP NZ, .peScaredDespawn         ; Knockback offscreen → borrar y despawnear
 554+ A103 18 08            JR .peCalcAndDraw
 555+ A105              .peDeathAI:
 556+ A105 CD EE C4         CALL UpdateDeath
 557+ A108 18 03            JR .peCalcAndDraw
 558+ A10A              .peNormalAI:
 559+ A10A CD 17 AD         CALL UpdateEnemy
 560+ A10D
 561+ A10D                  ; --- Compartido: CalcDraw + skip check + erase + draw + save ---
 562+ A10D              .peCalcAndDraw:
 563+ A10D CD 77 A4         CALL CalcDrawX
 564+ A110 CD 0F 9F         CALL ComputeEnemyDrawY              ; → EnemyDrawY = POSY o POSY+1 (monster+techo)
 565+ A113
 566+ A113                  ; --- Skip si nada cambio ---
 567+ A113 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 568+ A116 DD BE 0C         CP (IX+ENT_OLDX)
 569+ A119 20 0F            JR NZ, .peDoErase
 570+ A11B 3A D6 82         LD A, (EnemyDrawY)
 571+ A11E DD BE 0D         CP (IX+ENT_OLDY)
 572+ A121 20 07            JR NZ, .peDoErase
 573+ A123 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 574+ A126 DD BE 0E         CP (IX+ENT_OLDSPRID)
 575+ A129 C8               RET Z                               ; Nada cambio → skip todo
 576+ A12A
 577+ A12A              .peDoErase:
 578+ A12A                  ; --- Erase viejo ---
 579+ A12A CD ED A4         CALL GetOldSpriteAddr
 580+ A12D DD 7E 0D         LD A, (IX+ENT_OLDY)
 581+ A130 57               LD D, A
 582+ A131 DD 7E 0C         LD A, (IX+ENT_OLDX)
 583+ A134 5F               LD E, A
