 365+ E69F              ; ==============================================================================
 366+ E69F              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 367+ E69F              ; ==============================================================================
 368+ E69F              ; Entrada: A = sprite ID
 369+ E69F              ; Setea BgSpriteIsHouse (0 o 1)
 370+ E69F              ; Preserva: A, DE, IX
 371+ E69F              ;
 372+ E69F              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 373+ E69F              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 374+ E69F              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 375+ E69F              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 376+ E69F              ; ==============================================================================
 377+ E69F              CheckIfHouseSprite:
 378+ E69F F5               PUSH AF
 379+ E6A0 E5               PUSH HL
 380+ E6A1 C5               PUSH BC
 381+ E6A2
 382+ E6A2 47               LD B, A                     ; B = id buscado
 383+ E6A3
 384+ E6A3 AF               XOR A
 385+ E6A4 32 03 E5         LD (BgSpriteIsHouse), A     ; Default: no es house
 386+ E6A7
 387+ E6A7 21 BC E1         LD HL, HouseIdList
 388+ E6AA              .checkLoop:
 389+ E6AA 7E               LD A, (HL)
 390+ E6AB FE FF            CP $FF
 391+ E6AD 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 392+ E6AF B8               CP B
 393+ E6B0 28 03            JR Z, .checkFound
 394+ E6B2 23               INC HL
 395+ E6B3 18 F5            JR .checkLoop
 396+ E6B5
 397+ E6B5              .checkFound:
 398+ E6B5 3E 01            LD A, 1
 399+ E6B7 32 03 E5         LD (BgSpriteIsHouse), A
 400+ E6BA
 401+ E6BA              .checkDone:
 402+ E6BA C1               POP BC
 403+ E6BB E1               POP HL
 404+ E6BC F1               POP AF
 405+ E6BD C9               RET
 406+ E6BE
 407+ E6BE              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 408+ E6BE              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 409+ E6BE              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 410+ E6BE
 411+ E6BE              ; ==============================================================================
 412+ E6BE              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 413+ E6BE              ; ==============================================================================
 414+ E6BE              ; Formato: XX,YY:NN nombre_room     DY
 415+ E6BE              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 416+ E6BE              ; ==============================================================================
 417+ E6BE              DrawRoomInfo:
 418+ E6BE                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 419+ E6BE 1E 00            LD E, 0
 420+ E6C0 06 0D            LD B, 13
 421+ E6C2              .clearLoop:
 422+ E6C2 C5               PUSH BC
 423+ E6C3 D5               PUSH DE
 424+ E6C4 3E 20            LD A, ' '
 425+ E6C6 CD 79 E8         CALL DrawHudChar
 426+ E6C9 D1               POP DE
 427+ E6CA C1               POP BC
 428+ E6CB 1C               INC E
 429+ E6CC 10 F4            DJNZ .clearLoop
 430+ E6CE
 431+ E6CE                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 432+ E6CE 3A AD 82         LD A, (CurrentScreenX)
 433+ E6D1 1E 00            LD E, 0
 434+ E6D3 CD 31 E7         CALL .drawDec2
 435+ E6D6
 436+ E6D6                  ; --- ',' en col 2 ---
 437+ E6D6 3E 2C            LD A, ','
 438+ E6D8 1E 02            LD E, 2
 439+ E6DA CD 79 E8         CALL DrawHudChar
 440+ E6DD
 441+ E6DD                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 442+ E6DD 3A AE 82         LD A, (CurrentScreenY)
 443+ E6E0 1E 03            LD E, 3
 444+ E6E2 CD 31 E7         CALL .drawDec2
 445+ E6E5
 446+ E6E5                  ; --- ':' en col 5 ---
 447+ E6E5 3E 3A            LD A, ':'
 448+ E6E7 1E 05            LD E, 5
 449+ E6E9 CD 79 E8         CALL DrawHudChar
 450+ E6EC
 451+ E6EC                  ; --- Obtener room index de MapTable[Y*16+X] ---
 452+ E6EC 3A AE 82         LD A, (CurrentScreenY)
 453+ E6EF 6F               LD L, A
 454+ E6F0 26 00            LD H, 0
 455+ E6F2 29               ADD HL, HL
 456+ E6F3 29               ADD HL, HL
 457+ E6F4 29               ADD HL, HL
 458+ E6F5 29               ADD HL, HL                  ; HL = Y * 16
 459+ E6F6 3A AD 82         LD A, (CurrentScreenX)
 460+ E6F9 5F               LD E, A
 461+ E6FA 16 00            LD D, 0
 462+ E6FC 19               ADD HL, DE                  ; HL = Y*16 + X
 463+ E6FD 11 27 E0         LD DE, MapTable
 464+ E700 19               ADD HL, DE
 465+ E701 7E               LD A, (HL)                  ; A = room index (0-47)
 466+ E702 F5               PUSH AF                     ; guardar room index
 467+ E703
 468+ E703                  ; --- Room index como 2 hex en cols 6-7 ---
 469+ E703 F5               PUSH AF
 470+ E704 0F               RRCA
 471+ E705 0F               RRCA
 472+ E706 0F               RRCA
 473+ E707 0F               RRCA
 474+ E708 E6 0F            AND $0F
 475+ E70A CD 4F E7         CALL .hexToAscii
 476+ E70D 1E 06            LD E, 6
 477+ E70F CD 79 E8         CALL DrawHudChar
 478+ E712 F1               POP AF
 479+ E713 E6 0F            AND $0F
 480+ E715 CD 4F E7         CALL .hexToAscii
 481+ E718 1E 07            LD E, 7
 482+ E71A CD 79 E8         CALL DrawHudChar
 483+ E71D
 484+ E71D                  ; --- Espacio en col 8 ---
 485+ E71D 3E 20            LD A, ' '
 486+ E71F 1E 08            LD E, 8
 487+ E721 CD 79 E8         CALL DrawHudChar
 488+ E724
 489+ E724                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 490+ E724 F1               POP AF                      ; A = room index (descartar)
 491+ E725
 492+ E725                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 493+ E725 21 20 58         LD HL, ATTR_BASE + 1 * 32
 494+ E728 3E 47            LD A, $47                   ; bright white on black
 495+ E72A 06 0D            LD B, 13
 496+ E72C              .attrLoop:
 497+ E72C 77               LD (HL), A
 498+ E72D 23               INC HL
 499+ E72E 10 FC            DJNZ .attrLoop
 500+ E730 C9               RET
 501+ E731
 502+ E731              ; --- Helpers ---
 503+ E731              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 504+ E731              .drawDec2:
 505+ E731 4B               LD C, E                     ; guardar columna inicial
 506+ E732 06 00            LD B, 0                     ; decenas
 507+ E734              .divLoop:
 508+ E734 FE 0A            CP 10
 509+ E736 38 05            JR C, .divDone
 510+ E738 D6 0A            SUB 10
 511+ E73A 04               INC B
 512+ E73B 18 F7            JR .divLoop
 513+ E73D              .divDone:
 514+ E73D                  ; B = decenas, A = unidades
 515+ E73D F5               PUSH AF                     ; guardar unidades
 516+ E73E 78               LD A, B
 517+ E73F C6 30            ADD A, '0'
 518+ E741 59               LD E, C
 519+ E742 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 520+ E743 CD 79 E8         CALL DrawHudChar
 521+ E746 C1               POP BC                      ; restaurar C
 522+ E747 F1               POP AF
 523+ E748 C6 30            ADD A, '0'
 524+ E74A 59               LD E, C
 525+ E74B 1C               INC E
 526+ E74C C3 79 E8         JP DrawHudChar              ; tail call
 527+ E74F
 528+ E74F              .hexToAscii:
 529+ E74F FE 0A            CP 10
 530+ E751 38 03            JR C, .isDigit
 531+ E753 C6 37            ADD A, 'A' - 10
 532+ E755 C9               RET
 533+ E756              .isDigit:
 534+ E756 C6 30            ADD A, '0'
 535+ E758 C9               RET
