  70+ E28A              ; ==============================================================================
  71+ E28A              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  72+ E28A              ; ==============================================================================
  73+ E28A              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  74+ E28A              ; el AY toca solo durante el decay.
  75+ E28A              ; ==============================================================================
  76+ E28A              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  77+ E28A              ; ==============================================================================
  78+ E28A              ; ==============================================================================
  79+ E28A              ; Variables del decay manual de la campana (con pan estereo)
  80+ E28A              ; ==============================================================================
  81+ E28A              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  82+ E28A              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  83+ E28A              ; Cuando los 3 son 0, la campana esta silenciada.
  84+ E28A 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  85+ E28B 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  86+ E28C 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  87+ E28D 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  88+ E28E
  89+ E28E              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  90+ E28E
  91+ E28E              ; ==============================================================================
  92+ E28E              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  93+ E28E              ; ==============================================================================
  94+ E28E              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  95+ E28E              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  96+ E28E              ; ==============================================================================
  97+ E28E              AY_PlayBellChime:
  98+ E28E                  ; --- Calcular dx (signed) y |dx|, |dy| ---
  99+ E28E 3A C8 81         LD A, (CurrentScreenX)
 100+ E291 D6 08            SUB START_SCREEN_X          ; A = dx (signed: + plaza al oeste, - plaza al este)
 101+ E293 57               LD D, A                     ; D = dx signed (player - plaza)
 102+ E294 30 02            JR NC, .absDxOk
 103+ E296 ED 44            NEG
 104+ E298              .absDxOk:
 105+ E298 47               LD B, A                     ; B = |dx|
 106+ E299
 107+ E299 3A C9 81         LD A, (CurrentScreenY)
 108+ E29C D6 08            SUB START_SCREEN_Y
 109+ E29E 30 02            JR NC, .absDyOk
 110+ E2A0 ED 44            NEG
 111+ E2A2              .absDyOk:
 112+ E2A2 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 113+ E2A3 4F               LD C, A                     ; C = distancia
 114+ E2A4
 115+ E2A4                  ; --- Volumen total = max(15 - dist*2, 1) ---
 116+ E2A4 87               ADD A, A                    ; A = dist * 2
 117+ E2A5 47               LD B, A
 118+ E2A6 3E 0F            LD A, 15
 119+ E2A8 90               SUB B                       ; A = 15 - dist*2
 120+ E2A9 30 02            JR NC, .volTotalOk
 121+ E2AB 3E 01            LD A, 1
 122+ E2AD              .volTotalOk:
 123+ E2AD B7               OR A
 124+ E2AE 20 02            JR NZ, .volTotalSet
 125+ E2B0 3E 01            LD A, 1
 126+ E2B2              .volTotalSet:
 127+ E2B2 47               LD B, A                     ; B = volumen total (1-15)
 128+ E2B3
 129+ E2B3                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 130+ E2B3                  ; D > 0  → player está al ESTE de plaza → plaza al oeste (canal A más fuerte)
 131+ E2B3                  ; D < 0  → player está al OESTE de plaza → plaza al este (canal C más fuerte)
 132+ E2B3                  ; D == 0 → alineado X → canal B
 133+ E2B3 7A               LD A, D
 134+ E2B4 B7               OR A
 135+ E2B5 28 27            JR Z, .panCenter
 136+ E2B7 F2 CC E2         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 137+ E2BA                  ; D < 0: plaza al este → canal C dominante
 138+ E2BA 78               LD A, B                     ; A = vol total
 139+ E2BB 32 8C E2         LD (BellVolR), A            ; canal C = full
 140+ E2BE CB 38            SRL B
 141+ E2C0 78               LD A, B
 142+ E2C1 32 8B E2         LD (BellVolC), A            ; canal B = mitad
 143+ E2C4 CB 38            SRL B
 144+ E2C6 78               LD A, B
 145+ E2C7 32 8A E2         LD (BellVolL), A            ; canal A = cuarto
 146+ E2CA 18 1D            JR .panDone
 147+ E2CC
 148+ E2CC              .panLeft:
 149+ E2CC                  ; D > 0: plaza al oeste → canal A dominante
 150+ E2CC 78               LD A, B
 151+ E2CD 32 8A E2         LD (BellVolL), A
 152+ E2D0 CB 38            SRL B
 153+ E2D2 78               LD A, B
 154+ E2D3 32 8B E2         LD (BellVolC), A
 155+ E2D6 CB 38            SRL B
 156+ E2D8 78               LD A, B
 157+ E2D9 32 8C E2         LD (BellVolR), A
 158+ E2DC 18 0B            JR .panDone
 159+ E2DE
 160+ E2DE              .panCenter:
 161+ E2DE                  ; Alineado: solo canal B
 162+ E2DE 78               LD A, B
 163+ E2DF 32 8B E2         LD (BellVolC), A
 164+ E2E2 AF               XOR A
 165+ E2E3 32 8A E2         LD (BellVolL), A
 166+ E2E6 32 8C E2         LD (BellVolR), A
 167+ E2E9
 168+ E2E9              .panDone:
 169+ E2E9 3E 02            LD A, BELL_DECAY_RATE
 170+ E2EB 32 8D E2         LD (BellDecayTimer), A
 171+ E2EE
 172+ E2EE                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 173+ E2EE 3E 00            LD A, 0                     ; R0: tone A LSB
 174+ E2F0 1E 58            LD E, $58
 175+ E2F2 CD 4C E2         CALL AY_WriteReg
 176+ E2F5 3E 01            LD A, 1                     ; R1: tone A MSB
 177+ E2F7 1E 02            LD E, $02
 178+ E2F9 CD 4C E2         CALL AY_WriteReg
 179+ E2FC 3E 02            LD A, 2                     ; R2: tone B LSB
 180+ E2FE 1E 58            LD E, $58
 181+ E300 CD 4C E2         CALL AY_WriteReg
 182+ E303 3E 03            LD A, 3                     ; R3: tone B MSB
 183+ E305 1E 02            LD E, $02
 184+ E307 CD 4C E2         CALL AY_WriteReg
 185+ E30A 3E 04            LD A, 4                     ; R4: tone C LSB
 186+ E30C 1E 58            LD E, $58
 187+ E30E CD 4C E2         CALL AY_WriteReg
 188+ E311 3E 05            LD A, 5                     ; R5: tone C MSB
 189+ E313 1E 02            LD E, $02
 190+ E315 CD 4C E2         CALL AY_WriteReg
 191+ E318
 192+ E318                  ; --- Mixer: tonos A, B, C activos ---
 193+ E318 3E 07            LD A, 7
 194+ E31A 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 195+ E31C CD 4C E2         CALL AY_WriteReg
 196+ E31F
 197+ E31F                  ; --- Volúmenes iniciales ---
 198+ E31F 3E 08            LD A, 8
 199+ E321 21 8A E2         LD HL, BellVolL
 200+ E324 5E               LD E, (HL)
 201+ E325 CD 4C E2         CALL AY_WriteReg
 202+ E328 3E 09            LD A, 9
 203+ E32A 21 8B E2         LD HL, BellVolC
 204+ E32D 5E               LD E, (HL)
 205+ E32E CD 4C E2         CALL AY_WriteReg
 206+ E331 3E 0A            LD A, 10
 207+ E333 21 8C E2         LD HL, BellVolR
 208+ E336 5E               LD E, (HL)
 209+ E337 CD 4C E2         CALL AY_WriteReg
 210+ E33A
 211+ E33A C9               RET
