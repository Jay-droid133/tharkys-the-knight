 194+ 883A              ; Variables locales de DrawSprite
 195+ 883A 00           .posX:       DEFB 0
 196+ 883B 00           .posY:       DEFB 0
 197+ 883C 00           .widthSave:  DEFB 0
 198+ 883D 00           .heightSave: DEFB 0
 199+ 883E 00           .tablePage:  DEFB 0
 200+ 883F 00           .widthCount: DEFB 0
