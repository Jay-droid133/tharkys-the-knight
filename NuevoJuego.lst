 407+ E4D8 78               LD A, B
 408+ E4D9 E6 0F            AND $0F
 409+ E4DB FE 0F            CP 15
 410+ E4DD 28 03            JR Z, .ccnInvalid
 411+ E4DF 78               LD A, B
