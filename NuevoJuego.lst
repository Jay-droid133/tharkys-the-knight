4951+ BA4D              ; ==============================================================================
4952+ BA4D              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4953+ BA4D              ; ==============================================================================
4954+ BA4D              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4955+ BA4D              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4956+ BA4D              ; ==============================================================================
4957+ BA4D              KillAllActiveNasties:
4958+ BA4D DD 21 0D 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4959+ BA51 06 03            LD B, NUM_NASTIES
4960+ BA53              .kanLoop:
4961+ BA53 C5               PUSH BC
4962+ BA54 DD 7E 01         LD A, (IX+ENT_TYPE)
4963+ BA57 B7               OR A
4964+ BA58 28 26            JR Z, .kanSkip                  ; slot vacio
4965+ BA5A FE 03            CP TYPE_NASTY
4966+ BA5C 20 22            JR NZ, .kanSkip                 ; no es nasty
4967+ BA5E DD 7E 02         LD A, (IX+ENT_STATE)
4968+ BA61 FE 03            CP STATE_DYING
4969+ BA63 28 1B            JR Z, .kanSkip                  ; ya muriendo
4970+ BA65                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4971+ BA65                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4972+ BA65                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4973+ BA65                  ; del nasty: peDying paintea el rect del puff con ese color)
4974+ BA65 CD 89 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4975+ BA68 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4976+ BA6C DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4977+ BA70 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4978+ BA74 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4979+ BA78 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4980+ BA7C DD 36 07 00      LD (IX+ENT_DELTAY), 0
4981+ BA80              .kanSkip:
4982+ BA80 11 10 00         LD DE, ENT_SIZE
4983+ BA83 DD 19            ADD IX, DE
4984+ BA85 C1               POP BC
4985+ BA86 10 CB            DJNZ .kanLoop
4986+ BA88 C9               RET
4987+ BA89
4988+ BA89              ; ==============================================================================
4989+ BA89              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4990+ BA89              ; ==============================================================================
4991+ BA89              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4992+ BA89              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4993+ BA89              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4994+ BA89              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4995+ BA89              ; deja la posicion original (puff puede asomar levemente, raro).
4996+ BA89              ; IN:  IX = nasty entity.
4997+ BA89              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4998+ BA89              ; Destruye: AF, BC, DE, HL.
4999+ BA89              ; ==============================================================================
5000+ BA89              SnapPuffPos:
5001+ BA89 DD 7E 03         LD A, (IX+ENT_POSX)
5002+ BA8C 32 FF BA         LD (.sppOrigX), A
5003+ BA8F E6 F8            AND $F8
5004+ BA91 32 01 BB         LD (.sppBaseX), A                   ; base char-aligned X
5005+ BA94 DD 7E 04         LD A, (IX+ENT_POSY)
5006+ BA97 32 00 BB         LD (.sppOrigY), A
5007+ BA9A E6 F8            AND $F8
5008+ BA9C 32 02 BB         LD (.sppBaseY), A                   ; base char-aligned Y
5009+ BA9F
5010+ BA9F                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
5011+ BA9F CD D3 BA         CALL .sppCheckFit
5012+ BAA2 C8               RET Z
5013+ BAA3
5014+ BAA3                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
5015+ BAA3                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
5016+ BAA3 21 03 BB         LD HL, .sppShifts
5017+ BAA6              .sppLoop:
5018+ BAA6 7E               LD A, (HL)
5019+ BAA7 23               INC HL
5020+ BAA8 47               LD B, A                             ; dx (signed)
5021+ BAA9 7E               LD A, (HL)
5022+ BAAA 23               INC HL
5023+ BAAB FE 80            CP $80
5024+ BAAD 28 17            JR Z, .sppFail                      ; sentinel
5025+ BAAF 4F               LD C, A                             ; dy (signed)
5026+ BAB0
5027+ BAB0 3A 01 BB         LD A, (.sppBaseX)
5028+ BAB3 80               ADD A, B
5029+ BAB4 DD 77 03         LD (IX+ENT_POSX), A
5030+ BAB7 3A 02 BB         LD A, (.sppBaseY)
5031+ BABA 81               ADD A, C
5032+ BABB DD 77 04         LD (IX+ENT_POSY), A
5033+ BABE
5034+ BABE E5               PUSH HL
5035+ BABF CD D3 BA         CALL .sppCheckFit
5036+ BAC2 E1               POP HL
5037+ BAC3 C8               RET Z                               ; encontrado
5038+ BAC4 18 E0            JR .sppLoop
5039+ BAC6
5040+ BAC6              .sppFail:
5041+ BAC6 3A FF BA         LD A, (.sppOrigX)
5042+ BAC9 DD 77 03         LD (IX+ENT_POSX), A
5043+ BACC 3A 00 BB         LD A, (.sppOrigY)
5044+ BACF DD 77 04         LD (IX+ENT_POSY), A
5045+ BAD2 C9               RET
5046+ BAD3
5047+ BAD3              ; --- .sppCheckFit ---
5048+ BAD3              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5049+ BAD3              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5050+ BAD3              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5051+ BAD3              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5052+ BAD3              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5053+ BAD3              .sppCheckFit:
5054+ BAD3                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5055+ BAD3 DD 7E 03         LD A, (IX+ENT_POSX)
5056+ BAD6 FE D1            CP SCREEN_MAX_X - 23
5057+ BAD8 30 21            JR NC, .sppOutOfBounds
5058+ BADA DD 7E 04         LD A, (IX+ENT_POSY)
5059+ BADD FE 10            CP SCREEN_MIN_Y
5060+ BADF 38 1A            JR C, .sppOutOfBounds
5061+ BAE1 FE 91            CP SCREEN_MAX_Y - 23
5062+ BAE3 30 16            JR NC, .sppOutOfBounds
5063+ BAE5                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5064+ BAE5 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5065+ BAE8 32 FE BA         LD (.sppSpritIdSave), A
5066+ BAEB DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5067+ BAEF CD DD B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5068+ BAF2 F5               PUSH AF
5069+ BAF3 3A FE BA         LD A, (.sppSpritIdSave)
5070+ BAF6 DD 77 00         LD (IX+ENT_SPRITEID), A
5071+ BAF9 F1               POP AF
5072+ BAFA C9               RET
5073+ BAFB              .sppOutOfBounds:
5074+ BAFB F6 01            OR 1                                ; NZ
5075+ BAFD C9               RET
5076+ BAFE
5077+ BAFE 00           .sppSpritIdSave: DEFB 0
5078+ BAFF
5079+ BAFF 00           .sppOrigX: DEFB 0
5080+ BB00 00           .sppOrigY: DEFB 0
5081+ BB01 00           .sppBaseX: DEFB 0
5082+ BB02 00           .sppBaseY: DEFB 0
5083+ BB03              .sppShifts:
5084+ BB03                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5085+ BB03                  ; Distancia creciente. Sentinel: dy=$80.
5086+ BB03 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5087+ BB05 00 F8            DEFB 0,   -8                        ; arriba 8
5088+ BB07 00 08            DEFB 0,    8                        ; abajo 8
5089+ BB09 F8 00            DEFB -8,   0                        ; izq 8
5090+ BB0B 08 00            DEFB 8,    0                        ; der 8
5091+ BB0D 00 F0            DEFB 0,  -16                        ; arriba 16
5092+ BB0F 00 10            DEFB 0,   16                        ; abajo 16
5093+ BB11 F8 F8            DEFB -8,  -8
5094+ BB13 08 F8            DEFB 8,   -8
5095+ BB15 F8 08            DEFB -8,   8
5096+ BB17 08 08            DEFB 8,    8
5097+ BB19 00 80            DEFB 0,  $80                        ; sentinel
5098+ BB1B
5099+ BB1B              ; ==============================================================================
5100+ BB1B              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5101+ BB1B              ; ==============================================================================
5102+ BB1B              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5103+ BB1B              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5104+ BB1B              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5105+ BB1B              ; DeathSpawned. No-op si la muerte no esta activa.
5106+ BB1B              ; ==============================================================================
5107+ BB1B              SilentKillDeath:
5108+ BB1B DD 21 4D 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5109+ BB1F DD 7E 01         LD A, (IX+ENT_TYPE)
5110+ BB22 B7               OR A
5111+ BB23 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5112+ BB25 CD 30 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5113+ BB28 AF               XOR A
5114+ BB29 DD 77 01         LD (IX+ENT_TYPE), A
5115+ BB2C 32 FC 82         LD (DeathSpawned), A
5116+ BB2F              .skdResetTimer:
5117+ BB2F                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5118+ BB2F                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5119+ BB2F 21 00 00         LD HL, 0
5120+ BB32 22 F9 82         LD (DeathScreenTimer), HL
5121+ BB35                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5122+ BB35                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5123+ BB35                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5124+ BB35                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5125+ BB35                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5126+ BB35 C9               RET
5127+ BB36
5128+ BB36              ; ==============================================================================
5129+ BB36              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5130+ BB36              ; ==============================================================================
5131+ BB36              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5132+ BB36              ; no DYING ni SPAWNING):
5133+ BB36              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5134+ BB36              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5135+ BB36              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5136+ BB36              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5137+ BB36              ;     Si tampoco, deja el monster donde estaba.
5138+ BB36              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5139+ BB36              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5140+ BB36              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5141+ BB36              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5142+ BB36              ; ==============================================================================
5143+ BB36              FreezeMonstersFacingCorpse:
5144+ BB36                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5145+ BB36 3A A0 81         LD A, (EntityTable + ENT_POSX)
5146+ BB39 32 F3 82         LD (CorpseX), A
5147+ BB3C 3A A1 81         LD A, (EntityTable + ENT_POSY)
5148+ BB3F 32 F4 82         LD (CorpseY), A
5149+ BB42                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5150+ BB42                  ; ya skipea; no aplica aqui pero por simetria)
5151+ BB42 3E 01            LD A, 1
5152+ BB44 32 F2 82         LD (MonstersFrozen), A
5153+ BB47 DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5154+ BB4B 06 06            LD B, NUM_MONSTERS
5155+ BB4D              .fmcLoop:
5156+ BB4D C5               PUSH BC
5157+ BB4E DD 7E 01         LD A, (IX+ENT_TYPE)
5158+ BB51 FE 02            CP TYPE_MONSTER
5159+ BB53 20 0E            JR NZ, .fmcNext
5160+ BB55 DD 7E 02         LD A, (IX+ENT_STATE)
5161+ BB58 FE 03            CP STATE_DYING
5162+ BB5A 28 07            JR Z, .fmcNext
5163+ BB5C FE 04            CP STATE_SPAWNING
5164+ BB5E 28 03            JR Z, .fmcNext
5165+ BB60 CD 6C BB         CALL FreezeOneMonster
5166+ BB63              .fmcNext:
5167+ BB63 C1               POP BC
5168+ BB64 11 10 00         LD DE, ENT_SIZE
5169+ BB67 DD 19            ADD IX, DE
5170+ BB69 10 E2            DJNZ .fmcLoop
5171+ BB6B C9               RET
5172+ BB6C
5173+ BB6C              ; --- FreezeOneMonster ---
5174+ BB6C              ; IX = monster slot pointer.
5175+ BB6C              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5176+ BB6C              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5177+ BB6C              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5178+ BB6C              FreezeOneMonster:
5179+ BB6C                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5180+ BB6C                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5181+ BB6C                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5182+ BB6C DD 7E 03         LD A, (IX+ENT_POSX)
5183+ BB6F 47               LD B, A
5184+ BB70 3A F3 82         LD A, (CorpseX)
5185+ BB73 B8               CP B
5186+ BB74 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5187+ BB76 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5188+ BB78              .fomFaceE:
5189+ BB78 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5190+ BB7B C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5191+ BB7D DD 77 00         LD (IX+ENT_SPRITEID), A
5192+ BB80 18 08            JR .fomFaceDone
5193+ BB82              .fomFaceW:
5194+ BB82 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5195+ BB85 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5196+ BB87 DD 77 00         LD (IX+ENT_SPRITEID), A
5197+ BB8A              .fomFaceDone:
5198+ BB8A
5199+ BB8A                  ; --- 2) Computar |dx| y |dy| ---
5200+ BB8A 3A F3 82         LD A, (CorpseX)
5201+ BB8D 4F               LD C, A
5202+ BB8E DD 7E 03         LD A, (IX+ENT_POSX)
5203+ BB91 91               SUB C                           ; A = posX - corpseX (signed)
5204+ BB92 30 02            JR NC, .fomDxPos
5205+ BB94 ED 44            NEG
5206+ BB96              .fomDxPos:
5207+ BB96 32 E7 BB         LD (.fomAdx), A
5208+ BB99 3A F4 82         LD A, (CorpseY)
5209+ BB9C 4F               LD C, A
5210+ BB9D DD 7E 04         LD A, (IX+ENT_POSY)
5211+ BBA0 91               SUB C
5212+ BBA1 30 02            JR NC, .fomDyPos
5213+ BBA3 ED 44            NEG
5214+ BBA5              .fomDyPos:
5215+ BBA5 32 E8 BB         LD (.fomAdy), A
5216+ BBA8
5217+ BBA8                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5218+ BBA8 3A E7 BB         LD A, (.fomAdx)
5219+ BBAB FE 10            CP 16
5220+ BBAD D2 D6 BB         JP NC, .fomFreeze
5221+ BBB0 3A E8 BB         LD A, (.fomAdy)
5222+ BBB3 FE 10            CP 16
5223+ BBB5 D2 D6 BB         JP NC, .fomFreeze
5224+ BBB8
5225+ BBB8                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5226+ BBB8 3A E7 BB         LD A, (.fomAdx)
5227+ BBBB 47               LD B, A
5228+ BBBC 3A E8 BB         LD A, (.fomAdy)
5229+ BBBF B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5230+ BBC0 38 0C            JR C, .fomTryX
5231+ BBC2 28 0A            JR Z, .fomTryX
5232+ BBC4                  ; |dy| > |dx| -> intentar Y primero
5233+ BBC4 CD 1C BC         CALL TryBackoffY
5234+ BBC7 28 0D            JR Z, .fomFreeze                ; ok
5235+ BBC9 CD E9 BB         CALL TryBackoffX
5236+ BBCC 18 08            JR .fomFreeze
5237+ BBCE              .fomTryX:
5238+ BBCE CD E9 BB         CALL TryBackoffX
5239+ BBD1 28 03            JR Z, .fomFreeze
5240+ BBD3 CD 1C BC         CALL TryBackoffY
5241+ BBD6
5242+ BBD6              .fomFreeze:
5243+ BBD6                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5244+ BBD6                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5245+ BBD6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5246+ BBDA DD 36 07 00      LD (IX+ENT_DELTAY), 0
5247+ BBDE DD 36 0A 00      LD (IX+ENT_DIR), 0
5248+ BBE2 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5249+ BBE6 C9               RET
5250+ BBE7
5251+ BBE7 00           .fomAdx: DEFB 0
5252+ BBE8 00           .fomAdy: DEFB 0
5253+ BBE9
5254+ BBE9              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5255+ BBE9              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5256+ BBE9              TryBackoffX:
5257+ BBE9 DD 7E 03         LD A, (IX+ENT_POSX)
5258+ BBEC 32 1B BC         LD (.tbxSavePos), A
5259+ BBEF 47               LD B, A
5260+ BBF0 3A F3 82         LD A, (CorpseX)
5261+ BBF3 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5262+ BBF4 DD 7E 03         LD A, (IX+ENT_POSX)
5263+ BBF7 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5264+ BBF9 C6 10            ADD A, 16
5265+ BBFB 18 02            JR .tbxApply
5266+ BBFD              .tbxNeg:
5267+ BBFD D6 10            SUB 16
5268+ BBFF              .tbxApply:
5269+ BBFF                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5270+ BBFF DD 77 03         LD (IX+ENT_POSX), A
5271+ BC02 FE E8            CP SCREEN_MAX_X
5272+ BC04 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5273+ BC06 CD DD B6         CALL CheckEnemyCollision
5274+ BC09 20 07            JR NZ, .tbxFail
5275+ BC0B CD 53 BC         CALL CheckMonsterOverlap
5276+ BC0E 20 02            JR NZ, .tbxFail
5277+ BC10 AF               XOR A                           ; Z = ok
5278+ BC11 C9               RET
5279+ BC12              .tbxFail:
5280+ BC12 3A 1B BC         LD A, (.tbxSavePos)
5281+ BC15 DD 77 03         LD (IX+ENT_POSX), A
5282+ BC18 F6 01            OR 1                            ; NZ
5283+ BC1A C9               RET
5284+ BC1B 00           .tbxSavePos: DEFB 0
5285+ BC1C
5286+ BC1C              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5287+ BC1C              TryBackoffY:
5288+ BC1C DD 7E 04         LD A, (IX+ENT_POSY)
5289+ BC1F 32 52 BC         LD (.tbySavePos), A
5290+ BC22 47               LD B, A
5291+ BC23 3A F4 82         LD A, (CorpseY)
5292+ BC26 B8               CP B
5293+ BC27 DD 7E 04         LD A, (IX+ENT_POSY)
5294+ BC2A 30 04            JR NC, .tbyNeg
5295+ BC2C C6 10            ADD A, 16
5296+ BC2E 18 02            JR .tbyApply
5297+ BC30              .tbyNeg:
5298+ BC30 D6 10            SUB 16
5299+ BC32              .tbyApply:
5300+ BC32 DD 77 04         LD (IX+ENT_POSY), A
5301+ BC35 FE 10            CP SCREEN_MIN_Y
5302+ BC37 38 10            JR C, .tbyFail
5303+ BC39 FE A8            CP SCREEN_MAX_Y
5304+ BC3B 30 0C            JR NC, .tbyFail
5305+ BC3D CD DD B6         CALL CheckEnemyCollision
5306+ BC40 20 07            JR NZ, .tbyFail
5307+ BC42 CD 53 BC         CALL CheckMonsterOverlap
5308+ BC45 20 02            JR NZ, .tbyFail
5309+ BC47 AF               XOR A
5310+ BC48 C9               RET
5311+ BC49              .tbyFail:
5312+ BC49 3A 52 BC         LD A, (.tbySavePos)
5313+ BC4C DD 77 04         LD (IX+ENT_POSY), A
5314+ BC4F F6 01            OR 1
5315+ BC51 C9               RET
5316+ BC52 00           .tbySavePos: DEFB 0
5317+ BC53
5318+ BC53              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5319+ BC53              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5320+ BC53              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5321+ BC53              CheckMonsterOverlap:
5322+ BC53 C5               PUSH BC
5323+ BC54 FD E5            PUSH IY
5324+ BC56 FD 21 AD 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5325+ BC5A 06 06            LD B, NUM_MONSTERS
5326+ BC5C              .cmoLoop:
5327+ BC5C                  ; Skip self (IY == IX)
5328+ BC5C DD E5            PUSH IX
5329+ BC5E E1               POP HL
5330+ BC5F FD E5            PUSH IY
5331+ BC61 D1               POP DE
5332+ BC62 B7               OR A
5333+ BC63 ED 52            SBC HL, DE
5334+ BC65 28 3D            JR Z, .cmoNext                  ; same slot
5335+ BC67
5336+ BC67 FD 7E 01         LD A, (IY+ENT_TYPE)
5337+ BC6A FE 02            CP TYPE_MONSTER
5338+ BC6C 20 36            JR NZ, .cmoNext
5339+ BC6E
5340+ BC6E                  ; AABB overlap (rect 16x21 cada uno):
5341+ BC6E                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5342+ BC6E                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5343+ BC6E DD 7E 03         LD A, (IX+ENT_POSX)
5344+ BC71 C6 10            ADD A, 16
5345+ BC73 4F               LD C, A
5346+ BC74 FD 7E 03         LD A, (IY+ENT_POSX)
5347+ BC77 B9               CP C                            ; iy.x cmp ix.x+16
5348+ BC78 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5349+ BC7A FD 7E 03         LD A, (IY+ENT_POSX)
5350+ BC7D C6 10            ADD A, 16
5351+ BC7F 4F               LD C, A
5352+ BC80 DD 7E 03         LD A, (IX+ENT_POSX)
5353+ BC83 B9               CP C
5354+ BC84 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5355+ BC86 DD 7E 04         LD A, (IX+ENT_POSY)
5356+ BC89 C6 15            ADD A, 21
5357+ BC8B 4F               LD C, A
5358+ BC8C FD 7E 04         LD A, (IY+ENT_POSY)
5359+ BC8F B9               CP C
5360+ BC90 30 12            JR NC, .cmoNext
5361+ BC92 FD 7E 04         LD A, (IY+ENT_POSY)
5362+ BC95 C6 15            ADD A, 21
5363+ BC97 4F               LD C, A
5364+ BC98 DD 7E 04         LD A, (IX+ENT_POSY)
5365+ BC9B B9               CP C
5366+ BC9C 30 06            JR NC, .cmoNext
5367+ BC9E                  ; Overlap en ambos ejes
5368+ BC9E FD E1            POP IY
5369+ BCA0 C1               POP BC
5370+ BCA1 F6 01            OR 1                            ; NZ
5371+ BCA3 C9               RET
5372+ BCA4              .cmoNext:
5373+ BCA4 11 10 00         LD DE, ENT_SIZE
5374+ BCA7 FD 19            ADD IY, DE
5375+ BCA9 10 B1            DJNZ .cmoLoop
5376+ BCAB FD E1            POP IY
5377+ BCAD C1               POP BC
5378+ BCAE AF               XOR A                           ; Z = no overlap
5379+ BCAF C9               RET
5380+ BCB0
5381+ BCB0              ; ==============================================================================
5382+ BCB0              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5383+ BCB0              ; ==============================================================================
5384+ BCB0              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5385+ BCB0              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5386+ BCB0              ; ==============================================================================
5387+ BCB0              KillAllActiveMonsters:
5388+ BCB0 AF               XOR A
5389+ BCB1 32 78 B3         LD (MonstersActive), A              ; No respawnear mas
5390+ BCB4 DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5391+ BCB8 06 06            LD B, NUM_MONSTERS
5392+ BCBA              .kamLoop:
5393+ BCBA C5               PUSH BC
5394+ BCBB DD 7E 01         LD A, (IX+ENT_TYPE)
5395+ BCBE B7               OR A
5396+ BCBF 28 27            JR Z, .kamSkip                      ; slot vacio
5397+ BCC1 FE 02            CP TYPE_MONSTER
5398+ BCC3 20 23            JR NZ, .kamSkip                     ; no es monster
5399+ BCC5 DD 7E 02         LD A, (IX+ENT_STATE)
5400+ BCC8 FE 03            CP STATE_DYING
5401+ BCCA 28 1C            JR Z, .kamSkip
5402+ BCCC FE 04            CP STATE_SPAWNING
5403+ BCCE 28 18            JR Z, .kamSkip
5404+ BCD0 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5405+ BCD4 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5406+ BCD8 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5407+ BCDC DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5408+ BCE0 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5409+ BCE4 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5410+ BCE8                  ; ENT_ATTR conservado: puff hereda color del monster
5411+ BCE8              .kamSkip:
5412+ BCE8 11 10 00         LD DE, ENT_SIZE
5413+ BCEB DD 19            ADD IX, DE
5414+ BCED C1               POP BC
5415+ BCEE 10 CA            DJNZ .kamLoop
5416+ BCF0 C9               RET
5417+ BCF1
5418+ BCF1              ; --- Tabla de tipos de nasty (SpriteID base) ---
5419+ BCF1              ; --- Tablas de nasties por momento del dia ---
5420+ BCF1              NUM_NASTY_TYPES EQU 4
5421+ BCF1              DiurnalTypeTable:                       ; DY, C1, A2
5422+ BCF1 30               DEFB SPRID_ENEMY_4          ; Eagle
5423+ BCF2 20               DEFB SPRID_ENEMY_0          ; Spider
5424+ BCF3 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5425+ BCF4 2C               DEFB SPRID_ENEMY_3          ; Snake
5426+ BCF5              CrepuscularTypeTable:                   ; C2, N1
5427+ BCF5 34               DEFB SPRID_ENEMY_5          ; Rat
5428+ BCF6 28               DEFB SPRID_ENEMY_2          ; Bat
5429+ BCF7 24               DEFB SPRID_ENEMY_1          ; Scorpion
5430+ BCF8 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5431+ BCF9
5432+ BCF9              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5433+ BCF9              NastyColorTable:
5434+ BCF9 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5435+ BCFA 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5436+ BCFB 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5437+ BCFC 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5438+ BCFD 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5439+ BCFE 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5440+ BCFF 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5441+ BD00 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5442+ BD01
5443+ BD01              ; --- Tabla de comportamiento depredador ---
5444+ BD01              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5445+ BD01              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5446+ BD01              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5447+ BD01              PredatorTable:
5448+ BD01 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5449+ BD02 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5450+ BD03 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5451+ BD04 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5452+ BD05 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5453+ BD06 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5454+ BD07 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5455+ BD08 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5456+ BD09
5457+ BD09              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5458+ BD09              PredatorSpeedTable:
5459+ BD09 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5460+ BD0A 02               DEFB 2                              ; Ciclo 1: lento
5461+ BD0B 03               DEFB 3                              ; Ciclo 2: intermedio
5462+ BD0C 04               DEFB 4                              ; Ciclo 3+: rapido
5463+ BD0D
5464+ BD0D 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5465+ BD0E
5466+ BD0E F1 BC        CurrentNastyTable: DEFW DiurnalTypeTable
5467+ BD10
5468+ BD10              ; ==============================================================================
5469+ BD10              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5470+ BD10              ; ==============================================================================
5471+ BD10              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5472+ BD10              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5473+ BD10              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5474+ BD10              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5475+ BD10              ;   pantalla, no diurnos.
5476+ BD10              ; ==============================================================================
5477+ BD10              UpdateNastyTable:
5478+ BD10 3A 86 E3         LD A, (CurrentTimeOfDay)
5479+ BD13 FE 02            CP 2
5480+ BD15 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5481+ BD17 FE 06            CP 6
5482+ BD19 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5483+ BD1B 21 F5 BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5484+ BD1E 18 03            JR .setTable
5485+ BD20              .diurnal:
5486+ BD20 21 F1 BC         LD HL, DiurnalTypeTable
5487+ BD23              .setTable:
5488+ BD23 22 0E BD         LD (CurrentNastyTable), HL
5489+ BD26 C9               RET
5490+ BD27
5491+ BD27              ; ==============================================================================
5492+ BD27              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5493+ BD27              ; ==============================================================================
5494+ BD27              ScareAllMonsters:
5495+ BD27 AF               XOR A
5496+ BD28 32 78 B3         LD (MonstersActive), A              ; No respawnear mas
5497+ BD2B                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5498+ BD2B                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5499+ BD2B                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5500+ BD2B 21 95 8D         LD HL, MonsterAiFlags
5501+ BD2E 06 03            LD B, 3
5502+ BD30              .samClearLoop:
5503+ BD30 7E               LD A, (HL)
5504+ BD31 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5505+ BD33 77               LD (HL), A
5506+ BD34 23               INC HL
5507+ BD35 10 F9            DJNZ .samClearLoop
5508+ BD37 3E 7D            LD A, SCARE_TIMER_DAWN
5509+ BD39 32 0E B6         LD (ScareTimer), A
5510+ BD3C                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5511+ BD3C                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5512+ BD3C                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5513+ BD3C                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5514+ BD3C DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5515+ BD40 06 06            LD B, NUM_MONSTERS
5516+ BD42              .samStateLoop:
5517+ BD42 DD 7E 01         LD A, (IX+ENT_TYPE)
5518+ BD45 FE 02            CP TYPE_MONSTER
5519+ BD47 20 1B            JR NZ, .samStateNext
5520+ BD49 DD 7E 02         LD A, (IX+ENT_STATE)
5521+ BD4C FE 03            CP STATE_DYING
5522+ BD4E 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5523+ BD50 FE 04            CP STATE_SPAWNING
5524+ BD52 28 10            JR Z, .samStateNext
5525+ BD54 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5526+ BD58 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5527+ BD5C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5528+ BD60 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5529+ BD64              .samStateNext:
5530+ BD64 11 10 00         LD DE, ENT_SIZE
5531+ BD67 DD 19            ADD IX, DE
5532+ BD69 10 D7            DJNZ .samStateLoop
5533+ BD6B C9               RET
5534+ BD6C
5535+ BD6C              ; ==============================================================================
5536+ BD6C              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5537+ BD6C              ; ==============================================================================
5538+ BD6C              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5539+ BD6C              ; ==============================================================================
5540+ BD6C
5541+ BD6C              ; ==============================================================================
5542+ BD6C              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5543+ BD6C              ; ==============================================================================
5544+ BD6C              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5545+ BD6C              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5546+ BD6C              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5547+ BD6C              ; ==============================================================================
5548+ BD6C              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5549+ BD6C              ; ==============================================================================
5550+ BD6C              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5551+ BD6C              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5552+ BD6C              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5553+ BD6C              ; ==============================================================================
5554+ BD6C              MONSTERS_TO_SPAWN   EQU 3
5555+ BD6C              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5556+ BD6C              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5557+ BD6C
5558+ BD6C              ; ==============================================================================
5559+ BD6C              ; SpawnMonsters - Primera aparicion tras campanadas
5560+ BD6C              ; ==============================================================================
5561+ BD6C              SpawnMonsters:
5562+ BD6C                  IF DEBUG_NO_ENEMIES
5563+ BD6C ~                RET
5564+ BD6C                  ENDIF
5565+ BD6C 3A 78 B3         LD A, (MonstersActive)
5566+ BD6F B7               OR A
5567+ BD70 C0               RET NZ
5568+ BD71                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5569+ BD71                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5570+ BD71 CD 4D BA         CALL KillAllActiveNasties
5571+ BD74 3E 01            LD A, 1
5572+ BD76 32 78 B3         LD (MonstersActive), A
5573+ BD79 CD F6 BD         CALL ShuffleMonsterTypes
5574+ BD7C DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5575+ BD80 06 03            LD B, MONSTERS_TO_SPAWN
5576+ BD82 0E 00            LD C, 0
5577+ BD84              .smLoop:
5578+ BD84 C5               PUSH BC
5579+ BD85 DD 7E 01         LD A, (IX+ENT_TYPE)
5580+ BD88 B7               OR A
5581+ BD89 C2 E5 BD         JP NZ, .smSkip
5582+ BD8C                  ; Asignar tipo y color
5583+ BD8C 79               LD A, C
5584+ BD8D 21 5A BE         LD HL, MonsterTypeTable
5585+ BD90 5F               LD E, A
5586+ BD91 16 00            LD D, 0
5587+ BD93 19               ADD HL, DE
5588+ BD94 7E               LD A, (HL)
5589+ BD95 DD 77 08         LD (IX+ENT_ANIMBASE), A
5590+ BD98 79               LD A, C
5591+ BD99 21 5D BE         LD HL, MonsterColorTable
5592+ BD9C 5F               LD E, A
5593+ BD9D 16 00            LD D, 0
5594+ BD9F 19               ADD HL, DE
5595+ BDA0 7E               LD A, (HL)
5596+ BDA1 DD 77 05         LD (IX+ENT_ATTR), A
5597+ BDA4                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5598+ BDA4 C5               PUSH BC
5599+ BDA5 CD BA 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5600+ BDA8 B7               OR A
5601+ BDA9 20 0E            JR NZ, .smFallbackPos
5602+ BDAB 3A C2 97         LD A, (MaiSpawnX)
5603+ BDAE DD 77 03         LD (IX+ENT_POSX), A
5604+ BDB1 3A C3 97         LD A, (MaiSpawnY)
5605+ BDB4 DD 77 04         LD (IX+ENT_POSY), A
5606+ BDB7 18 0C            JR .smPosDone
5607+ BDB9              .smFallbackPos:
5608+ BDB9 3A 10 83         LD A, (LastEntryPosX)
5609+ BDBC DD 77 03         LD (IX+ENT_POSX), A
5610+ BDBF 3A 11 83         LD A, (LastEntryPosY)
5611+ BDC2 DD 77 04         LD (IX+ENT_POSY), A
5612+ BDC5              .smPosDone:
5613+ BDC5 C1               POP BC
5614+ BDC6                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5615+ BDC6 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5616+ BDCA DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5617+ BDCE DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5618+ BDD2 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5619+ BDD6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5620+ BDDA                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5621+ BDDA                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5622+ BDDA                  ; lo empuje a un vecino (migracion por knockback).
5623+ BDDA CD AF 8E         CALL MaiGetCurrentScreenId
5624+ BDDD 21 89 8D         LD HL, MonsterRoomId
5625+ BDE0 59               LD E, C
5626+ BDE1 16 00            LD D, 0
5627+ BDE3 19               ADD HL, DE
5628+ BDE4 77               LD (HL), A
5629+ BDE5              .smSkip:
5630+ BDE5 11 10 00         LD DE, ENT_SIZE
5631+ BDE8 DD 19            ADD IX, DE
5632+ BDEA C1               POP BC
5633+ BDEB 0C               INC C
5634+ BDEC 05               DEC B
5635+ BDED C2 84 BD         JP NZ, .smLoop
5636+ BDF0 3E 14            LD A, MONSTER_ENTRY_BASE
5637+ BDF2 32 44 BF         LD (TryRespawnMonsters.rmTimer), A
5638+ BDF5                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5639+ BDF5                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5640+ BDF5                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5641+ BDF5 C9               RET
5642+ BDF6
5643+ BDF6              ; --- Barajar tablas tipo/color ---
5644+ BDF6              ShuffleMonsterTypes:
5645+ BDF6 ED 5F            LD A, R
5646+ BDF8 E6 03            AND 3
5647+ BDFA C8               RET Z
5648+ BDFB FE 01            CP 1
5649+ BDFD 28 21            JR Z, .shSwap01
5650+ BDFF FE 02            CP 2
5651+ BE01 28 3A            JR Z, .shSwap12
5652+ BE03 3A 5A BE         LD A, (MonsterTypeTable)
5653+ BE06 57               LD D, A
5654+ BE07 3A 5C BE         LD A, (MonsterTypeTable + 2)
5655+ BE0A 32 5A BE         LD (MonsterTypeTable), A
5656+ BE0D 7A               LD A, D
5657+ BE0E 32 5C BE         LD (MonsterTypeTable + 2), A
5658+ BE11 3A 5D BE         LD A, (MonsterColorTable)
5659+ BE14 57               LD D, A
5660+ BE15 3A 5F BE         LD A, (MonsterColorTable + 2)
5661+ BE18 32 5D BE         LD (MonsterColorTable), A
5662+ BE1B 7A               LD A, D
5663+ BE1C 32 5F BE         LD (MonsterColorTable + 2), A
5664+ BE1F C9               RET
5665+ BE20              .shSwap01:
5666+ BE20 3A 5A BE         LD A, (MonsterTypeTable)
5667+ BE23 57               LD D, A
5668+ BE24 3A 5B BE         LD A, (MonsterTypeTable + 1)
5669+ BE27 32 5A BE         LD (MonsterTypeTable), A
5670+ BE2A 7A               LD A, D
5671+ BE2B 32 5B BE         LD (MonsterTypeTable + 1), A
5672+ BE2E 3A 5D BE         LD A, (MonsterColorTable)
5673+ BE31 57               LD D, A
5674+ BE32 3A 5E BE         LD A, (MonsterColorTable + 1)
5675+ BE35 32 5D BE         LD (MonsterColorTable), A
5676+ BE38 7A               LD A, D
5677+ BE39 32 5E BE         LD (MonsterColorTable + 1), A
5678+ BE3C C9               RET
5679+ BE3D              .shSwap12:
5680+ BE3D 3A 5B BE         LD A, (MonsterTypeTable + 1)
5681+ BE40 57               LD D, A
5682+ BE41 3A 5C BE         LD A, (MonsterTypeTable + 2)
5683+ BE44 32 5B BE         LD (MonsterTypeTable + 1), A
5684+ BE47 7A               LD A, D
5685+ BE48 32 5C BE         LD (MonsterTypeTable + 2), A
5686+ BE4B 3A 5E BE         LD A, (MonsterColorTable + 1)
5687+ BE4E 57               LD D, A
5688+ BE4F 3A 5F BE         LD A, (MonsterColorTable + 2)
5689+ BE52 32 5E BE         LD (MonsterColorTable + 1), A
5690+ BE55 7A               LD A, D
5691+ BE56 32 5F BE         LD (MonsterColorTable + 2), A
5692+ BE59 C9               RET
5693+ BE5A
5694+ BE5A              MonsterTypeTable:
5695+ BE5A 4C               DEFB SPRID_MONSTER_0
5696+ BE5B 54               DEFB SPRID_MONSTER_1
5697+ BE5C 5C               DEFB SPRID_MONSTER_2
5698+ BE5D              MonsterColorTable:
5699+ BE5D 44               DEFB $44                            ; Zombi: verde
5700+ BE5E 46               DEFB $46                            ; Skeleton: amarillo
5701+ BE5F 45               DEFB $45                            ; Ghost: cyan
5702+ BE60
5703+ BE60              ; ==============================================================================
5704+ BE60              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5705+ BE60              ; ==============================================================================
5706+ BE60              TryRespawnMonsters:
5707+ BE60                  IF DEBUG_NO_ENEMIES
5708+ BE60 ~                RET
5709+ BE60                  ENDIF
5710+ BE60 3A 86 E3         LD A, (CurrentTimeOfDay)
5711+ BE63 FE 03            CP 3
5712+ BE65 28 05            JR Z, .rmNight
5713+ BE67 FE 04            CP 4
5714+ BE69 28 01            JR Z, .rmNight
5715+ BE6B C9               RET
5716+ BE6C              .rmNight:
5717+ BE6C 3A 78 B3         LD A, (MonstersActive)
5718+ BE6F B7               OR A
5719+ BE70 C8               RET Z
5720+ BE71 CD 48 BF         CALL .rmUpdateReturnTimers
5721+ BE74 3A 44 BF         LD A, (.rmTimer)
5722+ BE77 B7               OR A
5723+ BE78 28 05            JR Z, .rmCheckSlots
5724+ BE7A 3D               DEC A
5725+ BE7B 32 44 BF         LD (.rmTimer), A
5726+ BE7E C9               RET
5727+ BE7F              .rmCheckSlots:
5728+ BE7F DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5729+ BE83 06 03            LD B, MONSTERS_TO_SPAWN
5730+ BE85 0E 00            LD C, 0
5731+ BE87              .rmLoop:
5732+ BE87 C5               PUSH BC
5733+ BE88 DD 7E 01         LD A, (IX+ENT_TYPE)
5734+ BE8B B7               OR A
5735+ BE8C C2 38 BF         JP NZ, .rmSkip
5736+ BE8F                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5737+ BE8F                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5738+ BE8F                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5739+ BE8F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5740+ BE92 B7               OR A
5741+ BE93 20 09            JR NZ, .rmHasTypeForTrap
5742+ BE95                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5743+ BE95 79               LD A, C
5744+ BE96 21 5A BE         LD HL, MonsterTypeTable
5745+ BE99 5F               LD E, A
5746+ BE9A 16 00            LD D, 0
5747+ BE9C 19               ADD HL, DE
5748+ BE9D 7E               LD A, (HL)
5749+ BE9E              .rmHasTypeForTrap:
5750+ BE9E D6 4C            SUB SPRID_MONSTER_0
5751+ BEA0 CB 3F            SRL A
5752+ BEA2 CB 3F            SRL A
5753+ BEA4 CB 3F            SRL A                               ; A = type idx 0..2
5754+ BEA6 21 45 BF         LD HL, .rmTrapBits
5755+ BEA9 5F               LD E, A
5756+ BEAA 16 00            LD D, 0
5757+ BEAC 19               ADD HL, DE
5758+ BEAD 7E               LD A, (HL)
5759+ BEAE 21 C0 82         LD HL, MonsterTrappedFlags
5760+ BEB1 A6               AND (HL)
5761+ BEB2 C2 38 BF         JP NZ, .rmSkip
5762+ BEB5                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5763+ BEB5                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5764+ BEB5                  ; que el player visite su room.
5765+ BEB5 79               LD A, C
5766+ BEB6 6F               LD L, A
5767+ BEB7 26 00            LD H, 0
5768+ BEB9 11 89 8D         LD DE, MonsterRoomId
5769+ BEBC 19               ADD HL, DE
5770+ BEBD 7E               LD A, (HL)
5771+ BEBE 5F               LD E, A                             ; E = room_id del slot
5772+ BEBF CD AF 8E         CALL MaiGetCurrentScreenId          ; A = current screen_id
5773+ BEC2 BB               CP E
5774+ BEC3 C2 38 BF         JP NZ, .rmSkip                      ; distinto room → skip
5775+ BEC6                  ; === Activar SIN tocar POSX/POSY ===
5776+ BEC6                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5777+ BEC6                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5778+ BEC6                  ;   - RepositionMonstersAtEntry: gap en entry side
5779+ BEC6                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5780+ BEC6 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5781+ BEC9 B7               OR A
5782+ BECA 20 18            JR NZ, .rmHasType
5783+ BECC 79               LD A, C
5784+ BECD 21 5A BE         LD HL, MonsterTypeTable
5785+ BED0 5F               LD E, A
5786+ BED1 16 00            LD D, 0
5787+ BED3 19               ADD HL, DE
5788+ BED4 7E               LD A, (HL)
5789+ BED5 DD 77 08         LD (IX+ENT_ANIMBASE), A
5790+ BED8 79               LD A, C
5791+ BED9 21 5D BE         LD HL, MonsterColorTable
5792+ BEDC 5F               LD E, A
5793+ BEDD 16 00            LD D, 0
5794+ BEDF 19               ADD HL, DE
5795+ BEE0 7E               LD A, (HL)
5796+ BEE1 DD 77 05         LD (IX+ENT_ATTR), A
5797+ BEE4              .rmHasType:
5798+ BEE4 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5799+ BEE7 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5800+ BEEB DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5801+ BEEF                  ; Facing
5802+ BEEF 57               LD D, A
5803+ BEF0 3A A0 81         LD A, (EntityTable + ENT_POSX)
5804+ BEF3 DD BE 03         CP (IX+ENT_POSX)
5805+ BEF6 30 05            JR NC, .rmFaceR
5806+ BEF8 7A               LD A, D
5807+ BEF9 C6 04            ADD A, MONSTER_FRAMES_LEFT
5808+ BEFB 18 01            JR .rmFaceSet
5809+ BEFD              .rmFaceR:
5810+ BEFD 7A               LD A, D
5811+ BEFE              .rmFaceSet:
5812+ BEFE DD 77 00         LD (IX+ENT_SPRITEID), A
5813+ BF01 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5814+ BF05 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5815+ BF09 DD 36 0A 00      LD (IX+ENT_DIR), 0
5816+ BF0D DD 36 06 00      LD (IX+ENT_DELTAX), 0
5817+ BF11 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5818+ BF15 DD 7E 03         LD A, (IX+ENT_POSX)
5819+ BF18 DD 77 0C         LD (IX+ENT_OLDX), A
5820+ BF1B DD 77 0F         LD (IX+ENT_DRAWX), A
5821+ BF1E DD 7E 04         LD A, (IX+ENT_POSY)
5822+ BF21 DD 77 0D         LD (IX+ENT_OLDY), A
5823+ BF24 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5824+ BF27 DD 77 0E         LD (IX+ENT_OLDSPRID), A
5825+ BF2A                  ; Solo UNO por frame
5826+ BF2A C1               POP BC
5827+ BF2B 3E 14            LD A, MONSTER_ENTRY_GAP
5828+ BF2D 32 44 BF         LD (.rmTimer), A
5829+ BF30                  ; Arrancar MonstersMusic la PRIMERA vez que un monster aparece visible.
5830+ BF30                  ; Step=$FF (sentinel inactivo) -> aun no ha sonado nunca esta noche.
5831+ BF30                  ; Tras StartMonstersMusic, Step=0 -> no re-arranca en respawns posteriores.
5832+ BF30                  ; StopMonstersMusic en sunrise restaura Step=$FF para la siguiente noche.
5833+ BF30 3A 85 FB         LD A, (MonstersMusicStep)
5834+ BF33 3C               INC A
5835+ BF34 C0               RET NZ                              ; Step != $FF -> ya arranco, salir
5836+ BF35 C3 47 FB         JP StartMonstersMusic               ; tail-call: arranca el secuencer
5837+ BF38              .rmSkip:
5838+ BF38 11 10 00         LD DE, ENT_SIZE
5839+ BF3B DD 19            ADD IX, DE
5840+ BF3D C1               POP BC
5841+ BF3E 0C               INC C
5842+ BF3F 05               DEC B
5843+ BF40 C2 87 BE         JP NZ, .rmLoop
5844+ BF43 C9               RET
5845+ BF44
5846+ BF44 00           .rmTimer: DEFB 0
5847+ BF45 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5848+ BF48
5849+ BF48              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5850+ BF48              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5851+ BF48              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5852+ BF48              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5853+ BF48              ; empujado).
5854+ BF48              .rmUpdateReturnTimers:
5855+ BF48 21 79 B3         LD HL, MonsterReturnTimer
5856+ BF4B DD 21 AD 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5857+ BF4F 06 03            LD B, MONSTERS_TO_SPAWN
5858+ BF51              .rmRtLoop:
5859+ BF51 7E               LD A, (HL)
5860+ BF52 B7               OR A
5861+ BF53 CA 28 C0         JP Z, .rmRtNext
5862+ BF56 3D               DEC A
5863+ BF57 77               LD (HL), A
5864+ BF58 C2 28 C0         JP NZ, .rmRtNext
5865+ BF5B                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5866+ BF5B                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5867+ BF5B                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5868+ BF5B                  ; Calcular target coord: axis variable segun borde de salida.
5869+ BF5B                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5870+ BF5B DD 7E 0A         LD A, (IX+ENT_DIR)
5871+ BF5E FE 01            CP DIR_N
5872+ BF60 28 11            JR Z, .rmRtSideN
5873+ BF62 FE 02            CP DIR_S
5874+ BF64 28 1C            JR Z, .rmRtSideS
5875+ BF66 FE 04            CP DIR_E
5876+ BF68 CA A2 BF         JP Z, .rmRtSideE
5877+ BF6B FE 08            CP DIR_W
5878+ BF6D CA 91 BF         JP Z, .rmRtSideW
5879+ BF70 C3 FF BF         JP .rmRtFallback
5880+ BF73              .rmRtSideN:
5881+ BF73                  ; target coord = cx = POSX / 8
5882+ BF73 DD 7E 03         LD A, (IX+ENT_POSX)
5883+ BF76 0F               RRCA
5884+ BF77 0F               RRCA
5885+ BF78 0F               RRCA
5886+ BF79 E6 1F            AND $1F
5887+ BF7B 32 C1 97         LD (MaiGapTargetCoord), A
5888+ BF7E 3E 00            LD A, MAI_SIDE_N
5889+ BF80 18 2F            JR .rmRtPickGap
5890+ BF82              .rmRtSideS:
5891+ BF82 DD 7E 03         LD A, (IX+ENT_POSX)
5892+ BF85 0F               RRCA
5893+ BF86 0F               RRCA
5894+ BF87 0F               RRCA
5895+ BF88 E6 1F            AND $1F
5896+ BF8A 32 C1 97         LD (MaiGapTargetCoord), A
5897+ BF8D 3E 01            LD A, MAI_SIDE_S
5898+ BF8F 18 20            JR .rmRtPickGap
5899+ BF91              .rmRtSideW:
5900+ BF91                  ; target coord = cy = (POSY - 16) / 8
5901+ BF91 DD 7E 04         LD A, (IX+ENT_POSY)
5902+ BF94 D6 10            SUB SCREEN_MIN_Y
5903+ BF96 0F               RRCA
5904+ BF97 0F               RRCA
5905+ BF98 0F               RRCA
5906+ BF99 E6 1F            AND $1F
5907+ BF9B 32 C1 97         LD (MaiGapTargetCoord), A
5908+ BF9E 3E 02            LD A, MAI_SIDE_W
5909+ BFA0 18 0F            JR .rmRtPickGap
5910+ BFA2              .rmRtSideE:
5911+ BFA2 DD 7E 04         LD A, (IX+ENT_POSY)
5912+ BFA5 D6 10            SUB SCREEN_MIN_Y
5913+ BFA7 0F               RRCA
5914+ BFA8 0F               RRCA
5915+ BFA9 0F               RRCA
5916+ BFAA E6 1F            AND $1F
5917+ BFAC 32 C1 97         LD (MaiGapTargetCoord), A
5918+ BFAF 3E 03            LD A, MAI_SIDE_E
5919+ BFB1              .rmRtPickGap:
5920+ BFB1                  ; MaiPickNearestGapOnSide destruye HL y BC (paginacion bank 6, loops
5921+ BFB1                  ; internos). Preservamos HL (ptr a MonsterReturnTimer[slot]) y B
5922+ BFB1                  ; (contador del outer loop) para que .rmRtNext pueda iterar bien.
5923+ BFB1 E5               PUSH HL
5924+ BFB2 C5               PUSH BC
5925+ BFB3 CD 69 91         CALL MaiPickNearestGapOnSide        ; elige gap del side mas cercano al target
5926+ BFB6 C1               POP BC
5927+ BFB7 E1               POP HL
5928+ BFB8 B7               OR A
5929+ BFB9 C2 FF BF         JP NZ, .rmRtFallback
5930+ BFBC                  ; Ajustar MaiSpawnX/Y con MAI_REENTRY_OFFSET hacia dentro. MaiPickRandomGapOnSide
5931+ BFBC                  ; usa MAI_ENTRY_OFFSET (=0) y deja el spawn al borde; aqui lo empujamos 2 chars.
5932+ BFBC 3A BD 97         LD A, (MaiGapSide)
5933+ BFBF FE 00            CP MAI_SIDE_N
5934+ BFC1 28 12            JR Z, .rmRtAdjN
5935+ BFC3 FE 01            CP MAI_SIDE_S
5936+ BFC5 28 18            JR Z, .rmRtAdjS
5937+ BFC7 FE 02            CP MAI_SIDE_W
5938+ BFC9 28 1E            JR Z, .rmRtAdjW
5939+ BFCB                  ; side E
5940+ BFCB 3A C2 97         LD A, (MaiSpawnX)
5941+ BFCE D6 10            SUB MAI_REENTRY_OFFSET
5942+ BFD0 32 C2 97         LD (MaiSpawnX), A
5943+ BFD3 18 1C            JR .rmRtApplyGap
5944+ BFD5              .rmRtAdjN:
5945+ BFD5 3A C3 97         LD A, (MaiSpawnY)
5946+ BFD8 C6 10            ADD A, MAI_REENTRY_OFFSET
5947+ BFDA 32 C3 97         LD (MaiSpawnY), A
5948+ BFDD 18 12            JR .rmRtApplyGap
5949+ BFDF              .rmRtAdjS:
5950+ BFDF 3A C3 97         LD A, (MaiSpawnY)
5951+ BFE2 D6 10            SUB MAI_REENTRY_OFFSET
5952+ BFE4 32 C3 97         LD (MaiSpawnY), A
5953+ BFE7 18 08            JR .rmRtApplyGap
5954+ BFE9              .rmRtAdjW:
5955+ BFE9 3A C2 97         LD A, (MaiSpawnX)
5956+ BFEC C6 10            ADD A, MAI_REENTRY_OFFSET
5957+ BFEE 32 C2 97         LD (MaiSpawnX), A
5958+ BFF1              .rmRtApplyGap:
5959+ BFF1 3A C2 97         LD A, (MaiSpawnX)
5960+ BFF4 DD 77 03         LD (IX+ENT_POSX), A
5961+ BFF7 3A C3 97         LD A, (MaiSpawnY)
5962+ BFFA DD 77 04         LD (IX+ENT_POSY), A
5963+ BFFD 18 0C            JR .rmRtReturnDone
5964+ BFFF              .rmRtFallback:
