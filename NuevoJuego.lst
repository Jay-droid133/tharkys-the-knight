 185+ EFF0              ; ==============================================================================
 186+ EFF0              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->7->0 (debug)
 187+ EFF0              ; ==============================================================================
 188+ EFF0              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 189+ EFF0              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 190+ EFF0              ; inmediato del valor actual.
 191+ EFF0              ;
 192+ EFF0              ; Rango: 1..6 son keys clasicas (forest/ruins/cemetery/clock/church/towngate),
 193+ EFF0              ; 7 es BankCheck (cheque del banco, slot 7 en KeyLockTable). Util para
 194+ EFF0              ; probar el bump trigger del banco sin tener que completar M7 antes.
 195+ EFF0              ;
 196+ EFF0              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 197+ EFF0              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 198+ EFF0              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 199+ EFF0              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 200+ EFF0              ; ==============================================================================
 201+ EFF0              CheckCurrentKeyCycleKey:
 202+ EFF0 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 203+ EFF2 DB FE            IN A, ($FE)
 204+ EFF4 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 205+ EFF6 20 17            JR NZ, .ckcNotPressed
 206+ EFF8 3A 14 F0         LD A, (CurrentKeyCycleDebounce)
 207+ EFFB B7               OR A
 208+ EFFC C0               RET NZ
 209+ EFFD 3E 01            LD A, 1
 210+ EFFF 32 14 F0         LD (CurrentKeyCycleDebounce), A
 211+ F002 3A B0 82         LD A, (CurrentKey)
 212+ F005 3C               INC A
 213+ F006 FE 08            CP 8
 214+ F008 38 01            JR C, .ckcSet                       ; 1..7 dentro de rango (7 = BankCheck)
 215+ F00A AF               XOR A                               ; 8 -> wrap a 0
 216+ F00B              .ckcSet:
 217+ F00B 32 B0 82         LD (CurrentKey), A
 218+ F00E C9               RET
 219+ F00F              .ckcNotPressed:
 220+ F00F AF               XOR A
 221+ F010 32 14 F0         LD (CurrentKeyCycleDebounce), A
 222+ F013 C9               RET
