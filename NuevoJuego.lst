3407+ A5DF              ; ==============================================================================
3408+ A5DF              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
3409+ A5DF              ; ==============================================================================
3410+ A5DF              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
3411+ A5DF              ; ==============================================================================
3412+ A5DF              SchedulePendingErase:
3413+ A5DF 3A B8 81         LD A, (PendingEraseCount)
3414+ A5E2 FE 03            CP 3
3415+ A5E4 D0               RET NC                              ; Buffer lleno (no deberia pasar)
3416+ A5E5                  ; Calcular posicion en buffer: count × 5
3417+ A5E5 6F               LD L, A
3418+ A5E6 26 00            LD H, 0
3419+ A5E8 29               ADD HL, HL
3420+ A5E9 29               ADD HL, HL
3421+ A5EA 29               ADD HL, HL                          ; count × 8 (simplificado)
3422+ A5EB                  ; Corregir: count × 5 = count × 4 + count
3423+ A5EB 6F               LD L, A
3424+ A5EC 26 00            LD H, 0
3425+ A5EE 54               LD D, H
3426+ A5EF 5D               LD E, L
3427+ A5F0 29               ADD HL, HL
3428+ A5F1 29               ADD HL, HL                          ; count × 4
3429+ A5F2 19               ADD HL, DE                          ; count × 5
3430+ A5F3 11 B9 81         LD DE, PendingEraseSlots
3431+ A5F6 19               ADD HL, DE
3432+ A5F7                  ; Guardar OLDSPRID, OLDX, OLDY + sprite addr
3433+ A5F7 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
3434+ A5FA 77               LD (HL), A
3435+ A5FB 23               INC HL
3436+ A5FC DD 7E 0C         LD A, (IX+ENT_OLDX)
3437+ A5FF 77               LD (HL), A
3438+ A600 23               INC HL
3439+ A601 DD 7E 0D         LD A, (IX+ENT_OLDY)
3440+ A604 77               LD (HL), A
3441+ A605 23               INC HL
3442+ A606                  ; Resolver sprite addr y guardarla
3443+ A606 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
3444+ A609 E5               PUSH HL
3445+ A60A 6F               LD L, A
3446+ A60B 26 00            LD H, 0
3447+ A60D 29               ADD HL, HL
3448+ A60E 11 F8 C6         LD DE, SpriteFrameTable
3449+ A611 19               ADD HL, DE
3450+ A612 5E               LD E, (HL)
3451+ A613 23               INC HL
3452+ A614 56               LD D, (HL)                          ; DE = sprite data addr
3453+ A615 E1               POP HL
3454+ A616 73               LD (HL), E
3455+ A617 23               INC HL
3456+ A618 72               LD (HL), D
3457+ A619                  ; Incrementar counter
3458+ A619 3A B8 81         LD A, (PendingEraseCount)
3459+ A61C 3C               INC A
3460+ A61D 32 B8 81         LD (PendingEraseCount), A
3461+ A620 C9               RET
