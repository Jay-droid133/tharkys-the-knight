 525+ 8FE3                  ; Leer puntero record
 526+ 8FE3 5E               LD E, (HL)
 527+ 8FE4 23               INC HL
 528+ 8FE5 56               LD D, (HL)
 529+ 8FE6 EB               EX DE, HL                       ; HL = record ptr
