 710+ A239 19               ADD HL, DE
 711+ A23A DD 7E 03         LD A, (IX+ENT_POSX)
 712+ A23D 77               LD (HL), A
 713+ A23E 21 9A 5F         LD HL, MonsterShakeOrigY
 714+ A241 19               ADD HL, DE
 715+ A242 DD 7E 04         LD A, (IX+ENT_POSY)
 716+ A245 77               LD (HL), A
 717+ A246 18 4F            JR .peScaredSpriteToggle
 718+ A248              .peShakeActive:
 719+ A248                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 720+ A248 ED 5F            LD A, R
 721+ A24A E6 03            AND 3
 722+ A24C 28 0C            JR Z, .peShakeUp
 723+ A24E 3D               DEC A
 724+ A24F 28 0F            JR Z, .peShakeDown
 725+ A251 3D               DEC A
 726+ A252 28 12            JR Z, .peShakeLeft
 727+ A254                  ; 3: right
 728+ A254 06 01            LD B, 1
 729+ A256 0E 00            LD C, 0
 730+ A258 18 10            JR .peShakeApply
 731+ A25A              .peShakeUp:
 732+ A25A 06 00            LD B, 0
 733+ A25C 0E FF            LD C, -1
 734+ A25E 18 0A            JR .peShakeApply
 735+ A260              .peShakeDown:
 736+ A260 06 00            LD B, 0
 737+ A262 0E 01            LD C, 1
 738+ A264 18 04            JR .peShakeApply
 739+ A266              .peShakeLeft:
 740+ A266 06 FF            LD B, -1
 741+ A268 0E 00            LD C, 0
 742+ A26A              .peShakeApply:
 743+ A26A                  ; new POSX = orig + B, new POSY = orig + C
 744+ A26A 21 97 5F         LD HL, MonsterShakeOrigX
 745+ A26D 19               ADD HL, DE
 746+ A26E 7E               LD A, (HL)
 747+ A26F 80               ADD A, B
 748+ A270 DD 77 03         LD (IX+ENT_POSX), A
 749+ A273 21 9A 5F         LD HL, MonsterShakeOrigY
 750+ A276 19               ADD HL, DE
 751+ A277 7E               LD A, (HL)
 752+ A278 81               ADD A, C
 753+ A279 DD 77 04         LD (IX+ENT_POSY), A
 754+ A27C                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 755+ A27C CD DD B6         CALL CheckEnemyCollision
 756+ A27F 28 16            JR Z, .peScaredSpriteToggle
 757+ A281                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 758+ A281 CD 3B 8F         CALL MaiGetMonsterSlot
 759+ A284 5F               LD E, A
 760+ A285 16 00            LD D, 0
 761+ A287 21 97 5F         LD HL, MonsterShakeOrigX
 762+ A28A 19               ADD HL, DE
 763+ A28B 7E               LD A, (HL)
 764+ A28C DD 77 03         LD (IX+ENT_POSX), A
 765+ A28F 21 9A 5F         LD HL, MonsterShakeOrigY
 766+ A292 19               ADD HL, DE
 767+ A293 7E               LD A, (HL)
 768+ A294 DD 77 04         LD (IX+ENT_POSY), A
