2551+ D9A6 E1               POP HL
2552+ D9A7                  ; Reescribir el ptr de la entry a la versión "open".
2553+ D9A7 3E 2C            LD A, LOW BgGfx_old_church_door_open
2554+ D9A9 77               LD (HL), A
2555+ D9AA 23               INC HL
2556+ D9AB 3E DF            LD A, HIGH BgGfx_old_church_door_open
2557+ D9AD 77               LD (HL), A
2558+ D9AE 2B               DEC HL                          ; HL en ptr_lo otra vez
2559+ D9AF                  ; Cargar el sprite "open" al buffer (bank 3) y dibujarlo + atributos.
2560+ D9AF E5               PUSH HL
2561+ D9B0 C5               PUSH BC
2562+ D9B1 21 2C DF         LD HL, BgGfx_old_church_door_open
2563+ D9B4 3E 03            LD A, 3
2564+ D9B6 CD C2 6C         CALL LoadBgSpriteToBuffer       ; preserva BC
2565+ D9B9 DD 21 F8 86      LD IX, BgSpriteBuffer
2566+ D9BD CD E0 DB         CALL DrawBgSpriteXOR
2567+ D9C0 C1               POP BC
2568+ D9C1 C5               PUSH BC
2569+ D9C2 DD 21 F8 86      LD IX, BgSpriteBuffer
