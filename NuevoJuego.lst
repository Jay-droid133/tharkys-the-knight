 982+ B35E DD 23            INC IX
 983+ B360 10 FC            DJNZ .spRleLitSkip
 984+ B362 18 E8            JR .spRleLoop
 985+ B364              .spRleRun:
 986+ B364                  ; Run: consume (A & $7F)+2 pixeles, saltar 1 byte valor
 987+ B364 E6 7F            AND $7F
 988+ B366 C6 02            ADD A, 2
 989+ B368 5F               LD E, A
 990+ B369 16 00            LD D, 0
 991+ B36B ED 52            SBC HL, DE                  ; HL -= count
 992+ B36D DD 23            INC IX                      ; saltar byte valor
 993+ B36F 18 DB            JR .spRleLoop
