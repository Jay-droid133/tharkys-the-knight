  41+ F045 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ F047 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
