 313+ EBB8
 314+ EBB8              ; ==============================================================================
 315+ EBB8              ; UpdatePlayerColorCyclerBody - cycler de color player segun buffs activos
 316+ EBB8              ; ==============================================================================
 317+ EBB8              ; Llamado desde MainLoop cada frame via thunk slot 1 (UpdatePlayerColorCycler).
 318+ EBB8              ; Lee timers de buffs/debuffs activos (16-bit cada uno), cuenta cuantos hay,
 319+ EBB8              ; cycla entre sus colores cada COLOR_CYCLER_PERIOD frames.
 320+ EBB8              ;
 321+ EBB8              ; Prioridades (en orden):
 322+ EBB8              ;   1. PlayerHitTimer > 0  -> no tocar color (RED damage flash gana)
 323+ EBB8              ;   2. >=1 buff activo     -> cyclar entre sus colores
 324+ EBB8              ;   3. AttackCooldown > 0  -> no tocar color (BLUE sword cooldown persiste)
 325+ EBB8              ;   4. Default             -> escribir WHITE | $40
 326+ EBB8              ;
 327+ EBB8              ; Orden fijo en el ciclo (afecta cual se ve primero): SpeedBuff (RAYO/CARACOL)
 328+ EBB8              ; primero, luego MushroomBuff (SETA). Fase 3/4 anadira ESPADA / ESCUDO / REVERSE.
 329+ EBB8              ;
 330+ EBB8              ; Destruye: AF, BC, DE, HL.
 331+ EBB8              ; ==============================================================================
 332+ EBB8              UpdatePlayerColorCyclerBody:
 333+ EBB8                  ; NOTA: el check de PlayerHitTimer vive en el thunk slot 1, NO aqui.
 334+ EBB8                  ; PlayerHitTimer esta en bank 0 (slot 3) y desde bank 7 body slot 3 = bank 7
 335+ EBB8                  ; -> lectura corrupta. El thunk gates el call antes de paginar.
 336+ EBB8
 337+ EBB8                  ; --- Pass 1: contar timers activos ---
 338+ EBB8 06 00            LD B, 0                                 ; B = count
 339+ EBBA 3A DF 82         LD A, (SpeedBuffTimer)
 340+ EBBD 4F               LD C, A
 341+ EBBE 3A E0 82         LD A, (SpeedBuffTimer+1)
 342+ EBC1 B1               OR C
 343+ EBC2 28 01            JR Z, .upcc_noSpeed
 344+ EBC4 04               INC B
 345+ EBC5              .upcc_noSpeed:
 346+ EBC5 3A E2 82         LD A, (MushroomLockTimer)
 347+ EBC8 4F               LD C, A
 348+ EBC9 3A E3 82         LD A, (MushroomLockTimer+1)
 349+ EBCC B1               OR C
 350+ EBCD 28 01            JR Z, .upcc_noMush
 351+ EBCF 04               INC B
 352+ EBD0              .upcc_noMush:
 353+ EBD0 3A DA 5F         LD A, (EspadaTimer)
 354+ EBD3 4F               LD C, A
 355+ EBD4 3A DB 5F         LD A, (EspadaTimer+1)
 356+ EBD7 B1               OR C
 357+ EBD8 28 01            JR Z, .upcc_noEspada
 358+ EBDA 04               INC B
 359+ EBDB              .upcc_noEspada:
 360+ EBDB 3A DC 5F         LD A, (EscudoTimer)
 361+ EBDE 4F               LD C, A
 362+ EBDF 3A DD 5F         LD A, (EscudoTimer+1)
 363+ EBE2 B1               OR C
 364+ EBE3 28 01            JR Z, .upcc_noEscudo
 365+ EBE5 04               INC B
 366+ EBE6              .upcc_noEscudo:
 367+ EBE6 3A DE 5F         LD A, (ReverseTimer)
 368+ EBE9 4F               LD C, A
 369+ EBEA 3A DF 5F         LD A, (ReverseTimer+1)
 370+ EBED B1               OR C
 371+ EBEE 28 01            JR Z, .upcc_noReverse
 372+ EBF0 04               INC B
 373+ EBF1              .upcc_noReverse:
 374+ EBF1
 375+ EBF1 78               LD A, B
 376+ EBF2 B7               OR A
 377+ EBF3 20 12            JR NZ, .upcc_haveBuffs
 378+ EBF5
 379+ EBF5                  ; --- Sin buffs. Prioridad 3: cooldown de espada = MAGENTA bright ---
 380+ EBF5 3A 85 B3         LD A, (AttackCooldown)
 381+ EBF8 B7               OR A
 382+ EBF9 28 06            JR Z, .upcc_default
 383+ EBFB 3E 43            LD A, MAGENTA | $40                     ; $43 magenta bright (cooldown)
 384+ EBFD 32 A8 81         LD (EntityTable + ENT_ATTR), A
 385+ EC00 C9               RET
 386+ EC01
 387+ EC01              .upcc_default:
 388+ EC01                  ; --- Default: WHITE | $40 ---
 389+ EC01 3E 47            LD A, WHITE | $40
 390+ EC03 32 A8 81         LD (EntityTable + ENT_ATTR), A
 391+ EC06 C9               RET
 392+ EC07
 393+ EC07              .upcc_haveBuffs:
 394+ EC07                  ; --- Increment frame counter (wrap natural a 256) ---
 395+ EC07 21 D9 5F         LD HL, PlayerColorCyclerFrame
 396+ EC0A 34               INC (HL)
 397+ EC0B
 398+ EC0B                  ; --- Slot = (frame / COLOR_CYCLER_PERIOD) mod B ---
 399+ EC0B 7E               LD A, (HL)
 400+ EC0C 16 00            LD D, 0                                 ; D = quotient (frame / PERIOD)
 401+ EC0E              .upcc_divLoop:
 402+ EC0E D6 0C            SUB COLOR_CYCLER_PERIOD
 403+ EC10 38 03            JR C, .upcc_divDone
 404+ EC12 14               INC D
 405+ EC13 18 F9            JR .upcc_divLoop
 406+ EC15              .upcc_divDone:
 407+ EC15                  ; D = floor(frame / PERIOD). Mod B:
 408+ EC15 7A               LD A, D
 409+ EC16              .upcc_modLoop:
 410+ EC16 90               SUB B
 411+ EC17 30 FD            JR NC, .upcc_modLoop
 412+ EC19 80               ADD A, B                                ; A = slot (0..B-1)
 413+ EC1A 57               LD D, A                                 ; D = target slot
 414+ EC1B
 415+ EC1B                  ; --- Pass 2: iterar buffs en orden fijo, aplicar color del slot-th ---
 416+ EC1B 0E 00            LD C, 0                                 ; running count
 417+ EC1D
 418+ EC1D                  ; SpeedBuff (RAYO o CARACOL)
 419+ EC1D 3A DF 82         LD A, (SpeedBuffTimer)
