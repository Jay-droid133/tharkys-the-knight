 178+ 9951                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 9951                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 9951 5C               LD E, H                     ; E = period high
 181+ 9952 3E 01            LD A, 1
 182+ 9954 01 FD FF         LD BC, $FFFD
 183+ 9957 ED 79            OUT (C), A
