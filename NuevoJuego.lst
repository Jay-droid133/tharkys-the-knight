6918+ C9E1              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
6919+ C9E1              UpdateDeathTimer:
6920+ C9E1 3A 81 82         LD A, (DeathSpawned)
6921+ C9E4 B7               OR A
6922+ C9E5 C0               RET NZ                              ; ya spawneada: nada que hacer
6923+ C9E6                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
6924+ C9E6                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
6925+ C9E6                  ; arranca de cero al recuperar el control (urb1LastBeat).
6926+ C9E6 3A 6F 82         LD A, (DeathBorderPhase)
6927+ C9E9 B7               OR A
6928+ C9EA C0               RET NZ
6929+ C9EB 3A 73 82         LD A, (PlayerRespawnPhase)
6930+ C9EE FE 01            CP 1
6931+ C9F0 C8               RET Z
6932+ C9F1                  ; Durante la fase de encerrar monsters (MonstersActive=1 y aun no
6933+ C9F1                  ; atrapados los 3) la muerte no aparece, por mucho que tarde. Una vez
6934+ C9F1                  ; atrapados los 3 (MonsterTrappedFlags & $07 == $07) la fase termina y
6935+ C9F1                  ; la muerte vuelve a comportarse normal aunque MonstersActive siga 1.
6936+ C9F1 3A DF B6         LD A, (MonstersActive)
6937+ C9F4 B7               OR A
6938+ C9F5 28 08            JR Z, .udtPhaseDone
6939+ C9F7 3A 58 82         LD A, (MonsterTrappedFlags)
6940+ C9FA E6 07            AND $07
6941+ C9FC FE 07            CP $07
6942+ C9FE C0               RET NZ
6943+ C9FF              .udtPhaseDone:
6944+ C9FF 2A 7F 82         LD HL, (DeathScreenTimer)
6945+ CA02 11 F4 01         LD DE, DEATH_SPAWN_FRAMES
