4502+ A5F4              ; ResetAttrBlock - Limpiar atributos en una posicion (3x2 celdas)
4503+ A5F4              ; ==============================================================================
4504+ A5F4              ; D = pixelY, E = pixelX. Pinta $07 (blanco/negro) en las celdas ocupadas.
4505+ A5F4              ; ==============================================================================
4506+ A5F4              ResetAttrBlock:
4507+ A5F4                  ; Calcular attr address: ATTR_BASE + (Y/8)*32 + (X/8)
4508+ A5F4 7A               LD A, D
4509+ A5F5 0F               RRCA
4510+ A5F6 0F               RRCA
4511+ A5F7 0F               RRCA
4512+ A5F8 E6 1F            AND $1F                             ; charY = Y/8
4513+ A5FA 6F               LD L, A
4514+ A5FB 26 00            LD H, 0
4515+ A5FD 29               ADD HL, HL
4516+ A5FE 29               ADD HL, HL
4517+ A5FF 29               ADD HL, HL
4518+ A600 29               ADD HL, HL
4519+ A601 29               ADD HL, HL                          ; HL = charY * 32
4520+ A602 7B               LD A, E
4521+ A603 0F               RRCA
4522+ A604 0F               RRCA
4523+ A605 0F               RRCA
4524+ A606 E6 1F            AND $1F                             ; charX = X/8
4525+ A608 5F               LD E, A
4526+ A609 16 00            LD D, 0
4527+ A60B 19               ADD HL, DE                          ; HL = charY*32 + charX
4528+ A60C 11 00 58         LD DE, ATTR_BASE
4529+ A60F 19               ADD HL, DE                          ; HL = attribute address
4530+ A610                  ; Pintar 3 columnas × 2 filas con $07
4531+ A610 3E 07            LD A, $07
4532+ A612 77               LD (HL), A
4533+ A613 23               INC HL
4534+ A614 77               LD (HL), A
4535+ A615 23               INC HL
4536+ A616 77               LD (HL), A
4537+ A617 11 1E 00         LD DE, 30                           ; siguiente fila: +32-2
4538+ A61A 19               ADD HL, DE
4539+ A61B 77               LD (HL), A
4540+ A61C 23               INC HL
4541+ A61D 77               LD (HL), A
4542+ A61E 23               INC HL
4543+ A61F 77               LD (HL), A
4544+ A620 C9               RET
