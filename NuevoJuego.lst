 181+ DE4F
 182+ DE4F              ; Posicion de la mano cuando asoma (centrada en el hueco de la puerta)
 183+ DE4F              BCS_HAND_PX_X           EQU 120     ; mismo X que la puerta (16x16 sprite)
 184+ DE4F              BCS_HAND_PX_Y           EQU 48      ; mismo Y que la puerta
 185+ DE4F
 186+ DE4F              ; Posicion (char) donde se dibuja BankKey al final — placeholder
 187+ DE4F              ; (suelo justo delante de la puerta)
 188+ DE4F              BCS_KEY_DROP_CHARX      EQU 15
 189+ DE4F              BCS_KEY_DROP_CHARY      EQU 7
 190+ DE4F
 191+ DE4F              ; Trigger requirements
 192+ DE4F              BCS_REQUIRED_KEY        EQU 7       ; BankCheck (slot 7 en KeyLockTable, NUEVO)
 193+ DE4F
 194+ DE4F              ; ==============================================================================
 195+ DE4F              ; CheckBankTriggerBg - bump-trigger del banco (BG sprite, no en PickupTable)
 196+ DE4F              ; ==============================================================================
 197+ DE4F              ; Llamada cada frame desde MainLoop tras CheckBumpTriggers (gemelo de
 198+ DE4F              ; CheckTownGateTriggerBg). Mismo test AABB ±BCS_DOOR_TOLERANCE.
 199+ DE4F              ;
 200+ DE4F              ; Dispara: BankCutscenePhase==0, CurrentKey==7 (BankCheck), sala (8,8),
 201+ DE4F              ; player AABB (16x21) overlapea rect de la puerta. HIT → StartBankCutscene
 202+ DE4F              ; + CheckMilestoneTrigger(4) (avanza M9).
 203+ DE4F              ; Destruye: AF, BC, DE, HL, IX.
 204+ DE4F              ;
 205+ DE4F              ; NOTA: llamado a traves del thunk CheckBankTriggerBg (slot 1), que pagina
 206+ DE4F              ; bank 7 antes de saltar aqui. Por eso este label es ...Body (el nombre publico
 207+ DE4F              ; sin sufijo lo lleva el thunk).
 208+ DE4F              ; ==============================================================================
 209+ DE4F              CheckBankTriggerBgBody:
 210+ DE4F 3A D1 82         LD A, (BankCutscenePhase)
 211+ DE52 B7               OR A
 212+ DE53 C0               RET NZ                              ; ya en cutscene
 213+ DE54 3A B6 82         LD A, (CurrentKey)
 214+ DE57 FE 07            CP BCS_REQUIRED_KEY
 215+ DE59 C0               RET NZ                              ; sin cheque
 216+ DE5A 3A 10 83         LD A, (CurrentScreenX)
 217+ DE5D FE 08            CP BCS_BANK_ROOM_X
 218+ DE5F C0               RET NZ
 219+ DE60 3A 11 83         LD A, (CurrentScreenY)
 220+ DE63 FE 08            CP BCS_BANK_ROOM_Y
 221+ DE65 C0               RET NZ
 222+ DE66                  ; --- Horizontal AABB ---
 223+ DE66 3A A6 81         LD A, (EntityTable + ENT_POSX)
 224+ DE69 4F               LD C, A                             ; C = player_left
 225+ DE6A C6 10            ADD A, 16
 226+ DE6C 57               LD D, A                             ; D = player_right
 227+ DE6D 3E 78            LD A, BCS_DOOR_PX_LEFT
 228+ DE6F D6 04            SUB BCS_DOOR_TOLERANCE
 229+ DE71 30 01            JR NC, .cbtNoUnderL
 230+ DE73 AF               XOR A
 231+ DE74              .cbtNoUnderL:
 232+ DE74 BA               CP D
 233+ DE75 D0               RET NC
 234+ DE76 3E 87            LD A, BCS_DOOR_PX_RIGHT
 235+ DE78 C6 04            ADD A, BCS_DOOR_TOLERANCE
 236+ DE7A 30 02            JR NC, .cbtNoOverR
 237+ DE7C 3E FF            LD A, $FF
 238+ DE7E              .cbtNoOverR:
 239+ DE7E B9               CP C
 240+ DE7F D8               RET C
 241+ DE80                  ; --- Vertical AABB (player rect 16x21) ---
 242+ DE80 3A A7 81         LD A, (EntityTable + ENT_POSY)
 243+ DE83 4F               LD C, A
 244+ DE84 C6 15            ADD A, 21
 245+ DE86 57               LD D, A
 246+ DE87 3E 30            LD A, BCS_DOOR_PX_TOP
 247+ DE89 D6 04            SUB BCS_DOOR_TOLERANCE
 248+ DE8B 30 01            JR NC, .cbtNoUnderT
 249+ DE8D AF               XOR A
 250+ DE8E              .cbtNoUnderT:
 251+ DE8E BA               CP D
 252+ DE8F D0               RET NC
 253+ DE90 3E 3F            LD A, BCS_DOOR_PX_BOTTOM
 254+ DE92 C6 04            ADD A, BCS_DOOR_TOLERANCE
 255+ DE94 30 02            JR NC, .cbtNoOverB
 256+ DE96 3E FF            LD A, $FF
 257+ DE98              .cbtNoOverB:
 258+ DE98 B9               CP C
 259+ DE99 D8               RET C
 260+ DE9A                  ; HIT
 261+ DE9A CD A2 DE         CALL StartBankCutscene
 262+ DE9D 3E 04            LD A, 4                             ; action 4 = BankDoor
 263+ DE9F C3 CC 6E         JP CheckMilestoneTrigger_B7         ; tail-call al thunk slot 1 (que repagina bank 7 antes de RET)
 264+ DEA2
 265+ DEA2              ; ==============================================================================
 266+ DEA2              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 267+ DEA2              ; ==============================================================================
 268+ DEA2              ; 1. NO consume cheque aqui — se consume despues, en la transicion
 269+ DEA2              ;    HAND_OPEN_IN -> HAND_OPEN_TAKE (la mano abierta "coge" el cheque
 270+ DEA2              ;    visualmente). El bloqueo del re-trigger lo da el check de phase != 0
 271+ DEA2              ;    en CheckBankTriggerBg.
 272+ DEA2              ; 2. Snap player a anchor frente a la puerta, facing N.
 273+ DEA2              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 274+ DEA2              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 275+ DEA2              ;    para limpiar la pantalla durante la cutscene.
 276+ DEA2              ; Destruye: AF, BC, DE, HL, IX.
 277+ DEA2              ; ==============================================================================
 278+ DEA2              StartBankCutscene:
 279+ DEA2 AF               XOR A
 280+ DEA3 32 D4 82         LD (BankCutsceneKnockIdx), A
 281+ DEA6 32 D3 82         LD (BankCutsceneSubState), A
 282+ DEA9 32 D5 82         LD (BankCutsceneNoIdx), A
 283+ DEAC 32 D6 82         LD (BankCutsceneHandFrame), A
 284+ DEAF                  ; Resetea el color del player al default (WHITE | $40 = $47). Si el player
 285+ DEAF                  ; tenia color de un buff (speed, mushroom...) o de un hit (BLUE flash), se
 286+ DEAF                  ; pierde aqui. Sino el player aparece tintado durante toda la cinematica.
 287+ DEAF 3E 47            LD A, WHITE | $40
 288+ DEB1 32 A8 81         LD (EntityTable + ENT_ATTR), A
 289+ DEB4 CD E4 6E         CALL KillAllActiveNasties_B7           ; nasties → STATE_DYING + puff anim
 290+ DEB7 CD EA 6E         CALL KillDeathIfActive_B7               ; muerte (slot 11) → puff y despawn
 291+ DEBA                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 292+ DEBA                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 293+ DEBA                  ; cambiamos el sprite a facing N para preparar.
 294+ DEBA CD 3D DF         CALL BankCutsceneFacingNRedraw
 295+ DEBD CD C5 E2         CALL SFX_Bank_OnStart
 296+ DEC0                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 297+ DEC0                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 298+ DEC0                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 299+ DEC0 3E 64            LD A, BCS_T_PUFF_WAIT
 300+ DEC2 32 D2 82         LD (BankCutsceneTimer), A
 301+ DEC5 3E 11            LD A, BCP_WAIT_NASTIES
 302+ DEC7 32 D1 82         LD (BankCutscenePhase), A
 303+ DECA C9               RET
 304+ DECB
 305+ DECB              ; ==============================================================================
 306+ DECB              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 307+ DECB              ; ==============================================================================
 308+ DECB              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 309+ DECB              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 310+ DECB              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 311+ DECB              BankCutsceneSnapToDoor:
 312+ DECB DD 21 A3 81      LD IX, EntityTable
 313+ DECF DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 314+ DED3 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 315+ DED7 DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 316+ DEDB 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 317+ DEDD 32 E4 82         LD (PlayerDrawY), A
 318+ DEE0 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 319+ DEE2 DD 77 00         LD (IX+ENT_SPRITEID), A
 320+ DEE5 3E 0A            LD A, SPRID_WALK_N
 321+ DEE7 DD 77 08         LD (IX+ENT_ANIMBASE), A
 322+ DEEA AF               XOR A
 323+ DEEB DD 77 09         LD (IX+ENT_ANIMTIMER), A
 324+ DEEE C3 D5 6E         JP TownGateRedrawPlayer_B7
 325+ DEF1
 326+ DEF1              ; ==============================================================================
 327+ DEF1              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 328+ DEF1              ; ==============================================================================
 329+ DEF1              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 330+ DEF1              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 331+ DEF1              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 332+ DEF1              BankCutsceneSnapToRetreat:
 333+ DEF1 DD 21 A3 81      LD IX, EntityTable
 334+ DEF5 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 335+ DEF9 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 336+ DEFD DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 337+ DF01 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 338+ DF03 32 E4 82         LD (PlayerDrawY), A
 339+ DF06 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 340+ DF08 DD 77 00         LD (IX+ENT_SPRITEID), A
 341+ DF0B 3E 0A            LD A, SPRID_WALK_N
 342+ DF0D DD 77 08         LD (IX+ENT_ANIMBASE), A
 343+ DF10 AF               XOR A
 344+ DF11 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 345+ DF14 C3 D5 6E         JP TownGateRedrawPlayer_B7
 346+ DF17
 347+ DF17              ; ==============================================================================
 348+ DF17              ; BankCutsceneSnapToBackOff - teleport player a anchor BACKOFF (centrado + 2 char hueco)
 349+ DF17              ; ==============================================================================
 350+ DF17              ; Llamado al cerrarse la puerta tras el "no no" (.bcPhHandOut). El player baja
 351+ DF17              ; 1 char extra respecto a RETREAT como reaccion al portazo final.
 352+ DF17              ; Mismo X que los demas anchors (centrado con la puerta), Y=80 (door bottom 63,
 353+ DF17              ; 16 px de hueco, top del player en 80). Sigue facing N.
 354+ DF17              BankCutsceneSnapToBackOff:
 355+ DF17 DD 21 A3 81      LD IX, EntityTable
 356+ DF1B DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 357+ DF1F DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 358+ DF23 DD 36 04 50      LD (IX+ENT_POSY), BCS_PLAYER_BACKOFF_Y
 359+ DF27 3E 50            LD A, BCS_PLAYER_BACKOFF_Y
 360+ DF29 32 E4 82         LD (PlayerDrawY), A
 361+ DF2C 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 362+ DF2E DD 77 00         LD (IX+ENT_SPRITEID), A
 363+ DF31 3E 0A            LD A, SPRID_WALK_N
 364+ DF33 DD 77 08         LD (IX+ENT_ANIMBASE), A
 365+ DF36 AF               XOR A
 366+ DF37 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 367+ DF3A C3 D5 6E         JP TownGateRedrawPlayer_B7
 368+ DF3D
 369+ DF3D              ; ==============================================================================
 370+ DF3D              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 371+ DF3D              ; ==============================================================================
 372+ DF3D              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 373+ DF3D              ; para asegurar que el player mira a la puerta antes del primer snap.
 374+ DF3D              BankCutsceneFacingNRedraw:
 375+ DF3D DD 21 A3 81      LD IX, EntityTable
 376+ DF41 DD 7E 04         LD A, (IX+ENT_POSY)
 377+ DF44 32 E4 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 378+ DF47 3E 0B            LD A, SPRID_WALK_N + 1
 379+ DF49 DD 77 00         LD (IX+ENT_SPRITEID), A
 380+ DF4C 3E 0A            LD A, SPRID_WALK_N
 381+ DF4E DD 77 08         LD (IX+ENT_ANIMBASE), A
 382+ DF51 AF               XOR A
 383+ DF52 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 384+ DF55 C3 D5 6E         JP TownGateRedrawPlayer_B7
 385+ DF58
 386+ DF58              ; ==============================================================================
 387+ DF58              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 388+ DF58              ; ==============================================================================
 389+ DF58              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 390+ DF58              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 391+ DF58              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 392+ DF58              ; resuelve KillAllActiveNasties de StartBankCutscene).
 393+ DF58              ; Destruye: AF, BC, DE, HL, IX.
 394+ DF58              ; ==============================================================================
 395+ DF58              UpdateBankCutsceneBody:
 396+ DF58 3A D1 82         LD A, (BankCutscenePhase)
 397+ DF5B FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 398+ DF5D CA B0 DF         JP Z, .bcPhWaitNasties
 399+ DF60 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 400+ DF62 CA BA E1         JP Z, .bcPhDoorClosed
 401+ DF65 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 402+ DF67                                                      ;   clink + consume cheque + erase mano + cierra puerta
 403+ DF67 CA E1 E0         JP Z, .bcPhHandOpenIn
 404+ DF6A FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 405+ DF6C CA 40 E1         JP Z, .bcPhHandOpenOut
 406+ DF6F 3D               DEC A
 407+ DF70 CA CA DF         JP Z, .bcPhLock
 408+ DF73 3D               DEC A
 409+ DF74 CA E8 DF         JP Z, .bcPhKnocks1
 410+ DF77 3D               DEC A
 411+ DF78 CA FD DF         JP Z, .bcPhWait1
 412+ DF7B 3D               DEC A
 413+ DF7C CA 1E E0         JP Z, .bcPhKnocks2
 414+ DF7F 3D               DEC A
 415+ DF80 CA 33 E0         JP Z, .bcPhWait2
 416+ DF83 3D               DEC A
 417+ DF84 CA 55 E0         JP Z, .bcPhTurnToCam
 418+ DF87 3D               DEC A
 419+ DF88 CA 79 E0         JP Z, .bcPhTurnToDoor
 420+ DF8B 3D               DEC A
 421+ DF8C CA 9B E0         JP Z, .bcPhKnocks3
 422+ DF8F 3D               DEC A
 423+ DF90 CA B0 E0         JP Z, .bcPhWait3
 424+ DF93 3D               DEC A
 425+ DF94 CA C2 E0         JP Z, .bcPhPreHand
 426+ DF97 3D               DEC A
 427+ DF98 CA 5F E1         JP Z, .bcPhHandIn
 428+ DF9B 3D               DEC A
 429+ DF9C CA 6E E1         JP Z, .bcPhHandNoNo
 430+ DF9F 3D               DEC A
 431+ DFA0 CA 9F E1         JP Z, .bcPhHandOut
 432+ DFA3 3D               DEC A
 433+ DFA4 CA DA E1         JP Z, .bcPhKeyDrop
 434+ DFA7 3D               DEC A
 435+ DFA8 CA FF E1         JP Z, .bcPhPlayerTurnCam
 436+ DFAB                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 437+ DFAB AF               XOR A
 438+ DFAC 32 D1 82         LD (BankCutscenePhase), A
 439+ DFAF C9               RET
 440+ DFB0
 441+ DFB0              ; ---- Phase 17: WAIT_NASTIES ----
 442+ DFB0              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 443+ DFB0              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 444+ DFB0              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 445+ DFB0              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 446+ DFB0              ;
 447+ DFB0              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 448+ DFB0              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 449+ DFB0              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 450+ DFB0              .bcPhWaitNasties:
 451+ DFB0 CD E4 6E         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 452+ DFB3 CD 21 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 453+ DFB6 28 04            JR Z, .bcWaitNastiesDone
 454+ DFB8 CD BC E2         CALL BankCutsceneDecTimer           ; safety timeout
 455+ DFBB C0               RET NZ
 456+ DFBC              .bcWaitNastiesDone:
 457+ DFBC CD CB DE         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 458+ DFBF 3E 1E            LD A, BCS_T_LOCK
 459+ DFC1 32 D2 82         LD (BankCutsceneTimer), A
 460+ DFC4 3E 01            LD A, BCP_LOCK
 461+ DFC6 32 D1 82         LD (BankCutscenePhase), A
 462+ DFC9 C9               RET
 463+ DFCA
 464+ DFCA              ; ---- Phase 1: lock + facing UP ----
 465+ DFCA              .bcPhLock:
 466+ DFCA CD BC E2         CALL BankCutsceneDecTimer
 467+ DFCD C0               RET NZ
 468+ DFCE                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DFCE AF               XOR A
 470+ DFCF 32 D4 82         LD (BankCutsceneKnockIdx), A
 471+ DFD2 32 D7 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DFD5 3E 00            LD A, BCS_KNOCK_HIT
 473+ DFD7 32 D3 82         LD (BankCutsceneSubState), A
 474+ DFDA 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DFDC 32 D2 82         LD (BankCutsceneTimer), A
 476+ DFDF CD 44 E2         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DFE2 3E 02            LD A, BCP_KNOCKS_1
 478+ DFE4 32 D1 82         LD (BankCutscenePhase), A
 479+ DFE7 C9               RET
 480+ DFE8
 481+ DFE8              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 482+ DFE8              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 483+ DFE8              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 484+ DFE8              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 485+ DFE8              .bcPhKnocks1:
 486+ DFE8 3E 03            LD A, BCS_GROUP1_KNOCKS
 487+ DFEA CD 09 E2         CALL BankCutsceneTickKnockGroup
 488+ DFED B7               OR A
 489+ DFEE C8               RET Z                               ; sigue
 490+ DFEF                  ; grupo 1 terminado → retirarse a ORIG + wait
 491+ DFEF CD F1 DE         CALL BankCutsceneSnapToRetreat
 492+ DFF2 3E 32            LD A, BCS_T_GROUP_WAIT
 493+ DFF4 32 D2 82         LD (BankCutsceneTimer), A
 494+ DFF7 3E 03            LD A, BCP_WAIT_1
 495+ DFF9 32 D1 82         LD (BankCutscenePhase), A
 496+ DFFC C9               RET
 497+ DFFD
 498+ DFFD              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 499+ DFFD              .bcPhWait1:
 500+ DFFD CD BC E2         CALL BankCutsceneDecTimer
 501+ E000 C0               RET NZ
 502+ E001                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 503+ E001 CD CB DE         CALL BankCutsceneSnapToDoor
 504+ E004 AF               XOR A
 505+ E005 32 D4 82         LD (BankCutsceneKnockIdx), A
 506+ E008 32 D7 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 507+ E00B 3E 00            LD A, BCS_KNOCK_HIT
 508+ E00D 32 D3 82         LD (BankCutsceneSubState), A
 509+ E010 3E 04            LD A, BCS_T_KNOCK_HIT
 510+ E012 32 D2 82         LD (BankCutsceneTimer), A
 511+ E015 CD 44 E2         CALL BankCutsceneEmitKnockHit
 512+ E018 3E 04            LD A, BCP_KNOCKS_2
 513+ E01A 32 D1 82         LD (BankCutscenePhase), A
 514+ E01D C9               RET
 515+ E01E
 516+ E01E              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 517+ E01E              .bcPhKnocks2:
 518+ E01E 3E 03            LD A, BCS_GROUP2_KNOCKS
 519+ E020 CD 09 E2         CALL BankCutsceneTickKnockGroup
 520+ E023 B7               OR A
 521+ E024 C8               RET Z
 522+ E025                  ; grupo 2 terminado → retirarse a ORIG + wait
 523+ E025 CD F1 DE         CALL BankCutsceneSnapToRetreat
 524+ E028 3E 32            LD A, BCS_T_GROUP_WAIT
 525+ E02A 32 D2 82         LD (BankCutsceneTimer), A
 526+ E02D 3E 05            LD A, BCP_WAIT_2
 527+ E02F 32 D1 82         LD (BankCutscenePhase), A
 528+ E032 C9               RET
 529+ E033
 530+ E033              ; ---- Phase 5: WAIT_2 ----
 531+ E033              .bcPhWait2:
 532+ E033 CD BC E2         CALL BankCutsceneDecTimer
 533+ E036 C0               RET NZ
 534+ E037                  ; Player gira a S (cara camara).
 535+ E037 DD 21 A3 81      LD IX, EntityTable
 536+ E03B 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 537+ E03D DD 77 00         LD (IX+ENT_SPRITEID), A
 538+ E040 DD 77 08         LD (IX+ENT_ANIMBASE), A
 539+ E043 AF               XOR A
 540+ E044 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 541+ E047 CD D5 6E         CALL TownGateRedrawPlayer_B7
 542+ E04A 3E 28            LD A, BCS_T_TURN_CAM
 543+ E04C 32 D2 82         LD (BankCutsceneTimer), A
 544+ E04F 3E 06            LD A, BCP_TURN_TO_CAM
 545+ E051 32 D1 82         LD (BankCutscenePhase), A
 546+ E054 C9               RET
 547+ E055
 548+ E055              ; ---- Phase 6: player mirando camara mid-cutscene ----
 549+ E055              .bcPhTurnToCam:
 550+ E055 CD BC E2         CALL BankCutsceneDecTimer
 551+ E058 C0               RET NZ
 552+ E059                  ; Player vuelve a N (cara puerta).
 553+ E059 DD 21 A3 81      LD IX, EntityTable
 554+ E05D 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 555+ E05F DD 77 00         LD (IX+ENT_SPRITEID), A
 556+ E062 3E 0A            LD A, SPRID_WALK_N
 557+ E064 DD 77 08         LD (IX+ENT_ANIMBASE), A
 558+ E067 AF               XOR A
 559+ E068 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 560+ E06B CD D5 6E         CALL TownGateRedrawPlayer_B7
 561+ E06E 3E 0A            LD A, BCS_T_TURN_BACK
 562+ E070 32 D2 82         LD (BankCutsceneTimer), A
 563+ E073 3E 07            LD A, BCP_TURN_TO_DOOR
 564+ E075 32 D1 82         LD (BankCutscenePhase), A
 565+ E078 C9               RET
 566+ E079
 567+ E079              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 568+ E079              .bcPhTurnToDoor:
 569+ E079 CD BC E2         CALL BankCutsceneDecTimer
 570+ E07C C0               RET NZ
 571+ E07D                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 572+ E07D CD CB DE         CALL BankCutsceneSnapToDoor
 573+ E080 AF               XOR A
 574+ E081 32 D4 82         LD (BankCutsceneKnockIdx), A
 575+ E084 3E 01            LD A, 1
 576+ E086 32 D7 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 577+ E089 AF               XOR A
 578+ E08A 32 D3 82         LD (BankCutsceneSubState), A        ; HIT
 579+ E08D 3E 04            LD A, BCS_T_KNOCK_HIT
 580+ E08F 32 D2 82         LD (BankCutsceneTimer), A
 581+ E092 CD 44 E2         CALL BankCutsceneEmitKnockHit
 582+ E095 3E 08            LD A, BCP_KNOCKS_3
 583+ E097 32 D1 82         LD (BankCutscenePhase), A
 584+ E09A C9               RET
 585+ E09B
 586+ E09B              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 587+ E09B              .bcPhKnocks3:
 588+ E09B 3E 06            LD A, BCS_GROUP3_KNOCKS
