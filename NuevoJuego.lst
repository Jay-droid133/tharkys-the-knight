 136+ F0BF              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 137+ F0BF              ; ==============================================================================
 138+ F0BF              CheckMilestoneDebugKey:
 139+ F0BF 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 140+ F0C1 DB FE            IN A, ($FE)
 141+ F0C3 CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 142+ F0C5 20 1D            JR NZ, .cmdkNotPressed
 143+ F0C7 3A E9 F0         LD A, (MilestoneKeyDebounce)
 144+ F0CA B7               OR A
 145+ F0CB C0               RET NZ
 146+ F0CC 3E 01            LD A, 1
 147+ F0CE 32 E9 F0         LD (MilestoneKeyDebounce), A
 148+ F0D1 3A 51 82         LD A, (CurrentObjective)
 149+ F0D4 FE 09            CP 9
 150+ F0D6 D0               RET NC
 151+ F0D7 3C               INC A
