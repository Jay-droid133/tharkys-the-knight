 198+ 9EDE                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ 9EDE 3E 0C            LD A, SPAWN_INTERVAL
 200+ 9EE0 32 F8 82         LD (SpawnTimer), A
 201+ 9EE3 AF               XOR A
 202+ 9EE4 32 05 83         LD (EnemyStepIdx), A
 203+ 9EE7 32 7B 5F         LD (PendingEraseCount), A
 204+ 9EEA C9               RET
