6699+ C8BC              ; --- bfsTryNbr: probar vecino (B=nx, C=ny, A=step_dir). Si valido, encolar
6700+ C8BC              ; y actualizar best. ---
6701+ C8BC              .bfsTryNbr:
6702+ C8BC 32 7A 5F         LD (DBfsTryDir), A
6703+ C8BF 78               LD A, B
6704+ C8C0 32 78 5F         LD (DBfsTryCx), A
6705+ C8C3 79               LD A, C
6706+ C8C4 32 79 5F         LD (DBfsTryCy), A
6707+ C8C7                  ; Bounds: nx <= FFZ_MAX_CX, ny <= FFZ_MAX_CY (sprite cabe sin wrap/HUD)
