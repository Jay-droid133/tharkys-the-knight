 307+ E71F DD 7E 04         LD A, (IX+ENT_POSY)
 308+ E722 32 E4 82         LD (PlayerDrawY), A
 309+ E725 06 0E            LD B, SPRID_WALK_S
 310+ E727 18 22            JR .tgwtaApplyAnim
 311+ E729                  ; --- Fase 2: X (solo si Y ya aligned) ---
 312+ E729              .tgwtaTryX:
 313+ E729 DD 7E 03         LD A, (IX+ENT_POSX)
 314+ E72C FE 78            CP TGCS_WALK_TARGET_X
 315+ E72E CA 6C E7         JP Z, .tgwtaArrived                 ; ambos aligned
 316+ E731 38 0D            JR C, .tgwtaMoveE                   ; cur_X < target → E (X++)
 317+ E733 DD 35 03         DEC (IX+ENT_POSX)
 318+ E736 DD 7E 03         LD A, (IX+ENT_POSX)
 319+ E739 DD 77 0F         LD (IX+ENT_DRAWX), A
 320+ E73C 06 06            LD B, SPRID_WALK_W
