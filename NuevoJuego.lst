# file closed: town_gate_cutscene.asm
  97  66AE
  98  66AE                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
  99  66AE                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 100  66AE                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 101  66AE                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 102  66AE                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 103  66AE                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 66AE              ; ==============================================================================
   2+ 66AE              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 66AE              ; ==============================================================================
   4+ 66AE              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 66AE              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 66AE              ; la cinematica — invisible porque es one-shot.
   7+ 66AE              ;
   8+ 66AE              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 66AE              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 66AE              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 66AE              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 66AE              ; ==============================================================================
  13+ 66AE
  14+ 66AE              ; ==============================================================================
  15+ 66AE              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 66AE              ; ==============================================================================
  17+ 66AE              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 66AE              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 66AE              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 66AE              ; ChurchCutsceneSlot.
  21+ 66AE              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 66AE              ; ==============================================================================
  23+ 66AE              EraseChurchTrappedMonster:
  24+ 66AE 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 66B1 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 66B2 6F               LD L, A
  27+ 66B3 26 00            LD H, 0
  28+ 66B5 29               ADD HL, HL
  29+ 66B6 29               ADD HL, HL
  30+ 66B7 29               ADD HL, HL
  31+ 66B8 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 66B9 11 4B 81         LD DE, EntityTable
  33+ 66BC 19               ADD HL, DE
  34+ 66BD E5               PUSH HL
  35+ 66BE DD E1            POP IX
  36+ 66C0 CD 31 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66C3 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66C6 57               LD D, A
  39+ 66C7 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66CA 5F               LD E, A
  41+ 66CB DD 2A B9 A7      LD IX, (OldSprAddr)
  42+ 66CF C3 32 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 66D2
  44+ 66D2              ; ==============================================================================
  45+ 66D2              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 66D2              ; ==============================================================================
  47+ 66D2              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 66D2              ; - Despawn monster (ENT_TYPE=0).
  49+ 66D2              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 66D2              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 66D2              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 66D2              ; ==============================================================================
  53+ 66D2              ApplyChurchTrapDone:
  54+ 66D2                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 66D2 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 66D5 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 66D6 6F               LD L, A
  58+ 66D7 26 00            LD H, 0
  59+ 66D9 29               ADD HL, HL
  60+ 66DA 29               ADD HL, HL
  61+ 66DB 29               ADD HL, HL
  62+ 66DC 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 66DD 11 4B 81         LD DE, EntityTable
  64+ 66E0 19               ADD HL, DE
  65+ 66E1 E5               PUSH HL
  66+ 66E2 DD E1            POP IX
  67+ 66E4                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 66E4                  ; guardado en TriggerChurchTrap).
  69+ 66E4 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 66E7 21 64 67         LD HL, ChurchTrapBitMask
  71+ 66EA 5F               LD E, A
  72+ 66EB 16 00            LD D, 0
  73+ 66ED 19               ADD HL, DE
  74+ 66EE 7E               LD A, (HL)
  75+ 66EF 21 6D 82         LD HL, MonsterTrappedFlags
  76+ 66F2 B6               OR (HL)
  77+ 66F3 77               LD (HL), A
  78+ 66F4                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 66F4                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 66F4                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 66F4 21 6E 82         LD HL, NextChurchTrapStep
  82+ 66F7 34               INC (HL)
  83+ 66F8                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 66F8                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 66F8                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 66F8                  ; antes de quedarse fija en blanco brillante.
  87+ 66F8 DD E5            PUSH IX
  88+ 66FA CD A6 F4         CALL StartStatueBlink
  89+ 66FD DD E1            POP IX
  90+ 66FF                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 66FF                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 66FF                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 66FF DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 6703 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 6707 DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 670B DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 670F                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 670F                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 670F                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 670F                  ; anteriores del cutscene.)
 101+ 670F                  ; Decidir spawn: 3 atrapados?
 102+ 670F 3A 6D 82         LD A, (MonsterTrappedFlags)
 103+ 6712 E6 07            AND $07
 104+ 6714 FE 07            CP $07
 105+ 6716 28 12            JR Z, .actdAllTrapped
 106+ 6718                  ; <3 atrapados: respawn church_key en AltN
 107+ 6718 3E 01            LD A, 1
 108+ 671A 32 60 82         LD (ChurchKeySpawned), A
 109+ 671D 21 70 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 6720 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6721 CD B5 69         CALL RespawnChurchKeyAtAlt
 112+ 6724                  ; Dibujar surgical en su nueva posicion
 113+ 6724 11 E5 DB         LD DE, BgGfx_church_key
 114+ 6727 C3 4B DA         JP RedrawPickupByPtr
 115+ 672A              .actdAllTrapped:
 116+ 672A                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 672A                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 672A                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 672A                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 672A                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 672A                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 672A AF               XOR A
 123+ 672B 32 63 82         LD (TimeFrozen), A
 124+ 672E 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 6730 32 73 82         LD (PostTrapPauseTimer), A
 126+ 6733 C9               RET
