 179+ 9E9A                  ; Configurar slot 0: Player
 180+ 9E9A DD 21 9E 81      LD IX, EntityTable
 181+ 9E9E DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ 9EA2 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ 9EA6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ 9EAA DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 185+ 9EAE DD 36 04 A0      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ 9EB2 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ 9EB6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ 9EBA DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ 9EBE DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ 9EC2 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EC6 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9ECA DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ 9ECE DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
