 109  E6BB                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ E6BB              ; ==============================================================================
   2+ E6BB              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ E6BB              ; ==============================================================================
   4+ E6BB              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ E6BB              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ E6BB              ;
   7+ E6BB              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ E6BB              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ E6BB              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ E6BB              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ E6BB              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ E6BB              ; ==============================================================================
  13+ E6BB
  14+ E6BB              ; ==============================================================================
  15+ E6BB              ; PlaySFX - Reproduce un efecto de sonido
  16+ E6BB              ; ==============================================================================
  17+ E6BB              ; Entrada: HL = puntero a datos del efecto
  18+ E6BB              ; Modifica: AF, BC, DE, HL
  19+ E6BB              ; ==============================================================================
  20+ E6BB              PlaySFX:
  21+ E6BB F3               DI                          ; Sin interrupciones para audio limpio
  22+ E6BC 3A 79 87         LD A, (CurrentBorderColor)
  23+ E6BF E6 07            AND $07                     ; Solo bits de color del borde
  24+ E6C1 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ E6C2
  26+ E6C2              .nextStep:
  27+ E6C2 7E               LD A, (HL)                  ; Leer duration
  28+ E6C3 B7               OR A
  29+ E6C4 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ E6C6
  31+ E6C6 47               LD B, A                     ; B = duration (bucle externo)
  32+ E6C7 23               INC HL
  33+ E6C8 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ E6C9 23               INC HL
  35+ E6CA 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ E6CB 23               INC HL
  37+ E6CC 7E               LD A, (HL)                  ; A = flags
  38+ E6CD 23               INC HL
  39+ E6CE E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ E6CF CB 47            BIT 0, A
  41+ E6D1 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ E6D3
  43+ E6D3              ; --- Bucle de tono normal ---
  44+ E6D3              .toneLoop:
  45+ E6D3                  ; Semi-periodo HIGH
  46+ E6D3 7B               LD A, E
  47+ E6D4 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ E6D6 D3 FE            OUT ($FE), A
  49+ E6D8 79               LD A, C                     ; A = pitch actual
  50+ E6D9              .toneDelayHi:
  51+ E6D9 3D               DEC A
  52+ E6DA 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ E6DC
  54+ E6DC                  ; Semi-periodo LOW
  55+ E6DC 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ E6DD D3 FE            OUT ($FE), A
  57+ E6DF 79               LD A, C
  58+ E6E0              .toneDelayLo:
  59+ E6E0 3D               DEC A
  60+ E6E1 20 FD            JR NZ, .toneDelayLo
  61+ E6E3
  62+ E6E3                  ; Aplicar pitch sweep
  63+ E6E3 79               LD A, C
  64+ E6E4 82               ADD A, D                    ; pitch += pitchDelta
  65+ E6E5 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ E6E7 FA EF E6         JP M, .toneClamp            ; evitar pitch negativo
  67+ E6EA 4F               LD C, A
  68+ E6EB              .toneAfterClamp:
  69+ E6EB 10 E6            DJNZ .toneLoop
  70+ E6ED 18 30            JR .stepDone
  71+ E6EF
  72+ E6EF              .toneClamp:
  73+ E6EF 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ E6F1 18 F8            JR .toneAfterClamp
  75+ E6F3
  76+ E6F3              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ E6F3              .noiseLoop:
  78+ E6F3                  ; Semi-periodo HIGH con ruido
  79+ E6F3 7B               LD A, E
  80+ E6F4 F6 10            OR $10
  81+ E6F6 D3 FE            OUT ($FE), A
  82+ E6F8 ED 5F            LD A, R                     ; R register como PRNG
  83+ E6FA A9               XOR C                       ; mezclar con pitch base
  84+ E6FB E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ E6FD F6 01            OR $01                      ; minimo 1
  86+ E6FF              .noiseDelayHi:
  87+ E6FF 3D               DEC A
  88+ E700 20 FD            JR NZ, .noiseDelayHi
  89+ E702
  90+ E702                  ; Semi-periodo LOW
  91+ E702 7B               LD A, E
  92+ E703 D3 FE            OUT ($FE), A
  93+ E705 ED 5F            LD A, R
  94+ E707 A9               XOR C
  95+ E708 E6 1F            AND $1F
  96+ E70A F6 01            OR $01
  97+ E70C              .noiseDelayLo:
  98+ E70C 3D               DEC A
  99+ E70D 20 FD            JR NZ, .noiseDelayLo
 100+ E70F
 101+ E70F                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ E70F 79               LD A, C
 103+ E710 82               ADD A, D
 104+ E711 28 08            JR Z, .noiseClamp
 105+ E713 FA 1B E7         JP M, .noiseClamp
 106+ E716 4F               LD C, A
 107+ E717              .noiseAfterClamp:
 108+ E717 10 DA            DJNZ .noiseLoop
 109+ E719 18 04            JR .stepDone
 110+ E71B
 111+ E71B              .noiseClamp:
 112+ E71B 0E 01            LD C, 1
 113+ E71D 18 F8            JR .noiseAfterClamp
 114+ E71F
 115+ E71F              .stepDone:
 116+ E71F E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ E720 18 A0            JR .nextStep
 118+ E722
 119+ E722              .done:
 120+ E722 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ E723 D3 FE            OUT ($FE), A
 122+ E725 FB               EI
 123+ E726 C9               RET
 124+ E727
 125+ E727              ; ==============================================================================
 126+ E727              ; DATOS DE EFECTOS DE SONIDO
 127+ E727              ; ==============================================================================
 128+ E727
 129+ E727              ; --- SFX_Footstep: click suave de paso (~15ms) ---
 130+ E727              ; Golpe bajo muy corto, apenas perceptible pero da ritmo al movimiento
 131+ E727              SFX_Footstep:
 132+ E727 08 28 03 00      DEFB 8, 40, 3, 0            ; tono bajo breve con ligero ascenso
 133+ E72B 05 14 00 01      DEFB 5, 20, 0, 1            ; mini-click de ruido
 134+ E72F 00               DEFB 0                      ; fin
 135+ E730
 136+ E730              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 137+ E730              ; Dos pasos: sweep rapido de agudo a grave
 138+ E730              SFX_Attack:
 139+ E730 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 140+ E734 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 141+ E738 00               DEFB 0                      ; fin
 142+ E739
 143+ E739              ; --- SFX_EnemyDeath: "explosion" con ruido (~100ms) ---
 144+ E739              ; Ruido percusivo seguido de tono descendente
 145+ E739              SFX_EnemyDeath:
 146+ E739 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 147+ E73D 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 148+ E741 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 149+ E745 00               DEFB 0                      ; fin
 150+ E746
 151+ E746              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 152+ E746              ; Tono ascendente rapido seguido de ruido seco
 153+ E746              SFX_PlayerHit:
 154+ E746 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 155+ E74A 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 156+ E74E 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 157+ E752 00               DEFB 0                      ; fin
 158+ E753
 159+ E753              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
 160+ E753              ; Tres tonos escalonados ascendentes
 161+ E753              SFX_ScreenTransition:
 162+ E753 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 163+ E757 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 164+ E75B 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 165+ E75F 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 166+ E763 00               DEFB 0                      ; fin
 167+ E764
 168+ E764              ; --- SFX_EnemySpawn: "pop" ascendente + crackle (~70ms) ---
 169+ E764              ; Tono rapido ascendente y crujido
 170+ E764              SFX_EnemySpawn:
 171+ E764 19 23 FE 00      DEFB 25, 35, -2, 0         ; tono ascendente rapido
 172+ E768 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 173+ E76C 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 174+ E770 00               DEFB 0                      ; fin
 175+ E771
 176+ E771              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 177+ E771              ; Tres escalones ascendentes, tipo recarga
 178+ E771              SFX_WellRecover:
 179+ E771 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 180+ E775 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 181+ E779 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 182+ E77D 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 183+ E781 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
 184+ E785 3C 0C FF 00      DEFB 60, 12, -1, 0         ; sweep ascendente
 185+ E789 28 08 00 00      DEFB 40, 8, 0, 0           ; agudo brillante sostenido
 186+ E78D 00               DEFB 0                      ; fin
 187+ E78E
 188+ E78E              ; --- SFX_Pickup: "ding" ascendente corto al recoger objeto (~50ms) ---
 189+ E78E              SFX_Pickup:
 190+ E78E 28 32 00 00      DEFB 40, 50, 0, 0          ; tono grave largo
 191+ E792 28 23 00 00      DEFB 40, 35, 0, 0          ; tono medio
 192+ E796 28 19 00 00      DEFB 40, 25, 0, 0          ; tono medio-agudo
 193+ E79A 28 12 00 00      DEFB 40, 18, 0, 0          ; tono agudo
 194+ E79E 32 0C FF 00      DEFB 50, 12, -1, 0         ; sweep ascendente final
 195+ E7A2 00               DEFB 0                      ; fin
 196+ E7A3
 197+ E7A3              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 198+ E7A3              ; Tono grave resonante con decay lento, como campana de iglesia
 199+ E7A3              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 200+ E7A3              SFX_BellChime:
 201+ E7A3 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 202+ E7A7 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 203+ E7AB 00               DEFB 0                      ; fin
 204+ E7AC
 205+ E7AC              ; --- Sistema de campanadas con pausa entre ellas ---
 206+ E7AC 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 207+ E7AD 00           BellTimer:      DEFB 0          ; frames hasta la siguiente campanada
 208+ E7AE              BELL_PAUSE      EQU 40          ; frames de pausa entre campanadas (~0.8s a 50fps)
 209+ E7AE
 210+ E7AE              ; ==============================================================================
 211+ E7AE              ; StartBellChimes - Inicia secuencia de 12 campanadas
 212+ E7AE              ; ==============================================================================
 213+ E7AE              StartBellChimes:
 214+ E7AE 3E 0C            LD A, 12
 215+ E7B0 32 AC E7         LD (BellCount), A
 216+ E7B3 3E 01            LD A, 1                     ; sonar la primera inmediatamente
 217+ E7B5 32 AD E7         LD (BellTimer), A
 218+ E7B8 3E FA            LD A, SCARE_TIMER_BELLS
 219+ E7BA 32 78 9E         LD (ScareTimer), A
 220+ E7BD C9               RET
 221+ E7BE
 222+ E7BE              ; ==============================================================================
 223+ E7BE              ; UpdateBellChimes - Llamar cada frame desde el main loop
 224+ E7BE              ; ==============================================================================
 225+ E7BE              UpdateBellChimes:
 226+ E7BE 3A AC E7         LD A, (BellCount)
 227+ E7C1 B7               OR A
 228+ E7C2 C8               RET Z                       ; sin campanadas pendientes
 229+ E7C3
 230+ E7C3 21 AD E7         LD HL, BellTimer
 231+ E7C6 35               DEC (HL)
 232+ E7C7 C0               RET NZ                      ; aun no toca
 233+ E7C8
 234+ E7C8                  ; Sonar una campanada
 235+ E7C8 C5               PUSH BC
 236+ E7C9 D5               PUSH DE
 237+ E7CA 21 A3 E7         LD HL, SFX_BellChime
 238+ E7CD CD BB E6         CALL PlaySFX
 239+ E7D0 D1               POP DE
 240+ E7D1 C1               POP BC
 241+ E7D2
 242+ E7D2                  ; Preparar siguiente
 243+ E7D2 21 AC E7         LD HL, BellCount
 244+ E7D5 35               DEC (HL)
 245+ E7D6 28 06            JR Z, .bellsDone
 246+ E7D8 3E 28            LD A, BELL_PAUSE
 247+ E7DA 32 AD E7         LD (BellTimer), A
 248+ E7DD C9               RET
 249+ E7DE
 250+ E7DE              .bellsDone:
 251+ E7DE                  ; Ultima campanada: actualizar tablas a N2 y aplicar remap
 252+ E7DE CD 2C DE         CALL UpdateRemapTables
 253+ E7E1 3E 01            LD A, 1
 254+ E7E3 32 B2 81         LD (AttrsDirty), A
 255+ E7E6 C9               RET
 256+ E7E7
