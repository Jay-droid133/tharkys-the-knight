  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD 7D 90         CALL InitPaging
  34  6007 CD 0B 9D         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 58 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 A9 02         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  62  602B 3E FF            LD A, $FF
  63  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  64  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  65  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  66  6036
  67  6036                  ; Inicializar sistema de pantallas
  68  6036 CD 99 C9         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  69  6039 CD 2B A2         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  70  603C CD E8 DD         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  71  603F CD 80 BD         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  72  6042 CD FA E9         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  73  6045                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  74  6045
  75  6045 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  76  6047 FB               EI                      ; Habilitar interrupciones
  77  6048 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  78  604A 32 DB 80         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
  79  604D C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
  80  6050
  81  6050                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
  82  6050                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
  83  6050                  ; contention pero solo durante la cinematica final, una vez por partida —
  84  6050                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
  85  6050                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
  86  6050                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
  87  6050                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
  88  6050                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
  89  6050                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 6050              ; ==============================================================================
   2+ 6050              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6050              ; ==============================================================================
   4+ 6050              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6050              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6050              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6050              ;
   8+ 6050              ; Esquema de fases:
   9+ 6050              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6050              ;   2 ARM_IN       arm aparece, pausa
  11+ 6050              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6050              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6050              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6050              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6050              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6050              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6050              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6050              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6050              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6050              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6050              ;  13 END_HOLD     "The End" sprite hold
  22+ 6050              ;  14 BLACK        wipe a negro + hold
  23+ 6050              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6050              ;
  25+ 6050              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6050              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6050              ; ==============================================================================
  28+ 6050
  29+ 6050              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6050              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6050              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6050              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6050              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6050              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6050              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6050              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6050              TGCS_T_PLAYER_FRAMED   EQU 60      ; Player premece en la puerta
  38+ 6050              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  39+ 6050              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  40+ 6050              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  41+ 6050
  42+ 6050              ; --- Posiciones (pixel) ---
  43+ 6050              TGCS_ANCHOR1_X         EQU 120     ; char (15,10)
  44+ 6050              TGCS_ANCHOR1_Y         EQU 80
  45+ 6050              TGCS_ANCHOR2_X         EQU 120     ; ajuste fino para encaje en hueco del open door
  46+ 6050              TGCS_ANCHOR2_Y         EQU 152
  47+ 6050              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  48+ 6050              TGCS_END_CHARY         EQU 4
  49+ 6050              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  50+ 6050
  51+ 6050              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  52+ 6050              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  53+ 6050              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  54+ 6050              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  55+ 6050              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  56+ 6050              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  57+ 6050              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  58+ 6050              TGCS_ARM_PX_X          EQU 136
  59+ 6050              TGCS_ARM_PX_Y          EQU 64
  60+ 6050              TGCS_FINGER_PX_X       EQU 136
  61+ 6050              TGCS_FINGER_PX_Y       EQU 56
  62+ 6050
  63+ 6050              ; --- Phase enum ---
  64+ 6050              TGP_IDLE               EQU 0
  65+ 6050              TGP_LOCK               EQU 1
  66+ 6050              TGP_ARM_IN             EQU 2
  67+ 6050              TGP_FINGER_IN          EQU 3
  68+ 6050              TGP_SHAKE              EQU 4
  69+ 6050              TGP_FINGER_PULSE       EQU 5
  70+ 6050              TGP_FINGER_OUT         EQU 6
  71+ 6050              TGP_ARM_HOLD           EQU 7
  72+ 6050              TGP_ARM_OUT            EQU 8
  73+ 6050              TGP_PLAYER_TURN        EQU 9
  74+ 6050              TGP_PLAYER_HIDE        EQU 10
  75+ 6050              TGP_PLAYER_FRAMED      EQU 11
  76+ 6050              TGP_PLAYER_EXIT        EQU 12
  77+ 6050              TGP_END_HOLD           EQU 13
  78+ 6050              TGP_BLACK              EQU 14
  79+ 6050              TGP_CREDITS            EQU 15
  80+ 6050              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  81+ 6050
  82+ 6050              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  83+ 6050                                                ; check dinamico de "todos los nasties dead".
  84+ 6050                                                ; ProcessEnemies hace 2 slots/frame; con 4
  85+ 6050                                                ; nasties + 3 monsters + 1 death = 8 slots,
  86+ 6050                                                ; cada puff tarda ~50 frames. 100 = margen.
  87+ 6050
  88+ 6050              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  89+ 6050              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  90+ 6050              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  91+ 6050              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  92+ 6050              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  93+ 6050              ;
  94+ 6050              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  95+ 6050              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  96+ 6050              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
  97+ 6050              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
  98+ 6050              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
  99+ 6050              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 100+ 6050              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 101+ 6050              TGCS_PART1_CHARX       EQU 10        ; placement de part1 en char (para redraw)
 102+ 6050              TGCS_PART1_CHARY       EQU 13
