 114+ 880D              .alignedLine:
 115+ 880D 3A 64 88         LD A, (.widthSave)
 116+ 8810 47               LD B, A                     ; B = ancho en bytes
 117+ 8811 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 118+ 8812
 119+ 8812              .alignedByte:
 120+ 8812 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 121+ 8813 AE               XOR (HL)
 122+ 8814 77               LD (HL), A
 123+ 8815 23               INC HL                      ; Siguiente columna VRAM
 124+ 8816 13               INC DE                      ; 6T (era INC IX = 10T)
 125+ 8817 10 F9            DJNZ .alignedByte
 126+ 8819
 127+ 8819 E1               POP HL                      ; Restaurar inicio de linea
 128+ 881A 0D               DEC C
 129+ 881B C8               RET Z                       ; Terminamos todas las lineas
 130+ 881C CD 68 88         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 131+ 881F 18 EC            JR .alignedLine
 132+ 8821
 133+ 8821                  ; ==================================================================
 134+ 8821                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 135+ 8821                  ; ==================================================================
 136+ 8821                  ; A = shift amount (1-7) al llegar aqui
 137+ 8821              .shifted:
 138+ 8821                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 139+ 8821 3D               DEC A                       ; 0-6
 140+ 8822 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 141+ 8823 E6 0E            AND $0E
 142+ 8825 C6 DC            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 143+ 8827 32 66 88         LD (.tablePage), A
 144+ 882A
 145+ 882A                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 146+ 882A DD E5            PUSH IX
 147+ 882C D1               POP DE                      ; DE = puntero a pixel data
 148+ 882D D5               PUSH DE                     ; Guardar sprite data ptr en stack
 149+ 882E
 150+ 882E                  ; Recargar D=Y, E=X para CalcPixelAddr
 151+ 882E 3A 63 88         LD A, (.posY)
 152+ 8831 57               LD D, A
 153+ 8832 3A 62 88         LD A, (.posX)
 154+ 8835 5F               LD E, A
 155+ 8836 CD BC 8A         CALL CalcPixelAddr          ; HL = dir VRAM
 156+ 8839
 157+ 8839 D1               POP DE                      ; DE = sprite data ptr restaurado
 158+ 883A 3A 66 88         LD A, (.tablePage)
 159+ 883D 47               LD B, A                     ; B = pagina high part
 160+ 883E                  ; Contadores en IX (libre: se convirtio a DE arriba)
 161+ 883E                  ; IXH = height counter, IXL = width counter (reset cada linea)
 162+ 883E 3A 65 88         LD A, (.heightSave)
 163+ 8841 DD 67            LD IXH, A
