 466+ 92FB C5               PUSH BC
 467+ 92FC DD 7E 01         LD A, (IX+ENT_TYPE)
 468+ 92FF FE 02            CP TYPE_MONSTER
 469+ 9301 20 12            JR NZ, .dsmNext
 470+ 9303 DD 7E 02         LD A, (IX+ENT_STATE)
 471+ 9306 FE 05            CP STATE_SCARED
 472+ 9308 20 0B            JR NZ, .dsmNext
 473+ 930A CD B6 92         CALL WipeMonsterSlot
 474+ 930D DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 9311 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 476+ 9315              .dsmNext:
 477+ 9315 11 10 00         LD DE, ENT_SIZE
 478+ 9318 DD 19            ADD IX, DE
 479+ 931A C1               POP BC
 480+ 931B 10 DE            DJNZ .dsmLoop
 481+ 931D C9               RET
