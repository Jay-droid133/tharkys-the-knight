 325+ 654F CB 3F            SRL A
 325+ 6551 CB 3F          SRL A
 325+ 6553 CB 3F          SRL A                   ; A = char Y (post-HUD)
 326+ 6555 26 00            LD H, 0
 327+ 6557 6F               LD L, A
 328+ 6558 29               ADD HL, HL                              ; *2
 329+ 6559 29               ADD HL, HL                              ; *4
 330+ 655A 29               ADD HL, HL                              ; *8
 331+ 655B 29               ADD HL, HL                              ; *16
 332+ 655C 29               ADD HL, HL                              ; *32
 333+ 655D 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 334+ 6560 CB 3F            SRL A
 334+ 6562 CB 3F          SRL A
 334+ 6564 CB 3F          SRL A                   ; A = char X
 335+ 6566 5F               LD E, A
 336+ 6567 16 00            LD D, 0
 337+ 6569 19               ADD HL, DE
 338+ 656A 11 00 58         LD DE, $5800
 339+ 656D 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 340+ 656E AF               XOR A                                   ; paper black, ink black
 341+ 656F 77               LD (HL), A                              ; (charY, charX)
 342+ 6570 23               INC HL
 343+ 6571 77               LD (HL), A                              ; (charY, charX+1)
 344+ 6572 11 1F 00         LD DE, 31
 345+ 6575 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 346+ 6576 77               LD (HL), A
 347+ 6577 23               INC HL
 348+ 6578 77               LD (HL), A                              ; (charY+1, charX+1)
 349+ 6579 C9               RET
