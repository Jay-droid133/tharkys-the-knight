 227+ 9ABF              ; ==============================================================================
 228+ 9ABF              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9ABF              ; ==============================================================================
 230+ 9ABF              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9ABF              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9ABF              ;
 233+ 9ABF              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9ABF              ; ==============================================================================
 235+ 9ABF              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9ABF              NextPixelLine:
 237+ 9ABF 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9AC0 7C               LD A, H
 239+ 9AC1 E6 07            AND 7
 240+ 9AC3 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9AC4
 242+ 9AC4                  ; --- Cruce de character row ---
 243+ 9AC4 7D               LD A, L
 244+ 9AC5 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AC7 6F               LD L, A
 246+ 9AC8 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9ACA C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9ACB
 249+ 9ACB                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9ACB 7C               LD A, H
 251+ 9ACC D6 08            SUB 8
 252+ 9ACE 67               LD H, A
 253+ 9ACF C9               RET
