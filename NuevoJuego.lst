1014+ A7C8              ; ==============================================================================
1015+ A7C8              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
1016+ A7C8              ; ==============================================================================
1017+ A7C8              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
1018+ A7C8              ; IX = puntero a la entidad
1019+ A7C8              ; ==============================================================================
1020+ A7C8              DrawEntity:
1021+ A7C8 CD FD A7         CALL GetSpriteAddr
1022+ A7CB
1023+ A7CB                  ; Guardar attrs del fondo ANTES de pintar
1024+ A7CB DD 56 04         LD D, (IX+ENT_POSY)
1025+ A7CE DD 7E 0F         LD A, (IX+ENT_DRAWX)
1026+ A7D1 5F               LD E, A
1027+ A7D2 DD E5            PUSH IX
1028+ A7D4 DD 2A 2C A8      LD IX, (SpriteAddrTemp)
1029+ A7D8 CD 91 9E         CALL SaveEntityAttr
1030+ A7DB DD E1            POP IX
1031+ A7DD
1032+ A7DD                  ; Pintar atributo ANTES del draw
1033+ A7DD DD 56 04         LD D, (IX+ENT_POSY)
1034+ A7E0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1035+ A7E3 5F               LD E, A
1036+ A7E4 DD 7E 05         LD A, (IX+ENT_ATTR)
1037+ A7E7 CD 23 9E         CALL SetEntityAttr
1038+ A7EA
1039+ A7EA                  ; XOR draw del sprite
1040+ A7EA DD 56 04         LD D, (IX+ENT_POSY)
1041+ A7ED DD 7E 0F         LD A, (IX+ENT_DRAWX)
1042+ A7F0 5F               LD E, A
