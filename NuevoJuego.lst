 624+ D4C7              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 625+ D4C7              ; ==============================================================================
 626+ D4C7              DrawTimeIndicator:
 627+ D4C7                  ; Calcular puntero al label de 2 chars
 628+ D4C7 3A DF D1         LD A, (CurrentTimeOfDay)
 629+ D4CA 87               ADD A, A                    ; A = momento * 2
 630+ D4CB 5F               LD E, A
 631+ D4CC 16 00            LD D, 0
 632+ D4CE 21 CE D5         LD HL, TimeLabels
 633+ D4D1 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 634+ D4D2
 635+ D4D2                  ; Primer caracter en columna 30
 636+ D4D2 7E               LD A, (HL)
 637+ D4D3 E5               PUSH HL
 638+ D4D4 1E 1E            LD E, 30
 639+ D4D6 CD EA D4         CALL DrawHudChar
 640+ D4D9 E1               POP HL
 641+ D4DA
 642+ D4DA                  ; Segundo caracter en columna 31
 643+ D4DA 23               INC HL
 644+ D4DB 7E               LD A, (HL)
 645+ D4DC 1E 1F            LD E, 31
 646+ D4DE CD EA D4         CALL DrawHudChar
 647+ D4E1
 648+ D4E1                  ; Atributos del indicador (bright white on black)
 649+ D4E1 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 650+ D4E4 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 651+ D4E6 77               LD (HL), A
 652+ D4E7 23               INC HL
 653+ D4E8 77               LD (HL), A
 654+ D4E9 C9               RET
