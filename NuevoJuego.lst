 211+ DAAC 5F               LD E, A
 212+ DAAD 16 00            LD D, 0
 213+ DAAF 21 1D DB         LD HL, NibbleDoubleLUT
 214+ DAB2 19               ADD HL, DE
 215+ DAB3 7E               LD A, (HL)                      ; A = low doubled
 216+ DAB4 2A E2 DA         LD HL, (.dpxDstTop)
 217+ DAB7 77               LD (HL), A
 218+ DAB8 23               INC HL
 219+ DAB9 22 E2 DA         LD (.dpxDstTop), HL
