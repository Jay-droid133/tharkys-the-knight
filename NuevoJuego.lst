 400+ 9F5F 11 9C 9F         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9F62
 402+ 9F62 3A AD 9F         LD A, (EntityAttrH)
 403+ 9F65 4F               LD C, A                     ; C = filas
