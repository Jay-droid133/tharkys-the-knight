 187  8039 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 188  803C ED 78            IN A, (C)
 189  803E CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 190  8040 C2 2B 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 191  8043                  ; SPACE pulsado: reset total -> JP Inicio
 192  8043 F3               DI
 193  8044 31 58 FF         LD SP, SP_ADDRESS
 194  8047 C3 00 60         JP Inicio
