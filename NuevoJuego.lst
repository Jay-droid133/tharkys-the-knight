# file closed: screen_data.asm
 345  E497                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 346  E497                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 347  E497                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 348  E497                  ; deben vivir en el mismo banco paginado.
 349  E497                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E497              ; ==============================================================================
   2+ E497              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E497              ; ==============================================================================
   4+ E497              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E497              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E497              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E497              ; ==============================================================================
   8+ E497
   9+ E497              ; --- Constantes ---
  10+ E497              NUM_TIME_MOMENTS    EQU 7
  11+ E497
  12+ E497              ; --- Variables ---
  13+ E497 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E498 30 E9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E49A 30 E9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E49C 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E49D 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E49E 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E49F
  20+ E49F              ; ==============================================================================
  21+ E49F              ; SetTimeOfDay - Cambia el momento del dia
  22+ E49F              ; ==============================================================================
  23+ E49F              ; Entrada: A = momento (0-6)
  24+ E49F              ; ==============================================================================
  25+ E49F              SetTimeOfDay:
  26+ E49F 32 97 E4         LD (CurrentTimeOfDay), A
  27+ E4A2
  28+ E4A2                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E4A2 FE 04            CP 4
  30+ E4A4 20 06            JR NZ, .notNewCycle
  31+ E4A6 21 D3 BF         LD HL, DayCycleCount
  32+ E4A9 34               INC (HL)
  33+ E4AA 18 04            JR .skipBellsReset
  34+ E4AC              .notNewCycle:
  35+ E4AC                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E4AC                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E4AC                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E4AC AF               XOR A
  39+ E4AD 32 59 82         LD (BellsTriggered), A
  40+ E4B0              .skipBellsReset:
  41+ E4B0 3A 97 E4         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E4B3
  43+ E4B3                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E4B3 FE 04            CP 4
  45+ E4B5 28 21            JR Z, .bellsFirst
  46+ E4B7
  47+ E4B7                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E4B7 FE 05            CP 5
  49+ E4B9 20 0A            JR NZ, .noScareMon
  50+ E4BB CD ED BF         CALL ScareAllMonsters
  51+ E4BE                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  52+ E4BE                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  53+ E4BE                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  54+ E4BE                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  55+ E4BE 3E 01            LD A, 1                         ; track 1 = Sunrise
  56+ E4C0 CD F2 9C         CALL StartMusic
  57+ E4C3 18 07            JR .noKillMon
  58+ E4C5              .noScareMon:
  59+ E4C5                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  60+ E4C5 FE 06            CP 6
  61+ E4C7 20 03            JR NZ, .noKillMon
  62+ E4C9 CD 76 BF         CALL KillAllActiveMonsters
  63+ E4CC              .noKillMon:
  64+ E4CC
  65+ E4CC                  ; Actualizar tablas de remap y tabla de nasties
  66+ E4CC CD 01 E5         CALL UpdateRemapTables
  67+ E4CF CD D6 BF         CALL UpdateNastyTable
  68+ E4D2
  69+ E4D2                  ; Forzar remap de atributos (sin redibujar pixeles)
  70+ E4D2 3E 01            LD A, 1
  71+ E4D4 32 A3 82         LD (AttrsDirty), A
  72+ E4D7 C9               RET
  73+ E4D8
  74+ E4D8              .bellsFirst:
  75+ E4D8                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  76+ E4D8                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  77+ E4D8                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  78+ E4D8                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  79+ E4D8                  ; que sean nocturnos (Crepuscular), no diurnos.
  80+ E4D8 CD D6 BF         CALL UpdateNastyTable
  81+ E4DB                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  82+ E4DB                  ; antes de medianoche natural y forzo el evento), saltamos.
  83+ E4DB 3A 59 82         LD A, (BellsTriggered)
  84+ E4DE B7               OR A
  85+ E4DF C0               RET NZ
  86+ E4E0 3E 01            LD A, 1
  87+ E4E2 32 59 82         LD (BellsTriggered), A
  88+ E4E5 CD A9 F9         CALL StartBellChimes
  89+ E4E8 C9               RET
  90+ E4E9
  91+ E4E9              ; ==============================================================================
  92+ E4E9              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  93+ E4E9              ; ==============================================================================
  94+ E4E9              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  95+ E4E9              ;   - Salta reloj a 00:00.
  96+ E4E9              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  97+ E4E9              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  98+ E4E9              ;     campanadas como hace el path natural). El usuario quiere que la
  99+ E4E9              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 100+ E4E9              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 101+ E4E9              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 102+ E4E9              ;     pero ya esta en N2 -> no-op visual.
 103+ E4E9              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 104+ E4E9              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 105+ E4E9              ;
 106+ E4E9              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 107+ E4E9              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 108+ E4E9              ; aqui no re-dispara nada.
 109+ E4E9              ; ==============================================================================
 110+ E4E9              TriggerChurchMidnight:
 111+ E4E9 3A 59 82         LD A, (BellsTriggered)
 112+ E4EC B7               OR A
 113+ E4ED C0               RET NZ                              ; bells ya sonaron -> no-op
 114+ E4EE 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 115+ E4F0 CD E0 EC         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 116+ E4F3 3E 04            LD A, 4
 117+ E4F5 CD 9F E4         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 118+ E4F8                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 119+ E4F8                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 120+ E4F8                  ; diurnos durante chimes). En este path queremos lo contrario.
 121+ E4F8 CD 01 E5         CALL UpdateRemapTables
 122+ E4FB 3E 01            LD A, 1
 123+ E4FD 32 A3 82         LD (AttrsDirty), A
 124+ E500 C9               RET
 125+ E501
 126+ E501              ; ==============================================================================
 127+ E501              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 128+ E501              ; ==============================================================================
 129+ E501              UpdateRemapTables:
 130+ E501 3A 97 E4         LD A, (CurrentTimeOfDay)
 131+ E504 21 04 E9         LD HL, RemapTablePtrs
 132+ E507 5F               LD E, A
 133+ E508 16 00            LD D, 0
 134+ E50A 19               ADD HL, DE
 135+ E50B 19               ADD HL, DE
 136+ E50C 5E               LD E, (HL)
 137+ E50D 23               INC HL
 138+ E50E 56               LD D, (HL)
 139+ E50F ED 53 98 E4      LD (CurrentRemapTable), DE
 140+ E513
 141+ E513 3A 97 E4         LD A, (CurrentTimeOfDay)
 142+ E516 21 12 E9         LD HL, RemapHouseTablePtrs
 143+ E519 5F               LD E, A
 144+ E51A 16 00            LD D, 0
 145+ E51C 19               ADD HL, DE
 146+ E51D 19               ADD HL, DE
 147+ E51E 5E               LD E, (HL)
 148+ E51F 23               INC HL
 149+ E520 56               LD D, (HL)
 150+ E521 ED 53 9A E4      LD (CurrentHouseRemapTable), DE
 151+ E525 C9               RET
 152+ E526
 153+ E526              ; ==============================================================================
 154+ E526              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 155+ E526              ; ==============================================================================
 156+ E526              CheckDebugKeys:
 157+ E526 3E FB            LD A, $FB
 158+ E528 DB FE            IN A, ($FE)
 159+ E52A CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 160+ E52C 20 1C            JR NZ, .notPressed
 161+ E52E
 162+ E52E                  ; Tecla pulsada: comprobar debounce
 163+ E52E 3A 9E E4         LD A, (DebugKeyDebounce)
 164+ E531 B7               OR A
 165+ E532 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 166+ E533
 167+ E533                  ; Primera pulsacion: ciclar
 168+ E533 3E 01            LD A, 1
 169+ E535 32 9E E4         LD (DebugKeyDebounce), A
 170+ E538
 171+ E538 3A 97 E4         LD A, (CurrentTimeOfDay)
 172+ E53B 3C               INC A
 173+ E53C FE 07            CP NUM_TIME_MOMENTS
 174+ E53E 38 01            JR C, .noWrap
 175+ E540 AF               XOR A                   ; Volver a 0 (Dia)
 176+ E541              .noWrap:
 177+ E541 F5               PUSH AF
 178+ E542 CD 9F E4         CALL SetTimeOfDay
 179+ E545 F1               POP AF
 180+ E546 CD E0 EC         CALL SetClockToPhaseHour
 181+ E549 C9               RET
 182+ E54A
 183+ E54A              .notPressed:
 184+ E54A AF               XOR A
 185+ E54B 32 9E E4         LD (DebugKeyDebounce), A
 186+ E54E
 187+ E54E                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 188+ E54E 3E FD            LD A, $FD
 189+ E550 DB FE            IN A, ($FE)
 190+ E552 4F               LD C, A                 ; C = estado semi-fila $FDFE
 191+ E553 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 192+ E555 20 13            JR NZ, .sNotPressed
 193+ E557 3A A5 E5         LD A, (SpeedKeyDebounce)
 194+ E55A B7               OR A
 195+ E55B C0               RET NZ
 196+ E55C 3E 01            LD A, 1
 197+ E55E 32 A5 E5         LD (SpeedKeyDebounce), A
 198+ E561 21 D3 BF         LD HL, DayCycleCount
 199+ E564 7E               LD A, (HL)
 200+ E565 FE 0A            CP 10
 201+ E567 D0               RET NC                  ; Ya en maximo
 202+ E568 34               INC (HL)
 203+ E569 C9               RET
 204+ E56A              .sNotPressed:
 205+ E56A                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 206+ E56A CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 207+ E56C 20 13            JR NZ, .dNotPressed
 208+ E56E 3A A5 E5         LD A, (SpeedKeyDebounce)
 209+ E571 B7               OR A
 210+ E572 C0               RET NZ
 211+ E573 3E 01            LD A, 1
 212+ E575 32 A5 E5         LD (SpeedKeyDebounce), A
 213+ E578 21 D3 BF         LD HL, DayCycleCount
 214+ E57B 7E               LD A, (HL)
 215+ E57C FE 01            CP 1
 216+ E57E C8               RET Z                   ; Ya en minimo
 217+ E57F 35               DEC (HL)
 218+ E580 C9               RET
 219+ E581              .dNotPressed:
 220+ E581 AF               XOR A
 221+ E582 32 A5 E5         LD (SpeedKeyDebounce), A
 222+ E585
 223+ E585                  ; --- Tecla N: togglea NoclipMode (debug) ---
 224+ E585 3E 7F            LD A, $7F
 225+ E587 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 226+ E589 CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 227+ E58B 20 13            JR NZ, .nNotPressed
 228+ E58D 3A A6 E5         LD A, (NoclipKeyDebounce)
 229+ E590 B7               OR A
 230+ E591 C0               RET NZ
 231+ E592 3E 01            LD A, 1
 232+ E594 32 A6 E5         LD (NoclipKeyDebounce), A
 233+ E597 3A 51 82         LD A, (NoclipMode)
 234+ E59A EE 01            XOR 1
 235+ E59C 32 51 82         LD (NoclipMode), A
 236+ E59F C9               RET
 237+ E5A0              .nNotPressed:
 238+ E5A0 AF               XOR A
 239+ E5A1 32 A6 E5         LD (NoclipKeyDebounce), A
 240+ E5A4 C9               RET
 241+ E5A5
 242+ E5A5 00           SpeedKeyDebounce: DEFB 0
 243+ E5A6 00           NoclipKeyDebounce: DEFB 0
 244+ E5A7
 245+ E5A7              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 246+ E5A7              DrawSwordModeHUD:
 247+ E5A7 3A 37 B6         LD A, (SwordMode)
 248+ E5AA 21 DA E5         LD HL, .modeChars
 249+ E5AD 5F               LD E, A
 250+ E5AE 16 00            LD D, 0
 251+ E5B0 19               ADD HL, DE
 252+ E5B1 7E               LD A, (HL)                          ; A = ASCII del modo
 253+ E5B2                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 254+ E5B2 21 00 40         LD HL, $4000
 255+ E5B5                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 256+ E5B5 5F               LD E, A
 257+ E5B6 16 00            LD D, 0
 258+ E5B8 42               LD B, D                             ; B = 0
 259+ E5B9 CB 23            SLA E
 259+ E5BB CB 12          RL D                        ; *2
 260+ E5BD CB 23            SLA E
 260+ E5BF CB 12          RL D                        ; *4
 261+ E5C1 CB 23            SLA E
 261+ E5C3 CB 12          RL D                        ; *8
 262+ E5C5 E5               PUSH HL
 263+ E5C6 21 00 3C         LD HL, $3C00
 264+ E5C9 19               ADD HL, DE                          ; HL = direccion del glyph
 265+ E5CA EB               EX DE, HL                           ; DE = glyph
 266+ E5CB E1               POP HL                              ; HL = VRAM
 267+ E5CC 06 08            LD B, 8
 268+ E5CE              .drawChar:
 269+ E5CE 1A               LD A, (DE)
 270+ E5CF 77               LD (HL), A
 271+ E5D0 13               INC DE
 272+ E5D1 24               INC H                               ; siguiente scan line
 273+ E5D2 10 FA            DJNZ .drawChar
 274+ E5D4                  ; Attr: fila 0, col 0 = $5800
 275+ E5D4 3E 47            LD A, $47                           ; blanco bright
 276+ E5D6 32 00 58         LD ($5800), A
 277+ E5D9 C9               RET
 278+ E5DA
 279+ E5DA 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 280+ E5DD
 281+ E5DD              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 282+ E5DD              DrawNoclipHUD:
 283+ E5DD 3A 51 82         LD A, (NoclipMode)
 284+ E5E0 B7               OR A
 285+ E5E1 20 0E            JR NZ, .ncOn
 286+ E5E3 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 287+ E5E5 1E 1E            LD E, 30
 288+ E5E7 CD 12 E8         CALL DrawHudChar
 289+ E5EA 3E 20            LD A, 32
 290+ E5EC 1E 1F            LD E, 31
 291+ E5EE C3 12 E8         JP DrawHudChar
 292+ E5F1              .ncOn:
 293+ E5F1 3E 4E            LD A, 'N'
 294+ E5F3 1E 1E            LD E, 30
