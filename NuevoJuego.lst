1279+ A930 32 66 B6         LD (AttackTimer), A
1280+ A933 20 08            JR NZ, .bActive
1281+ A935                  ; Swing terminado: iniciar cooldown + color azul
1282+ A935 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1283+ A937 32 67 B6         LD (AttackCooldown), A
1284+ A93A CD 95 A9         CALL .setPlayerBlue
1285+ A93D              .bActive:
1286+ A93D DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1287+ A941 C9               RET
1288+ A942              .bNoActive:
