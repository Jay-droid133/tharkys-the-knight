# file opened: sound.asm
   1+ F969              ; ==============================================================================
   2+ F969              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F969              ; ==============================================================================
   4+ F969              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F969              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F969              ;
   7+ F969              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F969              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F969              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F969              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F969              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F969              ; ==============================================================================
  13+ F969
  14+ F969              ; ==============================================================================
  15+ F969              ; PlaySFX - Reproduce un efecto de sonido
  16+ F969              ; ==============================================================================
  17+ F969              ; Entrada: HL = puntero a datos del efecto
  18+ F969              ; Modifica: AF, BC, DE, HL
  19+ F969              ; ==============================================================================
  20+ F969              PlaySFX:
  21+ F969 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F96A 3A 88 8D         LD A, (CurrentBorderColor)
  23+ F96D E6 07            AND $07                     ; Solo bits de color del borde
  24+ F96F 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F970
  26+ F970              .nextStep:
  27+ F970 7E               LD A, (HL)                  ; Leer duration
  28+ F971 B7               OR A
  29+ F972 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F974
  31+ F974 47               LD B, A                     ; B = duration (bucle externo)
  32+ F975 23               INC HL
  33+ F976 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F977 23               INC HL
  35+ F978 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F979 23               INC HL
  37+ F97A 7E               LD A, (HL)                  ; A = flags
  38+ F97B 23               INC HL
  39+ F97C E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F97D CB 47            BIT 0, A
  41+ F97F 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F981
  43+ F981              ; --- Bucle de tono normal ---
  44+ F981              .toneLoop:
  45+ F981                  ; Semi-periodo HIGH
  46+ F981 7B               LD A, E
  47+ F982 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F984 D3 FE            OUT ($FE), A
  49+ F986 79               LD A, C                     ; A = pitch actual
  50+ F987              .toneDelayHi:
  51+ F987 3D               DEC A
  52+ F988 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F98A
  54+ F98A                  ; Semi-periodo LOW
  55+ F98A 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F98B D3 FE            OUT ($FE), A
  57+ F98D 79               LD A, C
  58+ F98E              .toneDelayLo:
  59+ F98E 3D               DEC A
  60+ F98F 20 FD            JR NZ, .toneDelayLo
  61+ F991
  62+ F991                  ; Aplicar pitch sweep
  63+ F991 79               LD A, C
  64+ F992 82               ADD A, D                    ; pitch += pitchDelta
  65+ F993 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F995 FA 9D F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F998 4F               LD C, A
  68+ F999              .toneAfterClamp:
  69+ F999 10 E6            DJNZ .toneLoop
  70+ F99B 18 30            JR .stepDone
  71+ F99D
  72+ F99D              .toneClamp:
  73+ F99D 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F99F 18 F8            JR .toneAfterClamp
  75+ F9A1
  76+ F9A1              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F9A1              .noiseLoop:
  78+ F9A1                  ; Semi-periodo HIGH con ruido
  79+ F9A1 7B               LD A, E
  80+ F9A2 F6 10            OR $10
  81+ F9A4 D3 FE            OUT ($FE), A
  82+ F9A6 ED 5F            LD A, R                     ; R register como PRNG
  83+ F9A8 A9               XOR C                       ; mezclar con pitch base
  84+ F9A9 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F9AB F6 01            OR $01                      ; minimo 1
  86+ F9AD              .noiseDelayHi:
  87+ F9AD 3D               DEC A
  88+ F9AE 20 FD            JR NZ, .noiseDelayHi
  89+ F9B0
  90+ F9B0                  ; Semi-periodo LOW
  91+ F9B0 7B               LD A, E
  92+ F9B1 D3 FE            OUT ($FE), A
  93+ F9B3 ED 5F            LD A, R
  94+ F9B5 A9               XOR C
  95+ F9B6 E6 1F            AND $1F
  96+ F9B8 F6 01            OR $01
  97+ F9BA              .noiseDelayLo:
  98+ F9BA 3D               DEC A
  99+ F9BB 20 FD            JR NZ, .noiseDelayLo
 100+ F9BD
 101+ F9BD                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F9BD 79               LD A, C
 103+ F9BE 82               ADD A, D
 104+ F9BF 28 08            JR Z, .noiseClamp
 105+ F9C1 FA C9 F9         JP M, .noiseClamp
 106+ F9C4 4F               LD C, A
 107+ F9C5              .noiseAfterClamp:
 108+ F9C5 10 DA            DJNZ .noiseLoop
 109+ F9C7 18 04            JR .stepDone
 110+ F9C9
 111+ F9C9              .noiseClamp:
 112+ F9C9 0E 01            LD C, 1
 113+ F9CB 18 F8            JR .noiseAfterClamp
 114+ F9CD
 115+ F9CD              .stepDone:
 116+ F9CD E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F9CE 18 A0            JR .nextStep
 118+ F9D0
 119+ F9D0              .done:
 120+ F9D0 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F9D1 D3 FE            OUT ($FE), A
 122+ F9D3 FB               EI
 123+ F9D4 C9               RET
