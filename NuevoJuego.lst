 743+ D439              ; ==============================================================================
 744+ D439              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 745+ D439              ; ==============================================================================
 746+ D439              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 747+ D439              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 748+ D439              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 749+ D439              ; ==============================================================================
 750+ D439              DrawBgGfxSprite:
