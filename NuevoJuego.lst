 452+ 65DE 21 B0 64         LD HL, StatueIdTable
 453+ 65E1 5F               LD E, A
 454+ 65E2 16 00            LD D, 0
 455+ 65E4 19               ADD HL, DE
 456+ 65E5 7E               LD A, (HL)                              ; A = statue id
 457+ 65E6 B7               OR A
