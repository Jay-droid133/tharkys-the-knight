2078+ AA86              ; ==============================================================================
2079+ AA86              ; SISTEMA DE ENEMIGOS
2080+ AA86              ; ==============================================================================
2081+ AA86
2082+ AA86              ; ==============================================================================
2083+ AA86              ; UpdateEnemy - AI patrol + bounce (estilo Sabre Wulf)
2084+ AA86              ; ==============================================================================
2085+ AA86              ; Cada frame: posicion += delta. Si choca con borde o fondo, invierte delta.
2086+ AA86              ; Animacion: cicla SpriteID dentro del rango del tipo.
2087+ AA86              ; IX = puntero a la entidad enemiga.
2088+ AA86              ; ==============================================================================
2089+ AA86              ; ==============================================================================
2090+ AA86              ; CheckPredatorAttack - Comprueba si nasty debe lanzarse como depredador
2091+ AA86              ; ==============================================================================
2092+ AA86              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
2093+ AA86              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
2094+ AA86              ; ==============================================================================
2095+ AA86              ; ==============================================================================
2096+ AA86              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2097+ AA86              ; ==============================================================================
2098+ AA86              UpdateStamina:
2099+ AA86                  ; --- Regenerar salud (1 unidad cada HEALTH_REGEN_RATE = 100 f = 4 s) ---
2100+ AA86 3A 89 B3         LD A, (PlayerHealth)
2101+ AA89 FE 10            CP HEALTH_MAX
2102+ AA8B 28 12            JR Z, .usHealthFull
2103+ AA8D 21 8D B3         LD HL, HealthRegenCtr
2104+ AA90 34               INC (HL)
2105+ AA91 7E               LD A, (HL)
2106+ AA92 FE 64            CP HEALTH_REGEN_RATE
2107+ AA94 38 09            JR C, .usHealthFull
2108+ AA96 36 00            LD (HL), 0
2109+ AA98 3A 89 B3         LD A, (PlayerHealth)
2110+ AA9B 3C               INC A
2111+ AA9C 32 89 B3         LD (PlayerHealth), A
2112+ AA9F              .usHealthFull:
2113+ AA9F                  ; --- Stamina: consumir o regenerar ---
2114+ AA9F DD 7E 02         LD A, (IX+ENT_STATE)
2115+ AAA2 FE 02            CP STATE_FIGHTING
2116+ AAA4 28 18            JR Z, .usDrain
2117+ AAA6                  ; --- Regenerar stamina (1 unidad cada STAMINA_REGEN_RATE = 50 f = 2 s) ---
2118+ AAA6 3A 8A B3         LD A, (PlayerStamina)
2119+ AAA9 FE 10            CP STAMINA_MAX
2120+ AAAB C8               RET Z                               ; Ya al maximo
2121+ AAAC 21 8C B3         LD HL, StaminaRegenCtr
2122+ AAAF 34               INC (HL)
2123+ AAB0 7E               LD A, (HL)
2124+ AAB1 FE 32            CP STAMINA_REGEN_RATE
2125+ AAB3 D8               RET C                               ; Aun no toca
2126+ AAB4 36 00            LD (HL), 0                          ; Reset counter
2127+ AAB6 3A 8A B3         LD A, (PlayerStamina)
2128+ AAB9 3C               INC A
2129+ AABA 32 8A B3         LD (PlayerStamina), A
2130+ AABD C9               RET
2131+ AABE              .usDrain:
2132+ AABE                  ; Atacando: consumir stamina
2133+ AABE                  ; ESPADA buff activo -> no consume stamina (gate).
2134+ AABE 3A DA 5F         LD A, (EspadaTimer)
2135+ AAC1 21 DB 5F         LD HL, EspadaTimer + 1
2136+ AAC4 B6               OR (HL)
2137+ AAC5 C0               RET NZ                              ; Espada activa: skip drain
2138+ AAC6 3A 8A B3         LD A, (PlayerStamina)
2139+ AAC9 B7               OR A
2140+ AACA C8               RET Z                               ; Ya vacia
2141+ AACB 21 8B B3         LD HL, StaminaDrainCtr
2142+ AACE 34               INC (HL)
2143+ AACF 7E               LD A, (HL)
2144+ AAD0 FE 0D            CP STAMINA_DRAIN_RATE
2145+ AAD2 D8               RET C
2146+ AAD3 36 00            LD (HL), 0
2147+ AAD5 3A 8A B3         LD A, (PlayerStamina)
2148+ AAD8 3D               DEC A
2149+ AAD9 32 8A B3         LD (PlayerStamina), A
2150+ AADC                  ; Si stamina llega a 0, dar 1 punto tras cooldown
2151+ AADC B7               OR A
2152+ AADD C0               RET NZ
2153+ AADE 3E 01            LD A, 1
2154+ AAE0 32 8A B3         LD (PlayerStamina), A               ; Minimo 1 para un swing
2155+ AAE3 C9               RET
2156+ AAE4
2157+ AAE4              ; ==============================================================================
2158+ AAE4              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2159+ AAE4              ; ==============================================================================
2160+ AAE4              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2161+ AAE4              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2162+ AAE4              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2163+ AAE4              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2164+ AAE4              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2165+ AAE4              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2166+ AAE4              ; ==============================================================================
2167+ AAE4              SelectSwordMode:
2168+ AAE4                  ; ESPADA buff: fuerza mode 2 (libre) sin importar stamina (ataque a 0 OK).
2169+ AAE4 3A DA 5F         LD A, (EspadaTimer)
2170+ AAE7 21 DB 5F         LD HL, EspadaTimer + 1
2171+ AAEA B6               OR (HL)
2172+ AAEB 28 04            JR Z, .smCheckStamina
2173+ AAED 3E 02            LD A, 2                             ; ESPADA: siempre libre
2174+ AAEF 18 14            JR .smSet
2175+ AAF1              .smCheckStamina:
2176+ AAF1 3A 8A B3         LD A, (PlayerStamina)
2177+ AAF4 FE 0C            CP STAMINA_THRESHOLD_HIGH
2178+ AAF6 38 04            JR C, .smNotHigh
2179+ AAF8 3E 02            LD A, 2                             ; Libre (continuo)
2180+ AAFA 18 09            JR .smSet
2181+ AAFC              .smNotHigh:
2182+ AAFC FE 07            CP STAMINA_THRESHOLD_MID
2183+ AAFE 38 04            JR C, .smNotMid
2184+ AB00 3E 01            LD A, 1                             ; Fixed swing
2185+ AB02 18 01            JR .smSet
2186+ AB04              .smNotMid:
2187+ AB04 AF               XOR A                               ; Cooldown (0)
2188+ AB05              .smSet:
