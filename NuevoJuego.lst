4794+ BCEA
4795+ BCEA              ; --- Tabla de tipos de nasty (SpriteID base) ---
4796+ BCEA              ; --- Tablas de nasties por momento del dia ---
4797+ BCEA              NUM_NASTY_TYPES EQU 4
4798+ BCEA              DiurnalTypeTable:                       ; DY, C1, A2
4799+ BCEA 30               DEFB SPRID_ENEMY_4          ; Eagle
4800+ BCEB 20               DEFB SPRID_ENEMY_0          ; Spider
4801+ BCEC 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
4802+ BCED 2C               DEFB SPRID_ENEMY_3          ; Snake
4803+ BCEE              CrepuscularTypeTable:                   ; C2, N1
4804+ BCEE 34               DEFB SPRID_ENEMY_5          ; Rat
4805+ BCEF 28               DEFB SPRID_ENEMY_2          ; Bat
4806+ BCF0 24               DEFB SPRID_ENEMY_1          ; Scorpion
4807+ BCF1 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
4808+ BCF2
4809+ BCF2              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
4810+ BCF2              NastyColorTable:
4811+ BCF2 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
4812+ BCF3 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
4813+ BCF4 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
4814+ BCF5 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
4815+ BCF6 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
4816+ BCF7 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
4817+ BCF8 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
4818+ BCF9 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
4819+ BCFA
4820+ BCFA              ; --- Tabla de comportamiento depredador ---
4821+ BCFA              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
4822+ BCFA              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
4823+ BCFA              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
4824+ BCFA              PredatorTable:
4825+ BCFA 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
4826+ BCFB 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
4827+ BCFC 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
4828+ BCFD 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
4829+ BCFE 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
4830+ BCFF 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
4831+ BD00 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
4832+ BD01 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
4833+ BD02
4834+ BD02              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
4835+ BD02              PredatorSpeedTable:
4836+ BD02 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
4837+ BD03 02               DEFB 2                              ; Ciclo 1: lento
4838+ BD04 03               DEFB 3                              ; Ciclo 2: intermedio
4839+ BD05 04               DEFB 4                              ; Ciclo 3+: rapido
4840+ BD06
4841+ BD06 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
4842+ BD07
4843+ BD07 EA BC        CurrentNastyTable: DEFW DiurnalTypeTable
4844+ BD09
4845+ BD09              ; ==============================================================================
4846+ BD09              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
4847+ BD09              ; ==============================================================================
4848+ BD09              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
4849+ BD09              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
4850+ BD09              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
4851+ BD09              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
4852+ BD09              ;   pantalla, no diurnos.
4853+ BD09              ; ==============================================================================
4854+ BD09              UpdateNastyTable:
4855+ BD09 3A 02 DD         LD A, (CurrentTimeOfDay)
4856+ BD0C FE 02            CP 2
4857+ BD0E 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
4858+ BD10 FE 06            CP 6
4859+ BD12 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
4860+ BD14 21 EE BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
4861+ BD17 18 03            JR .setTable
4862+ BD19              .diurnal:
4863+ BD19 21 EA BC         LD HL, DiurnalTypeTable
4864+ BD1C              .setTable:
4865+ BD1C 22 07 BD         LD (CurrentNastyTable), HL
4866+ BD1F C9               RET
4867+ BD20
4868+ BD20              ; ==============================================================================
4869+ BD20              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
4870+ BD20              ; ==============================================================================
4871+ BD20              ScareAllMonsters:
4872+ BD20 AF               XOR A
4873+ BD21 32 9F B5         LD (MonstersActive), A              ; No respawnear mas
4874+ BD24                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
4875+ BD24                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
4876+ BD24                  ; del amanecer capturara el orig POSX/POSY del primer frame.
4877+ BD24 21 A0 90         LD HL, MonsterAiFlags
4878+ BD27 06 03            LD B, 3
4879+ BD29              .samClearLoop:
4880+ BD29 7E               LD A, (HL)
4881+ BD2A E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
4882+ BD2C 77               LD (HL), A
4883+ BD2D 23               INC HL
4884+ BD2E 10 F9            DJNZ .samClearLoop
4885+ BD30 3E 7D            LD A, SCARE_TIMER_DAWN
4886+ BD32 32 35 B8         LD (ScareTimer), A
4887+ BD35                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
4888+ BD35                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
4889+ BD35                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
4890+ BD35                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
4891+ BD35 DD 21 24 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4892+ BD39 06 06            LD B, NUM_MONSTERS
4893+ BD3B              .samStateLoop:
4894+ BD3B DD 7E 01         LD A, (IX+ENT_TYPE)
4895+ BD3E FE 02            CP TYPE_MONSTER
4896+ BD40 20 1B            JR NZ, .samStateNext
4897+ BD42 DD 7E 02         LD A, (IX+ENT_STATE)
4898+ BD45 FE 03            CP STATE_DYING
4899+ BD47 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
4900+ BD49 FE 04            CP STATE_SPAWNING
4901+ BD4B 28 10            JR Z, .samStateNext
4902+ BD4D DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
4903+ BD51 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
4904+ BD55 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4905+ BD59 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4906+ BD5D              .samStateNext:
4907+ BD5D 11 10 00         LD DE, ENT_SIZE
4908+ BD60 DD 19            ADD IX, DE
4909+ BD62 10 D7            DJNZ .samStateLoop
4910+ BD64 C9               RET
4911+ BD65
4912+ BD65              ; ==============================================================================
4913+ BD65              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
4914+ BD65              ; ==============================================================================
4915+ BD65              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
4916+ BD65              ; ==============================================================================
4917+ BD65
4918+ BD65              ; ==============================================================================
4919+ BD65              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
4920+ BD65              ; ==============================================================================
4921+ BD65              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
4922+ BD65              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
4923+ BD65              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4924+ BD65              ; ==============================================================================
4925+ BD65              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
4926+ BD65              ; ==============================================================================
4927+ BD65              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
4928+ BD65              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
4929+ BD65              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4930+ BD65              ; ==============================================================================
4931+ BD65              MONSTERS_TO_SPAWN   EQU 3
4932+ BD65              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
4933+ BD65              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
4934+ BD65
4935+ BD65              ; ==============================================================================
4936+ BD65              ; SpawnMonsters - Primera aparicion tras campanadas
4937+ BD65              ; ==============================================================================
4938+ BD65              SpawnMonsters:
4939+ BD65 3A 9F B5         LD A, (MonstersActive)
4940+ BD68 B7               OR A
4941+ BD69 C0               RET NZ
4942+ BD6A                  ; Matar nasties activos antes de poblar slots de monster: liberar el
4943+ BD6A                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
4944+ BD6A CD 64 BC         CALL KillAllActiveNasties
4945+ BD6D 3E 01            LD A, 1
4946+ BD6F 32 9F B5         LD (MonstersActive), A
4947+ BD72 CD EF BD         CALL ShuffleMonsterTypes
4948+ BD75 DD 21 24 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4949+ BD79 06 03            LD B, MONSTERS_TO_SPAWN
4950+ BD7B 0E 00            LD C, 0
4951+ BD7D              .smLoop:
4952+ BD7D C5               PUSH BC
4953+ BD7E DD 7E 01         LD A, (IX+ENT_TYPE)
4954+ BD81 B7               OR A
4955+ BD82 C2 DE BD         JP NZ, .smSkip
4956+ BD85                  ; Asignar tipo y color
4957+ BD85 79               LD A, C
4958+ BD86 21 53 BE         LD HL, MonsterTypeTable
4959+ BD89 5F               LD E, A
4960+ BD8A 16 00            LD D, 0
4961+ BD8C 19               ADD HL, DE
4962+ BD8D 7E               LD A, (HL)
4963+ BD8E DD 77 08         LD (IX+ENT_ANIMBASE), A
4964+ BD91 79               LD A, C
4965+ BD92 21 56 BE         LD HL, MonsterColorTable
4966+ BD95 5F               LD E, A
4967+ BD96 16 00            LD D, 0
4968+ BD98 19               ADD HL, DE
4969+ BD99 7E               LD A, (HL)
4970+ BD9A DD 77 05         LD (IX+ENT_ATTR), A
4971+ BD9D                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
4972+ BD9D C5               PUSH BC
4973+ BD9E CD EE 93         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
4974+ BDA1 B7               OR A
4975+ BDA2 20 0E            JR NZ, .smFallbackPos
4976+ BDA4 3A AB 9C         LD A, (MaiSpawnX)
4977+ BDA7 DD 77 03         LD (IX+ENT_POSX), A
4978+ BDAA 3A AC 9C         LD A, (MaiSpawnY)
4979+ BDAD DD 77 04         LD (IX+ENT_POSY), A
4980+ BDB0 18 0C            JR .smPosDone
4981+ BDB2              .smFallbackPos:
4982+ BDB2 3A 5B 82         LD A, (LastEntryPosX)
4983+ BDB5 DD 77 03         LD (IX+ENT_POSX), A
4984+ BDB8 3A 5C 82         LD A, (LastEntryPosY)
4985+ BDBB DD 77 04         LD (IX+ENT_POSY), A
4986+ BDBE              .smPosDone:
4987+ BDBE C1               POP BC
4988+ BDBF                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
4989+ BDBF DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4990+ BDC3 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
4991+ BDC7 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
4992+ BDCB DD 36 06 00      LD (IX+ENT_DELTAX), 0
4993+ BDCF DD 36 07 00      LD (IX+ENT_DELTAY), 0
4994+ BDD3                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
4995+ BDD3                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
4996+ BDD3                  ; lo empuje a un vecino (migracion por knockback).
4997+ BDD3 CD E3 92         CALL MaiGetCurrentScreenId
4998+ BDD6 21 94 90         LD HL, MonsterRoomId
4999+ BDD9 59               LD E, C
5000+ BDDA 16 00            LD D, 0
5001+ BDDC 19               ADD HL, DE
5002+ BDDD 77               LD (HL), A
5003+ BDDE              .smSkip:
5004+ BDDE 11 10 00         LD DE, ENT_SIZE
5005+ BDE1 DD 19            ADD IX, DE
5006+ BDE3 C1               POP BC
5007+ BDE4 0C               INC C
5008+ BDE5 05               DEC B
5009+ BDE6 C2 7D BD         JP NZ, .smLoop
5010+ BDE9 3E 14            LD A, MONSTER_ENTRY_BASE
5011+ BDEB 32 36 BF         LD (TryRespawnMonsters.rmTimer), A
5012+ BDEE C9               RET
5013+ BDEF
5014+ BDEF              ; --- Barajar tablas tipo/color ---
5015+ BDEF              ShuffleMonsterTypes:
5016+ BDEF ED 5F            LD A, R
5017+ BDF1 E6 03            AND 3
5018+ BDF3 C8               RET Z
5019+ BDF4 FE 01            CP 1
5020+ BDF6 28 21            JR Z, .shSwap01
5021+ BDF8 FE 02            CP 2
5022+ BDFA 28 3A            JR Z, .shSwap12
5023+ BDFC 3A 53 BE         LD A, (MonsterTypeTable)
5024+ BDFF 57               LD D, A
5025+ BE00 3A 55 BE         LD A, (MonsterTypeTable + 2)
5026+ BE03 32 53 BE         LD (MonsterTypeTable), A
5027+ BE06 7A               LD A, D
5028+ BE07 32 55 BE         LD (MonsterTypeTable + 2), A
5029+ BE0A 3A 56 BE         LD A, (MonsterColorTable)
5030+ BE0D 57               LD D, A
5031+ BE0E 3A 58 BE         LD A, (MonsterColorTable + 2)
