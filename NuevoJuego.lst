 602+ ED99              ; ==============================================================================
 603+ ED99              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ ED99              ; ==============================================================================
 605+ ED99
 606+ ED99              ; ==============================================================================
 607+ ED99              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ ED99              ; ==============================================================================
 609+ ED99              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ ED99              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ ED99              ; ==============================================================================
 612+ ED99              BuildPlazaScanAddrs:
 613+ ED99                  ; Calcular pixel coords del top-left de la esfera
 614+ ED99 3A 61 8D         LD A, (PlazaClockCharY)
 615+ ED9C 07               RLCA
 616+ ED9D 07               RLCA
 617+ ED9E 07               RLCA
 618+ ED9F 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EDA0 3A 60 8D         LD A, (PlazaClockCharX)
 620+ EDA3 07               RLCA
 621+ EDA4 07               RLCA
 622+ EDA5 07               RLCA
 623+ EDA6 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EDA7 CD 5A 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EDAA
 626+ EDAA DD 21 62 8D      LD IX, PlazaScanAddrs
 627+ EDAE 06 10            LD B, 16
 628+ EDB0              .buildLoop:
 629+ EDB0 DD 75 00         LD (IX+0), L
 630+ EDB3 DD 74 01         LD (IX+1), H
 631+ EDB6 DD 23            INC IX
 632+ EDB8 DD 23            INC IX
 633+ EDBA 05               DEC B
 634+ EDBB C8               RET Z
 635+ EDBC CD C6 9A         CALL NextPixelLine
 636+ EDBF 18 EF            JR .buildLoop
 637+ EDC1
 638+ EDC1              ; ==============================================================================
 639+ EDC1              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EDC1              ; ==============================================================================
 641+ EDC1              ; Llamar cada frame desde el main loop.
 642+ EDC1              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EDC1              ; ==============================================================================
 644+ EDC1              DrawPlazaClock:
 645+ EDC1 3A 5F 8D         LD A, (PlazaClockActive)
 646+ EDC4 B7               OR A
 647+ EDC5 C8               RET Z
 648+ EDC6
 649+ EDC6                  ; --- Calcular posicion actual de las agujas ---
 650+ EDC6 3A 38 E9         LD A, (GameHours)
 651+ EDC9 FE 0C            CP 12
 652+ EDCB 38 02            JR C, .pCalcHourOk
 653+ EDCD D6 0C            SUB 12
 654+ EDCF              .pCalcHourOk:
 655+ EDCF 57               LD D, A                     ; D = display hour (0-11)
 656+ EDD0 3A 37 E9         LD A, (GameMinutes)
 657+ EDD3 1E 00            LD E, 0
 658+ EDD5              .pCalcDiv5:
 659+ EDD5 FE 05            CP 5
 660+ EDD7 38 05            JR C, .pCalcMinOk
 661+ EDD9 D6 05            SUB 5
 662+ EDDB 1C               INC E
 663+ EDDC 18 F7            JR .pCalcDiv5
 664+ EDDE              .pCalcMinOk:
 665+ EDDE                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EDDE
 667+ EDDE                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EDDE 3A 32 EE         LD A, (PlazaLastHour)
 669+ EDE1 BA               CP D
 670+ EDE2 20 05            JR NZ, .pNeedsRedraw
 671+ EDE4 3A 33 EE         LD A, (PlazaLastMin)
 672+ EDE7 BB               CP E
 673+ EDE8 C8               RET Z                       ; sin cambio → no redibujar
 674+ EDE9
 675+ EDE9              .pNeedsRedraw:
 676+ EDE9 7A               LD A, D
 677+ EDEA 32 32 EE         LD (PlazaLastHour), A
 678+ EDED 7B               LD A, E
 679+ EDEE 32 33 EE         LD (PlazaLastMin), A
 680+ EDF1
 681+ EDF1                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EDF1                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EDF1 DD 21 35 8A      LD IX, PlazaClockPixels
 684+ EDF5 FD 21 62 8D      LD IY, PlazaScanAddrs
 685+ EDF9 06 10            LD B, 16
 686+ EDFB              .faceRow:
 687+ EDFB FD 6E 00         LD L, (IY+0)
 688+ EDFE FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EE01 DD 7E 00         LD A, (IX+0)
 690+ EE04 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EE05 77               LD (HL), A                  ; byte izquierdo
 692+ EE06 23               INC HL
 693+ EE07 DD 7E 01         LD A, (IX+1)
 694+ EE0A 2F               CPL
 695+ EE0B 77               LD (HL), A                  ; byte derecho
 696+ EE0C DD 23            INC IX
 697+ EE0E DD 23            INC IX
 698+ EE10 FD 23            INC IY
 699+ EE12 FD 23            INC IY
 700+ EE14 10 E5            DJNZ .faceRow
 701+ EE16
 702+ EE16                  ; --- Aguja de horas ---
 703+ EE16 3A 32 EE         LD A, (PlazaLastHour)
 704+ EE19 21 34 EA         LD HL, HourHandPtrs
 705+ EE1C CD 34 EE         CALL DrawPlazaHandLine
 706+ EE1F
 707+ EE1F                  ; --- Aguja de minutos ---
 708+ EE1F 3A 33 EE         LD A, (PlazaLastMin)
 709+ EE22 21 50 E9         LD HL, MinHandPtrs
 710+ EE25 CD 34 EE         CALL DrawPlazaHandLine
 711+ EE28
 712+ EE28                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EE28 21 70 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EE2B 7E               LD A, (HL)
 715+ EE2C 23               INC HL
 716+ EE2D 66               LD H, (HL)
 717+ EE2E 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EE2F CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EE31 C9               RET
 720+ EE32
 721+ EE32              ; Variables locales reloj plaza
 722+ EE32 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EE33 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EE34
 725+ EE34              ; ==============================================================================
 726+ EE34              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EE34              ; ==============================================================================
 728+ EE34              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EE34              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EE34              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EE34              ; ==============================================================================
 732+ EE34              DrawPlazaHandLine:
 733+ EE34                  ; Indexar en tabla de punteros
 734+ EE34 87               ADD A, A
 735+ EE35 4F               LD C, A
 736+ EE36 06 00            LD B, 0
 737+ EE38 09               ADD HL, BC
 738+ EE39 7E               LD A, (HL)
 739+ EE3A 23               INC HL
 740+ EE3B 66               LD H, (HL)
 741+ EE3C 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EE3D
 743+ EE3D              .pxLoop:
 744+ EE3D 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EE3E B7               OR A
 746+ EE3F C8               RET Z
 747+ EE40
 748+ EE40                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EE40 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EE41 23               INC HL
 751+ EE42 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EE43 23               INC HL
 753+ EE44 56               LD D, (HL)                  ; D = mask
 754+ EE45 23               INC HL
 755+ EE46 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EE47
 757+ EE47                  ; --- Calcular scanLine (0-15) ---
 758+ EE47 78               LD A, B
 759+ EE48 E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EE4A CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EE4C 28 02            JR Z, .pxIsTop
 762+ EE4E C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EE50              .pxIsTop:
 764+ EE50                  ; A = scanLine (0-15)
 765+ EE50
 766+ EE50                  ; --- Calcular colOffset (0 o 1) ---
 767+ EE50 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EE51 79               LD A, C
 769+ EE52 E6 1F            AND $1F                     ; extraer columna
 770+ EE54 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EE56 4F               LD C, A                     ; C = colOffset
 772+ EE57
 773+ EE57                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EE57 7B               LD A, E                     ; A = scanLine
 775+ EE58 87               ADD A, A                    ; *2 (word index)
 776+ EE59 21 62 8D         LD HL, PlazaScanAddrs
 777+ EE5C 85               ADD A, L
 778+ EE5D 6F               LD L, A
 779+ EE5E 30 01            JR NC, .pxNC
 780+ EE60 24               INC H
 781+ EE61              .pxNC:
 782+ EE61 7E               LD A, (HL)
 783+ EE62 23               INC HL
 784+ EE63 66               LD H, (HL)
 785+ EE64 81               ADD A, C                    ; sumar colOffset
 786+ EE65 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EE66
 788+ EE66                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EE66 7A               LD A, D
 790+ EE67 2F               CPL
 791+ EE68 A6               AND (HL)
 792+ EE69 77               LD (HL), A
 793+ EE6A
 794+ EE6A E1               POP HL                      ; restaurar puntero datos
 795+ EE6B 18 D0            JR .pxLoop
 796+ EE6D
