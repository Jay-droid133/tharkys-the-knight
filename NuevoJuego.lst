 536+ E812 32 A5 5F         LD (TownGateTimer), A
 537+ E815 3E 0E            LD A, TGP_BLACK
 538+ E817 32 D0 82         LD (TownGatePhase), A
 539+ E81A C9               RET
 540+ E81B
 541+ E81B              ; ---- Phase 14: pantalla negra hold ----
 542+ E81B              .tgPhBlack:
