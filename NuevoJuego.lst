7408+ C846 28 1E            JR Z, .bfsAppW
7409+ C848 DD 36 06 02      LD (IX+ENT_DELTAX), MONSTER_SPEED
7410+ C84C DD 36 07 00      LD (IX+ENT_DELTAY), 0
7411+ C850 18 1C            JR .bfsAppMove
7412+ C852              .bfsAppN:
7413+ C852 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7414+ C856 DD 36 07 FE      LD (IX+ENT_DELTAY), -MONSTER_SPEED
7415+ C85A 18 12            JR .bfsAppMove
7416+ C85C              .bfsAppS:
7417+ C85C DD 36 06 00      LD (IX+ENT_DELTAX), 0
7418+ C860 DD 36 07 02      LD (IX+ENT_DELTAY), MONSTER_SPEED
7419+ C864 18 08            JR .bfsAppMove
