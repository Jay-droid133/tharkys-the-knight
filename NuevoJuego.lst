 104  6A13
 105  6A13                  ; --- Rutinas de paginacion (paging.asm) ---
 106  6A13                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 107  6A13                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 108  6A13                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 109  6A13                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 110  6A13                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 111  6A13                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 112  6A13                  ; criterio (siempre visible) pero contended.
 113  6A13                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 114  6A13                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 115  6A13                  ; el inner loop, asi que el overhead es invisible.
 116  6A13                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 6A13              ; ==============================================================================
   2+ 6A13              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6A13              ; ==============================================================================
   4+ 6A13              ; Port $7FFD (write-only):
   5+ 6A13              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6A13              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6A13              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6A13              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6A13              ;
  10+ 6A13              ; Bancos disponibles:
  11+ 6A13              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6A13              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6A13              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6A13              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6A13              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6A13              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6A13              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6A13              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6A13              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6A13              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6A13              ; ==============================================================================
  22+ 6A13
  23+ 6A13              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6A13              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6A13
  26+ 6A13              ; ==============================================================================
  27+ 6A13              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6A13              ; ==============================================================================
  29+ 6A13              ; Entrada: A = banco (0-7)
  30+ 6A13              ; Preserva: HL, DE, IX, IY
  31+ 6A13              ; Destruye: A, BC
  32+ 6A13              ; ==============================================================================
  33+ 6A13              PageBankSlot3:
  34+ 6A13 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6A15 47               LD B, A                     ; guardar banco nuevo
  36+ 6A16 3A E7 90         LD A, (CurrentPaging)
  37+ 6A19 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6A1B B0               OR B                        ; poner nuevo banco
  39+ 6A1C 32 E7 90         LD (CurrentPaging), A
  40+ 6A1F 01 FD 7F         LD BC, $7FFD
  41+ 6A22 ED 79            OUT (C), A
  42+ 6A24 C9               RET
  43+ 6A25
  44+ 6A25              ; ==============================================================================
  45+ 6A25              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6A25              ; ==============================================================================
  47+ 6A25              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6A25              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6A25              ; ==============================================================================
  50+ 6A25              InitPaging:
  51+ 6A25 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6A27 32 E7 90         LD (CurrentPaging), A
  53+ 6A2A 01 FD 7F         LD BC, $7FFD
  54+ 6A2D ED 79            OUT (C), A
  55+ 6A2F C9               RET
  56+ 6A30
  57+ 6A30              ; ==============================================================================
  58+ 6A30              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6A30              ; ==============================================================================
  60+ 6A30              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6A30              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6A30              ;      Paginacion restaurada a bank 0.
  63+ 6A30              ; Destruye: A, BC, DE, HL
  64+ 6A30              ;
  65+ 6A30              ; Formato del room en FUENTE (variable-length):
  66+ 6A30              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6A30              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6A30              ;   terminador:                  DEFB $FF
  69+ 6A30              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6A30              ;
  71+ 6A30              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6A30              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6A30              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6A30              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6A30              ; ==============================================================================
  76+ 6A30              LoadRoomToBuffer:
  77+ 6A30                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 6A30                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 6A30                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 6A30                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 6A30                  ;
  82+ 6A30                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 6A30                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 6A30                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 6A30                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 6A30 F3               DI
  87+ 6A31                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 6A31 3A E7 90         LD A, (CurrentPaging)
  89+ 6A34 E6 F8            AND $F8
  90+ 6A36 F6 01            OR 1
  91+ 6A38 32 E7 90         LD (CurrentPaging), A
  92+ 6A3B 01 FD 7F         LD BC, $7FFD
  93+ 6A3E ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 6A40                  ; --- Copy + decompress loop ---
  95+ 6A40                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 6A40                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 6A40 11 9A 85         LD DE, CurrentScreenBuffer
  98+ 6A43              .lrbLoop:
  99+ 6A43 7E               LD A, (HL)                      ; id
 100+ 6A44 12               LD (DE), A
 101+ 6A45 23               INC HL
 102+ 6A46 13               INC DE
 103+ 6A47 FE FF            CP $FF                          ; terminador?
 104+ 6A49 28 1B            JR Z, .lrbDone
 105+ 6A4B                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 6A4B                  ; al buffer escribimos x limpio (AND $7F).
 107+ 6A4B 7E               LD A, (HL)
 108+ 6A4C 23               INC HL
 109+ 6A4D 47               LD B, A                         ; B = x raw (con flag)
 110+ 6A4E E6 7F            AND $7F
 111+ 6A50 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 6A51 13               INC DE
 113+ 6A52                  ; Copiar y
 114+ 6A52 7E               LD A, (HL)
 115+ 6A53 12               LD (DE), A
 116+ 6A54 23               INC HL
 117+ 6A55 13               INC DE
 118+ 6A56                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 6A56 CB 78            BIT 7, B
 120+ 6A58 28 06            JR Z, .lrbNoTint
 121+ 6A5A 7E               LD A, (HL)                      ; v desde source
 122+ 6A5B 23               INC HL
 123+ 6A5C 12               LD (DE), A
 124+ 6A5D 13               INC DE
 125+ 6A5E 18 E3            JR .lrbLoop
 126+ 6A60              .lrbNoTint:
 127+ 6A60 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 6A62 12               LD (DE), A
 129+ 6A63 13               INC DE
 130+ 6A64 18 DD            JR .lrbLoop
 131+ 6A66              .lrbDone:
 132+ 6A66                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 6A66 3A E7 90         LD A, (CurrentPaging)
 134+ 6A69 E6 F8            AND $F8                         ; bank 0
 135+ 6A6B 32 E7 90         LD (CurrentPaging), A
 136+ 6A6E 01 FD 7F         LD BC, $7FFD
 137+ 6A71 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 6A73                  ; Restaurar interrupciones si Inicio ya termino
 139+ 6A73 3A 4A 81         LD A, (StartupComplete)
 140+ 6A76 B7               OR A
 141+ 6A77 C8               RET Z                           ; aun en Inicio -> dejar DI
 142+ 6A78 FB               EI
 143+ 6A79 C9               RET
