 194+ 64B1              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 195+ 64B1              ; ==============================================================================
 196+ 64B1              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 197+ 64B1              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 198+ 64B1              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 199+ 64B1              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 200+ 64B1              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 201+ 64B1              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 202+ 64B1              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 203+ 64B1              ; ==============================================================================
 204+ 64B1              StatueIdTable:
 205+ 64B1 D5               DEFB 213        ; type idx 0: statue_zombi
 206+ 64B2 E1               DEFB 225        ; type idx 1: statue_skeleton
 207+ 64B3 D3               DEFB 211        ; type idx 2: statue_ghost
