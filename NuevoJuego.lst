 504  E39A                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E39A              ; ==============================================================================
   2+ E39A              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E39A              ; ==============================================================================
   4+ E39A              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E39A              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E39A              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E39A              ; ==============================================================================
   8+ E39A
   9+ E39A              ; --- Constantes ---
  10+ E39A              NUM_TIME_MOMENTS    EQU 7
  11+ E39A
  12+ E39A              ; --- Variables ---
  13+ E39A 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E39B 36 E8        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E39D 36 E8        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E39F 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E3A0 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E3A1 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E3A2
  20+ E3A2              ; ==============================================================================
  21+ E3A2              ; SetTimeOfDay - Cambia el momento del dia
  22+ E3A2              ; ==============================================================================
  23+ E3A2              ; Entrada: A = momento (0-6)
  24+ E3A2              ; ==============================================================================
  25+ E3A2              SetTimeOfDay:
  26+ E3A2 32 9A E3         LD (CurrentTimeOfDay), A
  27+ E3A5
  28+ E3A5                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E3A5 FE 04            CP 4
  30+ E3A7 20 06            JR NZ, .notNewCycle
  31+ E3A9 21 21 BD         LD HL, DayCycleCount
  32+ E3AC 34               INC (HL)
  33+ E3AD 18 04            JR .skipBellsReset
  34+ E3AF              .notNewCycle:
  35+ E3AF                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E3AF                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E3AF                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E3AF AF               XOR A
  39+ E3B0 32 BB 82         LD (BellsTriggered), A
  40+ E3B3              .skipBellsReset:
  41+ E3B3 3A 9A E3         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E3B6
  43+ E3B6                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E3B6 FE 04            CP 4
  45+ E3B8 28 24            JR Z, .bellsFirst
  46+ E3BA
  47+ E3BA                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E3BA FE 05            CP 5
  49+ E3BC 20 0D            JR NZ, .noScareMon
  50+ E3BE CD 3B BD         CALL ScareAllMonsters
  51+ E3C1 CD 64 FB         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E3C4                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E3C4                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E3C4                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E3C4                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E3C4 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E3C6 CD BF 99         CALL StartMusic
  58+ E3C9 18 07            JR .noKillMon
  59+ E3CB              .noScareMon:
  60+ E3CB                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E3CB FE 06            CP 6
  62+ E3CD 20 03            JR NZ, .noKillMon
  63+ E3CF CD C4 BC         CALL KillAllActiveMonsters
  64+ E3D2              .noKillMon:
  65+ E3D2
  66+ E3D2                  ; Actualizar tablas de remap y tabla de nasties
  67+ E3D2 CD 07 E4         CALL UpdateRemapTables
  68+ E3D5 CD 24 BD         CALL UpdateNastyTable
  69+ E3D8
  70+ E3D8                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E3D8 3E 01            LD A, 1
  72+ E3DA 32 16 83         LD (AttrsDirty), A
  73+ E3DD C9               RET
  74+ E3DE
  75+ E3DE              .bellsFirst:
  76+ E3DE                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E3DE                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E3DE                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E3DE                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E3DE                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E3DE CD 24 BD         CALL UpdateNastyTable
  82+ E3E1                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E3E1                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E3E1 3A BB 82         LD A, (BellsTriggered)
  85+ E3E4 B7               OR A
  86+ E3E5 C0               RET NZ
  87+ E3E6 3E 01            LD A, 1
  88+ E3E8 32 BB 82         LD (BellsTriggered), A
  89+ E3EB CD DA FA         CALL StartBellChimes
  90+ E3EE C9               RET
  91+ E3EF
  92+ E3EF              ; ==============================================================================
  93+ E3EF              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E3EF              ; ==============================================================================
  95+ E3EF              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E3EF              ;   - Salta reloj a 00:00.
  97+ E3EF              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E3EF              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E3EF              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E3EF              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E3EF              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E3EF              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E3EF              ;     pero ya esta en N2 -> no-op visual.
 104+ E3EF              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E3EF              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E3EF              ;
 107+ E3EF              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E3EF              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E3EF              ; aqui no re-dispara nada.
 110+ E3EF              ; ==============================================================================
 111+ E3EF              TriggerChurchMidnight:
 112+ E3EF 3A BB 82         LD A, (BellsTriggered)
 113+ E3F2 B7               OR A
 114+ E3F3 C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E3F4 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E3F6 CD E6 EB         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E3F9 3E 04            LD A, 4
 118+ E3FB CD A2 E3         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E3FE                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E3FE                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E3FE                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E3FE CD 07 E4         CALL UpdateRemapTables
 123+ E401 3E 01            LD A, 1
 124+ E403 32 16 83         LD (AttrsDirty), A
 125+ E406 C9               RET
 126+ E407
 127+ E407              ; ==============================================================================
 128+ E407              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 129+ E407              ; ==============================================================================
 130+ E407              UpdateRemapTables:
 131+ E407 3A 9A E3         LD A, (CurrentTimeOfDay)
 132+ E40A 21 0A E8         LD HL, RemapTablePtrs
 133+ E40D 5F               LD E, A
 134+ E40E 16 00            LD D, 0
 135+ E410 19               ADD HL, DE
 136+ E411 19               ADD HL, DE
 137+ E412 5E               LD E, (HL)
 138+ E413 23               INC HL
 139+ E414 56               LD D, (HL)
 140+ E415 ED 53 9B E3      LD (CurrentRemapTable), DE
