   1+ 0000              ; ==============================================================================
   2+ 0000              ; MACROS ÚTILES PARA EL DESARROLLO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000                  ; Marco para pintar un color rápidamente en la pantalla
   6+ 0000                  MACRO SET_COLOR color, address
   7+ 0000 ~                    LD A, color
   8+ 0000 ~                    LD HL, address
   9+ 0000 ~                    LD (HL), A
  10+ 0000                  ENDM
  11+ 0000
  12+ 0000                  ; Macro estándar para sumar A a HL
  13+ 0000                  MACRO ADD_HL_A
  14+ 0000 ~                    ADD A, L
  15+ 0000 ~                    LD L, A
  16+ 0000 ~                    ADC A, H
  17+ 0000 ~                    SUB L
  18+ 0000 ~                    LD H, A
  19+ 0000                  ENDM
  20+ 0000
# file closed: macros.asm
  11  0000
  12  0000                  ; Origen del programa en RAM
  13  0000                  ORG ORIGIN_ADDRESS
  14  8000
  15  8000              Inicio:
  16  8000 F3               DI                      ; Deshabilitar interrupciones
  17  8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  18  8004
  19  8004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  20  8004 CD F3 8C         CALL InitPaging
  21  8007 CD 6D E2         CALL AY_Init                ; silenciar AY al arrancar
  22  800A
  23  800A                  ; Configuración inicial (Borde negro, etc.)
  24  800A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  25  800C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  26  800E 32 DD 8C         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  27  8011
  28  8011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  29  8011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  30  8011 21 00 40         LD HL, SCREEN_BASE
  31  8014 11 01 40         LD DE, SCREEN_BASE + 1
  32  8017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  33  801A AF               XOR A                   ; A = 0
  34  801B 77               LD (HL), A
  35  801C ED B0            LDIR
  36  801E
  37  801E                  ; Inicializar sistema de pantallas
  38  801E CD 23 AE         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  39  8021 CD 0B 92         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  40  8024 CD 36 D6         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  41  8027 CD 98 A9         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  42  802A                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  43  802A
  44  802A ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  45  802C FB               EI                      ; Habilitar interrupciones
  46  802D
  47  802D              ; ==============================================================================
  48  802D              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
  49  802D              ; ==============================================================================
  50  802D              ; El original NO separa render de logica. Cada entidad hace todo junto:
  51  802D              ;   erase viejo → AI/movimiento → draw nuevo
  52  802D              ; Player: siempre se procesa completo cada frame (tras HALT).
  53  802D              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
  54  802D              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
  55  802D              ; ==============================================================================
  56  802D              MainLoop:
  57  802D                  ; --- Marcar inicio de frame (referencia para sync al final) ---
  58  802D 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
  59  8030 32 9B 80         LD (.frameStart), A
  60  8033
  61  8033                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
  62  8033 CD 67 AE         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
  63  8036 CD F3 AF         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
  64  8039 CD A6 B2         CALL RemapScreenAttrs       ; Remap attrs si cambio de fase (~fast)
  65  803C
  66  803C                  ; === PLAYER: siempre cada frame, completo (erase+logic+draw) ===
  67  803C CD 21 A6         CALL EraseDeadSprites       ; Cleanup puff terminadas (~20T normal)
  68  803F CD 71 91         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
  69  8042 CD 76 92         CALL ProcessPlayer          ; Erase + logic + draw player (todo junto)
  70  8045 CD 0D 9C         CALL CheckWellPickup        ; Recuperar salud/stamina si pisa un pozo
  71  8048 CD 91 B4         CALL CheckPickupCollect     ; Detectar pickups (borrado diferido al siguiente frame)
  72  804B
  73  804B                  ; Limpiar flag de pantalla recien dibujada (tras renderizar player)
  74  804B AF               XOR A
  75  804C 32 D2 81         LD (ScreenJustRedrawn), A
  76  804F
  77  804F                  ; === ENEMIGOS: round-robin, erase+logic+draw por entidad ===
  78  804F CD 90 93         CALL ProcessEnemies         ; Round-robin: hasta MAX_ENEMIES_PER_FRAME
  79  8052
  80  8052                  ; === SISTEMAS GLOBALES ===
  81  8052 CD 3F A7         CALL TrySpawnNasty          ; Spawn check (tiene su propio timer)
  82  8055 CD 89 AA         CALL TryRespawnMonsters     ; Rellenar slots monster vacios (siempre 3)
  83  8058 CD E9 AB         CALL CheckPlayerEnemyCollision ; Colision player vs enemigos
  84  805B CD B9 DD         CALL DrawClockHUD           ; Reloj: cara + agujas (HUD fijo, no flicker)
  85  805E CD 40 E0         CALL DrawPlazaClock         ; Reloj de plaza (si existe en esta room)
  86  8061 CD DE DE         CALL DrawHealthStaminaHUD   ; Barras salud/stamina en decoraciones
  87  8064 CD BC D6         CALL DrawSwordModeHUD       ; Debug: indicador modo espada
  88  8067 CD F3 D7         CALL DrawDayCycleHUD        ; Indicador de dia (D1, D2, D3...)
  89  806A CD 79 D8         CALL DrawPlayerSpeedHUD     ; Debug: velocidad player (fila 0, col 2)
  90  806D CD 89 D8         CALL DrawEnemySpeedHUD      ; Debug: velocidad nasties (V1, V2...)
  91  8070 CD 5F DD         CALL UpdateGameClock        ; Avanzar reloj de juego
  92  8073 CD B1 A8         CALL UpdateEnemySpeed       ; Ajustar velocidad nasties segun ciclo
  93  8076 CD F4 E1         CALL UpdateBellChimes       ; Campanadas de medianoche (si activas)
  94  8079 CD 25 E2         CALL UpdateBellsDoneTimer   ; Cadena post-campanadas: ventanas off → monster spawn
  95  807C CD 3B E3         CALL AY_UpdateBell          ; Decay manual del volumen de la campana
  96  807F CD B2 A5         CALL UpdateScareTimer       ; Countdown pausa+huida (bells/dawn)
  97  8082 CD 5B D6         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
  98  8085
  99  8085                  ; Incrementar contador de frames
 100  8085 3A 9C 80         LD A, (GameFrameCounter)
 101  8088 3C               INC A
 102  8089 32 9C 80         LD (GameFrameCounter), A
 103  808C
 104  808C                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 105  808C              .frameSync:
 106  808C 76               HALT                        ; Dormir hasta siguiente interrupt
 107  808D 3A 9B 80         LD A, (.frameStart)
 108  8090 47               LD B, A
 109  8091 3A 78 5C         LD A, ($5C78)
 110  8094 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 111  8095 FE 02            CP 2
