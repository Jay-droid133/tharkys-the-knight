5783+ BFDE 3E 06            LD A, 6                         ; 6 frames a 25fps ~0.24s (era 12 a 50fps)
5784+ BFE0 32 30 C0         LD (PlayerHitTimer), A
5785+ BFE3                  ; Si nasty destructible → muere al tocar al player
5786+ BFE3 DD CB 0B 56      BIT ENTF_DESTRUCT, (IX+ENT_FLAGS)
5787+ BFE7 28 1C            JR Z, .playerHitSFX
5788+ BFE9 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5789+ BFED DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5790+ BFF1 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5791+ BFF5 DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5792+ BFF9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5793+ BFFD DD 36 07 00      LD (IX+ENT_DELTAY), 0
5794+ C001 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
