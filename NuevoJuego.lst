 264+ EB79 32 CF 82         LD (PlayerSpeedFight), A
 265+ EB7C 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 266+ EB7F 22 D0 82         LD (SpeedBuffTimer), HL
 267+ EB82 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 268+ EB84 32 D2 82         LD (SpeedBuffType), A
 269+ EB87 3E 45            LD A, SPEED_BUFF_RAYO_ATTR
 270+ EB89 32 99 81         LD (EntityTable + ENT_ATTR), A
 271+ EB8C C9               RET
