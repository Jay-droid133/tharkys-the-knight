7207+ C728              ; ==============================================================================
7208+ C728              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7209+ C728              ; ==============================================================================
7210+ C728              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7211+ C728              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7212+ C728              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7213+ C728              ; el primer paso (N/S/W/E) desde el inicio.
7214+ C728              ;
7215+ C728              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7216+ C728              ; consistente con CheckEnemyCollision en cell-aligned positions).
7217+ C728              ;
7218+ C728              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7219+ C728              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7220+ C728              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7221+ C728              ; paso pero permite llegar a una celda mas profunda con dist menor).
7222+ C728              ;
7223+ C728              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7224+ C728              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7225+ C728              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7226+ C728              ;
7227+ C728              ; IX = SLOT_DEATH al entrar.
7228+ C728              ; ==============================================================================
7229+ C728              DeathBfsRescue:
7230+ C728                  ; --- Celda inicial = celda actual de Death ---
7231+ C728 DD 7E 03         LD A, (IX+ENT_POSX)
7232+ C72B 0F               RRCA
7233+ C72C 0F               RRCA
7234+ C72D 0F               RRCA
7235+ C72E E6 1F            AND $1F
7236+ C730 32 74 5F         LD (DBfsCurCx), A
7237+ C733 DD 7E 04         LD A, (IX+ENT_POSY)
7238+ C736 D6 10            SUB SCREEN_MIN_Y
7239+ C738 0F               RRCA
7240+ C739 0F               RRCA
7241+ C73A 0F               RRCA
7242+ C73B E6 1F            AND $1F
7243+ C73D 32 75 5F         LD (DBfsCurCy), A
7244+ C740                  ; --- Celda del player ---
7245+ C740 3A A1 81         LD A, (EntityTable + ENT_POSX)
7246+ C743 0F               RRCA
7247+ C744 0F               RRCA
7248+ C745 0F               RRCA
7249+ C746 E6 1F            AND $1F
7250+ C748 32 72 5F         LD (DBfsPlayerCx), A
7251+ C74B 3A A2 81         LD A, (EntityTable + ENT_POSY)
7252+ C74E D6 10            SUB SCREEN_MIN_Y
7253+ C750 0F               RRCA
7254+ C751 0F               RRCA
7255+ C752 0F               RRCA
7256+ C753 E6 1F            AND $1F
7257+ C755 32 73 5F         LD (DBfsPlayerCy), A
7258+ C758                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7259+ C758 21 FF 5E         LD HL, DBfsQueue
7260+ C75B 22 6B 5F         LD (DBfsQHead), HL
7261+ C75E 3A 74 5F         LD A, (DBfsCurCx)
7262+ C761 77               LD (HL), A
7263+ C762 23               INC HL
7264+ C763 3A 75 5F         LD A, (DBfsCurCy)
7265+ C766 77               LD (HL), A
7266+ C767 23               INC HL
7267+ C768 36 FF            LD (HL), MAI_DIR_NONE
7268+ C76A 23               INC HL
7269+ C76B 36 00            LD (HL), 0
7270+ C76D 23               INC HL
7271+ C76E 22 6D 5F         LD (DBfsQTail), HL
7272+ C771                  ; Best inicial: ningun candidato
7273+ C771 3E FF            LD A, MAI_DIR_NONE
7274+ C773 32 6F 5F         LD (DBfsBestDir), A
7275+ C776 AF               XOR A
7276+ C777 32 70 5F         LD (DBfsBestDepth), A
7277+ C77A 3E FF            LD A, $FF
7278+ C77C 32 71 5F         LD (DBfsBestManh), A
