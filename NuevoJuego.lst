 280+ E49B 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 281+ E49E
 282+ E49E              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 283+ E49E              DrawNoclipHUD:
