4063+ B927              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
4064+ B927              ; ==============================================================================
4065+ B927              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
4066+ B927              ; ENT_DIR contiene el ANIMBASE real del enemigo.
