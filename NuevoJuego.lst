 500+ 8ACE C2 11 8B         JP NZ, .peSpawnFresh
 501+ 8AD1
 502+ 8AD1 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
 503+ 8AD4 6F               LD L, A
 504+ 8AD5 26 00            LD H, 0
 505+ 8AD7 29               ADD HL, HL
 506+ 8AD8 11 98 AD         LD DE, SpriteFrameTable
 507+ 8ADB 19               ADD HL, DE
 508+ 8ADC 5E               LD E, (HL)
 509+ 8ADD 23               INC HL
 510+ 8ADE 56               LD D, (HL)
 511+ 8ADF ED 53 30 8B      LD (OldSprAddr), DE
 512+ 8AE3 DD 7E 0D         LD A, (IX+ENT_OLDY)
 513+ 8AE6 57               LD D, A
 514+ 8AE7 DD 7E 0C         LD A, (IX+ENT_OLDX)
 515+ 8AEA 5F               LD E, A
 516+ 8AEB DD E5            PUSH IX
 517+ 8AED DD 2A 30 8B      LD IX, (OldSprAddr)
 518+ 8AF1 CD 47 84         CALL DrawSprite
