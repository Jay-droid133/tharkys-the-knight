2587+ B126 ED 44            NEG
2588+ B128 DD 77 07         LD (IX+ENT_DELTAY), A
2589+ B12B              .eYDone:
2590+ B12B
2591+ B12B                  ; --- Animacion: seleccionar par de frames segun direccion horizontal ---
2592+ B12B                  ; DELTAX >= 0 → base+0,base+1 (derecha). DELTAX < 0 → base+2,base+3 (izquierda).
2593+ B12B DD 7E 06         LD A, (IX+ENT_DELTAX)
2594+ B12E 0E 00            LD C, ENEMY_FRAMES_RIGHT    ; C = offset de direccion (0 = derecha)
2595+ B130 CB 7F            BIT 7, A
2596+ B132 28 02            JR Z, .eAnimDir
2597+ B134 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2598+ B136              .eAnimDir:
2599+ B136 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2600+ B139 20 27            JR NZ, .eAnimDone
2601+ B13B 3A 9D 90         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2602+ B13E 47               LD B, A
2603+ B13F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2604+ B142 FE 34            CP SPRID_ENEMY_5
2605+ B144 78               LD A, B
2606+ B145 20 06            JR NZ, .eAnimDelaySet
2607+ B147 CB 3F            SRL A                               ; Rata: mitad del delay
2608+ B149 B7               OR A
2609+ B14A 20 01            JR NZ, .eAnimDelaySet
2610+ B14C 3C               INC A                               ; Minimo 1
2611+ B14D              .eAnimDelaySet:
2612+ B14D DD 77 09         LD (IX+ENT_ANIMTIMER), A
2613+ B150                  ; Avanzar frame dentro del par (2 frames por direccion)
2614+ B150 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2615+ B153 47               LD B, A
2616+ B154 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2617+ B157                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2618+ B157 E6 01            AND 1
2619+ B159 20 03            JR NZ, .eFrameReset
2620+ B15B                  ; Frame 0 del par → avanzar a frame 1
2621+ B15B 04               INC B
2622+ B15C 18 01            JR .eFrameSet
2623+ B15E              .eFrameReset:
2624+ B15E                  ; Frame 1 del par → volver a frame 0
2625+ B15E 05               DEC B
2626+ B15F              .eFrameSet:
2627+ B15F DD 70 00         LD (IX+ENT_SPRITEID), B
2628+ B162              .eAnimDone:
