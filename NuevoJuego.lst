 189+ DA89                  ; --- High nibble doubled ---
 190+ DA89 E6 F0            AND $F0
 191+ DA8B 0F               RRCA
 191+ DA8C 0F             RRCA
 191+ DA8D 0F             RRCA
 191+ DA8E 0F             RRCA       ; high nibble en posición baja
 192+ DA8F 5F               LD E, A
 193+ DA90 16 00            LD D, 0
 194+ DA92 21 1D DB         LD HL, NibbleDoubleLUT
 195+ DA95 19               ADD HL, DE
 196+ DA96 7E               LD A, (HL)                      ; A = high doubled
 197+ DA97 2A E2 DA         LD HL, (.dpxDstTop)
 198+ DA9A 77               LD (HL), A
 199+ DA9B 23               INC HL
 200+ DA9C 22 E2 DA         LD (.dpxDstTop), HL
 201+ DA9F 2A E4 DA         LD HL, (.dpxDstBot)
 202+ DAA2 77               LD (HL), A
 203+ DAA3 23               INC HL
 204+ DAA4 22 E4 DA         LD (.dpxDstBot), HL
 205+ DAA7
 206+ DAA7                  ; --- Low nibble doubled ---
 207+ DAA7 C1               POP BC                          ; recover src byte (en C)
 208+ DAA8 C5               PUSH BC
 209+ DAA9 79               LD A, C
 210+ DAAA E6 0F            AND $0F
 211+ DAAC 5F               LD E, A
 212+ DAAD 16 00            LD D, 0
 213+ DAAF 21 1D DB         LD HL, NibbleDoubleLUT
 214+ DAB2 19               ADD HL, DE
 215+ DAB3 7E               LD A, (HL)                      ; A = low doubled
 216+ DAB4 2A E2 DA         LD HL, (.dpxDstTop)
 217+ DAB7 77               LD (HL), A
 218+ DAB8 23               INC HL
 219+ DAB9 22 E2 DA         LD (.dpxDstTop), HL
 220+ DABC 2A E4 DA         LD HL, (.dpxDstBot)
 221+ DABF 77               LD (HL), A
 222+ DAC0 23               INC HL
 223+ DAC1 22 E4 DA         LD (.dpxDstBot), HL
 224+ DAC4
 225+ DAC4 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 226+ DAC5 E1               POP HL                          ; src ptr
 227+ DAC6 10 BC            DJNZ .dpxByteLoop
 228+ DAC8
 229+ DAC8                  ; Avanzar a siguiente src row
 230+ DAC8 22 E0 DA         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 231+ DACB 3A DF DA         LD A, (.dpxDstY)
 232+ DACE C6 02            ADD A, 2                        ; 2 dst rows por 1 src row
 233+ DAD0 32 DF DA         LD (.dpxDstY), A
