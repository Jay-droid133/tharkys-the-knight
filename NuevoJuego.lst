 581+ 73CD              ; ==============================================================================
 582+ 73CD              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
 583+ 73CD              ; ==============================================================================
 584+ 73CD              ; prev ← cur (data de la sala que dejamos).
 585+ 73CD              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
 586+ 73CD              ;
 587+ 73CD              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
 588+ 73CD              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
 589+ 73CD              ; ==============================================================================
 590+ 73CD              .urpZeroAndRotate:
 591+ 73CD AF               XOR A
