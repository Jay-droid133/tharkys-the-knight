 104+ 9D8D 32 0C 9E         LD (.posY), A
 105+ 9D90 57               LD D, A
 106+ 9D91              .clipTopDone:
 107+ 9D91                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9D91 3A 0C 9E         LD A, (.posY)
 109+ 9D94 47               LD B, A
 110+ 9D95 3A 0E 9E         LD A, (.heightSave)
 111+ 9D98 80               ADD A, B                    ; A = Y + height
 112+ 9D99 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9D9B FE C0            CP 192
 114+ 9D9D 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9D9F              .clipBot:
 116+ 9D9F                  ; Reducir altura: new_height = 192 - Y
 117+ 9D9F 3E C0            LD A, 192
 118+ 9DA1 90               SUB B                       ; A = 192 - Y
 119+ 9DA2 C8               RET Z
 120+ 9DA3 D8               RET C
