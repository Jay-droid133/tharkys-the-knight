 643+ DFEA 47               LD B, A
 644+ DFEB CB 3F            SRL A
 645+ DFED CB 3F            SRL A
 646+ DFEF CB 3F            SRL A
 647+ DFF1 CB 3F            SRL A
 648+ DFF3 FE 0A            CP 10
 649+ DFF5 38 04            JR C, .dzcHiDigit
 650+ DFF7 C6 37            ADD A, 'A' - 10
 651+ DFF9 18 02            JR .dzcHiOut
 652+ DFFB              .dzcHiDigit:
 653+ DFFB C6 30            ADD A, '0'
 654+ DFFD              .dzcHiOut:
