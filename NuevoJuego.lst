 379+ EE9B              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EE9B              ; ==============================================================================
 381+ EE9B              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EE9B              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EE9B              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EE9B              ; ==============================================================================
 385+ EE9B              DrawHealthStaminaHUD:
 386+ EE9B                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EE9B 3A 6B B6         LD A, (PlayerHealth)
 388+ EE9E 4F               LD C, A                             ; C = nivel (0-16)
 389+ EE9F 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EEA2 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EEA5 DD 21 81 EA      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EEA9 FD 21 F2 EA      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EEAD CD 13 EF         CALL .drawBar
 394+ EEB0
 395+ EEB0                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EEB0 3A 6C B6         LD A, (PlayerStamina)
