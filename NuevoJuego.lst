3028+ AFC1              .moKbClampDone:
3029+ AFC1                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
3030+ AFC1                  ;
3031+ AFC1                  ; Doble comportamiento:
3032+ AFC1                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
3033+ AFC1                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
3034+ AFC1                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
3035+ AFC1                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
3036+ AFC1                  ;   y lo activa).
3037+ AFC1                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
3038+ AFC1                  ;   El monster queda en destino (memoria) hasta que el player visite.
3039+ AFC1                  ;
3040+ AFC1                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
3041+ AFC1                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
3042+ AFC1 DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
3043+ AFC4 32 05 B0         LD (.moKbSavedDir), A
3044+ AFC7 3E 01            LD A, 1
3045+ AFC9 32 50 B3         LD (MonsterKbDespawn), A
3046+ AFCC                  ; Calcular slot (0-2) en E, D=0
3047+ AFCC DD E5            PUSH IX
3048+ AFCE E1               POP HL
3049+ AFCF 11 A4 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
3050+ AFD2 B7               OR A
3051+ AFD3 ED 52            SBC HL, DE
3052+ AFD5 CB 3D            SRL L
3053+ AFD7 CB 3D            SRL L
3054+ AFD9 CB 3D            SRL L
3055+ AFDB CB 3D            SRL L
3056+ AFDD 5D               LD E, L
3057+ AFDE 16 00            LD D, 0
3058+ AFE0                  ; Clear MAI_FLAG_LEAVING
3059+ AFE0 21 8C 8D         LD HL, MonsterAiFlags
3060+ AFE3 19               ADD HL, DE
3061+ AFE4 7E               LD A, (HL)
3062+ AFE5 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
3063+ AFE7 77               LD (HL), A
3064+ AFE8                  ; MonsterRoomId[slot] = neighbor_id (destino)
3065+ AFE8 3A 05 B0         LD A, (.moKbSavedDir)
3066+ AFEB CD B4 8E         CALL MaiGetNeighborScreenId
3067+ AFEE 21 80 8D         LD HL, MonsterRoomId
3068+ AFF1 19               ADD HL, DE
3069+ AFF2 77               LD (HL), A
3070+ AFF3                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
3071+ AFF3 3A 05 B0         LD A, (.moKbSavedDir)
3072+ AFF6 CD 13 8F         CALL MaiDirToEntrySide
3073+ AFF9 21 86 8D         LD HL, MonsterEntryBorder
3074+ AFFC 19               ADD HL, DE
3075+ AFFD 77               LD (HL), A
3076+ AFFE                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
3077+ AFFE 21 52 B3         LD HL, MonsterReturnTimer
3078+ B001 19               ADD HL, DE
3079+ B002 36 19            LD (HL), MAI_LINGER_PUSHED
3080+ B004 C9               RET
