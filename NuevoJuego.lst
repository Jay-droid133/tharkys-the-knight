 727+ 63D2              ; ==============================================================================
 728+ 63D2              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 729+ 63D2              ; ==============================================================================
 730+ 63D2              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 731+ 63D2              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 732+ 63D2              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 733+ 63D2              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 734+ 63D2              ; ==============================================================================
 735+ 63D2              TownGatePlayerSlideErase:
 736+ 63D2 DD 21 C7 80      LD IX, EntityTable
 737+ 63D6 DD E5            PUSH IX
 738+ 63D8 CD F3 A7         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 739+ 63DB DD E1            POP IX
 740+ 63DD 3A 42 90         LD A, (CurrentPaging)
 741+ 63E0 E6 F8            AND $F8
 742+ 63E2 F6 06            OR 6
 743+ 63E4 32 42 90         LD (CurrentPaging), A
 744+ 63E7 01 FD 7F         LD BC, $7FFD
 745+ 63EA ED 79            OUT (C), A
 746+ 63EC FD 2A 7B A7      LD IY, (OldSprAddr)
 747+ 63F0 DD 56 0D         LD D, (IX+ENT_OLDY)
 748+ 63F3 DD 7E 0C         LD A, (IX+ENT_OLDX)
 749+ 63F6 5F               LD E, A
 750+ 63F7 CD 9E 63         CALL TownGatePlayerXOR_BiClip
 751+ 63FA 3A 42 90         LD A, (CurrentPaging)
 752+ 63FD E6 F8            AND $F8
 753+ 63FF 32 42 90         LD (CurrentPaging), A
 754+ 6402 01 FD 7F         LD BC, $7FFD
 755+ 6405 ED 79            OUT (C), A
 756+ 6407 C9               RET
 757+ 6408
 758+ 6408              TownGatePlayerSlideDraw:
 759+ 6408 DD 21 C7 80      LD IX, EntityTable
 760+ 640C DD E5            PUSH IX
