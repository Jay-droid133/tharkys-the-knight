   2+ 6277              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6277              ; ==============================================================================
   4+ 6277              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6277              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6277              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6277              ;
   8+ 6277              ; Esquema de fases:
   9+ 6277              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6277              ;   2 ARM_IN       arm aparece, pausa
  11+ 6277              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6277              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6277              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6277              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6277              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6277              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6277              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6277              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6277              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6277              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6277              ;  13 END_HOLD     "The End" sprite hold
  22+ 6277              ;  14 BLACK        wipe a negro + hold
  23+ 6277              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6277              ;
  25+ 6277              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6277              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6277              ; ==============================================================================
  28+ 6277
  29+ 6277              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6277              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6277              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6277              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6277              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6277              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6277              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6277              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6277              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 6277              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 6277              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 6277
  41+ 6277              ; --- Posiciones (pixel) ---
  42+ 6277              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 6277              TGCS_ANCHOR1_Y         EQU 80
  44+ 6277              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 6277              TGCS_END_CHARY         EQU 4
  46+ 6277              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 6277
  48+ 6277              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 6277              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 6277              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 6277              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 6277              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 6277              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 6277              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 6277              TGCS_ARM_PX_X          EQU 136
  56+ 6277              TGCS_ARM_PX_Y          EQU 64
  57+ 6277              TGCS_FINGER_PX_X       EQU 136
  58+ 6277              TGCS_FINGER_PX_Y       EQU 56
  59+ 6277
  60+ 6277              ; --- Phase enum ---
  61+ 6277              TGP_IDLE               EQU 0
  62+ 6277              TGP_LOCK               EQU 1
  63+ 6277              TGP_ARM_IN             EQU 2
  64+ 6277              TGP_FINGER_IN          EQU 3
  65+ 6277              TGP_SHAKE              EQU 4
  66+ 6277              TGP_FINGER_PULSE       EQU 5
  67+ 6277              TGP_FINGER_OUT         EQU 6
  68+ 6277              TGP_ARM_HOLD           EQU 7
  69+ 6277              TGP_ARM_OUT            EQU 8
  70+ 6277              TGP_PLAYER_TURN        EQU 9
  71+ 6277              TGP_PLAYER_HIDE        EQU 10
  72+ 6277              TGP_PLAYER_FRAMED      EQU 11
  73+ 6277              TGP_PLAYER_EXIT        EQU 12
  74+ 6277              TGP_END_HOLD           EQU 13
  75+ 6277              TGP_BLACK              EQU 14
  76+ 6277              TGP_CREDITS            EQU 15
  77+ 6277              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ 6277              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ 6277
  80+ 6277              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ 6277                                                ; check dinamico de "todos los nasties dead".
  82+ 6277                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ 6277                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ 6277                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ 6277
  86+ 6277              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ 6277              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ 6277              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ 6277              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ 6277
  91+ 6277              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ 6277              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ 6277              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ 6277              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ 6277              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ 6277              ;
  97+ 6277              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ 6277              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ 6277              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ 6277              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ 6277              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ 6277              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ 6277              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 104+ 6277
 105+ 6277              ; --- Posicion de la puerta (closed v2 + open) en char ---
 106+ 6277              ; El closed v2 (id 246) vive en PickupTable a (14, 17). El open (id 250)
 107+ 6277              ; comparte posicion y tamano (4x5 chars). Cuando el cutscene erase el closed,
 108+ 6277              ; dibuja el open in-place via DrawBgGfxSprite.
 109+ 6277              TGCS_DOOR_CHARX        EQU 14
 110+ 6277              TGCS_DOOR_CHARY        EQU 17
 111+ 6277              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
 112+ 6277              TGCS_ARCH_ROOM_X       EQU 7
 113+ 6277              TGCS_ARCH_ROOM_Y       EQU 15
 114+ 6277              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
 115+ 6277
 116+ 6277              ; ==============================================================================
 117+ 6277              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ 6277              ; ==============================================================================
 119+ 6277              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ 6277              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ 6277              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ 6277              ;
 123+ 6277              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ 6277              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ 6277              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ 6277              ; Destruye: AF, BC, DE, HL, IX.
 127+ 6277              ; ==============================================================================
 128+ 6277              CheckTownGateTriggerBg:
 129+ 6277 3A C8 82         LD A, (TownGatePhase)
 130+ 627A B7               OR A
 131+ 627B C0               RET NZ                              ; ya en cutscene
 132+ 627C 3A AE 82         LD A, (CurrentKey)
 133+ 627F FE 06            CP TGCS_ARCH_KEY_ID
 134+ 6281 C0               RET NZ                              ; sin la key correcta
 135+ 6282 3A 08 83         LD A, (CurrentScreenX)
 136+ 6285 FE 07            CP TGCS_ARCH_ROOM_X
 137+ 6287 C0               RET NZ
 138+ 6288 3A 09 83         LD A, (CurrentScreenY)
 139+ 628B FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ 628D C0               RET NZ
 141+ 628E                  ; --- Horizontal AABB ---
 142+ 628E 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 143+ 6291 4F               LD C, A                             ; C = player_left
 144+ 6292 C6 10            ADD A, 16
 145+ 6294 57               LD D, A                             ; D = player_right
 146+ 6295 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ 6297 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ 6299 30 01            JR NC, .ctgtNoUnderL
 149+ 629B AF               XOR A
 150+ 629C              .ctgtNoUnderL:
 151+ 629C BA               CP D
 152+ 629D D0               RET NC                              ; ext_left >= player_right
 153+ 629E 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ 62A0 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ 62A2 30 02            JR NC, .ctgtNoOverR
 156+ 62A4 3E FF            LD A, $FF
 157+ 62A6              .ctgtNoOverR:
 158+ 62A6 B9               CP C
 159+ 62A7 D8               RET C                               ; ext_right < player_left
 160+ 62A8                  ; --- Vertical AABB ---
 161+ 62A8                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ 62A8                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ 62A8                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ 62A8                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ 62A8                  ; con la altura real del rect.
 166+ 62A8 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 167+ 62AB 4F               LD C, A                             ; C = player_top
 168+ 62AC C6 15            ADD A, 21
 169+ 62AE 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ 62AF 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ 62B1 D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ 62B3 30 01            JR NC, .ctgtNoUnderT
 173+ 62B5 AF               XOR A
 174+ 62B6              .ctgtNoUnderT:
 175+ 62B6 BA               CP D
 176+ 62B7 D0               RET NC
 177+ 62B8 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ 62BA C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ 62BC 30 02            JR NC, .ctgtNoOverB
 180+ 62BE 3E FF            LD A, $FF
 181+ 62C0              .ctgtNoOverB:
 182+ 62C0 B9               CP C
 183+ 62C1 D8               RET C
 184+ 62C2                  ; HIT
 185+ 62C2 CD CA 62         CALL StartTownGateCutscene
 186+ 62C5 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ 62C7 C3 D1 EE         JP CheckMilestoneTrigger            ; tail call
 188+ 62CA
 189+ 62CA              ; ==============================================================================
 190+ 62CA              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 62CA              ; ==============================================================================
 192+ 62CA              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 62CA              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 62CA              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 62CA              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 62CA              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 62CA              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 62CA              ; Destruye: AF, BC, DE, HL, IX.
 199+ 62CA              ; ==============================================================================
 200+ 62CA              StartTownGateCutscene:
 201+ 62CA AF               XOR A
 202+ 62CB 32 AE 82         LD (CurrentKey), A
 203+ 62CE CD C7 65         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 62D1 CD 2D BA         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 62D4 CD E5 62         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 62D7 CD 63 68         CALL SFX_TownGate_OnStart
 207+ 62DA 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 62DC 32 C8 82         LD (TownGatePhase), A
 209+ 62DF 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ 62E1 32 A5 5F         LD (TownGateTimer), A
 211+ 62E4 C9               RET
 212+ 62E5
 213+ 62E5              ; ==============================================================================
 214+ 62E5              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
 215+ 62E5              ; ==============================================================================
 216+ 62E5              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING
 217+ 62E5              ; con SPRID_PUFF. ProcessDeath → ProcessOneEnemy.peDying anima puff cada
 218+ 62E5              ; frame en WAIT_NASTIES (igual que nasties). Al terminar puff,
 219+ 62E5              ; UpdateDying pone TYPE_NONE y la check dinamica de WAIT_NASTIES sigue.
 220+ 62E5              ; (DeathSpawned se queda a 1 pero es inocuo: ProcessDeath ya retorna
 221+ 62E5              ; cuando ENT_TYPE=0, y no hay respawn durante cutscene.)
 222+ 62E5              ; ==============================================================================
 223+ 62E5              KillDeathIfActive:
 224+ 62E5 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
 225+ 62E9 DD 7E 01         LD A, (IX+ENT_TYPE)
 226+ 62EC B7               OR A
 227+ 62ED C8               RET Z                               ; muerte ya inactiva
 228+ 62EE DD 7E 02         LD A, (IX+ENT_STATE)
 229+ 62F1 FE 03            CP STATE_DYING
 230+ 62F3 C8               RET Z                               ; ya muriendo
 231+ 62F4 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
 232+ 62F8 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
 233+ 62FC DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
 234+ 6300 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
 235+ 6304 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 236+ 6308 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 237+ 630C DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
 238+ 6310                  ; Death se va con puff -> parar musica de la muerte. $FD = stop-if-loopable
 239+ 6310                  ; (DeathMusic es la unica loopable; si sonaba tension/sunrise no las cortamos).
 240+ 6310 3E FD            LD A, $FD
 241+ 6312 C3 BA 99         JP StartMusic
 242+ 6315
 243+ 6315              ; ==============================================================================
 244+ 6315              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 245+ 6315              ; ==============================================================================
 246+ 6315              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 247+ 6315              ; transicion a la siguiente.
 248+ 6315              ; Destruye: AF, BC, DE, HL, IX.
 249+ 6315              ; ==============================================================================
 250+ 6315              UpdateTownGateCutscene:
 251+ 6315 3A C8 82         LD A, (TownGatePhase)
 252+ 6318 FE 10            CP TGP_WAIT_NASTIES
 253+ 631A CA 55 63         JP Z, .tgPhWaitNasties              ; pre-LOCK wait, ProcessEnemies sigue corriendo
 254+ 631D FE 11            CP TGP_WALK_TO_ANCHOR
 255+ 631F CA 71 63         JP Z, .tgPhWalkToAnchor              ; player camina autonomo a anchor1
 256+ 6322 3D               DEC A
 257+ 6323 CA F7 63         JP Z, .tgPhLock
 258+ 6326 3D               DEC A
 259+ 6327 CA 0F 64         JP Z, .tgPhArmIn
 260+ 632A 3D               DEC A
 261+ 632B CA 27 64         JP Z, .tgPhFingerIn
 262+ 632E 3D               DEC A
 263+ 632F CA 40 64         JP Z, .tgPhShake
 264+ 6332 3D               DEC A
 265+ 6333 CA 58 64         JP Z, .tgPhFingerPulse
 266+ 6336 3D               DEC A
 267+ 6337 CA 70 64         JP Z, .tgPhFingerOut
 268+ 633A 3D               DEC A
 269+ 633B CA 7F 64         JP Z, .tgPhArmHold
 270+ 633E 3D               DEC A
 271+ 633F CA 97 64         JP Z, .tgPhArmOut
 272+ 6342 3D               DEC A
 273+ 6343 CA BC 64         JP Z, .tgPhPlayerTurn
 274+ 6346 3D               DEC A                               ; phase 10 (PLAYER_HIDE) deprecated
 275+ 6347 3D               DEC A                               ; phase 11 (PLAYER_FRAMED) deprecated
 276+ 6348 3D               DEC A
 277+ 6349 CA F1 64         JP Z, .tgPhPlayerExit
 278+ 634C 3D               DEC A
 279+ 634D CA 21 65         JP Z, .tgPhEndHold
 280+ 6350 3D               DEC A
 281+ 6351 CA 33 65         JP Z, .tgPhBlack
 282+ 6354                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 283+ 6354 C9               RET
 284+ 6355
 285+ 6355              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 286+ 6355              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 287+ 6355              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 288+ 6355              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 289+ 6355              ;
 290+ 6355              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 291+ 6355              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 292+ 6355              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 293+ 6355              ; capturamos para meterlos en STATE_DYING.
 294+ 6355              .tgPhWaitNasties:
 295+ 6355 CD 2D BA         CALL KillAllActiveNasties           ; cazar spawnings recien terminados
 296+ 6358 CD E7 65         CALL TownGateAllNastiesDeadCheck
 297+ 635B 28 04            JR Z, .tgWaitNastiesDone
 298+ 635D CD 43 65         CALL TownGateDecTimer               ; safety timeout
 299+ 6360 C0               RET NZ
 300+ 6361              .tgWaitNastiesDone:
 301+ 6361                  ; Refrescar attrs del player antes del walk: los puffs de nasties cerca
 302+ 6361                  ; del player pueden haber dejado attrs contaminados (color nasty) en
 303+ 6361                  ; sus celdas. TownGateRedrawPlayer hace erase + RestoreOldAttr (limpia
 304+ 6361                  ; desde CleanAttrMap) + draw + SetEntityAttr (player white).
 305+ 6361 CD 9E 65         CALL TownGateRedrawPlayer
 306+ 6364 AF               XOR A
 307+ 6365 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 308+ 6368 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 309+ 636B 3E 11            LD A, TGP_WALK_TO_ANCHOR
 310+ 636D 32 C8 82         LD (TownGatePhase), A
 311+ 6370 C9               RET
 312+ 6371
 313+ 6371              ; ---- Phase WALK_TO_ANCHOR: player camina autonomo en 2 fases ----
 314+ 6371              ; Fase 1: movimiento vertical hasta alinear Y con TGCS_WALK_TARGET_Y
 315+ 6371              ;         (sprite WALK_N o WALK_S segun direccion).
 316+ 6371              ; Fase 2: movimiento horizontal hasta alinear X con TGCS_WALK_TARGET_X
 317+ 6371              ;         (sprite WALK_E o WALK_W segun direccion).
 318+ 6371              ; Al llegar (ambos ejes alineados): pose static WALK_N+1 + transicion a LOCK.
 319+ 6371              ; Toggle frame anim 0/1 cada TGCS_WALK_ANIM_PERIOD frames.
 320+ 6371              .tgPhWalkToAnchor:
 321+ 6371 DD 21 9B 81      LD IX, EntityTable
 322+ 6375                  ; --- Fase 1: Y ---
 323+ 6375 DD 7E 04         LD A, (IX+ENT_POSY)
 324+ 6378 FE 50            CP TGCS_WALK_TARGET_Y
 325+ 637A 28 1C            JR Z, .tgwtaTryX                    ; Y aligned, pasar a fase 2
 326+ 637C 38 0D            JR C, .tgwtaMoveS                   ; cur_Y < target → S (Y++)
 327+ 637E                  ; cur_Y > target → N (Y--)
 328+ 637E DD 35 04         DEC (IX+ENT_POSY)
 329+ 6381 DD 7E 04         LD A, (IX+ENT_POSY)
 330+ 6384 32 DC 82         LD (PlayerDrawY), A
 331+ 6387 06 0A            LD B, SPRID_WALK_N
 332+ 6389 18 2F            JR .tgwtaApplyAnim
 333+ 638B              .tgwtaMoveS:
 334+ 638B DD 34 04         INC (IX+ENT_POSY)
 335+ 638E DD 7E 04         LD A, (IX+ENT_POSY)
 336+ 6391 32 DC 82         LD (PlayerDrawY), A
 337+ 6394 06 0E            LD B, SPRID_WALK_S
 338+ 6396 18 22            JR .tgwtaApplyAnim
 339+ 6398                  ; --- Fase 2: X (solo si Y ya aligned) ---
 340+ 6398              .tgwtaTryX:
 341+ 6398 DD 7E 03         LD A, (IX+ENT_POSX)
 342+ 639B FE 78            CP TGCS_WALK_TARGET_X
 343+ 639D CA DB 63         JP Z, .tgwtaArrived                 ; ambos aligned
 344+ 63A0 38 0D            JR C, .tgwtaMoveE                   ; cur_X < target → E (X++)
 345+ 63A2 DD 35 03         DEC (IX+ENT_POSX)
 346+ 63A5 DD 7E 03         LD A, (IX+ENT_POSX)
 347+ 63A8 DD 77 0F         LD (IX+ENT_DRAWX), A
 348+ 63AB 06 06            LD B, SPRID_WALK_W
 349+ 63AD 18 0B            JR .tgwtaApplyAnim
 350+ 63AF              .tgwtaMoveE:
 351+ 63AF DD 34 03         INC (IX+ENT_POSX)
 352+ 63B2 DD 7E 03         LD A, (IX+ENT_POSX)
 353+ 63B5 DD 77 0F         LD (IX+ENT_DRAWX), A
 354+ 63B8 06 02            LD B, SPRID_WALK_E
 355+ 63BA              .tgwtaApplyAnim:
 356+ 63BA                  ; B = sprite base. Toggle frame 0/1 cada TGCS_WALK_ANIM_PERIOD.
 357+ 63BA 3A A5 5F         LD A, (TownGateTimer)
 358+ 63BD 3C               INC A
 359+ 63BE 32 A5 5F         LD (TownGateTimer), A
 360+ 63C1 FE 04            CP TGCS_WALK_ANIM_PERIOD
 361+ 63C3 38 0C            JR C, .tgwtaSameFrame
 362+ 63C5 AF               XOR A
 363+ 63C6 32 A5 5F         LD (TownGateTimer), A
 364+ 63C9 3A A9 5F         LD A, (TownGateExitWalkFrame)
 365+ 63CC EE 01            XOR 1
 366+ 63CE 32 A9 5F         LD (TownGateExitWalkFrame), A
 367+ 63D1              .tgwtaSameFrame:
 368+ 63D1 3A A9 5F         LD A, (TownGateExitWalkFrame)
 369+ 63D4 80               ADD A, B
 370+ 63D5 DD 77 00         LD (IX+ENT_SPRITEID), A
 371+ 63D8 C3 9E 65         JP TownGateRedrawPlayer             ; tail call
 372+ 63DB
 373+ 63DB              .tgwtaArrived:
 374+ 63DB                  ; Llegado a anchor1: pose static WALK_N+1 + transicion a LOCK.
 375+ 63DB 3E 0B            LD A, SPRID_WALK_N + 1              ; frame 2o de Walk North (mirando arriba)
 376+ 63DD DD 77 00         LD (IX+ENT_SPRITEID), A
 377+ 63E0 3E 0A            LD A, SPRID_WALK_N
 378+ 63E2 DD 77 08         LD (IX+ENT_ANIMBASE), A
 379+ 63E5 AF               XOR A
 380+ 63E6 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 381+ 63E9 CD 9E 65         CALL TownGateRedrawPlayer
