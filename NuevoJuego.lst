 376+ EC08              ; ==============================================================================
 377+ EC08              ; UpdateRandomPickup - room-enter hook
 378+ EC08              ; ==============================================================================
 379+ EC08              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 380+ EC08              ; Early-out si ScreenDirty=0 (no transition).
 381+ EC08              ;
 382+ EC08              ; En transition:
 383+ EC08              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 384+ EC08              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 385+ EC08              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 386+ EC08              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 387+ EC08              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 388+ EC08              ;
 389+ EC08              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 390+ EC08              ; fijos (id, charX, charY, v) terminados con id=$FF.
 391+ EC08              ;
 392+ EC08              ; Destruye AF, BC, DE, HL.
 393+ EC08              ; ==============================================================================
 394+ EC08              UpdateRandomPickupBody:
 395+ EC08 3A 09 83         LD A, (ScreenDirty)
 396+ EC0B B7               OR A
 397+ EC0C C8               RET Z
 398+ EC0D
 399+ EC0D                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 400+ EC0D 3E FE            LD A, $FE
 401+ EC0F 32 B4 5F         LD (RandomSynthMapX), A
 402+ EC12 AF               XOR A
 403+ EC13 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 404+ EC16
 405+ EC16                  ; --- Scan BG stream, build SlotList ---
 406+ EC16 AF               XOR A
 407+ EC17 32 AB 5F         LD (RandomSlotCount), A
 408+ EC1A 2A 03 83         LD HL, (CurrentScreenAddr)
 409+ EC1D              .urpScanLoop:
 410+ EC1D 7E               LD A, (HL)                          ; A = id
 411+ EC1E FE FF            CP $FF
 412+ EC20 28 2A            JR Z, .urpScanDone
 413+ EC22 FE D2            CP RANDOM_SLOT_MARKER
 414+ EC24 20 20            JR NZ, .urpSkipEntry
 415+ EC26                  ; Es marker. Cap reached?
 416+ EC26 3A AB 5F         LD A, (RandomSlotCount)
 417+ EC29 FE 04            CP RANDOM_SLOT_MAX
 418+ EC2B 30 19            JR NC, .urpSkipEntry
 419+ EC2D                  ; SlotList[count*2] = charX, [count*2+1] = charY
 420+ EC2D 23               INC HL                              ; HL @ charX
 421+ EC2E 46               LD B, (HL)                          ; B = charX
 422+ EC2F 23               INC HL                              ; HL @ charY
 423+ EC30 4E               LD C, (HL)                          ; C = charY
 424+ EC31 E5               PUSH HL                             ; save HL @ charY
 425+ EC32 87               ADD A, A                            ; A = count*2
 426+ EC33 6F               LD L, A
 427+ EC34 26 00            LD H, 0
 428+ EC36 11 AC 5F         LD DE, RandomSlotList
 429+ EC39 19               ADD HL, DE
 430+ EC3A 70               LD (HL), B                          ; charX
 431+ EC3B 23               INC HL
 432+ EC3C 71               LD (HL), C                          ; charY
 433+ EC3D 21 AB 5F         LD HL, RandomSlotCount
 434+ EC40 34               INC (HL)
 435+ EC41 E1               POP HL                              ; HL @ charY
 436+ EC42 23               INC HL                              ; HL @ v
 437+ EC43 23               INC HL                              ; HL @ next id
 438+ EC44 18 D7            JR .urpScanLoop
 439+ EC46              .urpSkipEntry:
 440+ EC46                  ; Skip entry: 4 bytes (id, charX, charY, v).
 441+ EC46 23               INC HL
 441+ EC47 23             INC HL
 441+ EC48 23             INC HL
 441+ EC49 23             INC HL
 442+ EC4A 18 D1            JR .urpScanLoop
 443+ EC4C              .urpScanDone:
 444+ EC4C
 445+ EC4C                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 446+ EC4C 3A AB 5F         LD A, (RandomSlotCount)
 447+ EC4F B7               OR A
 448+ EC50 CA A1 ED         JP Z, .urpZeroAndRotate
 449+ EC53
 450+ EC53                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 451+ EC53                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 452+ EC53                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 453+ EC53 3A 02 83         LD A, (CurrentScreenY)
 454+ EC56 07               RLCA
 454+ EC57 07             RLCA
 454+ EC58 07             RLCA
 454+ EC59 07             RLCA           ; Y*16
 455+ EC5A 21 01 83         LD HL, CurrentScreenX
 456+ EC5D 86               ADD A, (HL)                         ; A = newSid
 457+ EC5E 47               LD B, A                             ; B = newSid (preservar)
 458+ EC5F 3A D1 5F         LD A, (RP_PrevSid)
 459+ EC62 B8               CP B
 460+ EC63 20 1A            JR NZ, .urpCacheMiss
 461+ EC65                  ; HIT prev. Validar slot < count.
 462+ EC65 3A D2 5F         LD A, (RP_PrevSlot)
 463+ EC68 4F               LD C, A                             ; C = cached slot
 464+ EC69 3A AB 5F         LD A, (RandomSlotCount)
 465+ EC6C B9               CP C
 466+ EC6D 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 467+ EC6F 38 0E            JR C, .urpCacheMiss
 468+ EC71                  ; Restaurar: usar cached slot + cached rolled.
 469+ EC71 79               LD A, C
 470+ EC72 32 D4 5F         LD (RP_TmpSlot), A
 471+ EC75 3A D3 5F         LD A, (RP_PrevRolled)
 472+ EC78 32 D5 5F         LD (RP_TmpRolled), A
 473+ EC7B 79               LD A, C                             ; A = slot
 474+ EC7C C3 CE EC         JP .urpReadSlotAndDispatchCache
 475+ EC7F
 476+ EC7F              .urpCacheMiss:
 477+ EC7F 3A AB 5F         LD A, (RandomSlotCount)
 478+ EC82                  ; --- Pick slot via R mod count ---
 479+ EC82 47               LD B, A                             ; B = count
 480+ EC83 ED 5F            LD A, R
 481+ EC85              .urpModLoop:
 482+ EC85 90               SUB B
 483+ EC86 30 FD            JR NC, .urpModLoop
 484+ EC88 80               ADD A, B                            ; A = R mod count, [0..count-1]
 485+ EC89 32 D4 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
 486+ EC8C
 487+ EC8C                  ; --- Read SlotList[A*2] = (charX, charY) ---
 488+ EC8C 87               ADD A, A
 489+ EC8D 5F               LD E, A
 490+ EC8E 16 00            LD D, 0
 491+ EC90 21 AC 5F         LD HL, RandomSlotList
 492+ EC93 19               ADD HL, DE
 493+ EC94 7E               LD A, (HL)                          ; charX
 494+ EC95 32 B8 5F         LD (RandomSynthCharX), A
 495+ EC98 23               INC HL
 496+ EC99 7E               LD A, (HL)                          ; charY
 497+ EC9A 32 B9 5F         LD (RandomSynthCharY), A
 498+ EC9D
 499+ EC9D                  ; --- Roll type usando R XOR SYS_FRAMES ---
 500+ EC9D                  IF DEBUG_FORCE_COMPASS
 501+ EC9D ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 502+ EC9D ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 503+ EC9D ~                    JP .urpDoCompass
 504+ EC9D                  ENDIF
 505+ EC9D                  IF DEBUG_FORCE_MUSHROOM
 506+ EC9D ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 507+ EC9D ~                    JP .urpDoMushroom
 508+ EC9D                  ENDIF
 509+ EC9D                  IF DEBUG_FORCE_ROULETTE
 510+ EC9D ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 511+ EC9D ~                    JP .urpDoRoulette
 512+ EC9D                  ENDIF
 513+ EC9D ED 5F            LD A, R
 514+ EC9F 21 78 5C         LD HL, $5C78
 515+ ECA2 AE               XOR (HL)
 516+ ECA3                  ; JP C en lugar de JR C: el cache hit dispatch crecio el binario, los JR
 517+ ECA3                  ; quedaban fuera de rango (+127 max). JP unconditional, +1 byte por entrada.
 518+ ECA3 FE 08            CP PROB_LIFE_END
 519+ ECA5 DA 1D ED         JP C, .urpDoLife
 520+ ECA8 FE 18            CP PROB_HEALTH_END
 521+ ECAA DA 27 ED         JP C, .urpDoHealth
 522+ ECAD FE 28            CP PROB_STAMINA_END
 523+ ECAF DA 34 ED         JP C, .urpDoStamina
 524+ ECB2 FE 38            CP PROB_RAYO_END
 525+ ECB4 DA 41 ED         JP C, .urpDoRayo
 526+ ECB7 FE 48            CP PROB_CARACOL_END
 527+ ECB9 DA 4B ED         JP C, .urpDoCaracol
 528+ ECBC FE 58            CP PROB_ROULETTE_END
 529+ ECBE DA 69 ED         JP C, .urpDoRoulette
 530+ ECC1 FE 68            CP PROB_MUSHROOM_END
 531+ ECC3 DA 55 ED         JP C, .urpDoMushroom
 532+ ECC6 FE 70            CP PROB_COMPASS_END
 533+ ECC8 DA 5F ED         JP C, .urpDoCompass
 534+ ECCB C3 A1 ED         JP .urpZeroAndRotate                ; tipo nada, RandomSynthMapX ya esta a $FE
 535+ ECCE
 536+ ECCE              ; ==============================================================================
 537+ ECCE              ; .urpReadSlotAndDispatchCache — path del cache HIT
 538+ ECCE              ; ==============================================================================
 539+ ECCE              ; Entrada: A = slot cached, RP_TmpRolled = tipo cached (ya setado).
 540+ ECCE              ; Lee SlotList[A*2] → CharX/Y, luego dispatcha al .urpDoXxx correspondiente.
 541+ ECCE              ; ROLLED_NONE → JP .urpZeroAndRotate (no spawn pero rota cache).
 542+ ECCE              ; ==============================================================================
 543+ ECCE              .urpReadSlotAndDispatchCache:
 544+ ECCE 87               ADD A, A
 545+ ECCF 5F               LD E, A
 546+ ECD0 16 00            LD D, 0
 547+ ECD2 21 AC 5F         LD HL, RandomSlotList
 548+ ECD5 19               ADD HL, DE
 549+ ECD6 7E               LD A, (HL)
 550+ ECD7 32 B8 5F         LD (RandomSynthCharX), A
 551+ ECDA 23               INC HL
 552+ ECDB 7E               LD A, (HL)
 553+ ECDC 32 B9 5F         LD (RandomSynthCharY), A
 554+ ECDF
 555+ ECDF 3A D5 5F         LD A, (RP_TmpRolled)
 556+ ECE2 B7               OR A
 557+ ECE3 CA A1 ED         JP Z, .urpZeroAndRotate             ; ROLLED_NONE (consumido) → no spawn
 558+ ECE6 3D               DEC A
 559+ ECE7 CA 1D ED         JP Z, .urpDoLife                    ; ROLLED_LIFE
 560+ ECEA 3D               DEC A
 561+ ECEB 28 16            JR Z, .urpDoHealthFromCache         ; ROLLED_HEALTH: reusa variant cacheada
 562+ ECED 3D               DEC A
 563+ ECEE 28 1A            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 564+ ECF0 3D               DEC A
 565+ ECF1 CA 41 ED         JP Z, .urpDoRayo
 566+ ECF4 3D               DEC A
 567+ ECF5 CA 4B ED         JP Z, .urpDoCaracol
 568+ ECF8 3D               DEC A
 569+ ECF9 CA 69 ED         JP Z, .urpDoRoulette
 570+ ECFC 3D               DEC A
 571+ ECFD CA 55 ED         JP Z, .urpDoMushroom
 572+ ED00 C3 5F ED         JP .urpDoCompass                    ; ROLLED_COMPASS (resto)
 573+ ED03
 574+ ED03              ; ==============================================================================
 575+ ED03              ; .urpDoHealthFromCache / .urpDoStaminaFromCache - cache hit path
 576+ ED03              ; ==============================================================================
 577+ ED03              ; Llamadas solo desde .urpReadSlotAndDispatchCache. Restauran la variante exacta
 578+ ED03              ; que el player vio la última vez en esta sala (vía RP_PrevVariant) en lugar de
 579+ ED03              ; re-rollear con PickRandomVariantPtr. El usuario ve consistencia visual.
 580+ ED03              ;
 581+ ED03              ; Comparten .urpDoVariantFromCache: HL ya cargado con la tabla, A con ROLLED_*.
 582+ ED03              ; ==============================================================================
 583+ ED03              .urpDoHealthFromCache:
 584+ ED03 3E 02            LD A, ROLLED_HEALTH
 585+ ED05 21 43 EF         LD HL, HealthVariantPtrs
 586+ ED08 18 05            JR .urpDoVariantFromCache
 587+ ED0A              .urpDoStaminaFromCache:
 588+ ED0A 3E 03            LD A, ROLLED_STAMINA
 589+ ED0C 21 4C EF         LD HL, StaminaVariantPtrs
 590+ ED0F              .urpDoVariantFromCache:
 591+ ED0F 32 D5 5F         LD (RP_TmpRolled), A
 592+ ED12 3A D7 5F         LD A, (RP_PrevVariant)
 593+ ED15 32 D8 5F         LD (RP_TmpVariant), A               ; restore: la próxima rotación lo lleva a Cur
 594+ ED18 CD 5C EF         CALL LookupVariantPtrByIdx          ; HL = tabla, A = idx → HL = sprite ptr
 595+ ED1B 18 6E            JR .urpActivate
 596+ ED1D
 597+ ED1D              .urpDoLife:
 598+ ED1D 3E 01            LD A, ROLLED_LIFE
 599+ ED1F 32 D5 5F         LD (RP_TmpRolled), A
 600+ ED22 21 13 CE         LD HL, BgGfx_life
 601+ ED25 18 64            JR .urpActivate
 602+ ED27              .urpDoHealth:
 603+ ED27 3E 02            LD A, ROLLED_HEALTH
 604+ ED29 32 D5 5F         LD (RP_TmpRolled), A
