 120+ 9907              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 121+ 9907              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 122+ 9907              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 123+ 9907              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 124+ 9907              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 125+ 9907              AY_OverrideBellPeriod:
 126+ 9907 F3               DI
 127+ 9908                  ; R0 = period low (canal A)
 128+ 9908 5D               LD E, L
 129+ 9909 3E 00            LD A, 0
 130+ 990B 01 FD FF         LD BC, $FFFD
 131+ 990E ED 79            OUT (C), A
 132+ 9910 01 FD BF         LD BC, $BFFD
 133+ 9913 ED 59            OUT (C), E
 134+ 9915                  ; R1 = period high (canal A)
 135+ 9915 5C               LD E, H
 136+ 9916 3E 01            LD A, 1
 137+ 9918 01 FD FF         LD BC, $FFFD
 138+ 991B ED 79            OUT (C), A
 139+ 991D 01 FD BF         LD BC, $BFFD
 140+ 9920 ED 59            OUT (C), E
 141+ 9922                  ; R2/R3 (canal B)
 142+ 9922 5D               LD E, L
 143+ 9923 3E 02            LD A, 2
 144+ 9925 01 FD FF         LD BC, $FFFD
 145+ 9928 ED 79            OUT (C), A
 146+ 992A 01 FD BF         LD BC, $BFFD
 147+ 992D ED 59            OUT (C), E
 148+ 992F 5C               LD E, H
 149+ 9930 3E 03            LD A, 3
 150+ 9932 01 FD FF         LD BC, $FFFD
 151+ 9935 ED 79            OUT (C), A
 152+ 9937 01 FD BF         LD BC, $BFFD
 153+ 993A ED 59            OUT (C), E
 154+ 993C                  ; R4/R5 (canal C)
 155+ 993C 5D               LD E, L
 156+ 993D 3E 04            LD A, 4
 157+ 993F 01 FD FF         LD BC, $FFFD
 158+ 9942 ED 79            OUT (C), A
 159+ 9944 01 FD BF         LD BC, $BFFD
 160+ 9947 ED 59            OUT (C), E
 161+ 9949 5C               LD E, H
 162+ 994A 3E 05            LD A, 5
 163+ 994C 01 FD FF         LD BC, $FFFD
 164+ 994F ED 79            OUT (C), A
 165+ 9951 01 FD BF         LD BC, $BFFD
 166+ 9954 ED 59            OUT (C), E
 167+ 9956 FB               EI
 168+ 9957 C9               RET
 169+ 9958
 170+ 9958              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 171+ 9958              ; HL = period (12-bit), B = duracion (10ms units).
 172+ 9958              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 173+ 9958              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 174+ 9958              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 175+ 9958              ; cambiaramos de bank en slot 3 entre el push y el pop).
 176+ 9958              AY_PlayToneBlocking:
 177+ 9958 F3               DI
 178+ 9959                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 9959                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 9959 5C               LD E, H                     ; E = period high
 181+ 995A 3E 01            LD A, 1
 182+ 995C 01 FD FF         LD BC, $FFFD
 183+ 995F ED 79            OUT (C), A
 184+ 9961 01 FD BF         LD BC, $BFFD
 185+ 9964 ED 59            OUT (C), E
 186+ 9966                  ; R0 = period low
 187+ 9966 5D               LD E, L                     ; E = period low
 188+ 9967 3E 00            LD A, 0
 189+ 9969 01 FD FF         LD BC, $FFFD
 190+ 996C ED 79            OUT (C), A
 191+ 996E 01 FD BF         LD BC, $BFFD
 192+ 9971 ED 59            OUT (C), E
 193+ 9973                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 194+ 9973 3E 09            LD A, 9
 195+ 9975 01 FD FF         LD BC, $FFFD
 196+ 9978 ED 79            OUT (C), A
 197+ 997A 01 FD BF         LD BC, $BFFD
 198+ 997D AF               XOR A
 199+ 997E ED 79            OUT (C), A
 200+ 9980                  ; R10 = 0 (silenciar canal C)
 201+ 9980 3E 0A            LD A, 10
 202+ 9982 01 FD FF         LD BC, $FFFD
 203+ 9985 ED 79            OUT (C), A
 204+ 9987 01 FD BF         LD BC, $BFFD
 205+ 998A AF               XOR A
 206+ 998B ED 79            OUT (C), A
 207+ 998D                  ; R7 = $3E (mixer: solo tono A activo)
 208+ 998D 3E 07            LD A, 7
 209+ 998F 01 FD FF         LD BC, $FFFD
 210+ 9992 ED 79            OUT (C), A
 211+ 9994 01 FD BF         LD BC, $BFFD
 212+ 9997 3E 3E            LD A, $3E
 213+ 9999 ED 79            OUT (C), A
 214+ 999B                  ; R8 = 13 (volumen A alto)
 215+ 999B 3E 08            LD A, 8
 216+ 999D 01 FD FF         LD BC, $FFFD
 217+ 99A0 ED 79            OUT (C), A
 218+ 99A2 01 FD BF         LD BC, $BFFD
 219+ 99A5 3E 0D            LD A, 13
 220+ 99A7 ED 79            OUT (C), A
 221+ 99A9                  ; --- Busy loop B × ~12.4ms ---
 222+ 99A9              .aypbOuter:
 223+ 99A9 21 80 06         LD HL, $0680                ; ~1664 inner iters
 224+ 99AC              .aypbInner:
 225+ 99AC 2B               DEC HL
 226+ 99AD 7C               LD A, H
 227+ 99AE B5               OR L
 228+ 99AF 20 FB            JR NZ, .aypbInner
 229+ 99B1 10 F6            DJNZ .aypbOuter
 230+ 99B3                  ; --- Silenciar canal A (volumen 0) ---
 231+ 99B3 3E 08            LD A, 8
 232+ 99B5 01 FD FF         LD BC, $FFFD
 233+ 99B8 ED 79            OUT (C), A
 234+ 99BA 01 FD BF         LD BC, $BFFD
 235+ 99BD AF               XOR A
 236+ 99BE ED 79            OUT (C), A
 237+ 99C0 FB               EI
 238+ 99C1 C9               RET
