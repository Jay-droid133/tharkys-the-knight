 781+ F253 3A 01 83         LD A, (CurrentScreenX)
 782+ F256 32 B4 82         LD (LastCompassScreenX), A
 783+ F259 3A 02 83         LD A, (CurrentScreenY)
 784+ F25C 32 B5 82         LD (LastCompassScreenY), A
 785+ F25F C9               RET
 786+ F260
 787+ F260 00           .dcSpriteIdx: DEFB 0
 788+ F261 00           .dcDistance:  DEFB 0
 789+ F262 00           .dcAttr:      DEFB 0
