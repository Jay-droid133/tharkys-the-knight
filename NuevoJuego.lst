 195+ FA31              ; --- SFX_CountdownTick: bip ~700ms para "3" y "2" del countdown ---
 196+ FA31              ; Pitch 102 = ~1047 Hz. Calibrado para octava precisa con pitch 50 (ratio 1.992).
 197+ FA31              ; (PlaySFX tiene ~78T de overhead por ciclo ademas de 32*pitch -> ratio puro
 198+ FA31              ; 100/50 quedaria desafinado ~30 cents. Compensado a 102 da ~7 cents.)
 199+ FA31              SFX_CountdownTick:
 200+ FA31 FA 66 00 00      DEFB 250, 102, 0, 0         ; ~239ms
 201+ FA35 FA 66 00 00      DEFB 250, 102, 0, 0         ; ~478ms
 202+ FA39 E6 66 00 00      DEFB 230, 102, 0, 0         ; ~219ms (total ~718ms)
 203+ FA3D 00               DEFB 0
 204+ FA3E
 205+ FA3E              ; --- SFX_CountdownGo: octava arriba del Tick, ~1s ---
 206+ FA3E              ; Pitch 50 = ~2086 Hz. Ratio period(102)/period(50) = 3342/1678 = 1.992.
 207+ FA3E              SFX_CountdownGo:
 208+ FA3E FA 32 00 00      DEFB 250, 50, 0, 0          ; ~120ms cada step
 209+ FA42 FA 32 00 00      DEFB 250, 50, 0, 0
 210+ FA46 FA 32 00 00      DEFB 250, 50, 0, 0
 211+ FA4A FA 32 00 00      DEFB 250, 50, 0, 0
 212+ FA4E FA 32 00 00      DEFB 250, 50, 0, 0
 213+ FA52 FA 32 00 00      DEFB 250, 50, 0, 0
 214+ FA56 FA 32 00 00      DEFB 250, 50, 0, 0
 215+ FA5A FA 32 00 00      DEFB 250, 50, 0, 0
 216+ FA5E 5A 32 00 00      DEFB 90, 50, 0, 0           ; total ~1003ms
 217+ FA62 00               DEFB 0
 218+ FA63
 219+ FA63              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 220+ FA63              ; Tono grave resonante con decay lento, como campana de iglesia
 221+ FA63              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 222+ FA63              SFX_BellChime:
 223+ FA63 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 224+ FA67 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 225+ FA6B 00               DEFB 0                      ; fin
 226+ FA6C
 227+ FA6C              ; --- SFX_ChurchDoorOpen: "click + creak" puerta de iglesia (~300ms) ---
 228+ FA6C              ; Click corto inicial (cerrojo), luego crujido lento ascendente (madera vieja
 229+ FA6C              ; girando con esfuerzo). Valores iniciales — afinar en el emulador.
 230+ FA6C              SFX_ChurchDoorOpen:
 231+ FA6C 0C 32 00 01      DEFB 12,  50,  0, 1          ; click: 12 iter ruido pitch 50
 232+ FA70 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 233+ FA74 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 234+ FA78 00               DEFB  0                       ; fin
 235+ FA79
 236+ FA79              ; --- SFX_DoorClose: "chof" sordo de puerta cerrandose (~120ms) ---
 237+ FA79              ; Compartido por: bank cutscene HAND_OPEN_IN (cierre tras cobro), bank
 238+ FA79              ; HAND_OUT (cierre final), church cutscene CloseChurchDoor.
 239+ FA79              ;
 240+ FA79              ; Caracter: thud blando, no metalico. Burst de noise denso (textura rugosa)
 241+ FA79              ; seguido de un rumble grave muy breve. Distinto del creak (SFX_ChurchDoorOpen)
 242+ FA79              ; — la puerta ABRE con creak (madera girando) y CIERRA con chof (impacto contra
 243+ FA79              ; el marco).
 244+ FA79              ;
 245+ FA79              ; pitch=0 en noise mode -> delay = (R AND $1F) | 1 -> rango completo 1-31
 246+ FA79              ; (textura densa). Distinto a pitch=18 (= AND $1F) del SFX_ChurchDoorOpen
 247+ FA79              ; click, que sesgaba mas agudo.
 248+ FA79              SFX_DoorClose:
 249+ FA79 23 00 00 01      DEFB 35,   0,  0, 1          ; chof: noise denso 35 iter (impacto contundente)
 250+ FA7D 19 F0 00 00      DEFB 25, 240,  0, 0          ; rumble grave sostenido: pitch 240, sweep 0 (sin decay,
 251+ FA81                                               ; rumble plano = peso maximo). Si demasiado largo,
 252+ FA81                                               ; bajar duracion (25 -> 20 / 15).
 253+ FA81 00               DEFB  0                       ; fin
 254+ FA82
 255+ FA82              ; --- SFX_BlockedExit: "BUZZ - BUZZ - BUZZ" triple tono profundo (~500 ticks) ---
 256+ FA82              ; Disparado cuando el jugador intenta salir de la iglesia hacia el sur
 257+ FA82              ; mientras el reloj esta congelado (fase de captura). Tres tonos cuadrados
 258+ FA82              ; muy graves separados por breves pausas para sugerir "no, no, no" como
 259+ FA82              ; un buzzer triple de concurso televisivo.
 260+ FA82              ;
 261+ FA82              ; En modo noise el pitch real esta limitado a 0-31 por AND $1F, por eso
 262+ FA82              ; usamos modo tono (noise=0) con pitch alto: el delay loop usa C
 263+ FA82              ; directamente, asi que pitch=220 da un periodo mucho mas largo (~7x mas
 264+ FA82              ; profundo que el max del modo noise).
 265+ FA82              SFX_BlockedExit:
 266+ FA82                  ; "Contraseña incorrecta" estilo pelicula: dos pulsos cortos harsh
 267+ FA82                  ; con noise (texture digital "BRRRT-BRRRT" tipo "ACCESS DENIED").
 268+ FA82                  ; Cada burst se hace con dos phases consecutivas porque cada phase
 269+ FA82                  ; en modo noise tiene duracion real corta (iter ~80us a pitch=8).
 270+ FA82 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1a: noise harsh
 271+ FA86 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1b: continua
 272+ FA8A 50 28 00 00      DEFB  80, 40, 0, 0          ; gap tonal audible para separacion
 273+ FA8E FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2a
 274+ FA92 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2b
 275+ FA96 00               DEFB   0                    ; fin
 276+ FA97
 277+ FA97              ; --- SFX_NoSwordError: "BRRT" corto, ruido grave (~150 ticks). Disparado
 278+ FA97              ; cuando el jugador pulsa fire con la seta activa (mushroom bloquea ataque).
 279+ FA97              ;
 280+ FA97              ; Modo noise (flag=1) puro: el delay del toggle es (R XOR C) AND $1F | 1.
 281+ FA97              ; pitch=0 deja el random "limpio" sin sesgar bits altos hacia delays cortos
 282+ FA97              ; (probar pitch=20 hizo que el bit 4 quedara seteado a menudo via XOR,
 283+ FA97              ; reduciendo delays => sonaba mas agudo). Con pitch=0 el patron usa todo
 284+ FA97              ; el rango 1-31 segun R, dando textura mas densa/rugosa.
 285+ FA97              ;
 286+ FA97              ; Duration 150 (vs 120 antes) sostiene el ruido un poco mas: a la oreja
 287+ FA97              ; se percibe como "mas cuerpo" sin pasar a beep tonal.
 288+ FA97              SFX_NoSwordError:
 289+ FA97 96 00 00 01      DEFB 150, 0, 0, 1           ; noise puro, pitch 0, duration mayor
 290+ FA9B 00               DEFB   0                    ; fin
 291+ FA9C
 292+ FA9C              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 293+ FA9C              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 294+ FA9C              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 295+ FA9C              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 296+ FA9C              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 297+ FA9C              SFX_KeyDrop:
 298+ FA9C 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 299+ FAA0 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 300+ FAA4 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 301+ FAA8 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 302+ FAAC 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 303+ FAB0 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 304+ FAB4 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 305+ FAB8 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 306+ FABC 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 307+ FAC0 00               DEFB   0                       ; fin
 308+ FAC1
 309+ FAC1              ; --- Sistema de campanadas con pausa entre ellas ---
 310+ FAC1              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 311+ FAC1              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 312+ FAC1              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 313+ FAC1 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 314+ FAC2 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 315+ FAC4              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 316+ FAC4              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 317+ FAC4
 318+ FAC4              ; --- Cadena de eventos tras la ultima campanada ---
 319+ FAC4              ; last chime → (delay) → windows off → (delay) → monster spawn
 320+ FAC4              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 321+ FAC4              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 322+ FAC4 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 323+ FAC5 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 324+ FAC6
 325+ FAC6              ; ==============================================================================
 326+ FAC6              ; StartBellChimes - Inicia secuencia de 12 campanadas
 327+ FAC6              ; ==============================================================================
 328+ FAC6              StartBellChimes:
 329+ FAC6                  ; Silenciar musica activa (death o cualquier otra). Bell escribe R7 (mixer
 330+ FAC6                  ; all-on), R0-R5 (period A/B/C) y R8-R10 (vols), clobbeando lo que la musica
 331+ FAC6                  ; mantenga en canal B. Mejor parar limpiamente que oir glitches.
 332+ FAC6 F5               PUSH AF
 333+ FAC7 3E FF            LD A, $FF
 334+ FAC9 CD BC 99         CALL StartMusic
 335+ FACC F1               POP AF
 336+ FACD 3E 0C            LD A, 12                            ; 12 campanadas (medianoche)
 337+ FACF 32 C1 FA         LD (BellCount), A
 338+ FAD2                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 339+ FAD2 2A 78 5C         LD HL, (SYS_FRAMES)
 340+ FAD5 22 C2 FA         LD (BellNextFrame), HL
 341+ FAD8 3E 7D            LD A, SCARE_TIMER_BELLS
 342+ FADA 32 0E B6         LD (ScareTimer), A
 343+ FADD C9               RET
 344+ FADE
 345+ FADE              ; ==============================================================================
 346+ FADE              ; UpdateBellChimes - Llamar cada frame desde el main loop
 347+ FADE              ; ==============================================================================
 348+ FADE              UpdateBellChimes:
 349+ FADE 3A C1 FA         LD A, (BellCount)
 350+ FAE1 B7               OR A
 351+ FAE2 C8               RET Z                       ; sin campanadas pendientes
 352+ FAE3
 353+ FAE3                  ; Comparar FRAMES actual con BellNextFrame
 354+ FAE3 2A 78 5C         LD HL, (SYS_FRAMES)
 355+ FAE6 ED 5B C2 FA      LD DE, (BellNextFrame)
 356+ FAEA B7               OR A
 357+ FAEB ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 358+ FAED D8               RET C                       ; FRAMES < deadline → aun no toca
 359+ FAEE
 360+ FAEE                  ; Sonar campanada (AY, no bloquea CPU)
 361+ FAEE C5               PUSH BC
 362+ FAEF D5               PUSH DE
 363+ FAF0 CD D2 98         CALL AY_PlayBellChime
 364+ FAF3 D1               POP DE
 365+ FAF4 C1               POP BC
 366+ FAF5
 367+ FAF5                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 368+ FAF5                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 369+ FAF5 2A 78 5C         LD HL, (SYS_FRAMES)
 370+ FAF8 11 4B 00         LD DE, BELL_PAUSE
 371+ FAFB 19               ADD HL, DE
 372+ FAFC 22 C2 FA         LD (BellNextFrame), HL
 373+ FAFF
 374+ FAFF 21 C1 FA         LD HL, BellCount
 375+ FB02 35               DEC (HL)
 376+ FB03 C0               RET NZ
 377+ FB04 18 00            JR .bellsDone
 378+ FB06
 379+ FB06              .bellsDone:
 380+ FB06                  ; Ultima campanada:
 381+ FB06                  ;   1) matar todos los nasties vivos (puff)
 382+ FB06                  ;   2) arrancar cadena diferida: windows off → monster spawn
 383+ FB06 CD 4D BA         CALL KillAllActiveNasties
 384+ FB09 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 385+ FB0B 32 C4 FA         LD (BellsDoneTimer), A
 386+ FB0E C9               RET
 387+ FB0F
 388+ FB0F              ; ==============================================================================
 389+ FB0F              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 390+ FB0F              ; ==============================================================================
 391+ FB0F              ; Maneja la cadena diferida tras la ultima campanada:
 392+ FB0F              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 393+ FB0F              ;      y arranca SpawnAfterWinTimer
 394+ FB0F              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 395+ FB0F              ; ==============================================================================
 396+ FB0F              UpdateBellsDoneTimer:
 397+ FB0F 3A C4 FA         LD A, (BellsDoneTimer)
 398+ FB12 B7               OR A
 399+ FB13 28 21            JR Z, .ubdCheckSpawn
 400+ FB15 3D               DEC A
 401+ FB16 32 C4 FA         LD (BellsDoneTimer), A
 402+ FB19 20 1B            JR NZ, .ubdCheckSpawn
 403+ FB1B                  ; Llego a 0: apagar ventanas
 404+ FB1B CD F3 E3         CALL UpdateRemapTables
 405+ FB1E 3E 01            LD A, 1
 406+ FB20 32 13 83         LD (AttrsDirty), A
 407+ FB23                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 408+ FB23                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 409+ FB23                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 410+ FB23                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 411+ FB23 3A B3 82         LD A, (ChurchDoorOpen)
 412+ FB26 B7               OR A
 413+ FB27 28 03            JR Z, .ubdSkipHighlight
 414+ FB29 CD C7 F3         CALL StartStatueBlink
 415+ FB2C              .ubdSkipHighlight:
 416+ FB2C                  ; Armar el gating: SpawnAfterWinTimer = 1 = "esperando a que Tension
 417+ FB2C                  ; termine para spawnear". El check real esta en .ubdCheckSpawn (mira
 418+ FB2C                  ; MusicTimer del driver tabular). Cuando Tension acaba (MusicTimer
 419+ FB2C                  ; pasa a 0), dispara SpawnMonsters. Asi el primer monster aparece
 420+ FB2C                  ; tras Tension + el natural ~0.8s de MONSTER_ENTRY_BASE -> "calma
 421+ FB2C                  ; antes de la tormenta".
 422+ FB2C 3E 01            LD A, 1
 423+ FB2E 32 C5 FA         LD (SpawnAfterWinTimer), A
 424+ FB31                  ; Musica de tension organica entre lights-off y monster spawn (track 0)
 425+ FB31 AF               XOR A                           ; A = 0 = MUSIC_TENSION
 426+ FB32 CD BC 99         CALL StartMusic
 427+ FB35 C9               RET
 428+ FB36              .ubdCheckSpawn:
 429+ FB36 3A C5 FA         LD A, (SpawnAfterWinTimer)
 430+ FB39 B7               OR A
 431+ FB3A C8               RET Z                           ; no armado (boot, ya disparado, etc.)
 432+ FB3B                  ; Gating dinamico: esperar a que MusicTimer del driver tabular llegue
 433+ FB3B                  ; a 0. Indica que Tension (la musica activa) acaba de terminar (su
 434+ FB3B                  ; ultima nota se cumplio y MusicEndOfTable.meotStop puso Timer=0).
 435+ FB3B                  ; Robusto a cambios de duracion en TensionMusicTable.
 436+ FB3B 3A A8 7B         LD A, (MusicTimer)
 437+ FB3E B7               OR A
 438+ FB3F C0               RET NZ                          ; Tension aun sonando
 439+ FB40                  ; Tension acabo: rearmar y disparar spawn.
 440+ FB40 AF               XOR A
 441+ FB41 32 C5 FA         LD (SpawnAfterWinTimer), A
 442+ FB44 C3 6C BD         JP SpawnMonsters
 443+ FB47
 444+ FB47              ; ==============================================================================
 445+ FB47              ; MonstersMusic - Secuencer ad-hoc para una nota grave repetida
 446+ FB47              ; ==============================================================================
 447+ FB47              ; Ritmo "po-po-popo-po": 5 hits con gaps definidos en MonstersBeatGaps. Cada
 448+ FB47              ; hit dispara AY_PlayBeep(period=$0688 ~C2, dur=4f) en canal B AY (~160ms).
 449+ FB47              ; Loopable. Arrancado desde SpawnMonsters (StartMonstersMusic). Detenido al
 450+ FB47              ; sunrise (StopMonstersMusic).
 451+ FB47              ;
 452+ FB47              ; NO usa el driver tabular ni reserva nada en slot 1 — el patron es puro
 453+ FB47              ; codigo. Variables (Timer + Step) viven al final de esta rutina (bank 0).
 454+ FB47              ;
 455+ FB47              ; Para iterar: ajustar MonstersBeatGaps (frames entre hits) o el period en
 456+ FB47              ; UpdateMonstersMusic (LD HL, $0688) para cambiar el tono.
 457+ FB47              ; ==============================================================================
 458+ FB47
 459+ FB47              ; --- StartMonstersMusic: arranca el secuencer ---
 460+ FB47              ; Se llama desde SpawnMonsters una vez por noche. Setea Step=0 + Timer=1
 461+ FB47              ; para que el primer hit suene en el frame siguiente.
 462+ FB47              StartMonstersMusic:
 463+ FB47 AF               XOR A
 464+ FB48 32 85 FB         LD (MonstersMusicStep), A       ; Step = 0 → primer hit
 465+ FB4B 3C               INC A
 466+ FB4C 32 84 FB         LD (MonstersMusicTimer), A      ; Timer = 1 → suena ya en proximo update
 467+ FB4F C9               RET
 468+ FB50
 469+ FB50              ; --- StopMonstersMusic: detiene el secuencer ---
 470+ FB50              ; Se llama al sunrise (day_cycle.asm fase 5). Step=$FF actua como sentinel
 471+ FB50              ; "inactivo" en UpdateMonstersMusic (INC A → 0 → RET Z).
 472+ FB50              StopMonstersMusic:
 473+ FB50 3E FF            LD A, $FF
 474+ FB52 32 85 FB         LD (MonstersMusicStep), A
 475+ FB55 C9               RET
 476+ FB56
 477+ FB56              ; --- UpdateMonstersMusic: tick por frame desde MainLoop ---
 478+ FB56              ; Si activo, decrementa Timer; cuando llega a 0, dispara AY_PlayBeep y
 479+ FB56              ; avanza Step (con wrap a 0 al pasar de 4). Si Step=$FF, no-op.
 480+ FB56              UpdateMonstersMusic:
 481+ FB56 3A 85 FB         LD A, (MonstersMusicStep)
 482+ FB59 3C               INC A
 483+ FB5A C8               RET Z                           ; $FF + INC = 0 → inactivo
 484+ FB5B 3D               DEC A                           ; restaurar Step real
 485+ FB5C 21 84 FB         LD HL, MonstersMusicTimer
 486+ FB5F 35               DEC (HL)
 487+ FB60 C0               RET NZ                          ; aun esperando proximo hit
 488+ FB61                  ; Hora del proximo "po": leer gap[Step] -> Timer
 489+ FB61 21 7F FB         LD HL, MonstersBeatGaps
 490+ FB64 5F               LD E, A
 491+ FB65 16 00            LD D, 0
 492+ FB67 19               ADD HL, DE
 493+ FB68 7E               LD A, (HL)
 494+ FB69 32 84 FB         LD (MonstersMusicTimer), A
 495+ FB6C                  ; Avanzar Step con wrap a 0 al llegar a 5
 496+ FB6C 21 85 FB         LD HL, MonstersMusicStep
 497+ FB6F 34               INC (HL)
 498+ FB70 7E               LD A, (HL)
 499+ FB71 FE 05            CP 5
 500+ FB73 38 02            JR C, .ummDoBeep
 501+ FB75 AF               XOR A
 502+ FB76 77               LD (HL), A                      ; wrap: Step=0 → vuelve al inicio del patron
 503+ FB77              .ummDoBeep:
 504+ FB77 21 88 06         LD HL, $0688                    ; period AY canal B (~C2 = 65 Hz, grave)
 505+ FB7A 06 03            LD B, 3                         ; cutoff a 3 frames (~120ms) -> "po" staccato medio
 506+ FB7C C3 D2 6A         JP AY_PlayBeep                  ; tail-call
 507+ FB7F
 508+ FB7F              ; --- Datos del patron "po-po-popo-po" ---
 509+ FB7F              ; Frames entre hits consecutivos. Total = 12+12+4+8+26 = 62 frames = ~2.48s/loop.
 510+ FB7F              ; Beat 1: po (gap 12 hasta beat 2)
 511+ FB7F              ; Beat 2: po (gap 12 hasta beat 3.0)
 512+ FB7F              ; Beat 3.0: po (gap 4 hasta beat 3.5 = corchea)
 513+ FB7F              ; Beat 3.5: po (gap 8 hasta beat 4)
 514+ FB7F              ; Beat 4: po (gap 26 hasta beat 1 = loop — pausa larga al final)
 515+ FB7F              MonstersBeatGaps:
 516+ FB7F 0C 0C 04 08      DEFB 12, 12, 4, 8, 26
 516+ FB83 1A
 517+ FB84
 518+ FB84 00           MonstersMusicTimer: DEFB 0
 519+ FB85 FF           MonstersMusicStep:  DEFB $FF             ; $FF = inactivo (sentinel)
 520+ FB86
# file closed: sound.asm
