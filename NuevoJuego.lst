 366+ E59A              ; ==============================================================================
 367+ E59A              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E59A              ; ==============================================================================
 369+ E59A              ; Entrada: A = sprite ID
 370+ E59A              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E59A              ; Preserva: A, DE, IX
 372+ E59A              ;
 373+ E59A              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E59A              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E59A              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E59A              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E59A              ; ==============================================================================
 378+ E59A              CheckIfHouseSprite:
 379+ E59A F5               PUSH AF
 380+ E59B E5               PUSH HL
 381+ E59C C5               PUSH BC
 382+ E59D
 383+ E59D 47               LD B, A                     ; B = id buscado
 384+ E59E
 385+ E59E AF               XOR A
 386+ E59F 32 FB E3         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E5A2
 388+ E5A2 21 B3 E0         LD HL, HouseIdList
 389+ E5A5              .checkLoop:
 390+ E5A5 7E               LD A, (HL)
 391+ E5A6 FE FF            CP $FF
 392+ E5A8 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E5AA B8               CP B
 394+ E5AB 28 03            JR Z, .checkFound
 395+ E5AD 23               INC HL
 396+ E5AE 18 F5            JR .checkLoop
 397+ E5B0
 398+ E5B0              .checkFound:
 399+ E5B0 3E 01            LD A, 1
 400+ E5B2 32 FB E3         LD (BgSpriteIsHouse), A
 401+ E5B5
 402+ E5B5              .checkDone:
 403+ E5B5 C1               POP BC
 404+ E5B6 E1               POP HL
 405+ E5B7 F1               POP AF
 406+ E5B8 C9               RET
