 302+ 9F5C
 303+ 9F5C                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 304+ 9F5C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 305+ 9F5F DD BE 0C         CP (IX+ENT_OLDX)
 306+ 9F62 20 3C            JR NZ, .plDoErase
 307+ 9F64 3A D5 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 308+ 9F67 DD BE 0D         CP (IX+ENT_OLDY)
 309+ 9F6A 20 34            JR NZ, .plDoErase
 310+ 9F6C DD 7E 00         LD A, (IX+ENT_SPRITEID)
 311+ 9F6F DD BE 0E         CP (IX+ENT_OLDSPRID)
 312+ 9F72 20 2C            JR NZ, .plDoErase
 313+ 9F74                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 314+ 9F74 3A ED C4         LD A, (PlayerHitTimer)
 315+ 9F77 B7               OR A
 316+ 9F78 20 01            JR NZ, .plRepaintAttr
 317+ 9F7A C9               RET                                 ; Nada cambio → skip todo
 318+ 9F7B              .plRepaintAttr:
 319+ 9F7B 3A D5 82         LD A, (PlayerDrawY)
 320+ 9F7E 57               LD D, A
 321+ 9F7F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 322+ 9F82 5F               LD E, A
 323+ 9F83 DD E5            PUSH IX
 324+ 9F85 CD BC A4         CALL GetSpriteAddr
 325+ 9F88 DD 2A EB A4      LD IX, (SpriteAddrTemp)
 326+ 9F8C CD FD 9A         CALL CalcEntityAttrSize
