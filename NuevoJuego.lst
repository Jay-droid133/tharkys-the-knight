 102  A874                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ A874              ; ==============================================================================
   2+ A874              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ A874              ; ==============================================================================
   4+ A874              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ A874              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ A874              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ A874              ; ==============================================================================
   8+ A874
   9+ A874              ; ==============================================================================
  10+ A874              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ A874              ; ==============================================================================
  12+ A874              InitScreenSystem:
  13+ A874 3E 08            LD A, START_SCREEN_X
  14+ A876 32 AC 81         LD (CurrentScreenX), A
  15+ A879 3E 08            LD A, START_SCREEN_Y
  16+ A87B 32 AD 81         LD (CurrentScreenY), A
  17+ A87E 3E 01            LD A, 1
  18+ A880 32 B1 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ A883 AF               XOR A
  20+ A884 32 B0 81         LD (ScreenTransition), A
  21+ A887 CD 8B A8         CALL CalcScreenAddress
  22+ A88A C9               RET
  23+ A88B
  24+ A88B              ; ==============================================================================
  25+ A88B              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ A88B              ; ==============================================================================
  27+ A88B              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ A88B              ; ==============================================================================
  29+ A88B              CalcScreenAddress:
  30+ A88B 3A AD 81         LD A, (CurrentScreenY)
  31+ A88E 6F               LD L, A
  32+ A88F 26 00            LD H, 0
  33+ A891 29               ADD HL, HL                  ; x2
  34+ A892 29               ADD HL, HL                  ; x4
  35+ A893 29               ADD HL, HL                  ; x8
  36+ A894 29               ADD HL, HL                  ; x16
  37+ A895 3A AC 81         LD A, (CurrentScreenX)
  38+ A898 5F               LD E, A
  39+ A899 16 00            LD D, 0
  40+ A89B 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ A89C 11 75 B1         LD DE, MapTable
  42+ A89F 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ A8A0 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ A8A1                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ A8A1 6F               LD L, A
  46+ A8A2 26 00            LD H, 0
  47+ A8A4 29               ADD HL, HL                  ; index * 2
  48+ A8A5 11 13 B1         LD DE, RoomTable
  49+ A8A8 19               ADD HL, DE
  50+ A8A9 5E               LD E, (HL)
  51+ A8AA 23               INC HL
  52+ A8AB 56               LD D, (HL)                  ; DE = puntero a room data
  53+ A8AC ED 53 AE 81      LD (CurrentScreenAddr), DE
  54+ A8B0 C9               RET
  55+ A8B1
  56+ A8B1              ; ==============================================================================
  57+ A8B1              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  58+ A8B1              ; ==============================================================================
  59+ A8B1              CheckScreenTransition:
  60+ A8B1 AF               XOR A
  61+ A8B2 32 B0 81         LD (ScreenTransition), A
  62+ A8B5
  63+ A8B5                  ; --- Comprobar borde OESTE (izquierdo) ---
  64+ A8B5 3A 85 80         LD A, (EntityTable + ENT_POSX)
  65+ A8B8 FE 04            CP TRANSITION_ZONE
  66+ A8BA 30 16            JR NC, .noWest
  67+ A8BC 3A AC 81         LD A, (CurrentScreenX)
  68+ A8BF B7               OR A
  69+ A8C0 28 10            JR Z, .noWest
  70+ A8C2 3D               DEC A
  71+ A8C3 32 AC 81         LD (CurrentScreenX), A
  72+ A8C6 3E 08            LD A, DIR_W
  73+ A8C8 32 B0 81         LD (ScreenTransition), A
  74+ A8CB 3E E0            LD A, SCREEN_MAX_X - 8
  75+ A8CD 32 85 80         LD (EntityTable + ENT_POSX), A
  76+ A8D0 18 57            JR .doTransition
  77+ A8D2
  78+ A8D2              .noWest:
  79+ A8D2                  ; --- Comprobar borde ESTE (derecho) ---
  80+ A8D2 3A 85 80         LD A, (EntityTable + ENT_POSX)
  81+ A8D5 FE E8            CP SCREEN_MAX_X
  82+ A8D7 38 17            JR C, .noEast
  83+ A8D9 3A AC 81         LD A, (CurrentScreenX)
  84+ A8DC FE 0F            CP MAP_WIDTH - 1
  85+ A8DE 28 10            JR Z, .noEast
  86+ A8E0 3C               INC A
