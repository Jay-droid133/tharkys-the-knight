 706+ E6CA              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 707+ E6CA              ; A = codigo ASCII, E = columna (0-31)
 708+ E6CA              DrawHudCharRow0:
 709+ E6CA 6F               LD L, A
 710+ E6CB 26 00            LD H, 0
 711+ E6CD 29               ADD HL, HL
 712+ E6CE 29               ADD HL, HL
 713+ E6CF 29               ADD HL, HL
 714+ E6D0 01 00 3C         LD BC, $3C00
 715+ E6D3 09               ADD HL, BC                  ; HL = font data
 716+ E6D4 16 40            LD D, $40                   ; Tercio 0, scan line 0
 717+ E6D6 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 718+ E6D7 5F               LD E, A                     ; DE = dir VRAM
 719+ E6D8 06 08            LD B, 8
 720+ E6DA              .row0Char:
 721+ E6DA 7E               LD A, (HL)
 722+ E6DB 12               LD (DE), A
 723+ E6DC 23               INC HL
 724+ E6DD 14               INC D                       ; siguiente scan line
 725+ E6DE 10 FA            DJNZ .row0Char
 726+ E6E0 C9               RET
