 271+ 9AE4              .rowLoop:
 272+ 9AE4                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE4 E5               PUSH HL
 274+ 9AE5 7C               LD A, H
 275+ 9AE6 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
