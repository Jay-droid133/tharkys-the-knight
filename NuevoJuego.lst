 590+ 6972              ; ==============================================================================
 591+ 6972              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 592+ 6972              ; ==============================================================================
 593+ 6972              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 594+ 6972              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 595+ 6972              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 596+ 6972              ;   2. Leer charX/charY de la entry
 597+ 6972              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 598+ 6972              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 599+ 6972              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 600+ 6972              ;   6. ChurchDoorOpen = 0
 601+ 6972              ; ==============================================================================
 602+ 6972              CloseChurchDoor:
 603+ 6972                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
 604+ 6972                  ; ambos sentidos). Suena ANTES del cambio visual.
 605+ 6972 21 66 FA         LD HL, SFX_ChurchDoorOpen
 606+ 6975 CD 4F F9         CALL PlaySFX
 607+ 6978 11 AB E2         LD DE, BgGfx_old_church_door_open
 608+ 697B CD 05 6A         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 609+ 697E 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 610+ 6980                  ; Leer charX (HL+4) y charY (HL+5) en BC
 611+ 6980 E5               PUSH HL                                 ; save mapX ptr
 612+ 6981 01 04 00         LD BC, 4
 613+ 6984 09               ADD HL, BC
 614+ 6985 46               LD B, (HL)                              ; B = charX
 615+ 6986 23               INC HL
 616+ 6987 4E               LD C, (HL)                              ; C = charY
 617+ 6988 E1               POP HL                                  ; HL = mapX ptr
 618+ 6989                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 619+ 6989 E5               PUSH HL
 620+ 698A C5               PUSH BC
 621+ 698B 21 AB E2         LD HL, BgGfx_old_church_door_open
 622+ 698E 3E 03            LD A, 3
 623+ 6990 CD 8F 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 624+ 6993 C1               POP BC
 625+ 6994 C5               PUSH BC
 626+ 6995 DD 21 9B 89      LD IX, BgSpriteBuffer
 627+ 6999 CD 69 DE         CALL DrawBgSpriteXOR                    ; borra
 628+ 699C C1               POP BC
 629+ 699D E1               POP HL
 630+ 699E                  ; --- Patch ptr: open -> closed ---
 631+ 699E 23               INC HL
 631+ 699F 23             INC HL                         ; -> ptr_lo
 632+ 69A0 3E F2            LD A, LOW BgGfx_old_church_door_closed
 633+ 69A2 77               LD (HL), A
 634+ 69A3 23               INC HL
 635+ 69A4 3E E1            LD A, HIGH BgGfx_old_church_door_closed
 636+ 69A6 77               LD (HL), A
 637+ 69A7                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 638+ 69A7 C5               PUSH BC
 639+ 69A8 21 F2 E1         LD HL, BgGfx_old_church_door_closed
 640+ 69AB 3E 03            LD A, 3
 641+ 69AD CD 8F 6A         CALL LoadBgSpriteToBuffer
 642+ 69B0 C1               POP BC
 643+ 69B1 C5               PUSH BC
 644+ 69B2 DD 21 9B 89      LD IX, BgSpriteBuffer
 645+ 69B6 CD 69 DE         CALL DrawBgSpriteXOR
 646+ 69B9 C1               POP BC
 647+ 69BA DD 21 9B 89      LD IX, BgSpriteBuffer
 648+ 69BE AF               XOR A
 649+ 69BF 32 52 E5         LD (BgSpriteIsHouse), A
 650+ 69C2 CD AE DE         CALL DrawBgAttrOnly
 651+ 69C5              .ccdFlag:
 652+ 69C5 AF               XOR A
 653+ 69C6 32 61 82         LD (ChurchDoorOpen), A
 654+ 69C9 C9               RET
