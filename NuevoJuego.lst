 466  EDC2                  INCLUDE "milestones.asm"
# file opened: code/milestones.asm
   1+ EDC2              ; ==============================================================================
   2+ EDC2              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EDC2              ; ==============================================================================
   4+ EDC2              ; CurrentObjective vive en variables.asm. Valor:
   5+ EDC2              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EDC2              ;   11    = todos los hitos completados (juego ganado)
   7+ EDC2              ;
   8+ EDC2              ; ----------------------------------------------------------------------------
   9+ EDC2              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EDC2              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EDC2              ;                       recoger el sprite cuyo behavior coincide.
  12+ EDC2              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EDC2              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EDC2              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EDC2              ;
  16+ EDC2              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EDC2              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EDC2              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EDC2              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EDC2              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EDC2              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EDC2              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EDC2              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EDC2              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EDC2              ;
  26+ EDC2              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EDC2              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EDC2              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EDC2              ;
  30+ EDC2              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  31+ EDC2              ; util para probar la cadena entera mientras los hitos 7, 9, 11 no tienen
  32+ EDC2              ; mecanica real (todos los SPECIAL/TRIGGER customs estan en cinematicas).
  33+ EDC2              ; ==============================================================================
  34+ EDC2
  35+ EDC2              MILESTONE_TYPE_PICKUP   EQU 1
  36+ EDC2              MILESTONE_TYPE_TRIGGER  EQU 2
  37+ EDC2              MILESTONE_TYPE_SPECIAL  EQU 3
  38+ EDC2
  39+ EDC2              MilestoneTable:
  40+ EDC2 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  41+ EDC4 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  42+ EDC6 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  43+ EDC8 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  44+ EDCA 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  45+ EDCC 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  46+ EDCE 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  47+ EDD0 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque del banco (dinamica)
  48+ EDD2 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  49+ EDD4 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  50+ EDD6 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  51+ EDD8
  52+ EDD8              MilestoneResolveTable:
  53+ EDD8 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  54+ EDDA 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  55+ EDDC 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  56+ EDDE 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  57+ EDE0 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  58+ EDE2 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  59+ EDE4 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  60+ EDE6 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  61+ EDE8 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  62+ EDEA 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  63+ EDEC 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  64+ EDEE
  65+ EDEE              ; ==============================================================================
  66+ EDEE              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  67+ EDEE              ; ==============================================================================
  68+ EDEE              ; IN:  A = key id (1..6) recien recogida
