 172  7A57
 173  7A57                  ; --- Music IRQ handler + driver musica (slot 1) ---
 174  7A57                  ; Tabla IM 2 en $7A00, JP en $7B7B, handler en $7B7E. State + tablas + tick
 175  7A57                  ; al final del archivo. Ver music_irq.asm. Independiza el ritmo musical de
 176  7A57                  ; la latencia de MainLoop sin paginar slot 3 desde el handler.
 177  7A57                  INCLUDE "music_irq.asm"
# file opened: code/music_irq.asm
   1+ 7A57              ; ==============================================================================
   2+ 7A57              ; MUSIC_IRQ - IM 2 handler para tick de musica a 25 Hz
   3+ 7A57              ; ==============================================================================
   4+ 7A57              ; Vive en slot 1 ($7A00+, contended pero siempre visible).
   5+ 7A57              ;
   6+ 7A57              ; Por que existe: la latencia de MainLoop (especialmente en transiciones de
   7+ 7A57              ; pantalla, ~200 ms) provocaba que la musica avanzara N notas en una sola
   8+ 7A57              ; iteracion, escribiendo solo el ultimo period al AY. El usuario percibia
   9+ 7A57              ; notas "saltadas" o ritmo desplazado. Con IM 2 + handler propio, el tick de
  10+ 7A57              ; musica ocurre cada 2 IRQs (= 25 Hz) independientemente de la carga del
  11+ 7A57              ; MainLoop. Las escrituras AY caen en el wall-clock exacto, ritmo intacto.
  12+ 7A57              ;
  13+ 7A57              ; IM 2 setup (Inicio):
  14+ 7A57              ;   I = $7A
  15+ 7A57              ;   Tabla 257 bytes en $7A00-$7B00, todos $7B (cualquier byte del data bus
  16+ 7A57              ;     da vector = $7B7B).
  17+ 7A57              ;   $7B7B: JP MusicIrqHandler.
  18+ 7A57              ;
  19+ 7A57              ; Race condition con AY desde MainLoop: las rutinas que escriben AY desde
  20+ 7A57              ; gameplay (StartMusic thunk, AY_PlayBeep, AY_PlayBellChime, etc.) ya hacen
  21+ 7A57              ; DI/EI alrededor de sus AY OUTs, asi que no son interrumpidas. Las
  22+ 7A57              ; escrituras AY desde el IRQ handler no necesitan DI extra (CPU ya tiene
  23+ 7A57              ; interrupts deshabilitados al entrar al handler).
  24+ 7A57              ; ==============================================================================
  25+ 7A57
  26+ 7A57              ; --- Vector table (257 bytes all $7B) ---
  27+ 7A57              ; Cualquier byte del data bus da vector = $7B7B (.im2Vector).
  28+ 7A57                  ORG $7A00
  29+ 7A00              .im2Table:
  30+ 7A00 7B 7B 7B...      DEFS 257, $7B                       ; $7A00-$7B00 inclusive
  31+ 7B01
  32+ 7B01              ; --- Vector target: JP MusicIrqHandler ---
  33+ 7B01                  ORG $7B7B
  34+ 7B7B              .im2Vector:
  35+ 7B7B C3 7E 7B         JP MusicIrqHandler
  36+ 7B7E
  37+ 7B7E              ; --- IRQ handler proper ---
  38+ 7B7E              ; Cada IRQ:
  39+ 7B7E              ;   1. INC $5C78 (system frames counter — ROM IRQ no se ejecuta con IM 2).
  40+ 7B7E              ;   2. Toggle MusicIrqDivisor: solo tickea musica cada 2 IRQs (= 25 Hz).
  41+ 7B7E              ;   3. Si toca tick: CALL UpdateMusicTick (en slot 1, sin paginar nada).
  42+ 7B7E              ;   4. EI + RET.
  43+ 7B7E              ;
  44+ 7B7E              ; Atomicidad: el handler NO toca slot 3, asi que los PUSH/POP del propio
  45+ 7B7E              ; handler operan sobre el mismo bank fisico de principio a fin —
  46+ 7B7E              ; inmune al race con MainLoop que paga slots sin DI.
  47+ 7B7E              ;
  48+ 7B7E              ; Coste: ~80 T-states en frame skip (no tick), ~250 T-states en frame tick.
  49+ 7B7E              ; Per-second: ~12500 T = 0.36% del CPU. Despreciable.
  50+ 7B7E              MusicIrqHandler:
  51+ 7B7E F5               PUSH AF
  52+ 7B7F C5               PUSH BC
  53+ 7B80 D5               PUSH DE
  54+ 7B81 E5               PUSH HL
  55+ 7B82
  56+ 7B82                  ; --- Increment $5C78 ---
  57+ 7B82 21 78 5C         LD HL, $5C78
  58+ 7B85 34               INC (HL)
  59+ 7B86 20 02            JR NZ, .mihNoWrap
  60+ 7B88 23               INC HL
  61+ 7B89 34               INC (HL)
  62+ 7B8A              .mihNoWrap:
  63+ 7B8A
  64+ 7B8A                  ; --- Toggle divisor (25 Hz) ---
  65+ 7B8A 21 A2 7B         LD HL, MusicIrqDivisor
  66+ 7B8D 7E               LD A, (HL)
  67+ 7B8E EE 01            XOR 1
  68+ 7B90 77               LD (HL), A
  69+ 7B91 28 09            JR Z, .mihEpilogue
  70+ 7B93
  71+ 7B93                  ; --- Tick SFX + MUSICA (slot 1, siempre visible). ---
  72+ 7B93                  ; SFX countdown (Beep, PlayerHit) tickea aqui para inmunizar la duracion
  73+ 7B93                  ; al wall-clock (commit 1759338: "TIC del compass no se estira en
  74+ 7B93                  ; transiciones").
  75+ 7B93                  ;
  76+ 7B93                  ; La MUSICA tambien tickea aqui (avance de nota + re-arm AY). Asi el ritmo
  77+ 7B93                  ; sigue exacto durante DrawScreen/transiciones de pantalla, donde MainLoop
  78+ 7B93                  ; queda bloqueado varios frames y antes la nota actual se "alargaba" hasta
  79+ 7B93                  ; que MainLoop volvia y hacia catchup.
  80+ 7B93                  ;
  81+ 7B93                  ; Concurrencia AY: TODAS las escrituras al AY desde MainLoop estan
  82+ 7B93                  ; envueltas en DI/EI (auditoria en ay_sound_thunks.asm + sfx_player_hit_ay
  83+ 7B93                  ; .asm). Por tanto el handler IRQ nunca cae a media secuencia
  84+ 7B93                  ; select($FFFD)+data($BFFD) y no corrompe el index del AY.
  85+ 7B93                  ;
  86+ 7B93                  ; Inline tick: equivale a CALL UpdateMusicTick pero ahorra el stub (-3 B).
  87+ 7B93 CD 34 6E         CALL AY_UpdatePlayerHit
  88+ 7B96 CD 45 7E         CALL UpdateMusicImpl.upmiTickOnce
  89+ 7B99 CD D4 7D         CALL UpdateMusicImpl.upmiPostLoop
