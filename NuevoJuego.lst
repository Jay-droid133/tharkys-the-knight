4211+ B997              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
4212+ B997              ; ==============================================================================
4213+ B997              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
4214+ B997              ; ENT_DIR contiene el ANIMBASE real del enemigo.
4215+ B997              ; Cuando el ultimo frame expira → restaura sprite real y activa movimiento.
4216+ B997              ; ==============================================================================
4217+ B997              UpdateSpawning:
4218+ B997 DD 35 09         DEC (IX+ENT_ANIMTIMER)
4219+ B99A 20 39            JR NZ, .spAnimDone
