1062+ A4C3              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A4C3              ; ==============================================================================
1064+ A4C3              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A4C3              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A4C3              ; ==============================================================================
1067+ A4C3              GetSpriteAddr:
1068+ A4C3                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A4C3                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A4C3 3A 82 8D         LD A, (CurrentPaging)
1071+ A4C6 E6 F8            AND $F8
1072+ A4C8 F6 06            OR 6
1073+ A4CA 32 82 8D         LD (CurrentPaging), A
1074+ A4CD 01 FD 7F         LD BC, $7FFD
1075+ A4D0 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A4D2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A4D5 6F               LD L, A
1078+ A4D6 26 00            LD H, 0
1079+ A4D8 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A4D9 11 B7 E7         LD DE, SpriteFrameTable
1081+ A4DC 19               ADD HL, DE
1082+ A4DD 5E               LD E, (HL)
1083+ A4DE 23               INC HL
1084+ A4DF 56               LD D, (HL)
1085+ A4E0 ED 53 F2 A4      LD (SpriteAddrTemp), DE
1086+ A4E4 3A 82 8D         LD A, (CurrentPaging)
1087+ A4E7 E6 F8            AND $F8
1088+ A4E9 32 82 8D         LD (CurrentPaging), A
1089+ A4EC 01 FD 7F         LD BC, $7FFD
1090+ A4EF ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A4F1 C9               RET
1092+ A4F2
1093+ A4F2 00 00        SpriteAddrTemp: DEFW 0
1094+ A4F4
1095+ A4F4              ; ==============================================================================
1096+ A4F4              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1097+ A4F4              ; ==============================================================================
1098+ A4F4              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1099+ A4F4              ; Salida:   DE = puntero al sprite data
1100+ A4F4              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1101+ A4F4              ; Preserva: IX
1102+ A4F4              ; Destruye: A, HL
1103+ A4F4              ; ==============================================================================
1104+ A4F4              GetOldSpriteAddr:
1105+ A4F4                  ; Paging inline (ver GetSpriteAddr)
1106+ A4F4 3A 82 8D         LD A, (CurrentPaging)
