 641+ 6384              ; ==============================================================================
 642+ 6384              ; TownGateRedrawPart1 - re-pinta el lintel arco (id 247) sobre el player
 643+ 6384              ; ==============================================================================
 644+ 6384              ; Llamado per-step en el slide-down mientras player overlapea verticalmente
 645+ 6384              ; con part1. DrawBgGfxSprite es direct write — sobreescribe pixels del player
 646+ 6384              ; en TODA la zona de part1, no solo donde part1 tiene contenido. Visualmente
 647+ 6384              ; el player desaparece "dentro" del rect de part1 (lo que el usuario quiere).
 648+ 6384              ; Bank 3 (sprite baseline town).
 649+ 6384              ; ==============================================================================
 650+ 6384              TownGateRedrawPart1:
 651+ 6384 21 F0 E9         LD HL, BgGfx_town_gate_v3_part1
 652+ 6387 3E 03            LD A, 3
 653+ 6389 CD BD 90         CALL LoadBgSpriteToBuffer
 654+ 638C DD 21 F5 88      LD IX, BgSpriteBuffer
 655+ 6390 06 0A            LD B, TGCS_PART1_CHARX
 656+ 6392 0E 0D            LD C, TGCS_PART1_CHARY
 657+ 6394 AF               XOR A
 658+ 6395 32 74 DD         LD (BgSpriteIsHouse), A
 659+ 6398 32 85 CE         LD (CurrentTintVar), A
 660+ 639B C3 7B CD         JP DrawBgGfxSprite
 661+ 639E
 662+ 639E              ; ==============================================================================
 663+ 639E              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 664+ 639E              ; ==============================================================================
 665+ 639E              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 666+ 639E              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 667+ 639E              ; y abajo se dibujan normal (XOR).
 668+ 639E              ;
 669+ 639E              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 670+ 639E              ; - Encima del arco (POSY+20 < 120): full draw.
 671+ 639E              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 672+ 639E              ;   inferiores que pasan tras el lintel skipped.
 673+ 639E              ; - Totalmente dentro (POSY 120..131): nada drawn.
 674+ 639E              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 675+ 639E              ;   lintel skipped.
 676+ 639E              ; - Bajo del arco (POSY >= 152): full draw.
 677+ 639E              ;
 678+ 639E              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 679+ 639E              ;     Bank 6 paginado al entrar (caller).
 680+ 639E              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 681+ 639E              ; Destruye: AF, BC, DE, HL, IY.
 682+ 639E              ; ==============================================================================
 683+ 639E              PLAYER_H_PX              EQU 21
 684+ 639E
 685+ 639E              TownGatePlayerXOR_BiClip:
 686+ 639E FD 23            INC IY
 687+ 63A0 FD 23            INC IY                              ; skip header
 688+ 63A2 D5               PUSH DE
 689+ 63A3 CD 1C A1         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 690+ 63A6 D1               POP DE
 691+ 63A7 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 692+ 63A9 4A               LD C, D                             ; C = current pixel Y
 693+ 63AA              .tgpxbcRow:
 694+ 63AA 79               LD A, C
 695+ 63AB FE C0            CP 192
 696+ 63AD 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 697+ 63AF                                                      ; (sin este clip, NextPixelLine lleva
 698+ 63AF                                                      ; HL a $5800+ = area de attrs → XOR
 699+ 63AF                                                      ; corrompe attrs como flashes raros).
 700+ 63AF FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 701+ 63B1 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 702+ 63B3 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 703+ 63B5 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 704+ 63B7                  ; In [120, 151] → skip pixels en esta row
 705+ 63B7 18 0C            JR .tgpxbcAdvance
 706+ 63B9              .tgpxbcDraw:
 707+ 63B9                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 708+ 63B9                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 709+ 63B9 FD 7E 00         LD A, (IY+0)
 710+ 63BC AE               XOR (HL)
 711+ 63BD 77               LD (HL), A
 712+ 63BE 23               INC HL
 713+ 63BF FD 7E 01         LD A, (IY+1)
 714+ 63C2 AE               XOR (HL)
 715+ 63C3 77               LD (HL), A
 716+ 63C4 2B               DEC HL                              ; back to row start
 717+ 63C5              .tgpxbcAdvance:
 718+ 63C5 FD 23            INC IY
 719+ 63C7 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 720+ 63C9 0C               INC C                               ; pixel Y += 1
 721+ 63CA C5               PUSH BC
 722+ 63CB CD 88 9E         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 723+ 63CE C1               POP BC
 724+ 63CF 10 D9            DJNZ .tgpxbcRow
 725+ 63D1 C9               RET
