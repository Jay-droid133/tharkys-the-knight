2851+ B294                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2852+ B294                  ;
2853+ B294                  ; Doble comportamiento:
2854+ B294                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2855+ B294                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2856+ B294                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2857+ B294                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2858+ B294                  ;   y lo activa).
2859+ B294                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2860+ B294                  ;   El monster queda en destino (memoria) hasta que el player visite.
2861+ B294                  ;
2862+ B294                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2863+ B294                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2864+ B294 DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2865+ B297 32 D8 B2         LD (.moKbSavedDir), A
2866+ B29A 3E 01            LD A, 1
2867+ B29C 32 15 B6         LD (MonsterKbDespawn), A
2868+ B29F                  ; Calcular slot (0-2) en E, D=0
2869+ B29F DD E5            PUSH IX
2870+ B2A1 E1               POP HL
2871+ B2A2 11 EC 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
2872+ B2A5 B7               OR A
2873+ B2A6 ED 52            SBC HL, DE
2874+ B2A8 CB 3D            SRL L
2875+ B2AA CB 3D            SRL L
2876+ B2AC CB 3D            SRL L
2877+ B2AE CB 3D            SRL L
2878+ B2B0 5D               LD E, L
2879+ B2B1 16 00            LD D, 0
2880+ B2B3                  ; Clear MAI_FLAG_LEAVING
2881+ B2B3 21 68 90         LD HL, MonsterAiFlags
2882+ B2B6 19               ADD HL, DE
2883+ B2B7 7E               LD A, (HL)
2884+ B2B8 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
2885+ B2BA 77               LD (HL), A
2886+ B2BB                  ; MonsterRoomId[slot] = neighbor_id (destino)
2887+ B2BB 3A D8 B2         LD A, (.moKbSavedDir)
2888+ B2BE CD B9 92         CALL MaiGetNeighborScreenId
2889+ B2C1 21 5C 90         LD HL, MonsterRoomId
2890+ B2C4 19               ADD HL, DE
2891+ B2C5 77               LD (HL), A
2892+ B2C6                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
2893+ B2C6 3A D8 B2         LD A, (.moKbSavedDir)
2894+ B2C9 CD 18 93         CALL MaiDirToEntrySide
2895+ B2CC 21 62 90         LD HL, MonsterEntryBorder
2896+ B2CF 19               ADD HL, DE
2897+ B2D0 77               LD (HL), A
2898+ B2D1                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
2899+ B2D1 21 17 B6         LD HL, MonsterReturnTimer
2900+ B2D4 19               ADD HL, DE
2901+ B2D5 36 19            LD (HL), MAI_LINGER_PUSHED
2902+ B2D7 C9               RET
