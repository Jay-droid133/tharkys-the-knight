1103+ 9217                  ; Determinar velocidad base segun estado
1104+ 9217 DD 7E 02         LD A, (IX+ENT_STATE)
1105+ 921A FE 02            CP STATE_FIGHTING
1106+ 921C 3E 02            LD A, SPEED_RUN
1107+ 921E 20 02            JR NZ, .gotBaseSpeed
1108+ 9220 3E 01            LD A, SPEED_FIGHT
1109+ 9222              .gotBaseSpeed:
1110+ 9222 32 29 93         LD (.speed), A
1111+ 9225                  ; Boost dinamico fraccionario segun enemigos activos
1112+ 9225                  ; Nasties y monsters nunca conviven. Los monsters ralentizan menos,
1113+ 9225                  ; asi que usan una tabla con un grado menos de boost.
1114+ 9225 CD CD A0         CALL CountActiveNasties         ; A = nastis activos
1115+ 9228 B7               OR A
1116+ 9229 20 0D            JR NZ, .hasEnemies
1117+ 922B CD D4 A0         CALL CountActiveMonsters        ; A = monsters activos
1118+ 922E B7               OR A
1119+ 922F 28 2C            JR Z, .noBoost                  ; 0 enemigos: sin boost
1120+ 9231                  ; Monsters: usar tabla suave
1121+ 9231 3D               DEC A
