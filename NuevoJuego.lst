1180+ F55D              ; ==============================================================================
1181+ F55D              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1182+ F55D              ; ==============================================================================
1183+ F55D              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1184+ F55D              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1185+ F55D              ; ==============================================================================
1186+ F55D              ChurchCutsceneToggleMonsterDir:
1187+ F55D                  ; IX = trapped monster
1188+ F55D 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1189+ F560 3C               INC A
1190+ F561 6F               LD L, A
1191+ F562 26 00            LD H, 0
1192+ F564 29               ADD HL, HL
1193+ F565 29               ADD HL, HL
1194+ F566 29               ADD HL, HL
1195+ F567 29               ADD HL, HL
1196+ F568 11 3F 81         LD DE, EntityTable
1197+ F56B 19               ADD HL, DE
1198+ F56C E5               PUSH HL
1199+ F56D DD E1            POP IX
1200+ F56F                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1201+ F56F DD 7E 00         LD A, (IX+ENT_SPRITEID)
1202+ F572 DD 96 08         SUB (IX+ENT_ANIMBASE)
1203+ F575 EE 04            XOR 4
1204+ F577 47               LD B, A
1205+ F578 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1206+ F57B 80               ADD A, B
1207+ F57C DD 77 00         LD (IX+ENT_SPRITEID), A
1208+ F57F C3 71 F6         JP RedrawTrappedMonster
