4816+ B962              .setDY:
4817+ B962 DD 77 07         LD (IX+ENT_DELTAY), A
4818+ B965                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4819+ B965                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4820+ B965                  ; identicas y las nasties van en paralelo solapadas.
4821+ B965 DD 7E 06         LD A, (IX+ENT_DELTAX)
4822+ B968 E6 80            AND $80                             ; bit 7 = signo X
4823+ B96A 47               LD B, A
4824+ B96B DD 7E 07         LD A, (IX+ENT_DELTAY)
4825+ B96E E6 80            AND $80                             ; bit 7 = signo Y
4826+ B970 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4827+ B971 B0               OR B                                ; A = signX(7) | signY(6)
4828+ B972 47               LD B, A
