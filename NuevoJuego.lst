# file opened: day_cycle.asm
   1+ DD84              ; ==============================================================================
   2+ DD84              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ DD84              ; ==============================================================================
   4+ DD84              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ DD84              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ DD84              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ DD84              ; ==============================================================================
   8+ DD84
   9+ DD84              ; --- Constantes ---
  10+ DD84              NUM_TIME_MOMENTS    EQU 7
  11+ DD84
  12+ DD84              ; --- Variables ---
  13+ DD84 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ DD85 11 E2        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ DD87 11 E2        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ DD89 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ DD8A 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ DD8B
  19+ DD8B              ; ==============================================================================
  20+ DD8B              ; SetTimeOfDay - Cambia el momento del dia
  21+ DD8B              ; ==============================================================================
  22+ DD8B              ; Entrada: A = momento (0-6)
  23+ DD8B              ; ==============================================================================
  24+ DD8B              SetTimeOfDay:
  25+ DD8B 32 84 DD         LD (CurrentTimeOfDay), A
  26+ DD8E
  27+ DD8E                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  28+ DD8E FE 04            CP 4
  29+ DD90 20 06            JR NZ, .notNewCycle
  30+ DD92 21 7D BD         LD HL, DayCycleCount
  31+ DD95 34               INC (HL)
  32+ DD96 18 04            JR .skipBellsReset
  33+ DD98              .notNewCycle:
  34+ DD98                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  35+ DD98                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  36+ DD98                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  37+ DD98 AF               XOR A
  38+ DD99 32 F6 81         LD (BellsTriggered), A
  39+ DD9C              .skipBellsReset:
  40+ DD9C 3A 84 DD         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  41+ DD9F
  42+ DD9F                  ; N2 (medianoche): campanadas primero, remap al terminar
  43+ DD9F FE 04            CP 4
  44+ DDA1 28 1C            JR Z, .bellsFirst
  45+ DDA3
  46+ DDA3                  ; Amanecer temprano (fase 5): despawnear monsters
  47+ DDA3 FE 05            CP 5
  48+ DDA5 20 05            JR NZ, .noScareMon
  49+ DDA7 CD 97 BD         CALL ScareAllMonsters
  50+ DDAA 18 07            JR .noKillMon
  51+ DDAC              .noScareMon:
  52+ DDAC                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  53+ DDAC FE 06            CP 6
  54+ DDAE 20 03            JR NZ, .noKillMon
  55+ DDB0 CD 1C BD         CALL KillAllActiveMonsters
  56+ DDB3              .noKillMon:
  57+ DDB3
  58+ DDB3                  ; Actualizar tablas de remap y tabla de nasties
  59+ DDB3 CD E8 DD         CALL UpdateRemapTables
  60+ DDB6 CD 80 BD         CALL UpdateNastyTable
  61+ DDB9
  62+ DDB9                  ; Forzar remap de atributos (sin redibujar pixeles)
  63+ DDB9 3E 01            LD A, 1
  64+ DDBB 32 26 82         LD (AttrsDirty), A
  65+ DDBE C9               RET
  66+ DDBF
  67+ DDBF              .bellsFirst:
  68+ DDBF                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  69+ DDBF                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  70+ DDBF                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  71+ DDBF                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  72+ DDBF                  ; que sean nocturnos (Crepuscular), no diurnos.
  73+ DDBF CD 80 BD         CALL UpdateNastyTable
  74+ DDC2                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  75+ DDC2                  ; antes de medianoche natural y forzo el evento), saltamos.
  76+ DDC2 3A F6 81         LD A, (BellsTriggered)
  77+ DDC5 B7               OR A
  78+ DDC6 C0               RET NZ
  79+ DDC7 3E 01            LD A, 1
  80+ DDC9 32 F6 81         LD (BellsTriggered), A
  81+ DDCC CD 5C F2         CALL StartBellChimes
  82+ DDCF C9               RET
  83+ DDD0
  84+ DDD0              ; ==============================================================================
  85+ DDD0              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  86+ DDD0              ; ==============================================================================
  87+ DDD0              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  88+ DDD0              ;   - Salta reloj a 00:00.
  89+ DDD0              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  90+ DDD0              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  91+ DDD0              ;     campanadas como hace el path natural). El usuario quiere que la
  92+ DDD0              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
  93+ DDD0              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
  94+ DDD0              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
  95+ DDD0              ;     pero ya esta en N2 -> no-op visual.
  96+ DDD0              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
  97+ DDD0              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
  98+ DDD0              ;
  99+ DDD0              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 100+ DDD0              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 101+ DDD0              ; aqui no re-dispara nada.
 102+ DDD0              ; ==============================================================================
 103+ DDD0              TriggerChurchMidnight:
 104+ DDD0 3A F6 81         LD A, (BellsTriggered)
 105+ DDD3 B7               OR A
 106+ DDD4 C0               RET NZ                              ; bells ya sonaron -> no-op
 107+ DDD5 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 108+ DDD7 CD C1 E5         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 109+ DDDA 3E 04            LD A, 4
 110+ DDDC CD 8B DD         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 111+ DDDF                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 112+ DDDF                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 113+ DDDF                  ; diurnos durante chimes). En este path queremos lo contrario.
 114+ DDDF CD E8 DD         CALL UpdateRemapTables
 115+ DDE2 3E 01            LD A, 1
 116+ DDE4 32 26 82         LD (AttrsDirty), A
 117+ DDE7 C9               RET
