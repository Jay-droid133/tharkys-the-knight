6859+ C53B 18 03            JR .udPost
6860+ C53D              .udSkip:
6861+ C53D CD B9 C5         CALL DeathAnimate                   ; skip: solo animacion
6862+ C540              .udPost:
6863+ C540                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6864+ C540 3A FC 82         LD A, (DeathPrevX)
6865+ C543 DD BE 03         CP (IX+ENT_POSX)
6866+ C546 20 19            JR NZ, .udMoved
6867+ C548 3A FD 82         LD A, (DeathPrevY)
6868+ C54B DD BE 04         CP (IX+ENT_POSY)
6869+ C54E 20 11            JR NZ, .udMoved
6870+ C550                  ; No movio: incrementar BFS counter
6871+ C550 3A FE 82         LD A, (DeathStuckCounter)
6872+ C553 3C               INC A
6873+ C554 32 FE 82         LD (DeathStuckCounter), A
6874+ C557 FE 06            CP DEATH_STUCK_THRESHOLD
6875+ C559 D8               RET C
6876+ C55A AF               XOR A
6877+ C55B 32 FE 82         LD (DeathStuckCounter), A
6878+ C55E C3 25 C7         JP DeathBfsRescue
6879+ C561              .udMoved:
6880+ C561 AF               XOR A
6881+ C562 32 FE 82         LD (DeathStuckCounter), A
6882+ C565 C9               RET
