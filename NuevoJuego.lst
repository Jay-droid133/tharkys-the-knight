1311+ D415                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1312+ D415                  ; Total pixeles = height_px * (width_bytes & $7F)
1313+ D415              .spSkipRle:
1314+ D415 7B               LD A, E
1315+ D416 E6 7F            AND $7F                     ; width_bytes real
1316+ D418                  ; Calcular total = D * A (height * width)
1317+ D418 42               LD B, D                     ; B = height
1318+ D419 21 00 00         LD HL, 0
1319+ D41C 16 00            LD D, 0
1320+ D41E 5F               LD E, A                     ; DE = width
