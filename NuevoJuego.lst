   1+ 0000              ; ==============================================================================
   2+ 0000              ; CONSTANTES DEL SISTEMA Y JUEGO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000              ; --- Direcciones de Memoria ---
   6+ 0000              ORIGIN_ADDRESS  EQU 32768           ; $8000 - Inicio de nuestro juego en RAM
   7+ 0000              SP_ADDRESS      EQU 65368           ; $FF58 - Tope seguro para la pila (Stack)
   8+ 0000
   9+ 0000              ; --- Mapa de Video ---
  10+ 0000              SCREEN_BASE     EQU 16384           ; $4000 - Inicio de los píxeles
  11+ 0000              ATTR_BASE       EQU 22528           ; $5800 - Inicio de los atributos (colores)
  12+ 0000              ATTR_SIZE       EQU 768             ; Tamaño de la zona de atributos
  13+ 0000
  14+ 0000              ; --- Colores Básicos (Tinta) ---
  15+ 0000              BLACK           EQU 0
  16+ 0000              BLUE            EQU 1
  17+ 0000              RED             EQU 2
  18+ 0000              MAGENTA         EQU 3
  19+ 0000              GREEN           EQU 4
  20+ 0000              CYAN            EQU 5
  21+ 0000              YELLOW          EQU 6
  22+ 0000              WHITE           EQU 7
  23+ 0000
  24+ 0000              ; --- Rutinas de la ROM ---
  25+ 0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
  26+ 0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
  27+ 0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
  28+ 0000
  29+ 0000              ; --- Movimiento estilo Sabre Wulf (8-bit, sin subpixel) ---
  30+ 0000              ; --- Movimiento estilo Sabre Wulf ---
  31+ 0000              ; Fiel al original: 4px cada 2 frames (turns_per_player_move=2).
  32+ 0000              ; PlayerMoveTimer controla cuándo se aplica el movimiento.
  33+ 0000              SPEED_RUN           EQU 2           ; 2 px por movimiento (cada frame = 2px/frame, fiel al original)
  34+ 0000              SPEED_FIGHT         EQU 1           ; 1 px por movimiento peleando (mas lento)
  35+ 0000              PLAYER_MOVE_TURNS   EQU 1           ; Mover cada frame (granularidad fina para colision char-based)
  36+ 0000
  37+ 0000              ; --- Limites de pantalla (en pixeles) ---
  38+ 0000              ; Los limites maximos asumen sprite 16px ancho, ~16px alto.
  39+ 0000              ; Para sprites mas grandes, el clamp real se ajusta en runtime.
  40+ 0000              ; HUD en filas 0-1 (16px superiores); area de juego en filas 2-23.
  41+ 0000              SCREEN_MIN_X    EQU 0               ; Limite izquierdo
  42+ 0000              SCREEN_MAX_X    EQU 232             ; Limite derecho (con margen para shift: 256 - 16 - 8)
  43+ 0000              SCREEN_MIN_Y    EQU 16              ; Limite superior (debajo del HUD: 2 filas x 8px)
  44+ 0000              SCREEN_MAX_Y    EQU 171             ; Limite inferior (16 + 176 - 21)
  45+ 0000              BG_Y_OFFSET     EQU 2              ; Offset (char-rows) aplicado al dibujar/colisionar sprites BG
  46+ 0000
  47+ 0000              ; --- Animacion (delays en frames de pantalla) ---
  48+ 0000              ANIM_DELAY_RUN  EQU 4               ; Frames entre cambios de anim corriendo
  49+ 0000              ANIM_DELAY_IDLE EQU 20               ; Frames entre cambios de anim idle
  50+ 0000              ANIM_DELAY_FIGHT EQU 3              ; Frames entre cambios de anim peleando
  51+ 0000              ANIM_DELAY_PUFF EQU 3               ; Frames entre cambios de anim puff (muerte)
  52+ 0000              ANIM_DELAY_SPAWN EQU 3              ; Frames entre cambios de anim spawn (aparicion)
  53+ 0000
  54+ 0000              ; --- Numero de frames de animacion por estado ---
  55+ 0000              ANIM_FRAMES_WALK    EQU 3           ; Frames caminando por direccion
  56+ 0000              ANIM_FRAMES_FIGHT   EQU 5           ; Frames peleando por direccion
  57+ 0000              ANIM_FRAMES_IDLE    EQU 2           ; Frames idle
  58+ 0000              ANIM_FRAMES_PUFF    EQU 6           ; Frames de la animacion puff (muerte)
  59+ 0000              ANIM_FRAMES_SPAWN   EQU 6           ; Frames de la animacion spawn (aparicion)
  60+ 0000
  61+ 0000              ; --- Direcciones del jugador ---
  62+ 0000              DIR_NONE        EQU 0
  63+ 0000              DIR_N           EQU 1
  64+ 0000              DIR_S           EQU 2
  65+ 0000              DIR_E           EQU 4
  66+ 0000              DIR_W           EQU 8
  67+ 0000              DIR_NE          EQU 5               ; DIR_N | DIR_E
  68+ 0000              DIR_NW          EQU 9               ; DIR_N | DIR_W
  69+ 0000              DIR_SE          EQU 6               ; DIR_S | DIR_E
  70+ 0000              DIR_SW          EQU 10              ; DIR_S | DIR_W
  71+ 0000
  72+ 0000              ; --- Estados del jugador/entidad ---
  73+ 0000              STATE_IDLE      EQU 0
  74+ 0000              STATE_RUNNING   EQU 1
  75+ 0000              STATE_FIGHTING  EQU 2
  76+ 0000              STATE_DYING     EQU 3               ; Animacion de muerte (puff)
  77+ 0000              STATE_SPAWNING  EQU 4               ; Animacion de aparicion (spawn)
  78+ 0000
  79+ 0000              ; ==============================================================================
  80+ 0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
  81+ 0000              ; ==============================================================================
  82+ 0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
  83+ 0000              ; Acceso via IX + ENT_* offset.
  84+ 0000              ; ==============================================================================
  85+ 0000
  86+ 0000              ; --- Offsets en la estructura de entidad (16 bytes) ---
  87+ 0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
  88+ 0000              ENT_TYPE        EQU 1               ; Tipo de entidad
  89+ 0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
  90+ 0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
  91+ 0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
  92+ 0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
  93+ 0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
  94+ 0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
  95+ 0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
  96+ 0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
  97+ 0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
  98+ 0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
  99+ 0000              ENT_OLDX        EQU 12              ; X del frame anterior (para XOR erase)
 100+ 0000              ENT_OLDY        EQU 13              ; Y del frame anterior (para XOR erase)
 101+ 0000              ENT_OLDSPRID    EQU 14              ; SpriteID del frame anterior
 102+ 0000              ENT_DRAWX       EQU 15              ; X de dibujo (ajustado para attack offset)
 103+ 0000
 104+ 0000              ENT_SIZE        EQU 16              ; Bytes por entidad
 105+ 0000              NUM_ENTITIES    EQU 17              ; Total de slots
 106+ 0000
 107+ 0000              ; --- Tipos de entidad ---
 108+ 0000              TYPE_NONE       EQU 0               ; Slot inactivo
 109+ 0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 110+ 0000              TYPE_IMMORTAL   EQU 2               ; Enemigo permanente (rhino, wolf, etc.)
 111+ 0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 112+ 0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
 113+ 0000
 114+ 0000              ; --- Flags de entidad (ENT_FLAGS) ---
 115+ 0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
 116+ 0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
 117+ 0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
 118+ 0000              ENTF_NEWSPAWN   EQU 3               ; bit 3: recien creada (usar freshDraw, no erase)
 119+ 0000
 120+ 0000              ; --- Rangos de slots ---
 121+ 0000              SLOT_PLAYER     EQU 0               ; Slot 0: player
 122+ 0000              SLOT_IMMORTAL0  EQU 1               ; Slots 1-6: inmortales
 123+ 0000              NUM_IMMORTALS   EQU 6
 124+ 0000              SLOT_NASTY0     EQU 7               ; Slots 7-9: nasties (spawn)
 125+ 0000              NUM_NASTIES     EQU 3
 126+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 127+ 0000              NUM_OBJECTS     EQU 4
 128+ 0000
 129+ 0000              ; --- Velocidades de enemigos ---
 130+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 131+ 0000              ENEMY_ANIM_DELAY EQU 8              ; Frames entre cambio de frame
 132+ 0000
 133+ 0000              ; --- Spawn system ---
 134+ 0000              SPAWN_INTERVAL  EQU 100             ; Frames entre intentos de spawn
 135+ 0000
 136+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 137+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 138+ 0000
 139+ 0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 140+ 0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 141+ 0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 142+ 0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 143+ 0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 144+ 0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 145+ 0000
 146+ 0000              ; ==============================================================================
 147+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 148+ 0000              ; ==============================================================================
 149+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 150+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 151+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 152+ 0000              ;
 153+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 154+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 155+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 156+ 0000              ; ==============================================================================
 157+ 0000
 158+ 0000              ; --- Dimensiones del mapa ---
 159+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 160+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 161+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 162+ 0000
 163+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 164+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 165+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 166+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 167+ 0000
 168+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 169+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 170+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 171+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 172+ 0000
 173+ 0000              ; --- Tipos de tile ---
 174+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 175+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 176+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 177+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 178+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 179+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 180+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 181+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 182+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 183+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 184+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 185+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 186+ 0000
 187+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 188+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 189+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 190+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 191+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 192+ 0000
 193+ 0000              ; --- Posicion inicial del jugador en el mapa ---
 194+ 0000              START_SCREEN_X  EQU 8               ; Pantalla inicial X (centro del mapa)
 195+ 0000              START_SCREEN_Y  EQU 8               ; Pantalla inicial Y
 196+ 0000              START_PLAYER_X  EQU 120             ; Pixel X inicial dentro de la pantalla
 197+ 0000              START_PLAYER_Y  EQU 88              ; Pixel Y inicial dentro de la pantalla
 198+ 0000
 199+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 200+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 201+ 0000
