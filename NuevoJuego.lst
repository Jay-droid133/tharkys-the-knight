 366+ E5E7 17 01            DEFW $0117                      ; G4
 367+ E5E9 04               DEFB 4
 368+ E5EA 4C 01            DEFW $014C                      ; E4
 369+ E5EC 04               DEFB 4
 370+ E5ED A2 01            DEFW $01A2                      ; C4
 371+ E5EF 04               DEFB 4
