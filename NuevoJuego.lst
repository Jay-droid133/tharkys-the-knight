 403+ E60E              ; --- Track 4: DeathMusic (LOOPABLE) ---
 404+ E60E              ; Tipo tiburon staccato: 2 notas graves alternadas. Cada beat = 12 frames
 405+ E60E              ; (480ms): nota 6f sonando + 6f silencio. Tempo agil. 4 loops = 8 notas =
 406+ E60E              ; 96 frames = 3.84s — sincronizado con DEATH_GHOST_FRAMES: cuando termina
 407+ E60E              ; el silencio tras la 8a nota, la muerte se lanza y la musica reinicia a
 408+ E60E              ; tempo doble. Iterar via tools/music_converter.html (boton Death) cuando
 409+ E60E              ; tengas melodia compuesta — mantener el patron de 12 frames por beat para
 410+ E60E              ; preservar la sincronizacion con el lunge.
 411+ E60E              DeathMusicTable:
 412+ E60E 36 05            DEFW $0536                      ; E2  ~82 Hz   (grave)
 413+ E610 06               DEFB 6                          ; ~240ms suena
 414+ E611 00 00            DEFW $0000                      ; REST
 415+ E613 06               DEFB 6                          ; ~240ms silencio
 416+ E614 E9 04            DEFW $04E9                      ; F2  ~87 Hz   (semitone arriba)
 417+ E616 06               DEFB 6
 418+ E617 00 00            DEFW $0000                      ; REST
 419+ E619 06               DEFB 6
 420+ E61A 00 00            DEFW 0
 421+ E61C 00               DEFB 0                          ; terminator -> driver reinicia (MusicLoop=1)
 422+ E61D
 423+ E61D              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 424+ E61D              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 425+ E61D              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 426+ E61D              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 427+ E61D              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 428+ E61D              StartMusicImpl:
 429+ E61D 3A 17 9D         LD A, (MusicTrackArg)
 430+ E620 FE FF            CP $FF
 431+ E622 28 4A            JR Z, .smStop                   ; sentinel: parar musica activa
 432+ E624 FE FE            CP $FE
 433+ E626 28 57            JR Z, .smRestart                ; sentinel: re-armar track actual desde
 434+ E628                                                  ; primera nota, PRESERVANDO MusicLoop y
 435+ E628                                                  ; MusicSpeedShift (utiles para enfasis
 436+ E628                                                  ; ej. "muerte se lanza" -> sigue loop +
 437+ E628                                                  ; aplica nuevo tempo desde nota 0).
 438+ E628                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 439+ E628 F5               PUSH AF
 440+ E629 AF               XOR A
 441+ E62A 32 A4 E5         LD (MusicLoop), A
 442+ E62D 32 18 9D         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 443+ E630 F1               POP AF
 444+ E631                  ; Resolver puntero a tabla segun track_id
 445+ E631 21 A5 E5         LD HL, TensionMusicTable
 446+ E634 B7               OR A
 447+ E635 28 1E            JR Z, .smArm
 448+ E637 21 B4 E5         LD HL, SunriseMusicTable
 449+ E63A 3D               DEC A
 450+ E63B 28 18            JR Z, .smArm
 451+ E63D 21 D5 E5         LD HL, EndGameMusicTable
 452+ E640 3D               DEC A
 453+ E641 28 0D            JR Z, .smArmLoopable                ; track 2 = LOOPABLE (musica de creditos sin cortes)
 454+ E643 21 F9 E5         LD HL, GameOverMusicTable
 455+ E646 3D               DEC A
 456+ E647 28 0C            JR Z, .smArm
 457+ E649 21 0E E6         LD HL, DeathMusicTable
 458+ E64C 3D               DEC A
 459+ E64D 28 01            JR Z, .smArmLoopable            ; track 4 = LOOPABLE
 460+ E64F C9               RET                             ; track_id desconocido: no-op
 461+ E650
 462+ E650              .smArmLoopable:
 463+ E650 3E 01            LD A, 1
 464+ E652 32 A4 E5         LD (MusicLoop), A
 465+ E655                  ; fall-through a .smArm
 466+ E655              .smArm:
 467+ E655 22 A2 E5         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 468+ E658 E5               PUSH HL                         ; preservar tabla a traves de AY_WriteReg (clobbea BC/A)
 469+ E659                  ; Mixer: solo tono B activo (A/C off, ruidos off). Canal B = centro (ambos
 470+ E659                  ; altavoces) en cableado ACB del Spectrum 128. Canal A es izquierdo y C es
 471+ E659                  ; derecho — reservados para campanadas con paneo segun distancia a plaza.
 472+ E659 3E 07            LD A, 7
 473+ E65B 1E 3D            LD E, $3D                       ; %00111101 (bit 1=0 -> B tono on; bits 0,2=1 -> A,C off)
 474+ E65D CD 5D E4         CALL AY_WriteReg
 475+ E660                  ; Volumen canal B (R9)
 476+ E660 3E 09            LD A, 9
 477+ E662 1E 0C            LD E, 12                        ; vol medio-alto
 478+ E664 CD 5D E4         CALL AY_WriteReg
 479+ E667 E1               POP HL
 480+ E668 22 9F E5         LD (MusicPtr), HL
 481+ E66B C3 A0 E6         JP MusicAdvanceNote
 482+ E66E
 483+ E66E              .smStop:
 484+ E66E                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 485+ E66E                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 486+ E66E AF               XOR A
 487+ E66F 32 A1 E5         LD (MusicTimer), A
 488+ E672 32 A4 E5         LD (MusicLoop), A
 489+ E675 32 18 9D         LD (MusicSpeedShift), A         ; reset tempo
 490+ E678 3E 09            LD A, 9
 491+ E67A 1E 00            LD E, 0
 492+ E67C C3 5D E4         JP AY_WriteReg                  ; tail-call: mute R9
 493+ E67F
 494+ E67F              .smRestart:
 495+ E67F                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 496+ E67F                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 497+ E67F                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 498+ E67F                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 499+ E67F                  ; con eventos del juego sin esperar al fin de la nota actual.
 500+ E67F 2A A2 E5         LD HL, (MusicTableStart)
 501+ E682 22 9F E5         LD (MusicPtr), HL
 502+ E685 C3 A0 E6         JP MusicAdvanceNote
 503+ E688
 504+ E688              ; --- UpdateMusicImpl: catchup wall-clock — avanza N game frames donde
 505+ E688              ; N = FramesElapsed (calculado en MainLoop top). Bajo carga normal N=1.
 506+ E688              ; Tras una transicion lenta puede ser N=3..10 → consume varias notas en una
 507+ E688              ; llamada para preservar el ritmo en wall-clock.
 508+ E688              UpdateMusicImpl:
 509+ E688 3A 19 9D         LD A, (FramesElapsed)
 510+ E68B B7               OR A
 511+ E68C C8               RET Z
 512+ E68D 47               LD B, A
 513+ E68E              .upmiLoop:
 514+ E68E C5               PUSH BC
 515+ E68F CD 96 E6         CALL .upmiTickOnce
 516+ E692 C1               POP BC
 517+ E693 10 F9            DJNZ .upmiLoop
 518+ E695 C9               RET
 519+ E696
 520+ E696              .upmiTickOnce:
 521+ E696 3A A1 E5         LD A, (MusicTimer)
 522+ E699 B7               OR A
 523+ E69A C8               RET Z                           ; inactivo
 524+ E69B 3D               DEC A
 525+ E69C 32 A1 E5         LD (MusicTimer), A
 526+ E69F C0               RET NZ                          ; aun en la nota actual
 527+ E6A0                  ; Hora de la siguiente nota (fall-through a MusicAdvanceNote)
 528+ E6A0
 529+ E6A0              ; --- MusicAdvanceNote: lee 3 bytes de la tabla y aplica al AY ---
 530+ E6A0              ; Formato de entry (3 bytes):
 531+ E6A0              ;   period=$XXXX, duration=$NN  -> nota normal a ese pitch durante NN frames
 532+ E6A0              ;   period=$0000, duration=$NN  -> rest (mute R8) durante NN frames (NN!=0)
 533+ E6A0              ;   period=$0000, duration=$00  -> terminador (silencia canal y para)
 534+ E6A0              ;
 535+ E6A0              ; OJO: AY_WriteReg clobbea B y C (LD BC, $FFFD/$BFFD). Hay que stashear los
 536+ E6A0              ; bytes de period en D y E (que SI se preservan a traves del call).
 537+ E6A0              MusicAdvanceNote:
 538+ E6A0 2A 9F E5         LD HL, (MusicPtr)
 539+ E6A3 5E               LD E, (HL)                      ; E = pitch_lo
 540+ E6A4 23               INC HL
 541+ E6A5 56               LD D, (HL)                      ; D = pitch_hi
 542+ E6A6 23               INC HL
 543+ E6A7 7E               LD A, (HL)                      ; duration
 544+ E6A8 23               INC HL
 545+ E6A9 B7               OR A
 546+ E6AA 28 38            JR Z, .manEnd                   ; duration = 0 -> fin de tabla
 547+ E6AC 22 9F E5         LD (MusicPtr), HL
 548+ E6AF                  ; --- Aplicar MusicSpeedShift: SRL duration N veces (0=normal). Clamp a 1
 549+ E6AF                  ; post-shift para que duration=0 siga indicando solo terminator. ---
 550+ E6AF 47               LD B, A                         ; B = duration original
 551+ E6B0 3A 18 9D         LD A, (MusicSpeedShift)
 552+ E6B3 B7               OR A
 553+ E6B4 28 0B            JR Z, .manSpeedDone
 554+ E6B6              .manSpeedLoop:
 555+ E6B6 CB 38            SRL B
 556+ E6B8 3D               DEC A
 557+ E6B9 20 FB            JR NZ, .manSpeedLoop
 558+ E6BB 78               LD A, B
 559+ E6BC B7               OR A
 560+ E6BD 20 02            JR NZ, .manSpeedDone            ; B>0 tras shift: ok
 561+ E6BF 06 01            LD B, 1                         ; underflow: clamp a 1 frame minimo
 562+ E6C1              .manSpeedDone:
 563+ E6C1 78               LD A, B
 564+ E6C2 32 A1 E5         LD (MusicTimer), A
 565+ E6C5                  ; ¿es rest? (period == 0 y duration != 0)
 566+ E6C5 7B               LD A, E
 567+ E6C6 B2               OR D
 568+ E6C7 28 14            JR Z, .manRest
 569+ E6C9                  ; Nota normal: re-armar vol R9 (por si venimos de un rest que la mute) +
 570+ E6C9                  ; escribir period en R2/R3 (canal B). Re-armar siempre cuesta 1 AY_WriteReg
 571+ E6C9                  ; extra por nota; mas barato que llevar un flag de estado.
 572+ E6C9 D5               PUSH DE
 573+ E6CA 3E 09            LD A, 9
 574+ E6CC 1E 0C            LD E, 12
 575+ E6CE CD 5D E4         CALL AY_WriteReg                ; R9 = vol B medio-alto
 576+ E6D1 D1               POP DE
 577+ E6D2 3E 02            LD A, 2                         ; R2 = period B low
 578+ E6D4 CD 5D E4         CALL AY_WriteReg                ; escribe E (pitch_lo); D preservado
 579+ E6D7 3E 03            LD A, 3                         ; R3 = period B high
 580+ E6D9 5A               LD E, D                         ; recargar E con pitch_hi
 581+ E6DA C3 5D E4         JP AY_WriteReg                  ; tail-call
 582+ E6DD              .manRest:
 583+ E6DD                  ; Silencio durante MusicTimer frames; UpdateMusicImpl seguira tickeando.
 584+ E6DD 3E 09            LD A, 9
 585+ E6DF 1E 00            LD E, 0
 586+ E6E1 C3 5D E4         JP AY_WriteReg                  ; tail-call (mute R9)
 587+ E6E4              .manEnd:
 588+ E6E4                  ; Terminator: si la pista es loopable, reiniciar; si no, silenciar y parar.
 589+ E6E4 3A A4 E5         LD A, (MusicLoop)
 590+ E6E7 B7               OR A
 591+ E6E8 28 09            JR Z, .manEndStop
 592+ E6EA                  ; Loop: restaurar MusicPtr al inicio de la tabla y leer la primera nota.
 593+ E6EA 2A A2 E5         LD HL, (MusicTableStart)
 594+ E6ED 22 9F E5         LD (MusicPtr), HL
 595+ E6F0 C3 A0 E6         JP MusicAdvanceNote             ; reentrar al primer nota (no-recursivo: solo lee 3B)
 596+ E6F3              .manEndStop:
 597+ E6F3 AF               XOR A
 598+ E6F4 32 A1 E5         LD (MusicTimer), A              ; flag inactivo
 599+ E6F7 3E 09            LD A, 9
 600+ E6F9 1E 00            LD E, 0
 601+ E6FB C3 5D E4         JP AY_WriteReg                  ; tail-call
 602+ E6FE
# file closed: ay_sound.asm
