2166+ D73A 6D DE            DEFW BgGfx_old_church_door_closed
2167+ D73C 05               DEFB 5                          ; key requerida = ChurchKey
2168+ D73D 02               DEFB 2                          ; action = ChurchDoor open
2169+ D73E 28 D8            DEFW BgGfx_chimes_tower_door
2170+ D740 04               DEFB 4                          ; key requerida = ClockTowerKey
2171+ D741 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2172+ D742 00 00            DEFW 0                          ; fin
2173+ D744 00 00            DEFB 0, 0
