1153+ CFBF              ; ==============================================================================
1154+ CFBF              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
1155+ CFBF              ; ==============================================================================
1156+ CFBF              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
1157+ CFBF              ; Salida:  IX = primer byte tras pixel data (tintPaper)
1158+ CFBF              ; Modifica: AF, BC, DE, HL
1159+ CFBF              ; ==============================================================================
1160+ CFBF              SkipPixelData:
1161+ CFBF DD 7E 00         LD A, (IX+0)                ; height_px
1162+ CFC2 57               LD D, A                     ; D = height_px
1163+ CFC3 DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
1164+ CFC6 5F               LD E, A                     ; E = raw value con flag
1165+ CFC7 DD 23            INC IX
1166+ CFC9 DD 23            INC IX                      ; IX -> pixel data
1167+ CFCB
1168+ CFCB CB 7B            BIT 7, E
1169+ CFCD 20 0A            JR NZ, .spSkipRle
1170+ CFCF
1171+ CFCF                  ; --- Path literal: saltar height * width bytes ---
1172+ CFCF 7B               LD A, E                     ; width_bytes (sin flag, bit7=0)
1173+ CFD0              .spLitRow:
