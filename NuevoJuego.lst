4561+ BABE D1               POP DE
4562+ BABF              .setAttr:
4563+ BABF DD 77 05         LD (IX+ENT_ATTR), A
4564+ BAC2
4565+ BAC2                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4566+ BAC2                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4567+ BAC2                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4568+ BAC2                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4569+ BAC2                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4570+ BAC2                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4571+ BAC2 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4572+ BAC4 32 22 BC         LD (.spawnW1), A
4573+ BAC7 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4574+ BAC9 32 23 BC         LD (.spawnH1), A
4575+ BACC
4576+ BACC                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4577+ BACC                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4578+ BACC                  ; Sin rebuild aqui = sin lag por spawn.)
4579+ BACC                  ; Posicion aleatoria (con reintentos)
4580+ BACC 3E 08            LD A, 8                             ; mas reintentos: ahora tambien hay min-distance check
4581+ BACE 32 20 BC         LD (.spawnTries), A
4582+ BAD1 AF               XOR A
4583+ BAD2 32 21 BC         LD (.spawnIgnoreZone), A            ; primera ronda respeta zona del player
