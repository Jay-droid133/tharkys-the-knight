4396+ B744              ; ==============================================================================
4397+ B744              ; CountActiveNasties / CountActiveMonsters
4398+ B744              ; ==============================================================================
4399+ B744              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4400+ B744              ; Ambas usan _CountSlots internamente.
4401+ B744              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4402+ B744              ; ==============================================================================
4403+ B744              CountActiveNasties:
4404+ B744 21 0F 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4405+ B747 06 03            LD B, NUM_NASTIES
4406+ B749 18 05            JR _CountSlots
4407+ B74B
4408+ B74B              CountActiveMonsters:
4409+ B74B 21 AF 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4410+ B74E 06 06            LD B, NUM_MONSTERS
4411+ B750
4412+ B750              _CountSlots:
4413+ B750 0E 00            LD C, 0                         ; Contador
4414+ B752              .countLoop:
4415+ B752 7E               LD A, (HL)
4416+ B753 B7               OR A
4417+ B754 28 16            JR Z, .countNext                ; Slot vacio: no contar
4418+ B756                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4419+ B756 D5               PUSH DE
4420+ B757 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4421+ B75A 19               ADD HL, DE
4422+ B75B 7E               LD A, (HL)
4423+ B75C ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4424+ B75E D1               POP DE
4425+ B75F FE 03            CP STATE_DYING
4426+ B761 28 09            JR Z, .countNext
4427+ B763 FE 04            CP STATE_SPAWNING
4428+ B765 28 05            JR Z, .countNext
4429+ B767 FE 05            CP STATE_SCARED
4430+ B769 28 01            JR Z, .countNext
4431+ B76B 0C               INC C
4432+ B76C              .countNext:
4433+ B76C 11 10 00         LD DE, ENT_SIZE
4434+ B76F 19               ADD HL, DE
4435+ B770 10 E0            DJNZ .countLoop
4436+ B772 79               LD A, C
4437+ B773 C9               RET
4438+ B774
4439+ B774              ; ==============================================================================
4440+ B774              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4441+ B774              ; ==============================================================================
4442+ B774              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4443+ B774              ; ==============================================================================
4444+ B774              TrySpawnNasty:
4445+ B774                  IF DEBUG_NO_ENEMIES
4446+ B774 ~                RET
4447+ B774                  ENDIF
4448+ B774                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4449+ B774                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4450+ B774                  ; cuando el timer llega a 0.
4451+ B774 3A CA 82         LD A, (PostTrapPauseTimer)
4452+ B777 B7               OR A
4453+ B778 C0               RET NZ
4454+ B779                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4455+ B779                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4456+ B779 3A EA 82         LD A, (DeathBorderPhase)
4457+ B77C B7               OR A
4458+ B77D C0               RET NZ
4459+ B77E                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4460+ B77E                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4461+ B77E                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4462+ B77E 3A EE 82         LD A, (PlayerRespawnPhase)
4463+ B781 FE 01            CP 1
4464+ B783 C8               RET Z
4465+ B784                  ; Cooldown tras cambio de pantalla / inicio
4466+ B784 3A F8 82         LD A, (SpawnTimer)
4467+ B787 B7               OR A
4468+ B788 28 05            JR Z, .spawnReady
4469+ B78A 3D               DEC A
4470+ B78B 32 F8 82         LD (SpawnTimer), A
4471+ B78E C9               RET
4472+ B78F              .spawnReady:
4473+ B78F                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4474+ B78F 3A F1 B5         LD A, (ScareTimer)
4475+ B792 B7               OR A
4476+ B793 C0               RET NZ
4477+ B794                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4478+ B794                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4479+ B794                  ; rellenamos con nasties crepusculares hasta A2.
4480+ B794 3A C1 82         LD A, (MonsterTrappedFlags)
4481+ B797 E6 07            AND $07
4482+ B799 FE 07            CP $07
4483+ B79B 28 0E            JR Z, .spawnIgnoreNightBlocks
4484+ B79D                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4485+ B79D                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4486+ B79D                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4487+ B79D                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4488+ B79D 3A 5B B3         LD A, (MonstersActive)
4489+ B7A0 B7               OR A
4490+ B7A1 C0               RET NZ
4491+ B7A2                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4492+ B7A2 3A D3 E2         LD A, (CurrentTimeOfDay)
4493+ B7A5 FE 04            CP 4                        ; N2
4494+ B7A7 C8               RET Z
4495+ B7A8 FE 05            CP 5                        ; A1
4496+ B7AA C8               RET Z
4497+ B7AB              .spawnIgnoreNightBlocks:
4498+ B7AB                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4499+ B7AB                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4500+ B7AB                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4501+ B7AB                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4502+ B7AB DD 21 0E 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4503+ B7AF 06 03            LD B, NUM_NASTIES
4504+ B7B1              .spawnLoop:
4505+ B7B1 C5               PUSH BC
4506+ B7B2 DD 7E 01         LD A, (IX+ENT_TYPE)
4507+ B7B5 B7               OR A
