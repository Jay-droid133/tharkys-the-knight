 347+ 6873              .cshLoop:
 348+ 6873 BE               CP (HL)
 349+ 6874 28 06            JR Z, .cshMatch
 350+ 6876 23               INC HL
 351+ 6877 0C               INC C
 352+ 6878 10 F9            DJNZ .cshLoop
 353+ 687A AF               XOR A                                   ; not statue -> Z (visible)
 354+ 687B C9               RET
 355+ 687C              .cshMatch:
 356+ 687C                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 357+ 687C 79               LD A, C
