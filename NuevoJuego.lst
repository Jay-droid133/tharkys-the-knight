 237+ ECD7                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ ECD7 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ ECDA CB 86            RES 0, (HL)
 240+ ECDC C9               RET
 241+ ECDD
 242+ ECDD              .clkBlinkOff:
 243+ ECDD                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ ECDD                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ ECDD                  ; paper=black + ink=black.
 246+ ECDD AF               XOR A
 247+ ECDE 32 0F 58         LD ($580F), A
 248+ ECE1 32 2F 58         LD ($582F), A
 249+ ECE4 32 10 58         LD ($5810), A
 250+ ECE7 32 30 58         LD ($5830), A
 251+ ECEA C9               RET
