 256  E922                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ E922              ; ==============================================================================
   2+ E922              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ E922              ; ==============================================================================
   4+ E922              ; CurrentObjective vive en variables.asm. Valor:
   5+ E922              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ E922              ;   9    = todos los hitos completados (juego ganado)
   7+ E922              ;
   8+ E922              ; ----------------------------------------------------------------------------
   9+ E922              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ E922              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ E922              ;                       recoger el sprite cuyo behavior coincide.
  12+ E922              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ E922              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ E922              ;                       Avanza al disparar el trigger correspondiente.
  15+ E922              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ E922              ;
  17+ E922              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ E922              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ E922              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ E922              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ E922              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ E922              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ E922              ;
  24+ E922              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ E922              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ E922              ; mecanica real.
  27+ E922              ; ==============================================================================
  28+ E922
  29+ E922              MILESTONE_TYPE_PICKUP   EQU 1
  30+ E922              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ E922              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ E922
  33+ E922              MilestoneTable:
  34+ E922 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ E924 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ E926 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ E928 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ E92A 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ E92C 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ E92E 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ E930 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ E932 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ E934
  44+ E934              MilestoneResolveTable:
  45+ E934 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ E936 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ E938 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ E93A 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ E93C 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ E93E 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ E940 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ E942 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ E944 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ E946
  55+ E946              ; ==============================================================================
  56+ E946              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ E946              ; ==============================================================================
  58+ E946              ; IN:  A = key id (1..6) recien recogida
  59+ E946              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ E946              ; ==============================================================================
  61+ E946              CheckMilestonePickup:
  62+ E946 E5               PUSH HL
  63+ E947 D5               PUSH DE
  64+ E948 C5               PUSH BC
  65+ E949 F5               PUSH AF
  66+ E94A 47               LD B, A                             ; B = key id recibida
  67+ E94B 3A F7 81         LD A, (CurrentObjective)
  68+ E94E FE 09            CP 9
  69+ E950 30 21            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ E952 87               ADD A, A                            ; *2 (entry size)
  71+ E953 6F               LD L, A
  72+ E954 26 00            LD H, 0
  73+ E956 11 22 E9         LD DE, MilestoneTable
  74+ E959 19               ADD HL, DE
  75+ E95A 7E               LD A, (HL)                          ; tipo
  76+ E95B FE 01            CP MILESTONE_TYPE_PICKUP
  77+ E95D 20 14            JR NZ, .cmpDone
  78+ E95F 23               INC HL
  79+ E960 7E               LD A, (HL)                          ; ref esperada
  80+ E961 B8               CP B
  81+ E962 20 0F            JR NZ, .cmpDone
  82+ E964 3A F7 81         LD A, (CurrentObjective)
  83+ E967 3C               INC A
  84+ E968 32 F7 81         LD (CurrentObjective), A
  85+ E96B CD FA E9         CALL ResolveObjectiveScreen
  86+ E96E 3E FF            LD A, $FF
  87+ E970 32 FA 81         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ E973              .cmpDone:
  89+ E973 F1               POP AF
  90+ E974 C1               POP BC
  91+ E975 D1               POP DE
  92+ E976 E1               POP HL
  93+ E977 C9               RET
  94+ E978
  95+ E978              ; ==============================================================================
  96+ E978              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
  97+ E978              ; ==============================================================================
  98+ E978              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
  99+ E978              ; Preserva: AF, BC, DE, HL.
 100+ E978              ; ==============================================================================
 101+ E978              CheckMilestoneTrigger:
 102+ E978 E5               PUSH HL
 103+ E979 D5               PUSH DE
 104+ E97A C5               PUSH BC
 105+ E97B F5               PUSH AF
 106+ E97C 47               LD B, A
