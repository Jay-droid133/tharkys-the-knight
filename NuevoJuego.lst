 691+ CDA8 CD 1C A1         CALL CalcPixelAddr          ; HL = dir VRAM
 692+ CDAB
 693+ CDAB                  ; --- Inicializar RLE state ---
 694+ CDAB AF               XOR A
 695+ CDAC 32 83 CE         LD (.rlePending), A         ; sin run pendiente al inicio
 696+ CDAF
 697+ CDAF                  ; --- Comprobar si es RLE o literal ---
