 612  EA6F
 613  EA6F                  ; --- Random pickups body (~1.26 KB, slot 1 -> bank 7 move) ---
 614  EA6F                  ; Antes vivia en slot 1 entre $6BF7..$70E4. Movido aqui para liberar slot 1
 615  EA6F                  ; (RoomCompGapsTable y la IM2 table compiten por el espacio anterior a $7A00).
 616  EA6F                  ; Los 9 entry points externos (UpdateRandomPickup, UpdateRoulette, ...) viven
 617  EA6F                  ; como thunks en slot 1 (random_pickups_thunks.asm). El body usa _B7 wrappers
 618  EA6F                  ; (LoadBgSpriteToBuffer_B7, DrawBgSpriteXOR_B7, PlaySFX_B7, SkipPixelData_B7,
 619  EA6F                  ; RestorePickupAttrs_B7, ApplyMagicCompassBuff_B7) para envolver cada CALL
 620  EA6F                  ; externo. Internamente las dispatch tail-JPs (GiveLife etc.) usan los Body
 621  EA6F                  ; suffix (intra-bank, no thunk).
 622  EA6F                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ EA6F              ; ==============================================================================
   2+ EA6F              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ EA6F              ; ==============================================================================
   4+ EA6F              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ EA6F              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ EA6F              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ EA6F              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ EA6F              ; correspondiente desde CheckPickupCollect.
   9+ EA6F              ;
  10+ EA6F              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ EA6F              ; si en el futuro se ponen pickups fijos en el editor.
  12+ EA6F              ;
  13+ EA6F              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ EA6F              ; Bank 0/2 quedan limpios.
  15+ EA6F              ; ==============================================================================
  16+ EA6F
  17+ EA6F              ; ==============================================================================
  18+ EA6F              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ EA6F              ; ==============================================================================
  20+ EA6F              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ EA6F              ; el cambio via cache .dlhLast.
  22+ EA6F              ; ==============================================================================
  23+ EA6F              GiveLifeBody:
  24+ EA6F 3A D7 82         LD A, (PlayerLives)
  25+ EA72 FE 05            CP PLAYER_LIVES_MAX
  26+ EA74 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ EA75 3C               INC A
  28+ EA76 32 D7 82         LD (PlayerLives), A
  29+ EA79 C9               RET
  30+ EA7A
  31+ EA7A              ; ==============================================================================
  32+ EA7A              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ EA7A              ; ==============================================================================
  34+ EA7A              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ EA7A              ; ==============================================================================
  36+ EA7A              GiveHealthBody:
  37+ EA7A 3A 4B B3         LD A, (PlayerHealth)
  38+ EA7D C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ EA7F 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ EA81 FE 11            CP HEALTH_MAX + 1
  41+ EA83 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ EA85              .ghCap:
  43+ EA85 3E 10            LD A, HEALTH_MAX
  44+ EA87              .ghStore:
  45+ EA87 32 4B B3         LD (PlayerHealth), A
  46+ EA8A C9               RET
  47+ EA8B
  48+ EA8B              ; ==============================================================================
  49+ EA8B              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ EA8B              ; ==============================================================================
  51+ EA8B              GiveStaminaBody:
  52+ EA8B 3A 4C B3         LD A, (PlayerStamina)
  53+ EA8E C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ EA90 38 04            JR C, .gsCap
  55+ EA92 FE 11            CP STAMINA_MAX + 1
  56+ EA94 38 02            JR C, .gsStore
  57+ EA96              .gsCap:
  58+ EA96 3E 10            LD A, STAMINA_MAX
  59+ EA98              .gsStore:
  60+ EA98 32 4C B3         LD (PlayerStamina), A
  61+ EA9B C9               RET
  62+ EA9C
  63+ EA9C              ; ==============================================================================
  64+ EA9C              ; ROULETTE — datos
  65+ EA9C              ; ==============================================================================
  66+ EA9C              ; RouletteOrder: secuencia de type ids que recorre el ciclado. Tunable por
  67+ EA9C              ; el usuario — añadir/quitar/reordenar entries y rebuild. La longitud se
  68+ EA9C              ; calcula sola via ROULETTE_ORDER_LEN.
  69+ EA9C              RouletteOrder:
  70+ EA9C 01               DEFB ROUL_LIFE
  71+ EA9D 06               DEFB ROUL_MUSHROOM
  72+ EA9E 02               DEFB ROUL_HEALTH
  73+ EA9F 05               DEFB ROUL_CARACOL
  74+ EAA0 07               DEFB ROUL_COMPASS
  75+ EAA1 06               DEFB ROUL_MUSHROOM
  76+ EAA2 03               DEFB ROUL_STAMINA
  77+ EAA3 04               DEFB ROUL_RAYO
  78+ EAA4 05               DEFB ROUL_CARACOL
  79+ EAA5              RouletteOrderEnd:
  80+ EAA5              ROULETTE_ORDER_LEN  EQU RouletteOrderEnd - RouletteOrder
  81+ EAA5
  82+ EAA5              ; RouletteTypePtrs: tabla de lookup type id → BgGfx ptr. Indexada por
  83+ EAA5              ; (type-1)*2 — el id 0 esta sin usar (no aparece en RouletteOrder).
  84+ EAA5              RouletteTypePtrs:
  85+ EAA5 13 CE            DEFW BgGfx_life                                     ; ROUL_LIFE     = 1
  86+ EAA7 B6 F5            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH   = 2
  87+ EAA9 72 EA            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA  = 3
  88+ EAAB 9B EA            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO     = 4
  89+ EAAD C4 EA            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  90+ EAAF ED EA            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  91+ EAB1 52 F5            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
  92+ EAB3
  93+ EAB3              ; ==============================================================================
  94+ EAB3              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ EAB3              ; ==============================================================================
  96+ EAB3              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  97+ EAB3              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  98+ EAB3              ;
  99+ EAB3              ; HEALTH y STAMINA: en lugar del ptr canonical de RouletteTypePtrs, se elige
 100+ EAB3              ; al azar entre las variantes (HealthVariantPtrs / StaminaVariantPtrs). Cada
 101+ EAB3              ; tick del ciclo (~480ms) que toque health o stamina muestra una variante
 102+ EAB3              ; potencialmente distinta — consistencia visual con el random pickup directo.
 103+ EAB3              ; ==============================================================================
 104+ EAB3              GetRoulettePtrByIdx:
 105+ EAB3 21 9C EA         LD HL, RouletteOrder
 106+ EAB6 5F               LD E, A
 107+ EAB7 16 00            LD D, 0
 108+ EAB9 19               ADD HL, DE
 109+ EABA 7E               LD A, (HL)                              ; A = type id (1..7)
 110+ EABB                  ; Intercept HEALTH / STAMINA -> tail call a PickRandomVariantPtr
 111+ EABB FE 02            CP ROUL_HEALTH
 112+ EABD 28 12            JR Z, .grpiHealth
 113+ EABF FE 03            CP ROUL_STAMINA
 114+ EAC1 28 14            JR Z, .grpiStamina
 115+ EAC3                  ; Resto: lookup en RouletteTypePtrs (canonical)
 116+ EAC3 3D               DEC A                                   ; idx 0-based para tabla ptrs
 117+ EAC4 26 00            LD H, 0
 118+ EAC6 6F               LD L, A
 119+ EAC7 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 120+ EAC8 11 A5 EA         LD DE, RouletteTypePtrs
 121+ EACB 19               ADD HL, DE
 122+ EACC 5E               LD E, (HL)
 123+ EACD 23               INC HL
 124+ EACE 56               LD D, (HL)
 125+ EACF EB               EX DE, HL                               ; HL = ptr
 126+ EAD0 C9               RET
 127+ EAD1              .grpiHealth:
 128+ EAD1 21 43 EF         LD HL, HealthVariantPtrs
 129+ EAD4 C3 51 EF         JP PickRandomVariantPtr                 ; tail call: HL=tabla -> HL=ptr
 130+ EAD7              .grpiStamina:
 131+ EAD7 21 4C EF         LD HL, StaminaVariantPtrs
 132+ EADA C3 51 EF         JP PickRandomVariantPtr
 133+ EADD
 134+ EADD              ; ==============================================================================
 135+ EADD              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 136+ EADD              ;                                 store los 4 attr bytes (TL,TR,BL,BR) del 2x2.
 137+ EADD              ; ==============================================================================
 138+ EADD              ; Antes guardaba solo attr[0] (TL) y PaintSynthPickupAttrs lo replicaba a las
 139+ EADD              ; 4 celdas, perdiendo el patrón per-celda del BG editor (ej: col1 bright,
 140+ EADD              ; col2 dim). Ahora extraemos los 4 → preservación 1:1.
 141+ EADD              ; ==============================================================================
 142+ EADD              LoadSynthSpriteAndExtractAttr:
 143+ EADD 22 B6 5F         LD (RandomSynthPtr), HL
 144+ EAE0 3E 03            LD A, 3
 145+ EAE2 CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 146+ EAE5 DD 21 EE 86      LD IX, BgSpriteBuffer
 147+ EAE9 CD 3C 6C         CALL SkipPixelData_B7                      ; IX @ tintPaper
 148+ EAEC DD 23            INC IX                                  ; @ attr_h
 149+ EAEE DD 23            INC IX                                  ; @ attr_w
 150+ EAF0 DD 23            INC IX                                  ; @ attr_data[0] = TL
 151+ EAF2 DD 7E 00         LD A, (IX+0)
 152+ EAF5 32 BB 5F         LD (RandomSynthAttr), A                 ; TL
 153+ EAF8 DD 7E 01         LD A, (IX+1)
 154+ EAFB 32 D9 5F         LD (RandomSynthAttrTR), A
 155+ EAFE DD 7E 02         LD A, (IX+2)
 156+ EB01 32 DA 5F         LD (RandomSynthAttrBL), A
 157+ EB04 DD 7E 03         LD A, (IX+3)
 158+ EB07 32 DB 5F         LD (RandomSynthAttrBR), A
 159+ EB0A C9               RET
 160+ EB0B
 161+ EB0B              ; ==============================================================================
 162+ EB0B              ; AdvanceRouletteIdx / SkipCompassIfNeeded - helpers para saltar la entry
 163+ EB0B              ; ROUL_COMPASS del RouletteOrder cuando MagicCompassPermanent != 0
 164+ EB0B              ; ==============================================================================
 165+ EB0B              ; AdvanceRouletteIdx:    INC + wrap, luego skip-compass (uso: tick de ciclado).
 166+ EB0B              ; SkipCompassIfNeeded:   skip-compass solo, sin INC inicial (uso: idx random
 167+ EB0B              ;                        recien calculado al activar la ruleta).
 168+ EB0B              ;
 169+ EB0B              ; Fallthrough: si la wrap rama (XOR A) ejecuta, cae a SkipCompassIfNeeded.
 170+ EB0B              ; Si tras skip encuentra COMPASS, JR AdvanceRouletteIdx re-avanza.
 171+ EB0B              ;
 172+ EB0B              ; RouletteOrder garantiza 8 entries non-compass (de 9 total): el loop nunca
 173+ EB0B              ; es infinito. Si en el futuro alguien edita RouletteOrder y deja solo COMPASS,
 174+ EB0B              ; se colgaria — improbable pero merece warning en la cabecera de la tabla.
 175+ EB0B              ;
 176+ EB0B              ; IN:  A = idx actual (0..ROULETTE_ORDER_LEN-1)
 177+ EB0B              ; OUT: A = idx ajustado (RouletteOrder[A] != ROUL_COMPASS si Permanent != 0)
 178+ EB0B              ; Destruye: AF, BC, HL.
 179+ EB0B              ; ==============================================================================
 180+ EB0B              AdvanceRouletteIdx:
 181+ EB0B 3C               INC A
 182+ EB0C FE 09            CP ROULETTE_ORDER_LEN
 183+ EB0E 38 01            JR C, SkipCompassIfNeeded
 184+ EB10 AF               XOR A
 185+ EB11              SkipCompassIfNeeded:
 186+ EB11 21 BE 82         LD HL, MagicCompassPermanent
 187+ EB14 CB 46            BIT 0, (HL)
 188+ EB16 C8               RET Z                               ; lasting off: idx listo
 189+ EB17 4F               LD C, A
 190+ EB18 06 00            LD B, 0
 191+ EB1A 21 9C EA         LD HL, RouletteOrder
 192+ EB1D 09               ADD HL, BC
 193+ EB1E 7E               LD A, (HL)
 194+ EB1F FE 07            CP ROUL_COMPASS
 195+ EB21 79               LD A, C
 196+ EB22 C0               RET NZ
 197+ EB23 18 E6            JR AdvanceRouletteIdx               ; compass: re-avanzar
 198+ EB25
 199+ EB25              ; ==============================================================================
 200+ EB25              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 201+ EB25              ; ==============================================================================
 202+ EB25              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 203+ EB25              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 204+ EB25              ; carga sprite nuevo, dibuja, repaint attrs.
 205+ EB25              ; ==============================================================================
 206+ EB25              UpdateRouletteBody:
 207+ EB25 3A BC 5F         LD A, (RouletteActive)
 208+ EB28 B7               OR A
 209+ EB29 C8               RET Z
 210+ EB2A 3A B4 5F         LD A, (RandomSynthMapX)
 211+ EB2D FE FE            CP $FE
 212+ EB2F C8               RET Z                                   ; recogido / inactivo: no ciclar
 213+ EB30
 214+ EB30                  ; Tick frame counter
 215+ EB30 21 BE 5F         LD HL, RouletteFrameCounter
 216+ EB33 35               DEC (HL)
 217+ EB34 C0               RET NZ                                  ; aun no toca avanzar
 218+ EB35
 219+ EB35                  ; --- Counter expirado: ciclar al siguiente tipo ---
 220+ EB35 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 221+ EB37 32 BE 5F         LD (RouletteFrameCounter), A
 222+ EB3A
 223+ EB3A                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 224+ EB3A 2A B6 5F         LD HL, (RandomSynthPtr)
 225+ EB3D 3E 03            LD A, 3
 226+ EB3F CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 227+ EB42 3A B8 5F         LD A, (RandomSynthCharX)
 228+ EB45 47               LD B, A
 229+ EB46 3A B9 5F         LD A, (RandomSynthCharY)
 230+ EB49 4F               LD C, A
 231+ EB4A DD 21 EE 86      LD IX, BgSpriteBuffer
 232+ EB4E CD 08 6D         CALL DrawBgSpriteXOR_B7
 233+ EB51
 234+ EB51                  ; Avanzar idx con wrap (AdvanceRouletteIdx skipea ROUL_COMPASS si la
 235+ EB51                  ; brujula permanente esta activa — no se ve un solo frame de compass).
 236+ EB51 3A BD 5F         LD A, (RouletteIdx)
 237+ EB54 CD 0B EB         CALL AdvanceRouletteIdx
 238+ EB57 32 BD 5F         LD (RouletteIdx), A
 239+ EB5A
 240+ EB5A                  ; Lookup nuevo tipo, cargar sprite, extraer attr
 241+ EB5A CD B3 EA         CALL GetRoulettePtrByIdx                ; HL = nuevo ptr
 242+ EB5D CD DD EA         CALL LoadSynthSpriteAndExtractAttr
 243+ EB60
 244+ EB60                  ; Dibujar sprite nuevo
 245+ EB60 3A B8 5F         LD A, (RandomSynthCharX)
 246+ EB63 47               LD B, A
 247+ EB64 3A B9 5F         LD A, (RandomSynthCharY)
 248+ EB67 4F               LD C, A
 249+ EB68 DD 21 EE 86      LD IX, BgSpriteBuffer
 250+ EB6C CD 08 6D         CALL DrawBgSpriteXOR_B7
 251+ EB6F
 252+ EB6F                  ; Repaint attrs en VRAM
 253+ EB6F C3 E1 ED         JP PaintSynthPickupAttrsBody            ; tail call (intra-body)
 254+ EB72
 255+ EB72              ; ==============================================================================
 256+ EB72              ; ApplyRayoBuff - speed boost 1.5x durante 15s + player CYAN | $40
 257+ EB72              ; ==============================================================================
