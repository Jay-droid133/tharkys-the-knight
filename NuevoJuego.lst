2622+ DA47              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2623+ DA47              ; ==============================================================================
2624+ DA47              ; IN:  DE = BgGfx pointer
2625+ DA47              ; OUT: A = 0 (normal), 1..7 (key), 8..13 (lock con key requerida = A-7)
2626+ DA47              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2627+ DA47              ; ==============================================================================
2628+ DA47              GetPickupKeyBehavior:
2629+ DA47 E5               PUSH HL
2630+ DA48 C5               PUSH BC
2631+ DA49 21 8D D7         LD HL, KeyLockTable
2632+ DA4C 06 0D            LD B, 13                    ; 13 slots (insertado BankCheck en slot 7)
2633+ DA4E 0E 01            LD C, 1                     ; id actual (1..13)
2634+ DA50              .gpkbLoop:
2635+ DA50 7E               LD A, (HL)                  ; ptr_lo del slot
2636+ DA51 BB               CP E
2637+ DA52 20 06            JR NZ, .gpkbNext
2638+ DA54 23               INC HL
2639+ DA55 7E               LD A, (HL)                  ; ptr_hi
2640+ DA56 2B               DEC HL
2641+ DA57 BA               CP D
2642+ DA58 28 09            JR Z, .gpkbFound
2643+ DA5A              .gpkbNext:
