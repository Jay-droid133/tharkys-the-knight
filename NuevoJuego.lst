2024+ D9BA              ; ==============================================================================
2025+ D9BA              ; IsPickupDormant - ¿está esta entry de pickup latente y aún no activada?
2026+ D9BA              ; ==============================================================================
2027+ D9BA              ; IN:  DE = BgGfx ptr del pickup
2028+ D9BA              ; OUT: A = 0 si está activo (no es dormant o flag=1), 1 si dormant inactivo.
2029+ D9BA              ;      Z flag set si activo (NZ si dormant).
2030+ D9BA              ; Preserva: BC, DE, HL.
2031+ D9BA              ; ==============================================================================
2032+ D9BA              IsPickupDormant:
2033+ D9BA E5               PUSH HL
2034+ D9BB C5               PUSH BC
2035+ D9BC 21 A0 D9         LD HL, DormantPickupTable
2036+ D9BF              .ipdLoop:
2037+ D9BF 7E               LD A, (HL)
2038+ D9C0 23               INC HL
2039+ D9C1 46               LD B, (HL)                      ; B = ptr_hi de la entry
2040+ D9C2 23               INC HL
2041+ D9C3 B0               OR B
2042+ D9C4 28 24            JR Z, .ipdActive                ; ptr 0 = fin de tabla → no es dormant
2043+ D9C6                  ; HL apunta ahora a flag_lo. ptr_lo está en HL-2, ptr_hi en HL-1.
2044+ D9C6 2B               DEC HL
2044+ D9C7 2B             DEC HL                 ; volver a ptr_lo
2045+ D9C8 7E               LD A, (HL)
2046+ D9C9 BB               CP E
2047+ D9CA 20 18            JR NZ, .ipdNext
2048+ D9CC 23               INC HL
2049+ D9CD 7E               LD A, (HL)
2050+ D9CE BA               CP D
2051+ D9CF 20 0E            JR NZ, .ipdNextHi
2052+ D9D1                  ; ptr matchea: leer dirección del flag y consultar
2053+ D9D1 23               INC HL
2054+ D9D2 4E               LD C, (HL)                      ; flag_lo
2055+ D9D3 23               INC HL
2056+ D9D4 46               LD B, (HL)                      ; flag_hi
2057+ D9D5 0A               LD A, (BC)
2058+ D9D6 B7               OR A
2059+ D9D7 20 11            JR NZ, .ipdActive               ; flag != 0 → activo
2060+ D9D9 3E 01            LD A, 1                         ; dormant inactivo
2061+ D9DB C1               POP BC
2062+ D9DC E1               POP HL
2063+ D9DD B7               OR A                            ; NZ
2064+ D9DE C9               RET
2065+ D9DF              .ipdNextHi:
2066+ D9DF                  ; HL en ptr_hi tras la 2ª comparación → +3 = SIG ptr_lo
2067+ D9DF 23               INC HL
2068+ D9E0 23               INC HL
2069+ D9E1 23               INC HL
2070+ D9E2 18 DB            JR .ipdLoop
2071+ D9E4              .ipdNext:
2072+ D9E4                  ; HL en ptr_lo tras la 1ª comparación → +4 = SIG ptr_lo
2073+ D9E4 23               INC HL
2074+ D9E5 23               INC HL
2075+ D9E6 23               INC HL
2076+ D9E7 23               INC HL
2077+ D9E8 18 D5            JR .ipdLoop
2078+ D9EA              .ipdActive:
2079+ D9EA AF               XOR A                           ; Z, no dormant
2080+ D9EB C1               POP BC
2081+ D9EC E1               POP HL
2082+ D9ED C9               RET
