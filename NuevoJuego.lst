 365+ EB85 DD 7E 03         LD A, (IX+3)
 365+ EB88 77                                       LD (HL), A
 365+ EB89 23             INC HL  ; esfera
 366+ EB8A DD 7E 04         LD A, (IX+4)
 366+ EB8D CD 91 E3       CALL ApplyDayCycleRemap
 366+ EB90 77             LD (HL), A
 366+ EB91 23             INC HL
 367+ EB92 DD 7E 05         LD A, (IX+5)
 367+ EB95 CD 91 E3       CALL ApplyDayCycleRemap
 367+ EB98 77             LD (HL), A
