 557+ E54F                  ; --- Digito decenas (col 8) ---
 558+ E54F 3A ED BC         LD A, (DayCycleCount)
 559+ E552 FE 0A            CP 10
 560+ E554 38 20            JR C, .singleDigit
 561+ E556                  ; Dos digitos: dividir A / 10
 562+ E556 06 00            LD B, 0
 563+ E558              .divLoop:
 564+ E558 D6 0A            SUB 10
 565+ E55A 04               INC B
 566+ E55B FE 0A            CP 10
 567+ E55D 30 F9            JR NC, .divLoop
 568+ E55F                  ; B = decenas, A = unidades
 569+ E55F F5               PUSH AF                             ; Guardar unidades
 570+ E560 78               LD A, B
 571+ E561 CD 96 E5         CALL .getDigitFont
 572+ E564 11 08 40         LD DE, $4008                        ; Col 8
 573+ E567 CD A3 E5         CALL .drawChar
 574+ E56A F1               POP AF                              ; Recuperar unidades
 575+ E56B CD 96 E5         CALL .getDigitFont
