   1+ 9DA5              ; ==============================================================================
   2+ 9DA5              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 9DA5              ; ==============================================================================
   4+ 9DA5              ; Sistema fiel a Sabre Wulf:
   5+ 9DA5              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 9DA5              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 9DA5              ; - NextPixelLine para cruzar character rows y tercios
   8+ 9DA5              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 9DA5              ; ==============================================================================
  10+ 9DA5
  11+ 9DA5              ClearScreen:
  12+ 9DA5 CD AF 0D         CALL ROM_CLS
  13+ 9DA8 C9               RET
  14+ 9DA9
  15+ 9DA9              ; ==============================================================================
  16+ 9DA9              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9DA9              ; ==============================================================================
  18+ 9DA9              ; Entrada:
  19+ 9DA9              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9DA9              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9DA9              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9DA9              ;
  23+ 9DA9              ; Formato del sprite:
  24+ 9DA9              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9DA9              ;   DEFB height_pixels
  26+ 9DA9              ;   DEFB pixel_data... (width * height bytes)
  27+ 9DA9              ;
  28+ 9DA9              ; Dos paths:
  29+ 9DA9              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9DA9              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9DA9              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9DA9              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9DA9              ;
  34+ 9DA9              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9DA9              ;
  36+ 9DA9              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9DA9              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9DA9              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9DA9              ; alto la restauracion del bank.
  40+ 9DA9              ; ==============================================================================
  41+ 9DA9              DrawSprite:
  42+ 9DA9                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9DA9                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9DA9                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9DA9 3A 42 90         LD A, (CurrentPaging)
  46+ 9DAC E6 F8            AND $F8
  47+ 9DAE F6 06            OR 6
  48+ 9DB0 32 42 90         LD (CurrentPaging), A
  49+ 9DB3 01 FD 7F         LD BC, $7FFD
  50+ 9DB6 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9DB8 CD C9 9D         CALL _DrawSpriteImpl
  52+ 9DBB                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9DBB                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9DBB 3A 42 90         LD A, (CurrentPaging)
  55+ 9DBE E6 F8            AND $F8
  56+ 9DC0 32 42 90         LD (CurrentPaging), A
  57+ 9DC3 01 FD 7F         LD BC, $7FFD
  58+ 9DC6 ED 79            OUT (C), A
  59+ 9DC8 C9               RET
  60+ 9DC9
  61+ 9DC9              _DrawSpriteImpl:
  62+ 9DC9                  ; Guardar posicion
  63+ 9DC9 7A               LD A, D
  64+ 9DCA 32 83 9E         LD (.posY), A
  65+ 9DCD 7B               LD A, E
  66+ 9DCE 32 82 9E         LD (.posX), A
  67+ 9DD1
  68+ 9DD1                  ; Leer cabecera sprite
  69+ 9DD1 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9DD4 32 84 9E         LD (.widthSave), A
  71+ 9DD7 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9DDA 32 85 9E         LD (.heightSave), A
  73+ 9DDD DD 23            INC IX
  74+ 9DDF DD 23            INC IX                      ; IX → pixel data
  75+ 9DE1
  76+ 9DE1                  ; === Y CLIPPING ===
  77+ 9DE1                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9DE1 3A 83 9E         LD A, (.posY)
