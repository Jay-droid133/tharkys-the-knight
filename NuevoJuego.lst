 602+ ED9C              ; ==============================================================================
 603+ ED9C              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ ED9C              ; ==============================================================================
 605+ ED9C
 606+ ED9C              ; ==============================================================================
 607+ ED9C              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ ED9C              ; ==============================================================================
 609+ ED9C              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ ED9C              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ ED9C              ; ==============================================================================
 612+ ED9C              BuildPlazaScanAddrs:
 613+ ED9C                  ; Calcular pixel coords del top-left de la esfera
 614+ ED9C 3A 64 8D         LD A, (PlazaClockCharY)
 615+ ED9F 07               RLCA
 616+ EDA0 07               RLCA
 617+ EDA1 07               RLCA
 618+ EDA2 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EDA3 3A 63 8D         LD A, (PlazaClockCharX)
 620+ EDA6 07               RLCA
 621+ EDA7 07               RLCA
 622+ EDA8 07               RLCA
 623+ EDA9 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EDAA CD 5D 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EDAD
 626+ EDAD DD 21 65 8D      LD IX, PlazaScanAddrs
 627+ EDB1 06 10            LD B, 16
 628+ EDB3              .buildLoop:
 629+ EDB3 DD 75 00         LD (IX+0), L
 630+ EDB6 DD 74 01         LD (IX+1), H
 631+ EDB9 DD 23            INC IX
 632+ EDBB DD 23            INC IX
 633+ EDBD 05               DEC B
 634+ EDBE C8               RET Z
 635+ EDBF CD C9 9A         CALL NextPixelLine
 636+ EDC2 18 EF            JR .buildLoop
 637+ EDC4
 638+ EDC4              ; ==============================================================================
 639+ EDC4              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EDC4              ; ==============================================================================
 641+ EDC4              ; Llamar cada frame desde el main loop.
 642+ EDC4              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EDC4              ; ==============================================================================
 644+ EDC4              DrawPlazaClock:
 645+ EDC4 3A 62 8D         LD A, (PlazaClockActive)
 646+ EDC7 B7               OR A
 647+ EDC8 C8               RET Z
 648+ EDC9
 649+ EDC9                  ; --- Calcular posicion actual de las agujas ---
 650+ EDC9 3A 3B E9         LD A, (GameHours)
 651+ EDCC FE 0C            CP 12
 652+ EDCE 38 02            JR C, .pCalcHourOk
 653+ EDD0 D6 0C            SUB 12
 654+ EDD2              .pCalcHourOk:
 655+ EDD2 57               LD D, A                     ; D = display hour (0-11)
 656+ EDD3 3A 3A E9         LD A, (GameMinutes)
 657+ EDD6 1E 00            LD E, 0
 658+ EDD8              .pCalcDiv5:
 659+ EDD8 FE 05            CP 5
 660+ EDDA 38 05            JR C, .pCalcMinOk
 661+ EDDC D6 05            SUB 5
 662+ EDDE 1C               INC E
 663+ EDDF 18 F7            JR .pCalcDiv5
 664+ EDE1              .pCalcMinOk:
 665+ EDE1                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EDE1
 667+ EDE1                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EDE1 3A 35 EE         LD A, (PlazaLastHour)
 669+ EDE4 BA               CP D
 670+ EDE5 20 05            JR NZ, .pNeedsRedraw
 671+ EDE7 3A 36 EE         LD A, (PlazaLastMin)
 672+ EDEA BB               CP E
 673+ EDEB C8               RET Z                       ; sin cambio → no redibujar
 674+ EDEC
 675+ EDEC              .pNeedsRedraw:
 676+ EDEC 7A               LD A, D
 677+ EDED 32 35 EE         LD (PlazaLastHour), A
 678+ EDF0 7B               LD A, E
 679+ EDF1 32 36 EE         LD (PlazaLastMin), A
 680+ EDF4
 681+ EDF4                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EDF4                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EDF4 DD 21 38 8A      LD IX, PlazaClockPixels
 684+ EDF8 FD 21 65 8D      LD IY, PlazaScanAddrs
 685+ EDFC 06 10            LD B, 16
 686+ EDFE              .faceRow:
 687+ EDFE FD 6E 00         LD L, (IY+0)
 688+ EE01 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EE04 DD 7E 00         LD A, (IX+0)
 690+ EE07 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EE08 77               LD (HL), A                  ; byte izquierdo
 692+ EE09 23               INC HL
 693+ EE0A DD 7E 01         LD A, (IX+1)
 694+ EE0D 2F               CPL
 695+ EE0E 77               LD (HL), A                  ; byte derecho
 696+ EE0F DD 23            INC IX
 697+ EE11 DD 23            INC IX
 698+ EE13 FD 23            INC IY
 699+ EE15 FD 23            INC IY
 700+ EE17 10 E5            DJNZ .faceRow
 701+ EE19
 702+ EE19                  ; --- Aguja de horas ---
 703+ EE19 3A 35 EE         LD A, (PlazaLastHour)
 704+ EE1C 21 37 EA         LD HL, HourHandPtrs
 705+ EE1F CD 37 EE         CALL DrawPlazaHandLine
 706+ EE22
 707+ EE22                  ; --- Aguja de minutos ---
 708+ EE22 3A 36 EE         LD A, (PlazaLastMin)
 709+ EE25 21 53 E9         LD HL, MinHandPtrs
 710+ EE28 CD 37 EE         CALL DrawPlazaHandLine
 711+ EE2B
 712+ EE2B                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EE2B 21 73 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EE2E 7E               LD A, (HL)
 715+ EE2F 23               INC HL
 716+ EE30 66               LD H, (HL)
 717+ EE31 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EE32 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EE34 C9               RET
 720+ EE35
 721+ EE35              ; Variables locales reloj plaza
 722+ EE35 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EE36 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EE37
 725+ EE37              ; ==============================================================================
 726+ EE37              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EE37              ; ==============================================================================
 728+ EE37              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EE37              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EE37              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EE37              ; ==============================================================================
 732+ EE37              DrawPlazaHandLine:
 733+ EE37                  ; Indexar en tabla de punteros
 734+ EE37 87               ADD A, A
 735+ EE38 4F               LD C, A
 736+ EE39 06 00            LD B, 0
 737+ EE3B 09               ADD HL, BC
 738+ EE3C 7E               LD A, (HL)
 739+ EE3D 23               INC HL
 740+ EE3E 66               LD H, (HL)
 741+ EE3F 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EE40
 743+ EE40              .pxLoop:
 744+ EE40 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EE41 B7               OR A
 746+ EE42 C8               RET Z
 747+ EE43
 748+ EE43                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EE43 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EE44 23               INC HL
 751+ EE45 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EE46 23               INC HL
 753+ EE47 56               LD D, (HL)                  ; D = mask
 754+ EE48 23               INC HL
 755+ EE49 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EE4A
 757+ EE4A                  ; --- Calcular scanLine (0-15) ---
 758+ EE4A 78               LD A, B
 759+ EE4B E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EE4D CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EE4F 28 02            JR Z, .pxIsTop
 762+ EE51 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EE53              .pxIsTop:
 764+ EE53                  ; A = scanLine (0-15)
 765+ EE53
 766+ EE53                  ; --- Calcular colOffset (0 o 1) ---
 767+ EE53 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EE54 79               LD A, C
 769+ EE55 E6 1F            AND $1F                     ; extraer columna
 770+ EE57 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EE59 4F               LD C, A                     ; C = colOffset
 772+ EE5A
 773+ EE5A                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EE5A 7B               LD A, E                     ; A = scanLine
 775+ EE5B 87               ADD A, A                    ; *2 (word index)
 776+ EE5C 21 65 8D         LD HL, PlazaScanAddrs
 777+ EE5F 85               ADD A, L
 778+ EE60 6F               LD L, A
 779+ EE61 30 01            JR NC, .pxNC
 780+ EE63 24               INC H
 781+ EE64              .pxNC:
 782+ EE64 7E               LD A, (HL)
 783+ EE65 23               INC HL
 784+ EE66 66               LD H, (HL)
 785+ EE67 81               ADD A, C                    ; sumar colOffset
 786+ EE68 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EE69
 788+ EE69                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EE69 7A               LD A, D
 790+ EE6A 2F               CPL
 791+ EE6B A6               AND (HL)
 792+ EE6C 77               LD (HL), A
 793+ EE6D
 794+ EE6D E1               POP HL                      ; restaurar puntero datos
 795+ EE6E 18 D0            JR .pxLoop
