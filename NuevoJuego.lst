 466+ 8F95 C5               PUSH BC
 467+ 8F96 DD 7E 01         LD A, (IX+ENT_TYPE)
 468+ 8F99 FE 02            CP TYPE_MONSTER
 469+ 8F9B 20 12            JR NZ, .dsmNext
 470+ 8F9D DD 7E 02         LD A, (IX+ENT_STATE)
 471+ 8FA0 FE 05            CP STATE_SCARED
 472+ 8FA2 20 0B            JR NZ, .dsmNext
 473+ 8FA4 CD 50 8F         CALL WipeMonsterSlot
 474+ 8FA7 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 8FAB DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 476+ 8FAF              .dsmNext:
 477+ 8FAF 11 10 00         LD DE, ENT_SIZE
 478+ 8FB2 DD 19            ADD IX, DE
 479+ 8FB4 C1               POP BC
 480+ 8FB5 10 DE            DJNZ .dsmLoop
 481+ 8FB7 C9               RET
