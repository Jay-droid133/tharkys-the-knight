 402+ A373              ; ==============================================================================
 403+ A373              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 404+ A373              ; ==============================================================================
 405+ A373              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 406+ A373              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 407+ A373              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 408+ A373              ; ==============================================================================
 409+ A373              ProcessEnemies:
 410+ A373 3E 00            LD A, 0
 411+ A375 32 BE A3         LD (.peCount), A
 412+ A378 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 413+ A37A
 414+ A37A              .peLoop:
 415+ A37A C5               PUSH BC
 416+ A37B
 417+ A37B                  ; Calcular IX desde EnemyStepIdx
 418+ A37B 3A 94 82         LD A, (EnemyStepIdx)
 419+ A37E C6 01            ADD A, SLOT_MONSTER0
 420+ A380 6F               LD L, A
 421+ A381 26 00            LD H, 0
 422+ A383 29               ADD HL, HL
 423+ A384 29               ADD HL, HL
 424+ A385 29               ADD HL, HL
 425+ A386 29               ADD HL, HL                          ; × ENT_SIZE (16)
 426+ A387 11 3F 81         LD DE, EntityTable
 427+ A38A 19               ADD HL, DE
 428+ A38B E5               PUSH HL
 429+ A38C DD E1            POP IX
 430+ A38E
 431+ A38E                  ; Avanzar indice round-robin
 432+ A38E 3A 94 82         LD A, (EnemyStepIdx)
 433+ A391 3C               INC A
 434+ A392 FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 435+ A394 38 01            JR C, .peNoWrap
 436+ A396 AF               XOR A
 437+ A397              .peNoWrap:
 438+ A397 32 94 82         LD (EnemyStepIdx), A
 439+ A39A
 440+ A39A                  ; Slot activo?
 441+ A39A DD 7E 01         LD A, (IX+ENT_TYPE)
 442+ A39D B7               OR A
 443+ A39E 28 16            JR Z, .peSkip
 444+ A3A0
 445+ A3A0                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 446+ A3A0 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 447+ A3A4 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 448+ A3A5
 449+ A3A5                  ; Procesar esta entidad completa (erase + logic + draw)
 450+ A3A5 CD BF A3         CALL ProcessOneEnemy
 451+ A3A8
 452+ A3A8                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 453+ A3A8 F1               POP AF
 454+ A3A9 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 455+ A3AB
 456+ A3AB                  ; Budget check
 457+ A3AB 3A BE A3         LD A, (.peCount)
 458+ A3AE 3C               INC A
 459+ A3AF 32 BE A3         LD (.peCount), A
 460+ A3B2 FE 02            CP MAX_ENEMIES_PER_FRAME
 461+ A3B4 30 06            JR NC, .peDone
 462+ A3B6
 463+ A3B6              .peSkip:
 464+ A3B6 C1               POP BC
 465+ A3B7 05               DEC B
 466+ A3B8 C2 7A A3         JP NZ, .peLoop
 467+ A3BB C9               RET
 468+ A3BC
 469+ A3BC              .peDone:
 470+ A3BC C1               POP BC
 471+ A3BD C9               RET
 472+ A3BE
 473+ A3BE 00           .peCount: DEFB 0
