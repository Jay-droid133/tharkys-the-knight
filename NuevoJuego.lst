 561+ E8DD              ; TownGateDrawPlayerHere / TownGateRedrawPlayer / TownGateErasePlayer:
 562+ E8DD              ; viven en slot 1 (town_gate_cutscene.asm) — llamadas por bank_cutscene via
 563+ E8DD              ; TownGateRedrawPlayer_B7. Aqui las omitimos para evitar duplicacion.
 564+ E8DD
 565+ E8DD              ; ==============================================================================
 566+ E8DD              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 567+ E8DD              ; ==============================================================================
 568+ E8DD              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 569+ E8DD              ;    al haberse dibujado ya en el render normal de la sala).
 570+ E8DD              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 571+ E8DD              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 572+ E8DD              ; Bank 3 para ambos (sprites baseline town).
 573+ E8DD              ; Destruye: AF, BC, DE, HL, IX.
 574+ E8DD              ; ==============================================================================
 575+ E8DD              TownGateOpenDoor:
 576+ E8DD 11 D1 E2         LD DE, BgGfx_town_gate_door_closed_v2
 577+ E8E0 CD BA 6E         CALL RedrawPickupByPtr_B7               ; XOR-erase del closed
 578+ E8E3                  ; Fall-through a TownGateRedrawOpenDoor
 579+ E8E3
 580+ E8E3              ; ==============================================================================
 581+ E8E3              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 582+ E8E3              ; ==============================================================================
 583+ E8E3              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 584+ E8E3              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 585+ E8E3              ; el open door restaura attrs originales en sus 4 cols + pixels.
 586+ E8E3              ; ==============================================================================
 587+ E8E3              TownGateRedrawOpenDoor:
 588+ E8E3 21 90 E6         LD HL, BgGfx_town_gate_door_open
 589+ E8E6 3E 03            LD A, 3
 590+ E8E8 CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 591+ E8EB DD 21 FD 86      LD IX, BgSpriteBuffer
 592+ E8EF 06 0E            LD B, TGCS_DOOR_CHARX
 593+ E8F1 0E 11            LD C, TGCS_DOOR_CHARY
 594+ E8F3                  ; BgSpriteIsHouse=0, CurrentTintVar=0 escritas dentro de DrawBgGfxSpriteBlackTint_B7
 595+ E8F3                  ; (esas vars viven en bank 0, no se pueden escribir desde bank 7 sin paginar).
 596+ E8F3 C3 3B 6F         JP DrawBgGfxSpriteBlackTint_B7
 597+ E8F6
 598+ E8F6              ; TownGateAllNastiesDeadCheck: vive en slot 1 (town_gate_cutscene.asm) —
 599+ E8F6              ; llamada por bank_cutscene directamente (CALL TownGateAllNastiesDeadCheck).
 600+ E8F6              ; Es safe sin _B7 wrap porque NO toca paging.
 601+ E8F6
 602+ E8F6              ; TownGatePlayerXOR_BiClip: vive en slot 1 (usada por TownGatePlayerSlideErase
 603+ E8F6              ; y SlideDraw que viven en slot 1). El body bank 7 no la llama directamente.
 604+ E8F6
 605+ E8F6              ; TownGatePlayerSlideErase / SlideDraw: viven en slot 1 (paginan bank 6
 606+ E8F6              ; internamente con OUT, no se pueden mover a bank 7 sin reorganizacion mayor).
 607+ E8F6              ; El body bank 7 las llama via TownGatePlayerSlideErase_B7 / SlideDraw_B7.
 608+ E8F6
 609+ E8F6              ; ==============================================================================
 610+ E8F6              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 611+ E8F6              ; ==============================================================================
 612+ E8F6              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 613+ E8F6              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 614+ E8F6              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 615+ E8F6              ; 2. Compute new offset random.
 616+ E8F6              ; 3. Draw at new offset.
 617+ E8F6              ; Destruye: AF, BC, DE, HL, IX.
 618+ E8F6              ; ==============================================================================
 619+ E8F6              TownGateShakeStep:
 620+ E8F6 CD 3E E9         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 621+ E8F9 CD 59 E9         CALL TownGateDrawFingerShifted
 622+ E8FC                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 623+ E8FC ED 5F            LD A, R
 624+ E8FE E6 03            AND $03
 625+ E900 21 21 E9         LD HL, .tgssJitterTable
 626+ E903 5F               LD E, A
 627+ E904 16 00            LD D, 0
 628+ E906 19               ADD HL, DE
 629+ E907 7E               LD A, (HL)
 630+ E908 32 A6 5F         LD (TownGateShakeOffsX), A
 631+ E90B 3A A0 81         LD A, (GameFrameCounter)
 632+ E90E E6 03            AND $03
 633+ E910 21 21 E9         LD HL, .tgssJitterTable
 634+ E913 5F               LD E, A
 635+ E914 16 00            LD D, 0
 636+ E916 19               ADD HL, DE
 637+ E917 7E               LD A, (HL)
 638+ E918 32 A7 5F         LD (TownGateShakeOffsY), A
 639+ E91B CD 3E E9         CALL TownGateDrawArmShifted          ; draw at new offset
 640+ E91E C3 59 E9         JP TownGateDrawFingerShifted
 641+ E921              .tgssJitterTable:
 642+ E921 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 643+ E925
 644+ E925              ; ==============================================================================
 645+ E925              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 646+ E925              ; ==============================================================================
 647+ E925              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 648+ E925              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 649+ E925              ; ==============================================================================
 650+ E925              TownGateShakeRestore:
 651+ E925 CD 3E E9         CALL TownGateDrawArmShifted          ; erase last shifted
 652+ E928 CD 59 E9         CALL TownGateDrawFingerShifted
 653+ E92B AF               XOR A
 654+ E92C 32 A6 5F         LD (TownGateShakeOffsX), A
 655+ E92F 32 A7 5F         LD (TownGateShakeOffsY), A
 656+ E932 11 76 E2         LD DE, BgGfx_arm
 657+ E935 CD BA 6E         CALL RedrawPickupByPtr_B7               ; restore at PickupTable position
 658+ E938 11 C3 E2         LD DE, BgGfx_finger
 659+ E93B C3 BA 6E         JP RedrawPickupByPtr_B7
 660+ E93E
 661+ E93E              ; ==============================================================================
 662+ E93E              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 663+ E93E              ; ==============================================================================
 664+ E93E              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 665+ E93E              ; Destruye: AF, BC, DE, HL, IX.
 666+ E93E              ; ==============================================================================
 667+ E93E              TownGateDrawArmShifted:
 668+ E93E 21 76 E2         LD HL, BgGfx_arm
 669+ E941 3E 03            LD A, 3
 670+ E943 CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 671+ E946 3A A6 5F         LD A, (TownGateShakeOffsX)
 672+ E949 47               LD B, A
 673+ E94A 3E 88            LD A, TGCS_ARM_PX_X
 674+ E94C 80               ADD A, B
 675+ E94D 5F               LD E, A
 676+ E94E 3A A7 5F         LD A, (TownGateShakeOffsY)
 677+ E951 47               LD B, A
 678+ E952 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 679+ E954 80               ADD A, B
 680+ E955 57               LD D, A
 681+ E956 C3 74 E9         JP DrawBgSpriteAnyXorAtPixel
 682+ E959
 683+ E959              ; ==============================================================================
 684+ E959              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 685+ E959              ; ==============================================================================
 686+ E959              TownGateDrawFingerShifted:
 687+ E959 21 C3 E2         LD HL, BgGfx_finger
 688+ E95C 3E 03            LD A, 3
 689+ E95E CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 690+ E961 3A A6 5F         LD A, (TownGateShakeOffsX)
 691+ E964 47               LD B, A
 692+ E965 3E 88            LD A, TGCS_FINGER_PX_X
 693+ E967 80               ADD A, B
 694+ E968 5F               LD E, A
 695+ E969 3A A7 5F         LD A, (TownGateShakeOffsY)
 696+ E96C 47               LD B, A
 697+ E96D 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 698+ E96F 80               ADD A, B
 699+ E970 57               LD D, A
 700+ E971 C3 74 E9         JP DrawBgSpriteAnyXorAtPixel
 701+ E974
 702+ E974              ; ==============================================================================
 703+ E974              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 704+ E974              ; ==============================================================================
 705+ E974              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 706+ E974              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 707+ E974              ;     E = pixel X (0..255).
 708+ E974              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 709+ E974              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 710+ E974              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 711+ E974              ; Destruye: AF, BC, DE, HL, IX.
 712+ E974              ; ==============================================================================
 713+ E974              DrawBgSpriteAnyXorAtPixel:
 714+ E974 DD 21 FD 86      LD IX, BgSpriteBuffer
 715+ E978 DD 7E 00         LD A, (IX+0)                        ; height_px
 716+ E97B B7               OR A
 717+ E97C C8               RET Z
 718+ E97D 32 D7 E9         LD (.dbsaHeight), A
 719+ E980 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 720+ E983 E6 7F            AND $7F
 721+ E985 32 D8 E9         LD (.dbsaWidth), A
 722+ E988 DD 23            INC IX
 723+ E98A DD 23            INC IX                              ; -> pixel data
 724+ E98C 7B               LD A, E
 725+ E98D E6 07            AND $07
 726+ E98F 32 D9 E9         LD (.dbsaShift), A
 727+ E992 7B               LD A, E
 728+ E993 E6 F8            AND $F8
 729+ E995 5F               LD E, A
 730+ E996 CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 731+ E999              .dbsaRow:
 732+ E999 E5               PUSH HL
 733+ E99A 3A D8 E9         LD A, (.dbsaWidth)
 734+ E99D 47               LD B, A                             ; B = width counter
 735+ E99E 0E 00            LD C, 0                             ; C = carry from prev byte
 736+ E9A0              .dbsaByte:
 737+ E9A0 DD 7E 00         LD A, (IX+0)
 738+ E9A3 2F               CPL                                 ; un-invert
 739+ E9A4 57               LD D, A                             ; D = sprite byte
 740+ E9A5 1E 00            LD E, 0                             ; E = bits que caen al next byte
 741+ E9A7 3A D9 E9         LD A, (.dbsaShift)
 742+ E9AA B7               OR A
 743+ E9AB 28 09            JR Z, .dbsaNoShift
 744+ E9AD C5               PUSH BC
 745+ E9AE 47               LD B, A
 746+ E9AF              .dbsaShiftLoop:
 747+ E9AF CB 3A            SRL D
 748+ E9B1 CB 1B            RR E
 749+ E9B3 10 FA            DJNZ .dbsaShiftLoop
 750+ E9B5 C1               POP BC
 751+ E9B6              .dbsaNoShift:
 752+ E9B6 7A               LD A, D
 753+ E9B7 B1               OR C                                ; combinar con carry previo
 754+ E9B8 AE               XOR (HL)
 755+ E9B9 77               LD (HL), A
 756+ E9BA 23               INC HL
 757+ E9BB 4B               LD C, E                             ; nuevo carry para siguiente byte
 758+ E9BC DD 23            INC IX
 759+ E9BE 10 E0            DJNZ .dbsaByte
 760+ E9C0                  ; Byte final (carry) si shift > 0
 761+ E9C0 3A D9 E9         LD A, (.dbsaShift)
 762+ E9C3 B7               OR A
 763+ E9C4 28 03            JR Z, .dbsaNoFinal
 764+ E9C6 79               LD A, C
 765+ E9C7 AE               XOR (HL)
 766+ E9C8 77               LD (HL), A
 767+ E9C9              .dbsaNoFinal:
 768+ E9C9 E1               POP HL
 769+ E9CA CD CE 9A         CALL NextPixelLine
 770+ E9CD 3A D7 E9         LD A, (.dbsaHeight)
 771+ E9D0 3D               DEC A
 772+ E9D1 32 D7 E9         LD (.dbsaHeight), A
 773+ E9D4 20 C3            JR NZ, .dbsaRow
 774+ E9D6 C9               RET
 775+ E9D7 00           .dbsaHeight: DEFB 0
 776+ E9D8 00           .dbsaWidth:  DEFB 0
 777+ E9D9 00           .dbsaShift:  DEFB 0
 778+ E9DA
 779+ E9DA              ; ==============================================================================
 780+ E9DA              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 781+ E9DA              ; ==============================================================================
 782+ E9DA              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 783+ E9DA              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 784+ E9DA              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 785+ E9DA              ; visualmente la mitad inferior del player desaparece tras la HUD.
 786+ E9DA              ; ==============================================================================
 787+ E9DA              TownGateExitStep:
 788+ E9DA 3A A8 5F         LD A, (TownGateExitStepCnt)
 789+ E9DD 3C               INC A
 790+ E9DE 32 A8 5F         LD (TownGateExitStepCnt), A
 791+ E9E1 FE 02            CP TGCS_T_EXIT_STEP
 792+ E9E3 D8               RET C                               ; aun no toca step
 793+ E9E4 AF               XOR A
 794+ E9E5 32 A8 5F         LD (TownGateExitStepCnt), A
 795+ E9E8                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
 796+ E9E8 DD 21 A3 81      LD IX, EntityTable
 797+ E9EC DD 7E 04         LD A, (IX+ENT_POSY)
 798+ E9EF 3C               INC A
 799+ E9F0 DD 77 04         LD (IX+ENT_POSY), A
 800+ E9F3 32 E4 82         LD (PlayerDrawY), A
 801+ E9F6 3A A9 5F         LD A, (TownGateExitWalkFrame)
 802+ E9F9 EE 01            XOR 1                               ; toggle 0/1
 803+ E9FB 32 A9 5F         LD (TownGateExitWalkFrame), A
 804+ E9FE 47               LD B, A
 805+ E9FF 3E 0E            LD A, SPRID_WALK_S
 806+ EA01 80               ADD A, B
 807+ EA02 DD 77 00         LD (IX+ENT_SPRITEID), A
 808+ EA05                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
 809+ EA05                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
 810+ EA05                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
 811+ EA05                  ; part1 attrs ni de door attrs.
 812+ EA05 CD 2F 6F         CALL TownGatePlayerSlideErase_B7
 813+ EA08 C3 35 6F         JP TownGatePlayerSlideDraw_B7       ; tail call via thunk (paging-safe desde bank 7)
 814+ EA0B
 815+ EA0B              ; ==============================================================================
 816+ EA0B              ; TownGateDrawTheEnd - dibuja el sprite "The End" en (TGCS_END_CHARX, _Y)
 817+ EA0B              ; ==============================================================================
 818+ EA0B              ; El sprite original "the end" (id 243, 88x72=891 B) se troceo en dos partes
 819+ EA0B              ; horizontales para no consumir el 87% de BgSpriteBuffer:
 820+ EA0B              ;   - the_end_part1 (id 47, 88x32 = 11x4 chars, 396 B): mitad superior.
 821+ EA0B              ;   - the_end_part2 (id 48, 88x40 = 11x5 chars, 495 B): mitad inferior.
 822+ EA0B              ; Bank 3. RLE-comprimidos (bit 7 de width_bytes set), asi que NO podemos
 823+ EA0B              ; usar DrawBgSpriteXOR (produce distorsion). Usamos DrawBgGfxSprite, la
 824+ EA0B              ; rutina normal de render BG: decodifica RLE + pinta pixels + attrs.
 825+ EA0B              ; Destruye: AF, BC, DE, HL, IX.
 826+ EA0B              ; ==============================================================================
 827+ EA0B              TownGateDrawTheEnd:
 828+ EA0B                  ; --- Part 1: mitad superior (11x4 chars) ---
 829+ EA0B 21 9B EC         LD HL, BgGfx_the_end_part1
 830+ EA0E 3E 03            LD A, 3
 831+ EA10 CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 832+ EA13 DD 21 FD 86      LD IX, BgSpriteBuffer
 833+ EA17 06 0B            LD B, TGCS_END_CHARX
 834+ EA19 0E 04            LD C, TGCS_END_CHARY
 835+ EA1B CD 3B 6F         CALL DrawBgGfxSpriteBlackTint_B7    ; flags=0 escritas dentro del thunk
 836+ EA1E
 837+ EA1E                  ; --- Part 2: mitad inferior (11x5 chars), 4 chars debajo de part1 ---
 838+ EA1E 21 0E EE         LD HL, BgGfx_the_end_part2
 839+ EA21 3E 03            LD A, 3
 840+ EA23 CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 841+ EA26 DD 21 FD 86      LD IX, BgSpriteBuffer
 842+ EA2A 06 0B            LD B, TGCS_END_CHARX
 843+ EA2C 0E 08            LD C, TGCS_END_CHARY + 4
 844+ EA2E C3 3B 6F         JP DrawBgGfxSpriteBlackTint_B7      ; tail call
 845+ EA31
 846+ EA31              ; ==============================================================================
 847+ EA31              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
 848+ EA31              ; ==============================================================================
 849+ EA31              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
 850+ EA31              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
 851+ EA31              ; quedara visible sobre fondo negro.
 852+ EA31              ; ==============================================================================
 853+ EA31              TownGateWipeBlack:
 854+ EA31 21 00 40         LD HL, $4000
 855+ EA34 11 01 40         LD DE, $4001
 856+ EA37 01 FF 17         LD BC, $17FF
 857+ EA3A 36 00            LD (HL), 0
 858+ EA3C ED B0            LDIR
 859+ EA3E 21 00 58         LD HL, $5800
 860+ EA41 11 01 58         LD DE, $5801
 861+ EA44 01 FF 02         LD BC, $02FF
 862+ EA47 36 00            LD (HL), $00                        ; ink black, paper black
 863+ EA49 ED B0            LDIR
 864+ EA4B C9               RET
 865+ EA4C
 866+ EA4C              ; ==============================================================================
 867+ EA4C              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
 868+ EA4C              ; ==============================================================================
 869+ EA4C              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
 870+ EA4C              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
 871+ EA4C              ; (white ink, black paper, bright) para todo el area de texto.
 872+ EA4C              ; ==============================================================================
 873+ EA4C              TownGateDrawCredits:
 874+ EA4C                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
 875+ EA4C 21 00 58         LD HL, $5800
 876+ EA4F 11 01 58         LD DE, $5801
 877+ EA52 01 FF 02         LD BC, $02FF
 878+ EA55 36 47            LD (HL), $47
 879+ EA57 ED B0            LDIR
 880+ EA59                  ; Iterar credits
 881+ EA59 21 B2 EA         LD HL, TownGateCreditsData
 882+ EA5C              .tgdcLoop:
 883+ EA5C 7E               LD A, (HL)
 884+ EA5D FE FF            CP $FF
 885+ EA5F C8               RET Z
 886+ EA60 57               LD D, A                             ; D = row
 887+ EA61 23               INC HL
 888+ EA62 7E               LD A, (HL)
 889+ EA63 5F               LD E, A                             ; E = col
 890+ EA64 23               INC HL                              ; HL → string
 891+ EA65 CD 6A EA         CALL PrintStringFontAt
 892+ EA68 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
 893+ EA6A
 894+ EA6A              ; ==============================================================================
 895+ EA6A              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
 896+ EA6A              ; ==============================================================================
 897+ EA6A              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
 898+ EA6A              ; siguiente byte tras el 0 (para que el caller siga iterando).
 899+ EA6A              ; Destruye: AF, BC, DE, HL.
 900+ EA6A              ; OUT: HL apunta al byte tras el 0 terminador.
 901+ EA6A              ; ==============================================================================
 902+ EA6A              PrintStringFontAt:
 903+ EA6A              .psfaCharLoop:
 904+ EA6A 7E               LD A, (HL)
 905+ EA6B 23               INC HL
 906+ EA6C B7               OR A
 907+ EA6D C8               RET Z                               ; fin de string
 908+ EA6E E5               PUSH HL
 909+ EA6F D5               PUSH DE
 910+ EA70 CD 78 EA         CALL DrawCharFontAt                 ; D=row, E=col, A=char
 911+ EA73 D1               POP DE
 912+ EA74 E1               POP HL
 913+ EA75 1C               INC E                               ; siguiente columna
 914+ EA76 18 F2            JR .psfaCharLoop
 915+ EA78
 916+ EA78              ; ==============================================================================
 917+ EA78              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
 918+ EA78              ; ==============================================================================
 919+ EA78              ; D = row (0..23), E = col (0..31), A = ASCII char.
 920+ EA78              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
 921+ EA78              ;   y = row * 8, x = col * 8
 922+ EA78              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
 923+ EA78              ; El char se renderiza con direct write (sobrescribe pixels y attr).
 924+ EA78              ; Destruye: AF, BC, DE, HL.
 925+ EA78              ; ==============================================================================
 926+ EA78              DrawCharFontAt:
 927+ EA78 D5               PUSH DE
 928+ EA79                  ; HL = $3C00 + char * 8
 929+ EA79 6F               LD L, A
 930+ EA7A 26 00            LD H, 0
 931+ EA7C 29               ADD HL, HL
 932+ EA7D 29               ADD HL, HL
 933+ EA7E 29               ADD HL, HL
 934+ EA7F 01 00 3C         LD BC, $3C00
 935+ EA82 09               ADD HL, BC
 936+ EA83 D1               POP DE
 937+ EA84                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
 938+ EA84 E5               PUSH HL                             ; save font ptr
 939+ EA85 7A               LD A, D
 940+ EA86 87               ADD A, A
 941+ EA87 87               ADD A, A
 942+ EA88 87               ADD A, A                            ; A = row * 8 = pixel Y
 943+ EA89 57               LD D, A
 944+ EA8A 7B               LD A, E
 945+ EA8B 87               ADD A, A
 946+ EA8C 87               ADD A, A
 947+ EA8D 87               ADD A, A                            ; A = col * 8 = pixel X
 948+ EA8E 5F               LD E, A
 949+ EA8F CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 950+ EA92 EB               EX DE, HL                           ; DE = VRAM addr
 951+ EA93 E1               POP HL                              ; HL = font ptr
 952+ EA94 06 08            LD B, 8
 953+ EA96              .dcfaLoop:
 954+ EA96 7E               LD A, (HL)
 955+ EA97 12               LD (DE), A
 956+ EA98 23               INC HL
 957+ EA99 14               INC D                               ; siguiente scan line (within char)
 958+ EA9A 10 FA            DJNZ .dcfaLoop
 959+ EA9C C9               RET
