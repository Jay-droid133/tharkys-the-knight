4230+ BA5F 3A C4 BA         LD A, (.ecXlo)
4231+ BA62 57               LD D, A
4232+ BA63 7B               LD A, E
4233+ BA64 92               SUB D
4234+ BA65 3C               INC A                           ; width_chars
4235+ BA66 32 C6 BA         LD (.ecWc), A
4236+ BA69                  ; --- Char Y range ---
4237+ BA69 DD 7E 04         LD A, (IX+ENT_POSY)
4238+ BA6C 47               LD B, A                         ; B = posY (salvar)
4239+ BA6D 0F               RRCA
4240+ BA6E 0F               RRCA
4241+ BA6F 0F               RRCA
4242+ BA70 E6 1F            AND $1F
4243+ BA72 D6 02            SUB BG_Y_OFFSET
4244+ BA74 32 C5 BA         LD (.ecYlo), A
4245+ BA77 78               LD A, B
4246+ BA78 81               ADD A, C
4247+ BA79 3D               DEC A                           ; posY + H - 1
4248+ BA7A 0F               RRCA
4249+ BA7B 0F               RRCA
4250+ BA7C 0F               RRCA
4251+ BA7D E6 1F            AND $1F
4252+ BA7F D6 02            SUB BG_Y_OFFSET
4253+ BA81 47               LD B, A                         ; B = charYhi
4254+ BA82 3A C5 BA         LD A, (.ecYlo)
4255+ BA85 ED 44            NEG
4256+ BA87 80               ADD A, B
4257+ BA88 3C               INC A                           ; height_chars
4258+ BA89 32 C7 BA         LD (.ecHc), A
4259+ BA8C                  ; --- HL = CollisionMap + charYlo*32 + charXlo ---
4260+ BA8C 3A C5 BA         LD A, (.ecYlo)
4261+ BA8F FE 16            CP 22
4262+ BA91 30 2C            JR NC, .ecFree                  ; fuera de rango (underflow HUD o abajo)
4263+ BA93 6F               LD L, A
4264+ BA94 26 00            LD H, 0
4265+ BA96 29               ADD HL, HL
4266+ BA97 29               ADD HL, HL
4267+ BA98 29               ADD HL, HL
4268+ BA99 29               ADD HL, HL
4269+ BA9A 29               ADD HL, HL                      ; *32
4270+ BA9B 3A C4 BA         LD A, (.ecXlo)
