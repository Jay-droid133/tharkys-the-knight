 208+ 6D3E              TownGateRedrawPlayer_B7:
 209+ 6D3E CD 86 6C         CALL _PageBank0
 210+ 6D41 CD F9 62         CALL TownGateRedrawPlayer            ; -> TownGateErasePlayer -> RestoreOldAttr (bank 0)
 211+ 6D44 C3 98 6C         JP _PageBank7
 212+ 6D47
 213+ 6D47              ; --- slot 1 callee que deja bank 0 paginado al RET (solo post-wrap) ---
 214+ 6D47
 215+ 6D47              LoadBgSpriteToBuffer_B7:                 ; HL = sprite ptr, A = bank
 216+ 6D47 CD CA 67         CALL LoadBgSpriteToBuffer            ; ya pagina bank 3/4 internamente, deja bank 0 al RET
 217+ 6D4A C3 98 6C         JP _PageBank7                        ; repaginar bank 7 (LoadBgSpriteToBuffer no lo hace)
 218+ 6D4D
 219+ 6D4D              ; --- slot 2 callees que internamente paginan bank 6 (sprite_data) y "restauran"
 220+ 6D4D              ;     bank 0 al RET, no el bank original. Si los llamasemos crudamente desde
 221+ 6D4D              ;     bank 7, slot 3 terminaria con bank 0 -> body bank 7 invisible -> crash.
 222+ 6D4D              ;     KillAllActiveNasties -> SnapPuffPos -> GetSpriteDims (pagina bank 6).
 223+ 6D4D              ;     KillDeathIfActive    -> StartMusic   (pagina bank 4). ---
 224+ 6D4D
 225+ 6D4D              KillAllActiveNasties_B7:
 226+ 6D4D CD 26 BA         CALL KillAllActiveNasties
 227+ 6D50 C3 98 6C         JP _PageBank7                        ; restaura bank 7 (KillAll dejo bank 0)
 228+ 6D53
 229+ 6D53              KillDeathIfActive_B7:
 230+ 6D53 CD 77 62         CALL KillDeathIfActive
 231+ 6D56 C3 98 6C         JP _PageBank7                        ; restaura bank 7 (StartMusic dejo bank 0)
