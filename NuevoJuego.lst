 196+ F10F              ; ==============================================================================
 197+ F10F              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 198+ F10F              ; ==============================================================================
 199+ F10F              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 200+ F10F              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 201+ F10F              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 202+ F10F              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 203+ F10F              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 204+ F10F              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 205+ F10F              ;               actuales; queda como salvaguarda.
 206+ F10F              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 207+ F10F              ; Destruye: AF, BC, DE, HL.
 208+ F10F              ; ==============================================================================
 209+ F10F              ResolveObjectiveScreen:
 210+ F10F 3A 51 82         LD A, (CurrentObjective)
 211+ F112 FE 09            CP 9
 212+ F114 30 2F            JR NC, .rosNoTarget
 213+ F116 87               ADD A, A
 214+ F117 6F               LD L, A
 215+ F118 26 00            LD H, 0
 216+ F11A 11 49 F0         LD DE, MilestoneResolveTable
 217+ F11D 19               ADD HL, DE
 218+ F11E 7E               LD A, (HL)                          ; tipo
 219+ F11F 23               INC HL
 220+ F120 46               LD B, (HL)                          ; B = ref
 221+ F121 FE 01            CP MILESTONE_TYPE_PICKUP
 222+ F123 28 06            JR Z, .rosPickup
 223+ F125 FE 02            CP MILESTONE_TYPE_TRIGGER
 224+ F127 28 08            JR Z, .rosTrigger
 225+ F129 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 226+ F12B              .rosPickup:
 227+ F12B 78               LD A, B
 228+ F12C CD 4E F1         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 229+ F12F 18 08            JR .rosFindPos
 230+ F131              .rosTrigger:
 231+ F131 78               LD A, B
 232+ F132 CD 5B F1         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 233+ F135 7A               LD A, D
 234+ F136 B3               OR E
 235+ F137 28 0C            JR Z, .rosNoTarget
 236+ F139              .rosFindPos:
 237+ F139 CD 76 F1         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 238+ F13C 78               LD A, B
 239+ F13D 32 52 82         LD (ObjectiveScreenX), A
 240+ F140 79               LD A, C
 241+ F141 32 53 82         LD (ObjectiveScreenY), A
 242+ F144 C9               RET
 243+ F145              .rosNoTarget:
 244+ F145 3E FF            LD A, $FF
 245+ F147 32 52 82         LD (ObjectiveScreenX), A
 246+ F14A 32 53 82         LD (ObjectiveScreenY), A
 247+ F14D C9               RET
 248+ F14E
 249+ F14E              ; ==============================================================================
 250+ F14E              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 251+ F14E              ; ==============================================================================
 252+ F14E              ; IN:  A = key id (1..6)
 253+ F14E              ; OUT: DE = ptr
 254+ F14E              ; Destruye: AF, HL.
 255+ F14E              ; ==============================================================================
 256+ F14E              KeyIdToPtr:
 257+ F14E 3D               DEC A
 258+ F14F 87               ADD A, A                            ; *2 (DEFW size)
 259+ F150 6F               LD L, A
 260+ F151 26 00            LD H, 0
 261+ F153 11 36 D9         LD DE, KeyLockTable
 262+ F156 19               ADD HL, DE
 263+ F157 5E               LD E, (HL)
 264+ F158 23               INC HL
 265+ F159 56               LD D, (HL)
 266+ F15A C9               RET
 267+ F15B
 268+ F15B              ; ==============================================================================
 269+ F15B              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 270+ F15B              ; ==============================================================================
 271+ F15B              ; IN:  A = action id (1, 2, ...)
 272+ F15B              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 273+ F15B              ;      Z flag set si no encontrado.
 274+ F15B              ; Destruye: AF, BC, HL.
 275+ F15B              ; ==============================================================================
 276+ F15B              ActionToTriggerPtr:
 277+ F15B 4F               LD C, A                             ; C = action id buscada
 278+ F15C 21 C4 D9         LD HL, BumpTriggerTable
 279+ F15F              .attLoop:
 280+ F15F 5E               LD E, (HL)
 281+ F160 23               INC HL
 282+ F161 56               LD D, (HL)
 283+ F162 23               INC HL                              ; HL -> required_key
 284+ F163 7A               LD A, D
 285+ F164 B3               OR E
 286+ F165 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 287+ F167 23               INC HL                              ; HL -> action
 288+ F168 7E               LD A, (HL)
 289+ F169 23               INC HL                              ; HL -> next entry
 290+ F16A B9               CP C
 291+ F16B 20 F2            JR NZ, .attLoop
 292+ F16D F6 01            OR 1                                ; clear Z (encontrado)
 293+ F16F C9               RET
 294+ F170              .attNotFound:
 295+ F170 16 00            LD D, 0
 296+ F172 1E 00            LD E, 0
 297+ F174 AF               XOR A                               ; set Z
 298+ F175 C9               RET
 299+ F176
 300+ F176              ; ==============================================================================
 301+ F176              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 302+ F176              ; ==============================================================================
 303+ F176              ; PickupTable layout (per-entry, 7 bytes):
 304+ F176              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 305+ F176              ; Terminator: $FF (single byte).
 306+ F176              ;
 307+ F176              ; IN:  DE = ptr a buscar
 308+ F176              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 309+ F176              ;      B = C = $FF si no encontrado (Z).
 310+ F176              ; Destruye: AF, HL. Preserva DE.
 311+ F176              ; ==============================================================================
 312+ F176              FindPickupScreen:
 313+ F176 21 FB E0         LD HL, PickupTable
 314+ F179              .fpsLoop:
 315+ F179 7E               LD A, (HL)
 316+ F17A FE FF            CP $FF
 317+ F17C 28 1C            JR Z, .fpsNotFound
 318+ F17E E5               PUSH HL
 319+ F17F 23               INC HL                              ; -> mapY
 320+ F180 23               INC HL                              ; -> ptr_lo
 321+ F181 7E               LD A, (HL)
 322+ F182 BB               CP E
 323+ F183 20 0C            JR NZ, .fpsNoMatch
 324+ F185 23               INC HL                              ; -> ptr_hi
 325+ F186 7E               LD A, (HL)
 326+ F187 BA               CP D
 327+ F188 20 07            JR NZ, .fpsNoMatch
 328+ F18A E1               POP HL                              ; back to entry start (mapX)
 329+ F18B 46               LD B, (HL)                          ; B = mapX
 330+ F18C 23               INC HL
 331+ F18D 4E               LD C, (HL)                          ; C = mapY
 332+ F18E F6 01            OR 1                                ; clear Z (NZ = encontrado)
 333+ F190 C9               RET
 334+ F191              .fpsNoMatch:
 335+ F191 E1               POP HL
 336+ F192 C5               PUSH BC
 337+ F193 01 07 00         LD BC, 7
 338+ F196 09               ADD HL, BC
 339+ F197 C1               POP BC
 340+ F198 18 DF            JR .fpsLoop
 341+ F19A              .fpsNotFound:
 342+ F19A 06 FF            LD B, $FF
 343+ F19C 0E FF            LD C, $FF
 344+ F19E AF               XOR A                               ; set Z
 345+ F19F C9               RET
 346+ F1A0
 347+ F1A0              ; ==============================================================================
 348+ F1A0              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 349+ F1A0              ; ==============================================================================
 350+ F1A0              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 351+ F1A0              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 352+ F1A0              ; third). El brujula se redibuja solo cuando:
 353+ F1A0              ;   - cambias de pantalla (LastCompassScreen != Current)
 354+ F1A0              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 355+ F1A0              ; En reposo es un no-op barato (solo unas comparaciones).
 356+ F1A0              ;
 357+ F1A0              ; Color (atributo de las 4 celdas):
 358+ F1A0              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 359+ F1A0              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 360+ F1A0              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 361+ F1A0              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 362+ F1A0              ;
 363+ F1A0              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 364+ F1A0              ; ==============================================================================
 365+ F1A0
 366+ F1A0              COMPASS_COL     EQU 24
 367+ F1A0              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 368+ F1A0
 369+ F1A0              ; ==============================================================================
 370+ F1A0              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 371+ F1A0              ; ==============================================================================
 372+ F1A0              DrawCompass:
 373+ F1A0                  ; Sin objetivo resuelto -> limpiar y salir
 374+ F1A0 3A 52 82         LD A, (ObjectiveScreenX)
 375+ F1A3 FE FF            CP $FF
 376+ F1A5 CA EC F2         JP Z, ClearCompass
 377+ F1A8
 378+ F1A8                  ; Necesita redraw? screen cambio, PrevDist == $FF, o wobble activo.
 379+ F1A8 3A 8F 82         LD A, (CurrentScreenX)
 380+ F1AB 47               LD B, A
 381+ F1AC 3A 55 82         LD A, (LastCompassScreenX)
 382+ F1AF B8               CP B
 383+ F1B0 20 16            JR NZ, .dcRedraw
 384+ F1B2 3A 90 82         LD A, (CurrentScreenY)
 385+ F1B5 47               LD B, A
 386+ F1B6 3A 56 82         LD A, (LastCompassScreenY)
 387+ F1B9 B8               CP B
 388+ F1BA 20 0C            JR NZ, .dcRedraw
 389+ F1BC 3A 54 82         LD A, (PreviousObjectiveDistance)
 390+ F1BF FE FF            CP $FF
 391+ F1C1 28 05            JR Z, .dcRedraw
 392+ F1C3 3A 57 82         LD A, (CompassWobbleCounter)
 393+ F1C6 B7               OR A
 394+ F1C7 C8               RET Z                               ; sin cambios y sin wobble -> nada
 395+ F1C8
 396+ F1C8              .dcRedraw:
 397+ F1C8                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 398+ F1C8 3A 52 82         LD A, (ObjectiveScreenX)
 399+ F1CB 47               LD B, A
 400+ F1CC 3A 8F 82         LD A, (CurrentScreenX)
 401+ F1CF 4F               LD C, A
 402+ F1D0 78               LD A, B
 403+ F1D1 91               SUB C                               ; A = dx (signed)
 404+ F1D2                  ; abs(dx) -> H, sign(dx)+1 -> L
 405+ F1D2 F2 DC F1         JP P, .dcDxNonNeg
 406+ F1D5 ED 44            NEG
 407+ F1D7 67               LD H, A                             ; abs(dx)
 408+ F1D8 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 409+ F1DA 18 0A            JR .dcDxDone
 410+ F1DC              .dcDxNonNeg:
 411+ F1DC 67               LD H, A
 412+ F1DD B7               OR A
 413+ F1DE 20 04            JR NZ, .dcDxPositive
 414+ F1E0 2E 01            LD L, 1                             ; dx == 0
 415+ F1E2 18 02            JR .dcDxDone
 416+ F1E4              .dcDxPositive:
 417+ F1E4 2E 02            LD L, 2
 418+ F1E6              .dcDxDone:
 419+ F1E6 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 420+ F1E7
 421+ F1E7                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 422+ F1E7 3A 53 82         LD A, (ObjectiveScreenY)
 423+ F1EA 47               LD B, A
 424+ F1EB 3A 90 82         LD A, (CurrentScreenY)
 425+ F1EE 4F               LD C, A
 426+ F1EF 78               LD A, B
 427+ F1F0 91               SUB C
 428+ F1F1 F2 FB F1         JP P, .dcDyNonNeg
 429+ F1F4 ED 44            NEG
 430+ F1F6 67               LD H, A
 431+ F1F7 2E 00            LD L, 0
 432+ F1F9 18 0A            JR .dcDyDone
 433+ F1FB              .dcDyNonNeg:
 434+ F1FB 67               LD H, A
 435+ F1FC B7               OR A
 436+ F1FD 20 04            JR NZ, .dcDyPositive
 437+ F1FF 2E 01            LD L, 1
 438+ F201 18 02            JR .dcDyDone
 439+ F203              .dcDyPositive:
 440+ F203 2E 02            LD L, 2
 441+ F205              .dcDyDone:
 442+ F205                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 443+ F205 D1               POP DE                              ; D = abs_dx, E = signdx+1
 444+ F206                  ; idx = (signdy+1)*3 + (signdx+1)
 445+ F206 7D               LD A, L
 446+ F207 87               ADD A, A
 447+ F208 85               ADD A, L                            ; A = (signdy+1)*3
 448+ F209 83               ADD A, E                            ; A = idx (0..8)
 449+ F20A 32 B9 F2         LD (.dcSpriteIdx), A
 450+ F20D                  ; distance = abs_dx + abs_dy
 451+ F20D 7A               LD A, D
 452+ F20E 84               ADD A, H
 453+ F20F 32 BA F2         LD (.dcDistance), A
 454+ F212
 455+ F212                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 456+ F212                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 457+ F212                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 458+ F212                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 459+ F212                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 460+ F212                  ; nuevo idx.
 461+ F212                  ; Counter == 0 -> sin override, idx = target.
 462+ F212                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 463+ F212                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 464+ F212                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 465+ F212 3A B9 F2         LD A, (.dcSpriteIdx)
 466+ F215 FE 04            CP 4
 467+ F217 20 06            JR NZ, .dcWobbleNotX
 468+ F219                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 469+ F219                  ; frame no redibuje innecesariamente.
 470+ F219 AF               XOR A
 471+ F21A 32 57 82         LD (CompassWobbleCounter), A
 472+ F21D 18 46            JR .dcWobbleEnd
 473+ F21F              .dcWobbleNotX:
 474+ F21F                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 475+ F21F 3A 8F 82         LD A, (CurrentScreenX)
 476+ F222 47               LD B, A
 477+ F223 3A 55 82         LD A, (LastCompassScreenX)
 478+ F226 B8               CP B
 479+ F227 20 0A            JR NZ, .dcWobbleStart
 480+ F229 3A 90 82         LD A, (CurrentScreenY)
 481+ F22C 47               LD B, A
 482+ F22D 3A 56 82         LD A, (LastCompassScreenY)
 483+ F230 B8               CP B
 484+ F231 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 485+ F233              .dcWobbleStart:
 486+ F233 3E 09            LD A, 9
 487+ F235 32 57 82         LD (CompassWobbleCounter), A
 488+ F238              .dcWobbleResolve:
 489+ F238 3A 57 82         LD A, (CompassWobbleCounter)
 490+ F23B B7               OR A
 491+ F23C 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 492+ F23E 3D               DEC A
 493+ F23F 32 57 82         LD (CompassWobbleCounter), A
 494+ F242                                                      ; A = phase 0..8 (1 frame por fase)
 495+ F242 21 0A F7         LD HL, WobblePhaseTable
 496+ F245 5F               LD E, A
 497+ F246 16 00            LD D, 0
 498+ F248 19               ADD HL, DE
 499+ F249 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 500+ F24A FE 02            CP 2
 501+ F24C 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 502+ F24E                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 503+ F24E                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 504+ F24E FE 03            CP 3
 505+ F250 38 01            JR C, .dcWobbleOffsetReady
 506+ F252 3D               DEC A
 507+ F253              .dcWobbleOffsetReady:
 508+ F253 5F               LD E, A
 509+ F254 3A B9 F2         LD A, (.dcSpriteIdx)
 510+ F257 87               ADD A, A                            ; idx*2
 511+ F258 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 512+ F259 83               ADD A, E                            ; +offset
 513+ F25A 21 E6 F6         LD HL, CompassWobbleTable
 514+ F25D 5F               LD E, A
 515+ F25E 16 00            LD D, 0
 516+ F260 19               ADD HL, DE
 517+ F261 7E               LD A, (HL)
 518+ F262 32 B9 F2         LD (.dcSpriteIdx), A                ; override
 519+ F265
 520+ F265              .dcWobbleEnd:
 521+ F265
 522+ F265                  ; --- Color ---
 523+ F265                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 524+ F265 3A B9 F2         LD A, (.dcSpriteIdx)
 525+ F268 FE 04            CP 4
 526+ F26A 28 18            JR Z, .dcWhite
 527+ F26C 3A 54 82         LD A, (PreviousObjectiveDistance)
 528+ F26F FE FF            CP $FF
 529+ F271 28 11            JR Z, .dcWhite
 530+ F273 47               LD B, A
 531+ F274 3A BA F2         LD A, (.dcDistance)
 532+ F277 B8               CP B
 533+ F278 28 0A            JR Z, .dcWhite                      ; igual = blanco
 534+ F27A 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 535+ F27C 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 536+ F27E 18 06            JR .dcColorDone
 537+ F280              .dcGreen:
 538+ F280 3E 44            LD A, GREEN | $40
 539+ F282 18 02            JR .dcColorDone
 540+ F284              .dcWhite:
 541+ F284 3E 47            LD A, WHITE | $40
 542+ F286              .dcColorDone:
 543+ F286 32 BB F2         LD (.dcAttr), A
 544+ F289
 545+ F289                  ; --- Sprite ptr de CompassSprites[idx] ---
 546+ F289 3A B9 F2         LD A, (.dcSpriteIdx)
 547+ F28C 87               ADD A, A                            ; *2
 548+ F28D 6F               LD L, A
 549+ F28E 26 00            LD H, 0
 550+ F290 11 D4 F6         LD DE, CompassSprites
 551+ F293 19               ADD HL, DE
 552+ F294 5E               LD E, (HL)
 553+ F295 23               INC HL
 554+ F296 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 555+ F297 CD BC F2         CALL DrawCompassSprite
 556+ F29A
 557+ F29A                  ; --- Attrs ---
 558+ F29A 3A BB F2         LD A, (.dcAttr)
 559+ F29D CD DF F2         CALL SetCompassAttrs
 560+ F2A0
 561+ F2A0                  ; --- Cachear estado ---
 562+ F2A0                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 563+ F2A0                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 564+ F2A0                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 565+ F2A0                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 566+ F2A0                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 567+ F2A0                  ; el wobble y la comparacion sigue siendo correcta.
 568+ F2A0 3A 57 82         LD A, (CompassWobbleCounter)
 569+ F2A3 B7               OR A
 570+ F2A4 20 06            JR NZ, .dcSkipPrevDistSave
 571+ F2A6 3A BA F2         LD A, (.dcDistance)
 572+ F2A9 32 54 82         LD (PreviousObjectiveDistance), A
 573+ F2AC              .dcSkipPrevDistSave:
 574+ F2AC 3A 8F 82         LD A, (CurrentScreenX)
 575+ F2AF 32 55 82         LD (LastCompassScreenX), A
 576+ F2B2 3A 90 82         LD A, (CurrentScreenY)
 577+ F2B5 32 56 82         LD (LastCompassScreenY), A
 578+ F2B8 C9               RET
 579+ F2B9
 580+ F2B9 00           .dcSpriteIdx: DEFB 0
 581+ F2BA 00           .dcDistance:  DEFB 0
 582+ F2BB 00           .dcAttr:      DEFB 0
 583+ F2BC
 584+ F2BC              ; ==============================================================================
 585+ F2BC              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 586+ F2BC              ; ==============================================================================
 587+ F2BC              ; IN: DE = ptr a 16 filas x 2 bytes
 588+ F2BC              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 589+ F2BC              ; Destruye: AF, B, HL.
 590+ F2BC              ; ==============================================================================
 591+ F2BC              DrawCompassSprite:
 592+ F2BC                  ; Char row 0 (rows 0-7 del sprite)
 593+ F2BC 26 40            LD H, $40
 594+ F2BE 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 595+ F2C0 06 08            LD B, 8
 596+ F2C2              .dcsRow0:
 597+ F2C2 1A               LD A, (DE)
 598+ F2C3 77               LD (HL), A
 599+ F2C4 13               INC DE
 600+ F2C5 23               INC HL
 601+ F2C6 1A               LD A, (DE)
 602+ F2C7 77               LD (HL), A
 603+ F2C8 13               INC DE
 604+ F2C9 2B               DEC HL
 605+ F2CA 24               INC H
 606+ F2CB 10 F5            DJNZ .dcsRow0
 607+ F2CD                  ; Char row 1 (rows 8-15 del sprite)
 608+ F2CD 26 40            LD H, $40
 609+ F2CF 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 610+ F2D1 06 08            LD B, 8
 611+ F2D3              .dcsRow1:
 612+ F2D3 1A               LD A, (DE)
 613+ F2D4 77               LD (HL), A
 614+ F2D5 13               INC DE
 615+ F2D6 23               INC HL
 616+ F2D7 1A               LD A, (DE)
 617+ F2D8 77               LD (HL), A
 618+ F2D9 13               INC DE
 619+ F2DA 2B               DEC HL
 620+ F2DB 24               INC H
 621+ F2DC 10 F5            DJNZ .dcsRow1
 622+ F2DE C9               RET
 623+ F2DF
 624+ F2DF              ; ==============================================================================
 625+ F2DF              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 626+ F2DF              ; ==============================================================================
 627+ F2DF              SetCompassAttrs:
 628+ F2DF 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 629+ F2E2 77               LD (HL), A
 630+ F2E3 23               INC HL
 631+ F2E4 77               LD (HL), A
 632+ F2E5 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 633+ F2E8 77               LD (HL), A
 634+ F2E9 23               INC HL
 635+ F2EA 77               LD (HL), A
 636+ F2EB C9               RET
 637+ F2EC
 638+ F2EC              ; ==============================================================================
 639+ F2EC              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 640+ F2EC              ; ==============================================================================
 641+ F2EC              ClearCompass:
 642+ F2EC 26 40            LD H, $40
 643+ F2EE 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 644+ F2F0 06 08            LD B, 8
 645+ F2F2 AF               XOR A
 646+ F2F3              .ccRow0:
 647+ F2F3 77               LD (HL), A
 648+ F2F4 23               INC HL
 649+ F2F5 77               LD (HL), A
 650+ F2F6 2B               DEC HL
 651+ F2F7 24               INC H
 652+ F2F8 10 F9            DJNZ .ccRow0
 653+ F2FA 26 40            LD H, $40
 654+ F2FC 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 655+ F2FE 06 08            LD B, 8
 656+ F300 AF               XOR A
 657+ F301              .ccRow1:
 658+ F301 77               LD (HL), A
 659+ F302 23               INC HL
 660+ F303 77               LD (HL), A
 661+ F304 2B               DEC HL
 662+ F305 24               INC H
 663+ F306 10 F9            DJNZ .ccRow1
 664+ F308 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 665+ F309 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 666+ F30C 77               LD (HL), A
 667+ F30D 23               INC HL
 668+ F30E 77               LD (HL), A
 669+ F30F 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 670+ F312 77               LD (HL), A
 671+ F313 23               INC HL
 672+ F314 77               LD (HL), A
 673+ F315 C9               RET
 674+ F316
 675+ F316              ; ==============================================================================
 676+ F316              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 677+ F316              ; ==============================================================================
 678+ F316              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 679+ F316              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 680+ F316              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 681+ F316              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 682+ F316              ; monstruo cae alli con la puerta abierta:
 683+ F316              ;   - Bit slot en MonsterTrappedFlags
 684+ F316              ;   - Despawn del monstruo (puff)
 685+ F316              ;   - Puerta se re-cierra (sprite + flag)
 686+ F316              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 687+ F316              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 688+ F316              ;
 689+ F316              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 690+ F316              ; auto-generadas por el level editor segun la posicion de la puerta y los
 691+ F316              ; markers AltKey1/AltKey2.
 692+ F316              ; ==============================================================================
 693+ F316
 694+ F316              ; ==============================================================================
 695+ F316              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 696+ F316              ; ==============================================================================
 697+ F316              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 698+ F316              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 699+ F316              ; Destruye: AF, BC.
 700+ F316              ; ==============================================================================
 701+ F316              CheckChurchTrap:
 702+ F316                  ; --- Solo en pantalla de la iglesia ---
 703+ F316 3A 8F 82         LD A, (CurrentScreenX)
 704+ F319 FE 0F            CP CHURCH_TRAP_SCREEN_X
 705+ F31B 20 5D            JR NZ, .cctNoTrap
 706+ F31D 3A 90 82         LD A, (CurrentScreenY)
 707+ F320 FE 06            CP CHURCH_TRAP_SCREEN_Y
 708+ F322 20 56            JR NZ, .cctNoTrap
 709+ F324                  ; --- Solo con la puerta abierta ---
 710+ F324 3A 4C 82         LD A, (ChurchDoorOpen)
 711+ F327 B7               OR A
 712+ F328 28 50            JR Z, .cctNoTrap
 713+ F32A                  ; --- Solo si el knockback es DIRECTO del player ---
 714+ F32A                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 715+ F32A                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 716+ F32A                  ; espada y se clear cuando se hereda kb por colision.
 717+ F32A DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 718+ F32E 28 4A            JR Z, .cctNoTrap
 719+ F330                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 720+ F330                  ; (acepta sprites de 16, 21 o 24 px de alto)
 721+ F330 DD 7E 04         LD A, (IX+ENT_POSY)
 722+ F333 CB 3F            SRL A
 723+ F335 CB 3F            SRL A
 724+ F337 CB 3F            SRL A                                   ; A = top charY del monster
 725+ F339 47               LD B, A
 726+ F33A 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 727+ F33C 90               SUB B                                   ; A = trap_charY - mon_charY
 728+ F33D FE 03            CP 3
 729+ F33F 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 730+ F341                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 731+ F341 DD 7E 03         LD A, (IX+ENT_POSX)
 732+ F344 CB 3F            SRL A
 733+ F346 CB 3F            SRL A
 734+ F348 CB 3F            SRL A
 735+ F34A 47               LD B, A                                 ; B = left charX del monster
 736+ F34B 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 737+ F34D 3C               INC A                                   ; A = LO_X + 1
 738+ F34E 90               SUB B                                   ; A = LO_X+1 - charX
 739+ F34F FE 03            CP 3
 740+ F351 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 741+ F353                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 742+ F353                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 743+ F353 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 744+ F356 D6 4C            SUB SPRID_MONSTER_0
 745+ F358 CB 3F            SRL A
 746+ F35A CB 3F            SRL A
 747+ F35C CB 3F            SRL A                                   ; A = type idx 0..2
 748+ F35E 47               LD B, A
 749+ F35F                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 750+ F35F 3A 59 82         LD A, (NextChurchTrapStep)
 751+ F362 FE 03            CP 3
 752+ F364 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 753+ F366 21 7C F3         LD HL, ChurchTrapOrderTable
 754+ F369 5F               LD E, A
 755+ F36A 16 00            LD D, 0
 756+ F36C 19               ADD HL, DE
 757+ F36D 7E               LD A, (HL)                              ; A = type esperado
 758+ F36E B8               CP B
 759+ F36F 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 760+ F371                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 761+ F371 CD 14 F4         CALL TriggerChurchTrap
 762+ F374 3E 01            LD A, 1
 763+ F376 C9               RET
 764+ F377              .cctBlockAsWall:
 765+ F377                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 766+ F377                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 767+ F377 3E 02            LD A, 2
 768+ F379 C9               RET
 769+ F37A              .cctNoTrap:
 770+ F37A AF               XOR A
 771+ F37B C9               RET
 772+ F37C
 773+ F37C              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 774+ F37C              ChurchTrapOrderTable:
 775+ F37C 00 02 01         DEFB 0, 2, 1
 776+ F37F
 777+ F37F              ; ==============================================================================
 778+ F37F              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 779+ F37F              ; blanco brillante sobre paper negro ($47).
 780+ F37F              ; ==============================================================================
 781+ F37F              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 782+ F37F              ; - No-op fuera de la sala de la iglesia.
 783+ F37F              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 784+ F37F              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 785+ F37F              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 786+ F37F              ;   aun no toca) conservan sus attrs originales del sprite.
 787+ F37F              ; Destruye: AF, BC, DE, HL.
 788+ F37F              ; ==============================================================================
 789+ F37F              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 790+ F37F              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 791+ F37F              HighlightExpectedStatue:
 792+ F37F 3E 47            LD A, $47
 793+ F381 18 00            JR PaintExpectedStatueAttr
 794+ F383
 795+ F383              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 796+ F383              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 797+ F383              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 798+ F383              PaintExpectedStatueAttr:
 799+ F383 32 ED F3         LD (.hesAttr), A
 800+ F386                  ; --- Solo en la sala de la iglesia ---
 801+ F386 3A 8F 82         LD A, (CurrentScreenX)
 802+ F389 FE 0F            CP CHURCH_TRAP_SCREEN_X
 803+ F38B C0               RET NZ
 804+ F38C 3A 90 82         LD A, (CurrentScreenY)
 805+ F38F FE 06            CP CHURCH_TRAP_SCREEN_Y
 806+ F391 C0               RET NZ
 807+ F392                  ; --- Solo tras abrir la iglesia 1a vez ---
 808+ F392                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 809+ F392                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 810+ F392                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 811+ F392                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 812+ F392                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 813+ F392 3A 4D 82         LD A, (ChurchEverOpened)
 814+ F395 B7               OR A
 815+ F396 C8               RET Z
 816+ F397                  ; --- Solo si quedan monstruos por atrapar ---
 817+ F397 3A 59 82         LD A, (NextChurchTrapStep)
 818+ F39A FE 03            CP 3
 819+ F39C D0               RET NC
 820+ F39D                  ; --- Type esperado -> statue id ---
 821+ F39D 21 7C F3         LD HL, ChurchTrapOrderTable
 822+ F3A0 5F               LD E, A
 823+ F3A1 16 00            LD D, 0
 824+ F3A3 19               ADD HL, DE
 825+ F3A4 7E               LD A, (HL)                              ; type idx esperado
 826+ F3A5 21 2E 67         LD HL, StatueIdTable
 827+ F3A8 5F               LD E, A
 828+ F3A9 16 00            LD D, 0
 829+ F3AB 19               ADD HL, DE
 830+ F3AC 7E               LD A, (HL)                              ; A = statue id
 831+ F3AD B7               OR A
 832+ F3AE C8               RET Z
 833+ F3AF 32 EE F3         LD (.hesTargetId), A
 834+ F3B2                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 835+ F3B2 2A 91 82         LD HL, (CurrentScreenAddr)
 836+ F3B5              .hesLoop:
 837+ F3B5 7E               LD A, (HL)
 838+ F3B6 FE FF            CP $FF
 839+ F3B8 C8               RET Z                                   ; estatua no en esta sala
 840+ F3B9 47               LD B, A
 841+ F3BA 3A EE F3         LD A, (.hesTargetId)
 842+ F3BD B8               CP B
 843+ F3BE 28 06            JR Z, .hesFound
 844+ F3C0 11 04 00         LD DE, 4
 845+ F3C3 19               ADD HL, DE
 846+ F3C4 18 EF            JR .hesLoop
 847+ F3C6              .hesFound:
 848+ F3C6 23               INC HL
 849+ F3C7 7E               LD A, (HL)                              ; charX
 850+ F3C8 47               LD B, A
 851+ F3C9 23               INC HL
 852+ F3CA 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 853+ F3CB C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 854+ F3CD 4F               LD C, A                                 ; C = charY (post-HUD)
 855+ F3CE                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 856+ F3CE 26 00            LD H, 0
 857+ F3D0 69               LD L, C
 858+ F3D1 29               ADD HL, HL
 859+ F3D2 29               ADD HL, HL
 860+ F3D3 29               ADD HL, HL
 861+ F3D4 29               ADD HL, HL
 862+ F3D5 29               ADD HL, HL                              ; HL = charY * 32
 863+ F3D6 58               LD E, B
 864+ F3D7 16 00            LD D, 0
 865+ F3D9 19               ADD HL, DE                              ; + charX
 866+ F3DA 11 00 58         LD DE, $5800
 867+ F3DD 19               ADD HL, DE                              ; HL = attr addr top-left
 868+ F3DE                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 869+ F3DE                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 870+ F3DE                  ; no hace falta sincronizar CleanAttrMap.
 871+ F3DE 3A ED F3         LD A, (.hesAttr)
 872+ F3E1 06 03            LD B, 3                                 ; 3 filas de chars
 873+ F3E3              .hesRow:
 874+ F3E3 77               LD (HL), A
 875+ F3E4 23               INC HL
 876+ F3E5 77               LD (HL), A                              ; (charX+1)
 877+ F3E6 11 1F 00         LD DE, 31
 878+ F3E9 19               ADD HL, DE                              ; siguiente fila col 0
 879+ F3EA 10 F7            DJNZ .hesRow
 880+ F3EC C9               RET
 881+ F3ED 00           .hesAttr:     DEFB 0
 882+ F3EE 00           .hesTargetId: DEFB 0
 883+ F3EF
 884+ F3EF              ; ==============================================================================
 885+ F3EF              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 886+ F3EF              ; ==============================================================================
 887+ F3EF              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 888+ F3EF              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 889+ F3EF              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 890+ F3EF              ; + ON final settle): 8 ciclos de ON-OFF en total.
 891+ F3EF              ; ==============================================================================
 892+ F3EF              STATUE_BLINK_FRAMES   EQU 32
 893+ F3EF
 894+ F3EF              StartStatueBlink:
 895+ F3EF                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 896+ F3EF                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 897+ F3EF                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 898+ F3EF                  ; (caso A), .cbtActChurchDoor (caso B).
 899+ F3EF 3E 20            LD A, STATUE_BLINK_FRAMES
 900+ F3F1 32 5A 82         LD (StatueBlinkCounter), A
 901+ F3F4 C3 7F F3         JP HighlightExpectedStatue              ; initial ON paint
 902+ F3F7
 903+ F3F7              UpdateStatueBlink:
 904+ F3F7                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 905+ F3F7 3A 5A 82         LD A, (StatueBlinkCounter)
 906+ F3FA B7               OR A
 907+ F3FB C8               RET Z
 908+ F3FC 3D               DEC A
 909+ F3FD 32 5A 82         LD (StatueBlinkCounter), A
 910+ F400 20 03            JR NZ, .usbInProgress
 911+ F402                  ; Counter recien llego a 0: settle ON
 912+ F402 C3 7F F3         JP HighlightExpectedStatue
 913+ F405              .usbInProgress:
 914+ F405                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 915+ F405                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 916+ F405 CB 3F            SRL A
 917+ F407 E6 01            AND $01
 918+ F409 28 05            JR Z, .usbOff
 919+ F40B 3E 47            LD A, $47
 920+ F40D C3 83 F3         JP PaintExpectedStatueAttr
 921+ F410              .usbOff:
 922+ F410 AF               XOR A
 923+ F411 C3 83 F3         JP PaintExpectedStatueAttr
 924+ F414
 925+ F414              ; ==============================================================================
 926+ F414              ; CUTSCENE - parametros ajustables
 927+ F414              ; ==============================================================================
 928+ F414              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 929+ F414              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 930+ F414              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 931+ F414              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 932+ F414
 933+ F414              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 934+ F414              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 935+ F414              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 936+ F414
 937+ F414              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
 938+ F414              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
 939+ F414              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
 940+ F414              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
 941+ F414              ;   tick 12 -> erase smoke[2], pasar a DONE
 942+ F414              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
 943+ F414              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
 944+ F414
 945+ F414              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
 946+ F414              ; base del vano (auto-derivada por el editor). El monster (3 chars de
 947+ F414              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
 948+ F414              ; centrado dentro del vano de la puerta.
 949+ F414              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
 950+ F414              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
 951+ F414              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
 952+ F414              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
 953+ F414
 954+ F414              ; ==============================================================================
 955+ F414              ; TriggerChurchTrap - arranca la cutscene de la iglesia
 956+ F414              ; ==============================================================================
 957+ F414              ; IN: IX = monster atrapado.
 958+ F414              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
 959+ F414              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
 960+ F414              ; en ApplyChurchTrapEffects al final del cutscene.
 961+ F414              ; ==============================================================================
 962+ F414              TriggerChurchTrap:
 963+ F414                  ; --- 1. Calcular slot 0..2 ---
 964+ F414 DD E5            PUSH IX
 965+ F416 E1               POP HL
 966+ F417 11 46 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 967+ F41A B7               OR A
 968+ F41B ED 52            SBC HL, DE
 969+ F41D CB 3D            SRL L
 970+ F41F CB 3D            SRL L
 971+ F421 CB 3D            SRL L
 972+ F423 CB 3D            SRL L                                   ; L = slot 0..2
 973+ F425 7D               LD A, L
 974+ F426 32 9E 5F         LD (ChurchCutsceneSlot), A
 975+ F429                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
 976+ F429 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 977+ F42C D6 4C            SUB SPRID_MONSTER_0
 978+ F42E CB 3F            SRL A
 979+ F430 CB 3F            SRL A
 980+ F432 CB 3F            SRL A                                   ; A = type idx
 981+ F434 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
 982+ F437                  ; --- 2. Mover monster al centro del vano ---
 983+ F437 3E 78            LD A, CHURCH_TRAP_AREA_POSX
 984+ F439 DD 77 03         LD (IX+ENT_POSX), A
 985+ F43C 3E 58            LD A, CHURCH_TRAP_AREA_POSY
 986+ F43E DD 77 04         LD (IX+ENT_POSY), A
 987+ F441 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 988+ F445 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 989+ F449 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
 990+ F44D                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
 991+ F44D                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
 992+ F44D                  ; del shake y del humo se renderizarian invisibles (ink black sobre
 993+ F44D                  ; paper black). Forzando ON aqui garantizamos que la animacion de
 994+ F44D                  ; temblor se vea con ink blanco brillante sobre paper negro.
 995+ F44D AF               XOR A
 996+ F44E 32 5A 82         LD (StatueBlinkCounter), A              ; parar blink
 997+ F451 DD E5            PUSH IX
 998+ F453 CD 7F F3         CALL HighlightExpectedStatue            ; pintar $47
 999+ F456 DD E1            POP IX
1000+ F458                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1001+ F458 3E 01            LD A, 1
1002+ F45A 32 5D 82         LD (ChurchCutscenePhase), A
1003+ F45D AF               XOR A
1004+ F45E 32 9D 5F         LD (ChurchCutsceneFrame), A
1005+ F461 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1006+ F463 32 A4 5F         LD (ChurchCutsceneLookCount), A
1007+ F466 C9               RET
1008+ F467
1009+ F467              ; ==============================================================================
1010+ F467              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1011+ F467              ; ==============================================================================
1012+ F467              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1013+ F467              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1014+ F467              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1015+ F467              ; ==============================================================================
1016+ F467              UpdateChurchCutscene:
1017+ F467 3A 5D 82         LD A, (ChurchCutscenePhase)
1018+ F46A B7               OR A
1019+ F46B C8               RET Z
1020+ F46C 3D               DEC A
1021+ F46D 28 12            JR Z, .ucsLookPhase
1022+ F46F 3D               DEC A
1023+ F470 28 38            JR Z, .ucsShakeStatuePhase
1024+ F472 3D               DEC A
1025+ F473 CA FC F4         JP Z, .ucsSmokePhase
1026+ F476                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1027+ F476 CD B1 66         CALL ApplyChurchTrapDone
1028+ F479 AF               XOR A
1029+ F47A 32 5D 82         LD (ChurchCutscenePhase), A
1030+ F47D 32 9D 5F         LD (ChurchCutsceneFrame), A
1031+ F480 C9               RET
1032+ F481
1033+ F481              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1034+ F481              .ucsLookPhase:
1035+ F481                  ; Frame counter (para detectar fin de fase)
1036+ F481 21 9D 5F         LD HL, ChurchCutsceneFrame
1037+ F484 34               INC (HL)
1038+ F485                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1039+ F485 21 A4 5F         LD HL, ChurchCutsceneLookCount
1040+ F488 35               DEC (HL)
1041+ F489 20 06            JR NZ, .ucsLookCheckEnd
1042+ F48B 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1043+ F48D 77               LD (HL), A
1044+ F48E CD 4A F5         CALL ChurchCutsceneToggleMonsterDir
1045+ F491              .ucsLookCheckEnd:
1046+ F491 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1047+ F494 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1048+ F496 D8               RET C                                   ; sigue mirando
1049+ F497                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1050+ F497                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1051+ F497                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1052+ F497 CD 8D 66         CALL EraseChurchTrappedMonster
1053+ F49A CD 24 69         CALL CloseChurchDoor
1054+ F49D CD 6F F5         CALL ChurchCutsceneInitStatueShake
1055+ F4A0 3E 02            LD A, 2
1056+ F4A2 32 5D 82         LD (ChurchCutscenePhase), A
1057+ F4A5 AF               XOR A
1058+ F4A6 32 9D 5F         LD (ChurchCutsceneFrame), A
1059+ F4A9 C9               RET
1060+ F4AA
1061+ F4AA              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1062+ F4AA              .ucsShakeStatuePhase:
1063+ F4AA 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1064+ F4AD FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1065+ F4AF 30 35            JR NC, .ucsShakeStatueDone
1066+ F4B1                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1067+ F4B1                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1068+ F4B1                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1069+ F4B1                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1070+ F4B1                  ;
1071+ F4B1                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1072+ F4B1                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1073+ F4B1 ED 5F            LD A, R
1074+ F4B3 E6 03            AND $03
1075+ F4B5 21 E2 F4         LD HL, .ucsShakeJitterTable
1076+ F4B8 5F               LD E, A
1077+ F4B9 16 00            LD D, 0
1078+ F4BB 19               ADD HL, DE
1079+ F4BC 7E               LD A, (HL)
1080+ F4BD 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1081+ F4BE                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1082+ F4BE 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1083+ F4C1 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1084+ F4C3 21 2E 67         LD HL, StatueIdTable
1085+ F4C6 38 03            JR C, .ucsShakeTablePicked
1086+ F4C8 21 31 67         LD HL, StatueBrokenIdTable
1087+ F4CB              .ucsShakeTablePicked:
1088+ F4CB 78               LD A, B                                 ; restore jitter para la llamada
1089+ F4CC CD D9 F5         CALL ChurchCutsceneShakeStatueByteShift
1090+ F4CF                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1091+ F4CF                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1092+ F4CF                  ; y al salir de la fase forzamos borde a negro explicitamente.
1093+ F4CF 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1094+ F4D2 E6 01            AND $01
1095+ F4D4 28 04            JR Z, .ucsShakeBorderBlack
1096+ F4D6 3E 07            LD A, WHITE
1097+ F4D8 18 01            JR .ucsShakeBorderOut
1098+ F4DA              .ucsShakeBorderBlack:
1099+ F4DA AF               XOR A                                   ; BLACK
1100+ F4DB              .ucsShakeBorderOut:
1101+ F4DB D3 FE            OUT (254), A
1102+ F4DD 21 9D 5F         LD HL, ChurchCutsceneFrame
1103+ F4E0 34               INC (HL)
1104+ F4E1 C9               RET
1105+ F4E2              .ucsShakeJitterTable:
1106+ F4E2 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1107+ F4E6              .ucsShakeStatueDone:
1108+ F4E6                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1109+ F4E6 AF               XOR A
1110+ F4E7 D3 FE            OUT (254), A
1111+ F4E9                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1112+ F4E9                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1113+ F4E9                  ; directo a 0 garantiza que no queden residuos.)
1114+ F4E9 CD 44 F6         CALL ChurchCutsceneEraseStatueDirect
1115+ F4EC 21 B2 F8         LD HL, SFX_EnemyDeath
1116+ F4EF CD 33 F8         CALL PlaySFX
1117+ F4F2 3E 03            LD A, 3
1118+ F4F4 32 5D 82         LD (ChurchCutscenePhase), A
1119+ F4F7 AF               XOR A
1120+ F4F8 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1121+ F4FB C9               RET
1122+ F4FC
1123+ F4FC              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1124+ F4FC              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1125+ F4FC              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1126+ F4FC              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1127+ F4FC              ; Entre transiciones, solo incrementa frame counter.
1128+ F4FC              .ucsSmokePhase:
1129+ F4FC 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1130+ F4FF B7               OR A
1131+ F500 28 0E            JR Z, .ucsSmokeEntry
1132+ F502 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1133+ F504 28 16            JR Z, .ucsSmokeStep1
1134+ F506 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1135+ F508 28 1D            JR Z, .ucsSmokeStep2
1136+ F50A FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1137+ F50C 28 25            JR Z, .ucsSmokeEnd
1138+ F50E 18 35            JR .ucsSmokeIncFrame
1139+ F510              .ucsSmokeEntry:
1140+ F510                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1141+ F510 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1142+ F513 CD 59 68         CALL DrawRemainsForType
1143+ F516                  ; Dibujar smoke[0] (XOR)
1144+ F516 AF               XOR A
1145+ F517 CD A4 67         CALL DrawSmokeFrameXor
1146+ F51A 18 29            JR .ucsSmokeIncFrame
1147+ F51C              .ucsSmokeStep1:
1148+ F51C AF               XOR A
1149+ F51D CD A4 67         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1150+ F520 3E 01            LD A, 1
1151+ F522 CD A4 67         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1152+ F525 18 1E            JR .ucsSmokeIncFrame
1153+ F527              .ucsSmokeStep2:
1154+ F527 3E 01            LD A, 1
1155+ F529 CD A4 67         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1156+ F52C 3E 02            LD A, 2
1157+ F52E CD A4 67         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1158+ F531 18 12            JR .ucsSmokeIncFrame
1159+ F533              .ucsSmokeEnd:
1160+ F533 3E 02            LD A, 2
1161+ F535 CD A4 67         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1162+ F538 CD C3 67         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1163+ F53B 3E 04            LD A, 4
1164+ F53D 32 5D 82         LD (ChurchCutscenePhase), A
1165+ F540 AF               XOR A
1166+ F541 32 9D 5F         LD (ChurchCutsceneFrame), A
1167+ F544 C9               RET
1168+ F545              .ucsSmokeIncFrame:
1169+ F545 21 9D 5F         LD HL, ChurchCutsceneFrame
1170+ F548 34               INC (HL)
1171+ F549 C9               RET
1172+ F54A
1173+ F54A              ; ==============================================================================
1174+ F54A              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1175+ F54A              ; ==============================================================================
1176+ F54A              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1177+ F54A              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1178+ F54A              ; ==============================================================================
1179+ F54A              ChurchCutsceneToggleMonsterDir:
1180+ F54A                  ; IX = trapped monster
1181+ F54A 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1182+ F54D 3C               INC A
1183+ F54E 6F               LD L, A
1184+ F54F 26 00            LD H, 0
1185+ F551 29               ADD HL, HL
1186+ F552 29               ADD HL, HL
1187+ F553 29               ADD HL, HL
1188+ F554 29               ADD HL, HL
1189+ F555 11 36 81         LD DE, EntityTable
1190+ F558 19               ADD HL, DE
1191+ F559 E5               PUSH HL
1192+ F55A DD E1            POP IX
1193+ F55C                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1194+ F55C DD 7E 00         LD A, (IX+ENT_SPRITEID)
1195+ F55F DD 96 08         SUB (IX+ENT_ANIMBASE)
1196+ F562 EE 04            XOR 4
1197+ F564 47               LD B, A
1198+ F565 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1199+ F568 80               ADD A, B
1200+ F569 DD 77 00         LD (IX+ENT_SPRITEID), A
1201+ F56C C3 5E F6         JP RedrawTrappedMonster
1202+ F56F
1203+ F56F              ; ==============================================================================
1204+ F56F              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1205+ F56F              ; ==============================================================================
1206+ F56F              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1207+ F56F              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1208+ F56F              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1209+ F56F              ; ==============================================================================
1210+ F56F              ChurchCutsceneInitStatueShake:
1211+ F56F 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1212+ F572 21 2E 67         LD HL, StatueIdTable
1213+ F575 5F               LD E, A
1214+ F576 16 00            LD D, 0
1215+ F578 19               ADD HL, DE
1216+ F579 7E               LD A, (HL)                              ; A = statue id
1217+ F57A B7               OR A
1218+ F57B C8               RET Z                                   ; sin estatua
1219+ F57C 32 AC F5         LD (.cisTargetId), A
1220+ F57F                  ; Buscar en CurrentScreenBuffer
1221+ F57F 2A 91 82         LD HL, (CurrentScreenAddr)
1222+ F582              .cisLoop:
1223+ F582 7E               LD A, (HL)
1224+ F583 FE FF            CP $FF
1225+ F585 C8               RET Z                                   ; no encontrada (no se hace shake)
1226+ F586 47               LD B, A
1227+ F587 3A AC F5         LD A, (.cisTargetId)
1228+ F58A B8               CP B
1229+ F58B 28 06            JR Z, .cisFound
1230+ F58D 11 04 00         LD DE, 4
1231+ F590 19               ADD HL, DE
1232+ F591 18 EF            JR .cisLoop
1233+ F593              .cisFound:
1234+ F593 23               INC HL
1235+ F594 7E               LD A, (HL)                              ; charX
1236+ F595                  ; Pixel X = charX * 8
1237+ F595 87               ADD A, A
1238+ F596 87               ADD A, A
1239+ F597 87               ADD A, A
1240+ F598 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1241+ F59B 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1242+ F59E 23               INC HL
1243+ F59F 7E               LD A, (HL)                              ; charY
1244+ F5A0                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1245+ F5A0 C6 02            ADD A, BG_Y_OFFSET
1246+ F5A2 87               ADD A, A
1247+ F5A3 87               ADD A, A
1248+ F5A4 87               ADD A, A
1249+ F5A5 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1250+ F5A8 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1251+ F5AB C9               RET
1252+ F5AC 00           .cisTargetId: DEFB 0
1253+ F5AD
1254+ F5AD              ; ==============================================================================
1255+ F5AD              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1256+ F5AD              ; ==============================================================================
1257+ F5AD              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1258+ F5AD              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1259+ F5AD              ; ==============================================================================
1260+ F5AD              ChurchCutsceneEraseStatueAtLast:
1261+ F5AD              ChurchCutsceneDrawStatueAtLast:
1262+ F5AD 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1263+ F5B0 21 2E 67         LD HL, StatueIdTable
1264+ F5B3 5F               LD E, A
1265+ F5B4 16 00            LD D, 0
1266+ F5B6 19               ADD HL, DE
1267+ F5B7 7E               LD A, (HL)                              ; A = statue id
1268+ F5B8 B7               OR A
1269+ F5B9 C8               RET Z
1270+ F5BA                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1271+ F5BA 6F               LD L, A
1272+ F5BB 26 00            LD H, 0
1273+ F5BD 54               LD D, H
1274+ F5BE 5D               LD E, L
1275+ F5BF 29               ADD HL, HL
1276+ F5C0 19               ADD HL, DE                              ; HL = id*3
1277+ F5C1 11 99 E1         LD DE, BgGfxPtrById
1278+ F5C4 19               ADD HL, DE
1279+ F5C5 5E               LD E, (HL)
1280+ F5C6 23               INC HL
1281+ F5C7 56               LD D, (HL)                              ; DE = sprite ptr
1282+ F5C8 23               INC HL
1283+ F5C9 7E               LD A, (HL)                              ; A = bank
1284+ F5CA EB               EX DE, HL                               ; HL = sprite ptr
1285+ F5CB CD 41 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1286+ F5CE                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1287+ F5CE 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1288+ F5D1 57               LD D, A
1289+ F5D2 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1290+ F5D5 5F               LD E, A
1291+ F5D6 C3 B6 68         JP DrawBgSprite16XorAtPixel
1292+ F5D9
1293+ F5D9              ; ==============================================================================
1294+ F5D9              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1295+ F5D9              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1296+ F5D9              ;     A  = jitter signed (-1, 0, +1) en bits.
1297+ F5D9              ; ==============================================================================
1298+ F5D9              ; IN: A = jitter signed (-1, 0, +1) en bits.
1299+ F5D9              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1300+ F5D9              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1301+ F5D9              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1302+ F5D9              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1303+ F5D9              ; version shifted, sin XOR.
1304+ F5D9              ;
1305+ F5D9              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1306+ F5D9              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1307+ F5D9              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1308+ F5D9              ; estatua se perdio cuando la estatua se pinto la primera vez con
1309+ F5D9              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1310+ F5D9              ; de la estatua, el wall perdido no se ve.
1311+ F5D9              ;
1312+ F5D9              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1313+ F5D9              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1314+ F5D9              ; shift de 1 bit no pierde pixels visibles.
1315+ F5D9              ; Destruye: AF, BC, DE, HL, IX.
1316+ F5D9              ; ==============================================================================
1317+ F5D9              ChurchCutsceneShakeStatueByteShift:
1318+ F5D9 32 43 F6         LD (.csbsJitter), A
1319+ F5DC                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1320+ F5DC 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1321+ F5DF 5F               LD E, A
1322+ F5E0 16 00            LD D, 0
1323+ F5E2 19               ADD HL, DE
1324+ F5E3 7E               LD A, (HL)
1325+ F5E4 B7               OR A
1326+ F5E5 C8               RET Z                                   ; sin estatua
1327+ F5E6 6F               LD L, A
1328+ F5E7 26 00            LD H, 0
1329+ F5E9 54               LD D, H
1330+ F5EA 5D               LD E, L
1331+ F5EB 29               ADD HL, HL
1332+ F5EC 19               ADD HL, DE                              ; HL = id*3
1333+ F5ED 11 99 E1         LD DE, BgGfxPtrById
1334+ F5F0 19               ADD HL, DE
1335+ F5F1 5E               LD E, (HL)
1336+ F5F2 23               INC HL
1337+ F5F3 56               LD D, (HL)                              ; DE = sprite ptr
1338+ F5F4 23               INC HL
1339+ F5F5 7E               LD A, (HL)                              ; A = bank
1340+ F5F6 EB               EX DE, HL                               ; HL = sprite ptr
1341+ F5F7 CD 41 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1342+ F5FA                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1343+ F5FA DD 21 7C 89      LD IX, BgSpriteBuffer
1344+ F5FE DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1345+ F601 B7               OR A
1346+ F602 C8               RET Z
1347+ F603 47               LD B, A                                 ; B = row counter
1348+ F604 DD 23            INC IX
1349+ F606 DD 23            INC IX                                  ; IX -> pixel data
1350+ F608                  ; Calcular addr VRAM en (origX, origY)
1351+ F608 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1352+ F60B 57               LD D, A
1353+ F60C 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1354+ F60F 5F               LD E, A
1355+ F610 CD 41 A1         CALL CalcPixelAddr                      ; HL = VRAM addr
1356+ F613              .csbsRow:
1357+ F613 C5               PUSH BC
1358+ F614 E5               PUSH HL                                 ; save inicio fila VRAM
1359+ F615                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1360+ F615 DD 7E 00         LD A, (IX+0)
1361+ F618 2F               CPL
1362+ F619 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1363+ F61A DD 7E 01         LD A, (IX+1)
1364+ F61D 2F               CPL
1365+ F61E 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1366+ F61F                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1367+ F61F 3A 43 F6         LD A, (.csbsJitter)
1368+ F622 B7               OR A
1369+ F623 28 0D            JR Z, .csbsWrite                        ; sin shift
1370+ F625 FA 2E F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1371+ F628                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1372+ F628 CB 3A            SRL D
1373+ F62A CB 1B            RR E
1374+ F62C 18 04            JR .csbsWrite
1375+ F62E              .csbsLeft:
1376+ F62E CB 23            SLA E
1377+ F630 CB 12            RL D
1378+ F632              .csbsWrite:
1379+ F632 7A               LD A, D
1380+ F633 77               LD (HL), A
1381+ F634 23               INC HL
1382+ F635 7B               LD A, E
1383+ F636 77               LD (HL), A
1384+ F637 E1               POP HL
1385+ F638 CD AD 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1386+ F63B DD 23            INC IX
1387+ F63D DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1388+ F63F C1               POP BC
1389+ F640 10 D1            DJNZ .csbsRow
1390+ F642 C9               RET
1391+ F643 00           .csbsJitter: DEFB 0
1392+ F644
1393+ F644              ; ==============================================================================
1394+ F644              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1395+ F644              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1396+ F644              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1397+ F644              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1398+ F644              ; Destruye: AF, BC, HL.
1399+ F644              ; ==============================================================================
1400+ F644              ChurchCutsceneEraseStatueDirect:
1401+ F644 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1402+ F647 57               LD D, A
1403+ F648 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1404+ F64B 5F               LD E, A
1405+ F64C CD 41 A1         CALL CalcPixelAddr
1406+ F64F 06 18            LD B, 24                                ; statues son 24 px de alto
1407+ F651              .csedRow:
1408+ F651 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1409+ F652 77               LD (HL), A
1410+ F653 23               INC HL
1411+ F654 77               LD (HL), A
1412+ F655 2B               DEC HL                                  ; volver a inicio fila
1413+ F656 C5               PUSH BC
1414+ F657 CD AD 9E         CALL NextPixelLine
1415+ F65A C1               POP BC
1416+ F65B 10 F4            DJNZ .csedRow
1417+ F65D C9               RET
1418+ F65E
1419+ F65E              ; ==============================================================================
1420+ F65E              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1421+ F65E              ; ==============================================================================
1422+ F65E              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1423+ F65E              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1424+ F65E              ; suficiente para corromper visualmente).
1425+ F65E              ; IN: IX = entity ptr.
1426+ F65E              ; ==============================================================================
1427+ F65E              RedrawTrappedMonster:
1428+ F65E                  ; --- Erase viejo en (OLDX, OLDY) ---
1429+ F65E CD C1 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1430+ F661 DD 7E 0D         LD A, (IX+ENT_OLDY)
1431+ F664 57               LD D, A
1432+ F665 DD 7E 0C         LD A, (IX+ENT_OLDX)
1433+ F668 5F               LD E, A
1434+ F669 DD E5            PUSH IX
1435+ F66B DD 2A 49 A8      LD IX, (OldSprAddr)
1436+ F66F CD CE 9D         CALL DrawSprite
1437+ F672 DD E1            POP IX
1438+ F674                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1439+ F674                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1440+ F674 DD 56 0D         LD D, (IX+ENT_OLDY)
1441+ F677 DD 5E 0C         LD E, (IX+ENT_OLDX)
1442+ F67A CD 9A D5         CALL RestoreOldAttr
1443+ F67D                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1444+ F67D                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1445+ F67D                  ; reponer attrs de pickups que el flujo de entidades pisa con
1446+ F67D                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1447+ F67D                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1448+ F67D                  ; estar bajo el monster.
1449+ F67D DD E5            PUSH IX
1450+ F67F CD 09 DC         CALL RefreshPickupAttrs
1451+ F682 DD E1            POP IX
1452+ F684                  ; --- Compute new draw pos ---
1453+ F684 CD 4B A8         CALL CalcDrawX
1454+ F687 CD C2 A2         CALL ComputeEnemyDrawY
1455+ F68A                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1456+ F68A CD 90 A8         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1457+ F68D 3A 65 82         LD A, (EnemyDrawY)
1458+ F690 57               LD D, A
1459+ F691 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1460+ F694 5F               LD E, A
1461+ F695 DD E5            PUSH IX
1462+ F697 DD 2A BF A8      LD IX, (SpriteAddrTemp)
1463+ F69B CD EB 9E         CALL CalcEntityAttrSize
1464+ F69E DD E1            POP IX
1465+ F6A0 3A 65 82         LD A, (EnemyDrawY)
1466+ F6A3 57               LD D, A
1467+ F6A4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1468+ F6A7 5F               LD E, A
1469+ F6A8 DD 7E 05         LD A, (IX+ENT_ATTR)
1470+ F6AB CD BE 9E         CALL SetEntityAttr
1471+ F6AE                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1472+ F6AE 3A 65 82         LD A, (EnemyDrawY)
1473+ F6B1 57               LD D, A
1474+ F6B2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1475+ F6B5 5F               LD E, A
1476+ F6B6 DD E5            PUSH IX
1477+ F6B8 DD 2A BF A8      LD IX, (SpriteAddrTemp)
1478+ F6BC CD CE 9D         CALL DrawSprite
1479+ F6BF DD E1            POP IX
1480+ F6C1                  ; --- Save OLD = current ---
1481+ F6C1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1482+ F6C4 DD 77 0C         LD (IX+ENT_OLDX), A
1483+ F6C7 3A 65 82         LD A, (EnemyDrawY)
1484+ F6CA DD 77 0D         LD (IX+ENT_OLDY), A
1485+ F6CD DD 7E 00         LD A, (IX+ENT_SPRITEID)
1486+ F6D0 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1487+ F6D3 C9               RET
