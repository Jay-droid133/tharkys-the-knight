 374+ 9F27              _SaveEntityAttrImpl:
 375+ 9F27                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9F27 DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9F2A 47               LD B, A
 378+ 9F2B 7B               LD A, E                     ; X pixel (raw)
 379+ 9F2C E6 07            AND 7
 380+ 9F2E 28 01            JR Z, .noExtraW
