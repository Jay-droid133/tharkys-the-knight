6909+ C57F DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6910+ C582 3A 9E 81         LD A, (EntityTable + ENT_POSX)
6911+ C585 DD 96 03         SUB (IX+ENT_POSX)
6912+ C588 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6913+ C58A 3E 04            LD A, DEATH_GHOST_SPEED
6914+ C58C 30 02            JR NC, .udgXSet
6915+ C58E 3E FC            LD A, -DEATH_GHOST_SPEED
6916+ C590              .udgXSet:
6917+ C590 DD 77 06         LD (IX+ENT_DELTAX), A
6918+ C593 DD 86 03         ADD A, (IX+ENT_POSX)
6919+ C596 DD 77 03         LD (IX+ENT_POSX), A
6920+ C599 18 1B            JR .udgAnim
6921+ C59B
6922+ C59B                  ; --- Eje Y primario ---
6923+ C59B              .udgVertPrim:
6924+ C59B AF               XOR A
6925+ C59C DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6926+ C59F 3A 9F 81         LD A, (EntityTable + ENT_POSY)
6927+ C5A2 DD 96 04         SUB (IX+ENT_POSY)
6928+ C5A5 28 0F            JR Z, .udgAnim
6929+ C5A7 3E 04            LD A, DEATH_GHOST_SPEED
6930+ C5A9 30 02            JR NC, .udgYSet
6931+ C5AB 3E FC            LD A, -DEATH_GHOST_SPEED
6932+ C5AD              .udgYSet:
6933+ C5AD DD 77 07         LD (IX+ENT_DELTAY), A
6934+ C5B0 DD 86 04         ADD A, (IX+ENT_POSY)
6935+ C5B3 DD 77 04         LD (IX+ENT_POSY), A
6936+ C5B6              .udgAnim:
6937+ C5B6                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6938+ C5B6                  ; ser despawneada por una de tres condiciones externas:
6939+ C5B6                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6940+ C5B6                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6941+ C5B6                  ;   3. Player cambia de pantalla (screen_system reset)
6942+ C5B6                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6943+ C5B6                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6944+ C5B6                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6945+ C5B6 C3 B9 C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6946+ C5B9
6947+ C5B9              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6948+ C5B9              ; Llamada por:
6949+ C5B9              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6950+ C5B9              ;   - UpdateDeath en frame skip (sin movimiento).
6951+ C5B9              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6952+ C5B9              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6953+ C5B9              DeathAnimate:
6954+ C5B9 DD 7E 06         LD A, (IX+ENT_DELTAX)
6955+ C5BC B7               OR A
6956+ C5BD 28 0A            JR Z, .daKeepDir
6957+ C5BF 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6958+ C5C1 CB 7F            BIT 7, A
6959+ C5C3 28 0D            JR Z, .daDir
6960+ C5C5 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6961+ C5C7 18 09            JR .daDir
6962+ C5C9              .daKeepDir:
6963+ C5C9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6964+ C5CC DD 96 08         SUB (IX+ENT_ANIMBASE)
6965+ C5CF E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6966+ C5D1 4F               LD C, A
6967+ C5D2              .daDir:
6968+ C5D2 DD 35 09         DEC (IX+ENT_ANIMTIMER)
6969+ C5D5 20 16            JR NZ, .daFrameSet
6970+ C5D7 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6971+ C5DB DD 7E 00         LD A, (IX+ENT_SPRITEID)
6972+ C5DE 47               LD B, A
6973+ C5DF DD 96 08         SUB (IX+ENT_ANIMBASE)
6974+ C5E2 E6 01            AND 1
6975+ C5E4 20 03            JR NZ, .daFrameDec
6976+ C5E6 04               INC B
6977+ C5E7 18 01            JR .daFrameStore
6978+ C5E9              .daFrameDec:
6979+ C5E9 05               DEC B
6980+ C5EA              .daFrameStore:
6981+ C5EA DD 70 00         LD (IX+ENT_SPRITEID), B
6982+ C5ED              .daFrameSet:
6983+ C5ED DD 7E 00         LD A, (IX+ENT_SPRITEID)
6984+ C5F0 DD 96 08         SUB (IX+ENT_ANIMBASE)
6985+ C5F3 E6 01            AND 1
6986+ C5F5 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6987+ C5F8 81               ADD A, C
6988+ C5F9 DD 77 00         LD (IX+ENT_SPRITEID), A
6989+ C5FC C9               RET
