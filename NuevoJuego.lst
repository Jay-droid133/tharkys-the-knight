 329+ 72A5 11 E9 73         LD DE, RoomExitsTable
 330+ 72A8 19               ADD HL, DE
 331+ 72A9 7E               LD A, (HL)                           ; A = exits bitmap
 332+ 72AA 32 E6 73         LD (.cmcpExits), A
