 103+ 7BA5              ; --- Estado del divisor (1 byte) ---
 104+ 7BA5 00           MusicIrqDivisor: DEFB 0
 105+ 7BA6
 106+ 7BA6              ; ==============================================================================
 107+ 7BA6              ; MUSIC DRIVER STATE + TABLES + TICK (movido de bank 4 a slot 1)
 108+ 7BA6              ; ==============================================================================
 109+ 7BA6              ; Vive aqui porque el IRQ handler debe acceder a este codigo/datos sin paginar
 110+ 7BA6              ; (paginar slot 3 dentro del IRQ rompe los PUSH/POP del propio handler — ver
 111+ 7BA6              ; project_ay_thunk_stack_bug.md). Slot 1 = $6000-$7FFF siempre visible, asi
 112+ 7BA6              ; que tanto el handler IRQ como StartMusicImpl (en bank 4) llegan aqui sin
 113+ 7BA6              ; problemas: bank 4 paga slot 3, slot 1 sigue intacto.
 114+ 7BA6              ;
 115+ 7BA6              ; Tracks (mismo dispatcher que antes, vive en bank 4 / ay_sound.asm):
 116+ 7BA6              ;   0    = Tension     (TensionMusicTable)
 117+ 7BA6              ;   1    = Sunrise     (SunriseMusicTable)
 118+ 7BA6              ;   2    = EndGame     (EndGameMusicTable)  LOOPABLE
 119+ 7BA6              ;   3    = GameOver    (GameOverMusicTable)
 120+ 7BA6              ;   4    = Death       (DeathMusicTable)    LOOPABLE
 121+ 7BA6              ;   $FF  = STOP, $FE = restart, $FD = stop-if-loopable
 122+ 7BA6              ; ==============================================================================
 123+ 7BA6
 124+ 7BA6              ; --- State (13 B) ---
 125+ 7BA6              ; Driver poly: tracks in-game (Tension/Sunrise/Death) usan poly2 (canales A+C,
 126+ 7BA6              ; B reservado a SFX). Tracks game-end (EndGame/GameOver) usan poly3 (A+B+C, sin
 127+ 7BA6              ; SFX en escena). El modo se setea en StartMusicImpl segun track id; dicta el
 128+ 7BA6              ; stride de tabla (5 vs 7 B/nota) y qué canales re-armar cada frame.
 129+ 7BA6 00 00        MusicPtr:           DEFW 0      ; Ptr a la nota actual en la tabla activa
 130+ 7BA8 00           MusicTimer:         DEFB 0      ; Frames restantes en la nota actual (0 = inactivo)
 131+ 7BA9 00 00        MusicTableStart:    DEFW 0      ; Ptr al inicio de la tabla activa (para loop)
 132+ 7BAB 00           MusicLoop:          DEFB 0      ; 1 = al terminator reiniciar; 0 = mute y parar
 133+ 7BAC 00           MusicMode:          DEFB 0      ; 2 = poly2 (5 B/entry, A+C), 3 = poly3 (7 B/entry, A+B+C)
 134+ 7BAD 00 00        MusicPeriodA:       DEFW 0      ; Period activo canal A (0 = mute A en re-arm)
 135+ 7BAF 00 00        MusicPeriodB:       DEFW 0      ; Period activo canal B (solo poly3; 0 = mute)
 136+ 7BB1 00 00        MusicPeriodC:       DEFW 0      ; Period activo canal C (0 = mute C en re-arm)
 137+ 7BB3
 138+ 7BB3              ; ==============================================================================
 139+ 7BB3              ; TRACK TABLES (polifonicas)
 140+ 7BB3              ; ==============================================================================
 141+ 7BB3              ; Period AY = 1750000 / (16 * frequency). Duraciones en frames a 25fps (1f=40ms).
 142+ 7BB3              ;
 143+ 7BB3              ; Formato Poly2 (5 B/entry): periodA(2) + periodC(2) + duration(1)
 144+ 7BB3              ;   Tracks 0/1/4 (Tension/Sunrise/Death). Canal B libre para SFX.
 145+ 7BB3              ; Formato Poly3 (7 B/entry): periodA(2) + periodB(2) + periodC(2) + duration(1)
 146+ 7BB3              ;   Tracks 2/3 (EndGame/GameOver). Sin SFX en escena → 3 voces simultaneas.
 147+ 7BB3              ;
 148+ 7BB3              ; period=$0000 en un canal = ese canal en silencio durante la nota (vol mute).
 149+ 7BB3              ; Terminator: entry completa con todo a 0 (5 B en poly2, 7 B en poly3).
 150+ 7BB3              ;
 151+ 7BB3              ; Por ahora todas las melodias siguen monofonicas (voz original en A, B/C en
 152+ 7BB3              ; silencio) hasta que el converter genere las versiones polifonicas reales.
 153+ 7BB3              ; ==============================================================================
 154+ 7BB3
