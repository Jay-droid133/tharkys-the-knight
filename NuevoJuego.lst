  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD EC 69         CALL InitPaging
  34  6007 CD 5A 9C         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 CA 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 A9 02         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  62  602B 3E FF            LD A, $FF
  63  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  64  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  65  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  66  6036
  67  6036                  ; Inicializar sistema de pantallas
  68  6036 CD C8 CC         CALL InitGameState      ; Reset variables de gameplay (idempotente)
  69  6039 CD EF CF         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  70  603C CD 3B A2         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  71  603F CD FC E4         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  72  6042 CD 72 C0         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  73  6045 CD 0F F1         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  74  6048                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  75  6048
  76  6048 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  77  604A FB               EI                      ; Habilitar interrupciones
  78  604B 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  79  604D 32 35 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
  80  6050 C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
  81  6053
  82  6053                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
  83  6053                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
  84  6053                  ; contention pero solo durante la cinematica final, una vez por partida —
  85  6053                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
  86  6053                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
  87  6053                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
  88  6053                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
  89  6053                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
  90  6053                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 6053              ; ==============================================================================
   2+ 6053              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6053              ; ==============================================================================
   4+ 6053              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6053              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6053              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6053              ;
   8+ 6053              ; Esquema de fases:
   9+ 6053              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6053              ;   2 ARM_IN       arm aparece, pausa
  11+ 6053              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6053              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6053              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6053              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6053              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6053              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6053              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6053              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6053              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6053              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6053              ;  13 END_HOLD     "The End" sprite hold
  22+ 6053              ;  14 BLACK        wipe a negro + hold
  23+ 6053              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6053              ;
  25+ 6053              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6053              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6053              ; ==============================================================================
  28+ 6053
  29+ 6053              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6053              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6053              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6053              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6053              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6053              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6053              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6053              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6053              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 6053              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 6053              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 6053
  41+ 6053              ; --- Posiciones (pixel) ---
  42+ 6053              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 6053              TGCS_ANCHOR1_Y         EQU 80
  44+ 6053              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 6053              TGCS_END_CHARY         EQU 4
  46+ 6053              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 6053
  48+ 6053              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 6053              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 6053              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 6053              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 6053              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 6053              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 6053              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 6053              TGCS_ARM_PX_X          EQU 136
  56+ 6053              TGCS_ARM_PX_Y          EQU 64
  57+ 6053              TGCS_FINGER_PX_X       EQU 136
  58+ 6053              TGCS_FINGER_PX_Y       EQU 56
  59+ 6053
  60+ 6053              ; --- Phase enum ---
  61+ 6053              TGP_IDLE               EQU 0
  62+ 6053              TGP_LOCK               EQU 1
  63+ 6053              TGP_ARM_IN             EQU 2
  64+ 6053              TGP_FINGER_IN          EQU 3
  65+ 6053              TGP_SHAKE              EQU 4
  66+ 6053              TGP_FINGER_PULSE       EQU 5
  67+ 6053              TGP_FINGER_OUT         EQU 6
  68+ 6053              TGP_ARM_HOLD           EQU 7
  69+ 6053              TGP_ARM_OUT            EQU 8
  70+ 6053              TGP_PLAYER_TURN        EQU 9
  71+ 6053              TGP_PLAYER_HIDE        EQU 10
  72+ 6053              TGP_PLAYER_FRAMED      EQU 11
  73+ 6053              TGP_PLAYER_EXIT        EQU 12
  74+ 6053              TGP_END_HOLD           EQU 13
  75+ 6053              TGP_BLACK              EQU 14
  76+ 6053              TGP_CREDITS            EQU 15
  77+ 6053              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ 6053              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ 6053
  80+ 6053              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ 6053                                                ; check dinamico de "todos los nasties dead".
  82+ 6053                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ 6053                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ 6053                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ 6053
  86+ 6053              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ 6053              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ 6053              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ 6053              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ 6053
  91+ 6053              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ 6053              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ 6053              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ 6053              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ 6053              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ 6053              ;
  97+ 6053              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ 6053              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ 6053              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ 6053              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ 6053              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ 6053              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ 6053              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 104+ 6053
 105+ 6053              ; --- Posicion de la puerta (closed v2 + open) en char ---
 106+ 6053              ; El closed v2 (id 246) vive en PickupTable a (14, 17). El open (id 250)
 107+ 6053              ; comparte posicion y tamano (4x5 chars). Cuando el cutscene erase el closed,
 108+ 6053              ; dibuja el open in-place via DrawBgGfxSprite.
 109+ 6053              TGCS_DOOR_CHARX        EQU 14
 110+ 6053              TGCS_DOOR_CHARY        EQU 17
 111+ 6053              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
 112+ 6053              TGCS_ARCH_ROOM_X       EQU 7
 113+ 6053              TGCS_ARCH_ROOM_Y       EQU 15
 114+ 6053              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
 115+ 6053
 116+ 6053              ; ==============================================================================
 117+ 6053              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ 6053              ; ==============================================================================
 119+ 6053              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ 6053              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ 6053              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ 6053              ;
 123+ 6053              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ 6053              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ 6053              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ 6053              ; Destruye: AF, BC, DE, HL, IX.
 127+ 6053              ; ==============================================================================
 128+ 6053              CheckTownGateTriggerBg:
 129+ 6053 3A 5E 82         LD A, (TownGatePhase)
 130+ 6056 B7               OR A
 131+ 6057 C0               RET NZ                              ; ya en cutscene
 132+ 6058 3A 49 82         LD A, (CurrentKey)
 133+ 605B FE 06            CP TGCS_ARCH_KEY_ID
 134+ 605D C0               RET NZ                              ; sin la key correcta
 135+ 605E 3A 8F 82         LD A, (CurrentScreenX)
 136+ 6061 FE 07            CP TGCS_ARCH_ROOM_X
 137+ 6063 C0               RET NZ
 138+ 6064 3A 90 82         LD A, (CurrentScreenY)
 139+ 6067 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ 6069 C0               RET NZ
 141+ 606A                  ; --- Horizontal AABB ---
 142+ 606A 3A 39 81         LD A, (EntityTable + ENT_POSX)
 143+ 606D 4F               LD C, A                             ; C = player_left
 144+ 606E C6 10            ADD A, 16
 145+ 6070 57               LD D, A                             ; D = player_right
 146+ 6071 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ 6073 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ 6075 30 01            JR NC, .ctgtNoUnderL
 149+ 6077 AF               XOR A
 150+ 6078              .ctgtNoUnderL:
 151+ 6078 BA               CP D
 152+ 6079 D0               RET NC                              ; ext_left >= player_right
 153+ 607A 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ 607C C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ 607E 30 02            JR NC, .ctgtNoOverR
 156+ 6080 3E FF            LD A, $FF
 157+ 6082              .ctgtNoOverR:
 158+ 6082 B9               CP C
 159+ 6083 D8               RET C                               ; ext_right < player_left
 160+ 6084                  ; --- Vertical AABB ---
 161+ 6084                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ 6084                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ 6084                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ 6084                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ 6084                  ; con la altura real del rect.
 166+ 6084 3A 3A 81         LD A, (EntityTable + ENT_POSY)
 167+ 6087 4F               LD C, A                             ; C = player_top
 168+ 6088 C6 15            ADD A, 21
 169+ 608A 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ 608B 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ 608D D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ 608F 30 01            JR NC, .ctgtNoUnderT
 173+ 6091 AF               XOR A
 174+ 6092              .ctgtNoUnderT:
 175+ 6092 BA               CP D
 176+ 6093 D0               RET NC
 177+ 6094 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ 6096 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ 6098 30 02            JR NC, .ctgtNoOverB
 180+ 609A 3E FF            LD A, $FF
 181+ 609C              .ctgtNoOverB:
 182+ 609C B9               CP C
 183+ 609D D8               RET C
 184+ 609E                  ; HIT
 185+ 609E CD A6 60         CALL StartTownGateCutscene
 186+ 60A1 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ 60A3 C3 8D F0         JP CheckMilestoneTrigger            ; tail call
 188+ 60A6
 189+ 60A6              ; ==============================================================================
 190+ 60A6              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 60A6              ; ==============================================================================
 192+ 60A6              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 60A6              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 60A6              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 60A6              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 60A6              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 60A6              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 60A6              ; Destruye: AF, BC, DE, HL, IX.
 199+ 60A6              ; ==============================================================================
 200+ 60A6              StartTownGateCutscene:
 201+ 60A6 AF               XOR A
 202+ 60A7 32 49 82         LD (CurrentKey), A
 203+ 60AA CD 8D 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 60AD CD AF BD         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 60B0 CD C1 60         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 60B3 CD 0F 66         CALL SFX_TownGate_OnStart
 207+ 60B6 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 60B8 32 5E 82         LD (TownGatePhase), A
 209+ 60BB 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ 60BD 32 A5 5F         LD (TownGateTimer), A
 211+ 60C0 C9               RET
 212+ 60C1
 213+ 60C1              ; ==============================================================================
 214+ 60C1              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
 215+ 60C1              ; ==============================================================================
 216+ 60C1              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING
 217+ 60C1              ; con SPRID_PUFF. ProcessDeath → ProcessOneEnemy.peDying anima puff cada
 218+ 60C1              ; frame en WAIT_NASTIES (igual que nasties). Al terminar puff,
 219+ 60C1              ; UpdateDying pone TYPE_NONE y la check dinamica de WAIT_NASTIES sigue.
 220+ 60C1              ; (DeathSpawned se queda a 1 pero es inocuo: ProcessDeath ya retorna
 221+ 60C1              ; cuando ENT_TYPE=0, y no hay respawn durante cutscene.)
 222+ 60C1              ; ==============================================================================
 223+ 60C1              KillDeathIfActive:
 224+ 60C1 DD 21 E6 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
 225+ 60C5 DD 7E 01         LD A, (IX+ENT_TYPE)
 226+ 60C8 B7               OR A
 227+ 60C9 C8               RET Z                               ; muerte ya inactiva
 228+ 60CA DD 7E 02         LD A, (IX+ENT_STATE)
 229+ 60CD FE 03            CP STATE_DYING
 230+ 60CF C8               RET Z                               ; ya muriendo
 231+ 60D0 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
 232+ 60D4 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
 233+ 60D8 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
 234+ 60DC DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
 235+ 60E0 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 236+ 60E4 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 237+ 60E8 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
 238+ 60EC C9               RET
