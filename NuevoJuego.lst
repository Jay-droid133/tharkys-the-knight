# file opened: minimap.asm
   1+ FBEA              ; ==============================================================================
   2+ FBEA              ; MINIMAP - Overlay de mapa 16x16 (tecla I)
   3+ FBEA              ; Bank 0
   4+ FBEA              ; ==============================================================================
   5+ FBEA              ; Dibuja un sprite 8x8 por sala en la capa de pixeles + attrs.
   6+ FBEA              ; Las conexiones reales (gaps walkables) se leen de MinimapConnTable (bank 0,
   7+ FBEA              ; generada por tools/build_screen_gaps.py).
   8+ FBEA              ;
   9+ FBEA              ;   Sala valida:  borde azul oscuro, lados abiertos segun conexiones reales
  10+ FBEA              ;                   attr: $01 (paper=0 ink=1 no-bright)
  11+ FBEA              ;   Jugador:      bloque solido amarillo brillante
  12+ FBEA              ;                   attr: $76 (bright paper=6 ink=6)
  13+ FBEA              ;   Objetivo:     bloque solido cyan brillante
  14+ FBEA              ;                   attr: $6D (bright paper=5 ink=5)
  15+ FBEA              ;   Vacio:        negro (attr ya $00, pixeles irrelevantes con paper=ink=0)
  16+ FBEA              ;
  17+ FBEA              ; Patron de sala (bit 3=N bit 2=S bit 1=W bit 0=E en flags, 1=abierto):
  18+ FBEA              ;   fila 0: $FF si N cerrado, $00 si N abierto
  19+ FBEA              ;   filas 1-6: bit7=1 si W cerrado, bit0=1 si E cerrado
  20+ FBEA              ;   fila 7: $FF si S cerrado, $00 si S abierto
  21+ FBEA              ;
  22+ FBEA              ; Tecla M: abrir. Tecla M otra vez: cerrar.
  23+ FBEA              ; ScreenDirty=1 al cerrar -> repintado completo en el siguiente frame.
  24+ FBEA              ;
  25+ FBEA              ; INC H avanza scanlines dentro de un char (siempre en el mismo third:
  26+ FBEA              ; $40xx/$48xx/$50xx). Las dir. de fila 0 vienen de mmRowTable (16 DEFW).
  27+ FBEA              ; ==============================================================================
  28+ FBEA
  29+ FBEA              MINIMAP_ATTR_BASE   EQU $5888   ; char(8,4): $5800 + 4*32 + 8
  30+ FBEA
  31+ FBEA              MM_EMPTY    EQU $00
  32+ FBEA              MM_ROOM     EQU $01     ; azul oscuro (paper=0 ink=1 no-bright)
  33+ FBEA              MM_PLAYER   EQU $76     ; amarillo brillante (paper=6 ink=6 bright)
  34+ FBEA              MM_GOAL     EQU $6D     ; cyan brillante    (paper=5 ink=5 bright)
  35+ FBEA
  36+ FBEA              ; ------------------------------------------------------------------------------
  37+ FBEA              ; CheckMinimapKey - llamar desde MainLoop cada frame
  38+ FBEA              ; Preserva todos los registros del caller.
  39+ FBEA              ; ------------------------------------------------------------------------------
  40+ FBEA              CheckMinimapKey:
  41+ FBEA F5               PUSH AF
  42+ FBEB C5               PUSH BC
  43+ FBEC 01 FE 7F         LD BC, $7FFE            ; fila SPACE-SS-M-N-B
  44+ FBEF ED 78            IN A, (C)
  45+ FBF1 CB 57            BIT 2, A                ; M = bit 2 (active low)
  46+ FBF3 28 03            JR Z, .pressed
  47+ FBF5 C1               POP BC
  48+ FBF6 F1               POP AF
  49+ FBF7 C9               RET
  50+ FBF8              .pressed:
  51+ FBF8              .waitRel:
  52+ FBF8 76               HALT
  53+ FBF9 ED 78            IN A, (C)
