 728+ E745              ; ==============================================================================
 729+ E745              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 730+ E745              ; ==============================================================================
 731+ E745              DrawTimeIndicator:
 732+ E745                  ; Calcular puntero al label de 2 chars
 733+ E745 3A EA E3         LD A, (CurrentTimeOfDay)
 734+ E748 87               ADD A, A                    ; A = momento * 2
 735+ E749 5F               LD E, A
 736+ E74A 16 00            LD D, 0
 737+ E74C 21 4C E8         LD HL, TimeLabels
 738+ E74F 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 739+ E750
 740+ E750                  ; Primer caracter en columna 30
 741+ E750 7E               LD A, (HL)
 742+ E751 E5               PUSH HL
 743+ E752 1E 1E            LD E, 30
 744+ E754 CD 68 E7         CALL DrawHudChar
 745+ E757 E1               POP HL
 746+ E758
 747+ E758                  ; Segundo caracter en columna 31
 748+ E758 23               INC HL
 749+ E759 7E               LD A, (HL)
 750+ E75A 1E 1F            LD E, 31
