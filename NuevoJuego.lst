4368+ B733              ; ==============================================================================
4369+ B733              ; CheckEnemyCollision - Colision enemigo contra fondo (2 puntos, simplificado)
4370+ B733              ; ==============================================================================
4371+ B733              ; IX = entidad. Salida: Z=libre, NZ=colision.
4372+ B733              ; ==============================================================================
4373+ B733              CheckEnemyCollision:
4374+ B733                  ; Testea TODAS las celdas del bbox del enemigo en CollisionMap
4375+ B733                  ; (no solo las 4 esquinas: podian dejar pasar obstaculos pequenyos
4376+ B733                  ; como el pozo o el bench cuando el enemigo cae desalineado).
4377+ B733 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4378+ B736 CD 55 A5         CALL GetSpriteDims              ; B=W_px, C=H_px
4379+ B739                  ; --- Char X range ---
4380+ B739 DD 7E 03         LD A, (IX+ENT_POSX)
4381+ B73C 57               LD D, A                         ; D = posX
4382+ B73D 0F               RRCA
4383+ B73E 0F               RRCA
4384+ B73F 0F               RRCA
4385+ B740 E6 1F            AND $1F
4386+ B742 32 B3 B7         LD (.ecXlo), A                  ; charXlo
4387+ B745 7A               LD A, D
4388+ B746 80               ADD A, B
4389+ B747 3D               DEC A                           ; posX + W - 1
4390+ B748 0F               RRCA
4391+ B749 0F               RRCA
4392+ B74A 0F               RRCA
4393+ B74B E6 1F            AND $1F
4394+ B74D 5F               LD E, A                         ; E = charXhi
4395+ B74E 3A B3 B7         LD A, (.ecXlo)
4396+ B751 57               LD D, A
4397+ B752 7B               LD A, E
4398+ B753 92               SUB D
4399+ B754 3C               INC A                           ; width_chars
4400+ B755 32 B5 B7         LD (.ecWc), A
4401+ B758                  ; --- Char Y range ---
4402+ B758 DD 7E 04         LD A, (IX+ENT_POSY)
4403+ B75B 47               LD B, A                         ; B = posY (salvar)
4404+ B75C 0F               RRCA
4405+ B75D 0F               RRCA
4406+ B75E 0F               RRCA
4407+ B75F E6 1F            AND $1F
4408+ B761 D6 02            SUB BG_Y_OFFSET
4409+ B763 32 B4 B7         LD (.ecYlo), A
4410+ B766 78               LD A, B
4411+ B767 81               ADD A, C
4412+ B768 3D               DEC A                           ; posY + H - 1
4413+ B769 0F               RRCA
4414+ B76A 0F               RRCA
4415+ B76B 0F               RRCA
4416+ B76C E6 1F            AND $1F
4417+ B76E D6 02            SUB BG_Y_OFFSET
4418+ B770 47               LD B, A                         ; B = charYhi
4419+ B771 3A B4 B7         LD A, (.ecYlo)
4420+ B774 ED 44            NEG
4421+ B776 80               ADD A, B
4422+ B777 3C               INC A                           ; height_chars
4423+ B778 32 B6 B7         LD (.ecHc), A
4424+ B77B                  ; --- HL = CollisionMap + charYlo*32 + charXlo ---
4425+ B77B 3A B4 B7         LD A, (.ecYlo)
4426+ B77E FE 16            CP 22
4427+ B780 30 2C            JR NC, .ecFree                  ; fuera de rango (underflow HUD o abajo)
4428+ B782 6F               LD L, A
4429+ B783 26 00            LD H, 0
4430+ B785 29               ADD HL, HL
4431+ B786 29               ADD HL, HL
4432+ B787 29               ADD HL, HL
4433+ B788 29               ADD HL, HL
4434+ B789 29               ADD HL, HL                      ; *32
4435+ B78A 3A B3 B7         LD A, (.ecXlo)
4436+ B78D 85               ADD A, L
4437+ B78E 6F               LD L, A
4438+ B78F 30 01            JR NC, .ecNoCarry
4439+ B791 24               INC H
4440+ B792              .ecNoCarry:
4441+ B792 11 3D 83         LD DE, CollisionMap
4442+ B795 19               ADD HL, DE
4443+ B796                  ; --- Loop filas x columnas ---
4444+ B796 3A B6 B7         LD A, (.ecHc)
