 237+ EB64                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EB64 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EB67 CB 86            RES 0, (HL)
 240+ EB69 C9               RET
 241+ EB6A
 242+ EB6A              .clkBlinkOff:
 243+ EB6A                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EB6A                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EB6A                  ; paper=black + ink=black.
 246+ EB6A AF               XOR A
 247+ EB6B 32 0F 58         LD ($580F), A
 248+ EB6E 32 2F 58         LD ($582F), A
 249+ EB71 32 10 58         LD ($5810), A
 250+ EB74 32 30 58         LD ($5830), A
 251+ EB77 C9               RET
