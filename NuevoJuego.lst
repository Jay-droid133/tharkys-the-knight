1612+ EFDE              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
1613+ EFDE              ; ==============================================================================
1614+ EFDE              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
1615+ EFDE              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
1616+ EFDE              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
1617+ EFDE              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
1618+ EFDE              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
1619+ EFDE              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
1620+ EFDE              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
1621+ EFDE              ; ==============================================================================
1622+ EFDE              StatueIdTable:
1623+ EFDE D5               DEFB 213        ; type idx 0: statue_zombi
1624+ EFDF E1               DEFB 225        ; type idx 1: statue_skeleton
1625+ EFE0 D3               DEFB 211        ; type idx 2: statue_ghost
