1004+ EEE8              .urpDoRoulette:
1005+ EEE8                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
1006+ EEE8                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
1007+ EEE8                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
1008+ EEE8                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
1009+ EEE8 3E 06            LD A, ROLLED_ROULETTE
1010+ EEEA 32 D5 5F         LD (RP_TmpRolled), A
1011+ EEED 3E 01            LD A, 1
1012+ EEEF 32 BC 5F         LD (RouletteActive), A
1013+ EEF2                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
1014+ EEF2 ED 5F            LD A, R
1015+ EEF4 06 06            LD B, ROULETTE_ORDER_LEN
1016+ EEF6              .urpRouletteModLoop:
1017+ EEF6 90               SUB B
1018+ EEF7 30 FD            JR NC, .urpRouletteModLoop
1019+ EEF9 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
1020+ EEFA CD 6A EB         CALL SkipCompassIfNeeded            ; si idx cae en COMPASS y lasting activo, avanza
1021+ EEFD 32 BD 5F         LD (RouletteIdx), A
1022+ EF00 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
1023+ EF01 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
1024+ EF03 32 BE 5F         LD (RouletteFrameCounter), A
1025+ EF06 78               LD A, B
1026+ EF07 CD D7 EA         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
1027+ EF0A              .urpActivate:
1028+ EF0A                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
1029+ EF0A CD 36 EB         CALL LoadSynthSpriteAndExtractAttr
1030+ EF0D 3A 10 83         LD A, (CurrentScreenX)
1031+ EF10 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
1032+ EF13 3A 11 83         LD A, (CurrentScreenY)
1033+ EF16 32 B5 5F         LD (RandomSynthMapY), A
1034+ EF19 3E FF            LD A, $FF
1035+ EF1B 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
1036+ EF1E 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
1037+ EF20                                                      ; ya están set por .urpDoXxx — no resetear)
1038+ EF20
1039+ EF20              ; ==============================================================================
1040+ EF20              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
1041+ EF20              ; ==============================================================================
1042+ EF20              ; prev ← cur (data de la sala que dejamos).
1043+ EF20              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
1044+ EF20              ;
1045+ EF20              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
1046+ EF20              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
1047+ EF20              ; ==============================================================================
1048+ EF20              .urpZeroAndRotate:
1049+ EF20 AF               XOR A
1050+ EF21 32 D4 5F         LD (RP_TmpSlot), A
1051+ EF24 32 D5 5F         LD (RP_TmpRolled), A
1052+ EF27              .urpRotateAndRet:
1053+ EF27                  ; prev ← cur
1054+ EF27 3A CE 5F         LD A, (RP_CurSid)
1054+ EF2A 32 D1 5F       LD (RP_PrevSid), A
1055+ EF2D 3A CF 5F         LD A, (RP_CurSlot)
1055+ EF30 32 D2 5F       LD (RP_PrevSlot), A
1056+ EF33 3A D0 5F         LD A, (RP_CurRolled)
1056+ EF36 32 D3 5F       LD (RP_PrevRolled), A
1057+ EF39 3A D6 5F         LD A, (RP_CurVariant)
1057+ EF3C 32 D7 5F       LD (RP_PrevVariant), A
1058+ EF3F                  ; cur ← (newSid, TmpSlot, TmpRolled, TmpVariant)
1059+ EF3F 3A 11 83         LD A, (CurrentScreenY)
1060+ EF42 07               RLCA
1060+ EF43 07             RLCA
1060+ EF44 07             RLCA
1060+ EF45 07             RLCA           ; Y*16
1061+ EF46 21 10 83         LD HL, CurrentScreenX
1062+ EF49 86               ADD A, (HL)                         ; A = newSid
1063+ EF4A 32 CE 5F         LD (RP_CurSid), A
1064+ EF4D 3A D4 5F         LD A, (RP_TmpSlot)
1064+ EF50 32 CF 5F       LD (RP_CurSlot), A
1065+ EF53 3A D5 5F         LD A, (RP_TmpRolled)
1065+ EF56 32 D0 5F       LD (RP_CurRolled), A
1066+ EF59 3A D8 5F         LD A, (RP_TmpVariant)
1066+ EF5C 32 D6 5F       LD (RP_CurVariant), A
1067+ EF5F C9               RET
1068+ EF60
1069+ EF60              ; ==============================================================================
1070+ EF60              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
1071+ EF60              ; ==============================================================================
1072+ EF60              ; Se llama desde:
1073+ EF60              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
1074+ EF60              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
1075+ EF60              ;     por encima y los borro.
1076+ EF60              ;
1077+ EF60              ; Bypass total del day/night remap → respeta exactamente el patrón per-celda
1078+ EF60              ; que el BG editor exporta (ej: col1 bright + col2 dim). Lee los 4 attrs
1079+ EF60              ; ya extraídos por LoadSynthSpriteAndExtractAttr (RandomSynthAttr=TL,
1080+ EF60              ; RandomSynthAttrTR, RandomSynthAttrBL, RandomSynthAttrBR) y los pinta
1081+ EF60              ; 1:1 en VRAM.
1082+ EF60              ;
1083+ EF60              ; Pickup es 16x16 = 2x2 char attrs.
1084+ EF60              ; Early-out si RandomSynthMapX = $FE (no activo).
1085+ EF60              ; Destruye AF, BC, DE, HL.
1086+ EF60              ; ==============================================================================
1087+ EF60              PaintSynthPickupAttrsBody:
1088+ EF60 3A B4 5F         LD A, (RandomSynthMapX)
1089+ EF63 FE FE            CP $FE
1090+ EF65 C8               RET Z                               ; no activo
1091+ EF66                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
1092+ EF66 3A B9 5F         LD A, (RandomSynthCharY)
1093+ EF69 C6 02            ADD A, BG_Y_OFFSET
1094+ EF6B 26 00            LD H, 0
1095+ EF6D 6F               LD L, A
1096+ EF6E 29               ADD HL, HL
1097+ EF6F 29               ADD HL, HL
1098+ EF70 29               ADD HL, HL
1099+ EF71 29               ADD HL, HL
1100+ EF72 29               ADD HL, HL                          ; *32
1101+ EF73 3A B8 5F         LD A, (RandomSynthCharX)
1102+ EF76 85               ADD A, L
1103+ EF77 6F               LD L, A
1104+ EF78 30 01            JR NC, .pspaNoCarry
1105+ EF7A 24               INC H
1106+ EF7B              .pspaNoCarry:
1107+ EF7B 11 00 58         LD DE, ATTR_BASE
1108+ EF7E 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
1109+ EF7F                  ; --- Fila 0: TL, TR ---
1110+ EF7F 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
1111+ EF82 77               LD (HL), A
1112+ EF83 23               INC HL
1113+ EF84 3A E1 5F         LD A, (RandomSynthAttrTR)
1114+ EF87 77               LD (HL), A
1115+ EF88                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
1116+ EF88 7D               LD A, L
1117+ EF89 C6 1F            ADD A, 31
1118+ EF8B 6F               LD L, A
1119+ EF8C 30 01            JR NC, .pspaNoCarry2
1120+ EF8E 24               INC H
1121+ EF8F              .pspaNoCarry2:
1122+ EF8F                  ; --- Fila 1: BL, BR ---
1123+ EF8F 3A E2 5F         LD A, (RandomSynthAttrBL)
1124+ EF92 77               LD (HL), A
1125+ EF93 23               INC HL
1126+ EF94 3A E3 5F         LD A, (RandomSynthAttrBR)
1127+ EF97 77               LD (HL), A
1128+ EF98 C9               RET
1129+ EF99
1130+ EF99              ; ==============================================================================
1131+ EF99              ; CheckRandomSyntheticPickup - colision + collect del pickup sintetico
1132+ EF99              ; ==============================================================================
1133+ EF99              ; Llamada por CheckPickupCollect tras procesar PickupTable. Si la entry
1134+ EF99              ; sintetica esta activa, hace AABB contra el player. Si hay hit:
1135+ EF99              ;   - SFX_Pickup
1136+ EF99              ;   - Erase XOR + restore attrs
1137+ EF99              ;   - Mark inactiva ($FE)
1138+ EF99              ;   - Dispatch GiveLife/GiveHealth/GiveStamina segun RandomSynthPtr
1139+ EF99              ; ==============================================================================
1140+ EF99              CheckRandomSyntheticPickupBody:
1141+ EF99 3A B4 5F         LD A, (RandomSynthMapX)
1142+ EF9C FE FE            CP $FE
1143+ EF9E C8               RET Z                               ; inactiva
1144+ EF9F                  ; Sanity: solo procesar si estamos en su sala (deberia ser asi tras hook).
1145+ EF9F 47               LD B, A
1146+ EFA0 3A 10 83         LD A, (CurrentScreenX)
1147+ EFA3 B8               CP B
1148+ EFA4 C0               RET NZ
1149+ EFA5 3A B5 5F         LD A, (RandomSynthMapY)
1150+ EFA8 47               LD B, A
1151+ EFA9 3A 11 83         LD A, (CurrentScreenY)
1152+ EFAC B8               CP B
1153+ EFAD C0               RET NZ
1154+ EFAE
1155+ EFAE                  ; --- Cargar sprite a BgSpriteBuffer (header + pixels + attrs) ---
1156+ EFAE 2A B6 5F         LD HL, (RandomSynthPtr)
1157+ EFB1 3E 03            LD A, 3                             ; bank 3
1158+ EFB3 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
1159+ EFB6
1160+ EFB6                  ; --- Calcular pk_left, pk_top, pk_width_px, pk_height_px ---
1161+ EFB6 21 FD 86         LD HL, BgSpriteBuffer
1162+ EFB9 7E               LD A, (HL)                          ; height_px
1163+ EFBA 32 03 F0         LD (.crsPkH+1), A
1164+ EFBD 23               INC HL
1165+ EFBE 7E               LD A, (HL)
1166+ EFBF E6 7F            AND $7F                             ; width_bytes (sin flag RLE)
1167+ EFC1 87               ADD A, A
1168+ EFC2 87               ADD A, A
1169+ EFC3 87               ADD A, A                            ; width_px = bytes*8
1170+ EFC4 32 EB EF         LD (.crsPkW+1), A
1171+ EFC7 3A B8 5F         LD A, (RandomSynthCharX)
1172+ EFCA 87               ADD A, A
1173+ EFCB 87               ADD A, A
1174+ EFCC 87               ADD A, A                            ; pk_left = charX*8
1175+ EFCD 32 E6 EF         LD (.crsPkLeft+1), A
1176+ EFD0 3A B9 5F         LD A, (RandomSynthCharY)
1177+ EFD3 C6 02            ADD A, BG_Y_OFFSET
1178+ EFD5 87               ADD A, A
1179+ EFD6 87               ADD A, A
1180+ EFD7 87               ADD A, A                            ; pk_top = (charY+BG_Y_OFFSET)*8
1181+ EFD8 32 FE EF         LD (.crsPkTop+1), A
1182+ EFDB
1183+ EFDB                  ; --- AABB: player_right > pk_left AND player_left < pk_right
1184+ EFDB                  ;          AND player_bottom > pk_top AND player_top < pk_bottom ---
1185+ EFDB 3A A6 81         LD A, (EntityTable + ENT_POSX)
1186+ EFDE 32 E2 EF         LD (.crsPlX+1), A
1187+ EFE1              .crsPlX:
1188+ EFE1 3E 00            LD A, 0                             ; player_left (self-mod)
1189+ EFE3 C6 10            ADD A, 16                           ; player_right
1190+ EFE5              .crsPkLeft:
1191+ EFE5 06 00            LD B, 0
1192+ EFE7 B8               CP B
1193+ EFE8 D8               RET C                               ; player_right <= pk_left -> miss
1194+ EFE9 C8               RET Z
1195+ EFEA              .crsPkW:
1196+ EFEA 3E 00            LD A, 0                             ; pk_width
1197+ EFEC 80               ADD A, B                            ; pk_right
1198+ EFED 47               LD B, A
1199+ EFEE 3A E2 EF         LD A, (.crsPlX+1)
1200+ EFF1 B8               CP B
1201+ EFF2 D0               RET NC                              ; player_left >= pk_right -> miss
1202+ EFF3
1203+ EFF3 3A A7 81         LD A, (EntityTable + ENT_POSY)
1204+ EFF6 32 FA EF         LD (.crsPlY+1), A
1205+ EFF9              .crsPlY:
1206+ EFF9 3E 00            LD A, 0                             ; player_top
1207+ EFFB C6 15            ADD A, 21                           ; player_bottom (player es 21 alto)
1208+ EFFD              .crsPkTop:
1209+ EFFD 06 00            LD B, 0
1210+ EFFF B8               CP B
1211+ F000 D8               RET C
1212+ F001 C8               RET Z
1213+ F002              .crsPkH:
1214+ F002 3E 00            LD A, 0                             ; pk_height
1215+ F004 80               ADD A, B                            ; pk_bottom
1216+ F005 47               LD B, A
1217+ F006 3A FA EF         LD A, (.crsPlY+1)
1218+ F009 B8               CP B
1219+ F00A D0               RET NC                              ; miss
1220+ F00B
1221+ F00B                  ; --- HIT detectado, pero saltar si player ya esta al maximo del recurso ---
1222+ F00B                  ; Identificar tipo via RP_CurRolled (semantico, no por ptr) y comparar
1223+ F00B                  ; contra cap. Si A >= cap, RET (sin SFX ni erase): el pickup queda
1224+ F00B                  ; visible para cuando el jugador haya gastado el recurso.
1225+ F00B                  ; Rayo/caracol/mushroom/compass no son cap-able: siempre aplican.
1226+ F00B                  ;
1227+ F00B                  ; Antes esto se hacia comparando RandomSynthPtr contra BgGfx_health_pickup
1228+ F00B                  ; / BgGfx_stamina_pickup. Ahora hay variantes (ids 72/74/254 health,
1229+ F00B                  ; 73/255 stamina) elegidas al azar por .urpDoHealth/.urpDoStamina; el
1230+ F00B                  ; ptr varia pero RP_CurRolled mantiene la semantica.
1231+ F00B 3A D0 5F         LD A, (RP_CurRolled)
1232+ F00E FE 01            CP ROLLED_LIFE
1233+ F010 28 0A            JR Z, .crsCheckLife
1234+ F012 FE 02            CP ROLLED_HEALTH
1235+ F014 28 0E            JR Z, .crsCheckHealth
1236+ F016 FE 03            CP ROLLED_STAMINA
1237+ F018 28 12            JR Z, .crsCheckStamina
1238+ F01A 18 16            JR .crsApplyHit                     ; rayo/caracol/mushroom/compass: siempre apply
1239+ F01C              .crsCheckLife:
1240+ F01C 3A E6 82         LD A, (PlayerLives)
1241+ F01F FE 05            CP PLAYER_LIVES_MAX
1242+ F021 D0               RET NC
