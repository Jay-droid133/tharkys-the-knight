2130+ DA70              ; BumpTriggerTable - sprites que disparan acción al "chocar" (no por overlap).
2131+ DA70              ; ==============================================================================
2132+ DA70              ; Cada entry: ptr (DEFW), required_key (DEFB), action_id (DEFB). 4 bytes.
2133+ DA70              ; Terminada en DEFW 0.
2134+ DA70              ;
2135+ DA70              ; Action_ids:
2136+ DA70              ;   1 = TownHall: ChurchKeySpawned = 1, CurrentKey = 0.
2137+ DA70              ;   2 = ChurchDoor: ChurchDoorOpen = 1, CurrentKey = 0, reescribe ptr de la
2138+ DA70              ;       entry a BgGfx_old_church_door_open + rebuild CollisionMap.
2139+ DA70              ;
2140+ DA70              ; El sprite tiene que estar también en WallAlwaysTable para que sea sólido.
2141+ DA70              ;
2142+ DA70              ; NOTA: el cutscene final (action 3 = TownGate) se dispara aparte, en
2143+ DA70              ; CheckTownGateTriggerBg (town_gate_cutscene.asm). El arco es BG sprite y
2144+ DA70              ; no esta en PickupTable, asi que esta tabla no puede hospedarlo. La logica
2145+ DA70              ; es equivalente: AABB del player vs rect del arco con tolerancia +-4.
2146+ DA70              ; ==============================================================================
2147+ DA70              BumpTriggerTable:
2148+ DA70 F2 E1            DEFW BgGfx_old_church_door_closed
2149+ DA72 05               DEFB 5                          ; key requerida = ChurchKey
2150+ DA73 02               DEFB 2                          ; action = ChurchDoor open
2151+ DA74 AD DB            DEFW BgGfx_chimes_tower_door
2152+ DA76 04               DEFB 4                          ; key requerida = ClockTowerKey
2153+ DA77 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2154+ DA78 00 00            DEFW 0                          ; fin
2155+ DA7A 00 00            DEFB 0, 0
