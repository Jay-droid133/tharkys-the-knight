 121+ F075              ; UpdateGameClock
 122+ F075              ; ==============================================================================
 123+ F075              UpdateGameClock:
 124+ F075 21 DB EE         LD HL, GameSubMinute
 125+ F078 34               INC (HL)
 126+ F079 3A DE EE         LD A, (SubMinuteMax)
 127+ F07C BE               CP (HL)
 128+ F07D C0               RET NZ
 129+ F07E
 130+ F07E AF               XOR A
 131+ F07F 32 DB EE         LD (GameSubMinute), A
 132+ F082 21 DC EE         LD HL, GameMinutes
 133+ F085 34               INC (HL)
 134+ F086                  ; --- Check 00:30 → spawnear monstruos ---
 135+ F086 3A DD EE         LD A, (GameHours)
 136+ F089 B7               OR A
 137+ F08A 20 08            JR NZ, .noMonsterSpawn          ; No es hora 0
 138+ F08C 7E               LD A, (HL)                      ; HL = GameMinutes
 139+ F08D FE 1E            CP 30
 140+ F08F 20 03            JR NZ, .noMonsterSpawn
 141+ F091 CD ED A2         CALL SpawnMonsters
 142+ F094              .noMonsterSpawn:
 143+ F094 3A DC EE         LD A, (GameMinutes)
 144+ F097 FE 3C            CP 60
 145+ F099 C0               RET NZ
 146+ F09A
 147+ F09A AF               XOR A
 148+ F09B 32 DC EE         LD (GameMinutes), A
 149+ F09E 21 DD EE         LD HL, GameHours
 150+ F0A1 34               INC (HL)
 151+ F0A2 7E               LD A, (HL)
 152+ F0A3 FE 18            CP 24
 153+ F0A5 20 04            JR NZ, .checkPhase
 154+ F0A7 AF               XOR A
 155+ F0A8 32 DD EE         LD (GameHours), A
 156+ F0AB
 157+ F0AB              .checkPhase:
 158+ F0AB 3A DD EE         LD A, (GameHours)
 159+ F0AE 21 E7 EE         LD HL, PhaseTable
 160+ F0B1 06 07            LD B, 7
 161+ F0B3              .phaseLoop:
 162+ F0B3 BE               CP (HL)
 163+ F0B4 28 05            JR Z, .phaseFound
 164+ F0B6 23               INC HL
 165+ F0B7 23               INC HL
 166+ F0B8 10 F9            DJNZ .phaseLoop
 167+ F0BA C9               RET
 168+ F0BB              .phaseFound:
 169+ F0BB 23               INC HL
 170+ F0BC 7E               LD A, (HL)
 171+ F0BD F5               PUSH AF
 172+ F0BE CD 07 EA         CALL SetTimeOfDay
 173+ F0C1 F1               POP AF
 174+ F0C2 B7               OR A                                ; Fase 0 = DY (amanecer 7:00)?
 175+ F0C3 C0               RET NZ
 176+ F0C4                  ; Nuevo dia: incrementar ciclo
 177+ F0C4 21 C9 A2         LD HL, DayCycleCount
 178+ F0C7 34               INC (HL)
 179+ F0C8 C9               RET
