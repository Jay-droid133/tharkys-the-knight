  52+ 987F              ; --- AY_UpdateBell: cada frame ---
  53+ 987F              ; SP alterno (slot 1) durante el page switch para no enmascarar IRQs. DI corto
  54+ 987F              ; SOLO alrededor del Impl (que hace varios OUTs AY que deben ser atomicos
  55+ 987F              ; respecto al handler IRQ que tambien escribe AY). Ver project_paging_alt_stack.
  56+ 987F              AY_UpdateBell:
  57+ 987F ED 73 AC 98      LD (.aubSavedSP), SP
  58+ 9883 31 CE 6D         LD SP, PagingAltStackTop
  59+ 9886 3A 82 8D         LD A, (CurrentPaging)
  60+ 9889 E6 F8            AND $F8
  61+ 988B F6 04            OR 4
  62+ 988D 32 82 8D         LD (CurrentPaging), A
  63+ 9890 01 FD 7F         LD BC, $7FFD
  64+ 9893 ED 79            OUT (C), A                      ; slot 3 = bank 4 (sin DI; SP alterno)
  65+ 9895 F3               DI                              ; cierra ventana antes de los OUTs AY del Impl
  66+ 9896 CD 81 E5         CALL AY_UpdateBellImpl
  67+ 9899 FB               EI
  68+ 989A 3A 82 8D         LD A, (CurrentPaging)
  69+ 989D E6 F8            AND $F8
  70+ 989F 32 82 8D         LD (CurrentPaging), A
  71+ 98A2 01 FD 7F         LD BC, $7FFD
  72+ 98A5 ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98A7 ED 7B AC 98      LD SP, (.aubSavedSP)
  74+ 98AB C9               RET
  75+ 98AC 00 00        .aubSavedSP: DEFW 0
  76+ 98AE
  77+ 98AE              ; --- UpdateMusic: cada frame (driver tabular generico, content-agnostic) ---
  78+ 98AE              UpdateMusic:
  79+ 98AE F3               DI
  80+ 98AF 3A 82 8D         LD A, (CurrentPaging)
  81+ 98B2 E6 F8            AND $F8
  82+ 98B4 F6 04            OR 4
  83+ 98B6 32 82 8D         LD (CurrentPaging), A
  84+ 98B9 01 FD 7F         LD BC, $7FFD
  85+ 98BC ED 79            OUT (C), A
  86+ 98BE CD 92 7D         CALL UpdateMusicImpl
  87+ 98C1 3A 82 8D         LD A, (CurrentPaging)
  88+ 98C4 E6 F8            AND $F8
  89+ 98C6 32 82 8D         LD (CurrentPaging), A
  90+ 98C9 01 FD 7F         LD BC, $7FFD
  91+ 98CC ED 79            OUT (C), A
  92+ 98CE FB               EI
  93+ 98CF C9               RET
  94+ 98D0
  95+ 98D0              ; --- AY_PlayBellChime: medianoche/iglesia, cold ---
  96+ 98D0              ; D = pan (-1=izq, 0=centro, +1=der). Preservar D atraviesa el thunk porque
  97+ 98D0              ; el patron page-switch no toca DE.
  98+ 98D0              ; SP alterno + DI corto solo en el Impl (mismo patron que AY_UpdateBell).
  99+ 98D0              AY_PlayBellChime:
 100+ 98D0 ED 73 FD 98      LD (.apbcSavedSP), SP
 101+ 98D4 31 CE 6D         LD SP, PagingAltStackTop
 102+ 98D7 3A 82 8D         LD A, (CurrentPaging)
 103+ 98DA E6 F8            AND $F8
 104+ 98DC F6 04            OR 4
 105+ 98DE 32 82 8D         LD (CurrentPaging), A
 106+ 98E1 01 FD 7F         LD BC, $7FFD
 107+ 98E4 ED 79            OUT (C), A
 108+ 98E6 F3               DI
 109+ 98E7 CD D6 E4         CALL AY_PlayBellChimeImpl
 110+ 98EA FB               EI
 111+ 98EB 3A 82 8D         LD A, (CurrentPaging)
 112+ 98EE E6 F8            AND $F8
