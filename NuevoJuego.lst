 145+ 6A8F              ; ==============================================================================
 146+ 6A8F              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 147+ 6A8F              ; ==============================================================================
 148+ 6A8F              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 149+ 6A8F              ;      A  = bank (0-7) donde vive el sprite
 150+ 6A8F              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 151+ 6A8F              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 152+ 6A8F              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 153+ 6A8F              ;
 154+ 6A8F              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 155+ 6A8F              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 156+ 6A8F              ; forzar EI prematuro en startup.
 157+ 6A8F              ;
 158+ 6A8F              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 159+ 6A8F              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 160+ 6A8F              ; ==============================================================================
 161+ 6A8F              LoadBgSpriteToBuffer:
 162+ 6A8F                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 163+ 6A8F                  ; necesitan intacto, y los registros alternos se usan abajo).
 164+ 6A8F 32 1E 6B         LD (.lbsBankSave), A
 165+ 6A92                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 166+ 6A92                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 167+ 6A92 C5               PUSH BC
 168+ 6A93                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 169+ 6A93 F3               DI
 170+ 6A94                  ; Page bank deseado inline
 171+ 6A94 3A E8 90         LD A, (CurrentPaging)
 172+ 6A97 E6 F8            AND $F8
 173+ 6A99 47               LD B, A                         ; B = paging limpio sin bank
 174+ 6A9A 3A 1E 6B         LD A, (.lbsBankSave)
 175+ 6A9D E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 6A9F B0               OR B                            ; merge bank en paging
 177+ 6AA0 32 E8 90         LD (CurrentPaging), A
 178+ 6AA3 01 FD 7F         LD BC, $7FFD
 179+ 6AA6 ED 79            OUT (C), A
 180+ 6AA8                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 6AA8                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 6AA8                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 6AA8                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 6AA8 11 9B 89         LD DE, BgSpriteBuffer
 185+ 6AAB                  ; Copiar H (header byte 0)
 186+ 6AAB 7E               LD A, (HL)
 187+ 6AAC 12               LD (DE), A
 188+ 6AAD 32 1C 6B         LD (.lbsHsave), A
 189+ 6AB0 23               INC HL
 190+ 6AB1 13               INC DE
 191+ 6AB2                  ; Copiar W|RLE (header byte 1)
 192+ 6AB2 7E               LD A, (HL)
 193+ 6AB3 12               LD (DE), A
 194+ 6AB4 23               INC HL
 195+ 6AB5 13               INC DE
 196+ 6AB6 CB 7F            BIT 7, A
 197+ 6AB8 20 47            JR NZ, .lbsRleFallback
 198+ 6ABA E6 7F            AND $7F
 199+ 6ABC 32 1D 6B         LD (.lbsWsave), A
 200+ 6ABF                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 6ABF 3A 1C 6B         LD A, (.lbsHsave)
