   1+ 0000              ; ==============================================================================
   2+ 0000              ; CONSTANTES DEL SISTEMA Y JUEGO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000              ; --- Direcciones de Memoria ---
   6+ 0000              ORIGIN_ADDRESS  EQU 32768           ; $8000 - Inicio de nuestro juego en RAM
   7+ 0000              SP_ADDRESS      EQU 65368           ; $FF58 - Tope seguro para la pila (Stack)
   8+ 0000
   9+ 0000              ; --- Mapa de Video ---
  10+ 0000              SCREEN_BASE     EQU 16384           ; $4000 - Inicio de los píxeles
  11+ 0000              ATTR_BASE       EQU 22528           ; $5800 - Inicio de los atributos (colores)
  12+ 0000              ATTR_SIZE       EQU 768             ; Tamaño de la zona de atributos
  13+ 0000
  14+ 0000              ; --- Colores Básicos (Tinta) ---
  15+ 0000              BLACK           EQU 0
  16+ 0000              BLUE            EQU 1
  17+ 0000              RED             EQU 2
  18+ 0000              MAGENTA         EQU 3
  19+ 0000              GREEN           EQU 4
  20+ 0000              CYAN            EQU 5
  21+ 0000              YELLOW          EQU 6
  22+ 0000              WHITE           EQU 7
  23+ 0000
  24+ 0000              ; --- Rutinas de la ROM ---
  25+ 0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
  26+ 0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
  27+ 0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
  28+ 0000
  29+ 0000              ; --- Movimiento estilo Sabre Wulf (8-bit, sin subpixel) ---
  30+ 0000              ; --- Movimiento estilo Sabre Wulf ---
  31+ 0000              ; Fiel al original: 4px cada 2 frames (turns_per_player_move=2).
  32+ 0000              ; PlayerMoveTimer controla cuándo se aplica el movimiento.
  33+ 0000              ;
  34+ 0000              ; COMPENSACION DE RALENTIZACION POR NASTIS
  35+ 0000              ; -----------------------------------------
  36+ 0000              ; Cuando hay multiples enemigos (monsters + nastis) en pantalla, la CPU del Spectrum no da
  37+ 0000              ; abasto y el framerate cae. Para que el jugador no note la diferencia,
  38+ 0000              ; se aplica un sistema de boost dinamico tanto a la velocidad de
  39+ 0000              ; movimiento como a la velocidad de animacion:
  40+ 0000              ;
  41+ 0000              ; Velocidad de movimiento (UpdatePlayerMovement):
  42+ 0000              ;   Usa una tabla fraccionaria (.speedBoostTable) con acumulador de 8 bits
  43+ 0000              ;   (SpeedFracAccum). Cada nasti aporta una parte entera y una fraccion.
  44+ 0000              ;   Cuando el acumulador desborda (>= 256), se suma +1px extra ese frame.
  45+ 0000              ;   Esto permite velocidades intermedias (ej: +0.5px/frame, +1.5px/frame).
  46+ 0000              ;
  47+ 0000              ;   | Nastis | Corriendo (base 2px) | Atacando (base 1px) |
  48+ 0000              ;   |--------|----------------------|---------------------|
  49+ 0000              ;   | 0      | 2.0                  | 1.0                 |
  50+ 0000              ;   | 1      | 2.5                  | 1.5                 |
  51+ 0000              ;   | 2      | 3.0                  | 2.0                 |
  52+ 0000              ;   | 3      | 3.5                  | 2.5                 |
  53+ 0000              ;
  54+ 0000              ; Velocidad de animacion (UpdatePlayerAnimation, .applyAnim):
  55+ 0000              ;   Reduce el ANIM_DELAY en -1 por cada nasti a partir del 2do.
  56+ 0000              ;   Minimo delay = 1 frame. Misma logica para correr y atacar.
  57+ 0000              ;
  58+ 0000              ;   | Nastis | Delay correr (base 4) | Delay atacar (base 2) |
  59+ 0000              ;   |--------|-----------------------|-----------------------|
  60+ 0000              ;   | 0-1    | 4                     | 2                     |
  61+ 0000              ;   | 2      | 3                     | 1                     |
  62+ 0000              ;   | 3      | 2                     | 1                     |
  63+ 0000              ;
  64+ 0000              SPEED_RUN           EQU 2           ; 2 px por movimiento corriendo
  65+ 0000              SPEED_FIGHT         EQU 1           ; 1 px por movimiento atacando
  66+ 0000              NASTY_BOOST_THRESHOLD EQU 2         ; (legacy, ya no se usa en el boost fraccionario)
  67+ 0000              PLAYER_MOVE_TURNS   EQU 1           ; Mover cada frame (granularidad fina para colision char-based)
  68+ 0000
  69+ 0000              ; --- Limites de pantalla (en pixeles) ---
  70+ 0000              ; Los limites maximos asumen sprite 16px ancho, ~16px alto.
  71+ 0000              ; Para sprites mas grandes, el clamp real se ajusta en runtime.
  72+ 0000              ; HUD en filas 0-1 (16px superiores); area de juego en filas 2-23.
  73+ 0000              SCREEN_MIN_X    EQU 0               ; Limite izquierdo
  74+ 0000              SCREEN_MAX_X    EQU 232             ; Limite derecho (con margen para shift: 256 - 16 - 8)
  75+ 0000              SCREEN_MIN_Y    EQU 16              ; Limite superior (debajo del HUD: 2 filas x 8px)
  76+ 0000              SCREEN_MAX_Y    EQU 171             ; Limite inferior (16 + 176 - 21)
  77+ 0000              BG_Y_OFFSET     EQU 2              ; Offset (char-rows) aplicado al dibujar/colisionar sprites BG
  78+ 0000
  79+ 0000              ; --- Animacion (delays en frames de pantalla) ---
  80+ 0000              ANIM_DELAY_RUN  EQU 4               ; Frames entre cambios de anim corriendo
  81+ 0000              ANIM_DELAY_IDLE EQU 20               ; Frames entre cambios de anim idle
  82+ 0000              ANIM_DELAY_FIGHT EQU 2              ; Frames entre cambios de anim peleando
  83+ 0000              ANIM_DELAY_PUFF EQU 3               ; Frames entre cambios de anim puff (muerte)
  84+ 0000              ANIM_DELAY_SPAWN EQU 3              ; Frames entre cambios de anim spawn (aparicion)
  85+ 0000
  86+ 0000              ; --- Numero de frames de animacion por estado ---
  87+ 0000              ANIM_FRAMES_WALK    EQU 3           ; Frames caminando por direccion
  88+ 0000              ANIM_FRAMES_FIGHT   EQU 5           ; Frames peleando por direccion
  89+ 0000              ANIM_FRAMES_IDLE    EQU 2           ; Frames idle
  90+ 0000              ANIM_FRAMES_PUFF    EQU 6           ; Frames de la animacion puff (muerte)
  91+ 0000              ANIM_FRAMES_SPAWN   EQU 6           ; Frames de la animacion spawn (aparicion)
  92+ 0000
  93+ 0000              ; --- Direcciones del jugador ---
  94+ 0000              DIR_NONE        EQU 0
  95+ 0000              DIR_N           EQU 1
  96+ 0000              DIR_S           EQU 2
  97+ 0000              DIR_E           EQU 4
  98+ 0000              DIR_W           EQU 8
  99+ 0000              DIR_NE          EQU 5               ; DIR_N | DIR_E
 100+ 0000              DIR_NW          EQU 9               ; DIR_N | DIR_W
 101+ 0000              DIR_SE          EQU 6               ; DIR_S | DIR_E
 102+ 0000              DIR_SW          EQU 10              ; DIR_S | DIR_W
