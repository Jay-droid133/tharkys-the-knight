1108+ D5F3              .roaAabbLoop:
1109+ D5F3                  ; (HL+0)=pX, (HL+1)=pY, (HL+2)=pXEnd, (HL+3)=pYEnd.
1110+ D5F3                  ; eraseRect = [eX..eX+3] × [eY..eY+3].
1111+ D5F3                  ; Overlap: pX <= eX+3 AND pXEnd >= eX AND pY <= eY+3 AND pYEnd >= eY.
1112+ D5F3                  ; eX+3 < pX -> no overlap (X)
1113+ D5F3 3A 36 D6         LD A, (.roaEraseX)
1114+ D5F6 C6 03            ADD A, 3
1115+ D5F8 BE               CP (HL)
1116+ D5F9 38 34            JR C, .roaAabbNext
1117+ D5FB 23               INC HL                              ; pY
1118+ D5FC                  ; eY+3 < pY -> no overlap (Y)
