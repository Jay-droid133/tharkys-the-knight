1821+ F87F
1822+ F87F              ; ==============================================================================
1823+ F87F              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1824+ F87F              ;                     debe salir (magic compass activa).
1825+ F87F              ; ==============================================================================
1826+ F87F              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1827+ F87F              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1828+ F87F              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1829+ F87F              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1830+ F87F              ; el viejo porque DrawScreen ya repinta BG limpio.
1831+ F87F              ;
1832+ F87F              ; Llamada cada frame desde MainLoop tras DrawCompass.
1833+ F87F              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1834+ F87F              ; ==============================================================================
1835+ F87F              DrawCompassGapHint:
1836+ F87F                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1837+ F87F                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1838+ F87F                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1839+ F87F                  ; produciendo el parpadeo sincronizado con el tic AY.
1840+ F87F 2A BF 5F         LD HL, (MagicCompassTimer)
1841+ F882 7C               LD A, H
1842+ F883 B5               OR L
1843+ F884 28 7B            JR Z, .dcghHide
1844+ F886 3A C1 5F         LD A, (MagicCompassPathDir)
1845+ F889 3C               INC A                               ; A=0 si era $FF
1846+ F88A 28 75            JR Z, .dcghHide
1847+ F88C 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1848+ F88F B7               OR A
1849+ F890 28 6F            JR Z, .dcghHide
1850+ F892
1851+ F892                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1852+ F892 21 B5 F9         LD HL, HintLastDir
1853+ F895 7E               LD A, (HL)
1854+ F896 47               LD B, A
1855+ F897 3A C1 5F         LD A, (MagicCompassPathDir)
1856+ F89A B8               CP B
1857+ F89B 20 1A            JR NZ, .dcghDraw
1858+ F89D 23               INC HL
1859+ F89E 7E               LD A, (HL)
1860+ F89F 47               LD B, A
1861+ F8A0 3A C2 5F         LD A, (MagicCompassPathCoord)
1862+ F8A3 B8               CP B
1863+ F8A4 20 11            JR NZ, .dcghDraw
1864+ F8A6 23               INC HL
1865+ F8A7 7E               LD A, (HL)
1866+ F8A8 47               LD B, A
1867+ F8A9 3A 10 83         LD A, (CurrentScreenX)
1868+ F8AC B8               CP B
1869+ F8AD 20 08            JR NZ, .dcghDraw
1870+ F8AF 23               INC HL
1871+ F8B0 7E               LD A, (HL)
1872+ F8B1 47               LD B, A
1873+ F8B2 3A 11 83         LD A, (CurrentScreenY)
1874+ F8B5 B8               CP B
1875+ F8B6 C8               RET Z                               ; sin cambio -> nada que hacer
1876+ F8B7
1877+ F8B7              .dcghDraw:
1878+ F8B7                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1879+ F8B7                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1880+ F8B7 3A B5 F9         LD A, (HintLastDir)
1881+ F8BA FE FF            CP $FF
1882+ F8BC 28 1F            JR Z, .dcghDrawNew
1883+ F8BE 3A B7 F9         LD A, (HintLastScreenX)
1884+ F8C1 47               LD B, A
1885+ F8C2 3A 10 83         LD A, (CurrentScreenX)
1886+ F8C5 B8               CP B
1887+ F8C6 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1888+ F8C8 3A B8 F9         LD A, (HintLastScreenY)
1889+ F8CB 47               LD B, A
1890+ F8CC 3A 11 83         LD A, (CurrentScreenY)
1891+ F8CF B8               CP B
1892+ F8D0 20 0B            JR NZ, .dcghDrawNew
1893+ F8D2 3A B5 F9         LD A, (HintLastDir)
1894+ F8D5 47               LD B, A
1895+ F8D6 3A B6 F9         LD A, (HintLastCoord)
1896+ F8D9 4F               LD C, A
1897+ F8DA CD 58 F9         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1898+ F8DD              .dcghDrawNew:
1899+ F8DD 3A C1 5F         LD A, (MagicCompassPathDir)
1900+ F8E0 47               LD B, A
1901+ F8E1 3A C2 5F         LD A, (MagicCompassPathCoord)
1902+ F8E4 4F               LD C, A
1903+ F8E5 CD 4B F9         CALL DrawHintAtPos
1904+ F8E8                  ; Update cache
1905+ F8E8 3A C1 5F         LD A, (MagicCompassPathDir)
1906+ F8EB 32 B5 F9         LD (HintLastDir), A
1907+ F8EE 3A C2 5F         LD A, (MagicCompassPathCoord)
1908+ F8F1 32 B6 F9         LD (HintLastCoord), A
1909+ F8F4 3A 10 83         LD A, (CurrentScreenX)
1910+ F8F7 32 B7 F9         LD (HintLastScreenX), A
1911+ F8FA 3A 11 83         LD A, (CurrentScreenY)
1912+ F8FD 32 B8 F9         LD (HintLastScreenY), A
1913+ F900 C9               RET
1914+ F901
1915+ F901              .dcghHide:
1916+ F901                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1917+ F901 3A B5 F9         LD A, (HintLastDir)
1918+ F904 FE FF            CP $FF
1919+ F906 C8               RET Z
1920+ F907 3A B7 F9         LD A, (HintLastScreenX)
1921+ F90A 47               LD B, A
1922+ F90B 3A 10 83         LD A, (CurrentScreenX)
1923+ F90E B8               CP B
1924+ F90F 20 15            JR NZ, .dcghHideInvalidate
1925+ F911 3A B8 F9         LD A, (HintLastScreenY)
1926+ F914 47               LD B, A
1927+ F915 3A 11 83         LD A, (CurrentScreenY)
1928+ F918 B8               CP B
1929+ F919 20 0B            JR NZ, .dcghHideInvalidate
1930+ F91B 3A B5 F9         LD A, (HintLastDir)
1931+ F91E 47               LD B, A
1932+ F91F 3A B6 F9         LD A, (HintLastCoord)
1933+ F922 4F               LD C, A
1934+ F923 CD 58 F9         CALL EraseHintAtPos                 ; XOR + restore attrs
1935+ F926              .dcghHideInvalidate:
1936+ F926 3E FF            LD A, $FF
1937+ F928 32 B5 F9         LD (HintLastDir), A
1938+ F92B C9               RET
1939+ F92C
1940+ F92C              ; ==============================================================================
1941+ F92C              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1942+ F92C              ; ==============================================================================
1943+ F92C              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1944+ F92C              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1945+ F92C              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1946+ F92C              ;
1947+ F92C              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1948+ F92C              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1949+ F92C              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1950+ F92C              ; la zona de atributos ($5800+).
1951+ F92C              ; Destruye: A.
1952+ F92C              ; ==============================================================================
1953+ F92C              ComputeHintPos:
1954+ F92C 78               LD A, B
1955+ F92D B7               OR A
1956+ F92E 28 0A            JR Z, .chpNorth                     ; 0 = N
1957+ F930 3D               DEC A
1958+ F931 28 0B            JR Z, .chpSouth                     ; 1 = S
1959+ F933 3D               DEC A
1960+ F934 28 0C            JR Z, .chpWest                      ; 2 = W
1961+ F936                  ; Fall-through: 3 = E
1962+ F936 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1963+ F938 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1964+ F93A              .chpNorth:
1965+ F93A 41               LD B, C                             ; charX = coord
1966+ F93B 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1967+ F93D C9               RET
1968+ F93E              .chpSouth:
1969+ F93E 41               LD B, C
1970+ F93F 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1971+ F941 C9               RET
1972+ F942              .chpWest:
1973+ F942 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1974+ F944                  ; fall-through a .chpVertShift
1975+ F944              .chpVertShift:
1976+ F944                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1977+ F944                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1978+ F944                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1979+ F944 79               LD A, C
1980+ F945 FE 07            CP 7
1981+ F947 D8               RET C                               ; coord < 7: gap superior, charY = coord
1982+ F948 3C               INC A                               ; gap inferior: charY = coord + 1
1983+ F949 4F               LD C, A
1984+ F94A C9               RET
