 641+ E77C C9               RET
 642+ E77D
 643+ E77D              ; ==============================================================================
 644+ E77D              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 645+ E77D              ; ==============================================================================
 646+ E77D              DrawZoneCountHUD:
 647+ E77D 3A 00 5D         LD A, (ZoneCellCount)
 648+ E780                  ; Hi nibble
 649+ E780 47               LD B, A
 650+ E781 CB 3F            SRL A
 651+ E783 CB 3F            SRL A
 652+ E785 CB 3F            SRL A
 653+ E787 CB 3F            SRL A
 654+ E789 FE 0A            CP 10
 655+ E78B 38 04            JR C, .dzcHiDigit
 656+ E78D C6 37            ADD A, 'A' - 10
 657+ E78F 18 02            JR .dzcHiOut
 658+ E791              .dzcHiDigit:
 659+ E791 C6 30            ADD A, '0'
 660+ E793              .dzcHiOut:
 661+ E793 1E 0B            LD E, 11
 662+ E795 CD CD E7         CALL DrawHudCharRow0
 663+ E798                  ; Lo nibble
 664+ E798 78               LD A, B
 665+ E799 E6 0F            AND $0F
 666+ E79B FE 0A            CP 10
 667+ E79D 38 04            JR C, .dzcLoDigit
 668+ E79F C6 37            ADD A, 'A' - 10
 669+ E7A1 18 02            JR .dzcLoOut
 670+ E7A3              .dzcLoDigit:
 671+ E7A3 C6 30            ADD A, '0'
 672+ E7A5              .dzcLoOut:
