 921+ A7A2              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
 922+ A7A2              ; ==============================================================================
 923+ A7A2              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
 924+ A7A2              ; IX = puntero a la entidad
 925+ A7A2              ; ==============================================================================
 926+ A7A2              DrawEntity:
 927+ A7A2 CD D7 A7         CALL GetSpriteAddr
 928+ A7A5
 929+ A7A5                  ; Guardar attrs del fondo ANTES de pintar
 930+ A7A5 DD 56 04         LD D, (IX+ENT_POSY)
 931+ A7A8 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 932+ A7AB 5F               LD E, A
 933+ A7AC DD E5            PUSH IX
 934+ A7AE DD 2A 06 A8      LD IX, (SpriteAddrTemp)
 935+ A7B2 CD 1C 9F         CALL SaveEntityAttr
 936+ A7B5 DD E1            POP IX
 937+ A7B7
 938+ A7B7                  ; Pintar atributo ANTES del draw
