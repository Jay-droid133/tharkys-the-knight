 284+ EB95 32 99 81         LD (EntityTable + ENT_ATTR), A
 285+ EB98 C9               RET
 286+ EB99
 287+ EB99              ; ==============================================================================
 288+ EB99              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 289+ EB99              ; ==============================================================================
 290+ EB99              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 291+ EB99              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 292+ EB99              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 293+ EB99              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 294+ EB99              ; si no, restaura WHITE | $40.
 295+ EB99              ; ==============================================================================
 296+ EB99              UpdateMushroomBuffBody:
 297+ EB99 2A D3 82         LD HL, (MushroomLockTimer)
 298+ EB9C 7C               LD A, H
 299+ EB9D B5               OR L
 300+ EB9E C8               RET Z                               ; sin debuff
 301+ EB9F 2B               DEC HL
 302+ EBA0 22 D3 82         LD (MushroomLockTimer), HL
 303+ EBA3 7C               LD A, H
 304+ EBA4 B5               OR L
 305+ EBA5 20 0B            JR NZ, .umbActive
 306+ EBA7                  ; --- Justo expirado: restaurar segun estado de speed buff ---
 307+ EBA7 3A D2 82         LD A, (SpeedBuffType)
 308+ EBAA B7               OR A
 309+ EBAB C0               RET NZ                              ; speed buff activo: ya pinto color, no tocar
 310+ EBAC 3E 47            LD A, WHITE | $40
 311+ EBAE 32 99 81         LD (EntityTable + ENT_ATTR), A
 312+ EBB1 C9               RET
 313+ EBB2              .umbActive:
 314+ EBB2 3E 43            LD A, MUSHROOM_LOCK_ATTR
 315+ EBB4 32 99 81         LD (EntityTable + ENT_ATTR), A
 316+ EBB7 C9               RET
 317+ EBB8
 318+ EBB8              ; ==============================================================================
