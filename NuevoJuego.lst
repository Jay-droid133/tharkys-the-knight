 224+ E534                  ; --- Tecla N: togglea NoclipMode (debug) ---
 225+ E534 3E 7F            LD A, $7F
 226+ E536 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 227+ E538 CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 228+ E53A 20 13            JR NZ, .nNotPressed
 229+ E53C 3A 55 E5         LD A, (NoclipKeyDebounce)
 230+ E53F B7               OR A
 231+ E540 C0               RET NZ
 232+ E541 3E 01            LD A, 1
