  45+ 90FA 0F               RRCA
  46+ 90FB E6 1F            AND $1F
  47+ 90FD 32 04 9B         LD (MaiFlowPlCy), A
  48+ 9100
  49+ 9100                  ; --- Swap a stack temporal (bank 2) ---
  50+ 9100 ED 73 0A 9B      LD (MaiFlowSavedSP), SP
  51+ 9104 31 AA 9B         LD SP, MaiTempStackTop
  52+ 9107
  53+ 9107                  ; --- Ventana de paginacion ---
  54+ 9107                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 9107 F3               DI
  56+ 9108 3A D4 90         LD A, (CurrentPaging)
  57+ 910B E6 F8            AND $F8
  58+ 910D F6 06            OR 6
  59+ 910F 32 D4 90         LD (CurrentPaging), A
  60+ 9112 01 FD 7F         LD BC, $7FFD
  61+ 9115 ED 79            OUT (C), A
