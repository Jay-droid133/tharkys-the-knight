 425  E8BD                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ E8BD              ; ==============================================================================
   2+ E8BD              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ E8BD              ; ==============================================================================
   4+ E8BD              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ E8BD              ; Para cada shift S:
   6+ E8BD              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ E8BD              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ E8BD              ;
   9+ E8BD              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ E8BD              ;
  11+ E8BD              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ E8BD              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ E8BD              ;
  14+ E8BD              ; Calculo de B desde X%8:
  15+ E8BD              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ E8BD              ; ==============================================================================
  17+ E8BD
  18+ E8BD 00 00 00...      ALIGN 256
  19+ E900              ShiftTables:
  20+ E900                  LUA ALLPASS
  21+ E900 ~                for shift = 1, 7 do
  22+ E900 ~                    -- High part: byte >> shift
  23+ E900 ~                    for i = 0, 255 do
  24+ E900 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ E900 ~                    end
  26+ E900 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ E900 ~                    for i = 0, 255 do
  28+ E900 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ E900 ~                    end
  30+ E900 ~                end
  31+ E900 00 00 01 01      ENDLUA
