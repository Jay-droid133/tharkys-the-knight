1939+ F897
1940+ F897              ; ==============================================================================
1941+ F897              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1942+ F897              ; ==============================================================================
1943+ F897              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1944+ F897              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1945+ F897              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1946+ F897              ;
1947+ F897              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1948+ F897              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1949+ F897              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1950+ F897              ; la zona de atributos ($5800+).
1951+ F897              ; Destruye: A.
1952+ F897              ; ==============================================================================
1953+ F897              ComputeHintPos:
1954+ F897 78               LD A, B
1955+ F898 B7               OR A
1956+ F899 28 0A            JR Z, .chpNorth                     ; 0 = N
1957+ F89B 3D               DEC A
1958+ F89C 28 0B            JR Z, .chpSouth                     ; 1 = S
1959+ F89E 3D               DEC A
1960+ F89F 28 0C            JR Z, .chpWest                      ; 2 = W
1961+ F8A1                  ; Fall-through: 3 = E
1962+ F8A1 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1963+ F8A3 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1964+ F8A5              .chpNorth:
1965+ F8A5 41               LD B, C                             ; charX = coord
1966+ F8A6 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1967+ F8A8 C9               RET
1968+ F8A9              .chpSouth:
1969+ F8A9 41               LD B, C
1970+ F8AA 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1971+ F8AC C9               RET
1972+ F8AD              .chpWest:
1973+ F8AD 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1974+ F8AF                  ; fall-through a .chpVertShift
1975+ F8AF              .chpVertShift:
1976+ F8AF                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1977+ F8AF                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1978+ F8AF                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1979+ F8AF 79               LD A, C
1980+ F8B0 FE 07            CP 7
1981+ F8B2 D8               RET C                               ; coord < 7: gap superior, charY = coord
1982+ F8B3 3C               INC A                               ; gap inferior: charY = coord + 1
1983+ F8B4 4F               LD C, A
1984+ F8B5 C9               RET
1985+ F8B6
1986+ F8B6              ; ==============================================================================
1987+ F8B6              ; DrawHintAtPos - Load sprite + XOR-draw flecha en (B=dir, C=coord)
1988+ F8B6              ; ==============================================================================
1989+ F8B6              ; IN:  B = PathDir (0=N, 1=S, 2=W, 3=E)
1990+ F8B6              ;      C = PathCoord (char col para N/S, char row para W/E)
1991+ F8B6              ; Destruye: AF, BC, DE, HL, IX.
1992+ F8B6              ; ==============================================================================
1993+ F8B6              DrawHintAtPos:
1994+ F8B6 CD E0 F8         CALL LoadHintSprite                 ; HL = ptr cargado a BgSpriteBuffer; preserva BC
1995+ F8B9 CD 97 F8         CALL ComputeHintPos                 ; B=charX, C=charY
1996+ F8BC DD 21 EE 86      LD IX, BgSpriteBuffer
1997+ F8C0 C3 D6 DB         JP DrawBgSpriteXOR                  ; tail call
1998+ F8C3
1999+ F8C3              ; ==============================================================================
2000+ F8C3              ; EraseHintAtPos - XOR-erase + restore attrs en (B=dir, C=coord)
2001+ F8C3              ; ==============================================================================
2002+ F8C3              ; Llamado al cambiar de path/sala/cancel. Mismo XOR-draw que erase los pixels,
2003+ F8C3              ; mas RestorePickupAttrs para limpiar las attrs (de lo contrario quedan
2004+ F8C3              ; cuadrados verdes huerfanos en pantalla).
2005+ F8C3              ; ==============================================================================
2006+ F8C3              EraseHintAtPos:
2007+ F8C3 CD E0 F8         CALL LoadHintSprite                 ; HL=ptr; BgSpriteBuffer poblado
2008+ F8C6 CD 97 F8         CALL ComputeHintPos                 ; B=charX, C=charY
2009+ F8C9 C5               PUSH BC                             ; save charX, charY for RestorePickupAttrs
2010+ F8CA DD 21 EE 86      LD IX, BgSpriteBuffer
2011+ F8CE CD D6 DB         CALL DrawBgSpriteXOR                ; XOR-erase pixels
2012+ F8D1 C1               POP BC
2013+ F8D2                  ; height_chars depende del sprite (2 para 16x16, 3 para 16x24).
2014+ F8D2                  ; Leer del header: BgSpriteBuffer[0] = height_px; /8 = char rows.
2015+ F8D2 3A EE 86         LD A, (BgSpriteBuffer)
2016+ F8D5 0F               RRCA
2016+ F8D6 0F             RRCA
2016+ F8D7 0F             RRCA                  ; /8
2017+ F8D8 E6 1F            AND $1F
2018+ F8DA 57               LD D, A                             ; height_chars
2019+ F8DB 1E 02            LD E, 2                             ; width_chars (siempre 2 para flechas)
2020+ F8DD C3 6C DC         JP RestorePickupAttrs               ; tail call: restaura attrs desde CleanAttrMap
2021+ F8E0
2022+ F8E0              ; ==============================================================================
2023+ F8E0              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2024+ F8E0              ; ==============================================================================
2025+ F8E0              ; IN:  B = PathDir, C = PathCoord
2026+ F8E0              ; OUT: BgSpriteBuffer poblado con sprite
2027+ F8E0              ; Destruye: AF, DE, HL. Preserva BC.
2028+ F8E0              ;
2029+ F8E0              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2030+ F8E0              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2031+ F8E0              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2032+ F8E0              ; ==============================================================================
2033+ F8E0              LoadHintSprite:
2034+ F8E0 78               LD A, B
2035+ F8E1 FE 02            CP 2                                ; W?
2036+ F8E3 28 12            JR Z, .lhsW
2037+ F8E5 FE 03            CP 3                                ; E?
2038+ F8E7 28 1D            JR Z, .lhsE
2039+ F8E9                  ; N o S -> tabla base
2040+ F8E9 87               ADD A, A                            ; *2
2041+ F8EA 5F               LD E, A
2042+ F8EB 16 00            LD D, 0
2043+ F8ED 21 18 F9         LD HL, HintArrowPtrs
2044+ F8F0 19               ADD HL, DE
2045+ F8F1 5E               LD E, (HL)
2046+ F8F2 23               INC HL
2047+ F8F3 56               LD D, (HL)
2048+ F8F4 EB               EX DE, HL                           ; HL = sprite ptr
2049+ F8F5 18 1C            JR .lhsLoad
2050+ F8F7              .lhsW:
2051+ F8F7 79               LD A, C
2052+ F8F8 FE 07            CP 7
2053+ F8FA 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2054+ F8FC 21 27 F7         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
2055+ F8FF 18 12            JR .lhsLoad
2056+ F901              .lhsWBase:
2057+ F901 21 D5 F6         LD HL, BgGfx_arrow_2x2_west
2058+ F904 18 0D            JR .lhsLoad
2059+ F906              .lhsE:
2060+ F906 79               LD A, C
2061+ F907 FE 07            CP 7
2062+ F909 30 05            JR NC, .lhsEBase
2063+ F90B 21 62 F7         LD HL, BgGfx_arrow_2x3_east
2064+ F90E 18 03            JR .lhsLoad
2065+ F910              .lhsEBase:
2066+ F910 21 FE F6         LD HL, BgGfx_arrow_2x2_east
2067+ F913              .lhsLoad:
2068+ F913 3E 03            LD A, 3                             ; bank 3 (bg_gfx.asm)
2069+ F915 C3 CA 67         JP LoadBgSpriteToBuffer             ; tail call (preserva BC)
2070+ F918
2071+ F918              ; Sprite ptrs ordenados por PathDir: 0=N, 1=S, 2=W, 3=E. 16x16 = 2x2 chars.
2072+ F918              ; Los labels los crea inject_pickup_sprites.py si no estan placed.
2073+ F918              HintArrowPtrs:
2074+ F918 83 F6            DEFW BgGfx_arrow_2x2_north          ; 0 = N (id 42)
2075+ F91A AC F6            DEFW BgGfx_arrow_2x2_south          ; 1 = S (id 49)
2076+ F91C D5 F6            DEFW BgGfx_arrow_2x2_west           ; 2 = W (id 80)
2077+ F91E FE F6            DEFW BgGfx_arrow_2x2_east           ; 3 = E (id 82)
2078+ F920
2079+ F920              ; Cache: ultima posicion dibujada (para erase + skip-no-op). 4 B en bank 0.
2080+ F920 FF           HintLastDir:        DEFB $FF            ; $FF = nada dibujado
2081+ F921 00           HintLastCoord:      DEFB 0
2082+ F922 FF           HintLastScreenX:    DEFB $FF
2083+ F923 FF           HintLastScreenY:    DEFB $FF
