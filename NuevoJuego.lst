 203+ 6AC3 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 6AC5 47               LD B, A                         ; B = H (outer loop)
 205+ 6AC6              .lbsPixRow:
 206+ 6AC6 3A 1D 6B         LD A, (.lbsWsave)
 207+ 6AC9 B7               OR A
 208+ 6ACA 28 08            JR Z, .lbsPixRowDone
 209+ 6ACC 4F               LD C, A                         ; C = W (inner loop)
 210+ 6ACD              .lbsPixCol:
 211+ 6ACD 7E               LD A, (HL)
 212+ 6ACE 12               LD (DE), A
 213+ 6ACF 23               INC HL
 214+ 6AD0 13               INC DE
 215+ 6AD1 0D               DEC C
 216+ 6AD2 20 F9            JR NZ, .lbsPixCol
 217+ 6AD4              .lbsPixRowDone:
 218+ 6AD4 10 F0            DJNZ .lbsPixRow
 219+ 6AD6              .lbsAfterPixels:
 220+ 6AD6                  ; --- Copiar 1 byte tint ---
 221+ 6AD6 7E               LD A, (HL)
 222+ 6AD7 12               LD (DE), A
 223+ 6AD8 23               INC HL
 224+ 6AD9 13               INC DE
 225+ 6ADA                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 226+ 6ADA 7E               LD A, (HL)
 227+ 6ADB 12               LD (DE), A
 228+ 6ADC 32 1C 6B         LD (.lbsHsave), A               ; reusar var
 229+ 6ADF 23               INC HL
 230+ 6AE0 13               INC DE
 231+ 6AE1 7E               LD A, (HL)
 232+ 6AE2 12               LD (DE), A
 233+ 6AE3 32 1D 6B         LD (.lbsWsave), A
 234+ 6AE6 23               INC HL
 235+ 6AE7 13               INC DE
 236+ 6AE8 3A 1C 6B         LD A, (.lbsHsave)
