4871+ B9DC              .setDY:
4872+ B9DC DD 77 07         LD (IX+ENT_DELTAY), A
4873+ B9DF                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4874+ B9DF                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4875+ B9DF                  ; identicas y las nasties van en paralelo solapadas.
4876+ B9DF DD 7E 06         LD A, (IX+ENT_DELTAX)
4877+ B9E2 E6 80            AND $80                             ; bit 7 = signo X
4878+ B9E4 47               LD B, A
4879+ B9E5 DD 7E 07         LD A, (IX+ENT_DELTAY)
4880+ B9E8 E6 80            AND $80                             ; bit 7 = signo Y
4881+ B9EA 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4882+ B9EB B0               OR B                                ; A = signX(7) | signY(6)
4883+ B9EC 47               LD B, A
4884+ B9ED 3A FB 82         LD A, (LastSpawnDirSigns)
4885+ B9F0 B8               CP B
4886+ B9F1 20 0C            JR NZ, .spawnDirOk
