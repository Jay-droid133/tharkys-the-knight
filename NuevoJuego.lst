 378+ 728F 70               LD (HL), B                          ; charX
 379+ 7290 23               INC HL
 380+ 7291 71               LD (HL), C                          ; charY
 381+ 7292 21 AB 5F         LD HL, RandomSlotCount
 382+ 7295 34               INC (HL)
 383+ 7296 E1               POP HL                              ; HL @ charY
 384+ 7297 23               INC HL                              ; HL @ v
 385+ 7298 23               INC HL                              ; HL @ next id
 386+ 7299 18 D7            JR .urpScanLoop
 387+ 729B              .urpSkipEntry:
 388+ 729B                  ; Skip entry: 4 bytes (id, charX, charY, v).
 389+ 729B 23               INC HL
 389+ 729C 23             INC HL
 389+ 729D 23             INC HL
 389+ 729E 23             INC HL
 390+ 729F 18 D1            JR .urpScanLoop
