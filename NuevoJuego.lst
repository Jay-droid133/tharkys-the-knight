 184+ 9D58 ED 79            OUT (C), A
 185+ 9D5A 01 FD BF         LD BC, $BFFD
 186+ 9D5D AF               XOR A
 187+ 9D5E ED 79            OUT (C), A
 188+ 9D60                  ; R10 = 0 (silenciar canal C)
 189+ 9D60 3E 0A            LD A, 10
 190+ 9D62 01 FD FF         LD BC, $FFFD
 191+ 9D65 ED 79            OUT (C), A
 192+ 9D67 01 FD BF         LD BC, $BFFD
 193+ 9D6A AF               XOR A
 194+ 9D6B ED 79            OUT (C), A
 195+ 9D6D                  ; R7 = $3E (mixer: solo tono A activo)
 196+ 9D6D 3E 07            LD A, 7
 197+ 9D6F 01 FD FF         LD BC, $FFFD
 198+ 9D72 ED 79            OUT (C), A
 199+ 9D74 01 FD BF         LD BC, $BFFD
 200+ 9D77 3E 3E            LD A, $3E
 201+ 9D79 ED 79            OUT (C), A
 202+ 9D7B                  ; R8 = 13 (volumen A alto)
 203+ 9D7B 3E 08            LD A, 8
 204+ 9D7D 01 FD FF         LD BC, $FFFD
 205+ 9D80 ED 79            OUT (C), A
 206+ 9D82 01 FD BF         LD BC, $BFFD
 207+ 9D85 3E 0D            LD A, 13
 208+ 9D87 ED 79            OUT (C), A
 209+ 9D89                  ; --- Busy loop B × ~12.4ms ---
 210+ 9D89              .aypbOuter:
 211+ 9D89 21 80 06         LD HL, $0680                ; ~1664 inner iters
 212+ 9D8C              .aypbInner:
 213+ 9D8C 2B               DEC HL
 214+ 9D8D 7C               LD A, H
 215+ 9D8E B5               OR L
 216+ 9D8F 20 FB            JR NZ, .aypbInner
 217+ 9D91 10 F6            DJNZ .aypbOuter
 218+ 9D93                  ; --- Silenciar canal A (volumen 0) ---
 219+ 9D93 3E 08            LD A, 8
 220+ 9D95 01 FD FF         LD BC, $FFFD
 221+ 9D98 ED 79            OUT (C), A
 222+ 9D9A 01 FD BF         LD BC, $BFFD
 223+ 9D9D AF               XOR A
 224+ 9D9E ED 79            OUT (C), A
 225+ 9DA0 FB               EI
 226+ 9DA1 C9               RET
 227+ 9DA2
 228+ 9DA2              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 229+ 9DA2              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 230+ 9DA2              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 231+ 9DA2              ;
 232+ 9DA2              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 233+ 9DA2              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 234+ 9DA2              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 235+ 9DA2              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 236+ 9DA2              StartMusic:
 237+ 9DA2 32 C7 9D         LD (MusicTrackArg), A
 238+ 9DA5 F3               DI
 239+ 9DA6 3A C9 90         LD A, (CurrentPaging)
 240+ 9DA9 E6 F8            AND $F8
 241+ 9DAB F6 04            OR 4
 242+ 9DAD 32 C9 90         LD (CurrentPaging), A
 243+ 9DB0 01 FD 7F         LD BC, $7FFD
 244+ 9DB3 ED 79            OUT (C), A
 245+ 9DB5 CD 0B E6         CALL StartMusicImpl
 246+ 9DB8 3A C9 90         LD A, (CurrentPaging)
 247+ 9DBB E6 F8            AND $F8
 248+ 9DBD 32 C9 90         LD (CurrentPaging), A
 249+ 9DC0 01 FD 7F         LD BC, $7FFD
 250+ 9DC3 ED 79            OUT (C), A
 251+ 9DC5 FB               EI
 252+ 9DC6 C9               RET
 253+ 9DC7
 254+ 9DC7              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 255+ 9DC7              ; desde el Impl en bank 4 sin trampa de paging.
 256+ 9DC7 00           MusicTrackArg: DEFB 0
 257+ 9DC8
 258+ 9DC8              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 259+ 9DC8              ; transiciones de pantalla u otros frames lentos) ---
 260+ 9DC8              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 261+ 9DC8              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 262+ 9DC8              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 263+ 9DC8              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 264+ 9DC8              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 265+ 9DC8              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 266+ 9DC8              ; tick daria 0, drift acumulando.
 267+ 9DC8 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 268+ 9DC9 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 269+ 9DCA
# file closed: ay_sound_thunks.asm
 330  9DCA                  INCLUDE "engine_graphics.asm"
# file opened: engine_graphics.asm
   1+ 9DCA              ; ==============================================================================
   2+ 9DCA              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 9DCA              ; ==============================================================================
   4+ 9DCA              ; Sistema fiel a Sabre Wulf:
   5+ 9DCA              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 9DCA              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 9DCA              ; - NextPixelLine para cruzar character rows y tercios
   8+ 9DCA              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 9DCA              ; ==============================================================================
  10+ 9DCA
  11+ 9DCA              ClearScreen:
  12+ 9DCA CD AF 0D         CALL ROM_CLS
  13+ 9DCD C9               RET
  14+ 9DCE
  15+ 9DCE              ; ==============================================================================
  16+ 9DCE              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9DCE              ; ==============================================================================
  18+ 9DCE              ; Entrada:
  19+ 9DCE              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9DCE              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9DCE              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9DCE              ;
  23+ 9DCE              ; Formato del sprite:
  24+ 9DCE              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9DCE              ;   DEFB height_pixels
  26+ 9DCE              ;   DEFB pixel_data... (width * height bytes)
  27+ 9DCE              ;
  28+ 9DCE              ; Dos paths:
  29+ 9DCE              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9DCE              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9DCE              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9DCE              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9DCE              ;
  34+ 9DCE              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9DCE              ;
  36+ 9DCE              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9DCE              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9DCE              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9DCE              ; alto la restauracion del bank.
  40+ 9DCE              ; ==============================================================================
  41+ 9DCE              DrawSprite:
  42+ 9DCE                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9DCE                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9DCE                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9DCE 3A C9 90         LD A, (CurrentPaging)
  46+ 9DD1 E6 F8            AND $F8
  47+ 9DD3 F6 06            OR 6
  48+ 9DD5 32 C9 90         LD (CurrentPaging), A
  49+ 9DD8 01 FD 7F         LD BC, $7FFD
  50+ 9DDB ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9DDD CD EE 9D         CALL _DrawSpriteImpl
  52+ 9DE0                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9DE0                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9DE0 3A C9 90         LD A, (CurrentPaging)
  55+ 9DE3 E6 F8            AND $F8
  56+ 9DE5 32 C9 90         LD (CurrentPaging), A
  57+ 9DE8 01 FD 7F         LD BC, $7FFD
  58+ 9DEB ED 79            OUT (C), A
  59+ 9DED C9               RET
  60+ 9DEE
  61+ 9DEE              _DrawSpriteImpl:
  62+ 9DEE                  ; Guardar posicion
  63+ 9DEE 7A               LD A, D
  64+ 9DEF 32 A8 9E         LD (.posY), A
  65+ 9DF2 7B               LD A, E
  66+ 9DF3 32 A7 9E         LD (.posX), A
  67+ 9DF6
  68+ 9DF6                  ; Leer cabecera sprite
  69+ 9DF6 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9DF9 32 A9 9E         LD (.widthSave), A
  71+ 9DFC DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9DFF 32 AA 9E         LD (.heightSave), A
  73+ 9E02 DD 23            INC IX
  74+ 9E04 DD 23            INC IX                      ; IX → pixel data
  75+ 9E06
  76+ 9E06                  ; === Y CLIPPING ===
  77+ 9E06                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9E06 3A A8 9E         LD A, (.posY)
  79+ 9E09 FE 10            CP SCREEN_MIN_Y
  80+ 9E0B 30 20            JR NC, .clipTopDone
  81+ 9E0D                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9E0D 47               LD B, A                     ; B = Y
  83+ 9E0E 3E 10            LD A, SCREEN_MIN_Y
  84+ 9E10 90               SUB B                       ; A = filas a saltar
  85+ 9E11 47               LD B, A                     ; B = skip rows
  86+ 9E12                  ; Reducir altura
  87+ 9E12 3A AA 9E         LD A, (.heightSave)
  88+ 9E15 90               SUB B
  89+ 9E16 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9E17 D8               RET C                       ; Idem
  91+ 9E18 32 AA 9E         LD (.heightSave), A
  92+ 9E1B                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9E1B 3A A9 9E         LD A, (.widthSave)
  94+ 9E1E 4F               LD C, A
  95+ 9E1F              .clipSkipRow:
  96+ 9E1F 79               LD A, C
  97+ 9E20              .clipSkipByte:
  98+ 9E20 DD 23            INC IX
  99+ 9E22 3D               DEC A
 100+ 9E23 20 FB            JR NZ, .clipSkipByte
 101+ 9E25 10 F8            DJNZ .clipSkipRow
 102+ 9E27                  ; Ajustar Y al borde
 103+ 9E27 3E 10            LD A, SCREEN_MIN_Y
 104+ 9E29 32 A8 9E         LD (.posY), A
 105+ 9E2C 57               LD D, A
 106+ 9E2D              .clipTopDone:
 107+ 9E2D                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9E2D 3A A8 9E         LD A, (.posY)
 109+ 9E30 47               LD B, A
 110+ 9E31 3A AA 9E         LD A, (.heightSave)
 111+ 9E34 80               ADD A, B                    ; A = Y + height
 112+ 9E35 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9E37 FE C0            CP 192
 114+ 9E39 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9E3B              .clipBot:
 116+ 9E3B                  ; Reducir altura: new_height = 192 - Y
 117+ 9E3B 3E C0            LD A, 192
 118+ 9E3D 90               SUB B                       ; A = 192 - Y
 119+ 9E3E C8               RET Z
 120+ 9E3F D8               RET C
 121+ 9E40 32 AA 9E         LD (.heightSave), A
 122+ 9E43              .clipBotDone:
 123+ 9E43
 124+ 9E43                  ; Comprobar alineacion
 125+ 9E43 7B               LD A, E
 126+ 9E44 E6 07            AND 7
 127+ 9E46 20 1E            JR NZ, .shifted
 128+ 9E48
 129+ 9E48                  ; ==================================================================
 130+ 9E48                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9E48                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9E48                  ; ==================================================================
 133+ 9E48 CD 41 A1         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9E4B DD E5            PUSH IX
 135+ 9E4D D1               POP DE                      ; DE = puntero a pixel data
 136+ 9E4E 3A AA 9E         LD A, (.heightSave)
 137+ 9E51 4F               LD C, A                     ; C = height counter
 138+ 9E52
 139+ 9E52              .alignedLine:
 140+ 9E52 3A A9 9E         LD A, (.widthSave)
 141+ 9E55 47               LD B, A                     ; B = ancho en bytes
 142+ 9E56 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9E57
 144+ 9E57              .alignedByte:
 145+ 9E57 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9E58 AE               XOR (HL)
 147+ 9E59 77               LD (HL), A
 148+ 9E5A 23               INC HL                      ; Siguiente columna VRAM
 149+ 9E5B 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9E5C 10 F9            DJNZ .alignedByte
 151+ 9E5E
 152+ 9E5E E1               POP HL                      ; Restaurar inicio de linea
 153+ 9E5F 0D               DEC C
 154+ 9E60 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9E61 CD AD 9E         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9E64 18 EC            JR .alignedLine
 157+ 9E66
 158+ 9E66                  ; ==================================================================
 159+ 9E66                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9E66                  ; ==================================================================
 161+ 9E66                  ; A = shift amount (1-7) al llegar aqui
 162+ 9E66              .shifted:
 163+ 9E66                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9E66 3D               DEC A                       ; 0-6
 165+ 9E67 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9E68 E6 0E            AND $0E
 167+ 9E6A C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9E6C 32 AB 9E         LD (.tablePage), A
 169+ 9E6F
 170+ 9E6F                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9E6F DD E5            PUSH IX
 172+ 9E71 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9E72 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9E73
 175+ 9E73                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9E73 3A A8 9E         LD A, (.posY)
 177+ 9E76 57               LD D, A
 178+ 9E77 3A A7 9E         LD A, (.posX)
 179+ 9E7A 5F               LD E, A
 180+ 9E7B CD 41 A1         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9E7E
 182+ 9E7E D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9E7F 3A AB 9E         LD A, (.tablePage)
 184+ 9E82 47               LD B, A                     ; B = pagina high part
 185+ 9E83                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9E83                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9E83 3A AA 9E         LD A, (.heightSave)
 188+ 9E86 DD 67            LD IXH, A
 189+ 9E88
 190+ 9E88              .shiftedLine:
 191+ 9E88 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9E89 3A A9 9E         LD A, (.widthSave)
 193+ 9E8C DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9E8E
 195+ 9E8E              .shiftedByte:
 196+ 9E8E                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9E8E 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9E8F 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9E90 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9E91 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9E92 77               LD (HL), A                  ; Escribir
 202+ 9E93 2C               INC L                       ; Siguiente columna VRAM
 203+ 9E94 04               INC B                       ; Pagina overflow
 204+ 9E95 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9E96 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9E97 77               LD (HL), A                  ; Escribir
 207+ 9E98 05               DEC B                       ; Restaurar pagina high
 208+ 9E99 13               INC DE                      ; Siguiente byte de sprite
 209+ 9E9A                  ; Siguiente byte de ancho
 210+ 9E9A DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9E9C 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9E9E
 213+ 9E9E E1               POP HL                      ; Restaurar inicio de linea
 214+ 9E9F DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9EA1 C8               RET Z                       ; Terminamos todas las lineas
 216+ 9EA2 CD AD 9E         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9EA5 18 E1            JR .shiftedLine
 218+ 9EA7
 219+ 9EA7              ; Variables locales de DrawSprite
 220+ 9EA7 00           .posX:       DEFB 0
 221+ 9EA8 00           .posY:       DEFB 0
 222+ 9EA9 00           .widthSave:  DEFB 0
 223+ 9EAA 00           .heightSave: DEFB 0
 224+ 9EAB 00           .tablePage:  DEFB 0
 225+ 9EAC 00           .widthCount: DEFB 0
 226+ 9EAD
 227+ 9EAD              ; ==============================================================================
 228+ 9EAD              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9EAD              ; ==============================================================================
 230+ 9EAD              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9EAD              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9EAD              ;
 233+ 9EAD              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9EAD              ; ==============================================================================
 235+ 9EAD              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9EAD              NextPixelLine:
 237+ 9EAD 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9EAE 7C               LD A, H
 239+ 9EAF E6 07            AND 7
 240+ 9EB1 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9EB2
 242+ 9EB2                  ; --- Cruce de character row ---
 243+ 9EB2 7D               LD A, L
 244+ 9EB3 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9EB5 6F               LD L, A
 246+ 9EB6 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9EB8 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9EB9
 249+ 9EB9                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9EB9 7C               LD A, H
 251+ 9EBA D6 08            SUB 8
 252+ 9EBC 67               LD H, A
 253+ 9EBD C9               RET
 254+ 9EBE
 255+ 9EBE              ; ==============================================================================
 256+ 9EBE              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9EBE              ; ==============================================================================
 258+ 9EBE              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9EBE              ; Entrada:
 260+ 9EBE              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9EBE              ;   A = atributo a pintar
 262+ 9EBE              ; ==============================================================================
 263+ 9EBE              SetEntityAttr:
 264+ 9EBE F5               PUSH AF                     ; Guardar atributo
 265+ 9EBF CD 26 A1         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9EC2 F1               POP AF
 267+ 9EC3
 268+ 9EC3 47               LD B, A                     ; B = atributo (preservar)
 269+ 9EC4 3A BD 9F         LD A, (EntityAttrH)
 270+ 9EC7 4F               LD C, A                     ; C = filas
 271+ 9EC8              .rowLoop:
 272+ 9EC8                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9EC8 E5               PUSH HL
 274+ 9EC9 7C               LD A, H
 275+ 9ECA FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9ECC 20 08            JR NZ, .rowNotHud
 277+ 9ECE 7D               LD A, L
 278+ 9ECF FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9ED1 30 03            JR NC, .rowNotHud
 280+ 9ED3                  ; Fila en HUD → saltar sin pintar
 281+ 9ED3 E1               POP HL
 282+ 9ED4 18 0B            JR .rowSkip
 283+ 9ED6              .rowNotHud:
 284+ 9ED6 E1               POP HL
 285+ 9ED7 3A BC 9F         LD A, (EntityAttrW)
 286+ 9EDA E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9EDB                  ; Pintar una fila
 288+ 9EDB              .colLoop:
 289+ 9EDB 70               LD (HL), B
 290+ 9EDC 23               INC HL
 291+ 9EDD 3D               DEC A
 292+ 9EDE 20 FB            JR NZ, .colLoop
 293+ 9EE0 E1               POP HL
 294+ 9EE1              .rowSkip:
 295+ 9EE1                  ; Siguiente fila: HL += 32
 296+ 9EE1 D5               PUSH DE
 297+ 9EE2 11 20 00         LD DE, 32
 298+ 9EE5 19               ADD HL, DE
 299+ 9EE6 D1               POP DE
 300+ 9EE7 0D               DEC C
 301+ 9EE8 20 DE            JR NZ, .rowLoop
 302+ 9EEA C9               RET
 303+ 9EEB
 304+ 9EEB              ; ==============================================================================
 305+ 9EEB              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9EEB              ; ==============================================================================
 307+ 9EEB              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9EEB              ; Se llama ANTES de pintar el sprite.
 309+ 9EEB              ;
 310+ 9EEB              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9EEB              ;          IX = puntero al sprite (para leer width/height)
 312+ 9EEB              ; ==============================================================================
 313+ 9EEB              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9EEB              ; ==============================================================================
 315+ 9EEB              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9EEB              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9EEB              ; ==============================================================================
 318+ 9EEB              CalcEntityAttrSize:
 319+ 9EEB                  ; Paging inline (ver nota en DrawSprite)
 320+ 9EEB 3A C9 90         LD A, (CurrentPaging)
 321+ 9EEE E6 F8            AND $F8
 322+ 9EF0 F6 06            OR 6
 323+ 9EF2 32 C9 90         LD (CurrentPaging), A
 324+ 9EF5 01 FD 7F         LD BC, $7FFD
 325+ 9EF8 ED 79            OUT (C), A
 326+ 9EFA CD 0B 9F         CALL _CalcEntityAttrSizeImpl
 327+ 9EFD 3A C9 90         LD A, (CurrentPaging)
 328+ 9F00 E6 F8            AND $F8
 329+ 9F02 32 C9 90         LD (CurrentPaging), A
 330+ 9F05 01 FD 7F         LD BC, $7FFD
 331+ 9F08 ED 79            OUT (C), A
 332+ 9F0A C9               RET
 333+ 9F0B
 334+ 9F0B              _CalcEntityAttrSizeImpl:
 335+ 9F0B DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9F0E 47               LD B, A
 337+ 9F0F 7B               LD A, E
 338+ 9F10 E6 07            AND 7
 339+ 9F12 28 01            JR Z, .ceNoExtra
 340+ 9F14 04               INC B
 341+ 9F15              .ceNoExtra:
 342+ 9F15 78               LD A, B
 343+ 9F16 32 BC 9F         LD (EntityAttrW), A
 344+ 9F19 7A               LD A, D
 345+ 9F1A E6 07            AND 7
 346+ 9F1C 4F               LD C, A
 347+ 9F1D DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9F20 81               ADD A, C
 349+ 9F21 C6 07            ADD A, 7
 350+ 9F23 0F               RRCA
 351+ 9F24 0F               RRCA
 352+ 9F25 0F               RRCA
 353+ 9F26 E6 1F            AND $1F
 354+ 9F28 32 BD 9F         LD (EntityAttrH), A
 355+ 9F2B C9               RET
