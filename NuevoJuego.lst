 130  6277                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 6277              ; ==============================================================================
   2+ 6277              ; town_gate_cutscene.asm - Funciones COMPARTIDAS slot 1 (resto en bank 7)
   3+ 6277              ; ==============================================================================
   4+ 6277              ; Tras commit "town_gate to bank 7", el body de la cinematica M11 (puerta
   5+ 6277              ; final del juego) vive en bank 7 (town_gate_cutscene_bank7.asm). Aqui
   6+ 6277              ; quedan solo las funciones que tienen que vivir en slot 1 always-visible
   7+ 6277              ; por dos razones:
   8+ 6277              ;
   9+ 6277              ;   1. Son llamadas por bank_cutscene.asm (que tambien vive en bank 7).
  10+ 6277              ;      Si vivieran en bank 7, el body bank_cutscene las llamaria via thunks
  11+ 6277              ;      _B7, pero esas son INTERNALMENTE problematicas porque al pasar por
  12+ 6277              ;      bank 0 paginated invalidaria el stack frame del caller bank 7.
  13+ 6277              ;        - KillDeathIfActive
  14+ 6277              ;        - TownGateAllNastiesDeadCheck
  15+ 6277              ;        - TownGateRedrawPlayer / TownGateErasePlayer / TownGateDrawPlayerHere
  16+ 6277              ;
  17+ 6277              ;   2. Paginan slot 3 internamente (LD CurrentPaging + OUT). Si vivieran
  18+ 6277              ;      en bank 7, el OUT que cambia slot 3 a bank 6 haria desaparecer el
  19+ 6277              ;      codigo bajo sus pies -> crash inmediato.
  20+ 6277              ;        - TownGatePlayerSlideErase / TownGatePlayerSlideDraw
  21+ 6277              ;        - TownGatePlayerXOR_BiClip (no pagina pero la llaman las Slide*)
  22+ 6277              ;
  23+ 6277              ; El body bank 7 (entry thunks CheckTownGateTriggerBg / UpdateTownGateCutscene
  24+ 6277              ; en bank_cutscene_thunks.asm) llama a estas via:
  25+ 6277              ;   - JP/CALL directo (slot 1 always-visible, sin paging) cuando la rutina
  26+ 6277              ;     no toca paging (TownGateAllNastiesDeadCheck, BiClip).
  27+ 6277              ;   - Thunks _B7 con post-page-back (KillDeathIfActive_B7,
  28+ 6277              ;     TownGateRedrawPlayer_B7, TownGatePlayerSlideErase_B7, etc.) cuando la
  29+ 6277              ;     rutina paginate slot 3 internamente.
  30+ 6277              ; ==============================================================================
  31+ 6277
  32+ 6277              ; --- Constantes usadas por TownGatePlayerXOR_BiClip (compartidas con el body
  33+ 6277              ;     bank 7 que las redefine localmente — sjasmplus las acepta como EQU
  34+ 6277              ;     siempre que el valor coincida). ---
  35+ 6277              ; TGCS_ARCH_PX_TOP / BOTTOM tambien viven en town_gate_cutscene_bank7.asm
  36+ 6277              ; con el mismo valor — sjasmplus emite error si difieren. Mantener sincronizado.
  37+ 6277              PLAYER_H_PX              EQU 21
  38+ 6277
  39+ 6277              ; ==============================================================================
  40+ 6277              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
  41+ 6277              ; ==============================================================================
  42+ 6277              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING con
  43+ 6277              ; SPRID_PUFF. Llamado por StartBankCutscene (bank 7) via KillDeathIfActive_B7
  44+ 6277              ; thunk y por StartTownGateCutscene (bank 7) tambien via _B7.
  45+ 6277              ; ==============================================================================
  46+ 6277              KillDeathIfActive:
  47+ 6277 DD 21 50 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
  48+ 627B DD 7E 01         LD A, (IX+ENT_TYPE)
  49+ 627E B7               OR A
  50+ 627F C8               RET Z                               ; muerte ya inactiva
  51+ 6280 DD 7E 02         LD A, (IX+ENT_STATE)
  52+ 6283 FE 03            CP STATE_DYING
  53+ 6285 C8               RET Z                               ; ya muriendo
  54+ 6286 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
  55+ 628A DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
  56+ 628E DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
  57+ 6292 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
  58+ 6296 DD 36 06 00      LD (IX+ENT_DELTAX), 0
  59+ 629A DD 36 07 00      LD (IX+ENT_DELTAY), 0
  60+ 629E DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
  61+ 62A2                  ; Death se va con puff -> parar musica de la muerte. $FD = stop-if-loopable.
  62+ 62A2 3E FD            LD A, $FD
  63+ 62A4 C3 BF 99         JP StartMusic
  64+ 62A7
  65+ 62A7              ; ==============================================================================
  66+ 62A7              ; TownGateDrawPlayerHere - draw + attrs del player en (DRAWX, PlayerDrawY)
  67+ 62A7              ; ==============================================================================
  68+ 62A7              TownGateDrawPlayerHere:
  69+ 62A7 DD 21 A0 81      LD IX, EntityTable
  70+ 62AB DD E5            PUSH IX
  71+ 62AD CD EF A4         CALL GetSpriteAddr
  72+ 62B0 DD E1            POP IX
  73+ 62B2 3A E1 82         LD A, (PlayerDrawY)
  74+ 62B5 57               LD D, A
  75+ 62B6 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  76+ 62B9 5F               LD E, A
  77+ 62BA DD E5            PUSH IX
  78+ 62BC DD 2A 1E A5      LD IX, (SpriteAddrTemp)
  79+ 62C0 CD EC 99         CALL DrawSprite
  80+ 62C3 DD E1            POP IX
  81+ 62C5 3A E1 82         LD A, (PlayerDrawY)
  82+ 62C8 57               LD D, A
  83+ 62C9 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  84+ 62CC 5F               LD E, A
  85+ 62CD DD E5            PUSH IX
  86+ 62CF DD 2A 1E A5      LD IX, (SpriteAddrTemp)
  87+ 62D3 CD 09 9B         CALL CalcEntityAttrSize
  88+ 62D6 DD E1            POP IX
  89+ 62D8 3A E1 82         LD A, (PlayerDrawY)
  90+ 62DB 57               LD D, A
  91+ 62DC DD 7E 0F         LD A, (IX+ENT_DRAWX)
  92+ 62DF 5F               LD E, A
  93+ 62E0 DD 7E 05         LD A, (IX+ENT_ATTR)
  94+ 62E3 CD DC 9A         CALL SetEntityAttr
  95+ 62E6 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  96+ 62E9 DD 77 0C         LD (IX+ENT_OLDX), A
  97+ 62EC 3A E1 82         LD A, (PlayerDrawY)
  98+ 62EF DD 77 0D         LD (IX+ENT_OLDY), A
  99+ 62F2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 100+ 62F5 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 101+ 62F8 C9               RET
 102+ 62F9
 103+ 62F9              ; ==============================================================================
 104+ 62F9              ; TownGateRedrawPlayer - erase old + draw new
 105+ 62F9              ; ==============================================================================
 106+ 62F9              TownGateRedrawPlayer:
 107+ 62F9 CD FF 62         CALL TownGateErasePlayer
 108+ 62FC C3 A7 62         JP TownGateDrawPlayerHere
