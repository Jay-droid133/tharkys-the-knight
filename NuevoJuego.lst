1170+ A555              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1171+ A555              ; ==============================================================================
1172+ A555              ; Entrada: A = SpriteID
1173+ A555              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1174+ A555              ; Destruye: A, DE, HL
1175+ A555              ; ==============================================================================
1176+ A555              GetSpriteDims:
1177+ A555                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1178+ A555                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1179+ A555 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1180+ A556 26 00            LD H, 0
1181+ A558 3A 8A 8D         LD A, (CurrentPaging)
1182+ A55B E6 F8            AND $F8
1183+ A55D F6 06            OR 6
