 766+ F278              .dcDrawDone:
 767+ F278
 768+ F278                  ; --- Cachear estado ---
 769+ F278                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 770+ F278                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 771+ F278                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 772+ F278                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 773+ F278                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 774+ F278                  ; el wobble y la comparacion sigue siendo correcta.
 775+ F278 3A BF 82         LD A, (CompassWobbleCounter)
 776+ F27B B7               OR A
 777+ F27C 20 06            JR NZ, .dcSkipPrevDistSave
 778+ F27E 3A 92 F2         LD A, (.dcDistance)
 779+ F281 32 BC 82         LD (PreviousObjectiveDistance), A
 780+ F284              .dcSkipPrevDistSave:
 781+ F284 3A 0A 83         LD A, (CurrentScreenX)
 782+ F287 32 BD 82         LD (LastCompassScreenX), A
