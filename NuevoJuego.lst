 560+ E834
 561+ E834              ; TownGateDrawPlayerHere / TownGateRedrawPlayer / TownGateErasePlayer:
 562+ E834              ; viven en slot 1 (town_gate_cutscene.asm) — llamadas por bank_cutscene via
 563+ E834              ; TownGateRedrawPlayer_B7. Aqui las omitimos para evitar duplicacion.
 564+ E834
 565+ E834              ; ==============================================================================
 566+ E834              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 567+ E834              ; ==============================================================================
 568+ E834              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 569+ E834              ;    al haberse dibujado ya en el render normal de la sala).
 570+ E834              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 571+ E834              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 572+ E834              ; Bank 3 para ambos (sprites baseline town).
 573+ E834              ; Destruye: AF, BC, DE, HL, IX.
 574+ E834              ; ==============================================================================
 575+ E834              TownGateOpenDoor:
 576+ E834 11 C4 E2         LD DE, BgGfx_town_gate_door_closed_v2
 577+ E837 CD 3B 6D         CALL RedrawPickupByPtr_B7               ; XOR-erase del closed
 578+ E83A                  ; Fall-through a TownGateRedrawOpenDoor
 579+ E83A
 580+ E83A              ; ==============================================================================
 581+ E83A              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 582+ E83A              ; ==============================================================================
 583+ E83A              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 584+ E83A              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 585+ E83A              ; el open door restaura attrs originales en sus 4 cols + pixels.
 586+ E83A              ; ==============================================================================
 587+ E83A              TownGateRedrawOpenDoor:
 588+ E83A 21 83 E6         LD HL, BgGfx_town_gate_door_open
 589+ E83D 3E 03            LD A, 3
 590+ E83F CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 591+ E842 DD 21 FD 86      LD IX, BgSpriteBuffer
 592+ E846 06 0E            LD B, TGCS_DOOR_CHARX
 593+ E848 0E 11            LD C, TGCS_DOOR_CHARY
 594+ E84A                  ; BgSpriteIsHouse=0, CurrentTintVar=0 escritas dentro de DrawBgGfxSpriteBlackTint_B7
 595+ E84A                  ; (esas vars viven en bank 0, no se pueden escribir desde bank 7 sin paginar).
 596+ E84A C3 BC 6D         JP DrawBgGfxSpriteBlackTint_B7
 597+ E84D
 598+ E84D              ; TownGateAllNastiesDeadCheck: vive en slot 1 (town_gate_cutscene.asm) —
 599+ E84D              ; llamada por bank_cutscene directamente (CALL TownGateAllNastiesDeadCheck).
 600+ E84D              ; Es safe sin _B7 wrap porque NO toca paging.
 601+ E84D
 602+ E84D              ; TownGatePlayerXOR_BiClip: vive en slot 1 (usada por TownGatePlayerSlideErase
 603+ E84D              ; y SlideDraw que viven en slot 1). El body bank 7 no la llama directamente.
 604+ E84D
 605+ E84D              ; TownGatePlayerSlideErase / SlideDraw: viven en slot 1 (paginan bank 6
 606+ E84D              ; internamente con OUT, no se pueden mover a bank 7 sin reorganizacion mayor).
 607+ E84D              ; El body bank 7 las llama via TownGatePlayerSlideErase_B7 / SlideDraw_B7.
 608+ E84D
 609+ E84D              ; ==============================================================================
 610+ E84D              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 611+ E84D              ; ==============================================================================
 612+ E84D              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 613+ E84D              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 614+ E84D              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 615+ E84D              ; 2. Compute new offset random.
 616+ E84D              ; 3. Draw at new offset.
 617+ E84D              ; Destruye: AF, BC, DE, HL, IX.
 618+ E84D              ; ==============================================================================
 619+ E84D              TownGateShakeStep:
 620+ E84D CD 95 E8         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 621+ E850 CD B0 E8         CALL TownGateDrawFingerShifted
 622+ E853                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 623+ E853 ED 5F            LD A, R
 624+ E855 E6 03            AND $03
 625+ E857 21 78 E8         LD HL, .tgssJitterTable
 626+ E85A 5F               LD E, A
 627+ E85B 16 00            LD D, 0
 628+ E85D 19               ADD HL, DE
 629+ E85E 7E               LD A, (HL)
 630+ E85F 32 A6 5F         LD (TownGateShakeOffsX), A
 631+ E862 3A A0 81         LD A, (GameFrameCounter)
 632+ E865 E6 03            AND $03
 633+ E867 21 78 E8         LD HL, .tgssJitterTable
 634+ E86A 5F               LD E, A
 635+ E86B 16 00            LD D, 0
 636+ E86D 19               ADD HL, DE
 637+ E86E 7E               LD A, (HL)
 638+ E86F 32 A7 5F         LD (TownGateShakeOffsY), A
 639+ E872 CD 95 E8         CALL TownGateDrawArmShifted          ; draw at new offset
 640+ E875 C3 B0 E8         JP TownGateDrawFingerShifted
 641+ E878              .tgssJitterTable:
 642+ E878 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 643+ E87C
 644+ E87C              ; ==============================================================================
 645+ E87C              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 646+ E87C              ; ==============================================================================
 647+ E87C              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 648+ E87C              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 649+ E87C              ; ==============================================================================
 650+ E87C              TownGateShakeRestore:
 651+ E87C CD 95 E8         CALL TownGateDrawArmShifted          ; erase last shifted
 652+ E87F CD B0 E8         CALL TownGateDrawFingerShifted
 653+ E882 AF               XOR A
 654+ E883 32 A6 5F         LD (TownGateShakeOffsX), A
 655+ E886 32 A7 5F         LD (TownGateShakeOffsY), A
 656+ E889 11 69 E2         LD DE, BgGfx_arm
 657+ E88C CD 3B 6D         CALL RedrawPickupByPtr_B7               ; restore at PickupTable position
 658+ E88F 11 B6 E2         LD DE, BgGfx_finger
 659+ E892 C3 3B 6D         JP RedrawPickupByPtr_B7
 660+ E895
 661+ E895              ; ==============================================================================
 662+ E895              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 663+ E895              ; ==============================================================================
 664+ E895              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 665+ E895              ; Destruye: AF, BC, DE, HL, IX.
 666+ E895              ; ==============================================================================
 667+ E895              TownGateDrawArmShifted:
 668+ E895 21 69 E2         LD HL, BgGfx_arm
 669+ E898 3E 03            LD A, 3
 670+ E89A CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 671+ E89D 3A A6 5F         LD A, (TownGateShakeOffsX)
 672+ E8A0 47               LD B, A
 673+ E8A1 3E 88            LD A, TGCS_ARM_PX_X
 674+ E8A3 80               ADD A, B
 675+ E8A4 5F               LD E, A
 676+ E8A5 3A A7 5F         LD A, (TownGateShakeOffsY)
 677+ E8A8 47               LD B, A
 678+ E8A9 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 679+ E8AB 80               ADD A, B
 680+ E8AC 57               LD D, A
 681+ E8AD C3 CB E8         JP DrawBgSpriteAnyXorAtPixel
 682+ E8B0
 683+ E8B0              ; ==============================================================================
 684+ E8B0              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 685+ E8B0              ; ==============================================================================
 686+ E8B0              TownGateDrawFingerShifted:
 687+ E8B0 21 B6 E2         LD HL, BgGfx_finger
 688+ E8B3 3E 03            LD A, 3
 689+ E8B5 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 690+ E8B8 3A A6 5F         LD A, (TownGateShakeOffsX)
 691+ E8BB 47               LD B, A
 692+ E8BC 3E 88            LD A, TGCS_FINGER_PX_X
 693+ E8BE 80               ADD A, B
 694+ E8BF 5F               LD E, A
 695+ E8C0 3A A7 5F         LD A, (TownGateShakeOffsY)
 696+ E8C3 47               LD B, A
 697+ E8C4 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 698+ E8C6 80               ADD A, B
 699+ E8C7 57               LD D, A
 700+ E8C8 C3 CB E8         JP DrawBgSpriteAnyXorAtPixel
 701+ E8CB
 702+ E8CB              ; ==============================================================================
 703+ E8CB              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 704+ E8CB              ; ==============================================================================
 705+ E8CB              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 706+ E8CB              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 707+ E8CB              ;     E = pixel X (0..255).
 708+ E8CB              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 709+ E8CB              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 710+ E8CB              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 711+ E8CB              ; Destruye: AF, BC, DE, HL, IX.
 712+ E8CB              ; ==============================================================================
 713+ E8CB              DrawBgSpriteAnyXorAtPixel:
 714+ E8CB DD 21 FD 86      LD IX, BgSpriteBuffer
 715+ E8CF DD 7E 00         LD A, (IX+0)                        ; height_px
 716+ E8D2 B7               OR A
 717+ E8D3 C8               RET Z
 718+ E8D4 32 2E E9         LD (.dbsaHeight), A
 719+ E8D7 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 720+ E8DA E6 7F            AND $7F
 721+ E8DC 32 2F E9         LD (.dbsaWidth), A
 722+ E8DF DD 23            INC IX
 723+ E8E1 DD 23            INC IX                              ; -> pixel data
 724+ E8E3 7B               LD A, E
 725+ E8E4 E6 07            AND $07
 726+ E8E6 32 30 E9         LD (.dbsaShift), A
 727+ E8E9 7B               LD A, E
 728+ E8EA E6 F8            AND $F8
 729+ E8EC 5F               LD E, A
 730+ E8ED CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 731+ E8F0              .dbsaRow:
 732+ E8F0 E5               PUSH HL
 733+ E8F1 3A 2F E9         LD A, (.dbsaWidth)
 734+ E8F4 47               LD B, A                             ; B = width counter
 735+ E8F5 0E 00            LD C, 0                             ; C = carry from prev byte
 736+ E8F7              .dbsaByte:
 737+ E8F7 DD 7E 00         LD A, (IX+0)
 738+ E8FA 2F               CPL                                 ; un-invert
 739+ E8FB 57               LD D, A                             ; D = sprite byte
 740+ E8FC 1E 00            LD E, 0                             ; E = bits que caen al next byte
 741+ E8FE 3A 30 E9         LD A, (.dbsaShift)
 742+ E901 B7               OR A
 743+ E902 28 09            JR Z, .dbsaNoShift
 744+ E904 C5               PUSH BC
 745+ E905 47               LD B, A
 746+ E906              .dbsaShiftLoop:
 747+ E906 CB 3A            SRL D
 748+ E908 CB 1B            RR E
 749+ E90A 10 FA            DJNZ .dbsaShiftLoop
 750+ E90C C1               POP BC
 751+ E90D              .dbsaNoShift:
 752+ E90D 7A               LD A, D
 753+ E90E B1               OR C                                ; combinar con carry previo
 754+ E90F AE               XOR (HL)
 755+ E910 77               LD (HL), A
 756+ E911 23               INC HL
 757+ E912 4B               LD C, E                             ; nuevo carry para siguiente byte
 758+ E913 DD 23            INC IX
 759+ E915 10 E0            DJNZ .dbsaByte
 760+ E917                  ; Byte final (carry) si shift > 0
 761+ E917 3A 30 E9         LD A, (.dbsaShift)
 762+ E91A B7               OR A
 763+ E91B 28 03            JR Z, .dbsaNoFinal
 764+ E91D 79               LD A, C
 765+ E91E AE               XOR (HL)
 766+ E91F 77               LD (HL), A
 767+ E920              .dbsaNoFinal:
 768+ E920 E1               POP HL
 769+ E921 CD CE 9A         CALL NextPixelLine
 770+ E924 3A 2E E9         LD A, (.dbsaHeight)
 771+ E927 3D               DEC A
 772+ E928 32 2E E9         LD (.dbsaHeight), A
 773+ E92B 20 C3            JR NZ, .dbsaRow
 774+ E92D C9               RET
 775+ E92E 00           .dbsaHeight: DEFB 0
 776+ E92F 00           .dbsaWidth:  DEFB 0
 777+ E930 00           .dbsaShift:  DEFB 0
 778+ E931
 779+ E931              ; ==============================================================================
 780+ E931              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 781+ E931              ; ==============================================================================
 782+ E931              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 783+ E931              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 784+ E931              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 785+ E931              ; visualmente la mitad inferior del player desaparece tras la HUD.
 786+ E931              ; ==============================================================================
 787+ E931              TownGateExitStep:
 788+ E931 3A A8 5F         LD A, (TownGateExitStepCnt)
 789+ E934 3C               INC A
 790+ E935 32 A8 5F         LD (TownGateExitStepCnt), A
 791+ E938 FE 02            CP TGCS_T_EXIT_STEP
 792+ E93A D8               RET C                               ; aun no toca step
 793+ E93B AF               XOR A
 794+ E93C 32 A8 5F         LD (TownGateExitStepCnt), A
 795+ E93F                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
 796+ E93F DD 21 A3 81      LD IX, EntityTable
 797+ E943 DD 7E 04         LD A, (IX+ENT_POSY)
 798+ E946 3C               INC A
 799+ E947 DD 77 04         LD (IX+ENT_POSY), A
 800+ E94A 32 E4 82         LD (PlayerDrawY), A
 801+ E94D 3A A9 5F         LD A, (TownGateExitWalkFrame)
 802+ E950 EE 01            XOR 1                               ; toggle 0/1
 803+ E952 32 A9 5F         LD (TownGateExitWalkFrame), A
 804+ E955 47               LD B, A
 805+ E956 3E 0E            LD A, SPRID_WALK_S
 806+ E958 80               ADD A, B
 807+ E959 DD 77 00         LD (IX+ENT_SPRITEID), A
 808+ E95C                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
 809+ E95C                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
 810+ E95C                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
 811+ E95C                  ; part1 attrs ni de door attrs.
 812+ E95C CD B0 6D         CALL TownGatePlayerSlideErase_B7
 813+ E95F C3 B6 6D         JP TownGatePlayerSlideDraw_B7       ; tail call via thunk (paging-safe desde bank 7)
 814+ E962
 815+ E962              ; ==============================================================================
 816+ E962              ; TownGateDrawTheEnd - dibuja el sprite "The End" en (TGCS_END_CHARX, _Y)
 817+ E962              ; ==============================================================================
 818+ E962              ; El sprite original "the end" (id 243, 88x72=891 B) se troceo en dos partes
 819+ E962              ; horizontales para no consumir el 87% de BgSpriteBuffer:
 820+ E962              ;   - the_end_part1 (id 47, 88x32 = 11x4 chars, 396 B): mitad superior.
 821+ E962              ;   - the_end_part2 (id 48, 88x40 = 11x5 chars, 495 B): mitad inferior.
 822+ E962              ; Bank 3. RLE-comprimidos (bit 7 de width_bytes set), asi que NO podemos
 823+ E962              ; usar DrawBgSpriteXOR (produce distorsion). Usamos DrawBgGfxSprite, la
 824+ E962              ; rutina normal de render BG: decodifica RLE + pinta pixels + attrs.
 825+ E962              ; Destruye: AF, BC, DE, HL, IX.
 826+ E962              ; ==============================================================================
 827+ E962              TownGateDrawTheEnd:
 828+ E962                  ; --- Part 1: mitad superior (11x4 chars) ---
 829+ E962 21 8E EC         LD HL, BgGfx_the_end_part1
 830+ E965 3E 03            LD A, 3
 831+ E967 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 832+ E96A DD 21 FD 86      LD IX, BgSpriteBuffer
 833+ E96E 06 0B            LD B, TGCS_END_CHARX
 834+ E970 0E 04            LD C, TGCS_END_CHARY
 835+ E972 CD BC 6D         CALL DrawBgGfxSpriteBlackTint_B7    ; flags=0 escritas dentro del thunk
 836+ E975
 837+ E975                  ; --- Part 2: mitad inferior (11x5 chars), 4 chars debajo de part1 ---
 838+ E975 21 01 EE         LD HL, BgGfx_the_end_part2
 839+ E978 3E 03            LD A, 3
 840+ E97A CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 841+ E97D DD 21 FD 86      LD IX, BgSpriteBuffer
 842+ E981 06 0B            LD B, TGCS_END_CHARX
 843+ E983 0E 08            LD C, TGCS_END_CHARY + 4
 844+ E985 C3 BC 6D         JP DrawBgGfxSpriteBlackTint_B7      ; tail call
 845+ E988
 846+ E988              ; ==============================================================================
 847+ E988              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
 848+ E988              ; ==============================================================================
 849+ E988              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
 850+ E988              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
 851+ E988              ; quedara visible sobre fondo negro.
 852+ E988              ; ==============================================================================
 853+ E988              TownGateWipeBlack:
 854+ E988 21 00 40         LD HL, $4000
 855+ E98B 11 01 40         LD DE, $4001
 856+ E98E 01 FF 17         LD BC, $17FF
 857+ E991 36 00            LD (HL), 0
 858+ E993 ED B0            LDIR
 859+ E995 21 00 58         LD HL, $5800
 860+ E998 11 01 58         LD DE, $5801
 861+ E99B 01 FF 02         LD BC, $02FF
 862+ E99E 36 00            LD (HL), $00                        ; ink black, paper black
 863+ E9A0 ED B0            LDIR
 864+ E9A2 C9               RET
 865+ E9A3
 866+ E9A3              ; ==============================================================================
 867+ E9A3              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
 868+ E9A3              ; ==============================================================================
 869+ E9A3              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
 870+ E9A3              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
 871+ E9A3              ; (white ink, black paper, bright) para todo el area de texto.
 872+ E9A3              ; ==============================================================================
 873+ E9A3              TownGateDrawCredits:
 874+ E9A3                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
 875+ E9A3 21 00 58         LD HL, $5800
 876+ E9A6 11 01 58         LD DE, $5801
 877+ E9A9 01 FF 02         LD BC, $02FF
 878+ E9AC 36 47            LD (HL), $47
 879+ E9AE ED B0            LDIR
 880+ E9B0                  ; Iterar credits
 881+ E9B0 21 09 EA         LD HL, TownGateCreditsData
 882+ E9B3              .tgdcLoop:
 883+ E9B3 7E               LD A, (HL)
 884+ E9B4 FE FF            CP $FF
 885+ E9B6 C8               RET Z
 886+ E9B7 57               LD D, A                             ; D = row
 887+ E9B8 23               INC HL
 888+ E9B9 7E               LD A, (HL)
 889+ E9BA 5F               LD E, A                             ; E = col
 890+ E9BB 23               INC HL                              ; HL → string
 891+ E9BC CD C1 E9         CALL PrintStringFontAt
 892+ E9BF 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
 893+ E9C1
 894+ E9C1              ; ==============================================================================
 895+ E9C1              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
 896+ E9C1              ; ==============================================================================
 897+ E9C1              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
 898+ E9C1              ; siguiente byte tras el 0 (para que el caller siga iterando).
 899+ E9C1              ; Destruye: AF, BC, DE, HL.
 900+ E9C1              ; OUT: HL apunta al byte tras el 0 terminador.
 901+ E9C1              ; ==============================================================================
 902+ E9C1              PrintStringFontAt:
 903+ E9C1              .psfaCharLoop:
 904+ E9C1 7E               LD A, (HL)
 905+ E9C2 23               INC HL
 906+ E9C3 B7               OR A
 907+ E9C4 C8               RET Z                               ; fin de string
 908+ E9C5 E5               PUSH HL
 909+ E9C6 D5               PUSH DE
 910+ E9C7 CD CF E9         CALL DrawCharFontAt                 ; D=row, E=col, A=char
 911+ E9CA D1               POP DE
 912+ E9CB E1               POP HL
 913+ E9CC 1C               INC E                               ; siguiente columna
 914+ E9CD 18 F2            JR .psfaCharLoop
 915+ E9CF
 916+ E9CF              ; ==============================================================================
 917+ E9CF              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
 918+ E9CF              ; ==============================================================================
 919+ E9CF              ; D = row (0..23), E = col (0..31), A = ASCII char.
 920+ E9CF              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
 921+ E9CF              ;   y = row * 8, x = col * 8
 922+ E9CF              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
 923+ E9CF              ; El char se renderiza con direct write (sobrescribe pixels y attr).
 924+ E9CF              ; Destruye: AF, BC, DE, HL.
 925+ E9CF              ; ==============================================================================
 926+ E9CF              DrawCharFontAt:
 927+ E9CF D5               PUSH DE
 928+ E9D0                  ; HL = $3C00 + char * 8
 929+ E9D0 6F               LD L, A
 930+ E9D1 26 00            LD H, 0
 931+ E9D3 29               ADD HL, HL
 932+ E9D4 29               ADD HL, HL
 933+ E9D5 29               ADD HL, HL
 934+ E9D6 01 00 3C         LD BC, $3C00
 935+ E9D9 09               ADD HL, BC
 936+ E9DA D1               POP DE
 937+ E9DB                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
 938+ E9DB E5               PUSH HL                             ; save font ptr
 939+ E9DC 7A               LD A, D
 940+ E9DD 87               ADD A, A
 941+ E9DE 87               ADD A, A
 942+ E9DF 87               ADD A, A                            ; A = row * 8 = pixel Y
 943+ E9E0 57               LD D, A
 944+ E9E1 7B               LD A, E
 945+ E9E2 87               ADD A, A
 946+ E9E3 87               ADD A, A
 947+ E9E4 87               ADD A, A                            ; A = col * 8 = pixel X
 948+ E9E5 5F               LD E, A
 949+ E9E6 CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 950+ E9E9 EB               EX DE, HL                           ; DE = VRAM addr
 951+ E9EA E1               POP HL                              ; HL = font ptr
 952+ E9EB 06 08            LD B, 8
 953+ E9ED              .dcfaLoop:
 954+ E9ED 7E               LD A, (HL)
 955+ E9EE 12               LD (DE), A
 956+ E9EF 23               INC HL
 957+ E9F0 14               INC D                               ; siguiente scan line (within char)
 958+ E9F1 10 FA            DJNZ .dcfaLoop
 959+ E9F3 C9               RET
 960+ E9F4
