 117+ E635              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ E635              ; ==============================================================================
 119+ E635              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ E635              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ E635              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ E635              ;
 123+ E635              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ E635              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ E635              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ E635              ; Destruye: AF, BC, DE, HL, IX.
 127+ E635              ; ==============================================================================
 128+ E635              CheckTownGateTriggerBgBody:
 129+ E635 3A D0 82         LD A, (TownGatePhase)
 130+ E638 B7               OR A
 131+ E639 C0               RET NZ                              ; ya en cutscene
 132+ E63A 3A B6 82         LD A, (CurrentKey)
 133+ E63D FE 06            CP TGCS_ARCH_KEY_ID
 134+ E63F C0               RET NZ                              ; sin la key correcta
 135+ E640 3A 10 83         LD A, (CurrentScreenX)
 136+ E643 FE 07            CP TGCS_ARCH_ROOM_X
 137+ E645 C0               RET NZ
 138+ E646 3A 11 83         LD A, (CurrentScreenY)
 139+ E649 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ E64B C0               RET NZ
 141+ E64C                  ; --- Horizontal AABB ---
 142+ E64C 3A A6 81         LD A, (EntityTable + ENT_POSX)
 143+ E64F 4F               LD C, A                             ; C = player_left
 144+ E650 C6 10            ADD A, 16
 145+ E652 57               LD D, A                             ; D = player_right
 146+ E653 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ E655 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ E657 30 01            JR NC, .ctgtNoUnderL
 149+ E659 AF               XOR A
 150+ E65A              .ctgtNoUnderL:
 151+ E65A BA               CP D
 152+ E65B D0               RET NC                              ; ext_left >= player_right
 153+ E65C 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ E65E C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ E660 30 02            JR NC, .ctgtNoOverR
 156+ E662 3E FF            LD A, $FF
 157+ E664              .ctgtNoOverR:
 158+ E664 B9               CP C
 159+ E665 D8               RET C                               ; ext_right < player_left
 160+ E666                  ; --- Vertical AABB ---
 161+ E666                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ E666                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ E666                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ E666                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ E666                  ; con la altura real del rect.
 166+ E666 3A A7 81         LD A, (EntityTable + ENT_POSY)
 167+ E669 4F               LD C, A                             ; C = player_top
 168+ E66A C6 15            ADD A, 21
 169+ E66C 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ E66D 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ E66F D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ E671 30 01            JR NC, .ctgtNoUnderT
 173+ E673 AF               XOR A
 174+ E674              .ctgtNoUnderT:
 175+ E674 BA               CP D
 176+ E675 D0               RET NC
 177+ E676 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ E678 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ E67A 30 02            JR NC, .ctgtNoOverB
 180+ E67C 3E FF            LD A, $FF
