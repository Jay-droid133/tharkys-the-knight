 497+ EC7C                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EC7C D5               PUSH DE
 499+ EC7D 11 06 00         LD DE, 6
 500+ EC80 DD 19            ADD IX, DE
 501+ EC82 FD 19            ADD IY, DE
 502+ EC84 D1               POP DE
 503+ EC85 14               INC D
 504+ EC86 10 C5            DJNZ .dbLoop
 505+ EC88 C9               RET
 506+ EC89
 507+ EC89 00           .dbCol:  DEFB 0
 508+ EC8A 00           .dbCol1: DEFB 0
