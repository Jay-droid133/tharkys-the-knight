 168+ 9DE5 32 24 9E         LD (.tablePage), A
 169+ 9DE8
 170+ 9DE8                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9DE8 DD E5            PUSH IX
 172+ 9DEA D1               POP DE                      ; DE = puntero a pixel data
 173+ 9DEB D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9DEC
 175+ 9DEC                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9DEC 3A 21 9E         LD A, (.posY)
 177+ 9DEF 57               LD D, A
 178+ 9DF0 3A 20 9E         LD A, (.posX)
 179+ 9DF3 5F               LD E, A
 180+ 9DF4 CD BA A0         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9DF7
 182+ 9DF7 D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9DF8 3A 24 9E         LD A, (.tablePage)
 184+ 9DFB 47               LD B, A                     ; B = pagina high part
 185+ 9DFC                  ; Contadores en IX (libre: se convirtio a DE arriba)
