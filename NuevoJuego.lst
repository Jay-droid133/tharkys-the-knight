 300+ E9DF              ; ==============================================================================
 301+ E9DF              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 302+ E9DF              ; ==============================================================================
 303+ E9DF              ; PickupTable layout (per-entry, 7 bytes):
 304+ E9DF              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 305+ E9DF              ; Terminator: $FF (single byte).
 306+ E9DF              ;
 307+ E9DF              ; IN:  DE = ptr a buscar
 308+ E9DF              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 309+ E9DF              ;      B = C = $FF si no encontrado (Z).
 310+ E9DF              ; Destruye: AF, HL. Preserva DE.
 311+ E9DF              ; ==============================================================================
 312+ E9DF              FindPickupScreen:
 313+ E9DF 21 7E D9         LD HL, PickupTable
 314+ E9E2              .fpsLoop:
 315+ E9E2 7E               LD A, (HL)
 316+ E9E3 FE FF            CP $FF
 317+ E9E5 28 1C            JR Z, .fpsNotFound
 318+ E9E7 E5               PUSH HL
 319+ E9E8 23               INC HL                              ; -> mapY
 320+ E9E9 23               INC HL                              ; -> ptr_lo
 321+ E9EA 7E               LD A, (HL)
 322+ E9EB BB               CP E
 323+ E9EC 20 0C            JR NZ, .fpsNoMatch
 324+ E9EE 23               INC HL                              ; -> ptr_hi
 325+ E9EF 7E               LD A, (HL)
 326+ E9F0 BA               CP D
 327+ E9F1 20 07            JR NZ, .fpsNoMatch
 328+ E9F3 E1               POP HL                              ; back to entry start (mapX)
 329+ E9F4 46               LD B, (HL)                          ; B = mapX
 330+ E9F5 23               INC HL
 331+ E9F6 4E               LD C, (HL)                          ; C = mapY
 332+ E9F7 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 333+ E9F9 C9               RET
 334+ E9FA              .fpsNoMatch:
 335+ E9FA E1               POP HL
 336+ E9FB C5               PUSH BC
 337+ E9FC 01 07 00         LD BC, 7
 338+ E9FF 09               ADD HL, BC
 339+ EA00 C1               POP BC
 340+ EA01 18 DF            JR .fpsLoop
 341+ EA03              .fpsNotFound:
 342+ EA03 06 FF            LD B, $FF
 343+ EA05 0E FF            LD C, $FF
 344+ EA07 AF               XOR A                               ; set Z
 345+ EA08 C9               RET
