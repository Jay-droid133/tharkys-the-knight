 739+ E861                  ; Primer caracter en columna 30
 740+ E861 7E               LD A, (HL)
 741+ E862 E5               PUSH HL
 742+ E863 1E 1E            LD E, 30
 743+ E865 CD 79 E8         CALL DrawHudChar
 744+ E868 E1               POP HL
 745+ E869
 746+ E869                  ; Segundo caracter en columna 31
 747+ E869 23               INC HL
 748+ E86A 7E               LD A, (HL)
 749+ E86B 1E 1F            LD E, 31
 750+ E86D CD 79 E8         CALL DrawHudChar
