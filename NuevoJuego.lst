1799+ ACBD DD 77 03         LD (IX+ENT_POSX), A
1800+ ACC0              .noPushBackPop:
1801+ ACC0 C1               POP BC
1802+ ACC1 D1               POP DE
1803+ ACC2              .noPushBack:
1804+ ACC2                  ; Si es animacion de ataque → SFX al inicio del primer swing
1805+ ACC2 7A               LD A, D
1806+ ACC3 FE 16            CP SPRID_ATTACK_EAST
1807+ ACC5 28 04            JR Z, .newAnimAttackSfx
1808+ ACC7 FE 1B            CP SPRID_ATTACK_WEST
1809+ ACC9 20 0F            JR NZ, .newAnimNoSfx
1810+ ACCB              .newAnimAttackSfx:
1811+ ACCB 3E 01            LD A, 1
1812+ ACCD 32 0E B6         LD (AttackSfxPlayed), A         ; Marcar: ya sono este ciclo
1813+ ACD0 C5               PUSH BC
1814+ ACD1 D5               PUSH DE
1815+ ACD2 21 94 F1         LD HL, SFX_Attack
1816+ ACD5 CD 1E F1         CALL PlaySFX
1817+ ACD8 D1               POP DE
1818+ ACD9 C1               POP BC
1819+ ACDA              .newAnimNoSfx:
1820+ ACDA DD 72 08         LD (IX+ENT_ANIMBASE), D
1821+ ACDD DD 72 00         LD (IX+ENT_SPRITEID), D     ; Reset al primer frame
1822+ ACE0 DD 71 09         LD (IX+ENT_ANIMTIMER), C
1823+ ACE3 C9               RET
