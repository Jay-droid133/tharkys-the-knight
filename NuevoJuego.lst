 684+ FB2D
 685+ FB2D              ; ==============================================================================
 686+ FB2D              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 687+ FB2D              ; ==============================================================================
 688+ FB2D              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 689+ FB2D              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 690+ FB2D              ;
 691+ FB2D              ; Estado:
 692+ FB2D              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 693+ FB2D              ;   BankCutsceneTimer:    decrementa por frame
 694+ FB2D              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 695+ FB2D              ;
 696+ FB2D              ; Logica:
 697+ FB2D              ;   - Tick timer. Si != 0, return 0.
 698+ FB2D              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 699+ FB2D              ;   - Si SubState=GAP y timer=0:
 700+ FB2D              ;       - increment KnockIdx
 701+ FB2D              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 702+ FB2D              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 703+ FB2D              ;
 704+ FB2D              ; Destruye: A, BC, DE, HL.
 705+ FB2D              ; ==============================================================================
 706+ FB2D              BankCutsceneTickKnockGroup:
 707+ FB2D 47               LD B, A                             ; B = total knocks
 708+ FB2E 3A CA 82         LD A, (BankCutsceneTimer)
 709+ FB31 3D               DEC A
 710+ FB32 32 CA 82         LD (BankCutsceneTimer), A
 711+ FB35 B7               OR A
 712+ FB36 28 02            JR Z, .bctkgTimer0
 713+ FB38 AF               XOR A                               ; sigue, no terminado
 714+ FB39 C9               RET
 715+ FB3A              .bctkgTimer0:
 716+ FB3A 3A CB 82         LD A, (BankCutsceneSubState)
 717+ FB3D B7               OR A
 718+ FB3E 20 0C            JR NZ, .bctkgGap0
 719+ FB40                  ; HIT acabo: switch a GAP.
 720+ FB40 3E 01            LD A, BCS_KNOCK_GAP
 721+ FB42 32 CB 82         LD (BankCutsceneSubState), A
 722+ FB45 3E 05            LD A, BCS_T_KNOCK_GAP
 723+ FB47 32 CA 82         LD (BankCutsceneTimer), A
 724+ FB4A AF               XOR A
 725+ FB4B C9               RET
 726+ FB4C              .bctkgGap0:
 727+ FB4C                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 728+ FB4C 3A CC 82         LD A, (BankCutsceneKnockIdx)
 729+ FB4F 3C               INC A
 730+ FB50 32 CC 82         LD (BankCutsceneKnockIdx), A
 731+ FB53 B8               CP B
 732+ FB54 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 733+ FB56                  ; grupo terminado.
 734+ FB56 3E 01            LD A, 1
 735+ FB58 C9               RET
 736+ FB59              .bctkgNextHit:
 737+ FB59 3E 00            LD A, BCS_KNOCK_HIT
 738+ FB5B 32 CB 82         LD (BankCutsceneSubState), A
 739+ FB5E 3E 04            LD A, BCS_T_KNOCK_HIT
 740+ FB60 32 CA 82         LD (BankCutsceneTimer), A
 741+ FB63 CD 68 FB         CALL BankCutsceneEmitKnockHit
 742+ FB66 AF               XOR A
 743+ FB67 C9               RET
 744+ FB68
 745+ FB68              ; ==============================================================================
 746+ FB68              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 747+ FB68              ; ==============================================================================
 748+ FB68              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 749+ FB68              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 750+ FB68              ; Destruye: A, BC, DE, HL.
 751+ FB68              ; ==============================================================================
 752+ FB68              BankCutsceneEmitKnockHit:
 753+ FB68 C3 D3 FB         JP SFX_Bank_OnKnock                 ; tail-call
 754+ FB6B
 755+ FB6B              ; ==============================================================================
 756+ FB6B              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 757+ FB6B              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 758+ FB6B              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 759+ FB6B              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 760+ FB6B              ; oscuridad de la rendija".
 761+ FB6B              BCS_DOOR_HAND_ATTR      EQU $47
 762+ FB6B
 763+ FB6B              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 764+ FB6B              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 765+ FB6B              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 766+ FB6B              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 767+ FB6B              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 768+ FB6B
 769+ FB6B              ; ==============================================================================
 770+ FB6B              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 771+ FB6B              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 772+ FB6B              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 773+ FB6B              ; pixels visibles bright white sobre fondo negro.
 774+ FB6B              ;
 775+ FB6B              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 776+ FB6B              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 777+ FB6B              ; dos llamadas no cancelan, solo re-pintan.
 778+ FB6B              ; Destruye: AF, BC, DE, HL, IX.
 779+ FB6B              ; ==============================================================================
 780+ FB6B              BankCutsceneOpenDoorWithHandAttrs:
 781+ FB6B 21 FA F0         LD HL, BgGfx_bank_door_closed
 782+ FB6E 3E 03            LD A, 3                             ; bank 3
 783+ FB70 CD C2 6A         CALL LoadBgSpriteToBuffer
 784+ FB73 DD 21 F5 86      LD IX, BgSpriteBuffer
 785+ FB77 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 786+ FB79 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 787+ FB7B CD 35 DB         CALL DrawBgSpriteXOR                ; XOR-cancel pixels (attrs intactos $78)
 788+ FB7E                  ; Sobreescribir attrs a "hand mode" = $47.
 789+ FB7E 3E 47            LD A, BCS_DOOR_HAND_ATTR
 790+ FB80 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 791+ FB83 77               LD (HL), A
 792+ FB84 23               INC HL                              ; $58D0 (16, 4)
 793+ FB85 77               LD (HL), A
 794+ FB86 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 795+ FB89 77               LD (HL), A
 796+ FB8A 23               INC HL                              ; $58F0 (16, 5)
 797+ FB8B 77               LD (HL), A
 798+ FB8C C9               RET
 799+ FB8D
 800+ FB8D              ; ==============================================================================
 801+ FB8D              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 802+ FB8D              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 803+ FB8D              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 804+ FB8D              ;
 805+ FB8D              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 806+ FB8D              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 807+ FB8D              ; Destruye: AF, BC, DE, HL, IX.
 808+ FB8D              ; ==============================================================================
 809+ FB8D              BankCutsceneCloseDoorRestoreAttrs:
 810+ FB8D 21 FA F0         LD HL, BgGfx_bank_door_closed
 811+ FB90 3E 03            LD A, 3
 812+ FB92 CD C2 6A         CALL LoadBgSpriteToBuffer
 813+ FB95 DD 21 F5 86      LD IX, BgSpriteBuffer
 814+ FB99 06 0F            LD B, BCS_DOOR_CHARX
 815+ FB9B 0E 04            LD C, BCS_DOOR_CHARY
 816+ FB9D AF               XOR A
 817+ FB9E 32 2D E2         LD (BgSpriteIsHouse), A
 818+ FBA1                  ; CurrentTintVar = $FF (no tint). El sprite door tiene tintPaper=7 y attr
 819+ FBA1                  ; paper=7 — si CurrentTintVar fuera 0, ApplyTintSwap pondria paper=0 → todo
 820+ FBA1                  ; negro. Con $FF (= "sin tint") la attr queda intacta a su valor original.
 821+ FBA1 3E FF            LD A, $FF
 822+ FBA3 32 F6 D1         LD (CurrentTintVar), A
 823+ FBA6 C3 EC D0         JP DrawBgGfxSprite                  ; SET pixels + PAINT attrs ($78) sin tint
 824+ FBA9
 825+ FBA9              ; ==============================================================================
 826+ FBA9              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 827+ FBA9              ; ==============================================================================
 828+ FBA9              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 829+ FBA9              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 830+ FBA9              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 831+ FBA9              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 832+ FBA9              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 833+ FBA9              ; Destruye: AF, BC, DE, HL, IX.
 834+ FBA9              ; ==============================================================================
 835+ FBA9              BankCutsceneDrawHand:
 836+ FBA9 3A CE 82         LD A, (BankCutsceneHandFrame)
 837+ FBAC B7               OR A
 838+ FBAD 20 05            JR NZ, .bcdhFrame1
 839+ FBAF 21 04 FC         LD HL, BgGfx_BankHandFrame0
 840+ FBB2 18 03            JR .bcdhCopy
 841+ FBB4              .bcdhFrame1:
 842+ FBB4 21 26 FC         LD HL, BgGfx_BankHandFrame1
 843+ FBB7              .bcdhCopy:
 844+ FBB7 11 F5 86         LD DE, BgSpriteBuffer
 845+ FBBA 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
 846+ FBBD ED B0            LDIR
 847+ FBBF 16 30            LD D, BCS_HAND_PX_Y
 848+ FBC1 1E 78            LD E, BCS_HAND_PX_X
 849+ FBC3 C3 31 69         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
 850+ FBC6
 851+ FBC6              ; ==============================================================================
 852+ FBC6              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
 853+ FBC6              ; ==============================================================================
 854+ FBC6              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
 855+ FBC6              ; Destruye: AF, BC, DE, HL, IX.
 856+ FBC6              ; ==============================================================================
 857+ FBC6              BankCutsceneEraseHand:
 858+ FBC6 C3 A9 FB         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
 859+ FBC9
 860+ FBC9              ; ==============================================================================
 861+ FBC9              ; Player redraw helpers — REUSADOS de town_gate_cutscene.asm (slot 1, always-vis):
 862+ FBC9              ;   TownGateRedrawPlayer:    erase old + draw new (cambio sprite/posicion).
 863+ FBC9              ;   TownGateDrawPlayerHere:  draw + attrs en (ENT_DRAWX, PlayerDrawY).
 864+ FBC9              ;   TownGateErasePlayer:     XOR-erase en (ENT_OLDX, ENT_OLDY) + RestoreOldAttr.
 865+ FBC9              ; Son rutinas puras del estado del player (no tocan ninguna var de town_gate),
 866+ FBC9              ; asi que invocarlas desde aqui (bank 0) ahorra ~85 B sin cambiar comportamiento.
 867+ FBC9              ; ==============================================================================
 868+ FBC9
 869+ FBC9              ; ==============================================================================
 870+ FBC9              ; BankCutsceneDecTimer - decrementa BankCutsceneTimer, devuelve Z si llego a 0
 871+ FBC9              ; ==============================================================================
 872+ FBC9              BankCutsceneDecTimer:
 873+ FBC9 3A CA 82         LD A, (BankCutsceneTimer)
 874+ FBCC 3D               DEC A
 875+ FBCD 32 CA 82         LD (BankCutsceneTimer), A
 876+ FBD0 B7               OR A
 877+ FBD1 C9               RET
 878+ FBD2
 879+ FBD2              ; ==============================================================================
 880+ FBD2              ; SFX stubs — placeholders RET. Rellenar con AY_PlayBeep / PlaySFX cuando
 881+ FBD2              ; se diseñen los timbres.
 882+ FBD2              ; ==============================================================================
 883+ FBD2              SFX_Bank_OnStart:
 884+ FBD2 C9               RET
 885+ FBD3              ; Knock: dispatch entre soft (grupos 1, 2) y loud (grupo 3) segun
 886+ FBD3              ; BankCutsceneKnockType (set por la fase de entrada al grupo). Duracion
 887+ FBD3              ; comun 4 frames (~160ms).
 888+ FBD3              SFX_Bank_OnKnock:
 889+ FBD3 3A CF 82         LD A, (BankCutsceneKnockType)
 890+ FBD6 B7               OR A
 891+ FBD7 20 05            JR NZ, .sokLoud
 892+ FBD9 06 04            LD B, 4
 893+ FBDB C3 F0 6D         JP AY_PlayKnockSoft                 ; tail-call (grupos 1, 2: 3 knocks)
 894+ FBDE              .sokLoud:
 895+ FBDE 06 04            LD B, 4
 896+ FBE0 C3 F5 6D         JP AY_PlayKnockLoud                 ; tail-call (grupo 3: 6 knocks)
 897+ FBE3              SFX_Bank_OnDoorCreak:                   ; antes SFX_Bank_OnDoorOpen
 898+ FBE3                  ; TODO: crujido leve para sugerir que la puerta cede mientras la mano
 899+ FBE3                  ; sale por la rendija (la puerta nunca se abre del todo).
 900+ FBE3 C9               RET
 901+ FBE4              ; Cuando la puerta del banco se abre (PRE_HAND), reusamos el mismo crujido
 902+ FBE4              ; de puerta vieja que la iglesia (.cbtActChurchDoor en screen_system.asm).
 903+ FBE4              SFX_Bank_OnHandIn:
 904+ FBE4 21 58 F7         LD HL, SFX_ChurchDoorOpen
 905+ FBE7 C3 41 F6         JP PlaySFX                          ; tail-call
 906+ FBEA              ; SFX_Bank_OnNoSwap — dos tonos alternos por swap ("uh-oh" cartoonish).
 907+ FBEA              ; Llamado AL HACER swap, justo despues de XOR'ar BankCutsceneHandFrame:
 908+ FBEA              ;   swap 1: HandFrame=1 → aguda
 909+ FBEA              ;   swap 2: HandFrame=0 → grave
 910+ FBEA              ;   ...
 911+ FBEA              ;   swap 8: HandFrame=0 → grave
 912+ FBEA              ; → Patron 8 swaps: A G A G A G A G (4 ciclos "uh-oh").
 913+ FBEA              ; AY_PlayBeep es no-bloqueante (cutoff via BeepDurationFrames + ticker IRQ).
 914+ FBEA              SFX_Bank_OnNoSwap:
 915+ FBEA 3A CE 82         LD A, (BankCutsceneHandFrame)
 916+ FBED B7               OR A
 917+ FBEE 28 05            JR Z, .nsLow
 918+ FBF0 21 50 01         LD HL, BCS_NO_PERIOD_HI
 919+ FBF3 18 03            JR .nsPlay
 920+ FBF5              .nsLow:
 921+ FBF5 21 A8 01         LD HL, BCS_NO_PERIOD_LO
 922+ FBF8              .nsPlay:
 923+ FBF8 06 06            LD B, BCS_NO_DUR_FRAMES
 924+ FBFA C3 CA 6D         JP AY_PlayBeep                      ; tail-call
 925+ FBFD              ; Cuando la puerta del banco se cierra (HAND_OUT, tras erase mano + redraw
 926+ FBFD              ; door), reusamos el mismo crujido de puerta vieja que la iglesia. La
 927+ FBFD              ; iglesia tambien comparte SFX_ChurchDoorOpen para abrir y cerrar (ver
 928+ FBFD              ; CloseChurchDoor en church_cutscene.asm:610).
 929+ FBFD              SFX_Bank_OnHandOut:
 930+ FBFD 21 58 F7         LD HL, SFX_ChurchDoorOpen
 931+ FC00 C3 41 F6         JP PlaySFX                          ; tail-call
 932+ FC03              SFX_Bank_OnPlayerTurn:
 933+ FC03 C9               RET
