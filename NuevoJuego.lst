 266+ 7D84              ; ==============================================================================
 267+ 7D84              ; AY_WriteRegSlot1 - copia de AY_WriteReg en slot 1
 268+ 7D84              ; ==============================================================================
 269+ 7D84              ; Necesaria porque desde el IRQ handler (slot 1) NO podemos llamar a la
 270+ 7D84              ; AY_WriteReg de bank 4: bank 4 puede no estar paginado en slot 3, y aunque
 271+ 7D84              ; lo estuviera, paginarlo desde el IRQ trae el race que estamos eliminando.
 272+ 7D84              ; Identica a AY_WriteReg (bank 4): A=registro, E=valor; clobbea BC y A.
 273+ 7D84              ; ==============================================================================
 274+ 7D84              AY_WriteRegSlot1:
 275+ 7D84 01 FD FF         LD BC, $FFFD
 276+ 7D87 ED 79            OUT (C), A                      ; seleccionar registro
 277+ 7D89 01 FD BF         LD BC, $BFFD
 278+ 7D8C ED 59            OUT (C), E                      ; escribir valor
 279+ 7D8E C9               RET
 280+ 7D8F
 281+ 7D8F              ; ==============================================================================
 282+ 7D8F              ; UpdateMusicImpl - catchup wall-clock. LEGACY: ya no se llama desde MainLoop.
 283+ 7D8F              ; ==============================================================================
 284+ 7D8F              ; Hoy el tick vive en MusicIrqHandler (CALL .upmiTickOnce + CALL .upmiPostLoop
 285+ 7D8F              ; cada 2 IRQs). Esta rutina catchup se mantiene como fallback por si alguna
 286+ 7D8F              ; vez queremos forzar avance N frames desde codigo.
 287+ 7D8F              ; ==============================================================================
 288+ 7D8F              UpdateMusicImpl:
 289+ 7D8F 3A C7 9C         LD A, (FramesElapsed)
 290+ 7D92 B7               OR A
 291+ 7D93 28 08            JR Z, .upmiPostLoop
 292+ 7D95 47               LD B, A
 293+ 7D96              .upmiLoop:
 294+ 7D96 C5               PUSH BC
 295+ 7D97 CD 0E 7E         CALL .upmiTickOnce
 296+ 7D9A C1               POP BC
 297+ 7D9B 10 F9            DJNZ .upmiLoop
 298+ 7D9D              .upmiPostLoop:
 299+ 7D9D                  ; --- Re-arm AY si musica activa ---
 300+ 7D9D                  ; Sin esto, la nota actual queda muda tras (a) cualquier write a R8/R9/R10
 301+ 7D9D                  ; que la mute, o (b) tras pasar por un rest. Re-escribimos vol + period de
 302+ 7D9D                  ; cada canal con period activo != 0. SFX en canal B (poly2 only) bloquean
 303+ 7D9D                  ; el re-arm de B; en poly3 no hay SFX activos (game-end), siempre re-armar.
 304+ 7D9D 3A A5 7B         LD A, (MusicTimer)
 305+ 7DA0 B7               OR A
 306+ 7DA1 C8               RET Z                           ; musica inactiva → no tocar AY
 307+ 7DA2                  ; --- Re-arm canal A: R0/R1 + R8 si MusicPeriodA != 0 ---
 308+ 7DA2 2A AA 7B         LD HL, (MusicPeriodA)
 309+ 7DA5 7C               LD A, H
 310+ 7DA6 B5               OR L
 311+ 7DA7 28 18            JR Z, .upmiSkipA
 312+ 7DA9 E5               PUSH HL
 313+ 7DAA 3E 08            LD A, 8
 314+ 7DAC 1E 0C            LD E, 12
 315+ 7DAE CD 84 7D         CALL AY_WriteRegSlot1           ; R8 = vol A medio-alto
 316+ 7DB1 E1               POP HL
 317+ 7DB2 5D               LD E, L
 318+ 7DB3 3E 00            LD A, 0
 319+ 7DB5 CD 84 7D         CALL AY_WriteRegSlot1           ; R0 = period A lo
 320+ 7DB8 2A AA 7B         LD HL, (MusicPeriodA)
 321+ 7DBB 5C               LD E, H
 322+ 7DBC 3E 01            LD A, 1
 323+ 7DBE CD 84 7D         CALL AY_WriteRegSlot1           ; R1 = period A hi
 324+ 7DC1              .upmiSkipA:
 325+ 7DC1                  ; --- Re-arm canal C: R4/R5 + R10 si MusicPeriodC != 0 ---
 326+ 7DC1 2A AE 7B         LD HL, (MusicPeriodC)
 327+ 7DC4 7C               LD A, H
 328+ 7DC5 B5               OR L
 329+ 7DC6 28 18            JR Z, .upmiSkipC
 330+ 7DC8 E5               PUSH HL
 331+ 7DC9 3E 0A            LD A, 10
 332+ 7DCB 1E 0C            LD E, 12
 333+ 7DCD CD 84 7D         CALL AY_WriteRegSlot1           ; R10 = vol C medio-alto
 334+ 7DD0 E1               POP HL
 335+ 7DD1 5D               LD E, L
 336+ 7DD2 3E 04            LD A, 4
 337+ 7DD4 CD 84 7D         CALL AY_WriteRegSlot1           ; R4 = period C lo
 338+ 7DD7 2A AE 7B         LD HL, (MusicPeriodC)
 339+ 7DDA 5C               LD E, H
 340+ 7DDB 3E 05            LD A, 5
 341+ 7DDD CD 84 7D         CALL AY_WriteRegSlot1           ; R5 = period C hi
 342+ 7DE0              .upmiSkipC:
 343+ 7DE0                  ; --- Re-arm canal B: solo en poly3 y solo si no hay SFX en curso ---
 344+ 7DE0 3A A9 7B         LD A, (MusicMode)
 345+ 7DE3 FE 03            CP 3
 346+ 7DE5 C0               RET NZ                          ; poly2: B reservado a SFX, no tocar
 347+ 7DE6 3A 4C 6D         LD A, (BeepDurationFrames)
 348+ 7DE9 B7               OR A
 349+ 7DEA C0               RET NZ
 350+ 7DEB 3A 47 6D         LD A, (PlayerHitFrames)
 351+ 7DEE B7               OR A
 352+ 7DEF C0               RET NZ
 353+ 7DF0 2A AC 7B         LD HL, (MusicPeriodB)
 354+ 7DF3 7C               LD A, H
 355+ 7DF4 B5               OR L
 356+ 7DF5 C8               RET Z
 357+ 7DF6 E5               PUSH HL
 358+ 7DF7 3E 09            LD A, 9
 359+ 7DF9 1E 0C            LD E, 12
 360+ 7DFB CD 84 7D         CALL AY_WriteRegSlot1           ; R9 = vol B medio-alto
 361+ 7DFE E1               POP HL
 362+ 7DFF 5D               LD E, L
 363+ 7E00 3E 02            LD A, 2
 364+ 7E02 CD 84 7D         CALL AY_WriteRegSlot1           ; R2 = period B lo
 365+ 7E05 2A AC 7B         LD HL, (MusicPeriodB)
 366+ 7E08 5C               LD E, H
 367+ 7E09 3E 03            LD A, 3
