2953+ B35D                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2954+ B35D                  ;
2955+ B35D                  ; Doble comportamiento:
2956+ B35D                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2957+ B35D                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2958+ B35D                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2959+ B35D                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2960+ B35D                  ;   y lo activa).
2961+ B35D                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2962+ B35D                  ;   El monster queda en destino (memoria) hasta que el player visite.
2963+ B35D                  ;
2964+ B35D                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2965+ B35D                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2966+ B35D DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2967+ B360 32 A1 B3         LD (.moKbSavedDir), A
2968+ B363 3E 01            LD A, 1
2969+ B365 32 DE B6         LD (MonsterKbDespawn), A
2970+ B368                  ; Calcular slot (0-2) en E, D=0
2971+ B368 DD E5            PUSH IX
2972+ B36A E1               POP HL
2973+ B36B 11 46 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
2974+ B36E B7               OR A
2975+ B36F ED 52            SBC HL, DE
2976+ B371 CB 3D            SRL L
2977+ B373 CB 3D            SRL L
2978+ B375 CB 3D            SRL L
2979+ B377 CB 3D            SRL L
