  98+ 0000              ; ==============================================================================
  99+ 0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
 100+ 0000              ; ==============================================================================
 101+ 0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
 102+ 0000              ; Acceso via IX + ENT_* offset.
 103+ 0000              ; ==============================================================================
 104+ 0000
 105+ 0000              ; --- Offsets en la estructura de entidad (16 bytes) ---
 106+ 0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
 107+ 0000              ENT_TYPE        EQU 1               ; Tipo de entidad
 108+ 0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
 109+ 0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
 110+ 0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
 111+ 0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
 112+ 0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
 113+ 0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
 114+ 0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
 115+ 0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
 116+ 0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
 117+ 0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
 118+ 0000              ENT_OLDX        EQU 12              ; X del frame anterior (para XOR erase)
 119+ 0000              ENT_OLDY        EQU 13              ; Y del frame anterior (para XOR erase)
 120+ 0000              ENT_OLDSPRID    EQU 14              ; SpriteID del frame anterior
 121+ 0000              ENT_DRAWX       EQU 15              ; X de dibujo (ajustado para attack offset)
 122+ 0000
 123+ 0000              ENT_SIZE        EQU 16              ; Bytes por entidad
 124+ 0000              NUM_ENTITIES    EQU 17              ; Total de slots
 125+ 0000
 126+ 0000              ; --- Tipos de entidad ---
 127+ 0000              TYPE_NONE       EQU 0               ; Slot inactivo
 128+ 0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 129+ 0000              TYPE_MONSTER   EQU 2               ; Monstruo permanente (rhino, wolf, etc.)
 130+ 0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 131+ 0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
 132+ 0000              TYPE_DEATH      EQU 5               ; La muerte: persigue al player tras 10s en sala
 133+ 0000
 134+ 0000              ; --- Flags de entidad (ENT_FLAGS) ---
 135+ 0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
 136+ 0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
 137+ 0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
 138+ 0000              ENTF_NEWSPAWN   EQU 3               ; bit 3: recien creada (usar freshDraw, no erase)
 139+ 0000              ENTF_KB_DIRECT  EQU 4               ; bit 4: knockback directo del player (no billar)
 140+ 0000                                                  ;   Set al golpear con espada; clear al heredar
 141+ 0000                                                  ;   kb por colision billar. CheckChurchTrap solo
 142+ 0000                                                  ;   dispara la trampa si este bit esta set.
 143+ 0000
 144+ 0000              ; --- Rangos de slots ---
 145+ 0000              SLOT_PLAYER     EQU 0               ; Slot 0: player
 146+ 0000              SLOT_MONSTER0  EQU 1               ; Slots 1-6: monstruos
 147+ 0000              NUM_MONSTERS   EQU 6
 148+ 0000              SLOT_NASTY0     EQU 7               ; Slots 7-10: nasties (spawn)
 149+ 0000              NUM_NASTIES     EQU 4
 150+ 0000              SLOT_DEATH      EQU 11              ; Slot 11: la muerte (entidad unica TYPE_DEATH)
 151+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 152+ 0000              NUM_OBJECTS     EQU 4
 153+ 0000
 154+ 0000              ; --- Velocidades de enemigos ---
 155+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 156+ 0000              MONSTER_SPEED    EQU 2               ; Pixels por update (efectivo ~1 px/frame con round-robin)
 157+ 0000              MONSTER_MAX_HITS EQU 5              ; Golpes directos para matar un monster
 158+ 0000              MONSTER_KB_SPEED EQU 4              ; Pixels por update durante knockback
 159+ 0000              MONSTER_RESPAWN_DELAY EQU 75        ; 75 frames a 25fps = 3s (era 150 a 50fps)
 160+ 0000              MONSTER_STUN_TOTAL EQU 12           ; 12 frames a 25fps ~0.5s (era 24 a 50fps)
 161+ 0000              MONSTER_STUN_PAUSE EQU 6            ; 6 frames a 25fps (era 12 a 50fps)
 162+ 0000              ENEMY_ANIM_DELAY EQU 4              ; 4 frames a 25fps = 160ms (era 8 a 50fps)
 163+ 0000              ; PREDATOR_SPEED: se lee de PredatorSpeedTable segun DayCycleCount
 164+ 0000              ; Tipos de depredador (bits 0-1 de PredatorTable)
 165+ 0000              PRED_NONE       EQU 0               ; No depredador (movimiento random)
 166+ 0000              PRED_FROM_ABOVE EQU 1               ; Se lanza desde arriba (Eagle, Bat)
 167+ 0000              PRED_FROM_BELOW EQU 2               ; Se lanza desde abajo (Snake, Scorpion)
 168+ 0000              PRED_HORIZONTAL EQU 3               ; Se lanza horizontalmente (Goat, RabidCat)
 169+ 0000              PRED_ALIGN_DIST EQU 12              ; Distancia de alineacion para activar ataque
 170+ 0000              PREDATOR_COOLDOWN EQU 25            ; 25 frames a 25fps = 1s (era 50 a 50fps)
 171+ 0000
 172+ 0000              ; --- Stamina / Salud ---
 173+ 0000              STAMINA_MAX         EQU 16          ; Nivel maximo (= 16 scanlines del HUD)
 174+ 0000              HEALTH_MAX          EQU 16
 175+ 0000              STAMINA_DRAIN_RATE  EQU 13          ; 13 frames a 25fps ~0.5s (era 25 a 50fps)
 176+ 0000              STAMINA_REGEN_RATE  EQU 25          ; 25 frames a 25fps = 1s (era 50 a 50fps)
 177+ 0000              HEALTH_REGEN_RATE   EQU 50          ; 50 frames a 25fps = 2s (era 100 a 50fps)
 178+ 0000              STAMINA_THRESHOLD_HIGH EQU 12       ; >= libre (continuo)
 179+ 0000              STAMINA_THRESHOLD_MID  EQU 7        ; >= fixed swing
 180+ 0000              STAMINA_THRESHOLD_LOW  EQU 3        ; >= cooldown corto
 181+ 0000              ; < LOW = cooldown largo + 1 punto recuperado tras cada cooldown
 182+ 0000              ATTACK_COOLDOWN_FRAMES EQU 10       ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
 183+ 0000              ATTACK_SWING_FRAMES EQU ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT ; Opcion C: = 1 ciclo de animacion
 184+ 0000              SCARE_FLEE_THRESHOLD EQU 50          ; 50 a 25fps (era 100 a 50fps)
 185+ 0000              SCARE_TIMER_BELLS EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 186+ 0000              SCARE_TIMER_DAWN  EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 187+ 0000              FLEE_PLAYER_AVOID EQU 12            ; Pixeles de proximidad para evitar al player al huir
 188+ 0000              NEAR_ENTRY_DIST EQU 30              ; Distancia minima monster-entrada al restaurar room
 189+ 0000
 190+ 0000              ; --- Spawn system ---
 191+ 0000              SPAWN_INTERVAL  EQU 12              ; ~0.5s a 25fps (era 25 = 1s) — primer nasty post-transition
 192+ 0000                                                  ; (Gap entre spawns consecutivos = R AND 7 frames, 0-0.28s)
 193+ 0000
 194+ 0000              ; --- La muerte (TYPE_DEATH, slot 11) ---
 195+ 0000              DEATH_SPAWN_FRAMES   EQU 500         ; TEMP DEBUG: 20s a 25fps (volver a 250 = 10s al terminar test). Pausa con TimeFrozen=1.
 196+ 0000              DEATH_SPEED          EQU 1           ; 1 px por update; acumulador 1/2 -> mueve cada 2 frames
 197+ 0000              DEATH_STUCK_THRESHOLD EQU 6          ; Frames sin movimiento -> activar BFS rescue
 198+ 0000              DEATH_BFS_MAX_DEPTH  EQU 3           ; Profundidad max del mini-BFS (diamond ~25 cells)
 199+ 0000              DEATH_GHOST_FRAMES   EQU 125         ; DEBUG: 5s a 25fps (final: 375 = 15s) -> ghost mode (no collision)
 200+ 0000              DEATH_GHOST_SPEED    EQU SPEED_RUN   ; Velocidad ghost = SPEED_RUN del player (4 px/frame)
 201+ 0000              DEATH_MIN_SPAWN_DIST EQU 8           ; Min distancia BFS al player en cells. Evita instakill en cul-de-sac.
 202+ 0000
 203+ 0000              ; --- Well cooldown tras curar (modo prueba; ajustar al gusto) ---
 204+ 0000              ; --- Player lives ---
 205+ 0000              PLAYER_LIVES_INIT       EQU 3            ; Vidas iniciales
 206+ 0000              PLAYER_LIVES_MAX        EQU 5            ; Cap (futuro Life pickup incrementa hasta este max)
 207+ 0000
 208+ 0000              ; --- Death border flash ---
 209+ 0000              DEATH_BORDER_YELLOW_FRAMES EQU 50        ; 2s a 25fps
 210+ 0000              DEATH_BORDER_RED_FRAMES    EQU 50        ; 2s a 25fps
 211+ 0000
 212+ 0000              ; --- Player death animation (durante fase yellow del border flash) ---
 213+ 0000              PLAYER_DEATH_ANIM_DELAY  EQU 13          ; ~0.5s a 25fps por frame (3 frames ≈ 1.5s; resto del yellow queda en frame final)
 214+ 0000              PLAYER_DEATH_ANIM_FRAMES EQU 3           ; Frames de la anim de muerte del player
 215+ 0000
 216+ 0000              ; --- Respawn blink ---
 217+ 0000              ; Phase 1: countdown "3, 2, 1!" - 3 beats con flash + bip; ultimo bip largo bloqueante.
 218+ 0000              ; Beats van back-to-back: tras cada SFX (500ms o 1000ms) hay un flash off de 4 frames
 219+ 0000              ; antes del siguiente beat -> fase 1 ~= 2 * (500ms + 160ms) + 1000ms = ~2.3s.
 220+ 0000              RESPAWN_FLASH_FRAMES       EQU 6         ; ~240ms silencio entre beats
 221+ 0000              ; Phase 2: gracia ~1s con control + blink rapido. Activada tambien tras cada
 222+ 0000              ; hit de monster/nasty (CheckPlayerEnemyCollision.pHpDmgNotZero) — invulnerable
 223+ 0000              ; durante 1s con feedback visual de blink. Compartida via EnterGracePhase.
 224+ 0000              RESPAWN_GRACE_FRAMES       EQU 25        ; ~1s a 25fps
 225+ 0000              RESPAWN_GRACE_BLINK_PERIOD EQU 2         ; ~80ms entre toggles (bit 1 frame counter)
 226+ 0000
 227+ 0000              WELL_COOLDOWN_FRAMES  EQU 125        ; 5 s @ 25 fps
 228+ 0000              WELL_COOLDOWN_ATTR_L  EQU $78        ; Celda inferior-izq: BRIGHT + PAPER WHITE
 229+ 0000              WELL_COOLDOWN_ATTR_R  EQU $38        ; Celda inferior-der: PAPER WHITE (sin bright)
 230+ 0000
 231+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 232+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 233+ 0000
 234+ 0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 235+ 0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 236+ 0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 237+ 0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 238+ 0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 239+ 0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 240+ 0000
 241+ 0000              ; ==============================================================================
 242+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 243+ 0000              ; ==============================================================================
 244+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 245+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 246+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 247+ 0000              ;
 248+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 249+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 250+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 251+ 0000              ; ==============================================================================
 252+ 0000
 253+ 0000              ; --- Dimensiones del mapa ---
 254+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 255+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 256+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 257+ 0000
 258+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 259+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 260+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 261+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 262+ 0000
 263+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 264+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 265+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 266+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 267+ 0000
 268+ 0000              ; --- Tipos de tile ---
 269+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 270+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 271+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 272+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 273+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 274+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 275+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 276+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 277+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 278+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 279+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 280+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 281+ 0000
 282+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 283+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 284+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 285+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 286+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 287+ 0000
 288+ 0000              ; --- Posicion inicial del jugador: definida en screen_data.asm (level editor) ---
 289+ 0000
 290+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 291+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 292+ 0000
 293+ 0000              ; ==============================================================================
 294+ 0000              ; MONSTER AI v2 (fase 2 — estructuras en RAM + bank 6)
 295+ 0000              ; ==============================================================================
 296+ 0000              ; Timings tuneables. Unidad: frames a 25fps.
 297+ 0000              MAI_LINGER_NORMAL   EQU 18          ; ~0.7s — migrar tras abandono sin push
 298+ 0000              MAI_LINGER_PUSHED   EQU 25          ; ~1s — vuelta tras knockback de espada
 299+ 0000              MAI_ENTRY_OFFSET    EQU 0           ; Spawn inicial: al borde mismo (Regla 1)
 300+ 0000              MAI_REENTRY_OFFSET  EQU 16          ; Reaparicion tras push: 2 chars dentro (Regla 4)
 301+ 0000              MAI_WAIT_OFFSET     EQU 40          ; Offset del migrado "esperando" desde entry gap (evita solape con player)
 302+ 0000
 303+ 0000              ; Lados de un screen (coincide con ScreenGaps_*.asm y el campo EntryBorder)
 304+ 0000              MAI_SIDE_N          EQU 0
 305+ 0000              MAI_SIDE_S          EQU 1
 306+ 0000              MAI_SIDE_W          EQU 2
 307+ 0000              MAI_SIDE_E          EQU 3
 308+ 0000
 309+ 0000              ; Flags por monster (campo MonsterAiFlags[slot], 1 byte)
 310+ 0000              MAI_FLAG_PUSHED     EQU %00000001   ; bit 0: empujado por espada (usar LINGER_PUSHED)
 311+ 0000              MAI_FLAG_LEAVING    EQU %00000010   ; bit 1: buscando hueco y saliendo (amanecer/muerte)
 312+ 0000              MAI_FLAG_REMOTE     EQU %00000100   ; bit 2: asentado en una room distinta al player
 313+ 0000              MAI_FLAG_SHAKE_SAVED EQU %00001000  ; bit 3: orig POSX/POSY guardados para shake del amanecer
 314+ 0000
 315+ 0000              ; ScreenGaps: DEFB count, {side, coord} × count
 316+ 0000              MAI_GAP_REC_SIZE    EQU 2           ; bytes por entrada de gap
 317+ 0000
 318+ 0000              ; RoomHistory: ventana de las ultimas 3 rooms distintas visitadas.
 319+ 0000              MAI_HISTORY_LEN     EQU 3
 320+ 0000
 321+ 0000              ; Flow field: direcciones resueltas + intervalo de recomputacion
 322+ 0000              MAI_DIR_NONE        EQU $FF
 323+ 0000              MAI_DIR_N           EQU 0
 324+ 0000              MAI_DIR_S           EQU 1
 325+ 0000              MAI_DIR_W           EQU 2
 326+ 0000              MAI_DIR_E           EQU 3
 327+ 0000              MAI_FLOW_INTERVAL   EQU 10          ; frames entre recomputaciones de BFS
 328+ 0000
