7293+ C777 3C               INC A
7294+ C778 4F               LD C, A
7295+ C779 3A 74 5F         LD A, (DBfsCurCx)
7296+ C77C 47               LD B, A
7297+ C77D 3E 01            LD A, MAI_DIR_S
7298+ C77F CD 12 C8         CALL .bfsTryNbr
7299+ C782              .bfsTryW:
