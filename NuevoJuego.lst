2301+ DB1E              ; ==============================================================================
2302+ DB1E              ; CheckBumpTriggers - cada frame, si player AABB toca un sprite bump-trigger
2303+ DB1E              ; ==============================================================================
2304+ DB1E              ; en la pantalla actual y tiene la key correcta, dispara la acción.
2305+ DB1E              ; Player AABB = 16×16 en (EntityTable[ENT_POSX/POSY]).
2306+ DB1E              ; Sprite AABB se extiende +1 pixel en cada lado para detectar "pegado".
2307+ DB1E              ; Como los chars del sprite son walls (vía WallAlwaysTable), el player nunca
2308+ DB1E              ; se solapa físicamente con él — solo puede estar pegado por algún borde.
2309+ DB1E              ; ==============================================================================
2310+ DB1E              CheckBumpTriggers:
2311+ DB1E 21 AF E1         LD HL, PickupTable
2312+ DB21              .cbtLoop:
2313+ DB21 7E               LD A, (HL)
2314+ DB22 FE FF            CP $FF
2315+ DB24 C8               RET Z
2316+ DB25 FE FE            CP $FE
2317+ DB27 CA 86 DC         JP Z, .cbtSkipInactive
2318+ DB2A 47               LD B, A                         ; mapX
2319+ DB2B 23               INC HL
2320+ DB2C 3A AE 82         LD A, (CurrentScreenX)
2321+ DB2F B8               CP B
2322+ DB30 C2 7F DC         JP NZ, .cbtSkipMapY
2323+ DB33 4E               LD C, (HL)                      ; mapY
2324+ DB34 23               INC HL
2325+ DB35 3A AF 82         LD A, (CurrentScreenY)
2326+ DB38 B9               CP C
2327+ DB39 C2 78 DC         JP NZ, .cbtSkipPtr
2328+ DB3C                  ; Pantalla actual: leer ptr
2329+ DB3C E5               PUSH HL                         ; entry en ptr_lo
2330+ DB3D 5E               LD E, (HL)
2331+ DB3E 23               INC HL
2332+ DB3F 56               LD D, (HL)                      ; DE = ptr
2333+ DB40 CD 7C DA         CALL LookupBumpTrigger          ; A = action, C = key
2334+ DB43 B7               OR A
2335+ DB44 CA 77 DC         JP Z, .cbtPopNext               ; no es bump-trigger
2336+ DB47 32 91 DC         LD (.cbtAction), A              ; salvar action (B se reusa abajo)
2337+ DB4A 3A 5E 82         LD A, (CurrentKey)
2338+ DB4D B9               CP C
2339+ DB4E C2 77 DC         JP NZ, .cbtPopNext              ; sin la key correcta
2340+ DB51                  ; Match: cargar sprite para conocer dimensiones y testear AABB.
2341+ DB51                  ; (action ya está en .cbtAction; BC libre para usar como dimensiones)
2342+ DB51 EB               EX DE, HL                       ; HL = sprite ptr
2343+ DB52 3E 03            LD A, 3                         ; PickupTable ptrs viven en bank 3
2344+ DB54 CD 8F 6A         CALL LoadBgSpriteToBuffer
2345+ DB57 21 9B 89         LD HL, BgSpriteBuffer
2346+ DB5A 7E               LD A, (HL)                      ; height_px
2347+ DB5B 32 90 DC         LD (.cbtSpH), A
2348+ DB5E 23               INC HL
2349+ DB5F 7E               LD A, (HL)
2350+ DB60 E6 7F            AND $7F
2351+ DB62 87               ADD A, A                        ; *2
2352+ DB63 87               ADD A, A                        ; *4
2353+ DB64 87               ADD A, A                        ; *8 = width_px
2354+ DB65 32 8F DC         LD (.cbtSpW), A
2355+ DB68                  ; Recuperar charX/charY de la entry (POP HL → entry ptr_lo, +2 = charX)
2356+ DB68 E1               POP HL                          ; HL en ptr_lo
2357+ DB69 E5               PUSH HL                         ; volver a guardar para el handler
2358+ DB6A 23               INC HL
2358+ DB6B 23             INC HL                 ; skip ptr
2359+ DB6C 7E               LD A, (HL)                      ; charX
2360+ DB6D 87               ADD A, A
2360+ DB6E 87             ADD A, A
2360+ DB6F 87             ADD A, A  ; *8 = px_left
2361+ DB70 32 8D DC         LD (.cbtSpX), A
2362+ DB73 23               INC HL
2363+ DB74 7E               LD A, (HL)                      ; charY
2364+ DB75 C6 02            ADD A, BG_Y_OFFSET
2365+ DB77 87               ADD A, A
2365+ DB78 87             ADD A, A
2365+ DB79 87             ADD A, A  ; *8 = px_top
2366+ DB7A 32 8E DC         LD (.cbtSpY), A
2367+ DB7D                  ; AABB overlap test con extensión +SPEED_RUN pixels en cada lado.
2368+ DB7D                  ; Motivo: el motor revierte el movimiento al chocar, dejando al player
2369+ DB7D                  ; hasta 4 px del wall. Sin esta tolerancia, el bump nunca dispararía.
2370+ DB7D                  ; Horizontal: ext_left = max(0, sprite_left - 4), ext_right = min(255, sprite_right + 4).
2371+ DB7D 3A 4E 81         LD A, (EntityTable + ENT_POSX)
2372+ DB80 4F               LD C, A                         ; C = player_left
2373+ DB81 C6 10            ADD A, 16                       ; A = player_right
2374+ DB83 57               LD D, A
2375+ DB84                  ; ext_left: sprite_left - 4 con clamp inferior (sin underflow)
2376+ DB84 3A 8D DC         LD A, (.cbtSpX)
2377+ DB87 D6 04            SUB 4
2378+ DB89 30 01            JR NC, .cbtNoUnderflowL
2379+ DB8B AF               XOR A
2380+ DB8C              .cbtNoUnderflowL:
2381+ DB8C BA               CP D
2382+ DB8D D2 77 DC         JP NC, .cbtPopNext              ; ext_left >= player_right → fuera por la izquierda
2383+ DB90                  ; ext_right: sprite_right + 4 con clamp superior
2384+ DB90 3A 8F DC         LD A, (.cbtSpW)
2385+ DB93 47               LD B, A
2386+ DB94 3A 8D DC         LD A, (.cbtSpX)
2387+ DB97 80               ADD A, B                        ; sprite_right
2388+ DB98 C6 04            ADD A, 4                        ; +4
2389+ DB9A 30 02            JR NC, .cbtNoOverflowR
2390+ DB9C 3E FF            LD A, $FF
