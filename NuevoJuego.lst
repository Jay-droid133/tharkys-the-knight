 270+ EC4D DD 23            INC IX
 270+ EC4F DD 23          INC IX         ; saltar bytes 4-5 (decoración derecha)
 271+ EC51 C1               POP BC
 272+ EC52 E1               POP HL
 273+ EC53 24               INC H
 274+ EC54 0D               DEC C
 275+ EC55 20 E1            JR NZ, .fc22
 276+ EC57
 277+ EC57 26 40            LD H, $40
 278+ EC59 2E 2F            LD L, $2F               ; col 15, scan 0, fila 1
 279+ EC5B 0E 08            LD C, 8
