 129+ F175              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F175              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F175              SFX_FootstepTic:
 132+ F175 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F179 00               DEFB 0                      ; fin
 134+ F17A
 135+ F17A              SFX_FootstepTac:
 136+ F17A 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ F17E 00               DEFB 0                      ; fin
