 236+ F879              ; ==============================================================================
 237+ F879              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 238+ F879              ; ==============================================================================
 239+ F879              ; 1. Consume cheque (CurrentKey = 0).
 240+ F879              ; 2. Snap player a anchor frente a la puerta, facing N.
 241+ F879              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 242+ F879              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 243+ F879              ;    para limpiar la pantalla durante la cutscene.
 244+ F879              ; Destruye: AF, BC, DE, HL, IX.
 245+ F879              ; ==============================================================================
 246+ F879              StartBankCutscene:
 247+ F879 AF               XOR A
 248+ F87A 32 AE 82         LD (CurrentKey), A                  ; consume cheque
 249+ F87D 32 CC 82         LD (BankCutsceneKnockIdx), A
 250+ F880 32 CB 82         LD (BankCutsceneSubState), A
 251+ F883 32 CD 82         LD (BankCutsceneNoIdx), A
 252+ F886 32 CE 82         LD (BankCutsceneHandFrame), A
 253+ F889 CD E7 B9         CALL KillAllActiveNasties           ; nasties → STATE_DYING + puff anim
 254+ F88C CD E5 60         CALL KillDeathIfActive               ; muerte (slot 11) → puff y despawn
 255+ F88F                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 256+ F88F                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 257+ F88F                  ; cambiamos el sprite a facing N para preparar.
 258+ F88F CD EC F8         CALL BankCutsceneFacingNRedraw
 259+ F892 CD D2 FB         CALL SFX_Bank_OnStart
 260+ F895                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 261+ F895                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 262+ F895                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 263+ F895 3E 64            LD A, BCS_T_PUFF_WAIT
 264+ F897 32 CA 82         LD (BankCutsceneTimer), A
 265+ F89A 3E 11            LD A, BCP_WAIT_NASTIES
 266+ F89C 32 C9 82         LD (BankCutscenePhase), A
 267+ F89F C9               RET
 268+ F8A0
