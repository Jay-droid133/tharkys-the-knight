 631+ A521                  ; === STATE_ATTACKING: nasty depredador lanzandose ===
 632+ A521              .peAttacking:
 633+ A521 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 634+ A525 C2 C5 A4         JP NZ, .peFresh
 635+ A528 CD E2 AE         CALL UpdatePredatorAttack
 636+ A52B C3 3F A4         JP .peCalcAndDraw
 637+ A52E
 638+ A52E                  ; === STATE_SCARED: pausa dramatica + huida ===
 639+ A52E              .peScared:
 640+ A52E DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 641+ A532 C2 F7 A5         JP NZ, .peScaredFresh
 642+ A535
 643+ A535                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 644+ A535 3A 35 B8         LD A, (ScareTimer)
 645+ A538 FE 33            CP SCARE_FLEE_THRESHOLD + 1
 646+ A53A DA DA A5         JP C, .peScaredFlee
 647+ A53D                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 648+ A53D                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 649+ A53D DD 36 06 00      LD (IX+ENT_DELTAX), 0
 650+ A541 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 651+ A545                  ; Shake monster-only (nasties durante bells no se agitan)
 652+ A545 DD 7E 01         LD A, (IX+ENT_TYPE)
 653+ A548 FE 02            CP TYPE_MONSTER
 654+ A54A C2 C0 A5         JP NZ, .peScaredSpriteToggle
 655+ A54D                  ; --- Shake ---
 656+ A54D CD 6F 93         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 657+ A550 5F               LD E, A
 658+ A551 16 00            LD D, 0
 659+ A553 21 A0 90         LD HL, MonsterAiFlags
 660+ A556 19               ADD HL, DE
 661+ A557 7E               LD A, (HL)
 662+ A558 CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 663+ A55A 20 15            JR NZ, .peShakeActive
 664+ A55C                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 665+ A55C F6 08            OR MAI_FLAG_SHAKE_SAVED
 666+ A55E 77               LD (HL), A
 667+ A55F 21 97 5F         LD HL, MonsterShakeOrigX
 668+ A562 19               ADD HL, DE
 669+ A563 DD 7E 03         LD A, (IX+ENT_POSX)
 670+ A566 77               LD (HL), A
 671+ A567 21 9A 5F         LD HL, MonsterShakeOrigY
 672+ A56A 19               ADD HL, DE
 673+ A56B DD 7E 04         LD A, (IX+ENT_POSY)
 674+ A56E 77               LD (HL), A
 675+ A56F 18 4F            JR .peScaredSpriteToggle
 676+ A571              .peShakeActive:
 677+ A571                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 678+ A571 ED 5F            LD A, R
 679+ A573 E6 03            AND 3
 680+ A575 28 0C            JR Z, .peShakeUp
 681+ A577 3D               DEC A
 682+ A578 28 0F            JR Z, .peShakeDown
 683+ A57A 3D               DEC A
 684+ A57B 28 12            JR Z, .peShakeLeft
 685+ A57D                  ; 3: right
 686+ A57D 06 01            LD B, 1
 687+ A57F 0E 00            LD C, 0
 688+ A581 18 10            JR .peShakeApply
 689+ A583              .peShakeUp:
 690+ A583 06 00            LD B, 0
 691+ A585 0E FF            LD C, -1
 692+ A587 18 0A            JR .peShakeApply
 693+ A589              .peShakeDown:
 694+ A589 06 00            LD B, 0
 695+ A58B 0E 01            LD C, 1
 696+ A58D 18 04            JR .peShakeApply
 697+ A58F              .peShakeLeft:
 698+ A58F 06 FF            LD B, -1
 699+ A591 0E 00            LD C, 0
 700+ A593              .peShakeApply:
 701+ A593                  ; new POSX = orig + B, new POSY = orig + C
 702+ A593 21 97 5F         LD HL, MonsterShakeOrigX
 703+ A596 19               ADD HL, DE
 704+ A597 7E               LD A, (HL)
 705+ A598 80               ADD A, B
 706+ A599 DD 77 03         LD (IX+ENT_POSX), A
 707+ A59C 21 9A 5F         LD HL, MonsterShakeOrigY
 708+ A59F 19               ADD HL, DE
 709+ A5A0 7E               LD A, (HL)
 710+ A5A1 81               ADD A, C
 711+ A5A2 DD 77 04         LD (IX+ENT_POSY), A
 712+ A5A5                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 713+ A5A5 CD 04 B9         CALL CheckEnemyCollision
 714+ A5A8 28 16            JR Z, .peScaredSpriteToggle
 715+ A5AA                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 716+ A5AA CD 6F 93         CALL MaiGetMonsterSlot
 717+ A5AD 5F               LD E, A
 718+ A5AE 16 00            LD D, 0
 719+ A5B0 21 97 5F         LD HL, MonsterShakeOrigX
 720+ A5B3 19               ADD HL, DE
 721+ A5B4 7E               LD A, (HL)
 722+ A5B5 DD 77 03         LD (IX+ENT_POSX), A
 723+ A5B8 21 9A 5F         LD HL, MonsterShakeOrigY
 724+ A5BB 19               ADD HL, DE
 725+ A5BC 7E               LD A, (HL)
 726+ A5BD DD 77 04         LD (IX+ENT_POSY), A
 727+ A5C0              .peScaredSpriteToggle:
 728+ A5C0                  ; Animacion: toggle L/R cada 8f
 729+ A5C0 DD 35 09         DEC (IX+ENT_ANIMTIMER)
 730+ A5C3 20 12            JR NZ, .peScaredNoFlip
 731+ A5C5 DD 36 09 08      LD (IX+ENT_ANIMTIMER), 8
 732+ A5C9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 733+ A5CC DD 96 08         SUB (IX+ENT_ANIMBASE)
 734+ A5CF EE 02            XOR 2                               ; toggle bit 1: 0↔2 (R↔L)
 735+ A5D1 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
 736+ A5D4 DD 77 00         LD (IX+ENT_SPRITEID), A
 737+ A5D7              .peScaredNoFlip:
 738+ A5D7 C3 3F A4         JP .peCalcAndDraw
 739+ A5DA
 740+ A5DA              .peScaredFlee:
 741+ A5DA                  ; Campanada 5+ / amanecer: huir. Monsters usan UpdateMonsterLeave
