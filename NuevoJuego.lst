 577+ ECB1 C9               RET
 578+ ECB2
 579+ ECB2              ; ==============================================================================
 580+ ECB2              ; UpdateRandomPickup - room-enter hook
 581+ ECB2              ; ==============================================================================
 582+ ECB2              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 583+ ECB2              ; Early-out si ScreenDirty=0 (no transition).
 584+ ECB2              ;
 585+ ECB2              ; En transition:
 586+ ECB2              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 587+ ECB2              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 588+ ECB2              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 589+ ECB2              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 590+ ECB2              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 591+ ECB2              ;
 592+ ECB2              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 593+ ECB2              ; fijos (id, charX, charY, v) terminados con id=$FF.
 594+ ECB2              ;
 595+ ECB2              ; Destruye AF, BC, DE, HL.
 596+ ECB2              ; ==============================================================================
 597+ ECB2              UpdateRandomPickupBody:
 598+ ECB2 3A 12 83         LD A, (ScreenDirty)
 599+ ECB5 B7               OR A
 600+ ECB6 C8               RET Z
 601+ ECB7
 602+ ECB7                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 603+ ECB7 3E FE            LD A, $FE
 604+ ECB9 32 B4 5F         LD (RandomSynthMapX), A
 605+ ECBC AF               XOR A
 606+ ECBD 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 607+ ECC0
 608+ ECC0                  ; --- Scan BG stream, build SlotList ---
 609+ ECC0 AF               XOR A
 610+ ECC1 32 AB 5F         LD (RandomSlotCount), A
 611+ ECC4 2A 0C 83         LD HL, (CurrentScreenAddr)
 612+ ECC7              .urpScanLoop:
 613+ ECC7 7E               LD A, (HL)                          ; A = id
 614+ ECC8 FE FF            CP $FF
 615+ ECCA 28 2A            JR Z, .urpScanDone
 616+ ECCC FE D2            CP RANDOM_SLOT_MARKER
 617+ ECCE 20 20            JR NZ, .urpSkipEntry
 618+ ECD0                  ; Es marker. Cap reached?
 619+ ECD0 3A AB 5F         LD A, (RandomSlotCount)
 620+ ECD3 FE 04            CP RANDOM_SLOT_MAX
 621+ ECD5 30 19            JR NC, .urpSkipEntry
 622+ ECD7                  ; SlotList[count*2] = charX, [count*2+1] = charY
 623+ ECD7 23               INC HL                              ; HL @ charX
 624+ ECD8 46               LD B, (HL)                          ; B = charX
 625+ ECD9 23               INC HL                              ; HL @ charY
 626+ ECDA 4E               LD C, (HL)                          ; C = charY
 627+ ECDB E5               PUSH HL                             ; save HL @ charY
 628+ ECDC 87               ADD A, A                            ; A = count*2
 629+ ECDD 6F               LD L, A
 630+ ECDE 26 00            LD H, 0
 631+ ECE0 11 AC 5F         LD DE, RandomSlotList
 632+ ECE3 19               ADD HL, DE
 633+ ECE4 70               LD (HL), B                          ; charX
 634+ ECE5 23               INC HL
 635+ ECE6 71               LD (HL), C                          ; charY
 636+ ECE7 21 AB 5F         LD HL, RandomSlotCount
 637+ ECEA 34               INC (HL)
 638+ ECEB E1               POP HL                              ; HL @ charY
 639+ ECEC 23               INC HL                              ; HL @ v
 640+ ECED 23               INC HL                              ; HL @ next id
 641+ ECEE 18 D7            JR .urpScanLoop
 642+ ECF0              .urpSkipEntry:
 643+ ECF0                  ; Skip entry: 4 bytes (id, charX, charY, v).
 644+ ECF0 23               INC HL
 644+ ECF1 23             INC HL
 644+ ECF2 23             INC HL
 644+ ECF3 23             INC HL
 645+ ECF4 18 D1            JR .urpScanLoop
 646+ ECF6              .urpScanDone:
 647+ ECF6
 648+ ECF6                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 649+ ECF6 3A AB 5F         LD A, (RandomSlotCount)
 650+ ECF9 B7               OR A
 651+ ECFA CA 80 EE         JP Z, .urpZeroAndRotate
 652+ ECFD
 653+ ECFD                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 654+ ECFD                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 655+ ECFD                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 656+ ECFD 3A 0B 83         LD A, (CurrentScreenY)
 657+ ED00 07               RLCA
 657+ ED01 07             RLCA
 657+ ED02 07             RLCA
 657+ ED03 07             RLCA           ; Y*16
 658+ ED04 21 0A 83         LD HL, CurrentScreenX
 659+ ED07 86               ADD A, (HL)                         ; A = newSid
 660+ ED08 47               LD B, A                             ; B = newSid (preservar)
 661+ ED09 3A D1 5F         LD A, (RP_PrevSid)
 662+ ED0C B8               CP B
 663+ ED0D 20 1A            JR NZ, .urpCacheMiss
 664+ ED0F                  ; HIT prev. Validar slot < count.
 665+ ED0F 3A D2 5F         LD A, (RP_PrevSlot)
 666+ ED12 4F               LD C, A                             ; C = cached slot
 667+ ED13 3A AB 5F         LD A, (RandomSlotCount)
 668+ ED16 B9               CP C
 669+ ED17 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 670+ ED19 38 0E            JR C, .urpCacheMiss
 671+ ED1B                  ; Restaurar: usar cached slot + cached rolled.
 672+ ED1B 79               LD A, C
 673+ ED1C 32 D4 5F         LD (RP_TmpSlot), A
 674+ ED1F 3A D3 5F         LD A, (RP_PrevRolled)
 675+ ED22 32 D5 5F         LD (RP_TmpRolled), A
 676+ ED25 79               LD A, C                             ; A = slot
 677+ ED26 C3 78 ED         JP .urpReadSlotAndDispatchCache
 678+ ED29
 679+ ED29              .urpCacheMiss:
 680+ ED29 3A AB 5F         LD A, (RandomSlotCount)
 681+ ED2C                  ; --- Pick slot via R mod count ---
 682+ ED2C 47               LD B, A                             ; B = count
 683+ ED2D ED 5F            LD A, R
 684+ ED2F              .urpModLoop:
 685+ ED2F 90               SUB B
 686+ ED30 30 FD            JR NC, .urpModLoop
 687+ ED32 80               ADD A, B                            ; A = R mod count, [0..count-1]
 688+ ED33 32 D4 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
 689+ ED36
 690+ ED36                  ; --- Read SlotList[A*2] = (charX, charY) ---
 691+ ED36 87               ADD A, A
 692+ ED37 5F               LD E, A
 693+ ED38 16 00            LD D, 0
 694+ ED3A 21 AC 5F         LD HL, RandomSlotList
 695+ ED3D 19               ADD HL, DE
 696+ ED3E 7E               LD A, (HL)                          ; charX
 697+ ED3F 32 B8 5F         LD (RandomSynthCharX), A
 698+ ED42 23               INC HL
 699+ ED43 7E               LD A, (HL)                          ; charY
 700+ ED44 32 B9 5F         LD (RandomSynthCharY), A
 701+ ED47
 702+ ED47                  ; --- Roll type usando R XOR SYS_FRAMES ---
 703+ ED47                  IF DEBUG_FORCE_COMPASS
 704+ ED47 ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 705+ ED47 ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 706+ ED47 ~                    JP .urpDoCompass
 707+ ED47                  ENDIF
 708+ ED47                  IF DEBUG_FORCE_MUSHROOM
 709+ ED47 ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 710+ ED47 ~                    JP .urpDoMushroom
 711+ ED47                  ENDIF
 712+ ED47                  IF DEBUG_FORCE_ROULETTE
 713+ ED47 ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 714+ ED47 ~                    JP .urpDoRoulette
 715+ ED47                  ENDIF
 716+ ED47                  IF DEBUG_FORCE_COLOR_CHANGER
 717+ ED47 ~                    ; DEBUG: rotar entre RAYO/CARACOL/MUSHROOM al 33% para testar el color
 718+ ED47 ~                    ; cycler. R XOR SYS_FRAMES da pseudo-random uniform 0..255, partido en
 719+ ED47 ~                    ; 3 bandas de 85.3 c/u.
 720+ ED47 ~                    LD A, R
 721+ ED47 ~                    LD HL, $5C78
 722+ ED47 ~                    XOR (HL)
 723+ ED47 ~                    CP 85
 724+ ED47 ~                    JP C, .urpDoRayo
 725+ ED47 ~                    CP 170
 726+ ED47 ~                    JP C, .urpDoCaracol
 727+ ED47 ~                    JP .urpDoMushroom
 728+ ED47                  ENDIF
 729+ ED47                  IF DEBUG_FORCE_NEW_BUFFS
 730+ ED47 ~                    ; DEBUG: rotar entre ESPADA/ESCUDO/ESCUDO_RAYO al 33% para testar
 731+ ED47 ~                    ; fase 3 (buffs nuevos).
 732+ ED47 ~                    LD A, R
 733+ ED47 ~                    LD HL, $5C78
 734+ ED47 ~                    XOR (HL)
 735+ ED47 ~                    CP 85
 736+ ED47 ~                    JP C, .urpDoEspada
 737+ ED47 ~                    CP 170
 738+ ED47 ~                    JP C, .urpDoEscudo
 739+ ED47 ~                    JP .urpDoEscudoRayo
 740+ ED47                  ENDIF
 741+ ED47 ED 5F            LD A, R
 742+ ED49 21 78 5C         LD HL, $5C78
 743+ ED4C AE               XOR (HL)
