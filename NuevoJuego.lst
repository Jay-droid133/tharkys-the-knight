 609+ F013              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ F013              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ F013              ; ==============================================================================
 612+ F013              BuildPlazaScanAddrs:
 613+ F013                  ; Calcular pixel coords del top-left de la esfera
 614+ F013 3A C7 90         LD A, (PlazaClockCharY)
 615+ F016 07               RLCA
 616+ F017 07               RLCA
 617+ F018 07               RLCA
 618+ F019 57               LD D, A                     ; D = pixelY = charY * 8
 619+ F01A 3A C6 90         LD A, (PlazaClockCharX)
 620+ F01D 07               RLCA
 621+ F01E 07               RLCA
 622+ F01F 07               RLCA
 623+ F020 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ F021 CD A6 A0         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ F024
 626+ F024 DD 21 C8 90      LD IX, PlazaScanAddrs
 627+ F028 06 10            LD B, 16
 628+ F02A              .buildLoop:
 629+ F02A DD 75 00         LD (IX+0), L
 630+ F02D DD 74 01         LD (IX+1), H
 631+ F030 DD 23            INC IX
 632+ F032 DD 23            INC IX
 633+ F034 05               DEC B
 634+ F035 C8               RET Z
 635+ F036 CD 12 9E         CALL NextPixelLine
 636+ F039 18 EF            JR .buildLoop
 637+ F03B
 638+ F03B              ; ==============================================================================
 639+ F03B              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ F03B              ; ==============================================================================
 641+ F03B              ; Llamar cada frame desde el main loop.
 642+ F03B              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ F03B              ; ==============================================================================
 644+ F03B              DrawPlazaClock:
 645+ F03B 3A C5 90         LD A, (PlazaClockActive)
 646+ F03E B7               OR A
 647+ F03F C8               RET Z
 648+ F040
 649+ F040                  ; --- Calcular posicion actual de las agujas ---
 650+ F040 3A B2 EB         LD A, (GameHours)
 651+ F043 FE 0C            CP 12
 652+ F045 38 02            JR C, .pCalcHourOk
 653+ F047 D6 0C            SUB 12
 654+ F049              .pCalcHourOk:
 655+ F049 57               LD D, A                     ; D = display hour (0-11)
 656+ F04A 3A B1 EB         LD A, (GameMinutes)
 657+ F04D 1E 00            LD E, 0
 658+ F04F              .pCalcDiv5:
 659+ F04F FE 05            CP 5
 660+ F051 38 05            JR C, .pCalcMinOk
 661+ F053 D6 05            SUB 5
 662+ F055 1C               INC E
 663+ F056 18 F7            JR .pCalcDiv5
 664+ F058              .pCalcMinOk:
 665+ F058                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ F058
 667+ F058                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ F058 3A AC F0         LD A, (PlazaLastHour)
 669+ F05B BA               CP D
 670+ F05C 20 05            JR NZ, .pNeedsRedraw
 671+ F05E 3A AD F0         LD A, (PlazaLastMin)
 672+ F061 BB               CP E
 673+ F062 C8               RET Z                       ; sin cambio → no redibujar
 674+ F063
 675+ F063              .pNeedsRedraw:
 676+ F063 7A               LD A, D
 677+ F064 32 AC F0         LD (PlazaLastHour), A
 678+ F067 7B               LD A, E
 679+ F068 32 AD F0         LD (PlazaLastMin), A
 680+ F06B
 681+ F06B                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ F06B                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ F06B DD 21 9B 8D      LD IX, PlazaClockPixels
 684+ F06F FD 21 C8 90      LD IY, PlazaScanAddrs
 685+ F073 06 10            LD B, 16
 686+ F075              .faceRow:
 687+ F075 FD 6E 00         LD L, (IY+0)
 688+ F078 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ F07B DD 7E 00         LD A, (IX+0)
 690+ F07E 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ F07F 77               LD (HL), A                  ; byte izquierdo
 692+ F080 23               INC HL
 693+ F081 DD 7E 01         LD A, (IX+1)
 694+ F084 2F               CPL
 695+ F085 77               LD (HL), A                  ; byte derecho
 696+ F086 DD 23            INC IX
 697+ F088 DD 23            INC IX
 698+ F08A FD 23            INC IY
 699+ F08C FD 23            INC IY
 700+ F08E 10 E5            DJNZ .faceRow
 701+ F090
 702+ F090                  ; --- Aguja de horas ---
 703+ F090 3A AC F0         LD A, (PlazaLastHour)
 704+ F093 21 AE EC         LD HL, HourHandPtrs
 705+ F096 CD AE F0         CALL DrawPlazaHandLine
 706+ F099
 707+ F099                  ; --- Aguja de minutos ---
 708+ F099 3A AD F0         LD A, (PlazaLastMin)
 709+ F09C 21 CA EB         LD HL, MinHandPtrs
 710+ F09F CD AE F0         CALL DrawPlazaHandLine
 711+ F0A2
 712+ F0A2                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ F0A2 21 D6 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ F0A5 7E               LD A, (HL)
 715+ F0A6 23               INC HL
 716+ F0A7 66               LD H, (HL)
 717+ F0A8 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ F0A9 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ F0AB C9               RET
 720+ F0AC
 721+ F0AC              ; Variables locales reloj plaza
 722+ F0AC FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ F0AD FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ F0AE
 725+ F0AE              ; ==============================================================================
 726+ F0AE              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ F0AE              ; ==============================================================================
 728+ F0AE              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ F0AE              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ F0AE              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ F0AE              ; ==============================================================================
 732+ F0AE              DrawPlazaHandLine:
 733+ F0AE                  ; Indexar en tabla de punteros
 734+ F0AE 87               ADD A, A
 735+ F0AF 4F               LD C, A
 736+ F0B0 06 00            LD B, 0
 737+ F0B2 09               ADD HL, BC
 738+ F0B3 7E               LD A, (HL)
 739+ F0B4 23               INC HL
 740+ F0B5 66               LD H, (HL)
 741+ F0B6 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ F0B7
 743+ F0B7              .pxLoop:
 744+ F0B7 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ F0B8 B7               OR A
 746+ F0B9 C8               RET Z
 747+ F0BA
 748+ F0BA                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ F0BA 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ F0BB 23               INC HL
 751+ F0BC 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ F0BD 23               INC HL
 753+ F0BE 56               LD D, (HL)                  ; D = mask
 754+ F0BF 23               INC HL
 755+ F0C0 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ F0C1
 757+ F0C1                  ; --- Calcular scanLine (0-15) ---
 758+ F0C1 78               LD A, B
 759+ F0C2 E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ F0C4 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ F0C6 28 02            JR Z, .pxIsTop
 762+ F0C8 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ F0CA              .pxIsTop:
 764+ F0CA                  ; A = scanLine (0-15)
 765+ F0CA
 766+ F0CA                  ; --- Calcular colOffset (0 o 1) ---
 767+ F0CA 5F               LD E, A                     ; E = scanLine (guardar)
 768+ F0CB 79               LD A, C
 769+ F0CC E6 1F            AND $1F                     ; extraer columna
 770+ F0CE D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ F0D0 4F               LD C, A                     ; C = colOffset
 772+ F0D1
 773+ F0D1                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ F0D1 7B               LD A, E                     ; A = scanLine
 775+ F0D2 87               ADD A, A                    ; *2 (word index)
 776+ F0D3 21 C8 90         LD HL, PlazaScanAddrs
 777+ F0D6 85               ADD A, L
 778+ F0D7 6F               LD L, A
 779+ F0D8 30 01            JR NC, .pxNC
 780+ F0DA 24               INC H
 781+ F0DB              .pxNC:
 782+ F0DB 7E               LD A, (HL)
 783+ F0DC 23               INC HL
 784+ F0DD 66               LD H, (HL)
 785+ F0DE 81               ADD A, C                    ; sumar colOffset
 786+ F0DF 6F               LD L, A                     ; HL = dir VRAM destino
 787+ F0E0
 788+ F0E0                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ F0E0 7A               LD A, D
 790+ F0E1 2F               CPL
 791+ F0E2 A6               AND (HL)
 792+ F0E3 77               LD (HL), A
 793+ F0E4
 794+ F0E4 E1               POP HL                      ; restaurar puntero datos
 795+ F0E5 18 D0            JR .pxLoop
 796+ F0E7
# file closed: hud_clock.asm
 385  F0E7                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ F0E7              ; ==============================================================================
   2+ F0E7              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ F0E7              ; ==============================================================================
   4+ F0E7              ; CurrentObjective vive en variables.asm. Valor:
   5+ F0E7              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ F0E7              ;   9    = todos los hitos completados (juego ganado)
   7+ F0E7              ;
   8+ F0E7              ; ----------------------------------------------------------------------------
   9+ F0E7              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ F0E7              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ F0E7              ;                       recoger el sprite cuyo behavior coincide.
  12+ F0E7              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ F0E7              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ F0E7              ;                       Avanza al disparar el trigger correspondiente.
  15+ F0E7              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ F0E7              ;
  17+ F0E7              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ F0E7              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ F0E7              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ F0E7              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ F0E7              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ F0E7              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ F0E7              ;
  24+ F0E7              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ F0E7              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ F0E7              ; mecanica real.
  27+ F0E7              ; ==============================================================================
  28+ F0E7
  29+ F0E7              MILESTONE_TYPE_PICKUP   EQU 1
  30+ F0E7              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ F0E7              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ F0E7
  33+ F0E7              MilestoneTable:
  34+ F0E7 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ F0E9 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ F0EB 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ F0ED 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ F0EF 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ F0F1 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ F0F3 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ F0F5 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ F0F7 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ F0F9
  44+ F0F9              MilestoneResolveTable:
  45+ F0F9 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ F0FB 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ F0FD 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ F0FF 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ F101 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ F103 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ F105 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ F107 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ F109 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ F10B
  55+ F10B              ; ==============================================================================
  56+ F10B              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ F10B              ; ==============================================================================
  58+ F10B              ; IN:  A = key id (1..6) recien recogida
  59+ F10B              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ F10B              ; ==============================================================================
  61+ F10B              CheckMilestonePickup:
  62+ F10B E5               PUSH HL
  63+ F10C D5               PUSH DE
  64+ F10D C5               PUSH BC
  65+ F10E F5               PUSH AF
  66+ F10F 47               LD B, A                             ; B = key id recibida
  67+ F110 3A 67 82         LD A, (CurrentObjective)
  68+ F113 FE 09            CP 9
  69+ F115 30 24            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ F117 87               ADD A, A                            ; *2 (entry size)
  71+ F118 6F               LD L, A
  72+ F119 26 00            LD H, 0
  73+ F11B 11 E7 F0         LD DE, MilestoneTable
  74+ F11E 19               ADD HL, DE
  75+ F11F 7E               LD A, (HL)                          ; tipo
  76+ F120 FE 01            CP MILESTONE_TYPE_PICKUP
  77+ F122 20 17            JR NZ, .cmpDone
  78+ F124 23               INC HL
  79+ F125 7E               LD A, (HL)                          ; ref esperada
  80+ F126 B8               CP B
  81+ F127 20 12            JR NZ, .cmpDone
  82+ F129 3A 67 82         LD A, (CurrentObjective)
  83+ F12C 3C               INC A
  84+ F12D 32 67 82         LD (CurrentObjective), A
  85+ F130 CD C8 F1         CALL ResolveObjectiveScreen
  86+ F133 3E FF            LD A, $FF
  87+ F135 32 6A 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ F138 CD 2A 72         CALL CancelMagicCompass             ; magic compass: cancela al cumplir hito
  89+ F13B              .cmpDone:
  90+ F13B F1               POP AF
  91+ F13C C1               POP BC
  92+ F13D D1               POP DE
  93+ F13E E1               POP HL
  94+ F13F C9               RET
  95+ F140
  96+ F140              ; ==============================================================================
  97+ F140              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
  98+ F140              ; ==============================================================================
  99+ F140              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
 100+ F140              ; Preserva: AF, BC, DE, HL.
 101+ F140              ; ==============================================================================
 102+ F140              CheckMilestoneTrigger:
 103+ F140 E5               PUSH HL
 104+ F141 D5               PUSH DE
 105+ F142 C5               PUSH BC
 106+ F143 F5               PUSH AF
 107+ F144 47               LD B, A
 108+ F145 3A 67 82         LD A, (CurrentObjective)
 109+ F148 FE 09            CP 9
 110+ F14A 30 24            JR NC, .cmtDone
 111+ F14C 87               ADD A, A
 112+ F14D 6F               LD L, A
 113+ F14E 26 00            LD H, 0
 114+ F150 11 E7 F0         LD DE, MilestoneTable
 115+ F153 19               ADD HL, DE
 116+ F154 7E               LD A, (HL)
 117+ F155 FE 02            CP MILESTONE_TYPE_TRIGGER
 118+ F157 20 17            JR NZ, .cmtDone
 119+ F159 23               INC HL
 120+ F15A 7E               LD A, (HL)
 121+ F15B B8               CP B
 122+ F15C 20 12            JR NZ, .cmtDone
 123+ F15E 3A 67 82         LD A, (CurrentObjective)
 124+ F161 3C               INC A
 125+ F162 32 67 82         LD (CurrentObjective), A
 126+ F165 CD C8 F1         CALL ResolveObjectiveScreen
 127+ F168 3E FF            LD A, $FF
 128+ F16A 32 6A 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 129+ F16D CD 2A 72         CALL CancelMagicCompass             ; magic compass: cancela al cumplir hito
 130+ F170              .cmtDone:
 131+ F170 F1               POP AF
 132+ F171 C1               POP BC
 133+ F172 D1               POP DE
 134+ F173 E1               POP HL
 135+ F174 C9               RET
 136+ F175
 137+ F175              ; ==============================================================================
 138+ F175              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 139+ F175              ; ==============================================================================
 140+ F175              CheckMilestoneDebugKey:
 141+ F175 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 142+ F177 DB FE            IN A, ($FE)
 143+ F179 CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 144+ F17B 20 20            JR NZ, .cmdkNotPressed
 145+ F17D 3A A2 F1         LD A, (MilestoneKeyDebounce)
 146+ F180 B7               OR A
 147+ F181 C0               RET NZ
 148+ F182 3E 01            LD A, 1
 149+ F184 32 A2 F1         LD (MilestoneKeyDebounce), A
 150+ F187 3A 67 82         LD A, (CurrentObjective)
 151+ F18A FE 09            CP 9
 152+ F18C D0               RET NC
 153+ F18D 3C               INC A
 154+ F18E 32 67 82         LD (CurrentObjective), A
 155+ F191 CD C8 F1         CALL ResolveObjectiveScreen
 156+ F194 3E FF            LD A, $FF
 157+ F196 32 6A 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 158+ F199 CD 2A 72         CALL CancelMagicCompass             ; magic compass: cancela al saltar hito
 159+ F19C C9               RET
 160+ F19D              .cmdkNotPressed:
 161+ F19D AF               XOR A
 162+ F19E 32 A2 F1         LD (MilestoneKeyDebounce), A
 163+ F1A1 C9               RET
 164+ F1A2
 165+ F1A2 00           MilestoneKeyDebounce: DEFB 0
 166+ F1A3
 167+ F1A3              ; ==============================================================================
 168+ F1A3              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 169+ F1A3              ; ==============================================================================
 170+ F1A3              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 171+ F1A3              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 172+ F1A3              ; inmediato del valor actual.
 173+ F1A3              ;
 174+ F1A3              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 175+ F1A3              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 176+ F1A3              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 177+ F1A3              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 178+ F1A3              ; ==============================================================================
 179+ F1A3              CheckCurrentKeyCycleKey:
 180+ F1A3 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 181+ F1A5 DB FE            IN A, ($FE)
 182+ F1A7 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 183+ F1A9 20 17            JR NZ, .ckcNotPressed
 184+ F1AB 3A C7 F1         LD A, (CurrentKeyCycleDebounce)
 185+ F1AE B7               OR A
 186+ F1AF C0               RET NZ
 187+ F1B0 3E 01            LD A, 1
 188+ F1B2 32 C7 F1         LD (CurrentKeyCycleDebounce), A
 189+ F1B5 3A 5E 82         LD A, (CurrentKey)
 190+ F1B8 3C               INC A
 191+ F1B9 FE 07            CP 7
 192+ F1BB 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 193+ F1BD AF               XOR A                               ; 7 -> wrap a 0
 194+ F1BE              .ckcSet:
 195+ F1BE 32 5E 82         LD (CurrentKey), A
 196+ F1C1 C9               RET
 197+ F1C2              .ckcNotPressed:
 198+ F1C2 AF               XOR A
 199+ F1C3 32 C7 F1         LD (CurrentKeyCycleDebounce), A
 200+ F1C6 C9               RET
 201+ F1C7
 202+ F1C7 00           CurrentKeyCycleDebounce: DEFB 0
 203+ F1C8
 204+ F1C8              ; ==============================================================================
 205+ F1C8              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 206+ F1C8              ; ==============================================================================
 207+ F1C8              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 208+ F1C8              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 209+ F1C8              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 210+ F1C8              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 211+ F1C8              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 212+ F1C8              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 213+ F1C8              ;               actuales; queda como salvaguarda.
 214+ F1C8              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 215+ F1C8              ; Destruye: AF, BC, DE, HL.
 216+ F1C8              ; ==============================================================================
 217+ F1C8              ResolveObjectiveScreen:
 218+ F1C8 3A 67 82         LD A, (CurrentObjective)
 219+ F1CB FE 09            CP 9
 220+ F1CD 30 2F            JR NC, .rosNoTarget
 221+ F1CF 87               ADD A, A
 222+ F1D0 6F               LD L, A
 223+ F1D1 26 00            LD H, 0
 224+ F1D3 11 F9 F0         LD DE, MilestoneResolveTable
 225+ F1D6 19               ADD HL, DE
 226+ F1D7 7E               LD A, (HL)                          ; tipo
 227+ F1D8 23               INC HL
 228+ F1D9 46               LD B, (HL)                          ; B = ref
 229+ F1DA FE 01            CP MILESTONE_TYPE_PICKUP
 230+ F1DC 28 06            JR Z, .rosPickup
 231+ F1DE FE 02            CP MILESTONE_TYPE_TRIGGER
 232+ F1E0 28 08            JR Z, .rosTrigger
 233+ F1E2 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 234+ F1E4              .rosPickup:
 235+ F1E4 78               LD A, B
 236+ F1E5 CD 07 F2         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 237+ F1E8 18 08            JR .rosFindPos
