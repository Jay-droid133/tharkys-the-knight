 726+ 90CB              .mosModDone:
 727+ 90CB                  ; A = target idx 0..matches-1. Descartar stack ANTES de moverlo a C,
 728+ 90CB                  ; porque POP BC machaca C (bug anterior: target se perdia, siempre idx 0).
 729+ 90CB C1               POP BC                          ; discard saved total count
 730+ 90CC E1               POP HL                          ; HL = first entry ptr again
 731+ 90CD 4F               LD C, A                         ; C = target match index
 732+ 90CE 06 00            LD B, 0                         ; B = matches seen so far
