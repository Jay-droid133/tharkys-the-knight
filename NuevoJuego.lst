 539+ FA55              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 540+ FA55              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 541+ FA55              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 542+ FA55              .bcPhWait3:
 543+ FA55 CD C9 FB         CALL BankCutsceneDecTimer
 544+ FA58 C0               RET NZ
 545+ FA59 CD E3 FB         CALL SFX_Bank_OnDoorCreak
 546+ FA5C 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 547+ FA5E 32 CA 82         LD (BankCutsceneTimer), A
 548+ FA61 3E 0A            LD A, BCP_PRE_HAND
 549+ FA63 32 C9 82         LD (BankCutscenePhase), A
 550+ FA66 C9               RET
 551+ FA67
 552+ FA67              ; ---- Phase 10: hold corto antes de la mano ----
 553+ FA67              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 554+ FA67              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 555+ FA67              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 556+ FA67              .bcPhPreHand:
 557+ FA67 CD C9 FB         CALL BankCutsceneDecTimer
 558+ FA6A C0               RET NZ
 559+ FA6B AF               XOR A
 560+ FA6C 32 CE 82         LD (BankCutsceneHandFrame), A
 561+ FA6F 32 CD 82         LD (BankCutsceneNoIdx), A
 562+ FA72 CD 6B FB         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 563+ FA75 CD A9 FB         CALL BankCutsceneDrawHand           ; frame 0 sobre area en negro
 564+ FA78 CD E4 FB         CALL SFX_Bank_OnHandIn
 565+ FA7B                  ; HAND_IN saltado — la mano arranca el ciclo "no no" inmediatamente
 566+ FA7B                  ; tras aparecer (sin pausa quieta). Para revertir: usar BCS_T_HAND_IN
 567+ FA7B                  ; + BCP_HAND_IN aqui en vez de NO_FRAME + HAND_NO_NO.
 568+ FA7B 3E 0C            LD A, BCS_T_NO_FRAME
 569+ FA7D 32 CA 82         LD (BankCutsceneTimer), A
 570+ FA80 3E 0C            LD A, BCP_HAND_NO_NO
 571+ FA82 32 C9 82         LD (BankCutscenePhase), A
 572+ FA85 C9               RET
 573+ FA86
 574+ FA86              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 575+ FA86              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 576+ FA86              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 577+ FA86              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 578+ FA86              .bcPhHandIn:
 579+ FA86 CD C9 FB         CALL BankCutsceneDecTimer
 580+ FA89 C0               RET NZ
 581+ FA8A 3E 0C            LD A, BCS_T_NO_FRAME
 582+ FA8C 32 CA 82         LD (BankCutsceneTimer), A
 583+ FA8F 3E 0C            LD A, BCP_HAND_NO_NO
 584+ FA91 32 C9 82         LD (BankCutscenePhase), A
 585+ FA94 C9               RET
 586+ FA95
 587+ FA95              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 588+ FA95              .bcPhHandNoNo:
 589+ FA95 CD C9 FB         CALL BankCutsceneDecTimer
 590+ FA98 C0               RET NZ
 591+ FA99                  ; Swap frame: erase actual + draw el otro.
 592+ FA99 CD C6 FB         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 593+ FA9C 3A CE 82         LD A, (BankCutsceneHandFrame)
 594+ FA9F EE 01            XOR 1
 595+ FAA1 32 CE 82         LD (BankCutsceneHandFrame), A
 596+ FAA4 CD A9 FB         CALL BankCutsceneDrawHand           ; draw frame nuevo
 597+ FAA7 CD EA FB         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 598+ FAAA                  ; Increment swap idx, check completion.
 599+ FAAA 3A CD 82         LD A, (BankCutsceneNoIdx)
 600+ FAAD 3C               INC A
 601+ FAAE 32 CD 82         LD (BankCutsceneNoIdx), A
 602+ FAB1 FE 08            CP BCS_NO_SWAPS_TOTAL
 603+ FAB3 38 0B            JR C, .bcNoNoMoreSwaps
 604+ FAB5                  ; Todos los swaps hechos — pausa antes de erase mano.
 605+ FAB5 3E 0F            LD A, BCS_T_HAND_HOLD
 606+ FAB7 32 CA 82         LD (BankCutsceneTimer), A
 607+ FABA                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 608+ FABA                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 609+ FABA 3E 0D            LD A, BCP_HAND_OUT
 610+ FABC 32 C9 82         LD (BankCutscenePhase), A
 611+ FABF C9               RET
 612+ FAC0              .bcNoNoMoreSwaps:
 613+ FAC0 3E 0C            LD A, BCS_T_NO_FRAME
 614+ FAC2 32 CA 82         LD (BankCutsceneTimer), A
 615+ FAC5 C9               RET
 616+ FAC6
 617+ FAC6              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 618+ FAC6              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 619+ FAC6              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 620+ FAC6              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 621+ FAC6              ; del pickup dormant).
 622+ FAC6              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 623+ FAC6              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 624+ FAC6              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 625+ FAC6              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 626+ FAC6              ; de la llave.
 627+ FAC6              .bcPhHandOut:
 628+ FAC6 CD C9 FB         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 629+ FAC9 C0               RET NZ
 630+ FACA CD C6 FB         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 631+ FACD CD 8D FB         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 632+ FAD0 CD FD FB         CALL SFX_Bank_OnHandOut             ; SFX cierre de puerta (placeholder hoy)
 633+ FAD3 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 634+ FAD5 32 CA 82         LD (BankCutsceneTimer), A
 635+ FAD8 3E 12            LD A, BCP_DOOR_CLOSED
 636+ FADA 32 C9 82         LD (BankCutscenePhase), A
 637+ FADD C9               RET
 638+ FADE
 639+ FADE              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 640+ FADE              .bcPhDoorClosed:
 641+ FADE CD C9 FB         CALL BankCutsceneDecTimer
 642+ FAE1 C0               RET NZ
 643+ FAE2                  ; --- Spawn de la llave de la ciudad ---
 644+ FAE2 3E 01            LD A, 1
 645+ FAE4 32 C2 82         LD (TownGateKeySpawned), A
 646+ FAE7 21 7F F7         LD HL, SFX_KeyDrop
 647+ FAEA CD 41 F6         CALL PlaySFX
