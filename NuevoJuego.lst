1089+ CF86                  ; --- AABB-check 4x4 erase rect vs PickupRectCache ---
1090+ CF86                  ; Si solapa con algun pickup activo, set PickupAttrsDirty=1 para que
1091+ CF86                  ; RefreshPickupAttrs (post-ProcessEnemies) repinte. Sin overlap = no-op.
1092+ CF86 3A 29 82         LD A, (NumPickupsCached)
1093+ CF89 B7               OR A
1094+ CF8A C8               RET Z
1095+ CF8B 47               LD B, A                             ; B = entries
1096+ CF8C 21 2A 82         LD HL, PickupRectCache
1097+ CF8F              .roaAabbLoop:
1098+ CF8F                  ; (HL+0)=pX, (HL+1)=pY, (HL+2)=pXEnd, (HL+3)=pYEnd.
1099+ CF8F                  ; eraseRect = [eX..eX+3] × [eY..eY+3].
1100+ CF8F                  ; Overlap: pX <= eX+3 AND pXEnd >= eX AND pY <= eY+3 AND pYEnd >= eY.
1101+ CF8F                  ; eX+3 < pX -> no overlap (X)
1102+ CF8F 3A D2 CF         LD A, (.roaEraseX)
1103+ CF92 C6 03            ADD A, 3
1104+ CF94 BE               CP (HL)
1105+ CF95 38 34            JR C, .roaAabbNext
1106+ CF97 23               INC HL                              ; pY
1107+ CF98                  ; eY+3 < pY -> no overlap (Y)
1108+ CF98 3A D3 CF         LD A, (.roaEraseY)
1109+ CF9B C6 03            ADD A, 3
1110+ CF9D BE               CP (HL)
1111+ CF9E 38 25            JR C, .roaAabbNext1
1112+ CFA0 23               INC HL                              ; pXEnd
1113+ CFA1                  ; pXEnd < eX -> no overlap
1114+ CFA1 7E               LD A, (HL)
1115+ CFA2 4F               LD C, A
1116+ CFA3 3A D2 CF         LD A, (.roaEraseX)
1117+ CFA6 B9               CP C
1118+ CFA7 28 02            JR Z, .roaAabbXEndOk
1119+ CFA9 30 15            JR NC, .roaAabbNext2
1120+ CFAB              .roaAabbXEndOk:
1121+ CFAB 23               INC HL                              ; pYEnd
1122+ CFAC                  ; pYEnd < eY -> no overlap
1123+ CFAC 7E               LD A, (HL)
1124+ CFAD 4F               LD C, A
1125+ CFAE 3A D3 CF         LD A, (.roaEraseY)
1126+ CFB1 B9               CP C
1127+ CFB2 28 02            JR Z, .roaAabbHit
1128+ CFB4 30 06            JR NC, .roaAabbNext3
1129+ CFB6              .roaAabbHit:
1130+ CFB6 3E 01            LD A, 1
1131+ CFB8 32 28 82         LD (PickupAttrsDirty), A
1132+ CFBB C9               RET                                 ; flag set, no need to check more
1133+ CFBC              .roaAabbNext3:
1134+ CFBC 23               INC HL                              ; advance to next entry's pX
1135+ CFBD 10 D0            DJNZ .roaAabbLoop
1136+ CFBF C9               RET
1137+ CFC0              .roaAabbNext2:
1138+ CFC0 23               INC HL
1138+ CFC1 23             INC HL                     ; from pXEnd to next pX
1139+ CFC2 10 CB            DJNZ .roaAabbLoop
1140+ CFC4 C9               RET
1141+ CFC5              .roaAabbNext1:
1142+ CFC5 23               INC HL
1142+ CFC6 23             INC HL
1142+ CFC7 23             INC HL            ; from pY to next pX
1143+ CFC8 10 C5            DJNZ .roaAabbLoop
1144+ CFCA C9               RET
1145+ CFCB              .roaAabbNext:
1146+ CFCB 11 04 00         LD DE, 4                            ; from pX to next pX
1147+ CFCE 19               ADD HL, DE
1148+ CFCF 10 BE            DJNZ .roaAabbLoop
1149+ CFD1 C9               RET
1150+ CFD2 00           .roaEraseX: DEFB 0
1151+ CFD3 00           .roaEraseY: DEFB 0
