 333+ 6A62              ; DrawPendingTomb - Pinta tumba in-place tras la animacion de muerte
 334+ 6A62              ; ==============================================================================
 335+ 6A62              ; Llamado desde MainLoop tras ProcessPlayer. Si TombDrawPending=1: ProcessPlayer
 336+ 6A62              ; en este frame hizo XOR-erase del sprite de muerte (ya invisible), asi que
 337+ 6A62              ; dibujar la tumba en (CorpseX, CorpseY) la deja "in-place" sobre la sala
 338+ 6A62              ; actual. Consume el flag.
 339+ 6A62              ;
 340+ 6A62              ; Tras el draw, parchea CleanAttrMap con los 6 chars (3x2) que ocupa la tumba
 341+ 6A62              ; para que RestoreOldAttr (entidades que pisen la tumba) preserve sus attrs
 342+ 6A62              ; en vez del BG original. Al re-entrar a la sala, DrawTombstonesInRoom +
 343+ 6A62              ; SaveCleanAttrs vuelve a sincronizar todo.
 344+ 6A62              ; ==============================================================================
 345+ 6A62              DrawPendingTomb:
 346+ 6A62 3A ED 82         LD A, (TombDrawPending)
 347+ 6A65 B7               OR A
 348+ 6A66 C8               RET Z
 349+ 6A67 AF               XOR A
 350+ 6A68 32 ED 82         LD (TombDrawPending), A             ; consumir
 351+ 6A6B
 352+ 6A6B 21 00 EA         LD HL, BgGfx_tomb
 353+ 6A6E 3E 03            LD A, 3
 354+ 6A70 CD CA 67         CALL LoadBgSpriteToBuffer
 355+ 6A73
 356+ 6A73 3A EA 82         LD A, (CorpseX)
 357+ 6A76 CB 3F            SRL A
 358+ 6A78 CB 3F            SRL A
 359+ 6A7A CB 3F            SRL A                               ; x_char = posX / 8
 360+ 6A7C 47               LD B, A
 361+ 6A7D 3A EB 82         LD A, (CorpseY)
 362+ 6A80 C6 05            ADD A, 5                            ; tomb 16px alineada a base del player 21px
 363+ 6A82 CB 3F            SRL A
 364+ 6A84 CB 3F            SRL A
 365+ 6A86 CB 3F            SRL A                               ; abs_char_y = (posY+5) / 8
 366+ 6A88 D6 02            SUB BG_Y_OFFSET                     ; DrawBgGfxSprite re-suma BG_Y_OFFSET
 367+ 6A8A 4F               LD C, A
 368+ 6A8B DD 21 EE 86      LD IX, BgSpriteBuffer
 369+ 6A8F CD 63 D1         CALL DrawBgGfxSprite
 370+ 6A92
 371+ 6A92                  ; Override attrs cyan fijo (sin remap day/night) + patch CleanAttrMap
 372+ 6A92 3A EA 82         LD A, (CorpseX)
 373+ 6A95 47               LD B, A
 374+ 6A96 3A EB 82         LD A, (CorpseY)
 375+ 6A99 C6 05            ADD A, 5                            ; mismo offset que el draw
