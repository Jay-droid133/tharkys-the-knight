 292+ 683E              ; ==============================================================================
 293+ 683E              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 294+ 683E              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 295+ 683E              ; ==============================================================================
 296+ 683E              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 297+ 683E              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 298+ 683E              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 299+ 683E              ; uniformemente negro -- el efecto que pidio el usuario.
 300+ 683E              ;
 301+ 683E              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 302+ 683E              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 303+ 683E              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 304+ 683E              ; Destruye: AF, BC, DE, HL.
 305+ 683E              ; ==============================================================================
 306+ 683E              ClearSmokeAttrs:
 307+ 683E                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 308+ 683E 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 309+ 6841 CB 3F            SRL A
 309+ 6843 CB 3F          SRL A
 309+ 6845 CB 3F          SRL A                   ; A = char Y (post-HUD)
 310+ 6847 26 00            LD H, 0
 311+ 6849 6F               LD L, A
 312+ 684A 29               ADD HL, HL                              ; *2
 313+ 684B 29               ADD HL, HL                              ; *4
 314+ 684C 29               ADD HL, HL                              ; *8
 315+ 684D 29               ADD HL, HL                              ; *16
 316+ 684E 29               ADD HL, HL                              ; *32
 317+ 684F 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 318+ 6852 CB 3F            SRL A
 318+ 6854 CB 3F          SRL A
 318+ 6856 CB 3F          SRL A                   ; A = char X
 319+ 6858 5F               LD E, A
 320+ 6859 16 00            LD D, 0
 321+ 685B 19               ADD HL, DE
 322+ 685C 11 00 58         LD DE, $5800
 323+ 685F 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 324+ 6860 AF               XOR A                                   ; paper black, ink black
 325+ 6861 77               LD (HL), A                              ; (charY, charX)
 326+ 6862 23               INC HL
 327+ 6863 77               LD (HL), A                              ; (charY, charX+1)
 328+ 6864 11 1F 00         LD DE, 31
 329+ 6867 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 330+ 6868 77               LD (HL), A
 331+ 6869 23               INC HL
 332+ 686A 77               LD (HL), A                              ; (charY+1, charX+1)
 333+ 686B C9               RET
