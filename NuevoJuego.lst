1316+ D080                  ; Iterar sprites del room (formato Stage A: DEFB id, x, y, v; $FF = end)
1317+ D080 2A 1F 82         LD HL, (CurrentScreenAddr)
1318+ D083              .bcmLoop:
1319+ D083 7E               LD A, (HL)                  ; A = id
1320+ D084 23               INC HL
