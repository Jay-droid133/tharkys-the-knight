 216  70D8                  ; --- Music IRQ handler + driver musica (slot 1) ---
 217  70D8                  ; Tabla IM 2 en $7A00, JP en $7B7B, handler en $7B7E. State + tablas + tick
 218  70D8                  ; al final del archivo. Ver music_irq.asm. Independiza el ritmo musical de
 219  70D8                  ; la latencia de MainLoop sin paginar slot 3 desde el handler.
 220  70D8                  INCLUDE "music_irq.asm"
# file opened: music_irq.asm
   1+ 70D8              ; ==============================================================================
   2+ 70D8              ; MUSIC_IRQ - IM 2 handler para tick de musica a 25 Hz
   3+ 70D8              ; ==============================================================================
   4+ 70D8              ; Vive en slot 1 ($7A00+, contended pero siempre visible).
   5+ 70D8              ;
   6+ 70D8              ; Por que existe: la latencia de MainLoop (especialmente en transiciones de
   7+ 70D8              ; pantalla, ~200 ms) provocaba que la musica avanzara N notas en una sola
   8+ 70D8              ; iteracion, escribiendo solo el ultimo period al AY. El usuario percibia
   9+ 70D8              ; notas "saltadas" o ritmo desplazado. Con IM 2 + handler propio, el tick de
  10+ 70D8              ; musica ocurre cada 2 IRQs (= 25 Hz) independientemente de la carga del
  11+ 70D8              ; MainLoop. Las escrituras AY caen en el wall-clock exacto, ritmo intacto.
  12+ 70D8              ;
  13+ 70D8              ; IM 2 setup (Inicio):
  14+ 70D8              ;   I = $7A
  15+ 70D8              ;   Tabla 257 bytes en $7A00-$7B00, todos $7B (cualquier byte del data bus
  16+ 70D8              ;     da vector = $7B7B).
  17+ 70D8              ;   $7B7B: JP MusicIrqHandler.
  18+ 70D8              ;
  19+ 70D8              ; Race condition con AY desde MainLoop: las rutinas que escriben AY desde
  20+ 70D8              ; gameplay (StartMusic thunk, AY_PlayBeep, AY_PlayBellChime, etc.) ya hacen
  21+ 70D8              ; DI/EI alrededor de sus AY OUTs, asi que no son interrumpidas. Las
  22+ 70D8              ; escrituras AY desde el IRQ handler no necesitan DI extra (CPU ya tiene
  23+ 70D8              ; interrupts deshabilitados al entrar al handler).
  24+ 70D8              ; ==============================================================================
  25+ 70D8
  26+ 70D8              ; --- Vector table (257 bytes all $7B) ---
  27+ 70D8              ; Cualquier byte del data bus da vector = $7B7B (.im2Vector).
  28+ 70D8                  ORG $7A00
  29+ 7A00              .im2Table:
  30+ 7A00 7B 7B 7B...      DEFS 257, $7B                       ; $7A00-$7B00 inclusive
  31+ 7B01
  32+ 7B01              ; --- Vector target: JP MusicIrqHandler ---
  33+ 7B01                  ORG $7B7B
  34+ 7B7B              .im2Vector:
  35+ 7B7B C3 7E 7B         JP MusicIrqHandler
  36+ 7B7E
  37+ 7B7E              ; --- IRQ handler proper ---
  38+ 7B7E              ; Cada IRQ:
  39+ 7B7E              ;   1. INC $5C78 (system frames counter — ROM IRQ no se ejecuta con IM 2).
  40+ 7B7E              ;   2. Toggle MusicIrqDivisor: solo tickea musica cada 2 IRQs (= 25 Hz).
  41+ 7B7E              ;   3. Si toca tick: CALL UpdateMusicTick (en slot 1, sin paginar nada).
  42+ 7B7E              ;   4. EI + RET.
  43+ 7B7E              ;
  44+ 7B7E              ; Atomicidad: el handler NO toca slot 3, asi que los PUSH/POP del propio
  45+ 7B7E              ; handler operan sobre el mismo bank fisico de principio a fin —
  46+ 7B7E              ; inmune al race con MainLoop que paga slots sin DI.
  47+ 7B7E              ;
  48+ 7B7E              ; Coste: ~80 T-states en frame skip (no tick), ~250 T-states en frame tick.
  49+ 7B7E              ; Per-second: ~12500 T = 0.36% del CPU. Despreciable.
  50+ 7B7E              MusicIrqHandler:
  51+ 7B7E F5               PUSH AF
  52+ 7B7F C5               PUSH BC
  53+ 7B80 D5               PUSH DE
  54+ 7B81 E5               PUSH HL
  55+ 7B82
  56+ 7B82                  ; --- Increment $5C78 ---
  57+ 7B82 21 78 5C         LD HL, $5C78
  58+ 7B85 34               INC (HL)
  59+ 7B86 20 02            JR NZ, .mihNoWrap
  60+ 7B88 23               INC HL
  61+ 7B89 34               INC (HL)
  62+ 7B8A              .mihNoWrap:
  63+ 7B8A
  64+ 7B8A                  ; --- Toggle divisor (25 Hz) ---
  65+ 7B8A 21 A5 7B         LD HL, MusicIrqDivisor
  66+ 7B8D 7E               LD A, (HL)
  67+ 7B8E EE 01            XOR 1
  68+ 7B90 77               LD (HL), A
  69+ 7B91 28 0C            JR Z, .mihEpilogue
  70+ 7B93
  71+ 7B93                  ; --- Tick SFX + MUSICA (slot 1, siempre visible). ---
  72+ 7B93                  ; SFX countdown (Beep, PlayerHit) tickea aqui para inmunizar la duracion
  73+ 7B93                  ; al wall-clock (commit 1759338: "TIC del compass no se estira en
  74+ 7B93                  ; transiciones").
  75+ 7B93                  ;
  76+ 7B93                  ; La MUSICA tambien tickea aqui (avance de nota + re-arm AY). Asi el ritmo
  77+ 7B93                  ; sigue exacto durante DrawScreen/transiciones de pantalla, donde MainLoop
  78+ 7B93                  ; queda bloqueado varios frames y antes la nota actual se "alargaba" hasta
  79+ 7B93                  ; que MainLoop volvia y hacia catchup.
  80+ 7B93                  ;
  81+ 7B93                  ; Concurrencia AY: TODAS las escrituras al AY desde MainLoop estan
  82+ 7B93                  ; envueltas en DI/EI (auditoria en ay_sound_thunks.asm + sfx_player_hit_ay
  83+ 7B93                  ; .asm). Por tanto el handler IRQ nunca cae a media secuencia
  84+ 7B93                  ; select($FFFD)+data($BFFD) y no corrompe el index del AY.
  85+ 7B93                  ;
  86+ 7B93                  ; Inline tick: equivale a CALL UpdateMusicTick pero ahorra el stub (-3 B).
  87+ 7B93 CD 26 6B         CALL AY_UpdateSFX               ; sistema data-driven (sfx_interp.asm).
  88+ 7B96                                                  ; AY_UpdatePlayerHit legacy eliminado Fase 5c
  89+ 7B96                                                  ; (no quedaban callers tras la migracion).
  90+ 7B96 CD 0D 7E         CALL UpdateMusicImpl.upmiTickOnce
  91+ 7B99 CD A0 7D         CALL UpdateMusicImpl.upmiPostLoop
  92+ 7B9C CD 84 7F         CALL BellTickIrq                ; decay de la campana (movido aqui desde
  93+ 7B9F                                                  ; bank 4 para no perderse en transiciones)
