 201  8039 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 202  803C ED 78            IN A, (C)
 203  803E CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 204  8040 C2 37 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 205  8043                  ; SPACE pulsado: reset total -> JP Inicio
 206  8043 F3               DI
 207  8044 31 58 FF         LD SP, SP_ADDRESS
 208  8047 C3 00 60         JP Inicio
