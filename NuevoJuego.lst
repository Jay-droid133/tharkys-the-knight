 485+ 931E              ; MaiPickRandomGap
 486+ 931E              ; ==============================================================================
 487+ 931E              ; Selecciona un opening aleatorio del screen actual (ScreenGaps en bank 6) y
 488+ 931E              ; traduce (side, coord) a posicion pixel con MAI_ENTRY_OFFSET aplicado.
 489+ 931E              ;
 490+ 931E              ; Output:
 491+ 931E              ;   A = 0 exito; (MaiSpawnX), (MaiSpawnY) contienen posicion spawn
 492+ 931E              ;   A = 1 no hay gaps validos; el caller debe usar fallback (LastEntryPos)
 493+ 931E              ; Destruye: AF, BC, DE, HL
 494+ 931E              ; ==============================================================================
 495+ 931E              MaiPickRandomGap:
 496+ 931E                  ; screen_id = Y * 16 + X
 497+ 931E 3A AF 82         LD A, (CurrentScreenY)
 498+ 9321 07               RLCA
