 163  6AC8                  ; --- SFX generico data-driven (sfx_interp.asm + sfx_data.asm) ---
 164  6AC8                  ; Interprete + tabla de SFX compilada desde code/sfx_library.json por
 165  6AC8                  ; tools/build_sfx.py. Fase 2: coexiste con sfx_player_hit_ay (legacy).
 166  6AC8                  ; UpdateSFX se hookea en MusicIrqHandler en Fase 3 (al migrar primer SFX).
 167  6AC8                  INCLUDE "sfx_interp.asm"
# file opened: sfx_interp.asm
   1+ 6AC8              ; ==============================================================================
   2+ 6AC8              ; sfx_interp.asm - Generic AY SFX interpreter (slot 1, always visible)
   3+ 6AC8              ; ==============================================================================
   4+ 6AC8              ; Walks an opcode stream emitted by tools/build_sfx.py from
   5+ 6AC8              ; code/sfx_library.json. Single active SFX. While playing, AySfxChannelMask
   6+ 6AC8              ; lists reserved channels (bit 0=A, 1=B, 2=C, 3=Noise) so the music driver
   7+ 6AC8              ; can suppress its own writes on those channels (hook to be added later in
   8+ 6AC8              ; MusicAdvanceNote).
   9+ 6AC8              ;
  10+ 6AC8              ; Public API:
  11+ 6AC8              ;   AY_PlaySFX   A = SFX id (0..AYSFX_COUNT-1)        — start
  12+ 6AC8              ;   AY_StopSFX                                      — external halt
  13+ 6AC8              ;   AY_UpdateSFX                                    — per-tick (called from IRQ)
  14+ 6AC8              ;
  15+ 6AC8              ; AY writes: direct OUT to $FFFD/$BFFD (no paging — slot 1 always visible).
  16+ 6AC8              ; Caller manages DI/EI: AY_PlaySFX/AY_StopSFX DI around their writes; AY_UpdateSFX
  17+ 6AC8              ; runs inside MusicIrqHandler (IFF=0 already).
  18+ 6AC8              ;
  19+ 6AC8              ; Opcode IDs must match tools/build_sfx.py OPCODES dict. Args are arranged
  20+ 6AC8              ; so HL walks the stream forwards with INC HL between bytes.
  21+ 6AC8              ; ==============================================================================
  22+ 6AC8
  23+ 6AC8              SFXCMD_END        EQU $00
  24+ 6AC8              SFXCMD_WAIT       EQU $01    ; frames(1)
  25+ 6AC8              SFXCMD_TONE       EQU $02    ; ch(1) period(2)
  26+ 6AC8              SFXCMD_VOL        EQU $03    ; ch(1) v(1)
  27+ 6AC8              SFXCMD_MIXER      EQU $04    ; mask(1)
  28+ 6AC8              SFXCMD_NOISE      EQU $05    ; period(1)
  29+ 6AC8              SFXCMD_ENV_SHAPE  EQU $06    ; shape(1)
  30+ 6AC8              SFXCMD_ENV_PERIOD EQU $07    ; period(2)
  31+ 6AC8              SFXCMD_SWEEP_TONE EQU $08    ; ch(1) from(2) delta(2) frames(1)
  32+ 6AC8              SFXCMD_SWEEP_VOL  EQU $09    ; ch(1) from_fp(2) delta(2) frames(1)   8.8 fp
  33+ 6AC8
  34+ 6AC8              ; --- State (10 B) ---
  35+ 6AC8 00 00        AySfxPtr:           DEFW 0    ; current cmd ptr (0 = inactive)
  36+ 6ACA 00           AySfxChannelMask:   DEFB 0    ; reserved channels (bit 0=A 1=B 2=C 3=N)
  37+ 6ACB 00           AySfxWait:          DEFB 0    ; frames remaining in current WAIT / SWEEP
  38+ 6ACC 00           AySfxSweepKind:     DEFB 0    ; 0=none, 1=tone, 2=vol
  39+ 6ACD 00           AySfxSweepCh:       DEFB 0    ; channel 0/1/2
  40+ 6ACE 00 00        AySfxSweepCur:      DEFW 0    ; current value (16-bit; 8.8 fp for vol sweep)
  41+ 6AD0 00 00        AySfxSweepDelta:    DEFW 0    ; signed delta per frame
  42+ 6AD2
  43+ 6AD2              ; ==============================================================================
  44+ 6AD2              ; AY_PlaySFX - Start a SFX by id. Stops any active SFX first.
  45+ 6AD2              ; ==============================================================================
  46+ 6AD2              ; IN: A = SFX id. >= AYSFX_COUNT -> no-op. Destroys: A, BC, DE, HL.
  47+ 6AD2              ; ==============================================================================
  48+ 6AD2              AY_PlaySFX:
  49+ 6AD2 FE 0D            CP AYSFX_COUNT
  50+ 6AD4 D0               RET NC
  51+ 6AD5 F3               DI
  52+ 6AD6 47               LD B, A                         ; B = id (preserved through StopInternal)
  53+ 6AD7 CD FD 6A         CALL _sfxStopInternal           ; mute previous, clear state
  54+ 6ADA                  ; --- Load channel mask ---
  55+ 6ADA 21 8A 6C         LD HL, AySfxChannelMaskTable
  56+ 6ADD 58               LD E, B
  57+ 6ADE 16 00            LD D, 0
  58+ 6AE0 19               ADD HL, DE
  59+ 6AE1 7E               LD A, (HL)
  60+ 6AE2 32 CA 6A         LD (AySfxChannelMask), A
  61+ 6AE5                  ; --- Load data ptr from AySfxTable[id*2] ---
  62+ 6AE5 21 70 6C         LD HL, AySfxTable
  63+ 6AE8 78               LD A, B
  64+ 6AE9 87               ADD A, A
  65+ 6AEA 5F               LD E, A
  66+ 6AEB 16 00            LD D, 0
  67+ 6AED 19               ADD HL, DE
  68+ 6AEE 5E               LD E, (HL)
  69+ 6AEF 23               INC HL
  70+ 6AF0 56               LD D, (HL)
  71+ 6AF1 ED 53 C8 6A      LD (AySfxPtr), DE
  72+ 6AF5 FB               EI
  73+ 6AF6 C9               RET
  74+ 6AF7
  75+ 6AF7              ; ==============================================================================
  76+ 6AF7              ; AY_StopSFX - External halt entry (e.g. on player death, scene change).
  77+ 6AF7              ; ==============================================================================
  78+ 6AF7              AY_StopSFX:
  79+ 6AF7 F3               DI
  80+ 6AF8 CD FD 6A         CALL _sfxStopInternal
  81+ 6AFB FB               EI
  82+ 6AFC C9               RET
  83+ 6AFD
  84+ 6AFD              ; --- Internal: mute reserved channels + clear state. Caller wraps DI/EI. ---
  85+ 6AFD              ; Destroys: A, BC, DE, HL.
  86+ 6AFD              _sfxStopInternal:
  87+ 6AFD 3A CA 6A         LD A, (AySfxChannelMask)
  88+ 6B00 B7               OR A
  89+ 6B01 28 13            JR Z, .ssiClear
  90+ 6B03 57               LD D, A                         ; D = mask (shift through bits 0..2)
  91+ 6B04 0E 08            LD C, 8                         ; C = AY R8/R9/R10 (vol A/B/C)
  92+ 6B06              .ssiMuteLoop:
  93+ 6B06 CB 3A            SRL D
  94+ 6B08 30 06            JR NC, .ssiSkip
  95+ 6B0A 79               LD A, C
  96+ 6B0B 1E 00            LD E, 0
  97+ 6B0D CD 54 6C         CALL _sfxWriteAy
  98+ 6B10              .ssiSkip:
  99+ 6B10 0C               INC C
 100+ 6B11 79               LD A, C
 101+ 6B12 FE 0B            CP 11
 102+ 6B14 38 F0            JR C, .ssiMuteLoop
 103+ 6B16              .ssiClear:
 104+ 6B16 AF               XOR A
 105+ 6B17 67               LD H, A
 106+ 6B18 6F               LD L, A
 107+ 6B19 22 C8 6A         LD (AySfxPtr), HL                 ; mark inactive
 108+ 6B1C 32 CA 6A         LD (AySfxChannelMask), A
 109+ 6B1F 32 CB 6A         LD (AySfxWait), A
 110+ 6B22 32 CC 6A         LD (AySfxSweepKind), A
 111+ 6B25 C9               RET
 112+ 6B26
 113+ 6B26              ; ==============================================================================
 114+ 6B26              ; AY_UpdateSFX - Per-tick advance. Called from MusicIrqHandler (IFF=0, 25 Hz).
 115+ 6B26              ; ==============================================================================
 116+ 6B26              ; If AySfxWait > 0: decrement, apply active sweep if any.
 117+ 6B26              ; If AySfxWait = 0: fetch and execute next commands until WAIT/SWEEP/END.
 118+ 6B26              ; Destroys: A, BC, DE, HL.
 119+ 6B26              ; ==============================================================================
 120+ 6B26              AY_UpdateSFX:
 121+ 6B26 2A C8 6A         LD HL, (AySfxPtr)
 122+ 6B29 7C               LD A, H
 123+ 6B2A B5               OR L
 124+ 6B2B C8               RET Z                           ; inactive
 125+ 6B2C
 126+ 6B2C 3A CB 6A         LD A, (AySfxWait)
 127+ 6B2F B7               OR A
 128+ 6B30 CA 67 6B         JP Z, _sfxFetchCmds
 129+ 6B33
 130+ 6B33 3D               DEC A
 131+ 6B34 32 CB 6A         LD (AySfxWait), A
 132+ 6B37 3A CC 6A         LD A, (AySfxSweepKind)
 133+ 6B3A 3D               DEC A
 134+ 6B3B 28 04            JR Z, _sfxApplyToneSweep
 135+ 6B3D 3D               DEC A
 136+ 6B3E 28 13            JR Z, _sfxApplyVolSweep
 137+ 6B40 C9               RET                             ; pure WAIT, no sweep
 138+ 6B41
 139+ 6B41              _sfxApplyToneSweep:
 140+ 6B41 2A CE 6A         LD HL, (AySfxSweepCur)
 141+ 6B44 ED 5B D0 6A      LD DE, (AySfxSweepDelta)
 142+ 6B48 19               ADD HL, DE
 143+ 6B49 22 CE 6A         LD (AySfxSweepCur), HL
 144+ 6B4C 3A CD 6A         LD A, (AySfxSweepCh)
 145+ 6B4F 47               LD B, A
 146+ 6B50 C3 5F 6C         JP _sfxWriteToneAyIrq           ; tail call
 147+ 6B53
 148+ 6B53              _sfxApplyVolSweep:
 149+ 6B53 2A CE 6A         LD HL, (AySfxSweepCur)
 150+ 6B56 ED 5B D0 6A      LD DE, (AySfxSweepDelta)
 151+ 6B5A 19               ADD HL, DE
 152+ 6B5B 22 CE 6A         LD (AySfxSweepCur), HL
 153+ 6B5E 3A CD 6A         LD A, (AySfxSweepCh)
 154+ 6B61 C6 08            ADD A, 8                        ; R8/9/10
 155+ 6B63 5C               LD E, H                         ; hi byte (8.8 fp) = current volume
 156+ 6B64 C3 54 6C         JP _sfxWriteAy                  ; tail call
 157+ 6B67
 158+ 6B67              ; ==============================================================================
 159+ 6B67              ; _sfxFetchCmds - Execute commands until something yields (WAIT/SWEEP/END).
 160+ 6B67              ; ==============================================================================
 161+ 6B67              ; HL preloaded with AySfxPtr (set by caller via memory; we reload).
 162+ 6B67              ; Destroys: A, BC, DE, HL.
 163+ 6B67              ; ==============================================================================
 164+ 6B67              _sfxFetchCmds:
 165+ 6B67 AF               XOR A
 166+ 6B68 32 CC 6A         LD (AySfxSweepKind), A            ; cleared until a SWEEP cmd sets it
 167+ 6B6B 2A C8 6A         LD HL, (AySfxPtr)
 168+ 6B6E              .fcNext:
 169+ 6B6E 7E               LD A, (HL)
 170+ 6B6F 23               INC HL
 171+ 6B70 FE 00            CP SFXCMD_END
 172+ 6B72 28 27            JR Z, .fcCmdEnd
 173+ 6B74 FE 01            CP SFXCMD_WAIT
 174+ 6B76 28 26            JR Z, .fcCmdWait
 175+ 6B78 FE 02            CP SFXCMD_TONE
 176+ 6B7A 28 2B            JR Z, .fcCmdTone
 177+ 6B7C FE 03            CP SFXCMD_VOL
 178+ 6B7E 28 36            JR Z, .fcCmdVol
 179+ 6B80 FE 04            CP SFXCMD_MIXER
 180+ 6B82 28 41            JR Z, .fcCmdMixer
 181+ 6B84 FE 05            CP SFXCMD_NOISE
 182+ 6B86 28 48            JR Z, .fcCmdNoise
 183+ 6B88 FE 06            CP SFXCMD_ENV_SHAPE
 184+ 6B8A 28 4F            JR Z, .fcCmdEnvShape
 185+ 6B8C FE 07            CP SFXCMD_ENV_PERIOD
 186+ 6B8E CA E6 6B         JP Z, .fcCmdEnvPeriod
 187+ 6B91 FE 08            CP SFXCMD_SWEEP_TONE
 188+ 6B93 CA FC 6B         JP Z, .fcCmdSweepTone
