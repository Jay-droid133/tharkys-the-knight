 238+ D313              ; ==============================================================================
 239+ D313              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 240+ D313              ; ==============================================================================
 241+ D313              ; Entrada: A = attr original
 242+ D313              ; Salida:  A = attr transformado
 243+ D313              ; Preserva: HL, DE, BC, IX
 244+ D313              ; ==============================================================================
 245+ D313              ApplyDayCycleRemap:
 246+ D313 E5               PUSH HL
 247+ D314 67               LD H, A                     ; H = attr (temp save)
 248+ D315 3A DF D1         LD A, (CurrentTimeOfDay)
 249+ D318 B7               OR A
 250+ D319 20 03            JR NZ, .doRemap
 251+ D31B 7C               LD A, H                     ; Dia: devolver sin cambio
 252+ D31C E1               POP HL
 253+ D31D C9               RET
 254+ D31E
 255+ D31E              .doRemap:
 256+ D31E D5               PUSH DE
 257+ D31F C5               PUSH BC
 258+ D320
 259+ D320 7C               LD A, H                     ; A = attr original
 260+ D321 4F               LD C, A                     ; C = attr original
 261+ D322
 262+ D322                  ; Guardar flash + ink (bits 7, 2-0)
 263+ D322 E6 87            AND $87                     ; A = F000_0III
 264+ D324 47               LD B, A                     ; B = flash | ink
 265+ D325
 266+ D325                  ; Extraer paper+bright como indice 0-15
 267+ D325 79               LD A, C
 268+ D326 E6 78            AND $78                     ; A = 0BPPP000
 269+ D328 0F               RRCA
 270+ D329 0F               RRCA
 271+ D32A 0F               RRCA                        ; A = 0000BPPP = indice
 272+ D32B
 273+ D32B                  ; Elegir tabla segun tipo de sprite
 274+ D32B 5F               LD E, A
 275+ D32C 16 00            LD D, 0
 276+ D32E 3A E4 D1         LD A, (BgSpriteIsHouse)
 277+ D331 B7               OR A
 278+ D332 28 05            JR Z, .useStdTable
 279+ D334 2A E2 D1         LD HL, (CurrentHouseRemapTable)
 280+ D337 18 03            JR .doLookup
 281+ D339              .useStdTable:
 282+ D339 2A E0 D1         LD HL, (CurrentRemapTable)
 283+ D33C              .doLookup:
 284+ D33C 19               ADD HL, DE
 285+ D33D 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 286+ D33E
 287+ D33E                  ; Reconstruir atributo
 288+ D33E 07               RLCA
 289+ D33F 07               RLCA
 290+ D340 07               RLCA                        ; A = 0BPPP000
 291+ D341 B0               OR B                        ; A = FBPPPIII
 292+ D342
 293+ D342 C1               POP BC
 294+ D343 D1               POP DE
 295+ D344 E1               POP HL
 296+ D345 C9               RET
 297+ D346
 298+ D346              ; ==============================================================================
 299+ D346              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 300+ D346              ; ==============================================================================
 301+ D346              ; Entrada: A = sprite ID
 302+ D346              ; Setea BgSpriteIsHouse (0 o 1)
 303+ D346              ; Preserva: A, DE, IX
 304+ D346              ;
 305+ D346              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 306+ D346              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 307+ D346              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 308+ D346              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 309+ D346              ; ==============================================================================
 310+ D346              CheckIfHouseSprite:
 311+ D346 F5               PUSH AF
 312+ D347 E5               PUSH HL
 313+ D348 C5               PUSH BC
 314+ D349
 315+ D349 47               LD B, A                     ; B = id buscado
 316+ D34A
 317+ D34A AF               XOR A
 318+ D34B 32 E4 D1         LD (BgSpriteIsHouse), A     ; Default: no es house
 319+ D34E
 320+ D34E 21 07 CF         LD HL, HouseIdList
 321+ D351              .checkLoop:
 322+ D351 7E               LD A, (HL)
 323+ D352 FE FF            CP $FF
 324+ D354 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 325+ D356 B8               CP B
 326+ D357 28 03            JR Z, .checkFound
 327+ D359 23               INC HL
 328+ D35A 18 F5            JR .checkLoop
 329+ D35C
 330+ D35C              .checkFound:
 331+ D35C 3E 01            LD A, 1
 332+ D35E 32 E4 D1         LD (BgSpriteIsHouse), A
 333+ D361
 334+ D361              .checkDone:
 335+ D361 C1               POP BC
 336+ D362 E1               POP HL
 337+ D363 F1               POP AF
 338+ D364 C9               RET
 339+ D365
 340+ D365              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 341+ D365              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 342+ D365              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 343+ D365
 344+ D365              ; ==============================================================================
 345+ D365              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 346+ D365              ; ==============================================================================
 347+ D365              ; Formato: XX,YY:NN nombre_room     DY
 348+ D365              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 349+ D365              ; ==============================================================================
 350+ D365              DrawRoomInfo:
 351+ D365                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 352+ D365 1E 00            LD E, 0
 353+ D367 06 0D            LD B, 13
 354+ D369              .clearLoop:
 355+ D369 C5               PUSH BC
 356+ D36A D5               PUSH DE
 357+ D36B 3E 20            LD A, ' '
 358+ D36D CD EA D4         CALL DrawHudChar
 359+ D370 D1               POP DE
 360+ D371 C1               POP BC
 361+ D372 1C               INC E
 362+ D373 10 F4            DJNZ .clearLoop
 363+ D375
 364+ D375                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 365+ D375 3A E3 81         LD A, (CurrentScreenX)
 366+ D378 1E 00            LD E, 0
 367+ D37A CD D8 D3         CALL .drawDec2
 368+ D37D
 369+ D37D                  ; --- ',' en col 2 ---
 370+ D37D 3E 2C            LD A, ','
 371+ D37F 1E 02            LD E, 2
 372+ D381 CD EA D4         CALL DrawHudChar
 373+ D384
 374+ D384                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 375+ D384 3A E4 81         LD A, (CurrentScreenY)
 376+ D387 1E 03            LD E, 3
 377+ D389 CD D8 D3         CALL .drawDec2
 378+ D38C
 379+ D38C                  ; --- ':' en col 5 ---
 380+ D38C 3E 3A            LD A, ':'
 381+ D38E 1E 05            LD E, 5
 382+ D390 CD EA D4         CALL DrawHudChar
 383+ D393
 384+ D393                  ; --- Obtener room index de MapTable[Y*16+X] ---
 385+ D393 3A E4 81         LD A, (CurrentScreenY)
 386+ D396 6F               LD L, A
 387+ D397 26 00            LD H, 0
 388+ D399 29               ADD HL, HL
 389+ D39A 29               ADD HL, HL
 390+ D39B 29               ADD HL, HL
 391+ D39C 29               ADD HL, HL                  ; HL = Y * 16
 392+ D39D 3A E3 81         LD A, (CurrentScreenX)
 393+ D3A0 5F               LD E, A
 394+ D3A1 16 00            LD D, 0
 395+ D3A3 19               ADD HL, DE                  ; HL = Y*16 + X
 396+ D3A4 11 BF CD         LD DE, MapTable
 397+ D3A7 19               ADD HL, DE
 398+ D3A8 7E               LD A, (HL)                  ; A = room index (0-47)
 399+ D3A9 F5               PUSH AF                     ; guardar room index
 400+ D3AA
 401+ D3AA                  ; --- Room index como 2 hex en cols 6-7 ---
 402+ D3AA F5               PUSH AF
 403+ D3AB 0F               RRCA
 404+ D3AC 0F               RRCA
 405+ D3AD 0F               RRCA
 406+ D3AE 0F               RRCA
 407+ D3AF E6 0F            AND $0F
 408+ D3B1 CD F6 D3         CALL .hexToAscii
 409+ D3B4 1E 06            LD E, 6
 410+ D3B6 CD EA D4         CALL DrawHudChar
 411+ D3B9 F1               POP AF
 412+ D3BA E6 0F            AND $0F
 413+ D3BC CD F6 D3         CALL .hexToAscii
 414+ D3BF 1E 07            LD E, 7
 415+ D3C1 CD EA D4         CALL DrawHudChar
 416+ D3C4
 417+ D3C4                  ; --- Espacio en col 8 ---
 418+ D3C4 3E 20            LD A, ' '
 419+ D3C6 1E 08            LD E, 8
 420+ D3C8 CD EA D4         CALL DrawHudChar
 421+ D3CB
 422+ D3CB                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 423+ D3CB F1               POP AF                      ; A = room index (descartar)
 424+ D3CC
 425+ D3CC                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 426+ D3CC 21 20 58         LD HL, ATTR_BASE + 1 * 32
 427+ D3CF 3E 47            LD A, $47                   ; bright white on black
 428+ D3D1 06 0D            LD B, 13
 429+ D3D3              .attrLoop:
 430+ D3D3 77               LD (HL), A
 431+ D3D4 23               INC HL
 432+ D3D5 10 FC            DJNZ .attrLoop
 433+ D3D7 C9               RET
 434+ D3D8
 435+ D3D8              ; --- Helpers ---
 436+ D3D8              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 437+ D3D8              .drawDec2:
 438+ D3D8 4B               LD C, E                     ; guardar columna inicial
 439+ D3D9 06 00            LD B, 0                     ; decenas
 440+ D3DB              .divLoop:
 441+ D3DB FE 0A            CP 10
 442+ D3DD 38 05            JR C, .divDone
 443+ D3DF D6 0A            SUB 10
 444+ D3E1 04               INC B
 445+ D3E2 18 F7            JR .divLoop
 446+ D3E4              .divDone:
 447+ D3E4                  ; B = decenas, A = unidades
 448+ D3E4 F5               PUSH AF                     ; guardar unidades
 449+ D3E5 78               LD A, B
 450+ D3E6 C6 30            ADD A, '0'
 451+ D3E8 59               LD E, C
 452+ D3E9 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 453+ D3EA CD EA D4         CALL DrawHudChar
 454+ D3ED C1               POP BC                      ; restaurar C
 455+ D3EE F1               POP AF
 456+ D3EF C6 30            ADD A, '0'
 457+ D3F1 59               LD E, C
 458+ D3F2 1C               INC E
 459+ D3F3 C3 EA D4         JP DrawHudChar              ; tail call
 460+ D3F6
 461+ D3F6              .hexToAscii:
 462+ D3F6 FE 0A            CP 10
 463+ D3F8 38 03            JR C, .isDigit
 464+ D3FA C6 37            ADD A, 'A' - 10
 465+ D3FC C9               RET
 466+ D3FD              .isDigit:
 467+ D3FD C6 30            ADD A, '0'
 468+ D3FF C9               RET
