 131  63E8
 132  63E8                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 133  63E8                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 134  63E8                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 135  63E8                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 136  63E8                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 137  63E8                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 63E8              ; ==============================================================================
   2+ 63E8              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 63E8              ; ==============================================================================
   4+ 63E8              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 63E8              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 63E8              ; la cinematica — invisible porque es one-shot.
   7+ 63E8              ;
   8+ 63E8              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 63E8              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 63E8              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 63E8              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 63E8              ; ==============================================================================
  13+ 63E8
  14+ 63E8              ; ==============================================================================
  15+ 63E8              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 63E8              ; ==============================================================================
  17+ 63E8              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 63E8              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 63E8              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 63E8              ; ChurchCutsceneSlot.
  21+ 63E8              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 63E8              ; ==============================================================================
  23+ 63E8              EraseChurchTrappedMonster:
  24+ 63E8 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 63EB 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 63EC 6F               LD L, A
  27+ 63ED 26 00            LD H, 0
  28+ 63EF 29               ADD HL, HL
  29+ 63F0 29               ADD HL, HL
  30+ 63F1 29               ADD HL, HL
  31+ 63F2 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 63F3 11 A3 81         LD DE, EntityTable
  33+ 63F6 19               ADD HL, DE
  34+ 63F7 E5               PUSH HL
  35+ 63F8 DD E1            POP IX
  36+ 63FA CD 23 A5         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 63FD DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 6400 57               LD D, A
  39+ 6401 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 6404 5F               LD E, A
  41+ 6405 DD 2A AB A4      LD IX, (OldSprAddr)
  42+ 6409 C3 EF 99         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 640C
  44+ 640C              ; ==============================================================================
  45+ 640C              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 640C              ; ==============================================================================
  47+ 640C              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 640C              ; - Despawn monster (ENT_TYPE=0).
  49+ 640C              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 640C              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 640C              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 640C              ; ==============================================================================
  53+ 640C              ApplyChurchTrapDone:
  54+ 640C                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 640C 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 640F 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 6410 6F               LD L, A
  58+ 6411 26 00            LD H, 0
