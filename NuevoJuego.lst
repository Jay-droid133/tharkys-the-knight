3622+ B676              ; ==============================================================================
3623+ B676              ; UpdateNastyFlee - Huida con colision, evasion del player y backtracking
3624+ B676              ; ==============================================================================
3625+ B676              ; IX = entidad nasty en STATE_SCARED.
3626+ B676              ; Persistencia: continua en la direccion actual si sigue pasable.
3627+ B676              ; Si bloqueado: recalcula con 4 candidatos (hacia bordes + opuestos).
3628+ B676              ; Prioridad: pasable+sin_player > pasable > no moverse.
3629+ B676              ; Si llega al borde, pone NastyFleeDespawn=1 para que ProcessOneEnemy lo borre.
3630+ B676              ; ==============================================================================
3631+ B676              UpdateNastyFlee:
3632+ B676                  ; --- Posicion del player ---
3633+ B676 3A 4E 81         LD A, (EntityTable + ENT_POSX)
3634+ B679 32 F3 B8         LD (.flPX), A
3635+ B67C 3A 4F 81         LD A, (EntityTable + ENT_POSY)
3636+ B67F 32 F4 B8         LD (.flPY), A
3637+ B682
3638+ B682                  ; --- Persistencia: intentar continuar en la direccion actual ---
3639+ B682 DD 56 06         LD D, (IX+ENT_DELTAX)
3640+ B685 DD 5E 07         LD E, (IX+ENT_DELTAY)
3641+ B688 7A               LD A, D
3642+ B689 B3               OR E
3643+ B68A 28 06            JR Z, .flRecalc                 ; Sin direccion → recalcular
3644+ B68C CD 23 B8         CALL .flTryPassable
3645+ B68F CA AD B7         JP Z, .flApply                  ; Sigue pasable → continuar
3646+ B692
3647+ B692              .flRecalc:
3648+ B692                  ; --- Borde horizontal mas cercano ---
3649+ B692 DD 7E 03         LD A, (IX+ENT_POSX)
