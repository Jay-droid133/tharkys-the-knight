 374+ 9F3C              _SaveEntityAttrImpl:
 375+ 9F3C                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9F3C DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9F3F 47               LD B, A
 378+ 9F40 7B               LD A, E                     ; X pixel (raw)
 379+ 9F41 E6 07            AND 7
 380+ 9F43 28 01            JR Z, .noExtraW
 381+ 9F45 04               INC B                       ; +1 columna si no alineado
 382+ 9F46              .noExtraW:
 383+ 9F46 78               LD A, B
 384+ 9F47 32 AC 9F         LD (EntityAttrW), A
