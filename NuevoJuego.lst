# file closed: milestones.asm
 241  F109                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 242  F109                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F109              ; ==============================================================================
   2+ F109              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F109              ; ==============================================================================
   4+ F109              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F109              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F109              ;
   7+ F109              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F109              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F109              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F109              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F109              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F109              ; ==============================================================================
  13+ F109
  14+ F109              ; ==============================================================================
  15+ F109              ; PlaySFX - Reproduce un efecto de sonido
  16+ F109              ; ==============================================================================
  17+ F109              ; Entrada: HL = puntero a datos del efecto
  18+ F109              ; Modifica: AF, BC, DE, HL
  19+ F109              ; ==============================================================================
  20+ F109              PlaySFX:
  21+ F109 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F10A 3A 43 90         LD A, (CurrentBorderColor)
  23+ F10D E6 07            AND $07                     ; Solo bits de color del borde
  24+ F10F 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F110
  26+ F110              .nextStep:
  27+ F110 7E               LD A, (HL)                  ; Leer duration
  28+ F111 B7               OR A
  29+ F112 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F114
  31+ F114 47               LD B, A                     ; B = duration (bucle externo)
  32+ F115 23               INC HL
  33+ F116 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F117 23               INC HL
  35+ F118 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F119 23               INC HL
  37+ F11A 7E               LD A, (HL)                  ; A = flags
  38+ F11B 23               INC HL
  39+ F11C E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F11D CB 47            BIT 0, A
  41+ F11F 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F121
  43+ F121              ; --- Bucle de tono normal ---
  44+ F121              .toneLoop:
  45+ F121                  ; Semi-periodo HIGH
  46+ F121 7B               LD A, E
  47+ F122 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F124 D3 FE            OUT ($FE), A
  49+ F126 79               LD A, C                     ; A = pitch actual
  50+ F127              .toneDelayHi:
  51+ F127 3D               DEC A
  52+ F128 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F12A
  54+ F12A                  ; Semi-periodo LOW
  55+ F12A 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F12B D3 FE            OUT ($FE), A
  57+ F12D 79               LD A, C
  58+ F12E              .toneDelayLo:
  59+ F12E 3D               DEC A
  60+ F12F 20 FD            JR NZ, .toneDelayLo
  61+ F131
  62+ F131                  ; Aplicar pitch sweep
  63+ F131 79               LD A, C
  64+ F132 82               ADD A, D                    ; pitch += pitchDelta
  65+ F133 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F135 FA 3D F1         JP M, .toneClamp            ; evitar pitch negativo
  67+ F138 4F               LD C, A
  68+ F139              .toneAfterClamp:
  69+ F139 10 E6            DJNZ .toneLoop
  70+ F13B 18 30            JR .stepDone
  71+ F13D
  72+ F13D              .toneClamp:
  73+ F13D 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F13F 18 F8            JR .toneAfterClamp
  75+ F141
  76+ F141              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F141              .noiseLoop:
  78+ F141                  ; Semi-periodo HIGH con ruido
  79+ F141 7B               LD A, E
  80+ F142 F6 10            OR $10
  81+ F144 D3 FE            OUT ($FE), A
  82+ F146 ED 5F            LD A, R                     ; R register como PRNG
  83+ F148 A9               XOR C                       ; mezclar con pitch base
  84+ F149 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F14B F6 01            OR $01                      ; minimo 1
  86+ F14D              .noiseDelayHi:
  87+ F14D 3D               DEC A
  88+ F14E 20 FD            JR NZ, .noiseDelayHi
  89+ F150
  90+ F150                  ; Semi-periodo LOW
  91+ F150 7B               LD A, E
  92+ F151 D3 FE            OUT ($FE), A
  93+ F153 ED 5F            LD A, R
  94+ F155 A9               XOR C
  95+ F156 E6 1F            AND $1F
  96+ F158 F6 01            OR $01
  97+ F15A              .noiseDelayLo:
  98+ F15A 3D               DEC A
  99+ F15B 20 FD            JR NZ, .noiseDelayLo
 100+ F15D
 101+ F15D                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F15D 79               LD A, C
 103+ F15E 82               ADD A, D
 104+ F15F 28 08            JR Z, .noiseClamp
 105+ F161 FA 69 F1         JP M, .noiseClamp
 106+ F164 4F               LD C, A
 107+ F165              .noiseAfterClamp:
 108+ F165 10 DA            DJNZ .noiseLoop
 109+ F167 18 04            JR .stepDone
 110+ F169
 111+ F169              .noiseClamp:
 112+ F169 0E 01            LD C, 1
 113+ F16B 18 F8            JR .noiseAfterClamp
 114+ F16D
 115+ F16D              .stepDone:
 116+ F16D E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F16E 18 A0            JR .nextStep
 118+ F170
 119+ F170              .done:
 120+ F170 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F171 D3 FE            OUT ($FE), A
 122+ F173 FB               EI
 123+ F174 C9               RET
 124+ F175
 125+ F175              ; ==============================================================================
 126+ F175              ; DATOS DE EFECTOS DE SONIDO
 127+ F175              ; ==============================================================================
