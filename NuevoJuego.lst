 198+ 9E08 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9E09 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9E0A AE               XOR (HL)                    ; XOR con VRAM
 201+ 9E0B 77               LD (HL), A                  ; Escribir
 202+ 9E0C 2C               INC L                       ; Siguiente columna VRAM
 203+ 9E0D 04               INC B                       ; Pagina overflow
 204+ 9E0E 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9E0F AE               XOR (HL)                    ; XOR con VRAM
 206+ 9E10 77               LD (HL), A                  ; Escribir
 207+ 9E11 05               DEC B                       ; Restaurar pagina high
 208+ 9E12 13               INC DE                      ; Siguiente byte de sprite
