4851+ B9C3 47               LD B, A
4852+ B9C4              .spawnDirOk:
4853+ B9C4 78               LD A, B
4854+ B9C5 32 EF 82         LD (LastSpawnDirSigns), A
4855+ B9C8
4856+ B9C8                  ; Inicializar old pos = pos actual
4857+ B9C8 DD 7E 03         LD A, (IX+ENT_POSX)
4858+ B9CB DD 77 0C         LD (IX+ENT_OLDX), A
4859+ B9CE DD 77 0F         LD (IX+ENT_DRAWX), A
4860+ B9D1 DD 7E 04         LD A, (IX+ENT_POSY)
4861+ B9D4 DD 77 0D         LD (IX+ENT_OLDY), A
4862+ B9D7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4863+ B9DA DD 77 0E         LD (IX+ENT_OLDSPRID), A
4864+ B9DD                  ; SFX de spawn
4865+ B9DD 21 C1 F9         LD HL, SFX_EnemySpawn
4866+ B9E0 CD 24 F9         CALL PlaySFX
4867+ B9E3 C9               RET
4868+ B9E4
4869+ B9E4              ; ==============================================================================
4870+ B9E4              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4871+ B9E4              ; ==============================================================================
4872+ B9E4              UpdateEnemySpeed:
4873+ B9E4 3A E6 BC         LD A, (DayCycleCount)
4874+ B9E7 3D               DEC A                               ; 0-based index
4875+ B9E8 FE 0A            CP 10
4876+ B9EA 38 02            JR C, .uesOk
4877+ B9EC 3E 09            LD A, 9                             ; Cap en indice 9
4878+ B9EE              .uesOk:
4879+ B9EE F5               PUSH AF                             ; Guardar indice para tabla de anim
4880+ B9EF 21 12 BA         LD HL, EnemySpeedTable
4881+ B9F2 5F               LD E, A
4882+ B9F3 16 00            LD D, 0
4883+ B9F5 19               ADD HL, DE
4884+ B9F6 7E               LD A, (HL)                          ; A = velocidad × 2
4885+ B9F7                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4886+ B9F7 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4887+ B9F9 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4888+ B9FB                  ; Hay fraccion .5: alternar +1 en frames impares
4889+ B9FB 47               LD B, A                             ; B = parte entera
4890+ B9FC 3A 91 81         LD A, (GameFrameCounter)
4891+ B9FF E6 01            AND 1                               ; 0 en par, 1 en impar
4892+ BA01 80               ADD A, B                            ; Sumar 0 o 1
4893+ BA02              .uesNoFrac:
4894+ BA02 32 4E 8D         LD (CurrentEnemySpeed), A
4895+ BA05                  ; Leer delay de animacion para este ciclo
4896+ BA05 F1               POP AF                              ; A = indice 0-based
4897+ BA06 21 1C BA         LD HL, EnemyAnimDelayTable
4898+ BA09 5F               LD E, A
4899+ BA0A 16 00            LD D, 0
4900+ BA0C 19               ADD HL, DE
4901+ BA0D 7E               LD A, (HL)
4902+ BA0E 32 4F 8D         LD (CurrentEnemyAnimDelay), A
4903+ BA11 C9               RET
4904+ BA12
4905+ BA12              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4906+ BA12              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4907+ BA12              EnemySpeedTable:
4908+ BA12 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4909+ BA13 05               DEFB 5                              ; Ciclo 2: 2.5px
4910+ BA14 06               DEFB 6                              ; Ciclo 3: 3px
4911+ BA15 07               DEFB 7                              ; Ciclo 4: 3.5px
4912+ BA16 08               DEFB 8                              ; Ciclo 5: 4px
4913+ BA17 09               DEFB 9                              ; Ciclo 6: 4.5px
4914+ BA18 0A               DEFB 10                             ; Ciclo 7: 5px
4915+ BA19 0B               DEFB 11                             ; Ciclo 8: 5.5px
4916+ BA1A 0C               DEFB 12                             ; Ciclo 9: 6px
4917+ BA1B 0E               DEFB 14                             ; Ciclo 10: 7px
4918+ BA1C
4919+ BA1C              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4920+ BA1C              ; La rata usara la mitad de estos valores
4921+ BA1C              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4922+ BA1C 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4923+ BA1D 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4924+ BA1E 03               DEFB 3                              ; Ciclo 3 (era 6)
4925+ BA1F 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4926+ BA20 02               DEFB 2                              ; Ciclo 5 (era 4)
4927+ BA21 02               DEFB 2                              ; Ciclo 6 (era 4)
4928+ BA22 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4929+ BA23 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4930+ BA24 01               DEFB 1                              ; Ciclo 9 (era 2)
4931+ BA25 01               DEFB 1                              ; Ciclo 10 (era 2)
4932+ BA26
4933+ BA26              ; ==============================================================================
4934+ BA26              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4935+ BA26              ; ==============================================================================
4936+ BA26              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4937+ BA26              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4938+ BA26              ; ==============================================================================
4939+ BA26              KillAllActiveNasties:
4940+ BA26 DD 21 04 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4941+ BA2A 06 03            LD B, NUM_NASTIES
4942+ BA2C              .kanLoop:
4943+ BA2C C5               PUSH BC
4944+ BA2D DD 7E 01         LD A, (IX+ENT_TYPE)
4945+ BA30 B7               OR A
4946+ BA31 28 26            JR Z, .kanSkip                  ; slot vacio
4947+ BA33 FE 03            CP TYPE_NASTY
4948+ BA35 20 22            JR NZ, .kanSkip                 ; no es nasty
4949+ BA37 DD 7E 02         LD A, (IX+ENT_STATE)
4950+ BA3A FE 03            CP STATE_DYING
4951+ BA3C 28 1B            JR Z, .kanSkip                  ; ya muriendo
4952+ BA3E                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4953+ BA3E                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4954+ BA3E                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4955+ BA3E                  ; del nasty: peDying paintea el rect del puff con ese color)
4956+ BA3E CD 62 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4957+ BA41 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4958+ BA45 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4959+ BA49 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4960+ BA4D DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4961+ BA51 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4962+ BA55 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4963+ BA59              .kanSkip:
4964+ BA59 11 10 00         LD DE, ENT_SIZE
4965+ BA5C DD 19            ADD IX, DE
4966+ BA5E C1               POP BC
4967+ BA5F 10 CB            DJNZ .kanLoop
4968+ BA61 C9               RET
4969+ BA62
4970+ BA62              ; ==============================================================================
4971+ BA62              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4972+ BA62              ; ==============================================================================
4973+ BA62              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4974+ BA62              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4975+ BA62              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4976+ BA62              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4977+ BA62              ; deja la posicion original (puff puede asomar levemente, raro).
4978+ BA62              ; IN:  IX = nasty entity.
4979+ BA62              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4980+ BA62              ; Destruye: AF, BC, DE, HL.
4981+ BA62              ; ==============================================================================
4982+ BA62              SnapPuffPos:
4983+ BA62 DD 7E 03         LD A, (IX+ENT_POSX)
4984+ BA65 32 D8 BA         LD (.sppOrigX), A
4985+ BA68 E6 F8            AND $F8
4986+ BA6A 32 DA BA         LD (.sppBaseX), A                   ; base char-aligned X
4987+ BA6D DD 7E 04         LD A, (IX+ENT_POSY)
4988+ BA70 32 D9 BA         LD (.sppOrigY), A
4989+ BA73 E6 F8            AND $F8
4990+ BA75 32 DB BA         LD (.sppBaseY), A                   ; base char-aligned Y
4991+ BA78
4992+ BA78                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4993+ BA78 CD AC BA         CALL .sppCheckFit
4994+ BA7B C8               RET Z
4995+ BA7C
4996+ BA7C                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4997+ BA7C                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4998+ BA7C 21 DC BA         LD HL, .sppShifts
4999+ BA7F              .sppLoop:
5000+ BA7F 7E               LD A, (HL)
5001+ BA80 23               INC HL
5002+ BA81 47               LD B, A                             ; dx (signed)
5003+ BA82 7E               LD A, (HL)
5004+ BA83 23               INC HL
5005+ BA84 FE 80            CP $80
5006+ BA86 28 17            JR Z, .sppFail                      ; sentinel
5007+ BA88 4F               LD C, A                             ; dy (signed)
5008+ BA89
5009+ BA89 3A DA BA         LD A, (.sppBaseX)
5010+ BA8C 80               ADD A, B
5011+ BA8D DD 77 03         LD (IX+ENT_POSX), A
5012+ BA90 3A DB BA         LD A, (.sppBaseY)
5013+ BA93 81               ADD A, C
5014+ BA94 DD 77 04         LD (IX+ENT_POSY), A
5015+ BA97
5016+ BA97 E5               PUSH HL
5017+ BA98 CD AC BA         CALL .sppCheckFit
5018+ BA9B E1               POP HL
5019+ BA9C C8               RET Z                               ; encontrado
5020+ BA9D 18 E0            JR .sppLoop
5021+ BA9F
5022+ BA9F              .sppFail:
5023+ BA9F 3A D8 BA         LD A, (.sppOrigX)
5024+ BAA2 DD 77 03         LD (IX+ENT_POSX), A
5025+ BAA5 3A D9 BA         LD A, (.sppOrigY)
5026+ BAA8 DD 77 04         LD (IX+ENT_POSY), A
5027+ BAAB C9               RET
5028+ BAAC
5029+ BAAC              ; --- .sppCheckFit ---
5030+ BAAC              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5031+ BAAC              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5032+ BAAC              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5033+ BAAC              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5034+ BAAC              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5035+ BAAC              .sppCheckFit:
5036+ BAAC                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5037+ BAAC DD 7E 03         LD A, (IX+ENT_POSX)
5038+ BAAF FE D1            CP SCREEN_MAX_X - 23
5039+ BAB1 30 21            JR NC, .sppOutOfBounds
5040+ BAB3 DD 7E 04         LD A, (IX+ENT_POSY)
5041+ BAB6 FE 10            CP SCREEN_MIN_Y
5042+ BAB8 38 1A            JR C, .sppOutOfBounds
5043+ BABA FE 91            CP SCREEN_MAX_Y - 23
5044+ BABC 30 16            JR NC, .sppOutOfBounds
5045+ BABE                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5046+ BABE DD 7E 00         LD A, (IX+ENT_SPRITEID)
5047+ BAC1 32 D7 BA         LD (.sppSpritIdSave), A
5048+ BAC4 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5049+ BAC8 CD B6 B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5050+ BACB F5               PUSH AF
5051+ BACC 3A D7 BA         LD A, (.sppSpritIdSave)
5052+ BACF DD 77 00         LD (IX+ENT_SPRITEID), A
5053+ BAD2 F1               POP AF
5054+ BAD3 C9               RET
5055+ BAD4              .sppOutOfBounds:
5056+ BAD4 F6 01            OR 1                                ; NZ
5057+ BAD6 C9               RET
5058+ BAD7
5059+ BAD7 00           .sppSpritIdSave: DEFB 0
5060+ BAD8
5061+ BAD8 00           .sppOrigX: DEFB 0
5062+ BAD9 00           .sppOrigY: DEFB 0
5063+ BADA 00           .sppBaseX: DEFB 0
5064+ BADB 00           .sppBaseY: DEFB 0
5065+ BADC              .sppShifts:
5066+ BADC                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5067+ BADC                  ; Distancia creciente. Sentinel: dy=$80.
5068+ BADC 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5069+ BADE 00 F8            DEFB 0,   -8                        ; arriba 8
5070+ BAE0 00 08            DEFB 0,    8                        ; abajo 8
5071+ BAE2 F8 00            DEFB -8,   0                        ; izq 8
5072+ BAE4 08 00            DEFB 8,    0                        ; der 8
5073+ BAE6 00 F0            DEFB 0,  -16                        ; arriba 16
5074+ BAE8 00 10            DEFB 0,   16                        ; abajo 16
5075+ BAEA F8 F8            DEFB -8,  -8
5076+ BAEC 08 F8            DEFB 8,   -8
5077+ BAEE F8 08            DEFB -8,   8
5078+ BAF0 08 08            DEFB 8,    8
5079+ BAF2 00 80            DEFB 0,  $80                        ; sentinel
5080+ BAF4
5081+ BAF4              ; ==============================================================================
5082+ BAF4              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5083+ BAF4              ; ==============================================================================
5084+ BAF4              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5085+ BAF4              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5086+ BAF4              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5087+ BAF4              ; DeathSpawned. No-op si la muerte no esta activa.
5088+ BAF4              ; ==============================================================================
5089+ BAF4              SilentKillDeath:
5090+ BAF4 DD 21 44 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5091+ BAF8 DD 7E 01         LD A, (IX+ENT_TYPE)
5092+ BAFB B7               OR A
5093+ BAFC 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5094+ BAFE CD FF C6         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5095+ BB01 AF               XOR A
5096+ BB02 DD 77 01         LD (IX+ENT_TYPE), A
5097+ BB05 32 F3 82         LD (DeathSpawned), A
5098+ BB08              .skdResetTimer:
5099+ BB08                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5100+ BB08                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5101+ BB08 21 00 00         LD HL, 0
5102+ BB0B 22 F0 82         LD (DeathScreenTimer), HL
5103+ BB0E                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5104+ BB0E                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5105+ BB0E                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5106+ BB0E                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5107+ BB0E                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5108+ BB0E C9               RET
5109+ BB0F
5110+ BB0F              ; ==============================================================================
5111+ BB0F              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5112+ BB0F              ; ==============================================================================
5113+ BB0F              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5114+ BB0F              ; no DYING ni SPAWNING):
5115+ BB0F              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5116+ BB0F              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5117+ BB0F              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5118+ BB0F              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5119+ BB0F              ;     Si tampoco, deja el monster donde estaba.
5120+ BB0F              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5121+ BB0F              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5122+ BB0F              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5123+ BB0F              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5124+ BB0F              ; ==============================================================================
5125+ BB0F              FreezeMonstersFacingCorpse:
5126+ BB0F                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5127+ BB0F 3A 97 81         LD A, (EntityTable + ENT_POSX)
5128+ BB12 32 EA 82         LD (CorpseX), A
5129+ BB15 3A 98 81         LD A, (EntityTable + ENT_POSY)
5130+ BB18 32 EB 82         LD (CorpseY), A
5131+ BB1B                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5132+ BB1B                  ; ya skipea; no aplica aqui pero por simetria)
5133+ BB1B 3E 01            LD A, 1
5134+ BB1D 32 E9 82         LD (MonstersFrozen), A
5135+ BB20 DD 21 A4 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5136+ BB24 06 06            LD B, NUM_MONSTERS
5137+ BB26              .fmcLoop:
5138+ BB26 C5               PUSH BC
5139+ BB27 DD 7E 01         LD A, (IX+ENT_TYPE)
5140+ BB2A FE 02            CP TYPE_MONSTER
5141+ BB2C 20 0E            JR NZ, .fmcNext
5142+ BB2E DD 7E 02         LD A, (IX+ENT_STATE)
5143+ BB31 FE 03            CP STATE_DYING
5144+ BB33 28 07            JR Z, .fmcNext
5145+ BB35 FE 04            CP STATE_SPAWNING
5146+ BB37 28 03            JR Z, .fmcNext
5147+ BB39 CD 45 BB         CALL FreezeOneMonster
5148+ BB3C              .fmcNext:
5149+ BB3C C1               POP BC
5150+ BB3D 11 10 00         LD DE, ENT_SIZE
5151+ BB40 DD 19            ADD IX, DE
5152+ BB42 10 E2            DJNZ .fmcLoop
5153+ BB44 C9               RET
5154+ BB45
5155+ BB45              ; --- FreezeOneMonster ---
5156+ BB45              ; IX = monster slot pointer.
5157+ BB45              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5158+ BB45              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5159+ BB45              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5160+ BB45              FreezeOneMonster:
5161+ BB45                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5162+ BB45                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5163+ BB45                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5164+ BB45 DD 7E 03         LD A, (IX+ENT_POSX)
5165+ BB48 47               LD B, A
5166+ BB49 3A EA 82         LD A, (CorpseX)
5167+ BB4C B8               CP B
5168+ BB4D 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5169+ BB4F 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5170+ BB51              .fomFaceE:
5171+ BB51 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5172+ BB54 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5173+ BB56 DD 77 00         LD (IX+ENT_SPRITEID), A
5174+ BB59 18 08            JR .fomFaceDone
5175+ BB5B              .fomFaceW:
5176+ BB5B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5177+ BB5E C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5178+ BB60 DD 77 00         LD (IX+ENT_SPRITEID), A
5179+ BB63              .fomFaceDone:
5180+ BB63
5181+ BB63                  ; --- 2) Computar |dx| y |dy| ---
5182+ BB63 3A EA 82         LD A, (CorpseX)
5183+ BB66 4F               LD C, A
5184+ BB67 DD 7E 03         LD A, (IX+ENT_POSX)
5185+ BB6A 91               SUB C                           ; A = posX - corpseX (signed)
5186+ BB6B 30 02            JR NC, .fomDxPos
5187+ BB6D ED 44            NEG
5188+ BB6F              .fomDxPos:
5189+ BB6F 32 C0 BB         LD (.fomAdx), A
5190+ BB72 3A EB 82         LD A, (CorpseY)
5191+ BB75 4F               LD C, A
5192+ BB76 DD 7E 04         LD A, (IX+ENT_POSY)
5193+ BB79 91               SUB C
5194+ BB7A 30 02            JR NC, .fomDyPos
5195+ BB7C ED 44            NEG
5196+ BB7E              .fomDyPos:
5197+ BB7E 32 C1 BB         LD (.fomAdy), A
5198+ BB81
5199+ BB81                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5200+ BB81 3A C0 BB         LD A, (.fomAdx)
5201+ BB84 FE 10            CP 16
5202+ BB86 D2 AF BB         JP NC, .fomFreeze
5203+ BB89 3A C1 BB         LD A, (.fomAdy)
5204+ BB8C FE 10            CP 16
5205+ BB8E D2 AF BB         JP NC, .fomFreeze
5206+ BB91
5207+ BB91                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5208+ BB91 3A C0 BB         LD A, (.fomAdx)
5209+ BB94 47               LD B, A
5210+ BB95 3A C1 BB         LD A, (.fomAdy)
5211+ BB98 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5212+ BB99 38 0C            JR C, .fomTryX
5213+ BB9B 28 0A            JR Z, .fomTryX
5214+ BB9D                  ; |dy| > |dx| -> intentar Y primero
5215+ BB9D CD F5 BB         CALL TryBackoffY
5216+ BBA0 28 0D            JR Z, .fomFreeze                ; ok
5217+ BBA2 CD C2 BB         CALL TryBackoffX
5218+ BBA5 18 08            JR .fomFreeze
5219+ BBA7              .fomTryX:
5220+ BBA7 CD C2 BB         CALL TryBackoffX
5221+ BBAA 28 03            JR Z, .fomFreeze
5222+ BBAC CD F5 BB         CALL TryBackoffY
5223+ BBAF
5224+ BBAF              .fomFreeze:
5225+ BBAF                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5226+ BBAF                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5227+ BBAF DD 36 06 00      LD (IX+ENT_DELTAX), 0
5228+ BBB3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5229+ BBB7 DD 36 0A 00      LD (IX+ENT_DIR), 0
5230+ BBBB DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5231+ BBBF C9               RET
5232+ BBC0
5233+ BBC0 00           .fomAdx: DEFB 0
5234+ BBC1 00           .fomAdy: DEFB 0
5235+ BBC2
5236+ BBC2              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5237+ BBC2              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5238+ BBC2              TryBackoffX:
5239+ BBC2 DD 7E 03         LD A, (IX+ENT_POSX)
5240+ BBC5 32 F4 BB         LD (.tbxSavePos), A
5241+ BBC8 47               LD B, A
5242+ BBC9 3A EA 82         LD A, (CorpseX)
5243+ BBCC B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5244+ BBCD DD 7E 03         LD A, (IX+ENT_POSX)
5245+ BBD0 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5246+ BBD2 C6 10            ADD A, 16
5247+ BBD4 18 02            JR .tbxApply
5248+ BBD6              .tbxNeg:
5249+ BBD6 D6 10            SUB 16
5250+ BBD8              .tbxApply:
5251+ BBD8                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5252+ BBD8 DD 77 03         LD (IX+ENT_POSX), A
5253+ BBDB FE E8            CP SCREEN_MAX_X
5254+ BBDD 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5255+ BBDF CD B6 B6         CALL CheckEnemyCollision
5256+ BBE2 20 07            JR NZ, .tbxFail
5257+ BBE4 CD 2C BC         CALL CheckMonsterOverlap
5258+ BBE7 20 02            JR NZ, .tbxFail
5259+ BBE9 AF               XOR A                           ; Z = ok
5260+ BBEA C9               RET
5261+ BBEB              .tbxFail:
5262+ BBEB 3A F4 BB         LD A, (.tbxSavePos)
5263+ BBEE DD 77 03         LD (IX+ENT_POSX), A
5264+ BBF1 F6 01            OR 1                            ; NZ
5265+ BBF3 C9               RET
5266+ BBF4 00           .tbxSavePos: DEFB 0
5267+ BBF5
5268+ BBF5              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5269+ BBF5              TryBackoffY:
5270+ BBF5 DD 7E 04         LD A, (IX+ENT_POSY)
5271+ BBF8 32 2B BC         LD (.tbySavePos), A
5272+ BBFB 47               LD B, A
5273+ BBFC 3A EB 82         LD A, (CorpseY)
5274+ BBFF B8               CP B
5275+ BC00 DD 7E 04         LD A, (IX+ENT_POSY)
5276+ BC03 30 04            JR NC, .tbyNeg
5277+ BC05 C6 10            ADD A, 16
5278+ BC07 18 02            JR .tbyApply
5279+ BC09              .tbyNeg:
5280+ BC09 D6 10            SUB 16
5281+ BC0B              .tbyApply:
5282+ BC0B DD 77 04         LD (IX+ENT_POSY), A
5283+ BC0E FE 10            CP SCREEN_MIN_Y
5284+ BC10 38 10            JR C, .tbyFail
5285+ BC12 FE A8            CP SCREEN_MAX_Y
5286+ BC14 30 0C            JR NC, .tbyFail
5287+ BC16 CD B6 B6         CALL CheckEnemyCollision
5288+ BC19 20 07            JR NZ, .tbyFail
5289+ BC1B CD 2C BC         CALL CheckMonsterOverlap
5290+ BC1E 20 02            JR NZ, .tbyFail
5291+ BC20 AF               XOR A
5292+ BC21 C9               RET
5293+ BC22              .tbyFail:
5294+ BC22 3A 2B BC         LD A, (.tbySavePos)
5295+ BC25 DD 77 04         LD (IX+ENT_POSY), A
5296+ BC28 F6 01            OR 1
5297+ BC2A C9               RET
5298+ BC2B 00           .tbySavePos: DEFB 0
