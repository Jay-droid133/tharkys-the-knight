4913+ BA21 09               DEFB 9                              ; Ciclo 6: 4.5px
4914+ BA22 0A               DEFB 10                             ; Ciclo 7: 5px
4915+ BA23 0B               DEFB 11                             ; Ciclo 8: 5.5px
4916+ BA24 0C               DEFB 12                             ; Ciclo 9: 6px
4917+ BA25 0E               DEFB 14                             ; Ciclo 10: 7px
4918+ BA26
4919+ BA26              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4920+ BA26              ; La rata usara la mitad de estos valores
4921+ BA26              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4922+ BA26 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4923+ BA27 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4924+ BA28 03               DEFB 3                              ; Ciclo 3 (era 6)
4925+ BA29 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4926+ BA2A 02               DEFB 2                              ; Ciclo 5 (era 4)
4927+ BA2B 02               DEFB 2                              ; Ciclo 6 (era 4)
4928+ BA2C 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4929+ BA2D 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4930+ BA2E 01               DEFB 1                              ; Ciclo 9 (era 2)
4931+ BA2F 01               DEFB 1                              ; Ciclo 10 (era 2)
4932+ BA30
4933+ BA30              ; ==============================================================================
4934+ BA30              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4935+ BA30              ; ==============================================================================
4936+ BA30              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4937+ BA30              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4938+ BA30              ; ==============================================================================
4939+ BA30              KillAllActiveNasties:
4940+ BA30 DD 21 0E 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4941+ BA34 06 03            LD B, NUM_NASTIES
4942+ BA36              .kanLoop:
4943+ BA36 C5               PUSH BC
4944+ BA37 DD 7E 01         LD A, (IX+ENT_TYPE)
4945+ BA3A B7               OR A
4946+ BA3B 28 26            JR Z, .kanSkip                  ; slot vacio
4947+ BA3D FE 03            CP TYPE_NASTY
4948+ BA3F 20 22            JR NZ, .kanSkip                 ; no es nasty
4949+ BA41 DD 7E 02         LD A, (IX+ENT_STATE)
4950+ BA44 FE 03            CP STATE_DYING
4951+ BA46 28 1B            JR Z, .kanSkip                  ; ya muriendo
4952+ BA48                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4953+ BA48                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4954+ BA48                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4955+ BA48                  ; del nasty: peDying paintea el rect del puff con ese color)
4956+ BA48 CD 6C BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4957+ BA4B DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4958+ BA4F DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4959+ BA53 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4960+ BA57 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4961+ BA5B DD 36 06 00      LD (IX+ENT_DELTAX), 0
4962+ BA5F DD 36 07 00      LD (IX+ENT_DELTAY), 0
4963+ BA63              .kanSkip:
4964+ BA63 11 10 00         LD DE, ENT_SIZE
4965+ BA66 DD 19            ADD IX, DE
4966+ BA68 C1               POP BC
4967+ BA69 10 CB            DJNZ .kanLoop
4968+ BA6B C9               RET
4969+ BA6C
4970+ BA6C              ; ==============================================================================
4971+ BA6C              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4972+ BA6C              ; ==============================================================================
4973+ BA6C              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4974+ BA6C              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4975+ BA6C              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4976+ BA6C              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4977+ BA6C              ; deja la posicion original (puff puede asomar levemente, raro).
4978+ BA6C              ; IN:  IX = nasty entity.
4979+ BA6C              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4980+ BA6C              ; Destruye: AF, BC, DE, HL.
4981+ BA6C              ; ==============================================================================
4982+ BA6C              SnapPuffPos:
4983+ BA6C DD 7E 03         LD A, (IX+ENT_POSX)
4984+ BA6F 32 E2 BA         LD (.sppOrigX), A
4985+ BA72 E6 F8            AND $F8
4986+ BA74 32 E4 BA         LD (.sppBaseX), A                   ; base char-aligned X
4987+ BA77 DD 7E 04         LD A, (IX+ENT_POSY)
4988+ BA7A 32 E3 BA         LD (.sppOrigY), A
4989+ BA7D E6 F8            AND $F8
4990+ BA7F 32 E5 BA         LD (.sppBaseY), A                   ; base char-aligned Y
4991+ BA82
4992+ BA82                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4993+ BA82 CD B6 BA         CALL .sppCheckFit
4994+ BA85 C8               RET Z
4995+ BA86
4996+ BA86                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4997+ BA86                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4998+ BA86 21 E6 BA         LD HL, .sppShifts
4999+ BA89              .sppLoop:
5000+ BA89 7E               LD A, (HL)
5001+ BA8A 23               INC HL
5002+ BA8B 47               LD B, A                             ; dx (signed)
5003+ BA8C 7E               LD A, (HL)
5004+ BA8D 23               INC HL
5005+ BA8E FE 80            CP $80
5006+ BA90 28 17            JR Z, .sppFail                      ; sentinel
5007+ BA92 4F               LD C, A                             ; dy (signed)
5008+ BA93
5009+ BA93 3A E4 BA         LD A, (.sppBaseX)
5010+ BA96 80               ADD A, B
5011+ BA97 DD 77 03         LD (IX+ENT_POSX), A
5012+ BA9A 3A E5 BA         LD A, (.sppBaseY)
5013+ BA9D 81               ADD A, C
5014+ BA9E DD 77 04         LD (IX+ENT_POSY), A
5015+ BAA1
5016+ BAA1 E5               PUSH HL
5017+ BAA2 CD B6 BA         CALL .sppCheckFit
5018+ BAA5 E1               POP HL
5019+ BAA6 C8               RET Z                               ; encontrado
5020+ BAA7 18 E0            JR .sppLoop
5021+ BAA9
5022+ BAA9              .sppFail:
5023+ BAA9 3A E2 BA         LD A, (.sppOrigX)
5024+ BAAC DD 77 03         LD (IX+ENT_POSX), A
5025+ BAAF 3A E3 BA         LD A, (.sppOrigY)
5026+ BAB2 DD 77 04         LD (IX+ENT_POSY), A
5027+ BAB5 C9               RET
5028+ BAB6
5029+ BAB6              ; --- .sppCheckFit ---
5030+ BAB6              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5031+ BAB6              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5032+ BAB6              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5033+ BAB6              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5034+ BAB6              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5035+ BAB6              .sppCheckFit:
5036+ BAB6                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5037+ BAB6 DD 7E 03         LD A, (IX+ENT_POSX)
5038+ BAB9 FE D1            CP SCREEN_MAX_X - 23
5039+ BABB 30 21            JR NC, .sppOutOfBounds
5040+ BABD DD 7E 04         LD A, (IX+ENT_POSY)
5041+ BAC0 FE 10            CP SCREEN_MIN_Y
5042+ BAC2 38 1A            JR C, .sppOutOfBounds
5043+ BAC4 FE 91            CP SCREEN_MAX_Y - 23
5044+ BAC6 30 16            JR NC, .sppOutOfBounds
5045+ BAC8                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5046+ BAC8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5047+ BACB 32 E1 BA         LD (.sppSpritIdSave), A
5048+ BACE DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5049+ BAD2 CD C0 B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5050+ BAD5 F5               PUSH AF
5051+ BAD6 3A E1 BA         LD A, (.sppSpritIdSave)
5052+ BAD9 DD 77 00         LD (IX+ENT_SPRITEID), A
5053+ BADC F1               POP AF
5054+ BADD C9               RET
5055+ BADE              .sppOutOfBounds:
5056+ BADE F6 01            OR 1                                ; NZ
5057+ BAE0 C9               RET
5058+ BAE1
5059+ BAE1 00           .sppSpritIdSave: DEFB 0
5060+ BAE2
5061+ BAE2 00           .sppOrigX: DEFB 0
5062+ BAE3 00           .sppOrigY: DEFB 0
5063+ BAE4 00           .sppBaseX: DEFB 0
5064+ BAE5 00           .sppBaseY: DEFB 0
5065+ BAE6              .sppShifts:
5066+ BAE6                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5067+ BAE6                  ; Distancia creciente. Sentinel: dy=$80.
5068+ BAE6 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5069+ BAE8 00 F8            DEFB 0,   -8                        ; arriba 8
5070+ BAEA 00 08            DEFB 0,    8                        ; abajo 8
5071+ BAEC F8 00            DEFB -8,   0                        ; izq 8
5072+ BAEE 08 00            DEFB 8,    0                        ; der 8
5073+ BAF0 00 F0            DEFB 0,  -16                        ; arriba 16
5074+ BAF2 00 10            DEFB 0,   16                        ; abajo 16
5075+ BAF4 F8 F8            DEFB -8,  -8
5076+ BAF6 08 F8            DEFB 8,   -8
5077+ BAF8 F8 08            DEFB -8,   8
5078+ BAFA 08 08            DEFB 8,    8
5079+ BAFC 00 80            DEFB 0,  $80                        ; sentinel
5080+ BAFE
5081+ BAFE              ; ==============================================================================
5082+ BAFE              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5083+ BAFE              ; ==============================================================================
5084+ BAFE              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5085+ BAFE              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5086+ BAFE              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5087+ BAFE              ; DeathSpawned. No-op si la muerte no esta activa.
5088+ BAFE              ; ==============================================================================
5089+ BAFE              SilentKillDeath:
5090+ BAFE DD 21 4E 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5091+ BB02 DD 7E 01         LD A, (IX+ENT_TYPE)
5092+ BB05 B7               OR A
5093+ BB06 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5094+ BB08 CD 09 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5095+ BB0B AF               XOR A
5096+ BB0C DD 77 01         LD (IX+ENT_TYPE), A
5097+ BB0F 32 FD 82         LD (DeathSpawned), A
5098+ BB12              .skdResetTimer:
5099+ BB12                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5100+ BB12                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5101+ BB12 21 00 00         LD HL, 0
5102+ BB15 22 FA 82         LD (DeathScreenTimer), HL
5103+ BB18                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5104+ BB18                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5105+ BB18                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5106+ BB18                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5107+ BB18                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5108+ BB18 C9               RET
5109+ BB19
5110+ BB19              ; ==============================================================================
5111+ BB19              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5112+ BB19              ; ==============================================================================
5113+ BB19              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5114+ BB19              ; no DYING ni SPAWNING):
5115+ BB19              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5116+ BB19              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5117+ BB19              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5118+ BB19              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5119+ BB19              ;     Si tampoco, deja el monster donde estaba.
5120+ BB19              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5121+ BB19              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5122+ BB19              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5123+ BB19              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5124+ BB19              ; ==============================================================================
5125+ BB19              FreezeMonstersFacingCorpse:
5126+ BB19                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5127+ BB19 3A A1 81         LD A, (EntityTable + ENT_POSX)
5128+ BB1C 32 F4 82         LD (CorpseX), A
5129+ BB1F 3A A2 81         LD A, (EntityTable + ENT_POSY)
5130+ BB22 32 F5 82         LD (CorpseY), A
5131+ BB25                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5132+ BB25                  ; ya skipea; no aplica aqui pero por simetria)
5133+ BB25 3E 01            LD A, 1
5134+ BB27 32 F3 82         LD (MonstersFrozen), A
5135+ BB2A DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5136+ BB2E 06 06            LD B, NUM_MONSTERS
5137+ BB30              .fmcLoop:
5138+ BB30 C5               PUSH BC
5139+ BB31 DD 7E 01         LD A, (IX+ENT_TYPE)
5140+ BB34 FE 02            CP TYPE_MONSTER
5141+ BB36 20 0E            JR NZ, .fmcNext
5142+ BB38 DD 7E 02         LD A, (IX+ENT_STATE)
5143+ BB3B FE 03            CP STATE_DYING
5144+ BB3D 28 07            JR Z, .fmcNext
5145+ BB3F FE 04            CP STATE_SPAWNING
5146+ BB41 28 03            JR Z, .fmcNext
5147+ BB43 CD 4F BB         CALL FreezeOneMonster
5148+ BB46              .fmcNext:
5149+ BB46 C1               POP BC
5150+ BB47 11 10 00         LD DE, ENT_SIZE
5151+ BB4A DD 19            ADD IX, DE
5152+ BB4C 10 E2            DJNZ .fmcLoop
5153+ BB4E C9               RET
5154+ BB4F
5155+ BB4F              ; --- FreezeOneMonster ---
5156+ BB4F              ; IX = monster slot pointer.
5157+ BB4F              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5158+ BB4F              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5159+ BB4F              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5160+ BB4F              FreezeOneMonster:
5161+ BB4F                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5162+ BB4F                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5163+ BB4F                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5164+ BB4F DD 7E 03         LD A, (IX+ENT_POSX)
5165+ BB52 47               LD B, A
5166+ BB53 3A F4 82         LD A, (CorpseX)
5167+ BB56 B8               CP B
5168+ BB57 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5169+ BB59 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5170+ BB5B              .fomFaceE:
5171+ BB5B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5172+ BB5E C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5173+ BB60 DD 77 00         LD (IX+ENT_SPRITEID), A
5174+ BB63 18 08            JR .fomFaceDone
5175+ BB65              .fomFaceW:
5176+ BB65 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5177+ BB68 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5178+ BB6A DD 77 00         LD (IX+ENT_SPRITEID), A
5179+ BB6D              .fomFaceDone:
5180+ BB6D
5181+ BB6D                  ; --- 2) Computar |dx| y |dy| ---
5182+ BB6D 3A F4 82         LD A, (CorpseX)
5183+ BB70 4F               LD C, A
5184+ BB71 DD 7E 03         LD A, (IX+ENT_POSX)
5185+ BB74 91               SUB C                           ; A = posX - corpseX (signed)
5186+ BB75 30 02            JR NC, .fomDxPos
5187+ BB77 ED 44            NEG
5188+ BB79              .fomDxPos:
5189+ BB79 32 CA BB         LD (.fomAdx), A
5190+ BB7C 3A F5 82         LD A, (CorpseY)
5191+ BB7F 4F               LD C, A
5192+ BB80 DD 7E 04         LD A, (IX+ENT_POSY)
5193+ BB83 91               SUB C
5194+ BB84 30 02            JR NC, .fomDyPos
5195+ BB86 ED 44            NEG
5196+ BB88              .fomDyPos:
5197+ BB88 32 CB BB         LD (.fomAdy), A
5198+ BB8B
5199+ BB8B                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5200+ BB8B 3A CA BB         LD A, (.fomAdx)
5201+ BB8E FE 10            CP 16
5202+ BB90 D2 B9 BB         JP NC, .fomFreeze
5203+ BB93 3A CB BB         LD A, (.fomAdy)
5204+ BB96 FE 10            CP 16
5205+ BB98 D2 B9 BB         JP NC, .fomFreeze
5206+ BB9B
5207+ BB9B                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5208+ BB9B 3A CA BB         LD A, (.fomAdx)
5209+ BB9E 47               LD B, A
5210+ BB9F 3A CB BB         LD A, (.fomAdy)
5211+ BBA2 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5212+ BBA3 38 0C            JR C, .fomTryX
5213+ BBA5 28 0A            JR Z, .fomTryX
5214+ BBA7                  ; |dy| > |dx| -> intentar Y primero
5215+ BBA7 CD FF BB         CALL TryBackoffY
5216+ BBAA 28 0D            JR Z, .fomFreeze                ; ok
5217+ BBAC CD CC BB         CALL TryBackoffX
5218+ BBAF 18 08            JR .fomFreeze
5219+ BBB1              .fomTryX:
5220+ BBB1 CD CC BB         CALL TryBackoffX
5221+ BBB4 28 03            JR Z, .fomFreeze
5222+ BBB6 CD FF BB         CALL TryBackoffY
5223+ BBB9
5224+ BBB9              .fomFreeze:
5225+ BBB9                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5226+ BBB9                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5227+ BBB9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5228+ BBBD DD 36 07 00      LD (IX+ENT_DELTAY), 0
5229+ BBC1 DD 36 0A 00      LD (IX+ENT_DIR), 0
5230+ BBC5 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5231+ BBC9 C9               RET
5232+ BBCA
5233+ BBCA 00           .fomAdx: DEFB 0
5234+ BBCB 00           .fomAdy: DEFB 0
5235+ BBCC
5236+ BBCC              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5237+ BBCC              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5238+ BBCC              TryBackoffX:
5239+ BBCC DD 7E 03         LD A, (IX+ENT_POSX)
5240+ BBCF 32 FE BB         LD (.tbxSavePos), A
5241+ BBD2 47               LD B, A
5242+ BBD3 3A F4 82         LD A, (CorpseX)
5243+ BBD6 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5244+ BBD7 DD 7E 03         LD A, (IX+ENT_POSX)
5245+ BBDA 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5246+ BBDC C6 10            ADD A, 16
5247+ BBDE 18 02            JR .tbxApply
5248+ BBE0              .tbxNeg:
5249+ BBE0 D6 10            SUB 16
5250+ BBE2              .tbxApply:
5251+ BBE2                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5252+ BBE2 DD 77 03         LD (IX+ENT_POSX), A
5253+ BBE5 FE E8            CP SCREEN_MAX_X
5254+ BBE7 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5255+ BBE9 CD C0 B6         CALL CheckEnemyCollision
5256+ BBEC 20 07            JR NZ, .tbxFail
5257+ BBEE CD 36 BC         CALL CheckMonsterOverlap
5258+ BBF1 20 02            JR NZ, .tbxFail
5259+ BBF3 AF               XOR A                           ; Z = ok
5260+ BBF4 C9               RET
5261+ BBF5              .tbxFail:
5262+ BBF5 3A FE BB         LD A, (.tbxSavePos)
5263+ BBF8 DD 77 03         LD (IX+ENT_POSX), A
5264+ BBFB F6 01            OR 1                            ; NZ
5265+ BBFD C9               RET
5266+ BBFE 00           .tbxSavePos: DEFB 0
5267+ BBFF
5268+ BBFF              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5269+ BBFF              TryBackoffY:
5270+ BBFF DD 7E 04         LD A, (IX+ENT_POSY)
5271+ BC02 32 35 BC         LD (.tbySavePos), A
5272+ BC05 47               LD B, A
5273+ BC06 3A F5 82         LD A, (CorpseY)
5274+ BC09 B8               CP B
5275+ BC0A DD 7E 04         LD A, (IX+ENT_POSY)
5276+ BC0D 30 04            JR NC, .tbyNeg
5277+ BC0F C6 10            ADD A, 16
5278+ BC11 18 02            JR .tbyApply
5279+ BC13              .tbyNeg:
5280+ BC13 D6 10            SUB 16
5281+ BC15              .tbyApply:
5282+ BC15 DD 77 04         LD (IX+ENT_POSY), A
5283+ BC18 FE 10            CP SCREEN_MIN_Y
5284+ BC1A 38 10            JR C, .tbyFail
5285+ BC1C FE A8            CP SCREEN_MAX_Y
5286+ BC1E 30 0C            JR NC, .tbyFail
5287+ BC20 CD C0 B6         CALL CheckEnemyCollision
5288+ BC23 20 07            JR NZ, .tbyFail
5289+ BC25 CD 36 BC         CALL CheckMonsterOverlap
5290+ BC28 20 02            JR NZ, .tbyFail
5291+ BC2A AF               XOR A
5292+ BC2B C9               RET
5293+ BC2C              .tbyFail:
5294+ BC2C 3A 35 BC         LD A, (.tbySavePos)
5295+ BC2F DD 77 04         LD (IX+ENT_POSY), A
5296+ BC32 F6 01            OR 1
5297+ BC34 C9               RET
5298+ BC35 00           .tbySavePos: DEFB 0
5299+ BC36
5300+ BC36              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5301+ BC36              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5302+ BC36              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5303+ BC36              CheckMonsterOverlap:
5304+ BC36 C5               PUSH BC
5305+ BC37 FD E5            PUSH IY
5306+ BC39 FD 21 AE 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5307+ BC3D 06 06            LD B, NUM_MONSTERS
5308+ BC3F              .cmoLoop:
5309+ BC3F                  ; Skip self (IY == IX)
5310+ BC3F DD E5            PUSH IX
5311+ BC41 E1               POP HL
5312+ BC42 FD E5            PUSH IY
5313+ BC44 D1               POP DE
5314+ BC45 B7               OR A
5315+ BC46 ED 52            SBC HL, DE
5316+ BC48 28 3D            JR Z, .cmoNext                  ; same slot
5317+ BC4A
5318+ BC4A FD 7E 01         LD A, (IY+ENT_TYPE)
5319+ BC4D FE 02            CP TYPE_MONSTER
5320+ BC4F 20 36            JR NZ, .cmoNext
5321+ BC51
5322+ BC51                  ; AABB overlap (rect 16x21 cada uno):
5323+ BC51                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5324+ BC51                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5325+ BC51 DD 7E 03         LD A, (IX+ENT_POSX)
5326+ BC54 C6 10            ADD A, 16
5327+ BC56 4F               LD C, A
5328+ BC57 FD 7E 03         LD A, (IY+ENT_POSX)
5329+ BC5A B9               CP C                            ; iy.x cmp ix.x+16
5330+ BC5B 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5331+ BC5D FD 7E 03         LD A, (IY+ENT_POSX)
5332+ BC60 C6 10            ADD A, 16
5333+ BC62 4F               LD C, A
5334+ BC63 DD 7E 03         LD A, (IX+ENT_POSX)
5335+ BC66 B9               CP C
5336+ BC67 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5337+ BC69 DD 7E 04         LD A, (IX+ENT_POSY)
5338+ BC6C C6 15            ADD A, 21
5339+ BC6E 4F               LD C, A
5340+ BC6F FD 7E 04         LD A, (IY+ENT_POSY)
5341+ BC72 B9               CP C
5342+ BC73 30 12            JR NC, .cmoNext
5343+ BC75 FD 7E 04         LD A, (IY+ENT_POSY)
5344+ BC78 C6 15            ADD A, 21
5345+ BC7A 4F               LD C, A
5346+ BC7B DD 7E 04         LD A, (IX+ENT_POSY)
5347+ BC7E B9               CP C
5348+ BC7F 30 06            JR NC, .cmoNext
5349+ BC81                  ; Overlap en ambos ejes
5350+ BC81 FD E1            POP IY
5351+ BC83 C1               POP BC
5352+ BC84 F6 01            OR 1                            ; NZ
5353+ BC86 C9               RET
5354+ BC87              .cmoNext:
5355+ BC87 11 10 00         LD DE, ENT_SIZE
5356+ BC8A FD 19            ADD IY, DE
5357+ BC8C 10 B1            DJNZ .cmoLoop
5358+ BC8E FD E1            POP IY
5359+ BC90 C1               POP BC
5360+ BC91 AF               XOR A                           ; Z = no overlap
5361+ BC92 C9               RET
