 642+ F1D9                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F1D9                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F1D9 FE 03            CP 3
 645+ F1DB 38 01            JR C, .dcWobbleOffsetReady
 646+ F1DD 3D               DEC A
 647+ F1DE              .dcWobbleOffsetReady:
 648+ F1DE 5F               LD E, A
 649+ F1DF 3A 91 F2         LD A, (.dcSpriteIdx)
 650+ F1E2 87               ADD A, A                            ; idx*2
 651+ F1E3 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F1E4 83               ADD A, E                            ; +offset
 653+ F1E5 21 CE F6         LD HL, CompassWobbleTable
 654+ F1E8 5F               LD E, A
 655+ F1E9 16 00            LD D, 0
