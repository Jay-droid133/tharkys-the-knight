2255+ AB6B              ; ==============================================================================
2256+ AB6B              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2257+ AB6B              ; ==============================================================================
2258+ AB6B              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2259+ AB6B              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2260+ AB6B              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2261+ AB6B              ; ==============================================================================
2262+ AB6B              StartWellCooldown:
2263+ AB6B CD 98 AB         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2264+ AB6E E5               PUSH HL
2265+ AB6F 11 57 8A         LD DE, CleanAttrMap
2266+ AB72 19               ADD HL, DE
2267+ AB73 7E               LD A, (HL)
2268+ AB74 32 5F 8D         LD (WellOrigAttr0), A
2269+ AB77 23               INC HL
2270+ AB78 7E               LD A, (HL)
2271+ AB79 32 60 8D         LD (WellOrigAttr1), A
2272+ AB7C E1               POP HL
2273+ AB7D CD B2 AB         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2274+ AB80 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
