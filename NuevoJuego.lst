 635+ E0D0 CD 9C E2         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 636+ E0D3 CD D7 E2         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 637+ E0D6 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 638+ E0D8 32 D2 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 639+ E0DB 3E 13            LD A, BCP_HAND_OPEN_IN
 640+ E0DD 32 D1 82         LD (BankCutscenePhase), A
 641+ E0E0 C9               RET
