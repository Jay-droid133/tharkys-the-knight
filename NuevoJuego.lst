1492+ EFBF              ; ==============================================================================
1493+ EFBF              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1494+ EFBF              ; ==============================================================================
1495+ EFBF              ; Indice (CompassSprites[idx]):
1496+ EFBF              ;   0 = NW    1 = N    2 = NE
1497+ EFBF              ;   3 = W     4 = X    5 = E
1498+ EFBF              ;   6 = SW    7 = S    8 = SE
1499+ EFBF              ; ==============================================================================
1500+ EFBF              CompassSprites:
1501+ EFBF DE F0            DEFW Sprite_Compass_NW
1502+ EFC1 FE EF            DEFW Sprite_Compass_N
1503+ EFC3 1E F0            DEFW Sprite_Compass_NE
1504+ EFC5 BE F0            DEFW Sprite_Compass_W
1505+ EFC7 FE F0            DEFW Sprite_Compass_X
1506+ EFC9 3E F0            DEFW Sprite_Compass_E
1507+ EFCB 9E F0            DEFW Sprite_Compass_SW
1508+ EFCD 7E F0            DEFW Sprite_Compass_S
1509+ EFCF 5E F0            DEFW Sprite_Compass_SE
1510+ EFD1
1511+ EFD1              ; ==============================================================================
1512+ EFD1              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1513+ EFD1              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1514+ EFD1              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1515+ EFD1              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1516+ EFD1              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1517+ EFD1              ; ==============================================================================
1518+ EFD1              CompassWobbleTable:
1519+ EFD1 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1520+ EFD5 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1521+ EFD9 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1522+ EFDD 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1523+ EFE1 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1524+ EFE5 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1525+ EFE9 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1526+ EFED 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1527+ EFF1 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1528+ EFF5
1529+ EFF5              ; ==============================================================================
1530+ EFF5              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1531+ EFF5              ; Indexada por (counter-1) -> 0..8. Valor:
1532+ EFF5              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1533+ EFF5              ; Con counter inicial 9 y decremento por frame:
1534+ EFF5              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1535+ EFF5              ;   counter 8 -> phase 7 -> prev
1536+ EFF5              ;   counter 7 -> phase 6 -> target
1537+ EFF5              ;   counter 6 -> phase 5 -> next
1538+ EFF5              ;   counter 5 -> phase 4 -> next2
1539+ EFF5              ;   counter 4 -> phase 3 -> prev
1540+ EFF5              ;   counter 3 -> phase 2 -> target
1541+ EFF5              ;   counter 2 -> phase 1 -> prev
1542+ EFF5              ;   counter 1 -> phase 0 -> target (estado final, settle)
1543+ EFF5              ; ==============================================================================
1544+ EFF5              WobblePhaseTable:
1545+ EFF5 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1545+ EFF9 04 03 02 01
1545+ EFFD 00
