 136+ EADE AF               XOR A
 137+ EADF 32 36 E9         LD (GameSubMinute), A
 138+ EAE2 21 37 E9         LD HL, GameMinutes
 139+ EAE5 34               INC (HL)
 140+ EAE6                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EAE6                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EAE6 3A 37 E9         LD A, (GameMinutes)
 143+ EAE9 FE 3C            CP 60
 144+ EAEB C0               RET NZ
 145+ EAEC
 146+ EAEC AF               XOR A
