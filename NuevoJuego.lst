 435+ F9A2              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 436+ F9A2              .bcPhWait1:
 437+ F9A2 CD C9 FB         CALL BankCutsceneDecTimer
 438+ F9A5 C0               RET NZ
 439+ F9A6                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 440+ F9A6 CD A0 F8         CALL BankCutsceneSnapToDoor
 441+ F9A9 AF               XOR A
 442+ F9AA 32 CC 82         LD (BankCutsceneKnockIdx), A
 443+ F9AD 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 444+ F9B0 3E 00            LD A, BCS_KNOCK_HIT
 445+ F9B2 32 CB 82         LD (BankCutsceneSubState), A
 446+ F9B5 3E 04            LD A, BCS_T_KNOCK_HIT
 447+ F9B7 32 CA 82         LD (BankCutsceneTimer), A
 448+ F9BA CD 68 FB         CALL BankCutsceneEmitKnockHit
 449+ F9BD 3E 04            LD A, BCP_KNOCKS_2
 450+ F9BF 32 C9 82         LD (BankCutscenePhase), A
 451+ F9C2 C9               RET
