 126  C7C0                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ C7C0              ; ==============================================================================
   2+ C7C0              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ C7C0              ; ==============================================================================
   4+ C7C0              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ C7C0              ; Para cada shift S:
   6+ C7C0              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ C7C0              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ C7C0              ;
   9+ C7C0              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ C7C0              ;
  11+ C7C0              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ C7C0              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ C7C0              ;
  14+ C7C0              ; Calculo de B desde X%8:
  15+ C7C0              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ C7C0              ; ==============================================================================
  17+ C7C0
  18+ C7C0 00 00 00...      ALIGN 256
  19+ C800              ShiftTables:
  20+ C800                  LUA ALLPASS
  21+ C800 ~                for shift = 1, 7 do
  22+ C800 ~                    -- High part: byte >> shift
  23+ C800 ~                    for i = 0, 255 do
  24+ C800 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ C800 ~                    end
  26+ C800 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ C800 ~                    for i = 0, 255 do
  28+ C800 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ C800 ~                    end
  30+ C800 ~                end
  31+ C800 00 00 01 01      ENDLUA
