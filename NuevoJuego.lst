 374+ 9B68              _SaveEntityAttrImpl:
 375+ 9B68                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B68 DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B6B 47               LD B, A
 378+ 9B6C 7B               LD A, E                     ; X pixel (raw)
 379+ 9B6D E6 07            AND 7
 380+ 9B6F 28 01            JR Z, .noExtraW
 381+ 9B71 04               INC B                       ; +1 columna si no alineado
 382+ 9B72              .noExtraW:
