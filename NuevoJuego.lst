 357+ 9E2B              ; ==============================================================================
 358+ 9E2B              SaveEntityAttr:
 359+ 9E2B                  ; Paging inline (ver nota en DrawSprite)
 360+ 9E2B 3A 82 90         LD A, (CurrentPaging)
 361+ 9E2E E6 F8            AND $F8
 362+ 9E30 F6 06            OR 6
 363+ 9E32 32 82 90         LD (CurrentPaging), A
 364+ 9E35 01 FD 7F         LD BC, $7FFD
 365+ 9E38 ED 79            OUT (C), A
 366+ 9E3A CD 4B 9E         CALL _SaveEntityAttrImpl
 367+ 9E3D 3A 82 90         LD A, (CurrentPaging)
 368+ 9E40 E6 F8            AND $F8
 369+ 9E42 32 82 90         LD (CurrentPaging), A
 370+ 9E45 01 FD 7F         LD BC, $7FFD
 371+ 9E48 ED 79            OUT (C), A
 372+ 9E4A C9               RET
 373+ 9E4B
 374+ 9E4B              _SaveEntityAttrImpl:
 375+ 9E4B                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9E4B DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9E4E 47               LD B, A
 378+ 9E4F 7B               LD A, E                     ; X pixel (raw)
 379+ 9E50 E6 07            AND 7
 380+ 9E52 28 01            JR Z, .noExtraW
 381+ 9E54 04               INC B                       ; +1 columna si no alineado
 382+ 9E55              .noExtraW:
 383+ 9E55 78               LD A, B
 384+ 9E56 32 BB 9E         LD (EntityAttrW), A
 385+ 9E59
 386+ 9E59                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9E59 7A               LD A, D                     ; Y pixel (raw)
 388+ 9E5A E6 07            AND 7                       ; Y offset dentro del char
 389+ 9E5C 4F               LD C, A
 390+ 9E5D DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9E60 81               ADD A, C                    ; + Y offset
 392+ 9E61 C6 07            ADD A, 7
 393+ 9E63 0F               RRCA
 394+ 9E64 0F               RRCA
 395+ 9E65 0F               RRCA
 396+ 9E66 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9E68 32 BC 9E         LD (EntityAttrH), A
 398+ 9E6B
 399+ 9E6B CD 25 A0         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9E6E 11 AB 9E         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9E71
 402+ 9E71 3A BC 9E         LD A, (EntityAttrH)
 403+ 9E74 4F               LD C, A                     ; C = filas
 404+ 9E75              .saveRow:
 405+ 9E75 3A BB 9E         LD A, (EntityAttrW)
