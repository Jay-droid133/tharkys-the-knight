1798+ F753
1799+ F753              ; ==============================================================================
1800+ F753              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1801+ F753              ;                     debe salir (magic compass activa).
1802+ F753              ; ==============================================================================
1803+ F753              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1804+ F753              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1805+ F753              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1806+ F753              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1807+ F753              ; el viejo porque DrawScreen ya repinta BG limpio.
1808+ F753              ;
1809+ F753              ; Llamada cada frame desde MainLoop tras DrawCompass.
1810+ F753              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1811+ F753              ; ==============================================================================
1812+ F753              DrawCompassGapHint:
1813+ F753                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1814+ F753                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1815+ F753                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1816+ F753                  ; produciendo el parpadeo sincronizado con el tic AY.
1817+ F753 2A BF 5F         LD HL, (MagicCompassTimer)
1818+ F756 7C               LD A, H
1819+ F757 B5               OR L
1820+ F758 28 7B            JR Z, .dcghHide
1821+ F75A 3A C1 5F         LD A, (MagicCompassPathDir)
1822+ F75D 3C               INC A                               ; A=0 si era $FF
1823+ F75E 28 75            JR Z, .dcghHide
1824+ F760 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1825+ F763 B7               OR A
1826+ F764 28 6F            JR Z, .dcghHide
1827+ F766
1828+ F766                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1829+ F766 21 89 F8         LD HL, HintLastDir
1830+ F769 7E               LD A, (HL)
1831+ F76A 47               LD B, A
1832+ F76B 3A C1 5F         LD A, (MagicCompassPathDir)
1833+ F76E B8               CP B
1834+ F76F 20 1A            JR NZ, .dcghDraw
1835+ F771 23               INC HL
1836+ F772 7E               LD A, (HL)
1837+ F773 47               LD B, A
1838+ F774 3A C2 5F         LD A, (MagicCompassPathCoord)
1839+ F777 B8               CP B
1840+ F778 20 11            JR NZ, .dcghDraw
1841+ F77A 23               INC HL
1842+ F77B 7E               LD A, (HL)
1843+ F77C 47               LD B, A
1844+ F77D 3A 0B 83         LD A, (CurrentScreenX)
1845+ F780 B8               CP B
1846+ F781 20 08            JR NZ, .dcghDraw
1847+ F783 23               INC HL
1848+ F784 7E               LD A, (HL)
1849+ F785 47               LD B, A
1850+ F786 3A 0C 83         LD A, (CurrentScreenY)
1851+ F789 B8               CP B
1852+ F78A C8               RET Z                               ; sin cambio -> nada que hacer
1853+ F78B
1854+ F78B              .dcghDraw:
1855+ F78B                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1856+ F78B                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1857+ F78B 3A 89 F8         LD A, (HintLastDir)
1858+ F78E FE FF            CP $FF
1859+ F790 28 1F            JR Z, .dcghDrawNew
1860+ F792 3A 8B F8         LD A, (HintLastScreenX)
1861+ F795 47               LD B, A
1862+ F796 3A 0B 83         LD A, (CurrentScreenX)
1863+ F799 B8               CP B
1864+ F79A 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1865+ F79C 3A 8C F8         LD A, (HintLastScreenY)
1866+ F79F 47               LD B, A
1867+ F7A0 3A 0C 83         LD A, (CurrentScreenY)
1868+ F7A3 B8               CP B
1869+ F7A4 20 0B            JR NZ, .dcghDrawNew
1870+ F7A6 3A 89 F8         LD A, (HintLastDir)
1871+ F7A9 47               LD B, A
1872+ F7AA 3A 8A F8         LD A, (HintLastCoord)
1873+ F7AD 4F               LD C, A
1874+ F7AE CD 2C F8         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1875+ F7B1              .dcghDrawNew:
1876+ F7B1 3A C1 5F         LD A, (MagicCompassPathDir)
1877+ F7B4 47               LD B, A
1878+ F7B5 3A C2 5F         LD A, (MagicCompassPathCoord)
1879+ F7B8 4F               LD C, A
1880+ F7B9 CD 1F F8         CALL DrawHintAtPos
1881+ F7BC                  ; Update cache
1882+ F7BC 3A C1 5F         LD A, (MagicCompassPathDir)
1883+ F7BF 32 89 F8         LD (HintLastDir), A
1884+ F7C2 3A C2 5F         LD A, (MagicCompassPathCoord)
1885+ F7C5 32 8A F8         LD (HintLastCoord), A
1886+ F7C8 3A 0B 83         LD A, (CurrentScreenX)
1887+ F7CB 32 8B F8         LD (HintLastScreenX), A
1888+ F7CE 3A 0C 83         LD A, (CurrentScreenY)
1889+ F7D1 32 8C F8         LD (HintLastScreenY), A
1890+ F7D4 C9               RET
1891+ F7D5
1892+ F7D5              .dcghHide:
1893+ F7D5                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1894+ F7D5 3A 89 F8         LD A, (HintLastDir)
1895+ F7D8 FE FF            CP $FF
1896+ F7DA C8               RET Z
1897+ F7DB 3A 8B F8         LD A, (HintLastScreenX)
1898+ F7DE 47               LD B, A
1899+ F7DF 3A 0B 83         LD A, (CurrentScreenX)
1900+ F7E2 B8               CP B
1901+ F7E3 20 15            JR NZ, .dcghHideInvalidate
1902+ F7E5 3A 8C F8         LD A, (HintLastScreenY)
1903+ F7E8 47               LD B, A
1904+ F7E9 3A 0C 83         LD A, (CurrentScreenY)
1905+ F7EC B8               CP B
1906+ F7ED 20 0B            JR NZ, .dcghHideInvalidate
1907+ F7EF 3A 89 F8         LD A, (HintLastDir)
1908+ F7F2 47               LD B, A
1909+ F7F3 3A 8A F8         LD A, (HintLastCoord)
1910+ F7F6 4F               LD C, A
