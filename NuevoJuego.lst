 798+ D452                  ; >0 = run en curso, emitir valor
 799+ D452              .rleRunEmit:
 800+ D452 3A F3 D4         LD A, (.rleValue)
 801+ D455 2F               CPL
 802+ D456 77               LD (HL), A
 803+ D457 23               INC HL
 804+ D458 3A F2 D4         LD A, (.rlePending)
 805+ D45B 3D               DEC A
 806+ D45C 32 F2 D4         LD (.rlePending), A
 807+ D45F 10 E7            DJNZ .rlePixCol
 808+ D461 18 32            JR .rleRowDone
 809+ D463
 810+ D463              .rleNewToken:
 811+ D463 DD 7E 00         LD A, (IX+0)
 812+ D466 DD 23            INC IX
 813+ D468 CB 7F            BIT 7, A
 814+ D46A 20 18            JR NZ, .rleNewRun
 815+ D46C                  ; --- Literal group: A = count (1-127) ---
 816+ D46C ED 44            NEG                         ; A = -count (negativo)
 817+ D46E 32 F2 D4         LD (.rlePending), A
 818+ D471                  ; fall through: emitir primer byte literal
 819+ D471
