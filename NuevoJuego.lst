 365+ E6E7 21 2D 58         LD HL, $582D
 366+ E6EA DD 7E 06         LD A, (IX+6)
 366+ E6ED CD E6 DE       CALL ApplyDayCycleRemap
 366+ E6F0 77             LD (HL), A
 366+ E6F1 23             INC HL
 367+ E6F2 DD 7E 07         LD A, (IX+7)
 367+ E6F5 CD E6 DE       CALL ApplyDayCycleRemap
 367+ E6F8 77             LD (HL), A
 367+ E6F9 23             INC HL
 368+ E6FA DD 7E 08         LD A, (IX+8)
 368+ E6FD 77                                       LD (HL), A
 368+ E6FE 23             INC HL  ; esfera
 369+ E6FF DD 7E 09         LD A, (IX+9)
 369+ E702 77                                       LD (HL), A
 369+ E703 23             INC HL  ; esfera
 370+ E704 DD 7E 0A         LD A, (IX+10)
 370+ E707 CD E6 DE       CALL ApplyDayCycleRemap
