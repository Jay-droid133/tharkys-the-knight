 360  A105                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A105              ; ==============================================================================
   2+ A105              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A105              ; ==============================================================================
   4+ A105              ; - Estructura de entidad de 12 bytes (universal)
   5+ A105              ; - Game loop per-entity: erase → update → draw
   6+ A105              ; - Movimiento 8-bit (sin subpixel)
   7+ A105              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A105              ; - XOR draw/erase (una sola rutina)
   9+ A105              ; ==============================================================================
  10+ A105
  11+ A105              ; ==============================================================================
  12+ A105              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A105              ; ==============================================================================
  14+ A105              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A105              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A105              ; ==============================================================================
  17+ A105              ReadInput:
  18+ A105 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A107 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A109
  21+ A109                  ; -- 1. QAOP --
  22+ A109 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A10C ED 78            IN A, (C)
  24+ A10E CB 47            BIT 0, A            ; Q = Arriba
  25+ A110 20 02            JR NZ, .no_q
  26+ A112 CB C2            SET 0, D
  27+ A114              .no_q:
  28+ A114 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A117 ED 78            IN A, (C)
  30+ A119 CB 47            BIT 0, A            ; A = Abajo
  31+ A11B 20 02            JR NZ, .no_a
  32+ A11D CB CA            SET 1, D
  33+ A11F              .no_a:
  34+ A11F 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A122 ED 78            IN A, (C)
  36+ A124 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A126 20 02            JR NZ, .no_o
  38+ A128 CB DA            SET 3, D
  39+ A12A              .no_o:
  40+ A12A CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A12C 20 02            JR NZ, .no_p
  42+ A12E CB D2            SET 2, D
  43+ A130              .no_p:
  44+ A130
  45+ A130                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A130                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A130 DB 1F            IN A, (31)
  48+ A132 4F               LD C, A             ; guardar para fire
  49+ A133 CB 5F            BIT 3, A            ; Up
  50+ A135 28 02            JR Z, .no_k_up
  51+ A137 CB C2            SET 0, D
  52+ A139              .no_k_up:
  53+ A139 CB 57            BIT 2, A            ; Down
  54+ A13B 28 02            JR Z, .no_k_down
  55+ A13D CB CA            SET 1, D
  56+ A13F              .no_k_down:
  57+ A13F CB 4F            BIT 1, A            ; Left
  58+ A141 28 02            JR Z, .no_k_left
  59+ A143 CB DA            SET 3, D
  60+ A145              .no_k_left:
  61+ A145 CB 47            BIT 0, A            ; Right
  62+ A147 28 02            JR Z, .no_k_right
  63+ A149 CB D2            SET 2, D
  64+ A14B              .no_k_right:
  65+ A14B CB 61            BIT 4, C            ; Kempston Fire
  66+ A14D 28 02            JR Z, .no_k_fire
  67+ A14F CB C3            SET 0, E
  68+ A151              .no_k_fire:
  69+ A151
  70+ A151                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A151                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A151 01 FE F7         LD BC, $F7FE
  73+ A154 ED 78            IN A, (C)
  74+ A156 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A158 20 02            JR NZ, .no_s1_up
  76+ A15A CB C2            SET 0, D
  77+ A15C              .no_s1_up:
  78+ A15C CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A15E 20 02            JR NZ, .no_s1_down
  80+ A160 CB CA            SET 1, D
  81+ A162              .no_s1_down:
  82+ A162 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A164 20 02            JR NZ, .no_s1_left
  84+ A166 CB DA            SET 3, D
  85+ A168              .no_s1_left:
  86+ A168 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A16A 20 02            JR NZ, .no_s1_right
  88+ A16C CB D2            SET 2, D
  89+ A16E              .no_s1_right:
  90+ A16E CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A170 20 02            JR NZ, .no_s1_fire
  92+ A172 CB C3            SET 0, E
  93+ A174              .no_s1_fire:
  94+ A174
  95+ A174                  ; -- 4. SPACE = Fire (teclado) --
  96+ A174 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A177 ED 78            IN A, (C)
  98+ A179 CB 47            BIT 0, A            ; SPACE
  99+ A17B 20 02            JR NZ, .no_space
 100+ A17D CB C3            SET 0, E
 101+ A17F              .no_space:
 102+ A17F
 103+ A17F                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A17F 7B               LD A, E
 105+ A180 32 5C 82         LD (InputFire), A
 106+ A183
 107+ A183                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 --
 108+ A183 21 7F 82         LD HL, MushroomLockTimer
 109+ A186 7E               LD A, (HL)
 110+ A187 23               INC HL
 111+ A188 B6               OR (HL)
 112+ A189 28 04            JR Z, .noMushLock
 113+ A18B AF               XOR A
 114+ A18C 32 5C 82         LD (InputFire), A
 115+ A18F              .noMushLock:
 116+ A18F
 117+ A18F                  ; -- 6. Cancelar opuestos --
 118+ A18F 7A               LD A, D
 119+ A190 47               LD B, A
 120+ A191 E6 03            AND DIR_N | DIR_S
 121+ A193 FE 03            CP DIR_N | DIR_S
 122+ A195 20 04            JR NZ, .noVC
 123+ A197 78               LD A, B
 124+ A198 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 125+ A19A 47               LD B, A
 126+ A19B              .noVC:
 127+ A19B 78               LD A, B
 128+ A19C E6 0C            AND DIR_E | DIR_W
 129+ A19E FE 0C            CP DIR_E | DIR_W
 130+ A1A0 20 04            JR NZ, .noHC
 131+ A1A2 78               LD A, B
 132+ A1A3 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 133+ A1A5 47               LD B, A
 134+ A1A6              .noHC:
 135+ A1A6 78               LD A, B
 136+ A1A7 32 5B 82         LD (InputDirection), A
 137+ A1AA C9               RET
 138+ A1AB
 139+ A1AB              ; ==============================================================================
 140+ A1AB              ; InitEntities - Inicializa la tabla de entidades
 141+ A1AB              ; ==============================================================================
 142+ A1AB              ; Limpia todos los slots y configura el slot 0 como player.
 143+ A1AB              ; ==============================================================================
 144+ A1AB              InitEntities:
 145+ A1AB                  ; Limpiar toda la tabla a ceros
 146+ A1AB 21 4B 81         LD HL, EntityTable
 147+ A1AE 11 4C 81         LD DE, EntityTable + 1
 148+ A1B1 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 149+ A1B4 AF               XOR A
 150+ A1B5 77               LD (HL), A
 151+ A1B6 ED B0            LDIR
 152+ A1B8
 153+ A1B8                  ; Limpiar tabla de atributos salvados
 154+ A1B8 21 22 9F         LD HL, SavedAttrTable
 155+ A1BB 11 23 9F         LD DE, SavedAttrTable + 1
 156+ A1BE 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 157+ A1C1 AF               XOR A
 158+ A1C2 77               LD (HL), A
 159+ A1C3 ED B0            LDIR
 160+ A1C5
 161+ A1C5                  ; Configurar slot 0: Player
 162+ A1C5 DD 21 4B 81      LD IX, EntityTable
 163+ A1C9 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 164+ A1CD DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 165+ A1D1 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 166+ A1D5 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 167+ A1D9 DD 36 04 A0      LD (IX+ENT_POSY), START_PLAYER_Y
 168+ A1DD DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 169+ A1E1 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 170+ A1E5 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 171+ A1E9 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 172+ A1ED DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 173+ A1F1 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 174+ A1F5 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 175+ A1F9 DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 176+ A1FD DD 36 0D A0      LD (IX+ENT_OLDY), START_PLAYER_Y
 177+ A201 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 178+ A205 DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
 179+ A209
 180+ A209                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 181+ A209 3E 0C            LD A, SPAWN_INTERVAL
 182+ A20B 32 9A 82         LD (SpawnTimer), A
 183+ A20E AF               XOR A
 184+ A20F 32 A7 82         LD (EnemyStepIdx), A
 185+ A212 32 7B 5F         LD (PendingEraseCount), A
 186+ A215 C9               RET
 187+ A216
 188+ A216              ; ==============================================================================
 189+ A216              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 190+ A216              ; ==============================================================================
 191+ A216              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 192+ A216              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 193+ A216              ; que los pies parezcan hundirse en el suelo.
 194+ A216              ; ==============================================================================
 195+ A216              ComputePlayerDrawY:
 196+ A216 3A 4E 81         LD A, (EntityTable + ENT_POSX)
 197+ A219 C6 08            ADD A, 8                    ; center X del player
 198+ A21B 47               LD B, A
 199+ A21C 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 200+ A21F 4F               LD C, A
 201+ A220 32 81 82         LD (PlayerDrawY), A         ; default: sin offset
 202+ A223 B7               OR A
 203+ A224 C8               RET Z
 204+ A225 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 205+ A226 CD 0C D8         CALL IsPointBlocked
 206+ A229 C8               RET Z                       ; libre → sin offset
 207+ A22A 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 208+ A22D 3C               INC A
 209+ A22E 32 81 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 210+ A231 C9               RET
 211+ A232
 212+ A232              ; ==============================================================================
 213+ A232              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 214+ A232              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 215+ A232              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 216+ A232              ; no parecer que se hunde en el techo.
 217+ A232              ; Preserva: IX. Destruye: AF, BC.
 218+ A232              ; ==============================================================================
 219+ A232              ComputeEnemyDrawY:
 220+ A232 DD 7E 04         LD A, (IX+ENT_POSY)
 221+ A235 32 82 82         LD (EnemyDrawY), A          ; default = POSY
 222+ A238 DD 7E 01         LD A, (IX+ENT_TYPE)
 223+ A23B FE 02            CP TYPE_MONSTER
 224+ A23D C0               RET NZ                      ; no monster → sin offset
 225+ A23E DD 7E 03         LD A, (IX+ENT_POSX)
 226+ A241 C6 08            ADD A, 8                    ; center X
 227+ A243 47               LD B, A
 228+ A244 DD 7E 04         LD A, (IX+ENT_POSY)
 229+ A247 4F               LD C, A
 230+ A248 B7               OR A
 231+ A249 C8               RET Z
 232+ A24A 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 233+ A24B CD 0C D8         CALL IsPointBlocked
 234+ A24E C8               RET Z                       ; libre → sin offset
 235+ A24F DD 7E 04         LD A, (IX+ENT_POSY)
 236+ A252 3C               INC A
 237+ A253 32 82 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 238+ A256 C9               RET
 239+ A257
 240+ A257              ; ==============================================================================
 241+ A257              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 242+ A257              ; ==============================================================================
 243+ A257              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 244+ A257              ; ==============================================================================
 245+ A257              ProcessPlayer:
 246+ A257 DD 21 4B 81      LD IX, EntityTable
 247+ A25B
 248+ A25B                  ; --- Fresh check ---
 249+ A25B 3A B7 82         LD A, (ScreenJustRedrawn)
 250+ A25E B7               OR A
 251+ A25F C2 41 A3         JP NZ, .plFresh
 252+ A262 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 253+ A266 C2 41 A3         JP NZ, .plFresh
 254+ A269
 255+ A269                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 256+ A269                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 257+ A269                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 258+ A269                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 259+ A269                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 260+ A269                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 261+ A269                  ; y UpdatePlayerAnimation lo sobrescribiria.
 262+ A269 3A 8C 82         LD A, (DeathBorderPhase)
 263+ A26C B7               OR A
 264+ A26D 20 0A            JR NZ, .plSkipUpdate
 265+ A26F 3A 90 82         LD A, (PlayerRespawnPhase)
 266+ A272 FE 01            CP 1
 267+ A274 28 03            JR Z, .plSkipUpdate
 268+ A276 CD A2 A8         CALL UpdatePlayer
 269+ A279              .plSkipUpdate:
 270+ A279 CD BB A7         CALL CalcDrawX
 271+ A27C CD 16 A2         CALL ComputePlayerDrawY
 272+ A27F
 273+ A27F                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 274+ A27F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 275+ A282 DD BE 0C         CP (IX+ENT_OLDX)
 276+ A285 20 47            JR NZ, .plDoErase
 277+ A287 3A 81 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 278+ A28A DD BE 0D         CP (IX+ENT_OLDY)
 279+ A28D 20 3F            JR NZ, .plDoErase
 280+ A28F DD 7E 00         LD A, (IX+ENT_SPRITEID)
 281+ A292 DD BE 0E         CP (IX+ENT_OLDSPRID)
 282+ A295 20 37            JR NZ, .plDoErase
 283+ A297                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 284+ A297 3A 06 C8         LD A, (PlayerHitTimer)
 285+ A29A B7               OR A
 286+ A29B 20 01            JR NZ, .plRepaintAttr
 287+ A29D C9               RET                                 ; Nada cambio → skip todo
 288+ A29E              .plRepaintAttr:
 289+ A29E 3A 81 82         LD A, (PlayerDrawY)
 290+ A2A1 57               LD D, A
 291+ A2A2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 292+ A2A5 5F               LD E, A
 293+ A2A6 DD E5            PUSH IX
 294+ A2A8 CD 00 A8         CALL GetSpriteAddr
 295+ A2AB DD 2A 2F A8      LD IX, (SpriteAddrTemp)
 296+ A2AF CD 4F 9E         CALL CalcEntityAttrSize
 297+ A2B2                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 298+ A2B2 3A 21 9F         LD A, (EntityAttrH)
 299+ A2B5 FE 02            CP 2
