 191+ F9EC              ; --- SFX_Pickup: "ding" ascendente corto al recoger objeto (~50ms) ---
 192+ F9EC              SFX_Pickup:
 193+ F9EC 28 32 00 00      DEFB 40, 50, 0, 0          ; tono grave largo
 194+ F9F0 28 23 00 00      DEFB 40, 35, 0, 0          ; tono medio
 195+ F9F4 28 19 00 00      DEFB 40, 25, 0, 0          ; tono medio-agudo
 196+ F9F8 28 12 00 00      DEFB 40, 18, 0, 0          ; tono agudo
 197+ F9FC 32 0C FF 00      DEFB 50, 12, -1, 0         ; sweep ascendente final
 198+ FA00 00               DEFB 0                      ; fin
 199+ FA01
 200+ FA01              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 201+ FA01              ; Tono grave resonante con decay lento, como campana de iglesia
 202+ FA01              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 203+ FA01              SFX_BellChime:
 204+ FA01 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 205+ FA05 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 206+ FA09 00               DEFB 0                      ; fin
 207+ FA0A
 208+ FA0A              ; --- SFX_ChurchDoorOpen: "click + creak" puerta de iglesia (~300ms) ---
 209+ FA0A              ; Click corto inicial (cerrojo), luego crujido lento ascendente (madera vieja
 210+ FA0A              ; girando con esfuerzo). Valores iniciales — afinar en el emulador.
 211+ FA0A              SFX_ChurchDoorOpen:
 212+ FA0A 0C 32 00 01      DEFB 12,  50,  0, 1          ; click: 12 iter ruido pitch 50
 213+ FA0E 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 214+ FA12 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 215+ FA16 00               DEFB  0                       ; fin
 216+ FA17
 217+ FA17              ; --- SFX_BlockedExit: "BUZZ - BUZZ - BUZZ" triple tono profundo (~500 ticks) ---
 218+ FA17              ; Disparado cuando el jugador intenta salir de la iglesia hacia el sur
 219+ FA17              ; mientras el reloj esta congelado (fase de captura). Tres tonos cuadrados
 220+ FA17              ; muy graves separados por breves pausas para sugerir "no, no, no" como
 221+ FA17              ; un buzzer triple de concurso televisivo.
 222+ FA17              ;
 223+ FA17              ; En modo noise el pitch real esta limitado a 0-31 por AND $1F, por eso
 224+ FA17              ; usamos modo tono (noise=0) con pitch alto: el delay loop usa C
 225+ FA17              ; directamente, asi que pitch=220 da un periodo mucho mas largo (~7x mas
 226+ FA17              ; profundo que el max del modo noise).
 227+ FA17              SFX_BlockedExit:
 228+ FA17                  ; "Contraseña incorrecta" estilo pelicula: dos pulsos cortos harsh
 229+ FA17                  ; con noise (texture digital "BRRRT-BRRRT" tipo "ACCESS DENIED").
 230+ FA17                  ; Cada burst se hace con dos phases consecutivas porque cada phase
 231+ FA17                  ; en modo noise tiene duracion real corta (iter ~80us a pitch=8).
 232+ FA17 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1a: noise harsh
 233+ FA1B FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1b: continua
 234+ FA1F 50 28 00 00      DEFB  80, 40, 0, 0          ; gap tonal audible para separacion
 235+ FA23 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2a
 236+ FA27 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2b
 237+ FA2B 00               DEFB   0                    ; fin
 238+ FA2C
 239+ FA2C              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 240+ FA2C              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 241+ FA2C              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 242+ FA2C              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 243+ FA2C              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 244+ FA2C              SFX_KeyDrop:
 245+ FA2C 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 246+ FA30 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 247+ FA34 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 248+ FA38 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 249+ FA3C 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 250+ FA40 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 251+ FA44 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 252+ FA48 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 253+ FA4C 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 254+ FA50 00               DEFB   0                       ; fin
 255+ FA51
 256+ FA51              ; --- Sistema de campanadas con pausa entre ellas ---
 257+ FA51              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 258+ FA51              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 259+ FA51              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 260+ FA51 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 261+ FA52 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 262+ FA54              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 263+ FA54              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 264+ FA54
 265+ FA54              ; --- Cadena de eventos tras la ultima campanada ---
 266+ FA54              ; last chime → (delay) → windows off → (delay) → monster spawn
 267+ FA54              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 268+ FA54              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 269+ FA54 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 270+ FA55 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 271+ FA56
 272+ FA56              ; ==============================================================================
 273+ FA56              ; StartBellChimes - Inicia secuencia de 12 campanadas
 274+ FA56              ; ==============================================================================
 275+ FA56              StartBellChimes:
 276+ FA56 3E 03            LD A, 3                             ; DEBUG: 3 campanadas (era 12)
 277+ FA58 32 51 FA         LD (BellCount), A
 278+ FA5B                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 279+ FA5B 2A 78 5C         LD HL, (SYS_FRAMES)
 280+ FA5E 22 52 FA         LD (BellNextFrame), HL
 281+ FA61 3E 7D            LD A, SCARE_TIMER_BELLS
 282+ FA63 32 35 B8         LD (ScareTimer), A
 283+ FA66 C9               RET
 284+ FA67
 285+ FA67              ; ==============================================================================
 286+ FA67              ; UpdateBellChimes - Llamar cada frame desde el main loop
 287+ FA67              ; ==============================================================================
 288+ FA67              UpdateBellChimes:
 289+ FA67 3A 51 FA         LD A, (BellCount)
 290+ FA6A B7               OR A
 291+ FA6B C8               RET Z                       ; sin campanadas pendientes
 292+ FA6C
 293+ FA6C                  ; Comparar FRAMES actual con BellNextFrame
 294+ FA6C 2A 78 5C         LD HL, (SYS_FRAMES)
 295+ FA6F ED 5B 52 FA      LD DE, (BellNextFrame)
 296+ FA73 B7               OR A
 297+ FA74 ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 298+ FA76 D8               RET C                       ; FRAMES < deadline → aun no toca
 299+ FA77
 300+ FA77                  ; Sonar campanada (AY, no bloquea CPU)
 301+ FA77 C5               PUSH BC
 302+ FA78 D5               PUSH DE
 303+ FA79 CD 0D FB         CALL AY_PlayBellChime
 304+ FA7C D1               POP DE
 305+ FA7D C1               POP BC
 306+ FA7E
 307+ FA7E                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 308+ FA7E                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 309+ FA7E 2A 78 5C         LD HL, (SYS_FRAMES)
 310+ FA81 11 4B 00         LD DE, BELL_PAUSE
 311+ FA84 19               ADD HL, DE
 312+ FA85 22 52 FA         LD (BellNextFrame), HL
 313+ FA88
 314+ FA88 21 51 FA         LD HL, BellCount
 315+ FA8B 35               DEC (HL)
 316+ FA8C C0               RET NZ
 317+ FA8D 18 00            JR .bellsDone
 318+ FA8F
 319+ FA8F              .bellsDone:
 320+ FA8F                  ; Ultima campanada:
 321+ FA8F                  ;   1) matar todos los nasties vivos (puff)
 322+ FA8F                  ;   2) arrancar cadena diferida: windows off → monster spawn
 323+ FA8F CD 64 BC         CALL KillAllActiveNasties
 324+ FA92 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 325+ FA94 32 54 FA         LD (BellsDoneTimer), A
 326+ FA97 C9               RET
 327+ FA98
 328+ FA98              ; ==============================================================================
 329+ FA98              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 330+ FA98              ; ==============================================================================
 331+ FA98              ; Maneja la cadena diferida tras la ultima campanada:
 332+ FA98              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 333+ FA98              ;      y arranca SpawnAfterWinTimer
 334+ FA98              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 335+ FA98              ; ==============================================================================
 336+ FA98              UpdateBellsDoneTimer:
 337+ FA98 3A 54 FA         LD A, (BellsDoneTimer)
 338+ FA9B B7               OR A
 339+ FA9C 28 20            JR Z, .ubdCheckSpawn
 340+ FA9E 3D               DEC A
 341+ FA9F 32 54 FA         LD (BellsDoneTimer), A
 342+ FAA2 20 1A            JR NZ, .ubdCheckSpawn
 343+ FAA4                  ; Llego a 0: apagar ventanas
 344+ FAA4 CD 66 DD         CALL UpdateRemapTables
 345+ FAA7 3E 01            LD A, 1
 346+ FAA9 32 5E 82         LD (AttrsDirty), A
 347+ FAAC                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 348+ FAAC                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 349+ FAAC                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 350+ FAAC                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 351+ FAAC 3A 2A 82         LD A, (ChurchDoorOpen)
 352+ FAAF B7               OR A
 353+ FAB0 28 03            JR Z, .ubdSkipHighlight
 354+ FAB2 CD 58 EC         CALL StartStatueBlink
 355+ FAB5              .ubdSkipHighlight:
 356+ FAB5 3E 26            LD A, POST_WINDOWS_SPAWN_DELAY
 357+ FAB7 32 55 FA         LD (SpawnAfterWinTimer), A
 358+ FABA                  ; Musica de tension organica entre lights-off y monster spawn
 359+ FABA CD 13 FC         CALL StartTensionMusic
 360+ FABD C9               RET
 361+ FABE              .ubdCheckSpawn:
 362+ FABE 3A 55 FA         LD A, (SpawnAfterWinTimer)
 363+ FAC1 B7               OR A
 364+ FAC2 C8               RET Z
 365+ FAC3 3D               DEC A
 366+ FAC4 32 55 FA         LD (SpawnAfterWinTimer), A
 367+ FAC7 C0               RET NZ
 368+ FAC8                  ; Llego a 0: spawnear monsters
 369+ FAC8 C3 65 BD         JP SpawnMonsters
 370+ FACB
# file closed: sound.asm
 207  FACB                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ FACB              ; ==============================================================================
   2+ FACB              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ FACB              ; ==============================================================================
   4+ FACB              ; Puertos:
   5+ FACB              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ FACB              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ FACB              ;
   8+ FACB              ; Registros AY:
   9+ FACB              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ FACB              ;   R2/R3: tono canal B
  11+ FACB              ;   R4/R5: tono canal C
  12+ FACB              ;   R6:    period del ruido (5 bits)
  13+ FACB              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ FACB              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ FACB              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ FACB              ;   R9:    volumen B
  17+ FACB              ;   R10:   volumen C
  18+ FACB              ;   R11/R12: period del envelope
  19+ FACB              ;   R13:   forma del envelope (0-15)
  20+ FACB              ; ==============================================================================
  21+ FACB
  22+ FACB              ; ==============================================================================
  23+ FACB              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ FACB              ; ==============================================================================
  25+ FACB              ; Entrada: A = registro (0-13), E = valor
  26+ FACB              ; Destruye: BC, A
  27+ FACB              ; ==============================================================================
  28+ FACB              AY_WriteReg:
  29+ FACB 01 FD FF         LD BC, $FFFD
  30+ FACE ED 79            OUT (C), A                  ; seleccionar registro
  31+ FAD0 01 FD BF         LD BC, $BFFD
  32+ FAD3 ED 59            OUT (C), E                  ; escribir valor
  33+ FAD5 C9               RET
  34+ FAD6
  35+ FAD6              ; ==============================================================================
  36+ FAD6              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ FAD6              ; ==============================================================================
  38+ FAD6              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ FAD6              ; ==============================================================================
  40+ FAD6              AY_Stop:
  41+ FAD6 3E 08            LD A, 8
  42+ FAD8 1E 00            LD E, 0
  43+ FADA CD CB FA         CALL AY_WriteReg
  44+ FADD 3E 09            LD A, 9
  45+ FADF 1E 00            LD E, 0
  46+ FAE1 CD CB FA         CALL AY_WriteReg
  47+ FAE4 3E 0A            LD A, 10
  48+ FAE6 1E 00            LD E, 0
  49+ FAE8 CD CB FA         CALL AY_WriteReg
  50+ FAEB C9               RET
  51+ FAEC
  52+ FAEC              ; ==============================================================================
  53+ FAEC              ; AY_Init - Silencia todos los canales (volumen 0, mixer todo off)
  54+ FAEC              ; ==============================================================================
  55+ FAEC              AY_Init:
  56+ FAEC 3E 07            LD A, 7                     ; mixer
  57+ FAEE 1E 3F            LD E, $3F                   ; todos los tonos y ruidos en off
  58+ FAF0 CD CB FA         CALL AY_WriteReg
  59+ FAF3 3E 08            LD A, 8                     ; volumen A
  60+ FAF5 1E 00            LD E, 0
  61+ FAF7 CD CB FA         CALL AY_WriteReg
  62+ FAFA 3E 09            LD A, 9                     ; volumen B
  63+ FAFC 1E 00            LD E, 0
  64+ FAFE CD CB FA         CALL AY_WriteReg
  65+ FB01 3E 0A            LD A, 10                    ; volumen C
  66+ FB03 1E 00            LD E, 0
  67+ FB05 CD CB FA         CALL AY_WriteReg
  68+ FB08 C9               RET
  69+ FB09
  70+ FB09              ; ==============================================================================
  71+ FB09              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  72+ FB09              ; ==============================================================================
  73+ FB09              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  74+ FB09              ; el AY toca solo durante el decay.
  75+ FB09              ; ==============================================================================
  76+ FB09              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  77+ FB09              ; ==============================================================================
  78+ FB09              ; ==============================================================================
  79+ FB09              ; Variables del decay manual de la campana (con pan estereo)
  80+ FB09              ; ==============================================================================
  81+ FB09              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  82+ FB09              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  83+ FB09              ; Cuando los 3 son 0, la campana esta silenciada.
  84+ FB09 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  85+ FB0A 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  86+ FB0B 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  87+ FB0C 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  88+ FB0D
  89+ FB0D              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  90+ FB0D
  91+ FB0D              ; ==============================================================================
  92+ FB0D              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  93+ FB0D              ; ==============================================================================
  94+ FB0D              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  95+ FB0D              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  96+ FB0D              ; ==============================================================================
  97+ FB0D              AY_PlayBellChime:
  98+ FB0D                  ; --- Calcular dx (signed) y |dx|, |dy| ---
  99+ FB0D 3A 55 82         LD A, (CurrentScreenX)
 100+ FB10 D6 07            SUB START_SCREEN_X          ; A = dx (signed: + plaza al oeste, - plaza al este)
 101+ FB12 57               LD D, A                     ; D = dx signed (player - plaza)
 102+ FB13 30 02            JR NC, .absDxOk
 103+ FB15 ED 44            NEG
 104+ FB17              .absDxOk:
 105+ FB17 47               LD B, A                     ; B = |dx|
 106+ FB18
 107+ FB18 3A 56 82         LD A, (CurrentScreenY)
 108+ FB1B D6 0E            SUB START_SCREEN_Y
 109+ FB1D 30 02            JR NC, .absDyOk
 110+ FB1F ED 44            NEG
 111+ FB21              .absDyOk:
 112+ FB21 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 113+ FB22 4F               LD C, A                     ; C = distancia
 114+ FB23
 115+ FB23                  ; --- Volumen total = max(15 - dist*2, 1) ---
 116+ FB23 87               ADD A, A                    ; A = dist * 2
 117+ FB24 47               LD B, A
 118+ FB25 3E 0F            LD A, 15
 119+ FB27 90               SUB B                       ; A = 15 - dist*2
 120+ FB28 30 02            JR NC, .volTotalOk
 121+ FB2A 3E 01            LD A, 1
 122+ FB2C              .volTotalOk:
 123+ FB2C B7               OR A
 124+ FB2D 20 02            JR NZ, .volTotalSet
 125+ FB2F 3E 01            LD A, 1
 126+ FB31              .volTotalSet:
 127+ FB31 47               LD B, A                     ; B = volumen total (1-15)
 128+ FB32
 129+ FB32                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 130+ FB32                  ; D > 0  → player está al ESTE de plaza → plaza al oeste (canal A más fuerte)
 131+ FB32                  ; D < 0  → player está al OESTE de plaza → plaza al este (canal C más fuerte)
 132+ FB32                  ; D == 0 → alineado X → canal B
 133+ FB32 7A               LD A, D
 134+ FB33 B7               OR A
 135+ FB34 28 27            JR Z, .panCenter
 136+ FB36 F2 4B FB         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 137+ FB39                  ; D < 0: plaza al este → canal C dominante
 138+ FB39 78               LD A, B                     ; A = vol total
 139+ FB3A 32 0B FB         LD (BellVolR), A            ; canal C = full
 140+ FB3D CB 38            SRL B
 141+ FB3F 78               LD A, B
 142+ FB40 32 0A FB         LD (BellVolC), A            ; canal B = mitad
 143+ FB43 CB 38            SRL B
 144+ FB45 78               LD A, B
 145+ FB46 32 09 FB         LD (BellVolL), A            ; canal A = cuarto
 146+ FB49 18 1D            JR .panDone
 147+ FB4B
 148+ FB4B              .panLeft:
 149+ FB4B                  ; D > 0: plaza al oeste → canal A dominante
 150+ FB4B 78               LD A, B
 151+ FB4C 32 09 FB         LD (BellVolL), A
 152+ FB4F CB 38            SRL B
 153+ FB51 78               LD A, B
 154+ FB52 32 0A FB         LD (BellVolC), A
 155+ FB55 CB 38            SRL B
 156+ FB57 78               LD A, B
 157+ FB58 32 0B FB         LD (BellVolR), A
 158+ FB5B 18 0B            JR .panDone
 159+ FB5D
 160+ FB5D              .panCenter:
 161+ FB5D                  ; Alineado: solo canal B
 162+ FB5D 78               LD A, B
 163+ FB5E 32 0A FB         LD (BellVolC), A
 164+ FB61 AF               XOR A
 165+ FB62 32 09 FB         LD (BellVolL), A
 166+ FB65 32 0B FB         LD (BellVolR), A
 167+ FB68
 168+ FB68              .panDone:
 169+ FB68 3E 02            LD A, BELL_DECAY_RATE
 170+ FB6A 32 0C FB         LD (BellDecayTimer), A
 171+ FB6D
 172+ FB6D                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 173+ FB6D 3E 00            LD A, 0                     ; R0: tone A LSB
 174+ FB6F 1E 58            LD E, $58
 175+ FB71 CD CB FA         CALL AY_WriteReg
 176+ FB74 3E 01            LD A, 1                     ; R1: tone A MSB
 177+ FB76 1E 02            LD E, $02
 178+ FB78 CD CB FA         CALL AY_WriteReg
 179+ FB7B 3E 02            LD A, 2                     ; R2: tone B LSB
 180+ FB7D 1E 58            LD E, $58
 181+ FB7F CD CB FA         CALL AY_WriteReg
 182+ FB82 3E 03            LD A, 3                     ; R3: tone B MSB
 183+ FB84 1E 02            LD E, $02
 184+ FB86 CD CB FA         CALL AY_WriteReg
 185+ FB89 3E 04            LD A, 4                     ; R4: tone C LSB
 186+ FB8B 1E 58            LD E, $58
 187+ FB8D CD CB FA         CALL AY_WriteReg
 188+ FB90 3E 05            LD A, 5                     ; R5: tone C MSB
 189+ FB92 1E 02            LD E, $02
 190+ FB94 CD CB FA         CALL AY_WriteReg
 191+ FB97
 192+ FB97                  ; --- Mixer: tonos A, B, C activos ---
 193+ FB97 3E 07            LD A, 7
 194+ FB99 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 195+ FB9B CD CB FA         CALL AY_WriteReg
 196+ FB9E
 197+ FB9E                  ; --- Volúmenes iniciales ---
 198+ FB9E 3E 08            LD A, 8
 199+ FBA0 21 09 FB         LD HL, BellVolL
 200+ FBA3 5E               LD E, (HL)
 201+ FBA4 CD CB FA         CALL AY_WriteReg
 202+ FBA7 3E 09            LD A, 9
 203+ FBA9 21 0A FB         LD HL, BellVolC
 204+ FBAC 5E               LD E, (HL)
 205+ FBAD CD CB FA         CALL AY_WriteReg
 206+ FBB0 3E 0A            LD A, 10
 207+ FBB2 21 0B FB         LD HL, BellVolR
 208+ FBB5 5E               LD E, (HL)
 209+ FBB6 CD CB FA         CALL AY_WriteReg
 210+ FBB9
 211+ FBB9 C9               RET
 212+ FBBA
 213+ FBBA              ; ==============================================================================
 214+ FBBA              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 215+ FBBA              ; ==============================================================================
 216+ FBBA              ; Llamar cada frame desde el main loop.
 217+ FBBA              ; ==============================================================================
 218+ FBBA              AY_UpdateBell:
 219+ FBBA                  ; ¿alguno de los 3 canales aún suena?
 220+ FBBA 3A 09 FB         LD A, (BellVolL)
 221+ FBBD 47               LD B, A
 222+ FBBE 3A 0A FB         LD A, (BellVolC)
 223+ FBC1 B0               OR B
 224+ FBC2 47               LD B, A
 225+ FBC3 3A 0B FB         LD A, (BellVolR)
 226+ FBC6 B0               OR B
 227+ FBC7 C8               RET Z                       ; los 3 a 0 → silenciado
 228+ FBC8
 229+ FBC8 21 0C FB         LD HL, BellDecayTimer
 230+ FBCB 35               DEC (HL)
 231+ FBCC C0               RET NZ                      ; aun no toca decrementar
 232+ FBCD
 233+ FBCD 3E 02            LD A, BELL_DECAY_RATE
 234+ FBCF 32 0C FB         LD (BellDecayTimer), A
 235+ FBD2
 236+ FBD2                  ; Decrementar canal A (si > 0)
 237+ FBD2 3A 09 FB         LD A, (BellVolL)
 238+ FBD5 B7               OR A
 239+ FBD6 28 0A            JR Z, .skipA
 240+ FBD8 3D               DEC A
 241+ FBD9 32 09 FB         LD (BellVolL), A
 242+ FBDC 5F               LD E, A
 243+ FBDD 3E 08            LD A, 8
 244+ FBDF CD CB FA         CALL AY_WriteReg
 245+ FBE2              .skipA:
 246+ FBE2
 247+ FBE2                  ; Decrementar canal B (si > 0)
 248+ FBE2 3A 0A FB         LD A, (BellVolC)
 249+ FBE5 B7               OR A
 250+ FBE6 28 0A            JR Z, .skipB
 251+ FBE8 3D               DEC A
 252+ FBE9 32 0A FB         LD (BellVolC), A
 253+ FBEC 5F               LD E, A
 254+ FBED 3E 09            LD A, 9
 255+ FBEF CD CB FA         CALL AY_WriteReg
 256+ FBF2              .skipB:
 257+ FBF2
 258+ FBF2                  ; Decrementar canal C (si > 0)
 259+ FBF2 3A 0B FB         LD A, (BellVolR)
 260+ FBF5 B7               OR A
 261+ FBF6 C8               RET Z
 262+ FBF7 3D               DEC A
 263+ FBF8 32 0B FB         LD (BellVolR), A
 264+ FBFB 5F               LD E, A
 265+ FBFC 3E 0A            LD A, 10
 266+ FBFE C3 CB FA         JP AY_WriteReg              ; tail call
 267+ FC01
 268+ FC01              ; ==============================================================================
 269+ FC01              ; TENSION MUSIC - "Ti-to-di-to" de organo grave entre lights-off y monster spawn
 270+ FC01              ; ==============================================================================
 271+ FC01              ; Disparada por UpdateBellsDoneTimer al apagar las ventanas. Reproduce un motivo
 272+ FC01              ; corto de 4 notas en el canal A del AY mientras corre el SpawnAfterWinTimer.
 273+ FC01              ; Patron tabular dirigido por frame: TensionMusicTable contiene (period_lo,
 274+ FC01              ; period_hi, duration_frames) por nota. Marca de fin = duration 0.
 275+ FC01              ;
 276+ FC01              ; CPU-free durante la reproduccion: solo escribe registros AY al cambiar de nota.
 277+ FC01              ; No interfiere con BellVolL/C/R (decay completo antes de lights-off por
 278+ FC01              ; POST_BELL_WINDOWS_DELAY = 45f vs decay max 30f).
 279+ FC01              ; ==============================================================================
 280+ FC01 00 00        TensionMusicPtr:    DEFW 0          ; Ptr a la nota actual en TensionMusicTable
 281+ FC03 00           TensionMusicTimer:  DEFB 0          ; Frames restantes en la nota actual (0 = inactivo)
 282+ FC04
 283+ FC04              ; Tabla: 4 notas en registro grave de organo (A2 - C3 - A2 - D3, ~1.5s total)
 284+ FC04              ; Period AY = 1750000 / (16 * frequency). Duraciones en frames a 25fps.
 285+ FC04              TensionMusicTable:
 286+ FC04 E2 03            DEFW $03E2                      ; A2  ~110 Hz
 287+ FC06 09               DEFB 9                          ; ~360ms
 288+ FC07 44 03            DEFW $0344                      ; C3  ~131 Hz
 289+ FC09 09               DEFB 9
 290+ FC0A E2 03            DEFW $03E2                      ; A2
 291+ FC0C 09               DEFB 9
 292+ FC0D E9 02            DEFW $02E9                      ; D3  ~147 Hz (climax mas alto)
 293+ FC0F 0B               DEFB 11                         ; ~440ms sostenido
 294+ FC10 00 00            DEFW 0
 295+ FC12 00               DEFB 0                          ; fin
 296+ FC13
 297+ FC13              ; --- StartTensionMusic: setup canal A + carga primera nota ---
 298+ FC13              StartTensionMusic:
 299+ FC13                  ; Mixer: solo tono A activo (B/C off, ruidos off)
 300+ FC13 3E 07            LD A, 7
 301+ FC15 1E 3E            LD E, $3E                       ; %00111110
 302+ FC17 CD CB FA         CALL AY_WriteReg
 303+ FC1A                  ; Volumen canal A
 304+ FC1A 3E 08            LD A, 8
 305+ FC1C 1E 0C            LD E, 12                        ; vol medio-alto
 306+ FC1E CD CB FA         CALL AY_WriteReg
 307+ FC21                  ; Reset puntero
 308+ FC21 21 04 FC         LD HL, TensionMusicTable
 309+ FC24 22 01 FC         LD (TensionMusicPtr), HL
 310+ FC27 C3 34 FC         JP TmAdvanceNote
 311+ FC2A
 312+ FC2A              ; --- UpdateTensionMusic: tick per-frame; avanza notas y silencia al final ---
 313+ FC2A              UpdateTensionMusic:
 314+ FC2A 3A 03 FC         LD A, (TensionMusicTimer)
 315+ FC2D B7               OR A
 316+ FC2E C8               RET Z                           ; inactivo
 317+ FC2F 3D               DEC A
 318+ FC30 32 03 FC         LD (TensionMusicTimer), A
 319+ FC33 C0               RET NZ                          ; aun en la nota actual
 320+ FC34                  ; Hora de la siguiente nota
 321+ FC34                  ; (fall-through a TmAdvanceNote)
 322+ FC34
 323+ FC34              ; --- TmAdvanceNote: lee 3 bytes de la tabla y aplica al AY ---
 324+ FC34              ; OJO: AY_WriteReg clobbea B y C (LD BC, $FFFD/$BFFD). Hay que stashear los
 325+ FC34              ; bytes de period en D y E (que SI se preservan a traves del call).
 326+ FC34              TmAdvanceNote:
 327+ FC34 2A 01 FC         LD HL, (TensionMusicPtr)
 328+ FC37 5E               LD E, (HL)                      ; E = pitch_lo (param de AY_WriteReg)
 329+ FC38 23               INC HL
 330+ FC39 56               LD D, (HL)                      ; D = pitch_hi (preservado por AY_WriteReg)
 331+ FC3A 23               INC HL
 332+ FC3B 7E               LD A, (HL)                      ; duration
 333+ FC3C 23               INC HL
 334+ FC3D B7               OR A
 335+ FC3E 28 11            JR Z, .tmEnd                    ; duration = 0 -> fin de tabla
 336+ FC40 22 01 FC         LD (TensionMusicPtr), HL
 337+ FC43 32 03 FC         LD (TensionMusicTimer), A
 338+ FC46                  ; Escribir period en R0/R1
 339+ FC46 3E 00            LD A, 0                         ; R0 = period low
 340+ FC48 CD CB FA         CALL AY_WriteReg                ; escribe E (pitch_lo); D preservado
 341+ FC4B 3E 01            LD A, 1                         ; R1 = period high
 342+ FC4D 5A               LD E, D                         ; recargar E con pitch_hi
 343+ FC4E C3 CB FA         JP AY_WriteReg                  ; tail-call
 344+ FC51              .tmEnd:
 345+ FC51                  ; Silenciar canal A
 346+ FC51 AF               XOR A
 347+ FC52 32 03 FC         LD (TensionMusicTimer), A       ; flag inactivo
 348+ FC55 3E 08            LD A, 8
 349+ FC57 1E 00            LD E, 0
 350+ FC59 C3 CB FA         JP AY_WriteReg                  ; tail-call
 351+ FC5C
# file closed: ay_sound.asm
