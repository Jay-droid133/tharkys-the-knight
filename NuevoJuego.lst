6759+ C4A9              ; ==============================================================================
6760+ C4A9              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6761+ C4A9              ; ==============================================================================
6762+ C4A9              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6763+ C4A9              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6764+ C4A9              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6765+ C4A9              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6766+ C4A9              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6767+ C4A9              ; main.asm; aqui no hace falta guard adicional).
6768+ C4A9              ; ==============================================================================
6769+ C4A9
6770+ C4A9              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6771+ C4A9              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6772+ C4A9              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6773+ C4A9              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6774+ C4A9              ;
6775+ C4A9              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6776+ C4A9              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6777+ C4A9              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6778+ C4A9              ;
6779+ C4A9              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6780+ C4A9              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6781+ C4A9              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6782+ C4A9              ; en vez de 8 + orientacion invertida).
6783+ C4A9              UpdateDeath:
6784+ C4A9                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6785+ C4A9                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6786+ C4A9                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6787+ C4A9                  ; progreso real, no solo quedar inmovil. ---
6788+ C4A9 2A FF 82         LD HL, (DeathGhostStuckTimer)
6789+ C4AC 23               INC HL
6790+ C4AD 22 FF 82         LD (DeathGhostStuckTimer), HL
6791+ C4B0 7C               LD A, H
6792+ C4B1 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6793+ C4B3 38 1A            JR C, .udGhostCheckDone
6794+ C4B5 20 05            JR NZ, .udGhostOn
6795+ C4B7 7D               LD A, L
6796+ C4B8 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6797+ C4BA 38 13            JR C, .udGhostCheckDone
6798+ C4BC              .udGhostOn:
6799+ C4BC                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6800+ C4BC                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6801+ C4BC                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6802+ C4BC                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6803+ C4BC                  ; re-disparar restart).
6804+ C4BC 3A 01 83         LD A, (DeathGhostMode)
6805+ C4BF B7               OR A
6806+ C4C0 20 0D            JR NZ, .udGhostCheckDone
6807+ C4C2 3E 01            LD A, 1
6808+ C4C4 32 01 83         LD (DeathGhostMode), A
6809+ C4C7 32 E0 99         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6810+ C4CA 3E FE            LD A, $FE                       ; sentinel restart-current-track
6811+ C4CC CD BA 99         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6812+ C4CF              .udGhostCheckDone:
6813+ C4CF
6814+ C4CF                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6815+ C4CF 3A 01 83         LD A, (DeathGhostMode)
6816+ C4D2 B7               OR A
6817+ C4D3 C2 1A C5         JP NZ, DeathGhostChase
6818+ C4D6
6819+ C4D6                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6820+ C4D6 DD 7E 03         LD A, (IX+ENT_POSX)
6821+ C4D9 32 FC 82         LD (DeathPrevX), A
6822+ C4DC DD 7E 04         LD A, (IX+ENT_POSY)
6823+ C4DF 32 FD 82         LD (DeathPrevY), A
6824+ C4E2                  ; Sub-pixel acc 1/2
6825+ C4E2 3A FB 82         LD A, (DeathSubPixelAcc)
6826+ C4E5 EE 01            XOR 1
6827+ C4E7 32 FB 82         LD (DeathSubPixelAcc), A
6828+ C4EA 28 05            JR Z, .udSkip
6829+ C4EC CD 99 AD         CALL UpdateMonster                  ; activo: chase + move + animate
6830+ C4EF 18 03            JR .udPost
6831+ C4F1              .udSkip:
6832+ C4F1 CD 6D C5         CALL DeathAnimate                   ; skip: solo animacion
6833+ C4F4              .udPost:
6834+ C4F4                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6835+ C4F4 3A FC 82         LD A, (DeathPrevX)
6836+ C4F7 DD BE 03         CP (IX+ENT_POSX)
6837+ C4FA 20 19            JR NZ, .udMoved
6838+ C4FC 3A FD 82         LD A, (DeathPrevY)
6839+ C4FF DD BE 04         CP (IX+ENT_POSY)
6840+ C502 20 11            JR NZ, .udMoved
6841+ C504                  ; No movio: incrementar BFS counter
6842+ C504 3A FE 82         LD A, (DeathStuckCounter)
6843+ C507 3C               INC A
6844+ C508 32 FE 82         LD (DeathStuckCounter), A
6845+ C50B FE 06            CP DEATH_STUCK_THRESHOLD
6846+ C50D D8               RET C
6847+ C50E AF               XOR A
6848+ C50F 32 FE 82         LD (DeathStuckCounter), A
6849+ C512 C3 D9 C6         JP DeathBfsRescue
6850+ C515              .udMoved:
6851+ C515 AF               XOR A
6852+ C516 32 FE 82         LD (DeathStuckCounter), A
6853+ C519 C9               RET
6854+ C51A
6855+ C51A              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6856+ C51A              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6857+ C51A              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6858+ C51A              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6859+ C51A              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6860+ C51A              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6861+ C51A              DeathGhostChase:
6862+ C51A                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6863+ C51A 3A 9E 81         LD A, (EntityTable + ENT_POSX)
6864+ C51D DD 96 03         SUB (IX+ENT_POSX)
6865+ C520 30 02            JR NC, .udgAbsDxOk
6866+ C522 ED 44            NEG
6867+ C524              .udgAbsDxOk:
6868+ C524 47               LD B, A                             ; B = |dx|
6869+ C525 3A 9F 81         LD A, (EntityTable + ENT_POSY)
6870+ C528 DD 96 04         SUB (IX+ENT_POSY)
6871+ C52B 30 02            JR NC, .udgAbsDyOk
6872+ C52D ED 44            NEG
6873+ C52F              .udgAbsDyOk:
6874+ C52F                  ; A = |dy|, B = |dx|
6875+ C52F B8               CP B
6876+ C530 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6877+ C532
6878+ C532                  ; --- Eje X primario ---
6879+ C532 AF               XOR A
6880+ C533 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6881+ C536 3A 9E 81         LD A, (EntityTable + ENT_POSX)
6882+ C539 DD 96 03         SUB (IX+ENT_POSX)
6883+ C53C 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6884+ C53E 3E 04            LD A, DEATH_GHOST_SPEED
6885+ C540 30 02            JR NC, .udgXSet
6886+ C542 3E FC            LD A, -DEATH_GHOST_SPEED
6887+ C544              .udgXSet:
6888+ C544 DD 77 06         LD (IX+ENT_DELTAX), A
6889+ C547 DD 86 03         ADD A, (IX+ENT_POSX)
6890+ C54A DD 77 03         LD (IX+ENT_POSX), A
6891+ C54D 18 1B            JR .udgAnim
6892+ C54F
6893+ C54F                  ; --- Eje Y primario ---
6894+ C54F              .udgVertPrim:
6895+ C54F AF               XOR A
6896+ C550 DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6897+ C553 3A 9F 81         LD A, (EntityTable + ENT_POSY)
6898+ C556 DD 96 04         SUB (IX+ENT_POSY)
6899+ C559 28 0F            JR Z, .udgAnim
6900+ C55B 3E 04            LD A, DEATH_GHOST_SPEED
6901+ C55D 30 02            JR NC, .udgYSet
6902+ C55F 3E FC            LD A, -DEATH_GHOST_SPEED
6903+ C561              .udgYSet:
6904+ C561 DD 77 07         LD (IX+ENT_DELTAY), A
6905+ C564 DD 86 04         ADD A, (IX+ENT_POSY)
6906+ C567 DD 77 04         LD (IX+ENT_POSY), A
6907+ C56A              .udgAnim:
6908+ C56A                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6909+ C56A                  ; ser despawneada por una de tres condiciones externas:
6910+ C56A                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6911+ C56A                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6912+ C56A                  ;   3. Player cambia de pantalla (screen_system reset)
6913+ C56A                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6914+ C56A                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6915+ C56A                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6916+ C56A C3 6D C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6917+ C56D
6918+ C56D              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6919+ C56D              ; Llamada por:
6920+ C56D              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6921+ C56D              ;   - UpdateDeath en frame skip (sin movimiento).
6922+ C56D              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6923+ C56D              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6924+ C56D              DeathAnimate:
6925+ C56D DD 7E 06         LD A, (IX+ENT_DELTAX)
6926+ C570 B7               OR A
6927+ C571 28 0A            JR Z, .daKeepDir
6928+ C573 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6929+ C575 CB 7F            BIT 7, A
6930+ C577 28 0D            JR Z, .daDir
6931+ C579 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6932+ C57B 18 09            JR .daDir
6933+ C57D              .daKeepDir:
6934+ C57D DD 7E 00         LD A, (IX+ENT_SPRITEID)
6935+ C580 DD 96 08         SUB (IX+ENT_ANIMBASE)
6936+ C583 E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6937+ C585 4F               LD C, A
6938+ C586              .daDir:
6939+ C586 DD 35 09         DEC (IX+ENT_ANIMTIMER)
6940+ C589 20 16            JR NZ, .daFrameSet
6941+ C58B DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6942+ C58F DD 7E 00         LD A, (IX+ENT_SPRITEID)
6943+ C592 47               LD B, A
6944+ C593 DD 96 08         SUB (IX+ENT_ANIMBASE)
6945+ C596 E6 01            AND 1
6946+ C598 20 03            JR NZ, .daFrameDec
6947+ C59A 04               INC B
6948+ C59B 18 01            JR .daFrameStore
6949+ C59D              .daFrameDec:
6950+ C59D 05               DEC B
6951+ C59E              .daFrameStore:
6952+ C59E DD 70 00         LD (IX+ENT_SPRITEID), B
6953+ C5A1              .daFrameSet:
6954+ C5A1 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6955+ C5A4 DD 96 08         SUB (IX+ENT_ANIMBASE)
6956+ C5A7 E6 01            AND 1
6957+ C5A9 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6958+ C5AC 81               ADD A, C
6959+ C5AD DD 77 00         LD (IX+ENT_SPRITEID), A
6960+ C5B0 C9               RET
6961+ C5B1
6962+ C5B1              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6963+ C5B1              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6964+ C5B1              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6965+ C5B1              ; timer >= DEATH_SPAWN_FRAMES).
6966+ C5B1              SpawnDeath:
6967+ C5B1                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6968+ C5B1                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6969+ C5B1                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6970+ C5B1                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6971+ C5B1                  ; atravesando el mapa.
6972+ C5B1 CD 32 94         CALL FindFarthestAnyFreeCell
6973+ C5B4 C8               RET Z                               ; sin candidato: reintento siguiente frame
6974+ C5B5              .sdHaveCell:
6975+ C5B5                  ; B = cx, C = cy
6976+ C5B5 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6977+ C5B9                  ; POSX = cx * 8
6978+ C5B9 78               LD A, B
6979+ C5BA 87               ADD A, A
6980+ C5BB 87               ADD A, A
6981+ C5BC 87               ADD A, A
6982+ C5BD DD 77 03         LD (IX+ENT_POSX), A
6983+ C5C0 DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
6984+ C5C3                  ; POSY = cy * 8 + SCREEN_MIN_Y
6985+ C5C3 79               LD A, C
6986+ C5C4 87               ADD A, A
6987+ C5C5 87               ADD A, A
6988+ C5C6 87               ADD A, A
6989+ C5C7 C6 10            ADD A, SCREEN_MIN_Y
6990+ C5C9 DD 77 04         LD (IX+ENT_POSY), A
6991+ C5CC DD 77 0D         LD (IX+ENT_OLDY), A
6992+ C5CF                  ; Tipo / estado / sprite
6993+ C5CF DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
