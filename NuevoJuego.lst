 493+ 6617              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 494+ 6617              ; ==============================================================================
 495+ 6617              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 496+ 6617              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
