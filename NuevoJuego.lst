7625+ C9A8              OnPlayerHealthDepleted:
7626+ C9A8                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7627+ C9A8                  ; coste real). Idempotente si no estaba activo.
7628+ C9A8 CD 01 73         CALL CancelMagicCompass
7629+ C9AB                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7630+ C9AB                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7631+ C9AB                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7632+ C9AB                  ; (combate, Death catch, drain de salud por cualquier via).
7633+ C9AB F5               PUSH AF
7634+ C9AC 3E FF            LD A, $FF
7635+ C9AE CD BA 99         CALL StartMusic
7636+ C9B1 F1               POP AF
7637+ C9B2                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7638+ C9B2                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7639+ C9B2 CD A7 6D         CALL AY_PlayPlayerDeath
7640+ C9B5                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7641+ C9B5                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7642+ C9B5 3E 02            LD A, 2
7643+ C9B7 32 B3 82         LD (TimeFrozen), A
7644+ C9BA                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7645+ C9BA CD CE 6B         CALL TombStore
7646+ C9BD                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7647+ C9BD CD E7 B9         CALL KillAllActiveNasties
7648+ C9C0                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7649+ C9C0 CD B5 BA         CALL SilentKillDeath
7650+ C9C3                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7651+ C9C3 CD D0 BA         CALL FreezeMonstersFacingCorpse
7652+ C9C6                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7653+ C9C6 CD 6F CA         CALL TriggerDeathBorder
7654+ C9C9                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7655+ C9C9                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7656+ C9C9                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7657+ C9C9 DD 21 9B 81      LD IX, EntityTable
7658+ C9CD                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7659+ C9CD DD 7E 0A         LD A, (IX+ENT_DIR)
7660+ C9D0 E6 80            AND $80
7661+ C9D2 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7662+ C9D4 28 02            JR Z, .ophdRightBase
7663+ C9D6 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7664+ C9D8              .ophdRightBase:
7665+ C9D8 DD 77 00         LD (IX+ENT_SPRITEID), A
7666+ C9DB DD 36 06 00      LD (IX+ENT_DELTAX), 0
7667+ C9DF DD 36 07 00      LD (IX+ENT_DELTAY), 0
7668+ C9E3 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7669+ C9E5 32 E9 82         LD (PlayerDeathAnimTimer), A
7670+ C9E8 AF               XOR A
7671+ C9E9 32 EA 82         LD (PlayerDeathAnimFrame), A
7672+ C9EC                  ; Decrementar vida (clamp a 0)
7673+ C9EC 3A DE 82         LD A, (PlayerLives)
7674+ C9EF B7               OR A
7675+ C9F0 C8               RET Z
7676+ C9F1 3D               DEC A
7677+ C9F2 32 DE 82         LD (PlayerLives), A
7678+ C9F5 C9               RET
7679+ C9F6
7680+ C9F6              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7681+ C9F6              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7682+ C9F6              ErasePlayerSpriteAtOldPos:
7683+ C9F6 DD 21 9B 81      LD IX, EntityTable
7684+ C9FA CD F4 A4         CALL GetOldSpriteAddr
7685+ C9FD DD 56 0D         LD D, (IX+ENT_OLDY)
7686+ CA00 DD 7E 0C         LD A, (IX+ENT_OLDX)
7687+ CA03 5F               LD E, A
7688+ CA04 DD E5            PUSH IX
7689+ CA06 DD 2A 7C A4      LD IX, (OldSprAddr)
7690+ CA0A CD E7 99         CALL DrawSprite
7691+ CA0D DD E1            POP IX
7692+ CA0F DD 56 0D         LD D, (IX+ENT_OLDY)
7693+ CA12 DD 5E 0C         LD E, (IX+ENT_OLDX)
7694+ CA15 C3 9E D2         JP RestoreOldAttr                   ; tail-call
7695+ CA18
7696+ CA18              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7697+ CA18              RespawnPlayerAtEntry:
7698+ CA18 DD 21 9B 81      LD IX, EntityTable
7699+ CA1C 3A 0E 83         LD A, (LastEntryPosX)
7700+ CA1F DD 77 03         LD (IX+ENT_POSX), A
7701+ CA22 DD 77 0C         LD (IX+ENT_OLDX), A
7702+ CA25 DD 77 0F         LD (IX+ENT_DRAWX), A
7703+ CA28 3A 0F 83         LD A, (LastEntryPosY)
7704+ CA2B DD 77 04         LD (IX+ENT_POSY), A
7705+ CA2E DD 77 0D         LD (IX+ENT_OLDY), A
7706+ CA31 3E 10            LD A, HEALTH_MAX
7707+ CA33 32 0C B3         LD (PlayerHealth), A
7708+ CA36 3E 10            LD A, STAMINA_MAX
7709+ CA38 32 0D B3         LD (PlayerStamina), A
7710+ CA3B DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7711+ CA3F DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7712+ CA43 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7713+ CA47 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7714+ CA4B DD 36 06 00      LD (IX+ENT_DELTAX), 0
7715+ CA4F DD 36 07 00      LD (IX+ENT_DELTAY), 0
7716+ CA53                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7717+ CA53                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7718+ CA53                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7719+ CA53                  ; libre, y .swordModeFree no toca el color.
7720+ CA53 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7721+ CA57 AF               XOR A
7722+ CA58 32 08 B3         LD (AttackCooldown), A
7723+ CA5B 32 07 B3         LD (AttackTimer), A
7724+ CA5E DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7725+ CA62                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7726+ CA62                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7727+ CA62 3E 01            LD A, 1
7728+ CA64 32 EB 82         LD (PlayerRespawnPhase), A
7729+ CA67 AF               XOR A
7730+ CA68 32 EC 82         LD (PlayerRespawnTimer), A
7731+ CA6B 32 EF 82         LD (PlayerRespawnBeatIdx), A
7732+ CA6E C9               RET
7733+ CA6F
7734+ CA6F              ; ==============================================================================
7735+ CA6F              ; TriggerDeathBorder - arranca el flash del borde tras morir
7736+ CA6F              ; ==============================================================================
7737+ CA6F              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7738+ CA6F              ; luego vuelve a negro y se desactiva.
7739+ CA6F              ; ==============================================================================
7740+ CA6F              TriggerDeathBorder:
7741+ CA6F 3E 01            LD A, 1
7742+ CA71 32 E7 82         LD (DeathBorderPhase), A
7743+ CA74 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7744+ CA76 32 E8 82         LD (DeathBorderTimer), A
7745+ CA79 3E 06            LD A, YELLOW
7746+ CA7B 32 83 8D         LD (CurrentBorderColor), A
7747+ CA7E D3 FE            OUT (254), A
7748+ CA80 C9               RET
7749+ CA81
7750+ CA81              ; ==============================================================================
7751+ CA81              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7752+ CA81              ; ==============================================================================
7753+ CA81              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7754+ CA81              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7755+ CA81              ; ==============================================================================
7756+ CA81              UpdateRespawnBlink:
7757+ CA81 3A EB 82         LD A, (PlayerRespawnPhase)
7758+ CA84 B7               OR A
7759+ CA85 C8               RET Z
7760+ CA86 3D               DEC A
7761+ CA87 28 0D            JR Z, .urbPhase1
7762+ CA89                  ; Phase 2: solo timer (sin parpadeo)
7763+ CA89 3A EC 82         LD A, (PlayerRespawnTimer)
7764+ CA8C 3D               DEC A
7765+ CA8D 32 EC 82         LD (PlayerRespawnTimer), A
7766+ CA90 C0               RET NZ
7767+ CA91 AF               XOR A
7768+ CA92 32 EB 82         LD (PlayerRespawnPhase), A
7769+ CA95 C9               RET
7770+ CA96
7771+ CA96              .urbPhase1:
7772+ CA96                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7773+ CA96                  ; Zero input (sin control)
7774+ CA96 AF               XOR A
7775+ CA97 32 AB 82         LD (InputDirection), A
7776+ CA9A 32 AC 82         LD (InputFire), A
7777+ CA9D                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7778+ CA9D                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7779+ CA9D 3A 9C 6D         LD A, (BeepDurationFrames)
7780+ CAA0 D6 01            SUB 1                               ; CY si era 0 (silencio)
7781+ CAA2 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7782+ CAA3 E6 74            AND SPRID_PLAYER_BLANK
7783+ CAA5 32 9B 81         LD (EntityTable), A
7784+ CAA8                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7785+ CAA8 3A EC 82         LD A, (PlayerRespawnTimer)
7786+ CAAB B7               OR A
7787+ CAAC 28 05            JR Z, .urb1FireBeat
7788+ CAAE 3D               DEC A
7789+ CAAF 32 EC 82         LD (PlayerRespawnTimer), A
7790+ CAB2 C9               RET
7791+ CAB3              .urb1FireBeat:
7792+ CAB3 3A EF 82         LD A, (PlayerRespawnBeatIdx)
7793+ CAB6 3C               INC A
7794+ CAB7 32 EF 82         LD (PlayerRespawnBeatIdx), A
7795+ CABA FE 04            CP 4
7796+ CABC 28 12            JR Z, .urb1LastBeat
7797+ CABE FE 05            CP 5
7798+ CAC0 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7799+ CAC2                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7800+ CAC2 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7801+ CAC5 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7802+ CAC7 CD CA 6D         CALL AY_PlayBeep
7803+ CACA                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7804+ CACA                  ; (mitad) para mantener ON/OFF ~50/50.
7805+ CACA 3E 14            LD A, 20
7806+ CACC 32 EC 82         LD (PlayerRespawnTimer), A
7807+ CACF C9               RET
7808+ CAD0              .urb1LastBeat:
7809+ CAD0                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7810+ CAD0                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7811+ CAD0                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7812+ CAD0                  ; entra grace EXACTAMENTE al terminar el beep.
7813+ CAD0 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7814+ CAD3 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7815+ CAD5 CD CA 6D         CALL AY_PlayBeep
7816+ CAD8 3E 0B            LD A, 11                    ; espera = duracion del beep
7817+ CADA 32 EC 82         LD (PlayerRespawnTimer), A
7818+ CADD C9               RET
7819+ CADE              .urb1AfterBeep:
7820+ CADE                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7821+ CADE                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7822+ CADE CD F7 CA         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7823+ CAE1 3E 0C            LD A, SPAWN_INTERVAL
7824+ CAE3 32 F5 82         LD (SpawnTimer), A
7825+ CAE6 AF               XOR A
7826+ CAE7 32 FA 82         LD (DeathSpawned), A
7827+ CAEA 32 F0 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7828+ CAED 32 B3 82         LD (TimeFrozen), A              ; Reanudar reloj
7829+ CAF0 21 00 00         LD HL, 0
7830+ CAF3 22 F7 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7831+ CAF6 C9               RET
7832+ CAF7
7833+ CAF7              ; ==============================================================================
7834+ CAF7              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7835+ CAF7              ; ==============================================================================
7836+ CAF7              ; Llamado desde:
7837+ CAF7              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7838+ CAF7              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7839+ CAF7              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7840+ CAF7              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7841+ CAF7              ; ==============================================================================
7842+ CAF7              EnterGracePhase:
7843+ CAF7 3E 02            LD A, 2
7844+ CAF9 32 EB 82         LD (PlayerRespawnPhase), A
7845+ CAFC 3E 19            LD A, RESPAWN_GRACE_FRAMES
7846+ CAFE 32 EC 82         LD (PlayerRespawnTimer), A
7847+ CB01 C9               RET
7848+ CB02
7849+ CB02              ; ==============================================================================
7850+ CB02              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7851+ CB02              ; ==============================================================================
7852+ CB02              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7853+ CB02              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7854+ CB02              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7855+ CB02              ; ==============================================================================
7856+ CB02              UpdateDeathAnim:
7857+ CB02 3A E7 82         LD A, (DeathBorderPhase)
7858+ CB05 FE 01            CP 1
7859+ CB07 C0               RET NZ
7860+ CB08 3A E9 82         LD A, (PlayerDeathAnimTimer)
7861+ CB0B 3D               DEC A
7862+ CB0C 32 E9 82         LD (PlayerDeathAnimTimer), A
7863+ CB0F C0               RET NZ
7864+ CB10                  ; Tick consumido: avanzar frame
7865+ CB10 3A EA 82         LD A, (PlayerDeathAnimFrame)
7866+ CB13 3C               INC A
7867+ CB14 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7868+ CB16 D0               RET NC                              ; ya en ultimo frame (clamp)
7869+ CB17 32 EA 82         LD (PlayerDeathAnimFrame), A
7870+ CB1A DD 21 9B 81      LD IX, EntityTable
7871+ CB1E DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7872+ CB21                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7873+ CB21                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7874+ CB21                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7875+ CB21 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7876+ CB23 20 06            JR NZ, .udaSkipSplatSfx
7877+ CB25 21 C0 F6         LD HL, SFX_EnemyDeath
7878+ CB28 CD 41 F6         CALL PlaySFX
7879+ CB2B              .udaSkipSplatSfx:
7880+ CB2B 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7881+ CB2D 32 E9 82         LD (PlayerDeathAnimTimer), A
7882+ CB30 C9               RET
7883+ CB31
7884+ CB31              ; ==============================================================================
7885+ CB31              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7886+ CB31              ; ==============================================================================
7887+ CB31              UpdateDeathBorder:
7888+ CB31 3A E7 82         LD A, (DeathBorderPhase)
7889+ CB34 B7               OR A
7890+ CB35 C8               RET Z
7891+ CB36 3A E8 82         LD A, (DeathBorderTimer)
7892+ CB39 3D               DEC A
7893+ CB3A 32 E8 82         LD (DeathBorderTimer), A
7894+ CB3D C0               RET NZ
7895+ CB3E                  ; Timer expiro: avanzar fase
7896+ CB3E 3A E7 82         LD A, (DeathBorderPhase)
7897+ CB41 FE 01            CP 1
7898+ CB43 20 33            JR NZ, .udbToBlack
7899+ CB45                  ; --- Fin fase amarillo ---
7900+ CB45                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7901+ CB45                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7902+ CB45 3A DE 82         LD A, (PlayerLives)
7903+ CB48 B7               OR A
7904+ CB49 28 1F            JR Z, .udbToGameOver
7905+ CB4B DD 21 9B 81      LD IX, EntityTable
7906+ CB4F DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7907+ CB53 3E 02            LD A, 2
7908+ CB55 32 E7 82         LD (DeathBorderPhase), A
7909+ CB58 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7910+ CB5A 32 E8 82         LD (DeathBorderTimer), A
7911+ CB5D 3E 02            LD A, RED
7912+ CB5F 32 83 8D         LD (CurrentBorderColor), A
7913+ CB62 D3 FE            OUT (254), A
7914+ CB64                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7915+ CB64                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7916+ CB64 3E 01            LD A, 1
7917+ CB66 32 F4 82         LD (TombDrawPending), A
7918+ CB69 C9               RET
7919+ CB6A              .udbToGameOver:
7920+ CB6A                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7921+ CB6A AF               XOR A
7922+ CB6B 32 E7 82         LD (DeathBorderPhase), A
7923+ CB6E 3E 00            LD A, BLACK
7924+ CB70 32 83 8D         LD (CurrentBorderColor), A
7925+ CB73 D3 FE            OUT (254), A
7926+ CB75 C3 86 CB         JP ShowGameOver
7927+ CB78              .udbToBlack:
7928+ CB78                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7929+ CB78 AF               XOR A
7930+ CB79 32 E7 82         LD (DeathBorderPhase), A
7931+ CB7C 3E 00            LD A, BLACK
7932+ CB7E 32 83 8D         LD (CurrentBorderColor), A
7933+ CB81 D3 FE            OUT (254), A
7934+ CB83 C3 18 CA         JP RespawnPlayerAtEntry             ; tail-call
7935+ CB86
7936+ CB86              ; ==============================================================================
7937+ CB86              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7938+ CB86              ; ==============================================================================
7939+ CB86              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7940+ CB86              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7941+ CB86              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7942+ CB86              ; ==============================================================================
7943+ CB86              ShowGameOver:
7944+ CB86 3E 01            LD A, 1
7945+ CB88 32 DF 82         LD (GameOver), A
7946+ CB8B C9               RET
7947+ CB8C
7948+ CB8C              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7949+ CB8C              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7950+ CB8C              PaintGameOverScreen:
7951+ CB8C                  ; Wipe pixels
7952+ CB8C 21 00 40         LD HL, $4000
7953+ CB8F 11 01 40         LD DE, $4001
7954+ CB92 01 FF 17         LD BC, $17FF
7955+ CB95 36 00            LD (HL), 0
7956+ CB97 ED B0            LDIR
7957+ CB99                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7958+ CB99 21 00 58         LD HL, $5800
7959+ CB9C 11 01 58         LD DE, $5801
7960+ CB9F 01 FF 02         LD BC, $02FF
7961+ CBA2 36 47            LD (HL), $47
7962+ CBA4 ED B0            LDIR
7963+ CBA6                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
7964+ CBA6                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
7965+ CBA6 CD 28 78         CALL DrawTombstone2xCentered
7966+ CBA9                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7967+ CBA9 3E 88            LD A, GAMEOVER_ANIM_X_MAX
7968+ CBAB 32 E0 82         LD (GameOverAnimX), A
7969+ CBAE AF               XOR A
7970+ CBAF 32 E1 82         LD (GameOverAnimDir), A
7971+ CBB2 32 E2 82         LD (GameOverAnimFrame), A
7972+ CBB5 32 E6 82         LD (GameOverAnimLastX), A
7973+ CBB8 21 00 00         LD HL, 0
7974+ CBBB 22 E4 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7975+ CBBE 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7976+ CBC0 32 E3 82         LD (GameOverAnimFrameTimer), A
7977+ CBC3                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7978+ CBC3                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7979+ CBC3                  ; congelado en GameOver=2.
7980+ CBC3 3E 03            LD A, 3
7981+ CBC5 C3 BA 99         JP StartMusic                   ; tail-call
7982+ CBC8
7983+ CBC8              ; ==============================================================================
7984+ CBC8              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7985+ CBC8              ; ==============================================================================
7986+ CBC8              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7987+ CBC8              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7988+ CBC8              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7989+ CBC8              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7990+ CBC8              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7991+ CBC8              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7992+ CBC8              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7993+ CBC8              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7994+ CBC8              ;
7995+ CBC8              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7996+ CBC8              ; shifted (que ocupa 4 chars = 32 px).
7997+ CBC8              ; ==============================================================================
7998+ CBC8              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
7999+ CBC8              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8000+ CBC8              ; X swing centrado sobre la tumba:
8001+ CBC8              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8002+ CBC8              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8003+ CBC8              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8004+ CBC8              GAMEOVER_ANIM_Y           EQU 56
8005+ CBC8              GAMEOVER_ANIM_X_MIN       EQU 96
8006+ CBC8              GAMEOVER_ANIM_X_MAX       EQU 136
8007+ CBC8              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8008+ CBC8
8009+ CBC8              UpdateGameOverAnim:
8010+ CBC8                  ; --- Erase del sprite previo (si lo hubo) ---
8011+ CBC8 2A E4 82         LD HL, (GameOverAnimLastSpr)
8012+ CBCB 7C               LD A, H
8013+ CBCC B5               OR L
8014+ CBCD 28 0C            JR Z, .ugoaNoErase
8015+ CBCF E5               PUSH HL
8016+ CBD0 DD E1            POP IX
8017+ CBD2 3A E6 82         LD A, (GameOverAnimLastX)
8018+ CBD5 5F               LD E, A
8019+ CBD6 16 38            LD D, GAMEOVER_ANIM_Y
8020+ CBD8 CD E7 99         CALL DrawSprite
8021+ CBDB              .ugoaNoErase:
8022+ CBDB
8023+ CBDB                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8024+ CBDB 3A E3 82         LD A, (GameOverAnimFrameTimer)
8025+ CBDE 3D               DEC A
8026+ CBDF 20 0A            JR NZ, .ugoaTimerSet
8027+ CBE1 3A E2 82         LD A, (GameOverAnimFrame)
8028+ CBE4 EE 01            XOR 1
8029+ CBE6 32 E2 82         LD (GameOverAnimFrame), A
8030+ CBE9 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8031+ CBEB              .ugoaTimerSet:
8032+ CBEB 32 E3 82         LD (GameOverAnimFrameTimer), A
8033+ CBEE
8034+ CBEE                  ; --- Avanzar X segun direccion (ping-pong) ---
8035+ CBEE 3A E1 82         LD A, (GameOverAnimDir)
8036+ CBF1 B7               OR A
8037+ CBF2 20 14            JR NZ, .ugoaSlideRight
8038+ CBF4                  ; Dir 0: facing R, slide LEFT (X--)
8039+ CBF4 3A E0 82         LD A, (GameOverAnimX)
8040+ CBF7 FE 60            CP GAMEOVER_ANIM_X_MIN
8041+ CBF9 28 06            JR Z, .ugoaFlipToL
8042+ CBFB 3D               DEC A
8043+ CBFC 32 E0 82         LD (GameOverAnimX), A
8044+ CBFF 18 18            JR .ugoaPickSprite
8045+ CC01              .ugoaFlipToL:
8046+ CC01 3E 01            LD A, 1
8047+ CC03 32 E1 82         LD (GameOverAnimDir), A
8048+ CC06 18 11            JR .ugoaPickSprite
8049+ CC08              .ugoaSlideRight:
8050+ CC08                  ; Dir 1: facing L, slide RIGHT (X++)
8051+ CC08 3A E0 82         LD A, (GameOverAnimX)
8052+ CC0B FE 88            CP GAMEOVER_ANIM_X_MAX
8053+ CC0D 28 06            JR Z, .ugoaFlipToR
8054+ CC0F 3C               INC A
8055+ CC10 32 E0 82         LD (GameOverAnimX), A
8056+ CC13 18 04            JR .ugoaPickSprite
8057+ CC15              .ugoaFlipToR:
8058+ CC15 AF               XOR A
8059+ CC16 32 E1 82         LD (GameOverAnimDir), A
8060+ CC19
8061+ CC19              .ugoaPickSprite:
8062+ CC19                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8063+ CC19                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8064+ CC19                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8065+ CC19 3A E1 82         LD A, (GameOverAnimDir)
8066+ CC1C B7               OR A
8067+ CC1D 20 0E            JR NZ, .ugoaPickR
8068+ CC1F 3A E2 82         LD A, (GameOverAnimFrame)
8069+ CC22 B7               OR A
8070+ CC23 21 DF DD         LD HL, SprDeath_L0
8071+ CC26 28 11            JR Z, .ugoaSprSet
8072+ CC28 21 29 DE         LD HL, SprDeath_L1
8073+ CC2B 18 0C            JR .ugoaSprSet
8074+ CC2D              .ugoaPickR:
8075+ CC2D 3A E2 82         LD A, (GameOverAnimFrame)
8076+ CC30 B7               OR A
8077+ CC31 21 4B DD         LD HL, SprDeath_0
8078+ CC34 28 03            JR Z, .ugoaSprSet
8079+ CC36 21 95 DD         LD HL, SprDeath_1
8080+ CC39              .ugoaSprSet:
8081+ CC39 22 E4 82         LD (GameOverAnimLastSpr), HL
8082+ CC3C 3A E0 82         LD A, (GameOverAnimX)
8083+ CC3F 32 E6 82         LD (GameOverAnimLastX), A
8084+ CC42
8085+ CC42                  ; --- Draw nuevo sprite ---
8086+ CC42 E5               PUSH HL
8087+ CC43 DD E1            POP IX
8088+ CC45 5F               LD E, A
8089+ CC46 16 38            LD D, GAMEOVER_ANIM_Y
8090+ CC48 C3 E7 99         JP DrawSprite                   ; tail-call
