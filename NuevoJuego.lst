 284+ 7691
 285+ 7691              ; .umcUpdateJingle ELIMINADO. Junto con MagicCompassJingleTable libera ~50 B
 286+ 7691              ; en slot 1, evitando overflow de las variables del BFS sobre la tabla IM 2
 287+ 7691              ; del IRQ handler ($7A00). El SFX de pickup ahora usa _AY_PlaySweep via
 288+ 7691              ; AY_PlayCompassPickup/AY_PlayLastingPickup (sfx_player_hit_ay.asm).
 289+ 7691
 290+ 7691              ; ==============================================================================
 291+ 7691              ; PaintMagicCompassAttrs - Pinta los 4 chars del HUD compass en modo magic
 292+ 7691              ; ==============================================================================
 293+ 7691              ; Color base lo decide el editor (sprite id 36, attrBytes). El runtime lo
 294+ 7691              ; lee de MagicCompassBaseAttrs (auto-importado por import_magic_compass_hud.py
 295+ 7691              ; con bit 6 BRIGHT clearado) y aplica BRIGHT solo al char correspondiente
 296+ 7691              ; a la PathDir. Durante los últimos 5 s ese bright parpadea on/off a ~6 Hz.
 297+ 7691              ;
 298+ 7691              ; Mapping diagonal de las 4 esquinas del 2x2:
 299+ 7691              ;   col1   col2
 300+ 7691              ;     W      N    (row 1, top)     ← idx 0 (1,1) | idx 1 (2,1)
 301+ 7691              ;     S      E    (row 2, bottom)  ← idx 2 (1,2) | idx 3 (2,2)
 302+ 7691              ;
 303+ 7691              ;   PathDir 0 (N) → idx 1 → offset +1
 304+ 7691              ;   PathDir 1 (S) → idx 2 → offset +$20
 305+ 7691              ;   PathDir 2 (W) → idx 0 → offset +0
 306+ 7691              ;   PathDir 3 (E) → idx 3 → offset +$21
 307+ 7691              ;
 308+ 7691              ; Destruye: AF, BC, DE, HL.
 309+ 7691              ; ==============================================================================
 310+ 7691              PaintMagicCompassAttrs:
 311+ 7691                  ; Pintar 4 chars con MagicCompassBaseAttrs (orden: 1,1 / 2,1 / 1,2 / 2,2)
 312+ 7691 11 BD 79         LD DE, MagicCompassBaseAttrs
 313+ 7694 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 314+ 7697 1A               LD A, (DE)
 315+ 7698 77               LD (HL), A
 316+ 7699 23               INC HL
 317+ 769A 13               INC DE
 318+ 769B 1A               LD A, (DE)
 319+ 769C 77               LD (HL), A
 320+ 769D 13               INC DE
 321+ 769E 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 322+ 76A1 1A               LD A, (DE)
 323+ 76A2 77               LD (HL), A
 324+ 76A3 23               INC HL
 325+ 76A4 13               INC DE
 326+ 76A5 1A               LD A, (DE)
 327+ 76A6 77               LD (HL), A
 328+ 76A7
 329+ 76A7                  ; Si sin path no hay char activo: solo base attrs (ya pintados).
 330+ 76A7 3A C1 5F         LD A, (MagicCompassPathDir)
 331+ 76AA FE FF            CP $FF
 332+ 76AC C8               RET Z
 333+ 76AD
 334+ 76AD                  ; Si el tick no está sonando, char activo se queda con base attr.
 335+ 76AD                  ; Eso da el efecto visual "OFF" entre pitidos.
 336+ 76AD 3A C3 5F         LD A, (MagicCompassTickActiveFrames)
 337+ 76B0 B7               OR A
 338+ 76B1 C8               RET Z
 339+ 76B2
 340+ 76B2                  ; Tick sonando: override del char activo a MAGIC_COMPASS_ACTIVE_ATTR
 341+ 76B2                  ; ($47 = white bright). Los pixels del sprite los pinta el editor;
 342+ 76B2                  ; para que la silueta no se "invierta" al cambiar paper/ink, diseña
 343+ 76B2                  ; el char correspondiente con paper black + ink negro (la silueta vive
 344+ 76B2                  ; en los píxeles encendidos, que pasan a ink white bright en el flash).
 345+ 76B2 3A C1 5F         LD A, (MagicCompassPathDir)
 346+ 76B5 5F               LD E, A
 347+ 76B6 16 00            LD D, 0
 348+ 76B8 21 C8 76         LD HL, .pmcaDirToOffset
 349+ 76BB 19               ADD HL, DE
 350+ 76BC 7E               LD A, (HL)
 351+ 76BD 5F               LD E, A
 352+ 76BE 16 00            LD D, 0
 353+ 76C0 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 354+ 76C3 19               ADD HL, DE                           ; HL = addr del char activo (attr area)
 355+ 76C4 3E 47            LD A, MAGIC_COMPASS_ACTIVE_ATTR
 356+ 76C6 77               LD (HL), A
 357+ 76C7 C9               RET
 358+ 76C8
 359+ 76C8              .pmcaDirToOffset:
 360+ 76C8 01               DEFB $01                             ; 0 (N) → col 2 row 1 → +1
 361+ 76C9 20               DEFB $20                             ; 1 (S) → col 1 row 2 → +$20
 362+ 76CA 00               DEFB $00                             ; 2 (W) → col 1 row 1 → +0
 363+ 76CB 21               DEFB $21                             ; 3 (E) → col 2 row 2 → +$21
 364+ 76CC
 365+ 76CC              ; MagicCompassJingleTable ELIMINADO (12 B). Pickup chime ahora via _AY_PlaySweep.
 366+ 76CC
 367+ 76CC              ; ==============================================================================
 368+ 76CC              ; ComputeMagicCompassPath - BFS reverse con state (sid, comp_local)
 369+ 76CC              ; ==============================================================================
 370+ 76CC              ; Algoritmo:
 371+ 76CC              ;   1. queue.push((target_sid, target_comp=0)). Mark visited.
 372+ 76CC              ;      target_comp = 0 (heurística: el pickup vive en la comp principal).
 373+ 76CC              ;   2. While queue not empty:
 374+ 76CC              ;        (R, R_comp) = queue.pop()
 375+ 76CC              ;        For each gap in RoomCompGaps[R]:
 376+ 76CC              ;          If gap.comp != R_comp: skip.
 377+ 76CC              ;          V = neighbor of R via gap.side.
 378+ 76CC              ;          Find V's gap with side=opposite(gap.side) AND coord=gap.coord.
 379+ 76CC              ;          V_comp = that gap's comp.
 380+ 76CC              ;          If (V, V_comp) visited: skip.
 381+ 76CC              ;          If V == current_sid AND V_comp == player_current_comp:
 382+ 76CC              ;            dir_player = opposite(gap.side); STORE; RETURN.
 383+ 76CC              ;          Mark visited; queue.push((V, V_comp)).
 384+ 76CC              ;
 385+ 76CC              ; player_current_comp se determina via LastEntrySide:
 386+ 76CC              ;   - LastEntrySide = side por el que el player entró a current_sid.
 387+ 76CC              ;   - player_comp = comp del gap de current_sid en LastEntrySide.
 388+ 76CC              ;   - Si LastEntrySide = $FF (boot/respawn), comp = 0 (fallback).
 389+ 76CC              ;
 390+ 76CC              ; OUT: MagicCompassPathDir = 0=N, 1=E, 2=S, 3=W; o $FF si sin path.
 391+ 76CC              ; ==============================================================================
 392+ 76CC              ; ComputeMagicCompassPath — wrapper que pagina bank 7 alrededor del BFS.
 393+ 76CC              ; Las tablas RoomCompGaps_XX viven en bank 7 (movidas para liberar slot 1
 394+ 76CC              ; del overflow). RoomCompGapsTable (pointer table) sigue en slot 1, pero
 395+ 76CC              ; sus valores son addresses en $C000+ que solo se dereferencian con bank 7
 396+ 76CC              ; paginado. El BFS body (renombrado a _Inner) solo llama a helpers .cmcp*
 397+ 76CC              ; (todos en slot 1) — ningun CALL externo a bank 0.
 398+ 76CC              ;
 399+ 76CC              ; DIAGNOSTICO: revertido el SP alterno (commit e1e9c5f) para confirmar si era
 400+ 76CC              ; la causa de "transiciones eternas al coger la brujula". Vuelta al patron DI
 401+ 76CC              ; envolvente original.
 402+ 76CC              ;
 403+ 76CC              ; Mantiene DI durante todo el chunk BFS (~4000 T = 1/15 frame). Riesgo de
 404+ 76CC              ; perder ~3 IRQ por segundo de compass activo, aceptable.
 405+ 76CC              ; ==============================================================================
 406+ 76CC              ComputeMagicCompassPath:
 407+ 76CC F3               DI
 408+ 76CD                  ; --- Page bank 7 in slot 3 ---
 409+ 76CD 3A 82 8D         LD A, (CurrentPaging)
 410+ 76D0 E6 F8            AND $F8
 411+ 76D2 F6 07            OR 7
 412+ 76D4 32 82 8D         LD (CurrentPaging), A
 413+ 76D7 01 FD 7F         LD BC, $7FFD
 414+ 76DA ED 79            OUT (C), A
 415+ 76DC
 416+ 76DC CD F3 76         CALL _ComputeMagicCompassPath_Inner
 417+ 76DF
 418+ 76DF                  ; --- Page bank 0 back ---
 419+ 76DF 3A 82 8D         LD A, (CurrentPaging)
 420+ 76E2 E6 F8            AND $F8
 421+ 76E4 32 82 8D         LD (CurrentPaging), A
 422+ 76E7 01 FD 7F         LD BC, $7FFD
 423+ 76EA ED 79            OUT (C), A
 424+ 76EC
 425+ 76EC 3A 9A 81         LD A, (StartupComplete)
 426+ 76EF B7               OR A
 427+ 76F0 C8               RET Z                                ; aún en Inicio: dejar DI
 428+ 76F1 FB               EI
 429+ 76F2 C9               RET
