 600+ B1AE 77               LD (HL), A
 601+ B1AF DD 23            INC IX
 602+ B1B1 23               INC HL
 603+ B1B2 10 F6            DJNZ .pixCol
 604+ B1B4
 605+ B1B4 E1               POP HL                      ; restaurar inicio fila
 606+ B1B5 3A 6D B2         LD A, (.heightCnt)
 607+ B1B8 3D               DEC A
 608+ B1B9 32 6D B2         LD (.heightCnt), A
 609+ B1BC 28 66            JR Z, .pixDone
 610+ B1BE CD BD 8E         CALL NextPixelLine          ; HL = siguiente linea pixel
 611+ B1C1 18 E2            JR .pixRow
 612+ B1C3
 613+ B1C3                  ; ===================== PATH RLE =====================
 614+ B1C3                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 615+ B1C3                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 616+ B1C3                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 617+ B1C3                  ; El estado .rlePending conserva el chunk entre filas:
 618+ B1C3                  ;   0 = necesita nuevo token
 619+ B1C3                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 620+ B1C3                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 621+ B1C3              .rlePixRow:
 622+ B1C3 3A 6E B2         LD A, (.widthVal)
 623+ B1C6 47               LD B, A
 624+ B1C7 E5               PUSH HL                     ; guardar inicio de fila VRAM
 625+ B1C8
 626+ B1C8              .rlePixCol:
 627+ B1C8 3A 72 B2         LD A, (.rlePending)
 628+ B1CB B7               OR A
 629+ B1CC CA E3 B1         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 630+ B1CF FA F1 B1         JP M, .rleLitEmit           ; <0 = literal group en curso
 631+ B1D2                  ; >0 = run en curso, emitir valor
 632+ B1D2              .rleRunEmit:
 633+ B1D2 3A 73 B2         LD A, (.rleValue)
 634+ B1D5 2F               CPL
 635+ B1D6 77               LD (HL), A
 636+ B1D7 23               INC HL
 637+ B1D8 3A 72 B2         LD A, (.rlePending)
 638+ B1DB 3D               DEC A
 639+ B1DC 32 72 B2         LD (.rlePending), A
 640+ B1DF 10 E7            DJNZ .rlePixCol
 641+ B1E1 18 32            JR .rleRowDone
 642+ B1E3
 643+ B1E3              .rleNewToken:
 644+ B1E3 DD 7E 00         LD A, (IX+0)
 645+ B1E6 DD 23            INC IX
 646+ B1E8 CB 7F            BIT 7, A
 647+ B1EA 20 18            JR NZ, .rleNewRun
 648+ B1EC                  ; --- Literal group: A = count (1-127) ---
 649+ B1EC ED 44            NEG                         ; A = -count (negativo)
 650+ B1EE 32 72 B2         LD (.rlePending), A
 651+ B1F1                  ; fall through: emitir primer byte literal
 652+ B1F1
 653+ B1F1              .rleLitEmit:
 654+ B1F1 DD 7E 00         LD A, (IX+0)
 655+ B1F4 DD 23            INC IX
 656+ B1F6 2F               CPL
 657+ B1F7 77               LD (HL), A
 658+ B1F8 23               INC HL
 659+ B1F9 3A 72 B2         LD A, (.rlePending)
 660+ B1FC 3C               INC A                       ; hacia 0
 661+ B1FD 32 72 B2         LD (.rlePending), A
 662+ B200 10 C6            DJNZ .rlePixCol
 663+ B202 18 11            JR .rleRowDone
 664+ B204
 665+ B204                  ; --- Run: count = (A & $7F) + 2 ---
 666+ B204              .rleNewRun:
 667+ B204 E6 7F            AND $7F
 668+ B206 C6 02            ADD A, 2
 669+ B208 32 72 B2         LD (.rlePending), A
 670+ B20B DD 7E 00         LD A, (IX+0)
 671+ B20E DD 23            INC IX
 672+ B210 32 73 B2         LD (.rleValue), A
 673+ B213 18 BD            JR .rleRunEmit
 674+ B215
 675+ B215              .rleRowDone:
 676+ B215 E1               POP HL                      ; restaurar inicio fila
 677+ B216 3A 6D B2         LD A, (.heightCnt)
 678+ B219 3D               DEC A
 679+ B21A 32 6D B2         LD (.heightCnt), A
 680+ B21D 28 05            JR Z, .pixDone
 681+ B21F CD BD 8E         CALL NextPixelLine
 682+ B222 18 9F            JR .rlePixRow
