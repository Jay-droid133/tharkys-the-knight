 818+ D492                  ; ===================== PATH RLE =====================
 819+ D492                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 820+ D492                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 821+ D492                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 822+ D492                  ; El estado .rlePending conserva el chunk entre filas:
 823+ D492                  ;   0 = necesita nuevo token
 824+ D492                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 825+ D492                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 826+ D492              .rlePixRow:
 827+ D492 3A 3D D5         LD A, (.widthVal)
 828+ D495 47               LD B, A
 829+ D496 E5               PUSH HL                     ; guardar inicio de fila VRAM
 830+ D497
 831+ D497              .rlePixCol:
 832+ D497 3A 41 D5         LD A, (.rlePending)
 833+ D49A B7               OR A
 834+ D49B CA B2 D4         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 835+ D49E FA C0 D4         JP M, .rleLitEmit           ; <0 = literal group en curso
 836+ D4A1                  ; >0 = run en curso, emitir valor
 837+ D4A1              .rleRunEmit:
 838+ D4A1 3A 42 D5         LD A, (.rleValue)
 839+ D4A4 2F               CPL
 840+ D4A5 77               LD (HL), A
 841+ D4A6 23               INC HL
 842+ D4A7 3A 41 D5         LD A, (.rlePending)
 843+ D4AA 3D               DEC A
 844+ D4AB 32 41 D5         LD (.rlePending), A
 845+ D4AE 10 E7            DJNZ .rlePixCol
 846+ D4B0 18 32            JR .rleRowDone
 847+ D4B2
 848+ D4B2              .rleNewToken:
 849+ D4B2 DD 7E 00         LD A, (IX+0)
 850+ D4B5 DD 23            INC IX
 851+ D4B7 CB 7F            BIT 7, A
 852+ D4B9 20 18            JR NZ, .rleNewRun
 853+ D4BB                  ; --- Literal group: A = count (1-127) ---
 854+ D4BB ED 44            NEG                         ; A = -count (negativo)
 855+ D4BD 32 41 D5         LD (.rlePending), A
 856+ D4C0                  ; fall through: emitir primer byte literal
 857+ D4C0
 858+ D4C0              .rleLitEmit:
 859+ D4C0 DD 7E 00         LD A, (IX+0)
 860+ D4C3 DD 23            INC IX
 861+ D4C5 2F               CPL
 862+ D4C6 77               LD (HL), A
 863+ D4C7 23               INC HL
 864+ D4C8 3A 41 D5         LD A, (.rlePending)
 865+ D4CB 3C               INC A                       ; hacia 0
 866+ D4CC 32 41 D5         LD (.rlePending), A
 867+ D4CF 10 C6            DJNZ .rlePixCol
 868+ D4D1 18 11            JR .rleRowDone
