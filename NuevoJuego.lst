 506  F955                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 507  F955                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F955              ; ==============================================================================
   2+ F955              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F955              ; ==============================================================================
   4+ F955              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F955              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F955              ;
   7+ F955              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F955              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F955              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F955              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F955              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F955              ; ==============================================================================
  13+ F955
  14+ F955              ; ==============================================================================
  15+ F955              ; PlaySFX - Reproduce un efecto de sonido
  16+ F955              ; ==============================================================================
  17+ F955              ; Entrada: HL = puntero a datos del efecto
  18+ F955              ; Modifica: AF, BC, DE, HL
  19+ F955              ; ==============================================================================
  20+ F955              PlaySFX:
  21+ F955 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F956 3A 85 8D         LD A, (CurrentBorderColor)
  23+ F959 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F95B 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F95C
  26+ F95C              .nextStep:
  27+ F95C 7E               LD A, (HL)                  ; Leer duration
  28+ F95D B7               OR A
  29+ F95E 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F960
  31+ F960 47               LD B, A                     ; B = duration (bucle externo)
  32+ F961 23               INC HL
  33+ F962 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F963 23               INC HL
  35+ F964 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F965 23               INC HL
  37+ F966 7E               LD A, (HL)                  ; A = flags
  38+ F967 23               INC HL
  39+ F968 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F969 CB 47            BIT 0, A
  41+ F96B 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F96D
  43+ F96D              ; --- Bucle de tono normal ---
  44+ F96D              .toneLoop:
  45+ F96D                  ; Semi-periodo HIGH
  46+ F96D 7B               LD A, E
  47+ F96E F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F970 D3 FE            OUT ($FE), A
  49+ F972 79               LD A, C                     ; A = pitch actual
  50+ F973              .toneDelayHi:
  51+ F973 3D               DEC A
  52+ F974 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F976
  54+ F976                  ; Semi-periodo LOW
  55+ F976 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F977 D3 FE            OUT ($FE), A
  57+ F979 79               LD A, C
  58+ F97A              .toneDelayLo:
  59+ F97A 3D               DEC A
  60+ F97B 20 FD            JR NZ, .toneDelayLo
  61+ F97D
  62+ F97D                  ; Aplicar pitch sweep
  63+ F97D 79               LD A, C
  64+ F97E 82               ADD A, D                    ; pitch += pitchDelta
  65+ F97F 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F981 FA 89 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F984 4F               LD C, A
  68+ F985              .toneAfterClamp:
  69+ F985 10 E6            DJNZ .toneLoop
  70+ F987 18 30            JR .stepDone
  71+ F989
  72+ F989              .toneClamp:
  73+ F989 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F98B 18 F8            JR .toneAfterClamp
  75+ F98D
  76+ F98D              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F98D              .noiseLoop:
  78+ F98D                  ; Semi-periodo HIGH con ruido
  79+ F98D 7B               LD A, E
  80+ F98E F6 10            OR $10
  81+ F990 D3 FE            OUT ($FE), A
  82+ F992 ED 5F            LD A, R                     ; R register como PRNG
  83+ F994 A9               XOR C                       ; mezclar con pitch base
  84+ F995 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F997 F6 01            OR $01                      ; minimo 1
  86+ F999              .noiseDelayHi:
  87+ F999 3D               DEC A
  88+ F99A 20 FD            JR NZ, .noiseDelayHi
  89+ F99C
  90+ F99C                  ; Semi-periodo LOW
  91+ F99C 7B               LD A, E
  92+ F99D D3 FE            OUT ($FE), A
  93+ F99F ED 5F            LD A, R
  94+ F9A1 A9               XOR C
  95+ F9A2 E6 1F            AND $1F
  96+ F9A4 F6 01            OR $01
  97+ F9A6              .noiseDelayLo:
  98+ F9A6 3D               DEC A
  99+ F9A7 20 FD            JR NZ, .noiseDelayLo
 100+ F9A9
 101+ F9A9                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F9A9 79               LD A, C
 103+ F9AA 82               ADD A, D
 104+ F9AB 28 08            JR Z, .noiseClamp
 105+ F9AD FA B5 F9         JP M, .noiseClamp
 106+ F9B0 4F               LD C, A
 107+ F9B1              .noiseAfterClamp:
 108+ F9B1 10 DA            DJNZ .noiseLoop
 109+ F9B3 18 04            JR .stepDone
 110+ F9B5
 111+ F9B5              .noiseClamp:
 112+ F9B5 0E 01            LD C, 1
 113+ F9B7 18 F8            JR .noiseAfterClamp
 114+ F9B9
 115+ F9B9              .stepDone:
 116+ F9B9 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F9BA 18 A0            JR .nextStep
 118+ F9BC
 119+ F9BC              .done:
 120+ F9BC 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F9BD D3 FE            OUT ($FE), A
 122+ F9BF FB               EI
 123+ F9C0 C9               RET
