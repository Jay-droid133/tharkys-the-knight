 419+ 6F16 ~                LD A, (MagicCompassBfsState)
 420+ 6F16 ~                OR A
 421+ 6F16 ~                JP NZ, .cmcpResume
 422+ 6F16 ~
 423+ 6F16 ~                ; --- INIT (solo cuando arranca un BFS nuevo) ---
 424+ 6F16 ~                LD A, (CurrentScreenY)
