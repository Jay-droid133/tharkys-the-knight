 747+ F077
 748+ F077                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ F077 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ F078 23               INC HL
 751+ F079 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ F07A 23               INC HL
