2322+ ABAF              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2323+ ABAF              ; ==============================================================================
2324+ ABAF              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2325+ ABAF              ; CleanAttrMap suma CleanAttrMap.
2326+ ABAF              ; Destruye: A, DE
2327+ ABAF              ; ==============================================================================
2328+ ABAF              GetWellBottomOffset:
2329+ ABAF 3A 61 8D         LD A, (WellPosY)
2330+ ABB2 26 00            LD H, 0
