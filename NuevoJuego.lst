5595+ BDC2              ; ==============================================================================
5596+ BDC2              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5597+ BDC2              ; ==============================================================================
5598+ BDC2              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5599+ BDC2              ; ==============================================================================
5600+ BDC2
5601+ BDC2              ; ==============================================================================
5602+ BDC2              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5603+ BDC2              ; ==============================================================================
5604+ BDC2              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5605+ BDC2              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5606+ BDC2              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5607+ BDC2              ; ==============================================================================
5608+ BDC2              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5609+ BDC2              ; ==============================================================================
5610+ BDC2              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5611+ BDC2              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5612+ BDC2              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5613+ BDC2              ; ==============================================================================
5614+ BDC2              MONSTERS_TO_SPAWN   EQU 3
5615+ BDC2              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5616+ BDC2              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5617+ BDC2
5618+ BDC2              ; ==============================================================================
5619+ BDC2              ; SpawnMonsters - Primera aparicion tras campanadas
5620+ BDC2              ; ==============================================================================
5621+ BDC2              SpawnMonsters:
5622+ BDC2                  IF DEBUG_NO_ENEMIES
5623+ BDC2 ~                RET
5624+ BDC2                  ENDIF
5625+ BDC2 3A CE B3         LD A, (MonstersActive)
5626+ BDC5 B7               OR A
5627+ BDC6 C0               RET NZ
5628+ BDC7                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5629+ BDC7                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5630+ BDC7 CD A3 BA         CALL KillAllActiveNasties
5631+ BDCA 3E 01            LD A, 1
5632+ BDCC 32 CE B3         LD (MonstersActive), A
5633+ BDCF CD 4C BE         CALL ShuffleMonsterTypes
5634+ BDD2 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5635+ BDD6 06 03            LD B, MONSTERS_TO_SPAWN
5636+ BDD8 0E 00            LD C, 0
5637+ BDDA              .smLoop:
5638+ BDDA C5               PUSH BC
5639+ BDDB DD 7E 01         LD A, (IX+ENT_TYPE)
5640+ BDDE B7               OR A
5641+ BDDF C2 3B BE         JP NZ, .smSkip
5642+ BDE2                  ; Asignar tipo y color
5643+ BDE2 79               LD A, C
5644+ BDE3 21 B0 BE         LD HL, MonsterTypeTable
5645+ BDE6 5F               LD E, A
5646+ BDE7 16 00            LD D, 0
5647+ BDE9 19               ADD HL, DE
5648+ BDEA 7E               LD A, (HL)
5649+ BDEB DD 77 08         LD (IX+ENT_ANIMBASE), A
5650+ BDEE 79               LD A, C
5651+ BDEF 21 B3 BE         LD HL, MonsterColorTable
5652+ BDF2 5F               LD E, A
5653+ BDF3 16 00            LD D, 0
5654+ BDF5 19               ADD HL, DE
5655+ BDF6 7E               LD A, (HL)
5656+ BDF7 DD 77 05         LD (IX+ENT_ATTR), A
5657+ BDFA                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5658+ BDFA C5               PUSH BC
5659+ BDFB CD C0 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5660+ BDFE B7               OR A
5661+ BDFF 20 0E            JR NZ, .smFallbackPos
5662+ BE01 3A C8 97         LD A, (MaiSpawnX)
5663+ BE04 DD 77 03         LD (IX+ENT_POSX), A
5664+ BE07 3A C9 97         LD A, (MaiSpawnY)
5665+ BE0A DD 77 04         LD (IX+ENT_POSY), A
5666+ BE0D 18 0C            JR .smPosDone
5667+ BE0F              .smFallbackPos:
5668+ BE0F 3A 16 83         LD A, (LastEntryPosX)
5669+ BE12 DD 77 03         LD (IX+ENT_POSX), A
5670+ BE15 3A 17 83         LD A, (LastEntryPosY)
5671+ BE18 DD 77 04         LD (IX+ENT_POSY), A
5672+ BE1B              .smPosDone:
5673+ BE1B C1               POP BC
5674+ BE1C                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5675+ BE1C DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5676+ BE20 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5677+ BE24 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5678+ BE28 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5679+ BE2C DD 36 07 00      LD (IX+ENT_DELTAY), 0
5680+ BE30                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5681+ BE30                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5682+ BE30                  ; lo empuje a un vecino (migracion por knockback).
5683+ BE30 CD B5 8E         CALL MaiGetCurrentScreenId
5684+ BE33 21 8F 8D         LD HL, MonsterRoomId
5685+ BE36 59               LD E, C
5686+ BE37 16 00            LD D, 0
5687+ BE39 19               ADD HL, DE
5688+ BE3A 77               LD (HL), A
5689+ BE3B              .smSkip:
5690+ BE3B 11 10 00         LD DE, ENT_SIZE
5691+ BE3E DD 19            ADD IX, DE
5692+ BE40 C1               POP BC
5693+ BE41 0C               INC C
5694+ BE42 05               DEC B
5695+ BE43 C2 DA BD         JP NZ, .smLoop
5696+ BE46 3E 14            LD A, MONSTER_ENTRY_BASE
5697+ BE48 32 9A BF         LD (TryRespawnMonsters.rmTimer), A
5698+ BE4B                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5699+ BE4B                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5700+ BE4B                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5701+ BE4B C9               RET
