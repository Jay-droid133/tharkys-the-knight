  67+ E8C9 3A 2F 82         LD A, (CurrentObjective)
  68+ E8CC FE 09            CP 9
  69+ E8CE 30 21            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ E8D0 87               ADD A, A                            ; *2 (entry size)
  71+ E8D1 6F               LD L, A
  72+ E8D2 26 00            LD H, 0
  73+ E8D4 11 A0 E8         LD DE, MilestoneTable
  74+ E8D7 19               ADD HL, DE
  75+ E8D8 7E               LD A, (HL)                          ; tipo
  76+ E8D9 FE 01            CP MILESTONE_TYPE_PICKUP
  77+ E8DB 20 14            JR NZ, .cmpDone
  78+ E8DD 23               INC HL
  79+ E8DE 7E               LD A, (HL)                          ; ref esperada
  80+ E8DF B8               CP B
  81+ E8E0 20 0F            JR NZ, .cmpDone
  82+ E8E2 3A 2F 82         LD A, (CurrentObjective)
  83+ E8E5 3C               INC A
  84+ E8E6 32 2F 82         LD (CurrentObjective), A
  85+ E8E9 CD 78 E9         CALL ResolveObjectiveScreen
  86+ E8EC 3E FF            LD A, $FF
  87+ E8EE 32 32 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ E8F1              .cmpDone:
  89+ E8F1 F1               POP AF
  90+ E8F2 C1               POP BC
  91+ E8F3 D1               POP DE
  92+ E8F4 E1               POP HL
  93+ E8F5 C9               RET
