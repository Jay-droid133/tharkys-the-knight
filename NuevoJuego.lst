1719+ F788              ; church-cutscene block (lines 1489-2181 originales) movido a code/church_cutscene.asm
1720+ F788              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1721+ F788
1722+ F788              ; ==============================================================================
1723+ F788              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1724+ F788              ; ==============================================================================
1725+ F788              ; Indice (CompassSprites[idx]):
1726+ F788              ;   0 = NW    1 = N    2 = NE
1727+ F788              ;   3 = W     4 = X    5 = E
1728+ F788              ;   6 = SW    7 = S    8 = SE
1729+ F788              ; ==============================================================================
1730+ F788              CompassSprites:
1731+ F788 A7 F8            DEFW Sprite_Compass_NW
1732+ F78A C7 F7            DEFW Sprite_Compass_N
1733+ F78C E7 F7            DEFW Sprite_Compass_NE
1734+ F78E 87 F8            DEFW Sprite_Compass_W
1735+ F790 C7 F8            DEFW Sprite_Compass_X
1736+ F792 07 F8            DEFW Sprite_Compass_E
1737+ F794 67 F8            DEFW Sprite_Compass_SW
1738+ F796 47 F8            DEFW Sprite_Compass_S
1739+ F798 27 F8            DEFW Sprite_Compass_SE
1740+ F79A
1741+ F79A              ; ==============================================================================
1742+ F79A              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1743+ F79A              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1744+ F79A              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1745+ F79A              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1746+ F79A              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1747+ F79A              ; ==============================================================================
1748+ F79A              CompassWobbleTable:
1749+ F79A 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1750+ F79E 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1751+ F7A2 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1752+ F7A6 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1753+ F7AA 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1754+ F7AE 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1755+ F7B2 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1756+ F7B6 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1757+ F7BA 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1758+ F7BE
1759+ F7BE              ; ==============================================================================
1760+ F7BE              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1761+ F7BE              ; Indexada por (counter-1) -> 0..8. Valor:
1762+ F7BE              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1763+ F7BE              ; Con counter inicial 9 y decremento por frame:
1764+ F7BE              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1765+ F7BE              ;   counter 8 -> phase 7 -> prev
1766+ F7BE              ;   counter 7 -> phase 6 -> target
1767+ F7BE              ;   counter 6 -> phase 5 -> next
1768+ F7BE              ;   counter 5 -> phase 4 -> next2
1769+ F7BE              ;   counter 4 -> phase 3 -> prev
1770+ F7BE              ;   counter 3 -> phase 2 -> target
1771+ F7BE              ;   counter 2 -> phase 1 -> prev
1772+ F7BE              ;   counter 1 -> phase 0 -> target (estado final, settle)
1773+ F7BE              ; ==============================================================================
1774+ F7BE              WobblePhaseTable:
1775+ F7BE 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1775+ F7C2 04 03 02 01
1775+ F7C6 00
1776+ F7C7
1777+ F7C7              ; Sprites importados de References/flechas02 (16x16, esfera roja con flecha)
