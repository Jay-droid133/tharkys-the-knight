 485  9DBA                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9DBA              ; ==============================================================================
   2+ 9DBA              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DBA              ; ==============================================================================
   4+ 9DBA              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DBA              ; - Game loop per-entity: erase → update → draw
   6+ 9DBA              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DBA              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DBA              ; - XOR draw/erase (una sola rutina)
   9+ 9DBA              ; ==============================================================================
  10+ 9DBA
  11+ 9DBA              ; ==============================================================================
  12+ 9DBA              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DBA              ; ==============================================================================
  14+ 9DBA              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DBA              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DBA              ; ==============================================================================
  17+ 9DBA              ReadInput:
  18+ 9DBA 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DBC 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DBE
  21+ 9DBE                  ; -- 1. QAOP --
  22+ 9DBE 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC1 ED 78            IN A, (C)
  24+ 9DC3 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DC5 20 02            JR NZ, .no_q
  26+ 9DC7 CB C2            SET 0, D
  27+ 9DC9              .no_q:
  28+ 9DC9 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DCC ED 78            IN A, (C)
  30+ 9DCE CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD0 20 02            JR NZ, .no_a
  32+ 9DD2 CB CA            SET 1, D
  33+ 9DD4              .no_a:
  34+ 9DD4 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DD7 ED 78            IN A, (C)
  36+ 9DD9 CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DDB 20 02            JR NZ, .no_o
  38+ 9DDD CB DA            SET 3, D
  39+ 9DDF              .no_o:
  40+ 9DDF CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE1 20 02            JR NZ, .no_p
  42+ 9DE3 CB D2            SET 2, D
  43+ 9DE5              .no_p:
  44+ 9DE5
  45+ 9DE5                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DE5                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DE5 DB 1F            IN A, (31)
  48+ 9DE7 4F               LD C, A             ; guardar para fire
  49+ 9DE8 CB 5F            BIT 3, A            ; Up
  50+ 9DEA 28 02            JR Z, .no_k_up
  51+ 9DEC CB C2            SET 0, D
  52+ 9DEE              .no_k_up:
  53+ 9DEE CB 57            BIT 2, A            ; Down
  54+ 9DF0 28 02            JR Z, .no_k_down
  55+ 9DF2 CB CA            SET 1, D
  56+ 9DF4              .no_k_down:
  57+ 9DF4 CB 4F            BIT 1, A            ; Left
  58+ 9DF6 28 02            JR Z, .no_k_left
  59+ 9DF8 CB DA            SET 3, D
  60+ 9DFA              .no_k_left:
  61+ 9DFA CB 47            BIT 0, A            ; Right
  62+ 9DFC 28 02            JR Z, .no_k_right
  63+ 9DFE CB D2            SET 2, D
  64+ 9E00              .no_k_right:
  65+ 9E00 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E02 28 02            JR Z, .no_k_fire
  67+ 9E04 CB C3            SET 0, E
  68+ 9E06              .no_k_fire:
  69+ 9E06
  70+ 9E06                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E06                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E06 01 FE F7         LD BC, $F7FE
  73+ 9E09 ED 78            IN A, (C)
  74+ 9E0B CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E0D 20 02            JR NZ, .no_s1_up
  76+ 9E0F CB C2            SET 0, D
  77+ 9E11              .no_s1_up:
  78+ 9E11 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E13 20 02            JR NZ, .no_s1_down
  80+ 9E15 CB CA            SET 1, D
  81+ 9E17              .no_s1_down:
  82+ 9E17 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E19 20 02            JR NZ, .no_s1_left
  84+ 9E1B CB DA            SET 3, D
  85+ 9E1D              .no_s1_left:
  86+ 9E1D CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E1F 20 02            JR NZ, .no_s1_right
  88+ 9E21 CB D2            SET 2, D
  89+ 9E23              .no_s1_right:
  90+ 9E23 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E25 20 02            JR NZ, .no_s1_fire
  92+ 9E27 CB C3            SET 0, E
  93+ 9E29              .no_s1_fire:
  94+ 9E29
  95+ 9E29                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E29 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E2C ED 78            IN A, (C)
  98+ 9E2E CB 47            BIT 0, A            ; SPACE
  99+ 9E30 20 02            JR NZ, .no_space
 100+ 9E32 CB C3            SET 0, E
 101+ 9E34              .no_space:
 102+ 9E34
 103+ 9E34                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E34 7B               LD A, E
 105+ 9E35 32 AC 82         LD (InputFire), A
 106+ 9E38
 107+ 9E38                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E38 21 DA 82         LD HL, MushroomLockTimer
 109+ 9E3B 7E               LD A, (HL)
 110+ 9E3C 23               INC HL
 111+ 9E3D B6               OR (HL)
 112+ 9E3E 28 21            JR Z, .noMushLock
 113+ 9E40 AF               XOR A
 114+ 9E41 32 AC 82         LD (InputFire), A
 115+ 9E44                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E44                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E44 7B               LD A, E
 118+ 9E45 B7               OR A
 119+ 9E46 28 15            JR Z, .resetNoSwordFlag
 120+ 9E48 3A B5 82         LD A, (NoSwordSoundFlag)
 121+ 9E4B B7               OR A
 122+ 9E4C 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E4E 3E 01            LD A, 1
 124+ 9E50 32 B5 82         LD (NoSwordSoundFlag), A
 125+ 9E53 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E54 21 92 F8         LD HL, SFX_NoSwordError
 127+ 9E57 CD 50 F7         CALL PlaySFX
 128+ 9E5A D1               POP DE
 129+ 9E5B 18 04            JR .noMushLock
 130+ 9E5D              .resetNoSwordFlag:
 131+ 9E5D AF               XOR A
 132+ 9E5E 32 B5 82         LD (NoSwordSoundFlag), A
 133+ 9E61              .noMushLock:
 134+ 9E61
 135+ 9E61                  ; -- 6. Cancelar opuestos --
 136+ 9E61 7A               LD A, D
 137+ 9E62 47               LD B, A
 138+ 9E63 E6 03            AND DIR_N | DIR_S
 139+ 9E65 FE 03            CP DIR_N | DIR_S
 140+ 9E67 20 04            JR NZ, .noVC
 141+ 9E69 78               LD A, B
 142+ 9E6A E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ 9E6C 47               LD B, A
 144+ 9E6D              .noVC:
 145+ 9E6D 78               LD A, B
 146+ 9E6E E6 0C            AND DIR_E | DIR_W
 147+ 9E70 FE 0C            CP DIR_E | DIR_W
 148+ 9E72 20 04            JR NZ, .noHC
 149+ 9E74 78               LD A, B
 150+ 9E75 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ 9E77 47               LD B, A
 152+ 9E78              .noHC:
 153+ 9E78 78               LD A, B
 154+ 9E79 32 AB 82         LD (InputDirection), A
 155+ 9E7C C9               RET
 156+ 9E7D
 157+ 9E7D              ; ==============================================================================
 158+ 9E7D              ; InitEntities - Inicializa la tabla de entidades
 159+ 9E7D              ; ==============================================================================
 160+ 9E7D              ; Limpia todos los slots y configura el slot 0 como player.
 161+ 9E7D              ; ==============================================================================
 162+ 9E7D              InitEntities:
 163+ 9E7D                  ; Limpiar toda la tabla a ceros
 164+ 9E7D 21 9B 81         LD HL, EntityTable
 165+ 9E80 11 9C 81         LD DE, EntityTable + 1
 166+ 9E83 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E86 AF               XOR A
 168+ 9E87 77               LD (HL), A
 169+ 9E88 ED B0            LDIR
 170+ 9E8A
 171+ 9E8A                  ; Limpiar tabla de atributos salvados
 172+ 9E8A 21 D7 9B         LD HL, SavedAttrTable
 173+ 9E8D 11 D8 9B         LD DE, SavedAttrTable + 1
 174+ 9E90 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E93 AF               XOR A
 176+ 9E94 77               LD (HL), A
 177+ 9E95 ED B0            LDIR
 178+ 9E97
 179+ 9E97                  ; Configurar slot 0: Player
 180+ 9E97 DD 21 9B 81      LD IX, EntityTable
 181+ 9E9B DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ 9E9F DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ 9EA3 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ 9EA7 DD 36 03 C8      LD (IX+ENT_POSX), START_PLAYER_X
 185+ 9EAB DD 36 04 38      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ 9EAF DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ 9EB3 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ 9EB7 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ 9EBB DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ 9EBF DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EC3 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9EC7 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ 9ECB DD 36 0C C8      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ 9ECF DD 36 0D 38      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ 9ED3 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ 9ED7 DD 36 0F C8      LD (IX+ENT_DRAWX), START_PLAYER_X
 197+ 9EDB
 198+ 9EDB                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ 9EDB 3E 0C            LD A, SPAWN_INTERVAL
 200+ 9EDD 32 F5 82         LD (SpawnTimer), A
 201+ 9EE0 AF               XOR A
 202+ 9EE1 32 02 83         LD (EnemyStepIdx), A
 203+ 9EE4 32 7B 5F         LD (PendingEraseCount), A
 204+ 9EE7 C9               RET
 205+ 9EE8
 206+ 9EE8              ; ==============================================================================
 207+ 9EE8              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ 9EE8              ; ==============================================================================
 209+ 9EE8              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ 9EE8              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ 9EE8              ; que los pies parezcan hundirse en el suelo.
 212+ 9EE8              ; ==============================================================================
 213+ 9EE8              ComputePlayerDrawY:
 214+ 9EE8                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ 9EE8                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ 9EE8                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ 9EE8 3A 9B 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ 9EEB D6 6E            SUB SPRID_PLAYER_DEATH
 219+ 9EED FE 06            CP 6
 220+ 9EEF 30 09            JR NC, .cpdyNotDeath
 221+ 9EF1 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 222+ 9EF4 C6 05            ADD A, 5
 223+ 9EF6 32 DC 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ 9EF9 C9               RET
 225+ 9EFA              .cpdyNotDeath:
 226+ 9EFA 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 227+ 9EFD C6 08            ADD A, 8                    ; center X del player
 228+ 9EFF 47               LD B, A
 229+ 9F00 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 230+ 9F03 4F               LD C, A
 231+ 9F04 32 DC 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ 9F07 B7               OR A
 233+ 9F08 C8               RET Z
 234+ 9F09 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ 9F0A CD 8C D5         CALL IsPointBlocked
 236+ 9F0D C8               RET Z                       ; libre → sin offset
 237+ 9F0E 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 238+ 9F11 3C               INC A
 239+ 9F12 32 DC 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ 9F15 C9               RET
 241+ 9F16
 242+ 9F16              ; ==============================================================================
 243+ 9F16              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ 9F16              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ 9F16              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ 9F16              ; no parecer que se hunde en el techo.
 247+ 9F16              ; Preserva: IX. Destruye: AF, BC.
 248+ 9F16              ; ==============================================================================
 249+ 9F16              ComputeEnemyDrawY:
 250+ 9F16 DD 7E 04         LD A, (IX+ENT_POSY)
 251+ 9F19 32 DD 82         LD (EnemyDrawY), A          ; default = POSY
 252+ 9F1C DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ 9F1F FE 02            CP TYPE_MONSTER
 254+ 9F21 C0               RET NZ                      ; no monster → sin offset
 255+ 9F22 DD 7E 03         LD A, (IX+ENT_POSX)
 256+ 9F25 C6 08            ADD A, 8                    ; center X
 257+ 9F27 47               LD B, A
 258+ 9F28 DD 7E 04         LD A, (IX+ENT_POSY)
 259+ 9F2B 4F               LD C, A
 260+ 9F2C B7               OR A
 261+ 9F2D C8               RET Z
 262+ 9F2E 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F2F CD 8C D5         CALL IsPointBlocked
 264+ 9F32 C8               RET Z                       ; libre → sin offset
 265+ 9F33 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F36 3C               INC A
 267+ 9F37 32 DD 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F3A C9               RET
 269+ 9F3B
 270+ 9F3B              ; ==============================================================================
 271+ 9F3B              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 272+ 9F3B              ; ==============================================================================
 273+ 9F3B              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 274+ 9F3B              ; ==============================================================================
 275+ 9F3B              ProcessPlayer:
 276+ 9F3B DD 21 9B 81      LD IX, EntityTable
 277+ 9F3F
 278+ 9F3F                  ; --- Fresh check ---
 279+ 9F3F 3A 12 83         LD A, (ScreenJustRedrawn)
 280+ 9F42 B7               OR A
 281+ 9F43 C2 0F A0         JP NZ, .plFresh
 282+ 9F46 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 283+ 9F4A C2 0F A0         JP NZ, .plFresh
 284+ 9F4D
 285+ 9F4D                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 286+ 9F4D                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 287+ 9F4D                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 288+ 9F4D                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 289+ 9F4D                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 290+ 9F4D                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 291+ 9F4D                  ; y UpdatePlayerAnimation lo sobrescribiria.
 292+ 9F4D 3A E7 82         LD A, (DeathBorderPhase)
 293+ 9F50 B7               OR A
 294+ 9F51 20 0A            JR NZ, .plSkipUpdate
 295+ 9F53 3A EB 82         LD A, (PlayerRespawnPhase)
 296+ 9F56 FE 01            CP 1
 297+ 9F58 28 03            JR Z, .plSkipUpdate
 298+ 9F5A CD 65 A5         CALL UpdatePlayer
 299+ 9F5D              .plSkipUpdate:
 300+ 9F5D CD 7E A4         CALL CalcDrawX
 301+ 9F60 CD E8 9E         CALL ComputePlayerDrawY
 302+ 9F63
 303+ 9F63                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 304+ 9F63 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 305+ 9F66 DD BE 0C         CP (IX+ENT_OLDX)
 306+ 9F69 20 3C            JR NZ, .plDoErase
 307+ 9F6B 3A DC 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 308+ 9F6E DD BE 0D         CP (IX+ENT_OLDY)
 309+ 9F71 20 34            JR NZ, .plDoErase
 310+ 9F73 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 311+ 9F76 DD BE 0E         CP (IX+ENT_OLDSPRID)
 312+ 9F79 20 2C            JR NZ, .plDoErase
 313+ 9F7B                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 314+ 9F7B 3A F4 C4         LD A, (PlayerHitTimer)
 315+ 9F7E B7               OR A
 316+ 9F7F 20 01            JR NZ, .plRepaintAttr
 317+ 9F81 C9               RET                                 ; Nada cambio → skip todo
 318+ 9F82              .plRepaintAttr:
 319+ 9F82 3A DC 82         LD A, (PlayerDrawY)
 320+ 9F85 57               LD D, A
 321+ 9F86 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 322+ 9F89 5F               LD E, A
 323+ 9F8A DD E5            PUSH IX
 324+ 9F8C CD C3 A4         CALL GetSpriteAddr
 325+ 9F8F DD 2A F2 A4      LD IX, (SpriteAddrTemp)
 326+ 9F93 CD 04 9B         CALL CalcEntityAttrSize
 327+ 9F96 DD E1            POP IX
 328+ 9F98 3A DC 82         LD A, (PlayerDrawY)
 329+ 9F9B 57               LD D, A
 330+ 9F9C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 331+ 9F9F 5F               LD E, A
 332+ 9FA0 DD 7E 05         LD A, (IX+ENT_ATTR)
 333+ 9FA3 CD D7 9A         CALL SetEntityAttr
 334+ 9FA6 C9               RET
 335+ 9FA7
 336+ 9FA7              .plDoErase:
 337+ 9FA7                  ; --- Erase viejo ---
 338+ 9FA7 CD F4 A4         CALL GetOldSpriteAddr
 339+ 9FAA DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 340+ 9FAD DD 7E 0C         LD A, (IX+ENT_OLDX)
 341+ 9FB0 5F               LD E, A
 342+ 9FB1 DD E5            PUSH IX
 343+ 9FB3 DD 2A 7C A4      LD IX, (OldSprAddr)
 344+ 9FB7 CD E7 99         CALL DrawSprite
 345+ 9FBA DD E1            POP IX
 346+ 9FBC                  ; Restaurar atributos del fondo en posicion vieja
 347+ 9FBC DD 56 0D         LD D, (IX+ENT_OLDY)
 348+ 9FBF DD 5E 0C         LD E, (IX+ENT_OLDX)
 349+ 9FC2 CD 1C D3         CALL RestoreOldAttr
 350+ 9FC5                  ; --- Draw nuevo ---
 351+ 9FC5 CD C3 A4         CALL GetSpriteAddr
 352+ 9FC8 3A DC 82         LD A, (PlayerDrawY)
 353+ 9FCB 57               LD D, A
 354+ 9FCC DD 7E 0F         LD A, (IX+ENT_DRAWX)
 355+ 9FCF 5F               LD E, A
 356+ 9FD0 DD E5            PUSH IX
 357+ 9FD2 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
 358+ 9FD6 CD E7 99         CALL DrawSprite
 359+ 9FD9 DD E1            POP IX
 360+ 9FDB
 361+ 9FDB                  ; Pintar attr
 362+ 9FDB 3A DC 82         LD A, (PlayerDrawY)
 363+ 9FDE 57               LD D, A
 364+ 9FDF DD 7E 0F         LD A, (IX+ENT_DRAWX)
 365+ 9FE2 5F               LD E, A
 366+ 9FE3 DD E5            PUSH IX
 367+ 9FE5 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
 368+ 9FE9 CD 04 9B         CALL CalcEntityAttrSize
 369+ 9FEC DD E1            POP IX
 370+ 9FEE 3A DC 82         LD A, (PlayerDrawY)
 371+ 9FF1 57               LD D, A
 372+ 9FF2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 373+ 9FF5 5F               LD E, A
 374+ 9FF6 DD 7E 05         LD A, (IX+ENT_ATTR)
 375+ 9FF9 CD D7 9A         CALL SetEntityAttr
 376+ 9FFC
 377+ 9FFC                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 378+ 9FFC              .plSaveOld:
 379+ 9FFC DD 7E 0F         LD A, (IX+ENT_DRAWX)
 380+ 9FFF DD 77 0C         LD (IX+ENT_OLDX), A
 381+ A002 3A DC 82         LD A, (PlayerDrawY)
 382+ A005 DD 77 0D         LD (IX+ENT_OLDY), A
 383+ A008 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 384+ A00B DD 77 0E         LD (IX+ENT_OLDSPRID), A
 385+ A00E C9               RET
 386+ A00F
 387+ A00F                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 388+ A00F              .plFresh:
 389+ A00F DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 390+ A013 CD 65 A5         CALL UpdatePlayer
 391+ A016 CD 7E A4         CALL CalcDrawX
 392+ A019 CD E8 9E         CALL ComputePlayerDrawY
 393+ A01C CD C3 A4         CALL GetSpriteAddr
 394+ A01F
 395+ A01F 3A DC 82         LD A, (PlayerDrawY)
 396+ A022 57               LD D, A
 397+ A023 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 398+ A026 5F               LD E, A
 399+ A027 DD E5            PUSH IX
 400+ A029 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
 401+ A02D CD 04 9B         CALL CalcEntityAttrSize
 402+ A030 DD E1            POP IX
 403+ A032 3A DC 82         LD A, (PlayerDrawY)
 404+ A035 57               LD D, A
 405+ A036 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 406+ A039 5F               LD E, A
 407+ A03A DD 7E 05         LD A, (IX+ENT_ATTR)
 408+ A03D CD D7 9A         CALL SetEntityAttr
 409+ A040
 410+ A040 3A DC 82         LD A, (PlayerDrawY)
 411+ A043 57               LD D, A
 412+ A044 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 413+ A047 5F               LD E, A
 414+ A048 DD E5            PUSH IX
 415+ A04A DD 2A F2 A4      LD IX, (SpriteAddrTemp)
 416+ A04E CD E7 99         CALL DrawSprite
 417+ A051 DD E1            POP IX
 418+ A053 18 A7            JR .plSaveOld
 419+ A055
 420+ A055              ; ==============================================================================
 421+ A055              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A055              ; ==============================================================================
 423+ A055              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A055              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A055              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A055              ; ==============================================================================
 427+ A055              ProcessEnemies:
 428+ A055 3E 00            LD A, 0
 429+ A057 32 A0 A0         LD (.peCount), A
 430+ A05A 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A05C
 432+ A05C              .peLoop:
 433+ A05C C5               PUSH BC
 434+ A05D
 435+ A05D                  ; Calcular IX desde EnemyStepIdx
 436+ A05D 3A 02 83         LD A, (EnemyStepIdx)
 437+ A060 C6 01            ADD A, SLOT_MONSTER0
 438+ A062 6F               LD L, A
 439+ A063 26 00            LD H, 0
