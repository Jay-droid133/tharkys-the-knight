1302+ F402              .ucsShakeJitterTable:
1303+ F402 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1304+ F406              .ucsShakeStatueDone:
1305+ F406                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1306+ F406 AF               XOR A
1307+ F407 D3 FE            OUT (254), A
1308+ F409                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1309+ F409                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1310+ F409                  ; directo a 0 garantiza que no queden residuos.)
1311+ F409 CD 64 F5         CALL ChurchCutsceneEraseStatueDirect
