4512+ AC09 3A 9E 80         LD A, (EntityTable + ENT_SPRITEID)
4513+ AC0C CD F4 96         CALL GetSpriteDims          ; B=playerW, C=playerH
4514+ AC0F 78               LD A, B
4515+ AC10 32 1E AE         LD (.plW), A
4516+ AC13 79               LD A, C
4517+ AC14 32 1F AE         LD (.plH), A
4518+ AC17
4519+ AC17 DD 21 AE 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)  ; Empezar en slot 1
4520+ AC1B 06 09            LD B, NUM_MONSTERS + NUM_NASTIES       ; Slots 1-12
4521+ AC1D
4522+ AC1D              .checkLoop:
