2645+ DA5B 23               INC HL                      ; siguiente slot (DEFW = 2 bytes)
2646+ DA5C 0C               INC C
2647+ DA5D 10 F1            DJNZ .gpkbLoop
2648+ DA5F AF               XOR A                       ; no encontrado → comportamiento normal
2649+ DA60 C1               POP BC
2650+ DA61 E1               POP HL
2651+ DA62 C9               RET
2652+ DA63              .gpkbFound:
2653+ DA63 79               LD A, C                     ; A = id (1..8)
2654+ DA64 C1               POP BC
2655+ DA65 E1               POP HL
2656+ DA66 C9               RET
