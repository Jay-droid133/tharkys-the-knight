 553+ EF2C              .pixLoop:
 554+ EF2C 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 555+ EF2D B7               OR A
 556+ EF2E C8               RET Z
 557+ EF2F 57               LD D, A
 558+ EF30 23               INC HL
 559+ EF31 7E               LD A, (HL)          ; VRAM L
 560+ EF32 23               INC HL
 561+ EF33 5F               LD E, A
 562+ EF34 7E               LD A, (HL)          ; mask
 563+ EF35 23               INC HL
 564+ EF36 E5               PUSH HL
 565+ EF37 2F               CPL                 ; ~mask
 566+ EF38 62               LD H, D
 567+ EF39 6B               LD L, E
 568+ EF3A A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 569+ EF3B 77               LD (HL), A
 570+ EF3C E1               POP HL
 571+ EF3D 18 ED            JR .pixLoop
