1252+ 9794              ; BuildZoneCellList - construye ZoneCellList (main RAM) iterando FlowField
1253+ 9794              ; ==============================================================================
1254+ 9794              ; Llamada desde DrawScreen al entrar a una sala (tras MaiComputeFlowField).
1255+ 9794              ; Anade (cx, cy) a la lista para CADA celda alcanzable desde el player en su
1256+ 9794              ; posicion de entrada (FlowField byte != $FF). La lista representa el "hueco"
1257+ 9794              ; completo donde puedo estar, sin filtro de proximidad.
1258+ 9794              ; Cap 255 entradas. SpawnOneNasty elige idx random de aqui.
1259+ 9794              ; Destruye: AF, BC, DE, HL.
1260+ 9794              ; ==============================================================================
1261+ 9794              BuildZoneCellList:
1262+ 9794 AF               XOR A
1263+ 9795 32 00 5D         LD (ZoneCellCount), A
1264+ 9798 21 01 5D         LD HL, ZoneCellList
1265+ 979B 22 F1 97         LD (.bzclPtr), HL
1266+ 979E F3               DI
1267+ 979F 3A 57 90         LD A, (CurrentPaging)
1268+ 97A2 E6 F8            AND $F8
1269+ 97A4 F6 06            OR 6
1270+ 97A6 32 57 90         LD (CurrentPaging), A
1271+ 97A9 01 FD 7F         LD BC, $7FFD
1272+ 97AC ED 79            OUT (C), A
1273+ 97AE 11 ED C9         LD DE, FlowField
1274+ 97B1 0E 00            LD C, 0                                 ; cy
1275+ 97B3              .bzclRow:
1276+ 97B3 06 00            LD B, 0                                 ; cx
1277+ 97B5              .bzclCol:
1278+ 97B5 1A               LD A, (DE)
1279+ 97B6 13               INC DE
1280+ 97B7 FE FF            CP $FF
1281+ 97B9 28 15            JR Z, .bzclSkipCell
1282+ 97BB                  ; Append (cx, cy)
1283+ 97BB 3A 00 5D         LD A, (ZoneCellCount)
1284+ 97BE FE FF            CP 255
1285+ 97C0 28 0E            JR Z, .bzclSkipCell
1286+ 97C2 3C               INC A
1287+ 97C3 32 00 5D         LD (ZoneCellCount), A
1288+ 97C6 2A F1 97         LD HL, (.bzclPtr)
1289+ 97C9 70               LD (HL), B                              ; cx
1290+ 97CA 23               INC HL
1291+ 97CB 71               LD (HL), C                              ; cy
1292+ 97CC 23               INC HL
1293+ 97CD 22 F1 97         LD (.bzclPtr), HL
1294+ 97D0              .bzclSkipCell:
1295+ 97D0 04               INC B
1296+ 97D1 78               LD A, B
1297+ 97D2 FE 20            CP 32
1298+ 97D4 20 DF            JR NZ, .bzclCol
1299+ 97D6 0C               INC C
1300+ 97D7 79               LD A, C
1301+ 97D8 FE 16            CP 22
1302+ 97DA 20 D7            JR NZ, .bzclRow
1303+ 97DC 3A 57 90         LD A, (CurrentPaging)
1304+ 97DF E6 F8            AND $F8
1305+ 97E1 32 57 90         LD (CurrentPaging), A
1306+ 97E4 01 FD 7F         LD BC, $7FFD
1307+ 97E7 ED 79            OUT (C), A
1308+ 97E9 3A DB 80         LD A, (StartupComplete)
1309+ 97EC B7               OR A
1310+ 97ED 28 01            JR Z, .bzclNoEI
1311+ 97EF FB               EI
1312+ 97F0              .bzclNoEI:
1313+ 97F0 C9               RET
1314+ 97F1 00 00        .bzclPtr:  DEFW 0
