 123+ EA25              ; ==============================================================================
 124+ EA25              ; UpdateGameClock
 125+ EA25              ; ==============================================================================
 126+ EA25              UpdateGameClock:
 127+ EA25 3A B3 82         LD A, (TimeFrozen)
 128+ EA28 B7               OR A
 129+ EA29 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EA2A 21 8B E8         LD HL, GameSubMinute
 131+ EA2D 34               INC (HL)
 132+ EA2E 3A 8E E8         LD A, (SubMinuteMax)
 133+ EA31 BE               CP (HL)
 134+ EA32 C0               RET NZ
 135+ EA33
 136+ EA33 AF               XOR A
 137+ EA34 32 8B E8         LD (GameSubMinute), A
 138+ EA37 21 8C E8         LD HL, GameMinutes
 139+ EA3A 34               INC (HL)
 140+ EA3B                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EA3B                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EA3B 3A 8C E8         LD A, (GameMinutes)
 143+ EA3E FE 3C            CP 60
 144+ EA40 C0               RET NZ
 145+ EA41
 146+ EA41 AF               XOR A
 147+ EA42 32 8C E8         LD (GameMinutes), A
 148+ EA45 21 8D E8         LD HL, GameHours
 149+ EA48 34               INC (HL)
 150+ EA49 7E               LD A, (HL)
 151+ EA4A FE 18            CP 24
 152+ EA4C 20 04            JR NZ, .checkPhase
 153+ EA4E AF               XOR A
 154+ EA4F 32 8D E8         LD (GameHours), A
 155+ EA52
 156+ EA52              .checkPhase:
 157+ EA52 3A 8D E8         LD A, (GameHours)
 158+ EA55 21 97 E8         LD HL, PhaseTable
 159+ EA58 06 07            LD B, 7
 160+ EA5A              .phaseLoop:
 161+ EA5A BE               CP (HL)
 162+ EA5B 28 05            JR Z, .phaseFound
 163+ EA5D 23               INC HL
 164+ EA5E 23               INC HL
 165+ EA5F 10 F9            DJNZ .phaseLoop
 166+ EA61 C9               RET
 167+ EA62              .phaseFound:
 168+ EA62 23               INC HL
 169+ EA63 7E               LD A, (HL)
 170+ EA64 F5               PUSH AF
 171+ EA65 CD 30 E2         CALL SetTimeOfDay
 172+ EA68 F1               POP AF
 173+ EA69 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EA6B C0               RET NZ
 175+ EA6C                  ; Nuevo dia: incrementar ciclo
 176+ EA6C 21 A7 BC         LD HL, DayCycleCount
 177+ EA6F 34               INC (HL)
 178+ EA70 C9               RET
 179+ EA71
 180+ EA71              ; ==============================================================================
 181+ EA71              ; SetClockToPhaseHour
 182+ EA71              ; ==============================================================================
 183+ EA71              SetClockToPhaseHour:
 184+ EA71 21 90 E8         LD HL, PhaseStartHour
 185+ EA74 4F               LD C, A
 186+ EA75 06 00            LD B, 0
 187+ EA77 09               ADD HL, BC
 188+ EA78 7E               LD A, (HL)
 189+ EA79 32 8D E8         LD (GameHours), A
 190+ EA7C AF               XOR A
 191+ EA7D 32 8C E8         LD (GameMinutes), A
 192+ EA80 32 8B E8         LD (GameSubMinute), A
 193+ EA83 C9               RET
 194+ EA84
 195+ EA84              ; ==============================================================================
 196+ EA84              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EA84              ; ==============================================================================
 198+ EA84              DrawClockHUD:
 199+ EA84                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EA84                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EA84                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EA84                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EA84                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EA84                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EA84 3A B3 82         LD A, (TimeFrozen)
 206+ EA87 FE 01            CP 1
 207+ EA89 20 07            JR NZ, .clkDrawNormal
 208+ EA8B 3A 98 81         LD A, (GameFrameCounter)
 209+ EA8E E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EA90 28 2D            JR Z, .clkBlinkOff
 211+ EA92              .clkDrawNormal:
 212+ EA92 CD CD EA         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EA95
 214+ EA95                  ; --- Aguja de horas ---
 215+ EA95 3A 8D E8         LD A, (GameHours)
 216+ EA98 FE 0C            CP 12
 217+ EA9A 38 02            JR C, .hourOk
 218+ EA9C D6 0C            SUB 12
 219+ EA9E              .hourOk:
 220+ EA9E 21 89 E9         LD HL, HourHandPtrs
 221+ EAA1 CD A3 EC         CALL DrawHandLine
 222+ EAA4
 223+ EAA4                  ; --- Aguja de minutos ---
 224+ EAA4 3A 8C E8         LD A, (GameMinutes)
 225+ EAA7 06 00            LD B, 0
 226+ EAA9              .divMin:
 227+ EAA9 FE 05            CP 5
 228+ EAAB 38 05            JR C, .minOk
 229+ EAAD D6 05            SUB 5
 230+ EAAF 04               INC B
 231+ EAB0 18 F7            JR .divMin
 232+ EAB2              .minOk:
 233+ EAB2 78               LD A, B
 234+ EAB3 21 A5 E8         LD HL, MinHandPtrs
 235+ EAB6 CD A3 EC         CALL DrawHandLine
 236+ EAB9
 237+ EAB9                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EAB9 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EABC CB 86            RES 0, (HL)
 240+ EABE C9               RET
 241+ EABF
 242+ EABF              .clkBlinkOff:
 243+ EABF                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EABF                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EABF                  ; paper=black + ink=black.
 246+ EABF AF               XOR A
 247+ EAC0 32 0F 58         LD ($580F), A
 248+ EAC3 32 2F 58         LD ($582F), A
 249+ EAC6 32 10 58         LD ($5810), A
 250+ EAC9 32 30 58         LD ($5830), A
 251+ EACC C9               RET
 252+ EACD
 253+ EACD              ; ==============================================================================
 254+ EACD              ; DrawClockFaceOnly - Redibuja solo la esfera (cols 15-16, filas 22-23)
 255+ EACD              ; ==============================================================================
 256+ EACD              ; Salta los bytes de decoración (bytes 0-1 y 4-5 de cada fila del sprite)
 257+ EACD              ; ==============================================================================
 258+ EACD              DrawClockFaceOnly:
 259+ EACD DD 21 AB E7      LD IX, BgGfx_hud_clock + 2  ; saltar cabecera
 260+ EAD1
 261+ EAD1 26 40            LD H, $40
 262+ EAD3 2E 0F            LD L, $0F               ; col 15, scan 0, fila 0
 263+ EAD5 0E 08            LD C, 8
 264+ EAD7              .fc22:
 265+ EAD7 DD 23            INC IX
 265+ EAD9 DD 23          INC IX         ; saltar bytes 0-1 (decoración izquierda)
 266+ EADB E5               PUSH HL
 267+ EADC C5               PUSH BC
 268+ EADD DD 7E 00         LD A, (IX)
 268+ EAE0 DD 23          INC IX
 268+ EAE2 2F             CPL
 268+ EAE3 77             LD (HL), A
 268+ EAE4 23             INC HL  ; byte 2 → col 15
 269+ EAE5 DD 7E 00         LD A, (IX)
 269+ EAE8 DD 23          INC IX
 269+ EAEA 2F             CPL
 269+ EAEB 77             LD (HL), A            ; byte 3 → col 16
 270+ EAEC DD 23            INC IX
 270+ EAEE DD 23          INC IX         ; saltar bytes 4-5 (decoración derecha)
 271+ EAF0 C1               POP BC
 272+ EAF1 E1               POP HL
 273+ EAF2 24               INC H
 274+ EAF3 0D               DEC C
 275+ EAF4 20 E1            JR NZ, .fc22
 276+ EAF6
 277+ EAF6 26 40            LD H, $40
 278+ EAF8 2E 2F            LD L, $2F               ; col 15, scan 0, fila 1
 279+ EAFA 0E 08            LD C, 8
 280+ EAFC              .fc23:
 281+ EAFC DD 23            INC IX
 281+ EAFE DD 23          INC IX
 282+ EB00 E5               PUSH HL
 283+ EB01 C5               PUSH BC
 284+ EB02 DD 7E 00         LD A, (IX)
 284+ EB05 DD 23          INC IX
 284+ EB07 2F             CPL
 284+ EB08 77             LD (HL), A
 284+ EB09 23             INC HL
 285+ EB0A DD 7E 00         LD A, (IX)
 285+ EB0D DD 23          INC IX
 285+ EB0F 2F             CPL
 285+ EB10 77             LD (HL), A
 286+ EB11 DD 23            INC IX
 286+ EB13 DD 23          INC IX
 287+ EB15 C1               POP BC
 288+ EB16 E1               POP HL
 289+ EB17 24               INC H
 290+ EB18 0D               DEC C
 291+ EB19 20 E1            JR NZ, .fc23
 292+ EB1B
 293+ EB1B                  ; Atributos de la esfera (filas 0-1, cols 15-16)
 294+ EB1B 3E 47            LD A, $47              ; col 15: bright white
 295+ EB1D 32 0F 58         LD ($580F), A
 296+ EB20 32 2F 58         LD ($582F), A
 297+ EB23 3E 07            LD A, $07              ; col 16: white
 298+ EB25 32 10 58         LD ($5810), A
 299+ EB28 32 30 58         LD ($5830), A
 300+ EB2B C9               RET
 301+ EB2C
 302+ EB2C              ; ==============================================================================
 303+ EB2C              ; DrawClockSprite - Copia BgGfx_hud_clock al HUD (filas 22-23, cols 13-18)
 304+ EB2C              ; ==============================================================================
 305+ EB2C              ; Aplica CPL a cada byte (datos almacenados invertidos, como en DrawBgGfxSprite)
 306+ EB2C              ; ==============================================================================
 307+ EB2C              DrawClockSprite:
 308+ EB2C DD 21 AB E7      LD IX, BgGfx_hud_clock + 2  ; saltar cabecera height_px, width_bytes
 309+ EB30
 310+ EB30                  ; --- Filas 0-7 del sprite → fila 0, scans 0-7 ---
 311+ EB30 26 40            LD H, $40
 312+ EB32 2E 0D            LD L, $0D               ; col 13, scan 0
 313+ EB34 0E 08            LD C, 8
 314+ EB36              .r22:
 315+ EB36 E5               PUSH HL
 316+ EB37 C5               PUSH BC
 317+ EB38 06 06            LD B, 6
 318+ EB3A              .b22:
 319+ EB3A DD 7E 00         LD A, (IX)
 320+ EB3D 2F               CPL
 321+ EB3E 77               LD (HL), A
 322+ EB3F DD 23            INC IX
 323+ EB41 23               INC HL
 324+ EB42 10 F6            DJNZ .b22
 325+ EB44 C1               POP BC
 326+ EB45 E1               POP HL
 327+ EB46 24               INC H                   ; siguiente scan line
 328+ EB47 0D               DEC C
 329+ EB48 20 EC            JR NZ, .r22
 330+ EB4A
 331+ EB4A                  ; --- Filas 8-15 del sprite → fila 1, scans 0-7 ---
 332+ EB4A 26 40            LD H, $40
 333+ EB4C 2E 2D            LD L, $2D               ; col 13, scan 0
 334+ EB4E 0E 08            LD C, 8
 335+ EB50              .r23:
 336+ EB50 E5               PUSH HL
 337+ EB51 C5               PUSH BC
 338+ EB52 06 06            LD B, 6
 339+ EB54              .b23:
 340+ EB54 DD 7E 00         LD A, (IX)
 341+ EB57 2F               CPL
 342+ EB58 77               LD (HL), A
 343+ EB59 DD 23            INC IX
 344+ EB5B 23               INC HL
 345+ EB5C 10 F6            DJNZ .b23
 346+ EB5E C1               POP BC
 347+ EB5F E1               POP HL
 348+ EB60 24               INC H
 349+ EB61 0D               DEC C
 350+ EB62 20 EC            JR NZ, .r23
 351+ EB64
 352+ EB64                  ; --- Atributos del sprite (2 filas × 6 cols) ---
 353+ EB64                  ; Layout: [dec0][dec1][sfera_L][sfera_R][dec2][dec3]
 354+ EB64                  ; Decoracion (cols 0,1,4,5): remap paper via ApplyDayCycleRemap
 355+ EB64                  ; Esfera (cols 2,3): sin remap (gestionada por DrawClockFaceOnly)
 356+ EB64 DD 23            INC IX                  ; saltar attr_h
 357+ EB66 DD 23            INC IX                  ; saltar attr_w
 358+ EB68 AF               XOR A
 359+ EB69 32 2D E2         LD (BgSpriteIsHouse), A ; clock no es house
 360+ EB6C                  ; --- Fila 0 (row 0, cols 13-18) ---
 361+ EB6C 21 0D 58         LD HL, $580D
 362+ EB6F DD 7E 00         LD A, (IX+0)
 362+ EB72 CD 90 E3       CALL ApplyDayCycleRemap
 362+ EB75 77             LD (HL), A
 362+ EB76 23             INC HL
 363+ EB77 DD 7E 01         LD A, (IX+1)
 363+ EB7A CD 90 E3       CALL ApplyDayCycleRemap
 363+ EB7D 77             LD (HL), A
 363+ EB7E 23             INC HL
 364+ EB7F DD 7E 02         LD A, (IX+2)
 364+ EB82 77                                       LD (HL), A
 364+ EB83 23             INC HL  ; esfera
 365+ EB84 DD 7E 03         LD A, (IX+3)
 365+ EB87 77                                       LD (HL), A
 365+ EB88 23             INC HL  ; esfera
 366+ EB89 DD 7E 04         LD A, (IX+4)
 366+ EB8C CD 90 E3       CALL ApplyDayCycleRemap
 366+ EB8F 77             LD (HL), A
 366+ EB90 23             INC HL
 367+ EB91 DD 7E 05         LD A, (IX+5)
 367+ EB94 CD 90 E3       CALL ApplyDayCycleRemap
 367+ EB97 77             LD (HL), A
 368+ EB98                  ; --- Fila 1 (row 1, cols 13-18) ---
 369+ EB98 21 2D 58         LD HL, $582D
 370+ EB9B DD 7E 06         LD A, (IX+6)
 370+ EB9E CD 90 E3       CALL ApplyDayCycleRemap
 370+ EBA1 77             LD (HL), A
 370+ EBA2 23             INC HL
 371+ EBA3 DD 7E 07         LD A, (IX+7)
 371+ EBA6 CD 90 E3       CALL ApplyDayCycleRemap
 371+ EBA9 77             LD (HL), A
 371+ EBAA 23             INC HL
 372+ EBAB DD 7E 08         LD A, (IX+8)
 372+ EBAE 77                                       LD (HL), A
 372+ EBAF 23             INC HL  ; esfera
 373+ EBB0 DD 7E 09         LD A, (IX+9)
 373+ EBB3 77                                       LD (HL), A
 373+ EBB4 23             INC HL  ; esfera
 374+ EBB5 DD 7E 0A         LD A, (IX+10)
 374+ EBB8 CD 90 E3       CALL ApplyDayCycleRemap
 374+ EBBB 77             LD (HL), A
 374+ EBBC 23             INC HL
 375+ EBBD DD 7E 0B         LD A, (IX+11)
 375+ EBC0 CD 90 E3       CALL ApplyDayCycleRemap
 375+ EBC3 77             LD (HL), A
 376+ EBC4 C9               RET
 377+ EBC5
 378+ EBC5              ; ==============================================================================
 379+ EBC5              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EBC5              ; ==============================================================================
 381+ EBC5              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EBC5              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EBC5              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EBC5              ; ==============================================================================
 385+ EBC5              DrawHealthStaminaHUD:
 386+ EBC5                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EBC5 3A 0C B3         LD A, (PlayerHealth)
 388+ EBC8 4F               LD C, A                             ; C = nivel (0-16)
 389+ EBC9 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EBCC 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EBCF DD 21 AB E7      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EBD3 FD 21 1C E8      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EBD7 CD 3D EC         CALL .drawBar
 394+ EBDA
 395+ EBDA                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EBDA 3A 0D B3         LD A, (PlayerStamina)
 397+ EBDD 4F               LD C, A
 398+ EBDE 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EBE1 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EBE4 DD 21 AF E7      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EBE8 FD 21 20 E8      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EBEC CD 3D EC         CALL .drawBar
 403+ EBEF
 404+ EBEF                  ; --- Flash de recuperacion del pozo ---
 405+ EBEF 3A 5A 8D         LD A, (WellFlashTimer)
 406+ EBF2 B7               OR A
 407+ EBF3 28 23            JR Z, .noFlash
 408+ EBF5 3D               DEC A
 409+ EBF6 32 5A 8D         LD (WellFlashTimer), A
 410+ EBF9                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EBF9 E6 04            AND $04
 412+ EBFB 28 1B            JR Z, .noFlash
 413+ EBFD                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ EBFD                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ EBFD 3E 47            LD A, WHITE | $40
 416+ EBFF 32 0D 58         LD ($580D), A
 417+ EC02 32 0E 58         LD ($580E), A
 418+ EC05 32 2D 58         LD ($582D), A
 419+ EC08 32 2E 58         LD ($582E), A
 420+ EC0B 32 11 58         LD ($5811), A
 421+ EC0E 32 12 58         LD ($5812), A
 422+ EC11 32 31 58         LD ($5831), A
 423+ EC14 32 32 58         LD ($5832), A
 424+ EC17 C9               RET
