 662+ 63C3              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 63C3              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 63C3              ; Bank 3 para ambos (sprites baseline town).
 665+ 63C3              ; Destruye: AF, BC, DE, HL, IX.
 666+ 63C3              ; ==============================================================================
 667+ 63C3              TownGateOpenDoor:
 668+ 63C3 11 28 E9         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 63C6 CD 9A DA         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 63C9                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 63C9
 672+ 63C9              ; ==============================================================================
 673+ 63C9              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 63C9              ; ==============================================================================
 675+ 63C9              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 63C9              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 63C9              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 63C9              ; ==============================================================================
 679+ 63C9              TownGateRedrawOpenDoor:
 680+ 63C9 21 E7 EC         LD HL, BgGfx_town_gate_door_open
 681+ 63CC 3E 03            LD A, 3
 682+ 63CE CD 8F 6A         CALL LoadBgSpriteToBuffer
 683+ 63D1 DD 21 9B 89      LD IX, BgSpriteBuffer
 684+ 63D5 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 63D7 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 63D9 AF               XOR A
 687+ 63DA 32 52 E5         LD (BgSpriteIsHouse), A
 688+ 63DD 32 43 D5         LD (CurrentTintVar), A
 689+ 63E0 C3 39 D4         JP DrawBgGfxSprite
 690+ 63E3
 691+ 63E3              ; ==============================================================================
 692+ 63E3              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 63E3              ; ==============================================================================
 694+ 63E3              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 63E3              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 63E3              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 63E3              ; Destruye: A, BC, DE, IX.
 698+ 63E3              ; ==============================================================================
 699+ 63E3              TownGateAllNastiesDeadCheck:
 700+ 63E3 DD 21 BB 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63E7 06 04            LD B, NUM_NASTIES
 702+ 63E9              .tgandcLoop:
 703+ 63E9 DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 63EC B7               OR A
 705+ 63ED C0               RET NZ                              ; algun nasty aun activo
 706+ 63EE 11 10 00         LD DE, ENT_SIZE
 707+ 63F1 DD 19            ADD IX, DE
 708+ 63F3 10 F4            DJNZ .tgandcLoop
 709+ 63F5 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 63F6 C9               RET
 711+ 63F7
 712+ 63F7              ; ==============================================================================
 713+ 63F7              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63F7              ; ==============================================================================
 715+ 63F7              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63F7              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63F7              ; y abajo se dibujan normal (XOR).
 718+ 63F7              ;
 719+ 63F7              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63F7              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63F7              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63F7              ;   inferiores que pasan tras el lintel skipped.
 723+ 63F7              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63F7              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63F7              ;   lintel skipped.
 726+ 63F7              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63F7              ;
 728+ 63F7              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63F7              ;     Bank 6 paginado al entrar (caller).
 730+ 63F7              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63F7              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63F7              ; ==============================================================================
 733+ 63F7              PLAYER_H_PX              EQU 21
 734+ 63F7
 735+ 63F7              TownGatePlayerXOR_BiClip:
 736+ 63F7 FD 23            INC IY
 737+ 63F9 FD 23            INC IY                              ; skip header
 738+ 63FB D5               PUSH DE
 739+ 63FC CD A6 A0         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 63FF D1               POP DE
 741+ 6400 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 6402 4A               LD C, D                             ; C = current pixel Y
 743+ 6403              .tgpxbcRow:
 744+ 6403 79               LD A, C
 745+ 6404 FE C0            CP 192
 746+ 6406 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 6408                                                      ; (sin este clip, NextPixelLine lleva
 748+ 6408                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 6408                                                      ; corrompe attrs como flashes raros).
 750+ 6408 FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 640A 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 640C FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 640E 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 6410                  ; In [120, 151] → skip pixels en esta row
 755+ 6410 18 0C            JR .tgpxbcAdvance
 756+ 6412              .tgpxbcDraw:
 757+ 6412                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 6412                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 6412 FD 7E 00         LD A, (IY+0)
 760+ 6415 AE               XOR (HL)
 761+ 6416 77               LD (HL), A
 762+ 6417 23               INC HL
 763+ 6418 FD 7E 01         LD A, (IY+1)
 764+ 641B AE               XOR (HL)
 765+ 641C 77               LD (HL), A
 766+ 641D 2B               DEC HL                              ; back to row start
 767+ 641E              .tgpxbcAdvance:
 768+ 641E FD 23            INC IY
 769+ 6420 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 6422 0C               INC C                               ; pixel Y += 1
 771+ 6423 C5               PUSH BC
 772+ 6424 CD 12 9E         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 6427 C1               POP BC
 774+ 6428 10 D9            DJNZ .tgpxbcRow
 775+ 642A C9               RET
 776+ 642B
 777+ 642B              ; ==============================================================================
 778+ 642B              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 642B              ; ==============================================================================
 780+ 642B              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 642B              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 642B              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 642B              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 642B              ; ==============================================================================
 785+ 642B              TownGatePlayerSlideErase:
 786+ 642B DD 21 4B 81      LD IX, EntityTable
 787+ 642F DD E5            PUSH IX
 788+ 6431 CD 2E A8         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6434 DD E1            POP IX
 790+ 6436 3A E8 90         LD A, (CurrentPaging)
 791+ 6439 E6 F8            AND $F8
 792+ 643B F6 06            OR 6
 793+ 643D 32 E8 90         LD (CurrentPaging), A
 794+ 6440 01 FD 7F         LD BC, $7FFD
 795+ 6443 ED 79            OUT (C), A
 796+ 6445 FD 2A B6 A7      LD IY, (OldSprAddr)
 797+ 6449 DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 644C DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 644F 5F               LD E, A
 800+ 6450 CD F7 63         CALL TownGatePlayerXOR_BiClip
 801+ 6453 3A E8 90         LD A, (CurrentPaging)
 802+ 6456 E6 F8            AND $F8
 803+ 6458 32 E8 90         LD (CurrentPaging), A
 804+ 645B 01 FD 7F         LD BC, $7FFD
 805+ 645E ED 79            OUT (C), A
 806+ 6460 C9               RET
 807+ 6461
 808+ 6461              TownGatePlayerSlideDraw:
 809+ 6461 DD 21 4B 81      LD IX, EntityTable
 810+ 6465 DD E5            PUSH IX
 811+ 6467 CD FD A7         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 646A DD E1            POP IX
 813+ 646C 3A E8 90         LD A, (CurrentPaging)
 814+ 646F E6 F8            AND $F8
 815+ 6471 F6 06            OR 6
 816+ 6473 32 E8 90         LD (CurrentPaging), A
 817+ 6476 01 FD 7F         LD BC, $7FFD
 818+ 6479 ED 79            OUT (C), A
 819+ 647B FD 2A 2C A8      LD IY, (SpriteAddrTemp)
 820+ 647F 3A 82 82         LD A, (PlayerDrawY)
 821+ 6482 57               LD D, A
 822+ 6483 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 6486 5F               LD E, A
 824+ 6487 CD F7 63         CALL TownGatePlayerXOR_BiClip
 825+ 648A 3A E8 90         LD A, (CurrentPaging)
 826+ 648D E6 F8            AND $F8
 827+ 648F 32 E8 90         LD (CurrentPaging), A
 828+ 6492 01 FD 7F         LD BC, $7FFD
 829+ 6495 ED 79            OUT (C), A
 830+ 6497                  ; Update OLD = current
 831+ 6497 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 649A DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 649D 3A 82 82         LD A, (PlayerDrawY)
 834+ 64A0 DD 77 0D         LD (IX+ENT_OLDY), A
 835+ 64A3 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 836+ 64A6 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 837+ 64A9 C9               RET
 838+ 64AA
 839+ 64AA              ; ==============================================================================
 840+ 64AA              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 64AA              ; ==============================================================================
 842+ 64AA              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 64AA              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 64AA              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 64AA              ; 2. Compute new offset random.
 846+ 64AA              ; 3. Draw at new offset.
 847+ 64AA              ; Destruye: AF, BC, DE, HL, IX.
 848+ 64AA              ; ==============================================================================
 849+ 64AA              TownGateShakeStep:
 850+ 64AA CD F2 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 64AD CD 0D 65         CALL TownGateDrawFingerShifted
 852+ 64B0                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 64B0 ED 5F            LD A, R
 854+ 64B2 E6 03            AND $03
 855+ 64B4 21 D5 64         LD HL, .tgssJitterTable
 856+ 64B7 5F               LD E, A
 857+ 64B8 16 00            LD D, 0
 858+ 64BA 19               ADD HL, DE
 859+ 64BB 7E               LD A, (HL)
 860+ 64BC 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 64BF 3A 48 81         LD A, (GameFrameCounter)
 862+ 64C2 E6 03            AND $03
 863+ 64C4 21 D5 64         LD HL, .tgssJitterTable
 864+ 64C7 5F               LD E, A
 865+ 64C8 16 00            LD D, 0
 866+ 64CA 19               ADD HL, DE
 867+ 64CB 7E               LD A, (HL)
 868+ 64CC 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 64CF CD F2 64         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 64D2 C3 0D 65         JP TownGateDrawFingerShifted
 871+ 64D5              .tgssJitterTable:
 872+ 64D5 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 64D9
 874+ 64D9              ; ==============================================================================
 875+ 64D9              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 64D9              ; ==============================================================================
 877+ 64D9              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 64D9              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 64D9              ; ==============================================================================
 880+ 64D9              TownGateShakeRestore:
 881+ 64D9 CD F2 64         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 64DC CD 0D 65         CALL TownGateDrawFingerShifted
 883+ 64DF AF               XOR A
 884+ 64E0 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 64E3 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 64E6 11 D4 E5         LD DE, BgGfx_arm
 887+ 64E9 CD 9A DA         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 64EC 11 21 E6         LD DE, BgGfx_finger
 889+ 64EF C3 9A DA         JP RedrawPickupByPtr
 890+ 64F2
 891+ 64F2              ; ==============================================================================
 892+ 64F2              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 64F2              ; ==============================================================================
 894+ 64F2              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 64F2              ; Destruye: AF, BC, DE, HL, IX.
 896+ 64F2              ; ==============================================================================
 897+ 64F2              TownGateDrawArmShifted:
 898+ 64F2 21 D4 E5         LD HL, BgGfx_arm
 899+ 64F5 3E 03            LD A, 3
 900+ 64F7 CD 8F 6A         CALL LoadBgSpriteToBuffer
 901+ 64FA 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 64FD 47               LD B, A
 903+ 64FE 3E 88            LD A, TGCS_ARM_PX_X
 904+ 6500 80               ADD A, B
 905+ 6501 5F               LD E, A
 906+ 6502 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 6505 47               LD B, A
 908+ 6506 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 6508 80               ADD A, B
 910+ 6509 57               LD D, A
 911+ 650A C3 28 65         JP DrawBgSpriteAnyXorAtPixel
 912+ 650D
 913+ 650D              ; ==============================================================================
 914+ 650D              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 650D              ; ==============================================================================
 916+ 650D              TownGateDrawFingerShifted:
 917+ 650D 21 21 E6         LD HL, BgGfx_finger
 918+ 6510 3E 03            LD A, 3
 919+ 6512 CD 8F 6A         CALL LoadBgSpriteToBuffer
 920+ 6515 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 6518 47               LD B, A
 922+ 6519 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 651B 80               ADD A, B
 924+ 651C 5F               LD E, A
 925+ 651D 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 6520 47               LD B, A
 927+ 6521 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 6523 80               ADD A, B
 929+ 6524 57               LD D, A
 930+ 6525 C3 28 65         JP DrawBgSpriteAnyXorAtPixel
 931+ 6528
 932+ 6528              ; ==============================================================================
 933+ 6528              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 6528              ; ==============================================================================
 935+ 6528              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 6528              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 6528              ;     E = pixel X (0..255).
 938+ 6528              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 6528              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 6528              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 6528              ; Destruye: AF, BC, DE, HL, IX.
 942+ 6528              ; ==============================================================================
 943+ 6528              DrawBgSpriteAnyXorAtPixel:
 944+ 6528 DD 21 9B 89      LD IX, BgSpriteBuffer
 945+ 652C DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 652F B7               OR A
 947+ 6530 C8               RET Z
 948+ 6531 32 8B 65         LD (.dbsaHeight), A
 949+ 6534 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 6537 E6 7F            AND $7F
 951+ 6539 32 8C 65         LD (.dbsaWidth), A
 952+ 653C DD 23            INC IX
 953+ 653E DD 23            INC IX                              ; -> pixel data
 954+ 6540 7B               LD A, E
 955+ 6541 E6 07            AND $07
 956+ 6543 32 8D 65         LD (.dbsaShift), A
 957+ 6546 7B               LD A, E
 958+ 6547 E6 F8            AND $F8
 959+ 6549 5F               LD E, A
 960+ 654A CD A6 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 654D              .dbsaRow:
 962+ 654D E5               PUSH HL
 963+ 654E 3A 8C 65         LD A, (.dbsaWidth)
 964+ 6551 47               LD B, A                             ; B = width counter
 965+ 6552 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 6554              .dbsaByte:
 967+ 6554 DD 7E 00         LD A, (IX+0)
 968+ 6557 2F               CPL                                 ; un-invert
 969+ 6558 57               LD D, A                             ; D = sprite byte
 970+ 6559 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 655B 3A 8D 65         LD A, (.dbsaShift)
 972+ 655E B7               OR A
 973+ 655F 28 09            JR Z, .dbsaNoShift
 974+ 6561 C5               PUSH BC
 975+ 6562 47               LD B, A
 976+ 6563              .dbsaShiftLoop:
 977+ 6563 CB 3A            SRL D
 978+ 6565 CB 1B            RR E
 979+ 6567 10 FA            DJNZ .dbsaShiftLoop
 980+ 6569 C1               POP BC
 981+ 656A              .dbsaNoShift:
 982+ 656A 7A               LD A, D
 983+ 656B B1               OR C                                ; combinar con carry previo
 984+ 656C AE               XOR (HL)
 985+ 656D 77               LD (HL), A
 986+ 656E 23               INC HL
 987+ 656F 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 6570 DD 23            INC IX
 989+ 6572 10 E0            DJNZ .dbsaByte
 990+ 6574                  ; Byte final (carry) si shift > 0
 991+ 6574 3A 8D 65         LD A, (.dbsaShift)
 992+ 6577 B7               OR A
 993+ 6578 28 03            JR Z, .dbsaNoFinal
 994+ 657A 79               LD A, C
 995+ 657B AE               XOR (HL)
 996+ 657C 77               LD (HL), A
 997+ 657D              .dbsaNoFinal:
 998+ 657D E1               POP HL
 999+ 657E CD 12 9E         CALL NextPixelLine
1000+ 6581 3A 8B 65         LD A, (.dbsaHeight)
1001+ 6584 3D               DEC A
1002+ 6585 32 8B 65         LD (.dbsaHeight), A
1003+ 6588 20 C3            JR NZ, .dbsaRow
1004+ 658A C9               RET
1005+ 658B 00           .dbsaHeight: DEFB 0
1006+ 658C 00           .dbsaWidth:  DEFB 0
1007+ 658D 00           .dbsaShift:  DEFB 0
1008+ 658E
1009+ 658E              ; ==============================================================================
1010+ 658E              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 658E              ; ==============================================================================
1012+ 658E              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 658E              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 658E              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 658E              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 658E              ; ==============================================================================
1017+ 658E              TownGateExitStep:
1018+ 658E 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 6591 3C               INC A
1020+ 6592 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 6595 FE 02            CP TGCS_T_EXIT_STEP
1022+ 6597 D8               RET C                               ; aun no toca step
1023+ 6598 AF               XOR A
1024+ 6599 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 659C                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 659C DD 21 4B 81      LD IX, EntityTable
1027+ 65A0 DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 65A3 3C               INC A
1029+ 65A4 DD 77 04         LD (IX+ENT_POSY), A
1030+ 65A7 32 82 82         LD (PlayerDrawY), A
1031+ 65AA 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 65AD EE 01            XOR 1                               ; toggle 0/1
1033+ 65AF 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 65B2 47               LD B, A
1035+ 65B3 3E 0E            LD A, SPRID_WALK_S
1036+ 65B5 80               ADD A, B
1037+ 65B6 DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 65B9                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 65B9                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 65B9                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 65B9                  ; part1 attrs ni de door attrs.
1042+ 65B9 CD 2B 64         CALL TownGatePlayerSlideErase
1043+ 65BC C3 61 64         JP TownGatePlayerSlideDraw          ; tail call
1044+ 65BF
1045+ 65BF              ; ==============================================================================
1046+ 65BF              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
1047+ 65BF              ; ==============================================================================
1048+ 65BF              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
1049+ 65BF              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1050+ 65BF              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1051+ 65BF              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1052+ 65BF              ; Destruye: AF, BC, DE, HL, IX.
1053+ 65BF              ; ==============================================================================
1054+ 65BF              TownGateDrawTheEnd:
1055+ 65BF 21 2F E6         LD HL, BgGfx_the_end
1056+ 65C2 3E 03            LD A, 3
1057+ 65C4 CD 8F 6A         CALL LoadBgSpriteToBuffer
1058+ 65C7 DD 21 9B 89      LD IX, BgSpriteBuffer
1059+ 65CB 06 0B            LD B, TGCS_END_CHARX
1060+ 65CD 0E 04            LD C, TGCS_END_CHARY
1061+ 65CF AF               XOR A
1062+ 65D0 32 52 E5         LD (BgSpriteIsHouse), A
1063+ 65D3 32 43 D5         LD (CurrentTintVar), A              ; sin tint
1064+ 65D6 C3 39 D4         JP DrawBgGfxSprite
1065+ 65D9
1066+ 65D9              ; ==============================================================================
1067+ 65D9              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1068+ 65D9              ; ==============================================================================
1069+ 65D9              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1070+ 65D9              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1071+ 65D9              ; quedara visible sobre fondo negro.
1072+ 65D9              ; ==============================================================================
