4383+ B6FE              ; ==============================================================================
4384+ B6FE              ; CountActiveNasties / CountActiveMonsters
4385+ B6FE              ; ==============================================================================
4386+ B6FE              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4387+ B6FE              ; Ambas usan _CountSlots internamente.
4388+ B6FE              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4389+ B6FE              ; ==============================================================================
4390+ B6FE              CountActiveNasties:
4391+ B6FE 21 0F 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4392+ B701 06 04            LD B, NUM_NASTIES
4393+ B703 18 05            JR _CountSlots
4394+ B705
4395+ B705              CountActiveMonsters:
4396+ B705 21 AF 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4397+ B708 06 06            LD B, NUM_MONSTERS
4398+ B70A
4399+ B70A              _CountSlots:
4400+ B70A 0E 00            LD C, 0                         ; Contador
4401+ B70C              .countLoop:
4402+ B70C 7E               LD A, (HL)
4403+ B70D B7               OR A
4404+ B70E 28 16            JR Z, .countNext                ; Slot vacio: no contar
4405+ B710                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4406+ B710 D5               PUSH DE
4407+ B711 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4408+ B714 19               ADD HL, DE
4409+ B715 7E               LD A, (HL)
4410+ B716 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4411+ B718 D1               POP DE
4412+ B719 FE 03            CP STATE_DYING
4413+ B71B 28 09            JR Z, .countNext
4414+ B71D FE 04            CP STATE_SPAWNING
4415+ B71F 28 05            JR Z, .countNext
4416+ B721 FE 05            CP STATE_SCARED
4417+ B723 28 01            JR Z, .countNext
4418+ B725 0C               INC C
4419+ B726              .countNext:
4420+ B726 11 10 00         LD DE, ENT_SIZE
4421+ B729 19               ADD HL, DE
4422+ B72A 10 E0            DJNZ .countLoop
4423+ B72C 79               LD A, C
4424+ B72D C9               RET
