 549+ E7F7              .pixLoop:
 550+ E7F7 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 551+ E7F8 B7               OR A
 552+ E7F9 C8               RET Z
 553+ E7FA 57               LD D, A
 554+ E7FB 23               INC HL
 555+ E7FC 7E               LD A, (HL)          ; VRAM L
 556+ E7FD 23               INC HL
 557+ E7FE 5F               LD E, A
 558+ E7FF 7E               LD A, (HL)          ; mask
 559+ E800 23               INC HL
 560+ E801 E5               PUSH HL
 561+ E802 2F               CPL                 ; ~mask
 562+ E803 62               LD H, D
 563+ E804 6B               LD L, E
 564+ E805 A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 565+ E806 77               LD (HL), A
 566+ E807 E1               POP HL
 567+ E808 18 ED            JR .pixLoop
