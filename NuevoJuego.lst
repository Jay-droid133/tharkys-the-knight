 735+ F1A5 23               INC HL
 736+ F1A6 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 737+ F1A7 CD CC F1         CALL DrawCompassSprite
 738+ F1AA
 739+ F1AA                  ; --- Attrs ---
 740+ F1AA 3A CB F1         LD A, (.dcAttr)
 741+ F1AD CD EF F1         CALL SetCompassAttrs
 742+ F1B0
 743+ F1B0              .dcDrawDone:
 744+ F1B0
 745+ F1B0                  ; --- Cachear estado ---
 746+ F1B0                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 747+ F1B0                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 748+ F1B0                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 749+ F1B0                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 750+ F1B0                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 751+ F1B0                  ; el wobble y la comparacion sigue siendo correcta.
 752+ F1B0 3A C0 82         LD A, (CompassWobbleCounter)
 753+ F1B3 B7               OR A
 754+ F1B4 20 06            JR NZ, .dcSkipPrevDistSave
 755+ F1B6 3A CA F1         LD A, (.dcDistance)
 756+ F1B9 32 BD 82         LD (PreviousObjectiveDistance), A
 757+ F1BC              .dcSkipPrevDistSave:
 758+ F1BC 3A 0B 83         LD A, (CurrentScreenX)
 759+ F1BF 32 BE 82         LD (LastCompassScreenX), A
 760+ F1C2 3A 0C 83         LD A, (CurrentScreenY)
 761+ F1C5 32 BF 82         LD (LastCompassScreenY), A
 762+ F1C8 C9               RET
 763+ F1C9
 764+ F1C9 00           .dcSpriteIdx: DEFB 0
 765+ F1CA 00           .dcDistance:  DEFB 0
 766+ F1CB 00           .dcAttr:      DEFB 0
 767+ F1CC
 768+ F1CC              ; ==============================================================================
 769+ F1CC              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 770+ F1CC              ; ==============================================================================
 771+ F1CC              ; IN: DE = ptr a 16 filas x 2 bytes
 772+ F1CC              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 773+ F1CC              ; Destruye: AF, B, HL.
 774+ F1CC              ; ==============================================================================
 775+ F1CC              DrawCompassSprite:
 776+ F1CC                  ; Char row 0 (rows 0-7 del sprite)
 777+ F1CC 26 40            LD H, $40
 778+ F1CE 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 779+ F1D0 06 08            LD B, 8
 780+ F1D2              .dcsRow0:
 781+ F1D2 1A               LD A, (DE)
 782+ F1D3 77               LD (HL), A
 783+ F1D4 13               INC DE
 784+ F1D5 23               INC HL
 785+ F1D6 1A               LD A, (DE)
 786+ F1D7 77               LD (HL), A
 787+ F1D8 13               INC DE
 788+ F1D9 2B               DEC HL
 789+ F1DA 24               INC H
 790+ F1DB 10 F5            DJNZ .dcsRow0
 791+ F1DD                  ; Char row 1 (rows 8-15 del sprite)
 792+ F1DD 26 40            LD H, $40
 793+ F1DF 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 794+ F1E1 06 08            LD B, 8
 795+ F1E3              .dcsRow1:
 796+ F1E3 1A               LD A, (DE)
 797+ F1E4 77               LD (HL), A
 798+ F1E5 13               INC DE
 799+ F1E6 23               INC HL
 800+ F1E7 1A               LD A, (DE)
 801+ F1E8 77               LD (HL), A
 802+ F1E9 13               INC DE
 803+ F1EA 2B               DEC HL
 804+ F1EB 24               INC H
 805+ F1EC 10 F5            DJNZ .dcsRow1
 806+ F1EE C9               RET
 807+ F1EF
 808+ F1EF              ; ==============================================================================
 809+ F1EF              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 810+ F1EF              ; ==============================================================================
 811+ F1EF              SetCompassAttrs:
 812+ F1EF 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 813+ F1F2 77               LD (HL), A
 814+ F1F3 23               INC HL
 815+ F1F4 77               LD (HL), A
 816+ F1F5 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F1F8 77               LD (HL), A
 818+ F1F9 23               INC HL
 819+ F1FA 77               LD (HL), A
 820+ F1FB C9               RET
 821+ F1FC
 822+ F1FC              ; ==============================================================================
 823+ F1FC              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 824+ F1FC              ; ==============================================================================
 825+ F1FC              ClearCompass:
 826+ F1FC 26 40            LD H, $40
 827+ F1FE 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 828+ F200 06 08            LD B, 8
 829+ F202 AF               XOR A
 830+ F203              .ccRow0:
 831+ F203 77               LD (HL), A
 832+ F204 23               INC HL
 833+ F205 77               LD (HL), A
 834+ F206 2B               DEC HL
 835+ F207 24               INC H
 836+ F208 10 F9            DJNZ .ccRow0
 837+ F20A 26 40            LD H, $40
 838+ F20C 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 839+ F20E 06 08            LD B, 8
 840+ F210 AF               XOR A
 841+ F211              .ccRow1:
 842+ F211 77               LD (HL), A
 843+ F212 23               INC HL
 844+ F213 77               LD (HL), A
 845+ F214 2B               DEC HL
 846+ F215 24               INC H
 847+ F216 10 F9            DJNZ .ccRow1
 848+ F218 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 849+ F219 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 850+ F21C 77               LD (HL), A
 851+ F21D 23               INC HL
 852+ F21E 77               LD (HL), A
 853+ F21F 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 854+ F222 77               LD (HL), A
 855+ F223 23               INC HL
 856+ F224 77               LD (HL), A
 857+ F225 C9               RET
 858+ F226
 859+ F226              ; ==============================================================================
 860+ F226              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 861+ F226              ; ==============================================================================
 862+ F226              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 863+ F226              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 864+ F226              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 865+ F226              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 866+ F226              ; monstruo cae alli con la puerta abierta:
 867+ F226              ;   - Bit slot en MonsterTrappedFlags
 868+ F226              ;   - Despawn del monstruo (puff)
 869+ F226              ;   - Puerta se re-cierra (sprite + flag)
 870+ F226              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 871+ F226              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 872+ F226              ;
 873+ F226              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 874+ F226              ; auto-generadas por el level editor segun la posicion de la puerta y los
 875+ F226              ; markers AltKey1/AltKey2.
 876+ F226              ; ==============================================================================
 877+ F226
 878+ F226              ; ==============================================================================
 879+ F226              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 880+ F226              ; ==============================================================================
 881+ F226              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 882+ F226              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 883+ F226              ; Destruye: AF, BC.
 884+ F226              ; ==============================================================================
 885+ F226              CheckChurchTrap:
 886+ F226                  ; --- Solo en pantalla de la iglesia ---
 887+ F226 3A 0B 83         LD A, (CurrentScreenX)
 888+ F229 FE 0F            CP CHURCH_TRAP_SCREEN_X
 889+ F22B 20 5D            JR NZ, .cctNoTrap
 890+ F22D 3A 0C 83         LD A, (CurrentScreenY)
 891+ F230 FE 06            CP CHURCH_TRAP_SCREEN_Y
 892+ F232 20 56            JR NZ, .cctNoTrap
 893+ F234                  ; --- Solo con la puerta abierta ---
 894+ F234 3A B4 82         LD A, (ChurchDoorOpen)
 895+ F237 B7               OR A
 896+ F238 28 50            JR Z, .cctNoTrap
 897+ F23A                  ; --- Solo si el knockback es DIRECTO del player ---
 898+ F23A                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 899+ F23A                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 900+ F23A                  ; espada y se clear cuando se hereda kb por colision.
 901+ F23A DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 902+ F23E 28 4A            JR Z, .cctNoTrap
 903+ F240                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 904+ F240                  ; (acepta sprites de 16, 21 o 24 px de alto)
 905+ F240 DD 7E 04         LD A, (IX+ENT_POSY)
 906+ F243 CB 3F            SRL A
 907+ F245 CB 3F            SRL A
 908+ F247 CB 3F            SRL A                                   ; A = top charY del monster
 909+ F249 47               LD B, A
 910+ F24A 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 911+ F24C 90               SUB B                                   ; A = trap_charY - mon_charY
 912+ F24D FE 03            CP 3
 913+ F24F 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 914+ F251                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 915+ F251 DD 7E 03         LD A, (IX+ENT_POSX)
 916+ F254 CB 3F            SRL A
 917+ F256 CB 3F            SRL A
 918+ F258 CB 3F            SRL A
 919+ F25A 47               LD B, A                                 ; B = left charX del monster
 920+ F25B 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 921+ F25D 3C               INC A                                   ; A = LO_X + 1
 922+ F25E 90               SUB B                                   ; A = LO_X+1 - charX
 923+ F25F FE 03            CP 3
 924+ F261 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 925+ F263                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 926+ F263                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 927+ F263 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 928+ F266 D6 4C            SUB SPRID_MONSTER_0
 929+ F268 CB 3F            SRL A
 930+ F26A CB 3F            SRL A
 931+ F26C CB 3F            SRL A                                   ; A = type idx 0..2
 932+ F26E 47               LD B, A
 933+ F26F                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 934+ F26F 3A C2 82         LD A, (NextChurchTrapStep)
 935+ F272 FE 03            CP 3
 936+ F274 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 937+ F276 21 8C F2         LD HL, ChurchTrapOrderTable
 938+ F279 5F               LD E, A
 939+ F27A 16 00            LD D, 0
 940+ F27C 19               ADD HL, DE
 941+ F27D 7E               LD A, (HL)                              ; A = type esperado
 942+ F27E B8               CP B
 943+ F27F 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 944+ F281                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 945+ F281 CD 24 F3         CALL TriggerChurchTrap
 946+ F284 3E 01            LD A, 1
 947+ F286 C9               RET
 948+ F287              .cctBlockAsWall:
 949+ F287                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 950+ F287                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 951+ F287 3E 02            LD A, 2
 952+ F289 C9               RET
 953+ F28A              .cctNoTrap:
 954+ F28A AF               XOR A
 955+ F28B C9               RET
 956+ F28C
 957+ F28C              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 958+ F28C              ChurchTrapOrderTable:
 959+ F28C 00 02 01         DEFB 0, 2, 1
 960+ F28F
 961+ F28F              ; ==============================================================================
 962+ F28F              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 963+ F28F              ; blanco brillante sobre paper negro ($47).
 964+ F28F              ; ==============================================================================
 965+ F28F              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 966+ F28F              ; - No-op fuera de la sala de la iglesia.
 967+ F28F              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 968+ F28F              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 969+ F28F              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 970+ F28F              ;   aun no toca) conservan sus attrs originales del sprite.
 971+ F28F              ; Destruye: AF, BC, DE, HL.
 972+ F28F              ; ==============================================================================
 973+ F28F              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 974+ F28F              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 975+ F28F              HighlightExpectedStatue:
 976+ F28F 3E 47            LD A, $47
 977+ F291 18 00            JR PaintExpectedStatueAttr
 978+ F293
 979+ F293              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 980+ F293              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 981+ F293              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 982+ F293              PaintExpectedStatueAttr:
 983+ F293 32 FD F2         LD (.hesAttr), A
 984+ F296                  ; --- Solo en la sala de la iglesia ---
 985+ F296 3A 0B 83         LD A, (CurrentScreenX)
 986+ F299 FE 0F            CP CHURCH_TRAP_SCREEN_X
 987+ F29B C0               RET NZ
 988+ F29C 3A 0C 83         LD A, (CurrentScreenY)
 989+ F29F FE 06            CP CHURCH_TRAP_SCREEN_Y
 990+ F2A1 C0               RET NZ
 991+ F2A2                  ; --- Solo tras abrir la iglesia 1a vez ---
 992+ F2A2                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 993+ F2A2                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 994+ F2A2                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 995+ F2A2                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 996+ F2A2                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 997+ F2A2 3A B5 82         LD A, (ChurchEverOpened)
 998+ F2A5 B7               OR A
 999+ F2A6 C8               RET Z
1000+ F2A7                  ; --- Solo si quedan monstruos por atrapar ---
1001+ F2A7 3A C2 82         LD A, (NextChurchTrapStep)
1002+ F2AA FE 03            CP 3
1003+ F2AC D0               RET NC
1004+ F2AD                  ; --- Type esperado -> statue id ---
1005+ F2AD 21 8C F2         LD HL, ChurchTrapOrderTable
1006+ F2B0 5F               LD E, A
1007+ F2B1 16 00            LD D, 0
1008+ F2B3 19               ADD HL, DE
1009+ F2B4 7E               LD A, (HL)                              ; type idx esperado
1010+ F2B5 21 A9 69         LD HL, StatueIdTable
1011+ F2B8 5F               LD E, A
1012+ F2B9 16 00            LD D, 0
1013+ F2BB 19               ADD HL, DE
1014+ F2BC 7E               LD A, (HL)                              ; A = statue id
1015+ F2BD B7               OR A
1016+ F2BE C8               RET Z
1017+ F2BF 32 FE F2         LD (.hesTargetId), A
1018+ F2C2                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1019+ F2C2 2A 0D 83         LD HL, (CurrentScreenAddr)
1020+ F2C5              .hesLoop:
1021+ F2C5 7E               LD A, (HL)
1022+ F2C6 FE FF            CP $FF
1023+ F2C8 C8               RET Z                                   ; estatua no en esta sala
1024+ F2C9 47               LD B, A
1025+ F2CA 3A FE F2         LD A, (.hesTargetId)
1026+ F2CD B8               CP B
1027+ F2CE 28 06            JR Z, .hesFound
1028+ F2D0 11 04 00         LD DE, 4
1029+ F2D3 19               ADD HL, DE
1030+ F2D4 18 EF            JR .hesLoop
1031+ F2D6              .hesFound:
1032+ F2D6 23               INC HL
1033+ F2D7 7E               LD A, (HL)                              ; charX
1034+ F2D8 47               LD B, A
1035+ F2D9 23               INC HL
1036+ F2DA 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1037+ F2DB C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1038+ F2DD 4F               LD C, A                                 ; C = charY (post-HUD)
1039+ F2DE                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1040+ F2DE 26 00            LD H, 0
1041+ F2E0 69               LD L, C
1042+ F2E1 29               ADD HL, HL
1043+ F2E2 29               ADD HL, HL
1044+ F2E3 29               ADD HL, HL
1045+ F2E4 29               ADD HL, HL
1046+ F2E5 29               ADD HL, HL                              ; HL = charY * 32
1047+ F2E6 58               LD E, B
1048+ F2E7 16 00            LD D, 0
1049+ F2E9 19               ADD HL, DE                              ; + charX
1050+ F2EA 11 00 58         LD DE, $5800
1051+ F2ED 19               ADD HL, DE                              ; HL = attr addr top-left
1052+ F2EE                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1053+ F2EE                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1054+ F2EE                  ; no hace falta sincronizar CleanAttrMap.
1055+ F2EE 3A FD F2         LD A, (.hesAttr)
1056+ F2F1 06 03            LD B, 3                                 ; 3 filas de chars
1057+ F2F3              .hesRow:
1058+ F2F3 77               LD (HL), A
1059+ F2F4 23               INC HL
1060+ F2F5 77               LD (HL), A                              ; (charX+1)
1061+ F2F6 11 1F 00         LD DE, 31
1062+ F2F9 19               ADD HL, DE                              ; siguiente fila col 0
1063+ F2FA 10 F7            DJNZ .hesRow
1064+ F2FC C9               RET
1065+ F2FD 00           .hesAttr:     DEFB 0
1066+ F2FE 00           .hesTargetId: DEFB 0
1067+ F2FF
1068+ F2FF              ; ==============================================================================
1069+ F2FF              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1070+ F2FF              ; ==============================================================================
1071+ F2FF              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1072+ F2FF              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1073+ F2FF              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1074+ F2FF              ; + ON final settle): 8 ciclos de ON-OFF en total.
1075+ F2FF              ; ==============================================================================
1076+ F2FF              STATUE_BLINK_FRAMES   EQU 32
1077+ F2FF
1078+ F2FF              StartStatueBlink:
1079+ F2FF                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1080+ F2FF                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1081+ F2FF                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1082+ F2FF                  ; (caso A), .cbtActChurchDoor (caso B).
1083+ F2FF 3E 20            LD A, STATUE_BLINK_FRAMES
1084+ F301 32 C3 82         LD (StatueBlinkCounter), A
1085+ F304 C3 8F F2         JP HighlightExpectedStatue              ; initial ON paint
1086+ F307
1087+ F307              UpdateStatueBlink:
1088+ F307                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1089+ F307 3A C3 82         LD A, (StatueBlinkCounter)
1090+ F30A B7               OR A
1091+ F30B C8               RET Z
1092+ F30C 3D               DEC A
1093+ F30D 32 C3 82         LD (StatueBlinkCounter), A
1094+ F310 20 03            JR NZ, .usbInProgress
1095+ F312                  ; Counter recien llego a 0: settle ON
1096+ F312 C3 8F F2         JP HighlightExpectedStatue
1097+ F315              .usbInProgress:
1098+ F315                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1099+ F315                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1100+ F315 CB 3F            SRL A
1101+ F317 E6 01            AND $01
1102+ F319 28 05            JR Z, .usbOff
1103+ F31B 3E 47            LD A, $47
1104+ F31D C3 93 F2         JP PaintExpectedStatueAttr
1105+ F320              .usbOff:
1106+ F320 AF               XOR A
1107+ F321 C3 93 F2         JP PaintExpectedStatueAttr
1108+ F324
1109+ F324              ; ==============================================================================
1110+ F324              ; CUTSCENE - parametros ajustables
1111+ F324              ; ==============================================================================
1112+ F324              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1113+ F324              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1114+ F324              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1115+ F324              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1116+ F324
1117+ F324              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1118+ F324              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1119+ F324              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1120+ F324
1121+ F324              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1122+ F324              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1123+ F324              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1124+ F324              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1125+ F324              ;   tick 12 -> erase smoke[2], pasar a DONE
1126+ F324              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1127+ F324              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1128+ F324
1129+ F324              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1130+ F324              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1131+ F324              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1132+ F324              ; centrado dentro del vano de la puerta.
1133+ F324              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1134+ F324              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1135+ F324              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1136+ F324              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1137+ F324
1138+ F324              ; ==============================================================================
1139+ F324              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1140+ F324              ; ==============================================================================
1141+ F324              ; IN: IX = monster atrapado.
1142+ F324              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1143+ F324              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1144+ F324              ; en ApplyChurchTrapEffects al final del cutscene.
1145+ F324              ; ==============================================================================
1146+ F324              TriggerChurchTrap:
1147+ F324                  ; --- 1. Calcular slot 0..2 ---
1148+ F324 DD E5            PUSH IX
1149+ F326 E1               POP HL
1150+ F327 11 AE 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1151+ F32A B7               OR A
1152+ F32B ED 52            SBC HL, DE
1153+ F32D CB 3D            SRL L
1154+ F32F CB 3D            SRL L
1155+ F331 CB 3D            SRL L
1156+ F333 CB 3D            SRL L                                   ; L = slot 0..2
1157+ F335 7D               LD A, L
1158+ F336 32 9E 5F         LD (ChurchCutsceneSlot), A
1159+ F339                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1160+ F339 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1161+ F33C D6 4C            SUB SPRID_MONSTER_0
1162+ F33E CB 3F            SRL A
1163+ F340 CB 3F            SRL A
1164+ F342 CB 3F            SRL A                                   ; A = type idx
1165+ F344 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1166+ F347                  ; --- 2. Mover monster al centro del vano ---
1167+ F347 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1168+ F349 DD 77 03         LD (IX+ENT_POSX), A
1169+ F34C 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1170+ F34E DD 77 04         LD (IX+ENT_POSY), A
1171+ F351 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1172+ F355 DD 36 07 00      LD (IX+ENT_DELTAY), 0
1173+ F359 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1174+ F35D                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1175+ F35D                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1176+ F35D                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1177+ F35D                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1178+ F35D                  ; temblor se vea con ink blanco brillante sobre paper negro.
1179+ F35D AF               XOR A
1180+ F35E 32 C3 82         LD (StatueBlinkCounter), A              ; parar blink
1181+ F361 DD E5            PUSH IX
