 383+ 6832              ; ==============================================================================
 384+ 6832              ; DrawRemainsForType - dibuja los restos del tipo de monstruo en la base de
 385+ 6832              ; su estatua (charY + 2). Localiza la estatua en CurrentScreenBuffer.
 386+ 6832              ; ==============================================================================
 387+ 6832              ; IN:  A = type idx (0..2)
 388+ 6832              ; OUT: -
 389+ 6832              ; Destruye: AF, BC, DE, HL, IX.
 390+ 6832              ; Si el tipo no tiene estatua en la pantalla actual, retorna sin dibujar.
 391+ 6832              ; ==============================================================================
 392+ 6832              DrawRemainsForType:
 393+ 6832 32 6B 68         LD (.drftType), A
 394+ 6835                  ; Lookup statue id por tipo
 395+ 6835 21 07 67         LD HL, StatueIdTable
 396+ 6838 5F               LD E, A
 397+ 6839 16 00            LD D, 0
 398+ 683B 19               ADD HL, DE
 399+ 683C 7E               LD A, (HL)                              ; A = statue id
 400+ 683D B7               OR A
 401+ 683E C8               RET Z                                   ; sin estatua exportada
 402+ 683F 32 6C 68         LD (.drftStatueId), A
 403+ 6842                  ; Scan CurrentScreenBuffer para encontrar la estatua (formato 4B)
 404+ 6842 2A 0A 82         LD HL, (CurrentScreenAddr)
 405+ 6845              .drftLoop:
 406+ 6845 7E               LD A, (HL)
 407+ 6846 FE FF            CP $FF
 408+ 6848 C8               RET Z                                   ; estatua no esta en esta sala
 409+ 6849 47               LD B, A                                 ; B = current id
 410+ 684A 3A 6C 68         LD A, (.drftStatueId)
 411+ 684D B8               CP B
 412+ 684E 28 06            JR Z, .drftFound
 413+ 6850 11 04 00         LD DE, 4
 414+ 6853 19               ADD HL, DE
 415+ 6854 18 EF            JR .drftLoop
 416+ 6856              .drftFound:
 417+ 6856                  ; HL apunta al id, +1=charX, +2=charY, +3=variant
 418+ 6856 23               INC HL
 419+ 6857 46               LD B, (HL)                              ; B = charX
 420+ 6858 23               INC HL
 421+ 6859 7E               LD A, (HL)
 422+ 685A C6 02            ADD A, 2                                ; charY + 2 (base de la estatua)
 423+ 685C 4F               LD C, A
 424+ 685D                  ; Lookup remains id por tipo
 425+ 685D 3A 6B 68         LD A, (.drftType)
 426+ 6860 21 0D 67         LD HL, RemainsIdTable
 427+ 6863 5F               LD E, A
 428+ 6864 16 00            LD D, 0
 429+ 6866 19               ADD HL, DE
 430+ 6867 7E               LD A, (HL)
 431+ 6868 C3 6D 68         JP DrawBgSpriteByIdAtChar               ; tail call (no-op si id 0)
 432+ 686B 00           .drftType:     DEFB 0
 433+ 686C 00           .drftStatueId: DEFB 0
 434+ 686D
 435+ 686D              ; ==============================================================================
 436+ 686D              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 437+ 686D              ; ==============================================================================
 438+ 686D              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 439+ 686D              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 440+ 686D              ; OUT: -
 441+ 686D              ; Destruye: AF, BC, DE, HL, IX.
 442+ 686D              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 443+ 686D              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 444+ 686D              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 445+ 686D              ; ==============================================================================
 446+ 686D              DrawBgSpriteByIdAtChar:
 447+ 686D B7               OR A
 448+ 686E C8               RET Z                                   ; id 0 = no sprite, salir
 449+ 686F C5               PUSH BC
 450+ 6870 6F               LD L, A
 451+ 6871 26 00            LD H, 0
 452+ 6873 54               LD D, H
 453+ 6874 5D               LD E, L                                 ; DE = id
 454+ 6875 29               ADD HL, HL                              ; *2
 455+ 6876 19               ADD HL, DE                              ; *3
 456+ 6877 11 7E DA         LD DE, BgGfxPtrById
 457+ 687A 19               ADD HL, DE
 458+ 687B 5E               LD E, (HL)
 459+ 687C 23               INC HL
 460+ 687D 56               LD D, (HL)                              ; DE = ptr
 461+ 687E 23               INC HL
 462+ 687F 7E               LD A, (HL)                              ; A = bank
 463+ 6880 32 87 CE         LD (CurrentBgSpriteBank), A
 464+ 6883 EB               EX DE, HL                               ; HL = ptr
 465+ 6884 CD BD 90         CALL LoadBgSpriteToBuffer               ; preserva BC
 466+ 6887 DD 21 F5 88      LD IX, BgSpriteBuffer
 467+ 688B C1               POP BC
 468+ 688C C3 7B CD         JP DrawBgGfxSprite                      ; tail call
 469+ 688F
 470+ 688F              ; ==============================================================================
 471+ 688F              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 472+ 688F              ; ==============================================================================
 473+ 688F              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 474+ 688F              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 475+ 688F              ;
 476+ 688F              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 477+ 688F              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 478+ 688F              ;     E = pixel X (0-255).
 479+ 688F              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 480+ 688F              ; Solo XOR de pixels (no toca attrs).
 481+ 688F              ; Destruye: AF, BC, DE, HL, IX.
 482+ 688F              ; ==============================================================================
 483+ 688F              DrawBgSprite16XorAtPixel:
 484+ 688F DD 21 F5 88      LD IX, BgSpriteBuffer
 485+ 6893 DD 7E 00         LD A, (IX+0)                            ; height_px
 486+ 6896 B7               OR A
 487+ 6897 C8               RET Z
 488+ 6898 32 FB 68         LD (.dbsHeight), A
 489+ 689B DD 23            INC IX
 490+ 689D DD 23            INC IX                                  ; -> pixel data
 491+ 689F                  ; Shift = E & 7 ; aligned X = E & ~7
 492+ 689F 7B               LD A, E
 493+ 68A0 E6 07            AND $07
 494+ 68A2 32 FC 68         LD (.dbsShift), A
 495+ 68A5 7B               LD A, E
 496+ 68A6 E6 F8            AND $F8
 497+ 68A8 5F               LD E, A
 498+ 68A9 CD 1C A1         CALL CalcPixelAddr                      ; HL = VRAM addr
 499+ 68AC              .dbsRow:
 500+ 68AC E5               PUSH HL                                 ; save row start
 501+ 68AD                  ; --- Byte 0 del sprite ---
 502+ 68AD DD 7E 00         LD A, (IX+0)
 503+ 68B0 2F               CPL                                     ; un-invert
 504+ 68B1 57               LD D, A                                 ; D = sprite byte
 505+ 68B2 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 506+ 68B4 3A FC 68         LD A, (.dbsShift)
 507+ 68B7 B7               OR A
 508+ 68B8 28 07            JR Z, .dbsNoShift0
 509+ 68BA 47               LD B, A
 510+ 68BB              .dbsShift0Loop:
 511+ 68BB CB 3A            SRL D
 512+ 68BD CB 1B            RR E
 513+ 68BF 10 FA            DJNZ .dbsShift0Loop
 514+ 68C1              .dbsNoShift0:
 515+ 68C1 7A               LD A, D
 516+ 68C2 AE               XOR (HL)
 517+ 68C3 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 518+ 68C4 23               INC HL
 519+ 68C5 4B               LD C, E                                 ; C = carry para siguiente byte
 520+ 68C6                  ; --- Byte 1 del sprite ---
 521+ 68C6 DD 7E 01         LD A, (IX+1)
 522+ 68C9 2F               CPL
 523+ 68CA 57               LD D, A
 524+ 68CB 1E 00            LD E, 0
 525+ 68CD 3A FC 68         LD A, (.dbsShift)
 526+ 68D0 B7               OR A
 527+ 68D1 28 07            JR Z, .dbsNoShift1
 528+ 68D3 47               LD B, A
 529+ 68D4              .dbsShift1Loop:
 530+ 68D4 CB 3A            SRL D
 531+ 68D6 CB 1B            RR E
 532+ 68D8 10 FA            DJNZ .dbsShift1Loop
 533+ 68DA              .dbsNoShift1:
 534+ 68DA 7A               LD A, D
 535+ 68DB B1               OR C                                    ; combinar con carry de byte 0
 536+ 68DC AE               XOR (HL)
 537+ 68DD 77               LD (HL), A
 538+ 68DE 23               INC HL
 539+ 68DF 4B               LD C, E                                 ; carry para byte final
 540+ 68E0                  ; --- Byte final (solo si shift>0) ---
 541+ 68E0 3A FC 68         LD A, (.dbsShift)
 542+ 68E3 B7               OR A
 543+ 68E4 28 03            JR Z, .dbsNoFinal
 544+ 68E6 79               LD A, C
 545+ 68E7 AE               XOR (HL)
 546+ 68E8 77               LD (HL), A
 547+ 68E9              .dbsNoFinal:
 548+ 68E9 E1               POP HL                                  ; restore row start
 549+ 68EA CD 88 9E         CALL NextPixelLine
 550+ 68ED DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 551+ 68EF DD 23            INC IX
 552+ 68F1 3A FB 68         LD A, (.dbsHeight)
 553+ 68F4 3D               DEC A
 554+ 68F5 32 FB 68         LD (.dbsHeight), A
 555+ 68F8 20 B2            JR NZ, .dbsRow
 556+ 68FA C9               RET
 557+ 68FB 00           .dbsHeight: DEFB 0
 558+ 68FC 00           .dbsShift:  DEFB 0
 559+ 68FD
 560+ 68FD              ; ==============================================================================
 561+ 68FD              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 562+ 68FD              ; ==============================================================================
 563+ 68FD              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 564+ 68FD              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 565+ 68FD              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 566+ 68FD              ;   2. Leer charX/charY de la entry
 567+ 68FD              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 568+ 68FD              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 569+ 68FD              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 570+ 68FD              ;   6. ChurchDoorOpen = 0
 571+ 68FD              ; ==============================================================================
 572+ 68FD              CloseChurchDoor:
 573+ 68FD                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
 574+ 68FD                  ; ambos sentidos). Suena ANTES del cambio visual.
 575+ 68FD 21 FB F1         LD HL, SFX_ChurchDoorOpen
 576+ 6900 CD 09 F1         CALL PlaySFX
 577+ 6903 11 BA E2         LD DE, BgGfx_old_church_door_open
 578+ 6906 CD 90 69         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 579+ 6909 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 580+ 690B                  ; Leer charX (HL+4) y charY (HL+5) en BC
 581+ 690B E5               PUSH HL                                 ; save mapX ptr
 582+ 690C 01 04 00         LD BC, 4
 583+ 690F 09               ADD HL, BC
 584+ 6910 46               LD B, (HL)                              ; B = charX
 585+ 6911 23               INC HL
 586+ 6912 4E               LD C, (HL)                              ; C = charY
 587+ 6913 E1               POP HL                                  ; HL = mapX ptr
 588+ 6914                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 589+ 6914 E5               PUSH HL
 590+ 6915 C5               PUSH BC
 591+ 6916 21 BA E2         LD HL, BgGfx_old_church_door_open
 592+ 6919 3E 03            LD A, 3
 593+ 691B CD BD 90         CALL LoadBgSpriteToBuffer               ; preserva BC
 594+ 691E C1               POP BC
 595+ 691F C5               PUSH BC
 596+ 6920 DD 21 F5 88      LD IX, BgSpriteBuffer
 597+ 6924 CD C4 D6         CALL DrawBgSpriteXOR                    ; borra
 598+ 6927 C1               POP BC
 599+ 6928 E1               POP HL
 600+ 6929                  ; --- Patch ptr: open -> closed ---
 601+ 6929 23               INC HL
 601+ 692A 23             INC HL                         ; -> ptr_lo
 602+ 692B 3E 01            LD A, LOW BgGfx_old_church_door_closed
 603+ 692D 77               LD (HL), A
 604+ 692E 23               INC HL
 605+ 692F 3E E2            LD A, HIGH BgGfx_old_church_door_closed
 606+ 6931 77               LD (HL), A
 607+ 6932                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 608+ 6932 C5               PUSH BC
 609+ 6933 21 01 E2         LD HL, BgGfx_old_church_door_closed
 610+ 6936 3E 03            LD A, 3
 611+ 6938 CD BD 90         CALL LoadBgSpriteToBuffer
 612+ 693B C1               POP BC
 613+ 693C C5               PUSH BC
 614+ 693D DD 21 F5 88      LD IX, BgSpriteBuffer
 615+ 6941 CD C4 D6         CALL DrawBgSpriteXOR
 616+ 6944 C1               POP BC
 617+ 6945 DD 21 F5 88      LD IX, BgSpriteBuffer
 618+ 6949 AF               XOR A
 619+ 694A 32 74 DD         LD (BgSpriteIsHouse), A
 620+ 694D CD 09 D7         CALL DrawBgAttrOnly
 621+ 6950              .ccdFlag:
 622+ 6950 AF               XOR A
 623+ 6951 32 DD 81         LD (ChurchDoorOpen), A
 624+ 6954 C9               RET
 625+ 6955
 626+ 6955              ; ==============================================================================
 627+ 6955              ; RespawnChurchKeyAtAlt - patch PickupTable entry de church_key con coords AltN
 628+ 6955              ; ==============================================================================
 629+ 6955              ; Lee ChurchKeyAltSpawnIdx (1 o 2) y patchea con CHURCH_KEY_ALT[1|2]_* coords.
 630+ 6955              ; ==============================================================================
 631+ 6955              RespawnChurchKeyAtAlt:
 632+ 6955 3A EC 81         LD A, (ChurchKeyAltSpawnIdx)
 633+ 6958 FE 01            CP 1
 634+ 695A 28 05            JR Z, .rcaAlt1
 635+ 695C FE 02            CP 2
 636+ 695E 28 0B            JR Z, .rcaAlt2
 637+ 6960 C9               RET                                     ; estado raro, no hacer nada
 638+ 6961              .rcaAlt1:
 639+ 6961 06 0F            LD B, CHURCH_KEY_ALT1_SCREEN_X
 640+ 6963 0E 06            LD C, CHURCH_KEY_ALT1_SCREEN_Y
 641+ 6965 16 1A            LD D, CHURCH_KEY_ALT1_CHAR_X
 642+ 6967 3E 03            LD A, CHURCH_KEY_ALT1_CHAR_Y
 643+ 6969 18 08            JR .rcaPatch
 644+ 696B              .rcaAlt2:
 645+ 696B 06 0F            LD B, CHURCH_KEY_ALT2_SCREEN_X
 646+ 696D 0E 06            LD C, CHURCH_KEY_ALT2_SCREEN_Y
 647+ 696F 16 04            LD D, CHURCH_KEY_ALT2_CHAR_X
 648+ 6971 3E 03            LD A, CHURCH_KEY_ALT2_CHAR_Y
 649+ 6973              .rcaPatch:
 650+ 6973 32 8F 69         LD (.rcaCharY), A
 651+ 6976 C5               PUSH BC                                 ; preservar B=mapX, C=mapY
 652+ 6977 D5               PUSH DE                                 ; preservar D=charX
 653+ 6978 11 AA DB         LD DE, BgGfx_church_key
 654+ 697B CD 90 69         CALL FindPickupEntryByPtr               ; HL = mapX byte
 655+ 697E D1               POP DE
 656+ 697F C1               POP BC
 657+ 6980 20 0C            JR NZ, .rcaSkip
 658+ 6982 70               LD (HL), B                              ; mapX = AltN_SCREEN_X
 659+ 6983 23               INC HL
 660+ 6984 71               LD (HL), C                              ; mapY = AltN_SCREEN_Y
 661+ 6985 23               INC HL
 661+ 6986 23             INC HL
 661+ 6987 23             INC HL                ; skip ptr_lo, ptr_hi
 662+ 6988 72               LD (HL), D                              ; charX = AltN_CHAR_X
 663+ 6989 23               INC HL
 664+ 698A 3A 8F 69         LD A, (.rcaCharY)
 665+ 698D 77               LD (HL), A                              ; charY = AltN_CHAR_Y
 666+ 698E              .rcaSkip:
 667+ 698E C9               RET
 668+ 698F 00           .rcaCharY: DEFB 0
 669+ 6990
 670+ 6990              ; ==============================================================================
 671+ 6990              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
 672+ 6990              ; ==============================================================================
 673+ 6990              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
 674+ 6990              ; comparando ptr_lo/ptr_hi con DE.
 675+ 6990              ; IN:  DE = ptr buscado.
 676+ 6990              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
 677+ 6990              ; Destruye: AF.
 678+ 6990              ; ==============================================================================
 679+ 6990              FindPickupEntryByPtr:
 680+ 6990 21 E0 D9         LD HL, PickupTable
 681+ 6993              .fpeLoop:
 682+ 6993 7E               LD A, (HL)
 683+ 6994 FE FF            CP $FF
 684+ 6996 28 18            JR Z, .fpeNotFound
 685+ 6998 E5               PUSH HL
 686+ 6999 23               INC HL
 686+ 699A 23             INC HL                         ; -> ptr_lo
 687+ 699B 7E               LD A, (HL)
 688+ 699C BB               CP E
 689+ 699D 20 08            JR NZ, .fpeNoMatch
 690+ 699F 23               INC HL
 691+ 69A0 7E               LD A, (HL)
 692+ 69A1 BA               CP D
 693+ 69A2 20 03            JR NZ, .fpeNoMatch
 694+ 69A4 E1               POP HL
 695+ 69A5 AF               XOR A                                   ; Z = encontrado
 696+ 69A6 C9               RET
 697+ 69A7              .fpeNoMatch:
 698+ 69A7 E1               POP HL
 699+ 69A8 C5               PUSH BC
 700+ 69A9 01 07 00         LD BC, 7
 701+ 69AC 09               ADD HL, BC
 702+ 69AD C1               POP BC
 703+ 69AE 18 E3            JR .fpeLoop
 704+ 69B0              .fpeNotFound:
 705+ 69B0 F6 01            OR 1                                    ; NZ
 706+ 69B2 C9               RET
