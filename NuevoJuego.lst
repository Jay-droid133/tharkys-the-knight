 164+ F1A2              SFX_ScreenTransition:
 165+ F1A2 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 166+ F1A6 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 167+ F1AA 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 168+ F1AE 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 169+ F1B2 00               DEFB 0                      ; fin
