 272+ 6527              ; ==============================================================================
 273+ 6527              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 274+ 6527              ; ==============================================================================
 275+ 6527              ; IN: A = frame idx (0..2)
 276+ 6527              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 277+ 6527              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 278+ 6527              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 279+ 6527              ; Destruye: AF, BC, DE, HL, IX.
 280+ 6527              ; ==============================================================================
 281+ 6527              DrawSmokeFrameXor:
 282+ 6527 87               ADD A, A                                ; *2 (entries de 2 bytes)
 283+ 6528 6F               LD L, A
 284+ 6529 26 00            LD H, 0
 285+ 652B 11 21 65         LD DE, SmokeFramePtrTable
 286+ 652E 19               ADD HL, DE
 287+ 652F 5E               LD E, (HL)
 288+ 6530 23               INC HL
 289+ 6531 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 290+ 6532                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 291+ 6532                  ; Source y destino accesibles sin paging (milestones bank 0,
 292+ 6532                  ; BgSpriteBuffer en RAM principal).
 293+ 6532 EB               EX DE, HL                               ; HL = source
 294+ 6533 11 FD 86         LD DE, BgSpriteBuffer
 295+ 6536 01 22 00         LD BC, 34
 296+ 6539 ED B0            LDIR
 297+ 653B                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 298+ 653B 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 299+ 653E 57               LD D, A
 300+ 653F 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 301+ 6542 5F               LD E, A
 302+ 6543 C3 39 66         JP DrawBgSprite16XorAtPixel
