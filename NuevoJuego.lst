 318+ 6EDB 77               LD (HL), A
 319+ 6EDC 23               INC HL
 320+ 6EDD 13               INC DE
 321+ 6EDE 1A               LD A, (DE)
 322+ 6EDF 77               LD (HL), A
 323+ 6EE0 13               INC DE
 324+ 6EE1 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 325+ 6EE4 1A               LD A, (DE)
 326+ 6EE5 77               LD (HL), A
 327+ 6EE6 23               INC HL
 328+ 6EE7 13               INC DE
 329+ 6EE8 1A               LD A, (DE)
 330+ 6EE9 77               LD (HL), A
 331+ 6EEA C9               RET
