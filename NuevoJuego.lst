3107+ B03E                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
3108+ B03E                  ;
3109+ B03E                  ; Doble comportamiento:
3110+ B03E                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
3111+ B03E                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
3112+ B03E                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
3113+ B03E                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
3114+ B03E                  ;   y lo activa).
3115+ B03E                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
3116+ B03E                  ;   El monster queda en destino (memoria) hasta que el player visite.
3117+ B03E                  ;
3118+ B03E                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
3119+ B03E                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
3120+ B03E DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
3121+ B041 32 82 B0         LD (.moKbSavedDir), A
3122+ B044 3E 01            LD A, 1
3123+ B046 32 CD B3         LD (MonsterKbDespawn), A
3124+ B049                  ; Calcular slot (0-2) en E, D=0
3125+ B049 DD E5            PUSH IX
3126+ B04B E1               POP HL
3127+ B04C 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
3128+ B04F B7               OR A
3129+ B050 ED 52            SBC HL, DE
3130+ B052 CB 3D            SRL L
3131+ B054 CB 3D            SRL L
3132+ B056 CB 3D            SRL L
3133+ B058 CB 3D            SRL L
3134+ B05A 5D               LD E, L
3135+ B05B 16 00            LD D, 0
3136+ B05D                  ; Clear MAI_FLAG_LEAVING
3137+ B05D 21 9B 8D         LD HL, MonsterAiFlags
3138+ B060 19               ADD HL, DE
3139+ B061 7E               LD A, (HL)
3140+ B062 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
3141+ B064 77               LD (HL), A
3142+ B065                  ; MonsterRoomId[slot] = neighbor_id (destino)
3143+ B065 3A 82 B0         LD A, (.moKbSavedDir)
3144+ B068 CD C3 8E         CALL MaiGetNeighborScreenId
3145+ B06B 21 8F 8D         LD HL, MonsterRoomId
3146+ B06E 19               ADD HL, DE
3147+ B06F 77               LD (HL), A
3148+ B070                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
3149+ B070 3A 82 B0         LD A, (.moKbSavedDir)
3150+ B073 CD 22 8F         CALL MaiDirToEntrySide
3151+ B076 21 95 8D         LD HL, MonsterEntryBorder
3152+ B079 19               ADD HL, DE
3153+ B07A 77               LD (HL), A
3154+ B07B                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
3155+ B07B 21 CF B3         LD HL, MonsterReturnTimer
3156+ B07E 19               ADD HL, DE
3157+ B07F 36 19            LD (HL), MAI_LINGER_PUSHED
