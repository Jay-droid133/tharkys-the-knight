 837+ D148 3A F2 D1         LD A, (.rlePending)
 838+ D14B B7               OR A
 839+ D14C CA 63 D1         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 840+ D14F FA 71 D1         JP M, .rleLitEmit           ; <0 = literal group en curso
 841+ D152                  ; >0 = run en curso, emitir valor
 842+ D152              .rleRunEmit:
 843+ D152 3A F3 D1         LD A, (.rleValue)
 844+ D155 2F               CPL
 845+ D156 77               LD (HL), A
 846+ D157 23               INC HL
 847+ D158 3A F2 D1         LD A, (.rlePending)
 848+ D15B 3D               DEC A
 849+ D15C 32 F2 D1         LD (.rlePending), A
 850+ D15F 10 E7            DJNZ .rlePixCol
 851+ D161 18 32            JR .rleRowDone
 852+ D163
 853+ D163              .rleNewToken:
 854+ D163 DD 7E 00         LD A, (IX+0)
 855+ D166 DD 23            INC IX
 856+ D168 CB 7F            BIT 7, A
 857+ D16A 20 18            JR NZ, .rleNewRun
 858+ D16C                  ; --- Literal group: A = count (1-127) ---
 859+ D16C ED 44            NEG                         ; A = -count (negativo)
 860+ D16E 32 F2 D1         LD (.rlePending), A
 861+ D171                  ; fall through: emitir primer byte literal
 862+ D171
 863+ D171              .rleLitEmit:
 864+ D171 DD 7E 00         LD A, (IX+0)
 865+ D174 DD 23            INC IX
 866+ D176 2F               CPL
 867+ D177 77               LD (HL), A
 868+ D178 23               INC HL
 869+ D179 3A F2 D1         LD A, (.rlePending)
 870+ D17C 3C               INC A                       ; hacia 0
 871+ D17D 32 F2 D1         LD (.rlePending), A
 872+ D180 10 C6            DJNZ .rlePixCol
 873+ D182 18 11            JR .rleRowDone
