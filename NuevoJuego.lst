 456  985B                  INCLUDE "ay_sound_thunks.asm"
# file opened: code/ay_sound_thunks.asm
   1+ 985B              ; ==============================================================================
   2+ 985B              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 985B              ; ==============================================================================
   4+ 985B              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 985B              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 985B              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 985B              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 985B              ;
   9+ 985B              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 985B              ; fallo en el intento previo):
  11+ 985B              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 985B              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 985B              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 985B              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 985B              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 985B              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 985B              ;      nadie las toca, asi que no hay corrupcion.
  18+ 985B              ;
  19+ 985B              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 985B              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 985B              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 985B              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 985B              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 985B              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 985B              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 985B              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 985B              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 985B              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 985B              ; ==============================================================================
  30+ 985B
  31+ 985B              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 985B              AY_Init:
  33+ 985B F3               DI
  34+ 985C 3A 85 8D         LD A, (CurrentPaging)
  35+ 985F E6 F8            AND $F8
  36+ 9861 F6 04            OR 4
  37+ 9863 32 85 8D         LD (CurrentPaging), A
  38+ 9866 01 FD 7F         LD BC, $7FFD
  39+ 9869 ED 79            OUT (C), A
  40+ 986B CD BF E4         CALL AY_InitImpl
  41+ 986E 3A 85 8D         LD A, (CurrentPaging)
  42+ 9871 E6 F8            AND $F8
  43+ 9873 32 85 8D         LD (CurrentPaging), A
  44+ 9876 01 FD 7F         LD BC, $7FFD
  45+ 9879 ED 79            OUT (C), A
  46+ 987B 3A 9D 81         LD A, (StartupComplete)
  47+ 987E B7               OR A
  48+ 987F C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9880 FB               EI
  50+ 9881 C9               RET
