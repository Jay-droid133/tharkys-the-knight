 984+ D2B4
 985+ D2B4              ; Bank del sprite que se va a cargar con LoadBgSpriteToBuffer. Los iteradores
 986+ D2B4              ; de placements (DrawScreen, RemapScreenAttrs, CollisionMap) lo leen de
 987+ D2B4              ; BgGfxPtrById[id].bank tras resolver el ID. HUD y otros callers con labels
 988+ D2B4              ; hardcoded (DrawKeyHUD, etc.) asignan 3 directamente.
 989+ D2B4 03           CurrentBgSpriteBank: DEFB 3
 990+ D2B5
 991+ D2B5              ; ID del sprite actualmente siendo procesado en los iteradores (Stage B.2).
 992+ D2B5              ; Usado por CheckIfHouseSprite (compara por ID contra HouseIdList) y por
 993+ D2B5              ; comparaciones con WELL_POZO_ID / RELOJ_PLAZA_ID en DrawScreen.
 994+ D2B5 00           CurrentBgSpriteId: DEFB 0
 995+ D2B6
 996+ D2B6              ; ==============================================================================
 997+ D2B6              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 998+ D2B6              ; ==============================================================================
 999+ D2B6              ; Entrada: A = attr byte
1000+ D2B6              ; Salida:  A = attr con paper reemplazado (o sin cambio)
1001+ D2B6              ; Preserva: HL, DE, BC, IX
1002+ D2B6              ; ==============================================================================
1003+ D2B6              ApplyTintSwap:
1004+ D2B6 C5               PUSH BC
1005+ D2B7 47               LD B, A                     ; B = attr original
1006+ D2B8 3A B2 D2         LD A, (CurrentTintVar)
1007+ D2BB FE FF            CP $FF
1008+ D2BD 28 24            JR Z, .tintNoChange
1009+ D2BF 4F               LD C, A                     ; C = tint variant (new paper 0-7)
1010+ D2C0 3A B3 D2         LD A, (CurrentTintPaper)
1011+ D2C3 FE FF            CP $FF
1012+ D2C5 28 1C            JR Z, .tintNoChange
1013+ D2C7                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
1014+ D2C7                  ; Extraer paper del attr: bits 5-3
1015+ D2C7 78               LD A, B
1016+ D2C8 E6 38            AND $38                     ; A = 00PPP000
1017+ D2CA 0F               RRCA
1018+ D2CB 0F               RRCA
1019+ D2CC 0F               RRCA                        ; A = 00000PPP = paper actual
1020+ D2CD D5               PUSH DE
1021+ D2CE 57               LD D, A                     ; D = paper actual
1022+ D2CF 3A B3 D2         LD A, (CurrentTintPaper)
1023+ D2D2 BA               CP D                        ; paper actual == tintPaper?
1024+ D2D3 D1               POP DE
1025+ D2D4 20 0D            JR NZ, .tintNoChange
1026+ D2D6                  ; Match: reemplazar paper bits con tintVar
1027+ D2D6 78               LD A, B
1028+ D2D7 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1029+ D2D9 D5               PUSH DE
1030+ D2DA 57               LD D, A
1031+ D2DB 79               LD A, C                     ; A = tintVar (0-7)
1032+ D2DC 07               RLCA
1033+ D2DD 07               RLCA
1034+ D2DE 07               RLCA                        ; A = 00PPP000
1035+ D2DF B2               OR D                        ; A = FBPPPIII
1036+ D2E0 D1               POP DE
1037+ D2E1 C1               POP BC
1038+ D2E2 C9               RET
1039+ D2E3              .tintNoChange:
1040+ D2E3 78               LD A, B                     ; devolver sin cambio
1041+ D2E4 C1               POP BC
1042+ D2E5 C9               RET
