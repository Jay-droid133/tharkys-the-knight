2645+ B0D1 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2646+ B0D4 47               LD B, A
2647+ B0D5 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2648+ B0D8                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2649+ B0D8 E6 01            AND 1
2650+ B0DA 20 03            JR NZ, .eFrameReset
2651+ B0DC                  ; Frame 0 del par → avanzar a frame 1
2652+ B0DC 04               INC B
2653+ B0DD 18 01            JR .eFrameSet
2654+ B0DF              .eFrameReset:
2655+ B0DF                  ; Frame 1 del par → volver a frame 0
2656+ B0DF 05               DEC B
