 195+ 9D8D              .shiftedByte:
 196+ 9D8D                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9D8D 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9D8E 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9D8F 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9D90 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9D91 77               LD (HL), A                  ; Escribir
 202+ 9D92 2C               INC L                       ; Siguiente columna VRAM
 203+ 9D93 04               INC B                       ; Pagina overflow
 204+ 9D94 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9D95 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9D96 77               LD (HL), A                  ; Escribir
 207+ 9D97 05               DEC B                       ; Restaurar pagina high
 208+ 9D98 13               INC DE                      ; Siguiente byte de sprite
 209+ 9D99                  ; Siguiente byte de ancho
 210+ 9D99 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9D9B 20 F0            JR NZ, .shiftedByte         ; 12/7T
