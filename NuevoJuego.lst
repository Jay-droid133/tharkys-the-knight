 426+ 934D 21 53 90         LD HL, MonsterAiFlags
 427+ 9350 19               ADD HL, DE
 428+ 9351 36 00            LD (HL), 0
 429+ 9353 21 47 90         LD HL, MonsterRoomId
 430+ 9356 19               ADD HL, DE
 431+ 9357 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 9359 21 4D 90         LD HL, MonsterEntryBorder
 433+ 935C 19               ADD HL, DE
 434+ 935D 36 00            LD (HL), 0
 435+ 935F 21 50 90         LD HL, MonsterExitCoord
 436+ 9362 19               ADD HL, DE
 437+ 9363 36 00            LD (HL), 0
 438+ 9365 21 02 B6         LD HL, MonsterReturnTimer
 439+ 9368 19               ADD HL, DE
 440+ 9369 36 00            LD (HL), 0
 441+ 936B 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 936E 19               ADD HL, DE
 443+ 936F 36 00            LD (HL), 0
 444+ 9371 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 9374 19               ADD HL, DE
 446+ 9375 36 00            LD (HL), 0
 447+ 9377 C9               RET
