7013+ C608                  ; POSY = cy * 8 + SCREEN_MIN_Y
7014+ C608 79               LD A, C
7015+ C609 87               ADD A, A
7016+ C60A 87               ADD A, A
7017+ C60B 87               ADD A, A
7018+ C60C C6 10            ADD A, SCREEN_MIN_Y
7019+ C60E DD 77 04         LD (IX+ENT_POSY), A
7020+ C611 DD 77 0D         LD (IX+ENT_OLDY), A
