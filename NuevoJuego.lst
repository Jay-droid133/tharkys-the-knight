   1+ 99E5              ; ==============================================================================
   2+ 99E5              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99E5              ; ==============================================================================
   4+ 99E5              ; Sistema fiel a Sabre Wulf:
   5+ 99E5              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99E5              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99E5              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99E5              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99E5              ; ==============================================================================
  10+ 99E5
  11+ 99E5              ClearScreen:
  12+ 99E5 CD AF 0D         CALL ROM_CLS
  13+ 99E8 C9               RET
  14+ 99E9
  15+ 99E9              ; ==============================================================================
  16+ 99E9              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99E9              ; ==============================================================================
  18+ 99E9              ; Entrada:
  19+ 99E9              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99E9              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99E9              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99E9              ;
  23+ 99E9              ; Formato del sprite:
  24+ 99E9              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99E9              ;   DEFB height_pixels
  26+ 99E9              ;   DEFB pixel_data... (width * height bytes)
  27+ 99E9              ;
  28+ 99E9              ; Dos paths:
  29+ 99E9              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99E9              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99E9              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99E9              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99E9              ;
  34+ 99E9              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99E9              ;
  36+ 99E9              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99E9              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99E9              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99E9              ; alto la restauracion del bank.
  40+ 99E9              ; ==============================================================================
  41+ 99E9              DrawSprite:
  42+ 99E9                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99E9                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99E9                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99E9 3A 84 8D         LD A, (CurrentPaging)
  46+ 99EC E6 F8            AND $F8
  47+ 99EE F6 06            OR 6
  48+ 99F0 32 84 8D         LD (CurrentPaging), A
  49+ 99F3 01 FD 7F         LD BC, $7FFD
  50+ 99F6 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99F8 CD 09 9A         CALL _DrawSpriteImpl
  52+ 99FB                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 99FB                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 99FB 3A 84 8D         LD A, (CurrentPaging)
  55+ 99FE E6 F8            AND $F8
  56+ 9A00 32 84 8D         LD (CurrentPaging), A
  57+ 9A03 01 FD 7F         LD BC, $7FFD
  58+ 9A06 ED 79            OUT (C), A
  59+ 9A08 C9               RET
  60+ 9A09
  61+ 9A09              _DrawSpriteImpl:
  62+ 9A09                  ; Guardar posicion
  63+ 9A09 7A               LD A, D
  64+ 9A0A 32 C3 9A         LD (.posY), A
  65+ 9A0D 7B               LD A, E
  66+ 9A0E 32 C2 9A         LD (.posX), A
  67+ 9A11
  68+ 9A11                  ; Leer cabecera sprite
  69+ 9A11 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A14 32 C4 9A         LD (.widthSave), A
  71+ 9A17 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A1A 32 C5 9A         LD (.heightSave), A
  73+ 9A1D DD 23            INC IX
  74+ 9A1F DD 23            INC IX                      ; IX → pixel data
  75+ 9A21
  76+ 9A21                  ; === Y CLIPPING ===
  77+ 9A21                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A21 3A C3 9A         LD A, (.posY)
  79+ 9A24 FE 10            CP SCREEN_MIN_Y
  80+ 9A26 30 20            JR NC, .clipTopDone
  81+ 9A28                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A28 47               LD B, A                     ; B = Y
  83+ 9A29 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A2B 90               SUB B                       ; A = filas a saltar
  85+ 9A2C 47               LD B, A                     ; B = skip rows
  86+ 9A2D                  ; Reducir altura
  87+ 9A2D 3A C5 9A         LD A, (.heightSave)
  88+ 9A30 90               SUB B
  89+ 9A31 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A32 D8               RET C                       ; Idem
  91+ 9A33 32 C5 9A         LD (.heightSave), A
  92+ 9A36                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A36 3A C4 9A         LD A, (.widthSave)
  94+ 9A39 4F               LD C, A
  95+ 9A3A              .clipSkipRow:
  96+ 9A3A 79               LD A, C
  97+ 9A3B              .clipSkipByte:
  98+ 9A3B DD 23            INC IX
  99+ 9A3D 3D               DEC A
 100+ 9A3E 20 FB            JR NZ, .clipSkipByte
 101+ 9A40 10 F8            DJNZ .clipSkipRow
 102+ 9A42                  ; Ajustar Y al borde
 103+ 9A42 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A44 32 C3 9A         LD (.posY), A
 105+ 9A47 57               LD D, A
 106+ 9A48              .clipTopDone:
 107+ 9A48                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A48 3A C3 9A         LD A, (.posY)
 109+ 9A4B 47               LD B, A
 110+ 9A4C 3A C5 9A         LD A, (.heightSave)
 111+ 9A4F 80               ADD A, B                    ; A = Y + height
 112+ 9A50 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A52 FE C0            CP 192
 114+ 9A54 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A56              .clipBot:
 116+ 9A56                  ; Reducir altura: new_height = 192 - Y
 117+ 9A56 3E C0            LD A, 192
 118+ 9A58 90               SUB B                       ; A = 192 - Y
 119+ 9A59 C8               RET Z
 120+ 9A5A D8               RET C
 121+ 9A5B 32 C5 9A         LD (.heightSave), A
 122+ 9A5E              .clipBotDone:
 123+ 9A5E
 124+ 9A5E                  ; Comprobar alineacion
 125+ 9A5E 7B               LD A, E
 126+ 9A5F E6 07            AND 7
 127+ 9A61 20 1E            JR NZ, .shifted
 128+ 9A63
 129+ 9A63                  ; ==================================================================
 130+ 9A63                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9A63                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9A63                  ; ==================================================================
 133+ 9A63 CD 5C 9D         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9A66 DD E5            PUSH IX
 135+ 9A68 D1               POP DE                      ; DE = puntero a pixel data
 136+ 9A69 3A C5 9A         LD A, (.heightSave)
 137+ 9A6C 4F               LD C, A                     ; C = height counter
 138+ 9A6D
 139+ 9A6D              .alignedLine:
 140+ 9A6D 3A C4 9A         LD A, (.widthSave)
 141+ 9A70 47               LD B, A                     ; B = ancho en bytes
 142+ 9A71 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A72
 144+ 9A72              .alignedByte:
 145+ 9A72 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A73 AE               XOR (HL)
 147+ 9A74 77               LD (HL), A
 148+ 9A75 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A76 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A77 10 F9            DJNZ .alignedByte
 151+ 9A79
 152+ 9A79 E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A7A 0D               DEC C
 154+ 9A7B C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A7C CD C8 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A7F 18 EC            JR .alignedLine
 157+ 9A81
 158+ 9A81                  ; ==================================================================
 159+ 9A81                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A81                  ; ==================================================================
 161+ 9A81                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A81              .shifted:
 163+ 9A81                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A81 3D               DEC A                       ; 0-6
 165+ 9A82 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A83 E6 0E            AND $0E
 167+ 9A85 C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A87 32 C6 9A         LD (.tablePage), A
 169+ 9A8A
 170+ 9A8A                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A8A DD E5            PUSH IX
 172+ 9A8C D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A8D D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A8E
 175+ 9A8E                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A8E 3A C3 9A         LD A, (.posY)
 177+ 9A91 57               LD D, A
 178+ 9A92 3A C2 9A         LD A, (.posX)
 179+ 9A95 5F               LD E, A
 180+ 9A96 CD 5C 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A99
 182+ 9A99 D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9A9A 3A C6 9A         LD A, (.tablePage)
 184+ 9A9D 47               LD B, A                     ; B = pagina high part
 185+ 9A9E                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9A9E                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9A9E 3A C5 9A         LD A, (.heightSave)
 188+ 9AA1 DD 67            LD IXH, A
 189+ 9AA3
 190+ 9AA3              .shiftedLine:
 191+ 9AA3 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9AA4 3A C4 9A         LD A, (.widthSave)
 193+ 9AA7 DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9AA9
 195+ 9AA9              .shiftedByte:
 196+ 9AA9                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AA9 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AAA 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AAB 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AAC AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AAD 77               LD (HL), A                  ; Escribir
 202+ 9AAE 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AAF 04               INC B                       ; Pagina overflow
 204+ 9AB0 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AB1 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AB2 77               LD (HL), A                  ; Escribir
 207+ 9AB3 05               DEC B                       ; Restaurar pagina high
 208+ 9AB4 13               INC DE                      ; Siguiente byte de sprite
 209+ 9AB5                  ; Siguiente byte de ancho
 210+ 9AB5 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9AB7 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9AB9
 213+ 9AB9 E1               POP HL                      ; Restaurar inicio de linea
 214+ 9ABA DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9ABC C8               RET Z                       ; Terminamos todas las lineas
 216+ 9ABD CD C8 9A         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9AC0 18 E1            JR .shiftedLine
 218+ 9AC2
 219+ 9AC2              ; Variables locales de DrawSprite
 220+ 9AC2 00           .posX:       DEFB 0
 221+ 9AC3 00           .posY:       DEFB 0
 222+ 9AC4 00           .widthSave:  DEFB 0
 223+ 9AC5 00           .heightSave: DEFB 0
 224+ 9AC6 00           .tablePage:  DEFB 0
 225+ 9AC7 00           .widthCount: DEFB 0
 226+ 9AC8
 227+ 9AC8              ; ==============================================================================
 228+ 9AC8              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9AC8              ; ==============================================================================
 230+ 9AC8              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9AC8              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9AC8              ;
 233+ 9AC8              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9AC8              ; ==============================================================================
 235+ 9AC8              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9AC8              NextPixelLine:
 237+ 9AC8 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9AC9 7C               LD A, H
 239+ 9ACA E6 07            AND 7
 240+ 9ACC C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9ACD
 242+ 9ACD                  ; --- Cruce de character row ---
 243+ 9ACD 7D               LD A, L
 244+ 9ACE C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AD0 6F               LD L, A
 246+ 9AD1 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD3 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9AD4
 249+ 9AD4                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9AD4 7C               LD A, H
 251+ 9AD5 D6 08            SUB 8
 252+ 9AD7 67               LD H, A
 253+ 9AD8 C9               RET
 254+ 9AD9
 255+ 9AD9              ; ==============================================================================
 256+ 9AD9              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9AD9              ; ==============================================================================
 258+ 9AD9              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9AD9              ; Entrada:
 260+ 9AD9              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9AD9              ;   A = atributo a pintar
 262+ 9AD9              ; ==============================================================================
 263+ 9AD9              SetEntityAttr:
 264+ 9AD9 F5               PUSH AF                     ; Guardar atributo
 265+ 9ADA CD 41 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9ADD F1               POP AF
 267+ 9ADE
 268+ 9ADE 47               LD B, A                     ; B = atributo (preservar)
 269+ 9ADF 3A D8 9B         LD A, (EntityAttrH)
 270+ 9AE2 4F               LD C, A                     ; C = filas
 271+ 9AE3              .rowLoop:
 272+ 9AE3                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE3 E5               PUSH HL
 274+ 9AE4 7C               LD A, H
 275+ 9AE5 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9AE7 20 08            JR NZ, .rowNotHud
 277+ 9AE9 7D               LD A, L
 278+ 9AEA FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AEC 30 03            JR NC, .rowNotHud
 280+ 9AEE                  ; Fila en HUD → saltar sin pintar
 281+ 9AEE E1               POP HL
 282+ 9AEF 18 0B            JR .rowSkip
 283+ 9AF1              .rowNotHud:
 284+ 9AF1 E1               POP HL
 285+ 9AF2 3A D7 9B         LD A, (EntityAttrW)
 286+ 9AF5 E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AF6                  ; Pintar una fila
 288+ 9AF6              .colLoop:
 289+ 9AF6 70               LD (HL), B
 290+ 9AF7 23               INC HL
 291+ 9AF8 3D               DEC A
 292+ 9AF9 20 FB            JR NZ, .colLoop
 293+ 9AFB E1               POP HL
 294+ 9AFC              .rowSkip:
 295+ 9AFC                  ; Siguiente fila: HL += 32
 296+ 9AFC D5               PUSH DE
 297+ 9AFD 11 20 00         LD DE, 32
 298+ 9B00 19               ADD HL, DE
 299+ 9B01 D1               POP DE
 300+ 9B02 0D               DEC C
 301+ 9B03 20 DE            JR NZ, .rowLoop
 302+ 9B05 C9               RET
 303+ 9B06
 304+ 9B06              ; ==============================================================================
 305+ 9B06              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9B06              ; ==============================================================================
 307+ 9B06              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9B06              ; Se llama ANTES de pintar el sprite.
 309+ 9B06              ;
 310+ 9B06              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9B06              ;          IX = puntero al sprite (para leer width/height)
 312+ 9B06              ; ==============================================================================
 313+ 9B06              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9B06              ; ==============================================================================
 315+ 9B06              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9B06              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9B06              ; ==============================================================================
 318+ 9B06              CalcEntityAttrSize:
 319+ 9B06                  ; Paging inline (ver nota en DrawSprite)
 320+ 9B06 3A 84 8D         LD A, (CurrentPaging)
 321+ 9B09 E6 F8            AND $F8
 322+ 9B0B F6 06            OR 6
 323+ 9B0D 32 84 8D         LD (CurrentPaging), A
 324+ 9B10 01 FD 7F         LD BC, $7FFD
 325+ 9B13 ED 79            OUT (C), A
 326+ 9B15 CD 26 9B         CALL _CalcEntityAttrSizeImpl
 327+ 9B18 3A 84 8D         LD A, (CurrentPaging)
 328+ 9B1B E6 F8            AND $F8
 329+ 9B1D 32 84 8D         LD (CurrentPaging), A
 330+ 9B20 01 FD 7F         LD BC, $7FFD
 331+ 9B23 ED 79            OUT (C), A
 332+ 9B25 C9               RET
 333+ 9B26
 334+ 9B26              _CalcEntityAttrSizeImpl:
 335+ 9B26 DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9B29 47               LD B, A
 337+ 9B2A 7B               LD A, E
 338+ 9B2B E6 07            AND 7
 339+ 9B2D 28 01            JR Z, .ceNoExtra
 340+ 9B2F 04               INC B
 341+ 9B30              .ceNoExtra:
 342+ 9B30 78               LD A, B
 343+ 9B31 32 D7 9B         LD (EntityAttrW), A
 344+ 9B34 7A               LD A, D
 345+ 9B35 E6 07            AND 7
 346+ 9B37 4F               LD C, A
 347+ 9B38 DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9B3B 81               ADD A, C
 349+ 9B3C C6 07            ADD A, 7
 350+ 9B3E 0F               RRCA
 351+ 9B3F 0F               RRCA
 352+ 9B40 0F               RRCA
 353+ 9B41 E6 1F            AND $1F
 354+ 9B43 32 D8 9B         LD (EntityAttrH), A
 355+ 9B46 C9               RET
 356+ 9B47
 357+ 9B47              ; ==============================================================================
 358+ 9B47              SaveEntityAttr:
 359+ 9B47                  ; Paging inline (ver nota en DrawSprite)
 360+ 9B47 3A 84 8D         LD A, (CurrentPaging)
 361+ 9B4A E6 F8            AND $F8
 362+ 9B4C F6 06            OR 6
 363+ 9B4E 32 84 8D         LD (CurrentPaging), A
 364+ 9B51 01 FD 7F         LD BC, $7FFD
 365+ 9B54 ED 79            OUT (C), A
 366+ 9B56 CD 67 9B         CALL _SaveEntityAttrImpl
 367+ 9B59 3A 84 8D         LD A, (CurrentPaging)
 368+ 9B5C E6 F8            AND $F8
 369+ 9B5E 32 84 8D         LD (CurrentPaging), A
 370+ 9B61 01 FD 7F         LD BC, $7FFD
 371+ 9B64 ED 79            OUT (C), A
 372+ 9B66 C9               RET
 373+ 9B67
 374+ 9B67              _SaveEntityAttrImpl:
 375+ 9B67                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B67 DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B6A 47               LD B, A
 378+ 9B6B 7B               LD A, E                     ; X pixel (raw)
 379+ 9B6C E6 07            AND 7
 380+ 9B6E 28 01            JR Z, .noExtraW
 381+ 9B70 04               INC B                       ; +1 columna si no alineado
 382+ 9B71              .noExtraW:
 383+ 9B71 78               LD A, B
 384+ 9B72 32 D7 9B         LD (EntityAttrW), A
 385+ 9B75
 386+ 9B75                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B75 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B76 E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B78 4F               LD C, A
 390+ 9B79 DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9B7C 81               ADD A, C                    ; + Y offset
 392+ 9B7D C6 07            ADD A, 7
 393+ 9B7F 0F               RRCA
 394+ 9B80 0F               RRCA
 395+ 9B81 0F               RRCA
 396+ 9B82 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9B84 32 D8 9B         LD (EntityAttrH), A
 398+ 9B87
 399+ 9B87 CD 41 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9B8A 11 C7 9B         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9B8D
 402+ 9B8D 3A D8 9B         LD A, (EntityAttrH)
 403+ 9B90 4F               LD C, A                     ; C = filas
 404+ 9B91              .saveRow:
 405+ 9B91 3A D7 9B         LD A, (EntityAttrW)
 406+ 9B94 47               LD B, A                     ; B = columnas
 407+ 9B95 E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9B96              .saveCol:
 409+ 9B96 7E               LD A, (HL)
 410+ 9B97 12               LD (DE), A
 411+ 9B98 23               INC HL
 412+ 9B99 13               INC DE
 413+ 9B9A 10 FA            DJNZ .saveCol
 414+ 9B9C E1               POP HL
 415+ 9B9D                  ; Siguiente fila attr: HL += 32
 416+ 9B9D D5               PUSH DE
 417+ 9B9E 11 20 00         LD DE, 32
 418+ 9BA1 19               ADD HL, DE
 419+ 9BA2 D1               POP DE
 420+ 9BA3 0D               DEC C
 421+ 9BA4 20 EB            JR NZ, .saveRow
 422+ 9BA6 C9               RET
 423+ 9BA7
 424+ 9BA7              ; ==============================================================================
 425+ 9BA7              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9BA7              ; ==============================================================================
 427+ 9BA7              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9BA7              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9BA7              ;
 430+ 9BA7              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9BA7              ; ==============================================================================
 432+ 9BA7              RestoreEntityAttr:
 433+ 9BA7 CD 41 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BAA 11 C7 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BAD
 436+ 9BAD 3A D8 9B         LD A, (EntityAttrH)
 437+ 9BB0 4F               LD C, A
 438+ 9BB1              .restRow:
 439+ 9BB1 3A D7 9B         LD A, (EntityAttrW)
 440+ 9BB4 47               LD B, A
 441+ 9BB5 E5               PUSH HL
 442+ 9BB6              .restCol:
 443+ 9BB6 1A               LD A, (DE)
 444+ 9BB7 77               LD (HL), A
 445+ 9BB8 23               INC HL
 446+ 9BB9 13               INC DE
 447+ 9BBA 10 FA            DJNZ .restCol
 448+ 9BBC E1               POP HL
 449+ 9BBD D5               PUSH DE
 450+ 9BBE 11 20 00         LD DE, 32
 451+ 9BC1 19               ADD HL, DE
 452+ 9BC2 D1               POP DE
 453+ 9BC3 0D               DEC C
 454+ 9BC4 20 EB            JR NZ, .restRow
 455+ 9BC6 C9               RET
 456+ 9BC7
 457+ 9BC7              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BC7              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BC7              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BC7              ; ---
 461+ 9BC7 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BD7 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BD8 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BD9 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D0B 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D0C
 467+ 9D0C              ; ==============================================================================
 468+ 9D0C              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D0C              ; ==============================================================================
 470+ 9D0C              ; Entrada: A = indice de entidad (0-16)
 471+ 9D0C              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D0C              ; ==============================================================================
 473+ 9D0C              SetAttrSlot:
 474+ 9D0C 32 0B 9D         LD (CurrentAttrSlot), A
 475+ 9D0F                  ; Calcular offset: A * 18
 476+ 9D0F 6F               LD L, A
 477+ 9D10 26 00            LD H, 0
 478+ 9D12 29               ADD HL, HL                  ; x2
 479+ 9D13 54               LD D, H
 480+ 9D14 5D               LD E, L                     ; DE = x2
 481+ 9D15 29               ADD HL, HL                  ; x4
 482+ 9D16 29               ADD HL, HL                  ; x8
 483+ 9D17 29               ADD HL, HL                  ; x16
 484+ 9D18 19               ADD HL, DE                  ; x18
 485+ 9D19 11 D9 9B         LD DE, SavedAttrTable
 486+ 9D1C 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D1D                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D1D 11 C7 9B         LD DE, EntitySavedAttr
 489+ 9D20 01 12 00         LD BC, 18
 490+ 9D23 ED B0            LDIR
 491+ 9D25 C9               RET
 492+ 9D26
 493+ 9D26              ; ==============================================================================
 494+ 9D26              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D26              ; ==============================================================================
 496+ 9D26              FlushAttrSlot:
 497+ 9D26 3A 0B 9D         LD A, (CurrentAttrSlot)
 498+ 9D29 6F               LD L, A
 499+ 9D2A 26 00            LD H, 0
 500+ 9D2C 29               ADD HL, HL                  ; x2
 501+ 9D2D 54               LD D, H
 502+ 9D2E 5D               LD E, L
 503+ 9D2F 29               ADD HL, HL                  ; x4
 504+ 9D30 29               ADD HL, HL                  ; x8
 505+ 9D31 29               ADD HL, HL                  ; x16
 506+ 9D32 19               ADD HL, DE                  ; x18
 507+ 9D33 11 D9 9B         LD DE, SavedAttrTable
 508+ 9D36 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D37 EB               EX DE, HL                   ; DE = destino
 510+ 9D38 21 C7 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D3B 01 12 00         LD BC, 18
 512+ 9D3E ED B0            LDIR
 513+ 9D40 C9               RET
 514+ 9D41
 515+ 9D41              ; ==============================================================================
 516+ 9D41              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D41              ; ==============================================================================
 518+ 9D41              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D41              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D41              ; ==============================================================================
 521+ 9D41              CalcAttrAddr:
 522+ 9D41 7A               LD A, D
 523+ 9D42 0F               RRCA
 524+ 9D43 0F               RRCA
 525+ 9D44 0F               RRCA
 526+ 9D45 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D47 6F               LD L, A
 528+ 9D48 26 00            LD H, 0
 529+ 9D4A 29               ADD HL, HL
 530+ 9D4B 29               ADD HL, HL
 531+ 9D4C 29               ADD HL, HL
 532+ 9D4D 29               ADD HL, HL
 533+ 9D4E 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D4F 7B               LD A, E
 535+ 9D50 0F               RRCA
 536+ 9D51 0F               RRCA
 537+ 9D52 0F               RRCA
 538+ 9D53 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D55 B5               OR L
 540+ 9D56 6F               LD L, A
 541+ 9D57 01 00 58         LD BC, ATTR_BASE
 542+ 9D5A 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D5B C9               RET
 544+ 9D5C
 545+ 9D5C              ; ==============================================================================
 546+ 9D5C              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D5C              ; ==============================================================================
 548+ 9D5C              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D5C              ; Salida: HL=direccion en VRAM
 550+ 9D5C              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D5C              ; ==============================================================================
 552+ 9D5C              CalcPixelAddr:
 553+ 9D5C 7A               LD A, D
 554+ 9D5D E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D5F 1F               RRA
 556+ 9D60 1F               RRA
 557+ 9D61 1F               RRA                         ; >> 3
 558+ 9D62 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D64 67               LD H, A
 560+ 9D65
 561+ 9D65 7A               LD A, D
 562+ 9D66 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D68 B4               OR H
 564+ 9D69 67               LD H, A
 565+ 9D6A
 566+ 9D6A 7A               LD A, D
 567+ 9D6B E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D6D 87               ADD A, A
 569+ 9D6E 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D6F 6F               LD L, A
 571+ 9D70
 572+ 9D70 7B               LD A, E
 573+ 9D71 1F               RRA
 574+ 9D72 1F               RRA
 575+ 9D73 1F               RRA
 576+ 9D74 E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D76 B5               OR L
 578+ 9D77 6F               LD L, A
 579+ 9D78 C9               RET
 580+ 9D79
 581+ 9D79              ; ==============================================================================
 582+ 9D79              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D79              ; ==============================================================================
 584+ 9D79              DrawDebugInfo:
 585+ 9D79 3A 0A 83         LD A, (CurrentScreenX)
 586+ 9D7C 1E 00            LD E, 0
 587+ 9D7E CD 9B 9D         CALL .drawHexDigit
 588+ 9D81
 589+ 9D81 3E 2C            LD A, ','
 590+ 9D83 1E 01            LD E, 1
 591+ 9D85 CD A7 9D         CALL .drawChar
 592+ 9D88
 593+ 9D88 3A 0B 83         LD A, (CurrentScreenY)
 594+ 9D8B 1E 02            LD E, 2
 595+ 9D8D CD 9B 9D         CALL .drawHexDigit
 596+ 9D90
 597+ 9D90 21 00 58         LD HL, ATTR_BASE
 598+ 9D93 3E 47            LD A, WHITE | $40
 599+ 9D95 77               LD (HL), A
 600+ 9D96 23               INC HL
 601+ 9D97 77               LD (HL), A
 602+ 9D98 23               INC HL
 603+ 9D99 77               LD (HL), A
 604+ 9D9A C9               RET
 605+ 9D9B
 606+ 9D9B              .drawHexDigit:
 607+ 9D9B E6 0F            AND $0F
 608+ 9D9D FE 0A            CP 10
 609+ 9D9F 38 04            JR C, .isNum
 610+ 9DA1 C6 37            ADD A, 'A' - 10
 611+ 9DA3 18 02            JR .drawChar
 612+ 9DA5              .isNum:
 613+ 9DA5 C6 30            ADD A, '0'
 614+ 9DA7              .drawChar:
 615+ 9DA7 6F               LD L, A
 616+ 9DA8 26 00            LD H, 0
 617+ 9DAA 29               ADD HL, HL
 618+ 9DAB 29               ADD HL, HL
 619+ 9DAC 29               ADD HL, HL
 620+ 9DAD 01 00 3C         LD BC, $3C00
 621+ 9DB0 09               ADD HL, BC
 622+ 9DB1
 623+ 9DB1 16 40            LD D, $40
 624+ 9DB3 06 08            LD B, 8
 625+ 9DB5              .charLoop:
 626+ 9DB5 7E               LD A, (HL)
 627+ 9DB6 12               LD (DE), A
 628+ 9DB7 23               INC HL
 629+ 9DB8 14               INC D
 630+ 9DB9 10 FA            DJNZ .charLoop
 631+ 9DBB C9               RET
