 129  E0EC                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ E0EC              ; ==============================================================================
   2+ E0EC              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ E0EC              ; ==============================================================================
   4+ E0EC              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ E0EC              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ E0EC              ;
   7+ E0EC              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ E0EC              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ E0EC              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ E0EC              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ E0EC              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ E0EC              ; ==============================================================================
  13+ E0EC
  14+ E0EC              ; ==============================================================================
  15+ E0EC              ; PlaySFX - Reproduce un efecto de sonido
  16+ E0EC              ; ==============================================================================
  17+ E0EC              ; Entrada: HL = puntero a datos del efecto
  18+ E0EC              ; Modifica: AF, BC, DE, HL
  19+ E0EC              ; ==============================================================================
  20+ E0EC              PlaySFX:
  21+ E0EC F3               DI                          ; Sin interrupciones para audio limpio
  22+ E0ED 3A DD 8C         LD A, (CurrentBorderColor)
  23+ E0F0 E6 07            AND $07                     ; Solo bits de color del borde
  24+ E0F2 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ E0F3
  26+ E0F3              .nextStep:
  27+ E0F3 7E               LD A, (HL)                  ; Leer duration
  28+ E0F4 B7               OR A
  29+ E0F5 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ E0F7
  31+ E0F7 47               LD B, A                     ; B = duration (bucle externo)
  32+ E0F8 23               INC HL
  33+ E0F9 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ E0FA 23               INC HL
  35+ E0FB 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ E0FC 23               INC HL
  37+ E0FD 7E               LD A, (HL)                  ; A = flags
  38+ E0FE 23               INC HL
  39+ E0FF E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ E100 CB 47            BIT 0, A
  41+ E102 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ E104
  43+ E104              ; --- Bucle de tono normal ---
  44+ E104              .toneLoop:
  45+ E104                  ; Semi-periodo HIGH
  46+ E104 7B               LD A, E
  47+ E105 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ E107 D3 FE            OUT ($FE), A
  49+ E109 79               LD A, C                     ; A = pitch actual
  50+ E10A              .toneDelayHi:
  51+ E10A 3D               DEC A
  52+ E10B 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ E10D
  54+ E10D                  ; Semi-periodo LOW
  55+ E10D 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ E10E D3 FE            OUT ($FE), A
  57+ E110 79               LD A, C
  58+ E111              .toneDelayLo:
  59+ E111 3D               DEC A
  60+ E112 20 FD            JR NZ, .toneDelayLo
  61+ E114
  62+ E114                  ; Aplicar pitch sweep
  63+ E114 79               LD A, C
  64+ E115 82               ADD A, D                    ; pitch += pitchDelta
  65+ E116 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ E118 FA 20 E1         JP M, .toneClamp            ; evitar pitch negativo
  67+ E11B 4F               LD C, A
  68+ E11C              .toneAfterClamp:
  69+ E11C 10 E6            DJNZ .toneLoop
  70+ E11E 18 30            JR .stepDone
  71+ E120
  72+ E120              .toneClamp:
  73+ E120 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ E122 18 F8            JR .toneAfterClamp
  75+ E124
  76+ E124              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ E124              .noiseLoop:
  78+ E124                  ; Semi-periodo HIGH con ruido
  79+ E124 7B               LD A, E
  80+ E125 F6 10            OR $10
  81+ E127 D3 FE            OUT ($FE), A
  82+ E129 ED 5F            LD A, R                     ; R register como PRNG
  83+ E12B A9               XOR C                       ; mezclar con pitch base
  84+ E12C E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ E12E F6 01            OR $01                      ; minimo 1
  86+ E130              .noiseDelayHi:
  87+ E130 3D               DEC A
  88+ E131 20 FD            JR NZ, .noiseDelayHi
  89+ E133
  90+ E133                  ; Semi-periodo LOW
  91+ E133 7B               LD A, E
  92+ E134 D3 FE            OUT ($FE), A
  93+ E136 ED 5F            LD A, R
  94+ E138 A9               XOR C
  95+ E139 E6 1F            AND $1F
  96+ E13B F6 01            OR $01
  97+ E13D              .noiseDelayLo:
  98+ E13D 3D               DEC A
  99+ E13E 20 FD            JR NZ, .noiseDelayLo
 100+ E140
 101+ E140                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ E140 79               LD A, C
 103+ E141 82               ADD A, D
 104+ E142 28 08            JR Z, .noiseClamp
 105+ E144 FA 4C E1         JP M, .noiseClamp
 106+ E147 4F               LD C, A
 107+ E148              .noiseAfterClamp:
 108+ E148 10 DA            DJNZ .noiseLoop
 109+ E14A 18 04            JR .stepDone
 110+ E14C
 111+ E14C              .noiseClamp:
 112+ E14C 0E 01            LD C, 1
 113+ E14E 18 F8            JR .noiseAfterClamp
 114+ E150
 115+ E150              .stepDone:
 116+ E150 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ E151 18 A0            JR .nextStep
 118+ E153
 119+ E153              .done:
 120+ E153 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ E154 D3 FE            OUT ($FE), A
 122+ E156 FB               EI
 123+ E157 C9               RET
 124+ E158
 125+ E158              ; ==============================================================================
 126+ E158              ; DATOS DE EFECTOS DE SONIDO
 127+ E158              ; ==============================================================================
 128+ E158
 129+ E158              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ E158              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ E158              SFX_FootstepTic:
 132+ E158 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ E15C 00               DEFB 0                      ; fin
 134+ E15D
 135+ E15D              SFX_FootstepTac:
 136+ E15D 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ E161 00               DEFB 0                      ; fin
 138+ E162
 139+ E162              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 140+ E162              ; Dos pasos: sweep rapido de agudo a grave
 141+ E162              SFX_Attack:
 142+ E162 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 143+ E166 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 144+ E16A 00               DEFB 0                      ; fin
 145+ E16B
 146+ E16B              ; --- SFX_EnemyDeath: "explosion" con ruido (~100ms) ---
 147+ E16B              ; Ruido percusivo seguido de tono descendente
 148+ E16B              SFX_EnemyDeath:
 149+ E16B 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ E16F 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ E173 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ E177 00               DEFB 0                      ; fin
 153+ E178
 154+ E178              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 155+ E178              ; Tono ascendente rapido seguido de ruido seco
 156+ E178              SFX_PlayerHit:
 157+ E178 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 158+ E17C 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 159+ E180 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 160+ E184 00               DEFB 0                      ; fin
 161+ E185
 162+ E185              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
 163+ E185              ; Tres tonos escalonados ascendentes
 164+ E185              SFX_ScreenTransition:
 165+ E185 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 166+ E189 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 167+ E18D 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 168+ E191 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 169+ E195 00               DEFB 0                      ; fin
 170+ E196
 171+ E196              ; --- SFX_EnemySpawn: "pop" ascendente + crackle (~70ms) ---
 172+ E196              ; Tono rapido ascendente y crujido
 173+ E196              SFX_EnemySpawn:
 174+ E196 19 23 FE 00      DEFB 25, 35, -2, 0         ; tono ascendente rapido
 175+ E19A 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 176+ E19E 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 177+ E1A2 00               DEFB 0                      ; fin
 178+ E1A3
 179+ E1A3              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 180+ E1A3              ; Tres escalones ascendentes, tipo recarga
 181+ E1A3              SFX_WellRecover:
 182+ E1A3 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 183+ E1A7 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 184+ E1AB 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 185+ E1AF 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 186+ E1B3 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
 187+ E1B7 3C 0C FF 00      DEFB 60, 12, -1, 0         ; sweep ascendente
 188+ E1BB 28 08 00 00      DEFB 40, 8, 0, 0           ; agudo brillante sostenido
 189+ E1BF 00               DEFB 0                      ; fin
 190+ E1C0
 191+ E1C0              ; --- SFX_Pickup: "ding" ascendente corto al recoger objeto (~50ms) ---
 192+ E1C0              SFX_Pickup:
 193+ E1C0 28 32 00 00      DEFB 40, 50, 0, 0          ; tono grave largo
 194+ E1C4 28 23 00 00      DEFB 40, 35, 0, 0          ; tono medio
 195+ E1C8 28 19 00 00      DEFB 40, 25, 0, 0          ; tono medio-agudo
 196+ E1CC 28 12 00 00      DEFB 40, 18, 0, 0          ; tono agudo
 197+ E1D0 32 0C FF 00      DEFB 50, 12, -1, 0         ; sweep ascendente final
 198+ E1D4 00               DEFB 0                      ; fin
 199+ E1D5
 200+ E1D5              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 201+ E1D5              ; Tono grave resonante con decay lento, como campana de iglesia
 202+ E1D5              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 203+ E1D5              SFX_BellChime:
 204+ E1D5 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 205+ E1D9 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 206+ E1DD 00               DEFB 0                      ; fin
 207+ E1DE
 208+ E1DE              ; --- Sistema de campanadas con pausa entre ellas ---
 209+ E1DE              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 210+ E1DE              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 211+ E1DE              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 212+ E1DE 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 213+ E1DF 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 214+ E1E1              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 215+ E1E1              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 216+ E1E1
 217+ E1E1              ; --- Cadena de eventos tras la ultima campanada ---
 218+ E1E1              ; last chime → (delay) → windows off → (delay) → monster spawn
 219+ E1E1              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 220+ E1E1              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 221+ E1E1 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 222+ E1E2 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 223+ E1E3
 224+ E1E3              ; ==============================================================================
 225+ E1E3              ; StartBellChimes - Inicia secuencia de 12 campanadas
 226+ E1E3              ; ==============================================================================
 227+ E1E3              StartBellChimes:
 228+ E1E3 3E 03            LD A, 3                             ; DEBUG: 3 campanadas (era 12)
 229+ E1E5 32 DE E1         LD (BellCount), A
 230+ E1E8                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 231+ E1E8 2A 78 5C         LD HL, (SYS_FRAMES)
 232+ E1EB 22 DF E1         LD (BellNextFrame), HL
 233+ E1EE 3E 7D            LD A, SCARE_TIMER_BELLS
 234+ E1F0 32 B1 A5         LD (ScareTimer), A
 235+ E1F3 C9               RET
 236+ E1F4
 237+ E1F4              ; ==============================================================================
 238+ E1F4              ; UpdateBellChimes - Llamar cada frame desde el main loop
 239+ E1F4              ; ==============================================================================
 240+ E1F4              UpdateBellChimes:
 241+ E1F4 3A DE E1         LD A, (BellCount)
 242+ E1F7 B7               OR A
 243+ E1F8 C8               RET Z                       ; sin campanadas pendientes
 244+ E1F9
 245+ E1F9                  ; Comparar FRAMES actual con BellNextFrame
 246+ E1F9 2A 78 5C         LD HL, (SYS_FRAMES)
 247+ E1FC ED 5B DF E1      LD DE, (BellNextFrame)
 248+ E200 B7               OR A
 249+ E201 ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 250+ E203 D8               RET C                       ; FRAMES < deadline → aun no toca
 251+ E204
 252+ E204                  ; Sonar campanada (AY, no bloquea CPU)
 253+ E204 C5               PUSH BC
 254+ E205 D5               PUSH DE
 255+ E206 CD 8E E2         CALL AY_PlayBellChime
 256+ E209 D1               POP DE
 257+ E20A C1               POP BC
 258+ E20B
 259+ E20B                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 260+ E20B                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 261+ E20B 2A 78 5C         LD HL, (SYS_FRAMES)
 262+ E20E 11 4B 00         LD DE, BELL_PAUSE
 263+ E211 19               ADD HL, DE
 264+ E212 22 DF E1         LD (BellNextFrame), HL
 265+ E215
 266+ E215 21 DE E1         LD HL, BellCount
 267+ E218 35               DEC (HL)
 268+ E219 C0               RET NZ
 269+ E21A 18 00            JR .bellsDone
 270+ E21C
 271+ E21C              .bellsDone:
 272+ E21C                  ; Ultima campanada:
 273+ E21C                  ;   1) matar todos los nasties vivos (puff)
 274+ E21C                  ;   2) arrancar cadena diferida: windows off → monster spawn
 275+ E21C CD F3 A8         CALL KillAllActiveNasties
 276+ E21F 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 277+ E221 32 E1 E1         LD (BellsDoneTimer), A
 278+ E224 C9               RET
 279+ E225
 280+ E225              ; ==============================================================================
 281+ E225              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 282+ E225              ; ==============================================================================
 283+ E225              ; Maneja la cadena diferida tras la ultima campanada:
 284+ E225              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 285+ E225              ;      y arranca SpawnAfterWinTimer
 286+ E225              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 287+ E225              ; ==============================================================================
 288+ E225              UpdateBellsDoneTimer:
 289+ E225 3A E1 E1         LD A, (BellsDoneTimer)
 290+ E228 B7               OR A
 291+ E229 28 14            JR Z, .ubdCheckSpawn
 292+ E22B 3D               DEC A
 293+ E22C 32 E1 E1         LD (BellsDoneTimer), A
 294+ E22F 20 0E            JR NZ, .ubdCheckSpawn
 295+ E231                  ; Llego a 0: apagar ventanas
 296+ E231 CD 36 D6         CALL UpdateRemapTables
 297+ E234 3E 01            LD A, 1
 298+ E236 32 D1 81         LD (AttrsDirty), A
 299+ E239 3E 26            LD A, POST_WINDOWS_SPAWN_DELAY
 300+ E23B 32 E2 E1         LD (SpawnAfterWinTimer), A
 301+ E23E C9               RET
 302+ E23F              .ubdCheckSpawn:
 303+ E23F 3A E2 E1         LD A, (SpawnAfterWinTimer)
 304+ E242 B7               OR A
 305+ E243 C8               RET Z
 306+ E244 3D               DEC A
 307+ E245 32 E2 E1         LD (SpawnAfterWinTimer), A
 308+ E248 C0               RET NZ
 309+ E249                  ; Llego a 0: spawnear monsters
 310+ E249 C3 B9 A9         JP SpawnMonsters
 311+ E24C
