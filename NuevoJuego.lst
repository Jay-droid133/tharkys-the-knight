 618+ 66A6              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 619+ 66A6              ; ==============================================================================
 620+ 66A6              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 621+ 66A6              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 622+ 66A6              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 623+ 66A6              ;   2. Leer charX/charY de la entry
 624+ 66A6              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 625+ 66A6              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 626+ 66A6              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 627+ 66A6              ;   6. ChurchDoorOpen = 0
 628+ 66A6              ; ==============================================================================
 629+ 66A6              CloseChurchDoor:
 630+ 66A6                  ; SFX "chof" del cierre — distinto del creak (SFX_ChurchDoorOpen) que
 631+ 66A6                  ; usa la misma puerta al ABRIR. ABRIR = creak (madera girando con esfuerzo);
 632+ 66A6                  ; CERRAR = chof (impacto contra el marco). SFX_DoorClose compartido con la
 633+ 66A6                  ; cinematica del banco (HAND_OUT + HAND_OPEN_IN). Suena ANTES del cambio visual.
 634+ 66A6 21 FE FA         LD HL, SFX_DoorClose
