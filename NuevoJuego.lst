3378+ A5BC              ; ==============================================================================
3379+ A5BC              ; UpdateDying - Avanza animacion puff (6 frames), luego programa erase pendiente
3380+ A5BC              ; ==============================================================================
3381+ A5BC              ; IX = entidad en STATE_DYING. ANIMBASE = SPRID_PUFF.
3382+ A5BC              ; Cuando el ultimo frame expira → programa erase pendiente + TYPE_NONE.
3383+ A5BC              ; El erase final se ejecutara en EraseDeadSprites del siguiente frame.
3384+ A5BC              ; ==============================================================================
3385+ A5BC              UpdateDying:
3386+ A5BC DD 35 09         DEC (IX+ENT_ANIMTIMER)
3387+ A5BF 20 1D            JR NZ, .dyAnimDone
3388+ A5C1                  ; Timer expirado → avanzar frame
3389+ A5C1 3E 02            LD A, ANIM_DELAY_PUFF
3390+ A5C3 DD 77 09         LD (IX+ENT_ANIMTIMER), A
3391+ A5C6 DD 7E 00         LD A, (IX+ENT_SPRITEID)
3392+ A5C9 3C               INC A
3393+ A5CA 47               LD B, A
3394+ A5CB DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de puff
3395+ A5CE FE 06            CP ANIM_FRAMES_PUFF             ; >= 6 → animacion terminada
3396+ A5D0 38 09            JR C, .dyFrameOk
3397+ A5D2                  ; Animacion puff terminada: desactivar entidad
3398+ A5D2                  ; (el erase del ultimo frame ya se hizo en ProcessOneEnemy.peDying)
3399+ A5D2 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
3400+ A5D6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
3401+ A5DA C9               RET
3402+ A5DB              .dyFrameOk:
3403+ A5DB DD 70 00         LD (IX+ENT_SPRITEID), B
3404+ A5DE              .dyAnimDone:
3405+ A5DE C9               RET
