1474+ F564              ; ==============================================================================
1475+ F564              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1476+ F564              ; ==============================================================================
1477+ F564              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1478+ F564              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1479+ F564              ; ==============================================================================
1480+ F564              ChurchCutsceneEraseStatueAtLast:
1481+ F564              ChurchCutsceneDrawStatueAtLast:
1482+ F564 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1483+ F567 21 B1 64         LD HL, StatueIdTable
1484+ F56A 5F               LD E, A
1485+ F56B 16 00            LD D, 0
1486+ F56D 19               ADD HL, DE
1487+ F56E 7E               LD A, (HL)                              ; A = statue id
1488+ F56F B7               OR A
1489+ F570 C8               RET Z
1490+ F571                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1491+ F571 6F               LD L, A
1492+ F572 26 00            LD H, 0
1493+ F574 54               LD D, H
1494+ F575 5D               LD E, L
1495+ F576 29               ADD HL, HL
1496+ F577 19               ADD HL, DE                              ; HL = id*3
1497+ F578 11 55 E0         LD DE, BgGfxPtrById
1498+ F57B 19               ADD HL, DE
1499+ F57C 5E               LD E, (HL)
1500+ F57D 23               INC HL
1501+ F57E 56               LD D, (HL)                              ; DE = sprite ptr
1502+ F57F 23               INC HL
1503+ F580 7E               LD A, (HL)                              ; A = bank
1504+ F581 EB               EX DE, HL                               ; HL = sprite ptr
1505+ F582 CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1506+ F585                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1507+ F585 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1508+ F588 57               LD D, A
1509+ F589 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1510+ F58C 5F               LD E, A
1511+ F58D C3 39 66         JP DrawBgSprite16XorAtPixel
1512+ F590
1513+ F590              ; ==============================================================================
1514+ F590              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1515+ F590              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1516+ F590              ;     A  = jitter signed (-1, 0, +1) en bits.
1517+ F590              ; ==============================================================================
1518+ F590              ; IN: A = jitter signed (-1, 0, +1) en bits.
1519+ F590              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1520+ F590              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1521+ F590              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1522+ F590              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1523+ F590              ; version shifted, sin XOR.
1524+ F590              ;
1525+ F590              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1526+ F590              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1527+ F590              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1528+ F590              ; estatua se perdio cuando la estatua se pinto la primera vez con
1529+ F590              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1530+ F590              ; de la estatua, el wall perdido no se ve.
1531+ F590              ;
1532+ F590              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1533+ F590              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1534+ F590              ; shift de 1 bit no pierde pixels visibles.
1535+ F590              ; Destruye: AF, BC, DE, HL, IX.
1536+ F590              ; ==============================================================================
1537+ F590              ChurchCutsceneShakeStatueByteShift:
1538+ F590 32 FA F5         LD (.csbsJitter), A
1539+ F593                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1540+ F593 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1541+ F596 5F               LD E, A
1542+ F597 16 00            LD D, 0
1543+ F599 19               ADD HL, DE
1544+ F59A 7E               LD A, (HL)
1545+ F59B B7               OR A
1546+ F59C C8               RET Z                                   ; sin estatua
1547+ F59D 6F               LD L, A
1548+ F59E 26 00            LD H, 0
1549+ F5A0 54               LD D, H
1550+ F5A1 5D               LD E, L
1551+ F5A2 29               ADD HL, HL
1552+ F5A3 19               ADD HL, DE                              ; HL = id*3
1553+ F5A4 11 55 E0         LD DE, BgGfxPtrById
1554+ F5A7 19               ADD HL, DE
1555+ F5A8 5E               LD E, (HL)
1556+ F5A9 23               INC HL
1557+ F5AA 56               LD D, (HL)                              ; DE = sprite ptr
1558+ F5AB 23               INC HL
1559+ F5AC 7E               LD A, (HL)                              ; A = bank
1560+ F5AD EB               EX DE, HL                               ; HL = sprite ptr
1561+ F5AE CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1562+ F5B1                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1563+ F5B1 DD 21 EE 86      LD IX, BgSpriteBuffer
1564+ F5B5 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1565+ F5B8 B7               OR A
1566+ F5B9 C8               RET Z
1567+ F5BA 47               LD B, A                                 ; B = row counter
1568+ F5BB DD 23            INC IX
1569+ F5BD DD 23            INC IX                                  ; IX -> pixel data
1570+ F5BF                  ; Calcular addr VRAM en (origX, origY)
1571+ F5BF 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1572+ F5C2 57               LD D, A
1573+ F5C3 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1574+ F5C6 5F               LD E, A
1575+ F5C7 CD 53 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1576+ F5CA              .csbsRow:
1577+ F5CA C5               PUSH BC
1578+ F5CB E5               PUSH HL                                 ; save inicio fila VRAM
1579+ F5CC                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1580+ F5CC DD 7E 00         LD A, (IX+0)
1581+ F5CF 2F               CPL
1582+ F5D0 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1583+ F5D1 DD 7E 01         LD A, (IX+1)
1584+ F5D4 2F               CPL
1585+ F5D5 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1586+ F5D6                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1587+ F5D6 3A FA F5         LD A, (.csbsJitter)
1588+ F5D9 B7               OR A
1589+ F5DA 28 0D            JR Z, .csbsWrite                        ; sin shift
1590+ F5DC FA E5 F5         JP M, .csbsLeft                         ; A < 0 -> shift left
1591+ F5DF                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1592+ F5DF CB 3A            SRL D
1593+ F5E1 CB 1B            RR E
1594+ F5E3 18 04            JR .csbsWrite
1595+ F5E5              .csbsLeft:
1596+ F5E5 CB 23            SLA E
1597+ F5E7 CB 12            RL D
1598+ F5E9              .csbsWrite:
1599+ F5E9 7A               LD A, D
1600+ F5EA 77               LD (HL), A
1601+ F5EB 23               INC HL
1602+ F5EC 7B               LD A, E
1603+ F5ED 77               LD (HL), A
1604+ F5EE E1               POP HL
1605+ F5EF CD BF 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1606+ F5F2 DD 23            INC IX
1607+ F5F4 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1608+ F5F6 C1               POP BC
1609+ F5F7 10 D1            DJNZ .csbsRow
1610+ F5F9 C9               RET
1611+ F5FA 00           .csbsJitter: DEFB 0
1612+ F5FB
1613+ F5FB              ; ==============================================================================
1614+ F5FB              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1615+ F5FB              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1616+ F5FB              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1617+ F5FB              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1618+ F5FB              ; Destruye: AF, BC, HL.
1619+ F5FB              ; ==============================================================================
1620+ F5FB              ChurchCutsceneEraseStatueDirect:
1621+ F5FB 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1622+ F5FE 57               LD D, A
1623+ F5FF 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1624+ F602 5F               LD E, A
1625+ F603 CD 53 9D         CALL CalcPixelAddr
1626+ F606 06 18            LD B, 24                                ; statues son 24 px de alto
1627+ F608              .csedRow:
1628+ F608 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1629+ F609 77               LD (HL), A
1630+ F60A 23               INC HL
1631+ F60B 77               LD (HL), A
1632+ F60C 2B               DEC HL                                  ; volver a inicio fila
1633+ F60D C5               PUSH BC
1634+ F60E CD BF 9A         CALL NextPixelLine
1635+ F611 C1               POP BC
1636+ F612 10 F4            DJNZ .csedRow
1637+ F614 C9               RET
