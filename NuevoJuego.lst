4486+ BAEA              ; ==============================================================================
4487+ BAEA              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4488+ BAEA              ; ==============================================================================
4489+ BAEA              SpawnOneNasty:
4490+ BAEA                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4491+ BAEA ED 5F            LD A, R
4492+ BAEC E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4493+ BAEE 6F               LD L, A
4494+ BAEF 26 00            LD H, 0
4495+ BAF1 ED 5B 08 C0      LD DE, (CurrentNastyTable)
4496+ BAF5 19               ADD HL, DE
4497+ BAF6 7E               LD A, (HL)
4498+ BAF7
4499+ BAF7                  ; Configurar entidad base
4500+ BAF7 DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4501+ BAFA DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4502+ BAFE DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4503+ BB02                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4504+ BB02                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4505+ BB02 3A 08 C0         LD A, (CurrentNastyTable)
4506+ BB05 FE EF            CP LOW CrepuscularTypeTable
4507+ BB07 20 0B            JR NZ, .spnDay
4508+ BB09 3A 09 C0         LD A, (CurrentNastyTable + 1)
4509+ BB0C FE BF            CP HIGH CrepuscularTypeTable
4510+ BB0E 20 04            JR NZ, .spnDay
4511+ BB10 3E 68            LD A, SPRID_SPAWN_NIGHT
4512+ BB12 18 02            JR .spnSet
4513+ BB14              .spnDay:
4514+ BB14 3E 46            LD A, SPRID_SPAWN
4515+ BB16              .spnSet:
4516+ BB16 DD 77 00         LD (IX+ENT_SPRITEID), A
4517+ BB19 DD 77 08         LD (IX+ENT_ANIMBASE), A
4518+ BB1C DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4519+ BB20 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4520+ BB24
4521+ BB24                  ; Color segun tipo (cada tipo tiene color fijo)
4522+ BB24 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4523+ BB27 21 F3 BF         LD HL, NastyColorTable
4524+ BB2A D5               PUSH DE
4525+ BB2B 11 20 00         LD DE, SPRID_ENEMY_0
4526+ BB2E 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4527+ BB2F CB 3F            SRL A
4528+ BB31 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4529+ BB33 5F               LD E, A
4530+ BB34 16 00            LD D, 0
4531+ BB36 19               ADD HL, DE
4532+ BB37 7E               LD A, (HL)
4533+ BB38 D1               POP DE
4534+ BB39              .setAttr:
4535+ BB39 DD 77 05         LD (IX+ENT_ATTR), A
4536+ BB3C
4537+ BB3C                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4538+ BB3C                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4539+ BB3C                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4540+ BB3C                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4541+ BB3C                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4542+ BB3C                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4543+ BB3C 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4544+ BB3E 32 9C BC         LD (.spawnW1), A
4545+ BB41 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4546+ BB43 32 9D BC         LD (.spawnH1), A
4547+ BB46
4548+ BB46                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4549+ BB46                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4550+ BB46                  ; Sin rebuild aqui = sin lag por spawn.)
4551+ BB46                  ; Posicion aleatoria (con reintentos)
4552+ BB46 3E 08            LD A, 8                             ; mas reintentos: ahora tambien hay min-distance check
4553+ BB48 32 9A BC         LD (.spawnTries), A
4554+ BB4B AF               XOR A
4555+ BB4C 32 9B BC         LD (.spawnIgnoreZone), A            ; primera ronda respeta zona del player
