 136+ E928              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 137+ E928              ; ==============================================================================
 138+ E928              CheckMilestoneDebugKey:
 139+ E928 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 140+ E92A DB FE            IN A, ($FE)
 141+ E92C CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 142+ E92E 20 1D            JR NZ, .cmdkNotPressed
