# file closed: town_gate_cutscene.asm
  94  66A8
  95  66A8                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
  96  66A8                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
  97  66A8                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
  98  66A8                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
  99  66A8                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 100  66A8                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 66A8              ; ==============================================================================
   2+ 66A8              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 66A8              ; ==============================================================================
   4+ 66A8              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 66A8              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 66A8              ; la cinematica — invisible porque es one-shot.
   7+ 66A8              ;
   8+ 66A8              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 66A8              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 66A8              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 66A8              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 66A8              ; ==============================================================================
  13+ 66A8
  14+ 66A8              ; ==============================================================================
  15+ 66A8              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 66A8              ; ==============================================================================
  17+ 66A8              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 66A8              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 66A8              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 66A8              ; ChurchCutsceneSlot.
  21+ 66A8              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 66A8              ; ==============================================================================
  23+ 66A8              EraseChurchTrappedMonster:
  24+ 66A8 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 66AB 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 66AC 6F               LD L, A
  27+ 66AD 26 00            LD H, 0
  28+ 66AF 29               ADD HL, HL
  29+ 66B0 29               ADD HL, HL
  30+ 66B1 29               ADD HL, HL
  31+ 66B2 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 66B3 11 3F 81         LD DE, EntityTable
  33+ 66B6 19               ADD HL, DE
  34+ 66B7 E5               PUSH HL
  35+ 66B8 DD E1            POP IX
  36+ 66BA CD 12 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66BD DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66C0 57               LD D, A
  39+ 66C1 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66C4 5F               LD E, A
  41+ 66C5 DD 2A 9A A7      LD IX, (OldSprAddr)
  42+ 66C9 C3 1F 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 66CC
  44+ 66CC              ; ==============================================================================
  45+ 66CC              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 66CC              ; ==============================================================================
  47+ 66CC              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 66CC              ; - Despawn monster (ENT_TYPE=0).
  49+ 66CC              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 66CC              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 66CC              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 66CC              ; ==============================================================================
  53+ 66CC              ApplyChurchTrapDone:
  54+ 66CC                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 66CC 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 66CF 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 66D0 6F               LD L, A
  58+ 66D1 26 00            LD H, 0
  59+ 66D3 29               ADD HL, HL
  60+ 66D4 29               ADD HL, HL
  61+ 66D5 29               ADD HL, HL
  62+ 66D6 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 66D7 11 3F 81         LD DE, EntityTable
  64+ 66DA 19               ADD HL, DE
  65+ 66DB E5               PUSH HL
  66+ 66DC DD E1            POP IX
  67+ 66DE                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 66DE                  ; guardado en TriggerChurchTrap).
  69+ 66DE 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 66E1 21 5E 67         LD HL, ChurchTrapBitMask
  71+ 66E4 5F               LD E, A
  72+ 66E5 16 00            LD D, 0
  73+ 66E7 19               ADD HL, DE
  74+ 66E8 7E               LD A, (HL)
  75+ 66E9 21 61 82         LD HL, MonsterTrappedFlags
  76+ 66EC B6               OR (HL)
  77+ 66ED 77               LD (HL), A
  78+ 66EE                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 66EE                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 66EE                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 66EE 21 62 82         LD HL, NextChurchTrapStep
  82+ 66F1 34               INC (HL)
  83+ 66F2                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 66F2                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 66F2                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 66F2                  ; antes de quedarse fija en blanco brillante.
  87+ 66F2 DD E5            PUSH IX
  88+ 66F4 CD FA F3         CALL StartStatueBlink
  89+ 66F7 DD E1            POP IX
  90+ 66F9                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 66F9                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 66F9                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 66F9 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 66FD DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 6701 DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 6705 DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 6709                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 6709                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 6709                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 6709                  ; anteriores del cutscene.)
 101+ 6709                  ; Decidir spawn: 3 atrapados?
 102+ 6709 3A 61 82         LD A, (MonsterTrappedFlags)
 103+ 670C E6 07            AND $07
 104+ 670E FE 07            CP $07
 105+ 6710 28 12            JR Z, .actdAllTrapped
 106+ 6712                  ; <3 atrapados: respawn church_key en AltN
 107+ 6712 3E 01            LD A, 1
 108+ 6714 32 54 82         LD (ChurchKeySpawned), A
 109+ 6717 21 64 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 671A 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 671B CD AF 69         CALL RespawnChurchKeyAtAlt
 112+ 671E                  ; Dibujar surgical en su nueva posicion
 113+ 671E 11 DF DB         LD DE, BgGfx_church_key
 114+ 6721 C3 E4 D9         JP RedrawPickupByPtr
 115+ 6724              .actdAllTrapped:
 116+ 6724                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 6724                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 6724                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 6724                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 6724                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 6724                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 6724 AF               XOR A
 123+ 6725 32 57 82         LD (TimeFrozen), A
 124+ 6728 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 672A 32 67 82         LD (PostTrapPauseTimer), A
 126+ 672D C9               RET
 127+ 672E
 128+ 672E              ; ==============================================================================
 129+ 672E              ; UpdatePostTrapPause - Tick + dispara eventos diferidos tras cutscene de iglesia
 130+ 672E              ; ==============================================================================
 131+ 672E              ; Llamado cada frame desde MainLoop. No-op si timer = 0 (caso normal).
 132+ 672E              ; Cuando ApplyChurchTrapDone setea el timer a 50, esta rutina decrementa cada
 133+ 672E              ; frame y dispara los eventos a los frames precisos:
 134+ 672E              ;   timer=25 (= 1s desde inicio): aparece town_gate_key + advance milestone 7→8.
 135+ 672E              ;   timer=0  (= 2s desde inicio): nasties resumen (via guard en TrySpawnNasty).
 136+ 672E              ; ==============================================================================
 137+ 672E              UpdatePostTrapPause:
 138+ 672E 3A 67 82         LD A, (PostTrapPauseTimer)
 139+ 6731 B7               OR A
 140+ 6732 C8               RET Z
 141+ 6733 3D               DEC A
 142+ 6734 32 67 82         LD (PostTrapPauseTimer), A
 143+ 6737 FE 4B            CP POST_TRAP_KEY_DELAY              ; ¿cae justo en el frame del key spawn?
 144+ 6739 C0               RET NZ
