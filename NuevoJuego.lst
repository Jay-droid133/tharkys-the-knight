 227+ 9DAC              ; ==============================================================================
 228+ 9DAC              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9DAC              ; ==============================================================================
 230+ 9DAC              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9DAC              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9DAC              ;
 233+ 9DAC              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9DAC              ; ==============================================================================
 235+ 9DAC              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9DAC              NextPixelLine:
 237+ 9DAC 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9DAD 7C               LD A, H
 239+ 9DAE E6 07            AND 7
 240+ 9DB0 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9DB1
 242+ 9DB1                  ; --- Cruce de character row ---
 243+ 9DB1 7D               LD A, L
 244+ 9DB2 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9DB4 6F               LD L, A
 246+ 9DB5 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9DB7 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9DB8
 249+ 9DB8                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9DB8 7C               LD A, H
 251+ 9DB9 D6 08            SUB 8
 252+ 9DBB 67               LD H, A
 253+ 9DBC C9               RET
