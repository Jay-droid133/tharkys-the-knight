 164+ E953              ; ==============================================================================
 165+ E953              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 166+ E953              ; ==============================================================================
 167+ E953              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 168+ E953              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 169+ E953              ; inmediato del valor actual.
 170+ E953              ; ==============================================================================
 171+ E953              CheckCurrentKeyCycleKey:
 172+ E953 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 173+ E955 DB FE            IN A, ($FE)
 174+ E957 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 175+ E959 20 17            JR NZ, .ckcNotPressed
 176+ E95B 3A 77 E9         LD A, (CurrentKeyCycleDebounce)
 177+ E95E B7               OR A
 178+ E95F C0               RET NZ
 179+ E960 3E 01            LD A, 1
 180+ E962 32 77 E9         LD (CurrentKeyCycleDebounce), A
 181+ E965 3A 27 82         LD A, (CurrentKey)
 182+ E968 3C               INC A
 183+ E969 FE 07            CP 7
 184+ E96B 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 185+ E96D AF               XOR A                               ; 7 -> wrap a 0
 186+ E96E              .ckcSet:
 187+ E96E 32 27 82         LD (CurrentKey), A
 188+ E971 C9               RET
 189+ E972              .ckcNotPressed:
