 475+ A3BF              ; ==============================================================================
 476+ A3BF              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 477+ A3BF              ; ==============================================================================
 478+ A3BF              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 479+ A3BF              ; ==============================================================================
 480+ A3BF              ProcessOneEnemy:
 481+ A3BF                  ; --- Frozen monster gate (durante muerte del player) ---
 482+ A3BF                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 483+ A3BF                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 484+ A3BF                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 485+ A3BF 3A 82 82         LD A, (MonstersFrozen)
 486+ A3C2 B7               OR A
 487+ A3C3 28 08            JR Z, .peDispatch
 488+ A3C5 DD 7E 01         LD A, (IX+ENT_TYPE)
 489+ A3C8 FE 02            CP TYPE_MONSTER
 490+ A3CA CA 32 A4         JP Z, .peCalcAndDraw
 491+ A3CD              .peDispatch:
 492+ A3CD                  ; --- Dispatch segun estado ---
 493+ A3CD DD 7E 02         LD A, (IX+ENT_STATE)
 494+ A3D0 FE 03            CP STATE_DYING
 495+ A3D2 CA 44 A6         JP Z, .peDying
 496+ A3D5 FE 04            CP STATE_SPAWNING
 497+ A3D7 CA F9 A6         JP Z, .peSpawning
 498+ A3DA FE 05            CP STATE_SCARED
 499+ A3DC CA 21 A5         JP Z, .peScared
 500+ A3DF FE 06            CP STATE_ATTACKING
 501+ A3E1 CA 14 A5         JP Z, .peAttacking
 502+ A3E4
 503+ A3E4                  ; === STATE_RUNNING ===
 504+ A3E4                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 505+ A3E4 3A D4 B8         LD A, (ScareTimer)
 506+ A3E7 B7               OR A
 507+ A3E8 28 1E            JR Z, .peRunning
 508+ A3EA DD 7E 01         LD A, (IX+ENT_TYPE)
 509+ A3ED FE 03            CP TYPE_NASTY
 510+ A3EF 28 08            JR Z, .peDoScare
 511+ A3F1 FE 02            CP TYPE_MONSTER
 512+ A3F3 20 13            JR NZ, .peRunning
 513+ A3F5                  ; Monster: limpiar stun antes de asustar
 514+ A3F5 DD 36 0A 00      LD (IX+ENT_DIR), 0
 515+ A3F9              .peDoScare:
 516+ A3F9 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 517+ A3FD DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 518+ A401 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 519+ A405 C3 21 A5         JP .peScared
 520+ A408              .peRunning:
 521+ A408 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 522+ A40C C2 B8 A4         JP NZ, .peFresh
 523+ A40F
 524+ A40F                  ; --- Logica: AI + movimiento + animacion ---
 525+ A40F DD 7E 01         LD A, (IX+ENT_TYPE)
 526+ A412 FE 05            CP TYPE_DEATH
 527+ A414 28 14            JR Z, .peDeathAI
 528+ A416 FE 02            CP TYPE_MONSTER
 529+ A418 20 15            JR NZ, .peNormalAI
 530+ A41A AF               XOR A
 531+ A41B 32 3D B6         LD (MonsterKbDespawn), A        ; Reset flag
 532+ A41E CD C5 B0         CALL UpdateMonster
 533+ A421 3A 3D B6         LD A, (MonsterKbDespawn)
 534+ A424 B7               OR A
 535+ A425 C2 1C A6         JP NZ, .peScaredDespawn         ; Knockback offscreen → borrar y despawnear
