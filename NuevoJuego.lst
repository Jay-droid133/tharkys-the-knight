1254+ EE16              ; ==============================================================================
1255+ EE16              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1256+ EE16              ; ==============================================================================
1257+ EE16              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1258+ EE16              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1259+ EE16              ; ==============================================================================
1260+ EE16              ChurchCutsceneEraseStatueAtLast:
1261+ EE16              ChurchCutsceneDrawStatueAtLast:
1262+ EE16 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1263+ EE19 21 DE EF         LD HL, StatueIdTable
1264+ EE1C 5F               LD E, A
1265+ EE1D 16 00            LD D, 0
1266+ EE1F 19               ADD HL, DE
1267+ EE20 7E               LD A, (HL)                              ; A = statue id
1268+ EE21 B7               OR A
1269+ EE22 C8               RET Z
1270+ EE23                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1271+ EE23 6F               LD L, A
1272+ EE24 26 00            LD H, 0
1273+ EE26 54               LD D, H
1274+ EE27 5D               LD E, L
1275+ EE28 29               ADD HL, HL
1276+ EE29 19               ADD HL, DE                              ; HL = id*3
1277+ EE2A 11 23 DA         LD DE, BgGfxPtrById
1278+ EE2D 19               ADD HL, DE
1279+ EE2E 5E               LD E, (HL)
1280+ EE2F 23               INC HL
1281+ EE30 56               LD D, (HL)                              ; DE = sprite ptr
1282+ EE31 23               INC HL
1283+ EE32 7E               LD A, (HL)                              ; A = bank
1284+ EE33 EB               EX DE, HL                               ; HL = sprite ptr
1285+ EE34 CD 0A 91         CALL LoadBgSpriteToBuffer               ; preserva BC
1286+ EE37                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1287+ EE37 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1288+ EE3A 57               LD D, A
1289+ EE3B 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1290+ EE3E 5F               LD E, A
1291+ EE3F C3 66 F1         JP DrawBgSprite16XorAtPixel
1292+ EE42
1293+ EE42              ; ==============================================================================
1294+ EE42              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1295+ EE42              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1296+ EE42              ;     A  = jitter signed (-1, 0, +1) en bits.
1297+ EE42              ; ==============================================================================
1298+ EE42              ; IN: A = jitter signed (-1, 0, +1) en bits.
1299+ EE42              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1300+ EE42              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1301+ EE42              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1302+ EE42              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1303+ EE42              ; version shifted, sin XOR.
1304+ EE42              ;
1305+ EE42              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1306+ EE42              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1307+ EE42              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1308+ EE42              ; estatua se perdio cuando la estatua se pinto la primera vez con
1309+ EE42              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1310+ EE42              ; de la estatua, el wall perdido no se ve.
1311+ EE42              ;
1312+ EE42              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1313+ EE42              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1314+ EE42              ; shift de 1 bit no pierde pixels visibles.
1315+ EE42              ; Destruye: AF, BC, DE, HL, IX.
1316+ EE42              ; ==============================================================================
1317+ EE42              ChurchCutsceneShakeStatueByteShift:
1318+ EE42 32 AC EE         LD (.csbsJitter), A
1319+ EE45                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1320+ EE45 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1321+ EE48 5F               LD E, A
1322+ EE49 16 00            LD D, 0
1323+ EE4B 19               ADD HL, DE
1324+ EE4C 7E               LD A, (HL)
1325+ EE4D B7               OR A
1326+ EE4E C8               RET Z                                   ; sin estatua
1327+ EE4F 6F               LD L, A
1328+ EE50 26 00            LD H, 0
1329+ EE52 54               LD D, H
1330+ EE53 5D               LD E, L
1331+ EE54 29               ADD HL, HL
1332+ EE55 19               ADD HL, DE                              ; HL = id*3
1333+ EE56 11 23 DA         LD DE, BgGfxPtrById
1334+ EE59 19               ADD HL, DE
1335+ EE5A 5E               LD E, (HL)
1336+ EE5B 23               INC HL
1337+ EE5C 56               LD D, (HL)                              ; DE = sprite ptr
1338+ EE5D 23               INC HL
1339+ EE5E 7E               LD A, (HL)                              ; A = bank
1340+ EE5F EB               EX DE, HL                               ; HL = sprite ptr
1341+ EE60 CD 0A 91         CALL LoadBgSpriteToBuffer               ; preserva BC
1342+ EE63                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1343+ EE63 DD 21 42 89      LD IX, BgSpriteBuffer
1344+ EE67 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1345+ EE6A B7               OR A
1346+ EE6B C8               RET Z
1347+ EE6C 47               LD B, A                                 ; B = row counter
1348+ EE6D DD 23            INC IX
1349+ EE6F DD 23            INC IX                                  ; IX -> pixel data
1350+ EE71                  ; Calcular addr VRAM en (origX, origY)
1351+ EE71 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1352+ EE74 57               LD D, A
1353+ EE75 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1354+ EE78 5F               LD E, A
1355+ EE79 CD BA A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1356+ EE7C              .csbsRow:
1357+ EE7C C5               PUSH BC
1358+ EE7D E5               PUSH HL                                 ; save inicio fila VRAM
1359+ EE7E                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1360+ EE7E DD 7E 00         LD A, (IX+0)
1361+ EE81 2F               CPL
1362+ EE82 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1363+ EE83 DD 7E 01         LD A, (IX+1)
1364+ EE86 2F               CPL
1365+ EE87 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1366+ EE88                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1367+ EE88 3A AC EE         LD A, (.csbsJitter)
1368+ EE8B B7               OR A
1369+ EE8C 28 0D            JR Z, .csbsWrite                        ; sin shift
1370+ EE8E FA 97 EE         JP M, .csbsLeft                         ; A < 0 -> shift left
1371+ EE91                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1372+ EE91 CB 3A            SRL D
1373+ EE93 CB 1B            RR E
1374+ EE95 18 04            JR .csbsWrite
1375+ EE97              .csbsLeft:
1376+ EE97 CB 23            SLA E
1377+ EE99 CB 12            RL D
1378+ EE9B              .csbsWrite:
1379+ EE9B 7A               LD A, D
1380+ EE9C 77               LD (HL), A
1381+ EE9D 23               INC HL
1382+ EE9E 7B               LD A, E
1383+ EE9F 77               LD (HL), A
1384+ EEA0 E1               POP HL
1385+ EEA1 CD 26 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1386+ EEA4 DD 23            INC IX
1387+ EEA6 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1388+ EEA8 C1               POP BC
1389+ EEA9 10 D1            DJNZ .csbsRow
1390+ EEAB C9               RET
1391+ EEAC 00           .csbsJitter: DEFB 0
1392+ EEAD
1393+ EEAD              ; ==============================================================================
1394+ EEAD              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1395+ EEAD              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1396+ EEAD              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1397+ EEAD              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1398+ EEAD              ; Destruye: AF, BC, HL.
1399+ EEAD              ; ==============================================================================
1400+ EEAD              ChurchCutsceneEraseStatueDirect:
1401+ EEAD 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1402+ EEB0 57               LD D, A
1403+ EEB1 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1404+ EEB4 5F               LD E, A
1405+ EEB5 CD BA A0         CALL CalcPixelAddr
1406+ EEB8 06 18            LD B, 24                                ; statues son 24 px de alto
1407+ EEBA              .csedRow:
1408+ EEBA AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1409+ EEBB 77               LD (HL), A
1410+ EEBC 23               INC HL
1411+ EEBD 77               LD (HL), A
1412+ EEBE 2B               DEC HL                                  ; volver a inicio fila
1413+ EEBF C5               PUSH BC
1414+ EEC0 CD 26 9E         CALL NextPixelLine
1415+ EEC3 C1               POP BC
1416+ EEC4 10 F4            DJNZ .csedRow
1417+ EEC6 C9               RET
1418+ EEC7
1419+ EEC7              ; ==============================================================================
1420+ EEC7              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1421+ EEC7              ; ==============================================================================
1422+ EEC7              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1423+ EEC7              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1424+ EEC7              ; suficiente para corromper visualmente).
1425+ EEC7              ; IN: IX = entity ptr.
1426+ EEC7              ; ==============================================================================
1427+ EEC7              RedrawTrappedMonster:
1428+ EEC7                  ; --- Erase viejo en (OLDX, OLDY) ---
1429+ EEC7 CD 91 A7         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1430+ EECA DD 7E 0D         LD A, (IX+ENT_OLDY)
1431+ EECD 57               LD D, A
1432+ EECE DD 7E 0C         LD A, (IX+ENT_OLDX)
1433+ EED1 5F               LD E, A
1434+ EED2 DD E5            PUSH IX
1435+ EED4 DD 2A 19 A7      LD IX, (OldSprAddr)
1436+ EED8 CD 47 9D         CALL DrawSprite
1437+ EEDB DD E1            POP IX
1438+ EEDD                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1439+ EEDD                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1440+ EEDD DD 56 0D         LD D, (IX+ENT_OLDY)
1441+ EEE0 DD 5E 0C         LD E, (IX+ENT_OLDX)
1442+ EEE3 CD BF CE         CALL RestoreOldAttr
1443+ EEE6                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1444+ EEE6                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1445+ EEE6                  ; reponer attrs de pickups que el flujo de entidades pisa con
1446+ EEE6                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1447+ EEE6                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1448+ EEE6                  ; estar bajo el monster.
1449+ EEE6 DD E5            PUSH IX
1450+ EEE8 CD 23 D5         CALL RefreshPickupAttrs
1451+ EEEB DD E1            POP IX
1452+ EEED                  ; --- Compute new draw pos ---
1453+ EEED CD 1B A7         CALL CalcDrawX
1454+ EEF0 CD 3B A2         CALL ComputeEnemyDrawY
1455+ EEF3                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1456+ EEF3 CD 60 A7         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1457+ EEF6 3A 43 82         LD A, (EnemyDrawY)
1458+ EEF9 57               LD D, A
1459+ EEFA DD 7E 0F         LD A, (IX+ENT_DRAWX)
1460+ EEFD 5F               LD E, A
1461+ EEFE DD E5            PUSH IX
1462+ EF00 DD 2A 8F A7      LD IX, (SpriteAddrTemp)
1463+ EF04 CD 64 9E         CALL CalcEntityAttrSize
1464+ EF07 DD E1            POP IX
1465+ EF09 3A 43 82         LD A, (EnemyDrawY)
1466+ EF0C 57               LD D, A
1467+ EF0D DD 7E 0F         LD A, (IX+ENT_DRAWX)
1468+ EF10 5F               LD E, A
1469+ EF11 DD 7E 05         LD A, (IX+ENT_ATTR)
1470+ EF14 CD 37 9E         CALL SetEntityAttr
