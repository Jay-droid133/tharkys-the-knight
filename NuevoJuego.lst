1712+ F720              ; ==============================================================================
1713+ F720              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1714+ F720              ; ==============================================================================
1715+ F720              ; Indice (CompassSprites[idx]):
1716+ F720              ;   0 = NW    1 = N    2 = NE
1717+ F720              ;   3 = W     4 = X    5 = E
1718+ F720              ;   6 = SW    7 = S    8 = SE
1719+ F720              ; ==============================================================================
1720+ F720              CompassSprites:
1721+ F720 3F F8            DEFW Sprite_Compass_NW
1722+ F722 5F F7            DEFW Sprite_Compass_N
1723+ F724 7F F7            DEFW Sprite_Compass_NE
1724+ F726 1F F8            DEFW Sprite_Compass_W
1725+ F728 5F F8            DEFW Sprite_Compass_X
1726+ F72A 9F F7            DEFW Sprite_Compass_E
1727+ F72C FF F7            DEFW Sprite_Compass_SW
1728+ F72E DF F7            DEFW Sprite_Compass_S
1729+ F730 BF F7            DEFW Sprite_Compass_SE
1730+ F732
1731+ F732              ; ==============================================================================
1732+ F732              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1733+ F732              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1734+ F732              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1735+ F732              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1736+ F732              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1737+ F732              ; ==============================================================================
1738+ F732              CompassWobbleTable:
1739+ F732 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1740+ F736 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1741+ F73A 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1742+ F73E 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1743+ F742 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1744+ F746 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1745+ F74A 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1746+ F74E 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1747+ F752 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1748+ F756
1749+ F756              ; ==============================================================================
1750+ F756              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1751+ F756              ; Indexada por (counter-1) -> 0..8. Valor:
1752+ F756              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1753+ F756              ; Con counter inicial 9 y decremento por frame:
1754+ F756              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1755+ F756              ;   counter 8 -> phase 7 -> prev
1756+ F756              ;   counter 7 -> phase 6 -> target
1757+ F756              ;   counter 6 -> phase 5 -> next
1758+ F756              ;   counter 5 -> phase 4 -> next2
1759+ F756              ;   counter 4 -> phase 3 -> prev
1760+ F756              ;   counter 3 -> phase 2 -> target
1761+ F756              ;   counter 2 -> phase 1 -> prev
1762+ F756              ;   counter 1 -> phase 0 -> target (estado final, settle)
1763+ F756              ; ==============================================================================
1764+ F756              WobblePhaseTable:
1765+ F756 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1765+ F75A 04 03 02 01
1765+ F75E 00
