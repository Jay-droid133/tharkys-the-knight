4367+ BA63              _CountSlots:
4368+ BA63 0E 00            LD C, 0                         ; Contador
4369+ BA65              .countLoop:
4370+ BA65 7E               LD A, (HL)
4371+ BA66 B7               OR A
4372+ BA67 28 16            JR Z, .countNext                ; Slot vacio: no contar
4373+ BA69                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4374+ BA69 D5               PUSH DE
4375+ BA6A 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4376+ BA6D 19               ADD HL, DE
4377+ BA6E 7E               LD A, (HL)
4378+ BA6F ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4379+ BA71 D1               POP DE
4380+ BA72 FE 03            CP STATE_DYING
4381+ BA74 28 09            JR Z, .countNext
4382+ BA76 FE 04            CP STATE_SPAWNING
4383+ BA78 28 05            JR Z, .countNext
4384+ BA7A FE 05            CP STATE_SCARED
4385+ BA7C 28 01            JR Z, .countNext
4386+ BA7E 0C               INC C
4387+ BA7F              .countNext:
4388+ BA7F 11 10 00         LD DE, ENT_SIZE
4389+ BA82 19               ADD HL, DE
4390+ BA83 10 E0            DJNZ .countLoop
4391+ BA85 79               LD A, C
4392+ BA86 C9               RET
4393+ BA87
4394+ BA87              ; ==============================================================================
4395+ BA87              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4396+ BA87              ; ==============================================================================
4397+ BA87              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4398+ BA87              ; ==============================================================================
4399+ BA87              TrySpawnNasty:
4400+ BA87                  IF DEBUG_NO_ENEMIES
4401+ BA87 ~                RET
4402+ BA87                  ENDIF
4403+ BA87                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4404+ BA87                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4405+ BA87                  ; cuando el timer llega a 0.
4406+ BA87 3A 74 82         LD A, (PostTrapPauseTimer)
4407+ BA8A B7               OR A
4408+ BA8B C0               RET NZ
4409+ BA8C                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4410+ BA8C                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4411+ BA8C 3A 8D 82         LD A, (DeathBorderPhase)
4412+ BA8F B7               OR A
4413+ BA90 C0               RET NZ
4414+ BA91                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4415+ BA91                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4416+ BA91                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4417+ BA91 3A 91 82         LD A, (PlayerRespawnPhase)
4418+ BA94 FE 01            CP 1
4419+ BA96 C8               RET Z
4420+ BA97                  ; Cooldown tras cambio de pantalla / inicio
4421+ BA97 3A 9B 82         LD A, (SpawnTimer)
4422+ BA9A B7               OR A
4423+ BA9B 28 05            JR Z, .spawnReady
4424+ BA9D 3D               DEC A
4425+ BA9E 32 9B 82         LD (SpawnTimer), A
4426+ BAA1 C9               RET
4427+ BAA2              .spawnReady:
4428+ BAA2                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4429+ BAA2 3A 04 B9         LD A, (ScareTimer)
4430+ BAA5 B7               OR A
4431+ BAA6 C0               RET NZ
4432+ BAA7                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4433+ BAA7                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4434+ BAA7                  ; rellenamos con nasties crepusculares hasta A2.
4435+ BAA7 3A 6E 82         LD A, (MonsterTrappedFlags)
4436+ BAAA E6 07            AND $07
4437+ BAAC FE 07            CP $07
4438+ BAAE 28 0E            JR Z, .spawnIgnoreNightBlocks
4439+ BAB0                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4440+ BAB0                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4441+ BAB0                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4442+ BAB0                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4443+ BAB0 3A 6E B6         LD A, (MonstersActive)
4444+ BAB3 B7               OR A
4445+ BAB4 C0               RET NZ
4446+ BAB5                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4447+ BAB5 3A 4D E5         LD A, (CurrentTimeOfDay)
4448+ BAB8 FE 04            CP 4                        ; N2
4449+ BABA C8               RET Z
4450+ BABB FE 05            CP 5                        ; A1
4451+ BABD C8               RET Z
4452+ BABE              .spawnIgnoreNightBlocks:
4453+ BABE                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4454+ BABE                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4455+ BABE                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4456+ BABE                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4457+ BABE DD 21 BB 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4458+ BAC2 06 04            LD B, NUM_NASTIES
4459+ BAC4              .spawnLoop:
4460+ BAC4 C5               PUSH BC
4461+ BAC5 DD 7E 01         LD A, (IX+ENT_TYPE)
4462+ BAC8 B7               OR A
4463+ BAC9 20 12            JR NZ, .spawnNextSlot
4464+ BACB CD E6 BA         CALL SpawnOneNasty
4465+ BACE DD 7E 01         LD A, (IX+ENT_TYPE)
4466+ BAD1 B7               OR A
4467+ BAD2 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4468+ BAD4                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4469+ BAD4                  ; (un poco de irregularidad en la cadencia de aparicion).
4470+ BAD4 ED 5F            LD A, R
4471+ BAD6 E6 07            AND $07
4472+ BAD8 32 9B 82         LD (SpawnTimer), A
4473+ BADB C1               POP BC
4474+ BADC C9               RET
4475+ BADD              .spawnNextSlot:
4476+ BADD 11 10 00         LD DE, ENT_SIZE
4477+ BAE0 DD 19            ADD IX, DE
4478+ BAE2 C1               POP BC
4479+ BAE3 10 DF            DJNZ .spawnLoop
4480+ BAE5 C9               RET
4481+ BAE6
4482+ BAE6              ; ==============================================================================
4483+ BAE6              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4484+ BAE6              ; ==============================================================================
4485+ BAE6              SpawnOneNasty:
4486+ BAE6                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4487+ BAE6 ED 5F            LD A, R
4488+ BAE8 E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4489+ BAEA 6F               LD L, A
4490+ BAEB 26 00            LD H, 0
4491+ BAED ED 5B 04 C0      LD DE, (CurrentNastyTable)
4492+ BAF1 19               ADD HL, DE
4493+ BAF2 7E               LD A, (HL)
4494+ BAF3
4495+ BAF3                  ; Configurar entidad base
4496+ BAF3 DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4497+ BAF6 DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4498+ BAFA DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4499+ BAFE                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4500+ BAFE                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4501+ BAFE 3A 04 C0         LD A, (CurrentNastyTable)
4502+ BB01 FE EB            CP LOW CrepuscularTypeTable
4503+ BB03 20 0B            JR NZ, .spnDay
4504+ BB05 3A 05 C0         LD A, (CurrentNastyTable + 1)
4505+ BB08 FE BF            CP HIGH CrepuscularTypeTable
4506+ BB0A 20 04            JR NZ, .spnDay
4507+ BB0C 3E 68            LD A, SPRID_SPAWN_NIGHT
4508+ BB0E 18 02            JR .spnSet
4509+ BB10              .spnDay:
4510+ BB10 3E 46            LD A, SPRID_SPAWN
4511+ BB12              .spnSet:
4512+ BB12 DD 77 00         LD (IX+ENT_SPRITEID), A
4513+ BB15 DD 77 08         LD (IX+ENT_ANIMBASE), A
4514+ BB18 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4515+ BB1C DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4516+ BB20
4517+ BB20                  ; Color segun tipo (cada tipo tiene color fijo)
4518+ BB20 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4519+ BB23 21 EF BF         LD HL, NastyColorTable
4520+ BB26 D5               PUSH DE
4521+ BB27 11 20 00         LD DE, SPRID_ENEMY_0
4522+ BB2A 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4523+ BB2B CB 3F            SRL A
4524+ BB2D CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4525+ BB2F 5F               LD E, A
4526+ BB30 16 00            LD D, 0
4527+ BB32 19               ADD HL, DE
4528+ BB33 7E               LD A, (HL)
4529+ BB34 D1               POP DE
4530+ BB35              .setAttr:
4531+ BB35 DD 77 05         LD (IX+ENT_ATTR), A
4532+ BB38
4533+ BB38                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4534+ BB38                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4535+ BB38                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4536+ BB38                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4537+ BB38                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4538+ BB38                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4539+ BB38 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4540+ BB3A 32 98 BC         LD (.spawnW1), A
4541+ BB3D 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4542+ BB3F 32 99 BC         LD (.spawnH1), A
4543+ BB42
4544+ BB42                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4545+ BB42                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4546+ BB42                  ; Sin rebuild aqui = sin lag por spawn.)
4547+ BB42                  ; Posicion aleatoria (con reintentos)
4548+ BB42 3E 08            LD A, 8                             ; mas reintentos: ahora tambien hay min-distance check
4549+ BB44 32 96 BC         LD (.spawnTries), A
4550+ BB47 AF               XOR A
4551+ BB48 32 97 BC         LD (.spawnIgnoreZone), A            ; primera ronda respeta zona del player
4552+ BB4B
4553+ BB4B              .spawnRetry:
4554+ BB4B                  ; Picker: si .spawnIgnoreZone=0 y la lista de celdas alcanzables tiene
4555+ BB4B                  ; entradas, elegir aleatorio de la lista (garantiza zona del player).
4556+ BB4B                  ; Si fallback (.spawnIgnoreZone=1) o lista vacia: random X/Y de pantalla.
4557+ BB4B 3A 97 BC         LD A, (.spawnIgnoreZone)
4558+ BB4E B7               OR A
4559+ BB4F 20 2A            JR NZ, .spwRandomXY
4560+ BB51 3A 00 5D         LD A, (ZoneCellCount)
4561+ BB54 B7               OR A
4562+ BB55 28 24            JR Z, .spwRandomXY                  ; lista vacia → fallback random
4563+ BB57                  ; idx = R mod count
4564+ BB57 47               LD B, A                             ; B = count
4565+ BB58 ED 5F            LD A, R
4566+ BB5A              .spwIdxLoop:
