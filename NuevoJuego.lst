2659+ D9BD 32 2D E2         LD (BgSpriteIsHouse), A
2660+ D9C0 CD 7A DB         CALL DrawBgAttrOnly         ; solo attrs
2661+ D9C3 E1               POP HL                      ; recuperar puntero a siguiente entry
2662+ D9C4 18 C4            JR .rpaLoop
2663+ D9C6              .rpaSkip:
2664+ D9C6                  ; HL en ptr_lo. Skip 5 (ptr_lo, ptr_hi, charX, charY, tint) al siguiente mapX.
2665+ D9C6 11 05 00         LD DE, 5
2666+ D9C9 19               ADD HL, DE
2667+ D9CA 18 BE            JR .rpaLoop
2668+ D9CC              .rpaInactive:
2669+ D9CC                  ; HL en mapX ($FE). Skip 7.
2670+ D9CC 11 07 00         LD DE, 7
2671+ D9CF 19               ADD HL, DE
2672+ D9D0 18 B8            JR .rpaLoop
