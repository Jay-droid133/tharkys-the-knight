 474+ F178              ; ==============================================================================
 475+ F178              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F178              ; ==============================================================================
 477+ F178              DrawCompass:
 478+ F178                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F178 3A C0 82         LD A, (ObjectiveScreenX)
 480+ F17B FE FF            CP $FF
 481+ F17D CA 34 F3         JP Z, ClearCompass
 482+ F180
 483+ F180                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F180                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F180                  ; reflejar la dir del path al cambiar de sala).
 486+ F180 3A 10 83         LD A, (CurrentScreenX)
 487+ F183 47               LD B, A
 488+ F184 3A C3 82         LD A, (LastCompassScreenX)
 489+ F187 B8               CP B
 490+ F188 C2 AE F1         JP NZ, .dcRedrawNewScreen
 491+ F18B 3A 11 83         LD A, (CurrentScreenY)
 492+ F18E 47               LD B, A
 493+ F18F 3A C4 82         LD A, (LastCompassScreenY)
 494+ F192 B8               CP B
 495+ F193 C2 AE F1         JP NZ, .dcRedrawNewScreen
 496+ F196 3A C2 82         LD A, (PreviousObjectiveDistance)
 497+ F199 FE FF            CP $FF
 498+ F19B 28 16            JR Z, .dcRedraw
 499+ F19D 3A C5 82         LD A, (CompassWobbleCounter)
 500+ F1A0 B7               OR A
 501+ F1A1 20 10            JR NZ, .dcRedraw
 502+ F1A3                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F1A3                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F1A3 3A BF 5F         LD A, (MagicCompassTimer)
 505+ F1A6 47               LD B, A
 506+ F1A7 3A C0 5F         LD A, (MagicCompassTimer + 1)
 507+ F1AA B0               OR B
 508+ F1AB C8               RET Z                               ; sin cambios + sin wobble + sin magic
 509+ F1AC 18 05            JR .dcRedraw
