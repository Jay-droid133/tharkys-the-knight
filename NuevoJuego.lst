 732+ A53E 06 00            LD B, 0
 733+ A540 0E FF            LD C, -1
 734+ A542 18 0A            JR .peShakeApply
 735+ A544              .peShakeDown:
 736+ A544 06 00            LD B, 0
 737+ A546 0E 01            LD C, 1
 738+ A548 18 04            JR .peShakeApply
 739+ A54A              .peShakeLeft:
 740+ A54A 06 FF            LD B, -1
 741+ A54C 0E 00            LD C, 0
 742+ A54E              .peShakeApply:
 743+ A54E                  ; new POSX = orig + B, new POSY = orig + C
 744+ A54E 21 97 5F         LD HL, MonsterShakeOrigX
 745+ A551 19               ADD HL, DE
 746+ A552 7E               LD A, (HL)
 747+ A553 80               ADD A, B
 748+ A554 DD 77 03         LD (IX+ENT_POSX), A
 749+ A557 21 9A 5F         LD HL, MonsterShakeOrigY
 750+ A55A 19               ADD HL, DE
 751+ A55B 7E               LD A, (HL)
 752+ A55C 81               ADD A, C
 753+ A55D DD 77 04         LD (IX+ENT_POSY), A
 754+ A560                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 755+ A560 CD 5D B9         CALL CheckEnemyCollision
 756+ A563 28 16            JR Z, .peScaredSpriteToggle
 757+ A565                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 758+ A565 CD 39 92         CALL MaiGetMonsterSlot
 759+ A568 5F               LD E, A
 760+ A569 16 00            LD D, 0
 761+ A56B 21 97 5F         LD HL, MonsterShakeOrigX
 762+ A56E 19               ADD HL, DE
 763+ A56F 7E               LD A, (HL)
 764+ A570 DD 77 03         LD (IX+ENT_POSX), A
 765+ A573 21 9A 5F         LD HL, MonsterShakeOrigY
 766+ A576 19               ADD HL, DE
 767+ A577 7E               LD A, (HL)
 768+ A578 DD 77 04         LD (IX+ENT_POSY), A
