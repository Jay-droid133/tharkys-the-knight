 157+ EAF1              .grpiPick:
 158+ EAF1 3A 33 EB         LD A, (.grpiCount)
 159+ EAF4 47               LD B, A
 160+ EAF5 ED 5F            LD A, R
 161+ EAF7              .grpiMod:
 162+ EAF7 90               SUB B
 163+ EAF8 30 FD            JR NC, .grpiMod
 164+ EAFA 80               ADD A, B                                ; A = R mod count
 165+ EAFB 5F               LD E, A
 166+ EAFC 16 00            LD D, 0
 167+ EAFE 2A 34 EB         LD HL, (.grpiItems)
 168+ EB01 19               ADD HL, DE
 169+ EB02 7E               LD A, (HL)                              ; A = ROUL_* picado
