2537+ B0D1 38 03            JR C, .eClampXOk            ; No underflow → ok
2538+ B0D3 AF               XOR A                       ; Clamp a 0
2539+ B0D4 18 0E            JR .eReverseX
2540+ B0D6              .eClampXOk:
2541+ B0D6 DD 77 03         LD (IX+ENT_POSX), A
2542+ B0D9                  ; Check colision fondo en X
2543+ B0D9 CD 44 BA         CALL CheckEnemyCollision
2544+ B0DC 28 0E            JR Z, .eXDone
2545+ B0DE                  ; Colision → revertir X e invertir delta
2546+ B0DE 3A 72 B1         LD A, (.savedEX)
2547+ B0E1 DD 77 03         LD (IX+ENT_POSX), A
2548+ B0E4              .eReverseX:
2549+ B0E4 DD 7E 06         LD A, (IX+ENT_DELTAX)
2550+ B0E7 ED 44            NEG
2551+ B0E9 DD 77 06         LD (IX+ENT_DELTAX), A
2552+ B0EC              .eXDone:
2553+ B0EC
2554+ B0EC                  ; --- Movimiento vertical ---
2555+ B0EC DD 7E 04         LD A, (IX+ENT_POSY)
2556+ B0EF 32 73 B1         LD (.savedEY), A
2557+ B0F2 47               LD B, A
2558+ B0F3 DD 7E 07         LD A, (IX+ENT_DELTAY)
2559+ B0F6 4F               LD C, A
2560+ B0F7 CB 79            BIT 7, C
2561+ B0F9 20 0A            JR NZ, .eDeltaYNeg
2562+ B0FB 78               LD A, B
2563+ B0FC 81               ADD A, C
2564+ B0FD FE A8            CP SCREEN_MAX_Y
2565+ B0FF 38 14            JR C, .eClampYOk
2566+ B101 3E A7            LD A, SCREEN_MAX_Y - 1
2567+ B103 18 1E            JR .eReverseY
2568+ B105              .eDeltaYNeg:
2569+ B105 78               LD A, B
2570+ B106 81               ADD A, C
2571+ B107 38 04            JR C, .eCheckMinY
2572+ B109 3E 10            LD A, SCREEN_MIN_Y
2573+ B10B 18 16            JR .eReverseY
2574+ B10D              .eCheckMinY:
2575+ B10D FE 10            CP SCREEN_MIN_Y
2576+ B10F 30 04            JR NC, .eClampYOk
2577+ B111 3E 10            LD A, SCREEN_MIN_Y
2578+ B113 18 0E            JR .eReverseY
2579+ B115              .eClampYOk:
2580+ B115 DD 77 04         LD (IX+ENT_POSY), A
2581+ B118 CD 44 BA         CALL CheckEnemyCollision
2582+ B11B 28 0E            JR Z, .eYDone
2583+ B11D 3A 73 B1         LD A, (.savedEY)
2584+ B120 DD 77 04         LD (IX+ENT_POSY), A
2585+ B123              .eReverseY:
