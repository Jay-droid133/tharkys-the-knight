 234  DD6F                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 235  DD6F                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 236  DD6F                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 237  DD6F                  ; deben vivir en el mismo banco paginado.
 238  DD6F                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ DD6F              ; ==============================================================================
   2+ DD6F              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ DD6F              ; ==============================================================================
   4+ DD6F              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ DD6F              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ DD6F              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ DD6F              ; ==============================================================================
   8+ DD6F
   9+ DD6F              ; --- Constantes ---
  10+ DD6F              NUM_TIME_MOMENTS    EQU 7
  11+ DD6F
  12+ DD6F              ; --- Variables ---
  13+ DD6F 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ DD70 FC E1        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ DD72 FC E1        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ DD74 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ DD75 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ DD76
  19+ DD76              ; ==============================================================================
  20+ DD76              ; SetTimeOfDay - Cambia el momento del dia
  21+ DD76              ; ==============================================================================
  22+ DD76              ; Entrada: A = momento (0-6)
  23+ DD76              ; ==============================================================================
  24+ DD76              SetTimeOfDay:
  25+ DD76 32 6F DD         LD (CurrentTimeOfDay), A
  26+ DD79
  27+ DD79                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  28+ DD79 FE 04            CP 4
  29+ DD7B 20 06            JR NZ, .notNewCycle
  30+ DD7D 21 68 BD         LD HL, DayCycleCount
  31+ DD80 34               INC (HL)
  32+ DD81 18 04            JR .skipBellsReset
  33+ DD83              .notNewCycle:
  34+ DD83                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  35+ DD83                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  36+ DD83                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  37+ DD83 AF               XOR A
  38+ DD84 32 E1 81         LD (BellsTriggered), A
  39+ DD87              .skipBellsReset:
  40+ DD87 3A 6F DD         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  41+ DD8A
  42+ DD8A                  ; N2 (medianoche): campanadas primero, remap al terminar
  43+ DD8A FE 04            CP 4
  44+ DD8C 28 1C            JR Z, .bellsFirst
  45+ DD8E
  46+ DD8E                  ; Amanecer temprano (fase 5): despawnear monsters
  47+ DD8E FE 05            CP 5
  48+ DD90 20 05            JR NZ, .noScareMon
  49+ DD92 CD 82 BD         CALL ScareAllMonsters
  50+ DD95 18 07            JR .noKillMon
  51+ DD97              .noScareMon:
  52+ DD97                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  53+ DD97 FE 06            CP 6
  54+ DD99 20 03            JR NZ, .noKillMon
  55+ DD9B CD 07 BD         CALL KillAllActiveMonsters
  56+ DD9E              .noKillMon:
  57+ DD9E
  58+ DD9E                  ; Actualizar tablas de remap y tabla de nasties
  59+ DD9E CD D3 DD         CALL UpdateRemapTables
  60+ DDA1 CD 6B BD         CALL UpdateNastyTable
  61+ DDA4
  62+ DDA4                  ; Forzar remap de atributos (sin redibujar pixeles)
  63+ DDA4 3E 01            LD A, 1
  64+ DDA6 32 11 82         LD (AttrsDirty), A
  65+ DDA9 C9               RET
  66+ DDAA
  67+ DDAA              .bellsFirst:
  68+ DDAA                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  69+ DDAA                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  70+ DDAA                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  71+ DDAA                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  72+ DDAA                  ; que sean nocturnos (Crepuscular), no diurnos.
  73+ DDAA CD 6B BD         CALL UpdateNastyTable
  74+ DDAD                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  75+ DDAD                  ; antes de medianoche natural y forzo el evento), saltamos.
  76+ DDAD 3A E1 81         LD A, (BellsTriggered)
  77+ DDB0 B7               OR A
  78+ DDB1 C0               RET NZ
  79+ DDB2 3E 01            LD A, 1
  80+ DDB4 32 E1 81         LD (BellsTriggered), A
  81+ DDB7 CD 47 F2         CALL StartBellChimes
  82+ DDBA C9               RET
  83+ DDBB
  84+ DDBB              ; ==============================================================================
  85+ DDBB              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  86+ DDBB              ; ==============================================================================
  87+ DDBB              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  88+ DDBB              ;   - Salta reloj a 00:00.
  89+ DDBB              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  90+ DDBB              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  91+ DDBB              ;     campanadas como hace el path natural). El usuario quiere que la
  92+ DDBB              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
  93+ DDBB              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
  94+ DDBB              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
  95+ DDBB              ;     pero ya esta en N2 -> no-op visual.
  96+ DDBB              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
  97+ DDBB              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
  98+ DDBB              ;
  99+ DDBB              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 100+ DDBB              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 101+ DDBB              ; aqui no re-dispara nada.
 102+ DDBB              ; ==============================================================================
 103+ DDBB              TriggerChurchMidnight:
 104+ DDBB 3A E1 81         LD A, (BellsTriggered)
 105+ DDBE B7               OR A
 106+ DDBF C0               RET NZ                              ; bells ya sonaron -> no-op
 107+ DDC0 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 108+ DDC2 CD AC E5         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 109+ DDC5 3E 04            LD A, 4
 110+ DDC7 CD 76 DD         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 111+ DDCA                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 112+ DDCA                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 113+ DDCA                  ; diurnos durante chimes). En este path queremos lo contrario.
 114+ DDCA CD D3 DD         CALL UpdateRemapTables
 115+ DDCD 3E 01            LD A, 1
 116+ DDCF 32 11 82         LD (AttrsDirty), A
 117+ DDD2 C9               RET
 118+ DDD3
 119+ DDD3              ; ==============================================================================
 120+ DDD3              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 121+ DDD3              ; ==============================================================================
 122+ DDD3              UpdateRemapTables:
 123+ DDD3 3A 6F DD         LD A, (CurrentTimeOfDay)
 124+ DDD6 21 D0 E1         LD HL, RemapTablePtrs
 125+ DDD9 5F               LD E, A
 126+ DDDA 16 00            LD D, 0
 127+ DDDC 19               ADD HL, DE
 128+ DDDD 19               ADD HL, DE
 129+ DDDE 5E               LD E, (HL)
 130+ DDDF 23               INC HL
 131+ DDE0 56               LD D, (HL)
 132+ DDE1 ED 53 70 DD      LD (CurrentRemapTable), DE
 133+ DDE5
 134+ DDE5 3A 6F DD         LD A, (CurrentTimeOfDay)
 135+ DDE8 21 DE E1         LD HL, RemapHouseTablePtrs
 136+ DDEB 5F               LD E, A
 137+ DDEC 16 00            LD D, 0
 138+ DDEE 19               ADD HL, DE
 139+ DDEF 19               ADD HL, DE
 140+ DDF0 5E               LD E, (HL)
 141+ DDF1 23               INC HL
 142+ DDF2 56               LD D, (HL)
 143+ DDF3 ED 53 72 DD      LD (CurrentHouseRemapTable), DE
 144+ DDF7 C9               RET
 145+ DDF8
 146+ DDF8              ; ==============================================================================
 147+ DDF8              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 148+ DDF8              ; ==============================================================================
 149+ DDF8              CheckDebugKeys:
 150+ DDF8 3E FB            LD A, $FB
 151+ DDFA DB FE            IN A, ($FE)
 152+ DDFC CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 153+ DDFE 20 1C            JR NZ, .notPressed
 154+ DE00
 155+ DE00                  ; Tecla pulsada: comprobar debounce
 156+ DE00 3A 75 DD         LD A, (DebugKeyDebounce)
 157+ DE03 B7               OR A
 158+ DE04 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 159+ DE05
 160+ DE05                  ; Primera pulsacion: ciclar
 161+ DE05 3E 01            LD A, 1
 162+ DE07 32 75 DD         LD (DebugKeyDebounce), A
 163+ DE0A
 164+ DE0A 3A 6F DD         LD A, (CurrentTimeOfDay)
 165+ DE0D 3C               INC A
 166+ DE0E FE 07            CP NUM_TIME_MOMENTS
 167+ DE10 38 01            JR C, .noWrap
 168+ DE12 AF               XOR A                   ; Volver a 0 (Dia)
 169+ DE13              .noWrap:
 170+ DE13 F5               PUSH AF
 171+ DE14 CD 76 DD         CALL SetTimeOfDay
 172+ DE17 F1               POP AF
 173+ DE18 CD AC E5         CALL SetClockToPhaseHour
 174+ DE1B C9               RET
 175+ DE1C
 176+ DE1C              .notPressed:
 177+ DE1C AF               XOR A
 178+ DE1D 32 75 DD         LD (DebugKeyDebounce), A
 179+ DE20
 180+ DE20                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 181+ DE20 3E FD            LD A, $FD
 182+ DE22 DB FE            IN A, ($FE)
 183+ DE24 4F               LD C, A                 ; C = estado semi-fila $FDFE
 184+ DE25 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 185+ DE27 20 13            JR NZ, .sNotPressed
 186+ DE29 3A 77 DE         LD A, (SpeedKeyDebounce)
 187+ DE2C B7               OR A
 188+ DE2D C0               RET NZ
 189+ DE2E 3E 01            LD A, 1
 190+ DE30 32 77 DE         LD (SpeedKeyDebounce), A
 191+ DE33 21 68 BD         LD HL, DayCycleCount
 192+ DE36 7E               LD A, (HL)
 193+ DE37 FE 0A            CP 10
 194+ DE39 D0               RET NC                  ; Ya en maximo
 195+ DE3A 34               INC (HL)
 196+ DE3B C9               RET
 197+ DE3C              .sNotPressed:
 198+ DE3C                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 199+ DE3C CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 200+ DE3E 20 13            JR NZ, .dNotPressed
 201+ DE40 3A 77 DE         LD A, (SpeedKeyDebounce)
 202+ DE43 B7               OR A
 203+ DE44 C0               RET NZ
 204+ DE45 3E 01            LD A, 1
 205+ DE47 32 77 DE         LD (SpeedKeyDebounce), A
 206+ DE4A 21 68 BD         LD HL, DayCycleCount
 207+ DE4D 7E               LD A, (HL)
 208+ DE4E FE 01            CP 1
 209+ DE50 C8               RET Z                   ; Ya en minimo
 210+ DE51 35               DEC (HL)
 211+ DE52 C9               RET
 212+ DE53              .dNotPressed:
 213+ DE53 AF               XOR A
 214+ DE54 32 77 DE         LD (SpeedKeyDebounce), A
 215+ DE57
 216+ DE57                  ; --- Tecla N: togglea NoclipMode (debug) ---
 217+ DE57 3E 7F            LD A, $7F
 218+ DE59 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 219+ DE5B CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 220+ DE5D 20 13            JR NZ, .nNotPressed
 221+ DE5F 3A 78 DE         LD A, (NoclipKeyDebounce)
 222+ DE62 B7               OR A
 223+ DE63 C0               RET NZ
 224+ DE64 3E 01            LD A, 1
 225+ DE66 32 78 DE         LD (NoclipKeyDebounce), A
 226+ DE69 3A D9 81         LD A, (NoclipMode)
 227+ DE6C EE 01            XOR 1
 228+ DE6E 32 D9 81         LD (NoclipMode), A
 229+ DE71 C9               RET
 230+ DE72              .nNotPressed:
 231+ DE72 AF               XOR A
 232+ DE73 32 78 DE         LD (NoclipKeyDebounce), A
 233+ DE76 C9               RET
 234+ DE77
 235+ DE77 00           SpeedKeyDebounce: DEFB 0
 236+ DE78 00           NoclipKeyDebounce: DEFB 0
 237+ DE79
 238+ DE79              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 239+ DE79              DrawSwordModeHUD:
 240+ DE79 3A FA B5         LD A, (SwordMode)
 241+ DE7C 21 AC DE         LD HL, .modeChars
 242+ DE7F 5F               LD E, A
 243+ DE80 16 00            LD D, 0
 244+ DE82 19               ADD HL, DE
 245+ DE83 7E               LD A, (HL)                          ; A = ASCII del modo
 246+ DE84                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 247+ DE84 21 00 40         LD HL, $4000
 248+ DE87                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 249+ DE87 5F               LD E, A
 250+ DE88 16 00            LD D, 0
 251+ DE8A 42               LD B, D                             ; B = 0
 252+ DE8B CB 23            SLA E
 252+ DE8D CB 12          RL D                        ; *2
 253+ DE8F CB 23            SLA E
 253+ DE91 CB 12          RL D                        ; *4
 254+ DE93 CB 23            SLA E
 254+ DE95 CB 12          RL D                        ; *8
 255+ DE97 E5               PUSH HL
 256+ DE98 21 00 3C         LD HL, $3C00
 257+ DE9B 19               ADD HL, DE                          ; HL = direccion del glyph
 258+ DE9C EB               EX DE, HL                           ; DE = glyph
 259+ DE9D E1               POP HL                              ; HL = VRAM
 260+ DE9E 06 08            LD B, 8
 261+ DEA0              .drawChar:
 262+ DEA0 1A               LD A, (DE)
 263+ DEA1 77               LD (HL), A
 264+ DEA2 13               INC DE
 265+ DEA3 24               INC H                               ; siguiente scan line
 266+ DEA4 10 FA            DJNZ .drawChar
 267+ DEA6                  ; Attr: fila 0, col 0 = $5800
 268+ DEA6 3E 47            LD A, $47                           ; blanco bright
 269+ DEA8 32 00 58         LD ($5800), A
 270+ DEAB C9               RET
 271+ DEAC
 272+ DEAC 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 273+ DEAF
 274+ DEAF              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 275+ DEAF              DrawNoclipHUD:
 276+ DEAF 3A D9 81         LD A, (NoclipMode)
 277+ DEB2 B7               OR A
 278+ DEB3 20 0E            JR NZ, .ncOn
 279+ DEB5 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 280+ DEB7 1E 1E            LD E, 30
 281+ DEB9 CD DE E0         CALL DrawHudChar
 282+ DEBC 3E 20            LD A, 32
 283+ DEBE 1E 1F            LD E, 31
 284+ DEC0 C3 DE E0         JP DrawHudChar
 285+ DEC3              .ncOn:
 286+ DEC3 3E 4E            LD A, 'N'
 287+ DEC5 1E 1E            LD E, 30
 288+ DEC7 CD DE E0         CALL DrawHudChar
 289+ DECA 3E 43            LD A, 'C'
 290+ DECC 1E 1F            LD E, 31
 291+ DECE C3 DE E0         JP DrawHudChar
 292+ DED1
 293+ DED1              ; ==============================================================================
 294+ DED1              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 295+ DED1              ; ==============================================================================
 296+ DED1              ; Entrada: A = attr original
 297+ DED1              ; Salida:  A = attr transformado
 298+ DED1              ; Preserva: HL, DE, BC, IX
 299+ DED1              ; ==============================================================================
 300+ DED1              ApplyDayCycleRemap:
 301+ DED1 E5               PUSH HL
 302+ DED2 67               LD H, A                     ; H = attr (temp save)
 303+ DED3 3A 6F DD         LD A, (CurrentTimeOfDay)
 304+ DED6 B7               OR A
 305+ DED7 20 03            JR NZ, .doRemap
 306+ DED9 7C               LD A, H                     ; Dia: devolver sin cambio
 307+ DEDA E1               POP HL
 308+ DEDB C9               RET
 309+ DEDC
 310+ DEDC              .doRemap:
 311+ DEDC D5               PUSH DE
 312+ DEDD C5               PUSH BC
 313+ DEDE
 314+ DEDE 7C               LD A, H                     ; A = attr original
 315+ DEDF 4F               LD C, A                     ; C = attr original
 316+ DEE0
 317+ DEE0                  ; Guardar flash + ink (bits 7, 2-0)
 318+ DEE0 E6 87            AND $87                     ; A = F000_0III
 319+ DEE2 47               LD B, A                     ; B = flash | ink
 320+ DEE3
 321+ DEE3                  ; Extraer paper+bright como indice 0-15
 322+ DEE3 79               LD A, C
 323+ DEE4 E6 78            AND $78                     ; A = 0BPPP000
 324+ DEE6 0F               RRCA
 325+ DEE7 0F               RRCA
 326+ DEE8 0F               RRCA                        ; A = 0000BPPP = indice
 327+ DEE9
 328+ DEE9                  ; Elegir tabla segun tipo de sprite
 329+ DEE9 5F               LD E, A
 330+ DEEA 16 00            LD D, 0
 331+ DEEC 3A 74 DD         LD A, (BgSpriteIsHouse)
 332+ DEEF B7               OR A
 333+ DEF0 28 05            JR Z, .useStdTable
 334+ DEF2 2A 72 DD         LD HL, (CurrentHouseRemapTable)
 335+ DEF5 18 03            JR .doLookup
 336+ DEF7              .useStdTable:
 337+ DEF7 2A 70 DD         LD HL, (CurrentRemapTable)
 338+ DEFA              .doLookup:
 339+ DEFA 19               ADD HL, DE
 340+ DEFB 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 341+ DEFC
 342+ DEFC                  ; Reconstruir atributo
 343+ DEFC 07               RLCA
 344+ DEFD 07               RLCA
 345+ DEFE 07               RLCA                        ; A = 0BPPP000
 346+ DEFF B0               OR B                        ; A = FBPPPIII
 347+ DF00
 348+ DF00 C1               POP BC
 349+ DF01 D1               POP DE
 350+ DF02 E1               POP HL
 351+ DF03 C9               RET
 352+ DF04
 353+ DF04              ; ==============================================================================
 354+ DF04              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 355+ DF04              ; ==============================================================================
 356+ DF04              ; Entrada: A = sprite ID
 357+ DF04              ; Setea BgSpriteIsHouse (0 o 1)
 358+ DF04              ; Preserva: A, DE, IX
 359+ DF04              ;
 360+ DF04              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 361+ DF04              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 362+ DF04              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 363+ DF04              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 364+ DF04              ; ==============================================================================
 365+ DF04              CheckIfHouseSprite:
 366+ DF04 F5               PUSH AF
 367+ DF05 E5               PUSH HL
 368+ DF06 C5               PUSH BC
 369+ DF07
 370+ DF07 47               LD B, A                     ; B = id buscado
 371+ DF08
 372+ DF08 AF               XOR A
 373+ DF09 32 74 DD         LD (BgSpriteIsHouse), A     ; Default: no es house
 374+ DF0C
 375+ DF0C 21 3C DA         LD HL, HouseIdList
 376+ DF0F              .checkLoop:
 377+ DF0F 7E               LD A, (HL)
 378+ DF10 FE FF            CP $FF
 379+ DF12 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 380+ DF14 B8               CP B
 381+ DF15 28 03            JR Z, .checkFound
 382+ DF17 23               INC HL
 383+ DF18 18 F5            JR .checkLoop
 384+ DF1A
 385+ DF1A              .checkFound:
 386+ DF1A 3E 01            LD A, 1
 387+ DF1C 32 74 DD         LD (BgSpriteIsHouse), A
 388+ DF1F
 389+ DF1F              .checkDone:
 390+ DF1F C1               POP BC
 391+ DF20 E1               POP HL
 392+ DF21 F1               POP AF
 393+ DF22 C9               RET
 394+ DF23
 395+ DF23              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 396+ DF23              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 397+ DF23              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 398+ DF23
 399+ DF23              ; ==============================================================================
 400+ DF23              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 401+ DF23              ; ==============================================================================
 402+ DF23              ; Formato: XX,YY:NN nombre_room     DY
 403+ DF23              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 404+ DF23              ; ==============================================================================
 405+ DF23              DrawRoomInfo:
 406+ DF23                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 407+ DF23 1E 00            LD E, 0
 408+ DF25 06 0D            LD B, 13
 409+ DF27              .clearLoop:
 410+ DF27 C5               PUSH BC
 411+ DF28 D5               PUSH DE
 412+ DF29 3E 20            LD A, ' '
 413+ DF2B CD DE E0         CALL DrawHudChar
 414+ DF2E D1               POP DE
 415+ DF2F C1               POP BC
 416+ DF30 1C               INC E
 417+ DF31 10 F4            DJNZ .clearLoop
 418+ DF33
 419+ DF33                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 420+ DF33 3A 08 82         LD A, (CurrentScreenX)
 421+ DF36 1E 00            LD E, 0
 422+ DF38 CD 96 DF         CALL .drawDec2
 423+ DF3B
 424+ DF3B                  ; --- ',' en col 2 ---
 425+ DF3B 3E 2C            LD A, ','
 426+ DF3D 1E 02            LD E, 2
 427+ DF3F CD DE E0         CALL DrawHudChar
 428+ DF42
 429+ DF42                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 430+ DF42 3A 09 82         LD A, (CurrentScreenY)
 431+ DF45 1E 03            LD E, 3
 432+ DF47 CD 96 DF         CALL .drawDec2
 433+ DF4A
 434+ DF4A                  ; --- ':' en col 5 ---
 435+ DF4A 3E 3A            LD A, ':'
 436+ DF4C 1E 05            LD E, 5
 437+ DF4E CD DE E0         CALL DrawHudChar
 438+ DF51
 439+ DF51                  ; --- Obtener room index de MapTable[Y*16+X] ---
 440+ DF51 3A 09 82         LD A, (CurrentScreenY)
 441+ DF54 6F               LD L, A
 442+ DF55 26 00            LD H, 0
 443+ DF57 29               ADD HL, HL
 444+ DF58 29               ADD HL, HL
 445+ DF59 29               ADD HL, HL
 446+ DF5A 29               ADD HL, HL                  ; HL = Y * 16
 447+ DF5B 3A 08 82         LD A, (CurrentScreenX)
 448+ DF5E 5F               LD E, A
 449+ DF5F 16 00            LD D, 0
 450+ DF61 19               ADD HL, DE                  ; HL = Y*16 + X
 451+ DF62 11 D1 D8         LD DE, MapTable
 452+ DF65 19               ADD HL, DE
 453+ DF66 7E               LD A, (HL)                  ; A = room index (0-47)
 454+ DF67 F5               PUSH AF                     ; guardar room index
 455+ DF68
 456+ DF68                  ; --- Room index como 2 hex en cols 6-7 ---
 457+ DF68 F5               PUSH AF
 458+ DF69 0F               RRCA
 459+ DF6A 0F               RRCA
 460+ DF6B 0F               RRCA
 461+ DF6C 0F               RRCA
 462+ DF6D E6 0F            AND $0F
 463+ DF6F CD B4 DF         CALL .hexToAscii
 464+ DF72 1E 06            LD E, 6
 465+ DF74 CD DE E0         CALL DrawHudChar
 466+ DF77 F1               POP AF
 467+ DF78 E6 0F            AND $0F
 468+ DF7A CD B4 DF         CALL .hexToAscii
 469+ DF7D 1E 07            LD E, 7
 470+ DF7F CD DE E0         CALL DrawHudChar
 471+ DF82
 472+ DF82                  ; --- Espacio en col 8 ---
 473+ DF82 3E 20            LD A, ' '
 474+ DF84 1E 08            LD E, 8
 475+ DF86 CD DE E0         CALL DrawHudChar
 476+ DF89
 477+ DF89                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 478+ DF89 F1               POP AF                      ; A = room index (descartar)
 479+ DF8A
 480+ DF8A                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 481+ DF8A 21 20 58         LD HL, ATTR_BASE + 1 * 32
 482+ DF8D 3E 47            LD A, $47                   ; bright white on black
 483+ DF8F 06 0D            LD B, 13
 484+ DF91              .attrLoop:
 485+ DF91 77               LD (HL), A
 486+ DF92 23               INC HL
 487+ DF93 10 FC            DJNZ .attrLoop
 488+ DF95 C9               RET
 489+ DF96
 490+ DF96              ; --- Helpers ---
 491+ DF96              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 492+ DF96              .drawDec2:
 493+ DF96 4B               LD C, E                     ; guardar columna inicial
 494+ DF97 06 00            LD B, 0                     ; decenas
 495+ DF99              .divLoop:
 496+ DF99 FE 0A            CP 10
 497+ DF9B 38 05            JR C, .divDone
 498+ DF9D D6 0A            SUB 10
 499+ DF9F 04               INC B
 500+ DFA0 18 F7            JR .divLoop
 501+ DFA2              .divDone:
 502+ DFA2                  ; B = decenas, A = unidades
 503+ DFA2 F5               PUSH AF                     ; guardar unidades
 504+ DFA3 78               LD A, B
 505+ DFA4 C6 30            ADD A, '0'
 506+ DFA6 59               LD E, C
 507+ DFA7 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 508+ DFA8 CD DE E0         CALL DrawHudChar
 509+ DFAB C1               POP BC                      ; restaurar C
 510+ DFAC F1               POP AF
 511+ DFAD C6 30            ADD A, '0'
 512+ DFAF 59               LD E, C
 513+ DFB0 1C               INC E
 514+ DFB1 C3 DE E0         JP DrawHudChar              ; tail call
 515+ DFB4
 516+ DFB4              .hexToAscii:
 517+ DFB4 FE 0A            CP 10
 518+ DFB6 38 03            JR C, .isDigit
 519+ DFB8 C6 37            ADD A, 'A' - 10
 520+ DFBA C9               RET
 521+ DFBB              .isDigit:
 522+ DFBB C6 30            ADD A, '0'
 523+ DFBD C9               RET
 524+ DFBE
 525+ DFBE              ; ==============================================================================
 526+ DFBE              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 527+ DFBE              ; Usa font custom (DayHudFont) en vez de ROM font
 528+ DFBE              ; ==============================================================================
 529+ DFBE              DrawDayCycleHUD:
 530+ DFBE                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 531+ DFBE 21 7C E2         LD HL, DayHudFont + 0 * 8          ; 'D'
 532+ DFC1 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 533+ DFC4 CD 33 E0         CALL .drawChar
 534+ DFC7 21 84 E2         LD HL, DayHudFont + 1 * 8          ; 'A'
 535+ DFCA 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 536+ DFCD CD 33 E0         CALL .drawChar
 537+ DFD0 21 8C E2         LD HL, DayHudFont + 2 * 8          ; 'Y'
 538+ DFD3 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 539+ DFD6 CD 33 E0         CALL .drawChar
 540+ DFD9                  ; Col 7 = espacio (limpiar)
 541+ DFD9 11 07 40         LD DE, $4007
 542+ DFDC CD 3C E0         CALL .clearChar
 543+ DFDF
 544+ DFDF                  ; --- Digito decenas (col 8) ---
 545+ DFDF 3A 68 BD         LD A, (DayCycleCount)
 546+ DFE2 FE 0A            CP 10
 547+ DFE4 38 20            JR C, .singleDigit
 548+ DFE6                  ; Dos digitos: dividir A / 10
 549+ DFE6 06 00            LD B, 0
 550+ DFE8              .divLoop:
 551+ DFE8 D6 0A            SUB 10
 552+ DFEA 04               INC B
 553+ DFEB FE 0A            CP 10
 554+ DFED 30 F9            JR NC, .divLoop
 555+ DFEF                  ; B = decenas, A = unidades
 556+ DFEF F5               PUSH AF                             ; Guardar unidades
 557+ DFF0 78               LD A, B
 558+ DFF1 CD 26 E0         CALL .getDigitFont
 559+ DFF4 11 08 40         LD DE, $4008                        ; Col 8
 560+ DFF7 CD 33 E0         CALL .drawChar
 561+ DFFA F1               POP AF                              ; Recuperar unidades
 562+ DFFB CD 26 E0         CALL .getDigitFont
 563+ DFFE 11 09 40         LD DE, $4009                        ; Col 9
 564+ E001 CD 33 E0         CALL .drawChar
 565+ E004 18 14            JR .setAttrs
 566+ E006
 567+ E006              .singleDigit:
 568+ E006                  ; Una cifra: decena = 0, unidad = A
 569+ E006 F5               PUSH AF
 570+ E007 21 94 E2         LD HL, DayHudFont + 3 * 8          ; '0'
 571+ E00A 11 08 40         LD DE, $4008                        ; Col 8
 572+ E00D CD 33 E0         CALL .drawChar
 573+ E010 F1               POP AF
 574+ E011 CD 26 E0         CALL .getDigitFont
 575+ E014 11 09 40         LD DE, $4009                        ; Col 9
 576+ E017 CD 33 E0         CALL .drawChar
 577+ E01A
 578+ E01A              .setAttrs:
 579+ E01A                  ; Atributos: bright white en cols 4-9
 580+ E01A 3E 47            LD A, $47
 581+ E01C 21 04 58         LD HL, ATTR_BASE + 4
 582+ E01F 06 06            LD B, 6
 583+ E021              .attrLoop:
 584+ E021 77               LD (HL), A
 585+ E022 23               INC HL
 586+ E023 10 FC            DJNZ .attrLoop
 587+ E025 C9               RET
 588+ E026
 589+ E026              ; Devuelve HL = puntero a font data del digito en A (0-9)
 590+ E026              ; A se destruye
 591+ E026              .getDigitFont:
 592+ E026 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 593+ E028 6F               LD L, A
 594+ E029 26 00            LD H, 0
 595+ E02B 29               ADD HL, HL
 596+ E02C 29               ADD HL, HL
 597+ E02D 29               ADD HL, HL                          ; HL = indice * 8
 598+ E02E 01 7C E2         LD BC, DayHudFont
 599+ E031 09               ADD HL, BC
 600+ E032 C9               RET
 601+ E033
 602+ E033              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 603+ E033              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 604+ E033              .drawChar:
 605+ E033 06 08            LD B, 8
 606+ E035              .charLoop:
 607+ E035 7E               LD A, (HL)
 608+ E036 12               LD (DE), A
 609+ E037 23               INC HL
 610+ E038 14               INC D
 611+ E039 10 FA            DJNZ .charLoop
 612+ E03B C9               RET
 613+ E03C
 614+ E03C              ; Limpia 8 scan lines en VRAM (DE)
 615+ E03C              .clearChar:
 616+ E03C 06 08            LD B, 8
 617+ E03E AF               XOR A
 618+ E03F              .clearLoop:
 619+ E03F 12               LD (DE), A
 620+ E040 14               INC D
 621+ E041 10 FC            DJNZ .clearLoop
 622+ E043 C9               RET
 623+ E044
 624+ E044              ; ==============================================================================
 625+ E044              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 626+ E044              ; ==============================================================================
 627+ E044              DrawPlayerSpeedHUD:
 628+ E044 3A 46 90         LD A, (PlayerCurrentSpeed)
 629+ E047 C6 30            ADD A, '0'
 630+ E049 1E 02            LD E, 2
 631+ E04B CD A4 E0         CALL DrawHudCharRow0
 632+ E04E                  ; Atributo (bright white)
 633+ E04E 3E 47            LD A, $47
 634+ E050 32 02 58         LD (ATTR_BASE + 2), A
 635+ E053 C9               RET
 636+ E054
 637+ E054              ; ==============================================================================
 638+ E054              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 639+ E054              ; ==============================================================================
 640+ E054              DrawZoneCountHUD:
 641+ E054 3A 00 5D         LD A, (ZoneCellCount)
 642+ E057                  ; Hi nibble
 643+ E057 47               LD B, A
 644+ E058 CB 3F            SRL A
 645+ E05A CB 3F            SRL A
 646+ E05C CB 3F            SRL A
 647+ E05E CB 3F            SRL A
 648+ E060 FE 0A            CP 10
 649+ E062 38 04            JR C, .dzcHiDigit
 650+ E064 C6 37            ADD A, 'A' - 10
 651+ E066 18 02            JR .dzcHiOut
 652+ E068              .dzcHiDigit:
 653+ E068 C6 30            ADD A, '0'
 654+ E06A              .dzcHiOut:
 655+ E06A 1E 0B            LD E, 11
 656+ E06C CD A4 E0         CALL DrawHudCharRow0
 657+ E06F                  ; Lo nibble
 658+ E06F 78               LD A, B
 659+ E070 E6 0F            AND $0F
 660+ E072 FE 0A            CP 10
 661+ E074 38 04            JR C, .dzcLoDigit
 662+ E076 C6 37            ADD A, 'A' - 10
 663+ E078 18 02            JR .dzcLoOut
 664+ E07A              .dzcLoDigit:
 665+ E07A C6 30            ADD A, '0'
 666+ E07C              .dzcLoOut:
 667+ E07C 1E 0C            LD E, 12
 668+ E07E CD A4 E0         CALL DrawHudCharRow0
 669+ E081 3E 47            LD A, $47
 670+ E083 32 0B 58         LD (ATTR_BASE + 11), A
 671+ E086 32 0C 58         LD (ATTR_BASE + 12), A
 672+ E089 C9               RET
 673+ E08A
 674+ E08A              ; ==============================================================================
 675+ E08A              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 676+ E08A              ; ==============================================================================
 677+ E08A              DrawEnemySpeedHUD:
 678+ E08A                  ; "V" en columna 30
 679+ E08A 3E 56            LD A, 'V'
 680+ E08C 1E 1E            LD E, 30
 681+ E08E CD A4 E0         CALL DrawHudCharRow0
 682+ E091                  ; Numero de velocidad en columna 31
 683+ E091 3A 15 90         LD A, (CurrentEnemySpeed)
 684+ E094 C6 30            ADD A, '0'
 685+ E096 1E 1F            LD E, 31
 686+ E098 CD A4 E0         CALL DrawHudCharRow0
 687+ E09B                  ; Atributos (bright white)
 688+ E09B 3E 47            LD A, $47
 689+ E09D 32 1E 58         LD (ATTR_BASE + 30), A
 690+ E0A0 32 1F 58         LD (ATTR_BASE + 31), A
 691+ E0A3 C9               RET
 692+ E0A4
 693+ E0A4              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 694+ E0A4              ; A = codigo ASCII, E = columna (0-31)
 695+ E0A4              DrawHudCharRow0:
 696+ E0A4 6F               LD L, A
 697+ E0A5 26 00            LD H, 0
 698+ E0A7 29               ADD HL, HL
 699+ E0A8 29               ADD HL, HL
 700+ E0A9 29               ADD HL, HL
 701+ E0AA 01 00 3C         LD BC, $3C00
 702+ E0AD 09               ADD HL, BC                  ; HL = font data
 703+ E0AE 16 40            LD D, $40                   ; Tercio 0, scan line 0
 704+ E0B0 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 705+ E0B1 5F               LD E, A                     ; DE = dir VRAM
 706+ E0B2 06 08            LD B, 8
 707+ E0B4              .row0Char:
 708+ E0B4 7E               LD A, (HL)
 709+ E0B5 12               LD (DE), A
 710+ E0B6 23               INC HL
 711+ E0B7 14               INC D                       ; siguiente scan line
 712+ E0B8 10 FA            DJNZ .row0Char
 713+ E0BA C9               RET
 714+ E0BB
 715+ E0BB              ; ==============================================================================
 716+ E0BB              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 717+ E0BB              ; ==============================================================================
 718+ E0BB              DrawTimeIndicator:
 719+ E0BB                  ; Calcular puntero al label de 2 chars
 720+ E0BB 3A 6F DD         LD A, (CurrentTimeOfDay)
 721+ E0BE 87               ADD A, A                    ; A = momento * 2
 722+ E0BF 5F               LD E, A
 723+ E0C0 16 00            LD D, 0
 724+ E0C2 21 C2 E1         LD HL, TimeLabels
 725+ E0C5 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 726+ E0C6
 727+ E0C6                  ; Primer caracter en columna 30
 728+ E0C6 7E               LD A, (HL)
 729+ E0C7 E5               PUSH HL
 730+ E0C8 1E 1E            LD E, 30
 731+ E0CA CD DE E0         CALL DrawHudChar
 732+ E0CD E1               POP HL
 733+ E0CE
 734+ E0CE                  ; Segundo caracter en columna 31
 735+ E0CE 23               INC HL
 736+ E0CF 7E               LD A, (HL)
 737+ E0D0 1E 1F            LD E, 31
 738+ E0D2 CD DE E0         CALL DrawHudChar
 739+ E0D5
 740+ E0D5                  ; Atributos del indicador (bright white on black)
 741+ E0D5 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 742+ E0D8 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 743+ E0DA 77               LD (HL), A
 744+ E0DB 23               INC HL
 745+ E0DC 77               LD (HL), A
 746+ E0DD C9               RET
 747+ E0DE
 748+ E0DE              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 749+ E0DE              ; A = codigo ASCII, E = columna (0-31)
 750+ E0DE              DrawHudChar:
 751+ E0DE                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 752+ E0DE 6F               LD L, A
 753+ E0DF 26 00            LD H, 0
 754+ E0E1 29               ADD HL, HL
 755+ E0E2 29               ADD HL, HL
 756+ E0E3 29               ADD HL, HL
 757+ E0E4 01 00 3C         LD BC, $3C00
 758+ E0E7 09               ADD HL, BC                  ; HL = font data
 759+ E0E8
 760+ E0E8                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 761+ E0E8 16 40            LD D, $40                   ; Tercio 0, scan line 0
 762+ E0EA 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 763+ E0EC 83               ADD A, E
 764+ E0ED 5F               LD E, A                     ; DE = dir VRAM
 765+ E0EE
 766+ E0EE 06 08            LD B, 8
 767+ E0F0              .hudCharLoop:
 768+ E0F0 7E               LD A, (HL)
 769+ E0F1 12               LD (DE), A
 770+ E0F2 23               INC HL
 771+ E0F3 14               INC D                       ; Siguiente scan line
 772+ E0F4 10 FA            DJNZ .hudCharLoop
 773+ E0F6 C9               RET
