 496  9DBC                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9DBC              ; ==============================================================================
   2+ 9DBC              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DBC              ; ==============================================================================
   4+ 9DBC              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DBC              ; - Game loop per-entity: erase → update → draw
   6+ 9DBC              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DBC              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DBC              ; - XOR draw/erase (una sola rutina)
   9+ 9DBC              ; ==============================================================================
  10+ 9DBC
  11+ 9DBC              ; ==============================================================================
  12+ 9DBC              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DBC              ; ==============================================================================
  14+ 9DBC              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DBC              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DBC              ; ==============================================================================
  17+ 9DBC              ReadInput:
  18+ 9DBC 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DBE 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DC0
  21+ 9DC0                  ; -- 1. QAOP --
  22+ 9DC0 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC3 ED 78            IN A, (C)
  24+ 9DC5 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DC7 20 02            JR NZ, .no_q
  26+ 9DC9 CB C2            SET 0, D
  27+ 9DCB              .no_q:
  28+ 9DCB 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DCE ED 78            IN A, (C)
  30+ 9DD0 CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD2 20 02            JR NZ, .no_a
  32+ 9DD4 CB CA            SET 1, D
  33+ 9DD6              .no_a:
  34+ 9DD6 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DD9 ED 78            IN A, (C)
  36+ 9DDB CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DDD 20 02            JR NZ, .no_o
  38+ 9DDF CB DA            SET 3, D
  39+ 9DE1              .no_o:
  40+ 9DE1 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE3 20 02            JR NZ, .no_p
  42+ 9DE5 CB D2            SET 2, D
  43+ 9DE7              .no_p:
  44+ 9DE7
  45+ 9DE7                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DE7                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DE7 DB 1F            IN A, (31)
  48+ 9DE9 4F               LD C, A             ; guardar para fire
  49+ 9DEA CB 5F            BIT 3, A            ; Up
  50+ 9DEC 28 02            JR Z, .no_k_up
  51+ 9DEE CB C2            SET 0, D
  52+ 9DF0              .no_k_up:
  53+ 9DF0 CB 57            BIT 2, A            ; Down
  54+ 9DF2 28 02            JR Z, .no_k_down
  55+ 9DF4 CB CA            SET 1, D
  56+ 9DF6              .no_k_down:
  57+ 9DF6 CB 4F            BIT 1, A            ; Left
  58+ 9DF8 28 02            JR Z, .no_k_left
  59+ 9DFA CB DA            SET 3, D
  60+ 9DFC              .no_k_left:
  61+ 9DFC CB 47            BIT 0, A            ; Right
  62+ 9DFE 28 02            JR Z, .no_k_right
  63+ 9E00 CB D2            SET 2, D
  64+ 9E02              .no_k_right:
  65+ 9E02 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E04 28 02            JR Z, .no_k_fire
  67+ 9E06 CB C3            SET 0, E
  68+ 9E08              .no_k_fire:
  69+ 9E08
  70+ 9E08                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E08                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E08 01 FE F7         LD BC, $F7FE
  73+ 9E0B ED 78            IN A, (C)
  74+ 9E0D CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E0F 20 02            JR NZ, .no_s1_up
  76+ 9E11 CB C2            SET 0, D
  77+ 9E13              .no_s1_up:
  78+ 9E13 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E15 20 02            JR NZ, .no_s1_down
  80+ 9E17 CB CA            SET 1, D
  81+ 9E19              .no_s1_down:
  82+ 9E19 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E1B 20 02            JR NZ, .no_s1_left
  84+ 9E1D CB DA            SET 3, D
  85+ 9E1F              .no_s1_left:
  86+ 9E1F CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E21 20 02            JR NZ, .no_s1_right
  88+ 9E23 CB D2            SET 2, D
  89+ 9E25              .no_s1_right:
  90+ 9E25 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E27 20 02            JR NZ, .no_s1_fire
  92+ 9E29 CB C3            SET 0, E
  93+ 9E2B              .no_s1_fire:
  94+ 9E2B
  95+ 9E2B                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E2B 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E2E ED 78            IN A, (C)
  98+ 9E30 CB 47            BIT 0, A            ; SPACE
  99+ 9E32 20 02            JR NZ, .no_space
 100+ 9E34 CB C3            SET 0, E
 101+ 9E36              .no_space:
 102+ 9E36
 103+ 9E36                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E36 7B               LD A, E
 105+ 9E37 32 AE 82         LD (InputFire), A
 106+ 9E3A
 107+ 9E3A                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E3A 21 DC 82         LD HL, MushroomLockTimer
 109+ 9E3D 7E               LD A, (HL)
 110+ 9E3E 23               INC HL
 111+ 9E3F B6               OR (HL)
 112+ 9E40 28 21            JR Z, .noMushLock
 113+ 9E42 AF               XOR A
 114+ 9E43 32 AE 82         LD (InputFire), A
 115+ 9E46                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E46                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E46 7B               LD A, E
 118+ 9E47 B7               OR A
 119+ 9E48 28 15            JR Z, .resetNoSwordFlag
 120+ 9E4A 3A B7 82         LD A, (NoSwordSoundFlag)
 121+ 9E4D B7               OR A
 122+ 9E4E 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E50 3E 01            LD A, 1
 124+ 9E52 32 B7 82         LD (NoSwordSoundFlag), A
 125+ 9E55 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E56 21 97 FA         LD HL, SFX_NoSwordError
 127+ 9E59 CD 55 F9         CALL PlaySFX
 128+ 9E5C D1               POP DE
 129+ 9E5D 18 04            JR .noMushLock
 130+ 9E5F              .resetNoSwordFlag:
 131+ 9E5F AF               XOR A
 132+ 9E60 32 B7 82         LD (NoSwordSoundFlag), A
 133+ 9E63              .noMushLock:
 134+ 9E63
 135+ 9E63                  ; -- 6. Cancelar opuestos --
 136+ 9E63 7A               LD A, D
 137+ 9E64 47               LD B, A
 138+ 9E65 E6 03            AND DIR_N | DIR_S
 139+ 9E67 FE 03            CP DIR_N | DIR_S
 140+ 9E69 20 04            JR NZ, .noVC
 141+ 9E6B 78               LD A, B
 142+ 9E6C E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ 9E6E 47               LD B, A
 144+ 9E6F              .noVC:
 145+ 9E6F 78               LD A, B
 146+ 9E70 E6 0C            AND DIR_E | DIR_W
 147+ 9E72 FE 0C            CP DIR_E | DIR_W
 148+ 9E74 20 04            JR NZ, .noHC
 149+ 9E76 78               LD A, B
 150+ 9E77 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ 9E79 47               LD B, A
 152+ 9E7A              .noHC:
 153+ 9E7A 78               LD A, B
 154+ 9E7B 32 AD 82         LD (InputDirection), A
 155+ 9E7E C9               RET
