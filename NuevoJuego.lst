 273+ FA8D              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 274+ FA8D              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 275+ FA8D              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 276+ FA8D              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 277+ FA8D              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 278+ FA8D              SFX_KeyDrop:
 279+ FA8D 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 280+ FA91 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 281+ FA95 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 282+ FA99 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 283+ FA9D 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 284+ FAA1 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 285+ FAA5 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 286+ FAA9 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 287+ FAAD 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 288+ FAB1 00               DEFB   0                       ; fin
 289+ FAB2
 290+ FAB2              ; --- Sistema de campanadas con pausa entre ellas ---
 291+ FAB2              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 292+ FAB2              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 293+ FAB2              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 294+ FAB2 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 295+ FAB3 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 296+ FAB5              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 297+ FAB5              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 298+ FAB5
 299+ FAB5              ; --- Cadena de eventos tras la ultima campanada ---
 300+ FAB5              ; last chime → (delay) → windows off → (delay) → monster spawn
 301+ FAB5              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 302+ FAB5              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 303+ FAB5 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 304+ FAB6 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 305+ FAB7
 306+ FAB7              ; ==============================================================================
 307+ FAB7              ; StartBellChimes - Inicia secuencia de 12 campanadas
 308+ FAB7              ; ==============================================================================
 309+ FAB7              StartBellChimes:
 310+ FAB7                  ; Silenciar musica activa (death o cualquier otra). Bell escribe R7 (mixer
 311+ FAB7                  ; all-on), R0-R5 (period A/B/C) y R8-R10 (vols), clobbeando lo que la musica
 312+ FAB7                  ; mantenga en canal B. Mejor parar limpiamente que oir glitches.
 313+ FAB7 F5               PUSH AF
 314+ FAB8 3E FF            LD A, $FF
 315+ FABA CD 06 9D         CALL StartMusic
 316+ FABD F1               POP AF
 317+ FABE 3E 03            LD A, 3                             ; DEBUG: 3 campanadas (era 12)
 318+ FAC0 32 B2 FA         LD (BellCount), A
 319+ FAC3                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 320+ FAC3 2A 78 5C         LD HL, (SYS_FRAMES)
 321+ FAC6 22 B3 FA         LD (BellNextFrame), HL
 322+ FAC9 3E 7D            LD A, SCARE_TIMER_BELLS
 323+ FACB 32 04 B9         LD (ScareTimer), A
 324+ FACE C9               RET
 325+ FACF
 326+ FACF              ; ==============================================================================
 327+ FACF              ; UpdateBellChimes - Llamar cada frame desde el main loop
 328+ FACF              ; ==============================================================================
 329+ FACF              UpdateBellChimes:
 330+ FACF 3A B2 FA         LD A, (BellCount)
 331+ FAD2 B7               OR A
 332+ FAD3 C8               RET Z                       ; sin campanadas pendientes
 333+ FAD4
 334+ FAD4                  ; Comparar FRAMES actual con BellNextFrame
 335+ FAD4 2A 78 5C         LD HL, (SYS_FRAMES)
 336+ FAD7 ED 5B B3 FA      LD DE, (BellNextFrame)
 337+ FADB B7               OR A
 338+ FADC ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 339+ FADE D8               RET C                       ; FRAMES < deadline → aun no toca
 340+ FADF
 341+ FADF                  ; Sonar campanada (AY, no bloquea CPU)
 342+ FADF C5               PUSH BC
 343+ FAE0 D5               PUSH DE
 344+ FAE1 CD 29 9C         CALL AY_PlayBellChime
 345+ FAE4 D1               POP DE
 346+ FAE5 C1               POP BC
 347+ FAE6
 348+ FAE6                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 349+ FAE6                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 350+ FAE6 2A 78 5C         LD HL, (SYS_FRAMES)
 351+ FAE9 11 4B 00         LD DE, BELL_PAUSE
 352+ FAEC 19               ADD HL, DE
 353+ FAED 22 B3 FA         LD (BellNextFrame), HL
 354+ FAF0
 355+ FAF0 21 B2 FA         LD HL, BellCount
 356+ FAF3 35               DEC (HL)
 357+ FAF4 C0               RET NZ
 358+ FAF5 18 00            JR .bellsDone
 359+ FAF7
 360+ FAF7              .bellsDone:
 361+ FAF7                  ; Ultima campanada:
 362+ FAF7                  ;   1) matar todos los nasties vivos (puff)
 363+ FAF7                  ;   2) arrancar cadena diferida: windows off → monster spawn
 364+ FAF7 CD 43 BD         CALL KillAllActiveNasties
 365+ FAFA 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 366+ FAFC 32 B5 FA         LD (BellsDoneTimer), A
 367+ FAFF C9               RET
 368+ FB00
 369+ FB00              ; ==============================================================================
 370+ FB00              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 371+ FB00              ; ==============================================================================
 372+ FB00              ; Maneja la cadena diferida tras la ultima campanada:
 373+ FB00              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 374+ FB00              ;      y arranca SpawnAfterWinTimer
 375+ FB00              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 376+ FB00              ; ==============================================================================
 377+ FB00              UpdateBellsDoneTimer:
 378+ FB00 3A B5 FA         LD A, (BellsDoneTimer)
 379+ FB03 B7               OR A
 380+ FB04 28 21            JR Z, .ubdCheckSpawn
 381+ FB06 3D               DEC A
 382+ FB07 32 B5 FA         LD (BellsDoneTimer), A
 383+ FB0A 20 1B            JR NZ, .ubdCheckSpawn
 384+ FB0C                  ; Llego a 0: apagar ventanas
 385+ FB0C CD B7 E5         CALL UpdateRemapTables
 386+ FB0F 3E 01            LD A, 1
 387+ FB11 32 B7 82         LD (AttrsDirty), A
 388+ FB14                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 389+ FB14                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 390+ FB14                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 391+ FB14                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 392+ FB14 3A 61 82         LD A, (ChurchDoorOpen)
 393+ FB17 B7               OR A
 394+ FB18 28 03            JR Z, .ubdSkipHighlight
 395+ FB1A CD 03 F5         CALL StartStatueBlink
 396+ FB1D              .ubdSkipHighlight:
 397+ FB1D 3E 26            LD A, POST_WINDOWS_SPAWN_DELAY
 398+ FB1F 32 B6 FA         LD (SpawnAfterWinTimer), A
 399+ FB22                  ; Musica de tension organica entre lights-off y monster spawn (track 0)
 400+ FB22 AF               XOR A                           ; A = 0 = MUSIC_TENSION
 401+ FB23 CD 06 9D         CALL StartMusic
 402+ FB26 C9               RET
 403+ FB27              .ubdCheckSpawn:
 404+ FB27 3A B6 FA         LD A, (SpawnAfterWinTimer)
 405+ FB2A B7               OR A
 406+ FB2B C8               RET Z
 407+ FB2C 3D               DEC A
 408+ FB2D 32 B6 FA         LD (SpawnAfterWinTimer), A
 409+ FB30 C0               RET NZ
 410+ FB31                  ; Llego a 0: spawnear monsters
 411+ FB31 C3 62 C0         JP SpawnMonsters
 412+ FB34
# file closed: sound.asm
 388  FB34                  ; ay_sound.asm: movido a bank 4 (ver PAGE 4 abajo). MainLoop entra via
 389  FB34                  ; los thunks en ay_sound_thunks.asm.
 390  FB34
 391  FB34                  ; --- Tumba 2x para Game Over (game_over_tomb.asm, bank 0) ---
 392  FB34                  ; Vive en bank 0 (junto a PaintGameOverScreen en logic_game.asm) → CALL
 393  FB34                  ; directo sin paginación. Usa LoadBgSpriteToBuffer (en slot 1 always-visible)
 394  FB34                  ; para cargar bank 4 (cemetery) a BgSpriteBuffer, luego decodifica RLE+CPL
 395  FB34                  ; y renderiza 2x. Cold path: 1 llamada por partida.
 396  FB34                  INCLUDE "game_over_tomb.asm"
# file opened: game_over_tomb.asm
   1+ FB34              ; ==============================================================================
   2+ FB34              ; GAME OVER — TUMBA DEL JUGADOR A 2x
   3+ FB34              ; ==============================================================================
   4+ FB34              ; Vive en slot 1 (siempre visible), cold path: una llamada por partida.
   5+ FB34              ;
   6+ FB34              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
   7+ FB34              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
   8+ FB34              ; Game Over. La muerte hace moonwalk justo encima del techo.
   9+ FB34              ;
  10+ FB34              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  11+ FB34              ;
  12+ FB34              ; Algoritmo:
  13+ FB34              ;   1. LoadBgSpriteToBuffer(BgGfx_little_house_cemetery, bank 4) → BgSpriteBuffer
  14+ FB34              ;      tiene [H=40, W|RLE=$86, RLE pixel data..., tint, AH=5, AW=6, attrs..., garbage].
  15+ FB34              ;   2. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  16+ FB34              ;      planos en TombDecodedPixels. Salva src ptr post-pixels (= byte tint).
  17+ FB34              ;   3. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  18+ FB34              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  19+ FB34              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  20+ FB34              ;   4. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  21+ FB34              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  22+ FB34              ;
  23+ FB34              ; Coste: ~30K T-states one-shot. Invisible.
  24+ FB34              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch = ~536 B en slot 1.
  25+ FB34              ;
  26+ FB34              ; Capas:
  27+ FB34              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  28+ FB34              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba
  29+ FB34              ;     ni con su 1x render → XOR redraw de muerte no corrompe.
  30+ FB34              ; ==============================================================================
  31+ FB34
  32+ FB34              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  33+ FB34              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  34+ FB34              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  35+ FB34              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  36+ FB34              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  37+ FB34              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  38+ FB34              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  39+ FB34              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  40+ FB34              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  41+ FB34
  42+ FB34              ; ==============================================================================
  43+ FB34              ; DrawTombstone2xCentered - entry point
  44+ FB34              ; ==============================================================================
  45+ FB34              ; Llamado desde PaintGameOverScreen (cold, 1 vez por partida).
  46+ FB34              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  47+ FB34              ; directamente a VRAM sin XOR.
  48+ FB34              ; Destruye: AF, BC, DE, HL, IX.
  49+ FB34              ; ==============================================================================
  50+ FB34              DrawTombstone2xCentered:
  51+ FB34                  ; --- 1. Cargar sprite a BgSpriteBuffer (paginación interna) ---
  52+ FB34 21 5B D9         LD HL, BgGfx_little_house_cemetery
  53+ FB37 3E 04            LD A, TOMB_SRC_BANK
  54+ FB39 CD 8F 6A         CALL LoadBgSpriteToBuffer
  55+ FB3C
  56+ FB3C                  ; --- 2. Decodificar pixeles RLE+CPL → flat buffer ---
  57+ FB3C CD 45 FB         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  58+ FB3F
  59+ FB3F                  ; --- 3. Dibujar pixeles 2x desde flat buffer ---
  60+ FB3F CD A2 FB         CALL DrawTombPixels2x
  61+ FB42
  62+ FB42                  ; --- 4. Dibujar attrs 2x desde BgSpriteBuffer ---
  63+ FB42 C3 2B FC         JP DrawTombAttrs2x              ; tail-call
  64+ FB45
  65+ FB45              ; ==============================================================================
  66+ FB45              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  67+ FB45              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  68+ FB45              ; ==============================================================================
  69+ FB45              ; Formato RLE (mismo que DrawBgGfxSprite):
  70+ FB45              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  71+ FB45              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  72+ FB45              ;
  73+ FB45              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  74+ FB45              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  75+ FB45              ;
  76+ FB45              ; Destruye: AF, BC, DE, HL.
  77+ FB45              ; ==============================================================================
  78+ FB45              DecodeTombRLEPixels:
  79+ FB45 21 9D 89         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  80+ FB48 11 72 FC         LD DE, TombDecodedPixels
