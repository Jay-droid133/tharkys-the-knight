2224+ AB27              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2225+ AB27              ; ==============================================================================
2226+ AB27              CheckWellPickup:
2227+ AB27 3A 5F 8D         LD A, (WellActive)
2228+ AB2A B7               OR A
2229+ AB2B C8               RET Z                               ; No hay pozo en esta pantalla
2230+ AB2C                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2231+ AB2C 2A 63 8D         LD HL, (WellCooldownTimer)
2232+ AB2F 7C               LD A, H
2233+ AB30 B5               OR L
2234+ AB31 C0               RET NZ                              ; timer > 0 → skip
2235+ AB32                  ; Skip si salud + stamina al maximo Y no hay debuff que curar
2236+ AB32 3A C8 B3         LD A, (PlayerHealth)
2237+ AB35 FE 10            CP HEALTH_MAX
2238+ AB37 20 1B            JR NZ, .cwDoCheck
2239+ AB39 3A C9 B3         LD A, (PlayerStamina)
2240+ AB3C FE 10            CP STAMINA_MAX
2241+ AB3E 20 14            JR NZ, .cwDoCheck
2242+ AB40                  ; Salud y stamina al maximo: chequear debuffs (seta / caracol / reverse)
2243+ AB40 2A E2 82         LD HL, (MushroomLockTimer)
2244+ AB43 7C               LD A, H
2245+ AB44 B5               OR L
2246+ AB45 20 0D            JR NZ, .cwDoCheck
2247+ AB47 2A DE 5F         LD HL, (ReverseTimer)
2248+ AB4A 7C               LD A, H
2249+ AB4B B5               OR L
2250+ AB4C 20 06            JR NZ, .cwDoCheck
2251+ AB4E 3A E1 82         LD A, (SpeedBuffType)
2252+ AB51 FE 02            CP SPEED_BUFF_TYPE_CARACOL
2253+ AB53 C0               RET NZ                              ; sin debuffs y todo maxed → nada
2254+ AB54              .cwDoCheck:
2255+ AB54                  ; AABB con margen de 8px (1 celda) por cada lado:
2256+ AB54                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2257+ AB54                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2258+ AB54                  ; --- Check X ---
2259+ AB54 3A 60 8D         LD A, (WellPosX)
2260+ AB57 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2261+ AB59 4F               LD C, A
2262+ AB5A 3A A6 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2263+ AB5D B9               CP C                                ; playerX < wellRight+margen?
2264+ AB5E 30 60            JR NC, .cwNoOverlap                 ; no → fuera
2265+ AB60 3A A6 81         LD A, (EntityTable + ENT_POSX)
2266+ AB63 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2267+ AB65 4F               LD C, A
2268+ AB66 3A 60 8D         LD A, (WellPosX)                    ; A = wellX
2269+ AB69 B9               CP C                                ; wellX < playerRight+margen?
2270+ AB6A 30 54            JR NC, .cwNoOverlap                 ; no → fuera
2271+ AB6C                  ; --- Check Y ---
2272+ AB6C 3A 61 8D         LD A, (WellPosY)
2273+ AB6F C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2274+ AB71 4F               LD C, A
2275+ AB72 3A A7 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2276+ AB75 B9               CP C                                ; playerY < wellBottom+margen?
2277+ AB76 30 48            JR NC, .cwNoOverlap                 ; no → fuera
2278+ AB78 3A A7 81         LD A, (EntityTable + ENT_POSY)
2279+ AB7B C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2280+ AB7D 4F               LD C, A
2281+ AB7E 3A 61 8D         LD A, (WellPosY)                    ; A = wellY
2282+ AB81 B9               CP C                                ; wellY < playerBottom+margen?
2283+ AB82 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2284+ AB84                  ; --- Overlap! Recuperar salud y stamina ---
2285+ AB84 3E 10            LD A, HEALTH_MAX
2286+ AB86 32 C8 B3         LD (PlayerHealth), A
2287+ AB89 3E 10            LD A, STAMINA_MAX
2288+ AB8B 32 C9 B3         LD (PlayerStamina), A
