1322+ F535 21 9D 5F         LD HL, ChurchCutsceneFrame
1323+ F538 34               INC (HL)
1324+ F539 C9               RET
1325+ F53A              .ucsShakeJitterTable:
1326+ F53A 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1327+ F53E              .ucsShakeStatueDone:
1328+ F53E                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1329+ F53E AF               XOR A
1330+ F53F D3 FE            OUT (254), A
