 365+ E6AB              ; ==============================================================================
 366+ E6AB              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 367+ E6AB              ; ==============================================================================
 368+ E6AB              ; Entrada: A = sprite ID
 369+ E6AB              ; Setea BgSpriteIsHouse (0 o 1)
 370+ E6AB              ; Preserva: A, DE, IX
 371+ E6AB              ;
 372+ E6AB              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 373+ E6AB              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 374+ E6AB              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 375+ E6AB              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 376+ E6AB              ; ==============================================================================
 377+ E6AB              CheckIfHouseSprite:
 378+ E6AB F5               PUSH AF
 379+ E6AC E5               PUSH HL
 380+ E6AD C5               PUSH BC
 381+ E6AE
 382+ E6AE 47               LD B, A                     ; B = id buscado
 383+ E6AF
 384+ E6AF AF               XOR A
 385+ E6B0 32 0F E5         LD (BgSpriteIsHouse), A     ; Default: no es house
 386+ E6B3
 387+ E6B3 21 C7 E1         LD HL, HouseIdList
 388+ E6B6              .checkLoop:
 389+ E6B6 7E               LD A, (HL)
 390+ E6B7 FE FF            CP $FF
 391+ E6B9 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 392+ E6BB B8               CP B
 393+ E6BC 28 03            JR Z, .checkFound
 394+ E6BE 23               INC HL
 395+ E6BF 18 F5            JR .checkLoop
 396+ E6C1
 397+ E6C1              .checkFound:
 398+ E6C1 3E 01            LD A, 1
 399+ E6C3 32 0F E5         LD (BgSpriteIsHouse), A
 400+ E6C6
 401+ E6C6              .checkDone:
 402+ E6C6 C1               POP BC
 403+ E6C7 E1               POP HL
 404+ E6C8 F1               POP AF
 405+ E6C9 C9               RET
 406+ E6CA
 407+ E6CA              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 408+ E6CA              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 409+ E6CA              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 410+ E6CA
 411+ E6CA              ; ==============================================================================
 412+ E6CA              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 413+ E6CA              ; ==============================================================================
 414+ E6CA              ; Formato: XX,YY:NN nombre_room     DY
 415+ E6CA              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 416+ E6CA              ; ==============================================================================
 417+ E6CA              DrawRoomInfo:
 418+ E6CA                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 419+ E6CA 1E 00            LD E, 0
 420+ E6CC 06 0D            LD B, 13
 421+ E6CE              .clearLoop:
 422+ E6CE C5               PUSH BC
 423+ E6CF D5               PUSH DE
 424+ E6D0 3E 20            LD A, ' '
 425+ E6D2 CD 85 E8         CALL DrawHudChar
 426+ E6D5 D1               POP DE
 427+ E6D6 C1               POP BC
 428+ E6D7 1C               INC E
 429+ E6D8 10 F4            DJNZ .clearLoop
 430+ E6DA
 431+ E6DA                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 432+ E6DA 3A 08 83         LD A, (CurrentScreenX)
 433+ E6DD 1E 00            LD E, 0
 434+ E6DF CD 3D E7         CALL .drawDec2
 435+ E6E2
 436+ E6E2                  ; --- ',' en col 2 ---
 437+ E6E2 3E 2C            LD A, ','
 438+ E6E4 1E 02            LD E, 2
 439+ E6E6 CD 85 E8         CALL DrawHudChar
 440+ E6E9
 441+ E6E9                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 442+ E6E9 3A 09 83         LD A, (CurrentScreenY)
 443+ E6EC 1E 03            LD E, 3
 444+ E6EE CD 3D E7         CALL .drawDec2
 445+ E6F1
 446+ E6F1                  ; --- ':' en col 5 ---
 447+ E6F1 3E 3A            LD A, ':'
 448+ E6F3 1E 05            LD E, 5
 449+ E6F5 CD 85 E8         CALL DrawHudChar
 450+ E6F8
 451+ E6F8                  ; --- Obtener room index de MapTable[Y*16+X] ---
 452+ E6F8 3A 09 83         LD A, (CurrentScreenY)
 453+ E6FB 6F               LD L, A
 454+ E6FC 26 00            LD H, 0
 455+ E6FE 29               ADD HL, HL
 456+ E6FF 29               ADD HL, HL
 457+ E700 29               ADD HL, HL
 458+ E701 29               ADD HL, HL                  ; HL = Y * 16
 459+ E702 3A 08 83         LD A, (CurrentScreenX)
 460+ E705 5F               LD E, A
 461+ E706 16 00            LD D, 0
 462+ E708 19               ADD HL, DE                  ; HL = Y*16 + X
 463+ E709 11 24 E0         LD DE, MapTable
 464+ E70C 19               ADD HL, DE
 465+ E70D 7E               LD A, (HL)                  ; A = room index (0-47)
 466+ E70E F5               PUSH AF                     ; guardar room index
 467+ E70F
 468+ E70F                  ; --- Room index como 2 hex en cols 6-7 ---
 469+ E70F F5               PUSH AF
 470+ E710 0F               RRCA
 471+ E711 0F               RRCA
 472+ E712 0F               RRCA
 473+ E713 0F               RRCA
 474+ E714 E6 0F            AND $0F
 475+ E716 CD 5B E7         CALL .hexToAscii
 476+ E719 1E 06            LD E, 6
 477+ E71B CD 85 E8         CALL DrawHudChar
 478+ E71E F1               POP AF
 479+ E71F E6 0F            AND $0F
 480+ E721 CD 5B E7         CALL .hexToAscii
 481+ E724 1E 07            LD E, 7
 482+ E726 CD 85 E8         CALL DrawHudChar
 483+ E729
 484+ E729                  ; --- Espacio en col 8 ---
 485+ E729 3E 20            LD A, ' '
 486+ E72B 1E 08            LD E, 8
 487+ E72D CD 85 E8         CALL DrawHudChar
 488+ E730
 489+ E730                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 490+ E730 F1               POP AF                      ; A = room index (descartar)
 491+ E731
 492+ E731                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 493+ E731 21 20 58         LD HL, ATTR_BASE + 1 * 32
 494+ E734 3E 47            LD A, $47                   ; bright white on black
 495+ E736 06 0D            LD B, 13
 496+ E738              .attrLoop:
 497+ E738 77               LD (HL), A
 498+ E739 23               INC HL
 499+ E73A 10 FC            DJNZ .attrLoop
 500+ E73C C9               RET
 501+ E73D
 502+ E73D              ; --- Helpers ---
 503+ E73D              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 504+ E73D              .drawDec2:
 505+ E73D 4B               LD C, E                     ; guardar columna inicial
 506+ E73E 06 00            LD B, 0                     ; decenas
 507+ E740              .divLoop:
 508+ E740 FE 0A            CP 10
 509+ E742 38 05            JR C, .divDone
 510+ E744 D6 0A            SUB 10
 511+ E746 04               INC B
 512+ E747 18 F7            JR .divLoop
 513+ E749              .divDone:
 514+ E749                  ; B = decenas, A = unidades
 515+ E749 F5               PUSH AF                     ; guardar unidades
 516+ E74A 78               LD A, B
 517+ E74B C6 30            ADD A, '0'
 518+ E74D 59               LD E, C
 519+ E74E C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 520+ E74F CD 85 E8         CALL DrawHudChar
 521+ E752 C1               POP BC                      ; restaurar C
 522+ E753 F1               POP AF
 523+ E754 C6 30            ADD A, '0'
 524+ E756 59               LD E, C
 525+ E757 1C               INC E
 526+ E758 C3 85 E8         JP DrawHudChar              ; tail call
 527+ E75B
 528+ E75B              .hexToAscii:
 529+ E75B FE 0A            CP 10
 530+ E75D 38 03            JR C, .isDigit
 531+ E75F C6 37            ADD A, 'A' - 10
 532+ E761 C9               RET
 533+ E762              .isDigit:
 534+ E762 C6 30            ADD A, '0'
 535+ E764 C9               RET
