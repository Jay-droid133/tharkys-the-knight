 116+ 605E              ; ==============================================================================
 117+ 605E              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ 605E              ; ==============================================================================
 119+ 605E              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ 605E              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ 605E              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ 605E              ;
 123+ 605E              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ 605E              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ 605E              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ 605E              ; Destruye: AF, BC, DE, HL, IX.
 127+ 605E              ; ==============================================================================
 128+ 605E              CheckTownGateTriggerBg:
 129+ 605E 3A 74 82         LD A, (TownGatePhase)
 130+ 6061 B7               OR A
 131+ 6062 C0               RET NZ                              ; ya en cutscene
 132+ 6063 3A 5E 82         LD A, (CurrentKey)
 133+ 6066 FE 06            CP TGCS_ARCH_KEY_ID
 134+ 6068 C0               RET NZ                              ; sin la key correcta
 135+ 6069 3A AD 82         LD A, (CurrentScreenX)
 136+ 606C FE 07            CP TGCS_ARCH_ROOM_X
 137+ 606E C0               RET NZ
 138+ 606F 3A AE 82         LD A, (CurrentScreenY)
 139+ 6072 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ 6074 C0               RET NZ
 141+ 6075                  ; --- Horizontal AABB ---
 142+ 6075 3A 4E 81         LD A, (EntityTable + ENT_POSX)
 143+ 6078 4F               LD C, A                             ; C = player_left
 144+ 6079 C6 10            ADD A, 16
 145+ 607B 57               LD D, A                             ; D = player_right
 146+ 607C 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ 607E D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ 6080 30 01            JR NC, .ctgtNoUnderL
 149+ 6082 AF               XOR A
 150+ 6083              .ctgtNoUnderL:
 151+ 6083 BA               CP D
 152+ 6084 D0               RET NC                              ; ext_left >= player_right
 153+ 6085 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ 6087 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ 6089 30 02            JR NC, .ctgtNoOverR
 156+ 608B 3E FF            LD A, $FF
 157+ 608D              .ctgtNoOverR:
 158+ 608D B9               CP C
 159+ 608E D8               RET C                               ; ext_right < player_left
 160+ 608F                  ; --- Vertical AABB ---
 161+ 608F                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ 608F                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ 608F                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ 608F                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ 608F                  ; con la altura real del rect.
 166+ 608F 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 167+ 6092 4F               LD C, A                             ; C = player_top
 168+ 6093 C6 15            ADD A, 21
 169+ 6095 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ 6096 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ 6098 D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ 609A 30 01            JR NC, .ctgtNoUnderT
 173+ 609C AF               XOR A
 174+ 609D              .ctgtNoUnderT:
 175+ 609D BA               CP D
 176+ 609E D0               RET NC
 177+ 609F 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ 60A1 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ 60A3 30 02            JR NC, .ctgtNoOverB
 180+ 60A5 3E FF            LD A, $FF
 181+ 60A7              .ctgtNoOverB:
 182+ 60A7 B9               CP C
 183+ 60A8 D8               RET C
