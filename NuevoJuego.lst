   1+ 0000              ; ==============================================================================
   2+ 0000              ; MACROS ÚTILES PARA EL DESARROLLO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000                  ; Marco para pintar un color rápidamente en la pantalla
   6+ 0000                  MACRO SET_COLOR color, address
   7+ 0000 ~                    LD A, color
   8+ 0000 ~                    LD HL, address
   9+ 0000 ~                    LD (HL), A
  10+ 0000                  ENDM
  11+ 0000
  12+ 0000                  ; Macro estándar para sumar A a HL
  13+ 0000                  MACRO ADD_HL_A
  14+ 0000 ~                    ADD A, L
  15+ 0000 ~                    LD L, A
  16+ 0000 ~                    ADC A, H
  17+ 0000 ~                    SUB L
  18+ 0000 ~                    LD H, A
  19+ 0000                  ENDM
  20+ 0000
# file closed: macros.asm
  11  0000
  12  0000                  ; Origen del programa en RAM
  13  0000                  ORG ORIGIN_ADDRESS
  14  8000
  15  8000              Inicio:
  16  8000 F3               DI                      ; Deshabilitar interrupciones
  17  8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  18  8004
  19  8004                  ; Configuración inicial (Borde negro, etc.)
  20  8004 3E 01            LD A, BLUE              ; A = 1 (Azul oscuro)
  21  8006 D3 FE            OUT (254), A            ; Cambia el color del borde a azul oscuro
  22  8008 32 A0 87         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  23  800B
  24  800B                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  25  800B                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  26  800B 21 00 40         LD HL, SCREEN_BASE
  27  800E 11 01 40         LD DE, SCREEN_BASE + 1
  28  8011 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  29  8014 AF               XOR A                   ; A = 0
  30  8015 77               LD (HL), A
  31  8016 ED B0            LDIR
  32  8018
  33  8018                  ; Inicializar sistema de pantallas
  34  8018 CD C8 A9         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  35  801B CD B6 8B         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  36  801E CD 2C EA         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  37  8021 CD CC A2         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  38  8024 CD 68 F1         CALL DrawClockSprite    ; Dibujar decoración del reloj (solo se repite en cambio de pantalla)
  39  8027 CD B2 EA         CALL DrawSwordModeHUD   ; Mostrar modo de espada inicial
  40  802A
  41  802A ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  42  802C FB               EI                      ; Habilitar interrupciones
  43  802D
  44  802D              ; ==============================================================================
  45  802D              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
  46  802D              ; ==============================================================================
  47  802D              ; El original NO separa render de logica. Cada entidad hace todo junto:
  48  802D              ;   erase viejo → AI/movimiento → draw nuevo
  49  802D              ; Player: siempre se procesa completo cada frame (tras HALT).
  50  802D              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
  51  802D              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
  52  802D              ; ==============================================================================
  53  802D              MainLoop:
  54  802D 76               HALT                    ; Esperar al barrido de pantalla (sincronizar a 50 FPS)
  55  802E
  56  802E                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
  57  802E CD 05 AA         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
  58  8031 CD 2A AB         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
  59  8034 CD 5C AD         CALL RemapScreenAttrs       ; Remap attrs si cambio de fase (~fast)
  60  8037
  61  8037                  ; === PLAYER: siempre cada frame, completo (erase+logic+draw) ===
  62  8037 CD 0D A0         CALL EraseDeadSprites       ; Cleanup puff terminadas (~20T normal)
  63  803A CD 1C 8B         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
  64  803D CD 21 8C         CALL ProcessPlayer          ; Erase + logic + draw player (todo junto)
  65  8040 CD 43 96         CALL CheckWellPickup        ; Recuperar salud/stamina si pisa un pozo
  66  8043 CD F6 AE         CALL CheckPickupCollect     ; Detectar pickups (borrado diferido al siguiente frame)
  67  8046
  68  8046                  ; Limpiar flag de pantalla recien dibujada (tras renderizar player)
  69  8046 AF               XOR A
  70  8047 32 B6 81         LD (ScreenJustRedrawn), A
  71  804A
  72  804A                  ; === ENEMIGOS: round-robin, erase+logic+draw por entidad ===
  73  804A CD 3B 8D         CALL ProcessEnemies         ; Round-robin: hasta MAX_ENEMIES_PER_FRAME
  74  804D
  75  804D                  ; === SISTEMAS GLOBALES ===
  76  804D CD F9 A0         CALL TrySpawnNasty          ; Spawn check (tiene su propio timer)
  77  8050 CD D7 A3         CALL TryRespawnMonsters     ; Rellenar slots monster vacios (siempre 3)
  78  8053 CD 75 A7         CALL CheckPlayerEnemyCollision ; Colision player vs enemigos
  79  8056 CD DC F0         CALL DrawClockHUD           ; Reloj: cara + agujas (HUD fijo, no flicker)
  80  8059 CD 63 F3         CALL DrawPlazaClock         ; Reloj de plaza (si existe en esta room)
  81  805C CD 01 F2         CALL DrawHealthStaminaHUD   ; Barras salud/stamina en decoraciones
  82  805F CD B2 EA         CALL DrawSwordModeHUD       ; Debug: indicador modo espada
  83  8062 CD D7 EB         CALL DrawDayCycleHUD        ; Indicador de dia (D1, D2, D3...)
  84  8065 CD F7 EB         CALL DrawPlayerSpeedHUD     ; Debug: velocidad player (fila 0, col 2)
  85  8068 CD 07 EC         CALL DrawEnemySpeedHUD      ; Debug: velocidad nasties (V1, V2...)
  86  806B CD 75 F0         CALL UpdateGameClock        ; Avanzar reloj de juego
  87  806E CD 6B A2         CALL UpdateEnemySpeed       ; Ajustar velocidad nasties segun ciclo
  88  8071 CD 12 F5         CALL UpdateBellChimes       ; Campanadas de medianoche (si activas)
  89  8074 CD 9E 9F         CALL UpdateScareTimer       ; Countdown pausa+huida (bells/dawn)
  90  8077 CD 51 EA         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
