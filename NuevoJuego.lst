 428+ F294              .dcRedraw:
 429+ F294                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 430+ F294 3A 68 82         LD A, (ObjectiveScreenX)
 431+ F297 47               LD B, A
 432+ F298 3A AE 82         LD A, (CurrentScreenX)
 433+ F29B 4F               LD C, A
 434+ F29C 78               LD A, B
 435+ F29D 91               SUB C                               ; A = dx (signed)
 436+ F29E                  ; abs(dx) -> H, sign(dx)+1 -> L
 437+ F29E F2 A8 F2         JP P, .dcDxNonNeg
 438+ F2A1 ED 44            NEG
 439+ F2A3 67               LD H, A                             ; abs(dx)
 440+ F2A4 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 441+ F2A6 18 0A            JR .dcDxDone
 442+ F2A8              .dcDxNonNeg:
