 129+ 9E38                  ; ==================================================================
 130+ 9E38                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9E38                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9E38                  ; ==================================================================
 133+ 9E38 CD 31 A1         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9E3B DD E5            PUSH IX
 135+ 9E3D D1               POP DE                      ; DE = puntero a pixel data
 136+ 9E3E 3A 9A 9E         LD A, (.heightSave)
 137+ 9E41 4F               LD C, A                     ; C = height counter
