1872+ A953              UpdatePlayerAnimation:
1873+ A953                  ; Determinar animacion segun estado y direccion
1874+ A953 DD 7E 02         LD A, (IX+ENT_STATE)
1875+ A956 FE 02            CP STATE_FIGHTING
1876+ A958 28 0C            JR Z, .animFight
1877+ A95A FE 01            CP STATE_RUNNING
1878+ A95C 28 21            JR Z, .animRun
1879+ A95E
1880+ A95E                  ; --- IDLE ---
1881+ A95E 16 00            LD D, SPRID_IDLE
1882+ A960 1E 02            LD E, ANIM_FRAMES_IDLE
1883+ A962 0E 0A            LD C, ANIM_DELAY_IDLE
1884+ A964 18 44            JR .applyAnim
1885+ A966
1886+ A966              .animFight:
1887+ A966                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1888+ A966 DD 7E 0A         LD A, (IX+ENT_DIR)
1889+ A969 0F               RRCA
1890+ A96A 0F               RRCA
1891+ A96B 0F               RRCA
1892+ A96C 0F               RRCA
1893+ A96D E6 0F            AND $0F                     ; lastHDir
1894+ A96F FE 08            CP DIR_W
1895+ A971 28 04            JR Z, .fightW
1896+ A973 16 16            LD D, SPRID_ATTACK_EAST
1897+ A975 18 02            JR .fightSet
1898+ A977              .fightW:
