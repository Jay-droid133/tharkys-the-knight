  88+ 9C29              ; --- AY_PlayBellChime: medianoche/iglesia, cold ---
  89+ 9C29              ; D = pan (-1=izq, 0=centro, +1=der). Preservar D atraviesa el thunk porque
  90+ 9C29              ; el patron page-switch no toca DE.
  91+ 9C29              AY_PlayBellChime:
  92+ 9C29 F3               DI
  93+ 9C2A 3A E8 90         LD A, (CurrentPaging)
  94+ 9C2D E6 F8            AND $F8
  95+ 9C2F F6 04            OR 4
  96+ 9C31 32 E8 90         LD (CurrentPaging), A
  97+ 9C34 01 FD 7F         LD BC, $7FFD
  98+ 9C37 ED 79            OUT (C), A
  99+ 9C39 CD 9F E4         CALL AY_PlayBellChimeImpl
