 375+ ED82 DD 7E 0B         LD A, (IX+11)
 375+ ED85 CD 55 E5       CALL ApplyDayCycleRemap
 375+ ED88 77             LD (HL), A
 376+ ED89 C9               RET
 377+ ED8A
 378+ ED8A              ; ==============================================================================
 379+ ED8A              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ ED8A              ; ==============================================================================
 381+ ED8A              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ ED8A              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ ED8A              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ ED8A              ; ==============================================================================
 385+ ED8A              DrawHealthStaminaHUD:
 386+ ED8A                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ ED8A 3A 89 B3         LD A, (PlayerHealth)
 388+ ED8D 4F               LD C, A                             ; C = nivel (0-16)
 389+ ED8E 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ ED91 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ ED94 DD 21 70 E9      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ ED98 FD 21 E1 E9      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ ED9C CD 02 EE         CALL .drawBar
 394+ ED9F
 395+ ED9F                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ ED9F 3A 8A B3         LD A, (PlayerStamina)
 397+ EDA2 4F               LD C, A
 398+ EDA3 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EDA6 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EDA9 DD 21 74 E9      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EDAD FD 21 E5 E9      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EDB1 CD 02 EE         CALL .drawBar
 403+ EDB4
 404+ EDB4                  ; --- Flash de recuperacion del pozo ---
 405+ EDB4 3A 62 8D         LD A, (WellFlashTimer)
 406+ EDB7 B7               OR A
 407+ EDB8 28 23            JR Z, .noFlash
 408+ EDBA 3D               DEC A
 409+ EDBB 32 62 8D         LD (WellFlashTimer), A
 410+ EDBE                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EDBE E6 04            AND $04
 412+ EDC0 28 1B            JR Z, .noFlash
 413+ EDC2                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ EDC2                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ EDC2 3E 47            LD A, WHITE | $40
 416+ EDC4 32 0D 58         LD ($580D), A
 417+ EDC7 32 0E 58         LD ($580E), A
 418+ EDCA 32 2D 58         LD ($582D), A
 419+ EDCD 32 2E 58         LD ($582E), A
 420+ EDD0 32 11 58         LD ($5811), A
 421+ EDD3 32 12 58         LD ($5812), A
 422+ EDD6 32 31 58         LD ($5831), A
 423+ EDD9 32 32 58         LD ($5832), A
 424+ EDDC C9               RET
 425+ EDDD              .noFlash:
 426+ EDDD                  ; --- Attrs segun nivel (normal) ---
 427+ EDDD                  ; Salud
 428+ EDDD 3A 89 B3         LD A, (PlayerHealth)
 429+ EDE0 CD 50 EE         CALL .levelToColor
 430+ EDE3 32 0D 58         LD ($580D), A
 431+ EDE6 32 0E 58         LD ($580E), A
 432+ EDE9 32 2D 58         LD ($582D), A
 433+ EDEC 32 2E 58         LD ($582E), A
 434+ EDEF                  ; Stamina
 435+ EDEF 3A 8A B3         LD A, (PlayerStamina)
 436+ EDF2 CD 50 EE         CALL .levelToColor
 437+ EDF5 32 11 58         LD ($5811), A
 438+ EDF8 32 12 58         LD ($5812), A
 439+ EDFB 32 31 58         LD ($5831), A
 440+ EDFE 32 32 58         LD ($5832), A
 441+ EE01 C9               RET
 442+ EE02
 443+ EE02              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EE02              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EE02              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EE02              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EE02              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EE02              .drawBar:
 449+ EE02 7D               LD A, L
 450+ EE03 32 4E EE         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EE06 7B               LD A, E
 452+ EE07 32 4F EE         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EE0A 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EE0C 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EE0E                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EE0E 3E 10            LD A, 16
 457+ EE10 91               SUB C
 458+ EE11 5F               LD E, A                             ; E = primera scanline llena
 459+ EE12              .dbLoop:
 460+ EE12                  ; Calcular direccion VRAM
 461+ EE12 7A               LD A, D
 462+ EE13 FE 08            CP 8
 463+ EE15 30 09            JR NC, .dbCalcR1
 464+ EE17                  ; Char row 0
 465+ EE17 67               LD H, A
 466+ EE18 CB F4            SET 6, H
 467+ EE1A 3A 4E EE         LD A, (.dbCol)
 468+ EE1D 6F               LD L, A
 469+ EE1E 18 09            JR .dbWrite
 470+ EE20              .dbCalcR1:
 471+ EE20                  ; Char row 1
 472+ EE20 D6 08            SUB 8
 473+ EE22 67               LD H, A
 474+ EE23 CB F4            SET 6, H
 475+ EE25 3A 4F EE         LD A, (.dbCol1)
 476+ EE28 6F               LD L, A
 477+ EE29              .dbWrite:
 478+ EE29                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EE29 7A               LD A, D
 480+ EE2A BB               CP E
 481+ EE2B 30 0B            JR NC, .dbFull
 482+ EE2D                  ; Marchito: copiar sprite decayed
 483+ EE2D FD 7E 00         LD A, (IY+0)
 484+ EE30 77               LD (HL), A
 485+ EE31 23               INC HL
 486+ EE32 FD 7E 01         LD A, (IY+1)
 487+ EE35 77               LD (HL), A
 488+ EE36 18 09            JR .dbAdvanceSpr
 489+ EE38              .dbFull:
 490+ EE38                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EE38 DD 7E 00         LD A, (IX+0)
 492+ EE3B 77               LD (HL), A
 493+ EE3C 23               INC HL
 494+ EE3D DD 7E 01         LD A, (IX+1)
 495+ EE40 77               LD (HL), A
 496+ EE41              .dbAdvanceSpr:
 497+ EE41                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EE41 D5               PUSH DE
 499+ EE42 11 06 00         LD DE, 6
 500+ EE45 DD 19            ADD IX, DE
 501+ EE47 FD 19            ADD IY, DE
 502+ EE49 D1               POP DE
 503+ EE4A 14               INC D
 504+ EE4B 10 C5            DJNZ .dbLoop
 505+ EE4D C9               RET
 506+ EE4E
 507+ EE4E 00           .dbCol:  DEFB 0
 508+ EE4F 00           .dbCol1: DEFB 0
 509+ EE50
 510+ EE50              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EE50              .levelToColor:
 512+ EE50 FE 0C            CP 12
 513+ EE52 30 11            JR NC, .lcGreen
 514+ EE54 FE 07            CP 7
 515+ EE56 30 0A            JR NC, .lcCyan
 516+ EE58 FE 03            CP 3
 517+ EE5A 30 03            JR NC, .lcYellow
 518+ EE5C 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EE5E C9               RET
 520+ EE5F              .lcYellow:
 521+ EE5F 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EE61 C9               RET
 523+ EE62              .lcCyan:
 524+ EE62 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EE64 C9               RET
 526+ EE65              .lcGreen:
 527+ EE65 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EE67 C9               RET
 529+ EE68
 530+ EE68              ; ==============================================================================
 531+ EE68              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EE68              ; ==============================================================================
 533+ EE68              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EE68              ; ==============================================================================
 535+ EE68              DrawHandLine:
 536+ EE68 87               ADD A, A
 537+ EE69 4F               LD C, A
 538+ EE6A 06 00            LD B, 0
 539+ EE6C 09               ADD HL, BC
 540+ EE6D 7E               LD A, (HL)
 541+ EE6E 23               INC HL
 542+ EE6F 66               LD H, (HL)
 543+ EE70 6F               LD L, A             ; HL = puntero a datos de línea
 544+ EE71
 545+ EE71              .pixLoop:
 546+ EE71 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EE72 B7               OR A
 548+ EE73 C8               RET Z
 549+ EE74 57               LD D, A
 550+ EE75 23               INC HL
 551+ EE76 7E               LD A, (HL)          ; VRAM L
 552+ EE77 23               INC HL
 553+ EE78 5F               LD E, A
 554+ EE79 7E               LD A, (HL)          ; mask
 555+ EE7A 23               INC HL
 556+ EE7B E5               PUSH HL
 557+ EE7C 2F               CPL                 ; ~mask
 558+ EE7D 62               LD H, D
 559+ EE7E 6B               LD L, E
 560+ EE7F A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EE80 77               LD (HL), A
 562+ EE81 E1               POP HL
 563+ EE82 18 ED            JR .pixLoop
 564+ EE84
 565+ EE84              ; ==============================================================================
 566+ EE84              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ EE84              ; ==============================================================================
 568+ EE84              CheckClockSpeedKeys:
 569+ EE84 3E F7            LD A, $F7
 570+ EE86 DB FE            IN A, ($FE)
 571+ EE88 2F               CPL
 572+ EE89 E6 07            AND $07
 573+ EE8B
 574+ EE8B 47               LD B, A
 575+ EE8C 3A 54 EA         LD A, (ClockDebounce)
 576+ EE8F 4F               LD C, A
 577+ EE90 78               LD A, B
 578+ EE91 32 54 EA         LD (ClockDebounce), A
 579+ EE94 78               LD A, B
 580+ EE95
 581+ EE95 79               LD A, C
 582+ EE96 2F               CPL
 583+ EE97 A0               AND B
 584+ EE98 C8               RET Z
 585+ EE99
 586+ EE99 CB 47            BIT 0, A
 587+ EE9B 28 06            JR Z, .try2
 588+ EE9D 3E 01            LD A, 1
 589+ EE9F 32 53 EA         LD (SubMinuteMax), A
 590+ EEA2 C9               RET
 591+ EEA3              .try2:
 592+ EEA3 CB 4F            BIT 1, A
 593+ EEA5 28 06            JR Z, .try3
 594+ EEA7 3E 05            LD A, 5
 595+ EEA9 32 53 EA         LD (SubMinuteMax), A
 596+ EEAC C9               RET
 597+ EEAD              .try3:
 598+ EEAD 3E 15            LD A, 21
 599+ EEAF 32 53 EA         LD (SubMinuteMax), A
 600+ EEB2 C9               RET
 601+ EEB3
 602+ EEB3              ; ==============================================================================
 603+ EEB3              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ EEB3              ; ==============================================================================
 605+ EEB3
 606+ EEB3              ; ==============================================================================
 607+ EEB3              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ EEB3              ; ==============================================================================
 609+ EEB3              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ EEB3              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ EEB3              ; ==============================================================================
 612+ EEB3              BuildPlazaScanAddrs:
 613+ EEB3                  ; Calcular pixel coords del top-left de la esfera
 614+ EEB3 3A 69 8D         LD A, (PlazaClockCharY)
 615+ EEB6 07               RLCA
 616+ EEB7 07               RLCA
 617+ EEB8 07               RLCA
 618+ EEB9 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EEBA 3A 68 8D         LD A, (PlazaClockCharX)
 620+ EEBD 07               RLCA
 621+ EEBE 07               RLCA
 622+ EEBF 07               RLCA
 623+ EEC0 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EEC1 CD 62 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EEC4
 626+ EEC4 DD 21 6A 8D      LD IX, PlazaScanAddrs
 627+ EEC8 06 10            LD B, 16
 628+ EECA              .buildLoop:
 629+ EECA DD 75 00         LD (IX+0), L
 630+ EECD DD 74 01         LD (IX+1), H
 631+ EED0 DD 23            INC IX
 632+ EED2 DD 23            INC IX
 633+ EED4 05               DEC B
 634+ EED5 C8               RET Z
 635+ EED6 CD CE 9A         CALL NextPixelLine
 636+ EED9 18 EF            JR .buildLoop
 637+ EEDB
 638+ EEDB              ; ==============================================================================
 639+ EEDB              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EEDB              ; ==============================================================================
 641+ EEDB              ; Llamar cada frame desde el main loop.
 642+ EEDB              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EEDB              ; ==============================================================================
 644+ EEDB              DrawPlazaClock:
 645+ EEDB 3A 67 8D         LD A, (PlazaClockActive)
 646+ EEDE B7               OR A
 647+ EEDF C8               RET Z
 648+ EEE0
 649+ EEE0                  ; --- Calcular posicion actual de las agujas ---
 650+ EEE0 3A 52 EA         LD A, (GameHours)
 651+ EEE3 FE 0C            CP 12
 652+ EEE5 38 02            JR C, .pCalcHourOk
 653+ EEE7 D6 0C            SUB 12
 654+ EEE9              .pCalcHourOk:
 655+ EEE9 57               LD D, A                     ; D = display hour (0-11)
 656+ EEEA 3A 51 EA         LD A, (GameMinutes)
 657+ EEED 1E 00            LD E, 0
 658+ EEEF              .pCalcDiv5:
 659+ EEEF FE 05            CP 5
 660+ EEF1 38 05            JR C, .pCalcMinOk
 661+ EEF3 D6 05            SUB 5
 662+ EEF5 1C               INC E
 663+ EEF6 18 F7            JR .pCalcDiv5
 664+ EEF8              .pCalcMinOk:
 665+ EEF8                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EEF8
 667+ EEF8                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EEF8 3A 4C EF         LD A, (PlazaLastHour)
 669+ EEFB BA               CP D
 670+ EEFC 20 05            JR NZ, .pNeedsRedraw
 671+ EEFE 3A 4D EF         LD A, (PlazaLastMin)
 672+ EF01 BB               CP E
 673+ EF02 C8               RET Z                       ; sin cambio → no redibujar
 674+ EF03
 675+ EF03              .pNeedsRedraw:
 676+ EF03 7A               LD A, D
 677+ EF04 32 4C EF         LD (PlazaLastHour), A
 678+ EF07 7B               LD A, E
 679+ EF08 32 4D EF         LD (PlazaLastMin), A
 680+ EF0B
 681+ EF0B                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EF0B                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EF0B DD 21 3D 8A      LD IX, PlazaClockPixels
 684+ EF0F FD 21 6A 8D      LD IY, PlazaScanAddrs
 685+ EF13 06 10            LD B, 16
 686+ EF15              .faceRow:
 687+ EF15 FD 6E 00         LD L, (IY+0)
 688+ EF18 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EF1B DD 7E 00         LD A, (IX+0)
 690+ EF1E 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EF1F 77               LD (HL), A                  ; byte izquierdo
 692+ EF20 23               INC HL
 693+ EF21 DD 7E 01         LD A, (IX+1)
 694+ EF24 2F               CPL
 695+ EF25 77               LD (HL), A                  ; byte derecho
 696+ EF26 DD 23            INC IX
 697+ EF28 DD 23            INC IX
 698+ EF2A FD 23            INC IY
 699+ EF2C FD 23            INC IY
 700+ EF2E 10 E5            DJNZ .faceRow
 701+ EF30
 702+ EF30                  ; --- Aguja de horas ---
 703+ EF30 3A 4C EF         LD A, (PlazaLastHour)
 704+ EF33 21 4E EB         LD HL, HourHandPtrs
 705+ EF36 CD 4E EF         CALL DrawPlazaHandLine
 706+ EF39
 707+ EF39                  ; --- Aguja de minutos ---
 708+ EF39 3A 4D EF         LD A, (PlazaLastMin)
 709+ EF3C 21 6A EA         LD HL, MinHandPtrs
 710+ EF3F CD 4E EF         CALL DrawPlazaHandLine
 711+ EF42
 712+ EF42                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EF42 21 78 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EF45 7E               LD A, (HL)
 715+ EF46 23               INC HL
 716+ EF47 66               LD H, (HL)
 717+ EF48 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EF49 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EF4B C9               RET
 720+ EF4C
 721+ EF4C              ; Variables locales reloj plaza
 722+ EF4C FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EF4D FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EF4E
 725+ EF4E              ; ==============================================================================
 726+ EF4E              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EF4E              ; ==============================================================================
 728+ EF4E              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EF4E              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EF4E              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EF4E              ; ==============================================================================
 732+ EF4E              DrawPlazaHandLine:
 733+ EF4E                  ; Indexar en tabla de punteros
 734+ EF4E 87               ADD A, A
 735+ EF4F 4F               LD C, A
 736+ EF50 06 00            LD B, 0
 737+ EF52 09               ADD HL, BC
 738+ EF53 7E               LD A, (HL)
 739+ EF54 23               INC HL
 740+ EF55 66               LD H, (HL)
 741+ EF56 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EF57
 743+ EF57              .pxLoop:
 744+ EF57 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EF58 B7               OR A
 746+ EF59 C8               RET Z
 747+ EF5A
 748+ EF5A                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EF5A 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EF5B 23               INC HL
 751+ EF5C 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EF5D 23               INC HL
 753+ EF5E 56               LD D, (HL)                  ; D = mask
 754+ EF5F 23               INC HL
 755+ EF60 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EF61
 757+ EF61                  ; --- Calcular scanLine (0-15) ---
 758+ EF61 78               LD A, B
 759+ EF62 E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EF64 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EF66 28 02            JR Z, .pxIsTop
 762+ EF68 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EF6A              .pxIsTop:
 764+ EF6A                  ; A = scanLine (0-15)
 765+ EF6A
 766+ EF6A                  ; --- Calcular colOffset (0 o 1) ---
 767+ EF6A 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EF6B 79               LD A, C
 769+ EF6C E6 1F            AND $1F                     ; extraer columna
 770+ EF6E D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EF70 4F               LD C, A                     ; C = colOffset
 772+ EF71
 773+ EF71                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EF71 7B               LD A, E                     ; A = scanLine
 775+ EF72 87               ADD A, A                    ; *2 (word index)
 776+ EF73 21 6A 8D         LD HL, PlazaScanAddrs
 777+ EF76 85               ADD A, L
 778+ EF77 6F               LD L, A
 779+ EF78 30 01            JR NC, .pxNC
 780+ EF7A 24               INC H
 781+ EF7B              .pxNC:
 782+ EF7B 7E               LD A, (HL)
 783+ EF7C 23               INC HL
 784+ EF7D 66               LD H, (HL)
 785+ EF7E 81               ADD A, C                    ; sumar colOffset
 786+ EF7F 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EF80
 788+ EF80                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EF80 7A               LD A, D
 790+ EF81 2F               CPL
 791+ EF82 A6               AND (HL)
 792+ EF83 77               LD (HL), A
 793+ EF84
 794+ EF84 E1               POP HL                      ; restaurar puntero datos
 795+ EF85 18 D0            JR .pxLoop
 796+ EF87
# file closed: hud_clock.asm
 507  EF87                  INCLUDE "milestones.asm"
