 262+ 9F31 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F32 CD 8F D5         CALL IsPointBlocked
 264+ 9F35 C8               RET Z                       ; libre → sin offset
 265+ 9F36 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F39 3C               INC A
 267+ 9F3A 32 E0 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F3D C9               RET
