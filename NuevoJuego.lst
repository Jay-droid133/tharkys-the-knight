2179+ AABC              .cwDoCheck:
2180+ AABC                  ; AABB con margen de 8px (1 celda) por cada lado:
2181+ AABC                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2182+ AABC                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2183+ AABC                  ; --- Check X ---
2184+ AABC 3A 58 8D         LD A, (WellPosX)
2185+ AABF C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2186+ AAC1 4F               LD C, A
2187+ AAC2 3A 9E 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2188+ AAC5 B9               CP C                                ; playerX < wellRight+margen?
2189+ AAC6 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2190+ AAC8 3A 9E 81         LD A, (EntityTable + ENT_POSX)
2191+ AACB C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2192+ AACD 4F               LD C, A
2193+ AACE 3A 58 8D         LD A, (WellPosX)                    ; A = wellX
2194+ AAD1 B9               CP C                                ; wellX < playerRight+margen?
2195+ AAD2 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2196+ AAD4                  ; --- Check Y ---
2197+ AAD4 3A 59 8D         LD A, (WellPosY)
2198+ AAD7 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2199+ AAD9 4F               LD C, A
2200+ AADA 3A 9F 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2201+ AADD B9               CP C                                ; playerY < wellBottom+margen?
2202+ AADE 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2203+ AAE0 3A 9F 81         LD A, (EntityTable + ENT_POSY)
2204+ AAE3 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2205+ AAE5 4F               LD C, A
2206+ AAE6 3A 59 8D         LD A, (WellPosY)                    ; A = wellY
2207+ AAE9 B9               CP C                                ; wellY < playerBottom+margen?
2208+ AAEA 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2209+ AAEC                  ; --- Overlap! Recuperar salud y stamina ---
2210+ AAEC 3E 10            LD A, HEALTH_MAX
2211+ AAEE 32 0C B3         LD (PlayerHealth), A
2212+ AAF1 3E 10            LD A, STAMINA_MAX
