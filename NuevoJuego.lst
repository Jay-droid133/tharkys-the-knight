7736+ CA7D DD 77 04         LD (IX+ENT_POSY), A
7737+ CA80 DD 77 0D         LD (IX+ENT_OLDY), A
7738+ CA83 3E 10            LD A, HEALTH_MAX
7739+ CA85 32 55 B3         LD (PlayerHealth), A
7740+ CA88 3E 10            LD A, STAMINA_MAX
7741+ CA8A 32 56 B3         LD (PlayerStamina), A
7742+ CA8D DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7743+ CA91 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7744+ CA95 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7745+ CA99 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7746+ CA9D DD 36 06 00      LD (IX+ENT_DELTAX), 0
7747+ CAA1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7748+ CAA5                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7749+ CAA5                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7750+ CAA5                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7751+ CAA5                  ; libre, y .swordModeFree no toca el color.
7752+ CAA5 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7753+ CAA9 AF               XOR A
7754+ CAAA 32 51 B3         LD (AttackCooldown), A
7755+ CAAD 32 50 B3         LD (AttackTimer), A
7756+ CAB0 DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7757+ CAB4                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7758+ CAB4                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7759+ CAB4 3E 01            LD A, 1
7760+ CAB6 32 EE 82         LD (PlayerRespawnPhase), A
7761+ CAB9 AF               XOR A
7762+ CABA 32 EF 82         LD (PlayerRespawnTimer), A
7763+ CABD 32 F2 82         LD (PlayerRespawnBeatIdx), A
7764+ CAC0 C9               RET
7765+ CAC1
7766+ CAC1              ; ==============================================================================
7767+ CAC1              ; TriggerDeathBorder - arranca el flash del borde tras morir
7768+ CAC1              ; ==============================================================================
7769+ CAC1              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7770+ CAC1              ; luego vuelve a negro y se desactiva.
7771+ CAC1              ; ==============================================================================
7772+ CAC1              TriggerDeathBorder:
7773+ CAC1 3E 01            LD A, 1
7774+ CAC3 32 EA 82         LD (DeathBorderPhase), A
7775+ CAC6 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7776+ CAC8 32 EB 82         LD (DeathBorderTimer), A
7777+ CACB 3E 06            LD A, YELLOW
7778+ CACD 32 86 8D         LD (CurrentBorderColor), A
7779+ CAD0 D3 FE            OUT (254), A
7780+ CAD2 C9               RET
7781+ CAD3
7782+ CAD3              ; ==============================================================================
7783+ CAD3              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7784+ CAD3              ; ==============================================================================
7785+ CAD3              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7786+ CAD3              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7787+ CAD3              ; ==============================================================================
7788+ CAD3              UpdateRespawnBlink:
7789+ CAD3 3A EE 82         LD A, (PlayerRespawnPhase)
7790+ CAD6 B7               OR A
7791+ CAD7 C8               RET Z
7792+ CAD8 3D               DEC A
7793+ CAD9 28 0D            JR Z, .urbPhase1
7794+ CADB                  ; Phase 2: solo timer (sin parpadeo)
7795+ CADB 3A EF 82         LD A, (PlayerRespawnTimer)
7796+ CADE 3D               DEC A
7797+ CADF 32 EF 82         LD (PlayerRespawnTimer), A
7798+ CAE2 C0               RET NZ
7799+ CAE3 AF               XOR A
7800+ CAE4 32 EE 82         LD (PlayerRespawnPhase), A
7801+ CAE7 C9               RET
7802+ CAE8
7803+ CAE8              .urbPhase1:
7804+ CAE8                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7805+ CAE8                  ; Zero input (sin control)
7806+ CAE8 AF               XOR A
7807+ CAE9 32 AE 82         LD (InputDirection), A
7808+ CAEC 32 AF 82         LD (InputFire), A
7809+ CAEF                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7810+ CAEF                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7811+ CAEF 3A 9C 6F         LD A, (BeepDurationFrames)
7812+ CAF2 D6 01            SUB 1                               ; CY si era 0 (silencio)
7813+ CAF4 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7814+ CAF5 E6 74            AND SPRID_PLAYER_BLANK
7815+ CAF7 32 9E 81         LD (EntityTable), A
7816+ CAFA                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7817+ CAFA 3A EF 82         LD A, (PlayerRespawnTimer)
7818+ CAFD B7               OR A
7819+ CAFE 28 05            JR Z, .urb1FireBeat
7820+ CB00 3D               DEC A
7821+ CB01 32 EF 82         LD (PlayerRespawnTimer), A
7822+ CB04 C9               RET
7823+ CB05              .urb1FireBeat:
7824+ CB05 3A F2 82         LD A, (PlayerRespawnBeatIdx)
7825+ CB08 3C               INC A
7826+ CB09 32 F2 82         LD (PlayerRespawnBeatIdx), A
7827+ CB0C FE 04            CP 4
7828+ CB0E 28 12            JR Z, .urb1LastBeat
7829+ CB10 FE 05            CP 5
7830+ CB12 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7831+ CB14                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7832+ CB14 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7833+ CB17 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7834+ CB19 CD CA 6F         CALL AY_PlayBeep
7835+ CB1C                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7836+ CB1C                  ; (mitad) para mantener ON/OFF ~50/50.
7837+ CB1C 3E 14            LD A, 20
7838+ CB1E 32 EF 82         LD (PlayerRespawnTimer), A
7839+ CB21 C9               RET
7840+ CB22              .urb1LastBeat:
7841+ CB22                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7842+ CB22                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7843+ CB22                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7844+ CB22                  ; entra grace EXACTAMENTE al terminar el beep.
7845+ CB22 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7846+ CB25 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7847+ CB27 CD CA 6F         CALL AY_PlayBeep
7848+ CB2A 3E 0B            LD A, 11                    ; espera = duracion del beep
7849+ CB2C 32 EF 82         LD (PlayerRespawnTimer), A
7850+ CB2F C9               RET
7851+ CB30              .urb1AfterBeep:
7852+ CB30                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7853+ CB30                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7854+ CB30 CD 58 CB         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7855+ CB33 3E 0C            LD A, SPAWN_INTERVAL
7856+ CB35 32 F8 82         LD (SpawnTimer), A
7857+ CB38 AF               XOR A
7858+ CB39 32 FD 82         LD (DeathSpawned), A
7859+ CB3C 32 F3 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7860+ CB3F 32 B6 82         LD (TimeFrozen), A              ; Reanudar reloj
7861+ CB42 21 00 00         LD HL, 0
7862+ CB45 22 FA 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7863+ CB48                  ; Si los monsters siguen activos (no era game over), reanudar el
7864+ CB48                  ; secuencer "po-po-popo-po" — fue parado en OnPlayerHealthDepleted.
7865+ CB48 3A 5B B3         LD A, (MonstersActive)
7866+ CB4B B7               OR A
7867+ CB4C C8               RET Z
7868+ CB4D                  ; No re-arrancar si los 3 monsters estan atrapados en la iglesia
7869+ CB4D                  ; (StopMonstersMusic se llamo en TriggerChurchTrap del 3o; ya no hay
7870+ CB4D                  ; monsters jugables en pantalla aunque MonstersActive siga 1).
7871+ CB4D 3A C1 82         LD A, (MonsterTrappedFlags)
7872+ CB50 E6 07            AND $07
7873+ CB52 FE 07            CP $07
7874+ CB54 C8               RET Z
7875+ CB55 C3 7F FA         JP StartMonstersMusic           ; tail-call
7876+ CB58
7877+ CB58              ; ==============================================================================
7878+ CB58              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7879+ CB58              ; ==============================================================================
7880+ CB58              ; Llamado desde:
7881+ CB58              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7882+ CB58              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7883+ CB58              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7884+ CB58              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7885+ CB58              ; ==============================================================================
7886+ CB58              EnterGracePhase:
7887+ CB58 3E 02            LD A, 2
7888+ CB5A 32 EE 82         LD (PlayerRespawnPhase), A
7889+ CB5D 3E 19            LD A, RESPAWN_GRACE_FRAMES
7890+ CB5F 32 EF 82         LD (PlayerRespawnTimer), A
7891+ CB62 C9               RET
7892+ CB63
7893+ CB63              ; ==============================================================================
7894+ CB63              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7895+ CB63              ; ==============================================================================
7896+ CB63              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7897+ CB63              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7898+ CB63              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7899+ CB63              ; ==============================================================================
7900+ CB63              UpdateDeathAnim:
7901+ CB63 3A EA 82         LD A, (DeathBorderPhase)
7902+ CB66 FE 01            CP 1
7903+ CB68 C0               RET NZ
7904+ CB69 3A EC 82         LD A, (PlayerDeathAnimTimer)
7905+ CB6C 3D               DEC A
7906+ CB6D 32 EC 82         LD (PlayerDeathAnimTimer), A
7907+ CB70 C0               RET NZ
7908+ CB71                  ; Tick consumido: avanzar frame
7909+ CB71 3A ED 82         LD A, (PlayerDeathAnimFrame)
7910+ CB74 3C               INC A
7911+ CB75 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7912+ CB77 D0               RET NC                              ; ya en ultimo frame (clamp)
7913+ CB78 32 ED 82         LD (PlayerDeathAnimFrame), A
7914+ CB7B DD 21 9E 81      LD IX, EntityTable
7915+ CB7F DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7916+ CB82                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7917+ CB82                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7918+ CB82                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7919+ CB82 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7920+ CB84 20 06            JR NZ, .udaSkipSplatSfx
7921+ CB86 21 0C F9         LD HL, SFX_EnemyDeath
7922+ CB89 CD 8D F8         CALL PlaySFX
7923+ CB8C              .udaSkipSplatSfx:
7924+ CB8C 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7925+ CB8E 32 EC 82         LD (PlayerDeathAnimTimer), A
7926+ CB91 C9               RET
7927+ CB92
7928+ CB92              ; ==============================================================================
7929+ CB92              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7930+ CB92              ; ==============================================================================
7931+ CB92              UpdateDeathBorder:
7932+ CB92 3A EA 82         LD A, (DeathBorderPhase)
7933+ CB95 B7               OR A
7934+ CB96 C8               RET Z
7935+ CB97 3A EB 82         LD A, (DeathBorderTimer)
7936+ CB9A 3D               DEC A
7937+ CB9B 32 EB 82         LD (DeathBorderTimer), A
7938+ CB9E C0               RET NZ
7939+ CB9F                  ; Timer expiro: avanzar fase
7940+ CB9F 3A EA 82         LD A, (DeathBorderPhase)
7941+ CBA2 FE 01            CP 1
7942+ CBA4 20 33            JR NZ, .udbToBlack
7943+ CBA6                  ; --- Fin fase amarillo ---
7944+ CBA6                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7945+ CBA6                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7946+ CBA6 3A E1 82         LD A, (PlayerLives)
7947+ CBA9 B7               OR A
7948+ CBAA 28 1F            JR Z, .udbToGameOver
7949+ CBAC DD 21 9E 81      LD IX, EntityTable
7950+ CBB0 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7951+ CBB4 3E 02            LD A, 2
7952+ CBB6 32 EA 82         LD (DeathBorderPhase), A
7953+ CBB9 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7954+ CBBB 32 EB 82         LD (DeathBorderTimer), A
7955+ CBBE 3E 02            LD A, RED
7956+ CBC0 32 86 8D         LD (CurrentBorderColor), A
7957+ CBC3 D3 FE            OUT (254), A
7958+ CBC5                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7959+ CBC5                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7960+ CBC5 3E 01            LD A, 1
7961+ CBC7 32 F7 82         LD (TombDrawPending), A
7962+ CBCA C9               RET
7963+ CBCB              .udbToGameOver:
7964+ CBCB                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7965+ CBCB AF               XOR A
7966+ CBCC 32 EA 82         LD (DeathBorderPhase), A
7967+ CBCF 3E 00            LD A, BLACK
7968+ CBD1 32 86 8D         LD (CurrentBorderColor), A
7969+ CBD4 D3 FE            OUT (254), A
7970+ CBD6 C3 E7 CB         JP ShowGameOver
7971+ CBD9              .udbToBlack:
7972+ CBD9                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7973+ CBD9 AF               XOR A
7974+ CBDA 32 EA 82         LD (DeathBorderPhase), A
7975+ CBDD 3E 00            LD A, BLACK
7976+ CBDF 32 86 8D         LD (CurrentBorderColor), A
7977+ CBE2 D3 FE            OUT (254), A
7978+ CBE4 C3 6A CA         JP RespawnPlayerAtEntry             ; tail-call
7979+ CBE7
7980+ CBE7              ; ==============================================================================
7981+ CBE7              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7982+ CBE7              ; ==============================================================================
7983+ CBE7              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7984+ CBE7              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7985+ CBE7              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7986+ CBE7              ; ==============================================================================
7987+ CBE7              ShowGameOver:
7988+ CBE7 3E 01            LD A, 1
7989+ CBE9 32 E2 82         LD (GameOver), A
7990+ CBEC C9               RET
7991+ CBED
7992+ CBED              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7993+ CBED              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7994+ CBED              PaintGameOverScreen:
7995+ CBED                  ; Wipe pixels
7996+ CBED 21 00 40         LD HL, $4000
7997+ CBF0 11 01 40         LD DE, $4001
7998+ CBF3 01 FF 17         LD BC, $17FF
7999+ CBF6 36 00            LD (HL), 0
8000+ CBF8 ED B0            LDIR
8001+ CBFA                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
8002+ CBFA 21 00 58         LD HL, $5800
8003+ CBFD 11 01 58         LD DE, $5801
8004+ CC00 01 FF 02         LD BC, $02FF
8005+ CC03 36 47            LD (HL), $47
8006+ CC05 ED B0            LDIR
8007+ CC07                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
8008+ CC07                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
8009+ CC07 CD 73 75         CALL DrawTombstone2xCentered
8010+ CC0A                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
8011+ CC0A 3E 88            LD A, GAMEOVER_ANIM_X_MAX
8012+ CC0C 32 E3 82         LD (GameOverAnimX), A
8013+ CC0F AF               XOR A
8014+ CC10 32 E4 82         LD (GameOverAnimDir), A
8015+ CC13 32 E5 82         LD (GameOverAnimFrame), A
8016+ CC16 32 E9 82         LD (GameOverAnimLastX), A
8017+ CC19 21 00 00         LD HL, 0
8018+ CC1C 22 E7 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
8019+ CC1F 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8020+ CC21 32 E6 82         LD (GameOverAnimFrameTimer), A
8021+ CC24                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
8022+ CC24                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
8023+ CC24                  ; congelado en GameOver=2.
8024+ CC24 3E 03            LD A, 3
8025+ CC26 C3 BD 99         JP StartMusic                   ; tail-call
8026+ CC29
8027+ CC29              ; ==============================================================================
8028+ CC29              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
8029+ CC29              ; ==============================================================================
8030+ CC29              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
8031+ CC29              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
8032+ CC29              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
8033+ CC29              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
8034+ CC29              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
8035+ CC29              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
8036+ CC29              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
8037+ CC29              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
8038+ CC29              ;
8039+ CC29              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
8040+ CC29              ; shifted (que ocupa 4 chars = 32 px).
8041+ CC29              ; ==============================================================================
8042+ CC29              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
8043+ CC29              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8044+ CC29              ; X swing centrado sobre la tumba:
8045+ CC29              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8046+ CC29              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8047+ CC29              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8048+ CC29              GAMEOVER_ANIM_Y           EQU 56
8049+ CC29              GAMEOVER_ANIM_X_MIN       EQU 96
8050+ CC29              GAMEOVER_ANIM_X_MAX       EQU 136
8051+ CC29              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8052+ CC29
8053+ CC29              UpdateGameOverAnim:
8054+ CC29                  ; --- Erase del sprite previo (si lo hubo) ---
8055+ CC29 2A E7 82         LD HL, (GameOverAnimLastSpr)
8056+ CC2C 7C               LD A, H
8057+ CC2D B5               OR L
8058+ CC2E 28 0C            JR Z, .ugoaNoErase
8059+ CC30 E5               PUSH HL
8060+ CC31 DD E1            POP IX
8061+ CC33 3A E9 82         LD A, (GameOverAnimLastX)
8062+ CC36 5F               LD E, A
8063+ CC37 16 38            LD D, GAMEOVER_ANIM_Y
8064+ CC39 CD EA 99         CALL DrawSprite
8065+ CC3C              .ugoaNoErase:
8066+ CC3C
8067+ CC3C                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8068+ CC3C 3A E6 82         LD A, (GameOverAnimFrameTimer)
8069+ CC3F 3D               DEC A
8070+ CC40 20 0A            JR NZ, .ugoaTimerSet
8071+ CC42 3A E5 82         LD A, (GameOverAnimFrame)
8072+ CC45 EE 01            XOR 1
8073+ CC47 32 E5 82         LD (GameOverAnimFrame), A
8074+ CC4A 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8075+ CC4C              .ugoaTimerSet:
8076+ CC4C 32 E6 82         LD (GameOverAnimFrameTimer), A
8077+ CC4F
8078+ CC4F                  ; --- Avanzar X segun direccion (ping-pong) ---
8079+ CC4F 3A E4 82         LD A, (GameOverAnimDir)
8080+ CC52 B7               OR A
8081+ CC53 20 14            JR NZ, .ugoaSlideRight
8082+ CC55                  ; Dir 0: facing R, slide LEFT (X--)
8083+ CC55 3A E3 82         LD A, (GameOverAnimX)
8084+ CC58 FE 60            CP GAMEOVER_ANIM_X_MIN
8085+ CC5A 28 06            JR Z, .ugoaFlipToL
8086+ CC5C 3D               DEC A
8087+ CC5D 32 E3 82         LD (GameOverAnimX), A
8088+ CC60 18 18            JR .ugoaPickSprite
8089+ CC62              .ugoaFlipToL:
8090+ CC62 3E 01            LD A, 1
8091+ CC64 32 E4 82         LD (GameOverAnimDir), A
8092+ CC67 18 11            JR .ugoaPickSprite
8093+ CC69              .ugoaSlideRight:
8094+ CC69                  ; Dir 1: facing L, slide RIGHT (X++)
8095+ CC69 3A E3 82         LD A, (GameOverAnimX)
8096+ CC6C FE 88            CP GAMEOVER_ANIM_X_MAX
8097+ CC6E 28 06            JR Z, .ugoaFlipToR
8098+ CC70 3C               INC A
8099+ CC71 32 E3 82         LD (GameOverAnimX), A
8100+ CC74 18 04            JR .ugoaPickSprite
8101+ CC76              .ugoaFlipToR:
8102+ CC76 AF               XOR A
8103+ CC77 32 E4 82         LD (GameOverAnimDir), A
8104+ CC7A
8105+ CC7A              .ugoaPickSprite:
8106+ CC7A                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8107+ CC7A                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8108+ CC7A                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8109+ CC7A 3A E4 82         LD A, (GameOverAnimDir)
8110+ CC7D B7               OR A
8111+ CC7E 20 0E            JR NZ, .ugoaPickR
8112+ CC80 3A E5 82         LD A, (GameOverAnimFrame)
8113+ CC83 B7               OR A
8114+ CC84 21 DF DD         LD HL, SprDeath_L0
8115+ CC87 28 11            JR Z, .ugoaSprSet
8116+ CC89 21 29 DE         LD HL, SprDeath_L1
8117+ CC8C 18 0C            JR .ugoaSprSet
8118+ CC8E              .ugoaPickR:
8119+ CC8E 3A E5 82         LD A, (GameOverAnimFrame)
8120+ CC91 B7               OR A
8121+ CC92 21 4B DD         LD HL, SprDeath_0
8122+ CC95 28 03            JR Z, .ugoaSprSet
8123+ CC97 21 95 DD         LD HL, SprDeath_1
8124+ CC9A              .ugoaSprSet:
8125+ CC9A 22 E7 82         LD (GameOverAnimLastSpr), HL
8126+ CC9D 3A E3 82         LD A, (GameOverAnimX)
8127+ CCA0 32 E9 82         LD (GameOverAnimLastX), A
8128+ CCA3
8129+ CCA3                  ; --- Draw nuevo sprite ---
8130+ CCA3 E5               PUSH HL
8131+ CCA4 DD E1            POP IX
8132+ CCA6 5F               LD E, A
8133+ CCA7 16 38            LD D, GAMEOVER_ANIM_Y
8134+ CCA9 C3 EA 99         JP DrawSprite                   ; tail-call
8135+ CCAC
# file closed: logic_game.asm
 497  CCAC                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCAC              ; ==============================================================================
   2+ CCAC              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCAC              ; ==============================================================================
   4+ CCAC              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCAC              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCAC              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCAC              ; ==============================================================================
   8+ CCAC
   9+ CCAC              ; ==============================================================================
  10+ CCAC              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCAC              ; ==============================================================================
  12+ CCAC              InitScreenSystem:
  13+ CCAC 3E 08            LD A, START_SCREEN_X
  14+ CCAE 32 0B 83         LD (CurrentScreenX), A
  15+ CCB1 3E 09            LD A, START_SCREEN_Y
  16+ CCB3 32 0C 83         LD (CurrentScreenY), A
  17+ CCB6 3E 01            LD A, 1
  18+ CCB8 32 13 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCBB AF               XOR A
  20+ CCBC 32 0F 83         LD (ScreenTransition), A
  21+ CCBF CD C3 CC         CALL CalcScreenAddress
  22+ CCC2 C9               RET
  23+ CCC3
  24+ CCC3              ; ==============================================================================
  25+ CCC3              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CCC3              ; ==============================================================================
  27+ CCC3              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CCC3              ; ==============================================================================
  29+ CCC3              CalcScreenAddress:
  30+ CCC3 3A 0C 83         LD A, (CurrentScreenY)
  31+ CCC6 6F               LD L, A
  32+ CCC7 26 00            LD H, 0
  33+ CCC9 29               ADD HL, HL                  ; x2
  34+ CCCA 29               ADD HL, HL                  ; x4
  35+ CCCB 29               ADD HL, HL                  ; x8
  36+ CCCC 29               ADD HL, HL                  ; x16
  37+ CCCD 3A 0B 83         LD A, (CurrentScreenX)
  38+ CCD0 5F               LD E, A
  39+ CCD1 16 00            LD D, 0
  40+ CCD3 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CCD4 11 ED DD         LD DE, MapTable
  42+ CCD7 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CCD8 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CCD9                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CCD9 6F               LD L, A
  46+ CCDA 26 00            LD H, 0
  47+ CCDC 29               ADD HL, HL                  ; index * 2
  48+ CCDD 11 BB DC         LD DE, RoomTable
  49+ CCE0 19               ADD HL, DE
  50+ CCE1 5E               LD E, (HL)
  51+ CCE2 23               INC HL
  52+ CCE3 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CCE4                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CCE4 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CCE5 CD 72 6C         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CCE8                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CCE8 11 F8 85         LD DE, CurrentScreenBuffer
  58+ CCEB ED 53 0D 83      LD (CurrentScreenAddr), DE
  59+ CCEF C9               RET
  60+ CCF0
  61+ CCF0              ; ==============================================================================
  62+ CCF0              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CCF0              ; ==============================================================================
  64+ CCF0              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CCF0              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CCF0              ; por estar atrapado cerca del borde.
  67+ CCF0              ; ==============================================================================
  68+ CCF0              CheckScreenTransition:
  69+ CCF0 AF               XOR A
  70+ CCF1 32 0F 83         LD (ScreenTransition), A
  71+ CCF4
  72+ CCF4                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CCF4                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CCF4                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CCF4                  ; dispararia transicion sur en plena animacion.
  76+ CCF4 3A CB 82         LD A, (TownGatePhase)
  77+ CCF7 B7               OR A
  78+ CCF8 C0               RET NZ
  79+ CCF9
  80+ CCF9                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CCF9                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CCF9                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CCF9                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CCF9                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CCF9                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CCF9 3A B6 82         LD A, (TimeFrozen)
  87+ CCFC B7               OR A
  88+ CCFD 28 23            JR Z, .cstNotFrozen
  89+ CCFF 3A AE 82         LD A, (InputDirection)
  90+ CD02 CB 4F            BIT 1, A                    ; S
  91+ CD04 28 17            JR Z, .cstClearBlockFlag
  92+ CD06 3A A2 81         LD A, (EntityTable + ENT_POSY)
  93+ CD09 FE A8            CP SCREEN_MAX_Y
  94+ CD0B 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD0D                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD0D 3A B7 82         LD A, (BlockedExitSoundFlag)
  97+ CD10 B7               OR A
  98+ CD11 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD12 3E 01            LD A, 1
 100+ CD14 32 B7 82         LD (BlockedExitSoundFlag), A
 101+ CD17 21 BA F9         LD HL, SFX_BlockedExit
 102+ CD1A C3 8D F8         JP PlaySFX                  ; tail call
 103+ CD1D              .cstClearBlockFlag:
 104+ CD1D AF               XOR A
 105+ CD1E 32 B7 82         LD (BlockedExitSoundFlag), A
 106+ CD21 C9               RET
 107+ CD22              .cstNotFrozen:
 108+ CD22                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD22 AF               XOR A
 110+ CD23 32 B7 82         LD (BlockedExitSoundFlag), A
 111+ CD26
 112+ CD26 3A AE 82         LD A, (InputDirection)
 113+ CD29 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CD2A
 115+ CD2A                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CD2A CB 5A            BIT 3, D                    ; W
 117+ CD2C CA 8D CD         JP Z, .noWest
 118+ CD2F 3A A1 81         LD A, (EntityTable + ENT_POSX)
 119+ CD32 FE 04            CP TRANSITION_ZONE
 120+ CD34 D2 8D CD         JP NC, .noWest
 121+ CD37 3A 0B 83         LD A, (CurrentScreenX)
 122+ CD3A B7               OR A
 123+ CD3B CA 8D CD         JP Z, .noWest
 124+ CD3E                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CD3E 06 00            LD B, 0
 126+ CD40 3A A2 81         LD A, (EntityTable + ENT_POSY)
 127+ CD43 4F               LD C, A
 128+ CD44 CD 8F D5         CALL IsPointBlocked
 129+ CD47 C2 8D CD         JP NZ, .noWest
 130+ CD4A 06 00            LD B, 0
 131+ CD4C 3A A2 81         LD A, (EntityTable + ENT_POSY)
 132+ CD4F C6 0A            ADD A, 10
 133+ CD51 4F               LD C, A
 134+ CD52 CD 8F D5         CALL IsPointBlocked
 135+ CD55 C2 8D CD         JP NZ, .noWest
 136+ CD58 06 00            LD B, 0
 137+ CD5A 3A A2 81         LD A, (EntityTable + ENT_POSY)
 138+ CD5D C6 14            ADD A, 20
 139+ CD5F 4F               LD C, A
 140+ CD60 CD 8F D5         CALL IsPointBlocked
 141+ CD63 C2 8D CD         JP NZ, .noWest
 142+ CD66 3A 0B 83         LD A, (CurrentScreenX)
 143+ CD69 3D               DEC A
 144+ CD6A 32 0B 83         LD (CurrentScreenX), A
 145+ CD6D 3E 08            LD A, DIR_W
 146+ CD6F 32 0F 83         LD (ScreenTransition), A
 147+ CD72 3E 03            LD A, 3                             ; entró por E (cruzó W) → side 3 = E
 148+ CD74 32 CA 5F         LD (LastEntrySide), A
 149+ CD77                  ; LastEntryCoord = (POSY - 16) / 8 (charY top-left aprox)
 150+ CD77 3A A2 81         LD A, (EntityTable + ENT_POSY)
 151+ CD7A D6 10            SUB 16
 152+ CD7C CB 3F            SRL A
 152+ CD7E CB 3F          SRL A
 152+ CD80 CB 3F          SRL A
 153+ CD82 32 CB 5F         LD (LastEntryCoord), A
 154+ CD85 3E E8            LD A, SCREEN_MAX_X
 155+ CD87 32 A1 81         LD (EntityTable + ENT_POSX), A
 156+ CD8A C3 B4 CE         JP .doTransition
 157+ CD8D
 158+ CD8D              .noWest:
 159+ CD8D                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 160+ CD8D CB 52            BIT 2, D                    ; E
 161+ CD8F CA F1 CD         JP Z, .noEast
 162+ CD92 3A A1 81         LD A, (EntityTable + ENT_POSX)
 163+ CD95 FE E8            CP SCREEN_MAX_X
 164+ CD97 DA F1 CD         JP C, .noEast
 165+ CD9A 3A 0B 83         LD A, (CurrentScreenX)
 166+ CD9D FE 0F            CP MAP_WIDTH - 1
 167+ CD9F CA F1 CD         JP Z, .noEast
 168+ CDA2                  ; Check collision at col 31 (top + mid + bottom del player)
 169+ CDA2 06 F8            LD B, 248
 170+ CDA4 3A A2 81         LD A, (EntityTable + ENT_POSY)
 171+ CDA7 4F               LD C, A
 172+ CDA8 CD 8F D5         CALL IsPointBlocked
 173+ CDAB C2 F1 CD         JP NZ, .noEast
 174+ CDAE 06 F8            LD B, 248
 175+ CDB0 3A A2 81         LD A, (EntityTable + ENT_POSY)
 176+ CDB3 C6 0A            ADD A, 10
 177+ CDB5 4F               LD C, A
 178+ CDB6 CD 8F D5         CALL IsPointBlocked
 179+ CDB9 C2 F1 CD         JP NZ, .noEast
 180+ CDBC 06 F8            LD B, 248
 181+ CDBE 3A A2 81         LD A, (EntityTable + ENT_POSY)
 182+ CDC1 C6 14            ADD A, 20
 183+ CDC3 4F               LD C, A
 184+ CDC4 CD 8F D5         CALL IsPointBlocked
 185+ CDC7 C2 F1 CD         JP NZ, .noEast
 186+ CDCA 3A 0B 83         LD A, (CurrentScreenX)
 187+ CDCD 3C               INC A
 188+ CDCE 32 0B 83         LD (CurrentScreenX), A
 189+ CDD1 3E 04            LD A, DIR_E
 190+ CDD3 32 0F 83         LD (ScreenTransition), A
 191+ CDD6 3E 02            LD A, 2                             ; entró por W (cruzó E) → side 2 = W
 192+ CDD8 32 CA 5F         LD (LastEntrySide), A
 193+ CDDB 3A A2 81         LD A, (EntityTable + ENT_POSY)
 194+ CDDE D6 10            SUB 16
 195+ CDE0 CB 3F            SRL A
 195+ CDE2 CB 3F          SRL A
 195+ CDE4 CB 3F          SRL A
 196+ CDE6 32 CB 5F         LD (LastEntryCoord), A
 197+ CDE9 3E 00            LD A, SCREEN_MIN_X
 198+ CDEB 32 A1 81         LD (EntityTable + ENT_POSX), A
 199+ CDEE C3 B4 CE         JP .doTransition
 200+ CDF1
 201+ CDF1              .noEast:
 202+ CDF1                  ; --- Comprobar borde NORTE (solo si pulsa N) ---
 203+ CDF1 CB 42            BIT 0, D                    ; N
 204+ CDF3 CA 52 CE         JP Z, .noNorth
 205+ CDF6 3A A2 81         LD A, (EntityTable + ENT_POSY)
 206+ CDF9 FE 14            CP SCREEN_MIN_Y + TRANSITION_ZONE
 207+ CDFB D2 52 CE         JP NC, .noNorth
 208+ CDFE 3A 0C 83         LD A, (CurrentScreenY)
 209+ CE01 B7               OR A
 210+ CE02 CA 52 CE         JP Z, .noNorth
 211+ CE05                  ; Check collision at row 0 (left + mid + right del player)
 212+ CE05 3A A1 81         LD A, (EntityTable + ENT_POSX)
 213+ CE08 47               LD B, A
 214+ CE09 0E 10            LD C, SCREEN_MIN_Y
 215+ CE0B CD 8F D5         CALL IsPointBlocked
 216+ CE0E C2 52 CE         JP NZ, .noNorth
 217+ CE11 3A A1 81         LD A, (EntityTable + ENT_POSX)
 218+ CE14 C6 07            ADD A, 7
 219+ CE16 47               LD B, A
 220+ CE17 0E 10            LD C, SCREEN_MIN_Y
 221+ CE19 CD 8F D5         CALL IsPointBlocked
 222+ CE1C C2 52 CE         JP NZ, .noNorth
 223+ CE1F 3A A1 81         LD A, (EntityTable + ENT_POSX)
 224+ CE22 C6 0F            ADD A, 15
 225+ CE24 47               LD B, A
 226+ CE25 0E 10            LD C, SCREEN_MIN_Y
 227+ CE27 CD 8F D5         CALL IsPointBlocked
 228+ CE2A C2 52 CE         JP NZ, .noNorth
 229+ CE2D 3A 0C 83         LD A, (CurrentScreenY)
 230+ CE30 3D               DEC A
 231+ CE31 32 0C 83         LD (CurrentScreenY), A
 232+ CE34 3E 01            LD A, DIR_N
 233+ CE36 32 0F 83         LD (ScreenTransition), A
 234+ CE39 3E 01            LD A, 1                             ; entró por S (cruzó N) → side 1 = S
 235+ CE3B 32 CA 5F         LD (LastEntrySide), A
 236+ CE3E                  ; LastEntryCoord = POSX / 8 (charX top-left aprox)
 237+ CE3E 3A A1 81         LD A, (EntityTable + ENT_POSX)
 238+ CE41 CB 3F            SRL A
 238+ CE43 CB 3F          SRL A
 238+ CE45 CB 3F          SRL A
 239+ CE47 32 CB 5F         LD (LastEntryCoord), A
 240+ CE4A 3E A8            LD A, SCREEN_MAX_Y
 241+ CE4C 32 A2 81         LD (EntityTable + ENT_POSY), A
 242+ CE4F C3 B4 CE         JP .doTransition
 243+ CE52
 244+ CE52              .noNorth:
 245+ CE52                  ; --- Comprobar borde SUR (solo si pulsa S) ---
 246+ CE52 CB 4A            BIT 1, D                    ; S
 247+ CE54 CA 10 CF         JP Z, .noSouth
 248+ CE57 3A A2 81         LD A, (EntityTable + ENT_POSY)
 249+ CE5A FE A8            CP SCREEN_MAX_Y
 250+ CE5C DA 10 CF         JP C, .noSouth
 251+ CE5F 3A 0C 83         LD A, (CurrentScreenY)
 252+ CE62 FE 0F            CP MAP_HEIGHT - 1
 253+ CE64 CA 10 CF         JP Z, .noSouth
 254+ CE67                  ; Check collision at row 21 (left + mid + right del player)
 255+ CE67 3A A1 81         LD A, (EntityTable + ENT_POSX)
 256+ CE6A 47               LD B, A
 257+ CE6B 0E A8            LD C, SCREEN_MAX_Y
 258+ CE6D CD 8F D5         CALL IsPointBlocked
 259+ CE70 C2 10 CF         JP NZ, .noSouth
 260+ CE73 3A A1 81         LD A, (EntityTable + ENT_POSX)
 261+ CE76 C6 07            ADD A, 7
 262+ CE78 47               LD B, A
 263+ CE79 0E A8            LD C, SCREEN_MAX_Y
 264+ CE7B CD 8F D5         CALL IsPointBlocked
 265+ CE7E C2 10 CF         JP NZ, .noSouth
 266+ CE81 3A A1 81         LD A, (EntityTable + ENT_POSX)
 267+ CE84 C6 0F            ADD A, 15
 268+ CE86 47               LD B, A
 269+ CE87 0E A8            LD C, SCREEN_MAX_Y
 270+ CE89 CD 8F D5         CALL IsPointBlocked
 271+ CE8C C2 10 CF         JP NZ, .noSouth
 272+ CE8F 3A 0C 83         LD A, (CurrentScreenY)
 273+ CE92 3C               INC A
 274+ CE93 32 0C 83         LD (CurrentScreenY), A
 275+ CE96 3E 02            LD A, DIR_S
 276+ CE98 32 0F 83         LD (ScreenTransition), A
 277+ CE9B 3E 00            LD A, 0                             ; entró por N (cruzó S) → side 0 = N
 278+ CE9D 32 CA 5F         LD (LastEntrySide), A
 279+ CEA0 3A A1 81         LD A, (EntityTable + ENT_POSX)
 280+ CEA3 CB 3F            SRL A
 280+ CEA5 CB 3F          SRL A
 280+ CEA7 CB 3F          SRL A
 281+ CEA9 32 CB 5F         LD (LastEntryCoord), A
 282+ CEAC 3E 10            LD A, SCREEN_MIN_Y
 283+ CEAE 32 A2 81         LD (EntityTable + ENT_POSY), A
 284+ CEB1 C3 B4 CE         JP .doTransition
 285+ CEB4
 286+ CEB4              .doTransition:
 287+ CEB4                  ; Silenciar musica de la muerte INMEDIATAMENTE al cruzar el borde. Se hace
 288+ CEB4                  ; aqui (no en el bloque de reset al final del draw de la nueva sala) para
 289+ CEB4                  ; que no haya 1-2 frames de coletazo musical durante la transicion.
 290+ CEB4                  ; $FD = stop-if-loopable: solo corta DeathMusic (loopable, ligada a Death
 291+ CEB4                  ; entity que se despawnea ahora). Tracks one-shot (tension/sunrise/endgame)
 292+ CEB4                  ; siguen sonando — no tienen sentido cortarlos al cambiar de sala.
 293+ CEB4 F5               PUSH AF
 294+ CEB5 3E FD            LD A, $FD
 295+ CEB7 CD BD 99         CALL StartMusic
 296+ CEBA F1               POP AF
 297+ CEBB 3A 0F 83         LD A, (ScreenTransition)
 298+ CEBE 32 10 83         LD (LastScreenTransition), A
 299+ CEC1                  ; Guardar posicion del player al entrar (unico punto seguro para monsters)
 300+ CEC1 3A A1 81         LD A, (EntityTable + ENT_POSX)
 301+ CEC4 32 11 83         LD (LastEntryPosX), A
 302+ CEC7 3A A2 81         LD A, (EntityTable + ENT_POSY)
 303+ CECA 32 12 83         LD (LastEntryPosY), A
 304+ CECD CD C3 CC         CALL CalcScreenAddress
 305+ CED0 CD 11 CF         CALL ClearNasties           ; Limpiar enemigos al cambiar de pantalla
 306+ CED3 CD 92 8F         CALL DespawnScaredMonsters  ; Borra monsters fleeing stuck (no siguen al player en dawn)
 307+ CED6 CD 16 C0         CALL RepositionMonstersAtEntry ; Monsters siguen al player desde la pantalla anterior
 308+ CED9                  ; SFX de transicion de pantalla (comentado para pruebas)
 309+ CED9                  ; LD HL, SFX_ScreenTransition
 310+ CED9                  ; CALL PlaySFX
 311+ CED9 AF               XOR A
 312+ CEDA 32 7B 5F         LD (PendingEraseCount), A   ; Cancelar erases pendientes (pantalla se borra)
 313+ CEDD 3E 01            LD A, 1
 314+ CEDF 32 13 83         LD (ScreenDirty), A
 315+ CEE2 32 15 83         LD (ScreenJustRedrawn), A
 316+ CEE5
 317+ CEE5                  ; --- Reiniciar el patron "po-po-popo-po" de MonstersMusic en cada cruce ---
 318+ CEE5                  ; Si el secuencer esta activo (Step != $FF), resetear Step=0 + Timer=1 ->
 319+ CEE5                  ; el primer "po" suena en el frame inmediato de la nueva sala.
 320+ CEE5                  ; Step=$FF (sentinel inactivo) -> StartMonstersMusic no se llama.
 321+ CEE5 3A BD FA         LD A, (MonstersMusicStep)
 322+ CEE8 3C               INC A
 323+ CEE9 C4 7F FA         CALL NZ, StartMonstersMusic
 324+ CEEC
 325+ CEEC                  ; --- Magic compass: BFS sincronico ANTES de DrawScreen ---
 326+ CEEC                  ; Si el power-up esta activo, recalcular el path AHORA con el nuevo
 327+ CEEC                  ; CurrentScreenX/Y + LastEntrySide/Coord. Sin esto, el BFS amortizado
 328+ CEEC                  ; tarda 3-4 frames en converger y los primeros ticks visibles en la
 329+ CEEC                  ; nueva sala parpadeaban apuntando a la direccion vieja. El sync se paga
 330+ CEEC                  ; con ~10K T-states extra en el frame del cruce — el unico que ya tenia
 331+ CEEC                  ; presupuesto apretado por DrawScreen, pero solo ocurre 1 vez por cruce
 332+ CEEC                  ; y no afecta a los frames de gameplay normal.
 333+ CEEC 3A BF 5F         LD A, (MagicCompassTimer)
 334+ CEEF 47               LD B, A
 335+ CEF0 3A C0 5F         LD A, (MagicCompassTimer + 1)
 336+ CEF3 B0               OR B
 337+ CEF4 C4 7A 76         CALL NZ, ForceComputeMagicCompassPath
 338+ CEF7
 339+ CEF7                  ; --- Achievement chime: sweep AY al entrar a la sala del hito ---
 340+ CEF7                  ; Reusa AY_PlayCompassPickup (mismo sweep ascendente que el pickup del
 341+ CEF7                  ; magic compass random). No bloqueante, canal B AY. Solo dispara al
 342+ CEF7                  ; CRUZAR el borde de la sala objetivo (no cada frame).
 343+ CEF7 3A BB 82         LD A, (ObjectiveScreenX)
 344+ CEFA FE FF            CP $FF
 345+ CEFC 28 12            JR Z, .noSouth                  ; sin objetivo resuelto -> nada
 346+ CEFE 21 0B 83         LD HL, CurrentScreenX
 347+ CF01 BE               CP (HL)
 348+ CF02 20 0C            JR NZ, .noSouth                 ; X distinta -> no es la sala
 349+ CF04 3A BC 82         LD A, (ObjectiveScreenY)
 350+ CF07 21 0C 83         LD HL, CurrentScreenY
 351+ CF0A BE               CP (HL)
 352+ CF0B 20 03            JR NZ, .noSouth                 ; Y distinta -> no es la sala
 353+ CF0D CD C8 70         CALL AY_PlayCompassPickup
 354+ CF10              .noSouth:
 355+ CF10 C9               RET
 356+ CF11
 357+ CF11              ; ==============================================================================
 358+ CF11              ; ClearNasties - Limpia todos los slots de nasties (enemigos destruibles)
 359+ CF11              ; ==============================================================================
 360+ CF11              ; Los nasties no persisten entre pantallas (como en Sabre Wulf).
 361+ CF11              ; ==============================================================================
 362+ CF11              ClearNasties:
 363+ CF11 21 0E 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 364+ CF14 06 03            LD B, NUM_NASTIES
 365+ CF16              .clearLoop:
 366+ CF16 C5               PUSH BC
 367+ CF17 E5               PUSH HL
 368+ CF18 36 00            LD (HL), 0                  ; ENT_SPRITEID = 0
 369+ CF1A 23               INC HL
 370+ CF1B 36 00            LD (HL), 0                  ; ENT_TYPE = 0 (inactivo)
 371+ CF1D E1               POP HL
 372+ CF1E 11 10 00         LD DE, ENT_SIZE
 373+ CF21 19               ADD HL, DE
 374+ CF22 C1               POP BC
 375+ CF23 10 F1            DJNZ .clearLoop
 376+ CF25                  ; Reset spawn timer para nueva pantalla (delay antes de nasties)
 377+ CF25 3E 0C            LD A, SPAWN_INTERVAL
 378+ CF27 32 F8 82         LD (SpawnTimer), A
 379+ CF2A C9               RET
 380+ CF2B
 381+ CF2B              ; ==============================================================================
 382+ CF2B              ; DrawScreen - Dibuja la pantalla actual iterando BG sprites
 383+ CF2B              ; ==============================================================================
 384+ CF2B              ; Formato room: DEFW BgGfx_ptr : DEFB x_char, y_char ... DEFW $0000
 385+ CF2B              ; Formato BgGfx: DEFB height_px, width_bytes, pixel_data(CPL),
 386+ CF2B              ;                DEFB attr_h, attr_w, attr_data
 387+ CF2B              ; Solo se ejecuta cuando ScreenDirty=1 (cambio de pantalla).
 388+ CF2B              ; ==============================================================================
 389+ CF2B              DrawScreen:
 390+ CF2B 3A 13 83         LD A, (ScreenDirty)
 391+ CF2E B7               OR A
 392+ CF2F C8               RET Z
 393+ CF30
 394+ CF30                  ; --- Reset well / plaza clock detection ---
 395+ CF30 AF               XOR A
 396+ CF31 32 5A 8D         LD (WellActive), A
 397+ CF34 32 62 8D         LD (PlazaClockActive), A
 398+ CF37 3E FF            LD A, $FF
 399+ CF39 32 35 EE         LD (PlazaLastHour), A       ; forzar redibujado al entrar en room
 400+ CF3C 32 36 EE         LD (PlazaLastMin), A
 401+ CF3F
 402+ CF3F                  ; --- Limpiar pixeles ---
 403+ CF3F 21 00 40         LD HL, SCREEN_BASE
 404+ CF42 11 01 40         LD DE, SCREEN_BASE + 1
 405+ CF45 01 FF 17         LD BC, 6143
 406+ CF48 AF               XOR A
 407+ CF49 77               LD (HL), A
 408+ CF4A ED B0            LDIR
 409+ CF4C
 410+ CF4C                  ; --- Limpiar atributos: ink=WHITE, paper=BLACK ---
 411+ CF4C 21 00 58         LD HL, ATTR_BASE
 412+ CF4F 11 01 58         LD DE, ATTR_BASE + 1
 413+ CF52 01 FF 02         LD BC, ATTR_SIZE - 1
 414+ CF55 3E 07            LD A, $07
 415+ CF57 77               LD (HL), A
 416+ CF58 ED B0            LDIR
 417+ CF5A
 418+ CF5A                  ; --- Iterar sprites del room (formato Stage A: DEFB id, x, y, v; $FF = end) ---
 419+ CF5A 2A 0D 83         LD HL, (CurrentScreenAddr)
 420+ CF5D              .sprLoop:
 421+ CF5D 7E               LD A, (HL)                  ; A = id
 422+ CF5E 23               INC HL
 423+ CF5F FE FF            CP $FF
