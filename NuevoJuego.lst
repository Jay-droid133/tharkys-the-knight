 418+ E493              DrawRoomInfo:
 419+ E493                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E493 1E 00            LD E, 0
 421+ E495 06 0D            LD B, 13
 422+ E497              .clearLoop:
 423+ E497 C5               PUSH BC
 424+ E498 D5               PUSH DE
