 672+ ED11 2B               DEC HL
 673+ ED12 22 DF 82         LD (SpeedBuffTimer), HL
 674+ ED15 7C               LD A, H
 675+ ED16 B5               OR L
 676+ ED17 C0               RET NZ                              ; buff aun activo (color via cycler)
 677+ ED18                  ; Buff terminado: reset speeds + clear type. Color lo pinta el cycler.
 678+ ED18 3E 04            LD A, SPEED_RUN
 679+ ED1A 32 DD 82         LD (PlayerSpeedRun), A
 680+ ED1D 3E 02            LD A, SPEED_FIGHT
 681+ ED1F 32 DE 82         LD (PlayerSpeedFight), A
 682+ ED22 AF               XOR A
 683+ ED23 32 E1 82         LD (SpeedBuffType), A
 684+ ED26 C9               RET
