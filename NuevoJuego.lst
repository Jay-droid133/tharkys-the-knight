 748+ 6F17 ~            ; ==============================================================================
 749+ 6F17 ~            ; .cmcpComputeNeighbor - Calcula V dado R y side, con bounds check
 750+ 6F17 ~            ; ==============================================================================
 751+ 6F17 ~            ; IN:  B = R sid, C = side (0=N,1=S,2=W,3=E)
 752+ 6F17 ~            ; OUT: A = V sid (0..255) si valid; A = $FF si neighbor sale del mapa.
 753+ 6F17 ~            ; Destruye: AF.
 754+ 6F17 ~            ; ==============================================================================
 755+ 6F17 ~            .cmcpComputeNeighbor:
 756+ 6F17 ~                LD A, C
 757+ 6F17 ~                OR A
 758+ 6F17 ~                JR NZ, .ccnNotN
 759+ 6F17 ~                ; N: V = R - 16, valid if R >= 16
 760+ 6F17 ~                LD A, B
 761+ 6F17 ~                CP 16
 762+ 6F17 ~                JR C, .ccnInvalid
 763+ 6F17 ~                SUB 16
 764+ 6F17 ~                RET
 765+ 6F17 ~            .ccnNotN:
 766+ 6F17 ~                DEC A
 767+ 6F17 ~                JR NZ, .ccnNotS
 768+ 6F17 ~                ; S: V = R + 16, valid if R < 240
 769+ 6F17 ~                LD A, B
 770+ 6F17 ~                CP 240
 771+ 6F17 ~                JR NC, .ccnInvalid
 772+ 6F17 ~                ADD A, 16
 773+ 6F17 ~                RET
 774+ 6F17 ~            .ccnNotS:
 775+ 6F17 ~                DEC A
 776+ 6F17 ~                JR NZ, .ccnE
 777+ 6F17 ~                ; W: V = R - 1, valid if R % 16 != 0
 778+ 6F17 ~                LD A, B
 779+ 6F17 ~                AND $0F
 780+ 6F17 ~                JR Z, .ccnInvalid
 781+ 6F17 ~                LD A, B
 782+ 6F17 ~                DEC A
 783+ 6F17 ~                RET
 784+ 6F17 ~            .ccnE:
 785+ 6F17 ~                ; E: V = R + 1, valid if R % 16 != 15
 786+ 6F17 ~                LD A, B
 787+ 6F17 ~                AND $0F
 788+ 6F17 ~                CP 15
 789+ 6F17 ~                JR Z, .ccnInvalid
 790+ 6F17 ~                LD A, B
 791+ 6F17 ~                INC A
 792+ 6F17 ~                RET
 793+ 6F17 ~            .ccnInvalid:
 794+ 6F17 ~                LD A, $FF
 795+ 6F17 ~                RET
