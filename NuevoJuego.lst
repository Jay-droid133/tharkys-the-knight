   1+ F88D              ; ==============================================================================
   2+ F88D              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F88D              ; ==============================================================================
   4+ F88D              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F88D              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F88D              ;
   7+ F88D              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F88D              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F88D              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F88D              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F88D              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F88D              ; ==============================================================================
  13+ F88D
  14+ F88D              ; ==============================================================================
  15+ F88D              ; PlaySFX - Reproduce un efecto de sonido
  16+ F88D              ; ==============================================================================
  17+ F88D              ; Entrada: HL = puntero a datos del efecto
  18+ F88D              ; Modifica: AF, BC, DE, HL
  19+ F88D              ; ==============================================================================
  20+ F88D              PlaySFX:
  21+ F88D F3               DI                          ; Sin interrupciones para audio limpio
  22+ F88E 3A 86 8D         LD A, (CurrentBorderColor)
  23+ F891 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F893 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F894
  26+ F894              .nextStep:
  27+ F894 7E               LD A, (HL)                  ; Leer duration
  28+ F895 B7               OR A
  29+ F896 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F898
  31+ F898 47               LD B, A                     ; B = duration (bucle externo)
  32+ F899 23               INC HL
  33+ F89A 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F89B 23               INC HL
  35+ F89C 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F89D 23               INC HL
  37+ F89E 7E               LD A, (HL)                  ; A = flags
  38+ F89F 23               INC HL
  39+ F8A0 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F8A1 CB 47            BIT 0, A
  41+ F8A3 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F8A5
  43+ F8A5              ; --- Bucle de tono normal ---
  44+ F8A5              .toneLoop:
  45+ F8A5                  ; Semi-periodo HIGH
  46+ F8A5 7B               LD A, E
  47+ F8A6 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F8A8 D3 FE            OUT ($FE), A
  49+ F8AA 79               LD A, C                     ; A = pitch actual
  50+ F8AB              .toneDelayHi:
  51+ F8AB 3D               DEC A
  52+ F8AC 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F8AE
  54+ F8AE                  ; Semi-periodo LOW
  55+ F8AE 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F8AF D3 FE            OUT ($FE), A
  57+ F8B1 79               LD A, C
  58+ F8B2              .toneDelayLo:
  59+ F8B2 3D               DEC A
  60+ F8B3 20 FD            JR NZ, .toneDelayLo
  61+ F8B5
  62+ F8B5                  ; Aplicar pitch sweep
  63+ F8B5 79               LD A, C
  64+ F8B6 82               ADD A, D                    ; pitch += pitchDelta
  65+ F8B7 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F8B9 FA C1 F8         JP M, .toneClamp            ; evitar pitch negativo
  67+ F8BC 4F               LD C, A
  68+ F8BD              .toneAfterClamp:
  69+ F8BD 10 E6            DJNZ .toneLoop
  70+ F8BF 18 30            JR .stepDone
  71+ F8C1
  72+ F8C1              .toneClamp:
  73+ F8C1 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F8C3 18 F8            JR .toneAfterClamp
  75+ F8C5
  76+ F8C5              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F8C5              .noiseLoop:
  78+ F8C5                  ; Semi-periodo HIGH con ruido
  79+ F8C5 7B               LD A, E
  80+ F8C6 F6 10            OR $10
  81+ F8C8 D3 FE            OUT ($FE), A
  82+ F8CA ED 5F            LD A, R                     ; R register como PRNG
  83+ F8CC A9               XOR C                       ; mezclar con pitch base
  84+ F8CD E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F8CF F6 01            OR $01                      ; minimo 1
  86+ F8D1              .noiseDelayHi:
  87+ F8D1 3D               DEC A
  88+ F8D2 20 FD            JR NZ, .noiseDelayHi
  89+ F8D4
  90+ F8D4                  ; Semi-periodo LOW
  91+ F8D4 7B               LD A, E
  92+ F8D5 D3 FE            OUT ($FE), A
  93+ F8D7 ED 5F            LD A, R
  94+ F8D9 A9               XOR C
  95+ F8DA E6 1F            AND $1F
  96+ F8DC F6 01            OR $01
  97+ F8DE              .noiseDelayLo:
  98+ F8DE 3D               DEC A
  99+ F8DF 20 FD            JR NZ, .noiseDelayLo
 100+ F8E1
 101+ F8E1                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F8E1 79               LD A, C
 103+ F8E2 82               ADD A, D
 104+ F8E3 28 08            JR Z, .noiseClamp
 105+ F8E5 FA ED F8         JP M, .noiseClamp
 106+ F8E8 4F               LD C, A
 107+ F8E9              .noiseAfterClamp:
 108+ F8E9 10 DA            DJNZ .noiseLoop
 109+ F8EB 18 04            JR .stepDone
 110+ F8ED
 111+ F8ED              .noiseClamp:
 112+ F8ED 0E 01            LD C, 1
 113+ F8EF 18 F8            JR .noiseAfterClamp
 114+ F8F1
 115+ F8F1              .stepDone:
 116+ F8F1 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F8F2 18 A0            JR .nextStep
 118+ F8F4
 119+ F8F4              .done:
 120+ F8F4 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F8F5 D3 FE            OUT ($FE), A
 122+ F8F7 FB               EI
 123+ F8F8 C9               RET
