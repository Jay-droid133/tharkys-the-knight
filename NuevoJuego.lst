 375+ E58F              ; ==============================================================================
 376+ E58F              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 377+ E58F              ; ==============================================================================
 378+ E58F              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 379+ E58F              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 380+ E58F              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 381+ E58F              ; ==============================================================================
 382+ E58F              DrawHealthStaminaHUD:
 383+ E58F                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 384+ E58F 3A 1F 9C         LD A, (PlayerHealth)
 385+ E592 4F               LD C, A                             ; C = nivel (0-16)
 386+ E593 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 387+ E596 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 388+ E599 DD 21 FB E1      LD IX, BgGfx_hud_clock + 2          ; Sprite data (skip header), offset 0
 389+ E59D CD 10 E6         CALL .drawBar
 390+ E5A0
 391+ E5A0                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 392+ E5A0 3A 20 9C         LD A, (PlayerStamina)
 393+ E5A3 4F               LD C, A
 394+ E5A4 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 395+ E5A7 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 396+ E5AA DD 21 FF E1      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite data, offset 4 (cols 4-5)
 397+ E5AE CD 10 E6         CALL .drawBar
 398+ E5B1
 399+ E5B1                  ; --- Flash de recuperacion del pozo ---
 400+ E5B1 3A 78 87         LD A, (WellFlashTimer)
 401+ E5B4 B7               OR A
 402+ E5B5 28 28            JR Z, .noFlash
 403+ E5B7 3D               DEC A
 404+ E5B8 32 78 87         LD (WellFlashTimer), A
 405+ E5BB                  ; Flash: alternar blanco/normal cada 4 frames
 406+ E5BB E6 04            AND $04
 407+ E5BD 28 20            JR Z, .noFlash
 408+ E5BF                  ; Flash blanco brillante en ambas barras + player verde
 409+ E5BF 3E 47            LD A, WHITE | $40
 410+ E5C1 32 0D 58         LD ($580D), A
 411+ E5C4 32 0E 58         LD ($580E), A
 412+ E5C7 32 2D 58         LD ($582D), A
 413+ E5CA 32 2E 58         LD ($582E), A
 414+ E5CD 32 11 58         LD ($5811), A
 415+ E5D0 32 12 58         LD ($5812), A
 416+ E5D3 32 31 58         LD ($5831), A
 417+ E5D6 32 32 58         LD ($5832), A
 418+ E5D9 3E 44            LD A, GREEN | $40
 419+ E5DB 32 87 80         LD (EntityTable + ENT_ATTR), A
 420+ E5DE C9               RET
 421+ E5DF              .noFlash:
 422+ E5DF                  ; Restaurar color player si estaba en flash verde
 423+ E5DF 3A 87 80         LD A, (EntityTable + ENT_ATTR)
 424+ E5E2 FE 44            CP GREEN | $40
 425+ E5E4 20 05            JR NZ, .noFlashPlayer
 426+ E5E6 3E 47            LD A, WHITE | $40
 427+ E5E8 32 87 80         LD (EntityTable + ENT_ATTR), A
 428+ E5EB              .noFlashPlayer:
 429+ E5EB                  ; --- Attrs segun nivel (normal) ---
 430+ E5EB                  ; Salud
 431+ E5EB 3A 1F 9C         LD A, (PlayerHealth)
 432+ E5EE CD 58 E6         CALL .levelToColor
 433+ E5F1 32 0D 58         LD ($580D), A
 434+ E5F4 32 0E 58         LD ($580E), A
 435+ E5F7 32 2D 58         LD ($582D), A
 436+ E5FA 32 2E 58         LD ($582E), A
 437+ E5FD                  ; Stamina
 438+ E5FD 3A 20 9C         LD A, (PlayerStamina)
 439+ E600 CD 58 E6         CALL .levelToColor
 440+ E603 32 11 58         LD ($5811), A
 441+ E606 32 12 58         LD ($5812), A
 442+ E609 32 31 58         LD ($5831), A
 443+ E60C 32 32 58         LD ($5832), A
 444+ E60F C9               RET
 445+ E610
 446+ E610              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 447+ E610              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 448+ E610              ; IX = puntero al primer byte de la decoracion en sprite data
 449+ E610              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 450+ E610              ; las (16-C) superiores con $00 (vacio/negro)
 451+ E610              .drawBar:
 452+ E610 7D               LD A, L
 453+ E611 32 56 E6         LD (.dbCol), A                      ; Guardar columna base row 0
 454+ E614 7B               LD A, E
 455+ E615 32 57 E6         LD (.dbCol1), A                     ; Guardar columna base row 1
 456+ E618 06 10            LD B, 16                            ; 16 scanlines totales
 457+ E61A 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 458+ E61C                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 459+ E61C 3E 10            LD A, 16
 460+ E61E 91               SUB C
 461+ E61F 5F               LD E, A                             ; E = primera scanline llena
 462+ E620              .dbLoop:
 463+ E620                  ; Calcular direccion VRAM
 464+ E620 7A               LD A, D
 465+ E621 FE 08            CP 8
 466+ E623 30 09            JR NC, .dbCalcR1
 467+ E625                  ; Char row 0
 468+ E625 67               LD H, A
 469+ E626 CB F4            SET 6, H
 470+ E628 3A 56 E6         LD A, (.dbCol)
 471+ E62B 6F               LD L, A
 472+ E62C 18 09            JR .dbWrite
 473+ E62E              .dbCalcR1:
 474+ E62E                  ; Char row 1
 475+ E62E D6 08            SUB 8
 476+ E630 67               LD H, A
 477+ E631 CB F4            SET 6, H
 478+ E633 3A 57 E6         LD A, (.dbCol1)
 479+ E636 6F               LD L, A
 480+ E637              .dbWrite:
 481+ E637                  ; D < E → vacio (blanquear), D >= E → lleno (sprite data)
 482+ E637 7A               LD A, D
 483+ E638 BB               CP E
 484+ E639 30 07            JR NC, .dbFull
 485+ E63B                  ; Vacio: escribir negro
 486+ E63B 36 00            LD (HL), $00
 487+ E63D 23               INC HL
 488+ E63E 36 00            LD (HL), $00
 489+ E640 18 09            JR .dbAdvanceSpr
 490+ E642              .dbFull:
 491+ E642                  ; Lleno: copiar sprite data sin CPL (ya almacenado invertido)
 492+ E642 DD 7E 00         LD A, (IX+0)
 493+ E645 77               LD (HL), A
 494+ E646 23               INC HL
 495+ E647 DD 7E 01         LD A, (IX+1)
 496+ E64A 77               LD (HL), A
 497+ E64B              .dbAdvanceSpr:
 498+ E64B                  ; Avanzar puntero sprite (siempre, 6 bytes por scanline)
 499+ E64B D5               PUSH DE
 500+ E64C 11 06 00         LD DE, 6
 501+ E64F DD 19            ADD IX, DE
 502+ E651 D1               POP DE
 503+ E652 14               INC D
 504+ E653 10 CB            DJNZ .dbLoop
 505+ E655 C9               RET
 506+ E656
 507+ E656 00           .dbCol:  DEFB 0
 508+ E657 00           .dbCol1: DEFB 0
 509+ E658
 510+ E658              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ E658              .levelToColor:
 512+ E658 FE 0C            CP 12
 513+ E65A 30 11            JR NC, .lcGreen
 514+ E65C FE 07            CP 7
 515+ E65E 30 0A            JR NC, .lcCyan
 516+ E660 FE 03            CP 3
 517+ E662 30 03            JR NC, .lcYellow
 518+ E664 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ E666 C9               RET
 520+ E667              .lcYellow:
 521+ E667 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ E669 C9               RET
 523+ E66A              .lcCyan:
 524+ E66A 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ E66C C9               RET
 526+ E66D              .lcGreen:
 527+ E66D 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ E66F C9               RET
 529+ E670
 530+ E670              ; ==============================================================================
 531+ E670              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ E670              ; ==============================================================================
 533+ E670              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ E670              ; ==============================================================================
 535+ E670              DrawHandLine:
 536+ E670 87               ADD A, A
 537+ E671 4F               LD C, A
 538+ E672 06 00            LD B, 0
 539+ E674 09               ADD HL, BC
 540+ E675 7E               LD A, (HL)
 541+ E676 23               INC HL
 542+ E677 66               LD H, (HL)
 543+ E678 6F               LD L, A             ; HL = puntero a datos de línea
 544+ E679
 545+ E679              .pixLoop:
 546+ E679 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ E67A B7               OR A
 548+ E67B C8               RET Z
 549+ E67C 57               LD D, A
 550+ E67D 23               INC HL
 551+ E67E 7E               LD A, (HL)          ; VRAM L
 552+ E67F 23               INC HL
 553+ E680 5F               LD E, A
 554+ E681 7E               LD A, (HL)          ; mask
 555+ E682 23               INC HL
 556+ E683 E5               PUSH HL
 557+ E684 2F               CPL                 ; ~mask
 558+ E685 62               LD H, D
 559+ E686 6B               LD L, E
 560+ E687 A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ E688 77               LD (HL), A
 562+ E689 E1               POP HL
 563+ E68A 18 ED            JR .pixLoop
 564+ E68C
 565+ E68C              ; ==============================================================================
 566+ E68C              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ E68C              ; ==============================================================================
 568+ E68C              CheckClockSpeedKeys:
 569+ E68C 3E F7            LD A, $F7
 570+ E68E DB FE            IN A, ($FE)
 571+ E690 2F               CPL
 572+ E691 E6 07            AND $07
 573+ E693
 574+ E693 47               LD B, A
 575+ E694 3A 6D E2         LD A, (ClockDebounce)
 576+ E697 4F               LD C, A
 577+ E698 78               LD A, B
 578+ E699 32 6D E2         LD (ClockDebounce), A
 579+ E69C 78               LD A, B
 580+ E69D
 581+ E69D 79               LD A, C
 582+ E69E 2F               CPL
 583+ E69F A0               AND B
 584+ E6A0 C8               RET Z
 585+ E6A1
 586+ E6A1 CB 47            BIT 0, A
 587+ E6A3 28 06            JR Z, .try2
 588+ E6A5 3E 01            LD A, 1
 589+ E6A7 32 6C E2         LD (SubMinuteMax), A
 590+ E6AA C9               RET
 591+ E6AB              .try2:
 592+ E6AB CB 4F            BIT 1, A
 593+ E6AD 28 06            JR Z, .try3
 594+ E6AF 3E 05            LD A, 5
 595+ E6B1 32 6C E2         LD (SubMinuteMax), A
 596+ E6B4 C9               RET
 597+ E6B5              .try3:
 598+ E6B5 3E 15            LD A, 21
 599+ E6B7 32 6C E2         LD (SubMinuteMax), A
 600+ E6BA C9               RET
 601+ E6BB
