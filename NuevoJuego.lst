4514+ B78A              ; ==============================================================================
4515+ B78A              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4516+ B78A              ; ==============================================================================
4517+ B78A              SpawnOneNasty:
4518+ B78A                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4519+ B78A ED 5F            LD A, R
4520+ B78C E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4521+ B78E 6F               LD L, A
4522+ B78F 26 00            LD H, 0
4523+ B791 ED 5B A8 BC      LD DE, (CurrentNastyTable)
4524+ B795 19               ADD HL, DE
4525+ B796 7E               LD A, (HL)
4526+ B797
4527+ B797                  ; Configurar entidad base
4528+ B797 DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4529+ B79A DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4530+ B79E DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4531+ B7A2                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4532+ B7A2                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4533+ B7A2 3A A8 BC         LD A, (CurrentNastyTable)
4534+ B7A5 FE 8F            CP LOW CrepuscularTypeTable
4535+ B7A7 20 0B            JR NZ, .spnDay
4536+ B7A9 3A A9 BC         LD A, (CurrentNastyTable + 1)
4537+ B7AC FE BC            CP HIGH CrepuscularTypeTable
4538+ B7AE 20 04            JR NZ, .spnDay
4539+ B7B0 3E 68            LD A, SPRID_SPAWN_NIGHT
4540+ B7B2 18 02            JR .spnSet
4541+ B7B4              .spnDay:
4542+ B7B4 3E 46            LD A, SPRID_SPAWN
4543+ B7B6              .spnSet:
4544+ B7B6 DD 77 00         LD (IX+ENT_SPRITEID), A
4545+ B7B9 DD 77 08         LD (IX+ENT_ANIMBASE), A
4546+ B7BC DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4547+ B7C0 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4548+ B7C4
4549+ B7C4                  ; Color segun tipo (cada tipo tiene color fijo)
4550+ B7C4 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4551+ B7C7 21 93 BC         LD HL, NastyColorTable
4552+ B7CA D5               PUSH DE
4553+ B7CB 11 20 00         LD DE, SPRID_ENEMY_0
4554+ B7CE 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4555+ B7CF CB 3F            SRL A
4556+ B7D1 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4557+ B7D3 5F               LD E, A
4558+ B7D4 16 00            LD D, 0
4559+ B7D6 19               ADD HL, DE
4560+ B7D7 7E               LD A, (HL)
4561+ B7D8 D1               POP DE
4562+ B7D9              .setAttr:
4563+ B7D9 DD 77 05         LD (IX+ENT_ATTR), A
4564+ B7DC
4565+ B7DC                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4566+ B7DC                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4567+ B7DC                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4568+ B7DC                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4569+ B7DC                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4570+ B7DC                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4571+ B7DC 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4572+ B7DE 32 3C B9         LD (.spawnW1), A
4573+ B7E1 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4574+ B7E3 32 3D B9         LD (.spawnH1), A
4575+ B7E6
4576+ B7E6                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4577+ B7E6                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4578+ B7E6                  ; Sin rebuild aqui = sin lag por spawn.)
4579+ B7E6                  ; Posicion aleatoria (con reintentos)
