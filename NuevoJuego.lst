5359+ C025              ; ==============================================================================
5360+ C025              ; RepositionMonstersAtEntry - Al cambiar de room
5361+ C025              ; ==============================================================================
5362+ C025              RepositionMonstersAtEntry:
5363+ C025 3A 9F B5         LD A, (MonstersActive)
5364+ C028 B7               OR A
5365+ C029 C8               RET Z
5366+ C02A                  ; Pre-construir CollisionMap del room NEW aqui (DrawScreen lo reconstruira
5367+ C02A                  ; de nuevo poco despues, pero necesitamos datos frescos para el collision
5368+ C02A                  ; check de la Fase 8 .reInNewStepBack — sin esto usariamos el map del room
5369+ C02A                  ; anterior y el migrado acabaria sobre BG sprites).
5370+ C02A CD FC CF         CALL BuildCollisionMap
5371+ C02D                  ; Memoria de ubicacion: solo reposicionar monsters cuyo RoomId == OLD
5372+ C02D                  ; (siguen al player desde el room anterior) o RoomId == NEW (ya vivian
5373+ C02D                  ; en este room, migrados por knockback previo). Los que vivan en otro
5374+ C02D                  ; room quedan intactos (TYPE_NONE en su posicion clampada) y no se
5375+ C02D                  ; activaran hasta que el player visite su room.
5376+ C02D CD E3 92         CALL MaiGetCurrentScreenId
5377+ C030 32 7A C2         LD (.reNewId), A
5378+ C033 CD 26 93         CALL MaiGetOldScreenId
5379+ C036 32 7B C2         LD (.reOldId), A
5380+ C039                  ; Cache entry side del player (solo valido para monsters que vienen de OLD)
5381+ C039 CD 3C 96         CALL MaiGetEntrySide            ; A = MAI_SIDE_N/S/W/E o $FF
5382+ C03C 32 7C C2         LD (.reFollowSide), A
5383+ C03F DD 21 24 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5384+ C043 06 03            LD B, MONSTERS_TO_SPAWN
5385+ C045 0E 00            LD C, 0                         ; C = slot index
5386+ C047              .reLoop:
5387+ C047 C5               PUSH BC
5388+ C048                  ; --- Pass 1 (solo TYPE_MONSTER): snapshot pre-transition para poder
5389+ C048                  ; restaurar si player vuelve antes de que este monster active en NEW. ---
5390+ C048 DD 7E 01         LD A, (IX+ENT_TYPE)
5391+ C04B FE 02            CP TYPE_MONSTER
5392+ C04D 20 1D            JR NZ, .reCheckRestore
5393+ C04F                  ; Guardar LastSeenRoom = OLD, LastSeenX/Y = POSX/POSY actuales
5394+ C04F 59               LD E, C
5395+ C050 16 00            LD D, 0
5396+ C052 21 8E 5F         LD HL, MonsterLastSeenRoom
5397+ C055 19               ADD HL, DE
5398+ C056 3A 7B C2         LD A, (.reOldId)
5399+ C059 77               LD (HL), A
5400+ C05A 21 91 5F         LD HL, MonsterLastSeenX
5401+ C05D 19               ADD HL, DE
5402+ C05E DD 7E 03         LD A, (IX+ENT_POSX)
5403+ C061 77               LD (HL), A
5404+ C062 21 94 5F         LD HL, MonsterLastSeenY
5405+ C065 19               ADD HL, DE
5406+ C066 DD 7E 04         LD A, (IX+ENT_POSY)
5407+ C069 77               LD (HL), A
5408+ C06A 18 1E            JR .reCheckReposition
5409+ C06C              .reCheckRestore:
5410+ C06C                  ; TYPE_NONE: check si debemos restaurar (player vuelve rapido antes de
5411+ C06C                  ; que este slot active en el NEW previo). Condicion:
5412+ C06C                  ;   RoomId[slot] == OLD_actual && LastSeenRoom[slot] == NEW_actual
5413+ C06C                  ; Significa: este monster estaba tracked como siguiendo al player (RoomId
5414+ C06C                  ; = OLD = donde el player vino), y su ultima vista visible fue en el
5415+ C06C                  ; room al que el player vuelve.
5416+ C06C 59               LD E, C
5417+ C06D 16 00            LD D, 0
5418+ C06F 21 94 90         LD HL, MonsterRoomId
5419+ C072 19               ADD HL, DE
5420+ C073 7E               LD A, (HL)
5421+ C074 47               LD B, A
5422+ C075 3A 7B C2         LD A, (.reOldId)
5423+ C078 B8               CP B
5424+ C079 20 0F            JR NZ, .reCheckReposition       ; RoomId != OLD → no follow-in-transit
5425+ C07B 21 8E 5F         LD HL, MonsterLastSeenRoom
5426+ C07E 19               ADD HL, DE
5427+ C07F 7E               LD A, (HL)
5428+ C080 47               LD B, A
5429+ C081 3A 7A C2         LD A, (.reNewId)
5430+ C084 B8               CP B
5431+ C085 20 03            JR NZ, .reCheckReposition       ; LastSeen != NEW
5432+ C087 C3 78 C1         JP .reRestore                   ; ambas condiciones OK → restore
5433+ C08A              .reCheckReposition:
5434+ C08A                  ; Fetch MonsterRoomId[slot] para comparaciones OLD/NEW (logica original)
5435+ C08A 59               LD E, C
5436+ C08B 16 00            LD D, 0
5437+ C08D 21 94 90         LD HL, MonsterRoomId
5438+ C090 19               ADD HL, DE
5439+ C091 7E               LD A, (HL)
5440+ C092 5F               LD E, A                         ; E = room_id
5441+ C093 3A 7B C2         LD A, (.reOldId)
5442+ C096 BB               CP E
5443+ C097 28 09            JR Z, .reFromOld
5444+ C099 3A 7A C2         LD A, (.reNewId)
5445+ C09C BB               CP E
5446+ C09D 28 09            JR Z, .reInNew
5447+ C09F C3 5F C2         JP .reSkip                      ; Otro room: no tocar
5448+ C0A2              .reFromOld:
5449+ C0A2                  ; Monster viene con el player: usar entry side actual
5450+ C0A2 3A 7C C2         LD A, (.reFollowSide)
5451+ C0A5 C3 00 C2         JP .rePickGap
5452+ C0A8              .reInNew:
