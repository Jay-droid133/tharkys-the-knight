 610+ EF6E              ; ==============================================================================
 611+ EF6E              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 612+ EF6E              ; ==============================================================================
 613+ EF6E
 614+ EF6E              ; ==============================================================================
 615+ EF6E              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 616+ EF6E              ; ==============================================================================
 617+ EF6E              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 618+ EF6E              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 619+ EF6E              ; ==============================================================================
 620+ EF6E              BuildPlazaScanAddrs:
 621+ EF6E                  ; Calcular pixel coords del top-left de la esfera
 622+ EF6E 3A B3 90         LD A, (PlazaClockCharY)
 623+ EF71 07               RLCA
 624+ EF72 07               RLCA
 625+ EF73 07               RLCA
 626+ EF74 57               LD D, A                     ; D = pixelY = charY * 8
 627+ EF75 3A B2 90         LD A, (PlazaClockCharX)
 628+ EF78 07               RLCA
 629+ EF79 07               RLCA
 630+ EF7A 07               RLCA
 631+ EF7B 5F               LD E, A                     ; E = pixelX = charX * 8
 632+ EF7C CD 92 A0         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 633+ EF7F
 634+ EF7F DD 21 B4 90      LD IX, PlazaScanAddrs
 635+ EF83 06 10            LD B, 16
 636+ EF85              .buildLoop:
 637+ EF85 DD 75 00         LD (IX+0), L
 638+ EF88 DD 74 01         LD (IX+1), H
 639+ EF8B DD 23            INC IX
 640+ EF8D DD 23            INC IX
 641+ EF8F 05               DEC B
 642+ EF90 C8               RET Z
 643+ EF91 CD FE 9D         CALL NextPixelLine
 644+ EF94 18 EF            JR .buildLoop
 645+ EF96
 646+ EF96              ; ==============================================================================
 647+ EF96              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 648+ EF96              ; ==============================================================================
 649+ EF96              ; Llamar cada frame desde el main loop.
 650+ EF96              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 651+ EF96              ; ==============================================================================
 652+ EF96              DrawPlazaClock:
 653+ EF96 3A B1 90         LD A, (PlazaClockActive)
 654+ EF99 B7               OR A
 655+ EF9A C8               RET Z
 656+ EF9B
 657+ EF9B                  ; --- Calcular posicion actual de las agujas ---
 658+ EF9B 3A FC EA         LD A, (GameHours)
 659+ EF9E FE 0C            CP 12
 660+ EFA0 38 02            JR C, .pCalcHourOk
 661+ EFA2 D6 0C            SUB 12
 662+ EFA4              .pCalcHourOk:
 663+ EFA4 57               LD D, A                     ; D = display hour (0-11)
 664+ EFA5 3A FB EA         LD A, (GameMinutes)
 665+ EFA8 1E 00            LD E, 0
 666+ EFAA              .pCalcDiv5:
 667+ EFAA FE 05            CP 5
 668+ EFAC 38 05            JR C, .pCalcMinOk
 669+ EFAE D6 05            SUB 5
 670+ EFB0 1C               INC E
 671+ EFB1 18 F7            JR .pCalcDiv5
 672+ EFB3              .pCalcMinOk:
 673+ EFB3                  ; D = hour pos (0-11), E = minute pos (0-11)
 674+ EFB3
 675+ EFB3                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 676+ EFB3 3A 07 F0         LD A, (PlazaLastHour)
 677+ EFB6 BA               CP D
 678+ EFB7 20 05            JR NZ, .pNeedsRedraw
 679+ EFB9 3A 08 F0         LD A, (PlazaLastMin)
 680+ EFBC BB               CP E
 681+ EFBD C8               RET Z                       ; sin cambio → no redibujar
 682+ EFBE
 683+ EFBE              .pNeedsRedraw:
 684+ EFBE 7A               LD A, D
 685+ EFBF 32 07 F0         LD (PlazaLastHour), A
 686+ EFC2 7B               LD A, E
 687+ EFC3 32 08 F0         LD (PlazaLastMin), A
 688+ EFC6
 689+ EFC6                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 690+ EFC6                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 691+ EFC6 DD 21 87 8D      LD IX, PlazaClockPixels
 692+ EFCA FD 21 B4 90      LD IY, PlazaScanAddrs
 693+ EFCE 06 10            LD B, 16
 694+ EFD0              .faceRow:
 695+ EFD0 FD 6E 00         LD L, (IY+0)
 696+ EFD3 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 697+ EFD6 DD 7E 00         LD A, (IX+0)
 698+ EFD9 2F               CPL                         ; des-invertir (dato CPL'd)
 699+ EFDA 77               LD (HL), A                  ; byte izquierdo
 700+ EFDB 23               INC HL
 701+ EFDC DD 7E 01         LD A, (IX+1)
 702+ EFDF 2F               CPL
 703+ EFE0 77               LD (HL), A                  ; byte derecho
 704+ EFE1 DD 23            INC IX
 705+ EFE3 DD 23            INC IX
 706+ EFE5 FD 23            INC IY
 707+ EFE7 FD 23            INC IY
 708+ EFE9 10 E5            DJNZ .faceRow
 709+ EFEB
 710+ EFEB                  ; --- Aguja de horas ---
 711+ EFEB 3A 07 F0         LD A, (PlazaLastHour)
 712+ EFEE 21 F8 EB         LD HL, HourHandPtrs
 713+ EFF1 CD 09 F0         CALL DrawPlazaHandLine
 714+ EFF4
 715+ EFF4                  ; --- Aguja de minutos ---
 716+ EFF4 3A 08 F0         LD A, (PlazaLastMin)
 717+ EFF7 21 14 EB         LD HL, MinHandPtrs
 718+ EFFA CD 09 F0         CALL DrawPlazaHandLine
 719+ EFFD
 720+ EFFD                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 721+ EFFD 21 C2 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 722+ F000 7E               LD A, (HL)
 723+ F001 23               INC HL
 724+ F002 66               LD H, (HL)
 725+ F003 6F               LD L, A                     ; HL = dir VRAM scan line 7
 726+ F004 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 727+ F006 C9               RET
 728+ F007
 729+ F007              ; Variables locales reloj plaza
 730+ F007 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 731+ F008 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 732+ F009
 733+ F009              ; ==============================================================================
 734+ F009              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 735+ F009              ; ==============================================================================
 736+ F009              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 737+ F009              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 738+ F009              ; a posiciones relativas y las busca en PlazaScanAddrs.
 739+ F009              ; ==============================================================================
 740+ F009              DrawPlazaHandLine:
 741+ F009                  ; Indexar en tabla de punteros
 742+ F009 87               ADD A, A
 743+ F00A 4F               LD C, A
 744+ F00B 06 00            LD B, 0
 745+ F00D 09               ADD HL, BC
 746+ F00E 7E               LD A, (HL)
 747+ F00F 23               INC HL
 748+ F010 66               LD H, (HL)
 749+ F011 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 750+ F012
 751+ F012              .pxLoop:
 752+ F012 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 753+ F013 B7               OR A
 754+ F014 C8               RET Z
 755+ F015
 756+ F015                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 757+ F015 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 758+ F016 23               INC HL
 759+ F017 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 760+ F018 23               INC HL
 761+ F019 56               LD D, (HL)                  ; D = mask
 762+ F01A 23               INC HL
 763+ F01B E5               PUSH HL                     ; guardar puntero a siguiente entrada
 764+ F01C
 765+ F01C                  ; --- Calcular scanLine (0-15) ---
 766+ F01C 78               LD A, B
 767+ F01D E6 07            AND $07                     ; scan dentro del char row (0-7)
 768+ F01F CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 769+ F021 28 02            JR Z, .pxIsTop
 770+ F023 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 771+ F025              .pxIsTop:
 772+ F025                  ; A = scanLine (0-15)
 773+ F025
 774+ F025                  ; --- Calcular colOffset (0 o 1) ---
 775+ F025 5F               LD E, A                     ; E = scanLine (guardar)
 776+ F026 79               LD A, C
 777+ F027 E6 1F            AND $1F                     ; extraer columna
 778+ F029 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 779+ F02B 4F               LD C, A                     ; C = colOffset
 780+ F02C
 781+ F02C                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 782+ F02C 7B               LD A, E                     ; A = scanLine
 783+ F02D 87               ADD A, A                    ; *2 (word index)
 784+ F02E 21 B4 90         LD HL, PlazaScanAddrs
 785+ F031 85               ADD A, L
 786+ F032 6F               LD L, A
 787+ F033 30 01            JR NC, .pxNC
 788+ F035 24               INC H
 789+ F036              .pxNC:
 790+ F036 7E               LD A, (HL)
 791+ F037 23               INC HL
 792+ F038 66               LD H, (HL)
 793+ F039 81               ADD A, C                    ; sumar colOffset
 794+ F03A 6F               LD L, A                     ; HL = dir VRAM destino
 795+ F03B
 796+ F03B                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 797+ F03B 7A               LD A, D
 798+ F03C 2F               CPL
 799+ F03D A6               AND (HL)
 800+ F03E 77               LD (HL), A
 801+ F03F
 802+ F03F E1               POP HL                      ; restaurar puntero datos
 803+ F040 18 D0            JR .pxLoop
