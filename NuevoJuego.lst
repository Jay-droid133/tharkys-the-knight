 113+ 0000              ; ==============================================================================
 114+ 0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
 115+ 0000              ; ==============================================================================
 116+ 0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
 117+ 0000              ; Acceso via IX + ENT_* offset.
 118+ 0000              ; ==============================================================================
 119+ 0000
 120+ 0000              ; --- Offsets en la estructura de entidad (16 bytes) ---
 121+ 0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
 122+ 0000              ENT_TYPE        EQU 1               ; Tipo de entidad
 123+ 0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
 124+ 0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
 125+ 0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
 126+ 0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
 127+ 0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
 128+ 0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
 129+ 0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
 130+ 0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
 131+ 0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
 132+ 0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
 133+ 0000              ENT_OLDX        EQU 12              ; X del frame anterior (para XOR erase)
 134+ 0000              ENT_OLDY        EQU 13              ; Y del frame anterior (para XOR erase)
 135+ 0000              ENT_OLDSPRID    EQU 14              ; SpriteID del frame anterior
 136+ 0000              ENT_DRAWX       EQU 15              ; X de dibujo (ajustado para attack offset)
 137+ 0000
 138+ 0000              ENT_SIZE        EQU 16              ; Bytes por entidad
 139+ 0000              NUM_ENTITIES    EQU 17              ; Total de slots
 140+ 0000
 141+ 0000              ; --- Tipos de entidad ---
 142+ 0000              TYPE_NONE       EQU 0               ; Slot inactivo
 143+ 0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 144+ 0000              TYPE_MONSTER   EQU 2               ; Monstruo permanente (rhino, wolf, etc.)
 145+ 0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 146+ 0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
 147+ 0000
 148+ 0000              ; --- Flags de entidad (ENT_FLAGS) ---
 149+ 0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
 150+ 0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
 151+ 0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
 152+ 0000              ENTF_NEWSPAWN   EQU 3               ; bit 3: recien creada (usar freshDraw, no erase)
 153+ 0000
 154+ 0000              ; --- Rangos de slots ---
 155+ 0000              SLOT_PLAYER     EQU 0               ; Slot 0: player
 156+ 0000              SLOT_MONSTER0  EQU 1               ; Slots 1-6: monstruos
 157+ 0000              NUM_MONSTERS   EQU 6
 158+ 0000              SLOT_NASTY0     EQU 7               ; Slots 7-9: nasties (spawn)
 159+ 0000              NUM_NASTIES     EQU 3
 160+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 161+ 0000              NUM_OBJECTS     EQU 4
 162+ 0000
 163+ 0000              ; --- Velocidades de enemigos ---
 164+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 165+ 0000              MONSTER_SPEED    EQU 1               ; Pixels por update (lento, inexorable)
 166+ 0000              MONSTER_MAX_HITS EQU 5              ; Golpes directos para matar un monster
 167+ 0000              MONSTER_KB_SPEED EQU 4              ; Pixels por update durante knockback
 168+ 0000              MONSTER_RESPAWN_DELAY EQU 150       ; Frames de espera antes de respawnear (~3s)
 169+ 0000              MONSTER_STUN_TOTAL EQU 24           ; Frames totales de stun (knockback + pausa)
 170+ 0000              MONSTER_STUN_PAUSE EQU 12           ; Por debajo de este umbral: pausa sin movimiento
 171+ 0000              ENEMY_ANIM_DELAY EQU 8              ; Frames entre cambio de frame
 172+ 0000              ; PREDATOR_SPEED: se lee de PredatorSpeedTable segun DayCycleCount
 173+ 0000              ; Tipos de depredador (bits 0-1 de PredatorTable)
 174+ 0000              PRED_NONE       EQU 0               ; No depredador (movimiento random)
 175+ 0000              PRED_FROM_ABOVE EQU 1               ; Se lanza desde arriba (Eagle, Bat)
 176+ 0000              PRED_FROM_BELOW EQU 2               ; Se lanza desde abajo (Snake, Scorpion)
 177+ 0000              PRED_HORIZONTAL EQU 3               ; Se lanza horizontalmente (Goat, RabidCat)
 178+ 0000              PRED_ALIGN_DIST EQU 12              ; Distancia de alineacion para activar ataque
 179+ 0000              PREDATOR_COOLDOWN EQU 50            ; Frames antes de poder re-atacar (~1s)
 180+ 0000
 181+ 0000              ; --- Stamina / Salud ---
 182+ 0000              STAMINA_MAX         EQU 16          ; Nivel maximo (= 16 scanlines del HUD)
 183+ 0000              HEALTH_MAX          EQU 16
 184+ 0000              STAMINA_DRAIN_RATE  EQU 25          ; Frames de ataque por punto de stamina consumido (~0.5s)
 185+ 0000              STAMINA_REGEN_RATE  EQU 50          ; Frames sin atacar por punto recuperado (~1s)
 186+ 0000              HEALTH_REGEN_RATE   EQU 100         ; Frames por punto de salud regenerado (~2s)
 187+ 0000              STAMINA_THRESHOLD_HIGH EQU 12       ; >= libre (continuo)
 188+ 0000              STAMINA_THRESHOLD_MID  EQU 7        ; >= fixed swing
 189+ 0000              STAMINA_THRESHOLD_LOW  EQU 3        ; >= cooldown corto
 190+ 0000              ; < LOW = cooldown largo + 1 punto recuperado tras cada cooldown
 191+ 0000              ATTACK_COOLDOWN_FRAMES EQU 20       ; Opcion B: frames de cooldown tras atacar (~0.4s)
 192+ 0000              ATTACK_SWING_FRAMES EQU ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT ; Opcion C: = 1 ciclo de animacion
 193+ 0000              SCARE_FLEE_THRESHOLD EQU 100         ; ScareTimer <= este valor → huir (> → pausa dramatica)
 194+ 0000              SCARE_TIMER_BELLS EQU 250           ; Campanadas: ~3s pausa + huida (~150 pausa + 100 huida)
 195+ 0000              SCARE_TIMER_DAWN  EQU 250           ; Amanecer: igual
 196+ 0000              FLEE_PLAYER_AVOID EQU 24            ; Pixeles de proximidad para evitar al player al huir
 197+ 0000              NEAR_ENTRY_DIST EQU 30              ; Distancia minima monster-entrada al restaurar room
 198+ 0000
 199+ 0000              ; --- Spawn system ---
 200+ 0000              SPAWN_INTERVAL  EQU 50              ; Frames entre intentos de spawn (~1s)
 201+ 0000
 202+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 203+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 204+ 0000
 205+ 0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 206+ 0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 207+ 0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 208+ 0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 209+ 0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 210+ 0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 211+ 0000
 212+ 0000              ; ==============================================================================
 213+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 214+ 0000              ; ==============================================================================
 215+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 216+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 217+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 218+ 0000              ;
 219+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 220+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 221+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 222+ 0000              ; ==============================================================================
 223+ 0000
 224+ 0000              ; --- Dimensiones del mapa ---
 225+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 226+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 227+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 228+ 0000
 229+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 230+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 231+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 232+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 233+ 0000
 234+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 235+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 236+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 237+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 238+ 0000
 239+ 0000              ; --- Tipos de tile ---
 240+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 241+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 242+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 243+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 244+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 245+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 246+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 247+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 248+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 249+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 250+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 251+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 252+ 0000
 253+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 254+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 255+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 256+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 257+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 258+ 0000
 259+ 0000              ; --- Posicion inicial del jugador: definida en screen_data.asm (level editor) ---
 260+ 0000
 261+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 262+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 263+ 0000
# file closed: constants.asm
