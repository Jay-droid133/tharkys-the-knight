1945+ F166              ; ==============================================================================
1946+ F166              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
1947+ F166              ; ==============================================================================
1948+ F166              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
1949+ F166              ; Permite posicion sub-char en X (shift bits) Y (scan line).
1950+ F166              ;
1951+ F166              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
1952+ F166              ;     D = pixel Y (0-191, post-HUD ya aplicado).
1953+ F166              ;     E = pixel X (0-255).
1954+ F166              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
1955+ F166              ; Solo XOR de pixels (no toca attrs).
1956+ F166              ; Destruye: AF, BC, DE, HL, IX.
1957+ F166              ; ==============================================================================
1958+ F166              DrawBgSprite16XorAtPixel:
1959+ F166 DD 21 42 89      LD IX, BgSpriteBuffer
1960+ F16A DD 7E 00         LD A, (IX+0)                            ; height_px
1961+ F16D B7               OR A
1962+ F16E C8               RET Z
1963+ F16F 32 D2 F1         LD (.dbsHeight), A
1964+ F172 DD 23            INC IX
1965+ F174 DD 23            INC IX                                  ; -> pixel data
1966+ F176                  ; Shift = E & 7 ; aligned X = E & ~7
1967+ F176 7B               LD A, E
1968+ F177 E6 07            AND $07
1969+ F179 32 D3 F1         LD (.dbsShift), A
1970+ F17C 7B               LD A, E
1971+ F17D E6 F8            AND $F8
1972+ F17F 5F               LD E, A
1973+ F180 CD BA A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1974+ F183              .dbsRow:
1975+ F183 E5               PUSH HL                                 ; save row start
1976+ F184                  ; --- Byte 0 del sprite ---
1977+ F184 DD 7E 00         LD A, (IX+0)
1978+ F187 2F               CPL                                     ; un-invert
1979+ F188 57               LD D, A                                 ; D = sprite byte
1980+ F189 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
1981+ F18B 3A D3 F1         LD A, (.dbsShift)
1982+ F18E B7               OR A
1983+ F18F 28 07            JR Z, .dbsNoShift0
1984+ F191 47               LD B, A
1985+ F192              .dbsShift0Loop:
1986+ F192 CB 3A            SRL D
1987+ F194 CB 1B            RR E
1988+ F196 10 FA            DJNZ .dbsShift0Loop
1989+ F198              .dbsNoShift0:
1990+ F198 7A               LD A, D
1991+ F199 AE               XOR (HL)
1992+ F19A 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
1993+ F19B 23               INC HL
1994+ F19C 4B               LD C, E                                 ; C = carry para siguiente byte
1995+ F19D                  ; --- Byte 1 del sprite ---
1996+ F19D DD 7E 01         LD A, (IX+1)
1997+ F1A0 2F               CPL
1998+ F1A1 57               LD D, A
1999+ F1A2 1E 00            LD E, 0
2000+ F1A4 3A D3 F1         LD A, (.dbsShift)
2001+ F1A7 B7               OR A
2002+ F1A8 28 07            JR Z, .dbsNoShift1
2003+ F1AA 47               LD B, A
2004+ F1AB              .dbsShift1Loop:
2005+ F1AB CB 3A            SRL D
2006+ F1AD CB 1B            RR E
2007+ F1AF 10 FA            DJNZ .dbsShift1Loop
2008+ F1B1              .dbsNoShift1:
2009+ F1B1 7A               LD A, D
2010+ F1B2 B1               OR C                                    ; combinar con carry de byte 0
2011+ F1B3 AE               XOR (HL)
2012+ F1B4 77               LD (HL), A
2013+ F1B5 23               INC HL
2014+ F1B6 4B               LD C, E                                 ; carry para byte final
2015+ F1B7                  ; --- Byte final (solo si shift>0) ---
2016+ F1B7 3A D3 F1         LD A, (.dbsShift)
2017+ F1BA B7               OR A
2018+ F1BB 28 03            JR Z, .dbsNoFinal
2019+ F1BD 79               LD A, C
2020+ F1BE AE               XOR (HL)
2021+ F1BF 77               LD (HL), A
2022+ F1C0              .dbsNoFinal:
2023+ F1C0 E1               POP HL                                  ; restore row start
2024+ F1C1 CD 26 9E         CALL NextPixelLine
2025+ F1C4 DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
2026+ F1C6 DD 23            INC IX
2027+ F1C8 3A D2 F1         LD A, (.dbsHeight)
2028+ F1CB 3D               DEC A
2029+ F1CC 32 D2 F1         LD (.dbsHeight), A
2030+ F1CF 20 B2            JR NZ, .dbsRow
2031+ F1D1 C9               RET
2032+ F1D2 00           .dbsHeight: DEFB 0
2033+ F1D3 00           .dbsShift:  DEFB 0
