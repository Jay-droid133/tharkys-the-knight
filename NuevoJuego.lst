 304+ 9B04              ; ==============================================================================
 305+ 9B04              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9B04              ; ==============================================================================
 307+ 9B04              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9B04              ; Se llama ANTES de pintar el sprite.
 309+ 9B04              ;
 310+ 9B04              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9B04              ;          IX = puntero al sprite (para leer width/height)
 312+ 9B04              ; ==============================================================================
 313+ 9B04              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9B04              ; ==============================================================================
 315+ 9B04              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9B04              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9B04              ; ==============================================================================
 318+ 9B04              CalcEntityAttrSize:
 319+ 9B04                  ; Paging inline (ver nota en DrawSprite)
 320+ 9B04 3A 82 8D         LD A, (CurrentPaging)
 321+ 9B07 E6 F8            AND $F8
 322+ 9B09 F6 06            OR 6
 323+ 9B0B 32 82 8D         LD (CurrentPaging), A
 324+ 9B0E 01 FD 7F         LD BC, $7FFD
 325+ 9B11 ED 79            OUT (C), A
 326+ 9B13 CD 24 9B         CALL _CalcEntityAttrSizeImpl
 327+ 9B16 3A 82 8D         LD A, (CurrentPaging)
 328+ 9B19 E6 F8            AND $F8
 329+ 9B1B 32 82 8D         LD (CurrentPaging), A
 330+ 9B1E 01 FD 7F         LD BC, $7FFD
 331+ 9B21 ED 79            OUT (C), A
 332+ 9B23 C9               RET
 333+ 9B24
 334+ 9B24              _CalcEntityAttrSizeImpl:
 335+ 9B24 DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9B27 47               LD B, A
 337+ 9B28 7B               LD A, E
 338+ 9B29 E6 07            AND 7
 339+ 9B2B 28 01            JR Z, .ceNoExtra
 340+ 9B2D 04               INC B
 341+ 9B2E              .ceNoExtra:
 342+ 9B2E 78               LD A, B
 343+ 9B2F 32 D5 9B         LD (EntityAttrW), A
 344+ 9B32 7A               LD A, D
 345+ 9B33 E6 07            AND 7
 346+ 9B35 4F               LD C, A
 347+ 9B36 DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9B39 81               ADD A, C
 349+ 9B3A C6 07            ADD A, 7
 350+ 9B3C 0F               RRCA
 351+ 9B3D 0F               RRCA
 352+ 9B3E 0F               RRCA
 353+ 9B3F E6 1F            AND $1F
 354+ 9B41 32 D6 9B         LD (EntityAttrH), A
 355+ 9B44 C9               RET
