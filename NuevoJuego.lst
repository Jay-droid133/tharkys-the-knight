   2+ 6DB8              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 6DB8              ; ==============================================================================
   4+ 6DB8              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 6DB8              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 6DB8              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 6DB8              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 6DB8              ; correspondiente desde CheckPickupCollect.
   9+ 6DB8              ;
  10+ 6DB8              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 6DB8              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 6DB8              ;
  13+ 6DB8              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 6DB8              ; Bank 0/2 quedan limpios.
  15+ 6DB8              ; ==============================================================================
  16+ 6DB8
  17+ 6DB8              ; ==============================================================================
  18+ 6DB8              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 6DB8              ; ==============================================================================
  20+ 6DB8              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 6DB8              ; el cambio via cache .dlhLast.
  22+ 6DB8              ; ==============================================================================
  23+ 6DB8              GiveLife:
  24+ 6DB8 3A 83 82         LD A, (PlayerLives)
  25+ 6DBB FE 05            CP PLAYER_LIVES_MAX
  26+ 6DBD D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 6DBE 3C               INC A
  28+ 6DBF 32 83 82         LD (PlayerLives), A
  29+ 6DC2 C9               RET
  30+ 6DC3
  31+ 6DC3              ; ==============================================================================
  32+ 6DC3              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 6DC3              ; ==============================================================================
  34+ 6DC3              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 6DC3              ; ==============================================================================
  36+ 6DC3              GiveHealth:
  37+ 6DC3 3A 6B B6         LD A, (PlayerHealth)
  38+ 6DC6 C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 6DC8 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 6DCA FE 11            CP HEALTH_MAX + 1
  41+ 6DCC 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 6DCE              .ghCap:
  43+ 6DCE 3E 10            LD A, HEALTH_MAX
  44+ 6DD0              .ghStore:
  45+ 6DD0 32 6B B6         LD (PlayerHealth), A
  46+ 6DD3 C9               RET
  47+ 6DD4
  48+ 6DD4              ; ==============================================================================
  49+ 6DD4              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ 6DD4              ; ==============================================================================
  51+ 6DD4              GiveStamina:
  52+ 6DD4 3A 6C B6         LD A, (PlayerStamina)
  53+ 6DD7 C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ 6DD9 38 04            JR C, .gsCap
  55+ 6DDB FE 11            CP STAMINA_MAX + 1
  56+ 6DDD 38 02            JR C, .gsStore
  57+ 6DDF              .gsCap:
  58+ 6DDF 3E 10            LD A, STAMINA_MAX
  59+ 6DE1              .gsStore:
  60+ 6DE1 32 6C B6         LD (PlayerStamina), A
  61+ 6DE4 C9               RET
  62+ 6DE5
  63+ 6DE5              ; ==============================================================================
  64+ 6DE5              ; ROULETTE — datos
  65+ 6DE5              ; ==============================================================================
  66+ 6DE5              ; RouletteOrder: secuencia de type ids que recorre el ciclado. Tunable por
  67+ 6DE5              ; el usuario — añadir/quitar/reordenar entries y rebuild. La longitud se
  68+ 6DE5              ; calcula sola via ROULETTE_ORDER_LEN.
  69+ 6DE5              RouletteOrder:
  70+ 6DE5 01               DEFB ROUL_LIFE
  71+ 6DE6 02               DEFB ROUL_HEALTH
  72+ 6DE7 03               DEFB ROUL_STAMINA
  73+ 6DE8 04               DEFB ROUL_RAYO
  74+ 6DE9 05               DEFB ROUL_CARACOL
  75+ 6DEA 07               DEFB ROUL_COMPASS
  76+ 6DEB              RouletteOrderEnd:
  77+ 6DEB              ROULETTE_ORDER_LEN  EQU RouletteOrderEnd - RouletteOrder
  78+ 6DEB
  79+ 6DEB              ; RouletteTypePtrs: tabla de lookup type id → BgGfx ptr. Indexada por
  80+ 6DEB              ; (type-1)*2 — el id 0 esta sin usar (no aparece en RouletteOrder).
  81+ 6DEB              RouletteTypePtrs:
  82+ 6DEB 6E CC            DEFW BgGfx_life                                     ; ROUL_LIFE     = 1
  83+ 6DED 53 EE            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH   = 2
  84+ 6DEF 7C EE            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA  = 3
  85+ 6DF1 A5 EE            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO     = 4
  86+ 6DF3 CE EE            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  87+ 6DF5 F7 EE            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  88+ 6DF7 20 EF            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
  89+ 6DF9
  90+ 6DF9              ; ==============================================================================
  91+ 6DF9              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  92+ 6DF9              ; ==============================================================================
  93+ 6DF9              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  94+ 6DF9              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  95+ 6DF9              ; ==============================================================================
  96+ 6DF9              GetRoulettePtrByIdx:
  97+ 6DF9 21 E5 6D         LD HL, RouletteOrder
  98+ 6DFC 5F               LD E, A
  99+ 6DFD 16 00            LD D, 0
 100+ 6DFF 19               ADD HL, DE
 101+ 6E00 7E               LD A, (HL)                              ; A = type id (1..5)
 102+ 6E01 3D               DEC A                                   ; idx 0-based para tabla ptrs
 103+ 6E02 26 00            LD H, 0
 104+ 6E04 6F               LD L, A
 105+ 6E05 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 106+ 6E06 11 EB 6D         LD DE, RouletteTypePtrs
 107+ 6E09 19               ADD HL, DE
 108+ 6E0A 5E               LD E, (HL)
 109+ 6E0B 23               INC HL
 110+ 6E0C 56               LD D, (HL)
 111+ 6E0D EB               EX DE, HL                               ; HL = ptr
 112+ 6E0E C9               RET
 113+ 6E0F
 114+ 6E0F              ; ==============================================================================
 115+ 6E0F              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 116+ 6E0F              ;                                 store first attr byte en RandomSynthAttr.
 117+ 6E0F              ; ==============================================================================
 118+ 6E0F              LoadSynthSpriteAndExtractAttr:
 119+ 6E0F 22 B6 5F         LD (RandomSynthPtr), HL
 120+ 6E12 3E 03            LD A, 3
 121+ 6E14 CD 7A 6A         CALL LoadBgSpriteToBuffer
 122+ 6E17 DD 21 9A 89      LD IX, BgSpriteBuffer
 123+ 6E1B CD 3A D6         CALL SkipPixelData                      ; IX @ tintPaper
 124+ 6E1E DD 23            INC IX                                  ; @ attr_h
 125+ 6E20 DD 23            INC IX                                  ; @ attr_w
 126+ 6E22 DD 23            INC IX                                  ; @ attr_data
 127+ 6E24 DD 7E 00         LD A, (IX+0)
 128+ 6E27 32 BB 5F         LD (RandomSynthAttr), A
 129+ 6E2A C9               RET
 130+ 6E2B
 131+ 6E2B              ; ==============================================================================
 132+ 6E2B              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 133+ 6E2B              ; ==============================================================================
 134+ 6E2B              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 135+ 6E2B              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 136+ 6E2B              ; carga sprite nuevo, dibuja, repaint attrs.
 137+ 6E2B              ; ==============================================================================
 138+ 6E2B              UpdateRoulette:
 139+ 6E2B 3A BC 5F         LD A, (RouletteActive)
 140+ 6E2E B7               OR A
 141+ 6E2F C8               RET Z
 142+ 6E30 3A B4 5F         LD A, (RandomSynthMapX)
 143+ 6E33 FE FE            CP $FE
 144+ 6E35 C8               RET Z                                   ; recogido / inactivo: no ciclar
 145+ 6E36
 146+ 6E36                  ; Tick frame counter
 147+ 6E36 21 BE 5F         LD HL, RouletteFrameCounter
 148+ 6E39 35               DEC (HL)
 149+ 6E3A C0               RET NZ                                  ; aun no toca avanzar
 150+ 6E3B
 151+ 6E3B                  ; --- Counter expirado: ciclar al siguiente tipo ---
 152+ 6E3B 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 153+ 6E3D 32 BE 5F         LD (RouletteFrameCounter), A
 154+ 6E40
 155+ 6E40                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 156+ 6E40 2A B6 5F         LD HL, (RandomSynthPtr)
 157+ 6E43 3E 03            LD A, 3
 158+ 6E45 CD 7A 6A         CALL LoadBgSpriteToBuffer
 159+ 6E48 3A B8 5F         LD A, (RandomSynthCharX)
 160+ 6E4B 47               LD B, A
 161+ 6E4C 3A B9 5F         LD A, (RandomSynthCharY)
 162+ 6E4F 4F               LD C, A
 163+ 6E50 DD 21 9A 89      LD IX, BgSpriteBuffer
 164+ 6E54 CD 1A DE         CALL DrawBgSpriteXOR
 165+ 6E57
 166+ 6E57                  ; Avanzar idx con wrap
 167+ 6E57 3A BD 5F         LD A, (RouletteIdx)
 168+ 6E5A 3C               INC A
 169+ 6E5B FE 06            CP ROULETTE_ORDER_LEN
 170+ 6E5D 38 01            JR C, .urWrapOk
 171+ 6E5F AF               XOR A
 172+ 6E60              .urWrapOk:
 173+ 6E60 32 BD 5F         LD (RouletteIdx), A
 174+ 6E63
 175+ 6E63                  ; Lookup nuevo tipo, cargar sprite, extraer attr
 176+ 6E63 CD F9 6D         CALL GetRoulettePtrByIdx                ; HL = nuevo ptr
 177+ 6E66 CD 0F 6E         CALL LoadSynthSpriteAndExtractAttr
 178+ 6E69
 179+ 6E69                  ; Dibujar sprite nuevo
 180+ 6E69 3A B8 5F         LD A, (RandomSynthCharX)
 181+ 6E6C 47               LD B, A
 182+ 6E6D 3A B9 5F         LD A, (RandomSynthCharY)
 183+ 6E70 4F               LD C, A
 184+ 6E71 DD 21 9A 89      LD IX, BgSpriteBuffer
 185+ 6E75 CD 1A DE         CALL DrawBgSpriteXOR
 186+ 6E78
 187+ 6E78                  ; Repaint attrs en VRAM
 188+ 6E78 C3 E6 6F         JP PaintSynthPickupAttrs                ; tail call
 189+ 6E7B
 190+ 6E7B              ; ==============================================================================
 191+ 6E7B              ; ApplyRayoBuff - speed boost 1.5x durante 15s + player CYAN | $40
 192+ 6E7B              ; ==============================================================================
 193+ 6E7B              ; "Last wins": llamar de nuevo resetea timer + override estado actual.
 194+ 6E7B              ; ==============================================================================
 195+ 6E7B              ApplyRayoBuff:
 196+ 6E7B 3E 06            LD A, SPEED_BUFF_RAYO_RUN
 197+ 6E7D 32 7A 82         LD (PlayerSpeedRun), A
 198+ 6E80 3E 03            LD A, SPEED_BUFF_RAYO_FIGHT
 199+ 6E82 32 7B 82         LD (PlayerSpeedFight), A
 200+ 6E85 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 201+ 6E88 22 7C 82         LD (SpeedBuffTimer), HL
 202+ 6E8B 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 203+ 6E8D 32 7E 82         LD (SpeedBuffType), A
 204+ 6E90 3E 45            LD A, SPEED_BUFF_RAYO_ATTR
 205+ 6E92 32 50 81         LD (EntityTable + ENT_ATTR), A
 206+ 6E95 C9               RET
 207+ 6E96
 208+ 6E96              ; ==============================================================================
 209+ 6E96              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 210+ 6E96              ; ==============================================================================
 211+ 6E96              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 212+ 6E96              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 213+ 6E96              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 214+ 6E96              ; ==============================================================================
 215+ 6E96              ApplyMushroomBuff:
 216+ 6E96 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 217+ 6E99 22 7F 82         LD (MushroomLockTimer), HL
 218+ 6E9C 3E 43            LD A, MUSHROOM_LOCK_ATTR
 219+ 6E9E 32 50 81         LD (EntityTable + ENT_ATTR), A
 220+ 6EA1 C9               RET
 221+ 6EA2
 222+ 6EA2              ; ==============================================================================
 223+ 6EA2              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 224+ 6EA2              ; ==============================================================================
 225+ 6EA2              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 226+ 6EA2              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 227+ 6EA2              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 228+ 6EA2              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 229+ 6EA2              ; si no, restaura WHITE | $40.
 230+ 6EA2              ; ==============================================================================
 231+ 6EA2              UpdateMushroomBuff:
 232+ 6EA2 2A 7F 82         LD HL, (MushroomLockTimer)
 233+ 6EA5 7C               LD A, H
 234+ 6EA6 B5               OR L
 235+ 6EA7 C8               RET Z                               ; sin debuff
 236+ 6EA8 2B               DEC HL
 237+ 6EA9 22 7F 82         LD (MushroomLockTimer), HL
 238+ 6EAC 7C               LD A, H
 239+ 6EAD B5               OR L
 240+ 6EAE 20 0B            JR NZ, .umbActive
 241+ 6EB0                  ; --- Justo expirado: restaurar segun estado de speed buff ---
 242+ 6EB0 3A 7E 82         LD A, (SpeedBuffType)
 243+ 6EB3 B7               OR A
 244+ 6EB4 C0               RET NZ                              ; speed buff activo: ya pinto color, no tocar
 245+ 6EB5 3E 47            LD A, WHITE | $40
 246+ 6EB7 32 50 81         LD (EntityTable + ENT_ATTR), A
 247+ 6EBA C9               RET
 248+ 6EBB              .umbActive:
 249+ 6EBB 3E 43            LD A, MUSHROOM_LOCK_ATTR
 250+ 6EBD 32 50 81         LD (EntityTable + ENT_ATTR), A
 251+ 6EC0 C9               RET
 252+ 6EC1
 253+ 6EC1              ; ==============================================================================
 254+ 6EC1              ; ApplyCaracolBuff - speed slow 0.5x durante 10s + player GREEN | $40
 255+ 6EC1              ; ==============================================================================
 256+ 6EC1              ApplyCaracolBuff:
 257+ 6EC1 3E 02            LD A, SPEED_BUFF_CARACOL_RUN
 258+ 6EC3 32 7A 82         LD (PlayerSpeedRun), A
 259+ 6EC6 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 260+ 6EC8 32 7B 82         LD (PlayerSpeedFight), A
 261+ 6ECB 21 7D 00         LD HL, SPEED_BUFF_CARACOL_FRAMES
 262+ 6ECE 22 7C 82         LD (SpeedBuffTimer), HL
 263+ 6ED1 3E 02            LD A, SPEED_BUFF_TYPE_CARACOL
 264+ 6ED3 32 7E 82         LD (SpeedBuffType), A
 265+ 6ED6 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR
 266+ 6ED8 32 50 81         LD (EntityTable + ENT_ATTR), A
 267+ 6EDB C9               RET
 268+ 6EDC
 269+ 6EDC              ; ==============================================================================
 270+ 6EDC              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 271+ 6EDC              ; ==============================================================================
 272+ 6EDC              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 273+ 6EDC              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 274+ 6EDC              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 275+ 6EDC              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 276+ 6EDC              ; ==============================================================================
 277+ 6EDC              UpdateSpeedBuff:
 278+ 6EDC 3A 7E 82         LD A, (SpeedBuffType)
 279+ 6EDF B7               OR A
 280+ 6EE0 C8               RET Z                               ; sin buff activo
 281+ 6EE1                  ; Tick 16-bit timer.
 282+ 6EE1 2A 7C 82         LD HL, (SpeedBuffTimer)
 283+ 6EE4 2B               DEC HL
 284+ 6EE5 22 7C 82         LD (SpeedBuffTimer), HL
 285+ 6EE8 7C               LD A, H
 286+ 6EE9 B5               OR L
 287+ 6EEA 28 11            JR Z, .usbExpire
 288+ 6EEC                  ; Buff aun activo: re-aplicar color player segun tipo.
 289+ 6EEC 3A 7E 82         LD A, (SpeedBuffType)
 290+ 6EEF FE 01            CP SPEED_BUFF_TYPE_RAYO
 291+ 6EF1 20 04            JR NZ, .usbCaracol
 292+ 6EF3 3E 45            LD A, SPEED_BUFF_RAYO_ATTR
 293+ 6EF5 18 02            JR .usbWriteAttr
 294+ 6EF7              .usbCaracol:
 295+ 6EF7 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR
 296+ 6EF9              .usbWriteAttr:
 297+ 6EF9 32 50 81         LD (EntityTable + ENT_ATTR), A
 298+ 6EFC C9               RET
 299+ 6EFD              .usbExpire:
 300+ 6EFD                  ; Buff terminado: reset speeds, type, color player.
 301+ 6EFD 3E 04            LD A, SPEED_RUN
 302+ 6EFF 32 7A 82         LD (PlayerSpeedRun), A
 303+ 6F02 3E 02            LD A, SPEED_FIGHT
 304+ 6F04 32 7B 82         LD (PlayerSpeedFight), A
 305+ 6F07 AF               XOR A
 306+ 6F08 32 7E 82         LD (SpeedBuffType), A
 307+ 6F0B 3E 47            LD A, WHITE | $40
 308+ 6F0D 32 50 81         LD (EntityTable + ENT_ATTR), A
 309+ 6F10 C9               RET
