 561+ A116                  ; --- Compartido: CalcDraw + skip check + erase + draw + save ---
 562+ A116              .peCalcAndDraw:
 563+ A116 CD 80 A4         CALL CalcDrawX
 564+ A119 CD 18 9F         CALL ComputeEnemyDrawY              ; → EnemyDrawY = POSY o POSY+1 (monster+techo)
 565+ A11C
 566+ A11C                  ; --- Skip si nada cambio ---
 567+ A11C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 568+ A11F DD BE 0C         CP (IX+ENT_OLDX)
 569+ A122 20 0F            JR NZ, .peDoErase
 570+ A124 3A DF 82         LD A, (EnemyDrawY)
 571+ A127 DD BE 0D         CP (IX+ENT_OLDY)
 572+ A12A 20 07            JR NZ, .peDoErase
 573+ A12C DD 7E 00         LD A, (IX+ENT_SPRITEID)
 574+ A12F DD BE 0E         CP (IX+ENT_OLDSPRID)
 575+ A132 C8               RET Z                               ; Nada cambio → skip todo
