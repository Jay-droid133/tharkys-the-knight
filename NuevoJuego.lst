 157  7828
 158  7828                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 159  7828                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 160  7828                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7
 161  7828                  ; aprovechando que está holgado tras mover tambien bg_gfx_c stuff allí.
 162  7828                  ; (Slot 1 ya tiene headroom limpio tras Phase A — el thunk no causa
 163  7828                  ; overflow ni siquiera estando antes de room_routes.)
 164  7828                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: code/game_over_tomb_thunk.asm
   1+ 7828              ; ==============================================================================
   2+ 7828              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 7828              ; ==============================================================================
   4+ 7828              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 7828              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 7828              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 7828              ;
   8+ 7828              ; Estrategia:
   9+ 7828              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 7828              ;      bank 0 paginado en slot 3.
  11+ 7828              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 7828              ;      seguro hacer la conmutación aquí).
  13+ 7828              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 7828              ;   4. Body retorna → restauramos bank 0.
  15+ 7828              ;
  16+ 7828              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 7828              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 7828              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 7828              ; ==============================================================================
  20+ 7828
  21+ 7828              DrawTombstone2xCentered:
  22+ 7828                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 7828 21 72 D9         LD HL, BgGfx_little_house_cemetery
  24+ 782B 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 782D CD C2 6A         CALL LoadBgSpriteToBuffer
  26+ 7830
  27+ 7830                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 7830 F3               DI
  29+ 7831 3A 82 8D         LD A, (CurrentPaging)
  30+ 7834 E6 F8            AND $F8
  31+ 7836 F6 07            OR 7
  32+ 7838 32 82 8D         LD (CurrentPaging), A
  33+ 783B 01 FD 7F         LD BC, $7FFD
  34+ 783E ED 79            OUT (C), A
  35+ 7840
  36+ 7840                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 7840 CD F7 D9         CALL DrawTombstone2xBody
  38+ 7843
  39+ 7843                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 7843 3A 82 8D         LD A, (CurrentPaging)
  41+ 7846 E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 7848 32 82 8D         LD (CurrentPaging), A
  43+ 784B 01 FD 7F         LD BC, $7FFD
  44+ 784E ED 79            OUT (C), A
  45+ 7850
  46+ 7850                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 7850 3A 9A 81         LD A, (StartupComplete)
  48+ 7853 B7               OR A
  49+ 7854 C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 7855 FB               EI
  51+ 7856 C9               RET
  52+ 7857
