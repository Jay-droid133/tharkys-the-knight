4201+ B9FB
4202+ B9FB 00           .ecXlo: DEFB 0
4203+ B9FC 00           .ecYlo: DEFB 0
4204+ B9FD 00           .ecWc:  DEFB 0
4205+ B9FE 00           .ecHc:  DEFB 0
4206+ B9FF
4207+ B9FF              ; ==============================================================================
4208+ B9FF              ; CountActiveNasties / CountActiveMonsters
4209+ B9FF              ; ==============================================================================
4210+ B9FF              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4211+ B9FF              ; Ambas usan _CountSlots internamente.
4212+ B9FF              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4213+ B9FF              ; ==============================================================================
4214+ B9FF              CountActiveNasties:
4215+ B9FF 21 4D 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4216+ BA02 06 04            LD B, NUM_NASTIES
4217+ BA04 18 05            JR _CountSlots
4218+ BA06
4219+ BA06              CountActiveMonsters:
4220+ BA06 21 ED 80         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4221+ BA09 06 06            LD B, NUM_MONSTERS
4222+ BA0B
4223+ BA0B              _CountSlots:
4224+ BA0B 0E 00            LD C, 0                         ; Contador
4225+ BA0D              .countLoop:
4226+ BA0D 7E               LD A, (HL)
4227+ BA0E B7               OR A
4228+ BA0F 28 16            JR Z, .countNext                ; Slot vacio: no contar
4229+ BA11                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4230+ BA11 D5               PUSH DE
4231+ BA12 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4232+ BA15 19               ADD HL, DE
4233+ BA16 7E               LD A, (HL)
4234+ BA17 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4235+ BA19 D1               POP DE
4236+ BA1A FE 03            CP STATE_DYING
4237+ BA1C 28 09            JR Z, .countNext
4238+ BA1E FE 04            CP STATE_SPAWNING
4239+ BA20 28 05            JR Z, .countNext
4240+ BA22 FE 05            CP STATE_SCARED
4241+ BA24 28 01            JR Z, .countNext
4242+ BA26 0C               INC C
4243+ BA27              .countNext:
4244+ BA27 11 10 00         LD DE, ENT_SIZE
4245+ BA2A 19               ADD HL, DE
4246+ BA2B 10 E0            DJNZ .countLoop
4247+ BA2D 79               LD A, C
4248+ BA2E C9               RET
4249+ BA2F
4250+ BA2F              ; ==============================================================================
4251+ BA2F              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4252+ BA2F              ; ==============================================================================
4253+ BA2F              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4254+ BA2F              ; ==============================================================================
4255+ BA2F              TrySpawnNasty:
4256+ BA2F                  ; Cooldown tras cambio de pantalla / inicio
4257+ BA2F 3A 0C 82         LD A, (SpawnTimer)
4258+ BA32 B7               OR A
4259+ BA33 28 05            JR Z, .spawnReady
4260+ BA35 3D               DEC A
4261+ BA36 32 0C 82         LD (SpawnTimer), A
4262+ BA39 C9               RET
4263+ BA3A              .spawnReady:
4264+ BA3A                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4265+ BA3A 3A AC B8         LD A, (ScareTimer)
4266+ BA3D B7               OR A
4267+ BA3E C0               RET NZ
4268+ BA3F                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4269+ BA3F                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4270+ BA3F                  ; rellenamos con nasties crepusculares hasta A2.
4271+ BA3F 3A FE 81         LD A, (MonsterTrappedFlags)
4272+ BA42 E6 07            AND $07
4273+ BA44 FE 07            CP $07
4274+ BA46 28 0E            JR Z, .spawnIgnoreNightBlocks
4275+ BA48                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4276+ BA48                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4277+ BA48                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4278+ BA48                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4279+ BA48 3A 16 B6         LD A, (MonstersActive)
4280+ BA4B B7               OR A
4281+ BA4C C0               RET NZ
4282+ BA4D                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4283+ BA4D 3A 84 DD         LD A, (CurrentTimeOfDay)
4284+ BA50 FE 04            CP 4                        ; N2
4285+ BA52 C8               RET Z
4286+ BA53 FE 05            CP 5                        ; A1
4287+ BA55 C8               RET Z
4288+ BA56              .spawnIgnoreNightBlocks:
4289+ BA56                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4290+ BA56                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4291+ BA56                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4292+ BA56                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4293+ BA56 DD 21 4C 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4294+ BA5A 06 04            LD B, NUM_NASTIES
4295+ BA5C              .spawnLoop:
4296+ BA5C C5               PUSH BC
4297+ BA5D DD 7E 01         LD A, (IX+ENT_TYPE)
