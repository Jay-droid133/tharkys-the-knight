 124+ EBF6              ; UpdateGameClock
 125+ EBF6              ; ==============================================================================
 126+ EBF6              UpdateGameClock:
 127+ EBF6 3A BB 82         LD A, (TimeFrozen)
 128+ EBF9 B7               OR A
 129+ EBFA C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EBFB 21 5C EA         LD HL, GameSubMinute
 131+ EBFE 34               INC (HL)
 132+ EBFF 3A 5F EA         LD A, (SubMinuteMax)
 133+ EC02 BE               CP (HL)
 134+ EC03 C0               RET NZ
 135+ EC04
 136+ EC04 AF               XOR A
 137+ EC05 32 5C EA         LD (GameSubMinute), A
 138+ EC08 21 5D EA         LD HL, GameMinutes
 139+ EC0B 34               INC (HL)
 140+ EC0C                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EC0C                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EC0C 3A 5D EA         LD A, (GameMinutes)
 143+ EC0F FE 3C            CP 60
 144+ EC11 C0               RET NZ
 145+ EC12
 146+ EC12 AF               XOR A
 147+ EC13 32 5D EA         LD (GameMinutes), A
 148+ EC16 21 5E EA         LD HL, GameHours
 149+ EC19 34               INC (HL)
 150+ EC1A 7E               LD A, (HL)
 151+ EC1B FE 18            CP 24
 152+ EC1D 20 04            JR NZ, .checkPhase
 153+ EC1F AF               XOR A
 154+ EC20 32 5E EA         LD (GameHours), A
 155+ EC23
 156+ EC23              .checkPhase:
 157+ EC23 3A 5E EA         LD A, (GameHours)
 158+ EC26 21 68 EA         LD HL, PhaseTable
 159+ EC29 06 07            LD B, 7
 160+ EC2B              .phaseLoop:
 161+ EC2B BE               CP (HL)
 162+ EC2C 28 05            JR Z, .phaseFound
 163+ EC2E 23               INC HL
 164+ EC2F 23               INC HL
 165+ EC30 10 F9            DJNZ .phaseLoop
 166+ EC32 C9               RET
 167+ EC33              .phaseFound:
 168+ EC33 23               INC HL
 169+ EC34 7E               LD A, (HL)
 170+ EC35 F5               PUSH AF
 171+ EC36 CD FE E3         CALL SetTimeOfDay
 172+ EC39 F1               POP AF
 173+ EC3A FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EC3C C0               RET NZ
 175+ EC3D                  ; Nuevo dia: incrementar ciclo
 176+ EC3D 21 24 BD         LD HL, DayCycleCount
 177+ EC40 34               INC (HL)
 178+ EC41 C9               RET
