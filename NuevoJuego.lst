 498  9DC2                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9DC2              ; ==============================================================================
   2+ 9DC2              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DC2              ; ==============================================================================
   4+ 9DC2              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DC2              ; - Game loop per-entity: erase → update → draw
   6+ 9DC2              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DC2              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DC2              ; - XOR draw/erase (una sola rutina)
   9+ 9DC2              ; ==============================================================================
  10+ 9DC2
  11+ 9DC2              ; ==============================================================================
  12+ 9DC2              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DC2              ; ==============================================================================
  14+ 9DC2              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DC2              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DC2              ; ==============================================================================
  17+ 9DC2              ReadInput:
  18+ 9DC2 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DC4 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DC6
  21+ 9DC6                  ; -- 1. QAOP --
  22+ 9DC6 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC9 ED 78            IN A, (C)
  24+ 9DCB CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DCD 20 02            JR NZ, .no_q
  26+ 9DCF CB C2            SET 0, D
  27+ 9DD1              .no_q:
  28+ 9DD1 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DD4 ED 78            IN A, (C)
  30+ 9DD6 CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD8 20 02            JR NZ, .no_a
  32+ 9DDA CB CA            SET 1, D
  33+ 9DDC              .no_a:
  34+ 9DDC 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DDF ED 78            IN A, (C)
  36+ 9DE1 CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DE3 20 02            JR NZ, .no_o
  38+ 9DE5 CB DA            SET 3, D
  39+ 9DE7              .no_o:
  40+ 9DE7 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE9 20 02            JR NZ, .no_p
  42+ 9DEB CB D2            SET 2, D
  43+ 9DED              .no_p:
  44+ 9DED
  45+ 9DED                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DED                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DED DB 1F            IN A, (31)
  48+ 9DEF 4F               LD C, A             ; guardar para fire
  49+ 9DF0 CB 5F            BIT 3, A            ; Up
  50+ 9DF2 28 02            JR Z, .no_k_up
  51+ 9DF4 CB C2            SET 0, D
  52+ 9DF6              .no_k_up:
  53+ 9DF6 CB 57            BIT 2, A            ; Down
  54+ 9DF8 28 02            JR Z, .no_k_down
  55+ 9DFA CB CA            SET 1, D
  56+ 9DFC              .no_k_down:
  57+ 9DFC CB 4F            BIT 1, A            ; Left
  58+ 9DFE 28 02            JR Z, .no_k_left
  59+ 9E00 CB DA            SET 3, D
  60+ 9E02              .no_k_left:
  61+ 9E02 CB 47            BIT 0, A            ; Right
  62+ 9E04 28 02            JR Z, .no_k_right
  63+ 9E06 CB D2            SET 2, D
  64+ 9E08              .no_k_right:
  65+ 9E08 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E0A 28 02            JR Z, .no_k_fire
  67+ 9E0C CB C3            SET 0, E
  68+ 9E0E              .no_k_fire:
  69+ 9E0E
  70+ 9E0E                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E0E                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E0E 01 FE F7         LD BC, $F7FE
  73+ 9E11 ED 78            IN A, (C)
  74+ 9E13 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E15 20 02            JR NZ, .no_s1_up
  76+ 9E17 CB C2            SET 0, D
  77+ 9E19              .no_s1_up:
  78+ 9E19 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E1B 20 02            JR NZ, .no_s1_down
  80+ 9E1D CB CA            SET 1, D
  81+ 9E1F              .no_s1_down:
  82+ 9E1F CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E21 20 02            JR NZ, .no_s1_left
  84+ 9E23 CB DA            SET 3, D
  85+ 9E25              .no_s1_left:
  86+ 9E25 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E27 20 02            JR NZ, .no_s1_right
  88+ 9E29 CB D2            SET 2, D
  89+ 9E2B              .no_s1_right:
  90+ 9E2B CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E2D 20 02            JR NZ, .no_s1_fire
  92+ 9E2F CB C3            SET 0, E
  93+ 9E31              .no_s1_fire:
  94+ 9E31
  95+ 9E31                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E31 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E34 ED 78            IN A, (C)
  98+ 9E36 CB 47            BIT 0, A            ; SPACE
  99+ 9E38 20 02            JR NZ, .no_space
 100+ 9E3A CB C3            SET 0, E
 101+ 9E3C              .no_space:
 102+ 9E3C
 103+ 9E3C                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E3C 7B               LD A, E
 105+ 9E3D 32 B4 82         LD (InputFire), A
 106+ 9E40
 107+ 9E40                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E40 21 E2 82         LD HL, MushroomLockTimer
 109+ 9E43 7E               LD A, (HL)
 110+ 9E44 23               INC HL
 111+ 9E45 B6               OR (HL)
 112+ 9E46 28 21            JR Z, .noMushLock
 113+ 9E48 AF               XOR A
 114+ 9E49 32 B4 82         LD (InputFire), A
 115+ 9E4C                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E4C                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E4C 7B               LD A, E
 118+ 9E4D B7               OR A
 119+ 9E4E 28 15            JR Z, .resetNoSwordFlag
 120+ 9E50 3A BD 82         LD A, (NoSwordSoundFlag)
 121+ 9E53 B7               OR A
 122+ 9E54 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E56 3E 01            LD A, 1
 124+ 9E58 32 BD 82         LD (NoSwordSoundFlag), A
 125+ 9E5B D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E5C 21 1C FB         LD HL, SFX_NoSwordError
 127+ 9E5F CD C5 F9         CALL PlaySFX
 128+ 9E62 D1               POP DE
 129+ 9E63 18 04            JR .noMushLock
 130+ 9E65              .resetNoSwordFlag:
 131+ 9E65 AF               XOR A
 132+ 9E66 32 BD 82         LD (NoSwordSoundFlag), A
 133+ 9E69              .noMushLock:
 134+ 9E69
 135+ 9E69                  ; -- REVERSE debuff: si timer > 0, swap N<->S y E<->W en D --
 136+ 9E69                  ; Para que las dos parejas se "intercambien" solo cuando difieren (caso
 137+ 9E69                  ; 01 o 10), comprobamos cada pareja por separado y XOR'eamos $03 / $0C
 138+ 9E69                  ; respectivamente. Si ambos bits estan igual (00 o 11), no se toca.
 139+ 9E69 3A DE 5F         LD A, (ReverseTimer)
 140+ 9E6C 21 DF 5F         LD HL, ReverseTimer + 1
 141+ 9E6F B6               OR (HL)
 142+ 9E70 28 1E            JR Z, .revOff
 143+ 9E72                  ; Swap bits 0 (N) y 1 (S)
 144+ 9E72 7A               LD A, D
 145+ 9E73 E6 03            AND $03
 146+ 9E75 FE 01            CP $01
 147+ 9E77 28 04            JR Z, .revFlipNS
 148+ 9E79 FE 02            CP $02
 149+ 9E7B 20 04            JR NZ, .revAfterNS
 150+ 9E7D              .revFlipNS:
 151+ 9E7D 7A               LD A, D
 152+ 9E7E EE 03            XOR $03
 153+ 9E80 57               LD D, A
 154+ 9E81              .revAfterNS:
 155+ 9E81                  ; Swap bits 2 (E) y 3 (W)
 156+ 9E81 7A               LD A, D
 157+ 9E82 E6 0C            AND $0C
 158+ 9E84 FE 04            CP $04
 159+ 9E86 28 04            JR Z, .revFlipEW
 160+ 9E88 FE 08            CP $08
 161+ 9E8A 20 04            JR NZ, .revAfterEW
 162+ 9E8C              .revFlipEW:
 163+ 9E8C 7A               LD A, D
 164+ 9E8D EE 0C            XOR $0C
 165+ 9E8F 57               LD D, A
 166+ 9E90              .revAfterEW:
 167+ 9E90              .revOff:
 168+ 9E90
 169+ 9E90                  ; -- 6. Cancelar opuestos --
 170+ 9E90 7A               LD A, D
 171+ 9E91 47               LD B, A
 172+ 9E92 E6 03            AND DIR_N | DIR_S
 173+ 9E94 FE 03            CP DIR_N | DIR_S
 174+ 9E96 20 04            JR NZ, .noVC
 175+ 9E98 78               LD A, B
 176+ 9E99 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 177+ 9E9B 47               LD B, A
 178+ 9E9C              .noVC:
 179+ 9E9C 78               LD A, B
 180+ 9E9D E6 0C            AND DIR_E | DIR_W
 181+ 9E9F FE 0C            CP DIR_E | DIR_W
 182+ 9EA1 20 04            JR NZ, .noHC
 183+ 9EA3 78               LD A, B
 184+ 9EA4 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 185+ 9EA6 47               LD B, A
 186+ 9EA7              .noHC:
 187+ 9EA7 78               LD A, B
 188+ 9EA8 32 B3 82         LD (InputDirection), A
 189+ 9EAB C9               RET
