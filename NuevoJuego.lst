2673+ B0F5              ; ==============================================================================
2674+ B0F5              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2675+ B0F5              ; ==============================================================================
2676+ B0F5              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2677+ B0F5              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2678+ B0F5              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2679+ B0F5              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2680+ B0F5              ; ==============================================================================
2681+ B0F5              UpdateMonster:
2682+ B0F5                  ; --- Stun: knockback + pausa tras golpe del player ---
2683+ B0F5 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2684+ B0F8 B7               OR A
2685+ B0F9 CA 2E B3         JP Z, .moNormal
2686+ B0FC DD 35 0A         DEC (IX+ENT_DIR)
2687+ B0FF 20 0B            JR NZ, .moStunActive
2688+ B101                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2689+ B101 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2690+ B105 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2691+ B109 C3 2E B3         JP .moNormal
2692+ B10C
2693+ B10C              .moStunActive:
2694+ B10C                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2695+ B10C FE 06            CP MONSTER_STUN_PAUSE
2696+ B10E DA BF B4         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2697+ B111                  ; Knockback: aplicar movimiento con collision check
2698+ B111 DD 56 06         LD D, (IX+ENT_DELTAX)
2699+ B114 DD 5E 07         LD E, (IX+ENT_DELTAY)
2700+ B117 7A               LD A, D
2701+ B118 B3               OR E
2702+ B119 CA BF B4         JP Z, .moAnimate
2703+ B11C                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2704+ B11C D5               PUSH DE
2705+ B11D DD 7E 03         LD A, (IX+ENT_POSX)
2706+ B120 32 57 B6         LD (.moSvX), A
2707+ B123 DD 7E 04         LD A, (IX+ENT_POSY)
2708+ B126 32 58 B6         LD (.moSvY), A
2709+ B129                  ; Calcular nueva posicion
2710+ B129 DD 7E 03         LD A, (IX+ENT_POSX)
2711+ B12C 82               ADD A, D
2712+ B12D DD 77 03         LD (IX+ENT_POSX), A
2713+ B130 DD 7E 04         LD A, (IX+ENT_POSY)
2714+ B133 83               ADD A, E
2715+ B134 DD 77 04         LD (IX+ENT_POSY), A
