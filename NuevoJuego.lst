 481+ A37E              .peSkip:
 482+ A37E C1               POP BC
 483+ A37F 05               DEC B
 484+ A380 C2 42 A3         JP NZ, .peLoop
 485+ A383 C9               RET
 486+ A384
 487+ A384              .peDone:
 488+ A384 C1               POP BC
 489+ A385 C9               RET
 490+ A386
 491+ A386 00           .peCount: DEFB 0
 492+ A387
 493+ A387              ; ==============================================================================
 494+ A387              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 495+ A387              ; ==============================================================================
 496+ A387              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 497+ A387              ; ==============================================================================
 498+ A387              ProcessOneEnemy:
 499+ A387                  ; --- Frozen monster gate (durante muerte del player) ---
 500+ A387                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 501+ A387                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 502+ A387                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 503+ A387 3A F0 82         LD A, (MonstersFrozen)
 504+ A38A B7               OR A
 505+ A38B 28 08            JR Z, .peDispatch
 506+ A38D DD 7E 01         LD A, (IX+ENT_TYPE)
 507+ A390 FE 02            CP TYPE_MONSTER
 508+ A392 CA FA A3         JP Z, .peCalcAndDraw
 509+ A395              .peDispatch:
 510+ A395                  ; --- Dispatch segun estado ---
 511+ A395 DD 7E 02         LD A, (IX+ENT_STATE)
 512+ A398 FE 03            CP STATE_DYING
 513+ A39A CA 0C A6         JP Z, .peDying
 514+ A39D FE 04            CP STATE_SPAWNING
 515+ A39F CA C1 A6         JP Z, .peSpawning
 516+ A3A2 FE 05            CP STATE_SCARED
 517+ A3A4 CA E9 A4         JP Z, .peScared
 518+ A3A7 FE 06            CP STATE_ATTACKING
 519+ A3A9 CA DC A4         JP Z, .peAttacking
 520+ A3AC
 521+ A3AC                  ; === STATE_RUNNING ===
 522+ A3AC                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 523+ A3AC 3A 8E B8         LD A, (ScareTimer)
 524+ A3AF B7               OR A
 525+ A3B0 28 1E            JR Z, .peRunning
 526+ A3B2 DD 7E 01         LD A, (IX+ENT_TYPE)
 527+ A3B5 FE 03            CP TYPE_NASTY
 528+ A3B7 28 08            JR Z, .peDoScare
 529+ A3B9 FE 02            CP TYPE_MONSTER
 530+ A3BB 20 13            JR NZ, .peRunning
 531+ A3BD                  ; Monster: limpiar stun antes de asustar
 532+ A3BD DD 36 0A 00      LD (IX+ENT_DIR), 0
 533+ A3C1              .peDoScare:
 534+ A3C1 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 535+ A3C5 DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 536+ A3C9 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 537+ A3CD C3 E9 A4         JP .peScared
 538+ A3D0              .peRunning:
 539+ A3D0 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 540+ A3D4 C2 80 A4         JP NZ, .peFresh
 541+ A3D7
 542+ A3D7                  ; --- Logica: AI + movimiento + animacion ---
 543+ A3D7 DD 7E 01         LD A, (IX+ENT_TYPE)
 544+ A3DA FE 05            CP TYPE_DEATH
 545+ A3DC 28 14            JR Z, .peDeathAI
 546+ A3DE FE 02            CP TYPE_MONSTER
 547+ A3E0 20 15            JR NZ, .peNormalAI
 548+ A3E2 AF               XOR A
 549+ A3E3 32 F7 B5         LD (MonsterKbDespawn), A        ; Reset flag
 550+ A3E6 CD 7F B0         CALL UpdateMonster
 551+ A3E9 3A F7 B5         LD A, (MonsterKbDespawn)
 552+ A3EC B7               OR A
 553+ A3ED C2 E4 A5         JP NZ, .peScaredDespawn         ; Knockback offscreen → borrar y despawnear
 554+ A3F0 18 08            JR .peCalcAndDraw
 555+ A3F2              .peDeathAI:
 556+ A3F2 CD 8B C7         CALL UpdateDeath
 557+ A3F5 18 03            JR .peCalcAndDraw
 558+ A3F7              .peNormalAI:
 559+ A3F7 CD BE AF         CALL UpdateEnemy
