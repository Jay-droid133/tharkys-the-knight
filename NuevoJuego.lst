1101+ A4F5              ; ==============================================================================
1102+ A4F5              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1103+ A4F5              ; ==============================================================================
1104+ A4F5              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1105+ A4F5              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1106+ A4F5              ; ==============================================================================
1107+ A4F5              GetSpriteAddr:
1108+ A4F5                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1109+ A4F5                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1110+ A4F5 3A 8A 8D         LD A, (CurrentPaging)
1111+ A4F8 E6 F8            AND $F8
1112+ A4FA F6 06            OR 6
1113+ A4FC 32 8A 8D         LD (CurrentPaging), A
1114+ A4FF 01 FD 7F         LD BC, $7FFD
1115+ A502 ED 79            OUT (C), A                  ; bank 6 paginado
1116+ A504 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1117+ A507 6F               LD L, A
1118+ A508 26 00            LD H, 0
