4799+ ADCB 3E 42            LD A, RED | $40
4800+ ADCD 32 A3 80         LD (EntityTable + ENT_ATTR), A
4801+ ADD0 3E 06            LD A, 6                         ; 6 frames a 25fps ~0.24s (era 12 a 50fps)
4802+ ADD2 32 22 AE         LD (PlayerHitTimer), A
4803+ ADD5                  ; Si nasty destructible → muere al tocar al player
4804+ ADD5 DD CB 0B 56      BIT ENTF_DESTRUCT, (IX+ENT_FLAGS)
4805+ ADD9 28 1C            JR Z, .playerHitSFX
4806+ ADDB DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4807+ ADDF DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4808+ ADE3 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4809+ ADE7 DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4810+ ADEB DD 36 06 00      LD (IX+ENT_DELTAX), 0
4811+ ADEF DD 36 07 00      LD (IX+ENT_DELTAY), 0
4812+ ADF3 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
