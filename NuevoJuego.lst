  63+ 846B              .alignedLine:
  64+ 846B 3A CB 84         LD A, (.widthSave)
  65+ 846E 47               LD B, A                     ; B = ancho en bytes
  66+ 846F E5               PUSH HL                     ; Guardar inicio de linea en VRAM
