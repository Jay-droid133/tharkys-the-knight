   1+ 99EB              ; ==============================================================================
   2+ 99EB              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99EB              ; ==============================================================================
   4+ 99EB              ; Sistema fiel a Sabre Wulf:
   5+ 99EB              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99EB              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99EB              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99EB              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99EB              ; ==============================================================================
  10+ 99EB
  11+ 99EB              ClearScreen:
  12+ 99EB CD AF 0D         CALL ROM_CLS
  13+ 99EE C9               RET
  14+ 99EF
  15+ 99EF              ; ==============================================================================
  16+ 99EF              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99EF              ; ==============================================================================
  18+ 99EF              ; Entrada:
  19+ 99EF              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99EF              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99EF              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99EF              ;
  23+ 99EF              ; Formato del sprite:
  24+ 99EF              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99EF              ;   DEFB height_pixels
  26+ 99EF              ;   DEFB pixel_data... (width * height bytes)
  27+ 99EF              ;
  28+ 99EF              ; Dos paths:
  29+ 99EF              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99EF              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99EF              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99EF              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99EF              ;
  34+ 99EF              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99EF              ;
  36+ 99EF              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99EF              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99EF              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99EF              ; alto la restauracion del bank.
  40+ 99EF              ; ==============================================================================
  41+ 99EF              DrawSprite:
  42+ 99EF                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99EF                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99EF                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99EF 3A 8A 8D         LD A, (CurrentPaging)
  46+ 99F2 E6 F8            AND $F8
  47+ 99F4 F6 06            OR 6
  48+ 99F6 32 8A 8D         LD (CurrentPaging), A
  49+ 99F9 01 FD 7F         LD BC, $7FFD
  50+ 99FC ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99FE CD 0F 9A         CALL _DrawSpriteImpl
  52+ 9A01                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9A01                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9A01 3A 8A 8D         LD A, (CurrentPaging)
  55+ 9A04 E6 F8            AND $F8
  56+ 9A06 32 8A 8D         LD (CurrentPaging), A
  57+ 9A09 01 FD 7F         LD BC, $7FFD
  58+ 9A0C ED 79            OUT (C), A
  59+ 9A0E C9               RET
  60+ 9A0F
  61+ 9A0F              _DrawSpriteImpl:
  62+ 9A0F                  ; Guardar posicion
  63+ 9A0F 7A               LD A, D
  64+ 9A10 32 C9 9A         LD (.posY), A
  65+ 9A13 7B               LD A, E
  66+ 9A14 32 C8 9A         LD (.posX), A
  67+ 9A17
  68+ 9A17                  ; Leer cabecera sprite
  69+ 9A17 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A1A 32 CA 9A         LD (.widthSave), A
  71+ 9A1D DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A20 32 CB 9A         LD (.heightSave), A
  73+ 9A23 DD 23            INC IX
  74+ 9A25 DD 23            INC IX                      ; IX → pixel data
  75+ 9A27
  76+ 9A27                  ; === Y CLIPPING ===
  77+ 9A27                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A27 3A C9 9A         LD A, (.posY)
  79+ 9A2A FE 10            CP SCREEN_MIN_Y
  80+ 9A2C 30 20            JR NC, .clipTopDone
  81+ 9A2E                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A2E 47               LD B, A                     ; B = Y
  83+ 9A2F 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A31 90               SUB B                       ; A = filas a saltar
  85+ 9A32 47               LD B, A                     ; B = skip rows
  86+ 9A33                  ; Reducir altura
  87+ 9A33 3A CB 9A         LD A, (.heightSave)
  88+ 9A36 90               SUB B
  89+ 9A37 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A38 D8               RET C                       ; Idem
  91+ 9A39 32 CB 9A         LD (.heightSave), A
  92+ 9A3C                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A3C 3A CA 9A         LD A, (.widthSave)
  94+ 9A3F 4F               LD C, A
  95+ 9A40              .clipSkipRow:
  96+ 9A40 79               LD A, C
  97+ 9A41              .clipSkipByte:
  98+ 9A41 DD 23            INC IX
  99+ 9A43 3D               DEC A
 100+ 9A44 20 FB            JR NZ, .clipSkipByte
 101+ 9A46 10 F8            DJNZ .clipSkipRow
 102+ 9A48                  ; Ajustar Y al borde
 103+ 9A48 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A4A 32 C9 9A         LD (.posY), A
 105+ 9A4D 57               LD D, A
 106+ 9A4E              .clipTopDone:
 107+ 9A4E                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A4E 3A C9 9A         LD A, (.posY)
 109+ 9A51 47               LD B, A
 110+ 9A52 3A CB 9A         LD A, (.heightSave)
 111+ 9A55 80               ADD A, B                    ; A = Y + height
 112+ 9A56 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A58 FE C0            CP 192
 114+ 9A5A 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A5C              .clipBot:
 116+ 9A5C                  ; Reducir altura: new_height = 192 - Y
 117+ 9A5C 3E C0            LD A, 192
 118+ 9A5E 90               SUB B                       ; A = 192 - Y
 119+ 9A5F C8               RET Z
 120+ 9A60 D8               RET C
 121+ 9A61 32 CB 9A         LD (.heightSave), A
 122+ 9A64              .clipBotDone:
 123+ 9A64
 124+ 9A64                  ; Comprobar alineacion
 125+ 9A64 7B               LD A, E
 126+ 9A65 E6 07            AND 7
 127+ 9A67 20 1E            JR NZ, .shifted
 128+ 9A69
 129+ 9A69                  ; ==================================================================
 130+ 9A69                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9A69                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9A69                  ; ==================================================================
 133+ 9A69 CD 62 9D         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9A6C DD E5            PUSH IX
 135+ 9A6E D1               POP DE                      ; DE = puntero a pixel data
 136+ 9A6F 3A CB 9A         LD A, (.heightSave)
 137+ 9A72 4F               LD C, A                     ; C = height counter
 138+ 9A73
 139+ 9A73              .alignedLine:
 140+ 9A73 3A CA 9A         LD A, (.widthSave)
 141+ 9A76 47               LD B, A                     ; B = ancho en bytes
 142+ 9A77 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A78
 144+ 9A78              .alignedByte:
 145+ 9A78 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A79 AE               XOR (HL)
 147+ 9A7A 77               LD (HL), A
 148+ 9A7B 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A7C 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A7D 10 F9            DJNZ .alignedByte
 151+ 9A7F
 152+ 9A7F E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A80 0D               DEC C
 154+ 9A81 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A82 CD CE 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A85 18 EC            JR .alignedLine
 157+ 9A87
 158+ 9A87                  ; ==================================================================
 159+ 9A87                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A87                  ; ==================================================================
 161+ 9A87                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A87              .shifted:
 163+ 9A87                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A87 3D               DEC A                       ; 0-6
 165+ 9A88 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A89 E6 0E            AND $0E
 167+ 9A8B C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A8D 32 CC 9A         LD (.tablePage), A
 169+ 9A90
 170+ 9A90                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A90 DD E5            PUSH IX
 172+ 9A92 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A93 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A94
 175+ 9A94                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A94 3A C9 9A         LD A, (.posY)
 177+ 9A97 57               LD D, A
 178+ 9A98 3A C8 9A         LD A, (.posX)
 179+ 9A9B 5F               LD E, A
 180+ 9A9C CD 62 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A9F
 182+ 9A9F D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9AA0 3A CC 9A         LD A, (.tablePage)
 184+ 9AA3 47               LD B, A                     ; B = pagina high part
 185+ 9AA4                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9AA4                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9AA4 3A CB 9A         LD A, (.heightSave)
 188+ 9AA7 DD 67            LD IXH, A
 189+ 9AA9
 190+ 9AA9              .shiftedLine:
 191+ 9AA9 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9AAA 3A CA 9A         LD A, (.widthSave)
 193+ 9AAD DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9AAF
 195+ 9AAF              .shiftedByte:
 196+ 9AAF                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AAF 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AB0 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AB1 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AB2 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AB3 77               LD (HL), A                  ; Escribir
 202+ 9AB4 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AB5 04               INC B                       ; Pagina overflow
 204+ 9AB6 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AB7 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AB8 77               LD (HL), A                  ; Escribir
 207+ 9AB9 05               DEC B                       ; Restaurar pagina high
 208+ 9ABA 13               INC DE                      ; Siguiente byte de sprite
 209+ 9ABB                  ; Siguiente byte de ancho
 210+ 9ABB DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9ABD 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9ABF
 213+ 9ABF E1               POP HL                      ; Restaurar inicio de linea
 214+ 9AC0 DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9AC2 C8               RET Z                       ; Terminamos todas las lineas
 216+ 9AC3 CD CE 9A         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9AC6 18 E1            JR .shiftedLine
 218+ 9AC8
 219+ 9AC8              ; Variables locales de DrawSprite
 220+ 9AC8 00           .posX:       DEFB 0
 221+ 9AC9 00           .posY:       DEFB 0
 222+ 9ACA 00           .widthSave:  DEFB 0
 223+ 9ACB 00           .heightSave: DEFB 0
 224+ 9ACC 00           .tablePage:  DEFB 0
 225+ 9ACD 00           .widthCount: DEFB 0
 226+ 9ACE
 227+ 9ACE              ; ==============================================================================
 228+ 9ACE              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9ACE              ; ==============================================================================
 230+ 9ACE              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9ACE              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9ACE              ;
 233+ 9ACE              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9ACE              ; ==============================================================================
 235+ 9ACE              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9ACE              NextPixelLine:
 237+ 9ACE 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9ACF 7C               LD A, H
 239+ 9AD0 E6 07            AND 7
 240+ 9AD2 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9AD3
 242+ 9AD3                  ; --- Cruce de character row ---
 243+ 9AD3 7D               LD A, L
 244+ 9AD4 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AD6 6F               LD L, A
 246+ 9AD7 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD9 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9ADA
 249+ 9ADA                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9ADA 7C               LD A, H
 251+ 9ADB D6 08            SUB 8
 252+ 9ADD 67               LD H, A
 253+ 9ADE C9               RET
 254+ 9ADF
 255+ 9ADF              ; ==============================================================================
 256+ 9ADF              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9ADF              ; ==============================================================================
 258+ 9ADF              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9ADF              ; Entrada:
 260+ 9ADF              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9ADF              ;   A = atributo a pintar
 262+ 9ADF              ; ==============================================================================
 263+ 9ADF              SetEntityAttr:
 264+ 9ADF F5               PUSH AF                     ; Guardar atributo
 265+ 9AE0 CD 47 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9AE3 F1               POP AF
 267+ 9AE4
 268+ 9AE4 47               LD B, A                     ; B = atributo (preservar)
 269+ 9AE5 3A DE 9B         LD A, (EntityAttrH)
 270+ 9AE8 4F               LD C, A                     ; C = filas
 271+ 9AE9              .rowLoop:
 272+ 9AE9                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE9 E5               PUSH HL
 274+ 9AEA 7C               LD A, H
 275+ 9AEB FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9AED 20 08            JR NZ, .rowNotHud
 277+ 9AEF 7D               LD A, L
 278+ 9AF0 FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AF2 30 03            JR NC, .rowNotHud
 280+ 9AF4                  ; Fila en HUD → saltar sin pintar
 281+ 9AF4 E1               POP HL
 282+ 9AF5 18 0B            JR .rowSkip
 283+ 9AF7              .rowNotHud:
 284+ 9AF7 E1               POP HL
 285+ 9AF8 3A DD 9B         LD A, (EntityAttrW)
 286+ 9AFB E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AFC                  ; Pintar una fila
 288+ 9AFC              .colLoop:
 289+ 9AFC 70               LD (HL), B
 290+ 9AFD 23               INC HL
 291+ 9AFE 3D               DEC A
 292+ 9AFF 20 FB            JR NZ, .colLoop
 293+ 9B01 E1               POP HL
 294+ 9B02              .rowSkip:
 295+ 9B02                  ; Siguiente fila: HL += 32
 296+ 9B02 D5               PUSH DE
 297+ 9B03 11 20 00         LD DE, 32
 298+ 9B06 19               ADD HL, DE
 299+ 9B07 D1               POP DE
 300+ 9B08 0D               DEC C
 301+ 9B09 20 DE            JR NZ, .rowLoop
 302+ 9B0B C9               RET
 303+ 9B0C
 304+ 9B0C              ; ==============================================================================
 305+ 9B0C              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9B0C              ; ==============================================================================
 307+ 9B0C              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9B0C              ; Se llama ANTES de pintar el sprite.
 309+ 9B0C              ;
 310+ 9B0C              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9B0C              ;          IX = puntero al sprite (para leer width/height)
 312+ 9B0C              ; ==============================================================================
 313+ 9B0C              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9B0C              ; ==============================================================================
 315+ 9B0C              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9B0C              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9B0C              ; ==============================================================================
 318+ 9B0C              CalcEntityAttrSize:
 319+ 9B0C                  ; Paging inline (ver nota en DrawSprite)
 320+ 9B0C 3A 8A 8D         LD A, (CurrentPaging)
 321+ 9B0F E6 F8            AND $F8
 322+ 9B11 F6 06            OR 6
 323+ 9B13 32 8A 8D         LD (CurrentPaging), A
 324+ 9B16 01 FD 7F         LD BC, $7FFD
 325+ 9B19 ED 79            OUT (C), A
 326+ 9B1B CD 2C 9B         CALL _CalcEntityAttrSizeImpl
 327+ 9B1E 3A 8A 8D         LD A, (CurrentPaging)
 328+ 9B21 E6 F8            AND $F8
 329+ 9B23 32 8A 8D         LD (CurrentPaging), A
 330+ 9B26 01 FD 7F         LD BC, $7FFD
 331+ 9B29 ED 79            OUT (C), A
 332+ 9B2B C9               RET
 333+ 9B2C
 334+ 9B2C              _CalcEntityAttrSizeImpl:
 335+ 9B2C DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9B2F 47               LD B, A
 337+ 9B30 7B               LD A, E
 338+ 9B31 E6 07            AND 7
 339+ 9B33 28 01            JR Z, .ceNoExtra
 340+ 9B35 04               INC B
 341+ 9B36              .ceNoExtra:
 342+ 9B36 78               LD A, B
 343+ 9B37 32 DD 9B         LD (EntityAttrW), A
 344+ 9B3A 7A               LD A, D
 345+ 9B3B E6 07            AND 7
 346+ 9B3D 4F               LD C, A
 347+ 9B3E DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9B41 81               ADD A, C
 349+ 9B42 C6 07            ADD A, 7
 350+ 9B44 0F               RRCA
 351+ 9B45 0F               RRCA
 352+ 9B46 0F               RRCA
 353+ 9B47 E6 1F            AND $1F
 354+ 9B49 32 DE 9B         LD (EntityAttrH), A
 355+ 9B4C C9               RET
 356+ 9B4D
 357+ 9B4D              ; ==============================================================================
 358+ 9B4D              SaveEntityAttr:
 359+ 9B4D                  ; Paging inline (ver nota en DrawSprite)
 360+ 9B4D 3A 8A 8D         LD A, (CurrentPaging)
 361+ 9B50 E6 F8            AND $F8
 362+ 9B52 F6 06            OR 6
 363+ 9B54 32 8A 8D         LD (CurrentPaging), A
 364+ 9B57 01 FD 7F         LD BC, $7FFD
 365+ 9B5A ED 79            OUT (C), A
 366+ 9B5C CD 6D 9B         CALL _SaveEntityAttrImpl
 367+ 9B5F 3A 8A 8D         LD A, (CurrentPaging)
 368+ 9B62 E6 F8            AND $F8
 369+ 9B64 32 8A 8D         LD (CurrentPaging), A
 370+ 9B67 01 FD 7F         LD BC, $7FFD
 371+ 9B6A ED 79            OUT (C), A
 372+ 9B6C C9               RET
 373+ 9B6D
 374+ 9B6D              _SaveEntityAttrImpl:
 375+ 9B6D                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B6D DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B70 47               LD B, A
 378+ 9B71 7B               LD A, E                     ; X pixel (raw)
 379+ 9B72 E6 07            AND 7
 380+ 9B74 28 01            JR Z, .noExtraW
 381+ 9B76 04               INC B                       ; +1 columna si no alineado
 382+ 9B77              .noExtraW:
 383+ 9B77 78               LD A, B
 384+ 9B78 32 DD 9B         LD (EntityAttrW), A
 385+ 9B7B
 386+ 9B7B                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B7B 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B7C E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B7E 4F               LD C, A
 390+ 9B7F DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9B82 81               ADD A, C                    ; + Y offset
 392+ 9B83 C6 07            ADD A, 7
 393+ 9B85 0F               RRCA
 394+ 9B86 0F               RRCA
 395+ 9B87 0F               RRCA
 396+ 9B88 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9B8A 32 DE 9B         LD (EntityAttrH), A
 398+ 9B8D
 399+ 9B8D CD 47 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9B90 11 CD 9B         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9B93
 402+ 9B93 3A DE 9B         LD A, (EntityAttrH)
 403+ 9B96 4F               LD C, A                     ; C = filas
 404+ 9B97              .saveRow:
 405+ 9B97 3A DD 9B         LD A, (EntityAttrW)
 406+ 9B9A 47               LD B, A                     ; B = columnas
 407+ 9B9B E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9B9C              .saveCol:
 409+ 9B9C 7E               LD A, (HL)
 410+ 9B9D 12               LD (DE), A
 411+ 9B9E 23               INC HL
 412+ 9B9F 13               INC DE
 413+ 9BA0 10 FA            DJNZ .saveCol
 414+ 9BA2 E1               POP HL
 415+ 9BA3                  ; Siguiente fila attr: HL += 32
 416+ 9BA3 D5               PUSH DE
 417+ 9BA4 11 20 00         LD DE, 32
 418+ 9BA7 19               ADD HL, DE
 419+ 9BA8 D1               POP DE
 420+ 9BA9 0D               DEC C
 421+ 9BAA 20 EB            JR NZ, .saveRow
 422+ 9BAC C9               RET
 423+ 9BAD
 424+ 9BAD              ; ==============================================================================
 425+ 9BAD              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9BAD              ; ==============================================================================
 427+ 9BAD              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9BAD              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9BAD              ;
 430+ 9BAD              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9BAD              ; ==============================================================================
 432+ 9BAD              RestoreEntityAttr:
 433+ 9BAD CD 47 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BB0 11 CD 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BB3
 436+ 9BB3 3A DE 9B         LD A, (EntityAttrH)
 437+ 9BB6 4F               LD C, A
 438+ 9BB7              .restRow:
 439+ 9BB7 3A DD 9B         LD A, (EntityAttrW)
 440+ 9BBA 47               LD B, A
 441+ 9BBB E5               PUSH HL
 442+ 9BBC              .restCol:
 443+ 9BBC 1A               LD A, (DE)
 444+ 9BBD 77               LD (HL), A
 445+ 9BBE 23               INC HL
 446+ 9BBF 13               INC DE
 447+ 9BC0 10 FA            DJNZ .restCol
 448+ 9BC2 E1               POP HL
 449+ 9BC3 D5               PUSH DE
 450+ 9BC4 11 20 00         LD DE, 32
 451+ 9BC7 19               ADD HL, DE
 452+ 9BC8 D1               POP DE
 453+ 9BC9 0D               DEC C
 454+ 9BCA 20 EB            JR NZ, .restRow
 455+ 9BCC C9               RET
 456+ 9BCD
 457+ 9BCD              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BCD              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BCD              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BCD              ; ---
 461+ 9BCD 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BDD 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BDE 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BDF 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D11 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D12
 467+ 9D12              ; ==============================================================================
 468+ 9D12              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D12              ; ==============================================================================
 470+ 9D12              ; Entrada: A = indice de entidad (0-16)
 471+ 9D12              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D12              ; ==============================================================================
 473+ 9D12              SetAttrSlot:
 474+ 9D12 32 11 9D         LD (CurrentAttrSlot), A
 475+ 9D15                  ; Calcular offset: A * 18
 476+ 9D15 6F               LD L, A
 477+ 9D16 26 00            LD H, 0
 478+ 9D18 29               ADD HL, HL                  ; x2
 479+ 9D19 54               LD D, H
 480+ 9D1A 5D               LD E, L                     ; DE = x2
 481+ 9D1B 29               ADD HL, HL                  ; x4
 482+ 9D1C 29               ADD HL, HL                  ; x8
 483+ 9D1D 29               ADD HL, HL                  ; x16
 484+ 9D1E 19               ADD HL, DE                  ; x18
 485+ 9D1F 11 DF 9B         LD DE, SavedAttrTable
 486+ 9D22 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D23                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D23 11 CD 9B         LD DE, EntitySavedAttr
 489+ 9D26 01 12 00         LD BC, 18
 490+ 9D29 ED B0            LDIR
 491+ 9D2B C9               RET
 492+ 9D2C
 493+ 9D2C              ; ==============================================================================
 494+ 9D2C              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D2C              ; ==============================================================================
 496+ 9D2C              FlushAttrSlot:
 497+ 9D2C 3A 11 9D         LD A, (CurrentAttrSlot)
 498+ 9D2F 6F               LD L, A
 499+ 9D30 26 00            LD H, 0
 500+ 9D32 29               ADD HL, HL                  ; x2
 501+ 9D33 54               LD D, H
 502+ 9D34 5D               LD E, L
 503+ 9D35 29               ADD HL, HL                  ; x4
 504+ 9D36 29               ADD HL, HL                  ; x8
 505+ 9D37 29               ADD HL, HL                  ; x16
 506+ 9D38 19               ADD HL, DE                  ; x18
 507+ 9D39 11 DF 9B         LD DE, SavedAttrTable
 508+ 9D3C 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D3D EB               EX DE, HL                   ; DE = destino
 510+ 9D3E 21 CD 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D41 01 12 00         LD BC, 18
 512+ 9D44 ED B0            LDIR
 513+ 9D46 C9               RET
 514+ 9D47
 515+ 9D47              ; ==============================================================================
 516+ 9D47              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D47              ; ==============================================================================
 518+ 9D47              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D47              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D47              ; ==============================================================================
 521+ 9D47              CalcAttrAddr:
 522+ 9D47 7A               LD A, D
 523+ 9D48 0F               RRCA
 524+ 9D49 0F               RRCA
 525+ 9D4A 0F               RRCA
 526+ 9D4B E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D4D 6F               LD L, A
 528+ 9D4E 26 00            LD H, 0
 529+ 9D50 29               ADD HL, HL
 530+ 9D51 29               ADD HL, HL
 531+ 9D52 29               ADD HL, HL
 532+ 9D53 29               ADD HL, HL
 533+ 9D54 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D55 7B               LD A, E
 535+ 9D56 0F               RRCA
 536+ 9D57 0F               RRCA
 537+ 9D58 0F               RRCA
 538+ 9D59 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D5B B5               OR L
 540+ 9D5C 6F               LD L, A
 541+ 9D5D 01 00 58         LD BC, ATTR_BASE
 542+ 9D60 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D61 C9               RET
 544+ 9D62
 545+ 9D62              ; ==============================================================================
 546+ 9D62              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D62              ; ==============================================================================
 548+ 9D62              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D62              ; Salida: HL=direccion en VRAM
 550+ 9D62              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D62              ; ==============================================================================
 552+ 9D62              CalcPixelAddr:
 553+ 9D62 7A               LD A, D
 554+ 9D63 E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D65 1F               RRA
 556+ 9D66 1F               RRA
 557+ 9D67 1F               RRA                         ; >> 3
 558+ 9D68 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D6A 67               LD H, A
 560+ 9D6B
 561+ 9D6B 7A               LD A, D
 562+ 9D6C E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D6E B4               OR H
 564+ 9D6F 67               LD H, A
 565+ 9D70
 566+ 9D70 7A               LD A, D
 567+ 9D71 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D73 87               ADD A, A
 569+ 9D74 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D75 6F               LD L, A
 571+ 9D76
 572+ 9D76 7B               LD A, E
 573+ 9D77 1F               RRA
 574+ 9D78 1F               RRA
 575+ 9D79 1F               RRA
 576+ 9D7A E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D7C B5               OR L
 578+ 9D7D 6F               LD L, A
 579+ 9D7E C9               RET
 580+ 9D7F
 581+ 9D7F              ; ==============================================================================
 582+ 9D7F              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D7F              ; ==============================================================================
 584+ 9D7F              DrawDebugInfo:
 585+ 9D7F 3A 10 83         LD A, (CurrentScreenX)
 586+ 9D82 1E 00            LD E, 0
 587+ 9D84 CD A1 9D         CALL .drawHexDigit
 588+ 9D87
 589+ 9D87 3E 2C            LD A, ','
 590+ 9D89 1E 01            LD E, 1
 591+ 9D8B CD AD 9D         CALL .drawChar
 592+ 9D8E
 593+ 9D8E 3A 11 83         LD A, (CurrentScreenY)
 594+ 9D91 1E 02            LD E, 2
 595+ 9D93 CD A1 9D         CALL .drawHexDigit
 596+ 9D96
 597+ 9D96 21 00 58         LD HL, ATTR_BASE
 598+ 9D99 3E 47            LD A, WHITE | $40
 599+ 9D9B 77               LD (HL), A
 600+ 9D9C 23               INC HL
 601+ 9D9D 77               LD (HL), A
 602+ 9D9E 23               INC HL
 603+ 9D9F 77               LD (HL), A
 604+ 9DA0 C9               RET
 605+ 9DA1
 606+ 9DA1              .drawHexDigit:
 607+ 9DA1 E6 0F            AND $0F
 608+ 9DA3 FE 0A            CP 10
 609+ 9DA5 38 04            JR C, .isNum
 610+ 9DA7 C6 37            ADD A, 'A' - 10
 611+ 9DA9 18 02            JR .drawChar
 612+ 9DAB              .isNum:
 613+ 9DAB C6 30            ADD A, '0'
 614+ 9DAD              .drawChar:
 615+ 9DAD 6F               LD L, A
 616+ 9DAE 26 00            LD H, 0
 617+ 9DB0 29               ADD HL, HL
 618+ 9DB1 29               ADD HL, HL
 619+ 9DB2 29               ADD HL, HL
 620+ 9DB3 01 00 3C         LD BC, $3C00
 621+ 9DB6 09               ADD HL, BC
 622+ 9DB7
 623+ 9DB7 16 40            LD D, $40
 624+ 9DB9 06 08            LD B, 8
 625+ 9DBB              .charLoop:
 626+ 9DBB 7E               LD A, (HL)
 627+ 9DBC 12               LD (DE), A
 628+ 9DBD 23               INC HL
 629+ 9DBE 14               INC D
 630+ 9DBF 10 FA            DJNZ .charLoop
 631+ 9DC1 C9               RET
 632+ 9DC2
