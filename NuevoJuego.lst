1484+ F661              ; ==============================================================================
1485+ F661              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1486+ F661              ; ==============================================================================
1487+ F661              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1488+ F661              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1489+ F661              ; ==============================================================================
1490+ F661              ChurchCutsceneEraseStatueAtLast:
1491+ F661              ChurchCutsceneDrawStatueAtLast:
1492+ F661 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1493+ F664 21 B7 64         LD HL, StatueIdTable
1494+ F667 5F               LD E, A
1495+ F668 16 00            LD D, 0
1496+ F66A 19               ADD HL, DE
1497+ F66B 7E               LD A, (HL)                              ; A = statue id
1498+ F66C B7               OR A
1499+ F66D C8               RET Z
1500+ F66E                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1501+ F66E 6F               LD L, A
1502+ F66F 26 00            LD H, 0
1503+ F671 54               LD D, H
1504+ F672 5D               LD E, L
1505+ F673 29               ADD HL, HL
1506+ F674 19               ADD HL, DE                              ; HL = id*3
1507+ F675 11 43 E1         LD DE, BgGfxPtrById
1508+ F678 19               ADD HL, DE
1509+ F679 5E               LD E, (HL)
1510+ F67A 23               INC HL
1511+ F67B 56               LD D, (HL)                              ; DE = sprite ptr
1512+ F67C 23               INC HL
1513+ F67D 7E               LD A, (HL)                              ; A = bank
1514+ F67E EB               EX DE, HL                               ; HL = sprite ptr
1515+ F67F CD D0 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1516+ F682                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1517+ F682 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1518+ F685 57               LD D, A
1519+ F686 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1520+ F689 5F               LD E, A
1521+ F68A C3 3F 66         JP DrawBgSprite16XorAtPixel
