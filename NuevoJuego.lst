   1+ 0000              ; ==============================================================================
   2+ 0000              ; CONSTANTES DEL SISTEMA Y JUEGO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000              ; --- Direcciones de Memoria ---
   6+ 0000              ORIGIN_ADDRESS  EQU 32768           ; $8000 - Inicio de nuestro juego en RAM
   7+ 0000              SP_ADDRESS      EQU 65368           ; $FF58 - Tope seguro para la pila (Stack)
   8+ 0000
   9+ 0000              ; --- Plaza del reloj (referencia para sonido espacial de campanadas) ---
  10+ 0000              ; NO confundir con START_SCREEN_X/Y (spawn del player, exportado por el editor).
  11+ 0000              ; Vive aqui (no en screen_data.asm) porque ese archivo lo regenera el editor
  12+ 0000              ; y se llevaria por delante estas EQUs.
  13+ 0000              PLAZA_SCREEN_X  EQU 8
  14+ 0000              PLAZA_SCREEN_Y  EQU 9
  15+ 0000
  16+ 0000              ; --- Mapa de Video ---
  17+ 0000              SCREEN_BASE     EQU 16384           ; $4000 - Inicio de los píxeles
  18+ 0000              ATTR_BASE       EQU 22528           ; $5800 - Inicio de los atributos (colores)
  19+ 0000              ATTR_SIZE       EQU 768             ; Tamaño de la zona de atributos
  20+ 0000
  21+ 0000              ; --- Colores Básicos (Tinta) ---
  22+ 0000              BLACK           EQU 0
  23+ 0000              BLUE            EQU 1
  24+ 0000              RED             EQU 2
  25+ 0000              MAGENTA         EQU 3
  26+ 0000              GREEN           EQU 4
  27+ 0000              CYAN            EQU 5
  28+ 0000              YELLOW          EQU 6
  29+ 0000              WHITE           EQU 7
  30+ 0000
  31+ 0000              ; --- Rutinas de la ROM ---
  32+ 0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
  33+ 0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
  34+ 0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
  35+ 0000
  36+ 0000              ; --- Movimiento estilo Sabre Wulf (8-bit, sin subpixel) ---
  37+ 0000              ; --- Movimiento estilo Sabre Wulf ---
  38+ 0000              ; Fiel al original: 4px cada 2 frames (turns_per_player_move=2).
  39+ 0000              ; PlayerMoveTimer controla cuándo se aplica el movimiento.
  40+ 0000              ;
  41+ 0000              ; FRAMERATE FIJO 25FPS
  42+ 0000              ; --------------------
  43+ 0000              ; El MainLoop usa doble HALT (2 × 20ms = 40ms/frame = 25fps).
  44+ 0000              ; Esto garantiza velocidad y animacion constantes independientemente
  45+ 0000              ; de la carga de CPU (numero de enemigos en pantalla).
  46+ 0000              ; Todas las constantes de timing estan calibradas para 25fps.
  47+ 0000              ;
  48+ 0000              SPEED_RUN           EQU 4           ; 4 px por frame a 25fps = 100px/s
  49+ 0000              SPEED_FIGHT         EQU 2           ; 2 px por frame a 25fps = 50px/s
  50+ 0000              PLAYER_MOVE_TURNS   EQU 1           ; Mover cada frame (granularidad fina para colision char-based)
  51+ 0000
  52+ 0000              ; --- Limites de pantalla (en pixeles) ---
  53+ 0000              ; Los limites maximos asumen sprite 16px ancho, ~16px alto.
  54+ 0000              ; Para sprites mas grandes, el clamp real se ajusta en runtime.
  55+ 0000              ; HUD en filas 0-1 (16px superiores); area de juego en filas 2-23.
  56+ 0000              SCREEN_MIN_X    EQU 0               ; Limite izquierdo
  57+ 0000              SCREEN_MAX_X    EQU 232             ; Limite derecho (con margen para shift: 256 - 16 - 8)
  58+ 0000              SCREEN_MIN_Y    EQU 16              ; Limite superior (debajo del HUD: 2 filas x 8px)
  59+ 0000              SCREEN_MAX_Y    EQU 168             ; Limite inferior alineado a múltiplo de 8 (antes: 171)
  60+ 0000              BG_Y_OFFSET     EQU 2              ; Offset (char-rows) aplicado al dibujar/colisionar sprites BG
  61+ 0000
  62+ 0000              ; --- Animacion (delays en frames de pantalla) ---
  63+ 0000              ANIM_DELAY_RUN  EQU 2               ; 2 frames a 25fps = 80ms (era 4 a 50fps)
  64+ 0000              ANIM_DELAY_IDLE EQU 10              ; 10 frames a 25fps = 400ms (era 20 a 50fps)
  65+ 0000              ANIM_DELAY_FIGHT EQU 1              ; 1 frame a 25fps = 40ms (era 2 a 50fps)
  66+ 0000              ANIM_DELAY_PUFF EQU 1               ; 1 frame a 25fps = 40ms (puff 24x24, 6f → 240ms total)
  67+ 0000              ANIM_DELAY_SPAWN EQU 1              ; 1 frame a 25fps = 40ms (spawn 24x24, 6f → 240ms total)
  68+ 0000
  69+ 0000              ; --- Numero de frames de animacion por estado ---
  70+ 0000              ANIM_FRAMES_WALK    EQU 3           ; Frames caminando por direccion
  71+ 0000              ANIM_FRAMES_FIGHT   EQU 5           ; Frames peleando por direccion
  72+ 0000              ANIM_FRAMES_IDLE    EQU 2           ; Frames idle
  73+ 0000              ANIM_FRAMES_PUFF    EQU 6           ; Frames de la animacion puff (muerte)
  74+ 0000              ANIM_FRAMES_SPAWN   EQU 6           ; Frames de la animacion spawn (aparicion)
  75+ 0000              ANIM_FRAMES_MONSTER EQU 3           ; Frames unicos de animacion de monstruo
  76+ 0000              MONSTER_BOUNCE_LEN  EQU 4           ; Slots bounce (0,1,2,1)
  77+ 0000
  78+ 0000              ; --- Direcciones del jugador ---
  79+ 0000              DIR_NONE        EQU 0
  80+ 0000              DIR_N           EQU 1
  81+ 0000              DIR_S           EQU 2
  82+ 0000              DIR_E           EQU 4
  83+ 0000              DIR_W           EQU 8
  84+ 0000              DIR_NE          EQU 5               ; DIR_N | DIR_E
  85+ 0000              DIR_NW          EQU 9               ; DIR_N | DIR_W
  86+ 0000              DIR_SE          EQU 6               ; DIR_S | DIR_E
  87+ 0000              DIR_SW          EQU 10              ; DIR_S | DIR_W
  88+ 0000
  89+ 0000              ; --- Estados del jugador/entidad ---
  90+ 0000              STATE_IDLE      EQU 0
  91+ 0000              STATE_RUNNING   EQU 1
  92+ 0000              STATE_FIGHTING  EQU 2
  93+ 0000              STATE_DYING     EQU 3               ; Animacion de muerte (puff)
  94+ 0000              STATE_SPAWNING  EQU 4               ; Animacion de aparicion (spawn)
  95+ 0000              STATE_SCARED    EQU 5               ; Huida hacia borde (campanadas)
  96+ 0000              STATE_ATTACKING EQU 6               ; Nasty depredador lanzandose hacia el player
  97+ 0000
  98+ 0000              ; ==============================================================================
  99+ 0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
 100+ 0000              ; ==============================================================================
 101+ 0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
 102+ 0000              ; Acceso via IX + ENT_* offset.
 103+ 0000              ; ==============================================================================
 104+ 0000
 105+ 0000              ; --- Offsets en la estructura de entidad (16 bytes) ---
 106+ 0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
 107+ 0000              ENT_TYPE        EQU 1               ; Tipo de entidad
 108+ 0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
 109+ 0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
 110+ 0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
 111+ 0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
 112+ 0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
 113+ 0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
 114+ 0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
 115+ 0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
 116+ 0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
 117+ 0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
 118+ 0000              ENT_OLDX        EQU 12              ; X del frame anterior (para XOR erase)
 119+ 0000              ENT_OLDY        EQU 13              ; Y del frame anterior (para XOR erase)
 120+ 0000              ENT_OLDSPRID    EQU 14              ; SpriteID del frame anterior
 121+ 0000              ENT_DRAWX       EQU 15              ; X de dibujo (ajustado para attack offset)
 122+ 0000
 123+ 0000              ENT_SIZE        EQU 16              ; Bytes por entidad
 124+ 0000              NUM_ENTITIES    EQU 17              ; Total de slots
 125+ 0000
 126+ 0000              ; --- Tipos de entidad ---
 127+ 0000              TYPE_NONE       EQU 0               ; Slot inactivo
 128+ 0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 129+ 0000              TYPE_MONSTER   EQU 2               ; Monstruo permanente (rhino, wolf, etc.)
 130+ 0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 131+ 0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
 132+ 0000              TYPE_DEATH      EQU 5               ; La muerte: persigue al player tras 10s en sala
 133+ 0000
 134+ 0000              ; --- Flags de entidad (ENT_FLAGS) ---
 135+ 0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
 136+ 0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
 137+ 0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
 138+ 0000              ENTF_NEWSPAWN   EQU 3               ; bit 3: recien creada (usar freshDraw, no erase)
 139+ 0000              ENTF_KB_DIRECT  EQU 4               ; bit 4: knockback directo del player (no billar)
 140+ 0000                                                  ;   Set al golpear con espada; clear al heredar
 141+ 0000                                                  ;   kb por colision billar. CheckChurchTrap solo
 142+ 0000                                                  ;   dispara la trampa si este bit esta set.
 143+ 0000
 144+ 0000              ; --- Rangos de slots ---
 145+ 0000              SLOT_PLAYER     EQU 0               ; Slot 0: player
 146+ 0000              SLOT_MONSTER0  EQU 1               ; Slots 1-6: monstruos
 147+ 0000              NUM_MONSTERS   EQU 6
 148+ 0000              SLOT_NASTY0     EQU 7               ; Slots 7-9: nasties activos (slot 10 reservado, sin usar)
 149+ 0000              NUM_NASTIES     EQU 3
 150+ 0000              SLOT_DEATH      EQU 11              ; Slot 11: la muerte (entidad unica TYPE_DEATH)
 151+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 152+ 0000              NUM_OBJECTS     EQU 4
 153+ 0000
 154+ 0000              ; --- Velocidades de enemigos ---
 155+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 156+ 0000              MONSTER_SPEED    EQU 2               ; Pixels por update (efectivo ~1 px/frame con round-robin)
 157+ 0000              MONSTER_MAX_HITS EQU 5              ; Golpes directos para matar un monster
 158+ 0000              MONSTER_KB_SPEED EQU 4              ; Pixels por update durante knockback
 159+ 0000              MONSTER_RESPAWN_DELAY EQU 75        ; 75 frames a 25fps = 3s (era 150 a 50fps)
 160+ 0000              MONSTER_STUN_TOTAL EQU 12           ; 12 frames a 25fps ~0.5s (era 24 a 50fps)
 161+ 0000              MONSTER_STUN_PAUSE EQU 6            ; 6 frames a 25fps (era 12 a 50fps)
 162+ 0000              ENEMY_ANIM_DELAY EQU 4              ; 4 frames a 25fps = 160ms (era 8 a 50fps)
 163+ 0000              ; PREDATOR_SPEED: se lee de PredatorSpeedTable segun DayCycleCount
 164+ 0000              ; Tipos de depredador (bits 0-1 de PredatorTable)
 165+ 0000              PRED_NONE       EQU 0               ; No depredador (movimiento random)
 166+ 0000              PRED_FROM_ABOVE EQU 1               ; Se lanza desde arriba (Eagle, Bat)
 167+ 0000              PRED_FROM_BELOW EQU 2               ; Se lanza desde abajo (Snake, Scorpion)
 168+ 0000              PRED_HORIZONTAL EQU 3               ; Se lanza horizontalmente (Goat, RabidCat)
 169+ 0000              PRED_ALIGN_DIST EQU 12              ; Distancia de alineacion para activar ataque
 170+ 0000              PREDATOR_COOLDOWN EQU 25            ; 25 frames a 25fps = 1s (era 50 a 50fps)
 171+ 0000
 172+ 0000              ; --- DEBUG: deshabilita el spawn de TODOS los enemigos (nasties, monsters,
 173+ 0000              ; muerte, monsters post-bells). Util para testing puro de mecanicas.
 174+ 0000              ; Poner a 0 cuando termine el debug.
 175+ 0000              DEBUG_NO_ENEMIES    EQU 0
 176+ 0000
 177+ 0000              ; DEBUG: forzar siempre compass al rolear random pickup. Pone a 0 para volver
 178+ 0000              ; a la distribución normal. Usado para test rápido del power-up.
 179+ 0000              DEBUG_FORCE_COMPASS EQU 0
 180+ 0000
 181+ 0000              ; DEBUG: forzar siempre mushroom al rolear random pickup. Pone a 0 para
 182+ 0000              ; volver a la distribución normal. Util para probar el debuff (block fire
 183+ 0000              ; + SFX de error). Si DEBUG_FORCE_COMPASS y DEBUG_FORCE_MUSHROOM estan
 184+ 0000              ; ambos a 1, gana COMPASS (chequeado primero).
 185+ 0000              DEBUG_FORCE_MUSHROOM EQU 0
 186+ 0000
 187+ 0000              ; DEBUG: forzar siempre roulette al rolear random pickup. Pone a 0 para
 188+ 0000              ; volver a distribución normal. Util para probar el ciclado de RouletteOrder.
 189+ 0000              DEBUG_FORCE_ROULETTE EQU 0
 190+ 0000
 191+ 0000              ; DEBUG: forzar roll a uno de los buffs/debuffs que cambian color (RAYO,
 192+ 0000              ; CARACOL, MUSHROOM) al 33% cada uno. Util para probar el color cycler:
 193+ 0000              ; recoges 1, vuelves a la sala, sale otro, y los ves cyclar a la vez.
 194+ 0000              ; Pone a 0 para volver a distribución normal.
 195+ 0000              DEBUG_FORCE_COLOR_CHANGER EQU 0
 196+ 0000
 197+ 0000              ; DEBUG: forzar roll a los nuevos buffs ESPADA / ESCUDO / ESCUDO_RAYO al
 198+ 0000              ; 33% cada uno. Util para probar fase 3 (sin estar todavia en RouletteOrder
 199+ 0000              ; ni en PROB_*_END). Pone a 0 para volver a distribución normal.
 200+ 0000              DEBUG_FORCE_NEW_BUFFS EQU 0
 201+ 0000
 202+ 0000              ; --- Step-up / sidestep del player ---
 203+ 0000              ; Rango de nudges (px) probados perpendicularmente al toparse con un obstaculo.
 204+ 0000              ; Iterativo MIN..MAX. Por cada nivel se prueban ambas direcciones (UP/DOWN o
 205+ 0000              ; LEFT/RIGHT) antes de avanzar al siguiente.
 206+ 0000              ;   MIN=8: descarta lifts sub-char (1-7 px) que serian espurios al rozar
 207+ 0000              ;     bordes de char en transiciones entre sprites adyacentes. Solo lifts
 208+ 0000              ;     "reales" de >=1 char.
 209+ 0000              ;   MAX=12: cubre alineamientos Y%8=4 que requieren 9-12 px para clarear
 210+ 0000              ;     un obstaculo de 1 char.
 211+ 0000              MIN_STEP_LIFT       EQU 8
 212+ 0000              MAX_STEP_LIFT       EQU 12
 213+ 0000
 214+ 0000              ; --- Stamina / Salud ---
 215+ 0000              STAMINA_MAX         EQU 16          ; Nivel maximo (= 16 scanlines del HUD)
 216+ 0000              HEALTH_MAX          EQU 16
 217+ 0000              STAMINA_DRAIN_RATE  EQU 13          ; 13 frames a 25fps ~0.5s (era 25 a 50fps)
 218+ 0000              STAMINA_REGEN_RATE  EQU 50          ; 50 frames a 25fps = 2s
 219+ 0000              HEALTH_REGEN_RATE   EQU 100         ; 100 frames a 25fps = 4s
 220+ 0000              STAMINA_THRESHOLD_HIGH EQU 12       ; >= libre (continuo)
 221+ 0000              STAMINA_THRESHOLD_MID  EQU 7        ; >= fixed swing
 222+ 0000              STAMINA_THRESHOLD_LOW  EQU 3        ; >= cooldown corto
 223+ 0000              ; < LOW = cooldown largo + 1 punto recuperado tras cada cooldown
 224+ 0000              ATTACK_COOLDOWN_FRAMES EQU 10       ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
 225+ 0000              ATTACK_SWING_FRAMES EQU ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT ; Opcion C: = 1 ciclo de animacion
 226+ 0000              SCARE_FLEE_THRESHOLD EQU 50          ; 50 a 25fps (era 100 a 50fps)
 227+ 0000              SCARE_TIMER_BELLS EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 228+ 0000              SCARE_TIMER_DAWN  EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 229+ 0000              FLEE_PLAYER_AVOID EQU 12            ; Pixeles de proximidad para evitar al player al huir
 230+ 0000              NEAR_ENTRY_DIST EQU 30              ; Distancia minima monster-entrada al restaurar room
 231+ 0000
 232+ 0000              ; --- Spawn system ---
 233+ 0000              SPAWN_INTERVAL  EQU 12              ; ~0.5s a 25fps (era 25 = 1s) — primer nasty post-transition
 234+ 0000                                                  ; (Gap entre spawns consecutivos = R AND 7 frames, 0-0.28s)
 235+ 0000
 236+ 0000              ; --- La muerte (TYPE_DEATH, slot 11) ---
 237+ 0000              DEATH_SPAWN_FRAMES   EQU 250         ; 10s a 25fps. Pausa con TimeFrozen=1.
 238+ 0000              DEATH_SPEED          EQU 1           ; 1 px por update; acumulador 1/2 -> mueve cada 2 frames
 239+ 0000              DEATH_STUCK_THRESHOLD EQU 6          ; Frames sin movimiento -> activar BFS rescue
 240+ 0000              DEATH_BFS_MAX_DEPTH  EQU 3           ; Profundidad max del mini-BFS (diamond ~25 cells)
 241+ 0000              DEATH_GHOST_FRAMES   EQU 96          ; 3.84s a 25fps. Sincronizado: cae justo al final del silencio post-8a nota de DeathMusicTable (8 beats x 12 frames). Ghost mode persistente hasta despawn.
 242+ 0000
 243+ 0000              ; --- Pausa cinematografica tras 3a captura en iglesia ---
 244+ 0000              POST_TRAP_NASTY_DELAY  EQU 100       ; 4s @ 25fps. Total de la pausa post-cutscene.
 245+ 0000              POST_TRAP_KEY_DELAY    EQU 75        ; Frame del timer al que aparece la llave (1s desde el cutscene -> 3s antes de nasties).
 246+ 0000              POST_TRAP_LASTING_DELAY EQU 60       ; Frame del timer al que aparece compass_lasting (~0.6s tras el cheque).
 247+ 0000              DEATH_GHOST_SPEED    EQU SPEED_RUN   ; Velocidad ghost = SPEED_RUN del player (4 px/frame)
 248+ 0000              DEATH_MIN_SPAWN_DIST EQU 8           ; Min distancia BFS al player en cells. Evita instakill en cul-de-sac.
 249+ 0000
 250+ 0000              ; --- Well cooldown tras curar (modo prueba; ajustar al gusto) ---
 251+ 0000              ; --- Player lives ---
 252+ 0000              PLAYER_LIVES_INIT       EQU 3            ; Vidas iniciales
 253+ 0000              PLAYER_LIVES_MAX        EQU 5            ; Cap (futuro Life pickup incrementa hasta este max)
 254+ 0000
 255+ 0000              ; --- Death border flash ---
 256+ 0000              DEATH_BORDER_YELLOW_FRAMES EQU 50        ; 2s a 25fps
 257+ 0000              DEATH_BORDER_RED_FRAMES    EQU 50        ; 2s a 25fps
 258+ 0000
 259+ 0000              ; --- Player death animation (durante fase yellow del border flash) ---
 260+ 0000              PLAYER_DEATH_ANIM_DELAY  EQU 13          ; ~0.5s a 25fps por frame (3 frames ≈ 1.5s; resto del yellow queda en frame final)
 261+ 0000              PLAYER_DEATH_ANIM_FRAMES EQU 3           ; Frames de la anim de muerte del player
 262+ 0000
 263+ 0000              ; --- Respawn blink ---
 264+ 0000              ; Phase 1: countdown "3, 2, 1!" - 3 beats con flash + bip; ultimo bip largo bloqueante.
 265+ 0000              ; Beats van back-to-back: tras cada SFX (500ms o 1000ms) hay un flash off de 4 frames
 266+ 0000              ; antes del siguiente beat -> fase 1 ~= 2 * (500ms + 160ms) + 1000ms = ~2.3s.
 267+ 0000              RESPAWN_FLASH_FRAMES       EQU 6         ; ~240ms silencio entre beats
 268+ 0000              ; Phase 2: gracia ~1s con control + blink rapido. Activada tambien tras cada
 269+ 0000              ; hit de monster/nasty (CheckPlayerEnemyCollision.pHpDmgNotZero) — invulnerable
 270+ 0000              ; durante 1s con feedback visual de blink. Compartida via EnterGracePhase.
 271+ 0000              RESPAWN_GRACE_FRAMES       EQU 25        ; ~1s a 25fps
 272+ 0000              RESPAWN_GRACE_BLINK_PERIOD EQU 2         ; ~80ms entre toggles (bit 1 frame counter)
 273+ 0000
 274+ 0000              WELL_COOLDOWN_FRAMES  EQU 125        ; 5 s @ 25 fps
 275+ 0000              WELL_COOLDOWN_ATTR_L  EQU $78        ; Celda inferior-izq: BRIGHT + PAPER WHITE
 276+ 0000              WELL_COOLDOWN_ATTR_R  EQU $38        ; Celda inferior-der: PAPER WHITE (sin bright)
 277+ 0000
 278+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 279+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 280+ 0000
 281+ 0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 282+ 0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 283+ 0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 284+ 0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 285+ 0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 286+ 0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 287+ 0000
 288+ 0000              ; ==============================================================================
 289+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 290+ 0000              ; ==============================================================================
 291+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 292+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 293+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 294+ 0000              ;
 295+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 296+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 297+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 298+ 0000              ; ==============================================================================
 299+ 0000
 300+ 0000              ; --- Dimensiones del mapa ---
 301+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 302+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 303+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 304+ 0000
 305+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 306+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 307+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 308+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 309+ 0000
 310+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 311+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 312+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 313+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 314+ 0000
 315+ 0000              ; --- Tipos de tile ---
 316+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 317+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 318+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 319+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 320+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 321+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 322+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 323+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 324+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 325+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 326+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 327+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 328+ 0000
 329+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 330+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 331+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 332+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 333+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 334+ 0000
 335+ 0000              ; --- Posicion inicial del jugador: definida en screen_data.asm (level editor) ---
 336+ 0000
 337+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 338+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 339+ 0000
 340+ 0000              ; ==============================================================================
 341+ 0000              ; MONSTER AI v2 (fase 2 — estructuras en RAM + bank 6)
 342+ 0000              ; ==============================================================================
 343+ 0000              ; Timings tuneables. Unidad: frames a 25fps.
 344+ 0000              MAI_LINGER_NORMAL   EQU 18          ; ~0.7s — migrar tras abandono sin push
 345+ 0000              MAI_LINGER_PUSHED   EQU 25          ; ~1s — vuelta tras knockback de espada
 346+ 0000              MAI_ENTRY_OFFSET    EQU 0           ; Spawn inicial: al borde mismo (Regla 1)
 347+ 0000              MAI_REENTRY_OFFSET  EQU 16          ; Reaparicion tras push: 2 chars dentro (Regla 4)
 348+ 0000              MAI_WAIT_OFFSET     EQU 40          ; Offset del migrado "esperando" desde entry gap (evita solape con player)
 349+ 0000
 350+ 0000              ; Lados de un screen (coincide con ScreenGaps_*.asm y el campo EntryBorder)
 351+ 0000              MAI_SIDE_N          EQU 0
 352+ 0000              MAI_SIDE_S          EQU 1
 353+ 0000              MAI_SIDE_W          EQU 2
 354+ 0000              MAI_SIDE_E          EQU 3
 355+ 0000
 356+ 0000              ; Flags por monster (campo MonsterAiFlags[slot], 1 byte)
 357+ 0000              MAI_FLAG_PUSHED     EQU %00000001   ; bit 0: empujado por espada (usar LINGER_PUSHED)
 358+ 0000              MAI_FLAG_LEAVING    EQU %00000010   ; bit 1: buscando hueco y saliendo (amanecer/muerte)
 359+ 0000              MAI_FLAG_REMOTE     EQU %00000100   ; bit 2: asentado en una room distinta al player
 360+ 0000              MAI_FLAG_SHAKE_SAVED EQU %00001000  ; bit 3: orig POSX/POSY guardados para shake del amanecer
 361+ 0000
 362+ 0000              ; ScreenGaps: DEFB count, {side, coord} × count
 363+ 0000              MAI_GAP_REC_SIZE    EQU 2           ; bytes por entrada de gap
 364+ 0000
 365+ 0000              ; RoomHistory: ventana de las ultimas 3 rooms distintas visitadas.
 366+ 0000              MAI_HISTORY_LEN     EQU 3
 367+ 0000
 368+ 0000              ; Flow field: direcciones resueltas + intervalo de recomputacion
 369+ 0000              MAI_DIR_NONE        EQU $FF
 370+ 0000              MAI_DIR_N           EQU 0
 371+ 0000              MAI_DIR_S           EQU 1
 372+ 0000              MAI_DIR_W           EQU 2
 373+ 0000              MAI_DIR_E           EQU 3
 374+ 0000              MAI_FLOW_INTERVAL   EQU 10          ; frames entre recomputaciones de BFS
 375+ 0000
 376+ 0000              ; ==============================================================================
 377+ 0000              ; RANDOM PICKUPS — slot marker + tunables
 378+ 0000              ; ==============================================================================
 379+ 0000              ; Sistema: cada plantilla puede llevar hasta 4 placements con id RANDOM_SLOT_MARKER.
 380+ 0000              ; Al entrar en una sala, el engine elige UN slot al azar y rolea su contenido
 381+ 0000              ; segun probabilidades acumulativas sobre un byte RNG (0-255). Tipos:
 382+ 0000              ;   life / health / stamina / rayo (boost) / caracol (slow) / nada.
 383+ 0000              ; Sin proteccion anti-farm: rerollea cada room-enter.
 384+ 0000              RANDOM_SLOT_MARKER      EQU 210         ; sprite id reservado en bg_sprites.json ("random pickup")
 385+ 0000              RANDOM_SLOT_MAX         EQU 4           ; max slots por sala (= max placements id=210 por plantilla)
 386+ 0000
 387+ 0000              ; --- Pickup amounts (lo que da cada uno al recogerlo) ---
 388+ 0000              PICKUP_HEALTH_AMT       EQU 8           ; +health, clamp a HEALTH_MAX
 389+ 0000              PICKUP_STAMINA_AMT      EQU 8           ; +stamina, clamp a STAMINA_MAX
 390+ 0000              ; +1 vida, clamp a PLAYER_LIVES_MAX (constante existente)
 391+ 0000
 392+ 0000              ; --- Speed buffs (rayo / caracol) ---
 393+ 0000              SPEED_BUFF_RAYO_FRAMES    EQU 250       ; 10s @ 25fps. Tunable.
 394+ 0000              SPEED_BUFF_CARACOL_FRAMES EQU 125       ;  5s @ 25fps. Tunable.
 395+ 0000
 396+ 0000              ; --- Mushroom debuff: bloquea ataque durante MUSHROOM_LOCK_FRAMES ---
 397+ 0000              MUSHROOM_LOCK_FRAMES     EQU 125        ;  5s @ 25fps. Tunable.
 398+ 0000              MUSHROOM_LOCK_ATTR       EQU MAGENTA | $40   ; $43 magenta bright
 399+ 0000
 400+ 0000              ; --- Magic compass: power-up que muestra ruta exacta sala-a-sala ---
 401+ 0000              ; Timer 16-bit en frames de juego (25fps tras catchup): 25s = 625 frames.
 402+ 0000              ; Warning de los ultimos 5s: 125 frames -> blink/tick aceleran.
 403+ 0000              MAGIC_COMPASS_FRAMES        EQU 625     ; 25s @ 25fps
 404+ 0000              MAGIC_COMPASS_WARNING_FRAMES EQU 125    ; ultimos 5s -> blink x2 + tick x2
 405+ 0000              ; Blink: alterna paper amarillo ON/OFF cada N frames de juego (25fps).
 406+ 0000              ;   normal:  4 frames/fase -> 8 frames/ciclo -> ~3.1 Hz
 407+ 0000              ;   warning: 2 frames/fase -> 4 frames/ciclo -> ~6.2 Hz
 408+ 0000              MAGIC_COMPASS_BLINK_NORMAL  EQU 4
 409+ 0000              MAGIC_COMPASS_BLINK_WARNING EQU 2
 410+ 0000              ; Char activo (mientras suena el tick): override fijo del attr al char que
 411+ 0000              ; toca, ignorando el color base del editor. Da contraste fuerte de "white
 412+ 0000              ; bright" sobre el color base de los demás chars.
 413+ 0000              ;   $47 = ink white + paper black + bright (mismo "white bright" que la X
 414+ 0000              ;   normal cuando estás en sala destino).
 415+ 0000              ;
 416+ 0000              ; OJO: si los chars del sprite están diseñados con paper distinto a black
 417+ 0000              ; (e.g. paper white), los pixels se "invierten" al aplicar este override
 418+ 0000              ; porque cambia la polaridad paper/ink. Para que se vea natural, diseña los
 419+ 0000              ; 4 chars de los sprites ID 36 / ID 37 con PAPER BLACK + INK del color que prefieras —
 420+ 0000              ; al activar el char el bright lo destaca sin invertir nada.
 421+ 0000              MAGIC_COMPASS_ACTIVE_ATTR   EQU WHITE | $40          ; $47
 422+ 0000              ; Tick heartbeat AY: cada N game frames suena beep corto.
 423+ 0000              ;   normal:  25 frames -> 1.0 s
 424+ 0000              ;   warning: 12 frames -> ~0.5 s
 425+ 0000              MAGIC_COMPASS_TICK_NORMAL   EQU 25
 426+ 0000              MAGIC_COMPASS_TICK_WARNING  EQU 12
 427+ 0000              ; Period AY del tick (canal B). Mas alto = mas grave.
 428+ 0000              MAGIC_COMPASS_TICK_PERIOD   EQU $00C0    ; ~570 Hz tick suave
 429+ 0000              MAGIC_COMPASS_TICK_DURATION EQU 2        ; frames del beep (cutoff abrupto)
 430+ 0000              ; Iteraciones máx del BFS sala-a-sala por frame. El BFS se amortiza en chunks
 431+ 0000              ; pequeños para no gastar el presupuesto del frame post-transición de golpe
 432+ 0000              ; (eso causaba parpadeo del reloj HUD). 8 iter/frame = ~3-4 frames totales
 433+ 0000              ; para un BFS típico (path 13 saltos, ~30 iter en total).
 434+ 0000              MAGIC_COMPASS_BFS_ITERS_PER_FRAME EQU 32      ; 4x mas rapido. Cada chunk dura ~1.8 ms bajo DI; periodo IRQ 20 ms → sin riesgo.
 435+ 0000              SPEED_BUFF_RAYO_RUN     EQU 6           ; 1.5x SPEED_RUN
 436+ 0000              SPEED_BUFF_RAYO_FIGHT   EQU 3           ; 1.5x SPEED_FIGHT
 437+ 0000              SPEED_BUFF_CARACOL_RUN  EQU 2           ; 0.5x SPEED_RUN
 438+ 0000              SPEED_BUFF_CARACOL_FIGHT EQU 1          ; 0.5x SPEED_FIGHT
 439+ 0000              ; Player attr aplicado durante buff (paper black + ink bright):
 440+ 0000              SPEED_BUFF_RAYO_ATTR    EQU CYAN  | $40 ; $45 cyan bright
 441+ 0000              SPEED_BUFF_CARACOL_ATTR EQU GREEN | $40 ; $44 green bright
 442+ 0000              ; SpeedBuffType encoding (RAM):
 443+ 0000              SPEED_BUFF_NONE         EQU 0
 444+ 0000              SPEED_BUFF_TYPE_RAYO    EQU 1
 445+ 0000              SPEED_BUFF_TYPE_CARACOL EQU 2
 446+ 0000
 447+ 0000              ; --- ESPADA buff (no consume stamina + ataca a 0 + cancela cooldown azul) ---
 448+ 0000              ESPADA_BUFF_FRAMES      EQU 12 * 25                     ; 12s a 25 fps = 300 frames
 449+ 0000              ESPADA_BUFF_ATTR        EQU RED   | $40                 ; $42 red bright
 450+ 0000
 451+ 0000              ; --- ESCUDO buff (invulnerabilidad contra nasti/monster contact, knockback persiste) ---
 452+ 0000              ESCUDO_BUFF_FRAMES      EQU 15 * 25                     ; 15s a 25 fps = 375 frames
 453+ 0000              ESCUDO_BUFF_ATTR        EQU YELLOW | $40                ; $46 yellow bright
 454+ 0000
 455+ 0000              ; --- Player color cycler ---
 456+ 0000              ; Cada COLOR_CYCLER_PERIOD frames, el cycler avanza al siguiente color de
 457+ 0000              ; entre los buffs/debuffs activos. 12 frames = ~480ms por color a 25 fps.
 458+ 0000              ; Con N buffs activos, ciclo completo dura N * 480ms.
 459+ 0000              COLOR_CYCLER_PERIOD     EQU 12
 460+ 0000
 461+ 0000              ; --- Probabilidades del roll (TUNE) ---
 462+ 0000              ; Umbrales acumulativos sobre RNG byte (0-255). Definidos como suma encadenada
 463+ 0000              ; (cada uno = el anterior + su peso) → cambiar el peso de un tipo no rompe los
 464+ 0000              ; siguientes; el slack va a "nada".
 465+ 0000              ; Ratio actual: life:health:stamina:rayo:caracol:roulette:mushroom:compass:nada
 466+ 0000              ;             = 0.5:1:1:1:1:1:1:0.5:18
 467+ 0000              ;   life     = 0.5X = 8    (3.1%)
 468+ 0000              ;   health   = 1X   = 16   (6.3%)
 469+ 0000              ;   stamina  = 1X   = 16   (6.3%)
 470+ 0000              ;   rayo     = 1X   = 16   (6.3%)
 471+ 0000              ;   caracol  = 1X   = 16   (6.3%)
 472+ 0000              ;   roulette = 1X   = 16   (6.3%)
 473+ 0000              ;   mushroom = 1X   = 16   (6.3%)
 474+ 0000              ;   compass  = 0.5X = 8    (3.1%)  -> mismo peso que life (drop "raro")
 475+ 0000              ;   nada     = resto = 144 (56.3%)
 476+ 0000              PICKUP_X                EQU 16
 477+ 0000              PROB_LIFE_END           EQU PICKUP_X / 2                                        ; 8
 478+ 0000              PROB_HEALTH_END         EQU PROB_LIFE_END + PICKUP_X                            ; 24
 479+ 0000              PROB_STAMINA_END        EQU PROB_HEALTH_END + PICKUP_X                         ; 40
 480+ 0000              PROB_RAYO_END           EQU PROB_STAMINA_END + PICKUP_X                         ; 56
 481+ 0000              PROB_CARACOL_END        EQU PROB_RAYO_END + PICKUP_X                            ; 72
 482+ 0000              PROB_ROULETTE_END       EQU PROB_CARACOL_END + PICKUP_X                         ; 88
 483+ 0000              PROB_MUSHROOM_END       EQU PROB_ROULETTE_END + PICKUP_X                        ; 104
 484+ 0000              PROB_COMPASS_END        EQU PROB_MUSHROOM_END + PICKUP_X / 2                    ; 112
 485+ 0000              ; resto [112..256) -> nada (56.3%)
 486+ 0000
 487+ 0000              ; --- Roulette: cicla entre los tipos definidos en RouletteOrder ---
 488+ 0000              ; Cada ROULETTE_CYCLE_FRAMES, el sprite/efecto del synth pickup avanza un
 489+ 0000              ; paso en RouletteOrder. Al recoger, se aplica el efecto del tipo activo.
 490+ 0000              ROULETTE_CYCLE_FRAMES   EQU 12                          ; ~480ms @ 25fps por tipo. Tunable.
 491+ 0000              ; Type ids usados por RouletteOrder + lookup en RouletteTypePtrs:
 492+ 0000              ROUL_LIFE               EQU 1
 493+ 0000              ROUL_HEALTH             EQU 2
 494+ 0000              ROUL_STAMINA            EQU 3
 495+ 0000              ROUL_RAYO               EQU 4
 496+ 0000              ROUL_CARACOL            EQU 5
 497+ 0000              ROUL_MUSHROOM           EQU 6
 498+ 0000              ROUL_COMPASS            EQU 7
 499+ 0000
 500+ 0000              ; --- Random pickup memory cache: encoding del campo "rolled" ---
 501+ 0000              ; Identifica el resultado del roll guardado en el cache (cur/prev). 0 = NONE
 502+ 0000              ; cubre dos casos: roll original cayo en "nada", o el pickup ya fue consumido
 503+ 0000              ; (CheckRandomSyntheticPickup zappea cur.rolled=0 al hit). Restaurar NONE
 504+ 0000              ; equivale a "no spawnea pickup en esta sala" -> evita farmeo por respawn.
 505+ 0000              ROLLED_NONE             EQU 0
 506+ 0000              ROLLED_LIFE             EQU 1
 507+ 0000              ROLLED_HEALTH           EQU 2
 508+ 0000              ROLLED_STAMINA          EQU 3
 509+ 0000              ROLLED_RAYO             EQU 4
 510+ 0000              ROLLED_CARACOL          EQU 5
 511+ 0000              ROLLED_ROULETTE         EQU 6
 512+ 0000              ROLLED_MUSHROOM         EQU 7
 513+ 0000              ROLLED_COMPASS          EQU 8
 514+ 0000              ROLLED_ESPADA           EQU 9
 515+ 0000              ROLLED_ESCUDO           EQU 10
 516+ 0000              ROLLED_ESCUDO_RAYO      EQU 11
 517+ 0000
