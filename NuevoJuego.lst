2851+ B27F                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2852+ B27F                  ;
2853+ B27F                  ; Doble comportamiento:
2854+ B27F                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2855+ B27F                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2856+ B27F                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2857+ B27F                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2858+ B27F                  ;   y lo activa).
2859+ B27F                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2860+ B27F                  ;   El monster queda en destino (memoria) hasta que el player visite.
2861+ B27F                  ;
2862+ B27F                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2863+ B27F                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2864+ B27F DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2865+ B282 32 C3 B2         LD (.moKbSavedDir), A
2866+ B285 3E 01            LD A, 1
2867+ B287 32 00 B6         LD (MonsterKbDespawn), A
2868+ B28A                  ; Calcular slot (0-2) en E, D=0
2869+ B28A DD E5            PUSH IX
2870+ B28C E1               POP HL
2871+ B28D 11 D7 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
2872+ B290 B7               OR A
2873+ B291 ED 52            SBC HL, DE
2874+ B293 CB 3D            SRL L
2875+ B295 CB 3D            SRL L
2876+ B297 CB 3D            SRL L
2877+ B299 CB 3D            SRL L
2878+ B29B 5D               LD E, L
2879+ B29C 16 00            LD D, 0
2880+ B29E                  ; Clear MAI_FLAG_LEAVING
2881+ B29E 21 53 90         LD HL, MonsterAiFlags
2882+ B2A1 19               ADD HL, DE
2883+ B2A2 7E               LD A, (HL)
2884+ B2A3 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
2885+ B2A5 77               LD (HL), A
2886+ B2A6                  ; MonsterRoomId[slot] = neighbor_id (destino)
2887+ B2A6 3A C3 B2         LD A, (.moKbSavedDir)
2888+ B2A9 CD A4 92         CALL MaiGetNeighborScreenId
2889+ B2AC 21 47 90         LD HL, MonsterRoomId
2890+ B2AF 19               ADD HL, DE
2891+ B2B0 77               LD (HL), A
2892+ B2B1                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
2893+ B2B1 3A C3 B2         LD A, (.moKbSavedDir)
2894+ B2B4 CD 03 93         CALL MaiDirToEntrySide
2895+ B2B7 21 4D 90         LD HL, MonsterEntryBorder
2896+ B2BA 19               ADD HL, DE
2897+ B2BB 77               LD (HL), A
2898+ B2BC                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
2899+ B2BC 21 02 B6         LD HL, MonsterReturnTimer
2900+ B2BF 19               ADD HL, DE
2901+ B2C0 36 19            LD (HL), MAI_LINGER_PUSHED
2902+ B2C2 C9               RET
