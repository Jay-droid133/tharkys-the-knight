 304+ 9AFD              ; ==============================================================================
 305+ 9AFD              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9AFD              ; ==============================================================================
 307+ 9AFD              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9AFD              ; Se llama ANTES de pintar el sprite.
 309+ 9AFD              ;
 310+ 9AFD              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9AFD              ;          IX = puntero al sprite (para leer width/height)
 312+ 9AFD              ; ==============================================================================
 313+ 9AFD              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9AFD              ; ==============================================================================
 315+ 9AFD              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9AFD              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9AFD              ; ==============================================================================
 318+ 9AFD              CalcEntityAttrSize:
 319+ 9AFD                  ; Paging inline (ver nota en DrawSprite)
 320+ 9AFD 3A 7B 8D         LD A, (CurrentPaging)
 321+ 9B00 E6 F8            AND $F8
 322+ 9B02 F6 06            OR 6
 323+ 9B04 32 7B 8D         LD (CurrentPaging), A
 324+ 9B07 01 FD 7F         LD BC, $7FFD
 325+ 9B0A ED 79            OUT (C), A
 326+ 9B0C CD 1D 9B         CALL _CalcEntityAttrSizeImpl
 327+ 9B0F 3A 7B 8D         LD A, (CurrentPaging)
 328+ 9B12 E6 F8            AND $F8
 329+ 9B14 32 7B 8D         LD (CurrentPaging), A
 330+ 9B17 01 FD 7F         LD BC, $7FFD
 331+ 9B1A ED 79            OUT (C), A
 332+ 9B1C C9               RET
 333+ 9B1D
 334+ 9B1D              _CalcEntityAttrSizeImpl:
 335+ 9B1D DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9B20 47               LD B, A
 337+ 9B21 7B               LD A, E
 338+ 9B22 E6 07            AND 7
 339+ 9B24 28 01            JR Z, .ceNoExtra
 340+ 9B26 04               INC B
 341+ 9B27              .ceNoExtra:
 342+ 9B27 78               LD A, B
 343+ 9B28 32 CE 9B         LD (EntityAttrW), A
 344+ 9B2B 7A               LD A, D
 345+ 9B2C E6 07            AND 7
 346+ 9B2E 4F               LD C, A
 347+ 9B2F DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9B32 81               ADD A, C
 349+ 9B33 C6 07            ADD A, 7
 350+ 9B35 0F               RRCA
 351+ 9B36 0F               RRCA
 352+ 9B37 0F               RRCA
 353+ 9B38 E6 1F            AND $1F
 354+ 9B3A 32 CF 9B         LD (EntityAttrH), A
 355+ 9B3D C9               RET
 356+ 9B3E
 357+ 9B3E              ; ==============================================================================
 358+ 9B3E              SaveEntityAttr:
 359+ 9B3E                  ; Paging inline (ver nota en DrawSprite)
 360+ 9B3E 3A 7B 8D         LD A, (CurrentPaging)
 361+ 9B41 E6 F8            AND $F8
 362+ 9B43 F6 06            OR 6
 363+ 9B45 32 7B 8D         LD (CurrentPaging), A
 364+ 9B48 01 FD 7F         LD BC, $7FFD
 365+ 9B4B ED 79            OUT (C), A
 366+ 9B4D CD 5E 9B         CALL _SaveEntityAttrImpl
 367+ 9B50 3A 7B 8D         LD A, (CurrentPaging)
 368+ 9B53 E6 F8            AND $F8
 369+ 9B55 32 7B 8D         LD (CurrentPaging), A
 370+ 9B58 01 FD 7F         LD BC, $7FFD
 371+ 9B5B ED 79            OUT (C), A
 372+ 9B5D C9               RET
 373+ 9B5E
 374+ 9B5E              _SaveEntityAttrImpl:
 375+ 9B5E                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B5E DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B61 47               LD B, A
 378+ 9B62 7B               LD A, E                     ; X pixel (raw)
 379+ 9B63 E6 07            AND 7
 380+ 9B65 28 01            JR Z, .noExtraW
 381+ 9B67 04               INC B                       ; +1 columna si no alineado
 382+ 9B68              .noExtraW:
 383+ 9B68 78               LD A, B
 384+ 9B69 32 CE 9B         LD (EntityAttrW), A
 385+ 9B6C
 386+ 9B6C                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B6C 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B6D E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B6F 4F               LD C, A
 390+ 9B70 DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9B73 81               ADD A, C                    ; + Y offset
 392+ 9B74 C6 07            ADD A, 7
 393+ 9B76 0F               RRCA
 394+ 9B77 0F               RRCA
 395+ 9B78 0F               RRCA
 396+ 9B79 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9B7B 32 CF 9B         LD (EntityAttrH), A
 398+ 9B7E
 399+ 9B7E CD 38 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9B81 11 BE 9B         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9B84
 402+ 9B84 3A CF 9B         LD A, (EntityAttrH)
 403+ 9B87 4F               LD C, A                     ; C = filas
 404+ 9B88              .saveRow:
 405+ 9B88 3A CE 9B         LD A, (EntityAttrW)
 406+ 9B8B 47               LD B, A                     ; B = columnas
 407+ 9B8C E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9B8D              .saveCol:
 409+ 9B8D 7E               LD A, (HL)
 410+ 9B8E 12               LD (DE), A
 411+ 9B8F 23               INC HL
 412+ 9B90 13               INC DE
 413+ 9B91 10 FA            DJNZ .saveCol
 414+ 9B93 E1               POP HL
 415+ 9B94                  ; Siguiente fila attr: HL += 32
 416+ 9B94 D5               PUSH DE
 417+ 9B95 11 20 00         LD DE, 32
 418+ 9B98 19               ADD HL, DE
 419+ 9B99 D1               POP DE
 420+ 9B9A 0D               DEC C
 421+ 9B9B 20 EB            JR NZ, .saveRow
 422+ 9B9D C9               RET
 423+ 9B9E
 424+ 9B9E              ; ==============================================================================
 425+ 9B9E              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9B9E              ; ==============================================================================
 427+ 9B9E              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9B9E              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9B9E              ;
 430+ 9B9E              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9B9E              ; ==============================================================================
 432+ 9B9E              RestoreEntityAttr:
 433+ 9B9E CD 38 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BA1 11 BE 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BA4
 436+ 9BA4 3A CF 9B         LD A, (EntityAttrH)
 437+ 9BA7 4F               LD C, A
 438+ 9BA8              .restRow:
 439+ 9BA8 3A CE 9B         LD A, (EntityAttrW)
 440+ 9BAB 47               LD B, A
 441+ 9BAC E5               PUSH HL
 442+ 9BAD              .restCol:
 443+ 9BAD 1A               LD A, (DE)
 444+ 9BAE 77               LD (HL), A
 445+ 9BAF 23               INC HL
 446+ 9BB0 13               INC DE
 447+ 9BB1 10 FA            DJNZ .restCol
 448+ 9BB3 E1               POP HL
 449+ 9BB4 D5               PUSH DE
 450+ 9BB5 11 20 00         LD DE, 32
 451+ 9BB8 19               ADD HL, DE
 452+ 9BB9 D1               POP DE
 453+ 9BBA 0D               DEC C
 454+ 9BBB 20 EB            JR NZ, .restRow
 455+ 9BBD C9               RET
 456+ 9BBE
 457+ 9BBE              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BBE              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BBE              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BBE              ; ---
 461+ 9BBE 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BCE 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BCF 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BD0 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D02 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D03
 467+ 9D03              ; ==============================================================================
 468+ 9D03              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D03              ; ==============================================================================
 470+ 9D03              ; Entrada: A = indice de entidad (0-16)
 471+ 9D03              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D03              ; ==============================================================================
 473+ 9D03              SetAttrSlot:
 474+ 9D03 32 02 9D         LD (CurrentAttrSlot), A
 475+ 9D06                  ; Calcular offset: A * 18
 476+ 9D06 6F               LD L, A
 477+ 9D07 26 00            LD H, 0
 478+ 9D09 29               ADD HL, HL                  ; x2
 479+ 9D0A 54               LD D, H
 480+ 9D0B 5D               LD E, L                     ; DE = x2
 481+ 9D0C 29               ADD HL, HL                  ; x4
 482+ 9D0D 29               ADD HL, HL                  ; x8
 483+ 9D0E 29               ADD HL, HL                  ; x16
 484+ 9D0F 19               ADD HL, DE                  ; x18
 485+ 9D10 11 D0 9B         LD DE, SavedAttrTable
 486+ 9D13 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D14                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D14 11 BE 9B         LD DE, EntitySavedAttr
 489+ 9D17 01 12 00         LD BC, 18
 490+ 9D1A ED B0            LDIR
 491+ 9D1C C9               RET
 492+ 9D1D
 493+ 9D1D              ; ==============================================================================
 494+ 9D1D              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D1D              ; ==============================================================================
 496+ 9D1D              FlushAttrSlot:
 497+ 9D1D 3A 02 9D         LD A, (CurrentAttrSlot)
 498+ 9D20 6F               LD L, A
 499+ 9D21 26 00            LD H, 0
 500+ 9D23 29               ADD HL, HL                  ; x2
 501+ 9D24 54               LD D, H
 502+ 9D25 5D               LD E, L
 503+ 9D26 29               ADD HL, HL                  ; x4
 504+ 9D27 29               ADD HL, HL                  ; x8
 505+ 9D28 29               ADD HL, HL                  ; x16
 506+ 9D29 19               ADD HL, DE                  ; x18
 507+ 9D2A 11 D0 9B         LD DE, SavedAttrTable
 508+ 9D2D 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D2E EB               EX DE, HL                   ; DE = destino
 510+ 9D2F 21 BE 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D32 01 12 00         LD BC, 18
 512+ 9D35 ED B0            LDIR
 513+ 9D37 C9               RET
 514+ 9D38
 515+ 9D38              ; ==============================================================================
 516+ 9D38              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D38              ; ==============================================================================
 518+ 9D38              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D38              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D38              ; ==============================================================================
 521+ 9D38              CalcAttrAddr:
 522+ 9D38 7A               LD A, D
 523+ 9D39 0F               RRCA
 524+ 9D3A 0F               RRCA
 525+ 9D3B 0F               RRCA
 526+ 9D3C E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D3E 6F               LD L, A
 528+ 9D3F 26 00            LD H, 0
 529+ 9D41 29               ADD HL, HL
 530+ 9D42 29               ADD HL, HL
 531+ 9D43 29               ADD HL, HL
 532+ 9D44 29               ADD HL, HL
 533+ 9D45 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D46 7B               LD A, E
 535+ 9D47 0F               RRCA
 536+ 9D48 0F               RRCA
 537+ 9D49 0F               RRCA
 538+ 9D4A E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D4C B5               OR L
 540+ 9D4D 6F               LD L, A
 541+ 9D4E 01 00 58         LD BC, ATTR_BASE
 542+ 9D51 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D52 C9               RET
 544+ 9D53
 545+ 9D53              ; ==============================================================================
 546+ 9D53              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D53              ; ==============================================================================
 548+ 9D53              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D53              ; Salida: HL=direccion en VRAM
 550+ 9D53              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D53              ; ==============================================================================
 552+ 9D53              CalcPixelAddr:
 553+ 9D53 7A               LD A, D
 554+ 9D54 E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D56 1F               RRA
 556+ 9D57 1F               RRA
 557+ 9D58 1F               RRA                         ; >> 3
 558+ 9D59 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D5B 67               LD H, A
 560+ 9D5C
 561+ 9D5C 7A               LD A, D
 562+ 9D5D E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D5F B4               OR H
 564+ 9D60 67               LD H, A
 565+ 9D61
 566+ 9D61 7A               LD A, D
 567+ 9D62 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D64 87               ADD A, A
 569+ 9D65 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D66 6F               LD L, A
 571+ 9D67
 572+ 9D67 7B               LD A, E
 573+ 9D68 1F               RRA
 574+ 9D69 1F               RRA
 575+ 9D6A 1F               RRA
 576+ 9D6B E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D6D B5               OR L
 578+ 9D6E 6F               LD L, A
 579+ 9D6F C9               RET
 580+ 9D70
 581+ 9D70              ; ==============================================================================
 582+ 9D70              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D70              ; ==============================================================================
 584+ 9D70              DrawDebugInfo:
 585+ 9D70 3A 01 83         LD A, (CurrentScreenX)
 586+ 9D73 1E 00            LD E, 0
 587+ 9D75 CD 92 9D         CALL .drawHexDigit
 588+ 9D78
 589+ 9D78 3E 2C            LD A, ','
 590+ 9D7A 1E 01            LD E, 1
 591+ 9D7C CD 9E 9D         CALL .drawChar
 592+ 9D7F
 593+ 9D7F 3A 02 83         LD A, (CurrentScreenY)
 594+ 9D82 1E 02            LD E, 2
 595+ 9D84 CD 92 9D         CALL .drawHexDigit
 596+ 9D87
 597+ 9D87 21 00 58         LD HL, ATTR_BASE
 598+ 9D8A 3E 47            LD A, WHITE | $40
 599+ 9D8C 77               LD (HL), A
 600+ 9D8D 23               INC HL
 601+ 9D8E 77               LD (HL), A
 602+ 9D8F 23               INC HL
 603+ 9D90 77               LD (HL), A
 604+ 9D91 C9               RET
 605+ 9D92
 606+ 9D92              .drawHexDigit:
 607+ 9D92 E6 0F            AND $0F
 608+ 9D94 FE 0A            CP 10
 609+ 9D96 38 04            JR C, .isNum
 610+ 9D98 C6 37            ADD A, 'A' - 10
 611+ 9D9A 18 02            JR .drawChar
 612+ 9D9C              .isNum:
 613+ 9D9C C6 30            ADD A, '0'
 614+ 9D9E              .drawChar:
 615+ 9D9E 6F               LD L, A
 616+ 9D9F 26 00            LD H, 0
 617+ 9DA1 29               ADD HL, HL
 618+ 9DA2 29               ADD HL, HL
 619+ 9DA3 29               ADD HL, HL
 620+ 9DA4 01 00 3C         LD BC, $3C00
 621+ 9DA7 09               ADD HL, BC
 622+ 9DA8
 623+ 9DA8 16 40            LD D, $40
 624+ 9DAA 06 08            LD B, 8
 625+ 9DAC              .charLoop:
 626+ 9DAC 7E               LD A, (HL)
 627+ 9DAD 12               LD (DE), A
 628+ 9DAE 23               INC HL
 629+ 9DAF 14               INC D
 630+ 9DB0 10 FA            DJNZ .charLoop
 631+ 9DB2 C9               RET
