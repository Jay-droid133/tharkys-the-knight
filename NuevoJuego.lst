 179+ F1C0              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 180+ F1C0              ; Tres escalones ascendentes, tipo recarga
 181+ F1C0              SFX_WellRecover:
 182+ F1C0 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 183+ F1C4 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 184+ F1C8 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 185+ F1CC 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 186+ F1D0 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
