2940+ DB90 23               INC HL
2940+ DB91 77             LD (HL), A
2941+ DB92 23               INC HL
2941+ DB93 77             LD (HL), A
2942+ DB94 23               INC HL
2942+ DB95 77             LD (HL), A
2943+ DB96 23               INC HL
2943+ DB97 77             LD (HL), A             ; 5 cols
2944+ DB98 7D               LD A, L
2945+ DB99 D6 04            SUB 4
2946+ DB9B 6F               LD L, A                         ; volver al inicio de fila
2947+ DB9C 24               INC H                           ; siguiente scanline
2948+ DB9D 10 EF            DJNZ .dlhClrPx
2949+ DB9F                  ; --- Limpiar attrs (row 1 cols 26-30) ---
2950+ DB9F 3E 47            LD A, $47                       ; bright white on black
2951+ DBA1 32 3A 58         LD ($583A), A
2952+ DBA4 32 3B 58         LD ($583B), A
2953+ DBA7 32 3C 58         LD ($583C), A
2954+ DBAA 32 3D 58         LD ($583D), A
2955+ DBAD 32 3E 58         LD ($583E), A
2956+ DBB0
2957+ DBB0                  ; Si N=0, ya esta (strip limpio).
