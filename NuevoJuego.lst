2914+ DB73              ; DrawLivesHUD - Renderiza N iconos "Lives" (BG253, 8x8) en row 1 cols 26-30
2915+ DB73              ; ==============================================================================
2916+ DB73              ; N = min(PlayerLives, PLAYER_LIVES_MAX). Limpia el strip y dibuja N iconos.
2917+ DB73              ; ==============================================================================
2918+ DB73              DrawLivesHUD:
2919+ DB73                  ; --- Determinar N (cap a PLAYER_LIVES_MAX) ---
2920+ DB73 3A E1 82         LD A, (PlayerLives)
2921+ DB76 FE 06            CP PLAYER_LIVES_MAX + 1
2922+ DB78 38 02            JR C, .dlhCapOk
2923+ DB7A 3E 05            LD A, PLAYER_LIVES_MAX
2924+ DB7C              .dlhCapOk:
2925+ DB7C 47               LD B, A                         ; B = N actual
2926+ DB7D                  ; --- Skip si mismo valor que el ultimo dibujo (evita flicker) ---
2927+ DB7D 3A DF DB         LD A, (.dlhLast)
2928+ DB80 B8               CP B
2929+ DB81 C8               RET Z
2930+ DB82 78               LD A, B
2931+ DB83 32 DF DB         LD (.dlhLast), A
2932+ DB86 32 DE DB         LD (.dlhCount), A
