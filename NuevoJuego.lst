 233+ E608                  ; --- Punto central (borra el pixel = marca negra) ---
 234+ E608 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 235+ E60B CB 86            RES 0, (HL)
 236+ E60D C9               RET
 237+ E60E
 238+ E60E              .clkBlinkOff:
 239+ E60E                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 240+ E60E                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 241+ E60E                  ; paper=black + ink=black.
 242+ E60E AF               XOR A
 243+ E60F 32 0F 58         LD ($580F), A
 244+ E612 32 2F 58         LD ($582F), A
 245+ E615 32 10 58         LD ($5810), A
 246+ E618 32 30 58         LD ($5830), A
 247+ E61B C9               RET
