 204  E8A0                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ E8A0              ; ==============================================================================
   2+ E8A0              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ E8A0              ; ==============================================================================
   4+ E8A0              ; CurrentObjective vive en variables.asm. Valor:
   5+ E8A0              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ E8A0              ;   9    = todos los hitos completados (juego ganado)
   7+ E8A0              ;
   8+ E8A0              ; ----------------------------------------------------------------------------
   9+ E8A0              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ E8A0              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ E8A0              ;                       recoger el sprite cuyo behavior coincide.
  12+ E8A0              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ E8A0              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ E8A0              ;                       Avanza al disparar el trigger correspondiente.
  15+ E8A0              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ E8A0              ;
  17+ E8A0              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ E8A0              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ E8A0              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ E8A0              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ E8A0              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ E8A0              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ E8A0              ;
  24+ E8A0              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ E8A0              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ E8A0              ; mecanica real.
  27+ E8A0              ; ==============================================================================
  28+ E8A0
  29+ E8A0              MILESTONE_TYPE_PICKUP   EQU 1
  30+ E8A0              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ E8A0              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ E8A0
  33+ E8A0              MilestoneTable:
  34+ E8A0 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ E8A2 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ E8A4 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ E8A6 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ E8A8 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ E8AA 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ E8AC 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ E8AE 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ E8B0 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ E8B2
  44+ E8B2              MilestoneResolveTable:
  45+ E8B2 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ E8B4 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ E8B6 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ E8B8 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ E8BA 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ E8BC 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ E8BE 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ E8C0 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ E8C2 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ E8C4
  55+ E8C4              ; ==============================================================================
  56+ E8C4              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ E8C4              ; ==============================================================================
  58+ E8C4              ; IN:  A = key id (1..6) recien recogida
  59+ E8C4              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ E8C4              ; ==============================================================================
  61+ E8C4              CheckMilestonePickup:
  62+ E8C4 E5               PUSH HL
  63+ E8C5 D5               PUSH DE
  64+ E8C6 C5               PUSH BC
  65+ E8C7 F5               PUSH AF
