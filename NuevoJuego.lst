  42+ 8D9D D6 10            SUB SCREEN_MIN_Y
  43+ 8D9F 0F               RRCA
  44+ 8DA0 0F               RRCA
  45+ 8DA1 0F               RRCA
  46+ 8DA2 E6 1F            AND $1F
  47+ 8DA4 32 AB 97         LD (MaiFlowPlCy), A
  48+ 8DA7
  49+ 8DA7                  ; --- Swap a stack temporal (bank 2) ---
  50+ 8DA7 ED 73 B1 97      LD (MaiFlowSavedSP), SP
  51+ 8DAB 31 51 98         LD SP, MaiTempStackTop
  52+ 8DAE
  53+ 8DAE                  ; --- Ventana de paginacion ---
  54+ 8DAE                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 8DAE F3               DI
  56+ 8DAF 3A 7B 8D         LD A, (CurrentPaging)
  57+ 8DB2 E6 F8            AND $F8
  58+ 8DB4 F6 06            OR 6
  59+ 8DB6 32 7B 8D         LD (CurrentPaging), A
  60+ 8DB9 01 FD 7F         LD BC, $7FFD
  61+ 8DBC ED 79            OUT (C), A
  62+ 8DBE
  63+ 8DBE                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 8DBE CD DA 8D         CALL MaiFlowBfs
  65+ 8DC1
  66+ 8DC1                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 8DC1 3A 7B 8D         LD A, (CurrentPaging)
  68+ 8DC4 E6 F8            AND $F8
  69+ 8DC6 32 7B 8D         LD (CurrentPaging), A
  70+ 8DC9 01 FD 7F         LD BC, $7FFD
  71+ 8DCC ED 79            OUT (C), A
  72+ 8DCE
  73+ 8DCE ED 7B B1 97      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 8DD2 3A 93 81         LD A, (StartupComplete)
  75+ 8DD5 B7               OR A
  76+ 8DD6 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 8DD8 FB               EI
  78+ 8DD9              .mcffNoEI:
  79+ 8DD9 C9               RET
