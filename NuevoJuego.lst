 285+ 613C              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 286+ 613C              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 287+ 613C              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 288+ 613C              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 289+ 613C              ;
 290+ 613C              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 291+ 613C              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 292+ 613C              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 293+ 613C              ; capturamos para meterlos en STATE_DYING.
 294+ 613C              .tgPhWaitNasties:
 295+ 613C CD 47 BD         CALL KillAllActiveNasties           ; cazar spawnings recien terminados
 296+ 613F CD CE 63         CALL TownGateAllNastiesDeadCheck
 297+ 6142 28 04            JR Z, .tgWaitNastiesDone
 298+ 6144 CD 2A 63         CALL TownGateDecTimer               ; safety timeout
 299+ 6147 C0               RET NZ
 300+ 6148              .tgWaitNastiesDone:
 301+ 6148                  ; Refrescar attrs del player antes del walk: los puffs de nasties cerca
 302+ 6148                  ; del player pueden haber dejado attrs contaminados (color nasty) en
 303+ 6148                  ; sus celdas. TownGateRedrawPlayer hace erase + RestoreOldAttr (limpia
 304+ 6148                  ; desde CleanAttrMap) + draw + SetEntityAttr (player white).
 305+ 6148 CD 85 63         CALL TownGateRedrawPlayer
 306+ 614B AF               XOR A
 307+ 614C 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 308+ 614F 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 309+ 6152 3E 11            LD A, TGP_WALK_TO_ANCHOR
 310+ 6154 32 74 82         LD (TownGatePhase), A
 311+ 6157 C9               RET
