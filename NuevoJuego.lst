 198+ 9EDB                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ 9EDB 3E 0C            LD A, SPAWN_INTERVAL
 200+ 9EDD 32 F5 82         LD (SpawnTimer), A
 201+ 9EE0 AF               XOR A
 202+ 9EE1 32 02 83         LD (EnemyStepIdx), A
 203+ 9EE4 32 7B 5F         LD (PendingEraseCount), A
 204+ 9EE7 C9               RET
