 505  EF23                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ EF23              ; ==============================================================================
   2+ EF23              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EF23              ; ==============================================================================
   4+ EF23              ; CurrentObjective vive en variables.asm. Valor:
   5+ EF23              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EF23              ;   11    = todos los hitos completados (juego ganado)
   7+ EF23              ;
   8+ EF23              ; ----------------------------------------------------------------------------
   9+ EF23              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EF23              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EF23              ;                       recoger el sprite cuyo behavior coincide.
  12+ EF23              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EF23              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EF23              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EF23              ;
  16+ EF23              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EF23              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EF23              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EF23              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EF23              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EF23              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EF23              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EF23              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EF23              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EF23              ;
  26+ EF23              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EF23              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EF23              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EF23              ;
  30+ EF23              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre.
  31+ EF23              ; Util para saltarse hitos durante test (incluido M#7 SPECIAL si quisieras
  32+ EF23              ; saltarte la cinematica de captura entera, aunque ya avanza solo desde
  33+ EF23              ; UpdatePostTrapPause.uptpKey al soltar el cheque).
  34+ EF23              ; ==============================================================================
  35+ EF23
  36+ EF23              MILESTONE_TYPE_PICKUP   EQU 1
  37+ EF23              MILESTONE_TYPE_TRIGGER  EQU 2
  38+ EF23              MILESTONE_TYPE_SPECIAL  EQU 3
  39+ EF23
  40+ EF23              MilestoneTable:
  41+ EF23 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EF25 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EF27 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EF29 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EF2B 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EF2D 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EF2F 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EF31                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EF31                                                      ;    el cheque, no por tecla M en runtime)
  50+ EF31 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EF33                                                      ;    ir a recogerlo tras drop de la
  52+ EF33                                                      ;    cinematica de la iglesia)
  53+ EF33 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EF35 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EF37 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EF39
  57+ EF39              MilestoneResolveTable:
  58+ EF39 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EF3B 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EF3D 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EF3F 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EF41 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EF43 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EF45 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
