6722+ C801              ; ==============================================================================
6723+ C801              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6724+ C801              ; ==============================================================================
6725+ C801              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6726+ C801              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6727+ C801              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6728+ C801              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6729+ C801              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6730+ C801              ; main.asm; aqui no hace falta guard adicional).
6731+ C801              ; ==============================================================================
6732+ C801
6733+ C801              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6734+ C801              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6735+ C801              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6736+ C801              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6737+ C801              ;
6738+ C801              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6739+ C801              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6740+ C801              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6741+ C801              ;
6742+ C801              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6743+ C801              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6744+ C801              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6745+ C801              ; en vez de 8 + orientacion invertida).
6746+ C801              UpdateDeath:
6747+ C801                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6748+ C801                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6749+ C801                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6750+ C801                  ; progreso real, no solo quedar inmovil. ---
6751+ C801 2A A5 82         LD HL, (DeathGhostStuckTimer)
6752+ C804 23               INC HL
6753+ C805 22 A5 82         LD (DeathGhostStuckTimer), HL
6754+ C808 7C               LD A, H
6755+ C809 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6756+ C80B 38 1A            JR C, .udGhostCheckDone
6757+ C80D 20 05            JR NZ, .udGhostOn
6758+ C80F 7D               LD A, L
6759+ C810 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6760+ C812 38 13            JR C, .udGhostCheckDone
6761+ C814              .udGhostOn:
6762+ C814                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6763+ C814                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6764+ C814                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6765+ C814                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6766+ C814                  ; re-disparar restart).
6767+ C814 3A A7 82         LD A, (DeathGhostMode)
6768+ C817 B7               OR A
6769+ C818 20 0D            JR NZ, .udGhostCheckDone
6770+ C81A 3E 01            LD A, 1
6771+ C81C 32 A7 82         LD (DeathGhostMode), A
6772+ C81F 32 2C 9D         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6773+ C822 3E FE            LD A, $FE                       ; sentinel restart-current-track
6774+ C824 CD 06 9D         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6775+ C827              .udGhostCheckDone:
6776+ C827
6777+ C827                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6778+ C827 3A A7 82         LD A, (DeathGhostMode)
6779+ C82A B7               OR A
6780+ C82B C2 72 C8         JP NZ, DeathGhostChase
6781+ C82E
6782+ C82E                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6783+ C82E DD 7E 03         LD A, (IX+ENT_POSX)
6784+ C831 32 A2 82         LD (DeathPrevX), A
6785+ C834 DD 7E 04         LD A, (IX+ENT_POSY)
6786+ C837 32 A3 82         LD (DeathPrevY), A
6787+ C83A                  ; Sub-pixel acc 1/2
6788+ C83A 3A A1 82         LD A, (DeathSubPixelAcc)
6789+ C83D EE 01            XOR 1
6790+ C83F 32 A1 82         LD (DeathSubPixelAcc), A
6791+ C842 28 05            JR Z, .udSkip
6792+ C844 CD F5 B0         CALL UpdateMonster                  ; activo: chase + move + animate
6793+ C847 18 03            JR .udPost
6794+ C849              .udSkip:
6795+ C849 CD C5 C8         CALL DeathAnimate                   ; skip: solo animacion
6796+ C84C              .udPost:
6797+ C84C                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6798+ C84C 3A A2 82         LD A, (DeathPrevX)
6799+ C84F DD BE 03         CP (IX+ENT_POSX)
6800+ C852 20 19            JR NZ, .udMoved
6801+ C854 3A A3 82         LD A, (DeathPrevY)
6802+ C857 DD BE 04         CP (IX+ENT_POSY)
6803+ C85A 20 11            JR NZ, .udMoved
6804+ C85C                  ; No movio: incrementar BFS counter
6805+ C85C 3A A4 82         LD A, (DeathStuckCounter)
6806+ C85F 3C               INC A
6807+ C860 32 A4 82         LD (DeathStuckCounter), A
6808+ C863 FE 06            CP DEATH_STUCK_THRESHOLD
6809+ C865 D8               RET C
6810+ C866 AF               XOR A
6811+ C867 32 A4 82         LD (DeathStuckCounter), A
6812+ C86A C3 31 CA         JP DeathBfsRescue
6813+ C86D              .udMoved:
6814+ C86D AF               XOR A
6815+ C86E 32 A4 82         LD (DeathStuckCounter), A
6816+ C871 C9               RET
