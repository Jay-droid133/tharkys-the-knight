4463+ BB50 DD 7E 04         LD A, (IX+ENT_POSY)
4464+ BB53 47               LD B, A
4465+ BB54 3A 31 BC         LD A, (.spawnH1)
4466+ BB57 80               ADD A, B
4467+ BB58 DA 0C BC         JP C, .spawnBlocked                 ; wrap Y tambien malo
4468+ BB5B FE A8            CP SCREEN_MAX_Y
