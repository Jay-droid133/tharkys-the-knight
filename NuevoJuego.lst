5014+ BDF4 00           .sppSpritIdSave: DEFB 0
5015+ BDF5
5016+ BDF5 00           .sppOrigX: DEFB 0
5017+ BDF6 00           .sppOrigY: DEFB 0
5018+ BDF7 00           .sppBaseX: DEFB 0
5019+ BDF8 00           .sppBaseY: DEFB 0
5020+ BDF9              .sppShifts:
5021+ BDF9                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5022+ BDF9                  ; Distancia creciente. Sentinel: dy=$80.
5023+ BDF9 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5024+ BDFB 00 F8            DEFB 0,   -8                        ; arriba 8
5025+ BDFD 00 08            DEFB 0,    8                        ; abajo 8
5026+ BDFF F8 00            DEFB -8,   0                        ; izq 8
5027+ BE01 08 00            DEFB 8,    0                        ; der 8
5028+ BE03 00 F0            DEFB 0,  -16                        ; arriba 16
5029+ BE05 00 10            DEFB 0,   16                        ; abajo 16
5030+ BE07 F8 F8            DEFB -8,  -8
5031+ BE09 08 F8            DEFB 8,   -8
5032+ BE0B F8 08            DEFB -8,   8
5033+ BE0D 08 08            DEFB 8,    8
5034+ BE0F 00 80            DEFB 0,  $80                        ; sentinel
5035+ BE11
5036+ BE11              ; ==============================================================================
5037+ BE11              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5038+ BE11              ; ==============================================================================
5039+ BE11              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5040+ BE11              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5041+ BE11              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5042+ BE11              ; DeathSpawned. No-op si la muerte no esta activa.
5043+ BE11              ; ==============================================================================
5044+ BE11              SilentKillDeath:
5045+ BE11 DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5046+ BE15 DD 7E 01         LD A, (IX+ENT_TYPE)
5047+ BE18 B7               OR A
5048+ BE19 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5049+ BE1B CD 12 CA         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5050+ BE1E AF               XOR A
5051+ BE1F DD 77 01         LD (IX+ENT_TYPE), A
5052+ BE22 32 A0 82         LD (DeathSpawned), A
5053+ BE25              .skdResetTimer:
5054+ BE25                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5055+ BE25                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5056+ BE25 21 00 00         LD HL, 0
5057+ BE28 22 9D 82         LD (DeathScreenTimer), HL
5058+ BE2B                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5059+ BE2B                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5060+ BE2B                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5061+ BE2B                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5062+ BE2B                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5063+ BE2B C9               RET
5064+ BE2C
5065+ BE2C              ; ==============================================================================
5066+ BE2C              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5067+ BE2C              ; ==============================================================================
5068+ BE2C              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5069+ BE2C              ; no DYING ni SPAWNING):
5070+ BE2C              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5071+ BE2C              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5072+ BE2C              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5073+ BE2C              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5074+ BE2C              ;     Si tampoco, deja el monster donde estaba.
5075+ BE2C              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5076+ BE2C              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5077+ BE2C              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5078+ BE2C              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5079+ BE2C              ; ==============================================================================
5080+ BE2C              FreezeMonstersFacingCorpse:
5081+ BE2C                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5082+ BE2C 3A 4E 81         LD A, (EntityTable + ENT_POSX)
5083+ BE2F 32 97 82         LD (CorpseX), A
5084+ BE32 3A 4F 81         LD A, (EntityTable + ENT_POSY)
5085+ BE35 32 98 82         LD (CorpseY), A
5086+ BE38                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5087+ BE38                  ; ya skipea; no aplica aqui pero por simetria)
5088+ BE38 3E 01            LD A, 1
5089+ BE3A 32 96 82         LD (MonstersFrozen), A
5090+ BE3D DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5091+ BE41 06 06            LD B, NUM_MONSTERS
5092+ BE43              .fmcLoop:
5093+ BE43 C5               PUSH BC
5094+ BE44 DD 7E 01         LD A, (IX+ENT_TYPE)
5095+ BE47 FE 02            CP TYPE_MONSTER
5096+ BE49 20 0E            JR NZ, .fmcNext
5097+ BE4B DD 7E 02         LD A, (IX+ENT_STATE)
5098+ BE4E FE 03            CP STATE_DYING
5099+ BE50 28 07            JR Z, .fmcNext
5100+ BE52 FE 04            CP STATE_SPAWNING
5101+ BE54 28 03            JR Z, .fmcNext
5102+ BE56 CD 62 BE         CALL FreezeOneMonster
5103+ BE59              .fmcNext:
5104+ BE59 C1               POP BC
5105+ BE5A 11 10 00         LD DE, ENT_SIZE
5106+ BE5D DD 19            ADD IX, DE
5107+ BE5F 10 E2            DJNZ .fmcLoop
5108+ BE61 C9               RET
5109+ BE62
5110+ BE62              ; --- FreezeOneMonster ---
5111+ BE62              ; IX = monster slot pointer.
5112+ BE62              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5113+ BE62              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5114+ BE62              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5115+ BE62              FreezeOneMonster:
5116+ BE62                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5117+ BE62                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5118+ BE62                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5119+ BE62 DD 7E 03         LD A, (IX+ENT_POSX)
5120+ BE65 47               LD B, A
5121+ BE66 3A 97 82         LD A, (CorpseX)
5122+ BE69 B8               CP B
5123+ BE6A 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5124+ BE6C 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5125+ BE6E              .fomFaceE:
5126+ BE6E DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5127+ BE71 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5128+ BE73 DD 77 00         LD (IX+ENT_SPRITEID), A
5129+ BE76 18 08            JR .fomFaceDone
5130+ BE78              .fomFaceW:
5131+ BE78 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5132+ BE7B C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5133+ BE7D DD 77 00         LD (IX+ENT_SPRITEID), A
5134+ BE80              .fomFaceDone:
5135+ BE80
5136+ BE80                  ; --- 2) Computar |dx| y |dy| ---
5137+ BE80 3A 97 82         LD A, (CorpseX)
5138+ BE83 4F               LD C, A
5139+ BE84 DD 7E 03         LD A, (IX+ENT_POSX)
5140+ BE87 91               SUB C                           ; A = posX - corpseX (signed)
5141+ BE88 30 02            JR NC, .fomDxPos
5142+ BE8A ED 44            NEG
5143+ BE8C              .fomDxPos:
5144+ BE8C 32 DD BE         LD (.fomAdx), A
5145+ BE8F 3A 98 82         LD A, (CorpseY)
5146+ BE92 4F               LD C, A
5147+ BE93 DD 7E 04         LD A, (IX+ENT_POSY)
5148+ BE96 91               SUB C
5149+ BE97 30 02            JR NC, .fomDyPos
5150+ BE99 ED 44            NEG
5151+ BE9B              .fomDyPos:
5152+ BE9B 32 DE BE         LD (.fomAdy), A
5153+ BE9E
5154+ BE9E                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5155+ BE9E 3A DD BE         LD A, (.fomAdx)
5156+ BEA1 FE 10            CP 16
5157+ BEA3 D2 CC BE         JP NC, .fomFreeze
5158+ BEA6 3A DE BE         LD A, (.fomAdy)
5159+ BEA9 FE 10            CP 16
5160+ BEAB D2 CC BE         JP NC, .fomFreeze
5161+ BEAE
5162+ BEAE                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5163+ BEAE 3A DD BE         LD A, (.fomAdx)
5164+ BEB1 47               LD B, A
5165+ BEB2 3A DE BE         LD A, (.fomAdy)
5166+ BEB5 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5167+ BEB6 38 0C            JR C, .fomTryX
5168+ BEB8 28 0A            JR Z, .fomTryX
5169+ BEBA                  ; |dy| > |dx| -> intentar Y primero
5170+ BEBA CD 12 BF         CALL TryBackoffY
5171+ BEBD 28 0D            JR Z, .fomFreeze                ; ok
5172+ BEBF CD DF BE         CALL TryBackoffX
5173+ BEC2 18 08            JR .fomFreeze
5174+ BEC4              .fomTryX:
5175+ BEC4 CD DF BE         CALL TryBackoffX
5176+ BEC7 28 03            JR Z, .fomFreeze
5177+ BEC9 CD 12 BF         CALL TryBackoffY
5178+ BECC
5179+ BECC              .fomFreeze:
5180+ BECC                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5181+ BECC                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5182+ BECC DD 36 06 00      LD (IX+ENT_DELTAX), 0
5183+ BED0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5184+ BED4 DD 36 0A 00      LD (IX+ENT_DIR), 0
5185+ BED8 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5186+ BEDC C9               RET
5187+ BEDD
5188+ BEDD 00           .fomAdx: DEFB 0
5189+ BEDE 00           .fomAdy: DEFB 0
5190+ BEDF
5191+ BEDF              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5192+ BEDF              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5193+ BEDF              TryBackoffX:
5194+ BEDF DD 7E 03         LD A, (IX+ENT_POSX)
5195+ BEE2 32 11 BF         LD (.tbxSavePos), A
5196+ BEE5 47               LD B, A
5197+ BEE6 3A 97 82         LD A, (CorpseX)
5198+ BEE9 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5199+ BEEA DD 7E 03         LD A, (IX+ENT_POSX)
5200+ BEED 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5201+ BEEF C6 10            ADD A, 16
5202+ BEF1 18 02            JR .tbxApply
5203+ BEF3              .tbxNeg:
5204+ BEF3 D6 10            SUB 16
5205+ BEF5              .tbxApply:
5206+ BEF5                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5207+ BEF5 DD 77 03         LD (IX+ENT_POSX), A
5208+ BEF8 FE E8            CP SCREEN_MAX_X
5209+ BEFA 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5210+ BEFC CD D3 B9         CALL CheckEnemyCollision
5211+ BEFF 20 07            JR NZ, .tbxFail
5212+ BF01 CD 49 BF         CALL CheckMonsterOverlap
5213+ BF04 20 02            JR NZ, .tbxFail
5214+ BF06 AF               XOR A                           ; Z = ok
5215+ BF07 C9               RET
5216+ BF08              .tbxFail:
5217+ BF08 3A 11 BF         LD A, (.tbxSavePos)
5218+ BF0B DD 77 03         LD (IX+ENT_POSX), A
5219+ BF0E F6 01            OR 1                            ; NZ
5220+ BF10 C9               RET
5221+ BF11 00           .tbxSavePos: DEFB 0
5222+ BF12
5223+ BF12              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5224+ BF12              TryBackoffY:
5225+ BF12 DD 7E 04         LD A, (IX+ENT_POSY)
5226+ BF15 32 48 BF         LD (.tbySavePos), A
5227+ BF18 47               LD B, A
5228+ BF19 3A 98 82         LD A, (CorpseY)
5229+ BF1C B8               CP B
5230+ BF1D DD 7E 04         LD A, (IX+ENT_POSY)
5231+ BF20 30 04            JR NC, .tbyNeg
5232+ BF22 C6 10            ADD A, 16
5233+ BF24 18 02            JR .tbyApply
5234+ BF26              .tbyNeg:
5235+ BF26 D6 10            SUB 16
5236+ BF28              .tbyApply:
5237+ BF28 DD 77 04         LD (IX+ENT_POSY), A
5238+ BF2B FE 10            CP SCREEN_MIN_Y
5239+ BF2D 38 10            JR C, .tbyFail
5240+ BF2F FE A8            CP SCREEN_MAX_Y
5241+ BF31 30 0C            JR NC, .tbyFail
5242+ BF33 CD D3 B9         CALL CheckEnemyCollision
5243+ BF36 20 07            JR NZ, .tbyFail
5244+ BF38 CD 49 BF         CALL CheckMonsterOverlap
5245+ BF3B 20 02            JR NZ, .tbyFail
5246+ BF3D AF               XOR A
5247+ BF3E C9               RET
5248+ BF3F              .tbyFail:
5249+ BF3F 3A 48 BF         LD A, (.tbySavePos)
5250+ BF42 DD 77 04         LD (IX+ENT_POSY), A
5251+ BF45 F6 01            OR 1
5252+ BF47 C9               RET
5253+ BF48 00           .tbySavePos: DEFB 0
5254+ BF49
5255+ BF49              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5256+ BF49              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5257+ BF49              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5258+ BF49              CheckMonsterOverlap:
5259+ BF49 C5               PUSH BC
5260+ BF4A FD E5            PUSH IY
5261+ BF4C FD 21 5B 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5262+ BF50 06 06            LD B, NUM_MONSTERS
5263+ BF52              .cmoLoop:
5264+ BF52                  ; Skip self (IY == IX)
5265+ BF52 DD E5            PUSH IX
5266+ BF54 E1               POP HL
5267+ BF55 FD E5            PUSH IY
5268+ BF57 D1               POP DE
5269+ BF58 B7               OR A
5270+ BF59 ED 52            SBC HL, DE
5271+ BF5B 28 3D            JR Z, .cmoNext                  ; same slot
5272+ BF5D
5273+ BF5D FD 7E 01         LD A, (IY+ENT_TYPE)
5274+ BF60 FE 02            CP TYPE_MONSTER
5275+ BF62 20 36            JR NZ, .cmoNext
5276+ BF64
5277+ BF64                  ; AABB overlap (rect 16x21 cada uno):
5278+ BF64                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5279+ BF64                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5280+ BF64 DD 7E 03         LD A, (IX+ENT_POSX)
5281+ BF67 C6 10            ADD A, 16
5282+ BF69 4F               LD C, A
5283+ BF6A FD 7E 03         LD A, (IY+ENT_POSX)
5284+ BF6D B9               CP C                            ; iy.x cmp ix.x+16
5285+ BF6E 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5286+ BF70 FD 7E 03         LD A, (IY+ENT_POSX)
5287+ BF73 C6 10            ADD A, 16
5288+ BF75 4F               LD C, A
5289+ BF76 DD 7E 03         LD A, (IX+ENT_POSX)
5290+ BF79 B9               CP C
5291+ BF7A 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5292+ BF7C DD 7E 04         LD A, (IX+ENT_POSY)
5293+ BF7F C6 15            ADD A, 21
5294+ BF81 4F               LD C, A
5295+ BF82 FD 7E 04         LD A, (IY+ENT_POSY)
5296+ BF85 B9               CP C
5297+ BF86 30 12            JR NC, .cmoNext
5298+ BF88 FD 7E 04         LD A, (IY+ENT_POSY)
5299+ BF8B C6 15            ADD A, 21
5300+ BF8D 4F               LD C, A
5301+ BF8E DD 7E 04         LD A, (IX+ENT_POSY)
5302+ BF91 B9               CP C
5303+ BF92 30 06            JR NC, .cmoNext
5304+ BF94                  ; Overlap en ambos ejes
5305+ BF94 FD E1            POP IY
5306+ BF96 C1               POP BC
5307+ BF97 F6 01            OR 1                            ; NZ
5308+ BF99 C9               RET
5309+ BF9A              .cmoNext:
5310+ BF9A 11 10 00         LD DE, ENT_SIZE
5311+ BF9D FD 19            ADD IY, DE
5312+ BF9F 10 B1            DJNZ .cmoLoop
5313+ BFA1 FD E1            POP IY
5314+ BFA3 C1               POP BC
5315+ BFA4 AF               XOR A                           ; Z = no overlap
5316+ BFA5 C9               RET
5317+ BFA6
5318+ BFA6              ; ==============================================================================
5319+ BFA6              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5320+ BFA6              ; ==============================================================================
5321+ BFA6              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5322+ BFA6              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5323+ BFA6              ; ==============================================================================
5324+ BFA6              KillAllActiveMonsters:
5325+ BFA6 AF               XOR A
5326+ BFA7 32 6E B6         LD (MonstersActive), A              ; No respawnear mas
5327+ BFAA DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5328+ BFAE 06 06            LD B, NUM_MONSTERS
5329+ BFB0              .kamLoop:
5330+ BFB0 C5               PUSH BC
5331+ BFB1 DD 7E 01         LD A, (IX+ENT_TYPE)
5332+ BFB4 B7               OR A
5333+ BFB5 28 27            JR Z, .kamSkip                      ; slot vacio
5334+ BFB7 FE 02            CP TYPE_MONSTER
5335+ BFB9 20 23            JR NZ, .kamSkip                     ; no es monster
5336+ BFBB DD 7E 02         LD A, (IX+ENT_STATE)
5337+ BFBE FE 03            CP STATE_DYING
5338+ BFC0 28 1C            JR Z, .kamSkip
5339+ BFC2 FE 04            CP STATE_SPAWNING
5340+ BFC4 28 18            JR Z, .kamSkip
5341+ BFC6 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5342+ BFCA DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5343+ BFCE DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5344+ BFD2 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5345+ BFD6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5346+ BFDA DD 36 07 00      LD (IX+ENT_DELTAY), 0
5347+ BFDE                  ; ENT_ATTR conservado: puff hereda color del monster
5348+ BFDE              .kamSkip:
5349+ BFDE 11 10 00         LD DE, ENT_SIZE
5350+ BFE1 DD 19            ADD IX, DE
5351+ BFE3 C1               POP BC
5352+ BFE4 10 CA            DJNZ .kamLoop
5353+ BFE6 C9               RET
5354+ BFE7
5355+ BFE7              ; --- Tabla de tipos de nasty (SpriteID base) ---
5356+ BFE7              ; --- Tablas de nasties por momento del dia ---
5357+ BFE7              NUM_NASTY_TYPES EQU 4
5358+ BFE7              DiurnalTypeTable:                       ; DY, C1, A2
5359+ BFE7 30               DEFB SPRID_ENEMY_4          ; Eagle
5360+ BFE8 20               DEFB SPRID_ENEMY_0          ; Spider
5361+ BFE9 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5362+ BFEA 2C               DEFB SPRID_ENEMY_3          ; Snake
5363+ BFEB              CrepuscularTypeTable:                   ; C2, N1
5364+ BFEB 34               DEFB SPRID_ENEMY_5          ; Rat
5365+ BFEC 28               DEFB SPRID_ENEMY_2          ; Bat
5366+ BFED 24               DEFB SPRID_ENEMY_1          ; Scorpion
5367+ BFEE 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5368+ BFEF
5369+ BFEF              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5370+ BFEF              NastyColorTable:
5371+ BFEF 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5372+ BFF0 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5373+ BFF1 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5374+ BFF2 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5375+ BFF3 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5376+ BFF4 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5377+ BFF5 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5378+ BFF6 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5379+ BFF7
5380+ BFF7              ; --- Tabla de comportamiento depredador ---
5381+ BFF7              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5382+ BFF7              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5383+ BFF7              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5384+ BFF7              PredatorTable:
5385+ BFF7 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5386+ BFF8 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5387+ BFF9 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5388+ BFFA 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5389+ BFFB 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5390+ BFFC 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5391+ BFFD 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5392+ BFFE 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5393+ BFFF
5394+ BFFF              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5395+ BFFF              PredatorSpeedTable:
5396+ BFFF 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5397+ C000 02               DEFB 2                              ; Ciclo 1: lento
5398+ C001 03               DEFB 3                              ; Ciclo 2: intermedio
5399+ C002 04               DEFB 4                              ; Ciclo 3+: rapido
5400+ C003
5401+ C003 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5402+ C004
5403+ C004 E7 BF        CurrentNastyTable: DEFW DiurnalTypeTable
5404+ C006
5405+ C006              ; ==============================================================================
5406+ C006              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5407+ C006              ; ==============================================================================
5408+ C006              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5409+ C006              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5410+ C006              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5411+ C006              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5412+ C006              ;   pantalla, no diurnos.
5413+ C006              ; ==============================================================================
5414+ C006              UpdateNastyTable:
