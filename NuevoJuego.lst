1736+ AC58 0E 02            LD C, ANIM_DELAY_RUN
1737+ AC5A
1738+ AC5A              .applyAnim:
1739+ AC5A                  ; D = nuevo AnimBase, E = num frames, C = delay (fijo, 25fps constante)
1740+ AC5A                  ; ¿Cambio de animacion?
1741+ AC5A DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1742+ AC5D BA               CP D
1743+ AC5E CA E4 AC         JP Z, .sameAnim
1744+ AC61
1745+ AC61                  ; Nueva animacion → reiniciar
1746+ AC61                  ; Push-back al entrar en animaciones de ataque con sprite 24px
1747+ AC61 7A               LD A, D
1748+ AC62 FE 16            CP SPRID_ATTACK_EAST
1749+ AC64 28 30            JR Z, .pushBackEast
1750+ AC66 FE 1B            CP SPRID_ATTACK_WEST
1751+ AC68 20 58            JR NZ, .noPushBack
1752+ AC6A
1753+ AC6A                  ; Attack west: comprobar X-8 en fila superior e inferior → mover +8
1754+ AC6A D5               PUSH DE
1755+ AC6B C5               PUSH BC
1756+ AC6C DD 7E 03         LD A, (IX+ENT_POSX)
1757+ AC6F D6 08            SUB 8
1758+ AC71 47               LD B, A
1759+ AC72 DD 7E 04         LD A, (IX+ENT_POSY)
1760+ AC75 4F               LD C, A
1761+ AC76 CD 9D D1         CALL IsPointBlocked
1762+ AC79 20 11            JR NZ, .doPushBackWest
1763+ AC7B DD 7E 03         LD A, (IX+ENT_POSX)
1764+ AC7E D6 08            SUB 8
1765+ AC80 47               LD B, A
1766+ AC81 DD 7E 04         LD A, (IX+ENT_POSY)
1767+ AC84 C6 14            ADD A, 20
1768+ AC86 4F               LD C, A
1769+ AC87 CD 9D D1         CALL IsPointBlocked
1770+ AC8A 28 34            JR Z, .noPushBackPop
1771+ AC8C              .doPushBackWest:
1772+ AC8C DD 7E 03         LD A, (IX+ENT_POSX)
