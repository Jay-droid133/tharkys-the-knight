 467  EDC3                  INCLUDE "milestones.asm"
# file opened: code/milestones.asm
   1+ EDC3              ; ==============================================================================
   2+ EDC3              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EDC3              ; ==============================================================================
   4+ EDC3              ; CurrentObjective vive en variables.asm. Valor:
   5+ EDC3              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EDC3              ;   11    = todos los hitos completados (juego ganado)
   7+ EDC3              ;
   8+ EDC3              ; ----------------------------------------------------------------------------
   9+ EDC3              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EDC3              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EDC3              ;                       recoger el sprite cuyo behavior coincide.
  12+ EDC3              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EDC3              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EDC3              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EDC3              ;
  16+ EDC3              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EDC3              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EDC3              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EDC3              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EDC3              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EDC3              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EDC3              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EDC3              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EDC3              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EDC3              ;
  26+ EDC3              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EDC3              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EDC3              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EDC3              ;
  30+ EDC3              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  31+ EDC3              ; util para probar la cadena entera mientras los hitos 7, 9, 11 no tienen
  32+ EDC3              ; mecanica real (todos los SPECIAL/TRIGGER customs estan en cinematicas).
  33+ EDC3              ; ==============================================================================
  34+ EDC3
  35+ EDC3              MILESTONE_TYPE_PICKUP   EQU 1
  36+ EDC3              MILESTONE_TYPE_TRIGGER  EQU 2
  37+ EDC3              MILESTONE_TYPE_SPECIAL  EQU 3
  38+ EDC3
  39+ EDC3              MilestoneTable:
  40+ EDC3 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  41+ EDC5 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  42+ EDC7 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  43+ EDC9 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  44+ EDCB 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  45+ EDCD 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  46+ EDCF 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  47+ EDD1 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque del banco (dinamica)
  48+ EDD3 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  49+ EDD5 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  50+ EDD7 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  51+ EDD9
  52+ EDD9              MilestoneResolveTable:
  53+ EDD9 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  54+ EDDB 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  55+ EDDD 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  56+ EDDF 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  57+ EDE1 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  58+ EDE3 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  59+ EDE5 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  60+ EDE7 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  61+ EDE9 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  62+ EDEB 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  63+ EDED 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  64+ EDEF
  65+ EDEF              ; ==============================================================================
  66+ EDEF              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  67+ EDEF              ; ==============================================================================
  68+ EDEF              ; IN:  A = key id (1..6) recien recogida
  69+ EDEF              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  70+ EDEF              ; ==============================================================================
  71+ EDEF              CheckMilestonePickup:
  72+ EDEF E5               PUSH HL
  73+ EDF0 D5               PUSH DE
  74+ EDF1 C5               PUSH BC
  75+ EDF2 F5               PUSH AF
  76+ EDF3 47               LD B, A                             ; B = key id recibida
  77+ EDF4 3A BA 82         LD A, (CurrentObjective)
  78+ EDF7 FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  79+ EDF9 30 24            JR NC, .cmpDone                     ; sin hitos pendientes
  80+ EDFB 87               ADD A, A                            ; *2 (entry size)
  81+ EDFC 6F               LD L, A
  82+ EDFD 26 00            LD H, 0
  83+ EDFF 11 C3 ED         LD DE, MilestoneTable
  84+ EE02 19               ADD HL, DE
