 223+ FC09 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 224+ FC0A E1               POP HL                          ; src ptr
 225+ FC0B 10 BC            DJNZ .dpxByteLoop
 226+ FC0D
 227+ FC0D                  ; Avanzar a siguiente src row
 228+ FC0D 22 25 FC         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 229+ FC10 3A 24 FC         LD A, (.dpxDstY)
