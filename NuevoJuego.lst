# file opened: sound.asm
   1+ F8F2              ; ==============================================================================
   2+ F8F2              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F8F2              ; ==============================================================================
   4+ F8F2              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F8F2              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F8F2              ;
   7+ F8F2              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F8F2              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F8F2              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F8F2              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F8F2              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F8F2              ; ==============================================================================
  13+ F8F2
  14+ F8F2              ; ==============================================================================
  15+ F8F2              ; PlaySFX - Reproduce un efecto de sonido
  16+ F8F2              ; ==============================================================================
  17+ F8F2              ; Entrada: HL = puntero a datos del efecto
  18+ F8F2              ; Modifica: AF, BC, DE, HL
  19+ F8F2              ; ==============================================================================
  20+ F8F2              PlaySFX:
  21+ F8F2 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F8F3 3A E8 90         LD A, (CurrentBorderColor)
  23+ F8F6 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F8F8 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F8F9
  26+ F8F9              .nextStep:
  27+ F8F9 7E               LD A, (HL)                  ; Leer duration
  28+ F8FA B7               OR A
  29+ F8FB 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F8FD
  31+ F8FD 47               LD B, A                     ; B = duration (bucle externo)
  32+ F8FE 23               INC HL
  33+ F8FF 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F900 23               INC HL
  35+ F901 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F902 23               INC HL
  37+ F903 7E               LD A, (HL)                  ; A = flags
  38+ F904 23               INC HL
  39+ F905 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F906 CB 47            BIT 0, A
  41+ F908 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F90A
  43+ F90A              ; --- Bucle de tono normal ---
  44+ F90A              .toneLoop:
  45+ F90A                  ; Semi-periodo HIGH
  46+ F90A 7B               LD A, E
  47+ F90B F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F90D D3 FE            OUT ($FE), A
  49+ F90F 79               LD A, C                     ; A = pitch actual
  50+ F910              .toneDelayHi:
  51+ F910 3D               DEC A
  52+ F911 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F913
  54+ F913                  ; Semi-periodo LOW
  55+ F913 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F914 D3 FE            OUT ($FE), A
  57+ F916 79               LD A, C
  58+ F917              .toneDelayLo:
  59+ F917 3D               DEC A
  60+ F918 20 FD            JR NZ, .toneDelayLo
  61+ F91A
  62+ F91A                  ; Aplicar pitch sweep
  63+ F91A 79               LD A, C
  64+ F91B 82               ADD A, D                    ; pitch += pitchDelta
  65+ F91C 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F91E FA 26 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F921 4F               LD C, A
  68+ F922              .toneAfterClamp:
  69+ F922 10 E6            DJNZ .toneLoop
  70+ F924 18 30            JR .stepDone
  71+ F926
  72+ F926              .toneClamp:
  73+ F926 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F928 18 F8            JR .toneAfterClamp
  75+ F92A
  76+ F92A              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F92A              .noiseLoop:
  78+ F92A                  ; Semi-periodo HIGH con ruido
  79+ F92A 7B               LD A, E
  80+ F92B F6 10            OR $10
  81+ F92D D3 FE            OUT ($FE), A
  82+ F92F ED 5F            LD A, R                     ; R register como PRNG
  83+ F931 A9               XOR C                       ; mezclar con pitch base
  84+ F932 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F934 F6 01            OR $01                      ; minimo 1
  86+ F936              .noiseDelayHi:
  87+ F936 3D               DEC A
  88+ F937 20 FD            JR NZ, .noiseDelayHi
  89+ F939
  90+ F939                  ; Semi-periodo LOW
  91+ F939 7B               LD A, E
  92+ F93A D3 FE            OUT ($FE), A
  93+ F93C ED 5F            LD A, R
  94+ F93E A9               XOR C
  95+ F93F E6 1F            AND $1F
  96+ F941 F6 01            OR $01
  97+ F943              .noiseDelayLo:
  98+ F943 3D               DEC A
  99+ F944 20 FD            JR NZ, .noiseDelayLo
 100+ F946
 101+ F946                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F946 79               LD A, C
 103+ F947 82               ADD A, D
 104+ F948 28 08            JR Z, .noiseClamp
 105+ F94A FA 52 F9         JP M, .noiseClamp
 106+ F94D 4F               LD C, A
 107+ F94E              .noiseAfterClamp:
 108+ F94E 10 DA            DJNZ .noiseLoop
 109+ F950 18 04            JR .stepDone
 110+ F952
 111+ F952              .noiseClamp:
 112+ F952 0E 01            LD C, 1
 113+ F954 18 F8            JR .noiseAfterClamp
 114+ F956
 115+ F956              .stepDone:
 116+ F956 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F957 18 A0            JR .nextStep
 118+ F959
 119+ F959              .done:
 120+ F959 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F95A D3 FE            OUT ($FE), A
 122+ F95C FB               EI
 123+ F95D C9               RET
 124+ F95E
