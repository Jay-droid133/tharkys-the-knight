 496  E355                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 497  E355                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 498  E355                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 499  E355                  ; deben vivir en el mismo banco paginado.
 500  E355                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E355              ; ==============================================================================
   2+ E355              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E355              ; ==============================================================================
   4+ E355              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E355              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E355              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E355              ; ==============================================================================
   8+ E355
   9+ E355              ; --- Constantes ---
  10+ E355              NUM_TIME_MOMENTS    EQU 7
  11+ E355
  12+ E355              ; --- Variables ---
  13+ E355 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E356 F1 E7        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E358 F1 E7        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E35A 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E35B 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E35C 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E35D
  20+ E35D              ; ==============================================================================
  21+ E35D              ; SetTimeOfDay - Cambia el momento del dia
  22+ E35D              ; ==============================================================================
  23+ E35D              ; Entrada: A = momento (0-6)
  24+ E35D              ; ==============================================================================
  25+ E35D              SetTimeOfDay:
  26+ E35D 32 55 E3         LD (CurrentTimeOfDay), A
  27+ E360
  28+ E360                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E360 FE 04            CP 4
  30+ E362 20 06            JR NZ, .notNewCycle
  31+ E364 21 E6 BC         LD HL, DayCycleCount
  32+ E367 34               INC (HL)
  33+ E368 18 04            JR .skipBellsReset
  34+ E36A              .notNewCycle:
  35+ E36A                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E36A                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E36A                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E36A AF               XOR A
  39+ E36B 32 AF 82         LD (BellsTriggered), A
  40+ E36E              .skipBellsReset:
  41+ E36E 3A 55 E3         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E371
  43+ E371                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E371 FE 04            CP 4
  45+ E373 28 24            JR Z, .bellsFirst
  46+ E375
  47+ E375                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E375 FE 05            CP 5
  49+ E377 20 0D            JR NZ, .noScareMon
  50+ E379 CD 00 BD         CALL ScareAllMonsters
  51+ E37C CD 1F FB         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E37F                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E37F                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E37F                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E37F                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E37F 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E381 CD B3 99         CALL StartMusic
  58+ E384 18 07            JR .noKillMon
  59+ E386              .noScareMon:
  60+ E386                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E386 FE 06            CP 6
  62+ E388 20 03            JR NZ, .noKillMon
  63+ E38A CD 89 BC         CALL KillAllActiveMonsters
  64+ E38D              .noKillMon:
  65+ E38D
  66+ E38D                  ; Actualizar tablas de remap y tabla de nasties
  67+ E38D CD C2 E3         CALL UpdateRemapTables
  68+ E390 CD E9 BC         CALL UpdateNastyTable
  69+ E393
  70+ E393                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E393 3E 01            LD A, 1
  72+ E395 32 0A 83         LD (AttrsDirty), A
  73+ E398 C9               RET
  74+ E399
  75+ E399              .bellsFirst:
  76+ E399                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E399                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E399                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E399                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E399                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E399 CD E9 BC         CALL UpdateNastyTable
  82+ E39C                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E39C                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E39C 3A AF 82         LD A, (BellsTriggered)
  85+ E39F B7               OR A
  86+ E3A0 C0               RET NZ
  87+ E3A1 3E 01            LD A, 1
  88+ E3A3 32 AF 82         LD (BellsTriggered), A
  89+ E3A6 CD 95 FA         CALL StartBellChimes
  90+ E3A9 C9               RET
  91+ E3AA
  92+ E3AA              ; ==============================================================================
  93+ E3AA              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E3AA              ; ==============================================================================
  95+ E3AA              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E3AA              ;   - Salta reloj a 00:00.
  97+ E3AA              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E3AA              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E3AA              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E3AA              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E3AA              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E3AA              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E3AA              ;     pero ya esta en N2 -> no-op visual.
 104+ E3AA              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E3AA              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E3AA              ;
 107+ E3AA              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E3AA              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E3AA              ; aqui no re-dispara nada.
 110+ E3AA              ; ==============================================================================
 111+ E3AA              TriggerChurchMidnight:
 112+ E3AA 3A AF 82         LD A, (BellsTriggered)
 113+ E3AD B7               OR A
 114+ E3AE C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E3AF 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E3B1 CD A1 EB         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E3B4 3E 04            LD A, 4
 118+ E3B6 CD 5D E3         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E3B9                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E3B9                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E3B9                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E3B9 CD C2 E3         CALL UpdateRemapTables
 123+ E3BC 3E 01            LD A, 1
 124+ E3BE 32 0A 83         LD (AttrsDirty), A
 125+ E3C1 C9               RET
 126+ E3C2
 127+ E3C2              ; ==============================================================================
 128+ E3C2              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 129+ E3C2              ; ==============================================================================
 130+ E3C2              UpdateRemapTables:
 131+ E3C2 3A 55 E3         LD A, (CurrentTimeOfDay)
 132+ E3C5 21 C5 E7         LD HL, RemapTablePtrs
 133+ E3C8 5F               LD E, A
 134+ E3C9 16 00            LD D, 0
 135+ E3CB 19               ADD HL, DE
 136+ E3CC 19               ADD HL, DE
 137+ E3CD 5E               LD E, (HL)
 138+ E3CE 23               INC HL
 139+ E3CF 56               LD D, (HL)
 140+ E3D0 ED 53 56 E3      LD (CurrentRemapTable), DE
 141+ E3D4
 142+ E3D4 3A 55 E3         LD A, (CurrentTimeOfDay)
 143+ E3D7 21 D3 E7         LD HL, RemapHouseTablePtrs
 144+ E3DA 5F               LD E, A
 145+ E3DB 16 00            LD D, 0
 146+ E3DD 19               ADD HL, DE
 147+ E3DE 19               ADD HL, DE
 148+ E3DF 5E               LD E, (HL)
 149+ E3E0 23               INC HL
 150+ E3E1 56               LD D, (HL)
 151+ E3E2 ED 53 58 E3      LD (CurrentHouseRemapTable), DE
 152+ E3E6 C9               RET
 153+ E3E7
 154+ E3E7              ; ==============================================================================
 155+ E3E7              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E3E7              ; ==============================================================================
 157+ E3E7              CheckDebugKeys:
 158+ E3E7 3E FB            LD A, $FB
 159+ E3E9 DB FE            IN A, ($FE)
 160+ E3EB CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E3ED 20 1C            JR NZ, .notPressed
 162+ E3EF
 163+ E3EF                  ; Tecla pulsada: comprobar debounce
 164+ E3EF 3A 5C E3         LD A, (DebugKeyDebounce)
 165+ E3F2 B7               OR A
 166+ E3F3 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E3F4
 168+ E3F4                  ; Primera pulsacion: ciclar
 169+ E3F4 3E 01            LD A, 1
 170+ E3F6 32 5C E3         LD (DebugKeyDebounce), A
 171+ E3F9
 172+ E3F9 3A 55 E3         LD A, (CurrentTimeOfDay)
 173+ E3FC 3C               INC A
 174+ E3FD FE 07            CP NUM_TIME_MOMENTS
 175+ E3FF 38 01            JR C, .noWrap
 176+ E401 AF               XOR A                   ; Volver a 0 (Dia)
 177+ E402              .noWrap:
 178+ E402 F5               PUSH AF
 179+ E403 CD 5D E3         CALL SetTimeOfDay
 180+ E406 F1               POP AF
 181+ E407 CD A1 EB         CALL SetClockToPhaseHour
 182+ E40A C9               RET
 183+ E40B
 184+ E40B              .notPressed:
 185+ E40B AF               XOR A
 186+ E40C 32 5C E3         LD (DebugKeyDebounce), A
 187+ E40F
 188+ E40F                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E40F 3E FD            LD A, $FD
 190+ E411 DB FE            IN A, ($FE)
 191+ E413 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E414 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E416 20 13            JR NZ, .sNotPressed
 194+ E418 3A 66 E4         LD A, (SpeedKeyDebounce)
 195+ E41B B7               OR A
 196+ E41C C0               RET NZ
 197+ E41D 3E 01            LD A, 1
 198+ E41F 32 66 E4         LD (SpeedKeyDebounce), A
 199+ E422 21 E6 BC         LD HL, DayCycleCount
 200+ E425 7E               LD A, (HL)
 201+ E426 FE 0A            CP 10
 202+ E428 D0               RET NC                  ; Ya en maximo
 203+ E429 34               INC (HL)
 204+ E42A C9               RET
 205+ E42B              .sNotPressed:
 206+ E42B                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E42B CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E42D 20 13            JR NZ, .dNotPressed
 209+ E42F 3A 66 E4         LD A, (SpeedKeyDebounce)
 210+ E432 B7               OR A
 211+ E433 C0               RET NZ
 212+ E434 3E 01            LD A, 1
 213+ E436 32 66 E4         LD (SpeedKeyDebounce), A
 214+ E439 21 E6 BC         LD HL, DayCycleCount
 215+ E43C 7E               LD A, (HL)
 216+ E43D FE 01            CP 1
 217+ E43F C8               RET Z                   ; Ya en minimo
 218+ E440 35               DEC (HL)
 219+ E441 C9               RET
 220+ E442              .dNotPressed:
 221+ E442 AF               XOR A
 222+ E443 32 66 E4         LD (SpeedKeyDebounce), A
 223+ E446
 224+ E446                  ; --- Tecla N: togglea NoclipMode (debug) ---
 225+ E446 3E 7F            LD A, $7F
 226+ E448 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 227+ E44A CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 228+ E44C 20 13            JR NZ, .nNotPressed
 229+ E44E 3A 67 E4         LD A, (NoclipKeyDebounce)
 230+ E451 B7               OR A
 231+ E452 C0               RET NZ
 232+ E453 3E 01            LD A, 1
 233+ E455 32 67 E4         LD (NoclipKeyDebounce), A
 234+ E458 3A A6 82         LD A, (NoclipMode)
 235+ E45B EE 01            XOR 1
 236+ E45D 32 A6 82         LD (NoclipMode), A
 237+ E460 C9               RET
 238+ E461              .nNotPressed:
 239+ E461 AF               XOR A
 240+ E462 32 67 E4         LD (NoclipKeyDebounce), A
 241+ E465 C9               RET
