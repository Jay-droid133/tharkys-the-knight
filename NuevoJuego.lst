 753+ E16E
 754+ E16E              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 755+ E16E              .bcPhHandNoNo:
 756+ E16E CD BC E2         CALL BankCutsceneDecTimer
 757+ E171 C0               RET NZ
 758+ E172                  ; Swap frame: erase actual + draw el otro.
 759+ E172 CD 99 E2         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 760+ E175 3A D6 82         LD A, (BankCutsceneHandFrame)
 761+ E178 EE 01            XOR 1
 762+ E17A 32 D6 82         LD (BankCutsceneHandFrame), A
 763+ E17D CD 7C E2         CALL BankCutsceneDrawHand           ; draw frame nuevo
 764+ E180 CD DD E2         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 765+ E183                  ; Increment swap idx, check completion.
 766+ E183 3A D5 82         LD A, (BankCutsceneNoIdx)
 767+ E186 3C               INC A
 768+ E187 32 D5 82         LD (BankCutsceneNoIdx), A
 769+ E18A FE 08            CP BCS_NO_SWAPS_TOTAL
