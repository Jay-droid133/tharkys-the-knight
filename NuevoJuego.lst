1061+ ED13              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1062+ ED13              .ucsShakeStatuePhase:
1063+ ED13 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1064+ ED16 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1065+ ED18 30 35            JR NC, .ucsShakeStatueDone
1066+ ED1A                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1067+ ED1A                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1068+ ED1A                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1069+ ED1A                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1070+ ED1A                  ;
1071+ ED1A                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1072+ ED1A                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1073+ ED1A ED 5F            LD A, R
1074+ ED1C E6 03            AND $03
1075+ ED1E 21 4B ED         LD HL, .ucsShakeJitterTable
1076+ ED21 5F               LD E, A
1077+ ED22 16 00            LD D, 0
1078+ ED24 19               ADD HL, DE
1079+ ED25 7E               LD A, (HL)
1080+ ED26 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1081+ ED27                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1082+ ED27 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1083+ ED2A FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1084+ ED2C 21 DE EF         LD HL, StatueIdTable
1085+ ED2F 38 03            JR C, .ucsShakeTablePicked
1086+ ED31 21 E1 EF         LD HL, StatueBrokenIdTable
1087+ ED34              .ucsShakeTablePicked:
1088+ ED34 78               LD A, B                                 ; restore jitter para la llamada
1089+ ED35 CD 42 EE         CALL ChurchCutsceneShakeStatueByteShift
1090+ ED38                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1091+ ED38                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1092+ ED38                  ; y al salir de la fase forzamos borde a negro explicitamente.
1093+ ED38 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1094+ ED3B E6 01            AND $01
1095+ ED3D 28 04            JR Z, .ucsShakeBorderBlack
1096+ ED3F 3E 07            LD A, WHITE
1097+ ED41 18 01            JR .ucsShakeBorderOut
1098+ ED43              .ucsShakeBorderBlack:
1099+ ED43 AF               XOR A                                   ; BLACK
1100+ ED44              .ucsShakeBorderOut:
1101+ ED44 D3 FE            OUT (254), A
1102+ ED46 21 9D 5F         LD HL, ChurchCutsceneFrame
1103+ ED49 34               INC (HL)
1104+ ED4A C9               RET
1105+ ED4B              .ucsShakeJitterTable:
1106+ ED4B 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1107+ ED4F              .ucsShakeStatueDone:
1108+ ED4F                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1109+ ED4F AF               XOR A
1110+ ED50 D3 FE            OUT (254), A
1111+ ED52                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1112+ ED52                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1113+ ED52                  ; directo a 0 garantiza que no queden residuos.)
1114+ ED52 CD AD EE         CALL ChurchCutsceneEraseStatueDirect
1115+ ED55 21 97 F9         LD HL, SFX_EnemyDeath
1116+ ED58 CD 18 F9         CALL PlaySFX
