 172+ 6C08 11 04 00         LD DE, TOMBSTONE_BYTES
 173+ 6C0B 19               ADD HL, DE                              ; siguiente entry
 174+ 6C0C C1               POP BC                                  ; restaurar contador
 175+ 6C0D 10 8F            DJNZ .dtirLoop
 176+ 6C0F C9               RET
