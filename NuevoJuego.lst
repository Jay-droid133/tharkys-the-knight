 417+ 6AB2 3A D3 6A         LD A, (.eseTargetId)
 418+ 6AB5 6F               LD L, A
 419+ 6AB6 26 00            LD H, 0
 420+ 6AB8 54               LD D, H
 421+ 6AB9 5D               LD E, L
 422+ 6ABA 29               ADD HL, HL                              ; *2
 423+ 6ABB 19               ADD HL, DE                              ; *3
 424+ 6ABC 11 D3 DF         LD DE, BgGfxPtrById
 425+ 6ABF 19               ADD HL, DE
 426+ 6AC0 5E               LD E, (HL)
 427+ 6AC1 23               INC HL
 428+ 6AC2 56               LD D, (HL)                              ; DE = ptr
 429+ 6AC3 23               INC HL
 430+ 6AC4 7E               LD A, (HL)                              ; A = bank
 431+ 6AC5 C5               PUSH BC
 432+ 6AC6 EB               EX DE, HL                               ; HL = ptr
