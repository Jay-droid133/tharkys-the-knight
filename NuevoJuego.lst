7448+ CC16
7449+ CC16              ; ==============================================================================
7450+ CC16              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7451+ CC16              ; ==============================================================================
7452+ CC16              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7453+ CC16              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7454+ CC16              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7455+ CC16              ; ==============================================================================
7456+ CC16              ; ==============================================================================
7457+ CC16              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7458+ CC16              ; ==============================================================================
7459+ CC16              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7460+ CC16              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7461+ CC16              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7462+ CC16              ; los pone a su default.
7463+ CC16              ; ==============================================================================
7464+ CC16              InitGameState:
7465+ CC16 3E 03            LD A, PLAYER_LIVES_INIT
7466+ CC18 32 70 82         LD (PlayerLives), A
7467+ CC1B 3E 10            LD A, HEALTH_MAX
7468+ CC1D 32 38 B6         LD (PlayerHealth), A
7469+ CC20 3E 10            LD A, STAMINA_MAX
7470+ CC22 32 39 B6         LD (PlayerStamina), A
7471+ CC25 AF               XOR A
7472+ CC26 32 71 82         LD (GameOver), A
7473+ CC29 32 5A 82         LD (CurrentObjective), A
7474+ CC2C 32 52 82         LD (CurrentKey), A
7475+ CC2F 32 56 82         LD (ChurchEverOpened), A
7476+ CC32 32 55 82         LD (ChurchDoorOpen), A
7477+ CC35 32 57 82         LD (TimeFrozen), A
7478+ CC38 32 54 82         LD (ChurchKeySpawned), A
7479+ CC3B 32 65 82         LD (TownGateKeySpawned), A
7480+ CC3E 32 69 82         LD (ArmRevealed), A
7481+ CC41 32 6A 82         LD (FingerRevealed), A
7482+ CC44 32 3E B6         LD (MonstersActive), A
7483+ CC47 32 61 82         LD (MonsterTrappedFlags), A
7484+ CC4A 32 8C 82         LD (DeathSpawned), A
7485+ CC4D 32 68 82         LD (TownGatePhase), A
7486+ CC50 32 66 82         LD (ChurchCutscenePhase), A
7487+ CC53 32 97 E4         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7488+ CC56 32 59 82         LD (BellsTriggered), A
7489+ CC59 32 62 82         LD (NextChurchTrapStep), A
7490+ CC5C 32 63 82         LD (StatueBlinkCounter), A
7491+ CC5F 32 64 82         LD (ChurchKeyAltSpawnIdx), A
7492+ CC62 32 D0 C7         LD (PlayerHitTimer), A
7493+ CC65 32 85 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7494+ CC68 32 86 82         LD (TombDrawPending), A
7495+ CC6B 32 79 82         LD (DeathBorderPhase), A
7496+ CC6E 32 7A 82         LD (DeathBorderTimer), A
7497+ CC71 32 7B 82         LD (PlayerDeathAnimTimer), A
7498+ CC74 32 7C 82         LD (PlayerDeathAnimFrame), A
7499+ CC77 32 7D 82         LD (PlayerRespawnPhase), A
7500+ CC7A 32 7E 82         LD (PlayerRespawnTimer), A
7501+ CC7D 32 7F 82         LD (PlayerRespawnBlinkTimer), A
7502+ CC80 32 81 82         LD (PlayerRespawnBeatIdx), A
7503+ CC83 32 72 82         LD (GameOverAnimX), A
7504+ CC86 32 73 82         LD (GameOverAnimDir), A
7505+ CC89 32 74 82         LD (GameOverAnimFrame), A
7506+ CC8C 32 75 82         LD (GameOverAnimFrameTimer), A
7507+ CC8F 32 78 82         LD (GameOverAnimLastX), A
7508+ CC92 21 00 00         LD HL, 0
7509+ CC95 22 76 82         LD (GameOverAnimLastSpr), HL
7510+ CC98 22 89 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7511+ CC9B 3E 01            LD A, 1
7512+ CC9D 32 80 82         LD (PlayerRespawnVisible), A
7513+ CCA0 3E 00            LD A, BLACK
7514+ CCA2 32 D5 90         LD (CurrentBorderColor), A
7515+ CCA5 D3 FE            OUT (254), A
7516+ CCA7 3E 01            LD A, 1
7517+ CCA9 32 D3 BF         LD (DayCycleCount), A
7518+ CCAC 21 B7 BF         LD HL, DiurnalTypeTable
7519+ CCAF 22 D4 BF         LD (CurrentNastyTable), HL
7520+ CCB2 C9               RET
7521+ CCB3
7522+ CCB3              OnPlayerHealthDepleted:
7523+ CCB3                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7524+ CCB3                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7525+ CCB3                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7526+ CCB3                  ; (combate, Death catch, drain de salud por cualquier via).
7527+ CCB3 F5               PUSH AF
7528+ CCB4 3E FF            LD A, $FF
7529+ CCB6 CD F2 9C         CALL StartMusic
7530+ CCB9 F1               POP AF
7531+ CCBA                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7532+ CCBA                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7533+ CCBA CD 05 6D         CALL AY_PlayPlayerDeath
7534+ CCBD                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7535+ CCBD                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7536+ CCBD 3E 02            LD A, 2
7537+ CCBF 32 57 82         LD (TimeFrozen), A
7538+ CCC2                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7539+ CCC2 CD 36 6B         CALL TombStore
7540+ CCC5                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7541+ CCC5 CD 13 BD         CALL KillAllActiveNasties
7542+ CCC8                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7543+ CCC8 CD E1 BD         CALL SilentKillDeath
7544+ CCCB                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7545+ CCCB CD FC BD         CALL FreezeMonstersFacingCorpse
7546+ CCCE                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7547+ CCCE CD 6C CD         CALL TriggerDeathBorder
7548+ CCD1                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7549+ CCD1                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7550+ CCD1                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7551+ CCD1 DD 21 3F 81      LD IX, EntityTable
7552+ CCD5                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7553+ CCD5 DD 7E 0A         LD A, (IX+ENT_DIR)
7554+ CCD8 E6 80            AND $80
7555+ CCDA 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7556+ CCDC 28 02            JR Z, .ophdRightBase
7557+ CCDE 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7558+ CCE0              .ophdRightBase:
7559+ CCE0 DD 77 00         LD (IX+ENT_SPRITEID), A
7560+ CCE3 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7561+ CCE7 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7562+ CCEB 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7563+ CCED 32 7B 82         LD (PlayerDeathAnimTimer), A
7564+ CCF0 AF               XOR A
7565+ CCF1 32 7C 82         LD (PlayerDeathAnimFrame), A
7566+ CCF4                  ; Decrementar vida (clamp a 0)
7567+ CCF4 3A 70 82         LD A, (PlayerLives)
7568+ CCF7 B7               OR A
7569+ CCF8 C8               RET Z
7570+ CCF9 3D               DEC A
7571+ CCFA 32 70 82         LD (PlayerLives), A
7572+ CCFD C9               RET
7573+ CCFE
7574+ CCFE              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7575+ CCFE              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7576+ CCFE              ErasePlayerSpriteAtOldPos:
7577+ CCFE DD 21 3F 81      LD IX, EntityTable
7578+ CD02 CD 12 A8         CALL GetOldSpriteAddr
7579+ CD05 DD 56 0D         LD D, (IX+ENT_OLDY)
7580+ CD08 DD 7E 0C         LD A, (IX+ENT_OLDX)
7581+ CD0B 5F               LD E, A
7582+ CD0C DD E5            PUSH IX
7583+ CD0E DD 2A 9A A7      LD IX, (OldSprAddr)
7584+ CD12 CD 1F 9D         CALL DrawSprite
7585+ CD15 DD E1            POP IX
7586+ CD17 DD 56 0D         LD D, (IX+ENT_OLDY)
7587+ CD1A DD 5E 0C         LD E, (IX+ENT_OLDX)
7588+ CD1D C3 45 D5         JP RestoreOldAttr                   ; tail-call
7589+ CD20
7590+ CD20              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7591+ CD20              RespawnPlayerAtEntry:
7592+ CD20 DD 21 3F 81      LD IX, EntityTable
7593+ CD24 3A A0 82         LD A, (LastEntryPosX)
7594+ CD27 DD 77 03         LD (IX+ENT_POSX), A
7595+ CD2A DD 77 0C         LD (IX+ENT_OLDX), A
7596+ CD2D DD 77 0F         LD (IX+ENT_DRAWX), A
7597+ CD30 3A A1 82         LD A, (LastEntryPosY)
7598+ CD33 DD 77 04         LD (IX+ENT_POSY), A
7599+ CD36 DD 77 0D         LD (IX+ENT_OLDY), A
7600+ CD39 3E 10            LD A, HEALTH_MAX
7601+ CD3B 32 38 B6         LD (PlayerHealth), A
7602+ CD3E 3E 10            LD A, STAMINA_MAX
7603+ CD40 32 39 B6         LD (PlayerStamina), A
7604+ CD43 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7605+ CD47 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7606+ CD4B DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7607+ CD4F DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7608+ CD53 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7609+ CD57 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7610+ CD5B DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7611+ CD5F                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7612+ CD5F                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7613+ CD5F 3E 01            LD A, 1
7614+ CD61 32 7D 82         LD (PlayerRespawnPhase), A
7615+ CD64 AF               XOR A
7616+ CD65 32 7E 82         LD (PlayerRespawnTimer), A
7617+ CD68 32 81 82         LD (PlayerRespawnBeatIdx), A
7618+ CD6B C9               RET
7619+ CD6C
7620+ CD6C              ; ==============================================================================
7621+ CD6C              ; TriggerDeathBorder - arranca el flash del borde tras morir
7622+ CD6C              ; ==============================================================================
7623+ CD6C              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7624+ CD6C              ; luego vuelve a negro y se desactiva.
7625+ CD6C              ; ==============================================================================
7626+ CD6C              TriggerDeathBorder:
7627+ CD6C 3E 01            LD A, 1
7628+ CD6E 32 79 82         LD (DeathBorderPhase), A
7629+ CD71 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7630+ CD73 32 7A 82         LD (DeathBorderTimer), A
7631+ CD76 3E 06            LD A, YELLOW
7632+ CD78 32 D5 90         LD (CurrentBorderColor), A
7633+ CD7B D3 FE            OUT (254), A
7634+ CD7D C9               RET
7635+ CD7E
7636+ CD7E              ; ==============================================================================
7637+ CD7E              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7638+ CD7E              ; ==============================================================================
7639+ CD7E              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7640+ CD7E              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7641+ CD7E              ; ==============================================================================
7642+ CD7E              UpdateRespawnBlink:
7643+ CD7E 3A 7D 82         LD A, (PlayerRespawnPhase)
7644+ CD81 B7               OR A
7645+ CD82 C8               RET Z
7646+ CD83 3D               DEC A
7647+ CD84 28 0D            JR Z, .urbPhase1
7648+ CD86                  ; Phase 2: solo timer (sin parpadeo)
7649+ CD86 3A 7E 82         LD A, (PlayerRespawnTimer)
7650+ CD89 3D               DEC A
7651+ CD8A 32 7E 82         LD (PlayerRespawnTimer), A
7652+ CD8D C0               RET NZ
7653+ CD8E AF               XOR A
7654+ CD8F 32 7D 82         LD (PlayerRespawnPhase), A
7655+ CD92 C9               RET
7656+ CD93
7657+ CD93              .urbPhase1:
7658+ CD93                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7659+ CD93                  ; Zero input (sin control)
7660+ CD93 AF               XOR A
7661+ CD94 32 4F 82         LD (InputDirection), A
7662+ CD97 32 50 82         LD (InputFire), A
7663+ CD9A                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7664+ CD9A                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7665+ CD9A 3A FA 6C         LD A, (BeepDurationFrames)
7666+ CD9D D6 01            SUB 1                               ; CY si era 0 (silencio)
7667+ CD9F 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7668+ CDA0 E6 74            AND SPRID_PLAYER_BLANK
7669+ CDA2 32 3F 81         LD (EntityTable), A
7670+ CDA5                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7671+ CDA5 3A 7E 82         LD A, (PlayerRespawnTimer)
7672+ CDA8 B7               OR A
7673+ CDA9 28 05            JR Z, .urb1FireBeat
7674+ CDAB 3D               DEC A
7675+ CDAC 32 7E 82         LD (PlayerRespawnTimer), A
7676+ CDAF C9               RET
7677+ CDB0              .urb1FireBeat:
7678+ CDB0 3A 81 82         LD A, (PlayerRespawnBeatIdx)
7679+ CDB3 3C               INC A
7680+ CDB4 32 81 82         LD (PlayerRespawnBeatIdx), A
7681+ CDB7 FE 04            CP 4
7682+ CDB9 28 12            JR Z, .urb1LastBeat
7683+ CDBB FE 05            CP 5
7684+ CDBD 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7685+ CDBF                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7686+ CDBF 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7687+ CDC2 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7688+ CDC4 CD 2A 6D         CALL AY_PlayBeep
7689+ CDC7                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7690+ CDC7                  ; (mitad) para mantener ON/OFF ~50/50.
7691+ CDC7 3E 14            LD A, 20
7692+ CDC9 32 7E 82         LD (PlayerRespawnTimer), A
7693+ CDCC C9               RET
7694+ CDCD              .urb1LastBeat:
7695+ CDCD                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7696+ CDCD                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7697+ CDCD                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7698+ CDCD                  ; entra grace EXACTAMENTE al terminar el beep.
7699+ CDCD 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7700+ CDD0 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7701+ CDD2 CD 2A 6D         CALL AY_PlayBeep
7702+ CDD5 3E 0B            LD A, 11                    ; espera = duracion del beep
7703+ CDD7 32 7E 82         LD (PlayerRespawnTimer), A
7704+ CDDA C9               RET
7705+ CDDB              .urb1AfterBeep:
7706+ CDDB                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7707+ CDDB                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7708+ CDDB CD F4 CD         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7709+ CDDE 3E 0C            LD A, SPAWN_INTERVAL
7710+ CDE0 32 87 82         LD (SpawnTimer), A
7711+ CDE3 AF               XOR A
7712+ CDE4 32 8C 82         LD (DeathSpawned), A
7713+ CDE7 32 82 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7714+ CDEA 32 57 82         LD (TimeFrozen), A              ; Reanudar reloj
7715+ CDED 21 00 00         LD HL, 0
7716+ CDF0 22 89 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7717+ CDF3 C9               RET
7718+ CDF4
7719+ CDF4              ; ==============================================================================
7720+ CDF4              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7721+ CDF4              ; ==============================================================================
7722+ CDF4              ; Llamado desde:
7723+ CDF4              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7724+ CDF4              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7725+ CDF4              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7726+ CDF4              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7727+ CDF4              ; ==============================================================================
7728+ CDF4              EnterGracePhase:
7729+ CDF4 3E 02            LD A, 2
7730+ CDF6 32 7D 82         LD (PlayerRespawnPhase), A
7731+ CDF9 3E 19            LD A, RESPAWN_GRACE_FRAMES
7732+ CDFB 32 7E 82         LD (PlayerRespawnTimer), A
7733+ CDFE C9               RET
7734+ CDFF
7735+ CDFF              ; ==============================================================================
7736+ CDFF              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7737+ CDFF              ; ==============================================================================
7738+ CDFF              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7739+ CDFF              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7740+ CDFF              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7741+ CDFF              ; ==============================================================================
7742+ CDFF              UpdateDeathAnim:
7743+ CDFF 3A 79 82         LD A, (DeathBorderPhase)
7744+ CE02 FE 01            CP 1
7745+ CE04 C0               RET NZ
7746+ CE05 3A 7B 82         LD A, (PlayerDeathAnimTimer)
7747+ CE08 3D               DEC A
7748+ CE09 32 7B 82         LD (PlayerDeathAnimTimer), A
7749+ CE0C C0               RET NZ
7750+ CE0D                  ; Tick consumido: avanzar frame
7751+ CE0D 3A 7C 82         LD A, (PlayerDeathAnimFrame)
7752+ CE10 3C               INC A
7753+ CE11 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7754+ CE13 D0               RET NC                              ; ya en ultimo frame (clamp)
7755+ CE14 32 7C 82         LD (PlayerDeathAnimFrame), A
7756+ CE17 DD 21 3F 81      LD IX, EntityTable
7757+ CE1B DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7758+ CE1E                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7759+ CE1E                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7760+ CE1E                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7761+ CE1E FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7762+ CE20 20 06            JR NZ, .udaSkipSplatSfx
7763+ CE22 21 C5 F8         LD HL, SFX_EnemyDeath
7764+ CE25 CD 46 F8         CALL PlaySFX
7765+ CE28              .udaSkipSplatSfx:
7766+ CE28 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7767+ CE2A 32 7B 82         LD (PlayerDeathAnimTimer), A
7768+ CE2D C9               RET
7769+ CE2E
7770+ CE2E              ; ==============================================================================
7771+ CE2E              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7772+ CE2E              ; ==============================================================================
7773+ CE2E              UpdateDeathBorder:
7774+ CE2E 3A 79 82         LD A, (DeathBorderPhase)
7775+ CE31 B7               OR A
7776+ CE32 C8               RET Z
7777+ CE33 3A 7A 82         LD A, (DeathBorderTimer)
7778+ CE36 3D               DEC A
7779+ CE37 32 7A 82         LD (DeathBorderTimer), A
7780+ CE3A C0               RET NZ
7781+ CE3B                  ; Timer expiro: avanzar fase
7782+ CE3B 3A 79 82         LD A, (DeathBorderPhase)
7783+ CE3E FE 01            CP 1
7784+ CE40 20 33            JR NZ, .udbToBlack
7785+ CE42                  ; --- Fin fase amarillo ---
7786+ CE42                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7787+ CE42                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7788+ CE42 3A 70 82         LD A, (PlayerLives)
7789+ CE45 B7               OR A
7790+ CE46 28 1F            JR Z, .udbToGameOver
7791+ CE48 DD 21 3F 81      LD IX, EntityTable
7792+ CE4C DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7793+ CE50 3E 02            LD A, 2
7794+ CE52 32 79 82         LD (DeathBorderPhase), A
7795+ CE55 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7796+ CE57 32 7A 82         LD (DeathBorderTimer), A
7797+ CE5A 3E 02            LD A, RED
7798+ CE5C 32 D5 90         LD (CurrentBorderColor), A
7799+ CE5F D3 FE            OUT (254), A
7800+ CE61                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7801+ CE61                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7802+ CE61 3E 01            LD A, 1
7803+ CE63 32 86 82         LD (TombDrawPending), A
7804+ CE66 C9               RET
7805+ CE67              .udbToGameOver:
7806+ CE67                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7807+ CE67 AF               XOR A
7808+ CE68 32 79 82         LD (DeathBorderPhase), A
7809+ CE6B 3E 00            LD A, BLACK
7810+ CE6D 32 D5 90         LD (CurrentBorderColor), A
7811+ CE70 D3 FE            OUT (254), A
7812+ CE72 C3 83 CE         JP ShowGameOver
7813+ CE75              .udbToBlack:
7814+ CE75                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7815+ CE75 AF               XOR A
7816+ CE76 32 79 82         LD (DeathBorderPhase), A
7817+ CE79 3E 00            LD A, BLACK
7818+ CE7B 32 D5 90         LD (CurrentBorderColor), A
7819+ CE7E D3 FE            OUT (254), A
7820+ CE80 C3 20 CD         JP RespawnPlayerAtEntry             ; tail-call
7821+ CE83
7822+ CE83              ; ==============================================================================
7823+ CE83              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7824+ CE83              ; ==============================================================================
7825+ CE83              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7826+ CE83              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7827+ CE83              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7828+ CE83              ; ==============================================================================
7829+ CE83              ShowGameOver:
7830+ CE83 3E 01            LD A, 1
7831+ CE85 32 71 82         LD (GameOver), A
7832+ CE88 C9               RET
7833+ CE89
7834+ CE89              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7835+ CE89              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7836+ CE89              PaintGameOverScreen:
7837+ CE89                  ; Wipe pixels
7838+ CE89 21 00 40         LD HL, $4000
7839+ CE8C 11 01 40         LD DE, $4001
7840+ CE8F 01 FF 17         LD BC, $17FF
7841+ CE92 36 00            LD (HL), 0
7842+ CE94 ED B0            LDIR
7843+ CE96                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7844+ CE96 21 00 58         LD HL, $5800
7845+ CE99 11 01 58         LD DE, $5801
7846+ CE9C 01 FF 02         LD BC, $02FF
7847+ CE9F 36 47            LD (HL), $47
7848+ CEA1 ED B0            LDIR
7849+ CEA3                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7850+ CEA3 3E A0            LD A, GAMEOVER_ANIM_X_MAX
7851+ CEA5 32 72 82         LD (GameOverAnimX), A
7852+ CEA8 AF               XOR A
7853+ CEA9 32 73 82         LD (GameOverAnimDir), A
7854+ CEAC 32 74 82         LD (GameOverAnimFrame), A
7855+ CEAF 32 78 82         LD (GameOverAnimLastX), A
7856+ CEB2 21 00 00         LD HL, 0
7857+ CEB5 22 76 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7858+ CEB8 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7859+ CEBA 32 75 82         LD (GameOverAnimFrameTimer), A
7860+ CEBD                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7861+ CEBD                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7862+ CEBD                  ; congelado en GameOver=2.
7863+ CEBD 3E 03            LD A, 3
7864+ CEBF C3 F2 9C         JP StartMusic                   ; tail-call
7865+ CEC2
7866+ CEC2              ; ==============================================================================
7867+ CEC2              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7868+ CEC2              ; ==============================================================================
7869+ CEC2              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7870+ CEC2              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7871+ CEC2              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7872+ CEC2              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7873+ CEC2              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7874+ CEC2              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7875+ CEC2              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7876+ CEC2              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7877+ CEC2              ;
7878+ CEC2              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7879+ CEC2              ; shifted (que ocupa 4 chars = 32 px).
7880+ CEC2              ; ==============================================================================
7881+ CEC2              GAMEOVER_ANIM_Y           EQU 80
7882+ CEC2              GAMEOVER_ANIM_X_MIN       EQU 80
7883+ CEC2              GAMEOVER_ANIM_X_MAX       EQU 160
7884+ CEC2              GAMEOVER_ANIM_FRAME_TICKS EQU 6
7885+ CEC2
7886+ CEC2              UpdateGameOverAnim:
7887+ CEC2                  ; --- Erase del sprite previo (si lo hubo) ---
7888+ CEC2 2A 76 82         LD HL, (GameOverAnimLastSpr)
7889+ CEC5 7C               LD A, H
7890+ CEC6 B5               OR L
7891+ CEC7 28 0C            JR Z, .ugoaNoErase
7892+ CEC9 E5               PUSH HL
7893+ CECA DD E1            POP IX
7894+ CECC 3A 78 82         LD A, (GameOverAnimLastX)
7895+ CECF 5F               LD E, A
7896+ CED0 16 50            LD D, GAMEOVER_ANIM_Y
7897+ CED2 CD 1F 9D         CALL DrawSprite
7898+ CED5              .ugoaNoErase:
7899+ CED5
7900+ CED5                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
7901+ CED5 3A 75 82         LD A, (GameOverAnimFrameTimer)
7902+ CED8 3D               DEC A
7903+ CED9 20 0A            JR NZ, .ugoaTimerSet
7904+ CEDB 3A 74 82         LD A, (GameOverAnimFrame)
7905+ CEDE EE 01            XOR 1
7906+ CEE0 32 74 82         LD (GameOverAnimFrame), A
7907+ CEE3 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7908+ CEE5              .ugoaTimerSet:
7909+ CEE5 32 75 82         LD (GameOverAnimFrameTimer), A
7910+ CEE8
7911+ CEE8                  ; --- Avanzar X segun direccion (ping-pong) ---
7912+ CEE8 3A 73 82         LD A, (GameOverAnimDir)
7913+ CEEB B7               OR A
7914+ CEEC 20 14            JR NZ, .ugoaSlideRight
7915+ CEEE                  ; Dir 0: facing R, slide LEFT (X--)
7916+ CEEE 3A 72 82         LD A, (GameOverAnimX)
7917+ CEF1 FE 50            CP GAMEOVER_ANIM_X_MIN
7918+ CEF3 28 06            JR Z, .ugoaFlipToL
7919+ CEF5 3D               DEC A
7920+ CEF6 32 72 82         LD (GameOverAnimX), A
7921+ CEF9 18 18            JR .ugoaPickSprite
7922+ CEFB              .ugoaFlipToL:
7923+ CEFB 3E 01            LD A, 1
7924+ CEFD 32 73 82         LD (GameOverAnimDir), A
7925+ CF00 18 11            JR .ugoaPickSprite
7926+ CF02              .ugoaSlideRight:
7927+ CF02                  ; Dir 1: facing L, slide RIGHT (X++)
7928+ CF02 3A 72 82         LD A, (GameOverAnimX)
7929+ CF05 FE A0            CP GAMEOVER_ANIM_X_MAX
7930+ CF07 28 06            JR Z, .ugoaFlipToR
7931+ CF09 3C               INC A
7932+ CF0A 32 72 82         LD (GameOverAnimX), A
7933+ CF0D 18 04            JR .ugoaPickSprite
7934+ CF0F              .ugoaFlipToR:
7935+ CF0F AF               XOR A
7936+ CF10 32 73 82         LD (GameOverAnimDir), A
7937+ CF13
7938+ CF13              .ugoaPickSprite:
7939+ CF13                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
7940+ CF13                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
7941+ CF13                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
7942+ CF13 3A 73 82         LD A, (GameOverAnimDir)
7943+ CF16 B7               OR A
7944+ CF17 20 0E            JR NZ, .ugoaPickR
7945+ CF19 3A 74 82         LD A, (GameOverAnimFrame)
7946+ CF1C B7               OR A
7947+ CF1D 21 FB DD         LD HL, SprDeath_L0
7948+ CF20 28 11            JR Z, .ugoaSprSet
7949+ CF22 21 45 DE         LD HL, SprDeath_L1
7950+ CF25 18 0C            JR .ugoaSprSet
7951+ CF27              .ugoaPickR:
7952+ CF27 3A 74 82         LD A, (GameOverAnimFrame)
7953+ CF2A B7               OR A
7954+ CF2B 21 67 DD         LD HL, SprDeath_0
7955+ CF2E 28 03            JR Z, .ugoaSprSet
7956+ CF30 21 B1 DD         LD HL, SprDeath_1
7957+ CF33              .ugoaSprSet:
7958+ CF33 22 76 82         LD (GameOverAnimLastSpr), HL
7959+ CF36 3A 72 82         LD A, (GameOverAnimX)
7960+ CF39 32 78 82         LD (GameOverAnimLastX), A
7961+ CF3C
7962+ CF3C                  ; --- Draw nuevo sprite ---
7963+ CF3C E5               PUSH HL
7964+ CF3D DD E1            POP IX
7965+ CF3F 5F               LD E, A
7966+ CF40 16 50            LD D, GAMEOVER_ANIM_Y
7967+ CF42 C3 1F 9D         JP DrawSprite                   ; tail-call
7968+ CF45
