 209+ EB36              ; ==============================================================================
 210+ EB36              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 211+ EB36              ;                                 store los 4 attr bytes (TL,TR,BL,BR) del 2x2.
 212+ EB36              ; ==============================================================================
 213+ EB36              ; Antes guardaba solo attr[0] (TL) y PaintSynthPickupAttrs lo replicaba a las
 214+ EB36              ; 4 celdas, perdiendo el patrón per-celda del BG editor (ej: col1 bright,
 215+ EB36              ; col2 dim). Ahora extraemos los 4 → preservación 1:1.
 216+ EB36              ; ==============================================================================
 217+ EB36              LoadSynthSpriteAndExtractAttr:
 218+ EB36 22 B6 5F         LD (RandomSynthPtr), HL
 219+ EB39 3E 03            LD A, 3
 220+ EB3B CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 221+ EB3E DD 21 FD 86      LD IX, BgSpriteBuffer
 222+ EB42 CD 54 6C         CALL SkipPixelData_B7                      ; IX @ tintPaper
 223+ EB45 DD 23            INC IX                                  ; @ attr_h
 224+ EB47 DD 23            INC IX                                  ; @ attr_w
 225+ EB49 DD 23            INC IX                                  ; @ attr_data[0] = TL
 226+ EB4B DD 7E 00         LD A, (IX+0)
 227+ EB4E 32 BB 5F         LD (RandomSynthAttr), A                 ; TL
 228+ EB51 DD 7E 01         LD A, (IX+1)
 229+ EB54 32 E1 5F         LD (RandomSynthAttrTR), A
 230+ EB57 DD 7E 02         LD A, (IX+2)
 231+ EB5A 32 E2 5F         LD (RandomSynthAttrBL), A
 232+ EB5D DD 7E 03         LD A, (IX+3)
 233+ EB60 32 E3 5F         LD (RandomSynthAttrBR), A
 234+ EB63 C9               RET
