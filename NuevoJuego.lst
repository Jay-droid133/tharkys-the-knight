 291+ F8C6              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 292+ F8C6              ; ==============================================================================
 293+ F8C6              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 294+ F8C6              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 295+ F8C6              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 296+ F8C6              BankCutsceneSnapToRetreat:
 297+ F8C6 DD 21 9B 81      LD IX, EntityTable
 298+ F8CA DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 299+ F8CE DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 300+ F8D2 DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 301+ F8D6 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 302+ F8D8 32 DC 82         LD (PlayerDrawY), A
 303+ F8DB 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 304+ F8DD DD 77 00         LD (IX+ENT_SPRITEID), A
 305+ F8E0 3E 0A            LD A, SPRID_WALK_N
 306+ F8E2 DD 77 08         LD (IX+ENT_ANIMBASE), A
 307+ F8E5 AF               XOR A
 308+ F8E6 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 309+ F8E9 C3 9E 63         JP TownGateRedrawPlayer
 310+ F8EC
 311+ F8EC              ; ==============================================================================
 312+ F8EC              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 313+ F8EC              ; ==============================================================================
 314+ F8EC              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 315+ F8EC              ; para asegurar que el player mira a la puerta antes del primer snap.
 316+ F8EC              BankCutsceneFacingNRedraw:
 317+ F8EC DD 21 9B 81      LD IX, EntityTable
 318+ F8F0 DD 7E 04         LD A, (IX+ENT_POSY)
