 671+ A540
 672+ A540                  ; === STATE_SCARED: pausa dramatica + huida ===
 673+ A540              .peScared:
 674+ A540 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 675+ A544 C2 09 A6         JP NZ, .peScaredFresh
 676+ A547
 677+ A547                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 678+ A547 3A 07 B9         LD A, (ScareTimer)
 679+ A54A FE 33            CP SCARE_FLEE_THRESHOLD + 1
 680+ A54C DA EC A5         JP C, .peScaredFlee
 681+ A54F                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 682+ A54F                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 683+ A54F DD 36 06 00      LD (IX+ENT_DELTAX), 0
 684+ A553 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 685+ A557                  ; Shake monster-only (nasties durante bells no se agitan)
 686+ A557 DD 7E 01         LD A, (IX+ENT_TYPE)
 687+ A55A FE 02            CP TYPE_MONSTER
 688+ A55C C2 D2 A5         JP NZ, .peScaredSpriteToggle
 689+ A55F                  ; --- Shake ---
 690+ A55F CD 9E 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 691+ A562 5F               LD E, A
 692+ A563 16 00            LD D, 0
 693+ A565 21 F8 90         LD HL, MonsterAiFlags
 694+ A568 19               ADD HL, DE
 695+ A569 7E               LD A, (HL)
 696+ A56A CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 697+ A56C 20 15            JR NZ, .peShakeActive
 698+ A56E                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 699+ A56E F6 08            OR MAI_FLAG_SHAKE_SAVED
 700+ A570 77               LD (HL), A
 701+ A571 21 97 5F         LD HL, MonsterShakeOrigX
 702+ A574 19               ADD HL, DE
 703+ A575 DD 7E 03         LD A, (IX+ENT_POSX)
 704+ A578 77               LD (HL), A
 705+ A579 21 9A 5F         LD HL, MonsterShakeOrigY
 706+ A57C 19               ADD HL, DE
 707+ A57D DD 7E 04         LD A, (IX+ENT_POSY)
 708+ A580 77               LD (HL), A
 709+ A581 18 4F            JR .peScaredSpriteToggle
 710+ A583              .peShakeActive:
 711+ A583                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 712+ A583 ED 5F            LD A, R
 713+ A585 E6 03            AND 3
 714+ A587 28 0C            JR Z, .peShakeUp
 715+ A589 3D               DEC A
 716+ A58A 28 0F            JR Z, .peShakeDown
 717+ A58C 3D               DEC A
 718+ A58D 28 12            JR Z, .peShakeLeft
 719+ A58F                  ; 3: right
 720+ A58F 06 01            LD B, 1
 721+ A591 0E 00            LD C, 0
 722+ A593 18 10            JR .peShakeApply
 723+ A595              .peShakeUp:
 724+ A595 06 00            LD B, 0
 725+ A597 0E FF            LD C, -1
 726+ A599 18 0A            JR .peShakeApply
 727+ A59B              .peShakeDown:
 728+ A59B 06 00            LD B, 0
 729+ A59D 0E 01            LD C, 1
 730+ A59F 18 04            JR .peShakeApply
 731+ A5A1              .peShakeLeft:
 732+ A5A1 06 FF            LD B, -1
 733+ A5A3 0E 00            LD C, 0
 734+ A5A5              .peShakeApply:
 735+ A5A5                  ; new POSX = orig + B, new POSY = orig + C
 736+ A5A5 21 97 5F         LD HL, MonsterShakeOrigX
 737+ A5A8 19               ADD HL, DE
 738+ A5A9 7E               LD A, (HL)
 739+ A5AA 80               ADD A, B
 740+ A5AB DD 77 03         LD (IX+ENT_POSX), A
 741+ A5AE 21 9A 5F         LD HL, MonsterShakeOrigY
 742+ A5B1 19               ADD HL, DE
 743+ A5B2 7E               LD A, (HL)
 744+ A5B3 81               ADD A, C
 745+ A5B4 DD 77 04         LD (IX+ENT_POSY), A
 746+ A5B7                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 747+ A5B7 CD D6 B9         CALL CheckEnemyCollision
 748+ A5BA 28 16            JR Z, .peScaredSpriteToggle
 749+ A5BC                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 750+ A5BC CD 9E 92         CALL MaiGetMonsterSlot
 751+ A5BF 5F               LD E, A
