1371+ F3BB
1372+ F3BB              ; ==============================================================================
1373+ F3BB              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1374+ F3BB              ; ==============================================================================
1375+ F3BB              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1376+ F3BB              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1377+ F3BB              ; ==============================================================================
1378+ F3BB              ChurchCutsceneEraseStatueAtLast:
1379+ F3BB              ChurchCutsceneDrawStatueAtLast:
1380+ F3BB 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1381+ F3BE 21 A9 67         LD HL, StatueIdTable
1382+ F3C1 5F               LD E, A
1383+ F3C2 16 00            LD D, 0
1384+ F3C4 19               ADD HL, DE
1385+ F3C5 7E               LD A, (HL)                              ; A = statue id
1386+ F3C6 B7               OR A
1387+ F3C7 C8               RET Z
1388+ F3C8                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1389+ F3C8 6F               LD L, A
1390+ F3C9 26 00            LD H, 0
1391+ F3CB 54               LD D, H
1392+ F3CC 5D               LD E, L
1393+ F3CD 29               ADD HL, HL
1394+ F3CE 19               ADD HL, DE                              ; HL = id*3
1395+ F3CF 11 28 DF         LD DE, BgGfxPtrById
1396+ F3D2 19               ADD HL, DE
1397+ F3D3 5E               LD E, (HL)
1398+ F3D4 23               INC HL
1399+ F3D5 56               LD D, (HL)                              ; DE = sprite ptr
1400+ F3D6 23               INC HL
1401+ F3D7 7E               LD A, (HL)                              ; A = bank
1402+ F3D8 EB               EX DE, HL                               ; HL = sprite ptr
1403+ F3D9 CD C2 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1404+ F3DC                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1405+ F3DC 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1406+ F3DF 57               LD D, A
1407+ F3E0 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1408+ F3E3 5F               LD E, A
1409+ F3E4 C3 31 69         JP DrawBgSprite16XorAtPixel
1410+ F3E7
1411+ F3E7              ; ==============================================================================
1412+ F3E7              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1413+ F3E7              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1414+ F3E7              ;     A  = jitter signed (-1, 0, +1) en bits.
1415+ F3E7              ; ==============================================================================
1416+ F3E7              ; IN: A = jitter signed (-1, 0, +1) en bits.
1417+ F3E7              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1418+ F3E7              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1419+ F3E7              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1420+ F3E7              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1421+ F3E7              ; version shifted, sin XOR.
1422+ F3E7              ;
1423+ F3E7              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1424+ F3E7              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1425+ F3E7              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1426+ F3E7              ; estatua se perdio cuando la estatua se pinto la primera vez con
1427+ F3E7              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1428+ F3E7              ; de la estatua, el wall perdido no se ve.
1429+ F3E7              ;
1430+ F3E7              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1431+ F3E7              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1432+ F3E7              ; shift de 1 bit no pierde pixels visibles.
1433+ F3E7              ; Destruye: AF, BC, DE, HL, IX.
1434+ F3E7              ; ==============================================================================
1435+ F3E7              ChurchCutsceneShakeStatueByteShift:
1436+ F3E7 32 51 F4         LD (.csbsJitter), A
1437+ F3EA                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1438+ F3EA 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1439+ F3ED 5F               LD E, A
1440+ F3EE 16 00            LD D, 0
1441+ F3F0 19               ADD HL, DE
1442+ F3F1 7E               LD A, (HL)
1443+ F3F2 B7               OR A
1444+ F3F3 C8               RET Z                                   ; sin estatua
1445+ F3F4 6F               LD L, A
1446+ F3F5 26 00            LD H, 0
1447+ F3F7 54               LD D, H
1448+ F3F8 5D               LD E, L
1449+ F3F9 29               ADD HL, HL
1450+ F3FA 19               ADD HL, DE                              ; HL = id*3
1451+ F3FB 11 28 DF         LD DE, BgGfxPtrById
1452+ F3FE 19               ADD HL, DE
1453+ F3FF 5E               LD E, (HL)
1454+ F400 23               INC HL
1455+ F401 56               LD D, (HL)                              ; DE = sprite ptr
1456+ F402 23               INC HL
1457+ F403 7E               LD A, (HL)                              ; A = bank
1458+ F404 EB               EX DE, HL                               ; HL = sprite ptr
1459+ F405 CD C2 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1460+ F408                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1461+ F408 DD 21 F5 86      LD IX, BgSpriteBuffer
1462+ F40C DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1463+ F40F B7               OR A
1464+ F410 C8               RET Z
1465+ F411 47               LD B, A                                 ; B = row counter
1466+ F412 DD 23            INC IX
1467+ F414 DD 23            INC IX                                  ; IX -> pixel data
1468+ F416                  ; Calcular addr VRAM en (origX, origY)
1469+ F416 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1470+ F419 57               LD D, A
1471+ F41A 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1472+ F41D 5F               LD E, A
1473+ F41E CD 5A 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1474+ F421              .csbsRow:
1475+ F421 C5               PUSH BC
1476+ F422 E5               PUSH HL                                 ; save inicio fila VRAM
1477+ F423                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1478+ F423 DD 7E 00         LD A, (IX+0)
1479+ F426 2F               CPL
1480+ F427 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1481+ F428 DD 7E 01         LD A, (IX+1)
1482+ F42B 2F               CPL
1483+ F42C 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1484+ F42D                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1485+ F42D 3A 51 F4         LD A, (.csbsJitter)
1486+ F430 B7               OR A
1487+ F431 28 0D            JR Z, .csbsWrite                        ; sin shift
1488+ F433 FA 3C F4         JP M, .csbsLeft                         ; A < 0 -> shift left
1489+ F436                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1490+ F436 CB 3A            SRL D
1491+ F438 CB 1B            RR E
1492+ F43A 18 04            JR .csbsWrite
1493+ F43C              .csbsLeft:
1494+ F43C CB 23            SLA E
1495+ F43E CB 12            RL D
1496+ F440              .csbsWrite:
1497+ F440 7A               LD A, D
1498+ F441 77               LD (HL), A
1499+ F442 23               INC HL
1500+ F443 7B               LD A, E
1501+ F444 77               LD (HL), A
1502+ F445 E1               POP HL
1503+ F446 CD C6 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1504+ F449 DD 23            INC IX
1505+ F44B DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1506+ F44D C1               POP BC
1507+ F44E 10 D1            DJNZ .csbsRow
1508+ F450 C9               RET
1509+ F451 00           .csbsJitter: DEFB 0
1510+ F452
1511+ F452              ; ==============================================================================
1512+ F452              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1513+ F452              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1514+ F452              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1515+ F452              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1516+ F452              ; Destruye: AF, BC, HL.
1517+ F452              ; ==============================================================================
1518+ F452              ChurchCutsceneEraseStatueDirect:
1519+ F452 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1520+ F455 57               LD D, A
1521+ F456 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1522+ F459 5F               LD E, A
1523+ F45A CD 5A 9D         CALL CalcPixelAddr
1524+ F45D 06 18            LD B, 24                                ; statues son 24 px de alto
1525+ F45F              .csedRow:
1526+ F45F AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1527+ F460 77               LD (HL), A
1528+ F461 23               INC HL
1529+ F462 77               LD (HL), A
1530+ F463 2B               DEC HL                                  ; volver a inicio fila
1531+ F464 C5               PUSH BC
1532+ F465 CD C6 9A         CALL NextPixelLine
1533+ F468 C1               POP BC
1534+ F469 10 F4            DJNZ .csedRow
1535+ F46B C9               RET
