1520+ 9AEB 18 2A            JR .noPushBackPop
1521+ 9AED
1522+ 9AED                  ; Attack east: comprobar X+23 en fila superior E inferior → mover -8
1523+ 9AED              .pushBackEast:
1524+ 9AED D5               PUSH DE
1525+ 9AEE C5               PUSH BC
1526+ 9AEF DD 7E 03         LD A, (IX+ENT_POSX)
1527+ 9AF2 C6 17            ADD A, 23
1528+ 9AF4 47               LD B, A
1529+ 9AF5 DD 7E 04         LD A, (IX+ENT_POSY)
1530+ 9AF8 4F               LD C, A
1531+ 9AF9 CD 67 B4         CALL IsPointBlocked
1532+ 9AFC 20 11            JR NZ, .doPushBackEast
1533+ 9AFE DD 7E 03         LD A, (IX+ENT_POSX)
1534+ 9B01 C6 17            ADD A, 23
1535+ 9B03 47               LD B, A
1536+ 9B04 DD 7E 04         LD A, (IX+ENT_POSY)
1537+ 9B07 C6 14            ADD A, 20
1538+ 9B09 4F               LD C, A
1539+ 9B0A CD 67 B4         CALL IsPointBlocked
1540+ 9B0D 28 08            JR Z, .noPushBackPop
1541+ 9B0F              .doPushBackEast:
1542+ 9B0F DD 7E 03         LD A, (IX+ENT_POSX)
1543+ 9B12 D6 08            SUB 8
1544+ 9B14 DD 77 03         LD (IX+ENT_POSX), A
1545+ 9B17              .noPushBackPop:
1546+ 9B17 C1               POP BC
1547+ 9B18 D1               POP DE
1548+ 9B19              .noPushBack:
1549+ 9B19                  ; Si es animacion de ataque → SFX al inicio del primer swing
1550+ 9B19 7A               LD A, D
1551+ 9B1A FE 16            CP SPRID_ATTACK_EAST
1552+ 9B1C 28 04            JR Z, .newAnimAttackSfx
1553+ 9B1E FE 1B            CP SPRID_ATTACK_WEST
1554+ 9B20 20 0F            JR NZ, .newAnimNoSfx
1555+ 9B22              .newAnimAttackSfx:
