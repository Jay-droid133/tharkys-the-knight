 705+ D393              ; ==============================================================================
 706+ D393              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 707+ D393              ; ==============================================================================
 708+ D393              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 709+ D393              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 710+ D393              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 711+ D393              ; ==============================================================================
 712+ D393              DrawBgGfxSprite:
 713+ D393 DD 7E 00         LD A, (IX+0)                ; height_px
 714+ D396 B7               OR A
 715+ D397 C8               RET Z                       ; sprite nulo (sin datos)
 716+ D398 32 96 D4         LD (.heightCnt), A
 717+ D39B DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
 718+ D39E 32 9A D4         LD (.rleFlag), A
 719+ D3A1 E6 7F            AND $7F
 720+ D3A3 32 97 D4         LD (.widthVal), A
 721+ D3A6
 722+ D3A6                  ; Aplicar offset HUD: desplazar sprites BG 2 filas hacia abajo
 723+ D3A6 79               LD A, C
 724+ D3A7 C6 02            ADD A, BG_Y_OFFSET
 725+ D3A9 4F               LD C, A
 726+ D3AA
 727+ D3AA                  ; Guardar posicion para la fase de atributos
 728+ D3AA 78               LD A, B
 729+ D3AB 32 98 D4         LD (.xChar), A
 730+ D3AE 79               LD A, C
 731+ D3AF 32 99 D4         LD (.yChar), A
 732+ D3B2
 733+ D3B2 DD 23            INC IX
 734+ D3B4 DD 23            INC IX                      ; IX -> pixel data
 735+ D3B6
 736+ D3B6                  ; Calcular dir VRAM inicio: x_pixel = x_char*8, y_pixel = y_char*8
 737+ D3B6 79               LD A, C
 738+ D3B7 07               RLCA
 739+ D3B8 07               RLCA
 740+ D3B9 07               RLCA
 741+ D3BA 57               LD D, A                     ; D = y_pixel
 742+ D3BB 78               LD A, B
 743+ D3BC 07               RLCA
 744+ D3BD 07               RLCA
 745+ D3BE 07               RLCA
 746+ D3BF 5F               LD E, A                     ; E = x_pixel
 747+ D3C0 CD 92 A0         CALL CalcPixelAddr          ; HL = dir VRAM
 748+ D3C3
 749+ D3C3                  ; --- Inicializar RLE state ---
 750+ D3C3 AF               XOR A
 751+ D3C4 32 9B D4         LD (.rlePending), A         ; sin run pendiente al inicio
 752+ D3C7
 753+ D3C7                  ; --- Comprobar si es RLE o literal ---
 754+ D3C7 3A 9A D4         LD A, (.rleFlag)
 755+ D3CA CB 7F            BIT 7, A
 756+ D3CC 20 1E            JR NZ, .rlePixRow
 757+ D3CE
 758+ D3CE                  ; ===================== PATH LITERAL (sin cambios) =====================
 759+ D3CE              .pixRow:
 760+ D3CE 3A 97 D4         LD A, (.widthVal)
 761+ D3D1 47               LD B, A
 762+ D3D2 E5               PUSH HL                     ; guardar inicio de fila VRAM
 763+ D3D3
 764+ D3D3              .pixCol:
 765+ D3D3 DD 7E 00         LD A, (IX+0)
 766+ D3D6 2F               CPL                         ; des-invertir (dato almacenado CPL'd)
 767+ D3D7 77               LD (HL), A
 768+ D3D8 DD 23            INC IX
 769+ D3DA 23               INC HL
 770+ D3DB 10 F6            DJNZ .pixCol
 771+ D3DD
 772+ D3DD E1               POP HL                      ; restaurar inicio fila
 773+ D3DE 3A 96 D4         LD A, (.heightCnt)
 774+ D3E1 3D               DEC A
 775+ D3E2 32 96 D4         LD (.heightCnt), A
 776+ D3E5 28 66            JR Z, .pixDone
 777+ D3E7 CD FE 9D         CALL NextPixelLine          ; HL = siguiente linea pixel
 778+ D3EA 18 E2            JR .pixRow
 779+ D3EC
 780+ D3EC                  ; ===================== PATH RLE =====================
 781+ D3EC                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 782+ D3EC                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 783+ D3EC                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 784+ D3EC                  ; El estado .rlePending conserva el chunk entre filas:
 785+ D3EC                  ;   0 = necesita nuevo token
 786+ D3EC                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 787+ D3EC                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 788+ D3EC              .rlePixRow:
 789+ D3EC 3A 97 D4         LD A, (.widthVal)
 790+ D3EF 47               LD B, A
 791+ D3F0 E5               PUSH HL                     ; guardar inicio de fila VRAM
 792+ D3F1
 793+ D3F1              .rlePixCol:
 794+ D3F1 3A 9B D4         LD A, (.rlePending)
 795+ D3F4 B7               OR A
 796+ D3F5 CA 0C D4         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 797+ D3F8 FA 1A D4         JP M, .rleLitEmit           ; <0 = literal group en curso
 798+ D3FB                  ; >0 = run en curso, emitir valor
 799+ D3FB              .rleRunEmit:
 800+ D3FB 3A 9C D4         LD A, (.rleValue)
 801+ D3FE 2F               CPL
 802+ D3FF 77               LD (HL), A
 803+ D400 23               INC HL
 804+ D401 3A 9B D4         LD A, (.rlePending)
 805+ D404 3D               DEC A
 806+ D405 32 9B D4         LD (.rlePending), A
 807+ D408 10 E7            DJNZ .rlePixCol
 808+ D40A 18 32            JR .rleRowDone
 809+ D40C
 810+ D40C              .rleNewToken:
 811+ D40C DD 7E 00         LD A, (IX+0)
 812+ D40F DD 23            INC IX
 813+ D411 CB 7F            BIT 7, A
 814+ D413 20 18            JR NZ, .rleNewRun
 815+ D415                  ; --- Literal group: A = count (1-127) ---
 816+ D415 ED 44            NEG                         ; A = -count (negativo)
 817+ D417 32 9B D4         LD (.rlePending), A
 818+ D41A                  ; fall through: emitir primer byte literal
 819+ D41A
 820+ D41A              .rleLitEmit:
 821+ D41A DD 7E 00         LD A, (IX+0)
 822+ D41D DD 23            INC IX
 823+ D41F 2F               CPL
 824+ D420 77               LD (HL), A
 825+ D421 23               INC HL
 826+ D422 3A 9B D4         LD A, (.rlePending)
 827+ D425 3C               INC A                       ; hacia 0
 828+ D426 32 9B D4         LD (.rlePending), A
 829+ D429 10 C6            DJNZ .rlePixCol
 830+ D42B 18 11            JR .rleRowDone
 831+ D42D
 832+ D42D                  ; --- Run: count = (A & $7F) + 2 ---
 833+ D42D              .rleNewRun:
 834+ D42D E6 7F            AND $7F
 835+ D42F C6 02            ADD A, 2
 836+ D431 32 9B D4         LD (.rlePending), A
 837+ D434 DD 7E 00         LD A, (IX+0)
 838+ D437 DD 23            INC IX
 839+ D439 32 9C D4         LD (.rleValue), A
 840+ D43C 18 BD            JR .rleRunEmit
 841+ D43E
 842+ D43E              .rleRowDone:
 843+ D43E E1               POP HL                      ; restaurar inicio fila
 844+ D43F 3A 96 D4         LD A, (.heightCnt)
 845+ D442 3D               DEC A
 846+ D443 32 96 D4         LD (.heightCnt), A
 847+ D446 28 05            JR Z, .pixDone
 848+ D448 CD FE 9D         CALL NextPixelLine
 849+ D44B 18 9F            JR .rlePixRow
 850+ D44D
 851+ D44D              .pixDone:
 852+ D44D                  ; --- Leer tintPaper del sprite data ---
 853+ D44D DD 7E 00         LD A, (IX+0)                ; tintPaper (255=not tintable)
 854+ D450 32 9E D4         LD (CurrentTintPaper), A
 855+ D453 DD 23            INC IX
 856+ D455
 857+ D455                  ; --- Pintar atributos ---
 858+ D455 DD 7E 00         LD A, (IX+0)                ; attr_h
 859+ D458 B7               OR A
 860+ D459 C8               RET Z
 861+ D45A 5F               LD E, A                     ; E = filas de atributos
 862+ D45B DD 7E 01         LD A, (IX+1)                ; attr_w
 863+ D45E 57               LD D, A                     ; D = columnas de atributos
 864+ D45F DD 23            INC IX
 865+ D461 DD 23            INC IX                      ; IX -> attr data
 866+ D463
 867+ D463                  ; Calcular dir atributos: ATTR_BASE + y_char*32 + x_char
 868+ D463 3A 99 D4         LD A, (.yChar)
 869+ D466 6F               LD L, A
 870+ D467 26 00            LD H, 0
 871+ D469 29               ADD HL, HL
 872+ D46A 29               ADD HL, HL
 873+ D46B 29               ADD HL, HL
 874+ D46C 29               ADD HL, HL
 875+ D46D 29               ADD HL, HL                  ; HL = y_char * 32
 876+ D46E 3A 98 D4         LD A, (.xChar)
 877+ D471 85               ADD A, L
 878+ D472 6F               LD L, A
 879+ D473 30 01            JR NC, .noCarryA
 880+ D475 24               INC H
 881+ D476              .noCarryA:
 882+ D476 01 00 58         LD BC, ATTR_BASE
 883+ D479 09               ADD HL, BC                  ; HL = dir atributo VRAM
 884+ D47A
 885+ D47A              .attrRow:
 886+ D47A 42               LD B, D                     ; B = attr_w
 887+ D47B E5               PUSH HL
 888+ D47C
 889+ D47C              .attrCol:
 890+ D47C DD 7E 00         LD A, (IX+0)
 891+ D47F CD A1 D4         CALL ApplyTintSwap          ; Reemplazar paper si coincide con tintPaper
 892+ D482 CD FF E5         CALL ApplyDayCycleRemap     ; Transformar attr segun momento del dia
 893+ D485 77               LD (HL), A
 894+ D486 DD 23            INC IX
 895+ D488 23               INC HL
 896+ D489 10 F1            DJNZ .attrCol
 897+ D48B
 898+ D48B E1               POP HL
 899+ D48C D5               PUSH DE
 900+ D48D 11 20 00         LD DE, 32
 901+ D490 19               ADD HL, DE
 902+ D491 D1               POP DE
 903+ D492 1D               DEC E
 904+ D493 20 E5            JR NZ, .attrRow
 905+ D495 C9               RET
 906+ D496
 907+ D496              ; Variables locales DrawBgGfxSprite
 908+ D496 00           .heightCnt: DEFB 0
 909+ D497 00           .widthVal:  DEFB 0
 910+ D498 00           .xChar:     DEFB 0
 911+ D499 00           .yChar:     DEFB 0
 912+ D49A 00           .rleFlag:   DEFB 0              ; bit 7 = sprite RLE comprimido
 913+ D49B 00           .rlePending: DEFB 0             ; bytes restantes del run actual
 914+ D49C 00           .rleValue:  DEFB 0              ; valor del run actual
 915+ D49D
 916+ D49D              ; Variables de tint
 917+ D49D FF           CurrentTintVar:   DEFB $FF    ; paper destino del placement (255=sin tint)
 918+ D49E FF           CurrentTintPaper: DEFB $FF    ; paper original tintable del sprite (255=no tintable)
 919+ D49F
 920+ D49F              ; Bank del sprite que se va a cargar con LoadBgSpriteToBuffer. Los iteradores
 921+ D49F              ; de placements (DrawScreen, RemapScreenAttrs, CollisionMap) lo leen de
 922+ D49F              ; BgGfxPtrById[id].bank tras resolver el ID. HUD y otros callers con labels
 923+ D49F              ; hardcoded (DrawKeyHUD, etc.) asignan 3 directamente.
 924+ D49F 03           CurrentBgSpriteBank: DEFB 3
 925+ D4A0
 926+ D4A0              ; ID del sprite actualmente siendo procesado en los iteradores (Stage B.2).
 927+ D4A0              ; Usado por CheckIfHouseSprite (compara por ID contra HouseIdList) y por
 928+ D4A0              ; comparaciones con WELL_POZO_ID / RELOJ_PLAZA_ID en DrawScreen.
 929+ D4A0 00           CurrentBgSpriteId: DEFB 0
 930+ D4A1
 931+ D4A1              ; ==============================================================================
 932+ D4A1              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 933+ D4A1              ; ==============================================================================
 934+ D4A1              ; Entrada: A = attr byte
 935+ D4A1              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 936+ D4A1              ; Preserva: HL, DE, BC, IX
 937+ D4A1              ; ==============================================================================
 938+ D4A1              ApplyTintSwap:
 939+ D4A1 C5               PUSH BC
 940+ D4A2 47               LD B, A                     ; B = attr original
 941+ D4A3 3A 9D D4         LD A, (CurrentTintVar)
 942+ D4A6 FE FF            CP $FF
 943+ D4A8 28 24            JR Z, .tintNoChange
 944+ D4AA 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 945+ D4AB 3A 9E D4         LD A, (CurrentTintPaper)
 946+ D4AE FE FF            CP $FF
 947+ D4B0 28 1C            JR Z, .tintNoChange
 948+ D4B2                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 949+ D4B2                  ; Extraer paper del attr: bits 5-3
 950+ D4B2 78               LD A, B
 951+ D4B3 E6 38            AND $38                     ; A = 00PPP000
 952+ D4B5 0F               RRCA
 953+ D4B6 0F               RRCA
 954+ D4B7 0F               RRCA                        ; A = 00000PPP = paper actual
 955+ D4B8 D5               PUSH DE
 956+ D4B9 57               LD D, A                     ; D = paper actual
 957+ D4BA 3A 9E D4         LD A, (CurrentTintPaper)
 958+ D4BD BA               CP D                        ; paper actual == tintPaper?
 959+ D4BE D1               POP DE
 960+ D4BF 20 0D            JR NZ, .tintNoChange
 961+ D4C1                  ; Match: reemplazar paper bits con tintVar
 962+ D4C1 78               LD A, B
 963+ D4C2 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 964+ D4C4 D5               PUSH DE
 965+ D4C5 57               LD D, A
 966+ D4C6 79               LD A, C                     ; A = tintVar (0-7)
 967+ D4C7 07               RLCA
 968+ D4C8 07               RLCA
 969+ D4C9 07               RLCA                        ; A = 00PPP000
 970+ D4CA B2               OR D                        ; A = FBPPPIII
 971+ D4CB D1               POP DE
 972+ D4CC C1               POP BC
 973+ D4CD C9               RET
 974+ D4CE              .tintNoChange:
 975+ D4CE 78               LD A, B                     ; devolver sin cambio
 976+ D4CF C1               POP BC
 977+ D4D0 C9               RET
 978+ D4D1
 979+ D4D1              ; ==============================================================================
 980+ D4D1              ; RemapScreenAttrs - Remap rapido de atributos (sin redibujar pixeles)
 981+ D4D1              ; ==============================================================================
 982+ D4D1              ; Solo se ejecuta cuando AttrsDirty=1 (cambio de fase day/night).
 983+ D4D1              ; Itera BG sprites saltando pixel data, solo repinta attrs con nuevo remap.
 984+ D4D1              ; ==============================================================================
 985+ D4D1              RemapScreenAttrs:
 986+ D4D1 3A A3 82         LD A, (AttrsDirty)
 987+ D4D4 B7               OR A
 988+ D4D5 C8               RET Z
 989+ D4D6
 990+ D4D6 AF               XOR A
 991+ D4D7 32 A3 82         LD (AttrsDirty), A
 992+ D4DA
 993+ D4DA                  ; --- Iterar sprites del room (solo attrs, formato Stage A) ---
 994+ D4DA 2A 9C 82         LD HL, (CurrentScreenAddr)
 995+ D4DD              .rsLoop:
 996+ D4DD 7E               LD A, (HL)                  ; A = id
 997+ D4DE 23               INC HL
 998+ D4DF FE FF            CP $FF
 999+ D4E1 28 42            JR Z, .rsDone
1000+ D4E3 FE D2            CP RANDOM_SLOT_MARKER       ; id 210: ghost (no remap, no attrs).
1001+ D4E5 20 05            JR NZ, .rsNotMarker
1002+ D4E7 23               INC HL
1002+ D4E8 23             INC HL
1002+ D4E9 23             INC HL    ; skip x, y, v
1003+ D4EA 18 F1            JR .rsLoop
1004+ D4EC              .rsNotMarker:
1005+ D4EC 32 A0 D4         LD (CurrentBgSpriteId), A
1006+ D4EF
1007+ D4EF                  ; Resolver id -> (ptr, bank) via BgGfxPtrById (formato 3B: ptr + bank)
1008+ D4EF E5               PUSH HL
1009+ D4F0 6F               LD L, A
1010+ D4F1 26 00            LD H, 0
1011+ D4F3 54               LD D, H
1012+ D4F4 5D               LD E, L                     ; DE = id
1013+ D4F5 29               ADD HL, HL                  ; HL = id*2
1014+ D4F6 19               ADD HL, DE                  ; HL = id*3
1015+ D4F7 11 97 E1         LD DE, BgGfxPtrById
1016+ D4FA 19               ADD HL, DE
1017+ D4FB 5E               LD E, (HL)
1018+ D4FC 23               INC HL
1019+ D4FD 56               LD D, (HL)                  ; DE = ptr al sprite data
1020+ D4FE 23               INC HL
1021+ D4FF 7E               LD A, (HL)                  ; A = bank
1022+ D500 32 9F D4         LD (CurrentBgSpriteBank), A
1023+ D503 E1               POP HL
1024+ D504
1025+ D504 46               LD B, (HL)                  ; B = x_char
1026+ D505 23               INC HL
1027+ D506 4E               LD C, (HL)                  ; C = y_char
1028+ D507 23               INC HL
1029+ D508 7E               LD A, (HL)                  ; A = tint variant
1030+ D509 23               INC HL
1031+ D50A 32 9D D4         LD (CurrentTintVar), A
1032+ D50D E5               PUSH HL
1033+ D50E
1034+ D50E 3A A0 D4         LD A, (CurrentBgSpriteId)
1035+ D511 CD 38 E6         CALL CheckIfHouseSprite
1036+ D514
1037+ D514                  ; Cargar sprite al buffer (bank variable → BgSpriteBuffer) antes de leer attrs
1038+ D514 EB               EX DE, HL                   ; HL = BgGfx ptr
1039+ D515 3A 9F D4         LD A, (CurrentBgSpriteBank)
1040+ D518 CD 74 6A         CALL LoadBgSpriteToBuffer
1041+ D51B DD 21 87 89      LD IX, BgSpriteBuffer
1042+ D51F CD 2F D6         CALL RemapBgAttrsOnly
1043+ D522
1044+ D522 E1               POP HL
1045+ D523 18 B8            JR .rsLoop
1046+ D525
1047+ D525              .rsDone:
1048+ D525 CD 9B ED         CALL DrawClockSprite
1049+ D528 CD EF E7         CALL DrawTimeIndicator
1050+ D52B                  ; Snapshot de atributos limpios tras remap
1051+ D52B CD 39 D5         CALL SaveCleanAttrs
1052+ D52E                  ; Tumbas: si habia entities encima durante el remap, sus attrs entraron
1053+ D52E                  ; en ATTR_BASE y CleanAttrMap. Re-pintar cyan deja la tumba consistente.
1054+ D52E CD 59 6C         CALL RefreshTombAttrsForRoom
1055+ D531                  ; Cambio de fase day/night: RemapScreenAttrs solo toca BG sprites
1056+ D531                  ; (loop por CurrentScreenAddr). Los pickups (PickupTable, render aparte)
1057+ D531                  ; no se remapean aqui, asi que marcamos PickupAttrsDirty=1 para que
1058+ D531                  ; RefreshPickupAttrs los repinte con el nuevo remap en este mismo frame.
1059+ D531 3E 01            LD A, 1
1060+ D533 32 A5 82         LD (PickupAttrsDirty), A
1061+ D536                  ; Si el cooldown sigue activo (p.ej. cambio de fase día/noche durante
1062+ D536                  ; cooldown), re-aplicar blanco sobre el cian recien pintado.
1063+ D536 C3 4D AE         JP ApplyWellCooldownIfActive
