 232+ 9F0A                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 233+ 9F0A 3E 0C            LD A, SPAWN_INTERVAL
 234+ 9F0C 32 FD 82         LD (SpawnTimer), A
 235+ 9F0F AF               XOR A
 236+ 9F10 32 0A 83         LD (EnemyStepIdx), A
 237+ 9F13 32 7B 5F         LD (PendingEraseCount), A
