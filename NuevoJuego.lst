 361  CF9C                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CF9C              ; ==============================================================================
   2+ CF9C              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CF9C              ; ==============================================================================
   4+ CF9C              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CF9C              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CF9C              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CF9C              ; ==============================================================================
   8+ CF9C
   9+ CF9C              ; ==============================================================================
  10+ CF9C              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CF9C              ; ==============================================================================
  12+ CF9C              InitScreenSystem:
  13+ CF9C 3E 08            LD A, START_SCREEN_X
  14+ CF9E 32 AD 82         LD (CurrentScreenX), A
  15+ CFA1 3E 09            LD A, START_SCREEN_Y
  16+ CFA3 32 AE 82         LD (CurrentScreenY), A
  17+ CFA6 3E 01            LD A, 1
  18+ CFA8 32 B5 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CFAB AF               XOR A
  20+ CFAC 32 B1 82         LD (ScreenTransition), A
  21+ CFAF CD B3 CF         CALL CalcScreenAddress
  22+ CFB2 C9               RET
  23+ CFB3
  24+ CFB3              ; ==============================================================================
  25+ CFB3              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CFB3              ; ==============================================================================
  27+ CFB3              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CFB3              ; ==============================================================================
  29+ CFB3              CalcScreenAddress:
  30+ CFB3 3A AE 82         LD A, (CurrentScreenY)
  31+ CFB6 6F               LD L, A
  32+ CFB7 26 00            LD H, 0
  33+ CFB9 29               ADD HL, HL                  ; x2
  34+ CFBA 29               ADD HL, HL                  ; x4
  35+ CFBB 29               ADD HL, HL                  ; x8
  36+ CFBC 29               ADD HL, HL                  ; x16
  37+ CFBD 3A AD 82         LD A, (CurrentScreenX)
  38+ CFC0 5F               LD E, A
  39+ CFC1 16 00            LD D, 0
  40+ CFC3 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CFC4 11 27 E0         LD DE, MapTable
  42+ CFC7 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CFC8 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CFC9                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CFC9 6F               LD L, A
  46+ CFCA 26 00            LD H, 0
  47+ CFCC 29               ADD HL, HL                  ; index * 2
  48+ CFCD 11 F5 DE         LD DE, RoomTable
  49+ CFD0 19               ADD HL, DE
  50+ CFD1 5E               LD E, (HL)
  51+ CFD2 23               INC HL
  52+ CFD3 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CFD4                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CFD4 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CFD5 CD 30 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CFD8                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CFD8 11 9A 85         LD DE, CurrentScreenBuffer
  58+ CFDB ED 53 AF 82      LD (CurrentScreenAddr), DE
  59+ CFDF C9               RET
  60+ CFE0
  61+ CFE0              ; ==============================================================================
  62+ CFE0              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CFE0              ; ==============================================================================
  64+ CFE0              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CFE0              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CFE0              ; por estar atrapado cerca del borde.
  67+ CFE0              ; ==============================================================================
  68+ CFE0              CheckScreenTransition:
  69+ CFE0 AF               XOR A
  70+ CFE1 32 B1 82         LD (ScreenTransition), A
  71+ CFE4
  72+ CFE4                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CFE4                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CFE4                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CFE4                  ; dispararia transicion sur en plena animacion.
  76+ CFE4 3A 74 82         LD A, (TownGatePhase)
  77+ CFE7 B7               OR A
  78+ CFE8 C0               RET NZ
  79+ CFE9
  80+ CFE9                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CFE9                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CFE9                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CFE9                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CFE9                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CFE9                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CFE9 3A 63 82         LD A, (TimeFrozen)
  87+ CFEC B7               OR A
  88+ CFED 28 23            JR Z, .cstNotFrozen
  89+ CFEF 3A 5B 82         LD A, (InputDirection)
  90+ CFF2 CB 4F            BIT 1, A                    ; S
  91+ CFF4 28 17            JR Z, .cstClearBlockFlag
  92+ CFF6 3A 4F 81         LD A, (EntityTable + ENT_POSY)
  93+ CFF9 FE A8            CP SCREEN_MAX_Y
  94+ CFFB 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CFFD                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CFFD 3A 64 82         LD A, (BlockedExitSoundFlag)
  97+ D000 B7               OR A
  98+ D001 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ D002 3E 01            LD A, 1
 100+ D004 32 64 82         LD (BlockedExitSoundFlag), A
 101+ D007 21 16 FA         LD HL, SFX_BlockedExit
 102+ D00A C3 F2 F8         JP PlaySFX                  ; tail call
 103+ D00D              .cstClearBlockFlag:
 104+ D00D AF               XOR A
 105+ D00E 32 64 82         LD (BlockedExitSoundFlag), A
 106+ D011 C9               RET
 107+ D012              .cstNotFrozen:
 108+ D012                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ D012 AF               XOR A
 110+ D013 32 64 82         LD (BlockedExitSoundFlag), A
