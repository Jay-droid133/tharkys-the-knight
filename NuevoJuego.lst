 385+ E696 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 386+ E699 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 387+ E69C DD 21 79 E2      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 388+ E6A0 FD 21 EA E2      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 389+ E6A4 CD 1B E7         CALL .drawBar
 390+ E6A7
 391+ E6A7                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 392+ E6A7 3A 9A B5         LD A, (PlayerStamina)
 393+ E6AA 4F               LD C, A
 394+ E6AB 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 395+ E6AE 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 396+ E6B1 DD 21 7D E2      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 397+ E6B5 FD 21 EE E2      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 398+ E6B9 CD 1B E7         CALL .drawBar
