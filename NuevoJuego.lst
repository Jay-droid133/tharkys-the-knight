 373+ ED29 23             INC HL  ; esfera
 374+ ED2A DD 7E 0A         LD A, (IX+10)
 374+ ED2D CD 05 E5       CALL ApplyDayCycleRemap
 374+ ED30 77             LD (HL), A
 374+ ED31 23             INC HL
 375+ ED32 DD 7E 0B         LD A, (IX+11)
 375+ ED35 CD 05 E5       CALL ApplyDayCycleRemap
 375+ ED38 77             LD (HL), A
 376+ ED39 C9               RET
 377+ ED3A
 378+ ED3A              ; ==============================================================================
 379+ ED3A              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ ED3A              ; ==============================================================================
 381+ ED3A              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ ED3A              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ ED3A              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ ED3A              ; ==============================================================================
 385+ ED3A              DrawHealthStaminaHUD:
 386+ ED3A                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ ED3A 3A 86 B3         LD A, (PlayerHealth)
 388+ ED3D 4F               LD C, A                             ; C = nivel (0-16)
 389+ ED3E 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ ED41 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ ED44 DD 21 20 E9      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ ED48 FD 21 91 E9      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ ED4C CD B2 ED         CALL .drawBar
 394+ ED4F
 395+ ED4F                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ ED4F 3A 87 B3         LD A, (PlayerStamina)
 397+ ED52 4F               LD C, A
 398+ ED53 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ ED56 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ ED59 DD 21 24 E9      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ ED5D FD 21 95 E9      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ ED61 CD B2 ED         CALL .drawBar
 403+ ED64
 404+ ED64                  ; --- Flash de recuperacion del pozo ---
 405+ ED64 3A 5F 8D         LD A, (WellFlashTimer)
 406+ ED67 B7               OR A
 407+ ED68 28 23            JR Z, .noFlash
 408+ ED6A 3D               DEC A
 409+ ED6B 32 5F 8D         LD (WellFlashTimer), A
 410+ ED6E                  ; Flash: alternar blanco/normal cada 4 frames
 411+ ED6E E6 04            AND $04
 412+ ED70 28 1B            JR Z, .noFlash
 413+ ED72                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ ED72                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ ED72 3E 47            LD A, WHITE | $40
 416+ ED74 32 0D 58         LD ($580D), A
 417+ ED77 32 0E 58         LD ($580E), A
 418+ ED7A 32 2D 58         LD ($582D), A
 419+ ED7D 32 2E 58         LD ($582E), A
 420+ ED80 32 11 58         LD ($5811), A
 421+ ED83 32 12 58         LD ($5812), A
 422+ ED86 32 31 58         LD ($5831), A
 423+ ED89 32 32 58         LD ($5832), A
 424+ ED8C C9               RET
 425+ ED8D              .noFlash:
 426+ ED8D                  ; --- Attrs segun nivel (normal) ---
 427+ ED8D                  ; Salud
 428+ ED8D 3A 86 B3         LD A, (PlayerHealth)
 429+ ED90 CD 00 EE         CALL .levelToColor
 430+ ED93 32 0D 58         LD ($580D), A
 431+ ED96 32 0E 58         LD ($580E), A
 432+ ED99 32 2D 58         LD ($582D), A
 433+ ED9C 32 2E 58         LD ($582E), A
 434+ ED9F                  ; Stamina
 435+ ED9F 3A 87 B3         LD A, (PlayerStamina)
 436+ EDA2 CD 00 EE         CALL .levelToColor
 437+ EDA5 32 11 58         LD ($5811), A
 438+ EDA8 32 12 58         LD ($5812), A
 439+ EDAB 32 31 58         LD ($5831), A
 440+ EDAE 32 32 58         LD ($5832), A
 441+ EDB1 C9               RET
 442+ EDB2
 443+ EDB2              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EDB2              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EDB2              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EDB2              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EDB2              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EDB2              .drawBar:
 449+ EDB2 7D               LD A, L
 450+ EDB3 32 FE ED         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EDB6 7B               LD A, E
 452+ EDB7 32 FF ED         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EDBA 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EDBC 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EDBE                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EDBE 3E 10            LD A, 16
 457+ EDC0 91               SUB C
 458+ EDC1 5F               LD E, A                             ; E = primera scanline llena
 459+ EDC2              .dbLoop:
 460+ EDC2                  ; Calcular direccion VRAM
 461+ EDC2 7A               LD A, D
 462+ EDC3 FE 08            CP 8
 463+ EDC5 30 09            JR NC, .dbCalcR1
 464+ EDC7                  ; Char row 0
 465+ EDC7 67               LD H, A
 466+ EDC8 CB F4            SET 6, H
 467+ EDCA 3A FE ED         LD A, (.dbCol)
 468+ EDCD 6F               LD L, A
 469+ EDCE 18 09            JR .dbWrite
 470+ EDD0              .dbCalcR1:
 471+ EDD0                  ; Char row 1
 472+ EDD0 D6 08            SUB 8
 473+ EDD2 67               LD H, A
 474+ EDD3 CB F4            SET 6, H
 475+ EDD5 3A FF ED         LD A, (.dbCol1)
 476+ EDD8 6F               LD L, A
 477+ EDD9              .dbWrite:
 478+ EDD9                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EDD9 7A               LD A, D
 480+ EDDA BB               CP E
 481+ EDDB 30 0B            JR NC, .dbFull
 482+ EDDD                  ; Marchito: copiar sprite decayed
 483+ EDDD FD 7E 00         LD A, (IY+0)
 484+ EDE0 77               LD (HL), A
 485+ EDE1 23               INC HL
 486+ EDE2 FD 7E 01         LD A, (IY+1)
 487+ EDE5 77               LD (HL), A
 488+ EDE6 18 09            JR .dbAdvanceSpr
 489+ EDE8              .dbFull:
 490+ EDE8                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EDE8 DD 7E 00         LD A, (IX+0)
 492+ EDEB 77               LD (HL), A
 493+ EDEC 23               INC HL
 494+ EDED DD 7E 01         LD A, (IX+1)
 495+ EDF0 77               LD (HL), A
 496+ EDF1              .dbAdvanceSpr:
 497+ EDF1                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EDF1 D5               PUSH DE
 499+ EDF2 11 06 00         LD DE, 6
 500+ EDF5 DD 19            ADD IX, DE
 501+ EDF7 FD 19            ADD IY, DE
 502+ EDF9 D1               POP DE
 503+ EDFA 14               INC D
 504+ EDFB 10 C5            DJNZ .dbLoop
 505+ EDFD C9               RET
 506+ EDFE
 507+ EDFE 00           .dbCol:  DEFB 0
 508+ EDFF 00           .dbCol1: DEFB 0
 509+ EE00
 510+ EE00              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EE00              .levelToColor:
 512+ EE00 FE 0C            CP 12
 513+ EE02 30 11            JR NC, .lcGreen
 514+ EE04 FE 07            CP 7
 515+ EE06 30 0A            JR NC, .lcCyan
 516+ EE08 FE 03            CP 3
 517+ EE0A 30 03            JR NC, .lcYellow
 518+ EE0C 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EE0E C9               RET
 520+ EE0F              .lcYellow:
 521+ EE0F 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EE11 C9               RET
 523+ EE12              .lcCyan:
 524+ EE12 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EE14 C9               RET
 526+ EE15              .lcGreen:
 527+ EE15 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EE17 C9               RET
 529+ EE18
 530+ EE18              ; ==============================================================================
 531+ EE18              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EE18              ; ==============================================================================
 533+ EE18              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EE18              ; ==============================================================================
 535+ EE18              DrawHandLine:
 536+ EE18 87               ADD A, A
 537+ EE19 4F               LD C, A
 538+ EE1A 06 00            LD B, 0
 539+ EE1C 09               ADD HL, BC
 540+ EE1D 7E               LD A, (HL)
 541+ EE1E 23               INC HL
 542+ EE1F 66               LD H, (HL)
 543+ EE20 6F               LD L, A             ; HL = puntero a datos de línea
 544+ EE21
 545+ EE21              .pixLoop:
 546+ EE21 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EE22 B7               OR A
 548+ EE23 C8               RET Z
 549+ EE24 57               LD D, A
 550+ EE25 23               INC HL
 551+ EE26 7E               LD A, (HL)          ; VRAM L
 552+ EE27 23               INC HL
 553+ EE28 5F               LD E, A
 554+ EE29 7E               LD A, (HL)          ; mask
 555+ EE2A 23               INC HL
 556+ EE2B E5               PUSH HL
 557+ EE2C 2F               CPL                 ; ~mask
 558+ EE2D 62               LD H, D
 559+ EE2E 6B               LD L, E
 560+ EE2F A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EE30 77               LD (HL), A
 562+ EE31 E1               POP HL
 563+ EE32 18 ED            JR .pixLoop
 564+ EE34
 565+ EE34              ; ==============================================================================
 566+ EE34              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ EE34              ; ==============================================================================
 568+ EE34              CheckClockSpeedKeys:
 569+ EE34 3E F7            LD A, $F7
 570+ EE36 DB FE            IN A, ($FE)
 571+ EE38 2F               CPL
 572+ EE39 E6 07            AND $07
 573+ EE3B
 574+ EE3B 47               LD B, A
 575+ EE3C 3A 04 EA         LD A, (ClockDebounce)
 576+ EE3F 4F               LD C, A
 577+ EE40 78               LD A, B
 578+ EE41 32 04 EA         LD (ClockDebounce), A
 579+ EE44 78               LD A, B
 580+ EE45
 581+ EE45 79               LD A, C
 582+ EE46 2F               CPL
 583+ EE47 A0               AND B
 584+ EE48 C8               RET Z
 585+ EE49
 586+ EE49 CB 47            BIT 0, A
 587+ EE4B 28 06            JR Z, .try2
 588+ EE4D 3E 01            LD A, 1
 589+ EE4F 32 03 EA         LD (SubMinuteMax), A
 590+ EE52 C9               RET
 591+ EE53              .try2:
 592+ EE53 CB 4F            BIT 1, A
 593+ EE55 28 06            JR Z, .try3
 594+ EE57 3E 05            LD A, 5
