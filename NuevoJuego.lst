5359+ C09C              ; ==============================================================================
5360+ C09C              ; RepositionMonstersAtEntry - Al cambiar de room
5361+ C09C              ; ==============================================================================
5362+ C09C              RepositionMonstersAtEntry:
5363+ C09C 3A 16 B6         LD A, (MonstersActive)
5364+ C09F B7               OR A
5365+ C0A0 C8               RET Z
5366+ C0A1                  ; Pre-construir CollisionMap del room NEW aqui (DrawScreen lo reconstruira
5367+ C0A1                  ; de nuevo poco despues, pero necesitamos datos frescos para el collision
5368+ C0A1                  ; check de la Fase 8 .reInNewStepBack — sin esto usariamos el map del room
5369+ C0A1                  ; anterior y el migrado acabaria sobre BG sprites).
5370+ C0A1 CD 73 D0         CALL BuildCollisionMap
5371+ C0A4                  ; Memoria de ubicacion: solo reposicionar monsters cuyo RoomId == OLD
5372+ C0A4                  ; (siguen al player desde el room anterior) o RoomId == NEW (ya vivian
5373+ C0A4                  ; en este room, migrados por knockback previo). Los que vivan en otro
5374+ C0A4                  ; room quedan intactos (TYPE_NONE en su posicion clampada) y no se
5375+ C0A4                  ; activaran hasta que el player visite su room.
5376+ C0A4 CD AB 92         CALL MaiGetCurrentScreenId
5377+ C0A7 32 F1 C2         LD (.reNewId), A
5378+ C0AA CD EE 92         CALL MaiGetOldScreenId
5379+ C0AD 32 F2 C2         LD (.reOldId), A
5380+ C0B0                  ; Cache entry side del player (solo valido para monsters que vienen de OLD)
5381+ C0B0 CD 04 96         CALL MaiGetEntrySide            ; A = MAI_SIDE_N/S/W/E o $FF
5382+ C0B3 32 F3 C2         LD (.reFollowSide), A
5383+ C0B6 DD 21 EC 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5384+ C0BA 06 03            LD B, MONSTERS_TO_SPAWN
5385+ C0BC 0E 00            LD C, 0                         ; C = slot index
5386+ C0BE              .reLoop:
5387+ C0BE C5               PUSH BC
5388+ C0BF                  ; --- Pass 1 (solo TYPE_MONSTER): snapshot pre-transition para poder
5389+ C0BF                  ; restaurar si player vuelve antes de que este monster active en NEW. ---
5390+ C0BF DD 7E 01         LD A, (IX+ENT_TYPE)
5391+ C0C2 FE 02            CP TYPE_MONSTER
5392+ C0C4 20 1D            JR NZ, .reCheckRestore
5393+ C0C6                  ; Guardar LastSeenRoom = OLD, LastSeenX/Y = POSX/POSY actuales
5394+ C0C6 59               LD E, C
5395+ C0C7 16 00            LD D, 0
5396+ C0C9 21 8E 5F         LD HL, MonsterLastSeenRoom
5397+ C0CC 19               ADD HL, DE
5398+ C0CD 3A F2 C2         LD A, (.reOldId)
5399+ C0D0 77               LD (HL), A
5400+ C0D1 21 91 5F         LD HL, MonsterLastSeenX
5401+ C0D4 19               ADD HL, DE
5402+ C0D5 DD 7E 03         LD A, (IX+ENT_POSX)
5403+ C0D8 77               LD (HL), A
5404+ C0D9 21 94 5F         LD HL, MonsterLastSeenY
5405+ C0DC 19               ADD HL, DE
5406+ C0DD DD 7E 04         LD A, (IX+ENT_POSY)
5407+ C0E0 77               LD (HL), A
5408+ C0E1 18 1E            JR .reCheckReposition
5409+ C0E3              .reCheckRestore:
5410+ C0E3                  ; TYPE_NONE: check si debemos restaurar (player vuelve rapido antes de
5411+ C0E3                  ; que este slot active en el NEW previo). Condicion:
5412+ C0E3                  ;   RoomId[slot] == OLD_actual && LastSeenRoom[slot] == NEW_actual
5413+ C0E3                  ; Significa: este monster estaba tracked como siguiendo al player (RoomId
5414+ C0E3                  ; = OLD = donde el player vino), y su ultima vista visible fue en el
5415+ C0E3                  ; room al que el player vuelve.
5416+ C0E3 59               LD E, C
5417+ C0E4 16 00            LD D, 0
5418+ C0E6 21 5C 90         LD HL, MonsterRoomId
5419+ C0E9 19               ADD HL, DE
5420+ C0EA 7E               LD A, (HL)
5421+ C0EB 47               LD B, A
5422+ C0EC 3A F2 C2         LD A, (.reOldId)
5423+ C0EF B8               CP B
5424+ C0F0 20 0F            JR NZ, .reCheckReposition       ; RoomId != OLD → no follow-in-transit
5425+ C0F2 21 8E 5F         LD HL, MonsterLastSeenRoom
5426+ C0F5 19               ADD HL, DE
5427+ C0F6 7E               LD A, (HL)
5428+ C0F7 47               LD B, A
5429+ C0F8 3A F1 C2         LD A, (.reNewId)
5430+ C0FB B8               CP B
5431+ C0FC 20 03            JR NZ, .reCheckReposition       ; LastSeen != NEW
5432+ C0FE C3 EF C1         JP .reRestore                   ; ambas condiciones OK → restore
5433+ C101              .reCheckReposition:
5434+ C101                  ; Fetch MonsterRoomId[slot] para comparaciones OLD/NEW (logica original)
5435+ C101 59               LD E, C
