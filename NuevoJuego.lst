 215+ E54A              ; ==============================================================================
 216+ E54A              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 217+ E54A              ; ==============================================================================
 218+ E54A              ; Llamar cada frame desde el main loop.
 219+ E54A              ; ==============================================================================
 220+ E54A              ; AY_UpdateBellImpl: catchup wall-clock — avanza N game frames de decay donde
 221+ E54A              ; N = FramesElapsed (calculado en MainLoop top). Identico a tickear N veces
 222+ E54A              ; per-frame (preserva la fase del BellDecayTimer modulo BELL_DECAY_RATE).
 223+ E54A              AY_UpdateBellImpl:
 224+ E54A 3A 2D 9D         LD A, (FramesElapsed)
 225+ E54D B7               OR A
 226+ E54E C8               RET Z
 227+ E54F 47               LD B, A
 228+ E550              .aubLoop:
 229+ E550 C5               PUSH BC
 230+ E551 CD 58 E5         CALL .aubTickOnce
 231+ E554 C1               POP BC
 232+ E555 10 F9            DJNZ .aubLoop
 233+ E557 C9               RET
 234+ E558
 235+ E558              .aubTickOnce:
 236+ E558                  ; ¿alguno de los 3 canales aún suena?
 237+ E558 3A 9B E4         LD A, (BellVolL)
 238+ E55B 47               LD B, A
 239+ E55C 3A 9C E4         LD A, (BellVolC)
 240+ E55F B0               OR B
 241+ E560 47               LD B, A
 242+ E561 3A 9D E4         LD A, (BellVolR)
 243+ E564 B0               OR B
