 845+ F328              ; ==============================================================================
 846+ F328              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 847+ F328              ; ==============================================================================
 848+ F328              ClearCompass:
 849+ F328 26 40            LD H, $40
 850+ F32A 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 851+ F32C 06 08            LD B, 8
 852+ F32E AF               XOR A
 853+ F32F              .ccRow0:
 854+ F32F 77               LD (HL), A
 855+ F330 23               INC HL
 856+ F331 77               LD (HL), A
 857+ F332 2B               DEC HL
 858+ F333 24               INC H
 859+ F334 10 F9            DJNZ .ccRow0
 860+ F336 26 40            LD H, $40
 861+ F338 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 862+ F33A 06 08            LD B, 8
 863+ F33C AF               XOR A
 864+ F33D              .ccRow1:
 865+ F33D 77               LD (HL), A
 866+ F33E 23               INC HL
 867+ F33F 77               LD (HL), A
 868+ F340 2B               DEC HL
 869+ F341 24               INC H
 870+ F342 10 F9            DJNZ .ccRow1
 871+ F344 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 872+ F345 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 873+ F348 77               LD (HL), A
 874+ F349 23               INC HL
 875+ F34A 77               LD (HL), A
 876+ F34B 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 877+ F34E 77               LD (HL), A
 878+ F34F 23               INC HL
 879+ F350 77               LD (HL), A
 880+ F351 C9               RET
 881+ F352
 882+ F352              ; ==============================================================================
 883+ F352              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 884+ F352              ; ==============================================================================
 885+ F352              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 886+ F352              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 887+ F352              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 888+ F352              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 889+ F352              ; monstruo cae alli con la puerta abierta:
 890+ F352              ;   - Bit slot en MonsterTrappedFlags
 891+ F352              ;   - Despawn del monstruo (puff)
 892+ F352              ;   - Puerta se re-cierra (sprite + flag)
 893+ F352              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 894+ F352              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 895+ F352              ;
 896+ F352              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 897+ F352              ; auto-generadas por el level editor segun la posicion de la puerta y los
 898+ F352              ; markers AltKey1/AltKey2.
 899+ F352              ; ==============================================================================
 900+ F352
 901+ F352              ; ==============================================================================
 902+ F352              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 903+ F352              ; ==============================================================================
 904+ F352              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 905+ F352              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 906+ F352              ; Destruye: AF, BC.
 907+ F352              ; ==============================================================================
 908+ F352              CheckChurchTrap:
 909+ F352                  ; --- Solo en pantalla de la iglesia ---
 910+ F352 3A 10 83         LD A, (CurrentScreenX)
 911+ F355 FE 0F            CP CHURCH_TRAP_SCREEN_X
 912+ F357 20 5D            JR NZ, .cctNoTrap
 913+ F359 3A 11 83         LD A, (CurrentScreenY)
 914+ F35C FE 06            CP CHURCH_TRAP_SCREEN_Y
 915+ F35E 20 56            JR NZ, .cctNoTrap
 916+ F360                  ; --- Solo con la puerta abierta ---
 917+ F360 3A B9 82         LD A, (ChurchDoorOpen)
 918+ F363 B7               OR A
 919+ F364 28 50            JR Z, .cctNoTrap
 920+ F366                  ; --- Solo si el knockback es DIRECTO del player ---
 921+ F366                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 922+ F366                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 923+ F366                  ; espada y se clear cuando se hereda kb por colision.
 924+ F366 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 925+ F36A 28 4A            JR Z, .cctNoTrap
 926+ F36C                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 927+ F36C                  ; (acepta sprites de 16, 21 o 24 px de alto)
 928+ F36C DD 7E 04         LD A, (IX+ENT_POSY)
 929+ F36F CB 3F            SRL A
 930+ F371 CB 3F            SRL A
 931+ F373 CB 3F            SRL A                                   ; A = top charY del monster
 932+ F375 47               LD B, A
 933+ F376 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 934+ F378 90               SUB B                                   ; A = trap_charY - mon_charY
 935+ F379 FE 03            CP 3
 936+ F37B 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 937+ F37D                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 938+ F37D DD 7E 03         LD A, (IX+ENT_POSX)
 939+ F380 CB 3F            SRL A
 940+ F382 CB 3F            SRL A
 941+ F384 CB 3F            SRL A
 942+ F386 47               LD B, A                                 ; B = left charX del monster
 943+ F387 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 944+ F389 3C               INC A                                   ; A = LO_X + 1
 945+ F38A 90               SUB B                                   ; A = LO_X+1 - charX
 946+ F38B FE 03            CP 3
 947+ F38D 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 948+ F38F                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 949+ F38F                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 950+ F38F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 951+ F392 D6 4C            SUB SPRID_MONSTER_0
 952+ F394 CB 3F            SRL A
 953+ F396 CB 3F            SRL A
 954+ F398 CB 3F            SRL A                                   ; A = type idx 0..2
 955+ F39A 47               LD B, A
 956+ F39B                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 957+ F39B 3A C7 82         LD A, (NextChurchTrapStep)
 958+ F39E FE 03            CP 3
 959+ F3A0 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 960+ F3A2 21 B8 F3         LD HL, ChurchTrapOrderTable
 961+ F3A5 5F               LD E, A
 962+ F3A6 16 00            LD D, 0
 963+ F3A8 19               ADD HL, DE
 964+ F3A9 7E               LD A, (HL)                              ; A = type esperado
 965+ F3AA B8               CP B
 966+ F3AB 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 967+ F3AD                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 968+ F3AD CD 50 F4         CALL TriggerChurchTrap
 969+ F3B0 3E 01            LD A, 1
 970+ F3B2 C9               RET
 971+ F3B3              .cctBlockAsWall:
 972+ F3B3                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 973+ F3B3                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 974+ F3B3 3E 02            LD A, 2
 975+ F3B5 C9               RET
 976+ F3B6              .cctNoTrap:
 977+ F3B6 AF               XOR A
 978+ F3B7 C9               RET
 979+ F3B8
 980+ F3B8              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 981+ F3B8              ChurchTrapOrderTable:
 982+ F3B8 00 02 01         DEFB 0, 2, 1
 983+ F3BB
 984+ F3BB              ; ==============================================================================
 985+ F3BB              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 986+ F3BB              ; blanco brillante sobre paper negro ($47).
 987+ F3BB              ; ==============================================================================
 988+ F3BB              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 989+ F3BB              ; - No-op fuera de la sala de la iglesia.
 990+ F3BB              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 991+ F3BB              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 992+ F3BB              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 993+ F3BB              ;   aun no toca) conservan sus attrs originales del sprite.
 994+ F3BB              ; Destruye: AF, BC, DE, HL.
 995+ F3BB              ; ==============================================================================
 996+ F3BB              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 997+ F3BB              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 998+ F3BB              HighlightExpectedStatue:
 999+ F3BB 3E 47            LD A, $47
1000+ F3BD 18 00            JR PaintExpectedStatueAttr
1001+ F3BF
1002+ F3BF              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
1003+ F3BF              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
1004+ F3BF              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
1005+ F3BF              PaintExpectedStatueAttr:
1006+ F3BF 32 29 F4         LD (.hesAttr), A
1007+ F3C2                  ; --- Solo en la sala de la iglesia ---
1008+ F3C2 3A 10 83         LD A, (CurrentScreenX)
1009+ F3C5 FE 0F            CP CHURCH_TRAP_SCREEN_X
1010+ F3C7 C0               RET NZ
1011+ F3C8 3A 11 83         LD A, (CurrentScreenY)
1012+ F3CB FE 06            CP CHURCH_TRAP_SCREEN_Y
1013+ F3CD C0               RET NZ
1014+ F3CE                  ; --- Solo tras abrir la iglesia 1a vez ---
1015+ F3CE                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
1016+ F3CE                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
1017+ F3CE                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
1018+ F3CE                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
1019+ F3CE                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
1020+ F3CE 3A BA 82         LD A, (ChurchEverOpened)
1021+ F3D1 B7               OR A
1022+ F3D2 C8               RET Z
1023+ F3D3                  ; --- Solo si quedan monstruos por atrapar ---
1024+ F3D3 3A C7 82         LD A, (NextChurchTrapStep)
1025+ F3D6 FE 03            CP 3
1026+ F3D8 D0               RET NC
1027+ F3D9                  ; --- Type esperado -> statue id ---
1028+ F3D9 21 B8 F3         LD HL, ChurchTrapOrderTable
1029+ F3DC 5F               LD E, A
1030+ F3DD 16 00            LD D, 0
1031+ F3DF 19               ADD HL, DE
1032+ F3E0 7E               LD A, (HL)                              ; type idx esperado
1033+ F3E1 21 B1 64         LD HL, StatueIdTable
1034+ F3E4 5F               LD E, A
1035+ F3E5 16 00            LD D, 0
1036+ F3E7 19               ADD HL, DE
1037+ F3E8 7E               LD A, (HL)                              ; A = statue id
1038+ F3E9 B7               OR A
1039+ F3EA C8               RET Z
1040+ F3EB 32 2A F4         LD (.hesTargetId), A
1041+ F3EE                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1042+ F3EE 2A 12 83         LD HL, (CurrentScreenAddr)
1043+ F3F1              .hesLoop:
1044+ F3F1 7E               LD A, (HL)
1045+ F3F2 FE FF            CP $FF
1046+ F3F4 C8               RET Z                                   ; estatua no en esta sala
1047+ F3F5 47               LD B, A
1048+ F3F6 3A 2A F4         LD A, (.hesTargetId)
1049+ F3F9 B8               CP B
1050+ F3FA 28 06            JR Z, .hesFound
1051+ F3FC 11 04 00         LD DE, 4
1052+ F3FF 19               ADD HL, DE
1053+ F400 18 EF            JR .hesLoop
1054+ F402              .hesFound:
1055+ F402 23               INC HL
1056+ F403 7E               LD A, (HL)                              ; charX
1057+ F404 47               LD B, A
1058+ F405 23               INC HL
1059+ F406 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1060+ F407 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1061+ F409 4F               LD C, A                                 ; C = charY (post-HUD)
1062+ F40A                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1063+ F40A 26 00            LD H, 0
1064+ F40C 69               LD L, C
1065+ F40D 29               ADD HL, HL
1066+ F40E 29               ADD HL, HL
1067+ F40F 29               ADD HL, HL
1068+ F410 29               ADD HL, HL
1069+ F411 29               ADD HL, HL                              ; HL = charY * 32
1070+ F412 58               LD E, B
1071+ F413 16 00            LD D, 0
1072+ F415 19               ADD HL, DE                              ; + charX
1073+ F416 11 00 58         LD DE, $5800
1074+ F419 19               ADD HL, DE                              ; HL = attr addr top-left
1075+ F41A                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1076+ F41A                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1077+ F41A                  ; no hace falta sincronizar CleanAttrMap.
1078+ F41A 3A 29 F4         LD A, (.hesAttr)
1079+ F41D 06 03            LD B, 3                                 ; 3 filas de chars
1080+ F41F              .hesRow:
1081+ F41F 77               LD (HL), A
1082+ F420 23               INC HL
1083+ F421 77               LD (HL), A                              ; (charX+1)
1084+ F422 11 1F 00         LD DE, 31
1085+ F425 19               ADD HL, DE                              ; siguiente fila col 0
1086+ F426 10 F7            DJNZ .hesRow
1087+ F428 C9               RET
1088+ F429 00           .hesAttr:     DEFB 0
1089+ F42A 00           .hesTargetId: DEFB 0
1090+ F42B
1091+ F42B              ; ==============================================================================
1092+ F42B              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1093+ F42B              ; ==============================================================================
1094+ F42B              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1095+ F42B              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1096+ F42B              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1097+ F42B              ; + ON final settle): 8 ciclos de ON-OFF en total.
1098+ F42B              ; ==============================================================================
1099+ F42B              STATUE_BLINK_FRAMES   EQU 32
1100+ F42B
1101+ F42B              StartStatueBlink:
1102+ F42B                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1103+ F42B                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1104+ F42B                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1105+ F42B                  ; (caso A), .cbtActChurchDoor (caso B).
1106+ F42B 3E 20            LD A, STATUE_BLINK_FRAMES
1107+ F42D 32 C8 82         LD (StatueBlinkCounter), A
1108+ F430 C3 BB F3         JP HighlightExpectedStatue              ; initial ON paint
1109+ F433
1110+ F433              UpdateStatueBlink:
1111+ F433                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1112+ F433 3A C8 82         LD A, (StatueBlinkCounter)
1113+ F436 B7               OR A
1114+ F437 C8               RET Z
1115+ F438 3D               DEC A
1116+ F439 32 C8 82         LD (StatueBlinkCounter), A
1117+ F43C 20 03            JR NZ, .usbInProgress
1118+ F43E                  ; Counter recien llego a 0: settle ON
1119+ F43E C3 BB F3         JP HighlightExpectedStatue
1120+ F441              .usbInProgress:
1121+ F441                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1122+ F441                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1123+ F441 CB 3F            SRL A
1124+ F443 E6 01            AND $01
1125+ F445 28 05            JR Z, .usbOff
1126+ F447 3E 47            LD A, $47
1127+ F449 C3 BF F3         JP PaintExpectedStatueAttr
1128+ F44C              .usbOff:
1129+ F44C AF               XOR A
1130+ F44D C3 BF F3         JP PaintExpectedStatueAttr
1131+ F450
1132+ F450              ; ==============================================================================
1133+ F450              ; CUTSCENE - parametros ajustables
1134+ F450              ; ==============================================================================
1135+ F450              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1136+ F450              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1137+ F450              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1138+ F450              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1139+ F450
1140+ F450              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1141+ F450              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1142+ F450              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1143+ F450
1144+ F450              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1145+ F450              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1146+ F450              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1147+ F450              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1148+ F450              ;   tick 12 -> erase smoke[2], pasar a DONE
1149+ F450              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1150+ F450              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1151+ F450
1152+ F450              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1153+ F450              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1154+ F450              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1155+ F450              ; centrado dentro del vano de la puerta.
1156+ F450              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1157+ F450              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1158+ F450              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1159+ F450              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1160+ F450
1161+ F450              ; ==============================================================================
1162+ F450              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1163+ F450              ; ==============================================================================
1164+ F450              ; IN: IX = monster atrapado.
1165+ F450              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1166+ F450              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1167+ F450              ; en ApplyChurchTrapEffects al final del cutscene.
1168+ F450              ; ==============================================================================
1169+ F450              TriggerChurchTrap:
1170+ F450                  ; --- 1. Calcular slot 0..2 ---
1171+ F450 DD E5            PUSH IX
1172+ F452 E1               POP HL
1173+ F453 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1174+ F456 B7               OR A
1175+ F457 ED 52            SBC HL, DE
1176+ F459 CB 3D            SRL L
1177+ F45B CB 3D            SRL L
1178+ F45D CB 3D            SRL L
1179+ F45F CB 3D            SRL L                                   ; L = slot 0..2
1180+ F461 7D               LD A, L
1181+ F462 32 9E 5F         LD (ChurchCutsceneSlot), A
1182+ F465                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1183+ F465 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1184+ F468 D6 4C            SUB SPRID_MONSTER_0
1185+ F46A CB 3F            SRL A
1186+ F46C CB 3F            SRL A
1187+ F46E CB 3F            SRL A                                   ; A = type idx
1188+ F470 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1189+ F473                  ; --- 2. Mover monster al centro del vano ---
1190+ F473 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1191+ F475 DD 77 03         LD (IX+ENT_POSX), A
1192+ F478 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1193+ F47A DD 77 04         LD (IX+ENT_POSY), A
1194+ F47D DD 36 06 00      LD (IX+ENT_DELTAX), 0
1195+ F481 DD 36 07 00      LD (IX+ENT_DELTAY), 0
1196+ F485 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1197+ F489                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1198+ F489                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1199+ F489                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1200+ F489                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1201+ F489                  ; temblor se vea con ink blanco brillante sobre paper negro.
1202+ F489 AF               XOR A
1203+ F48A 32 C8 82         LD (StatueBlinkCounter), A              ; parar blink
1204+ F48D DD E5            PUSH IX
1205+ F48F CD BB F3         CALL HighlightExpectedStatue            ; pintar $47
1206+ F492                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1207+ F492                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1208+ F492                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1209+ F492                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1210+ F492 CD 32 BB         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1211+ F495 3E FF            LD A, $FF
1212+ F497 CD C2 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1213+ F49A                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1214+ F49A                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1215+ F49A                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1216+ F49A 3A C7 82         LD A, (NextChurchTrapStep)
1217+ F49D FE 02            CP 2
1218+ F49F CC B4 FB         CALL Z, StopMonstersMusic
1219+ F4A2 DD E1            POP IX
1220+ F4A4                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1221+ F4A4 3E 01            LD A, 1
1222+ F4A6 32 CE 82         LD (ChurchCutscenePhase), A
1223+ F4A9 AF               XOR A
1224+ F4AA 32 9D 5F         LD (ChurchCutsceneFrame), A
1225+ F4AD 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1226+ F4AF 32 A4 5F         LD (ChurchCutsceneLookCount), A
1227+ F4B2 C9               RET
1228+ F4B3
1229+ F4B3              ; ==============================================================================
1230+ F4B3              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1231+ F4B3              ; ==============================================================================
1232+ F4B3              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1233+ F4B3              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1234+ F4B3              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1235+ F4B3              ; ==============================================================================
1236+ F4B3              UpdateChurchCutscene:
1237+ F4B3 3A CE 82         LD A, (ChurchCutscenePhase)
1238+ F4B6 B7               OR A
1239+ F4B7 C8               RET Z
1240+ F4B8 3D               DEC A
1241+ F4B9 28 12            JR Z, .ucsLookPhase
1242+ F4BB 3D               DEC A
1243+ F4BC 28 38            JR Z, .ucsShakeStatuePhase
1244+ F4BE 3D               DEC A
1245+ F4BF CA 48 F5         JP Z, .ucsSmokePhase
