 356+ F201              ; ==============================================================================
 357+ F201              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 358+ F201              ; ==============================================================================
 359+ F201              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 360+ F201              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 361+ F201              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 362+ F201              ; ==============================================================================
 363+ F201              DrawHealthStaminaHUD:
 364+ F201                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 365+ F201 3A 44 9D         LD A, (PlayerHealth)
 366+ F204 4F               LD C, A                             ; C = nivel (0-16)
 367+ F205 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 368+ F208 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 369+ F20B DD 21 FB ED      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 370+ F20F FD 21 6C EE      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 371+ F213 CD 8A F2         CALL .drawBar
 372+ F216
 373+ F216                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 374+ F216 3A 45 9D         LD A, (PlayerStamina)
 375+ F219 4F               LD C, A
 376+ F21A 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 377+ F21D 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 378+ F220 DD 21 FF ED      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 379+ F224 FD 21 70 EE      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 380+ F228 CD 8A F2         CALL .drawBar
 381+ F22B
 382+ F22B                  ; --- Flash de recuperacion del pozo ---
 383+ F22B 3A 7C 87         LD A, (WellFlashTimer)
 384+ F22E B7               OR A
 385+ F22F 28 28            JR Z, .noFlash
 386+ F231 3D               DEC A
 387+ F232 32 7C 87         LD (WellFlashTimer), A
 388+ F235                  ; Flash: alternar blanco/normal cada 4 frames
 389+ F235 E6 04            AND $04
 390+ F237 28 20            JR Z, .noFlash
 391+ F239                  ; Flash blanco brillante en ambas barras + player verde
 392+ F239 3E 47            LD A, WHITE | $40
 393+ F23B 32 0D 58         LD ($580D), A
 394+ F23E 32 0E 58         LD ($580E), A
 395+ F241 32 2D 58         LD ($582D), A
 396+ F244 32 2E 58         LD ($582E), A
 397+ F247 32 11 58         LD ($5811), A
 398+ F24A 32 12 58         LD ($5812), A
 399+ F24D 32 31 58         LD ($5831), A
 400+ F250 32 32 58         LD ($5832), A
 401+ F253 3E 44            LD A, GREEN | $40
 402+ F255 32 8A 80         LD (EntityTable + ENT_ATTR), A
 403+ F258 C9               RET
 404+ F259              .noFlash:
 405+ F259                  ; Restaurar color player si estaba en flash verde
 406+ F259 3A 8A 80         LD A, (EntityTable + ENT_ATTR)
 407+ F25C FE 44            CP GREEN | $40
 408+ F25E 20 05            JR NZ, .noFlashPlayer
 409+ F260 3E 47            LD A, WHITE | $40
 410+ F262 32 8A 80         LD (EntityTable + ENT_ATTR), A
 411+ F265              .noFlashPlayer:
 412+ F265                  ; --- Attrs segun nivel (normal) ---
 413+ F265                  ; Salud
 414+ F265 3A 44 9D         LD A, (PlayerHealth)
 415+ F268 CD D8 F2         CALL .levelToColor
 416+ F26B 32 0D 58         LD ($580D), A
 417+ F26E 32 0E 58         LD ($580E), A
 418+ F271 32 2D 58         LD ($582D), A
 419+ F274 32 2E 58         LD ($582E), A
 420+ F277                  ; Stamina
 421+ F277 3A 45 9D         LD A, (PlayerStamina)
 422+ F27A CD D8 F2         CALL .levelToColor
 423+ F27D 32 11 58         LD ($5811), A
 424+ F280 32 12 58         LD ($5812), A
 425+ F283 32 31 58         LD ($5831), A
 426+ F286 32 32 58         LD ($5832), A
 427+ F289 C9               RET
 428+ F28A
 429+ F28A              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 430+ F28A              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 431+ F28A              ; IX = puntero al primer byte de la decoracion en sprite data
 432+ F28A              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 433+ F28A              ; las (16-C) superiores con $00 (vacio/negro)
 434+ F28A              .drawBar:
 435+ F28A 7D               LD A, L
 436+ F28B 32 D6 F2         LD (.dbCol), A                      ; Guardar columna base row 0
 437+ F28E 7B               LD A, E
 438+ F28F 32 D7 F2         LD (.dbCol1), A                     ; Guardar columna base row 1
 439+ F292 06 10            LD B, 16                            ; 16 scanlines totales
 440+ F294 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 441+ F296                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 442+ F296 3E 10            LD A, 16
 443+ F298 91               SUB C
 444+ F299 5F               LD E, A                             ; E = primera scanline llena
 445+ F29A              .dbLoop:
 446+ F29A                  ; Calcular direccion VRAM
 447+ F29A 7A               LD A, D
 448+ F29B FE 08            CP 8
 449+ F29D 30 09            JR NC, .dbCalcR1
 450+ F29F                  ; Char row 0
 451+ F29F 67               LD H, A
 452+ F2A0 CB F4            SET 6, H
 453+ F2A2 3A D6 F2         LD A, (.dbCol)
 454+ F2A5 6F               LD L, A
 455+ F2A6 18 09            JR .dbWrite
 456+ F2A8              .dbCalcR1:
 457+ F2A8                  ; Char row 1
 458+ F2A8 D6 08            SUB 8
 459+ F2AA 67               LD H, A
 460+ F2AB CB F4            SET 6, H
 461+ F2AD 3A D7 F2         LD A, (.dbCol1)
 462+ F2B0 6F               LD L, A
 463+ F2B1              .dbWrite:
 464+ F2B1                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 465+ F2B1 7A               LD A, D
 466+ F2B2 BB               CP E
 467+ F2B3 30 0B            JR NC, .dbFull
 468+ F2B5                  ; Marchito: copiar sprite decayed
 469+ F2B5 FD 7E 00         LD A, (IY+0)
 470+ F2B8 77               LD (HL), A
 471+ F2B9 23               INC HL
 472+ F2BA FD 7E 01         LD A, (IY+1)
 473+ F2BD 77               LD (HL), A
 474+ F2BE 18 09            JR .dbAdvanceSpr
 475+ F2C0              .dbFull:
 476+ F2C0                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 477+ F2C0 DD 7E 00         LD A, (IX+0)
 478+ F2C3 77               LD (HL), A
 479+ F2C4 23               INC HL
 480+ F2C5 DD 7E 01         LD A, (IX+1)
 481+ F2C8 77               LD (HL), A
 482+ F2C9              .dbAdvanceSpr:
 483+ F2C9                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 484+ F2C9 D5               PUSH DE
 485+ F2CA 11 06 00         LD DE, 6
 486+ F2CD DD 19            ADD IX, DE
 487+ F2CF FD 19            ADD IY, DE
 488+ F2D1 D1               POP DE
 489+ F2D2 14               INC D
 490+ F2D3 10 C5            DJNZ .dbLoop
 491+ F2D5 C9               RET
 492+ F2D6
 493+ F2D6 00           .dbCol:  DEFB 0
 494+ F2D7 00           .dbCol1: DEFB 0
 495+ F2D8
 496+ F2D8              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 497+ F2D8              .levelToColor:
 498+ F2D8 FE 0C            CP 12
 499+ F2DA 30 11            JR NC, .lcGreen
 500+ F2DC FE 07            CP 7
 501+ F2DE 30 0A            JR NC, .lcCyan
 502+ F2E0 FE 03            CP 3
 503+ F2E2 30 03            JR NC, .lcYellow
 504+ F2E4 3E 42            LD A, RED | $40                     ; 0-2: rojo
 505+ F2E6 C9               RET
 506+ F2E7              .lcYellow:
 507+ F2E7 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 508+ F2E9 C9               RET
 509+ F2EA              .lcCyan:
 510+ F2EA 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 511+ F2EC C9               RET
 512+ F2ED              .lcGreen:
 513+ F2ED 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 514+ F2EF C9               RET
 515+ F2F0
 516+ F2F0              ; ==============================================================================
 517+ F2F0              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 518+ F2F0              ; ==============================================================================
 519+ F2F0              ; Entrada: A = posición (0-11), HL = tabla de punteros
 520+ F2F0              ; ==============================================================================
 521+ F2F0              DrawHandLine:
 522+ F2F0 87               ADD A, A
 523+ F2F1 4F               LD C, A
 524+ F2F2 06 00            LD B, 0
 525+ F2F4 09               ADD HL, BC
 526+ F2F5 7E               LD A, (HL)
 527+ F2F6 23               INC HL
 528+ F2F7 66               LD H, (HL)
 529+ F2F8 6F               LD L, A             ; HL = puntero a datos de línea
 530+ F2F9
 531+ F2F9              .pixLoop:
 532+ F2F9 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 533+ F2FA B7               OR A
 534+ F2FB C8               RET Z
 535+ F2FC 57               LD D, A
 536+ F2FD 23               INC HL
 537+ F2FE 7E               LD A, (HL)          ; VRAM L
 538+ F2FF 23               INC HL
 539+ F300 5F               LD E, A
 540+ F301 7E               LD A, (HL)          ; mask
 541+ F302 23               INC HL
 542+ F303 E5               PUSH HL
 543+ F304 2F               CPL                 ; ~mask
 544+ F305 62               LD H, D
 545+ F306 6B               LD L, E
 546+ F307 A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 547+ F308 77               LD (HL), A
 548+ F309 E1               POP HL
 549+ F30A 18 ED            JR .pixLoop
 550+ F30C
 551+ F30C              ; ==============================================================================
 552+ F30C              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 553+ F30C              ; ==============================================================================
 554+ F30C              CheckClockSpeedKeys:
 555+ F30C 3E F7            LD A, $F7
 556+ F30E DB FE            IN A, ($FE)
 557+ F310 2F               CPL
 558+ F311 E6 07            AND $07
 559+ F313
 560+ F313 47               LD B, A
 561+ F314 3A DF EE         LD A, (ClockDebounce)
 562+ F317 4F               LD C, A
 563+ F318 78               LD A, B
 564+ F319 32 DF EE         LD (ClockDebounce), A
 565+ F31C 78               LD A, B
 566+ F31D
 567+ F31D 79               LD A, C
 568+ F31E 2F               CPL
 569+ F31F A0               AND B
 570+ F320 C8               RET Z
 571+ F321
 572+ F321 CB 47            BIT 0, A
 573+ F323 28 06            JR Z, .try2
 574+ F325 3E 01            LD A, 1
 575+ F327 32 DE EE         LD (SubMinuteMax), A
 576+ F32A C9               RET
 577+ F32B              .try2:
 578+ F32B CB 4F            BIT 1, A
 579+ F32D 28 06            JR Z, .try3
 580+ F32F 3E 05            LD A, 5
 581+ F331 32 DE EE         LD (SubMinuteMax), A
 582+ F334 C9               RET
 583+ F335              .try3:
 584+ F335 3E 15            LD A, 21
 585+ F337 32 DE EE         LD (SubMinuteMax), A
 586+ F33A C9               RET
 587+ F33B
 588+ F33B              ; ==============================================================================
 589+ F33B              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 590+ F33B              ; ==============================================================================
 591+ F33B
 592+ F33B              ; ==============================================================================
 593+ F33B              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 594+ F33B              ; ==============================================================================
 595+ F33B              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 596+ F33B              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 597+ F33B              ; ==============================================================================
 598+ F33B              BuildPlazaScanAddrs:
 599+ F33B                  ; Calcular pixel coords del top-left de la esfera
 600+ F33B 3A 7F 87         LD A, (PlazaClockCharY)
 601+ F33E 07               RLCA
 602+ F33F 07               RLCA
 603+ F340 07               RLCA
 604+ F341 57               LD D, A                     ; D = pixelY = charY * 8
 605+ F342 3A 7E 87         LD A, (PlazaClockCharX)
 606+ F345 07               RLCA
 607+ F346 07               RLCA
 608+ F347 07               RLCA
 609+ F348 5F               LD E, A                     ; E = pixelX = charX * 8
 610+ F349 CD BC 8A         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 611+ F34C
 612+ F34C DD 21 80 87      LD IX, PlazaScanAddrs
 613+ F350 06 10            LD B, 16
 614+ F352              .buildLoop:
 615+ F352 DD 75 00         LD (IX+0), L
 616+ F355 DD 74 01         LD (IX+1), H
 617+ F358 DD 23            INC IX
 618+ F35A DD 23            INC IX
 619+ F35C 05               DEC B
 620+ F35D C8               RET Z
 621+ F35E CD 68 88         CALL NextPixelLine
 622+ F361 18 EF            JR .buildLoop
 623+ F363
 624+ F363              ; ==============================================================================
 625+ F363              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 626+ F363              ; ==============================================================================
 627+ F363              ; Llamar cada frame desde el main loop.
 628+ F363              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 629+ F363              ; ==============================================================================
 630+ F363              DrawPlazaClock:
 631+ F363 3A 7D 87         LD A, (PlazaClockActive)
 632+ F366 B7               OR A
 633+ F367 C8               RET Z
 634+ F368
 635+ F368                  ; --- Calcular posicion actual de las agujas ---
 636+ F368 3A DD EE         LD A, (GameHours)
 637+ F36B FE 0C            CP 12
 638+ F36D 38 02            JR C, .pCalcHourOk
 639+ F36F D6 0C            SUB 12
 640+ F371              .pCalcHourOk:
 641+ F371 57               LD D, A                     ; D = display hour (0-11)
 642+ F372 3A DC EE         LD A, (GameMinutes)
 643+ F375 1E 00            LD E, 0
 644+ F377              .pCalcDiv5:
 645+ F377 FE 05            CP 5
 646+ F379 38 05            JR C, .pCalcMinOk
 647+ F37B D6 05            SUB 5
 648+ F37D 1C               INC E
 649+ F37E 18 F7            JR .pCalcDiv5
 650+ F380              .pCalcMinOk:
 651+ F380                  ; D = hour pos (0-11), E = minute pos (0-11)
 652+ F380
 653+ F380                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 654+ F380 3A D4 F3         LD A, (PlazaLastHour)
 655+ F383 BA               CP D
 656+ F384 20 05            JR NZ, .pNeedsRedraw
 657+ F386 3A D5 F3         LD A, (PlazaLastMin)
 658+ F389 BB               CP E
 659+ F38A C8               RET Z                       ; sin cambio → no redibujar
 660+ F38B
 661+ F38B              .pNeedsRedraw:
 662+ F38B 7A               LD A, D
 663+ F38C 32 D4 F3         LD (PlazaLastHour), A
 664+ F38F 7B               LD A, E
 665+ F390 32 D5 F3         LD (PlazaLastMin), A
 666+ F393
 667+ F393                  ; --- Restaurar pixels de la esfera desde sprite data ---
 668+ F393 DD 21 B3 C5      LD IX, BgGfx_reloj_plaza + 2    ; saltar cabecera (height, width)
 669+ F397 FD 21 80 87      LD IY, PlazaScanAddrs
 670+ F39B 06 10            LD B, 16
 671+ F39D              .faceRow:
 672+ F39D FD 6E 00         LD L, (IY+0)
 673+ F3A0 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 674+ F3A3 DD 7E 00         LD A, (IX+0)
 675+ F3A6 2F               CPL                         ; des-invertir (dato CPL'd)
 676+ F3A7 77               LD (HL), A                  ; byte izquierdo
 677+ F3A8 23               INC HL
 678+ F3A9 DD 7E 01         LD A, (IX+1)
 679+ F3AC 2F               CPL
 680+ F3AD 77               LD (HL), A                  ; byte derecho
 681+ F3AE DD 23            INC IX
 682+ F3B0 DD 23            INC IX
 683+ F3B2 FD 23            INC IY
 684+ F3B4 FD 23            INC IY
 685+ F3B6 10 E5            DJNZ .faceRow
 686+ F3B8
 687+ F3B8                  ; --- Aguja de horas ---
 688+ F3B8 3A D4 F3         LD A, (PlazaLastHour)
 689+ F3BB 21 D9 EF         LD HL, HourHandPtrs
 690+ F3BE CD D6 F3         CALL DrawPlazaHandLine
 691+ F3C1
 692+ F3C1                  ; --- Aguja de minutos ---
 693+ F3C1 3A D5 F3         LD A, (PlazaLastMin)
 694+ F3C4 21 F5 EE         LD HL, MinHandPtrs
 695+ F3C7 CD D6 F3         CALL DrawPlazaHandLine
 696+ F3CA
 697+ F3CA                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 698+ F3CA 21 8E 87         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 699+ F3CD 7E               LD A, (HL)
 700+ F3CE 23               INC HL
 701+ F3CF 66               LD H, (HL)
 702+ F3D0 6F               LD L, A                     ; HL = dir VRAM scan line 7
 703+ F3D1 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 704+ F3D3 C9               RET
 705+ F3D4
 706+ F3D4              ; Variables locales reloj plaza
 707+ F3D4 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 708+ F3D5 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 709+ F3D6
 710+ F3D6              ; ==============================================================================
 711+ F3D6              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 712+ F3D6              ; ==============================================================================
 713+ F3D6              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 714+ F3D6              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 715+ F3D6              ; a posiciones relativas y las busca en PlazaScanAddrs.
 716+ F3D6              ; ==============================================================================
 717+ F3D6              DrawPlazaHandLine:
 718+ F3D6                  ; Indexar en tabla de punteros
 719+ F3D6 87               ADD A, A
 720+ F3D7 4F               LD C, A
 721+ F3D8 06 00            LD B, 0
 722+ F3DA 09               ADD HL, BC
 723+ F3DB 7E               LD A, (HL)
 724+ F3DC 23               INC HL
 725+ F3DD 66               LD H, (HL)
 726+ F3DE 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 727+ F3DF
 728+ F3DF              .pxLoop:
 729+ F3DF 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 730+ F3E0 B7               OR A
 731+ F3E1 C8               RET Z
 732+ F3E2
 733+ F3E2                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 734+ F3E2 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 735+ F3E3 23               INC HL
 736+ F3E4 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 737+ F3E5 23               INC HL
 738+ F3E6 56               LD D, (HL)                  ; D = mask
 739+ F3E7 23               INC HL
 740+ F3E8 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 741+ F3E9
 742+ F3E9                  ; --- Calcular scanLine (0-15) ---
 743+ F3E9 78               LD A, B
 744+ F3EA E6 07            AND $07                     ; scan dentro del char row (0-7)
 745+ F3EC CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 746+ F3EE 28 02            JR Z, .pxIsTop
 747+ F3F0 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 748+ F3F2              .pxIsTop:
 749+ F3F2                  ; A = scanLine (0-15)
 750+ F3F2
 751+ F3F2                  ; --- Calcular colOffset (0 o 1) ---
 752+ F3F2 5F               LD E, A                     ; E = scanLine (guardar)
 753+ F3F3 79               LD A, C
 754+ F3F4 E6 1F            AND $1F                     ; extraer columna
 755+ F3F6 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 756+ F3F8 4F               LD C, A                     ; C = colOffset
 757+ F3F9
 758+ F3F9                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 759+ F3F9 7B               LD A, E                     ; A = scanLine
 760+ F3FA 87               ADD A, A                    ; *2 (word index)
 761+ F3FB 21 80 87         LD HL, PlazaScanAddrs
 762+ F3FE 85               ADD A, L
 763+ F3FF 6F               LD L, A
 764+ F400 30 01            JR NC, .pxNC
 765+ F402 24               INC H
 766+ F403              .pxNC:
 767+ F403 7E               LD A, (HL)
 768+ F404 23               INC HL
 769+ F405 66               LD H, (HL)
 770+ F406 81               ADD A, C                    ; sumar colOffset
 771+ F407 6F               LD L, A                     ; HL = dir VRAM destino
 772+ F408
 773+ F408                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 774+ F408 7A               LD A, D
 775+ F409 2F               CPL
 776+ F40A A6               AND (HL)
 777+ F40B 77               LD (HL), A
 778+ F40C
 779+ F40C E1               POP HL                      ; restaurar puntero datos
 780+ F40D 18 D0            JR .pxLoop
 781+ F40F
