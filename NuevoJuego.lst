7474+ CC2B 19               ADD HL, DE                          ; HL = &CollisionMap[cy][cx]
7475+ CC2C 0E 03            LD C, 3                             ; filas restantes
7476+ CC2E              .cfRow:
7477+ CC2E E5               PUSH HL
7478+ CC2F 06 03            LD B, 3                             ; cols restantes
7479+ CC31              .cfCol:
