  97  69B3
  98  69B3                  ; ==========================================================================
  99  69B3                  ; ORG $8000 - codigo principal (no-contended)
 100  69B3                  ; ==========================================================================
 101  69B3                  ORG ORIGIN_ADDRESS
 102  8000
 103  8000              ; ==============================================================================
 104  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 105  8000              ; ==============================================================================
 106  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 107  8000              ;   erase viejo → AI/movimiento → draw nuevo
 108  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 109  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 110  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 111  8000              ; ==============================================================================
 112  8000              MainLoop:
 113  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 114  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 115  8003 32 C3 80         LD (.frameStart), A
 116  8006
 117  8006                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
 118  8006 CD C8 C9         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
 119  8009 CD 89 CB         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
 120  800C CD B9 CE         CALL RemapScreenAttrs       ; Remap attrs si cambio de fase (~fast)
 121  800F
 122  800F                  ; === CUTSCENE final (M9, puerta sur): si activa, saltar gameplay ===
 123  800F 3A EF 81         LD A, (TownGatePhase)
 124  8012 B7               OR A
 125  8013 C2 58 80         JP NZ, .townGateCutsceneActive
 126  8016
 127  8016                  ; === CUTSCENE de la iglesia (paso 7): si activa, saltar gameplay ===
 128  8016 3A EE 81         LD A, (ChurchCutscenePhase)
 129  8019 B7               OR A
 130  801A C2 53 80         JP NZ, .cutsceneActive
 131  801D
 132  801D                  ; === PLAYER: siempre cada frame, completo (erase+logic+draw) ===
 133  801D CD FC B8         CALL EraseDeadSprites       ; Cleanup puff terminadas (~20T normal)
 134  8020 CD 7C A1         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
 135  8023 CD C2 A2         CALL ProcessPlayer          ; Erase + logic + draw player (todo junto)
 136  8026 CD A1 AD         CALL CheckWellPickup        ; Recuperar salud/stamina si pisa un pozo
 137  8029 CD BA D1         CALL CheckPickupCollect     ; Detectar pickups (borrado diferido al siguiente frame)
 138  802C CD F9 D3         CALL CheckBumpTriggers      ; Sprites trigger por colisión (puerta iglesia/ayuntamiento)
 139  802F CD 50 60         CALL CheckTownGateTriggerBg ; Cutscene final: arco sur (BG sprite, no en PickupTable)
 140  8032
 141  8032                  ; Limpiar flag de pantalla recien dibujada (tras renderizar player)
 142  8032 AF               XOR A
 143  8033 32 12 82         LD (ScreenJustRedrawn), A
 144  8036
 145  8036                  ; Flow field BFS: DESACTIVADO por coste (~1M T-states = 7 frames stutter).
 146  8036                  ; La infraestructura vive en monster_ai.asm y bank 6 (FlowField + BfsQueue).
 147  8036                  ; Para reactivar: amortizar el BFS en K iteraciones por frame (TODO).
 148  8036                  ; CALL MaiMaybeRecomputeFlow
 149  8036
 150  8036                  ; === ENEMIGOS: round-robin, erase+logic+draw por entidad ===
 151  8036 CD F0 A3         CALL ProcessEnemies         ; Round-robin: hasta MAX_ENEMIES_PER_FRAME
 152  8039 CD DA C6         CALL ProcessDeath           ; La muerte (slot 11): erase+AI+draw fuera del round-robin
 153  803C CD 85 D5         CALL RefreshPickupAttrs     ; Re-pinta attrs de pickups tras erase de enemigos
 154  803F CD D9 D3         CALL UpdatePickupFlash      ; Parpadeo de pickups recién spawnados (church_key)
 155  8042
 156  8042                  ; === SISTEMAS GLOBALES ===
 157  8042 CD 1A BA         CALL TrySpawnNasty          ; Spawn check (tiene su propio timer)
 158  8045 CD BB BE         CALL TryRespawnMonsters     ; Rellenar slots monster vacios (siempre 3)
 159  8048 CD C4 C6         CALL UpdateDeathTimer       ; Tick contador 10s + spawn la muerte si toca
 160  804B CD 10 C3         CALL CheckPlayerEnemyCollision ; Colision player vs enemigos
 161  804E CD EB C6         CALL CheckDeathTouchPlayer  ; La muerte toca al player → drena HP + despawn
 162  8051 18 08            JR .afterGameplay
 163  8053              .cutsceneActive:
 164  8053 CD 3D ED         CALL UpdateChurchCutscene   ; Avanza phase machine de la cutscene
 165  8056 18 03            JR .afterGameplay
 166  8058              .townGateCutsceneActive:
 167  8058 CD 47 61         CALL UpdateTownGateCutscene ; Phase machine del cutscene final (M9)
 168  805B              .afterGameplay:
 169  805B CD BF E5         CALL DrawClockHUD           ; Reloj: cara + agujas (HUD fijo, no flicker)
 170  805E CD 65 D6         CALL DrawKeyHUD             ; Llave actual (slot 3×2 en cols 20-22, rows 22-23)
 171  8061 CD 61 E8         CALL DrawPlazaClock         ; Reloj de plaza (si existe en esta room)
 172  8064 CD FF E6         CALL DrawHealthStaminaHUD   ; Barras salud/stamina en decoraciones
 173  8067 CD 79 DE         CALL DrawSwordModeHUD       ; Debug: indicador modo espada
 174  806A CD AF DE         CALL DrawNoclipHUD          ; Debug: indicador NoclipMode (N)
 175  806D CD BE DF         CALL DrawDayCycleHUD        ; Indicador de dia (D1, D2, D3...)
 176  8070 CD 44 E0         CALL DrawPlayerSpeedHUD     ; Debug: velocidad player (fila 0, col 2)
 177  8073 CD 8A E0         CALL DrawEnemySpeedHUD      ; Debug: velocidad nasties (V1, V2...)
 178  8076 CD 54 E0         CALL DrawZoneCountHUD       ; Debug: ZoneCellCount en hex (cols 11-12)
 179  8079 CD 76 EA         CALL DrawCompass            ; Brujula del hito actual (cols 23-24, rows 0-1)
 180  807C                  ; === Updates + debug: pausados durante cualquier cutscene ===
 181  807C 3A EE 81         LD A, (ChurchCutscenePhase)
 182  807F B7               OR A
 183  8080 20 2A            JR NZ, .skipUpdates
 184  8082 3A EF 81         LD A, (TownGatePhase)
 185  8085 B7               OR A
 186  8086 20 24            JR NZ, .skipUpdates
 187  8088 CD 62 AE         CALL UpdateWellCooldown     ; Tick cooldown del pozo + repintar blanco si activo
 188  808B CD 60 E5         CALL UpdateGameClock        ; Avanzar reloj de juego
 189  808E CD 84 BC         CALL UpdateEnemySpeed       ; Ajustar velocidad nasties segun ciclo
 190  8091 CD 58 F2         CALL UpdateBellChimes       ; Campanadas de medianoche (si activas)
 191  8094 CD 89 F2         CALL UpdateBellsDoneTimer   ; Cadena post-campanadas: ventanas off → monster spawn
 192  8097 CD CD EC         CALL UpdateStatueBlink      ; Parpadeo ON-OFF de la estatua que se enciende
 193  809A CD 1D 9D         CALL AY_UpdateBell          ; Decay manual del volumen de la campana
 194  809D CD 3F 9D         CALL UpdateTensionMusic     ; Motivo de tension entre lights-off y monster spawn
 195  80A0 CD 98 B8         CALL UpdateScareTimer       ; Countdown pausa+huida (bells/dawn)
 196  80A3 CD F8 DD         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
 197  80A6 CD 95 E9         CALL CheckMilestoneDebugKey ; Tecla M: skip de hito (debug)
 198  80A9 CD C0 E9         CALL CheckCurrentKeyCycleKey ; Tecla K: cicla CurrentKey 0..6 (debug)
 199  80AC              .skipUpdates:
 200  80AC
 201  80AC                  ; Incrementar contador de frames
 202  80AC 3A C4 80         LD A, (GameFrameCounter)
 203  80AF 3C               INC A
 204  80B0 32 C4 80         LD (GameFrameCounter), A
 205  80B3
 206  80B3                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 207  80B3              .frameSync:
 208  80B3 76               HALT                        ; Dormir hasta siguiente interrupt
 209  80B4 3A C3 80         LD A, (.frameStart)
 210  80B7 47               LD B, A
 211  80B8 3A 78 5C         LD A, ($5C78)
 212  80BB 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 213  80BC FE 02            CP 2
 214  80BE 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
 215  80C0
 216  80C0 C3 00 80         JP MainLoop
 217  80C3 00           .frameStart: DEFB 0
