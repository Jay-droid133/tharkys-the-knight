 293+ DEE6              ; ==============================================================================
 294+ DEE6              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 295+ DEE6              ; ==============================================================================
 296+ DEE6              ; Entrada: A = attr original
 297+ DEE6              ; Salida:  A = attr transformado
 298+ DEE6              ; Preserva: HL, DE, BC, IX
 299+ DEE6              ; ==============================================================================
 300+ DEE6              ApplyDayCycleRemap:
 301+ DEE6 E5               PUSH HL
 302+ DEE7 67               LD H, A                     ; H = attr (temp save)
 303+ DEE8 3A 84 DD         LD A, (CurrentTimeOfDay)
 304+ DEEB B7               OR A
 305+ DEEC 20 03            JR NZ, .doRemap
 306+ DEEE 7C               LD A, H                     ; Dia: devolver sin cambio
 307+ DEEF E1               POP HL
 308+ DEF0 C9               RET
 309+ DEF1
 310+ DEF1              .doRemap:
 311+ DEF1 D5               PUSH DE
 312+ DEF2 C5               PUSH BC
 313+ DEF3
 314+ DEF3 7C               LD A, H                     ; A = attr original
 315+ DEF4 4F               LD C, A                     ; C = attr original
 316+ DEF5
 317+ DEF5                  ; Guardar flash + ink (bits 7, 2-0)
 318+ DEF5 E6 87            AND $87                     ; A = F000_0III
 319+ DEF7 47               LD B, A                     ; B = flash | ink
 320+ DEF8
 321+ DEF8                  ; Extraer paper+bright como indice 0-15
 322+ DEF8 79               LD A, C
 323+ DEF9 E6 78            AND $78                     ; A = 0BPPP000
 324+ DEFB 0F               RRCA
 325+ DEFC 0F               RRCA
 326+ DEFD 0F               RRCA                        ; A = 0000BPPP = indice
 327+ DEFE
 328+ DEFE                  ; Elegir tabla segun tipo de sprite
 329+ DEFE 5F               LD E, A
 330+ DEFF 16 00            LD D, 0
 331+ DF01 3A 89 DD         LD A, (BgSpriteIsHouse)
 332+ DF04 B7               OR A
 333+ DF05 28 05            JR Z, .useStdTable
 334+ DF07 2A 87 DD         LD HL, (CurrentHouseRemapTable)
 335+ DF0A 18 03            JR .doLookup
 336+ DF0C              .useStdTable:
 337+ DF0C 2A 85 DD         LD HL, (CurrentRemapTable)
 338+ DF0F              .doLookup:
 339+ DF0F 19               ADD HL, DE
 340+ DF10 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 341+ DF11
 342+ DF11                  ; Reconstruir atributo
 343+ DF11 07               RLCA
 344+ DF12 07               RLCA
 345+ DF13 07               RLCA                        ; A = 0BPPP000
 346+ DF14 B0               OR B                        ; A = FBPPPIII
 347+ DF15
 348+ DF15 C1               POP BC
 349+ DF16 D1               POP DE
 350+ DF17 E1               POP HL
 351+ DF18 C9               RET
