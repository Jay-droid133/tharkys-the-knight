 277+ 652D              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 278+ 652D              ; ==============================================================================
 279+ 652D              ; IN: A = frame idx (0..2)
 280+ 652D              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 281+ 652D              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 282+ 652D              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 283+ 652D              ; Destruye: AF, BC, DE, HL, IX.
 284+ 652D              ; ==============================================================================
 285+ 652D              DrawSmokeFrameXor:
 286+ 652D 87               ADD A, A                                ; *2 (entries de 2 bytes)
 287+ 652E 6F               LD L, A
 288+ 652F 26 00            LD H, 0
 289+ 6531 11 27 65         LD DE, SmokeFramePtrTable
 290+ 6534 19               ADD HL, DE
 291+ 6535 5E               LD E, (HL)
 292+ 6536 23               INC HL
 293+ 6537 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 294+ 6538                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 295+ 6538                  ; Source y destino accesibles sin paging (milestones bank 0,
 296+ 6538                  ; BgSpriteBuffer en RAM principal).
 297+ 6538 EB               EX DE, HL                               ; HL = source
 298+ 6539 11 FD 86         LD DE, BgSpriteBuffer
 299+ 653C 01 22 00         LD BC, 34
 300+ 653F ED B0            LDIR
 301+ 6541                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 302+ 6541 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 303+ 6544 57               LD D, A
 304+ 6545 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 305+ 6548 5F               LD E, A
 306+ 6549 C3 3F 66         JP DrawBgSprite16XorAtPixel
