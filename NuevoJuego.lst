# file closed: screen_data.asm
 379  E54D                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 380  E54D                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 381  E54D                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 382  E54D                  ; deben vivir en el mismo banco paginado.
 383  E54D                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E54D              ; ==============================================================================
   2+ E54D              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E54D              ; ==============================================================================
   4+ E54D              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E54D              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E54D              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E54D              ; ==============================================================================
   8+ E54D
   9+ E54D              ; --- Constantes ---
  10+ E54D              NUM_TIME_MOMENTS    EQU 7
  11+ E54D
  12+ E54D              ; --- Variables ---
  13+ E54D 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E54E E6 E9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E550 E6 E9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E552 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E553 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E554 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E555
  20+ E555              ; ==============================================================================
  21+ E555              ; SetTimeOfDay - Cambia el momento del dia
  22+ E555              ; ==============================================================================
  23+ E555              ; Entrada: A = momento (0-6)
  24+ E555              ; ==============================================================================
  25+ E555              SetTimeOfDay:
  26+ E555 32 4D E5         LD (CurrentTimeOfDay), A
  27+ E558
  28+ E558                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E558 FE 04            CP 4
  30+ E55A 20 06            JR NZ, .notNewCycle
  31+ E55C 21 03 C0         LD HL, DayCycleCount
  32+ E55F 34               INC (HL)
  33+ E560 18 04            JR .skipBellsReset
  34+ E562              .notNewCycle:
  35+ E562                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E562                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E562                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E562 AF               XOR A
  39+ E563 32 66 82         LD (BellsTriggered), A
  40+ E566              .skipBellsReset:
  41+ E566 3A 4D E5         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E569
  43+ E569                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E569 FE 04            CP 4
  45+ E56B 28 21            JR Z, .bellsFirst
  46+ E56D
  47+ E56D                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E56D FE 05            CP 5
  49+ E56F 20 0A            JR NZ, .noScareMon
  50+ E571 CD 1D C0         CALL ScareAllMonsters
  51+ E574                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  52+ E574                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  53+ E574                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  54+ E574                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  55+ E574 3E 01            LD A, 1                         ; track 1 = Sunrise
  56+ E576 CD 06 9D         CALL StartMusic
  57+ E579 18 07            JR .noKillMon
  58+ E57B              .noScareMon:
  59+ E57B                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  60+ E57B FE 06            CP 6
  61+ E57D 20 03            JR NZ, .noKillMon
  62+ E57F CD A6 BF         CALL KillAllActiveMonsters
  63+ E582              .noKillMon:
  64+ E582
  65+ E582                  ; Actualizar tablas de remap y tabla de nasties
  66+ E582 CD B7 E5         CALL UpdateRemapTables
  67+ E585 CD 06 C0         CALL UpdateNastyTable
  68+ E588
  69+ E588                  ; Forzar remap de atributos (sin redibujar pixeles)
  70+ E588 3E 01            LD A, 1
  71+ E58A 32 B7 82         LD (AttrsDirty), A
  72+ E58D C9               RET
  73+ E58E
  74+ E58E              .bellsFirst:
  75+ E58E                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  76+ E58E                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  77+ E58E                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  78+ E58E                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  79+ E58E                  ; que sean nocturnos (Crepuscular), no diurnos.
  80+ E58E CD 06 C0         CALL UpdateNastyTable
  81+ E591                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  82+ E591                  ; antes de medianoche natural y forzo el evento), saltamos.
  83+ E591 3A 66 82         LD A, (BellsTriggered)
  84+ E594 B7               OR A
  85+ E595 C0               RET NZ
  86+ E596 3E 01            LD A, 1
  87+ E598 32 66 82         LD (BellsTriggered), A
  88+ E59B CD B7 FA         CALL StartBellChimes
  89+ E59E C9               RET
  90+ E59F
  91+ E59F              ; ==============================================================================
  92+ E59F              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  93+ E59F              ; ==============================================================================
  94+ E59F              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  95+ E59F              ;   - Salta reloj a 00:00.
  96+ E59F              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  97+ E59F              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  98+ E59F              ;     campanadas como hace el path natural). El usuario quiere que la
  99+ E59F              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 100+ E59F              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 101+ E59F              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 102+ E59F              ;     pero ya esta en N2 -> no-op visual.
 103+ E59F              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 104+ E59F              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 105+ E59F              ;
 106+ E59F              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 107+ E59F              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 108+ E59F              ; aqui no re-dispara nada.
 109+ E59F              ; ==============================================================================
 110+ E59F              TriggerChurchMidnight:
 111+ E59F 3A 66 82         LD A, (BellsTriggered)
 112+ E5A2 B7               OR A
 113+ E5A3 C0               RET NZ                              ; bells ya sonaron -> no-op
 114+ E5A4 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 115+ E5A6 CD 96 ED         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 116+ E5A9 3E 04            LD A, 4
 117+ E5AB CD 55 E5         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 118+ E5AE                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 119+ E5AE                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 120+ E5AE                  ; diurnos durante chimes). En este path queremos lo contrario.
 121+ E5AE CD B7 E5         CALL UpdateRemapTables
 122+ E5B1 3E 01            LD A, 1
 123+ E5B3 32 B7 82         LD (AttrsDirty), A
 124+ E5B6 C9               RET
 125+ E5B7
 126+ E5B7              ; ==============================================================================
 127+ E5B7              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 128+ E5B7              ; ==============================================================================
 129+ E5B7              UpdateRemapTables:
 130+ E5B7 3A 4D E5         LD A, (CurrentTimeOfDay)
 131+ E5BA 21 BA E9         LD HL, RemapTablePtrs
 132+ E5BD 5F               LD E, A
 133+ E5BE 16 00            LD D, 0
 134+ E5C0 19               ADD HL, DE
 135+ E5C1 19               ADD HL, DE
 136+ E5C2 5E               LD E, (HL)
 137+ E5C3 23               INC HL
 138+ E5C4 56               LD D, (HL)
 139+ E5C5 ED 53 4E E5      LD (CurrentRemapTable), DE
 140+ E5C9
 141+ E5C9 3A 4D E5         LD A, (CurrentTimeOfDay)
 142+ E5CC 21 C8 E9         LD HL, RemapHouseTablePtrs
 143+ E5CF 5F               LD E, A
 144+ E5D0 16 00            LD D, 0
 145+ E5D2 19               ADD HL, DE
 146+ E5D3 19               ADD HL, DE
 147+ E5D4 5E               LD E, (HL)
 148+ E5D5 23               INC HL
 149+ E5D6 56               LD D, (HL)
 150+ E5D7 ED 53 50 E5      LD (CurrentHouseRemapTable), DE
 151+ E5DB C9               RET
 152+ E5DC
 153+ E5DC              ; ==============================================================================
 154+ E5DC              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 155+ E5DC              ; ==============================================================================
 156+ E5DC              CheckDebugKeys:
 157+ E5DC 3E FB            LD A, $FB
 158+ E5DE DB FE            IN A, ($FE)
 159+ E5E0 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 160+ E5E2 20 1C            JR NZ, .notPressed
 161+ E5E4
 162+ E5E4                  ; Tecla pulsada: comprobar debounce
 163+ E5E4 3A 54 E5         LD A, (DebugKeyDebounce)
 164+ E5E7 B7               OR A
 165+ E5E8 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 166+ E5E9
 167+ E5E9                  ; Primera pulsacion: ciclar
 168+ E5E9 3E 01            LD A, 1
 169+ E5EB 32 54 E5         LD (DebugKeyDebounce), A
 170+ E5EE
 171+ E5EE 3A 4D E5         LD A, (CurrentTimeOfDay)
 172+ E5F1 3C               INC A
 173+ E5F2 FE 07            CP NUM_TIME_MOMENTS
 174+ E5F4 38 01            JR C, .noWrap
 175+ E5F6 AF               XOR A                   ; Volver a 0 (Dia)
 176+ E5F7              .noWrap:
 177+ E5F7 F5               PUSH AF
 178+ E5F8 CD 55 E5         CALL SetTimeOfDay
 179+ E5FB F1               POP AF
 180+ E5FC CD 96 ED         CALL SetClockToPhaseHour
 181+ E5FF C9               RET
 182+ E600
 183+ E600              .notPressed:
 184+ E600 AF               XOR A
 185+ E601 32 54 E5         LD (DebugKeyDebounce), A
 186+ E604
 187+ E604                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 188+ E604 3E FD            LD A, $FD
 189+ E606 DB FE            IN A, ($FE)
 190+ E608 4F               LD C, A                 ; C = estado semi-fila $FDFE
 191+ E609 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 192+ E60B 20 13            JR NZ, .sNotPressed
 193+ E60D 3A 5B E6         LD A, (SpeedKeyDebounce)
 194+ E610 B7               OR A
 195+ E611 C0               RET NZ
 196+ E612 3E 01            LD A, 1
 197+ E614 32 5B E6         LD (SpeedKeyDebounce), A
 198+ E617 21 03 C0         LD HL, DayCycleCount
 199+ E61A 7E               LD A, (HL)
 200+ E61B FE 0A            CP 10
 201+ E61D D0               RET NC                  ; Ya en maximo
 202+ E61E 34               INC (HL)
 203+ E61F C9               RET
 204+ E620              .sNotPressed:
 205+ E620                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 206+ E620 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 207+ E622 20 13            JR NZ, .dNotPressed
 208+ E624 3A 5B E6         LD A, (SpeedKeyDebounce)
 209+ E627 B7               OR A
 210+ E628 C0               RET NZ
 211+ E629 3E 01            LD A, 1
 212+ E62B 32 5B E6         LD (SpeedKeyDebounce), A
 213+ E62E 21 03 C0         LD HL, DayCycleCount
 214+ E631 7E               LD A, (HL)
 215+ E632 FE 01            CP 1
 216+ E634 C8               RET Z                   ; Ya en minimo
 217+ E635 35               DEC (HL)
 218+ E636 C9               RET
 219+ E637              .dNotPressed:
 220+ E637 AF               XOR A
 221+ E638 32 5B E6         LD (SpeedKeyDebounce), A
 222+ E63B
 223+ E63B                  ; --- Tecla N: togglea NoclipMode (debug) ---
 224+ E63B 3E 7F            LD A, $7F
 225+ E63D DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 226+ E63F CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 227+ E641 20 13            JR NZ, .nNotPressed
 228+ E643 3A 5C E6         LD A, (NoclipKeyDebounce)
 229+ E646 B7               OR A
 230+ E647 C0               RET NZ
 231+ E648 3E 01            LD A, 1
 232+ E64A 32 5C E6         LD (NoclipKeyDebounce), A
 233+ E64D 3A 5D 82         LD A, (NoclipMode)
 234+ E650 EE 01            XOR 1
 235+ E652 32 5D 82         LD (NoclipMode), A
 236+ E655 C9               RET
 237+ E656              .nNotPressed:
 238+ E656 AF               XOR A
 239+ E657 32 5C E6         LD (NoclipKeyDebounce), A
 240+ E65A C9               RET
 241+ E65B
 242+ E65B 00           SpeedKeyDebounce: DEFB 0
 243+ E65C 00           NoclipKeyDebounce: DEFB 0
