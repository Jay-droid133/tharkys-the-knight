 538+ B16A              ; ==============================================================================
 539+ B16A              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 540+ B16A              ; ==============================================================================
 541+ B16A              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 542+ B16A              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 543+ B16A              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 544+ B16A              ; ==============================================================================
