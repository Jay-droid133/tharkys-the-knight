 165+ 8843              .shiftedLine:
 166+ 8843 E5               PUSH HL                     ; Guardar inicio de linea
 167+ 8844 3A 64 88         LD A, (.widthSave)
 168+ 8847 DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 169+ 8849
 170+ 8849              .shiftedByte:
 171+ 8849                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 172+ 8849 1A               LD A, (DE)                  ; Leer byte de sprite
 173+ 884A 4F               LD C, A                     ; C = byte value (indice en tabla)
 174+ 884B 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 175+ 884C AE               XOR (HL)                    ; XOR con VRAM
 176+ 884D 77               LD (HL), A                  ; Escribir
 177+ 884E 2C               INC L                       ; Siguiente columna VRAM
 178+ 884F 04               INC B                       ; Pagina overflow
 179+ 8850 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 180+ 8851 AE               XOR (HL)                    ; XOR con VRAM
 181+ 8852 77               LD (HL), A                  ; Escribir
 182+ 8853 05               DEC B                       ; Restaurar pagina high
 183+ 8854 13               INC DE                      ; Siguiente byte de sprite
 184+ 8855                  ; Siguiente byte de ancho
 185+ 8855 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 186+ 8857 20 F0            JR NZ, .shiftedByte         ; 12/7T
 187+ 8859
 188+ 8859 E1               POP HL                      ; Restaurar inicio de linea
 189+ 885A DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 190+ 885C C8               RET Z                       ; Terminamos todas las lineas
 191+ 885D CD 68 88         CALL NextPixelLine          ; HL = siguiente linea
 192+ 8860 18 E1            JR .shiftedLine
