2214+ AE45 7E               LD A, (HL)                          ; A = byte predador
2215+ AE46 B7               OR A
2216+ AE47 C8               RET Z                               ; PRED_NONE → no es depredador
2217+ AE48
2218+ AE48                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2219+ AE48 47               LD B, A                             ; B = byte predador completo
2220+ AE49 CB 3F            SRL A
2221+ AE4B CB 3F            SRL A                               ; A = ciclo requerido (1-3)
2222+ AE4D 4F               LD C, A
2223+ AE4E 3A 06 BD         LD A, (DayCycleCount)
2224+ AE51 B9               CP C
2225+ AE52 D8               RET C                               ; DayCycleCount < ciclo requerido → no atacar
2226+ AE53
2227+ AE53                  ; Calcular velocidad de ataque segun ciclo
2228+ AE53 3A 06 BD         LD A, (DayCycleCount)
2229+ AE56 FE 04            CP 4
