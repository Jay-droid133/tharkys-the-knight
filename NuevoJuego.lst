1177+ EFCB C6 02            ADD A, BG_Y_OFFSET
1178+ EFCD 87               ADD A, A
1179+ EFCE 87               ADD A, A
1180+ EFCF 87               ADD A, A                            ; pk_top = (charY+BG_Y_OFFSET)*8
1181+ EFD0 32 F6 EF         LD (.crsPkTop+1), A
1182+ EFD3
1183+ EFD3                  ; --- AABB: player_right > pk_left AND player_left < pk_right
1184+ EFD3                  ;          AND player_bottom > pk_top AND player_top < pk_bottom ---
1185+ EFD3 3A A6 81         LD A, (EntityTable + ENT_POSX)
1186+ EFD6 32 DA EF         LD (.crsPlX+1), A
1187+ EFD9              .crsPlX:
