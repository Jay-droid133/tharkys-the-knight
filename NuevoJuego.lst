1281+ F502              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1282+ F502              .ucsShakeStatuePhase:
1283+ F502 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1284+ F505 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1285+ F507 30 35            JR NC, .ucsShakeStatueDone
1286+ F509                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1287+ F509                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1288+ F509                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1289+ F509                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1290+ F509                  ;
1291+ F509                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1292+ F509                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1293+ F509 ED 5F            LD A, R
1294+ F50B E6 03            AND $03
1295+ F50D 21 3A F5         LD HL, .ucsShakeJitterTable
1296+ F510 5F               LD E, A
1297+ F511 16 00            LD D, 0
1298+ F513 19               ADD HL, DE
1299+ F514 7E               LD A, (HL)
1300+ F515 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1301+ F516                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1302+ F516 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1303+ F519 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
