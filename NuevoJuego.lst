  91  668D
  92  668D                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
  93  668D                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
  94  668D                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
  95  668D                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
  96  668D                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
  97  668D                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 668D              ; ==============================================================================
   2+ 668D              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 668D              ; ==============================================================================
   4+ 668D              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 668D              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 668D              ; la cinematica — invisible porque es one-shot.
   7+ 668D              ;
   8+ 668D              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 668D              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 668D              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 668D              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 668D              ; ==============================================================================
  13+ 668D
  14+ 668D              ; ==============================================================================
  15+ 668D              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 668D              ; ==============================================================================
  17+ 668D              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 668D              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 668D              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 668D              ; ChurchCutsceneSlot.
  21+ 668D              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 668D              ; ==============================================================================
  23+ 668D              EraseChurchTrappedMonster:
  24+ 668D 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 6690 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 6691 6F               LD L, A
  27+ 6692 26 00            LD H, 0
  28+ 6694 29               ADD HL, HL
  29+ 6695 29               ADD HL, HL
  30+ 6696 29               ADD HL, HL
  31+ 6697 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 6698 11 36 81         LD DE, EntityTable
  33+ 669B 19               ADD HL, DE
  34+ 669C E5               PUSH HL
  35+ 669D DD E1            POP IX
  36+ 669F CD C1 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66A2 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66A5 57               LD D, A
  39+ 66A6 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66A9 5F               LD E, A
  41+ 66AA DD 2A 49 A8      LD IX, (OldSprAddr)
  42+ 66AE C3 CE 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 66B1
  44+ 66B1              ; ==============================================================================
  45+ 66B1              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 66B1              ; ==============================================================================
  47+ 66B1              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 66B1              ; - Despawn monster (ENT_TYPE=0).
  49+ 66B1              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 66B1              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 66B1              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 66B1              ; ==============================================================================
  53+ 66B1              ApplyChurchTrapDone:
  54+ 66B1                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 66B1 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 66B4 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 66B5 6F               LD L, A
  58+ 66B6 26 00            LD H, 0
  59+ 66B8 29               ADD HL, HL
  60+ 66B9 29               ADD HL, HL
  61+ 66BA 29               ADD HL, HL
  62+ 66BB 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 66BC 11 36 81         LD DE, EntityTable
  64+ 66BF 19               ADD HL, DE
  65+ 66C0 E5               PUSH HL
  66+ 66C1 DD E1            POP IX
  67+ 66C3                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 66C3                  ; guardado en TriggerChurchTrap).
  69+ 66C3 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 66C6 21 2B 67         LD HL, ChurchTrapBitMask
  71+ 66C9 5F               LD E, A
  72+ 66CA 16 00            LD D, 0
  73+ 66CC 19               ADD HL, DE
  74+ 66CD 7E               LD A, (HL)
  75+ 66CE 21 58 82         LD HL, MonsterTrappedFlags
  76+ 66D1 B6               OR (HL)
  77+ 66D2 77               LD (HL), A
  78+ 66D3                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 66D3                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 66D3                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 66D3 21 59 82         LD HL, NextChurchTrapStep
  82+ 66D6 34               INC (HL)
  83+ 66D7                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 66D7                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 66D7                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 66D7                  ; antes de quedarse fija en blanco brillante.
  87+ 66D7 DD E5            PUSH IX
  88+ 66D9 CD EF F3         CALL StartStatueBlink
  89+ 66DC DD E1            POP IX
  90+ 66DE                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 66DE                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 66DE                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 66DE DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 66E2 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 66E6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 66EA DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 66EE                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 66EE                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 66EE                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 66EE                  ; anteriores del cutscene.)
 101+ 66EE                  ; Decidir spawn: 3 atrapados?
 102+ 66EE 3A 58 82         LD A, (MonsterTrappedFlags)
 103+ 66F1 E6 07            AND $07
 104+ 66F3 FE 07            CP $07
 105+ 66F5 28 12            JR Z, .actdAllTrapped
 106+ 66F7                  ; <3 atrapados: respawn church_key en AltN
 107+ 66F7 3E 01            LD A, 1
 108+ 66F9 32 4B 82         LD (ChurchKeySpawned), A
 109+ 66FC 21 5B 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 66FF 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6700 CD 7C 69         CALL RespawnChurchKeyAtAlt
 112+ 6703                  ; Dibujar surgical en su nueva posicion
 113+ 6703 11 AE DB         LD DE, BgGfx_church_key
 114+ 6706 C3 EE D9         JP RedrawPickupByPtr
 115+ 6709              .actdAllTrapped:
 116+ 6709                  ; Los 3 monstruos atrapados: descongelar el reloj, el ciclo dia/noche
 117+ 6709                  ; reanuda desde donde se quedo al abrir la iglesia.
 118+ 6709 AF               XOR A
 119+ 670A 32 4E 82         LD (TimeFrozen), A
 120+ 670D 3E 01            LD A, 1
 121+ 670F 32 5C 82         LD (TownGateKeySpawned), A
 122+ 6712 11 73 DB         LD DE, BgGfx_town_gate_key
 123+ 6715 CD EE D9         CALL RedrawPickupByPtr
 124+ 6718 3A 51 82         LD A, (CurrentObjective)
 125+ 671B FE 07            CP 7
