 651+ E51A              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 652+ E51A              ; ==============================================================================
 653+ E51A              DrawZoneCountHUD:
 654+ E51A 3A 00 5D         LD A, (ZoneCellCount)
 655+ E51D                  ; Hi nibble
 656+ E51D 47               LD B, A
 657+ E51E CB 3F            SRL A
 658+ E520 CB 3F            SRL A
 659+ E522 CB 3F            SRL A
 660+ E524 CB 3F            SRL A
 661+ E526 FE 0A            CP 10
 662+ E528 38 04            JR C, .dzcHiDigit
 663+ E52A C6 37            ADD A, 'A' - 10
 664+ E52C 18 02            JR .dzcHiOut
 665+ E52E              .dzcHiDigit:
 666+ E52E C6 30            ADD A, '0'
 667+ E530              .dzcHiOut:
 668+ E530 1E 0B            LD E, 11
 669+ E532 CD 6A E5         CALL DrawHudCharRow0
 670+ E535                  ; Lo nibble
 671+ E535 78               LD A, B
 672+ E536 E6 0F            AND $0F
 673+ E538 FE 0A            CP 10
 674+ E53A 38 04            JR C, .dzcLoDigit
 675+ E53C C6 37            ADD A, 'A' - 10
 676+ E53E 18 02            JR .dzcLoOut
 677+ E540              .dzcLoDigit:
 678+ E540 C6 30            ADD A, '0'
 679+ E542              .dzcLoOut:
 680+ E542 1E 0C            LD E, 12
 681+ E544 CD 6A E5         CALL DrawHudCharRow0
 682+ E547 3E 47            LD A, $47
 683+ E549 32 0B 58         LD (ATTR_BASE + 11), A
 684+ E54C 32 0C 58         LD (ATTR_BASE + 12), A
 685+ E54F C9               RET
