 755+ CD92 DD 7E 00         LD A, (IX+0)
 756+ CD95 DD 23            INC IX
 757+ CD97 CB 7F            BIT 7, A
 758+ CD99 20 18            JR NZ, .rleNewRun
 759+ CD9B                  ; --- Literal group: A = count (1-127) ---
 760+ CD9B ED 44            NEG                         ; A = -count (negativo)
 761+ CD9D 32 21 CE         LD (.rlePending), A
 762+ CDA0                  ; fall through: emitir primer byte literal
 763+ CDA0
 764+ CDA0              .rleLitEmit:
 765+ CDA0 DD 7E 00         LD A, (IX+0)
 766+ CDA3 DD 23            INC IX
 767+ CDA5 2F               CPL
 768+ CDA6 77               LD (HL), A
 769+ CDA7 23               INC HL
 770+ CDA8 3A 21 CE         LD A, (.rlePending)
 771+ CDAB 3C               INC A                       ; hacia 0
 772+ CDAC 32 21 CE         LD (.rlePending), A
 773+ CDAF 10 C6            DJNZ .rlePixCol
