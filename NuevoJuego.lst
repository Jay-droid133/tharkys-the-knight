6953+ C922 87               ADD A, A
6954+ C923 87               ADD A, A
6955+ C924 87               ADD A, A
6956+ C925 C6 10            ADD A, SCREEN_MIN_Y
6957+ C927 DD 77 04         LD (IX+ENT_POSY), A
6958+ C92A DD 77 0D         LD (IX+ENT_OLDY), A
