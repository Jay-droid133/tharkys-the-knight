 171+ 6E72 3C               INC A
 172+ 6E73 FE 09            CP ROULETTE_ORDER_LEN
 173+ 6E75 38 01            JR C, .urWrapOk
 174+ 6E77 AF               XOR A
 175+ 6E78              .urWrapOk:
 176+ 6E78 32 BD 5F         LD (RouletteIdx), A
