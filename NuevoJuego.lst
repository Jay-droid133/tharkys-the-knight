 175+ DCA9                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 176+ DCA9 CD CE 9A         CALL NextPixelLine
 177+ DCAC 22 14 DD         LD (.dpxDstBot), HL
