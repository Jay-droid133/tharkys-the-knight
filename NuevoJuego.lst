 328+ F907              ; ==============================================================================
 329+ F907              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 330+ F907              ; ==============================================================================
 331+ F907              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 332+ F907              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 333+ F907              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 334+ F907              ; resuelve KillAllActiveNasties de StartBankCutscene).
 335+ F907              ; Destruye: AF, BC, DE, HL, IX.
 336+ F907              ; ==============================================================================
 337+ F907              UpdateBankCutscene:
 338+ F907 3A C9 82         LD A, (BankCutscenePhase)
 339+ F90A FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 340+ F90C CA 55 F9         JP Z, .bcPhWaitNasties
 341+ F90F FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 342+ F911 CA DE FA         JP Z, .bcPhDoorClosed
 343+ F914 3D               DEC A
 344+ F915 CA 6F F9         JP Z, .bcPhLock
 345+ F918 3D               DEC A
 346+ F919 CA 8D F9         JP Z, .bcPhKnocks1
 347+ F91C 3D               DEC A
 348+ F91D CA A2 F9         JP Z, .bcPhWait1
 349+ F920 3D               DEC A
 350+ F921 CA C3 F9         JP Z, .bcPhKnocks2
 351+ F924 3D               DEC A
 352+ F925 CA D8 F9         JP Z, .bcPhWait2
 353+ F928 3D               DEC A
 354+ F929 CA FA F9         JP Z, .bcPhTurnToCam
 355+ F92C 3D               DEC A
 356+ F92D CA 1E FA         JP Z, .bcPhTurnToDoor
 357+ F930 3D               DEC A
 358+ F931 CA 40 FA         JP Z, .bcPhKnocks3
 359+ F934 3D               DEC A
 360+ F935 CA 55 FA         JP Z, .bcPhWait3
 361+ F938 3D               DEC A
 362+ F939 CA 67 FA         JP Z, .bcPhPreHand
 363+ F93C 3D               DEC A
 364+ F93D CA 86 FA         JP Z, .bcPhHandIn
 365+ F940 3D               DEC A
 366+ F941 CA 95 FA         JP Z, .bcPhHandNoNo
 367+ F944 3D               DEC A
 368+ F945 CA C6 FA         JP Z, .bcPhHandOut
 369+ F948 3D               DEC A
 370+ F949 CA FE FA         JP Z, .bcPhKeyDrop
 371+ F94C 3D               DEC A
 372+ F94D CA 23 FB         JP Z, .bcPhPlayerTurnCam
 373+ F950                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 374+ F950 AF               XOR A
 375+ F951 32 C9 82         LD (BankCutscenePhase), A
 376+ F954 C9               RET
