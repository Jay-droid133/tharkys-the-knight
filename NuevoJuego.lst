   1+ F40F              ; ==============================================================================
   2+ F40F              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F40F              ; ==============================================================================
   4+ F40F              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F40F              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F40F              ;
   7+ F40F              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F40F              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F40F              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F40F              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F40F              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F40F              ; ==============================================================================
  13+ F40F
  14+ F40F              ; ==============================================================================
  15+ F40F              ; PlaySFX - Reproduce un efecto de sonido
  16+ F40F              ; ==============================================================================
  17+ F40F              ; Entrada: HL = puntero a datos del efecto
  18+ F40F              ; Modifica: AF, BC, DE, HL
  19+ F40F              ; ==============================================================================
  20+ F40F              PlaySFX:
  21+ F40F F3               DI                          ; Sin interrupciones para audio limpio
  22+ F410 3A A0 87         LD A, (CurrentBorderColor)
  23+ F413 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F415 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F416
  26+ F416              .nextStep:
  27+ F416 7E               LD A, (HL)                  ; Leer duration
  28+ F417 B7               OR A
  29+ F418 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F41A
  31+ F41A 47               LD B, A                     ; B = duration (bucle externo)
  32+ F41B 23               INC HL
  33+ F41C 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F41D 23               INC HL
  35+ F41E 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F41F 23               INC HL
  37+ F420 7E               LD A, (HL)                  ; A = flags
  38+ F421 23               INC HL
  39+ F422 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F423 CB 47            BIT 0, A
  41+ F425 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F427
  43+ F427              ; --- Bucle de tono normal ---
  44+ F427              .toneLoop:
  45+ F427                  ; Semi-periodo HIGH
  46+ F427 7B               LD A, E
  47+ F428 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F42A D3 FE            OUT ($FE), A
  49+ F42C 79               LD A, C                     ; A = pitch actual
  50+ F42D              .toneDelayHi:
  51+ F42D 3D               DEC A
  52+ F42E 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F430
  54+ F430                  ; Semi-periodo LOW
  55+ F430 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F431 D3 FE            OUT ($FE), A
  57+ F433 79               LD A, C
  58+ F434              .toneDelayLo:
  59+ F434 3D               DEC A
  60+ F435 20 FD            JR NZ, .toneDelayLo
  61+ F437
  62+ F437                  ; Aplicar pitch sweep
  63+ F437 79               LD A, C
  64+ F438 82               ADD A, D                    ; pitch += pitchDelta
  65+ F439 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F43B FA 43 F4         JP M, .toneClamp            ; evitar pitch negativo
  67+ F43E 4F               LD C, A
  68+ F43F              .toneAfterClamp:
  69+ F43F 10 E6            DJNZ .toneLoop
  70+ F441 18 30            JR .stepDone
  71+ F443
  72+ F443              .toneClamp:
  73+ F443 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F445 18 F8            JR .toneAfterClamp
  75+ F447
  76+ F447              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F447              .noiseLoop:
  78+ F447                  ; Semi-periodo HIGH con ruido
  79+ F447 7B               LD A, E
  80+ F448 F6 10            OR $10
  81+ F44A D3 FE            OUT ($FE), A
  82+ F44C ED 5F            LD A, R                     ; R register como PRNG
  83+ F44E A9               XOR C                       ; mezclar con pitch base
  84+ F44F E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F451 F6 01            OR $01                      ; minimo 1
  86+ F453              .noiseDelayHi:
  87+ F453 3D               DEC A
  88+ F454 20 FD            JR NZ, .noiseDelayHi
  89+ F456
  90+ F456                  ; Semi-periodo LOW
  91+ F456 7B               LD A, E
  92+ F457 D3 FE            OUT ($FE), A
  93+ F459 ED 5F            LD A, R
  94+ F45B A9               XOR C
  95+ F45C E6 1F            AND $1F
  96+ F45E F6 01            OR $01
  97+ F460              .noiseDelayLo:
  98+ F460 3D               DEC A
  99+ F461 20 FD            JR NZ, .noiseDelayLo
 100+ F463
 101+ F463                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F463 79               LD A, C
 103+ F464 82               ADD A, D
 104+ F465 28 08            JR Z, .noiseClamp
 105+ F467 FA 6F F4         JP M, .noiseClamp
 106+ F46A 4F               LD C, A
 107+ F46B              .noiseAfterClamp:
 108+ F46B 10 DA            DJNZ .noiseLoop
 109+ F46D 18 04            JR .stepDone
 110+ F46F
 111+ F46F              .noiseClamp:
 112+ F46F 0E 01            LD C, 1
 113+ F471 18 F8            JR .noiseAfterClamp
 114+ F473
 115+ F473              .stepDone:
 116+ F473 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F474 18 A0            JR .nextStep
 118+ F476
 119+ F476              .done:
 120+ F476 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F477 D3 FE            OUT ($FE), A
 122+ F479 FB               EI
 123+ F47A C9               RET
 124+ F47B
 125+ F47B              ; ==============================================================================
 126+ F47B              ; DATOS DE EFECTOS DE SONIDO
 127+ F47B              ; ==============================================================================
 128+ F47B
 129+ F47B              ; --- SFX_Footstep: click suave de paso (~15ms) ---
 130+ F47B              ; Golpe bajo muy corto, apenas perceptible pero da ritmo al movimiento
 131+ F47B              SFX_Footstep:
 132+ F47B 08 28 03 00      DEFB 8, 40, 3, 0            ; tono bajo breve con ligero ascenso
 133+ F47F 05 14 00 01      DEFB 5, 20, 0, 1            ; mini-click de ruido
 134+ F483 00               DEFB 0                      ; fin
 135+ F484
 136+ F484              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 137+ F484              ; Dos pasos: sweep rapido de agudo a grave
 138+ F484              SFX_Attack:
 139+ F484 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 140+ F488 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 141+ F48C 00               DEFB 0                      ; fin
 142+ F48D
 143+ F48D              ; --- SFX_EnemyDeath: "explosion" con ruido (~100ms) ---
 144+ F48D              ; Ruido percusivo seguido de tono descendente
 145+ F48D              SFX_EnemyDeath:
 146+ F48D 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 147+ F491 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 148+ F495 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 149+ F499 00               DEFB 0                      ; fin
 150+ F49A
 151+ F49A              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 152+ F49A              ; Tono ascendente rapido seguido de ruido seco
 153+ F49A              SFX_PlayerHit:
 154+ F49A 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 155+ F49E 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 156+ F4A2 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 157+ F4A6 00               DEFB 0                      ; fin
 158+ F4A7
 159+ F4A7              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
 160+ F4A7              ; Tres tonos escalonados ascendentes
 161+ F4A7              SFX_ScreenTransition:
 162+ F4A7 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 163+ F4AB 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 164+ F4AF 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 165+ F4B3 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 166+ F4B7 00               DEFB 0                      ; fin
 167+ F4B8
 168+ F4B8              ; --- SFX_EnemySpawn: "pop" ascendente + crackle (~70ms) ---
 169+ F4B8              ; Tono rapido ascendente y crujido
 170+ F4B8              SFX_EnemySpawn:
 171+ F4B8 19 23 FE 00      DEFB 25, 35, -2, 0         ; tono ascendente rapido
 172+ F4BC 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 173+ F4C0 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 174+ F4C4 00               DEFB 0                      ; fin
 175+ F4C5
 176+ F4C5              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 177+ F4C5              ; Tres escalones ascendentes, tipo recarga
 178+ F4C5              SFX_WellRecover:
 179+ F4C5 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 180+ F4C9 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 181+ F4CD 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 182+ F4D1 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 183+ F4D5 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
 184+ F4D9 3C 0C FF 00      DEFB 60, 12, -1, 0         ; sweep ascendente
 185+ F4DD 28 08 00 00      DEFB 40, 8, 0, 0           ; agudo brillante sostenido
 186+ F4E1 00               DEFB 0                      ; fin
 187+ F4E2
 188+ F4E2              ; --- SFX_Pickup: "ding" ascendente corto al recoger objeto (~50ms) ---
 189+ F4E2              SFX_Pickup:
 190+ F4E2 28 32 00 00      DEFB 40, 50, 0, 0          ; tono grave largo
 191+ F4E6 28 23 00 00      DEFB 40, 35, 0, 0          ; tono medio
 192+ F4EA 28 19 00 00      DEFB 40, 25, 0, 0          ; tono medio-agudo
 193+ F4EE 28 12 00 00      DEFB 40, 18, 0, 0          ; tono agudo
 194+ F4F2 32 0C FF 00      DEFB 50, 12, -1, 0         ; sweep ascendente final
 195+ F4F6 00               DEFB 0                      ; fin
 196+ F4F7
 197+ F4F7              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 198+ F4F7              ; Tono grave resonante con decay lento, como campana de iglesia
 199+ F4F7              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 200+ F4F7              SFX_BellChime:
 201+ F4F7 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 202+ F4FB 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 203+ F4FF 00               DEFB 0                      ; fin
 204+ F500
 205+ F500              ; --- Sistema de campanadas con pausa entre ellas ---
 206+ F500 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 207+ F501 00           BellTimer:      DEFB 0          ; frames hasta la siguiente campanada
 208+ F502              BELL_PAUSE      EQU 40          ; frames de pausa entre campanadas (~0.8s a 50fps)
 209+ F502
 210+ F502              ; ==============================================================================
 211+ F502              ; StartBellChimes - Inicia secuencia de 12 campanadas
 212+ F502              ; ==============================================================================
 213+ F502              StartBellChimes:
 214+ F502 3E 0C            LD A, 12
 215+ F504 32 00 F5         LD (BellCount), A
 216+ F507 3E 01            LD A, 1                     ; sonar la primera inmediatamente
 217+ F509 32 01 F5         LD (BellTimer), A
 218+ F50C 3E FA            LD A, SCARE_TIMER_BELLS
 219+ F50E 32 9D 9F         LD (ScareTimer), A
 220+ F511 C9               RET
 221+ F512
 222+ F512              ; ==============================================================================
 223+ F512              ; UpdateBellChimes - Llamar cada frame desde el main loop
 224+ F512              ; ==============================================================================
 225+ F512              UpdateBellChimes:
 226+ F512 3A 00 F5         LD A, (BellCount)
 227+ F515 B7               OR A
 228+ F516 C8               RET Z                       ; sin campanadas pendientes
 229+ F517
 230+ F517 21 01 F5         LD HL, BellTimer
 231+ F51A 35               DEC (HL)
 232+ F51B C0               RET NZ                      ; aun no toca
 233+ F51C
 234+ F51C                  ; Sonar una campanada
 235+ F51C C5               PUSH BC
 236+ F51D D5               PUSH DE
 237+ F51E 21 F7 F4         LD HL, SFX_BellChime
 238+ F521 CD 0F F4         CALL PlaySFX
 239+ F524 D1               POP DE
 240+ F525 C1               POP BC
 241+ F526
 242+ F526                  ; Preparar siguiente
 243+ F526 21 00 F5         LD HL, BellCount
 244+ F529 35               DEC (HL)
 245+ F52A 28 06            JR Z, .bellsDone
 246+ F52C 3E 28            LD A, BELL_PAUSE
 247+ F52E 32 01 F5         LD (BellTimer), A
 248+ F531 C9               RET
 249+ F532
 250+ F532              .bellsDone:
 251+ F532                  ; Ultima campanada: actualizar tablas a N2 y aplicar remap
 252+ F532 CD 2C EA         CALL UpdateRemapTables
 253+ F535 3E 01            LD A, 1
 254+ F537 32 B5 81         LD (AttrsDirty), A
 255+ F53A C9               RET
 256+ F53B
# file closed: sound.asm
