 586+ DFEF              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 587+ DFEF              .bcPhKnocks3:
 588+ DFEF 3E 06            LD A, BCS_GROUP3_KNOCKS
 589+ DFF1 CD 5D E1         CALL BankCutsceneTickKnockGroup
 590+ DFF4 B7               OR A
 591+ DFF5 C8               RET Z
 592+ DFF6                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 593+ DFF6                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 594+ DFF6                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 595+ DFF6 CD 45 DE         CALL BankCutsceneSnapToRetreat
 596+ DFF9 3E 1E            LD A, BCS_T_PRE_HAND
 597+ DFFB 32 D2 82         LD (BankCutsceneTimer), A
 598+ DFFE 3E 09            LD A, BCP_WAIT_3
 599+ E000 32 D1 82         LD (BankCutscenePhase), A
 600+ E003 C9               RET
 601+ E004
 602+ E004              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 603+ E004              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 604+ E004              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 605+ E004              .bcPhWait3:
 606+ E004 CD 10 E2         CALL BankCutsceneDecTimer
 607+ E007 C0               RET NZ
 608+ E008 CD 2A E2         CALL SFX_Bank_OnDoorCreak
 609+ E00B 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 610+ E00D 32 D2 82         LD (BankCutsceneTimer), A
 611+ E010 3E 0A            LD A, BCP_PRE_HAND
 612+ E012 32 D1 82         LD (BankCutscenePhase), A
 613+ E015 C9               RET
 614+ E016
 615+ E016              ; ---- Phase 10: hold corto antes de la mano ----
 616+ E016              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 617+ E016              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 618+ E016              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 619+ E016              ;
 620+ E016              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 621+ E016              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 622+ E016              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 623+ E016              ; mano "no no" aparece (HAND_NO_NO).
 624+ E016              ;
 625+ E016              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 626+ E016              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 627+ E016              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 628+ E016              .bcPhPreHand:
 629+ E016 CD 10 E2         CALL BankCutsceneDecTimer
 630+ E019 C0               RET NZ
 631+ E01A AF               XOR A
 632+ E01B 32 D6 82         LD (BankCutsceneHandFrame), A           ; frame 1 (= seq[0])
 633+ E01E 32 D5 82         LD (BankCutsceneNoIdx), A               ; 0 slots completados
 634+ E021 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 635+ E024 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 636+ E027 CD 2B E2         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 637+ E02A 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 638+ E02C 32 D2 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 639+ E02F 3E 13            LD A, BCP_HAND_OPEN_IN
 640+ E031 32 D1 82         LD (BankCutscenePhase), A
 641+ E034 C9               RET
 642+ E035
 643+ E035              ; ---- Phase 19: HAND_OPEN_IN — anim scripted + hold + cobro ----
 644+ E035              ; Tabla BCS_OpenHandSeq dicta la secuencia visible (1 byte por estado:
 645+ E035              ; 0=frame 1, 1=frame 2). NoIdx = nº de slots COMPLETADOS hasta ahora; al
 646+ E035              ; entrar HAND_OPEN_IN el slot 0 (seq[0]) ya esta dibujado por PRE_HAND.
 647+ E035              ;
 648+ E035              ; Cada tick (timer=0):
 649+ E035              ;   - NoIdx >= LEN: hold expirado -> cobro
 650+ E035              ;   - NoIdx <  LEN: avanzar al siguiente slot:
 651+ E035              ;       leer seq[NoIdx], swap al frame indicado si != HandFrame
 652+ E035              ;       NoIdx++
 653+ E035              ;       si NoIdx == LEN: timer = HOLD (ultimo slot ya dibujado, hold estatico)
 654+ E035              ;       si NoIdx <  LEN: timer = SWAP
 655+ E035              ;
 656+ E035              ; Cobro: clink -> CurrentKey=0 -> erase mano -> cierra puerta -> chof
 657+ E035              ;   -> BCP_HAND_OPEN_OUT.
 658+ E035              .bcPhHandOpenIn:
 659+ E035 CD 10 E2         CALL BankCutsceneDecTimer
 660+ E038 C0               RET NZ
 661+ E039 3A D5 82         LD A, (BankCutsceneNoIdx)
 662+ E03C FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 663+ E03E 30 32            JR NC, .bcOpenInCobro                   ; anim + hold acabados -> cobro
 664+ E040                  ; Avanzar al siguiente slot. NoIdx ya esta en A.
 665+ E040 21 8D E0         LD HL, .openHandSeq
 666+ E043 5F               LD E, A
 667+ E044 16 00            LD D, 0
 668+ E046 19               ADD HL, DE
 669+ E047 7E               LD A, (HL)                              ; A = frame deseado en este slot
 670+ E048 47               LD B, A                                 ; B = frame deseado
 671+ E049 3A D6 82         LD A, (BankCutsceneHandFrame)
 672+ E04C B8               CP B
 673+ E04D 28 0C            JR Z, .bcOpenInNoSwap                   ; mismo frame, no hace falta swap
 674+ E04F                  ; OJO: BankCutsceneEraseHandOpen -> DrawHandOpen -> LDIR (con BC=34)
 675+ E04F                  ; corrompe BC. Sin PUSH/POP, B queda a 0 al volver y HandFrame siempre se
 676+ E04F                  ; setea a frame 1 -> animacion invisible (parece estatica).
 677+ E04F C5               PUSH BC                                 ; preserva frame deseado
 678+ E050 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; XOR self-cancel frame actual
 679+ E053 C1               POP BC                                  ; recupera frame deseado
 680+ E054 78               LD A, B
 681+ E055 32 D6 82         LD (BankCutsceneHandFrame), A
 682+ E058 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; draw frame nuevo
 683+ E05B              .bcOpenInNoSwap:
 684+ E05B 3A D5 82         LD A, (BankCutsceneNoIdx)
 685+ E05E 3C               INC A
 686+ E05F 32 D5 82         LD (BankCutsceneNoIdx), A
 687+ E062 FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 688+ E064 28 06            JR Z, .bcOpenInLastSlot
 689+ E066 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 690+ E068 32 D2 82         LD (BankCutsceneTimer), A
 691+ E06B C9               RET
 692+ E06C              .bcOpenInLastSlot:
 693+ E06C 3E 1E            LD A, BCS_T_OPEN_HAND_HOLD
 694+ E06E 32 D2 82         LD (BankCutsceneTimer), A
 695+ E071 C9               RET
 696+ E072              .bcOpenInCobro:
 697+ E072 CD 4B E2         CALL SFX_Bank_OnTake                    ; (1) clink (suena primero)
 698+ E075 AF               XOR A
 699+ E076 32 B6 82         LD (CurrentKey), A                      ; (2) consume cheque
 700+ E079 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; (3) mano desaparece (frame final)
 701+ E07C CD BD E1         CALL BankCutsceneCloseDoorRestoreAttrs  ; (4) puerta se cierra
 702+ E07F CD 44 E2         CALL SFX_Bank_OnDoorClose               ; (5) "chof"
 703+ E082 3E 4B            LD A, BCS_T_HAND_OPEN_OUT
 704+ E084 32 D2 82         LD (BankCutsceneTimer), A
 705+ E087 3E 15            LD A, BCP_HAND_OPEN_OUT
 706+ E089 32 D1 82         LD (BankCutscenePhase), A
 707+ E08C C9               RET
