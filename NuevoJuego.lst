1933+ A9AA              .applyAnim:
1934+ A9AA                  ; D = nuevo AnimBase, E = num frames, C = delay (fijo, 25fps constante)
1935+ A9AA                  ; ¿Cambio de animacion?
1936+ A9AA DD 7E 08         LD A, (IX+ENT_ANIMBASE)
