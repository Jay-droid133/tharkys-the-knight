 729+ E62E              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 730+ E62E              ; ==============================================================================
 731+ E62E              DrawTimeIndicator:
 732+ E62E                  ; Calcular puntero al label de 2 chars
 733+ E62E 3A D3 E2         LD A, (CurrentTimeOfDay)
 734+ E631 87               ADD A, A                    ; A = momento * 2
 735+ E632 5F               LD E, A
 736+ E633 16 00            LD D, 0
 737+ E635 21 35 E7         LD HL, TimeLabels
 738+ E638 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 739+ E639
 740+ E639                  ; Primer caracter en columna 30
 741+ E639 7E               LD A, (HL)
 742+ E63A E5               PUSH HL
 743+ E63B 1E 1E            LD E, 30
 744+ E63D CD 51 E6         CALL DrawHudChar
 745+ E640 E1               POP HL
 746+ E641
 747+ E641                  ; Segundo caracter en columna 31
 748+ E641 23               INC HL
 749+ E642 7E               LD A, (HL)
 750+ E643 1E 1F            LD E, 31
 751+ E645 CD 51 E6         CALL DrawHudChar
 752+ E648
 753+ E648                  ; Atributos del indicador (bright white on black)
 754+ E648 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 755+ E64B 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 756+ E64D 77               LD (HL), A
 757+ E64E 23               INC HL
 758+ E64F 77               LD (HL), A
 759+ E650 C9               RET
