 737+ CD77              .rlePixCol:
 738+ CD77 3A 21 CE         LD A, (.rlePending)
 739+ CD7A B7               OR A
 740+ CD7B CA 92 CD         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 741+ CD7E FA A0 CD         JP M, .rleLitEmit           ; <0 = literal group en curso
 742+ CD81                  ; >0 = run en curso, emitir valor
 743+ CD81              .rleRunEmit:
 744+ CD81 3A 22 CE         LD A, (.rleValue)
 745+ CD84 2F               CPL
 746+ CD85 77               LD (HL), A
 747+ CD86 23               INC HL
 748+ CD87 3A 21 CE         LD A, (.rlePending)
 749+ CD8A 3D               DEC A
 750+ CD8B 32 21 CE         LD (.rlePending), A
 751+ CD8E 10 E7            DJNZ .rlePixCol
 752+ CD90 18 32            JR .rleRowDone
 753+ CD92
