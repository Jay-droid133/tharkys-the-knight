 243  9D0B                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 244  9D0B                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 245  9D0B                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9D0B              ; ==============================================================================
   2+ 9D0B              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9D0B              ; ==============================================================================
   4+ 9D0B              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9D0B              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9D0B              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9D0B              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9D0B              ;
   9+ 9D0B              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9D0B              ; fallo en el intento previo):
  11+ 9D0B              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9D0B              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9D0B              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9D0B              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, TensionMusicPtr,
  15+ 9D0B              ;      TensionMusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9D0B              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9D0B              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9D0B              ;
  19+ 9D0B              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9D0B              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9D0B              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9D0B              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9D0B              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9D0B              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9D0B              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9D0B              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9D0B              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9D0B              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9D0B              ; ==============================================================================
  30+ 9D0B
  31+ 9D0B              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9D0B              AY_Init:
  33+ 9D0B F3               DI
  34+ 9D0C 3A 57 90         LD A, (CurrentPaging)
  35+ 9D0F E6 F8            AND $F8
  36+ 9D11 F6 04            OR 4
  37+ 9D13 32 57 90         LD (CurrentPaging), A
  38+ 9D16 01 FD 7F         LD BC, $7FFD
  39+ 9D19 ED 79            OUT (C), A
  40+ 9D1B CD 7E E4         CALL AY_InitImpl
  41+ 9D1E 3A 57 90         LD A, (CurrentPaging)
  42+ 9D21 E6 F8            AND $F8
  43+ 9D23 32 57 90         LD (CurrentPaging), A
  44+ 9D26 01 FD 7F         LD BC, $7FFD
  45+ 9D29 ED 79            OUT (C), A
  46+ 9D2B 3A DB 80         LD A, (StartupComplete)
  47+ 9D2E B7               OR A
  48+ 9D2F C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9D30 FB               EI
  50+ 9D31 C9               RET
  51+ 9D32
  52+ 9D32              ; --- AY_UpdateBell: cada frame ---
  53+ 9D32              AY_UpdateBell:
  54+ 9D32 F3               DI
  55+ 9D33 3A 57 90         LD A, (CurrentPaging)
