4937+ BA4B DD 77 0F         LD (IX+ENT_DRAWX), A
4938+ BA4E DD 7E 04         LD A, (IX+ENT_POSY)
4939+ BA51 DD 77 0D         LD (IX+ENT_OLDY), A
4940+ BA54 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4941+ BA57 DD 77 0E         LD (IX+ENT_OLDSPRID), A
4942+ BA5A                  ; SFX de spawn
4943+ BA5A 21 BE FA         LD HL, SFX_EnemySpawn
4944+ BA5D CD 21 FA         CALL PlaySFX
4945+ BA60 C9               RET
4946+ BA61
4947+ BA61              ; ==============================================================================
4948+ BA61              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4949+ BA61              ; ==============================================================================
4950+ BA61              UpdateEnemySpeed:
4951+ BA61 3A 63 BD         LD A, (DayCycleCount)
4952+ BA64 3D               DEC A                               ; 0-based index
4953+ BA65 FE 0A            CP 10
4954+ BA67 38 02            JR C, .uesOk
4955+ BA69 3E 09            LD A, 9                             ; Cap en indice 9
4956+ BA6B              .uesOk:
4957+ BA6B F5               PUSH AF                             ; Guardar indice para tabla de anim
4958+ BA6C 21 8F BA         LD HL, EnemySpeedTable
4959+ BA6F 5F               LD E, A
4960+ BA70 16 00            LD D, 0
4961+ BA72 19               ADD HL, DE
4962+ BA73 7E               LD A, (HL)                          ; A = velocidad × 2
4963+ BA74                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4964+ BA74 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4965+ BA76 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4966+ BA78                  ; Hay fraccion .5: alternar +1 en frames impares
4967+ BA78 47               LD B, A                             ; B = parte entera
4968+ BA79 3A A0 81         LD A, (GameFrameCounter)
4969+ BA7C E6 01            AND 1                               ; 0 en par, 1 en impar
4970+ BA7E 80               ADD A, B                            ; Sumar 0 o 1
4971+ BA7F              .uesNoFrac:
4972+ BA7F 32 5D 8D         LD (CurrentEnemySpeed), A
4973+ BA82                  ; Leer delay de animacion para este ciclo
4974+ BA82 F1               POP AF                              ; A = indice 0-based
4975+ BA83 21 99 BA         LD HL, EnemyAnimDelayTable
4976+ BA86 5F               LD E, A
4977+ BA87 16 00            LD D, 0
4978+ BA89 19               ADD HL, DE
4979+ BA8A 7E               LD A, (HL)
4980+ BA8B 32 5E 8D         LD (CurrentEnemyAnimDelay), A
4981+ BA8E C9               RET
4982+ BA8F
4983+ BA8F              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4984+ BA8F              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4985+ BA8F              EnemySpeedTable:
4986+ BA8F 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4987+ BA90 05               DEFB 5                              ; Ciclo 2: 2.5px
4988+ BA91 06               DEFB 6                              ; Ciclo 3: 3px
4989+ BA92 07               DEFB 7                              ; Ciclo 4: 3.5px
4990+ BA93 08               DEFB 8                              ; Ciclo 5: 4px
4991+ BA94 09               DEFB 9                              ; Ciclo 6: 4.5px
4992+ BA95 0A               DEFB 10                             ; Ciclo 7: 5px
4993+ BA96 0B               DEFB 11                             ; Ciclo 8: 5.5px
4994+ BA97 0C               DEFB 12                             ; Ciclo 9: 6px
4995+ BA98 0E               DEFB 14                             ; Ciclo 10: 7px
4996+ BA99
4997+ BA99              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4998+ BA99              ; La rata usara la mitad de estos valores
4999+ BA99              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
5000+ BA99 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
5001+ BA9A 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
5002+ BA9B 03               DEFB 3                              ; Ciclo 3 (era 6)
5003+ BA9C 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
5004+ BA9D 02               DEFB 2                              ; Ciclo 5 (era 4)
5005+ BA9E 02               DEFB 2                              ; Ciclo 6 (era 4)
5006+ BA9F 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
5007+ BAA0 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
5008+ BAA1 01               DEFB 1                              ; Ciclo 9 (era 2)
5009+ BAA2 01               DEFB 1                              ; Ciclo 10 (era 2)
5010+ BAA3
5011+ BAA3              ; ==============================================================================
5012+ BAA3              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
5013+ BAA3              ; ==============================================================================
5014+ BAA3              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
5015+ BAA3              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
5016+ BAA3              ; ==============================================================================
5017+ BAA3              KillAllActiveNasties:
5018+ BAA3 DD 21 13 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
5019+ BAA7 06 03            LD B, NUM_NASTIES
5020+ BAA9              .kanLoop:
5021+ BAA9 C5               PUSH BC
5022+ BAAA DD 7E 01         LD A, (IX+ENT_TYPE)
5023+ BAAD B7               OR A
5024+ BAAE 28 26            JR Z, .kanSkip                  ; slot vacio
5025+ BAB0 FE 03            CP TYPE_NASTY
5026+ BAB2 20 22            JR NZ, .kanSkip                 ; no es nasty
5027+ BAB4 DD 7E 02         LD A, (IX+ENT_STATE)
5028+ BAB7 FE 03            CP STATE_DYING
5029+ BAB9 28 1B            JR Z, .kanSkip                  ; ya muriendo
5030+ BABB                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
5031+ BABB                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
5032+ BABB                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
5033+ BABB                  ; del nasty: peDying paintea el rect del puff con ese color)
5034+ BABB CD DF BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
5035+ BABE DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5036+ BAC2 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5037+ BAC6 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5038+ BACA DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5039+ BACE DD 36 06 00      LD (IX+ENT_DELTAX), 0
5040+ BAD2 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5041+ BAD6              .kanSkip:
5042+ BAD6 11 10 00         LD DE, ENT_SIZE
5043+ BAD9 DD 19            ADD IX, DE
5044+ BADB C1               POP BC
5045+ BADC 10 CB            DJNZ .kanLoop
5046+ BADE C9               RET
5047+ BADF
5048+ BADF              ; ==============================================================================
5049+ BADF              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
5050+ BADF              ; ==============================================================================
5051+ BADF              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
5052+ BADF              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
5053+ BADF              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
5054+ BADF              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
5055+ BADF              ; deja la posicion original (puff puede asomar levemente, raro).
5056+ BADF              ; IN:  IX = nasty entity.
5057+ BADF              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
5058+ BADF              ; Destruye: AF, BC, DE, HL.
5059+ BADF              ; ==============================================================================
5060+ BADF              SnapPuffPos:
5061+ BADF DD 7E 03         LD A, (IX+ENT_POSX)
5062+ BAE2 32 55 BB         LD (.sppOrigX), A
5063+ BAE5 E6 F8            AND $F8
5064+ BAE7 32 57 BB         LD (.sppBaseX), A                   ; base char-aligned X
5065+ BAEA DD 7E 04         LD A, (IX+ENT_POSY)
5066+ BAED 32 56 BB         LD (.sppOrigY), A
5067+ BAF0 E6 F8            AND $F8
5068+ BAF2 32 58 BB         LD (.sppBaseY), A                   ; base char-aligned Y
5069+ BAF5
5070+ BAF5                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
5071+ BAF5 CD 29 BB         CALL .sppCheckFit
5072+ BAF8 C8               RET Z
5073+ BAF9
5074+ BAF9                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
5075+ BAF9                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
5076+ BAF9 21 59 BB         LD HL, .sppShifts
5077+ BAFC              .sppLoop:
5078+ BAFC 7E               LD A, (HL)
5079+ BAFD 23               INC HL
5080+ BAFE 47               LD B, A                             ; dx (signed)
5081+ BAFF 7E               LD A, (HL)
5082+ BB00 23               INC HL
5083+ BB01 FE 80            CP $80
5084+ BB03 28 17            JR Z, .sppFail                      ; sentinel
5085+ BB05 4F               LD C, A                             ; dy (signed)
5086+ BB06
5087+ BB06 3A 57 BB         LD A, (.sppBaseX)
5088+ BB09 80               ADD A, B
5089+ BB0A DD 77 03         LD (IX+ENT_POSX), A
5090+ BB0D 3A 58 BB         LD A, (.sppBaseY)
5091+ BB10 81               ADD A, C
5092+ BB11 DD 77 04         LD (IX+ENT_POSY), A
5093+ BB14
5094+ BB14 E5               PUSH HL
5095+ BB15 CD 29 BB         CALL .sppCheckFit
5096+ BB18 E1               POP HL
5097+ BB19 C8               RET Z                               ; encontrado
5098+ BB1A 18 E0            JR .sppLoop
5099+ BB1C
5100+ BB1C              .sppFail:
5101+ BB1C 3A 55 BB         LD A, (.sppOrigX)
5102+ BB1F DD 77 03         LD (IX+ENT_POSX), A
5103+ BB22 3A 56 BB         LD A, (.sppOrigY)
5104+ BB25 DD 77 04         LD (IX+ENT_POSY), A
5105+ BB28 C9               RET
5106+ BB29
5107+ BB29              ; --- .sppCheckFit ---
5108+ BB29              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5109+ BB29              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5110+ BB29              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5111+ BB29              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5112+ BB29              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5113+ BB29              .sppCheckFit:
5114+ BB29                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5115+ BB29 DD 7E 03         LD A, (IX+ENT_POSX)
5116+ BB2C FE D1            CP SCREEN_MAX_X - 23
5117+ BB2E 30 21            JR NC, .sppOutOfBounds
5118+ BB30 DD 7E 04         LD A, (IX+ENT_POSY)
5119+ BB33 FE 10            CP SCREEN_MIN_Y
5120+ BB35 38 1A            JR C, .sppOutOfBounds
5121+ BB37 FE 91            CP SCREEN_MAX_Y - 23
5122+ BB39 30 16            JR NC, .sppOutOfBounds
5123+ BB3B                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5124+ BB3B DD 7E 00         LD A, (IX+ENT_SPRITEID)
5125+ BB3E 32 54 BB         LD (.sppSpritIdSave), A
5126+ BB41 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5127+ BB45 CD 33 B7         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5128+ BB48 F5               PUSH AF
5129+ BB49 3A 54 BB         LD A, (.sppSpritIdSave)
5130+ BB4C DD 77 00         LD (IX+ENT_SPRITEID), A
5131+ BB4F F1               POP AF
5132+ BB50 C9               RET
5133+ BB51              .sppOutOfBounds:
5134+ BB51 F6 01            OR 1                                ; NZ
5135+ BB53 C9               RET
5136+ BB54
5137+ BB54 00           .sppSpritIdSave: DEFB 0
5138+ BB55
5139+ BB55 00           .sppOrigX: DEFB 0
5140+ BB56 00           .sppOrigY: DEFB 0
5141+ BB57 00           .sppBaseX: DEFB 0
5142+ BB58 00           .sppBaseY: DEFB 0
5143+ BB59              .sppShifts:
5144+ BB59                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5145+ BB59                  ; Distancia creciente. Sentinel: dy=$80.
5146+ BB59 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5147+ BB5B 00 F8            DEFB 0,   -8                        ; arriba 8
5148+ BB5D 00 08            DEFB 0,    8                        ; abajo 8
5149+ BB5F F8 00            DEFB -8,   0                        ; izq 8
5150+ BB61 08 00            DEFB 8,    0                        ; der 8
5151+ BB63 00 F0            DEFB 0,  -16                        ; arriba 16
5152+ BB65 00 10            DEFB 0,   16                        ; abajo 16
5153+ BB67 F8 F8            DEFB -8,  -8
5154+ BB69 08 F8            DEFB 8,   -8
5155+ BB6B F8 08            DEFB -8,   8
5156+ BB6D 08 08            DEFB 8,    8
5157+ BB6F 00 80            DEFB 0,  $80                        ; sentinel
5158+ BB71
5159+ BB71              ; ==============================================================================
5160+ BB71              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5161+ BB71              ; ==============================================================================
5162+ BB71              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5163+ BB71              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5164+ BB71              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5165+ BB71              ; DeathSpawned. No-op si la muerte no esta activa.
5166+ BB71              ; ==============================================================================
5167+ BB71              SilentKillDeath:
5168+ BB71 DD 21 53 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5169+ BB75 DD 7E 01         LD A, (IX+ENT_TYPE)
5170+ BB78 B7               OR A
5171+ BB79 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5172+ BB7B CD 86 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5173+ BB7E AF               XOR A
5174+ BB7F DD 77 01         LD (IX+ENT_TYPE), A
5175+ BB82 32 02 83         LD (DeathSpawned), A
5176+ BB85              .skdResetTimer:
5177+ BB85                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5178+ BB85                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5179+ BB85 21 00 00         LD HL, 0
5180+ BB88 22 FF 82         LD (DeathScreenTimer), HL
5181+ BB8B                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5182+ BB8B                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5183+ BB8B                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5184+ BB8B                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5185+ BB8B                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5186+ BB8B C9               RET
5187+ BB8C
5188+ BB8C              ; ==============================================================================
5189+ BB8C              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5190+ BB8C              ; ==============================================================================
5191+ BB8C              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5192+ BB8C              ; no DYING ni SPAWNING):
5193+ BB8C              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5194+ BB8C              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5195+ BB8C              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5196+ BB8C              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5197+ BB8C              ;     Si tampoco, deja el monster donde estaba.
5198+ BB8C              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5199+ BB8C              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5200+ BB8C              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5201+ BB8C              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5202+ BB8C              ; ==============================================================================
5203+ BB8C              FreezeMonstersFacingCorpse:
5204+ BB8C                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5205+ BB8C 3A A6 81         LD A, (EntityTable + ENT_POSX)
5206+ BB8F 32 F9 82         LD (CorpseX), A
5207+ BB92 3A A7 81         LD A, (EntityTable + ENT_POSY)
5208+ BB95 32 FA 82         LD (CorpseY), A
5209+ BB98                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5210+ BB98                  ; ya skipea; no aplica aqui pero por simetria)
5211+ BB98 3E 01            LD A, 1
5212+ BB9A 32 F8 82         LD (MonstersFrozen), A
5213+ BB9D DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5214+ BBA1 06 06            LD B, NUM_MONSTERS
5215+ BBA3              .fmcLoop:
5216+ BBA3 C5               PUSH BC
5217+ BBA4 DD 7E 01         LD A, (IX+ENT_TYPE)
5218+ BBA7 FE 02            CP TYPE_MONSTER
5219+ BBA9 20 0E            JR NZ, .fmcNext
5220+ BBAB DD 7E 02         LD A, (IX+ENT_STATE)
5221+ BBAE FE 03            CP STATE_DYING
5222+ BBB0 28 07            JR Z, .fmcNext
5223+ BBB2 FE 04            CP STATE_SPAWNING
5224+ BBB4 28 03            JR Z, .fmcNext
5225+ BBB6 CD C2 BB         CALL FreezeOneMonster
5226+ BBB9              .fmcNext:
5227+ BBB9 C1               POP BC
5228+ BBBA 11 10 00         LD DE, ENT_SIZE
5229+ BBBD DD 19            ADD IX, DE
5230+ BBBF 10 E2            DJNZ .fmcLoop
5231+ BBC1 C9               RET
5232+ BBC2
5233+ BBC2              ; --- FreezeOneMonster ---
5234+ BBC2              ; IX = monster slot pointer.
5235+ BBC2              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5236+ BBC2              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5237+ BBC2              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5238+ BBC2              FreezeOneMonster:
5239+ BBC2                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5240+ BBC2                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5241+ BBC2                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5242+ BBC2 DD 7E 03         LD A, (IX+ENT_POSX)
5243+ BBC5 47               LD B, A
5244+ BBC6 3A F9 82         LD A, (CorpseX)
5245+ BBC9 B8               CP B
5246+ BBCA 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5247+ BBCC 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5248+ BBCE              .fomFaceE:
5249+ BBCE DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5250+ BBD1 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5251+ BBD3 DD 77 00         LD (IX+ENT_SPRITEID), A
5252+ BBD6 18 08            JR .fomFaceDone
5253+ BBD8              .fomFaceW:
5254+ BBD8 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5255+ BBDB C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5256+ BBDD DD 77 00         LD (IX+ENT_SPRITEID), A
5257+ BBE0              .fomFaceDone:
5258+ BBE0
5259+ BBE0                  ; --- 2) Computar |dx| y |dy| ---
5260+ BBE0 3A F9 82         LD A, (CorpseX)
5261+ BBE3 4F               LD C, A
5262+ BBE4 DD 7E 03         LD A, (IX+ENT_POSX)
5263+ BBE7 91               SUB C                           ; A = posX - corpseX (signed)
5264+ BBE8 30 02            JR NC, .fomDxPos
5265+ BBEA ED 44            NEG
5266+ BBEC              .fomDxPos:
5267+ BBEC 32 3D BC         LD (.fomAdx), A
5268+ BBEF 3A FA 82         LD A, (CorpseY)
5269+ BBF2 4F               LD C, A
5270+ BBF3 DD 7E 04         LD A, (IX+ENT_POSY)
5271+ BBF6 91               SUB C
5272+ BBF7 30 02            JR NC, .fomDyPos
5273+ BBF9 ED 44            NEG
5274+ BBFB              .fomDyPos:
5275+ BBFB 32 3E BC         LD (.fomAdy), A
5276+ BBFE
5277+ BBFE                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5278+ BBFE 3A 3D BC         LD A, (.fomAdx)
5279+ BC01 FE 10            CP 16
5280+ BC03 D2 2C BC         JP NC, .fomFreeze
5281+ BC06 3A 3E BC         LD A, (.fomAdy)
5282+ BC09 FE 10            CP 16
5283+ BC0B D2 2C BC         JP NC, .fomFreeze
5284+ BC0E
5285+ BC0E                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5286+ BC0E 3A 3D BC         LD A, (.fomAdx)
5287+ BC11 47               LD B, A
5288+ BC12 3A 3E BC         LD A, (.fomAdy)
5289+ BC15 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5290+ BC16 38 0C            JR C, .fomTryX
5291+ BC18 28 0A            JR Z, .fomTryX
5292+ BC1A                  ; |dy| > |dx| -> intentar Y primero
5293+ BC1A CD 72 BC         CALL TryBackoffY
5294+ BC1D 28 0D            JR Z, .fomFreeze                ; ok
5295+ BC1F CD 3F BC         CALL TryBackoffX
5296+ BC22 18 08            JR .fomFreeze
5297+ BC24              .fomTryX:
5298+ BC24 CD 3F BC         CALL TryBackoffX
5299+ BC27 28 03            JR Z, .fomFreeze
5300+ BC29 CD 72 BC         CALL TryBackoffY
5301+ BC2C
5302+ BC2C              .fomFreeze:
5303+ BC2C                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5304+ BC2C                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5305+ BC2C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5306+ BC30 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5307+ BC34 DD 36 0A 00      LD (IX+ENT_DIR), 0
5308+ BC38 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5309+ BC3C C9               RET
5310+ BC3D
5311+ BC3D 00           .fomAdx: DEFB 0
5312+ BC3E 00           .fomAdy: DEFB 0
5313+ BC3F
5314+ BC3F              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5315+ BC3F              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5316+ BC3F              TryBackoffX:
5317+ BC3F DD 7E 03         LD A, (IX+ENT_POSX)
5318+ BC42 32 71 BC         LD (.tbxSavePos), A
5319+ BC45 47               LD B, A
5320+ BC46 3A F9 82         LD A, (CorpseX)
5321+ BC49 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5322+ BC4A DD 7E 03         LD A, (IX+ENT_POSX)
5323+ BC4D 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5324+ BC4F C6 10            ADD A, 16
5325+ BC51 18 02            JR .tbxApply
5326+ BC53              .tbxNeg:
5327+ BC53 D6 10            SUB 16
5328+ BC55              .tbxApply:
5329+ BC55                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5330+ BC55 DD 77 03         LD (IX+ENT_POSX), A
5331+ BC58 FE E8            CP SCREEN_MAX_X
5332+ BC5A 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5333+ BC5C CD 33 B7         CALL CheckEnemyCollision
5334+ BC5F 20 07            JR NZ, .tbxFail
5335+ BC61 CD A9 BC         CALL CheckMonsterOverlap
5336+ BC64 20 02            JR NZ, .tbxFail
5337+ BC66 AF               XOR A                           ; Z = ok
5338+ BC67 C9               RET
5339+ BC68              .tbxFail:
5340+ BC68 3A 71 BC         LD A, (.tbxSavePos)
5341+ BC6B DD 77 03         LD (IX+ENT_POSX), A
5342+ BC6E F6 01            OR 1                            ; NZ
5343+ BC70 C9               RET
5344+ BC71 00           .tbxSavePos: DEFB 0
