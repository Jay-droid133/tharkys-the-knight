 236+ E353                  ; Decrementar canal A (si > 0)
 237+ E353 3A 8A E2         LD A, (BellVolL)
 238+ E356 B7               OR A
 239+ E357 28 0A            JR Z, .skipA
 240+ E359 3D               DEC A
 241+ E35A 32 8A E2         LD (BellVolL), A
 242+ E35D 5F               LD E, A
 243+ E35E 3E 08            LD A, 8
 244+ E360 CD 4C E2         CALL AY_WriteReg
 245+ E363              .skipA:
 246+ E363
 247+ E363                  ; Decrementar canal B (si > 0)
 248+ E363 3A 8B E2         LD A, (BellVolC)
 249+ E366 B7               OR A
 250+ E367 28 0A            JR Z, .skipB
 251+ E369 3D               DEC A
 252+ E36A 32 8B E2         LD (BellVolC), A
 253+ E36D 5F               LD E, A
 254+ E36E 3E 09            LD A, 9
 255+ E370 CD 4C E2         CALL AY_WriteReg
 256+ E373              .skipB:
 257+ E373
 258+ E373                  ; Decrementar canal C (si > 0)
 259+ E373 3A 8C E2         LD A, (BellVolR)
 260+ E376 B7               OR A
