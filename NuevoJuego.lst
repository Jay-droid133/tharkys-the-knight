 879+ 7939 6F               LD L, A                              ; HL = sid
 880+ 793A E5               PUSH HL
 881+ 793B 29               ADD HL, HL                           ; HL = sid*2
 882+ 793C D1               POP DE
 883+ 793D 19               ADD HL, DE                           ; HL = sid*3
 884+ 793E 58               LD E, B
 885+ 793F 16 00            LD D, 0
 886+ 7941 19               ADD HL, DE                           ; HL = sid*3 + comp
 887+ 7942                  ; bit pos = HL & 7; byte idx = HL >> 3
 888+ 7942 7D               LD A, L
 889+ 7943 E6 07            AND $07
 890+ 7945 4F               LD C, A                              ; C = bit pos
 891+ 7946 CB 3C            SRL H
 892+ 7948 CB 1D            RR L
