 124+ EBEA              ; UpdateGameClock
 125+ EBEA              ; ==============================================================================
 126+ EBEA              UpdateGameClock:
 127+ EBEA 3A BB 82         LD A, (TimeFrozen)
 128+ EBED B7               OR A
 129+ EBEE C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EBEF 21 50 EA         LD HL, GameSubMinute
 131+ EBF2 34               INC (HL)
 132+ EBF3 3A 53 EA         LD A, (SubMinuteMax)
 133+ EBF6 BE               CP (HL)
 134+ EBF7 C0               RET NZ
 135+ EBF8
 136+ EBF8 AF               XOR A
 137+ EBF9 32 50 EA         LD (GameSubMinute), A
 138+ EBFC 21 51 EA         LD HL, GameMinutes
 139+ EBFF 34               INC (HL)
 140+ EC00                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EC00                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EC00 3A 51 EA         LD A, (GameMinutes)
 143+ EC03 FE 3C            CP 60
 144+ EC05 C0               RET NZ
 145+ EC06
 146+ EC06 AF               XOR A
 147+ EC07 32 51 EA         LD (GameMinutes), A
 148+ EC0A 21 52 EA         LD HL, GameHours
 149+ EC0D 34               INC (HL)
 150+ EC0E 7E               LD A, (HL)
 151+ EC0F FE 18            CP 24
 152+ EC11 20 04            JR NZ, .checkPhase
 153+ EC13 AF               XOR A
 154+ EC14 32 52 EA         LD (GameHours), A
 155+ EC17
 156+ EC17              .checkPhase:
 157+ EC17 3A 52 EA         LD A, (GameHours)
 158+ EC1A 21 5C EA         LD HL, PhaseTable
 159+ EC1D 06 07            LD B, 7
 160+ EC1F              .phaseLoop:
 161+ EC1F BE               CP (HL)
 162+ EC20 28 05            JR Z, .phaseFound
 163+ EC22 23               INC HL
 164+ EC23 23               INC HL
 165+ EC24 10 F9            DJNZ .phaseLoop
 166+ EC26 C9               RET
 167+ EC27              .phaseFound:
 168+ EC27 23               INC HL
 169+ EC28 7E               LD A, (HL)
 170+ EC29 F5               PUSH AF
 171+ EC2A CD F2 E3         CALL SetTimeOfDay
 172+ EC2D F1               POP AF
 173+ EC2E FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EC30 C0               RET NZ
 175+ EC31                  ; Nuevo dia: incrementar ciclo
 176+ EC31 21 24 BD         LD HL, DayCycleCount
 177+ EC34 34               INC (HL)
 178+ EC35 C9               RET
