# file closed: bg_gfx_b.asm
 413  E45D                  ; ay_sound.asm vive aqui (bank 4, no-contended). MainLoop entra via thunks
 414  E45D                  ; en ay_sound_thunks.asm. ay_sound es self-contained: cero CALL/JP a
 415  E45D                  ; rutinas externas, asi que NO hay cross-bank surface dentro del impl.
 416  E45D                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ E45D              ; ==============================================================================
   2+ E45D              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E45D              ; ==============================================================================
   4+ E45D              ; Puertos:
   5+ E45D              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E45D              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E45D              ;
   8+ E45D              ; Registros AY:
   9+ E45D              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E45D              ;   R2/R3: tono canal B
  11+ E45D              ;   R4/R5: tono canal C
  12+ E45D              ;   R6:    period del ruido (5 bits)
  13+ E45D              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E45D              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E45D              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E45D              ;   R9:    volumen B
  17+ E45D              ;   R10:   volumen C
  18+ E45D              ;   R11/R12: period del envelope
  19+ E45D              ;   R13:   forma del envelope (0-15)
  20+ E45D              ; ==============================================================================
  21+ E45D
  22+ E45D              ; ==============================================================================
  23+ E45D              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E45D              ; ==============================================================================
  25+ E45D              ; Entrada: A = registro (0-13), E = valor
  26+ E45D              ; Destruye: BC, A
  27+ E45D              ; ==============================================================================
  28+ E45D              AY_WriteReg:
  29+ E45D 01 FD FF         LD BC, $FFFD
  30+ E460 ED 79            OUT (C), A                  ; seleccionar registro
  31+ E462 01 FD BF         LD BC, $BFFD
  32+ E465 ED 59            OUT (C), E                  ; escribir valor
  33+ E467 C9               RET
  34+ E468
  35+ E468              ; ==============================================================================
  36+ E468              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E468              ; ==============================================================================
  38+ E468              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E468              ; ==============================================================================
  40+ E468              AY_StopImpl:
  41+ E468 3E 08            LD A, 8
  42+ E46A 1E 00            LD E, 0
  43+ E46C CD 5D E4         CALL AY_WriteReg
  44+ E46F 3E 09            LD A, 9
  45+ E471 1E 00            LD E, 0
  46+ E473 CD 5D E4         CALL AY_WriteReg
  47+ E476 3E 0A            LD A, 10
  48+ E478 1E 00            LD E, 0
  49+ E47A CD 5D E4         CALL AY_WriteReg
  50+ E47D C9               RET
  51+ E47E
  52+ E47E
  53+ E47E              ; ==============================================================================
  54+ E47E              ; AY_Init - Silencia todos los canales (volumen 0, mixer todo off)
  55+ E47E              ; ==============================================================================
  56+ E47E              AY_InitImpl:
  57+ E47E 3E 07            LD A, 7                     ; mixer
  58+ E480 1E 3F            LD E, $3F                   ; todos los tonos y ruidos en off
  59+ E482 CD 5D E4         CALL AY_WriteReg
  60+ E485 3E 08            LD A, 8                     ; volumen A
  61+ E487 1E 00            LD E, 0
  62+ E489 CD 5D E4         CALL AY_WriteReg
  63+ E48C 3E 09            LD A, 9                     ; volumen B
  64+ E48E 1E 00            LD E, 0
  65+ E490 CD 5D E4         CALL AY_WriteReg
  66+ E493 3E 0A            LD A, 10                    ; volumen C
  67+ E495 1E 00            LD E, 0
  68+ E497 CD 5D E4         CALL AY_WriteReg
  69+ E49A C9               RET
  70+ E49B
  71+ E49B              ; ==============================================================================
  72+ E49B              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  73+ E49B              ; ==============================================================================
  74+ E49B              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  75+ E49B              ; el AY toca solo durante el decay.
  76+ E49B              ; ==============================================================================
  77+ E49B              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  78+ E49B              ; ==============================================================================
  79+ E49B              ; ==============================================================================
  80+ E49B              ; Variables del decay manual de la campana (con pan estereo)
  81+ E49B              ; ==============================================================================
  82+ E49B              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  83+ E49B              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  84+ E49B              ; Cuando los 3 son 0, la campana esta silenciada.
  85+ E49B 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  86+ E49C 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  87+ E49D 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  88+ E49E 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  89+ E49F
  90+ E49F              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  91+ E49F
  92+ E49F              ; ==============================================================================
  93+ E49F              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  94+ E49F              ; ==============================================================================
  95+ E49F              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  96+ E49F              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  97+ E49F              ; ==============================================================================
  98+ E49F              AY_PlayBellChimeImpl:
  99+ E49F                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 100+ E49F                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 101+ E49F                  ; editor — el sonido espacial debe centrarse en la plaza real).
 102+ E49F 3A AD 82         LD A, (CurrentScreenX)
 103+ E4A2 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 104+ E4A4 57               LD D, A                     ; D = dx signed (player - plaza)
 105+ E4A5 30 02            JR NC, .absDxOk
 106+ E4A7 ED 44            NEG
 107+ E4A9              .absDxOk:
 108+ E4A9 47               LD B, A                     ; B = |dx|
 109+ E4AA
