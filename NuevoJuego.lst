6818+ C872              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6819+ C872              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6820+ C872              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6821+ C872              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6822+ C872              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6823+ C872              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6824+ C872              DeathGhostChase:
6825+ C872                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6826+ C872 3A 4E 81         LD A, (EntityTable + ENT_POSX)
6827+ C875 DD 96 03         SUB (IX+ENT_POSX)
6828+ C878 30 02            JR NC, .udgAbsDxOk
6829+ C87A ED 44            NEG
6830+ C87C              .udgAbsDxOk:
6831+ C87C 47               LD B, A                             ; B = |dx|
6832+ C87D 3A 4F 81         LD A, (EntityTable + ENT_POSY)
6833+ C880 DD 96 04         SUB (IX+ENT_POSY)
6834+ C883 30 02            JR NC, .udgAbsDyOk
6835+ C885 ED 44            NEG
6836+ C887              .udgAbsDyOk:
6837+ C887                  ; A = |dy|, B = |dx|
6838+ C887 B8               CP B
6839+ C888 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6840+ C88A
6841+ C88A                  ; --- Eje X primario ---
6842+ C88A AF               XOR A
6843+ C88B DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6844+ C88E 3A 4E 81         LD A, (EntityTable + ENT_POSX)
6845+ C891 DD 96 03         SUB (IX+ENT_POSX)
6846+ C894 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6847+ C896 3E 04            LD A, DEATH_GHOST_SPEED
6848+ C898 30 02            JR NC, .udgXSet
6849+ C89A 3E FC            LD A, -DEATH_GHOST_SPEED
6850+ C89C              .udgXSet:
6851+ C89C DD 77 06         LD (IX+ENT_DELTAX), A
6852+ C89F DD 86 03         ADD A, (IX+ENT_POSX)
6853+ C8A2 DD 77 03         LD (IX+ENT_POSX), A
6854+ C8A5 18 1B            JR .udgAnim
6855+ C8A7
6856+ C8A7                  ; --- Eje Y primario ---
6857+ C8A7              .udgVertPrim:
6858+ C8A7 AF               XOR A
6859+ C8A8 DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6860+ C8AB 3A 4F 81         LD A, (EntityTable + ENT_POSY)
6861+ C8AE DD 96 04         SUB (IX+ENT_POSY)
6862+ C8B1 28 0F            JR Z, .udgAnim
6863+ C8B3 3E 04            LD A, DEATH_GHOST_SPEED
6864+ C8B5 30 02            JR NC, .udgYSet
6865+ C8B7 3E FC            LD A, -DEATH_GHOST_SPEED
6866+ C8B9              .udgYSet:
6867+ C8B9 DD 77 07         LD (IX+ENT_DELTAY), A
6868+ C8BC DD 86 04         ADD A, (IX+ENT_POSY)
6869+ C8BF DD 77 04         LD (IX+ENT_POSY), A
6870+ C8C2              .udgAnim:
6871+ C8C2                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6872+ C8C2                  ; ser despawneada por una de tres condiciones externas:
6873+ C8C2                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6874+ C8C2                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6875+ C8C2                  ;   3. Player cambia de pantalla (screen_system reset)
6876+ C8C2                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6877+ C8C2                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6878+ C8C2                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6879+ C8C2 C3 C5 C8         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6880+ C8C5
6881+ C8C5              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6882+ C8C5              ; Llamada por:
6883+ C8C5              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6884+ C8C5              ;   - UpdateDeath en frame skip (sin movimiento).
6885+ C8C5              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6886+ C8C5              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6887+ C8C5              DeathAnimate:
6888+ C8C5 DD 7E 06         LD A, (IX+ENT_DELTAX)
6889+ C8C8 B7               OR A
6890+ C8C9 28 0A            JR Z, .daKeepDir
6891+ C8CB 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6892+ C8CD CB 7F            BIT 7, A
6893+ C8CF 28 0D            JR Z, .daDir
6894+ C8D1 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6895+ C8D3 18 09            JR .daDir
6896+ C8D5              .daKeepDir:
