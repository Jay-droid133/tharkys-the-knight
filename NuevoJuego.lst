1610+ F7C4              ; ==============================================================================
1611+ F7C4              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1612+ F7C4              ; ==============================================================================
1613+ F7C4              ; Indice (CompassSprites[idx]):
1614+ F7C4              ;   0 = NW    1 = N    2 = NE
1615+ F7C4              ;   3 = W     4 = X    5 = E
1616+ F7C4              ;   6 = SW    7 = S    8 = SE
1617+ F7C4              ; ==============================================================================
1618+ F7C4              CompassSprites:
1619+ F7C4 E3 F8            DEFW Sprite_Compass_NW
1620+ F7C6 03 F8            DEFW Sprite_Compass_N
1621+ F7C8 23 F8            DEFW Sprite_Compass_NE
1622+ F7CA C3 F8            DEFW Sprite_Compass_W
1623+ F7CC 03 F9            DEFW Sprite_Compass_X
1624+ F7CE 43 F8            DEFW Sprite_Compass_E
1625+ F7D0 A3 F8            DEFW Sprite_Compass_SW
1626+ F7D2 83 F8            DEFW Sprite_Compass_S
1627+ F7D4 63 F8            DEFW Sprite_Compass_SE
1628+ F7D6
1629+ F7D6              ; ==============================================================================
1630+ F7D6              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1631+ F7D6              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1632+ F7D6              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1633+ F7D6              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1634+ F7D6              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1635+ F7D6              ; ==============================================================================
1636+ F7D6              CompassWobbleTable:
1637+ F7D6 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1638+ F7DA 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1639+ F7DE 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1640+ F7E2 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1641+ F7E6 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1642+ F7EA 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1643+ F7EE 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1644+ F7F2 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1645+ F7F6 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1646+ F7FA
1647+ F7FA              ; ==============================================================================
1648+ F7FA              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1649+ F7FA              ; Indexada por (counter-1) -> 0..8. Valor:
1650+ F7FA              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1651+ F7FA              ; Con counter inicial 9 y decremento por frame:
1652+ F7FA              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1653+ F7FA              ;   counter 8 -> phase 7 -> prev
1654+ F7FA              ;   counter 7 -> phase 6 -> target
1655+ F7FA              ;   counter 6 -> phase 5 -> next
1656+ F7FA              ;   counter 5 -> phase 4 -> next2
1657+ F7FA              ;   counter 4 -> phase 3 -> prev
1658+ F7FA              ;   counter 3 -> phase 2 -> target
1659+ F7FA              ;   counter 2 -> phase 1 -> prev
1660+ F7FA              ;   counter 1 -> phase 0 -> target (estado final, settle)
1661+ F7FA              ; ==============================================================================
1662+ F7FA              WobblePhaseTable:
1663+ F7FA 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1663+ F7FE 04 03 02 01
1663+ F802 00
