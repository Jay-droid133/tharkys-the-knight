 969+ D547              ; ==============================================================================
 970+ D547              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 971+ D547              ; ==============================================================================
 972+ D547              ; Entrada: A = attr byte
 973+ D547              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 974+ D547              ; Preserva: HL, DE, BC, IX
 975+ D547              ; ==============================================================================
 976+ D547              ApplyTintSwap:
 977+ D547 C5               PUSH BC
 978+ D548 47               LD B, A                     ; B = attr original
 979+ D549 3A 43 D5         LD A, (CurrentTintVar)
 980+ D54C FE FF            CP $FF
 981+ D54E 28 24            JR Z, .tintNoChange
 982+ D550 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 983+ D551 3A 44 D5         LD A, (CurrentTintPaper)
 984+ D554 FE FF            CP $FF
 985+ D556 28 1C            JR Z, .tintNoChange
 986+ D558                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 987+ D558                  ; Extraer paper del attr: bits 5-3
 988+ D558 78               LD A, B
