 108+ 6050              ; ==============================================================================
 109+ 6050              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 110+ 6050              ; ==============================================================================
 111+ 6050              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 112+ 6050              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 113+ 6050              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 114+ 6050              ;
 115+ 6050              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 116+ 6050              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 117+ 6050              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 118+ 6050              ; Destruye: AF, BC, DE, HL, IX.
 119+ 6050              ; ==============================================================================
 120+ 6050              CheckTownGateTriggerBg:
 121+ 6050 3A EF 81         LD A, (TownGatePhase)
 122+ 6053 B7               OR A
 123+ 6054 C0               RET NZ                              ; ya en cutscene
 124+ 6055 3A DA 81         LD A, (CurrentKey)
 125+ 6058 FE 06            CP TGCS_ARCH_KEY_ID
 126+ 605A C0               RET NZ                              ; sin la key correcta
 127+ 605B 3A 08 82         LD A, (CurrentScreenX)
 128+ 605E FE 07            CP TGCS_ARCH_ROOM_X
 129+ 6060 C0               RET NZ
 130+ 6061 3A 09 82         LD A, (CurrentScreenY)
 131+ 6064 FE 0F            CP TGCS_ARCH_ROOM_Y
 132+ 6066 C0               RET NZ
 133+ 6067                  ; --- Horizontal AABB ---
 134+ 6067 3A CA 80         LD A, (EntityTable + ENT_POSX)
 135+ 606A 4F               LD C, A                             ; C = player_left
 136+ 606B C6 10            ADD A, 16
 137+ 606D 57               LD D, A                             ; D = player_right
 138+ 606E 3E 50            LD A, TGCS_ARCH_PX_LEFT
 139+ 6070 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 140+ 6072 30 01            JR NC, .ctgtNoUnderL
 141+ 6074 AF               XOR A
 142+ 6075              .ctgtNoUnderL:
 143+ 6075 BA               CP D
 144+ 6076 D0               RET NC                              ; ext_left >= player_right
 145+ 6077 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 146+ 6079 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 147+ 607B 30 02            JR NC, .ctgtNoOverR
 148+ 607D 3E FF            LD A, $FF
 149+ 607F              .ctgtNoOverR:
 150+ 607F B9               CP C
 151+ 6080 D8               RET C                               ; ext_right < player_left
 152+ 6081                  ; --- Vertical AABB ---
 153+ 6081                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 154+ 6081                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 155+ 6081                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 156+ 6081                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 157+ 6081                  ; con la altura real del rect.
 158+ 6081 3A CB 80         LD A, (EntityTable + ENT_POSY)
 159+ 6084 4F               LD C, A                             ; C = player_top
 160+ 6085 C6 15            ADD A, 21
 161+ 6087 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 162+ 6088 3E 78            LD A, TGCS_ARCH_PX_TOP
 163+ 608A D6 04            SUB TGCS_ARCH_TOLERANCE
 164+ 608C 30 01            JR NC, .ctgtNoUnderT
 165+ 608E AF               XOR A
 166+ 608F              .ctgtNoUnderT:
 167+ 608F BA               CP D
 168+ 6090 D0               RET NC
 169+ 6091 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 170+ 6093 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 171+ 6095 30 02            JR NC, .ctgtNoOverB
 172+ 6097 3E FF            LD A, $FF
 173+ 6099              .ctgtNoOverB:
 174+ 6099 B9               CP C
 175+ 609A D8               RET C
 176+ 609B                  ; HIT
 177+ 609B CD EC 60         CALL StartTownGateCutscene
 178+ 609E 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 179+ 60A0 C3 63 E9         JP CheckMilestoneTrigger            ; tail call
 180+ 60A3
 181+ 60A3              ; ==============================================================================
 182+ 60A3              ; TownGateWipeAllEnemies - erase XOR + clear de nastys/monsters/death
 183+ 60A3              ; ==============================================================================
 184+ 60A3              ; Itera slots 1..NUM_ENTITIES-1 (slot 0 = player, lo dejamos). Para cada
 185+ 60A3              ; entidad activa que NO sea TYPE_OBJECT/PLAYER: erase via OldSprite XOR +
 186+ 60A3              ; RestoreOldAttr + TYPE_NONE. Igual al pattern de despawn limpio en
 187+ 60A3              ; .peScaredDespawn de logic_game.asm.
 188+ 60A3              ;
 189+ 60A3              ; Llamado desde StartTownGateCutscene antes del snap del player. Asi el
 190+ 60A3              ; mundo queda en silencio durante el cutscene final, sin enemigos
 191+ 60A3              ; congelados (skip de ProcessEnemies durante cutscene los dejaria pintados
 192+ 60A3              ; en su ultima posicion para siempre).
 193+ 60A3              ; Destruye: AF, BC, DE, HL, IX.
 194+ 60A3              ; ==============================================================================
 195+ 60A3              TownGateWipeAllEnemies:
 196+ 60A3 DD 21 D7 80      LD IX, EntityTable + ENT_SIZE       ; slot 1 (skip player)
 197+ 60A7 06 10            LD B, NUM_ENTITIES - 1
 198+ 60A9              .tgwaeLoop:
 199+ 60A9 DD 7E 01         LD A, (IX+ENT_TYPE)
 200+ 60AC B7               OR A
 201+ 60AD 28 31            JR Z, .tgwaeNext                    ; TYPE_NONE: nada que borrar
 202+ 60AF FE 04            CP TYPE_OBJECT
 203+ 60B1 28 2D            JR Z, .tgwaeNext                    ; objetos coleccionables: respetar
 204+ 60B3 FE 01            CP TYPE_PLAYER
 205+ 60B5 28 29            JR Z, .tgwaeNext                    ; (defensivo)
 206+ 60B7 C5               PUSH BC                             ; preservar B (loop counter)
 207+ 60B8 DD E5            PUSH IX                             ; preservar slot ptr
 208+ 60BA CD F3 A7         CALL GetOldSpriteAddr               ; OldSprAddr setado, IX intacto
 209+ 60BD DD 7E 0D         LD A, (IX+ENT_OLDY)
 210+ 60C0 57               LD D, A
 211+ 60C1 DD 7E 0C         LD A, (IX+ENT_OLDX)
 212+ 60C4 5F               LD E, A
 213+ 60C5 DD 2A 7B A7      LD IX, (OldSprAddr)
 214+ 60C9 CD A9 9D         CALL DrawSprite                     ; XOR erase
 215+ 60CC DD E1            POP IX                              ; recuperar slot ptr
 216+ 60CE DD 56 0D         LD D, (IX+ENT_OLDY)
 217+ 60D1 DD 5E 0C         LD E, (IX+ENT_OLDX)
 218+ 60D4 CD 21 CF         CALL RestoreOldAttr                 ; restaurar attrs del fondo
 219+ 60D7 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 220+ 60DB DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 221+ 60DF C1               POP BC
 222+ 60E0              .tgwaeNext:
 223+ 60E0 11 10 00         LD DE, ENT_SIZE
 224+ 60E3 DD 19            ADD IX, DE
 225+ 60E5 10 C2            DJNZ .tgwaeLoop
 226+ 60E7                  ; Limpiar tambien la cola de pending erases para que EraseDeadSprites
 227+ 60E7                  ; no intente procesar slots que ya hemos borrado (frame en curso).
 228+ 60E7 AF               XOR A
 229+ 60E8 32 7B 5F         LD (PendingEraseCount), A
 230+ 60EB C9               RET
 231+ 60EC
 232+ 60EC              ; ==============================================================================
 233+ 60EC              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 234+ 60EC              ; ==============================================================================
 235+ 60EC              ; Wipe enemigos (silencio dramatico) + erase puerta cerrada v2 + draw open
 236+ 60EC              ; door (v2 desaparece, open aparece in-place) + snap player a anchor1 UP.
 237+ 60EC              ; Set TownGatePhase=1 + TownGateTimer=TGCS_T_LOCK. Consume la TownGateKey.
 238+ 60EC              ; Destruye: AF, BC, DE, HL, IX.
 239+ 60EC              ; ==============================================================================
 240+ 60EC              StartTownGateCutscene:
 241+ 60EC AF               XOR A
 242+ 60ED 32 DA 81         LD (CurrentKey), A
 243+ 60F0 CD A3 60         CALL TownGateWipeAllEnemies
 244+ 60F3 CD 4A 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 245+ 60F6                  ; Erase player en su posicion actual (XOR redraw del sprite viejo)
 246+ 60F6 DD 21 C7 80      LD IX, EntityTable
 247+ 60FA DD E5            PUSH IX
 248+ 60FC CD F3 A7         CALL GetOldSpriteAddr
 249+ 60FF DD 56 0D         LD D, (IX+ENT_OLDY)
 250+ 6102 DD 7E 0C         LD A, (IX+ENT_OLDX)
 251+ 6105 5F               LD E, A
 252+ 6106 DD 2A 7B A7      LD IX, (OldSprAddr)
 253+ 610A CD A9 9D         CALL DrawSprite
