 562+ E831              ; TownGateDrawPlayerHere / TownGateRedrawPlayer / TownGateErasePlayer:
 563+ E831              ; viven en slot 1 (town_gate_cutscene.asm) — llamadas por bank_cutscene via
 564+ E831              ; TownGateRedrawPlayer_B7. Aqui las omitimos para evitar duplicacion.
 565+ E831
 566+ E831              ; ==============================================================================
 567+ E831              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 568+ E831              ; ==============================================================================
 569+ E831              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 570+ E831              ;    al haberse dibujado ya en el render normal de la sala).
 571+ E831              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 572+ E831              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 573+ E831              ; Bank 3 para ambos (sprites baseline town).
 574+ E831              ; Destruye: AF, BC, DE, HL, IX.
 575+ E831              ; ==============================================================================
 576+ E831              TownGateOpenDoor:
 577+ E831 11 B0 E2         LD DE, BgGfx_town_gate_door_closed_v2
 578+ E834 CD 37 6D         CALL RedrawPickupByPtr_B7               ; XOR-erase del closed
 579+ E837                  ; Fall-through a TownGateRedrawOpenDoor
 580+ E837
 581+ E837              ; ==============================================================================
 582+ E837              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 583+ E837              ; ==============================================================================
 584+ E837              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 585+ E837              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 586+ E837              ; el open door restaura attrs originales en sus 4 cols + pixels.
 587+ E837              ; ==============================================================================
 588+ E837              TownGateRedrawOpenDoor:
 589+ E837 21 6F E6         LD HL, BgGfx_town_gate_door_open
 590+ E83A 3E 03            LD A, 3
 591+ E83C CD 5B 6D         CALL LoadBgSpriteToBuffer_B7
 592+ E83F DD 21 F7 86      LD IX, BgSpriteBuffer
 593+ E843 06 0E            LD B, TGCS_DOOR_CHARX
 594+ E845 0E 11            LD C, TGCS_DOOR_CHARY
 595+ E847                  ; BgSpriteIsHouse=0, CurrentTintVar=0 escritas dentro de DrawBgGfxSpriteBlackTint_B7
 596+ E847                  ; (esas vars viven en bank 0, no se pueden escribir desde bank 7 sin paginar).
 597+ E847 C3 B8 6D         JP DrawBgGfxSpriteBlackTint_B7
 598+ E84A
 599+ E84A              ; TownGateAllNastiesDeadCheck: vive en slot 1 (town_gate_cutscene.asm) —
 600+ E84A              ; llamada por bank_cutscene directamente (CALL TownGateAllNastiesDeadCheck).
 601+ E84A              ; Es safe sin _B7 wrap porque NO toca paging.
 602+ E84A
 603+ E84A              ; TownGatePlayerXOR_BiClip: vive en slot 1 (usada por TownGatePlayerSlideErase
 604+ E84A              ; y SlideDraw que viven en slot 1). El body bank 7 no la llama directamente.
 605+ E84A
 606+ E84A              ; TownGatePlayerSlideErase / SlideDraw: viven en slot 1 (paginan bank 6
 607+ E84A              ; internamente con OUT, no se pueden mover a bank 7 sin reorganizacion mayor).
 608+ E84A              ; El body bank 7 las llama via TownGatePlayerSlideErase_B7 / SlideDraw_B7.
 609+ E84A
 610+ E84A              ; ==============================================================================
 611+ E84A              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 612+ E84A              ; ==============================================================================
 613+ E84A              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 614+ E84A              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 615+ E84A              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 616+ E84A              ; 2. Compute new offset random.
 617+ E84A              ; 3. Draw at new offset.
 618+ E84A              ; Destruye: AF, BC, DE, HL, IX.
 619+ E84A              ; ==============================================================================
 620+ E84A              TownGateShakeStep:
 621+ E84A CD 92 E8         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 622+ E84D CD AD E8         CALL TownGateDrawFingerShifted
 623+ E850                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 624+ E850 ED 5F            LD A, R
 625+ E852 E6 03            AND $03
 626+ E854 21 75 E8         LD HL, .tgssJitterTable
 627+ E857 5F               LD E, A
 628+ E858 16 00            LD D, 0
 629+ E85A 19               ADD HL, DE
 630+ E85B 7E               LD A, (HL)
 631+ E85C 32 A6 5F         LD (TownGateShakeOffsX), A
 632+ E85F 3A 9A 81         LD A, (GameFrameCounter)
 633+ E862 E6 03            AND $03
 634+ E864 21 75 E8         LD HL, .tgssJitterTable
 635+ E867 5F               LD E, A
 636+ E868 16 00            LD D, 0
 637+ E86A 19               ADD HL, DE
 638+ E86B 7E               LD A, (HL)
 639+ E86C 32 A7 5F         LD (TownGateShakeOffsY), A
 640+ E86F CD 92 E8         CALL TownGateDrawArmShifted          ; draw at new offset
 641+ E872 C3 AD E8         JP TownGateDrawFingerShifted
 642+ E875              .tgssJitterTable:
 643+ E875 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 644+ E879
 645+ E879              ; ==============================================================================
 646+ E879              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 647+ E879              ; ==============================================================================
 648+ E879              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 649+ E879              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 650+ E879              ; ==============================================================================
 651+ E879              TownGateShakeRestore:
 652+ E879 CD 92 E8         CALL TownGateDrawArmShifted          ; erase last shifted
 653+ E87C CD AD E8         CALL TownGateDrawFingerShifted
 654+ E87F AF               XOR A
 655+ E880 32 A6 5F         LD (TownGateShakeOffsX), A
 656+ E883 32 A7 5F         LD (TownGateShakeOffsY), A
 657+ E886 11 55 E2         LD DE, BgGfx_arm
 658+ E889 CD 37 6D         CALL RedrawPickupByPtr_B7               ; restore at PickupTable position
 659+ E88C 11 A2 E2         LD DE, BgGfx_finger
 660+ E88F C3 37 6D         JP RedrawPickupByPtr_B7
 661+ E892
 662+ E892              ; ==============================================================================
 663+ E892              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 664+ E892              ; ==============================================================================
 665+ E892              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 666+ E892              ; Destruye: AF, BC, DE, HL, IX.
 667+ E892              ; ==============================================================================
 668+ E892              TownGateDrawArmShifted:
 669+ E892 21 55 E2         LD HL, BgGfx_arm
 670+ E895 3E 03            LD A, 3
 671+ E897 CD 5B 6D         CALL LoadBgSpriteToBuffer_B7
 672+ E89A 3A A6 5F         LD A, (TownGateShakeOffsX)
 673+ E89D 47               LD B, A
 674+ E89E 3E 88            LD A, TGCS_ARM_PX_X
 675+ E8A0 80               ADD A, B
 676+ E8A1 5F               LD E, A
 677+ E8A2 3A A7 5F         LD A, (TownGateShakeOffsY)
 678+ E8A5 47               LD B, A
 679+ E8A6 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 680+ E8A8 80               ADD A, B
 681+ E8A9 57               LD D, A
 682+ E8AA C3 C8 E8         JP DrawBgSpriteAnyXorAtPixel
 683+ E8AD
 684+ E8AD              ; ==============================================================================
 685+ E8AD              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 686+ E8AD              ; ==============================================================================
 687+ E8AD              TownGateDrawFingerShifted:
 688+ E8AD 21 A2 E2         LD HL, BgGfx_finger
 689+ E8B0 3E 03            LD A, 3
 690+ E8B2 CD 5B 6D         CALL LoadBgSpriteToBuffer_B7
 691+ E8B5 3A A6 5F         LD A, (TownGateShakeOffsX)
 692+ E8B8 47               LD B, A
 693+ E8B9 3E 88            LD A, TGCS_FINGER_PX_X
 694+ E8BB 80               ADD A, B
 695+ E8BC 5F               LD E, A
 696+ E8BD 3A A7 5F         LD A, (TownGateShakeOffsY)
 697+ E8C0 47               LD B, A
 698+ E8C1 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 699+ E8C3 80               ADD A, B
 700+ E8C4 57               LD D, A
 701+ E8C5 C3 C8 E8         JP DrawBgSpriteAnyXorAtPixel
 702+ E8C8
 703+ E8C8              ; ==============================================================================
 704+ E8C8              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 705+ E8C8              ; ==============================================================================
 706+ E8C8              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 707+ E8C8              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 708+ E8C8              ;     E = pixel X (0..255).
 709+ E8C8              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 710+ E8C8              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 711+ E8C8              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 712+ E8C8              ; Destruye: AF, BC, DE, HL, IX.
 713+ E8C8              ; ==============================================================================
 714+ E8C8              DrawBgSpriteAnyXorAtPixel:
 715+ E8C8 DD 21 F7 86      LD IX, BgSpriteBuffer
 716+ E8CC DD 7E 00         LD A, (IX+0)                        ; height_px
 717+ E8CF B7               OR A
 718+ E8D0 C8               RET Z
 719+ E8D1 32 2B E9         LD (.dbsaHeight), A
 720+ E8D4 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 721+ E8D7 E6 7F            AND $7F
 722+ E8D9 32 2C E9         LD (.dbsaWidth), A
 723+ E8DC DD 23            INC IX
 724+ E8DE DD 23            INC IX                              ; -> pixel data
 725+ E8E0 7B               LD A, E
 726+ E8E1 E6 07            AND $07
 727+ E8E3 32 2D E9         LD (.dbsaShift), A
 728+ E8E6 7B               LD A, E
 729+ E8E7 E6 F8            AND $F8
 730+ E8E9 5F               LD E, A
 731+ E8EA CD 5C 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 732+ E8ED              .dbsaRow:
 733+ E8ED E5               PUSH HL
 734+ E8EE 3A 2C E9         LD A, (.dbsaWidth)
 735+ E8F1 47               LD B, A                             ; B = width counter
 736+ E8F2 0E 00            LD C, 0                             ; C = carry from prev byte
 737+ E8F4              .dbsaByte:
 738+ E8F4 DD 7E 00         LD A, (IX+0)
 739+ E8F7 2F               CPL                                 ; un-invert
 740+ E8F8 57               LD D, A                             ; D = sprite byte
 741+ E8F9 1E 00            LD E, 0                             ; E = bits que caen al next byte
 742+ E8FB 3A 2D E9         LD A, (.dbsaShift)
 743+ E8FE B7               OR A
 744+ E8FF 28 09            JR Z, .dbsaNoShift
 745+ E901 C5               PUSH BC
 746+ E902 47               LD B, A
 747+ E903              .dbsaShiftLoop:
 748+ E903 CB 3A            SRL D
 749+ E905 CB 1B            RR E
 750+ E907 10 FA            DJNZ .dbsaShiftLoop
 751+ E909 C1               POP BC
 752+ E90A              .dbsaNoShift:
 753+ E90A 7A               LD A, D
 754+ E90B B1               OR C                                ; combinar con carry previo
 755+ E90C AE               XOR (HL)
 756+ E90D 77               LD (HL), A
 757+ E90E 23               INC HL
 758+ E90F 4B               LD C, E                             ; nuevo carry para siguiente byte
 759+ E910 DD 23            INC IX
 760+ E912 10 E0            DJNZ .dbsaByte
 761+ E914                  ; Byte final (carry) si shift > 0
 762+ E914 3A 2D E9         LD A, (.dbsaShift)
 763+ E917 B7               OR A
 764+ E918 28 03            JR Z, .dbsaNoFinal
 765+ E91A 79               LD A, C
 766+ E91B AE               XOR (HL)
 767+ E91C 77               LD (HL), A
 768+ E91D              .dbsaNoFinal:
 769+ E91D E1               POP HL
 770+ E91E CD C8 9A         CALL NextPixelLine
 771+ E921 3A 2B E9         LD A, (.dbsaHeight)
 772+ E924 3D               DEC A
 773+ E925 32 2B E9         LD (.dbsaHeight), A
 774+ E928 20 C3            JR NZ, .dbsaRow
 775+ E92A C9               RET
