 102+ EAC1              ; RouletteTypePtrs: lookup ROUL_* (1..11) -> BgGfx canonical ptr.
 103+ EAC1              ; HEALTH/STAMINA usan variant pick (PickRandomVariantPtr), no esta tabla.
 104+ EAC1              RouletteTypePtrs:
 105+ EAC1 98 CC            DEFW BgGfx_life                                     ; ROUL_LIFE        = 1
 106+ EAC3 7C E7            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH      = 2 (unused: variants)
 107+ EAC5 A5 E7            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA     = 3 (unused: variants)
 108+ EAC7 CE E7            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO        = 4
 109+ EAC9 F7 E7            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL     = 5
 110+ EACB 20 E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM    = 6
 111+ EACD 5A F3            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS     = 7
 112+ EACF 8B F4            DEFW BgGfx_pickup_sword                             ; ROUL_ESPADA      = 8
 113+ EAD1 39 F4            DEFW BgGfx_pickup_shield                            ; ROUL_ESCUDO      = 9
 114+ EAD3 62 F4            DEFW BgGfx_pickup_shield_ray                        ; ROUL_ESCUDO_RAYO = 10
 115+ EAD5 B4 F4            DEFW BgGfx_pickup_reverse                           ; ROUL_REVERSE     = 11
