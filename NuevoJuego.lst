 603+ DC33 CD AD 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 604+ DC36
 605+ DC36 DD 21 DB 8F      LD IX, PlazaScanAddrs
 606+ DC3A 06 10            LD B, 16
 607+ DC3C              .buildLoop:
 608+ DC3C DD 75 00         LD (IX+0), L
 609+ DC3F DD 74 01         LD (IX+1), H
 610+ DC42 DD 23            INC IX
 611+ DC44 DD 23            INC IX
