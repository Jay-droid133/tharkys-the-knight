 428+ 6F16 ~                LD (.cmcpCurSid), A
 429+ 6F16 ~
 430+ 6F16 ~                LD A, (ObjectiveScreenX)
 431+ 6F16 ~                CP $FF
 432+ 6F16 ~                JP Z, .cmcpNoPath
 433+ 6F16 ~                LD A, (ObjectiveScreenY)
 434+ 6F16 ~                RLCA
 434+ 6F16 ~              RLCA
 434+ 6F16 ~              RLCA
 434+ 6F16 ~              RLCA
 435+ 6F16 ~                LD HL, ObjectiveScreenX
 436+ 6F16 ~                ADD A, (HL)
 437+ 6F16 ~                LD (.cmcpTgtSid), A
 438+ 6F16 ~
 439+ 6F16 ~                LD B, A                              ; B = target sid
 440+ 6F16 ~                LD A, (.cmcpCurSid)
 441+ 6F16 ~                CP B
 442+ 6F16 ~                JP Z, .cmcpNoPath                    ; current==target → X blanca
 443+ 6F16 ~
 444+ 6F16 ~                ; --- Determinar player_current_comp via LastEntrySide ---
 445+ 6F16 ~                LD A, (LastEntrySide)
 446+ 6F16 ~                CP $FF
 447+ 6F16 ~                JR NZ, .cmcpHaveEntry
 448+ 6F16 ~                XOR A                                ; fallback: comp 0
 449+ 6F16 ~                JR .cmcpStoreCurComp
 450+ 6F16 ~            .cmcpHaveEntry:
 451+ 6F16 ~                ; Buscar el gap de current_sid en side LastEntrySide. Su comp = player comp.
 452+ 6F16 ~                LD B, A                              ; B = LastEntrySide
 453+ 6F16 ~                LD A, (.cmcpCurSid)
 454+ 6F16 ~                CALL .cmcpFindGapBySide              ; OUT: A = comp (0..2), o $FF si no encontrado
 455+ 6F16 ~                CP $FF
 456+ 6F16 ~                JR NZ, .cmcpStoreCurComp
 457+ 6F16 ~                XOR A                                ; fallback comp 0
 458+ 6F16 ~            .cmcpStoreCurComp:
 459+ 6F16 ~                LD (.cmcpCurComp), A
 460+ 6F16 ~
 461+ 6F16 ~                ; --- Clear visited bitmap (96 bytes = 768 bits = 256 sids × 3 comps) ---
 462+ 6F16 ~                LD HL, MagicCompassVisited
 463+ 6F16 ~                LD DE, MagicCompassVisited + 1
 464+ 6F16 ~                LD BC, 95
 465+ 6F16 ~                XOR A
 466+ 6F16 ~                LD (HL), A
 467+ 6F16 ~                LDIR
 468+ 6F16 ~
 469+ 6F16 ~                ; --- Inicializar cola con (target, comp 0) ---
 470+ 6F16 ~                XOR A
 471+ 6F16 ~                LD (MagicCompassBfsHead), A
 472+ 6F16 ~                LD (MagicCompassBfsTail), A
 473+ 6F16 ~                LD A, (.cmcpTgtSid)
 474+ 6F16 ~                LD HL, MagicCompassBfsQueue
 475+ 6F16 ~                LD (HL), A                           ; queue[0].sid = target
 476+ 6F16 ~                INC HL
 477+ 6F16 ~                XOR A
 478+ 6F16 ~                LD (HL), A                           ; queue[0].comp = 0
 479+ 6F16 ~                LD HL, MagicCompassBfsHead
 480+ 6F16 ~                INC (HL)                             ; head = 1
 481+ 6F16 ~
 482+ 6F16 ~                ; visited[(target, 0)] = 1
 483+ 6F16 ~                LD A, (.cmcpTgtSid)
 484+ 6F16 ~                LD B, 0
 485+ 6F16 ~                CALL .cmcpMarkVisited
 486+ 6F16 ~
 487+ 6F16 ~                ; INIT done → marcar in-progress y caer al loop con counter de iteraciones.
 488+ 6F16 ~                LD A, 1
 489+ 6F16 ~                LD (MagicCompassBfsState), A
 490+ 6F16 ~
 491+ 6F16 ~            .cmcpResume:
 492+ 6F16 ~                ; Cargar contador de iteraciones para este chunk de frame.
 493+ 6F16 ~                LD A, MAGIC_COMPASS_BFS_ITERS_PER_FRAME
 494+ 6F16 ~                LD (.cmcpItersLeft), A
 495+ 6F16 ~
 496+ 6F16 ~                ; --- BFS loop ---
 497+ 6F16 ~            .cmcpLoop:
 498+ 6F16 ~                ; Yield si se acabó el chunk de iteraciones del frame.
 499+ 6F16 ~                LD A, (.cmcpItersLeft)
 500+ 6F16 ~                OR A
 501+ 6F16 ~                JP Z, .cmcpYield
 502+ 6F16 ~                DEC A
 503+ 6F16 ~                LD (.cmcpItersLeft), A
 504+ 6F16 ~
 505+ 6F16 ~                ; queue empty?
 506+ 6F16 ~                LD A, (MagicCompassBfsHead)
 507+ 6F16 ~                LD B, A
 508+ 6F16 ~                LD A, (MagicCompassBfsTail)
 509+ 6F16 ~                CP B
 510+ 6F16 ~                JP Z, .cmcpNoPath
 511+ 6F16 ~
 512+ 6F16 ~                ; Pop: read queue[tail*2] = (sid, comp); tail++
 513+ 6F16 ~                LD E, A
 514+ 6F16 ~                INC A
 515+ 6F16 ~                AND 63
 516+ 6F16 ~                LD (MagicCompassBfsTail), A
 517+ 6F16 ~                LD A, E
 518+ 6F16 ~                ADD A, A                             ; *2 (entries de 2 bytes)
 519+ 6F16 ~                LD E, A
 520+ 6F16 ~                LD D, 0
 521+ 6F16 ~                LD HL, MagicCompassBfsQueue
 522+ 6F16 ~                ADD HL, DE
 523+ 6F16 ~                LD A, (HL)                           ; sid
 524+ 6F16 ~                LD (.cmcpR), A
 525+ 6F16 ~                INC HL
 526+ 6F16 ~                LD A, (HL)
 527+ 6F16 ~                LD (.cmcpRComp), A
 528+ 6F16 ~
 529+ 6F16 ~                ; Iterate RoomCompGaps[R]
 530+ 6F16 ~                LD A, (.cmcpR)
 531+ 6F16 ~                LD L, A
 532+ 6F16 ~                LD H, 0
 533+ 6F16 ~                ADD HL, HL                           ; *2 (DEFW ptrs)
 534+ 6F16 ~                LD DE, RoomCompGapsTable
 535+ 6F16 ~                ADD HL, DE
 536+ 6F16 ~                LD E, (HL)
 537+ 6F16 ~                INC HL
 538+ 6F16 ~                LD D, (HL)                           ; DE = record ptr
 539+ 6F16 ~                EX DE, HL                            ; HL = record
 540+ 6F16 ~
 541+ 6F16 ~                LD A, (HL)                           ; count
 542+ 6F16 ~                OR A
 543+ 6F16 ~                JP Z, .cmcpLoop                      ; no gaps → next pop
 544+ 6F16 ~                LD B, A                              ; B = remaining count
 545+ 6F16 ~                INC HL                               ; HL @ first {side_comp, coord}
 546+ 6F16 ~
 547+ 6F16 ~            .cmcpGapLoop:
 548+ 6F16 ~                ; Read side_comp byte
 549+ 6F16 ~                LD A, (HL)
 550+ 6F16 ~                LD (.cmcpGapSideComp), A
 551+ 6F16 ~                INC HL
 552+ 6F16 ~                LD A, (HL)
 553+ 6F16 ~                LD (.cmcpGapCoord), A
 554+ 6F16 ~                INC HL
 555+ 6F16 ~                PUSH BC                              ; save count
 556+ 6F16 ~                PUSH HL                              ; save record ptr
 557+ 6F16 ~
 558+ 6F16 ~                ; Match comp?
 559+ 6F16 ~                LD A, (.cmcpGapSideComp)
 560+ 6F16 ~                SRL A
 561+ 6F16 ~                SRL A                                ; A = comp (bits 2-3 → bits 0-1)
 562+ 6F16 ~                AND $03
 563+ 6F16 ~                LD C, A                              ; C = gap comp
 564+ 6F16 ~                LD A, (.cmcpRComp)
 565+ 6F16 ~                CP C
 566+ 6F16 ~                JP NZ, .cmcpGapNext
 567+ 6F16 ~
 568+ 6F16 ~                ; Compute V = neighbor of R in gap.side
 569+ 6F16 ~                LD A, (.cmcpGapSideComp)
 570+ 6F16 ~                AND $03                              ; A = side
 571+ 6F16 ~                LD C, A                              ; C = side
 572+ 6F16 ~                LD A, (.cmcpR)
 573+ 6F16 ~                LD B, A                              ; B = R sid
 574+ 6F16 ~                CALL .cmcpComputeNeighbor            ; IN: B=R, C=side; OUT: A=V (or $FF if invalid)
 575+ 6F16 ~                CP $FF
 576+ 6F16 ~                JP Z, .cmcpGapNext
 577+ 6F16 ~                LD (.cmcpV), A
 578+ 6F16 ~
 579+ 6F16 ~                ; Find V's gap with side=opposite(gap.side) AND coord=gap.coord
 580+ 6F16 ~                LD A, C                              ; side
 581+ 6F16 ~                XOR $01                              ; opposite (N↔S, W↔E using XOR 1 — N=0,S=1,W=2,E=3)
 582+ 6F16 ~                LD C, A                              ; C = opp_side
 583+ 6F16 ~                LD A, (.cmcpGapCoord)
 584+ 6F16 ~                LD B, A                              ; B = coord
 585+ 6F16 ~                LD A, (.cmcpV)
 586+ 6F16 ~                CALL .cmcpFindMatchingGap            ; OUT: A = V_comp (0..2) or $FF if no match
 587+ 6F16 ~                CP $FF
 588+ 6F16 ~                JP Z, .cmcpGapNext
 589+ 6F16 ~                LD (.cmcpVComp), A
 590+ 6F16 ~
 591+ 6F16 ~                ; Check V == current_sid AND V_comp == player_current_comp
 592+ 6F16 ~                LD A, (.cmcpV)
 593+ 6F16 ~                LD B, A
 594+ 6F16 ~                LD A, (.cmcpCurSid)
 595+ 6F16 ~                CP B
 596+ 6F16 ~                JR NZ, .cmcpNotCurrent
 597+ 6F16 ~                LD A, (.cmcpVComp)
 598+ 6F16 ~                LD B, A
 599+ 6F16 ~                LD A, (.cmcpCurComp)
 600+ 6F16 ~                CP B
 601+ 6F16 ~                JR NZ, .cmcpNotCurrent
 602+ 6F16 ~                ; FOUND: dir_player = opposite of gap.side. We already have it as opp_side
 603+ 6F16 ~                ; logic: opposite of side means the direction the player at current goes
 604+ 6F16 ~                ; to reach R. We computed opp_side earlier (used to find V's gap).
 605+ 6F16 ~                ; gap.side from R's perspective = direction to V. Player at V goes
 606+ 6F16 ~                ; opposite(gap.side) = opp_side to reach R.
 607+ 6F16 ~                LD A, (.cmcpGapSideComp)
 608+ 6F16 ~                AND $03                              ; gap.side
 609+ 6F16 ~                XOR $01                              ; player's direction (opposite)
 610+ 6F16 ~                LD (MagicCompassPathDir), A
 611+ 6F16 ~                ; Save gap coord para que DrawCompassGapHint pueda dibujar en el gap concreto
 612+ 6F16 ~                LD A, (.cmcpGapCoord)
 613+ 6F16 ~                LD (MagicCompassPathCoord), A
 614+ 6F16 ~                XOR A
 615+ 6F16 ~                LD (MagicCompassBfsState), A         ; BFS terminado
 616+ 6F16 ~                POP HL
 617+ 6F16 ~                POP BC
 618+ 6F16 ~                RET
 619+ 6F16 ~
 620+ 6F16 ~            .cmcpNotCurrent:
 621+ 6F16 ~                ; Visited check (B=sid, C=comp)
 622+ 6F16 ~                LD A, (.cmcpV)
 623+ 6F16 ~                LD B, A
 624+ 6F16 ~                LD A, (.cmcpVComp)
 625+ 6F16 ~                LD C, A
 626+ 6F16 ~                CALL .cmcpCheckVisitedBC             ; OUT: Z=not visited, NZ=visited
 627+ 6F16 ~                JP NZ, .cmcpGapNext
 628+ 6F16 ~
 629+ 6F16 ~                ; Mark visited (A=sid, B=comp)
 630+ 6F16 ~                LD A, (.cmcpVComp)
 631+ 6F16 ~                LD B, A
 632+ 6F16 ~                LD A, (.cmcpV)
 633+ 6F16 ~                CALL .cmcpMarkVisited
 634+ 6F16 ~
 635+ 6F16 ~                ; Push (V, V_comp) to queue
 636+ 6F16 ~                LD A, (MagicCompassBfsHead)
 637+ 6F16 ~                ADD A, A                             ; *2
 638+ 6F16 ~                LD E, A
 639+ 6F16 ~                LD D, 0
 640+ 6F16 ~                LD HL, MagicCompassBfsQueue
 641+ 6F16 ~                ADD HL, DE
 642+ 6F16 ~                LD A, (.cmcpV)
 643+ 6F16 ~                LD (HL), A
 644+ 6F16 ~                INC HL
 645+ 6F16 ~                LD A, (.cmcpVComp)
 646+ 6F16 ~                LD (HL), A
 647+ 6F16 ~                LD A, (MagicCompassBfsHead)
 648+ 6F16 ~                INC A
 649+ 6F16 ~                AND 63
 650+ 6F16 ~                LD (MagicCompassBfsHead), A
 651+ 6F16 ~
 652+ 6F16 ~            .cmcpGapNext:
 653+ 6F16 ~                POP HL
 654+ 6F16 ~                POP BC
 655+ 6F16 ~                DEC B
 656+ 6F16 ~                JP NZ, .cmcpGapLoop
 657+ 6F16 ~                JP .cmcpLoop
 658+ 6F16 ~
 659+ 6F16 ~            .cmcpNoPath:
 660+ 6F16 ~                XOR A
 661+ 6F16 ~                LD (MagicCompassBfsState), A         ; BFS terminado (sin path)
 662+ 6F16 ~                LD A, $FF
 663+ 6F16 ~                LD (MagicCompassPathDir), A
 664+ 6F16 ~                LD (MagicCompassPathCoord), A
 665+ 6F16 ~                RET
 666+ 6F16 ~
 667+ 6F16 ~            .cmcpYield:
 668+ 6F16 ~                ; Acabamos el chunk de iteraciones de este frame. State queda en 1, así
 669+ 6F16 ~                ; que el siguiente frame UpdateMagicCompass llamará a esta rutina de
 670+ 6F16 ~                ; nuevo y caerá en .cmcpResume (skip init, recargar contador, continuar).
 671+ 6F16 ~                RET
 672+ 6F16 ~
 673+ 6F16 ~            ; ==============================================================================
 674+ 6F16 ~            ; .cmcpFindGapBySide - Para sala A, busca el gap en side B más cercano al
 675+ 6F16 ~            ; LastEntryCoord; devuelve su comp.
 676+ 6F16 ~            ; ==============================================================================
 677+ 6F16 ~            ; IN:  A = sid, B = side (0..3)
 678+ 6F16 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no hay gap en ese side.
 679+ 6F16 ~            ;
 680+ 6F16 ~            ; Cuando hay múltiples gaps del mismo side en distintas comps (e.g. (5,12)
 681+ 6F16 ~            ; con E@3 comp 1 y E@11 comp 0), el coord físico del char donde entró el
 682+ 6F16 ~            ; player desambigua: tomamos el gap con coord más cercano al LastEntryCoord.
 683+ 6F16 ~            ;
 684+ 6F16 ~            ; Destruye: AF, BC, DE, HL.
 685+ 6F16 ~            ; ==============================================================================
 686+ 6F16 ~            .cmcpFindGapBySide:
 687+ 6F16 ~                LD (.fgbsTargetSid), A
 688+ 6F16 ~                LD A, B
 689+ 6F16 ~                LD (.fgbsTargetSide), A
 690+ 6F16 ~                LD A, $FF
 691+ 6F16 ~                LD (.fgbsBestComp), A
 692+ 6F16 ~                LD A, 255
 693+ 6F16 ~                LD (.fgbsBestDist), A                ; init bestDist = 255 (max)
 694+ 6F16 ~
 695+ 6F16 ~                LD A, (.fgbsTargetSid)
 696+ 6F16 ~                LD L, A
 697+ 6F16 ~                LD H, 0
 698+ 6F16 ~                ADD HL, HL
 699+ 6F16 ~                LD DE, RoomCompGapsTable
 700+ 6F16 ~                ADD HL, DE
 701+ 6F16 ~                LD E, (HL)
 702+ 6F16 ~                INC HL
 703+ 6F16 ~                LD D, (HL)
 704+ 6F16 ~                EX DE, HL                            ; HL = record
 705+ 6F16 ~                LD A, (HL)
 706+ 6F16 ~                OR A
 707+ 6F16 ~                JR Z, .fgbsDone
 708+ 6F16 ~                LD B, A                              ; count
 709+ 6F16 ~                INC HL
 710+ 6F16 ~            .fgbsLoop:
 711+ 6F16 ~                LD A, (HL)                           ; side_comp
 712+ 6F16 ~                INC HL
 713+ 6F16 ~                LD C, (HL)                           ; coord
 714+ 6F16 ~                INC HL
 715+ 6F16 ~                LD D, A                              ; D = side_comp
 716+ 6F16 ~                AND $03
 717+ 6F16 ~                LD E, A
 718+ 6F16 ~                LD A, (.fgbsTargetSide)
 719+ 6F16 ~                CP E
 720+ 6F16 ~                JR NZ, .fgbsNext
 721+ 6F16 ~
 722+ 6F16 ~                ; Compute |coord - LastEntryCoord|
 723+ 6F16 ~                LD A, (LastEntryCoord)
 724+ 6F16 ~                SUB C
 725+ 6F16 ~                JR NC, .fgbsAbsOk
 726+ 6F16 ~                NEG
 727+ 6F16 ~            .fgbsAbsOk:
 728+ 6F16 ~                LD E, A                              ; E = distance
 729+ 6F16 ~                LD A, (.fgbsBestDist)
 730+ 6F16 ~                CP E
 731+ 6F16 ~                JR C, .fgbsNext                      ; bestDist < E → not better
 732+ 6F16 ~                JR Z, .fgbsNext                      ; ties: keep first
 733+ 6F16 ~                ; New best
 734+ 6F16 ~                LD A, E
 735+ 6F16 ~                LD (.fgbsBestDist), A
 736+ 6F16 ~                LD A, D
 737+ 6F16 ~                SRL A
 738+ 6F16 ~                SRL A
 739+ 6F16 ~                AND $03
 740+ 6F16 ~                LD (.fgbsBestComp), A
 741+ 6F16 ~
 742+ 6F16 ~            .fgbsNext:
 743+ 6F16 ~                DJNZ .fgbsLoop
 744+ 6F16 ~            .fgbsDone:
 745+ 6F16 ~                LD A, (.fgbsBestComp)
 746+ 6F16 ~                RET
 747+ 6F16 ~
 748+ 6F16 ~            ; ==============================================================================
 749+ 6F16 ~            ; .cmcpComputeNeighbor - Calcula V dado R y side, con bounds check
 750+ 6F16 ~            ; ==============================================================================
 751+ 6F16 ~            ; IN:  B = R sid, C = side (0=N,1=S,2=W,3=E)
 752+ 6F16 ~            ; OUT: A = V sid (0..255) si valid; A = $FF si neighbor sale del mapa.
 753+ 6F16 ~            ; Destruye: AF.
 754+ 6F16 ~            ; ==============================================================================
 755+ 6F16 ~            .cmcpComputeNeighbor:
 756+ 6F16 ~                LD A, C
 757+ 6F16 ~                OR A
 758+ 6F16 ~                JR NZ, .ccnNotN
 759+ 6F16 ~                ; N: V = R - 16, valid if R >= 16
 760+ 6F16 ~                LD A, B
 761+ 6F16 ~                CP 16
 762+ 6F16 ~                JR C, .ccnInvalid
 763+ 6F16 ~                SUB 16
 764+ 6F16 ~                RET
 765+ 6F16 ~            .ccnNotN:
 766+ 6F16 ~                DEC A
 767+ 6F16 ~                JR NZ, .ccnNotS
 768+ 6F16 ~                ; S: V = R + 16, valid if R < 240
 769+ 6F16 ~                LD A, B
 770+ 6F16 ~                CP 240
 771+ 6F16 ~                JR NC, .ccnInvalid
 772+ 6F16 ~                ADD A, 16
 773+ 6F16 ~                RET
 774+ 6F16 ~            .ccnNotS:
 775+ 6F16 ~                DEC A
 776+ 6F16 ~                JR NZ, .ccnE
 777+ 6F16 ~                ; W: V = R - 1, valid if R % 16 != 0
 778+ 6F16 ~                LD A, B
 779+ 6F16 ~                AND $0F
 780+ 6F16 ~                JR Z, .ccnInvalid
 781+ 6F16 ~                LD A, B
 782+ 6F16 ~                DEC A
 783+ 6F16 ~                RET
 784+ 6F16 ~            .ccnE:
 785+ 6F16 ~                ; E: V = R + 1, valid if R % 16 != 15
 786+ 6F16 ~                LD A, B
 787+ 6F16 ~                AND $0F
 788+ 6F16 ~                CP 15
 789+ 6F16 ~                JR Z, .ccnInvalid
 790+ 6F16 ~                LD A, B
 791+ 6F16 ~                INC A
 792+ 6F16 ~                RET
 793+ 6F16 ~            .ccnInvalid:
 794+ 6F16 ~                LD A, $FF
 795+ 6F16 ~                RET
 796+ 6F16 ~
 797+ 6F16 ~            ; ==============================================================================
 798+ 6F16 ~            ; .cmcpFindMatchingGap - Busca en sala A un gap (side=B, coord=C)
 799+ 6F16 ~            ; ==============================================================================
 800+ 6F16 ~            ; Devuelve la comp del gap matching (side AND coord). Permite resolver la
 801+ 6F16 ~            ; correspondencia gap-físico cuando hay múltiples gaps del mismo side en
 802+ 6F16 ~            ; comps distintas.
 803+ 6F16 ~            ; IN:  A = sid, B = coord, C = side
 804+ 6F16 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no match.
 805+ 6F16 ~            ; Destruye: AF, BC, DE, HL.
 806+ 6F16 ~            ; ==============================================================================
 807+ 6F16 ~            .cmcpFindMatchingGap:
 808+ 6F16 ~                LD (.cfmgSid), A
 809+ 6F16 ~                LD A, B
 810+ 6F16 ~                LD (.cfmgCoord), A
 811+ 6F16 ~                LD A, C
 812+ 6F16 ~                LD (.cfmgSide), A
 813+ 6F16 ~                LD A, (.cfmgSid)
 814+ 6F16 ~                LD L, A
 815+ 6F16 ~                LD H, 0
 816+ 6F16 ~                ADD HL, HL
 817+ 6F16 ~                LD DE, RoomCompGapsTable
 818+ 6F16 ~                ADD HL, DE
 819+ 6F16 ~                LD E, (HL)
 820+ 6F16 ~                INC HL
 821+ 6F16 ~                LD D, (HL)
 822+ 6F16 ~                EX DE, HL                            ; HL = record
 823+ 6F16 ~                LD A, (HL)
 824+ 6F16 ~                OR A
 825+ 6F16 ~                JR Z, .cfmgNotFound
 826+ 6F16 ~                LD B, A
 827+ 6F16 ~                INC HL
 828+ 6F16 ~            .cfmgLoop:
 829+ 6F16 ~                LD A, (HL)                           ; side_comp
 830+ 6F16 ~                INC HL
 831+ 6F16 ~                LD C, (HL)                           ; coord
 832+ 6F16 ~                INC HL
 833+ 6F16 ~                LD D, A                              ; D = side_comp
 834+ 6F16 ~                AND $03                              ; side
 835+ 6F16 ~                LD E, A
 836+ 6F16 ~                LD A, (.cfmgSide)
 837+ 6F16 ~                CP E
 838+ 6F16 ~                JR NZ, .cfmgSkip
 839+ 6F16 ~                LD A, (.cfmgCoord)
 840+ 6F16 ~                CP C
 841+ 6F16 ~                JR NZ, .cfmgSkip
 842+ 6F16 ~                ; Match. Extract comp.
 843+ 6F16 ~                LD A, D
 844+ 6F16 ~                SRL A
 845+ 6F16 ~                SRL A
 846+ 6F16 ~                AND $03
 847+ 6F16 ~                RET
 848+ 6F16 ~            .cfmgSkip:
 849+ 6F16 ~                DJNZ .cfmgLoop
 850+ 6F16 ~            .cfmgNotFound:
 851+ 6F16 ~                LD A, $FF
 852+ 6F16 ~                RET
 853+ 6F16 ~
 854+ 6F16 ~            ; ==============================================================================
 855+ 6F16 ~            ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 856+ 6F16 ~            ; ==============================================================================
 857+ 6F16 ~            ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 858+ 6F16 ~            ; bit_idx en 16-bit: HL.
 859+ 6F16 ~            ;
 860+ 6F16 ~            ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 861+ 6F16 ~            ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 862+ 6F16 ~            ; ==============================================================================
 863+ 6F16 ~            .cmcpMarkVisited:
 864+ 6F16 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 865+ 6F16 ~                LD H, 0
 866+ 6F16 ~                LD L, A                              ; HL = sid
 867+ 6F16 ~                PUSH HL
 868+ 6F16 ~                ADD HL, HL                           ; HL = sid*2
 869+ 6F16 ~                POP DE
 870+ 6F16 ~                ADD HL, DE                           ; HL = sid*3
 871+ 6F16 ~                LD E, B
 872+ 6F16 ~                LD D, 0
 873+ 6F16 ~                ADD HL, DE                           ; HL = sid*3 + comp
 874+ 6F16 ~                ; bit pos = HL & 7; byte idx = HL >> 3
 875+ 6F16 ~                LD A, L
 876+ 6F16 ~                AND $07
 877+ 6F16 ~                LD C, A                              ; C = bit pos
 878+ 6F16 ~                SRL H
 879+ 6F16 ~                RR L
 880+ 6F16 ~                SRL H
 881+ 6F16 ~                RR L
 882+ 6F16 ~                SRL H
 883+ 6F16 ~                RR L                                 ; HL = HL/8 (byte idx)
 884+ 6F16 ~                LD DE, MagicCompassVisited
 885+ 6F16 ~                ADD HL, DE                           ; HL = byte addr
 886+ 6F16 ~                LD A, 1
 887+ 6F16 ~                INC C
 888+ 6F16 ~            .cmvShift:
 889+ 6F16 ~                DEC C
 890+ 6F16 ~                JR Z, .cmvDone
 891+ 6F16 ~                ADD A, A
 892+ 6F16 ~                JR .cmvShift
 893+ 6F16 ~            .cmvDone:
 894+ 6F16 ~                OR (HL)
 895+ 6F16 ~                LD (HL), A
 896+ 6F16 ~                RET
 897+ 6F16 ~
 898+ 6F16 ~            .cmcpCheckVisitedBC:
 899+ 6F16 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 900+ 6F16 ~                LD H, 0
 901+ 6F16 ~                LD L, B                              ; HL = sid
 902+ 6F16 ~                PUSH HL
 903+ 6F16 ~                ADD HL, HL
 904+ 6F16 ~                POP DE
 905+ 6F16 ~                ADD HL, DE                           ; HL = sid*3
 906+ 6F16 ~                LD E, C
 907+ 6F16 ~                LD D, 0
 908+ 6F16 ~                ADD HL, DE                           ; HL = sid*3 + comp
 909+ 6F16 ~                LD A, L
 910+ 6F16 ~                AND $07
 911+ 6F16 ~                LD C, A
 912+ 6F16 ~                SRL H
 913+ 6F16 ~                RR L
 914+ 6F16 ~                SRL H
 915+ 6F16 ~                RR L
 916+ 6F16 ~                SRL H
 917+ 6F16 ~                RR L
 918+ 6F16 ~                LD DE, MagicCompassVisited
 919+ 6F16 ~                ADD HL, DE
 920+ 6F16 ~                LD A, 1
 921+ 6F16 ~                INC C
 922+ 6F16 ~            .ccvShift:
 923+ 6F16 ~                DEC C
 924+ 6F16 ~                JR Z, .ccvDone
 925+ 6F16 ~                ADD A, A
 926+ 6F16 ~                JR .ccvShift
 927+ 6F16 ~            .ccvDone:
 928+ 6F16 ~                AND (HL)
 929+ 6F16 ~                RET
