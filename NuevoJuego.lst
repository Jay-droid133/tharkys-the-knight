7134+ C6E1              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
7135+ C6E1              UpdateDeathTimer:
7136+ C6E1                  IF DEBUG_NO_ENEMIES
7137+ C6E1 ~                RET
7138+ C6E1                  ENDIF
7139+ C6E1 3A 02 83         LD A, (DeathSpawned)
7140+ C6E4 B7               OR A
7141+ C6E5 C0               RET NZ                              ; ya spawneada: nada que hacer
7142+ C6E6                  ; Inhibida en esta sala (puerta de iglesia abierta -> cinematica de
7143+ C6E6                  ; captura corre sin interferencia). Se limpia al cambiar de sala.
7144+ C6E6 3A 01 83         LD A, (DeathInhibitInRoom)
7145+ C6E9 B7               OR A
7146+ C6EA C0               RET NZ
7147+ C6EB                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
7148+ C6EB                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
7149+ C6EB                  ; arranca de cero al recuperar el control (urb1LastBeat).
7150+ C6EB 3A EF 82         LD A, (DeathBorderPhase)
7151+ C6EE B7               OR A
7152+ C6EF C0               RET NZ
7153+ C6F0 3A F3 82         LD A, (PlayerRespawnPhase)
7154+ C6F3 FE 01            CP 1
7155+ C6F5 C8               RET Z
7156+ C6F6                  ; Death aparece normalmente desde medianoche en adelante, en cualquier
7157+ C6F6                  ; sala. NO bloqueamos por MonstersActive — eso era confundir "monsters
7158+ C6F6                  ; activos en general" con "fase del cutscene de trampa de iglesia",
7159+ C6F6                  ; cosas distintas. Si el player esta en cutscene de iglesia su input
7160+ C6F6                  ; ya esta congelado, asi que Death no presiona ahi tampoco.
7161+ C6F6 2A FF 82         LD HL, (DeathScreenTimer)
7162+ C6F9 11 FA 00         LD DE, DEATH_SPAWN_FRAMES
7163+ C6FC E5               PUSH HL
7164+ C6FD B7               OR A
7165+ C6FE ED 52            SBC HL, DE
7166+ C700 E1               POP HL
7167+ C701 30 0D            JR NC, .udtTrySpawn                 ; HL >= threshold (caso reintento)
7168+ C703 23               INC HL
7169+ C704 22 FF 82         LD (DeathScreenTimer), HL
7170+ C707 E5               PUSH HL
7171+ C708 11 FA 00         LD DE, DEATH_SPAWN_FRAMES
7172+ C70B B7               OR A
7173+ C70C ED 52            SBC HL, DE
7174+ C70E E1               POP HL
7175+ C70F D8               RET C                               ; HL < threshold
7176+ C710              .udtTrySpawn:
7177+ C710 C3 7D C6         JP SpawnDeath
