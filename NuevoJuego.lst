 215+ 84FE              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 216+ 84FE              ; ==============================================================================
 217+ 84FE              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 218+ 84FE              ; Se llama ANTES de pintar el sprite.
 219+ 84FE              ;
 220+ 84FE              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 221+ 84FE              ;          IX = puntero al sprite (para leer width/height)
 222+ 84FE              ; ==============================================================================
 223+ 84FE              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 224+ 84FE              ; ==============================================================================
 225+ 84FE              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 226+ 84FE              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 227+ 84FE              ; ==============================================================================
 228+ 84FE              CalcEntityAttrSize:
 229+ 84FE DD 7E 00         LD A, (IX+0)                ; width_bytes
 230+ 8501 47               LD B, A
 231+ 8502 7B               LD A, E
 232+ 8503 E6 07            AND 7
 233+ 8505 28 01            JR Z, .ceNoExtra
 234+ 8507 04               INC B
 235+ 8508              .ceNoExtra:
 236+ 8508 78               LD A, B
 237+ 8509 32 8F 85         LD (EntityAttrW), A
 238+ 850C 7A               LD A, D
 239+ 850D E6 07            AND 7
 240+ 850F 4F               LD C, A
 241+ 8510 DD 7E 01         LD A, (IX+1)                ; height_pixels
 242+ 8513 81               ADD A, C
 243+ 8514 C6 07            ADD A, 7
 244+ 8516 0F               RRCA
 245+ 8517 0F               RRCA
 246+ 8518 0F               RRCA
 247+ 8519 E6 1F            AND $1F
 248+ 851B 32 90 85         LD (EntityAttrH), A
 249+ 851E C9               RET
