   1+ 877D              ; ==============================================================================
   2+ 877D              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 877D              ; ==============================================================================
   4+ 877D              ; Sistema fiel a Sabre Wulf:
   5+ 877D              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 877D              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 877D              ; - NextPixelLine para cruzar character rows y tercios
   8+ 877D              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 877D              ; ==============================================================================
  10+ 877D
  11+ 877D              ClearScreen:
  12+ 877D CD AF 0D         CALL ROM_CLS
  13+ 8780 C9               RET
  14+ 8781
  15+ 8781              ; ==============================================================================
  16+ 8781              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 8781              ; ==============================================================================
  18+ 8781              ; Entrada:
  19+ 8781              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 8781              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 8781              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 8781              ;
  23+ 8781              ; Formato del sprite:
  24+ 8781              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 8781              ;   DEFB height_pixels
  26+ 8781              ;   DEFB pixel_data... (width * height bytes)
  27+ 8781              ;
  28+ 8781              ; Dos paths:
  29+ 8781              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 8781              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 8781              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 8781              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 8781              ;
  34+ 8781              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 8781              ; ==============================================================================
  36+ 8781              DrawSprite:
  37+ 8781                  ; Guardar posicion
  38+ 8781 7A               LD A, D
  39+ 8782 32 3B 88         LD (.posY), A
  40+ 8785 7B               LD A, E
  41+ 8786 32 3A 88         LD (.posX), A
  42+ 8789
  43+ 8789                  ; Leer cabecera sprite
  44+ 8789 DD 7E 00         LD A, (IX+0)                ; width_bytes
  45+ 878C 32 3C 88         LD (.widthSave), A
  46+ 878F DD 7E 01         LD A, (IX+1)                ; height_pixels
  47+ 8792 32 3D 88         LD (.heightSave), A
  48+ 8795 DD 23            INC IX
  49+ 8797 DD 23            INC IX                      ; IX → pixel data
  50+ 8799
  51+ 8799                  ; === Y CLIPPING ===
  52+ 8799                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  53+ 8799 3A 3B 88         LD A, (.posY)
  54+ 879C FE 10            CP SCREEN_MIN_Y
  55+ 879E 30 20            JR NC, .clipTopDone
  56+ 87A0                  ; Filas a saltar = SCREEN_MIN_Y - Y
  57+ 87A0 47               LD B, A                     ; B = Y
  58+ 87A1 3E 10            LD A, SCREEN_MIN_Y
  59+ 87A3 90               SUB B                       ; A = filas a saltar
  60+ 87A4 47               LD B, A                     ; B = skip rows
  61+ 87A5                  ; Reducir altura
  62+ 87A5 3A 3D 88         LD A, (.heightSave)
  63+ 87A8 90               SUB B
  64+ 87A9 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  65+ 87AA D8               RET C                       ; Idem
  66+ 87AB 32 3D 88         LD (.heightSave), A
  67+ 87AE                  ; Avanzar IX: skip_rows * width_bytes
  68+ 87AE 3A 3C 88         LD A, (.widthSave)
  69+ 87B1 4F               LD C, A
  70+ 87B2              .clipSkipRow:
  71+ 87B2 79               LD A, C
  72+ 87B3              .clipSkipByte:
  73+ 87B3 DD 23            INC IX
  74+ 87B5 3D               DEC A
  75+ 87B6 20 FB            JR NZ, .clipSkipByte
  76+ 87B8 10 F8            DJNZ .clipSkipRow
  77+ 87BA                  ; Ajustar Y al borde
  78+ 87BA 3E 10            LD A, SCREEN_MIN_Y
  79+ 87BC 32 3B 88         LD (.posY), A
  80+ 87BF 57               LD D, A
  81+ 87C0              .clipTopDone:
  82+ 87C0                  ; Clip inferior: si Y + height > 192, reducir altura
  83+ 87C0 3A 3B 88         LD A, (.posY)
  84+ 87C3 47               LD B, A
  85+ 87C4 3A 3D 88         LD A, (.heightSave)
  86+ 87C7 80               ADD A, B                    ; A = Y + height
  87+ 87C8 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
  88+ 87CA FE C0            CP 192
  89+ 87CC 38 08            JR C, .clipBotDone          ; Dentro de pantalla
  90+ 87CE              .clipBot:
  91+ 87CE                  ; Reducir altura: new_height = 192 - Y
  92+ 87CE 3E C0            LD A, 192
  93+ 87D0 90               SUB B                       ; A = 192 - Y
  94+ 87D1 C8               RET Z
  95+ 87D2 D8               RET C
  96+ 87D3 32 3D 88         LD (.heightSave), A
  97+ 87D6              .clipBotDone:
  98+ 87D6
  99+ 87D6                  ; Comprobar alineacion
 100+ 87D6 7B               LD A, E
 101+ 87D7 E6 07            AND 7
 102+ 87D9 20 1E            JR NZ, .shifted
 103+ 87DB
 104+ 87DB                  ; ==================================================================
 105+ 87DB                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 106+ 87DB                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 107+ 87DB                  ; ==================================================================
 108+ 87DB CD 94 8A         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 109+ 87DE DD E5            PUSH IX
 110+ 87E0 D1               POP DE                      ; DE = puntero a pixel data
 111+ 87E1 3A 3D 88         LD A, (.heightSave)
 112+ 87E4 4F               LD C, A                     ; C = height counter
 113+ 87E5
 114+ 87E5              .alignedLine:
 115+ 87E5 3A 3C 88         LD A, (.widthSave)
 116+ 87E8 47               LD B, A                     ; B = ancho en bytes
 117+ 87E9 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 118+ 87EA
 119+ 87EA              .alignedByte:
 120+ 87EA 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 121+ 87EB AE               XOR (HL)
 122+ 87EC 77               LD (HL), A
 123+ 87ED 23               INC HL                      ; Siguiente columna VRAM
 124+ 87EE 13               INC DE                      ; 6T (era INC IX = 10T)
 125+ 87EF 10 F9            DJNZ .alignedByte
 126+ 87F1
 127+ 87F1 E1               POP HL                      ; Restaurar inicio de linea
 128+ 87F2 0D               DEC C
 129+ 87F3 C8               RET Z                       ; Terminamos todas las lineas
 130+ 87F4 CD 40 88         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 131+ 87F7 18 EC            JR .alignedLine
 132+ 87F9
 133+ 87F9                  ; ==================================================================
 134+ 87F9                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 135+ 87F9                  ; ==================================================================
 136+ 87F9                  ; A = shift amount (1-7) al llegar aqui
 137+ 87F9              .shifted:
 138+ 87F9                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 139+ 87F9 3D               DEC A                       ; 0-6
 140+ 87FA 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 141+ 87FB E6 0E            AND $0E
 142+ 87FD F6 D0            OR SHIFT_TABLE_BASE         ; Base de tablas
 143+ 87FF 32 3E 88         LD (.tablePage), A
 144+ 8802
 145+ 8802                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 146+ 8802 DD E5            PUSH IX
 147+ 8804 D1               POP DE                      ; DE = puntero a pixel data
 148+ 8805 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 149+ 8806
 150+ 8806                  ; Recargar D=Y, E=X para CalcPixelAddr
 151+ 8806 3A 3B 88         LD A, (.posY)
 152+ 8809 57               LD D, A
 153+ 880A 3A 3A 88         LD A, (.posX)
 154+ 880D 5F               LD E, A
 155+ 880E CD 94 8A         CALL CalcPixelAddr          ; HL = dir VRAM
 156+ 8811
 157+ 8811 D1               POP DE                      ; DE = sprite data ptr restaurado
 158+ 8812 3A 3E 88         LD A, (.tablePage)
 159+ 8815 47               LD B, A                     ; B = pagina high part
 160+ 8816                  ; Contadores en IX (libre: se convirtio a DE arriba)
 161+ 8816                  ; IXH = height counter, IXL = width counter (reset cada linea)
 162+ 8816 3A 3D 88         LD A, (.heightSave)
 163+ 8819 DD 67            LD IXH, A
 164+ 881B
 165+ 881B              .shiftedLine:
 166+ 881B E5               PUSH HL                     ; Guardar inicio de linea
 167+ 881C 3A 3C 88         LD A, (.widthSave)
 168+ 881F DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 169+ 8821
 170+ 8821              .shiftedByte:
 171+ 8821                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 172+ 8821 1A               LD A, (DE)                  ; Leer byte de sprite
 173+ 8822 4F               LD C, A                     ; C = byte value (indice en tabla)
 174+ 8823 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 175+ 8824 AE               XOR (HL)                    ; XOR con VRAM
 176+ 8825 77               LD (HL), A                  ; Escribir
 177+ 8826 2C               INC L                       ; Siguiente columna VRAM
 178+ 8827 04               INC B                       ; Pagina overflow
 179+ 8828 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 180+ 8829 AE               XOR (HL)                    ; XOR con VRAM
 181+ 882A 77               LD (HL), A                  ; Escribir
 182+ 882B 05               DEC B                       ; Restaurar pagina high
 183+ 882C 13               INC DE                      ; Siguiente byte de sprite
 184+ 882D                  ; Siguiente byte de ancho
 185+ 882D DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 186+ 882F 20 F0            JR NZ, .shiftedByte         ; 12/7T
 187+ 8831
 188+ 8831 E1               POP HL                      ; Restaurar inicio de linea
 189+ 8832 DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 190+ 8834 C8               RET Z                       ; Terminamos todas las lineas
 191+ 8835 CD 40 88         CALL NextPixelLine          ; HL = siguiente linea
 192+ 8838 18 E1            JR .shiftedLine
