 223+ EC75                  ; --- Aguja de minutos ---
 224+ EC75 3A 5D EA         LD A, (GameMinutes)
 225+ EC78 06 00            LD B, 0
 226+ EC7A              .divMin:
 227+ EC7A FE 05            CP 5
 228+ EC7C 38 05            JR C, .minOk
 229+ EC7E D6 05            SUB 5
 230+ EC80 04               INC B
 231+ EC81 18 F7            JR .divMin
 232+ EC83              .minOk:
 233+ EC83 78               LD A, B
 234+ EC84 21 76 EA         LD HL, MinHandPtrs
 235+ EC87 CD 74 EE         CALL DrawHandLine
