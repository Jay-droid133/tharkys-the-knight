 686+ ED27              ; ==============================================================================
 687+ ED27              ; UpdateRandomPickup - room-enter hook
 688+ ED27              ; ==============================================================================
 689+ ED27              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 690+ ED27              ; Early-out si ScreenDirty=0 (no transition).
 691+ ED27              ;
 692+ ED27              ; En transition:
 693+ ED27              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 694+ ED27              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 695+ ED27              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 696+ ED27              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 697+ ED27              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 698+ ED27              ;
 699+ ED27              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 700+ ED27              ; fijos (id, charX, charY, v) terminados con id=$FF.
 701+ ED27              ;
 702+ ED27              ; Destruye AF, BC, DE, HL.
 703+ ED27              ; ==============================================================================
 704+ ED27              UpdateRandomPickupBody:
 705+ ED27 3A 18 83         LD A, (ScreenDirty)
 706+ ED2A B7               OR A
 707+ ED2B C8               RET Z
 708+ ED2C
 709+ ED2C                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 710+ ED2C 3E FE            LD A, $FE
 711+ ED2E 32 B4 5F         LD (RandomSynthMapX), A
 712+ ED31 AF               XOR A
 713+ ED32 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 714+ ED35
 715+ ED35                  ; --- Scan BG stream, build SlotList ---
 716+ ED35 AF               XOR A
 717+ ED36 32 AB 5F         LD (RandomSlotCount), A
 718+ ED39 2A 12 83         LD HL, (CurrentScreenAddr)
 719+ ED3C              .urpScanLoop:
 720+ ED3C 7E               LD A, (HL)                          ; A = id
 721+ ED3D FE FF            CP $FF
 722+ ED3F 28 2A            JR Z, .urpScanDone
 723+ ED41 FE D2            CP RANDOM_SLOT_MARKER
 724+ ED43 20 20            JR NZ, .urpSkipEntry
 725+ ED45                  ; Es marker. Cap reached?
 726+ ED45 3A AB 5F         LD A, (RandomSlotCount)
 727+ ED48 FE 04            CP RANDOM_SLOT_MAX
 728+ ED4A 30 19            JR NC, .urpSkipEntry
 729+ ED4C                  ; SlotList[count*2] = charX, [count*2+1] = charY
 730+ ED4C 23               INC HL                              ; HL @ charX
 731+ ED4D 46               LD B, (HL)                          ; B = charX
 732+ ED4E 23               INC HL                              ; HL @ charY
 733+ ED4F 4E               LD C, (HL)                          ; C = charY
 734+ ED50 E5               PUSH HL                             ; save HL @ charY
 735+ ED51 87               ADD A, A                            ; A = count*2
 736+ ED52 6F               LD L, A
 737+ ED53 26 00            LD H, 0
 738+ ED55 11 AC 5F         LD DE, RandomSlotList
 739+ ED58 19               ADD HL, DE
 740+ ED59 70               LD (HL), B                          ; charX
 741+ ED5A 23               INC HL
 742+ ED5B 71               LD (HL), C                          ; charY
 743+ ED5C 21 AB 5F         LD HL, RandomSlotCount
 744+ ED5F 34               INC (HL)
 745+ ED60 E1               POP HL                              ; HL @ charY
 746+ ED61 23               INC HL                              ; HL @ v
 747+ ED62 23               INC HL                              ; HL @ next id
 748+ ED63 18 D7            JR .urpScanLoop
 749+ ED65              .urpSkipEntry:
 750+ ED65                  ; Skip entry: 4 bytes (id, charX, charY, v).
 751+ ED65 23               INC HL
 751+ ED66 23             INC HL
 751+ ED67 23             INC HL
 751+ ED68 23             INC HL
 752+ ED69 18 D1            JR .urpScanLoop
 753+ ED6B              .urpScanDone:
 754+ ED6B
 755+ ED6B                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 756+ ED6B 3A AB 5F         LD A, (RandomSlotCount)
 757+ ED6E B7               OR A
 758+ ED6F CA 18 EF         JP Z, .urpZeroAndRotate
 759+ ED72
 760+ ED72                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 761+ ED72                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 762+ ED72                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 763+ ED72 3A 11 83         LD A, (CurrentScreenY)
 764+ ED75 07               RLCA
 764+ ED76 07             RLCA
 764+ ED77 07             RLCA
 764+ ED78 07             RLCA           ; Y*16
 765+ ED79 21 10 83         LD HL, CurrentScreenX
 766+ ED7C 86               ADD A, (HL)                         ; A = newSid
 767+ ED7D 47               LD B, A                             ; B = newSid (preservar)
 768+ ED7E 3A D1 5F         LD A, (RP_PrevSid)
 769+ ED81 B8               CP B
 770+ ED82 20 1A            JR NZ, .urpCacheMiss
 771+ ED84                  ; HIT prev. Validar slot < count.
 772+ ED84 3A D2 5F         LD A, (RP_PrevSlot)
