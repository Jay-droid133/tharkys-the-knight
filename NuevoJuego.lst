 549+ ACDD DD 7E 00         LD A, (IX+0)                ; tintPaper (255=not tintable)
 550+ ACE0 32 2B AD         LD (CurrentTintPaper), A
 551+ ACE3 DD 23            INC IX
 552+ ACE5
 553+ ACE5                  ; --- Pintar atributos ---
 554+ ACE5 DD 7E 00         LD A, (IX+0)                ; attr_h
 555+ ACE8 B7               OR A
 556+ ACE9 C8               RET Z
 557+ ACEA 5F               LD E, A                     ; E = filas de atributos
 558+ ACEB DD 7E 01         LD A, (IX+1)                ; attr_w
 559+ ACEE 57               LD D, A                     ; D = columnas de atributos
 560+ ACEF DD 23            INC IX
 561+ ACF1 DD 23            INC IX                      ; IX -> attr data
 562+ ACF3
 563+ ACF3                  ; Calcular dir atributos: ATTR_BASE + y_char*32 + x_char
 564+ ACF3 3A 29 AD         LD A, (.yChar)
 565+ ACF6 6F               LD L, A
 566+ ACF7 26 00            LD H, 0
 567+ ACF9 29               ADD HL, HL
 568+ ACFA 29               ADD HL, HL
 569+ ACFB 29               ADD HL, HL
 570+ ACFC 29               ADD HL, HL
 571+ ACFD 29               ADD HL, HL                  ; HL = y_char * 32
 572+ ACFE 3A 28 AD         LD A, (.xChar)
