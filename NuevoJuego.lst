 188+ E4FD                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E4FD 3E FD            LD A, $FD
 190+ E4FF DB FE            IN A, ($FE)
 191+ E501 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E502 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E504 20 13            JR NZ, .sNotPressed
 194+ E506 3A 54 E5         LD A, (SpeedKeyDebounce)
 195+ E509 B7               OR A
 196+ E50A C0               RET NZ
 197+ E50B 3E 01            LD A, 1
 198+ E50D 32 54 E5         LD (SpeedKeyDebounce), A
 199+ E510 21 63 BD         LD HL, DayCycleCount
 200+ E513 7E               LD A, (HL)
 201+ E514 FE 0A            CP 10
 202+ E516 D0               RET NC                  ; Ya en maximo
 203+ E517 34               INC (HL)
 204+ E518 C9               RET
 205+ E519              .sNotPressed:
 206+ E519                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E519 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E51B 20 13            JR NZ, .dNotPressed
 209+ E51D 3A 54 E5         LD A, (SpeedKeyDebounce)
 210+ E520 B7               OR A
 211+ E521 C0               RET NZ
 212+ E522 3E 01            LD A, 1
 213+ E524 32 54 E5         LD (SpeedKeyDebounce), A
 214+ E527 21 63 BD         LD HL, DayCycleCount
 215+ E52A 7E               LD A, (HL)
 216+ E52B FE 01            CP 1
 217+ E52D C8               RET Z                   ; Ya en minimo
 218+ E52E 35               DEC (HL)
 219+ E52F C9               RET
 220+ E530              .dNotPressed:
 221+ E530 AF               XOR A
 222+ E531 32 54 E5         LD (SpeedKeyDebounce), A
