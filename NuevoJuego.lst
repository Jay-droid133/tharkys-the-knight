2641+ B174              ; ==============================================================================
2642+ B174              ; ==============================================================================
2643+ B174              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2644+ B174              ; ==============================================================================
2645+ B174              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2646+ B174              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2647+ B174              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2648+ B174              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2649+ B174              ; ==============================================================================
2650+ B174              UpdateMonster:
2651+ B174                  ; --- Stun: knockback + pausa tras golpe del player ---
2652+ B174 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2653+ B177 B7               OR A
2654+ B178 CA AD B3         JP Z, .moNormal
2655+ B17B DD 35 0A         DEC (IX+ENT_DIR)
2656+ B17E 20 0B            JR NZ, .moStunActive
2657+ B180                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2658+ B180 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2659+ B184 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2660+ B188 C3 AD B3         JP .moNormal
2661+ B18B
2662+ B18B              .moStunActive:
2663+ B18B                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2664+ B18B FE 06            CP MONSTER_STUN_PAUSE
2665+ B18D DA 37 B5         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2666+ B190                  ; Knockback: aplicar movimiento con collision check
2667+ B190 DD 56 06         LD D, (IX+ENT_DELTAX)
2668+ B193 DD 5E 07         LD E, (IX+ENT_DELTAY)
2669+ B196 7A               LD A, D
2670+ B197 B3               OR E
2671+ B198 CA 37 B5         JP Z, .moAnimate
2672+ B19B                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2673+ B19B D5               PUSH DE
2674+ B19C DD 7E 03         LD A, (IX+ENT_POSX)
2675+ B19F 32 C8 B6         LD (.moSvX), A
2676+ B1A2 DD 7E 04         LD A, (IX+ENT_POSY)
2677+ B1A5 32 C9 B6         LD (.moSvY), A
2678+ B1A8                  ; Calcular nueva posicion
2679+ B1A8 DD 7E 03         LD A, (IX+ENT_POSX)
2680+ B1AB 82               ADD A, D
2681+ B1AC DD 77 03         LD (IX+ENT_POSX), A
2682+ B1AF DD 7E 04         LD A, (IX+ENT_POSY)
2683+ B1B2 83               ADD A, E
2684+ B1B3 DD 77 04         LD (IX+ENT_POSY), A
2685+ B1B6                  ; Comprobar bordes ANTES de colision con paredes
2686+ B1B6 DD 7E 03         LD A, (IX+ENT_POSX)
2687+ B1B9 FE E8            CP SCREEN_MAX_X
2688+ B1BB 30 30            JR NC, .moKbPreOffscreen
2689+ B1BD FE 04            CP MONSTER_KB_SPEED
2690+ B1BF 38 20            JR C, .moKbPreOffscreenMaybeX
2691+ B1C1              .moKbPreBorderXOk:
2692+ B1C1 DD 7E 04         LD A, (IX+ENT_POSY)
2693+ B1C4 FE A8            CP SCREEN_MAX_Y
2694+ B1C6 30 25            JR NC, .moKbPreOffscreen
2695+ B1C8 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2696+ B1CA 38 1B            JR C, .moKbPreOffscreenMaybeY
2697+ B1CC              .moKbPreBorderOk:
2698+ B1CC                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2699+ B1CC                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2700+ B1CC                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2701+ B1CC                  ; CheckEnemyCollision.
2702+ B1CC                  ; CheckChurchTrap retorna:
2703+ B1CC                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2704+ B1CC                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2705+ B1CC                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2706+ B1CC CD 16 F3         CALL CheckChurchTrap
2707+ B1CF B7               OR A
2708+ B1D0 28 07            JR Z, .moKbCollCheck
2709+ B1D2 FE 02            CP 2
2710+ B1D4 CA 85 B2         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2711+ B1D7 D1               POP DE                              ; limpiar PUSH DE previo
2712+ B1D8 C9               RET                                 ; cutscene activa, salir
2713+ B1D9              .moKbCollCheck:
2714+ B1D9                  ; Dentro de pantalla: comprobar colision con paredes
2715+ B1D9 CD 44 BA         CALL CheckEnemyCollision
2716+ B1DC C2 85 B2         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2717+ B1DF 18 1C            JR .moKbNotBlocked
2718+ B1E1              .moKbPreOffscreenMaybeX:
2719+ B1E1 CB 7A            BIT 7, D
2720+ B1E3 20 08            JR NZ, .moKbPreOffscreen
2721+ B1E5 18 DA            JR .moKbPreBorderXOk
2722+ B1E7              .moKbPreOffscreenMaybeY:
2723+ B1E7 CB 7B            BIT 7, E
2724+ B1E9 20 02            JR NZ, .moKbPreOffscreen
2725+ B1EB 18 DF            JR .moKbPreBorderOk
2726+ B1ED              .moKbPreOffscreen:
2727+ B1ED                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2728+ B1ED 3A C8 B6         LD A, (.moSvX)
2729+ B1F0 DD 77 03         LD (IX+ENT_POSX), A
2730+ B1F3 3A C9 B6         LD A, (.moSvY)
2731+ B1F6 DD 77 04         LD (IX+ENT_POSY), A
2732+ B1F9 D1               POP DE
2733+ B1FA C3 EA B2         JP .moKbOffscreen
2734+ B1FD              .moKbNotBlocked:
2735+ B1FD                  ; Pared libre: comprobar impacto con otro monster (billar)
2736+ B1FD CD C9 B5         CALL .moCheckOverlap
2737+ B200 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2738+ B202                  ; Libre: restaurar pos y aplicar movimiento
2739+ B202 3A C8 B6         LD A, (.moSvX)
2740+ B205 DD 77 03         LD (IX+ENT_POSX), A
2741+ B208 3A C9 B6         LD A, (.moSvY)
2742+ B20B DD 77 04         LD (IX+ENT_POSY), A
2743+ B20E D1               POP DE
2744+ B20F C3 C1 B2         JP .moKbApply
2745+ B212              .moKbBilliard:
2746+ B212                  ; Billar: A para en su sitio, B hereda la fuerza
2747+ B212 3A C8 B6         LD A, (.moSvX)
2748+ B215 DD 77 03         LD (IX+ENT_POSX), A
2749+ B218 3A C9 B6         LD A, (.moSvY)
2750+ B21B DD 77 04         LD (IX+ENT_POSY), A
2751+ B21E D1               POP DE
2752+ B21F                  ; Transferir knockback al monster impactado
2753+ B21F DD E5            PUSH IX
2754+ B221 DD 2A D2 B6      LD IX, (.moHitMonster)
2755+ B225                  ; Solo transferir si no esta ya en stun
2756+ B225 DD 7E 0A         LD A, (IX+ENT_DIR)
2757+ B228 B7               OR A
2758+ B229 20 2A            JR NZ, .moKbBilliardDone
2759+ B22B                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2760+ B22B 7A               LD A, D
2761+ B22C B7               OR A
2762+ B22D 28 0D            JR Z, .moBillNoX
2763+ B22F CB 7A            BIT 7, D
2764+ B231 20 04            JR NZ, .moBillXNeg
2765+ B233 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2766+ B235 18 02            JR .moBillSetX
2767+ B237              .moBillXNeg:
2768+ B237 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2769+ B239              .moBillSetX:
2770+ B239 DD 77 06         LD (IX+ENT_DELTAX), A
2771+ B23C              .moBillNoX:
2772+ B23C 7B               LD A, E
2773+ B23D B7               OR A
2774+ B23E 28 0D            JR Z, .moBillNoY
2775+ B240 CB 7B            BIT 7, E
2776+ B242 20 04            JR NZ, .moBillYNeg
2777+ B244 3E 03            LD A, MONSTER_KB_SPEED - 1
2778+ B246 18 02            JR .moBillSetY
2779+ B248              .moBillYNeg:
2780+ B248 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2781+ B24A              .moBillSetY:
2782+ B24A DD 77 07         LD (IX+ENT_DELTAY), A
2783+ B24D              .moBillNoY:
2784+ B24D DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2785+ B251                  ; Kb heredado por billar: NO es directo del player.
2786+ B251                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2787+ B251 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2788+ B255              .moKbBilliardDone:
2789+ B255 DD E1            POP IX
2790+ B257                  ; A continua con fuerza reducida (no para del todo)
2791+ B257                  ; Reducir velocidad de A a la mitad
2792+ B257 DD 7E 06         LD A, (IX+ENT_DELTAX)
2793+ B25A CB 2F            SRA A                               ; /2 con signo
2794+ B25C DD 77 06         LD (IX+ENT_DELTAX), A
2795+ B25F 57               LD D, A
2796+ B260 DD 7E 07         LD A, (IX+ENT_DELTAY)
2797+ B263 CB 2F            SRA A
2798+ B265 DD 77 07         LD (IX+ENT_DELTAY), A
2799+ B268 5F               LD E, A
2800+ B269                  ; Reducir stun restante de A
2801+ B269 DD 7E 0A         LD A, (IX+ENT_DIR)
2802+ B26C FE 08            CP MONSTER_STUN_PAUSE + 2
2803+ B26E DA A2 B3         JP C, .moStunStop                   ; Casi sin stun → parar
2804+ B271 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2805+ B273 DD 77 0A         LD (IX+ENT_DIR), A
2806+ B276                  ; Aplicar movimiento reducido de A
2807+ B276 3A C8 B6         LD A, (.moSvX)
2808+ B279 DD 77 03         LD (IX+ENT_POSX), A
2809+ B27C 3A C9 B6         LD A, (.moSvY)
2810+ B27F DD 77 04         LD (IX+ENT_POSY), A
2811+ B282 C3 C1 B2         JP .moKbApply
2812+ B285              .moKbWallBlock:
2813+ B285                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2814+ B285 3A C8 B6         LD A, (.moSvX)
2815+ B288 DD 77 03         LD (IX+ENT_POSX), A
2816+ B28B 3A C9 B6         LD A, (.moSvY)
2817+ B28E DD 77 04         LD (IX+ENT_POSY), A
2818+ B291 D1               POP DE
2819+ B292                  ; Intentar solo eje X (mantener direccion del golpe)
2820+ B292 7A               LD A, D
2821+ B293 B7               OR A
2822+ B294 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2823+ B296 D5               PUSH DE
2824+ B297 1E 00            LD E, 0
2825+ B299 CD 91 B5         CALL .moTryPassable
