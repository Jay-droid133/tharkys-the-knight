 218+ EEAB              ; ==============================================================================
 219+ EEAB              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 220+ EEAB              ; ==============================================================================
 221+ EEAB              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 222+ EEAB              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 223+ EEAB              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 224+ EEAB              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 225+ EEAB              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 226+ EEAB              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 227+ EEAB              ;               actuales; queda como salvaguarda.
 228+ EEAB              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 229+ EEAB              ; Destruye: AF, BC, DE, HL.
 230+ EEAB              ; ==============================================================================
 231+ EEAB              ResolveObjectiveScreen:
 232+ EEAB 3A B7 82         LD A, (CurrentObjective)
 233+ EEAE FE 0B            CP 11
 234+ EEB0 30 3E            JR NC, .rosNoTarget
 235+ EEB2 87               ADD A, A
 236+ EEB3 6F               LD L, A
 237+ EEB4 26 00            LD H, 0
 238+ EEB6 11 D8 ED         LD DE, MilestoneResolveTable
 239+ EEB9 19               ADD HL, DE
 240+ EEBA 7E               LD A, (HL)                          ; tipo
 241+ EEBB 23               INC HL
 242+ EEBC 46               LD B, (HL)                          ; B = ref
 243+ EEBD FE 01            CP MILESTONE_TYPE_PICKUP
 244+ EEBF 28 06            JR Z, .rosPickup
 245+ EEC1 FE 02            CP MILESTONE_TYPE_TRIGGER
 246+ EEC3 28 08            JR Z, .rosTrigger
 247+ EEC5 18 29            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 248+ EEC7              .rosPickup:
 249+ EEC7 78               LD A, B
 250+ EEC8 CD F9 EE         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 251+ EECB 18 0C            JR .rosFindPos
 252+ EECD              .rosTrigger:
 253+ EECD 78               LD A, B
 254+ EECE FE 04            CP 4
 255+ EED0 28 13            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 256+ EED2 CD 06 EF         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 257+ EED5 7A               LD A, D
 258+ EED6 B3               OR E
 259+ EED7 28 17            JR Z, .rosNoTarget
 260+ EED9              .rosFindPos:
 261+ EED9 CD 21 EF         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 262+ EEDC 78               LD A, B
 263+ EEDD 32 B8 82         LD (ObjectiveScreenX), A
 264+ EEE0 79               LD A, C
 265+ EEE1 32 B9 82         LD (ObjectiveScreenY), A
 266+ EEE4 C9               RET
 267+ EEE5              .rosBankRoom:
 268+ EEE5                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 269+ EEE5                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 270+ EEE5 3E 08            LD A, BCS_BANK_ROOM_X
 271+ EEE7 32 B8 82         LD (ObjectiveScreenX), A
 272+ EEEA 3E 08            LD A, BCS_BANK_ROOM_Y
 273+ EEEC 32 B9 82         LD (ObjectiveScreenY), A
 274+ EEEF C9               RET
 275+ EEF0              .rosNoTarget:
 276+ EEF0 3E FF            LD A, $FF
 277+ EEF2 32 B8 82         LD (ObjectiveScreenX), A
 278+ EEF5 32 B9 82         LD (ObjectiveScreenY), A
 279+ EEF8 C9               RET
