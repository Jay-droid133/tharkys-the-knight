 498  CCE7                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCE7              ; ==============================================================================
   2+ CCE7              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCE7              ; ==============================================================================
   4+ CCE7              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCE7              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCE7              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCE7              ; ==============================================================================
   8+ CCE7
   9+ CCE7              ; ==============================================================================
  10+ CCE7              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCE7              ; ==============================================================================
  12+ CCE7              InitScreenSystem:
  13+ CCE7 3E 0F            LD A, START_SCREEN_X
  14+ CCE9 32 0D 83         LD (CurrentScreenX), A
  15+ CCEC 3E 07            LD A, START_SCREEN_Y
  16+ CCEE 32 0E 83         LD (CurrentScreenY), A
  17+ CCF1 3E 01            LD A, 1
  18+ CCF3 32 15 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCF6 AF               XOR A
  20+ CCF7 32 11 83         LD (ScreenTransition), A
  21+ CCFA CD FE CC         CALL CalcScreenAddress
  22+ CCFD C9               RET
  23+ CCFE
  24+ CCFE              ; ==============================================================================
  25+ CCFE              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CCFE              ; ==============================================================================
  27+ CCFE              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CCFE              ; ==============================================================================
  29+ CCFE              CalcScreenAddress:
  30+ CCFE 3A 0E 83         LD A, (CurrentScreenY)
  31+ CD01 6F               LD L, A
  32+ CD02 26 00            LD H, 0
  33+ CD04 29               ADD HL, HL                  ; x2
  34+ CD05 29               ADD HL, HL                  ; x4
  35+ CD06 29               ADD HL, HL                  ; x8
  36+ CD07 29               ADD HL, HL                  ; x16
  37+ CD08 3A 0D 83         LD A, (CurrentScreenX)
  38+ CD0B 5F               LD E, A
  39+ CD0C 16 00            LD D, 0
  40+ CD0E 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CD0F 11 28 DE         LD DE, MapTable
  42+ CD12 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CD13 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CD14                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CD14 6F               LD L, A
  46+ CD15 26 00            LD H, 0
  47+ CD17 29               ADD HL, HL                  ; index * 2
  48+ CD18 11 F6 DC         LD DE, RoomTable
  49+ CD1B 19               ADD HL, DE
  50+ CD1C 5E               LD E, (HL)
  51+ CD1D 23               INC HL
  52+ CD1E 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CD1F                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CD1F EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CD20 CD 7A 67         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CD23                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CD23 11 FA 85         LD DE, CurrentScreenBuffer
  58+ CD26 ED 53 0F 83      LD (CurrentScreenAddr), DE
  59+ CD2A C9               RET
  60+ CD2B
  61+ CD2B              ; ==============================================================================
  62+ CD2B              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CD2B              ; ==============================================================================
  64+ CD2B              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CD2B              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CD2B              ; por estar atrapado cerca del borde.
  67+ CD2B              ; ==============================================================================
  68+ CD2B              CheckScreenTransition:
  69+ CD2B AF               XOR A
  70+ CD2C 32 11 83         LD (ScreenTransition), A
  71+ CD2F
  72+ CD2F                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CD2F                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CD2F                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CD2F                  ; dispararia transicion sur en plena animacion.
  76+ CD2F 3A CD 82         LD A, (TownGatePhase)
  77+ CD32 B7               OR A
  78+ CD33 C0               RET NZ
  79+ CD34
  80+ CD34                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CD34                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CD34                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CD34                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CD34                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CD34                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CD34 3A B8 82         LD A, (TimeFrozen)
  87+ CD37 B7               OR A
  88+ CD38 28 23            JR Z, .cstNotFrozen
  89+ CD3A 3A B0 82         LD A, (InputDirection)
  90+ CD3D CB 4F            BIT 1, A                    ; S
  91+ CD3F 28 17            JR Z, .cstClearBlockFlag
  92+ CD41 3A A4 81         LD A, (EntityTable + ENT_POSY)
  93+ CD44 FE A8            CP SCREEN_MAX_Y
  94+ CD46 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD48                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD48 3A B9 82         LD A, (BlockedExitSoundFlag)
  97+ CD4B B7               OR A
  98+ CD4C C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD4D 3E 01            LD A, 1
 100+ CD4F 32 B9 82         LD (BlockedExitSoundFlag), A
 101+ CD52 21 96 FA         LD HL, SFX_BlockedExit
 102+ CD55 C3 69 F9         JP PlaySFX                  ; tail call
 103+ CD58              .cstClearBlockFlag:
 104+ CD58 AF               XOR A
 105+ CD59 32 B9 82         LD (BlockedExitSoundFlag), A
 106+ CD5C C9               RET
 107+ CD5D              .cstNotFrozen:
 108+ CD5D                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD5D AF               XOR A
 110+ CD5E 32 B9 82         LD (BlockedExitSoundFlag), A
 111+ CD61
 112+ CD61 3A B0 82         LD A, (InputDirection)
 113+ CD64 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CD65
 115+ CD65                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CD65 CB 5A            BIT 3, D                    ; W
 117+ CD67 CA C8 CD         JP Z, .noWest
 118+ CD6A 3A A3 81         LD A, (EntityTable + ENT_POSX)
 119+ CD6D FE 04            CP TRANSITION_ZONE
 120+ CD6F D2 C8 CD         JP NC, .noWest
 121+ CD72 3A 0D 83         LD A, (CurrentScreenX)
 122+ CD75 B7               OR A
 123+ CD76 CA C8 CD         JP Z, .noWest
 124+ CD79                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CD79 06 00            LD B, 0
 126+ CD7B 3A A4 81         LD A, (EntityTable + ENT_POSY)
 127+ CD7E 4F               LD C, A
 128+ CD7F CD CA D5         CALL IsPointBlocked
 129+ CD82 C2 C8 CD         JP NZ, .noWest
 130+ CD85 06 00            LD B, 0
 131+ CD87 3A A4 81         LD A, (EntityTable + ENT_POSY)
 132+ CD8A C6 0A            ADD A, 10
 133+ CD8C 4F               LD C, A
 134+ CD8D CD CA D5         CALL IsPointBlocked
 135+ CD90 C2 C8 CD         JP NZ, .noWest
 136+ CD93 06 00            LD B, 0
 137+ CD95 3A A4 81         LD A, (EntityTable + ENT_POSY)
 138+ CD98 C6 14            ADD A, 20
 139+ CD9A 4F               LD C, A
 140+ CD9B CD CA D5         CALL IsPointBlocked
 141+ CD9E C2 C8 CD         JP NZ, .noWest
 142+ CDA1 3A 0D 83         LD A, (CurrentScreenX)
 143+ CDA4 3D               DEC A
 144+ CDA5 32 0D 83         LD (CurrentScreenX), A
 145+ CDA8 3E 08            LD A, DIR_W
 146+ CDAA 32 11 83         LD (ScreenTransition), A
 147+ CDAD 3E 03            LD A, 3                             ; entró por E (cruzó W) → side 3 = E
 148+ CDAF 32 CA 5F         LD (LastEntrySide), A
 149+ CDB2                  ; LastEntryCoord = (POSY - 16) / 8 (charY top-left aprox)
 150+ CDB2 3A A4 81         LD A, (EntityTable + ENT_POSY)
 151+ CDB5 D6 10            SUB 16
 152+ CDB7 CB 3F            SRL A
 152+ CDB9 CB 3F          SRL A
 152+ CDBB CB 3F          SRL A
 153+ CDBD 32 CB 5F         LD (LastEntryCoord), A
 154+ CDC0 3E E8            LD A, SCREEN_MAX_X
 155+ CDC2 32 A3 81         LD (EntityTable + ENT_POSX), A
 156+ CDC5 C3 EF CE         JP .doTransition
 157+ CDC8
 158+ CDC8              .noWest:
 159+ CDC8                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 160+ CDC8 CB 52            BIT 2, D                    ; E
 161+ CDCA CA 2C CE         JP Z, .noEast
 162+ CDCD 3A A3 81         LD A, (EntityTable + ENT_POSX)
 163+ CDD0 FE E8            CP SCREEN_MAX_X
 164+ CDD2 DA 2C CE         JP C, .noEast
 165+ CDD5 3A 0D 83         LD A, (CurrentScreenX)
 166+ CDD8 FE 0F            CP MAP_WIDTH - 1
 167+ CDDA CA 2C CE         JP Z, .noEast
 168+ CDDD                  ; Check collision at col 31 (top + mid + bottom del player)
 169+ CDDD 06 F8            LD B, 248
 170+ CDDF 3A A4 81         LD A, (EntityTable + ENT_POSY)
 171+ CDE2 4F               LD C, A
 172+ CDE3 CD CA D5         CALL IsPointBlocked
 173+ CDE6 C2 2C CE         JP NZ, .noEast
 174+ CDE9 06 F8            LD B, 248
 175+ CDEB 3A A4 81         LD A, (EntityTable + ENT_POSY)
 176+ CDEE C6 0A            ADD A, 10
 177+ CDF0 4F               LD C, A
 178+ CDF1 CD CA D5         CALL IsPointBlocked
 179+ CDF4 C2 2C CE         JP NZ, .noEast
 180+ CDF7 06 F8            LD B, 248
 181+ CDF9 3A A4 81         LD A, (EntityTable + ENT_POSY)
 182+ CDFC C6 14            ADD A, 20
 183+ CDFE 4F               LD C, A
 184+ CDFF CD CA D5         CALL IsPointBlocked
 185+ CE02 C2 2C CE         JP NZ, .noEast
 186+ CE05 3A 0D 83         LD A, (CurrentScreenX)
 187+ CE08 3C               INC A
 188+ CE09 32 0D 83         LD (CurrentScreenX), A
