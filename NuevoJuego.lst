1341+ D3EC DD 23            INC IX
1342+ D3EE 10 FC            DJNZ .spRleLitSkip
1343+ D3F0 18 E8            JR .spRleLoop
1344+ D3F2              .spRleRun:
1345+ D3F2                  ; Run: consume (A & $7F)+2 pixeles, saltar 1 byte valor
1346+ D3F2 E6 7F            AND $7F
1347+ D3F4 C6 02            ADD A, 2
1348+ D3F6 5F               LD E, A
1349+ D3F7 16 00            LD D, 0
1350+ D3F9 ED 52            SBC HL, DE                  ; HL -= count
1351+ D3FB DD 23            INC IX                      ; saltar byte valor
1352+ D3FD 18 DB            JR .spRleLoop
