 249+ EA24              ; ==============================================================================
 250+ EA24              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 251+ EA24              ; ==============================================================================
 252+ EA24              ; IN:  A = key id (1..6)
 253+ EA24              ; OUT: DE = ptr
 254+ EA24              ; Destruye: AF, HL.
 255+ EA24              ; ==============================================================================
 256+ EA24              KeyIdToPtr:
 257+ EA24 3D               DEC A
 258+ EA25 87               ADD A, A                            ; *2 (DEFW size)
 259+ EA26 6F               LD L, A
 260+ EA27 26 00            LD H, 0
 261+ EA29 11 BD D2         LD DE, KeyLockTable
 262+ EA2C 19               ADD HL, DE
 263+ EA2D 5E               LD E, (HL)
 264+ EA2E 23               INC HL
 265+ EA2F 56               LD D, (HL)
 266+ EA30 C9               RET
 267+ EA31
 268+ EA31              ; ==============================================================================
 269+ EA31              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 270+ EA31              ; ==============================================================================
 271+ EA31              ; IN:  A = action id (1, 2, ...)
 272+ EA31              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 273+ EA31              ;      Z flag set si no encontrado.
 274+ EA31              ; Destruye: AF, BC, HL.
 275+ EA31              ; ==============================================================================
 276+ EA31              ActionToTriggerPtr:
 277+ EA31 4F               LD C, A                             ; C = action id buscada
 278+ EA32 21 4B D3         LD HL, BumpTriggerTable
 279+ EA35              .attLoop:
 280+ EA35 5E               LD E, (HL)
 281+ EA36 23               INC HL
 282+ EA37 56               LD D, (HL)
 283+ EA38 23               INC HL                              ; HL -> required_key
 284+ EA39 7A               LD A, D
 285+ EA3A B3               OR E
 286+ EA3B 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 287+ EA3D 23               INC HL                              ; HL -> action
 288+ EA3E 7E               LD A, (HL)
 289+ EA3F 23               INC HL                              ; HL -> next entry
 290+ EA40 B9               CP C
 291+ EA41 20 F2            JR NZ, .attLoop
 292+ EA43 F6 01            OR 1                                ; clear Z (encontrado)
 293+ EA45 C9               RET
 294+ EA46              .attNotFound:
 295+ EA46 16 00            LD D, 0
 296+ EA48 1E 00            LD E, 0
 297+ EA4A AF               XOR A                               ; set Z
 298+ EA4B C9               RET
