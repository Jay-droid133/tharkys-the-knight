1582+ F7A5              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1583+ F7A5              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1584+ F7A5              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1585+ F7A5              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1586+ F7A5              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1587+ F7A5              ; ==============================================================================
1588+ F7A5              CompassWobbleTable:
1589+ F7A5 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1590+ F7A9 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1591+ F7AD 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1592+ F7B1 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1593+ F7B5 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1594+ F7B9 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1595+ F7BD 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1596+ F7C1 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1597+ F7C5 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
