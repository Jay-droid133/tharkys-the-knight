 351+ 743A              .pmcaDirToOffset:
 352+ 743A 01               DEFB $01                             ; 0 (N) → col 2 row 1 → +1
 353+ 743B 20               DEFB $20                             ; 1 (S) → col 1 row 2 → +$20
 354+ 743C 00               DEFB $00                             ; 2 (W) → col 1 row 1 → +0
 355+ 743D 21               DEFB $21                             ; 3 (E) → col 2 row 2 → +$21
