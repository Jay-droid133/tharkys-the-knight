  11+ 9D1B              ClearScreen:
  12+ 9D1B CD AF 0D         CALL ROM_CLS
  13+ 9D1E C9               RET
  14+ 9D1F
  15+ 9D1F              ; ==============================================================================
  16+ 9D1F              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9D1F              ; ==============================================================================
  18+ 9D1F              ; Entrada:
  19+ 9D1F              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9D1F              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9D1F              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9D1F              ;
  23+ 9D1F              ; Formato del sprite:
  24+ 9D1F              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9D1F              ;   DEFB height_pixels
  26+ 9D1F              ;   DEFB pixel_data... (width * height bytes)
  27+ 9D1F              ;
  28+ 9D1F              ; Dos paths:
  29+ 9D1F              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9D1F              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9D1F              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9D1F              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9D1F              ;
  34+ 9D1F              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9D1F              ;
  36+ 9D1F              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9D1F              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9D1F              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9D1F              ; alto la restauracion del bank.
  40+ 9D1F              ; ==============================================================================
  41+ 9D1F              DrawSprite:
  42+ 9D1F                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9D1F                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9D1F                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9D1F 3A D4 90         LD A, (CurrentPaging)
  46+ 9D22 E6 F8            AND $F8
  47+ 9D24 F6 06            OR 6
  48+ 9D26 32 D4 90         LD (CurrentPaging), A
  49+ 9D29 01 FD 7F         LD BC, $7FFD
  50+ 9D2C ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9D2E CD 3F 9D         CALL _DrawSpriteImpl
  52+ 9D31                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9D31                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9D31 3A D4 90         LD A, (CurrentPaging)
  55+ 9D34 E6 F8            AND $F8
  56+ 9D36 32 D4 90         LD (CurrentPaging), A
  57+ 9D39 01 FD 7F         LD BC, $7FFD
  58+ 9D3C ED 79            OUT (C), A
  59+ 9D3E C9               RET
  60+ 9D3F
  61+ 9D3F              _DrawSpriteImpl:
  62+ 9D3F                  ; Guardar posicion
  63+ 9D3F 7A               LD A, D
  64+ 9D40 32 F9 9D         LD (.posY), A
  65+ 9D43 7B               LD A, E
  66+ 9D44 32 F8 9D         LD (.posX), A
  67+ 9D47
  68+ 9D47                  ; Leer cabecera sprite
  69+ 9D47 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9D4A 32 FA 9D         LD (.widthSave), A
  71+ 9D4D DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9D50 32 FB 9D         LD (.heightSave), A
  73+ 9D53 DD 23            INC IX
  74+ 9D55 DD 23            INC IX                      ; IX → pixel data
  75+ 9D57
  76+ 9D57                  ; === Y CLIPPING ===
  77+ 9D57                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9D57 3A F9 9D         LD A, (.posY)
  79+ 9D5A FE 10            CP SCREEN_MIN_Y
  80+ 9D5C 30 20            JR NC, .clipTopDone
  81+ 9D5E                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9D5E 47               LD B, A                     ; B = Y
  83+ 9D5F 3E 10            LD A, SCREEN_MIN_Y
  84+ 9D61 90               SUB B                       ; A = filas a saltar
  85+ 9D62 47               LD B, A                     ; B = skip rows
  86+ 9D63                  ; Reducir altura
  87+ 9D63 3A FB 9D         LD A, (.heightSave)
  88+ 9D66 90               SUB B
  89+ 9D67 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9D68 D8               RET C                       ; Idem
  91+ 9D69 32 FB 9D         LD (.heightSave), A
  92+ 9D6C                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9D6C 3A FA 9D         LD A, (.widthSave)
  94+ 9D6F 4F               LD C, A
  95+ 9D70              .clipSkipRow:
  96+ 9D70 79               LD A, C
  97+ 9D71              .clipSkipByte:
  98+ 9D71 DD 23            INC IX
  99+ 9D73 3D               DEC A
 100+ 9D74 20 FB            JR NZ, .clipSkipByte
 101+ 9D76 10 F8            DJNZ .clipSkipRow
 102+ 9D78                  ; Ajustar Y al borde
 103+ 9D78 3E 10            LD A, SCREEN_MIN_Y
 104+ 9D7A 32 F9 9D         LD (.posY), A
 105+ 9D7D 57               LD D, A
 106+ 9D7E              .clipTopDone:
 107+ 9D7E                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9D7E 3A F9 9D         LD A, (.posY)
 109+ 9D81 47               LD B, A
 110+ 9D82 3A FB 9D         LD A, (.heightSave)
 111+ 9D85 80               ADD A, B                    ; A = Y + height
 112+ 9D86 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9D88 FE C0            CP 192
 114+ 9D8A 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9D8C              .clipBot:
 116+ 9D8C                  ; Reducir altura: new_height = 192 - Y
 117+ 9D8C 3E C0            LD A, 192
 118+ 9D8E 90               SUB B                       ; A = 192 - Y
 119+ 9D8F C8               RET Z
 120+ 9D90 D8               RET C
 121+ 9D91 32 FB 9D         LD (.heightSave), A
 122+ 9D94              .clipBotDone:
 123+ 9D94
 124+ 9D94                  ; Comprobar alineacion
 125+ 9D94 7B               LD A, E
 126+ 9D95 E6 07            AND 7
 127+ 9D97 20 1E            JR NZ, .shifted
 128+ 9D99
 129+ 9D99                  ; ==================================================================
 130+ 9D99                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9D99                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9D99                  ; ==================================================================
 133+ 9D99 CD 92 A0         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9D9C DD E5            PUSH IX
 135+ 9D9E D1               POP DE                      ; DE = puntero a pixel data
 136+ 9D9F 3A FB 9D         LD A, (.heightSave)
 137+ 9DA2 4F               LD C, A                     ; C = height counter
 138+ 9DA3
 139+ 9DA3              .alignedLine:
 140+ 9DA3 3A FA 9D         LD A, (.widthSave)
 141+ 9DA6 47               LD B, A                     ; B = ancho en bytes
 142+ 9DA7 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9DA8
 144+ 9DA8              .alignedByte:
 145+ 9DA8 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9DA9 AE               XOR (HL)
 147+ 9DAA 77               LD (HL), A
 148+ 9DAB 23               INC HL                      ; Siguiente columna VRAM
 149+ 9DAC 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9DAD 10 F9            DJNZ .alignedByte
 151+ 9DAF
 152+ 9DAF E1               POP HL                      ; Restaurar inicio de linea
 153+ 9DB0 0D               DEC C
 154+ 9DB1 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9DB2 CD FE 9D         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9DB5 18 EC            JR .alignedLine
 157+ 9DB7
 158+ 9DB7                  ; ==================================================================
 159+ 9DB7                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9DB7                  ; ==================================================================
 161+ 9DB7                  ; A = shift amount (1-7) al llegar aqui
 162+ 9DB7              .shifted:
 163+ 9DB7                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9DB7 3D               DEC A                       ; 0-6
 165+ 9DB8 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9DB9 E6 0E            AND $0E
 167+ 9DBB C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9DBD 32 FC 9D         LD (.tablePage), A
 169+ 9DC0
 170+ 9DC0                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9DC0 DD E5            PUSH IX
 172+ 9DC2 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9DC3 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9DC4
 175+ 9DC4                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9DC4 3A F9 9D         LD A, (.posY)
 177+ 9DC7 57               LD D, A
 178+ 9DC8 3A F8 9D         LD A, (.posX)
 179+ 9DCB 5F               LD E, A
 180+ 9DCC CD 92 A0         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9DCF
 182+ 9DCF D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9DD0 3A FC 9D         LD A, (.tablePage)
 184+ 9DD3 47               LD B, A                     ; B = pagina high part
 185+ 9DD4                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9DD4                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9DD4 3A FB 9D         LD A, (.heightSave)
 188+ 9DD7 DD 67            LD IXH, A
 189+ 9DD9
 190+ 9DD9              .shiftedLine:
 191+ 9DD9 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9DDA 3A FA 9D         LD A, (.widthSave)
 193+ 9DDD DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9DDF
 195+ 9DDF              .shiftedByte:
 196+ 9DDF                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9DDF 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9DE0 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9DE1 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9DE2 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9DE3 77               LD (HL), A                  ; Escribir
 202+ 9DE4 2C               INC L                       ; Siguiente columna VRAM
 203+ 9DE5 04               INC B                       ; Pagina overflow
 204+ 9DE6 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9DE7 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9DE8 77               LD (HL), A                  ; Escribir
 207+ 9DE9 05               DEC B                       ; Restaurar pagina high
 208+ 9DEA 13               INC DE                      ; Siguiente byte de sprite
 209+ 9DEB                  ; Siguiente byte de ancho
 210+ 9DEB DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9DED 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9DEF
 213+ 9DEF E1               POP HL                      ; Restaurar inicio de linea
 214+ 9DF0 DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9DF2 C8               RET Z                       ; Terminamos todas las lineas
 216+ 9DF3 CD FE 9D         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9DF6 18 E1            JR .shiftedLine
