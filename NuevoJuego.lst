 251+ 6AFB 20 F9            JR NZ, .lbsAttrCol
 252+ 6AFD              .lbsAttrRowDone:
 253+ 6AFD 10 F0            DJNZ .lbsAttrRow
 254+ 6AFF 18 05            JR .lbsLoadDone
