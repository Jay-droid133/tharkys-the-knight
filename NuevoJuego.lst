  67+ F060 3A 51 82         LD A, (CurrentObjective)
  68+ F063 FE 09            CP 9
  69+ F065 30 21            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ F067 87               ADD A, A                            ; *2 (entry size)
  71+ F068 6F               LD L, A
  72+ F069 26 00            LD H, 0
  73+ F06B 11 37 F0         LD DE, MilestoneTable
