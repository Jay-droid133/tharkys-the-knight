 141+ E57A 3A FE E4         LD A, (CurrentTimeOfDay)
 142+ E57D 21 79 E9         LD HL, RemapHouseTablePtrs
 143+ E580 5F               LD E, A
 144+ E581 16 00            LD D, 0
 145+ E583 19               ADD HL, DE
 146+ E584 19               ADD HL, DE
 147+ E585 5E               LD E, (HL)
 148+ E586 23               INC HL
 149+ E587 56               LD D, (HL)
 150+ E588 ED 53 01 E5      LD (CurrentHouseRemapTable), DE
 151+ E58C C9               RET
