  76+ 6EBD 03               DEFB ROUL_STAMINA
  77+ 6EBE 04               DEFB ROUL_RAYO
  78+ 6EBF 05               DEFB ROUL_CARACOL
  79+ 6EC0              RouletteOrderEnd:
