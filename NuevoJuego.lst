 177+ E5C1              ; ==============================================================================
 178+ E5C1              ; SetClockToPhaseHour
 179+ E5C1              ; ==============================================================================
 180+ E5C1              SetClockToPhaseHour:
 181+ E5C1 21 E0 E3         LD HL, PhaseStartHour
 182+ E5C4 4F               LD C, A
 183+ E5C5 06 00            LD B, 0
 184+ E5C7 09               ADD HL, BC
 185+ E5C8 7E               LD A, (HL)
 186+ E5C9 32 DD E3         LD (GameHours), A
 187+ E5CC AF               XOR A
 188+ E5CD 32 DC E3         LD (GameMinutes), A
 189+ E5D0 32 DB E3         LD (GameSubMinute), A
 190+ E5D3 C9               RET
