 542  D9F7                  ; --- Game Over tumba 2x — body (~538 B) ---
 543  D9F7                  ; Cold path one-shot. Llamado via thunk en slot 1 (game_over_tomb_thunk.asm).
 544  D9F7                  ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
 545  D9F7                  ; al final → bank 7 desapareceria con el body ejecutandose). El thunk hace
 546  D9F7                  ; la carga del sprite ANTES de paginar bank 7 y llamar al body.
 547  D9F7                  INCLUDE "game_over_tomb.asm"
# file opened: code/game_over_tomb.asm
   1+ D9F7              ; ==============================================================================
   2+ D9F7              ; GAME OVER — TUMBA DEL JUGADOR A 2x (BODY, vive en BANK 7)
   3+ D9F7              ; ==============================================================================
   4+ D9F7              ; Cuerpo de la rutina. Vive en bank 7 (slot 3 cuando paged) por estar
   5+ D9F7              ; "holgado": tras bg_gfx_c (~$D226) y antes del storage de tombstones ($E000+),
   6+ D9F7              ; quedan ~3.5 KB libres. Bank 0 estaba al 96 % y este código es one-shot.
   7+ D9F7              ;
   8+ D9F7              ; Llamado por DrawTombstone2xCentered (thunk en slot 1) DESPUÉS de que el
   9+ D9F7              ; thunk haya cargado el sprite en BgSpriteBuffer y paginado bank 7 en slot 3.
  10+ D9F7              ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
  11+ D9F7              ; en slot 3 al final → bank 7 desaparece → crash).
  12+ D9F7              ;
  13+ D9F7              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
  14+ D9F7              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
  15+ D9F7              ; Game Over. La muerte hace moonwalk justo encima del techo.
  16+ D9F7              ;
  17+ D9F7              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  18+ D9F7              ;
  19+ D9F7              ; Algoritmo (precondición: BgSpriteBuffer ya tiene el sprite cargado):
  20+ D9F7              ;   1. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  21+ D9F7              ;      planos en TombDecodedPixels (en bank 7 RAM). Salva src ptr post-pixels.
  22+ D9F7              ;   2. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  23+ D9F7              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  24+ D9F7              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  25+ D9F7              ;   3. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  26+ D9F7              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  27+ D9F7              ;
  28+ D9F7              ; Coste: ~30K T-states one-shot. Invisible.
  29+ D9F7              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch + 2 B var = ~538 B en bank 7.
  30+ D9F7              ;
  31+ D9F7              ; Capas:
  32+ D9F7              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  33+ D9F7              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba.
  34+ D9F7              ; ==============================================================================
  35+ D9F7
  36+ D9F7              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  37+ D9F7              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  38+ D9F7              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  39+ D9F7              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  40+ D9F7              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  41+ D9F7              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  42+ D9F7              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  43+ D9F7              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  44+ D9F7              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  45+ D9F7
  46+ D9F7              ; ==============================================================================
  47+ D9F7              ; DrawTombstone2xBody - entry point del body en bank 7
  48+ D9F7              ; ==============================================================================
  49+ D9F7              ; Precondición: bank 7 paginado en slot 3 + BgSpriteBuffer ya cargado con
  50+ D9F7              ; el sprite (lo hace el thunk antes de llamar a esta rutina).
  51+ D9F7              ;
  52+ D9F7              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  53+ D9F7              ; directamente a VRAM sin XOR.
  54+ D9F7              ;
  55+ D9F7              ; Destruye: AF, BC, DE, HL, IX.
  56+ D9F7              ; ==============================================================================
  57+ D9F7              DrawTombstone2xBody:
  58+ D9F7                  ; --- 1. Decodificar pixeles RLE+CPL → flat buffer ---
  59+ D9F7 CD 00 DA         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  60+ D9FA
  61+ D9FA                  ; --- 2. Dibujar pixeles 2x desde flat buffer ---
  62+ D9FA CD 5D DA         CALL DrawTombPixels2x
  63+ D9FD
  64+ D9FD                  ; --- 3. Dibujar attrs 2x desde BgSpriteBuffer ---
  65+ D9FD C3 E6 DA         JP DrawTombAttrs2x              ; tail-call
  66+ DA00
  67+ DA00              ; ==============================================================================
  68+ DA00              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  69+ DA00              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  70+ DA00              ; ==============================================================================
  71+ DA00              ; Formato RLE (mismo que DrawBgGfxSprite):
  72+ DA00              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  73+ DA00              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  74+ DA00              ;
  75+ DA00              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  76+ DA00              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  77+ DA00              ;
  78+ DA00              ; Destruye: AF, BC, DE, HL.
  79+ DA00              ; ==============================================================================
  80+ DA00              DecodeTombRLEPixels:
  81+ DA00 21 FA 86         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  82+ DA03 11 2D DB         LD DE, TombDecodedPixels
  83+ DA06 01 F0 00         LD BC, TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes a emitir
  84+ DA09 AF               XOR A
  85+ DA0A 32 5B DA         LD (.drlPending), A
  86+ DA0D              .drlLoop:
  87+ DA0D 78               LD A, B
  88+ DA0E B1               OR C
  89+ DA0F 28 43            JR Z, .drlDone                  ; remaining == 0 → done
  90+ DA11 3A 5B DA         LD A, (.drlPending)
  91+ DA14 B7               OR A
  92+ DA15 28 22            JR Z, .drlNewToken
  93+ DA17 FA 2A DA         JP M, .drlLitEmit
  94+ DA1A                  ; pending > 0 → run en curso
  95+ DA1A              .drlRunEmit:
  96+ DA1A 3A 5C DA         LD A, (.drlValue)
  97+ DA1D 2F               CPL
  98+ DA1E 12               LD (DE), A
  99+ DA1F 13               INC DE
 100+ DA20 0B               DEC BC
 101+ DA21 3A 5B DA         LD A, (.drlPending)
 102+ DA24 3D               DEC A
 103+ DA25 32 5B DA         LD (.drlPending), A
 104+ DA28 18 E3            JR .drlLoop
 105+ DA2A
 106+ DA2A              .drlLitEmit:
 107+ DA2A 7E               LD A, (HL)
 108+ DA2B 23               INC HL
 109+ DA2C 2F               CPL
 110+ DA2D 12               LD (DE), A
 111+ DA2E 13               INC DE
 112+ DA2F 0B               DEC BC
 113+ DA30 3A 5B DA         LD A, (.drlPending)
 114+ DA33 3C               INC A                           ; hacia 0
 115+ DA34 32 5B DA         LD (.drlPending), A
 116+ DA37 18 D4            JR .drlLoop
 117+ DA39
 118+ DA39              .drlNewToken:
 119+ DA39 7E               LD A, (HL)
 120+ DA3A 23               INC HL
 121+ DA3B CB 7F            BIT 7, A
 122+ DA3D 20 07            JR NZ, .drlNewRun
 123+ DA3F                  ; Literal group: pending = -count
 124+ DA3F ED 44            NEG
 125+ DA41 32 5B DA         LD (.drlPending), A
 126+ DA44 18 C7            JR .drlLoop
 127+ DA46
 128+ DA46              .drlNewRun:
 129+ DA46 E6 7F            AND $7F
 130+ DA48 C6 02            ADD A, 2
 131+ DA4A 32 5B DA         LD (.drlPending), A
 132+ DA4D 7E               LD A, (HL)
 133+ DA4E 23               INC HL
 134+ DA4F 32 5C DA         LD (.drlValue), A
 135+ DA52 18 B9            JR .drlLoop
 136+ DA54
 137+ DA54              .drlDone:
 138+ DA54                  ; HL apunta al byte tras los pixeles RLE = tint byte.
 139+ DA54                  ; attrs comienzan en HL + 3 (skip tint + AH + AW).
 140+ DA54 23               INC HL
 141+ DA55 23               INC HL
 142+ DA56 23               INC HL
 143+ DA57 22 1D DC         LD (TombAttrSrcPtr), HL
 144+ DA5A C9               RET
 145+ DA5B
 146+ DA5B 00           .drlPending:    DEFB 0
 147+ DA5C 00           .drlValue:      DEFB 0
 148+ DA5D
 149+ DA5D              ; ==============================================================================
 150+ DA5D              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 151+ DA5D              ; ==============================================================================
 152+ DA5D              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 153+ DA5D              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 154+ DA5D              ; pareja de bytes — vertical doubling).
 155+ DA5D              ;
 156+ DA5D              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 157+ DA5D              ; Destruye: AF, BC, DE, HL.
 158+ DA5D              ; ==============================================================================
 159+ DA5D              DrawTombPixels2x:
 160+ DA5D 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 161+ DA5F 32 DE DA         LD (.dpxRowsLeft), A
 162+ DA62 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
