 468+ EF2E 6F               LD L, A
 469+ EF2F 18 09            JR .dbWrite
 470+ EF31              .dbCalcR1:
 471+ EF31                  ; Char row 1
 472+ EF31 D6 08            SUB 8
 473+ EF33 67               LD H, A
 474+ EF34 CB F4            SET 6, H
 475+ EF36 3A 60 EF         LD A, (.dbCol1)
 476+ EF39 6F               LD L, A
 477+ EF3A              .dbWrite:
 478+ EF3A                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EF3A 7A               LD A, D
 480+ EF3B BB               CP E
 481+ EF3C 30 0B            JR NC, .dbFull
 482+ EF3E                  ; Marchito: copiar sprite decayed
 483+ EF3E FD 7E 00         LD A, (IY+0)
 484+ EF41 77               LD (HL), A
 485+ EF42 23               INC HL
 486+ EF43 FD 7E 01         LD A, (IY+1)
 487+ EF46 77               LD (HL), A
 488+ EF47 18 09            JR .dbAdvanceSpr
 489+ EF49              .dbFull:
 490+ EF49                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EF49 DD 7E 00         LD A, (IX+0)
 492+ EF4C 77               LD (HL), A
 493+ EF4D 23               INC HL
 494+ EF4E DD 7E 01         LD A, (IX+1)
 495+ EF51 77               LD (HL), A
 496+ EF52              .dbAdvanceSpr:
 497+ EF52                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EF52 D5               PUSH DE
 499+ EF53 11 06 00         LD DE, 6
 500+ EF56 DD 19            ADD IX, DE
 501+ EF58 FD 19            ADD IY, DE
 502+ EF5A D1               POP DE
 503+ EF5B 14               INC D
 504+ EF5C 10 C5            DJNZ .dbLoop
 505+ EF5E C9               RET
 506+ EF5F
 507+ EF5F 00           .dbCol:  DEFB 0
 508+ EF60 00           .dbCol1: DEFB 0
