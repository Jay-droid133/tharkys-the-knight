7360+ C804 3A 11 C8         LD A, (.bfsSvX)
7361+ C807 DD 77 03         LD (IX+ENT_POSX), A
7362+ C80A 3A 12 C8         LD A, (.bfsSvY)
7363+ C80D DD 77 04         LD (IX+ENT_POSY), A
7364+ C810 C9               RET
7365+ C811 00           .bfsSvX: DEFB 0
7366+ C812 00           .bfsSvY: DEFB 0
