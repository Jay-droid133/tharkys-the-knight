 452  C9DB                  INCLUDE "monster_ai_bank6.asm"
# file opened: monster_ai_bank6.asm
   1+ C9DB              ; ==============================================================================
   2+ C9DB              ; MONSTER AI v2 — buffers runtime en bank 6
   3+ C9DB              ; ==============================================================================
   4+ C9DB              ; Se incluye en main.asm dentro del bloque PAGE 6, DESPUES de screen_gaps.asm.
   5+ C9DB              ; Los buffers viven en $Cxxx y se acceden paginando bank 6 al slot 3.
   6+ C9DB              ;
   7+ C9DB              ;   FlowField   — 704 B, distancia-al-player por celda (32×22 chars)
   8+ C9DB              ;                 Formato: 1 byte por celda. Valor $FF = inalcanzable.
   9+ C9DB              ;                 Offset lineal: cellY * 32 + cellX
  10+ C9DB              ;
  11+ C9DB              ;   BfsQueue    — 1408 B, FIFO para el BFS (cola de celdas a procesar)
  12+ C9DB              ;                 Cada entrada: 2 bytes = (cx, cy) con cx 0-31, cy 0-21.
  13+ C9DB              ;                 Capacidad 704 entradas = todo el grid. Suficiente en peor caso.
  14+ C9DB              ;
  15+ C9DB              ; Escritura y lectura: los clientes deben paginar bank 6 antes, repaginar bank 0
  16+ C9DB              ; despues (ver PageBankSlot3 en paging.asm).
  17+ C9DB              ; ==============================================================================
  18+ C9DB
  19+ C9DB 00 00 00...  FlowField:      DEFS 704
  20+ CC9B 00 00 00...  BfsQueue:       DEFS 1408
  21+ D21B
  22+ D21B              MonsterAiBank6End:
  23+ D21B
# file closed: monster_ai_bank6.asm
 453  D21B                  INCLUDE "sprite_data.asm"
# file opened: sprite_data.asm
   1+ D21B              ; ==============================================================================
   2+ D21B              ; DATOS DE SPRITES DEL JUGADOR (con cabecera width/height)
   3+ D21B              ; ==============================================================================
   4+ D21B              ; Formato por sprite:
   5+ D21B              ;   DEFB width_bytes   (2=16px, 3=24px)
   6+ D21B              ;   DEFB height_pixels
   7+ D21B              ;   DEFB pixel_data... (width * height bytes)
   8+ D21B              ;
   9+ D21B              ; Organizacion:
  10+ D21B              ;   SpriteID 0-1:   Idle (2 frames)
  11+ D21B              ;   SpriteID 2-5:   Walk East (4 frames: 0,1,2,1)
  12+ D21B              ;   SpriteID 5-8:   Walk West (4 frames: 0,1,2,1)
  13+ D21B              ;   SpriteID 8-10:  Walk North (3 frames)
  14+ D21B              ;   SpriteID 11-13: Walk South (3 frames)
  15+ D21B              ;   SpriteID 14-15: Fight East (2 frames)
  16+ D21B              ;   SpriteID 16-17: Fight West (2 frames)
  17+ D21B              ; ==============================================================================
  18+ D21B
  19+ D21B              ; --- SpriteID bases para animaciones ---
  20+ D21B              SPRID_IDLE       EQU 0
