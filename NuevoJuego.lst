 392+ EC81 FD 21 CA E8      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EC85 CD EB EC         CALL .drawBar
 394+ EC88
 395+ EC88                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
