 195+ FA95              ; --- SFX_CountdownTick: bip ~700ms para "3" y "2" del countdown ---
 196+ FA95              ; Pitch 102 = ~1047 Hz. Calibrado para octava precisa con pitch 50 (ratio 1.992).
 197+ FA95              ; (PlaySFX tiene ~78T de overhead por ciclo ademas de 32*pitch -> ratio puro
 198+ FA95              ; 100/50 quedaria desafinado ~30 cents. Compensado a 102 da ~7 cents.)
 199+ FA95              SFX_CountdownTick:
 200+ FA95 FA 66 00 00      DEFB 250, 102, 0, 0         ; ~239ms
 201+ FA99 FA 66 00 00      DEFB 250, 102, 0, 0         ; ~478ms
 202+ FA9D E6 66 00 00      DEFB 230, 102, 0, 0         ; ~219ms (total ~718ms)
 203+ FAA1 00               DEFB 0
 204+ FAA2
 205+ FAA2              ; --- SFX_CountdownGo: octava arriba del Tick, ~1s ---
 206+ FAA2              ; Pitch 50 = ~2086 Hz. Ratio period(102)/period(50) = 3342/1678 = 1.992.
 207+ FAA2              SFX_CountdownGo:
 208+ FAA2 FA 32 00 00      DEFB 250, 50, 0, 0          ; ~120ms cada step
 209+ FAA6 FA 32 00 00      DEFB 250, 50, 0, 0
 210+ FAAA FA 32 00 00      DEFB 250, 50, 0, 0
 211+ FAAE FA 32 00 00      DEFB 250, 50, 0, 0
 212+ FAB2 FA 32 00 00      DEFB 250, 50, 0, 0
 213+ FAB6 FA 32 00 00      DEFB 250, 50, 0, 0
 214+ FABA FA 32 00 00      DEFB 250, 50, 0, 0
 215+ FABE FA 32 00 00      DEFB 250, 50, 0, 0
