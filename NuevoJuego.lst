2514+ B004              UpdateEnemy:
2515+ B004                  ; --- Comprobar si debe lanzarse como depredador ---
2516+ B004 CD C6 AE         CALL CheckPredatorAttack
2517+ B007                  ; --- Movimiento horizontal ---
2518+ B007 DD 7E 03         LD A, (IX+ENT_POSX)
2519+ B00A 32 C3 B0         LD (.savedEX), A
2520+ B00D 47               LD B, A
2521+ B00E DD 7E 06         LD A, (IX+ENT_DELTAX)
2522+ B011 4F               LD C, A
2523+ B012                  ; Test signo para ADD signed
2524+ B012 CB 79            BIT 7, C
2525+ B014 20 0A            JR NZ, .eDeltaXNeg
2526+ B016                  ; Positivo: mover derecha
2527+ B016 78               LD A, B
2528+ B017 81               ADD A, C
2529+ B018 FE E8            CP SCREEN_MAX_X
2530+ B01A 38 0B            JR C, .eClampXOk
2531+ B01C 3E E7            LD A, SCREEN_MAX_X - 1
2532+ B01E 18 15            JR .eReverseX
2533+ B020              .eDeltaXNeg:
2534+ B020                  ; Negativo: mover izquierda
2535+ B020 78               LD A, B
2536+ B021 81               ADD A, C                    ; ADD signed (C es negativo)
2537+ B022 38 03            JR C, .eClampXOk            ; No underflow → ok
2538+ B024 AF               XOR A                       ; Clamp a 0
2539+ B025 18 0E            JR .eReverseX
2540+ B027              .eClampXOk:
2541+ B027 DD 77 03         LD (IX+ENT_POSX), A
