 537+ E759              ; ==============================================================================
 538+ E759              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 539+ E759              ; Usa font custom (DayHudFont) en vez de ROM font
 540+ E759              ; ==============================================================================
 541+ E759              DrawDayCycleHUD:
 542+ E759                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 543+ E759 21 17 EA         LD HL, DayHudFont + 0 * 8          ; 'D'
 544+ E75C 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 545+ E75F CD CE E7         CALL .drawChar
 546+ E762 21 1F EA         LD HL, DayHudFont + 1 * 8          ; 'A'
 547+ E765 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 548+ E768 CD CE E7         CALL .drawChar
 549+ E76B 21 27 EA         LD HL, DayHudFont + 2 * 8          ; 'Y'
 550+ E76E 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 551+ E771 CD CE E7         CALL .drawChar
 552+ E774                  ; Col 7 = espacio (limpiar)
 553+ E774 11 07 40         LD DE, $4007
 554+ E777 CD D7 E7         CALL .clearChar
 555+ E77A
 556+ E77A                  ; --- Digito decenas (col 8) ---
 557+ E77A 3A 07 C0         LD A, (DayCycleCount)
 558+ E77D FE 0A            CP 10
 559+ E77F 38 20            JR C, .singleDigit
 560+ E781                  ; Dos digitos: dividir A / 10
 561+ E781 06 00            LD B, 0
 562+ E783              .divLoop:
 563+ E783 D6 0A            SUB 10
 564+ E785 04               INC B
 565+ E786 FE 0A            CP 10
 566+ E788 30 F9            JR NC, .divLoop
 567+ E78A                  ; B = decenas, A = unidades
 568+ E78A F5               PUSH AF                             ; Guardar unidades
 569+ E78B 78               LD A, B
 570+ E78C CD C1 E7         CALL .getDigitFont
 571+ E78F 11 08 40         LD DE, $4008                        ; Col 8
 572+ E792 CD CE E7         CALL .drawChar
 573+ E795 F1               POP AF                              ; Recuperar unidades
 574+ E796 CD C1 E7         CALL .getDigitFont
 575+ E799 11 09 40         LD DE, $4009                        ; Col 9
 576+ E79C CD CE E7         CALL .drawChar
 577+ E79F 18 14            JR .setAttrs
 578+ E7A1
 579+ E7A1              .singleDigit:
 580+ E7A1                  ; Una cifra: decena = 0, unidad = A
 581+ E7A1 F5               PUSH AF
 582+ E7A2 21 2F EA         LD HL, DayHudFont + 3 * 8          ; '0'
 583+ E7A5 11 08 40         LD DE, $4008                        ; Col 8
 584+ E7A8 CD CE E7         CALL .drawChar
 585+ E7AB F1               POP AF
 586+ E7AC CD C1 E7         CALL .getDigitFont
 587+ E7AF 11 09 40         LD DE, $4009                        ; Col 9
 588+ E7B2 CD CE E7         CALL .drawChar
 589+ E7B5
 590+ E7B5              .setAttrs:
 591+ E7B5                  ; Atributos: bright white en cols 4-9
 592+ E7B5 3E 47            LD A, $47
 593+ E7B7 21 04 58         LD HL, ATTR_BASE + 4
 594+ E7BA 06 06            LD B, 6
 595+ E7BC              .attrLoop:
 596+ E7BC 77               LD (HL), A
 597+ E7BD 23               INC HL
 598+ E7BE 10 FC            DJNZ .attrLoop
 599+ E7C0 C9               RET
 600+ E7C1
 601+ E7C1              ; Devuelve HL = puntero a font data del digito en A (0-9)
 602+ E7C1              ; A se destruye
 603+ E7C1              .getDigitFont:
 604+ E7C1 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 605+ E7C3 6F               LD L, A
 606+ E7C4 26 00            LD H, 0
 607+ E7C6 29               ADD HL, HL
 608+ E7C7 29               ADD HL, HL
 609+ E7C8 29               ADD HL, HL                          ; HL = indice * 8
 610+ E7C9 01 17 EA         LD BC, DayHudFont
 611+ E7CC 09               ADD HL, BC
 612+ E7CD C9               RET
 613+ E7CE
 614+ E7CE              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 615+ E7CE              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 616+ E7CE              .drawChar:
 617+ E7CE 06 08            LD B, 8
 618+ E7D0              .charLoop:
