1166+ EFB7 E6 7F            AND $7F                             ; width_bytes (sin flag RLE)
1167+ EFB9 87               ADD A, A
1168+ EFBA 87               ADD A, A
1169+ EFBB 87               ADD A, A                            ; width_px = bytes*8
1170+ EFBC 32 E3 EF         LD (.crsPkW+1), A
