5124+ BB32              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5125+ BB32              ; ==============================================================================
5126+ BB32              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5127+ BB32              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5128+ BB32              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5129+ BB32              ; DeathSpawned. No-op si la muerte no esta activa.
5130+ BB32              ; ==============================================================================
5131+ BB32              SilentKillDeath:
5132+ BB32 DD 21 53 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5133+ BB36 DD 7E 01         LD A, (IX+ENT_TYPE)
5134+ BB39 B7               OR A
5135+ BB3A 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5136+ BB3C CD 47 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5137+ BB3F AF               XOR A
5138+ BB40 DD 77 01         LD (IX+ENT_TYPE), A
5139+ BB43 32 02 83         LD (DeathSpawned), A
5140+ BB46              .skdResetTimer:
5141+ BB46                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5142+ BB46                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5143+ BB46 21 00 00         LD HL, 0
5144+ BB49 22 FF 82         LD (DeathScreenTimer), HL
5145+ BB4C                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5146+ BB4C                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5147+ BB4C                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5148+ BB4C                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5149+ BB4C                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5150+ BB4C C9               RET
5151+ BB4D
5152+ BB4D              ; ==============================================================================
5153+ BB4D              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5154+ BB4D              ; ==============================================================================
5155+ BB4D              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5156+ BB4D              ; no DYING ni SPAWNING):
5157+ BB4D              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5158+ BB4D              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5159+ BB4D              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5160+ BB4D              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5161+ BB4D              ;     Si tampoco, deja el monster donde estaba.
5162+ BB4D              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5163+ BB4D              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5164+ BB4D              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5165+ BB4D              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5166+ BB4D              ; ==============================================================================
5167+ BB4D              FreezeMonstersFacingCorpse:
5168+ BB4D                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5169+ BB4D 3A A6 81         LD A, (EntityTable + ENT_POSX)
5170+ BB50 32 F9 82         LD (CorpseX), A
5171+ BB53 3A A7 81         LD A, (EntityTable + ENT_POSY)
5172+ BB56 32 FA 82         LD (CorpseY), A
5173+ BB59                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5174+ BB59                  ; ya skipea; no aplica aqui pero por simetria)
5175+ BB59 3E 01            LD A, 1
5176+ BB5B 32 F8 82         LD (MonstersFrozen), A
5177+ BB5E DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5178+ BB62 06 06            LD B, NUM_MONSTERS
5179+ BB64              .fmcLoop:
5180+ BB64 C5               PUSH BC
5181+ BB65 DD 7E 01         LD A, (IX+ENT_TYPE)
5182+ BB68 FE 02            CP TYPE_MONSTER
5183+ BB6A 20 0E            JR NZ, .fmcNext
5184+ BB6C DD 7E 02         LD A, (IX+ENT_STATE)
5185+ BB6F FE 03            CP STATE_DYING
5186+ BB71 28 07            JR Z, .fmcNext
5187+ BB73 FE 04            CP STATE_SPAWNING
5188+ BB75 28 03            JR Z, .fmcNext
5189+ BB77 CD 83 BB         CALL FreezeOneMonster
5190+ BB7A              .fmcNext:
5191+ BB7A C1               POP BC
5192+ BB7B 11 10 00         LD DE, ENT_SIZE
5193+ BB7E DD 19            ADD IX, DE
5194+ BB80 10 E2            DJNZ .fmcLoop
5195+ BB82 C9               RET
5196+ BB83
5197+ BB83              ; --- FreezeOneMonster ---
5198+ BB83              ; IX = monster slot pointer.
5199+ BB83              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5200+ BB83              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5201+ BB83              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5202+ BB83              FreezeOneMonster:
5203+ BB83                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5204+ BB83                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5205+ BB83                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5206+ BB83 DD 7E 03         LD A, (IX+ENT_POSX)
5207+ BB86 47               LD B, A
5208+ BB87 3A F9 82         LD A, (CorpseX)
5209+ BB8A B8               CP B
5210+ BB8B 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5211+ BB8D 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5212+ BB8F              .fomFaceE:
5213+ BB8F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5214+ BB92 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5215+ BB94 DD 77 00         LD (IX+ENT_SPRITEID), A
5216+ BB97 18 08            JR .fomFaceDone
5217+ BB99              .fomFaceW:
5218+ BB99 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5219+ BB9C C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5220+ BB9E DD 77 00         LD (IX+ENT_SPRITEID), A
5221+ BBA1              .fomFaceDone:
5222+ BBA1
5223+ BBA1                  ; --- 2) Computar |dx| y |dy| ---
5224+ BBA1 3A F9 82         LD A, (CorpseX)
5225+ BBA4 4F               LD C, A
5226+ BBA5 DD 7E 03         LD A, (IX+ENT_POSX)
5227+ BBA8 91               SUB C                           ; A = posX - corpseX (signed)
5228+ BBA9 30 02            JR NC, .fomDxPos
5229+ BBAB ED 44            NEG
5230+ BBAD              .fomDxPos:
5231+ BBAD 32 FE BB         LD (.fomAdx), A
5232+ BBB0 3A FA 82         LD A, (CorpseY)
5233+ BBB3 4F               LD C, A
5234+ BBB4 DD 7E 04         LD A, (IX+ENT_POSY)
5235+ BBB7 91               SUB C
5236+ BBB8 30 02            JR NC, .fomDyPos
5237+ BBBA ED 44            NEG
5238+ BBBC              .fomDyPos:
5239+ BBBC 32 FF BB         LD (.fomAdy), A
5240+ BBBF
5241+ BBBF                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5242+ BBBF 3A FE BB         LD A, (.fomAdx)
5243+ BBC2 FE 10            CP 16
5244+ BBC4 D2 ED BB         JP NC, .fomFreeze
5245+ BBC7 3A FF BB         LD A, (.fomAdy)
5246+ BBCA FE 10            CP 16
5247+ BBCC D2 ED BB         JP NC, .fomFreeze
5248+ BBCF
5249+ BBCF                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5250+ BBCF 3A FE BB         LD A, (.fomAdx)
5251+ BBD2 47               LD B, A
5252+ BBD3 3A FF BB         LD A, (.fomAdy)
5253+ BBD6 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5254+ BBD7 38 0C            JR C, .fomTryX
5255+ BBD9 28 0A            JR Z, .fomTryX
5256+ BBDB                  ; |dy| > |dx| -> intentar Y primero
5257+ BBDB CD 33 BC         CALL TryBackoffY
5258+ BBDE 28 0D            JR Z, .fomFreeze                ; ok
5259+ BBE0 CD 00 BC         CALL TryBackoffX
5260+ BBE3 18 08            JR .fomFreeze
5261+ BBE5              .fomTryX:
5262+ BBE5 CD 00 BC         CALL TryBackoffX
5263+ BBE8 28 03            JR Z, .fomFreeze
5264+ BBEA CD 33 BC         CALL TryBackoffY
5265+ BBED
5266+ BBED              .fomFreeze:
5267+ BBED                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5268+ BBED                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5269+ BBED DD 36 06 00      LD (IX+ENT_DELTAX), 0
5270+ BBF1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5271+ BBF5 DD 36 0A 00      LD (IX+ENT_DIR), 0
5272+ BBF9 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5273+ BBFD C9               RET
5274+ BBFE
5275+ BBFE 00           .fomAdx: DEFB 0
5276+ BBFF 00           .fomAdy: DEFB 0
5277+ BC00
5278+ BC00              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5279+ BC00              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5280+ BC00              TryBackoffX:
5281+ BC00 DD 7E 03         LD A, (IX+ENT_POSX)
5282+ BC03 32 32 BC         LD (.tbxSavePos), A
5283+ BC06 47               LD B, A
5284+ BC07 3A F9 82         LD A, (CorpseX)
5285+ BC0A B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5286+ BC0B DD 7E 03         LD A, (IX+ENT_POSX)
5287+ BC0E 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5288+ BC10 C6 10            ADD A, 16
5289+ BC12 18 02            JR .tbxApply
5290+ BC14              .tbxNeg:
5291+ BC14 D6 10            SUB 16
5292+ BC16              .tbxApply:
5293+ BC16                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5294+ BC16 DD 77 03         LD (IX+ENT_POSX), A
5295+ BC19 FE E8            CP SCREEN_MAX_X
5296+ BC1B 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5297+ BC1D CD F4 B6         CALL CheckEnemyCollision
5298+ BC20 20 07            JR NZ, .tbxFail
5299+ BC22 CD 6A BC         CALL CheckMonsterOverlap
5300+ BC25 20 02            JR NZ, .tbxFail
5301+ BC27 AF               XOR A                           ; Z = ok
5302+ BC28 C9               RET
5303+ BC29              .tbxFail:
5304+ BC29 3A 32 BC         LD A, (.tbxSavePos)
5305+ BC2C DD 77 03         LD (IX+ENT_POSX), A
5306+ BC2F F6 01            OR 1                            ; NZ
5307+ BC31 C9               RET
5308+ BC32 00           .tbxSavePos: DEFB 0
5309+ BC33
5310+ BC33              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5311+ BC33              TryBackoffY:
5312+ BC33 DD 7E 04         LD A, (IX+ENT_POSY)
5313+ BC36 32 69 BC         LD (.tbySavePos), A
5314+ BC39 47               LD B, A
5315+ BC3A 3A FA 82         LD A, (CorpseY)
5316+ BC3D B8               CP B
5317+ BC3E DD 7E 04         LD A, (IX+ENT_POSY)
5318+ BC41 30 04            JR NC, .tbyNeg
5319+ BC43 C6 10            ADD A, 16
5320+ BC45 18 02            JR .tbyApply
5321+ BC47              .tbyNeg:
5322+ BC47 D6 10            SUB 16
5323+ BC49              .tbyApply:
5324+ BC49 DD 77 04         LD (IX+ENT_POSY), A
5325+ BC4C FE 10            CP SCREEN_MIN_Y
5326+ BC4E 38 10            JR C, .tbyFail
5327+ BC50 FE A8            CP SCREEN_MAX_Y
5328+ BC52 30 0C            JR NC, .tbyFail
5329+ BC54 CD F4 B6         CALL CheckEnemyCollision
5330+ BC57 20 07            JR NZ, .tbyFail
5331+ BC59 CD 6A BC         CALL CheckMonsterOverlap
5332+ BC5C 20 02            JR NZ, .tbyFail
5333+ BC5E AF               XOR A
5334+ BC5F C9               RET
5335+ BC60              .tbyFail:
5336+ BC60 3A 69 BC         LD A, (.tbySavePos)
5337+ BC63 DD 77 04         LD (IX+ENT_POSY), A
5338+ BC66 F6 01            OR 1
5339+ BC68 C9               RET
5340+ BC69 00           .tbySavePos: DEFB 0
5341+ BC6A
5342+ BC6A              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5343+ BC6A              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5344+ BC6A              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5345+ BC6A              CheckMonsterOverlap:
5346+ BC6A C5               PUSH BC
5347+ BC6B FD E5            PUSH IY
5348+ BC6D FD 21 B3 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5349+ BC71 06 06            LD B, NUM_MONSTERS
5350+ BC73              .cmoLoop:
5351+ BC73                  ; Skip self (IY == IX)
5352+ BC73 DD E5            PUSH IX
5353+ BC75 E1               POP HL
5354+ BC76 FD E5            PUSH IY
5355+ BC78 D1               POP DE
5356+ BC79 B7               OR A
5357+ BC7A ED 52            SBC HL, DE
5358+ BC7C 28 3D            JR Z, .cmoNext                  ; same slot
5359+ BC7E
5360+ BC7E FD 7E 01         LD A, (IY+ENT_TYPE)
5361+ BC81 FE 02            CP TYPE_MONSTER
5362+ BC83 20 36            JR NZ, .cmoNext
5363+ BC85
5364+ BC85                  ; AABB overlap (rect 16x21 cada uno):
5365+ BC85                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5366+ BC85                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5367+ BC85 DD 7E 03         LD A, (IX+ENT_POSX)
5368+ BC88 C6 10            ADD A, 16
5369+ BC8A 4F               LD C, A
5370+ BC8B FD 7E 03         LD A, (IY+ENT_POSX)
5371+ BC8E B9               CP C                            ; iy.x cmp ix.x+16
5372+ BC8F 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5373+ BC91 FD 7E 03         LD A, (IY+ENT_POSX)
5374+ BC94 C6 10            ADD A, 16
5375+ BC96 4F               LD C, A
5376+ BC97 DD 7E 03         LD A, (IX+ENT_POSX)
5377+ BC9A B9               CP C
5378+ BC9B 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5379+ BC9D DD 7E 04         LD A, (IX+ENT_POSY)
5380+ BCA0 C6 15            ADD A, 21
5381+ BCA2 4F               LD C, A
5382+ BCA3 FD 7E 04         LD A, (IY+ENT_POSY)
5383+ BCA6 B9               CP C
5384+ BCA7 30 12            JR NC, .cmoNext
5385+ BCA9 FD 7E 04         LD A, (IY+ENT_POSY)
5386+ BCAC C6 15            ADD A, 21
5387+ BCAE 4F               LD C, A
5388+ BCAF DD 7E 04         LD A, (IX+ENT_POSY)
5389+ BCB2 B9               CP C
5390+ BCB3 30 06            JR NC, .cmoNext
5391+ BCB5                  ; Overlap en ambos ejes
5392+ BCB5 FD E1            POP IY
5393+ BCB7 C1               POP BC
5394+ BCB8 F6 01            OR 1                            ; NZ
5395+ BCBA C9               RET
5396+ BCBB              .cmoNext:
5397+ BCBB 11 10 00         LD DE, ENT_SIZE
5398+ BCBE FD 19            ADD IY, DE
5399+ BCC0 10 B1            DJNZ .cmoLoop
5400+ BCC2 FD E1            POP IY
5401+ BCC4 C1               POP BC
5402+ BCC5 AF               XOR A                           ; Z = no overlap
5403+ BCC6 C9               RET
5404+ BCC7
5405+ BCC7              ; ==============================================================================
5406+ BCC7              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5407+ BCC7              ; ==============================================================================
5408+ BCC7              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5409+ BCC7              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5410+ BCC7              ; ==============================================================================
5411+ BCC7              KillAllActiveMonsters:
5412+ BCC7 AF               XOR A
5413+ BCC8 32 8F B3         LD (MonstersActive), A              ; No respawnear mas
5414+ BCCB DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5415+ BCCF 06 06            LD B, NUM_MONSTERS
5416+ BCD1              .kamLoop:
5417+ BCD1 C5               PUSH BC
5418+ BCD2 DD 7E 01         LD A, (IX+ENT_TYPE)
5419+ BCD5 B7               OR A
5420+ BCD6 28 27            JR Z, .kamSkip                      ; slot vacio
5421+ BCD8 FE 02            CP TYPE_MONSTER
5422+ BCDA 20 23            JR NZ, .kamSkip                     ; no es monster
5423+ BCDC DD 7E 02         LD A, (IX+ENT_STATE)
5424+ BCDF FE 03            CP STATE_DYING
5425+ BCE1 28 1C            JR Z, .kamSkip
5426+ BCE3 FE 04            CP STATE_SPAWNING
5427+ BCE5 28 18            JR Z, .kamSkip
5428+ BCE7 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5429+ BCEB DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5430+ BCEF DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5431+ BCF3 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5432+ BCF7 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5433+ BCFB DD 36 07 00      LD (IX+ENT_DELTAY), 0
5434+ BCFF                  ; ENT_ATTR conservado: puff hereda color del monster
5435+ BCFF              .kamSkip:
5436+ BCFF 11 10 00         LD DE, ENT_SIZE
5437+ BD02 DD 19            ADD IX, DE
5438+ BD04 C1               POP BC
5439+ BD05 10 CA            DJNZ .kamLoop
5440+ BD07 C9               RET
5441+ BD08
5442+ BD08              ; --- Tabla de tipos de nasty (SpriteID base) ---
5443+ BD08              ; --- Tablas de nasties por momento del dia ---
5444+ BD08              NUM_NASTY_TYPES EQU 4
5445+ BD08              DiurnalTypeTable:                       ; DY, C1, A2
5446+ BD08 30               DEFB SPRID_ENEMY_4          ; Eagle
5447+ BD09 20               DEFB SPRID_ENEMY_0          ; Spider
5448+ BD0A 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5449+ BD0B 2C               DEFB SPRID_ENEMY_3          ; Snake
5450+ BD0C              CrepuscularTypeTable:                   ; C2, N1
5451+ BD0C 34               DEFB SPRID_ENEMY_5          ; Rat
5452+ BD0D 28               DEFB SPRID_ENEMY_2          ; Bat
5453+ BD0E 24               DEFB SPRID_ENEMY_1          ; Scorpion
5454+ BD0F 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5455+ BD10
5456+ BD10              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5457+ BD10              NastyColorTable:
5458+ BD10 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5459+ BD11 42               DEFB RED | $40              ; Enemy 1: Scorpion - rojo
5460+ BD12 43               DEFB MAGENTA | $40          ; Enemy 2: Bat - magenta
5461+ BD13 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5462+ BD14 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5463+ BD15 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5464+ BD16 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5465+ BD17 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5466+ BD18
5467+ BD18              ; --- Tabla de comportamiento depredador ---
5468+ BD18              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5469+ BD18              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5470+ BD18              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5471+ BD18              PredatorTable:
5472+ BD18 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5473+ BD19 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5474+ BD1A 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5475+ BD1B 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5476+ BD1C 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5477+ BD1D 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5478+ BD1E 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5479+ BD1F 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5480+ BD20
5481+ BD20              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5482+ BD20              PredatorSpeedTable:
5483+ BD20 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5484+ BD21 02               DEFB 2                              ; Ciclo 1: lento
5485+ BD22 03               DEFB 3                              ; Ciclo 2: intermedio
5486+ BD23 04               DEFB 4                              ; Ciclo 3+: rapido
5487+ BD24
5488+ BD24 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5489+ BD25
5490+ BD25 08 BD        CurrentNastyTable: DEFW DiurnalTypeTable
5491+ BD27
5492+ BD27              ; ==============================================================================
5493+ BD27              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5494+ BD27              ; ==============================================================================
5495+ BD27              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5496+ BD27              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5497+ BD27              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5498+ BD27              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5499+ BD27              ;   pantalla, no diurnos.
5500+ BD27              ; ==============================================================================
5501+ BD27              UpdateNastyTable:
5502+ BD27 3A F6 E3         LD A, (CurrentTimeOfDay)
5503+ BD2A FE 02            CP 2
5504+ BD2C 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5505+ BD2E FE 06            CP 6
5506+ BD30 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5507+ BD32 21 0C BD         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5508+ BD35 18 03            JR .setTable
5509+ BD37              .diurnal:
5510+ BD37 21 08 BD         LD HL, DiurnalTypeTable
5511+ BD3A              .setTable:
5512+ BD3A 22 25 BD         LD (CurrentNastyTable), HL
5513+ BD3D C9               RET
5514+ BD3E
5515+ BD3E              ; ==============================================================================
5516+ BD3E              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5517+ BD3E              ; ==============================================================================
5518+ BD3E              ScareAllMonsters:
5519+ BD3E AF               XOR A
5520+ BD3F 32 8F B3         LD (MonstersActive), A              ; No respawnear mas
5521+ BD42                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5522+ BD42                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5523+ BD42                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5524+ BD42 21 9B 8D         LD HL, MonsterAiFlags
5525+ BD45 06 03            LD B, 3
5526+ BD47              .samClearLoop:
5527+ BD47 7E               LD A, (HL)
5528+ BD48 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5529+ BD4A 77               LD (HL), A
5530+ BD4B 23               INC HL
5531+ BD4C 10 F9            DJNZ .samClearLoop
5532+ BD4E 3E 7D            LD A, SCARE_TIMER_DAWN
5533+ BD50 32 25 B6         LD (ScareTimer), A
5534+ BD53                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5535+ BD53                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5536+ BD53                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5537+ BD53                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5538+ BD53 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5539+ BD57 06 06            LD B, NUM_MONSTERS
5540+ BD59              .samStateLoop:
5541+ BD59 DD 7E 01         LD A, (IX+ENT_TYPE)
5542+ BD5C FE 02            CP TYPE_MONSTER
5543+ BD5E 20 1B            JR NZ, .samStateNext
5544+ BD60 DD 7E 02         LD A, (IX+ENT_STATE)
5545+ BD63 FE 03            CP STATE_DYING
5546+ BD65 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5547+ BD67 FE 04            CP STATE_SPAWNING
5548+ BD69 28 10            JR Z, .samStateNext
5549+ BD6B DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5550+ BD6F DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5551+ BD73 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5552+ BD77 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5553+ BD7B              .samStateNext:
5554+ BD7B 11 10 00         LD DE, ENT_SIZE
5555+ BD7E DD 19            ADD IX, DE
5556+ BD80 10 D7            DJNZ .samStateLoop
5557+ BD82 C9               RET
5558+ BD83
5559+ BD83              ; ==============================================================================
5560+ BD83              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5561+ BD83              ; ==============================================================================
5562+ BD83              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5563+ BD83              ; ==============================================================================
5564+ BD83
5565+ BD83              ; ==============================================================================
5566+ BD83              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5567+ BD83              ; ==============================================================================
5568+ BD83              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5569+ BD83              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5570+ BD83              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5571+ BD83              ; ==============================================================================
5572+ BD83              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5573+ BD83              ; ==============================================================================
5574+ BD83              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5575+ BD83              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5576+ BD83              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5577+ BD83              ; ==============================================================================
5578+ BD83              MONSTERS_TO_SPAWN   EQU 3
5579+ BD83              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5580+ BD83              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5581+ BD83
5582+ BD83              ; ==============================================================================
5583+ BD83              ; SpawnMonsters - Primera aparicion tras campanadas
5584+ BD83              ; ==============================================================================
5585+ BD83              SpawnMonsters:
5586+ BD83                  IF DEBUG_NO_ENEMIES
5587+ BD83 ~                RET
5588+ BD83                  ENDIF
5589+ BD83 3A 8F B3         LD A, (MonstersActive)
5590+ BD86 B7               OR A
5591+ BD87 C0               RET NZ
5592+ BD88                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5593+ BD88                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5594+ BD88 CD 64 BA         CALL KillAllActiveNasties
5595+ BD8B 3E 01            LD A, 1
5596+ BD8D 32 8F B3         LD (MonstersActive), A
5597+ BD90 CD 0D BE         CALL ShuffleMonsterTypes
5598+ BD93 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5599+ BD97 06 03            LD B, MONSTERS_TO_SPAWN
5600+ BD99 0E 00            LD C, 0
5601+ BD9B              .smLoop:
5602+ BD9B C5               PUSH BC
5603+ BD9C DD 7E 01         LD A, (IX+ENT_TYPE)
5604+ BD9F B7               OR A
5605+ BDA0 C2 FC BD         JP NZ, .smSkip
5606+ BDA3                  ; Asignar tipo y color
5607+ BDA3 79               LD A, C
5608+ BDA4 21 71 BE         LD HL, MonsterTypeTable
5609+ BDA7 5F               LD E, A
5610+ BDA8 16 00            LD D, 0
5611+ BDAA 19               ADD HL, DE
5612+ BDAB 7E               LD A, (HL)
5613+ BDAC DD 77 08         LD (IX+ENT_ANIMBASE), A
5614+ BDAF 79               LD A, C
5615+ BDB0 21 74 BE         LD HL, MonsterColorTable
5616+ BDB3 5F               LD E, A
5617+ BDB4 16 00            LD D, 0
5618+ BDB6 19               ADD HL, DE
5619+ BDB7 7E               LD A, (HL)
5620+ BDB8 DD 77 05         LD (IX+ENT_ATTR), A
5621+ BDBB                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5622+ BDBB C5               PUSH BC
5623+ BDBC CD C0 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5624+ BDBF B7               OR A
5625+ BDC0 20 0E            JR NZ, .smFallbackPos
5626+ BDC2 3A C8 97         LD A, (MaiSpawnX)
5627+ BDC5 DD 77 03         LD (IX+ENT_POSX), A
5628+ BDC8 3A C9 97         LD A, (MaiSpawnY)
5629+ BDCB DD 77 04         LD (IX+ENT_POSY), A
5630+ BDCE 18 0C            JR .smPosDone
5631+ BDD0              .smFallbackPos:
5632+ BDD0 3A 16 83         LD A, (LastEntryPosX)
5633+ BDD3 DD 77 03         LD (IX+ENT_POSX), A
5634+ BDD6 3A 17 83         LD A, (LastEntryPosY)
5635+ BDD9 DD 77 04         LD (IX+ENT_POSY), A
5636+ BDDC              .smPosDone:
5637+ BDDC C1               POP BC
5638+ BDDD                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5639+ BDDD DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5640+ BDE1 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5641+ BDE5 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5642+ BDE9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5643+ BDED DD 36 07 00      LD (IX+ENT_DELTAY), 0
5644+ BDF1                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5645+ BDF1                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5646+ BDF1                  ; lo empuje a un vecino (migracion por knockback).
5647+ BDF1 CD B5 8E         CALL MaiGetCurrentScreenId
5648+ BDF4 21 8F 8D         LD HL, MonsterRoomId
5649+ BDF7 59               LD E, C
5650+ BDF8 16 00            LD D, 0
5651+ BDFA 19               ADD HL, DE
5652+ BDFB 77               LD (HL), A
5653+ BDFC              .smSkip:
5654+ BDFC 11 10 00         LD DE, ENT_SIZE
5655+ BDFF DD 19            ADD IX, DE
5656+ BE01 C1               POP BC
5657+ BE02 0C               INC C
5658+ BE03 05               DEC B
5659+ BE04 C2 9B BD         JP NZ, .smLoop
5660+ BE07 3E 14            LD A, MONSTER_ENTRY_BASE
5661+ BE09 32 5B BF         LD (TryRespawnMonsters.rmTimer), A
5662+ BE0C                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5663+ BE0C                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5664+ BE0C                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5665+ BE0C C9               RET
5666+ BE0D
5667+ BE0D              ; --- Barajar tablas tipo/color ---
5668+ BE0D              ShuffleMonsterTypes:
5669+ BE0D ED 5F            LD A, R
5670+ BE0F E6 03            AND 3
5671+ BE11 C8               RET Z
5672+ BE12 FE 01            CP 1
5673+ BE14 28 21            JR Z, .shSwap01
5674+ BE16 FE 02            CP 2
5675+ BE18 28 3A            JR Z, .shSwap12
5676+ BE1A 3A 71 BE         LD A, (MonsterTypeTable)
5677+ BE1D 57               LD D, A
5678+ BE1E 3A 73 BE         LD A, (MonsterTypeTable + 2)
5679+ BE21 32 71 BE         LD (MonsterTypeTable), A
5680+ BE24 7A               LD A, D
5681+ BE25 32 73 BE         LD (MonsterTypeTable + 2), A
5682+ BE28 3A 74 BE         LD A, (MonsterColorTable)
5683+ BE2B 57               LD D, A
5684+ BE2C 3A 76 BE         LD A, (MonsterColorTable + 2)
5685+ BE2F 32 74 BE         LD (MonsterColorTable), A
5686+ BE32 7A               LD A, D
5687+ BE33 32 76 BE         LD (MonsterColorTable + 2), A
5688+ BE36 C9               RET
5689+ BE37              .shSwap01:
5690+ BE37 3A 71 BE         LD A, (MonsterTypeTable)
5691+ BE3A 57               LD D, A
5692+ BE3B 3A 72 BE         LD A, (MonsterTypeTable + 1)
5693+ BE3E 32 71 BE         LD (MonsterTypeTable), A
5694+ BE41 7A               LD A, D
5695+ BE42 32 72 BE         LD (MonsterTypeTable + 1), A
5696+ BE45 3A 74 BE         LD A, (MonsterColorTable)
5697+ BE48 57               LD D, A
5698+ BE49 3A 75 BE         LD A, (MonsterColorTable + 1)
5699+ BE4C 32 74 BE         LD (MonsterColorTable), A
5700+ BE4F 7A               LD A, D
5701+ BE50 32 75 BE         LD (MonsterColorTable + 1), A
5702+ BE53 C9               RET
5703+ BE54              .shSwap12:
5704+ BE54 3A 72 BE         LD A, (MonsterTypeTable + 1)
5705+ BE57 57               LD D, A
5706+ BE58 3A 73 BE         LD A, (MonsterTypeTable + 2)
5707+ BE5B 32 72 BE         LD (MonsterTypeTable + 1), A
5708+ BE5E 7A               LD A, D
5709+ BE5F 32 73 BE         LD (MonsterTypeTable + 2), A
5710+ BE62 3A 75 BE         LD A, (MonsterColorTable + 1)
5711+ BE65 57               LD D, A
5712+ BE66 3A 76 BE         LD A, (MonsterColorTable + 2)
5713+ BE69 32 75 BE         LD (MonsterColorTable + 1), A
5714+ BE6C 7A               LD A, D
5715+ BE6D 32 76 BE         LD (MonsterColorTable + 2), A
5716+ BE70 C9               RET
5717+ BE71
5718+ BE71              MonsterTypeTable:
5719+ BE71 4C               DEFB SPRID_MONSTER_0
5720+ BE72 54               DEFB SPRID_MONSTER_1
5721+ BE73 5C               DEFB SPRID_MONSTER_2
5722+ BE74              MonsterColorTable:
5723+ BE74 44               DEFB $44                            ; Zombi: verde
5724+ BE75 46               DEFB $46                            ; Skeleton: amarillo
5725+ BE76 45               DEFB $45                            ; Ghost: cyan
5726+ BE77
5727+ BE77              ; ==============================================================================
5728+ BE77              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5729+ BE77              ; ==============================================================================
5730+ BE77              TryRespawnMonsters:
5731+ BE77                  IF DEBUG_NO_ENEMIES
5732+ BE77 ~                RET
5733+ BE77                  ENDIF
5734+ BE77 3A F6 E3         LD A, (CurrentTimeOfDay)
5735+ BE7A FE 03            CP 3
5736+ BE7C 28 05            JR Z, .rmNight
5737+ BE7E FE 04            CP 4
5738+ BE80 28 01            JR Z, .rmNight
5739+ BE82 C9               RET
5740+ BE83              .rmNight:
5741+ BE83 3A 8F B3         LD A, (MonstersActive)
5742+ BE86 B7               OR A
5743+ BE87 C8               RET Z
5744+ BE88 CD 5F BF         CALL .rmUpdateReturnTimers
5745+ BE8B 3A 5B BF         LD A, (.rmTimer)
5746+ BE8E B7               OR A
5747+ BE8F 28 05            JR Z, .rmCheckSlots
5748+ BE91 3D               DEC A
5749+ BE92 32 5B BF         LD (.rmTimer), A
5750+ BE95 C9               RET
5751+ BE96              .rmCheckSlots:
5752+ BE96 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5753+ BE9A 06 03            LD B, MONSTERS_TO_SPAWN
5754+ BE9C 0E 00            LD C, 0
5755+ BE9E              .rmLoop:
5756+ BE9E C5               PUSH BC
5757+ BE9F DD 7E 01         LD A, (IX+ENT_TYPE)
5758+ BEA2 B7               OR A
5759+ BEA3 C2 4F BF         JP NZ, .rmSkip
5760+ BEA6                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5761+ BEA6                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5762+ BEA6                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5763+ BEA6 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5764+ BEA9 B7               OR A
5765+ BEAA 20 09            JR NZ, .rmHasTypeForTrap
5766+ BEAC                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5767+ BEAC 79               LD A, C
5768+ BEAD 21 71 BE         LD HL, MonsterTypeTable
5769+ BEB0 5F               LD E, A
5770+ BEB1 16 00            LD D, 0
5771+ BEB3 19               ADD HL, DE
5772+ BEB4 7E               LD A, (HL)
5773+ BEB5              .rmHasTypeForTrap:
5774+ BEB5 D6 4C            SUB SPRID_MONSTER_0
5775+ BEB7 CB 3F            SRL A
5776+ BEB9 CB 3F            SRL A
5777+ BEBB CB 3F            SRL A                               ; A = type idx 0..2
5778+ BEBD 21 5C BF         LD HL, .rmTrapBits
5779+ BEC0 5F               LD E, A
5780+ BEC1 16 00            LD D, 0
5781+ BEC3 19               ADD HL, DE
5782+ BEC4 7E               LD A, (HL)
5783+ BEC5 21 C6 82         LD HL, MonsterTrappedFlags
5784+ BEC8 A6               AND (HL)
5785+ BEC9 C2 4F BF         JP NZ, .rmSkip
5786+ BECC                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5787+ BECC                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5788+ BECC                  ; que el player visite su room.
5789+ BECC 79               LD A, C
5790+ BECD 6F               LD L, A
5791+ BECE 26 00            LD H, 0
5792+ BED0 11 8F 8D         LD DE, MonsterRoomId
5793+ BED3 19               ADD HL, DE
5794+ BED4 7E               LD A, (HL)
5795+ BED5 5F               LD E, A                             ; E = room_id del slot
5796+ BED6 CD B5 8E         CALL MaiGetCurrentScreenId          ; A = current screen_id
5797+ BED9 BB               CP E
5798+ BEDA C2 4F BF         JP NZ, .rmSkip                      ; distinto room → skip
5799+ BEDD                  ; === Activar SIN tocar POSX/POSY ===
5800+ BEDD                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5801+ BEDD                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5802+ BEDD                  ;   - RepositionMonstersAtEntry: gap en entry side
5803+ BEDD                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5804+ BEDD DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5805+ BEE0 B7               OR A
5806+ BEE1 20 18            JR NZ, .rmHasType
5807+ BEE3 79               LD A, C
5808+ BEE4 21 71 BE         LD HL, MonsterTypeTable
5809+ BEE7 5F               LD E, A
5810+ BEE8 16 00            LD D, 0
5811+ BEEA 19               ADD HL, DE
5812+ BEEB 7E               LD A, (HL)
5813+ BEEC DD 77 08         LD (IX+ENT_ANIMBASE), A
5814+ BEEF 79               LD A, C
5815+ BEF0 21 74 BE         LD HL, MonsterColorTable
5816+ BEF3 5F               LD E, A
5817+ BEF4 16 00            LD D, 0
5818+ BEF6 19               ADD HL, DE
5819+ BEF7 7E               LD A, (HL)
5820+ BEF8 DD 77 05         LD (IX+ENT_ATTR), A
5821+ BEFB              .rmHasType:
5822+ BEFB DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5823+ BEFE DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5824+ BF02 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5825+ BF06                  ; Facing
5826+ BF06 57               LD D, A
5827+ BF07 3A A6 81         LD A, (EntityTable + ENT_POSX)
5828+ BF0A DD BE 03         CP (IX+ENT_POSX)
5829+ BF0D 30 05            JR NC, .rmFaceR
5830+ BF0F 7A               LD A, D
5831+ BF10 C6 04            ADD A, MONSTER_FRAMES_LEFT
5832+ BF12 18 01            JR .rmFaceSet
5833+ BF14              .rmFaceR:
5834+ BF14 7A               LD A, D
5835+ BF15              .rmFaceSet:
5836+ BF15 DD 77 00         LD (IX+ENT_SPRITEID), A
5837+ BF18 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5838+ BF1C DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5839+ BF20 DD 36 0A 00      LD (IX+ENT_DIR), 0
5840+ BF24 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5841+ BF28 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5842+ BF2C DD 7E 03         LD A, (IX+ENT_POSX)
5843+ BF2F DD 77 0C         LD (IX+ENT_OLDX), A
5844+ BF32 DD 77 0F         LD (IX+ENT_DRAWX), A
5845+ BF35 DD 7E 04         LD A, (IX+ENT_POSY)
5846+ BF38 DD 77 0D         LD (IX+ENT_OLDY), A
5847+ BF3B DD 7E 00         LD A, (IX+ENT_SPRITEID)
5848+ BF3E DD 77 0E         LD (IX+ENT_OLDSPRID), A
5849+ BF41                  ; Solo UNO por frame
5850+ BF41 C1               POP BC
5851+ BF42 3E 14            LD A, MONSTER_ENTRY_GAP
5852+ BF44 32 5B BF         LD (.rmTimer), A
5853+ BF47                  ; Arrancar MonstersMusic la PRIMERA vez que un monster aparece visible.
5854+ BF47                  ; Step=$FF (sentinel inactivo) -> aun no ha sonado nunca esta noche.
5855+ BF47                  ; Tras StartMonstersMusic, Step=0 -> no re-arranca en respawns posteriores.
5856+ BF47                  ; StopMonstersMusic en sunrise restaura Step=$FF para la siguiente noche.
5857+ BF47 3A 0A FC         LD A, (MonstersMusicStep)
5858+ BF4A 3C               INC A
5859+ BF4B C0               RET NZ                              ; Step != $FF -> ya arranco, salir
5860+ BF4C C3 CC FB         JP StartMonstersMusic               ; tail-call: arranca el secuencer
5861+ BF4F              .rmSkip:
5862+ BF4F 11 10 00         LD DE, ENT_SIZE
5863+ BF52 DD 19            ADD IX, DE
5864+ BF54 C1               POP BC
5865+ BF55 0C               INC C
5866+ BF56 05               DEC B
5867+ BF57 C2 9E BE         JP NZ, .rmLoop
5868+ BF5A C9               RET
5869+ BF5B
5870+ BF5B 00           .rmTimer: DEFB 0
5871+ BF5C 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5872+ BF5F
5873+ BF5F              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5874+ BF5F              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5875+ BF5F              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5876+ BF5F              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5877+ BF5F              ; empujado).
5878+ BF5F              .rmUpdateReturnTimers:
5879+ BF5F 21 90 B3         LD HL, MonsterReturnTimer
5880+ BF62 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5881+ BF66 06 03            LD B, MONSTERS_TO_SPAWN
5882+ BF68              .rmRtLoop:
5883+ BF68 7E               LD A, (HL)
5884+ BF69 B7               OR A
5885+ BF6A CA 3F C0         JP Z, .rmRtNext
5886+ BF6D 3D               DEC A
5887+ BF6E 77               LD (HL), A
5888+ BF6F C2 3F C0         JP NZ, .rmRtNext
5889+ BF72                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5890+ BF72                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5891+ BF72                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5892+ BF72                  ; Calcular target coord: axis variable segun borde de salida.
5893+ BF72                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5894+ BF72 DD 7E 0A         LD A, (IX+ENT_DIR)
5895+ BF75 FE 01            CP DIR_N
5896+ BF77 28 11            JR Z, .rmRtSideN
5897+ BF79 FE 02            CP DIR_S
5898+ BF7B 28 1C            JR Z, .rmRtSideS
5899+ BF7D FE 04            CP DIR_E
5900+ BF7F CA B9 BF         JP Z, .rmRtSideE
5901+ BF82 FE 08            CP DIR_W
5902+ BF84 CA A8 BF         JP Z, .rmRtSideW
5903+ BF87 C3 16 C0         JP .rmRtFallback
5904+ BF8A              .rmRtSideN:
5905+ BF8A                  ; target coord = cx = POSX / 8
5906+ BF8A DD 7E 03         LD A, (IX+ENT_POSX)
5907+ BF8D 0F               RRCA
5908+ BF8E 0F               RRCA
5909+ BF8F 0F               RRCA
5910+ BF90 E6 1F            AND $1F
5911+ BF92 32 C7 97         LD (MaiGapTargetCoord), A
5912+ BF95 3E 00            LD A, MAI_SIDE_N
5913+ BF97 18 2F            JR .rmRtPickGap
5914+ BF99              .rmRtSideS:
5915+ BF99 DD 7E 03         LD A, (IX+ENT_POSX)
5916+ BF9C 0F               RRCA
5917+ BF9D 0F               RRCA
5918+ BF9E 0F               RRCA
5919+ BF9F E6 1F            AND $1F
5920+ BFA1 32 C7 97         LD (MaiGapTargetCoord), A
5921+ BFA4 3E 01            LD A, MAI_SIDE_S
5922+ BFA6 18 20            JR .rmRtPickGap
5923+ BFA8              .rmRtSideW:
5924+ BFA8                  ; target coord = cy = (POSY - 16) / 8
5925+ BFA8 DD 7E 04         LD A, (IX+ENT_POSY)
5926+ BFAB D6 10            SUB SCREEN_MIN_Y
5927+ BFAD 0F               RRCA
5928+ BFAE 0F               RRCA
5929+ BFAF 0F               RRCA
5930+ BFB0 E6 1F            AND $1F
5931+ BFB2 32 C7 97         LD (MaiGapTargetCoord), A
5932+ BFB5 3E 02            LD A, MAI_SIDE_W
5933+ BFB7 18 0F            JR .rmRtPickGap
5934+ BFB9              .rmRtSideE:
5935+ BFB9 DD 7E 04         LD A, (IX+ENT_POSY)
5936+ BFBC D6 10            SUB SCREEN_MIN_Y
5937+ BFBE 0F               RRCA
5938+ BFBF 0F               RRCA
5939+ BFC0 0F               RRCA
5940+ BFC1 E6 1F            AND $1F
5941+ BFC3 32 C7 97         LD (MaiGapTargetCoord), A
5942+ BFC6 3E 03            LD A, MAI_SIDE_E
