  41+ 8DA6 3A A4 81         LD A, (EntityTable + ENT_POSY)
  42+ 8DA9 D6 10            SUB SCREEN_MIN_Y
  43+ 8DAB 0F               RRCA
  44+ 8DAC 0F               RRCA
  45+ 8DAD 0F               RRCA
  46+ 8DAE E6 1F            AND $1F
  47+ 8DB0 32 B7 97         LD (MaiFlowPlCy), A
  48+ 8DB3
  49+ 8DB3                  ; --- Swap a stack temporal (bank 2) ---
  50+ 8DB3 ED 73 BD 97      LD (MaiFlowSavedSP), SP
  51+ 8DB7 31 5D 98         LD SP, MaiTempStackTop
  52+ 8DBA
  53+ 8DBA                  ; --- Ventana de paginacion ---
  54+ 8DBA                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 8DBA F3               DI
  56+ 8DBB 3A 87 8D         LD A, (CurrentPaging)
  57+ 8DBE E6 F8            AND $F8
  58+ 8DC0 F6 06            OR 6
  59+ 8DC2 32 87 8D         LD (CurrentPaging), A
  60+ 8DC5 01 FD 7F         LD BC, $7FFD
  61+ 8DC8 ED 79            OUT (C), A
  62+ 8DCA
  63+ 8DCA                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 8DCA CD E6 8D         CALL MaiFlowBfs
  65+ 8DCD
  66+ 8DCD                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 8DCD 3A 87 8D         LD A, (CurrentPaging)
  68+ 8DD0 E6 F8            AND $F8
  69+ 8DD2 32 87 8D         LD (CurrentPaging), A
  70+ 8DD5 01 FD 7F         LD BC, $7FFD
  71+ 8DD8 ED 79            OUT (C), A
  72+ 8DDA
  73+ 8DDA ED 7B BD 97      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 8DDE 3A 9F 81         LD A, (StartupComplete)
  75+ 8DE1 B7               OR A
  76+ 8DE2 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 8DE4 FB               EI
  78+ 8DE5              .mcffNoEI:
  79+ 8DE5 C9               RET
