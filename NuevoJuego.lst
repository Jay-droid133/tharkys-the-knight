2055+ AD3A              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
2056+ AD3A              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
2057+ AD3A              ; ==============================================================================
2058+ AD3A              ; ==============================================================================
2059+ AD3A              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2060+ AD3A              ; ==============================================================================
2061+ AD3A              UpdateStamina:
2062+ AD3A                  ; --- Regenerar salud (siempre, lento) ---
2063+ AD3A                  ; Regen-por-tiempo de salud desactivada para subir dificultad.
2064+ AD3A                  ; Salud solo se recupera por pozo / pickups. Reactivar quitando los `;`
2065+ AD3A                  ; (candidato a difficulty level "fácil" en el futuro).
2066+ AD3A                  ; LD A, (PlayerHealth)
2067+ AD3A                  ; CP HEALTH_MAX
2068+ AD3A                  ; JR Z, .usHealthFull
2069+ AD3A                  ; LD HL, HealthRegenCtr
2070+ AD3A                  ; INC (HL)
2071+ AD3A                  ; LD A, (HL)
2072+ AD3A                  ; CP HEALTH_REGEN_RATE
2073+ AD3A                  ; JR C, .usHealthFull
2074+ AD3A                  ; LD (HL), 0
2075+ AD3A                  ; LD A, (PlayerHealth)
2076+ AD3A                  ; INC A
2077+ AD3A                  ; LD (PlayerHealth), A
2078+ AD3A              .usHealthFull:
2079+ AD3A                  ; --- Stamina: consumir o regenerar ---
2080+ AD3A DD 7E 02         LD A, (IX+ENT_STATE)
2081+ AD3D FE 02            CP STATE_FIGHTING
2082+ AD3F 28 01            JR Z, .usDrain
2083+ AD41                  ; No atacando: regenerar
2084+ AD41                  ; Regen-por-tiempo de stamina desactivada para subir dificultad.
2085+ AD41                  ; Stamina solo se recupera por pozo / pickups. Reactivar quitando los `;`
2086+ AD41                  ; y eliminando el RET justo debajo (candidato a difficulty level "fácil").
2087+ AD41 C9               RET
2088+ AD42                  ; LD A, (PlayerStamina)
2089+ AD42                  ; CP STAMINA_MAX
2090+ AD42                  ; RET Z                               ; Ya al maximo
2091+ AD42                  ; LD HL, StaminaRegenCtr
2092+ AD42                  ; INC (HL)
2093+ AD42                  ; LD A, (HL)
2094+ AD42                  ; CP STAMINA_REGEN_RATE
2095+ AD42                  ; RET C                               ; Aun no toca
2096+ AD42                  ; LD (HL), 0                          ; Reset counter
2097+ AD42                  ; LD A, (PlayerStamina)
2098+ AD42                  ; INC A
2099+ AD42                  ; LD (PlayerStamina), A
2100+ AD42                  ; RET
2101+ AD42              .usDrain:
2102+ AD42                  ; Atacando: consumir stamina
2103+ AD42 3A F3 B5         LD A, (PlayerStamina)
2104+ AD45 B7               OR A
2105+ AD46 C8               RET Z                               ; Ya vacia
2106+ AD47 21 F4 B5         LD HL, StaminaDrainCtr
2107+ AD4A 34               INC (HL)
2108+ AD4B 7E               LD A, (HL)
2109+ AD4C FE 0D            CP STAMINA_DRAIN_RATE
2110+ AD4E D8               RET C
2111+ AD4F 36 00            LD (HL), 0
2112+ AD51 3A F3 B5         LD A, (PlayerStamina)
2113+ AD54 3D               DEC A
2114+ AD55 32 F3 B5         LD (PlayerStamina), A
2115+ AD58                  ; Si stamina llega a 0, dar 1 punto tras cooldown
2116+ AD58 B7               OR A
2117+ AD59 C0               RET NZ
2118+ AD5A 3E 01            LD A, 1
2119+ AD5C 32 F3 B5         LD (PlayerStamina), A               ; Minimo 1 para un swing
2120+ AD5F C9               RET
