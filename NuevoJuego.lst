2925+ AF30 C3 4C AF         JP .moKbApply
2926+ AF33              .moKbSlideY:
2927+ AF33                  ; Intentar solo eje Y (mantener direccion del golpe)
2928+ AF33 7B               LD A, E
2929+ AF34 B7               OR A
2930+ AF35 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2931+ AF37 D5               PUSH DE
2932+ AF38 16 00            LD D, 0
2933+ AF3A CD 23 B2         CALL .moTryPassable
2934+ AF3D D1               POP DE
2935+ AF3E 20 09            JR NZ, .moKbSlideStop
2936+ AF40                  ; Slide en Y funciona
2937+ AF40 16 00            LD D, 0
2938+ AF42 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2939+ AF46 C3 4C AF         JP .moKbApply
2940+ AF49              .moKbSlideStop:
2941+ AF49 C3 2D B0         JP .moStunStop
2942+ AF4C                  ; (moKbMonsterHit eliminado - reemplazado por moKbBilliard arriba)
2943+ AF4C              .moKbApply:
2944+ AF4C DD 7E 03         LD A, (IX+ENT_POSX)
2945+ AF4F 82               ADD A, D
2946+ AF50 DD 77 03         LD (IX+ENT_POSX), A
2947+ AF53                  ; Comprobar bordes X
2948+ AF53 FE E8            CP SCREEN_MAX_X
2949+ AF55 30 1E            JR NC, .moKbOffscreen               ; Derecha o underflow pasado izquierda
2950+ AF57                  ; Borde izquierdo: si X < KB_SPEED y empujando a la izquierda
2951+ AF57 FE 04            CP MONSTER_KB_SPEED
2952+ AF59 30 04            JR NC, .moKbXOk
2953+ AF5B CB 7A            BIT 7, D                            ; Delta X negativo?
2954+ AF5D 20 16            JR NZ, .moKbOffscreen               ; Si, empujando izquierda → offscreen
2955+ AF5F              .moKbXOk:
2956+ AF5F DD 7E 04         LD A, (IX+ENT_POSY)
2957+ AF62 83               ADD A, E
2958+ AF63 DD 77 04         LD (IX+ENT_POSY), A
2959+ AF66                  ; Comprobar bordes Y
2960+ AF66 FE A8            CP SCREEN_MAX_Y
2961+ AF68 30 0B            JR NC, .moKbOffscreen               ; Pasado borde inferior
2962+ AF6A                  ; Borde superior: si Y < MIN+KB_SPEED y empujando arriba
2963+ AF6A FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2964+ AF6C 30 04            JR NC, .moKbYOk
2965+ AF6E CB 7B            BIT 7, E                            ; Delta Y negativo?
2966+ AF70 20 03            JR NZ, .moKbOffscreen               ; Si, empujando arriba → offscreen
2967+ AF72              .moKbYOk:
2968+ AF72 C3 C9 B1         JP .moAnimate
2969+ AF75              .moKbOffscreen:
2970+ AF75                  ; Elegir eje de salida por MAGNITUD DEL KNOCKBACK, no por el eje que
2971+ AF75                  ; cruzo el borde primero. Asi el monster sale por el lado que el
2972+ AF75                  ; player quiso empujar (eje primario) aunque llegue al borde del eje
2973+ AF75                  ; secundario un frame antes por drift diagonal.
2974+ AF75                  ;
2975+ AF75                  ; |DX| vs |DY|: eje primario = mayor magnitud. En empate, horizontal.
2976+ AF75 DD 7E 06         LD A, (IX+ENT_DELTAX)
2977+ AF78 CB 7F            BIT 7, A
2978+ AF7A 28 02            JR Z, .moKbAbsDxOk
2979+ AF7C ED 44            NEG
2980+ AF7E              .moKbAbsDxOk:
2981+ AF7E 47               LD B, A                             ; B = |dx|
2982+ AF7F DD 7E 07         LD A, (IX+ENT_DELTAY)
2983+ AF82 CB 7F            BIT 7, A
2984+ AF84 28 02            JR Z, .moKbAbsDyOk
2985+ AF86 ED 44            NEG
2986+ AF88              .moKbAbsDyOk:
2987+ AF88                  ; A = |dy|, B = |dx|
2988+ AF88 B8               CP B
2989+ AF89 30 30            JR NC, .moKbPrimY                   ; |dy| >= |dx| → Y primario
2990+ AF8B              .moKbPrimX:
2991+ AF8B                  ; Eje primario X → clamp X, mantener Y (clampeado al rango valido)
2992+ AF8B DD 7E 06         LD A, (IX+ENT_DELTAX)
2993+ AF8E CB 7F            BIT 7, A
2994+ AF90 20 08            JR NZ, .moKbExitLeft
2995+ AF92 DD 36 03 E7      LD (IX+ENT_POSX), SCREEN_MAX_X - 1
2996+ AF96 3E 04            LD A, DIR_E
2997+ AF98 18 06            JR .moKbClampY
2998+ AF9A              .moKbExitLeft:
2999+ AF9A DD 36 03 00      LD (IX+ENT_POSX), 0
3000+ AF9E 3E 08            LD A, DIR_W
3001+ AFA0              .moKbClampY:
3002+ AFA0                  ; Proteger POSY: si el drift lo saco de rango, clamparlo al borde
3003+ AFA0 4F               LD C, A                             ; C = DIR_E/W
3004+ AFA1 DD 7E 04         LD A, (IX+ENT_POSY)
3005+ AFA4 FE A8            CP SCREEN_MAX_Y
3006+ AFA6 38 07            JR C, .moKbClampYHigh
3007+ AFA8                  ; POSY >= MAX (salio abajo o underflow): clamp a MAX-1
3008+ AFA8 3E A7            LD A, SCREEN_MAX_Y - 1
3009+ AFAA DD 77 04         LD (IX+ENT_POSY), A
3010+ AFAD 18 09            JR .moKbClampXDone
3011+ AFAF              .moKbClampYHigh:
3012+ AFAF FE 10            CP SCREEN_MIN_Y
3013+ AFB1 30 05            JR NC, .moKbClampXDone              ; POSY >= MIN, OK
3014+ AFB3 3E 10            LD A, SCREEN_MIN_Y
3015+ AFB5 DD 77 04         LD (IX+ENT_POSY), A
3016+ AFB8              .moKbClampXDone:
3017+ AFB8 79               LD A, C
3018+ AFB9 18 2D            JR .moKbClampDone
3019+ AFBB
3020+ AFBB              .moKbPrimY:
3021+ AFBB                  ; Eje primario Y → clamp Y, mantener X (clampeado al rango valido)
3022+ AFBB DD 7E 07         LD A, (IX+ENT_DELTAY)
3023+ AFBE CB 7F            BIT 7, A
3024+ AFC0 20 08            JR NZ, .moKbExitTop
3025+ AFC2 DD 36 04 A7      LD (IX+ENT_POSY), SCREEN_MAX_Y - 1
3026+ AFC6 3E 02            LD A, DIR_S
3027+ AFC8 18 06            JR .moKbClampX
3028+ AFCA              .moKbExitTop:
3029+ AFCA DD 36 04 10      LD (IX+ENT_POSY), SCREEN_MIN_Y
3030+ AFCE 3E 01            LD A, DIR_N
3031+ AFD0              .moKbClampX:
3032+ AFD0 4F               LD C, A                             ; C = DIR_N/S
3033+ AFD1 DD 7E 03         LD A, (IX+ENT_POSX)
3034+ AFD4 FE E8            CP SCREEN_MAX_X
3035+ AFD6 38 07            JR C, .moKbClampXHigh
3036+ AFD8 3E E7            LD A, SCREEN_MAX_X - 1
3037+ AFDA DD 77 03         LD (IX+ENT_POSX), A
3038+ AFDD 18 08            JR .moKbClampYDone
3039+ AFDF              .moKbClampXHigh:
3040+ AFDF FE 04            CP MONSTER_KB_SPEED
3041+ AFE1 30 04            JR NC, .moKbClampYDone              ; POSX >= KB_SPEED, OK
3042+ AFE3 AF               XOR A
3043+ AFE4 DD 77 03         LD (IX+ENT_POSX), A
3044+ AFE7              .moKbClampYDone:
3045+ AFE7 79               LD A, C
3046+ AFE8              .moKbClampDone:
3047+ AFE8                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
3048+ AFE8                  ;
3049+ AFE8                  ; Doble comportamiento:
3050+ AFE8                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
3051+ AFE8                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
3052+ AFE8                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
3053+ AFE8                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
3054+ AFE8                  ;   y lo activa).
3055+ AFE8                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
3056+ AFE8                  ;   El monster queda en destino (memoria) hasta que el player visite.
3057+ AFE8                  ;
3058+ AFE8                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
3059+ AFE8                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
3060+ AFE8 DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
