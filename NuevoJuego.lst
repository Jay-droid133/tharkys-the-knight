2021+ AE18 DD 7E 02         LD A, (IX+ENT_STATE)
2022+ AE1B FE 02            CP STATE_FIGHTING
2023+ AE1D 28 18            JR Z, .usDrain
2024+ AE1F                  ; No atacando: regenerar
2025+ AE1F 3A DA B6         LD A, (PlayerStamina)
2026+ AE22 FE 10            CP STAMINA_MAX
2027+ AE24 C8               RET Z                               ; Ya al maximo
2028+ AE25 21 DC B6         LD HL, StaminaRegenCtr
2029+ AE28 34               INC (HL)
2030+ AE29 7E               LD A, (HL)
2031+ AE2A FE 19            CP STAMINA_REGEN_RATE
2032+ AE2C D8               RET C                               ; Aun no toca
2033+ AE2D 36 00            LD (HL), 0                          ; Reset counter
2034+ AE2F 3A DA B6         LD A, (PlayerStamina)
2035+ AE32 3C               INC A
2036+ AE33 32 DA B6         LD (PlayerStamina), A
2037+ AE36 C9               RET
2038+ AE37              .usDrain:
2039+ AE37                  ; Atacando: consumir stamina
2040+ AE37 3A DA B6         LD A, (PlayerStamina)
