 470+ 68B6              ; ==============================================================================
 471+ 68B6              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 472+ 68B6              ; ==============================================================================
 473+ 68B6              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 474+ 68B6              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 475+ 68B6              ;
 476+ 68B6              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 477+ 68B6              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 478+ 68B6              ;     E = pixel X (0-255).
 479+ 68B6              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 480+ 68B6              ; Solo XOR de pixels (no toca attrs).
 481+ 68B6              ; Destruye: AF, BC, DE, HL, IX.
 482+ 68B6              ; ==============================================================================
 483+ 68B6              DrawBgSprite16XorAtPixel:
 484+ 68B6 DD 21 7C 89      LD IX, BgSpriteBuffer
 485+ 68BA DD 7E 00         LD A, (IX+0)                            ; height_px
 486+ 68BD B7               OR A
 487+ 68BE C8               RET Z
 488+ 68BF 32 22 69         LD (.dbsHeight), A
 489+ 68C2 DD 23            INC IX
 490+ 68C4 DD 23            INC IX                                  ; -> pixel data
 491+ 68C6                  ; Shift = E & 7 ; aligned X = E & ~7
 492+ 68C6 7B               LD A, E
 493+ 68C7 E6 07            AND $07
 494+ 68C9 32 23 69         LD (.dbsShift), A
 495+ 68CC 7B               LD A, E
 496+ 68CD E6 F8            AND $F8
 497+ 68CF 5F               LD E, A
 498+ 68D0 CD 41 A1         CALL CalcPixelAddr                      ; HL = VRAM addr
 499+ 68D3              .dbsRow:
 500+ 68D3 E5               PUSH HL                                 ; save row start
 501+ 68D4                  ; --- Byte 0 del sprite ---
 502+ 68D4 DD 7E 00         LD A, (IX+0)
 503+ 68D7 2F               CPL                                     ; un-invert
 504+ 68D8 57               LD D, A                                 ; D = sprite byte
 505+ 68D9 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 506+ 68DB 3A 23 69         LD A, (.dbsShift)
 507+ 68DE B7               OR A
 508+ 68DF 28 07            JR Z, .dbsNoShift0
 509+ 68E1 47               LD B, A
 510+ 68E2              .dbsShift0Loop:
 511+ 68E2 CB 3A            SRL D
 512+ 68E4 CB 1B            RR E
 513+ 68E6 10 FA            DJNZ .dbsShift0Loop
 514+ 68E8              .dbsNoShift0:
 515+ 68E8 7A               LD A, D
 516+ 68E9 AE               XOR (HL)
 517+ 68EA 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 518+ 68EB 23               INC HL
 519+ 68EC 4B               LD C, E                                 ; C = carry para siguiente byte
 520+ 68ED                  ; --- Byte 1 del sprite ---
 521+ 68ED DD 7E 01         LD A, (IX+1)
 522+ 68F0 2F               CPL
 523+ 68F1 57               LD D, A
 524+ 68F2 1E 00            LD E, 0
 525+ 68F4 3A 23 69         LD A, (.dbsShift)
 526+ 68F7 B7               OR A
 527+ 68F8 28 07            JR Z, .dbsNoShift1
 528+ 68FA 47               LD B, A
 529+ 68FB              .dbsShift1Loop:
 530+ 68FB CB 3A            SRL D
 531+ 68FD CB 1B            RR E
 532+ 68FF 10 FA            DJNZ .dbsShift1Loop
 533+ 6901              .dbsNoShift1:
 534+ 6901 7A               LD A, D
 535+ 6902 B1               OR C                                    ; combinar con carry de byte 0
 536+ 6903 AE               XOR (HL)
 537+ 6904 77               LD (HL), A
 538+ 6905 23               INC HL
 539+ 6906 4B               LD C, E                                 ; carry para byte final
 540+ 6907                  ; --- Byte final (solo si shift>0) ---
 541+ 6907 3A 23 69         LD A, (.dbsShift)
 542+ 690A B7               OR A
 543+ 690B 28 03            JR Z, .dbsNoFinal
 544+ 690D 79               LD A, C
 545+ 690E AE               XOR (HL)
 546+ 690F 77               LD (HL), A
 547+ 6910              .dbsNoFinal:
 548+ 6910 E1               POP HL                                  ; restore row start
 549+ 6911 CD AD 9E         CALL NextPixelLine
 550+ 6914 DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 551+ 6916 DD 23            INC IX
 552+ 6918 3A 22 69         LD A, (.dbsHeight)
 553+ 691B 3D               DEC A
 554+ 691C 32 22 69         LD (.dbsHeight), A
 555+ 691F 20 B2            JR NZ, .dbsRow
 556+ 6921 C9               RET
 557+ 6922 00           .dbsHeight: DEFB 0
 558+ 6923 00           .dbsShift:  DEFB 0
