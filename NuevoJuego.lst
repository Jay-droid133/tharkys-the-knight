 821+ D471 DD 7E 00         LD A, (IX+0)
 822+ D474 DD 23            INC IX
 823+ D476 2F               CPL
 824+ D477 77               LD (HL), A
 825+ D478 23               INC HL
 826+ D479 3A F2 D4         LD A, (.rlePending)
 827+ D47C 3C               INC A                       ; hacia 0
 828+ D47D 32 F2 D4         LD (.rlePending), A
 829+ D480 10 C6            DJNZ .rlePixCol
 830+ D482 18 11            JR .rleRowDone
