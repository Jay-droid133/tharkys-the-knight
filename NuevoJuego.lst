6717+ C8D7                  ; Footprint 3x3 libre?
6718+ C8D7 CD 67 C9         CALL .bfsCanFit
6719+ C8DA C0               RET NZ
6720+ C8DB                  ; --- first_dir del nuevo entry: hereda si curFirstDir != NONE, si no usa step ---
6721+ C8DB 3A 76 5F         LD A, (DBfsCurFirstDir)
6722+ C8DE FE FF            CP MAI_DIR_NONE
6723+ C8E0 20 03            JR NZ, .nbrInherit
6724+ C8E2 3A 7A 5F         LD A, (DBfsTryDir)
6725+ C8E5              .nbrInherit:
6726+ C8E5 47               LD B, A                             ; B = first_dir para enqueue
6727+ C8E6                  ; Encolar
6728+ C8E6 2A 6D 5F         LD HL, (DBfsQTail)
6729+ C8E9 3A 78 5F         LD A, (DBfsTryCx)
6730+ C8EC 77               LD (HL), A
6731+ C8ED 23               INC HL
6732+ C8EE 3A 79 5F         LD A, (DBfsTryCy)
6733+ C8F1 77               LD (HL), A
6734+ C8F2 23               INC HL
6735+ C8F3 78               LD A, B
6736+ C8F4 77               LD (HL), A
6737+ C8F5 23               INC HL
6738+ C8F6 3A 77 5F         LD A, (DBfsCurDepth)
6739+ C8F9 3C               INC A
6740+ C8FA 77               LD (HL), A
6741+ C8FB 4F               LD C, A                             ; C = newDepth
6742+ C8FC 23               INC HL
6743+ C8FD 22 6D 5F         LD (DBfsQTail), HL
6744+ C900                  ; --- Score: max depth tie-break min manhattan ---
6745+ C900                  ; manhattan = |tryCx - playerCx| + |tryCy - playerCy|
6746+ C900 3A 78 5F         LD A, (DBfsTryCx)
6747+ C903 57               LD D, A
6748+ C904 3A 72 5F         LD A, (DBfsPlayerCx)
6749+ C907 92               SUB D
6750+ C908 30 02            JR NC, .nbrAbsX
6751+ C90A ED 44            NEG
6752+ C90C              .nbrAbsX:
6753+ C90C 57               LD D, A
6754+ C90D 3A 79 5F         LD A, (DBfsTryCy)
6755+ C910 5F               LD E, A
6756+ C911 3A 73 5F         LD A, (DBfsPlayerCy)
6757+ C914 93               SUB E
6758+ C915 30 02            JR NC, .nbrAbsY
6759+ C917 ED 44            NEG
6760+ C919              .nbrAbsY:
6761+ C919 82               ADD A, D                            ; A = manhattan
6762+ C91A 57               LD D, A
6763+ C91B                  ; Compare: depth > best ? update : (depth == best && manh < bestManh ? update : skip)
6764+ C91B 79               LD A, C
6765+ C91C 21 70 5F         LD HL, DBfsBestDepth
6766+ C91F BE               CP (HL)
6767+ C920 38 15            JR C, .nbrNoBest
6768+ C922 20 07            JR NZ, .nbrUpdate                   ; depth > bestDepth
6769+ C924 7A               LD A, D
6770+ C925 21 71 5F         LD HL, DBfsBestManh
6771+ C928 BE               CP (HL)
6772+ C929 30 0C            JR NC, .nbrNoBest                   ; manh >= best
6773+ C92B              .nbrUpdate:
6774+ C92B 79               LD A, C
6775+ C92C 32 70 5F         LD (DBfsBestDepth), A
6776+ C92F 7A               LD A, D
6777+ C930 32 71 5F         LD (DBfsBestManh), A
6778+ C933 78               LD A, B
6779+ C934 32 6F 5F         LD (DBfsBestDir), A
6780+ C937              .nbrNoBest:
6781+ C937 C9               RET
