  25+ EA05              ; --- Horas de inicio de cada fase ---
  26+ EA05              ; Distribucion equinoccial: dia (DY)=10h, noche (N1+N2)=10h, transiciones
  27+ EA05              ; (C1+C2 + A1+A2) = 4h totales (1h por fase). Anclajes fijos: medianoche
  28+ EA05              ; (00:00 → N2, dispara campanadas) y amanecer a las 05:00.
  29+ EA05              PhaseStartHour:
  30+ EA05 07 11 12 13      DEFB 7, 17, 18, 19, 0, 5, 6
  30+ EA09 00 05 06
  31+ EA0C
  32+ EA0C              ; --- Tabla de transiciones automáticas (hora, fase) ---
  33+ EA0C              PhaseTable:
  34+ EA0C 07 00            DEFB 7,  0      ; 07:00 → DY     (10h pleno dia)
  35+ EA0E 11 01            DEFB 17, 1      ; 17:00 → C1     (crepusculo 1)
  36+ EA10 12 02            DEFB 18, 2      ; 18:00 → C2     (crepusculo 2)
  37+ EA12 13 03            DEFB 19, 3      ; 19:00 → N1     (noche pre-medianoche)
  38+ EA14 00 04            DEFB 0,  4      ; 00:00 → N2     (noche con monstruos, post-campanadas)
  39+ EA16 05 05            DEFB 5,  5      ; 05:00 → A1     (amanecer 1)
  40+ EA18 06 06            DEFB 6,  6      ; 06:00 → A2     (amanecer 2)
