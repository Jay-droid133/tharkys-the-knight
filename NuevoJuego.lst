1062+ A4BD              ; ==============================================================================
1063+ A4BD              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
1064+ A4BD              ; IX = puntero a la entidad
1065+ A4BD              ; ==============================================================================
1066+ A4BD              DrawEntity:
1067+ A4BD CD F2 A4         CALL GetSpriteAddr
1068+ A4C0
1069+ A4C0                  ; Guardar attrs del fondo ANTES de pintar
1070+ A4C0 DD 56 04         LD D, (IX+ENT_POSY)
1071+ A4C3 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1072+ A4C6 5F               LD E, A
