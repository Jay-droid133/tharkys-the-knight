 662+ A521                  ; === STATE_SCARED: pausa dramatica + huida ===
 663+ A521              .peScared:
 664+ A521 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 665+ A525 C2 EA A5         JP NZ, .peScaredFresh
 666+ A528
 667+ A528                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 668+ A528 3A D4 B8         LD A, (ScareTimer)
 669+ A52B FE 33            CP SCARE_FLEE_THRESHOLD + 1
 670+ A52D DA CD A5         JP C, .peScaredFlee
 671+ A530                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 672+ A530                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 673+ A530 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 674+ A534 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 675+ A538                  ; Shake monster-only (nasties durante bells no se agitan)
 676+ A538 DD 7E 01         LD A, (IX+ENT_TYPE)
 677+ A53B FE 02            CP TYPE_MONSTER
 678+ A53D C2 B3 A5         JP NZ, .peScaredSpriteToggle
 679+ A540                  ; --- Shake ---
 680+ A540 CD 8B 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 681+ A543 5F               LD E, A
 682+ A544 16 00            LD D, 0
 683+ A546 21 E5 90         LD HL, MonsterAiFlags
 684+ A549 19               ADD HL, DE
 685+ A54A 7E               LD A, (HL)
 686+ A54B CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 687+ A54D 20 15            JR NZ, .peShakeActive
 688+ A54F                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 689+ A54F F6 08            OR MAI_FLAG_SHAKE_SAVED
 690+ A551 77               LD (HL), A
 691+ A552 21 97 5F         LD HL, MonsterShakeOrigX
 692+ A555 19               ADD HL, DE
 693+ A556 DD 7E 03         LD A, (IX+ENT_POSX)
 694+ A559 77               LD (HL), A
 695+ A55A 21 9A 5F         LD HL, MonsterShakeOrigY
 696+ A55D 19               ADD HL, DE
 697+ A55E DD 7E 04         LD A, (IX+ENT_POSY)
 698+ A561 77               LD (HL), A
 699+ A562 18 4F            JR .peScaredSpriteToggle
 700+ A564              .peShakeActive:
 701+ A564                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 702+ A564 ED 5F            LD A, R
 703+ A566 E6 03            AND 3
 704+ A568 28 0C            JR Z, .peShakeUp
 705+ A56A 3D               DEC A
 706+ A56B 28 0F            JR Z, .peShakeDown
 707+ A56D 3D               DEC A
 708+ A56E 28 12            JR Z, .peShakeLeft
 709+ A570                  ; 3: right
 710+ A570 06 01            LD B, 1
 711+ A572 0E 00            LD C, 0
 712+ A574 18 10            JR .peShakeApply
 713+ A576              .peShakeUp:
 714+ A576 06 00            LD B, 0
 715+ A578 0E FF            LD C, -1
 716+ A57A 18 0A            JR .peShakeApply
 717+ A57C              .peShakeDown:
 718+ A57C 06 00            LD B, 0
 719+ A57E 0E 01            LD C, 1
 720+ A580 18 04            JR .peShakeApply
 721+ A582              .peShakeLeft:
 722+ A582 06 FF            LD B, -1
 723+ A584 0E 00            LD C, 0
 724+ A586              .peShakeApply:
 725+ A586                  ; new POSX = orig + B, new POSY = orig + C
 726+ A586 21 97 5F         LD HL, MonsterShakeOrigX
 727+ A589 19               ADD HL, DE
 728+ A58A 7E               LD A, (HL)
 729+ A58B 80               ADD A, B
 730+ A58C DD 77 03         LD (IX+ENT_POSX), A
 731+ A58F 21 9A 5F         LD HL, MonsterShakeOrigY
 732+ A592 19               ADD HL, DE
 733+ A593 7E               LD A, (HL)
 734+ A594 81               ADD A, C
 735+ A595 DD 77 04         LD (IX+ENT_POSY), A
 736+ A598                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 737+ A598 CD A3 B9         CALL CheckEnemyCollision
 738+ A59B 28 16            JR Z, .peScaredSpriteToggle
 739+ A59D                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 740+ A59D CD 8B 92         CALL MaiGetMonsterSlot
 741+ A5A0 5F               LD E, A
 742+ A5A1 16 00            LD D, 0
 743+ A5A3 21 97 5F         LD HL, MonsterShakeOrigX
 744+ A5A6 19               ADD HL, DE
 745+ A5A7 7E               LD A, (HL)
 746+ A5A8 DD 77 03         LD (IX+ENT_POSX), A
 747+ A5AB 21 9A 5F         LD HL, MonsterShakeOrigY
 748+ A5AE 19               ADD HL, DE
 749+ A5AF 7E               LD A, (HL)
 750+ A5B0 DD 77 04         LD (IX+ENT_POSY), A
