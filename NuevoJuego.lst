 101  8AF4                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 8AF4              ; ==============================================================================
   2+ 8AF4              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 8AF4              ; ==============================================================================
   4+ 8AF4              ; - Estructura de entidad de 12 bytes (universal)
   5+ 8AF4              ; - Game loop per-entity: erase → update → draw
   6+ 8AF4              ; - Movimiento 8-bit (sin subpixel)
   7+ 8AF4              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 8AF4              ; - XOR draw/erase (una sola rutina)
   9+ 8AF4              ; ==============================================================================
  10+ 8AF4
  11+ 8AF4              ; ==============================================================================
  12+ 8AF4              ; ReadInput - Lee teclado y genera direccion + fuego
  13+ 8AF4              ; ==============================================================================
  14+ 8AF4              ReadInput:
  15+ 8AF4 AF               XOR A
  16+ 8AF5 32 92 81         LD (InputDirection), A
  17+ 8AF8 32 93 81         LD (InputFire), A
  18+ 8AFB
  19+ 8AFB                  ; --- Q (Arriba) ---
  20+ 8AFB 01 FE FB         LD BC, $FBFE
  21+ 8AFE ED 78            IN A, (C)
  22+ 8B00 CB 47            BIT 0, A
  23+ 8B02 20 08            JR NZ, .noUp
  24+ 8B04 3A 92 81         LD A, (InputDirection)
  25+ 8B07 F6 01            OR DIR_N
  26+ 8B09 32 92 81         LD (InputDirection), A
  27+ 8B0C              .noUp:
  28+ 8B0C                  ; --- A (Abajo) ---
  29+ 8B0C 01 FE FD         LD BC, $FDFE
  30+ 8B0F ED 78            IN A, (C)
  31+ 8B11 CB 47            BIT 0, A
  32+ 8B13 20 08            JR NZ, .noDown
  33+ 8B15 3A 92 81         LD A, (InputDirection)
  34+ 8B18 F6 02            OR DIR_S
  35+ 8B1A 32 92 81         LD (InputDirection), A
  36+ 8B1D              .noDown:
  37+ 8B1D                  ; --- O (Izquierda) ---
  38+ 8B1D 01 FE DF         LD BC, $DFFE
  39+ 8B20 ED 78            IN A, (C)
  40+ 8B22 CB 4F            BIT 1, A
  41+ 8B24 20 08            JR NZ, .noLeft
  42+ 8B26 3A 92 81         LD A, (InputDirection)
  43+ 8B29 F6 08            OR DIR_W
  44+ 8B2B 32 92 81         LD (InputDirection), A
  45+ 8B2E              .noLeft:
  46+ 8B2E                  ; --- P (Derecha) ---
  47+ 8B2E 01 FE DF         LD BC, $DFFE
  48+ 8B31 ED 78            IN A, (C)
  49+ 8B33 CB 47            BIT 0, A
  50+ 8B35 20 08            JR NZ, .noRight
  51+ 8B37 3A 92 81         LD A, (InputDirection)
  52+ 8B3A F6 04            OR DIR_E
  53+ 8B3C 32 92 81         LD (InputDirection), A
  54+ 8B3F              .noRight:
  55+ 8B3F                  ; --- SPACE (Fuego) ---
  56+ 8B3F 01 FE 7F         LD BC, $7FFE
  57+ 8B42 ED 78            IN A, (C)
  58+ 8B44 CB 47            BIT 0, A
  59+ 8B46 20 05            JR NZ, .noFire
  60+ 8B48 3E 01            LD A, 1
  61+ 8B4A 32 93 81         LD (InputFire), A
  62+ 8B4D              .noFire:
  63+ 8B4D                  ; Cancelar opuestos
  64+ 8B4D 3A 92 81         LD A, (InputDirection)
  65+ 8B50 47               LD B, A
  66+ 8B51 E6 03            AND DIR_N | DIR_S
  67+ 8B53 FE 03            CP DIR_N | DIR_S
  68+ 8B55 20 04            JR NZ, .noVC
  69+ 8B57 78               LD A, B
  70+ 8B58 E6 FC            AND ~(DIR_N | DIR_S) & $FF
  71+ 8B5A 47               LD B, A
  72+ 8B5B              .noVC:
  73+ 8B5B 78               LD A, B
  74+ 8B5C E6 0C            AND DIR_E | DIR_W
  75+ 8B5E FE 0C            CP DIR_E | DIR_W
  76+ 8B60 20 04            JR NZ, .noHC
  77+ 8B62 78               LD A, B
  78+ 8B63 E6 F3            AND ~(DIR_E | DIR_W) & $FF
  79+ 8B65 47               LD B, A
  80+ 8B66              .noHC:
  81+ 8B66 78               LD A, B
  82+ 8B67 32 92 81         LD (InputDirection), A
  83+ 8B6A C9               RET
  84+ 8B6B
  85+ 8B6B              ; ==============================================================================
  86+ 8B6B              ; InitEntities - Inicializa la tabla de entidades
  87+ 8B6B              ; ==============================================================================
  88+ 8B6B              ; Limpia todos los slots y configura el slot 0 como player.
  89+ 8B6B              ; ==============================================================================
  90+ 8B6B              InitEntities:
  91+ 8B6B                  ; Limpiar toda la tabla a ceros
  92+ 8B6B 21 82 80         LD HL, EntityTable
  93+ 8B6E 11 83 80         LD DE, EntityTable + 1
  94+ 8B71 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
  95+ 8B74 AF               XOR A
  96+ 8B75 77               LD (HL), A
  97+ 8B76 ED B0            LDIR
  98+ 8B78
  99+ 8B78                  ; Limpiar tabla de atributos salvados
 100+ 8B78 21 11 89         LD HL, SavedAttrTable
 101+ 8B7B 11 12 89         LD DE, SavedAttrTable + 1
 102+ 8B7E 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 103+ 8B81 AF               XOR A
 104+ 8B82 77               LD (HL), A
 105+ 8B83 ED B0            LDIR
 106+ 8B85
 107+ 8B85                  ; Configurar slot 0: Player
 108+ 8B85 DD 21 82 80      LD IX, EntityTable
 109+ 8B89 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 110+ 8B8D DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 111+ 8B91 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 112+ 8B95 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 113+ 8B99 DD 36 04 58      LD (IX+ENT_POSY), START_PLAYER_Y
 114+ 8B9D DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 115+ 8BA1 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 116+ 8BA5 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 117+ 8BA9 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 118+ 8BAD DD 36 09 14      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 119+ 8BB1 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 120+ 8BB5 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 121+ 8BB9 DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 122+ 8BBD DD 36 0D 58      LD (IX+ENT_OLDY), START_PLAYER_Y
 123+ 8BC1 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 124+ 8BC5 DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
 125+ 8BC9
 126+ 8BC9                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 127+ 8BC9 3E 32            LD A, SPAWN_INTERVAL
 128+ 8BCB 32 95 81         LD (SpawnTimer), A
 129+ 8BCE AF               XOR A
 130+ 8BCF 32 96 81         LD (EnemyStepIdx), A
 131+ 8BD2 32 9C 81         LD (PendingEraseCount), A
 132+ 8BD5 C9               RET
 133+ 8BD6
 134+ 8BD6              ; ==============================================================================
 135+ 8BD6              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 136+ 8BD6              ; ==============================================================================
 137+ 8BD6              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 138+ 8BD6              ; ==============================================================================
 139+ 8BD6              ProcessPlayer:
 140+ 8BD6 DD 21 82 80      LD IX, EntityTable
 141+ 8BDA
 142+ 8BDA                  ; --- Fresh check ---
 143+ 8BDA 3A B3 81         LD A, (ScreenJustRedrawn)
 144+ 8BDD B7               OR A
 145+ 8BDE C2 B0 8C         JP NZ, .plFresh
 146+ 8BE1 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 147+ 8BE5 C2 B0 8C         JP NZ, .plFresh
 148+ 8BE8
 149+ 8BE8                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 150+ 8BE8 CD 68 90         CALL UpdatePlayer
 151+ 8BEB CD FA 8F         CALL CalcDrawX
 152+ 8BEE
 153+ 8BEE                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 154+ 8BEE DD 7E 0F         LD A, (IX+ENT_DRAWX)
 155+ 8BF1 DD BE 0C         CP (IX+ENT_OLDX)
 156+ 8BF4 20 45            JR NZ, .plDoErase
 157+ 8BF6 DD 7E 04         LD A, (IX+ENT_POSY)
 158+ 8BF9 DD BE 0D         CP (IX+ENT_OLDY)
 159+ 8BFC 20 3D            JR NZ, .plDoErase
 160+ 8BFE DD 7E 00         LD A, (IX+ENT_SPRITEID)
 161+ 8C01 DD BE 0E         CP (IX+ENT_OLDSPRID)
 162+ 8C04 20 35            JR NZ, .plDoErase
 163+ 8C06                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 164+ 8C06 3A 73 A8         LD A, (PlayerHitTimer)
 165+ 8C09 B7               OR A
 166+ 8C0A 20 01            JR NZ, .plRepaintAttr
 167+ 8C0C C9               RET                                 ; Nada cambio → skip todo
 168+ 8C0D              .plRepaintAttr:
 169+ 8C0D DD 56 04         LD D, (IX+ENT_POSY)
 170+ 8C10 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 171+ 8C13 5F               LD E, A
 172+ 8C14 DD E5            PUSH IX
 173+ 8C16 CD 3F 90         CALL GetSpriteAddr
 174+ 8C19 DD 2A 52 90      LD IX, (SpriteAddrTemp)
 175+ 8C1D CD 7E 88         CALL CalcEntityAttrSize
 176+ 8C20                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 177+ 8C20 3A 10 89         LD A, (EntityAttrH)
 178+ 8C23 FE 02            CP 2
 179+ 8C25 38 04            JR C, .plAttrHOk
 180+ 8C27 3D               DEC A
 181+ 8C28 32 10 89         LD (EntityAttrH), A
 182+ 8C2B              .plAttrHOk:
 183+ 8C2B DD E1            POP IX
 184+ 8C2D DD 56 04         LD D, (IX+ENT_POSY)
 185+ 8C30 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 186+ 8C33 5F               LD E, A
 187+ 8C34 DD 7E 05         LD A, (IX+ENT_ATTR)
 188+ 8C37 CD 51 88         CALL SetEntityAttr
 189+ 8C3A C9               RET
 190+ 8C3B
 191+ 8C3B              .plDoErase:
 192+ 8C3B                  ; --- Erase viejo ---
 193+ 8C3B DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
 194+ 8C3E 6F               LD L, A
 195+ 8C3F 26 00            LD H, 0
 196+ 8C41 29               ADD HL, HL
 197+ 8C42 11 A7 CA         LD DE, SpriteFrameTable
 198+ 8C45 19               ADD HL, DE
 199+ 8C46 5E               LD E, (HL)
 200+ 8C47 23               INC HL
 201+ 8C48 56               LD D, (HL)
 202+ 8C49 ED 53 F8 8F      LD (OldSprAddr), DE
 203+ 8C4D DD 7E 0D         LD A, (IX+ENT_OLDY)
 204+ 8C50 57               LD D, A
 205+ 8C51 DD 7E 0C         LD A, (IX+ENT_OLDX)
 206+ 8C54 5F               LD E, A
 207+ 8C55 DD E5            PUSH IX
 208+ 8C57 DD 2A F8 8F      LD IX, (OldSprAddr)
 209+ 8C5B CD 81 87         CALL DrawSprite
 210+ 8C5E DD E1            POP IX
 211+ 8C60                  ; Restaurar atributos del fondo en posicion vieja
 212+ 8C60 DD 56 0D         LD D, (IX+ENT_OLDY)
 213+ 8C63 DD 5E 0C         LD E, (IX+ENT_OLDX)
 214+ 8C66 CD 52 AB         CALL RestoreOldAttr
 215+ 8C69                  ; --- Draw nuevo ---
 216+ 8C69 CD 3F 90         CALL GetSpriteAddr
 217+ 8C6C DD 56 04         LD D, (IX+ENT_POSY)
 218+ 8C6F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 219+ 8C72 5F               LD E, A
 220+ 8C73 DD E5            PUSH IX
 221+ 8C75 DD 2A 52 90      LD IX, (SpriteAddrTemp)
 222+ 8C79 CD 81 87         CALL DrawSprite
 223+ 8C7C DD E1            POP IX
 224+ 8C7E
 225+ 8C7E                  ; Pintar attr
 226+ 8C7E DD 56 04         LD D, (IX+ENT_POSY)
 227+ 8C81 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 228+ 8C84 5F               LD E, A
 229+ 8C85 DD E5            PUSH IX
 230+ 8C87 DD 2A 52 90      LD IX, (SpriteAddrTemp)
 231+ 8C8B CD 7E 88         CALL CalcEntityAttrSize
 232+ 8C8E DD E1            POP IX
 233+ 8C90 DD 56 04         LD D, (IX+ENT_POSY)
 234+ 8C93 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 235+ 8C96 5F               LD E, A
 236+ 8C97 DD 7E 05         LD A, (IX+ENT_ATTR)
 237+ 8C9A CD 51 88         CALL SetEntityAttr
 238+ 8C9D
 239+ 8C9D                  ; Guardar old = actual
 240+ 8C9D              .plSaveOld:
 241+ 8C9D DD 7E 0F         LD A, (IX+ENT_DRAWX)
 242+ 8CA0 DD 77 0C         LD (IX+ENT_OLDX), A
 243+ 8CA3 DD 7E 04         LD A, (IX+ENT_POSY)
 244+ 8CA6 DD 77 0D         LD (IX+ENT_OLDY), A
 245+ 8CA9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 246+ 8CAC DD 77 0E         LD (IX+ENT_OLDSPRID), A
 247+ 8CAF C9               RET
 248+ 8CB0
 249+ 8CB0                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 250+ 8CB0              .plFresh:
 251+ 8CB0 DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 252+ 8CB4 CD 68 90         CALL UpdatePlayer
 253+ 8CB7 CD FA 8F         CALL CalcDrawX
 254+ 8CBA CD 3F 90         CALL GetSpriteAddr
 255+ 8CBD
 256+ 8CBD DD 56 04         LD D, (IX+ENT_POSY)
 257+ 8CC0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 258+ 8CC3 5F               LD E, A
 259+ 8CC4 DD E5            PUSH IX
 260+ 8CC6 DD 2A 52 90      LD IX, (SpriteAddrTemp)
 261+ 8CCA CD 7E 88         CALL CalcEntityAttrSize
 262+ 8CCD DD E1            POP IX
