 237  906B                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 906B              ; ==============================================================================
   2+ 906B              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 906B              ; ==============================================================================
   4+ 906B              ; Port $7FFD (write-only):
   5+ 906B              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 906B              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 906B              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 906B              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 906B              ;
  10+ 906B              ; Bancos disponibles:
  11+ 906B              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 906B              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 906B              ;   Bank 1: libre para datos nuevos (contended)
  14+ 906B              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 906B              ;   Bank 3: libre para datos nuevos (contended)
  16+ 906B              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 906B              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 906B              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 906B              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 906B              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 906B              ; ==============================================================================
  22+ 906B
  23+ 906B              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 906B              ; para no machacarse a si mismas al cambiar de banco.
  25+ 906B
  26+ 906B              ; ==============================================================================
  27+ 906B              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 906B              ; ==============================================================================
  29+ 906B              ; Entrada: A = banco (0-7)
  30+ 906B              ; Preserva: HL, DE, IX, IY
  31+ 906B              ; Destruye: A, BC
  32+ 906B              ; ==============================================================================
  33+ 906B              PageBankSlot3:
  34+ 906B E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 906D 47               LD B, A                     ; guardar banco nuevo
  36+ 906E 3A 57 90         LD A, (CurrentPaging)
  37+ 9071 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 9073 B0               OR B                        ; poner nuevo banco
  39+ 9074 32 57 90         LD (CurrentPaging), A
  40+ 9077 01 FD 7F         LD BC, $7FFD
  41+ 907A ED 79            OUT (C), A
  42+ 907C C9               RET
  43+ 907D
  44+ 907D              ; ==============================================================================
  45+ 907D              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 907D              ; ==============================================================================
  47+ 907D              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 907D              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 907D              ; ==============================================================================
  50+ 907D              InitPaging:
  51+ 907D 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 907F 32 57 90         LD (CurrentPaging), A
  53+ 9082 01 FD 7F         LD BC, $7FFD
  54+ 9085 ED 79            OUT (C), A
  55+ 9087 C9               RET
  56+ 9088
  57+ 9088              ; ==============================================================================
  58+ 9088              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 9088              ; ==============================================================================
  60+ 9088              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 9088              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 9088              ;      Paginacion restaurada a bank 0.
  63+ 9088              ; Destruye: A, BC, DE, HL
  64+ 9088              ;
  65+ 9088              ; Formato del room en FUENTE (variable-length):
  66+ 9088              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 9088              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 9088              ;   terminador:                  DEFB $FF
  69+ 9088              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 9088              ;
  71+ 9088              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 9088              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 9088              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 9088              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 9088              ; ==============================================================================
  76+ 9088              LoadRoomToBuffer:
  77+ 9088                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 9088                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 9088                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 9088                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 9088                  ;
  82+ 9088                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 9088                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 9088                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 9088                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 9088 F3               DI
  87+ 9089                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 9089 3A 57 90         LD A, (CurrentPaging)
  89+ 908C E6 F8            AND $F8
  90+ 908E F6 01            OR 1
  91+ 9090 32 57 90         LD (CurrentPaging), A
  92+ 9093 01 FD 7F         LD BC, $7FFD
  93+ 9096 ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 9098                  ; --- Copy + decompress loop ---
  95+ 9098                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 9098                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 9098 11 0A 85         LD DE, CurrentScreenBuffer
  98+ 909B              .lrbLoop:
  99+ 909B 7E               LD A, (HL)                      ; id
 100+ 909C 12               LD (DE), A
 101+ 909D 23               INC HL
 102+ 909E 13               INC DE
 103+ 909F FE FF            CP $FF                          ; terminador?
 104+ 90A1 28 1B            JR Z, .lrbDone
 105+ 90A3                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 90A3                  ; al buffer escribimos x limpio (AND $7F).
 107+ 90A3 7E               LD A, (HL)
 108+ 90A4 23               INC HL
 109+ 90A5 47               LD B, A                         ; B = x raw (con flag)
 110+ 90A6 E6 7F            AND $7F
 111+ 90A8 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 90A9 13               INC DE
 113+ 90AA                  ; Copiar y
 114+ 90AA 7E               LD A, (HL)
 115+ 90AB 12               LD (DE), A
 116+ 90AC 23               INC HL
 117+ 90AD 13               INC DE
 118+ 90AE                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 90AE CB 78            BIT 7, B
 120+ 90B0 28 06            JR Z, .lrbNoTint
 121+ 90B2 7E               LD A, (HL)                      ; v desde source
 122+ 90B3 23               INC HL
 123+ 90B4 12               LD (DE), A
 124+ 90B5 13               INC DE
 125+ 90B6 18 E3            JR .lrbLoop
 126+ 90B8              .lrbNoTint:
 127+ 90B8 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 90BA 12               LD (DE), A
 129+ 90BB 13               INC DE
 130+ 90BC 18 DD            JR .lrbLoop
 131+ 90BE              .lrbDone:
 132+ 90BE                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 90BE 3A 57 90         LD A, (CurrentPaging)
 134+ 90C1 E6 F8            AND $F8                         ; bank 0
 135+ 90C3 32 57 90         LD (CurrentPaging), A
 136+ 90C6 01 FD 7F         LD BC, $7FFD
 137+ 90C9 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 90CB                  ; Restaurar interrupciones si Inicio ya termino
 139+ 90CB 3A DB 80         LD A, (StartupComplete)
 140+ 90CE B7               OR A
 141+ 90CF C8               RET Z                           ; aun en Inicio -> dejar DI
 142+ 90D0 FB               EI
 143+ 90D1 C9               RET
 144+ 90D2
 145+ 90D2              ; ==============================================================================
 146+ 90D2              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 147+ 90D2              ; ==============================================================================
 148+ 90D2              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 149+ 90D2              ;      A  = bank (0-7) donde vive el sprite
 150+ 90D2              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 151+ 90D2              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 152+ 90D2              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 153+ 90D2              ;
 154+ 90D2              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 155+ 90D2              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 156+ 90D2              ; forzar EI prematuro en startup.
 157+ 90D2              ;
 158+ 90D2              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 159+ 90D2              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 160+ 90D2              ; ==============================================================================
 161+ 90D2              LoadBgSpriteToBuffer:
 162+ 90D2                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 163+ 90D2                  ; necesitan intacto, y los registros alternos se usan abajo).
 164+ 90D2 32 61 91         LD (.lbsBankSave), A
 165+ 90D5                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 166+ 90D5                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 167+ 90D5 C5               PUSH BC
 168+ 90D6                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 169+ 90D6 F3               DI
 170+ 90D7                  ; Page bank deseado inline
 171+ 90D7 3A 57 90         LD A, (CurrentPaging)
 172+ 90DA E6 F8            AND $F8
 173+ 90DC 47               LD B, A                         ; B = paging limpio sin bank
 174+ 90DD 3A 61 91         LD A, (.lbsBankSave)
 175+ 90E0 E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 90E2 B0               OR B                            ; merge bank en paging
 177+ 90E3 32 57 90         LD (CurrentPaging), A
 178+ 90E6 01 FD 7F         LD BC, $7FFD
 179+ 90E9 ED 79            OUT (C), A
 180+ 90EB                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 90EB                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 90EB                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 90EB                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 90EB 11 0A 89         LD DE, BgSpriteBuffer
 185+ 90EE                  ; Copiar H (header byte 0)
 186+ 90EE 7E               LD A, (HL)
 187+ 90EF 12               LD (DE), A
 188+ 90F0 32 5F 91         LD (.lbsHsave), A
 189+ 90F3 23               INC HL
 190+ 90F4 13               INC DE
 191+ 90F5                  ; Copiar W|RLE (header byte 1)
 192+ 90F5 7E               LD A, (HL)
 193+ 90F6 12               LD (DE), A
 194+ 90F7 23               INC HL
 195+ 90F8 13               INC DE
 196+ 90F9 CB 7F            BIT 7, A
 197+ 90FB 20 47            JR NZ, .lbsRleFallback
 198+ 90FD E6 7F            AND $7F
 199+ 90FF 32 60 91         LD (.lbsWsave), A
 200+ 9102                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 9102 3A 5F 91         LD A, (.lbsHsave)
 202+ 9105 B7               OR A
 203+ 9106 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 9108 47               LD B, A                         ; B = H (outer loop)
 205+ 9109              .lbsPixRow:
 206+ 9109 3A 60 91         LD A, (.lbsWsave)
 207+ 910C B7               OR A
 208+ 910D 28 08            JR Z, .lbsPixRowDone
 209+ 910F 4F               LD C, A                         ; C = W (inner loop)
 210+ 9110              .lbsPixCol:
 211+ 9110 7E               LD A, (HL)
 212+ 9111 12               LD (DE), A
 213+ 9112 23               INC HL
 214+ 9113 13               INC DE
 215+ 9114 0D               DEC C
 216+ 9115 20 F9            JR NZ, .lbsPixCol
 217+ 9117              .lbsPixRowDone:
 218+ 9117 10 F0            DJNZ .lbsPixRow
 219+ 9119              .lbsAfterPixels:
 220+ 9119                  ; --- Copiar 1 byte tint ---
 221+ 9119 7E               LD A, (HL)
 222+ 911A 12               LD (DE), A
 223+ 911B 23               INC HL
 224+ 911C 13               INC DE
 225+ 911D                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 226+ 911D 7E               LD A, (HL)
 227+ 911E 12               LD (DE), A
 228+ 911F 32 5F 91         LD (.lbsHsave), A               ; reusar var
 229+ 9122 23               INC HL
 230+ 9123 13               INC DE
 231+ 9124 7E               LD A, (HL)
 232+ 9125 12               LD (DE), A
 233+ 9126 32 60 91         LD (.lbsWsave), A
 234+ 9129 23               INC HL
 235+ 912A 13               INC DE
 236+ 912B 3A 5F 91         LD A, (.lbsHsave)
 237+ 912E B7               OR A
 238+ 912F 28 18            JR Z, .lbsLoadDone              ; sin attrs
 239+ 9131 47               LD B, A
 240+ 9132              .lbsAttrRow:
 241+ 9132 3A 60 91         LD A, (.lbsWsave)
 242+ 9135 B7               OR A
 243+ 9136 28 08            JR Z, .lbsAttrRowDone
 244+ 9138 4F               LD C, A
 245+ 9139              .lbsAttrCol:
 246+ 9139 7E               LD A, (HL)
 247+ 913A 12               LD (DE), A
 248+ 913B 23               INC HL
 249+ 913C 13               INC DE
 250+ 913D 0D               DEC C
 251+ 913E 20 F9            JR NZ, .lbsAttrCol
 252+ 9140              .lbsAttrRowDone:
 253+ 9140 10 F0            DJNZ .lbsAttrRow
 254+ 9142 18 05            JR .lbsLoadDone
