 329+ 6CC2              ; ==============================================================================
 330+ 6CC2              ; DrawPendingTomb - Pinta tumba in-place tras la animacion de muerte
 331+ 6CC2              ; ==============================================================================
 332+ 6CC2              ; Llamado desde MainLoop tras ProcessPlayer. Si TombDrawPending=1: ProcessPlayer
 333+ 6CC2              ; en este frame hizo XOR-erase del sprite de muerte (ya invisible), asi que
 334+ 6CC2              ; dibujar la tumba en (CorpseX, CorpseY) la deja "in-place" sobre la sala
 335+ 6CC2              ; actual. Consume el flag.
 336+ 6CC2              ;
 337+ 6CC2              ; Tras el draw, parchea CleanAttrMap con los 6 chars (3x2) que ocupa la tumba
 338+ 6CC2              ; para que RestoreOldAttr (entidades que pisen la tumba) preserve sus attrs
 339+ 6CC2              ; en vez del BG original. Al re-entrar a la sala, DrawTombstonesInRoom +
 340+ 6CC2              ; SaveCleanAttrs vuelve a sincronizar todo.
 341+ 6CC2              ; ==============================================================================
 342+ 6CC2              DrawPendingTomb:
 343+ 6CC2 3A 99 82         LD A, (TombDrawPending)
 344+ 6CC5 B7               OR A
 345+ 6CC6 C8               RET Z
 346+ 6CC7 AF               XOR A
 347+ 6CC8 32 99 82         LD (TombDrawPending), A             ; consumir
 348+ 6CCB
 349+ 6CCB 21 13 EE         LD HL, BgGfx_tomb
 350+ 6CCE 3E 03            LD A, 3
 351+ 6CD0 CD 7A 6A         CALL LoadBgSpriteToBuffer
 352+ 6CD3
 353+ 6CD3 3A 96 82         LD A, (CorpseX)
 354+ 6CD6 CB 3F            SRL A
 355+ 6CD8 CB 3F            SRL A
 356+ 6CDA CB 3F            SRL A                               ; x_char = posX / 8
 357+ 6CDC 47               LD B, A
 358+ 6CDD 3A 97 82         LD A, (CorpseY)
 359+ 6CE0 CB 3F            SRL A
 360+ 6CE2 CB 3F            SRL A
 361+ 6CE4 CB 3F            SRL A                               ; abs_char_y = posY / 8
 362+ 6CE6 D6 02            SUB BG_Y_OFFSET                     ; DrawBgGfxSprite re-suma BG_Y_OFFSET
 363+ 6CE8 4F               LD C, A
 364+ 6CE9 DD 21 9A 89      LD IX, BgSpriteBuffer
 365+ 6CED CD EA D3         CALL DrawBgGfxSprite
 366+ 6CF0
 367+ 6CF0                  ; Override attrs cyan fijo (sin remap day/night) + patch CleanAttrMap
 368+ 6CF0 3A 96 82         LD A, (CorpseX)
 369+ 6CF3 47               LD B, A
 370+ 6CF4 3A 97 82         LD A, (CorpseY)
 371+ 6CF7 4F               LD C, A
 372+ 6CF8 C3 12 6C         JP WriteTombAttrsCyan               ; tail call
 373+ 6CFB
