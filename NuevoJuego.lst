 233+ 7231              ; ==============================================================================
 234+ 7231              ; ComputeMagicCompassPath - BFS reverse desde Objective hasta Current
 235+ 7231              ; ==============================================================================
 236+ 7231              ; Lee RoomExitsTable (slot 1) y calcula la dirección que el player debe tomar
 237+ 7231              ; en la sala actual para acercarse al hito por la ruta sala-a-sala más corta.
 238+ 7231              ;
 239+ 7231              ; Algoritmo:
 240+ 7231              ;   1. queue.push(target_sid); visited[target] = 1.
 241+ 7231              ;   2. Mientras queue no vacía:
 242+ 7231              ;        R = queue.pop()
 243+ 7231              ;        Para cada side N/E/S/W donde RoomExitsTable[R] tiene exit:
 244+ 7231              ;          V = sid_neighbor(R, side)
 245+ 7231              ;          Si visited[V]: skip
 246+ 7231              ;          Si V == current_sid: dir = direction(current → R); STORE; RETURN
 247+ 7231              ;          visited[V] = 1; queue.push(V)
 248+ 7231              ;   3. Sin path: MagicCompassPathDir = $FF.
 249+ 7231              ;
 250+ 7231              ; OUT: MagicCompassPathDir = 0=N, 1=E, 2=S, 3=W; o $FF si sin path.
 251+ 7231              ; Destruye: AF, BC, DE, HL.
 252+ 7231              ; ==============================================================================
 253+ 7231              ComputeMagicCompassPath:
 254+ 7231                  ; --- Sid current y target ---
 255+ 7231 3A AE 82         LD A, (CurrentScreenY)
 256+ 7234 07               RLCA
 257+ 7235 07               RLCA
 258+ 7236 07               RLCA
 259+ 7237 07               RLCA                                 ; Y*16
 260+ 7238 21 AD 82         LD HL, CurrentScreenX
 261+ 723B 86               ADD A, (HL)
 262+ 723C 32 E3 73         LD (.cmcpCurSid), A
 263+ 723F
 264+ 723F 3A 67 82         LD A, (ObjectiveScreenX)
 265+ 7242 FE FF            CP $FF
 266+ 7244 CA 24 73         JP Z, .cmcpNoPath
 267+ 7247 3A 68 82         LD A, (ObjectiveScreenY)
 268+ 724A 07               RLCA
 269+ 724B 07               RLCA
 270+ 724C 07               RLCA
 271+ 724D 07               RLCA
 272+ 724E 21 67 82         LD HL, ObjectiveScreenX
 273+ 7251 86               ADD A, (HL)
 274+ 7252 32 E4 73         LD (.cmcpTgtSid), A
 275+ 7255
 276+ 7255                  ; Si target == current: no hay ruta inter-sala (X blanca lo gestiona)
 277+ 7255 47               LD B, A
 278+ 7256 3A E3 73         LD A, (.cmcpCurSid)
 279+ 7259 B8               CP B
 280+ 725A CA 24 73         JP Z, .cmcpNoPath
 281+ 725D
 282+ 725D                  ; --- Clear visited bitmap (32 bytes) ---
 283+ 725D 21 09 60         LD HL, MagicCompassVisited
 284+ 7260 11 0A 60         LD DE, MagicCompassVisited + 1
 285+ 7263 01 1F 00         LD BC, 31
 286+ 7266 AF               XOR A
 287+ 7267 77               LD (HL), A
 288+ 7268 ED B0            LDIR
 289+ 726A
 290+ 726A                  ; --- Inicializar cola con target ---
 291+ 726A AF               XOR A
 292+ 726B 32 07 60         LD (MagicCompassBfsHead), A
 293+ 726E 32 08 60         LD (MagicCompassBfsTail), A
 294+ 7271 3A E4 73         LD A, (.cmcpTgtSid)
