7207+ C725              ; ==============================================================================
7208+ C725              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7209+ C725              ; ==============================================================================
7210+ C725              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7211+ C725              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7212+ C725              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7213+ C725              ; el primer paso (N/S/W/E) desde el inicio.
7214+ C725              ;
7215+ C725              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7216+ C725              ; consistente con CheckEnemyCollision en cell-aligned positions).
7217+ C725              ;
7218+ C725              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7219+ C725              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7220+ C725              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7221+ C725              ; paso pero permite llegar a una celda mas profunda con dist menor).
7222+ C725              ;
7223+ C725              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7224+ C725              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7225+ C725              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7226+ C725              ;
7227+ C725              ; IX = SLOT_DEATH al entrar.
7228+ C725              ; ==============================================================================
7229+ C725              DeathBfsRescue:
7230+ C725                  ; --- Celda inicial = celda actual de Death ---
7231+ C725 DD 7E 03         LD A, (IX+ENT_POSX)
7232+ C728 0F               RRCA
7233+ C729 0F               RRCA
7234+ C72A 0F               RRCA
7235+ C72B E6 1F            AND $1F
7236+ C72D 32 74 5F         LD (DBfsCurCx), A
7237+ C730 DD 7E 04         LD A, (IX+ENT_POSY)
7238+ C733 D6 10            SUB SCREEN_MIN_Y
7239+ C735 0F               RRCA
7240+ C736 0F               RRCA
7241+ C737 0F               RRCA
7242+ C738 E6 1F            AND $1F
7243+ C73A 32 75 5F         LD (DBfsCurCy), A
7244+ C73D                  ; --- Celda del player ---
7245+ C73D 3A 9E 81         LD A, (EntityTable + ENT_POSX)
7246+ C740 0F               RRCA
7247+ C741 0F               RRCA
7248+ C742 0F               RRCA
7249+ C743 E6 1F            AND $1F
7250+ C745 32 72 5F         LD (DBfsPlayerCx), A
7251+ C748 3A 9F 81         LD A, (EntityTable + ENT_POSY)
7252+ C74B D6 10            SUB SCREEN_MIN_Y
7253+ C74D 0F               RRCA
7254+ C74E 0F               RRCA
7255+ C74F 0F               RRCA
7256+ C750 E6 1F            AND $1F
7257+ C752 32 73 5F         LD (DBfsPlayerCy), A
7258+ C755                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7259+ C755 21 FF 5E         LD HL, DBfsQueue
7260+ C758 22 6B 5F         LD (DBfsQHead), HL
7261+ C75B 3A 74 5F         LD A, (DBfsCurCx)
7262+ C75E 77               LD (HL), A
7263+ C75F 23               INC HL
7264+ C760 3A 75 5F         LD A, (DBfsCurCy)
7265+ C763 77               LD (HL), A
7266+ C764 23               INC HL
7267+ C765 36 FF            LD (HL), MAI_DIR_NONE
7268+ C767 23               INC HL
7269+ C768 36 00            LD (HL), 0
7270+ C76A 23               INC HL
7271+ C76B 22 6D 5F         LD (DBfsQTail), HL
7272+ C76E                  ; Best inicial: ningun candidato
7273+ C76E 3E FF            LD A, MAI_DIR_NONE
7274+ C770 32 6F 5F         LD (DBfsBestDir), A
7275+ C773 AF               XOR A
7276+ C774 32 70 5F         LD (DBfsBestDepth), A
7277+ C777 3E FF            LD A, $FF
7278+ C779 32 71 5F         LD (DBfsBestManh), A
7279+ C77C
7280+ C77C              .bfsLoop:
7281+ C77C                  ; Queue empty?
7282+ C77C 2A 6B 5F         LD HL, (DBfsQHead)
7283+ C77F ED 5B 6D 5F      LD DE, (DBfsQTail)
7284+ C783 B7               OR A
7285+ C784 ED 52            SBC HL, DE
7286+ C786 CA F5 C7         JP Z, .bfsApply
7287+ C789                  ; Dequeue
7288+ C789 2A 6B 5F         LD HL, (DBfsQHead)
7289+ C78C 7E               LD A, (HL)
7290+ C78D 32 74 5F         LD (DBfsCurCx), A
7291+ C790 23               INC HL
7292+ C791 7E               LD A, (HL)
7293+ C792 32 75 5F         LD (DBfsCurCy), A
7294+ C795 23               INC HL
7295+ C796 7E               LD A, (HL)
7296+ C797 32 76 5F         LD (DBfsCurFirstDir), A
7297+ C79A 23               INC HL
7298+ C79B 7E               LD A, (HL)
7299+ C79C 32 77 5F         LD (DBfsCurDepth), A
7300+ C79F 23               INC HL
7301+ C7A0 22 6B 5F         LD (DBfsQHead), HL
7302+ C7A3                  ; Si depth ya >= max, no expandir vecinos
7303+ C7A3 3A 77 5F         LD A, (DBfsCurDepth)
7304+ C7A6 FE 03            CP DEATH_BFS_MAX_DEPTH
7305+ C7A8 D2 7C C7         JP NC, .bfsLoop
7306+ C7AB
7307+ C7AB                  ; --- Expandir 4 vecinos ---
7308+ C7AB                  ; N: cy-1
7309+ C7AB 3A 75 5F         LD A, (DBfsCurCy)
7310+ C7AE B7               OR A
7311+ C7AF 28 0B            JR Z, .bfsTryS
7312+ C7B1 3D               DEC A
7313+ C7B2 4F               LD C, A
7314+ C7B3 3A 74 5F         LD A, (DBfsCurCx)
7315+ C7B6 47               LD B, A
7316+ C7B7 3E 00            LD A, MAI_DIR_N
7317+ C7B9 CD 5E C8         CALL .bfsTryNbr
7318+ C7BC              .bfsTryS:
7319+ C7BC 3A 75 5F         LD A, (DBfsCurCy)
7320+ C7BF FE 15            CP 21
7321+ C7C1 30 0B            JR NC, .bfsTryW
7322+ C7C3 3C               INC A
7323+ C7C4 4F               LD C, A
7324+ C7C5 3A 74 5F         LD A, (DBfsCurCx)
7325+ C7C8 47               LD B, A
7326+ C7C9 3E 01            LD A, MAI_DIR_S
7327+ C7CB CD 5E C8         CALL .bfsTryNbr
7328+ C7CE              .bfsTryW:
7329+ C7CE 3A 74 5F         LD A, (DBfsCurCx)
7330+ C7D1 B7               OR A
7331+ C7D2 28 0B            JR Z, .bfsTryE
7332+ C7D4 3D               DEC A
7333+ C7D5 47               LD B, A
7334+ C7D6 3A 75 5F         LD A, (DBfsCurCy)
7335+ C7D9 4F               LD C, A
7336+ C7DA 3E 02            LD A, MAI_DIR_W
7337+ C7DC CD 5E C8         CALL .bfsTryNbr
7338+ C7DF              .bfsTryE:
7339+ C7DF 3A 74 5F         LD A, (DBfsCurCx)
7340+ C7E2 FE 1F            CP 31
7341+ C7E4 D2 7C C7         JP NC, .bfsLoop
7342+ C7E7 3C               INC A
7343+ C7E8 47               LD B, A
7344+ C7E9 3A 75 5F         LD A, (DBfsCurCy)
7345+ C7EC 4F               LD C, A
7346+ C7ED 3E 03            LD A, MAI_DIR_E
7347+ C7EF CD 5E C8         CALL .bfsTryNbr
7348+ C7F2 C3 7C C7         JP .bfsLoop
7349+ C7F5
7350+ C7F5              .bfsApply:
7351+ C7F5                  ; --- Aplicar best dir si la hay ---
7352+ C7F5 3A 6F 5F         LD A, (DBfsBestDir)
7353+ C7F8 FE FF            CP MAI_DIR_NONE
7354+ C7FA C8               RET Z
7355+ C7FB                  ; Setear DELTAX/Y segun dir
7356+ C7FB FE 00            CP MAI_DIR_N
7357+ C7FD 28 12            JR Z, .bfsAppN
7358+ C7FF FE 01            CP MAI_DIR_S
7359+ C801 28 18            JR Z, .bfsAppS
7360+ C803 FE 02            CP MAI_DIR_W
7361+ C805 28 1E            JR Z, .bfsAppW
7362+ C807 DD 36 06 02      LD (IX+ENT_DELTAX), MONSTER_SPEED
7363+ C80B DD 36 07 00      LD (IX+ENT_DELTAY), 0
7364+ C80F 18 1C            JR .bfsAppMove
7365+ C811              .bfsAppN:
7366+ C811 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7367+ C815 DD 36 07 FE      LD (IX+ENT_DELTAY), -MONSTER_SPEED
7368+ C819 18 12            JR .bfsAppMove
7369+ C81B              .bfsAppS:
7370+ C81B DD 36 06 00      LD (IX+ENT_DELTAX), 0
7371+ C81F DD 36 07 02      LD (IX+ENT_DELTAY), MONSTER_SPEED
7372+ C823 18 08            JR .bfsAppMove
7373+ C825              .bfsAppW:
7374+ C825 DD 36 06 FE      LD (IX+ENT_DELTAX), -MONSTER_SPEED
7375+ C829 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7376+ C82D              .bfsAppMove:
7377+ C82D                  ; Intentar 1 paso con collision check
7378+ C82D DD 7E 03         LD A, (IX+ENT_POSX)
7379+ C830 32 5C C8         LD (.bfsSvX), A
7380+ C833 DD 7E 04         LD A, (IX+ENT_POSY)
7381+ C836 32 5D C8         LD (.bfsSvY), A
7382+ C839 DD 7E 03         LD A, (IX+ENT_POSX)
7383+ C83C DD 86 06         ADD A, (IX+ENT_DELTAX)
7384+ C83F DD 77 03         LD (IX+ENT_POSX), A
7385+ C842 DD 7E 04         LD A, (IX+ENT_POSY)
7386+ C845 DD 86 07         ADD A, (IX+ENT_DELTAY)
7387+ C848 DD 77 04         LD (IX+ENT_POSY), A
7388+ C84B CD BD B6         CALL CheckEnemyCollision
7389+ C84E C8               RET Z
7390+ C84F                  ; Bloqueado: revertir (DELTAX/Y se quedan setteados para que persistence
7391+ C84F                  ; de UpdateMonster vea la direccion del rescue en el siguiente intento).
7392+ C84F 3A 5C C8         LD A, (.bfsSvX)
7393+ C852 DD 77 03         LD (IX+ENT_POSX), A
7394+ C855 3A 5D C8         LD A, (.bfsSvY)
7395+ C858 DD 77 04         LD (IX+ENT_POSY), A
7396+ C85B C9               RET
7397+ C85C 00           .bfsSvX: DEFB 0
7398+ C85D 00           .bfsSvY: DEFB 0
7399+ C85E
7400+ C85E              ; --- bfsTryNbr: probar vecino (B=nx, C=ny, A=step_dir). Si valido, encolar
7401+ C85E              ; y actualizar best. ---
7402+ C85E              .bfsTryNbr:
7403+ C85E 32 7A 5F         LD (DBfsTryDir), A
7404+ C861 78               LD A, B
7405+ C862 32 78 5F         LD (DBfsTryCx), A
7406+ C865 79               LD A, C
7407+ C866 32 79 5F         LD (DBfsTryCy), A
7408+ C869                  ; Bounds: nx <= FFZ_MAX_CX, ny <= FFZ_MAX_CY (sprite cabe sin wrap/HUD)
7409+ C869 3A 78 5F         LD A, (DBfsTryCx)
7410+ C86C FE 1E            CP FFZ_MAX_CX + 1
7411+ C86E D0               RET NC
7412+ C86F 3A 79 5F         LD A, (DBfsTryCy)
7413+ C872 FE 11            CP FFZ_MAX_CY + 1
7414+ C874 D0               RET NC
7415+ C875                  ; Visited?
7416+ C875 CD DA C8         CALL .bfsIsVisited
7417+ C878 C0               RET NZ
7418+ C879                  ; Footprint 3x3 libre?
7419+ C879 CD 09 C9         CALL .bfsCanFit
7420+ C87C C0               RET NZ
7421+ C87D                  ; --- first_dir del nuevo entry: hereda si curFirstDir != NONE, si no usa step ---
7422+ C87D 3A 76 5F         LD A, (DBfsCurFirstDir)
7423+ C880 FE FF            CP MAI_DIR_NONE
7424+ C882 20 03            JR NZ, .nbrInherit
7425+ C884 3A 7A 5F         LD A, (DBfsTryDir)
7426+ C887              .nbrInherit:
7427+ C887 47               LD B, A                             ; B = first_dir para enqueue
7428+ C888                  ; Encolar
7429+ C888 2A 6D 5F         LD HL, (DBfsQTail)
7430+ C88B 3A 78 5F         LD A, (DBfsTryCx)
7431+ C88E 77               LD (HL), A
7432+ C88F 23               INC HL
7433+ C890 3A 79 5F         LD A, (DBfsTryCy)
7434+ C893 77               LD (HL), A
7435+ C894 23               INC HL
7436+ C895 78               LD A, B
7437+ C896 77               LD (HL), A
7438+ C897 23               INC HL
7439+ C898 3A 77 5F         LD A, (DBfsCurDepth)
7440+ C89B 3C               INC A
7441+ C89C 77               LD (HL), A
7442+ C89D 4F               LD C, A                             ; C = newDepth
7443+ C89E 23               INC HL
7444+ C89F 22 6D 5F         LD (DBfsQTail), HL
7445+ C8A2                  ; --- Score: max depth tie-break min manhattan ---
7446+ C8A2                  ; manhattan = |tryCx - playerCx| + |tryCy - playerCy|
7447+ C8A2 3A 78 5F         LD A, (DBfsTryCx)
7448+ C8A5 57               LD D, A
7449+ C8A6 3A 72 5F         LD A, (DBfsPlayerCx)
7450+ C8A9 92               SUB D
7451+ C8AA 30 02            JR NC, .nbrAbsX
7452+ C8AC ED 44            NEG
7453+ C8AE              .nbrAbsX:
7454+ C8AE 57               LD D, A
7455+ C8AF 3A 79 5F         LD A, (DBfsTryCy)
7456+ C8B2 5F               LD E, A
7457+ C8B3 3A 73 5F         LD A, (DBfsPlayerCy)
7458+ C8B6 93               SUB E
7459+ C8B7 30 02            JR NC, .nbrAbsY
7460+ C8B9 ED 44            NEG
7461+ C8BB              .nbrAbsY:
7462+ C8BB 82               ADD A, D                            ; A = manhattan
7463+ C8BC 57               LD D, A
7464+ C8BD                  ; Compare: depth > best ? update : (depth == best && manh < bestManh ? update : skip)
7465+ C8BD 79               LD A, C
7466+ C8BE 21 70 5F         LD HL, DBfsBestDepth
7467+ C8C1 BE               CP (HL)
7468+ C8C2 38 15            JR C, .nbrNoBest
7469+ C8C4 20 07            JR NZ, .nbrUpdate                   ; depth > bestDepth
7470+ C8C6 7A               LD A, D
7471+ C8C7 21 71 5F         LD HL, DBfsBestManh
7472+ C8CA BE               CP (HL)
7473+ C8CB 30 0C            JR NC, .nbrNoBest                   ; manh >= best
7474+ C8CD              .nbrUpdate:
7475+ C8CD 79               LD A, C
7476+ C8CE 32 70 5F         LD (DBfsBestDepth), A
7477+ C8D1 7A               LD A, D
7478+ C8D2 32 71 5F         LD (DBfsBestManh), A
7479+ C8D5 78               LD A, B
7480+ C8D6 32 6F 5F         LD (DBfsBestDir), A
7481+ C8D9              .nbrNoBest:
7482+ C8D9 C9               RET
7483+ C8DA
7484+ C8DA              ; --- bfsIsVisited: scan queue [Queue, QTail). Z=no visited, NZ=visited ---
7485+ C8DA              .bfsIsVisited:
7486+ C8DA 21 FF 5E         LD HL, DBfsQueue
7487+ C8DD ED 5B 6D 5F      LD DE, (DBfsQTail)
7488+ C8E1              .bivLoop:
7489+ C8E1                  ; HL == DE -> end
7490+ C8E1 E5               PUSH HL
