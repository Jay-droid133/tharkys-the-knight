1096+ A4EF              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1097+ A4EF              ; ==============================================================================
1098+ A4EF              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1099+ A4EF              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1100+ A4EF              ; ==============================================================================
1101+ A4EF              GetSpriteAddr:
1102+ A4EF                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1103+ A4EF                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1104+ A4EF 3A 87 8D         LD A, (CurrentPaging)
1105+ A4F2 E6 F8            AND $F8
1106+ A4F4 F6 06            OR 6
1107+ A4F6 32 87 8D         LD (CurrentPaging), A
1108+ A4F9 01 FD 7F         LD BC, $7FFD
1109+ A4FC ED 79            OUT (C), A                  ; bank 6 paginado
1110+ A4FE DD 7E 00         LD A, (IX+ENT_SPRITEID)
1111+ A501 6F               LD L, A
1112+ A502 26 00            LD H, 0
1113+ A504 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1114+ A505 11 B7 E7         LD DE, SpriteFrameTable
1115+ A508 19               ADD HL, DE
1116+ A509 5E               LD E, (HL)
1117+ A50A 23               INC HL
1118+ A50B 56               LD D, (HL)
1119+ A50C ED 53 1E A5      LD (SpriteAddrTemp), DE
1120+ A510 3A 87 8D         LD A, (CurrentPaging)
1121+ A513 E6 F8            AND $F8
1122+ A515 32 87 8D         LD (CurrentPaging), A
1123+ A518 01 FD 7F         LD BC, $7FFD
1124+ A51B ED 79            OUT (C), A                  ; bank 0 de vuelta
1125+ A51D C9               RET
1126+ A51E
1127+ A51E 00 00        SpriteAddrTemp: DEFW 0
1128+ A520
1129+ A520              ; ==============================================================================
1130+ A520              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1131+ A520              ; ==============================================================================
1132+ A520              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1133+ A520              ; Salida:   DE = puntero al sprite data
1134+ A520              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1135+ A520              ; Preserva: IX
1136+ A520              ; Destruye: A, HL
1137+ A520              ; ==============================================================================
1138+ A520              GetOldSpriteAddr:
1139+ A520                  ; Paging inline (ver GetSpriteAddr)
1140+ A520 3A 87 8D         LD A, (CurrentPaging)
1141+ A523 E6 F8            AND $F8
1142+ A525 F6 06            OR 6
1143+ A527 32 87 8D         LD (CurrentPaging), A
1144+ A52A 01 FD 7F         LD BC, $7FFD
1145+ A52D ED 79            OUT (C), A
1146+ A52F DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1147+ A532 6F               LD L, A
1148+ A533 26 00            LD H, 0
1149+ A535 29               ADD HL, HL
1150+ A536 11 B7 E7         LD DE, SpriteFrameTable
1151+ A539 19               ADD HL, DE
1152+ A53A 5E               LD E, (HL)
1153+ A53B 23               INC HL
1154+ A53C 56               LD D, (HL)
1155+ A53D ED 53 A8 A4      LD (OldSprAddr), DE
1156+ A541 3A 87 8D         LD A, (CurrentPaging)
1157+ A544 E6 F8            AND $F8
1158+ A546 32 87 8D         LD (CurrentPaging), A
1159+ A549 01 FD 7F         LD BC, $7FFD
1160+ A54C ED 79            OUT (C), A
1161+ A54E C9               RET
1162+ A54F
1163+ A54F              ; ==============================================================================
1164+ A54F              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1165+ A54F              ; ==============================================================================
1166+ A54F              ; Entrada: A = SpriteID
1167+ A54F              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1168+ A54F              ; Destruye: A, DE, HL
1169+ A54F              ; ==============================================================================
1170+ A54F              GetSpriteDims:
1171+ A54F                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1172+ A54F                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1173+ A54F 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1174+ A550 26 00            LD H, 0
1175+ A552 3A 87 8D         LD A, (CurrentPaging)
1176+ A555 E6 F8            AND $F8
1177+ A557 F6 06            OR 6
1178+ A559 32 87 8D         LD (CurrentPaging), A
1179+ A55C 01 FD 7F         LD BC, $7FFD
1180+ A55F ED 79            OUT (C), A                  ; bank 6 paginado
1181+ A561 29               ADD HL, HL
1182+ A562 11 B7 E7         LD DE, SpriteFrameTable
1183+ A565 19               ADD HL, DE
1184+ A566 5E               LD E, (HL)
1185+ A567 23               INC HL
1186+ A568 56               LD D, (HL)                  ; DE = ptr al sprite data
1187+ A569 1A               LD A, (DE)                  ; width_bytes
1188+ A56A 87               ADD A, A
1189+ A56B 87               ADD A, A
1190+ A56C 87               ADD A, A                    ; × 8 = width_px
1191+ A56D 47               LD B, A
1192+ A56E 13               INC DE
1193+ A56F 1A               LD A, (DE)                  ; height_px
1194+ A570 4F               LD C, A
1195+ A571                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1196+ A571 78               LD A, B
1197+ A572 32 8F A5         LD (GsdSavedB), A
1198+ A575 79               LD A, C
1199+ A576 32 90 A5         LD (GsdSavedC), A
1200+ A579 3A 87 8D         LD A, (CurrentPaging)
1201+ A57C E6 F8            AND $F8
1202+ A57E 32 87 8D         LD (CurrentPaging), A
1203+ A581 01 FD 7F         LD BC, $7FFD
1204+ A584 ED 79            OUT (C), A                  ; bank 0 de vuelta
1205+ A586 3A 8F A5         LD A, (GsdSavedB)
1206+ A589 47               LD B, A
1207+ A58A 3A 90 A5         LD A, (GsdSavedC)
1208+ A58D 4F               LD C, A
1209+ A58E C9               RET
1210+ A58F
1211+ A58F 00           GsdSavedB: DEFB 0
1212+ A590 00           GsdSavedC: DEFB 0
1213+ A591
1214+ A591              ; ==============================================================================
1215+ A591              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1216+ A591              ; ==============================================================================
1217+ A591              ; IX = puntero a la entidad del player (slot 0)
1218+ A591              ; ==============================================================================
1219+ A591              UpdatePlayer:
1220+ A591 CD B9 A5         CALL UpdatePlayerState
1221+ A594 CD D7 A6         CALL UpdatePlayerMovement
1222+ A597 CD 50 A9         CALL UpdatePlayerAnimation
1223+ A59A                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1224+ A59A                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1225+ A59A                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1226+ A59A                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1227+ A59A                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1228+ A59A                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1229+ A59A                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1230+ A59A                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1231+ A59A                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1232+ A59A                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1233+ A59A                  ; tickea a tiempo y reescribe SPRITEID).
1234+ A59A 3A F1 82         LD A, (PlayerRespawnTimer)
1235+ A59D B7               OR A
1236+ A59E C8               RET Z
1237+ A59F 3A 9D 81         LD A, (GameFrameCounter)
1238+ A5A2 E6 02            AND 2
1239+ A5A4 28 0D            JR Z, .pblOffFrame
1240+ A5A6                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1241+ A5A6 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1242+ A5A9 FE 74            CP SPRID_PLAYER_BLANK
1243+ A5AB C0               RET NZ                              ; sprite válido (anim viva) → keep
1244+ A5AC DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1245+ A5AF DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1246+ A5B2 C9               RET
1247+ A5B3              .pblOffFrame:
1248+ A5B3 3E 74            LD A, SPRID_PLAYER_BLANK
1249+ A5B5 32 A0 81         LD (EntityTable), A
1250+ A5B8 C9               RET
1251+ A5B9
1252+ A5B9              ; ==============================================================================
1253+ A5B9              ; UpdatePlayerState - Determina estado y direccion desde input
1254+ A5B9              ; ==============================================================================
1255+ A5B9              UpdatePlayerState:
1256+ A5B9 3A B0 82         LD A, (InputDirection)
1257+ A5BC 47               LD B, A
1258+ A5BD 3A B1 82         LD A, (InputFire)
1259+ A5C0 4F               LD C, A
1260+ A5C1
1261+ A5C1                  ; Sin input → idle (salvo si ataque en curso)
1262+ A5C1 78               LD A, B
1263+ A5C2 B1               OR C
1264+ A5C3 20 17            JR NZ, .notIdle
1265+ A5C5                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1266+ A5C5 3A 81 B3         LD A, (AttackTimer)
1267+ A5C8 B7               OR A
1268+ A5C9 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1269+ A5CB DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1270+ A5CF                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1271+ A5CF DD 7E 0A         LD A, (IX+ENT_DIR)
1272+ A5D2 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1273+ A5D4 DD 77 0A         LD (IX+ENT_DIR), A
1274+ A5D7                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1275+ A5D7 AF               XOR A
1276+ A5D8 32 83 B3         LD (AttackDebounce), A
1277+ A5DB C9               RET
1278+ A5DC
1279+ A5DC              .notIdle:
1280+ A5DC                  ; Guardar direccion actual en bits 0-3
1281+ A5DC DD 7E 0A         LD A, (IX+ENT_DIR)
1282+ A5DF E6 F0            AND $F0                     ; Mantener lastHDir
1283+ A5E1 B0               OR B                        ; Añadir dir actual
1284+ A5E2 DD 77 0A         LD (IX+ENT_DIR), A
1285+ A5E5
1286+ A5E5                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1287+ A5E5 3A 81 B3         LD A, (AttackTimer)
1288+ A5E8 B7               OR A
1289+ A5E9 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1290+ A5EB 78               LD A, B
1291+ A5EC E6 0C            AND DIR_E | DIR_W
1292+ A5EE 28 0E            JR Z, .noHorizUpdate
1293+ A5F0                  ; Guardar en bits 4-7
1294+ A5F0 07               RLCA
1295+ A5F1 07               RLCA
1296+ A5F2 07               RLCA
1297+ A5F3 07               RLCA                        ; Shift a bits 4-7
1298+ A5F4 4F               LD C, A                     ; C = lastHDir en bits 4-7
1299+ A5F5 DD 7E 0A         LD A, (IX+ENT_DIR)
1300+ A5F8 E6 0F            AND $0F                     ; Mantener dir actual
1301+ A5FA B1               OR C                        ; Añadir lastHDir
1302+ A5FB DD 77 0A         LD (IX+ENT_DIR), A
1303+ A5FE              .noHorizUpdate:
1304+ A5FE
1305+ A5FE                  ; --- Consumir/regenerar stamina ---
1306+ A5FE CD 83 AA         CALL UpdateStamina
1307+ A601                  ; --- Auto-select sword mode segun stamina ---
