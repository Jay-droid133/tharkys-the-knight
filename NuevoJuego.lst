 457+ 9F25              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9F25              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9F25              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9F25              ; ---
 461+ 9F25 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9F35 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9F36 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9F37 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ A069 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ A06A
 467+ A06A              ; ==============================================================================
 468+ A06A              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A06A              ; ==============================================================================
 470+ A06A              ; Entrada: A = indice de entidad (0-16)
 471+ A06A              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A06A              ; ==============================================================================
 473+ A06A              SetAttrSlot:
 474+ A06A 32 69 A0         LD (CurrentAttrSlot), A
 475+ A06D                  ; Calcular offset: A * 18
 476+ A06D 6F               LD L, A
 477+ A06E 26 00            LD H, 0
 478+ A070 29               ADD HL, HL                  ; x2
 479+ A071 54               LD D, H
 480+ A072 5D               LD E, L                     ; DE = x2
 481+ A073 29               ADD HL, HL                  ; x4
 482+ A074 29               ADD HL, HL                  ; x8
 483+ A075 29               ADD HL, HL                  ; x16
 484+ A076 19               ADD HL, DE                  ; x18
 485+ A077 11 37 9F         LD DE, SavedAttrTable
 486+ A07A 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A07B                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A07B 11 25 9F         LD DE, EntitySavedAttr
 489+ A07E 01 12 00         LD BC, 18
 490+ A081 ED B0            LDIR
 491+ A083 C9               RET
 492+ A084
 493+ A084              ; ==============================================================================
 494+ A084              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A084              ; ==============================================================================
 496+ A084              FlushAttrSlot:
 497+ A084 3A 69 A0         LD A, (CurrentAttrSlot)
 498+ A087 6F               LD L, A
 499+ A088 26 00            LD H, 0
 500+ A08A 29               ADD HL, HL                  ; x2
 501+ A08B 54               LD D, H
 502+ A08C 5D               LD E, L
 503+ A08D 29               ADD HL, HL                  ; x4
 504+ A08E 29               ADD HL, HL                  ; x8
 505+ A08F 29               ADD HL, HL                  ; x16
 506+ A090 19               ADD HL, DE                  ; x18
 507+ A091 11 37 9F         LD DE, SavedAttrTable
 508+ A094 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A095 EB               EX DE, HL                   ; DE = destino
 510+ A096 21 25 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A099 01 12 00         LD BC, 18
 512+ A09C ED B0            LDIR
 513+ A09E C9               RET
 514+ A09F
 515+ A09F              ; ==============================================================================
 516+ A09F              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A09F              ; ==============================================================================
 518+ A09F              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A09F              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A09F              ; ==============================================================================
 521+ A09F              CalcAttrAddr:
 522+ A09F 7A               LD A, D
 523+ A0A0 0F               RRCA
 524+ A0A1 0F               RRCA
 525+ A0A2 0F               RRCA
 526+ A0A3 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A0A5 6F               LD L, A
 528+ A0A6 26 00            LD H, 0
 529+ A0A8 29               ADD HL, HL
 530+ A0A9 29               ADD HL, HL
 531+ A0AA 29               ADD HL, HL
 532+ A0AB 29               ADD HL, HL
 533+ A0AC 29               ADD HL, HL                  ; HL = fila * 32
 534+ A0AD 7B               LD A, E
 535+ A0AE 0F               RRCA
 536+ A0AF 0F               RRCA
 537+ A0B0 0F               RRCA
 538+ A0B1 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A0B3 B5               OR L
 540+ A0B4 6F               LD L, A
 541+ A0B5 01 00 58         LD BC, ATTR_BASE
 542+ A0B8 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A0B9 C9               RET
 544+ A0BA
 545+ A0BA              ; ==============================================================================
 546+ A0BA              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A0BA              ; ==============================================================================
 548+ A0BA              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A0BA              ; Salida: HL=direccion en VRAM
 550+ A0BA              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A0BA              ; ==============================================================================
 552+ A0BA              CalcPixelAddr:
 553+ A0BA 7A               LD A, D
 554+ A0BB E6 C0            AND $C0                     ; Y7 Y6
 555+ A0BD 1F               RRA
 556+ A0BE 1F               RRA
 557+ A0BF 1F               RRA                         ; >> 3
 558+ A0C0 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A0C2 67               LD H, A
 560+ A0C3
 561+ A0C3 7A               LD A, D
 562+ A0C4 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A0C6 B4               OR H
 564+ A0C7 67               LD H, A
 565+ A0C8
 566+ A0C8 7A               LD A, D
 567+ A0C9 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A0CB 87               ADD A, A
 569+ A0CC 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A0CD 6F               LD L, A
 571+ A0CE
 572+ A0CE 7B               LD A, E
 573+ A0CF 1F               RRA
 574+ A0D0 1F               RRA
 575+ A0D1 1F               RRA
 576+ A0D2 E6 1F            AND $1F                     ; X / 8 = columna
 577+ A0D4 B5               OR L
 578+ A0D5 6F               LD L, A
 579+ A0D6 C9               RET
 580+ A0D7
 581+ A0D7              ; ==============================================================================
 582+ A0D7              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A0D7              ; ==============================================================================
 584+ A0D7              DrawDebugInfo:
 585+ A0D7 3A 55 82         LD A, (CurrentScreenX)
 586+ A0DA 1E 00            LD E, 0
 587+ A0DC CD F9 A0         CALL .drawHexDigit
 588+ A0DF
 589+ A0DF 3E 2C            LD A, ','
 590+ A0E1 1E 01            LD E, 1
 591+ A0E3 CD 05 A1         CALL .drawChar
 592+ A0E6
 593+ A0E6 3A 56 82         LD A, (CurrentScreenY)
 594+ A0E9 1E 02            LD E, 2
 595+ A0EB CD F9 A0         CALL .drawHexDigit
 596+ A0EE
 597+ A0EE 21 00 58         LD HL, ATTR_BASE
 598+ A0F1 3E 47            LD A, WHITE | $40
 599+ A0F3 77               LD (HL), A
 600+ A0F4 23               INC HL
 601+ A0F5 77               LD (HL), A
 602+ A0F6 23               INC HL
 603+ A0F7 77               LD (HL), A
 604+ A0F8 C9               RET
 605+ A0F9
 606+ A0F9              .drawHexDigit:
 607+ A0F9 E6 0F            AND $0F
 608+ A0FB FE 0A            CP 10
 609+ A0FD 38 04            JR C, .isNum
 610+ A0FF C6 37            ADD A, 'A' - 10
 611+ A101 18 02            JR .drawChar
 612+ A103              .isNum:
 613+ A103 C6 30            ADD A, '0'
 614+ A105              .drawChar:
 615+ A105 6F               LD L, A
 616+ A106 26 00            LD H, 0
 617+ A108 29               ADD HL, HL
 618+ A109 29               ADD HL, HL
 619+ A10A 29               ADD HL, HL
 620+ A10B 01 00 3C         LD BC, $3C00
 621+ A10E 09               ADD HL, BC
 622+ A10F
 623+ A10F 16 40            LD D, $40
 624+ A111 06 08            LD B, 8
 625+ A113              .charLoop:
 626+ A113 7E               LD A, (HL)
 627+ A114 12               LD (DE), A
 628+ A115 23               INC HL
 629+ A116 14               INC D
 630+ A117 10 FA            DJNZ .charLoop
 631+ A119 C9               RET
