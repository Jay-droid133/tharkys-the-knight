 699+ 745C              ; ==============================================================================
 700+ 745C              ; CheckRandomSyntheticPickup - colision + collect del pickup sintetico
 701+ 745C              ; ==============================================================================
 702+ 745C              ; Llamada por CheckPickupCollect tras procesar PickupTable. Si la entry
 703+ 745C              ; sintetica esta activa, hace AABB contra el player. Si hay hit:
 704+ 745C              ;   - SFX_Pickup
 705+ 745C              ;   - Erase XOR + restore attrs
 706+ 745C              ;   - Mark inactiva ($FE)
 707+ 745C              ;   - Dispatch GiveLife/GiveHealth/GiveStamina segun RandomSynthPtr
 708+ 745C              ; ==============================================================================
 709+ 745C              CheckRandomSyntheticPickup:
 710+ 745C 3A B4 5F         LD A, (RandomSynthMapX)
 711+ 745F FE FE            CP $FE
 712+ 7461 C8               RET Z                               ; inactiva
 713+ 7462                  ; Sanity: solo procesar si estamos en su sala (deberia ser asi tras hook).
 714+ 7462 47               LD B, A
 715+ 7463 3A 0B 83         LD A, (CurrentScreenX)
 716+ 7466 B8               CP B
 717+ 7467 C0               RET NZ
 718+ 7468 3A B5 5F         LD A, (RandomSynthMapY)
 719+ 746B 47               LD B, A
 720+ 746C 3A 0C 83         LD A, (CurrentScreenY)
 721+ 746F B8               CP B
 722+ 7470 C0               RET NZ
 723+ 7471
 724+ 7471                  ; --- Cargar sprite a BgSpriteBuffer (header + pixels + attrs) ---
 725+ 7471 2A B6 5F         LD HL, (RandomSynthPtr)
 726+ 7474 3E 03            LD A, 3                             ; bank 3
 727+ 7476 CD C2 6C         CALL LoadBgSpriteToBuffer
 728+ 7479
 729+ 7479                  ; --- Calcular pk_left, pk_top, pk_width_px, pk_height_px ---
 730+ 7479 21 F8 86         LD HL, BgSpriteBuffer
 731+ 747C 7E               LD A, (HL)                          ; height_px
 732+ 747D 32 C6 74         LD (.crsPkH+1), A
 733+ 7480 23               INC HL
 734+ 7481 7E               LD A, (HL)
 735+ 7482 E6 7F            AND $7F                             ; width_bytes (sin flag RLE)
 736+ 7484 87               ADD A, A
 737+ 7485 87               ADD A, A
 738+ 7486 87               ADD A, A                            ; width_px = bytes*8
 739+ 7487 32 AE 74         LD (.crsPkW+1), A
 740+ 748A 3A B8 5F         LD A, (RandomSynthCharX)
 741+ 748D 87               ADD A, A
 742+ 748E 87               ADD A, A
 743+ 748F 87               ADD A, A                            ; pk_left = charX*8
 744+ 7490 32 A9 74         LD (.crsPkLeft+1), A
 745+ 7493 3A B9 5F         LD A, (RandomSynthCharY)
 746+ 7496 C6 02            ADD A, BG_Y_OFFSET
 747+ 7498 87               ADD A, A
 748+ 7499 87               ADD A, A
 749+ 749A 87               ADD A, A                            ; pk_top = (charY+BG_Y_OFFSET)*8
 750+ 749B 32 C1 74         LD (.crsPkTop+1), A
 751+ 749E
 752+ 749E                  ; --- AABB: player_right > pk_left AND player_left < pk_right
 753+ 749E                  ;          AND player_bottom > pk_top AND player_top < pk_bottom ---
 754+ 749E 3A A1 81         LD A, (EntityTable + ENT_POSX)
 755+ 74A1 32 A5 74         LD (.crsPlX+1), A
 756+ 74A4              .crsPlX:
 757+ 74A4 3E 00            LD A, 0                             ; player_left (self-mod)
 758+ 74A6 C6 10            ADD A, 16                           ; player_right
 759+ 74A8              .crsPkLeft:
 760+ 74A8 06 00            LD B, 0
 761+ 74AA B8               CP B
 762+ 74AB D8               RET C                               ; player_right <= pk_left -> miss
 763+ 74AC C8               RET Z
 764+ 74AD              .crsPkW:
 765+ 74AD 3E 00            LD A, 0                             ; pk_width
 766+ 74AF 80               ADD A, B                            ; pk_right
 767+ 74B0 47               LD B, A
 768+ 74B1 3A A5 74         LD A, (.crsPlX+1)
 769+ 74B4 B8               CP B
 770+ 74B5 D0               RET NC                              ; player_left >= pk_right -> miss
 771+ 74B6
 772+ 74B6 3A A2 81         LD A, (EntityTable + ENT_POSY)
 773+ 74B9 32 BD 74         LD (.crsPlY+1), A
 774+ 74BC              .crsPlY:
 775+ 74BC 3E 00            LD A, 0                             ; player_top
 776+ 74BE C6 15            ADD A, 21                           ; player_bottom (player es 21 alto)
 777+ 74C0              .crsPkTop:
 778+ 74C0 06 00            LD B, 0
 779+ 74C2 B8               CP B
 780+ 74C3 D8               RET C
 781+ 74C4 C8               RET Z
 782+ 74C5              .crsPkH:
 783+ 74C5 3E 00            LD A, 0                             ; pk_height
 784+ 74C7 80               ADD A, B                            ; pk_bottom
 785+ 74C8 47               LD B, A
 786+ 74C9 3A BD 74         LD A, (.crsPlY+1)
 787+ 74CC B8               CP B
 788+ 74CD D0               RET NC                              ; miss
 789+ 74CE
 790+ 74CE                  ; --- HIT detectado, pero saltar si player ya esta al maximo del recurso ---
 791+ 74CE                  ; Identificar tipo via RP_CurRolled (semantico, no por ptr) y comparar
 792+ 74CE                  ; contra cap. Si A >= cap, RET (sin SFX ni erase): el pickup queda
 793+ 74CE                  ; visible para cuando el jugador haya gastado el recurso.
 794+ 74CE                  ; Rayo/caracol/mushroom/compass no son cap-able: siempre aplican.
 795+ 74CE                  ;
 796+ 74CE                  ; Antes esto se hacia comparando RandomSynthPtr contra BgGfx_health_pickup
 797+ 74CE                  ; / BgGfx_stamina_pickup. Ahora hay variantes (ids 72/74/254 health,
 798+ 74CE                  ; 73/255 stamina) elegidas al azar por .urpDoHealth/.urpDoStamina; el
 799+ 74CE                  ; ptr varia pero RP_CurRolled mantiene la semantica.
 800+ 74CE 3A D0 5F         LD A, (RP_CurRolled)
 801+ 74D1 FE 01            CP ROLLED_LIFE
 802+ 74D3 28 0A            JR Z, .crsCheckLife
 803+ 74D5 FE 02            CP ROLLED_HEALTH
 804+ 74D7 28 0E            JR Z, .crsCheckHealth
 805+ 74D9 FE 03            CP ROLLED_STAMINA
 806+ 74DB 28 12            JR Z, .crsCheckStamina
 807+ 74DD 18 16            JR .crsApplyHit                     ; rayo/caracol/mushroom/compass: siempre apply
 808+ 74DF              .crsCheckLife:
 809+ 74DF 3A E1 82         LD A, (PlayerLives)
 810+ 74E2 FE 05            CP PLAYER_LIVES_MAX
 811+ 74E4 D0               RET NC
 812+ 74E5 18 0E            JR .crsApplyHit
 813+ 74E7              .crsCheckHealth:
 814+ 74E7 3A 55 B3         LD A, (PlayerHealth)
 815+ 74EA FE 10            CP HEALTH_MAX
 816+ 74EC D0               RET NC
 817+ 74ED 18 06            JR .crsApplyHit
 818+ 74EF              .crsCheckStamina:
 819+ 74EF 3A 56 B3         LD A, (PlayerStamina)
 820+ 74F2 FE 10            CP STAMINA_MAX
 821+ 74F4 D0               RET NC
 822+ 74F5              .crsApplyHit:
 823+ 74F5                  ; --- HIT confirmado: SFX + erase + attrs + apply effect + mark inactive ---
 824+ 74F5 21 54 F9         LD HL, SFX_Pickup
 825+ 74F8 CD 8D F8         CALL PlaySFX
 826+ 74FB
 827+ 74FB                  ; Erase: XOR redraw (sprite ya esta en BgSpriteBuffer)
 828+ 74FB 3A B8 5F         LD A, (RandomSynthCharX)
 829+ 74FE 47               LD B, A
 830+ 74FF 3A B9 5F         LD A, (RandomSynthCharY)
 831+ 7502 4F               LD C, A
 832+ 7503 C5               PUSH BC
 833+ 7504 DD 21 F8 86      LD IX, BgSpriteBuffer
 834+ 7508 CD E0 DB         CALL DrawBgSpriteXOR
 835+ 750B C1               POP BC                              ; B=charX, C=charY
 836+ 750C
 837+ 750C                  ; Restore attrs: D=height_chars, E=width_chars
 838+ 750C 21 F8 86         LD HL, BgSpriteBuffer
 839+ 750F 7E               LD A, (HL)                          ; height_px
 840+ 7510 0F               RRCA
 840+ 7511 0F             RRCA
 840+ 7512 0F             RRCA
 841+ 7513 E6 1F            AND $1F
 842+ 7515 57               LD D, A
 843+ 7516 23               INC HL
 844+ 7517 7E               LD A, (HL)
 845+ 7518 E6 7F            AND $7F
