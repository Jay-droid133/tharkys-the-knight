4426+ B72E              ; ==============================================================================
4427+ B72E              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4428+ B72E              ; ==============================================================================
4429+ B72E              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4430+ B72E              ; ==============================================================================
4431+ B72E              TrySpawnNasty:
4432+ B72E                  IF DEBUG_NO_ENEMIES
4433+ B72E ~                RET
4434+ B72E                  ENDIF
4435+ B72E                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4436+ B72E                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4437+ B72E                  ; cuando el timer llega a 0.
4438+ B72E 3A CA 82         LD A, (PostTrapPauseTimer)
4439+ B731 B7               OR A
4440+ B732 C0               RET NZ
4441+ B733                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4442+ B733                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4443+ B733 3A EA 82         LD A, (DeathBorderPhase)
4444+ B736 B7               OR A
4445+ B737 C0               RET NZ
4446+ B738                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4447+ B738                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4448+ B738                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4449+ B738 3A EE 82         LD A, (PlayerRespawnPhase)
4450+ B73B FE 01            CP 1
4451+ B73D C8               RET Z
4452+ B73E                  ; Cooldown tras cambio de pantalla / inicio
4453+ B73E 3A F8 82         LD A, (SpawnTimer)
4454+ B741 B7               OR A
4455+ B742 28 05            JR Z, .spawnReady
4456+ B744 3D               DEC A
4457+ B745 32 F8 82         LD (SpawnTimer), A
4458+ B748 C9               RET
4459+ B749              .spawnReady:
4460+ B749                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4461+ B749 3A AB B5         LD A, (ScareTimer)
4462+ B74C B7               OR A
4463+ B74D C0               RET NZ
4464+ B74E                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4465+ B74E                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4466+ B74E                  ; rellenamos con nasties crepusculares hasta A2.
4467+ B74E 3A C1 82         LD A, (MonsterTrappedFlags)
4468+ B751 E6 07            AND $07
4469+ B753 FE 07            CP $07
4470+ B755 28 0E            JR Z, .spawnIgnoreNightBlocks
4471+ B757                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4472+ B757                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4473+ B757                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4474+ B757                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4475+ B757 3A 15 B3         LD A, (MonstersActive)
4476+ B75A B7               OR A
4477+ B75B C0               RET NZ
4478+ B75C                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4479+ B75C 3A 26 E2         LD A, (CurrentTimeOfDay)
4480+ B75F FE 04            CP 4                        ; N2
4481+ B761 C8               RET Z
4482+ B762 FE 05            CP 5                        ; A1
4483+ B764 C8               RET Z
4484+ B765              .spawnIgnoreNightBlocks:
4485+ B765                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4486+ B765                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4487+ B765                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4488+ B765                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4489+ B765 DD 21 0E 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4490+ B769 06 04            LD B, NUM_NASTIES
4491+ B76B              .spawnLoop:
4492+ B76B C5               PUSH BC
4493+ B76C DD 7E 01         LD A, (IX+ENT_TYPE)
4494+ B76F B7               OR A
4495+ B770 20 12            JR NZ, .spawnNextSlot
4496+ B772 CD 8D B7         CALL SpawnOneNasty
4497+ B775 DD 7E 01         LD A, (IX+ENT_TYPE)
4498+ B778 B7               OR A
4499+ B779 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4500+ B77B                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4501+ B77B                  ; (un poco de irregularidad en la cadencia de aparicion).
4502+ B77B ED 5F            LD A, R
4503+ B77D E6 07            AND $07
4504+ B77F 32 F8 82         LD (SpawnTimer), A
4505+ B782 C1               POP BC
4506+ B783 C9               RET
4507+ B784              .spawnNextSlot:
4508+ B784 11 10 00         LD DE, ENT_SIZE
4509+ B787 DD 19            ADD IX, DE
4510+ B789 C1               POP BC
4511+ B78A 10 DF            DJNZ .spawnLoop
4512+ B78C C9               RET
4513+ B78D
4514+ B78D              ; ==============================================================================
4515+ B78D              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4516+ B78D              ; ==============================================================================
4517+ B78D              SpawnOneNasty:
4518+ B78D                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4519+ B78D ED 5F            LD A, R
4520+ B78F E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4521+ B791 6F               LD L, A
4522+ B792 26 00            LD H, 0
4523+ B794 ED 5B AB BC      LD DE, (CurrentNastyTable)
4524+ B798 19               ADD HL, DE
4525+ B799 7E               LD A, (HL)
4526+ B79A
4527+ B79A                  ; Configurar entidad base
4528+ B79A DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4529+ B79D DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4530+ B7A1 DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4531+ B7A5                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4532+ B7A5                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4533+ B7A5 3A AB BC         LD A, (CurrentNastyTable)
4534+ B7A8 FE 92            CP LOW CrepuscularTypeTable
4535+ B7AA 20 0B            JR NZ, .spnDay
4536+ B7AC 3A AC BC         LD A, (CurrentNastyTable + 1)
4537+ B7AF FE BC            CP HIGH CrepuscularTypeTable
4538+ B7B1 20 04            JR NZ, .spnDay
4539+ B7B3 3E 68            LD A, SPRID_SPAWN_NIGHT
4540+ B7B5 18 02            JR .spnSet
4541+ B7B7              .spnDay:
4542+ B7B7 3E 46            LD A, SPRID_SPAWN
4543+ B7B9              .spnSet:
4544+ B7B9 DD 77 00         LD (IX+ENT_SPRITEID), A
4545+ B7BC DD 77 08         LD (IX+ENT_ANIMBASE), A
4546+ B7BF DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4547+ B7C3 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4548+ B7C7
4549+ B7C7                  ; Color segun tipo (cada tipo tiene color fijo)
4550+ B7C7 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4551+ B7CA 21 96 BC         LD HL, NastyColorTable
4552+ B7CD D5               PUSH DE
4553+ B7CE 11 20 00         LD DE, SPRID_ENEMY_0
4554+ B7D1 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4555+ B7D2 CB 3F            SRL A
4556+ B7D4 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
4557+ B7D6 5F               LD E, A
4558+ B7D7 16 00            LD D, 0
4559+ B7D9 19               ADD HL, DE
4560+ B7DA 7E               LD A, (HL)
4561+ B7DB D1               POP DE
4562+ B7DC              .setAttr:
4563+ B7DC DD 77 05         LD (IX+ENT_ATTR), A
4564+ B7DF
4565+ B7DF                  ; Bbox 24x24 fijo para nasties (truco "puff-fit"): el spawn check usa el
4566+ B7DF                  ; mismo bbox que el movimiento (CheckEnemyCollision con TYPE_NASTY → H=24).
4567+ B7DF                  ; Asi el nasty arranca en una celda donde caben los 24x24 del puff/spawn
4568+ B7DF                  ; sin asomar al BG, y movimiento posterior es consistente. Sin esto, nasties
4569+ B7DF                  ; bajos (Bat 8h, Eagle/Rat 9h) spawneaban en sitios que pasaban el viejo
4570+ B7DF                  ; check (14h) pero quedaban atascados al moverse (move-check exige 24h).
4571+ B7DF 3E 17            LD A, 23                            ; W-1 = 23 (24 px)
4572+ B7E1 32 3F B9         LD (.spawnW1), A
4573+ B7E4 3E 17            LD A, 23                            ; H-1 = 23 (24 px)
4574+ B7E6 32 40 B9         LD (.spawnH1), A
4575+ B7E9
4576+ B7E9                  ; (ZoneCellList se construye en DrawScreen con player pos en la entrada
4577+ B7E9                  ; y filtro Manhattan; lista estatica durante toda la estancia en la sala.
4578+ B7E9                  ; Sin rebuild aqui = sin lag por spawn.)
4579+ B7E9                  ; Posicion aleatoria (con reintentos)
4580+ B7E9 3E 08            LD A, 8                             ; mas reintentos: ahora tambien hay min-distance check
4581+ B7EB 32 3D B9         LD (.spawnTries), A
4582+ B7EE AF               XOR A
4583+ B7EF 32 3E B9         LD (.spawnIgnoreZone), A            ; primera ronda respeta zona del player
4584+ B7F2
4585+ B7F2              .spawnRetry:
4586+ B7F2                  ; Picker: si .spawnIgnoreZone=0 y la lista de celdas alcanzables tiene
4587+ B7F2                  ; entradas, elegir aleatorio de la lista (garantiza zona del player).
4588+ B7F2                  ; Si fallback (.spawnIgnoreZone=1) o lista vacia: random X/Y de pantalla.
4589+ B7F2 3A 3E B9         LD A, (.spawnIgnoreZone)
4590+ B7F5 B7               OR A
4591+ B7F6 20 2A            JR NZ, .spwRandomXY
4592+ B7F8 3A 00 5D         LD A, (ZoneCellCount)
4593+ B7FB B7               OR A
4594+ B7FC 28 24            JR Z, .spwRandomXY                  ; lista vacia → fallback random
4595+ B7FE                  ; idx = R mod count
4596+ B7FE 47               LD B, A                             ; B = count
4597+ B7FF ED 5F            LD A, R
4598+ B801              .spwIdxLoop:
