 273+ 7D87              ; ==============================================================================
 274+ 7D87              ; AY_WriteRegSlot1 - copia de AY_WriteReg en slot 1
 275+ 7D87              ; ==============================================================================
 276+ 7D87              ; Necesaria porque desde el IRQ handler (slot 1) NO podemos llamar a la
 277+ 7D87              ; AY_WriteReg de bank 4: bank 4 puede no estar paginado en slot 3, y aunque
 278+ 7D87              ; lo estuviera, paginarlo desde el IRQ trae el race que estamos eliminando.
 279+ 7D87              ; Identica a AY_WriteReg (bank 4): A=registro, E=valor; clobbea BC y A.
 280+ 7D87              ; ==============================================================================
 281+ 7D87              AY_WriteRegSlot1:
 282+ 7D87 01 FD FF         LD BC, $FFFD
 283+ 7D8A ED 79            OUT (C), A                      ; seleccionar registro
 284+ 7D8C 01 FD BF         LD BC, $BFFD
 285+ 7D8F ED 59            OUT (C), E                      ; escribir valor
 286+ 7D91 C9               RET
 287+ 7D92
 288+ 7D92              ; ==============================================================================
 289+ 7D92              ; UpdateMusicImpl - catchup wall-clock. LEGACY: ya no se llama desde MainLoop.
 290+ 7D92              ; ==============================================================================
 291+ 7D92              ; Hoy el tick vive en MusicIrqHandler (CALL .upmiTickOnce + CALL .upmiPostLoop
 292+ 7D92              ; cada 2 IRQs). Esta rutina catchup se mantiene como fallback por si alguna
 293+ 7D92              ; vez queremos forzar avance N frames desde codigo.
 294+ 7D92              ; ==============================================================================
 295+ 7D92              UpdateMusicImpl:
 296+ 7D92 3A E9 99         LD A, (FramesElapsed)
 297+ 7D95 B7               OR A
 298+ 7D96 28 08            JR Z, .upmiPostLoop
 299+ 7D98 47               LD B, A
 300+ 7D99              .upmiLoop:
 301+ 7D99 C5               PUSH BC
 302+ 7D9A CD 0D 7E         CALL .upmiTickOnce
 303+ 7D9D C1               POP BC
 304+ 7D9E 10 F9            DJNZ .upmiLoop
 305+ 7DA0              .upmiPostLoop:
 306+ 7DA0                  ; --- Re-arm AY si musica activa ---
 307+ 7DA0                  ; Sin esto, la nota actual queda muda tras (a) cualquier write a R8/R9/R10
 308+ 7DA0                  ; que la mute, o (b) tras pasar por un rest. Re-escribimos vol + period de
 309+ 7DA0                  ; cada canal con period activo != 0. SFX en canal B (poly2 only) bloquean
 310+ 7DA0                  ; el re-arm de B; en poly3 no hay SFX activos (game-end), siempre re-armar.
 311+ 7DA0 3A A8 7B         LD A, (MusicTimer)
 312+ 7DA3 B7               OR A
 313+ 7DA4 C8               RET Z                           ; musica inactiva → no tocar AY
 314+ 7DA5                  ; --- Re-arm canal A: R0/R1 + R8 si MusicPeriodA != 0 ---
 315+ 7DA5 2A AD 7B         LD HL, (MusicPeriodA)
 316+ 7DA8 7C               LD A, H
 317+ 7DA9 B5               OR L
 318+ 7DAA 28 18            JR Z, .upmiSkipA
 319+ 7DAC E5               PUSH HL
 320+ 7DAD 3E 08            LD A, 8
 321+ 7DAF 1E 0C            LD E, 12
 322+ 7DB1 CD 87 7D         CALL AY_WriteRegSlot1           ; R8 = vol A medio-alto
 323+ 7DB4 E1               POP HL
 324+ 7DB5 5D               LD E, L
 325+ 7DB6 3E 00            LD A, 0
