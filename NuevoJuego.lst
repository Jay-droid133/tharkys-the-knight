1712+ F6D0              ; ==============================================================================
1713+ F6D0              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1714+ F6D0              ; ==============================================================================
1715+ F6D0              ; Indice (CompassSprites[idx]):
1716+ F6D0              ;   0 = NW    1 = N    2 = NE
1717+ F6D0              ;   3 = W     4 = X    5 = E
1718+ F6D0              ;   6 = SW    7 = S    8 = SE
1719+ F6D0              ; ==============================================================================
1720+ F6D0              CompassSprites:
1721+ F6D0 EF F7            DEFW Sprite_Compass_NW
1722+ F6D2 0F F7            DEFW Sprite_Compass_N
1723+ F6D4 2F F7            DEFW Sprite_Compass_NE
1724+ F6D6 CF F7            DEFW Sprite_Compass_W
1725+ F6D8 0F F8            DEFW Sprite_Compass_X
1726+ F6DA 4F F7            DEFW Sprite_Compass_E
1727+ F6DC AF F7            DEFW Sprite_Compass_SW
