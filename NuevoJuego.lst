 132  63E9                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 133  63E9                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 134  63E9                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 135  63E9                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 136  63E9                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 137  63E9                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 63E9              ; ==============================================================================
   2+ 63E9              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 63E9              ; ==============================================================================
   4+ 63E9              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 63E9              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 63E9              ; la cinematica — invisible porque es one-shot.
   7+ 63E9              ;
   8+ 63E9              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 63E9              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 63E9              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 63E9              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 63E9              ; ==============================================================================
  13+ 63E9
  14+ 63E9              ; ==============================================================================
  15+ 63E9              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 63E9              ; ==============================================================================
  17+ 63E9              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 63E9              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 63E9              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 63E9              ; ChurchCutsceneSlot.
  21+ 63E9              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 63E9              ; ==============================================================================
  23+ 63E9              EraseChurchTrappedMonster:
  24+ 63E9 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 63EC 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 63ED 6F               LD L, A
  27+ 63EE 26 00            LD H, 0
  28+ 63F0 29               ADD HL, HL
  29+ 63F1 29               ADD HL, HL
  30+ 63F2 29               ADD HL, HL
  31+ 63F3 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 63F4 11 94 81         LD DE, EntityTable
  33+ 63F7 19               ADD HL, DE
  34+ 63F8 E5               PUSH HL
  35+ 63F9 DD E1            POP IX
  36+ 63FB CD ED A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 63FE DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 6401 57               LD D, A
  39+ 6402 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 6405 5F               LD E, A
  41+ 6406 DD 2A 75 A4      LD IX, (OldSprAddr)
  42+ 640A C3 E0 99         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 640D
  44+ 640D              ; ==============================================================================
  45+ 640D              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 640D              ; ==============================================================================
  47+ 640D              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 640D              ; - Despawn monster (ENT_TYPE=0).
  49+ 640D              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 640D              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 640D              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 640D              ; ==============================================================================
  53+ 640D              ApplyChurchTrapDone:
  54+ 640D                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 640D 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 6410 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 6411 6F               LD L, A
  58+ 6412 26 00            LD H, 0
  59+ 6414 29               ADD HL, HL
  60+ 6415 29               ADD HL, HL
  61+ 6416 29               ADD HL, HL
  62+ 6417 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 6418 11 94 81         LD DE, EntityTable
  64+ 641B 19               ADD HL, DE
  65+ 641C E5               PUSH HL
  66+ 641D DD E1            POP IX
  67+ 641F                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 641F                  ; guardado en TriggerChurchTrap).
  69+ 641F 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 6422 21 AE 64         LD HL, ChurchTrapBitMask
  71+ 6425 5F               LD E, A
  72+ 6426 16 00            LD D, 0
  73+ 6428 19               ADD HL, DE
  74+ 6429 7E               LD A, (HL)
  75+ 642A 21 B7 82         LD HL, MonsterTrappedFlags
  76+ 642D B6               OR (HL)
  77+ 642E 77               LD (HL), A
  78+ 642F                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 642F                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 642F                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 642F 21 B8 82         LD HL, NextChurchTrapStep
  82+ 6432 34               INC (HL)
  83+ 6433                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 6433                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 6433                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 6433                  ; antes de quedarse fija en blanco brillante.
  87+ 6433 DD E5            PUSH IX
  88+ 6435 CD 96 F3         CALL StartStatueBlink
  89+ 6438 DD E1            POP IX
  90+ 643A                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 643A                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 643A                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 643A DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 643E DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 6442 DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 6446 DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 644A                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 644A                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 644A                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 644A                  ; anteriores del cutscene.)
 101+ 644A                  ; Decidir spawn: 3 atrapados?
 102+ 644A 3A B7 82         LD A, (MonsterTrappedFlags)
 103+ 644D E6 07            AND $07
 104+ 644F FE 07            CP $07
 105+ 6451 28 12            JR Z, .actdAllTrapped
 106+ 6453                  ; <3 atrapados: respawn church_key en AltN
 107+ 6453 3E 01            LD A, 1
 108+ 6455 32 A9 82         LD (ChurchKeySpawned), A
 109+ 6458 21 BA 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 645B 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 645C CD FF 66         CALL RespawnChurchKeyAtAlt
 112+ 645F                  ; Dibujar surgical en su nueva posicion
 113+ 645F 11 93 DA         LD DE, BgGfx_church_key
 114+ 6462 C3 07 D8         JP RedrawPickupByPtr
 115+ 6465              .actdAllTrapped:
 116+ 6465                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 6465                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 6465                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 6465                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 6465                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 6465                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 6465 AF               XOR A
 123+ 6466 32 AC 82         LD (TimeFrozen), A
 124+ 6469 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 646B 32 C0 82         LD (PostTrapPauseTimer), A
 126+ 646E C9               RET
 127+ 646F
 128+ 646F              ; ==============================================================================
 129+ 646F              ; UpdatePostTrapPause - Tick + dispara eventos diferidos tras cutscene de iglesia
 130+ 646F              ; ==============================================================================
 131+ 646F              ; Llamado cada frame desde MainLoop. No-op si timer = 0 (caso normal).
 132+ 646F              ; Cuando ApplyChurchTrapDone setea el timer a 50, esta rutina decrementa cada
 133+ 646F              ; frame y dispara los eventos a los frames precisos:
 134+ 646F              ;   timer=25 (= 1s desde inicio): aparece BankCheck + avance M#7 (encerrar)
 135+ 646F              ;                                 -> M#8 (PICKUP cheque). El cheque hay que
 136+ 646F              ;                                 ir a recogerlo; CheckMilestonePickup(7)
 137+ 646F              ;                                 lo avanza luego a M#9 (bank trigger).
 138+ 646F              ;   timer=0  (= 2s desde inicio): nasties resumen (via guard en TrySpawnNasty).
 139+ 646F              ; ==============================================================================
 140+ 646F              UpdatePostTrapPause:
 141+ 646F 3A C0 82         LD A, (PostTrapPauseTimer)
 142+ 6472 B7               OR A
 143+ 6473 C8               RET Z
 144+ 6474 3D               DEC A
 145+ 6475 32 C0 82         LD (PostTrapPauseTimer), A
 146+ 6478 FE 4B            CP POST_TRAP_KEY_DELAY              ; ¿cae justo en el frame del key spawn?
 147+ 647A 28 0E            JR Z, .uptpKey
 148+ 647C FE 3C            CP POST_TRAP_LASTING_DELAY          ; ¿lasting compass spawn?
 149+ 647E C0               RET NZ
 150+ 647F                  ; t = ~1.6s: aparece compass_lasting (sprite id 37) en ALT2 de church_key.
 151+ 647F                  ; Sin SFX (a peticion). Es pickup latente (DormantPickupTable +
 152+ 647F                  ; LastingCompassSpawned).
 153+ 647F 3E 01            LD A, 1
 154+ 6481 32 BD 82         LD (LastingCompassSpawned), A
 155+ 6484 11 3F EB         LD DE, BgGfx_compass_lasting
 156+ 6487 C3 07 D8         JP RedrawPickupByPtr                ; tail call
 157+ 648A              .uptpKey:
 158+ 648A                  ; t=1s: aparece el CHEQUE (BankCheck) + avance del hito M#7 (SPECIAL
 159+ 648A                  ; "encerrar monstruos") al M#8 (PICKUP cheque). El cheque NO se auto
 160+ 648A                  ; consume aqui — el player tiene que ir fisicamente a recogerlo. El
 161+ 648A                  ; pickup avanza M#8 -> M#9 via CheckMilestonePickup(7).
 162+ 648A                  ;
 163+ 648A                  ; SFX primero (mismo "clink" que la church_key cuando aparece en la plaza
 164+ 648A                  ; del ayuntamiento): se oye antes de que se dibuje, igual que en CheckBumpTriggers.
 165+ 648A                  ;
 166+ 648A                  ; Cambio respecto a la version anterior: en vez de soltar town_gate_key
 167+ 648A                  ; (la llave de la ciudad) aqui, soltamos BankCheck. La llave de la ciudad
 168+ 648A                  ; ahora la suelta bank_cutscene (M9) tras llevar el cheque al banco. Ver
 169+ 648A                  ; docs/bank_cutscene.md.
 170+ 648A 21 6B FA         LD HL, SFX_KeyDrop
 171+ 648D CD 24 F9         CALL PlaySFX
 172+ 6490 3E 01            LD A, 1
 173+ 6492 32 BC 82         LD (BankCheckSpawned), A
 174+ 6495 11 7B F5         LD DE, BgGfx_BankCheck
 175+ 6498 CD 07 D8         CALL RedrawPickupByPtr
 176+ 649B                  ; Avance M#7 -> M#8: la cinematica IS la conclusion del hito SPECIAL
 177+ 649B                  ; "encerrar". CurrentObjective pasa de 6 (buscando M#7) a 7 (buscando
 178+ 649B                  ; M#8 cheque). La brujula resuelve a la sala del cheque via PickupTable.
 179+ 649B                  ; Sin esto la cadena se quedaba atascada en M#7 (SPECIAL solo avanza
 180+ 649B                  ; con la tecla M de debug).
 181+ 649B 3A B0 82         LD A, (CurrentObjective)
 182+ 649E FE 06            CP 6
 183+ 64A0 C0               RET NZ
 184+ 64A1 3C               INC A
 185+ 64A2 32 B0 82         LD (CurrentObjective), A
 186+ 64A5 CD E4 EF         CALL ResolveObjectiveScreen
 187+ 64A8 3E FF            LD A, $FF
 188+ 64AA 32 B3 82         LD (PreviousObjectiveDistance), A
 189+ 64AD C9               RET
