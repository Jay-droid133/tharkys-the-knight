 599+ 713A              ; ==============================================================================
 600+ 713A              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 601+ 713A              ; ==============================================================================
 602+ 713A              ; Se llama desde:
 603+ 713A              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 604+ 713A              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 605+ 713A              ;     por encima y los borro.
 606+ 713A              ;
 607+ 713A              ; Bypass total de tint swap + day/night remap → siempre brillan:
 608+ 713A              ;   life          = $47 (white bright, paper black)
 609+ 713A              ;   health_pickup = $42 (red bright,   paper black)
 610+ 713A              ;   stamina_pickup= $45 (cyan bright,  paper black)
 611+ 713A              ;
 612+ 713A              ; Pickup es 16x16 = 2x2 char attrs.
 613+ 713A              ; Early-out si RandomSynthMapX = $FE (no activo).
 614+ 713A              ; Destruye AF, BC, DE, HL.
 615+ 713A              ; ==============================================================================
 616+ 713A              PaintSynthPickupAttrs:
 617+ 713A 3A B4 5F         LD A, (RandomSynthMapX)
 618+ 713D FE FE            CP $FE
 619+ 713F C8               RET Z                               ; no activo
 620+ 7140                  ; --- Attr byte: leido del sprite al activar (RandomSynthAttr en RAM) ---
 621+ 7140                  ; Respeta el color que el usuario puso en el BG editor. Bypass del remap
 622+ 7140                  ; dia/noche garantizado al escribir directo a VRAM (sin DrawBgAttrOnly).
 623+ 7140 3A BB 5F         LD A, (RandomSynthAttr)
 624+ 7143 4F               LD C, A                             ; C = attr byte
 625+ 7144                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 626+ 7144 3A B9 5F         LD A, (RandomSynthCharY)
 627+ 7147 C6 02            ADD A, BG_Y_OFFSET
 628+ 7149 26 00            LD H, 0
 629+ 714B 6F               LD L, A
 630+ 714C 29               ADD HL, HL
 631+ 714D 29               ADD HL, HL
 632+ 714E 29               ADD HL, HL
 633+ 714F 29               ADD HL, HL
 634+ 7150 29               ADD HL, HL                          ; *32
 635+ 7151 3A B8 5F         LD A, (RandomSynthCharX)
 636+ 7154 85               ADD A, L
 637+ 7155 6F               LD L, A
 638+ 7156 30 01            JR NC, .pspaNoCarry
 639+ 7158 24               INC H
 640+ 7159              .pspaNoCarry:
 641+ 7159 11 00 58         LD DE, ATTR_BASE
 642+ 715C 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 643+ 715D                  ; --- Escribir 4 attrs (2x2) ---
 644+ 715D 71               LD (HL), C
 645+ 715E 23               INC HL
 646+ 715F 71               LD (HL), C                          ; fila 0
 647+ 7160 7D               LD A, L
 648+ 7161 C6 1F            ADD A, 31                           ; +32 a fila siguiente, -1 (al col 0)
 649+ 7163 6F               LD L, A
 650+ 7164 30 01            JR NC, .pspaNoCarry2
 651+ 7166 24               INC H
 652+ 7167              .pspaNoCarry2:
 653+ 7167 71               LD (HL), C
 654+ 7168 23               INC HL
 655+ 7169 71               LD (HL), C                          ; fila 1
 656+ 716A C9               RET
