 443+ EF1F              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EF1F              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EF1F              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EF1F              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EF1F              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EF1F              .drawBar:
 449+ EF1F 7D               LD A, L
 450+ EF20 32 6B EF         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EF23 7B               LD A, E
 452+ EF24 32 6C EF         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EF27 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EF29 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EF2B                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EF2B 3E 10            LD A, 16
 457+ EF2D 91               SUB C
 458+ EF2E 5F               LD E, A                             ; E = primera scanline llena
 459+ EF2F              .dbLoop:
 460+ EF2F                  ; Calcular direccion VRAM
 461+ EF2F 7A               LD A, D
 462+ EF30 FE 08            CP 8
 463+ EF32 30 09            JR NC, .dbCalcR1
 464+ EF34                  ; Char row 0
 465+ EF34 67               LD H, A
 466+ EF35 CB F4            SET 6, H
 467+ EF37 3A 6B EF         LD A, (.dbCol)
 468+ EF3A 6F               LD L, A
 469+ EF3B 18 09            JR .dbWrite
 470+ EF3D              .dbCalcR1:
 471+ EF3D                  ; Char row 1
 472+ EF3D D6 08            SUB 8
 473+ EF3F 67               LD H, A
 474+ EF40 CB F4            SET 6, H
 475+ EF42 3A 6C EF         LD A, (.dbCol1)
 476+ EF45 6F               LD L, A
 477+ EF46              .dbWrite:
 478+ EF46                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EF46 7A               LD A, D
 480+ EF47 BB               CP E
 481+ EF48 30 0B            JR NC, .dbFull
 482+ EF4A                  ; Marchito: copiar sprite decayed
 483+ EF4A FD 7E 00         LD A, (IY+0)
 484+ EF4D 77               LD (HL), A
 485+ EF4E 23               INC HL
 486+ EF4F FD 7E 01         LD A, (IY+1)
 487+ EF52 77               LD (HL), A
 488+ EF53 18 09            JR .dbAdvanceSpr
 489+ EF55              .dbFull:
 490+ EF55                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EF55 DD 7E 00         LD A, (IX+0)
 492+ EF58 77               LD (HL), A
 493+ EF59 23               INC HL
 494+ EF5A DD 7E 01         LD A, (IX+1)
 495+ EF5D 77               LD (HL), A
 496+ EF5E              .dbAdvanceSpr:
 497+ EF5E                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EF5E D5               PUSH DE
 499+ EF5F 11 06 00         LD DE, 6
 500+ EF62 DD 19            ADD IX, DE
 501+ EF64 FD 19            ADD IY, DE
 502+ EF66 D1               POP DE
 503+ EF67 14               INC D
 504+ EF68 10 C5            DJNZ .dbLoop
 505+ EF6A C9               RET
 506+ EF6B
 507+ EF6B 00           .dbCol:  DEFB 0
 508+ EF6C 00           .dbCol1: DEFB 0
 509+ EF6D
 510+ EF6D              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EF6D              .levelToColor:
 512+ EF6D FE 0C            CP 12
 513+ EF6F 30 11            JR NC, .lcGreen
 514+ EF71 FE 07            CP 7
 515+ EF73 30 0A            JR NC, .lcCyan
 516+ EF75 FE 03            CP 3
 517+ EF77 30 03            JR NC, .lcYellow
 518+ EF79 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EF7B C9               RET
 520+ EF7C              .lcYellow:
 521+ EF7C 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EF7E C9               RET
 523+ EF7F              .lcCyan:
 524+ EF7F 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EF81 C9               RET
 526+ EF82              .lcGreen:
 527+ EF82 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EF84 C9               RET
