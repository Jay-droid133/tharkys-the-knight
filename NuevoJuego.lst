 424+ 9BAD              ; ==============================================================================
 425+ 9BAD              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9BAD              ; ==============================================================================
 427+ 9BAD              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9BAD              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9BAD              ;
 430+ 9BAD              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9BAD              ; ==============================================================================
 432+ 9BAD              RestoreEntityAttr:
 433+ 9BAD CD 47 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BB0 11 CD 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BB3
 436+ 9BB3 3A DE 9B         LD A, (EntityAttrH)
 437+ 9BB6 4F               LD C, A
 438+ 9BB7              .restRow:
 439+ 9BB7 3A DD 9B         LD A, (EntityAttrW)
 440+ 9BBA 47               LD B, A
 441+ 9BBB E5               PUSH HL
 442+ 9BBC              .restCol:
 443+ 9BBC 1A               LD A, (DE)
 444+ 9BBD 77               LD (HL), A
 445+ 9BBE 23               INC HL
 446+ 9BBF 13               INC DE
 447+ 9BC0 10 FA            DJNZ .restCol
 448+ 9BC2 E1               POP HL
 449+ 9BC3 D5               PUSH DE
 450+ 9BC4 11 20 00         LD DE, 32
 451+ 9BC7 19               ADD HL, DE
 452+ 9BC8 D1               POP DE
 453+ 9BC9 0D               DEC C
 454+ 9BCA 20 EB            JR NZ, .restRow
 455+ 9BCC C9               RET
 456+ 9BCD
 457+ 9BCD              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BCD              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BCD              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BCD              ; ---
 461+ 9BCD 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BDD 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BDE 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BDF 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D11 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D12
 467+ 9D12              ; ==============================================================================
 468+ 9D12              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D12              ; ==============================================================================
 470+ 9D12              ; Entrada: A = indice de entidad (0-16)
 471+ 9D12              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D12              ; ==============================================================================
 473+ 9D12              SetAttrSlot:
 474+ 9D12 32 11 9D         LD (CurrentAttrSlot), A
 475+ 9D15                  ; Calcular offset: A * 18
 476+ 9D15 6F               LD L, A
 477+ 9D16 26 00            LD H, 0
 478+ 9D18 29               ADD HL, HL                  ; x2
 479+ 9D19 54               LD D, H
 480+ 9D1A 5D               LD E, L                     ; DE = x2
 481+ 9D1B 29               ADD HL, HL                  ; x4
 482+ 9D1C 29               ADD HL, HL                  ; x8
 483+ 9D1D 29               ADD HL, HL                  ; x16
 484+ 9D1E 19               ADD HL, DE                  ; x18
 485+ 9D1F 11 DF 9B         LD DE, SavedAttrTable
 486+ 9D22 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D23                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D23 11 CD 9B         LD DE, EntitySavedAttr
 489+ 9D26 01 12 00         LD BC, 18
 490+ 9D29 ED B0            LDIR
 491+ 9D2B C9               RET
 492+ 9D2C
 493+ 9D2C              ; ==============================================================================
 494+ 9D2C              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D2C              ; ==============================================================================
 496+ 9D2C              FlushAttrSlot:
 497+ 9D2C 3A 11 9D         LD A, (CurrentAttrSlot)
 498+ 9D2F 6F               LD L, A
 499+ 9D30 26 00            LD H, 0
 500+ 9D32 29               ADD HL, HL                  ; x2
 501+ 9D33 54               LD D, H
 502+ 9D34 5D               LD E, L
 503+ 9D35 29               ADD HL, HL                  ; x4
 504+ 9D36 29               ADD HL, HL                  ; x8
 505+ 9D37 29               ADD HL, HL                  ; x16
 506+ 9D38 19               ADD HL, DE                  ; x18
 507+ 9D39 11 DF 9B         LD DE, SavedAttrTable
 508+ 9D3C 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D3D EB               EX DE, HL                   ; DE = destino
 510+ 9D3E 21 CD 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D41 01 12 00         LD BC, 18
 512+ 9D44 ED B0            LDIR
 513+ 9D46 C9               RET
 514+ 9D47
 515+ 9D47              ; ==============================================================================
 516+ 9D47              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D47              ; ==============================================================================
 518+ 9D47              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D47              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D47              ; ==============================================================================
 521+ 9D47              CalcAttrAddr:
 522+ 9D47 7A               LD A, D
 523+ 9D48 0F               RRCA
 524+ 9D49 0F               RRCA
 525+ 9D4A 0F               RRCA
 526+ 9D4B E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D4D 6F               LD L, A
 528+ 9D4E 26 00            LD H, 0
 529+ 9D50 29               ADD HL, HL
 530+ 9D51 29               ADD HL, HL
 531+ 9D52 29               ADD HL, HL
 532+ 9D53 29               ADD HL, HL
 533+ 9D54 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D55 7B               LD A, E
 535+ 9D56 0F               RRCA
 536+ 9D57 0F               RRCA
 537+ 9D58 0F               RRCA
 538+ 9D59 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D5B B5               OR L
 540+ 9D5C 6F               LD L, A
 541+ 9D5D 01 00 58         LD BC, ATTR_BASE
 542+ 9D60 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D61 C9               RET
 544+ 9D62
 545+ 9D62              ; ==============================================================================
 546+ 9D62              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D62              ; ==============================================================================
 548+ 9D62              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D62              ; Salida: HL=direccion en VRAM
 550+ 9D62              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D62              ; ==============================================================================
 552+ 9D62              CalcPixelAddr:
 553+ 9D62 7A               LD A, D
 554+ 9D63 E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D65 1F               RRA
 556+ 9D66 1F               RRA
 557+ 9D67 1F               RRA                         ; >> 3
 558+ 9D68 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D6A 67               LD H, A
 560+ 9D6B
 561+ 9D6B 7A               LD A, D
 562+ 9D6C E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D6E B4               OR H
 564+ 9D6F 67               LD H, A
 565+ 9D70
 566+ 9D70 7A               LD A, D
 567+ 9D71 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D73 87               ADD A, A
 569+ 9D74 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D75 6F               LD L, A
 571+ 9D76
 572+ 9D76 7B               LD A, E
 573+ 9D77 1F               RRA
 574+ 9D78 1F               RRA
 575+ 9D79 1F               RRA
 576+ 9D7A E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D7C B5               OR L
 578+ 9D7D 6F               LD L, A
 579+ 9D7E C9               RET
 580+ 9D7F
 581+ 9D7F              ; ==============================================================================
 582+ 9D7F              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D7F              ; ==============================================================================
 584+ 9D7F              DrawDebugInfo:
 585+ 9D7F 3A 10 83         LD A, (CurrentScreenX)
 586+ 9D82 1E 00            LD E, 0
 587+ 9D84 CD A1 9D         CALL .drawHexDigit
 588+ 9D87
 589+ 9D87 3E 2C            LD A, ','
 590+ 9D89 1E 01            LD E, 1
 591+ 9D8B CD AD 9D         CALL .drawChar
 592+ 9D8E
 593+ 9D8E 3A 11 83         LD A, (CurrentScreenY)
 594+ 9D91 1E 02            LD E, 2
 595+ 9D93 CD A1 9D         CALL .drawHexDigit
 596+ 9D96
 597+ 9D96 21 00 58         LD HL, ATTR_BASE
 598+ 9D99 3E 47            LD A, WHITE | $40
 599+ 9D9B 77               LD (HL), A
 600+ 9D9C 23               INC HL
 601+ 9D9D 77               LD (HL), A
 602+ 9D9E 23               INC HL
 603+ 9D9F 77               LD (HL), A
 604+ 9DA0 C9               RET
