2708+ ADCA
2709+ ADCA                  ; --- Animacion: seleccionar par de frames segun direccion horizontal ---
2710+ ADCA                  ; DELTAX >= 0 → base+0,base+1 (derecha). DELTAX < 0 → base+2,base+3 (izquierda).
2711+ ADCA DD 7E 06         LD A, (IX+ENT_DELTAX)
2712+ ADCD 0E 00            LD C, ENEMY_FRAMES_RIGHT    ; C = offset de direccion (0 = derecha)
2713+ ADCF CB 7F            BIT 7, A
2714+ ADD1 28 02            JR Z, .eAnimDir
2715+ ADD3 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2716+ ADD5              .eAnimDir:
2717+ ADD5 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2718+ ADD8 20 27            JR NZ, .eAnimDone
2719+ ADDA 3A 5B 8D         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2720+ ADDD 47               LD B, A
2721+ ADDE DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2722+ ADE1 FE 34            CP SPRID_ENEMY_5
2723+ ADE3 78               LD A, B
2724+ ADE4 20 06            JR NZ, .eAnimDelaySet
2725+ ADE6 CB 3F            SRL A                               ; Rata: mitad del delay
2726+ ADE8 B7               OR A
2727+ ADE9 20 01            JR NZ, .eAnimDelaySet
2728+ ADEB 3C               INC A                               ; Minimo 1
2729+ ADEC              .eAnimDelaySet:
2730+ ADEC DD 77 09         LD (IX+ENT_ANIMTIMER), A
2731+ ADEF                  ; Avanzar frame dentro del par (2 frames por direccion)
2732+ ADEF DD 7E 00         LD A, (IX+ENT_SPRITEID)
2733+ ADF2 47               LD B, A
2734+ ADF3 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2735+ ADF6                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2736+ ADF6 E6 01            AND 1
2737+ ADF8 20 03            JR NZ, .eFrameReset
2738+ ADFA                  ; Frame 0 del par → avanzar a frame 1
2739+ ADFA 04               INC B
2740+ ADFB 18 01            JR .eFrameSet
2741+ ADFD              .eFrameReset:
2742+ ADFD                  ; Frame 1 del par → volver a frame 0
2743+ ADFD 05               DEC B
2744+ ADFE              .eFrameSet:
2745+ ADFE DD 70 00         LD (IX+ENT_SPRITEID), B
2746+ AE01              .eAnimDone:
2747+ AE01                  ; Ajustar sprite al par correcto segun direccion
2748+ AE01 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2749+ AE04 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset actual
2750+ AE07 E6 01            AND 1                       ; preservar frame (0 o 1) dentro del par
2751+ AE09 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
