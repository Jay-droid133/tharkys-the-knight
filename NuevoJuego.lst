 332  CFEF                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CFEF              ; ==============================================================================
   2+ CFEF              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CFEF              ; ==============================================================================
   4+ CFEF              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CFEF              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CFEF              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CFEF              ; ==============================================================================
   8+ CFEF
   9+ CFEF              ; ==============================================================================
  10+ CFEF              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CFEF              ; ==============================================================================
  12+ CFEF              InitScreenSystem:
  13+ CFEF 3E 0F            LD A, START_SCREEN_X
  14+ CFF1 32 8F 82         LD (CurrentScreenX), A
  15+ CFF4 3E 06            LD A, START_SCREEN_Y
  16+ CFF6 32 90 82         LD (CurrentScreenY), A
  17+ CFF9 3E 01            LD A, 1
  18+ CFFB 32 97 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CFFE AF               XOR A
  20+ CFFF 32 93 82         LD (ScreenTransition), A
  21+ D002 CD 06 D0         CALL CalcScreenAddress
  22+ D005 C9               RET
  23+ D006
  24+ D006              ; ==============================================================================
  25+ D006              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ D006              ; ==============================================================================
  27+ D006              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ D006              ; ==============================================================================
  29+ D006              CalcScreenAddress:
  30+ D006 3A 90 82         LD A, (CurrentScreenY)
  31+ D009 6F               LD L, A
  32+ D00A 26 00            LD H, 0
  33+ D00C 29               ADD HL, HL                  ; x2
  34+ D00D 29               ADD HL, HL                  ; x4
  35+ D00E 29               ADD HL, HL                  ; x8
  36+ D00F 29               ADD HL, HL                  ; x16
  37+ D010 3A 8F 82         LD A, (CurrentScreenX)
  38+ D013 5F               LD E, A
  39+ D014 16 00            LD D, 0
  40+ D016 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ D017 11 C2 DF         LD DE, MapTable
  42+ D01A 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ D01B 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ D01C                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ D01C 6F               LD L, A
  46+ D01D 26 00            LD H, 0
  47+ D01F 29               ADD HL, HL                  ; index * 2
  48+ D020 11 90 DE         LD DE, RoomTable
  49+ D023 19               ADD HL, DE
  50+ D024 5E               LD E, (HL)
  51+ D025 23               INC HL
  52+ D026 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ D027                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ D027 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ D028 CD F7 69         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ D02B                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ D02B 11 7C 85         LD DE, CurrentScreenBuffer
  58+ D02E ED 53 91 82      LD (CurrentScreenAddr), DE
  59+ D032 C9               RET
  60+ D033
  61+ D033              ; ==============================================================================
  62+ D033              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ D033              ; ==============================================================================
  64+ D033              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ D033              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ D033              ; por estar atrapado cerca del borde.
  67+ D033              ; ==============================================================================
  68+ D033              CheckScreenTransition:
  69+ D033 AF               XOR A
  70+ D034 32 93 82         LD (ScreenTransition), A
  71+ D037
  72+ D037                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ D037                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ D037                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ D037                  ; dispararia transicion sur en plena animacion.
  76+ D037 3A 5E 82         LD A, (TownGatePhase)
  77+ D03A B7               OR A
  78+ D03B C0               RET NZ
  79+ D03C
  80+ D03C                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ D03C                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ D03C                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ D03C                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ D03C                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ D03C                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ D03C 3A 4E 82         LD A, (TimeFrozen)
  87+ D03F B7               OR A
  88+ D040 28 23            JR Z, .cstNotFrozen
  89+ D042 3A 46 82         LD A, (InputDirection)
  90+ D045 CB 4F            BIT 1, A                    ; S
  91+ D047 28 17            JR Z, .cstClearBlockFlag
  92+ D049 3A 3A 81         LD A, (EntityTable + ENT_POSY)
  93+ D04C FE A8            CP SCREEN_MAX_Y
  94+ D04E 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ D050                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ D050 3A 4F 82         LD A, (BlockedExitSoundFlag)
  97+ D053 B7               OR A
  98+ D054 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ D055 3E 01            LD A, 1
 100+ D057 32 4F 82         LD (BlockedExitSoundFlag), A
 101+ D05A 21 57 F9         LD HL, SFX_BlockedExit
 102+ D05D C3 33 F8         JP PlaySFX                  ; tail call
 103+ D060              .cstClearBlockFlag:
 104+ D060 AF               XOR A
 105+ D061 32 4F 82         LD (BlockedExitSoundFlag), A
 106+ D064 C9               RET
 107+ D065              .cstNotFrozen:
 108+ D065                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ D065 AF               XOR A
 110+ D066 32 4F 82         LD (BlockedExitSoundFlag), A
 111+ D069
 112+ D069 3A 46 82         LD A, (InputDirection)
 113+ D06C 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ D06D
 115+ D06D                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ D06D CB 5A            BIT 3, D                    ; W
 117+ D06F CA BD D0         JP Z, .noWest
