1288+ 8F06 5E               LD E, (HL)                          ; OLDX
1289+ 8F07 23               INC HL
1290+ 8F08 56               LD D, (HL)                          ; OLDY
1291+ 8F09 23               INC HL
1292+ 8F0A 7E               LD A, (HL)
1293+ 8F0B 23               INC HL
1294+ 8F0C 66               LD H, (HL)
1295+ 8F0D 6F               LD L, A                             ; HL = sprite data addr
1296+ 8F0E                  ; D=Y, E=X para DrawSprite
1297+ 8F0E DD E5            PUSH IX
1298+ 8F10 E5               PUSH HL
1299+ 8F11 DD E1            POP IX                              ; IX = sprite data
