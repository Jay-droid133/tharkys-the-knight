 227+ 9E9D              ; ==============================================================================
 228+ 9E9D              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9E9D              ; ==============================================================================
 230+ 9E9D              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9E9D              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9E9D              ;
 233+ 9E9D              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9E9D              ; ==============================================================================
 235+ 9E9D              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9E9D              NextPixelLine:
 237+ 9E9D 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9E9E 7C               LD A, H
 239+ 9E9F E6 07            AND 7
 240+ 9EA1 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9EA2
 242+ 9EA2                  ; --- Cruce de character row ---
 243+ 9EA2 7D               LD A, L
 244+ 9EA3 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9EA5 6F               LD L, A
 246+ 9EA6 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9EA8 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9EA9
 249+ 9EA9                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9EA9 7C               LD A, H
 251+ 9EAA D6 08            SUB 8
 252+ 9EAC 67               LD H, A
 253+ 9EAD C9               RET
