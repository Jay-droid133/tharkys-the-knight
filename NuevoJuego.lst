 304+ 9DEA              ; ==============================================================================
 305+ 9DEA              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9DEA              ; ==============================================================================
 307+ 9DEA              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9DEA              ; Se llama ANTES de pintar el sprite.
 309+ 9DEA              ;
 310+ 9DEA              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9DEA              ;          IX = puntero al sprite (para leer width/height)
 312+ 9DEA              ; ==============================================================================
 313+ 9DEA              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9DEA              ; ==============================================================================
 315+ 9DEA              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9DEA              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9DEA              ; ==============================================================================
 318+ 9DEA              CalcEntityAttrSize:
 319+ 9DEA                  ; Paging inline (ver nota en DrawSprite)
 320+ 9DEA 3A 82 90         LD A, (CurrentPaging)
 321+ 9DED E6 F8            AND $F8
 322+ 9DEF F6 06            OR 6
 323+ 9DF1 32 82 90         LD (CurrentPaging), A
 324+ 9DF4 01 FD 7F         LD BC, $7FFD
 325+ 9DF7 ED 79            OUT (C), A
 326+ 9DF9 CD 0A 9E         CALL _CalcEntityAttrSizeImpl
 327+ 9DFC 3A 82 90         LD A, (CurrentPaging)
 328+ 9DFF E6 F8            AND $F8
 329+ 9E01 32 82 90         LD (CurrentPaging), A
 330+ 9E04 01 FD 7F         LD BC, $7FFD
 331+ 9E07 ED 79            OUT (C), A
 332+ 9E09 C9               RET
 333+ 9E0A
 334+ 9E0A              _CalcEntityAttrSizeImpl:
 335+ 9E0A DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9E0D 47               LD B, A
 337+ 9E0E 7B               LD A, E
 338+ 9E0F E6 07            AND 7
 339+ 9E11 28 01            JR Z, .ceNoExtra
 340+ 9E13 04               INC B
 341+ 9E14              .ceNoExtra:
 342+ 9E14 78               LD A, B
 343+ 9E15 32 BB 9E         LD (EntityAttrW), A
 344+ 9E18 7A               LD A, D
 345+ 9E19 E6 07            AND 7
 346+ 9E1B 4F               LD C, A
 347+ 9E1C DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9E1F 81               ADD A, C
 349+ 9E20 C6 07            ADD A, 7
 350+ 9E22 0F               RRCA
 351+ 9E23 0F               RRCA
 352+ 9E24 0F               RRCA
 353+ 9E25 E6 1F            AND $1F
 354+ 9E27 32 BC 9E         LD (EntityAttrH), A
 355+ 9E2A C9               RET
