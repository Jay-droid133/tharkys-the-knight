 530+ EF85              ; ==============================================================================
 531+ EF85              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EF85              ; ==============================================================================
 533+ EF85              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EF85              ; ==============================================================================
 535+ EF85              DrawHandLine:
 536+ EF85 87               ADD A, A
 537+ EF86 4F               LD C, A
 538+ EF87 06 00            LD B, 0
