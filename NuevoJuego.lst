 576+ 73BA              .urpDoRoulette:
 577+ 73BA                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
 578+ 73BA                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
 579+ 73BA                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
 580+ 73BA                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
 581+ 73BA 3E 06            LD A, ROLLED_ROULETTE
 582+ 73BC 32 D5 5F         LD (RP_TmpRolled), A
 583+ 73BF 3E 01            LD A, 1
 584+ 73C1 32 BC 5F         LD (RouletteActive), A
 585+ 73C4                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
 586+ 73C4 ED 5F            LD A, R
 587+ 73C6 06 09            LD B, ROULETTE_ORDER_LEN
 588+ 73C8              .urpRouletteModLoop:
 589+ 73C8 90               SUB B
 590+ 73C9 30 FD            JR NC, .urpRouletteModLoop
 591+ 73CB 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
 592+ 73CC 32 BD 5F         LD (RouletteIdx), A
 593+ 73CF 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
 594+ 73D0 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 595+ 73D2 32 BE 5F         LD (RouletteFrameCounter), A
 596+ 73D5 78               LD A, B
 597+ 73D6 CD 33 71         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
 598+ 73D9              .urpActivate:
 599+ 73D9                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
 600+ 73D9 CD 5D 71         CALL LoadSynthSpriteAndExtractAttr
 601+ 73DC 3A 0B 83         LD A, (CurrentScreenX)
 602+ 73DF 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
 603+ 73E2 3A 0C 83         LD A, (CurrentScreenY)
 604+ 73E5 32 B5 5F         LD (RandomSynthMapY), A
 605+ 73E8 3E FF            LD A, $FF
 606+ 73EA 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
 607+ 73ED 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
 608+ 73EF                                                      ; ya están set por .urpDoXxx — no resetear)
 609+ 73EF
 610+ 73EF              ; ==============================================================================
 611+ 73EF              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
 612+ 73EF              ; ==============================================================================
 613+ 73EF              ; prev ← cur (data de la sala que dejamos).
 614+ 73EF              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
 615+ 73EF              ;
 616+ 73EF              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
 617+ 73EF              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
 618+ 73EF              ; ==============================================================================
 619+ 73EF              .urpZeroAndRotate:
 620+ 73EF AF               XOR A
 621+ 73F0 32 D4 5F         LD (RP_TmpSlot), A
 622+ 73F3 32 D5 5F         LD (RP_TmpRolled), A
 623+ 73F6              .urpRotateAndRet:
 624+ 73F6                  ; prev ← cur
 625+ 73F6 3A CE 5F         LD A, (RP_CurSid)
 625+ 73F9 32 D1 5F       LD (RP_PrevSid), A
 626+ 73FC 3A CF 5F         LD A, (RP_CurSlot)
 626+ 73FF 32 D2 5F       LD (RP_PrevSlot), A
