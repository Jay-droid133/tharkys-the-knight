 699+ EDE1              ; ==============================================================================
 700+ EDE1              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 701+ EDE1              ; ==============================================================================
 702+ EDE1              ; Se llama desde:
 703+ EDE1              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 704+ EDE1              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 705+ EDE1              ;     por encima y los borro.
 706+ EDE1              ;
 707+ EDE1              ; Bypass total del day/night remap → respeta exactamente el patrón per-celda
 708+ EDE1              ; que el BG editor exporta (ej: col1 bright + col2 dim). Lee los 4 attrs
 709+ EDE1              ; ya extraídos por LoadSynthSpriteAndExtractAttr (RandomSynthAttr=TL,
 710+ EDE1              ; RandomSynthAttrTR, RandomSynthAttrBL, RandomSynthAttrBR) y los pinta
 711+ EDE1              ; 1:1 en VRAM.
 712+ EDE1              ;
 713+ EDE1              ; Pickup es 16x16 = 2x2 char attrs.
 714+ EDE1              ; Early-out si RandomSynthMapX = $FE (no activo).
 715+ EDE1              ; Destruye AF, BC, DE, HL.
 716+ EDE1              ; ==============================================================================
 717+ EDE1              PaintSynthPickupAttrsBody:
 718+ EDE1 3A B4 5F         LD A, (RandomSynthMapX)
 719+ EDE4 FE FE            CP $FE
 720+ EDE6 C8               RET Z                               ; no activo
 721+ EDE7                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 722+ EDE7 3A B9 5F         LD A, (RandomSynthCharY)
 723+ EDEA C6 02            ADD A, BG_Y_OFFSET
 724+ EDEC 26 00            LD H, 0
 725+ EDEE 6F               LD L, A
 726+ EDEF 29               ADD HL, HL
 727+ EDF0 29               ADD HL, HL
 728+ EDF1 29               ADD HL, HL
 729+ EDF2 29               ADD HL, HL
 730+ EDF3 29               ADD HL, HL                          ; *32
 731+ EDF4 3A B8 5F         LD A, (RandomSynthCharX)
 732+ EDF7 85               ADD A, L
 733+ EDF8 6F               LD L, A
 734+ EDF9 30 01            JR NC, .pspaNoCarry
 735+ EDFB 24               INC H
 736+ EDFC              .pspaNoCarry:
 737+ EDFC 11 00 58         LD DE, ATTR_BASE
 738+ EDFF 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 739+ EE00                  ; --- Fila 0: TL, TR ---
 740+ EE00 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
 741+ EE03 77               LD (HL), A
 742+ EE04 23               INC HL
 743+ EE05 3A D9 5F         LD A, (RandomSynthAttrTR)
 744+ EE08 77               LD (HL), A
 745+ EE09                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
 746+ EE09 7D               LD A, L
 747+ EE0A C6 1F            ADD A, 31
 748+ EE0C 6F               LD L, A
 749+ EE0D 30 01            JR NC, .pspaNoCarry2
 750+ EE0F 24               INC H
