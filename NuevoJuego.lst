 702+ CDB6                  ; ===================== PATH LITERAL (sin cambios) =====================
 703+ CDB6              .pixRow:
 704+ CDB6 3A 7F CE         LD A, (.widthVal)
 705+ CDB9 47               LD B, A
 706+ CDBA E5               PUSH HL                     ; guardar inicio de fila VRAM
 707+ CDBB
 708+ CDBB              .pixCol:
 709+ CDBB DD 7E 00         LD A, (IX+0)
 710+ CDBE 2F               CPL                         ; des-invertir (dato almacenado CPL'd)
 711+ CDBF 77               LD (HL), A
 712+ CDC0 DD 23            INC IX
 713+ CDC2 23               INC HL
 714+ CDC3 10 F6            DJNZ .pixCol
 715+ CDC5
 716+ CDC5 E1               POP HL                      ; restaurar inicio fila
 717+ CDC6 3A 7E CE         LD A, (.heightCnt)
 718+ CDC9 3D               DEC A
 719+ CDCA 32 7E CE         LD (.heightCnt), A
 720+ CDCD 28 66            JR Z, .pixDone
 721+ CDCF CD 88 9E         CALL NextPixelLine          ; HL = siguiente linea pixel
 722+ CDD2 18 E2            JR .pixRow
 723+ CDD4
 724+ CDD4                  ; ===================== PATH RLE =====================
 725+ CDD4                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 726+ CDD4                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 727+ CDD4                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 728+ CDD4                  ; El estado .rlePending conserva el chunk entre filas:
 729+ CDD4                  ;   0 = necesita nuevo token
 730+ CDD4                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 731+ CDD4                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 732+ CDD4              .rlePixRow:
 733+ CDD4 3A 7F CE         LD A, (.widthVal)
 734+ CDD7 47               LD B, A
 735+ CDD8 E5               PUSH HL                     ; guardar inicio de fila VRAM
 736+ CDD9
 737+ CDD9              .rlePixCol:
 738+ CDD9 3A 83 CE         LD A, (.rlePending)
 739+ CDDC B7               OR A
 740+ CDDD CA F4 CD         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 741+ CDE0 FA 02 CE         JP M, .rleLitEmit           ; <0 = literal group en curso
 742+ CDE3                  ; >0 = run en curso, emitir valor
 743+ CDE3              .rleRunEmit:
 744+ CDE3 3A 84 CE         LD A, (.rleValue)
 745+ CDE6 2F               CPL
 746+ CDE7 77               LD (HL), A
 747+ CDE8 23               INC HL
 748+ CDE9 3A 83 CE         LD A, (.rlePending)
 749+ CDEC 3D               DEC A
 750+ CDED 32 83 CE         LD (.rlePending), A
 751+ CDF0 10 E7            DJNZ .rlePixCol
 752+ CDF2 18 32            JR .rleRowDone
 753+ CDF4
 754+ CDF4              .rleNewToken:
 755+ CDF4 DD 7E 00         LD A, (IX+0)
 756+ CDF7 DD 23            INC IX
 757+ CDF9 CB 7F            BIT 7, A
 758+ CDFB 20 18            JR NZ, .rleNewRun
