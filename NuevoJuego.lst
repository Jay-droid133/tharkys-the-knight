2717+ B137 DD 7E 03         LD A, (IX+ENT_POSX)
2718+ B13A FE E8            CP SCREEN_MAX_X
2719+ B13C 30 30            JR NC, .moKbPreOffscreen
2720+ B13E FE 04            CP MONSTER_KB_SPEED
2721+ B140 38 20            JR C, .moKbPreOffscreenMaybeX
2722+ B142              .moKbPreBorderXOk:
2723+ B142 DD 7E 04         LD A, (IX+ENT_POSY)
2724+ B145 FE A8            CP SCREEN_MAX_Y
2725+ B147 30 25            JR NC, .moKbPreOffscreen
2726+ B149 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2727+ B14B 38 1B            JR C, .moKbPreOffscreenMaybeY
2728+ B14D              .moKbPreBorderOk:
2729+ B14D                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2730+ B14D                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2731+ B14D                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2732+ B14D                  ; CheckEnemyCollision.
2733+ B14D                  ; CheckChurchTrap retorna:
2734+ B14D                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2735+ B14D                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2736+ B14D                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2737+ B14D CD 2A F4         CALL CheckChurchTrap
2738+ B150 B7               OR A
2739+ B151 28 07            JR Z, .moKbCollCheck
2740+ B153 FE 02            CP 2
2741+ B155 CA 06 B2         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2742+ B158 D1               POP DE                              ; limpiar PUSH DE previo
2743+ B159 C9               RET                                 ; cutscene activa, salir
2744+ B15A              .moKbCollCheck:
2745+ B15A                  ; Dentro de pantalla: comprobar colision con paredes
2746+ B15A CD D3 B9         CALL CheckEnemyCollision
2747+ B15D C2 06 B2         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2748+ B160 18 1C            JR .moKbNotBlocked
