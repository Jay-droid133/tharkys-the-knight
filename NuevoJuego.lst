 180+ 9DDF CD A5 A0         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9DE2
 182+ 9DE2 D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9DE3 3A 0F 9E         LD A, (.tablePage)
 184+ 9DE6 47               LD B, A                     ; B = pagina high part
 185+ 9DE7                  ; Contadores en IX (libre: se convirtio a DE arriba)
