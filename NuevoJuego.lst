   1+ 9056              ; ==============================================================================
   2+ 9056              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 9056              ; ==============================================================================
   4+ 9056              ; Port $7FFD (write-only):
   5+ 9056              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 9056              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 9056              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 9056              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 9056              ;
  10+ 9056              ; Bancos disponibles:
  11+ 9056              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 9056              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 9056              ;   Bank 1: libre para datos nuevos (contended)
  14+ 9056              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 9056              ;   Bank 3: libre para datos nuevos (contended)
  16+ 9056              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 9056              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 9056              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 9056              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 9056              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 9056              ; ==============================================================================
  22+ 9056
  23+ 9056              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 9056              ; para no machacarse a si mismas al cambiar de banco.
  25+ 9056
  26+ 9056              ; ==============================================================================
  27+ 9056              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 9056              ; ==============================================================================
  29+ 9056              ; Entrada: A = banco (0-7)
  30+ 9056              ; Preserva: HL, DE, IX, IY
  31+ 9056              ; Destruye: A, BC
  32+ 9056              ; ==============================================================================
  33+ 9056              PageBankSlot3:
  34+ 9056 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 9058 47               LD B, A                     ; guardar banco nuevo
  36+ 9059 3A 42 90         LD A, (CurrentPaging)
  37+ 905C E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 905E B0               OR B                        ; poner nuevo banco
  39+ 905F 32 42 90         LD (CurrentPaging), A
  40+ 9062 01 FD 7F         LD BC, $7FFD
  41+ 9065 ED 79            OUT (C), A
  42+ 9067 C9               RET
  43+ 9068
  44+ 9068              ; ==============================================================================
  45+ 9068              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 9068              ; ==============================================================================
  47+ 9068              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 9068              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 9068              ; ==============================================================================
  50+ 9068              InitPaging:
  51+ 9068 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 906A 32 42 90         LD (CurrentPaging), A
  53+ 906D 01 FD 7F         LD BC, $7FFD
  54+ 9070 ED 79            OUT (C), A
  55+ 9072 C9               RET
  56+ 9073
  57+ 9073              ; ==============================================================================
  58+ 9073              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 9073              ; ==============================================================================
  60+ 9073              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 9073              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 9073              ;      Paginacion restaurada a bank 0.
  63+ 9073              ; Destruye: A, BC, DE, HL
  64+ 9073              ;
  65+ 9073              ; Formato del room en FUENTE (variable-length):
  66+ 9073              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 9073              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 9073              ;   terminador:                  DEFB $FF
  69+ 9073              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 9073              ;
  71+ 9073              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 9073              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 9073              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 9073              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 9073              ; ==============================================================================
  76+ 9073              LoadRoomToBuffer:
  77+ 9073                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 9073                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 9073                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 9073                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 9073                  ;
  82+ 9073                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 9073                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 9073                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 9073                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 9073 F3               DI
  87+ 9074                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 9074 3A 42 90         LD A, (CurrentPaging)
  89+ 9077 E6 F8            AND $F8
  90+ 9079 F6 01            OR 1
  91+ 907B 32 42 90         LD (CurrentPaging), A
  92+ 907E 01 FD 7F         LD BC, $7FFD
  93+ 9081 ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 9083                  ; --- Copy + decompress loop ---
  95+ 9083                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 9083                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 9083 11 F5 84         LD DE, CurrentScreenBuffer
  98+ 9086              .lrbLoop:
  99+ 9086 7E               LD A, (HL)                      ; id
 100+ 9087 12               LD (DE), A
 101+ 9088 23               INC HL
 102+ 9089 13               INC DE
 103+ 908A FE FF            CP $FF                          ; terminador?
 104+ 908C 28 1B            JR Z, .lrbDone
 105+ 908E                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 908E                  ; al buffer escribimos x limpio (AND $7F).
 107+ 908E 7E               LD A, (HL)
 108+ 908F 23               INC HL
 109+ 9090 47               LD B, A                         ; B = x raw (con flag)
 110+ 9091 E6 7F            AND $7F
 111+ 9093 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 9094 13               INC DE
 113+ 9095                  ; Copiar y
 114+ 9095 7E               LD A, (HL)
 115+ 9096 12               LD (DE), A
 116+ 9097 23               INC HL
 117+ 9098 13               INC DE
 118+ 9099                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 9099 CB 78            BIT 7, B
 120+ 909B 28 06            JR Z, .lrbNoTint
 121+ 909D 7E               LD A, (HL)                      ; v desde source
 122+ 909E 23               INC HL
 123+ 909F 12               LD (DE), A
 124+ 90A0 13               INC DE
 125+ 90A1 18 E3            JR .lrbLoop
 126+ 90A3              .lrbNoTint:
 127+ 90A3 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 90A5 12               LD (DE), A
 129+ 90A6 13               INC DE
 130+ 90A7 18 DD            JR .lrbLoop
 131+ 90A9              .lrbDone:
 132+ 90A9                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 90A9 3A 42 90         LD A, (CurrentPaging)
 134+ 90AC E6 F8            AND $F8                         ; bank 0
 135+ 90AE 32 42 90         LD (CurrentPaging), A
 136+ 90B1 01 FD 7F         LD BC, $7FFD
 137+ 90B4 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 90B6                  ; Restaurar interrupciones si Inicio ya termino
 139+ 90B6 3A C6 80         LD A, (StartupComplete)
 140+ 90B9 B7               OR A
 141+ 90BA C8               RET Z                           ; aun en Inicio -> dejar DI
 142+ 90BB FB               EI
 143+ 90BC C9               RET
 144+ 90BD
 145+ 90BD              ; ==============================================================================
 146+ 90BD              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 147+ 90BD              ; ==============================================================================
 148+ 90BD              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 149+ 90BD              ;      A  = bank (0-7) donde vive el sprite
 150+ 90BD              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 151+ 90BD              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 152+ 90BD              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 153+ 90BD              ;
 154+ 90BD              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 155+ 90BD              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 156+ 90BD              ; forzar EI prematuro en startup.
 157+ 90BD              ;
 158+ 90BD              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 159+ 90BD              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 160+ 90BD              ; ==============================================================================
 161+ 90BD              LoadBgSpriteToBuffer:
 162+ 90BD                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 163+ 90BD                  ; necesitan intacto, y los registros alternos se usan abajo).
 164+ 90BD 32 4C 91         LD (.lbsBankSave), A
 165+ 90C0                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 166+ 90C0                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 167+ 90C0 C5               PUSH BC
 168+ 90C1                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 169+ 90C1 F3               DI
 170+ 90C2                  ; Page bank deseado inline
 171+ 90C2 3A 42 90         LD A, (CurrentPaging)
 172+ 90C5 E6 F8            AND $F8
 173+ 90C7 47               LD B, A                         ; B = paging limpio sin bank
 174+ 90C8 3A 4C 91         LD A, (.lbsBankSave)
 175+ 90CB E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 90CD B0               OR B                            ; merge bank en paging
 177+ 90CE 32 42 90         LD (CurrentPaging), A
 178+ 90D1 01 FD 7F         LD BC, $7FFD
 179+ 90D4 ED 79            OUT (C), A
 180+ 90D6                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 90D6                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 90D6                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 90D6                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 90D6 11 F5 88         LD DE, BgSpriteBuffer
 185+ 90D9                  ; Copiar H (header byte 0)
 186+ 90D9 7E               LD A, (HL)
 187+ 90DA 12               LD (DE), A
 188+ 90DB 32 4A 91         LD (.lbsHsave), A
 189+ 90DE 23               INC HL
 190+ 90DF 13               INC DE
 191+ 90E0                  ; Copiar W|RLE (header byte 1)
 192+ 90E0 7E               LD A, (HL)
 193+ 90E1 12               LD (DE), A
 194+ 90E2 23               INC HL
 195+ 90E3 13               INC DE
 196+ 90E4 CB 7F            BIT 7, A
 197+ 90E6 20 47            JR NZ, .lbsRleFallback
 198+ 90E8 E6 7F            AND $7F
 199+ 90EA 32 4B 91         LD (.lbsWsave), A
 200+ 90ED                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 90ED 3A 4A 91         LD A, (.lbsHsave)
 202+ 90F0 B7               OR A
 203+ 90F1 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 90F3 47               LD B, A                         ; B = H (outer loop)
 205+ 90F4              .lbsPixRow:
 206+ 90F4 3A 4B 91         LD A, (.lbsWsave)
 207+ 90F7 B7               OR A
 208+ 90F8 28 08            JR Z, .lbsPixRowDone
 209+ 90FA 4F               LD C, A                         ; C = W (inner loop)
 210+ 90FB              .lbsPixCol:
 211+ 90FB 7E               LD A, (HL)
 212+ 90FC 12               LD (DE), A
 213+ 90FD 23               INC HL
 214+ 90FE 13               INC DE
 215+ 90FF 0D               DEC C
 216+ 9100 20 F9            JR NZ, .lbsPixCol
 217+ 9102              .lbsPixRowDone:
 218+ 9102 10 F0            DJNZ .lbsPixRow
 219+ 9104              .lbsAfterPixels:
 220+ 9104                  ; --- Copiar 1 byte tint ---
 221+ 9104 7E               LD A, (HL)
 222+ 9105 12               LD (DE), A
 223+ 9106 23               INC HL
 224+ 9107 13               INC DE
 225+ 9108                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 226+ 9108 7E               LD A, (HL)
 227+ 9109 12               LD (DE), A
 228+ 910A 32 4A 91         LD (.lbsHsave), A               ; reusar var
 229+ 910D 23               INC HL
 230+ 910E 13               INC DE
 231+ 910F 7E               LD A, (HL)
 232+ 9110 12               LD (DE), A
 233+ 9111 32 4B 91         LD (.lbsWsave), A
 234+ 9114 23               INC HL
 235+ 9115 13               INC DE
 236+ 9116 3A 4A 91         LD A, (.lbsHsave)
 237+ 9119 B7               OR A
 238+ 911A 28 18            JR Z, .lbsLoadDone              ; sin attrs
 239+ 911C 47               LD B, A
 240+ 911D              .lbsAttrRow:
 241+ 911D 3A 4B 91         LD A, (.lbsWsave)
 242+ 9120 B7               OR A
 243+ 9121 28 08            JR Z, .lbsAttrRowDone
 244+ 9123 4F               LD C, A
 245+ 9124              .lbsAttrCol:
 246+ 9124 7E               LD A, (HL)
 247+ 9125 12               LD (DE), A
 248+ 9126 23               INC HL
 249+ 9127 13               INC DE
 250+ 9128 0D               DEC C
 251+ 9129 20 F9            JR NZ, .lbsAttrCol
 252+ 912B              .lbsAttrRowDone:
 253+ 912B 10 F0            DJNZ .lbsAttrRow
 254+ 912D 18 05            JR .lbsLoadDone
 255+ 912F
 256+ 912F              .lbsRleFallback:
 257+ 912F                  ; Sprite RLE: tamaño desconocido sin parsear, copia BG_SPRITE_BUFFER_SIZE-2
 258+ 912F 01 FE 03         LD BC, BG_SPRITE_BUFFER_SIZE - 2
 259+ 9132 ED B0            LDIR
