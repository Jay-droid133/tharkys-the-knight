1062+ A4C5              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A4C5              ; ==============================================================================
1064+ A4C5              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A4C5              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A4C5              ; ==============================================================================
1067+ A4C5              GetSpriteAddr:
1068+ A4C5                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A4C5                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A4C5 3A 84 8D         LD A, (CurrentPaging)
1071+ A4C8 E6 F8            AND $F8
1072+ A4CA F6 06            OR 6
1073+ A4CC 32 84 8D         LD (CurrentPaging), A
1074+ A4CF 01 FD 7F         LD BC, $7FFD
1075+ A4D2 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A4D4 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A4D7 6F               LD L, A
1078+ A4D8 26 00            LD H, 0
1079+ A4DA 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A4DB 11 B7 E7         LD DE, SpriteFrameTable
1081+ A4DE 19               ADD HL, DE
1082+ A4DF 5E               LD E, (HL)
1083+ A4E0 23               INC HL
1084+ A4E1 56               LD D, (HL)
1085+ A4E2 ED 53 F4 A4      LD (SpriteAddrTemp), DE
1086+ A4E6 3A 84 8D         LD A, (CurrentPaging)
1087+ A4E9 E6 F8            AND $F8
1088+ A4EB 32 84 8D         LD (CurrentPaging), A
1089+ A4EE 01 FD 7F         LD BC, $7FFD
1090+ A4F1 ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A4F3 C9               RET
1092+ A4F4
1093+ A4F4 00 00        SpriteAddrTemp: DEFW 0
