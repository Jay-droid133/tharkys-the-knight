2421+ E6BF              ; PLAYER DEATH ANIMATION - 6 frames 16x16 (3 right + 3 left)
2422+ E6BF              ; ==============================================================================
2423+ E6BF              ; Importable desde References/player death 02-32x16.aseprite (96x16 strip)
2424+ E6BF              ; via tools/import_player_death.py.
2425+ E6BF              ; Layout: SprPlayerDeath0..2 = right-facing (rodillas, cabeza, desparramado),
2426+ E6BF              ;         SprPlayerDeath3..5 = left-facing (mismas poses, mirrored).
2427+ E6BF              ; OnPlayerHealthDepleted elige base (110 o 113) segun lastHDir del player.
2428+ E6BF              ; OJO: el aseprite tiene los frames en orden LEFT-LEFT-LEFT-RIGHT-RIGHT-RIGHT;
2429+ E6BF              ; import_player_death.py los reordena al cargar para que aqui queden R primero.
2430+ E6BF              ; ==============================================================================
2431+ E6BF              SPRID_PLAYER_DEATH      EQU 110
2432+ E6BF              SPRID_PLAYER_DEATH_LEFT EQU 113
