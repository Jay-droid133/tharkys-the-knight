1593+ AAB1              ; ==============================================================================
1594+ AAB1              ; CheckPlayerMonsterOverlap - Bloquear player contra monsters (colision solida)
1595+ AAB1              ; ==============================================================================
1596+ AAB1              ; IX = player entity. Comprueba AABB con todos los monsters activos.
1597+ AAB1              ; Usa GetSpriteDims para dimensiones reales (soporta monsters de cualquier tamaño).
1598+ AAB1              ; Retorna Z=libre, NZ=bloqueado por algun monster.
1599+ AAB1              ; ==============================================================================
1600+ AAB1              CheckPlayerMonsterOverlap:
1601+ AAB1                  ; Debug noclip: Z = libre siempre (sin bloqueo por monsters)
1602+ AAB1 3A AD 82         LD A, (NoclipMode)
1603+ AAB4 B7               OR A
1604+ AAB5 28 02            JR Z, .cpmoReal
1605+ AAB7 AF               XOR A
1606+ AAB8 C9               RET
1607+ AAB9              .cpmoReal:
1608+ AAB9                  ; Guardar IX (player)
1609+ AAB9 DD E5            PUSH IX
1610+ AABB                  ; Siempre usar ancho de CUERPO (16px), no espada (24px)
1611+ AABB                  ; Asi la espada puede solapar pero el cuerpo no
1612+ AABB 3E 10            LD A, 16
1613+ AABD 32 48 AB         LD (.cpmoPlW), A
1614+ AAC0 3E 15            LD A, 21                            ; Altura player fija
1615+ AAC2 32 49 AB         LD (.cpmoPlH), A
1616+ AAC5                  ; Player pos
1617+ AAC5 DD E1            POP IX
1618+ AAC7 DD E5            PUSH IX
1619+ AAC9 DD 7E 03         LD A, (IX+ENT_POSX)
1620+ AACC 32 46 AB         LD (.cpmoPlX), A
1621+ AACF DD 7E 04         LD A, (IX+ENT_POSY)
1622+ AAD2 32 47 AB         LD (.cpmoPlY), A
1623+ AAD5
1624+ AAD5 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1625+ AAD9 06 03            LD B, MONSTERS_TO_SPAWN
1626+ AADB              .cpmoLoop:
1627+ AADB C5               PUSH BC
1628+ AADC                  ; Solo monsters activos, no muriendo/spawneando/asustados (scared = atravesables)
1629+ AADC DD 7E 01         LD A, (IX+ENT_TYPE)
1630+ AADF FE 02            CP TYPE_MONSTER
1631+ AAE1 20 57            JR NZ, .cpmoNext
1632+ AAE3 DD 7E 02         LD A, (IX+ENT_STATE)
1633+ AAE6 FE 03            CP STATE_DYING
1634+ AAE8 28 50            JR Z, .cpmoNext
1635+ AAEA FE 04            CP STATE_SPAWNING
1636+ AAEC 28 4C            JR Z, .cpmoNext
1637+ AAEE FE 05            CP STATE_SCARED
1638+ AAF0 28 48            JR Z, .cpmoNext                     ; trembling/flee: atravesable
1639+ AAF2
1640+ AAF2                  ; Obtener dims del monster
1641+ AAF2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1642+ AAF5 CD 09 A8         CALL GetSpriteDims                 ; B=monW, C=monH
1643+ AAF8
1644+ AAF8                  ; AABB: playerX < monX + monW AND monX < playerX + plW
1645+ AAF8 DD 7E 03         LD A, (IX+ENT_POSX)
1646+ AAFB 80               ADD A, B                           ; monX + monW
1647+ AAFC 38 07            JR C, .cpmoXCheck2                 ; overflow → siempre true
1648+ AAFE 57               LD D, A
1649+ AAFF 3A 46 AB         LD A, (.cpmoPlX)
