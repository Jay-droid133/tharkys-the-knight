 361+ 9B4B E6 F8            AND $F8
 362+ 9B4D F6 06            OR 6
 363+ 9B4F 32 85 8D         LD (CurrentPaging), A
 364+ 9B52 01 FD 7F         LD BC, $7FFD
 365+ 9B55 ED 79            OUT (C), A
