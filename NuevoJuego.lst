 421+ 7064 30 FD            JR NC, .urpModLoop
 422+ 7066 80               ADD A, B                            ; A = R mod count, [0..count-1]
 423+ 7067 32 D3 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
