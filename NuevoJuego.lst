 464+ DF1E              ; ---- Phase 1: lock + facing UP ----
 465+ DF1E              .bcPhLock:
 466+ DF1E CD 10 E2         CALL BankCutsceneDecTimer
 467+ DF21 C0               RET NZ
 468+ DF22                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DF22 AF               XOR A
 470+ DF23 32 C5 82         LD (BankCutsceneKnockIdx), A
 471+ DF26 32 C8 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DF29 3E 00            LD A, BCS_KNOCK_HIT
 473+ DF2B 32 C4 82         LD (BankCutsceneSubState), A
 474+ DF2E 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DF30 32 C3 82         LD (BankCutsceneTimer), A
 476+ DF33 CD 98 E1         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DF36 3E 02            LD A, BCP_KNOCKS_1
 478+ DF38 32 C2 82         LD (BankCutscenePhase), A
 479+ DF3B C9               RET
