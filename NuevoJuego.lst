 386+ 9EAB                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9EAB 7A               LD A, D                     ; Y pixel (raw)
 388+ 9EAC E6 07            AND 7                       ; Y offset dentro del char
 389+ 9EAE 4F               LD C, A
 390+ 9EAF DD 7E 01         LD A, (IX+1)                ; height_pixels
