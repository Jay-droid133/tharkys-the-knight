 201+ E457              ; SetClockToPhaseHour
 202+ E457              ; ==============================================================================
 203+ E457              SetClockToPhaseHour:
 204+ E457 21 6E E2         LD HL, PhaseStartHour
 205+ E45A 4F               LD C, A
 206+ E45B 06 00            LD B, 0
 207+ E45D 09               ADD HL, BC
 208+ E45E 7E               LD A, (HL)
 209+ E45F 32 6B E2         LD (GameHours), A
 210+ E462 AF               XOR A
 211+ E463 32 6A E2         LD (GameMinutes), A
 212+ E466 32 69 E2         LD (GameSubMinute), A
 213+ E469 C9               RET
