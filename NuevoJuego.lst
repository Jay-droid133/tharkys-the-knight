7191+ C724              ; --- CheckDeathTouchPlayer: AABB completo 24x24 vs player (no margen) ---
7192+ C724              ; Si overlap: PlayerHealth=0, erase sprite, despawn.
7193+ C724              CheckDeathTouchPlayer:
7194+ C724 3A 02 83         LD A, (DeathSpawned)
7195+ C727 B7               OR A
7196+ C728 C8               RET Z
7197+ C729 DD 21 53 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7198+ C72D DD 7E 01         LD A, (IX+ENT_TYPE)
7199+ C730 B7               OR A
7200+ C731 C8               RET Z
7201+ C732                  ; Invulnerable SOLO durante el countdown phase 1 (sin control). NO durante
7202+ C732                  ; phase 2 (grace post-respawn O post-nasty-hit) — la phase 2 se setea tambien
7203+ C732                  ; al recibir un hit de nasty (EnterGracePhase desde .pHpDmgNotZero), y eso
7204+ C732                  ; daba 1s en el que Death te seguia pegada sin matarte. Death es instakill
7205+ C732                  ; sin importar inmunidades temporales. En el path post-respawn legitimo,
7206+ C732                  ; SilentKillDeath ya la despawneo, asi que no hay riesgo de instakill al
7207+ C732                  ; recuperar control.
7208+ C732 3A F3 82         LD A, (PlayerRespawnPhase)
7209+ C735 FE 01            CP 1
7210+ C737 C8               RET Z
