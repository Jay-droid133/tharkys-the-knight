 457+ 9EFD              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9EFD              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9EFD              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9EFD              ; ---
 461+ 9EFD 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9F0D 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9F0E 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9F0F 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ A041 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ A042
 467+ A042              ; ==============================================================================
 468+ A042              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A042              ; ==============================================================================
 470+ A042              ; Entrada: A = indice de entidad (0-16)
 471+ A042              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A042              ; ==============================================================================
 473+ A042              SetAttrSlot:
 474+ A042 32 41 A0         LD (CurrentAttrSlot), A
 475+ A045                  ; Calcular offset: A * 18
 476+ A045 6F               LD L, A
 477+ A046 26 00            LD H, 0
 478+ A048 29               ADD HL, HL                  ; x2
 479+ A049 54               LD D, H
 480+ A04A 5D               LD E, L                     ; DE = x2
 481+ A04B 29               ADD HL, HL                  ; x4
 482+ A04C 29               ADD HL, HL                  ; x8
 483+ A04D 29               ADD HL, HL                  ; x16
 484+ A04E 19               ADD HL, DE                  ; x18
 485+ A04F 11 0F 9F         LD DE, SavedAttrTable
 486+ A052 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A053                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A053 11 FD 9E         LD DE, EntitySavedAttr
 489+ A056 01 12 00         LD BC, 18
 490+ A059 ED B0            LDIR
 491+ A05B C9               RET
 492+ A05C
 493+ A05C              ; ==============================================================================
 494+ A05C              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A05C              ; ==============================================================================
 496+ A05C              FlushAttrSlot:
 497+ A05C 3A 41 A0         LD A, (CurrentAttrSlot)
 498+ A05F 6F               LD L, A
 499+ A060 26 00            LD H, 0
 500+ A062 29               ADD HL, HL                  ; x2
 501+ A063 54               LD D, H
 502+ A064 5D               LD E, L
 503+ A065 29               ADD HL, HL                  ; x4
 504+ A066 29               ADD HL, HL                  ; x8
 505+ A067 29               ADD HL, HL                  ; x16
 506+ A068 19               ADD HL, DE                  ; x18
 507+ A069 11 0F 9F         LD DE, SavedAttrTable
 508+ A06C 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A06D EB               EX DE, HL                   ; DE = destino
 510+ A06E 21 FD 9E         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A071 01 12 00         LD BC, 18
 512+ A074 ED B0            LDIR
 513+ A076 C9               RET
 514+ A077
 515+ A077              ; ==============================================================================
 516+ A077              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A077              ; ==============================================================================
 518+ A077              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A077              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A077              ; ==============================================================================
 521+ A077              CalcAttrAddr:
 522+ A077 7A               LD A, D
 523+ A078 0F               RRCA
 524+ A079 0F               RRCA
 525+ A07A 0F               RRCA
 526+ A07B E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A07D 6F               LD L, A
 528+ A07E 26 00            LD H, 0
 529+ A080 29               ADD HL, HL
 530+ A081 29               ADD HL, HL
 531+ A082 29               ADD HL, HL
 532+ A083 29               ADD HL, HL
 533+ A084 29               ADD HL, HL                  ; HL = fila * 32
 534+ A085 7B               LD A, E
 535+ A086 0F               RRCA
 536+ A087 0F               RRCA
 537+ A088 0F               RRCA
 538+ A089 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A08B B5               OR L
 540+ A08C 6F               LD L, A
 541+ A08D 01 00 58         LD BC, ATTR_BASE
 542+ A090 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A091 C9               RET
 544+ A092
 545+ A092              ; ==============================================================================
 546+ A092              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A092              ; ==============================================================================
 548+ A092              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A092              ; Salida: HL=direccion en VRAM
 550+ A092              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A092              ; ==============================================================================
 552+ A092              CalcPixelAddr:
 553+ A092 7A               LD A, D
 554+ A093 E6 C0            AND $C0                     ; Y7 Y6
 555+ A095 1F               RRA
 556+ A096 1F               RRA
 557+ A097 1F               RRA                         ; >> 3
 558+ A098 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A09A 67               LD H, A
 560+ A09B
 561+ A09B 7A               LD A, D
 562+ A09C E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A09E B4               OR H
 564+ A09F 67               LD H, A
 565+ A0A0
 566+ A0A0 7A               LD A, D
 567+ A0A1 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A0A3 87               ADD A, A
 569+ A0A4 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A0A5 6F               LD L, A
 571+ A0A6
 572+ A0A6 7B               LD A, E
 573+ A0A7 1F               RRA
 574+ A0A8 1F               RRA
 575+ A0A9 1F               RRA
 576+ A0AA E6 1F            AND $1F                     ; X / 8 = columna
 577+ A0AC B5               OR L
 578+ A0AD 6F               LD L, A
 579+ A0AE C9               RET
