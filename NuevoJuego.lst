 286+ 7DBB              ; ==============================================================================
 287+ 7DBB              ; AY_WriteRegSlot1 - copia de AY_WriteReg en slot 1
 288+ 7DBB              ; ==============================================================================
 289+ 7DBB              ; Necesaria porque desde el IRQ handler (slot 1) NO podemos llamar a la
 290+ 7DBB              ; AY_WriteReg de bank 4: bank 4 puede no estar paginado en slot 3, y aunque
 291+ 7DBB              ; lo estuviera, paginarlo desde el IRQ trae el race que estamos eliminando.
 292+ 7DBB              ; Identica a AY_WriteReg (bank 4): A=registro, E=valor; clobbea BC y A.
 293+ 7DBB              ; ==============================================================================
 294+ 7DBB              AY_WriteRegSlot1:
 295+ 7DBB 01 FD FF         LD BC, $FFFD
 296+ 7DBE ED 79            OUT (C), A                      ; seleccionar registro
 297+ 7DC0 01 FD BF         LD BC, $BFFD
 298+ 7DC3 ED 59            OUT (C), E                      ; escribir valor
 299+ 7DC5 C9               RET
 300+ 7DC6
 301+ 7DC6              ; ==============================================================================
 302+ 7DC6              ; UpdateMusicImpl - catchup wall-clock. LEGACY: ya no se llama desde MainLoop.
 303+ 7DC6              ; ==============================================================================
 304+ 7DC6              ; Hoy el tick vive en MusicIrqHandler (CALL .upmiTickOnce + CALL .upmiPostLoop
 305+ 7DC6              ; cada 2 IRQs). Esta rutina catchup se mantiene como fallback por si alguna
 306+ 7DC6              ; vez queremos forzar avance N frames desde codigo.
 307+ 7DC6              ; ==============================================================================
 308+ 7DC6              UpdateMusicImpl:
 309+ 7DC6 3A E1 99         LD A, (FramesElapsed)
 310+ 7DC9 B7               OR A
 311+ 7DCA 28 08            JR Z, .upmiPostLoop
 312+ 7DCC 47               LD B, A
 313+ 7DCD              .upmiLoop:
 314+ 7DCD C5               PUSH BC
 315+ 7DCE CD 45 7E         CALL .upmiTickOnce
 316+ 7DD1 C1               POP BC
 317+ 7DD2 10 F9            DJNZ .upmiLoop
 318+ 7DD4              .upmiPostLoop:
 319+ 7DD4                  ; --- Re-arm AY si musica activa ---
 320+ 7DD4                  ; Sin esto, la nota actual queda muda tras (a) cualquier write a R8/R9/R10
 321+ 7DD4                  ; que la mute, o (b) tras pasar por un rest. Re-escribimos vol + period de
 322+ 7DD4                  ; cada canal con period activo != 0. SFX en canal B (poly2 only) bloquean
 323+ 7DD4                  ; el re-arm de B; en poly3 no hay SFX activos (game-end), siempre re-armar.
 324+ 7DD4 3A A5 7B         LD A, (MusicTimer)
 325+ 7DD7 B7               OR A
 326+ 7DD8 C8               RET Z                           ; musica inactiva → no tocar AY
 327+ 7DD9                  ; --- Re-arm canal A: R0/R1 + R8 si MusicPeriodA != 0 ---
 328+ 7DD9 2A AA 7B         LD HL, (MusicPeriodA)
 329+ 7DDC 7C               LD A, H
 330+ 7DDD B5               OR L
 331+ 7DDE 28 18            JR Z, .upmiSkipA
 332+ 7DE0 E5               PUSH HL
 333+ 7DE1 3E 08            LD A, 8
 334+ 7DE3 1E 0C            LD E, 12
 335+ 7DE5 CD BB 7D         CALL AY_WriteRegSlot1           ; R8 = vol A medio-alto
 336+ 7DE8 E1               POP HL
 337+ 7DE9 5D               LD E, L
 338+ 7DEA 3E 00            LD A, 0
 339+ 7DEC CD BB 7D         CALL AY_WriteRegSlot1           ; R0 = period A lo
 340+ 7DEF 2A AA 7B         LD HL, (MusicPeriodA)
 341+ 7DF2 5C               LD E, H
 342+ 7DF3 3E 01            LD A, 1
 343+ 7DF5 CD BB 7D         CALL AY_WriteRegSlot1           ; R1 = period A hi
 344+ 7DF8              .upmiSkipA:
 345+ 7DF8                  ; --- Re-arm canal C: R4/R5 + R10 si MusicPeriodC != 0 ---
 346+ 7DF8 2A AE 7B         LD HL, (MusicPeriodC)
 347+ 7DFB 7C               LD A, H
 348+ 7DFC B5               OR L
 349+ 7DFD 28 18            JR Z, .upmiSkipC
 350+ 7DFF E5               PUSH HL
 351+ 7E00 3E 0A            LD A, 10
 352+ 7E02 1E 0C            LD E, 12
 353+ 7E04 CD BB 7D         CALL AY_WriteRegSlot1           ; R10 = vol C medio-alto
 354+ 7E07 E1               POP HL
 355+ 7E08 5D               LD E, L
 356+ 7E09 3E 04            LD A, 4
 357+ 7E0B CD BB 7D         CALL AY_WriteRegSlot1           ; R4 = period C lo
 358+ 7E0E 2A AE 7B         LD HL, (MusicPeriodC)
 359+ 7E11 5C               LD E, H
 360+ 7E12 3E 05            LD A, 5
 361+ 7E14 CD BB 7D         CALL AY_WriteRegSlot1           ; R5 = period C hi
 362+ 7E17              .upmiSkipC:
 363+ 7E17                  ; --- Re-arm canal B: solo en poly3 y solo si no hay SFX en curso ---
 364+ 7E17 3A A9 7B         LD A, (MusicMode)
 365+ 7E1A FE 03            CP 3
 366+ 7E1C C0               RET NZ                          ; poly2: B reservado a SFX, no tocar
 367+ 7E1D 3A 9C 6D         LD A, (BeepDurationFrames)
 368+ 7E20 B7               OR A
 369+ 7E21 C0               RET NZ
 370+ 7E22 3A 97 6D         LD A, (PlayerHitFrames)
 371+ 7E25 B7               OR A
 372+ 7E26 C0               RET NZ
 373+ 7E27 2A AC 7B         LD HL, (MusicPeriodB)
 374+ 7E2A 7C               LD A, H
 375+ 7E2B B5               OR L
 376+ 7E2C C8               RET Z
 377+ 7E2D E5               PUSH HL
 378+ 7E2E 3E 09            LD A, 9
 379+ 7E30 1E 0C            LD E, 12
 380+ 7E32 CD BB 7D         CALL AY_WriteRegSlot1           ; R9 = vol B medio-alto
 381+ 7E35 E1               POP HL
 382+ 7E36 5D               LD E, L
 383+ 7E37 3E 02            LD A, 2
 384+ 7E39 CD BB 7D         CALL AY_WriteRegSlot1           ; R2 = period B lo
 385+ 7E3C 2A AC 7B         LD HL, (MusicPeriodB)
 386+ 7E3F 5C               LD E, H
 387+ 7E40 3E 03            LD A, 3
 388+ 7E42 C3 BB 7D         JP AY_WriteRegSlot1             ; tail-call: R3 = period B hi
