2159+ F26D 28 18            JR Z, .fpeNotFound
2160+ F26F E5               PUSH HL
2161+ F270 23               INC HL
2161+ F271 23             INC HL                         ; -> ptr_lo
2162+ F272 7E               LD A, (HL)
2163+ F273 BB               CP E
2164+ F274 20 08            JR NZ, .fpeNoMatch
2165+ F276 23               INC HL
2166+ F277 7E               LD A, (HL)
2167+ F278 BA               CP D
2168+ F279 20 03            JR NZ, .fpeNoMatch
2169+ F27B E1               POP HL
2170+ F27C AF               XOR A                                   ; Z = encontrado
2171+ F27D C9               RET
2172+ F27E              .fpeNoMatch:
2173+ F27E E1               POP HL
