7447+ C89C              ; --- bfsTryNbr: probar vecino (B=nx, C=ny, A=step_dir). Si valido, encolar
7448+ C89C              ; y actualizar best. ---
7449+ C89C              .bfsTryNbr:
7450+ C89C 32 7A 5F         LD (DBfsTryDir), A
7451+ C89F 78               LD A, B
7452+ C8A0 32 78 5F         LD (DBfsTryCx), A
7453+ C8A3 79               LD A, C
7454+ C8A4 32 79 5F         LD (DBfsTryCy), A
