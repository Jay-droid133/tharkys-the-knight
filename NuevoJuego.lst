 138+ 84C0 32 CC 84         LD (.heightSave), A
 139+ 84C3 C8               RET Z                       ; Terminamos todas las lineas
 140+ 84C4 CD CF 84         CALL NextPixelLine          ; HL = siguiente linea
 141+ 84C7 18 D6            JR .shiftedLine
