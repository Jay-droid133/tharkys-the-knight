3384+ B519              ; --- Subrutina: comprobar pasabilidad + no solaparse con otros monsters ---
3385+ B519              ; D=deltaX, E=deltaY. Retorna Z=pasable, NZ=bloqueado. Preserva D,E.
3386+ B519              .moTryPassable:
3387+ B519 D5               PUSH DE
3388+ B51A                  ; Guardar posicion actual
3389+ B51A DD 7E 03         LD A, (IX+ENT_POSX)
3390+ B51D 32 57 B6         LD (.moSvX), A
3391+ B520 DD 7E 04         LD A, (IX+ENT_POSY)
3392+ B523 32 58 B6         LD (.moSvY), A
3393+ B526                  ; Posicion de test
3394+ B526 DD 7E 03         LD A, (IX+ENT_POSX)
