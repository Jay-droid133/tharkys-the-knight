 157  6A9F
 158  6A9F                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 159  6A9F                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 160  6A9F                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6A9F              ; ==============================================================================
   2+ 6A9F              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6A9F              ; ==============================================================================
   4+ 6A9F              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6A9F              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6A9F              ;
   7+ 6A9F              ; Diseño beeper-style:
   8+ 6A9F              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6A9F              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6A9F              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6A9F              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6A9F              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6A9F              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6A9F              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6A9F              ;     hits clasicos en 48K).
  16+ 6A9F              ;   - AY_UpdatePlayerHit se llama cada 2 IRQs (= 25 Hz) desde el handler IM 2
  17+ 6A9F              ;     en music_irq.asm (cold path: salta en RET Z si no hay sweep activo).
  18+ 6A9F              ;     Tickear desde IRQ inmuniza la duracion del beep frente a la latencia
  19+ 6A9F              ;     de MainLoop (transiciones lentas estiraban el beep antes).
  20+ 6A9F              ;
  21+ 6A9F              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  22+ 6A9F              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  23+ 6A9F              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  24+ 6A9F              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  25+ 6A9F              ;
  26+ 6A9F              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  27+ 6A9F              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  28+ 6A9F              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  29+ 6A9F              ;
  30+ 6A9F              ; Llamado desde:
  31+ 6A9F              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  32+ 6A9F              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  33+ 6A9F              ;   - MainLoop cada frame — update.
  34+ 6A9F              ; ==============================================================================
  35+ 6A9F
  36+ 6A9F              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  37+ 6A9F 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  38+ 6AA0 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  39+ 6AA2 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  40+ 6AA4 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  41+ 6AA5                                                ; (0 = inactivo o ya muteado)
  42+ 6AA5
  43+ 6AA5              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  44+ 6AA5              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  45+ 6AA5              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  46+ 6AA5              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  47+ 6AA5
  48+ 6AA5              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  49+ 6AA5              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  50+ 6AA5              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  51+ 6AA5              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  52+ 6AA5
  53+ 6AA5              ; ==============================================================================
  54+ 6AA5              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  55+ 6AA5              ; ==============================================================================
  56+ 6AA5              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  57+ 6AA5              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  58+ 6AA5              ; tabla los hardcodea.
  59+ 6AA5              ; ==============================================================================
  60+ 6AA5              AY_PlayPlayerHit:
  61+ 6AA5 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  62+ 6AA8 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  63+ 6AAA 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  64+ 6AAD 18 08            JR _AY_PlaySweep
  65+ 6AAF
  66+ 6AAF              AY_PlayPlayerDeath:
  67+ 6AAF 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  68+ 6AB2 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  69+ 6AB4 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  70+ 6AB7                  ; fall through
  71+ 6AB7
  72+ 6AB7              ; IN: HL=period inicial, B=frames, DE=delta.
  73+ 6AB7              _AY_PlaySweep:
  74+ 6AB7 22 A0 6A         LD (PlayerHitPeriod), HL
  75+ 6ABA ED 53 A2 6A      LD (PlayerHitDelta), DE
  76+ 6ABE 78               LD A, B
  77+ 6ABF 32 9F 6A         LD (PlayerHitFrames), A
  78+ 6AC2 F3               DI
  79+ 6AC3 0E FD            LD C, $FD
  80+ 6AC5 21 CB 6A         LD HL, .phRegs
  81+ 6AC8 C3 28 6B         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  82+ 6ACB
  83+ 6ACB              .phRegs:
  84+ 6ACB 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  85+ 6ACD 03 00            DEFB  3, $00          ; R3  = period B hi
  86+ 6ACF 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  87+ 6AD1                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
  88+ 6AD1                                        ; aqui para no cortar las voces A/C de la musica poly2)
  89+ 6AD1 FF               DEFB $FF              ; sentinel
  90+ 6AD2
  91+ 6AD2              ; ==============================================================================
  92+ 6AD2              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  93+ 6AD2              ; ==============================================================================
  94+ 6AD2              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  95+ 6AD2              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  96+ 6AD2              ; Canal B (center stereo ABC). No bloqueante.
  97+ 6AD2              ;
  98+ 6AD2              ; IN: HL = period AY canal B (mayor = mas grave).
  99+ 6AD2              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
 100+ 6AD2              ;
 101+ 6AD2              ; Sugerencias:
 102+ 6AD2              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 103+ 6AD2              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 104+ 6AD2              ; Destruye: A, BC, HL.
 105+ 6AD2              ; ==============================================================================
 106+ 6AD2              AY_PlayBeep:
 107+ 6AD2 78               LD A, B
 108+ 6AD3 32 A4 6A         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 109+ 6AD6 F3               DI
 110+ 6AD7 0E FD            LD C, $FD
 111+ 6AD9                  ; R2 = L (period B lo)
 112+ 6AD9 3E 02            LD A, 2
 113+ 6ADB 06 FF            LD B, $FF
 114+ 6ADD ED 79            OUT (C), A
 115+ 6ADF 7D               LD A, L
 116+ 6AE0 06 BF            LD B, $BF
 117+ 6AE2 ED 79            OUT (C), A
 118+ 6AE4                  ; R3 = H (period B hi)
 119+ 6AE4 3E 03            LD A, 3
 120+ 6AE6 06 FF            LD B, $FF
 121+ 6AE8 ED 79            OUT (C), A
 122+ 6AEA 7C               LD A, H
 123+ 6AEB 06 BF            LD B, $BF
 124+ 6AED ED 79            OUT (C), A
 125+ 6AEF                  ; R9 = $0F (vol max fija, SIN envelope). R7 mixer ya esta en $38 (set por
 126+ 6AEF                  ; AY_Init) — no tocar para no apagar las voces A/C de la musica poly2.
 127+ 6AEF 21 F5 6A         LD HL, .beepRegs
 128+ 6AF2 C3 28 6B         JP _AY_WriteRegPairs                ; tail call: EI + RET
 129+ 6AF5
 130+ 6AF5              .beepRegs:
 131+ 6AF5 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 132+ 6AF7                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
 133+ 6AF7                                        ; aqui para no cortar las voces A/C de la musica poly2)
 134+ 6AF7 FF               DEFB $FF              ; sentinel
 135+ 6AF8
 136+ 6AF8              ; ==============================================================================
 137+ 6AF8              ; AY_PlayKnockSoft / AY_PlayKnockLoud - Knock percusivo en canal B
 138+ 6AF8              ; ==============================================================================
 139+ 6AF8              ; Dos variantes de knock que comparten cutoff mechanism (BeepDurationFrames):
 140+ 6AF8              ;
 141+ 6AF8              ; Soft (grupos de 3 toques): noise B solo (tone B off), envelope $0200 (~1.2s
 142+ 6AF8              ;   decay). Knock seco, mas discreto. R7 = $2A.
 143+ 6AF8              ;
 144+ 6AF8              ; Loud (grupo de 6 toques): noise B + tone B mix (~217 Hz), envelope $0400
 145+ 6AF8              ;   (~2.4s decay). Knock con "body" del tone, vol perceptual ~3 dB mayor.
 146+ 6AF8              ;   R7 = $28.
 147+ 6AF8              ;
 148+ 6AF8              ; Ambos:
 149+ 6AF8              ;   - R6 = $05 (noise period, chasquido seco/agudo).
 150+ 6AF8              ;   - R9 = $10 (use envelope, bit 4 set).
 151+ 6AF8              ;   - R13 = $09 (decay shape, \___, retrigger en cada call). Va ULTIMO.
 152+ 6AF8              ;   - _uphMuteR9 restaura R7 = $38 al cutoff (cleanup tras knock).
 153+ 6AF8              ;
 154+ 6AF8              ; IN: B = duracion frames cutoff (recomendado 4 = ~160ms).
 155+ 6AF8              ; Destruye: A, BC, HL.
 156+ 6AF8              ; ==============================================================================
 157+ 6AF8              AY_PlayKnockSoft:
 158+ 6AF8 21 0A 6B         LD HL, _knockSoftRegs
 159+ 6AFB 18 03            JR _ay_play_knock_seq
 160+ 6AFD
 161+ 6AFD              AY_PlayKnockLoud:
 162+ 6AFD 21 17 6B         LD HL, _knockLoudRegs
 163+ 6B00                  ; fall through
 164+ 6B00
 165+ 6B00              _ay_play_knock_seq:
 166+ 6B00 78               LD A, B
 167+ 6B01 32 A4 6A         LD (BeepDurationFrames), A          ; arma cutoff via ticker
 168+ 6B04 F3               DI
 169+ 6B05 0E FD            LD C, $FD
 170+ 6B07 C3 28 6B         JP _AY_WriteRegPairs                ; tail-call: EI + RET
 171+ 6B0A
 172+ 6B0A              _knockSoftRegs:
 173+ 6B0A 06 05            DEFB  6, $05          ; R6 noise period
 174+ 6B0C 07 2A            DEFB  7, $2A          ; R7 mixer: noise B on, tone B off
 175+ 6B0E 0B 00            DEFB 11, $00          ; R11 envelope period lo
 176+ 6B10 0C 02            DEFB 12, $02          ; R12 envelope period hi ($0200 ~1.2s decay)
 177+ 6B12 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 178+ 6B14 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 179+ 6B16 FF               DEFB $FF
 180+ 6B17
 181+ 6B17              _knockLoudRegs:
 182+ 6B17 02 00            DEFB  2, $00          ; R2 tone B period lo
 183+ 6B19 03 02            DEFB  3, $02          ; R3 tone B period hi ($0200 ~217 Hz, body grave)
 184+ 6B1B 06 05            DEFB  6, $05          ; R6 noise period
 185+ 6B1D 07 28            DEFB  7, $28          ; R7 mixer: tone B + noise B both on
 186+ 6B1F 0B 00            DEFB 11, $00          ; R11 envelope period lo
 187+ 6B21 0C 04            DEFB 12, $04          ; R12 envelope period hi ($0400 ~2.4s decay)
 188+ 6B23 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 189+ 6B25 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 190+ 6B27 FF               DEFB $FF
 191+ 6B28
 192+ 6B28              ; ==============================================================================
 193+ 6B28              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 6B28              ; ==============================================================================
 195+ 6B28              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 6B28              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 6B28              ; ==============================================================================
 198+ 6B28              _AY_WriteRegPairs:
 199+ 6B28 7E               LD A, (HL)
 200+ 6B29 FE FF            CP $FF
 201+ 6B2B 28 0D            JR Z, .awrpDone
 202+ 6B2D 06 FF            LD B, $FF
 203+ 6B2F ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 6B31 23               INC HL
 205+ 6B32 06 BF            LD B, $BF
 206+ 6B34 7E               LD A, (HL)
 207+ 6B35 ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 6B37 23               INC HL
 209+ 6B38 18 EE            JR _AY_WriteRegPairs
 210+ 6B3A              .awrpDone:
 211+ 6B3A FB               EI
 212+ 6B3B C9               RET
 213+ 6B3C
 214+ 6B3C              ; ==============================================================================
 215+ 6B3C              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 6B3C              ; ==============================================================================
 217+ 6B3C              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 6B3C              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 6B3C              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 6B3C              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 6B3C              ; (con IFF=0), no hay race.
 222+ 6B3C              ;
 223+ 6B3C              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 6B3C              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 6B3C              ; Destruye: A, BC, DE, HL.
 226+ 6B3C              ; ==============================================================================
 227+ 6B3C              AY_UpdatePlayerHit:
 228+ 6B3C                  ; --- PendingPin tick: dispara beep diferido (lasting compass stage 2) ---
 229+ 6B3C                  ; Cuando AY_PlayLastingPickup arma una "PIN" tras el sweep, el ticker la
 230+ 6B3C                  ; dispara cuando el contador llega a 0. Escritura R2/R3/R9 inline (sin
 231+ 6B3C                  ; DI/EI: ya en contexto IRQ). Tras setear BeepDurationFrames el cutoff
 232+ 6B3C                  ; lo gestiona el path .uphCheckBeep en proximos ticks.
 233+ 6B3C 3A CC 6B         LD A, (PendingPinTimer)
 234+ 6B3F B7               OR A
 235+ 6B40 28 34            JR Z, .uphAfterPin
 236+ 6B42 3D               DEC A
 237+ 6B43 32 CC 6B         LD (PendingPinTimer), A
 238+ 6B46 20 2E            JR NZ, .uphAfterPin
 239+ 6B48 2A CD 6B         LD HL, (PendingPinPeriod)
 240+ 6B4B 0E FD            LD C, $FD
 241+ 6B4D 3E 02            LD A, 2
 242+ 6B4F 06 FF            LD B, $FF
 243+ 6B51 ED 79            OUT (C), A
 244+ 6B53 7D               LD A, L
 245+ 6B54 06 BF            LD B, $BF
 246+ 6B56 ED 79            OUT (C), A
 247+ 6B58 3E 03            LD A, 3
 248+ 6B5A 06 FF            LD B, $FF
 249+ 6B5C ED 79            OUT (C), A
 250+ 6B5E 7C               LD A, H
 251+ 6B5F 06 BF            LD B, $BF
 252+ 6B61 ED 79            OUT (C), A
 253+ 6B63 3E 09            LD A, 9
 254+ 6B65 06 FF            LD B, $FF
 255+ 6B67 ED 79            OUT (C), A
 256+ 6B69 3E 0F            LD A, $0F                           ; vol max canal B
 257+ 6B6B 06 BF            LD B, $BF
 258+ 6B6D ED 79            OUT (C), A
 259+ 6B6F 3A CF 6B         LD A, (PendingPinFrames)
 260+ 6B72 32 A4 6A         LD (BeepDurationFrames), A          ; arma cutoff
 261+ 6B75 C9               RET                                 ; skip resto del ticker este frame
 262+ 6B76              .uphAfterPin:
 263+ 6B76 3A 9F 6A         LD A, (PlayerHitFrames)
 264+ 6B79 B7               OR A
 265+ 6B7A 28 2A            JR Z, .uphCheckBeep
 266+ 6B7C 3D               DEC A
 267+ 6B7D 32 9F 6A         LD (PlayerHitFrames), A
 268+ 6B80 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 269+ 6B82
 270+ 6B82 2A A0 6A         LD HL, (PlayerHitPeriod)
 271+ 6B85 ED 5B A2 6A      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 272+ 6B89 19               ADD HL, DE
 273+ 6B8A 22 A0 6A         LD (PlayerHitPeriod), HL
 274+ 6B8D
 275+ 6B8D                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 276+ 6B8D 0E FD            LD C, $FD
 277+ 6B8F 3E 02            LD A, 2
 278+ 6B91 06 FF            LD B, $FF
 279+ 6B93 ED 79            OUT (C), A
 280+ 6B95 7D               LD A, L
 281+ 6B96 06 BF            LD B, $BF
 282+ 6B98 ED 79            OUT (C), A
 283+ 6B9A 3E 03            LD A, 3
 284+ 6B9C 06 FF            LD B, $FF
 285+ 6B9E ED 79            OUT (C), A
 286+ 6BA0 7C               LD A, H
 287+ 6BA1 06 BF            LD B, $BF
 288+ 6BA3 ED 79            OUT (C), A
 289+ 6BA5 C9               RET
 290+ 6BA6
 291+ 6BA6              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 292+ 6BA6              .uphCheckBeep:
 293+ 6BA6 3A A4 6A         LD A, (BeepDurationFrames)
 294+ 6BA9 B7               OR A
 295+ 6BAA C8               RET Z
 296+ 6BAB 3D               DEC A
 297+ 6BAC 32 A4 6A         LD (BeepDurationFrames), A
 298+ 6BAF C0               RET NZ
 299+ 6BB0                  ; fall-through al cutoff compartido
 300+ 6BB0
 301+ 6BB0              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 302+ 6BB0              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 303+ 6BB0              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 304+ 6BB0              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 305+ 6BB0              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 306+ 6BB0              _uphMuteR9:
 307+ 6BB0 01 FD FF         LD BC, $FFFD
 308+ 6BB3 3E 09            LD A, 9
 309+ 6BB5 ED 79            OUT (C), A
 310+ 6BB7 01 FD BF         LD BC, $BFFD
 311+ 6BBA AF               XOR A
 312+ 6BBB ED 79            OUT (C), A
 313+ 6BBD                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 314+ 6BBD 01 FD FF         LD BC, $FFFD
 315+ 6BC0 3E 07            LD A, 7
 316+ 6BC2 ED 79            OUT (C), A
 317+ 6BC4 01 FD BF         LD BC, $BFFD
 318+ 6BC7 3E 38            LD A, $38
 319+ 6BC9 ED 79            OUT (C), A
 320+ 6BCB C9               RET
 321+ 6BCC
 322+ 6BCC              ; AchievementJingle ELIMINADO: el chime de "llegar a la sala del hito" ahora
 323+ 6BCC              ; reusa AY_PlayCompassPickup (mismo sweep que el pickup del magic compass
 324+ 6BCC              ; random). Libera ~80 B en slot 1 y unifica el feedback "evento positivo de
 325+ 6BCC              ; navegacion" con un unico sonido.
 326+ 6BCC
 327+ 6BCC              ; ==============================================================================
 328+ 6BCC              ; CompassPickup SFX (random + lasting) - sweeps tipo PlayerHit/Death
 329+ 6BCC              ; ==============================================================================
 330+ 6BCC              ; Reusan _AY_PlaySweep (sweep continuo de pitch en canal B AY, no bloqueante,
 331+ 6BCC              ; cutoff abrupto al final via _uphMuteR9). Llamados desde ApplyMagicCompassBuff
 332+ 6BCC              ; segun MagicCompassPermanent: random -> AY_PlayCompassPickup (solo sweep),
 333+ 6BCC              ; lasting -> AY_PlayLastingPickup (sweep + PIN sostenido tipo "WHHIII-PIN").
 334+ 6BCC              ;
 335+ 6BCC              ; Direccion del sweep: GRAVE -> AGUDO ("found it!" feel). Period inicial alto,
 336+ 6BCC              ; delta NEGATIVO en two's complement ($FFE8 = -24 etc). _AY_PlaySweep usa
 337+ 6BCC              ; ADD HL, DE asi que el wrap unsigned funciona como resta.
 338+ 6BCC              ; ==============================================================================
 339+ 6BCC
 340+ 6BCC              ; Random compass: sweep ascendente ~640 ms (16 frames)
 341+ 6BCC              ;   $0200 (210 Hz, B3) -> $0080 (853 Hz, A5) — 2 octavas
 342+ 6BCC              COMPASS_SWEEP_PERIOD_INIT  EQU $0200
 343+ 6BCC              COMPASS_SWEEP_FRAMES       EQU 16
 344+ 6BCC              COMPASS_SWEEP_DELTA        EQU $FFE8         ; -24/frame
 345+ 6BCC
 346+ 6BCC              ; Lasting compass: sweep ascendente ~880 ms (22 frames) + PIN sostenido
 347+ 6BCC              ;   Sweep: $0300 (140 Hz, D3) -> $0040 (1700 Hz, ~A6) — 3+ octavas
 348+ 6BCC              ;   PIN: $0030 (~2270 Hz) por 6 frames (240 ms), 1 frame despues del sweep
 349+ 6BCC              LASTING_SWEEP_PERIOD_INIT  EQU $0300
 350+ 6BCC              LASTING_SWEEP_FRAMES       EQU 22
 351+ 6BCC              LASTING_SWEEP_DELTA        EQU $FFE0         ; -32/frame
 352+ 6BCC              LASTING_PIN_PERIOD         EQU $0030         ; ~2270 Hz, muy brillante
 353+ 6BCC              LASTING_PIN_FRAMES         EQU 6             ; 240 ms
 354+ 6BCC              LASTING_PIN_DELAY          EQU LASTING_SWEEP_FRAMES + 1   ; fire 1 frame tras cutoff
 355+ 6BCC
 356+ 6BCC              ; State del PIN diferido (tickeado por AY_UpdatePlayerHit)
 357+ 6BCC 00           PendingPinTimer:    DEFB 0       ; >0 = pendiente; 0 = nada
 358+ 6BCD 00 00        PendingPinPeriod:   DEFW 0       ; period AY canal B
 359+ 6BCF 00           PendingPinFrames:   DEFB 0       ; duracion del beep tras dispararse
 360+ 6BD0
 361+ 6BD0              ; AY_PlayCompassPickup - magic compass random
 362+ 6BD0              AY_PlayCompassPickup:
 363+ 6BD0 21 00 02         LD HL, COMPASS_SWEEP_PERIOD_INIT
 364+ 6BD3 06 10            LD B, COMPASS_SWEEP_FRAMES
 365+ 6BD5 11 E8 FF         LD DE, COMPASS_SWEEP_DELTA
 366+ 6BD8 C3 B7 6A         JP _AY_PlaySweep                  ; tail call
 367+ 6BDB
 368+ 6BDB              ; AY_PlayLastingPickup - lasting compass: sweep + PIN encadenado
 369+ 6BDB              AY_PlayLastingPickup:
 370+ 6BDB 21 00 03         LD HL, LASTING_SWEEP_PERIOD_INIT
 371+ 6BDE 06 16            LD B, LASTING_SWEEP_FRAMES
 372+ 6BE0 11 E0 FF         LD DE, LASTING_SWEEP_DELTA
 373+ 6BE3 CD B7 6A         CALL _AY_PlaySweep
 374+ 6BE6                  ; Encolar PIN (beep agudo final) para que dispare 1 frame tras el sweep
 375+ 6BE6 21 30 00         LD HL, LASTING_PIN_PERIOD
 376+ 6BE9 22 CD 6B         LD (PendingPinPeriod), HL
 377+ 6BEC 3E 06            LD A, LASTING_PIN_FRAMES
 378+ 6BEE 32 CF 6B         LD (PendingPinFrames), A
 379+ 6BF1 3E 17            LD A, LASTING_PIN_DELAY
 380+ 6BF3 32 CC 6B         LD (PendingPinTimer), A
 381+ 6BF6 C9               RET
 382+ 6BF7
# file closed: sfx_player_hit_ay.asm
 161  6BF7
 162  6BF7                  ; --- Random pickups: thunks slot 1 (random_pickups.asm body en bank 7) ---
 163  6BF7                  ; Movido a bank 7 para liberar slot 1 (~1.1 KB neto). Aqui solo viven los
 164  6BF7                  ; 9 entry thunks que paginan bank 7 + SP swap a alt_stack compartido con
 165  6BF7                  ; bank_cutscene, mas 3 _B7 wrappers nuevos (SkipPixelData/RestorePickupAttrs/
 166  6BF7                  ; ApplyMagicCompassBuff). Body en INCLUDE en PAGE 7 mas abajo.
 167  6BF7                  INCLUDE "random_pickups_thunks.asm"
# file opened: random_pickups_thunks.asm
   1+ 6BF7              ; ==============================================================================
   2+ 6BF7              ; random_pickups_thunks.asm - Wrappers slot 1 para random_pickups.asm en bank 7
   3+ 6BF7              ; ==============================================================================
   4+ 6BF7              ; random_pickups.asm vivia en slot 1 ($6BF7..$70E4, ~1.26 KB). Movido a bank 7
   5+ 6BF7              ; para liberar slot 1 (donde RoomCompGapsTable y la IM2 table compiten por el
   6+ 6BF7              ; espacio anterior a $7A00). El movimiento libera ~1.1 KB neto en slot 1.
   7+ 6BF7              ;
   8+ 6BF7              ; Body bank 7 expone 9 entry points externos. Aqui se exponen como thunks que
   9+ 6BF7              ; comparten un shell de SP swap + page switch para minimizar bytes en slot 1.
  10+ 6BF7              ;
  11+ 6BF7              ; Reutiliza de bank_cutscene_thunks.asm (slot 1, ya incluido en main.asm):
  12+ 6BF7              ;   - _PageBank0 / _PageBank7
  13+ 6BF7              ;   - BankCutsceneAltStackTop
  14+ 6BF7              ;   - LoadBgSpriteToBuffer_B7
  15+ 6BF7              ;   - DrawBgSpriteXOR_B7
  16+ 6BF7              ;   - PlaySFX_B7
  17+ 6BF7              ;
  18+ 6BF7              ; Nuevos _B7 wrappers (slot 1, para usar desde body en bank 7):
  19+ 6BF7              ;   - SkipPixelData_B7        (bank 0)
  20+ 6BF7              ;   - RestorePickupAttrs_B7   (bank 0)
  21+ 6BF7              ;   - ApplyMagicCompassBuff_B7 (slot 1, wrap por seguridad — llama helpers bank 0)
  22+ 6BF7              ;
  23+ 6BF7              ; CRITICO: stack normal en slot 3 (bank 0 paginable). Los thunks hacen SP swap
  24+ 6BF7              ; a BankCutsceneAltStackTop antes del page switch. Compartido secuencialmente
  25+ 6BF7              ; con bank_cutscene/town_gate thunks dentro del mismo frame — no conflicto
  26+ 6BF7              ; porque son single-threaded (Z80 + IRQ handler en slot 1 que no toca slot 3).
  27+ 6BF7              ; ==============================================================================
  28+ 6BF7
  29+ 6BF7              ; ==============================================================================
  30+ 6BF7              ; _RP_Thunk - shell compartido por los 9 entry thunks
  31+ 6BF7              ; ==============================================================================
  32+ 6BF7              ; IN:  HL = body address (en bank 7)
  33+ 6BF7              ; OUT: lo que devuelva el body. Regs intermedios usados por body, no preservados.
  34+ 6BF7              ; Destruye: AF, HL (la propia entrada).
  35+ 6BF7              ;
  36+ 6BF7              ; Flujo:
  37+ 6BF7              ;   1. Save SP normal en _RP_savedSP.
  38+ 6BF7              ;   2. Swap SP a alt_stack (slot 1 always-visible).
  39+ 6BF7              ;   3. Page bank 7 en slot 3.
  40+ 6BF7              ;   4. JP (HL) -> body (via CALL .callHL + JP (HL): el RET del body cae aqui).
  41+ 6BF7              ;   5. Page bank 0 en slot 3.
  42+ 6BF7              ;   6. Restore SP normal.
  43+ 6BF7              ;   7. RET al caller original (MainLoop).
  44+ 6BF7              ; ==============================================================================
  45+ 6BF7              _RP_Thunk:
  46+ 6BF7 ED 73 0D 6C      LD (_RP_savedSP), SP
  47+ 6BFB 31 00 80         LD SP, BankCutsceneAltStackTop
  48+ 6BFE CD AC 6C         CALL _PageBank7
  49+ 6C01 CD 0C 6C         CALL .callHL
  50+ 6C04 CD 9A 6C         CALL _PageBank0
  51+ 6C07 ED 7B 0D 6C      LD SP, (_RP_savedSP)
  52+ 6C0B C9               RET
  53+ 6C0C              .callHL:
  54+ 6C0C E9               JP (HL)
  55+ 6C0D 00 00        _RP_savedSP: DEFW 0
  56+ 6C0F
  57+ 6C0F              ; ==============================================================================
  58+ 6C0F              ; Entry thunks - cada uno carga HL=body y salta al shell shared
  59+ 6C0F              ; ==============================================================================
  60+ 6C0F              ; 5 bytes cada uno (LD HL = 3 B + JR = 2 B). JR backward al shell. Como el
  61+ 6C0F              ; shell mide ~18 B + las entries son ~45 B, todos los offsets caben en signed 8.
  62+ 6C0F              ;
  63+ 6C0F              ; Callers externos (registros sin args):
  64+ 6C0F              ;   UpdateRandomPickup, UpdateRoulette, PaintSynthPickupAttrs, UpdateSpeedBuff,
  65+ 6C0F              ;   UpdateMushroomBuff: MainLoop cada frame (early-out fast).
  66+ 6C0F              ;   CheckRandomSyntheticPickup: screen_system / pickup collect.
  67+ 6C0F              ;   GiveLife / GiveHealth / GiveStamina: screen_system (well pickup) +
  68+ 6C0F              ;       internamente desde CheckRandomSyntheticPickup body (intra-bank, no thunk).
  69+ 6C0F              ; ==============================================================================
  70+ 6C0F              UpdateRandomPickup:
  71+ 6C0F 21 B2 EC         LD HL, UpdateRandomPickupBody
  72+ 6C12 18 E3            JR _RP_Thunk
  73+ 6C14              UpdateRoulette:
  74+ 6C14 21 25 EB         LD HL, UpdateRouletteBody
  75+ 6C17 18 DE            JR _RP_Thunk
  76+ 6C19              PaintSynthPickupAttrs:
  77+ 6C19 21 C0 EE         LD HL, PaintSynthPickupAttrsBody
  78+ 6C1C 18 D9            JR _RP_Thunk
  79+ 6C1E              UpdateSpeedBuff:
  80+ 6C1E 21 94 EC         LD HL, UpdateSpeedBuffBody
  81+ 6C21 18 D4            JR _RP_Thunk
  82+ 6C23              UpdateMushroomBuff:
  83+ 6C23 21 40 EC         LD HL, UpdateMushroomBuffBody
  84+ 6C26 18 CF            JR _RP_Thunk
  85+ 6C28              CheckRandomSyntheticPickup:
  86+ 6C28 21 F9 EE         LD HL, CheckRandomSyntheticPickupBody
  87+ 6C2B 18 CA            JR _RP_Thunk
  88+ 6C2D              GiveLife:
  89+ 6C2D 21 6F EA         LD HL, GiveLifeBody
  90+ 6C30 18 C5            JR _RP_Thunk
  91+ 6C32              GiveHealth:
  92+ 6C32 21 7A EA         LD HL, GiveHealthBody
  93+ 6C35 18 C0            JR _RP_Thunk
  94+ 6C37              GiveStamina:
  95+ 6C37 21 8B EA         LD HL, GiveStaminaBody
  96+ 6C3A 18 BB            JR _RP_Thunk
  97+ 6C3C              UpdatePlayerColorCycler:
  98+ 6C3C                  ; CRITICO: PlayerHitTimer vive en bank 0 (slot 3). Hay que leerlo AQUI
  99+ 6C3C                  ; (con slot 3 = bank 0 default) antes de paginar bank 7 en el shell. Si
 100+ 6C3C                  ; lo lee el body, leeria de bank 7 (basura) y abortaria casi siempre.
 101+ 6C3C 3A 1E C5         LD A, (PlayerHitTimer)
 102+ 6C3F B7               OR A
 103+ 6C40 C0               RET NZ                              ; damage flash priority -> no cyclar
 104+ 6C41 21 72 EB         LD HL, UpdatePlayerColorCyclerBody
 105+ 6C44 18 B1            JR _RP_Thunk
 106+ 6C46              UpdateEspadaBuff:
 107+ 6C46 21 58 EC         LD HL, UpdateEspadaBuffBody
 108+ 6C49 18 AC            JR _RP_Thunk
 109+ 6C4B              UpdateEscudoBuff:
 110+ 6C4B 21 6A EC         LD HL, UpdateEscudoBuffBody
 111+ 6C4E 18 A7            JR _RP_Thunk
 112+ 6C50
 113+ 6C50              ; ==============================================================================
 114+ 6C50              ; _B7 wrappers - llamados desde body en bank 7. Paginan bank 0, ejecutan el
 115+ 6C50              ; callee, paginan bank 7 al volver. Estos viven en slot 1 (always-visible).
 116+ 6C50              ; ==============================================================================
 117+ 6C50              ; SkipPixelData / RestorePickupAttrs: bank 0 (slot 3 default), helpers de
 118+ 6C50              ; pickup rendering usados por LoadSynthSpriteAndExtractAttr / CheckRandomSyntheticPickup.
 119+ 6C50              ;
 120+ 6C50              ; ApplyMagicCompassBuff: slot 1 (magic_compass.asm) pero llama helpers bank 0
 121+ 6C50              ; internamente -> wrap completo. Solo se usa via JP tail-call desde dispatch
 122+ 6C50              ; del pickup compass directo (no via ruleta).
 123+ 6C50              ; ==============================================================================
 124+ 6C50              SkipPixelData_B7:
 125+ 6C50 CD 9A 6C         CALL _PageBank0
 126+ 6C53 CD E4 D3         CALL SkipPixelData
 127+ 6C56 C3 AC 6C         JP _PageBank7
 128+ 6C59              RestorePickupAttrs_B7:
 129+ 6C59 CD 9A 6C         CALL _PageBank0
 130+ 6C5C CD 9D DC         CALL RestorePickupAttrs
 131+ 6C5F C3 AC 6C         JP _PageBank7
 132+ 6C62              ApplyMagicCompassBuff_B7:
 133+ 6C62 CD 9A 6C         CALL _PageBank0
 134+ 6C65 CD C8 6D         CALL ApplyMagicCompassBuff
 135+ 6C68 C3 AC 6C         JP _PageBank7
 136+ 6C6B
# file closed: random_pickups_thunks.asm
 168  6C6B
 169  6C6B                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 170  6C6B                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 171  6C6B                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 172  6C6B                  ;
 173  6C6B                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 174  6C6B                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 175  6C6B                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 176  6C6B                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 177  6C6B                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 178  6C6B                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 179  6C6B                  ; mantiene por estabilidad.
 180  6C6B                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 6C6B              ; ==============================================================================
   2+ 6C6B              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 6C6B              ; ==============================================================================
   4+ 6C6B              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 6C6B              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 6C6B              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 6C6B              ;
   8+ 6C6B              ; Estrategia:
   9+ 6C6B              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 6C6B              ;      bank 0 paginado en slot 3.
  11+ 6C6B              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 6C6B              ;      seguro hacer la conmutación aquí).
  13+ 6C6B              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 6C6B              ;   4. Body retorna → restauramos bank 0.
  15+ 6C6B              ;
  16+ 6C6B              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 6C6B              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 6C6B              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 6C6B              ; ==============================================================================
  20+ 6C6B
  21+ 6C6B              DrawTombstone2xCentered:
  22+ 6C6B                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 6C6B 21 6C D9         LD HL, BgGfx_little_house_cemetery
  24+ 6C6E 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 6C70 CD CA 67         CALL LoadBgSpriteToBuffer
  26+ 6C73
  27+ 6C73                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 6C73 F3               DI
  29+ 6C74 3A 84 8D         LD A, (CurrentPaging)
  30+ 6C77 E6 F8            AND $F8
  31+ 6C79 F6 07            OR 7
  32+ 6C7B 32 84 8D         LD (CurrentPaging), A
  33+ 6C7E 01 FD 7F         LD BC, $7FFD
  34+ 6C81 ED 79            OUT (C), A
  35+ 6C83
  36+ 6C83                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 6C83 CD 7B DB         CALL DrawTombstone2xBody
  38+ 6C86
  39+ 6C86                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 6C86 3A 84 8D         LD A, (CurrentPaging)
  41+ 6C89 E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 6C8B 32 84 8D         LD (CurrentPaging), A
  43+ 6C8E 01 FD 7F         LD BC, $7FFD
  44+ 6C91 ED 79            OUT (C), A
  45+ 6C93
  46+ 6C93                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 6C93 3A 9C 81         LD A, (StartupComplete)
  48+ 6C96 B7               OR A
  49+ 6C97 C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 6C98 FB               EI
  51+ 6C99 C9               RET
  52+ 6C9A
# file closed: game_over_tomb_thunk.asm
 181  6C9A
 182  6C9A                  ; --- Bank cutscene: thunks slot 1 + body en bank 7 (M9) ---
 183  6C9A                  ; OBSERVACION CRITICA: estos thunks tienen que ir ANTES de magic_compass.asm
 184  6C9A                  ; (NO despues de music_irq) porque slot 1 esta apretado y meterlos al final
 185  6C9A                  ; deborda el slot a $8000+ (slot 2 = bank 2) -> crash al BASIC.
 186  6C9A                  ;
 187  6C9A                  ; Aqui empujan magic_compass.asm ~140 B hacia $7A00, pero gracias a la
 188  6C9A                  ; fusion de DrawBankDoorSprite_B7 dentro de DrawBgGfxSprite_B7 (ahorra 18 B)
 189  6C9A                  ; y al stripping de los thunks al minimo, magic_compass termina en ~$79F0,
 190  6C9A                  ; antes de la tabla IM2 ($7A00) -> BFS no cruza la zona reservada.
 191  6C9A                  INCLUDE "bank_cutscene_thunks.asm"
# file opened: bank_cutscene_thunks.asm
   1+ 6C9A              ; ==============================================================================
   2+ 6C9A              ; bank_cutscene_thunks.asm - Wrappers slot 1 para bank_cutscene en bank 7
   3+ 6C9A              ; ==============================================================================
   4+ 6C9A              ; bank_cutscene.asm vive en bank 7 (movido desde bank 0 para descongestionar el
   5+ 6C9A              ; main code). Este archivo expone los 2 entry points externos como thunks que
   6+ 6C9A              ; paginan bank 7 antes del body y restauran bank 0 al volver. Tambien proporciona
   7+ 6C9A              ; helpers _PageBank0 / _PageBank7 que el body bank 7 usa para envolver cada
   8+ 6C9A              ; CALL a una funcion en bank 0 (o en slot 1 que internamente llame a bank 0).
   9+ 6C9A              ;
  10+ 6C9A              ; Funciones externas que requieren el wrap pre+post (paginar bank 0 antes,
  11+ 6C9A              ; restaurar bank 7 despues):
  12+ 6C9A              ;   - DrawBgSpriteXOR, DrawBgGfxSprite, RedrawPickupByPtr, PlaySFX,
  13+ 6C9A              ;     CheckMilestoneTrigger    (todas en bank 0)
  14+ 6C9A              ;   - TownGateRedrawPlayer     (slot 1, pero llama internamente a RestoreOldAttr
  15+ 6C9A              ;                              que vive en bank 0)
  16+ 6C9A              ;
  17+ 6C9A              ; Funciones que requieren solo post-wrap (ya paginan bank 0 al final ellas mismas):
  18+ 6C9A              ;   - LoadBgSpriteToBuffer     (slot 1, deja bank 0 paginado al RET -> repaginar
  19+ 6C9A              ;                              bank 7 manualmente)
  20+ 6C9A              ;
  21+ 6C9A              ; Funciones que NO necesitan wrap (verificado por call graph):
  22+ 6C9A              ;   - KillAllActiveNasties, SnapPuffPos, CheckEnemyCollision  (bank 2 slot 2)
  23+ 6C9A              ;   - KillDeathIfActive -> StartMusic                          (bank 2 slot 2)
  24+ 6C9A              ;   - TownGateAllNastiesDeadCheck                              (slot 1, no calls)
  25+ 6C9A              ;   - AY_PlayKnockSoft/Loud/Beep                               (slot 1, no calls externos)
  26+ 6C9A              ;   - DrawBgSprite16XorAtPixel -> CalcPixelAddr/NextPixelLine  (bank 2 slot 2)
  27+ 6C9A              ;
  28+ 6C9A              ; Vive en slot 1 (always-visible). Patron similar a game_over_tomb_thunk.asm.
  29+ 6C9A              ;
  30+ 6C9A              ; CRITICO: el stack normal del juego vive en $FF58 (slot 3, bank 0 paginable).
  31+ 6C9A              ; Si los thunks paginan bank 7 en slot 3 sin tocar SP, el stack normal desaparece
  32+ 6C9A              ; bajo nuestros pies -> CALL/RET dentro del body bank 7 leen basura -> crash.
  33+ 6C9A              ; Solucion: los entry thunks (CheckBankTriggerBg, UpdateBankCutscene) hacen SP
  34+ 6C9A              ; swap a BankCutsceneAltStack (RAM always-visible en slot 1, zona $5BE0..$5C00
  35+ 6C9A              ; del printer buffer) durante toda la cutscene. Los _B7 thunks de funciones
  36+ 6C9A              ; externas heredan ese SP (no necesitan su propio swap).
  37+ 6C9A              ;
  38+ 6C9A              ; Sin DI en los page switches: MusicIrqHandler vive en slot 1, por convencion
  39+ 6C9A              ; project_irq_slot3_atomic no toca slot 3 -> IRQs corren normales durante los
  40+ 6C9A              ; page switches igual que en LoadBgSpriteToBuffer.
  41+ 6C9A              ; ==============================================================================
  42+ 6C9A
  43+ 6C9A              ; Alt stack: 64 B al final de slot 1 ($7FC0..$7FFF, hueco libre tras music_irq).
  44+ 6C9A              ; Vive en bank 5 always-visible, no toca otras zonas de RAM. Pico medido:
  45+ 6C9A              ; TownGateRedrawPlayer -> DrawSprite -> _DrawSpriteImpl + IRQ handler
  46+ 6C9A              ; concurrente puede superar 32 B; 64 B (32 niveles) da margen amplio.
  47+ 6C9A              BankCutsceneAltStackBase EQU $7FC0
  48+ 6C9A              BankCutsceneAltStackTop  EQU $8000       ; SP top: first PUSH escribe a $7FFE-$7FFF
  49+ 6C9A
  50+ 6C9A              ; ==============================================================================
  51+ 6C9A              ; _PageBank0 - Pagina bank 0 en slot 3. Preserva AF + BC + resto del caller.
  52+ 6C9A              ; ==============================================================================
  53+ 6C9A              ; Llamado por:
  54+ 6C9A              ;   - Entry thunks al final (devolver al gameplay normal).
  55+ 6C9A              ;   - Body bank 7 antes de cada CALL externo que toca bank 0.
  56+ 6C9A              ; Destruye: ningun reg (todo restaurado via PUSH/POP).
  57+ 6C9A              ; ==============================================================================
  58+ 6C9A              _PageBank0:
  59+ 6C9A F5               PUSH AF
  60+ 6C9B C5               PUSH BC
  61+ 6C9C 3A 84 8D         LD A, (CurrentPaging)
  62+ 6C9F E6 F8            AND $F8                              ; bank 0 = bits 0-2 a cero
  63+ 6CA1 32 84 8D         LD (CurrentPaging), A
  64+ 6CA4 01 FD 7F         LD BC, $7FFD
  65+ 6CA7 ED 79            OUT (C), A
  66+ 6CA9 C1               POP BC
  67+ 6CAA F1               POP AF
  68+ 6CAB C9               RET
  69+ 6CAC
  70+ 6CAC              ; ==============================================================================
  71+ 6CAC              ; _PageBank7 - Pagina bank 7 en slot 3. Preserva AF + BC + resto del caller.
  72+ 6CAC              ; ==============================================================================
  73+ 6CAC              ; Llamado por:
  74+ 6CAC              ;   - Entry thunks al principio (para que el body bank 7 sea visible).
  75+ 6CAC              ;   - Body bank 7 despues de cada CALL externo (para retomar el flujo).
  76+ 6CAC              ; Destruye: ningun reg.
  77+ 6CAC              ; ==============================================================================
  78+ 6CAC              _PageBank7:
  79+ 6CAC F5               PUSH AF
  80+ 6CAD C5               PUSH BC
  81+ 6CAE 3A 84 8D         LD A, (CurrentPaging)
  82+ 6CB1 E6 F8            AND $F8
  83+ 6CB3 F6 07            OR 7
  84+ 6CB5 32 84 8D         LD (CurrentPaging), A
  85+ 6CB8 01 FD 7F         LD BC, $7FFD
  86+ 6CBB ED 79            OUT (C), A
  87+ 6CBD C1               POP BC
  88+ 6CBE F1               POP AF
  89+ 6CBF C9               RET
  90+ 6CC0
  91+ 6CC0              ; ==============================================================================
  92+ 6CC0              ; CheckBankTriggerBg - Thunk de entry. Swap SP a alt_stack, pagina bank 7,
  93+ 6CC0              ; ejecuta body, restaura bank 0 + SP normal.
  94+ 6CC0              ; ==============================================================================
  95+ 6CC0              ; Llamado desde MainLoop cada frame. Body verifica si el player toca la
  96+ 6CC0              ; puerta del banco con el cheque y dispara la cutscene + avance de hito M9.
  97+ 6CC0              ;
  98+ 6CC0              ; CRITICO: stack normal vive en bank 0 (slot 3) -> desaparece al paginar bank 7.
  99+ 6CC0              ; Por eso swap SP a alt_stack ANTES del page switch.
 100+ 6CC0              ; ==============================================================================
 101+ 6CC0              CheckBankTriggerBg:
 102+ 6CC0 ED 73 D5 6C      LD (.savedSPCheck), SP                   ; save SP normal (en bank 0)
 103+ 6CC4 31 00 80         LD SP, BankCutsceneAltStackTop           ; SP -> alt_stack (slot 1 always-vis)
 104+ 6CC7 CD AC 6C         CALL _PageBank7
 105+ 6CCA CD A3 DD         CALL CheckBankTriggerBgBody
 106+ 6CCD CD 9A 6C         CALL _PageBank0                          ; bank 0 paginado -> SP normal accesible al restaurar
 107+ 6CD0 ED 7B D5 6C      LD SP, (.savedSPCheck)                   ; restore SP normal
 108+ 6CD4 C9               RET                                      ; vuelve al CALL del MainLoop
 109+ 6CD5 00 00        .savedSPCheck: DEFW 0
 110+ 6CD7
 111+ 6CD7              ; ==============================================================================
 112+ 6CD7              ; UpdateBankCutscene - Thunk de entry para el tick por frame de la cutscene.
 113+ 6CD7              ; ==============================================================================
 114+ 6CD7              ; Mismo patron SP swap que CheckBankTriggerBg. Llamado desde MainLoop cada
 115+ 6CD7              ; frame si BankCutscenePhase != 0.
 116+ 6CD7              ; ==============================================================================
 117+ 6CD7              UpdateBankCutscene:
 118+ 6CD7 ED 73 EC 6C      LD (.savedSPUpdate), SP
 119+ 6CDB 31 00 80         LD SP, BankCutsceneAltStackTop
 120+ 6CDE CD AC 6C         CALL _PageBank7
 121+ 6CE1 CD AC DE         CALL UpdateBankCutsceneBody
 122+ 6CE4 CD 9A 6C         CALL _PageBank0
 123+ 6CE7 ED 7B EC 6C      LD SP, (.savedSPUpdate)
 124+ 6CEB C9               RET
 125+ 6CEC 00 00        .savedSPUpdate: DEFW 0
 126+ 6CEE
 127+ 6CEE              ; ==============================================================================
 128+ 6CEE              ; Entry thunks para town_gate_cutscene (body en bank 7)
 129+ 6CEE              ; ==============================================================================
 130+ 6CEE              ; Mutuamente exclusiva con bank_cutscene (M11 vs M9), comparte el alt_stack
 131+ 6CEE              ; (no pueden estar activas a la vez por el milestone gating en MainLoop).
 132+ 6CEE              ;
 133+ 6CEE              ; StartTownGateCutscene NO necesita su propio entry thunk — se llama solo
 134+ 6CEE              ; desde CheckTownGateTriggerBgBody (interno bank 7).
 135+ 6CEE              ; ==============================================================================
 136+ 6CEE              CheckTownGateTriggerBg:
 137+ 6CEE ED 73 03 6D      LD (.savedSPCheckTG), SP
 138+ 6CF2 31 00 80         LD SP, BankCutsceneAltStackTop
 139+ 6CF5 CD AC 6C         CALL _PageBank7
 140+ 6CF8 CD 8C E5         CALL CheckTownGateTriggerBgBody
 141+ 6CFB CD 9A 6C         CALL _PageBank0
 142+ 6CFE ED 7B 03 6D      LD SP, (.savedSPCheckTG)
 143+ 6D02 C9               RET
 144+ 6D03 00 00        .savedSPCheckTG: DEFW 0
 145+ 6D05
 146+ 6D05              UpdateTownGateCutscene:
 147+ 6D05 ED 73 1A 6D      LD (.savedSPUpdateTG), SP
 148+ 6D09 31 00 80         LD SP, BankCutsceneAltStackTop
 149+ 6D0C CD AC 6C         CALL _PageBank7
 150+ 6D0F CD FA E5         CALL UpdateTownGateCutsceneBody
 151+ 6D12 CD 9A 6C         CALL _PageBank0
 152+ 6D15 ED 7B 1A 6D      LD SP, (.savedSPUpdateTG)
 153+ 6D19 C9               RET
 154+ 6D1A 00 00        .savedSPUpdateTG: DEFW 0
 155+ 6D1C
 156+ 6D1C              ; ==============================================================================
 157+ 6D1C              ; External call thunks - usados desde el body bank 7 para llamar a rutinas
 158+ 6D1C              ; que viven en bank 0 (o en slot 1 que internamente toca bank 0).
 159+ 6D1C              ; ==============================================================================
 160+ 6D1C              ; Patron: body bank 7 hace `CALL <Func>_B7`. El thunk pagina bank 0, llama a
 161+ 6D1C              ; la funcion real, repagina bank 7, y RETurnea al body. Args en HL/BC/DE/A/IX
 162+ 6D1C              ; quedan intactos (_PageBank0 / _PageBank7 preservan AF + BC via PUSH/POP).
 163+ 6D1C              ;
 164+ 6D1C              ; CRITICO: el body bank 7 NO puede llamar _PageBank0 directamente — al volver,
 165+ 6D1C              ; slot 3 estaria en bank 0 y el RET aterrizaria en bank 0 (no en bank 7) =
 166+ 6D1C              ; crash. Por eso cada wrap vive como thunk individual en slot 1 (always-vis).
 167+ 6D1C              ; ==============================================================================
 168+ 6D1C
 169+ 6D1C              ; --- bank 0 callees (paginar bank 0 antes, restaurar bank 7 al RET) ---
 170+ 6D1C
 171+ 6D1C              DrawBgSpriteXOR_B7:
 172+ 6D1C CD 9A 6C         CALL _PageBank0
 173+ 6D1F CD 07 DC         CALL DrawBgSpriteXOR
 174+ 6D22 C3 AC 6C         JP _PageBank7
 175+ 6D25
 176+ 6D25              ; DrawBgGfxSprite_B7 - draw + flags. El unico caller del body bank 7 es
 177+ 6D25              ; BankCutsceneCloseDoorRestoreAttrs, que necesita BgSpriteIsHouse=0 y
 178+ 6D25              ; CurrentTintVar=$FF antes del draw. Esas vars viven en BANK 0, asi que
 179+ 6D25              ; se escriben aqui DENTRO del wrap pre-paginated. Antes era un thunk
 180+ 6D25              ; aparte (DrawBankDoorSprite_B7) pero combinar ahorra 18 B en slot 1 —
 181+ 6D25              ; critico para que magic_compass.asm no cruce $7A00 (im2 table).
 182+ 6D25              DrawBgGfxSprite_B7:
 183+ 6D25 CD 9A 6C         CALL _PageBank0
 184+ 6D28 AF               XOR A
 185+ 6D29 32 8B E3         LD (BgSpriteIsHouse), A
 186+ 6D2C 3E FF            LD A, $FF
 187+ 6D2E 32 9E D2         LD (CurrentTintVar), A
 188+ 6D31 CD 94 D1         CALL DrawBgGfxSprite
 189+ 6D34 C3 AC 6C         JP _PageBank7
 190+ 6D37
 191+ 6D37              RedrawPickupByPtr_B7:
 192+ 6D37 CD 9A 6C         CALL _PageBank0
 193+ 6D3A CD 38 D8         CALL RedrawPickupByPtr
 194+ 6D3D C3 AC 6C         JP _PageBank7
 195+ 6D40
 196+ 6D40              PlaySFX_B7:                              ; HL = SFX data ptr (en bank 0)
 197+ 6D40 CD 9A 6C         CALL _PageBank0
 198+ 6D43 CD 55 F9         CALL PlaySFX
 199+ 6D46 C3 AC 6C         JP _PageBank7
 200+ 6D49
 201+ 6D49              CheckMilestoneTrigger_B7:                ; A = action id
 202+ 6D49 CD 9A 6C         CALL _PageBank0
 203+ 6D4C CD 87 EF         CALL CheckMilestoneTrigger
 204+ 6D4F C3 AC 6C         JP _PageBank7
 205+ 6D52
 206+ 6D52              ; --- slot 1 callee con dependencia bank 0 interna ---
 207+ 6D52
 208+ 6D52              TownGateRedrawPlayer_B7:
 209+ 6D52 CD 9A 6C         CALL _PageBank0
 210+ 6D55 CD F9 62         CALL TownGateRedrawPlayer            ; -> TownGateErasePlayer -> RestoreOldAttr (bank 0)
 211+ 6D58 C3 AC 6C         JP _PageBank7
 212+ 6D5B
 213+ 6D5B              ; --- slot 1 callee que deja bank 0 paginado al RET (solo post-wrap) ---
 214+ 6D5B
 215+ 6D5B              LoadBgSpriteToBuffer_B7:                 ; HL = sprite ptr, A = bank
 216+ 6D5B CD CA 67         CALL LoadBgSpriteToBuffer            ; ya pagina bank 3/4 internamente, deja bank 0 al RET
 217+ 6D5E C3 AC 6C         JP _PageBank7                        ; repaginar bank 7 (LoadBgSpriteToBuffer no lo hace)
 218+ 6D61
 219+ 6D61              ; --- slot 2 callees que internamente paginan bank 6 (sprite_data) y "restauran"
 220+ 6D61              ;     bank 0 al RET, no el bank original. Si los llamasemos crudamente desde
 221+ 6D61              ;     bank 7, slot 3 terminaria con bank 0 -> body bank 7 invisible -> crash.
 222+ 6D61              ;     KillAllActiveNasties -> SnapPuffPos -> GetSpriteDims (pagina bank 6).
 223+ 6D61              ;     KillDeathIfActive    -> StartMusic   (pagina bank 4). ---
 224+ 6D61
 225+ 6D61              KillAllActiveNasties_B7:
 226+ 6D61 CD 4D BA         CALL KillAllActiveNasties
 227+ 6D64 C3 AC 6C         JP _PageBank7                        ; restaura bank 7 (KillAll dejo bank 0)
 228+ 6D67
 229+ 6D67              KillDeathIfActive_B7:
 230+ 6D67 CD 77 62         CALL KillDeathIfActive
 231+ 6D6A C3 AC 6C         JP _PageBank7                        ; restaura bank 7 (StartMusic dejo bank 0)
 232+ 6D6D
 233+ 6D6D              ; ==============================================================================
 234+ 6D6D              ; Thunks adicionales para town_gate_cutscene body (bank 7)
 235+ 6D6D              ; ==============================================================================
 236+ 6D6D              ; town_gate body llama tambien a las siguientes funciones bank 2 / bank 0.
 237+ 6D6D              ; Mismo patron: paginate bank 0, CALL, repaginate bank 7.
 238+ 6D6D              ;
 239+ 6D6D              ; DrawSprite / GetSpriteAddr / GetOldSpriteAddr paginan bank 6 internamente
 240+ 6D6D              ; y restauran bank 0 al RET -> wrap completo (page bank 0 antes, page bank 7
 241+ 6D6D              ; despues).
 242+ 6D6D              ;
 243+ 6D6D              ; RestoreOldAttr / SetEntityAttr / CalcEntityAttrSize estan en bank 0 / bank 2
 244+ 6D6D              ; pero no paginan slot 3 -> tecnicamente el wrap _PageBank0 antes seria
 245+ 6D6D              ; suficiente sin necesidad de _PageBank7 despues. Aun asi por consistencia
 246+ 6D6D              ; con el patron usamos wrap completo.
 247+ 6D6D              ;
 248+ 6D6D              ; StartMusic pagina bank 4 internamente y restaura bank 0 -> wrap completo.
 249+ 6D6D              ; ==============================================================================
 250+ 6D6D
 251+ 6D6D              DrawSprite_B7:                           ; IX = sprite ptr, D = Y, E = X
 252+ 6D6D CD 9A 6C         CALL _PageBank0
 253+ 6D70 CD E9 99         CALL DrawSprite
 254+ 6D73 C3 AC 6C         JP _PageBank7
 255+ 6D76
 256+ 6D76              GetSpriteAddr_B7:                        ; IX = entity ptr, OUT: SpriteAddrTemp
 257+ 6D76 CD 9A 6C         CALL _PageBank0
 258+ 6D79 CD C5 A4         CALL GetSpriteAddr
 259+ 6D7C C3 AC 6C         JP _PageBank7
 260+ 6D7F
 261+ 6D7F              GetOldSpriteAddr_B7:                     ; IX = entity ptr, OUT: OldSprAddr
 262+ 6D7F CD 9A 6C         CALL _PageBank0
 263+ 6D82 CD F6 A4         CALL GetOldSpriteAddr
 264+ 6D85 C3 AC 6C         JP _PageBank7
 265+ 6D88
 266+ 6D88              RestoreOldAttr_B7:                       ; D = Y, E = X
 267+ 6D88 CD 9A 6C         CALL _PageBank0
 268+ 6D8B CD 46 D3         CALL RestoreOldAttr
 269+ 6D8E C3 AC 6C         JP _PageBank7
 270+ 6D91
 271+ 6D91              SetEntityAttr_B7:                        ; D = Y, E = X, A = attr
 272+ 6D91 CD 9A 6C         CALL _PageBank0
 273+ 6D94 CD D9 9A         CALL SetEntityAttr
 274+ 6D97 C3 AC 6C         JP _PageBank7
 275+ 6D9A
 276+ 6D9A              CalcEntityAttrSize_B7:                   ; IX = sprite ptr
 277+ 6D9A CD 9A 6C         CALL _PageBank0
 278+ 6D9D CD 06 9B         CALL CalcEntityAttrSize
 279+ 6DA0 C3 AC 6C         JP _PageBank7
 280+ 6DA3
 281+ 6DA3              StartMusic_B7:                           ; A = track arg
 282+ 6DA3 CD 9A 6C         CALL _PageBank0
 283+ 6DA6 CD BC 99         CALL StartMusic
 284+ 6DA9 C3 AC 6C         JP _PageBank7
 285+ 6DAC
 286+ 6DAC              ; TownGatePlayerSlide* viven en slot 1 (no se mueven a bank 7 porque paginan
 287+ 6DAC              ; bank 6 internamente — si fueran bank 7 el OUT haria desaparecer el codigo
 288+ 6DAC              ; bajo sus pies). Pero al volver al body bank 7 dejan slot 3 = bank 0 ->
 289+ 6DAC              ; necesitan post-wrap.
 290+ 6DAC              TownGatePlayerSlideErase_B7:
 291+ 6DAC CD 6A 63         CALL TownGatePlayerSlideErase
 292+ 6DAF C3 AC 6C         JP _PageBank7
 293+ 6DB2
 294+ 6DB2              TownGatePlayerSlideDraw_B7:
 295+ 6DB2 CD A0 63         CALL TownGatePlayerSlideDraw
 296+ 6DB5 C3 AC 6C         JP _PageBank7
 297+ 6DB8
 298+ 6DB8              ; DrawBgGfxSpriteBlackTint_B7 - draw con CurrentTintVar=0 + BgSpriteIsHouse=0.
 299+ 6DB8              ; Para town_gate: open door + "The End" sprites usan tint negro (ApplyTintSwap
 300+ 6DB8              ; reemplaza paper con 0 = black). Distinto de DrawBgGfxSprite_B7 que pone
 301+ 6DB8              ; tint=$FF (sin swap, attr preservado) para la puerta del banco.
 302+ 6DB8              DrawBgGfxSpriteBlackTint_B7:
 303+ 6DB8 CD 9A 6C         CALL _PageBank0
 304+ 6DBB AF               XOR A
 305+ 6DBC 32 8B E3         LD (BgSpriteIsHouse), A
