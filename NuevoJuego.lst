 335+ 857F              ; --- Buffer de atributos guardados POR ENTIDAD ---
 336+ 857F              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 337+ 857F              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 338+ 857F              ; ---
 339+ 857F 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 340+ 858F 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 341+ 8590 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 342+ 8591 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 343+ 86C3 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 344+ 86C4
 345+ 86C4              ; ==============================================================================
 346+ 86C4              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 347+ 86C4              ; ==============================================================================
 348+ 86C4              ; Entrada: A = indice de entidad (0-16)
 349+ 86C4              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 350+ 86C4              ; ==============================================================================
 351+ 86C4              SetAttrSlot:
 352+ 86C4 32 C3 86         LD (CurrentAttrSlot), A
 353+ 86C7                  ; Calcular offset: A * 18
 354+ 86C7 6F               LD L, A
 355+ 86C8 26 00            LD H, 0
 356+ 86CA 29               ADD HL, HL                  ; x2
 357+ 86CB 54               LD D, H
 358+ 86CC 5D               LD E, L                     ; DE = x2
 359+ 86CD 29               ADD HL, HL                  ; x4
 360+ 86CE 29               ADD HL, HL                  ; x8
 361+ 86CF 29               ADD HL, HL                  ; x16
 362+ 86D0 19               ADD HL, DE                  ; x18
 363+ 86D1 11 91 85         LD DE, SavedAttrTable
 364+ 86D4 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 365+ 86D5                  ; Copiar 18 bytes a EntitySavedAttr
 366+ 86D5 11 7F 85         LD DE, EntitySavedAttr
 367+ 86D8 01 12 00         LD BC, 18
 368+ 86DB ED B0            LDIR
 369+ 86DD C9               RET
 370+ 86DE
 371+ 86DE              ; ==============================================================================
 372+ 86DE              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 373+ 86DE              ; ==============================================================================
 374+ 86DE              FlushAttrSlot:
 375+ 86DE 3A C3 86         LD A, (CurrentAttrSlot)
 376+ 86E1 6F               LD L, A
 377+ 86E2 26 00            LD H, 0
 378+ 86E4 29               ADD HL, HL                  ; x2
 379+ 86E5 54               LD D, H
 380+ 86E6 5D               LD E, L
 381+ 86E7 29               ADD HL, HL                  ; x4
 382+ 86E8 29               ADD HL, HL                  ; x8
 383+ 86E9 29               ADD HL, HL                  ; x16
 384+ 86EA 19               ADD HL, DE                  ; x18
 385+ 86EB 11 91 85         LD DE, SavedAttrTable
 386+ 86EE 19               ADD HL, DE                  ; HL = destino en tabla
 387+ 86EF EB               EX DE, HL                   ; DE = destino
 388+ 86F0 21 7F 85         LD HL, EntitySavedAttr      ; HL = fuente
 389+ 86F3 01 12 00         LD BC, 18
 390+ 86F6 ED B0            LDIR
 391+ 86F8 C9               RET
 392+ 86F9
 393+ 86F9              ; ==============================================================================
 394+ 86F9              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 395+ 86F9              ; ==============================================================================
 396+ 86F9              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 397+ 86F9              ; Salida: HL = direccion en zona de atributos ($5800+)
 398+ 86F9              ; ==============================================================================
 399+ 86F9              CalcAttrAddr:
 400+ 86F9 7A               LD A, D
 401+ 86FA 0F               RRCA
 402+ 86FB 0F               RRCA
 403+ 86FC 0F               RRCA
 404+ 86FD E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 405+ 86FF 6F               LD L, A
 406+ 8700 26 00            LD H, 0
 407+ 8702 29               ADD HL, HL
 408+ 8703 29               ADD HL, HL
 409+ 8704 29               ADD HL, HL
 410+ 8705 29               ADD HL, HL
 411+ 8706 29               ADD HL, HL                  ; HL = fila * 32
 412+ 8707 7B               LD A, E
 413+ 8708 0F               RRCA
 414+ 8709 0F               RRCA
 415+ 870A 0F               RRCA
 416+ 870B E6 1F            AND $1F                     ; X / 8 = columna
 417+ 870D B5               OR L
 418+ 870E 6F               LD L, A
 419+ 870F 01 00 58         LD BC, ATTR_BASE
 420+ 8712 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 421+ 8713 C9               RET
 422+ 8714
 423+ 8714              ; ==============================================================================
 424+ 8714              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 425+ 8714              ; ==============================================================================
 426+ 8714              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 427+ 8714              ; Salida: HL=direccion en VRAM
 428+ 8714              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 429+ 8714              ; ==============================================================================
 430+ 8714              CalcPixelAddr:
 431+ 8714 7A               LD A, D
 432+ 8715 E6 C0            AND $C0                     ; Y7 Y6
 433+ 8717 1F               RRA
 434+ 8718 1F               RRA
 435+ 8719 1F               RRA                         ; >> 3
 436+ 871A F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 437+ 871C 67               LD H, A
 438+ 871D
 439+ 871D 7A               LD A, D
 440+ 871E E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 441+ 8720 B4               OR H
 442+ 8721 67               LD H, A
 443+ 8722
 444+ 8722 7A               LD A, D
 445+ 8723 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 446+ 8725 87               ADD A, A
 447+ 8726 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 448+ 8727 6F               LD L, A
 449+ 8728
 450+ 8728 7B               LD A, E
 451+ 8729 1F               RRA
 452+ 872A 1F               RRA
 453+ 872B 1F               RRA
 454+ 872C E6 1F            AND $1F                     ; X / 8 = columna
 455+ 872E B5               OR L
 456+ 872F 6F               LD L, A
 457+ 8730 C9               RET
 458+ 8731
 459+ 8731              ; ==============================================================================
 460+ 8731              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
