 163+ 9E76                  ; Limpiar toda la tabla a ceros
 164+ 9E76 21 94 81         LD HL, EntityTable
 165+ 9E79 11 95 81         LD DE, EntityTable + 1
 166+ 9E7C 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E7F AF               XOR A
 168+ 9E80 77               LD (HL), A
 169+ 9E81 ED B0            LDIR
 170+ 9E83
 171+ 9E83                  ; Limpiar tabla de atributos salvados
 172+ 9E83 21 D0 9B         LD HL, SavedAttrTable
 173+ 9E86 11 D1 9B         LD DE, SavedAttrTable + 1
 174+ 9E89 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E8C AF               XOR A
 176+ 9E8D 77               LD (HL), A
 177+ 9E8E ED B0            LDIR
