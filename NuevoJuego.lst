 485+ A3DE              ; ==============================================================================
 486+ A3DE              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 487+ A3DE              ; ==============================================================================
 488+ A3DE              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 489+ A3DE              ; ==============================================================================
 490+ A3DE              ProcessOneEnemy:
 491+ A3DE                  ; --- Frozen monster gate (durante muerte del player) ---
 492+ A3DE                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 493+ A3DE                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 494+ A3DE                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 495+ A3DE 3A 95 82         LD A, (MonstersFrozen)
 496+ A3E1 B7               OR A
 497+ A3E2 28 08            JR Z, .peDispatch
 498+ A3E4 DD 7E 01         LD A, (IX+ENT_TYPE)
 499+ A3E7 FE 02            CP TYPE_MONSTER
 500+ A3E9 CA 51 A4         JP Z, .peCalcAndDraw
 501+ A3EC              .peDispatch:
 502+ A3EC                  ; --- Dispatch segun estado ---
 503+ A3EC DD 7E 02         LD A, (IX+ENT_STATE)
 504+ A3EF FE 03            CP STATE_DYING
 505+ A3F1 CA 63 A6         JP Z, .peDying
 506+ A3F4 FE 04            CP STATE_SPAWNING
 507+ A3F6 CA 18 A7         JP Z, .peSpawning
 508+ A3F9 FE 05            CP STATE_SCARED
 509+ A3FB CA 40 A5         JP Z, .peScared
 510+ A3FE FE 06            CP STATE_ATTACKING
 511+ A400 CA 33 A5         JP Z, .peAttacking
