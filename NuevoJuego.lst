1097+ CF18              .roaAabbLoop:
1098+ CF18                  ; (HL+0)=pX, (HL+1)=pY, (HL+2)=pXEnd, (HL+3)=pYEnd.
1099+ CF18                  ; eraseRect = [eX..eX+3] × [eY..eY+3].
1100+ CF18                  ; Overlap: pX <= eX+3 AND pXEnd >= eX AND pY <= eY+3 AND pYEnd >= eY.
1101+ CF18                  ; eX+3 < pX -> no overlap (X)
1102+ CF18 3A 5B CF         LD A, (.roaEraseX)
1103+ CF1B C6 03            ADD A, 3
1104+ CF1D BE               CP (HL)
1105+ CF1E 38 34            JR C, .roaAabbNext
1106+ CF20 23               INC HL                              ; pY
1107+ CF21                  ; eY+3 < pY -> no overlap (Y)
1108+ CF21 3A 5C CF         LD A, (.roaEraseY)
1109+ CF24 C6 03            ADD A, 3
1110+ CF26 BE               CP (HL)
1111+ CF27 38 25            JR C, .roaAabbNext1
1112+ CF29 23               INC HL                              ; pXEnd
1113+ CF2A                  ; pXEnd < eX -> no overlap
1114+ CF2A 7E               LD A, (HL)
1115+ CF2B 4F               LD C, A
1116+ CF2C 3A 5B CF         LD A, (.roaEraseX)
1117+ CF2F B9               CP C
1118+ CF30 28 02            JR Z, .roaAabbXEndOk
1119+ CF32 30 15            JR NC, .roaAabbNext2
1120+ CF34              .roaAabbXEndOk:
1121+ CF34 23               INC HL                              ; pYEnd
1122+ CF35                  ; pYEnd < eY -> no overlap
1123+ CF35 7E               LD A, (HL)
1124+ CF36 4F               LD C, A
1125+ CF37 3A 5C CF         LD A, (.roaEraseY)
