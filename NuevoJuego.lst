 151+ 6481 C0               RET NZ
 152+ 6482                  ; t = ~1.6s: aparece compass_lasting (sprite id 37) en ALT2 de church_key.
 153+ 6482                  ; Sin SFX (a peticion). Es pickup latente (DormantPickupTable +
 154+ 6482                  ; LastingCompassSpawned).
 155+ 6482 3E 01            LD A, 1
 156+ 6484 32 CC 82         LD (LastingCompassSpawned), A
 157+ 6487 11 7F E8         LD DE, BgGfx_compass_lasting
 158+ 648A C3 A4 D8         JP RedrawPickupByPtr                ; tail call
 159+ 648D              .uptpFanfare:
 160+ 648D C3 B9 6A         JP AY_PlayVictoryFanfare            ; non-blocking AY sweep+PIN (~1.5s)
 161+ 6490              .uptpKey:
 162+ 6490                  ; t=1s: aparece el CHEQUE (BankCheck) + avance del hito M#7 (SPECIAL
 163+ 6490                  ; "encerrar monstruos") al M#8 (PICKUP cheque). El cheque NO se auto
 164+ 6490                  ; consume aqui — el player tiene que ir fisicamente a recogerlo. El
 165+ 6490                  ; pickup avanza M#8 -> M#9 via CheckMilestonePickup(7).
 166+ 6490                  ;
 167+ 6490                  ; SFX primero (mismo "clink" que la church_key cuando aparece en la plaza
 168+ 6490                  ; del ayuntamiento): se oye antes de que se dibuje, igual que en CheckBumpTriggers.
 169+ 6490                  ;
