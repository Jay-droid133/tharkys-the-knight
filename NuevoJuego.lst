7498+ CC4A 3E 01            LD A, 1
7499+ CC4C B7               OR A                                ; NZ
7500+ CC4D C9               RET
7501+ CC4E
7502+ CC4E              ; ==============================================================================
7503+ CC4E              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7504+ CC4E              ; ==============================================================================
7505+ CC4E              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7506+ CC4E              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7507+ CC4E              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7508+ CC4E              ; ==============================================================================
7509+ CC4E              ; ==============================================================================
7510+ CC4E              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7511+ CC4E              ; ==============================================================================
7512+ CC4E              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7513+ CC4E              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7514+ CC4E              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7515+ CC4E              ; los pone a su default.
7516+ CC4E              ; ==============================================================================
7517+ CC4E              InitGameState:
7518+ CC4E 3E 03            LD A, PLAYER_LIVES_INIT
7519+ CC50 32 83 82         LD (PlayerLives), A
7520+ CC53 3E 10            LD A, HEALTH_MAX
7521+ CC55 32 6B B6         LD (PlayerHealth), A
7522+ CC58 3E 10            LD A, STAMINA_MAX
7523+ CC5A 32 6C B6         LD (PlayerStamina), A
7524+ CC5D AF               XOR A
7525+ CC5E 32 84 82         LD (GameOver), A
7526+ CC61 32 66 82         LD (CurrentObjective), A
7527+ CC64 32 5E 82         LD (CurrentKey), A
7528+ CC67 32 62 82         LD (ChurchEverOpened), A
7529+ CC6A 32 61 82         LD (ChurchDoorOpen), A
7530+ CC6D 32 63 82         LD (TimeFrozen), A
7531+ CC70 32 60 82         LD (ChurchKeySpawned), A
7532+ CC73 32 71 82         LD (TownGateKeySpawned), A
7533+ CC76 32 75 82         LD (ArmRevealed), A
7534+ CC79 32 76 82         LD (FingerRevealed), A
7535+ CC7C 32 71 B6         LD (MonstersActive), A
7536+ CC7F 32 6D 82         LD (MonsterTrappedFlags), A
7537+ CC82 32 9F 82         LD (DeathSpawned), A
7538+ CC85 32 74 82         LD (TownGatePhase), A
7539+ CC88 32 72 82         LD (ChurchCutscenePhase), A
7540+ CC8B 32 FE E4         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7541+ CC8E 32 65 82         LD (BellsTriggered), A
7542+ CC91 32 6E 82         LD (NextChurchTrapStep), A
7543+ CC94 32 6F 82         LD (StatueBlinkCounter), A
7544+ CC97 32 70 82         LD (ChurchKeyAltSpawnIdx), A
7545+ CC9A 32 06 C8         LD (PlayerHitTimer), A
7546+ CC9D 32 98 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7547+ CCA0 32 99 82         LD (TombDrawPending), A
7548+ CCA3 32 8C 82         LD (DeathBorderPhase), A
7549+ CCA6 32 8D 82         LD (DeathBorderTimer), A
7550+ CCA9 32 8E 82         LD (PlayerDeathAnimTimer), A
7551+ CCAC 32 8F 82         LD (PlayerDeathAnimFrame), A
7552+ CCAF 32 90 82         LD (PlayerRespawnPhase), A
7553+ CCB2 32 91 82         LD (PlayerRespawnTimer), A
7554+ CCB5 32 92 82         LD (PlayerRespawnBlinkTimer), A
7555+ CCB8 32 94 82         LD (PlayerRespawnBeatIdx), A
7556+ CCBB 32 85 82         LD (GameOverAnimX), A
7557+ CCBE 32 86 82         LD (GameOverAnimDir), A
7558+ CCC1 32 87 82         LD (GameOverAnimFrame), A
7559+ CCC4 32 88 82         LD (GameOverAnimFrameTimer), A
7560+ CCC7 32 8B 82         LD (GameOverAnimLastX), A
7561+ CCCA 21 00 00         LD HL, 0
7562+ CCCD 22 89 82         LD (GameOverAnimLastSpr), HL
7563+ CCD0 22 9C 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7564+ CCD3 3E 01            LD A, 1
7565+ CCD5 32 93 82         LD (PlayerRespawnVisible), A
7566+ CCD8 3E 00            LD A, BLACK
7567+ CCDA 32 E8 90         LD (CurrentBorderColor), A
7568+ CCDD D3 FE            OUT (254), A
7569+ CCDF 3E 01            LD A, 1
7570+ CCE1 32 07 C0         LD (DayCycleCount), A
7571+ CCE4 21 EB BF         LD HL, DiurnalTypeTable
7572+ CCE7 22 08 C0         LD (CurrentNastyTable), HL
7573+ CCEA                  ; Reset speed + buff (en caso de restart con buff activo).
7574+ CCEA 3E 04            LD A, SPEED_RUN
7575+ CCEC 32 7A 82         LD (PlayerSpeedRun), A
7576+ CCEF 3E 02            LD A, SPEED_FIGHT
7577+ CCF1 32 7B 82         LD (PlayerSpeedFight), A
7578+ CCF4 21 00 00         LD HL, 0
7579+ CCF7 22 7C 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7580+ CCFA 22 7F 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7581+ CCFD AF               XOR A
7582+ CCFE 32 7E 82         LD (SpeedBuffType), A
7583+ CD01                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7584+ CD01                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7585+ CD01                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7586+ CD01                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7587+ CD01                  ; recupera el control. Mismo flujo que tras una muerte.
7588+ CD01 3E 01            LD A, 1
7589+ CD03 32 90 82         LD (PlayerRespawnPhase), A
7590+ CD06 C9               RET
7591+ CD07
7592+ CD07              OnPlayerHealthDepleted:
7593+ CD07                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7594+ CD07                  ; coste real). Idempotente si no estaba activo.
7595+ CD07 CD 59 71         CALL CancelMagicCompass
7596+ CD0A                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7597+ CD0A                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7598+ CD0A                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7599+ CD0A                  ; (combate, Death catch, drain de salud por cualquier via).
7600+ CD0A F5               PUSH AF
7601+ CD0B 3E FF            LD A, $FF
7602+ CD0D CD 05 9D         CALL StartMusic
7603+ CD10 F1               POP AF
7604+ CD11                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7605+ CD11                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7606+ CD11 CD 0B 6D         CALL AY_PlayPlayerDeath
7607+ CD14                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7608+ CD14                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7609+ CD14 3E 02            LD A, 2
7610+ CD16 32 63 82         LD (TimeFrozen), A
7611+ CD19                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7612+ CD19 CD 3C 6B         CALL TombStore
7613+ CD1C                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7614+ CD1C CD 47 BD         CALL KillAllActiveNasties
7615+ CD1F                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7616+ CD1F CD 15 BE         CALL SilentKillDeath
7617+ CD22                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7618+ CD22 CD 30 BE         CALL FreezeMonstersFacingCorpse
7619+ CD25                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7620+ CD25 CD C3 CD         CALL TriggerDeathBorder
7621+ CD28                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7622+ CD28                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7623+ CD28                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7624+ CD28 DD 21 4B 81      LD IX, EntityTable
7625+ CD2C                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7626+ CD2C DD 7E 0A         LD A, (IX+ENT_DIR)
7627+ CD2F E6 80            AND $80
7628+ CD31 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7629+ CD33 28 02            JR Z, .ophdRightBase
7630+ CD35 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7631+ CD37              .ophdRightBase:
7632+ CD37 DD 77 00         LD (IX+ENT_SPRITEID), A
7633+ CD3A DD 36 06 00      LD (IX+ENT_DELTAX), 0
7634+ CD3E DD 36 07 00      LD (IX+ENT_DELTAY), 0
7635+ CD42 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7636+ CD44 32 8E 82         LD (PlayerDeathAnimTimer), A
7637+ CD47 AF               XOR A
7638+ CD48 32 8F 82         LD (PlayerDeathAnimFrame), A
7639+ CD4B                  ; Decrementar vida (clamp a 0)
7640+ CD4B 3A 83 82         LD A, (PlayerLives)
7641+ CD4E B7               OR A
7642+ CD4F C8               RET Z
7643+ CD50 3D               DEC A
7644+ CD51 32 83 82         LD (PlayerLives), A
7645+ CD54 C9               RET
7646+ CD55
7647+ CD55              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7648+ CD55              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7649+ CD55              ErasePlayerSpriteAtOldPos:
7650+ CD55 DD 21 4B 81      LD IX, EntityTable
7651+ CD59 CD 31 A8         CALL GetOldSpriteAddr
7652+ CD5C DD 56 0D         LD D, (IX+ENT_OLDY)
7653+ CD5F DD 7E 0C         LD A, (IX+ENT_OLDX)
7654+ CD62 5F               LD E, A
7655+ CD63 DD E5            PUSH IX
7656+ CD65 DD 2A B9 A7      LD IX, (OldSprAddr)
7657+ CD69 CD 32 9D         CALL DrawSprite
7658+ CD6C DD E1            POP IX
7659+ CD6E DD 56 0D         LD D, (IX+ENT_OLDY)
7660+ CD71 DD 5E 0C         LD E, (IX+ENT_OLDX)
7661+ CD74 C3 9C D5         JP RestoreOldAttr                   ; tail-call
7662+ CD77
7663+ CD77              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7664+ CD77              RespawnPlayerAtEntry:
7665+ CD77 DD 21 4B 81      LD IX, EntityTable
7666+ CD7B 3A B3 82         LD A, (LastEntryPosX)
7667+ CD7E DD 77 03         LD (IX+ENT_POSX), A
7668+ CD81 DD 77 0C         LD (IX+ENT_OLDX), A
7669+ CD84 DD 77 0F         LD (IX+ENT_DRAWX), A
7670+ CD87 3A B4 82         LD A, (LastEntryPosY)
7671+ CD8A DD 77 04         LD (IX+ENT_POSY), A
7672+ CD8D DD 77 0D         LD (IX+ENT_OLDY), A
7673+ CD90 3E 10            LD A, HEALTH_MAX
7674+ CD92 32 6B B6         LD (PlayerHealth), A
7675+ CD95 3E 10            LD A, STAMINA_MAX
7676+ CD97 32 6C B6         LD (PlayerStamina), A
7677+ CD9A DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7678+ CD9E DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7679+ CDA2 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7680+ CDA6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7681+ CDAA DD 36 06 00      LD (IX+ENT_DELTAX), 0
7682+ CDAE DD 36 07 00      LD (IX+ENT_DELTAY), 0
7683+ CDB2 DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7684+ CDB6                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7685+ CDB6                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7686+ CDB6 3E 01            LD A, 1
7687+ CDB8 32 90 82         LD (PlayerRespawnPhase), A
7688+ CDBB AF               XOR A
7689+ CDBC 32 91 82         LD (PlayerRespawnTimer), A
7690+ CDBF 32 94 82         LD (PlayerRespawnBeatIdx), A
7691+ CDC2 C9               RET
7692+ CDC3
7693+ CDC3              ; ==============================================================================
7694+ CDC3              ; TriggerDeathBorder - arranca el flash del borde tras morir
7695+ CDC3              ; ==============================================================================
7696+ CDC3              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7697+ CDC3              ; luego vuelve a negro y se desactiva.
7698+ CDC3              ; ==============================================================================
7699+ CDC3              TriggerDeathBorder:
7700+ CDC3 3E 01            LD A, 1
7701+ CDC5 32 8C 82         LD (DeathBorderPhase), A
7702+ CDC8 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7703+ CDCA 32 8D 82         LD (DeathBorderTimer), A
7704+ CDCD 3E 06            LD A, YELLOW
7705+ CDCF 32 E8 90         LD (CurrentBorderColor), A
7706+ CDD2 D3 FE            OUT (254), A
7707+ CDD4 C9               RET
7708+ CDD5
7709+ CDD5              ; ==============================================================================
7710+ CDD5              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7711+ CDD5              ; ==============================================================================
7712+ CDD5              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7713+ CDD5              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7714+ CDD5              ; ==============================================================================
7715+ CDD5              UpdateRespawnBlink:
7716+ CDD5 3A 90 82         LD A, (PlayerRespawnPhase)
7717+ CDD8 B7               OR A
7718+ CDD9 C8               RET Z
7719+ CDDA 3D               DEC A
7720+ CDDB 28 0D            JR Z, .urbPhase1
7721+ CDDD                  ; Phase 2: solo timer (sin parpadeo)
7722+ CDDD 3A 91 82         LD A, (PlayerRespawnTimer)
7723+ CDE0 3D               DEC A
7724+ CDE1 32 91 82         LD (PlayerRespawnTimer), A
7725+ CDE4 C0               RET NZ
7726+ CDE5 AF               XOR A
7727+ CDE6 32 90 82         LD (PlayerRespawnPhase), A
7728+ CDE9 C9               RET
7729+ CDEA
7730+ CDEA              .urbPhase1:
7731+ CDEA                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7732+ CDEA                  ; Zero input (sin control)
7733+ CDEA AF               XOR A
7734+ CDEB 32 5B 82         LD (InputDirection), A
7735+ CDEE 32 5C 82         LD (InputFire), A
7736+ CDF1                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7737+ CDF1                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7738+ CDF1 3A 00 6D         LD A, (BeepDurationFrames)
7739+ CDF4 D6 01            SUB 1                               ; CY si era 0 (silencio)
7740+ CDF6 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7741+ CDF7 E6 74            AND SPRID_PLAYER_BLANK
7742+ CDF9 32 4B 81         LD (EntityTable), A
7743+ CDFC                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7744+ CDFC 3A 91 82         LD A, (PlayerRespawnTimer)
7745+ CDFF B7               OR A
7746+ CE00 28 05            JR Z, .urb1FireBeat
7747+ CE02 3D               DEC A
7748+ CE03 32 91 82         LD (PlayerRespawnTimer), A
7749+ CE06 C9               RET
7750+ CE07              .urb1FireBeat:
7751+ CE07 3A 94 82         LD A, (PlayerRespawnBeatIdx)
7752+ CE0A 3C               INC A
7753+ CE0B 32 94 82         LD (PlayerRespawnBeatIdx), A
7754+ CE0E FE 04            CP 4
7755+ CE10 28 12            JR Z, .urb1LastBeat
7756+ CE12 FE 05            CP 5
7757+ CE14 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7758+ CE16                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7759+ CE16 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7760+ CE19 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7761+ CE1B CD 30 6D         CALL AY_PlayBeep
7762+ CE1E                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7763+ CE1E                  ; (mitad) para mantener ON/OFF ~50/50.
7764+ CE1E 3E 14            LD A, 20
7765+ CE20 32 91 82         LD (PlayerRespawnTimer), A
7766+ CE23 C9               RET
7767+ CE24              .urb1LastBeat:
7768+ CE24                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7769+ CE24                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7770+ CE24                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7771+ CE24                  ; entra grace EXACTAMENTE al terminar el beep.
7772+ CE24 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7773+ CE27 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7774+ CE29 CD 30 6D         CALL AY_PlayBeep
7775+ CE2C 3E 0B            LD A, 11                    ; espera = duracion del beep
7776+ CE2E 32 91 82         LD (PlayerRespawnTimer), A
7777+ CE31 C9               RET
7778+ CE32              .urb1AfterBeep:
7779+ CE32                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7780+ CE32                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7781+ CE32 CD 4B CE         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7782+ CE35 3E 0C            LD A, SPAWN_INTERVAL
7783+ CE37 32 9A 82         LD (SpawnTimer), A
7784+ CE3A AF               XOR A
7785+ CE3B 32 9F 82         LD (DeathSpawned), A
7786+ CE3E 32 95 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7787+ CE41 32 63 82         LD (TimeFrozen), A              ; Reanudar reloj
7788+ CE44 21 00 00         LD HL, 0
7789+ CE47 22 9C 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7790+ CE4A C9               RET
7791+ CE4B
7792+ CE4B              ; ==============================================================================
7793+ CE4B              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7794+ CE4B              ; ==============================================================================
7795+ CE4B              ; Llamado desde:
7796+ CE4B              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7797+ CE4B              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7798+ CE4B              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7799+ CE4B              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7800+ CE4B              ; ==============================================================================
7801+ CE4B              EnterGracePhase:
7802+ CE4B 3E 02            LD A, 2
7803+ CE4D 32 90 82         LD (PlayerRespawnPhase), A
7804+ CE50 3E 19            LD A, RESPAWN_GRACE_FRAMES
7805+ CE52 32 91 82         LD (PlayerRespawnTimer), A
7806+ CE55 C9               RET
7807+ CE56
7808+ CE56              ; ==============================================================================
7809+ CE56              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7810+ CE56              ; ==============================================================================
7811+ CE56              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7812+ CE56              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7813+ CE56              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7814+ CE56              ; ==============================================================================
7815+ CE56              UpdateDeathAnim:
7816+ CE56 3A 8C 82         LD A, (DeathBorderPhase)
7817+ CE59 FE 01            CP 1
7818+ CE5B C0               RET NZ
7819+ CE5C 3A 8E 82         LD A, (PlayerDeathAnimTimer)
7820+ CE5F 3D               DEC A
7821+ CE60 32 8E 82         LD (PlayerDeathAnimTimer), A
7822+ CE63 C0               RET NZ
7823+ CE64                  ; Tick consumido: avanzar frame
7824+ CE64 3A 8F 82         LD A, (PlayerDeathAnimFrame)
7825+ CE67 3C               INC A
7826+ CE68 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7827+ CE6A D0               RET NC                              ; ya en ultimo frame (clamp)
7828+ CE6B 32 8F 82         LD (PlayerDeathAnimFrame), A
7829+ CE6E DD 21 4B 81      LD IX, EntityTable
7830+ CE72 DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7831+ CE75                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7832+ CE75                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7833+ CE75                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7834+ CE75 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7835+ CE77 20 06            JR NZ, .udaSkipSplatSfx
7836+ CE79 21 71 F9         LD HL, SFX_EnemyDeath
7837+ CE7C CD F2 F8         CALL PlaySFX
7838+ CE7F              .udaSkipSplatSfx:
7839+ CE7F 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7840+ CE81 32 8E 82         LD (PlayerDeathAnimTimer), A
7841+ CE84 C9               RET
7842+ CE85
7843+ CE85              ; ==============================================================================
7844+ CE85              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7845+ CE85              ; ==============================================================================
7846+ CE85              UpdateDeathBorder:
7847+ CE85 3A 8C 82         LD A, (DeathBorderPhase)
7848+ CE88 B7               OR A
7849+ CE89 C8               RET Z
7850+ CE8A 3A 8D 82         LD A, (DeathBorderTimer)
7851+ CE8D 3D               DEC A
7852+ CE8E 32 8D 82         LD (DeathBorderTimer), A
7853+ CE91 C0               RET NZ
7854+ CE92                  ; Timer expiro: avanzar fase
7855+ CE92 3A 8C 82         LD A, (DeathBorderPhase)
7856+ CE95 FE 01            CP 1
7857+ CE97 20 33            JR NZ, .udbToBlack
7858+ CE99                  ; --- Fin fase amarillo ---
7859+ CE99                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7860+ CE99                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7861+ CE99 3A 83 82         LD A, (PlayerLives)
7862+ CE9C B7               OR A
7863+ CE9D 28 1F            JR Z, .udbToGameOver
7864+ CE9F DD 21 4B 81      LD IX, EntityTable
7865+ CEA3 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7866+ CEA7 3E 02            LD A, 2
7867+ CEA9 32 8C 82         LD (DeathBorderPhase), A
7868+ CEAC 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7869+ CEAE 32 8D 82         LD (DeathBorderTimer), A
7870+ CEB1 3E 02            LD A, RED
7871+ CEB3 32 E8 90         LD (CurrentBorderColor), A
7872+ CEB6 D3 FE            OUT (254), A
7873+ CEB8                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7874+ CEB8                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7875+ CEB8 3E 01            LD A, 1
7876+ CEBA 32 99 82         LD (TombDrawPending), A
7877+ CEBD C9               RET
7878+ CEBE              .udbToGameOver:
7879+ CEBE                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7880+ CEBE AF               XOR A
7881+ CEBF 32 8C 82         LD (DeathBorderPhase), A
7882+ CEC2 3E 00            LD A, BLACK
7883+ CEC4 32 E8 90         LD (CurrentBorderColor), A
7884+ CEC7 D3 FE            OUT (254), A
7885+ CEC9 C3 DA CE         JP ShowGameOver
7886+ CECC              .udbToBlack:
7887+ CECC                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7888+ CECC AF               XOR A
7889+ CECD 32 8C 82         LD (DeathBorderPhase), A
7890+ CED0 3E 00            LD A, BLACK
7891+ CED2 32 E8 90         LD (CurrentBorderColor), A
7892+ CED5 D3 FE            OUT (254), A
7893+ CED7 C3 77 CD         JP RespawnPlayerAtEntry             ; tail-call
7894+ CEDA
7895+ CEDA              ; ==============================================================================
7896+ CEDA              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7897+ CEDA              ; ==============================================================================
7898+ CEDA              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7899+ CEDA              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7900+ CEDA              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7901+ CEDA              ; ==============================================================================
7902+ CEDA              ShowGameOver:
7903+ CEDA 3E 01            LD A, 1
7904+ CEDC 32 84 82         LD (GameOver), A
7905+ CEDF C9               RET
7906+ CEE0
7907+ CEE0              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7908+ CEE0              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7909+ CEE0              PaintGameOverScreen:
7910+ CEE0                  ; Wipe pixels
7911+ CEE0 21 00 40         LD HL, $4000
7912+ CEE3 11 01 40         LD DE, $4001
7913+ CEE6 01 FF 17         LD BC, $17FF
7914+ CEE9 36 00            LD (HL), 0
7915+ CEEB ED B0            LDIR
7916+ CEED                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7917+ CEED 21 00 58         LD HL, $5800
7918+ CEF0 11 01 58         LD DE, $5801
7919+ CEF3 01 FF 02         LD BC, $02FF
7920+ CEF6 36 47            LD (HL), $47
7921+ CEF8 ED B0            LDIR
7922+ CEFA                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7923+ CEFA 3E A0            LD A, GAMEOVER_ANIM_X_MAX
7924+ CEFC 32 85 82         LD (GameOverAnimX), A
7925+ CEFF AF               XOR A
7926+ CF00 32 86 82         LD (GameOverAnimDir), A
7927+ CF03 32 87 82         LD (GameOverAnimFrame), A
7928+ CF06 32 8B 82         LD (GameOverAnimLastX), A
7929+ CF09 21 00 00         LD HL, 0
7930+ CF0C 22 89 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7931+ CF0F 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7932+ CF11 32 88 82         LD (GameOverAnimFrameTimer), A
7933+ CF14                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7934+ CF14                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7935+ CF14                  ; congelado en GameOver=2.
7936+ CF14 3E 03            LD A, 3
7937+ CF16 C3 05 9D         JP StartMusic                   ; tail-call
7938+ CF19
7939+ CF19              ; ==============================================================================
7940+ CF19              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7941+ CF19              ; ==============================================================================
7942+ CF19              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7943+ CF19              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7944+ CF19              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7945+ CF19              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7946+ CF19              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7947+ CF19              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7948+ CF19              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7949+ CF19              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7950+ CF19              ;
7951+ CF19              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7952+ CF19              ; shifted (que ocupa 4 chars = 32 px).
7953+ CF19              ; ==============================================================================
7954+ CF19              GAMEOVER_ANIM_Y           EQU 80
7955+ CF19              GAMEOVER_ANIM_X_MIN       EQU 80
7956+ CF19              GAMEOVER_ANIM_X_MAX       EQU 160
7957+ CF19              GAMEOVER_ANIM_FRAME_TICKS EQU 6
7958+ CF19
7959+ CF19              UpdateGameOverAnim:
7960+ CF19                  ; --- Erase del sprite previo (si lo hubo) ---
7961+ CF19 2A 89 82         LD HL, (GameOverAnimLastSpr)
7962+ CF1C 7C               LD A, H
7963+ CF1D B5               OR L
7964+ CF1E 28 0C            JR Z, .ugoaNoErase
7965+ CF20 E5               PUSH HL
7966+ CF21 DD E1            POP IX
7967+ CF23 3A 8B 82         LD A, (GameOverAnimLastX)
7968+ CF26 5F               LD E, A
7969+ CF27 16 50            LD D, GAMEOVER_ANIM_Y
7970+ CF29 CD 32 9D         CALL DrawSprite
7971+ CF2C              .ugoaNoErase:
7972+ CF2C
7973+ CF2C                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
7974+ CF2C 3A 88 82         LD A, (GameOverAnimFrameTimer)
7975+ CF2F 3D               DEC A
7976+ CF30 20 0A            JR NZ, .ugoaTimerSet
7977+ CF32 3A 87 82         LD A, (GameOverAnimFrame)
7978+ CF35 EE 01            XOR 1
7979+ CF37 32 87 82         LD (GameOverAnimFrame), A
7980+ CF3A 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7981+ CF3C              .ugoaTimerSet:
7982+ CF3C 32 88 82         LD (GameOverAnimFrameTimer), A
7983+ CF3F
7984+ CF3F                  ; --- Avanzar X segun direccion (ping-pong) ---
7985+ CF3F 3A 86 82         LD A, (GameOverAnimDir)
7986+ CF42 B7               OR A
7987+ CF43 20 14            JR NZ, .ugoaSlideRight
7988+ CF45                  ; Dir 0: facing R, slide LEFT (X--)
7989+ CF45 3A 85 82         LD A, (GameOverAnimX)
7990+ CF48 FE 50            CP GAMEOVER_ANIM_X_MIN
7991+ CF4A 28 06            JR Z, .ugoaFlipToL
7992+ CF4C 3D               DEC A
7993+ CF4D 32 85 82         LD (GameOverAnimX), A
7994+ CF50 18 18            JR .ugoaPickSprite
7995+ CF52              .ugoaFlipToL:
7996+ CF52 3E 01            LD A, 1
7997+ CF54 32 86 82         LD (GameOverAnimDir), A
7998+ CF57 18 11            JR .ugoaPickSprite
7999+ CF59              .ugoaSlideRight:
8000+ CF59                  ; Dir 1: facing L, slide RIGHT (X++)
8001+ CF59 3A 85 82         LD A, (GameOverAnimX)
8002+ CF5C FE A0            CP GAMEOVER_ANIM_X_MAX
8003+ CF5E 28 06            JR Z, .ugoaFlipToR
8004+ CF60 3C               INC A
8005+ CF61 32 85 82         LD (GameOverAnimX), A
8006+ CF64 18 04            JR .ugoaPickSprite
8007+ CF66              .ugoaFlipToR:
8008+ CF66 AF               XOR A
8009+ CF67 32 86 82         LD (GameOverAnimDir), A
8010+ CF6A
8011+ CF6A              .ugoaPickSprite:
8012+ CF6A                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8013+ CF6A                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8014+ CF6A                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8015+ CF6A 3A 86 82         LD A, (GameOverAnimDir)
8016+ CF6D B7               OR A
8017+ CF6E 20 0E            JR NZ, .ugoaPickR
8018+ CF70 3A 87 82         LD A, (GameOverAnimFrame)
8019+ CF73 B7               OR A
8020+ CF74 21 E9 DD         LD HL, SprDeath_L0
8021+ CF77 28 11            JR Z, .ugoaSprSet
8022+ CF79 21 33 DE         LD HL, SprDeath_L1
8023+ CF7C 18 0C            JR .ugoaSprSet
8024+ CF7E              .ugoaPickR:
8025+ CF7E 3A 87 82         LD A, (GameOverAnimFrame)
8026+ CF81 B7               OR A
8027+ CF82 21 55 DD         LD HL, SprDeath_0
8028+ CF85 28 03            JR Z, .ugoaSprSet
8029+ CF87 21 9F DD         LD HL, SprDeath_1
8030+ CF8A              .ugoaSprSet:
8031+ CF8A 22 89 82         LD (GameOverAnimLastSpr), HL
8032+ CF8D 3A 85 82         LD A, (GameOverAnimX)
8033+ CF90 32 8B 82         LD (GameOverAnimLastX), A
8034+ CF93
8035+ CF93                  ; --- Draw nuevo sprite ---
8036+ CF93 E5               PUSH HL
8037+ CF94 DD E1            POP IX
8038+ CF96 5F               LD E, A
8039+ CF97 16 50            LD D, GAMEOVER_ANIM_Y
8040+ CF99 C3 32 9D         JP DrawSprite                   ; tail-call
