 120+ 98FF              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 121+ 98FF              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 122+ 98FF              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 123+ 98FF              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 124+ 98FF              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 125+ 98FF              AY_OverrideBellPeriod:
 126+ 98FF F3               DI
 127+ 9900                  ; R0 = period low (canal A)
 128+ 9900 5D               LD E, L
 129+ 9901 3E 00            LD A, 0
 130+ 9903 01 FD FF         LD BC, $FFFD
 131+ 9906 ED 79            OUT (C), A
 132+ 9908 01 FD BF         LD BC, $BFFD
 133+ 990B ED 59            OUT (C), E
 134+ 990D                  ; R1 = period high (canal A)
 135+ 990D 5C               LD E, H
 136+ 990E 3E 01            LD A, 1
 137+ 9910 01 FD FF         LD BC, $FFFD
 138+ 9913 ED 79            OUT (C), A
 139+ 9915 01 FD BF         LD BC, $BFFD
 140+ 9918 ED 59            OUT (C), E
 141+ 991A                  ; R2/R3 (canal B)
 142+ 991A 5D               LD E, L
 143+ 991B 3E 02            LD A, 2
 144+ 991D 01 FD FF         LD BC, $FFFD
 145+ 9920 ED 79            OUT (C), A
 146+ 9922 01 FD BF         LD BC, $BFFD
 147+ 9925 ED 59            OUT (C), E
 148+ 9927 5C               LD E, H
 149+ 9928 3E 03            LD A, 3
 150+ 992A 01 FD FF         LD BC, $FFFD
 151+ 992D ED 79            OUT (C), A
 152+ 992F 01 FD BF         LD BC, $BFFD
 153+ 9932 ED 59            OUT (C), E
 154+ 9934                  ; R4/R5 (canal C)
 155+ 9934 5D               LD E, L
 156+ 9935 3E 04            LD A, 4
 157+ 9937 01 FD FF         LD BC, $FFFD
 158+ 993A ED 79            OUT (C), A
 159+ 993C 01 FD BF         LD BC, $BFFD
 160+ 993F ED 59            OUT (C), E
 161+ 9941 5C               LD E, H
 162+ 9942 3E 05            LD A, 5
 163+ 9944 01 FD FF         LD BC, $FFFD
 164+ 9947 ED 79            OUT (C), A
 165+ 9949 01 FD BF         LD BC, $BFFD
 166+ 994C ED 59            OUT (C), E
 167+ 994E FB               EI
 168+ 994F C9               RET
 169+ 9950
 170+ 9950              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 171+ 9950              ; HL = period (12-bit), B = duracion (10ms units).
 172+ 9950              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 173+ 9950              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 174+ 9950              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 175+ 9950              ; cambiaramos de bank en slot 3 entre el push y el pop).
 176+ 9950              AY_PlayToneBlocking:
 177+ 9950 F3               DI
 178+ 9951                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 9951                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 9951 5C               LD E, H                     ; E = period high
 181+ 9952 3E 01            LD A, 1
 182+ 9954 01 FD FF         LD BC, $FFFD
 183+ 9957 ED 79            OUT (C), A
 184+ 9959 01 FD BF         LD BC, $BFFD
 185+ 995C ED 59            OUT (C), E
 186+ 995E                  ; R0 = period low
 187+ 995E 5D               LD E, L                     ; E = period low
 188+ 995F 3E 00            LD A, 0
 189+ 9961 01 FD FF         LD BC, $FFFD
 190+ 9964 ED 79            OUT (C), A
 191+ 9966 01 FD BF         LD BC, $BFFD
 192+ 9969 ED 59            OUT (C), E
 193+ 996B                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 194+ 996B 3E 09            LD A, 9
 195+ 996D 01 FD FF         LD BC, $FFFD
 196+ 9970 ED 79            OUT (C), A
 197+ 9972 01 FD BF         LD BC, $BFFD
 198+ 9975 AF               XOR A
 199+ 9976 ED 79            OUT (C), A
 200+ 9978                  ; R10 = 0 (silenciar canal C)
 201+ 9978 3E 0A            LD A, 10
 202+ 997A 01 FD FF         LD BC, $FFFD
 203+ 997D ED 79            OUT (C), A
 204+ 997F 01 FD BF         LD BC, $BFFD
 205+ 9982 AF               XOR A
 206+ 9983 ED 79            OUT (C), A
 207+ 9985                  ; R7 = $3E (mixer: solo tono A activo)
 208+ 9985 3E 07            LD A, 7
 209+ 9987 01 FD FF         LD BC, $FFFD
 210+ 998A ED 79            OUT (C), A
 211+ 998C 01 FD BF         LD BC, $BFFD
 212+ 998F 3E 3E            LD A, $3E
 213+ 9991 ED 79            OUT (C), A
 214+ 9993                  ; R8 = 13 (volumen A alto)
 215+ 9993 3E 08            LD A, 8
 216+ 9995 01 FD FF         LD BC, $FFFD
 217+ 9998 ED 79            OUT (C), A
 218+ 999A 01 FD BF         LD BC, $BFFD
 219+ 999D 3E 0D            LD A, 13
 220+ 999F ED 79            OUT (C), A
 221+ 99A1                  ; --- Busy loop B × ~12.4ms ---
 222+ 99A1              .aypbOuter:
 223+ 99A1 21 80 06         LD HL, $0680                ; ~1664 inner iters
 224+ 99A4              .aypbInner:
 225+ 99A4 2B               DEC HL
 226+ 99A5 7C               LD A, H
 227+ 99A6 B5               OR L
 228+ 99A7 20 FB            JR NZ, .aypbInner
 229+ 99A9 10 F6            DJNZ .aypbOuter
 230+ 99AB                  ; --- Silenciar canal A (volumen 0) ---
 231+ 99AB 3E 08            LD A, 8
 232+ 99AD 01 FD FF         LD BC, $FFFD
 233+ 99B0 ED 79            OUT (C), A
 234+ 99B2 01 FD BF         LD BC, $BFFD
 235+ 99B5 AF               XOR A
 236+ 99B6 ED 79            OUT (C), A
 237+ 99B8 FB               EI
 238+ 99B9 C9               RET
