 386+ 689A 2A 0A 83         LD HL, (CurrentScreenAddr)
 387+ 689D              .eseLoop:
 388+ 689D 7E               LD A, (HL)
 389+ 689E FE FF            CP $FF
 390+ 68A0 C8               RET Z                                   ; no encontrada en esta pantalla
 391+ 68A1 47               LD B, A                                 ; B = current id
 392+ 68A2 3A D3 68         LD A, (.eseTargetId)
 393+ 68A5 B8               CP B
 394+ 68A6 28 06            JR Z, .eseFound
 395+ 68A8 11 04 00         LD DE, 4
 396+ 68AB 19               ADD HL, DE
 397+ 68AC 18 EF            JR .eseLoop
 398+ 68AE              .eseFound:
