1194+ F5F7              .ucsShakeBorderOut:
1195+ F5F7 D3 FE            OUT (254), A
1196+ F5F9 21 9D 5F         LD HL, ChurchCutsceneFrame
1197+ F5FC 34               INC (HL)
1198+ F5FD C9               RET
1199+ F5FE              .ucsShakeJitterTable:
1200+ F5FE 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1201+ F602              .ucsShakeStatueDone:
1202+ F602                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1203+ F602 AF               XOR A
1204+ F603 D3 FE            OUT (254), A
1205+ F605                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1206+ F605                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1207+ F605                  ; directo a 0 garantiza que no queden residuos.)
