4867+ B9B3 21 D6 B9         LD HL, EnemySpeedTable
4868+ B9B6 5F               LD E, A
4869+ B9B7 16 00            LD D, 0
4870+ B9B9 19               ADD HL, DE
4871+ B9BA 7E               LD A, (HL)                          ; A = velocidad × 2
4872+ B9BB                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4873+ B9BB CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4874+ B9BD 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4875+ B9BF                  ; Hay fraccion .5: alternar +1 en frames impares
4876+ B9BF 47               LD B, A                             ; B = parte entera
4877+ B9C0 3A 9B 81         LD A, (GameFrameCounter)
4878+ B9C3 E6 01            AND 1                               ; 0 en par, 1 en impar
4879+ B9C5 80               ADD A, B                            ; Sumar 0 o 1
4880+ B9C6              .uesNoFrac:
4881+ B9C6 32 58 8D         LD (CurrentEnemySpeed), A
4882+ B9C9                  ; Leer delay de animacion para este ciclo
4883+ B9C9 F1               POP AF                              ; A = indice 0-based
4884+ B9CA 21 E0 B9         LD HL, EnemyAnimDelayTable
4885+ B9CD 5F               LD E, A
4886+ B9CE 16 00            LD D, 0
4887+ B9D0 19               ADD HL, DE
4888+ B9D1 7E               LD A, (HL)
4889+ B9D2 32 59 8D         LD (CurrentEnemyAnimDelay), A
4890+ B9D5 C9               RET
4891+ B9D6
4892+ B9D6              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4893+ B9D6              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4894+ B9D6              EnemySpeedTable:
4895+ B9D6 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4896+ B9D7 05               DEFB 5                              ; Ciclo 2: 2.5px
4897+ B9D8 06               DEFB 6                              ; Ciclo 3: 3px
4898+ B9D9 07               DEFB 7                              ; Ciclo 4: 3.5px
4899+ B9DA 08               DEFB 8                              ; Ciclo 5: 4px
4900+ B9DB 09               DEFB 9                              ; Ciclo 6: 4.5px
4901+ B9DC 0A               DEFB 10                             ; Ciclo 7: 5px
