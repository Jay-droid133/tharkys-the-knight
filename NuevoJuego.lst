 144  74E9                  ; ==========================================================================
 145  74E9                  ; ORG $8000 - codigo principal (no-contended)
 146  74E9                  ; ==========================================================================
 147  74E9                  ORG ORIGIN_ADDRESS
 148  8000
 149  8000              ; ==============================================================================
 150  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 151  8000              ; ==============================================================================
 152  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 153  8000              ;   erase viejo → AI/movimiento → draw nuevo
 154  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 155  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 156  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 157  8000              ; ==============================================================================
 158  8000              MainLoop:
 159  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 160  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 161  8003 47               LD B, A                     ; B = tick actual
 162  8004
 163  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 164  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 165  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 166  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 167  8004 78               LD A, B
 168  8005 21 47 81         LD HL, .frameStart
 169  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 170  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 171  800A 21 2D 9D         LD HL, TickRemainder
 172  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 173  800E 4F               LD C, A
 174  800F E6 01            AND $01
 175  8011 77               LD (HL), A                  ; new remainder = total mod 2
 176  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 177  8014 79               LD A, C
 178  8015 32 2C 9D         LD (FramesElapsed), A
 179  8018
 180  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 181  8018 CD 85 CE         CALL UpdateDeathBorder
 182  801B CD 56 CE         CALL UpdateDeathAnim
 183  801E                  ; UpdateMusic vive aqui (no en .skipUpdates) para que las pistas tabulares
 184  801E                  ; suenen tambien durante cutscenes (TownGatePhase!=0) y GameOver. Cada
 185  801E                  ; llamada hace catchup interno via FramesElapsed (loop de N iteraciones).
 186  801E CD 06 9C         CALL UpdateMusic
 187  8021
 188  8021                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 189  8021 3A 84 82         LD A, (GameOver)
 190  8024 B7               OR A
 191  8025 28 23            JR Z, .notGameOver
 192  8027 FE 02            CP 2
 193  8029 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 194  802B                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 195  802B CD E0 CE         CALL PaintGameOverScreen
 196  802E 3E 02            LD A, 2
 197  8030 32 84 82         LD (GameOver), A
 198  8033 C3 37 81         JP .frameSync
