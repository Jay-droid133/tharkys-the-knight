1649+ F712              ; ==============================================================================
1650+ F712              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1651+ F712              ; ==============================================================================
1652+ F712              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1653+ F712              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1654+ F712              ; suficiente para corromper visualmente).
1655+ F712              ; IN: IX = entity ptr.
1656+ F712              ; ==============================================================================
1657+ F712              RedrawTrappedMonster:
1658+ F712                  ; --- Erase viejo en (OLDX, OLDY) ---
1659+ F712 CD 26 A5         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1660+ F715 DD 7E 0D         LD A, (IX+ENT_OLDY)
1661+ F718 57               LD D, A
1662+ F719 DD 7E 0C         LD A, (IX+ENT_OLDX)
1663+ F71C 5F               LD E, A
1664+ F71D DD E5            PUSH IX
1665+ F71F DD 2A AB A4      LD IX, (OldSprAddr)
1666+ F723 CD EF 99         CALL DrawSprite
1667+ F726 DD E1            POP IX
1668+ F728                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1669+ F728                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1670+ F728 DD 56 0D         LD D, (IX+ENT_OLDY)
1671+ F72B DD 5E 0C         LD E, (IX+ENT_OLDX)
1672+ F72E CD 98 D3         CALL RestoreOldAttr
1673+ F731                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1674+ F731                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1675+ F731                  ; reponer attrs de pickups que el flujo de entidades pisa con
1676+ F731                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1677+ F731                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1678+ F731                  ; estar bajo el monster.
1679+ F731 DD E5            PUSH IX
1680+ F733 CD BC DA         CALL RefreshPickupAttrs
1681+ F736 DD E1            POP IX
1682+ F738                  ; --- Compute new draw pos ---
1683+ F738 CD AD A4         CALL CalcDrawX
1684+ F73B CD 45 9F         CALL ComputeEnemyDrawY
1685+ F73E                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1686+ F73E CD F5 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1687+ F741 3A E5 82         LD A, (EnemyDrawY)
1688+ F744 57               LD D, A
1689+ F745 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1690+ F748 5F               LD E, A
1691+ F749 DD E5            PUSH IX
1692+ F74B DD 2A 24 A5      LD IX, (SpriteAddrTemp)
1693+ F74F CD 0C 9B         CALL CalcEntityAttrSize
1694+ F752 DD E1            POP IX
1695+ F754 3A E5 82         LD A, (EnemyDrawY)
1696+ F757 57               LD D, A
1697+ F758 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1698+ F75B 5F               LD E, A
1699+ F75C DD 7E 05         LD A, (IX+ENT_ATTR)
1700+ F75F CD DF 9A         CALL SetEntityAttr
1701+ F762                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1702+ F762 3A E5 82         LD A, (EnemyDrawY)
1703+ F765 57               LD D, A
1704+ F766 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1705+ F769 5F               LD E, A
1706+ F76A DD E5            PUSH IX
1707+ F76C DD 2A 24 A5      LD IX, (SpriteAddrTemp)
1708+ F770 CD EF 99         CALL DrawSprite
1709+ F773 DD E1            POP IX
1710+ F775                  ; --- Save OLD = current ---
1711+ F775 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1712+ F778 DD 77 0C         LD (IX+ENT_OLDX), A
1713+ F77B 3A E5 82         LD A, (EnemyDrawY)
1714+ F77E DD 77 0D         LD (IX+ENT_OLDY), A
1715+ F781 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1716+ F784 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1717+ F787 C9               RET
