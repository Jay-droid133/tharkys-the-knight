2034+ AD80              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2035+ AD80              ; ==============================================================================
2036+ AD80              UpdateStamina:
2037+ AD80                  ; --- Regenerar salud (siempre, lento) ---
2038+ AD80 3A 68 B6         LD A, (PlayerHealth)
2039+ AD83 FE 10            CP HEALTH_MAX
2040+ AD85 28 12            JR Z, .usHealthFull
2041+ AD87 21 6C B6         LD HL, HealthRegenCtr
2042+ AD8A 34               INC (HL)
2043+ AD8B 7E               LD A, (HL)
2044+ AD8C FE 32            CP HEALTH_REGEN_RATE
2045+ AD8E 38 09            JR C, .usHealthFull
2046+ AD90 36 00            LD (HL), 0
2047+ AD92 3A 68 B6         LD A, (PlayerHealth)
2048+ AD95 3C               INC A
2049+ AD96 32 68 B6         LD (PlayerHealth), A
2050+ AD99              .usHealthFull:
2051+ AD99                  ; --- Stamina: consumir o regenerar ---
2052+ AD99 DD 7E 02         LD A, (IX+ENT_STATE)
2053+ AD9C FE 02            CP STATE_FIGHTING
2054+ AD9E 28 18            JR Z, .usDrain
2055+ ADA0                  ; No atacando: regenerar
2056+ ADA0 3A 69 B6         LD A, (PlayerStamina)
2057+ ADA3 FE 10            CP STAMINA_MAX
2058+ ADA5 C8               RET Z                               ; Ya al maximo
2059+ ADA6 21 6B B6         LD HL, StaminaRegenCtr
2060+ ADA9 34               INC (HL)
2061+ ADAA 7E               LD A, (HL)
2062+ ADAB FE 19            CP STAMINA_REGEN_RATE
2063+ ADAD D8               RET C                               ; Aun no toca
2064+ ADAE 36 00            LD (HL), 0                          ; Reset counter
2065+ ADB0 3A 69 B6         LD A, (PlayerStamina)
2066+ ADB3 3C               INC A
2067+ ADB4 32 69 B6         LD (PlayerStamina), A
2068+ ADB7 C9               RET
2069+ ADB8              .usDrain:
2070+ ADB8                  ; Atacando: consumir stamina
2071+ ADB8 3A 69 B6         LD A, (PlayerStamina)
2072+ ADBB B7               OR A
2073+ ADBC C8               RET Z                               ; Ya vacia
2074+ ADBD 21 6A B6         LD HL, StaminaDrainCtr
2075+ ADC0 34               INC (HL)
2076+ ADC1 7E               LD A, (HL)
2077+ ADC2 FE 0D            CP STAMINA_DRAIN_RATE
2078+ ADC4 D8               RET C
2079+ ADC5 36 00            LD (HL), 0
2080+ ADC7 3A 69 B6         LD A, (PlayerStamina)
2081+ ADCA 3D               DEC A
2082+ ADCB 32 69 B6         LD (PlayerStamina), A
