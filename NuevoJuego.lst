 389+ E3D4 7E               LD A, (HL)
 390+ E3D5 FE FF            CP $FF
 391+ E3D7 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 392+ E3D9 B8               CP B
 393+ E3DA 28 03            JR Z, .checkFound
 394+ E3DC 23               INC HL
 395+ E3DD 18 F5            JR .checkLoop
