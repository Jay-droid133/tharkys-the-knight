5363+ BC93              ; ==============================================================================
5364+ BC93              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5365+ BC93              ; ==============================================================================
5366+ BC93              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5367+ BC93              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5368+ BC93              ; ==============================================================================
5369+ BC93              KillAllActiveMonsters:
5370+ BC93 AF               XOR A
5371+ BC94 32 5B B3         LD (MonstersActive), A              ; No respawnear mas
5372+ BC97 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5373+ BC9B 06 06            LD B, NUM_MONSTERS
5374+ BC9D              .kamLoop:
5375+ BC9D C5               PUSH BC
5376+ BC9E DD 7E 01         LD A, (IX+ENT_TYPE)
5377+ BCA1 B7               OR A
5378+ BCA2 28 27            JR Z, .kamSkip                      ; slot vacio
5379+ BCA4 FE 02            CP TYPE_MONSTER
5380+ BCA6 20 23            JR NZ, .kamSkip                     ; no es monster
5381+ BCA8 DD 7E 02         LD A, (IX+ENT_STATE)
5382+ BCAB FE 03            CP STATE_DYING
5383+ BCAD 28 1C            JR Z, .kamSkip
5384+ BCAF FE 04            CP STATE_SPAWNING
5385+ BCB1 28 18            JR Z, .kamSkip
5386+ BCB3 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5387+ BCB7 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5388+ BCBB DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5389+ BCBF DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5390+ BCC3 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5391+ BCC7 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5392+ BCCB                  ; ENT_ATTR conservado: puff hereda color del monster
5393+ BCCB              .kamSkip:
5394+ BCCB 11 10 00         LD DE, ENT_SIZE
5395+ BCCE DD 19            ADD IX, DE
5396+ BCD0 C1               POP BC
5397+ BCD1 10 CA            DJNZ .kamLoop
5398+ BCD3 C9               RET
5399+ BCD4
5400+ BCD4              ; --- Tabla de tipos de nasty (SpriteID base) ---
5401+ BCD4              ; --- Tablas de nasties por momento del dia ---
5402+ BCD4              NUM_NASTY_TYPES EQU 4
5403+ BCD4              DiurnalTypeTable:                       ; DY, C1, A2
5404+ BCD4 30               DEFB SPRID_ENEMY_4          ; Eagle
5405+ BCD5 20               DEFB SPRID_ENEMY_0          ; Spider
5406+ BCD6 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5407+ BCD7 2C               DEFB SPRID_ENEMY_3          ; Snake
5408+ BCD8              CrepuscularTypeTable:                   ; C2, N1
5409+ BCD8 34               DEFB SPRID_ENEMY_5          ; Rat
5410+ BCD9 28               DEFB SPRID_ENEMY_2          ; Bat
5411+ BCDA 24               DEFB SPRID_ENEMY_1          ; Scorpion
5412+ BCDB 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5413+ BCDC
5414+ BCDC              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5415+ BCDC              NastyColorTable:
5416+ BCDC 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5417+ BCDD 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5418+ BCDE 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5419+ BCDF 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5420+ BCE0 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5421+ BCE1 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5422+ BCE2 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5423+ BCE3 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5424+ BCE4
5425+ BCE4              ; --- Tabla de comportamiento depredador ---
5426+ BCE4              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5427+ BCE4              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5428+ BCE4              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5429+ BCE4              PredatorTable:
5430+ BCE4 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5431+ BCE5 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5432+ BCE6 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5433+ BCE7 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5434+ BCE8 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5435+ BCE9 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5436+ BCEA 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5437+ BCEB 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5438+ BCEC
5439+ BCEC              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5440+ BCEC              PredatorSpeedTable:
5441+ BCEC 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5442+ BCED 02               DEFB 2                              ; Ciclo 1: lento
5443+ BCEE 03               DEFB 3                              ; Ciclo 2: intermedio
5444+ BCEF 04               DEFB 4                              ; Ciclo 3+: rapido
