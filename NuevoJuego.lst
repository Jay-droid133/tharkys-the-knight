7677+ C9F7              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7678+ C9F7              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7679+ C9F7              ErasePlayerSpriteAtOldPos:
7680+ C9F7 DD 21 9E 81      LD IX, EntityTable
7681+ C9FB CD F7 A4         CALL GetOldSpriteAddr
7682+ C9FE DD 56 0D         LD D, (IX+ENT_OLDY)
7683+ CA01 DD 7E 0C         LD A, (IX+ENT_OLDX)
7684+ CA04 5F               LD E, A
7685+ CA05 DD E5            PUSH IX
7686+ CA07 DD 2A 7F A4      LD IX, (OldSprAddr)
7687+ CA0B CD EA 99         CALL DrawSprite
7688+ CA0E DD E1            POP IX
7689+ CA10 DD 56 0D         LD D, (IX+ENT_OLDY)
7690+ CA13 DD 5E 0C         LD E, (IX+ENT_OLDX)
7691+ CA16 C3 9C D2         JP RestoreOldAttr                   ; tail-call
7692+ CA19
7693+ CA19              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7694+ CA19              RespawnPlayerAtEntry:
7695+ CA19 DD 21 9E 81      LD IX, EntityTable
7696+ CA1D 3A 11 83         LD A, (LastEntryPosX)
7697+ CA20 DD 77 03         LD (IX+ENT_POSX), A
7698+ CA23 DD 77 0C         LD (IX+ENT_OLDX), A
7699+ CA26 DD 77 0F         LD (IX+ENT_DRAWX), A
7700+ CA29 3A 12 83         LD A, (LastEntryPosY)
7701+ CA2C DD 77 04         LD (IX+ENT_POSY), A
7702+ CA2F DD 77 0D         LD (IX+ENT_OLDY), A
7703+ CA32 3E 10            LD A, HEALTH_MAX
7704+ CA34 32 0F B3         LD (PlayerHealth), A
7705+ CA37 3E 10            LD A, STAMINA_MAX
7706+ CA39 32 10 B3         LD (PlayerStamina), A
7707+ CA3C DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7708+ CA40 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7709+ CA44 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7710+ CA48 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7711+ CA4C DD 36 06 00      LD (IX+ENT_DELTAX), 0
7712+ CA50 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7713+ CA54                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7714+ CA54                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7715+ CA54                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7716+ CA54                  ; libre, y .swordModeFree no toca el color.
7717+ CA54 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7718+ CA58 AF               XOR A
7719+ CA59 32 0B B3         LD (AttackCooldown), A
7720+ CA5C 32 0A B3         LD (AttackTimer), A
7721+ CA5F DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7722+ CA63                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7723+ CA63                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7724+ CA63 3E 01            LD A, 1
7725+ CA65 32 EE 82         LD (PlayerRespawnPhase), A
7726+ CA68 AF               XOR A
7727+ CA69 32 EF 82         LD (PlayerRespawnTimer), A
7728+ CA6C 32 F2 82         LD (PlayerRespawnBeatIdx), A
7729+ CA6F C9               RET
7730+ CA70
7731+ CA70              ; ==============================================================================
7732+ CA70              ; TriggerDeathBorder - arranca el flash del borde tras morir
7733+ CA70              ; ==============================================================================
7734+ CA70              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7735+ CA70              ; luego vuelve a negro y se desactiva.
7736+ CA70              ; ==============================================================================
7737+ CA70              TriggerDeathBorder:
7738+ CA70 3E 01            LD A, 1
7739+ CA72 32 EA 82         LD (DeathBorderPhase), A
7740+ CA75 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7741+ CA77 32 EB 82         LD (DeathBorderTimer), A
7742+ CA7A 3E 06            LD A, YELLOW
7743+ CA7C 32 86 8D         LD (CurrentBorderColor), A
7744+ CA7F D3 FE            OUT (254), A
7745+ CA81 C9               RET
7746+ CA82
7747+ CA82              ; ==============================================================================
7748+ CA82              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7749+ CA82              ; ==============================================================================
7750+ CA82              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7751+ CA82              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7752+ CA82              ; ==============================================================================
7753+ CA82              UpdateRespawnBlink:
7754+ CA82 3A EE 82         LD A, (PlayerRespawnPhase)
7755+ CA85 B7               OR A
7756+ CA86 C8               RET Z
7757+ CA87 3D               DEC A
7758+ CA88 28 0D            JR Z, .urbPhase1
7759+ CA8A                  ; Phase 2: solo timer (sin parpadeo)
7760+ CA8A 3A EF 82         LD A, (PlayerRespawnTimer)
7761+ CA8D 3D               DEC A
7762+ CA8E 32 EF 82         LD (PlayerRespawnTimer), A
7763+ CA91 C0               RET NZ
7764+ CA92 AF               XOR A
7765+ CA93 32 EE 82         LD (PlayerRespawnPhase), A
7766+ CA96 C9               RET
7767+ CA97
7768+ CA97              .urbPhase1:
7769+ CA97                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7770+ CA97                  ; Zero input (sin control)
7771+ CA97 AF               XOR A
7772+ CA98 32 AE 82         LD (InputDirection), A
7773+ CA9B 32 AF 82         LD (InputFire), A
7774+ CA9E                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7775+ CA9E                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7776+ CA9E 3A 9C 6D         LD A, (BeepDurationFrames)
7777+ CAA1 D6 01            SUB 1                               ; CY si era 0 (silencio)
7778+ CAA3 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7779+ CAA4 E6 74            AND SPRID_PLAYER_BLANK
7780+ CAA6 32 9E 81         LD (EntityTable), A
7781+ CAA9                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7782+ CAA9 3A EF 82         LD A, (PlayerRespawnTimer)
7783+ CAAC B7               OR A
7784+ CAAD 28 05            JR Z, .urb1FireBeat
7785+ CAAF 3D               DEC A
7786+ CAB0 32 EF 82         LD (PlayerRespawnTimer), A
7787+ CAB3 C9               RET
7788+ CAB4              .urb1FireBeat:
7789+ CAB4 3A F2 82         LD A, (PlayerRespawnBeatIdx)
7790+ CAB7 3C               INC A
7791+ CAB8 32 F2 82         LD (PlayerRespawnBeatIdx), A
7792+ CABB FE 04            CP 4
7793+ CABD 28 12            JR Z, .urb1LastBeat
7794+ CABF FE 05            CP 5
7795+ CAC1 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7796+ CAC3                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7797+ CAC3 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7798+ CAC6 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7799+ CAC8 CD CA 6D         CALL AY_PlayBeep
7800+ CACB                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7801+ CACB                  ; (mitad) para mantener ON/OFF ~50/50.
7802+ CACB 3E 14            LD A, 20
7803+ CACD 32 EF 82         LD (PlayerRespawnTimer), A
7804+ CAD0 C9               RET
7805+ CAD1              .urb1LastBeat:
7806+ CAD1                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7807+ CAD1                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7808+ CAD1                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7809+ CAD1                  ; entra grace EXACTAMENTE al terminar el beep.
7810+ CAD1 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7811+ CAD4 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7812+ CAD6 CD CA 6D         CALL AY_PlayBeep
7813+ CAD9 3E 0B            LD A, 11                    ; espera = duracion del beep
7814+ CADB 32 EF 82         LD (PlayerRespawnTimer), A
7815+ CADE C9               RET
7816+ CADF              .urb1AfterBeep:
7817+ CADF                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7818+ CADF                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7819+ CADF CD F8 CA         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7820+ CAE2 3E 0C            LD A, SPAWN_INTERVAL
7821+ CAE4 32 F8 82         LD (SpawnTimer), A
7822+ CAE7 AF               XOR A
7823+ CAE8 32 FD 82         LD (DeathSpawned), A
7824+ CAEB 32 F3 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7825+ CAEE 32 B6 82         LD (TimeFrozen), A              ; Reanudar reloj
7826+ CAF1 21 00 00         LD HL, 0
7827+ CAF4 22 FA 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7828+ CAF7 C9               RET
7829+ CAF8
7830+ CAF8              ; ==============================================================================
7831+ CAF8              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7832+ CAF8              ; ==============================================================================
7833+ CAF8              ; Llamado desde:
7834+ CAF8              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7835+ CAF8              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7836+ CAF8              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7837+ CAF8              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7838+ CAF8              ; ==============================================================================
7839+ CAF8              EnterGracePhase:
7840+ CAF8 3E 02            LD A, 2
7841+ CAFA 32 EE 82         LD (PlayerRespawnPhase), A
7842+ CAFD 3E 19            LD A, RESPAWN_GRACE_FRAMES
7843+ CAFF 32 EF 82         LD (PlayerRespawnTimer), A
7844+ CB02 C9               RET
7845+ CB03
7846+ CB03              ; ==============================================================================
7847+ CB03              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7848+ CB03              ; ==============================================================================
7849+ CB03              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7850+ CB03              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7851+ CB03              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7852+ CB03              ; ==============================================================================
7853+ CB03              UpdateDeathAnim:
7854+ CB03 3A EA 82         LD A, (DeathBorderPhase)
7855+ CB06 FE 01            CP 1
7856+ CB08 C0               RET NZ
7857+ CB09 3A EC 82         LD A, (PlayerDeathAnimTimer)
7858+ CB0C 3D               DEC A
7859+ CB0D 32 EC 82         LD (PlayerDeathAnimTimer), A
7860+ CB10 C0               RET NZ
7861+ CB11                  ; Tick consumido: avanzar frame
7862+ CB11 3A ED 82         LD A, (PlayerDeathAnimFrame)
7863+ CB14 3C               INC A
7864+ CB15 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7865+ CB17 D0               RET NC                              ; ya en ultimo frame (clamp)
7866+ CB18 32 ED 82         LD (PlayerDeathAnimFrame), A
7867+ CB1B DD 21 9E 81      LD IX, EntityTable
7868+ CB1F DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7869+ CB22                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7870+ CB22                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7871+ CB22                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7872+ CB22 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7873+ CB24 20 06            JR NZ, .udaSkipSplatSfx
7874+ CB26 21 C1 F6         LD HL, SFX_EnemyDeath
7875+ CB29 CD 42 F6         CALL PlaySFX
7876+ CB2C              .udaSkipSplatSfx:
7877+ CB2C 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7878+ CB2E 32 EC 82         LD (PlayerDeathAnimTimer), A
7879+ CB31 C9               RET
7880+ CB32
7881+ CB32              ; ==============================================================================
7882+ CB32              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7883+ CB32              ; ==============================================================================
7884+ CB32              UpdateDeathBorder:
7885+ CB32 3A EA 82         LD A, (DeathBorderPhase)
7886+ CB35 B7               OR A
7887+ CB36 C8               RET Z
7888+ CB37 3A EB 82         LD A, (DeathBorderTimer)
7889+ CB3A 3D               DEC A
7890+ CB3B 32 EB 82         LD (DeathBorderTimer), A
7891+ CB3E C0               RET NZ
7892+ CB3F                  ; Timer expiro: avanzar fase
7893+ CB3F 3A EA 82         LD A, (DeathBorderPhase)
7894+ CB42 FE 01            CP 1
7895+ CB44 20 33            JR NZ, .udbToBlack
7896+ CB46                  ; --- Fin fase amarillo ---
7897+ CB46                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7898+ CB46                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7899+ CB46 3A E1 82         LD A, (PlayerLives)
7900+ CB49 B7               OR A
7901+ CB4A 28 1F            JR Z, .udbToGameOver
7902+ CB4C DD 21 9E 81      LD IX, EntityTable
7903+ CB50 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7904+ CB54 3E 02            LD A, 2
7905+ CB56 32 EA 82         LD (DeathBorderPhase), A
7906+ CB59 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7907+ CB5B 32 EB 82         LD (DeathBorderTimer), A
7908+ CB5E 3E 02            LD A, RED
7909+ CB60 32 86 8D         LD (CurrentBorderColor), A
7910+ CB63 D3 FE            OUT (254), A
7911+ CB65                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7912+ CB65                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7913+ CB65 3E 01            LD A, 1
7914+ CB67 32 F7 82         LD (TombDrawPending), A
7915+ CB6A C9               RET
7916+ CB6B              .udbToGameOver:
7917+ CB6B                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7918+ CB6B AF               XOR A
7919+ CB6C 32 EA 82         LD (DeathBorderPhase), A
7920+ CB6F 3E 00            LD A, BLACK
7921+ CB71 32 86 8D         LD (CurrentBorderColor), A
7922+ CB74 D3 FE            OUT (254), A
7923+ CB76 C3 87 CB         JP ShowGameOver
7924+ CB79              .udbToBlack:
7925+ CB79                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7926+ CB79 AF               XOR A
7927+ CB7A 32 EA 82         LD (DeathBorderPhase), A
7928+ CB7D 3E 00            LD A, BLACK
7929+ CB7F 32 86 8D         LD (CurrentBorderColor), A
7930+ CB82 D3 FE            OUT (254), A
7931+ CB84 C3 19 CA         JP RespawnPlayerAtEntry             ; tail-call
7932+ CB87
7933+ CB87              ; ==============================================================================
7934+ CB87              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7935+ CB87              ; ==============================================================================
7936+ CB87              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7937+ CB87              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7938+ CB87              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7939+ CB87              ; ==============================================================================
7940+ CB87              ShowGameOver:
7941+ CB87 3E 01            LD A, 1
7942+ CB89 32 E2 82         LD (GameOver), A
7943+ CB8C C9               RET
7944+ CB8D
7945+ CB8D              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7946+ CB8D              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7947+ CB8D              PaintGameOverScreen:
7948+ CB8D                  ; Wipe pixels
7949+ CB8D 21 00 40         LD HL, $4000
7950+ CB90 11 01 40         LD DE, $4001
7951+ CB93 01 FF 17         LD BC, $17FF
7952+ CB96 36 00            LD (HL), 0
7953+ CB98 ED B0            LDIR
7954+ CB9A                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7955+ CB9A 21 00 58         LD HL, $5800
7956+ CB9D 11 01 58         LD DE, $5801
7957+ CBA0 01 FF 02         LD BC, $02FF
7958+ CBA3 36 47            LD (HL), $47
7959+ CBA5 ED B0            LDIR
7960+ CBA7                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
7961+ CBA7                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
7962+ CBA7 CD 1F 78         CALL DrawTombstone2xCentered
7963+ CBAA                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7964+ CBAA 3E 88            LD A, GAMEOVER_ANIM_X_MAX
7965+ CBAC 32 E3 82         LD (GameOverAnimX), A
7966+ CBAF AF               XOR A
7967+ CBB0 32 E4 82         LD (GameOverAnimDir), A
7968+ CBB3 32 E5 82         LD (GameOverAnimFrame), A
7969+ CBB6 32 E9 82         LD (GameOverAnimLastX), A
7970+ CBB9 21 00 00         LD HL, 0
7971+ CBBC 22 E7 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7972+ CBBF 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7973+ CBC1 32 E6 82         LD (GameOverAnimFrameTimer), A
7974+ CBC4                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7975+ CBC4                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7976+ CBC4                  ; congelado en GameOver=2.
7977+ CBC4 3E 03            LD A, 3
7978+ CBC6 C3 BD 99         JP StartMusic                   ; tail-call
7979+ CBC9
7980+ CBC9              ; ==============================================================================
7981+ CBC9              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7982+ CBC9              ; ==============================================================================
7983+ CBC9              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7984+ CBC9              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7985+ CBC9              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7986+ CBC9              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7987+ CBC9              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7988+ CBC9              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7989+ CBC9              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7990+ CBC9              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7991+ CBC9              ;
7992+ CBC9              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7993+ CBC9              ; shifted (que ocupa 4 chars = 32 px).
7994+ CBC9              ; ==============================================================================
7995+ CBC9              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
7996+ CBC9              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
7997+ CBC9              ; X swing centrado sobre la tumba:
7998+ CBC9              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
7999+ CBC9              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8000+ CBC9              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8001+ CBC9              GAMEOVER_ANIM_Y           EQU 56
8002+ CBC9              GAMEOVER_ANIM_X_MIN       EQU 96
8003+ CBC9              GAMEOVER_ANIM_X_MAX       EQU 136
8004+ CBC9              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8005+ CBC9
8006+ CBC9              UpdateGameOverAnim:
8007+ CBC9                  ; --- Erase del sprite previo (si lo hubo) ---
8008+ CBC9 2A E7 82         LD HL, (GameOverAnimLastSpr)
8009+ CBCC 7C               LD A, H
8010+ CBCD B5               OR L
8011+ CBCE 28 0C            JR Z, .ugoaNoErase
8012+ CBD0 E5               PUSH HL
8013+ CBD1 DD E1            POP IX
8014+ CBD3 3A E9 82         LD A, (GameOverAnimLastX)
8015+ CBD6 5F               LD E, A
8016+ CBD7 16 38            LD D, GAMEOVER_ANIM_Y
8017+ CBD9 CD EA 99         CALL DrawSprite
8018+ CBDC              .ugoaNoErase:
8019+ CBDC
8020+ CBDC                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8021+ CBDC 3A E6 82         LD A, (GameOverAnimFrameTimer)
8022+ CBDF 3D               DEC A
8023+ CBE0 20 0A            JR NZ, .ugoaTimerSet
8024+ CBE2 3A E5 82         LD A, (GameOverAnimFrame)
8025+ CBE5 EE 01            XOR 1
8026+ CBE7 32 E5 82         LD (GameOverAnimFrame), A
8027+ CBEA 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8028+ CBEC              .ugoaTimerSet:
8029+ CBEC 32 E6 82         LD (GameOverAnimFrameTimer), A
8030+ CBEF
8031+ CBEF                  ; --- Avanzar X segun direccion (ping-pong) ---
8032+ CBEF 3A E4 82         LD A, (GameOverAnimDir)
8033+ CBF2 B7               OR A
8034+ CBF3 20 14            JR NZ, .ugoaSlideRight
8035+ CBF5                  ; Dir 0: facing R, slide LEFT (X--)
8036+ CBF5 3A E3 82         LD A, (GameOverAnimX)
8037+ CBF8 FE 60            CP GAMEOVER_ANIM_X_MIN
8038+ CBFA 28 06            JR Z, .ugoaFlipToL
8039+ CBFC 3D               DEC A
8040+ CBFD 32 E3 82         LD (GameOverAnimX), A
8041+ CC00 18 18            JR .ugoaPickSprite
8042+ CC02              .ugoaFlipToL:
8043+ CC02 3E 01            LD A, 1
8044+ CC04 32 E4 82         LD (GameOverAnimDir), A
8045+ CC07 18 11            JR .ugoaPickSprite
8046+ CC09              .ugoaSlideRight:
8047+ CC09                  ; Dir 1: facing L, slide RIGHT (X++)
8048+ CC09 3A E3 82         LD A, (GameOverAnimX)
8049+ CC0C FE 88            CP GAMEOVER_ANIM_X_MAX
8050+ CC0E 28 06            JR Z, .ugoaFlipToR
8051+ CC10 3C               INC A
8052+ CC11 32 E3 82         LD (GameOverAnimX), A
8053+ CC14 18 04            JR .ugoaPickSprite
8054+ CC16              .ugoaFlipToR:
8055+ CC16 AF               XOR A
8056+ CC17 32 E4 82         LD (GameOverAnimDir), A
8057+ CC1A
8058+ CC1A              .ugoaPickSprite:
8059+ CC1A                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8060+ CC1A                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8061+ CC1A                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8062+ CC1A 3A E4 82         LD A, (GameOverAnimDir)
8063+ CC1D B7               OR A
8064+ CC1E 20 0E            JR NZ, .ugoaPickR
8065+ CC20 3A E5 82         LD A, (GameOverAnimFrame)
8066+ CC23 B7               OR A
8067+ CC24 21 DF DD         LD HL, SprDeath_L0
8068+ CC27 28 11            JR Z, .ugoaSprSet
8069+ CC29 21 29 DE         LD HL, SprDeath_L1
8070+ CC2C 18 0C            JR .ugoaSprSet
8071+ CC2E              .ugoaPickR:
8072+ CC2E 3A E5 82         LD A, (GameOverAnimFrame)
8073+ CC31 B7               OR A
8074+ CC32 21 4B DD         LD HL, SprDeath_0
8075+ CC35 28 03            JR Z, .ugoaSprSet
8076+ CC37 21 95 DD         LD HL, SprDeath_1
8077+ CC3A              .ugoaSprSet:
8078+ CC3A 22 E7 82         LD (GameOverAnimLastSpr), HL
8079+ CC3D 3A E3 82         LD A, (GameOverAnimX)
8080+ CC40 32 E9 82         LD (GameOverAnimLastX), A
