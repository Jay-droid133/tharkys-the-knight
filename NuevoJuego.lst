3438+ B569 22 51 B6         LD (.moSelfAddr), HL
3439+ B56C                  ; Iterar los slots de monsters
3440+ B56C DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
3441+ B570 06 03            LD B, MONSTERS_TO_SPAWN
3442+ B572              .moOvLoop:
3443+ B572                  ; Saltar si es el mismo slot
3444+ B572 DD E5            PUSH IX
3445+ B574 E1               POP HL
3446+ B575 ED 5B 51 B6      LD DE, (.moSelfAddr)
