 580+ F0D5 7A               LD A, D
 581+ F0D6 84               ADD A, H
 582+ F0D7 32 CA F1         LD (.dcDistance), A
 583+ F0DA
 584+ F0DA                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F0DA                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F0DA                  ; Sprite_Compass_Magic (no oscila); el wobble logic solo gastaría CPU
 587+ F0DA                  ; durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F0DA                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F0DA                  ; cuando el frame de transición está apretado.
 590+ F0DA 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F0DD 47               LD B, A
 592+ F0DE 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F0E1 B0               OR B
 594+ F0E2 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F0E4 AF               XOR A
 596+ F0E5 32 C0 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F0E8 18 53            JR .dcWobbleEnd
 598+ F0EA              .dcWobbleStartNormal:
 599+ F0EA                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F0EA                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F0EA                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F0EA                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F0EA                  ; nuevo idx.
 604+ F0EA                  ; Counter == 0 -> sin override, idx = target.
 605+ F0EA 3A C9 F1         LD A, (.dcSpriteIdx)
 606+ F0ED FE 04            CP 4
 607+ F0EF 20 06            JR NZ, .dcWobbleNotX
 608+ F0F1                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F0F1                  ; frame no redibuje innecesariamente.
 610+ F0F1 AF               XOR A
 611+ F0F2 32 C0 82         LD (CompassWobbleCounter), A
 612+ F0F5 18 46            JR .dcWobbleEnd
 613+ F0F7              .dcWobbleNotX:
 614+ F0F7                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F0F7 3A 0B 83         LD A, (CurrentScreenX)
 616+ F0FA 47               LD B, A
 617+ F0FB 3A BE 82         LD A, (LastCompassScreenX)
 618+ F0FE B8               CP B
 619+ F0FF 20 0A            JR NZ, .dcWobbleStart
 620+ F101 3A 0C 83         LD A, (CurrentScreenY)
 621+ F104 47               LD B, A
 622+ F105 3A BF 82         LD A, (LastCompassScreenY)
 623+ F108 B8               CP B
 624+ F109 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F10B              .dcWobbleStart:
 626+ F10B 3E 09            LD A, 9
 627+ F10D 32 C0 82         LD (CompassWobbleCounter), A
 628+ F110              .dcWobbleResolve:
 629+ F110 3A C0 82         LD A, (CompassWobbleCounter)
 630+ F113 B7               OR A
 631+ F114 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F116 3D               DEC A
 633+ F117 32 C0 82         LD (CompassWobbleCounter), A
 634+ F11A                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F11A 21 2A F6         LD HL, WobblePhaseTable
 636+ F11D 5F               LD E, A
 637+ F11E 16 00            LD D, 0
 638+ F120 19               ADD HL, DE
 639+ F121 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F122 FE 02            CP 2
 641+ F124 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F126                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F126                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F126 FE 03            CP 3
 645+ F128 38 01            JR C, .dcWobbleOffsetReady
 646+ F12A 3D               DEC A
 647+ F12B              .dcWobbleOffsetReady:
 648+ F12B 5F               LD E, A
 649+ F12C 3A C9 F1         LD A, (.dcSpriteIdx)
 650+ F12F 87               ADD A, A                            ; idx*2
 651+ F130 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F131 83               ADD A, E                            ; +offset
 653+ F132 21 06 F6         LD HL, CompassWobbleTable
 654+ F135 5F               LD E, A
 655+ F136 16 00            LD D, 0
 656+ F138 19               ADD HL, DE
 657+ F139 7E               LD A, (HL)
 658+ F13A 32 C9 F1         LD (.dcSpriteIdx), A                ; override
 659+ F13D
 660+ F13D              .dcWobbleEnd:
 661+ F13D
 662+ F13D                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F13D                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F13D                  ; sin bright + char activo white bright; en warning el char activo
 665+ F13D                  ; parpadea bright on/off a ~6 Hz).
 666+ F13D                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F13D                  ; blanca se mantiene tal cual.
 668+ F13D 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F140 47               LD B, A
 670+ F141 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F144 B0               OR B
 672+ F145 28 29            JR Z, .dcMagicOff
 673+ F147 3A C9 F1         LD A, (.dcSpriteIdx)
 674+ F14A FE 04            CP 4
 675+ F14C 28 22            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F14E 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F151 FE FF            CP $FF
 678+ F153 28 1B            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F155                  ; --- MAGIC HUD ---
 680+ F155                  ; Cache: el sprite Sprite_Compass_Magic es siempre el mismo; sólo se
 681+ F155                  ; redibuja cuando cambia PathDir (o no estaba dibujado todavía). El
 682+ F155                  ; resto de frames basta con repintar los 4 attrs (ultra-barato), lo que
 683+ F155                  ; libera CPU durante el wobble post-transición y evita que las agujas
 684+ F155                  ; del reloj queden parcialmente actualizadas en frames con poco margen.
 685+ F155 3A C1 5F         LD A, (MagicCompassPathDir)
 686+ F158 47               LD B, A
 687+ F159 3A CC 5F         LD A, (LastMagicCompassDrawn)
 688+ F15C B8               CP B
 689+ F15D 28 0C            JR Z, .dcMagicAttrsOnly             ; mismo path → solo attrs
 690+ F15F 11 0A 7A         LD DE, Sprite_Compass_Magic
 691+ F162 CD CC F1         CALL DrawCompassSprite
 692+ F165 3A C1 5F         LD A, (MagicCompassPathDir)
 693+ F168 32 CC 5F         LD (LastMagicCompassDrawn), A
 694+ F16B              .dcMagicAttrsOnly:
 695+ F16B CD 19 77         CALL PaintMagicCompassAttrs
 696+ F16E 18 40            JR .dcDrawDone
 697+ F170
 698+ F170              .dcMagicOff:
 699+ F170                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 700+ F170                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 701+ F170 3E FF            LD A, $FF
 702+ F172 32 CC 5F         LD (LastMagicCompassDrawn), A
 703+ F175
 704+ F175                  ; --- Color normal ---
 705+ F175                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 706+ F175 3A C9 F1         LD A, (.dcSpriteIdx)
 707+ F178 FE 04            CP 4
 708+ F17A 28 18            JR Z, .dcWhite
 709+ F17C 3A BD 82         LD A, (PreviousObjectiveDistance)
 710+ F17F FE FF            CP $FF
 711+ F181 28 11            JR Z, .dcWhite
 712+ F183 47               LD B, A
 713+ F184 3A CA F1         LD A, (.dcDistance)
 714+ F187 B8               CP B
 715+ F188 28 0A            JR Z, .dcWhite                      ; igual = blanco
 716+ F18A 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 717+ F18C 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 718+ F18E 18 06            JR .dcColorDone
 719+ F190              .dcGreen:
 720+ F190 3E 44            LD A, GREEN | $40
 721+ F192 18 02            JR .dcColorDone
 722+ F194              .dcWhite:
 723+ F194 3E 47            LD A, WHITE | $40
 724+ F196              .dcColorDone:
 725+ F196 32 CB F1         LD (.dcAttr), A
 726+ F199
 727+ F199                  ; --- Sprite ptr de CompassSprites[idx] ---
 728+ F199 3A C9 F1         LD A, (.dcSpriteIdx)
 729+ F19C 87               ADD A, A                            ; *2
 730+ F19D 6F               LD L, A
 731+ F19E 26 00            LD H, 0
