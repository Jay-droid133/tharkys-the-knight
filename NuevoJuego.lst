2058+ AA57              ; ==============================================================================
2059+ AA57              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2060+ AA57              ; ==============================================================================
2061+ AA57              UpdateStamina:
2062+ AA57                  ; --- Regenerar salud (1 unidad cada HEALTH_REGEN_RATE = 100 f = 4 s) ---
2063+ AA57 3A 55 B3         LD A, (PlayerHealth)
2064+ AA5A FE 10            CP HEALTH_MAX
2065+ AA5C 28 12            JR Z, .usHealthFull
2066+ AA5E 21 59 B3         LD HL, HealthRegenCtr
2067+ AA61 34               INC (HL)
2068+ AA62 7E               LD A, (HL)
2069+ AA63 FE 64            CP HEALTH_REGEN_RATE
2070+ AA65 38 09            JR C, .usHealthFull
2071+ AA67 36 00            LD (HL), 0
2072+ AA69 3A 55 B3         LD A, (PlayerHealth)
2073+ AA6C 3C               INC A
2074+ AA6D 32 55 B3         LD (PlayerHealth), A
2075+ AA70              .usHealthFull:
