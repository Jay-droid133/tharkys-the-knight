 601+ D4B0              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 602+ D4B0              ; A = codigo ASCII, E = columna (0-31)
 603+ D4B0              DrawHudCharRow0:
 604+ D4B0 6F               LD L, A
 605+ D4B1 26 00            LD H, 0
 606+ D4B3 29               ADD HL, HL
 607+ D4B4 29               ADD HL, HL
 608+ D4B5 29               ADD HL, HL
 609+ D4B6 01 00 3C         LD BC, $3C00
 610+ D4B9 09               ADD HL, BC                  ; HL = font data
 611+ D4BA 16 40            LD D, $40                   ; Tercio 0, scan line 0
 612+ D4BC 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 613+ D4BD 5F               LD E, A                     ; DE = dir VRAM
 614+ D4BE 06 08            LD B, 8
