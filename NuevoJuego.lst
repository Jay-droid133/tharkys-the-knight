2534+ B031 C9               RET
2535+ B032
2536+ B032 00           .savedEX: DEFB 0
2537+ B033 00           .savedEY: DEFB 0
2538+ B034
2539+ B034              ; ==============================================================================
2540+ B034              ; ==============================================================================
2541+ B034              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2542+ B034              ; ==============================================================================
2543+ B034              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2544+ B034              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2545+ B034              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2546+ B034              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2547+ B034              ; ==============================================================================
2548+ B034              UpdateMonster:
2549+ B034                  ; --- Stun: knockback + pausa tras golpe del player ---
2550+ B034 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2551+ B037 B7               OR A
2552+ B038 CA 6D B2         JP Z, .moNormal
2553+ B03B DD 35 0A         DEC (IX+ENT_DIR)
2554+ B03E 20 0B            JR NZ, .moStunActive
2555+ B040                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2556+ B040 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2557+ B044 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2558+ B048 C3 6D B2         JP .moNormal
2559+ B04B
2560+ B04B              .moStunActive:
2561+ B04B                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2562+ B04B FE 06            CP MONSTER_STUN_PAUSE
2563+ B04D DA F7 B3         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2564+ B050                  ; Knockback: aplicar movimiento con collision check
2565+ B050 DD 56 06         LD D, (IX+ENT_DELTAX)
2566+ B053 DD 5E 07         LD E, (IX+ENT_DELTAY)
2567+ B056 7A               LD A, D
2568+ B057 B3               OR E
2569+ B058 CA F7 B3         JP Z, .moAnimate
2570+ B05B                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2571+ B05B D5               PUSH DE
2572+ B05C DD 7E 03         LD A, (IX+ENT_POSX)
2573+ B05F 32 88 B5         LD (.moSvX), A
2574+ B062 DD 7E 04         LD A, (IX+ENT_POSY)
2575+ B065 32 89 B5         LD (.moSvY), A
2576+ B068                  ; Calcular nueva posicion
2577+ B068 DD 7E 03         LD A, (IX+ENT_POSX)
2578+ B06B 82               ADD A, D
2579+ B06C DD 77 03         LD (IX+ENT_POSX), A
2580+ B06F DD 7E 04         LD A, (IX+ENT_POSY)
2581+ B072 83               ADD A, E
2582+ B073 DD 77 04         LD (IX+ENT_POSY), A
2583+ B076                  ; Comprobar bordes ANTES de colision con paredes
2584+ B076 DD 7E 03         LD A, (IX+ENT_POSX)
2585+ B079 FE E8            CP SCREEN_MAX_X
2586+ B07B 30 30            JR NC, .moKbPreOffscreen
2587+ B07D FE 04            CP MONSTER_KB_SPEED
2588+ B07F 38 20            JR C, .moKbPreOffscreenMaybeX
2589+ B081              .moKbPreBorderXOk:
2590+ B081 DD 7E 04         LD A, (IX+ENT_POSY)
2591+ B084 FE A8            CP SCREEN_MAX_Y
2592+ B086 30 25            JR NC, .moKbPreOffscreen
2593+ B088 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2594+ B08A 38 1B            JR C, .moKbPreOffscreenMaybeY
2595+ B08C              .moKbPreBorderOk:
2596+ B08C                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2597+ B08C                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2598+ B08C                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2599+ B08C                  ; CheckEnemyCollision.
2600+ B08C                  ; CheckChurchTrap retorna:
2601+ B08C                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2602+ B08C                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2603+ B08C                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2604+ B08C CD 7F EB         CALL CheckChurchTrap
2605+ B08F B7               OR A
2606+ B090 28 07            JR Z, .moKbCollCheck
2607+ B092 FE 02            CP 2
2608+ B094 CA 45 B1         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2609+ B097 D1               POP DE                              ; limpiar PUSH DE previo
2610+ B098 C9               RET                                 ; cutscene activa, salir
2611+ B099              .moKbCollCheck:
2612+ B099                  ; Dentro de pantalla: comprobar colision con paredes
2613+ B099 CD 04 B9         CALL CheckEnemyCollision
2614+ B09C C2 45 B1         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2615+ B09F 18 1C            JR .moKbNotBlocked
2616+ B0A1              .moKbPreOffscreenMaybeX:
2617+ B0A1 CB 7A            BIT 7, D
2618+ B0A3 20 08            JR NZ, .moKbPreOffscreen
2619+ B0A5 18 DA            JR .moKbPreBorderXOk
2620+ B0A7              .moKbPreOffscreenMaybeY:
2621+ B0A7 CB 7B            BIT 7, E
2622+ B0A9 20 02            JR NZ, .moKbPreOffscreen
2623+ B0AB 18 DF            JR .moKbPreBorderOk
2624+ B0AD              .moKbPreOffscreen:
2625+ B0AD                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2626+ B0AD 3A 88 B5         LD A, (.moSvX)
2627+ B0B0 DD 77 03         LD (IX+ENT_POSX), A
2628+ B0B3 3A 89 B5         LD A, (.moSvY)
2629+ B0B6 DD 77 04         LD (IX+ENT_POSY), A
2630+ B0B9 D1               POP DE
2631+ B0BA C3 AA B1         JP .moKbOffscreen
2632+ B0BD              .moKbNotBlocked:
2633+ B0BD                  ; Pared libre: comprobar impacto con otro monster (billar)
2634+ B0BD CD 89 B4         CALL .moCheckOverlap
2635+ B0C0 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2636+ B0C2                  ; Libre: restaurar pos y aplicar movimiento
2637+ B0C2 3A 88 B5         LD A, (.moSvX)
2638+ B0C5 DD 77 03         LD (IX+ENT_POSX), A
2639+ B0C8 3A 89 B5         LD A, (.moSvY)
2640+ B0CB DD 77 04         LD (IX+ENT_POSY), A
2641+ B0CE D1               POP DE
2642+ B0CF C3 81 B1         JP .moKbApply
2643+ B0D2              .moKbBilliard:
2644+ B0D2                  ; Billar: A para en su sitio, B hereda la fuerza
2645+ B0D2 3A 88 B5         LD A, (.moSvX)
2646+ B0D5 DD 77 03         LD (IX+ENT_POSX), A
2647+ B0D8 3A 89 B5         LD A, (.moSvY)
2648+ B0DB DD 77 04         LD (IX+ENT_POSY), A
2649+ B0DE D1               POP DE
2650+ B0DF                  ; Transferir knockback al monster impactado
2651+ B0DF DD E5            PUSH IX
2652+ B0E1 DD 2A 92 B5      LD IX, (.moHitMonster)
2653+ B0E5                  ; Solo transferir si no esta ya en stun
2654+ B0E5 DD 7E 0A         LD A, (IX+ENT_DIR)
2655+ B0E8 B7               OR A
2656+ B0E9 20 2A            JR NZ, .moKbBilliardDone
2657+ B0EB                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2658+ B0EB 7A               LD A, D
2659+ B0EC B7               OR A
2660+ B0ED 28 0D            JR Z, .moBillNoX
2661+ B0EF CB 7A            BIT 7, D
2662+ B0F1 20 04            JR NZ, .moBillXNeg
2663+ B0F3 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2664+ B0F5 18 02            JR .moBillSetX
2665+ B0F7              .moBillXNeg:
2666+ B0F7 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2667+ B0F9              .moBillSetX:
2668+ B0F9 DD 77 06         LD (IX+ENT_DELTAX), A
2669+ B0FC              .moBillNoX:
2670+ B0FC 7B               LD A, E
2671+ B0FD B7               OR A
2672+ B0FE 28 0D            JR Z, .moBillNoY
2673+ B100 CB 7B            BIT 7, E
2674+ B102 20 04            JR NZ, .moBillYNeg
2675+ B104 3E 03            LD A, MONSTER_KB_SPEED - 1
2676+ B106 18 02            JR .moBillSetY
2677+ B108              .moBillYNeg:
2678+ B108 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2679+ B10A              .moBillSetY:
2680+ B10A DD 77 07         LD (IX+ENT_DELTAY), A
2681+ B10D              .moBillNoY:
2682+ B10D DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2683+ B111                  ; Kb heredado por billar: NO es directo del player.
2684+ B111                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2685+ B111 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2686+ B115              .moKbBilliardDone:
2687+ B115 DD E1            POP IX
2688+ B117                  ; A continua con fuerza reducida (no para del todo)
2689+ B117                  ; Reducir velocidad de A a la mitad
2690+ B117 DD 7E 06         LD A, (IX+ENT_DELTAX)
2691+ B11A CB 2F            SRA A                               ; /2 con signo
2692+ B11C DD 77 06         LD (IX+ENT_DELTAX), A
2693+ B11F 57               LD D, A
2694+ B120 DD 7E 07         LD A, (IX+ENT_DELTAY)
2695+ B123 CB 2F            SRA A
2696+ B125 DD 77 07         LD (IX+ENT_DELTAY), A
2697+ B128 5F               LD E, A
