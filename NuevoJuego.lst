 194+ 64B0              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 195+ 64B0              ; ==============================================================================
 196+ 64B0              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 197+ 64B0              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
