 202+ A213              ; ==============================================================================
 203+ A213              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ A213              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ A213              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ A213              ; no parecer que se hunde en el techo.
 207+ A213              ; Preserva: IX. Destruye: AF, BC.
 208+ A213              ; ==============================================================================
 209+ A213              ComputeEnemyDrawY:
 210+ A213 DD 7E 04         LD A, (IX+ENT_POSY)
 211+ A216 32 6F 82         LD (EnemyDrawY), A          ; default = POSY
 212+ A219 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ A21C FE 02            CP TYPE_MONSTER
 214+ A21E C0               RET NZ                      ; no monster → sin offset
 215+ A21F DD 7E 03         LD A, (IX+ENT_POSX)
 216+ A222 C6 08            ADD A, 8                    ; center X
 217+ A224 47               LD B, A
 218+ A225 DD 7E 04         LD A, (IX+ENT_POSY)
 219+ A228 4F               LD C, A
 220+ A229 B7               OR A
 221+ A22A C8               RET Z
 222+ A22B 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ A22C CD B5 D7         CALL IsPointBlocked
 224+ A22F C8               RET Z                       ; libre → sin offset
 225+ A230 DD 7E 04         LD A, (IX+ENT_POSY)
 226+ A233 3C               INC A
 227+ A234 32 6F 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ A237 C9               RET
