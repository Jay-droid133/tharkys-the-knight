 279+ 887E              ; ==============================================================================
 280+ 887E              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 281+ 887E              ; ==============================================================================
 282+ 887E              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 283+ 887E              ; Se llama ANTES de pintar el sprite.
 284+ 887E              ;
 285+ 887E              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 286+ 887E              ;          IX = puntero al sprite (para leer width/height)
 287+ 887E              ; ==============================================================================
 288+ 887E              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 289+ 887E              ; ==============================================================================
 290+ 887E              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 291+ 887E              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 292+ 887E              ; ==============================================================================
 293+ 887E              CalcEntityAttrSize:
 294+ 887E DD 7E 00         LD A, (IX+0)                ; width_bytes
 295+ 8881 47               LD B, A
 296+ 8882 7B               LD A, E
 297+ 8883 E6 07            AND 7
 298+ 8885 28 01            JR Z, .ceNoExtra
 299+ 8887 04               INC B
 300+ 8888              .ceNoExtra:
 301+ 8888 78               LD A, B
 302+ 8889 32 0F 89         LD (EntityAttrW), A
 303+ 888C 7A               LD A, D
 304+ 888D E6 07            AND 7
 305+ 888F 4F               LD C, A
 306+ 8890 DD 7E 01         LD A, (IX+1)                ; height_pixels
 307+ 8893 81               ADD A, C
 308+ 8894 C6 07            ADD A, 7
 309+ 8896 0F               RRCA
 310+ 8897 0F               RRCA
 311+ 8898 0F               RRCA
 312+ 8899 E6 1F            AND $1F
 313+ 889B 32 10 89         LD (EntityAttrH), A
 314+ 889E C9               RET
 315+ 889F
 316+ 889F              ; ==============================================================================
 317+ 889F              SaveEntityAttr:
 318+ 889F                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 319+ 889F DD 7E 00         LD A, (IX+0)                ; width_bytes
 320+ 88A2 47               LD B, A
 321+ 88A3 7B               LD A, E                     ; X pixel (raw)
 322+ 88A4 E6 07            AND 7
 323+ 88A6 28 01            JR Z, .noExtraW
 324+ 88A8 04               INC B                       ; +1 columna si no alineado
 325+ 88A9              .noExtraW:
 326+ 88A9 78               LD A, B
 327+ 88AA 32 0F 89         LD (EntityAttrW), A
 328+ 88AD
 329+ 88AD                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 330+ 88AD 7A               LD A, D                     ; Y pixel (raw)
 331+ 88AE E6 07            AND 7                       ; Y offset dentro del char
 332+ 88B0 4F               LD C, A
 333+ 88B1 DD 7E 01         LD A, (IX+1)                ; height_pixels
 334+ 88B4 81               ADD A, C                    ; + Y offset
 335+ 88B5 C6 07            ADD A, 7
 336+ 88B7 0F               RRCA
 337+ 88B8 0F               RRCA
 338+ 88B9 0F               RRCA
 339+ 88BA E6 1F            AND $1F                     ; / 8 = height_chars
 340+ 88BC 32 10 89         LD (EntityAttrH), A
 341+ 88BF
 342+ 88BF CD 79 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 343+ 88C2 11 FF 88         LD DE, EntitySavedAttr      ; DE = buffer destino
 344+ 88C5
 345+ 88C5 3A 10 89         LD A, (EntityAttrH)
 346+ 88C8 4F               LD C, A                     ; C = filas
 347+ 88C9              .saveRow:
 348+ 88C9 3A 0F 89         LD A, (EntityAttrW)
