1423+ F5C7              ; ==============================================================================
1424+ F5C7              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1425+ F5C7              ; ==============================================================================
1426+ F5C7              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1427+ F5C7              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1428+ F5C7              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1429+ F5C7              ; ==============================================================================
1430+ F5C7              ChurchCutsceneInitStatueShake:
1431+ F5C7 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1432+ F5CA 21 B0 64         LD HL, StatueIdTable
1433+ F5CD 5F               LD E, A
1434+ F5CE 16 00            LD D, 0
1435+ F5D0 19               ADD HL, DE
1436+ F5D1 7E               LD A, (HL)                              ; A = statue id
1437+ F5D2 B7               OR A
1438+ F5D3 C8               RET Z                                   ; sin estatua
1439+ F5D4 32 04 F6         LD (.cisTargetId), A
1440+ F5D7                  ; Buscar en CurrentScreenBuffer
1441+ F5D7 2A 12 83         LD HL, (CurrentScreenAddr)
1442+ F5DA              .cisLoop:
1443+ F5DA 7E               LD A, (HL)
1444+ F5DB FE FF            CP $FF
1445+ F5DD C8               RET Z                                   ; no encontrada (no se hace shake)
1446+ F5DE 47               LD B, A
1447+ F5DF 3A 04 F6         LD A, (.cisTargetId)
1448+ F5E2 B8               CP B
1449+ F5E3 28 06            JR Z, .cisFound
1450+ F5E5 11 04 00         LD DE, 4
1451+ F5E8 19               ADD HL, DE
1452+ F5E9 18 EF            JR .cisLoop
1453+ F5EB              .cisFound:
1454+ F5EB 23               INC HL
1455+ F5EC 7E               LD A, (HL)                              ; charX
1456+ F5ED                  ; Pixel X = charX * 8
1457+ F5ED 87               ADD A, A
1458+ F5EE 87               ADD A, A
1459+ F5EF 87               ADD A, A
1460+ F5F0 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1461+ F5F3 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1462+ F5F6 23               INC HL
1463+ F5F7 7E               LD A, (HL)                              ; charY
1464+ F5F8                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1465+ F5F8 C6 02            ADD A, BG_Y_OFFSET
1466+ F5FA 87               ADD A, A
1467+ F5FB 87               ADD A, A
1468+ F5FC 87               ADD A, A
1469+ F5FD 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1470+ F600 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1471+ F603 C9               RET
