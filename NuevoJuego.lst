 434+ 6F17 ~              RLCA
 434+ 6F17 ~              RLCA
 435+ 6F17 ~                LD HL, ObjectiveScreenX
 436+ 6F17 ~                ADD A, (HL)
 437+ 6F17 ~                LD (.cmcpTgtSid), A
