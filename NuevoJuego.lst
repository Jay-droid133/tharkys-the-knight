2408+ D8BE                  ; (action ya está en .cbtAction; BC libre para usar como dimensiones)
2409+ D8BE EB               EX DE, HL                       ; HL = sprite ptr
2410+ D8BF 3E 03            LD A, 3                         ; PickupTable ptrs viven en bank 3
2411+ D8C1 CD CA 67         CALL LoadBgSpriteToBuffer
2412+ D8C4 21 EE 86         LD HL, BgSpriteBuffer
2413+ D8C7 7E               LD A, (HL)                      ; height_px
2414+ D8C8 32 FD D9         LD (.cbtSpH), A
2415+ D8CB 23               INC HL
2416+ D8CC 7E               LD A, (HL)
2417+ D8CD E6 7F            AND $7F
2418+ D8CF 87               ADD A, A                        ; *2
2419+ D8D0 87               ADD A, A                        ; *4
2420+ D8D1 87               ADD A, A                        ; *8 = width_px
2421+ D8D2 32 FC D9         LD (.cbtSpW), A
2422+ D8D5                  ; Recuperar charX/charY de la entry (POP HL → entry ptr_lo, +2 = charX)
2423+ D8D5 E1               POP HL                          ; HL en ptr_lo
2424+ D8D6 E5               PUSH HL                         ; volver a guardar para el handler
2425+ D8D7 23               INC HL
2425+ D8D8 23             INC HL                 ; skip ptr
2426+ D8D9 7E               LD A, (HL)                      ; charX
