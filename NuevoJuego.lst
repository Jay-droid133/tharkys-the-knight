 100+ DE4F              ; Timings (frames a 50 Hz). Ajustables sin tocar logica.
 101+ DE4F              ; ==============================================================================
 102+ DE4F              BCS_T_LOCK              EQU 30      ; 1.2s lock inicial
 103+ DE4F              BCS_T_KNOCK_HIT         EQU 4       ; cada hit (door shake + sfx) — was 6
 104+ DE4F              BCS_T_KNOCK_GAP         EQU 5       ; gap entre toques — was 8
 105+ DE4F              BCS_T_GROUP_WAIT        EQU 50      ; 2s espera silenciosa tras cada grupo
 106+ DE4F              BCS_T_TURN_CAM          EQU 40      ; 1.6s mid-cutscene mirando camara
 107+ DE4F              BCS_T_TURN_BACK         EQU 10      ; transicion rapida de vuelta
 108+ DE4F              BCS_T_PRE_HAND          EQU 30      ; pausa tras los 6 toques antes de la mano
 109+ DE4F              BCS_T_PRE_HAND_HOLD     EQU 20      ; hold corto antes de hacer aparecer la mano
 110+ DE4F              BCS_T_HAND_IN           EQU 20      ; pause tras aparecer mano
 111+ DE4F              BCS_T_NO_FRAME          EQU 12      ; cada swap de "no no"
 112+ DE4F              BCS_T_HAND_HOLD         EQU 15      ; pausa tras ultimo swap
