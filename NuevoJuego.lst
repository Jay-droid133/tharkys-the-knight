 732+ A258 06 00            LD B, 0
 733+ A25A 0E FF            LD C, -1
 734+ A25C 18 0A            JR .peShakeApply
 735+ A25E              .peShakeDown:
 736+ A25E 06 00            LD B, 0
 737+ A260 0E 01            LD C, 1
 738+ A262 18 04            JR .peShakeApply
 739+ A264              .peShakeLeft:
 740+ A264 06 FF            LD B, -1
 741+ A266 0E 00            LD C, 0
 742+ A268              .peShakeApply:
 743+ A268                  ; new POSX = orig + B, new POSY = orig + C
 744+ A268 21 97 5F         LD HL, MonsterShakeOrigX
 745+ A26B 19               ADD HL, DE
 746+ A26C 7E               LD A, (HL)
 747+ A26D 80               ADD A, B
 748+ A26E DD 77 03         LD (IX+ENT_POSX), A
 749+ A271 21 9A 5F         LD HL, MonsterShakeOrigY
