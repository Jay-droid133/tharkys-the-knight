 639+ 7F88 3A 81 7F         LD A, (BellVolC)
 640+ 7F8B B0               OR B
 641+ 7F8C 47               LD B, A
 642+ 7F8D 3A 82 7F         LD A, (BellVolR)
 643+ 7F90 B0               OR B
 644+ 7F91 C8               RET Z                           ; los 3 a 0 -> silenciada
 645+ 7F92
 646+ 7F92 21 83 7F         LD HL, BellDecayTimer
 647+ 7F95 35               DEC (HL)
 648+ 7F96 C0               RET NZ                          ; aun no toca decrementar
 649+ 7F97
 650+ 7F97 3E 02            LD A, BELL_DECAY_RATE
 651+ 7F99 32 83 7F         LD (BellDecayTimer), A
 652+ 7F9C
 653+ 7F9C                  ; Decrementar canal A (R8) si > 0
 654+ 7F9C 3A 80 7F         LD A, (BellVolL)
 655+ 7F9F B7               OR A
 656+ 7FA0 28 0A            JR Z, .btiSkipA
 657+ 7FA2 3D               DEC A
