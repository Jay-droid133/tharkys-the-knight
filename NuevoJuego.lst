7145+ CA38              ; ==============================================================================
7146+ CA38              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7147+ CA38              ; ==============================================================================
7148+ CA38              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7149+ CA38              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7150+ CA38              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7151+ CA38              ; el primer paso (N/S/W/E) desde el inicio.
7152+ CA38              ;
7153+ CA38              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7154+ CA38              ; consistente con CheckEnemyCollision en cell-aligned positions).
7155+ CA38              ;
7156+ CA38              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7157+ CA38              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7158+ CA38              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7159+ CA38              ; paso pero permite llegar a una celda mas profunda con dist menor).
7160+ CA38              ;
7161+ CA38              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7162+ CA38              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7163+ CA38              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7164+ CA38              ;
7165+ CA38              ; IX = SLOT_DEATH al entrar.
7166+ CA38              ; ==============================================================================
7167+ CA38              DeathBfsRescue:
7168+ CA38                  ; --- Celda inicial = celda actual de Death ---
7169+ CA38 DD 7E 03         LD A, (IX+ENT_POSX)
7170+ CA3B 0F               RRCA
7171+ CA3C 0F               RRCA
7172+ CA3D 0F               RRCA
7173+ CA3E E6 1F            AND $1F
7174+ CA40 32 74 5F         LD (DBfsCurCx), A
7175+ CA43 DD 7E 04         LD A, (IX+ENT_POSY)
7176+ CA46 D6 10            SUB SCREEN_MIN_Y
7177+ CA48 0F               RRCA
7178+ CA49 0F               RRCA
7179+ CA4A 0F               RRCA
7180+ CA4B E6 1F            AND $1F
7181+ CA4D 32 75 5F         LD (DBfsCurCy), A
7182+ CA50                  ; --- Celda del player ---
7183+ CA50 3A 4E 81         LD A, (EntityTable + ENT_POSX)
7184+ CA53 0F               RRCA
7185+ CA54 0F               RRCA
7186+ CA55 0F               RRCA
7187+ CA56 E6 1F            AND $1F
7188+ CA58 32 72 5F         LD (DBfsPlayerCx), A
7189+ CA5B 3A 4F 81         LD A, (EntityTable + ENT_POSY)
7190+ CA5E D6 10            SUB SCREEN_MIN_Y
7191+ CA60 0F               RRCA
7192+ CA61 0F               RRCA
7193+ CA62 0F               RRCA
7194+ CA63 E6 1F            AND $1F
7195+ CA65 32 73 5F         LD (DBfsPlayerCy), A
7196+ CA68                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7197+ CA68 21 FF 5E         LD HL, DBfsQueue
7198+ CA6B 22 6B 5F         LD (DBfsQHead), HL
7199+ CA6E 3A 74 5F         LD A, (DBfsCurCx)
7200+ CA71 77               LD (HL), A
7201+ CA72 23               INC HL
7202+ CA73 3A 75 5F         LD A, (DBfsCurCy)
7203+ CA76 77               LD (HL), A
7204+ CA77 23               INC HL
7205+ CA78 36 FF            LD (HL), MAI_DIR_NONE
7206+ CA7A 23               INC HL
7207+ CA7B 36 00            LD (HL), 0
7208+ CA7D 23               INC HL
7209+ CA7E 22 6D 5F         LD (DBfsQTail), HL
