# file opened: macros.asm
   1+ 0000              ; ==============================================================================
   2+ 0000              ; MACROS ÚTILES PARA EL DESARROLLO
   3+ 0000              ; ==============================================================================
   4+ 0000
   5+ 0000                  ; Marco para pintar un color rápidamente en la pantalla
   6+ 0000                  MACRO SET_COLOR color, address
   7+ 0000 ~                    LD A, color
   8+ 0000 ~                    LD HL, address
   9+ 0000 ~                    LD (HL), A
  10+ 0000                  ENDM
  11+ 0000
  12+ 0000                  ; Macro estándar para sumar A a HL
  13+ 0000                  MACRO ADD_HL_A
  14+ 0000 ~                    ADD A, L
  15+ 0000 ~                    LD L, A
  16+ 0000 ~                    ADC A, H
  17+ 0000 ~                    SUB L
  18+ 0000 ~                    LD H, A
  19+ 0000                  ENDM
  20+ 0000
# file closed: macros.asm
  11  0000
  12  0000                  ; Origen del programa en RAM
  13  0000                  ORG ORIGIN_ADDRESS
  14  8000
  15  8000              Inicio:
  16  8000 F3               DI                      ; Deshabilitar interrupciones
  17  8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  18  8004
  19  8004                  ; Configuración inicial (Borde negro, etc.)
  20  8004 3E 01            LD A, BLUE              ; A = 1 (Azul oscuro)
  21  8006 D3 FE            OUT (254), A            ; Cambia el color del borde a azul oscuro
  22  8008
  23  8008                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  24  8008                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  25  8008 21 00 40         LD HL, SCREEN_BASE
  26  800B 11 01 40         LD DE, SCREEN_BASE + 1
  27  800E 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  28  8011 AF               XOR A                   ; A = 0
  29  8012 77               LD (HL), A
  30  8013 ED B0            LDIR
  31  8015
  32  8015                  ; Inicializar sistema de pantallas
  33  8015 CD 82 91         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  34  8018 CD EB 87         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  35  801B CD EF C3         CALL DrawClockSprite    ; Dibujar decoración del reloj (solo se repite en cambio de pantalla)
  36  801E
  37  801E ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  38  8020 FB               EI                      ; Habilitar interrupciones
  39  8021
  40  8021              ; ==============================================================================
  41  8021              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
  42  8021              ; ==============================================================================
  43  8021              ; El original NO separa render de logica. Cada entidad hace todo junto:
  44  8021              ;   erase viejo → AI/movimiento → draw nuevo
  45  8021              ; Player: siempre se procesa completo cada frame (tras HALT).
  46  8021              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
  47  8021              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
  48  8021              ; ==============================================================================
  49  8021              MainLoop:
  50  8021 76               HALT                    ; Esperar al barrido de pantalla (sincronizar a 50 FPS)
  51  8022
  52  8022                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
  53  8022 CD BF 91         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
  54  8025 CD 64 92         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
  55  8028
  56  8028                  ; === PLAYER: siempre cada frame, completo (erase+logic+draw) ===
  57  8028 CD FA 8E         CALL EraseDeadSprites       ; Cleanup puff terminadas (~20T normal)
  58  802B CD 74 87         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
  59  802E CD 56 88         CALL ProcessPlayer          ; Erase + logic + draw player (todo junto)
  60  8031
  61  8031                  ; Limpiar flag de pantalla recien dibujada (tras renderizar player)
  62  8031 AF               XOR A
  63  8032 32 82 81         LD (ScreenJustRedrawn), A
  64  8035
  65  8035                  ; === ENEMIGOS: round-robin, erase+logic+draw por entidad ===
  66  8035 CD 31 89         CALL ProcessEnemies         ; Round-robin: hasta MAX_ENEMIES_PER_FRAME
  67  8038
  68  8038                  ; === SISTEMAS GLOBALES ===
  69  8038 CD A7 8F         CALL TrySpawnNasty          ; Spawn check (tiene su propio timer)
  70  803B CD D2 90         CALL CheckPlayerEnemyCollision ; Colision player vs enemigos
  71  803E CD 63 C3         CALL DrawClockHUD           ; Reloj: cara + agujas (HUD fijo, no flicker)
  72  8041 CD 14 C3         CALL UpdateGameClock        ; Avanzar reloj de juego
  73  8044 CD 31 BE         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
  74  8047
  75  8047                  ; Incrementar contador de frames
  76  8047 3A 50 80         LD A, (GameFrameCounter)
  77  804A 3C               INC A
  78  804B 32 50 80         LD (GameFrameCounter), A
  79  804E
  80  804E 18 D1            JR MainLoop
  81  8050
  82  8050                  ; Inclusión de módulos
  83  8050                  INCLUDE "variables.asm"
