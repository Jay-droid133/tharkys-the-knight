5466+ BDF6 C9               RET
5467+ BDF7
5468+ BDF7              ; ==============================================================================
5469+ BDF7              ; Llamado desde el main loop despues de ProcessEntities.
5470+ BDF7              ; Comprueba bounding box overlap entre player y cada enemigo activo.
5471+ BDF7              ; ==============================================================================
5472+ BDF7              CheckPlayerEnemyCollision:
5473+ BDF7                  ; NO usar IY — el handler IM 1 del ROM necesita IY=$5C3A.
5474+ BDF7                  ; Detectar inicio de nuevo ciclo de attack: limpiar hit marks
5475+ BDF7 3A B2 80         LD A, (EntityTable + ENT_STATE)
5476+ BDFA 57               LD D, A                             ; D = estado actual
5477+ BDFB 3A 6A B2         LD A, (PrevPlayerState)
5478+ BDFE 5F               LD E, A                             ; E = estado previo
5479+ BDFF 7A               LD A, D
5480+ BE00 32 6A B2         LD (PrevPlayerState), A             ; Guardar estado actual
5481+ BE03 7B               LD A, E                             ; A = estado previo
5482+ BE04 FE 02            CP STATE_FIGHTING
5483+ BE06 28 0F            JR Z, .noNewAttack                  ; Ya estaba peleando → no limpiar
5484+ BE08 7A               LD A, D
5485+ BE09 FE 02            CP STATE_FIGHTING
5486+ BE0B 20 0A            JR NZ, .noNewAttack                 ; No empezo a pelear → no limpiar
5487+ BE0D                  ; Transicion a STATE_FIGHTING → nuevo ciclo de attack
5488+ BE0D AF               XOR A
5489+ BE0E 32 67 B2         LD (MonsterHitThisAttack), A
5490+ BE11 32 68 B2         LD (MonsterHitThisAttack+1), A
5491+ BE14 32 69 B2         LD (MonsterHitThisAttack+2), A
5492+ BE17              .noNewAttack:
5493+ BE17                  ; Obtener dims del player una sola vez
5494+ BE17 3A B0 80         LD A, (EntityTable + ENT_SPRITEID)
5495+ BE1A CD A1 A4         CALL GetSpriteDims          ; B=playerW, C=playerH
5496+ BE1D 78               LD A, B
5497+ BE1E 32 2C C0         LD (.plW), A
5498+ BE21 79               LD A, C
5499+ BE22 32 2D C0         LD (.plH), A
5500+ BE25
5501+ BE25 DD 21 C0 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)  ; Empezar en slot 1
5502+ BE29 06 09            LD B, NUM_MONSTERS + NUM_NASTIES       ; Slots 1-12
5503+ BE2B
5504+ BE2B              .checkLoop:
5505+ BE2B DD 7E 01         LD A, (IX+ENT_TYPE)
5506+ BE2E B7               OR A
5507+ BE2F CA 12 C0         JP Z, .nextEnemy
5508+ BE32
5509+ BE32                  ; Skip enemigos muriendo o spawneando (no colisionan)
5510+ BE32 DD 7E 02         LD A, (IX+ENT_STATE)
5511+ BE35 FE 03            CP STATE_DYING
5512+ BE37 CA 12 C0         JP Z, .nextEnemy
5513+ BE3A FE 04            CP STATE_SPAWNING
5514+ BE3C CA 12 C0         JP Z, .nextEnemy
5515+ BE3F                  ; Skip monsters en stun/knockback (no hacen daño)
5516+ BE3F DD 7E 01         LD A, (IX+ENT_TYPE)
5517+ BE42 FE 02            CP TYPE_MONSTER
5518+ BE44 20 07            JR NZ, .notStunned
5519+ BE46 DD 7E 0A         LD A, (IX+ENT_DIR)
