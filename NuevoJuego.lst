 653+ E5C7              DrawZoneCountHUD:
 654+ E5C7 3A 00 5D         LD A, (ZoneCellCount)
 655+ E5CA                  ; Hi nibble
 656+ E5CA 47               LD B, A
 657+ E5CB CB 3F            SRL A
 658+ E5CD CB 3F            SRL A
 659+ E5CF CB 3F            SRL A
 660+ E5D1 CB 3F            SRL A
 661+ E5D3 FE 0A            CP 10
 662+ E5D5 38 04            JR C, .dzcHiDigit
 663+ E5D7 C6 37            ADD A, 'A' - 10
 664+ E5D9 18 02            JR .dzcHiOut
 665+ E5DB              .dzcHiDigit:
 666+ E5DB C6 30            ADD A, '0'
 667+ E5DD              .dzcHiOut:
 668+ E5DD 1E 0B            LD E, 11
 669+ E5DF CD 17 E6         CALL DrawHudCharRow0
 670+ E5E2                  ; Lo nibble
 671+ E5E2 78               LD A, B
 672+ E5E3 E6 0F            AND $0F
 673+ E5E5 FE 0A            CP 10
 674+ E5E7 38 04            JR C, .dzcLoDigit
 675+ E5E9 C6 37            ADD A, 'A' - 10
 676+ E5EB 18 02            JR .dzcLoOut
 677+ E5ED              .dzcLoDigit:
 678+ E5ED C6 30            ADD A, '0'
 679+ E5EF              .dzcLoOut:
