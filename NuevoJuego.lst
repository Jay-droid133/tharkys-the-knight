 304+ 9E3C              ; ==============================================================================
 305+ 9E3C              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9E3C              ; ==============================================================================
 307+ 9E3C              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9E3C              ; Se llama ANTES de pintar el sprite.
 309+ 9E3C              ;
 310+ 9E3C              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9E3C              ;          IX = puntero al sprite (para leer width/height)
 312+ 9E3C              ; ==============================================================================
 313+ 9E3C              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9E3C              ; ==============================================================================
 315+ 9E3C              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9E3C              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9E3C              ; ==============================================================================
 318+ 9E3C              CalcEntityAttrSize:
 319+ 9E3C                  ; Paging inline (ver nota en DrawSprite)
 320+ 9E3C 3A D4 90         LD A, (CurrentPaging)
 321+ 9E3F E6 F8            AND $F8
 322+ 9E41 F6 06            OR 6
 323+ 9E43 32 D4 90         LD (CurrentPaging), A
 324+ 9E46 01 FD 7F         LD BC, $7FFD
 325+ 9E49 ED 79            OUT (C), A
 326+ 9E4B CD 5C 9E         CALL _CalcEntityAttrSizeImpl
 327+ 9E4E 3A D4 90         LD A, (CurrentPaging)
 328+ 9E51 E6 F8            AND $F8
 329+ 9E53 32 D4 90         LD (CurrentPaging), A
 330+ 9E56 01 FD 7F         LD BC, $7FFD
 331+ 9E59 ED 79            OUT (C), A
 332+ 9E5B C9               RET
