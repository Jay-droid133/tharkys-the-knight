2986+ B381 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
2987+ B383 77               LD (HL), A
2988+ B384                  ; MonsterRoomId[slot] = neighbor_id (destino)
2989+ B384 3A A1 B3         LD A, (.moKbSavedDir)
2990+ B387 CD 02 92         CALL MaiGetNeighborScreenId
2991+ B38A 21 CE 90         LD HL, MonsterRoomId
