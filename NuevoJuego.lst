2370+ AF30              .paFrameSet:
2371+ AF30 DD 77 00         LD (IX+ENT_SPRITEID), A
2372+ AF33              .paAnimDone:
2373+ AF33 C9               RET                                 ; Sigue atacando
2374+ AF34
2375+ AF34              .paRevert:
2376+ AF34                  ; Revertir posicion y volver a STATE_RUNNING con velocidades aleatorias
2377+ AF34 3A 71 AF         LD A, (.paOldX)
