 919+ D251 32 9F D2         LD (CurrentTintPaper), A
 920+ D254 DD 23            INC IX
 921+ D256
 922+ D256                  ; --- Pintar atributos ---
 923+ D256 DD 7E 00         LD A, (IX+0)                ; attr_h
 924+ D259 B7               OR A
