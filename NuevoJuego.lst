 245+ 67D7              ; ==============================================================================
 246+ 67D7              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 247+ 67D7              ; ==============================================================================
 248+ 67D7              ; IN: A = frame idx (0..2)
 249+ 67D7              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 250+ 67D7              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 251+ 67D7              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 252+ 67D7              ; Destruye: AF, BC, DE, HL, IX.
 253+ 67D7              ; ==============================================================================
 254+ 67D7              DrawSmokeFrameXor:
 255+ 67D7 87               ADD A, A                                ; *2 (entries de 2 bytes)
 256+ 67D8 6F               LD L, A
 257+ 67D9 26 00            LD H, 0
 258+ 67DB 11 D1 67         LD DE, SmokeFramePtrTable
 259+ 67DE 19               ADD HL, DE
 260+ 67DF 5E               LD E, (HL)
 261+ 67E0 23               INC HL
 262+ 67E1 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 263+ 67E2                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 264+ 67E2                  ; Source y destino accesibles sin paging (milestones bank 0,
 265+ 67E2                  ; BgSpriteBuffer en RAM principal).
 266+ 67E2 EB               EX DE, HL                               ; HL = source
 267+ 67E3 11 87 89         LD DE, BgSpriteBuffer
 268+ 67E6 01 22 00         LD BC, 34
 269+ 67E9 ED B0            LDIR
 270+ 67EB                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 271+ 67EB 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 272+ 67EE 57               LD D, A
 273+ 67EF 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 274+ 67F2 5F               LD E, A
 275+ 67F3 C3 E9 68         JP DrawBgSprite16XorAtPixel
