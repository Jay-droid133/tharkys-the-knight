 311+ 6F11              ; ==============================================================================
 312+ 6F11              ; UpdateRandomPickup - room-enter hook
 313+ 6F11              ; ==============================================================================
 314+ 6F11              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 315+ 6F11              ; Early-out si ScreenDirty=0 (no transition).
 316+ 6F11              ;
 317+ 6F11              ; En transition:
 318+ 6F11              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 319+ 6F11              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 320+ 6F11              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 321+ 6F11              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 322+ 6F11              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 323+ 6F11              ;
 324+ 6F11              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 325+ 6F11              ; fijos (id, charX, charY, v) terminados con id=$FF.
 326+ 6F11              ;
 327+ 6F11              ; Destruye AF, BC, DE, HL.
 328+ 6F11              ; ==============================================================================
 329+ 6F11              UpdateRandomPickup:
 330+ 6F11 3A B5 82         LD A, (ScreenDirty)
 331+ 6F14 B7               OR A
 332+ 6F15 C8               RET Z
 333+ 6F16
 334+ 6F16                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 335+ 6F16 3E FE            LD A, $FE
 336+ 6F18 32 B4 5F         LD (RandomSynthMapX), A
 337+ 6F1B AF               XOR A
 338+ 6F1C 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 339+ 6F1F
 340+ 6F1F                  ; --- Scan BG stream, build SlotList ---
 341+ 6F1F AF               XOR A
 342+ 6F20 32 AB 5F         LD (RandomSlotCount), A
 343+ 6F23 2A AF 82         LD HL, (CurrentScreenAddr)
 344+ 6F26              .urpScanLoop:
 345+ 6F26 7E               LD A, (HL)                          ; A = id
 346+ 6F27 FE FF            CP $FF
 347+ 6F29 28 2A            JR Z, .urpScanDone
 348+ 6F2B FE D2            CP RANDOM_SLOT_MARKER
 349+ 6F2D 20 20            JR NZ, .urpSkipEntry
 350+ 6F2F                  ; Es marker. Cap reached?
 351+ 6F2F 3A AB 5F         LD A, (RandomSlotCount)
 352+ 6F32 FE 04            CP RANDOM_SLOT_MAX
 353+ 6F34 30 19            JR NC, .urpSkipEntry
 354+ 6F36                  ; SlotList[count*2] = charX, [count*2+1] = charY
 355+ 6F36 23               INC HL                              ; HL @ charX
 356+ 6F37 46               LD B, (HL)                          ; B = charX
 357+ 6F38 23               INC HL                              ; HL @ charY
 358+ 6F39 4E               LD C, (HL)                          ; C = charY
 359+ 6F3A E5               PUSH HL                             ; save HL @ charY
 360+ 6F3B 87               ADD A, A                            ; A = count*2
 361+ 6F3C 6F               LD L, A
 362+ 6F3D 26 00            LD H, 0
 363+ 6F3F 11 AC 5F         LD DE, RandomSlotList
 364+ 6F42 19               ADD HL, DE
 365+ 6F43 70               LD (HL), B                          ; charX
 366+ 6F44 23               INC HL
 367+ 6F45 71               LD (HL), C                          ; charY
 368+ 6F46 21 AB 5F         LD HL, RandomSlotCount
 369+ 6F49 34               INC (HL)
 370+ 6F4A E1               POP HL                              ; HL @ charY
 371+ 6F4B 23               INC HL                              ; HL @ v
 372+ 6F4C 23               INC HL                              ; HL @ next id
 373+ 6F4D 18 D7            JR .urpScanLoop
 374+ 6F4F              .urpSkipEntry:
 375+ 6F4F                  ; Skip entry: 4 bytes (id, charX, charY, v).
 376+ 6F4F 23               INC HL
 376+ 6F50 23             INC HL
 376+ 6F51 23             INC HL
 376+ 6F52 23             INC HL
 377+ 6F53 18 D1            JR .urpScanLoop
 378+ 6F55              .urpScanDone:
 379+ 6F55
 380+ 6F55                  ; --- count == 0 -> nada que hacer ---
 381+ 6F55 3A AB 5F         LD A, (RandomSlotCount)
 382+ 6F58 B7               OR A
 383+ 6F59 C8               RET Z
 384+ 6F5A
 385+ 6F5A                  ; --- Pick slot via R mod count ---
 386+ 6F5A 47               LD B, A                             ; B = count
 387+ 6F5B ED 5F            LD A, R
 388+ 6F5D              .urpModLoop:
 389+ 6F5D 90               SUB B
 390+ 6F5E 30 FD            JR NC, .urpModLoop
 391+ 6F60 80               ADD A, B                            ; A = R mod count, [0..count-1]
 392+ 6F61
 393+ 6F61                  ; --- Read SlotList[A*2] = (charX, charY) ---
 394+ 6F61 87               ADD A, A
 395+ 6F62 5F               LD E, A
 396+ 6F63 16 00            LD D, 0
 397+ 6F65 21 AC 5F         LD HL, RandomSlotList
 398+ 6F68 19               ADD HL, DE
 399+ 6F69 7E               LD A, (HL)                          ; charX
 400+ 6F6A 32 B8 5F         LD (RandomSynthCharX), A
 401+ 6F6D 23               INC HL
 402+ 6F6E 7E               LD A, (HL)                          ; charY
 403+ 6F6F 32 B9 5F         LD (RandomSynthCharY), A
 404+ 6F72
 405+ 6F72                  ; --- Roll type usando R XOR SYS_FRAMES ---
 406+ 6F72                  IF DEBUG_FORCE_COMPASS
 407+ 6F72                      ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 408+ 6F72                      ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 409+ 6F72 C3 BA 6F             JP .urpDoCompass
 410+ 6F75                  ENDIF
 411+ 6F75 ED 5F            LD A, R
 412+ 6F77 21 78 5C         LD HL, $5C78
 413+ 6F7A AE               XOR (HL)
 414+ 6F7B FE 08            CP PROB_LIFE_END
 415+ 6F7D 38 1D            JR C, .urpDoLife
 416+ 6F7F FE 28            CP PROB_HEALTH_END
 417+ 6F81 38 1E            JR C, .urpDoHealth
 418+ 6F83 FE 48            CP PROB_STAMINA_END
 419+ 6F85 38 1F            JR C, .urpDoStamina
 420+ 6F87 FE 58            CP PROB_RAYO_END
 421+ 6F89 38 20            JR C, .urpDoRayo
 422+ 6F8B FE 68            CP PROB_CARACOL_END
 423+ 6F8D 38 21            JR C, .urpDoCaracol
 424+ 6F8F FE 78            CP PROB_ROULETTE_END
 425+ 6F91 38 2C            JR C, .urpDoRoulette
 426+ 6F93 FE 88            CP PROB_MUSHROOM_END
 427+ 6F95 38 1E            JR C, .urpDoMushroom
 428+ 6F97 FE 90            CP PROB_COMPASS_END
 429+ 6F99 38 1F            JR C, .urpDoCompass
 430+ 6F9B C9               RET                                 ; tipo nada, RandomSynthMapX ya esta a $FE
 431+ 6F9C              .urpDoLife:
