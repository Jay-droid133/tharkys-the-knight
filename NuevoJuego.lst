3919+ B513 DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de puff
3920+ B516 FE 06            CP ANIM_FRAMES_PUFF             ; >= 6 → animacion terminada
3921+ B518 38 09            JR C, .dyFrameOk
3922+ B51A                  ; Animacion puff terminada: desactivar entidad
3923+ B51A                  ; (el erase del ultimo frame ya se hizo en ProcessOneEnemy.peDying)
3924+ B51A DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
