   1+ 99DC              ; ==============================================================================
   2+ 99DC              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99DC              ; ==============================================================================
   4+ 99DC              ; Sistema fiel a Sabre Wulf:
   5+ 99DC              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99DC              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99DC              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99DC              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99DC              ; ==============================================================================
  10+ 99DC
  11+ 99DC              ClearScreen:
  12+ 99DC CD AF 0D         CALL ROM_CLS
  13+ 99DF C9               RET
  14+ 99E0
  15+ 99E0              ; ==============================================================================
  16+ 99E0              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99E0              ; ==============================================================================
  18+ 99E0              ; Entrada:
  19+ 99E0              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99E0              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99E0              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99E0              ;
  23+ 99E0              ; Formato del sprite:
  24+ 99E0              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99E0              ;   DEFB height_pixels
  26+ 99E0              ;   DEFB pixel_data... (width * height bytes)
  27+ 99E0              ;
  28+ 99E0              ; Dos paths:
  29+ 99E0              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99E0              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99E0              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99E0              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99E0              ;
  34+ 99E0              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99E0              ;
  36+ 99E0              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99E0              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99E0              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99E0              ; alto la restauracion del bank.
  40+ 99E0              ; ==============================================================================
  41+ 99E0              DrawSprite:
  42+ 99E0                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99E0                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99E0                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99E0 3A 7B 8D         LD A, (CurrentPaging)
  46+ 99E3 E6 F8            AND $F8
  47+ 99E5 F6 06            OR 6
  48+ 99E7 32 7B 8D         LD (CurrentPaging), A
  49+ 99EA 01 FD 7F         LD BC, $7FFD
  50+ 99ED ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99EF CD 00 9A         CALL _DrawSpriteImpl
  52+ 99F2                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 99F2                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 99F2 3A 7B 8D         LD A, (CurrentPaging)
  55+ 99F5 E6 F8            AND $F8
  56+ 99F7 32 7B 8D         LD (CurrentPaging), A
  57+ 99FA 01 FD 7F         LD BC, $7FFD
  58+ 99FD ED 79            OUT (C), A
  59+ 99FF C9               RET
  60+ 9A00
  61+ 9A00              _DrawSpriteImpl:
  62+ 9A00                  ; Guardar posicion
  63+ 9A00 7A               LD A, D
  64+ 9A01 32 BA 9A         LD (.posY), A
  65+ 9A04 7B               LD A, E
  66+ 9A05 32 B9 9A         LD (.posX), A
  67+ 9A08
  68+ 9A08                  ; Leer cabecera sprite
  69+ 9A08 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A0B 32 BB 9A         LD (.widthSave), A
  71+ 9A0E DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A11 32 BC 9A         LD (.heightSave), A
  73+ 9A14 DD 23            INC IX
  74+ 9A16 DD 23            INC IX                      ; IX → pixel data
  75+ 9A18
  76+ 9A18                  ; === Y CLIPPING ===
  77+ 9A18                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A18 3A BA 9A         LD A, (.posY)
  79+ 9A1B FE 10            CP SCREEN_MIN_Y
  80+ 9A1D 30 20            JR NC, .clipTopDone
  81+ 9A1F                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A1F 47               LD B, A                     ; B = Y
  83+ 9A20 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A22 90               SUB B                       ; A = filas a saltar
  85+ 9A23 47               LD B, A                     ; B = skip rows
  86+ 9A24                  ; Reducir altura
  87+ 9A24 3A BC 9A         LD A, (.heightSave)
  88+ 9A27 90               SUB B
  89+ 9A28 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A29 D8               RET C                       ; Idem
  91+ 9A2A 32 BC 9A         LD (.heightSave), A
  92+ 9A2D                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A2D 3A BB 9A         LD A, (.widthSave)
  94+ 9A30 4F               LD C, A
  95+ 9A31              .clipSkipRow:
  96+ 9A31 79               LD A, C
  97+ 9A32              .clipSkipByte:
  98+ 9A32 DD 23            INC IX
  99+ 9A34 3D               DEC A
 100+ 9A35 20 FB            JR NZ, .clipSkipByte
 101+ 9A37 10 F8            DJNZ .clipSkipRow
 102+ 9A39                  ; Ajustar Y al borde
 103+ 9A39 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A3B 32 BA 9A         LD (.posY), A
 105+ 9A3E 57               LD D, A
 106+ 9A3F              .clipTopDone:
 107+ 9A3F                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A3F 3A BA 9A         LD A, (.posY)
 109+ 9A42 47               LD B, A
 110+ 9A43 3A BC 9A         LD A, (.heightSave)
 111+ 9A46 80               ADD A, B                    ; A = Y + height
 112+ 9A47 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A49 FE C0            CP 192
 114+ 9A4B 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A4D              .clipBot:
 116+ 9A4D                  ; Reducir altura: new_height = 192 - Y
 117+ 9A4D 3E C0            LD A, 192
 118+ 9A4F 90               SUB B                       ; A = 192 - Y
 119+ 9A50 C8               RET Z
 120+ 9A51 D8               RET C
 121+ 9A52 32 BC 9A         LD (.heightSave), A
 122+ 9A55              .clipBotDone:
 123+ 9A55
 124+ 9A55                  ; Comprobar alineacion
 125+ 9A55 7B               LD A, E
 126+ 9A56 E6 07            AND 7
 127+ 9A58 20 1E            JR NZ, .shifted
