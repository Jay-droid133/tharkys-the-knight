1019+ 91AC                  ; === Comun: iniciar ataque ===
1020+ 91AC                  ; AttackTimer ya viene cargado con ATTACK_SWING_FRAMES (valor base).
1021+ 91AC                  ; Recalculamos usando el delay boosteado real para que la animacion
1022+ 91AC                  ; no wrappee: timer = ANIM_FRAMES_FIGHT * delay_boosteado.
1023+ 91AC              .startAttack:
1024+ 91AC AF               XOR A
1025+ 91AD 32 4B 9D         LD (MonsterHitThisAttack), A
1026+ 91B0 32 4C 9D         LD (MonsterHitThisAttack+1), A
1027+ 91B3 32 4D 9D         LD (MonsterHitThisAttack+2), A
1028+ 91B6
1029+ 91B6                  ; Calcular delay real (misma logica que .applyAnim)
1030+ 91B6 0E 02            LD C, ANIM_DELAY_FIGHT      ; C = delay base (2)
1031+ 91B8 DD E5            PUSH IX
1032+ 91BA CD CD A0         CALL CountActiveNasties     ; A = nastis activos
1033+ 91BD DD E1            POP IX
1034+ 91BF B7               OR A
1035+ 91C0 20 0E            JR NZ, .sa_nasties
1036+ 91C2 DD E5            PUSH IX
1037+ 91C4 CD D4 A0         CALL CountActiveMonsters    ; A = monsters activos
1038+ 91C7 DD E1            POP IX
1039+ 91C9 D6 03            SUB 3
1040+ 91CB 38 14            JR C, .sa_noBoost
1041+ 91CD 3C               INC A
1042+ 91CE 18 05            JR .sa_boost
1043+ 91D0              .sa_nasties:
1044+ 91D0 D6 02            SUB 2
1045+ 91D2 38 0D            JR C, .sa_noBoost
1046+ 91D4 3C               INC A
1047+ 91D5              .sa_boost:
1048+ 91D5 47               LD B, A
1049+ 91D6 79               LD A, C
1050+ 91D7 90               SUB B                       ; delay - boost
1051+ 91D8 28 05            JR Z, .sa_min
1052+ 91DA 38 03            JR C, .sa_min
1053+ 91DC 4F               LD C, A
1054+ 91DD 18 02            JR .sa_noBoost
1055+ 91DF              .sa_min:
1056+ 91DF 0E 01            LD C, 1
1057+ 91E1              .sa_noBoost:
1058+ 91E1                  ; Timer = ANIM_FRAMES_FIGHT * C (delay boosteado)
1059+ 91E1 3E 05            LD A, ANIM_FRAMES_FIGHT     ; 5
1060+ 91E3 47               LD B, A
1061+ 91E4 AF               XOR A                       ; A = 0 (acumulador)
1062+ 91E5              .sa_mul:
1063+ 91E5 81               ADD A, C
1064+ 91E6 10 FD            DJNZ .sa_mul                ; A = 5 * C
1065+ 91E8 32 40 9D         LD (AttackTimer), A
1066+ 91EB
1067+ 91EB DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1068+ 91EF C9               RET
