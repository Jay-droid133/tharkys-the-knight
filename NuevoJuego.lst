 258+ DDEC B9               CP C
 259+ DDED D8               RET C
 260+ DDEE                  ; HIT
 261+ DDEE CD F6 DD         CALL StartBankCutscene
 262+ DDF1 3E 04            LD A, 4                             ; action 4 = BankDoor
 263+ DDF3 C3 49 6D         JP CheckMilestoneTrigger_B7         ; tail-call al thunk slot 1 (que repagina bank 7 antes de RET)
 264+ DDF6
 265+ DDF6              ; ==============================================================================
 266+ DDF6              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 267+ DDF6              ; ==============================================================================
 268+ DDF6              ; 1. NO consume cheque aqui — se consume despues, en la transicion
 269+ DDF6              ;    HAND_OPEN_IN -> HAND_OPEN_TAKE (la mano abierta "coge" el cheque
 270+ DDF6              ;    visualmente). El bloqueo del re-trigger lo da el check de phase != 0
 271+ DDF6              ;    en CheckBankTriggerBg.
 272+ DDF6              ; 2. Snap player a anchor frente a la puerta, facing N.
 273+ DDF6              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 274+ DDF6              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 275+ DDF6              ;    para limpiar la pantalla durante la cutscene.
 276+ DDF6              ; Destruye: AF, BC, DE, HL, IX.
 277+ DDF6              ; ==============================================================================
 278+ DDF6              StartBankCutscene:
 279+ DDF6 AF               XOR A
 280+ DDF7 32 CE 82         LD (BankCutsceneKnockIdx), A
 281+ DDFA 32 CD 82         LD (BankCutsceneSubState), A
 282+ DDFD 32 CF 82         LD (BankCutsceneNoIdx), A
 283+ DE00 32 D0 82         LD (BankCutsceneHandFrame), A
 284+ DE03                  ; Resetea el color del player al default (WHITE | $40 = $47). Si el player
 285+ DE03                  ; tenia color de un buff (speed, mushroom...) o de un hit (BLUE flash), se
 286+ DE03                  ; pierde aqui. Sino el player aparece tintado durante toda la cinematica.
 287+ DE03 3E 47            LD A, WHITE | $40
 288+ DE05 32 A2 81         LD (EntityTable + ENT_ATTR), A
 289+ DE08 CD 61 6D         CALL KillAllActiveNasties_B7           ; nasties → STATE_DYING + puff anim
 290+ DE0B CD 67 6D         CALL KillDeathIfActive_B7               ; muerte (slot 11) → puff y despawn
 291+ DE0E                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 292+ DE0E                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 293+ DE0E                  ; cambiamos el sprite a facing N para preparar.
 294+ DE0E CD 91 DE         CALL BankCutsceneFacingNRedraw
 295+ DE11 CD 19 E2         CALL SFX_Bank_OnStart
 296+ DE14                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 297+ DE14                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 298+ DE14                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 299+ DE14 3E 64            LD A, BCS_T_PUFF_WAIT
 300+ DE16 32 CC 82         LD (BankCutsceneTimer), A
 301+ DE19 3E 11            LD A, BCP_WAIT_NASTIES
 302+ DE1B 32 CB 82         LD (BankCutscenePhase), A
 303+ DE1E C9               RET
 304+ DE1F
 305+ DE1F              ; ==============================================================================
 306+ DE1F              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 307+ DE1F              ; ==============================================================================
 308+ DE1F              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 309+ DE1F              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 310+ DE1F              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 311+ DE1F              BankCutsceneSnapToDoor:
 312+ DE1F DD 21 9D 81      LD IX, EntityTable
 313+ DE23 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 314+ DE27 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 315+ DE2B DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 316+ DE2F 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 317+ DE31 32 DE 82         LD (PlayerDrawY), A
 318+ DE34 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 319+ DE36 DD 77 00         LD (IX+ENT_SPRITEID), A
 320+ DE39 3E 0A            LD A, SPRID_WALK_N
 321+ DE3B DD 77 08         LD (IX+ENT_ANIMBASE), A
 322+ DE3E AF               XOR A
 323+ DE3F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 324+ DE42 C3 52 6D         JP TownGateRedrawPlayer_B7
 325+ DE45
 326+ DE45              ; ==============================================================================
 327+ DE45              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 328+ DE45              ; ==============================================================================
 329+ DE45              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 330+ DE45              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 331+ DE45              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 332+ DE45              BankCutsceneSnapToRetreat:
 333+ DE45 DD 21 9D 81      LD IX, EntityTable
 334+ DE49 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 335+ DE4D DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 336+ DE51 DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 337+ DE55 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 338+ DE57 32 DE 82         LD (PlayerDrawY), A
 339+ DE5A 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 340+ DE5C DD 77 00         LD (IX+ENT_SPRITEID), A
 341+ DE5F 3E 0A            LD A, SPRID_WALK_N
 342+ DE61 DD 77 08         LD (IX+ENT_ANIMBASE), A
 343+ DE64 AF               XOR A
 344+ DE65 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 345+ DE68 C3 52 6D         JP TownGateRedrawPlayer_B7
 346+ DE6B
 347+ DE6B              ; ==============================================================================
 348+ DE6B              ; BankCutsceneSnapToBackOff - teleport player a anchor BACKOFF (centrado + 2 char hueco)
 349+ DE6B              ; ==============================================================================
 350+ DE6B              ; Llamado al cerrarse la puerta tras el "no no" (.bcPhHandOut). El player baja
 351+ DE6B              ; 1 char extra respecto a RETREAT como reaccion al portazo final.
 352+ DE6B              ; Mismo X que los demas anchors (centrado con la puerta), Y=80 (door bottom 63,
 353+ DE6B              ; 16 px de hueco, top del player en 80). Sigue facing N.
 354+ DE6B              BankCutsceneSnapToBackOff:
 355+ DE6B DD 21 9D 81      LD IX, EntityTable
 356+ DE6F DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 357+ DE73 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 358+ DE77 DD 36 04 50      LD (IX+ENT_POSY), BCS_PLAYER_BACKOFF_Y
 359+ DE7B 3E 50            LD A, BCS_PLAYER_BACKOFF_Y
 360+ DE7D 32 DE 82         LD (PlayerDrawY), A
 361+ DE80 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 362+ DE82 DD 77 00         LD (IX+ENT_SPRITEID), A
 363+ DE85 3E 0A            LD A, SPRID_WALK_N
 364+ DE87 DD 77 08         LD (IX+ENT_ANIMBASE), A
 365+ DE8A AF               XOR A
 366+ DE8B DD 77 09         LD (IX+ENT_ANIMTIMER), A
 367+ DE8E C3 52 6D         JP TownGateRedrawPlayer_B7
 368+ DE91
 369+ DE91              ; ==============================================================================
 370+ DE91              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 371+ DE91              ; ==============================================================================
 372+ DE91              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 373+ DE91              ; para asegurar que el player mira a la puerta antes del primer snap.
 374+ DE91              BankCutsceneFacingNRedraw:
 375+ DE91 DD 21 9D 81      LD IX, EntityTable
 376+ DE95 DD 7E 04         LD A, (IX+ENT_POSY)
 377+ DE98 32 DE 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 378+ DE9B 3E 0B            LD A, SPRID_WALK_N + 1
 379+ DE9D DD 77 00         LD (IX+ENT_SPRITEID), A
 380+ DEA0 3E 0A            LD A, SPRID_WALK_N
 381+ DEA2 DD 77 08         LD (IX+ENT_ANIMBASE), A
 382+ DEA5 AF               XOR A
 383+ DEA6 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 384+ DEA9 C3 52 6D         JP TownGateRedrawPlayer_B7
 385+ DEAC
 386+ DEAC              ; ==============================================================================
 387+ DEAC              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 388+ DEAC              ; ==============================================================================
 389+ DEAC              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 390+ DEAC              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 391+ DEAC              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 392+ DEAC              ; resuelve KillAllActiveNasties de StartBankCutscene).
 393+ DEAC              ; Destruye: AF, BC, DE, HL, IX.
 394+ DEAC              ; ==============================================================================
 395+ DEAC              UpdateBankCutsceneBody:
 396+ DEAC 3A CB 82         LD A, (BankCutscenePhase)
 397+ DEAF FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 398+ DEB1 CA 04 DF         JP Z, .bcPhWaitNasties
 399+ DEB4 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 400+ DEB6 CA 0E E1         JP Z, .bcPhDoorClosed
 401+ DEB9 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 402+ DEBB                                                      ;   clink + consume cheque + erase mano + cierra puerta
 403+ DEBB CA 35 E0         JP Z, .bcPhHandOpenIn
 404+ DEBE FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 405+ DEC0 CA 94 E0         JP Z, .bcPhHandOpenOut
 406+ DEC3 3D               DEC A
 407+ DEC4 CA 1E DF         JP Z, .bcPhLock
 408+ DEC7 3D               DEC A
 409+ DEC8 CA 3C DF         JP Z, .bcPhKnocks1
 410+ DECB 3D               DEC A
 411+ DECC CA 51 DF         JP Z, .bcPhWait1
 412+ DECF 3D               DEC A
 413+ DED0 CA 72 DF         JP Z, .bcPhKnocks2
 414+ DED3 3D               DEC A
 415+ DED4 CA 87 DF         JP Z, .bcPhWait2
 416+ DED7 3D               DEC A
 417+ DED8 CA A9 DF         JP Z, .bcPhTurnToCam
 418+ DEDB 3D               DEC A
 419+ DEDC CA CD DF         JP Z, .bcPhTurnToDoor
 420+ DEDF 3D               DEC A
 421+ DEE0 CA EF DF         JP Z, .bcPhKnocks3
 422+ DEE3 3D               DEC A
 423+ DEE4 CA 04 E0         JP Z, .bcPhWait3
 424+ DEE7 3D               DEC A
 425+ DEE8 CA 16 E0         JP Z, .bcPhPreHand
 426+ DEEB 3D               DEC A
 427+ DEEC CA B3 E0         JP Z, .bcPhHandIn
 428+ DEEF 3D               DEC A
 429+ DEF0 CA C2 E0         JP Z, .bcPhHandNoNo
 430+ DEF3 3D               DEC A
 431+ DEF4 CA F3 E0         JP Z, .bcPhHandOut
 432+ DEF7 3D               DEC A
 433+ DEF8 CA 2E E1         JP Z, .bcPhKeyDrop
 434+ DEFB 3D               DEC A
 435+ DEFC CA 53 E1         JP Z, .bcPhPlayerTurnCam
 436+ DEFF                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 437+ DEFF AF               XOR A
 438+ DF00 32 CB 82         LD (BankCutscenePhase), A
 439+ DF03 C9               RET
 440+ DF04
 441+ DF04              ; ---- Phase 17: WAIT_NASTIES ----
 442+ DF04              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 443+ DF04              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 444+ DF04              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 445+ DF04              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 446+ DF04              ;
 447+ DF04              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 448+ DF04              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 449+ DF04              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 450+ DF04              .bcPhWaitNasties:
 451+ DF04 CD 61 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 452+ DF07 CD 22 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 453+ DF0A 28 04            JR Z, .bcWaitNastiesDone
 454+ DF0C CD 10 E2         CALL BankCutsceneDecTimer           ; safety timeout
 455+ DF0F C0               RET NZ
 456+ DF10              .bcWaitNastiesDone:
 457+ DF10 CD 1F DE         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 458+ DF13 3E 1E            LD A, BCS_T_LOCK
 459+ DF15 32 CC 82         LD (BankCutsceneTimer), A
 460+ DF18 3E 01            LD A, BCP_LOCK
 461+ DF1A 32 CB 82         LD (BankCutscenePhase), A
 462+ DF1D C9               RET
 463+ DF1E
 464+ DF1E              ; ---- Phase 1: lock + facing UP ----
 465+ DF1E              .bcPhLock:
 466+ DF1E CD 10 E2         CALL BankCutsceneDecTimer
 467+ DF21 C0               RET NZ
 468+ DF22                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DF22 AF               XOR A
 470+ DF23 32 CE 82         LD (BankCutsceneKnockIdx), A
 471+ DF26 32 D1 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DF29 3E 00            LD A, BCS_KNOCK_HIT
 473+ DF2B 32 CD 82         LD (BankCutsceneSubState), A
 474+ DF2E 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DF30 32 CC 82         LD (BankCutsceneTimer), A
 476+ DF33 CD 98 E1         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DF36 3E 02            LD A, BCP_KNOCKS_1
 478+ DF38 32 CB 82         LD (BankCutscenePhase), A
 479+ DF3B C9               RET
 480+ DF3C
 481+ DF3C              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 482+ DF3C              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 483+ DF3C              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 484+ DF3C              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 485+ DF3C              .bcPhKnocks1:
 486+ DF3C 3E 03            LD A, BCS_GROUP1_KNOCKS
 487+ DF3E CD 5D E1         CALL BankCutsceneTickKnockGroup
 488+ DF41 B7               OR A
 489+ DF42 C8               RET Z                               ; sigue
 490+ DF43                  ; grupo 1 terminado → retirarse a ORIG + wait
 491+ DF43 CD 45 DE         CALL BankCutsceneSnapToRetreat
 492+ DF46 3E 32            LD A, BCS_T_GROUP_WAIT
 493+ DF48 32 CC 82         LD (BankCutsceneTimer), A
 494+ DF4B 3E 03            LD A, BCP_WAIT_1
 495+ DF4D 32 CB 82         LD (BankCutscenePhase), A
 496+ DF50 C9               RET
 497+ DF51
 498+ DF51              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 499+ DF51              .bcPhWait1:
 500+ DF51 CD 10 E2         CALL BankCutsceneDecTimer
 501+ DF54 C0               RET NZ
 502+ DF55                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 503+ DF55 CD 1F DE         CALL BankCutsceneSnapToDoor
 504+ DF58 AF               XOR A
 505+ DF59 32 CE 82         LD (BankCutsceneKnockIdx), A
 506+ DF5C 32 D1 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 507+ DF5F 3E 00            LD A, BCS_KNOCK_HIT
 508+ DF61 32 CD 82         LD (BankCutsceneSubState), A
 509+ DF64 3E 04            LD A, BCS_T_KNOCK_HIT
 510+ DF66 32 CC 82         LD (BankCutsceneTimer), A
 511+ DF69 CD 98 E1         CALL BankCutsceneEmitKnockHit
 512+ DF6C 3E 04            LD A, BCP_KNOCKS_2
 513+ DF6E 32 CB 82         LD (BankCutscenePhase), A
 514+ DF71 C9               RET
 515+ DF72
 516+ DF72              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 517+ DF72              .bcPhKnocks2:
 518+ DF72 3E 03            LD A, BCS_GROUP2_KNOCKS
 519+ DF74 CD 5D E1         CALL BankCutsceneTickKnockGroup
 520+ DF77 B7               OR A
 521+ DF78 C8               RET Z
 522+ DF79                  ; grupo 2 terminado → retirarse a ORIG + wait
 523+ DF79 CD 45 DE         CALL BankCutsceneSnapToRetreat
 524+ DF7C 3E 32            LD A, BCS_T_GROUP_WAIT
 525+ DF7E 32 CC 82         LD (BankCutsceneTimer), A
 526+ DF81 3E 05            LD A, BCP_WAIT_2
 527+ DF83 32 CB 82         LD (BankCutscenePhase), A
 528+ DF86 C9               RET
 529+ DF87
 530+ DF87              ; ---- Phase 5: WAIT_2 ----
 531+ DF87              .bcPhWait2:
 532+ DF87 CD 10 E2         CALL BankCutsceneDecTimer
 533+ DF8A C0               RET NZ
 534+ DF8B                  ; Player gira a S (cara camara).
 535+ DF8B DD 21 9D 81      LD IX, EntityTable
 536+ DF8F 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 537+ DF91 DD 77 00         LD (IX+ENT_SPRITEID), A
 538+ DF94 DD 77 08         LD (IX+ENT_ANIMBASE), A
 539+ DF97 AF               XOR A
 540+ DF98 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 541+ DF9B CD 52 6D         CALL TownGateRedrawPlayer_B7
 542+ DF9E 3E 28            LD A, BCS_T_TURN_CAM
 543+ DFA0 32 CC 82         LD (BankCutsceneTimer), A
 544+ DFA3 3E 06            LD A, BCP_TURN_TO_CAM
 545+ DFA5 32 CB 82         LD (BankCutscenePhase), A
 546+ DFA8 C9               RET
 547+ DFA9
 548+ DFA9              ; ---- Phase 6: player mirando camara mid-cutscene ----
 549+ DFA9              .bcPhTurnToCam:
 550+ DFA9 CD 10 E2         CALL BankCutsceneDecTimer
 551+ DFAC C0               RET NZ
 552+ DFAD                  ; Player vuelve a N (cara puerta).
 553+ DFAD DD 21 9D 81      LD IX, EntityTable
 554+ DFB1 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 555+ DFB3 DD 77 00         LD (IX+ENT_SPRITEID), A
 556+ DFB6 3E 0A            LD A, SPRID_WALK_N
 557+ DFB8 DD 77 08         LD (IX+ENT_ANIMBASE), A
 558+ DFBB AF               XOR A
 559+ DFBC DD 77 09         LD (IX+ENT_ANIMTIMER), A
 560+ DFBF CD 52 6D         CALL TownGateRedrawPlayer_B7
 561+ DFC2 3E 0A            LD A, BCS_T_TURN_BACK
 562+ DFC4 32 CC 82         LD (BankCutsceneTimer), A
 563+ DFC7 3E 07            LD A, BCP_TURN_TO_DOOR
 564+ DFC9 32 CB 82         LD (BankCutscenePhase), A
 565+ DFCC C9               RET
 566+ DFCD
 567+ DFCD              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 568+ DFCD              .bcPhTurnToDoor:
 569+ DFCD CD 10 E2         CALL BankCutsceneDecTimer
 570+ DFD0 C0               RET NZ
 571+ DFD1                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 572+ DFD1 CD 1F DE         CALL BankCutsceneSnapToDoor
 573+ DFD4 AF               XOR A
 574+ DFD5 32 CE 82         LD (BankCutsceneKnockIdx), A
 575+ DFD8 3E 01            LD A, 1
 576+ DFDA 32 D1 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 577+ DFDD AF               XOR A
 578+ DFDE 32 CD 82         LD (BankCutsceneSubState), A        ; HIT
 579+ DFE1 3E 04            LD A, BCS_T_KNOCK_HIT
 580+ DFE3 32 CC 82         LD (BankCutsceneTimer), A
 581+ DFE6 CD 98 E1         CALL BankCutsceneEmitKnockHit
 582+ DFE9 3E 08            LD A, BCP_KNOCKS_3
 583+ DFEB 32 CB 82         LD (BankCutscenePhase), A
 584+ DFEE C9               RET
 585+ DFEF
 586+ DFEF              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 587+ DFEF              .bcPhKnocks3:
 588+ DFEF 3E 06            LD A, BCS_GROUP3_KNOCKS
 589+ DFF1 CD 5D E1         CALL BankCutsceneTickKnockGroup
 590+ DFF4 B7               OR A
 591+ DFF5 C8               RET Z
 592+ DFF6                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 593+ DFF6                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 594+ DFF6                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 595+ DFF6 CD 45 DE         CALL BankCutsceneSnapToRetreat
 596+ DFF9 3E 1E            LD A, BCS_T_PRE_HAND
 597+ DFFB 32 CC 82         LD (BankCutsceneTimer), A
 598+ DFFE 3E 09            LD A, BCP_WAIT_3
 599+ E000 32 CB 82         LD (BankCutscenePhase), A
 600+ E003 C9               RET
 601+ E004
 602+ E004              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 603+ E004              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 604+ E004              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 605+ E004              .bcPhWait3:
 606+ E004 CD 10 E2         CALL BankCutsceneDecTimer
 607+ E007 C0               RET NZ
 608+ E008 CD 2A E2         CALL SFX_Bank_OnDoorCreak
 609+ E00B 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 610+ E00D 32 CC 82         LD (BankCutsceneTimer), A
 611+ E010 3E 0A            LD A, BCP_PRE_HAND
 612+ E012 32 CB 82         LD (BankCutscenePhase), A
 613+ E015 C9               RET
 614+ E016
 615+ E016              ; ---- Phase 10: hold corto antes de la mano ----
 616+ E016              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 617+ E016              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 618+ E016              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 619+ E016              ;
 620+ E016              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 621+ E016              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 622+ E016              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 623+ E016              ; mano "no no" aparece (HAND_NO_NO).
 624+ E016              ;
 625+ E016              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 626+ E016              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 627+ E016              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 628+ E016              .bcPhPreHand:
 629+ E016 CD 10 E2         CALL BankCutsceneDecTimer
 630+ E019 C0               RET NZ
 631+ E01A AF               XOR A
 632+ E01B 32 D0 82         LD (BankCutsceneHandFrame), A           ; frame 1 (= seq[0])
 633+ E01E 32 CF 82         LD (BankCutsceneNoIdx), A               ; 0 slots completados
 634+ E021 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 635+ E024 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 636+ E027 CD 2B E2         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 637+ E02A 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 638+ E02C 32 CC 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 639+ E02F 3E 13            LD A, BCP_HAND_OPEN_IN
 640+ E031 32 CB 82         LD (BankCutscenePhase), A
 641+ E034 C9               RET
