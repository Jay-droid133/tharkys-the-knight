  91+ 7B9C              .mihEpilogue:
  92+ 7B9C E1               POP HL
  93+ 7B9D D1               POP DE
  94+ 7B9E C1               POP BC
  95+ 7B9F F1               POP AF
  96+ 7BA0 FB               EI
  97+ 7BA1 C9               RET
  98+ 7BA2
  99+ 7BA2              ; --- Estado del divisor (1 byte) ---
 100+ 7BA2 00           MusicIrqDivisor: DEFB 0
 101+ 7BA3
 102+ 7BA3              ; ==============================================================================
 103+ 7BA3              ; MUSIC DRIVER STATE + TABLES + TICK (movido de bank 4 a slot 1)
 104+ 7BA3              ; ==============================================================================
 105+ 7BA3              ; Vive aqui porque el IRQ handler debe acceder a este codigo/datos sin paginar
 106+ 7BA3              ; (paginar slot 3 dentro del IRQ rompe los PUSH/POP del propio handler — ver
 107+ 7BA3              ; project_ay_thunk_stack_bug.md). Slot 1 = $6000-$7FFF siempre visible, asi
 108+ 7BA3              ; que tanto el handler IRQ como StartMusicImpl (en bank 4) llegan aqui sin
 109+ 7BA3              ; problemas: bank 4 paga slot 3, slot 1 sigue intacto.
 110+ 7BA3              ;
 111+ 7BA3              ; Tracks (mismo dispatcher que antes, vive en bank 4 / ay_sound.asm):
 112+ 7BA3              ;   0    = Tension     (TensionMusicTable)
 113+ 7BA3              ;   1    = Sunrise     (SunriseMusicTable)
 114+ 7BA3              ;   2    = EndGame     (EndGameMusicTable)  LOOPABLE
 115+ 7BA3              ;   3    = GameOver    (GameOverMusicTable)
 116+ 7BA3              ;   4    = Death       (DeathMusicTable)    LOOPABLE
 117+ 7BA3              ;   $FF  = STOP, $FE = restart, $FD = stop-if-loopable
 118+ 7BA3              ; ==============================================================================
 119+ 7BA3
 120+ 7BA3              ; --- State (13 B) ---
 121+ 7BA3              ; Driver poly: tracks in-game (Tension/Sunrise/Death) usan poly2 (canales A+C,
 122+ 7BA3              ; B reservado a SFX). Tracks game-end (EndGame/GameOver) usan poly3 (A+B+C, sin
 123+ 7BA3              ; SFX en escena). El modo se setea en StartMusicImpl segun track id; dicta el
 124+ 7BA3              ; stride de tabla (5 vs 7 B/nota) y qué canales re-armar cada frame.
 125+ 7BA3 00 00        MusicPtr:           DEFW 0      ; Ptr a la nota actual en la tabla activa
 126+ 7BA5 00           MusicTimer:         DEFB 0      ; Frames restantes en la nota actual (0 = inactivo)
 127+ 7BA6 00 00        MusicTableStart:    DEFW 0      ; Ptr al inicio de la tabla activa (para loop)
 128+ 7BA8 00           MusicLoop:          DEFB 0      ; 1 = al terminator reiniciar; 0 = mute y parar
 129+ 7BA9 00           MusicMode:          DEFB 0      ; 2 = poly2 (5 B/entry, A+C), 3 = poly3 (7 B/entry, A+B+C)
 130+ 7BAA 00 00        MusicPeriodA:       DEFW 0      ; Period activo canal A (0 = mute A en re-arm)
 131+ 7BAC 00 00        MusicPeriodB:       DEFW 0      ; Period activo canal B (solo poly3; 0 = mute)
 132+ 7BAE 00 00        MusicPeriodC:       DEFW 0      ; Period activo canal C (0 = mute C en re-arm)
 133+ 7BB0
 134+ 7BB0              ; ==============================================================================
 135+ 7BB0              ; TRACK TABLES (polifonicas)
 136+ 7BB0              ; ==============================================================================
 137+ 7BB0              ; Period AY = 1750000 / (16 * frequency). Duraciones en frames a 25fps (1f=40ms).
 138+ 7BB0              ;
 139+ 7BB0              ; Formato Poly2 (5 B/entry): periodA(2) + periodC(2) + duration(1)
 140+ 7BB0              ;   Tracks 0/1/4 (Tension/Sunrise/Death). Canal B libre para SFX.
 141+ 7BB0              ; Formato Poly3 (7 B/entry): periodA(2) + periodB(2) + periodC(2) + duration(1)
 142+ 7BB0              ;   Tracks 2/3 (EndGame/GameOver). Sin SFX en escena → 3 voces simultaneas.
 143+ 7BB0              ;
 144+ 7BB0              ; period=$0000 en un canal = ese canal en silencio durante la nota (vol mute).
 145+ 7BB0              ; Terminator: entry completa con todo a 0 (5 B en poly2, 7 B en poly3).
 146+ 7BB0              ;
 147+ 7BB0              ; Por ahora todas las melodias siguen monofonicas (voz original en A, B/C en
 148+ 7BB0              ; silencio) hasta que el converter genere las versiones polifonicas reales.
 149+ 7BB0              ; ==============================================================================
