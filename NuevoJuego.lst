 952+ B33F                  ; --- Path RLE: recorrer tokens para saltar el stream ---
 953+ B33F                  ; Total pixeles = height_px * (width_bytes & $7F)
 954+ B33F              .spSkipRle:
 955+ B33F 7B               LD A, E
 956+ B340 E6 7F            AND $7F                     ; width_bytes real
 957+ B342                  ; Calcular total = D * A (height * width)
 958+ B342 42               LD B, D                     ; B = height
 959+ B343 21 00 00         LD HL, 0
 960+ B346 16 00            LD D, 0
 961+ B348 5F               LD E, A                     ; DE = width
 962+ B349              .spMul:
 963+ B349 19               ADD HL, DE
 964+ B34A 10 FD            DJNZ .spMul
