 661+ 66D4 3E 87            LD A, LOW BgGfx_old_church_door_closed
 662+ 66D6 77               LD (HL), A
 663+ 66D7 23               INC HL
 664+ 66D8 3E DE            LD A, HIGH BgGfx_old_church_door_closed
 665+ 66DA 77               LD (HL), A
 666+ 66DB                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 667+ 66DB C5               PUSH BC
