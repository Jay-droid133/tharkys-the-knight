1018+ A7CB              ; ==============================================================================
1019+ A7CB              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
1020+ A7CB              ; ==============================================================================
1021+ A7CB              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
1022+ A7CB              ; IX = puntero a la entidad
1023+ A7CB              ; ==============================================================================
1024+ A7CB              DrawEntity:
1025+ A7CB CD 00 A8         CALL GetSpriteAddr
1026+ A7CE
1027+ A7CE                  ; Guardar attrs del fondo ANTES de pintar
1028+ A7CE DD 56 04         LD D, (IX+ENT_POSY)
1029+ A7D1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1030+ A7D4 5F               LD E, A
1031+ A7D5 DD E5            PUSH IX
1032+ A7D7 DD 2A 2F A8      LD IX, (SpriteAddrTemp)
1033+ A7DB CD 90 9E         CALL SaveEntityAttr
1034+ A7DE DD E1            POP IX
1035+ A7E0
1036+ A7E0                  ; Pintar atributo ANTES del draw
1037+ A7E0 DD 56 04         LD D, (IX+ENT_POSY)
1038+ A7E3 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1039+ A7E6 5F               LD E, A
1040+ A7E7 DD 7E 05         LD A, (IX+ENT_ATTR)
1041+ A7EA CD 22 9E         CALL SetEntityAttr
1042+ A7ED
1043+ A7ED                  ; XOR draw del sprite
1044+ A7ED DD 56 04         LD D, (IX+ENT_POSY)
1045+ A7F0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1046+ A7F3 5F               LD E, A
