4486+ ABE9              ; ==============================================================================
4487+ ABE9              ; Llamado desde el main loop despues de ProcessEntities.
4488+ ABE9              ; Comprueba bounding box overlap entre player y cada enemigo activo.
4489+ ABE9              ; ==============================================================================
4490+ ABE9              CheckPlayerEnemyCollision:
4491+ ABE9                  ; NO usar IY — el handler IM 1 del ROM necesita IY=$5C3A.
4492+ ABE9                  ; Detectar inicio de nuevo ciclo de attack: limpiar hit marks
4493+ ABE9 3A A0 80         LD A, (EntityTable + ENT_STATE)
4494+ ABEC 57               LD D, A                             ; D = estado actual
4495+ ABED 3A 22 A3         LD A, (PrevPlayerState)
4496+ ABF0 5F               LD E, A                             ; E = estado previo
4497+ ABF1 7A               LD A, D
4498+ ABF2 32 22 A3         LD (PrevPlayerState), A             ; Guardar estado actual
4499+ ABF5 7B               LD A, E                             ; A = estado previo
4500+ ABF6 FE 02            CP STATE_FIGHTING
4501+ ABF8 28 0F            JR Z, .noNewAttack                  ; Ya estaba peleando → no limpiar
4502+ ABFA 7A               LD A, D
4503+ ABFB FE 02            CP STATE_FIGHTING
4504+ ABFD 20 0A            JR NZ, .noNewAttack                 ; No empezo a pelear → no limpiar
4505+ ABFF                  ; Transicion a STATE_FIGHTING → nuevo ciclo de attack
4506+ ABFF AF               XOR A
4507+ AC00 32 1F A3         LD (MonsterHitThisAttack), A
4508+ AC03 32 20 A3         LD (MonsterHitThisAttack+1), A
4509+ AC06 32 21 A3         LD (MonsterHitThisAttack+2), A
4510+ AC09              .noNewAttack:
