1400+ F48C              ; ==============================================================================
1401+ F48C              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1402+ F48C              ; ==============================================================================
1403+ F48C              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1404+ F48C              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1405+ F48C              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1406+ F48C              ; ==============================================================================
1407+ F48C              ChurchCutsceneInitStatueShake:
1408+ F48C 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1409+ F48F 21 A9 69         LD HL, StatueIdTable
1410+ F492 5F               LD E, A
1411+ F493 16 00            LD D, 0
1412+ F495 19               ADD HL, DE
1413+ F496 7E               LD A, (HL)                              ; A = statue id
1414+ F497 B7               OR A
1415+ F498 C8               RET Z                                   ; sin estatua
1416+ F499 32 C9 F4         LD (.cisTargetId), A
1417+ F49C                  ; Buscar en CurrentScreenBuffer
1418+ F49C 2A 0A 83         LD HL, (CurrentScreenAddr)
1419+ F49F              .cisLoop:
1420+ F49F 7E               LD A, (HL)
1421+ F4A0 FE FF            CP $FF
1422+ F4A2 C8               RET Z                                   ; no encontrada (no se hace shake)
1423+ F4A3 47               LD B, A
1424+ F4A4 3A C9 F4         LD A, (.cisTargetId)
1425+ F4A7 B8               CP B
1426+ F4A8 28 06            JR Z, .cisFound
1427+ F4AA 11 04 00         LD DE, 4
1428+ F4AD 19               ADD HL, DE
1429+ F4AE 18 EF            JR .cisLoop
1430+ F4B0              .cisFound:
1431+ F4B0 23               INC HL
1432+ F4B1 7E               LD A, (HL)                              ; charX
1433+ F4B2                  ; Pixel X = charX * 8
1434+ F4B2 87               ADD A, A
1435+ F4B3 87               ADD A, A
1436+ F4B4 87               ADD A, A
1437+ F4B5 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1438+ F4B8 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1439+ F4BB 23               INC HL
1440+ F4BC 7E               LD A, (HL)                              ; charY
1441+ F4BD                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1442+ F4BD C6 02            ADD A, BG_Y_OFFSET
1443+ F4BF 87               ADD A, A
1444+ F4C0 87               ADD A, A
1445+ F4C1 87               ADD A, A
1446+ F4C2 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1447+ F4C5 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1448+ F4C8 C9               RET
1449+ F4C9 00           .cisTargetId: DEFB 0
