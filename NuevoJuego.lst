 492+ 6617              ; ==============================================================================
 493+ 6617              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 494+ 6617              ; ==============================================================================
 495+ 6617              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 496+ 6617              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 497+ 6617              ; OUT: -
 498+ 6617              ; Destruye: AF, BC, DE, HL, IX.
 499+ 6617              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 500+ 6617              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 501+ 6617              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 502+ 6617              ; ==============================================================================
 503+ 6617              DrawBgSpriteByIdAtChar:
 504+ 6617 B7               OR A
 505+ 6618 C8               RET Z                                   ; id 0 = no sprite, salir
 506+ 6619 C5               PUSH BC
 507+ 661A 6F               LD L, A
 508+ 661B 26 00            LD H, 0
 509+ 661D 54               LD D, H
 510+ 661E 5D               LD E, L                                 ; DE = id
 511+ 661F 29               ADD HL, HL                              ; *2
 512+ 6620 19               ADD HL, DE                              ; *3
 513+ 6621 11 55 E0         LD DE, BgGfxPtrById
 514+ 6624 19               ADD HL, DE
 515+ 6625 5E               LD E, (HL)
 516+ 6626 23               INC HL
 517+ 6627 56               LD D, (HL)                              ; DE = ptr
 518+ 6628 23               INC HL
 519+ 6629 7E               LD A, (HL)                              ; A = bank
 520+ 662A 32 6F D2         LD (CurrentBgSpriteBank), A
 521+ 662D EB               EX DE, HL                               ; HL = ptr
 522+ 662E CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
 523+ 6631 DD 21 EE 86      LD IX, BgSpriteBuffer
 524+ 6635 C1               POP BC
 525+ 6636 C3 63 D1         JP DrawBgGfxSprite                      ; tail call
