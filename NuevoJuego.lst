 892+ 66F6              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 66F6              ; ==============================================================================
 894+ 66F6              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 66F6              ; Destruye: AF, BC, DE, HL, IX.
 896+ 66F6              ; ==============================================================================
 897+ 66F6              TownGateDrawArmShifted:
 898+ 66F6 21 55 E2         LD HL, BgGfx_arm
 899+ 66F9 3E 03            LD A, 3
 900+ 66FB CD C2 6C         CALL LoadBgSpriteToBuffer
 901+ 66FE 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 6701 47               LD B, A
 903+ 6702 3E 88            LD A, TGCS_ARM_PX_X
 904+ 6704 80               ADD A, B
 905+ 6705 5F               LD E, A
 906+ 6706 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 6709 47               LD B, A
 908+ 670A 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 670C 80               ADD A, B
 910+ 670D 57               LD D, A
 911+ 670E C3 2C 67         JP DrawBgSpriteAnyXorAtPixel
