 174+ E4FD                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 175+ E4FD 3E 00            LD A, 0                     ; R0: tone A LSB
 176+ E4FF 1E 58            LD E, $58
 177+ E501 CD 5D E4         CALL AY_WriteReg
 178+ E504 3E 01            LD A, 1                     ; R1: tone A MSB
 179+ E506 1E 02            LD E, $02
 180+ E508 CD 5D E4         CALL AY_WriteReg
 181+ E50B 3E 02            LD A, 2                     ; R2: tone B LSB
 182+ E50D 1E 58            LD E, $58
 183+ E50F CD 5D E4         CALL AY_WriteReg
 184+ E512 3E 03            LD A, 3                     ; R3: tone B MSB
 185+ E514 1E 02            LD E, $02
 186+ E516 CD 5D E4         CALL AY_WriteReg
 187+ E519 3E 04            LD A, 4                     ; R4: tone C LSB
 188+ E51B 1E 58            LD E, $58
 189+ E51D CD 5D E4         CALL AY_WriteReg
 190+ E520 3E 05            LD A, 5                     ; R5: tone C MSB
 191+ E522 1E 02            LD E, $02
 192+ E524 CD 5D E4         CALL AY_WriteReg
 193+ E527
 194+ E527                  ; --- Mixer: tonos A, B, C activos ---
 195+ E527 3E 07            LD A, 7
 196+ E529 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 197+ E52B CD 5D E4         CALL AY_WriteReg
 198+ E52E
 199+ E52E                  ; --- Volúmenes iniciales ---
 200+ E52E 3E 08            LD A, 8
 201+ E530 21 9B E4         LD HL, BellVolL
 202+ E533 5E               LD E, (HL)
 203+ E534 CD 5D E4         CALL AY_WriteReg
 204+ E537 3E 09            LD A, 9
 205+ E539 21 9C E4         LD HL, BellVolC
 206+ E53C 5E               LD E, (HL)
 207+ E53D CD 5D E4         CALL AY_WriteReg
 208+ E540 3E 0A            LD A, 10
 209+ E542 21 9D E4         LD HL, BellVolR
 210+ E545 5E               LD E, (HL)
 211+ E546 CD 5D E4         CALL AY_WriteReg
