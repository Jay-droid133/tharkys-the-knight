 271+ E643 13               INC DE
 272+ E644 24               INC H                               ; siguiente scan line
 273+ E645 10 FA            DJNZ .drawChar
 274+ E647                  ; Attr: fila 0, col 0 = $5800
 275+ E647 3E 47            LD A, $47                           ; blanco bright
 276+ E649 32 00 58         LD ($5800), A
 277+ E64C C9               RET
 278+ E64D
 279+ E64D 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
