4674+ BB5D C2 FE BB         JP NZ, .spawnBlocked
4675+ BB60 DD 7E 03         LD A, (IX+ENT_POSX)
4676+ BB63 47               LD B, A
4677+ BB64 3A 22 BC         LD A, (.spawnW1)
4678+ BB67 80               ADD A, B
4679+ BB68 47               LD B, A
4680+ BB69 DD 7E 04         LD A, (IX+ENT_POSY)
4681+ BB6C 4F               LD C, A
4682+ BB6D CD F0 D7         CALL IsPointBlocked
4683+ BB70 C2 FE BB         JP NZ, .spawnBlocked
4684+ BB73 DD 7E 03         LD A, (IX+ENT_POSX)
4685+ BB76 47               LD B, A
4686+ BB77 DD 7E 04         LD A, (IX+ENT_POSY)
4687+ BB7A 4F               LD C, A
4688+ BB7B 3A 23 BC         LD A, (.spawnH1)
4689+ BB7E 81               ADD A, C
4690+ BB7F 4F               LD C, A
4691+ BB80 CD F0 D7         CALL IsPointBlocked
4692+ BB83 C2 FE BB         JP NZ, .spawnBlocked
4693+ BB86 DD 7E 03         LD A, (IX+ENT_POSX)
4694+ BB89 47               LD B, A
4695+ BB8A 3A 22 BC         LD A, (.spawnW1)
4696+ BB8D 80               ADD A, B
4697+ BB8E 47               LD B, A
4698+ BB8F DD 7E 04         LD A, (IX+ENT_POSY)
4699+ BB92 4F               LD C, A
4700+ BB93 3A 23 BC         LD A, (.spawnH1)
