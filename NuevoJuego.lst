 650+ CD90              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 651+ CD90              ; ==============================================================================
 652+ CD90              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 653+ CD90              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 654+ CD90              ;          DEFB tintPaper, attr_h, attr_w, attr_data
