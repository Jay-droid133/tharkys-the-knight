 480+ 690F              ; ==============================================================================
 481+ 690F              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 482+ 690F              ; ==============================================================================
 483+ 690F              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 484+ 690F              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 485+ 690F              ; OUT: -
 486+ 690F              ; Destruye: AF, BC, DE, HL, IX.
 487+ 690F              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 488+ 690F              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 489+ 690F              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 490+ 690F              ; ==============================================================================
 491+ 690F              DrawBgSpriteByIdAtChar:
 492+ 690F B7               OR A
 493+ 6910 C8               RET Z                                   ; id 0 = no sprite, salir
 494+ 6911 C5               PUSH BC
 495+ 6912 6F               LD L, A
 496+ 6913 26 00            LD H, 0
 497+ 6915 54               LD D, H
 498+ 6916 5D               LD E, L                                 ; DE = id
 499+ 6917 29               ADD HL, HL                              ; *2
 500+ 6918 19               ADD HL, DE                              ; *3
 501+ 6919 11 0A E2         LD DE, BgGfxPtrById
 502+ 691C 19               ADD HL, DE
 503+ 691D 5E               LD E, (HL)
 504+ 691E 23               INC HL
 505+ 691F 56               LD D, (HL)                              ; DE = ptr
 506+ 6920 23               INC HL
 507+ 6921 7E               LD A, (HL)                              ; A = bank
 508+ 6922 32 DA D4         LD (CurrentBgSpriteBank), A
 509+ 6925 EB               EX DE, HL                               ; HL = ptr
 510+ 6926 CD BC 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 511+ 6929 DD 21 F5 89      LD IX, BgSpriteBuffer
 512+ 692D C1               POP BC
 513+ 692E C3 CE D3         JP DrawBgGfxSprite                      ; tail call
