4105+ B5F8 32 49 B6         LD (.ecYlo), A
4106+ B5FB 78               LD A, B
4107+ B5FC 81               ADD A, C
4108+ B5FD 3D               DEC A                           ; posY + H - 1
4109+ B5FE 0F               RRCA
4110+ B5FF 0F               RRCA
