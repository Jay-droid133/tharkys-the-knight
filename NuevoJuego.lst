 996+ D2B9              ; ==============================================================================
 997+ D2B9              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 998+ D2B9              ; ==============================================================================
 999+ D2B9              ; Entrada: A = attr byte
1000+ D2B9              ; Salida:  A = attr con paper reemplazado (o sin cambio)
1001+ D2B9              ; Preserva: HL, DE, BC, IX
1002+ D2B9              ; ==============================================================================
1003+ D2B9              ApplyTintSwap:
1004+ D2B9 C5               PUSH BC
1005+ D2BA 47               LD B, A                     ; B = attr original
1006+ D2BB 3A B5 D2         LD A, (CurrentTintVar)
1007+ D2BE FE FF            CP $FF
1008+ D2C0 28 24            JR Z, .tintNoChange
1009+ D2C2 4F               LD C, A                     ; C = tint variant (new paper 0-7)
1010+ D2C3 3A B6 D2         LD A, (CurrentTintPaper)
1011+ D2C6 FE FF            CP $FF
1012+ D2C8 28 1C            JR Z, .tintNoChange
1013+ D2CA                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
1014+ D2CA                  ; Extraer paper del attr: bits 5-3
1015+ D2CA 78               LD A, B
1016+ D2CB E6 38            AND $38                     ; A = 00PPP000
1017+ D2CD 0F               RRCA
1018+ D2CE 0F               RRCA
1019+ D2CF 0F               RRCA                        ; A = 00000PPP = paper actual
1020+ D2D0 D5               PUSH DE
1021+ D2D1 57               LD D, A                     ; D = paper actual
1022+ D2D2 3A B6 D2         LD A, (CurrentTintPaper)
1023+ D2D5 BA               CP D                        ; paper actual == tintPaper?
1024+ D2D6 D1               POP DE
1025+ D2D7 20 0D            JR NZ, .tintNoChange
1026+ D2D9                  ; Match: reemplazar paper bits con tintVar
1027+ D2D9 78               LD A, B
1028+ D2DA E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1029+ D2DC D5               PUSH DE
1030+ D2DD 57               LD D, A
1031+ D2DE 79               LD A, C                     ; A = tintVar (0-7)
1032+ D2DF 07               RLCA
1033+ D2E0 07               RLCA
1034+ D2E1 07               RLCA                        ; A = 00PPP000
1035+ D2E2 B2               OR D                        ; A = FBPPPIII
1036+ D2E3 D1               POP DE
1037+ D2E4 C1               POP BC
1038+ D2E5 C9               RET
1039+ D2E6              .tintNoChange:
1040+ D2E6 78               LD A, B                     ; devolver sin cambio
1041+ D2E7 C1               POP BC
1042+ D2E8 C9               RET
