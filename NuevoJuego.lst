7643+ C9A4 32 D6 82         LD (FingerRevealed), A
7644+ C9A7 32 8C B3         LD (MonstersActive), A
7645+ C9AA 32 C3 82         LD (MonsterTrappedFlags), A
7646+ C9AD 32 FF 82         LD (DeathSpawned), A
7647+ C9B0 32 CD 82         LD (TownGatePhase), A
7648+ C9B3 32 CB 82         LD (ChurchCutscenePhase), A
7649+ C9B6 32 9A E3         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7650+ C9B9 32 BB 82         LD (BellsTriggered), A
7651+ C9BC 32 C4 82         LD (NextChurchTrapStep), A
7652+ C9BF 32 C5 82         LD (StatueBlinkCounter), A
7653+ C9C2 32 C6 82         LD (ChurchKeyAltSpawnIdx), A
7654+ C9C5 32 32 C5         LD (PlayerHitTimer), A
7655+ C9C8 32 F8 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7656+ C9CB 32 F9 82         LD (TombDrawPending), A
7657+ C9CE 32 EC 82         LD (DeathBorderPhase), A
7658+ C9D1 32 ED 82         LD (DeathBorderTimer), A
7659+ C9D4 32 EE 82         LD (PlayerDeathAnimTimer), A
7660+ C9D7 32 EF 82         LD (PlayerDeathAnimFrame), A
7661+ C9DA 32 F0 82         LD (PlayerRespawnPhase), A
7662+ C9DD 32 F1 82         LD (PlayerRespawnTimer), A
7663+ C9E0 32 F2 82         LD (PlayerRespawnBlinkTimer), A
7664+ C9E3 32 F4 82         LD (PlayerRespawnBeatIdx), A
7665+ C9E6 32 E5 82         LD (GameOverAnimX), A
7666+ C9E9 32 E6 82         LD (GameOverAnimDir), A
7667+ C9EC 32 E7 82         LD (GameOverAnimFrame), A
7668+ C9EF 32 E8 82         LD (GameOverAnimFrameTimer), A
