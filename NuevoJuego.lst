 632+ 70C4 6F               LD L, A
 633+ 70C5 29               ADD HL, HL
 634+ 70C6 29               ADD HL, HL
 635+ 70C7 29               ADD HL, HL
 636+ 70C8 29               ADD HL, HL
 637+ 70C9 29               ADD HL, HL                          ; *32
 638+ 70CA 3A B8 5F         LD A, (RandomSynthCharX)
 639+ 70CD 85               ADD A, L
 640+ 70CE 6F               LD L, A
 641+ 70CF 30 01            JR NC, .pspaNoCarry
 642+ 70D1 24               INC H
 643+ 70D2              .pspaNoCarry:
 644+ 70D2 11 00 58         LD DE, ATTR_BASE
 645+ 70D5 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 646+ 70D6                  ; --- Escribir 4 attrs (2x2) ---
