1085+ A86E              ; ==============================================================================
1086+ A86E              ; UpdatePlayerState - Determina estado y direccion desde input
1087+ A86E              ; ==============================================================================
1088+ A86E              UpdatePlayerState:
1089+ A86E 3A D7 81         LD A, (InputDirection)
1090+ A871 47               LD B, A
1091+ A872 3A D8 81         LD A, (InputFire)
1092+ A875 4F               LD C, A
1093+ A876
1094+ A876                  ; Sin input → idle (salvo si ataque en curso)
1095+ A876 78               LD A, B
1096+ A877 B1               OR C
1097+ A878 20 17            JR NZ, .notIdle
1098+ A87A                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1099+ A87A 3A F6 B5         LD A, (AttackTimer)
1100+ A87D B7               OR A
1101+ A87E 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1102+ A880 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1103+ A884                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1104+ A884 DD 7E 0A         LD A, (IX+ENT_DIR)
1105+ A887 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1106+ A889 DD 77 0A         LD (IX+ENT_DIR), A
1107+ A88C                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1108+ A88C AF               XOR A
1109+ A88D 32 F8 B5         LD (AttackDebounce), A
1110+ A890 C9               RET
1111+ A891
1112+ A891              .notIdle:
1113+ A891                  ; Guardar direccion actual en bits 0-3
1114+ A891 DD 7E 0A         LD A, (IX+ENT_DIR)
1115+ A894 E6 F0            AND $F0                     ; Mantener lastHDir
1116+ A896 B0               OR B                        ; Añadir dir actual
1117+ A897 DD 77 0A         LD (IX+ENT_DIR), A
1118+ A89A
1119+ A89A                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1120+ A89A 3A F6 B5         LD A, (AttackTimer)
1121+ A89D B7               OR A
1122+ A89E 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1123+ A8A0 78               LD A, B
1124+ A8A1 E6 0C            AND DIR_E | DIR_W
1125+ A8A3 28 0E            JR Z, .noHorizUpdate
1126+ A8A5                  ; Guardar en bits 4-7
1127+ A8A5 07               RLCA
1128+ A8A6 07               RLCA
1129+ A8A7 07               RLCA
1130+ A8A8 07               RLCA                        ; Shift a bits 4-7
1131+ A8A9 4F               LD C, A                     ; C = lastHDir en bits 4-7
1132+ A8AA DD 7E 0A         LD A, (IX+ENT_DIR)
1133+ A8AD E6 0F            AND $0F                     ; Mantener dir actual
1134+ A8AF B1               OR C                        ; Añadir lastHDir
1135+ A8B0 DD 77 0A         LD (IX+ENT_DIR), A
1136+ A8B3              .noHorizUpdate:
1137+ A8B3
1138+ A8B3                  ; --- Consumir/regenerar stamina ---
1139+ A8B3 CD 21 AD         CALL UpdateStamina
1140+ A8B6                  ; --- Auto-select sword mode segun stamina ---
1141+ A8B6 CD 77 AD         CALL SelectSwordMode
1142+ A8B9                  ; --- Dispatch segun SwordMode ---
1143+ A8B9 3A FA B5         LD A, (SwordMode)
1144+ A8BC B7               OR A
1145+ A8BD 28 09            JR Z, .swordModeB
1146+ A8BF FE 01            CP 1
1147+ A8C1 28 3F            JR Z, .swordModeC
1148+ A8C3 FE 02            CP 2
1149+ A8C5 CA 2B A9         JP Z, .swordModeFree
1150+ A8C8
1151+ A8C8                  ; === MODO B: Cooldown fijo tras atacar ===
1152+ A8C8              .swordModeB:
1153+ A8C8 3A F7 B5         LD A, (AttackCooldown)
1154+ A8CB B7               OR A
1155+ A8CC 28 0D            JR Z, .bNoCooldown
1156+ A8CE 3D               DEC A
1157+ A8CF 32 F7 B5         LD (AttackCooldown), A
1158+ A8D2 C2 79 A9         JP NZ, .running                     ; En cooldown: no puede atacar
1159+ A8D5                  ; Cooldown terminado: restaurar color blanco
1160+ A8D5 CD 52 A9         CALL .setPlayerWhite
1161+ A8D8 C3 79 A9         JP .running
1162+ A8DB              .bNoCooldown:
1163+ A8DB 3A F6 B5         LD A, (AttackTimer)
1164+ A8DE B7               OR A
1165+ A8DF 28 13            JR Z, .bNoActive
1166+ A8E1 3D               DEC A
1167+ A8E2 32 F6 B5         LD (AttackTimer), A
1168+ A8E5 20 08            JR NZ, .bActive
1169+ A8E7                  ; Swing terminado: iniciar cooldown + color azul
1170+ A8E7 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1171+ A8E9 32 F7 B5         LD (AttackCooldown), A
1172+ A8EC CD 47 A9         CALL .setPlayerBlue
1173+ A8EF              .bActive:
1174+ A8EF DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1175+ A8F3 C9               RET
1176+ A8F4              .bNoActive:
1177+ A8F4 3A D8 81         LD A, (InputFire)
1178+ A8F7 B7               OR A
1179+ A8F8 CA 79 A9         JP Z, .running
1180+ A8FB 3E 05            LD A, ATTACK_SWING_FRAMES
1181+ A8FD 32 F6 B5         LD (AttackTimer), A
1182+ A900 18 5B            JR .startAttack
1183+ A902
1184+ A902                  ; === MODO C: Swing fijo con debounce ===
1185+ A902              .swordModeC:
1186+ A902 3A F6 B5         LD A, (AttackTimer)
1187+ A905 B7               OR A
1188+ A906 28 09            JR Z, .cNoActive
1189+ A908 3D               DEC A
1190+ A909 32 F6 B5         LD (AttackTimer), A
1191+ A90C DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1192+ A910 C9               RET
1193+ A911              .cNoActive:
1194+ A911 3A D8 81         LD A, (InputFire)
1195+ A914 B7               OR A
1196+ A915 CA 75 A9         JP Z, .attackReleased
1197+ A918 3A F8 B5         LD A, (AttackDebounce)
1198+ A91B B7               OR A
1199+ A91C C2 79 A9         JP NZ, .running                     ; Aun mantenido → no re-atacar
1200+ A91F 3E 01            LD A, 1
1201+ A921 32 F8 B5         LD (AttackDebounce), A
1202+ A924 3E 05            LD A, ATTACK_SWING_FRAMES
1203+ A926 32 F6 B5         LD (AttackTimer), A
1204+ A929 18 32            JR .startAttack
1205+ A92B
1206+ A92B                  ; === MODO LIBRE: mantener SPACE = atacar continuo (stamina alta) ===
1207+ A92B              .swordModeFree:
1208+ A92B 3A F6 B5         LD A, (AttackTimer)
1209+ A92E B7               OR A
1210+ A92F 28 09            JR Z, .fNoActive
1211+ A931 3D               DEC A
1212+ A932 32 F6 B5         LD (AttackTimer), A
1213+ A935 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1214+ A939 C9               RET
1215+ A93A              .fNoActive:
1216+ A93A 3A D8 81         LD A, (InputFire)
1217+ A93D B7               OR A
1218+ A93E 28 39            JR Z, .running
1219+ A940 3E 05            LD A, ATTACK_SWING_FRAMES
1220+ A942 32 F6 B5         LD (AttackTimer), A
1221+ A945 18 16            JR .startAttack
1222+ A947
1223+ A947                  ; === Helpers de color para cooldown ===
1224+ A947              .setPlayerBlue:
1225+ A947 3A 52 C5         LD A, (PlayerHitTimer)
1226+ A94A B7               OR A
1227+ A94B C0               RET NZ                              ; En flash de daño → no cambiar
1228+ A94C 3E 41            LD A, BLUE | $40
1229+ A94E 32 CC 80         LD (EntityTable + ENT_ATTR), A
1230+ A951 C9               RET
1231+ A952              .setPlayerWhite:
1232+ A952 3A 52 C5         LD A, (PlayerHitTimer)
1233+ A955 B7               OR A
1234+ A956 C0               RET NZ                              ; En flash de daño → no cambiar
1235+ A957 3E 47            LD A, WHITE | $40
1236+ A959 32 CC 80         LD (EntityTable + ENT_ATTR), A
1237+ A95C C9               RET
1238+ A95D
1239+ A95D                  ; === Comun: iniciar ataque ===
1240+ A95D                  ; AttackTimer ya viene cargado con ATTACK_SWING_FRAMES (valor base).
1241+ A95D                  ; Recalculamos usando el delay boosteado real para que la animacion
1242+ A95D                  ; no wrappee: timer = ANIM_FRAMES_FIGHT * delay_boosteado.
1243+ A95D              .startAttack:
1244+ A95D AF               XOR A
1245+ A95E 32 05 B6         LD (MonsterHitThisAttack), A
1246+ A961 32 06 B6         LD (MonsterHitThisAttack+1), A
1247+ A964 32 07 B6         LD (MonsterHitThisAttack+2), A
1248+ A967
1249+ A967                  ; Timer = ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT (fijo, 25fps constante)
1250+ A967 3E 05            LD A, ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT
