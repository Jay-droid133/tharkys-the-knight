  94+ F826              BCS_T_TURN_CAM          EQU 40      ; 1.6s mid-cutscene mirando camara
  95+ F826              BCS_T_TURN_BACK         EQU 10      ; transicion rapida de vuelta
  96+ F826              BCS_T_PRE_HAND          EQU 30      ; pausa tras los 6 toques antes de la mano
  97+ F826              BCS_T_PRE_HAND_HOLD     EQU 20      ; hold corto antes de hacer aparecer la mano
  98+ F826              BCS_T_HAND_IN           EQU 20      ; pause tras aparecer mano
  99+ F826              BCS_T_NO_FRAME          EQU 12      ; cada swap de "no no"
 100+ F826              BCS_T_HAND_HOLD         EQU 15      ; pausa tras ultimo swap
