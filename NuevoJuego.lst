 195+ 0000              ; ==============================================================================
 196+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 197+ 0000              ; ==============================================================================
 198+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 199+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 200+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 201+ 0000              ;
 202+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 203+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 204+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 205+ 0000              ; ==============================================================================
 206+ 0000
 207+ 0000              ; --- Dimensiones del mapa ---
 208+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 209+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 210+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 211+ 0000
 212+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 213+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 214+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 215+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 216+ 0000
 217+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 218+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 219+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 220+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 221+ 0000
 222+ 0000              ; --- Tipos de tile ---
 223+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 224+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 225+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 226+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 227+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 228+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 229+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 230+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 231+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 232+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 233+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 234+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 235+ 0000
 236+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 237+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 238+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 239+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 240+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 241+ 0000
 242+ 0000              ; --- Posicion inicial del jugador: definida en screen_data.asm (level editor) ---
 243+ 0000
 244+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 245+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 246+ 0000
 247+ 0000              ; ==============================================================================
 248+ 0000              ; MONSTER AI v2 (fase 2 — estructuras en RAM + bank 6)
 249+ 0000              ; ==============================================================================
 250+ 0000              ; Timings tuneables. Unidad: frames a 25fps.
 251+ 0000              MAI_LINGER_NORMAL   EQU 45          ; ~1.8s — migrar tras abandono sin push
 252+ 0000              MAI_LINGER_PUSHED   EQU 50          ; ~2s — vuelta tras knockback de espada
 253+ 0000              MAI_ENTRY_OFFSET    EQU 0           ; Spawn inicial: al borde mismo (Regla 1)
 254+ 0000              MAI_REENTRY_OFFSET  EQU 16          ; Reaparicion tras push: 2 chars dentro (Regla 4)
 255+ 0000              MAI_WAIT_OFFSET     EQU 40          ; Offset del migrado "esperando" desde entry gap (evita solape con player)
 256+ 0000
 257+ 0000              ; Lados de un screen (coincide con ScreenGaps_*.asm y el campo EntryBorder)
 258+ 0000              MAI_SIDE_N          EQU 0
 259+ 0000              MAI_SIDE_S          EQU 1
 260+ 0000              MAI_SIDE_W          EQU 2
 261+ 0000              MAI_SIDE_E          EQU 3
 262+ 0000
 263+ 0000              ; Flags por monster (campo MonsterAiFlags[slot], 1 byte)
 264+ 0000              MAI_FLAG_PUSHED     EQU %00000001   ; bit 0: empujado por espada (usar LINGER_PUSHED)
 265+ 0000              MAI_FLAG_LEAVING    EQU %00000010   ; bit 1: buscando hueco y saliendo (amanecer/muerte)
 266+ 0000              MAI_FLAG_REMOTE     EQU %00000100   ; bit 2: asentado en una room distinta al player
 267+ 0000              MAI_FLAG_SHAKE_SAVED EQU %00001000  ; bit 3: orig POSX/POSY guardados para shake del amanecer
 268+ 0000
 269+ 0000              ; ScreenGaps: DEFB count, {side, coord} × count
 270+ 0000              MAI_GAP_REC_SIZE    EQU 2           ; bytes por entrada de gap
 271+ 0000
 272+ 0000              ; RoomHistory: ventana de las ultimas 3 rooms distintas visitadas.
 273+ 0000              MAI_HISTORY_LEN     EQU 3
 274+ 0000
 275+ 0000              ; Flow field: direcciones resueltas + intervalo de recomputacion
 276+ 0000              MAI_DIR_NONE        EQU $FF
 277+ 0000              MAI_DIR_N           EQU 0
 278+ 0000              MAI_DIR_S           EQU 1
 279+ 0000              MAI_DIR_W           EQU 2
 280+ 0000              MAI_DIR_E           EQU 3
 281+ 0000              MAI_FLOW_INTERVAL   EQU 10          ; frames entre recomputaciones de BFS
 282+ 0000
