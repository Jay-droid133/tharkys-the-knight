 838+ D433 FA 55 D4         JP M, .rleLitEmit           ; <0 = literal group en curso
 839+ D436                  ; >0 = run en curso, emitir valor
 840+ D436              .rleRunEmit:
 841+ D436 3A D7 D4         LD A, (.rleValue)
 842+ D439 2F               CPL
 843+ D43A 77               LD (HL), A
 844+ D43B 23               INC HL
 845+ D43C 3A D6 D4         LD A, (.rlePending)
 846+ D43F 3D               DEC A
 847+ D440 32 D6 D4         LD (.rlePending), A
