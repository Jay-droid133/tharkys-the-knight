2373+ D835 E5               PUSH HL                         ; volver a guardar para el handler
2374+ D836 23               INC HL
2374+ D837 23             INC HL                 ; skip ptr
2375+ D838 7E               LD A, (HL)                      ; charX
2376+ D839 87               ADD A, A
2376+ D83A 87             ADD A, A
2376+ D83B 87             ADD A, A  ; *8 = px_left
2377+ D83C 32 59 D9         LD (.cbtSpX), A
2378+ D83F 23               INC HL
