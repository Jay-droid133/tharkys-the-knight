2084+ AA7D 21 58 B3         LD HL, StaminaRegenCtr
2085+ AA80 34               INC (HL)
2086+ AA81 7E               LD A, (HL)
2087+ AA82 FE 32            CP STAMINA_REGEN_RATE
2088+ AA84 D8               RET C                               ; Aun no toca
2089+ AA85 36 00            LD (HL), 0                          ; Reset counter
2090+ AA87 3A 56 B3         LD A, (PlayerStamina)
2091+ AA8A 3C               INC A
2092+ AA8B 32 56 B3         LD (PlayerStamina), A
2093+ AA8E C9               RET
2094+ AA8F              .usDrain:
