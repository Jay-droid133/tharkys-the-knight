 915+ FD79
 916+ FD79              ; ==============================================================================
 917+ FD79              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 918+ FD79              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 919+ FD79              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 920+ FD79              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 921+ FD79              ; oscuridad de la rendija".
 922+ FD79              BCS_DOOR_HAND_ATTR      EQU $47
 923+ FD79
 924+ FD79              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 925+ FD79              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 926+ FD79              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 927+ FD79              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 928+ FD79              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 929+ FD79
 930+ FD79              ; ==============================================================================
 931+ FD79              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 932+ FD79              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 933+ FD79              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 934+ FD79              ; pixels visibles bright white sobre fondo negro.
 935+ FD79              ;
 936+ FD79              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 937+ FD79              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 938+ FD79              ; dos llamadas no cancelan, solo re-pintan.
 939+ FD79              ; Destruye: AF, BC, DE, HL, IX.
 940+ FD79              ; ==============================================================================
 941+ FD79              BankCutsceneOpenDoorWithHandAttrs:
 942+ FD79 21 F8 F0         LD HL, BgGfx_bank_door_closed
 943+ FD7C 3E 03            LD A, 3                             ; bank 3
 944+ FD7E CD C2 6C         CALL LoadBgSpriteToBuffer
 945+ FD81 DD 21 F5 86      LD IX, BgSpriteBuffer
 946+ FD85 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 947+ FD87 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 948+ FD89 CD DD DB         CALL DrawBgSpriteXOR                ; XOR-cancel pixels (attrs intactos $78)
 949+ FD8C                  ; Sobreescribir attrs a "hand mode" = $47.
 950+ FD8C 3E 47            LD A, BCS_DOOR_HAND_ATTR
 951+ FD8E 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 952+ FD91 77               LD (HL), A
 953+ FD92 23               INC HL                              ; $58D0 (16, 4)
 954+ FD93 77               LD (HL), A
 955+ FD94 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 956+ FD97 77               LD (HL), A
 957+ FD98 23               INC HL                              ; $58F0 (16, 5)
 958+ FD99 77               LD (HL), A
 959+ FD9A C9               RET
 960+ FD9B
 961+ FD9B              ; ==============================================================================
 962+ FD9B              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 963+ FD9B              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 964+ FD9B              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 965+ FD9B              ;
 966+ FD9B              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 967+ FD9B              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 968+ FD9B              ; Destruye: AF, BC, DE, HL, IX.
 969+ FD9B              ; ==============================================================================
 970+ FD9B              BankCutsceneCloseDoorRestoreAttrs:
 971+ FD9B 21 F8 F0         LD HL, BgGfx_bank_door_closed
 972+ FD9E 3E 03            LD A, 3
 973+ FDA0 CD C2 6C         CALL LoadBgSpriteToBuffer
 974+ FDA3 DD 21 F5 86      LD IX, BgSpriteBuffer
 975+ FDA7 06 0F            LD B, BCS_DOOR_CHARX
 976+ FDA9 0E 04            LD C, BCS_DOOR_CHARY
 977+ FDAB AF               XOR A
 978+ FDAC 32 D5 E2         LD (BgSpriteIsHouse), A
 979+ FDAF                  ; CurrentTintVar = $FF (no tint). El sprite door tiene tintPaper=7 y attr
 980+ FDAF                  ; paper=7 — si CurrentTintVar fuera 0, ApplyTintSwap pondria paper=0 → todo
 981+ FDAF                  ; negro. Con $FF (= "sin tint") la attr queda intacta a su valor original.
 982+ FDAF 3E FF            LD A, $FF
 983+ FDB1 32 74 D2         LD (CurrentTintVar), A
 984+ FDB4 C3 6A D1         JP DrawBgGfxSprite                  ; SET pixels + PAINT attrs ($78) sin tint
 985+ FDB7
 986+ FDB7              ; ==============================================================================
 987+ FDB7              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 988+ FDB7              ; ==============================================================================
 989+ FDB7              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 990+ FDB7              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 991+ FDB7              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 992+ FDB7              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 993+ FDB7              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 994+ FDB7              ; Destruye: AF, BC, DE, HL, IX.
 995+ FDB7              ; ==============================================================================
 996+ FDB7              BankCutsceneDrawHand:
 997+ FDB7 3A CE 82         LD A, (BankCutsceneHandFrame)
 998+ FDBA B7               OR A
 999+ FDBB 20 05            JR NZ, .bcdhFrame1
1000+ FDBD 21 38 FE         LD HL, BgGfx_BankHandFrame0
1001+ FDC0 18 03            JR .bcdhCopy
1002+ FDC2              .bcdhFrame1:
1003+ FDC2 21 5A FE         LD HL, BgGfx_BankHandFrame1
1004+ FDC5              .bcdhCopy:
1005+ FDC5 11 F5 86         LD DE, BgSpriteBuffer
1006+ FDC8 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
1007+ FDCB ED B0            LDIR
1008+ FDCD 16 30            LD D, BCS_HAND_PX_Y
1009+ FDCF 1E 78            LD E, BCS_HAND_PX_X
1010+ FDD1 C3 31 6B         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
1011+ FDD4
1012+ FDD4              ; ==============================================================================
1013+ FDD4              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
1014+ FDD4              ; ==============================================================================
1015+ FDD4              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
1016+ FDD4              ; Destruye: AF, BC, DE, HL, IX.
1017+ FDD4              ; ==============================================================================
1018+ FDD4              BankCutsceneEraseHand:
1019+ FDD4 C3 B7 FD         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
