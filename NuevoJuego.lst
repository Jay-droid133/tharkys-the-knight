 158+ 9D38              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 159+ 9D38              ; HL = period (12-bit), B = duracion (10ms units).
 160+ 9D38              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 161+ 9D38              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 162+ 9D38              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 163+ 9D38              ; cambiaramos de bank en slot 3 entre el push y el pop).
 164+ 9D38              AY_PlayToneBlocking:
 165+ 9D38 F3               DI
 166+ 9D39                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 167+ 9D39                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 168+ 9D39 5C               LD E, H                     ; E = period high
 169+ 9D3A 3E 01            LD A, 1
 170+ 9D3C 01 FD FF         LD BC, $FFFD
 171+ 9D3F ED 79            OUT (C), A
 172+ 9D41 01 FD BF         LD BC, $BFFD
 173+ 9D44 ED 59            OUT (C), E
 174+ 9D46                  ; R0 = period low
 175+ 9D46 5D               LD E, L                     ; E = period low
 176+ 9D47 3E 00            LD A, 0
 177+ 9D49 01 FD FF         LD BC, $FFFD
 178+ 9D4C ED 79            OUT (C), A
 179+ 9D4E 01 FD BF         LD BC, $BFFD
 180+ 9D51 ED 59            OUT (C), E
