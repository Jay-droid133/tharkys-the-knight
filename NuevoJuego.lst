1686+ F5F1              ; church-cutscene block (lines 1489-2181 originales) movido a code/church_cutscene.asm
1687+ F5F1              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1688+ F5F1
1689+ F5F1              ; ==============================================================================
1690+ F5F1              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1691+ F5F1              ; ==============================================================================
1692+ F5F1              ; Indice (CompassSprites[idx]):
1693+ F5F1              ;   0 = NW    1 = N    2 = NE
1694+ F5F1              ;   3 = W     4 = X    5 = E
1695+ F5F1              ;   6 = SW    7 = S    8 = SE
1696+ F5F1              ; ==============================================================================
1697+ F5F1              CompassSprites:
1698+ F5F1 10 F7            DEFW Sprite_Compass_NW
1699+ F5F3 30 F6            DEFW Sprite_Compass_N
1700+ F5F5 50 F6            DEFW Sprite_Compass_NE
1701+ F5F7 F0 F6            DEFW Sprite_Compass_W
1702+ F5F9 30 F7            DEFW Sprite_Compass_X
1703+ F5FB 70 F6            DEFW Sprite_Compass_E
1704+ F5FD D0 F6            DEFW Sprite_Compass_SW
1705+ F5FF B0 F6            DEFW Sprite_Compass_S
1706+ F601 90 F6            DEFW Sprite_Compass_SE
1707+ F603
1708+ F603              ; ==============================================================================
1709+ F603              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1710+ F603              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1711+ F603              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1712+ F603              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1713+ F603              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1714+ F603              ; ==============================================================================
1715+ F603              CompassWobbleTable:
1716+ F603 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1717+ F607 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1718+ F60B 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1719+ F60F 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1720+ F613 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1721+ F617 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1722+ F61B 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1723+ F61F 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1724+ F623 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1725+ F627
1726+ F627              ; ==============================================================================
1727+ F627              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1728+ F627              ; Indexada por (counter-1) -> 0..8. Valor:
1729+ F627              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1730+ F627              ; Con counter inicial 9 y decremento por frame:
1731+ F627              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1732+ F627              ;   counter 8 -> phase 7 -> prev
1733+ F627              ;   counter 7 -> phase 6 -> target
1734+ F627              ;   counter 6 -> phase 5 -> next
1735+ F627              ;   counter 5 -> phase 4 -> next2
1736+ F627              ;   counter 4 -> phase 3 -> prev
1737+ F627              ;   counter 3 -> phase 2 -> target
1738+ F627              ;   counter 2 -> phase 1 -> prev
1739+ F627              ;   counter 1 -> phase 0 -> target (estado final, settle)
1740+ F627              ; ==============================================================================
1741+ F627              WobblePhaseTable:
1742+ F627 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1742+ F62B 04 03 02 01
1742+ F62F 00
1743+ F630
1744+ F630              ; Sprites importados de References/flechas02 (16x16, esfera roja con flecha)
1745+ F630              Sprite_Compass_N:
1746+ F630 03 40 0A D0      DEFB $03,$40, $0A,$D0, $1A,$58, $30,$0C
1746+ F634 1A 58 30 0C
1747+ F638 61 86 61 86      DEFB $61,$86, $61,$86, $01,$80, $C3,$C3
1747+ F63C 01 80 C3 C3
1748+ F640 C3 C3 07 E0      DEFB $C3,$C3, $07,$E0, $67,$E6, $63,$C6
1748+ F644 67 E6 63 C6
1749+ F648 30 0C 1C 38      DEFB $30,$0C, $1C,$38, $0D,$B0, $01,$80
1749+ F64C 0D B0 01 80
