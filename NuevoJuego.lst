2622+ D9FF              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2623+ D9FF              ; ==============================================================================
2624+ D9FF              ; IN:  DE = BgGfx pointer
2625+ D9FF              ; OUT: A = 0 (normal), 1..7 (key), 8..13 (lock con key requerida = A-7)
2626+ D9FF              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2627+ D9FF              ; ==============================================================================
2628+ D9FF              GetPickupKeyBehavior:
2629+ D9FF E5               PUSH HL
2630+ DA00 C5               PUSH BC
2631+ DA01 21 45 D7         LD HL, KeyLockTable
2632+ DA04 06 0D            LD B, 13                    ; 13 slots (insertado BankCheck en slot 7)
2633+ DA06 0E 01            LD C, 1                     ; id actual (1..13)
2634+ DA08              .gpkbLoop:
2635+ DA08 7E               LD A, (HL)                  ; ptr_lo del slot
2636+ DA09 BB               CP E
2637+ DA0A 20 06            JR NZ, .gpkbNext
2638+ DA0C 23               INC HL
2639+ DA0D 7E               LD A, (HL)                  ; ptr_hi
2640+ DA0E 2B               DEC HL
2641+ DA0F BA               CP D
2642+ DA10 28 09            JR Z, .gpkbFound
2643+ DA12              .gpkbNext:
2644+ DA12 23               INC HL
2645+ DA13 23               INC HL                      ; siguiente slot (DEFW = 2 bytes)
2646+ DA14 0C               INC C
2647+ DA15 10 F1            DJNZ .gpkbLoop
2648+ DA17 AF               XOR A                       ; no encontrado → comportamiento normal
2649+ DA18 C1               POP BC
2650+ DA19 E1               POP HL
2651+ DA1A C9               RET
