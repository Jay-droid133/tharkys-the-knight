2212+ DA48              ; RedrawPickupByPtr - Localiza un pickup por su ptr en PickupTable y lo dibuja.
2213+ DA48              ; ==============================================================================
2214+ DA48              ; IN:  DE = BgGfx ptr del sprite a redibujar.
2215+ DA48              ; Si la entry está activa (no $FE) y en la pantalla actual, carga el sprite
2216+ DA48              ; al BgSpriteBuffer y lo pinta con XOR + DrawBgAttrOnly. Si no la encuentra,
2217+ DA48              ; retorna sin hacer nada. Usado en .cbtActTownHall para revelar la church_key
2218+ DA48              ; (que estaba dormant) sin re-renderizar la pantalla.
2219+ DA48              ; Destruye: A, BC, DE, HL.
2220+ DA48              ; ==============================================================================
2221+ DA48              RedrawPickupByPtr:
2222+ DA48 21 5D E1         LD HL, PickupTable
2223+ DA4B              .rpbpLoop:
2224+ DA4B 7E               LD A, (HL)
2225+ DA4C FE FF            CP $FF
2226+ DA4E C8               RET Z                       ; fin de tabla, no encontrado
2227+ DA4F FE FE            CP $FE
2228+ DA51 28 41            JR Z, .rpbpSkipInactive
2229+ DA53 47               LD B, A                     ; mapX
2230+ DA54 23               INC HL
2231+ DA55 3A 08 83         LD A, (CurrentScreenX)
2232+ DA58 B8               CP B
2233+ DA59 20 3F            JR NZ, .rpbpSkipMapY
2234+ DA5B 4E               LD C, (HL)                  ; mapY
2235+ DA5C 23               INC HL
2236+ DA5D 3A 09 83         LD A, (CurrentScreenY)
2237+ DA60 B9               CP C
2238+ DA61 20 3D            JR NZ, .rpbpSkipPtr
2239+ DA63                  ; HL en ptr_lo. Comparar ptr con DE.
2240+ DA63 7E               LD A, (HL)
2241+ DA64 BB               CP E
2242+ DA65 20 39            JR NZ, .rpbpSkipPtr
2243+ DA67 23               INC HL                      ; HL en ptr_hi
2244+ DA68 7E               LD A, (HL)
2245+ DA69 BA               CP D
2246+ DA6A 20 3A            JR NZ, .rpbpSkipPtrHi
2247+ DA6C                  ; Match. HL en ptr_hi. Avanzar a charX/charY/tint.
2248+ DA6C 23               INC HL                      ; HL en charX
2249+ DA6D 46               LD B, (HL)                  ; charX
2250+ DA6E 23               INC HL                      ; HL en charY
2251+ DA6F 4E               LD C, (HL)                  ; charY
2252+ DA70 23               INC HL                      ; HL en tint
2253+ DA71 7E               LD A, (HL)
2254+ DA72 32 D8 D4         LD (CurrentTintVar), A      ; tint correcto del placement (255 = sin tint)
