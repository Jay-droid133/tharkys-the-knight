2397+ DB3A BA               CP D
2398+ DB3B D2 25 DC         JP NC, .cbtPopNext              ; ext_left >= player_right → fuera por la izquierda
2399+ DB3E                  ; ext_right: sprite_right + 4 con clamp superior
2400+ DB3E 3A 3D DC         LD A, (.cbtSpW)
2401+ DB41 47               LD B, A
2402+ DB42 3A 3B DC         LD A, (.cbtSpX)
2403+ DB45 80               ADD A, B                        ; sprite_right
2404+ DB46 C6 04            ADD A, 4                        ; +4
2405+ DB48 30 02            JR NC, .cbtNoOverflowR
2406+ DB4A 3E FF            LD A, $FF
2407+ DB4C              .cbtNoOverflowR:
2408+ DB4C B9               CP C
2409+ DB4D DA 25 DC         JP C, .cbtPopNext               ; ext_right < player_left → fuera por la derecha
2410+ DB50                  ; Vertical
2411+ DB50 3A 9F 81         LD A, (EntityTable + ENT_POSY)
2412+ DB53 4F               LD C, A
2413+ DB54 C6 10            ADD A, 16
2414+ DB56 57               LD D, A
2415+ DB57 3A 3C DC         LD A, (.cbtSpY)
2416+ DB5A D6 04            SUB 4
2417+ DB5C 30 01            JR NC, .cbtNoUnderflowT
2418+ DB5E AF               XOR A
2419+ DB5F              .cbtNoUnderflowT:
2420+ DB5F BA               CP D
2421+ DB60 D2 25 DC         JP NC, .cbtPopNext
2422+ DB63 3A 3E DC         LD A, (.cbtSpH)
2423+ DB66 47               LD B, A
2424+ DB67 3A 3C DC         LD A, (.cbtSpY)
2425+ DB6A 80               ADD A, B
2426+ DB6B C6 04            ADD A, 4
2427+ DB6D 30 02            JR NC, .cbtNoOverflowB
