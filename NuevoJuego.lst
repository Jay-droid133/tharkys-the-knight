 206  F918                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F918              ; ==============================================================================
   2+ F918              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F918              ; ==============================================================================
   4+ F918              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F918              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F918              ;
   7+ F918              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F918              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F918              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F918              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F918              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F918              ; ==============================================================================
  13+ F918
  14+ F918              ; ==============================================================================
  15+ F918              ; PlaySFX - Reproduce un efecto de sonido
  16+ F918              ; ==============================================================================
  17+ F918              ; Entrada: HL = puntero a datos del efecto
  18+ F918              ; Modifica: AF, BC, DE, HL
  19+ F918              ; ==============================================================================
  20+ F918              PlaySFX:
  21+ F918 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F919 3A 90 90         LD A, (CurrentBorderColor)
  23+ F91C E6 07            AND $07                     ; Solo bits de color del borde
  24+ F91E 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F91F
  26+ F91F              .nextStep:
  27+ F91F 7E               LD A, (HL)                  ; Leer duration
  28+ F920 B7               OR A
  29+ F921 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F923
  31+ F923 47               LD B, A                     ; B = duration (bucle externo)
  32+ F924 23               INC HL
  33+ F925 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F926 23               INC HL
  35+ F927 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F928 23               INC HL
  37+ F929 7E               LD A, (HL)                  ; A = flags
  38+ F92A 23               INC HL
  39+ F92B E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F92C CB 47            BIT 0, A
  41+ F92E 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F930
  43+ F930              ; --- Bucle de tono normal ---
  44+ F930              .toneLoop:
  45+ F930                  ; Semi-periodo HIGH
  46+ F930 7B               LD A, E
  47+ F931 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F933 D3 FE            OUT ($FE), A
  49+ F935 79               LD A, C                     ; A = pitch actual
  50+ F936              .toneDelayHi:
  51+ F936 3D               DEC A
  52+ F937 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F939
  54+ F939                  ; Semi-periodo LOW
  55+ F939 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F93A D3 FE            OUT ($FE), A
  57+ F93C 79               LD A, C
  58+ F93D              .toneDelayLo:
  59+ F93D 3D               DEC A
  60+ F93E 20 FD            JR NZ, .toneDelayLo
  61+ F940
  62+ F940                  ; Aplicar pitch sweep
  63+ F940 79               LD A, C
  64+ F941 82               ADD A, D                    ; pitch += pitchDelta
  65+ F942 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F944 FA 4C F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F947 4F               LD C, A
  68+ F948              .toneAfterClamp:
  69+ F948 10 E6            DJNZ .toneLoop
  70+ F94A 18 30            JR .stepDone
  71+ F94C
  72+ F94C              .toneClamp:
  73+ F94C 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F94E 18 F8            JR .toneAfterClamp
  75+ F950
  76+ F950              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F950              .noiseLoop:
  78+ F950                  ; Semi-periodo HIGH con ruido
  79+ F950 7B               LD A, E
  80+ F951 F6 10            OR $10
  81+ F953 D3 FE            OUT ($FE), A
  82+ F955 ED 5F            LD A, R                     ; R register como PRNG
  83+ F957 A9               XOR C                       ; mezclar con pitch base
  84+ F958 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F95A F6 01            OR $01                      ; minimo 1
  86+ F95C              .noiseDelayHi:
  87+ F95C 3D               DEC A
  88+ F95D 20 FD            JR NZ, .noiseDelayHi
  89+ F95F
  90+ F95F                  ; Semi-periodo LOW
  91+ F95F 7B               LD A, E
  92+ F960 D3 FE            OUT ($FE), A
  93+ F962 ED 5F            LD A, R
  94+ F964 A9               XOR C
  95+ F965 E6 1F            AND $1F
  96+ F967 F6 01            OR $01
  97+ F969              .noiseDelayLo:
  98+ F969 3D               DEC A
  99+ F96A 20 FD            JR NZ, .noiseDelayLo
 100+ F96C
 101+ F96C                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F96C 79               LD A, C
 103+ F96D 82               ADD A, D
 104+ F96E 28 08            JR Z, .noiseClamp
 105+ F970 FA 78 F9         JP M, .noiseClamp
 106+ F973 4F               LD C, A
 107+ F974              .noiseAfterClamp:
 108+ F974 10 DA            DJNZ .noiseLoop
 109+ F976 18 04            JR .stepDone
 110+ F978
 111+ F978              .noiseClamp:
 112+ F978 0E 01            LD C, 1
 113+ F97A 18 F8            JR .noiseAfterClamp
 114+ F97C
 115+ F97C              .stepDone:
 116+ F97C E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F97D 18 A0            JR .nextStep
 118+ F97F
 119+ F97F              .done:
 120+ F97F 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F980 D3 FE            OUT ($FE), A
 122+ F982 FB               EI
 123+ F983 C9               RET
 124+ F984
 125+ F984              ; ==============================================================================
 126+ F984              ; DATOS DE EFECTOS DE SONIDO
 127+ F984              ; ==============================================================================
 128+ F984
 129+ F984              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F984              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F984              SFX_FootstepTic:
 132+ F984 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F988 00               DEFB 0                      ; fin
 134+ F989
 135+ F989              SFX_FootstepTac:
 136+ F989 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ F98D 00               DEFB 0                      ; fin
 138+ F98E
 139+ F98E              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 140+ F98E              ; Dos pasos: sweep rapido de agudo a grave
 141+ F98E              SFX_Attack:
 142+ F98E 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 143+ F992 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 144+ F996 00               DEFB 0                      ; fin
 145+ F997
 146+ F997              ; --- SFX_EnemyDeath: "explosion" con ruido (~100ms) ---
 147+ F997              ; Ruido percusivo seguido de tono descendente
 148+ F997              SFX_EnemyDeath:
 149+ F997 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ F99B 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ F99F 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ F9A3 00               DEFB 0                      ; fin
 153+ F9A4
 154+ F9A4              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 155+ F9A4              ; Tono ascendente rapido seguido de ruido seco
 156+ F9A4              SFX_PlayerHit:
 157+ F9A4 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 158+ F9A8 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 159+ F9AC 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 160+ F9B0 00               DEFB 0                      ; fin
 161+ F9B1
 162+ F9B1              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
 163+ F9B1              ; Tres tonos escalonados ascendentes
 164+ F9B1              SFX_ScreenTransition:
 165+ F9B1 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 166+ F9B5 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 167+ F9B9 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 168+ F9BD 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 169+ F9C1 00               DEFB 0                      ; fin
 170+ F9C2
 171+ F9C2              ; --- SFX_EnemySpawn: "pop" ascendente + crackle (~70ms) ---
 172+ F9C2              ; Tono rapido ascendente y crujido
 173+ F9C2              SFX_EnemySpawn:
 174+ F9C2 19 23 FE 00      DEFB 25, 35, -2, 0         ; tono ascendente rapido
 175+ F9C6 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 176+ F9CA 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 177+ F9CE 00               DEFB 0                      ; fin
 178+ F9CF
 179+ F9CF              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 180+ F9CF              ; Tres escalones ascendentes, tipo recarga
 181+ F9CF              SFX_WellRecover:
 182+ F9CF 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 183+ F9D3 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 184+ F9D7 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 185+ F9DB 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 186+ F9DF 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
 187+ F9E3 3C 0C FF 00      DEFB 60, 12, -1, 0         ; sweep ascendente
 188+ F9E7 28 08 00 00      DEFB 40, 8, 0, 0           ; agudo brillante sostenido
 189+ F9EB 00               DEFB 0                      ; fin
