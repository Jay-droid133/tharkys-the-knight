 471+ 8FA5 FE 05            CP STATE_SCARED
 472+ 8FA7 20 0B            JR NZ, .dsmNext
 473+ 8FA9 CD 55 8F         CALL WipeMonsterSlot
 474+ 8FAC DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 8FB0 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
