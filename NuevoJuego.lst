2617+ AD11                  ; --- Movimiento vertical ---
2618+ AD11 DD 7E 04         LD A, (IX+ENT_POSY)
2619+ AD14 32 98 AD         LD (.savedEY), A
2620+ AD17 47               LD B, A
2621+ AD18 DD 7E 07         LD A, (IX+ENT_DELTAY)
2622+ AD1B 4F               LD C, A
2623+ AD1C CB 79            BIT 7, C
2624+ AD1E 20 0A            JR NZ, .eDeltaYNeg
2625+ AD20 78               LD A, B
2626+ AD21 81               ADD A, C
2627+ AD22 FE A8            CP SCREEN_MAX_Y
2628+ AD24 38 14            JR C, .eClampYOk
2629+ AD26 3E A7            LD A, SCREEN_MAX_Y - 1
