 845+ D201                  ; ===================== PATH RLE =====================
 846+ D201                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 847+ D201                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 848+ D201                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 849+ D201                  ; El estado .rlePending conserva el chunk entre filas:
 850+ D201                  ;   0 = necesita nuevo token
 851+ D201                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 852+ D201                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 853+ D201              .rlePixRow:
 854+ D201 3A AC D2         LD A, (.widthVal)
 855+ D204 47               LD B, A
 856+ D205 E5               PUSH HL                     ; guardar inicio de fila VRAM
 857+ D206
 858+ D206              .rlePixCol:
 859+ D206 3A B0 D2         LD A, (.rlePending)
 860+ D209 B7               OR A
 861+ D20A CA 21 D2         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 862+ D20D FA 2F D2         JP M, .rleLitEmit           ; <0 = literal group en curso
 863+ D210                  ; >0 = run en curso, emitir valor
 864+ D210              .rleRunEmit:
 865+ D210 3A B1 D2         LD A, (.rleValue)
 866+ D213 2F               CPL
 867+ D214 77               LD (HL), A
 868+ D215 23               INC HL
 869+ D216 3A B0 D2         LD A, (.rlePending)
 870+ D219 3D               DEC A
 871+ D21A 32 B0 D2         LD (.rlePending), A
 872+ D21D 10 E7            DJNZ .rlePixCol
 873+ D21F 18 32            JR .rleRowDone
 874+ D221
 875+ D221              .rleNewToken:
 876+ D221 DD 7E 00         LD A, (IX+0)
 877+ D224 DD 23            INC IX
 878+ D226 CB 7F            BIT 7, A
 879+ D228 20 18            JR NZ, .rleNewRun
 880+ D22A                  ; --- Literal group: A = count (1-127) ---
 881+ D22A ED 44            NEG                         ; A = -count (negativo)
 882+ D22C 32 B0 D2         LD (.rlePending), A
 883+ D22F                  ; fall through: emitir primer byte literal
 884+ D22F
 885+ D22F              .rleLitEmit:
 886+ D22F DD 7E 00         LD A, (IX+0)
 887+ D232 DD 23            INC IX
 888+ D234 2F               CPL
 889+ D235 77               LD (HL), A
 890+ D236 23               INC HL
 891+ D237 3A B0 D2         LD A, (.rlePending)
 892+ D23A 3C               INC A                       ; hacia 0
 893+ D23B 32 B0 D2         LD (.rlePending), A
 894+ D23E 10 C6            DJNZ .rlePixCol
 895+ D240 18 11            JR .rleRowDone
 896+ D242
 897+ D242                  ; --- Run: count = (A & $7F) + 2 ---
 898+ D242              .rleNewRun:
 899+ D242 E6 7F            AND $7F
 900+ D244 C6 02            ADD A, 2
 901+ D246 32 B0 D2         LD (.rlePending), A
 902+ D249 DD 7E 00         LD A, (IX+0)
 903+ D24C DD 23            INC IX
 904+ D24E 32 B1 D2         LD (.rleValue), A
 905+ D251 18 BD            JR .rleRunEmit
 906+ D253
 907+ D253              .rleRowDone:
 908+ D253 E1               POP HL                      ; restaurar inicio fila
 909+ D254 3A AB D2         LD A, (.heightCnt)
 910+ D257 3D               DEC A
 911+ D258 32 AB D2         LD (.heightCnt), A
 912+ D25B 28 05            JR Z, .pixDone
 913+ D25D CD CB 9A         CALL NextPixelLine
 914+ D260 18 9F            JR .rlePixRow
