 120+ 9901              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 121+ 9901              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 122+ 9901              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 123+ 9901              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 124+ 9901              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 125+ 9901              AY_OverrideBellPeriod:
 126+ 9901 F3               DI
 127+ 9902                  ; R0 = period low (canal A)
 128+ 9902 5D               LD E, L
 129+ 9903 3E 00            LD A, 0
 130+ 9905 01 FD FF         LD BC, $FFFD
 131+ 9908 ED 79            OUT (C), A
 132+ 990A 01 FD BF         LD BC, $BFFD
 133+ 990D ED 59            OUT (C), E
