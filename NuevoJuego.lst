 108+ 9C4A              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 109+ 9C4A              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 110+ 9C4A              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 111+ 9C4A              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 112+ 9C4A              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 113+ 9C4A              AY_OverrideBellPeriod:
 114+ 9C4A F3               DI
 115+ 9C4B                  ; R0 = period low (canal A)
 116+ 9C4B 5D               LD E, L
 117+ 9C4C 3E 00            LD A, 0
 118+ 9C4E 01 FD FF         LD BC, $FFFD
 119+ 9C51 ED 79            OUT (C), A
 120+ 9C53 01 FD BF         LD BC, $BFFD
 121+ 9C56 ED 59            OUT (C), E
 122+ 9C58                  ; R1 = period high (canal A)
 123+ 9C58 5C               LD E, H
 124+ 9C59 3E 01            LD A, 1
 125+ 9C5B 01 FD FF         LD BC, $FFFD
 126+ 9C5E ED 79            OUT (C), A
 127+ 9C60 01 FD BF         LD BC, $BFFD
 128+ 9C63 ED 59            OUT (C), E
 129+ 9C65                  ; R2/R3 (canal B)
 130+ 9C65 5D               LD E, L
 131+ 9C66 3E 02            LD A, 2
 132+ 9C68 01 FD FF         LD BC, $FFFD
 133+ 9C6B ED 79            OUT (C), A
 134+ 9C6D 01 FD BF         LD BC, $BFFD
 135+ 9C70 ED 59            OUT (C), E
 136+ 9C72 5C               LD E, H
 137+ 9C73 3E 03            LD A, 3
 138+ 9C75 01 FD FF         LD BC, $FFFD
 139+ 9C78 ED 79            OUT (C), A
 140+ 9C7A 01 FD BF         LD BC, $BFFD
 141+ 9C7D ED 59            OUT (C), E
 142+ 9C7F                  ; R4/R5 (canal C)
 143+ 9C7F 5D               LD E, L
 144+ 9C80 3E 04            LD A, 4
 145+ 9C82 01 FD FF         LD BC, $FFFD
 146+ 9C85 ED 79            OUT (C), A
 147+ 9C87 01 FD BF         LD BC, $BFFD
 148+ 9C8A ED 59            OUT (C), E
 149+ 9C8C 5C               LD E, H
 150+ 9C8D 3E 05            LD A, 5
 151+ 9C8F 01 FD FF         LD BC, $FFFD
 152+ 9C92 ED 79            OUT (C), A
 153+ 9C94 01 FD BF         LD BC, $BFFD
 154+ 9C97 ED 59            OUT (C), E
 155+ 9C99 FB               EI
 156+ 9C9A C9               RET
