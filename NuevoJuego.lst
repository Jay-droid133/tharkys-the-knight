 121  6D7F
 122  6D7F                  ; ==========================================================================
 123  6D7F                  ; ORG $8000 - codigo principal (no-contended)
 124  6D7F                  ; ==========================================================================
 125  6D7F                  ORG ORIGIN_ADDRESS
 126  8000
 127  8000              ; ==============================================================================
 128  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 129  8000              ; ==============================================================================
 130  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 131  8000              ;   erase viejo → AI/movimiento → draw nuevo
 132  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 133  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 134  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 135  8000              ; ==============================================================================
 136  8000              MainLoop:
 137  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 138  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 139  8003 47               LD B, A                     ; B = tick actual
 140  8004
 141  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 142  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 143  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 144  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 145  8004 78               LD A, B
 146  8005 21 32 81         LD HL, .frameStart
 147  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 148  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 149  800A 21 C9 9D         LD HL, TickRemainder
 150  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 151  800E 4F               LD C, A
 152  800F E6 01            AND $01
 153  8011 77               LD (HL), A                  ; new remainder = total mod 2
 154  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 155  8014 79               LD A, C
 156  8015 32 C8 9D         LD (FramesElapsed), A
 157  8018
 158  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 159  8018 CD D9 CE         CALL UpdateDeathBorder
 160  801B CD AA CE         CALL UpdateDeathAnim
 161  801E                  ; UpdateMusic vive aqui (no en .skipUpdates) para que las pistas tabulares
 162  801E                  ; suenen tambien durante cutscenes (TownGatePhase!=0) y GameOver. Cada
 163  801E                  ; llamada hace catchup interno via FramesElapsed (loop de N iteraciones).
 164  801E CD A3 9C         CALL UpdateMusic
