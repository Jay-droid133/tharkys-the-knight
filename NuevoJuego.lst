7108+ C69D              ; --- CheckDeathTouchPlayer: AABB completo 24x24 vs player (no margen) ---
7109+ C69D              ; Si overlap: PlayerHealth=0, erase sprite, despawn.
7110+ C69D              CheckDeathTouchPlayer:
7111+ C69D 3A F3 82         LD A, (DeathSpawned)
7112+ C6A0 B7               OR A
7113+ C6A1 C8               RET Z
7114+ C6A2 DD 21 44 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7115+ C6A6 DD 7E 01         LD A, (IX+ENT_TYPE)
7116+ C6A9 B7               OR A
7117+ C6AA C8               RET Z
7118+ C6AB                  ; Invulnerable SOLO durante el countdown phase 1 (sin control). NO durante
7119+ C6AB                  ; phase 2 (grace post-respawn O post-nasty-hit) — la phase 2 se setea tambien
7120+ C6AB                  ; al recibir un hit de nasty (EnterGracePhase desde .pHpDmgNotZero), y eso
7121+ C6AB                  ; daba 1s en el que Death te seguia pegada sin matarte. Death es instakill
7122+ C6AB                  ; sin importar inmunidades temporales. En el path post-respawn legitimo,
7123+ C6AB                  ; SilentKillDeath ya la despawneo, asi que no hay riesgo de instakill al
7124+ C6AB                  ; recuperar control.
7125+ C6AB 3A E4 82         LD A, (PlayerRespawnPhase)
7126+ C6AE FE 01            CP 1
7127+ C6B0 C8               RET Z
7128+ C6B1
7129+ C6B1                  ; Player rect canonico: 16w x 21h (no usar GetSpriteDims — algunos frames
7130+ C6B1                  ; de animacion tienen altura menor y el AABB Y-axis fallaria). Ver
7131+ C6B1                  ; project_player_collision_rect.md.
7132+ C6B1 3E 15            LD A, 21
7133+ C6B3 32 FE C6         LD (.cdtPH), A
7134+ C6B6
7135+ C6B6                  ; --- AABB X: deathX..deathX+23 vs playerX..playerX+15 ---
7136+ C6B6                  ; cond1: deathX + 24 > playerX
7137+ C6B6 DD 7E 03         LD A, (IX+ENT_POSX)
7138+ C6B9 C6 18            ADD A, 24
7139+ C6BB 38 06            JR C, .cdtX2                        ; overflow → asume verdad
7140+ C6BD 57               LD D, A
7141+ C6BE 3A 97 81         LD A, (EntityTable + ENT_POSX)
7142+ C6C1 BA               CP D
7143+ C6C2 D0               RET NC                              ; playerX >= deathX+24 → no overlap
7144+ C6C3              .cdtX2:
7145+ C6C3                  ; cond2: playerX + 16 > deathX
7146+ C6C3 3A 97 81         LD A, (EntityTable + ENT_POSX)
7147+ C6C6 C6 10            ADD A, 16
7148+ C6C8 38 06            JR C, .cdtY1
7149+ C6CA 57               LD D, A
7150+ C6CB DD 7E 03         LD A, (IX+ENT_POSX)
7151+ C6CE BA               CP D
7152+ C6CF D0               RET NC                              ; deathX >= playerX+16 → no overlap
7153+ C6D0
7154+ C6D0              .cdtY1:
7155+ C6D0                  ; cond3: deathY + 24 > playerY
7156+ C6D0 DD 7E 04         LD A, (IX+ENT_POSY)
7157+ C6D3 C6 18            ADD A, 24
7158+ C6D5 38 06            JR C, .cdtY2
7159+ C6D7 57               LD D, A
7160+ C6D8 3A 98 81         LD A, (EntityTable + ENT_POSY)
7161+ C6DB BA               CP D
7162+ C6DC D0               RET NC
7163+ C6DD
7164+ C6DD              .cdtY2:
