1130+ A525              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A525              ; ==============================================================================
1132+ A525              ; Entrada: A = SpriteID
1133+ A525              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A525              ; Destruye: A, DE, HL
1135+ A525              ; ==============================================================================
1136+ A525              GetSpriteDims:
1137+ A525                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A525                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A525 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A526 26 00            LD H, 0
1141+ A528 3A 84 8D         LD A, (CurrentPaging)
1142+ A52B E6 F8            AND $F8
1143+ A52D F6 06            OR 6
1144+ A52F 32 84 8D         LD (CurrentPaging), A
1145+ A532 01 FD 7F         LD BC, $7FFD
1146+ A535 ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A537 29               ADD HL, HL
1148+ A538 11 B7 E7         LD DE, SpriteFrameTable
1149+ A53B 19               ADD HL, DE
1150+ A53C 5E               LD E, (HL)
1151+ A53D 23               INC HL
1152+ A53E 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A53F 1A               LD A, (DE)                  ; width_bytes
1154+ A540 87               ADD A, A
1155+ A541 87               ADD A, A
1156+ A542 87               ADD A, A                    ; × 8 = width_px
1157+ A543 47               LD B, A
1158+ A544 13               INC DE
1159+ A545 1A               LD A, (DE)                  ; height_px
1160+ A546 4F               LD C, A
1161+ A547                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A547 78               LD A, B
1163+ A548 32 65 A5         LD (GsdSavedB), A
1164+ A54B 79               LD A, C
1165+ A54C 32 66 A5         LD (GsdSavedC), A
1166+ A54F 3A 84 8D         LD A, (CurrentPaging)
1167+ A552 E6 F8            AND $F8
1168+ A554 32 84 8D         LD (CurrentPaging), A
1169+ A557 01 FD 7F         LD BC, $7FFD
1170+ A55A ED 79            OUT (C), A                  ; bank 0 de vuelta
1171+ A55C 3A 65 A5         LD A, (GsdSavedB)
1172+ A55F 47               LD B, A
1173+ A560 3A 66 A5         LD A, (GsdSavedC)
1174+ A563 4F               LD C, A
1175+ A564 C9               RET
1176+ A565
1177+ A565 00           GsdSavedB: DEFB 0
1178+ A566 00           GsdSavedC: DEFB 0
