   9+ E45D              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E45D              ;   R2/R3: tono canal B
  11+ E45D              ;   R4/R5: tono canal C
  12+ E45D              ;   R6:    period del ruido (5 bits)
  13+ E45D              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E45D              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E45D              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E45D              ;   R9:    volumen B
  17+ E45D              ;   R10:   volumen C
  18+ E45D              ;   R11/R12: period del envelope
  19+ E45D              ;   R13:   forma del envelope (0-15)
  20+ E45D              ; ==============================================================================
  21+ E45D
  22+ E45D              ; ==============================================================================
  23+ E45D              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E45D              ; ==============================================================================
  25+ E45D              ; Entrada: A = registro (0-13), E = valor
  26+ E45D              ; Destruye: BC, A
  27+ E45D              ; ==============================================================================
  28+ E45D              AY_WriteReg:
  29+ E45D 01 FD FF         LD BC, $FFFD
  30+ E460 ED 79            OUT (C), A                  ; seleccionar registro
  31+ E462 01 FD BF         LD BC, $BFFD
  32+ E465 ED 59            OUT (C), E                  ; escribir valor
  33+ E467 C9               RET
  34+ E468
  35+ E468              ; ==============================================================================
  36+ E468              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E468              ; ==============================================================================
  38+ E468              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E468              ; ==============================================================================
  40+ E468              AY_StopImpl:
  41+ E468 3E 08            LD A, 8
  42+ E46A 1E 00            LD E, 0
  43+ E46C CD 5D E4         CALL AY_WriteReg
  44+ E46F 3E 09            LD A, 9
  45+ E471 1E 00            LD E, 0
  46+ E473 CD 5D E4         CALL AY_WriteReg
  47+ E476 3E 0A            LD A, 10
  48+ E478 1E 00            LD E, 0
  49+ E47A CD 5D E4         CALL AY_WriteReg
  50+ E47D C9               RET
  51+ E47E
  52+ E47E              ; ==============================================================================
  53+ E47E              ; AY_Init - Silencia todos los canales (volumen 0, mixer todo off)
  54+ E47E              ; ==============================================================================
  55+ E47E              AY_InitImpl:
  56+ E47E 3E 07            LD A, 7                     ; mixer
  57+ E480 1E 3F            LD E, $3F                   ; todos los tonos y ruidos en off
  58+ E482 CD 5D E4         CALL AY_WriteReg
  59+ E485 3E 08            LD A, 8                     ; volumen A
  60+ E487 1E 00            LD E, 0
  61+ E489 CD 5D E4         CALL AY_WriteReg
  62+ E48C 3E 09            LD A, 9                     ; volumen B
  63+ E48E 1E 00            LD E, 0
  64+ E490 CD 5D E4         CALL AY_WriteReg
  65+ E493 3E 0A            LD A, 10                    ; volumen C
  66+ E495 1E 00            LD E, 0
  67+ E497 CD 5D E4         CALL AY_WriteReg
  68+ E49A C9               RET
  69+ E49B
  70+ E49B              ; ==============================================================================
  71+ E49B              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  72+ E49B              ; ==============================================================================
  73+ E49B              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  74+ E49B              ; el AY toca solo durante el decay.
  75+ E49B              ; ==============================================================================
  76+ E49B              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  77+ E49B              ; ==============================================================================
  78+ E49B              ; ==============================================================================
  79+ E49B              ; Variables del decay manual de la campana (con pan estereo)
  80+ E49B              ; ==============================================================================
  81+ E49B              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  82+ E49B              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  83+ E49B              ; Cuando los 3 son 0, la campana esta silenciada.
  84+ E49B 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  85+ E49C 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  86+ E49D 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  87+ E49E 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  88+ E49F
  89+ E49F              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  90+ E49F
  91+ E49F              ; ==============================================================================
  92+ E49F              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  93+ E49F              ; ==============================================================================
  94+ E49F              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  95+ E49F              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  96+ E49F              ; ==============================================================================
  97+ E49F              AY_PlayBellChimeImpl:
  98+ E49F                  ; --- Calcular dx (signed) y |dx|, |dy| ---
  99+ E49F 3A 08 82         LD A, (CurrentScreenX)
 100+ E4A2 D6 07            SUB START_SCREEN_X          ; A = dx (signed: + plaza al oeste, - plaza al este)
 101+ E4A4 57               LD D, A                     ; D = dx signed (player - plaza)
 102+ E4A5 30 02            JR NC, .absDxOk
 103+ E4A7 ED 44            NEG
 104+ E4A9              .absDxOk:
 105+ E4A9 47               LD B, A                     ; B = |dx|
 106+ E4AA
 107+ E4AA 3A 09 82         LD A, (CurrentScreenY)
 108+ E4AD D6 0F            SUB START_SCREEN_Y
 109+ E4AF 30 02            JR NC, .absDyOk
 110+ E4B1 ED 44            NEG
 111+ E4B3              .absDyOk:
 112+ E4B3 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 113+ E4B4 4F               LD C, A                     ; C = distancia
 114+ E4B5
 115+ E4B5                  ; --- Volumen total = max(15 - dist*2, 1) ---
 116+ E4B5 87               ADD A, A                    ; A = dist * 2
 117+ E4B6 47               LD B, A
 118+ E4B7 3E 0F            LD A, 15
 119+ E4B9 90               SUB B                       ; A = 15 - dist*2
 120+ E4BA 30 02            JR NC, .volTotalOk
 121+ E4BC 3E 01            LD A, 1
 122+ E4BE              .volTotalOk:
 123+ E4BE B7               OR A
 124+ E4BF 20 02            JR NZ, .volTotalSet
 125+ E4C1 3E 01            LD A, 1
 126+ E4C3              .volTotalSet:
 127+ E4C3 47               LD B, A                     ; B = volumen total (1-15)
 128+ E4C4
 129+ E4C4                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 130+ E4C4                  ; D > 0  → player está al ESTE de plaza → plaza al oeste (canal A más fuerte)
 131+ E4C4                  ; D < 0  → player está al OESTE de plaza → plaza al este (canal C más fuerte)
 132+ E4C4                  ; D == 0 → alineado X → canal B
 133+ E4C4 7A               LD A, D
 134+ E4C5 B7               OR A
 135+ E4C6 28 27            JR Z, .panCenter
 136+ E4C8 F2 DD E4         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 137+ E4CB                  ; D < 0: plaza al este → canal C dominante
 138+ E4CB 78               LD A, B                     ; A = vol total
 139+ E4CC 32 9D E4         LD (BellVolR), A            ; canal C = full
 140+ E4CF CB 38            SRL B
 141+ E4D1 78               LD A, B
 142+ E4D2 32 9C E4         LD (BellVolC), A            ; canal B = mitad
 143+ E4D5 CB 38            SRL B
 144+ E4D7 78               LD A, B
 145+ E4D8 32 9B E4         LD (BellVolL), A            ; canal A = cuarto
 146+ E4DB 18 1D            JR .panDone
 147+ E4DD
 148+ E4DD              .panLeft:
 149+ E4DD                  ; D > 0: plaza al oeste → canal A dominante
 150+ E4DD 78               LD A, B
 151+ E4DE 32 9B E4         LD (BellVolL), A
 152+ E4E1 CB 38            SRL B
 153+ E4E3 78               LD A, B
 154+ E4E4 32 9C E4         LD (BellVolC), A
 155+ E4E7 CB 38            SRL B
 156+ E4E9 78               LD A, B
 157+ E4EA 32 9D E4         LD (BellVolR), A
 158+ E4ED 18 0B            JR .panDone
 159+ E4EF
 160+ E4EF              .panCenter:
 161+ E4EF                  ; Alineado: solo canal B
 162+ E4EF 78               LD A, B
 163+ E4F0 32 9C E4         LD (BellVolC), A
 164+ E4F3 AF               XOR A
 165+ E4F4 32 9B E4         LD (BellVolL), A
 166+ E4F7 32 9D E4         LD (BellVolR), A
 167+ E4FA
 168+ E4FA              .panDone:
 169+ E4FA 3E 02            LD A, BELL_DECAY_RATE
 170+ E4FC 32 9E E4         LD (BellDecayTimer), A
 171+ E4FF
 172+ E4FF                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 173+ E4FF 3E 00            LD A, 0                     ; R0: tone A LSB
 174+ E501 1E 58            LD E, $58
 175+ E503 CD 5D E4         CALL AY_WriteReg
 176+ E506 3E 01            LD A, 1                     ; R1: tone A MSB
 177+ E508 1E 02            LD E, $02
 178+ E50A CD 5D E4         CALL AY_WriteReg
 179+ E50D 3E 02            LD A, 2                     ; R2: tone B LSB
 180+ E50F 1E 58            LD E, $58
 181+ E511 CD 5D E4         CALL AY_WriteReg
 182+ E514 3E 03            LD A, 3                     ; R3: tone B MSB
 183+ E516 1E 02            LD E, $02
 184+ E518 CD 5D E4         CALL AY_WriteReg
 185+ E51B 3E 04            LD A, 4                     ; R4: tone C LSB
 186+ E51D 1E 58            LD E, $58
 187+ E51F CD 5D E4         CALL AY_WriteReg
 188+ E522 3E 05            LD A, 5                     ; R5: tone C MSB
 189+ E524 1E 02            LD E, $02
 190+ E526 CD 5D E4         CALL AY_WriteReg
 191+ E529
 192+ E529                  ; --- Mixer: tonos A, B, C activos ---
 193+ E529 3E 07            LD A, 7
 194+ E52B 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 195+ E52D CD 5D E4         CALL AY_WriteReg
 196+ E530
 197+ E530                  ; --- Volúmenes iniciales ---
 198+ E530 3E 08            LD A, 8
 199+ E532 21 9B E4         LD HL, BellVolL
 200+ E535 5E               LD E, (HL)
 201+ E536 CD 5D E4         CALL AY_WriteReg
 202+ E539 3E 09            LD A, 9
 203+ E53B 21 9C E4         LD HL, BellVolC
 204+ E53E 5E               LD E, (HL)
 205+ E53F CD 5D E4         CALL AY_WriteReg
 206+ E542 3E 0A            LD A, 10
 207+ E544 21 9D E4         LD HL, BellVolR
 208+ E547 5E               LD E, (HL)
 209+ E548 CD 5D E4         CALL AY_WriteReg
 210+ E54B
 211+ E54B C9               RET
 212+ E54C
 213+ E54C              ; ==============================================================================
 214+ E54C              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 215+ E54C              ; ==============================================================================
 216+ E54C              ; Llamar cada frame desde el main loop.
 217+ E54C              ; ==============================================================================
 218+ E54C              AY_UpdateBellImpl:
 219+ E54C                  ; ¿alguno de los 3 canales aún suena?
 220+ E54C 3A 9B E4         LD A, (BellVolL)
 221+ E54F 47               LD B, A
 222+ E550 3A 9C E4         LD A, (BellVolC)
 223+ E553 B0               OR B
 224+ E554 47               LD B, A
 225+ E555 3A 9D E4         LD A, (BellVolR)
 226+ E558 B0               OR B
 227+ E559 C8               RET Z                       ; los 3 a 0 → silenciado
 228+ E55A
 229+ E55A 21 9E E4         LD HL, BellDecayTimer
 230+ E55D 35               DEC (HL)
 231+ E55E C0               RET NZ                      ; aun no toca decrementar
 232+ E55F
 233+ E55F 3E 02            LD A, BELL_DECAY_RATE
 234+ E561 32 9E E4         LD (BellDecayTimer), A
 235+ E564
 236+ E564                  ; Decrementar canal A (si > 0)
 237+ E564 3A 9B E4         LD A, (BellVolL)
 238+ E567 B7               OR A
 239+ E568 28 0A            JR Z, .skipA
 240+ E56A 3D               DEC A
 241+ E56B 32 9B E4         LD (BellVolL), A
 242+ E56E 5F               LD E, A
 243+ E56F 3E 08            LD A, 8
 244+ E571 CD 5D E4         CALL AY_WriteReg
 245+ E574              .skipA:
 246+ E574
 247+ E574                  ; Decrementar canal B (si > 0)
 248+ E574 3A 9C E4         LD A, (BellVolC)
 249+ E577 B7               OR A
 250+ E578 28 0A            JR Z, .skipB
 251+ E57A 3D               DEC A
 252+ E57B 32 9C E4         LD (BellVolC), A
 253+ E57E 5F               LD E, A
 254+ E57F 3E 09            LD A, 9
 255+ E581 CD 5D E4         CALL AY_WriteReg
 256+ E584              .skipB:
 257+ E584
 258+ E584                  ; Decrementar canal C (si > 0)
 259+ E584 3A 9D E4         LD A, (BellVolR)
 260+ E587 B7               OR A
 261+ E588 C8               RET Z
 262+ E589 3D               DEC A
 263+ E58A 32 9D E4         LD (BellVolR), A
 264+ E58D 5F               LD E, A
 265+ E58E 3E 0A            LD A, 10
 266+ E590 C3 5D E4         JP AY_WriteReg              ; tail call
 267+ E593
 268+ E593              ; ==============================================================================
 269+ E593              ; TENSION MUSIC - "Ti-to-di-to" de organo grave entre lights-off y monster spawn
 270+ E593              ; ==============================================================================
 271+ E593              ; Disparada por UpdateBellsDoneTimer al apagar las ventanas. Reproduce un motivo
 272+ E593              ; corto de 4 notas en el canal A del AY mientras corre el SpawnAfterWinTimer.
 273+ E593              ; Patron tabular dirigido por frame: TensionMusicTable contiene (period_lo,
 274+ E593              ; period_hi, duration_frames) por nota. Marca de fin = duration 0.
 275+ E593              ;
 276+ E593              ; CPU-free durante la reproduccion: solo escribe registros AY al cambiar de nota.
 277+ E593              ; No interfiere con BellVolL/C/R (decay completo antes de lights-off por
 278+ E593              ; POST_BELL_WINDOWS_DELAY = 45f vs decay max 30f).
 279+ E593              ; ==============================================================================
 280+ E593 00 00        TensionMusicPtr:    DEFW 0          ; Ptr a la nota actual en TensionMusicTable
 281+ E595 00           TensionMusicTimer:  DEFB 0          ; Frames restantes en la nota actual (0 = inactivo)
 282+ E596
 283+ E596              ; Tabla: 4 notas en registro grave de organo (A2 - C3 - A2 - D3, ~1.5s total)
 284+ E596              ; Period AY = 1750000 / (16 * frequency). Duraciones en frames a 25fps.
 285+ E596              TensionMusicTable:
 286+ E596 E2 03            DEFW $03E2                      ; A2  ~110 Hz
 287+ E598 09               DEFB 9                          ; ~360ms
 288+ E599 44 03            DEFW $0344                      ; C3  ~131 Hz
 289+ E59B 09               DEFB 9
 290+ E59C E2 03            DEFW $03E2                      ; A2
 291+ E59E 09               DEFB 9
 292+ E59F E9 02            DEFW $02E9                      ; D3  ~147 Hz (climax mas alto)
 293+ E5A1 0B               DEFB 11                         ; ~440ms sostenido
 294+ E5A2 00 00            DEFW 0
 295+ E5A4 00               DEFB 0                          ; fin
 296+ E5A5
 297+ E5A5              ; --- StartTensionMusic: setup canal A + carga primera nota ---
 298+ E5A5              StartTensionMusicImpl:
 299+ E5A5                  ; Mixer: solo tono A activo (B/C off, ruidos off)
 300+ E5A5 3E 07            LD A, 7
 301+ E5A7 1E 3E            LD E, $3E                       ; %00111110
 302+ E5A9 CD 5D E4         CALL AY_WriteReg
 303+ E5AC                  ; Volumen canal A
 304+ E5AC 3E 08            LD A, 8
 305+ E5AE 1E 0C            LD E, 12                        ; vol medio-alto
 306+ E5B0 CD 5D E4         CALL AY_WriteReg
 307+ E5B3                  ; Reset puntero
 308+ E5B3 21 96 E5         LD HL, TensionMusicTable
 309+ E5B6 22 93 E5         LD (TensionMusicPtr), HL
 310+ E5B9 C3 C6 E5         JP TmAdvanceNote
 311+ E5BC
 312+ E5BC              ; --- UpdateTensionMusic: tick per-frame; avanza notas y silencia al final ---
 313+ E5BC              UpdateTensionMusicImpl:
 314+ E5BC 3A 95 E5         LD A, (TensionMusicTimer)
 315+ E5BF B7               OR A
 316+ E5C0 C8               RET Z                           ; inactivo
 317+ E5C1 3D               DEC A
 318+ E5C2 32 95 E5         LD (TensionMusicTimer), A
 319+ E5C5 C0               RET NZ                          ; aun en la nota actual
 320+ E5C6                  ; Hora de la siguiente nota
 321+ E5C6                  ; (fall-through a TmAdvanceNote)
 322+ E5C6
 323+ E5C6              ; --- TmAdvanceNote: lee 3 bytes de la tabla y aplica al AY ---
 324+ E5C6              ; OJO: AY_WriteReg clobbea B y C (LD BC, $FFFD/$BFFD). Hay que stashear los
 325+ E5C6              ; bytes de period en D y E (que SI se preservan a traves del call).
 326+ E5C6              TmAdvanceNote:
 327+ E5C6 2A 93 E5         LD HL, (TensionMusicPtr)
 328+ E5C9 5E               LD E, (HL)                      ; E = pitch_lo (param de AY_WriteReg)
 329+ E5CA 23               INC HL
 330+ E5CB 56               LD D, (HL)                      ; D = pitch_hi (preservado por AY_WriteReg)
 331+ E5CC 23               INC HL
 332+ E5CD 7E               LD A, (HL)                      ; duration
 333+ E5CE 23               INC HL
 334+ E5CF B7               OR A
 335+ E5D0 28 11            JR Z, .tmEnd                    ; duration = 0 -> fin de tabla
 336+ E5D2 22 93 E5         LD (TensionMusicPtr), HL
 337+ E5D5 32 95 E5         LD (TensionMusicTimer), A
 338+ E5D8                  ; Escribir period en R0/R1
 339+ E5D8 3E 00            LD A, 0                         ; R0 = period low
 340+ E5DA CD 5D E4         CALL AY_WriteReg                ; escribe E (pitch_lo); D preservado
 341+ E5DD 3E 01            LD A, 1                         ; R1 = period high
 342+ E5DF 5A               LD E, D                         ; recargar E con pitch_hi
 343+ E5E0 C3 5D E4         JP AY_WriteReg                  ; tail-call
 344+ E5E3              .tmEnd:
 345+ E5E3                  ; Silenciar canal A
 346+ E5E3 AF               XOR A
 347+ E5E4 32 95 E5         LD (TensionMusicTimer), A       ; flag inactivo
 348+ E5E7 3E 08            LD A, 8
 349+ E5E9 1E 00            LD E, 0
 350+ E5EB C3 5D E4         JP AY_WriteReg                  ; tail-call
 351+ E5EE
# file closed: ay_sound.asm
