 996+ D278              ; ==============================================================================
 997+ D278              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 998+ D278              ; ==============================================================================
 999+ D278              ; Entrada: A = attr byte
1000+ D278              ; Salida:  A = attr con paper reemplazado (o sin cambio)
1001+ D278              ; Preserva: HL, DE, BC, IX
1002+ D278              ; ==============================================================================
1003+ D278              ApplyTintSwap:
1004+ D278 C5               PUSH BC
1005+ D279 47               LD B, A                     ; B = attr original
1006+ D27A 3A 74 D2         LD A, (CurrentTintVar)
1007+ D27D FE FF            CP $FF
1008+ D27F 28 24            JR Z, .tintNoChange
1009+ D281 4F               LD C, A                     ; C = tint variant (new paper 0-7)
1010+ D282 3A 75 D2         LD A, (CurrentTintPaper)
1011+ D285 FE FF            CP $FF
1012+ D287 28 1C            JR Z, .tintNoChange
1013+ D289                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
1014+ D289                  ; Extraer paper del attr: bits 5-3
1015+ D289 78               LD A, B
1016+ D28A E6 38            AND $38                     ; A = 00PPP000
1017+ D28C 0F               RRCA
1018+ D28D 0F               RRCA
1019+ D28E 0F               RRCA                        ; A = 00000PPP = paper actual
1020+ D28F D5               PUSH DE
1021+ D290 57               LD D, A                     ; D = paper actual
1022+ D291 3A 75 D2         LD A, (CurrentTintPaper)
1023+ D294 BA               CP D                        ; paper actual == tintPaper?
1024+ D295 D1               POP DE
1025+ D296 20 0D            JR NZ, .tintNoChange
1026+ D298                  ; Match: reemplazar paper bits con tintVar
1027+ D298 78               LD A, B
1028+ D299 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1029+ D29B D5               PUSH DE
1030+ D29C 57               LD D, A
1031+ D29D 79               LD A, C                     ; A = tintVar (0-7)
1032+ D29E 07               RLCA
1033+ D29F 07               RLCA
1034+ D2A0 07               RLCA                        ; A = 00PPP000
1035+ D2A1 B2               OR D                        ; A = FBPPPIII
1036+ D2A2 D1               POP DE
1037+ D2A3 C1               POP BC
1038+ D2A4 C9               RET
1039+ D2A5              .tintNoChange:
1040+ D2A5 78               LD A, B                     ; devolver sin cambio
1041+ D2A6 C1               POP BC
1042+ D2A7 C9               RET
