5674+ BDFE              ; ==============================================================================
5675+ BDFE              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5676+ BDFE              ; ==============================================================================
5677+ BDFE              TryRespawnMonsters:
5678+ BDFE                  IF DEBUG_NO_ENEMIES
5679+ BDFE ~                RET
5680+ BDFE                  ENDIF
5681+ BDFE 3A 28 E2         LD A, (CurrentTimeOfDay)
5682+ BE01 FE 03            CP 3
5683+ BE03 28 05            JR Z, .rmNight
5684+ BE05 FE 04            CP 4
5685+ BE07 28 01            JR Z, .rmNight
5686+ BE09 C9               RET
5687+ BE0A              .rmNight:
5688+ BE0A 3A 12 B3         LD A, (MonstersActive)
5689+ BE0D B7               OR A
5690+ BE0E C8               RET Z
5691+ BE0F CD DF BE         CALL .rmUpdateReturnTimers
5692+ BE12 3A DB BE         LD A, (.rmTimer)
5693+ BE15 B7               OR A
5694+ BE16 28 05            JR Z, .rmCheckSlots
5695+ BE18 3D               DEC A
5696+ BE19 32 DB BE         LD (.rmTimer), A
5697+ BE1C C9               RET
5698+ BE1D              .rmCheckSlots:
5699+ BE1D DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5700+ BE21 06 03            LD B, MONSTERS_TO_SPAWN
5701+ BE23 0E 00            LD C, 0
5702+ BE25              .rmLoop:
5703+ BE25 C5               PUSH BC
5704+ BE26 DD 7E 01         LD A, (IX+ENT_TYPE)
5705+ BE29 B7               OR A
5706+ BE2A C2 CF BE         JP NZ, .rmSkip
5707+ BE2D                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5708+ BE2D                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5709+ BE2D                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5710+ BE2D DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5711+ BE30 B7               OR A
5712+ BE31 20 09            JR NZ, .rmHasTypeForTrap
5713+ BE33                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5714+ BE33 79               LD A, C
5715+ BE34 21 F8 BD         LD HL, MonsterTypeTable
5716+ BE37 5F               LD E, A
5717+ BE38 16 00            LD D, 0
5718+ BE3A 19               ADD HL, DE
5719+ BE3B 7E               LD A, (HL)
5720+ BE3C              .rmHasTypeForTrap:
5721+ BE3C D6 4C            SUB SPRID_MONSTER_0
5722+ BE3E CB 3F            SRL A
5723+ BE40 CB 3F            SRL A
5724+ BE42 CB 3F            SRL A                               ; A = type idx 0..2
5725+ BE44 21 DC BE         LD HL, .rmTrapBits
5726+ BE47 5F               LD E, A
5727+ BE48 16 00            LD D, 0
5728+ BE4A 19               ADD HL, DE
5729+ BE4B 7E               LD A, (HL)
5730+ BE4C 21 BE 82         LD HL, MonsterTrappedFlags
5731+ BE4F A6               AND (HL)
5732+ BE50 C2 CF BE         JP NZ, .rmSkip
5733+ BE53                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5734+ BE53                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5735+ BE53                  ; que el player visite su room.
5736+ BE53 79               LD A, C
5737+ BE54 6F               LD L, A
5738+ BE55 26 00            LD H, 0
5739+ BE57 11 87 8D         LD DE, MonsterRoomId
5740+ BE5A 19               ADD HL, DE
5741+ BE5B 7E               LD A, (HL)
5742+ BE5C 5F               LD E, A                             ; E = room_id del slot
5743+ BE5D CD AD 8E         CALL MaiGetCurrentScreenId          ; A = current screen_id
5744+ BE60 BB               CP E
5745+ BE61 C2 CF BE         JP NZ, .rmSkip                      ; distinto room → skip
5746+ BE64                  ; === Activar SIN tocar POSX/POSY ===
5747+ BE64                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5748+ BE64                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5749+ BE64                  ;   - RepositionMonstersAtEntry: gap en entry side
5750+ BE64                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5751+ BE64 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5752+ BE67 B7               OR A
5753+ BE68 20 18            JR NZ, .rmHasType
5754+ BE6A 79               LD A, C
5755+ BE6B 21 F8 BD         LD HL, MonsterTypeTable
5756+ BE6E 5F               LD E, A
5757+ BE6F 16 00            LD D, 0
5758+ BE71 19               ADD HL, DE
5759+ BE72 7E               LD A, (HL)
5760+ BE73 DD 77 08         LD (IX+ENT_ANIMBASE), A
5761+ BE76 79               LD A, C
5762+ BE77 21 FB BD         LD HL, MonsterColorTable
5763+ BE7A 5F               LD E, A
5764+ BE7B 16 00            LD D, 0
5765+ BE7D 19               ADD HL, DE
5766+ BE7E 7E               LD A, (HL)
5767+ BE7F DD 77 05         LD (IX+ENT_ATTR), A
5768+ BE82              .rmHasType:
