4977+ BDBC              .sppFail:
4978+ BDBC 3A F5 BD         LD A, (.sppOrigX)
4979+ BDBF DD 77 03         LD (IX+ENT_POSX), A
4980+ BDC2 3A F6 BD         LD A, (.sppOrigY)
4981+ BDC5 DD 77 04         LD (IX+ENT_POSY), A
4982+ BDC8 C9               RET
4983+ BDC9
4984+ BDC9              ; --- .sppCheckFit ---
4985+ BDC9              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
4986+ BDC9              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
4987+ BDC9              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
4988+ BDC9              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
4989+ BDC9              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
4990+ BDC9              .sppCheckFit:
4991+ BDC9                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
4992+ BDC9 DD 7E 03         LD A, (IX+ENT_POSX)
4993+ BDCC FE D1            CP SCREEN_MAX_X - 23
4994+ BDCE 30 21            JR NC, .sppOutOfBounds
4995+ BDD0 DD 7E 04         LD A, (IX+ENT_POSY)
4996+ BDD3 FE 10            CP SCREEN_MIN_Y
4997+ BDD5 38 1A            JR C, .sppOutOfBounds
4998+ BDD7 FE 91            CP SCREEN_MAX_Y - 23
4999+ BDD9 30 16            JR NC, .sppOutOfBounds
5000+ BDDB                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5001+ BDDB DD 7E 00         LD A, (IX+ENT_SPRITEID)
5002+ BDDE 32 F4 BD         LD (.sppSpritIdSave), A
5003+ BDE1 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5004+ BDE5 CD D3 B9         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5005+ BDE8 F5               PUSH AF
5006+ BDE9 3A F4 BD         LD A, (.sppSpritIdSave)
5007+ BDEC DD 77 00         LD (IX+ENT_SPRITEID), A
5008+ BDEF F1               POP AF
5009+ BDF0 C9               RET
5010+ BDF1              .sppOutOfBounds:
5011+ BDF1 F6 01            OR 1                                ; NZ
5012+ BDF3 C9               RET
