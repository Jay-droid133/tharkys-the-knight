 660+ 63C7              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 661+ 63C7              ;    al haberse dibujado ya en el render normal de la sala).
 662+ 63C7              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 63C7              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 63C7              ; Bank 3 para ambos (sprites baseline town).
 665+ 63C7              ; Destruye: AF, BC, DE, HL, IX.
 666+ 63C7              ; ==============================================================================
 667+ 63C7              TownGateOpenDoor:
 668+ 63C7 11 AA E2         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 63CA CD 48 DA         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 63CD                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 63CD
 672+ 63CD              ; ==============================================================================
 673+ 63CD              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 63CD              ; ==============================================================================
 675+ 63CD              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 63CD              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 63CD              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 63CD              ; ==============================================================================
 679+ 63CD              TownGateRedrawOpenDoor:
 680+ 63CD 21 69 E6         LD HL, BgGfx_town_gate_door_open
 681+ 63D0 3E 03            LD A, 3
 682+ 63D2 CD BC 6A         CALL LoadBgSpriteToBuffer
 683+ 63D5 DD 21 F5 89      LD IX, BgSpriteBuffer
 684+ 63D9 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 63DB 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 63DD AF               XOR A
 687+ 63DE 32 0F E5         LD (BgSpriteIsHouse), A
 688+ 63E1 32 D8 D4         LD (CurrentTintVar), A
 689+ 63E4 C3 CE D3         JP DrawBgGfxSprite
 690+ 63E7
 691+ 63E7              ; ==============================================================================
 692+ 63E7              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 63E7              ; ==============================================================================
 694+ 63E7              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 63E7              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 63E7              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 63E7              ; Destruye: A, BC, DE, IX.
 698+ 63E7              ; ==============================================================================
 699+ 63E7              TownGateAllNastiesDeadCheck:
 700+ 63E7 DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63EB 06 04            LD B, NUM_NASTIES
 702+ 63ED              .tgandcLoop:
 703+ 63ED DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 63F0 B7               OR A
 705+ 63F1 C0               RET NZ                              ; algun nasty aun activo
 706+ 63F2 11 10 00         LD DE, ENT_SIZE
 707+ 63F5 DD 19            ADD IX, DE
 708+ 63F7 10 F4            DJNZ .tgandcLoop
 709+ 63F9 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 63FA C9               RET
 711+ 63FB
 712+ 63FB              ; ==============================================================================
 713+ 63FB              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63FB              ; ==============================================================================
 715+ 63FB              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63FB              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63FB              ; y abajo se dibujan normal (XOR).
 718+ 63FB              ;
 719+ 63FB              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63FB              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63FB              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63FB              ;   inferiores que pasan tras el lintel skipped.
 723+ 63FB              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63FB              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63FB              ;   lintel skipped.
 726+ 63FB              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63FB              ;
 728+ 63FB              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63FB              ;     Bank 6 paginado al entrar (caller).
 730+ 63FB              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63FB              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63FB              ; ==============================================================================
 733+ 63FB              PLAYER_H_PX              EQU 21
 734+ 63FB
 735+ 63FB              TownGatePlayerXOR_BiClip:
 736+ 63FB FD 23            INC IY
 737+ 63FD FD 23            INC IY                              ; skip header
 738+ 63FF D5               PUSH DE
 739+ 6400 CD 40 A0         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 6403 D1               POP DE
 741+ 6404 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 6406 4A               LD C, D                             ; C = current pixel Y
 743+ 6407              .tgpxbcRow:
 744+ 6407 79               LD A, C
 745+ 6408 FE C0            CP 192
 746+ 640A 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 640C                                                      ; (sin este clip, NextPixelLine lleva
 748+ 640C                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 640C                                                      ; corrompe attrs como flashes raros).
 750+ 640C FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 640E 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 6410 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 6412 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 6414                  ; In [120, 151] → skip pixels en esta row
 755+ 6414 18 0C            JR .tgpxbcAdvance
 756+ 6416              .tgpxbcDraw:
 757+ 6416                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 6416                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 6416 FD 7E 00         LD A, (IY+0)
 760+ 6419 AE               XOR (HL)
 761+ 641A 77               LD (HL), A
 762+ 641B 23               INC HL
 763+ 641C FD 7E 01         LD A, (IY+1)
 764+ 641F AE               XOR (HL)
 765+ 6420 77               LD (HL), A
 766+ 6421 2B               DEC HL                              ; back to row start
 767+ 6422              .tgpxbcAdvance:
 768+ 6422 FD 23            INC IY
 769+ 6424 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 6426 0C               INC C                               ; pixel Y += 1
 771+ 6427 C5               PUSH BC
 772+ 6428 CD AC 9D         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 642B C1               POP BC
 774+ 642C 10 D9            DJNZ .tgpxbcRow
 775+ 642E C9               RET
 776+ 642F
 777+ 642F              ; ==============================================================================
 778+ 642F              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 642F              ; ==============================================================================
 780+ 642F              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 642F              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 642F              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 642F              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 642F              ; ==============================================================================
 785+ 642F              TownGatePlayerSlideErase:
 786+ 642F DD 21 9B 81      LD IX, EntityTable
 787+ 6433 DD E5            PUSH IX
 788+ 6435 CD DA A7         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6438 DD E1            POP IX
 790+ 643A 3A 82 90         LD A, (CurrentPaging)
 791+ 643D E6 F8            AND $F8
 792+ 643F F6 06            OR 6
 793+ 6441 32 82 90         LD (CurrentPaging), A
 794+ 6444 01 FD 7F         LD BC, $7FFD
 795+ 6447 ED 79            OUT (C), A
 796+ 6449 FD 2A 62 A7      LD IY, (OldSprAddr)
 797+ 644D DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 6450 DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 6453 5F               LD E, A
 800+ 6454 CD FB 63         CALL TownGatePlayerXOR_BiClip
 801+ 6457 3A 82 90         LD A, (CurrentPaging)
 802+ 645A E6 F8            AND $F8
 803+ 645C 32 82 90         LD (CurrentPaging), A
 804+ 645F 01 FD 7F         LD BC, $7FFD
 805+ 6462 ED 79            OUT (C), A
 806+ 6464 C9               RET
 807+ 6465
 808+ 6465              TownGatePlayerSlideDraw:
 809+ 6465 DD 21 9B 81      LD IX, EntityTable
 810+ 6469 DD E5            PUSH IX
 811+ 646B CD A9 A7         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 646E DD E1            POP IX
 813+ 6470 3A 82 90         LD A, (CurrentPaging)
 814+ 6473 E6 F8            AND $F8
 815+ 6475 F6 06            OR 6
 816+ 6477 32 82 90         LD (CurrentPaging), A
 817+ 647A 01 FD 7F         LD BC, $7FFD
 818+ 647D ED 79            OUT (C), A
 819+ 647F FD 2A D8 A7      LD IY, (SpriteAddrTemp)
 820+ 6483 3A DC 82         LD A, (PlayerDrawY)
 821+ 6486 57               LD D, A
 822+ 6487 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 648A 5F               LD E, A
 824+ 648B CD FB 63         CALL TownGatePlayerXOR_BiClip
 825+ 648E 3A 82 90         LD A, (CurrentPaging)
 826+ 6491 E6 F8            AND $F8
 827+ 6493 32 82 90         LD (CurrentPaging), A
 828+ 6496 01 FD 7F         LD BC, $7FFD
 829+ 6499 ED 79            OUT (C), A
 830+ 649B                  ; Update OLD = current
 831+ 649B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 649E DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 64A1 3A DC 82         LD A, (PlayerDrawY)
 834+ 64A4 DD 77 0D         LD (IX+ENT_OLDY), A
 835+ 64A7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 836+ 64AA DD 77 0E         LD (IX+ENT_OLDSPRID), A
 837+ 64AD C9               RET
 838+ 64AE
 839+ 64AE              ; ==============================================================================
 840+ 64AE              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 64AE              ; ==============================================================================
 842+ 64AE              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 64AE              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 64AE              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 64AE              ; 2. Compute new offset random.
 846+ 64AE              ; 3. Draw at new offset.
 847+ 64AE              ; Destruye: AF, BC, DE, HL, IX.
 848+ 64AE              ; ==============================================================================
 849+ 64AE              TownGateShakeStep:
 850+ 64AE CD F6 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 64B1 CD 11 65         CALL TownGateDrawFingerShifted
 852+ 64B4                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 64B4 ED 5F            LD A, R
 854+ 64B6 E6 03            AND $03
 855+ 64B8 21 D9 64         LD HL, .tgssJitterTable
 856+ 64BB 5F               LD E, A
 857+ 64BC 16 00            LD D, 0
 858+ 64BE 19               ADD HL, DE
 859+ 64BF 7E               LD A, (HL)
 860+ 64C0 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 64C3 3A 98 81         LD A, (GameFrameCounter)
 862+ 64C6 E6 03            AND $03
 863+ 64C8 21 D9 64         LD HL, .tgssJitterTable
 864+ 64CB 5F               LD E, A
 865+ 64CC 16 00            LD D, 0
 866+ 64CE 19               ADD HL, DE
 867+ 64CF 7E               LD A, (HL)
 868+ 64D0 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 64D3 CD F6 64         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 64D6 C3 11 65         JP TownGateDrawFingerShifted
 871+ 64D9              .tgssJitterTable:
 872+ 64D9 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 64DD
 874+ 64DD              ; ==============================================================================
 875+ 64DD              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 64DD              ; ==============================================================================
 877+ 64DD              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 64DD              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 64DD              ; ==============================================================================
 880+ 64DD              TownGateShakeRestore:
 881+ 64DD CD F6 64         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 64E0 CD 11 65         CALL TownGateDrawFingerShifted
 883+ 64E3 AF               XOR A
 884+ 64E4 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 64E7 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 64EA 11 4F E2         LD DE, BgGfx_arm
 887+ 64ED CD 48 DA         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 64F0 11 9C E2         LD DE, BgGfx_finger
 889+ 64F3 C3 48 DA         JP RedrawPickupByPtr
 890+ 64F6
 891+ 64F6              ; ==============================================================================
 892+ 64F6              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 64F6              ; ==============================================================================
 894+ 64F6              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 64F6              ; Destruye: AF, BC, DE, HL, IX.
 896+ 64F6              ; ==============================================================================
 897+ 64F6              TownGateDrawArmShifted:
 898+ 64F6 21 4F E2         LD HL, BgGfx_arm
 899+ 64F9 3E 03            LD A, 3
 900+ 64FB CD BC 6A         CALL LoadBgSpriteToBuffer
 901+ 64FE 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 6501 47               LD B, A
 903+ 6502 3E 88            LD A, TGCS_ARM_PX_X
 904+ 6504 80               ADD A, B
 905+ 6505 5F               LD E, A
 906+ 6506 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 6509 47               LD B, A
 908+ 650A 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 650C 80               ADD A, B
 910+ 650D 57               LD D, A
 911+ 650E C3 2C 65         JP DrawBgSpriteAnyXorAtPixel
 912+ 6511
 913+ 6511              ; ==============================================================================
 914+ 6511              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 6511              ; ==============================================================================
 916+ 6511              TownGateDrawFingerShifted:
 917+ 6511 21 9C E2         LD HL, BgGfx_finger
 918+ 6514 3E 03            LD A, 3
 919+ 6516 CD BC 6A         CALL LoadBgSpriteToBuffer
 920+ 6519 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 651C 47               LD B, A
 922+ 651D 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 651F 80               ADD A, B
 924+ 6520 5F               LD E, A
 925+ 6521 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 6524 47               LD B, A
 927+ 6525 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 6527 80               ADD A, B
 929+ 6528 57               LD D, A
 930+ 6529 C3 2C 65         JP DrawBgSpriteAnyXorAtPixel
 931+ 652C
 932+ 652C              ; ==============================================================================
 933+ 652C              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 652C              ; ==============================================================================
 935+ 652C              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 652C              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 652C              ;     E = pixel X (0..255).
 938+ 652C              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 652C              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 652C              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 652C              ; Destruye: AF, BC, DE, HL, IX.
 942+ 652C              ; ==============================================================================
 943+ 652C              DrawBgSpriteAnyXorAtPixel:
 944+ 652C DD 21 F5 89      LD IX, BgSpriteBuffer
 945+ 6530 DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 6533 B7               OR A
 947+ 6534 C8               RET Z
 948+ 6535 32 8F 65         LD (.dbsaHeight), A
 949+ 6538 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 653B E6 7F            AND $7F
 951+ 653D 32 90 65         LD (.dbsaWidth), A
 952+ 6540 DD 23            INC IX
 953+ 6542 DD 23            INC IX                              ; -> pixel data
 954+ 6544 7B               LD A, E
 955+ 6545 E6 07            AND $07
 956+ 6547 32 91 65         LD (.dbsaShift), A
 957+ 654A 7B               LD A, E
 958+ 654B E6 F8            AND $F8
 959+ 654D 5F               LD E, A
 960+ 654E CD 40 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 6551              .dbsaRow:
 962+ 6551 E5               PUSH HL
 963+ 6552 3A 90 65         LD A, (.dbsaWidth)
 964+ 6555 47               LD B, A                             ; B = width counter
 965+ 6556 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 6558              .dbsaByte:
 967+ 6558 DD 7E 00         LD A, (IX+0)
 968+ 655B 2F               CPL                                 ; un-invert
 969+ 655C 57               LD D, A                             ; D = sprite byte
 970+ 655D 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 655F 3A 91 65         LD A, (.dbsaShift)
 972+ 6562 B7               OR A
 973+ 6563 28 09            JR Z, .dbsaNoShift
 974+ 6565 C5               PUSH BC
 975+ 6566 47               LD B, A
 976+ 6567              .dbsaShiftLoop:
 977+ 6567 CB 3A            SRL D
 978+ 6569 CB 1B            RR E
 979+ 656B 10 FA            DJNZ .dbsaShiftLoop
 980+ 656D C1               POP BC
 981+ 656E              .dbsaNoShift:
 982+ 656E 7A               LD A, D
 983+ 656F B1               OR C                                ; combinar con carry previo
 984+ 6570 AE               XOR (HL)
 985+ 6571 77               LD (HL), A
 986+ 6572 23               INC HL
 987+ 6573 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 6574 DD 23            INC IX
 989+ 6576 10 E0            DJNZ .dbsaByte
 990+ 6578                  ; Byte final (carry) si shift > 0
 991+ 6578 3A 91 65         LD A, (.dbsaShift)
 992+ 657B B7               OR A
 993+ 657C 28 03            JR Z, .dbsaNoFinal
 994+ 657E 79               LD A, C
 995+ 657F AE               XOR (HL)
 996+ 6580 77               LD (HL), A
 997+ 6581              .dbsaNoFinal:
 998+ 6581 E1               POP HL
 999+ 6582 CD AC 9D         CALL NextPixelLine
1000+ 6585 3A 8F 65         LD A, (.dbsaHeight)
1001+ 6588 3D               DEC A
1002+ 6589 32 8F 65         LD (.dbsaHeight), A
1003+ 658C 20 C3            JR NZ, .dbsaRow
1004+ 658E C9               RET
1005+ 658F 00           .dbsaHeight: DEFB 0
1006+ 6590 00           .dbsaWidth:  DEFB 0
1007+ 6591 00           .dbsaShift:  DEFB 0
1008+ 6592
1009+ 6592              ; ==============================================================================
1010+ 6592              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 6592              ; ==============================================================================
1012+ 6592              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 6592              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 6592              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 6592              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 6592              ; ==============================================================================
1017+ 6592              TownGateExitStep:
1018+ 6592 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 6595 3C               INC A
1020+ 6596 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 6599 FE 02            CP TGCS_T_EXIT_STEP
1022+ 659B D8               RET C                               ; aun no toca step
1023+ 659C AF               XOR A
1024+ 659D 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 65A0                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 65A0 DD 21 9B 81      LD IX, EntityTable
1027+ 65A4 DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 65A7 3C               INC A
1029+ 65A8 DD 77 04         LD (IX+ENT_POSY), A
1030+ 65AB 32 DC 82         LD (PlayerDrawY), A
1031+ 65AE 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 65B1 EE 01            XOR 1                               ; toggle 0/1
1033+ 65B3 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 65B6 47               LD B, A
1035+ 65B7 3E 0E            LD A, SPRID_WALK_S
1036+ 65B9 80               ADD A, B
1037+ 65BA DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 65BD                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 65BD                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 65BD                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 65BD                  ; part1 attrs ni de door attrs.
1042+ 65BD CD 2F 64         CALL TownGatePlayerSlideErase
1043+ 65C0 C3 65 64         JP TownGatePlayerSlideDraw          ; tail call
1044+ 65C3
1045+ 65C3              ; ==============================================================================
1046+ 65C3              ; TownGateDrawTheEnd - dibuja el sprite "The End" en (TGCS_END_CHARX, _Y)
1047+ 65C3              ; ==============================================================================
1048+ 65C3              ; El sprite original "the end" (id 243, 88x72=891 B) se troceo en dos partes
1049+ 65C3              ; horizontales para no consumir el 87% de BgSpriteBuffer:
1050+ 65C3              ;   - the_end_part1 (id 47, 88x32 = 11x4 chars, 396 B): mitad superior.
1051+ 65C3              ;   - the_end_part2 (id 48, 88x40 = 11x5 chars, 495 B): mitad inferior.
1052+ 65C3              ; Bank 3. RLE-comprimidos (bit 7 de width_bytes set), asi que NO podemos
1053+ 65C3              ; usar DrawBgSpriteXOR (produce distorsion). Usamos DrawBgGfxSprite, la
1054+ 65C3              ; rutina normal de render BG: decodifica RLE + pinta pixels + attrs.
1055+ 65C3              ; Destruye: AF, BC, DE, HL, IX.
1056+ 65C3              ; ==============================================================================
1057+ 65C3              TownGateDrawTheEnd:
1058+ 65C3                  ; --- Part 1: mitad superior (11x4 chars) ---
1059+ 65C3 21 74 EC         LD HL, BgGfx_the_end_part1
1060+ 65C6 3E 03            LD A, 3
1061+ 65C8 CD BC 6A         CALL LoadBgSpriteToBuffer
1062+ 65CB DD 21 F5 89      LD IX, BgSpriteBuffer
1063+ 65CF 06 0B            LD B, TGCS_END_CHARX
1064+ 65D1 0E 04            LD C, TGCS_END_CHARY
1065+ 65D3 AF               XOR A
1066+ 65D4 32 0F E5         LD (BgSpriteIsHouse), A
1067+ 65D7 32 D8 D4         LD (CurrentTintVar), A              ; sin tint
