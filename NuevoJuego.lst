 245+ 67DD              ; ==============================================================================
 246+ 67DD              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 247+ 67DD              ; ==============================================================================
 248+ 67DD              ; IN: A = frame idx (0..2)
 249+ 67DD              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 250+ 67DD              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 251+ 67DD              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 252+ 67DD              ; Destruye: AF, BC, DE, HL, IX.
 253+ 67DD              ; ==============================================================================
 254+ 67DD              DrawSmokeFrameXor:
 255+ 67DD 87               ADD A, A                                ; *2 (entries de 2 bytes)
 256+ 67DE 6F               LD L, A
 257+ 67DF 26 00            LD H, 0
 258+ 67E1 11 D7 67         LD DE, SmokeFramePtrTable
 259+ 67E4 19               ADD HL, DE
 260+ 67E5 5E               LD E, (HL)
 261+ 67E6 23               INC HL
 262+ 67E7 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 263+ 67E8                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 264+ 67E8                  ; Source y destino accesibles sin paging (milestones bank 0,
 265+ 67E8                  ; BgSpriteBuffer en RAM principal).
 266+ 67E8 EB               EX DE, HL                               ; HL = source
 267+ 67E9 11 9A 89         LD DE, BgSpriteBuffer
 268+ 67EC 01 22 00         LD BC, 34
 269+ 67EF ED B0            LDIR
 270+ 67F1                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 271+ 67F1 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 272+ 67F4 57               LD D, A
 273+ 67F5 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 274+ 67F8 5F               LD E, A
 275+ 67F9 C3 EF 68         JP DrawBgSprite16XorAtPixel
 276+ 67FC
 277+ 67FC              ; ==============================================================================
 278+ 67FC              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 279+ 67FC              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 280+ 67FC              ; ==============================================================================
 281+ 67FC              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 282+ 67FC              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 283+ 67FC              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 284+ 67FC              ; uniformemente negro -- el efecto que pidio el usuario.
 285+ 67FC              ;
 286+ 67FC              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 287+ 67FC              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 288+ 67FC              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 289+ 67FC              ; Destruye: AF, BC, DE, HL.
 290+ 67FC              ; ==============================================================================
 291+ 67FC              ClearSmokeAttrs:
 292+ 67FC                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 293+ 67FC 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 294+ 67FF CB 3F            SRL A
 294+ 6801 CB 3F          SRL A
 294+ 6803 CB 3F          SRL A                   ; A = char Y (post-HUD)
 295+ 6805 26 00            LD H, 0
 296+ 6807 6F               LD L, A
 297+ 6808 29               ADD HL, HL                              ; *2
 298+ 6809 29               ADD HL, HL                              ; *4
 299+ 680A 29               ADD HL, HL                              ; *8
 300+ 680B 29               ADD HL, HL                              ; *16
 301+ 680C 29               ADD HL, HL                              ; *32
 302+ 680D 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 303+ 6810 CB 3F            SRL A
 303+ 6812 CB 3F          SRL A
 303+ 6814 CB 3F          SRL A                   ; A = char X
 304+ 6816 5F               LD E, A
 305+ 6817 16 00            LD D, 0
 306+ 6819 19               ADD HL, DE
 307+ 681A 11 00 58         LD DE, $5800
 308+ 681D 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 309+ 681E AF               XOR A                                   ; paper black, ink black
 310+ 681F 77               LD (HL), A                              ; (charY, charX)
 311+ 6820 23               INC HL
 312+ 6821 77               LD (HL), A                              ; (charY, charX+1)
 313+ 6822 11 1F 00         LD DE, 31
 314+ 6825 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 315+ 6826 77               LD (HL), A
 316+ 6827 23               INC HL
 317+ 6828 77               LD (HL), A                              ; (charY+1, charX+1)
 318+ 6829 C9               RET
 319+ 682A
 320+ 682A              ; ==============================================================================
 321+ 682A              ; CheckStatueHidden - es esta entry de BG una estatua oculta?
 322+ 682A              ; ==============================================================================
 323+ 682A              ; IN:  A = sprite id
 324+ 682A              ; OUT: NZ si es estatua y su slot esta atrapado (skip drawing).
 325+ 682A              ;      Z si no es estatua o esta visible (draw normalmente).
 326+ 682A              ; Destruye: AF, BC, HL.
 327+ 682A              ; ==============================================================================
 328+ 682A              CheckStatueHidden:
 329+ 682A 21 67 67         LD HL, StatueIdTable
 330+ 682D 06 03            LD B, 3
 331+ 682F 0E 00            LD C, 0                                 ; slot index 0..2
 332+ 6831              .cshLoop:
 333+ 6831 BE               CP (HL)
 334+ 6832 28 06            JR Z, .cshMatch
 335+ 6834 23               INC HL
 336+ 6835 0C               INC C
 337+ 6836 10 F9            DJNZ .cshLoop
 338+ 6838 AF               XOR A                                   ; not statue -> Z (visible)
 339+ 6839 C9               RET
 340+ 683A              .cshMatch:
 341+ 683A                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 342+ 683A 79               LD A, C
 343+ 683B 32 70 67         LD (LastHiddenStatueType), A            ; expose type para el caller
 344+ 683E 21 64 67         LD HL, ChurchTrapBitMask
 345+ 6841 5F               LD E, A
 346+ 6842 16 00            LD D, 0
 347+ 6844 19               ADD HL, DE
 348+ 6845 7E               LD A, (HL)                              ; bit mask
 349+ 6846 21 6D 82         LD HL, MonsterTrappedFlags
 350+ 6849 A6               AND (HL)
 351+ 684A C9               RET                                     ; NZ si bit set (hidden), Z si no
 352+ 684B
 353+ 684B              ; ==============================================================================
 354+ 684B              ; EraseStatueAtSlot - borra (XOR) la estatua del slot N en la pantalla actual
 355+ 684B              ; ==============================================================================
 356+ 684B              ; IN: A = slot (0..2)
 357+ 684B              ; Solo tiene efecto si la estatua esta colocada en la pantalla actual.
 358+ 684B              ; Destruye: AF, BC, DE, HL, IX.
 359+ 684B              ; ==============================================================================
 360+ 684B              EraseStatueAtSlot:
 361+ 684B                  ; Get statue ID from table
 362+ 684B 21 67 67         LD HL, StatueIdTable
 363+ 684E 5F               LD E, A
 364+ 684F 16 00            LD D, 0
 365+ 6851 19               ADD HL, DE
 366+ 6852 7E               LD A, (HL)                              ; A = statue id
 367+ 6853 B7               OR A
 368+ 6854 C8               RET Z                                   ; ID 0 = no estatua (no exportada)
 369+ 6855 32 91 68         LD (.eseTargetId), A
 370+ 6858                  ; Scan CurrentScreenBuffer (formato 4B: id, charX, charY, variant; $FF = end)
 371+ 6858 2A AF 82         LD HL, (CurrentScreenAddr)
 372+ 685B              .eseLoop:
 373+ 685B 7E               LD A, (HL)
 374+ 685C FE FF            CP $FF
 375+ 685E C8               RET Z                                   ; no encontrada en esta pantalla
 376+ 685F 47               LD B, A                                 ; B = current id
 377+ 6860 3A 91 68         LD A, (.eseTargetId)
