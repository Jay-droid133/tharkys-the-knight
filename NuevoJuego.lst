1573+ 94BF              ; ==============================================================================
1574+ 94BF              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1575+ 94BF              ; ==============================================================================
1576+ 94BF              UpdateStamina:
1577+ 94BF                  ; --- Regenerar salud (siempre, lento) ---
1578+ 94BF 3A 1F 9C         LD A, (PlayerHealth)
1579+ 94C2 FE 10            CP HEALTH_MAX
1580+ 94C4 28 12            JR Z, .usHealthFull
1581+ 94C6 21 23 9C         LD HL, HealthRegenCtr
1582+ 94C9 34               INC (HL)
1583+ 94CA 7E               LD A, (HL)
1584+ 94CB FE 64            CP HEALTH_REGEN_RATE
1585+ 94CD 38 09            JR C, .usHealthFull
1586+ 94CF 36 00            LD (HL), 0
1587+ 94D1 3A 1F 9C         LD A, (PlayerHealth)
1588+ 94D4 3C               INC A
1589+ 94D5 32 1F 9C         LD (PlayerHealth), A
1590+ 94D8              .usHealthFull:
1591+ 94D8                  ; --- Stamina: consumir o regenerar ---
1592+ 94D8 DD 7E 02         LD A, (IX+ENT_STATE)
1593+ 94DB FE 02            CP STATE_FIGHTING
1594+ 94DD 28 18            JR Z, .usDrain
1595+ 94DF                  ; No atacando: regenerar
1596+ 94DF 3A 20 9C         LD A, (PlayerStamina)
1597+ 94E2 FE 10            CP STAMINA_MAX
1598+ 94E4 C8               RET Z                               ; Ya al maximo
1599+ 94E5 21 22 9C         LD HL, StaminaRegenCtr
1600+ 94E8 34               INC (HL)
1601+ 94E9 7E               LD A, (HL)
1602+ 94EA FE 32            CP STAMINA_REGEN_RATE
1603+ 94EC D8               RET C                               ; Aun no toca
1604+ 94ED 36 00            LD (HL), 0                          ; Reset counter
1605+ 94EF 3A 20 9C         LD A, (PlayerStamina)
1606+ 94F2 3C               INC A
1607+ 94F3 32 20 9C         LD (PlayerStamina), A
1608+ 94F6 C9               RET
1609+ 94F7              .usDrain:
1610+ 94F7                  ; Atacando: consumir stamina
1611+ 94F7 3A 20 9C         LD A, (PlayerStamina)
1612+ 94FA B7               OR A
1613+ 94FB C8               RET Z                               ; Ya vacia
1614+ 94FC 21 21 9C         LD HL, StaminaDrainCtr
1615+ 94FF 34               INC (HL)
1616+ 9500 7E               LD A, (HL)
1617+ 9501 FE 19            CP STAMINA_DRAIN_RATE
1618+ 9503 D8               RET C
1619+ 9504 36 00            LD (HL), 0
1620+ 9506 3A 20 9C         LD A, (PlayerStamina)
1621+ 9509 3D               DEC A
1622+ 950A 32 20 9C         LD (PlayerStamina), A
1623+ 950D                  ; Si stamina llega a 0, dar 1 punto tras cooldown
1624+ 950D B7               OR A
1625+ 950E C0               RET NZ
1626+ 950F 3E 01            LD A, 1
1627+ 9511 32 20 9C         LD (PlayerStamina), A               ; Minimo 1 para un swing
1628+ 9514 C9               RET
