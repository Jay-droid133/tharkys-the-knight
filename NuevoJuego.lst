 158+ 9C9B              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 159+ 9C9B              ; HL = period (12-bit), B = duracion (10ms units).
 160+ 9C9B              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 161+ 9C9B              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 162+ 9C9B              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 163+ 9C9B              ; cambiaramos de bank en slot 3 entre el push y el pop).
 164+ 9C9B              AY_PlayToneBlocking:
 165+ 9C9B F3               DI
 166+ 9C9C                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 167+ 9C9C                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 168+ 9C9C 5C               LD E, H                     ; E = period high
 169+ 9C9D 3E 01            LD A, 1
 170+ 9C9F 01 FD FF         LD BC, $FFFD
 171+ 9CA2 ED 79            OUT (C), A
 172+ 9CA4 01 FD BF         LD BC, $BFFD
 173+ 9CA7 ED 59            OUT (C), E
 174+ 9CA9                  ; R0 = period low
 175+ 9CA9 5D               LD E, L                     ; E = period low
 176+ 9CAA 3E 00            LD A, 0
 177+ 9CAC 01 FD FF         LD BC, $FFFD
 178+ 9CAF ED 79            OUT (C), A
 179+ 9CB1 01 FD BF         LD BC, $BFFD
 180+ 9CB4 ED 59            OUT (C), E
 181+ 9CB6                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 182+ 9CB6 3E 09            LD A, 9
 183+ 9CB8 01 FD FF         LD BC, $FFFD
 184+ 9CBB ED 79            OUT (C), A
 185+ 9CBD 01 FD BF         LD BC, $BFFD
 186+ 9CC0 AF               XOR A
 187+ 9CC1 ED 79            OUT (C), A
 188+ 9CC3                  ; R10 = 0 (silenciar canal C)
 189+ 9CC3 3E 0A            LD A, 10
 190+ 9CC5 01 FD FF         LD BC, $FFFD
 191+ 9CC8 ED 79            OUT (C), A
 192+ 9CCA 01 FD BF         LD BC, $BFFD
 193+ 9CCD AF               XOR A
 194+ 9CCE ED 79            OUT (C), A
 195+ 9CD0                  ; R7 = $3E (mixer: solo tono A activo)
 196+ 9CD0 3E 07            LD A, 7
 197+ 9CD2 01 FD FF         LD BC, $FFFD
 198+ 9CD5 ED 79            OUT (C), A
 199+ 9CD7 01 FD BF         LD BC, $BFFD
 200+ 9CDA 3E 3E            LD A, $3E
 201+ 9CDC ED 79            OUT (C), A
 202+ 9CDE                  ; R8 = 13 (volumen A alto)
 203+ 9CDE 3E 08            LD A, 8
 204+ 9CE0 01 FD FF         LD BC, $FFFD
 205+ 9CE3 ED 79            OUT (C), A
 206+ 9CE5 01 FD BF         LD BC, $BFFD
 207+ 9CE8 3E 0D            LD A, 13
 208+ 9CEA ED 79            OUT (C), A
