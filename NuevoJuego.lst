1004+ EF91              .urpDoRoulette:
1005+ EF91                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
1006+ EF91                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
1007+ EF91                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
1008+ EF91                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
1009+ EF91 3E 06            LD A, ROLLED_ROULETTE
1010+ EF93 32 D5 5F         LD (RP_TmpRolled), A
1011+ EF96 3E 01            LD A, 1
1012+ EF98 32 BC 5F         LD (RouletteActive), A
1013+ EF9B                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
1014+ EF9B ED 5F            LD A, R
1015+ EF9D 06 06            LD B, ROULETTE_ORDER_LEN
1016+ EF9F              .urpRouletteModLoop:
1017+ EF9F 90               SUB B
1018+ EFA0 30 FD            JR NC, .urpRouletteModLoop
1019+ EFA2 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
1020+ EFA3 CD 13 EC         CALL SkipCompassIfNeeded            ; si idx cae en COMPASS y lasting activo, avanza
1021+ EFA6 32 BD 5F         LD (RouletteIdx), A
1022+ EFA9 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
1023+ EFAA 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
1024+ EFAC 32 BE 5F         LD (RouletteFrameCounter), A
1025+ EFAF 78               LD A, B
1026+ EFB0 CD 80 EB         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
1027+ EFB3              .urpActivate:
1028+ EFB3                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
1029+ EFB3 CD DF EB         CALL LoadSynthSpriteAndExtractAttr
1030+ EFB6 3A 10 83         LD A, (CurrentScreenX)
1031+ EFB9 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
1032+ EFBC 3A 11 83         LD A, (CurrentScreenY)
1033+ EFBF 32 B5 5F         LD (RandomSynthMapY), A
1034+ EFC2 3E FF            LD A, $FF
1035+ EFC4 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
1036+ EFC7 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
1037+ EFC9                                                      ; ya están set por .urpDoXxx — no resetear)
1038+ EFC9
1039+ EFC9              ; ==============================================================================
1040+ EFC9              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
1041+ EFC9              ; ==============================================================================
1042+ EFC9              ; prev ← cur (data de la sala que dejamos).
1043+ EFC9              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
1044+ EFC9              ;
1045+ EFC9              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
1046+ EFC9              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
1047+ EFC9              ; ==============================================================================
1048+ EFC9              .urpZeroAndRotate:
1049+ EFC9 AF               XOR A
1050+ EFCA 32 D4 5F         LD (RP_TmpSlot), A
1051+ EFCD 32 D5 5F         LD (RP_TmpRolled), A
1052+ EFD0              .urpRotateAndRet:
1053+ EFD0                  ; prev ← cur
1054+ EFD0 3A CE 5F         LD A, (RP_CurSid)
1054+ EFD3 32 D1 5F       LD (RP_PrevSid), A
1055+ EFD6 3A CF 5F         LD A, (RP_CurSlot)
1055+ EFD9 32 D2 5F       LD (RP_PrevSlot), A
1056+ EFDC 3A D0 5F         LD A, (RP_CurRolled)
1056+ EFDF 32 D3 5F       LD (RP_PrevRolled), A
1057+ EFE2 3A D6 5F         LD A, (RP_CurVariant)
1057+ EFE5 32 D7 5F       LD (RP_PrevVariant), A
1058+ EFE8                  ; cur ← (newSid, TmpSlot, TmpRolled, TmpVariant)
1059+ EFE8 3A 11 83         LD A, (CurrentScreenY)
1060+ EFEB 07               RLCA
1060+ EFEC 07             RLCA
1060+ EFED 07             RLCA
1060+ EFEE 07             RLCA           ; Y*16
1061+ EFEF 21 10 83         LD HL, CurrentScreenX
1062+ EFF2 86               ADD A, (HL)                         ; A = newSid
1063+ EFF3 32 CE 5F         LD (RP_CurSid), A
1064+ EFF6 3A D4 5F         LD A, (RP_TmpSlot)
1064+ EFF9 32 CF 5F       LD (RP_CurSlot), A
1065+ EFFC 3A D5 5F         LD A, (RP_TmpRolled)
1065+ EFFF 32 D0 5F       LD (RP_CurRolled), A
1066+ F002 3A D8 5F         LD A, (RP_TmpVariant)
1066+ F005 32 D6 5F       LD (RP_CurVariant), A
1067+ F008 C9               RET
