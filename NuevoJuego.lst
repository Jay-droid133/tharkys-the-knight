# file opened: magic_compass_bfs_bank7.asm
   1+ E2D9              ; ==============================================================================
   2+ E2D9              ; magic_compass_bfs_bank7.asm - BFS Inner body movido a bank 7
   3+ E2D9              ; ==============================================================================
   4+ E2D9              ; _ComputeMagicCompassPath_Inner + sus helpers + locales DEFB. Antes vivía
   5+ E2D9              ; al final de magic_compass.asm en slot 1, pero al añadir los thunks de
   6+ E2D9              ; bank_cutscene_thunks.asm (~135 B), el código se desplazaba sobre $7A00 ->
   7+ E2D9              ; la tabla IM2 lo sobreescribia con $7B -> BFS retornaba basura -> magic
   8+ E2D9              ; compass siempre PathDir=$FF -> brújula clásica blanca inmóvil.
   9+ E2D9              ;
  10+ E2D9              ; Solución: mover ~690 B del BFS Inner aquí, a bank 7. ComputeMagicCompassPath
  11+ E2D9              ; en slot 1 ya pagina bank 7 antes de llamar a _Inner, así que el cuerpo
  12+ E2D9              ; permanece visible durante toda su ejecución. Sin SP swap necesario:
  13+ E2D9              ;   - ComputeMagicCompassPath ENTERS con bank 0 paginated, SP en stack normal.
  14+ E2D9              ;   - Pagina bank 7, CALL _Inner. PUSH PC va a stack-2 en bank 7 (slot 3).
  15+ E2D9              ;   - _Inner ejecuta, PUSHes/POPs/CALLs internos en bank 7 stack. RET pops
  16+ E2D9              ;     de bank 7. Stack consistent durante toda la ejecución.
  17+ E2D9              ;   - Tras RET, ComputeMagicCompassPath pagina bank 0. Stack-2 en bank 0
  18+ E2D9              ;     tiene la PC return original (pushed por el caller cuando bank 0
  19+ E2D9              ;     paginated). ✓
  20+ E2D9              ;
  21+ E2D9              ; _Inner accede a:
  22+ E2D9              ;   - Vars en bank 2 / slot 1 (always-visible): LastEntrySide, LastEntryCoord,
  23+ E2D9              ;     CurrentScreenX/Y, ObjectiveScreenX/Y, MagicCompassPathDir, *PathCoord,
  24+ E2D9              ;     *BfsState, *BfsHead, *BfsTail.
  25+ E2D9              ;   - MagicCompassBfsQueue / MagicCompassVisited (printer buffer, $5B00+).
  26+ E2D9              ;   - RoomCompGapsTable (slot 1) -> DEFW pointers a RoomCompGaps_XX records
  27+ E2D9              ;     (bank 7). Bank 7 paginated -> los records son legibles directamente.
  28+ E2D9              ;   - Locales DEFB (.cmcpCurSid etc.) - ahora viven en bank 7 también.
  29+ E2D9              ;
  30+ E2D9              ; Sjasmplus scope: `_ComputeMagicCompassPath_Inner` es global; todos los
  31+ E2D9              ; labels `.cmcpXxx`, `.cfmgXxx`, `.fgbsXxx`, `.cmvXxx`, `.ccvXxx` heredan
  32+ E2D9              ; ese scope (no se inserta ningun otro global hasta el final del archivo).
