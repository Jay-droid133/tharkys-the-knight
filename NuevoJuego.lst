 182+ 67A9              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 183+ 67A9              ; ==============================================================================
 184+ 67A9              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 185+ 67A9              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 186+ 67A9              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 187+ 67A9              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 188+ 67A9              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 189+ 67A9              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 190+ 67A9              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 191+ 67A9              ; ==============================================================================
 192+ 67A9              StatueIdTable:
 193+ 67A9 D5               DEFB 213        ; type idx 0: statue_zombi
 194+ 67AA E1               DEFB 225        ; type idx 1: statue_skeleton
 195+ 67AB D3               DEFB 211        ; type idx 2: statue_ghost
