 656+ 8BAA              ; UpdatePlayerState - Determina estado y direccion desde input
 657+ 8BAA              ; ==============================================================================
 658+ 8BAA              UpdatePlayerState:
 659+ 8BAA 3A 62 81         LD A, (InputDirection)
 660+ 8BAD 47               LD B, A
 661+ 8BAE 3A 63 81         LD A, (InputFire)
 662+ 8BB1 4F               LD C, A
 663+ 8BB2
 664+ 8BB2                  ; Sin input → idle
 665+ 8BB2 78               LD A, B
 666+ 8BB3 B1               OR C
 667+ 8BB4 20 0D            JR NZ, .notIdle
 668+ 8BB6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 669+ 8BBA                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
 670+ 8BBA DD 7E 0A         LD A, (IX+ENT_DIR)
 671+ 8BBD E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
 672+ 8BBF DD 77 0A         LD (IX+ENT_DIR), A
 673+ 8BC2 C9               RET
 674+ 8BC3
 675+ 8BC3              .notIdle:
 676+ 8BC3                  ; Guardar direccion actual en bits 0-3
 677+ 8BC3 DD 7E 0A         LD A, (IX+ENT_DIR)
 678+ 8BC6 E6 F0            AND $F0                     ; Mantener lastHDir
 679+ 8BC8 B0               OR B                        ; Añadir dir actual
 680+ 8BC9 DD 77 0A         LD (IX+ENT_DIR), A
 681+ 8BCC
 682+ 8BCC                  ; Actualizar lastHDir si hay componente E/W
 683+ 8BCC 78               LD A, B
 684+ 8BCD E6 0C            AND DIR_E | DIR_W
 685+ 8BCF 28 0E            JR Z, .noHorizUpdate
 686+ 8BD1                  ; Guardar en bits 4-7
 687+ 8BD1 07               RLCA
 688+ 8BD2 07               RLCA
 689+ 8BD3 07               RLCA
 690+ 8BD4 07               RLCA                        ; Shift a bits 4-7
 691+ 8BD5 4F               LD C, A                     ; C = lastHDir en bits 4-7
 692+ 8BD6 DD 7E 0A         LD A, (IX+ENT_DIR)
 693+ 8BD9 E6 0F            AND $0F                     ; Mantener dir actual
 694+ 8BDB B1               OR C                        ; Añadir lastHDir
 695+ 8BDC DD 77 0A         LD (IX+ENT_DIR), A
 696+ 8BDF              .noHorizUpdate:
 697+ 8BDF
 698+ 8BDF                  ; Fighting o running?
 699+ 8BDF 3A 63 81         LD A, (InputFire)
