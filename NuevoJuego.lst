 359+ 7273 FE FF            CP $FF
 360+ 7275 28 2A            JR Z, .urpScanDone
 361+ 7277 FE D2            CP RANDOM_SLOT_MARKER
 362+ 7279 20 20            JR NZ, .urpSkipEntry
 363+ 727B                  ; Es marker. Cap reached?
 364+ 727B 3A AB 5F         LD A, (RandomSlotCount)
 365+ 727E FE 04            CP RANDOM_SLOT_MAX
 366+ 7280 30 19            JR NC, .urpSkipEntry
 367+ 7282                  ; SlotList[count*2] = charX, [count*2+1] = charY
 368+ 7282 23               INC HL                              ; HL @ charX
 369+ 7283 46               LD B, (HL)                          ; B = charX
