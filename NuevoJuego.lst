 417+ E5B9              ; ==============================================================================
 418+ E5B9              DrawRoomInfo:
 419+ E5B9                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E5B9 1E 00            LD E, 0
 421+ E5BB 06 0D            LD B, 13
 422+ E5BD              .clearLoop:
 423+ E5BD C5               PUSH BC
 424+ E5BE D5               PUSH DE
