4179+ BA13 47               LD B, A
4180+ BA14 DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de spawn
4181+ BA17 FE 06            CP ANIM_FRAMES_SPAWN            ; >= 6 → animacion terminada
4182+ BA19 38 25            JR C, .spFrameOk
4183+ BA1B                  ; Spawn terminado: transicionar a STATE_RUNNING
4184+ BA1B DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
4185+ BA1F DD 7E 0A         LD A, (IX+ENT_DIR)              ; Recuperar ANIMBASE real del enemigo
4186+ BA22 DD 77 08         LD (IX+ENT_ANIMBASE), A
4187+ BA25 DD 77 00         LD (IX+ENT_SPRITEID), A
4188+ BA28 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
4189+ BA2C                  ; Monsters: breve pausa antes de empezar a perseguir
4190+ BA2C DD 7E 01         LD A, (IX+ENT_TYPE)
4191+ BA2F FE 02            CP TYPE_MONSTER
4192+ BA31 20 0C            JR NZ, .spNotMonster
