 118  6A28
 119  6A28                  ; --- Rutinas de paginacion (paging.asm) ---
 120  6A28                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 121  6A28                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 122  6A28                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 123  6A28                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 124  6A28                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 125  6A28                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 126  6A28                  ; criterio (siempre visible) pero contended.
 127  6A28                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 128  6A28                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 129  6A28                  ; el inner loop, asi que el overhead es invisible.
 130  6A28                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 6A28              ; ==============================================================================
   2+ 6A28              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6A28              ; ==============================================================================
   4+ 6A28              ; Port $7FFD (write-only):
   5+ 6A28              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6A28              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6A28              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6A28              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6A28              ;
  10+ 6A28              ; Bancos disponibles:
  11+ 6A28              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6A28              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6A28              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6A28              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6A28              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6A28              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6A28              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6A28              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6A28              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6A28              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6A28              ; ==============================================================================
  22+ 6A28
  23+ 6A28              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6A28              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6A28
  26+ 6A28              ; ==============================================================================
  27+ 6A28              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6A28              ; ==============================================================================
  29+ 6A28              ; Entrada: A = banco (0-7)
  30+ 6A28              ; Preserva: HL, DE, IX, IY
  31+ 6A28              ; Destruye: A, BC
  32+ 6A28              ; ==============================================================================
  33+ 6A28              PageBankSlot3:
  34+ 6A28 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6A2A 47               LD B, A                     ; guardar banco nuevo
  36+ 6A2B 3A E8 90         LD A, (CurrentPaging)
  37+ 6A2E E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6A30 B0               OR B                        ; poner nuevo banco
  39+ 6A31 32 E8 90         LD (CurrentPaging), A
  40+ 6A34 01 FD 7F         LD BC, $7FFD
  41+ 6A37 ED 79            OUT (C), A
  42+ 6A39 C9               RET
  43+ 6A3A
  44+ 6A3A              ; ==============================================================================
  45+ 6A3A              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6A3A              ; ==============================================================================
  47+ 6A3A              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6A3A              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6A3A              ; ==============================================================================
  50+ 6A3A              InitPaging:
  51+ 6A3A 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6A3C 32 E8 90         LD (CurrentPaging), A
  53+ 6A3F 01 FD 7F         LD BC, $7FFD
  54+ 6A42 ED 79            OUT (C), A
  55+ 6A44 C9               RET
  56+ 6A45
  57+ 6A45              ; ==============================================================================
  58+ 6A45              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6A45              ; ==============================================================================
  60+ 6A45              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6A45              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6A45              ;      Paginacion restaurada a bank 0.
  63+ 6A45              ; Destruye: A, BC, DE, HL
  64+ 6A45              ;
  65+ 6A45              ; Formato del room en FUENTE (variable-length):
  66+ 6A45              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6A45              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6A45              ;   terminador:                  DEFB $FF
  69+ 6A45              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6A45              ;
  71+ 6A45              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6A45              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6A45              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6A45              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6A45              ; ==============================================================================
  76+ 6A45              LoadRoomToBuffer:
  77+ 6A45                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 6A45                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 6A45                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 6A45                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 6A45                  ;
  82+ 6A45                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 6A45                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 6A45                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 6A45                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 6A45 F3               DI
  87+ 6A46                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 6A46 3A E8 90         LD A, (CurrentPaging)
  89+ 6A49 E6 F8            AND $F8
  90+ 6A4B F6 01            OR 1
  91+ 6A4D 32 E8 90         LD (CurrentPaging), A
  92+ 6A50 01 FD 7F         LD BC, $7FFD
  93+ 6A53 ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 6A55                  ; --- Copy + decompress loop ---
  95+ 6A55                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 6A55                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 6A55 11 9B 85         LD DE, CurrentScreenBuffer
  98+ 6A58              .lrbLoop:
  99+ 6A58 7E               LD A, (HL)                      ; id
 100+ 6A59 12               LD (DE), A
 101+ 6A5A 23               INC HL
 102+ 6A5B 13               INC DE
 103+ 6A5C FE FF            CP $FF                          ; terminador?
 104+ 6A5E 28 1B            JR Z, .lrbDone
 105+ 6A60                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 6A60                  ; al buffer escribimos x limpio (AND $7F).
 107+ 6A60 7E               LD A, (HL)
 108+ 6A61 23               INC HL
 109+ 6A62 47               LD B, A                         ; B = x raw (con flag)
 110+ 6A63 E6 7F            AND $7F
 111+ 6A65 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 6A66 13               INC DE
 113+ 6A67                  ; Copiar y
 114+ 6A67 7E               LD A, (HL)
 115+ 6A68 12               LD (DE), A
 116+ 6A69 23               INC HL
 117+ 6A6A 13               INC DE
 118+ 6A6B                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 6A6B CB 78            BIT 7, B
 120+ 6A6D 28 06            JR Z, .lrbNoTint
 121+ 6A6F 7E               LD A, (HL)                      ; v desde source
 122+ 6A70 23               INC HL
 123+ 6A71 12               LD (DE), A
 124+ 6A72 13               INC DE
 125+ 6A73 18 E3            JR .lrbLoop
 126+ 6A75              .lrbNoTint:
 127+ 6A75 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 6A77 12               LD (DE), A
 129+ 6A78 13               INC DE
 130+ 6A79 18 DD            JR .lrbLoop
 131+ 6A7B              .lrbDone:
 132+ 6A7B                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 6A7B 3A E8 90         LD A, (CurrentPaging)
 134+ 6A7E E6 F8            AND $F8                         ; bank 0
 135+ 6A80 32 E8 90         LD (CurrentPaging), A
 136+ 6A83 01 FD 7F         LD BC, $7FFD
 137+ 6A86 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 6A88                  ; Restaurar interrupciones si Inicio ya termino
 139+ 6A88 3A 4A 81         LD A, (StartupComplete)
 140+ 6A8B B7               OR A
 141+ 6A8C C8               RET Z                           ; aun en Inicio -> dejar DI
 142+ 6A8D FB               EI
 143+ 6A8E C9               RET
