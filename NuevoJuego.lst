 189+ E5DF              ; ==============================================================================
 190+ E5DF              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ E5DF              ; ==============================================================================
 192+ E5DF              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ E5DF              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ E5DF              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ E5DF              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ E5DF              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ E5DF              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ E5DF              ; Destruye: AF, BC, DE, HL, IX.
 199+ E5DF              ; ==============================================================================
 200+ E5DF              StartTownGateCutscene:
 201+ E5DF AF               XOR A
 202+ E5E0 32 B6 82         LD (CurrentKey), A
 203+ E5E3 CD 34 E8         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ E5E6 CD 65 6D         CALL KillAllActiveNasties_B7           ; nasties → puff (animan en WAIT_NASTIES)
 205+ E5E9 CD 6B 6D         CALL KillDeathIfActive_B7              ; muerte (slot 11) → puff y despawn
 206+ E5EC CD F4 E9         CALL SFX_TownGate_OnStart
 207+ E5EF 3E 10            LD A, TGP_WAIT_NASTIES
 208+ E5F1 32 D0 82         LD (TownGatePhase), A
 209+ E5F4 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ E5F6 32 A5 5F         LD (TownGateTimer), A
 211+ E5F9 C9               RET
 212+ E5FA
 213+ E5FA              ; KillDeathIfActive: vive en slot 1 (town_gate_cutscene.asm) — llamada por
 214+ E5FA              ; bank_cutscene via KillDeathIfActive_B7. NO duplicar aqui.
 215+ E5FA
 216+ E5FA              ; ==============================================================================
 217+ E5FA              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 218+ E5FA              ; ==============================================================================
 219+ E5FA              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 220+ E5FA              ; transicion a la siguiente.
 221+ E5FA              ; Destruye: AF, BC, DE, HL, IX.
 222+ E5FA              ; ==============================================================================
 223+ E5FA              UpdateTownGateCutsceneBody:
 224+ E5FA 3A D0 82         LD A, (TownGatePhase)
 225+ E5FD FE 10            CP TGP_WAIT_NASTIES
 226+ E5FF CA 3A E6         JP Z, .tgPhWaitNasties              ; pre-LOCK wait, ProcessEnemies sigue corriendo
 227+ E602 FE 11            CP TGP_WALK_TO_ANCHOR
 228+ E604 CA 59 E6         JP Z, .tgPhWalkToAnchor              ; player camina autonomo a anchor1
 229+ E607 3D               DEC A
 230+ E608 CA DF E6         JP Z, .tgPhLock
 231+ E60B 3D               DEC A
 232+ E60C CA F7 E6         JP Z, .tgPhArmIn
 233+ E60F 3D               DEC A
 234+ E610 CA 0F E7         JP Z, .tgPhFingerIn
 235+ E613 3D               DEC A
 236+ E614 CA 28 E7         JP Z, .tgPhShake
 237+ E617 3D               DEC A
 238+ E618 CA 40 E7         JP Z, .tgPhFingerPulse
 239+ E61B 3D               DEC A
 240+ E61C CA 58 E7         JP Z, .tgPhFingerOut
 241+ E61F 3D               DEC A
 242+ E620 CA 67 E7         JP Z, .tgPhArmHold
 243+ E623 3D               DEC A
 244+ E624 CA 7F E7         JP Z, .tgPhArmOut
 245+ E627 3D               DEC A
 246+ E628 CA A4 E7         JP Z, .tgPhPlayerTurn
 247+ E62B 3D               DEC A                               ; phase 10 (PLAYER_HIDE) deprecated
 248+ E62C 3D               DEC A                               ; phase 11 (PLAYER_FRAMED) deprecated
 249+ E62D 3D               DEC A
 250+ E62E CA D9 E7         JP Z, .tgPhPlayerExit
 251+ E631 3D               DEC A
 252+ E632 CA 09 E8         JP Z, .tgPhEndHold
 253+ E635 3D               DEC A
 254+ E636 CA 1B E8         JP Z, .tgPhBlack
 255+ E639                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 256+ E639 C9               RET
 257+ E63A
 258+ E63A              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 259+ E63A              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 260+ E63A              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 261+ E63A              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 262+ E63A              ;
 263+ E63A              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 264+ E63A              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 265+ E63A              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 266+ E63A              ; capturamos para meterlos en STATE_DYING.
 267+ E63A              .tgPhWaitNasties:
 268+ E63A CD 65 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 269+ E63D CD 21 63         CALL TownGateAllNastiesDeadCheck
 270+ E640 28 07            JR Z, .tgWaitNastiesDone
 271+ E642                  ; RestoreOldAttr de puffs vecinos sobreescribe attrs del player cada frame.
 272+ E642                  ; Repintar para que el color (buff o blanco) no se pierda mientras esperamos.
 273+ E642 CD 56 6D         CALL TownGateRedrawPlayer_B7
 274+ E645 CD 2B E8         CALL TownGateDecTimer               ; safety timeout
 275+ E648 C0               RET NZ
 276+ E649              .tgWaitNastiesDone:
 277+ E649 CD 56 6D         CALL TownGateRedrawPlayer_B7
 278+ E64C AF               XOR A
 279+ E64D 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 280+ E650 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 281+ E653 3E 11            LD A, TGP_WALK_TO_ANCHOR
 282+ E655 32 D0 82         LD (TownGatePhase), A
 283+ E658 C9               RET
 284+ E659
 285+ E659              ; ---- Phase WALK_TO_ANCHOR: player camina autonomo en 2 fases ----
 286+ E659              ; Fase 1: movimiento vertical hasta alinear Y con TGCS_WALK_TARGET_Y
 287+ E659              ;         (sprite WALK_N o WALK_S segun direccion).
 288+ E659              ; Fase 2: movimiento horizontal hasta alinear X con TGCS_WALK_TARGET_X
 289+ E659              ;         (sprite WALK_E o WALK_W segun direccion).
 290+ E659              ; Al llegar (ambos ejes alineados): pose static WALK_N+1 + transicion a LOCK.
 291+ E659              ; Toggle frame anim 0/1 cada TGCS_WALK_ANIM_PERIOD frames.
 292+ E659              .tgPhWalkToAnchor:
 293+ E659 DD 21 A3 81      LD IX, EntityTable
 294+ E65D                  ; --- Fase 1: Y ---
 295+ E65D DD 7E 04         LD A, (IX+ENT_POSY)
 296+ E660 FE 50            CP TGCS_WALK_TARGET_Y
 297+ E662 28 1C            JR Z, .tgwtaTryX                    ; Y aligned, pasar a fase 2
 298+ E664 38 0D            JR C, .tgwtaMoveS                   ; cur_Y < target → S (Y++)
 299+ E666                  ; cur_Y > target → N (Y--)
 300+ E666 DD 35 04         DEC (IX+ENT_POSY)
 301+ E669 DD 7E 04         LD A, (IX+ENT_POSY)
 302+ E66C 32 E4 82         LD (PlayerDrawY), A
 303+ E66F 06 0A            LD B, SPRID_WALK_N
 304+ E671 18 2F            JR .tgwtaApplyAnim
 305+ E673              .tgwtaMoveS:
 306+ E673 DD 34 04         INC (IX+ENT_POSY)
 307+ E676 DD 7E 04         LD A, (IX+ENT_POSY)
 308+ E679 32 E4 82         LD (PlayerDrawY), A
 309+ E67C 06 0E            LD B, SPRID_WALK_S
 310+ E67E 18 22            JR .tgwtaApplyAnim
 311+ E680                  ; --- Fase 2: X (solo si Y ya aligned) ---
 312+ E680              .tgwtaTryX:
 313+ E680 DD 7E 03         LD A, (IX+ENT_POSX)
 314+ E683 FE 78            CP TGCS_WALK_TARGET_X
 315+ E685 CA C3 E6         JP Z, .tgwtaArrived                 ; ambos aligned
 316+ E688 38 0D            JR C, .tgwtaMoveE                   ; cur_X < target → E (X++)
 317+ E68A DD 35 03         DEC (IX+ENT_POSX)
 318+ E68D DD 7E 03         LD A, (IX+ENT_POSX)
 319+ E690 DD 77 0F         LD (IX+ENT_DRAWX), A
 320+ E693 06 06            LD B, SPRID_WALK_W
 321+ E695 18 0B            JR .tgwtaApplyAnim
 322+ E697              .tgwtaMoveE:
 323+ E697 DD 34 03         INC (IX+ENT_POSX)
 324+ E69A DD 7E 03         LD A, (IX+ENT_POSX)
 325+ E69D DD 77 0F         LD (IX+ENT_DRAWX), A
 326+ E6A0 06 02            LD B, SPRID_WALK_E
 327+ E6A2              .tgwtaApplyAnim:
 328+ E6A2                  ; B = sprite base. Toggle frame 0/1 cada TGCS_WALK_ANIM_PERIOD.
 329+ E6A2 3A A5 5F         LD A, (TownGateTimer)
 330+ E6A5 3C               INC A
 331+ E6A6 32 A5 5F         LD (TownGateTimer), A
 332+ E6A9 FE 04            CP TGCS_WALK_ANIM_PERIOD
 333+ E6AB 38 0C            JR C, .tgwtaSameFrame
 334+ E6AD AF               XOR A
 335+ E6AE 32 A5 5F         LD (TownGateTimer), A
 336+ E6B1 3A A9 5F         LD A, (TownGateExitWalkFrame)
 337+ E6B4 EE 01            XOR 1
 338+ E6B6 32 A9 5F         LD (TownGateExitWalkFrame), A
