   1+ 8050              ; ==============================================================================
   2+ 8050              ; VARIABLES EN RAM MANTENIDAS POR EL JUEGO
   3+ 8050              ; ==============================================================================
   4+ 8050
   5+ 8050 00           GameFrameCounter:   DEFB 0      ; Contador que incrementa cada frame (0-255)
   6+ 8051 00           GameState:          DEFB 0      ; Estado: 0=Menu, 1=InGame, 2=GameOver
   7+ 8052
   8+ 8052              ; ==============================================================================
   9+ 8052              ; TABLA DE ENTIDADES (estilo Sabre Wulf)
  10+ 8052              ; ==============================================================================
  11+ 8052              ; 17 slots × 12 bytes = 204 bytes.
  12+ 8052              ; Slot 0: Player. Slots 1-6: Inmortales. Slots 7-12: Nasties. 13-16: Objetos.
  13+ 8052              ; Cada entidad: SpriteID, Type, State, PosX, PosY, Attr, DeltaX, DeltaY,
  14+ 8052              ;               AnimBase, AnimTimer, Dir, Flags
  15+ 8052              ; ==============================================================================
  16+ 8052 00 00 00...  EntityTable:        DEFS NUM_ENTITIES * ENT_SIZE
  17+ 8162
  18+ 8162              ; --- Input crudo ---
  19+ 8162 00           InputDirection:     DEFB 0      ; Direccion leida del teclado este frame
  20+ 8163 00           InputFire:          DEFB 0      ; Fuego leido del teclado este frame
  21+ 8164
  22+ 8164              ; --- Movimiento del player (fiel a Sabre Wulf turns_per_player_move) ---
  23+ 8164 01           PlayerMoveTimer:    DEFB 1      ; Countdown: mueve cuando llega a 0, reset a PLAYER_MOVE_TURNS
  24+ 8165
  25+ 8165              ; --- Spawn system ---
  26+ 8165 64           SpawnTimer:         DEFB SPAWN_INTERVAL  ; Countdown para intentar spawn de nasty
  27+ 8166
  28+ 8166              ; --- Round-robin de enemigos (estilo Sabre Wulf) ---
  29+ 8166 00           EnemyStepIdx:       DEFB 0      ; Posicion actual en el round-robin (0 a NUM_IMMORTALS+NUM_NASTIES-1)
  30+ 8167
  31+ 8167              ; --- Render/Logic split: buffer de enemigos procesados este frame ---
  32+ 8167 00           FrameEnemyCount:    DEFB 0      ; Cuantos enemigos se renderizaron este frame
  33+ 8168 00 00 00 00  FrameEnemySlots:    DEFS MAX_ENEMIES_PER_FRAME * 2  ; Punteros IX (DEFW) de cada enemigo
  34+ 816C
  35+ 816C              ; --- Pending erase: entidades cuya puff termino y necesitan erase final ---
  36+ 816C 00           PendingEraseCount:  DEFB 0      ; Cuantas entidades necesitan erase final
  37+ 816D 00 00 00...  PendingEraseSlots:  DEFS 3 * 5  ; Hasta 3 entidades: 2b IX + 1b OLDSPRID + 1b OLDX + 1b OLDY
  38+ 817C
  39+ 817C              ; ==============================================================================
  40+ 817C              ; SISTEMA DE PANTALLAS
  41+ 817C              ; ==============================================================================
  42+ 817C
  43+ 817C              ; --- Posicion actual en el mapa de pantallas (grid 16x16) ---
  44+ 817C 08           CurrentScreenX:     DEFB START_SCREEN_X  ; Columna actual (0-15)
  45+ 817D 08           CurrentScreenY:     DEFB START_SCREEN_Y  ; Fila actual (0-15)
  46+ 817E
  47+ 817E              ; --- Puntero a los datos de la pantalla actual ---
  48+ 817E 00 00        CurrentScreenAddr:  DEFW 0      ; Direccion en memoria de los datos de la pantalla actual
  49+ 8180
  50+ 8180              ; --- Flag de transicion ---
  51+ 8180 00           ScreenTransition:   DEFB 0      ; 0=sin transicion, 1=N, 2=S, 4=E, 8=W
  52+ 8181
  53+ 8181              ; --- Flag de redibujado ---
  54+ 8181 01           ScreenDirty:        DEFB 1      ; 1=hay que redibujar la pantalla completa
  55+ 8182
  56+ 8182              ; --- Flag de transicion reciente (skip restore en primer frame) ---
  57+ 8182 00           ScreenJustRedrawn:  DEFB 0      ; 1=pantalla recien dibujada, no restaurar attrs
  58+ 8183
  59+ 8183              ; ==============================================================================
  60+ 8183              ; MAPA DE COLISION (pre-computado al cargar pantalla)
  61+ 8183              ; ==============================================================================
  62+ 8183              ; 32 columnas × 22 filas = 704 bytes. 0=libre, 1=bloqueado.
  63+ 8183              ; Coordenadas en char-space del room (sin BG_Y_OFFSET).
  64+ 8183              ; Se construye en BuildCollisionMap al cargar cada pantalla.
  65+ 8183              ; ==============================================================================
  66+ 8183 00 00 00...  CollisionMap:       DEFS 32 * 22
