 592  E2D9                  ; --- Magic compass BFS Inner body (~690 B, slot 1 -> bank 7 move) ---
 593  E2D9                  ; _ComputeMagicCompassPath_Inner + helpers + locales DEFB. Antes vivian
 594  E2D9                  ; al final de magic_compass.asm en slot 1, pero los thunks de
 595  E2D9                  ; bank_cutscene_thunks.asm los empujaron sobre $7A00 (la tabla IM2 los
 596  E2D9                  ; sobreescribia con $7B). Movido aqui para preservar magic compass.
 597  E2D9                  ; ComputeMagicCompassPath en slot 1 pagina bank 7 antes de CALL _Inner;
 598  E2D9                  ; el wrapper se encarga del paging. Sin SP swap necesario porque el body
 599  E2D9                  ; permanece visible toda su ejecucion.
 600  E2D9                  INCLUDE "magic_compass_bfs_bank7.asm"
# file opened: magic_compass_bfs_bank7.asm
   1+ E2D9              ; ==============================================================================
   2+ E2D9              ; magic_compass_bfs_bank7.asm - BFS Inner body movido a bank 7
   3+ E2D9              ; ==============================================================================
   4+ E2D9              ; _ComputeMagicCompassPath_Inner + sus helpers + locales DEFB. Antes vivía
   5+ E2D9              ; al final de magic_compass.asm en slot 1, pero al añadir los thunks de
   6+ E2D9              ; bank_cutscene_thunks.asm (~135 B), el código se desplazaba sobre $7A00 ->
   7+ E2D9              ; la tabla IM2 lo sobreescribia con $7B -> BFS retornaba basura -> magic
   8+ E2D9              ; compass siempre PathDir=$FF -> brújula clásica blanca inmóvil.
   9+ E2D9              ;
  10+ E2D9              ; Solución: mover ~690 B del BFS Inner aquí, a bank 7. ComputeMagicCompassPath
  11+ E2D9              ; en slot 1 ya pagina bank 7 antes de llamar a _Inner, así que el cuerpo
  12+ E2D9              ; permanece visible durante toda su ejecución. Sin SP swap necesario:
  13+ E2D9              ;   - ComputeMagicCompassPath ENTERS con bank 0 paginated, SP en stack normal.
  14+ E2D9              ;   - Pagina bank 7, CALL _Inner. PUSH PC va a stack-2 en bank 7 (slot 3).
  15+ E2D9              ;   - _Inner ejecuta, PUSHes/POPs/CALLs internos en bank 7 stack. RET pops
  16+ E2D9              ;     de bank 7. Stack consistent durante toda la ejecución.
  17+ E2D9              ;   - Tras RET, ComputeMagicCompassPath pagina bank 0. Stack-2 en bank 0
  18+ E2D9              ;     tiene la PC return original (pushed por el caller cuando bank 0
  19+ E2D9              ;     paginated). ✓
  20+ E2D9              ;
  21+ E2D9              ; _Inner accede a:
  22+ E2D9              ;   - Vars en bank 2 / slot 1 (always-visible): LastEntrySide, LastEntryCoord,
  23+ E2D9              ;     CurrentScreenX/Y, ObjectiveScreenX/Y, MagicCompassPathDir, *PathCoord,
  24+ E2D9              ;     *BfsState, *BfsHead, *BfsTail.
  25+ E2D9              ;   - MagicCompassBfsQueue / MagicCompassVisited (printer buffer, $5B00+).
  26+ E2D9              ;   - RoomCompGapsTable (slot 1) -> DEFW pointers a RoomCompGaps_XX records
  27+ E2D9              ;     (bank 7). Bank 7 paginated -> los records son legibles directamente.
  28+ E2D9              ;   - Locales DEFB (.cmcpCurSid etc.) - ahora viven en bank 7 también.
  29+ E2D9              ;
  30+ E2D9              ; Sjasmplus scope: `_ComputeMagicCompassPath_Inner` es global; todos los
  31+ E2D9              ; labels `.cmcpXxx`, `.cfmgXxx`, `.fgbsXxx`, `.cmvXxx`, `.ccvXxx` heredan
  32+ E2D9              ; ese scope (no se inserta ningun otro global hasta el final del archivo).
  33+ E2D9              ; ==============================================================================
  34+ E2D9
  35+ E2D9              ; ==============================================================================
  36+ E2D9              ; _ComputeMagicCompassPath_Inner — BFS sin paging (asume bank 7 paginado).
  37+ E2D9              ; ==============================================================================
  38+ E2D9              _ComputeMagicCompassPath_Inner:
  39+ E2D9                  ; ¿BFS in-progress? Si sí, saltar init y reanudar.
  40+ E2D9 3A CD 5F         LD A, (MagicCompassBfsState)
  41+ E2DC B7               OR A
  42+ E2DD C2 54 E3         JP NZ, .cmcpResume
  43+ E2E0
  44+ E2E0                  ; --- INIT (solo cuando arranca un BFS nuevo) ---
  45+ E2E0 3A 02 83         LD A, (CurrentScreenY)
  46+ E2E3 07               RLCA
  46+ E2E4 07             RLCA
  46+ E2E5 07             RLCA
  46+ E2E6 07             RLCA            ; Y*16
  47+ E2E7 21 01 83         LD HL, CurrentScreenX
  48+ E2EA 86               ADD A, (HL)
  49+ E2EB 32 7B E5         LD (.cmcpCurSid), A
  50+ E2EE
  51+ E2EE 3A B1 82         LD A, (ObjectiveScreenX)
  52+ E2F1 FE FF            CP $FF
  53+ E2F3 CA 4F E4         JP Z, .cmcpNoPath
  54+ E2F6 3A B2 82         LD A, (ObjectiveScreenY)
  55+ E2F9 07               RLCA
  55+ E2FA 07             RLCA
  55+ E2FB 07             RLCA
  55+ E2FC 07             RLCA
  56+ E2FD 21 B1 82         LD HL, ObjectiveScreenX
  57+ E300 86               ADD A, (HL)
  58+ E301 32 7C E5         LD (.cmcpTgtSid), A
  59+ E304
  60+ E304 47               LD B, A                              ; B = target sid
  61+ E305 3A 7B E5         LD A, (.cmcpCurSid)
  62+ E308 B8               CP B
  63+ E309 CA 4F E4         JP Z, .cmcpNoPath                    ; current==target → X blanca
  64+ E30C
  65+ E30C                  ; --- Determinar player_current_comp via LastEntrySide ---
  66+ E30C 3A CA 5F         LD A, (LastEntrySide)
  67+ E30F FE FF            CP $FF
  68+ E311 20 03            JR NZ, .cmcpHaveEntry
  69+ E313 AF               XOR A                                ; fallback: comp 0
  70+ E314 18 0C            JR .cmcpStoreCurComp
  71+ E316              .cmcpHaveEntry:
  72+ E316                  ; Buscar el gap de current_sid en side LastEntrySide. Su comp = player comp.
  73+ E316 47               LD B, A                              ; B = LastEntrySide
  74+ E317 3A 7B E5         LD A, (.cmcpCurSid)
  75+ E31A CD 5D E4         CALL .cmcpFindGapBySide              ; OUT: A = comp (0..2), o $FF si no encontrado
  76+ E31D FE FF            CP $FF
  77+ E31F 20 01            JR NZ, .cmcpStoreCurComp
  78+ E321 AF               XOR A                                ; fallback comp 0
  79+ E322              .cmcpStoreCurComp:
  80+ E322 32 7D E5         LD (.cmcpCurComp), A
  81+ E325
  82+ E325                  ; --- Clear visited bitmap (96 bytes = 768 bits = 256 sids × 3 comps) ---
  83+ E325 21 80 5B         LD HL, MagicCompassVisited
  84+ E328 11 81 5B         LD DE, MagicCompassVisited + 1
  85+ E32B 01 5F 00         LD BC, 95
  86+ E32E AF               XOR A
  87+ E32F 77               LD (HL), A
  88+ E330 ED B0            LDIR
  89+ E332
  90+ E332                  ; --- Inicializar cola con (target, comp 0) ---
  91+ E332 AF               XOR A
  92+ E333 32 C8 5F         LD (MagicCompassBfsHead), A
  93+ E336 32 C9 5F         LD (MagicCompassBfsTail), A
  94+ E339 3A 7C E5         LD A, (.cmcpTgtSid)
  95+ E33C 21 00 5B         LD HL, MagicCompassBfsQueue
  96+ E33F 77               LD (HL), A                           ; queue[0].sid = target
  97+ E340 23               INC HL
  98+ E341 AF               XOR A
  99+ E342 77               LD (HL), A                           ; queue[0].comp = 0
 100+ E343 21 C8 5F         LD HL, MagicCompassBfsHead
 101+ E346 34               INC (HL)                             ; head = 1
 102+ E347
 103+ E347                  ; visited[(target, 0)] = 1
 104+ E347 3A 7C E5         LD A, (.cmcpTgtSid)
 105+ E34A 06 00            LD B, 0
 106+ E34C CD 26 E5         CALL .cmcpMarkVisited
 107+ E34F
 108+ E34F                  ; INIT done → marcar in-progress y caer al loop con counter de iteraciones.
 109+ E34F 3E 01            LD A, 1
 110+ E351 32 CD 5F         LD (MagicCompassBfsState), A
 111+ E354
 112+ E354              .cmcpResume:
 113+ E354                  ; Cargar contador de iteraciones para este chunk de frame.
 114+ E354 3E 20            LD A, MAGIC_COMPASS_BFS_ITERS_PER_FRAME
 115+ E356 32 8B E5         LD (.cmcpItersLeft), A
 116+ E359
 117+ E359                  ; --- BFS loop ---
 118+ E359              .cmcpLoop:
 119+ E359                  ; Yield si se acabó el chunk de iteraciones del frame.
 120+ E359 3A 8B E5         LD A, (.cmcpItersLeft)
 121+ E35C B7               OR A
 122+ E35D CA 5C E4         JP Z, .cmcpYield
 123+ E360 3D               DEC A
 124+ E361 32 8B E5         LD (.cmcpItersLeft), A
