 454  8180                  ; Incrementar contador de frames
 455  8180 3A 98 81         LD A, (GameFrameCounter)
 456  8183 3C               INC A
 457  8184 32 98 81         LD (GameFrameCounter), A
 458  8187
 459  8187                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 460  8187              .frameSync:
 461  8187 76               HALT                        ; Dormir hasta siguiente interrupt
 462  8188 3A 97 81         LD A, (.frameStart)
 463  818B 47               LD B, A
 464  818C 3A 78 5C         LD A, ($5C78)
 465  818F 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 466  8190 FE 02            CP 2
 467  8192 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
 468  8194
