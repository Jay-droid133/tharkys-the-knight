 789+ 6451              ; ==============================================================================
 790+ 6451              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 791+ 6451              ; ==============================================================================
 792+ 6451              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 793+ 6451              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 794+ 6451              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 795+ 6451              ; 2. Compute new offset random.
 796+ 6451              ; 3. Draw at new offset.
 797+ 6451              ; Destruye: AF, BC, DE, HL, IX.
 798+ 6451              ; ==============================================================================
 799+ 6451              TownGateShakeStep:
 800+ 6451 CD 99 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 801+ 6454 CD B4 64         CALL TownGateDrawFingerShifted
 802+ 6457                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 803+ 6457 ED 5F            LD A, R
 804+ 6459 E6 03            AND $03
 805+ 645B 21 7C 64         LD HL, .tgssJitterTable
 806+ 645E 5F               LD E, A
 807+ 645F 16 00            LD D, 0
 808+ 6461 19               ADD HL, DE
 809+ 6462 7E               LD A, (HL)
 810+ 6463 32 A6 5F         LD (TownGateShakeOffsX), A
 811+ 6466 3A C4 80         LD A, (GameFrameCounter)
 812+ 6469 E6 03            AND $03
 813+ 646B 21 7C 64         LD HL, .tgssJitterTable
 814+ 646E 5F               LD E, A
 815+ 646F 16 00            LD D, 0
 816+ 6471 19               ADD HL, DE
 817+ 6472 7E               LD A, (HL)
 818+ 6473 32 A7 5F         LD (TownGateShakeOffsY), A
 819+ 6476 CD 99 64         CALL TownGateDrawArmShifted          ; draw at new offset
 820+ 6479 C3 B4 64         JP TownGateDrawFingerShifted
 821+ 647C              .tgssJitterTable:
 822+ 647C 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 823+ 6480
 824+ 6480              ; ==============================================================================
 825+ 6480              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 826+ 6480              ; ==============================================================================
 827+ 6480              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 828+ 6480              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 829+ 6480              ; ==============================================================================
 830+ 6480              TownGateShakeRestore:
 831+ 6480 CD 99 64         CALL TownGateDrawArmShifted          ; erase last shifted
 832+ 6483 CD B4 64         CALL TownGateDrawFingerShifted
 833+ 6486 AF               XOR A
 834+ 6487 32 A6 5F         LD (TownGateShakeOffsX), A
 835+ 648A 32 A7 5F         LD (TownGateShakeOffsY), A
 836+ 648D 11 E3 E5         LD DE, BgGfx_arm
 837+ 6490 CD 75 D3         CALL RedrawPickupByPtr               ; restore at PickupTable position
 838+ 6493 11 30 E6         LD DE, BgGfx_finger
 839+ 6496 C3 75 D3         JP RedrawPickupByPtr
