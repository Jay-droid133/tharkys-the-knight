 300+ E5FF              ; ==============================================================================
 301+ E5FF              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 302+ E5FF              ; ==============================================================================
 303+ E5FF              ; Entrada: A = attr original
 304+ E5FF              ; Salida:  A = attr transformado
 305+ E5FF              ; Preserva: HL, DE, BC, IX
 306+ E5FF              ; ==============================================================================
 307+ E5FF              ApplyDayCycleRemap:
 308+ E5FF E5               PUSH HL
 309+ E600 67               LD H, A                     ; H = attr (temp save)
 310+ E601                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 311+ E601 3A 9D E4         LD A, (BgSpriteSkipRemap)
 312+ E604 B7               OR A
 313+ E605 20 06            JR NZ, .skipRemap
 314+ E607 3A 97 E4         LD A, (CurrentTimeOfDay)
 315+ E60A B7               OR A
 316+ E60B 20 03            JR NZ, .doRemap
 317+ E60D              .skipRemap:
 318+ E60D 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 319+ E60E E1               POP HL
 320+ E60F C9               RET
 321+ E610
 322+ E610              .doRemap:
 323+ E610 D5               PUSH DE
 324+ E611 C5               PUSH BC
 325+ E612
 326+ E612 7C               LD A, H                     ; A = attr original
 327+ E613 4F               LD C, A                     ; C = attr original
 328+ E614
 329+ E614                  ; Guardar flash + ink (bits 7, 2-0)
 330+ E614 E6 87            AND $87                     ; A = F000_0III
 331+ E616 47               LD B, A                     ; B = flash | ink
 332+ E617
 333+ E617                  ; Extraer paper+bright como indice 0-15
 334+ E617 79               LD A, C
 335+ E618 E6 78            AND $78                     ; A = 0BPPP000
 336+ E61A 0F               RRCA
 337+ E61B 0F               RRCA
 338+ E61C 0F               RRCA                        ; A = 0000BPPP = indice
 339+ E61D
 340+ E61D                  ; Elegir tabla segun tipo de sprite
 341+ E61D 5F               LD E, A
 342+ E61E 16 00            LD D, 0
 343+ E620 3A 9C E4         LD A, (BgSpriteIsHouse)
 344+ E623 B7               OR A
 345+ E624 28 05            JR Z, .useStdTable
 346+ E626 2A 9A E4         LD HL, (CurrentHouseRemapTable)
 347+ E629 18 03            JR .doLookup
 348+ E62B              .useStdTable:
 349+ E62B 2A 98 E4         LD HL, (CurrentRemapTable)
 350+ E62E              .doLookup:
 351+ E62E 19               ADD HL, DE
 352+ E62F 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 353+ E630
 354+ E630                  ; Reconstruir atributo
 355+ E630 07               RLCA
 356+ E631 07               RLCA
 357+ E632 07               RLCA                        ; A = 0BPPP000
 358+ E633 B0               OR B                        ; A = FBPPPIII
 359+ E634
 360+ E634 C1               POP BC
 361+ E635 D1               POP DE
 362+ E636 E1               POP HL
 363+ E637 C9               RET
 364+ E638
 365+ E638              ; ==============================================================================
 366+ E638              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 367+ E638              ; ==============================================================================
 368+ E638              ; Entrada: A = sprite ID
 369+ E638              ; Setea BgSpriteIsHouse (0 o 1)
 370+ E638              ; Preserva: A, DE, IX
 371+ E638              ;
 372+ E638              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 373+ E638              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 374+ E638              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 375+ E638              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 376+ E638              ; ==============================================================================
 377+ E638              CheckIfHouseSprite:
 378+ E638 F5               PUSH AF
 379+ E639 E5               PUSH HL
 380+ E63A C5               PUSH BC
 381+ E63B
 382+ E63B 47               LD B, A                     ; B = id buscado
 383+ E63C
 384+ E63C AF               XOR A
 385+ E63D 32 9C E4         LD (BgSpriteIsHouse), A     ; Default: no es house
 386+ E640
 387+ E640 21 55 E1         LD HL, HouseIdList
 388+ E643              .checkLoop:
 389+ E643 7E               LD A, (HL)
 390+ E644 FE FF            CP $FF
 391+ E646 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 392+ E648 B8               CP B
 393+ E649 28 03            JR Z, .checkFound
 394+ E64B 23               INC HL
 395+ E64C 18 F5            JR .checkLoop
 396+ E64E
 397+ E64E              .checkFound:
 398+ E64E 3E 01            LD A, 1
 399+ E650 32 9C E4         LD (BgSpriteIsHouse), A
 400+ E653
 401+ E653              .checkDone:
 402+ E653 C1               POP BC
 403+ E654 E1               POP HL
 404+ E655 F1               POP AF
 405+ E656 C9               RET
 406+ E657
 407+ E657              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 408+ E657              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 409+ E657              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 410+ E657
 411+ E657              ; ==============================================================================
 412+ E657              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 413+ E657              ; ==============================================================================
 414+ E657              ; Formato: XX,YY:NN nombre_room     DY
 415+ E657              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 416+ E657              ; ==============================================================================
 417+ E657              DrawRoomInfo:
 418+ E657                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 419+ E657 1E 00            LD E, 0
 420+ E659 06 0D            LD B, 13
 421+ E65B              .clearLoop:
 422+ E65B C5               PUSH BC
 423+ E65C D5               PUSH DE
 424+ E65D 3E 20            LD A, ' '
 425+ E65F CD 12 E8         CALL DrawHudChar
 426+ E662 D1               POP DE
 427+ E663 C1               POP BC
 428+ E664 1C               INC E
 429+ E665 10 F4            DJNZ .clearLoop
 430+ E667
 431+ E667                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 432+ E667 3A 9A 82         LD A, (CurrentScreenX)
 433+ E66A 1E 00            LD E, 0
 434+ E66C CD CA E6         CALL .drawDec2
 435+ E66F
 436+ E66F                  ; --- ',' en col 2 ---
 437+ E66F 3E 2C            LD A, ','
 438+ E671 1E 02            LD E, 2
 439+ E673 CD 12 E8         CALL DrawHudChar
 440+ E676
 441+ E676                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 442+ E676 3A 9B 82         LD A, (CurrentScreenY)
 443+ E679 1E 03            LD E, 3
 444+ E67B CD CA E6         CALL .drawDec2
 445+ E67E
 446+ E67E                  ; --- ':' en col 5 ---
 447+ E67E 3E 3A            LD A, ':'
 448+ E680 1E 05            LD E, 5
 449+ E682 CD 12 E8         CALL DrawHudChar
 450+ E685
 451+ E685                  ; --- Obtener room index de MapTable[Y*16+X] ---
 452+ E685 3A 9B 82         LD A, (CurrentScreenY)
 453+ E688 6F               LD L, A
 454+ E689 26 00            LD H, 0
 455+ E68B 29               ADD HL, HL
 456+ E68C 29               ADD HL, HL
 457+ E68D 29               ADD HL, HL
 458+ E68E 29               ADD HL, HL                  ; HL = Y * 16
 459+ E68F 3A 9A 82         LD A, (CurrentScreenX)
 460+ E692 5F               LD E, A
 461+ E693 16 00            LD D, 0
 462+ E695 19               ADD HL, DE                  ; HL = Y*16 + X
 463+ E696 11 C0 DF         LD DE, MapTable
 464+ E699 19               ADD HL, DE
 465+ E69A 7E               LD A, (HL)                  ; A = room index (0-47)
 466+ E69B F5               PUSH AF                     ; guardar room index
 467+ E69C
 468+ E69C                  ; --- Room index como 2 hex en cols 6-7 ---
 469+ E69C F5               PUSH AF
 470+ E69D 0F               RRCA
 471+ E69E 0F               RRCA
 472+ E69F 0F               RRCA
 473+ E6A0 0F               RRCA
 474+ E6A1 E6 0F            AND $0F
 475+ E6A3 CD E8 E6         CALL .hexToAscii
 476+ E6A6 1E 06            LD E, 6
 477+ E6A8 CD 12 E8         CALL DrawHudChar
 478+ E6AB F1               POP AF
 479+ E6AC E6 0F            AND $0F
 480+ E6AE CD E8 E6         CALL .hexToAscii
 481+ E6B1 1E 07            LD E, 7
 482+ E6B3 CD 12 E8         CALL DrawHudChar
 483+ E6B6
 484+ E6B6                  ; --- Espacio en col 8 ---
 485+ E6B6 3E 20            LD A, ' '
 486+ E6B8 1E 08            LD E, 8
 487+ E6BA CD 12 E8         CALL DrawHudChar
 488+ E6BD
 489+ E6BD                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 490+ E6BD F1               POP AF                      ; A = room index (descartar)
 491+ E6BE
 492+ E6BE                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 493+ E6BE 21 20 58         LD HL, ATTR_BASE + 1 * 32
 494+ E6C1 3E 47            LD A, $47                   ; bright white on black
 495+ E6C3 06 0D            LD B, 13
 496+ E6C5              .attrLoop:
 497+ E6C5 77               LD (HL), A
 498+ E6C6 23               INC HL
 499+ E6C7 10 FC            DJNZ .attrLoop
 500+ E6C9 C9               RET
 501+ E6CA
 502+ E6CA              ; --- Helpers ---
 503+ E6CA              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 504+ E6CA              .drawDec2:
 505+ E6CA 4B               LD C, E                     ; guardar columna inicial
 506+ E6CB 06 00            LD B, 0                     ; decenas
 507+ E6CD              .divLoop:
 508+ E6CD FE 0A            CP 10
 509+ E6CF 38 05            JR C, .divDone
 510+ E6D1 D6 0A            SUB 10
 511+ E6D3 04               INC B
 512+ E6D4 18 F7            JR .divLoop
 513+ E6D6              .divDone:
 514+ E6D6                  ; B = decenas, A = unidades
 515+ E6D6 F5               PUSH AF                     ; guardar unidades
 516+ E6D7 78               LD A, B
 517+ E6D8 C6 30            ADD A, '0'
 518+ E6DA 59               LD E, C
 519+ E6DB C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 520+ E6DC CD 12 E8         CALL DrawHudChar
 521+ E6DF C1               POP BC                      ; restaurar C
 522+ E6E0 F1               POP AF
 523+ E6E1 C6 30            ADD A, '0'
 524+ E6E3 59               LD E, C
 525+ E6E4 1C               INC E
 526+ E6E5 C3 12 E8         JP DrawHudChar              ; tail call
 527+ E6E8
 528+ E6E8              .hexToAscii:
 529+ E6E8 FE 0A            CP 10
 530+ E6EA 38 03            JR C, .isDigit
 531+ E6EC C6 37            ADD A, 'A' - 10
 532+ E6EE C9               RET
 533+ E6EF              .isDigit:
 534+ E6EF C6 30            ADD A, '0'
 535+ E6F1 C9               RET
 536+ E6F2
 537+ E6F2              ; ==============================================================================
 538+ E6F2              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 539+ E6F2              ; Usa font custom (DayHudFont) en vez de ROM font
 540+ E6F2              ; ==============================================================================
 541+ E6F2              DrawDayCycleHUD:
 542+ E6F2                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 543+ E6F2 21 B0 E9         LD HL, DayHudFont + 0 * 8          ; 'D'
 544+ E6F5 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 545+ E6F8 CD 67 E7         CALL .drawChar
 546+ E6FB 21 B8 E9         LD HL, DayHudFont + 1 * 8          ; 'A'
 547+ E6FE 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 548+ E701 CD 67 E7         CALL .drawChar
 549+ E704 21 C0 E9         LD HL, DayHudFont + 2 * 8          ; 'Y'
 550+ E707 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 551+ E70A CD 67 E7         CALL .drawChar
 552+ E70D                  ; Col 7 = espacio (limpiar)
 553+ E70D 11 07 40         LD DE, $4007
 554+ E710 CD 70 E7         CALL .clearChar
 555+ E713
 556+ E713                  ; --- Digito decenas (col 8) ---
 557+ E713 3A D3 BF         LD A, (DayCycleCount)
 558+ E716 FE 0A            CP 10
