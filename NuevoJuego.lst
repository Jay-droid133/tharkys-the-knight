1163+ 660F              ; ==============================================================================
1164+ 660F C9           SFX_TownGate_OnStart:           RET
1165+ 6610 C9           SFX_TownGate_OnArmIn:           RET
1166+ 6611 C9           SFX_TownGate_OnFingerIn:        RET
1167+ 6612 C9           SFX_TownGate_OnShake:           RET
1168+ 6613 C9           SFX_TownGate_OnFingerPulse:     RET
1169+ 6614 C9           SFX_TownGate_OnFingerOut:       RET
1170+ 6615 C9           SFX_TownGate_OnArmOut:          RET
1171+ 6616 C9           SFX_TownGate_OnPlayerTurn:      RET
1172+ 6617 C9           SFX_TownGate_OnPlayerFramed:    RET
1173+ 6618 C9           SFX_TownGate_OnPlayerExit:      RET
1174+ 6619 C9           SFX_TownGate_OnTheEnd:          RET
