# file opened: code/ay_sound.asm
   1+ E49E              ; ==============================================================================
   2+ E49E              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E49E              ; ==============================================================================
   4+ E49E              ; Puertos:
   5+ E49E              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E49E              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E49E              ;
   8+ E49E              ; Registros AY:
   9+ E49E              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E49E              ;   R2/R3: tono canal B
  11+ E49E              ;   R4/R5: tono canal C
  12+ E49E              ;   R6:    period del ruido (5 bits)
  13+ E49E              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E49E              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E49E              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E49E              ;   R9:    volumen B
  17+ E49E              ;   R10:   volumen C
  18+ E49E              ;   R11/R12: period del envelope
  19+ E49E              ;   R13:   forma del envelope (0-15)
  20+ E49E              ; ==============================================================================
  21+ E49E
  22+ E49E              ; ==============================================================================
  23+ E49E              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E49E              ; ==============================================================================
  25+ E49E              ; Entrada: A = registro (0-13), E = valor
  26+ E49E              ; Destruye: BC, A
  27+ E49E              ; ==============================================================================
  28+ E49E              AY_WriteReg:
  29+ E49E 01 FD FF         LD BC, $FFFD
  30+ E4A1 ED 79            OUT (C), A                  ; seleccionar registro
  31+ E4A3 01 FD BF         LD BC, $BFFD
  32+ E4A6 ED 59            OUT (C), E                  ; escribir valor
  33+ E4A8 C9               RET
  34+ E4A9
  35+ E4A9              ; ==============================================================================
  36+ E4A9              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E4A9              ; ==============================================================================
  38+ E4A9              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E4A9              ; ==============================================================================
  40+ E4A9              AY_StopImpl:
  41+ E4A9 3E 08            LD A, 8
  42+ E4AB 1E 00            LD E, 0
  43+ E4AD CD 9E E4         CALL AY_WriteReg
  44+ E4B0 3E 09            LD A, 9
  45+ E4B2 1E 00            LD E, 0
  46+ E4B4 CD 9E E4         CALL AY_WriteReg
  47+ E4B7 3E 0A            LD A, 10
  48+ E4B9 1E 00            LD E, 0
  49+ E4BB CD 9E E4         CALL AY_WriteReg
  50+ E4BE C9               RET
  51+ E4BF
  52+ E4BF
  53+ E4BF              ; ==============================================================================
  54+ E4BF              ; AY_Init - Silencia todos los canales (volumen 0). Mixer = $38 (todos los
  55+ E4BF              ; tonos enable, ruidos off). El silencio se gestiona via volumen por canal:
  56+ E4BF              ; bell, music poly y SFX comparten el chip sin clobbear el mixer entre ellos.
  57+ E4BF              ; ==============================================================================
  58+ E4BF              AY_InitImpl:
  59+ E4BF 3E 07            LD A, 7                     ; mixer
  60+ E4C1 1E 38            LD E, $38                   ; tonos ABC on, ruidos off; muting via vol
  61+ E4C3 CD 9E E4         CALL AY_WriteReg
  62+ E4C6 3E 08            LD A, 8                     ; volumen A
  63+ E4C8 1E 00            LD E, 0
  64+ E4CA CD 9E E4         CALL AY_WriteReg
  65+ E4CD 3E 09            LD A, 9                     ; volumen B
  66+ E4CF 1E 00            LD E, 0
  67+ E4D1 CD 9E E4         CALL AY_WriteReg
  68+ E4D4 3E 0A            LD A, 10                    ; volumen C
  69+ E4D6 1E 00            LD E, 0
  70+ E4D8 CD 9E E4         CALL AY_WriteReg
  71+ E4DB C9               RET
  72+ E4DC
  73+ E4DC              ; ==============================================================================
  74+ E4DC              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  75+ E4DC              ; ==============================================================================
  76+ E4DC              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  77+ E4DC              ; el AY toca solo durante el decay.
  78+ E4DC              ; ==============================================================================
  79+ E4DC              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  80+ E4DC              ; ==============================================================================
  81+ E4DC              ; ==============================================================================
  82+ E4DC              ; Variables del decay manual de la campana (con pan estereo)
  83+ E4DC              ; ==============================================================================
  84+ E4DC              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  85+ E4DC              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  86+ E4DC              ; Cuando los 3 son 0, la campana esta silenciada.
  87+ E4DC 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  88+ E4DD 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  89+ E4DE 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  90+ E4DF 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  91+ E4E0
  92+ E4E0              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  93+ E4E0
  94+ E4E0              ; ==============================================================================
  95+ E4E0              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  96+ E4E0              ; ==============================================================================
  97+ E4E0              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  98+ E4E0              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  99+ E4E0              ; ==============================================================================
 100+ E4E0              AY_PlayBellChimeImpl:
 101+ E4E0                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 102+ E4E0                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 103+ E4E0                  ; editor — el sonido espacial debe centrarse en la plaza real).
 104+ E4E0 3A 08 83         LD A, (CurrentScreenX)
 105+ E4E3 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 106+ E4E5 57               LD D, A                     ; D = dx signed (player - plaza)
 107+ E4E6 30 02            JR NC, .absDxOk
 108+ E4E8 ED 44            NEG
 109+ E4EA              .absDxOk:
 110+ E4EA 47               LD B, A                     ; B = |dx|
 111+ E4EB
 112+ E4EB 3A 09 83         LD A, (CurrentScreenY)
 113+ E4EE D6 09            SUB PLAZA_SCREEN_Y
 114+ E4F0 30 02            JR NC, .absDyOk
 115+ E4F2 ED 44            NEG
 116+ E4F4              .absDyOk:
 117+ E4F4 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 118+ E4F5
 119+ E4F5                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 120+ E4F5                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente, dom +9dB)
 121+ E4F5                  ;   dist 3..5  -> dom=12, far= 8  (medio: mas direccional, dom +12dB)
 122+ E4F5                  ;   dist 6+    -> dom= 9, far= 5  (lejos: muy direccional, dom +12dB)
 123+ E4F5                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 124+ E4F5 06 09            LD B, 9                     ; default tramo lejano: dom
 125+ E4F7 0E 05            LD C, 5                     ;                       far
 126+ E4F9 FE 06            CP 6
 127+ E4FB 30 0C            JR NC, .volTotalSet
 128+ E4FD 06 0C            LD B, 12                    ; tramo medio
 129+ E4FF 0E 08            LD C, 8
 130+ E501 FE 03            CP 3
 131+ E503 30 04            JR NC, .volTotalSet
 132+ E505 06 0F            LD B, 15                    ; tramo cercano
 133+ E507 0E 0C            LD C, 12
 134+ E509              .volTotalSet:                   ; B = dom_vol, C = far_vol
 135+ E509
 136+ E509                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 137+ E509                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 138+ E509                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 139+ E509                  ; D == 0 → alineado X → solo canal B (centro)
 140+ E509 7A               LD A, D
 141+ E50A B7               OR A
 142+ E50B 28 21            JR Z, .panCenter
 143+ E50D F2 1F E5         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 144+ E510                  ; D < 0: plaza al este → canal C dominante
 145+ E510              .panRight:
 146+ E510 79               LD A, C
 147+ E511 32 DC E4         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 148+ E514 78               LD A, B
 149+ E515 32 DE E4         LD (BellVolR), A            ; canal C = dom
 150+ E518 CB 3F            SRL A
 151+ E51A 32 DD E4         LD (BellVolC), A            ; canal B = dom/2
 152+ E51D 18 1A            JR .panDone
 153+ E51F
 154+ E51F              .panLeft:
 155+ E51F                  ; D > 0: plaza al oeste → canal A dominante
 156+ E51F 78               LD A, B
 157+ E520 32 DC E4         LD (BellVolL), A            ; canal A = dom
 158+ E523 CB 3F            SRL A
 159+ E525 32 DD E4         LD (BellVolC), A            ; canal B = dom/2
 160+ E528 79               LD A, C
 161+ E529 32 DE E4         LD (BellVolR), A            ; canal C = far
 162+ E52C 18 0B            JR .panDone
 163+ E52E
 164+ E52E              .panCenter:
 165+ E52E                  ; Alineado: solo canal B
 166+ E52E 78               LD A, B
 167+ E52F 32 DD E4         LD (BellVolC), A
 168+ E532 AF               XOR A
 169+ E533 32 DC E4         LD (BellVolL), A
 170+ E536 32 DE E4         LD (BellVolR), A
 171+ E539
 172+ E539              .panDone:
 173+ E539 3E 02            LD A, BELL_DECAY_RATE
 174+ E53B 32 DF E4         LD (BellDecayTimer), A
 175+ E53E
 176+ E53E                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 177+ E53E 3E 00            LD A, 0                     ; R0: tone A LSB
 178+ E540 1E 58            LD E, $58
 179+ E542 CD 9E E4         CALL AY_WriteReg
 180+ E545 3E 01            LD A, 1                     ; R1: tone A MSB
 181+ E547 1E 02            LD E, $02
 182+ E549 CD 9E E4         CALL AY_WriteReg
 183+ E54C 3E 02            LD A, 2                     ; R2: tone B LSB
 184+ E54E 1E 58            LD E, $58
 185+ E550 CD 9E E4         CALL AY_WriteReg
 186+ E553 3E 03            LD A, 3                     ; R3: tone B MSB
 187+ E555 1E 02            LD E, $02
 188+ E557 CD 9E E4         CALL AY_WriteReg
 189+ E55A 3E 04            LD A, 4                     ; R4: tone C LSB
 190+ E55C 1E 58            LD E, $58
 191+ E55E CD 9E E4         CALL AY_WriteReg
 192+ E561 3E 05            LD A, 5                     ; R5: tone C MSB
 193+ E563 1E 02            LD E, $02
 194+ E565 CD 9E E4         CALL AY_WriteReg
 195+ E568
 196+ E568                  ; --- Mixer: tonos A, B, C activos ---
 197+ E568 3E 07            LD A, 7
 198+ E56A 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 199+ E56C CD 9E E4         CALL AY_WriteReg
 200+ E56F
 201+ E56F                  ; --- Volúmenes iniciales ---
 202+ E56F 3E 08            LD A, 8
 203+ E571 21 DC E4         LD HL, BellVolL
 204+ E574 5E               LD E, (HL)
 205+ E575 CD 9E E4         CALL AY_WriteReg
 206+ E578 3E 09            LD A, 9
 207+ E57A 21 DD E4         LD HL, BellVolC
 208+ E57D 5E               LD E, (HL)
 209+ E57E CD 9E E4         CALL AY_WriteReg
 210+ E581 3E 0A            LD A, 10
 211+ E583 21 DE E4         LD HL, BellVolR
 212+ E586 5E               LD E, (HL)
 213+ E587 CD 9E E4         CALL AY_WriteReg
 214+ E58A
 215+ E58A C9               RET
