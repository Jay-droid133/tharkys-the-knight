2658+ AD58 CB 7F            BIT 7, A
2659+ AD5A 28 02            JR Z, .eAnimDir
2660+ AD5C 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2661+ AD5E              .eAnimDir:
2662+ AD5E DD 35 09         DEC (IX+ENT_ANIMTIMER)
2663+ AD61 20 27            JR NZ, .eAnimDone
