 410+ E6CA 3E 47            LD A, WHITE | $40
 411+ E6CC 32 0D 58         LD ($580D), A
 412+ E6CF 32 0E 58         LD ($580E), A
 413+ E6D2 32 2D 58         LD ($582D), A
 414+ E6D5 32 2E 58         LD ($582E), A
 415+ E6D8 32 11 58         LD ($5811), A
 416+ E6DB 32 12 58         LD ($5812), A
 417+ E6DE 32 31 58         LD ($5831), A
 418+ E6E1 32 32 58         LD ($5832), A
