1347+ A98D 32 42 B6         LD (MonsterHitThisAttack), A
1348+ A990 32 43 B6         LD (MonsterHitThisAttack+1), A
1349+ A993 32 44 B6         LD (MonsterHitThisAttack+2), A
1350+ A996
1351+ A996                  ; Timer = ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT (fijo, 25fps constante)
1352+ A996 3E 05            LD A, ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT
1353+ A998 32 33 B6         LD (AttackTimer), A
1354+ A99B
1355+ A99B                  ; Marcar que el SFX de este ciclo aun no sono
1356+ A99B                  ; (evita doble: newAnimSfx + wrapSfx en el mismo ciclo)
1357+ A99B AF               XOR A
1358+ A99C 32 36 B6         LD (AttackSfxPlayed), A
1359+ A99F
1360+ A99F DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
