1329+ 9401 29               ADD HL, HL
1330+ 9402 29               ADD HL, HL
1331+ 9403 29               ADD HL, HL
1332+ 9404 29               ADD HL, HL                              ; HL = cy * 32
1333+ 9405 7B               LD A, E
1334+ 9406 85               ADD A, L
1335+ 9407 6F               LD L, A
1336+ 9408 30 01            JR NC, .cpzaNoCarry
1337+ 940A 24               INC H
1338+ 940B              .cpzaNoCarry:
1339+ 940B 01 D1 C9         LD BC, FlowField
