 300+ E672              ; ==============================================================================
 301+ E672              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 302+ E672              ; ==============================================================================
 303+ E672              ; Entrada: A = attr original
 304+ E672              ; Salida:  A = attr transformado
 305+ E672              ; Preserva: HL, DE, BC, IX
 306+ E672              ; ==============================================================================
 307+ E672              ApplyDayCycleRemap:
 308+ E672 E5               PUSH HL
 309+ E673 67               LD H, A                     ; H = attr (temp save)
 310+ E674                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 311+ E674 3A 10 E5         LD A, (BgSpriteSkipRemap)
 312+ E677 B7               OR A
 313+ E678 20 06            JR NZ, .skipRemap
 314+ E67A 3A 0A E5         LD A, (CurrentTimeOfDay)
 315+ E67D B7               OR A
 316+ E67E 20 03            JR NZ, .doRemap
 317+ E680              .skipRemap:
 318+ E680 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 319+ E681 E1               POP HL
 320+ E682 C9               RET
 321+ E683
 322+ E683              .doRemap:
 323+ E683 D5               PUSH DE
 324+ E684 C5               PUSH BC
 325+ E685
 326+ E685 7C               LD A, H                     ; A = attr original
 327+ E686 4F               LD C, A                     ; C = attr original
 328+ E687
 329+ E687                  ; Guardar flash + ink (bits 7, 2-0)
 330+ E687 E6 87            AND $87                     ; A = F000_0III
 331+ E689 47               LD B, A                     ; B = flash | ink
 332+ E68A
 333+ E68A                  ; Extraer paper+bright como indice 0-15
 334+ E68A 79               LD A, C
 335+ E68B E6 78            AND $78                     ; A = 0BPPP000
 336+ E68D 0F               RRCA
 337+ E68E 0F               RRCA
 338+ E68F 0F               RRCA                        ; A = 0000BPPP = indice
 339+ E690
 340+ E690                  ; Elegir tabla segun tipo de sprite
 341+ E690 5F               LD E, A
 342+ E691 16 00            LD D, 0
 343+ E693 3A 0F E5         LD A, (BgSpriteIsHouse)
 344+ E696 B7               OR A
 345+ E697 28 05            JR Z, .useStdTable
 346+ E699 2A 0D E5         LD HL, (CurrentHouseRemapTable)
 347+ E69C 18 03            JR .doLookup
 348+ E69E              .useStdTable:
 349+ E69E 2A 0B E5         LD HL, (CurrentRemapTable)
 350+ E6A1              .doLookup:
 351+ E6A1 19               ADD HL, DE
 352+ E6A2 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 353+ E6A3
 354+ E6A3                  ; Reconstruir atributo
 355+ E6A3 07               RLCA
 356+ E6A4 07               RLCA
 357+ E6A5 07               RLCA                        ; A = 0BPPP000
 358+ E6A6 B0               OR B                        ; A = FBPPPIII
 359+ E6A7
 360+ E6A7 C1               POP BC
 361+ E6A8 D1               POP DE
 362+ E6A9 E1               POP HL
 363+ E6AA C9               RET
