 498+ 7EBD 2A AD 7B         LD HL, (MusicPeriodA)
 499+ 7EC0 7C               LD A, H
 500+ 7EC1 B5               OR L
 501+ 7EC2 20 09            JR NZ, .map3NoteA
 502+ 7EC4 3E 08            LD A, 8
 503+ 7EC6 1E 00            LD E, 0
 504+ 7EC8 CD 87 7D         CALL AY_WriteRegSlot1
 505+ 7ECB 18 18            JR .map3DoB
 506+ 7ECD              .map3NoteA:
 507+ 7ECD E5               PUSH HL
 508+ 7ECE 3E 08            LD A, 8
 509+ 7ED0 1E 0C            LD E, 12
 510+ 7ED2 CD 87 7D         CALL AY_WriteRegSlot1
 511+ 7ED5 E1               POP HL
 512+ 7ED6 5D               LD E, L
 513+ 7ED7 3E 00            LD A, 0
 514+ 7ED9 CD 87 7D         CALL AY_WriteRegSlot1
 515+ 7EDC 2A AD 7B         LD HL, (MusicPeriodA)
