2476+ AFBC FE 01            CP 1
2477+ AFBE 38 38            JR C, .paRevert
2478+ AFC0 DD 77 03         LD (IX+ENT_POSX), A
2479+ AFC3
2480+ AFC3                  ; Aplicar movimiento Y
2481+ AFC3 DD 7E 04         LD A, (IX+ENT_POSY)
2482+ AFC6 DD 86 07         ADD A, (IX+ENT_DELTAY)
2483+ AFC9 FE A8            CP SCREEN_MAX_Y
2484+ AFCB 30 2B            JR NC, .paRevert                    ; Fuera de rango Y
2485+ AFCD FE 10            CP SCREEN_MIN_Y
2486+ AFCF 38 27            JR C, .paRevert
2487+ AFD1 DD 77 04         LD (IX+ENT_POSY), A
2488+ AFD4
2489+ AFD4                  ; Comprobar colision con fondo
2490+ AFD4 CD D6 B9         CALL CheckEnemyCollision
2491+ AFD7 20 1F            JR NZ, .paRevert                    ; Choco con pared
2492+ AFD9
2493+ AFD9                  ; --- Animacion durante ataque ---
2494+ AFD9 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2495+ AFDC 20 19            JR NZ, .paAnimDone
2496+ AFDE 3E 04            LD A, 4                             ; Delay fijo rapido durante ataque
2497+ AFE0 DD 77 09         LD (IX+ENT_ANIMTIMER), A
2498+ AFE3 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2499+ AFE6 DD 96 08         SUB (IX+ENT_ANIMBASE)
