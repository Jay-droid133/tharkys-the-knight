 112  66C3                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 113  66C3                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 114  66C3                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 115  66C3                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 116  66C3                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 117  66C3                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 66C3              ; ==============================================================================
   2+ 66C3              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 66C3              ; ==============================================================================
   4+ 66C3              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 66C3              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 66C3              ; la cinematica — invisible porque es one-shot.
   7+ 66C3              ;
   8+ 66C3              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 66C3              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 66C3              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 66C3              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 66C3              ; ==============================================================================
  13+ 66C3
  14+ 66C3              ; ==============================================================================
  15+ 66C3              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 66C3              ; ==============================================================================
  17+ 66C3              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 66C3              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 66C3              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 66C3              ; ChurchCutsceneSlot.
  21+ 66C3              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 66C3              ; ==============================================================================
  23+ 66C3              EraseChurchTrappedMonster:
  24+ 66C3 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 66C6 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 66C7 6F               LD L, A
  27+ 66C8 26 00            LD H, 0
  28+ 66CA 29               ADD HL, HL
  29+ 66CB 29               ADD HL, HL
  30+ 66CC 29               ADD HL, HL
  31+ 66CD 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 66CE 11 4B 81         LD DE, EntityTable
  33+ 66D1 19               ADD HL, DE
  34+ 66D2 E5               PUSH HL
  35+ 66D3 DD E1            POP IX
  36+ 66D5 CD 2E A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66D8 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66DB 57               LD D, A
  39+ 66DC DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66DF 5F               LD E, A
  41+ 66E0 DD 2A B6 A7      LD IX, (OldSprAddr)
  42+ 66E4 C3 33 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 66E7
  44+ 66E7              ; ==============================================================================
  45+ 66E7              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 66E7              ; ==============================================================================
  47+ 66E7              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 66E7              ; - Despawn monster (ENT_TYPE=0).
  49+ 66E7              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 66E7              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 66E7              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 66E7              ; ==============================================================================
  53+ 66E7              ApplyChurchTrapDone:
  54+ 66E7                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 66E7 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 66EA 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 66EB 6F               LD L, A
  58+ 66EC 26 00            LD H, 0
  59+ 66EE 29               ADD HL, HL
  60+ 66EF 29               ADD HL, HL
  61+ 66F0 29               ADD HL, HL
  62+ 66F1 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 66F2 11 4B 81         LD DE, EntityTable
  64+ 66F5 19               ADD HL, DE
  65+ 66F6 E5               PUSH HL
  66+ 66F7 DD E1            POP IX
  67+ 66F9                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 66F9                  ; guardado en TriggerChurchTrap).
  69+ 66F9 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 66FC 21 79 67         LD HL, ChurchTrapBitMask
  71+ 66FF 5F               LD E, A
  72+ 6700 16 00            LD D, 0
  73+ 6702 19               ADD HL, DE
  74+ 6703 7E               LD A, (HL)
  75+ 6704 21 6E 82         LD HL, MonsterTrappedFlags
  76+ 6707 B6               OR (HL)
  77+ 6708 77               LD (HL), A
  78+ 6709                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 6709                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 6709                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 6709 21 6F 82         LD HL, NextChurchTrapStep
  82+ 670C 34               INC (HL)
  83+ 670D                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 670D                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 670D                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 670D                  ; antes de quedarse fija en blanco brillante.
  87+ 670D DD E5            PUSH IX
  88+ 670F CD 03 F5         CALL StartStatueBlink
  89+ 6712 DD E1            POP IX
  90+ 6714                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 6714                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 6714                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 6714 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 6718 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 671C DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 6720 DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 6724                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 6724                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 6724                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 6724                  ; anteriores del cutscene.)
 101+ 6724                  ; Decidir spawn: 3 atrapados?
 102+ 6724 3A 6E 82         LD A, (MonsterTrappedFlags)
 103+ 6727 E6 07            AND $07
 104+ 6729 FE 07            CP $07
 105+ 672B 28 12            JR Z, .actdAllTrapped
 106+ 672D                  ; <3 atrapados: respawn church_key en AltN
 107+ 672D 3E 01            LD A, 1
 108+ 672F 32 60 82         LD (ChurchKeySpawned), A
 109+ 6732 21 71 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 6735 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6736 CD CA 69         CALL RespawnChurchKeyAtAlt
 112+ 6739                  ; Dibujar surgical en su nueva posicion
 113+ 6739 11 72 DB         LD DE, BgGfx_church_key
 114+ 673C C3 9A DA         JP RedrawPickupByPtr
 115+ 673F              .actdAllTrapped:
 116+ 673F                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 673F                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 673F                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 673F                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 673F                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 673F                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 673F AF               XOR A
 123+ 6740 32 63 82         LD (TimeFrozen), A
 124+ 6743 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 6745 32 74 82         LD (PostTrapPauseTimer), A
 126+ 6748 C9               RET
 127+ 6749
 128+ 6749              ; ==============================================================================
 129+ 6749              ; UpdatePostTrapPause - Tick + dispara eventos diferidos tras cutscene de iglesia
 130+ 6749              ; ==============================================================================
 131+ 6749              ; Llamado cada frame desde MainLoop. No-op si timer = 0 (caso normal).
 132+ 6749              ; Cuando ApplyChurchTrapDone setea el timer a 50, esta rutina decrementa cada
 133+ 6749              ; frame y dispara los eventos a los frames precisos:
 134+ 6749              ;   timer=25 (= 1s desde inicio): aparece town_gate_key + advance milestone 7→8.
 135+ 6749              ;   timer=0  (= 2s desde inicio): nasties resumen (via guard en TrySpawnNasty).
 136+ 6749              ; ==============================================================================
 137+ 6749              UpdatePostTrapPause:
 138+ 6749 3A 74 82         LD A, (PostTrapPauseTimer)
 139+ 674C B7               OR A
 140+ 674D C8               RET Z
 141+ 674E 3D               DEC A
 142+ 674F 32 74 82         LD (PostTrapPauseTimer), A
 143+ 6752 FE 4B            CP POST_TRAP_KEY_DELAY              ; ¿cae justo en el frame del key spawn?
 144+ 6754 C0               RET NZ
 145+ 6755                  ; t=1s: aparece la llave + avance del hito.
 146+ 6755                  ; SFX primero (mismo "clink" que el church_key cuando aparece en la plaza
 147+ 6755                  ; del ayuntamiento): se oye antes de que se dibuje, igual que en CheckBumpTriggers.
 148+ 6755 21 8D FA         LD HL, SFX_KeyDrop
 149+ 6758 CD 4F F9         CALL PlaySFX
 150+ 675B 3E 01            LD A, 1
 151+ 675D 32 72 82         LD (TownGateKeySpawned), A
 152+ 6760 11 37 DB         LD DE, BgGfx_town_gate_key
 153+ 6763 CD 9A DA         CALL RedrawPickupByPtr
 154+ 6766 3A 67 82         LD A, (CurrentObjective)
 155+ 6769 FE 07            CP 7
 156+ 676B C0               RET NZ
 157+ 676C 3C               INC A
 158+ 676D 32 67 82         LD (CurrentObjective), A
 159+ 6770 CD C8 F1         CALL ResolveObjectiveScreen
 160+ 6773 3E FF            LD A, $FF
 161+ 6775 32 6A 82         LD (PreviousObjectiveDistance), A
 162+ 6778 C9               RET
