 286+ CEAA              .doTransition:
 287+ CEAA                  ; Silenciar musica de la muerte INMEDIATAMENTE al cruzar el borde. Se hace
 288+ CEAA                  ; aqui (no en el bloque de reset al final del draw de la nueva sala) para
 289+ CEAA                  ; que no haya 1-2 frames de coletazo musical durante la transicion.
 290+ CEAA                  ; $FD = stop-if-loopable: solo corta DeathMusic (loopable, ligada a Death
 291+ CEAA                  ; entity que se despawnea ahora). Tracks one-shot (tension/sunrise/endgame)
 292+ CEAA                  ; siguen sonando — no tienen sentido cortarlos al cambiar de sala.
 293+ CEAA F5               PUSH AF
 294+ CEAB 3E FD            LD A, $FD
 295+ CEAD CD B3 99         CALL StartMusic
 296+ CEB0 F1               POP AF
 297+ CEB1 3A 05 83         LD A, (ScreenTransition)
 298+ CEB4 32 06 83         LD (LastScreenTransition), A
 299+ CEB7                  ; Guardar posicion del player al entrar (unico punto seguro para monsters)
 300+ CEB7 3A 97 81         LD A, (EntityTable + ENT_POSX)
 301+ CEBA 32 07 83         LD (LastEntryPosX), A
 302+ CEBD 3A 98 81         LD A, (EntityTable + ENT_POSY)
 303+ CEC0 32 08 83         LD (LastEntryPosY), A
 304+ CEC3 CD B9 CC         CALL CalcScreenAddress
 305+ CEC6 CD 07 CF         CALL ClearNasties           ; Limpiar enemigos al cambiar de pantalla
 306+ CEC9 CD 88 8F         CALL DespawnScaredMonsters  ; Borra monsters fleeing stuck (no siguen al player en dawn)
 307+ CECC CD 0C C0         CALL RepositionMonstersAtEntry ; Monsters siguen al player desde la pantalla anterior
 308+ CECF                  ; SFX de transicion de pantalla (comentado para pruebas)
 309+ CECF                  ; LD HL, SFX_ScreenTransition
 310+ CECF                  ; CALL PlaySFX
 311+ CECF AF               XOR A
 312+ CED0 32 7B 5F         LD (PendingEraseCount), A   ; Cancelar erases pendientes (pantalla se borra)
 313+ CED3 3E 01            LD A, 1
 314+ CED5 32 09 83         LD (ScreenDirty), A
 315+ CED8 32 0B 83         LD (ScreenJustRedrawn), A
 316+ CEDB
 317+ CEDB                  ; --- Reiniciar el patron "po-po-popo-po" de MonstersMusic en cada cruce ---
 318+ CEDB                  ; Si el secuencer esta activo (Step != $FF), resetear Step=0 + Timer=1 ->
 319+ CEDB                  ; el primer "po" suena en el frame inmediato de la nueva sala.
 320+ CEDB                  ; Step=$FF (sentinel inactivo) -> StartMonstersMusic no se llama.
 321+ CEDB 3A 54 FB         LD A, (MonstersMusicStep)
 322+ CEDE 3C               INC A
 323+ CEDF C4 16 FB         CALL NZ, StartMonstersMusic
 324+ CEE2
 325+ CEE2                  ; --- Magic compass: BFS sincronico ANTES de DrawScreen ---
 326+ CEE2                  ; Si el power-up esta activo, recalcular el path AHORA con el nuevo
 327+ CEE2                  ; CurrentScreenX/Y + LastEntrySide/Coord. Sin esto, el BFS amortizado
 328+ CEE2                  ; tarda 3-4 frames en converger y los primeros ticks visibles en la
 329+ CEE2                  ; nueva sala parpadeaban apuntando a la direccion vieja. El sync se paga
 330+ CEE2                  ; con ~10K T-states extra en el frame del cruce — el unico que ya tenia
 331+ CEE2                  ; presupuesto apretado por DrawScreen, pero solo ocurre 1 vez por cruce
 332+ CEE2                  ; y no afecta a los frames de gameplay normal.
 333+ CEE2 3A BF 5F         LD A, (MagicCompassTimer)
 334+ CEE5 47               LD B, A
 335+ CEE6 3A C0 5F         LD A, (MagicCompassTimer + 1)
 336+ CEE9 B0               OR B
 337+ CEEA C4 18 6E         CALL NZ, ForceComputeMagicCompassPath
 338+ CEED
 339+ CEED                  ; --- Achievement chime: sweep AY al entrar a la sala del hito ---
 340+ CEED                  ; Reusa AY_PlayCompassPickup (mismo sweep ascendente que el pickup del
 341+ CEED                  ; magic compass random). No bloqueante, canal B AY. Solo dispara al
 342+ CEED                  ; CRUZAR el borde de la sala objetivo (no cada frame).
 343+ CEED 3A B1 82         LD A, (ObjectiveScreenX)
 344+ CEF0 FE FF            CP $FF
 345+ CEF2 28 12            JR Z, .noSouth                  ; sin objetivo resuelto -> nada
 346+ CEF4 21 01 83         LD HL, CurrentScreenX
 347+ CEF7 BE               CP (HL)
 348+ CEF8 20 0C            JR NZ, .noSouth                 ; X distinta -> no es la sala
 349+ CEFA 3A B2 82         LD A, (ObjectiveScreenY)
 350+ CEFD 21 02 83         LD HL, CurrentScreenY
 351+ CF00 BE               CP (HL)
 352+ CF01 20 03            JR NZ, .noSouth                 ; Y distinta -> no es la sala
 353+ CF03 CD D0 6B         CALL AY_PlayCompassPickup
 354+ CF06              .noSouth:
 355+ CF06 C9               RET
 356+ CF07
 357+ CF07              ; ==============================================================================
 358+ CF07              ; ClearNasties - Limpia todos los slots de nasties (enemigos destruibles)
 359+ CF07              ; ==============================================================================
 360+ CF07              ; Los nasties no persisten entre pantallas (como en Sabre Wulf).
 361+ CF07              ; ==============================================================================
 362+ CF07              ClearNasties:
 363+ CF07 21 04 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 364+ CF0A 06 03            LD B, NUM_NASTIES
