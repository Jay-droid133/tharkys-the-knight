 148+ 67CA              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 149+ 67CA              ; ==============================================================================
 150+ 67CA              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 151+ 67CA              ;      A  = bank (0-7) donde vive el sprite
 152+ 67CA              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 153+ 67CA              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 154+ 67CA              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 155+ 67CA              ;
 156+ 67CA              ; Mismo patron que LoadRoomToBuffer: inline page switch + SP alterno (slot 1)
 157+ 67CA              ; durante la copia. IRQs siguen procesandose normalmente -> tick de musica
 158+ 67CA              ; no se desfasa durante DrawScreen. Sin DI/EI internos.
 159+ 67CA              ;
 160+ 67CA              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 161+ 67CA              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 162+ 67CA              ; ==============================================================================
 163+ 67CA              LoadBgSpriteToBuffer:
 164+ 67CA                  ; Mismo patron que LoadRoomToBuffer: SP -> alterno antes del page switch
 165+ 67CA                  ; para que las IRQs durante la copia no corrompan el stack normal (que
 166+ 67CA                  ; queda fisicamente "oculto" mientras slot 3 = bank de sprite).
 167+ 67CA 32 5C 68         LD (.lbsBankSave), A
 168+ 67CD                  ; Preservar BC del caller (DrawScreen usa B=x_char, C=y_char) ANTES de
 169+ 67CD                  ; cambiar SP — el PUSH va al stack normal. El LD SP siguiente preserva
 170+ 67CD                  ; ese frame; al restaurar SP el POP BC final lo recupera.
 171+ 67CD C5               PUSH BC
 172+ 67CE ED 73 5D 68      LD (.lbsSavedSP), SP            ; salva SP normal (con PC + BC pushed)
 173+ 67D2 31 D6 68         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
 174+ 67D5                  ; Page bank deseado inline (SIN DI)
 175+ 67D5 3A 84 8D         LD A, (CurrentPaging)
 176+ 67D8 E6 F8            AND $F8
 177+ 67DA 47               LD B, A                         ; B = paging limpio sin bank
 178+ 67DB 3A 5C 68         LD A, (.lbsBankSave)
 179+ 67DE E6 07            AND $07                         ; safety: solo bits 0-2
 180+ 67E0 B0               OR B                            ; merge bank en paging
 181+ 67E1 32 84 8D         LD (CurrentPaging), A
 182+ 67E4 01 FD 7F         LD BC, $7FFD
 183+ 67E7 ED 79            OUT (C), A
 184+ 67E9                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 185+ 67E9                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 186+ 67E9                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 187+ 67E9                  ; Si no → calcular bytes exactos y copiar byte a byte.
 188+ 67E9 11 F7 86         LD DE, BgSpriteBuffer
 189+ 67EC                  ; Copiar H (header byte 0)
 190+ 67EC 7E               LD A, (HL)
 191+ 67ED 12               LD (DE), A
 192+ 67EE 32 5A 68         LD (.lbsHsave), A
 193+ 67F1 23               INC HL
 194+ 67F2 13               INC DE
 195+ 67F3                  ; Copiar W|RLE (header byte 1)
 196+ 67F3 7E               LD A, (HL)
 197+ 67F4 12               LD (DE), A
