 913+ 6711              ; ==============================================================================
 914+ 6711              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 6711              ; ==============================================================================
 916+ 6711              TownGateDrawFingerShifted:
 917+ 6711 21 A2 E2         LD HL, BgGfx_finger
 918+ 6714 3E 03            LD A, 3
 919+ 6716 CD C2 6C         CALL LoadBgSpriteToBuffer
 920+ 6719 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 671C 47               LD B, A
 922+ 671D 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 671F 80               ADD A, B
 924+ 6720 5F               LD E, A
 925+ 6721 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 6724 47               LD B, A
 927+ 6725 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 6727 80               ADD A, B
 929+ 6728 57               LD D, A
 930+ 6729 C3 2C 67         JP DrawBgSpriteAnyXorAtPixel
 931+ 672C
 932+ 672C              ; ==============================================================================
 933+ 672C              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 672C              ; ==============================================================================
 935+ 672C              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 672C              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 672C              ;     E = pixel X (0..255).
 938+ 672C              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 672C              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 672C              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 672C              ; Destruye: AF, BC, DE, HL, IX.
 942+ 672C              ; ==============================================================================
 943+ 672C              DrawBgSpriteAnyXorAtPixel:
 944+ 672C DD 21 F8 86      LD IX, BgSpriteBuffer
 945+ 6730 DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 6733 B7               OR A
 947+ 6734 C8               RET Z
 948+ 6735 32 8F 67         LD (.dbsaHeight), A
 949+ 6738 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 673B E6 7F            AND $7F
 951+ 673D 32 90 67         LD (.dbsaWidth), A
 952+ 6740 DD 23            INC IX
 953+ 6742 DD 23            INC IX                              ; -> pixel data
 954+ 6744 7B               LD A, E
 955+ 6745 E6 07            AND $07
 956+ 6747 32 91 67         LD (.dbsaShift), A
 957+ 674A 7B               LD A, E
 958+ 674B E6 F8            AND $F8
 959+ 674D 5F               LD E, A
 960+ 674E CD 5D 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 6751              .dbsaRow:
 962+ 6751 E5               PUSH HL
 963+ 6752 3A 90 67         LD A, (.dbsaWidth)
 964+ 6755 47               LD B, A                             ; B = width counter
 965+ 6756 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 6758              .dbsaByte:
 967+ 6758 DD 7E 00         LD A, (IX+0)
 968+ 675B 2F               CPL                                 ; un-invert
 969+ 675C 57               LD D, A                             ; D = sprite byte
 970+ 675D 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 675F 3A 91 67         LD A, (.dbsaShift)
 972+ 6762 B7               OR A
 973+ 6763 28 09            JR Z, .dbsaNoShift
 974+ 6765 C5               PUSH BC
 975+ 6766 47               LD B, A
 976+ 6767              .dbsaShiftLoop:
 977+ 6767 CB 3A            SRL D
 978+ 6769 CB 1B            RR E
 979+ 676B 10 FA            DJNZ .dbsaShiftLoop
 980+ 676D C1               POP BC
 981+ 676E              .dbsaNoShift:
 982+ 676E 7A               LD A, D
 983+ 676F B1               OR C                                ; combinar con carry previo
 984+ 6770 AE               XOR (HL)
 985+ 6771 77               LD (HL), A
 986+ 6772 23               INC HL
 987+ 6773 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 6774 DD 23            INC IX
 989+ 6776 10 E0            DJNZ .dbsaByte
 990+ 6778                  ; Byte final (carry) si shift > 0
 991+ 6778 3A 91 67         LD A, (.dbsaShift)
 992+ 677B B7               OR A
 993+ 677C 28 03            JR Z, .dbsaNoFinal
 994+ 677E 79               LD A, C
 995+ 677F AE               XOR (HL)
 996+ 6780 77               LD (HL), A
 997+ 6781              .dbsaNoFinal:
 998+ 6781 E1               POP HL
 999+ 6782 CD C9 9A         CALL NextPixelLine
1000+ 6785 3A 8F 67         LD A, (.dbsaHeight)
1001+ 6788 3D               DEC A
1002+ 6789 32 8F 67         LD (.dbsaHeight), A
1003+ 678C 20 C3            JR NZ, .dbsaRow
1004+ 678E C9               RET
1005+ 678F 00           .dbsaHeight: DEFB 0
1006+ 6790 00           .dbsaWidth:  DEFB 0
1007+ 6791 00           .dbsaShift:  DEFB 0
