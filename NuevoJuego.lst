 556+ 6EFE ~                PUSH HL                              ; save record ptr
 557+ 6EFE ~
 558+ 6EFE ~                ; Match comp?
 559+ 6EFE ~                LD A, (.cmcpGapSideComp)
 560+ 6EFE ~                SRL A
 561+ 6EFE ~                SRL A                                ; A = comp (bits 2-3 → bits 0-1)
 562+ 6EFE ~                AND $03
 563+ 6EFE ~                LD C, A                              ; C = gap comp
 564+ 6EFE ~                LD A, (.cmcpRComp)
 565+ 6EFE ~                CP C
 566+ 6EFE ~                JP NZ, .cmcpGapNext
