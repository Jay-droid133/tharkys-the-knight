 490+ DF29              ; --- Helpers ---
 491+ DF29              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 492+ DF29              .drawDec2:
 493+ DF29 4B               LD C, E                     ; guardar columna inicial
 494+ DF2A 06 00            LD B, 0                     ; decenas
 495+ DF2C              .divLoop:
 496+ DF2C FE 0A            CP 10
 497+ DF2E 38 05            JR C, .divDone
 498+ DF30 D6 0A            SUB 10
 499+ DF32 04               INC B
 500+ DF33 18 F7            JR .divLoop
 501+ DF35              .divDone:
 502+ DF35                  ; B = decenas, A = unidades
 503+ DF35 F5               PUSH AF                     ; guardar unidades
 504+ DF36 78               LD A, B
 505+ DF37 C6 30            ADD A, '0'
 506+ DF39 59               LD E, C
 507+ DF3A C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 508+ DF3B CD 71 E0         CALL DrawHudChar
 509+ DF3E C1               POP BC                      ; restaurar C
 510+ DF3F F1               POP AF
 511+ DF40 C6 30            ADD A, '0'
 512+ DF42 59               LD E, C
 513+ DF43 1C               INC E
 514+ DF44 C3 71 E0         JP DrawHudChar              ; tail call
