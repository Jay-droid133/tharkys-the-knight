# file closed: bg_gfx_b.asm
 554  E498                  ; ay_sound.asm vive aqui (bank 4, no-contended). MainLoop entra via thunks
 555  E498                  ; en ay_sound_thunks.asm. ay_sound es self-contained: cero CALL/JP a
 556  E498                  ; rutinas externas, asi que NO hay cross-bank surface dentro del impl.
 557  E498                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ E498              ; ==============================================================================
   2+ E498              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E498              ; ==============================================================================
   4+ E498              ; Puertos:
   5+ E498              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E498              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E498              ;
   8+ E498              ; Registros AY:
   9+ E498              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E498              ;   R2/R3: tono canal B
  11+ E498              ;   R4/R5: tono canal C
  12+ E498              ;   R6:    period del ruido (5 bits)
  13+ E498              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E498              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E498              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E498              ;   R9:    volumen B
  17+ E498              ;   R10:   volumen C
  18+ E498              ;   R11/R12: period del envelope
  19+ E498              ;   R13:   forma del envelope (0-15)
  20+ E498              ; ==============================================================================
  21+ E498
  22+ E498              ; ==============================================================================
  23+ E498              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E498              ; ==============================================================================
  25+ E498              ; Entrada: A = registro (0-13), E = valor
  26+ E498              ; Destruye: BC, A
  27+ E498              ; ==============================================================================
  28+ E498              AY_WriteReg:
  29+ E498 01 FD FF         LD BC, $FFFD
  30+ E49B ED 79            OUT (C), A                  ; seleccionar registro
  31+ E49D 01 FD BF         LD BC, $BFFD
  32+ E4A0 ED 59            OUT (C), E                  ; escribir valor
  33+ E4A2 C9               RET
  34+ E4A3
  35+ E4A3              ; ==============================================================================
  36+ E4A3              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E4A3              ; ==============================================================================
  38+ E4A3              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E4A3              ; ==============================================================================
  40+ E4A3              AY_StopImpl:
  41+ E4A3 3E 08            LD A, 8
  42+ E4A5 1E 00            LD E, 0
  43+ E4A7 CD 98 E4         CALL AY_WriteReg
  44+ E4AA 3E 09            LD A, 9
  45+ E4AC 1E 00            LD E, 0
  46+ E4AE CD 98 E4         CALL AY_WriteReg
  47+ E4B1 3E 0A            LD A, 10
  48+ E4B3 1E 00            LD E, 0
  49+ E4B5 CD 98 E4         CALL AY_WriteReg
  50+ E4B8 C9               RET
  51+ E4B9
  52+ E4B9
  53+ E4B9              ; ==============================================================================
  54+ E4B9              ; AY_Init - Silencia todos los canales (volumen 0). Mixer = $38 (todos los
  55+ E4B9              ; tonos enable, ruidos off). El silencio se gestiona via volumen por canal:
  56+ E4B9              ; bell, music poly y SFX comparten el chip sin clobbear el mixer entre ellos.
  57+ E4B9              ; ==============================================================================
  58+ E4B9              AY_InitImpl:
  59+ E4B9 3E 07            LD A, 7                     ; mixer
  60+ E4BB 1E 38            LD E, $38                   ; tonos ABC on, ruidos off; muting via vol
  61+ E4BD CD 98 E4         CALL AY_WriteReg
  62+ E4C0 3E 08            LD A, 8                     ; volumen A
  63+ E4C2 1E 00            LD E, 0
  64+ E4C4 CD 98 E4         CALL AY_WriteReg
  65+ E4C7 3E 09            LD A, 9                     ; volumen B
  66+ E4C9 1E 00            LD E, 0
  67+ E4CB CD 98 E4         CALL AY_WriteReg
  68+ E4CE 3E 0A            LD A, 10                    ; volumen C
  69+ E4D0 1E 00            LD E, 0
  70+ E4D2 CD 98 E4         CALL AY_WriteReg
  71+ E4D5 C9               RET
  72+ E4D6
  73+ E4D6              ; ==============================================================================
  74+ E4D6              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  75+ E4D6              ; ==============================================================================
  76+ E4D6              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  77+ E4D6              ; el AY toca solo durante el decay.
  78+ E4D6              ; ==============================================================================
  79+ E4D6              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  80+ E4D6              ; ==============================================================================
  81+ E4D6              ; ==============================================================================
  82+ E4D6              ; Variables del decay manual de la campana — MOVIDAS a music_irq.asm (slot 1)
  83+ E4D6              ; para que el handler IRQ las pueda leer/escribir sin paginar slot 3 (regla
  84+ E4D6              ; project_irq_slot3_atomic). El tick del decay vive ahora en BellTickIrq
  85+ E4D6              ; (slot 1) y se llama desde MusicIrqHandler cada 25 Hz. Sin esto, durante
  86+ E4D6              ; DrawScreen / transiciones (varios frames sin MainLoop) el bell decay no
  87+ E4D6              ; se actualizaba -> "campanada se alarga / se apaga raro".
  88+ E4D6              ;
  89+ E4D6              ; AY_PlayBellChimeImpl (bank 4) sigue escribiendo a las vars sin cambios:
  90+ E4D6              ; slot 1 always-vis desde bank 4.
  91+ E4D6              ;
  92+ E4D6              ; Symbols importados desde music_irq.asm: BellVolL, BellVolC, BellVolR,
  93+ E4D6              ; BellDecayTimer, BELL_DECAY_RATE.
  94+ E4D6
  95+ E4D6              ; ==============================================================================
  96+ E4D6              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  97+ E4D6              ; ==============================================================================
  98+ E4D6              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  99+ E4D6              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
 100+ E4D6              ; ==============================================================================
 101+ E4D6              AY_PlayBellChimeImpl:
 102+ E4D6                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 103+ E4D6                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 104+ E4D6                  ; editor — el sonido espacial debe centrarse en la plaza real).
 105+ E4D6 3A 0B 83         LD A, (CurrentScreenX)
 106+ E4D9 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 107+ E4DB 57               LD D, A                     ; D = dx signed (player - plaza)
 108+ E4DC 30 02            JR NC, .absDxOk
 109+ E4DE ED 44            NEG
 110+ E4E0              .absDxOk:
 111+ E4E0 47               LD B, A                     ; B = |dx|
 112+ E4E1
 113+ E4E1 3A 0C 83         LD A, (CurrentScreenY)
 114+ E4E4 D6 09            SUB PLAZA_SCREEN_Y
 115+ E4E6 30 02            JR NC, .absDyOk
 116+ E4E8 ED 44            NEG
 117+ E4EA              .absDyOk:
 118+ E4EA 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 119+ E4EB
 120+ E4EB                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 121+ E4EB                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente)
 122+ E4EB                  ;   dist 3..5  -> dom=13, far=10  (medio: direccional pero audible)
 123+ E4EB                  ;   dist 6+    -> dom=11, far= 8  (lejos: direccional, MIN audible)
 124+ E4EB                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 125+ E4EB 06 0B            LD B, 11                    ; default tramo lejano: dom
 126+ E4ED 0E 08            LD C, 8                     ;                       far (subido +3 desde 5)
 127+ E4EF FE 06            CP 6
 128+ E4F1 30 0C            JR NC, .volTotalSet
 129+ E4F3 06 0D            LD B, 13                    ; tramo medio (subido +1 desde 12)
 130+ E4F5 0E 0A            LD C, 10                    ;             (subido +2 desde 8)
 131+ E4F7 FE 03            CP 3
 132+ E4F9 30 04            JR NC, .volTotalSet
 133+ E4FB 06 0F            LD B, 15                    ; tramo cercano (sin cambios)
 134+ E4FD 0E 0C            LD C, 12
 135+ E4FF              .volTotalSet:                   ; B = dom_vol, C = far_vol
 136+ E4FF
 137+ E4FF                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 138+ E4FF                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 139+ E4FF                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 140+ E4FF                  ; D == 0 → alineado X → solo canal B (centro)
 141+ E4FF 7A               LD A, D
 142+ E500 B7               OR A
 143+ E501 28 21            JR Z, .panCenter
 144+ E503 F2 15 E5         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 145+ E506                  ; D < 0: plaza al este → canal C dominante
 146+ E506              .panRight:
 147+ E506 79               LD A, C
 148+ E507 32 84 7F         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 149+ E50A 78               LD A, B
 150+ E50B 32 86 7F         LD (BellVolR), A            ; canal C = dom
 151+ E50E CB 3F            SRL A
 152+ E510 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 153+ E513 18 1A            JR .panDone
 154+ E515
 155+ E515              .panLeft:
 156+ E515                  ; D > 0: plaza al oeste → canal A dominante
 157+ E515 78               LD A, B
 158+ E516 32 84 7F         LD (BellVolL), A            ; canal A = dom
 159+ E519 CB 3F            SRL A
 160+ E51B 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 161+ E51E 79               LD A, C
 162+ E51F 32 86 7F         LD (BellVolR), A            ; canal C = far
 163+ E522 18 0B            JR .panDone
