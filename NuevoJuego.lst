4726+ B8D4              .spPlayerOk:
4727+ B8D4                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4728+ B8D4                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4729+ B8D4 DD E5            PUSH IX
4730+ B8D6 E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4731+ B8D7 FD 21 0B 82      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4732+ B8DB 06 04            LD B, NUM_NASTIES
