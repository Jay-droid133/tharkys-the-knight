1499+ F6E7              ; ==============================================================================
1500+ F6E7              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1501+ F6E7              ; ==============================================================================
1502+ F6E7              ; Indice (CompassSprites[idx]):
1503+ F6E7              ;   0 = NW    1 = N    2 = NE
1504+ F6E7              ;   3 = W     4 = X    5 = E
1505+ F6E7              ;   6 = SW    7 = S    8 = SE
1506+ F6E7              ; ==============================================================================
1507+ F6E7              CompassSprites:
1508+ F6E7 06 F8            DEFW Sprite_Compass_NW
1509+ F6E9 26 F7            DEFW Sprite_Compass_N
1510+ F6EB 46 F7            DEFW Sprite_Compass_NE
