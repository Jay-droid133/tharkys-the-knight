 672+ F388                  ; --- Cachear estado ---
 673+ F388                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 674+ F388                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 675+ F388                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 676+ F388                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 677+ F388                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 678+ F388                  ; el wobble y la comparacion sigue siendo correcta.
 679+ F388 3A BD 82         LD A, (CompassWobbleCounter)
 680+ F38B B7               OR A
 681+ F38C 20 06            JR NZ, .dcSkipPrevDistSave
 682+ F38E 3A A2 F3         LD A, (.dcDistance)
 683+ F391 32 BA 82         LD (PreviousObjectiveDistance), A
 684+ F394              .dcSkipPrevDistSave:
 685+ F394 3A 08 83         LD A, (CurrentScreenX)
 686+ F397 32 BB 82         LD (LastCompassScreenX), A
 687+ F39A 3A 09 83         LD A, (CurrentScreenY)
 688+ F39D 32 BC 82         LD (LastCompassScreenY), A
 689+ F3A0 C9               RET
 690+ F3A1
 691+ F3A1 00           .dcSpriteIdx: DEFB 0
 692+ F3A2 00           .dcDistance:  DEFB 0
 693+ F3A3 00           .dcAttr:      DEFB 0
 694+ F3A4
 695+ F3A4              ; ==============================================================================
 696+ F3A4              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 697+ F3A4              ; ==============================================================================
 698+ F3A4              ; IN: DE = ptr a 16 filas x 2 bytes
 699+ F3A4              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 700+ F3A4              ; Destruye: AF, B, HL.
 701+ F3A4              ; ==============================================================================
 702+ F3A4              DrawCompassSprite:
 703+ F3A4                  ; Char row 0 (rows 0-7 del sprite)
 704+ F3A4 26 40            LD H, $40
 705+ F3A6 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 706+ F3A8 06 08            LD B, 8
 707+ F3AA              .dcsRow0:
 708+ F3AA 1A               LD A, (DE)
 709+ F3AB 77               LD (HL), A
 710+ F3AC 13               INC DE
 711+ F3AD 23               INC HL
 712+ F3AE 1A               LD A, (DE)
 713+ F3AF 77               LD (HL), A
 714+ F3B0 13               INC DE
 715+ F3B1 2B               DEC HL
 716+ F3B2 24               INC H
 717+ F3B3 10 F5            DJNZ .dcsRow0
 718+ F3B5                  ; Char row 1 (rows 8-15 del sprite)
 719+ F3B5 26 40            LD H, $40
 720+ F3B7 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 721+ F3B9 06 08            LD B, 8
 722+ F3BB              .dcsRow1:
 723+ F3BB 1A               LD A, (DE)
 724+ F3BC 77               LD (HL), A
 725+ F3BD 13               INC DE
 726+ F3BE 23               INC HL
 727+ F3BF 1A               LD A, (DE)
 728+ F3C0 77               LD (HL), A
 729+ F3C1 13               INC DE
 730+ F3C2 2B               DEC HL
 731+ F3C3 24               INC H
 732+ F3C4 10 F5            DJNZ .dcsRow1
 733+ F3C6 C9               RET
 734+ F3C7
 735+ F3C7              ; ==============================================================================
 736+ F3C7              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 737+ F3C7              ; ==============================================================================
 738+ F3C7              SetCompassAttrs:
 739+ F3C7 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 740+ F3CA 77               LD (HL), A
 741+ F3CB 23               INC HL
 742+ F3CC 77               LD (HL), A
 743+ F3CD 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 744+ F3D0 77               LD (HL), A
 745+ F3D1 23               INC HL
 746+ F3D2 77               LD (HL), A
 747+ F3D3 C9               RET
 748+ F3D4
 749+ F3D4              ; ==============================================================================
 750+ F3D4              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 751+ F3D4              ; ==============================================================================
 752+ F3D4              ClearCompass:
 753+ F3D4 26 40            LD H, $40
 754+ F3D6 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 755+ F3D8 06 08            LD B, 8
 756+ F3DA AF               XOR A
 757+ F3DB              .ccRow0:
 758+ F3DB 77               LD (HL), A
 759+ F3DC 23               INC HL
 760+ F3DD 77               LD (HL), A
 761+ F3DE 2B               DEC HL
 762+ F3DF 24               INC H
 763+ F3E0 10 F9            DJNZ .ccRow0
 764+ F3E2 26 40            LD H, $40
 765+ F3E4 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 766+ F3E6 06 08            LD B, 8
 767+ F3E8 AF               XOR A
 768+ F3E9              .ccRow1:
 769+ F3E9 77               LD (HL), A
 770+ F3EA 23               INC HL
 771+ F3EB 77               LD (HL), A
 772+ F3EC 2B               DEC HL
 773+ F3ED 24               INC H
 774+ F3EE 10 F9            DJNZ .ccRow1
 775+ F3F0 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 776+ F3F1 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 777+ F3F4 77               LD (HL), A
 778+ F3F5 23               INC HL
 779+ F3F6 77               LD (HL), A
 780+ F3F7 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 781+ F3FA 77               LD (HL), A
 782+ F3FB 23               INC HL
 783+ F3FC 77               LD (HL), A
 784+ F3FD C9               RET
 785+ F3FE
 786+ F3FE              ; ==============================================================================
 787+ F3FE              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 788+ F3FE              ; ==============================================================================
 789+ F3FE              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 790+ F3FE              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 791+ F3FE              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 792+ F3FE              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 793+ F3FE              ; monstruo cae alli con la puerta abierta:
 794+ F3FE              ;   - Bit slot en MonsterTrappedFlags
 795+ F3FE              ;   - Despawn del monstruo (puff)
 796+ F3FE              ;   - Puerta se re-cierra (sprite + flag)
 797+ F3FE              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 798+ F3FE              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 799+ F3FE              ;
 800+ F3FE              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 801+ F3FE              ; auto-generadas por el level editor segun la posicion de la puerta y los
 802+ F3FE              ; markers AltKey1/AltKey2.
 803+ F3FE              ; ==============================================================================
 804+ F3FE
 805+ F3FE              ; ==============================================================================
 806+ F3FE              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 807+ F3FE              ; ==============================================================================
 808+ F3FE              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 809+ F3FE              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 810+ F3FE              ; Destruye: AF, BC.
 811+ F3FE              ; ==============================================================================
 812+ F3FE              CheckChurchTrap:
 813+ F3FE                  ; --- Solo en pantalla de la iglesia ---
 814+ F3FE 3A 08 83         LD A, (CurrentScreenX)
 815+ F401 FE 0F            CP CHURCH_TRAP_SCREEN_X
 816+ F403 20 5D            JR NZ, .cctNoTrap
 817+ F405 3A 09 83         LD A, (CurrentScreenY)
 818+ F408 FE 06            CP CHURCH_TRAP_SCREEN_Y
 819+ F40A 20 56            JR NZ, .cctNoTrap
 820+ F40C                  ; --- Solo con la puerta abierta ---
 821+ F40C 3A B1 82         LD A, (ChurchDoorOpen)
 822+ F40F B7               OR A
 823+ F410 28 50            JR Z, .cctNoTrap
 824+ F412                  ; --- Solo si el knockback es DIRECTO del player ---
 825+ F412                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 826+ F412                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 827+ F412                  ; espada y se clear cuando se hereda kb por colision.
 828+ F412 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 829+ F416 28 4A            JR Z, .cctNoTrap
 830+ F418                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 831+ F418                  ; (acepta sprites de 16, 21 o 24 px de alto)
 832+ F418 DD 7E 04         LD A, (IX+ENT_POSY)
 833+ F41B CB 3F            SRL A
 834+ F41D CB 3F            SRL A
 835+ F41F CB 3F            SRL A                                   ; A = top charY del monster
 836+ F421 47               LD B, A
 837+ F422 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 838+ F424 90               SUB B                                   ; A = trap_charY - mon_charY
 839+ F425 FE 03            CP 3
 840+ F427 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 841+ F429                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 842+ F429 DD 7E 03         LD A, (IX+ENT_POSX)
 843+ F42C CB 3F            SRL A
 844+ F42E CB 3F            SRL A
 845+ F430 CB 3F            SRL A
 846+ F432 47               LD B, A                                 ; B = left charX del monster
 847+ F433 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 848+ F435 3C               INC A                                   ; A = LO_X + 1
 849+ F436 90               SUB B                                   ; A = LO_X+1 - charX
 850+ F437 FE 03            CP 3
 851+ F439 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 852+ F43B                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 853+ F43B                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 854+ F43B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 855+ F43E D6 4C            SUB SPRID_MONSTER_0
 856+ F440 CB 3F            SRL A
 857+ F442 CB 3F            SRL A
 858+ F444 CB 3F            SRL A                                   ; A = type idx 0..2
 859+ F446 47               LD B, A
 860+ F447                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 861+ F447 3A BF 82         LD A, (NextChurchTrapStep)
 862+ F44A FE 03            CP 3
 863+ F44C 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 864+ F44E 21 64 F4         LD HL, ChurchTrapOrderTable
 865+ F451 5F               LD E, A
 866+ F452 16 00            LD D, 0
 867+ F454 19               ADD HL, DE
 868+ F455 7E               LD A, (HL)                              ; A = type esperado
 869+ F456 B8               CP B
 870+ F457 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 871+ F459                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 872+ F459 CD FC F4         CALL TriggerChurchTrap
 873+ F45C 3E 01            LD A, 1
 874+ F45E C9               RET
 875+ F45F              .cctBlockAsWall:
 876+ F45F                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 877+ F45F                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 878+ F45F 3E 02            LD A, 2
 879+ F461 C9               RET
 880+ F462              .cctNoTrap:
 881+ F462 AF               XOR A
 882+ F463 C9               RET
 883+ F464
 884+ F464              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 885+ F464              ChurchTrapOrderTable:
 886+ F464 00 02 01         DEFB 0, 2, 1
 887+ F467
 888+ F467              ; ==============================================================================
 889+ F467              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 890+ F467              ; blanco brillante sobre paper negro ($47).
 891+ F467              ; ==============================================================================
 892+ F467              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 893+ F467              ; - No-op fuera de la sala de la iglesia.
 894+ F467              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 895+ F467              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 896+ F467              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 897+ F467              ;   aun no toca) conservan sus attrs originales del sprite.
 898+ F467              ; Destruye: AF, BC, DE, HL.
 899+ F467              ; ==============================================================================
 900+ F467              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 901+ F467              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 902+ F467              HighlightExpectedStatue:
 903+ F467 3E 47            LD A, $47
 904+ F469 18 00            JR PaintExpectedStatueAttr
 905+ F46B
 906+ F46B              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 907+ F46B              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 908+ F46B              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 909+ F46B              PaintExpectedStatueAttr:
 910+ F46B 32 D5 F4         LD (.hesAttr), A
 911+ F46E                  ; --- Solo en la sala de la iglesia ---
 912+ F46E 3A 08 83         LD A, (CurrentScreenX)
 913+ F471 FE 0F            CP CHURCH_TRAP_SCREEN_X
 914+ F473 C0               RET NZ
 915+ F474 3A 09 83         LD A, (CurrentScreenY)
 916+ F477 FE 06            CP CHURCH_TRAP_SCREEN_Y
 917+ F479 C0               RET NZ
 918+ F47A                  ; --- Solo tras abrir la iglesia 1a vez ---
 919+ F47A                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 920+ F47A                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 921+ F47A                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 922+ F47A                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 923+ F47A                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 924+ F47A 3A B2 82         LD A, (ChurchEverOpened)
 925+ F47D B7               OR A
 926+ F47E C8               RET Z
 927+ F47F                  ; --- Solo si quedan monstruos por atrapar ---
 928+ F47F 3A BF 82         LD A, (NextChurchTrapStep)
 929+ F482 FE 03            CP 3
 930+ F484 D0               RET NC
 931+ F485                  ; --- Type esperado -> statue id ---
 932+ F485 21 64 F4         LD HL, ChurchTrapOrderTable
 933+ F488 5F               LD E, A
 934+ F489 16 00            LD D, 0
 935+ F48B 19               ADD HL, DE
 936+ F48C 7E               LD A, (HL)                              ; type idx esperado
 937+ F48D 21 A9 67         LD HL, StatueIdTable
 938+ F490 5F               LD E, A
 939+ F491 16 00            LD D, 0
 940+ F493 19               ADD HL, DE
 941+ F494 7E               LD A, (HL)                              ; A = statue id
 942+ F495 B7               OR A
 943+ F496 C8               RET Z
 944+ F497 32 D6 F4         LD (.hesTargetId), A
 945+ F49A                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 946+ F49A 2A 0A 83         LD HL, (CurrentScreenAddr)
 947+ F49D              .hesLoop:
 948+ F49D 7E               LD A, (HL)
 949+ F49E FE FF            CP $FF
 950+ F4A0 C8               RET Z                                   ; estatua no en esta sala
 951+ F4A1 47               LD B, A
 952+ F4A2 3A D6 F4         LD A, (.hesTargetId)
 953+ F4A5 B8               CP B
 954+ F4A6 28 06            JR Z, .hesFound
 955+ F4A8 11 04 00         LD DE, 4
 956+ F4AB 19               ADD HL, DE
 957+ F4AC 18 EF            JR .hesLoop
 958+ F4AE              .hesFound:
 959+ F4AE 23               INC HL
 960+ F4AF 7E               LD A, (HL)                              ; charX
 961+ F4B0 47               LD B, A
 962+ F4B1 23               INC HL
 963+ F4B2 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 964+ F4B3 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 965+ F4B5 4F               LD C, A                                 ; C = charY (post-HUD)
 966+ F4B6                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 967+ F4B6 26 00            LD H, 0
 968+ F4B8 69               LD L, C
 969+ F4B9 29               ADD HL, HL
 970+ F4BA 29               ADD HL, HL
 971+ F4BB 29               ADD HL, HL
 972+ F4BC 29               ADD HL, HL
 973+ F4BD 29               ADD HL, HL                              ; HL = charY * 32
 974+ F4BE 58               LD E, B
 975+ F4BF 16 00            LD D, 0
 976+ F4C1 19               ADD HL, DE                              ; + charX
 977+ F4C2 11 00 58         LD DE, $5800
 978+ F4C5 19               ADD HL, DE                              ; HL = attr addr top-left
 979+ F4C6                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 980+ F4C6                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 981+ F4C6                  ; no hace falta sincronizar CleanAttrMap.
 982+ F4C6 3A D5 F4         LD A, (.hesAttr)
 983+ F4C9 06 03            LD B, 3                                 ; 3 filas de chars
 984+ F4CB              .hesRow:
 985+ F4CB 77               LD (HL), A
 986+ F4CC 23               INC HL
 987+ F4CD 77               LD (HL), A                              ; (charX+1)
 988+ F4CE 11 1F 00         LD DE, 31
 989+ F4D1 19               ADD HL, DE                              ; siguiente fila col 0
 990+ F4D2 10 F7            DJNZ .hesRow
 991+ F4D4 C9               RET
 992+ F4D5 00           .hesAttr:     DEFB 0
 993+ F4D6 00           .hesTargetId: DEFB 0
 994+ F4D7
 995+ F4D7              ; ==============================================================================
 996+ F4D7              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 997+ F4D7              ; ==============================================================================
 998+ F4D7              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 999+ F4D7              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1000+ F4D7              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1001+ F4D7              ; + ON final settle): 8 ciclos de ON-OFF en total.
1002+ F4D7              ; ==============================================================================
1003+ F4D7              STATUE_BLINK_FRAMES   EQU 32
1004+ F4D7
1005+ F4D7              StartStatueBlink:
1006+ F4D7                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1007+ F4D7                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1008+ F4D7                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1009+ F4D7                  ; (caso A), .cbtActChurchDoor (caso B).
1010+ F4D7 3E 20            LD A, STATUE_BLINK_FRAMES
1011+ F4D9 32 C0 82         LD (StatueBlinkCounter), A
1012+ F4DC C3 67 F4         JP HighlightExpectedStatue              ; initial ON paint
1013+ F4DF
1014+ F4DF              UpdateStatueBlink:
1015+ F4DF                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1016+ F4DF 3A C0 82         LD A, (StatueBlinkCounter)
1017+ F4E2 B7               OR A
1018+ F4E3 C8               RET Z
1019+ F4E4 3D               DEC A
1020+ F4E5 32 C0 82         LD (StatueBlinkCounter), A
1021+ F4E8 20 03            JR NZ, .usbInProgress
1022+ F4EA                  ; Counter recien llego a 0: settle ON
1023+ F4EA C3 67 F4         JP HighlightExpectedStatue
1024+ F4ED              .usbInProgress:
1025+ F4ED                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1026+ F4ED                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1027+ F4ED CB 3F            SRL A
1028+ F4EF E6 01            AND $01
1029+ F4F1 28 05            JR Z, .usbOff
1030+ F4F3 3E 47            LD A, $47
1031+ F4F5 C3 6B F4         JP PaintExpectedStatueAttr
1032+ F4F8              .usbOff:
1033+ F4F8 AF               XOR A
1034+ F4F9 C3 6B F4         JP PaintExpectedStatueAttr
1035+ F4FC
1036+ F4FC              ; ==============================================================================
1037+ F4FC              ; CUTSCENE - parametros ajustables
1038+ F4FC              ; ==============================================================================
1039+ F4FC              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1040+ F4FC              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1041+ F4FC              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1042+ F4FC              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1043+ F4FC
1044+ F4FC              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1045+ F4FC              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1046+ F4FC              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1047+ F4FC
1048+ F4FC              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1049+ F4FC              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1050+ F4FC              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1051+ F4FC              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1052+ F4FC              ;   tick 12 -> erase smoke[2], pasar a DONE
1053+ F4FC              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1054+ F4FC              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1055+ F4FC
1056+ F4FC              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1057+ F4FC              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1058+ F4FC              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1059+ F4FC              ; centrado dentro del vano de la puerta.
1060+ F4FC              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1061+ F4FC              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1062+ F4FC              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1063+ F4FC              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1064+ F4FC
1065+ F4FC              ; ==============================================================================
1066+ F4FC              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1067+ F4FC              ; ==============================================================================
1068+ F4FC              ; IN: IX = monster atrapado.
1069+ F4FC              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1070+ F4FC              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1071+ F4FC              ; en ApplyChurchTrapEffects al final del cutscene.
1072+ F4FC              ; ==============================================================================
1073+ F4FC              TriggerChurchTrap:
1074+ F4FC                  ; --- 1. Calcular slot 0..2 ---
1075+ F4FC DD E5            PUSH IX
1076+ F4FE E1               POP HL
1077+ F4FF 11 AB 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1078+ F502 B7               OR A
1079+ F503 ED 52            SBC HL, DE
1080+ F505 CB 3D            SRL L
