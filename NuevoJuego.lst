 121  9171                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9171              ; ==============================================================================
   2+ 9171              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9171              ; ==============================================================================
   4+ 9171              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9171              ; - Game loop per-entity: erase → update → draw
   6+ 9171              ; - Movimiento 8-bit (sin subpixel)
   7+ 9171              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9171              ; - XOR draw/erase (una sola rutina)
   9+ 9171              ; ==============================================================================
  10+ 9171
  11+ 9171              ; ==============================================================================
  12+ 9171              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9171              ; ==============================================================================
  14+ 9171              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9171              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9171              ; ==============================================================================
  17+ 9171              ReadInput:
  18+ 9171 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9173 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9175
  21+ 9175                  ; -- 1. QAOP --
  22+ 9175 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9178 ED 78            IN A, (C)
  24+ 917A CB 47            BIT 0, A            ; Q = Arriba
  25+ 917C 20 02            JR NZ, .no_q
  26+ 917E CB C2            SET 0, D
  27+ 9180              .no_q:
  28+ 9180 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9183 ED 78            IN A, (C)
  30+ 9185 CB 47            BIT 0, A            ; A = Abajo
  31+ 9187 20 02            JR NZ, .no_a
  32+ 9189 CB CA            SET 1, D
  33+ 918B              .no_a:
  34+ 918B 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 918E ED 78            IN A, (C)
  36+ 9190 CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9192 20 02            JR NZ, .no_o
  38+ 9194 CB DA            SET 3, D
  39+ 9196              .no_o:
  40+ 9196 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9198 20 02            JR NZ, .no_p
  42+ 919A CB D2            SET 2, D
  43+ 919C              .no_p:
  44+ 919C
  45+ 919C                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 919C                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 919C DB 1F            IN A, (31)
  48+ 919E 4F               LD C, A             ; guardar para fire
  49+ 919F CB 5F            BIT 3, A            ; Up
  50+ 91A1 28 02            JR Z, .no_k_up
  51+ 91A3 CB C2            SET 0, D
  52+ 91A5              .no_k_up:
  53+ 91A5 CB 57            BIT 2, A            ; Down
  54+ 91A7 28 02            JR Z, .no_k_down
  55+ 91A9 CB CA            SET 1, D
  56+ 91AB              .no_k_down:
  57+ 91AB CB 4F            BIT 1, A            ; Left
  58+ 91AD 28 02            JR Z, .no_k_left
  59+ 91AF CB DA            SET 3, D
  60+ 91B1              .no_k_left:
  61+ 91B1 CB 47            BIT 0, A            ; Right
  62+ 91B3 28 02            JR Z, .no_k_right
  63+ 91B5 CB D2            SET 2, D
  64+ 91B7              .no_k_right:
  65+ 91B7 CB 61            BIT 4, C            ; Kempston Fire
  66+ 91B9 28 02            JR Z, .no_k_fire
  67+ 91BB CB C3            SET 0, E
  68+ 91BD              .no_k_fire:
  69+ 91BD
  70+ 91BD                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 91BD                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 91BD 01 FE F7         LD BC, $F7FE
  73+ 91C0 ED 78            IN A, (C)
  74+ 91C2 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 91C4 20 02            JR NZ, .no_s1_up
  76+ 91C6 CB C2            SET 0, D
  77+ 91C8              .no_s1_up:
  78+ 91C8 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 91CA 20 02            JR NZ, .no_s1_down
  80+ 91CC CB CA            SET 1, D
  81+ 91CE              .no_s1_down:
  82+ 91CE CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 91D0 20 02            JR NZ, .no_s1_left
  84+ 91D2 CB DA            SET 3, D
  85+ 91D4              .no_s1_left:
  86+ 91D4 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 91D6 20 02            JR NZ, .no_s1_right
  88+ 91D8 CB D2            SET 2, D
  89+ 91DA              .no_s1_right:
  90+ 91DA CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 91DC 20 02            JR NZ, .no_s1_fire
  92+ 91DE CB C3            SET 0, E
  93+ 91E0              .no_s1_fire:
  94+ 91E0
  95+ 91E0                  ; -- 4. SPACE = Fire (teclado) --
  96+ 91E0 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 91E3 ED 78            IN A, (C)
  98+ 91E5 CB 47            BIT 0, A            ; SPACE
  99+ 91E7 20 02            JR NZ, .no_space
 100+ 91E9 CB C3            SET 0, E
 101+ 91EB              .no_space:
 102+ 91EB
 103+ 91EB                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 91EB 7B               LD A, E
 105+ 91EC 32 AF 81         LD (InputFire), A
 106+ 91EF
 107+ 91EF                  ; -- 6. Cancelar opuestos --
 108+ 91EF 7A               LD A, D
 109+ 91F0 47               LD B, A
 110+ 91F1 E6 03            AND DIR_N | DIR_S
 111+ 91F3 FE 03            CP DIR_N | DIR_S
 112+ 91F5 20 04            JR NZ, .noVC
 113+ 91F7 78               LD A, B
 114+ 91F8 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ 91FA 47               LD B, A
 116+ 91FB              .noVC:
 117+ 91FB 78               LD A, B
 118+ 91FC E6 0C            AND DIR_E | DIR_W
 119+ 91FE FE 0C            CP DIR_E | DIR_W
 120+ 9200 20 04            JR NZ, .noHC
 121+ 9202 78               LD A, B
 122+ 9203 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ 9205 47               LD B, A
 124+ 9206              .noHC:
 125+ 9206 78               LD A, B
 126+ 9207 32 AE 81         LD (InputDirection), A
 127+ 920A C9               RET
