 156+ F1AA              SFX_PlayerHit:
 157+ F1AA 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 158+ F1AE 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 159+ F1B2 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 160+ F1B6 00               DEFB 0                      ; fin
 161+ F1B7
 162+ F1B7              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
