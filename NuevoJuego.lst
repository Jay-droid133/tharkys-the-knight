 284+ 6ED8                  ; --- Calcular pk_left, pk_top, pk_width_px, pk_height_px ---
 285+ 6ED8 21 87 89         LD HL, BgSpriteBuffer
 286+ 6EDB 7E               LD A, (HL)                          ; height_px
 287+ 6EDC 32 25 6F         LD (.crsPkH+1), A
 288+ 6EDF 23               INC HL
 289+ 6EE0 7E               LD A, (HL)
 290+ 6EE1 E6 7F            AND $7F                             ; width_bytes (sin flag RLE)
 291+ 6EE3 87               ADD A, A
 292+ 6EE4 87               ADD A, A
 293+ 6EE5 87               ADD A, A                            ; width_px = bytes*8
 294+ 6EE6 32 0D 6F         LD (.crsPkW+1), A
 295+ 6EE9 3A B8 5F         LD A, (RandomSynthCharX)
 296+ 6EEC 87               ADD A, A
 297+ 6EED 87               ADD A, A
 298+ 6EEE 87               ADD A, A                            ; pk_left = charX*8
 299+ 6EEF 32 08 6F         LD (.crsPkLeft+1), A
 300+ 6EF2 3A B9 5F         LD A, (RandomSynthCharY)
 301+ 6EF5 C6 02            ADD A, BG_Y_OFFSET
 302+ 6EF7 87               ADD A, A
 303+ 6EF8 87               ADD A, A
 304+ 6EF9 87               ADD A, A                            ; pk_top = (charY+BG_Y_OFFSET)*8
 305+ 6EFA 32 20 6F         LD (.crsPkTop+1), A
 306+ 6EFD
 307+ 6EFD                  ; --- AABB: player_right > pk_left AND player_left < pk_right
 308+ 6EFD                  ;          AND player_bottom > pk_top AND player_top < pk_bottom ---
 309+ 6EFD 3A 42 81         LD A, (EntityTable + ENT_POSX)
 310+ 6F00 32 04 6F         LD (.crsPlX+1), A
 311+ 6F03              .crsPlX:
 312+ 6F03 3E 00            LD A, 0                             ; player_left (self-mod)
 313+ 6F05 C6 10            ADD A, 16                           ; player_right
 314+ 6F07              .crsPkLeft:
 315+ 6F07 06 00            LD B, 0
 316+ 6F09 B8               CP B
 317+ 6F0A D8               RET C                               ; player_right <= pk_left -> miss
 318+ 6F0B C8               RET Z
 319+ 6F0C              .crsPkW:
 320+ 6F0C 3E 00            LD A, 0                             ; pk_width
 321+ 6F0E 80               ADD A, B                            ; pk_right
 322+ 6F0F 47               LD B, A
 323+ 6F10 3A 04 6F         LD A, (.crsPlX+1)
 324+ 6F13 B8               CP B
 325+ 6F14 D0               RET NC                              ; player_left >= pk_right -> miss
 326+ 6F15
 327+ 6F15 3A 43 81         LD A, (EntityTable + ENT_POSY)
 328+ 6F18 32 1C 6F         LD (.crsPlY+1), A
 329+ 6F1B              .crsPlY:
 330+ 6F1B 3E 00            LD A, 0                             ; player_top
 331+ 6F1D C6 15            ADD A, 21                           ; player_bottom (player es 21 alto)
 332+ 6F1F              .crsPkTop:
 333+ 6F1F 06 00            LD B, 0
 334+ 6F21 B8               CP B
 335+ 6F22 D8               RET C
 336+ 6F23 C8               RET Z
 337+ 6F24              .crsPkH:
 338+ 6F24 3E 00            LD A, 0                             ; pk_height
 339+ 6F26 80               ADD A, B                            ; pk_bottom
 340+ 6F27 47               LD B, A
 341+ 6F28 3A 1C 6F         LD A, (.crsPlY+1)
 342+ 6F2B B8               CP B
 343+ 6F2C D0               RET NC                              ; miss
