 747+ E870              .pxLoop:
 748+ E870 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 749+ E871 B7               OR A
 750+ E872 C8               RET Z
 751+ E873
 752+ E873                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 753+ E873 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 754+ E874 23               INC HL
 755+ E875 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 756+ E876 23               INC HL
 757+ E877 56               LD D, (HL)                  ; D = mask
 758+ E878 23               INC HL
 759+ E879 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 760+ E87A
 761+ E87A                  ; --- Calcular scanLine (0-15) ---
 762+ E87A 78               LD A, B
 763+ E87B E6 07            AND $07                     ; scan dentro del char row (0-7)
 764+ E87D CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 765+ E87F 28 02            JR Z, .pxIsTop
 766+ E881 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 767+ E883              .pxIsTop:
 768+ E883                  ; A = scanLine (0-15)
 769+ E883
 770+ E883                  ; --- Calcular colOffset (0 o 1) ---
 771+ E883 5F               LD E, A                     ; E = scanLine (guardar)
 772+ E884 79               LD A, C
 773+ E885 E6 1F            AND $1F                     ; extraer columna
 774+ E887 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 775+ E889 4F               LD C, A                     ; C = colOffset
 776+ E88A
 777+ E88A                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 778+ E88A 7B               LD A, E                     ; A = scanLine
 779+ E88B 87               ADD A, A                    ; *2 (word index)
 780+ E88C 21 6F 90         LD HL, PlazaScanAddrs
 781+ E88F 85               ADD A, L
 782+ E890 6F               LD L, A
 783+ E891 30 01            JR NC, .pxNC
 784+ E893 24               INC H
 785+ E894              .pxNC:
 786+ E894 7E               LD A, (HL)
 787+ E895 23               INC HL
 788+ E896 66               LD H, (HL)
 789+ E897 81               ADD A, C                    ; sumar colOffset
 790+ E898 6F               LD L, A                     ; HL = dir VRAM destino
 791+ E899
 792+ E899                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 793+ E899 7A               LD A, D
 794+ E89A 2F               CPL
 795+ E89B A6               AND (HL)
 796+ E89C 77               LD (HL), A
 797+ E89D
 798+ E89D E1               POP HL                      ; restaurar puntero datos
 799+ E89E 18 D0            JR .pxLoop
