 597  DE4F                  ; --- Bank cutscene body (M9, ~1.7 KB con wrappers) ---
 598  DE4F                  ; Movido aqui desde bank 0 para descongestionar el main code (que estaba
 599  DE4F                  ; a 3 B libres). Los entry points (CheckBankTriggerBg / UpdateBankCutscene)
 600  DE4F                  ; viven como thunks en slot 1 (bank_cutscene_thunks.asm). El body usa
 601  DE4F                  ; _PageBank0 / _PageBank7 (slot 1, always-visible) para envolver cada
 602  DE4F                  ; CALL externo: el body no puede llamar directamente a rutinas bank 0
 603  DE4F                  ; porque slot 3 esta paginado a bank 7 mientras el body ejecuta.
 604  DE4F                  INCLUDE "bank_cutscene.asm"
# file opened: bank_cutscene.asm
   1+ DE4F              ; ==============================================================================
   2+ DE4F              ; bank_cutscene.asm - Cutscene del banco (M9 propuesto)
   3+ DE4F              ; ==============================================================================
   4+ DE4F              ; Placement actual: **bank 7** (PAGE 7, slot 3 cuando paginado).
   5+ DE4F              ;
   6+ DE4F              ; Historia: originalmente en bank 0 default cuando habia ~1.4 KB libres en
   7+ DE4F              ; main code. Tras la presion de slot 1 / bank 0 (ambos al limite) en mayo
   8+ DE4F              ; 2026, movido a bank 7 (que tenia ~8 KB libres). Los 2 entry points
   9+ DE4F              ; (CheckBankTriggerBg / UpdateBankCutscene) viven como thunks en slot 1
  10+ DE4F              ; (bank_cutscene_thunks.asm) que paginan bank 7 antes del body y restauran
  11+ DE4F              ; bank 0 al volver. Cada CALL externo dentro del body usa el patron
  12+ DE4F              ; `CALL _PageBank0 / CALL func / CALL _PageBank7` para que las rutinas
  13+ DE4F              ; bank 0 (DrawBgSpriteXOR, PlaySFX, etc.) y slot 1 que internamente tocan
  14+ DE4F              ; bank 0 (TownGateRedrawPlayer -> RestoreOldAttr) sean visibles durante su
  15+ DE4F              ; ejecucion.
  16+ DE4F              ;
  17+ DE4F              ; Diseno doc: docs/bank_cutscene.md.
  18+ DE4F              ;
  19+ DE4F              ; Disparada al chocar contra la puerta del banco (sprite Bank id 39, en
  20+ DE4F              ; sala (8,8)) llevando el cheque (BankCheck id 44, key id 7).
  21+ DE4F              ;
  22+ DE4F              ; Phase machine indexada por BankCutscenePhase. Cuando != 0, MainLoop salta
  23+ DE4F              ; el bloque normal de gameplay y llama UpdateBankCutscene cada frame.
  24+ DE4F              ;
  25+ DE4F              ; Esquema de fases:
  26+ DE4F              ;   0  IDLE              no en cutscene
  27+ DE4F              ;   1  LOCK              snap player a anchor, facing N, pausa breve
  28+ DE4F              ;   2  KNOCKS_1          3 toques (sub-state HIT/GAP)
  29+ DE4F              ;   3  WAIT_1            espera silenciosa tras grupo 1
  30+ DE4F              ;   4  KNOCKS_2          3 toques mas
  31+ DE4F              ;   5  WAIT_2            espera tras grupo 2
  32+ DE4F              ;   6  TURN_TO_CAM       player gira a S (cara camara)
  33+ DE4F              ;   7  TURN_TO_DOOR      player vuelve a N
  34+ DE4F              ;   8  KNOCKS_3          6 toques
  35+ DE4F              ;   9  WAIT_3            pausa antes de aparecer la mano
  36+ DE4F              ;  10  PRE_HAND          hold corto; la puerta NO se abre (mano sale por la
  37+ DE4F              ;                        rendija de la puerta cerrada)
  38+ DE4F              ;  11  HAND_IN           aparece mano (frame 0) sobre la puerta cerrada
  39+ DE4F              ;  12  HAND_NO_NO        anim swaps frame 0/1, BCS_NO_SWAPS_TOTAL veces
  40+ DE4F              ;  13  HAND_OUT          erase mano
  41+ DE4F              ;  14  KEY_DROP          BankKeySpawned=1 + RedrawPickupByPtr
  42+ DE4F              ;  15  PLAYER_TURN_CAM   player mira a camara un instante
  43+ DE4F              ;  16  DONE              sentinel; setear phase=IDLE devuelve control
  44+ DE4F              ;  17  WAIT_NASTIES      pre-LOCK: nasties + death animan puff antes de LOCK
  45+ DE4F              ;                        (mismo patron que TGP_WAIT_NASTIES de town_gate;
  46+ DE4F              ;                        MainLoop ramifica especial para mantener
  47+ DE4F              ;                        ProcessEnemies + ProcessDeath corriendo).
  48+ DE4F              ;
  49+ DE4F              ; NOTA visual: la mano se dibuja con XOR sobre la puerta cerrada del banco.
  50+ DE4F              ; Hereda los attrs de la facade (no pinta los suyos), asi que XOR self-cancel
  51+ DE4F              ; en HAND_OUT deja la facade intacta. Por eso el draft inline +
  52+ DE4F              ; DrawBgSprite16XorAtPixel es el match exacto: cero gestion de attrs.
  53+ DE4F              ;
  54+ DE4F              ; Patron de cross-bank tras el move a bank 7:
  55+ DE4F              ;   - Body bank 7 ejecuta con bank 7 paginado en slot 3.
  56+ DE4F              ;   - CALLs a slot 1/slot 2/bank 2 (always-visible): sin wrap, directas.
  57+ DE4F              ;   - CALLs a bank 0 o a slot 1 que internamente toca bank 0: wrap con
  58+ DE4F              ;     `CALL _PageBank0 / CALL func / CALL _PageBank7` (helpers en slot 1).
  59+ DE4F              ;   - CALL LoadBgSpriteToBuffer: pagina bank 3 internamente y deja bank 0
  60+ DE4F              ;     paginado al RET. Repaginar bank 7 manualmente tras la llamada.
  61+ DE4F              ; ==============================================================================
  62+ DE4F
  63+ DE4F              ; ==============================================================================
  64+ DE4F              ; Phase enum
  65+ DE4F              ; ==============================================================================
  66+ DE4F              BCP_IDLE                EQU 0
