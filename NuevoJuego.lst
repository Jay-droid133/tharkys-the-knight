2692+ DA8C 23               INC HL
2693+ DA8D 56               LD D, (HL)                  ; DE = BgGfx ptr
2694+ DA8E 23               INC HL                      ; HL en charX
2695+ DA8F 46               LD B, (HL)                  ; charX
2696+ DA90 23               INC HL
2697+ DA91 4E               LD C, (HL)                  ; charY
2698+ DA92 23               INC HL
2699+ DA93 7E               LD A, (HL)                  ; tint variant
