4820+ BD5C              ; --- Tabla de comportamiento depredador ---
4821+ BD5C              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
4822+ BD5C              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
4823+ BD5C              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
4824+ BD5C              PredatorTable:
4825+ BD5C 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
4826+ BD5D 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
4827+ BD5E 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
4828+ BD5F 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
4829+ BD60 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
4830+ BD61 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
4831+ BD62 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
4832+ BD63 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
4833+ BD64
4834+ BD64              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
4835+ BD64              PredatorSpeedTable:
4836+ BD64 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
4837+ BD65 02               DEFB 2                              ; Ciclo 1: lento
4838+ BD66 03               DEFB 3                              ; Ciclo 2: intermedio
4839+ BD67 04               DEFB 4                              ; Ciclo 3+: rapido
4840+ BD68
