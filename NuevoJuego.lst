 460+ F9CA CD C6 F8         CALL BankCutsceneSnapToRetreat
 461+ F9CD 3E 32            LD A, BCS_T_GROUP_WAIT
 462+ F9CF 32 CA 82         LD (BankCutsceneTimer), A
 463+ F9D2 3E 05            LD A, BCP_WAIT_2
 464+ F9D4 32 C9 82         LD (BankCutscenePhase), A
 465+ F9D7 C9               RET
 466+ F9D8
 467+ F9D8              ; ---- Phase 5: WAIT_2 ----
