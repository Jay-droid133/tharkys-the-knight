 202+ 6E9A 32 7C 82         LD (PlayerSpeedFight), A
 203+ 6E9D 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 204+ 6EA0 22 7D 82         LD (SpeedBuffTimer), HL
 205+ 6EA3 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 206+ 6EA5 32 7F 82         LD (SpeedBuffType), A
 207+ 6EA8 3E 45            LD A, SPEED_BUFF_RAYO_ATTR
 208+ 6EAA 32 50 81         LD (EntityTable + ENT_ATTR), A
