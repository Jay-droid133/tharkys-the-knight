 206+ 9141 3A 98 91         LD A, (.lbsWsave)
 207+ 9144 B7               OR A
 208+ 9145 28 08            JR Z, .lbsPixRowDone
 209+ 9147 4F               LD C, A                         ; C = W (inner loop)
 210+ 9148              .lbsPixCol:
 211+ 9148 7E               LD A, (HL)
 212+ 9149 12               LD (DE), A
 213+ 914A 23               INC HL
 214+ 914B 13               INC DE
