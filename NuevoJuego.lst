 261+ E56C CB 23            SLA E
 261+ E56E CB 12          RL D                        ; *4
 262+ E570 CB 23            SLA E
 262+ E572 CB 12          RL D                        ; *8
 263+ E574 E5               PUSH HL
 264+ E575 21 00 3C         LD HL, $3C00
 265+ E578 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E579 EB               EX DE, HL                           ; DE = glyph
 267+ E57A E1               POP HL                              ; HL = VRAM
 268+ E57B 06 08            LD B, 8
 269+ E57D              .drawChar:
 270+ E57D 1A               LD A, (DE)
 271+ E57E 77               LD (HL), A
 272+ E57F 13               INC DE
