 561  E759                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ E759              ; ==============================================================================
   2+ E759              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E759              ; ==============================================================================
   4+ E759              ; Puertos:
   5+ E759              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E759              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E759              ;
   8+ E759              ; Registros AY:
   9+ E759              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E759              ;   R2/R3: tono canal B
  11+ E759              ;   R4/R5: tono canal C
  12+ E759              ;   R6:    period del ruido (5 bits)
  13+ E759              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E759              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E759              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E759              ;   R9:    volumen B
  17+ E759              ;   R10:   volumen C
  18+ E759              ;   R11/R12: period del envelope
  19+ E759              ;   R13:   forma del envelope (0-15)
  20+ E759              ; ==============================================================================
  21+ E759
  22+ E759              ; ==============================================================================
  23+ E759              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E759              ; ==============================================================================
  25+ E759              ; Entrada: A = registro (0-13), E = valor
  26+ E759              ; Destruye: BC, A
  27+ E759              ; ==============================================================================
  28+ E759              AY_WriteReg:
  29+ E759 01 FD FF         LD BC, $FFFD
  30+ E75C ED 79            OUT (C), A                  ; seleccionar registro
  31+ E75E 01 FD BF         LD BC, $BFFD
  32+ E761 ED 59            OUT (C), E                  ; escribir valor
  33+ E763 C9               RET
  34+ E764
  35+ E764              ; ==============================================================================
  36+ E764              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E764              ; ==============================================================================
  38+ E764              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E764              ; ==============================================================================
  40+ E764              AY_StopImpl:
  41+ E764 3E 08            LD A, 8
  42+ E766 1E 00            LD E, 0
  43+ E768 CD 59 E7         CALL AY_WriteReg
  44+ E76B 3E 09            LD A, 9
  45+ E76D 1E 00            LD E, 0
  46+ E76F CD 59 E7         CALL AY_WriteReg
  47+ E772 3E 0A            LD A, 10
  48+ E774 1E 00            LD E, 0
  49+ E776 CD 59 E7         CALL AY_WriteReg
  50+ E779 C9               RET
  51+ E77A
  52+ E77A
  53+ E77A              ; ==============================================================================
  54+ E77A              ; AY_Init - Silencia todos los canales (volumen 0). Mixer = $38 (todos los
  55+ E77A              ; tonos enable, ruidos off). El silencio se gestiona via volumen por canal:
  56+ E77A              ; bell, music poly y SFX comparten el chip sin clobbear el mixer entre ellos.
  57+ E77A              ; ==============================================================================
  58+ E77A              AY_InitImpl:
  59+ E77A 3E 07            LD A, 7                     ; mixer
  60+ E77C 1E 38            LD E, $38                   ; tonos ABC on, ruidos off; muting via vol
  61+ E77E CD 59 E7         CALL AY_WriteReg
  62+ E781 3E 08            LD A, 8                     ; volumen A
  63+ E783 1E 00            LD E, 0
  64+ E785 CD 59 E7         CALL AY_WriteReg
  65+ E788 3E 09            LD A, 9                     ; volumen B
  66+ E78A 1E 00            LD E, 0
  67+ E78C CD 59 E7         CALL AY_WriteReg
  68+ E78F 3E 0A            LD A, 10                    ; volumen C
  69+ E791 1E 00            LD E, 0
  70+ E793 CD 59 E7         CALL AY_WriteReg
  71+ E796 C9               RET
