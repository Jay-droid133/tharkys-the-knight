 230+ A2E7              ; ==============================================================================
 231+ A2E7              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 232+ A2E7              ; ==============================================================================
 233+ A2E7              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 234+ A2E7              ; ==============================================================================
 235+ A2E7              ProcessPlayer:
 236+ A2E7 DD 21 36 81      LD IX, EntityTable
 237+ A2EB
 238+ A2EB                  ; --- Fresh check ---
 239+ A2EB 3A 99 82         LD A, (ScreenJustRedrawn)
 240+ A2EE B7               OR A
 241+ A2EF C2 D1 A3         JP NZ, .plFresh
 242+ A2F2 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 243+ A2F6 C2 D1 A3         JP NZ, .plFresh
 244+ A2F9
 245+ A2F9                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 246+ A2F9                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 247+ A2F9                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 248+ A2F9                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 249+ A2F9                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 250+ A2F9                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 251+ A2F9                  ; y UpdatePlayerAnimation lo sobrescribiria.
 252+ A2F9 3A 6F 82         LD A, (DeathBorderPhase)
 253+ A2FC B7               OR A
 254+ A2FD 20 0A            JR NZ, .plSkipUpdate
 255+ A2FF 3A 73 82         LD A, (PlayerRespawnPhase)
 256+ A302 FE 01            CP 1
 257+ A304 28 03            JR Z, .plSkipUpdate
 258+ A306 CD 32 A9         CALL UpdatePlayer
 259+ A309              .plSkipUpdate:
 260+ A309 CD 4B A8         CALL CalcDrawX
 261+ A30C CD A6 A2         CALL ComputePlayerDrawY
 262+ A30F
 263+ A30F                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 264+ A30F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 265+ A312 DD BE 0C         CP (IX+ENT_OLDX)
 266+ A315 20 47            JR NZ, .plDoErase
 267+ A317 3A 64 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 268+ A31A DD BE 0D         CP (IX+ENT_OLDY)
 269+ A31D 20 3F            JR NZ, .plDoErase
 270+ A31F DD 7E 00         LD A, (IX+ENT_SPRITEID)
 271+ A322 DD BE 0E         CP (IX+ENT_OLDSPRID)
 272+ A325 20 37            JR NZ, .plDoErase
 273+ A327                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 274+ A327 3A 6C C8         LD A, (PlayerHitTimer)
 275+ A32A B7               OR A
 276+ A32B 20 01            JR NZ, .plRepaintAttr
 277+ A32D C9               RET                                 ; Nada cambio → skip todo
 278+ A32E              .plRepaintAttr:
 279+ A32E 3A 64 82         LD A, (PlayerDrawY)
 280+ A331 57               LD D, A
 281+ A332 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 282+ A335 5F               LD E, A
 283+ A336 DD E5            PUSH IX
 284+ A338 CD 90 A8         CALL GetSpriteAddr
 285+ A33B DD 2A BF A8      LD IX, (SpriteAddrTemp)
 286+ A33F CD EB 9E         CALL CalcEntityAttrSize
 287+ A342                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 288+ A342 3A BD 9F         LD A, (EntityAttrH)
 289+ A345 FE 02            CP 2
 290+ A347 38 04            JR C, .plAttrHOk
 291+ A349 3D               DEC A
 292+ A34A 32 BD 9F         LD (EntityAttrH), A
 293+ A34D              .plAttrHOk:
 294+ A34D DD E1            POP IX
 295+ A34F 3A 64 82         LD A, (PlayerDrawY)
 296+ A352 57               LD D, A
 297+ A353 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 298+ A356 5F               LD E, A
 299+ A357 DD 7E 05         LD A, (IX+ENT_ATTR)
 300+ A35A CD BE 9E         CALL SetEntityAttr
 301+ A35D C9               RET
 302+ A35E
 303+ A35E              .plDoErase:
 304+ A35E                  ; --- Erase viejo ---
 305+ A35E CD C1 A8         CALL GetOldSpriteAddr
 306+ A361 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 307+ A364 DD 7E 0C         LD A, (IX+ENT_OLDX)
 308+ A367 5F               LD E, A
 309+ A368 DD E5            PUSH IX
 310+ A36A DD 2A 49 A8      LD IX, (OldSprAddr)
 311+ A36E CD CE 9D         CALL DrawSprite
 312+ A371 DD E1            POP IX
 313+ A373                  ; Restaurar atributos del fondo en posicion vieja
 314+ A373 DD 56 0D         LD D, (IX+ENT_OLDY)
 315+ A376 DD 5E 0C         LD E, (IX+ENT_OLDX)
 316+ A379 CD 9A D5         CALL RestoreOldAttr
 317+ A37C                  ; --- Draw nuevo ---
 318+ A37C CD 90 A8         CALL GetSpriteAddr
 319+ A37F 3A 64 82         LD A, (PlayerDrawY)
 320+ A382 57               LD D, A
 321+ A383 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 322+ A386 5F               LD E, A
 323+ A387 DD E5            PUSH IX
 324+ A389 DD 2A BF A8      LD IX, (SpriteAddrTemp)
 325+ A38D CD CE 9D         CALL DrawSprite
 326+ A390 DD E1            POP IX
 327+ A392
 328+ A392                  ; Pintar attr
 329+ A392 3A 64 82         LD A, (PlayerDrawY)
 330+ A395 57               LD D, A
 331+ A396 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 332+ A399 5F               LD E, A
 333+ A39A DD E5            PUSH IX
 334+ A39C DD 2A BF A8      LD IX, (SpriteAddrTemp)
 335+ A3A0 CD EB 9E         CALL CalcEntityAttrSize
 336+ A3A3 DD E1            POP IX
 337+ A3A5                  ; Reducir altura attr en 1 si es 4+ (última fila contiene muy pocos pixels
 338+ A3A5                  ; del sprite pero invade el char BG inferior con el color del player)
 339+ A3A5 3A BD 9F         LD A, (EntityAttrH)
 340+ A3A8 FE 04            CP 4
 341+ A3AA 38 04            JR C, .plAttrHOk2
 342+ A3AC 3D               DEC A
 343+ A3AD 32 BD 9F         LD (EntityAttrH), A
 344+ A3B0              .plAttrHOk2:
 345+ A3B0 3A 64 82         LD A, (PlayerDrawY)
 346+ A3B3 57               LD D, A
 347+ A3B4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 348+ A3B7 5F               LD E, A
 349+ A3B8 DD 7E 05         LD A, (IX+ENT_ATTR)
 350+ A3BB CD BE 9E         CALL SetEntityAttr
 351+ A3BE
 352+ A3BE                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 353+ A3BE              .plSaveOld:
 354+ A3BE DD 7E 0F         LD A, (IX+ENT_DRAWX)
 355+ A3C1 DD 77 0C         LD (IX+ENT_OLDX), A
 356+ A3C4 3A 64 82         LD A, (PlayerDrawY)
 357+ A3C7 DD 77 0D         LD (IX+ENT_OLDY), A
 358+ A3CA DD 7E 00         LD A, (IX+ENT_SPRITEID)
 359+ A3CD DD 77 0E         LD (IX+ENT_OLDSPRID), A
 360+ A3D0 C9               RET
 361+ A3D1
 362+ A3D1                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 363+ A3D1              .plFresh:
 364+ A3D1 DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 365+ A3D5 CD 32 A9         CALL UpdatePlayer
 366+ A3D8 CD 4B A8         CALL CalcDrawX
 367+ A3DB CD A6 A2         CALL ComputePlayerDrawY
 368+ A3DE CD 90 A8         CALL GetSpriteAddr
 369+ A3E1
 370+ A3E1 3A 64 82         LD A, (PlayerDrawY)
 371+ A3E4 57               LD D, A
 372+ A3E5 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 373+ A3E8 5F               LD E, A
 374+ A3E9 DD E5            PUSH IX
 375+ A3EB DD 2A BF A8      LD IX, (SpriteAddrTemp)
 376+ A3EF CD EB 9E         CALL CalcEntityAttrSize
 377+ A3F2 DD E1            POP IX
 378+ A3F4                  ; Reducir altura attr en 1 si es 4+ (evita invadir char BG inferior)
 379+ A3F4 3A BD 9F         LD A, (EntityAttrH)
 380+ A3F7 FE 04            CP 4
 381+ A3F9 38 04            JR C, .plAttrHOk3
 382+ A3FB 3D               DEC A
 383+ A3FC 32 BD 9F         LD (EntityAttrH), A
 384+ A3FF              .plAttrHOk3:
 385+ A3FF 3A 64 82         LD A, (PlayerDrawY)
 386+ A402 57               LD D, A
 387+ A403 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 388+ A406 5F               LD E, A
 389+ A407 DD 7E 05         LD A, (IX+ENT_ATTR)
 390+ A40A CD BE 9E         CALL SetEntityAttr
 391+ A40D
 392+ A40D 3A 64 82         LD A, (PlayerDrawY)
 393+ A410 57               LD D, A
 394+ A411 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 395+ A414 5F               LD E, A
 396+ A415 DD E5            PUSH IX
