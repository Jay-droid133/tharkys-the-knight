  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD 1F 6A         CALL InitPaging
  34  6007 CD AA 9B         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 D5 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 BA 02         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; RandomSynthMapX = $FE (inactivo: no hay random pickup spawneado al boot).
  62  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  63  602B 3E FF            LD A, $FF
  64  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  65  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  66  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  67  6036 3E FE            LD A, $FE
  68  6038 32 B4 5F         LD (RandomSynthMapX), A
  69  603B
  70  603B                  ; Inicializar sistema de pantallas
  71  603B CD 16 CC         CALL InitGameState      ; Reset variables de gameplay (idempotente)
  72  603E CD 45 CF         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  73  6041 CD 8C A1         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  74  6044 CD 01 E5         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  75  6047 CD D6 BF         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  76  604A CD 1A F1         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  77  604D                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  78  604D
  79  604D ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  80  604F FB               EI                      ; Habilitar interrupciones
  81  6050 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  82  6052 32 3E 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
  83  6055 C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
  84  6058
  85  6058                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
  86  6058                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
  87  6058                  ; contention pero solo durante la cinematica final, una vez por partida —
  88  6058                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
  89  6058                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
  90  6058                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
  91  6058                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
  92  6058                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
  93  6058                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 6058              ; ==============================================================================
   2+ 6058              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6058              ; ==============================================================================
   4+ 6058              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6058              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6058              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6058              ;
   8+ 6058              ; Esquema de fases:
   9+ 6058              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6058              ;   2 ARM_IN       arm aparece, pausa
  11+ 6058              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6058              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6058              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6058              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6058              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6058              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6058              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6058              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6058              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6058              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6058              ;  13 END_HOLD     "The End" sprite hold
  22+ 6058              ;  14 BLACK        wipe a negro + hold
  23+ 6058              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6058              ;
  25+ 6058              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6058              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6058              ; ==============================================================================
  28+ 6058
  29+ 6058              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6058              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6058              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6058              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6058              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6058              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6058              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6058              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6058              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 6058              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 6058              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 6058
  41+ 6058              ; --- Posiciones (pixel) ---
  42+ 6058              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 6058              TGCS_ANCHOR1_Y         EQU 80
  44+ 6058              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 6058              TGCS_END_CHARY         EQU 4
  46+ 6058              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 6058
  48+ 6058              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 6058              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 6058              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 6058              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 6058              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 6058              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 6058              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 6058              TGCS_ARM_PX_X          EQU 136
  56+ 6058              TGCS_ARM_PX_Y          EQU 64
  57+ 6058              TGCS_FINGER_PX_X       EQU 136
  58+ 6058              TGCS_FINGER_PX_Y       EQU 56
  59+ 6058
  60+ 6058              ; --- Phase enum ---
  61+ 6058              TGP_IDLE               EQU 0
  62+ 6058              TGP_LOCK               EQU 1
  63+ 6058              TGP_ARM_IN             EQU 2
  64+ 6058              TGP_FINGER_IN          EQU 3
  65+ 6058              TGP_SHAKE              EQU 4
  66+ 6058              TGP_FINGER_PULSE       EQU 5
  67+ 6058              TGP_FINGER_OUT         EQU 6
  68+ 6058              TGP_ARM_HOLD           EQU 7
  69+ 6058              TGP_ARM_OUT            EQU 8
  70+ 6058              TGP_PLAYER_TURN        EQU 9
  71+ 6058              TGP_PLAYER_HIDE        EQU 10
  72+ 6058              TGP_PLAYER_FRAMED      EQU 11
  73+ 6058              TGP_PLAYER_EXIT        EQU 12
