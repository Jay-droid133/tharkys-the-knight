  41+ 8DA3 3A A1 81         LD A, (EntityTable + ENT_POSY)
  42+ 8DA6 D6 10            SUB SCREEN_MIN_Y
  43+ 8DA8 0F               RRCA
  44+ 8DA9 0F               RRCA
  45+ 8DAA 0F               RRCA
  46+ 8DAB E6 1F            AND $1F
  47+ 8DAD 32 B4 97         LD (MaiFlowPlCy), A
  48+ 8DB0
  49+ 8DB0                  ; --- Swap a stack temporal (bank 2) ---
  50+ 8DB0 ED 73 BA 97      LD (MaiFlowSavedSP), SP
  51+ 8DB4 31 5A 98         LD SP, MaiTempStackTop
  52+ 8DB7
  53+ 8DB7                  ; --- Ventana de paginacion ---
  54+ 8DB7                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 8DB7 F3               DI
  56+ 8DB8 3A 84 8D         LD A, (CurrentPaging)
  57+ 8DBB E6 F8            AND $F8
  58+ 8DBD F6 06            OR 6
  59+ 8DBF 32 84 8D         LD (CurrentPaging), A
  60+ 8DC2 01 FD 7F         LD BC, $7FFD
  61+ 8DC5 ED 79            OUT (C), A
  62+ 8DC7
  63+ 8DC7                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 8DC7 CD E3 8D         CALL MaiFlowBfs
  65+ 8DCA
  66+ 8DCA                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 8DCA 3A 84 8D         LD A, (CurrentPaging)
  68+ 8DCD E6 F8            AND $F8
  69+ 8DCF 32 84 8D         LD (CurrentPaging), A
  70+ 8DD2 01 FD 7F         LD BC, $7FFD
  71+ 8DD5 ED 79            OUT (C), A
  72+ 8DD7
  73+ 8DD7 ED 7B BA 97      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 8DDB 3A 9C 81         LD A, (StartupComplete)
  75+ 8DDE B7               OR A
  76+ 8DDF 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 8DE1 FB               EI
  78+ 8DE2              .mcffNoEI:
  79+ 8DE2 C9               RET
