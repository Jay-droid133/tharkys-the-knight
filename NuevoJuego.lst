4135+ B98B DD 7E 04         LD A, (IX+ENT_POSY)
4136+ B98E 47               LD B, A                         ; B = posY (salvar)
4137+ B98F 0F               RRCA
4138+ B990 0F               RRCA
4139+ B991 0F               RRCA
4140+ B992 E6 1F            AND $1F
4141+ B994 D6 02            SUB BG_Y_OFFSET
4142+ B996 32 E7 B9         LD (.ecYlo), A
4143+ B999 78               LD A, B
4144+ B99A 81               ADD A, C
4145+ B99B 3D               DEC A                           ; posY + H - 1
4146+ B99C 0F               RRCA
4147+ B99D 0F               RRCA
4148+ B99E 0F               RRCA
4149+ B99F E6 1F            AND $1F
4150+ B9A1 D6 02            SUB BG_Y_OFFSET
4151+ B9A3 47               LD B, A                         ; B = charYhi
4152+ B9A4 3A E7 B9         LD A, (.ecYlo)
4153+ B9A7 ED 44            NEG
4154+ B9A9 80               ADD A, B
4155+ B9AA 3C               INC A                           ; height_chars
4156+ B9AB 32 E9 B9         LD (.ecHc), A
