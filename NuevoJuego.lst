4321+ BA27              ; CountActiveNasties / CountActiveMonsters
4322+ BA27              ; ==============================================================================
4323+ BA27              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4324+ BA27              ; Ambas usan _CountSlots internamente.
4325+ BA27              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4326+ BA27              ; ==============================================================================
4327+ BA27              CountActiveNasties:
4328+ BA27 21 B0 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4329+ BA2A 06 04            LD B, NUM_NASTIES
4330+ BA2C 18 05            JR _CountSlots
4331+ BA2E
4332+ BA2E              CountActiveMonsters:
4333+ BA2E 21 50 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4334+ BA31 06 06            LD B, NUM_MONSTERS
4335+ BA33
4336+ BA33              _CountSlots:
4337+ BA33 0E 00            LD C, 0                         ; Contador
4338+ BA35              .countLoop:
4339+ BA35 7E               LD A, (HL)
4340+ BA36 B7               OR A
4341+ BA37 28 16            JR Z, .countNext                ; Slot vacio: no contar
4342+ BA39                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4343+ BA39 D5               PUSH DE
4344+ BA3A 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4345+ BA3D 19               ADD HL, DE
4346+ BA3E 7E               LD A, (HL)
4347+ BA3F ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4348+ BA41 D1               POP DE
4349+ BA42 FE 03            CP STATE_DYING
4350+ BA44 28 09            JR Z, .countNext
4351+ BA46 FE 04            CP STATE_SPAWNING
4352+ BA48 28 05            JR Z, .countNext
4353+ BA4A FE 05            CP STATE_SCARED
4354+ BA4C 28 01            JR Z, .countNext
4355+ BA4E 0C               INC C
4356+ BA4F              .countNext:
4357+ BA4F 11 10 00         LD DE, ENT_SIZE
4358+ BA52 19               ADD HL, DE
4359+ BA53 10 E0            DJNZ .countLoop
4360+ BA55 79               LD A, C
4361+ BA56 C9               RET
4362+ BA57
4363+ BA57              ; ==============================================================================
4364+ BA57              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4365+ BA57              ; ==============================================================================
4366+ BA57              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4367+ BA57              ; ==============================================================================
4368+ BA57              TrySpawnNasty:
4369+ BA57                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4370+ BA57                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4371+ BA57                  ; cuando el timer llega a 0.
4372+ BA57 3A 67 82         LD A, (PostTrapPauseTimer)
4373+ BA5A B7               OR A
4374+ BA5B C0               RET NZ
4375+ BA5C                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4376+ BA5C                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4377+ BA5C 3A 79 82         LD A, (DeathBorderPhase)
4378+ BA5F B7               OR A
4379+ BA60 C0               RET NZ
4380+ BA61                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4381+ BA61                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4382+ BA61                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4383+ BA61 3A 7D 82         LD A, (PlayerRespawnPhase)
4384+ BA64 FE 01            CP 1
4385+ BA66 C8               RET Z
4386+ BA67                  ; Cooldown tras cambio de pantalla / inicio
4387+ BA67 3A 87 82         LD A, (SpawnTimer)
4388+ BA6A B7               OR A
4389+ BA6B 28 05            JR Z, .spawnReady
4390+ BA6D 3D               DEC A
4391+ BA6E 32 87 82         LD (SpawnTimer), A
4392+ BA71 C9               RET
4393+ BA72              .spawnReady:
4394+ BA72                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4395+ BA72 3A D4 B8         LD A, (ScareTimer)
4396+ BA75 B7               OR A
4397+ BA76 C0               RET NZ
4398+ BA77                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4399+ BA77                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4400+ BA77                  ; rellenamos con nasties crepusculares hasta A2.
4401+ BA77 3A 61 82         LD A, (MonsterTrappedFlags)
4402+ BA7A E6 07            AND $07
4403+ BA7C FE 07            CP $07
4404+ BA7E 28 0E            JR Z, .spawnIgnoreNightBlocks
4405+ BA80                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4406+ BA80                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4407+ BA80                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4408+ BA80                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4409+ BA80 3A 3E B6         LD A, (MonstersActive)
4410+ BA83 B7               OR A
4411+ BA84 C0               RET NZ
4412+ BA85                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4413+ BA85 3A 97 E4         LD A, (CurrentTimeOfDay)
4414+ BA88 FE 04            CP 4                        ; N2
4415+ BA8A C8               RET Z
4416+ BA8B FE 05            CP 5                        ; A1
4417+ BA8D C8               RET Z
4418+ BA8E              .spawnIgnoreNightBlocks:
4419+ BA8E                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4420+ BA8E                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4421+ BA8E                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4422+ BA8E                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4423+ BA8E DD 21 AF 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4424+ BA92 06 04            LD B, NUM_NASTIES
4425+ BA94              .spawnLoop:
4426+ BA94 C5               PUSH BC
4427+ BA95 DD 7E 01         LD A, (IX+ENT_TYPE)
4428+ BA98 B7               OR A
4429+ BA99 20 12            JR NZ, .spawnNextSlot
4430+ BA9B CD B6 BA         CALL SpawnOneNasty
4431+ BA9E DD 7E 01         LD A, (IX+ENT_TYPE)
4432+ BAA1 B7               OR A
4433+ BAA2 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4434+ BAA4                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4435+ BAA4                  ; (un poco de irregularidad en la cadencia de aparicion).
4436+ BAA4 ED 5F            LD A, R
4437+ BAA6 E6 07            AND $07
4438+ BAA8 32 87 82         LD (SpawnTimer), A
4439+ BAAB C1               POP BC
4440+ BAAC C9               RET
4441+ BAAD              .spawnNextSlot:
4442+ BAAD 11 10 00         LD DE, ENT_SIZE
4443+ BAB0 DD 19            ADD IX, DE
4444+ BAB2 C1               POP BC
4445+ BAB3 10 DF            DJNZ .spawnLoop
4446+ BAB5 C9               RET
4447+ BAB6
4448+ BAB6              ; ==============================================================================
4449+ BAB6              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4450+ BAB6              ; ==============================================================================
4451+ BAB6              SpawnOneNasty:
4452+ BAB6                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4453+ BAB6 ED 5F            LD A, R
4454+ BAB8 E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4455+ BABA 6F               LD L, A
4456+ BABB 26 00            LD H, 0
4457+ BABD ED 5B D4 BF      LD DE, (CurrentNastyTable)
4458+ BAC1 19               ADD HL, DE
4459+ BAC2 7E               LD A, (HL)
4460+ BAC3
4461+ BAC3                  ; Configurar entidad base
4462+ BAC3 DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4463+ BAC6 DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4464+ BACA DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4465+ BACE                  ; Spawn anim segun momento del dia: nocturno (CrepuscularTypeTable) usa
4466+ BACE                  ; SPRID_SPAWN_NIGHT, diurno usa SPRID_SPAWN.
4467+ BACE 3A D4 BF         LD A, (CurrentNastyTable)
4468+ BAD1 FE BB            CP LOW CrepuscularTypeTable
4469+ BAD3 20 0B            JR NZ, .spnDay
4470+ BAD5 3A D5 BF         LD A, (CurrentNastyTable + 1)
4471+ BAD8 FE BF            CP HIGH CrepuscularTypeTable
4472+ BADA 20 04            JR NZ, .spnDay
4473+ BADC 3E 68            LD A, SPRID_SPAWN_NIGHT
4474+ BADE 18 02            JR .spnSet
4475+ BAE0              .spnDay:
4476+ BAE0 3E 46            LD A, SPRID_SPAWN
4477+ BAE2              .spnSet:
4478+ BAE2 DD 77 00         LD (IX+ENT_SPRITEID), A
4479+ BAE5 DD 77 08         LD (IX+ENT_ANIMBASE), A
4480+ BAE8 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4481+ BAEC DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
4482+ BAF0
4483+ BAF0                  ; Color segun tipo (cada tipo tiene color fijo)
4484+ BAF0 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
4485+ BAF3 21 BF BF         LD HL, NastyColorTable
4486+ BAF6 D5               PUSH DE
4487+ BAF7 11 20 00         LD DE, SPRID_ENEMY_0
4488+ BAFA 93               SUB E                       ; A = SPRID offset desde ENEMY_0
4489+ BAFB CB 3F            SRL A
