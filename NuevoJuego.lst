 143+ 84C9              ; Variables locales de DrawSprite
 144+ 84C9 00           .posX:       DEFB 0
 145+ 84CA 00           .posY:       DEFB 0
 146+ 84CB 00           .widthSave:  DEFB 0
 147+ 84CC 00           .heightSave: DEFB 0
 148+ 84CD 00           .tablePage:  DEFB 0
 149+ 84CE 00           .widthCount: DEFB 0
