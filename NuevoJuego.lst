 222+ 99A6              .aypbOuter:
 223+ 99A6 21 80 06         LD HL, $0680                ; ~1664 inner iters
 224+ 99A9              .aypbInner:
 225+ 99A9 2B               DEC HL
 226+ 99AA 7C               LD A, H
 227+ 99AB B5               OR L
 228+ 99AC 20 FB            JR NZ, .aypbInner
 229+ 99AE 10 F6            DJNZ .aypbOuter
