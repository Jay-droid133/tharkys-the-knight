2671+ AD9B CB 7F            BIT 7, A
2672+ AD9D 28 02            JR Z, .eAnimDir
2673+ AD9F 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2674+ ADA1              .eAnimDir:
2675+ ADA1 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2676+ ADA4 20 27            JR NZ, .eAnimDone
