 378+ E5F6              ; Descenso menor, somber, ~2.5s. Borrador inicial — iterar.
 379+ E5F6              GameOverMusicTable:
 380+ E5F6 F1 01            DEFW $01F1                      ; A3  ~220 Hz
 381+ E5F8 0A               DEFB 10
 382+ E5F9 2E 02            DEFW $022E                      ; G3
 383+ E5FB 0A               DEFB 10
 384+ E5FC 72 02            DEFW $0272                      ; F3
 385+ E5FE 0A               DEFB 10
 386+ E5FF 97 02            DEFW $0297                      ; E3
 387+ E601 0A               DEFB 10
 388+ E602 E9 02            DEFW $02E9                      ; D3
 389+ E604 0C               DEFB 12
 390+ E605 44 03            DEFW $0344                      ; C3 (resolucion grave)
 391+ E607 18               DEFB 24                         ; final sostenido ~960ms
 392+ E608 00 00            DEFW 0
 393+ E60A 00               DEFB 0
 394+ E60B
 395+ E60B              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 396+ E60B              ; Entrada: (MusicTrackArg) = 0..3 (Tension, Sunrise, EndGame, GameOver). Track ids
 397+ E60B              ; desconocidos resultan en no-op (RET sin armar nada). Setup AY (mixer + vol)
 398+ E60B              ; compartido. NO usar A como entrada: el thunk en bank 2 clobbea A al leer
 399+ E60B              ; CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 400+ E60B              StartMusicImpl:
 401+ E60B                  ; Resolver puntero a tabla segun track_id
 402+ E60B 3A C7 9D         LD A, (MusicTrackArg)
 403+ E60E 21 A2 E5         LD HL, TensionMusicTable
 404+ E611 B7               OR A
 405+ E612 28 13            JR Z, .smArm
 406+ E614 21 B1 E5         LD HL, SunriseMusicTable
 407+ E617 3D               DEC A
 408+ E618 28 0D            JR Z, .smArm
 409+ E61A 21 D2 E5         LD HL, EndGameMusicTable
 410+ E61D 3D               DEC A
 411+ E61E 28 07            JR Z, .smArm
 412+ E620 21 F6 E5         LD HL, GameOverMusicTable
 413+ E623 3D               DEC A
 414+ E624 28 01            JR Z, .smArm
 415+ E626 C9               RET                             ; track_id desconocido: no-op
 416+ E627              .smArm:
 417+ E627 E5               PUSH HL                         ; preservar tabla a traves de AY_WriteReg (clobbea BC/A)
 418+ E628                  ; Mixer: solo tono B activo (A/C off, ruidos off). Canal B = centro (ambos
 419+ E628                  ; altavoces) en cableado ACB del Spectrum 128. Canal A es izquierdo y C es
 420+ E628                  ; derecho — reservados para campanadas con paneo segun distancia a plaza.
 421+ E628 3E 07            LD A, 7
 422+ E62A 1E 3D            LD E, $3D                       ; %00111101 (bit 1=0 -> B tono on; bits 0,2=1 -> A,C off)
 423+ E62C CD 5D E4         CALL AY_WriteReg
 424+ E62F                  ; Volumen canal B (R9)
 425+ E62F 3E 09            LD A, 9
 426+ E631 1E 0C            LD E, 12                        ; vol medio-alto
 427+ E633 CD 5D E4         CALL AY_WriteReg
 428+ E636 E1               POP HL
 429+ E637 22 9F E5         LD (MusicPtr), HL
 430+ E63A C3 55 E6         JP MusicAdvanceNote
 431+ E63D
 432+ E63D              ; --- UpdateMusicImpl: catchup wall-clock — avanza N game frames donde
 433+ E63D              ; N = FramesElapsed (calculado en MainLoop top). Bajo carga normal N=1.
 434+ E63D              ; Tras una transicion lenta puede ser N=3..10 → consume varias notas en una
 435+ E63D              ; llamada para preservar el ritmo en wall-clock.
 436+ E63D              UpdateMusicImpl:
 437+ E63D 3A C8 9D         LD A, (FramesElapsed)
 438+ E640 B7               OR A
 439+ E641 C8               RET Z
 440+ E642 47               LD B, A
 441+ E643              .upmiLoop:
 442+ E643 C5               PUSH BC
 443+ E644 CD 4B E6         CALL .upmiTickOnce
 444+ E647 C1               POP BC
 445+ E648 10 F9            DJNZ .upmiLoop
 446+ E64A C9               RET
 447+ E64B
 448+ E64B              .upmiTickOnce:
 449+ E64B 3A A1 E5         LD A, (MusicTimer)
 450+ E64E B7               OR A
 451+ E64F C8               RET Z                           ; inactivo
 452+ E650 3D               DEC A
 453+ E651 32 A1 E5         LD (MusicTimer), A
 454+ E654 C0               RET NZ                          ; aun en la nota actual
 455+ E655                  ; Hora de la siguiente nota (fall-through a MusicAdvanceNote)
 456+ E655
 457+ E655              ; --- MusicAdvanceNote: lee 3 bytes de la tabla y aplica al AY ---
 458+ E655              ; Formato de entry (3 bytes):
 459+ E655              ;   period=$XXXX, duration=$NN  -> nota normal a ese pitch durante NN frames
 460+ E655              ;   period=$0000, duration=$NN  -> rest (mute R8) durante NN frames (NN!=0)
 461+ E655              ;   period=$0000, duration=$00  -> terminador (silencia canal y para)
 462+ E655              ;
 463+ E655              ; OJO: AY_WriteReg clobbea B y C (LD BC, $FFFD/$BFFD). Hay que stashear los
 464+ E655              ; bytes de period en D y E (que SI se preservan a traves del call).
 465+ E655              MusicAdvanceNote:
 466+ E655 2A 9F E5         LD HL, (MusicPtr)
 467+ E658 5E               LD E, (HL)                      ; E = pitch_lo
 468+ E659 23               INC HL
 469+ E65A 56               LD D, (HL)                      ; D = pitch_hi
 470+ E65B 23               INC HL
 471+ E65C 7E               LD A, (HL)                      ; duration
 472+ E65D 23               INC HL
 473+ E65E B7               OR A
 474+ E65F 28 25            JR Z, .manEnd                   ; duration = 0 -> fin de tabla
 475+ E661 22 9F E5         LD (MusicPtr), HL
 476+ E664 32 A1 E5         LD (MusicTimer), A
 477+ E667                  ; ¿es rest? (period == 0 y duration != 0)
 478+ E667 7B               LD A, E
 479+ E668 B2               OR D
 480+ E669 28 14            JR Z, .manRest
 481+ E66B                  ; Nota normal: re-armar vol R9 (por si venimos de un rest que la mute) +
 482+ E66B                  ; escribir period en R2/R3 (canal B). Re-armar siempre cuesta 1 AY_WriteReg
 483+ E66B                  ; extra por nota; mas barato que llevar un flag de estado.
 484+ E66B D5               PUSH DE
 485+ E66C 3E 09            LD A, 9
 486+ E66E 1E 0C            LD E, 12
 487+ E670 CD 5D E4         CALL AY_WriteReg                ; R9 = vol B medio-alto
 488+ E673 D1               POP DE
 489+ E674 3E 02            LD A, 2                         ; R2 = period B low
 490+ E676 CD 5D E4         CALL AY_WriteReg                ; escribe E (pitch_lo); D preservado
 491+ E679 3E 03            LD A, 3                         ; R3 = period B high
 492+ E67B 5A               LD E, D                         ; recargar E con pitch_hi
 493+ E67C C3 5D E4         JP AY_WriteReg                  ; tail-call
 494+ E67F              .manRest:
 495+ E67F                  ; Silencio durante MusicTimer frames; UpdateMusicImpl seguira tickeando.
 496+ E67F 3E 09            LD A, 9
 497+ E681 1E 00            LD E, 0
 498+ E683 C3 5D E4         JP AY_WriteReg                  ; tail-call (mute R9)
 499+ E686              .manEnd:
 500+ E686                  ; Silenciar canal B
 501+ E686 AF               XOR A
 502+ E687 32 A1 E5         LD (MusicTimer), A              ; flag inactivo
 503+ E68A 3E 09            LD A, 9
 504+ E68C 1E 00            LD E, 0
 505+ E68E C3 5D E4         JP AY_WriteReg                  ; tail-call
 506+ E691
