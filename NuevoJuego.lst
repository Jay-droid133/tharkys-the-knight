 221  7FCB
 222  7FCB                  ; ==========================================================================
 223  7FCB                  ; ORG $8000 - codigo principal (no-contended)
 224  7FCB                  ; ==========================================================================
 225  7FCB                  ORG ORIGIN_ADDRESS
 226  8000
 227  8000              ; ==============================================================================
 228  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 229  8000              ; ==============================================================================
 230  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 231  8000              ;   erase viejo → AI/movimiento → draw nuevo
 232  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 233  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 234  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 235  8000              ; ==============================================================================
 236  8000              MainLoop:
 237  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 238  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 239  8003 47               LD B, A                     ; B = tick actual
 240  8004
 241  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 242  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 243  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 244  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 245  8004 78               LD A, B
 246  8005 21 9F 81         LD HL, .frameStart
 247  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 248  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 249  800A 21 EA 99         LD HL, TickRemainder
 250  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 251  800E 4F               LD C, A
 252  800F E6 01            AND $01
 253  8011 77               LD (HL), A                  ; new remainder = total mod 2
 254  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 255  8014 79               LD A, C
 256  8015 32 E9 99         LD (FramesElapsed), A
 257  8018
 258  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 259  8018 CD 0B CC         CALL UpdateDeathBorder
 260  801B CD DC CB         CALL UpdateDeathAnim
 261  801E                  ; Music tick: ahora vive en MusicIrqHandler (slot 1, cada 2 IRQs = 25 Hz).
 262  801E                  ; Auditoria de concurrencia AY confirmada: todos los AY writes desde
 263  801E                  ; MainLoop estan envueltos en DI/EI (ay_sound_thunks + sfx_player_hit_ay).
 264  801E                  ; UpdateMusicImpl sigue vivo como catchup-fallback no llamado por defecto.
 265  801E
 266  801E                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 267  801E 3A E7 82         LD A, (GameOver)
 268  8021 B7               OR A
 269  8022 28 23            JR Z, .notGameOver
 270  8024 FE 02            CP 2
 271  8026 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 272  8028                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 273  8028 CD 66 CC         CALL PaintGameOverScreen
 274  802B 3E 02            LD A, 2
 275  802D 32 E7 82         LD (GameOver), A
 276  8030 C3 8F 81         JP .frameSync
 277  8033              .gameOverWaitInput:
 278  8033 CD A2 CC         CALL UpdateGameOverAnim     ; Death moonwalkea por la pantalla negra
 279  8036 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 280  8039 ED 78            IN A, (C)
 281  803B CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 282  803D C2 8F 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 283  8040                  ; SPACE pulsado: reset total -> JP Inicio
 284  8040 F3               DI
 285  8041 31 58 FF         LD SP, SP_ADDRESS
 286  8044 C3 00 60         JP Inicio
 287  8047              .notGameOver:
 288  8047
 289  8047                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
 290  8047 CD 69 CD         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
 291  804A CD 8D 6D         CALL UpdateRandomPickup     ; Random pickup roll (early-out si !ScreenDirty)
 292  804D                  ; Lasting compass gating: solo el caso del roll DIRECTO a COMPASS necesita
 293  804D                  ; invalidacion aqui (synth ptr == BgGfx_pickup_compass → pickup redundante).
 294  804D                  ; El caso de la ruleta ya esta cubierto upstream: AdvanceRouletteIdx /
 295  804D                  ; SkipCompassIfNeeded (random_pickups.asm) saltan la entry ROUL_COMPASS
 296  804D                  ; del RouletteOrder cuando MagicCompassPermanent != 0 — la ruleta cicla
 297  804D                  ; 8 estados (de 9) sin mostrar un solo frame de compass.
 298  804D 3A CD 82         LD A, (MagicCompassPermanent)
 299  8050 B7               OR A
 300  8051 28 10            JR Z, .lcSkipRPGate
 301  8053 2A B6 5F         LD HL, (RandomSynthPtr)
 302  8056 11 D4 F3         LD DE, BgGfx_pickup_compass
 303  8059 B7               OR A
 304  805A ED 52            SBC HL, DE
 305  805C 20 05            JR NZ, .lcSkipRPGate
 306  805E 3E FE            LD A, $FE
 307  8060 32 B4 5F         LD (RandomSynthMapX), A
