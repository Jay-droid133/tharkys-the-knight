 467+ A056              ; ==============================================================================
 468+ A056              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A056              ; ==============================================================================
 470+ A056              ; Entrada: A = indice de entidad (0-16)
 471+ A056              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A056              ; ==============================================================================
 473+ A056              SetAttrSlot:
 474+ A056 32 55 A0         LD (CurrentAttrSlot), A
 475+ A059                  ; Calcular offset: A * 18
 476+ A059 6F               LD L, A
 477+ A05A 26 00            LD H, 0
 478+ A05C 29               ADD HL, HL                  ; x2
 479+ A05D 54               LD D, H
 480+ A05E 5D               LD E, L                     ; DE = x2
 481+ A05F 29               ADD HL, HL                  ; x4
 482+ A060 29               ADD HL, HL                  ; x8
 483+ A061 29               ADD HL, HL                  ; x16
 484+ A062 19               ADD HL, DE                  ; x18
 485+ A063 11 23 9F         LD DE, SavedAttrTable
 486+ A066 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A067                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A067 11 11 9F         LD DE, EntitySavedAttr
 489+ A06A 01 12 00         LD BC, 18
 490+ A06D ED B0            LDIR
 491+ A06F C9               RET
 492+ A070
 493+ A070              ; ==============================================================================
 494+ A070              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A070              ; ==============================================================================
 496+ A070              FlushAttrSlot:
 497+ A070 3A 55 A0         LD A, (CurrentAttrSlot)
 498+ A073 6F               LD L, A
 499+ A074 26 00            LD H, 0
 500+ A076 29               ADD HL, HL                  ; x2
 501+ A077 54               LD D, H
 502+ A078 5D               LD E, L
 503+ A079 29               ADD HL, HL                  ; x4
 504+ A07A 29               ADD HL, HL                  ; x8
 505+ A07B 29               ADD HL, HL                  ; x16
 506+ A07C 19               ADD HL, DE                  ; x18
 507+ A07D 11 23 9F         LD DE, SavedAttrTable
 508+ A080 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A081 EB               EX DE, HL                   ; DE = destino
 510+ A082 21 11 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A085 01 12 00         LD BC, 18
 512+ A088 ED B0            LDIR
 513+ A08A C9               RET
 514+ A08B
 515+ A08B              ; ==============================================================================
 516+ A08B              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A08B              ; ==============================================================================
 518+ A08B              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A08B              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A08B              ; ==============================================================================
 521+ A08B              CalcAttrAddr:
 522+ A08B 7A               LD A, D
 523+ A08C 0F               RRCA
 524+ A08D 0F               RRCA
 525+ A08E 0F               RRCA
 526+ A08F E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A091 6F               LD L, A
 528+ A092 26 00            LD H, 0
 529+ A094 29               ADD HL, HL
 530+ A095 29               ADD HL, HL
 531+ A096 29               ADD HL, HL
 532+ A097 29               ADD HL, HL
 533+ A098 29               ADD HL, HL                  ; HL = fila * 32
 534+ A099 7B               LD A, E
 535+ A09A 0F               RRCA
 536+ A09B 0F               RRCA
 537+ A09C 0F               RRCA
 538+ A09D E6 1F            AND $1F                     ; X / 8 = columna
 539+ A09F B5               OR L
 540+ A0A0 6F               LD L, A
 541+ A0A1 01 00 58         LD BC, ATTR_BASE
 542+ A0A4 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A0A5 C9               RET
 544+ A0A6
 545+ A0A6              ; ==============================================================================
 546+ A0A6              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A0A6              ; ==============================================================================
 548+ A0A6              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A0A6              ; Salida: HL=direccion en VRAM
 550+ A0A6              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A0A6              ; ==============================================================================
 552+ A0A6              CalcPixelAddr:
 553+ A0A6 7A               LD A, D
 554+ A0A7 E6 C0            AND $C0                     ; Y7 Y6
 555+ A0A9 1F               RRA
 556+ A0AA 1F               RRA
 557+ A0AB 1F               RRA                         ; >> 3
 558+ A0AC F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A0AE 67               LD H, A
 560+ A0AF
 561+ A0AF 7A               LD A, D
 562+ A0B0 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A0B2 B4               OR H
 564+ A0B3 67               LD H, A
 565+ A0B4
 566+ A0B4 7A               LD A, D
 567+ A0B5 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A0B7 87               ADD A, A
 569+ A0B8 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A0B9 6F               LD L, A
 571+ A0BA
 572+ A0BA 7B               LD A, E
 573+ A0BB 1F               RRA
 574+ A0BC 1F               RRA
 575+ A0BD 1F               RRA
 576+ A0BE E6 1F            AND $1F                     ; X / 8 = columna
 577+ A0C0 B5               OR L
 578+ A0C1 6F               LD L, A
 579+ A0C2 C9               RET
 580+ A0C3
 581+ A0C3              ; ==============================================================================
 582+ A0C3              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A0C3              ; ==============================================================================
 584+ A0C3              DrawDebugInfo:
 585+ A0C3 3A AE 82         LD A, (CurrentScreenX)
 586+ A0C6 1E 00            LD E, 0
 587+ A0C8 CD E5 A0         CALL .drawHexDigit
 588+ A0CB
 589+ A0CB 3E 2C            LD A, ','
 590+ A0CD 1E 01            LD E, 1
 591+ A0CF CD F1 A0         CALL .drawChar
 592+ A0D2
 593+ A0D2 3A AF 82         LD A, (CurrentScreenY)
 594+ A0D5 1E 02            LD E, 2
 595+ A0D7 CD E5 A0         CALL .drawHexDigit
 596+ A0DA
 597+ A0DA 21 00 58         LD HL, ATTR_BASE
 598+ A0DD 3E 47            LD A, WHITE | $40
 599+ A0DF 77               LD (HL), A
 600+ A0E0 23               INC HL
 601+ A0E1 77               LD (HL), A
 602+ A0E2 23               INC HL
 603+ A0E3 77               LD (HL), A
 604+ A0E4 C9               RET
 605+ A0E5
 606+ A0E5              .drawHexDigit:
 607+ A0E5 E6 0F            AND $0F
 608+ A0E7 FE 0A            CP 10
 609+ A0E9 38 04            JR C, .isNum
 610+ A0EB C6 37            ADD A, 'A' - 10
 611+ A0ED 18 02            JR .drawChar
 612+ A0EF              .isNum:
 613+ A0EF C6 30            ADD A, '0'
 614+ A0F1              .drawChar:
 615+ A0F1 6F               LD L, A
 616+ A0F2 26 00            LD H, 0
 617+ A0F4 29               ADD HL, HL
 618+ A0F5 29               ADD HL, HL
 619+ A0F6 29               ADD HL, HL
 620+ A0F7 01 00 3C         LD BC, $3C00
 621+ A0FA 09               ADD HL, BC
 622+ A0FB
 623+ A0FB 16 40            LD D, $40
 624+ A0FD 06 08            LD B, 8
 625+ A0FF              .charLoop:
 626+ A0FF 7E               LD A, (HL)
 627+ A100 12               LD (DE), A
 628+ A101 23               INC HL
 629+ A102 14               INC D
 630+ A103 10 FA            DJNZ .charLoop
 631+ A105 C9               RET
