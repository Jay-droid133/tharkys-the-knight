1368+ F12B              ; ==============================================================================
1369+ F12B              ; Variantes random de health/stamina pickup
1370+ F12B              ; ==============================================================================
1371+ F12B              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
1372+ F12B              ; eligen una variante visual al azar. Asi el random pickup tiene mas
1373+ F12B              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
1374+ F12B              ; variante — solo cambia el sprite que se ve.
1375+ F12B              ;
1376+ F12B              ; Formato tabla: DEFB count, ids... (1 byte por id)
1377+ F12B              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
1378+ F12B              ; ==============================================================================
1379+ F12B              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
1380+ F12B              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
1381+ F12B              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
1382+ F12B              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
1383+ F12B              ; raw, asi que usamos esos labels directamente.
1384+ F12B              HealthVariantPtrs:
1385+ F12B 05               DEFB 5                              ; 5 variantes (1 byte count)
1386+ F12C 7C E7            DEFW BgGfx_health_pickup            ; canonical (id 254, pan)
1387+ F12E 9C F1            DEFW BgGfx_health_pickup_72         ; variant id 72 (queso)
1388+ F130 EE F1            DEFW BgGfx_health_pickup_3          ; variant id 74 (chorizo)
1389+ F132 17 F2            DEFW BgGfx_health_pickup_4          ; variant id 75 (leche)
1390+ F134 BE F3            DEFW BgGfx_health_pickup_5          ; variant id 85 (pollo)
1391+ F136
1392+ F136              StaminaVariantPtrs:
1393+ F136 04               DEFB 4                              ; 4 variantes
1394+ F137 A5 E7            DEFW BgGfx_stamina_pickup           ; canonical (id 255, jarra de vino)
1395+ F139 C5 F1            DEFW BgGfx_stamina_pickup_2         ; variant id 73 (taza de cafe)
1396+ F13B E7 F3            DEFW BgGfx_stamina_pickup_3         ; variant id 79 (pocion)
1397+ F13D 10 F4            DEFW BgGfx_stamina_pickup_4         ; variant id 84 (copa de brandy)
1398+ F13F
1399+ F13F              ; ==============================================================================
1400+ F13F              ; PickRandomVariantPtr / LookupVariantPtrByIdx
1401+ F13F              ; ==============================================================================
1402+ F13F              ; PickRandomVariantPtr: elige variante random Y la persiste en RP_TmpVariant.
1403+ F13F              ;   IN:  HL = ptr a tabla "DEFB count, DEFW ptr1, DEFW ptr2, ..."
1404+ F13F              ;   OUT: HL = sprite ptr de la variante elegida.
1405+ F13F              ;   Side: RP_TmpVariant ← idx elegido (0..count-1), para que la cache pueda
1406+ F13F              ;         rotarlo y reusarlo al revisitar la sala.
1407+ F13F              ;
1408+ F13F              ; LookupVariantPtrByIdx: lookup directo SIN random (para cache hit que ya tiene
1409+ F13F              ;                       el idx que quiere reusar).
1410+ F13F              ;   IN:  HL = ptr a tabla, A = idx (0..count-1)
1411+ F13F              ;   OUT: HL = sprite ptr de la variante[idx].
1412+ F13F              ;   Side: ninguno (NO toca RP_TmpVariant — el caller lo gestiona).
1413+ F13F              ;
1414+ F13F              ; Destruye: AF, BC, DE (ambas rutinas).
1415+ F13F              ; ==============================================================================
1416+ F13F              PickRandomVariantPtr:
1417+ F13F 7E               LD A, (HL)                          ; A = count
1418+ F140 47               LD B, A
1419+ F141 ED 5F            LD A, R
1420+ F143              .pvpModLoop:
1421+ F143 90               SUB B
1422+ F144 30 FD            JR NC, .pvpModLoop
1423+ F146 80               ADD A, B                            ; A = R mod count (0..count-1)
1424+ F147 32 D8 5F         LD (RP_TmpVariant), A               ; persistir para cache rotation
1425+ F14A                  ; fall through a LookupVariantPtrByIdx (HL aun apunta al count byte, A = idx)
1426+ F14A              LookupVariantPtrByIdx:
1427+ F14A 23               INC HL                              ; HL @ first DEFW
1428+ F14B 87               ADD A, A                            ; idx*2 (DEFW = 2 B)
1429+ F14C 5F               LD E, A
1430+ F14D 16 00            LD D, 0
1431+ F14F 19               ADD HL, DE                          ; HL @ entry elegida
1432+ F150 7E               LD A, (HL)
1433+ F151 23               INC HL
1434+ F152 66               LD H, (HL)
1435+ F153 6F               LD L, A                             ; HL = sprite ptr
1436+ F154 C9               RET
1437+ F155
# file closed: random_pickups.asm
