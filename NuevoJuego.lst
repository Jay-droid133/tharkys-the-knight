2551+ B03A DD 77 06         LD (IX+ENT_DELTAX), A
2552+ B03D              .eXDone:
2553+ B03D
2554+ B03D                  ; --- Movimiento vertical ---
2555+ B03D DD 7E 04         LD A, (IX+ENT_POSY)
2556+ B040 32 C4 B0         LD (.savedEY), A
2557+ B043 47               LD B, A
2558+ B044 DD 7E 07         LD A, (IX+ENT_DELTAY)
2559+ B047 4F               LD C, A
2560+ B048 CB 79            BIT 7, C
2561+ B04A 20 0A            JR NZ, .eDeltaYNeg
2562+ B04C 78               LD A, B
2563+ B04D 81               ADD A, C
2564+ B04E FE A8            CP SCREEN_MAX_Y
2565+ B050 38 14            JR C, .eClampYOk
2566+ B052 3E A7            LD A, SCREEN_MAX_Y - 1
2567+ B054 18 1E            JR .eReverseY
2568+ B056              .eDeltaYNeg:
2569+ B056 78               LD A, B
2570+ B057 81               ADD A, C
2571+ B058 38 04            JR C, .eCheckMinY
2572+ B05A 3E 10            LD A, SCREEN_MIN_Y
2573+ B05C 18 16            JR .eReverseY
2574+ B05E              .eCheckMinY:
2575+ B05E FE 10            CP SCREEN_MIN_Y
2576+ B060 30 04            JR NC, .eClampYOk
2577+ B062 3E 10            LD A, SCREEN_MIN_Y
