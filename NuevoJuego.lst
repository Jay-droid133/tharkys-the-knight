 452+ F144 C6 30            ADD A, '0'
 453+ F146              .mhWriteTens:
 454+ F146 1E 1E            LD E, 30
 455+ F148 CD 2E E7         CALL DrawHudCharRow0
 456+ F14B F1               POP AF                      ; A = unidades
 457+ F14C C6 30            ADD A, '0'
