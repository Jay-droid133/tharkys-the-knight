5387+ BC8E              ; --- Tabla de tipos de nasty (SpriteID base) ---
5388+ BC8E              ; --- Tablas de nasties por momento del dia ---
5389+ BC8E              NUM_NASTY_TYPES EQU 4
5390+ BC8E              DiurnalTypeTable:                       ; DY, C1, A2
5391+ BC8E 30               DEFB SPRID_ENEMY_4          ; Eagle
5392+ BC8F 20               DEFB SPRID_ENEMY_0          ; Spider
5393+ BC90 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5394+ BC91 2C               DEFB SPRID_ENEMY_3          ; Snake
5395+ BC92              CrepuscularTypeTable:                   ; C2, N1
5396+ BC92 34               DEFB SPRID_ENEMY_5          ; Rat
5397+ BC93 28               DEFB SPRID_ENEMY_2          ; Bat
5398+ BC94 24               DEFB SPRID_ENEMY_1          ; Scorpion
5399+ BC95 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
