 606+ E84E              ; ==============================================================================
 607+ E84E              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 608+ E84E              ; ==============================================================================
 609+ E84E
 610+ E84E              ; ==============================================================================
 611+ E84E              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 612+ E84E              ; ==============================================================================
 613+ E84E              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 614+ E84E              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 615+ E84E              ; ==============================================================================
 616+ E84E              BuildPlazaScanAddrs:
 617+ E84E                  ; Calcular pixel coords del top-left de la esfera
 618+ E84E 3A 36 90         LD A, (PlazaClockCharY)
 619+ E851 07               RLCA
 620+ E852 07               RLCA
 621+ E853 07               RLCA
 622+ E854 57               LD D, A                     ; D = pixelY = charY * 8
 623+ E855 3A 35 90         LD A, (PlazaClockCharX)
 624+ E858 07               RLCA
 625+ E859 07               RLCA
 626+ E85A 07               RLCA
 627+ E85B 5F               LD E, A                     ; E = pixelX = charX * 8
 628+ E85C CD 31 A1         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 629+ E85F
 630+ E85F DD 21 37 90      LD IX, PlazaScanAddrs
 631+ E863 06 10            LD B, 16
 632+ E865              .buildLoop:
 633+ E865 DD 75 00         LD (IX+0), L
 634+ E868 DD 74 01         LD (IX+1), H
 635+ E86B DD 23            INC IX
 636+ E86D DD 23            INC IX
 637+ E86F 05               DEC B
 638+ E870 C8               RET Z
 639+ E871 CD 9D 9E         CALL NextPixelLine
 640+ E874 18 EF            JR .buildLoop
