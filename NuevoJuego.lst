 157+ 9E80              ; ==============================================================================
 158+ 9E80              ; InitEntities - Inicializa la tabla de entidades
 159+ 9E80              ; ==============================================================================
 160+ 9E80              ; Limpia todos los slots y configura el slot 0 como player.
 161+ 9E80              ; ==============================================================================
 162+ 9E80              InitEntities:
 163+ 9E80                  ; Limpiar toda la tabla a ceros
 164+ 9E80 21 9E 81         LD HL, EntityTable
 165+ 9E83 11 9F 81         LD DE, EntityTable + 1
 166+ 9E86 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E89 AF               XOR A
 168+ 9E8A 77               LD (HL), A
 169+ 9E8B ED B0            LDIR
 170+ 9E8D
 171+ 9E8D                  ; Limpiar tabla de atributos salvados
 172+ 9E8D 21 DA 9B         LD HL, SavedAttrTable
 173+ 9E90 11 DB 9B         LD DE, SavedAttrTable + 1
 174+ 9E93 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E96 AF               XOR A
 176+ 9E97 77               LD (HL), A
 177+ 9E98 ED B0            LDIR
 178+ 9E9A
 179+ 9E9A                  ; Configurar slot 0: Player
 180+ 9E9A DD 21 9E 81      LD IX, EntityTable
 181+ 9E9E DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ 9EA2 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ 9EA6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ 9EAA DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 185+ 9EAE DD 36 04 A0      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ 9EB2 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ 9EB6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ 9EBA DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ 9EBE DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ 9EC2 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EC6 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9ECA DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ 9ECE DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ 9ED2 DD 36 0D A0      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ 9ED6 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ 9EDA DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
