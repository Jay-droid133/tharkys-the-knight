 590+ E804              .setAttrs:
 591+ E804                  ; Atributos: bright white en cols 4-9
 592+ E804 3E 47            LD A, $47
 593+ E806 21 04 58         LD HL, ATTR_BASE + 4
 594+ E809 06 06            LD B, 6
 595+ E80B              .attrLoop:
 596+ E80B 77               LD (HL), A
 597+ E80C 23               INC HL
 598+ E80D 10 FC            DJNZ .attrLoop
 599+ E80F C9               RET
 600+ E810
 601+ E810              ; Devuelve HL = puntero a font data del digito en A (0-9)
 602+ E810              ; A se destruye
 603+ E810              .getDigitFont:
 604+ E810 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 605+ E812 6F               LD L, A
 606+ E813 26 00            LD H, 0
 607+ E815 29               ADD HL, HL
 608+ E816 29               ADD HL, HL
 609+ E817 29               ADD HL, HL                          ; HL = indice * 8
 610+ E818 01 66 EA         LD BC, DayHudFont
 611+ E81B 09               ADD HL, BC
 612+ E81C C9               RET
 613+ E81D
 614+ E81D              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 615+ E81D              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 616+ E81D              .drawChar:
 617+ E81D 06 08            LD B, 8
 618+ E81F              .charLoop:
 619+ E81F 7E               LD A, (HL)
 620+ E820 12               LD (DE), A
 621+ E821 23               INC HL
 622+ E822 14               INC D
 623+ E823 10 FA            DJNZ .charLoop
 624+ E825 C9               RET
 625+ E826
 626+ E826              ; Limpia 8 scan lines en VRAM (DE)
 627+ E826              .clearChar:
 628+ E826 06 08            LD B, 8
 629+ E828 AF               XOR A
 630+ E829              .clearLoop:
 631+ E829 12               LD (DE), A
 632+ E82A 14               INC D
 633+ E82B 10 FC            DJNZ .clearLoop
 634+ E82D C9               RET
