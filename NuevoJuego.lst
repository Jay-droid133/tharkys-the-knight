 386+ 9B76                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B76 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B77 E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B79 4F               LD C, A
 390+ 9B7A DD 7E 01         LD A, (IX+1)                ; height_pixels
