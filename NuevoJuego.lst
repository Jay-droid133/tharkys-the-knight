2115+ AAAD              ; ==============================================================================
2116+ AAAD              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2117+ AAAD              ; ==============================================================================
2118+ AAAD              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2119+ AAAD              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2120+ AAAD              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2121+ AAAD              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2122+ AAAD              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2123+ AAAD              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2124+ AAAD              ; ==============================================================================
2125+ AAAD              SelectSwordMode:
2126+ AAAD 3A 56 B3         LD A, (PlayerStamina)
2127+ AAB0 FE 0C            CP STAMINA_THRESHOLD_HIGH
2128+ AAB2 38 04            JR C, .smNotHigh
2129+ AAB4 3E 02            LD A, 2                             ; Libre (continuo)
2130+ AAB6 18 09            JR .smSet
2131+ AAB8              .smNotHigh:
2132+ AAB8 FE 07            CP STAMINA_THRESHOLD_MID
2133+ AABA 38 04            JR C, .smNotMid
2134+ AABC 3E 01            LD A, 1                             ; Fixed swing
2135+ AABE 18 01            JR .smSet
2136+ AAC0              .smNotMid:
2137+ AAC0 AF               XOR A                               ; Cooldown (0)
2138+ AAC1              .smSet:
2139+ AAC1 32 54 B3         LD (SwordMode), A
2140+ AAC4 B7               OR A
2141+ AAC5 C8               RET Z                               ; Mode B → cooldown legítimo, no tocar
2142+ AAC6                  ; Mode C/Free: cooldown sin sentido. Limpiar + reset color si quedó azul.
2143+ AAC6 AF               XOR A
2144+ AAC7 32 51 B3         LD (AttackCooldown), A
2145+ AACA 3A A3 81         LD A, (EntityTable + ENT_ATTR)
2146+ AACD FE 41            CP BLUE | $40
2147+ AACF C0               RET NZ                              ; No estaba azul → nada que hacer
2148+ AAD0 3A F7 C4         LD A, (PlayerHitTimer)
2149+ AAD3 B7               OR A
2150+ AAD4 C0               RET NZ                              ; En flash de daño → no pisar el rojo
2151+ AAD5 3E 47            LD A, WHITE | $40
2152+ AAD7 32 A3 81         LD (EntityTable + ENT_ATTR), A
2153+ AADA C9               RET
2154+ AADB
2155+ AADB              ; ==============================================================================
2156+ AADB              ; GetStaminaColor - Devuelve color del player segun estado actual
2157+ AADB              ; ==============================================================================
2158+ AADB              ; Salida: A = atributo de color (bright)
2159+ AADB              ; ==============================================================================
2160+ AADB              GetStaminaColor:
2161+ AADB 3A 54 B3         LD A, (SwordMode)
