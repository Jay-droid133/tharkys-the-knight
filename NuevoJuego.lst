  69+ DE4F              BCP_WAIT_1              EQU 3
  70+ DE4F              BCP_KNOCKS_2            EQU 4
  71+ DE4F              BCP_WAIT_2              EQU 5
  72+ DE4F              BCP_TURN_TO_CAM         EQU 6
  73+ DE4F              BCP_TURN_TO_DOOR        EQU 7
  74+ DE4F              BCP_KNOCKS_3            EQU 8
  75+ DE4F              BCP_WAIT_3              EQU 9
  76+ DE4F              BCP_PRE_HAND            EQU 10      ; antes BCP_DOOR_OPEN; ahora puerta no se abre
  77+ DE4F              BCP_HAND_IN             EQU 11
  78+ DE4F              BCP_HAND_NO_NO          EQU 12
  79+ DE4F              BCP_HAND_OUT            EQU 13
  80+ DE4F              BCP_KEY_DROP            EQU 14
