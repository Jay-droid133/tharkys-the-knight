 357  80F5 18 1F            JR .afterGameplay
 358  80F7              .bankCutsceneWaitNasties:
 359  80F7                  ; Pre-LOCK wait: deja correr ProcessEnemies + ProcessDeath para que los
 360  80F7                  ; puffs de nasties recien matados se animen. Skip ProcessPlayer (player
 361  80F7                  ; ya snap'd a anchor por StartBankCutscene). Skip pickup collect / bump
 362  80F7                  ; triggers (ya en cutscene, no re-disparar nada).
 363  80F7 CD F3 B8         CALL EraseDeadSprites
 364  80FA CD 3B A3         CALL ProcessEnemies
 365  80FD CD 29 C9         CALL ProcessDeath
 366  8100 CD E9 FB         CALL UpdateBankCutscene     ; tick wait timer; transiciona a LOCK al expirar
 367  8103 18 11            JR .afterGameplay
 368  8105              .townGateCutsceneActive:
 369  8105 CD 15 61         CALL UpdateTownGateCutscene ; Phase machine del cutscene final (M11)
 370  8108 18 0C            JR .afterGameplay
 371  810A              .townGateWaitNasties:
 372  810A                  ; Pre-LOCK wait: deja correr ProcessEnemies para que los puffs de
 373  810A                  ; nasties recien matados se animen. Skip ProcessPlayer (player frozen
 374  810A                  ; en anchor1, ya dibujado en StartTownGateCutscene). Skip pickup
 375  810A                  ; collect/bump triggers (ya en cutscene, no re-disparar nada).
 376  810A CD F3 B8         CALL EraseDeadSprites
 377  810D CD 3B A3         CALL ProcessEnemies
 378  8110 CD 29 C9         CALL ProcessDeath
 379  8113 CD 15 61         CALL UpdateTownGateCutscene ; tick wait timer; transiciona a LOCK al expirar
 380  8116              .afterGameplay:
 381  8116                  ; Skip HUD durante TGP_BLACK / TGP_CREDITS / GameOver
 382  8116 3A DF 82         LD A, (GameOver)
 383  8119 B7               OR A
 384  811A 20 31            JR NZ, .skipHUD
 385  811C 3A C8 82         LD A, (TownGatePhase)
 386  811F FE 0E            CP 14                       ; TGP_BLACK = 14, TGP_CREDITS = 15
 387  8121 30 2A            JR NC, .skipHUD
 388  8123 CD 66 ED         CALL DrawClockHUD           ; Reloj: cara + agujas (HUD fijo, no flicker)
 389  8126 CD 4B DD         CALL DrawKeyHUD             ; Llave actual (slot 3×2 en cols 20-22, rows 22-23)
 390  8129 CD AA DD         CALL DrawLivesHUD           ; Vidas (5 iconos 1×1 en row 1 cols 26-30)
 391  812C CD F8 EF         CALL DrawPlazaClock         ; Reloj de plaza (si existe en esta room)
 392  812F CD A7 EE         CALL DrawHealthStaminaHUD   ; Barras salud/stamina en decoraciones
 393  8132 CD 61 6F         CALL UpdateSpeedBuff        ; Tick buff rayo/caracol; reaplica color player; expira al 0
 394  8135 CD 27 6F         CALL UpdateMushroomBuff     ; Tick mushroom debuff; gana color sobre speed buffs
 395  8138 CD 1A E6         CALL DrawSwordModeHUD       ; Debug: indicador modo espada
 396  813B CD 50 E6         CALL DrawNoclipHUD          ; Debug: indicador NoclipMode (N)
 397  813E CD 65 E7         CALL DrawDayCycleHUD        ; Indicador de dia (D1, D2, D3...)
 398  8141 CD EB E7         CALL DrawPlayerSpeedHUD     ; Debug: velocidad player (fila 0, col 2)
 399  8144 CD 31 E8         CALL DrawEnemySpeedHUD      ; Debug: velocidad nasties (V1, V2...)
 400  8147 CD FB E7         CALL DrawZoneCountHUD       ; Debug: ZoneCellCount en hex (cols 11-12)
 401  814A CD 2D F2         CALL DrawCompass            ; Brujula del hito actual (cols 23-24, rows 0-1)
 402  814D              .skipHUD:
 403  814D                  ; === Updates + debug: pausados durante cualquier cutscene ===
 404  814D 3A C6 82         LD A, (ChurchCutscenePhase)
 405  8150 B7               OR A
 406  8151 20 2D            JR NZ, .skipUpdates
 407  8153 3A C8 82         LD A, (TownGatePhase)
 408  8156 B7               OR A
 409  8157 20 27            JR NZ, .skipUpdates
 410  8159 3A C9 82         LD A, (BankCutscenePhase)
 411  815C B7               OR A
 412  815D 20 21            JR NZ, .skipUpdates
 413  815F CD 4B AE         CALL UpdateWellCooldown     ; Tick cooldown del pozo + repintar blanco si activo
 414  8162 CD 07 ED         CALL UpdateGameClock        ; Avanzar reloj de juego
 415  8165 CD 8B BC         CALL UpdateEnemySpeed       ; Ajustar velocidad nasties segun ciclo
 416  8168 CD A3 FA         CALL UpdateBellChimes       ; Campanadas de medianoche (si activas)
 417  816B CD D4 FA         CALL UpdateBellsDoneTimer   ; Cadena post-campanadas: ventanas off → monster spawn
 418  816E CD DF F4         CALL UpdateStatueBlink      ; Parpadeo ON-OFF de la estatua que se enciende
 419  8171 CD 7F 9B         CALL AY_UpdateBell          ; Decay manual del volumen de la campana
 420  8174 CD 8F B8         CALL UpdateScareTimer       ; Countdown pausa+huida (bells/dawn)
 421  8177 CD 99 E5         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
 422  817A CD 3A F1         CALL CheckMilestoneDebugKey ; Tecla M: skip de hito (debug)
 423  817D CD 68 F1         CALL CheckCurrentKeyCycleKey ; Tecla K: cicla CurrentKey 0..6 (debug)
 424  8180              .skipUpdates:
