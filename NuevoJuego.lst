 490+ DFAB              ; --- Helpers ---
 491+ DFAB              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 492+ DFAB              .drawDec2:
 493+ DFAB 4B               LD C, E                     ; guardar columna inicial
 494+ DFAC 06 00            LD B, 0                     ; decenas
 495+ DFAE              .divLoop:
 496+ DFAE FE 0A            CP 10
 497+ DFB0 38 05            JR C, .divDone
 498+ DFB2 D6 0A            SUB 10
 499+ DFB4 04               INC B
 500+ DFB5 18 F7            JR .divLoop
 501+ DFB7              .divDone:
 502+ DFB7                  ; B = decenas, A = unidades
 503+ DFB7 F5               PUSH AF                     ; guardar unidades
 504+ DFB8 78               LD A, B
 505+ DFB9 C6 30            ADD A, '0'
 506+ DFBB 59               LD E, C
 507+ DFBC C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 508+ DFBD CD F3 E0         CALL DrawHudChar
 509+ DFC0 C1               POP BC                      ; restaurar C
 510+ DFC1 F1               POP AF
 511+ DFC2 C6 30            ADD A, '0'
