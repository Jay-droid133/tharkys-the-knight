 328+ F239 23               INC HL                              ; -> ptr_lo
 329+ F23A 7E               LD A, (HL)
 330+ F23B BB               CP E
 331+ F23C 20 0C            JR NZ, .fpsNoMatch
 332+ F23E 23               INC HL                              ; -> ptr_hi
 333+ F23F 7E               LD A, (HL)
