 180+ EC42              ; ==============================================================================
 181+ EC42              ; SetClockToPhaseHour
 182+ EC42              ; ==============================================================================
 183+ EC42              SetClockToPhaseHour:
 184+ EC42 21 61 EA         LD HL, PhaseStartHour
 185+ EC45 4F               LD C, A
 186+ EC46 06 00            LD B, 0
 187+ EC48 09               ADD HL, BC
 188+ EC49 7E               LD A, (HL)
 189+ EC4A 32 5E EA         LD (GameHours), A
 190+ EC4D AF               XOR A
 191+ EC4E 32 5D EA         LD (GameMinutes), A
 192+ EC51 32 5C EA         LD (GameSubMinute), A
 193+ EC54 C9               RET
