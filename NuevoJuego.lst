 558+ EB03 3A 24 EB         LD A, (.dcAttr)
 559+ EB06 CD 48 EB         CALL SetCompassAttrs
 560+ EB09
 561+ EB09                  ; --- Cachear estado ---
 562+ EB09                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 563+ EB09                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 564+ EB09                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 565+ EB09                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 566+ EB09                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 567+ EB09                  ; el wobble y la comparacion sigue siendo correcta.
 568+ EB09 3A 35 82         LD A, (CompassWobbleCounter)
 569+ EB0C B7               OR A
 570+ EB0D 20 06            JR NZ, .dcSkipPrevDistSave
 571+ EB0F 3A 23 EB         LD A, (.dcDistance)
 572+ EB12 32 32 82         LD (PreviousObjectiveDistance), A
 573+ EB15              .dcSkipPrevDistSave:
 574+ EB15 3A 55 82         LD A, (CurrentScreenX)
 575+ EB18 32 33 82         LD (LastCompassScreenX), A
 576+ EB1B 3A 56 82         LD A, (CurrentScreenY)
 577+ EB1E 32 34 82         LD (LastCompassScreenY), A
 578+ EB21 C9               RET
