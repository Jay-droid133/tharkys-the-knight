7019+ C616              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
7020+ C616              UpdateDeathTimer:
7021+ C616                  IF DEBUG_NO_ENEMIES
7022+ C616 ~                RET
7023+ C616                  ENDIF
7024+ C616 3A FD 82         LD A, (DeathSpawned)
7025+ C619 B7               OR A
7026+ C61A C0               RET NZ                              ; ya spawneada: nada que hacer
7027+ C61B                  ; Inhibida en esta sala (puerta de iglesia abierta -> cinematica de
7028+ C61B                  ; captura corre sin interferencia). Se limpia al cambiar de sala.
7029+ C61B 3A FC 82         LD A, (DeathInhibitInRoom)
7030+ C61E B7               OR A
7031+ C61F C0               RET NZ
7032+ C620                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
7033+ C620                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
7034+ C620                  ; arranca de cero al recuperar el control (urb1LastBeat).
7035+ C620 3A EA 82         LD A, (DeathBorderPhase)
7036+ C623 B7               OR A
7037+ C624 C0               RET NZ
7038+ C625 3A EE 82         LD A, (PlayerRespawnPhase)
7039+ C628 FE 01            CP 1
7040+ C62A C8               RET Z
7041+ C62B                  ; Death aparece normalmente desde medianoche en adelante, en cualquier
7042+ C62B                  ; sala. NO bloqueamos por MonstersActive — eso era confundir "monsters
7043+ C62B                  ; activos en general" con "fase del cutscene de trampa de iglesia",
7044+ C62B                  ; cosas distintas. Si el player esta en cutscene de iglesia su input
7045+ C62B                  ; ya esta congelado, asi que Death no presiona ahi tampoco.
7046+ C62B 2A FA 82         LD HL, (DeathScreenTimer)
7047+ C62E 11 96 00         LD DE, DEATH_SPAWN_FRAMES
7048+ C631 E5               PUSH HL
7049+ C632 B7               OR A
7050+ C633 ED 52            SBC HL, DE
7051+ C635 E1               POP HL
7052+ C636 30 0D            JR NC, .udtTrySpawn                 ; HL >= threshold (caso reintento)
7053+ C638 23               INC HL
7054+ C639 22 FA 82         LD (DeathScreenTimer), HL
7055+ C63C E5               PUSH HL
7056+ C63D 11 96 00         LD DE, DEATH_SPAWN_FRAMES
7057+ C640 B7               OR A
7058+ C641 ED 52            SBC HL, DE
7059+ C643 E1               POP HL
7060+ C644 D8               RET C                               ; HL < threshold
7061+ C645              .udtTrySpawn:
7062+ C645 C3 B2 C5         JP SpawnDeath
