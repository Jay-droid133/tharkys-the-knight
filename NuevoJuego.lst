4572+ A641 3A 82 80         LD A, (EntityTable + ENT_SPRITEID)
4573+ A644 CD 54 90         CALL GetSpriteDims          ; B=playerW, C=playerH
4574+ A647 78               LD A, B
4575+ A648 32 6F A8         LD (.plW), A
4576+ A64B 79               LD A, C
4577+ A64C 32 70 A8         LD (.plH), A
