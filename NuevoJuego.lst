 480+ EC61              .upcc_applyEspada:
 481+ EC61 3E 42            LD A, ESPADA_BUFF_ATTR                  ; $42 red bright
 482+ EC63 18 17            JR .upcc_writeAttr
 483+ EC65
 484+ EC65              .upcc_applyEscudo:
