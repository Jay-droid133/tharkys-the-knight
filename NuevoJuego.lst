 58   810B                  INCLUDE "engine_graphics.asm"
# file opened: engine_graphics.asm
  1+  810B              ; ==============================================================================
  2+  810B              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
  3+  810B              ; ==============================================================================
  4+  810B              ; Sistema fiel a Sabre Wulf:
  5+  810B              ; - Sprites de tamanyo variable (width+height en cabecera)
  6+  810B              ; - XOR para draw/erase (dibujar dos veces = borrar)
  7+  810B              ; - NextPixelLine para cruzar character rows y tercios
  8+  810B              ; - Atributos dinamicos segun tamanyo del sprite
  9+  810B              ; ==============================================================================
 10+  810B
 11+  810B              ClearScreen:
 12+  810B CD AF 0D         CALL ROM_CLS
 13+  810E C9               RET
 14+  810F
 15+  810F              ; ==============================================================================
 16+  810F              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
 17+  810F              ; ==============================================================================
 18+  810F              ; Entrada:
 19+  810F              ;   D = Y pixel (cualquier valor, no requiere alineacion)
 20+  810F              ;   E = X pixel (cualquier valor, no requiere alineacion)
 21+  810F              ;   IX = puntero a datos del sprite (con cabecera width, height)
 22+  810F              ;
 23+  810F              ; Formato del sprite:
 24+  810F              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
 25+  810F              ;   DEFB height_pixels
 26+  810F              ;   DEFB pixel_data... (width * height bytes)
 27+  810F              ;
 28+  810F              ; Dos paths:
 29+  810F              ;   - Alineado (X%8==0): XOR directo, sin tablas
 30+  810F              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
 31+  810F              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
 32+  810F              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
 33+  810F              ;
 34+  810F              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
 35+  810F              ; ==============================================================================
 36+  810F              DrawSprite:
 37+  810F                  ; Guardar posicion
 38+  810F 7A               LD A, D
 39+  8110 32 92 81         LD (.posY), A
 40+  8113 7B               LD A, E
 41+  8114 32 91 81         LD (.posX), A
 42+  8117
 43+  8117                  ; Leer cabecera sprite
 44+  8117 DD 7E 00         LD A, (IX+0)                ; width_bytes
 45+  811A 32 93 81         LD (.widthSave), A
 46+  811D DD 7E 01         LD A, (IX+1)                ; height_pixels
 47+  8120 32 94 81         LD (.heightSave), A
 48+  8123 DD 23            INC IX
 49+  8125 DD 23            INC IX                      ; IX → pixel data
 50+  8127
 51+  8127                  ; Comprobar alineacion
 52+  8127 7B               LD A, E
 53+  8128 E6 07            AND 7
 54+  812A 20 1E            JR NZ, .shifted
 55+  812C
 56+  812C                  ; ==================================================================
 57+  812C                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 58+  812C                  ; ==================================================================
 59+  812C CD 53 82         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 60+  812F 3A 94 81         LD A, (.heightSave)
 61+  8132 4F               LD C, A                     ; C = height counter
 62+  8133
 63+  8133              .alignedLine:
 64+  8133 3A 93 81         LD A, (.widthSave)
 65+  8136 47               LD B, A                     ; B = ancho en bytes
 66+  8137 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 67+  8138
 68+  8138              .alignedByte:
 69+  8138 DD 7E 00         LD A, (IX+0)
 70+  813B AE               XOR (HL)
 71+  813C 77               LD (HL), A
 72+  813D 23               INC HL                      ; Siguiente columna VRAM
 73+  813E DD 23            INC IX                      ; Siguiente byte de sprite
 74+  8140 10 F6            DJNZ .alignedByte
 75+  8142
 76+  8142 E1               POP HL                      ; Restaurar inicio de linea
 77+  8143 0D               DEC C
 78+  8144 C8               RET Z                       ; Terminamos todas las lineas
 79+  8145 CD 97 81         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 80+  8148 18 E9            JR .alignedLine
 81+  814A
 82+  814A                  ; ==================================================================
 83+  814A                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 84+  814A                  ; ==================================================================
 85+  814A                  ; A = shift amount (1-7) al llegar aqui
 86+  814A              .shifted:
 87+  814A                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 88+  814A 3D               DEC A                       ; 0-6
 89+  814B 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 90+  814C E6 0E            AND $0E
 91+  814E F6 90            OR SHIFT_TABLE_BASE         ; Base de tablas
 92+  8150 32 95 81         LD (.tablePage), A
 93+  8153
 94+  8153                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 95+  8153 DD E5            PUSH IX
 96+  8155 D1               POP DE                      ; DE = puntero a pixel data
 97+  8156 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 98+  8157
 99+  8157                  ; Recargar D=Y, E=X para CalcPixelAddr
100+  8157 3A 92 81         LD A, (.posY)
101+  815A 57               LD D, A
102+  815B 3A 91 81         LD A, (.posX)
103+  815E 5F               LD E, A
104+  815F CD 53 82         CALL CalcPixelAddr          ; HL = dir VRAM
105+  8162
106+  8162 D1               POP DE                      ; DE = sprite data ptr restaurado
107+  8163 3A 95 81         LD A, (.tablePage)
108+  8166 47               LD B, A                     ; B = pagina high part
109+  8167
110+  8167              .shiftedLine:
111+  8167 E5               PUSH HL                     ; Guardar inicio de linea
112+  8168 3A 93 81         LD A, (.widthSave)
113+  816B 32 96 81         LD (.widthCount), A
114+  816E
115+  816E              .shiftedByte:
116+  816E                  ; === Inner loop fiel al original ($BA0D) ===
117+  816E 1A               LD A, (DE)                  ; Leer byte de sprite
118+  816F 4F               LD C, A                     ; C = byte value (indice en tabla)
119+  8170 0A               LD A, (BC)                  ; A = byte >> shift (high part)
120+  8171 AE               XOR (HL)                    ; XOR con VRAM
121+  8172 77               LD (HL), A                  ; Escribir
122+  8173 2C               INC L                       ; Siguiente columna VRAM
123+  8174 04               INC B                       ; Pagina overflow
124+  8175 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
125+  8176 AE               XOR (HL)                    ; XOR con VRAM
126+  8177 77               LD (HL), A                  ; Escribir
127+  8178 05               DEC B                       ; Restaurar pagina high
128+  8179 13               INC DE                      ; Siguiente byte de sprite
129+  817A                  ; Siguiente byte de ancho
130+  817A 3A 96 81         LD A, (.widthCount)
131+  817D 3D               DEC A
132+  817E 32 96 81         LD (.widthCount), A
133+  8181 20 EB            JR NZ, .shiftedByte
134+  8183
135+  8183 E1               POP HL                      ; Restaurar inicio de linea
136+  8184 3A 94 81         LD A, (.heightSave)
137+  8187 3D               DEC A
138+  8188 32 94 81         LD (.heightSave), A
139+  818B C8               RET Z                       ; Terminamos todas las lineas
140+  818C CD 97 81         CALL NextPixelLine          ; HL = siguiente linea
141+  818F 18 D6            JR .shiftedLine
142+  8191
143+  8191              ; Variables locales de DrawSprite
144+  8191 00           .posX:       DEFB 0
145+  8192 00           .posY:       DEFB 0
146+  8193 00           .widthSave:  DEFB 0
147+  8194 00           .heightSave: DEFB 0
148+  8195 00           .tablePage:  DEFB 0
149+  8196 00           .widthCount: DEFB 0
