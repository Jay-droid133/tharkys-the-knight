 122  AE23                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ AE23              ; ==============================================================================
   2+ AE23              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ AE23              ; ==============================================================================
   4+ AE23              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ AE23              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ AE23              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ AE23              ; ==============================================================================
   8+ AE23
   9+ AE23              ; ==============================================================================
  10+ AE23              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ AE23              ; ==============================================================================
  12+ AE23              InitScreenSystem:
  13+ AE23 3E 08            LD A, START_SCREEN_X
  14+ AE25 32 C8 81         LD (CurrentScreenX), A
  15+ AE28 3E 08            LD A, START_SCREEN_Y
  16+ AE2A 32 C9 81         LD (CurrentScreenY), A
  17+ AE2D 3E 01            LD A, 1
  18+ AE2F 32 D0 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ AE32 AF               XOR A
  20+ AE33 32 CC 81         LD (ScreenTransition), A
  21+ AE36 CD 3A AE         CALL CalcScreenAddress
  22+ AE39 C9               RET
  23+ AE3A
  24+ AE3A              ; ==============================================================================
  25+ AE3A              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ AE3A              ; ==============================================================================
  27+ AE3A              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ AE3A              ; ==============================================================================
  29+ AE3A              CalcScreenAddress:
  30+ AE3A 3A C9 81         LD A, (CurrentScreenY)
  31+ AE3D 6F               LD L, A
  32+ AE3E 26 00            LD H, 0
  33+ AE40 29               ADD HL, HL                  ; x2
  34+ AE41 29               ADD HL, HL                  ; x4
  35+ AE42 29               ADD HL, HL                  ; x8
  36+ AE43 29               ADD HL, HL                  ; x16
  37+ AE44 3A C8 81         LD A, (CurrentScreenX)
  38+ AE47 5F               LD E, A
  39+ AE48 16 00            LD D, 0
  40+ AE4A 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ AE4B 11 98 B6         LD DE, MapTable
  42+ AE4E 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ AE4F 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ AE50                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ AE50 6F               LD L, A
  46+ AE51 26 00            LD H, 0
  47+ AE53 29               ADD HL, HL                  ; index * 2
  48+ AE54 11 38 B6         LD DE, RoomTable
  49+ AE57 19               ADD HL, DE
  50+ AE58 5E               LD E, (HL)
  51+ AE59 23               INC HL
  52+ AE5A 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ AE5B                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ AE5B EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ AE5C CD FE 8C         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ AE5F                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ AE5F 11 93 84         LD DE, CurrentScreenBuffer
  58+ AE62 ED 53 CA 81      LD (CurrentScreenAddr), DE
  59+ AE66 C9               RET
  60+ AE67
  61+ AE67              ; ==============================================================================
  62+ AE67              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ AE67              ; ==============================================================================
  64+ AE67              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ AE67              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ AE67              ; por estar atrapado cerca del borde.
  67+ AE67              ; ==============================================================================
  68+ AE67              CheckScreenTransition:
  69+ AE67 AF               XOR A
  70+ AE68 32 CC 81         LD (ScreenTransition), A
  71+ AE6B
  72+ AE6B 3A AE 81         LD A, (InputDirection)
  73+ AE6E 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
  74+ AE6F
  75+ AE6F                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
  76+ AE6F CB 5A            BIT 3, D                    ; W
  77+ AE71 CA BF AE         JP Z, .noWest
  78+ AE74 3A A1 80         LD A, (EntityTable + ENT_POSX)
  79+ AE77 FE 04            CP TRANSITION_ZONE
  80+ AE79 D2 BF AE         JP NC, .noWest
  81+ AE7C 3A C8 81         LD A, (CurrentScreenX)
  82+ AE7F B7               OR A
  83+ AE80 CA BF AE         JP Z, .noWest
  84+ AE83                  ; Check collision at col 0 (top + mid + bottom del player)
  85+ AE83 06 00            LD B, 0
  86+ AE85 3A A2 80         LD A, (EntityTable + ENT_POSY)
  87+ AE88 4F               LD C, A
  88+ AE89 CD 67 B4         CALL IsPointBlocked
  89+ AE8C C2 BF AE         JP NZ, .noWest
  90+ AE8F 06 00            LD B, 0
  91+ AE91 3A A2 80         LD A, (EntityTable + ENT_POSY)
  92+ AE94 C6 0A            ADD A, 10
  93+ AE96 4F               LD C, A
  94+ AE97 CD 67 B4         CALL IsPointBlocked
  95+ AE9A C2 BF AE         JP NZ, .noWest
  96+ AE9D 06 00            LD B, 0
  97+ AE9F 3A A2 80         LD A, (EntityTable + ENT_POSY)
  98+ AEA2 C6 14            ADD A, 20
  99+ AEA4 4F               LD C, A
 100+ AEA5 CD 67 B4         CALL IsPointBlocked
 101+ AEA8 C2 BF AE         JP NZ, .noWest
 102+ AEAB 3A C8 81         LD A, (CurrentScreenX)
 103+ AEAE 3D               DEC A
 104+ AEAF 32 C8 81         LD (CurrentScreenX), A
 105+ AEB2 3E 08            LD A, DIR_W
 106+ AEB4 32 CC 81         LD (ScreenTransition), A
 107+ AEB7 3E E8            LD A, SCREEN_MAX_X
 108+ AEB9 32 A1 80         LD (EntityTable + ENT_POSX), A
 109+ AEBC C3 B1 AF         JP .doTransition
 110+ AEBF
 111+ AEBF              .noWest:
 112+ AEBF                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 113+ AEBF CB 52            BIT 2, D                    ; E
 114+ AEC1 CA 10 AF         JP Z, .noEast
 115+ AEC4 3A A1 80         LD A, (EntityTable + ENT_POSX)
 116+ AEC7 FE E8            CP SCREEN_MAX_X
 117+ AEC9 DA 10 AF         JP C, .noEast
 118+ AECC 3A C8 81         LD A, (CurrentScreenX)
 119+ AECF FE 0F            CP MAP_WIDTH - 1
 120+ AED1 CA 10 AF         JP Z, .noEast
 121+ AED4                  ; Check collision at col 31 (top + mid + bottom del player)
 122+ AED4 06 F8            LD B, 248
