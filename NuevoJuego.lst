 198+ A1C1                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ A1C1 3E 0C            LD A, SPAWN_INTERVAL
 200+ A1C3 32 F5 82         LD (SpawnTimer), A
 201+ A1C6 AF               XOR A
 202+ A1C7 32 02 83         LD (EnemyStepIdx), A
 203+ A1CA 32 7B 5F         LD (PendingEraseCount), A
 204+ A1CD C9               RET
