1329+ F0DA              ; ==============================================================================
1330+ F0DA              ; Variantes random de health/stamina pickup
1331+ F0DA              ; ==============================================================================
1332+ F0DA              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
1333+ F0DA              ; eligen una variante visual al azar. Asi el random pickup tiene mas
1334+ F0DA              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
1335+ F0DA              ; variante — solo cambia el sprite que se ve.
1336+ F0DA              ;
1337+ F0DA              ; Formato tabla: DEFB count, ids... (1 byte por id)
1338+ F0DA              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
1339+ F0DA              ; ==============================================================================
1340+ F0DA              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
1341+ F0DA              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
1342+ F0DA              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
1343+ F0DA              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
1344+ F0DA              ; raw, asi que usamos esos labels directamente.
1345+ F0DA              HealthVariantPtrs:
1346+ F0DA 05               DEFB 5                              ; 5 variantes (1 byte count)
1347+ F0DB 5D EA            DEFW BgGfx_health_pickup            ; canonical (id 254, pan)
1348+ F0DD 66 F5            DEFW BgGfx_health_pickup_72         ; variant id 72 (queso)
1349+ F0DF B8 F5            DEFW BgGfx_health_pickup_3          ; variant id 74 (chorizo)
1350+ F0E1 E1 F5            DEFW BgGfx_health_pickup_4          ; variant id 75 (leche)
1351+ F0E3 88 F7            DEFW BgGfx_health_pickup_5          ; variant id 85 (pollo)
1352+ F0E5
1353+ F0E5              StaminaVariantPtrs:
1354+ F0E5 04               DEFB 4                              ; 4 variantes
1355+ F0E6 86 EA            DEFW BgGfx_stamina_pickup           ; canonical (id 255, jarra de vino)
1356+ F0E8 8F F5            DEFW BgGfx_stamina_pickup_2         ; variant id 73 (taza de cafe)
1357+ F0EA B1 F7            DEFW BgGfx_stamina_pickup_3         ; variant id 79 (pocion)
1358+ F0EC DA F7            DEFW BgGfx_stamina_pickup_4         ; variant id 84 (copa de brandy)
1359+ F0EE
1360+ F0EE              ; ==============================================================================
1361+ F0EE              ; PickRandomVariantPtr / LookupVariantPtrByIdx
1362+ F0EE              ; ==============================================================================
1363+ F0EE              ; PickRandomVariantPtr: elige variante random Y la persiste en RP_TmpVariant.
1364+ F0EE              ;   IN:  HL = ptr a tabla "DEFB count, DEFW ptr1, DEFW ptr2, ..."
1365+ F0EE              ;   OUT: HL = sprite ptr de la variante elegida.
1366+ F0EE              ;   Side: RP_TmpVariant ← idx elegido (0..count-1), para que la cache pueda
1367+ F0EE              ;         rotarlo y reusarlo al revisitar la sala.
1368+ F0EE              ;
1369+ F0EE              ; LookupVariantPtrByIdx: lookup directo SIN random (para cache hit que ya tiene
1370+ F0EE              ;                       el idx que quiere reusar).
1371+ F0EE              ;   IN:  HL = ptr a tabla, A = idx (0..count-1)
1372+ F0EE              ;   OUT: HL = sprite ptr de la variante[idx].
1373+ F0EE              ;   Side: ninguno (NO toca RP_TmpVariant — el caller lo gestiona).
1374+ F0EE              ;
1375+ F0EE              ; Destruye: AF, BC, DE (ambas rutinas).
1376+ F0EE              ; ==============================================================================
1377+ F0EE              PickRandomVariantPtr:
1378+ F0EE 7E               LD A, (HL)                          ; A = count
1379+ F0EF 47               LD B, A
1380+ F0F0 ED 5F            LD A, R
1381+ F0F2              .pvpModLoop:
1382+ F0F2 90               SUB B
1383+ F0F3 30 FD            JR NC, .pvpModLoop
1384+ F0F5 80               ADD A, B                            ; A = R mod count (0..count-1)
1385+ F0F6 32 D8 5F         LD (RP_TmpVariant), A               ; persistir para cache rotation
1386+ F0F9                  ; fall through a LookupVariantPtrByIdx (HL aun apunta al count byte, A = idx)
1387+ F0F9              LookupVariantPtrByIdx:
1388+ F0F9 23               INC HL                              ; HL @ first DEFW
1389+ F0FA 87               ADD A, A                            ; idx*2 (DEFW = 2 B)
1390+ F0FB 5F               LD E, A
1391+ F0FC 16 00            LD D, 0
1392+ F0FE 19               ADD HL, DE                          ; HL @ entry elegida
1393+ F0FF 7E               LD A, (HL)
1394+ F100 23               INC HL
1395+ F101 66               LD H, (HL)
1396+ F102 6F               LD L, A                             ; HL = sprite ptr
1397+ F103 C9               RET
1398+ F104
