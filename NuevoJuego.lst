 301+ E505              ; ==============================================================================
 302+ E505              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E505              ; ==============================================================================
 304+ E505              ; Entrada: A = attr original
 305+ E505              ; Salida:  A = attr transformado
 306+ E505              ; Preserva: HL, DE, BC, IX
 307+ E505              ; ==============================================================================
 308+ E505              ApplyDayCycleRemap:
 309+ E505 E5               PUSH HL
 310+ E506 67               LD H, A                     ; H = attr (temp save)
 311+ E507                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E507 3A A0 E3         LD A, (BgSpriteSkipRemap)
 313+ E50A B7               OR A
 314+ E50B 20 06            JR NZ, .skipRemap
 315+ E50D 3A 9A E3         LD A, (CurrentTimeOfDay)
 316+ E510 B7               OR A
 317+ E511 20 03            JR NZ, .doRemap
 318+ E513              .skipRemap:
 319+ E513 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E514 E1               POP HL
 321+ E515 C9               RET
 322+ E516
 323+ E516              .doRemap:
 324+ E516 D5               PUSH DE
 325+ E517 C5               PUSH BC
 326+ E518
 327+ E518 7C               LD A, H                     ; A = attr original
 328+ E519 4F               LD C, A                     ; C = attr original
 329+ E51A
 330+ E51A                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E51A E6 87            AND $87                     ; A = F000_0III
 332+ E51C 47               LD B, A                     ; B = flash | ink
 333+ E51D
 334+ E51D                  ; Extraer paper+bright como indice 0-15
 335+ E51D 79               LD A, C
 336+ E51E E6 78            AND $78                     ; A = 0BPPP000
 337+ E520 0F               RRCA
 338+ E521 0F               RRCA
 339+ E522 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E523
 341+ E523                  ; Elegir tabla segun tipo de sprite
 342+ E523 5F               LD E, A
 343+ E524 16 00            LD D, 0
 344+ E526 3A 9F E3         LD A, (BgSpriteIsHouse)
 345+ E529 B7               OR A
 346+ E52A 28 05            JR Z, .useStdTable
 347+ E52C 2A 9D E3         LD HL, (CurrentHouseRemapTable)
 348+ E52F 18 03            JR .doLookup
 349+ E531              .useStdTable:
 350+ E531 2A 9B E3         LD HL, (CurrentRemapTable)
 351+ E534              .doLookup:
 352+ E534 19               ADD HL, DE
 353+ E535 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E536
 355+ E536                  ; Reconstruir atributo
 356+ E536 07               RLCA
 357+ E537 07               RLCA
 358+ E538 07               RLCA                        ; A = 0BPPP000
 359+ E539 B0               OR B                        ; A = FBPPPIII
