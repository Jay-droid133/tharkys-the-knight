 379+ EE34              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EE34              ; ==============================================================================
 381+ EE34              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EE34              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EE34              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EE34              ; ==============================================================================
 385+ EE34              DrawHealthStaminaHUD:
 386+ EE34                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EE34 3A 38 B6         LD A, (PlayerHealth)
 388+ EE37 4F               LD C, A                             ; C = nivel (0-16)
 389+ EE38 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EE3B 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EE3E DD 21 1A EA      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EE42 FD 21 8B EA      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EE46 CD BD EE         CALL .drawBar
 394+ EE49
 395+ EE49                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EE49 3A 39 B6         LD A, (PlayerStamina)
 397+ EE4C 4F               LD C, A
 398+ EE4D 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EE50 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EE53 DD 21 1E EA      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EE57 FD 21 8F EA      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EE5B CD BD EE         CALL .drawBar
