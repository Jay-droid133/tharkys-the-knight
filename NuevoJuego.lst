 123+ 6E97 3E 03            LD A, 3
 124+ 6E99 CD BC 6A         CALL LoadBgSpriteToBuffer
 125+ 6E9C DD 21 F5 89      LD IX, BgSpriteBuffer
 126+ 6EA0 CD 1E D6         CALL SkipPixelData                      ; IX @ tintPaper
 127+ 6EA3 DD 23            INC IX                                  ; @ attr_h
 128+ 6EA5 DD 23            INC IX                                  ; @ attr_w
 129+ 6EA7 DD 23            INC IX                                  ; @ attr_data
