5308+ C043 32 74 9C         LD (MaiSpawnY), A
5309+ C046 18 12            JR .rmRtApplyGap
5310+ C048              .rmRtAdjS:
5311+ C048 3A 74 9C         LD A, (MaiSpawnY)
5312+ C04B D6 10            SUB MAI_REENTRY_OFFSET
5313+ C04D 32 74 9C         LD (MaiSpawnY), A
5314+ C050 18 08            JR .rmRtApplyGap
5315+ C052              .rmRtAdjW:
5316+ C052 3A 73 9C         LD A, (MaiSpawnX)
5317+ C055 C6 10            ADD A, MAI_REENTRY_OFFSET
5318+ C057 32 73 9C         LD (MaiSpawnX), A
5319+ C05A              .rmRtApplyGap:
5320+ C05A 3A 73 9C         LD A, (MaiSpawnX)
5321+ C05D DD 77 03         LD (IX+ENT_POSX), A
5322+ C060 3A 74 9C         LD A, (MaiSpawnY)
5323+ C063 DD 77 04         LD (IX+ENT_POSY), A
