 499  CCEA                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCEA              ; ==============================================================================
   2+ CCEA              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCEA              ; ==============================================================================
   4+ CCEA              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCEA              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCEA              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCEA              ; ==============================================================================
   8+ CCEA
   9+ CCEA              ; ==============================================================================
  10+ CCEA              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCEA              ; ==============================================================================
  12+ CCEA              InitScreenSystem:
  13+ CCEA 3E 08            LD A, START_SCREEN_X
  14+ CCEC 32 10 83         LD (CurrentScreenX), A
  15+ CCEF 3E 09            LD A, START_SCREEN_Y
  16+ CCF1 32 11 83         LD (CurrentScreenY), A
  17+ CCF4 3E 01            LD A, 1
  18+ CCF6 32 18 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCF9 AF               XOR A
  20+ CCFA 32 14 83         LD (ScreenTransition), A
  21+ CCFD CD 01 CD         CALL CalcScreenAddress
  22+ CD00 C9               RET
  23+ CD01
  24+ CD01              ; ==============================================================================
  25+ CD01              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CD01              ; ==============================================================================
  27+ CD01              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CD01              ; ==============================================================================
  29+ CD01              CalcScreenAddress:
  30+ CD01 3A 11 83         LD A, (CurrentScreenY)
  31+ CD04 6F               LD L, A
  32+ CD05 26 00            LD H, 0
  33+ CD07 29               ADD HL, HL                  ; x2
  34+ CD08 29               ADD HL, HL                  ; x4
  35+ CD09 29               ADD HL, HL                  ; x8
  36+ CD0A 29               ADD HL, HL                  ; x16
  37+ CD0B 3A 10 83         LD A, (CurrentScreenX)
  38+ CD0E 5F               LD E, A
  39+ CD0F 16 00            LD D, 0
  40+ CD11 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CD12 11 2B DE         LD DE, MapTable
  42+ CD15 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CD16 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CD17                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CD17 6F               LD L, A
  46+ CD18 26 00            LD H, 0
  47+ CD1A 29               ADD HL, HL                  ; index * 2
  48+ CD1B 11 F9 DC         LD DE, RoomTable
  49+ CD1E 19               ADD HL, DE
  50+ CD1F 5E               LD E, (HL)
  51+ CD20 23               INC HL
  52+ CD21 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CD22                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CD22 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CD23 CD 7A 67         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CD26                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CD26 11 FD 85         LD DE, CurrentScreenBuffer
  58+ CD29 ED 53 12 83      LD (CurrentScreenAddr), DE
  59+ CD2D C9               RET
  60+ CD2E
  61+ CD2E              ; ==============================================================================
  62+ CD2E              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CD2E              ; ==============================================================================
  64+ CD2E              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CD2E              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CD2E              ; por estar atrapado cerca del borde.
  67+ CD2E              ; ==============================================================================
  68+ CD2E              CheckScreenTransition:
  69+ CD2E AF               XOR A
  70+ CD2F 32 14 83         LD (ScreenTransition), A
  71+ CD32
  72+ CD32                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CD32                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CD32                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CD32                  ; dispararia transicion sur en plena animacion.
  76+ CD32 3A D0 82         LD A, (TownGatePhase)
  77+ CD35 B7               OR A
  78+ CD36 C0               RET NZ
  79+ CD37
  80+ CD37                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CD37                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CD37                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CD37                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CD37                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CD37                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CD37 3A BB 82         LD A, (TimeFrozen)
  87+ CD3A B7               OR A
  88+ CD3B 28 23            JR Z, .cstNotFrozen
  89+ CD3D 3A B3 82         LD A, (InputDirection)
  90+ CD40 CB 4F            BIT 1, A                    ; S
  91+ CD42 28 17            JR Z, .cstClearBlockFlag
  92+ CD44 3A A7 81         LD A, (EntityTable + ENT_POSY)
  93+ CD47 FE A8            CP SCREEN_MAX_Y
  94+ CD49 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD4B                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD4B 3A BC 82         LD A, (BlockedExitSoundFlag)
  97+ CD4E B7               OR A
  98+ CD4F C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD50 3E 01            LD A, 1
 100+ CD52 32 BC 82         LD (BlockedExitSoundFlag), A
 101+ CD55 21 E6 FA         LD HL, SFX_BlockedExit
 102+ CD58 C3 B9 F9         JP PlaySFX                  ; tail call
 103+ CD5B              .cstClearBlockFlag:
 104+ CD5B AF               XOR A
 105+ CD5C 32 BC 82         LD (BlockedExitSoundFlag), A
 106+ CD5F C9               RET
 107+ CD60              .cstNotFrozen:
 108+ CD60                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD60 AF               XOR A
 110+ CD61 32 BC 82         LD (BlockedExitSoundFlag), A
 111+ CD64
 112+ CD64 3A B3 82         LD A, (InputDirection)
 113+ CD67 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CD68
 115+ CD68                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CD68 CB 5A            BIT 3, D                    ; W
 117+ CD6A CA CB CD         JP Z, .noWest
 118+ CD6D 3A A6 81         LD A, (EntityTable + ENT_POSX)
 119+ CD70 FE 04            CP TRANSITION_ZONE
 120+ CD72 D2 CB CD         JP NC, .noWest
 121+ CD75 3A 10 83         LD A, (CurrentScreenX)
 122+ CD78 B7               OR A
 123+ CD79 CA CB CD         JP Z, .noWest
 124+ CD7C                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CD7C 06 00            LD B, 0
 126+ CD7E 3A A7 81         LD A, (EntityTable + ENT_POSY)
 127+ CD81 4F               LD C, A
 128+ CD82 CD CD D5         CALL IsPointBlocked
 129+ CD85 C2 CB CD         JP NZ, .noWest
 130+ CD88 06 00            LD B, 0
 131+ CD8A 3A A7 81         LD A, (EntityTable + ENT_POSY)
 132+ CD8D C6 0A            ADD A, 10
 133+ CD8F 4F               LD C, A
 134+ CD90 CD CD D5         CALL IsPointBlocked
 135+ CD93 C2 CB CD         JP NZ, .noWest
 136+ CD96 06 00            LD B, 0
 137+ CD98 3A A7 81         LD A, (EntityTable + ENT_POSY)
 138+ CD9B C6 14            ADD A, 20
 139+ CD9D 4F               LD C, A
 140+ CD9E CD CD D5         CALL IsPointBlocked
 141+ CDA1 C2 CB CD         JP NZ, .noWest
 142+ CDA4 3A 10 83         LD A, (CurrentScreenX)
 143+ CDA7 3D               DEC A
 144+ CDA8 32 10 83         LD (CurrentScreenX), A
 145+ CDAB 3E 08            LD A, DIR_W
 146+ CDAD 32 14 83         LD (ScreenTransition), A
 147+ CDB0 3E 03            LD A, 3                             ; entró por E (cruzó W) → side 3 = E
 148+ CDB2 32 CA 5F         LD (LastEntrySide), A
 149+ CDB5                  ; LastEntryCoord = (POSY - 16) / 8 (charY top-left aprox)
 150+ CDB5 3A A7 81         LD A, (EntityTable + ENT_POSY)
 151+ CDB8 D6 10            SUB 16
 152+ CDBA CB 3F            SRL A
 152+ CDBC CB 3F          SRL A
 152+ CDBE CB 3F          SRL A
 153+ CDC0 32 CB 5F         LD (LastEntryCoord), A
 154+ CDC3 3E E8            LD A, SCREEN_MAX_X
 155+ CDC5 32 A6 81         LD (EntityTable + ENT_POSX), A
 156+ CDC8 C3 F2 CE         JP .doTransition
 157+ CDCB
 158+ CDCB              .noWest:
 159+ CDCB                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 160+ CDCB CB 52            BIT 2, D                    ; E
 161+ CDCD CA 2F CE         JP Z, .noEast
 162+ CDD0 3A A6 81         LD A, (EntityTable + ENT_POSX)
 163+ CDD3 FE E8            CP SCREEN_MAX_X
 164+ CDD5 DA 2F CE         JP C, .noEast
 165+ CDD8 3A 10 83         LD A, (CurrentScreenX)
 166+ CDDB FE 0F            CP MAP_WIDTH - 1
 167+ CDDD CA 2F CE         JP Z, .noEast
 168+ CDE0                  ; Check collision at col 31 (top + mid + bottom del player)
 169+ CDE0 06 F8            LD B, 248
 170+ CDE2 3A A7 81         LD A, (EntityTable + ENT_POSY)
 171+ CDE5 4F               LD C, A
 172+ CDE6 CD CD D5         CALL IsPointBlocked
 173+ CDE9 C2 2F CE         JP NZ, .noEast
 174+ CDEC 06 F8            LD B, 248
 175+ CDEE 3A A7 81         LD A, (EntityTable + ENT_POSY)
 176+ CDF1 C6 0A            ADD A, 10
 177+ CDF3 4F               LD C, A
 178+ CDF4 CD CD D5         CALL IsPointBlocked
 179+ CDF7 C2 2F CE         JP NZ, .noEast
 180+ CDFA 06 F8            LD B, 248
 181+ CDFC 3A A7 81         LD A, (EntityTable + ENT_POSY)
 182+ CDFF C6 14            ADD A, 20
 183+ CE01 4F               LD C, A
 184+ CE02 CD CD D5         CALL IsPointBlocked
 185+ CE05 C2 2F CE         JP NZ, .noEast
 186+ CE08 3A 10 83         LD A, (CurrentScreenX)
 187+ CE0B 3C               INC A
 188+ CE0C 32 10 83         LD (CurrentScreenX), A
 189+ CE0F 3E 04            LD A, DIR_E
