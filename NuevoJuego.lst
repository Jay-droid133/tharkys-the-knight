 620  EA77                  ; --- Random pickups body (~1.26 KB, slot 1 -> bank 7 move) ---
 621  EA77                  ; Antes vivia en slot 1 entre $6BF7..$70E4. Movido aqui para liberar slot 1
 622  EA77                  ; (RoomCompGapsTable y la IM2 table compiten por el espacio anterior a $7A00).
 623  EA77                  ; Los 9 entry points externos (UpdateRandomPickup, UpdateRoulette, ...) viven
 624  EA77                  ; como thunks en slot 1 (random_pickups_thunks.asm). El body usa _B7 wrappers
 625  EA77                  ; (LoadBgSpriteToBuffer_B7, DrawBgSpriteXOR_B7, PlaySFX_B7, SkipPixelData_B7,
 626  EA77                  ; RestorePickupAttrs_B7, ApplyMagicCompassBuff_B7) para envolver cada CALL
 627  EA77                  ; externo. Internamente las dispatch tail-JPs (GiveLife etc.) usan los Body
 628  EA77                  ; suffix (intra-bank, no thunk).
 629  EA77                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ EA77              ; ==============================================================================
   2+ EA77              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ EA77              ; ==============================================================================
   4+ EA77              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ EA77              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ EA77              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ EA77              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ EA77              ; correspondiente desde CheckPickupCollect.
   9+ EA77              ;
  10+ EA77              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ EA77              ; si en el futuro se ponen pickups fijos en el editor.
  12+ EA77              ;
  13+ EA77              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ EA77              ; Bank 0/2 quedan limpios.
  15+ EA77              ; ==============================================================================
  16+ EA77
  17+ EA77              ; ==============================================================================
  18+ EA77              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ EA77              ; ==============================================================================
  20+ EA77              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ EA77              ; el cambio via cache .dlhLast.
  22+ EA77              ; ==============================================================================
  23+ EA77              GiveLifeBody:
  24+ EA77 3A E6 82         LD A, (PlayerLives)
  25+ EA7A FE 05            CP PLAYER_LIVES_MAX
  26+ EA7C D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ EA7D 3C               INC A
  28+ EA7E 32 E6 82         LD (PlayerLives), A
  29+ EA81 C9               RET
  30+ EA82
  31+ EA82              ; ==============================================================================
  32+ EA82              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ EA82              ; ==============================================================================
  34+ EA82              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ EA82              ; ==============================================================================
  36+ EA82              GiveHealthBody:
  37+ EA82 3A 89 B3         LD A, (PlayerHealth)
  38+ EA85 C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ EA87 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ EA89 FE 11            CP HEALTH_MAX + 1
  41+ EA8B 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ EA8D              .ghCap:
  43+ EA8D 3E 10            LD A, HEALTH_MAX
  44+ EA8F              .ghStore:
  45+ EA8F 32 89 B3         LD (PlayerHealth), A
  46+ EA92 C9               RET
  47+ EA93
  48+ EA93              ; ==============================================================================
  49+ EA93              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ EA93              ; ==============================================================================
  51+ EA93              GiveStaminaBody:
  52+ EA93 3A 8A B3         LD A, (PlayerStamina)
  53+ EA96 C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ EA98 38 04            JR C, .gsCap
  55+ EA9A FE 11            CP STAMINA_MAX + 1
  56+ EA9C 38 02            JR C, .gsStore
  57+ EA9E              .gsCap:
  58+ EA9E 3E 10            LD A, STAMINA_MAX
  59+ EAA0              .gsStore:
  60+ EAA0 32 8A B3         LD (PlayerStamina), A
  61+ EAA3 C9               RET
