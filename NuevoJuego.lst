   1+ 99E8              ; ==============================================================================
   2+ 99E8              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99E8              ; ==============================================================================
   4+ 99E8              ; Sistema fiel a Sabre Wulf:
   5+ 99E8              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99E8              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99E8              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99E8              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99E8              ; ==============================================================================
  10+ 99E8
  11+ 99E8              ClearScreen:
  12+ 99E8 CD AF 0D         CALL ROM_CLS
  13+ 99EB C9               RET
  14+ 99EC
  15+ 99EC              ; ==============================================================================
  16+ 99EC              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99EC              ; ==============================================================================
  18+ 99EC              ; Entrada:
  19+ 99EC              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99EC              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99EC              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99EC              ;
  23+ 99EC              ; Formato del sprite:
  24+ 99EC              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99EC              ;   DEFB height_pixels
  26+ 99EC              ;   DEFB pixel_data... (width * height bytes)
  27+ 99EC              ;
  28+ 99EC              ; Dos paths:
  29+ 99EC              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99EC              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99EC              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99EC              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99EC              ;
  34+ 99EC              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99EC              ;
  36+ 99EC              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99EC              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99EC              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99EC              ; alto la restauracion del bank.
  40+ 99EC              ; ==============================================================================
  41+ 99EC              DrawSprite:
  42+ 99EC                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99EC                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99EC                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99EC 3A 87 8D         LD A, (CurrentPaging)
  46+ 99EF E6 F8            AND $F8
  47+ 99F1 F6 06            OR 6
  48+ 99F3 32 87 8D         LD (CurrentPaging), A
  49+ 99F6 01 FD 7F         LD BC, $7FFD
  50+ 99F9 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99FB CD 0C 9A         CALL _DrawSpriteImpl
  52+ 99FE                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 99FE                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 99FE 3A 87 8D         LD A, (CurrentPaging)
  55+ 9A01 E6 F8            AND $F8
  56+ 9A03 32 87 8D         LD (CurrentPaging), A
  57+ 9A06 01 FD 7F         LD BC, $7FFD
  58+ 9A09 ED 79            OUT (C), A
  59+ 9A0B C9               RET
  60+ 9A0C
  61+ 9A0C              _DrawSpriteImpl:
  62+ 9A0C                  ; Guardar posicion
  63+ 9A0C 7A               LD A, D
  64+ 9A0D 32 C6 9A         LD (.posY), A
  65+ 9A10 7B               LD A, E
  66+ 9A11 32 C5 9A         LD (.posX), A
  67+ 9A14
  68+ 9A14                  ; Leer cabecera sprite
  69+ 9A14 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A17 32 C7 9A         LD (.widthSave), A
  71+ 9A1A DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A1D 32 C8 9A         LD (.heightSave), A
  73+ 9A20 DD 23            INC IX
  74+ 9A22 DD 23            INC IX                      ; IX → pixel data
  75+ 9A24
  76+ 9A24                  ; === Y CLIPPING ===
  77+ 9A24                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A24 3A C6 9A         LD A, (.posY)
  79+ 9A27 FE 10            CP SCREEN_MIN_Y
  80+ 9A29 30 20            JR NC, .clipTopDone
  81+ 9A2B                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A2B 47               LD B, A                     ; B = Y
  83+ 9A2C 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A2E 90               SUB B                       ; A = filas a saltar
  85+ 9A2F 47               LD B, A                     ; B = skip rows
  86+ 9A30                  ; Reducir altura
  87+ 9A30 3A C8 9A         LD A, (.heightSave)
  88+ 9A33 90               SUB B
  89+ 9A34 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A35 D8               RET C                       ; Idem
  91+ 9A36 32 C8 9A         LD (.heightSave), A
  92+ 9A39                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A39 3A C7 9A         LD A, (.widthSave)
  94+ 9A3C 4F               LD C, A
  95+ 9A3D              .clipSkipRow:
  96+ 9A3D 79               LD A, C
  97+ 9A3E              .clipSkipByte:
  98+ 9A3E DD 23            INC IX
  99+ 9A40 3D               DEC A
 100+ 9A41 20 FB            JR NZ, .clipSkipByte
 101+ 9A43 10 F8            DJNZ .clipSkipRow
 102+ 9A45                  ; Ajustar Y al borde
 103+ 9A45 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A47 32 C6 9A         LD (.posY), A
 105+ 9A4A 57               LD D, A
 106+ 9A4B              .clipTopDone:
 107+ 9A4B                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A4B 3A C6 9A         LD A, (.posY)
 109+ 9A4E 47               LD B, A
 110+ 9A4F 3A C8 9A         LD A, (.heightSave)
 111+ 9A52 80               ADD A, B                    ; A = Y + height
 112+ 9A53 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A55 FE C0            CP 192
 114+ 9A57 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A59              .clipBot:
 116+ 9A59                  ; Reducir altura: new_height = 192 - Y
 117+ 9A59 3E C0            LD A, 192
 118+ 9A5B 90               SUB B                       ; A = 192 - Y
 119+ 9A5C C8               RET Z
 120+ 9A5D D8               RET C
 121+ 9A5E 32 C8 9A         LD (.heightSave), A
 122+ 9A61              .clipBotDone:
 123+ 9A61
 124+ 9A61                  ; Comprobar alineacion
 125+ 9A61 7B               LD A, E
 126+ 9A62 E6 07            AND 7
 127+ 9A64 20 1E            JR NZ, .shifted
 128+ 9A66
 129+ 9A66                  ; ==================================================================
 130+ 9A66                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9A66                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9A66                  ; ==================================================================
 133+ 9A66 CD 5F 9D         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9A69 DD E5            PUSH IX
 135+ 9A6B D1               POP DE                      ; DE = puntero a pixel data
 136+ 9A6C 3A C8 9A         LD A, (.heightSave)
 137+ 9A6F 4F               LD C, A                     ; C = height counter
 138+ 9A70
 139+ 9A70              .alignedLine:
 140+ 9A70 3A C7 9A         LD A, (.widthSave)
 141+ 9A73 47               LD B, A                     ; B = ancho en bytes
 142+ 9A74 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A75
 144+ 9A75              .alignedByte:
 145+ 9A75 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A76 AE               XOR (HL)
 147+ 9A77 77               LD (HL), A
 148+ 9A78 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A79 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A7A 10 F9            DJNZ .alignedByte
 151+ 9A7C
 152+ 9A7C E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A7D 0D               DEC C
 154+ 9A7E C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A7F CD CB 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A82 18 EC            JR .alignedLine
 157+ 9A84
 158+ 9A84                  ; ==================================================================
 159+ 9A84                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A84                  ; ==================================================================
 161+ 9A84                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A84              .shifted:
 163+ 9A84                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A84 3D               DEC A                       ; 0-6
 165+ 9A85 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A86 E6 0E            AND $0E
 167+ 9A88 C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A8A 32 C9 9A         LD (.tablePage), A
 169+ 9A8D
 170+ 9A8D                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A8D DD E5            PUSH IX
 172+ 9A8F D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A90 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A91
 175+ 9A91                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A91 3A C6 9A         LD A, (.posY)
 177+ 9A94 57               LD D, A
 178+ 9A95 3A C5 9A         LD A, (.posX)
 179+ 9A98 5F               LD E, A
 180+ 9A99 CD 5F 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A9C
 182+ 9A9C D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9A9D 3A C9 9A         LD A, (.tablePage)
 184+ 9AA0 47               LD B, A                     ; B = pagina high part
 185+ 9AA1                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9AA1                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9AA1 3A C8 9A         LD A, (.heightSave)
 188+ 9AA4 DD 67            LD IXH, A
 189+ 9AA6
 190+ 9AA6              .shiftedLine:
 191+ 9AA6 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9AA7 3A C7 9A         LD A, (.widthSave)
 193+ 9AAA DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9AAC
 195+ 9AAC              .shiftedByte:
 196+ 9AAC                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AAC 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AAD 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AAE 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AAF AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AB0 77               LD (HL), A                  ; Escribir
 202+ 9AB1 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AB2 04               INC B                       ; Pagina overflow
 204+ 9AB3 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AB4 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AB5 77               LD (HL), A                  ; Escribir
 207+ 9AB6 05               DEC B                       ; Restaurar pagina high
 208+ 9AB7 13               INC DE                      ; Siguiente byte de sprite
 209+ 9AB8                  ; Siguiente byte de ancho
 210+ 9AB8 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9ABA 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9ABC
 213+ 9ABC E1               POP HL                      ; Restaurar inicio de linea
 214+ 9ABD DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9ABF C8               RET Z                       ; Terminamos todas las lineas
 216+ 9AC0 CD CB 9A         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9AC3 18 E1            JR .shiftedLine
