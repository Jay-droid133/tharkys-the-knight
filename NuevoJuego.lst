 158+ 9C9C              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 159+ 9C9C              ; HL = period (12-bit), B = duracion (10ms units).
 160+ 9C9C              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 161+ 9C9C              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 162+ 9C9C              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 163+ 9C9C              ; cambiaramos de bank en slot 3 entre el push y el pop).
 164+ 9C9C              AY_PlayToneBlocking:
 165+ 9C9C F3               DI
 166+ 9C9D                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 167+ 9C9D                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 168+ 9C9D 5C               LD E, H                     ; E = period high
 169+ 9C9E 3E 01            LD A, 1
 170+ 9CA0 01 FD FF         LD BC, $FFFD
 171+ 9CA3 ED 79            OUT (C), A
 172+ 9CA5 01 FD BF         LD BC, $BFFD
 173+ 9CA8 ED 59            OUT (C), E
 174+ 9CAA                  ; R0 = period low
 175+ 9CAA 5D               LD E, L                     ; E = period low
 176+ 9CAB 3E 00            LD A, 0
 177+ 9CAD 01 FD FF         LD BC, $FFFD
 178+ 9CB0 ED 79            OUT (C), A
 179+ 9CB2 01 FD BF         LD BC, $BFFD
 180+ 9CB5 ED 59            OUT (C), E
 181+ 9CB7                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 182+ 9CB7 3E 09            LD A, 9
 183+ 9CB9 01 FD FF         LD BC, $FFFD
 184+ 9CBC ED 79            OUT (C), A
 185+ 9CBE 01 FD BF         LD BC, $BFFD
 186+ 9CC1 AF               XOR A
 187+ 9CC2 ED 79            OUT (C), A
 188+ 9CC4                  ; R10 = 0 (silenciar canal C)
 189+ 9CC4 3E 0A            LD A, 10
 190+ 9CC6 01 FD FF         LD BC, $FFFD
 191+ 9CC9 ED 79            OUT (C), A
 192+ 9CCB 01 FD BF         LD BC, $BFFD
 193+ 9CCE AF               XOR A
 194+ 9CCF ED 79            OUT (C), A
 195+ 9CD1                  ; R7 = $3E (mixer: solo tono A activo)
 196+ 9CD1 3E 07            LD A, 7
 197+ 9CD3 01 FD FF         LD BC, $FFFD
 198+ 9CD6 ED 79            OUT (C), A
 199+ 9CD8 01 FD BF         LD BC, $BFFD
 200+ 9CDB 3E 3E            LD A, $3E
 201+ 9CDD ED 79            OUT (C), A
 202+ 9CDF                  ; R8 = 13 (volumen A alto)
 203+ 9CDF 3E 08            LD A, 8
 204+ 9CE1 01 FD FF         LD BC, $FFFD
 205+ 9CE4 ED 79            OUT (C), A
 206+ 9CE6 01 FD BF         LD BC, $BFFD
 207+ 9CE9 3E 0D            LD A, 13
 208+ 9CEB ED 79            OUT (C), A
