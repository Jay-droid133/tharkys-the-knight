 398+ 8F55              ; ==============================================================================
 399+ 8F55              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 8F55              ; ==============================================================================
 401+ 8F55              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 8F55              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 8F55              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 8F55              ; al room vecino.
 405+ 8F55              ;
 406+ 8F55              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 8F55              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 8F55              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 8F55              ;
 410+ 8F55              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 8F55              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 8F55              ; ==============================================================================
 413+ 8F55              WipeMonsterSlot:
 414+ 8F55 DD E5            PUSH IX
 415+ 8F57 E1               POP HL
 416+ 8F58 11 B0 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 8F5B B7               OR A
 418+ 8F5C ED 52            SBC HL, DE
 419+ 8F5E CB 3D            SRL L
 420+ 8F60 CB 3D            SRL L
 421+ 8F62 CB 3D            SRL L
 422+ 8F64 CB 3D            SRL L                               ; HL = slot * 1
 423+ 8F66 5D               LD E, L
 424+ 8F67 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 8F69
 426+ 8F69 21 98 8D         LD HL, MonsterAiFlags
 427+ 8F6C 19               ADD HL, DE
 428+ 8F6D 36 00            LD (HL), 0
 429+ 8F6F 21 8C 8D         LD HL, MonsterRoomId
 430+ 8F72 19               ADD HL, DE
 431+ 8F73 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 8F75 21 92 8D         LD HL, MonsterEntryBorder
 433+ 8F78 19               ADD HL, DE
 434+ 8F79 36 00            LD (HL), 0
 435+ 8F7B 21 95 8D         LD HL, MonsterExitCoord
 436+ 8F7E 19               ADD HL, DE
 437+ 8F7F 36 00            LD (HL), 0
 438+ 8F81 21 8D B3         LD HL, MonsterReturnTimer
 439+ 8F84 19               ADD HL, DE
 440+ 8F85 36 00            LD (HL), 0
 441+ 8F87 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 8F8A 19               ADD HL, DE
 443+ 8F8B 36 00            LD (HL), 0
 444+ 8F8D 21 9A 5F         LD HL, MonsterShakeOrigY
