5628+ BDAC 32 FA BD         LD (MonsterTypeTable + 2), A
5629+ BDAF 3A FB BD         LD A, (MonsterColorTable)
5630+ BDB2 57               LD D, A
5631+ BDB3 3A FD BD         LD A, (MonsterColorTable + 2)
5632+ BDB6 32 FB BD         LD (MonsterColorTable), A
5633+ BDB9 7A               LD A, D
5634+ BDBA 32 FD BD         LD (MonsterColorTable + 2), A
5635+ BDBD C9               RET
5636+ BDBE              .shSwap01:
5637+ BDBE 3A F8 BD         LD A, (MonsterTypeTable)
5638+ BDC1 57               LD D, A
5639+ BDC2 3A F9 BD         LD A, (MonsterTypeTable + 1)
5640+ BDC5 32 F8 BD         LD (MonsterTypeTable), A
5641+ BDC8 7A               LD A, D
5642+ BDC9 32 F9 BD         LD (MonsterTypeTable + 1), A
5643+ BDCC 3A FB BD         LD A, (MonsterColorTable)
5644+ BDCF 57               LD D, A
5645+ BDD0 3A FC BD         LD A, (MonsterColorTable + 1)
5646+ BDD3 32 FB BD         LD (MonsterColorTable), A
5647+ BDD6 7A               LD A, D
5648+ BDD7 32 FC BD         LD (MonsterColorTable + 1), A
5649+ BDDA C9               RET
5650+ BDDB              .shSwap12:
5651+ BDDB 3A F9 BD         LD A, (MonsterTypeTable + 1)
5652+ BDDE 57               LD D, A
5653+ BDDF 3A FA BD         LD A, (MonsterTypeTable + 2)
5654+ BDE2 32 F9 BD         LD (MonsterTypeTable + 1), A
5655+ BDE5 7A               LD A, D
5656+ BDE6 32 FA BD         LD (MonsterTypeTable + 2), A
5657+ BDE9 3A FC BD         LD A, (MonsterColorTable + 1)
5658+ BDEC 57               LD D, A
5659+ BDED 3A FD BD         LD A, (MonsterColorTable + 2)
5660+ BDF0 32 FC BD         LD (MonsterColorTable + 1), A
5661+ BDF3 7A               LD A, D
5662+ BDF4 32 FD BD         LD (MonsterColorTable + 2), A
5663+ BDF7 C9               RET
