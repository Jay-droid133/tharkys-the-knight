1537+ F71D              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1538+ F71D              ; Indexada por (counter-1) -> 0..8. Valor:
1539+ F71D              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1540+ F71D              ; Con counter inicial 9 y decremento por frame:
1541+ F71D              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1542+ F71D              ;   counter 8 -> phase 7 -> prev
1543+ F71D              ;   counter 7 -> phase 6 -> target
1544+ F71D              ;   counter 6 -> phase 5 -> next
1545+ F71D              ;   counter 5 -> phase 4 -> next2
1546+ F71D              ;   counter 4 -> phase 3 -> prev
1547+ F71D              ;   counter 3 -> phase 2 -> target
1548+ F71D              ;   counter 2 -> phase 1 -> prev
1549+ F71D              ;   counter 1 -> phase 0 -> target (estado final, settle)
1550+ F71D              ; ==============================================================================
1551+ F71D              WobblePhaseTable:
1552+ F71D 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
