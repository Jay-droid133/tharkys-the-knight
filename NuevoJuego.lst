1942+ A9B1 7A               LD A, D
1943+ A9B2 FE 16            CP SPRID_ATTACK_EAST
1944+ A9B4 28 30            JR Z, .pushBackEast
1945+ A9B6 FE 1B            CP SPRID_ATTACK_WEST
1946+ A9B8 20 58            JR NZ, .noPushBack
1947+ A9BA
1948+ A9BA                  ; Attack west: comprobar X-8 en fila superior e inferior → mover +8
1949+ A9BA D5               PUSH DE
1950+ A9BB C5               PUSH BC
1951+ A9BC DD 7E 03         LD A, (IX+ENT_POSX)
1952+ A9BF D6 08            SUB 8
1953+ A9C1 47               LD B, A
1954+ A9C2 DD 7E 04         LD A, (IX+ENT_POSY)
1955+ A9C5 4F               LD C, A
1956+ A9C6 CD CD D5         CALL IsPointBlocked
1957+ A9C9 20 11            JR NZ, .doPushBackWest
1958+ A9CB DD 7E 03         LD A, (IX+ENT_POSX)
1959+ A9CE D6 08            SUB 8
1960+ A9D0 47               LD B, A
1961+ A9D1 DD 7E 04         LD A, (IX+ENT_POSY)
1962+ A9D4 C6 14            ADD A, 20
1963+ A9D6 4F               LD C, A
1964+ A9D7 CD CD D5         CALL IsPointBlocked
1965+ A9DA 28 34            JR Z, .noPushBackPop
1966+ A9DC              .doPushBackWest:
1967+ A9DC DD 7E 03         LD A, (IX+ENT_POSX)
1968+ A9DF C6 08            ADD A, 8
1969+ A9E1 DD 77 03         LD (IX+ENT_POSX), A
1970+ A9E4 18 2A            JR .noPushBackPop
1971+ A9E6
1972+ A9E6                  ; Attack east: comprobar X+23 en fila superior E inferior → mover -8
1973+ A9E6              .pushBackEast:
1974+ A9E6 D5               PUSH DE
1975+ A9E7 C5               PUSH BC
1976+ A9E8 DD 7E 03         LD A, (IX+ENT_POSX)
1977+ A9EB C6 17            ADD A, 23
1978+ A9ED 47               LD B, A
1979+ A9EE DD 7E 04         LD A, (IX+ENT_POSY)
1980+ A9F1 4F               LD C, A
1981+ A9F2 CD CD D5         CALL IsPointBlocked
1982+ A9F5 20 11            JR NZ, .doPushBackEast
1983+ A9F7 DD 7E 03         LD A, (IX+ENT_POSX)
1984+ A9FA C6 17            ADD A, 23
1985+ A9FC 47               LD B, A
1986+ A9FD DD 7E 04         LD A, (IX+ENT_POSY)
1987+ AA00 C6 14            ADD A, 20
1988+ AA02 4F               LD C, A
1989+ AA03 CD CD D5         CALL IsPointBlocked
1990+ AA06 28 08            JR Z, .noPushBackPop
1991+ AA08              .doPushBackEast:
1992+ AA08 DD 7E 03         LD A, (IX+ENT_POSX)
1993+ AA0B D6 08            SUB 8
1994+ AA0D DD 77 03         LD (IX+ENT_POSX), A
1995+ AA10              .noPushBackPop:
1996+ AA10 C1               POP BC
1997+ AA11 D1               POP DE
1998+ AA12              .noPushBack:
1999+ AA12                  ; Si es animacion de ataque → SFX al inicio del primer swing
2000+ AA12 7A               LD A, D
2001+ AA13 FE 16            CP SPRID_ATTACK_EAST
2002+ AA15 28 04            JR Z, .newAnimAttackSfx
2003+ AA17 FE 1B            CP SPRID_ATTACK_WEST
2004+ AA19 20 0F            JR NZ, .newAnimNoSfx
2005+ AA1B              .newAnimAttackSfx:
2006+ AA1B 3E 01            LD A, 1
2007+ AA1D 32 87 B3         LD (AttackSfxPlayed), A         ; Marcar: ya sono este ciclo
2008+ AA20 C5               PUSH BC
2009+ AA21 D5               PUSH DE
2010+ AA22 21 3B FA         LD HL, SFX_Attack
2011+ AA25 CD C5 F9         CALL PlaySFX
2012+ AA28 D1               POP DE
2013+ AA29 C1               POP BC
2014+ AA2A              .newAnimNoSfx:
2015+ AA2A DD 72 08         LD (IX+ENT_ANIMBASE), D
2016+ AA2D DD 72 00         LD (IX+ENT_SPRITEID), D     ; Reset al primer frame
2017+ AA30 DD 71 09         LD (IX+ENT_ANIMTIMER), C
2018+ AA33 C9               RET
2019+ AA34
2020+ AA34              .sameAnim:
2021+ AA34                  ; Decrementar timer
2022+ AA34 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2023+ AA37 C0               RET NZ
2024+ AA38
2025+ AA38                  ; Timer expirado → avanzar frame
2026+ AA38 DD 71 09         LD (IX+ENT_ANIMTIMER), C    ; Reset timer
2027+ AA3B
2028+ AA3B                  ; Paso: si el player esta corriendo, reproducir "tic-tac" alternado
2029+ AA3B DD 7E 02         LD A, (IX+ENT_STATE)
2030+ AA3E FE 01            CP STATE_RUNNING
2031+ AA40 20 17            JR NZ, .noFootstep
2032+ AA42 3A 8D 8D         LD A, (FootstepToggle)
2033+ AA45 EE 01            XOR 1
2034+ AA47 32 8D 8D         LD (FootstepToggle), A
2035+ AA4A C5               PUSH BC
2036+ AA4B D5               PUSH DE
2037+ AA4C 21 31 FA         LD HL, SFX_FootstepTic
2038+ AA4F 20 03            JR NZ, .playStep
2039+ AA51 21 36 FA         LD HL, SFX_FootstepTac
2040+ AA54              .playStep:
2041+ AA54 CD C5 F9         CALL PlaySFX
2042+ AA57 D1               POP DE
2043+ AA58 C1               POP BC
2044+ AA59              .noFootstep:
2045+ AA59
2046+ AA59 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2047+ AA5C 3C               INC A
2048+ AA5D                  ; ¿Fuera de rango?
2049+ AA5D 47               LD B, A                     ; B = nuevo SpriteID
2050+ AA5E 92               SUB D                       ; A = frame relativo (nuevo - animBase)
2051+ AA5F BB               CP E                        ; ¿>= num_frames?
2052+ AA60 38 20            JR C, .frameOk
2053+ AA62 42               LD B, D                     ; Reset al AnimBase
2054+ AA63                  ; Si es animacion de ataque → SFX en wrap (si no sono ya este ciclo)
2055+ AA63 7A               LD A, D
2056+ AA64 FE 16            CP SPRID_ATTACK_EAST
2057+ AA66 28 04            JR Z, .checkWrapSfx
2058+ AA68 FE 1B            CP SPRID_ATTACK_WEST
2059+ AA6A 20 16            JR NZ, .frameOk
2060+ AA6C              .checkWrapSfx:
