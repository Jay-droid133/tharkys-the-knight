 139+ 9E42              .alignedLine:
 140+ 9E42 3A 99 9E         LD A, (.widthSave)
 141+ 9E45 47               LD B, A                     ; B = ancho en bytes
 142+ 9E46 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9E47
 144+ 9E47              .alignedByte:
 145+ 9E47 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9E48 AE               XOR (HL)
 147+ 9E49 77               LD (HL), A
 148+ 9E4A 23               INC HL                      ; Siguiente columna VRAM
 149+ 9E4B 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9E4C 10 F9            DJNZ .alignedByte
 151+ 9E4E
 152+ 9E4E E1               POP HL                      ; Restaurar inicio de linea
 153+ 9E4F 0D               DEC C
 154+ 9E50 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9E51 CD 9D 9E         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9E54 18 EC            JR .alignedLine
 157+ 9E56
 158+ 9E56                  ; ==================================================================
 159+ 9E56                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9E56                  ; ==================================================================
 161+ 9E56                  ; A = shift amount (1-7) al llegar aqui
 162+ 9E56              .shifted:
 163+ 9E56                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9E56 3D               DEC A                       ; 0-6
 165+ 9E57 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9E58 E6 0E            AND $0E
 167+ 9E5A C6 E4            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9E5C 32 9B 9E         LD (.tablePage), A
 169+ 9E5F
 170+ 9E5F                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9E5F DD E5            PUSH IX
 172+ 9E61 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9E62 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9E63
 175+ 9E63                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9E63 3A 98 9E         LD A, (.posY)
 177+ 9E66 57               LD D, A
 178+ 9E67 3A 97 9E         LD A, (.posX)
 179+ 9E6A 5F               LD E, A
 180+ 9E6B CD 31 A1         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9E6E
 182+ 9E6E D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9E6F 3A 9B 9E         LD A, (.tablePage)
 184+ 9E72 47               LD B, A                     ; B = pagina high part
 185+ 9E73                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9E73                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9E73 3A 9A 9E         LD A, (.heightSave)
 188+ 9E76 DD 67            LD IXH, A
 189+ 9E78
 190+ 9E78              .shiftedLine:
 191+ 9E78 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9E79 3A 99 9E         LD A, (.widthSave)
 193+ 9E7C DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9E7E
 195+ 9E7E              .shiftedByte:
 196+ 9E7E                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9E7E 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9E7F 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9E80 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9E81 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9E82 77               LD (HL), A                  ; Escribir
 202+ 9E83 2C               INC L                       ; Siguiente columna VRAM
 203+ 9E84 04               INC B                       ; Pagina overflow
 204+ 9E85 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9E86 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9E87 77               LD (HL), A                  ; Escribir
 207+ 9E88 05               DEC B                       ; Restaurar pagina high
 208+ 9E89 13               INC DE                      ; Siguiente byte de sprite
 209+ 9E8A                  ; Siguiente byte de ancho
 210+ 9E8A DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9E8C 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9E8E
 213+ 9E8E E1               POP HL                      ; Restaurar inicio de linea
 214+ 9E8F DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9E91 C8               RET Z                       ; Terminamos todas las lineas
 216+ 9E92 CD 9D 9E         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9E95 18 E1            JR .shiftedLine
