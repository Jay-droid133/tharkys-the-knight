 602+ ECEE              ; ==============================================================================
 603+ ECEE              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ ECEE              ; ==============================================================================
 605+ ECEE
 606+ ECEE              ; ==============================================================================
 607+ ECEE              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ ECEE              ; ==============================================================================
 609+ ECEE              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ ECEE              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ ECEE              ; ==============================================================================
 612+ ECEE              BuildPlazaScanAddrs:
 613+ ECEE                  ; Calcular pixel coords del top-left de la esfera
 614+ ECEE 3A 61 8D         LD A, (PlazaClockCharY)
 615+ ECF1 07               RLCA
 616+ ECF2 07               RLCA
 617+ ECF3 07               RLCA
 618+ ECF4 57               LD D, A                     ; D = pixelY = charY * 8
 619+ ECF5 3A 60 8D         LD A, (PlazaClockCharX)
 620+ ECF8 07               RLCA
 621+ ECF9 07               RLCA
 622+ ECFA 07               RLCA
 623+ ECFB 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ ECFC CD 5A 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ ECFF
 626+ ECFF DD 21 62 8D      LD IX, PlazaScanAddrs
 627+ ED03 06 10            LD B, 16
 628+ ED05              .buildLoop:
 629+ ED05 DD 75 00         LD (IX+0), L
 630+ ED08 DD 74 01         LD (IX+1), H
 631+ ED0B DD 23            INC IX
 632+ ED0D DD 23            INC IX
 633+ ED0F 05               DEC B
 634+ ED10 C8               RET Z
 635+ ED11 CD C6 9A         CALL NextPixelLine
 636+ ED14 18 EF            JR .buildLoop
 637+ ED16
 638+ ED16              ; ==============================================================================
 639+ ED16              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ ED16              ; ==============================================================================
 641+ ED16              ; Llamar cada frame desde el main loop.
 642+ ED16              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ ED16              ; ==============================================================================
 644+ ED16              DrawPlazaClock:
 645+ ED16 3A 5F 8D         LD A, (PlazaClockActive)
 646+ ED19 B7               OR A
 647+ ED1A C8               RET Z
 648+ ED1B
 649+ ED1B                  ; --- Calcular posicion actual de las agujas ---
 650+ ED1B 3A 8D E8         LD A, (GameHours)
 651+ ED1E FE 0C            CP 12
 652+ ED20 38 02            JR C, .pCalcHourOk
 653+ ED22 D6 0C            SUB 12
 654+ ED24              .pCalcHourOk:
 655+ ED24 57               LD D, A                     ; D = display hour (0-11)
 656+ ED25 3A 8C E8         LD A, (GameMinutes)
 657+ ED28 1E 00            LD E, 0
 658+ ED2A              .pCalcDiv5:
 659+ ED2A FE 05            CP 5
 660+ ED2C 38 05            JR C, .pCalcMinOk
 661+ ED2E D6 05            SUB 5
 662+ ED30 1C               INC E
 663+ ED31 18 F7            JR .pCalcDiv5
 664+ ED33              .pCalcMinOk:
 665+ ED33                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ ED33
 667+ ED33                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ ED33 3A 87 ED         LD A, (PlazaLastHour)
 669+ ED36 BA               CP D
 670+ ED37 20 05            JR NZ, .pNeedsRedraw
 671+ ED39 3A 88 ED         LD A, (PlazaLastMin)
 672+ ED3C BB               CP E
 673+ ED3D C8               RET Z                       ; sin cambio → no redibujar
 674+ ED3E
 675+ ED3E              .pNeedsRedraw:
 676+ ED3E 7A               LD A, D
 677+ ED3F 32 87 ED         LD (PlazaLastHour), A
 678+ ED42 7B               LD A, E
 679+ ED43 32 88 ED         LD (PlazaLastMin), A
 680+ ED46
 681+ ED46                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ ED46                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ ED46 DD 21 35 8A      LD IX, PlazaClockPixels
 684+ ED4A FD 21 62 8D      LD IY, PlazaScanAddrs
 685+ ED4E 06 10            LD B, 16
 686+ ED50              .faceRow:
 687+ ED50 FD 6E 00         LD L, (IY+0)
 688+ ED53 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ ED56 DD 7E 00         LD A, (IX+0)
 690+ ED59 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ ED5A 77               LD (HL), A                  ; byte izquierdo
 692+ ED5B 23               INC HL
 693+ ED5C DD 7E 01         LD A, (IX+1)
 694+ ED5F 2F               CPL
 695+ ED60 77               LD (HL), A                  ; byte derecho
 696+ ED61 DD 23            INC IX
 697+ ED63 DD 23            INC IX
 698+ ED65 FD 23            INC IY
 699+ ED67 FD 23            INC IY
 700+ ED69 10 E5            DJNZ .faceRow
 701+ ED6B
 702+ ED6B                  ; --- Aguja de horas ---
 703+ ED6B 3A 87 ED         LD A, (PlazaLastHour)
 704+ ED6E 21 89 E9         LD HL, HourHandPtrs
 705+ ED71 CD 89 ED         CALL DrawPlazaHandLine
 706+ ED74
 707+ ED74                  ; --- Aguja de minutos ---
 708+ ED74 3A 88 ED         LD A, (PlazaLastMin)
 709+ ED77 21 A5 E8         LD HL, MinHandPtrs
 710+ ED7A CD 89 ED         CALL DrawPlazaHandLine
 711+ ED7D
 712+ ED7D                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ ED7D 21 70 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ ED80 7E               LD A, (HL)
 715+ ED81 23               INC HL
 716+ ED82 66               LD H, (HL)
 717+ ED83 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ ED84 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ ED86 C9               RET
 720+ ED87
 721+ ED87              ; Variables locales reloj plaza
 722+ ED87 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ ED88 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ ED89
 725+ ED89              ; ==============================================================================
 726+ ED89              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ ED89              ; ==============================================================================
 728+ ED89              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ ED89              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ ED89              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ ED89              ; ==============================================================================
 732+ ED89              DrawPlazaHandLine:
 733+ ED89                  ; Indexar en tabla de punteros
 734+ ED89 87               ADD A, A
 735+ ED8A 4F               LD C, A
 736+ ED8B 06 00            LD B, 0
 737+ ED8D 09               ADD HL, BC
 738+ ED8E 7E               LD A, (HL)
 739+ ED8F 23               INC HL
 740+ ED90 66               LD H, (HL)
 741+ ED91 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ ED92
 743+ ED92              .pxLoop:
 744+ ED92 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ ED93 B7               OR A
 746+ ED94 C8               RET Z
 747+ ED95
 748+ ED95                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ ED95 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ ED96 23               INC HL
 751+ ED97 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ ED98 23               INC HL
 753+ ED99 56               LD D, (HL)                  ; D = mask
 754+ ED9A 23               INC HL
 755+ ED9B E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ ED9C
 757+ ED9C                  ; --- Calcular scanLine (0-15) ---
 758+ ED9C 78               LD A, B
 759+ ED9D E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ ED9F CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EDA1 28 02            JR Z, .pxIsTop
 762+ EDA3 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EDA5              .pxIsTop:
 764+ EDA5                  ; A = scanLine (0-15)
 765+ EDA5
 766+ EDA5                  ; --- Calcular colOffset (0 o 1) ---
 767+ EDA5 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EDA6 79               LD A, C
 769+ EDA7 E6 1F            AND $1F                     ; extraer columna
 770+ EDA9 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EDAB 4F               LD C, A                     ; C = colOffset
 772+ EDAC
 773+ EDAC                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EDAC 7B               LD A, E                     ; A = scanLine
 775+ EDAD 87               ADD A, A                    ; *2 (word index)
 776+ EDAE 21 62 8D         LD HL, PlazaScanAddrs
 777+ EDB1 85               ADD A, L
 778+ EDB2 6F               LD L, A
 779+ EDB3 30 01            JR NC, .pxNC
 780+ EDB5 24               INC H
 781+ EDB6              .pxNC:
 782+ EDB6 7E               LD A, (HL)
 783+ EDB7 23               INC HL
 784+ EDB8 66               LD H, (HL)
 785+ EDB9 81               ADD A, C                    ; sumar colOffset
 786+ EDBA 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EDBB
 788+ EDBB                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EDBB 7A               LD A, D
 790+ EDBC 2F               CPL
 791+ EDBD A6               AND (HL)
 792+ EDBE 77               LD (HL), A
 793+ EDBF
 794+ EDBF E1               POP HL                      ; restaurar puntero datos
 795+ EDC0 18 D0            JR .pxLoop
 796+ EDC2
