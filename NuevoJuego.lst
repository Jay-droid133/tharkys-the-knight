 179+ A17D                  ; Configurar slot 0: Player
 180+ A17D DD 21 9B 81      LD IX, EntityTable
 181+ A181 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ A185 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ A189 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ A18D DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 185+ A191 DD 36 04 30      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ A195 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ A199 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ A19D DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ A1A1 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ A1A5 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ A1A9 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ A1AD DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ A1B1 DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ A1B5 DD 36 0D 30      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ A1B9 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ A1BD DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
