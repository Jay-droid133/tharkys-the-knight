5280+ BFA3              .rmRtPickGap:
5281+ BFA3                  ; MaiPickNearestGapOnSide destruye HL y BC (paginacion bank 6, loops
5282+ BFA3                  ; internos). Preservamos HL (ptr a MonsterReturnTimer[slot]) y B
5283+ BFA3                  ; (contador del outer loop) para que .rmRtNext pueda iterar bien.
5284+ BFA3 E5               PUSH HL
5285+ BFA4 C5               PUSH BC
5286+ BFA5 CD 9D 95         CALL MaiPickNearestGapOnSide        ; elige gap del side mas cercano al target
5287+ BFA8 C1               POP BC
5288+ BFA9 E1               POP HL
5289+ BFAA B7               OR A
5290+ BFAB C2 F1 BF         JP NZ, .rmRtFallback
5291+ BFAE                  ; Ajustar MaiSpawnX/Y con MAI_REENTRY_OFFSET hacia dentro. MaiPickRandomGapOnSide
5292+ BFAE                  ; usa MAI_ENTRY_OFFSET (=0) y deja el spawn al borde; aqui lo empujamos 2 chars.
5293+ BFAE 3A A6 9C         LD A, (MaiGapSide)
5294+ BFB1 FE 00            CP MAI_SIDE_N
5295+ BFB3 28 12            JR Z, .rmRtAdjN
5296+ BFB5 FE 01            CP MAI_SIDE_S
5297+ BFB7 28 18            JR Z, .rmRtAdjS
5298+ BFB9 FE 02            CP MAI_SIDE_W
5299+ BFBB 28 1E            JR Z, .rmRtAdjW
5300+ BFBD                  ; side E
5301+ BFBD 3A AB 9C         LD A, (MaiSpawnX)
5302+ BFC0 D6 10            SUB MAI_REENTRY_OFFSET
5303+ BFC2 32 AB 9C         LD (MaiSpawnX), A
5304+ BFC5 18 1C            JR .rmRtApplyGap
5305+ BFC7              .rmRtAdjN:
5306+ BFC7 3A AC 9C         LD A, (MaiSpawnY)
5307+ BFCA C6 10            ADD A, MAI_REENTRY_OFFSET
5308+ BFCC 32 AC 9C         LD (MaiSpawnY), A
5309+ BFCF 18 12            JR .rmRtApplyGap
5310+ BFD1              .rmRtAdjS:
5311+ BFD1 3A AC 9C         LD A, (MaiSpawnY)
5312+ BFD4 D6 10            SUB MAI_REENTRY_OFFSET
5313+ BFD6 32 AC 9C         LD (MaiSpawnY), A
5314+ BFD9 18 08            JR .rmRtApplyGap
5315+ BFDB              .rmRtAdjW:
5316+ BFDB 3A AB 9C         LD A, (MaiSpawnX)
5317+ BFDE C6 10            ADD A, MAI_REENTRY_OFFSET
5318+ BFE0 32 AB 9C         LD (MaiSpawnX), A
5319+ BFE3              .rmRtApplyGap:
5320+ BFE3 3A AB 9C         LD A, (MaiSpawnX)
5321+ BFE6 DD 77 03         LD (IX+ENT_POSX), A
5322+ BFE9 3A AC 9C         LD A, (MaiSpawnY)
5323+ BFEC DD 77 04         LD (IX+ENT_POSY), A
5324+ BFEF 18 0C            JR .rmRtReturnDone
5325+ BFF1              .rmRtFallback:
5326+ BFF1                  ; Sin side valido (raro) o sin gaps en ese side → LastEntryPos
5327+ BFF1 3A 5B 82         LD A, (LastEntryPosX)
5328+ BFF4 DD 77 03         LD (IX+ENT_POSX), A
5329+ BFF7 3A 5C 82         LD A, (LastEntryPosY)
5330+ BFFA DD 77 04         LD (IX+ENT_POSY), A
5331+ BFFD              .rmRtReturnDone:
5332+ BFFD DD 36 0A 01      LD (IX+ENT_DIR), DIR_N                  ; sentinel (!=0 para skip spawn anim)
5333+ C001 AF               XOR A
5334+ C002 32 36 BF         LD (.rmTimer), A
5335+ C005                  ; Memoria de ubicacion: el monster ha vuelto al room actual (Regla 4).
5336+ C005                  ; Actualizar MonsterRoomId[slot] = current para que TryRespawnMonsters
5337+ C005                  ; lo active en este room. slot = HL - MonsterReturnTimer.
5338+ C005 E5               PUSH HL
5339+ C006 C5               PUSH BC
5340+ C007 11 A0 B5         LD DE, MonsterReturnTimer
5341+ C00A B7               OR A
5342+ C00B ED 52            SBC HL, DE                              ; HL = slot (0/1/2)
5343+ C00D 5D               LD E, L
5344+ C00E 16 00            LD D, 0
5345+ C010 CD E3 92         CALL MaiGetCurrentScreenId              ; A = current id, preserva DE
5346+ C013 21 94 90         LD HL, MonsterRoomId
5347+ C016 19               ADD HL, DE
5348+ C017 77               LD (HL), A
5349+ C018 C1               POP BC
5350+ C019 E1               POP HL
5351+ C01A              .rmRtNext:
5352+ C01A 11 10 00         LD DE, ENT_SIZE
