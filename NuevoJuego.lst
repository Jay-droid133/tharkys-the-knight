 485+ F9FA              ; ---- Phase 6: player mirando camara mid-cutscene ----
 486+ F9FA              .bcPhTurnToCam:
 487+ F9FA CD C9 FB         CALL BankCutsceneDecTimer
 488+ F9FD C0               RET NZ
 489+ F9FE                  ; Player vuelve a N (cara puerta).
 490+ F9FE DD 21 9B 81      LD IX, EntityTable
 491+ FA02 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 492+ FA04 DD 77 00         LD (IX+ENT_SPRITEID), A
 493+ FA07 3E 0A            LD A, SPRID_WALK_N
 494+ FA09 DD 77 08         LD (IX+ENT_ANIMBASE), A
 495+ FA0C AF               XOR A
 496+ FA0D DD 77 09         LD (IX+ENT_ANIMTIMER), A
 497+ FA10 CD 9E 63         CALL TownGateRedrawPlayer
 498+ FA13 3E 0A            LD A, BCS_T_TURN_BACK
 499+ FA15 32 CA 82         LD (BankCutsceneTimer), A
 500+ FA18 3E 07            LD A, BCP_TURN_TO_DOOR
 501+ FA1A 32 C9 82         LD (BankCutscenePhase), A
 502+ FA1D C9               RET
 503+ FA1E
 504+ FA1E              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 505+ FA1E              .bcPhTurnToDoor:
 506+ FA1E CD C9 FB         CALL BankCutsceneDecTimer
 507+ FA21 C0               RET NZ
 508+ FA22                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 509+ FA22 CD A0 F8         CALL BankCutsceneSnapToDoor
 510+ FA25 AF               XOR A
 511+ FA26 32 CC 82         LD (BankCutsceneKnockIdx), A
 512+ FA29 3E 01            LD A, 1
 513+ FA2B 32 CF 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 514+ FA2E AF               XOR A
 515+ FA2F 32 CB 82         LD (BankCutsceneSubState), A        ; HIT
 516+ FA32 3E 04            LD A, BCS_T_KNOCK_HIT
 517+ FA34 32 CA 82         LD (BankCutsceneTimer), A
 518+ FA37 CD 68 FB         CALL BankCutsceneEmitKnockHit
 519+ FA3A 3E 08            LD A, BCP_KNOCKS_3
 520+ FA3C 32 C9 82         LD (BankCutscenePhase), A
 521+ FA3F C9               RET
 522+ FA40
 523+ FA40              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 524+ FA40              .bcPhKnocks3:
 525+ FA40 3E 06            LD A, BCS_GROUP3_KNOCKS
 526+ FA42 CD 2D FB         CALL BankCutsceneTickKnockGroup
 527+ FA45 B7               OR A
 528+ FA46 C8               RET Z
 529+ FA47                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 530+ FA47                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 531+ FA47                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 532+ FA47 CD C6 F8         CALL BankCutsceneSnapToRetreat
 533+ FA4A 3E 1E            LD A, BCS_T_PRE_HAND
 534+ FA4C 32 CA 82         LD (BankCutsceneTimer), A
 535+ FA4F 3E 09            LD A, BCP_WAIT_3
 536+ FA51 32 C9 82         LD (BankCutscenePhase), A
 537+ FA54 C9               RET
