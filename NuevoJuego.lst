2158+ AE30              .cwNoOverlap:
2159+ AE30 C9               RET
2160+ AE31
2161+ AE31              ; ==============================================================================
2162+ AE31              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2163+ AE31              ; ==============================================================================
2164+ AE31              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2165+ AE31              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2166+ AE31              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2167+ AE31              ; ==============================================================================
2168+ AE31              StartWellCooldown:
2169+ AE31 CD 5E AE         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2170+ AE34 E5               PUSH HL
2171+ AE35 11 A7 8D         LD DE, CleanAttrMap
2172+ AE38 19               ADD HL, DE
2173+ AE39 7E               LD A, (HL)
2174+ AE3A 32 AF 90         LD (WellOrigAttr0), A
2175+ AE3D 23               INC HL
2176+ AE3E 7E               LD A, (HL)
2177+ AE3F 32 B0 90         LD (WellOrigAttr1), A
2178+ AE42 E1               POP HL
2179+ AE43 CD 78 AE         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2180+ AE46 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2181+ AE49 22 AD 90         LD (WellCooldownTimer), HL
2182+ AE4C C9               RET
2183+ AE4D
2184+ AE4D              ; ==============================================================================
2185+ AE4D              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2186+ AE4D              ; ==============================================================================
2187+ AE4D              ; Solo pinta blanco (no re-captura originals; los almacenados en
2188+ AE4D              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2189+ AE4D              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2190+ AE4D              ; para que el flash de cian dure lo mínimo posible.
2191+ AE4D              ; ==============================================================================
2192+ AE4D              ApplyWellCooldownIfActive:
2193+ AE4D 3A A9 90         LD A, (WellActive)
2194+ AE50 B7               OR A
2195+ AE51 C8               RET Z
2196+ AE52 2A AD 90         LD HL, (WellCooldownTimer)
2197+ AE55 7C               LD A, H
2198+ AE56 B5               OR L
2199+ AE57 C8               RET Z
2200+ AE58 CD 5E AE         CALL GetWellBottomOffset
2201+ AE5B C3 78 AE         JP PaintWellWhiteAt
2202+ AE5E
2203+ AE5E              ; ==============================================================================
2204+ AE5E              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2205+ AE5E              ; ==============================================================================
2206+ AE5E              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2207+ AE5E              ; CleanAttrMap suma CleanAttrMap.
2208+ AE5E              ; Destruye: A, DE
2209+ AE5E              ; ==============================================================================
2210+ AE5E              GetWellBottomOffset:
2211+ AE5E 3A AB 90         LD A, (WellPosY)
2212+ AE61 26 00            LD H, 0
2213+ AE63 6F               LD L, A
2214+ AE64 29               ADD HL, HL
2215+ AE65 29               ADD HL, HL                          ; (pixel_y/8)*32
2216+ AE66 3A AA 90         LD A, (WellPosX)
2217+ AE69 0F               RRCA
2218+ AE6A 0F               RRCA
2219+ AE6B 0F               RRCA
2220+ AE6C E6 1F            AND $1F
2221+ AE6E 85               ADD A, L
2222+ AE6F 6F               LD L, A
2223+ AE70 30 01            JR NC, .gwbNoCarry
2224+ AE72 24               INC H
2225+ AE73              .gwbNoCarry:
2226+ AE73 11 20 00         LD DE, 32
2227+ AE76 19               ADD HL, DE                          ; offset fila inferior
2228+ AE77 C9               RET
2229+ AE78
2230+ AE78              ; ==============================================================================
2231+ AE78              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2232+ AE78              ; ==============================================================================
2233+ AE78              ; IN: HL = offset fila inferior (relativo a attr map)
2234+ AE78              ; ==============================================================================
2235+ AE78              PaintWellWhiteAt:
2236+ AE78 E5               PUSH HL
2237+ AE79                  ; VRAM
2238+ AE79 11 00 58         LD DE, ATTR_BASE
2239+ AE7C 19               ADD HL, DE
2240+ AE7D 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2241+ AE7F 77               LD (HL), A
2242+ AE80 23               INC HL
2243+ AE81 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2244+ AE83 77               LD (HL), A
2245+ AE84 E1               POP HL
2246+ AE85                  ; CleanAttrMap
2247+ AE85 11 A7 8D         LD DE, CleanAttrMap
2248+ AE88 19               ADD HL, DE
2249+ AE89 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2250+ AE8B 77               LD (HL), A
2251+ AE8C 23               INC HL
2252+ AE8D 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2253+ AE8F 77               LD (HL), A
2254+ AE90 C9               RET
2255+ AE91
2256+ AE91              ; ==============================================================================
2257+ AE91              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2258+ AE91              ; ==============================================================================
2259+ AE91              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2260+ AE91              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2261+ AE91              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2262+ AE91              ; ==============================================================================
2263+ AE91              UpdateWellCooldown:
2264+ AE91 2A AD 90         LD HL, (WellCooldownTimer)
2265+ AE94 7C               LD A, H
2266+ AE95 B5               OR L
2267+ AE96 C8               RET Z                               ; 0 → nada que hacer
2268+ AE97 2B               DEC HL
2269+ AE98 22 AD 90         LD (WellCooldownTimer), HL
2270+ AE9B 7C               LD A, H
2271+ AE9C B5               OR L
2272+ AE9D C0               RET NZ                              ; > 0 → esperar
2273+ AE9E                  ; Timer acaba de llegar a 0. Si estamos en la room del pozo, restaurar
2274+ AE9E                  ; attrs originales. Si no, al volver DrawScreen ya dibuja cian normal.
2275+ AE9E 3A A9 90         LD A, (WellActive)
2276+ AEA1 B7               OR A
2277+ AEA2 C8               RET Z
2278+ AEA3 C3 A6 AE         JP RestoreWellOriginalAttrs
2279+ AEA6
2280+ AEA6              ; ==============================================================================
2281+ AEA6              ; RestoreWellOriginalAttrs - escribe WellOrigAttrN a VRAM y CleanAttrMap
2282+ AEA6              ; ==============================================================================
2283+ AEA6              RestoreWellOriginalAttrs:
2284+ AEA6 CD 5E AE         CALL GetWellBottomOffset
2285+ AEA9 E5               PUSH HL
2286+ AEAA                  ; VRAM
2287+ AEAA 11 00 58         LD DE, ATTR_BASE
2288+ AEAD 19               ADD HL, DE
2289+ AEAE 3A AF 90         LD A, (WellOrigAttr0)
2290+ AEB1 77               LD (HL), A
2291+ AEB2 23               INC HL
2292+ AEB3 3A B0 90         LD A, (WellOrigAttr1)
2293+ AEB6 77               LD (HL), A
2294+ AEB7 E1               POP HL
2295+ AEB8                  ; CleanAttrMap
2296+ AEB8 11 A7 8D         LD DE, CleanAttrMap
2297+ AEBB 19               ADD HL, DE
2298+ AEBC 3A AF 90         LD A, (WellOrigAttr0)
2299+ AEBF 77               LD (HL), A
2300+ AEC0 23               INC HL
2301+ AEC1 3A B0 90         LD A, (WellOrigAttr1)
2302+ AEC4 77               LD (HL), A
2303+ AEC5 C9               RET
