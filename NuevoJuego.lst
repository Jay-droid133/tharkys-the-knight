 485+ E4F2                  ; --- Espacio en col 8 ---
 486+ E4F2 3E 20            LD A, ' '
 487+ E4F4 1E 08            LD E, 8
 488+ E4F6 CD 4E E6         CALL DrawHudChar
 489+ E4F9
 490+ E4F9                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E4F9 F1               POP AF                      ; A = room index (descartar)
 492+ E4FA
 493+ E4FA                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E4FA 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E4FD 3E 47            LD A, $47                   ; bright white on black
 496+ E4FF 06 0D            LD B, 13
 497+ E501              .attrLoop:
 498+ E501 77               LD (HL), A
 499+ E502 23               INC HL
 500+ E503 10 FC            DJNZ .attrLoop
