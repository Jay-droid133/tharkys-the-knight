 281+ 914D              ; ==============================================================================
 282+ 914D              ; LoadPlazaClockPixels - Copia los 32 B de pixel data del reloj de plaza a RAM fija
 283+ 914D              ; ==============================================================================
 284+ 914D              ; Se llama una vez al cargar pantalla cuando se detecta BgGfx_reloj_plaza.
 285+ 914D              ; DrawPlazaClock lee PlazaClockPixels cada frame sin tocar paginacion.
 286+ 914D              ; ==============================================================================
 287+ 914D              LoadPlazaClockPixels:
 288+ 914D C5               PUSH BC
 289+ 914E                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 290+ 914E F3               DI
 291+ 914F                  ; Page bank 3 inline
 292+ 914F 3A 42 90         LD A, (CurrentPaging)
 293+ 9152 E6 F8            AND $F8
 294+ 9154 F6 03            OR 3
 295+ 9156 32 42 90         LD (CurrentPaging), A
 296+ 9159 01 FD 7F         LD BC, $7FFD
 297+ 915C ED 79            OUT (C), A
 298+ 915E                  ; Copia 32 bytes (16 rows * 2 bytes) desde BgGfx_reloj_plaza+2
 299+ 915E 21 5E CC         LD HL, BgGfx_reloj_plaza + 2
 300+ 9161 11 F5 8C         LD DE, PlazaClockPixels
 301+ 9164 01 20 00         LD BC, 32
 302+ 9167 ED B0            LDIR
 303+ 9169                  ; Page bank 0 inline
 304+ 9169 3A 42 90         LD A, (CurrentPaging)
 305+ 916C E6 F8            AND $F8
 306+ 916E 32 42 90         LD (CurrentPaging), A
 307+ 9171 01 FD 7F         LD BC, $7FFD
 308+ 9174 ED 79            OUT (C), A
 309+ 9176 3A C6 80         LD A, (StartupComplete)
 310+ 9179 B7               OR A
 311+ 917A 28 01            JR Z, .lpcpNoEI                 ; aun en Inicio -> dejar DI
 312+ 917C FB               EI
 313+ 917D              .lpcpNoEI:
 314+ 917D C1               POP BC
 315+ 917E C9               RET
