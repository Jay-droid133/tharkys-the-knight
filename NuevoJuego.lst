 301+ E391              ; ==============================================================================
 302+ E391              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E391              ; ==============================================================================
 304+ E391              ; Entrada: A = attr original
 305+ E391              ; Salida:  A = attr transformado
 306+ E391              ; Preserva: HL, DE, BC, IX
 307+ E391              ; ==============================================================================
 308+ E391              ApplyDayCycleRemap:
 309+ E391 E5               PUSH HL
 310+ E392 67               LD H, A                     ; H = attr (temp save)
 311+ E393                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E393 3A 2C E2         LD A, (BgSpriteSkipRemap)
 313+ E396 B7               OR A
 314+ E397 20 06            JR NZ, .skipRemap
 315+ E399 3A 26 E2         LD A, (CurrentTimeOfDay)
 316+ E39C B7               OR A
 317+ E39D 20 03            JR NZ, .doRemap
 318+ E39F              .skipRemap:
 319+ E39F 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E3A0 E1               POP HL
 321+ E3A1 C9               RET
 322+ E3A2
 323+ E3A2              .doRemap:
 324+ E3A2 D5               PUSH DE
 325+ E3A3 C5               PUSH BC
 326+ E3A4
 327+ E3A4 7C               LD A, H                     ; A = attr original
 328+ E3A5 4F               LD C, A                     ; C = attr original
 329+ E3A6
 330+ E3A6                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E3A6 E6 87            AND $87                     ; A = F000_0III
 332+ E3A8 47               LD B, A                     ; B = flash | ink
 333+ E3A9
 334+ E3A9                  ; Extraer paper+bright como indice 0-15
 335+ E3A9 79               LD A, C
 336+ E3AA E6 78            AND $78                     ; A = 0BPPP000
 337+ E3AC 0F               RRCA
 338+ E3AD 0F               RRCA
 339+ E3AE 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E3AF
 341+ E3AF                  ; Elegir tabla segun tipo de sprite
 342+ E3AF 5F               LD E, A
 343+ E3B0 16 00            LD D, 0
 344+ E3B2 3A 2B E2         LD A, (BgSpriteIsHouse)
 345+ E3B5 B7               OR A
 346+ E3B6 28 05            JR Z, .useStdTable
 347+ E3B8 2A 29 E2         LD HL, (CurrentHouseRemapTable)
 348+ E3BB 18 03            JR .doLookup
 349+ E3BD              .useStdTable:
 350+ E3BD 2A 27 E2         LD HL, (CurrentRemapTable)
 351+ E3C0              .doLookup:
 352+ E3C0 19               ADD HL, DE
 353+ E3C1 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E3C2
 355+ E3C2                  ; Reconstruir atributo
 356+ E3C2 07               RLCA
 357+ E3C3 07               RLCA
 358+ E3C4 07               RLCA                        ; A = 0BPPP000
 359+ E3C5 B0               OR B                        ; A = FBPPPIII
 360+ E3C6
 361+ E3C6 C1               POP BC
 362+ E3C7 D1               POP DE
 363+ E3C8 E1               POP HL
 364+ E3C9 C9               RET
