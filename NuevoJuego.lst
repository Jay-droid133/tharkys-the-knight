 972+ D4DC              ; ==============================================================================
 973+ D4DC              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 974+ D4DC              ; ==============================================================================
 975+ D4DC              ; Entrada: A = attr byte
 976+ D4DC              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 977+ D4DC              ; Preserva: HL, DE, BC, IX
 978+ D4DC              ; ==============================================================================
 979+ D4DC              ApplyTintSwap:
 980+ D4DC C5               PUSH BC
 981+ D4DD 47               LD B, A                     ; B = attr original
 982+ D4DE 3A D8 D4         LD A, (CurrentTintVar)
 983+ D4E1 FE FF            CP $FF
 984+ D4E3 28 24            JR Z, .tintNoChange
 985+ D4E5 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 986+ D4E6 3A D9 D4         LD A, (CurrentTintPaper)
 987+ D4E9 FE FF            CP $FF
 988+ D4EB 28 1C            JR Z, .tintNoChange
 989+ D4ED                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 990+ D4ED                  ; Extraer paper del attr: bits 5-3
 991+ D4ED 78               LD A, B
 992+ D4EE E6 38            AND $38                     ; A = 00PPP000
 993+ D4F0 0F               RRCA
 994+ D4F1 0F               RRCA
 995+ D4F2 0F               RRCA                        ; A = 00000PPP = paper actual
 996+ D4F3 D5               PUSH DE
 997+ D4F4 57               LD D, A                     ; D = paper actual
 998+ D4F5 3A D9 D4         LD A, (CurrentTintPaper)
 999+ D4F8 BA               CP D                        ; paper actual == tintPaper?
1000+ D4F9 D1               POP DE
1001+ D4FA 20 0D            JR NZ, .tintNoChange
1002+ D4FC                  ; Match: reemplazar paper bits con tintVar
1003+ D4FC 78               LD A, B
1004+ D4FD E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1005+ D4FF D5               PUSH DE
1006+ D500 57               LD D, A
1007+ D501 79               LD A, C                     ; A = tintVar (0-7)
1008+ D502 07               RLCA
1009+ D503 07               RLCA
1010+ D504 07               RLCA                        ; A = 00PPP000
1011+ D505 B2               OR D                        ; A = FBPPPIII
1012+ D506 D1               POP DE
1013+ D507 C1               POP BC
1014+ D508 C9               RET
