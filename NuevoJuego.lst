4853+ B9B9 ED 5F            LD A, R
4854+ B9BB CB 57            BIT 2, A
4855+ B9BD 28 07            JR Z, .dxPos
4856+ B9BF 3A 5A 8D         LD A, (CurrentEnemySpeed)
4857+ B9C2 ED 44            NEG
4858+ B9C4 18 03            JR .setDX
4859+ B9C6              .dxPos:
4860+ B9C6 3A 5A 8D         LD A, (CurrentEnemySpeed)
4861+ B9C9              .setDX:
4862+ B9C9 DD 77 06         LD (IX+ENT_DELTAX), A
4863+ B9CC ED 5F            LD A, R
4864+ B9CE CB 5F            BIT 3, A
4865+ B9D0 28 07            JR Z, .dyPos
4866+ B9D2 3A 5A 8D         LD A, (CurrentEnemySpeed)
4867+ B9D5 ED 44            NEG
4868+ B9D7 18 03            JR .setDY
4869+ B9D9              .dyPos:
