2098+ ADD0              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2099+ ADD0              ; ==============================================================================
2100+ ADD0              CheckWellPickup:
2101+ ADD0 3A A9 90         LD A, (WellActive)
2102+ ADD3 B7               OR A
2103+ ADD4 C8               RET Z                               ; No hay pozo en esta pantalla
2104+ ADD5                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2105+ ADD5 2A AD 90         LD HL, (WellCooldownTimer)
2106+ ADD8 7C               LD A, H
2107+ ADD9 B5               OR L
2108+ ADDA C0               RET NZ                              ; timer > 0 → skip
2109+ ADDB                  ; Ya esta al maximo? No hacer nada
2110+ ADDB 3A 38 B6         LD A, (PlayerHealth)
2111+ ADDE FE 10            CP HEALTH_MAX
2112+ ADE0 20 06            JR NZ, .cwDoCheck
2113+ ADE2 3A 39 B6         LD A, (PlayerStamina)
2114+ ADE5 FE 10            CP STAMINA_MAX
2115+ ADE7 C8               RET Z                               ; Ambos al maximo → nada
2116+ ADE8              .cwDoCheck:
2117+ ADE8                  ; AABB con margen de 8px (1 celda) por cada lado:
2118+ ADE8                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2119+ ADE8                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2120+ ADE8                  ; --- Check X ---
2121+ ADE8 3A AA 90         LD A, (WellPosX)
2122+ ADEB C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2123+ ADED 4F               LD C, A
2124+ ADEE 3A 42 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2125+ ADF1 B9               CP C                                ; playerX < wellRight+margen?
2126+ ADF2 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2127+ ADF4 3A 42 81         LD A, (EntityTable + ENT_POSX)
2128+ ADF7 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2129+ ADF9 4F               LD C, A
2130+ ADFA 3A AA 90         LD A, (WellPosX)                    ; A = wellX
2131+ ADFD B9               CP C                                ; wellX < playerRight+margen?
2132+ ADFE 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2133+ AE00                  ; --- Check Y ---
2134+ AE00 3A AB 90         LD A, (WellPosY)
2135+ AE03 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2136+ AE05 4F               LD C, A
2137+ AE06 3A 43 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2138+ AE09 B9               CP C                                ; playerY < wellBottom+margen?
2139+ AE0A 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2140+ AE0C 3A 43 81         LD A, (EntityTable + ENT_POSY)
2141+ AE0F C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2142+ AE11 4F               LD C, A
2143+ AE12 3A AB 90         LD A, (WellPosY)                    ; A = wellY
2144+ AE15 B9               CP C                                ; wellY < playerBottom+margen?
2145+ AE16 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2146+ AE18                  ; --- Overlap! Recuperar salud y stamina ---
2147+ AE18 3E 10            LD A, HEALTH_MAX
2148+ AE1A 32 38 B6         LD (PlayerHealth), A
2149+ AE1D 3E 10            LD A, STAMINA_MAX
2150+ AE1F 32 39 B6         LD (PlayerStamina), A
