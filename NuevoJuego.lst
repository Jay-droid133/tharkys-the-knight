   4+ 9DBA              ; Sistema fiel a Sabre Wulf:
   5+ 9DBA              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 9DBA              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 9DBA              ; - NextPixelLine para cruzar character rows y tercios
   8+ 9DBA              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 9DBA              ; ==============================================================================
  10+ 9DBA
  11+ 9DBA              ClearScreen:
  12+ 9DBA CD AF 0D         CALL ROM_CLS
  13+ 9DBD C9               RET
  14+ 9DBE
  15+ 9DBE              ; ==============================================================================
  16+ 9DBE              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9DBE              ; ==============================================================================
  18+ 9DBE              ; Entrada:
  19+ 9DBE              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9DBE              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9DBE              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9DBE              ;
  23+ 9DBE              ; Formato del sprite:
  24+ 9DBE              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9DBE              ;   DEFB height_pixels
  26+ 9DBE              ;   DEFB pixel_data... (width * height bytes)
  27+ 9DBE              ;
  28+ 9DBE              ; Dos paths:
  29+ 9DBE              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9DBE              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9DBE              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9DBE              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9DBE              ;
  34+ 9DBE              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9DBE              ;
  36+ 9DBE              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9DBE              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9DBE              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9DBE              ; alto la restauracion del bank.
  40+ 9DBE              ; ==============================================================================
  41+ 9DBE              DrawSprite:
  42+ 9DBE                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9DBE                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9DBE                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9DBE 3A 57 90         LD A, (CurrentPaging)
  46+ 9DC1 E6 F8            AND $F8
  47+ 9DC3 F6 06            OR 6
  48+ 9DC5 32 57 90         LD (CurrentPaging), A
  49+ 9DC8 01 FD 7F         LD BC, $7FFD
  50+ 9DCB ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9DCD CD DE 9D         CALL _DrawSpriteImpl
  52+ 9DD0                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9DD0                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9DD0 3A 57 90         LD A, (CurrentPaging)
  55+ 9DD3 E6 F8            AND $F8
  56+ 9DD5 32 57 90         LD (CurrentPaging), A
  57+ 9DD8 01 FD 7F         LD BC, $7FFD
  58+ 9DDB ED 79            OUT (C), A
  59+ 9DDD C9               RET
  60+ 9DDE
  61+ 9DDE              _DrawSpriteImpl:
  62+ 9DDE                  ; Guardar posicion
  63+ 9DDE 7A               LD A, D
  64+ 9DDF 32 98 9E         LD (.posY), A
  65+ 9DE2 7B               LD A, E
  66+ 9DE3 32 97 9E         LD (.posX), A
  67+ 9DE6
  68+ 9DE6                  ; Leer cabecera sprite
  69+ 9DE6 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9DE9 32 99 9E         LD (.widthSave), A
  71+ 9DEC DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9DEF 32 9A 9E         LD (.heightSave), A
  73+ 9DF2 DD 23            INC IX
  74+ 9DF4 DD 23            INC IX                      ; IX → pixel data
  75+ 9DF6
  76+ 9DF6                  ; === Y CLIPPING ===
  77+ 9DF6                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9DF6 3A 98 9E         LD A, (.posY)
  79+ 9DF9 FE 10            CP SCREEN_MIN_Y
  80+ 9DFB 30 20            JR NC, .clipTopDone
  81+ 9DFD                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9DFD 47               LD B, A                     ; B = Y
  83+ 9DFE 3E 10            LD A, SCREEN_MIN_Y
  84+ 9E00 90               SUB B                       ; A = filas a saltar
  85+ 9E01 47               LD B, A                     ; B = skip rows
  86+ 9E02                  ; Reducir altura
  87+ 9E02 3A 9A 9E         LD A, (.heightSave)
  88+ 9E05 90               SUB B
  89+ 9E06 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9E07 D8               RET C                       ; Idem
  91+ 9E08 32 9A 9E         LD (.heightSave), A
  92+ 9E0B                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9E0B 3A 99 9E         LD A, (.widthSave)
  94+ 9E0E 4F               LD C, A
  95+ 9E0F              .clipSkipRow:
  96+ 9E0F 79               LD A, C
  97+ 9E10              .clipSkipByte:
  98+ 9E10 DD 23            INC IX
  99+ 9E12 3D               DEC A
 100+ 9E13 20 FB            JR NZ, .clipSkipByte
 101+ 9E15 10 F8            DJNZ .clipSkipRow
 102+ 9E17                  ; Ajustar Y al borde
 103+ 9E17 3E 10            LD A, SCREEN_MIN_Y
 104+ 9E19 32 98 9E         LD (.posY), A
 105+ 9E1C 57               LD D, A
 106+ 9E1D              .clipTopDone:
 107+ 9E1D                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9E1D 3A 98 9E         LD A, (.posY)
 109+ 9E20 47               LD B, A
 110+ 9E21 3A 9A 9E         LD A, (.heightSave)
 111+ 9E24 80               ADD A, B                    ; A = Y + height
 112+ 9E25 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9E27 FE C0            CP 192
 114+ 9E29 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9E2B              .clipBot:
 116+ 9E2B                  ; Reducir altura: new_height = 192 - Y
 117+ 9E2B 3E C0            LD A, 192
 118+ 9E2D 90               SUB B                       ; A = 192 - Y
 119+ 9E2E C8               RET Z
 120+ 9E2F D8               RET C
 121+ 9E30 32 9A 9E         LD (.heightSave), A
 122+ 9E33              .clipBotDone:
 123+ 9E33
 124+ 9E33                  ; Comprobar alineacion
 125+ 9E33 7B               LD A, E
 126+ 9E34 E6 07            AND 7
 127+ 9E36 20 1E            JR NZ, .shifted
