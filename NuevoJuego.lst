1731+ F6CE              ; ==============================================================================
1732+ F6CE              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1733+ F6CE              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1734+ F6CE              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1735+ F6CE              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1736+ F6CE              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1737+ F6CE              ; ==============================================================================
1738+ F6CE              CompassWobbleTable:
1739+ F6CE 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1740+ F6D2 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1741+ F6D6 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1742+ F6DA 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1743+ F6DE 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1744+ F6E2 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1745+ F6E6 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1746+ F6EA 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1747+ F6EE 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1748+ F6F2
1749+ F6F2              ; ==============================================================================
1750+ F6F2              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1751+ F6F2              ; Indexada por (counter-1) -> 0..8. Valor:
1752+ F6F2              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1753+ F6F2              ; Con counter inicial 9 y decremento por frame:
1754+ F6F2              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1755+ F6F2              ;   counter 8 -> phase 7 -> prev
1756+ F6F2              ;   counter 7 -> phase 6 -> target
1757+ F6F2              ;   counter 6 -> phase 5 -> next
1758+ F6F2              ;   counter 5 -> phase 4 -> next2
1759+ F6F2              ;   counter 4 -> phase 3 -> prev
1760+ F6F2              ;   counter 3 -> phase 2 -> target
1761+ F6F2              ;   counter 2 -> phase 1 -> prev
1762+ F6F2              ;   counter 1 -> phase 0 -> target (estado final, settle)
1763+ F6F2              ; ==============================================================================
1764+ F6F2              WobblePhaseTable:
1765+ F6F2 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1765+ F6F6 04 03 02 01
1765+ F6FA 00
