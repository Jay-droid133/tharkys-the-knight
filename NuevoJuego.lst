133+  86B7              ; ==============================================================================
134+  86B7              ; DrawScreen - Dibuja la pantalla actual iterando sprites de fondo
135+  86B7              ; ==============================================================================
136+  86B7              ; Itera la lista de sprites del room y pinta rectangulos de atributos.
137+  86B7              ; Solo se ejecuta cuando ScreenDirty=1 (cambio de pantalla).
138+  86B7              ; ==============================================================================
139+  86B7              DrawScreen:
140+  86B7 3A 09 81         LD A, (ScreenDirty)
141+  86BA B7               OR A
142+  86BB C8               RET Z
143+  86BC
144+  86BC                  ; --- Limpiar pixeles ---
145+  86BC 21 00 40         LD HL, SCREEN_BASE
146+  86BF 11 01 40         LD DE, SCREEN_BASE + 1
147+  86C2 01 FF 17         LD BC, 6143
148+  86C5 AF               XOR A
149+  86C6 77               LD (HL), A
150+  86C7 ED B0            LDIR
151+  86C9
152+  86C9                  ; --- Limpiar TODOS los atributos a blanco sobre negro ---
153+  86C9                  ; Ink=WHITE para que cualquier pixel XOR sea visible contra paper=BLACK.
154+  86C9                  ; Si attrs fuesen 0 (ink=BLACK, paper=BLACK), los pixeles serian invisibles.
155+  86C9 21 00 58         LD HL, ATTR_BASE
156+  86CC 11 01 58         LD DE, ATTR_BASE + 1
157+  86CF 01 FF 02         LD BC, ATTR_SIZE - 1
158+  86D2 3E 07            LD A, $07               ; Ink=WHITE, Paper=BLACK, no bright
159+  86D4 77               LD (HL), A
160+  86D5 ED B0            LDIR
161+  86D7
162+  86D7                  ; --- Iterar sprites del room y pintar atributos ---
163+  86D7 2A 06 81         LD HL, (CurrentScreenAddr)
164+  86DA              .sprLoop:
165+  86DA                  ; Leer DEFW sprite_ptr
166+  86DA 5E               LD E, (HL)
167+  86DB 23               INC HL
168+  86DC 56               LD D, (HL)
169+  86DD 23               INC HL
170+  86DE                  ; Terminador?
171+  86DE 7A               LD A, D
172+  86DF B3               OR E
173+  86E0 28 11            JR Z, .drawDone
174+  86E2                  ; Leer posicion
175+  86E2 46               LD B, (HL)                  ; B = x_char
176+  86E3 23               INC HL
177+  86E4 4E               LD C, (HL)                  ; C = y_char
178+  86E5 23               INC HL
179+  86E6 E5               PUSH HL                     ; Guardar puntero a siguiente entrada
180+  86E7                  ; Leer definicion del sprite desde DE
181+  86E7 EB               EX DE, HL                   ; HL = sprite def
182+  86E8 56               LD D, (HL)                  ; D = width_chars
183+  86E9 23               INC HL
184+  86EA 5E               LD E, (HL)                  ; E = height_chars
185+  86EB 23               INC HL
186+  86EC 7E               LD A, (HL)                  ; A = attr
187+  86ED                  ; Pintar rectangulo de atributos
188+  86ED CD FD 86         CALL DrawRoomSprite
189+  86F0 E1               POP HL                      ; Restaurar puntero room data
190+  86F1 18 E7            JR .sprLoop
191+  86F3
192+  86F3              .drawDone:
193+  86F3 AF               XOR A
194+  86F4 32 09 81         LD (ScreenDirty), A
195+  86F7 3E 01            LD A, 1
196+  86F9 32 0A 81         LD (ScreenJustRedrawn), A   ; Entities deben saltar erase tras redibujar
197+  86FC C9               RET
198+  86FD
199+  86FD              ; ==============================================================================
200+  86FD              ; DrawRoomSprite - Pinta un rectangulo de atributos en VRAM
201+  86FD              ; ==============================================================================
202+  86FD              ; Entrada: B=x_char, C=y_char, D=width, E=height, A=attr
203+  86FD              ; ==============================================================================
204+  86FD              DrawRoomSprite:
205+  86FD F5               PUSH AF                     ; Guardar atributo
206+  86FE                  ; Calcular dir VRAM: ATTR_BASE + y*32 + x
207+  86FE 79               LD A, C
208+  86FF 6F               LD L, A
209+  8700 26 00            LD H, 0
210+  8702 29               ADD HL, HL
211+  8703 29               ADD HL, HL
212+  8704 29               ADD HL, HL
213+  8705 29               ADD HL, HL
214+  8706 29               ADD HL, HL                  ; HL = y * 32
215+  8707 78               LD A, B
216+  8708 85               ADD A, L
217+  8709 6F               LD L, A
218+  870A 30 01            JR NC, .noCarry
219+  870C 24               INC H
220+  870D              .noCarry:
221+  870D 01 00 58         LD BC, ATTR_BASE
222+  8710 09               ADD HL, BC                  ; HL = dir atributo VRAM
223+  8711 F1               POP AF                      ; A = attr
224+  8712                  ; Pintar E filas de D columnas
225+  8712              .rowLoop:
226+  8712 42               LD B, D                     ; B = ancho (contador columnas)
227+  8713 E5               PUSH HL                     ; Guardar inicio de fila
228+  8714              .colLoop:
229+  8714 77               LD (HL), A
230+  8715 23               INC HL
231+  8716 10 FC            DJNZ .colLoop
232+  8718 E1               POP HL                      ; Restaurar inicio de fila
233+  8719                  ; Siguiente fila: +32
234+  8719 D5               PUSH DE
235+  871A 11 20 00         LD DE, 32
236+  871D 19               ADD HL, DE
237+  871E D1               POP DE
238+  871F 1D               DEC E
239+  8720 20 F0            JR NZ, .rowLoop
240+  8722 C9               RET
