2202+ F29C              ; ==============================================================================
2203+ F29C              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
2204+ F29C              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
2205+ F29C              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
2206+ F29C              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
2207+ F29C              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
2208+ F29C              ; ==============================================================================
2209+ F29C              CompassWobbleTable:
2210+ F29C 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
2211+ F2A0 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
2212+ F2A4 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
2213+ F2A8 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
2214+ F2AC 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
2215+ F2B0 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
2216+ F2B4 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
2217+ F2B8 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
2218+ F2BC 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
2219+ F2C0
2220+ F2C0              ; ==============================================================================
2221+ F2C0              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
2222+ F2C0              ; Indexada por (counter-1) -> 0..8. Valor:
2223+ F2C0              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
2224+ F2C0              ; Con counter inicial 9 y decremento por frame:
2225+ F2C0              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
2226+ F2C0              ;   counter 8 -> phase 7 -> prev
2227+ F2C0              ;   counter 7 -> phase 6 -> target
2228+ F2C0              ;   counter 6 -> phase 5 -> next
2229+ F2C0              ;   counter 5 -> phase 4 -> next2
2230+ F2C0              ;   counter 4 -> phase 3 -> prev
2231+ F2C0              ;   counter 3 -> phase 2 -> target
2232+ F2C0              ;   counter 2 -> phase 1 -> prev
2233+ F2C0              ;   counter 1 -> phase 0 -> target (estado final, settle)
2234+ F2C0              ; ==============================================================================
2235+ F2C0              WobblePhaseTable:
2236+ F2C0 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
2236+ F2C4 04 03 02 01
2236+ F2C8 00
