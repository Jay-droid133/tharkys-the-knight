 167+ 677C              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 168+ 677C              ; ==============================================================================
 169+ 677C              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 170+ 677C              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 171+ 677C              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 172+ 677C              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 173+ 677C              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 174+ 677C              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 175+ 677C              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 176+ 677C              ; ==============================================================================
 177+ 677C              StatueIdTable:
 178+ 677C D5               DEFB 213        ; type idx 0: statue_zombi
 179+ 677D E1               DEFB 225        ; type idx 1: statue_skeleton
 180+ 677E D3               DEFB 211        ; type idx 2: statue_ghost
