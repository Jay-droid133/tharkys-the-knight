 341  F833                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 342  F833                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F833              ; ==============================================================================
   2+ F833              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F833              ; ==============================================================================
   4+ F833              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F833              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F833              ;
   7+ F833              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F833              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F833              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F833              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F833              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F833              ; ==============================================================================
  13+ F833
  14+ F833              ; ==============================================================================
  15+ F833              ; PlaySFX - Reproduce un efecto de sonido
  16+ F833              ; ==============================================================================
  17+ F833              ; Entrada: HL = puntero a datos del efecto
  18+ F833              ; Modifica: AF, BC, DE, HL
  19+ F833              ; ==============================================================================
  20+ F833              PlaySFX:
  21+ F833 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F834 3A CA 90         LD A, (CurrentBorderColor)
  23+ F837 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F839 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F83A
  26+ F83A              .nextStep:
  27+ F83A 7E               LD A, (HL)                  ; Leer duration
  28+ F83B B7               OR A
  29+ F83C 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F83E
  31+ F83E 47               LD B, A                     ; B = duration (bucle externo)
  32+ F83F 23               INC HL
  33+ F840 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F841 23               INC HL
  35+ F842 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F843 23               INC HL
  37+ F844 7E               LD A, (HL)                  ; A = flags
  38+ F845 23               INC HL
  39+ F846 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F847 CB 47            BIT 0, A
  41+ F849 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F84B
  43+ F84B              ; --- Bucle de tono normal ---
  44+ F84B              .toneLoop:
  45+ F84B                  ; Semi-periodo HIGH
  46+ F84B 7B               LD A, E
  47+ F84C F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F84E D3 FE            OUT ($FE), A
  49+ F850 79               LD A, C                     ; A = pitch actual
  50+ F851              .toneDelayHi:
  51+ F851 3D               DEC A
  52+ F852 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F854
  54+ F854                  ; Semi-periodo LOW
  55+ F854 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F855 D3 FE            OUT ($FE), A
  57+ F857 79               LD A, C
  58+ F858              .toneDelayLo:
  59+ F858 3D               DEC A
  60+ F859 20 FD            JR NZ, .toneDelayLo
  61+ F85B
  62+ F85B                  ; Aplicar pitch sweep
  63+ F85B 79               LD A, C
  64+ F85C 82               ADD A, D                    ; pitch += pitchDelta
  65+ F85D 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F85F FA 67 F8         JP M, .toneClamp            ; evitar pitch negativo
  67+ F862 4F               LD C, A
  68+ F863              .toneAfterClamp:
  69+ F863 10 E6            DJNZ .toneLoop
  70+ F865 18 30            JR .stepDone
  71+ F867
  72+ F867              .toneClamp:
  73+ F867 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F869 18 F8            JR .toneAfterClamp
  75+ F86B
  76+ F86B              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F86B              .noiseLoop:
  78+ F86B                  ; Semi-periodo HIGH con ruido
  79+ F86B 7B               LD A, E
  80+ F86C F6 10            OR $10
  81+ F86E D3 FE            OUT ($FE), A
  82+ F870 ED 5F            LD A, R                     ; R register como PRNG
  83+ F872 A9               XOR C                       ; mezclar con pitch base
  84+ F873 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F875 F6 01            OR $01                      ; minimo 1
  86+ F877              .noiseDelayHi:
  87+ F877 3D               DEC A
  88+ F878 20 FD            JR NZ, .noiseDelayHi
  89+ F87A
  90+ F87A                  ; Semi-periodo LOW
  91+ F87A 7B               LD A, E
  92+ F87B D3 FE            OUT ($FE), A
  93+ F87D ED 5F            LD A, R
  94+ F87F A9               XOR C
  95+ F880 E6 1F            AND $1F
  96+ F882 F6 01            OR $01
  97+ F884              .noiseDelayLo:
  98+ F884 3D               DEC A
  99+ F885 20 FD            JR NZ, .noiseDelayLo
