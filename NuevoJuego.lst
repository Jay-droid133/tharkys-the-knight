  24+ E2D8              ; ==============================================================================
  25+ E2D8              SetTimeOfDay:
  26+ E2D8 32 D0 E2         LD (CurrentTimeOfDay), A
  27+ E2DB
  28+ E2DB                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E2DB FE 04            CP 4
  30+ E2DD 20 06            JR NZ, .notNewCycle
  31+ E2DF 21 ED BC         LD HL, DayCycleCount
  32+ E2E2 34               INC (HL)
  33+ E2E3 18 04            JR .skipBellsReset
  34+ E2E5              .notNewCycle:
  35+ E2E5                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E2E5                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E2E5                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E2E5 AF               XOR A
  39+ E2E6 32 B6 82         LD (BellsTriggered), A
  40+ E2E9              .skipBellsReset:
  41+ E2E9 3A D0 E2         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E2EC
  43+ E2EC                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E2EC FE 04            CP 4
  45+ E2EE 28 24            JR Z, .bellsFirst
  46+ E2F0
  47+ E2F0                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E2F0 FE 05            CP 5
  49+ E2F2 20 0D            JR NZ, .noScareMon
  50+ E2F4 CD 07 BD         CALL ScareAllMonsters
  51+ E2F7 CD 4B F9         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E2FA                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E2FA                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E2FA                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E2FA                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E2FA 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E2FC CD BA 99         CALL StartMusic
  58+ E2FF 18 07            JR .noKillMon
  59+ E301              .noScareMon:
