1348+ F6C9              ; ==============================================================================
1349+ F6C9              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1350+ F6C9              ; ==============================================================================
1351+ F6C9              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1352+ F6C9              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1353+ F6C9              ; ==============================================================================
1354+ F6C9              ChurchCutsceneEraseStatueAtLast:
1355+ F6C9              ChurchCutsceneDrawStatueAtLast:
1356+ F6C9 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1357+ F6CC 21 7C 67         LD HL, StatueIdTable
1358+ F6CF 5F               LD E, A
1359+ F6D0 16 00            LD D, 0
1360+ F6D2 19               ADD HL, DE
1361+ F6D3 7E               LD A, (HL)                              ; A = statue id
1362+ F6D4 B7               OR A
1363+ F6D5 C8               RET Z
1364+ F6D6                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1365+ F6D6 6F               LD L, A
1366+ F6D7 26 00            LD H, 0
1367+ F6D9 54               LD D, H
1368+ F6DA 5D               LD E, L
1369+ F6DB 29               ADD HL, HL
1370+ F6DC 19               ADD HL, DE                              ; HL = id*3
1371+ F6DD 11 4D E2         LD DE, BgGfxPtrById
1372+ F6E0 19               ADD HL, DE
1373+ F6E1 5E               LD E, (HL)
1374+ F6E2 23               INC HL
1375+ F6E3 56               LD D, (HL)                              ; DE = sprite ptr
1376+ F6E4 23               INC HL
1377+ F6E5 7E               LD A, (HL)                              ; A = bank
1378+ F6E6 EB               EX DE, HL                               ; HL = sprite ptr
1379+ F6E7 CD 8F 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1380+ F6EA                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1381+ F6EA 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1382+ F6ED 57               LD D, A
1383+ F6EE 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1384+ F6F1 5F               LD E, A
1385+ F6F2 C3 04 69         JP DrawBgSprite16XorAtPixel
1386+ F6F5
1387+ F6F5              ; ==============================================================================
1388+ F6F5              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1389+ F6F5              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1390+ F6F5              ;     A  = jitter signed (-1, 0, +1) en bits.
1391+ F6F5              ; ==============================================================================
1392+ F6F5              ; IN: A = jitter signed (-1, 0, +1) en bits.
1393+ F6F5              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1394+ F6F5              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1395+ F6F5              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1396+ F6F5              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1397+ F6F5              ; version shifted, sin XOR.
1398+ F6F5              ;
1399+ F6F5              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1400+ F6F5              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1401+ F6F5              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1402+ F6F5              ; estatua se perdio cuando la estatua se pinto la primera vez con
1403+ F6F5              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1404+ F6F5              ; de la estatua, el wall perdido no se ve.
1405+ F6F5              ;
1406+ F6F5              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1407+ F6F5              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1408+ F6F5              ; shift de 1 bit no pierde pixels visibles.
1409+ F6F5              ; Destruye: AF, BC, DE, HL, IX.
1410+ F6F5              ; ==============================================================================
1411+ F6F5              ChurchCutsceneShakeStatueByteShift:
1412+ F6F5 32 5F F7         LD (.csbsJitter), A
1413+ F6F8                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1414+ F6F8 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1415+ F6FB 5F               LD E, A
1416+ F6FC 16 00            LD D, 0
1417+ F6FE 19               ADD HL, DE
1418+ F6FF 7E               LD A, (HL)
1419+ F700 B7               OR A
1420+ F701 C8               RET Z                                   ; sin estatua
1421+ F702 6F               LD L, A
1422+ F703 26 00            LD H, 0
1423+ F705 54               LD D, H
1424+ F706 5D               LD E, L
1425+ F707 29               ADD HL, HL
1426+ F708 19               ADD HL, DE                              ; HL = id*3
1427+ F709 11 4D E2         LD DE, BgGfxPtrById
1428+ F70C 19               ADD HL, DE
1429+ F70D 5E               LD E, (HL)
1430+ F70E 23               INC HL
1431+ F70F 56               LD D, (HL)                              ; DE = sprite ptr
1432+ F710 23               INC HL
1433+ F711 7E               LD A, (HL)                              ; A = bank
1434+ F712 EB               EX DE, HL                               ; HL = sprite ptr
1435+ F713 CD 8F 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1436+ F716                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1437+ F716 DD 21 9B 89      LD IX, BgSpriteBuffer
1438+ F71A DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1439+ F71D B7               OR A
1440+ F71E C8               RET Z
1441+ F71F 47               LD B, A                                 ; B = row counter
1442+ F720 DD 23            INC IX
1443+ F722 DD 23            INC IX                                  ; IX -> pixel data
1444+ F724                  ; Calcular addr VRAM en (origX, origY)
1445+ F724 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1446+ F727 57               LD D, A
1447+ F728 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1448+ F72B 5F               LD E, A
1449+ F72C CD A6 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1450+ F72F              .csbsRow:
1451+ F72F C5               PUSH BC
1452+ F730 E5               PUSH HL                                 ; save inicio fila VRAM
1453+ F731                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1454+ F731 DD 7E 00         LD A, (IX+0)
1455+ F734 2F               CPL
1456+ F735 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1457+ F736 DD 7E 01         LD A, (IX+1)
1458+ F739 2F               CPL
1459+ F73A 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1460+ F73B                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1461+ F73B 3A 5F F7         LD A, (.csbsJitter)
1462+ F73E B7               OR A
1463+ F73F 28 0D            JR Z, .csbsWrite                        ; sin shift
1464+ F741 FA 4A F7         JP M, .csbsLeft                         ; A < 0 -> shift left
1465+ F744                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1466+ F744 CB 3A            SRL D
1467+ F746 CB 1B            RR E
1468+ F748 18 04            JR .csbsWrite
1469+ F74A              .csbsLeft:
1470+ F74A CB 23            SLA E
1471+ F74C CB 12            RL D
1472+ F74E              .csbsWrite:
1473+ F74E 7A               LD A, D
1474+ F74F 77               LD (HL), A
1475+ F750 23               INC HL
1476+ F751 7B               LD A, E
1477+ F752 77               LD (HL), A
1478+ F753 E1               POP HL
1479+ F754 CD 12 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1480+ F757 DD 23            INC IX
1481+ F759 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1482+ F75B C1               POP BC
1483+ F75C 10 D1            DJNZ .csbsRow
1484+ F75E C9               RET
1485+ F75F 00           .csbsJitter: DEFB 0
1486+ F760
1487+ F760              ; ==============================================================================
1488+ F760              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1489+ F760              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1490+ F760              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1491+ F760              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1492+ F760              ; Destruye: AF, BC, HL.
1493+ F760              ; ==============================================================================
1494+ F760              ChurchCutsceneEraseStatueDirect:
1495+ F760 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1496+ F763 57               LD D, A
1497+ F764 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1498+ F767 5F               LD E, A
1499+ F768 CD A6 A0         CALL CalcPixelAddr
1500+ F76B 06 18            LD B, 24                                ; statues son 24 px de alto
1501+ F76D              .csedRow:
1502+ F76D AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1503+ F76E 77               LD (HL), A
1504+ F76F 23               INC HL
1505+ F770 77               LD (HL), A
1506+ F771 2B               DEC HL                                  ; volver a inicio fila
1507+ F772 C5               PUSH BC
1508+ F773 CD 12 9E         CALL NextPixelLine
1509+ F776 C1               POP BC
1510+ F777 10 F4            DJNZ .csedRow
1511+ F779 C9               RET
