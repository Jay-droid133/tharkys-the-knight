 662+ A5D0                  ; === STATE_SCARED: pausa dramatica + huida ===
 663+ A5D0              .peScared:
 664+ A5D0 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 665+ A5D4 C2 99 A6         JP NZ, .peScaredFresh
 666+ A5D7
 667+ A5D7                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 668+ A5D7 3A 75 B9         LD A, (ScareTimer)
 669+ A5DA FE 33            CP SCARE_FLEE_THRESHOLD + 1
 670+ A5DC DA 7C A6         JP C, .peScaredFlee
 671+ A5DF                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 672+ A5DF                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 673+ A5DF DD 36 06 00      LD (IX+ENT_DELTAX), 0
 674+ A5E3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 675+ A5E7                  ; Shake monster-only (nasties durante bells no se agitan)
 676+ A5E7 DD 7E 01         LD A, (IX+ENT_TYPE)
 677+ A5EA FE 02            CP TYPE_MONSTER
 678+ A5EC C2 62 A6         JP NZ, .peScaredSpriteToggle
 679+ A5EF                  ; --- Shake ---
 680+ A5EF CD 80 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 681+ A5F2 5F               LD E, A
 682+ A5F3 16 00            LD D, 0
 683+ A5F5 21 DA 90         LD HL, MonsterAiFlags
 684+ A5F8 19               ADD HL, DE
 685+ A5F9 7E               LD A, (HL)
 686+ A5FA CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 687+ A5FC 20 15            JR NZ, .peShakeActive
 688+ A5FE                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 689+ A5FE F6 08            OR MAI_FLAG_SHAKE_SAVED
 690+ A600 77               LD (HL), A
 691+ A601 21 97 5F         LD HL, MonsterShakeOrigX
 692+ A604 19               ADD HL, DE
 693+ A605 DD 7E 03         LD A, (IX+ENT_POSX)
 694+ A608 77               LD (HL), A
 695+ A609 21 9A 5F         LD HL, MonsterShakeOrigY
 696+ A60C 19               ADD HL, DE
 697+ A60D DD 7E 04         LD A, (IX+ENT_POSY)
 698+ A610 77               LD (HL), A
 699+ A611 18 4F            JR .peScaredSpriteToggle
 700+ A613              .peShakeActive:
 701+ A613                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 702+ A613 ED 5F            LD A, R
 703+ A615 E6 03            AND 3
 704+ A617 28 0C            JR Z, .peShakeUp
 705+ A619 3D               DEC A
 706+ A61A 28 0F            JR Z, .peShakeDown
 707+ A61C 3D               DEC A
 708+ A61D 28 12            JR Z, .peShakeLeft
 709+ A61F                  ; 3: right
 710+ A61F 06 01            LD B, 1
 711+ A621 0E 00            LD C, 0
 712+ A623 18 10            JR .peShakeApply
 713+ A625              .peShakeUp:
 714+ A625 06 00            LD B, 0
 715+ A627 0E FF            LD C, -1
 716+ A629 18 0A            JR .peShakeApply
 717+ A62B              .peShakeDown:
 718+ A62B 06 00            LD B, 0
 719+ A62D 0E 01            LD C, 1
 720+ A62F 18 04            JR .peShakeApply
 721+ A631              .peShakeLeft:
 722+ A631 06 FF            LD B, -1
 723+ A633 0E 00            LD C, 0
 724+ A635              .peShakeApply:
 725+ A635                  ; new POSX = orig + B, new POSY = orig + C
 726+ A635 21 97 5F         LD HL, MonsterShakeOrigX
 727+ A638 19               ADD HL, DE
 728+ A639 7E               LD A, (HL)
 729+ A63A 80               ADD A, B
 730+ A63B DD 77 03         LD (IX+ENT_POSX), A
 731+ A63E 21 9A 5F         LD HL, MonsterShakeOrigY
 732+ A641 19               ADD HL, DE
 733+ A642 7E               LD A, (HL)
 734+ A643 81               ADD A, C
 735+ A644 DD 77 04         LD (IX+ENT_POSY), A
 736+ A647                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 737+ A647 CD 44 BA         CALL CheckEnemyCollision
 738+ A64A 28 16            JR Z, .peScaredSpriteToggle
 739+ A64C                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 740+ A64C CD 80 92         CALL MaiGetMonsterSlot
 741+ A64F 5F               LD E, A
 742+ A650 16 00            LD D, 0
 743+ A652 21 97 5F         LD HL, MonsterShakeOrigX
 744+ A655 19               ADD HL, DE
 745+ A656 7E               LD A, (HL)
 746+ A657 DD 77 03         LD (IX+ENT_POSX), A
 747+ A65A 21 9A 5F         LD HL, MonsterShakeOrigY
 748+ A65D 19               ADD HL, DE
 749+ A65E 7E               LD A, (HL)
 750+ A65F DD 77 04         LD (IX+ENT_POSY), A
