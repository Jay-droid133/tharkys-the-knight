2704+ AD99              ; ==============================================================================
2705+ AD99              ; ==============================================================================
2706+ AD99              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2707+ AD99              ; ==============================================================================
2708+ AD99              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2709+ AD99              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2710+ AD99              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2711+ AD99              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2712+ AD99              ; ==============================================================================
2713+ AD99              UpdateMonster:
2714+ AD99                  ; --- Stun: knockback + pausa tras golpe del player ---
2715+ AD99 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2716+ AD9C B7               OR A
2717+ AD9D CA D2 AF         JP Z, .moNormal
2718+ ADA0 DD 35 0A         DEC (IX+ENT_DIR)
2719+ ADA3 20 0B            JR NZ, .moStunActive
2720+ ADA5                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2721+ ADA5 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2722+ ADA9 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2723+ ADAD C3 D2 AF         JP .moNormal
2724+ ADB0
2725+ ADB0              .moStunActive:
2726+ ADB0                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2727+ ADB0 FE 06            CP MONSTER_STUN_PAUSE
2728+ ADB2 DA 63 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2729+ ADB5                  ; Knockback: aplicar movimiento con collision check
2730+ ADB5 DD 56 06         LD D, (IX+ENT_DELTAX)
2731+ ADB8 DD 5E 07         LD E, (IX+ENT_DELTAY)
2732+ ADBB 7A               LD A, D
2733+ ADBC B3               OR E
2734+ ADBD CA 63 B1         JP Z, .moAnimate
2735+ ADC0                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2736+ ADC0 D5               PUSH DE
2737+ ADC1 DD 7E 03         LD A, (IX+ENT_POSX)
2738+ ADC4 32 FB B2         LD (.moSvX), A
2739+ ADC7 DD 7E 04         LD A, (IX+ENT_POSY)
2740+ ADCA 32 FC B2         LD (.moSvY), A
2741+ ADCD                  ; Calcular nueva posicion
2742+ ADCD DD 7E 03         LD A, (IX+ENT_POSX)
2743+ ADD0 82               ADD A, D
2744+ ADD1 DD 77 03         LD (IX+ENT_POSX), A
2745+ ADD4 DD 7E 04         LD A, (IX+ENT_POSY)
2746+ ADD7 83               ADD A, E
2747+ ADD8 DD 77 04         LD (IX+ENT_POSY), A
2748+ ADDB                  ; Comprobar bordes ANTES de colision con paredes
2749+ ADDB DD 7E 03         LD A, (IX+ENT_POSX)
2750+ ADDE FE E8            CP SCREEN_MAX_X
2751+ ADE0 30 30            JR NC, .moKbPreOffscreen
2752+ ADE2 FE 04            CP MONSTER_KB_SPEED
2753+ ADE4 38 20            JR C, .moKbPreOffscreenMaybeX
2754+ ADE6              .moKbPreBorderXOk:
2755+ ADE6 DD 7E 04         LD A, (IX+ENT_POSY)
2756+ ADE9 FE A8            CP SCREEN_MAX_Y
2757+ ADEB 30 25            JR NC, .moKbPreOffscreen
2758+ ADED FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2759+ ADEF 38 1B            JR C, .moKbPreOffscreenMaybeY
2760+ ADF1              .moKbPreBorderOk:
2761+ ADF1                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2762+ ADF1                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2763+ ADF1                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2764+ ADF1                  ; CheckEnemyCollision.
2765+ ADF1                  ; CheckChurchTrap retorna:
2766+ ADF1                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2767+ ADF1                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2768+ ADF1                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2769+ ADF1 CD 1C F1         CALL CheckChurchTrap
2770+ ADF4 B7               OR A
2771+ ADF5 28 07            JR Z, .moKbCollCheck
2772+ ADF7 FE 02            CP 2
2773+ ADF9 CA AA AE         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2774+ ADFC D1               POP DE                              ; limpiar PUSH DE previo
2775+ ADFD C9               RET                                 ; cutscene activa, salir
2776+ ADFE              .moKbCollCheck:
2777+ ADFE                  ; Dentro de pantalla: comprobar colision con paredes
2778+ ADFE CD 77 B6         CALL CheckEnemyCollision
2779+ AE01 C2 AA AE         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2780+ AE04 18 1C            JR .moKbNotBlocked
2781+ AE06              .moKbPreOffscreenMaybeX:
2782+ AE06 CB 7A            BIT 7, D
2783+ AE08 20 08            JR NZ, .moKbPreOffscreen
2784+ AE0A 18 DA            JR .moKbPreBorderXOk
2785+ AE0C              .moKbPreOffscreenMaybeY:
2786+ AE0C CB 7B            BIT 7, E
2787+ AE0E 20 02            JR NZ, .moKbPreOffscreen
2788+ AE10 18 DF            JR .moKbPreBorderOk
2789+ AE12              .moKbPreOffscreen:
2790+ AE12                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2791+ AE12 3A FB B2         LD A, (.moSvX)
2792+ AE15 DD 77 03         LD (IX+ENT_POSX), A
2793+ AE18 3A FC B2         LD A, (.moSvY)
2794+ AE1B DD 77 04         LD (IX+ENT_POSY), A
2795+ AE1E D1               POP DE
2796+ AE1F C3 0F AF         JP .moKbOffscreen
2797+ AE22              .moKbNotBlocked:
2798+ AE22                  ; Pared libre: comprobar impacto con otro monster (billar)
2799+ AE22 CD FC B1         CALL .moCheckOverlap
2800+ AE25 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2801+ AE27                  ; Libre: restaurar pos y aplicar movimiento
2802+ AE27 3A FB B2         LD A, (.moSvX)
2803+ AE2A DD 77 03         LD (IX+ENT_POSX), A
2804+ AE2D 3A FC B2         LD A, (.moSvY)
2805+ AE30 DD 77 04         LD (IX+ENT_POSY), A
2806+ AE33 D1               POP DE
2807+ AE34 C3 E6 AE         JP .moKbApply
2808+ AE37              .moKbBilliard:
2809+ AE37                  ; Billar: A para en su sitio, B hereda la fuerza
2810+ AE37 3A FB B2         LD A, (.moSvX)
2811+ AE3A DD 77 03         LD (IX+ENT_POSX), A
2812+ AE3D 3A FC B2         LD A, (.moSvY)
2813+ AE40 DD 77 04         LD (IX+ENT_POSY), A
2814+ AE43 D1               POP DE
2815+ AE44                  ; Transferir knockback al monster impactado
2816+ AE44 DD E5            PUSH IX
2817+ AE46 DD 2A 05 B3      LD IX, (.moHitMonster)
2818+ AE4A                  ; Solo transferir si no esta ya en stun
2819+ AE4A DD 7E 0A         LD A, (IX+ENT_DIR)
2820+ AE4D B7               OR A
2821+ AE4E 20 2A            JR NZ, .moKbBilliardDone
2822+ AE50                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2823+ AE50 7A               LD A, D
2824+ AE51 B7               OR A
2825+ AE52 28 0D            JR Z, .moBillNoX
2826+ AE54 CB 7A            BIT 7, D
2827+ AE56 20 04            JR NZ, .moBillXNeg
2828+ AE58 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2829+ AE5A 18 02            JR .moBillSetX
2830+ AE5C              .moBillXNeg:
2831+ AE5C 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2832+ AE5E              .moBillSetX:
2833+ AE5E DD 77 06         LD (IX+ENT_DELTAX), A
2834+ AE61              .moBillNoX:
2835+ AE61 7B               LD A, E
2836+ AE62 B7               OR A
2837+ AE63 28 0D            JR Z, .moBillNoY
2838+ AE65 CB 7B            BIT 7, E
2839+ AE67 20 04            JR NZ, .moBillYNeg
2840+ AE69 3E 03            LD A, MONSTER_KB_SPEED - 1
2841+ AE6B 18 02            JR .moBillSetY
2842+ AE6D              .moBillYNeg:
2843+ AE6D 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2844+ AE6F              .moBillSetY:
2845+ AE6F DD 77 07         LD (IX+ENT_DELTAY), A
2846+ AE72              .moBillNoY:
2847+ AE72 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2848+ AE76                  ; Kb heredado por billar: NO es directo del player.
2849+ AE76                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2850+ AE76 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2851+ AE7A              .moKbBilliardDone:
2852+ AE7A DD E1            POP IX
2853+ AE7C                  ; A continua con fuerza reducida (no para del todo)
2854+ AE7C                  ; Reducir velocidad de A a la mitad
2855+ AE7C DD 7E 06         LD A, (IX+ENT_DELTAX)
2856+ AE7F CB 2F            SRA A                               ; /2 con signo
2857+ AE81 DD 77 06         LD (IX+ENT_DELTAX), A
2858+ AE84 57               LD D, A
2859+ AE85 DD 7E 07         LD A, (IX+ENT_DELTAY)
2860+ AE88 CB 2F            SRA A
2861+ AE8A DD 77 07         LD (IX+ENT_DELTAY), A
2862+ AE8D 5F               LD E, A
2863+ AE8E                  ; Reducir stun restante de A
2864+ AE8E DD 7E 0A         LD A, (IX+ENT_DIR)
2865+ AE91 FE 08            CP MONSTER_STUN_PAUSE + 2
2866+ AE93 DA C7 AF         JP C, .moStunStop                   ; Casi sin stun → parar
2867+ AE96 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2868+ AE98 DD 77 0A         LD (IX+ENT_DIR), A
2869+ AE9B                  ; Aplicar movimiento reducido de A
2870+ AE9B 3A FB B2         LD A, (.moSvX)
2871+ AE9E DD 77 03         LD (IX+ENT_POSX), A
2872+ AEA1 3A FC B2         LD A, (.moSvY)
2873+ AEA4 DD 77 04         LD (IX+ENT_POSY), A
2874+ AEA7 C3 E6 AE         JP .moKbApply
2875+ AEAA              .moKbWallBlock:
2876+ AEAA                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2877+ AEAA 3A FB B2         LD A, (.moSvX)
2878+ AEAD DD 77 03         LD (IX+ENT_POSX), A
2879+ AEB0 3A FC B2         LD A, (.moSvY)
2880+ AEB3 DD 77 04         LD (IX+ENT_POSY), A
2881+ AEB6 D1               POP DE
2882+ AEB7                  ; Intentar solo eje X (mantener direccion del golpe)
2883+ AEB7 7A               LD A, D
2884+ AEB8 B7               OR A
2885+ AEB9 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2886+ AEBB D5               PUSH DE
2887+ AEBC 1E 00            LD E, 0
2888+ AEBE CD BD B1         CALL .moTryPassable
2889+ AEC1 D1               POP DE
2890+ AEC2 20 09            JR NZ, .moKbSlideY
2891+ AEC4                  ; Slide en X funciona
2892+ AEC4 1E 00            LD E, 0
2893+ AEC6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2894+ AECA C3 E6 AE         JP .moKbApply
2895+ AECD              .moKbSlideY:
2896+ AECD                  ; Intentar solo eje Y (mantener direccion del golpe)
2897+ AECD 7B               LD A, E
