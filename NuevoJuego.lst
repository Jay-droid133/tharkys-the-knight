 304+ 6546              ; ==============================================================================
 305+ 6546              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 306+ 6546              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 307+ 6546              ; ==============================================================================
 308+ 6546              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 309+ 6546              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 310+ 6546              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 311+ 6546              ; uniformemente negro -- el efecto que pidio el usuario.
 312+ 6546              ;
 313+ 6546              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 314+ 6546              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 315+ 6546              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 316+ 6546              ; Destruye: AF, BC, DE, HL.
 317+ 6546              ; ==============================================================================
 318+ 6546              ClearSmokeAttrs:
 319+ 6546                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 320+ 6546 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 321+ 6549 CB 3F            SRL A
 321+ 654B CB 3F          SRL A
 321+ 654D CB 3F          SRL A                   ; A = char Y (post-HUD)
 322+ 654F 26 00            LD H, 0
 323+ 6551 6F               LD L, A
 324+ 6552 29               ADD HL, HL                              ; *2
 325+ 6553 29               ADD HL, HL                              ; *4
 326+ 6554 29               ADD HL, HL                              ; *8
 327+ 6555 29               ADD HL, HL                              ; *16
 328+ 6556 29               ADD HL, HL                              ; *32
 329+ 6557 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 330+ 655A CB 3F            SRL A
 330+ 655C CB 3F          SRL A
 330+ 655E CB 3F          SRL A                   ; A = char X
 331+ 6560 5F               LD E, A
 332+ 6561 16 00            LD D, 0
 333+ 6563 19               ADD HL, DE
 334+ 6564 11 00 58         LD DE, $5800
 335+ 6567 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 336+ 6568 AF               XOR A                                   ; paper black, ink black
 337+ 6569 77               LD (HL), A                              ; (charY, charX)
 338+ 656A 23               INC HL
 339+ 656B 77               LD (HL), A                              ; (charY, charX+1)
 340+ 656C 11 1F 00         LD DE, 31
 341+ 656F 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 342+ 6570 77               LD (HL), A
 343+ 6571 23               INC HL
 344+ 6572 77               LD (HL), A                              ; (charY+1, charX+1)
 345+ 6573 C9               RET
