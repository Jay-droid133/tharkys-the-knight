 125+ 6E2F DD 21 9B 89      LD IX, BgSpriteBuffer
 126+ 6E33 CD 89 D6         CALL SkipPixelData                      ; IX @ tintPaper
 127+ 6E36 DD 23            INC IX                                  ; @ attr_h
 128+ 6E38 DD 23            INC IX                                  ; @ attr_w
 129+ 6E3A DD 23            INC IX                                  ; @ attr_data
 130+ 6E3C DD 7E 00         LD A, (IX+0)
 131+ 6E3F 32 BB 5F         LD (RandomSynthAttr), A
 132+ 6E42 C9               RET
