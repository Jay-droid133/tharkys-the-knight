 481+ 68CB 26 00            LD H, 0
 482+ 68CD 54               LD D, H
 483+ 68CE 5D               LD E, L                                 ; DE = id
 484+ 68CF 29               ADD HL, HL                              ; *2
 485+ 68D0 19               ADD HL, DE                              ; *3
 486+ 68D1 11 97 E1         LD DE, BgGfxPtrById
 487+ 68D4 19               ADD HL, DE
 488+ 68D5 5E               LD E, (HL)
 489+ 68D6 23               INC HL
 490+ 68D7 56               LD D, (HL)                              ; DE = ptr
 491+ 68D8 23               INC HL
 492+ 68D9 7E               LD A, (HL)                              ; A = bank
 493+ 68DA 32 9F D4         LD (CurrentBgSpriteBank), A
 494+ 68DD EB               EX DE, HL                               ; HL = ptr
 495+ 68DE CD 74 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 496+ 68E1 DD 21 87 89      LD IX, BgSpriteBuffer
 497+ 68E5 C1               POP BC
