1284+ D6A3                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1285+ D6A3                  ; Total pixeles = height_px * (width_bytes & $7F)
1286+ D6A3              .spSkipRle:
1287+ D6A3 7B               LD A, E
1288+ D6A4 E6 7F            AND $7F                     ; width_bytes real
1289+ D6A6                  ; Calcular total = D * A (height * width)
1290+ D6A6 42               LD B, D                     ; B = height
