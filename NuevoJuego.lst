 192+ AB10              ; ==============================================================================
 193+ AB10              ; ClearNasties - Limpia todos los slots de nasties (enemigos destruibles)
 194+ AB10              ; ==============================================================================
 195+ AB10              ; Los nasties no persisten entre pantallas (como en Sabre Wulf).
 196+ AB10              ; ==============================================================================
 197+ AB10              ClearNasties:
 198+ AB10 21 F5 80         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 199+ AB13 06 03            LD B, NUM_NASTIES
 200+ AB15              .clearLoop:
 201+ AB15 C5               PUSH BC
 202+ AB16 E5               PUSH HL
 203+ AB17 36 00            LD (HL), 0                  ; ENT_SPRITEID = 0
 204+ AB19 23               INC HL
 205+ AB1A 36 00            LD (HL), 0                  ; ENT_TYPE = 0 (inactivo)
 206+ AB1C E1               POP HL
 207+ AB1D 11 10 00         LD DE, ENT_SIZE
 208+ AB20 19               ADD HL, DE
 209+ AB21 C1               POP BC
 210+ AB22 10 F1            DJNZ .clearLoop
 211+ AB24                  ; Reset spawn timer para nueva pantalla (delay antes de nasties)
 212+ AB24 3E 32            LD A, SPAWN_INTERVAL
 213+ AB26 32 98 81         LD (SpawnTimer), A
 214+ AB29 C9               RET
