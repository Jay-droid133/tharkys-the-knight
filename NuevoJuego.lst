 177+ AAF4              .doTransition:
 178+ AAF4 CD DF A9         CALL CalcScreenAddress
 179+ AAF7 CD 10 AB         CALL ClearNasties           ; Limpiar enemigos al cambiar de pantalla
 180+ AAFA CD 3D A5         CALL RepositionMonstersAtEntry ; Monsters siguen al player desde la pantalla anterior
 181+ AAFD                  ; SFX de transicion de pantalla
 182+ AAFD 21 A7 F4         LD HL, SFX_ScreenTransition
 183+ AB00 CD 0F F4         CALL PlaySFX
 184+ AB03 AF               XOR A
 185+ AB04 32 9F 81         LD (PendingEraseCount), A   ; Cancelar erases pendientes (pantalla se borra)
 186+ AB07 3E 01            LD A, 1
 187+ AB09 32 B4 81         LD (ScreenDirty), A
 188+ AB0C 32 B6 81         LD (ScreenJustRedrawn), A
 189+ AB0F              .noSouth:
 190+ AB0F C9               RET
