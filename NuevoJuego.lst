2756+ B16C 18 DF            JR .moKbPreBorderOk
2757+ B16E              .moKbPreOffscreen:
2758+ B16E                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2759+ B16E 3A 57 B6         LD A, (.moSvX)
2760+ B171 DD 77 03         LD (IX+ENT_POSX), A
2761+ B174 3A 58 B6         LD A, (.moSvY)
2762+ B177 DD 77 04         LD (IX+ENT_POSY), A
2763+ B17A D1               POP DE
2764+ B17B C3 6B B2         JP .moKbOffscreen
2765+ B17E              .moKbNotBlocked:
2766+ B17E                  ; Pared libre: comprobar impacto con otro monster (billar)
2767+ B17E CD 58 B5         CALL .moCheckOverlap
2768+ B181 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2769+ B183                  ; Libre: restaurar pos y aplicar movimiento
2770+ B183 3A 57 B6         LD A, (.moSvX)
2771+ B186 DD 77 03         LD (IX+ENT_POSX), A
2772+ B189 3A 58 B6         LD A, (.moSvY)
2773+ B18C DD 77 04         LD (IX+ENT_POSY), A
2774+ B18F D1               POP DE
2775+ B190 C3 42 B2         JP .moKbApply
2776+ B193              .moKbBilliard:
2777+ B193                  ; Billar: A para en su sitio, B hereda la fuerza
2778+ B193 3A 57 B6         LD A, (.moSvX)
2779+ B196 DD 77 03         LD (IX+ENT_POSX), A
2780+ B199 3A 58 B6         LD A, (.moSvY)
2781+ B19C DD 77 04         LD (IX+ENT_POSY), A
2782+ B19F D1               POP DE
2783+ B1A0                  ; Transferir knockback al monster impactado
2784+ B1A0 DD E5            PUSH IX
2785+ B1A2 DD 2A 61 B6      LD IX, (.moHitMonster)
2786+ B1A6                  ; Solo transferir si no esta ya en stun
2787+ B1A6 DD 7E 0A         LD A, (IX+ENT_DIR)
2788+ B1A9 B7               OR A
2789+ B1AA 20 2A            JR NZ, .moKbBilliardDone
2790+ B1AC                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2791+ B1AC 7A               LD A, D
2792+ B1AD B7               OR A
2793+ B1AE 28 0D            JR Z, .moBillNoX
2794+ B1B0 CB 7A            BIT 7, D
2795+ B1B2 20 04            JR NZ, .moBillXNeg
2796+ B1B4 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2797+ B1B6 18 02            JR .moBillSetX
2798+ B1B8              .moBillXNeg:
2799+ B1B8 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2800+ B1BA              .moBillSetX:
2801+ B1BA DD 77 06         LD (IX+ENT_DELTAX), A
2802+ B1BD              .moBillNoX:
2803+ B1BD 7B               LD A, E
2804+ B1BE B7               OR A
2805+ B1BF 28 0D            JR Z, .moBillNoY
2806+ B1C1 CB 7B            BIT 7, E
2807+ B1C3 20 04            JR NZ, .moBillYNeg
2808+ B1C5 3E 03            LD A, MONSTER_KB_SPEED - 1
2809+ B1C7 18 02            JR .moBillSetY
2810+ B1C9              .moBillYNeg:
2811+ B1C9 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2812+ B1CB              .moBillSetY:
2813+ B1CB DD 77 07         LD (IX+ENT_DELTAY), A
2814+ B1CE              .moBillNoY:
2815+ B1CE DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2816+ B1D2                  ; Kb heredado por billar: NO es directo del player.
2817+ B1D2                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2818+ B1D2 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2819+ B1D6              .moKbBilliardDone:
2820+ B1D6 DD E1            POP IX
2821+ B1D8                  ; A continua con fuerza reducida (no para del todo)
2822+ B1D8                  ; Reducir velocidad de A a la mitad
2823+ B1D8 DD 7E 06         LD A, (IX+ENT_DELTAX)
2824+ B1DB CB 2F            SRA A                               ; /2 con signo
2825+ B1DD DD 77 06         LD (IX+ENT_DELTAX), A
2826+ B1E0 57               LD D, A
2827+ B1E1 DD 7E 07         LD A, (IX+ENT_DELTAY)
2828+ B1E4 CB 2F            SRA A
2829+ B1E6 DD 77 07         LD (IX+ENT_DELTAY), A
2830+ B1E9 5F               LD E, A
2831+ B1EA                  ; Reducir stun restante de A
2832+ B1EA DD 7E 0A         LD A, (IX+ENT_DIR)
2833+ B1ED FE 08            CP MONSTER_STUN_PAUSE + 2
2834+ B1EF DA 23 B3         JP C, .moStunStop                   ; Casi sin stun → parar
2835+ B1F2 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2836+ B1F4 DD 77 0A         LD (IX+ENT_DIR), A
2837+ B1F7                  ; Aplicar movimiento reducido de A
