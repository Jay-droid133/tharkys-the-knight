 839+ 6495              ; ==============================================================================
 840+ 6495              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 6495              ; ==============================================================================
 842+ 6495              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 6495              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 6495              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 6495              ; 2. Compute new offset random.
 846+ 6495              ; 3. Draw at new offset.
 847+ 6495              ; Destruye: AF, BC, DE, HL, IX.
 848+ 6495              ; ==============================================================================
 849+ 6495              TownGateShakeStep:
 850+ 6495 CD DD 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 6498 CD F8 64         CALL TownGateDrawFingerShifted
 852+ 649B                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 649B ED 5F            LD A, R
 854+ 649D E6 03            AND $03
 855+ 649F 21 C0 64         LD HL, .tgssJitterTable
 856+ 64A2 5F               LD E, A
 857+ 64A3 16 00            LD D, 0
 858+ 64A5 19               ADD HL, DE
 859+ 64A6 7E               LD A, (HL)
 860+ 64A7 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 64AA 3A 48 81         LD A, (GameFrameCounter)
 862+ 64AD E6 03            AND $03
 863+ 64AF 21 C0 64         LD HL, .tgssJitterTable
 864+ 64B2 5F               LD E, A
 865+ 64B3 16 00            LD D, 0
 866+ 64B5 19               ADD HL, DE
 867+ 64B6 7E               LD A, (HL)
 868+ 64B7 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 64BA CD DD 64         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 64BD C3 F8 64         JP TownGateDrawFingerShifted
 871+ 64C0              .tgssJitterTable:
 872+ 64C0 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 64C4
 874+ 64C4              ; ==============================================================================
 875+ 64C4              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 64C4              ; ==============================================================================
 877+ 64C4              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 64C4              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 64C4              ; ==============================================================================
 880+ 64C4              TownGateShakeRestore:
 881+ 64C4 CD DD 64         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 64C7 CD F8 64         CALL TownGateDrawFingerShifted
 883+ 64CA AF               XOR A
 884+ 64CB 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 64CE 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 64D1 11 47 E6         LD DE, BgGfx_arm
 887+ 64D4 CD 4B DA         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 64D7 11 94 E6         LD DE, BgGfx_finger
 889+ 64DA C3 4B DA         JP RedrawPickupByPtr
 890+ 64DD
 891+ 64DD              ; ==============================================================================
 892+ 64DD              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 64DD              ; ==============================================================================
 894+ 64DD              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 64DD              ; Destruye: AF, BC, DE, HL, IX.
 896+ 64DD              ; ==============================================================================
 897+ 64DD              TownGateDrawArmShifted:
 898+ 64DD 21 47 E6         LD HL, BgGfx_arm
 899+ 64E0 3E 03            LD A, 3
 900+ 64E2 CD 7A 6A         CALL LoadBgSpriteToBuffer
 901+ 64E5 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 64E8 47               LD B, A
 903+ 64E9 3E 88            LD A, TGCS_ARM_PX_X
 904+ 64EB 80               ADD A, B
 905+ 64EC 5F               LD E, A
 906+ 64ED 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 64F0 47               LD B, A
 908+ 64F1 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 64F3 80               ADD A, B
 910+ 64F4 57               LD D, A
 911+ 64F5 C3 13 65         JP DrawBgSpriteAnyXorAtPixel
 912+ 64F8
 913+ 64F8              ; ==============================================================================
 914+ 64F8              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 64F8              ; ==============================================================================
 916+ 64F8              TownGateDrawFingerShifted:
 917+ 64F8 21 94 E6         LD HL, BgGfx_finger
 918+ 64FB 3E 03            LD A, 3
 919+ 64FD CD 7A 6A         CALL LoadBgSpriteToBuffer
 920+ 6500 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 6503 47               LD B, A
 922+ 6504 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 6506 80               ADD A, B
 924+ 6507 5F               LD E, A
 925+ 6508 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 650B 47               LD B, A
 927+ 650C 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 650E 80               ADD A, B
 929+ 650F 57               LD D, A
 930+ 6510 C3 13 65         JP DrawBgSpriteAnyXorAtPixel
 931+ 6513
 932+ 6513              ; ==============================================================================
 933+ 6513              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 6513              ; ==============================================================================
 935+ 6513              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 6513              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 6513              ;     E = pixel X (0..255).
 938+ 6513              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 6513              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 6513              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 6513              ; Destruye: AF, BC, DE, HL, IX.
 942+ 6513              ; ==============================================================================
 943+ 6513              DrawBgSpriteAnyXorAtPixel:
 944+ 6513 DD 21 9A 89      LD IX, BgSpriteBuffer
 945+ 6517 DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 651A B7               OR A
 947+ 651B C8               RET Z
 948+ 651C 32 76 65         LD (.dbsaHeight), A
 949+ 651F DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 6522 E6 7F            AND $7F
 951+ 6524 32 77 65         LD (.dbsaWidth), A
 952+ 6527 DD 23            INC IX
 953+ 6529 DD 23            INC IX                              ; -> pixel data
 954+ 652B 7B               LD A, E
 955+ 652C E6 07            AND $07
 956+ 652E 32 78 65         LD (.dbsaShift), A
 957+ 6531 7B               LD A, E
 958+ 6532 E6 F8            AND $F8
 959+ 6534 5F               LD E, A
 960+ 6535 CD A5 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 6538              .dbsaRow:
 962+ 6538 E5               PUSH HL
 963+ 6539 3A 77 65         LD A, (.dbsaWidth)
 964+ 653C 47               LD B, A                             ; B = width counter
 965+ 653D 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 653F              .dbsaByte:
 967+ 653F DD 7E 00         LD A, (IX+0)
 968+ 6542 2F               CPL                                 ; un-invert
 969+ 6543 57               LD D, A                             ; D = sprite byte
 970+ 6544 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 6546 3A 78 65         LD A, (.dbsaShift)
 972+ 6549 B7               OR A
 973+ 654A 28 09            JR Z, .dbsaNoShift
 974+ 654C C5               PUSH BC
 975+ 654D 47               LD B, A
 976+ 654E              .dbsaShiftLoop:
 977+ 654E CB 3A            SRL D
 978+ 6550 CB 1B            RR E
 979+ 6552 10 FA            DJNZ .dbsaShiftLoop
 980+ 6554 C1               POP BC
 981+ 6555              .dbsaNoShift:
 982+ 6555 7A               LD A, D
 983+ 6556 B1               OR C                                ; combinar con carry previo
 984+ 6557 AE               XOR (HL)
 985+ 6558 77               LD (HL), A
 986+ 6559 23               INC HL
 987+ 655A 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 655B DD 23            INC IX
 989+ 655D 10 E0            DJNZ .dbsaByte
 990+ 655F                  ; Byte final (carry) si shift > 0
 991+ 655F 3A 78 65         LD A, (.dbsaShift)
 992+ 6562 B7               OR A
 993+ 6563 28 03            JR Z, .dbsaNoFinal
 994+ 6565 79               LD A, C
 995+ 6566 AE               XOR (HL)
 996+ 6567 77               LD (HL), A
 997+ 6568              .dbsaNoFinal:
 998+ 6568 E1               POP HL
 999+ 6569 CD 11 9E         CALL NextPixelLine
1000+ 656C 3A 76 65         LD A, (.dbsaHeight)
1001+ 656F 3D               DEC A
1002+ 6570 32 76 65         LD (.dbsaHeight), A
1003+ 6573 20 C3            JR NZ, .dbsaRow
1004+ 6575 C9               RET
1005+ 6576 00           .dbsaHeight: DEFB 0
1006+ 6577 00           .dbsaWidth:  DEFB 0
1007+ 6578 00           .dbsaShift:  DEFB 0
