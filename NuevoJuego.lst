  73+ 62B2 3A D5 82         LD A, (PlayerDrawY)
  74+ 62B5 57               LD D, A
  75+ 62B6 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  76+ 62B9 5F               LD E, A
  77+ 62BA DD E5            PUSH IX
  78+ 62BC DD 2A EB A4      LD IX, (SpriteAddrTemp)
  79+ 62C0 CD E0 99         CALL DrawSprite
  80+ 62C3 DD E1            POP IX
  81+ 62C5 3A D5 82         LD A, (PlayerDrawY)
  82+ 62C8 57               LD D, A
  83+ 62C9 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  84+ 62CC 5F               LD E, A
  85+ 62CD DD E5            PUSH IX
  86+ 62CF DD 2A EB A4      LD IX, (SpriteAddrTemp)
  87+ 62D3 CD FD 9A         CALL CalcEntityAttrSize
  88+ 62D6 DD E1            POP IX
  89+ 62D8 3A D5 82         LD A, (PlayerDrawY)
  90+ 62DB 57               LD D, A
  91+ 62DC DD 7E 0F         LD A, (IX+ENT_DRAWX)
  92+ 62DF 5F               LD E, A
  93+ 62E0 DD 7E 05         LD A, (IX+ENT_ATTR)
  94+ 62E3 CD D0 9A         CALL SetEntityAttr
  95+ 62E6 DD 7E 0F         LD A, (IX+ENT_DRAWX)
  96+ 62E9 DD 77 0C         LD (IX+ENT_OLDX), A
  97+ 62EC 3A D5 82         LD A, (PlayerDrawY)
  98+ 62EF DD 77 0D         LD (IX+ENT_OLDY), A
  99+ 62F2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 100+ 62F5 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 101+ 62F8 C9               RET
