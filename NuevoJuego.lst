6682+ C7D1              ; ==============================================================================
6683+ C7D1              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6684+ C7D1              ; ==============================================================================
6685+ C7D1              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6686+ C7D1              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6687+ C7D1              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6688+ C7D1              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6689+ C7D1              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6690+ C7D1              ; main.asm; aqui no hace falta guard adicional).
6691+ C7D1              ; ==============================================================================
6692+ C7D1
6693+ C7D1              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6694+ C7D1              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6695+ C7D1              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6696+ C7D1              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6697+ C7D1              ;
6698+ C7D1              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6699+ C7D1              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6700+ C7D1              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6701+ C7D1              ;
6702+ C7D1              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6703+ C7D1              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6704+ C7D1              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6705+ C7D1              ; en vez de 8 + orientacion invertida).
6706+ C7D1              UpdateDeath:
6707+ C7D1                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6708+ C7D1                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6709+ C7D1                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6710+ C7D1                  ; progreso real, no solo quedar inmovil. ---
6711+ C7D1 2A 91 82         LD HL, (DeathGhostStuckTimer)
6712+ C7D4 23               INC HL
6713+ C7D5 22 91 82         LD (DeathGhostStuckTimer), HL
6714+ C7D8 7C               LD A, H
6715+ C7D9 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6716+ C7DB 38 1A            JR C, .udGhostCheckDone
6717+ C7DD 20 05            JR NZ, .udGhostOn
6718+ C7DF 7D               LD A, L
6719+ C7E0 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6720+ C7E2 38 13            JR C, .udGhostCheckDone
6721+ C7E4              .udGhostOn:
6722+ C7E4                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6723+ C7E4                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6724+ C7E4                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6725+ C7E4                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6726+ C7E4                  ; re-disparar restart).
6727+ C7E4 3A 93 82         LD A, (DeathGhostMode)
6728+ C7E7 B7               OR A
6729+ C7E8 20 0D            JR NZ, .udGhostCheckDone
6730+ C7EA 3E 01            LD A, 1
6731+ C7EC 32 93 82         LD (DeathGhostMode), A
6732+ C7EF 32 18 9D         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6733+ C7F2 3E FE            LD A, $FE                       ; sentinel restart-current-track
6734+ C7F4 CD F2 9C         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6735+ C7F7              .udGhostCheckDone:
6736+ C7F7
6737+ C7F7                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6738+ C7F7 3A 93 82         LD A, (DeathGhostMode)
6739+ C7FA B7               OR A
6740+ C7FB C2 42 C8         JP NZ, DeathGhostChase
6741+ C7FE
6742+ C7FE                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6743+ C7FE DD 7E 03         LD A, (IX+ENT_POSX)
6744+ C801 32 8E 82         LD (DeathPrevX), A
6745+ C804 DD 7E 04         LD A, (IX+ENT_POSY)
6746+ C807 32 8F 82         LD (DeathPrevY), A
6747+ C80A                  ; Sub-pixel acc 1/2
6748+ C80A 3A 8D 82         LD A, (DeathSubPixelAcc)
6749+ C80D EE 01            XOR 1
6750+ C80F 32 8D 82         LD (DeathSubPixelAcc), A
6751+ C812 28 05            JR Z, .udSkip
6752+ C814 CD C5 B0         CALL UpdateMonster                  ; activo: chase + move + animate
6753+ C817 18 03            JR .udPost
6754+ C819              .udSkip:
6755+ C819 CD 95 C8         CALL DeathAnimate                   ; skip: solo animacion
6756+ C81C              .udPost:
6757+ C81C                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6758+ C81C 3A 8E 82         LD A, (DeathPrevX)
6759+ C81F DD BE 03         CP (IX+ENT_POSX)
6760+ C822 20 19            JR NZ, .udMoved
6761+ C824 3A 8F 82         LD A, (DeathPrevY)
6762+ C827 DD BE 04         CP (IX+ENT_POSY)
6763+ C82A 20 11            JR NZ, .udMoved
6764+ C82C                  ; No movio: incrementar BFS counter
6765+ C82C 3A 90 82         LD A, (DeathStuckCounter)
6766+ C82F 3C               INC A
6767+ C830 32 90 82         LD (DeathStuckCounter), A
6768+ C833 FE 06            CP DEATH_STUCK_THRESHOLD
6769+ C835 D8               RET C
6770+ C836 AF               XOR A
6771+ C837 32 90 82         LD (DeathStuckCounter), A
6772+ C83A C3 00 CA         JP DeathBfsRescue
6773+ C83D              .udMoved:
6774+ C83D AF               XOR A
6775+ C83E 32 90 82         LD (DeathStuckCounter), A
6776+ C841 C9               RET
6777+ C842
6778+ C842              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6779+ C842              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6780+ C842              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6781+ C842              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6782+ C842              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6783+ C842              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6784+ C842              DeathGhostChase:
6785+ C842                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6786+ C842 3A 42 81         LD A, (EntityTable + ENT_POSX)
6787+ C845 DD 96 03         SUB (IX+ENT_POSX)
6788+ C848 30 02            JR NC, .udgAbsDxOk
6789+ C84A ED 44            NEG
6790+ C84C              .udgAbsDxOk:
6791+ C84C 47               LD B, A                             ; B = |dx|
6792+ C84D 3A 43 81         LD A, (EntityTable + ENT_POSY)
6793+ C850 DD 96 04         SUB (IX+ENT_POSY)
6794+ C853 30 02            JR NC, .udgAbsDyOk
6795+ C855 ED 44            NEG
6796+ C857              .udgAbsDyOk:
6797+ C857                  ; A = |dy|, B = |dx|
6798+ C857 B8               CP B
6799+ C858 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6800+ C85A
6801+ C85A                  ; --- Eje X primario ---
6802+ C85A AF               XOR A
6803+ C85B DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6804+ C85E 3A 42 81         LD A, (EntityTable + ENT_POSX)
6805+ C861 DD 96 03         SUB (IX+ENT_POSX)
6806+ C864 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6807+ C866 3E 04            LD A, DEATH_GHOST_SPEED
6808+ C868 30 02            JR NC, .udgXSet
6809+ C86A 3E FC            LD A, -DEATH_GHOST_SPEED
6810+ C86C              .udgXSet:
6811+ C86C DD 77 06         LD (IX+ENT_DELTAX), A
6812+ C86F DD 86 03         ADD A, (IX+ENT_POSX)
6813+ C872 DD 77 03         LD (IX+ENT_POSX), A
6814+ C875 18 1B            JR .udgAnim
6815+ C877
6816+ C877                  ; --- Eje Y primario ---
6817+ C877              .udgVertPrim:
6818+ C877 AF               XOR A
6819+ C878 DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6820+ C87B 3A 43 81         LD A, (EntityTable + ENT_POSY)
6821+ C87E DD 96 04         SUB (IX+ENT_POSY)
6822+ C881 28 0F            JR Z, .udgAnim
6823+ C883 3E 04            LD A, DEATH_GHOST_SPEED
6824+ C885 30 02            JR NC, .udgYSet
6825+ C887 3E FC            LD A, -DEATH_GHOST_SPEED
6826+ C889              .udgYSet:
6827+ C889 DD 77 07         LD (IX+ENT_DELTAY), A
6828+ C88C DD 86 04         ADD A, (IX+ENT_POSY)
6829+ C88F DD 77 04         LD (IX+ENT_POSY), A
6830+ C892              .udgAnim:
6831+ C892                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6832+ C892                  ; ser despawneada por una de tres condiciones externas:
6833+ C892                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6834+ C892                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6835+ C892                  ;   3. Player cambia de pantalla (screen_system reset)
6836+ C892                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6837+ C892                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6838+ C892                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6839+ C892 C3 95 C8         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6840+ C895
6841+ C895              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6842+ C895              ; Llamada por:
6843+ C895              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6844+ C895              ;   - UpdateDeath en frame skip (sin movimiento).
6845+ C895              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6846+ C895              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6847+ C895              DeathAnimate:
6848+ C895 DD 7E 06         LD A, (IX+ENT_DELTAX)
6849+ C898 B7               OR A
6850+ C899 28 0A            JR Z, .daKeepDir
6851+ C89B 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6852+ C89D CB 7F            BIT 7, A
6853+ C89F 28 0D            JR Z, .daDir
6854+ C8A1 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6855+ C8A3 18 09            JR .daDir
6856+ C8A5              .daKeepDir:
6857+ C8A5 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6858+ C8A8 DD 96 08         SUB (IX+ENT_ANIMBASE)
6859+ C8AB E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6860+ C8AD 4F               LD C, A
6861+ C8AE              .daDir:
6862+ C8AE DD 35 09         DEC (IX+ENT_ANIMTIMER)
6863+ C8B1 20 16            JR NZ, .daFrameSet
6864+ C8B3 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6865+ C8B7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6866+ C8BA 47               LD B, A
6867+ C8BB DD 96 08         SUB (IX+ENT_ANIMBASE)
6868+ C8BE E6 01            AND 1
6869+ C8C0 20 03            JR NZ, .daFrameDec
6870+ C8C2 04               INC B
6871+ C8C3 18 01            JR .daFrameStore
6872+ C8C5              .daFrameDec:
6873+ C8C5 05               DEC B
6874+ C8C6              .daFrameStore:
6875+ C8C6 DD 70 00         LD (IX+ENT_SPRITEID), B
6876+ C8C9              .daFrameSet:
6877+ C8C9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6878+ C8CC DD 96 08         SUB (IX+ENT_ANIMBASE)
6879+ C8CF E6 01            AND 1
6880+ C8D1 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6881+ C8D4 81               ADD A, C
6882+ C8D5 DD 77 00         LD (IX+ENT_SPRITEID), A
6883+ C8D8 C9               RET
6884+ C8D9
6885+ C8D9              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6886+ C8D9              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6887+ C8D9              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6888+ C8D9              ; timer >= DEATH_SPAWN_FRAMES).
6889+ C8D9              SpawnDeath:
6890+ C8D9                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6891+ C8D9                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6892+ C8D9                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6893+ C8D9                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6894+ C8D9                  ; atravesando el mapa.
6895+ C8D9 CD 84 97         CALL FindFarthestAnyFreeCell
6896+ C8DC C8               RET Z                               ; sin candidato: reintento siguiente frame
6897+ C8DD              .sdHaveCell:
6898+ C8DD                  ; B = cx, C = cy
6899+ C8DD DD 21 EF 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6900+ C8E1                  ; POSX = cx * 8
6901+ C8E1 78               LD A, B
6902+ C8E2 87               ADD A, A
6903+ C8E3 87               ADD A, A
6904+ C8E4 87               ADD A, A
