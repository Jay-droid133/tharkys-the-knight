 389+ A3F0              ; ==============================================================================
 390+ A3F0              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 391+ A3F0              ; ==============================================================================
 392+ A3F0              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 393+ A3F0              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 394+ A3F0              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 395+ A3F0              ; ==============================================================================
 396+ A3F0              ProcessEnemies:
 397+ A3F0 3E 00            LD A, 0
 398+ A3F2 32 3B A4         LD (.peCount), A
 399+ A3F5 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 400+ A3F7
 401+ A3F7              .peLoop:
 402+ A3F7 C5               PUSH BC
 403+ A3F8
 404+ A3F8                  ; Calcular IX desde EnemyStepIdx
 405+ A3F8 3A 02 82         LD A, (EnemyStepIdx)
 406+ A3FB C6 01            ADD A, SLOT_MONSTER0
 407+ A3FD 6F               LD L, A
 408+ A3FE 26 00            LD H, 0
 409+ A400 29               ADD HL, HL
 410+ A401 29               ADD HL, HL
 411+ A402 29               ADD HL, HL
 412+ A403 29               ADD HL, HL                          ; × ENT_SIZE (16)
 413+ A404 11 C7 80         LD DE, EntityTable
 414+ A407 19               ADD HL, DE
 415+ A408 E5               PUSH HL
 416+ A409 DD E1            POP IX
 417+ A40B
 418+ A40B                  ; Avanzar indice round-robin
 419+ A40B 3A 02 82         LD A, (EnemyStepIdx)
 420+ A40E 3C               INC A
 421+ A40F FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 422+ A411 38 01            JR C, .peNoWrap
 423+ A413 AF               XOR A
 424+ A414              .peNoWrap:
 425+ A414 32 02 82         LD (EnemyStepIdx), A
 426+ A417
 427+ A417                  ; Slot activo?
 428+ A417 DD 7E 01         LD A, (IX+ENT_TYPE)
 429+ A41A B7               OR A
 430+ A41B 28 16            JR Z, .peSkip
 431+ A41D
 432+ A41D                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 433+ A41D DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 434+ A421 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 435+ A422
 436+ A422                  ; Procesar esta entidad completa (erase + logic + draw)
 437+ A422 CD 3C A4         CALL ProcessOneEnemy
 438+ A425
 439+ A425                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 440+ A425 F1               POP AF
 441+ A426 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 442+ A428
 443+ A428                  ; Budget check
 444+ A428 3A 3B A4         LD A, (.peCount)
 445+ A42B 3C               INC A
 446+ A42C 32 3B A4         LD (.peCount), A
 447+ A42F FE 02            CP MAX_ENEMIES_PER_FRAME
 448+ A431 30 06            JR NC, .peDone
 449+ A433
 450+ A433              .peSkip:
 451+ A433 C1               POP BC
 452+ A434 05               DEC B
 453+ A435 C2 F7 A3         JP NZ, .peLoop
 454+ A438 C9               RET
 455+ A439
 456+ A439              .peDone:
 457+ A439 C1               POP BC
 458+ A43A C9               RET
 459+ A43B
 460+ A43B 00           .peCount: DEFB 0
 461+ A43C
 462+ A43C              ; ==============================================================================
 463+ A43C              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 464+ A43C              ; ==============================================================================
 465+ A43C              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 466+ A43C              ; ==============================================================================
 467+ A43C              ProcessOneEnemy:
 468+ A43C                  ; --- Dispatch segun estado ---
 469+ A43C DD 7E 02         LD A, (IX+ENT_STATE)
 470+ A43F FE 03            CP STATE_DYING
 471+ A441 CA B3 A6         JP Z, .peDying
 472+ A444 FE 04            CP STATE_SPAWNING
 473+ A446 CA 1C A7         JP Z, .peSpawning
 474+ A449 FE 05            CP STATE_SCARED
 475+ A44B CA 90 A5         JP Z, .peScared
 476+ A44E FE 06            CP STATE_ATTACKING
 477+ A450 CA 83 A5         JP Z, .peAttacking
 478+ A453
 479+ A453                  ; === STATE_RUNNING ===
 480+ A453                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 481+ A453 3A 97 B8         LD A, (ScareTimer)
 482+ A456 B7               OR A
 483+ A457 28 1E            JR Z, .peRunning
 484+ A459 DD 7E 01         LD A, (IX+ENT_TYPE)
 485+ A45C FE 03            CP TYPE_NASTY
 486+ A45E 28 08            JR Z, .peDoScare
 487+ A460 FE 02            CP TYPE_MONSTER
 488+ A462 20 13            JR NZ, .peRunning
 489+ A464                  ; Monster: limpiar stun antes de asustar
 490+ A464 DD 36 0A 00      LD (IX+ENT_DIR), 0
 491+ A468              .peDoScare:
 492+ A468 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 493+ A46C DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 494+ A470 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 495+ A474 C3 90 A5         JP .peScared
 496+ A477              .peRunning:
 497+ A477 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 498+ A47B C2 27 A5         JP NZ, .peFresh
 499+ A47E
 500+ A47E                  ; --- Logica: AI + movimiento + animacion ---
 501+ A47E DD 7E 01         LD A, (IX+ENT_TYPE)
 502+ A481 FE 05            CP TYPE_DEATH
 503+ A483 28 14            JR Z, .peDeathAI
 504+ A485 FE 02            CP TYPE_MONSTER
 505+ A487 20 15            JR NZ, .peNormalAI
 506+ A489 AF               XOR A
