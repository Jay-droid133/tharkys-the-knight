 432  818A                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 433  818A              .frameSync:
 434  818A 76               HALT                        ; Dormir hasta siguiente interrupt
 435  818B 3A 9A 81         LD A, (.frameStart)
 436  818E 47               LD B, A
 437  818F 3A 78 5C         LD A, ($5C78)
