 447+ E71B              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 448+ E71B              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 449+ E71B              ; IX = puntero al primer byte de la decoracion en sprite data
 450+ E71B              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 451+ E71B              ; las (16-C) superiores con $00 (vacio/negro)
 452+ E71B              .drawBar:
 453+ E71B 7D               LD A, L
 454+ E71C 32 67 E7         LD (.dbCol), A                      ; Guardar columna base row 0
 455+ E71F 7B               LD A, E
 456+ E720 32 68 E7         LD (.dbCol1), A                     ; Guardar columna base row 1
 457+ E723 06 10            LD B, 16                            ; 16 scanlines totales
 458+ E725 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 459+ E727                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 460+ E727 3E 10            LD A, 16
 461+ E729 91               SUB C
 462+ E72A 5F               LD E, A                             ; E = primera scanline llena
 463+ E72B              .dbLoop:
 464+ E72B                  ; Calcular direccion VRAM
 465+ E72B 7A               LD A, D
 466+ E72C FE 08            CP 8
 467+ E72E 30 09            JR NC, .dbCalcR1
 468+ E730                  ; Char row 0
 469+ E730 67               LD H, A
 470+ E731 CB F4            SET 6, H
 471+ E733 3A 67 E7         LD A, (.dbCol)
 472+ E736 6F               LD L, A
 473+ E737 18 09            JR .dbWrite
 474+ E739              .dbCalcR1:
 475+ E739                  ; Char row 1
 476+ E739 D6 08            SUB 8
 477+ E73B 67               LD H, A
 478+ E73C CB F4            SET 6, H
 479+ E73E 3A 68 E7         LD A, (.dbCol1)
 480+ E741 6F               LD L, A
 481+ E742              .dbWrite:
 482+ E742                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 483+ E742 7A               LD A, D
 484+ E743 BB               CP E
 485+ E744 30 0B            JR NC, .dbFull
 486+ E746                  ; Marchito: copiar sprite decayed
 487+ E746 FD 7E 00         LD A, (IY+0)
 488+ E749 77               LD (HL), A
 489+ E74A 23               INC HL
 490+ E74B FD 7E 01         LD A, (IY+1)
 491+ E74E 77               LD (HL), A
 492+ E74F 18 09            JR .dbAdvanceSpr
 493+ E751              .dbFull:
 494+ E751                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 495+ E751 DD 7E 00         LD A, (IX+0)
 496+ E754 77               LD (HL), A
 497+ E755 23               INC HL
 498+ E756 DD 7E 01         LD A, (IX+1)
 499+ E759 77               LD (HL), A
 500+ E75A              .dbAdvanceSpr:
 501+ E75A                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 502+ E75A D5               PUSH DE
 503+ E75B 11 06 00         LD DE, 6
 504+ E75E DD 19            ADD IX, DE
 505+ E760 FD 19            ADD IY, DE
 506+ E762 D1               POP DE
 507+ E763 14               INC D
 508+ E764 10 C5            DJNZ .dbLoop
 509+ E766 C9               RET
 510+ E767
 511+ E767 00           .dbCol:  DEFB 0
 512+ E768 00           .dbCol1: DEFB 0
 513+ E769
 514+ E769              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 515+ E769              .levelToColor:
 516+ E769 FE 0C            CP 12
 517+ E76B 30 11            JR NC, .lcGreen
 518+ E76D FE 07            CP 7
 519+ E76F 30 0A            JR NC, .lcCyan
 520+ E771 FE 03            CP 3
 521+ E773 30 03            JR NC, .lcYellow
 522+ E775 3E 42            LD A, RED | $40                     ; 0-2: rojo
 523+ E777 C9               RET
 524+ E778              .lcYellow:
 525+ E778 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 526+ E77A C9               RET
 527+ E77B              .lcCyan:
 528+ E77B 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 529+ E77D C9               RET
 530+ E77E              .lcGreen:
 531+ E77E 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 532+ E780 C9               RET
