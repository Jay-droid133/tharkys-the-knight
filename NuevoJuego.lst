7670+ C9F5 21 00 00         LD HL, 0
7671+ C9F8 22 E9 82         LD (GameOverAnimLastSpr), HL
7672+ C9FB 22 FC 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7673+ C9FE 3E 01            LD A, 1
7674+ CA00 32 F3 82         LD (PlayerRespawnVisible), A
7675+ CA03 3E 00            LD A, BLACK
7676+ CA05 32 88 8D         LD (CurrentBorderColor), A
7677+ CA08 D3 FE            OUT (254), A
7678+ CA0A 3E 01            LD A, 1
7679+ CA0C 32 21 BD         LD (DayCycleCount), A
7680+ CA0F 21 05 BD         LD HL, DiurnalTypeTable
7681+ CA12 22 22 BD         LD (CurrentNastyTable), HL
7682+ CA15                  ; Reset speed + buff (en caso de restart con buff activo).
7683+ CA15 3E 04            LD A, SPEED_RUN
7684+ CA17 32 DA 82         LD (PlayerSpeedRun), A
7685+ CA1A 3E 02            LD A, SPEED_FIGHT
7686+ CA1C 32 DB 82         LD (PlayerSpeedFight), A
7687+ CA1F 21 00 00         LD HL, 0
7688+ CA22 22 DC 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7689+ CA25 22 DF 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7690+ CA28 AF               XOR A
7691+ CA29 32 DE 82         LD (SpeedBuffType), A
7692+ CA2C                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7693+ CA2C                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7694+ CA2C                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7695+ CA2C                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7696+ CA2C                  ; recupera el control. Mismo flujo que tras una muerte.
7697+ CA2C 3E 01            LD A, 1
