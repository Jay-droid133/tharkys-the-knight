 273+ E688 10 FA            DJNZ .drawChar
 274+ E68A                  ; Attr: fila 0, col 0 = $5800
 275+ E68A 3E 47            LD A, $47                           ; blanco bright
 276+ E68C 32 00 58         LD ($5800), A
 277+ E68F C9               RET
