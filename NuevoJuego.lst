 430+ ED4E 32 0D 58         LD ($580D), A
 431+ ED51 32 0E 58         LD ($580E), A
 432+ ED54 32 2D 58         LD ($582D), A
 433+ ED57 32 2E 58         LD ($582E), A
 434+ ED5A                  ; Stamina
 435+ ED5A 3A 4C B3         LD A, (PlayerStamina)
 436+ ED5D CD BB ED         CALL .levelToColor
 437+ ED60 32 11 58         LD ($5811), A
 438+ ED63 32 12 58         LD ($5812), A
 439+ ED66 32 31 58         LD ($5831), A
 440+ ED69 32 32 58         LD ($5832), A
 441+ ED6C C9               RET
 442+ ED6D
 443+ ED6D              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ ED6D              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ ED6D              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ ED6D              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ ED6D              ; las (16-C) superiores con $00 (vacio/negro)
 448+ ED6D              .drawBar:
 449+ ED6D 7D               LD A, L
 450+ ED6E 32 B9 ED         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ ED71 7B               LD A, E
 452+ ED72 32 BA ED         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ ED75 06 10            LD B, 16                            ; 16 scanlines totales
 454+ ED77 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ ED79                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ ED79 3E 10            LD A, 16
 457+ ED7B 91               SUB C
 458+ ED7C 5F               LD E, A                             ; E = primera scanline llena
 459+ ED7D              .dbLoop:
 460+ ED7D                  ; Calcular direccion VRAM
 461+ ED7D 7A               LD A, D
 462+ ED7E FE 08            CP 8
 463+ ED80 30 09            JR NC, .dbCalcR1
 464+ ED82                  ; Char row 0
 465+ ED82 67               LD H, A
 466+ ED83 CB F4            SET 6, H
 467+ ED85 3A B9 ED         LD A, (.dbCol)
 468+ ED88 6F               LD L, A
 469+ ED89 18 09            JR .dbWrite
 470+ ED8B              .dbCalcR1:
 471+ ED8B                  ; Char row 1
 472+ ED8B D6 08            SUB 8
 473+ ED8D 67               LD H, A
 474+ ED8E CB F4            SET 6, H
 475+ ED90 3A BA ED         LD A, (.dbCol1)
 476+ ED93 6F               LD L, A
 477+ ED94              .dbWrite:
 478+ ED94                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ ED94 7A               LD A, D
 480+ ED95 BB               CP E
 481+ ED96 30 0B            JR NC, .dbFull
 482+ ED98                  ; Marchito: copiar sprite decayed
 483+ ED98 FD 7E 00         LD A, (IY+0)
 484+ ED9B 77               LD (HL), A
 485+ ED9C 23               INC HL
 486+ ED9D FD 7E 01         LD A, (IY+1)
 487+ EDA0 77               LD (HL), A
 488+ EDA1 18 09            JR .dbAdvanceSpr
 489+ EDA3              .dbFull:
 490+ EDA3                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EDA3 DD 7E 00         LD A, (IX+0)
 492+ EDA6 77               LD (HL), A
 493+ EDA7 23               INC HL
 494+ EDA8 DD 7E 01         LD A, (IX+1)
 495+ EDAB 77               LD (HL), A
 496+ EDAC              .dbAdvanceSpr:
 497+ EDAC                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EDAC D5               PUSH DE
 499+ EDAD 11 06 00         LD DE, 6
 500+ EDB0 DD 19            ADD IX, DE
 501+ EDB2 FD 19            ADD IY, DE
 502+ EDB4 D1               POP DE
 503+ EDB5 14               INC D
 504+ EDB6 10 C5            DJNZ .dbLoop
 505+ EDB8 C9               RET
 506+ EDB9
 507+ EDB9 00           .dbCol:  DEFB 0
 508+ EDBA 00           .dbCol1: DEFB 0
 509+ EDBB
 510+ EDBB              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EDBB              .levelToColor:
 512+ EDBB FE 0C            CP 12
 513+ EDBD 30 11            JR NC, .lcGreen
 514+ EDBF FE 07            CP 7
 515+ EDC1 30 0A            JR NC, .lcCyan
 516+ EDC3 FE 03            CP 3
 517+ EDC5 30 03            JR NC, .lcYellow
 518+ EDC7 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EDC9 C9               RET
 520+ EDCA              .lcYellow:
 521+ EDCA 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EDCC C9               RET
 523+ EDCD              .lcCyan:
 524+ EDCD 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EDCF C9               RET
 526+ EDD0              .lcGreen:
 527+ EDD0 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EDD2 C9               RET
 529+ EDD3
 530+ EDD3              ; ==============================================================================
 531+ EDD3              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EDD3              ; ==============================================================================
 533+ EDD3              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EDD3              ; ==============================================================================
 535+ EDD3              DrawHandLine:
 536+ EDD3 87               ADD A, A
 537+ EDD4 4F               LD C, A
 538+ EDD5 06 00            LD B, 0
 539+ EDD7 09               ADD HL, BC
 540+ EDD8 7E               LD A, (HL)
 541+ EDD9 23               INC HL
 542+ EDDA 66               LD H, (HL)
 543+ EDDB 6F               LD L, A             ; HL = puntero a datos de línea
 544+ EDDC
 545+ EDDC              .pixLoop:
 546+ EDDC 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EDDD B7               OR A
 548+ EDDE C8               RET Z
 549+ EDDF 57               LD D, A
 550+ EDE0 23               INC HL
 551+ EDE1 7E               LD A, (HL)          ; VRAM L
 552+ EDE2 23               INC HL
 553+ EDE3 5F               LD E, A
 554+ EDE4 7E               LD A, (HL)          ; mask
 555+ EDE5 23               INC HL
 556+ EDE6 E5               PUSH HL
 557+ EDE7 2F               CPL                 ; ~mask
 558+ EDE8 62               LD H, D
 559+ EDE9 6B               LD L, E
 560+ EDEA A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EDEB 77               LD (HL), A
 562+ EDEC E1               POP HL
 563+ EDED 18 ED            JR .pixLoop
 564+ EDEF
 565+ EDEF              ; ==============================================================================
 566+ EDEF              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ EDEF              ; ==============================================================================
 568+ EDEF              CheckClockSpeedKeys:
 569+ EDEF 3E F7            LD A, $F7
 570+ EDF1 DB FE            IN A, ($FE)
 571+ EDF3 2F               CPL
 572+ EDF4 E6 07            AND $07
 573+ EDF6
 574+ EDF6 47               LD B, A
 575+ EDF7 3A BF E9         LD A, (ClockDebounce)
 576+ EDFA 4F               LD C, A
 577+ EDFB 78               LD A, B
 578+ EDFC 32 BF E9         LD (ClockDebounce), A
 579+ EDFF 78               LD A, B
 580+ EE00
 581+ EE00 79               LD A, C
 582+ EE01 2F               CPL
 583+ EE02 A0               AND B
