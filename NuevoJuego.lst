2612+ DA00 19               ADD HL, DE
2613+ DA01 C3 98 D8         JP .cbtLoop
2614+ DA04
2615+ DA04 00           .cbtSpX:    DEFB 0
2616+ DA05 00           .cbtSpY:    DEFB 0
2617+ DA06 00           .cbtSpW:    DEFB 0
2618+ DA07 00           .cbtSpH:    DEFB 0
2619+ DA08 00           .cbtAction: DEFB 0
