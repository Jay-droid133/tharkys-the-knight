1642+ 9B8D              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
1643+ 9B8D              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
1644+ 9B8D              ; ==============================================================================
1645+ 9B8D              ; ==============================================================================
1646+ 9B8D              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1647+ 9B8D              ; ==============================================================================
1648+ 9B8D              UpdateStamina:
1649+ 9B8D                  ; --- Regenerar salud (siempre, lento) ---
1650+ 9B8D 3A 15 A3         LD A, (PlayerHealth)
1651+ 9B90 FE 10            CP HEALTH_MAX
1652+ 9B92 28 12            JR Z, .usHealthFull
1653+ 9B94 21 19 A3         LD HL, HealthRegenCtr
1654+ 9B97 34               INC (HL)
1655+ 9B98 7E               LD A, (HL)
1656+ 9B99 FE 32            CP HEALTH_REGEN_RATE
1657+ 9B9B 38 09            JR C, .usHealthFull
1658+ 9B9D 36 00            LD (HL), 0
1659+ 9B9F 3A 15 A3         LD A, (PlayerHealth)
1660+ 9BA2 3C               INC A
1661+ 9BA3 32 15 A3         LD (PlayerHealth), A
1662+ 9BA6              .usHealthFull:
1663+ 9BA6                  ; --- Stamina: consumir o regenerar ---
1664+ 9BA6 DD 7E 02         LD A, (IX+ENT_STATE)
1665+ 9BA9 FE 02            CP STATE_FIGHTING
1666+ 9BAB 28 18            JR Z, .usDrain
1667+ 9BAD                  ; No atacando: regenerar
1668+ 9BAD 3A 16 A3         LD A, (PlayerStamina)
1669+ 9BB0 FE 10            CP STAMINA_MAX
1670+ 9BB2 C8               RET Z                               ; Ya al maximo
1671+ 9BB3 21 18 A3         LD HL, StaminaRegenCtr
1672+ 9BB6 34               INC (HL)
1673+ 9BB7 7E               LD A, (HL)
1674+ 9BB8 FE 19            CP STAMINA_REGEN_RATE
1675+ 9BBA D8               RET C                               ; Aun no toca
1676+ 9BBB 36 00            LD (HL), 0                          ; Reset counter
1677+ 9BBD 3A 16 A3         LD A, (PlayerStamina)
1678+ 9BC0 3C               INC A
1679+ 9BC1 32 16 A3         LD (PlayerStamina), A
1680+ 9BC4 C9               RET
1681+ 9BC5              .usDrain:
1682+ 9BC5                  ; Atacando: consumir stamina
1683+ 9BC5 3A 16 A3         LD A, (PlayerStamina)
1684+ 9BC8 B7               OR A
1685+ 9BC9 C8               RET Z                               ; Ya vacia
1686+ 9BCA 21 17 A3         LD HL, StaminaDrainCtr
1687+ 9BCD 34               INC (HL)
1688+ 9BCE 7E               LD A, (HL)
1689+ 9BCF FE 0D            CP STAMINA_DRAIN_RATE
