 142+ E475 3A F6 E3         LD A, (CurrentTimeOfDay)
 143+ E478 21 74 E8         LD HL, RemapHouseTablePtrs
 144+ E47B 5F               LD E, A
 145+ E47C 16 00            LD D, 0
 146+ E47E 19               ADD HL, DE
 147+ E47F 19               ADD HL, DE
 148+ E480 5E               LD E, (HL)
 149+ E481 23               INC HL
 150+ E482 56               LD D, (HL)
 151+ E483 ED 53 F9 E3      LD (CurrentHouseRemapTable), DE
 152+ E487 C9               RET
 153+ E488
 154+ E488              ; ==============================================================================
 155+ E488              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E488              ; ==============================================================================
 157+ E488              CheckDebugKeys:
 158+ E488 3E FB            LD A, $FB
 159+ E48A DB FE            IN A, ($FE)
 160+ E48C CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E48E 20 1C            JR NZ, .notPressed
 162+ E490
 163+ E490                  ; Tecla pulsada: comprobar debounce
 164+ E490 3A FD E3         LD A, (DebugKeyDebounce)
 165+ E493 B7               OR A
 166+ E494 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E495
 168+ E495                  ; Primera pulsacion: ciclar
 169+ E495 3E 01            LD A, 1
 170+ E497 32 FD E3         LD (DebugKeyDebounce), A
 171+ E49A
 172+ E49A 3A F6 E3         LD A, (CurrentTimeOfDay)
 173+ E49D 3C               INC A
 174+ E49E FE 07            CP NUM_TIME_MOMENTS
 175+ E4A0 38 01            JR C, .noWrap
 176+ E4A2 AF               XOR A                   ; Volver a 0 (Dia)
 177+ E4A3              .noWrap:
 178+ E4A3 F5               PUSH AF
 179+ E4A4 CD FE E3         CALL SetTimeOfDay
 180+ E4A7 F1               POP AF
 181+ E4A8 CD 42 EC         CALL SetClockToPhaseHour
 182+ E4AB C9               RET
 183+ E4AC
 184+ E4AC              .notPressed:
 185+ E4AC AF               XOR A
 186+ E4AD 32 FD E3         LD (DebugKeyDebounce), A
 187+ E4B0
 188+ E4B0                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E4B0 3E FD            LD A, $FD
 190+ E4B2 DB FE            IN A, ($FE)
 191+ E4B4 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E4B5 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E4B7 20 13            JR NZ, .sNotPressed
 194+ E4B9 3A 07 E5         LD A, (SpeedKeyDebounce)
 195+ E4BC B7               OR A
 196+ E4BD C0               RET NZ
 197+ E4BE 3E 01            LD A, 1
 198+ E4C0 32 07 E5         LD (SpeedKeyDebounce), A
 199+ E4C3 21 24 BD         LD HL, DayCycleCount
 200+ E4C6 7E               LD A, (HL)
 201+ E4C7 FE 0A            CP 10
 202+ E4C9 D0               RET NC                  ; Ya en maximo
 203+ E4CA 34               INC (HL)
 204+ E4CB C9               RET
 205+ E4CC              .sNotPressed:
 206+ E4CC                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E4CC CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E4CE 20 13            JR NZ, .dNotPressed
 209+ E4D0 3A 07 E5         LD A, (SpeedKeyDebounce)
 210+ E4D3 B7               OR A
 211+ E4D4 C0               RET NZ
 212+ E4D5 3E 01            LD A, 1
 213+ E4D7 32 07 E5         LD (SpeedKeyDebounce), A
 214+ E4DA 21 24 BD         LD HL, DayCycleCount
 215+ E4DD 7E               LD A, (HL)
 216+ E4DE FE 01            CP 1
 217+ E4E0 C8               RET Z                   ; Ya en minimo
 218+ E4E1 35               DEC (HL)
 219+ E4E2 C9               RET
 220+ E4E3              .dNotPressed:
 221+ E4E3 AF               XOR A
 222+ E4E4 32 07 E5         LD (SpeedKeyDebounce), A
