 765+ E7C1 6F               LD L, A
 766+ E7C2 26 00            LD H, 0
 767+ E7C4 29               ADD HL, HL
 768+ E7C5 29               ADD HL, HL
 769+ E7C6 29               ADD HL, HL
 770+ E7C7 01 00 3C         LD BC, $3C00
 771+ E7CA 09               ADD HL, BC                  ; HL = font data
 772+ E7CB
 773+ E7CB                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E7CB 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E7CD 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E7CF 83               ADD A, E
 777+ E7D0 5F               LD E, A                     ; DE = dir VRAM
