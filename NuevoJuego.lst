 378+ EC70              ; ==============================================================================
 379+ EC70              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EC70              ; ==============================================================================
 381+ EC70              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EC70              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EC70              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EC70              ; ==============================================================================
 385+ EC70              DrawHealthStaminaHUD:
 386+ EC70                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EC70 3A 52 B3         LD A, (PlayerHealth)
 388+ EC73 4F               LD C, A                             ; C = nivel (0-16)
 389+ EC74 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EC77 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EC7A DD 21 56 E8      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EC7E FD 21 C7 E8      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EC82 CD E8 EC         CALL .drawBar
 394+ EC85
 395+ EC85                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EC85 3A 53 B3         LD A, (PlayerStamina)
 397+ EC88 4F               LD C, A
 398+ EC89 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EC8C 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EC8F DD 21 5A E8      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EC93 FD 21 CB E8      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EC97 CD E8 EC         CALL .drawBar
 403+ EC9A
 404+ EC9A                  ; --- Flash de recuperacion del pozo ---
 405+ EC9A 3A 5A 8D         LD A, (WellFlashTimer)
 406+ EC9D B7               OR A
 407+ EC9E 28 23            JR Z, .noFlash
 408+ ECA0 3D               DEC A
 409+ ECA1 32 5A 8D         LD (WellFlashTimer), A
 410+ ECA4                  ; Flash: alternar blanco/normal cada 4 frames
 411+ ECA4 E6 04            AND $04
 412+ ECA6 28 1B            JR Z, .noFlash
 413+ ECA8                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ ECA8                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ ECA8 3E 47            LD A, WHITE | $40
 416+ ECAA 32 0D 58         LD ($580D), A
 417+ ECAD 32 0E 58         LD ($580E), A
 418+ ECB0 32 2D 58         LD ($582D), A
 419+ ECB3 32 2E 58         LD ($582E), A
 420+ ECB6 32 11 58         LD ($5811), A
 421+ ECB9 32 12 58         LD ($5812), A
 422+ ECBC 32 31 58         LD ($5831), A
 423+ ECBF 32 32 58         LD ($5832), A
 424+ ECC2 C9               RET
 425+ ECC3              .noFlash:
 426+ ECC3                  ; --- Attrs segun nivel (normal) ---
 427+ ECC3                  ; Salud
 428+ ECC3 3A 52 B3         LD A, (PlayerHealth)
 429+ ECC6 CD 36 ED         CALL .levelToColor
 430+ ECC9 32 0D 58         LD ($580D), A
 431+ ECCC 32 0E 58         LD ($580E), A
 432+ ECCF 32 2D 58         LD ($582D), A
 433+ ECD2 32 2E 58         LD ($582E), A
 434+ ECD5                  ; Stamina
 435+ ECD5 3A 53 B3         LD A, (PlayerStamina)
 436+ ECD8 CD 36 ED         CALL .levelToColor
 437+ ECDB 32 11 58         LD ($5811), A
 438+ ECDE 32 12 58         LD ($5812), A
 439+ ECE1 32 31 58         LD ($5831), A
 440+ ECE4 32 32 58         LD ($5832), A
 441+ ECE7 C9               RET
 442+ ECE8
 443+ ECE8              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ ECE8              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ ECE8              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ ECE8              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ ECE8              ; las (16-C) superiores con $00 (vacio/negro)
 448+ ECE8              .drawBar:
 449+ ECE8 7D               LD A, L
 450+ ECE9 32 34 ED         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ ECEC 7B               LD A, E
 452+ ECED 32 35 ED         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ ECF0 06 10            LD B, 16                            ; 16 scanlines totales
 454+ ECF2 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ ECF4                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ ECF4 3E 10            LD A, 16
 457+ ECF6 91               SUB C
 458+ ECF7 5F               LD E, A                             ; E = primera scanline llena
 459+ ECF8              .dbLoop:
 460+ ECF8                  ; Calcular direccion VRAM
 461+ ECF8 7A               LD A, D
 462+ ECF9 FE 08            CP 8
 463+ ECFB 30 09            JR NC, .dbCalcR1
 464+ ECFD                  ; Char row 0
 465+ ECFD 67               LD H, A
 466+ ECFE CB F4            SET 6, H
 467+ ED00 3A 34 ED         LD A, (.dbCol)
 468+ ED03 6F               LD L, A
 469+ ED04 18 09            JR .dbWrite
 470+ ED06              .dbCalcR1:
 471+ ED06                  ; Char row 1
 472+ ED06 D6 08            SUB 8
 473+ ED08 67               LD H, A
 474+ ED09 CB F4            SET 6, H
 475+ ED0B 3A 35 ED         LD A, (.dbCol1)
 476+ ED0E 6F               LD L, A
 477+ ED0F              .dbWrite:
 478+ ED0F                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ ED0F 7A               LD A, D
 480+ ED10 BB               CP E
 481+ ED11 30 0B            JR NC, .dbFull
 482+ ED13                  ; Marchito: copiar sprite decayed
 483+ ED13 FD 7E 00         LD A, (IY+0)
 484+ ED16 77               LD (HL), A
 485+ ED17 23               INC HL
 486+ ED18 FD 7E 01         LD A, (IY+1)
 487+ ED1B 77               LD (HL), A
 488+ ED1C 18 09            JR .dbAdvanceSpr
 489+ ED1E              .dbFull:
 490+ ED1E                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ ED1E DD 7E 00         LD A, (IX+0)
 492+ ED21 77               LD (HL), A
 493+ ED22 23               INC HL
 494+ ED23 DD 7E 01         LD A, (IX+1)
 495+ ED26 77               LD (HL), A
 496+ ED27              .dbAdvanceSpr:
 497+ ED27                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ ED27 D5               PUSH DE
 499+ ED28 11 06 00         LD DE, 6
 500+ ED2B DD 19            ADD IX, DE
 501+ ED2D FD 19            ADD IY, DE
 502+ ED2F D1               POP DE
 503+ ED30 14               INC D
 504+ ED31 10 C5            DJNZ .dbLoop
 505+ ED33 C9               RET
 506+ ED34
 507+ ED34 00           .dbCol:  DEFB 0
 508+ ED35 00           .dbCol1: DEFB 0
