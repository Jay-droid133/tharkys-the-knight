 293+ DE64              ; ==============================================================================
 294+ DE64              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 295+ DE64              ; ==============================================================================
 296+ DE64              ; Entrada: A = attr original
 297+ DE64              ; Salida:  A = attr transformado
 298+ DE64              ; Preserva: HL, DE, BC, IX
 299+ DE64              ; ==============================================================================
 300+ DE64              ApplyDayCycleRemap:
 301+ DE64 E5               PUSH HL
 302+ DE65 67               LD H, A                     ; H = attr (temp save)
 303+ DE66 3A 02 DD         LD A, (CurrentTimeOfDay)
 304+ DE69 B7               OR A
 305+ DE6A 20 03            JR NZ, .doRemap
 306+ DE6C 7C               LD A, H                     ; Dia: devolver sin cambio
 307+ DE6D E1               POP HL
 308+ DE6E C9               RET
 309+ DE6F
 310+ DE6F              .doRemap:
 311+ DE6F D5               PUSH DE
 312+ DE70 C5               PUSH BC
 313+ DE71
 314+ DE71 7C               LD A, H                     ; A = attr original
 315+ DE72 4F               LD C, A                     ; C = attr original
 316+ DE73
 317+ DE73                  ; Guardar flash + ink (bits 7, 2-0)
 318+ DE73 E6 87            AND $87                     ; A = F000_0III
 319+ DE75 47               LD B, A                     ; B = flash | ink
 320+ DE76
 321+ DE76                  ; Extraer paper+bright como indice 0-15
 322+ DE76 79               LD A, C
 323+ DE77 E6 78            AND $78                     ; A = 0BPPP000
 324+ DE79 0F               RRCA
 325+ DE7A 0F               RRCA
 326+ DE7B 0F               RRCA                        ; A = 0000BPPP = indice
 327+ DE7C
 328+ DE7C                  ; Elegir tabla segun tipo de sprite
 329+ DE7C 5F               LD E, A
 330+ DE7D 16 00            LD D, 0
 331+ DE7F 3A 07 DD         LD A, (BgSpriteIsHouse)
 332+ DE82 B7               OR A
 333+ DE83 28 05            JR Z, .useStdTable
 334+ DE85 2A 05 DD         LD HL, (CurrentHouseRemapTable)
 335+ DE88 18 03            JR .doLookup
 336+ DE8A              .useStdTable:
 337+ DE8A 2A 03 DD         LD HL, (CurrentRemapTable)
 338+ DE8D              .doLookup:
 339+ DE8D 19               ADD HL, DE
 340+ DE8E 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 341+ DE8F
 342+ DE8F                  ; Reconstruir atributo
 343+ DE8F 07               RLCA
 344+ DE90 07               RLCA
 345+ DE91 07               RLCA                        ; A = 0BPPP000
 346+ DE92 B0               OR B                        ; A = FBPPPIII
 347+ DE93
 348+ DE93 C1               POP BC
 349+ DE94 D1               POP DE
 350+ DE95 E1               POP HL
 351+ DE96 C9               RET
