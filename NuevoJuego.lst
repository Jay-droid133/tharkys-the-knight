  16+ 9D47              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9D47              ; ==============================================================================
  18+ 9D47              ; Entrada:
  19+ 9D47              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9D47              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9D47              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9D47              ;
  23+ 9D47              ; Formato del sprite:
  24+ 9D47              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9D47              ;   DEFB height_pixels
  26+ 9D47              ;   DEFB pixel_data... (width * height bytes)
  27+ 9D47              ;
  28+ 9D47              ; Dos paths:
  29+ 9D47              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9D47              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9D47              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9D47              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9D47              ;
  34+ 9D47              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9D47              ;
  36+ 9D47              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9D47              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9D47              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9D47              ; alto la restauracion del bank.
  40+ 9D47              ; ==============================================================================
  41+ 9D47              DrawSprite:
  42+ 9D47                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9D47                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9D47                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9D47 3A 8F 90         LD A, (CurrentPaging)
  46+ 9D4A E6 F8            AND $F8
  47+ 9D4C F6 06            OR 6
  48+ 9D4E 32 8F 90         LD (CurrentPaging), A
  49+ 9D51 01 FD 7F         LD BC, $7FFD
  50+ 9D54 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9D56 CD 67 9D         CALL _DrawSpriteImpl
  52+ 9D59                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9D59                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9D59 3A 8F 90         LD A, (CurrentPaging)
  55+ 9D5C E6 F8            AND $F8
  56+ 9D5E 32 8F 90         LD (CurrentPaging), A
  57+ 9D61 01 FD 7F         LD BC, $7FFD
  58+ 9D64 ED 79            OUT (C), A
  59+ 9D66 C9               RET
  60+ 9D67
  61+ 9D67              _DrawSpriteImpl:
  62+ 9D67                  ; Guardar posicion
  63+ 9D67 7A               LD A, D
  64+ 9D68 32 21 9E         LD (.posY), A
  65+ 9D6B 7B               LD A, E
  66+ 9D6C 32 20 9E         LD (.posX), A
  67+ 9D6F
  68+ 9D6F                  ; Leer cabecera sprite
  69+ 9D6F DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9D72 32 22 9E         LD (.widthSave), A
  71+ 9D75 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9D78 32 23 9E         LD (.heightSave), A
  73+ 9D7B DD 23            INC IX
  74+ 9D7D DD 23            INC IX                      ; IX → pixel data
  75+ 9D7F
  76+ 9D7F                  ; === Y CLIPPING ===
  77+ 9D7F                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9D7F 3A 21 9E         LD A, (.posY)
  79+ 9D82 FE 10            CP SCREEN_MIN_Y
  80+ 9D84 30 20            JR NC, .clipTopDone
  81+ 9D86                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9D86 47               LD B, A                     ; B = Y
  83+ 9D87 3E 10            LD A, SCREEN_MIN_Y
  84+ 9D89 90               SUB B                       ; A = filas a saltar
  85+ 9D8A 47               LD B, A                     ; B = skip rows
  86+ 9D8B                  ; Reducir altura
  87+ 9D8B 3A 23 9E         LD A, (.heightSave)
  88+ 9D8E 90               SUB B
  89+ 9D8F C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9D90 D8               RET C                       ; Idem
  91+ 9D91 32 23 9E         LD (.heightSave), A
  92+ 9D94                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9D94 3A 22 9E         LD A, (.widthSave)
  94+ 9D97 4F               LD C, A
  95+ 9D98              .clipSkipRow:
  96+ 9D98 79               LD A, C
  97+ 9D99              .clipSkipByte:
  98+ 9D99 DD 23            INC IX
  99+ 9D9B 3D               DEC A
 100+ 9D9C 20 FB            JR NZ, .clipSkipByte
 101+ 9D9E 10 F8            DJNZ .clipSkipRow
 102+ 9DA0                  ; Ajustar Y al borde
 103+ 9DA0 3E 10            LD A, SCREEN_MIN_Y
 104+ 9DA2 32 21 9E         LD (.posY), A
 105+ 9DA5 57               LD D, A
 106+ 9DA6              .clipTopDone:
 107+ 9DA6                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9DA6 3A 21 9E         LD A, (.posY)
 109+ 9DA9 47               LD B, A
 110+ 9DAA 3A 23 9E         LD A, (.heightSave)
 111+ 9DAD 80               ADD A, B                    ; A = Y + height
 112+ 9DAE 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9DB0 FE C0            CP 192
 114+ 9DB2 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9DB4              .clipBot:
 116+ 9DB4                  ; Reducir altura: new_height = 192 - Y
 117+ 9DB4 3E C0            LD A, 192
 118+ 9DB6 90               SUB B                       ; A = 192 - Y
 119+ 9DB7 C8               RET Z
 120+ 9DB8 D8               RET C
 121+ 9DB9 32 23 9E         LD (.heightSave), A
 122+ 9DBC              .clipBotDone:
