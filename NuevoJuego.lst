 501  E3EA                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 502  E3EA                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 503  E3EA                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
