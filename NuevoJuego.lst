1400+ F48F              ; ==============================================================================
1401+ F48F              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1402+ F48F              ; ==============================================================================
1403+ F48F              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1404+ F48F              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1405+ F48F              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1406+ F48F              ; ==============================================================================
1407+ F48F              ChurchCutsceneInitStatueShake:
1408+ F48F 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1409+ F492 21 A9 69         LD HL, StatueIdTable
1410+ F495 5F               LD E, A
1411+ F496 16 00            LD D, 0
1412+ F498 19               ADD HL, DE
1413+ F499 7E               LD A, (HL)                              ; A = statue id
1414+ F49A B7               OR A
1415+ F49B C8               RET Z                                   ; sin estatua
1416+ F49C 32 CC F4         LD (.cisTargetId), A
1417+ F49F                  ; Buscar en CurrentScreenBuffer
1418+ F49F 2A 0D 83         LD HL, (CurrentScreenAddr)
1419+ F4A2              .cisLoop:
1420+ F4A2 7E               LD A, (HL)
1421+ F4A3 FE FF            CP $FF
1422+ F4A5 C8               RET Z                                   ; no encontrada (no se hace shake)
1423+ F4A6 47               LD B, A
1424+ F4A7 3A CC F4         LD A, (.cisTargetId)
1425+ F4AA B8               CP B
1426+ F4AB 28 06            JR Z, .cisFound
1427+ F4AD 11 04 00         LD DE, 4
1428+ F4B0 19               ADD HL, DE
1429+ F4B1 18 EF            JR .cisLoop
1430+ F4B3              .cisFound:
1431+ F4B3 23               INC HL
1432+ F4B4 7E               LD A, (HL)                              ; charX
1433+ F4B5                  ; Pixel X = charX * 8
1434+ F4B5 87               ADD A, A
1435+ F4B6 87               ADD A, A
1436+ F4B7 87               ADD A, A
1437+ F4B8 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1438+ F4BB 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1439+ F4BE 23               INC HL
1440+ F4BF 7E               LD A, (HL)                              ; charY
1441+ F4C0                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1442+ F4C0 C6 02            ADD A, BG_Y_OFFSET
1443+ F4C2 87               ADD A, A
1444+ F4C3 87               ADD A, A
1445+ F4C4 87               ADD A, A
