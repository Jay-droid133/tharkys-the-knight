 301+ E4C0              ; ==============================================================================
 302+ E4C0              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E4C0              ; ==============================================================================
 304+ E4C0              ; Entrada: A = attr original
 305+ E4C0              ; Salida:  A = attr transformado
 306+ E4C0              ; Preserva: HL, DE, BC, IX
 307+ E4C0              ; ==============================================================================
 308+ E4C0              ApplyDayCycleRemap:
 309+ E4C0 E5               PUSH HL
 310+ E4C1 67               LD H, A                     ; H = attr (temp save)
 311+ E4C2                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E4C2 3A 5B E3         LD A, (BgSpriteSkipRemap)
 313+ E4C5 B7               OR A
 314+ E4C6 20 06            JR NZ, .skipRemap
 315+ E4C8 3A 55 E3         LD A, (CurrentTimeOfDay)
 316+ E4CB B7               OR A
 317+ E4CC 20 03            JR NZ, .doRemap
 318+ E4CE              .skipRemap:
 319+ E4CE 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E4CF E1               POP HL
 321+ E4D0 C9               RET
 322+ E4D1
 323+ E4D1              .doRemap:
 324+ E4D1 D5               PUSH DE
 325+ E4D2 C5               PUSH BC
 326+ E4D3
 327+ E4D3 7C               LD A, H                     ; A = attr original
 328+ E4D4 4F               LD C, A                     ; C = attr original
 329+ E4D5
 330+ E4D5                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E4D5 E6 87            AND $87                     ; A = F000_0III
 332+ E4D7 47               LD B, A                     ; B = flash | ink
 333+ E4D8
 334+ E4D8                  ; Extraer paper+bright como indice 0-15
 335+ E4D8 79               LD A, C
 336+ E4D9 E6 78            AND $78                     ; A = 0BPPP000
 337+ E4DB 0F               RRCA
 338+ E4DC 0F               RRCA
 339+ E4DD 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E4DE
 341+ E4DE                  ; Elegir tabla segun tipo de sprite
 342+ E4DE 5F               LD E, A
 343+ E4DF 16 00            LD D, 0
 344+ E4E1 3A 5A E3         LD A, (BgSpriteIsHouse)
 345+ E4E4 B7               OR A
 346+ E4E5 28 05            JR Z, .useStdTable
 347+ E4E7 2A 58 E3         LD HL, (CurrentHouseRemapTable)
 348+ E4EA 18 03            JR .doLookup
 349+ E4EC              .useStdTable:
 350+ E4EC 2A 56 E3         LD HL, (CurrentRemapTable)
 351+ E4EF              .doLookup:
 352+ E4EF 19               ADD HL, DE
 353+ E4F0 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E4F1
 355+ E4F1                  ; Reconstruir atributo
 356+ E4F1 07               RLCA
 357+ E4F2 07               RLCA
 358+ E4F3 07               RLCA                        ; A = 0BPPP000
 359+ E4F4 B0               OR B                        ; A = FBPPPIII
 360+ E4F5
 361+ E4F5 C1               POP BC
 362+ E4F6 D1               POP DE
 363+ E4F7 E1               POP HL
 364+ E4F8 C9               RET
 365+ E4F9
 366+ E4F9              ; ==============================================================================
 367+ E4F9              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E4F9              ; ==============================================================================
 369+ E4F9              ; Entrada: A = sprite ID
 370+ E4F9              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E4F9              ; Preserva: A, DE, IX
 372+ E4F9              ;
 373+ E4F9              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E4F9              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E4F9              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E4F9              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E4F9              ; ==============================================================================
 378+ E4F9              CheckIfHouseSprite:
 379+ E4F9 F5               PUSH AF
 380+ E4FA E5               PUSH HL
 381+ E4FB C5               PUSH BC
 382+ E4FC
 383+ E4FC 47               LD B, A                     ; B = id buscado
 384+ E4FD
 385+ E4FD AF               XOR A
 386+ E4FE 32 5A E3         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E501
 388+ E501 21 12 E0         LD HL, HouseIdList
 389+ E504              .checkLoop:
 390+ E504 7E               LD A, (HL)
 391+ E505 FE FF            CP $FF
 392+ E507 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E509 B8               CP B
 394+ E50A 28 03            JR Z, .checkFound
 395+ E50C 23               INC HL
 396+ E50D 18 F5            JR .checkLoop
 397+ E50F
 398+ E50F              .checkFound:
 399+ E50F 3E 01            LD A, 1
 400+ E511 32 5A E3         LD (BgSpriteIsHouse), A
 401+ E514
 402+ E514              .checkDone:
 403+ E514 C1               POP BC
 404+ E515 E1               POP HL
 405+ E516 F1               POP AF
 406+ E517 C9               RET
 407+ E518
 408+ E518              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E518              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E518              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E518
 412+ E518              ; ==============================================================================
 413+ E518              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 414+ E518              ; ==============================================================================
 415+ E518              ; Formato: XX,YY:NN nombre_room     DY
 416+ E518              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 417+ E518              ; ==============================================================================
 418+ E518              DrawRoomInfo:
 419+ E518                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E518 1E 00            LD E, 0
 421+ E51A 06 0D            LD B, 13
 422+ E51C              .clearLoop:
 423+ E51C C5               PUSH BC
 424+ E51D D5               PUSH DE
 425+ E51E 3E 20            LD A, ' '
 426+ E520 CD D3 E6         CALL DrawHudChar
 427+ E523 D1               POP DE
 428+ E524 C1               POP BC
 429+ E525 1C               INC E
 430+ E526 10 F4            DJNZ .clearLoop
 431+ E528
 432+ E528                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 433+ E528 3A 01 83         LD A, (CurrentScreenX)
 434+ E52B 1E 00            LD E, 0
 435+ E52D CD 8B E5         CALL .drawDec2
 436+ E530
 437+ E530                  ; --- ',' en col 2 ---
 438+ E530 3E 2C            LD A, ','
 439+ E532 1E 02            LD E, 2
 440+ E534 CD D3 E6         CALL DrawHudChar
 441+ E537
 442+ E537                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E537 3A 02 83         LD A, (CurrentScreenY)
 444+ E53A 1E 03            LD E, 3
 445+ E53C CD 8B E5         CALL .drawDec2
 446+ E53F
 447+ E53F                  ; --- ':' en col 5 ---
 448+ E53F 3E 3A            LD A, ':'
 449+ E541 1E 05            LD E, 5
 450+ E543 CD D3 E6         CALL DrawHudChar
 451+ E546
 452+ E546                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E546 3A 02 83         LD A, (CurrentScreenY)
 454+ E549 6F               LD L, A
 455+ E54A 26 00            LD H, 0
 456+ E54C 29               ADD HL, HL
 457+ E54D 29               ADD HL, HL
 458+ E54E 29               ADD HL, HL
 459+ E54F 29               ADD HL, HL                  ; HL = Y * 16
 460+ E550 3A 01 83         LD A, (CurrentScreenX)
 461+ E553 5F               LD E, A
 462+ E554 16 00            LD D, 0
 463+ E556 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E557 11 E3 DD         LD DE, MapTable
 465+ E55A 19               ADD HL, DE
 466+ E55B 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E55C F5               PUSH AF                     ; guardar room index
 468+ E55D
 469+ E55D                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E55D F5               PUSH AF
 471+ E55E 0F               RRCA
 472+ E55F 0F               RRCA
 473+ E560 0F               RRCA
 474+ E561 0F               RRCA
 475+ E562 E6 0F            AND $0F
 476+ E564 CD A9 E5         CALL .hexToAscii
 477+ E567 1E 06            LD E, 6
 478+ E569 CD D3 E6         CALL DrawHudChar
 479+ E56C F1               POP AF
 480+ E56D E6 0F            AND $0F
 481+ E56F CD A9 E5         CALL .hexToAscii
 482+ E572 1E 07            LD E, 7
 483+ E574 CD D3 E6         CALL DrawHudChar
 484+ E577
 485+ E577                  ; --- Espacio en col 8 ---
 486+ E577 3E 20            LD A, ' '
 487+ E579 1E 08            LD E, 8
 488+ E57B CD D3 E6         CALL DrawHudChar
 489+ E57E
 490+ E57E                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E57E F1               POP AF                      ; A = room index (descartar)
 492+ E57F
 493+ E57F                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E57F 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E582 3E 47            LD A, $47                   ; bright white on black
 496+ E584 06 0D            LD B, 13
 497+ E586              .attrLoop:
 498+ E586 77               LD (HL), A
 499+ E587 23               INC HL
 500+ E588 10 FC            DJNZ .attrLoop
 501+ E58A C9               RET
 502+ E58B
 503+ E58B              ; --- Helpers ---
 504+ E58B              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E58B              .drawDec2:
 506+ E58B 4B               LD C, E                     ; guardar columna inicial
 507+ E58C 06 00            LD B, 0                     ; decenas
 508+ E58E              .divLoop:
 509+ E58E FE 0A            CP 10
 510+ E590 38 05            JR C, .divDone
 511+ E592 D6 0A            SUB 10
 512+ E594 04               INC B
 513+ E595 18 F7            JR .divLoop
 514+ E597              .divDone:
 515+ E597                  ; B = decenas, A = unidades
 516+ E597 F5               PUSH AF                     ; guardar unidades
 517+ E598 78               LD A, B
 518+ E599 C6 30            ADD A, '0'
 519+ E59B 59               LD E, C
 520+ E59C C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E59D CD D3 E6         CALL DrawHudChar
 522+ E5A0 C1               POP BC                      ; restaurar C
 523+ E5A1 F1               POP AF
 524+ E5A2 C6 30            ADD A, '0'
 525+ E5A4 59               LD E, C
 526+ E5A5 1C               INC E
 527+ E5A6 C3 D3 E6         JP DrawHudChar              ; tail call
 528+ E5A9
 529+ E5A9              .hexToAscii:
 530+ E5A9 FE 0A            CP 10
 531+ E5AB 38 03            JR C, .isDigit
 532+ E5AD C6 37            ADD A, 'A' - 10
 533+ E5AF C9               RET
 534+ E5B0              .isDigit:
 535+ E5B0 C6 30            ADD A, '0'
 536+ E5B2 C9               RET
 537+ E5B3
 538+ E5B3              ; ==============================================================================
 539+ E5B3              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E5B3              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E5B3              ; ==============================================================================
 542+ E5B3              DrawDayCycleHUD:
 543+ E5B3                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E5B3 21 71 E8         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E5B6 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E5B9 CD 28 E6         CALL .drawChar
 547+ E5BC 21 79 E8         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E5BF 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E5C2 CD 28 E6         CALL .drawChar
 550+ E5C5 21 81 E8         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E5C8 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E5CB CD 28 E6         CALL .drawChar
 553+ E5CE                  ; Col 7 = espacio (limpiar)
 554+ E5CE 11 07 40         LD DE, $4007
 555+ E5D1 CD 31 E6         CALL .clearChar
 556+ E5D4
 557+ E5D4                  ; --- Digito decenas (col 8) ---
 558+ E5D4 3A E6 BC         LD A, (DayCycleCount)
 559+ E5D7 FE 0A            CP 10
 560+ E5D9 38 20            JR C, .singleDigit
 561+ E5DB                  ; Dos digitos: dividir A / 10
 562+ E5DB 06 00            LD B, 0
 563+ E5DD              .divLoop:
 564+ E5DD D6 0A            SUB 10
 565+ E5DF 04               INC B
 566+ E5E0 FE 0A            CP 10
 567+ E5E2 30 F9            JR NC, .divLoop
 568+ E5E4                  ; B = decenas, A = unidades
 569+ E5E4 F5               PUSH AF                             ; Guardar unidades
 570+ E5E5 78               LD A, B
 571+ E5E6 CD 1B E6         CALL .getDigitFont
 572+ E5E9 11 08 40         LD DE, $4008                        ; Col 8
 573+ E5EC CD 28 E6         CALL .drawChar
 574+ E5EF F1               POP AF                              ; Recuperar unidades
 575+ E5F0 CD 1B E6         CALL .getDigitFont
 576+ E5F3 11 09 40         LD DE, $4009                        ; Col 9
 577+ E5F6 CD 28 E6         CALL .drawChar
 578+ E5F9 18 14            JR .setAttrs
 579+ E5FB
 580+ E5FB              .singleDigit:
 581+ E5FB                  ; Una cifra: decena = 0, unidad = A
 582+ E5FB F5               PUSH AF
 583+ E5FC 21 89 E8         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E5FF 11 08 40         LD DE, $4008                        ; Col 8
 585+ E602 CD 28 E6         CALL .drawChar
 586+ E605 F1               POP AF
 587+ E606 CD 1B E6         CALL .getDigitFont
 588+ E609 11 09 40         LD DE, $4009                        ; Col 9
 589+ E60C CD 28 E6         CALL .drawChar
 590+ E60F
 591+ E60F              .setAttrs:
 592+ E60F                  ; Atributos: bright white en cols 4-9
 593+ E60F 3E 47            LD A, $47
 594+ E611 21 04 58         LD HL, ATTR_BASE + 4
 595+ E614 06 06            LD B, 6
 596+ E616              .attrLoop:
 597+ E616 77               LD (HL), A
 598+ E617 23               INC HL
 599+ E618 10 FC            DJNZ .attrLoop
 600+ E61A C9               RET
 601+ E61B
 602+ E61B              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E61B              ; A se destruye
 604+ E61B              .getDigitFont:
 605+ E61B C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E61D 6F               LD L, A
 607+ E61E 26 00            LD H, 0
 608+ E620 29               ADD HL, HL
 609+ E621 29               ADD HL, HL
 610+ E622 29               ADD HL, HL                          ; HL = indice * 8
 611+ E623 01 71 E8         LD BC, DayHudFont
 612+ E626 09               ADD HL, BC
 613+ E627 C9               RET
 614+ E628
 615+ E628              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 616+ E628              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 617+ E628              .drawChar:
 618+ E628 06 08            LD B, 8
 619+ E62A              .charLoop:
 620+ E62A 7E               LD A, (HL)
 621+ E62B 12               LD (DE), A
 622+ E62C 23               INC HL
 623+ E62D 14               INC D
 624+ E62E 10 FA            DJNZ .charLoop
 625+ E630 C9               RET
 626+ E631
 627+ E631              ; Limpia 8 scan lines en VRAM (DE)
 628+ E631              .clearChar:
 629+ E631 06 08            LD B, 8
 630+ E633 AF               XOR A
 631+ E634              .clearLoop:
 632+ E634 12               LD (DE), A
 633+ E635 14               INC D
 634+ E636 10 FC            DJNZ .clearLoop
 635+ E638 C9               RET
 636+ E639
 637+ E639              ; ==============================================================================
 638+ E639              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 639+ E639              ; ==============================================================================
 640+ E639              DrawPlayerSpeedHUD:
 641+ E639 3A 7F 8D         LD A, (PlayerCurrentSpeed)
 642+ E63C C6 30            ADD A, '0'
 643+ E63E 1E 02            LD E, 2
 644+ E640 CD 99 E6         CALL DrawHudCharRow0
 645+ E643                  ; Atributo (bright white)
 646+ E643 3E 47            LD A, $47
 647+ E645 32 02 58         LD (ATTR_BASE + 2), A
 648+ E648 C9               RET
 649+ E649
 650+ E649              ; ==============================================================================
 651+ E649              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 652+ E649              ; ==============================================================================
 653+ E649              DrawZoneCountHUD:
 654+ E649 3A 00 5D         LD A, (ZoneCellCount)
 655+ E64C                  ; Hi nibble
 656+ E64C 47               LD B, A
 657+ E64D CB 3F            SRL A
 658+ E64F CB 3F            SRL A
 659+ E651 CB 3F            SRL A
 660+ E653 CB 3F            SRL A
 661+ E655 FE 0A            CP 10
 662+ E657 38 04            JR C, .dzcHiDigit
 663+ E659 C6 37            ADD A, 'A' - 10
 664+ E65B 18 02            JR .dzcHiOut
 665+ E65D              .dzcHiDigit:
 666+ E65D C6 30            ADD A, '0'
 667+ E65F              .dzcHiOut:
 668+ E65F 1E 0B            LD E, 11
 669+ E661 CD 99 E6         CALL DrawHudCharRow0
 670+ E664                  ; Lo nibble
 671+ E664 78               LD A, B
 672+ E665 E6 0F            AND $0F
 673+ E667 FE 0A            CP 10
 674+ E669 38 04            JR C, .dzcLoDigit
 675+ E66B C6 37            ADD A, 'A' - 10
 676+ E66D 18 02            JR .dzcLoOut
 677+ E66F              .dzcLoDigit:
 678+ E66F C6 30            ADD A, '0'
 679+ E671              .dzcLoOut:
 680+ E671 1E 0C            LD E, 12
 681+ E673 CD 99 E6         CALL DrawHudCharRow0
 682+ E676 3E 47            LD A, $47
 683+ E678 32 0B 58         LD (ATTR_BASE + 11), A
 684+ E67B 32 0C 58         LD (ATTR_BASE + 12), A
 685+ E67E C9               RET
 686+ E67F
 687+ E67F              ; ==============================================================================
 688+ E67F              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 689+ E67F              ; ==============================================================================
 690+ E67F              DrawEnemySpeedHUD:
 691+ E67F                  ; "V" en columna 30
 692+ E67F 3E 56            LD A, 'V'
 693+ E681 1E 1E            LD E, 30
 694+ E683 CD 99 E6         CALL DrawHudCharRow0
 695+ E686                  ; Numero de velocidad en columna 31
 696+ E686 3A 4E 8D         LD A, (CurrentEnemySpeed)
 697+ E689 C6 30            ADD A, '0'
 698+ E68B 1E 1F            LD E, 31
 699+ E68D CD 99 E6         CALL DrawHudCharRow0
 700+ E690                  ; Atributos (bright white)
 701+ E690 3E 47            LD A, $47
 702+ E692 32 1E 58         LD (ATTR_BASE + 30), A
 703+ E695 32 1F 58         LD (ATTR_BASE + 31), A
 704+ E698 C9               RET
 705+ E699
 706+ E699              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 707+ E699              ; A = codigo ASCII, E = columna (0-31)
 708+ E699              DrawHudCharRow0:
 709+ E699 6F               LD L, A
 710+ E69A 26 00            LD H, 0
 711+ E69C 29               ADD HL, HL
 712+ E69D 29               ADD HL, HL
 713+ E69E 29               ADD HL, HL
 714+ E69F 01 00 3C         LD BC, $3C00
 715+ E6A2 09               ADD HL, BC                  ; HL = font data
 716+ E6A3 16 40            LD D, $40                   ; Tercio 0, scan line 0
 717+ E6A5 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 718+ E6A6 5F               LD E, A                     ; DE = dir VRAM
 719+ E6A7 06 08            LD B, 8
 720+ E6A9              .row0Char:
 721+ E6A9 7E               LD A, (HL)
 722+ E6AA 12               LD (DE), A
 723+ E6AB 23               INC HL
 724+ E6AC 14               INC D                       ; siguiente scan line
 725+ E6AD 10 FA            DJNZ .row0Char
 726+ E6AF C9               RET
 727+ E6B0
 728+ E6B0              ; ==============================================================================
 729+ E6B0              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 730+ E6B0              ; ==============================================================================
 731+ E6B0              DrawTimeIndicator:
 732+ E6B0                  ; Calcular puntero al label de 2 chars
 733+ E6B0 3A 55 E3         LD A, (CurrentTimeOfDay)
 734+ E6B3 87               ADD A, A                    ; A = momento * 2
 735+ E6B4 5F               LD E, A
 736+ E6B5 16 00            LD D, 0
 737+ E6B7 21 B7 E7         LD HL, TimeLabels
 738+ E6BA 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 739+ E6BB
 740+ E6BB                  ; Primer caracter en columna 30
 741+ E6BB 7E               LD A, (HL)
 742+ E6BC E5               PUSH HL
 743+ E6BD 1E 1E            LD E, 30
 744+ E6BF CD D3 E6         CALL DrawHudChar
 745+ E6C2 E1               POP HL
 746+ E6C3
 747+ E6C3                  ; Segundo caracter en columna 31
 748+ E6C3 23               INC HL
 749+ E6C4 7E               LD A, (HL)
 750+ E6C5 1E 1F            LD E, 31
 751+ E6C7 CD D3 E6         CALL DrawHudChar
 752+ E6CA
 753+ E6CA                  ; Atributos del indicador (bright white on black)
 754+ E6CA 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 755+ E6CD 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 756+ E6CF 77               LD (HL), A
 757+ E6D0 23               INC HL
 758+ E6D1 77               LD (HL), A
 759+ E6D2 C9               RET
 760+ E6D3
 761+ E6D3              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 762+ E6D3              ; A = codigo ASCII, E = columna (0-31)
 763+ E6D3              DrawHudChar:
 764+ E6D3                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 765+ E6D3 6F               LD L, A
 766+ E6D4 26 00            LD H, 0
 767+ E6D6 29               ADD HL, HL
 768+ E6D7 29               ADD HL, HL
 769+ E6D8 29               ADD HL, HL
 770+ E6D9 01 00 3C         LD BC, $3C00
 771+ E6DC 09               ADD HL, BC                  ; HL = font data
 772+ E6DD
 773+ E6DD                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E6DD 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E6DF 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E6E1 83               ADD A, E
 777+ E6E2 5F               LD E, A                     ; DE = dir VRAM
 778+ E6E3
 779+ E6E3 06 08            LD B, 8
 780+ E6E5              .hudCharLoop:
 781+ E6E5 7E               LD A, (HL)
 782+ E6E6 12               LD (DE), A
 783+ E6E7 23               INC HL
 784+ E6E8 14               INC D                       ; Siguiente scan line
 785+ E6E9 10 FA            DJNZ .hudCharLoop
 786+ E6EB C9               RET
