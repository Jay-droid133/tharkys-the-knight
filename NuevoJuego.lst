7191+ C706              ; --- EraseDeathSprite: redibuja XOR el ultimo sprite y restaura attrs ---
7192+ C706              ; IX debe ser EntityTable + SLOT_DEATH al entrar.
7193+ C706              EraseDeathSprite:
7194+ C706 CD F4 A4         CALL GetOldSpriteAddr
7195+ C709 DD 7E 0D         LD A, (IX+ENT_OLDY)
7196+ C70C 57               LD D, A
7197+ C70D DD 7E 0C         LD A, (IX+ENT_OLDX)
7198+ C710 5F               LD E, A
7199+ C711 DD E5            PUSH IX
7200+ C713 DD 2A 7C A4      LD IX, (OldSprAddr)
7201+ C717 CD E7 99         CALL DrawSprite
7202+ C71A DD E1            POP IX
7203+ C71C DD 56 0D         LD D, (IX+ENT_OLDY)
7204+ C71F DD 5E 0C         LD E, (IX+ENT_OLDX)
7205+ C722 C3 1C D3         JP RestoreOldAttr
