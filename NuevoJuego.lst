4546+ A621              ; ==============================================================================
4547+ A621              ; Llamado desde el main loop despues de ProcessEntities.
4548+ A621              ; Comprueba bounding box overlap entre player y cada enemigo activo.
4549+ A621              ; ==============================================================================
4550+ A621              CheckPlayerEnemyCollision:
4551+ A621                  ; NO usar IY — el handler IM 1 del ROM necesita IY=$5C3A.
4552+ A621                  ; Detectar inicio de nuevo ciclo de attack: limpiar hit marks
4553+ A621 3A 84 80         LD A, (EntityTable + ENT_STATE)
4554+ A624 57               LD D, A                             ; D = estado actual
4555+ A625 3A 29 9C         LD A, (PrevPlayerState)
4556+ A628 5F               LD E, A                             ; E = estado previo
4557+ A629 7A               LD A, D
4558+ A62A 32 29 9C         LD (PrevPlayerState), A             ; Guardar estado actual
4559+ A62D 7B               LD A, E                             ; A = estado previo
4560+ A62E FE 02            CP STATE_FIGHTING
4561+ A630 28 0F            JR Z, .noNewAttack                  ; Ya estaba peleando → no limpiar
4562+ A632 7A               LD A, D
4563+ A633 FE 02            CP STATE_FIGHTING
4564+ A635 20 0A            JR NZ, .noNewAttack                 ; No empezo a pelear → no limpiar
4565+ A637                  ; Transicion a STATE_FIGHTING → nuevo ciclo de attack
4566+ A637 AF               XOR A
4567+ A638 32 26 9C         LD (MonsterHitThisAttack), A
4568+ A63B 32 27 9C         LD (MonsterHitThisAttack+1), A
4569+ A63E 32 28 9C         LD (MonsterHitThisAttack+2), A
