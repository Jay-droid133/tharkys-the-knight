1397+ 9791 ED 79            OUT (C), A
1398+ 9793 11 ED C9         LD DE, FlowField
1399+ 9796 0E 00            LD C, 0                                 ; cy
1400+ 9798              .ffzRow:
1401+ 9798 06 00            LD B, 0                                 ; cx
1402+ 979A              .ffzCol:
