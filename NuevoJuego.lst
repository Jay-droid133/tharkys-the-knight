 709+ 8BEF              ; ==============================================================================
 710+ 8BEF              ; UpdatePlayerMovement - Fiel a Sabre Wulf: mueve cada N frames
 711+ 8BEF              ; ==============================================================================
 712+ 8BEF              ; El original usa turns_per_player_move=2: el player se mueve cada 2 frames.
 713+ 8BEF              ; Desplazamiento por turno: SPEED_RUN_X horizontal, SPEED_RUN_Y vertical.
 714+ 8BEF              ; ==============================================================================
 715+ 8BEF              UpdatePlayerMovement:
 716+ 8BEF                  ; Fiel a Sabre Wulf: mueve solo cada PLAYER_MOVE_TURNS frames
 717+ 8BEF 3A 64 81         LD A, (PlayerMoveTimer)
 718+ 8BF2 3D               DEC A
 719+ 8BF3 32 64 81         LD (PlayerMoveTimer), A
 720+ 8BF6 C0               RET NZ                      ; No es el turno de moverse
 721+ 8BF7 3E 01            LD A, PLAYER_MOVE_TURNS
 722+ 8BF9 32 64 81         LD (PlayerMoveTimer), A     ; Resetear timer
 723+ 8BFC
 724+ 8BFC DD 7E 0A         LD A, (IX+ENT_DIR)
 725+ 8BFF E6 0F            AND $0F                     ; Dir actual (bits 0-3)
 726+ 8C01 C8               RET Z                       ; Sin movimiento
 727+ 8C02
 728+ 8C02                  ; Determinar velocidad segun estado
 729+ 8C02 DD 7E 02         LD A, (IX+ENT_STATE)
 730+ 8C05 FE 02            CP STATE_FIGHTING
 731+ 8C07 3E 02            LD A, SPEED_RUN
 732+ 8C09 20 02            JR NZ, .gotSpeed
 733+ 8C0B 3E 01            LD A, SPEED_FIGHT
 734+ 8C0D              .gotSpeed:
 735+ 8C0D 32 96 8C         LD (.speed), A
 736+ 8C10
 737+ 8C10                  ; --- Movimiento horizontal (con colision) ---
 738+ 8C10 DD 7E 03         LD A, (IX+ENT_POSX)
 739+ 8C13 32 97 8C         LD (.savedX), A             ; Guardar X antes de mover
 740+ 8C16
 741+ 8C16 DD 7E 0A         LD A, (IX+ENT_DIR)
 742+ 8C19 CB 57            BIT 2, A                    ; DIR_E?
 743+ 8C1B 28 11            JR Z, .noE
 744+ 8C1D 3A 96 8C         LD A, (.speed)
 745+ 8C20 47               LD B, A
 746+ 8C21 DD 7E 03         LD A, (IX+ENT_POSX)
 747+ 8C24 80               ADD A, B
 748+ 8C25 FE E8            CP SCREEN_MAX_X
 749+ 8C27 38 02            JR C, .clampE
 750+ 8C29 3E E8            LD A, SCREEN_MAX_X
 751+ 8C2B              .clampE:
 752+ 8C2B DD 77 03         LD (IX+ENT_POSX), A
 753+ 8C2E              .noE:
 754+ 8C2E DD 7E 0A         LD A, (IX+ENT_DIR)
 755+ 8C31 CB 5F            BIT 3, A                    ; DIR_W?
 756+ 8C33 28 10            JR Z, .noW
 757+ 8C35 DD 7E 03         LD A, (IX+ENT_POSX)
 758+ 8C38 47               LD B, A
 759+ 8C39 3A 96 8C         LD A, (.speed)
 760+ 8C3C 4F               LD C, A
 761+ 8C3D 78               LD A, B
 762+ 8C3E 91               SUB C
 763+ 8C3F 30 01            JR NC, .clampW
 764+ 8C41 AF               XOR A                       ; Clamp a 0
 765+ 8C42              .clampW:
 766+ 8C42 DD 77 03         LD (IX+ENT_POSX), A
 767+ 8C45              .noW:
 768+ 8C45                  ; Check colision X
 769+ 8C45 CD 99 8C         CALL CheckEntityCollision
 770+ 8C48 28 06            JR Z, .xOk
 771+ 8C4A 3A 97 8C         LD A, (.savedX)
 772+ 8C4D DD 77 03         LD (IX+ENT_POSX), A        ; Revertir X
 773+ 8C50              .xOk:
 774+ 8C50
 775+ 8C50                  ; --- Movimiento vertical (con colision) ---
 776+ 8C50 DD 7E 04         LD A, (IX+ENT_POSY)
 777+ 8C53 32 98 8C         LD (.savedY), A
 778+ 8C56
 779+ 8C56 DD 7E 0A         LD A, (IX+ENT_DIR)
 780+ 8C59 CB 4F            BIT 1, A                    ; DIR_S?
 781+ 8C5B 28 11            JR Z, .noS
 782+ 8C5D 3A 96 8C         LD A, (.speed)
 783+ 8C60 47               LD B, A
 784+ 8C61 DD 7E 04         LD A, (IX+ENT_POSY)
 785+ 8C64 80               ADD A, B
 786+ 8C65 FE AB            CP SCREEN_MAX_Y
 787+ 8C67 38 02            JR C, .clampS
 788+ 8C69 3E AB            LD A, SCREEN_MAX_Y
 789+ 8C6B              .clampS:
 790+ 8C6B DD 77 04         LD (IX+ENT_POSY), A
 791+ 8C6E              .noS:
 792+ 8C6E DD 7E 0A         LD A, (IX+ENT_DIR)
 793+ 8C71 CB 47            BIT 0, A                    ; DIR_N?
 794+ 8C73 28 15            JR Z, .noN
 795+ 8C75 DD 7E 04         LD A, (IX+ENT_POSY)
 796+ 8C78 47               LD B, A
 797+ 8C79 3A 96 8C         LD A, (.speed)
 798+ 8C7C 4F               LD C, A
 799+ 8C7D 78               LD A, B
 800+ 8C7E 91               SUB C
 801+ 8C7F 38 04            JR C, .toMinY           ; underflow → por debajo de 0
 802+ 8C81 FE 10            CP SCREEN_MIN_Y
 803+ 8C83 30 02            JR NC, .clampN          ; A >= SCREEN_MIN_Y → ok
 804+ 8C85              .toMinY:
 805+ 8C85 3E 10            LD A, SCREEN_MIN_Y
 806+ 8C87              .clampN:
 807+ 8C87 DD 77 04         LD (IX+ENT_POSY), A
 808+ 8C8A              .noN:
 809+ 8C8A                  ; Check colision Y
 810+ 8C8A CD 99 8C         CALL CheckEntityCollision
 811+ 8C8D 28 06            JR Z, .yOk
 812+ 8C8F 3A 98 8C         LD A, (.savedY)
 813+ 8C92 DD 77 04         LD (IX+ENT_POSY), A        ; Revertir Y
 814+ 8C95              .yOk:
 815+ 8C95 C9               RET
 816+ 8C96
 817+ 8C96 00           .speed:  DEFB 0
 818+ 8C97 00           .savedX: DEFB 0
 819+ 8C98 00           .savedY: DEFB 0
 820+ 8C99
 821+ 8C99              ; ==============================================================================
 822+ 8C99              ; CheckEntityCollision - Colision de la entidad contra sprites de fondo
 823+ 8C99              ; ==============================================================================
 824+ 8C99              ; Comprueba 3 puntos del bounding box (como el original).
 825+ 8C99              ; IX = entidad. Salida: Z=libre, NZ=colision.
 826+ 8C99              ; ==============================================================================
 827+ 8C99              CheckEntityCollision:
 828+ 8C99                  ; Offsets segun animacion (sprites 24px de ataque)
 829+ 8C99                  ; collL: offset izquierdo (0 normal, -8 attack west = espada a la izq)
 830+ 8C99                  ; collW: offset derecho  (15 normal, 23 attack east/west = sprite mas ancho)
 831+ 8C99 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 832+ 8C9C FE 1B            CP SPRID_ATTACK_WEST
 833+ 8C9E 28 0D            JR Z, .collAttackW
 834+ 8CA0 FE 16            CP SPRID_ATTACK_EAST
 835+ 8CA2 28 12            JR Z, .collAttackE
 836+ 8CA4 3E 00            LD A, 0
 837+ 8CA6 32 08 8D         LD (.collL), A
 838+ 8CA9 3E 0F            LD A, 15
 839+ 8CAB 18 10            JR .collSetW
 840+ 8CAD              .collAttackW:
 841+ 8CAD 3E 08            LD A, 8                     ; izquierda desplazada 8 (espada)
 842+ 8CAF 32 08 8D         LD (.collL), A
 843+ 8CB2 3E 0F            LD A, 15                    ; derecha igual que walk (cuerpo en X..X+15)
 844+ 8CB4 18 07            JR .collSetW
 845+ 8CB6              .collAttackE:
 846+ 8CB6 3E 00            LD A, 0
 847+ 8CB8 32 08 8D         LD (.collL), A
 848+ 8CBB 3E 17            LD A, 23                    ; derecha extendida (espada a la derecha)
 849+ 8CBD              .collSetW:
 850+ 8CBD 32 09 8D         LD (.collW), A
 851+ 8CC0
 852+ 8CC0                  ; Punto 1: esquina superior-izquierda (X-collL, Y)
 853+ 8CC0 3A 08 8D         LD A, (.collL)
 854+ 8CC3 47               LD B, A
 855+ 8CC4 DD 7E 03         LD A, (IX+ENT_POSX)
 856+ 8CC7 90               SUB B
 857+ 8CC8 47               LD B, A
 858+ 8CC9 DD 7E 04         LD A, (IX+ENT_POSY)
 859+ 8CCC 4F               LD C, A
 860+ 8CCD CD AC 93         CALL IsPointBlocked
 861+ 8CD0 C0               RET NZ
 862+ 8CD1
 863+ 8CD1                  ; Punto 2: esquina superior-derecha (X+collW, Y)
 864+ 8CD1 3A 09 8D         LD A, (.collW)
 865+ 8CD4 47               LD B, A
 866+ 8CD5 DD 7E 03         LD A, (IX+ENT_POSX)
 867+ 8CD8 80               ADD A, B
 868+ 8CD9 47               LD B, A
 869+ 8CDA DD 7E 04         LD A, (IX+ENT_POSY)
 870+ 8CDD 4F               LD C, A
 871+ 8CDE CD AC 93         CALL IsPointBlocked
 872+ 8CE1 C0               RET NZ
 873+ 8CE2
 874+ 8CE2                  ; Punto 3: esquina inferior-izquierda (X-collL, Y+20)
 875+ 8CE2 3A 08 8D         LD A, (.collL)
 876+ 8CE5 47               LD B, A
 877+ 8CE6 DD 7E 03         LD A, (IX+ENT_POSX)
 878+ 8CE9 90               SUB B
 879+ 8CEA 47               LD B, A
 880+ 8CEB DD 7E 04         LD A, (IX+ENT_POSY)
 881+ 8CEE C6 14            ADD A, 20
 882+ 8CF0 4F               LD C, A
 883+ 8CF1 CD AC 93         CALL IsPointBlocked
 884+ 8CF4 C0               RET NZ
 885+ 8CF5
 886+ 8CF5                  ; Punto 4: esquina inferior-derecha (X+collW, Y+20)
 887+ 8CF5 3A 09 8D         LD A, (.collW)
 888+ 8CF8 47               LD B, A
 889+ 8CF9 DD 7E 03         LD A, (IX+ENT_POSX)
 890+ 8CFC 80               ADD A, B
 891+ 8CFD 47               LD B, A
 892+ 8CFE DD 7E 04         LD A, (IX+ENT_POSY)
 893+ 8D01 C6 14            ADD A, 20
 894+ 8D03 4F               LD C, A
 895+ 8D04 CD AC 93         CALL IsPointBlocked
 896+ 8D07 C9               RET                         ; Z/NZ del ultimo check
 897+ 8D08
 898+ 8D08 00           .collL: DEFB 0
 899+ 8D09 0F           .collW: DEFB 15
 900+ 8D0A
 901+ 8D0A              ; ==============================================================================
 902+ 8D0A              ; UpdatePlayerAnimation - Animacion por SpriteID
 903+ 8D0A              ; ==============================================================================
 904+ 8D0A              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
 905+ 8D0A              ; ==============================================================================
 906+ 8D0A              UpdatePlayerAnimation:
 907+ 8D0A                  ; Determinar animacion segun estado y direccion
 908+ 8D0A DD 7E 02         LD A, (IX+ENT_STATE)
 909+ 8D0D FE 02            CP STATE_FIGHTING
 910+ 8D0F 28 0C            JR Z, .animFight
 911+ 8D11 FE 01            CP STATE_RUNNING
 912+ 8D13 28 21            JR Z, .animRun
 913+ 8D15
 914+ 8D15                  ; --- IDLE ---
 915+ 8D15 16 00            LD D, SPRID_IDLE
 916+ 8D17 1E 02            LD E, ANIM_FRAMES_IDLE
 917+ 8D19 0E 14            LD C, ANIM_DELAY_IDLE
 918+ 8D1B 18 44            JR .applyAnim
 919+ 8D1D
 920+ 8D1D              .animFight:
 921+ 8D1D                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
 922+ 8D1D DD 7E 0A         LD A, (IX+ENT_DIR)
 923+ 8D20 0F               RRCA
 924+ 8D21 0F               RRCA
 925+ 8D22 0F               RRCA
 926+ 8D23 0F               RRCA
 927+ 8D24 E6 0F            AND $0F                     ; lastHDir
 928+ 8D26 FE 08            CP DIR_W
 929+ 8D28 28 04            JR Z, .fightW
 930+ 8D2A 16 16            LD D, SPRID_ATTACK_EAST
 931+ 8D2C 18 02            JR .fightSet
 932+ 8D2E              .fightW:
 933+ 8D2E 16 1B            LD D, SPRID_ATTACK_WEST
 934+ 8D30              .fightSet:
 935+ 8D30 1E 05            LD E, ANIM_FRAMES_FIGHT
 936+ 8D32 0E 03            LD C, ANIM_DELAY_FIGHT
 937+ 8D34 18 2B            JR .applyAnim
 938+ 8D36
 939+ 8D36              .animRun:
 940+ 8D36 DD 7E 0A         LD A, (IX+ENT_DIR)
 941+ 8D39 E6 0F            AND $0F                     ; dir actual
 942+ 8D3B                  ; Prioridad: E/W sobre N/S
 943+ 8D3B CB 57            BIT 2, A
 944+ 8D3D 20 0C            JR NZ, .runE
 945+ 8D3F CB 5F            BIT 3, A
 946+ 8D41 20 10            JR NZ, .runW
 947+ 8D43 CB 47            BIT 0, A
 948+ 8D45 20 14            JR NZ, .runN
 949+ 8D47 16 0E            LD D, SPRID_WALK_S
 950+ 8D49 18 12            JR .runSet
 951+ 8D4B              .runE:
 952+ 8D4B 16 02            LD D, SPRID_WALK_E
 953+ 8D4D 1E 04            LD E, 4
