  73+ E797              ; ==============================================================================
  74+ E797              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  75+ E797              ; ==============================================================================
  76+ E797              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  77+ E797              ; el AY toca solo durante el decay.
  78+ E797              ; ==============================================================================
  79+ E797              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  80+ E797              ; ==============================================================================
  81+ E797              ; ==============================================================================
  82+ E797              ; Variables del decay manual de la campana — MOVIDAS a music_irq.asm (slot 1)
  83+ E797              ; para que el handler IRQ las pueda leer/escribir sin paginar slot 3 (regla
  84+ E797              ; project_irq_slot3_atomic). El tick del decay vive ahora en BellTickIrq
  85+ E797              ; (slot 1) y se llama desde MusicIrqHandler cada 25 Hz. Sin esto, durante
  86+ E797              ; DrawScreen / transiciones (varios frames sin MainLoop) el bell decay no
  87+ E797              ; se actualizaba -> "campanada se alarga / se apaga raro".
  88+ E797              ;
  89+ E797              ; AY_PlayBellChimeImpl (bank 4) sigue escribiendo a las vars sin cambios:
  90+ E797              ; slot 1 always-vis desde bank 4.
  91+ E797              ;
  92+ E797              ; Symbols importados desde music_irq.asm: BellVolL, BellVolC, BellVolR,
  93+ E797              ; BellDecayTimer, BELL_DECAY_RATE.
  94+ E797
  95+ E797              ; ==============================================================================
  96+ E797              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  97+ E797              ; ==============================================================================
  98+ E797              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  99+ E797              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
 100+ E797              ; ==============================================================================
 101+ E797              AY_PlayBellChimeImpl:
 102+ E797                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 103+ E797                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 104+ E797                  ; editor — el sonido espacial debe centrarse en la plaza real).
 105+ E797 3A 01 83         LD A, (CurrentScreenX)
 106+ E79A D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 107+ E79C 57               LD D, A                     ; D = dx signed (player - plaza)
 108+ E79D 30 02            JR NC, .absDxOk
 109+ E79F ED 44            NEG
 110+ E7A1              .absDxOk:
 111+ E7A1 47               LD B, A                     ; B = |dx|
 112+ E7A2
 113+ E7A2 3A 02 83         LD A, (CurrentScreenY)
 114+ E7A5 D6 09            SUB PLAZA_SCREEN_Y
 115+ E7A7 30 02            JR NC, .absDyOk
 116+ E7A9 ED 44            NEG
 117+ E7AB              .absDyOk:
 118+ E7AB 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 119+ E7AC
 120+ E7AC                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 121+ E7AC                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente)
 122+ E7AC                  ;   dist 3..5  -> dom=13, far=10  (medio: direccional pero audible)
 123+ E7AC                  ;   dist 6+    -> dom=11, far= 8  (lejos: direccional, MIN audible)
 124+ E7AC                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 125+ E7AC 06 0B            LD B, 11                    ; default tramo lejano: dom
 126+ E7AE 0E 08            LD C, 8                     ;                       far (subido +3 desde 5)
 127+ E7B0 FE 06            CP 6
 128+ E7B2 30 0C            JR NC, .volTotalSet
 129+ E7B4 06 0D            LD B, 13                    ; tramo medio (subido +1 desde 12)
 130+ E7B6 0E 0A            LD C, 10                    ;             (subido +2 desde 8)
 131+ E7B8 FE 03            CP 3
 132+ E7BA 30 04            JR NC, .volTotalSet
 133+ E7BC 06 0F            LD B, 15                    ; tramo cercano (sin cambios)
 134+ E7BE 0E 0C            LD C, 12
 135+ E7C0              .volTotalSet:                   ; B = dom_vol, C = far_vol
 136+ E7C0
 137+ E7C0                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 138+ E7C0                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 139+ E7C0                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 140+ E7C0                  ; D == 0 → alineado X → solo canal B (centro)
 141+ E7C0 7A               LD A, D
 142+ E7C1 B7               OR A
 143+ E7C2 28 21            JR Z, .panCenter
 144+ E7C4 F2 D6 E7         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 145+ E7C7                  ; D < 0: plaza al este → canal C dominante
 146+ E7C7              .panRight:
 147+ E7C7 79               LD A, C
 148+ E7C8 32 84 7F         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 149+ E7CB 78               LD A, B
 150+ E7CC 32 86 7F         LD (BellVolR), A            ; canal C = dom
 151+ E7CF CB 3F            SRL A
 152+ E7D1 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 153+ E7D4 18 1A            JR .panDone
 154+ E7D6
 155+ E7D6              .panLeft:
 156+ E7D6                  ; D > 0: plaza al oeste → canal A dominante
 157+ E7D6 78               LD A, B
 158+ E7D7 32 84 7F         LD (BellVolL), A            ; canal A = dom
 159+ E7DA CB 3F            SRL A
 160+ E7DC 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 161+ E7DF 79               LD A, C
 162+ E7E0 32 86 7F         LD (BellVolR), A            ; canal C = far
 163+ E7E3 18 0B            JR .panDone
 164+ E7E5
 165+ E7E5              .panCenter:
 166+ E7E5                  ; Alineado: solo canal B
 167+ E7E5 78               LD A, B
 168+ E7E6 32 85 7F         LD (BellVolC), A
 169+ E7E9 AF               XOR A
 170+ E7EA 32 84 7F         LD (BellVolL), A
 171+ E7ED 32 86 7F         LD (BellVolR), A
 172+ E7F0
 173+ E7F0              .panDone:
 174+ E7F0 3E 02            LD A, BELL_DECAY_RATE
 175+ E7F2 32 87 7F         LD (BellDecayTimer), A
 176+ E7F5
 177+ E7F5                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 178+ E7F5 3E 00            LD A, 0                     ; R0: tone A LSB
 179+ E7F7 1E 58            LD E, $58
 180+ E7F9 CD 59 E7         CALL AY_WriteReg
 181+ E7FC 3E 01            LD A, 1                     ; R1: tone A MSB
 182+ E7FE 1E 02            LD E, $02
 183+ E800 CD 59 E7         CALL AY_WriteReg
 184+ E803 3E 02            LD A, 2                     ; R2: tone B LSB
 185+ E805 1E 58            LD E, $58
 186+ E807 CD 59 E7         CALL AY_WriteReg
 187+ E80A 3E 03            LD A, 3                     ; R3: tone B MSB
 188+ E80C 1E 02            LD E, $02
 189+ E80E CD 59 E7         CALL AY_WriteReg
 190+ E811 3E 04            LD A, 4                     ; R4: tone C LSB
 191+ E813 1E 58            LD E, $58
 192+ E815 CD 59 E7         CALL AY_WriteReg
 193+ E818 3E 05            LD A, 5                     ; R5: tone C MSB
 194+ E81A 1E 02            LD E, $02
 195+ E81C CD 59 E7         CALL AY_WriteReg
 196+ E81F
 197+ E81F                  ; --- Mixer: tonos A, B, C activos ---
 198+ E81F 3E 07            LD A, 7
 199+ E821 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 200+ E823 CD 59 E7         CALL AY_WriteReg
 201+ E826
 202+ E826                  ; --- Volúmenes iniciales ---
 203+ E826 3E 08            LD A, 8
 204+ E828 21 84 7F         LD HL, BellVolL
 205+ E82B 5E               LD E, (HL)
 206+ E82C CD 59 E7         CALL AY_WriteReg
 207+ E82F 3E 09            LD A, 9
 208+ E831 21 85 7F         LD HL, BellVolC
 209+ E834 5E               LD E, (HL)
 210+ E835 CD 59 E7         CALL AY_WriteReg
 211+ E838 3E 0A            LD A, 10
 212+ E83A 21 86 7F         LD HL, BellVolR
 213+ E83D 5E               LD E, (HL)
 214+ E83E CD 59 E7         CALL AY_WriteReg
 215+ E841
 216+ E841 C9               RET
