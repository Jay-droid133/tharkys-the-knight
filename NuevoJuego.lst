 605+ A16F 5F               LD E, A
 606+ A170 DD 7E 05         LD A, (IX+ENT_ATTR)
 607+ A173 CD D9 9A         CALL SetEntityAttr
 608+ A176                  ; --- Draw sprite nuevo ---
 609+ A176 3A DF 82         LD A, (EnemyDrawY)
 610+ A179 57               LD D, A
 611+ A17A DD 7E 0F         LD A, (IX+ENT_DRAWX)
 612+ A17D 5F               LD E, A
 613+ A17E DD E5            PUSH IX
 614+ A180 DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 615+ A184 CD E9 99         CALL DrawSprite
