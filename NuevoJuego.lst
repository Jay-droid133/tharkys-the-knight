 136+ 6707              ; ==============================================================================
 137+ 6707              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 138+ 6707              ; ==============================================================================
 139+ 6707              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 140+ 6707              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 141+ 6707              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 142+ 6707              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 143+ 6707              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 144+ 6707              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 145+ 6707              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 146+ 6707              ; ==============================================================================
 147+ 6707              StatueIdTable:
 148+ 6707 D5               DEFB 213        ; type idx 0: statue_zombi
 149+ 6708 E1               DEFB 225        ; type idx 1: statue_skeleton
 150+ 6709 D3               DEFB 211        ; type idx 2: statue_ghost
 151+ 670A
 152+ 670A              ; ==============================================================================
 153+ 670A              ; StatueBrokenIdTable - sprites de estatua "parcialmente rota". Se intercambia
 154+ 670A              ; con StatueIdTable a mitad de la fase SHAKE_STATUE para reforzar la sensacion
 155+ 670A              ; de que la estatua se cuartea. Mismas dimensiones (16x24) que las enteras.
 156+ 670A              ; Indexado igual que StatueIdTable (por type idx).
 157+ 670A              ; ==============================================================================
 158+ 670A              StatueBrokenIdTable:
 159+ 670A EA               DEFB 234        ; type idx 0: statue_zombi_braking
 160+ 670B EB               DEFB 235        ; type idx 1: statue_skeleton_braking
 161+ 670C E9               DEFB 233        ; type idx 2: statue_ghost_braking
 162+ 670D
 163+ 670D              ; ==============================================================================
 164+ 670D              ; RemainsIdTable - BG sprite id de los restos que dejan los monstruos al ser
 165+ 670D              ; atrapados. 16x8 (2 chars de ancho x 1 de alto). Se dibujan en la base de la
 166+ 670D              ; estatua (charY + 2) cuando MonsterTrappedFlags tiene el bit del tipo set.
 167+ 670D              ; Indexada por type idx (igual que StatueIdTable y MonsterTrappedFlags).
 168+ 670D              ; ==============================================================================
 169+ 670D              RemainsIdTable:
 170+ 670D E8               DEFB 232        ; type idx 0: zombi remains
 171+ 670E E7               DEFB 231        ; type idx 1: skeleton remains
 172+ 670F E6               DEFB 230        ; type idx 2: ghost remains
