 862+ D210 FA 32 D2         JP M, .rleLitEmit           ; <0 = literal group en curso
 863+ D213                  ; >0 = run en curso, emitir valor
 864+ D213              .rleRunEmit:
 865+ D213 3A B4 D2         LD A, (.rleValue)
 866+ D216 2F               CPL
 867+ D217 77               LD (HL), A
 868+ D218 23               INC HL
 869+ D219 3A B3 D2         LD A, (.rlePending)
 870+ D21C 3D               DEC A
 871+ D21D 32 B3 D2         LD (.rlePending), A
