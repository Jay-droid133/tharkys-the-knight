2727+ B15F 1E 00            LD E, 0
2728+ B161 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2729+ B165 C3 81 B1         JP .moKbApply
2730+ B168              .moKbSlideY:
2731+ B168                  ; Intentar solo eje Y (mantener direccion del golpe)
2732+ B168 7B               LD A, E
2733+ B169 B7               OR A
2734+ B16A 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2735+ B16C D5               PUSH DE
2736+ B16D 16 00            LD D, 0
2737+ B16F CD 51 B4         CALL .moTryPassable
2738+ B172 D1               POP DE
2739+ B173 20 09            JR NZ, .moKbSlideStop
2740+ B175                  ; Slide en Y funciona
2741+ B175 16 00            LD D, 0
