 247  A191                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A191              ; ==============================================================================
   2+ A191              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A191              ; ==============================================================================
   4+ A191              ; - Estructura de entidad de 12 bytes (universal)
   5+ A191              ; - Game loop per-entity: erase → update → draw
   6+ A191              ; - Movimiento 8-bit (sin subpixel)
   7+ A191              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A191              ; - XOR draw/erase (una sola rutina)
   9+ A191              ; ==============================================================================
  10+ A191
  11+ A191              ; ==============================================================================
  12+ A191              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A191              ; ==============================================================================
  14+ A191              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A191              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A191              ; ==============================================================================
  17+ A191              ReadInput:
  18+ A191 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A193 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A195
  21+ A195                  ; -- 1. QAOP --
  22+ A195 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A198 ED 78            IN A, (C)
  24+ A19A CB 47            BIT 0, A            ; Q = Arriba
  25+ A19C 20 02            JR NZ, .no_q
  26+ A19E CB C2            SET 0, D
  27+ A1A0              .no_q:
  28+ A1A0 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A1A3 ED 78            IN A, (C)
  30+ A1A5 CB 47            BIT 0, A            ; A = Abajo
  31+ A1A7 20 02            JR NZ, .no_a
  32+ A1A9 CB CA            SET 1, D
  33+ A1AB              .no_a:
  34+ A1AB 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A1AE ED 78            IN A, (C)
  36+ A1B0 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A1B2 20 02            JR NZ, .no_o
  38+ A1B4 CB DA            SET 3, D
  39+ A1B6              .no_o:
  40+ A1B6 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A1B8 20 02            JR NZ, .no_p
  42+ A1BA CB D2            SET 2, D
  43+ A1BC              .no_p:
  44+ A1BC
  45+ A1BC                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A1BC                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A1BC DB 1F            IN A, (31)
  48+ A1BE 4F               LD C, A             ; guardar para fire
  49+ A1BF CB 5F            BIT 3, A            ; Up
  50+ A1C1 28 02            JR Z, .no_k_up
  51+ A1C3 CB C2            SET 0, D
  52+ A1C5              .no_k_up:
  53+ A1C5 CB 57            BIT 2, A            ; Down
  54+ A1C7 28 02            JR Z, .no_k_down
  55+ A1C9 CB CA            SET 1, D
  56+ A1CB              .no_k_down:
  57+ A1CB CB 4F            BIT 1, A            ; Left
  58+ A1CD 28 02            JR Z, .no_k_left
  59+ A1CF CB DA            SET 3, D
  60+ A1D1              .no_k_left:
  61+ A1D1 CB 47            BIT 0, A            ; Right
  62+ A1D3 28 02            JR Z, .no_k_right
  63+ A1D5 CB D2            SET 2, D
  64+ A1D7              .no_k_right:
  65+ A1D7 CB 61            BIT 4, C            ; Kempston Fire
  66+ A1D9 28 02            JR Z, .no_k_fire
  67+ A1DB CB C3            SET 0, E
  68+ A1DD              .no_k_fire:
  69+ A1DD
  70+ A1DD                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A1DD                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A1DD 01 FE F7         LD BC, $F7FE
  73+ A1E0 ED 78            IN A, (C)
  74+ A1E2 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A1E4 20 02            JR NZ, .no_s1_up
  76+ A1E6 CB C2            SET 0, D
  77+ A1E8              .no_s1_up:
  78+ A1E8 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A1EA 20 02            JR NZ, .no_s1_down
  80+ A1EC CB CA            SET 1, D
  81+ A1EE              .no_s1_down:
  82+ A1EE CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A1F0 20 02            JR NZ, .no_s1_left
  84+ A1F2 CB DA            SET 3, D
  85+ A1F4              .no_s1_left:
  86+ A1F4 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A1F6 20 02            JR NZ, .no_s1_right
  88+ A1F8 CB D2            SET 2, D
  89+ A1FA              .no_s1_right:
  90+ A1FA CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A1FC 20 02            JR NZ, .no_s1_fire
  92+ A1FE CB C3            SET 0, E
  93+ A200              .no_s1_fire:
  94+ A200
  95+ A200                  ; -- 4. SPACE = Fire (teclado) --
  96+ A200 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A203 ED 78            IN A, (C)
  98+ A205 CB 47            BIT 0, A            ; SPACE
  99+ A207 20 02            JR NZ, .no_space
 100+ A209 CB C3            SET 0, E
 101+ A20B              .no_space:
 102+ A20B
 103+ A20B                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A20B 7B               LD A, E
 105+ A20C 32 ED 81         LD (InputFire), A
 106+ A20F
 107+ A20F                  ; -- 6. Cancelar opuestos --
 108+ A20F 7A               LD A, D
 109+ A210 47               LD B, A
 110+ A211 E6 03            AND DIR_N | DIR_S
 111+ A213 FE 03            CP DIR_N | DIR_S
 112+ A215 20 04            JR NZ, .noVC
 113+ A217 78               LD A, B
 114+ A218 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ A21A 47               LD B, A
 116+ A21B              .noVC:
 117+ A21B 78               LD A, B
 118+ A21C E6 0C            AND DIR_E | DIR_W
 119+ A21E FE 0C            CP DIR_E | DIR_W
 120+ A220 20 04            JR NZ, .noHC
 121+ A222 78               LD A, B
 122+ A223 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ A225 47               LD B, A
 124+ A226              .noHC:
 125+ A226 78               LD A, B
 126+ A227 32 EC 81         LD (InputDirection), A
 127+ A22A C9               RET
 128+ A22B
 129+ A22B              ; ==============================================================================
 130+ A22B              ; InitEntities - Inicializa la tabla de entidades
 131+ A22B              ; ==============================================================================
 132+ A22B              ; Limpia todos los slots y configura el slot 0 como player.
 133+ A22B              ; ==============================================================================
 134+ A22B              InitEntities:
 135+ A22B                  ; Limpiar toda la tabla a ceros
 136+ A22B 21 DC 80         LD HL, EntityTable
 137+ A22E 11 DD 80         LD DE, EntityTable + 1
 138+ A231 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ A234 AF               XOR A
 140+ A235 77               LD (HL), A
 141+ A236 ED B0            LDIR
 142+ A238
 143+ A238                  ; Limpiar tabla de atributos salvados
 144+ A238 21 AE 9F         LD HL, SavedAttrTable
 145+ A23B 11 AF 9F         LD DE, SavedAttrTable + 1
 146+ A23E 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ A241 AF               XOR A
 148+ A242 77               LD (HL), A
 149+ A243 ED B0            LDIR
 150+ A245
 151+ A245                  ; Configurar slot 0: Player
 152+ A245 DD 21 DC 80      LD IX, EntityTable
 153+ A249 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ A24D DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ A251 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ A255 DD 36 03 68      LD (IX+ENT_POSX), START_PLAYER_X
 157+ A259 DD 36 04 40      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ A25D DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ A261 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ A265 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ A269 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ A26D DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ A271 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ A275 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ A279 DD 36 0C 68      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ A27D DD 36 0D 40      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ A281 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ A285 DD 36 0F 68      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ A289
 170+ A289                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ A289 3E 0C            LD A, SPAWN_INTERVAL
 172+ A28B 32 0C 82         LD (SpawnTimer), A
 173+ A28E AF               XOR A
 174+ A28F 32 17 82         LD (EnemyStepIdx), A
 175+ A292 32 7B 5F         LD (PendingEraseCount), A
 176+ A295 C9               RET
 177+ A296
 178+ A296              ; ==============================================================================
 179+ A296              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ A296              ; ==============================================================================
 181+ A296              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ A296              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ A296              ; que los pies parezcan hundirse en el suelo.
 184+ A296              ; ==============================================================================
 185+ A296              ComputePlayerDrawY:
 186+ A296 3A DF 80         LD A, (EntityTable + ENT_POSX)
 187+ A299 C6 08            ADD A, 8                    ; center X del player
 188+ A29B 47               LD B, A
 189+ A29C 3A E0 80         LD A, (EntityTable + ENT_POSY)
 190+ A29F 4F               LD C, A
 191+ A2A0 32 0A 82         LD (PlayerDrawY), A         ; default: sin offset
 192+ A2A3 B7               OR A
 193+ A2A4 C8               RET Z
 194+ A2A5 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ A2A6 CD 9D D1         CALL IsPointBlocked
 196+ A2A9 C8               RET Z                       ; libre → sin offset
 197+ A2AA 3A E0 80         LD A, (EntityTable + ENT_POSY)
 198+ A2AD 3C               INC A
 199+ A2AE 32 0A 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ A2B1 C9               RET
 201+ A2B2
 202+ A2B2              ; ==============================================================================
 203+ A2B2              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ A2B2              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ A2B2              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ A2B2              ; no parecer que se hunde en el techo.
 207+ A2B2              ; Preserva: IX. Destruye: AF, BC.
 208+ A2B2              ; ==============================================================================
 209+ A2B2              ComputeEnemyDrawY:
 210+ A2B2 DD 7E 04         LD A, (IX+ENT_POSY)
 211+ A2B5 32 0B 82         LD (EnemyDrawY), A          ; default = POSY
 212+ A2B8 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ A2BB FE 02            CP TYPE_MONSTER
 214+ A2BD C0               RET NZ                      ; no monster → sin offset
 215+ A2BE DD 7E 03         LD A, (IX+ENT_POSX)
 216+ A2C1 C6 08            ADD A, 8                    ; center X
 217+ A2C3 47               LD B, A
 218+ A2C4 DD 7E 04         LD A, (IX+ENT_POSY)
 219+ A2C7 4F               LD C, A
 220+ A2C8 B7               OR A
 221+ A2C9 C8               RET Z
 222+ A2CA 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ A2CB CD 9D D1         CALL IsPointBlocked
 224+ A2CE C8               RET Z                       ; libre → sin offset
 225+ A2CF DD 7E 04         LD A, (IX+ENT_POSY)
 226+ A2D2 3C               INC A
 227+ A2D3 32 0B 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ A2D6 C9               RET
 229+ A2D7
 230+ A2D7              ; ==============================================================================
 231+ A2D7              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 232+ A2D7              ; ==============================================================================
 233+ A2D7              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 234+ A2D7              ; ==============================================================================
 235+ A2D7              ProcessPlayer:
 236+ A2D7 DD 21 DC 80      LD IX, EntityTable
 237+ A2DB
 238+ A2DB                  ; --- Fresh check ---
 239+ A2DB 3A 27 82         LD A, (ScreenJustRedrawn)
 240+ A2DE B7               OR A
 241+ A2DF C2 B4 A3         JP NZ, .plFresh
 242+ A2E2 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 243+ A2E6 C2 B4 A3         JP NZ, .plFresh
 244+ A2E9
 245+ A2E9                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 246+ A2E9 CD 79 A8         CALL UpdatePlayer
 247+ A2EC CD 92 A7         CALL CalcDrawX
 248+ A2EF CD 96 A2         CALL ComputePlayerDrawY
 249+ A2F2
 250+ A2F2                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 251+ A2F2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 252+ A2F5 DD BE 0C         CP (IX+ENT_OLDX)
 253+ A2F8 20 47            JR NZ, .plDoErase
 254+ A2FA 3A 0A 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 255+ A2FD DD BE 0D         CP (IX+ENT_OLDY)
 256+ A300 20 3F            JR NZ, .plDoErase
 257+ A302 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 258+ A305 DD BE 0E         CP (IX+ENT_OLDSPRID)
 259+ A308 20 37            JR NZ, .plDoErase
 260+ A30A                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 261+ A30A 3A 67 C5         LD A, (PlayerHitTimer)
 262+ A30D B7               OR A
 263+ A30E 20 01            JR NZ, .plRepaintAttr
 264+ A310 C9               RET                                 ; Nada cambio → skip todo
 265+ A311              .plRepaintAttr:
 266+ A311 3A 0A 82         LD A, (PlayerDrawY)
 267+ A314 57               LD D, A
 268+ A315 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 269+ A318 5F               LD E, A
 270+ A319 DD E5            PUSH IX
 271+ A31B CD D7 A7         CALL GetSpriteAddr
 272+ A31E DD 2A 06 A8      LD IX, (SpriteAddrTemp)
 273+ A322 CD DB 9E         CALL CalcEntityAttrSize
 274+ A325                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 275+ A325 3A AD 9F         LD A, (EntityAttrH)
 276+ A328 FE 02            CP 2
