 550+ F162                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F162 3A BB 82         LD A, (ObjectiveScreenY)
 552+ F165 47               LD B, A
 553+ F166 3A 0B 83         LD A, (CurrentScreenY)
 554+ F169 4F               LD C, A
 555+ F16A 78               LD A, B
 556+ F16B 91               SUB C
 557+ F16C F2 76 F1         JP P, .dcDyNonNeg
 558+ F16F ED 44            NEG
 559+ F171 67               LD H, A
 560+ F172 2E 00            LD L, 0
 561+ F174 18 0A            JR .dcDyDone
 562+ F176              .dcDyNonNeg:
 563+ F176 67               LD H, A
 564+ F177 B7               OR A
 565+ F178 20 04            JR NZ, .dcDyPositive
