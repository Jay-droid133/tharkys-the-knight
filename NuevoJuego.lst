1389+ F6AA 6F               LD L, A
1390+ F6AB 26 00            LD H, 0
1391+ F6AD 54               LD D, H
1392+ F6AE 5D               LD E, L
1393+ F6AF 29               ADD HL, HL
1394+ F6B0 19               ADD HL, DE                              ; HL = id*3
1395+ F6B1 11 0A E2         LD DE, BgGfxPtrById
1396+ F6B4 19               ADD HL, DE
1397+ F6B5 5E               LD E, (HL)
1398+ F6B6 23               INC HL
1399+ F6B7 56               LD D, (HL)                              ; DE = sprite ptr
1400+ F6B8 23               INC HL
1401+ F6B9 7E               LD A, (HL)                              ; A = bank
1402+ F6BA EB               EX DE, HL                               ; HL = sprite ptr
1403+ F6BB CD BC 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1404+ F6BE                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1405+ F6BE 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1406+ F6C1 57               LD D, A
1407+ F6C2 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1408+ F6C5 5F               LD E, A
1409+ F6C6 C3 31 69         JP DrawBgSprite16XorAtPixel
