 386+ 9F4A                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9F4A 7A               LD A, D                     ; Y pixel (raw)
 388+ 9F4B E6 07            AND 7                       ; Y offset dentro del char
 389+ 9F4D 4F               LD C, A
 390+ 9F4E DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9F51 81               ADD A, C                    ; + Y offset
 392+ 9F52 C6 07            ADD A, 7
 393+ 9F54 0F               RRCA
 394+ 9F55 0F               RRCA
 395+ 9F56 0F               RRCA
 396+ 9F57 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9F59 32 AD 9F         LD (EntityAttrH), A
