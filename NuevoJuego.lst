 228+ 9D05              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 229+ 9D05              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 230+ 9D05              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 231+ 9D05              ;
 232+ 9D05              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 233+ 9D05              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 234+ 9D05              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 235+ 9D05              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 236+ 9D05              StartMusic:
 237+ 9D05 32 2A 9D         LD (MusicTrackArg), A
 238+ 9D08 F3               DI
 239+ 9D09 3A E7 90         LD A, (CurrentPaging)
 240+ 9D0C E6 F8            AND $F8
 241+ 9D0E F6 04            OR 4
 242+ 9D10 32 E7 90         LD (CurrentPaging), A
 243+ 9D13 01 FD 7F         LD BC, $7FFD
 244+ 9D16 ED 79            OUT (C), A
 245+ 9D18 CD 1D E6         CALL StartMusicImpl
 246+ 9D1B 3A E7 90         LD A, (CurrentPaging)
 247+ 9D1E E6 F8            AND $F8
 248+ 9D20 32 E7 90         LD (CurrentPaging), A
 249+ 9D23 01 FD 7F         LD BC, $7FFD
 250+ 9D26 ED 79            OUT (C), A
 251+ 9D28 FB               EI
 252+ 9D29 C9               RET
 253+ 9D2A
 254+ 9D2A              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 255+ 9D2A              ; desde el Impl en bank 4 sin trampa de paging.
 256+ 9D2A 00           MusicTrackArg: DEFB 0
 257+ 9D2B
 258+ 9D2B              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 259+ 9D2B              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 260+ 9D2B              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 261+ 9D2B              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 262+ 9D2B              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 263+ 9D2B              ; (bank 0/2) puedan leer/escribir sin paging.
 264+ 9D2B 00           MusicSpeedShift: DEFB 0
 265+ 9D2C
 266+ 9D2C              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 267+ 9D2C              ; transiciones de pantalla u otros frames lentos) ---
 268+ 9D2C              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 269+ 9D2C              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 270+ 9D2C              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 271+ 9D2C              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 272+ 9D2C              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 273+ 9D2C              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 274+ 9D2C              ; tick daria 0, drift acumulando.
 275+ 9D2C 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 276+ 9D2D 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 277+ 9D2E
