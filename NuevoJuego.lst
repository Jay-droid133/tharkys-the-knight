1510+ 97E6              ; UpdateMonsterLeave - Salida al amanecer (Regla 7 / STATE_LEAVING)
1511+ 97E6              ; ==============================================================================
1512+ 97E6              ; IX = monster entity en STATE_SCARED.
1513+ 97E6              ;
1514+ 97E6              ; Primera llamada (flag MAI_FLAG_LEAVING clear): elige un gap aleatorio del
1515+ 97E6              ; screen actual, guarda side+coord en MonsterEntryBorder/ExitCoord[slot] y
1516+ 97E6              ; marca el flag. Llamadas posteriores: camina hacia el pixel del gap con AI
1517+ 97E6              ; hibrida simplificada (greedy + persistence + 4 candidatos). Al llegar al
1518+ 97E6              ; pixel objetivo setea NastyFleeDespawn=1 → .peScaredDespawn borra sprite
1519+ 97E6              ; limpiamente (sin puff).
1520+ 97E6              ;
1521+ 97E6              ; Fallback: si el screen no tiene gaps, tail-call a UpdateNastyFlee.
1522+ 97E6              ;
1523+ 97E6              ; Destruye: AF, BC, DE, HL. Preserva IX.
1524+ 97E6              ; ==============================================================================
1525+ 97E6              UpdateMonsterLeave:
1526+ 97E6                  ; --- Slot index (0..2) desde IX ---
1527+ 97E6 DD E5            PUSH IX
1528+ 97E8 E1               POP HL
1529+ 97E9 11 AB 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1530+ 97EC B7               OR A
1531+ 97ED ED 52            SBC HL, DE
1532+ 97EF CB 3D            SRL L
1533+ 97F1 CB 3D            SRL L
1534+ 97F3 CB 3D            SRL L
1535+ 97F5 CB 3D            SRL L                               ; /16 = ENT_SIZE
1536+ 97F7 7D               LD A, L
1537+ 97F8 32 CB 9A         LD (MulSlot), A
1538+ 97FB
1539+ 97FB                  ; --- Lazy init: picar gap si flag clear ---
1540+ 97FB 5F               LD E, A
1541+ 97FC 16 00            LD D, 0
1542+ 97FE 21 93 90         LD HL, MonsterAiFlags
1543+ 9801 19               ADD HL, DE
1544+ 9802 7E               LD A, (HL)
1545+ 9803 E6 02            AND MAI_FLAG_LEAVING
1546+ 9805 20 25            JR NZ, .mulHaveGap
1547+ 9807
1548+ 9807 CD B8 92         CALL MaiPickRandomGap
1549+ 980A B7               OR A
1550+ 980B C2 00 B6         JP NZ, UpdateNastyFlee              ; Sin gaps → fallback
1551+ 980E                  ; Guardar side/coord per-slot
1552+ 980E 3A CB 9A         LD A, (MulSlot)
1553+ 9811 5F               LD E, A
1554+ 9812 16 00            LD D, 0
1555+ 9814 21 8D 90         LD HL, MonsterEntryBorder
