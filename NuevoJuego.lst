2655+ AD70 38 03            JR C, .eClampXOk            ; No underflow → ok
2656+ AD72 AF               XOR A                       ; Clamp a 0
2657+ AD73 18 0E            JR .eReverseX
2658+ AD75              .eClampXOk:
2659+ AD75 DD 77 03         LD (IX+ENT_POSX), A
2660+ AD78                  ; Check colision fondo en X
2661+ AD78 CD F1 B6         CALL CheckEnemyCollision
2662+ AD7B 28 0E            JR Z, .eXDone
2663+ AD7D                  ; Colision → revertir X e invertir delta
2664+ AD7D 3A 11 AE         LD A, (.savedEX)
2665+ AD80 DD 77 03         LD (IX+ENT_POSX), A
2666+ AD83              .eReverseX:
2667+ AD83 DD 7E 06         LD A, (IX+ENT_DELTAX)
2668+ AD86 ED 44            NEG
2669+ AD88 DD 77 06         LD (IX+ENT_DELTAX), A
2670+ AD8B              .eXDone:
2671+ AD8B
