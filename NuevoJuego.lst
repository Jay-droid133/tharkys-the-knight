4646+ ACDC 57               LD D, A
4647+ ACDD 3A A2 80         LD A, (EntityTable + ENT_POSY)
4648+ ACE0 BA               CP D
4649+ ACE1 D2 03 AE         JP NC, .nextEnemyPop
4650+ ACE4
4651+ ACE4              .syCheck2:
4652+ ACE4 3A A2 80         LD A, (EntityTable + ENT_POSY)
4653+ ACE7 57               LD D, A
4654+ ACE8 3A 1F AE         LD A, (.plH)
4655+ ACEB 82               ADD A, D
4656+ ACEC C6 04            ADD A, 4
4657+ ACEE 38 08            JR C, .swordAction
4658+ ACF0 57               LD D, A
4659+ ACF1 DD 7E 04         LD A, (IX+ENT_POSY)
4660+ ACF4 BA               CP D
4661+ ACF5 D2 03 AE         JP NC, .nextEnemyPop
4662+ ACF8
4663+ ACF8                  ; Espada toca enemigo pero cuerpo no → kill sin daño al player
4664+ ACF8              .swordAction:
4665+ ACF8
4666+ ACF8                  ; Player atacando → destruir enemigo o knockback monster
4667+ ACF8 DD CB 0B 56      BIT ENTF_DESTRUCT, (IX+ENT_FLAGS)
4668+ ACFC C2 8F AD         JP NZ, .killNasty              ; Destructible → matar
4669+ ACFF                  ; No destructible (monster) → knockback
4670+ ACFF DD 7E 01         LD A, (IX+ENT_TYPE)
4671+ AD02 FE 02            CP TYPE_MONSTER
4672+ AD04 C2 B9 AD         JP NZ, .playerHit              ; No es monster → hit normal
4673+ AD07                  ; Comprobar si ya fue golpeado en ESTE ciclo de attack
4674+ AD07 DD E5            PUSH IX
4675+ AD09 E1               POP HL
4676+ AD0A 11 AE 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4677+ AD0D B7               OR A
4678+ AD0E ED 52            SBC HL, DE                          ; HL = offset desde MONSTER0
4679+ AD10                  ; HL / ENT_SIZE = indice monster (0, 1, 2)
4680+ AD10 7D               LD A, L
4681+ AD11 0F               RRCA
4682+ AD12 0F               RRCA
4683+ AD13 0F               RRCA
4684+ AD14 0F               RRCA                                ; /16 = ENT_SIZE
4685+ AD15 E6 03            AND $03                             ; indice 0-2
4686+ AD17 5F               LD E, A
4687+ AD18 16 00            LD D, 0
4688+ AD1A 21 1F A3         LD HL, MonsterHitThisAttack
4689+ AD1D 19               ADD HL, DE
4690+ AD1E 7E               LD A, (HL)
4691+ AD1F B7               OR A
4692+ AD20 C2 03 AE         JP NZ, .nextEnemyPop               ; Ya golpeado este ciclo → ignorar
4693+ AD23 36 01            LD (HL), 1                          ; Marcar como golpeado
4694+ AD25                  ; Knockback: direccion segun teclas de direccion del player
4695+ AD25 3A AE 81         LD A, (InputDirection)
4696+ AD28 B7               OR A
4697+ AD29 28 10            JR Z, .kbFromPos                ; Sin direccion → usar posicion relativa
4698+ AD2B 57               LD D, A                         ; D = input bits
4699+ AD2C                  ; Eje X: DIR_E(4) → empujar derecha, DIR_W(8) → empujar izquierda
4700+ AD2C AF               XOR A
4701+ AD2D CB 52            BIT 2, D                        ; DIR_E
4702+ AD2F 28 02            JR Z, .kbNoRight
4703+ AD31 3E 04            LD A, MONSTER_KB_SPEED
4704+ AD33              .kbNoRight:
4705+ AD33 CB 5A            BIT 3, D                        ; DIR_W
4706+ AD35 28 14            JR Z, .kbSetX
4707+ AD37 3E FC            LD A, -MONSTER_KB_SPEED
4708+ AD39 18 10            JR .kbSetX
4709+ AD3B              .kbFromPos:
4710+ AD3B                  ; Fallback: empujar segun posicion relativa al player
4711+ AD3B DD 7E 03         LD A, (IX+ENT_POSX)
4712+ AD3E 57               LD D, A
4713+ AD3F 3A A1 80         LD A, (EntityTable + ENT_POSX)
4714+ AD42 BA               CP D
4715+ AD43 30 04            JR NC, .kbPosLeft
4716+ AD45 3E 04            LD A, MONSTER_KB_SPEED          ; Monster a la derecha → empujar derecha
4717+ AD47 18 02            JR .kbSetX
4718+ AD49              .kbPosLeft:
4719+ AD49 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster a la izquierda → empujar izq
4720+ AD4B              .kbSetX:
4721+ AD4B DD 77 06         LD (IX+ENT_DELTAX), A
4722+ AD4E                  ; Eje Y: desde teclas o posicion relativa
4723+ AD4E 3A AE 81         LD A, (InputDirection)
4724+ AD51 B7               OR A
4725+ AD52 28 10            JR Z, .kbYFromPos
4726+ AD54 57               LD D, A
4727+ AD55 AF               XOR A
4728+ AD56 CB 4A            BIT 1, D                        ; DIR_S
4729+ AD58 28 02            JR Z, .kbNoDown
4730+ AD5A 3E 04            LD A, MONSTER_KB_SPEED
4731+ AD5C              .kbNoDown:
4732+ AD5C CB 42            BIT 0, D                        ; DIR_N
4733+ AD5E 28 14            JR Z, .kbSetY
4734+ AD60 3E FC            LD A, -MONSTER_KB_SPEED
4735+ AD62 18 10            JR .kbSetY
4736+ AD64              .kbYFromPos:
4737+ AD64 DD 7E 04         LD A, (IX+ENT_POSY)
4738+ AD67 57               LD D, A
4739+ AD68 3A A2 80         LD A, (EntityTable + ENT_POSY)
4740+ AD6B BA               CP D
4741+ AD6C 30 04            JR NC, .kbPosUp
4742+ AD6E 3E 04            LD A, MONSTER_KB_SPEED          ; Monster abajo → empujar abajo
4743+ AD70 18 02            JR .kbSetY
4744+ AD72              .kbPosUp:
4745+ AD72 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster arriba → empujar arriba
4746+ AD74              .kbSetY:
4747+ AD74 DD 77 07         LD (IX+ENT_DELTAY), A
4748+ AD77                  ; Iniciar stun timer (usa ENT_DIR como contador)
4749+ AD77 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_TOTAL
4750+ AD7B                  ; SFX de golpe al monster
4751+ AD7B DD E5            PUSH IX
4752+ AD7D C5               PUSH BC
4753+ AD7E 21 6B E1         LD HL, SFX_EnemyDeath
4754+ AD81 CD EC E0         CALL PlaySFX
4755+ AD84 C1               POP BC
4756+ AD85 DD E1            POP IX
4757+ AD87 18 7A            JR .nextEnemyPop
4758+ AD89
4759+ AD89              ; DEBUG: tabla de colores por golpes recibidos
4760+ AD89              .kbHitColors:
4761+ AD89 47               DEFB $47                            ; 0 hits: blanco brillante (no deberia usarse)
4762+ AD8A 44               DEFB $44                            ; 1 hit:  verde brillante
4763+ AD8B 45               DEFB $45                            ; 2 hits: cyan brillante
4764+ AD8C 46               DEFB $46                            ; 3 hits: amarillo brillante
4765+ AD8D 42               DEFB $42                            ; 4 hits: rojo brillante
4766+ AD8E 43               DEFB $43                            ; 5 hits: magenta brillante
4767+ AD8F
4768+ AD8F              .killNasty:
4769+ AD8F
4770+ AD8F                  ; Matar nasty: iniciar animacion puff
4771+ AD8F DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4772+ AD93 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4773+ AD97 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4774+ AD9B DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4775+ AD9F DD 36 06 00      LD (IX+ENT_DELTAX), 0          ; Parar movimiento
4776+ ADA3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4777+ ADA7 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40  ; Blanco brillante para el puff
4778+ ADAB                  ; SFX de muerte de enemigo
4779+ ADAB DD E5            PUSH IX
4780+ ADAD C5               PUSH BC
4781+ ADAE 21 6B E1         LD HL, SFX_EnemyDeath
4782+ ADB1 CD EC E0         CALL PlaySFX
