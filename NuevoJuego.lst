1657+ AB0D 38 07            JR C, .cpmoYCheck1
1658+ AB0F 57               LD D, A
1659+ AB10 DD 7E 03         LD A, (IX+ENT_POSX)
1660+ AB13 BA               CP D
1661+ AB14 30 24            JR NC, .cpmoNext                   ; monX >= playerX + plW → no overlap
1662+ AB16              .cpmoYCheck1:
1663+ AB16                  ; AABB Y: playerY < monY + monH AND monY < playerY + plH
1664+ AB16 DD 7E 04         LD A, (IX+ENT_POSY)
1665+ AB19 81               ADD A, C                           ; monY + monH
1666+ AB1A 38 07            JR C, .cpmoYCheck2
1667+ AB1C 57               LD D, A
1668+ AB1D 3A 47 AB         LD A, (.cpmoPlY)
1669+ AB20 BA               CP D
1670+ AB21 30 17            JR NC, .cpmoNext                   ; playerY >= monY + monH → no overlap
1671+ AB23              .cpmoYCheck2:
