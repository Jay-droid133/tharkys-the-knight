 206+ 9EE1              ; ==============================================================================
 207+ 9EE1              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ 9EE1              ; ==============================================================================
 209+ 9EE1              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ 9EE1              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ 9EE1              ; que los pies parezcan hundirse en el suelo.
 212+ 9EE1              ; ==============================================================================
 213+ 9EE1              ComputePlayerDrawY:
 214+ 9EE1                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ 9EE1                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ 9EE1                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ 9EE1 3A 94 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ 9EE4 D6 6E            SUB SPRID_PLAYER_DEATH
 219+ 9EE6 FE 06            CP 6
 220+ 9EE8 30 09            JR NC, .cpdyNotDeath
 221+ 9EEA 3A 98 81         LD A, (EntityTable + ENT_POSY)
 222+ 9EED C6 05            ADD A, 5
 223+ 9EEF 32 D5 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ 9EF2 C9               RET
 225+ 9EF3              .cpdyNotDeath:
 226+ 9EF3 3A 97 81         LD A, (EntityTable + ENT_POSX)
 227+ 9EF6 C6 08            ADD A, 8                    ; center X del player
 228+ 9EF8 47               LD B, A
 229+ 9EF9 3A 98 81         LD A, (EntityTable + ENT_POSY)
 230+ 9EFC 4F               LD C, A
 231+ 9EFD 32 D5 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ 9F00 B7               OR A
 233+ 9F01 C8               RET Z
 234+ 9F02 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ 9F03 CD 85 D5         CALL IsPointBlocked
 236+ 9F06 C8               RET Z                       ; libre → sin offset
 237+ 9F07 3A 98 81         LD A, (EntityTable + ENT_POSY)
 238+ 9F0A 3C               INC A
 239+ 9F0B 32 D5 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ 9F0E C9               RET
 241+ 9F0F
 242+ 9F0F              ; ==============================================================================
 243+ 9F0F              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ 9F0F              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ 9F0F              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ 9F0F              ; no parecer que se hunde en el techo.
 247+ 9F0F              ; Preserva: IX. Destruye: AF, BC.
 248+ 9F0F              ; ==============================================================================
 249+ 9F0F              ComputeEnemyDrawY:
 250+ 9F0F DD 7E 04         LD A, (IX+ENT_POSY)
 251+ 9F12 32 D6 82         LD (EnemyDrawY), A          ; default = POSY
 252+ 9F15 DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ 9F18 FE 02            CP TYPE_MONSTER
 254+ 9F1A C0               RET NZ                      ; no monster → sin offset
 255+ 9F1B DD 7E 03         LD A, (IX+ENT_POSX)
 256+ 9F1E C6 08            ADD A, 8                    ; center X
 257+ 9F20 47               LD B, A
 258+ 9F21 DD 7E 04         LD A, (IX+ENT_POSY)
 259+ 9F24 4F               LD C, A
 260+ 9F25 B7               OR A
 261+ 9F26 C8               RET Z
 262+ 9F27 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F28 CD 85 D5         CALL IsPointBlocked
 264+ 9F2B C8               RET Z                       ; libre → sin offset
 265+ 9F2C DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F2F 3C               INC A
 267+ 9F30 32 D6 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F33 C9               RET
