 234+ 8DB1              .lbsLoadDone:
 235+ 8DB1                  ; Page bank 0 inline
 236+ 8DB1 3A DC 8C         LD A, (CurrentPaging)
 237+ 8DB4 E6 F8            AND $F8
 238+ 8DB6 32 DC 8C         LD (CurrentPaging), A
 239+ 8DB9 01 FD 7F         LD BC, $7FFD
 240+ 8DBC ED 79            OUT (C), A
 241+ 8DBE                  ; Restaurar IFF
 242+ 8DBE F1               POP AF
 243+ 8DBF E2 C3 8D         JP PO, .lbsbNoEI                ; P/V odd = IFF2 era 0 → dejar DI
