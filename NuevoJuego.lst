5675+ C18B                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5676+ C18B                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5677+ C18B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5678+ C18E B7               OR A
5679+ C18F 20 09            JR NZ, .rmHasTypeForTrap
