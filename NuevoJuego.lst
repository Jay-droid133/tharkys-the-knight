4592+ BADB 3A 00 5D         LD A, (ZoneCellCount)
4593+ BADE B7               OR A
4594+ BADF 28 24            JR Z, .spwRandomXY                  ; lista vacia → fallback random
4595+ BAE1                  ; idx = R mod count
4596+ BAE1 47               LD B, A                             ; B = count
4597+ BAE2 ED 5F            LD A, R
4598+ BAE4              .spwIdxLoop:
