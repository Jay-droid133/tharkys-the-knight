 762+ 6411 DD E1            POP IX
 763+ 6413 3A 42 90         LD A, (CurrentPaging)
 764+ 6416 E6 F8            AND $F8
 765+ 6418 F6 06            OR 6
 766+ 641A 32 42 90         LD (CurrentPaging), A
 767+ 641D 01 FD 7F         LD BC, $7FFD
 768+ 6420 ED 79            OUT (C), A
 769+ 6422 FD 2A F1 A7      LD IY, (SpriteAddrTemp)
 770+ 6426 3A F5 81         LD A, (PlayerDrawY)
 771+ 6429 57               LD D, A
 772+ 642A DD 7E 0F         LD A, (IX+ENT_DRAWX)
 773+ 642D 5F               LD E, A
 774+ 642E CD 9E 63         CALL TownGatePlayerXOR_BiClip
 775+ 6431 3A 42 90         LD A, (CurrentPaging)
 776+ 6434 E6 F8            AND $F8
 777+ 6436 32 42 90         LD (CurrentPaging), A
 778+ 6439 01 FD 7F         LD BC, $7FFD
 779+ 643C ED 79            OUT (C), A
 780+ 643E                  ; Update OLD = current
 781+ 643E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 782+ 6441 DD 77 0C         LD (IX+ENT_OLDX), A
 783+ 6444 3A F5 81         LD A, (PlayerDrawY)
 784+ 6447 DD 77 0D         LD (IX+ENT_OLDY), A
 785+ 644A DD 7E 00         LD A, (IX+ENT_SPRITEID)
 786+ 644D DD 77 0E         LD (IX+ENT_OLDSPRID), A
 787+ 6450 C9               RET
