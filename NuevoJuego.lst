 635+ 740E 6F               LD L, A
 636+ 740F 29               ADD HL, HL
 637+ 7410 29               ADD HL, HL
 638+ 7411 29               ADD HL, HL
 639+ 7412 29               ADD HL, HL
 640+ 7413 29               ADD HL, HL                          ; *32
