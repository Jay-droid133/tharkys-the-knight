 159+ EB0A C9               RET
 160+ EB0B
 161+ EB0B              ; ==============================================================================
 162+ EB0B              ; AdvanceRouletteIdx / SkipCompassIfNeeded - helpers para saltar la entry
 163+ EB0B              ; ROUL_COMPASS del RouletteOrder cuando MagicCompassPermanent != 0
 164+ EB0B              ; ==============================================================================
 165+ EB0B              ; AdvanceRouletteIdx:    INC + wrap, luego skip-compass (uso: tick de ciclado).
 166+ EB0B              ; SkipCompassIfNeeded:   skip-compass solo, sin INC inicial (uso: idx random
 167+ EB0B              ;                        recien calculado al activar la ruleta).
 168+ EB0B              ;
 169+ EB0B              ; Fallthrough: si la wrap rama (XOR A) ejecuta, cae a SkipCompassIfNeeded.
 170+ EB0B              ; Si tras skip encuentra COMPASS, JR AdvanceRouletteIdx re-avanza.
 171+ EB0B              ;
 172+ EB0B              ; RouletteOrder garantiza 8 entries non-compass (de 9 total): el loop nunca
 173+ EB0B              ; es infinito. Si en el futuro alguien edita RouletteOrder y deja solo COMPASS,
 174+ EB0B              ; se colgaria — improbable pero merece warning en la cabecera de la tabla.
 175+ EB0B              ;
 176+ EB0B              ; IN:  A = idx actual (0..ROULETTE_ORDER_LEN-1)
 177+ EB0B              ; OUT: A = idx ajustado (RouletteOrder[A] != ROUL_COMPASS si Permanent != 0)
 178+ EB0B              ; Destruye: AF, BC, HL.
 179+ EB0B              ; ==============================================================================
 180+ EB0B              AdvanceRouletteIdx:
 181+ EB0B 3C               INC A
 182+ EB0C FE 09            CP ROULETTE_ORDER_LEN
 183+ EB0E 38 01            JR C, SkipCompassIfNeeded
 184+ EB10 AF               XOR A
 185+ EB11              SkipCompassIfNeeded:
 186+ EB11 21 C7 82         LD HL, MagicCompassPermanent
 187+ EB14 CB 46            BIT 0, (HL)
 188+ EB16 C8               RET Z                               ; lasting off: idx listo
 189+ EB17 4F               LD C, A
 190+ EB18 06 00            LD B, 0
 191+ EB1A 21 9C EA         LD HL, RouletteOrder
 192+ EB1D 09               ADD HL, BC
 193+ EB1E 7E               LD A, (HL)
 194+ EB1F FE 07            CP ROUL_COMPASS
 195+ EB21 79               LD A, C
 196+ EB22 C0               RET NZ
 197+ EB23 18 E6            JR AdvanceRouletteIdx               ; compass: re-avanzar
 198+ EB25
 199+ EB25              ; ==============================================================================
 200+ EB25              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 201+ EB25              ; ==============================================================================
 202+ EB25              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 203+ EB25              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 204+ EB25              ; carga sprite nuevo, dibuja, repaint attrs.
 205+ EB25              ; ==============================================================================
 206+ EB25              UpdateRouletteBody:
 207+ EB25 3A BC 5F         LD A, (RouletteActive)
 208+ EB28 B7               OR A
 209+ EB29 C8               RET Z
 210+ EB2A 3A B4 5F         LD A, (RandomSynthMapX)
 211+ EB2D FE FE            CP $FE
 212+ EB2F C8               RET Z                                   ; recogido / inactivo: no ciclar
 213+ EB30
 214+ EB30                  ; Tick frame counter
 215+ EB30 21 BE 5F         LD HL, RouletteFrameCounter
 216+ EB33 35               DEC (HL)
 217+ EB34 C0               RET NZ                                  ; aun no toca avanzar
 218+ EB35
 219+ EB35                  ; --- Counter expirado: ciclar al siguiente tipo ---
 220+ EB35 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 221+ EB37 32 BE 5F         LD (RouletteFrameCounter), A
 222+ EB3A
 223+ EB3A                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 224+ EB3A 2A B6 5F         LD HL, (RandomSynthPtr)
 225+ EB3D 3E 03            LD A, 3
 226+ EB3F CD 5B 6D         CALL LoadBgSpriteToBuffer_B7
 227+ EB42 3A B8 5F         LD A, (RandomSynthCharX)
 228+ EB45 47               LD B, A
 229+ EB46 3A B9 5F         LD A, (RandomSynthCharY)
 230+ EB49 4F               LD C, A
 231+ EB4A DD 21 F7 86      LD IX, BgSpriteBuffer
 232+ EB4E CD 1C 6D         CALL DrawBgSpriteXOR_B7
