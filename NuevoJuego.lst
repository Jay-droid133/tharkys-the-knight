 236+ EB64              ; ==============================================================================
 237+ EB64              ; AdvanceRouletteIdx / SkipCompassIfNeeded - INC con wrap mod ROULETTE_ORDER_LEN
 238+ EB64              ; ==============================================================================
 239+ EB64              ; Tras fase 5 (ruleta por categorias), el skip-compass vive en GetRoulettePtrByIdx
 240+ EB64              ; (re-pica dentro de la cat si sale COMPASS + permanent). Aqui solo queda el
 241+ EB64              ; INC + wrap. SkipCompassIfNeeded mantiene su nombre por compatibilidad con
 242+ EB64              ; .urpDoRoulette init (caller).
 243+ EB64              ;
 244+ EB64              ; IN:  A = idx actual (0..ROULETTE_ORDER_LEN-1)
 245+ EB64              ; OUT: A = idx avanzado (mod 6). Para SkipCompassIfNeeded: A sin cambios.
 246+ EB64              ; Destruye: AF.
 247+ EB64              ; ==============================================================================
 248+ EB64              AdvanceRouletteIdx:
 249+ EB64 3C               INC A
 250+ EB65 FE 06            CP ROULETTE_ORDER_LEN
 251+ EB67 D8               RET C
 252+ EB68 AF               XOR A
 253+ EB69 C9               RET
 254+ EB6A              SkipCompassIfNeeded:
 255+ EB6A                  ; No-op: el skip-compass vive en GetRoulettePtrByIdx (re-pick within cat).
 256+ EB6A C9               RET
