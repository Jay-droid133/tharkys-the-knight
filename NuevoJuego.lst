 240  E90D                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ E90D              ; ==============================================================================
   2+ E90D              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ E90D              ; ==============================================================================
   4+ E90D              ; CurrentObjective vive en variables.asm. Valor:
   5+ E90D              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ E90D              ;   9    = todos los hitos completados (juego ganado)
   7+ E90D              ;
   8+ E90D              ; ----------------------------------------------------------------------------
   9+ E90D              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ E90D              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ E90D              ;                       recoger el sprite cuyo behavior coincide.
  12+ E90D              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ E90D              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ E90D              ;                       Avanza al disparar el trigger correspondiente.
  15+ E90D              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ E90D              ;
  17+ E90D              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ E90D              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ E90D              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ E90D              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ E90D              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ E90D              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ E90D              ;
  24+ E90D              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ E90D              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ E90D              ; mecanica real.
  27+ E90D              ; ==============================================================================
  28+ E90D
  29+ E90D              MILESTONE_TYPE_PICKUP   EQU 1
  30+ E90D              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ E90D              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ E90D
  33+ E90D              MilestoneTable:
  34+ E90D 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ E90F 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ E911 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ E913 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ E915 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ E917 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ E919 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ E91B 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ E91D 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ E91F
  44+ E91F              MilestoneResolveTable:
  45+ E91F 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ E921 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ E923 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ E925 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ E927 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ E929 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ E92B 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ E92D 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ E92F 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ E931
  55+ E931              ; ==============================================================================
  56+ E931              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ E931              ; ==============================================================================
  58+ E931              ; IN:  A = key id (1..6) recien recogida
  59+ E931              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ E931              ; ==============================================================================
  61+ E931              CheckMilestonePickup:
  62+ E931 E5               PUSH HL
  63+ E932 D5               PUSH DE
  64+ E933 C5               PUSH BC
  65+ E934 F5               PUSH AF
  66+ E935 47               LD B, A                             ; B = key id recibida
  67+ E936 3A E2 81         LD A, (CurrentObjective)
  68+ E939 FE 09            CP 9
  69+ E93B 30 21            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ E93D 87               ADD A, A                            ; *2 (entry size)
  71+ E93E 6F               LD L, A
  72+ E93F 26 00            LD H, 0
  73+ E941 11 0D E9         LD DE, MilestoneTable
  74+ E944 19               ADD HL, DE
  75+ E945 7E               LD A, (HL)                          ; tipo
  76+ E946 FE 01            CP MILESTONE_TYPE_PICKUP
  77+ E948 20 14            JR NZ, .cmpDone
  78+ E94A 23               INC HL
  79+ E94B 7E               LD A, (HL)                          ; ref esperada
  80+ E94C B8               CP B
  81+ E94D 20 0F            JR NZ, .cmpDone
  82+ E94F 3A E2 81         LD A, (CurrentObjective)
  83+ E952 3C               INC A
  84+ E953 32 E2 81         LD (CurrentObjective), A
  85+ E956 CD E5 E9         CALL ResolveObjectiveScreen
  86+ E959 3E FF            LD A, $FF
  87+ E95B 32 E5 81         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ E95E              .cmpDone:
  89+ E95E F1               POP AF
  90+ E95F C1               POP BC
  91+ E960 D1               POP DE
  92+ E961 E1               POP HL
  93+ E962 C9               RET
  94+ E963
  95+ E963              ; ==============================================================================
  96+ E963              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
  97+ E963              ; ==============================================================================
  98+ E963              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
  99+ E963              ; Preserva: AF, BC, DE, HL.
 100+ E963              ; ==============================================================================
 101+ E963              CheckMilestoneTrigger:
 102+ E963 E5               PUSH HL
 103+ E964 D5               PUSH DE
 104+ E965 C5               PUSH BC
 105+ E966 F5               PUSH AF
 106+ E967 47               LD B, A
 107+ E968 3A E2 81         LD A, (CurrentObjective)
 108+ E96B FE 09            CP 9
 109+ E96D 30 21            JR NC, .cmtDone
 110+ E96F 87               ADD A, A
 111+ E970 6F               LD L, A
 112+ E971 26 00            LD H, 0
 113+ E973 11 0D E9         LD DE, MilestoneTable
 114+ E976 19               ADD HL, DE
 115+ E977 7E               LD A, (HL)
 116+ E978 FE 02            CP MILESTONE_TYPE_TRIGGER
 117+ E97A 20 14            JR NZ, .cmtDone
 118+ E97C 23               INC HL
 119+ E97D 7E               LD A, (HL)
 120+ E97E B8               CP B
 121+ E97F 20 0F            JR NZ, .cmtDone
 122+ E981 3A E2 81         LD A, (CurrentObjective)
 123+ E984 3C               INC A
 124+ E985 32 E2 81         LD (CurrentObjective), A
 125+ E988 CD E5 E9         CALL ResolveObjectiveScreen
 126+ E98B 3E FF            LD A, $FF
 127+ E98D 32 E5 81         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 128+ E990              .cmtDone:
 129+ E990 F1               POP AF
 130+ E991 C1               POP BC
 131+ E992 D1               POP DE
 132+ E993 E1               POP HL
 133+ E994 C9               RET
 134+ E995
 135+ E995              ; ==============================================================================
 136+ E995              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 137+ E995              ; ==============================================================================
 138+ E995              CheckMilestoneDebugKey:
 139+ E995 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 140+ E997 DB FE            IN A, ($FE)
 141+ E999 CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 142+ E99B 20 1D            JR NZ, .cmdkNotPressed
 143+ E99D 3A BF E9         LD A, (MilestoneKeyDebounce)
 144+ E9A0 B7               OR A
 145+ E9A1 C0               RET NZ
 146+ E9A2 3E 01            LD A, 1
 147+ E9A4 32 BF E9         LD (MilestoneKeyDebounce), A
 148+ E9A7 3A E2 81         LD A, (CurrentObjective)
 149+ E9AA FE 09            CP 9
 150+ E9AC D0               RET NC
 151+ E9AD 3C               INC A
 152+ E9AE 32 E2 81         LD (CurrentObjective), A
 153+ E9B1 CD E5 E9         CALL ResolveObjectiveScreen
 154+ E9B4 3E FF            LD A, $FF
 155+ E9B6 32 E5 81         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 156+ E9B9 C9               RET
 157+ E9BA              .cmdkNotPressed:
 158+ E9BA AF               XOR A
 159+ E9BB 32 BF E9         LD (MilestoneKeyDebounce), A
 160+ E9BE C9               RET
 161+ E9BF
 162+ E9BF 00           MilestoneKeyDebounce: DEFB 0
 163+ E9C0
 164+ E9C0              ; ==============================================================================
 165+ E9C0              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 166+ E9C0              ; ==============================================================================
 167+ E9C0              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 168+ E9C0              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 169+ E9C0              ; inmediato del valor actual.
 170+ E9C0              ; ==============================================================================
 171+ E9C0              CheckCurrentKeyCycleKey:
 172+ E9C0 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 173+ E9C2 DB FE            IN A, ($FE)
 174+ E9C4 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 175+ E9C6 20 17            JR NZ, .ckcNotPressed
 176+ E9C8 3A E4 E9         LD A, (CurrentKeyCycleDebounce)
 177+ E9CB B7               OR A
 178+ E9CC C0               RET NZ
 179+ E9CD 3E 01            LD A, 1
 180+ E9CF 32 E4 E9         LD (CurrentKeyCycleDebounce), A
 181+ E9D2 3A DA 81         LD A, (CurrentKey)
 182+ E9D5 3C               INC A
 183+ E9D6 FE 07            CP 7
 184+ E9D8 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 185+ E9DA AF               XOR A                               ; 7 -> wrap a 0
 186+ E9DB              .ckcSet:
 187+ E9DB 32 DA 81         LD (CurrentKey), A
 188+ E9DE C9               RET
 189+ E9DF              .ckcNotPressed:
 190+ E9DF AF               XOR A
 191+ E9E0 32 E4 E9         LD (CurrentKeyCycleDebounce), A
 192+ E9E3 C9               RET
 193+ E9E4
 194+ E9E4 00           CurrentKeyCycleDebounce: DEFB 0
 195+ E9E5
 196+ E9E5              ; ==============================================================================
 197+ E9E5              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 198+ E9E5              ; ==============================================================================
 199+ E9E5              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 200+ E9E5              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 201+ E9E5              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 202+ E9E5              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 203+ E9E5              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 204+ E9E5              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 205+ E9E5              ;               actuales; queda como salvaguarda.
 206+ E9E5              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 207+ E9E5              ; Destruye: AF, BC, DE, HL.
 208+ E9E5              ; ==============================================================================
 209+ E9E5              ResolveObjectiveScreen:
 210+ E9E5 3A E2 81         LD A, (CurrentObjective)
 211+ E9E8 FE 09            CP 9
 212+ E9EA 30 2F            JR NC, .rosNoTarget
 213+ E9EC 87               ADD A, A
 214+ E9ED 6F               LD L, A
 215+ E9EE 26 00            LD H, 0
 216+ E9F0 11 1F E9         LD DE, MilestoneResolveTable
 217+ E9F3 19               ADD HL, DE
 218+ E9F4 7E               LD A, (HL)                          ; tipo
 219+ E9F5 23               INC HL
 220+ E9F6 46               LD B, (HL)                          ; B = ref
 221+ E9F7 FE 01            CP MILESTONE_TYPE_PICKUP
 222+ E9F9 28 06            JR Z, .rosPickup
