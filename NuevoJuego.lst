1095+ EF65 6F               LD L, A
1096+ EF66 29               ADD HL, HL
1097+ EF67 29               ADD HL, HL
1098+ EF68 29               ADD HL, HL
1099+ EF69 29               ADD HL, HL
1100+ EF6A 29               ADD HL, HL                          ; *32
1101+ EF6B 3A B8 5F         LD A, (RandomSynthCharX)
1102+ EF6E 85               ADD A, L
1103+ EF6F 6F               LD L, A
1104+ EF70 30 01            JR NC, .pspaNoCarry
1105+ EF72 24               INC H
1106+ EF73              .pspaNoCarry:
1107+ EF73 11 00 58         LD DE, ATTR_BASE
1108+ EF76 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
1109+ EF77                  ; --- Fila 0: TL, TR ---
1110+ EF77 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
1111+ EF7A 77               LD (HL), A
1112+ EF7B 23               INC HL
1113+ EF7C 3A E1 5F         LD A, (RandomSynthAttrTR)
1114+ EF7F 77               LD (HL), A
1115+ EF80                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
1116+ EF80 7D               LD A, L
1117+ EF81 C6 1F            ADD A, 31
1118+ EF83 6F               LD L, A
1119+ EF84 30 01            JR NC, .pspaNoCarry2
1120+ EF86 24               INC H
1121+ EF87              .pspaNoCarry2:
1122+ EF87                  ; --- Fila 1: BL, BR ---
1123+ EF87 3A E2 5F         LD A, (RandomSynthAttrBL)
1124+ EF8A 77               LD (HL), A
1125+ EF8B 23               INC HL
1126+ EF8C 3A E3 5F         LD A, (RandomSynthAttrBR)
1127+ EF8F 77               LD (HL), A
1128+ EF90 C9               RET
