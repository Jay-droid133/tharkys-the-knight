7479+ C8D0 23               INC HL
7480+ C8D1 3A 79 5F         LD A, (DBfsTryCy)
7481+ C8D4 77               LD (HL), A
7482+ C8D5 23               INC HL
7483+ C8D6 78               LD A, B
7484+ C8D7 77               LD (HL), A
7485+ C8D8 23               INC HL
7486+ C8D9 3A 77 5F         LD A, (DBfsCurDepth)
7487+ C8DC 3C               INC A
