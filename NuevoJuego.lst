4871+ BD27 FE 03            CP STATE_DYING
4872+ BD29 28 1B            JR Z, .kanSkip                  ; ya muriendo
4873+ BD2B                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4874+ BD2B                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4875+ BD2B                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4876+ BD2B                  ; del nasty: peDying paintea el rect del puff con ese color)
4877+ BD2B CD 4F BD         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4878+ BD2E DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4879+ BD32 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4880+ BD36 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4881+ BD3A DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4882+ BD3E DD 36 06 00      LD (IX+ENT_DELTAX), 0
4883+ BD42 DD 36 07 00      LD (IX+ENT_DELTAY), 0
