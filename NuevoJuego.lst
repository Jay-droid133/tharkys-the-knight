 158+ 9E80              ; InitEntities - Inicializa la tabla de entidades
 159+ 9E80              ; ==============================================================================
 160+ 9E80              ; Limpia todos los slots y configura el slot 0 como player.
 161+ 9E80              ; ==============================================================================
 162+ 9E80              InitEntities:
 163+ 9E80                  ; Limpiar toda la tabla a ceros
 164+ 9E80 21 9E 81         LD HL, EntityTable
 165+ 9E83 11 9F 81         LD DE, EntityTable + 1
 166+ 9E86 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E89 AF               XOR A
