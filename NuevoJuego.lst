4971+ A88B DD 7E 01         LD A, (IX+ENT_TYPE)
4972+ A88E FE 02            CP TYPE_MONSTER
4973+ A890 C2 5E A9         JP NZ, .playerHit              ; No es monster → hit normal
4974+ A893                  ; Comprobar si ya fue golpeado en ESTE ciclo de attack
4975+ A893 DD E5            PUSH IX
4976+ A895 E1               POP HL
4977+ A896 11 95 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4978+ A899 B7               OR A
4979+ A89A ED 52            SBC HL, DE                          ; HL = offset desde MONSTER0
4980+ A89C                  ; HL / ENT_SIZE = indice monster (0, 1, 2)
4981+ A89C 7D               LD A, L
4982+ A89D 0F               RRCA
4983+ A89E 0F               RRCA
4984+ A89F 0F               RRCA
4985+ A8A0 0F               RRCA                                ; /16 = ENT_SIZE
4986+ A8A1 E6 03            AND $03                             ; indice 0-2
4987+ A8A3 5F               LD E, A
4988+ A8A4 16 00            LD D, 0
4989+ A8A6 21 4B 9D         LD HL, MonsterHitThisAttack
4990+ A8A9 19               ADD HL, DE
4991+ A8AA 7E               LD A, (HL)
4992+ A8AB B7               OR A
4993+ A8AC C2 A8 A9         JP NZ, .nextEnemyPop               ; Ya golpeado este ciclo → ignorar
4994+ A8AF 36 01            LD (HL), 1                          ; Marcar como golpeado
4995+ A8B1                  ; Knockback: direccion segun teclas de direccion del player
4996+ A8B1 3A 95 81         LD A, (InputDirection)
4997+ A8B4 B7               OR A
4998+ A8B5 28 10            JR Z, .kbFromPos                ; Sin direccion → usar posicion relativa
4999+ A8B7 57               LD D, A                         ; D = input bits
5000+ A8B8                  ; Eje X: DIR_E(4) → empujar derecha, DIR_W(8) → empujar izquierda
5001+ A8B8 AF               XOR A
5002+ A8B9 CB 52            BIT 2, D                        ; DIR_E
5003+ A8BB 28 02            JR Z, .kbNoRight
5004+ A8BD 3E 04            LD A, MONSTER_KB_SPEED
5005+ A8BF              .kbNoRight:
5006+ A8BF CB 5A            BIT 3, D                        ; DIR_W
5007+ A8C1 28 14            JR Z, .kbSetX
5008+ A8C3 3E FC            LD A, -MONSTER_KB_SPEED
5009+ A8C5 18 10            JR .kbSetX
5010+ A8C7              .kbFromPos:
5011+ A8C7                  ; Fallback: empujar segun posicion relativa al player
5012+ A8C7 DD 7E 03         LD A, (IX+ENT_POSX)
5013+ A8CA 57               LD D, A
5014+ A8CB 3A 88 80         LD A, (EntityTable + ENT_POSX)
5015+ A8CE BA               CP D
5016+ A8CF 30 04            JR NC, .kbPosLeft
5017+ A8D1 3E 04            LD A, MONSTER_KB_SPEED          ; Monster a la derecha → empujar derecha
5018+ A8D3 18 02            JR .kbSetX
5019+ A8D5              .kbPosLeft:
5020+ A8D5 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster a la izquierda → empujar izq
5021+ A8D7              .kbSetX:
5022+ A8D7 DD 77 06         LD (IX+ENT_DELTAX), A
5023+ A8DA                  ; Eje Y: desde teclas o posicion relativa
5024+ A8DA 3A 95 81         LD A, (InputDirection)
5025+ A8DD B7               OR A
5026+ A8DE 28 10            JR Z, .kbYFromPos
5027+ A8E0 57               LD D, A
5028+ A8E1 AF               XOR A
5029+ A8E2 CB 4A            BIT 1, D                        ; DIR_S
5030+ A8E4 28 02            JR Z, .kbNoDown
5031+ A8E6 3E 04            LD A, MONSTER_KB_SPEED
5032+ A8E8              .kbNoDown:
5033+ A8E8 CB 42            BIT 0, D                        ; DIR_N
5034+ A8EA 28 14            JR Z, .kbSetY
5035+ A8EC 3E FC            LD A, -MONSTER_KB_SPEED
5036+ A8EE 18 10            JR .kbSetY
5037+ A8F0              .kbYFromPos:
5038+ A8F0 DD 7E 04         LD A, (IX+ENT_POSY)
5039+ A8F3 57               LD D, A
5040+ A8F4 3A 89 80         LD A, (EntityTable + ENT_POSY)
5041+ A8F7 BA               CP D
5042+ A8F8 30 04            JR NC, .kbPosUp
5043+ A8FA 3E 04            LD A, MONSTER_KB_SPEED          ; Monster abajo → empujar abajo
5044+ A8FC 18 02            JR .kbSetY
5045+ A8FE              .kbPosUp:
5046+ A8FE 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster arriba → empujar arriba
5047+ A900              .kbSetY:
5048+ A900 DD 77 07         LD (IX+ENT_DELTAY), A
5049+ A903                  ; Incrementar hit counter (bits 4-7 de ENT_FLAGS)
5050+ A903 DD 7E 0B         LD A, (IX+ENT_FLAGS)
5051+ A906 C6 10            ADD A, $10                          ; +1 en nibble alto
5052+ A908 DD 77 0B         LD (IX+ENT_FLAGS), A
5053+ A90B                  ; DEBUG: color segun golpes (blanco→verde→cyan→amarillo→rojo→magenta)
5054+ A90B E6 F0            AND $F0
5055+ A90D 0F               RRCA
5056+ A90E 0F               RRCA
5057+ A90F 0F               RRCA
5058+ A910 0F               RRCA                                ; A = hit count (0-5)
5059+ A911 21 2E A9         LD HL, .kbHitColors
5060+ A914 5F               LD E, A
5061+ A915 16 00            LD D, 0
5062+ A917 19               ADD HL, DE
5063+ A918 7E               LD A, (HL)
5064+ A919 DD 77 05         LD (IX+ENT_ATTR), A
5065+ A91C                  ; Iniciar stun timer (usa ENT_DIR como contador)
5066+ A91C DD 36 0A 18      LD (IX+ENT_DIR), MONSTER_STUN_TOTAL
5067+ A920                  ; SFX de golpe al monster
5068+ A920 DD E5            PUSH IX
5069+ A922 C5               PUSH BC
5070+ A923 21 8D F4         LD HL, SFX_EnemyDeath
5071+ A926 CD 0F F4         CALL PlaySFX
5072+ A929 C1               POP BC
5073+ A92A DD E1            POP IX
5074+ A92C 18 7A            JR .nextEnemyPop
5075+ A92E
5076+ A92E              ; DEBUG: tabla de colores por golpes recibidos
5077+ A92E              .kbHitColors:
5078+ A92E 47               DEFB $47                            ; 0 hits: blanco brillante (no deberia usarse)
5079+ A92F 44               DEFB $44                            ; 1 hit:  verde brillante
5080+ A930 45               DEFB $45                            ; 2 hits: cyan brillante
5081+ A931 46               DEFB $46                            ; 3 hits: amarillo brillante
5082+ A932 42               DEFB $42                            ; 4 hits: rojo brillante
5083+ A933 43               DEFB $43                            ; 5 hits: magenta brillante
5084+ A934
5085+ A934              .killNasty:
5086+ A934
5087+ A934                  ; Matar nasty: iniciar animacion puff
5088+ A934 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5089+ A938 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5090+ A93C DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5091+ A940 DD 36 09 03      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5092+ A944 DD 36 06 00      LD (IX+ENT_DELTAX), 0          ; Parar movimiento
5093+ A948 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5094+ A94C DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40  ; Blanco brillante para el puff
5095+ A950                  ; SFX de muerte de enemigo
5096+ A950 DD E5            PUSH IX
5097+ A952 C5               PUSH BC
5098+ A953 21 8D F4         LD HL, SFX_EnemyDeath
5099+ A956 CD 0F F4         CALL PlaySFX
5100+ A959 C1               POP BC
5101+ A95A DD E1            POP IX
5102+ A95C 18 4A            JR .nextEnemyPop
5103+ A95E
5104+ A95E              .playerHit:
5105+ A95E                  ; Inmunidad temporal tras recibir daño (durante flash rojo)
5106+ A95E 3A C7 A9         LD A, (PlayerHitTimer)
5107+ A961 B7               OR A
5108+ A962 C2 A8 A9         JP NZ, .nextEnemyPop                ; Aun en inmunidad → ignorar
5109+ A965                  ; Enemigo toca al player → daño al player
5110+ A965 3A 44 9D         LD A, (PlayerHealth)
5111+ A968 B7               OR A
5112+ A969 CA A8 A9         JP Z, .nextEnemyPop                 ; Ya muerto, ignorar
5113+ A96C 3D               DEC A
5114+ A96D 32 44 9D         LD (PlayerHealth), A
5115+ A970                  ; Flash rojo
5116+ A970 3E 42            LD A, RED | $40
5117+ A972 32 8A 80         LD (EntityTable + ENT_ATTR), A
5118+ A975 3E 0C            LD A, 12
5119+ A977 32 C7 A9         LD (PlayerHitTimer), A
5120+ A97A                  ; Si nasty destructible → muere al tocar al player
5121+ A97A DD CB 0B 56      BIT ENTF_DESTRUCT, (IX+ENT_FLAGS)
5122+ A97E 28 1C            JR Z, .playerHitSFX
5123+ A980 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5124+ A984 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5125+ A988 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5126+ A98C DD 36 09 03      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5127+ A990 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5128+ A994 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5129+ A998 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
5130+ A99C              .playerHitSFX:
5131+ A99C                  ; SFX de golpe al player
5132+ A99C DD E5            PUSH IX
5133+ A99E C5               PUSH BC
5134+ A99F 21 9A F4         LD HL, SFX_PlayerHit
5135+ A9A2 CD 0F F4         CALL PlaySFX
5136+ A9A5 C1               POP BC
5137+ A9A6 DD E1            POP IX
5138+ A9A8
5139+ A9A8              .nextEnemyPop:
5140+ A9A8 C1               POP BC                      ; restaurar loop counter
5141+ A9A9              .nextEnemy:
5142+ A9A9 11 10 00         LD DE, ENT_SIZE
5143+ A9AC DD 19            ADD IX, DE
5144+ A9AE 05               DEC B
5145+ A9AF C2 A9 A7         JP NZ, .checkLoop
5146+ A9B2
5147+ A9B2                  ; Countdown del flash rojo
5148+ A9B2 3A C7 A9         LD A, (PlayerHitTimer)
5149+ A9B5 B7               OR A
5150+ A9B6 C8               RET Z
5151+ A9B7 3D               DEC A
5152+ A9B8 32 C7 A9         LD (PlayerHitTimer), A
5153+ A9BB C0               RET NZ
5154+ A9BC                  ; Timer llego a 0: restaurar color segun stamina actual
5155+ A9BC CD 31 96         CALL GetStaminaColor
5156+ A9BF 32 8A 80         LD (EntityTable + ENT_ATTR), A
5157+ A9C2 C9               RET
5158+ A9C3
5159+ A9C3 00           .plW: DEFB 0
5160+ A9C4 00           .plH: DEFB 0
5161+ A9C5 00           .enW: DEFB 0
5162+ A9C6 00           .enH: DEFB 0
5163+ A9C7 00           PlayerHitTimer: DEFB 0
