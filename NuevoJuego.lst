 657+ ED11
 658+ ED11              ; ==============================================================================
 659+ ED11              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 660+ ED11              ; ==============================================================================
 661+ ED11              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 662+ ED11              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 663+ ED11              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 664+ ED11              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 665+ ED11              ; ==============================================================================
 666+ ED11              UpdateSpeedBuffBody:
 667+ ED11 3A E1 82         LD A, (SpeedBuffType)
 668+ ED14 B7               OR A
 669+ ED15 C8               RET Z                               ; sin buff activo
 670+ ED16                  ; Tick 16-bit timer.
 671+ ED16 2A DF 82         LD HL, (SpeedBuffTimer)
 672+ ED19 2B               DEC HL
 673+ ED1A 22 DF 82         LD (SpeedBuffTimer), HL
 674+ ED1D 7C               LD A, H
 675+ ED1E B5               OR L
 676+ ED1F C0               RET NZ                              ; buff aun activo (color via cycler)
 677+ ED20                  ; Buff terminado: reset speeds + clear type. Color lo pinta el cycler.
 678+ ED20 3E 04            LD A, SPEED_RUN
 679+ ED22 32 DD 82         LD (PlayerSpeedRun), A
 680+ ED25 3E 02            LD A, SPEED_FIGHT
 681+ ED27 32 DE 82         LD (PlayerSpeedFight), A
 682+ ED2A AF               XOR A
 683+ ED2B 32 E1 82         LD (SpeedBuffType), A
 684+ ED2E C9               RET
 685+ ED2F
 686+ ED2F              ; ==============================================================================
 687+ ED2F              ; UpdateRandomPickup - room-enter hook
 688+ ED2F              ; ==============================================================================
 689+ ED2F              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 690+ ED2F              ; Early-out si ScreenDirty=0 (no transition).
 691+ ED2F              ;
 692+ ED2F              ; En transition:
 693+ ED2F              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 694+ ED2F              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 695+ ED2F              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 696+ ED2F              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 697+ ED2F              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 698+ ED2F              ;
 699+ ED2F              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 700+ ED2F              ; fijos (id, charX, charY, v) terminados con id=$FF.
 701+ ED2F              ;
 702+ ED2F              ; Destruye AF, BC, DE, HL.
 703+ ED2F              ; ==============================================================================
 704+ ED2F              UpdateRandomPickupBody:
 705+ ED2F 3A 18 83         LD A, (ScreenDirty)
 706+ ED32 B7               OR A
 707+ ED33 C8               RET Z
 708+ ED34
 709+ ED34                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 710+ ED34 3E FE            LD A, $FE
 711+ ED36 32 B4 5F         LD (RandomSynthMapX), A
 712+ ED39 AF               XOR A
 713+ ED3A 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 714+ ED3D
 715+ ED3D                  ; --- Scan BG stream, build SlotList ---
 716+ ED3D AF               XOR A
 717+ ED3E 32 AB 5F         LD (RandomSlotCount), A
 718+ ED41 2A 12 83         LD HL, (CurrentScreenAddr)
 719+ ED44              .urpScanLoop:
 720+ ED44 7E               LD A, (HL)                          ; A = id
 721+ ED45 FE FF            CP $FF
 722+ ED47 28 2A            JR Z, .urpScanDone
 723+ ED49 FE D2            CP RANDOM_SLOT_MARKER
 724+ ED4B 20 20            JR NZ, .urpSkipEntry
 725+ ED4D                  ; Es marker. Cap reached?
 726+ ED4D 3A AB 5F         LD A, (RandomSlotCount)
 727+ ED50 FE 04            CP RANDOM_SLOT_MAX
 728+ ED52 30 19            JR NC, .urpSkipEntry
 729+ ED54                  ; SlotList[count*2] = charX, [count*2+1] = charY
 730+ ED54 23               INC HL                              ; HL @ charX
 731+ ED55 46               LD B, (HL)                          ; B = charX
 732+ ED56 23               INC HL                              ; HL @ charY
 733+ ED57 4E               LD C, (HL)                          ; C = charY
 734+ ED58 E5               PUSH HL                             ; save HL @ charY
 735+ ED59 87               ADD A, A                            ; A = count*2
 736+ ED5A 6F               LD L, A
 737+ ED5B 26 00            LD H, 0
 738+ ED5D 11 AC 5F         LD DE, RandomSlotList
 739+ ED60 19               ADD HL, DE
 740+ ED61 70               LD (HL), B                          ; charX
 741+ ED62 23               INC HL
 742+ ED63 71               LD (HL), C                          ; charY
 743+ ED64 21 AB 5F         LD HL, RandomSlotCount
 744+ ED67 34               INC (HL)
 745+ ED68 E1               POP HL                              ; HL @ charY
 746+ ED69 23               INC HL                              ; HL @ v
 747+ ED6A 23               INC HL                              ; HL @ next id
 748+ ED6B 18 D7            JR .urpScanLoop
 749+ ED6D              .urpSkipEntry:
 750+ ED6D                  ; Skip entry: 4 bytes (id, charX, charY, v).
 751+ ED6D 23               INC HL
 751+ ED6E 23             INC HL
 751+ ED6F 23             INC HL
 751+ ED70 23             INC HL
 752+ ED71 18 D1            JR .urpScanLoop
 753+ ED73              .urpScanDone:
 754+ ED73
 755+ ED73                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 756+ ED73 3A AB 5F         LD A, (RandomSlotCount)
 757+ ED76 B7               OR A
 758+ ED77 CA 20 EF         JP Z, .urpZeroAndRotate
 759+ ED7A
 760+ ED7A                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 761+ ED7A                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 762+ ED7A                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 763+ ED7A 3A 11 83         LD A, (CurrentScreenY)
 764+ ED7D 07               RLCA
 764+ ED7E 07             RLCA
 764+ ED7F 07             RLCA
 764+ ED80 07             RLCA           ; Y*16
 765+ ED81 21 10 83         LD HL, CurrentScreenX
 766+ ED84 86               ADD A, (HL)                         ; A = newSid
 767+ ED85 47               LD B, A                             ; B = newSid (preservar)
 768+ ED86 3A D1 5F         LD A, (RP_PrevSid)
 769+ ED89 B8               CP B
 770+ ED8A 20 1A            JR NZ, .urpCacheMiss
 771+ ED8C                  ; HIT prev. Validar slot < count.
 772+ ED8C 3A D2 5F         LD A, (RP_PrevSlot)
 773+ ED8F 4F               LD C, A                             ; C = cached slot
 774+ ED90 3A AB 5F         LD A, (RandomSlotCount)
 775+ ED93 B9               CP C
 776+ ED94 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 777+ ED96 38 0E            JR C, .urpCacheMiss
 778+ ED98                  ; Restaurar: usar cached slot + cached rolled.
 779+ ED98 79               LD A, C
 780+ ED99 32 D4 5F         LD (RP_TmpSlot), A
 781+ ED9C 3A D3 5F         LD A, (RP_PrevRolled)
 782+ ED9F 32 D5 5F         LD (RP_TmpRolled), A
 783+ EDA2 79               LD A, C                             ; A = slot
 784+ EDA3 C3 09 EE         JP .urpReadSlotAndDispatchCache
 785+ EDA6
 786+ EDA6              .urpCacheMiss:
 787+ EDA6 3A AB 5F         LD A, (RandomSlotCount)
 788+ EDA9                  ; --- Pick slot via R mod count ---
 789+ EDA9 47               LD B, A                             ; B = count
 790+ EDAA ED 5F            LD A, R
 791+ EDAC              .urpModLoop:
 792+ EDAC 90               SUB B
 793+ EDAD 30 FD            JR NC, .urpModLoop
 794+ EDAF 80               ADD A, B                            ; A = R mod count, [0..count-1]
 795+ EDB0 32 D4 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
 796+ EDB3
 797+ EDB3                  ; --- Read SlotList[A*2] = (charX, charY) ---
 798+ EDB3 87               ADD A, A
 799+ EDB4 5F               LD E, A
 800+ EDB5 16 00            LD D, 0
 801+ EDB7 21 AC 5F         LD HL, RandomSlotList
 802+ EDBA 19               ADD HL, DE
 803+ EDBB 7E               LD A, (HL)                          ; charX
 804+ EDBC 32 B8 5F         LD (RandomSynthCharX), A
 805+ EDBF 23               INC HL
 806+ EDC0 7E               LD A, (HL)                          ; charY
 807+ EDC1 32 B9 5F         LD (RandomSynthCharY), A
 808+ EDC4
 809+ EDC4                  ; --- Roll type usando R XOR SYS_FRAMES ---
 810+ EDC4                  IF DEBUG_FORCE_COMPASS
 811+ EDC4 ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 812+ EDC4 ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 813+ EDC4 ~                    JP .urpDoCompass
 814+ EDC4                  ENDIF
 815+ EDC4                  IF DEBUG_FORCE_MUSHROOM
 816+ EDC4 ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 817+ EDC4 ~                    JP .urpDoMushroom
 818+ EDC4                  ENDIF
 819+ EDC4                  IF DEBUG_FORCE_ROULETTE
 820+ EDC4 ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 821+ EDC4 ~                    JP .urpDoRoulette
 822+ EDC4                  ENDIF
 823+ EDC4                  IF DEBUG_FORCE_COLOR_CHANGER
 824+ EDC4 ~                    ; DEBUG: rotar entre RAYO/CARACOL/MUSHROOM al 33% para testar el color
 825+ EDC4 ~                    ; cycler. R XOR SYS_FRAMES da pseudo-random uniform 0..255, partido en
 826+ EDC4 ~                    ; 3 bandas de 85.3 c/u.
 827+ EDC4 ~                    LD A, R
 828+ EDC4 ~                    LD HL, $5C78
 829+ EDC4 ~                    XOR (HL)
 830+ EDC4 ~                    CP 85
 831+ EDC4 ~                    JP C, .urpDoRayo
 832+ EDC4 ~                    CP 170
 833+ EDC4 ~                    JP C, .urpDoCaracol
 834+ EDC4 ~                    JP .urpDoMushroom
 835+ EDC4                  ENDIF
 836+ EDC4                  IF DEBUG_FORCE_NEW_BUFFS
 837+ EDC4 ~                    ; DEBUG: rotar entre ESPADA/ESCUDO/ESCUDO_RAYO al 33% para testar
 838+ EDC4 ~                    ; fase 3 (buffs nuevos).
 839+ EDC4 ~                    LD A, R
 840+ EDC4 ~                    LD HL, $5C78
 841+ EDC4 ~                    XOR (HL)
 842+ EDC4 ~                    CP 85
 843+ EDC4 ~                    JP C, .urpDoEspada
 844+ EDC4 ~                    CP 170
 845+ EDC4 ~                    JP C, .urpDoEscudo
 846+ EDC4 ~                    JP .urpDoEscudoRayo
 847+ EDC4                  ENDIF
 848+ EDC4                  IF DEBUG_FORCE_REVERSE
 849+ EDC4 ~                    ; DEBUG: forzar siempre REVERSE para testar fase 4.
 850+ EDC4 ~                    JP .urpDoReverse
 851+ EDC4                  ENDIF
 852+ EDC4 ED 5F            LD A, R
 853+ EDC6 21 78 5C         LD HL, $5C78
 854+ EDC9 AE               XOR (HL)
 855+ EDCA                  ; Bands cumulativos. Orden de chequeo en codigo NO afecta las
 856+ EDCA                  ; probabilidades — solo importa los valores de PROB_*_END. Aqui van
 857+ EDCA                  ; agrupados por categoria (Recursos, Especiales, Buffs, Debuffs, Meta).
 858+ EDCA                  ; JP C (no JR C) por rango con cache hit dispatch.
 859+ EDCA                  ; --- Recursos ---
 860+ EDCA FE 14            CP PROB_HEALTH_END
 860+ EDCC DA 74 EE       JP C, .urpDoHealth
 861+ EDCF FE 28            CP PROB_STAMINA_END
 861+ EDD1 DA 82 EE       JP C, .urpDoStamina
 862+ EDD4                  ; --- Especiales ---
 863+ EDD4 FE 2C            CP PROB_LIFE_END
 863+ EDD6 DA 69 EE       JP C, .urpDoLife
