2343+ D805 C2 44 D9         JP NZ, .cbtSkipPtr
2344+ D808                  ; Pantalla actual: leer ptr
2345+ D808 E5               PUSH HL                         ; entry en ptr_lo
2346+ D809 5E               LD E, (HL)
2347+ D80A 23               INC HL
2348+ D80B 56               LD D, (HL)                      ; DE = ptr
2349+ D80C CD 48 D7         CALL LookupBumpTrigger          ; A = action, C = key
2350+ D80F B7               OR A
2351+ D810 CA 43 D9         JP Z, .cbtPopNext               ; no es bump-trigger
2352+ D813 32 5D D9         LD (.cbtAction), A              ; salvar action (B se reusa abajo)
2353+ D816 3A AE 82         LD A, (CurrentKey)
2354+ D819 B9               CP C
2355+ D81A C2 43 D9         JP NZ, .cbtPopNext              ; sin la key correcta
2356+ D81D                  ; Match: cargar sprite para conocer dimensiones y testear AABB.
2357+ D81D                  ; (action ya está en .cbtAction; BC libre para usar como dimensiones)
2358+ D81D EB               EX DE, HL                       ; HL = sprite ptr
2359+ D81E 3E 03            LD A, 3                         ; PickupTable ptrs viven en bank 3
2360+ D820 CD C2 6A         CALL LoadBgSpriteToBuffer
2361+ D823 21 F5 86         LD HL, BgSpriteBuffer
