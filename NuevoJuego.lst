 138  675C
 139  675C                  ; --- Rutinas de paginacion (paging.asm) ---
 140  675C                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 141  675C                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 142  675C                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 143  675C                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 144  675C                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 145  675C                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 146  675C                  ; criterio (siempre visible) pero contended.
 147  675C                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 148  675C                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 149  675C                  ; el inner loop, asi que el overhead es invisible.
 150  675C                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 675C              ; ==============================================================================
   2+ 675C              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 675C              ; ==============================================================================
   4+ 675C              ; Port $7FFD (write-only):
   5+ 675C              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 675C              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 675C              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 675C              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 675C              ;
  10+ 675C              ; Bancos disponibles:
  11+ 675C              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 675C              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 675C              ;   Bank 1: libre para datos nuevos (contended)
  14+ 675C              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 675C              ;   Bank 3: libre para datos nuevos (contended)
  16+ 675C              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 675C              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 675C              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 675C              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 675C              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 675C              ; ==============================================================================
  22+ 675C
  23+ 675C              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 675C              ; para no machacarse a si mismas al cambiar de banco.
  25+ 675C
  26+ 675C              ; ==============================================================================
  27+ 675C              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 675C              ; ==============================================================================
  29+ 675C              ; Entrada: A = banco (0-7)
  30+ 675C              ; Preserva: HL, DE, IX, IY
  31+ 675C              ; Destruye: A, BC
  32+ 675C              ; ==============================================================================
  33+ 675C              PageBankSlot3:
  34+ 675C E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 675E 47               LD B, A                     ; guardar banco nuevo
  36+ 675F 3A 8A 8D         LD A, (CurrentPaging)
  37+ 6762 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6764 B0               OR B                        ; poner nuevo banco
  39+ 6765 32 8A 8D         LD (CurrentPaging), A
  40+ 6768 01 FD 7F         LD BC, $7FFD
  41+ 676B ED 79            OUT (C), A
  42+ 676D C9               RET
  43+ 676E
  44+ 676E              ; ==============================================================================
  45+ 676E              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 676E              ; ==============================================================================
  47+ 676E              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 676E              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 676E              ; ==============================================================================
  50+ 676E              InitPaging:
  51+ 676E 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6770 32 8A 8D         LD (CurrentPaging), A
  53+ 6773 01 FD 7F         LD BC, $7FFD
  54+ 6776 ED 79            OUT (C), A
  55+ 6778 C9               RET
  56+ 6779
  57+ 6779              ; ==============================================================================
  58+ 6779              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6779              ; ==============================================================================
  60+ 6779              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6779              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6779              ;      Paginacion restaurada a bank 0.
  63+ 6779              ; Destruye: A, BC, DE, HL
  64+ 6779              ;
  65+ 6779              ; Formato del room en FUENTE (variable-length):
  66+ 6779              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6779              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6779              ;   terminador:                  DEFB $FF
  69+ 6779              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6779              ;
  71+ 6779              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6779              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6779              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6779              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6779              ; ==============================================================================
  76+ 6779              LoadRoomToBuffer:
  77+ 6779                  ; El stack normal vive en slot 3 ($FF58). Mientras paginamos slot 3 al
  78+ 6779                  ; bank de datos, el stack normal queda fisicamente "oculto" (pero intacto
  79+ 6779                  ; en bank 0). Si una IRQ entra durante el LDIR, su PUSH PC iria al bank
  80+ 6779                  ; de datos -> corrupcion del room data que estamos leyendo.
  81+ 6779                  ;
  82+ 6779                  ; Solucion: cambiar SP a un buffer alterno en slot 1 (siempre visible)
  83+ 6779                  ; durante la copia. Asi las IRQs siguen procesandose normalmente y el
  84+ 6779                  ; tick de musica no pierde frames durante DrawScreen / transiciones.
  85+ 6779                  ;
  86+ 6779                  ; INLINEAMOS el page-switch (sin CALL intermedios) porque al inicio el
  87+ 6779                  ; SP aun apunta al stack normal con la PC del CALL pushed; un CALL aqui
  88+ 6779                  ; usaria stack normal y no podriamos garantizar atomicidad.
  89+ 6779 ED 73 C7 67      LD (.lrbSavedSP), SP            ; salva SP normal (con PC + caller frame)
  90+ 677D 31 D5 68         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
  91+ 6780                  ; --- Page bank 1 en slot 3 (inline, SIN DI) ---
  92+ 6780 3A 8A 8D         LD A, (CurrentPaging)
  93+ 6783 E6 F8            AND $F8
  94+ 6785 F6 01            OR 1
  95+ 6787 32 8A 8D         LD (CurrentPaging), A
  96+ 678A 01 FD 7F         LD BC, $7FFD
  97+ 678D ED 79            OUT (C), A                      ; slot 3 = bank 1
  98+ 678F                  ; --- Copy + decompress loop ---
  99+ 678F                  ; HL = source (Room_Txx en bank 1, formato variable)
 100+ 678F                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
 101+ 678F 11 FD 85         LD DE, CurrentScreenBuffer
 102+ 6792              .lrbLoop:
 103+ 6792 7E               LD A, (HL)                      ; id
 104+ 6793 12               LD (DE), A
 105+ 6794 23               INC HL
