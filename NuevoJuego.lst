 458+ 90F6              ; ==============================================================================
 459+ 90F6              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 460+ 90F6              ; ==============================================================================
 461+ 90F6              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 462+ 90F6              ; Salida: HL = direccion en zona de atributos ($5800+)
 463+ 90F6              ; ==============================================================================
 464+ 90F6              CalcAttrAddr:
 465+ 90F6 7A               LD A, D
 466+ 90F7 0F               RRCA
 467+ 90F8 0F               RRCA
 468+ 90F9 0F               RRCA
 469+ 90FA E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 470+ 90FC 6F               LD L, A
 471+ 90FD 26 00            LD H, 0
 472+ 90FF 29               ADD HL, HL
 473+ 9100 29               ADD HL, HL
 474+ 9101 29               ADD HL, HL
 475+ 9102 29               ADD HL, HL
 476+ 9103 29               ADD HL, HL                  ; HL = fila * 32
 477+ 9104 7B               LD A, E
 478+ 9105 0F               RRCA
 479+ 9106 0F               RRCA
 480+ 9107 0F               RRCA
 481+ 9108 E6 1F            AND $1F                     ; X / 8 = columna
 482+ 910A B5               OR L
 483+ 910B 6F               LD L, A
 484+ 910C 01 00 58         LD BC, ATTR_BASE
 485+ 910F 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 486+ 9110 C9               RET
 487+ 9111
 488+ 9111              ; ==============================================================================
 489+ 9111              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 490+ 9111              ; ==============================================================================
 491+ 9111              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 492+ 9111              ; Salida: HL=direccion en VRAM
 493+ 9111              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 494+ 9111              ; ==============================================================================
 495+ 9111              CalcPixelAddr:
 496+ 9111 7A               LD A, D
 497+ 9112 E6 C0            AND $C0                     ; Y7 Y6
 498+ 9114 1F               RRA
 499+ 9115 1F               RRA
 500+ 9116 1F               RRA                         ; >> 3
 501+ 9117 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 502+ 9119 67               LD H, A
 503+ 911A
 504+ 911A 7A               LD A, D
 505+ 911B E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 506+ 911D B4               OR H
 507+ 911E 67               LD H, A
 508+ 911F
 509+ 911F 7A               LD A, D
 510+ 9120 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 511+ 9122 87               ADD A, A
 512+ 9123 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 513+ 9124 6F               LD L, A
 514+ 9125
 515+ 9125 7B               LD A, E
 516+ 9126 1F               RRA
 517+ 9127 1F               RRA
 518+ 9128 1F               RRA
 519+ 9129 E6 1F            AND $1F                     ; X / 8 = columna
 520+ 912B B5               OR L
 521+ 912C 6F               LD L, A
 522+ 912D C9               RET
