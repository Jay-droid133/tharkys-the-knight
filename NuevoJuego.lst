# file opened: code/random_pickups.asm
   1+ 6E3A              ; ==============================================================================
   2+ 6E3A              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 6E3A              ; ==============================================================================
   4+ 6E3A              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 6E3A              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 6E3A              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 6E3A              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 6E3A              ; correspondiente desde CheckPickupCollect.
   9+ 6E3A              ;
  10+ 6E3A              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 6E3A              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 6E3A              ;
  13+ 6E3A              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 6E3A              ; Bank 0/2 quedan limpios.
  15+ 6E3A              ; ==============================================================================
  16+ 6E3A
  17+ 6E3A              ; ==============================================================================
  18+ 6E3A              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 6E3A              ; ==============================================================================
  20+ 6E3A              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 6E3A              ; el cambio via cache .dlhLast.
  22+ 6E3A              ; ==============================================================================
  23+ 6E3A              GiveLife:
  24+ 6E3A 3A DE 82         LD A, (PlayerLives)
  25+ 6E3D FE 05            CP PLAYER_LIVES_MAX
  26+ 6E3F D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 6E40 3C               INC A
  28+ 6E41 32 DE 82         LD (PlayerLives), A
  29+ 6E44 C9               RET
  30+ 6E45
  31+ 6E45              ; ==============================================================================
  32+ 6E45              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 6E45              ; ==============================================================================
  34+ 6E45              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 6E45              ; ==============================================================================
  36+ 6E45              GiveHealth:
  37+ 6E45 3A F2 B5         LD A, (PlayerHealth)
  38+ 6E48 C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 6E4A 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 6E4C FE 11            CP HEALTH_MAX + 1
  41+ 6E4E 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 6E50              .ghCap:
  43+ 6E50 3E 10            LD A, HEALTH_MAX
  44+ 6E52              .ghStore:
  45+ 6E52 32 F2 B5         LD (PlayerHealth), A
  46+ 6E55 C9               RET
  47+ 6E56
  48+ 6E56              ; ==============================================================================
  49+ 6E56              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ 6E56              ; ==============================================================================
  51+ 6E56              GiveStamina:
