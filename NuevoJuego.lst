1203+ EE45              ; ==============================================================================
1204+ EE45              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1205+ EE45              ; ==============================================================================
1206+ EE45              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1207+ EE45              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1208+ EE45              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1209+ EE45              ; ==============================================================================
1210+ EE45              ChurchCutsceneInitStatueShake:
1211+ EE45 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1212+ EE48 21 07 67         LD HL, StatueIdTable
1213+ EE4B 5F               LD E, A
1214+ EE4C 16 00            LD D, 0
1215+ EE4E 19               ADD HL, DE
1216+ EE4F 7E               LD A, (HL)                              ; A = statue id
1217+ EE50 B7               OR A
1218+ EE51 C8               RET Z                                   ; sin estatua
1219+ EE52 32 82 EE         LD (.cisTargetId), A
1220+ EE55                  ; Buscar en CurrentScreenBuffer
1221+ EE55 2A 0A 82         LD HL, (CurrentScreenAddr)
1222+ EE58              .cisLoop:
1223+ EE58 7E               LD A, (HL)
1224+ EE59 FE FF            CP $FF
1225+ EE5B C8               RET Z                                   ; no encontrada (no se hace shake)
1226+ EE5C 47               LD B, A
1227+ EE5D 3A 82 EE         LD A, (.cisTargetId)
1228+ EE60 B8               CP B
1229+ EE61 28 06            JR Z, .cisFound
1230+ EE63 11 04 00         LD DE, 4
1231+ EE66 19               ADD HL, DE
1232+ EE67 18 EF            JR .cisLoop
1233+ EE69              .cisFound:
1234+ EE69 23               INC HL
1235+ EE6A 7E               LD A, (HL)                              ; charX
1236+ EE6B                  ; Pixel X = charX * 8
1237+ EE6B 87               ADD A, A
1238+ EE6C 87               ADD A, A
1239+ EE6D 87               ADD A, A
1240+ EE6E 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1241+ EE71 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1242+ EE74 23               INC HL
1243+ EE75 7E               LD A, (HL)                              ; charY
1244+ EE76                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1245+ EE76 C6 02            ADD A, BG_Y_OFFSET
1246+ EE78 87               ADD A, A
1247+ EE79 87               ADD A, A
1248+ EE7A 87               ADD A, A
1249+ EE7B 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1250+ EE7E 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1251+ EE81 C9               RET
1252+ EE82 00           .cisTargetId: DEFB 0
