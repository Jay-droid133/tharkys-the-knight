 770+ D194              ; ==============================================================================
 771+ D194              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 772+ D194              ; ==============================================================================
 773+ D194              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 774+ D194              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 775+ D194              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 776+ D194              ; ==============================================================================
 777+ D194              DrawBgGfxSprite:
 778+ D194 DD 7E 00         LD A, (IX+0)                ; height_px
