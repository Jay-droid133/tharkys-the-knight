 841+ E1EC              ; REMAP TABLES - Standard (sprites normales)
 842+ E1EC              ; ==============================================================================
 843+ E1EC              ; 16 entradas: indice = bright*8 + color_paper
 844+ E1EC              ; Valor = new_bright*8 + new_color_paper
 845+ E1EC              ;
 846+ E1EC              ; Colores: 0=B 1=Bl 2=R 3=M 4=G 5=C 6=Y 7=W
 847+ E1EC              ; Indice 0-7 = dim, 8-15 = bright
