4816+ BCF2                  ; Leer delay de animacion para este ciclo
4817+ BCF2 F1               POP AF                              ; A = indice 0-based
4818+ BCF3 21 09 BD         LD HL, EnemyAnimDelayTable
4819+ BCF6 5F               LD E, A
4820+ BCF7 16 00            LD D, 0
4821+ BCF9 19               ADD HL, DE
4822+ BCFA 7E               LD A, (HL)
4823+ BCFB 32 A8 90         LD (CurrentEnemyAnimDelay), A
4824+ BCFE C9               RET
