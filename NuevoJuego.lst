2847+ DB0D B7               OR A
2848+ DB0E 20 35            JR NZ, .dkhDraw
2849+ DB10
2850+ DB10                  ; Limpiar pixeles fila 0 (third 0, scans 0-7 = H $40..$47)
2851+ DB10 21 14 40         LD HL, $4014                ; row 0 col 20 scan 0
2852+ DB13 06 08            LD B, 8
2853+ DB15              .dkhClr0:
2854+ DB15 AF               XOR A
2855+ DB16 77               LD (HL), A
2856+ DB17 23               INC HL
2857+ DB18 77               LD (HL), A
2858+ DB19 23               INC HL
2859+ DB1A 77               LD (HL), A
2860+ DB1B 2B               DEC HL
2861+ DB1C 2B               DEC HL
2862+ DB1D 24               INC H
2863+ DB1E 10 F5            DJNZ .dkhClr0
2864+ DB20                  ; Limpiar pixeles fila 1
2865+ DB20 21 34 40         LD HL, $4034                ; row 1 col 20 scan 0
2866+ DB23 06 08            LD B, 8
2867+ DB25              .dkhClr1:
2868+ DB25 AF               XOR A
2869+ DB26 77               LD (HL), A
2870+ DB27 23               INC HL
2871+ DB28 77               LD (HL), A
2872+ DB29 23               INC HL
2873+ DB2A 77               LD (HL), A
2874+ DB2B 2B               DEC HL
2875+ DB2C 2B               DEC HL
2876+ DB2D 24               INC H
2877+ DB2E 10 F5            DJNZ .dkhClr1
2878+ DB30                  ; Limpiar attrs (row 0-1, cols 20-22)
2879+ DB30 3E 47            LD A, $47                   ; bright white on black
2880+ DB32 32 14 58         LD ($5814), A
2881+ DB35 32 15 58         LD ($5815), A
2882+ DB38 32 16 58         LD ($5816), A
2883+ DB3B 32 34 58         LD ($5834), A
2884+ DB3E 32 35 58         LD ($5835), A
2885+ DB41 32 36 58         LD ($5836), A
2886+ DB44 C9               RET
