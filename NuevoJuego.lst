  91+ 0000              ; ==============================================================================
  92+ 0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
  93+ 0000              ; ==============================================================================
  94+ 0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
  95+ 0000              ; Acceso via IX + ENT_* offset.
  96+ 0000              ; ==============================================================================
  97+ 0000
  98+ 0000              ; --- Offsets en la estructura de entidad (16 bytes) ---
  99+ 0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
 100+ 0000              ENT_TYPE        EQU 1               ; Tipo de entidad
 101+ 0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
 102+ 0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
 103+ 0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
 104+ 0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
 105+ 0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
 106+ 0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
 107+ 0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
 108+ 0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
 109+ 0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
 110+ 0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
 111+ 0000              ENT_OLDX        EQU 12              ; X del frame anterior (para XOR erase)
 112+ 0000              ENT_OLDY        EQU 13              ; Y del frame anterior (para XOR erase)
 113+ 0000              ENT_OLDSPRID    EQU 14              ; SpriteID del frame anterior
 114+ 0000              ENT_DRAWX       EQU 15              ; X de dibujo (ajustado para attack offset)
 115+ 0000
 116+ 0000              ENT_SIZE        EQU 16              ; Bytes por entidad
 117+ 0000              NUM_ENTITIES    EQU 17              ; Total de slots
 118+ 0000
 119+ 0000              ; --- Tipos de entidad ---
 120+ 0000              TYPE_NONE       EQU 0               ; Slot inactivo
 121+ 0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 122+ 0000              TYPE_MONSTER   EQU 2               ; Monstruo permanente (rhino, wolf, etc.)
 123+ 0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 124+ 0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
 125+ 0000
 126+ 0000              ; --- Flags de entidad (ENT_FLAGS) ---
 127+ 0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
 128+ 0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
 129+ 0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
 130+ 0000              ENTF_NEWSPAWN   EQU 3               ; bit 3: recien creada (usar freshDraw, no erase)
 131+ 0000
 132+ 0000              ; --- Rangos de slots ---
 133+ 0000              SLOT_PLAYER     EQU 0               ; Slot 0: player
 134+ 0000              SLOT_MONSTER0  EQU 1               ; Slots 1-6: monstruos
 135+ 0000              NUM_MONSTERS   EQU 6
 136+ 0000              SLOT_NASTY0     EQU 7               ; Slots 7-9: nasties (spawn)
 137+ 0000              NUM_NASTIES     EQU 3
 138+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 139+ 0000              NUM_OBJECTS     EQU 4
 140+ 0000
 141+ 0000              ; --- Velocidades de enemigos ---
 142+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 143+ 0000              MONSTER_SPEED    EQU 1               ; Pixels por update (lento, inexorable)
 144+ 0000              MONSTER_MAX_HITS EQU 5              ; Golpes directos para matar un monster
 145+ 0000              MONSTER_KB_SPEED EQU 4              ; Pixels por update durante knockback
 146+ 0000              MONSTER_RESPAWN_DELAY EQU 75        ; 75 frames a 25fps = 3s (era 150 a 50fps)
 147+ 0000              MONSTER_STUN_TOTAL EQU 12           ; 12 frames a 25fps ~0.5s (era 24 a 50fps)
 148+ 0000              MONSTER_STUN_PAUSE EQU 6            ; 6 frames a 25fps (era 12 a 50fps)
 149+ 0000              ENEMY_ANIM_DELAY EQU 4              ; 4 frames a 25fps = 160ms (era 8 a 50fps)
 150+ 0000              ; PREDATOR_SPEED: se lee de PredatorSpeedTable segun DayCycleCount
 151+ 0000              ; Tipos de depredador (bits 0-1 de PredatorTable)
 152+ 0000              PRED_NONE       EQU 0               ; No depredador (movimiento random)
 153+ 0000              PRED_FROM_ABOVE EQU 1               ; Se lanza desde arriba (Eagle, Bat)
 154+ 0000              PRED_FROM_BELOW EQU 2               ; Se lanza desde abajo (Snake, Scorpion)
 155+ 0000              PRED_HORIZONTAL EQU 3               ; Se lanza horizontalmente (Goat, RabidCat)
 156+ 0000              PRED_ALIGN_DIST EQU 12              ; Distancia de alineacion para activar ataque
 157+ 0000              PREDATOR_COOLDOWN EQU 25            ; 25 frames a 25fps = 1s (era 50 a 50fps)
 158+ 0000
 159+ 0000              ; --- Stamina / Salud ---
 160+ 0000              STAMINA_MAX         EQU 16          ; Nivel maximo (= 16 scanlines del HUD)
 161+ 0000              HEALTH_MAX          EQU 16
 162+ 0000              STAMINA_DRAIN_RATE  EQU 13          ; 13 frames a 25fps ~0.5s (era 25 a 50fps)
 163+ 0000              STAMINA_REGEN_RATE  EQU 25          ; 25 frames a 25fps = 1s (era 50 a 50fps)
 164+ 0000              HEALTH_REGEN_RATE   EQU 50          ; 50 frames a 25fps = 2s (era 100 a 50fps)
 165+ 0000              STAMINA_THRESHOLD_HIGH EQU 12       ; >= libre (continuo)
 166+ 0000              STAMINA_THRESHOLD_MID  EQU 7        ; >= fixed swing
 167+ 0000              STAMINA_THRESHOLD_LOW  EQU 3        ; >= cooldown corto
 168+ 0000              ; < LOW = cooldown largo + 1 punto recuperado tras cada cooldown
 169+ 0000              ATTACK_COOLDOWN_FRAMES EQU 10       ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
 170+ 0000              ATTACK_SWING_FRAMES EQU ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT ; Opcion C: = 1 ciclo de animacion
 171+ 0000              SCARE_FLEE_THRESHOLD EQU 50          ; 50 a 25fps (era 100 a 50fps)
 172+ 0000              SCARE_TIMER_BELLS EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 173+ 0000              SCARE_TIMER_DAWN  EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 174+ 0000              FLEE_PLAYER_AVOID EQU 12            ; Pixeles de proximidad para evitar al player al huir
 175+ 0000              NEAR_ENTRY_DIST EQU 30              ; Distancia minima monster-entrada al restaurar room
 176+ 0000
 177+ 0000              ; --- Spawn system ---
 178+ 0000              SPAWN_INTERVAL  EQU 25              ; 25 frames a 25fps = 1s (era 50 a 50fps)
 179+ 0000
 180+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 181+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 182+ 0000
 183+ 0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 184+ 0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 185+ 0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 186+ 0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 187+ 0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 188+ 0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 189+ 0000
 190+ 0000              ; ==============================================================================
 191+ 0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 192+ 0000              ; ==============================================================================
 193+ 0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 194+ 0000              ; Cada pantalla es una vista fija (flick-screen).
 195+ 0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 196+ 0000              ;
 197+ 0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 198+ 0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 199+ 0000              ; (Las 2 filas superiores = HUD/panel de estado; area de juego filas 2-23)
 200+ 0000              ; ==============================================================================
 201+ 0000
 202+ 0000              ; --- Dimensiones del mapa ---
 203+ 0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 204+ 0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 205+ 0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 206+ 0000
 207+ 0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 208+ 0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 209+ 0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 210+ 0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 211+ 0000
 212+ 0000              ; --- Dimensiones del area de juego (en pixeles) ---
 213+ 0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
 214+ 0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
 215+ 0000              HUD_Y_START     EQU 0               ; Pixel Y donde empieza el HUD (filas 0-1, superior)
 216+ 0000
 217+ 0000              ; --- Tipos de tile ---
 218+ 0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
 219+ 0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
 220+ 0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
 221+ 0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
 222+ 0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
 223+ 0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
 224+ 0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
 225+ 0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
 226+ 0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
 227+ 0000              TILE_PATH_H     EQU 8               ; Camino horizontal
 228+ 0000              TILE_PATH_V     EQU 9               ; Camino vertical
 229+ 0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
 230+ 0000
 231+ 0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
 232+ 0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
 233+ 0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
 234+ 0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
 235+ 0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
 236+ 0000
 237+ 0000              ; --- Posicion inicial del jugador: definida en screen_data.asm (level editor) ---
 238+ 0000
 239+ 0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
 240+ 0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
 241+ 0000
