 254+ EB72
 255+ EB72              ; ==============================================================================
 256+ EB72              ; UpdatePlayerColorCyclerBody - cycler de color player segun buffs activos
 257+ EB72              ; ==============================================================================
 258+ EB72              ; Llamado desde MainLoop cada frame via thunk slot 1 (UpdatePlayerColorCycler).
 259+ EB72              ; Lee timers de buffs/debuffs activos (16-bit cada uno), cuenta cuantos hay,
 260+ EB72              ; cycla entre sus colores cada COLOR_CYCLER_PERIOD frames.
 261+ EB72              ;
 262+ EB72              ; Prioridades (en orden):
 263+ EB72              ;   1. PlayerHitTimer > 0  -> no tocar color (RED damage flash gana)
 264+ EB72              ;   2. >=1 buff activo     -> cyclar entre sus colores
 265+ EB72              ;   3. AttackCooldown > 0  -> no tocar color (BLUE sword cooldown persiste)
 266+ EB72              ;   4. Default             -> escribir WHITE | $40
 267+ EB72              ;
 268+ EB72              ; Orden fijo en el ciclo (afecta cual se ve primero): SpeedBuff (RAYO/CARACOL)
 269+ EB72              ; primero, luego MushroomBuff (SETA). Fase 3/4 anadira ESPADA / ESCUDO / REVERSE.
 270+ EB72              ;
 271+ EB72              ; Destruye: AF, BC, DE, HL.
 272+ EB72              ; ==============================================================================
 273+ EB72              UpdatePlayerColorCyclerBody:
 274+ EB72                  ; NOTA: el check de PlayerHitTimer vive en el thunk slot 1, NO aqui.
 275+ EB72                  ; PlayerHitTimer esta en bank 0 (slot 3) y desde bank 7 body slot 3 = bank 7
 276+ EB72                  ; -> lectura corrupta. El thunk gates el call antes de paginar.
 277+ EB72
 278+ EB72                  ; --- Pass 1: contar timers activos ---
 279+ EB72 06 00            LD B, 0                                 ; B = count
 280+ EB74 3A D9 82         LD A, (SpeedBuffTimer)
 281+ EB77 4F               LD C, A
 282+ EB78 3A DA 82         LD A, (SpeedBuffTimer+1)
 283+ EB7B B1               OR C
 284+ EB7C 28 01            JR Z, .upcc_noSpeed
 285+ EB7E 04               INC B
 286+ EB7F              .upcc_noSpeed:
 287+ EB7F 3A DC 82         LD A, (MushroomLockTimer)
 288+ EB82 4F               LD C, A
 289+ EB83 3A DD 82         LD A, (MushroomLockTimer+1)
 290+ EB86 B1               OR C
 291+ EB87 28 01            JR Z, .upcc_noMush
 292+ EB89 04               INC B
 293+ EB8A              .upcc_noMush:
 294+ EB8A 3A DA 5F         LD A, (EspadaTimer)
 295+ EB8D 4F               LD C, A
 296+ EB8E 3A DB 5F         LD A, (EspadaTimer+1)
 297+ EB91 B1               OR C
 298+ EB92 28 01            JR Z, .upcc_noEspada
 299+ EB94 04               INC B
 300+ EB95              .upcc_noEspada:
 301+ EB95 3A DC 5F         LD A, (EscudoTimer)
 302+ EB98 4F               LD C, A
 303+ EB99 3A DD 5F         LD A, (EscudoTimer+1)
 304+ EB9C B1               OR C
 305+ EB9D 28 01            JR Z, .upcc_noEscudo
 306+ EB9F 04               INC B
 307+ EBA0              .upcc_noEscudo:
 308+ EBA0                  ; [Fase 4: anadir ReverseTimer aqui]
 309+ EBA0
 310+ EBA0 78               LD A, B
 311+ EBA1 B7               OR A
 312+ EBA2 20 0B            JR NZ, .upcc_haveBuffs
 313+ EBA4
 314+ EBA4                  ; --- Sin buffs. Prioridad 3: respect BLUE sword cooldown ---
 315+ EBA4 3A 6E B3         LD A, (AttackCooldown)
 316+ EBA7 B7               OR A
 317+ EBA8 C0               RET NZ                                  ; cooldown activo, BLUE persiste
 318+ EBA9
 319+ EBA9                  ; --- Default: WHITE | $40 ---
 320+ EBA9 3E 47            LD A, WHITE | $40
 321+ EBAB 32 A2 81         LD (EntityTable + ENT_ATTR), A
 322+ EBAE C9               RET
 323+ EBAF
 324+ EBAF              .upcc_haveBuffs:
 325+ EBAF                  ; --- Increment frame counter (wrap natural a 256) ---
 326+ EBAF 21 D9 5F         LD HL, PlayerColorCyclerFrame
 327+ EBB2 34               INC (HL)
 328+ EBB3
 329+ EBB3                  ; --- Slot = (frame / COLOR_CYCLER_PERIOD) mod B ---
 330+ EBB3 7E               LD A, (HL)
 331+ EBB4 16 00            LD D, 0                                 ; D = quotient (frame / PERIOD)
 332+ EBB6              .upcc_divLoop:
 333+ EBB6 D6 0C            SUB COLOR_CYCLER_PERIOD
 334+ EBB8 38 03            JR C, .upcc_divDone
 335+ EBBA 14               INC D
 336+ EBBB 18 F9            JR .upcc_divLoop
 337+ EBBD              .upcc_divDone:
 338+ EBBD                  ; D = floor(frame / PERIOD). Mod B:
 339+ EBBD 7A               LD A, D
 340+ EBBE              .upcc_modLoop:
 341+ EBBE 90               SUB B
 342+ EBBF 30 FD            JR NC, .upcc_modLoop
 343+ EBC1 80               ADD A, B                                ; A = slot (0..B-1)
 344+ EBC2 57               LD D, A                                 ; D = target slot
 345+ EBC3
 346+ EBC3                  ; --- Pass 2: iterar buffs en orden fijo, aplicar color del slot-th ---
 347+ EBC3 0E 00            LD C, 0                                 ; running count
 348+ EBC5
 349+ EBC5                  ; SpeedBuff (RAYO o CARACOL)
 350+ EBC5 3A D9 82         LD A, (SpeedBuffTimer)
 351+ EBC8 5F               LD E, A
 352+ EBC9 3A DA 82         LD A, (SpeedBuffTimer+1)
 353+ EBCC B3               OR E
 354+ EBCD 28 05            JR Z, .upcc_skipSpeed
 355+ EBCF 7A               LD A, D
 356+ EBD0 B9               CP C
 357+ EBD1 28 37            JR Z, .upcc_applySpeed
 358+ EBD3 0C               INC C
 359+ EBD4              .upcc_skipSpeed:
 360+ EBD4
 361+ EBD4                  ; MushroomBuff (SETA)
 362+ EBD4 3A DC 82         LD A, (MushroomLockTimer)
 363+ EBD7 5F               LD E, A
 364+ EBD8 3A DD 82         LD A, (MushroomLockTimer+1)
 365+ EBDB B3               OR E
 366+ EBDC 28 05            JR Z, .upcc_skipMush
 367+ EBDE 7A               LD A, D
 368+ EBDF B9               CP C
 369+ EBE0 28 35            JR Z, .upcc_applyMush
 370+ EBE2 0C               INC C
 371+ EBE3              .upcc_skipMush:
 372+ EBE3
 373+ EBE3                  ; Espada
 374+ EBE3 3A DA 5F         LD A, (EspadaTimer)
 375+ EBE6 5F               LD E, A
 376+ EBE7 3A DB 5F         LD A, (EspadaTimer+1)
 377+ EBEA B3               OR E
 378+ EBEB 28 05            JR Z, .upcc_skipEspada
 379+ EBED 7A               LD A, D
 380+ EBEE B9               CP C
 381+ EBEF 28 11            JR Z, .upcc_applyEspada
 382+ EBF1 0C               INC C
 383+ EBF2              .upcc_skipEspada:
 384+ EBF2
 385+ EBF2                  ; Escudo
 386+ EBF2 3A DC 5F         LD A, (EscudoTimer)
 387+ EBF5 5F               LD E, A
 388+ EBF6 3A DD 5F         LD A, (EscudoTimer+1)
 389+ EBF9 B3               OR E
 390+ EBFA 28 05            JR Z, .upcc_skipEscudo
 391+ EBFC 7A               LD A, D
 392+ EBFD B9               CP C
 393+ EBFE 28 06            JR Z, .upcc_applyEscudo
 394+ EC00 0C               INC C
 395+ EC01              .upcc_skipEscudo:
 396+ EC01
 397+ EC01                  ; [Fase 4: anadir branch para REVERSE aqui]
 398+ EC01
 399+ EC01 C9               RET                                     ; unreachable si pass 1 fue correcto
