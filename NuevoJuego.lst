 343  CF45                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CF45              ; ==============================================================================
   2+ CF45              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CF45              ; ==============================================================================
   4+ CF45              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CF45              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CF45              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CF45              ; ==============================================================================
   8+ CF45
   9+ CF45              ; ==============================================================================
  10+ CF45              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CF45              ; ==============================================================================
  12+ CF45              InitScreenSystem:
  13+ CF45 3E 07            LD A, START_SCREEN_X
  14+ CF47 32 9A 82         LD (CurrentScreenX), A
  15+ CF4A 3E 0E            LD A, START_SCREEN_Y
  16+ CF4C 32 9B 82         LD (CurrentScreenY), A
  17+ CF4F 3E 01            LD A, 1
  18+ CF51 32 A2 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CF54 AF               XOR A
  20+ CF55 32 9E 82         LD (ScreenTransition), A
  21+ CF58 CD 5C CF         CALL CalcScreenAddress
  22+ CF5B C9               RET
  23+ CF5C
  24+ CF5C              ; ==============================================================================
  25+ CF5C              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CF5C              ; ==============================================================================
  27+ CF5C              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CF5C              ; ==============================================================================
  29+ CF5C              CalcScreenAddress:
  30+ CF5C 3A 9B 82         LD A, (CurrentScreenY)
  31+ CF5F 6F               LD L, A
  32+ CF60 26 00            LD H, 0
  33+ CF62 29               ADD HL, HL                  ; x2
  34+ CF63 29               ADD HL, HL                  ; x4
  35+ CF64 29               ADD HL, HL                  ; x8
  36+ CF65 29               ADD HL, HL                  ; x16
  37+ CF66 3A 9A 82         LD A, (CurrentScreenX)
  38+ CF69 5F               LD E, A
  39+ CF6A 16 00            LD D, 0
  40+ CF6C 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CF6D 11 C0 DF         LD DE, MapTable
  42+ CF70 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CF71 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CF72                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CF72 6F               LD L, A
  46+ CF73 26 00            LD H, 0
  47+ CF75 29               ADD HL, HL                  ; index * 2
  48+ CF76 11 8E DE         LD DE, RoomTable
  49+ CF79 19               ADD HL, DE
  50+ CF7A 5E               LD E, (HL)
  51+ CF7B 23               INC HL
  52+ CF7C 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CF7D                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CF7D EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CF7E CD 2A 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CF81                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CF81 11 87 85         LD DE, CurrentScreenBuffer
  58+ CF84 ED 53 9C 82      LD (CurrentScreenAddr), DE
  59+ CF88 C9               RET
  60+ CF89
  61+ CF89              ; ==============================================================================
  62+ CF89              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CF89              ; ==============================================================================
  64+ CF89              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CF89              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CF89              ; por estar atrapado cerca del borde.
  67+ CF89              ; ==============================================================================
  68+ CF89              CheckScreenTransition:
  69+ CF89 AF               XOR A
  70+ CF8A 32 9E 82         LD (ScreenTransition), A
  71+ CF8D
  72+ CF8D                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CF8D                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CF8D                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CF8D                  ; dispararia transicion sur en plena animacion.
  76+ CF8D 3A 68 82         LD A, (TownGatePhase)
  77+ CF90 B7               OR A
  78+ CF91 C0               RET NZ
  79+ CF92
  80+ CF92                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CF92                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CF92                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CF92                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CF92                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CF92                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CF92 3A 57 82         LD A, (TimeFrozen)
  87+ CF95 B7               OR A
  88+ CF96 28 23            JR Z, .cstNotFrozen
  89+ CF98 3A 4F 82         LD A, (InputDirection)
  90+ CF9B CB 4F            BIT 1, A                    ; S
  91+ CF9D 28 17            JR Z, .cstClearBlockFlag
  92+ CF9F 3A 43 81         LD A, (EntityTable + ENT_POSY)
  93+ CFA2 FE A8            CP SCREEN_MAX_Y
  94+ CFA4 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CFA6                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CFA6 3A 58 82         LD A, (BlockedExitSoundFlag)
  97+ CFA9 B7               OR A
  98+ CFAA C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CFAB 3E 01            LD A, 1
 100+ CFAD 32 58 82         LD (BlockedExitSoundFlag), A
 101+ CFB0 21 6A F9         LD HL, SFX_BlockedExit
 102+ CFB3 C3 46 F8         JP PlaySFX                  ; tail call
 103+ CFB6              .cstClearBlockFlag:
 104+ CFB6 AF               XOR A
 105+ CFB7 32 58 82         LD (BlockedExitSoundFlag), A
 106+ CFBA C9               RET
 107+ CFBB              .cstNotFrozen:
 108+ CFBB                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CFBB AF               XOR A
 110+ CFBC 32 58 82         LD (BlockedExitSoundFlag), A
 111+ CFBF
 112+ CFBF 3A 4F 82         LD A, (InputDirection)
 113+ CFC2 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CFC3
 115+ CFC3                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CFC3 CB 5A            BIT 3, D                    ; W
 117+ CFC5 CA 13 D0         JP Z, .noWest
 118+ CFC8 3A 42 81         LD A, (EntityTable + ENT_POSX)
 119+ CFCB FE 04            CP TRANSITION_ZONE
 120+ CFCD D2 13 D0         JP NC, .noWest
 121+ CFD0 3A 9A 82         LD A, (CurrentScreenX)
 122+ CFD3 B7               OR A
 123+ CFD4 CA 13 D0         JP Z, .noWest
 124+ CFD7                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CFD7 06 00            LD B, 0
 126+ CFD9 3A 43 81         LD A, (EntityTable + ENT_POSY)
 127+ CFDC 4F               LD C, A
 128+ CFDD CD B5 D7         CALL IsPointBlocked
 129+ CFE0 C2 13 D0         JP NZ, .noWest
 130+ CFE3 06 00            LD B, 0
 131+ CFE5 3A 43 81         LD A, (EntityTable + ENT_POSY)
 132+ CFE8 C6 0A            ADD A, 10
 133+ CFEA 4F               LD C, A
 134+ CFEB CD B5 D7         CALL IsPointBlocked
 135+ CFEE C2 13 D0         JP NZ, .noWest
 136+ CFF1 06 00            LD B, 0
 137+ CFF3 3A 43 81         LD A, (EntityTable + ENT_POSY)
 138+ CFF6 C6 14            ADD A, 20
 139+ CFF8 4F               LD C, A
 140+ CFF9 CD B5 D7         CALL IsPointBlocked
 141+ CFFC C2 13 D0         JP NZ, .noWest
 142+ CFFF 3A 9A 82         LD A, (CurrentScreenX)
 143+ D002 3D               DEC A
 144+ D003 32 9A 82         LD (CurrentScreenX), A
 145+ D006 3E 08            LD A, DIR_W
 146+ D008 32 9E 82         LD (ScreenTransition), A
 147+ D00B 3E E8            LD A, SCREEN_MAX_X
 148+ D00D 32 42 81         LD (EntityTable + ENT_POSX), A
 149+ D010 C3 05 D1         JP .doTransition
 150+ D013
 151+ D013              .noWest:
 152+ D013                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 153+ D013 CB 52            BIT 2, D                    ; E
 154+ D015 CA 64 D0         JP Z, .noEast
 155+ D018 3A 42 81         LD A, (EntityTable + ENT_POSX)
 156+ D01B FE E8            CP SCREEN_MAX_X
 157+ D01D DA 64 D0         JP C, .noEast
 158+ D020 3A 9A 82         LD A, (CurrentScreenX)
 159+ D023 FE 0F            CP MAP_WIDTH - 1
 160+ D025 CA 64 D0         JP Z, .noEast
 161+ D028                  ; Check collision at col 31 (top + mid + bottom del player)
 162+ D028 06 F8            LD B, 248
 163+ D02A 3A 43 81         LD A, (EntityTable + ENT_POSY)
 164+ D02D 4F               LD C, A
 165+ D02E CD B5 D7         CALL IsPointBlocked
 166+ D031 C2 64 D0         JP NZ, .noEast
 167+ D034 06 F8            LD B, 248
 168+ D036 3A 43 81         LD A, (EntityTable + ENT_POSY)
 169+ D039 C6 0A            ADD A, 10
 170+ D03B 4F               LD C, A
 171+ D03C CD B5 D7         CALL IsPointBlocked
 172+ D03F C2 64 D0         JP NZ, .noEast
 173+ D042 06 F8            LD B, 248
 174+ D044 3A 43 81         LD A, (EntityTable + ENT_POSY)
 175+ D047 C6 14            ADD A, 20
 176+ D049 4F               LD C, A
 177+ D04A CD B5 D7         CALL IsPointBlocked
 178+ D04D C2 64 D0         JP NZ, .noEast
 179+ D050 3A 9A 82         LD A, (CurrentScreenX)
 180+ D053 3C               INC A
 181+ D054 32 9A 82         LD (CurrentScreenX), A
 182+ D057 3E 04            LD A, DIR_E
 183+ D059 32 9E 82         LD (ScreenTransition), A
 184+ D05C 3E 00            LD A, SCREEN_MIN_X
 185+ D05E 32 42 81         LD (EntityTable + ENT_POSX), A
 186+ D061 C3 05 D1         JP .doTransition
 187+ D064
 188+ D064              .noEast:
 189+ D064                  ; --- Comprobar borde NORTE (solo si pulsa N) ---
 190+ D064 CB 42            BIT 0, D                    ; N
 191+ D066 CA B4 D0         JP Z, .noNorth
 192+ D069 3A 43 81         LD A, (EntityTable + ENT_POSY)
 193+ D06C FE 14            CP SCREEN_MIN_Y + TRANSITION_ZONE
 194+ D06E D2 B4 D0         JP NC, .noNorth
 195+ D071 3A 9B 82         LD A, (CurrentScreenY)
 196+ D074 B7               OR A
 197+ D075 CA B4 D0         JP Z, .noNorth
 198+ D078                  ; Check collision at row 0 (left + mid + right del player)
 199+ D078 3A 42 81         LD A, (EntityTable + ENT_POSX)
 200+ D07B 47               LD B, A
 201+ D07C 0E 10            LD C, SCREEN_MIN_Y
