 167+ F1BF 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 168+ F1C3 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 169+ F1C7 00               DEFB 0                      ; fin
