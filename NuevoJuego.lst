  81+ 8482
  82+ 8482                  ; ==================================================================
  83+ 8482                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
  84+ 8482                  ; ==================================================================
  85+ 8482                  ; A = shift amount (1-7) al llegar aqui
  86+ 8482              .shifted:
  87+ 8482                  ; Calcular pagina de tabla (fiel a PrepDraw original)
  88+ 8482 3D               DEC A                       ; 0-6
  89+ 8483 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
  90+ 8484 E6 0E            AND $0E
  91+ 8486 F6 B0            OR SHIFT_TABLE_BASE         ; Base de tablas
  92+ 8488 32 CD 84         LD (.tablePage), A
  93+ 848B
  94+ 848B                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
  95+ 848B DD E5            PUSH IX
  96+ 848D D1               POP DE                      ; DE = puntero a pixel data
  97+ 848E D5               PUSH DE                     ; Guardar sprite data ptr en stack
  98+ 848F
  99+ 848F                  ; Recargar D=Y, E=X para CalcPixelAddr
 100+ 848F 3A CA 84         LD A, (.posY)
 101+ 8492 57               LD D, A
 102+ 8493 3A C9 84         LD A, (.posX)
 103+ 8496 5F               LD E, A
 104+ 8497 CD 14 87         CALL CalcPixelAddr          ; HL = dir VRAM
 105+ 849A
 106+ 849A D1               POP DE                      ; DE = sprite data ptr restaurado
 107+ 849B 3A CD 84         LD A, (.tablePage)
 108+ 849E 47               LD B, A                     ; B = pagina high part
 109+ 849F
 110+ 849F              .shiftedLine:
 111+ 849F E5               PUSH HL                     ; Guardar inicio de linea
 112+ 84A0 3A CB 84         LD A, (.widthSave)
 113+ 84A3 32 CE 84         LD (.widthCount), A
