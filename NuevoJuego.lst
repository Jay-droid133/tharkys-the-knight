 628+ A20F                  ; === STATE_SCARED: pausa dramatica + huida ===
 629+ A20F              .peScared:
 630+ A20F DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 631+ A213 C2 D8 A2         JP NZ, .peScaredFresh
 632+ A216
 633+ A216                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 634+ A216 3A F9 B4         LD A, (ScareTimer)
 635+ A219 FE 33            CP SCARE_FLEE_THRESHOLD + 1
 636+ A21B DA BB A2         JP C, .peScaredFlee
 637+ A21E                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 638+ A21E                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 639+ A21E DD 36 06 00      LD (IX+ENT_DELTAX), 0
 640+ A222 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 641+ A226                  ; Shake monster-only (nasties durante bells no se agitan)
 642+ A226 DD 7E 01         LD A, (IX+ENT_TYPE)
 643+ A229 FE 02            CP TYPE_MONSTER
 644+ A22B C2 A1 A2         JP NZ, .peScaredSpriteToggle
 645+ A22E                  ; --- Shake ---
 646+ A22E CD F0 92         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 647+ A231 5F               LD E, A
 648+ A232 16 00            LD D, 0
 649+ A234 21 0C 90         LD HL, MonsterAiFlags
 650+ A237 19               ADD HL, DE
 651+ A238 7E               LD A, (HL)
 652+ A239 CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 653+ A23B 20 15            JR NZ, .peShakeActive
 654+ A23D                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 655+ A23D F6 08            OR MAI_FLAG_SHAKE_SAVED
 656+ A23F 77               LD (HL), A
 657+ A240 21 1B 90         LD HL, MonsterShakeOrigX
 658+ A243 19               ADD HL, DE
 659+ A244 DD 7E 03         LD A, (IX+ENT_POSX)
 660+ A247 77               LD (HL), A
 661+ A248 21 1E 90         LD HL, MonsterShakeOrigY
 662+ A24B 19               ADD HL, DE
 663+ A24C DD 7E 04         LD A, (IX+ENT_POSY)
 664+ A24F 77               LD (HL), A
 665+ A250 18 4F            JR .peScaredSpriteToggle
 666+ A252              .peShakeActive:
 667+ A252                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 668+ A252 ED 5F            LD A, R
 669+ A254 E6 03            AND 3
 670+ A256 28 0C            JR Z, .peShakeUp
 671+ A258 3D               DEC A
 672+ A259 28 0F            JR Z, .peShakeDown
 673+ A25B 3D               DEC A
 674+ A25C 28 12            JR Z, .peShakeLeft
 675+ A25E                  ; 3: right
 676+ A25E 06 01            LD B, 1
 677+ A260 0E 00            LD C, 0
 678+ A262 18 10            JR .peShakeApply
 679+ A264              .peShakeUp:
 680+ A264 06 00            LD B, 0
 681+ A266 0E FF            LD C, -1
 682+ A268 18 0A            JR .peShakeApply
 683+ A26A              .peShakeDown:
 684+ A26A 06 00            LD B, 0
 685+ A26C 0E 01            LD C, 1
 686+ A26E 18 04            JR .peShakeApply
 687+ A270              .peShakeLeft:
 688+ A270 06 FF            LD B, -1
 689+ A272 0E 00            LD C, 0
 690+ A274              .peShakeApply:
 691+ A274                  ; new POSX = orig + B, new POSY = orig + C
 692+ A274 21 1B 90         LD HL, MonsterShakeOrigX
 693+ A277 19               ADD HL, DE
 694+ A278 7E               LD A, (HL)
 695+ A279 80               ADD A, B
 696+ A27A DD 77 03         LD (IX+ENT_POSX), A
 697+ A27D 21 1E 90         LD HL, MonsterShakeOrigY
 698+ A280 19               ADD HL, DE
 699+ A281 7E               LD A, (HL)
 700+ A282 81               ADD A, C
 701+ A283 DD 77 04         LD (IX+ENT_POSY), A
 702+ A286                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 703+ A286 CD C8 B5         CALL CheckEnemyCollision
 704+ A289 28 16            JR Z, .peScaredSpriteToggle
 705+ A28B                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 706+ A28B CD F0 92         CALL MaiGetMonsterSlot
 707+ A28E 5F               LD E, A
 708+ A28F 16 00            LD D, 0
 709+ A291 21 1B 90         LD HL, MonsterShakeOrigX
 710+ A294 19               ADD HL, DE
 711+ A295 7E               LD A, (HL)
 712+ A296 DD 77 03         LD (IX+ENT_POSX), A
 713+ A299 21 1E 90         LD HL, MonsterShakeOrigY
 714+ A29C 19               ADD HL, DE
 715+ A29D 7E               LD A, (HL)
 716+ A29E DD 77 04         LD (IX+ENT_POSY), A
 717+ A2A1              .peScaredSpriteToggle:
 718+ A2A1                  ; Animacion: toggle L/R cada 8f
 719+ A2A1 DD 35 09         DEC (IX+ENT_ANIMTIMER)
 720+ A2A4 20 12            JR NZ, .peScaredNoFlip
 721+ A2A6 DD 36 09 08      LD (IX+ENT_ANIMTIMER), 8
