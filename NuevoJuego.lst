7564+ C93E              ; ==============================================================================
7565+ C93E              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7566+ C93E              ; ==============================================================================
7567+ C93E              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7568+ C93E              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7569+ C93E              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7570+ C93E              ; ==============================================================================
7571+ C93E              ; ==============================================================================
7572+ C93E              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7573+ C93E              ; ==============================================================================
7574+ C93E              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7575+ C93E              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7576+ C93E              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7577+ C93E              ; los pone a su default.
7578+ C93E              ; ==============================================================================
7579+ C93E              InitGameState:
7580+ C93E 3E 03            LD A, PLAYER_LIVES_INIT
