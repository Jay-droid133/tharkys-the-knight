7611+ C979              ; ==============================================================================
7612+ C979              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7613+ C979              ; ==============================================================================
7614+ C979              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7615+ C979              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7616+ C979              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7617+ C979              ; ==============================================================================
7618+ C979              ; ==============================================================================
7619+ C979              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7620+ C979              ; ==============================================================================
7621+ C979              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7622+ C979              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7623+ C979              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7624+ C979              ; los pone a su default.
7625+ C979              ; ==============================================================================
7626+ C979              InitGameState:
7627+ C979 3E 03            LD A, PLAYER_LIVES_INIT
7628+ C97B 32 E3 82         LD (PlayerLives), A
7629+ C97E 3E 10            LD A, HEALTH_MAX
7630+ C980 32 86 B3         LD (PlayerHealth), A
7631+ C983 3E 10            LD A, STAMINA_MAX
7632+ C985 32 87 B3         LD (PlayerStamina), A
7633+ C988 AF               XOR A
7634+ C989 32 E4 82         LD (GameOver), A
7635+ C98C 32 BC 82         LD (CurrentObjective), A
7636+ C98F 32 B3 82         LD (CurrentKey), A
7637+ C992 32 B7 82         LD (ChurchEverOpened), A
7638+ C995 32 B6 82         LD (ChurchDoorOpen), A
7639+ C998 32 B8 82         LD (TimeFrozen), A
7640+ C99B 32 B5 82         LD (ChurchKeySpawned), A
7641+ C99E 32 C7 82         LD (TownGateKeySpawned), A
