 219+ 9CF7 3E 08            LD A, 8
 220+ 9CF9 01 FD FF         LD BC, $FFFD
 221+ 9CFC ED 79            OUT (C), A
 222+ 9CFE 01 FD BF         LD BC, $BFFD
 223+ 9D01 AF               XOR A
 224+ 9D02 ED 79            OUT (C), A
