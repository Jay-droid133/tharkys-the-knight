4833+ BC5F DD 7E 07         LD A, (IX+ENT_DELTAY)
4834+ BC62 ED 44            NEG
4835+ BC64 DD 77 07         LD (IX+ENT_DELTAY), A
4836+ BC67 78               LD A, B
4837+ BC68 EE 40            XOR $40                             ; recalcular signs cacheados
4838+ BC6A 47               LD B, A
4839+ BC6B              .spawnDirOk:
