4888+ BA0B              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4889+ BA0B              ; ==============================================================================
4890+ BA0B              UpdateEnemySpeed:
4891+ BA0B 3A 0D BD         LD A, (DayCycleCount)
4892+ BA0E 3D               DEC A                               ; 0-based index
4893+ BA0F FE 0A            CP 10
4894+ BA11 38 02            JR C, .uesOk
4895+ BA13 3E 09            LD A, 9                             ; Cap en indice 9
4896+ BA15              .uesOk:
4897+ BA15 F5               PUSH AF                             ; Guardar indice para tabla de anim
4898+ BA16 21 39 BA         LD HL, EnemySpeedTable
4899+ BA19 5F               LD E, A
4900+ BA1A 16 00            LD D, 0
4901+ BA1C 19               ADD HL, DE
4902+ BA1D 7E               LD A, (HL)                          ; A = velocidad × 2
4903+ BA1E                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4904+ BA1E CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4905+ BA20 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4906+ BA22                  ; Hay fraccion .5: alternar +1 en frames impares
4907+ BA22 47               LD B, A                             ; B = parte entera
4908+ BA23 3A 9A 81         LD A, (GameFrameCounter)
4909+ BA26 E6 01            AND 1                               ; 0 en par, 1 en impar
4910+ BA28 80               ADD A, B                            ; Sumar 0 o 1
4911+ BA29              .uesNoFrac:
4912+ BA29 32 57 8D         LD (CurrentEnemySpeed), A
4913+ BA2C                  ; Leer delay de animacion para este ciclo
4914+ BA2C F1               POP AF                              ; A = indice 0-based
4915+ BA2D 21 43 BA         LD HL, EnemyAnimDelayTable
4916+ BA30 5F               LD E, A
4917+ BA31 16 00            LD D, 0
4918+ BA33 19               ADD HL, DE
4919+ BA34 7E               LD A, (HL)
4920+ BA35 32 58 8D         LD (CurrentEnemyAnimDelay), A
4921+ BA38 C9               RET
4922+ BA39
4923+ BA39              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4924+ BA39              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4925+ BA39              EnemySpeedTable:
4926+ BA39 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4927+ BA3A 05               DEFB 5                              ; Ciclo 2: 2.5px
4928+ BA3B 06               DEFB 6                              ; Ciclo 3: 3px
4929+ BA3C 07               DEFB 7                              ; Ciclo 4: 3.5px
4930+ BA3D 08               DEFB 8                              ; Ciclo 5: 4px
4931+ BA3E 09               DEFB 9                              ; Ciclo 6: 4.5px
4932+ BA3F 0A               DEFB 10                             ; Ciclo 7: 5px
4933+ BA40 0B               DEFB 11                             ; Ciclo 8: 5.5px
4934+ BA41 0C               DEFB 12                             ; Ciclo 9: 6px
4935+ BA42 0E               DEFB 14                             ; Ciclo 10: 7px
4936+ BA43
4937+ BA43              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4938+ BA43              ; La rata usara la mitad de estos valores
4939+ BA43              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4940+ BA43 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4941+ BA44 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4942+ BA45 03               DEFB 3                              ; Ciclo 3 (era 6)
4943+ BA46 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4944+ BA47 02               DEFB 2                              ; Ciclo 5 (era 4)
4945+ BA48 02               DEFB 2                              ; Ciclo 6 (era 4)
4946+ BA49 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4947+ BA4A 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4948+ BA4B 01               DEFB 1                              ; Ciclo 9 (era 2)
4949+ BA4C 01               DEFB 1                              ; Ciclo 10 (era 2)
