 753+ E8BF 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 754+ E8C2 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 755+ E8C4 77               LD (HL), A
 756+ E8C5 23               INC HL
 757+ E8C6 77               LD (HL), A
 758+ E8C7 C9               RET
