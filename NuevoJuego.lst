 245+ E61A              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 246+ E61A              DrawSwordModeHUD:
 247+ E61A 3A F1 B5         LD A, (SwordMode)
 248+ E61D 21 4D E6         LD HL, .modeChars
 249+ E620 5F               LD E, A
 250+ E621 16 00            LD D, 0
 251+ E623 19               ADD HL, DE
 252+ E624 7E               LD A, (HL)                          ; A = ASCII del modo
 253+ E625                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 254+ E625 21 00 40         LD HL, $4000
 255+ E628                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 256+ E628 5F               LD E, A
 257+ E629 16 00            LD D, 0
 258+ E62B 42               LD B, D                             ; B = 0
 259+ E62C CB 23            SLA E
 259+ E62E CB 12          RL D                        ; *2
 260+ E630 CB 23            SLA E
 260+ E632 CB 12          RL D                        ; *4
 261+ E634 CB 23            SLA E
 261+ E636 CB 12          RL D                        ; *8
 262+ E638 E5               PUSH HL
 263+ E639 21 00 3C         LD HL, $3C00
 264+ E63C 19               ADD HL, DE                          ; HL = direccion del glyph
 265+ E63D EB               EX DE, HL                           ; DE = glyph
 266+ E63E E1               POP HL                              ; HL = VRAM
 267+ E63F 06 08            LD B, 8
 268+ E641              .drawChar:
 269+ E641 1A               LD A, (DE)
