1608+ F4E3              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1609+ F4E3
1610+ F4E3              ; ==============================================================================
1611+ F4E3              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1612+ F4E3              ; ==============================================================================
1613+ F4E3              ; Indice (CompassSprites[idx]):
1614+ F4E3              ;   0 = NW    1 = N    2 = NE
1615+ F4E3              ;   3 = W     4 = X    5 = E
1616+ F4E3              ;   6 = SW    7 = S    8 = SE
1617+ F4E3              ; ==============================================================================
1618+ F4E3              CompassSprites:
1619+ F4E3 02 F6            DEFW Sprite_Compass_NW
1620+ F4E5 22 F5            DEFW Sprite_Compass_N
1621+ F4E7 42 F5            DEFW Sprite_Compass_NE
1622+ F4E9 E2 F5            DEFW Sprite_Compass_W
1623+ F4EB 22 F6            DEFW Sprite_Compass_X
1624+ F4ED 62 F5            DEFW Sprite_Compass_E
1625+ F4EF C2 F5            DEFW Sprite_Compass_SW
1626+ F4F1 A2 F5            DEFW Sprite_Compass_S
1627+ F4F3 82 F5            DEFW Sprite_Compass_SE
1628+ F4F5
1629+ F4F5              ; ==============================================================================
1630+ F4F5              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1631+ F4F5              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1632+ F4F5              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1633+ F4F5              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1634+ F4F5              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1635+ F4F5              ; ==============================================================================
1636+ F4F5              CompassWobbleTable:
1637+ F4F5 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1638+ F4F9 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1639+ F4FD 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1640+ F501 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1641+ F505 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1642+ F509 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1643+ F50D 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1644+ F511 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1645+ F515 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1646+ F519
1647+ F519              ; ==============================================================================
1648+ F519              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1649+ F519              ; Indexada por (counter-1) -> 0..8. Valor:
1650+ F519              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1651+ F519              ; Con counter inicial 9 y decremento por frame:
1652+ F519              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1653+ F519              ;   counter 8 -> phase 7 -> prev
1654+ F519              ;   counter 7 -> phase 6 -> target
1655+ F519              ;   counter 6 -> phase 5 -> next
1656+ F519              ;   counter 5 -> phase 4 -> next2
1657+ F519              ;   counter 4 -> phase 3 -> prev
1658+ F519              ;   counter 3 -> phase 2 -> target
1659+ F519              ;   counter 2 -> phase 1 -> prev
1660+ F519              ;   counter 1 -> phase 0 -> target (estado final, settle)
1661+ F519              ; ==============================================================================
1662+ F519              WobblePhaseTable:
1663+ F519 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1663+ F51D 04 03 02 01
1663+ F521 00
