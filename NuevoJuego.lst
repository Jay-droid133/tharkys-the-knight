 353+ 726B                  ; --- Scan BG stream, build SlotList ---
 354+ 726B AF               XOR A
 355+ 726C 32 AB 5F         LD (RandomSlotCount), A
 356+ 726F 2A 0A 83         LD HL, (CurrentScreenAddr)
 357+ 7272              .urpScanLoop:
