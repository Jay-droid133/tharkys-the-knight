 714+ E570 01 00 3C         LD BC, $3C00
 715+ E573 09               ADD HL, BC                  ; HL = font data
 716+ E574 16 40            LD D, $40                   ; Tercio 0, scan line 0
 717+ E576 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 718+ E577 5F               LD E, A                     ; DE = dir VRAM
 719+ E578 06 08            LD B, 8
