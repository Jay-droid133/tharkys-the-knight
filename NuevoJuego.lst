5473+ BD0A              ; ==============================================================================
5474+ BD0A              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5475+ BD0A              ; ==============================================================================
5476+ BD0A              ScareAllMonsters:
5477+ BD0A AF               XOR A
5478+ BD0B 32 5B B3         LD (MonstersActive), A              ; No respawnear mas
5479+ BD0E                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5480+ BD0E                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5481+ BD0E                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5482+ BD0E 21 96 8D         LD HL, MonsterAiFlags
5483+ BD11 06 03            LD B, 3
5484+ BD13              .samClearLoop:
5485+ BD13 7E               LD A, (HL)
5486+ BD14 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5487+ BD16 77               LD (HL), A
5488+ BD17 23               INC HL
5489+ BD18 10 F9            DJNZ .samClearLoop
5490+ BD1A 3E 7D            LD A, SCARE_TIMER_DAWN
5491+ BD1C 32 F1 B5         LD (ScareTimer), A
5492+ BD1F                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5493+ BD1F                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5494+ BD1F                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5495+ BD1F                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5496+ BD1F DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5497+ BD23 06 06            LD B, NUM_MONSTERS
5498+ BD25              .samStateLoop:
5499+ BD25 DD 7E 01         LD A, (IX+ENT_TYPE)
5500+ BD28 FE 02            CP TYPE_MONSTER
5501+ BD2A 20 1B            JR NZ, .samStateNext
5502+ BD2C DD 7E 02         LD A, (IX+ENT_STATE)
5503+ BD2F FE 03            CP STATE_DYING
5504+ BD31 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5505+ BD33 FE 04            CP STATE_SPAWNING
5506+ BD35 28 10            JR Z, .samStateNext
5507+ BD37 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5508+ BD3B DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5509+ BD3F DD 36 06 00      LD (IX+ENT_DELTAX), 0
5510+ BD43 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5511+ BD47              .samStateNext:
5512+ BD47 11 10 00         LD DE, ENT_SIZE
5513+ BD4A DD 19            ADD IX, DE
5514+ BD4C 10 D7            DJNZ .samStateLoop
