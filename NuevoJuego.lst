 702+ CDCB                  ; ===================== PATH LITERAL (sin cambios) =====================
 703+ CDCB              .pixRow:
 704+ CDCB 3A 94 CE         LD A, (.widthVal)
 705+ CDCE 47               LD B, A
 706+ CDCF E5               PUSH HL                     ; guardar inicio de fila VRAM
 707+ CDD0
 708+ CDD0              .pixCol:
 709+ CDD0 DD 7E 00         LD A, (IX+0)
 710+ CDD3 2F               CPL                         ; des-invertir (dato almacenado CPL'd)
 711+ CDD4 77               LD (HL), A
 712+ CDD5 DD 23            INC IX
 713+ CDD7 23               INC HL
 714+ CDD8 10 F6            DJNZ .pixCol
 715+ CDDA
 716+ CDDA E1               POP HL                      ; restaurar inicio fila
 717+ CDDB 3A 93 CE         LD A, (.heightCnt)
 718+ CDDE 3D               DEC A
 719+ CDDF 32 93 CE         LD (.heightCnt), A
