 412+ A392              ; ==============================================================================
 413+ A392              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 414+ A392              ; ==============================================================================
 415+ A392              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 416+ A392              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 417+ A392              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 418+ A392              ; ==============================================================================
 419+ A392              ProcessEnemies:
 420+ A392 3E 00            LD A, 0
 421+ A394 32 DD A3         LD (.peCount), A
 422+ A397 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 423+ A399
 424+ A399              .peLoop:
 425+ A399 C5               PUSH BC
 426+ A39A
 427+ A39A                  ; Calcular IX desde EnemyStepIdx
 428+ A39A 3A A7 82         LD A, (EnemyStepIdx)
 429+ A39D C6 01            ADD A, SLOT_MONSTER0
 430+ A39F 6F               LD L, A
 431+ A3A0 26 00            LD H, 0
 432+ A3A2 29               ADD HL, HL
 433+ A3A3 29               ADD HL, HL
 434+ A3A4 29               ADD HL, HL
 435+ A3A5 29               ADD HL, HL                          ; × ENT_SIZE (16)
 436+ A3A6 11 4B 81         LD DE, EntityTable
 437+ A3A9 19               ADD HL, DE
 438+ A3AA E5               PUSH HL
 439+ A3AB DD E1            POP IX
 440+ A3AD
 441+ A3AD                  ; Avanzar indice round-robin
 442+ A3AD 3A A7 82         LD A, (EnemyStepIdx)
 443+ A3B0 3C               INC A
 444+ A3B1 FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 445+ A3B3 38 01            JR C, .peNoWrap
 446+ A3B5 AF               XOR A
 447+ A3B6              .peNoWrap:
 448+ A3B6 32 A7 82         LD (EnemyStepIdx), A
 449+ A3B9
 450+ A3B9                  ; Slot activo?
 451+ A3B9 DD 7E 01         LD A, (IX+ENT_TYPE)
 452+ A3BC B7               OR A
 453+ A3BD 28 16            JR Z, .peSkip
 454+ A3BF
 455+ A3BF                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 456+ A3BF DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 457+ A3C3 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 458+ A3C4
 459+ A3C4                  ; Procesar esta entidad completa (erase + logic + draw)
 460+ A3C4 CD DE A3         CALL ProcessOneEnemy
 461+ A3C7
 462+ A3C7                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 463+ A3C7 F1               POP AF
 464+ A3C8 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 465+ A3CA
 466+ A3CA                  ; Budget check
 467+ A3CA 3A DD A3         LD A, (.peCount)
 468+ A3CD 3C               INC A
 469+ A3CE 32 DD A3         LD (.peCount), A
 470+ A3D1 FE 02            CP MAX_ENEMIES_PER_FRAME
 471+ A3D3 30 06            JR NC, .peDone
 472+ A3D5
 473+ A3D5              .peSkip:
 474+ A3D5 C1               POP BC
 475+ A3D6 05               DEC B
 476+ A3D7 C2 99 A3         JP NZ, .peLoop
 477+ A3DA C9               RET
 478+ A3DB
 479+ A3DB              .peDone:
 480+ A3DB C1               POP BC
 481+ A3DC C9               RET
