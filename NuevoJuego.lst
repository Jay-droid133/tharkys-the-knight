2427+ D8DB 87             ADD A, A
2427+ D8DC 87             ADD A, A  ; *8 = px_left
2428+ D8DD 32 FA D9         LD (.cbtSpX), A
2429+ D8E0 23               INC HL
2430+ D8E1 7E               LD A, (HL)                      ; charY
2431+ D8E2 C6 02            ADD A, BG_Y_OFFSET
2432+ D8E4 87               ADD A, A
2432+ D8E5 87             ADD A, A
2432+ D8E6 87             ADD A, A  ; *8 = px_top
2433+ D8E7 32 FB D9         LD (.cbtSpY), A
2434+ D8EA                  ; AABB overlap test con extensión +SPEED_RUN pixels en cada lado.
2435+ D8EA                  ; Motivo: el motor revierte el movimiento al chocar, dejando al player
2436+ D8EA                  ; hasta 4 px del wall. Sin esta tolerancia, el bump nunca dispararía.
2437+ D8EA                  ; Horizontal: ext_left = max(0, sprite_left - 4), ext_right = min(255, sprite_right + 4).
2438+ D8EA 3A 97 81         LD A, (EntityTable + ENT_POSX)
2439+ D8ED 4F               LD C, A                         ; C = player_left
2440+ D8EE C6 10            ADD A, 16                       ; A = player_right
2441+ D8F0 57               LD D, A
2442+ D8F1                  ; ext_left: sprite_left - 4 con clamp inferior (sin underflow)
2443+ D8F1 3A FA D9         LD A, (.cbtSpX)
2444+ D8F4 D6 04            SUB 4
2445+ D8F6 30 01            JR NC, .cbtNoUnderflowL
