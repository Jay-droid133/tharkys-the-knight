1474+ F605              ; ==============================================================================
1475+ F605              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1476+ F605              ; ==============================================================================
1477+ F605              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1478+ F605              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1479+ F605              ; ==============================================================================
1480+ F605              ChurchCutsceneEraseStatueAtLast:
1481+ F605              ChurchCutsceneDrawStatueAtLast:
1482+ F605 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1483+ F608 21 B0 64         LD HL, StatueIdTable
1484+ F60B 5F               LD E, A
1485+ F60C 16 00            LD D, 0
1486+ F60E 19               ADD HL, DE
1487+ F60F 7E               LD A, (HL)                              ; A = statue id
1488+ F610 B7               OR A
1489+ F611 C8               RET Z
1490+ F612                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1491+ F612 6F               LD L, A
1492+ F613 26 00            LD H, 0
1493+ F615 54               LD D, H
1494+ F616 5D               LD E, L
1495+ F617 29               ADD HL, HL
1496+ F618 19               ADD HL, DE                              ; HL = id*3
1497+ F619 11 F6 E0         LD DE, BgGfxPtrById
1498+ F61C 19               ADD HL, DE
1499+ F61D 5E               LD E, (HL)
1500+ F61E 23               INC HL
1501+ F61F 56               LD D, (HL)                              ; DE = sprite ptr
1502+ F620 23               INC HL
1503+ F621 7E               LD A, (HL)                              ; A = bank
1504+ F622 EB               EX DE, HL                               ; HL = sprite ptr
1505+ F623 CD C9 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1506+ F626                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1507+ F626 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1508+ F629 57               LD D, A
1509+ F62A 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1510+ F62D 5F               LD E, A
1511+ F62E C3 38 66         JP DrawBgSprite16XorAtPixel
1512+ F631
1513+ F631              ; ==============================================================================
1514+ F631              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1515+ F631              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1516+ F631              ;     A  = jitter signed (-1, 0, +1) en bits.
1517+ F631              ; ==============================================================================
1518+ F631              ; IN: A = jitter signed (-1, 0, +1) en bits.
1519+ F631              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1520+ F631              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1521+ F631              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1522+ F631              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1523+ F631              ; version shifted, sin XOR.
1524+ F631              ;
1525+ F631              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1526+ F631              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1527+ F631              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1528+ F631              ; estatua se perdio cuando la estatua se pinto la primera vez con
1529+ F631              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1530+ F631              ; de la estatua, el wall perdido no se ve.
1531+ F631              ;
1532+ F631              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1533+ F631              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1534+ F631              ; shift de 1 bit no pierde pixels visibles.
1535+ F631              ; Destruye: AF, BC, DE, HL, IX.
1536+ F631              ; ==============================================================================
1537+ F631              ChurchCutsceneShakeStatueByteShift:
1538+ F631 32 9B F6         LD (.csbsJitter), A
1539+ F634                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1540+ F634 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1541+ F637 5F               LD E, A
1542+ F638 16 00            LD D, 0
1543+ F63A 19               ADD HL, DE
1544+ F63B 7E               LD A, (HL)
1545+ F63C B7               OR A
1546+ F63D C8               RET Z                                   ; sin estatua
1547+ F63E 6F               LD L, A
1548+ F63F 26 00            LD H, 0
1549+ F641 54               LD D, H
1550+ F642 5D               LD E, L
1551+ F643 29               ADD HL, HL
1552+ F644 19               ADD HL, DE                              ; HL = id*3
1553+ F645 11 F6 E0         LD DE, BgGfxPtrById
1554+ F648 19               ADD HL, DE
1555+ F649 5E               LD E, (HL)
1556+ F64A 23               INC HL
1557+ F64B 56               LD D, (HL)                              ; DE = sprite ptr
1558+ F64C 23               INC HL
1559+ F64D 7E               LD A, (HL)                              ; A = bank
1560+ F64E EB               EX DE, HL                               ; HL = sprite ptr
1561+ F64F CD C9 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1562+ F652                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1563+ F652 DD 21 FD 86      LD IX, BgSpriteBuffer
1564+ F656 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1565+ F659 B7               OR A
1566+ F65A C8               RET Z
1567+ F65B 47               LD B, A                                 ; B = row counter
1568+ F65C DD 23            INC IX
1569+ F65E DD 23            INC IX                                  ; IX -> pixel data
1570+ F660                  ; Calcular addr VRAM en (origX, origY)
1571+ F660 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1572+ F663 57               LD D, A
1573+ F664 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1574+ F667 5F               LD E, A
1575+ F668 CD 62 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1576+ F66B              .csbsRow:
1577+ F66B C5               PUSH BC
1578+ F66C E5               PUSH HL                                 ; save inicio fila VRAM
1579+ F66D                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1580+ F66D DD 7E 00         LD A, (IX+0)
1581+ F670 2F               CPL
1582+ F671 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1583+ F672 DD 7E 01         LD A, (IX+1)
1584+ F675 2F               CPL
1585+ F676 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1586+ F677                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1587+ F677 3A 9B F6         LD A, (.csbsJitter)
1588+ F67A B7               OR A
1589+ F67B 28 0D            JR Z, .csbsWrite                        ; sin shift
1590+ F67D FA 86 F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1591+ F680                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1592+ F680 CB 3A            SRL D
1593+ F682 CB 1B            RR E
1594+ F684 18 04            JR .csbsWrite
1595+ F686              .csbsLeft:
1596+ F686 CB 23            SLA E
1597+ F688 CB 12            RL D
1598+ F68A              .csbsWrite:
1599+ F68A 7A               LD A, D
1600+ F68B 77               LD (HL), A
1601+ F68C 23               INC HL
1602+ F68D 7B               LD A, E
1603+ F68E 77               LD (HL), A
1604+ F68F E1               POP HL
1605+ F690 CD CE 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1606+ F693 DD 23            INC IX
1607+ F695 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1608+ F697 C1               POP BC
1609+ F698 10 D1            DJNZ .csbsRow
1610+ F69A C9               RET
1611+ F69B 00           .csbsJitter: DEFB 0
1612+ F69C
1613+ F69C              ; ==============================================================================
1614+ F69C              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1615+ F69C              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1616+ F69C              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1617+ F69C              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1618+ F69C              ; Destruye: AF, BC, HL.
1619+ F69C              ; ==============================================================================
1620+ F69C              ChurchCutsceneEraseStatueDirect:
1621+ F69C 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1622+ F69F 57               LD D, A
1623+ F6A0 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1624+ F6A3 5F               LD E, A
1625+ F6A4 CD 62 9D         CALL CalcPixelAddr
1626+ F6A7 06 18            LD B, 24                                ; statues son 24 px de alto
1627+ F6A9              .csedRow:
1628+ F6A9 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1629+ F6AA 77               LD (HL), A
1630+ F6AB 23               INC HL
1631+ F6AC 77               LD (HL), A
1632+ F6AD 2B               DEC HL                                  ; volver a inicio fila
1633+ F6AE C5               PUSH BC
1634+ F6AF CD CE 9A         CALL NextPixelLine
1635+ F6B2 C1               POP BC
1636+ F6B3 10 F4            DJNZ .csedRow
1637+ F6B5 C9               RET
1638+ F6B6
1639+ F6B6              ; ==============================================================================
1640+ F6B6              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1641+ F6B6              ; ==============================================================================
1642+ F6B6              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1643+ F6B6              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1644+ F6B6              ; suficiente para corromper visualmente).
1645+ F6B6              ; IN: IX = entity ptr.
1646+ F6B6              ; ==============================================================================
1647+ F6B6              RedrawTrappedMonster:
1648+ F6B6                  ; --- Erase viejo en (OLDX, OLDY) ---
1649+ F6B6 CD 23 A5         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1650+ F6B9 DD 7E 0D         LD A, (IX+ENT_OLDY)
1651+ F6BC 57               LD D, A
1652+ F6BD DD 7E 0C         LD A, (IX+ENT_OLDX)
1653+ F6C0 5F               LD E, A
1654+ F6C1 DD E5            PUSH IX
1655+ F6C3 DD 2A AB A4      LD IX, (OldSprAddr)
1656+ F6C7 CD EF 99         CALL DrawSprite
1657+ F6CA DD E1            POP IX
1658+ F6CC                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1659+ F6CC                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1660+ F6CC DD 56 0D         LD D, (IX+ENT_OLDY)
1661+ F6CF DD 5E 0C         LD E, (IX+ENT_OLDX)
1662+ F6D2 CD 5D D3         CALL RestoreOldAttr
1663+ F6D5                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1664+ F6D5                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1665+ F6D5                  ; reponer attrs de pickups que el flujo de entidades pisa con
1666+ F6D5                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1667+ F6D5                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1668+ F6D5                  ; estar bajo el monster.
1669+ F6D5 DD E5            PUSH IX
1670+ F6D7 CD 73 DA         CALL RefreshPickupAttrs
1671+ F6DA DD E1            POP IX
1672+ F6DC                  ; --- Compute new draw pos ---
1673+ F6DC CD AD A4         CALL CalcDrawX
1674+ F6DF CD 45 9F         CALL ComputeEnemyDrawY
1675+ F6E2                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1676+ F6E2 CD F2 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1677+ F6E5 3A E5 82         LD A, (EnemyDrawY)
1678+ F6E8 57               LD D, A
1679+ F6E9 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1680+ F6EC 5F               LD E, A
1681+ F6ED DD E5            PUSH IX
1682+ F6EF DD 2A 21 A5      LD IX, (SpriteAddrTemp)
1683+ F6F3 CD 0C 9B         CALL CalcEntityAttrSize
1684+ F6F6 DD E1            POP IX
1685+ F6F8 3A E5 82         LD A, (EnemyDrawY)
1686+ F6FB 57               LD D, A
1687+ F6FC DD 7E 0F         LD A, (IX+ENT_DRAWX)
1688+ F6FF 5F               LD E, A
1689+ F700 DD 7E 05         LD A, (IX+ENT_ATTR)
1690+ F703 CD DF 9A         CALL SetEntityAttr
1691+ F706                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1692+ F706 3A E5 82         LD A, (EnemyDrawY)
1693+ F709 57               LD D, A
1694+ F70A DD 7E 0F         LD A, (IX+ENT_DRAWX)
1695+ F70D 5F               LD E, A
1696+ F70E DD E5            PUSH IX
1697+ F710 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
1698+ F714 CD EF 99         CALL DrawSprite
1699+ F717 DD E1            POP IX
1700+ F719                  ; --- Save OLD = current ---
1701+ F719 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1702+ F71C DD 77 0C         LD (IX+ENT_OLDX), A
1703+ F71F 3A E5 82         LD A, (EnemyDrawY)
1704+ F722 DD 77 0D         LD (IX+ENT_OLDY), A
1705+ F725 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1706+ F728 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1707+ F72B C9               RET
