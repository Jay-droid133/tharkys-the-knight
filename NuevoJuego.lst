6138+ C553              ; ==============================================================================
6139+ C553              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6140+ C553              ; ==============================================================================
6141+ C553              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6142+ C553              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6143+ C553              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6144+ C553              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6145+ C553              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6146+ C553              ; main.asm; aqui no hace falta guard adicional).
6147+ C553              ; ==============================================================================
6148+ C553
6149+ C553              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6150+ C553              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6151+ C553              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6152+ C553              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6153+ C553              ;
6154+ C553              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6155+ C553              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6156+ C553              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6157+ C553              ;
6158+ C553              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6159+ C553              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6160+ C553              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6161+ C553              ; en vez de 8 + orientacion invertida).
6162+ C553              UpdateDeath:
6163+ C553                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6164+ C553                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6165+ C553                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6166+ C553                  ; progreso real, no solo quedar inmovil. ---
6167+ C553 2A FF 81         LD HL, (DeathGhostStuckTimer)
6168+ C556 23               INC HL
6169+ C557 22 FF 81         LD (DeathGhostStuckTimer), HL
6170+ C55A 7C               LD A, H
6171+ C55B FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6172+ C55D 38 0C            JR C, .udGhostCheckDone
6173+ C55F 20 05            JR NZ, .udGhostOn
6174+ C561 7D               LD A, L
6175+ C562 FE 7D            CP (DEATH_GHOST_FRAMES) & $FF
6176+ C564 38 05            JR C, .udGhostCheckDone
6177+ C566              .udGhostOn:
6178+ C566 3E 01            LD A, 1
6179+ C568 32 01 82         LD (DeathGhostMode), A
6180+ C56B              .udGhostCheckDone:
6181+ C56B
6182+ C56B                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6183+ C56B 3A 01 82         LD A, (DeathGhostMode)
6184+ C56E B7               OR A
6185+ C56F C2 B6 C5         JP NZ, DeathGhostChase
6186+ C572
6187+ C572                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6188+ C572 DD 7E 03         LD A, (IX+ENT_POSX)
6189+ C575 32 FC 81         LD (DeathPrevX), A
6190+ C578 DD 7E 04         LD A, (IX+ENT_POSY)
6191+ C57B 32 FD 81         LD (DeathPrevY), A
6192+ C57E                  ; Sub-pixel acc 1/2
6193+ C57E 3A FB 81         LD A, (DeathSubPixelAcc)
6194+ C581 EE 01            XOR 1
6195+ C583 32 FB 81         LD (DeathSubPixelAcc), A
6196+ C586 28 05            JR Z, .udSkip
6197+ C588 CD 96 B0         CALL UpdateMonster                  ; activo: chase + move + animate
6198+ C58B 18 03            JR .udPost
6199+ C58D              .udSkip:
6200+ C58D CD 1B C6         CALL DeathAnimate                   ; skip: solo animacion
6201+ C590              .udPost:
6202+ C590                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6203+ C590 3A FC 81         LD A, (DeathPrevX)
6204+ C593 DD BE 03         CP (IX+ENT_POSX)
6205+ C596 20 19            JR NZ, .udMoved
6206+ C598 3A FD 81         LD A, (DeathPrevY)
6207+ C59B DD BE 04         CP (IX+ENT_POSY)
6208+ C59E 20 11            JR NZ, .udMoved
6209+ C5A0                  ; No movio: incrementar BFS counter
6210+ C5A0 3A FE 81         LD A, (DeathStuckCounter)
6211+ C5A3 3C               INC A
6212+ C5A4 32 FE 81         LD (DeathStuckCounter), A
6213+ C5A7 FE 06            CP DEATH_STUCK_THRESHOLD
6214+ C5A9 D8               RET C
6215+ C5AA AF               XOR A
6216+ C5AB 32 FE 81         LD (DeathStuckCounter), A
6217+ C5AE C3 6E C7         JP DeathBfsRescue
6218+ C5B1              .udMoved:
6219+ C5B1 AF               XOR A
6220+ C5B2 32 FE 81         LD (DeathStuckCounter), A
6221+ C5B5 C9               RET
6222+ C5B6
6223+ C5B6              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6224+ C5B6              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6225+ C5B6              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6226+ C5B6              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6227+ C5B6              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6228+ C5B6              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6229+ C5B6              DeathGhostChase:
6230+ C5B6                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6231+ C5B6 3A CA 80         LD A, (EntityTable + ENT_POSX)
6232+ C5B9 DD 96 03         SUB (IX+ENT_POSX)
6233+ C5BC 30 02            JR NC, .udgAbsDxOk
6234+ C5BE ED 44            NEG
6235+ C5C0              .udgAbsDxOk:
6236+ C5C0 47               LD B, A                             ; B = |dx|
6237+ C5C1 3A CB 80         LD A, (EntityTable + ENT_POSY)
6238+ C5C4 DD 96 04         SUB (IX+ENT_POSY)
6239+ C5C7 30 02            JR NC, .udgAbsDyOk
6240+ C5C9 ED 44            NEG
6241+ C5CB              .udgAbsDyOk:
6242+ C5CB                  ; A = |dy|, B = |dx|
6243+ C5CB B8               CP B
6244+ C5CC 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6245+ C5CE
6246+ C5CE                  ; --- Eje X primario ---
6247+ C5CE AF               XOR A
6248+ C5CF DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6249+ C5D2 3A CA 80         LD A, (EntityTable + ENT_POSX)
6250+ C5D5 DD 96 03         SUB (IX+ENT_POSX)
6251+ C5D8 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6252+ C5DA 3E 04            LD A, DEATH_GHOST_SPEED
6253+ C5DC 30 02            JR NC, .udgXSet
6254+ C5DE 3E FC            LD A, -DEATH_GHOST_SPEED
6255+ C5E0              .udgXSet:
6256+ C5E0 DD 77 06         LD (IX+ENT_DELTAX), A
6257+ C5E3 DD 86 03         ADD A, (IX+ENT_POSX)
6258+ C5E6 DD 77 03         LD (IX+ENT_POSX), A
6259+ C5E9 18 1B            JR .udgAnim
6260+ C5EB
6261+ C5EB                  ; --- Eje Y primario ---
6262+ C5EB              .udgVertPrim:
6263+ C5EB AF               XOR A
6264+ C5EC DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6265+ C5EF 3A CB 80         LD A, (EntityTable + ENT_POSY)
6266+ C5F2 DD 96 04         SUB (IX+ENT_POSY)
6267+ C5F5 28 0F            JR Z, .udgAnim
6268+ C5F7 3E 04            LD A, DEATH_GHOST_SPEED
6269+ C5F9 30 02            JR NC, .udgYSet
6270+ C5FB 3E FC            LD A, -DEATH_GHOST_SPEED
6271+ C5FD              .udgYSet:
6272+ C5FD DD 77 07         LD (IX+ENT_DELTAY), A
6273+ C600 DD 86 04         ADD A, (IX+ENT_POSY)
6274+ C603 DD 77 04         LD (IX+ENT_POSY), A
6275+ C606              .udgAnim:
6276+ C606                  ; Check de salida: si el bbox de Death no overlapea con wall (free space),
6277+ C606                  ; exit ghost mode + reset timers para que AI normal reanude. Si aun en wall,
6278+ C606                  ; persistir ghost (next frame seguira moviendo).
6279+ C606 CD 66 B9         CALL CheckEnemyCollision            ; Z = free, NZ = blocked
6280+ C609 20 0D            JR NZ, .udgInWall
6281+ C60B AF               XOR A
6282+ C60C 32 01 82         LD (DeathGhostMode), A
6283+ C60F 32 FE 81         LD (DeathStuckCounter), A
6284+ C612 21 00 00         LD HL, 0
6285+ C615 22 FF 81         LD (DeathGhostStuckTimer), HL
6286+ C618              .udgInWall:
6287+ C618 C3 1B C6         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6288+ C61B
6289+ C61B              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6290+ C61B              ; Llamada por:
6291+ C61B              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6292+ C61B              ;   - UpdateDeath en frame skip (sin movimiento).
6293+ C61B              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6294+ C61B              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6295+ C61B              DeathAnimate:
6296+ C61B DD 7E 06         LD A, (IX+ENT_DELTAX)
6297+ C61E B7               OR A
6298+ C61F 28 0A            JR Z, .daKeepDir
6299+ C621 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6300+ C623 CB 7F            BIT 7, A
6301+ C625 28 0D            JR Z, .daDir
6302+ C627 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6303+ C629 18 09            JR .daDir
6304+ C62B              .daKeepDir:
6305+ C62B DD 7E 00         LD A, (IX+ENT_SPRITEID)
6306+ C62E DD 96 08         SUB (IX+ENT_ANIMBASE)
6307+ C631 E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6308+ C633 4F               LD C, A
6309+ C634              .daDir:
6310+ C634 DD 35 09         DEC (IX+ENT_ANIMTIMER)
6311+ C637 20 16            JR NZ, .daFrameSet
