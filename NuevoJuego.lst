1806+ AC4D              ; UpdatePlayerAnimation - Animacion por SpriteID
1807+ AC4D              ; ==============================================================================
1808+ AC4D              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
1809+ AC4D              ; ==============================================================================
1810+ AC4D              UpdatePlayerAnimation:
1811+ AC4D                  ; Determinar animacion segun estado y direccion
1812+ AC4D DD 7E 02         LD A, (IX+ENT_STATE)
1813+ AC50 FE 02            CP STATE_FIGHTING
1814+ AC52 28 0C            JR Z, .animFight
1815+ AC54 FE 01            CP STATE_RUNNING
1816+ AC56 28 21            JR Z, .animRun
1817+ AC58
1818+ AC58                  ; --- IDLE ---
1819+ AC58 16 00            LD D, SPRID_IDLE
1820+ AC5A 1E 02            LD E, ANIM_FRAMES_IDLE
1821+ AC5C 0E 0A            LD C, ANIM_DELAY_IDLE
1822+ AC5E 18 44            JR .applyAnim
1823+ AC60
1824+ AC60              .animFight:
1825+ AC60                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1826+ AC60 DD 7E 0A         LD A, (IX+ENT_DIR)
1827+ AC63 0F               RRCA
1828+ AC64 0F               RRCA
1829+ AC65 0F               RRCA
1830+ AC66 0F               RRCA
1831+ AC67 E6 0F            AND $0F                     ; lastHDir
1832+ AC69 FE 08            CP DIR_W
1833+ AC6B 28 04            JR Z, .fightW
1834+ AC6D 16 16            LD D, SPRID_ATTACK_EAST
1835+ AC6F 18 02            JR .fightSet
1836+ AC71              .fightW:
