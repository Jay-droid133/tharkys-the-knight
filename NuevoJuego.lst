2441+ ABFF 3A 9F 81         LD A, (EntityTable + ENT_POSY)
2442+ AC02 57               LD D, A
2443+ AC03 DD 7E 04         LD A, (IX+ENT_POSY)
2444+ AC06 BA               CP D
2445+ AC07 D0               RET NC                              ; nastyY >= playerY → no esta arriba
2446+ AC08                  ; Lanzarse hacia abajo
2447+ AC08 3A 46 AC         LD A, (.cpSpeed)
2448+ AC0B DD 77 07         LD (IX+ENT_DELTAY), A
2449+ AC0E DD 36 06 00      LD (IX+ENT_DELTAX), 0
2450+ AC12 18 2D            JR .cpActivate
