1311+ D3CD                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1312+ D3CD                  ; Total pixeles = height_px * (width_bytes & $7F)
1313+ D3CD              .spSkipRle:
1314+ D3CD 7B               LD A, E
1315+ D3CE E6 7F            AND $7F                     ; width_bytes real
1316+ D3D0                  ; Calcular total = D * A (height * width)
1317+ D3D0 42               LD B, D                     ; B = height
1318+ D3D1 21 00 00         LD HL, 0
1319+ D3D4 16 00            LD D, 0
1320+ D3D6 5F               LD E, A                     ; DE = width
