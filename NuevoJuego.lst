 443+ EF13              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EF13              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EF13              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EF13              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EF13              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EF13              .drawBar:
 449+ EF13 7D               LD A, L
 450+ EF14 32 5F EF         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EF17 7B               LD A, E
 452+ EF18 32 60 EF         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EF1B 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EF1D 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
