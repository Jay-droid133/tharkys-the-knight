4237+ B692              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
4238+ B692              ; ==============================================================================
4239+ B692              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
4240+ B692              ; ==============================================================================
4241+ B692              SchedulePendingErase:
4242+ B692 3A 7B 5F         LD A, (PendingEraseCount)
4243+ B695 FE 03            CP 3
4244+ B697 D0               RET NC                              ; Buffer lleno (no deberia pasar)
4245+ B698                  ; Calcular posicion en buffer: count × 5
4246+ B698 6F               LD L, A
4247+ B699 26 00            LD H, 0
4248+ B69B 29               ADD HL, HL
4249+ B69C 29               ADD HL, HL
4250+ B69D 29               ADD HL, HL                          ; count × 8 (simplificado)
4251+ B69E                  ; Corregir: count × 5 = count × 4 + count
4252+ B69E 6F               LD L, A
4253+ B69F 26 00            LD H, 0
4254+ B6A1 54               LD D, H
4255+ B6A2 5D               LD E, L
4256+ B6A3 29               ADD HL, HL
4257+ B6A4 29               ADD HL, HL                          ; count × 4
4258+ B6A5 19               ADD HL, DE                          ; count × 5
4259+ B6A6 11 7C 5F         LD DE, PendingEraseSlots
4260+ B6A9 19               ADD HL, DE
4261+ B6AA                  ; Guardar OLDSPRID, OLDX, OLDY + sprite addr
4262+ B6AA DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
4263+ B6AD 77               LD (HL), A
4264+ B6AE 23               INC HL
4265+ B6AF DD 7E 0C         LD A, (IX+ENT_OLDX)
4266+ B6B2 77               LD (HL), A
4267+ B6B3 23               INC HL
4268+ B6B4 DD 7E 0D         LD A, (IX+ENT_OLDY)
4269+ B6B7 77               LD (HL), A
4270+ B6B8 23               INC HL
4271+ B6B9                  ; Resolver sprite addr y guardarla
4272+ B6B9 E5               PUSH HL
4273+ B6BA CD 26 A5         CALL GetOldSpriteAddr               ; DE = sprite ptr (HL trashed)
4274+ B6BD E1               POP HL
4275+ B6BE 73               LD (HL), E
4276+ B6BF 23               INC HL
4277+ B6C0 72               LD (HL), D
4278+ B6C1                  ; Incrementar counter
4279+ B6C1 3A 7B 5F         LD A, (PendingEraseCount)
4280+ B6C4 3C               INC A
4281+ B6C5 32 7B 5F         LD (PendingEraseCount), A
4282+ B6C8 C9               RET
4283+ B6C9
