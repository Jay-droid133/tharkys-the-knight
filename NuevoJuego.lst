 264+ 67C6 CB 3F            SRL A
 264+ 67C8 CB 3F          SRL A
 264+ 67CA CB 3F          SRL A                   ; A = char Y (post-HUD)
 265+ 67CC 26 00            LD H, 0
 266+ 67CE 6F               LD L, A
 267+ 67CF 29               ADD HL, HL                              ; *2
 268+ 67D0 29               ADD HL, HL                              ; *4
 269+ 67D1 29               ADD HL, HL                              ; *8
 270+ 67D2 29               ADD HL, HL                              ; *16
 271+ 67D3 29               ADD HL, HL                              ; *32
 272+ 67D4 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 273+ 67D7 CB 3F            SRL A
 273+ 67D9 CB 3F          SRL A
 273+ 67DB CB 3F          SRL A                   ; A = char X
 274+ 67DD 5F               LD E, A
 275+ 67DE 16 00            LD D, 0
 276+ 67E0 19               ADD HL, DE
 277+ 67E1 11 00 58         LD DE, $5800
 278+ 67E4 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 279+ 67E5 AF               XOR A                                   ; paper black, ink black
 280+ 67E6 77               LD (HL), A                              ; (charY, charX)
 281+ 67E7 23               INC HL
 282+ 67E8 77               LD (HL), A                              ; (charY, charX+1)
 283+ 67E9 11 1F 00         LD DE, 31
 284+ 67EC 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 285+ 67ED 77               LD (HL), A
