 324+ EBBD 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 325+ EBBF 32 CF 82         LD (PlayerSpeedFight), A
 326+ EBC2 21 7D 00         LD HL, SPEED_BUFF_CARACOL_FRAMES
 327+ EBC5 22 D0 82         LD (SpeedBuffTimer), HL
 328+ EBC8 3E 02            LD A, SPEED_BUFF_TYPE_CARACOL
 329+ EBCA 32 D2 82         LD (SpeedBuffType), A
 330+ EBCD 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR
 331+ EBCF 32 99 81         LD (EntityTable + ENT_ATTR), A
 332+ EBD2 C9               RET
 333+ EBD3
 334+ EBD3              ; ==============================================================================
 335+ EBD3              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 336+ EBD3              ; ==============================================================================
 337+ EBD3              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 338+ EBD3              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 339+ EBD3              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 340+ EBD3              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 341+ EBD3              ; ==============================================================================
 342+ EBD3              UpdateSpeedBuffBody:
 343+ EBD3 3A D2 82         LD A, (SpeedBuffType)
 344+ EBD6 B7               OR A
 345+ EBD7 C8               RET Z                               ; sin buff activo
 346+ EBD8                  ; Tick 16-bit timer.
 347+ EBD8 2A D0 82         LD HL, (SpeedBuffTimer)
 348+ EBDB 2B               DEC HL
 349+ EBDC 22 D0 82         LD (SpeedBuffTimer), HL
 350+ EBDF 7C               LD A, H
 351+ EBE0 B5               OR L
 352+ EBE1 28 11            JR Z, .usbExpire
