2383+ D565              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2384+ D565              ; ==============================================================================
2385+ D565              ; IN:  DE = BgGfx pointer
2386+ D565              ; OUT: A = 0 (normal), 1..6 (key), 7..12 (lock con key requerida = A-6)
2387+ D565              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
