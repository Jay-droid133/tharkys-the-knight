 378+ EE29              ; ==============================================================================
 379+ EE29              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EE29              ; ==============================================================================
 381+ EE29              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EE29              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EE29              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EE29              ; ==============================================================================
 385+ EE29              DrawHealthStaminaHUD:
 386+ EE29                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EE29 3A D9 B6         LD A, (PlayerHealth)
 388+ EE2C 4F               LD C, A                             ; C = nivel (0-16)
 389+ EE2D 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EE30 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EE33 DD 21 0F EA      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EE37 FD 21 80 EA      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EE3B CD B2 EE         CALL .drawBar
 394+ EE3E
 395+ EE3E                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EE3E 3A DA B6         LD A, (PlayerStamina)
 397+ EE41 4F               LD C, A
 398+ EE42 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EE45 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EE48 DD 21 13 EA      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EE4C FD 21 84 EA      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EE50 CD B2 EE         CALL .drawBar
 403+ EE53
 404+ EE53                  ; --- Flash de recuperacion del pozo ---
 405+ EE53 3A A1 90         LD A, (WellFlashTimer)
 406+ EE56 B7               OR A
 407+ EE57 28 28            JR Z, .noFlash
 408+ EE59 3D               DEC A
 409+ EE5A 32 A1 90         LD (WellFlashTimer), A
 410+ EE5D                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EE5D E6 04            AND $04
 412+ EE5F 28 20            JR Z, .noFlash
 413+ EE61                  ; Flash blanco brillante en ambas barras + player verde
 414+ EE61 3E 47            LD A, WHITE | $40
 415+ EE63 32 0D 58         LD ($580D), A
 416+ EE66 32 0E 58         LD ($580E), A
 417+ EE69 32 2D 58         LD ($582D), A
 418+ EE6C 32 2E 58         LD ($582E), A
 419+ EE6F 32 11 58         LD ($5811), A
 420+ EE72 32 12 58         LD ($5812), A
 421+ EE75 32 31 58         LD ($5831), A
 422+ EE78 32 32 58         LD ($5832), A
 423+ EE7B 3E 44            LD A, GREEN | $40
 424+ EE7D 32 3B 81         LD (EntityTable + ENT_ATTR), A
 425+ EE80 C9               RET
 426+ EE81              .noFlash:
 427+ EE81                  ; Restaurar color player si estaba en flash verde
 428+ EE81 3A 3B 81         LD A, (EntityTable + ENT_ATTR)
 429+ EE84 FE 44            CP GREEN | $40
 430+ EE86 20 05            JR NZ, .noFlashPlayer
 431+ EE88 3E 47            LD A, WHITE | $40
 432+ EE8A 32 3B 81         LD (EntityTable + ENT_ATTR), A
 433+ EE8D              .noFlashPlayer:
 434+ EE8D                  ; --- Attrs segun nivel (normal) ---
 435+ EE8D                  ; Salud
 436+ EE8D 3A D9 B6         LD A, (PlayerHealth)
 437+ EE90 CD 00 EF         CALL .levelToColor
 438+ EE93 32 0D 58         LD ($580D), A
 439+ EE96 32 0E 58         LD ($580E), A
 440+ EE99 32 2D 58         LD ($582D), A
 441+ EE9C 32 2E 58         LD ($582E), A
 442+ EE9F                  ; Stamina
 443+ EE9F 3A DA B6         LD A, (PlayerStamina)
 444+ EEA2 CD 00 EF         CALL .levelToColor
 445+ EEA5 32 11 58         LD ($5811), A
 446+ EEA8 32 12 58         LD ($5812), A
 447+ EEAB 32 31 58         LD ($5831), A
 448+ EEAE 32 32 58         LD ($5832), A
 449+ EEB1 C9               RET
 450+ EEB2
 451+ EEB2              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 452+ EEB2              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 453+ EEB2              ; IX = puntero al primer byte de la decoracion en sprite data
 454+ EEB2              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 455+ EEB2              ; las (16-C) superiores con $00 (vacio/negro)
 456+ EEB2              .drawBar:
 457+ EEB2 7D               LD A, L
 458+ EEB3 32 FE EE         LD (.dbCol), A                      ; Guardar columna base row 0
 459+ EEB6 7B               LD A, E
 460+ EEB7 32 FF EE         LD (.dbCol1), A                     ; Guardar columna base row 1
 461+ EEBA 06 10            LD B, 16                            ; 16 scanlines totales
 462+ EEBC 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 463+ EEBE                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 464+ EEBE 3E 10            LD A, 16
 465+ EEC0 91               SUB C
 466+ EEC1 5F               LD E, A                             ; E = primera scanline llena
 467+ EEC2              .dbLoop:
 468+ EEC2                  ; Calcular direccion VRAM
 469+ EEC2 7A               LD A, D
 470+ EEC3 FE 08            CP 8
 471+ EEC5 30 09            JR NC, .dbCalcR1
 472+ EEC7                  ; Char row 0
 473+ EEC7 67               LD H, A
 474+ EEC8 CB F4            SET 6, H
 475+ EECA 3A FE EE         LD A, (.dbCol)
 476+ EECD 6F               LD L, A
 477+ EECE 18 09            JR .dbWrite
 478+ EED0              .dbCalcR1:
 479+ EED0                  ; Char row 1
 480+ EED0 D6 08            SUB 8
 481+ EED2 67               LD H, A
 482+ EED3 CB F4            SET 6, H
 483+ EED5 3A FF EE         LD A, (.dbCol1)
 484+ EED8 6F               LD L, A
 485+ EED9              .dbWrite:
 486+ EED9                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 487+ EED9 7A               LD A, D
 488+ EEDA BB               CP E
 489+ EEDB 30 0B            JR NC, .dbFull
 490+ EEDD                  ; Marchito: copiar sprite decayed
 491+ EEDD FD 7E 00         LD A, (IY+0)
 492+ EEE0 77               LD (HL), A
 493+ EEE1 23               INC HL
 494+ EEE2 FD 7E 01         LD A, (IY+1)
 495+ EEE5 77               LD (HL), A
 496+ EEE6 18 09            JR .dbAdvanceSpr
 497+ EEE8              .dbFull:
 498+ EEE8                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 499+ EEE8 DD 7E 00         LD A, (IX+0)
 500+ EEEB 77               LD (HL), A
 501+ EEEC 23               INC HL
 502+ EEED DD 7E 01         LD A, (IX+1)
 503+ EEF0 77               LD (HL), A
 504+ EEF1              .dbAdvanceSpr:
 505+ EEF1                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 506+ EEF1 D5               PUSH DE
 507+ EEF2 11 06 00         LD DE, 6
 508+ EEF5 DD 19            ADD IX, DE
 509+ EEF7 FD 19            ADD IY, DE
 510+ EEF9 D1               POP DE
 511+ EEFA 14               INC D
 512+ EEFB 10 C5            DJNZ .dbLoop
 513+ EEFD C9               RET
 514+ EEFE
 515+ EEFE 00           .dbCol:  DEFB 0
 516+ EEFF 00           .dbCol1: DEFB 0
 517+ EF00
 518+ EF00              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 519+ EF00              .levelToColor:
 520+ EF00 FE 0C            CP 12
 521+ EF02 30 11            JR NC, .lcGreen
 522+ EF04 FE 07            CP 7
 523+ EF06 30 0A            JR NC, .lcCyan
 524+ EF08 FE 03            CP 3
 525+ EF0A 30 03            JR NC, .lcYellow
 526+ EF0C 3E 42            LD A, RED | $40                     ; 0-2: rojo
 527+ EF0E C9               RET
 528+ EF0F              .lcYellow:
 529+ EF0F 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 530+ EF11 C9               RET
 531+ EF12              .lcCyan:
 532+ EF12 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 533+ EF14 C9               RET
 534+ EF15              .lcGreen:
 535+ EF15 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 536+ EF17 C9               RET
 537+ EF18
 538+ EF18              ; ==============================================================================
 539+ EF18              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 540+ EF18              ; ==============================================================================
 541+ EF18              ; Entrada: A = posición (0-11), HL = tabla de punteros
 542+ EF18              ; ==============================================================================
 543+ EF18              DrawHandLine:
 544+ EF18 87               ADD A, A
 545+ EF19 4F               LD C, A
 546+ EF1A 06 00            LD B, 0
 547+ EF1C 09               ADD HL, BC
 548+ EF1D 7E               LD A, (HL)
 549+ EF1E 23               INC HL
 550+ EF1F 66               LD H, (HL)
 551+ EF20 6F               LD L, A             ; HL = puntero a datos de línea
 552+ EF21
 553+ EF21              .pixLoop:
 554+ EF21 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 555+ EF22 B7               OR A
 556+ EF23 C8               RET Z
 557+ EF24 57               LD D, A
 558+ EF25 23               INC HL
 559+ EF26 7E               LD A, (HL)          ; VRAM L
 560+ EF27 23               INC HL
 561+ EF28 5F               LD E, A
 562+ EF29 7E               LD A, (HL)          ; mask
 563+ EF2A 23               INC HL
 564+ EF2B E5               PUSH HL
 565+ EF2C 2F               CPL                 ; ~mask
 566+ EF2D 62               LD H, D
 567+ EF2E 6B               LD L, E
 568+ EF2F A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 569+ EF30 77               LD (HL), A
 570+ EF31 E1               POP HL
 571+ EF32 18 ED            JR .pixLoop
 572+ EF34
 573+ EF34              ; ==============================================================================
 574+ EF34              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 575+ EF34              ; ==============================================================================
 576+ EF34              CheckClockSpeedKeys:
 577+ EF34 3E F7            LD A, $F7
 578+ EF36 DB FE            IN A, ($FE)
 579+ EF38 2F               CPL
 580+ EF39 E6 07            AND $07
 581+ EF3B
 582+ EF3B 47               LD B, A
 583+ EF3C 3A F3 EA         LD A, (ClockDebounce)
 584+ EF3F 4F               LD C, A
 585+ EF40 78               LD A, B
 586+ EF41 32 F3 EA         LD (ClockDebounce), A
 587+ EF44 78               LD A, B
 588+ EF45
 589+ EF45 79               LD A, C
 590+ EF46 2F               CPL
 591+ EF47 A0               AND B
 592+ EF48 C8               RET Z
 593+ EF49
 594+ EF49 CB 47            BIT 0, A
 595+ EF4B 28 06            JR Z, .try2
 596+ EF4D 3E 01            LD A, 1
 597+ EF4F 32 F2 EA         LD (SubMinuteMax), A
 598+ EF52 C9               RET
 599+ EF53              .try2:
 600+ EF53 CB 4F            BIT 1, A
 601+ EF55 28 06            JR Z, .try3
 602+ EF57 3E 05            LD A, 5
 603+ EF59 32 F2 EA         LD (SubMinuteMax), A
 604+ EF5C C9               RET
 605+ EF5D              .try3:
