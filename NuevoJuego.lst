 357+ E5D5              ; --- Track 2: EndGameMusic ---
 358+ E5D5              ; Fanfarria de victoria, mayor, ~6s. Borrador inicial — iterar.
 359+ E5D5              EndGameMusicTable:
 360+ E5D5 2E 02            DEFW $022E                      ; G3
 361+ E5D7 04               DEFB 4                          ; corchea
 362+ E5D8 2E 02            DEFW $022E                      ; G3
 363+ E5DA 04               DEFB 4
 364+ E5DB 2E 02            DEFW $022E                      ; G3
 365+ E5DD 04               DEFB 4
 366+ E5DE A2 01            DEFW $01A2                      ; C4
 367+ E5E0 0C               DEFB 12                         ; negra punteada
 368+ E5E1 4C 01            DEFW $014C                      ; E4
 369+ E5E3 08               DEFB 8
 370+ E5E4 A2 01            DEFW $01A2                      ; C4
 371+ E5E6 04               DEFB 4
 372+ E5E7 4C 01            DEFW $014C                      ; E4
 373+ E5E9 10               DEFB 16                         ; blanca
 374+ E5EA 17 01            DEFW $0117                      ; G4
 375+ E5EC 04               DEFB 4
 376+ E5ED 4C 01            DEFW $014C                      ; E4
 377+ E5EF 04               DEFB 4
 378+ E5F0 A2 01            DEFW $01A2                      ; C4
 379+ E5F2 04               DEFB 4
 380+ E5F3 17 01            DEFW $0117                      ; G4
 381+ E5F5 1E               DEFB 30                         ; final largo brillante
 382+ E5F6 00 00            DEFW 0
 383+ E5F8 00               DEFB 0
 384+ E5F9
 385+ E5F9              ; --- Track 3: GameOverMusic ---
 386+ E5F9              ; Descenso menor, somber, ~2.5s. Borrador inicial — iterar.
 387+ E5F9              GameOverMusicTable:
 388+ E5F9 F1 01            DEFW $01F1                      ; A3  ~220 Hz
 389+ E5FB 0A               DEFB 10
 390+ E5FC 2E 02            DEFW $022E                      ; G3
 391+ E5FE 0A               DEFB 10
 392+ E5FF 72 02            DEFW $0272                      ; F3
 393+ E601 0A               DEFB 10
 394+ E602 97 02            DEFW $0297                      ; E3
 395+ E604 0A               DEFB 10
 396+ E605 E9 02            DEFW $02E9                      ; D3
 397+ E607 0C               DEFB 12
 398+ E608 44 03            DEFW $0344                      ; C3 (resolucion grave)
