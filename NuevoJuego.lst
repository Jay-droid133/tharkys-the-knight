 530+ FB6F DD 77 00         LD (IX+ENT_SPRITEID), A
 531+ FB72 DD 77 08         LD (IX+ENT_ANIMBASE), A
 532+ FB75 AF               XOR A
 533+ FB76 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 534+ FB79 CD 9E 65         CALL TownGateRedrawPlayer
 535+ FB7C 3E 28            LD A, BCS_T_TURN_CAM
 536+ FB7E 32 CA 82         LD (BankCutsceneTimer), A
 537+ FB81 3E 06            LD A, BCP_TURN_TO_CAM
 538+ FB83 32 C9 82         LD (BankCutscenePhase), A
 539+ FB86 C9               RET
 540+ FB87
 541+ FB87              ; ---- Phase 6: player mirando camara mid-cutscene ----
 542+ FB87              .bcPhTurnToCam:
 543+ FB87 CD F7 FD         CALL BankCutsceneDecTimer
 544+ FB8A C0               RET NZ
 545+ FB8B                  ; Player vuelve a N (cara puerta).
 546+ FB8B DD 21 9B 81      LD IX, EntityTable
 547+ FB8F 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 548+ FB91 DD 77 00         LD (IX+ENT_SPRITEID), A
 549+ FB94 3E 0A            LD A, SPRID_WALK_N
 550+ FB96 DD 77 08         LD (IX+ENT_ANIMBASE), A
 551+ FB99 AF               XOR A
 552+ FB9A DD 77 09         LD (IX+ENT_ANIMTIMER), A
 553+ FB9D CD 9E 65         CALL TownGateRedrawPlayer
 554+ FBA0 3E 0A            LD A, BCS_T_TURN_BACK
 555+ FBA2 32 CA 82         LD (BankCutsceneTimer), A
 556+ FBA5 3E 07            LD A, BCP_TURN_TO_DOOR
 557+ FBA7 32 C9 82         LD (BankCutscenePhase), A
 558+ FBAA C9               RET
