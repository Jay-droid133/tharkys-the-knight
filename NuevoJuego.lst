1203+ EDD8              ; ==============================================================================
1204+ EDD8              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1205+ EDD8              ; ==============================================================================
1206+ EDD8              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1207+ EDD8              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1208+ EDD8              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1209+ EDD8              ; ==============================================================================
1210+ EDD8              ChurchCutsceneInitStatueShake:
1211+ EDD8 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1212+ EDDB 21 DE EF         LD HL, StatueIdTable
1213+ EDDE 5F               LD E, A
1214+ EDDF 16 00            LD D, 0
1215+ EDE1 19               ADD HL, DE
1216+ EDE2 7E               LD A, (HL)                              ; A = statue id
1217+ EDE3 B7               OR A
1218+ EDE4 C8               RET Z                                   ; sin estatua
1219+ EDE5 32 15 EE         LD (.cisTargetId), A
1220+ EDE8                  ; Buscar en CurrentScreenBuffer
1221+ EDE8 2A 57 82         LD HL, (CurrentScreenAddr)
1222+ EDEB              .cisLoop:
1223+ EDEB 7E               LD A, (HL)
1224+ EDEC FE FF            CP $FF
1225+ EDEE C8               RET Z                                   ; no encontrada (no se hace shake)
1226+ EDEF 47               LD B, A
1227+ EDF0 3A 15 EE         LD A, (.cisTargetId)
1228+ EDF3 B8               CP B
1229+ EDF4 28 06            JR Z, .cisFound
1230+ EDF6 11 04 00         LD DE, 4
1231+ EDF9 19               ADD HL, DE
1232+ EDFA 18 EF            JR .cisLoop
1233+ EDFC              .cisFound:
1234+ EDFC 23               INC HL
1235+ EDFD 7E               LD A, (HL)                              ; charX
1236+ EDFE                  ; Pixel X = charX * 8
1237+ EDFE 87               ADD A, A
1238+ EDFF 87               ADD A, A
1239+ EE00 87               ADD A, A
1240+ EE01 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1241+ EE04 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1242+ EE07 23               INC HL
1243+ EE08 7E               LD A, (HL)                              ; charY
1244+ EE09                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1245+ EE09 C6 02            ADD A, BG_Y_OFFSET
1246+ EE0B 87               ADD A, A
1247+ EE0C 87               ADD A, A
1248+ EE0D 87               ADD A, A
1249+ EE0E 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1250+ EE11 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1251+ EE14 C9               RET
1252+ EE15 00           .cisTargetId: DEFB 0
