 461+ A083 28 16            JR Z, .peSkip
 462+ A085
 463+ A085                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 464+ A085 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 465+ A089 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 466+ A08A
 467+ A08A                  ; Procesar esta entidad completa (erase + logic + draw)
 468+ A08A CD A4 A0         CALL ProcessOneEnemy
