1000+ D567 78               LD A, B
1001+ D568 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1002+ D56A D5               PUSH DE
1003+ D56B 57               LD D, A
1004+ D56C 79               LD A, C                     ; A = tintVar (0-7)
1005+ D56D 07               RLCA
1006+ D56E 07               RLCA
1007+ D56F 07               RLCA                        ; A = 00PPP000
1008+ D570 B2               OR D                        ; A = FBPPPIII
1009+ D571 D1               POP DE
1010+ D572 C1               POP BC
1011+ D573 C9               RET
1012+ D574              .tintNoChange:
1013+ D574 78               LD A, B                     ; devolver sin cambio
1014+ D575 C1               POP BC
1015+ D576 C9               RET
