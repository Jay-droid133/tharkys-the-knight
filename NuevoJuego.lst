7051+ C661              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
7052+ C661              UpdateDeathTimer:
7053+ C661                  IF DEBUG_NO_ENEMIES
7054+ C661 ~                RET
7055+ C661                  ENDIF
7056+ C661 3A FA 82         LD A, (DeathSpawned)
7057+ C664 B7               OR A
7058+ C665 C0               RET NZ                              ; ya spawneada: nada que hacer
7059+ C666                  ; Inhibida en esta sala (puerta de iglesia abierta -> cinematica de
7060+ C666                  ; captura corre sin interferencia). Se limpia al cambiar de sala.
7061+ C666 3A F9 82         LD A, (DeathInhibitInRoom)
7062+ C669 B7               OR A
7063+ C66A C0               RET NZ
7064+ C66B                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
7065+ C66B                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
7066+ C66B                  ; arranca de cero al recuperar el control (urb1LastBeat).
7067+ C66B 3A E7 82         LD A, (DeathBorderPhase)
7068+ C66E B7               OR A
