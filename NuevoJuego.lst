# file opened: sound.asm
   1+ F9B9              ; ==============================================================================
   2+ F9B9              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F9B9              ; ==============================================================================
   4+ F9B9              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F9B9              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F9B9              ;
   7+ F9B9              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F9B9              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F9B9              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F9B9              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F9B9              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F9B9              ; ==============================================================================
  13+ F9B9
  14+ F9B9              ; ==============================================================================
  15+ F9B9              ; PlaySFX - Reproduce un efecto de sonido
  16+ F9B9              ; ==============================================================================
  17+ F9B9              ; Entrada: HL = puntero a datos del efecto
  18+ F9B9              ; Modifica: AF, BC, DE, HL
  19+ F9B9              ; ==============================================================================
  20+ F9B9              PlaySFX:
  21+ F9B9 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F9BA 3A 8B 8D         LD A, (CurrentBorderColor)
  23+ F9BD E6 07            AND $07                     ; Solo bits de color del borde
  24+ F9BF 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F9C0
  26+ F9C0              .nextStep:
  27+ F9C0 7E               LD A, (HL)                  ; Leer duration
  28+ F9C1 B7               OR A
  29+ F9C2 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F9C4
  31+ F9C4 47               LD B, A                     ; B = duration (bucle externo)
  32+ F9C5 23               INC HL
  33+ F9C6 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F9C7 23               INC HL
  35+ F9C8 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F9C9 23               INC HL
  37+ F9CA 7E               LD A, (HL)                  ; A = flags
  38+ F9CB 23               INC HL
  39+ F9CC E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F9CD CB 47            BIT 0, A
  41+ F9CF 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F9D1
  43+ F9D1              ; --- Bucle de tono normal ---
  44+ F9D1              .toneLoop:
  45+ F9D1                  ; Semi-periodo HIGH
  46+ F9D1 7B               LD A, E
  47+ F9D2 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F9D4 D3 FE            OUT ($FE), A
  49+ F9D6 79               LD A, C                     ; A = pitch actual
  50+ F9D7              .toneDelayHi:
  51+ F9D7 3D               DEC A
  52+ F9D8 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F9DA
  54+ F9DA                  ; Semi-periodo LOW
  55+ F9DA 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F9DB D3 FE            OUT ($FE), A
  57+ F9DD 79               LD A, C
  58+ F9DE              .toneDelayLo:
  59+ F9DE 3D               DEC A
  60+ F9DF 20 FD            JR NZ, .toneDelayLo
  61+ F9E1
  62+ F9E1                  ; Aplicar pitch sweep
  63+ F9E1 79               LD A, C
  64+ F9E2 82               ADD A, D                    ; pitch += pitchDelta
  65+ F9E3 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F9E5 FA ED F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F9E8 4F               LD C, A
  68+ F9E9              .toneAfterClamp:
  69+ F9E9 10 E6            DJNZ .toneLoop
  70+ F9EB 18 30            JR .stepDone
  71+ F9ED
  72+ F9ED              .toneClamp:
  73+ F9ED 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F9EF 18 F8            JR .toneAfterClamp
  75+ F9F1
  76+ F9F1              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F9F1              .noiseLoop:
  78+ F9F1                  ; Semi-periodo HIGH con ruido
  79+ F9F1 7B               LD A, E
  80+ F9F2 F6 10            OR $10
  81+ F9F4 D3 FE            OUT ($FE), A
  82+ F9F6 ED 5F            LD A, R                     ; R register como PRNG
  83+ F9F8 A9               XOR C                       ; mezclar con pitch base
  84+ F9F9 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F9FB F6 01            OR $01                      ; minimo 1
  86+ F9FD              .noiseDelayHi:
  87+ F9FD 3D               DEC A
  88+ F9FE 20 FD            JR NZ, .noiseDelayHi
  89+ FA00
  90+ FA00                  ; Semi-periodo LOW
  91+ FA00 7B               LD A, E
  92+ FA01 D3 FE            OUT ($FE), A
  93+ FA03 ED 5F            LD A, R
  94+ FA05 A9               XOR C
  95+ FA06 E6 1F            AND $1F
  96+ FA08 F6 01            OR $01
  97+ FA0A              .noiseDelayLo:
  98+ FA0A 3D               DEC A
  99+ FA0B 20 FD            JR NZ, .noiseDelayLo
 100+ FA0D
 101+ FA0D                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ FA0D 79               LD A, C
 103+ FA0E 82               ADD A, D
 104+ FA0F 28 08            JR Z, .noiseClamp
 105+ FA11 FA 19 FA         JP M, .noiseClamp
 106+ FA14 4F               LD C, A
 107+ FA15              .noiseAfterClamp:
 108+ FA15 10 DA            DJNZ .noiseLoop
 109+ FA17 18 04            JR .stepDone
 110+ FA19
 111+ FA19              .noiseClamp:
 112+ FA19 0E 01            LD C, 1
 113+ FA1B 18 F8            JR .noiseAfterClamp
 114+ FA1D
 115+ FA1D              .stepDone:
 116+ FA1D E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ FA1E 18 A0            JR .nextStep
 118+ FA20
 119+ FA20              .done:
 120+ FA20 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ FA21 D3 FE            OUT ($FE), A
 122+ FA23 FB               EI
 123+ FA24 C9               RET
