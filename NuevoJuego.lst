2857+ B21D D1               POP DE
2858+ B21E 20 09            JR NZ, .moKbSlideY
2859+ B220                  ; Slide en X funciona
2860+ B220 1E 00            LD E, 0
2861+ B222 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2862+ B226 C3 42 B2         JP .moKbApply
2863+ B229              .moKbSlideY:
2864+ B229                  ; Intentar solo eje Y (mantener direccion del golpe)
2865+ B229 7B               LD A, E
2866+ B22A B7               OR A
2867+ B22B 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2868+ B22D D5               PUSH DE
2869+ B22E 16 00            LD D, 0
2870+ B230 CD 19 B5         CALL .moTryPassable
2871+ B233 D1               POP DE
2872+ B234 20 09            JR NZ, .moKbSlideStop
2873+ B236                  ; Slide en Y funciona
2874+ B236 16 00            LD D, 0
2875+ B238 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2876+ B23C C3 42 B2         JP .moKbApply
2877+ B23F              .moKbSlideStop:
