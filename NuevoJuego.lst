6532+ C710 0F               RRCA
6533+ C711 0F               RRCA
6534+ C712 E6 1F            AND $1F
6535+ C714 32 74 5F         LD (DBfsCurCx), A
6536+ C717 DD 7E 04         LD A, (IX+ENT_POSY)
6537+ C71A D6 10            SUB SCREEN_MIN_Y
6538+ C71C 0F               RRCA
6539+ C71D 0F               RRCA
6540+ C71E 0F               RRCA
6541+ C71F E6 1F            AND $1F
6542+ C721 32 75 5F         LD (DBfsCurCy), A
6543+ C724                  ; --- Celda del player ---
6544+ C724 3A 17 81         LD A, (EntityTable + ENT_POSX)
6545+ C727 0F               RRCA
6546+ C728 0F               RRCA
6547+ C729 0F               RRCA
6548+ C72A E6 1F            AND $1F
