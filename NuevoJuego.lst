2444+ B03F
2445+ B03F                  ; Aplicar movimiento Y
2446+ B03F DD 7E 04         LD A, (IX+ENT_POSY)
2447+ B042 DD 86 07         ADD A, (IX+ENT_DELTAY)
2448+ B045 FE A8            CP SCREEN_MAX_Y
2449+ B047 30 2B            JR NC, .paRevert                    ; Fuera de rango Y
2450+ B049 FE 10            CP SCREEN_MIN_Y
2451+ B04B 38 27            JR C, .paRevert
2452+ B04D DD 77 04         LD (IX+ENT_POSY), A
2453+ B050
2454+ B050                  ; Comprobar colision con fondo
2455+ B050 CD 44 BA         CALL CheckEnemyCollision
2456+ B053 20 1F            JR NZ, .paRevert                    ; Choco con pared
2457+ B055
2458+ B055                  ; --- Animacion durante ataque ---
2459+ B055 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2460+ B058 20 19            JR NZ, .paAnimDone
2461+ B05A 3E 04            LD A, 4                             ; Delay fijo rapido durante ataque
2462+ B05C DD 77 09         LD (IX+ENT_ANIMTIMER), A
2463+ B05F DD 7E 00         LD A, (IX+ENT_SPRITEID)
2464+ B062 DD 96 08         SUB (IX+ENT_ANIMBASE)
2465+ B065 E6 01            AND 1
2466+ B067 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2467+ B06A 20 03            JR NZ, .paFrame1
