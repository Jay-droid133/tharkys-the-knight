2718+ ADD8              ; ==============================================================================
2719+ ADD8              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2720+ ADD8              ; ==============================================================================
2721+ ADD8              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2722+ ADD8              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2723+ ADD8              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2724+ ADD8              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2725+ ADD8              ; ==============================================================================
2726+ ADD8              UpdateMonster:
2727+ ADD8                  ; --- Stun: knockback + pausa tras golpe del player ---
2728+ ADD8 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2729+ ADDB B7               OR A
2730+ ADDC CA 11 B0         JP Z, .moNormal
2731+ ADDF DD 35 0A         DEC (IX+ENT_DIR)
2732+ ADE2 20 0B            JR NZ, .moStunActive
2733+ ADE4                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2734+ ADE4 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2735+ ADE8 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2736+ ADEC C3 11 B0         JP .moNormal
2737+ ADEF
2738+ ADEF              .moStunActive:
2739+ ADEF                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2740+ ADEF FE 06            CP MONSTER_STUN_PAUSE
2741+ ADF1 DA A2 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2742+ ADF4                  ; Knockback: aplicar movimiento con collision check
2743+ ADF4 DD 56 06         LD D, (IX+ENT_DELTAX)
2744+ ADF7 DD 5E 07         LD E, (IX+ENT_DELTAY)
2745+ ADFA 7A               LD A, D
2746+ ADFB B3               OR E
2747+ ADFC CA A2 B1         JP Z, .moAnimate
2748+ ADFF                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2749+ ADFF D5               PUSH DE
2750+ AE00 DD 7E 03         LD A, (IX+ENT_POSX)
2751+ AE03 32 3A B3         LD (.moSvX), A
2752+ AE06 DD 7E 04         LD A, (IX+ENT_POSY)
2753+ AE09 32 3B B3         LD (.moSvY), A
2754+ AE0C                  ; Calcular nueva posicion
2755+ AE0C DD 7E 03         LD A, (IX+ENT_POSX)
2756+ AE0F 82               ADD A, D
2757+ AE10 DD 77 03         LD (IX+ENT_POSX), A
2758+ AE13 DD 7E 04         LD A, (IX+ENT_POSY)
2759+ AE16 83               ADD A, E
2760+ AE17 DD 77 04         LD (IX+ENT_POSY), A
2761+ AE1A                  ; Comprobar bordes ANTES de colision con paredes
