 974+ D1F8              ; ==============================================================================
 975+ D1F8              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 976+ D1F8              ; ==============================================================================
 977+ D1F8              ; Entrada: A = attr byte
 978+ D1F8              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 979+ D1F8              ; Preserva: HL, DE, BC, IX
 980+ D1F8              ; ==============================================================================
 981+ D1F8              ApplyTintSwap:
 982+ D1F8 C5               PUSH BC
 983+ D1F9 47               LD B, A                     ; B = attr original
 984+ D1FA 3A F4 D1         LD A, (CurrentTintVar)
 985+ D1FD FE FF            CP $FF
 986+ D1FF 28 24            JR Z, .tintNoChange
 987+ D201 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 988+ D202 3A F5 D1         LD A, (CurrentTintPaper)
 989+ D205 FE FF            CP $FF
 990+ D207 28 1C            JR Z, .tintNoChange
 991+ D209                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 992+ D209                  ; Extraer paper del attr: bits 5-3
 993+ D209 78               LD A, B
 994+ D20A E6 38            AND $38                     ; A = 00PPP000
 995+ D20C 0F               RRCA
 996+ D20D 0F               RRCA
 997+ D20E 0F               RRCA                        ; A = 00000PPP = paper actual
 998+ D20F D5               PUSH DE
 999+ D210 57               LD D, A                     ; D = paper actual
1000+ D211 3A F5 D1         LD A, (CurrentTintPaper)
1001+ D214 BA               CP D                        ; paper actual == tintPaper?
1002+ D215 D1               POP DE
1003+ D216 20 0D            JR NZ, .tintNoChange
1004+ D218                  ; Match: reemplazar paper bits con tintVar
1005+ D218 78               LD A, B
1006+ D219 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1007+ D21B D5               PUSH DE
1008+ D21C 57               LD D, A
1009+ D21D 79               LD A, C                     ; A = tintVar (0-7)
1010+ D21E 07               RLCA
1011+ D21F 07               RLCA
1012+ D220 07               RLCA                        ; A = 00PPP000
1013+ D221 B2               OR D                        ; A = FBPPPIII
1014+ D222 D1               POP DE
1015+ D223 C1               POP BC
1016+ D224 C9               RET
