1186+ 662C C9           SFX_TownGate_OnFingerIn:        RET
1187+ 662D C9           SFX_TownGate_OnShake:           RET
1188+ 662E C9           SFX_TownGate_OnFingerPulse:     RET
1189+ 662F C9           SFX_TownGate_OnFingerOut:       RET
1190+ 6630 C9           SFX_TownGate_OnArmOut:          RET
1191+ 6631 C9           SFX_TownGate_OnPlayerTurn:      RET
1192+ 6632 C9           SFX_TownGate_OnPlayerFramed:    RET
1193+ 6633 C9           SFX_TownGate_OnPlayerExit:      RET
