 148+ F19D              SFX_EnemyDeath:
 149+ F19D 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ F1A1 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ F1A5 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ F1A9 00               DEFB 0                      ; fin
 153+ F1AA
 154+ F1AA              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
