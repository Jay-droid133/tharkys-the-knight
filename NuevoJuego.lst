 462+ A0CD              ; ==============================================================================
 463+ A0CD              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 464+ A0CD              ; ==============================================================================
 465+ A0CD              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 466+ A0CD              ; ==============================================================================
 467+ A0CD              ProcessOneEnemy:
 468+ A0CD                  ; --- Dispatch segun estado ---
 469+ A0CD DD 7E 02         LD A, (IX+ENT_STATE)
 470+ A0D0 FE 03            CP STATE_DYING
 471+ A0D2 CA 32 A3         JP Z, .peDying
 472+ A0D5 FE 04            CP STATE_SPAWNING
 473+ A0D7 CA 9B A3         JP Z, .peSpawning
 474+ A0DA FE 05            CP STATE_SCARED
 475+ A0DC CA 0F A2         JP Z, .peScared
 476+ A0DF FE 06            CP STATE_ATTACKING
 477+ A0E1 CA 02 A2         JP Z, .peAttacking
 478+ A0E4
 479+ A0E4                  ; === STATE_RUNNING ===
 480+ A0E4                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 481+ A0E4 3A F9 B4         LD A, (ScareTimer)
 482+ A0E7 B7               OR A
 483+ A0E8 28 1E            JR Z, .peRunning
 484+ A0EA DD 7E 01         LD A, (IX+ENT_TYPE)
 485+ A0ED FE 03            CP TYPE_NASTY
 486+ A0EF 28 08            JR Z, .peDoScare
 487+ A0F1 FE 02            CP TYPE_MONSTER
 488+ A0F3 20 13            JR NZ, .peRunning
