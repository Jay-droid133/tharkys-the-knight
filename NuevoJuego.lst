 231  A17C                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A17C              ; ==============================================================================
   2+ A17C              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A17C              ; ==============================================================================
   4+ A17C              ; - Estructura de entidad de 12 bytes (universal)
   5+ A17C              ; - Game loop per-entity: erase → update → draw
   6+ A17C              ; - Movimiento 8-bit (sin subpixel)
   7+ A17C              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A17C              ; - XOR draw/erase (una sola rutina)
   9+ A17C              ; ==============================================================================
  10+ A17C
  11+ A17C              ; ==============================================================================
  12+ A17C              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A17C              ; ==============================================================================
  14+ A17C              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A17C              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A17C              ; ==============================================================================
  17+ A17C              ReadInput:
  18+ A17C 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A17E 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A180
  21+ A180                  ; -- 1. QAOP --
  22+ A180 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A183 ED 78            IN A, (C)
  24+ A185 CB 47            BIT 0, A            ; Q = Arriba
  25+ A187 20 02            JR NZ, .no_q
  26+ A189 CB C2            SET 0, D
  27+ A18B              .no_q:
  28+ A18B 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A18E ED 78            IN A, (C)
  30+ A190 CB 47            BIT 0, A            ; A = Abajo
  31+ A192 20 02            JR NZ, .no_a
  32+ A194 CB CA            SET 1, D
  33+ A196              .no_a:
  34+ A196 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A199 ED 78            IN A, (C)
  36+ A19B CB 4F            BIT 1, A            ; O = Izquierda
  37+ A19D 20 02            JR NZ, .no_o
  38+ A19F CB DA            SET 3, D
  39+ A1A1              .no_o:
  40+ A1A1 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A1A3 20 02            JR NZ, .no_p
  42+ A1A5 CB D2            SET 2, D
  43+ A1A7              .no_p:
  44+ A1A7
  45+ A1A7                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A1A7                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A1A7 DB 1F            IN A, (31)
  48+ A1A9 4F               LD C, A             ; guardar para fire
  49+ A1AA CB 5F            BIT 3, A            ; Up
  50+ A1AC 28 02            JR Z, .no_k_up
  51+ A1AE CB C2            SET 0, D
  52+ A1B0              .no_k_up:
  53+ A1B0 CB 57            BIT 2, A            ; Down
  54+ A1B2 28 02            JR Z, .no_k_down
  55+ A1B4 CB CA            SET 1, D
  56+ A1B6              .no_k_down:
  57+ A1B6 CB 4F            BIT 1, A            ; Left
  58+ A1B8 28 02            JR Z, .no_k_left
  59+ A1BA CB DA            SET 3, D
  60+ A1BC              .no_k_left:
  61+ A1BC CB 47            BIT 0, A            ; Right
  62+ A1BE 28 02            JR Z, .no_k_right
  63+ A1C0 CB D2            SET 2, D
  64+ A1C2              .no_k_right:
  65+ A1C2 CB 61            BIT 4, C            ; Kempston Fire
  66+ A1C4 28 02            JR Z, .no_k_fire
  67+ A1C6 CB C3            SET 0, E
  68+ A1C8              .no_k_fire:
  69+ A1C8
  70+ A1C8                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A1C8                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A1C8 01 FE F7         LD BC, $F7FE
  73+ A1CB ED 78            IN A, (C)
  74+ A1CD CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A1CF 20 02            JR NZ, .no_s1_up
  76+ A1D1 CB C2            SET 0, D
  77+ A1D3              .no_s1_up:
  78+ A1D3 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A1D5 20 02            JR NZ, .no_s1_down
  80+ A1D7 CB CA            SET 1, D
  81+ A1D9              .no_s1_down:
  82+ A1D9 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A1DB 20 02            JR NZ, .no_s1_left
  84+ A1DD CB DA            SET 3, D
  85+ A1DF              .no_s1_left:
  86+ A1DF CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A1E1 20 02            JR NZ, .no_s1_right
  88+ A1E3 CB D2            SET 2, D
  89+ A1E5              .no_s1_right:
  90+ A1E5 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A1E7 20 02            JR NZ, .no_s1_fire
  92+ A1E9 CB C3            SET 0, E
  93+ A1EB              .no_s1_fire:
  94+ A1EB
  95+ A1EB                  ; -- 4. SPACE = Fire (teclado) --
  96+ A1EB 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A1EE ED 78            IN A, (C)
  98+ A1F0 CB 47            BIT 0, A            ; SPACE
  99+ A1F2 20 02            JR NZ, .no_space
 100+ A1F4 CB C3            SET 0, E
 101+ A1F6              .no_space:
 102+ A1F6
 103+ A1F6                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A1F6 7B               LD A, E
 105+ A1F7 32 D8 81         LD (InputFire), A
 106+ A1FA
 107+ A1FA                  ; -- 6. Cancelar opuestos --
 108+ A1FA 7A               LD A, D
 109+ A1FB 47               LD B, A
 110+ A1FC E6 03            AND DIR_N | DIR_S
 111+ A1FE FE 03            CP DIR_N | DIR_S
 112+ A200 20 04            JR NZ, .noVC
 113+ A202 78               LD A, B
 114+ A203 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ A205 47               LD B, A
 116+ A206              .noVC:
 117+ A206 78               LD A, B
 118+ A207 E6 0C            AND DIR_E | DIR_W
 119+ A209 FE 0C            CP DIR_E | DIR_W
 120+ A20B 20 04            JR NZ, .noHC
 121+ A20D 78               LD A, B
 122+ A20E E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ A210 47               LD B, A
 124+ A211              .noHC:
 125+ A211 78               LD A, B
 126+ A212 32 D7 81         LD (InputDirection), A
 127+ A215 C9               RET
 128+ A216
 129+ A216              ; ==============================================================================
 130+ A216              ; InitEntities - Inicializa la tabla de entidades
 131+ A216              ; ==============================================================================
 132+ A216              ; Limpia todos los slots y configura el slot 0 como player.
 133+ A216              ; ==============================================================================
 134+ A216              InitEntities:
 135+ A216                  ; Limpiar toda la tabla a ceros
 136+ A216 21 C7 80         LD HL, EntityTable
 137+ A219 11 C8 80         LD DE, EntityTable + 1
 138+ A21C 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ A21F AF               XOR A
 140+ A220 77               LD (HL), A
 141+ A221 ED B0            LDIR
 142+ A223
 143+ A223                  ; Limpiar tabla de atributos salvados
 144+ A223 21 99 9F         LD HL, SavedAttrTable
 145+ A226 11 9A 9F         LD DE, SavedAttrTable + 1
 146+ A229 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ A22C AF               XOR A
 148+ A22D 77               LD (HL), A
 149+ A22E ED B0            LDIR
 150+ A230
 151+ A230                  ; Configurar slot 0: Player
 152+ A230 DD 21 C7 80      LD IX, EntityTable
 153+ A234 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ A238 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ A23C DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ A240 DD 36 03 68      LD (IX+ENT_POSX), START_PLAYER_X
 157+ A244 DD 36 04 40      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ A248 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ A24C DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ A250 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ A254 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ A258 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ A25C DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ A260 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ A264 DD 36 0C 68      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ A268 DD 36 0D 40      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ A26C DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ A270 DD 36 0F 68      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ A274
 170+ A274                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ A274 3E 0C            LD A, SPAWN_INTERVAL
 172+ A276 32 F7 81         LD (SpawnTimer), A
 173+ A279 AF               XOR A
 174+ A27A 32 02 82         LD (EnemyStepIdx), A
 175+ A27D 32 7B 5F         LD (PendingEraseCount), A
 176+ A280 C9               RET
 177+ A281
 178+ A281              ; ==============================================================================
 179+ A281              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ A281              ; ==============================================================================
 181+ A281              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ A281              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ A281              ; que los pies parezcan hundirse en el suelo.
 184+ A281              ; ==============================================================================
 185+ A281              ComputePlayerDrawY:
 186+ A281 3A CA 80         LD A, (EntityTable + ENT_POSX)
 187+ A284 C6 08            ADD A, 8                    ; center X del player
 188+ A286 47               LD B, A
 189+ A287 3A CB 80         LD A, (EntityTable + ENT_POSY)
 190+ A28A 4F               LD C, A
 191+ A28B 32 F5 81         LD (PlayerDrawY), A         ; default: sin offset
 192+ A28E B7               OR A
 193+ A28F C8               RET Z
 194+ A290 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ A291 CD 88 D1         CALL IsPointBlocked
 196+ A294 C8               RET Z                       ; libre → sin offset
 197+ A295 3A CB 80         LD A, (EntityTable + ENT_POSY)
 198+ A298 3C               INC A
 199+ A299 32 F5 81         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ A29C C9               RET
 201+ A29D
 202+ A29D              ; ==============================================================================
 203+ A29D              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ A29D              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ A29D              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ A29D              ; no parecer que se hunde en el techo.
 207+ A29D              ; Preserva: IX. Destruye: AF, BC.
 208+ A29D              ; ==============================================================================
 209+ A29D              ComputeEnemyDrawY:
 210+ A29D DD 7E 04         LD A, (IX+ENT_POSY)
 211+ A2A0 32 F6 81         LD (EnemyDrawY), A          ; default = POSY
 212+ A2A3 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ A2A6 FE 02            CP TYPE_MONSTER
 214+ A2A8 C0               RET NZ                      ; no monster → sin offset
 215+ A2A9 DD 7E 03         LD A, (IX+ENT_POSX)
 216+ A2AC C6 08            ADD A, 8                    ; center X
 217+ A2AE 47               LD B, A
 218+ A2AF DD 7E 04         LD A, (IX+ENT_POSY)
 219+ A2B2 4F               LD C, A
 220+ A2B3 B7               OR A
 221+ A2B4 C8               RET Z
 222+ A2B5 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ A2B6 CD 88 D1         CALL IsPointBlocked
 224+ A2B9 C8               RET Z                       ; libre → sin offset
 225+ A2BA DD 7E 04         LD A, (IX+ENT_POSY)
 226+ A2BD 3C               INC A
 227+ A2BE 32 F6 81         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ A2C1 C9               RET
 229+ A2C2
 230+ A2C2              ; ==============================================================================
 231+ A2C2              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 232+ A2C2              ; ==============================================================================
 233+ A2C2              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 234+ A2C2              ; ==============================================================================
 235+ A2C2              ProcessPlayer:
 236+ A2C2 DD 21 C7 80      LD IX, EntityTable
 237+ A2C6
 238+ A2C6                  ; --- Fresh check ---
 239+ A2C6 3A 12 82         LD A, (ScreenJustRedrawn)
 240+ A2C9 B7               OR A
 241+ A2CA C2 9F A3         JP NZ, .plFresh
 242+ A2CD DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 243+ A2D1 C2 9F A3         JP NZ, .plFresh
 244+ A2D4
 245+ A2D4                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 246+ A2D4 CD 64 A8         CALL UpdatePlayer
 247+ A2D7 CD 7D A7         CALL CalcDrawX
 248+ A2DA CD 81 A2         CALL ComputePlayerDrawY
 249+ A2DD
 250+ A2DD                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 251+ A2DD DD 7E 0F         LD A, (IX+ENT_DRAWX)
 252+ A2E0 DD BE 0C         CP (IX+ENT_OLDX)
 253+ A2E3 20 47            JR NZ, .plDoErase
 254+ A2E5 3A F5 81         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 255+ A2E8 DD BE 0D         CP (IX+ENT_OLDY)
 256+ A2EB 20 3F            JR NZ, .plDoErase
 257+ A2ED DD 7E 00         LD A, (IX+ENT_SPRITEID)
 258+ A2F0 DD BE 0E         CP (IX+ENT_OLDSPRID)
 259+ A2F3 20 37            JR NZ, .plDoErase
 260+ A2F5                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 261+ A2F5 3A 52 C5         LD A, (PlayerHitTimer)
 262+ A2F8 B7               OR A
 263+ A2F9 20 01            JR NZ, .plRepaintAttr
 264+ A2FB C9               RET                                 ; Nada cambio → skip todo
 265+ A2FC              .plRepaintAttr:
 266+ A2FC 3A F5 81         LD A, (PlayerDrawY)
 267+ A2FF 57               LD D, A
 268+ A300 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 269+ A303 5F               LD E, A
 270+ A304 DD E5            PUSH IX
 271+ A306 CD C2 A7         CALL GetSpriteAddr
 272+ A309 DD 2A F1 A7      LD IX, (SpriteAddrTemp)
 273+ A30D CD C6 9E         CALL CalcEntityAttrSize
 274+ A310                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 275+ A310 3A 98 9F         LD A, (EntityAttrH)
 276+ A313 FE 02            CP 2
 277+ A315 38 04            JR C, .plAttrHOk
 278+ A317 3D               DEC A
 279+ A318 32 98 9F         LD (EntityAttrH), A
 280+ A31B              .plAttrHOk:
 281+ A31B DD E1            POP IX
 282+ A31D 3A F5 81         LD A, (PlayerDrawY)
 283+ A320 57               LD D, A
 284+ A321 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 285+ A324 5F               LD E, A
 286+ A325 DD 7E 05         LD A, (IX+ENT_ATTR)
 287+ A328 CD 99 9E         CALL SetEntityAttr
 288+ A32B C9               RET
 289+ A32C
 290+ A32C              .plDoErase:
 291+ A32C                  ; --- Erase viejo ---
 292+ A32C CD F3 A7         CALL GetOldSpriteAddr
 293+ A32F DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 294+ A332 DD 7E 0C         LD A, (IX+ENT_OLDX)
 295+ A335 5F               LD E, A
 296+ A336 DD E5            PUSH IX
 297+ A338 DD 2A 7B A7      LD IX, (OldSprAddr)
 298+ A33C CD A9 9D         CALL DrawSprite
 299+ A33F DD E1            POP IX
 300+ A341                  ; Restaurar atributos del fondo en posicion vieja
 301+ A341 DD 56 0D         LD D, (IX+ENT_OLDY)
 302+ A344 DD 5E 0C         LD E, (IX+ENT_OLDX)
 303+ A347 CD 21 CF         CALL RestoreOldAttr
 304+ A34A                  ; --- Draw nuevo ---
 305+ A34A CD C2 A7         CALL GetSpriteAddr
 306+ A34D 3A F5 81         LD A, (PlayerDrawY)
 307+ A350 57               LD D, A
 308+ A351 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 309+ A354 5F               LD E, A
 310+ A355 DD E5            PUSH IX
 311+ A357 DD 2A F1 A7      LD IX, (SpriteAddrTemp)
 312+ A35B CD A9 9D         CALL DrawSprite
 313+ A35E DD E1            POP IX
 314+ A360
 315+ A360                  ; Pintar attr
 316+ A360 3A F5 81         LD A, (PlayerDrawY)
 317+ A363 57               LD D, A
 318+ A364 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 319+ A367 5F               LD E, A
 320+ A368 DD E5            PUSH IX
 321+ A36A DD 2A F1 A7      LD IX, (SpriteAddrTemp)
 322+ A36E CD C6 9E         CALL CalcEntityAttrSize
 323+ A371 DD E1            POP IX
 324+ A373                  ; Reducir altura attr en 1 si es 4+ (última fila contiene muy pocos pixels
 325+ A373                  ; del sprite pero invade el char BG inferior con el color del player)
 326+ A373 3A 98 9F         LD A, (EntityAttrH)
 327+ A376 FE 04            CP 4
 328+ A378 38 04            JR C, .plAttrHOk2
 329+ A37A 3D               DEC A
 330+ A37B 32 98 9F         LD (EntityAttrH), A
 331+ A37E              .plAttrHOk2:
 332+ A37E 3A F5 81         LD A, (PlayerDrawY)
 333+ A381 57               LD D, A
 334+ A382 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 335+ A385 5F               LD E, A
 336+ A386 DD 7E 05         LD A, (IX+ENT_ATTR)
 337+ A389 CD 99 9E         CALL SetEntityAttr
 338+ A38C
 339+ A38C                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 340+ A38C              .plSaveOld:
 341+ A38C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 342+ A38F DD 77 0C         LD (IX+ENT_OLDX), A
 343+ A392 3A F5 81         LD A, (PlayerDrawY)
 344+ A395 DD 77 0D         LD (IX+ENT_OLDY), A
 345+ A398 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 346+ A39B DD 77 0E         LD (IX+ENT_OLDSPRID), A
 347+ A39E C9               RET
 348+ A39F
 349+ A39F                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 350+ A39F              .plFresh:
 351+ A39F DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 352+ A3A3 CD 64 A8         CALL UpdatePlayer
 353+ A3A6 CD 7D A7         CALL CalcDrawX
 354+ A3A9 CD 81 A2         CALL ComputePlayerDrawY
 355+ A3AC CD C2 A7         CALL GetSpriteAddr
 356+ A3AF
 357+ A3AF 3A F5 81         LD A, (PlayerDrawY)
 358+ A3B2 57               LD D, A
 359+ A3B3 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 360+ A3B6 5F               LD E, A
 361+ A3B7 DD E5            PUSH IX
 362+ A3B9 DD 2A F1 A7      LD IX, (SpriteAddrTemp)
