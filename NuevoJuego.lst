7175+ C6DA              ; ==============================================================================
7176+ C6DA              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7177+ C6DA              ; ==============================================================================
7178+ C6DA              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7179+ C6DA              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7180+ C6DA              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7181+ C6DA              ; el primer paso (N/S/W/E) desde el inicio.
7182+ C6DA              ;
7183+ C6DA              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7184+ C6DA              ; consistente con CheckEnemyCollision en cell-aligned positions).
7185+ C6DA              ;
7186+ C6DA              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7187+ C6DA              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7188+ C6DA              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7189+ C6DA              ; paso pero permite llegar a una celda mas profunda con dist menor).
7190+ C6DA              ;
7191+ C6DA              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7192+ C6DA              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7193+ C6DA              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7194+ C6DA              ;
7195+ C6DA              ; IX = SLOT_DEATH al entrar.
7196+ C6DA              ; ==============================================================================
7197+ C6DA              DeathBfsRescue:
7198+ C6DA                  ; --- Celda inicial = celda actual de Death ---
7199+ C6DA DD 7E 03         LD A, (IX+ENT_POSX)
7200+ C6DD 0F               RRCA
7201+ C6DE 0F               RRCA
7202+ C6DF 0F               RRCA
7203+ C6E0 E6 1F            AND $1F
7204+ C6E2 32 74 5F         LD (DBfsCurCx), A
7205+ C6E5 DD 7E 04         LD A, (IX+ENT_POSY)
7206+ C6E8 D6 10            SUB SCREEN_MIN_Y
7207+ C6EA 0F               RRCA
7208+ C6EB 0F               RRCA
7209+ C6EC 0F               RRCA
7210+ C6ED E6 1F            AND $1F
7211+ C6EF 32 75 5F         LD (DBfsCurCy), A
7212+ C6F2                  ; --- Celda del player ---
7213+ C6F2 3A A1 81         LD A, (EntityTable + ENT_POSX)
7214+ C6F5 0F               RRCA
7215+ C6F6 0F               RRCA
7216+ C6F7 0F               RRCA
7217+ C6F8 E6 1F            AND $1F
7218+ C6FA 32 72 5F         LD (DBfsPlayerCx), A
7219+ C6FD 3A A2 81         LD A, (EntityTable + ENT_POSY)
7220+ C700 D6 10            SUB SCREEN_MIN_Y
7221+ C702 0F               RRCA
7222+ C703 0F               RRCA
7223+ C704 0F               RRCA
7224+ C705 E6 1F            AND $1F
7225+ C707 32 73 5F         LD (DBfsPlayerCy), A
7226+ C70A                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7227+ C70A 21 FF 5E         LD HL, DBfsQueue
7228+ C70D 22 6B 5F         LD (DBfsQHead), HL
7229+ C710 3A 74 5F         LD A, (DBfsCurCx)
7230+ C713 77               LD (HL), A
7231+ C714 23               INC HL
7232+ C715 3A 75 5F         LD A, (DBfsCurCy)
7233+ C718 77               LD (HL), A
7234+ C719 23               INC HL
7235+ C71A 36 FF            LD (HL), MAI_DIR_NONE
7236+ C71C 23               INC HL
7237+ C71D 36 00            LD (HL), 0
7238+ C71F 23               INC HL
7239+ C720 22 6D 5F         LD (DBfsQTail), HL
