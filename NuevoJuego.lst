 123+ EB86              ; ==============================================================================
 124+ EB86              ; UpdateGameClock
 125+ EB86              ; ==============================================================================
 126+ EB86              UpdateGameClock:
 127+ EB86 3A B5 82         LD A, (TimeFrozen)
 128+ EB89 B7               OR A
 129+ EB8A C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EB8B 21 EC E9         LD HL, GameSubMinute
 131+ EB8E 34               INC (HL)
 132+ EB8F 3A EF E9         LD A, (SubMinuteMax)
 133+ EB92 BE               CP (HL)
 134+ EB93 C0               RET NZ
 135+ EB94
 136+ EB94 AF               XOR A
 137+ EB95 32 EC E9         LD (GameSubMinute), A
 138+ EB98 21 ED E9         LD HL, GameMinutes
 139+ EB9B 34               INC (HL)
 140+ EB9C                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EB9C                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EB9C 3A ED E9         LD A, (GameMinutes)
 143+ EB9F FE 3C            CP 60
 144+ EBA1 C0               RET NZ
 145+ EBA2
 146+ EBA2 AF               XOR A
 147+ EBA3 32 ED E9         LD (GameMinutes), A
 148+ EBA6 21 EE E9         LD HL, GameHours
 149+ EBA9 34               INC (HL)
 150+ EBAA 7E               LD A, (HL)
 151+ EBAB FE 18            CP 24
 152+ EBAD 20 04            JR NZ, .checkPhase
 153+ EBAF AF               XOR A
 154+ EBB0 32 EE E9         LD (GameHours), A
 155+ EBB3
 156+ EBB3              .checkPhase:
 157+ EBB3 3A EE E9         LD A, (GameHours)
 158+ EBB6 21 F8 E9         LD HL, PhaseTable
 159+ EBB9 06 07            LD B, 7
 160+ EBBB              .phaseLoop:
 161+ EBBB BE               CP (HL)
 162+ EBBC 28 05            JR Z, .phaseFound
 163+ EBBE 23               INC HL
 164+ EBBF 23               INC HL
 165+ EBC0 10 F9            DJNZ .phaseLoop
 166+ EBC2 C9               RET
 167+ EBC3              .phaseFound:
 168+ EBC3 23               INC HL
 169+ EBC4 7E               LD A, (HL)
 170+ EBC5 F5               PUSH AF
 171+ EBC6 CD 8E E3         CALL SetTimeOfDay
 172+ EBC9 F1               POP AF
 173+ EBCA FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EBCC C0               RET NZ
 175+ EBCD                  ; Nuevo dia: incrementar ciclo
 176+ EBCD 21 0D BD         LD HL, DayCycleCount
 177+ EBD0 34               INC (HL)
 178+ EBD1 C9               RET
 179+ EBD2
 180+ EBD2              ; ==============================================================================
 181+ EBD2              ; SetClockToPhaseHour
 182+ EBD2              ; ==============================================================================
 183+ EBD2              SetClockToPhaseHour:
 184+ EBD2 21 F1 E9         LD HL, PhaseStartHour
 185+ EBD5 4F               LD C, A
 186+ EBD6 06 00            LD B, 0
 187+ EBD8 09               ADD HL, BC
 188+ EBD9 7E               LD A, (HL)
 189+ EBDA 32 EE E9         LD (GameHours), A
 190+ EBDD AF               XOR A
 191+ EBDE 32 ED E9         LD (GameMinutes), A
 192+ EBE1 32 EC E9         LD (GameSubMinute), A
 193+ EBE4 C9               RET
 194+ EBE5
 195+ EBE5              ; ==============================================================================
 196+ EBE5              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EBE5              ; ==============================================================================
 198+ EBE5              DrawClockHUD:
 199+ EBE5                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EBE5                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EBE5                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EBE5                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EBE5                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EBE5                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EBE5 3A B5 82         LD A, (TimeFrozen)
 206+ EBE8 FE 01            CP 1
 207+ EBEA 20 07            JR NZ, .clkDrawNormal
 208+ EBEC 3A 9A 81         LD A, (GameFrameCounter)
 209+ EBEF E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EBF1 28 2D            JR Z, .clkBlinkOff
 211+ EBF3              .clkDrawNormal:
 212+ EBF3 CD 2E EC         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EBF6
 214+ EBF6                  ; --- Aguja de horas ---
 215+ EBF6 3A EE E9         LD A, (GameHours)
 216+ EBF9 FE 0C            CP 12
 217+ EBFB 38 02            JR C, .hourOk
 218+ EBFD D6 0C            SUB 12
 219+ EBFF              .hourOk:
 220+ EBFF 21 EA EA         LD HL, HourHandPtrs
 221+ EC02 CD 04 EE         CALL DrawHandLine
 222+ EC05
 223+ EC05                  ; --- Aguja de minutos ---
 224+ EC05 3A ED E9         LD A, (GameMinutes)
 225+ EC08 06 00            LD B, 0
 226+ EC0A              .divMin:
 227+ EC0A FE 05            CP 5
 228+ EC0C 38 05            JR C, .minOk
 229+ EC0E D6 05            SUB 5
 230+ EC10 04               INC B
 231+ EC11 18 F7            JR .divMin
 232+ EC13              .minOk:
 233+ EC13 78               LD A, B
 234+ EC14 21 06 EA         LD HL, MinHandPtrs
 235+ EC17 CD 04 EE         CALL DrawHandLine
 236+ EC1A
 237+ EC1A                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EC1A 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EC1D CB 86            RES 0, (HL)
 240+ EC1F C9               RET
 241+ EC20
 242+ EC20              .clkBlinkOff:
 243+ EC20                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EC20                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EC20                  ; paper=black + ink=black.
 246+ EC20 AF               XOR A
 247+ EC21 32 0F 58         LD ($580F), A
 248+ EC24 32 2F 58         LD ($582F), A
 249+ EC27 32 10 58         LD ($5810), A
 250+ EC2A 32 30 58         LD ($5830), A
 251+ EC2D C9               RET
