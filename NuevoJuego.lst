 483+ AC94              ; ==============================================================================
 484+ AC94              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 485+ AC94              ; ==============================================================================
 486+ AC94              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 487+ AC94              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 488+ AC94              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 489+ AC94              ; ==============================================================================
 490+ AC94              DrawBgGfxSprite:
 491+ AC94 DD 7E 00         LD A, (IX+0)                ; height_px
 492+ AC97 B7               OR A
 493+ AC98 C8               RET Z                       ; sprite nulo (sin datos)
 494+ AC99 32 26 AD         LD (.heightCnt), A
 495+ AC9C DD 7E 01         LD A, (IX+1)                ; width_bytes
 496+ AC9F 32 27 AD         LD (.widthVal), A
 497+ ACA2
 498+ ACA2                  ; Aplicar offset HUD: desplazar sprites BG 2 filas hacia abajo
 499+ ACA2 79               LD A, C
 500+ ACA3 C6 02            ADD A, BG_Y_OFFSET
 501+ ACA5 4F               LD C, A
 502+ ACA6
 503+ ACA6                  ; Guardar posicion para la fase de atributos
 504+ ACA6 78               LD A, B
 505+ ACA7 32 28 AD         LD (.xChar), A
 506+ ACAA 79               LD A, C
 507+ ACAB 32 29 AD         LD (.yChar), A
 508+ ACAE
 509+ ACAE DD 23            INC IX
 510+ ACB0 DD 23            INC IX                      ; IX -> pixel data
 511+ ACB2
 512+ ACB2                  ; Calcular dir VRAM inicio: x_pixel = x_char*8, y_pixel = y_char*8
 513+ ACB2 79               LD A, C
 514+ ACB3 07               RLCA
 515+ ACB4 07               RLCA
 516+ ACB5 07               RLCA
 517+ ACB6 57               LD D, A                     ; D = y_pixel
 518+ ACB7 78               LD A, B
 519+ ACB8 07               RLCA
 520+ ACB9 07               RLCA
 521+ ACBA 07               RLCA
 522+ ACBB 5F               LD E, A                     ; E = x_pixel
 523+ ACBC CD BC 8A         CALL CalcPixelAddr          ; HL = dir VRAM
 524+ ACBF
 525+ ACBF                  ; --- Copiar pixel data (CPL para des-invertir) ---
 526+ ACBF              .pixRow:
 527+ ACBF 3A 27 AD         LD A, (.widthVal)
 528+ ACC2 47               LD B, A
 529+ ACC3 E5               PUSH HL                     ; guardar inicio de fila VRAM
 530+ ACC4
 531+ ACC4              .pixCol:
 532+ ACC4 DD 7E 00         LD A, (IX+0)
 533+ ACC7 2F               CPL                         ; des-invertir (dato almacenado CPL'd)
 534+ ACC8 77               LD (HL), A
 535+ ACC9 DD 23            INC IX
 536+ ACCB 23               INC HL
 537+ ACCC 10 F6            DJNZ .pixCol
 538+ ACCE
 539+ ACCE E1               POP HL                      ; restaurar inicio fila
 540+ ACCF 3A 26 AD         LD A, (.heightCnt)
 541+ ACD2 3D               DEC A
 542+ ACD3 32 26 AD         LD (.heightCnt), A
 543+ ACD6 28 05            JR Z, .pixDone
 544+ ACD8 CD 68 88         CALL NextPixelLine          ; HL = siguiente linea pixel
 545+ ACDB 18 E2            JR .pixRow
