 142+ 991F 5D               LD E, L
 143+ 9920 3E 02            LD A, 2
 144+ 9922 01 FD FF         LD BC, $FFFD
 145+ 9925 ED 79            OUT (C), A
 146+ 9927 01 FD BF         LD BC, $BFFD
 147+ 992A ED 59            OUT (C), E
 148+ 992C 5C               LD E, H
 149+ 992D 3E 03            LD A, 3
 150+ 992F 01 FD FF         LD BC, $FFFD
 151+ 9932 ED 79            OUT (C), A
 152+ 9934 01 FD BF         LD BC, $BFFD
 153+ 9937 ED 59            OUT (C), E
 154+ 9939                  ; R4/R5 (canal C)
 155+ 9939 5D               LD E, L
 156+ 993A 3E 04            LD A, 4
 157+ 993C 01 FD FF         LD BC, $FFFD
 158+ 993F ED 79            OUT (C), A
 159+ 9941 01 FD BF         LD BC, $BFFD
 160+ 9944 ED 59            OUT (C), E
 161+ 9946 5C               LD E, H
 162+ 9947 3E 05            LD A, 5
 163+ 9949 01 FD FF         LD BC, $FFFD
 164+ 994C ED 79            OUT (C), A
 165+ 994E 01 FD BF         LD BC, $BFFD
 166+ 9951 ED 59            OUT (C), E
 167+ 9953 FB               EI
 168+ 9954 C9               RET
 169+ 9955
 170+ 9955              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 171+ 9955              ; HL = period (12-bit), B = duracion (10ms units).
 172+ 9955              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 173+ 9955              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 174+ 9955              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 175+ 9955              ; cambiaramos de bank en slot 3 entre el push y el pop).
 176+ 9955              AY_PlayToneBlocking:
 177+ 9955 F3               DI
 178+ 9956                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 9956                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 9956 5C               LD E, H                     ; E = period high
 181+ 9957 3E 01            LD A, 1
 182+ 9959 01 FD FF         LD BC, $FFFD
 183+ 995C ED 79            OUT (C), A
 184+ 995E 01 FD BF         LD BC, $BFFD
 185+ 9961 ED 59            OUT (C), E
 186+ 9963                  ; R0 = period low
 187+ 9963 5D               LD E, L                     ; E = period low
 188+ 9964 3E 00            LD A, 0
 189+ 9966 01 FD FF         LD BC, $FFFD
 190+ 9969 ED 79            OUT (C), A
 191+ 996B 01 FD BF         LD BC, $BFFD
 192+ 996E ED 59            OUT (C), E
 193+ 9970                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 194+ 9970 3E 09            LD A, 9
 195+ 9972 01 FD FF         LD BC, $FFFD
 196+ 9975 ED 79            OUT (C), A
 197+ 9977 01 FD BF         LD BC, $BFFD
 198+ 997A AF               XOR A
 199+ 997B ED 79            OUT (C), A
 200+ 997D                  ; R10 = 0 (silenciar canal C)
 201+ 997D 3E 0A            LD A, 10
 202+ 997F 01 FD FF         LD BC, $FFFD
 203+ 9982 ED 79            OUT (C), A
 204+ 9984 01 FD BF         LD BC, $BFFD
 205+ 9987 AF               XOR A
 206+ 9988 ED 79            OUT (C), A
 207+ 998A                  ; R7 = $3E (mixer: solo tono A activo)
 208+ 998A 3E 07            LD A, 7
 209+ 998C 01 FD FF         LD BC, $FFFD
 210+ 998F ED 79            OUT (C), A
 211+ 9991 01 FD BF         LD BC, $BFFD
 212+ 9994 3E 3E            LD A, $3E
 213+ 9996 ED 79            OUT (C), A
 214+ 9998                  ; R8 = 13 (volumen A alto)
 215+ 9998 3E 08            LD A, 8
 216+ 999A 01 FD FF         LD BC, $FFFD
 217+ 999D ED 79            OUT (C), A
 218+ 999F 01 FD BF         LD BC, $BFFD
 219+ 99A2 3E 0D            LD A, 13
 220+ 99A4 ED 79            OUT (C), A
