 136+ 672E              ; ==============================================================================
 137+ 672E              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 138+ 672E              ; ==============================================================================
 139+ 672E              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 140+ 672E              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 141+ 672E              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 142+ 672E              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 143+ 672E              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 144+ 672E              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 145+ 672E              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 146+ 672E              ; ==============================================================================
 147+ 672E              StatueIdTable:
 148+ 672E D5               DEFB 213        ; type idx 0: statue_zombi
 149+ 672F E1               DEFB 225        ; type idx 1: statue_skeleton
 150+ 6730 D3               DEFB 211        ; type idx 2: statue_ghost
