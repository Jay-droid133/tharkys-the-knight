1258+ F3CA              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1259+ F3CA              .ucsShakeStatuePhase:
1260+ F3CA 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1261+ F3CD FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1262+ F3CF 30 35            JR NC, .ucsShakeStatueDone
1263+ F3D1                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1264+ F3D1                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1265+ F3D1                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1266+ F3D1                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1267+ F3D1                  ;
1268+ F3D1                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1269+ F3D1                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1270+ F3D1 ED 5F            LD A, R
1271+ F3D3 E6 03            AND $03
1272+ F3D5 21 02 F4         LD HL, .ucsShakeJitterTable
1273+ F3D8 5F               LD E, A
1274+ F3D9 16 00            LD D, 0
1275+ F3DB 19               ADD HL, DE
1276+ F3DC 7E               LD A, (HL)
1277+ F3DD 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1278+ F3DE                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1279+ F3DE 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1280+ F3E1 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
