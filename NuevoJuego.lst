7019+ C636              .udgAnim:
7020+ C636                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
7021+ C636                  ; ser despawneada por una de tres condiciones externas:
7022+ C636                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
7023+ C636                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
7024+ C636                  ;   3. Player cambia de pantalla (screen_system reset)
7025+ C636                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
7026+ C636                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
7027+ C636                  ; jugador no puede sacudirse a la muerte cambiando posicion.
7028+ C636 C3 39 C6         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
7029+ C639
7030+ C639              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
7031+ C639              ; Llamada por:
7032+ C639              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
7033+ C639              ;   - UpdateDeath en frame skip (sin movimiento).
7034+ C639              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
7035+ C639              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
7036+ C639              DeathAnimate:
7037+ C639 DD 7E 06         LD A, (IX+ENT_DELTAX)
7038+ C63C B7               OR A
7039+ C63D 28 0A            JR Z, .daKeepDir
7040+ C63F 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
7041+ C641 CB 7F            BIT 7, A
7042+ C643 28 0D            JR Z, .daDir
7043+ C645 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
7044+ C647 18 09            JR .daDir
7045+ C649              .daKeepDir:
7046+ C649 DD 7E 00         LD A, (IX+ENT_SPRITEID)
7047+ C64C DD 96 08         SUB (IX+ENT_ANIMBASE)
7048+ C64F E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
7049+ C651 4F               LD C, A
7050+ C652              .daDir:
7051+ C652 DD 35 09         DEC (IX+ENT_ANIMTIMER)
7052+ C655 20 16            JR NZ, .daFrameSet
7053+ C657 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7054+ C65B DD 7E 00         LD A, (IX+ENT_SPRITEID)
7055+ C65E 47               LD B, A
7056+ C65F DD 96 08         SUB (IX+ENT_ANIMBASE)
7057+ C662 E6 01            AND 1
7058+ C664 20 03            JR NZ, .daFrameDec
7059+ C666 04               INC B
7060+ C667 18 01            JR .daFrameStore
7061+ C669              .daFrameDec:
7062+ C669 05               DEC B
7063+ C66A              .daFrameStore:
7064+ C66A DD 70 00         LD (IX+ENT_SPRITEID), B
7065+ C66D              .daFrameSet:
7066+ C66D DD 7E 00         LD A, (IX+ENT_SPRITEID)
7067+ C670 DD 96 08         SUB (IX+ENT_ANIMBASE)
7068+ C673 E6 01            AND 1
7069+ C675 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
7070+ C678 81               ADD A, C
7071+ C679 DD 77 00         LD (IX+ENT_SPRITEID), A
7072+ C67C C9               RET
