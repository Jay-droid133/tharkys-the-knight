# file opened: code/sound.asm
   1+ F641              ; ==============================================================================
   2+ F641              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F641              ; ==============================================================================
   4+ F641              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F641              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F641              ;
   7+ F641              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F641              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F641              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F641              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F641              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F641              ; ==============================================================================
  13+ F641
  14+ F641              ; ==============================================================================
  15+ F641              ; PlaySFX - Reproduce un efecto de sonido
  16+ F641              ; ==============================================================================
  17+ F641              ; Entrada: HL = puntero a datos del efecto
  18+ F641              ; Modifica: AF, BC, DE, HL
  19+ F641              ; ==============================================================================
  20+ F641              PlaySFX:
  21+ F641 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F642 3A 83 8D         LD A, (CurrentBorderColor)
  23+ F645 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F647 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F648
  26+ F648              .nextStep:
  27+ F648 7E               LD A, (HL)                  ; Leer duration
  28+ F649 B7               OR A
  29+ F64A 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F64C
  31+ F64C 47               LD B, A                     ; B = duration (bucle externo)
  32+ F64D 23               INC HL
  33+ F64E 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F64F 23               INC HL
  35+ F650 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F651 23               INC HL
  37+ F652 7E               LD A, (HL)                  ; A = flags
  38+ F653 23               INC HL
  39+ F654 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F655 CB 47            BIT 0, A
  41+ F657 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F659
  43+ F659              ; --- Bucle de tono normal ---
  44+ F659              .toneLoop:
  45+ F659                  ; Semi-periodo HIGH
  46+ F659 7B               LD A, E
  47+ F65A F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F65C D3 FE            OUT ($FE), A
  49+ F65E 79               LD A, C                     ; A = pitch actual
  50+ F65F              .toneDelayHi:
  51+ F65F 3D               DEC A
  52+ F660 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F662
  54+ F662                  ; Semi-periodo LOW
  55+ F662 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F663 D3 FE            OUT ($FE), A
  57+ F665 79               LD A, C
  58+ F666              .toneDelayLo:
  59+ F666 3D               DEC A
  60+ F667 20 FD            JR NZ, .toneDelayLo
  61+ F669
  62+ F669                  ; Aplicar pitch sweep
  63+ F669 79               LD A, C
  64+ F66A 82               ADD A, D                    ; pitch += pitchDelta
  65+ F66B 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F66D FA 75 F6         JP M, .toneClamp            ; evitar pitch negativo
  67+ F670 4F               LD C, A
  68+ F671              .toneAfterClamp:
  69+ F671 10 E6            DJNZ .toneLoop
  70+ F673 18 30            JR .stepDone
  71+ F675
  72+ F675              .toneClamp:
  73+ F675 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F677 18 F8            JR .toneAfterClamp
  75+ F679
  76+ F679              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F679              .noiseLoop:
  78+ F679                  ; Semi-periodo HIGH con ruido
  79+ F679 7B               LD A, E
  80+ F67A F6 10            OR $10
  81+ F67C D3 FE            OUT ($FE), A
  82+ F67E ED 5F            LD A, R                     ; R register como PRNG
  83+ F680 A9               XOR C                       ; mezclar con pitch base
  84+ F681 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F683 F6 01            OR $01                      ; minimo 1
  86+ F685              .noiseDelayHi:
  87+ F685 3D               DEC A
  88+ F686 20 FD            JR NZ, .noiseDelayHi
  89+ F688
  90+ F688                  ; Semi-periodo LOW
  91+ F688 7B               LD A, E
  92+ F689 D3 FE            OUT ($FE), A
  93+ F68B ED 5F            LD A, R
  94+ F68D A9               XOR C
  95+ F68E E6 1F            AND $1F
  96+ F690 F6 01            OR $01
  97+ F692              .noiseDelayLo:
  98+ F692 3D               DEC A
  99+ F693 20 FD            JR NZ, .noiseDelayLo
 100+ F695
 101+ F695                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F695 79               LD A, C
 103+ F696 82               ADD A, D
 104+ F697 28 08            JR Z, .noiseClamp
 105+ F699 FA A1 F6         JP M, .noiseClamp
 106+ F69C 4F               LD C, A
 107+ F69D              .noiseAfterClamp:
 108+ F69D 10 DA            DJNZ .noiseLoop
 109+ F69F 18 04            JR .stepDone
 110+ F6A1
 111+ F6A1              .noiseClamp:
 112+ F6A1 0E 01            LD C, 1
 113+ F6A3 18 F8            JR .noiseAfterClamp
 114+ F6A5
 115+ F6A5              .stepDone:
 116+ F6A5 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F6A6 18 A0            JR .nextStep
 118+ F6A8
 119+ F6A8              .done:
 120+ F6A8 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F6A9 D3 FE            OUT ($FE), A
 122+ F6AB FB               EI
 123+ F6AC C9               RET
