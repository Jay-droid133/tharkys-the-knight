 771+ E65A 09               ADD HL, BC                  ; HL = font data
 772+ E65B
 773+ E65B                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E65B 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E65D 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E65F 83               ADD A, E
 777+ E660 5F               LD E, A                     ; DE = dir VRAM
