 130  9021                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 9021              ; ==============================================================================
   2+ 9021              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 9021              ; ==============================================================================
   4+ 9021              ; Port $7FFD (write-only):
   5+ 9021              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 9021              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 9021              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 9021              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 9021              ;
  10+ 9021              ; Bancos disponibles:
  11+ 9021              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 9021              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 9021              ;   Bank 1: libre para datos nuevos (contended)
  14+ 9021              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 9021              ;   Bank 3: libre para datos nuevos (contended)
  16+ 9021              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 9021              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 9021              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 9021              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 9021              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 9021              ; ==============================================================================
  22+ 9021
  23+ 9021              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 9021              ; para no machacarse a si mismas al cambiar de banco.
  25+ 9021
  26+ 9021              ; ==============================================================================
  27+ 9021              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 9021              ; ==============================================================================
  29+ 9021              ; Entrada: A = banco (0-7)
  30+ 9021              ; Preserva: HL, DE, IX, IY
  31+ 9021              ; Destruye: A, BC
  32+ 9021              ; ==============================================================================
  33+ 9021              PageBankSlot3:
  34+ 9021 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 9023 47               LD B, A                     ; guardar banco nuevo
  36+ 9024 3A FB 8F         LD A, (CurrentPaging)
  37+ 9027 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 9029 B0               OR B                        ; poner nuevo banco
  39+ 902A 32 FB 8F         LD (CurrentPaging), A
  40+ 902D 01 FD 7F         LD BC, $7FFD
  41+ 9030 ED 79            OUT (C), A
  42+ 9032 C9               RET
  43+ 9033
  44+ 9033              ; ==============================================================================
  45+ 9033              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 9033              ; ==============================================================================
  47+ 9033              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 9033              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 9033              ; ==============================================================================
  50+ 9033              InitPaging:
  51+ 9033 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 9035 32 FB 8F         LD (CurrentPaging), A
  53+ 9038 01 FD 7F         LD BC, $7FFD
  54+ 903B ED 79            OUT (C), A
  55+ 903D C9               RET
  56+ 903E
  57+ 903E              ; ==============================================================================
  58+ 903E              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 903E              ; ==============================================================================
  60+ 903E              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 903E              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 903E              ;      Paginacion restaurada a bank 0.
  63+ 903E              ; Destruye: A, BC, DE, HL
  64+ 903E              ;
  65+ 903E              ; Formato del room en FUENTE (variable-length):
  66+ 903E              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 903E              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 903E              ;   terminador:                  DEFB $FF
  69+ 903E              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 903E              ;
  71+ 903E              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 903E              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 903E              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 903E              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 903E              ; ==============================================================================
  76+ 903E              LoadRoomToBuffer:
  77+ 903E                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 903E                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 903E                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 903E                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 903E                  ;
  82+ 903E                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 903E                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 903E ED 57            LD A, I                         ; P/V = IFF2 (interrupts previos)
  85+ 9040 F5               PUSH AF                         ; push en bank 0 (slot 3 sigue bank 0)
  86+ 9041 F3               DI
  87+ 9042                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 9042 3A FB 8F         LD A, (CurrentPaging)
  89+ 9045 E6 F8            AND $F8
  90+ 9047 F6 01            OR 1
  91+ 9049 32 FB 8F         LD (CurrentPaging), A
  92+ 904C 01 FD 7F         LD BC, $7FFD
  93+ 904F ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 9051                  ; --- Copy + decompress loop ---
  95+ 9051                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 9051                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 9051 11 AE 84         LD DE, CurrentScreenBuffer
  98+ 9054              .lrbLoop:
  99+ 9054 7E               LD A, (HL)                      ; id
 100+ 9055 12               LD (DE), A
 101+ 9056 23               INC HL
 102+ 9057 13               INC DE
 103+ 9058 FE FF            CP $FF                          ; terminador?
 104+ 905A 28 1B            JR Z, .lrbDone
 105+ 905C                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 905C                  ; al buffer escribimos x limpio (AND $7F).
 107+ 905C 7E               LD A, (HL)
 108+ 905D 23               INC HL
 109+ 905E 47               LD B, A                         ; B = x raw (con flag)
 110+ 905F E6 7F            AND $7F
 111+ 9061 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 9062 13               INC DE
 113+ 9063                  ; Copiar y
 114+ 9063 7E               LD A, (HL)
 115+ 9064 12               LD (DE), A
 116+ 9065 23               INC HL
 117+ 9066 13               INC DE
 118+ 9067                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 9067 CB 78            BIT 7, B
 120+ 9069 28 06            JR Z, .lrbNoTint
 121+ 906B 7E               LD A, (HL)                      ; v desde source
 122+ 906C 23               INC HL
 123+ 906D 12               LD (DE), A
 124+ 906E 13               INC DE
 125+ 906F 18 E3            JR .lrbLoop
 126+ 9071              .lrbNoTint:
 127+ 9071 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 9073 12               LD (DE), A
 129+ 9074 13               INC DE
 130+ 9075 18 DD            JR .lrbLoop
 131+ 9077              .lrbDone:
 132+ 9077                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 9077 3A FB 8F         LD A, (CurrentPaging)
 134+ 907A E6 F8            AND $F8                         ; bank 0
 135+ 907C 32 FB 8F         LD (CurrentPaging), A
 136+ 907F 01 FD 7F         LD BC, $7FFD
 137+ 9082 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 9084                  ; Restaurar IFF original: si estaba deshabilitado (startup), no hacer EI
 139+ 9084 F1               POP AF                          ; pop desde bank 0 (el que pusimos al entrar)
 140+ 9085 E0               RET PO                          ; P/V odd = IFF2 era 0 → dejar DI
 141+ 9086 FB               EI
 142+ 9087 C9               RET
