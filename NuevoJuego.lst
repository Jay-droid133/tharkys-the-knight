 718+ A246              .peShakeActive:
 719+ A246                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 720+ A246 ED 5F            LD A, R
 721+ A248 E6 03            AND 3
 722+ A24A 28 0C            JR Z, .peShakeUp
 723+ A24C 3D               DEC A
 724+ A24D 28 0F            JR Z, .peShakeDown
 725+ A24F 3D               DEC A
 726+ A250 28 12            JR Z, .peShakeLeft
 727+ A252                  ; 3: right
 728+ A252 06 01            LD B, 1
 729+ A254 0E 00            LD C, 0
 730+ A256 18 10            JR .peShakeApply
