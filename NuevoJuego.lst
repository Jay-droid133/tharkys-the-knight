 466+ 93CB C5               PUSH BC
 467+ 93CC DD 7E 01         LD A, (IX+ENT_TYPE)
 468+ 93CF FE 02            CP TYPE_MONSTER
 469+ 93D1 20 12            JR NZ, .dsmNext
 470+ 93D3 DD 7E 02         LD A, (IX+ENT_STATE)
 471+ 93D6 FE 05            CP STATE_SCARED
 472+ 93D8 20 0B            JR NZ, .dsmNext
 473+ 93DA CD 86 93         CALL WipeMonsterSlot
 474+ 93DD DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 93E1 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
