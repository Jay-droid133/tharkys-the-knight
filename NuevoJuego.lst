 320+ F936 3E 0B            LD A, SPRID_WALK_N + 1
 321+ F938 DD 77 00         LD (IX+ENT_SPRITEID), A
 322+ F93B 3E 0A            LD A, SPRID_WALK_N
 323+ F93D DD 77 08         LD (IX+ENT_ANIMBASE), A
 324+ F940 AF               XOR A
 325+ F941 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 326+ F944 C3 9E 63         JP TownGateRedrawPlayer
