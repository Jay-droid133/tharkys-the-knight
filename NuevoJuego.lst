 602+ ECEF              ; ==============================================================================
 603+ ECEF              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ ECEF              ; ==============================================================================
 605+ ECEF
 606+ ECEF              ; ==============================================================================
 607+ ECEF              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ ECEF              ; ==============================================================================
 609+ ECEF              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ ECEF              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ ECEF              ; ==============================================================================
 612+ ECEF              BuildPlazaScanAddrs:
 613+ ECEF                  ; Calcular pixel coords del top-left de la esfera
 614+ ECEF 3A 64 8D         LD A, (PlazaClockCharY)
 615+ ECF2 07               RLCA
 616+ ECF3 07               RLCA
 617+ ECF4 07               RLCA
 618+ ECF5 57               LD D, A                     ; D = pixelY = charY * 8
 619+ ECF6 3A 63 8D         LD A, (PlazaClockCharX)
 620+ ECF9 07               RLCA
 621+ ECFA 07               RLCA
 622+ ECFB 07               RLCA
 623+ ECFC 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ ECFD CD 5D 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ ED00
 626+ ED00 DD 21 65 8D      LD IX, PlazaScanAddrs
 627+ ED04 06 10            LD B, 16
 628+ ED06              .buildLoop:
 629+ ED06 DD 75 00         LD (IX+0), L
 630+ ED09 DD 74 01         LD (IX+1), H
 631+ ED0C DD 23            INC IX
 632+ ED0E DD 23            INC IX
 633+ ED10 05               DEC B
 634+ ED11 C8               RET Z
 635+ ED12 CD C9 9A         CALL NextPixelLine
 636+ ED15 18 EF            JR .buildLoop
 637+ ED17
 638+ ED17              ; ==============================================================================
 639+ ED17              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ ED17              ; ==============================================================================
 641+ ED17              ; Llamar cada frame desde el main loop.
 642+ ED17              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ ED17              ; ==============================================================================
 644+ ED17              DrawPlazaClock:
 645+ ED17 3A 62 8D         LD A, (PlazaClockActive)
 646+ ED1A B7               OR A
 647+ ED1B C8               RET Z
 648+ ED1C
 649+ ED1C                  ; --- Calcular posicion actual de las agujas ---
 650+ ED1C 3A 8E E8         LD A, (GameHours)
 651+ ED1F FE 0C            CP 12
 652+ ED21 38 02            JR C, .pCalcHourOk
 653+ ED23 D6 0C            SUB 12
 654+ ED25              .pCalcHourOk:
 655+ ED25 57               LD D, A                     ; D = display hour (0-11)
 656+ ED26 3A 8D E8         LD A, (GameMinutes)
 657+ ED29 1E 00            LD E, 0
 658+ ED2B              .pCalcDiv5:
 659+ ED2B FE 05            CP 5
 660+ ED2D 38 05            JR C, .pCalcMinOk
 661+ ED2F D6 05            SUB 5
 662+ ED31 1C               INC E
 663+ ED32 18 F7            JR .pCalcDiv5
 664+ ED34              .pCalcMinOk:
 665+ ED34                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ ED34
 667+ ED34                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ ED34 3A 88 ED         LD A, (PlazaLastHour)
 669+ ED37 BA               CP D
 670+ ED38 20 05            JR NZ, .pNeedsRedraw
 671+ ED3A 3A 89 ED         LD A, (PlazaLastMin)
 672+ ED3D BB               CP E
 673+ ED3E C8               RET Z                       ; sin cambio → no redibujar
 674+ ED3F
 675+ ED3F              .pNeedsRedraw:
 676+ ED3F 7A               LD A, D
 677+ ED40 32 88 ED         LD (PlazaLastHour), A
 678+ ED43 7B               LD A, E
 679+ ED44 32 89 ED         LD (PlazaLastMin), A
 680+ ED47
 681+ ED47                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ ED47                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ ED47 DD 21 38 8A      LD IX, PlazaClockPixels
 684+ ED4B FD 21 65 8D      LD IY, PlazaScanAddrs
 685+ ED4F 06 10            LD B, 16
 686+ ED51              .faceRow:
 687+ ED51 FD 6E 00         LD L, (IY+0)
 688+ ED54 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ ED57 DD 7E 00         LD A, (IX+0)
 690+ ED5A 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ ED5B 77               LD (HL), A                  ; byte izquierdo
 692+ ED5C 23               INC HL
 693+ ED5D DD 7E 01         LD A, (IX+1)
 694+ ED60 2F               CPL
 695+ ED61 77               LD (HL), A                  ; byte derecho
 696+ ED62 DD 23            INC IX
 697+ ED64 DD 23            INC IX
 698+ ED66 FD 23            INC IY
 699+ ED68 FD 23            INC IY
 700+ ED6A 10 E5            DJNZ .faceRow
 701+ ED6C
 702+ ED6C                  ; --- Aguja de horas ---
 703+ ED6C 3A 88 ED         LD A, (PlazaLastHour)
 704+ ED6F 21 8A E9         LD HL, HourHandPtrs
 705+ ED72 CD 8A ED         CALL DrawPlazaHandLine
 706+ ED75
 707+ ED75                  ; --- Aguja de minutos ---
 708+ ED75 3A 89 ED         LD A, (PlazaLastMin)
 709+ ED78 21 A6 E8         LD HL, MinHandPtrs
 710+ ED7B CD 8A ED         CALL DrawPlazaHandLine
 711+ ED7E
 712+ ED7E                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ ED7E 21 73 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ ED81 7E               LD A, (HL)
 715+ ED82 23               INC HL
 716+ ED83 66               LD H, (HL)
 717+ ED84 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ ED85 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ ED87 C9               RET
 720+ ED88
 721+ ED88              ; Variables locales reloj plaza
 722+ ED88 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ ED89 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ ED8A
 725+ ED8A              ; ==============================================================================
 726+ ED8A              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ ED8A              ; ==============================================================================
 728+ ED8A              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ ED8A              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ ED8A              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ ED8A              ; ==============================================================================
 732+ ED8A              DrawPlazaHandLine:
 733+ ED8A                  ; Indexar en tabla de punteros
 734+ ED8A 87               ADD A, A
 735+ ED8B 4F               LD C, A
 736+ ED8C 06 00            LD B, 0
 737+ ED8E 09               ADD HL, BC
 738+ ED8F 7E               LD A, (HL)
 739+ ED90 23               INC HL
 740+ ED91 66               LD H, (HL)
 741+ ED92 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ ED93
 743+ ED93              .pxLoop:
 744+ ED93 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ ED94 B7               OR A
 746+ ED95 C8               RET Z
 747+ ED96
 748+ ED96                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ ED96 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ ED97 23               INC HL
 751+ ED98 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ ED99 23               INC HL
 753+ ED9A 56               LD D, (HL)                  ; D = mask
 754+ ED9B 23               INC HL
 755+ ED9C E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ ED9D
 757+ ED9D                  ; --- Calcular scanLine (0-15) ---
 758+ ED9D 78               LD A, B
 759+ ED9E E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EDA0 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EDA2 28 02            JR Z, .pxIsTop
 762+ EDA4 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EDA6              .pxIsTop:
 764+ EDA6                  ; A = scanLine (0-15)
 765+ EDA6
 766+ EDA6                  ; --- Calcular colOffset (0 o 1) ---
 767+ EDA6 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EDA7 79               LD A, C
 769+ EDA8 E6 1F            AND $1F                     ; extraer columna
 770+ EDAA D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EDAC 4F               LD C, A                     ; C = colOffset
 772+ EDAD
 773+ EDAD                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EDAD 7B               LD A, E                     ; A = scanLine
 775+ EDAE 87               ADD A, A                    ; *2 (word index)
 776+ EDAF 21 65 8D         LD HL, PlazaScanAddrs
 777+ EDB2 85               ADD A, L
 778+ EDB3 6F               LD L, A
 779+ EDB4 30 01            JR NC, .pxNC
 780+ EDB6 24               INC H
 781+ EDB7              .pxNC:
 782+ EDB7 7E               LD A, (HL)
 783+ EDB8 23               INC HL
 784+ EDB9 66               LD H, (HL)
 785+ EDBA 81               ADD A, C                    ; sumar colOffset
 786+ EDBB 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EDBC
 788+ EDBC                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EDBC 7A               LD A, D
 790+ EDBD 2F               CPL
 791+ EDBE A6               AND (HL)
 792+ EDBF 77               LD (HL), A
 793+ EDC0
 794+ EDC0 E1               POP HL                      ; restaurar puntero datos
 795+ EDC1 18 D0            JR .pxLoop
 796+ EDC3
