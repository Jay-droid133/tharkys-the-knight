 192  6DCD
 193  6DCD                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 194  6DCD                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 195  6DCD                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 196  6DCD                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 197  6DCD                  ;
 198  6DCD                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 199  6DCD                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 200  6DCD                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 201  6DCD                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 202  6DCD                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 203  6DCD                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 204  6DCD                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 6DCD              ; ==============================================================================
   2+ 6DCD              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 6DCD              ; ==============================================================================
   4+ 6DCD              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 6DCD              ; Mientras MagicCompassTimer>0:
   6+ 6DCD              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 6DCD              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 6DCD              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 6DCD              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 6DCD              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 6DCD              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 6DCD              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 6DCD              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 6DCD              ;
  15+ 6DCD              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 6DCD              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 6DCD              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 6DCD              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 6DCD              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 6DCD              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 6DCD              ;
  22+ 6DCD              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 6DCD              ; ==============================================================================
  24+ 6DCD
  25+ 6DCD              ; ==============================================================================
  26+ 6DCD              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 6DCD              ; ==============================================================================
  28+ 6DCD              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 6DCD              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 6DCD              ; Destruye: AF, HL.
  31+ 6DCD              ; ==============================================================================
  32+ 6DCD              ApplyMagicCompassBuff:
  33+ 6DCD 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 6DD0 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 6DD3 3E 01            LD A, 1
  36+ 6DD5 32 C3 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 6DD8 AF               XOR A
  38+ 6DD9 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 6DDC 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 6DDE 32 C5 5F         LD (MagicCompassTickCounter), A
  41+ 6DE1                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  42+ 6DE1                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  43+ 6DE1                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  44+ 6DE1                  ; el futuro se quiere reactivar.
  45+ 6DE1 3E FF            LD A, $FF
  46+ 6DE3 32 C6 5F         LD (MagicCompassJingleIdx), A
  47+ 6DE6                  ; SFX al recoger: sweep ascendente AY canal B. Lasting tiene PIN extra.
  48+ 6DE6 3A CA 82         LD A, (MagicCompassPermanent)
  49+ 6DE9 B7               OR A
  50+ 6DEA C2 DB 6B         JP NZ, AY_PlayLastingPickup         ; lasting: sweep largo + PIN (~1.12s)
  51+ 6DED C3 D0 6B         JP AY_PlayCompassPickup             ; random: sweep corto (~640ms)
  52+ 6DF0
  53+ 6DF0              ; ==============================================================================
  54+ 6DF0              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  55+ 6DF0              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  56+ 6DF0              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  57+ 6DF0              ; ==============================================================================
  58+ 6DF0              ; Entry points:
  59+ 6DF0              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  60+ 6DF0              ;                           muerte / hito cumplido / llegar a sala destino,
  61+ 6DF0              ;                           sites que no saben si la brujula estaba activa.
  62+ 6DF0              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  63+ 6DF0              ;                           por el branch del timeout natural (Timer ya es 0
  64+ 6DF0              ;                           tras el DEC, asi que el check daria RET Z falso
  65+ 6DF0              ;                           positivo y se saltaria el cleanup).
  66+ 6DF0              ; ==============================================================================
  67+ 6DF0              CancelMagicCompass:
  68+ 6DF0 3A CA 82         LD A, (MagicCompassPermanent)
  69+ 6DF3 B7               OR A
  70+ 6DF4 C0               RET NZ                               ; lasting compass: nunca cancelar
  71+ 6DF5 3A BF 5F         LD A, (MagicCompassTimer)
  72+ 6DF8 47               LD B, A
  73+ 6DF9 3A C0 5F         LD A, (MagicCompassTimer + 1)
  74+ 6DFC B0               OR B
  75+ 6DFD C8               RET Z                                ; ya inactivo
  76+ 6DFE                  ; fall through al cleanup compartido
  77+ 6DFE              _DoCancelMagicCompass:
  78+ 6DFE AF               XOR A
  79+ 6DFF 32 BF 5F         LD (MagicCompassTimer), A
  80+ 6E02 32 C0 5F         LD (MagicCompassTimer + 1), A
  81+ 6E05 32 C5 5F         LD (MagicCompassTickCounter), A
  82+ 6E08 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  83+ 6E0B 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  84+ 6E0E 3E FF            LD A, $FF
  85+ 6E10 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  86+ 6E13 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  87+ 6E16 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  88+ 6E19 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  89+ 6E1C 32 BF 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  90+ 6E1F                                                       ; frame: DrawCompass detecta $FF y
  91+ 6E1F                                                       ; entra a .dcRedraw, sustituyendo el
  92+ 6E1F                                                       ; sprite_compass_magic stale por la
  93+ 6E1F                                                       ; brujula clasica (8 flechas + X).
  94+ 6E1F C9               RET
