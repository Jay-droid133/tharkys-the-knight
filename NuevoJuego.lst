4582+ BB6D 87               ADD A, A
4583+ BB6E 87               ADD A, A
4584+ BB6F 87               ADD A, A                            ; cx*8
4585+ BB70 DD 77 03         LD (IX+ENT_POSX), A
4586+ BB73 23               INC HL
4587+ BB74 7E               LD A, (HL)                          ; cy
4588+ BB75 87               ADD A, A
4589+ BB76 87               ADD A, A
4590+ BB77 87               ADD A, A                            ; cy*8
