2796+ AE55              ; ==============================================================================
2797+ AE55              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2798+ AE55              ; ==============================================================================
2799+ AE55              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2800+ AE55              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2801+ AE55              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2802+ AE55              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2803+ AE55              ; ==============================================================================
2804+ AE55              UpdateMonster:
2805+ AE55                  ; --- Stun: knockback + pausa tras golpe del player ---
2806+ AE55 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2807+ AE58 B7               OR A
2808+ AE59 CA 8E B0         JP Z, .moNormal
2809+ AE5C DD 35 0A         DEC (IX+ENT_DIR)
2810+ AE5F 20 0B            JR NZ, .moStunActive
2811+ AE61                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2812+ AE61 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2813+ AE65 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2814+ AE69 C3 8E B0         JP .moNormal
2815+ AE6C
2816+ AE6C              .moStunActive:
2817+ AE6C                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2818+ AE6C FE 06            CP MONSTER_STUN_PAUSE
2819+ AE6E DA 1F B2         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2820+ AE71                  ; Knockback: aplicar movimiento con collision check
2821+ AE71 DD 56 06         LD D, (IX+ENT_DELTAX)
2822+ AE74 DD 5E 07         LD E, (IX+ENT_DELTAY)
2823+ AE77 7A               LD A, D
2824+ AE78 B3               OR E
2825+ AE79 CA 1F B2         JP Z, .moAnimate
2826+ AE7C                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2827+ AE7C D5               PUSH DE
2828+ AE7D DD 7E 03         LD A, (IX+ENT_POSX)
2829+ AE80 32 B7 B3         LD (.moSvX), A
2830+ AE83 DD 7E 04         LD A, (IX+ENT_POSY)
2831+ AE86 32 B8 B3         LD (.moSvY), A
2832+ AE89                  ; Calcular nueva posicion
2833+ AE89 DD 7E 03         LD A, (IX+ENT_POSX)
2834+ AE8C 82               ADD A, D
2835+ AE8D DD 77 03         LD (IX+ENT_POSX), A
2836+ AE90 DD 7E 04         LD A, (IX+ENT_POSY)
2837+ AE93 83               ADD A, E
2838+ AE94 DD 77 04         LD (IX+ENT_POSY), A
2839+ AE97                  ; Comprobar bordes ANTES de colision con paredes
2840+ AE97 DD 7E 03         LD A, (IX+ENT_POSX)
2841+ AE9A FE E8            CP SCREEN_MAX_X
2842+ AE9C 30 30            JR NC, .moKbPreOffscreen
2843+ AE9E FE 04            CP MONSTER_KB_SPEED
2844+ AEA0 38 20            JR C, .moKbPreOffscreenMaybeX
2845+ AEA2              .moKbPreBorderXOk:
2846+ AEA2 DD 7E 04         LD A, (IX+ENT_POSY)
2847+ AEA5 FE A8            CP SCREEN_MAX_Y
2848+ AEA7 30 25            JR NC, .moKbPreOffscreen
2849+ AEA9 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2850+ AEAB 38 1B            JR C, .moKbPreOffscreenMaybeY
2851+ AEAD              .moKbPreBorderOk:
2852+ AEAD                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2853+ AEAD                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2854+ AEAD                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2855+ AEAD                  ; CheckEnemyCollision.
2856+ AEAD                  ; CheckChurchTrap retorna:
2857+ AEAD                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2858+ AEAD                  ;   A=1 -> trampa disparada, cutscene activa: salir.
