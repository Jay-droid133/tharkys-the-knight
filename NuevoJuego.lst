4749+ B92A 30 0E            JR NC, .spPlayerOk                  ; |dx| >= 24 → no overlap posible, skip Y
4750+ B92C 3A A1 81         LD A, (EntityTable + ENT_POSY)
4751+ B92F DD 96 04         SUB (IX+ENT_POSY)
4752+ B932 30 02            JR NC, .spAbsY
4753+ B934 ED 44            NEG
4754+ B936              .spAbsY:
4755+ B936 FE 18            CP 24
4756+ B938 38 44            JR C, .spawnBlocked                 ; |dx| < 24 AND |dy| < 24 → demasiado cerca
4757+ B93A              .spPlayerOk:
4758+ B93A                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4759+ B93A                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4760+ B93A DD E5            PUSH IX
4761+ B93C E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4762+ B93D FD 21 0D 82      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4763+ B941 06 03            LD B, NUM_NASTIES
4764+ B943              .spDistLoop:
4765+ B943 C5               PUSH BC
4766+ B944 E5               PUSH HL
4767+ B945 FD E5            PUSH IY
4768+ B947 D1               POP DE                              ; DE = ptr al slot vecino
4769+ B948 B7               OR A
4770+ B949 ED 52            SBC HL, DE                          ; HL == 0 → mismo slot, skip
4771+ B94B E1               POP HL
4772+ B94C 28 25            JR Z, .spDistNext
4773+ B94E FD 7E 01         LD A, (IY+ENT_TYPE)
4774+ B951 B7               OR A
