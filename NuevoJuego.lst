4976+ BA64              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4977+ BA64              ; ==============================================================================
4978+ BA64              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4979+ BA64              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4980+ BA64              ; ==============================================================================
4981+ BA64              KillAllActiveNasties:
4982+ BA64 DD 21 13 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4983+ BA68 06 03            LD B, NUM_NASTIES
4984+ BA6A              .kanLoop:
4985+ BA6A C5               PUSH BC
4986+ BA6B DD 7E 01         LD A, (IX+ENT_TYPE)
4987+ BA6E B7               OR A
4988+ BA6F 28 26            JR Z, .kanSkip                  ; slot vacio
4989+ BA71 FE 03            CP TYPE_NASTY
4990+ BA73 20 22            JR NZ, .kanSkip                 ; no es nasty
4991+ BA75 DD 7E 02         LD A, (IX+ENT_STATE)
4992+ BA78 FE 03            CP STATE_DYING
4993+ BA7A 28 1B            JR Z, .kanSkip                  ; ya muriendo
4994+ BA7C                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4995+ BA7C                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4996+ BA7C                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4997+ BA7C                  ; del nasty: peDying paintea el rect del puff con ese color)
4998+ BA7C CD A0 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4999+ BA7F DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5000+ BA83 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5001+ BA87 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5002+ BA8B DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5003+ BA8F DD 36 06 00      LD (IX+ENT_DELTAX), 0
5004+ BA93 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5005+ BA97              .kanSkip:
5006+ BA97 11 10 00         LD DE, ENT_SIZE
5007+ BA9A DD 19            ADD IX, DE
5008+ BA9C C1               POP BC
5009+ BA9D 10 CB            DJNZ .kanLoop
5010+ BA9F C9               RET
5011+ BAA0
5012+ BAA0              ; ==============================================================================
5013+ BAA0              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
5014+ BAA0              ; ==============================================================================
5015+ BAA0              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
5016+ BAA0              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
5017+ BAA0              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
5018+ BAA0              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
5019+ BAA0              ; deja la posicion original (puff puede asomar levemente, raro).
5020+ BAA0              ; IN:  IX = nasty entity.
5021+ BAA0              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
5022+ BAA0              ; Destruye: AF, BC, DE, HL.
5023+ BAA0              ; ==============================================================================
5024+ BAA0              SnapPuffPos:
5025+ BAA0 DD 7E 03         LD A, (IX+ENT_POSX)
5026+ BAA3 32 16 BB         LD (.sppOrigX), A
5027+ BAA6 E6 F8            AND $F8
5028+ BAA8 32 18 BB         LD (.sppBaseX), A                   ; base char-aligned X
5029+ BAAB DD 7E 04         LD A, (IX+ENT_POSY)
5030+ BAAE 32 17 BB         LD (.sppOrigY), A
5031+ BAB1 E6 F8            AND $F8
5032+ BAB3 32 19 BB         LD (.sppBaseY), A                   ; base char-aligned Y
5033+ BAB6
5034+ BAB6                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
5035+ BAB6 CD EA BA         CALL .sppCheckFit
5036+ BAB9 C8               RET Z
5037+ BABA
5038+ BABA                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
5039+ BABA                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
5040+ BABA 21 1A BB         LD HL, .sppShifts
5041+ BABD              .sppLoop:
5042+ BABD 7E               LD A, (HL)
5043+ BABE 23               INC HL
5044+ BABF 47               LD B, A                             ; dx (signed)
5045+ BAC0 7E               LD A, (HL)
5046+ BAC1 23               INC HL
5047+ BAC2 FE 80            CP $80
5048+ BAC4 28 17            JR Z, .sppFail                      ; sentinel
5049+ BAC6 4F               LD C, A                             ; dy (signed)
5050+ BAC7
5051+ BAC7 3A 18 BB         LD A, (.sppBaseX)
5052+ BACA 80               ADD A, B
5053+ BACB DD 77 03         LD (IX+ENT_POSX), A
5054+ BACE 3A 19 BB         LD A, (.sppBaseY)
5055+ BAD1 81               ADD A, C
5056+ BAD2 DD 77 04         LD (IX+ENT_POSY), A
5057+ BAD5
5058+ BAD5 E5               PUSH HL
5059+ BAD6 CD EA BA         CALL .sppCheckFit
5060+ BAD9 E1               POP HL
5061+ BADA C8               RET Z                               ; encontrado
5062+ BADB 18 E0            JR .sppLoop
5063+ BADD
5064+ BADD              .sppFail:
5065+ BADD 3A 16 BB         LD A, (.sppOrigX)
5066+ BAE0 DD 77 03         LD (IX+ENT_POSX), A
5067+ BAE3 3A 17 BB         LD A, (.sppOrigY)
5068+ BAE6 DD 77 04         LD (IX+ENT_POSY), A
5069+ BAE9 C9               RET
5070+ BAEA
5071+ BAEA              ; --- .sppCheckFit ---
5072+ BAEA              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5073+ BAEA              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5074+ BAEA              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5075+ BAEA              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5076+ BAEA              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5077+ BAEA              .sppCheckFit:
5078+ BAEA                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5079+ BAEA DD 7E 03         LD A, (IX+ENT_POSX)
5080+ BAED FE D1            CP SCREEN_MAX_X - 23
5081+ BAEF 30 21            JR NC, .sppOutOfBounds
5082+ BAF1 DD 7E 04         LD A, (IX+ENT_POSY)
5083+ BAF4 FE 10            CP SCREEN_MIN_Y
5084+ BAF6 38 1A            JR C, .sppOutOfBounds
5085+ BAF8 FE 91            CP SCREEN_MAX_Y - 23
5086+ BAFA 30 16            JR NC, .sppOutOfBounds
5087+ BAFC                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5088+ BAFC DD 7E 00         LD A, (IX+ENT_SPRITEID)
5089+ BAFF 32 15 BB         LD (.sppSpritIdSave), A
5090+ BB02 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5091+ BB06 CD F4 B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5092+ BB09 F5               PUSH AF
5093+ BB0A 3A 15 BB         LD A, (.sppSpritIdSave)
5094+ BB0D DD 77 00         LD (IX+ENT_SPRITEID), A
5095+ BB10 F1               POP AF
5096+ BB11 C9               RET
5097+ BB12              .sppOutOfBounds:
5098+ BB12 F6 01            OR 1                                ; NZ
5099+ BB14 C9               RET
5100+ BB15
5101+ BB15 00           .sppSpritIdSave: DEFB 0
5102+ BB16
5103+ BB16 00           .sppOrigX: DEFB 0
5104+ BB17 00           .sppOrigY: DEFB 0
5105+ BB18 00           .sppBaseX: DEFB 0
5106+ BB19 00           .sppBaseY: DEFB 0
5107+ BB1A              .sppShifts:
5108+ BB1A                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5109+ BB1A                  ; Distancia creciente. Sentinel: dy=$80.
5110+ BB1A 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5111+ BB1C 00 F8            DEFB 0,   -8                        ; arriba 8
5112+ BB1E 00 08            DEFB 0,    8                        ; abajo 8
5113+ BB20 F8 00            DEFB -8,   0                        ; izq 8
5114+ BB22 08 00            DEFB 8,    0                        ; der 8
5115+ BB24 00 F0            DEFB 0,  -16                        ; arriba 16
5116+ BB26 00 10            DEFB 0,   16                        ; abajo 16
5117+ BB28 F8 F8            DEFB -8,  -8
5118+ BB2A 08 F8            DEFB 8,   -8
5119+ BB2C F8 08            DEFB -8,   8
5120+ BB2E 08 08            DEFB 8,    8
5121+ BB30 00 80            DEFB 0,  $80                        ; sentinel
