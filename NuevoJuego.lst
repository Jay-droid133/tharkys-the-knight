 791+ F2F8              ; ==============================================================================
 792+ F2F8              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 793+ F2F8              ; ==============================================================================
 794+ F2F8              ; IN: DE = ptr a 16 filas x 2 bytes
 795+ F2F8              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 796+ F2F8              ; Destruye: AF, B, HL.
 797+ F2F8              ; ==============================================================================
 798+ F2F8              DrawCompassSprite:
 799+ F2F8                  ; Char row 0 (rows 0-7 del sprite)
 800+ F2F8 26 40            LD H, $40
 801+ F2FA 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 802+ F2FC 06 08            LD B, 8
 803+ F2FE              .dcsRow0:
 804+ F2FE 1A               LD A, (DE)
 805+ F2FF 77               LD (HL), A
 806+ F300 13               INC DE
 807+ F301 23               INC HL
 808+ F302 1A               LD A, (DE)
 809+ F303 77               LD (HL), A
 810+ F304 13               INC DE
 811+ F305 2B               DEC HL
 812+ F306 24               INC H
 813+ F307 10 F5            DJNZ .dcsRow0
 814+ F309                  ; Char row 1 (rows 8-15 del sprite)
 815+ F309 26 40            LD H, $40
 816+ F30B 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F30D 06 08            LD B, 8
 818+ F30F              .dcsRow1:
 819+ F30F 1A               LD A, (DE)
 820+ F310 77               LD (HL), A
 821+ F311 13               INC DE
 822+ F312 23               INC HL
 823+ F313 1A               LD A, (DE)
 824+ F314 77               LD (HL), A
 825+ F315 13               INC DE
 826+ F316 2B               DEC HL
 827+ F317 24               INC H
 828+ F318 10 F5            DJNZ .dcsRow1
 829+ F31A C9               RET
 830+ F31B
 831+ F31B              ; ==============================================================================
 832+ F31B              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 833+ F31B              ; ==============================================================================
 834+ F31B              SetCompassAttrs:
 835+ F31B 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 836+ F31E 77               LD (HL), A
 837+ F31F 23               INC HL
 838+ F320 77               LD (HL), A
 839+ F321 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 840+ F324 77               LD (HL), A
 841+ F325 23               INC HL
 842+ F326 77               LD (HL), A
 843+ F327 C9               RET
