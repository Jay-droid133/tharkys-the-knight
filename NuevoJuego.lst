7343+ C7DE DD 36 07 00      LD (IX+ENT_DELTAY), 0
7344+ C7E2              .bfsAppMove:
7345+ C7E2                  ; Intentar 1 paso con collision check
7346+ C7E2 DD 7E 03         LD A, (IX+ENT_POSX)
7347+ C7E5 32 11 C8         LD (.bfsSvX), A
7348+ C7E8 DD 7E 04         LD A, (IX+ENT_POSY)
7349+ C7EB 32 12 C8         LD (.bfsSvY), A
7350+ C7EE DD 7E 03         LD A, (IX+ENT_POSX)
7351+ C7F1 DD 86 06         ADD A, (IX+ENT_DELTAX)
7352+ C7F4 DD 77 03         LD (IX+ENT_POSX), A
7353+ C7F7 DD 7E 04         LD A, (IX+ENT_POSY)
7354+ C7FA DD 86 07         ADD A, (IX+ENT_DELTAY)
7355+ C7FD DD 77 04         LD (IX+ENT_POSY), A
7356+ C800 CD 7A B6         CALL CheckEnemyCollision
7357+ C803 C8               RET Z
