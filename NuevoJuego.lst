5952+ BFE4              .rmRtReturnDone:
5953+ BFE4 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N                  ; sentinel (!=0 para skip spawn anim)
5954+ BFE8 AF               XOR A
5955+ BFE9 32 1D BF         LD (.rmTimer), A
5956+ BFEC                  ; Memoria de ubicacion: el monster ha vuelto al room actual (Regla 4).
5957+ BFEC                  ; Actualizar MonsterRoomId[slot] = current para que TryRespawnMonsters
5958+ BFEC                  ; lo active en este room. slot = HL - MonsterReturnTimer.
5959+ BFEC E5               PUSH HL
5960+ BFED C5               PUSH BC
5961+ BFEE 11 52 B3         LD DE, MonsterReturnTimer
5962+ BFF1 B7               OR A
