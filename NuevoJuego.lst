 396+ EA31              .dcRedraw:
 397+ EA31                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 398+ EA31 3A 30 82         LD A, (ObjectiveScreenX)
 399+ EA34 47               LD B, A
 400+ EA35 3A 55 82         LD A, (CurrentScreenX)
 401+ EA38 4F               LD C, A
 402+ EA39 78               LD A, B
 403+ EA3A 91               SUB C                               ; A = dx (signed)
 404+ EA3B                  ; abs(dx) -> H, sign(dx)+1 -> L
 405+ EA3B F2 45 EA         JP P, .dcDxNonNeg
 406+ EA3E ED 44            NEG
 407+ EA40 67               LD H, A                             ; abs(dx)
 408+ EA41 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 409+ EA43 18 0A            JR .dcDxDone
 410+ EA45              .dcDxNonNeg:
 411+ EA45 67               LD H, A
 412+ EA46 B7               OR A
 413+ EA47 20 04            JR NZ, .dcDxPositive
 414+ EA49 2E 01            LD L, 1                             ; dx == 0
 415+ EA4B 18 02            JR .dcDxDone
 416+ EA4D              .dcDxPositive:
 417+ EA4D 2E 02            LD L, 2
 418+ EA4F              .dcDxDone:
 419+ EA4F E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 420+ EA50
 421+ EA50                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 422+ EA50 3A 31 82         LD A, (ObjectiveScreenY)
 423+ EA53 47               LD B, A
 424+ EA54 3A 56 82         LD A, (CurrentScreenY)
 425+ EA57 4F               LD C, A
 426+ EA58 78               LD A, B
 427+ EA59 91               SUB C
 428+ EA5A F2 64 EA         JP P, .dcDyNonNeg
 429+ EA5D ED 44            NEG
 430+ EA5F 67               LD H, A
 431+ EA60 2E 00            LD L, 0
 432+ EA62 18 0A            JR .dcDyDone
 433+ EA64              .dcDyNonNeg:
 434+ EA64 67               LD H, A
 435+ EA65 B7               OR A
 436+ EA66 20 04            JR NZ, .dcDyPositive
 437+ EA68 2E 01            LD L, 1
 438+ EA6A 18 02            JR .dcDyDone
 439+ EA6C              .dcDyPositive:
 440+ EA6C 2E 02            LD L, 2
 441+ EA6E              .dcDyDone:
 442+ EA6E                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 443+ EA6E D1               POP DE                              ; D = abs_dx, E = signdx+1
 444+ EA6F                  ; idx = (signdy+1)*3 + (signdx+1)
 445+ EA6F 7D               LD A, L
 446+ EA70 87               ADD A, A
 447+ EA71 85               ADD A, L                            ; A = (signdy+1)*3
 448+ EA72 83               ADD A, E                            ; A = idx (0..8)
 449+ EA73 32 22 EB         LD (.dcSpriteIdx), A
 450+ EA76                  ; distance = abs_dx + abs_dy
 451+ EA76 7A               LD A, D
 452+ EA77 84               ADD A, H
 453+ EA78 32 23 EB         LD (.dcDistance), A
 454+ EA7B
 455+ EA7B                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 456+ EA7B                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 457+ EA7B                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 458+ EA7B                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 459+ EA7B                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 460+ EA7B                  ; nuevo idx.
 461+ EA7B                  ; Counter == 0 -> sin override, idx = target.
 462+ EA7B                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 463+ EA7B                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 464+ EA7B                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 465+ EA7B 3A 22 EB         LD A, (.dcSpriteIdx)
 466+ EA7E FE 04            CP 4
 467+ EA80 20 06            JR NZ, .dcWobbleNotX
 468+ EA82                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 469+ EA82                  ; frame no redibuje innecesariamente.
 470+ EA82 AF               XOR A
 471+ EA83 32 35 82         LD (CompassWobbleCounter), A
 472+ EA86 18 46            JR .dcWobbleEnd
 473+ EA88              .dcWobbleNotX:
 474+ EA88                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 475+ EA88 3A 55 82         LD A, (CurrentScreenX)
 476+ EA8B 47               LD B, A
 477+ EA8C 3A 33 82         LD A, (LastCompassScreenX)
 478+ EA8F B8               CP B
 479+ EA90 20 0A            JR NZ, .dcWobbleStart
 480+ EA92 3A 56 82         LD A, (CurrentScreenY)
 481+ EA95 47               LD B, A
 482+ EA96 3A 34 82         LD A, (LastCompassScreenY)
 483+ EA99 B8               CP B
 484+ EA9A 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 485+ EA9C              .dcWobbleStart:
 486+ EA9C 3E 09            LD A, 9
 487+ EA9E 32 35 82         LD (CompassWobbleCounter), A
 488+ EAA1              .dcWobbleResolve:
 489+ EAA1 3A 35 82         LD A, (CompassWobbleCounter)
 490+ EAA4 B7               OR A
 491+ EAA5 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 492+ EAA7 3D               DEC A
 493+ EAA8 32 35 82         LD (CompassWobbleCounter), A
 494+ EAAB                                                      ; A = phase 0..8 (1 frame por fase)
 495+ EAAB 21 C0 F2         LD HL, WobblePhaseTable
 496+ EAAE 5F               LD E, A
 497+ EAAF 16 00            LD D, 0
 498+ EAB1 19               ADD HL, DE
 499+ EAB2 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 500+ EAB3 FE 02            CP 2
 501+ EAB5 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 502+ EAB7                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 503+ EAB7                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 504+ EAB7 FE 03            CP 3
 505+ EAB9 38 01            JR C, .dcWobbleOffsetReady
 506+ EABB 3D               DEC A
 507+ EABC              .dcWobbleOffsetReady:
 508+ EABC 5F               LD E, A
 509+ EABD 3A 22 EB         LD A, (.dcSpriteIdx)
 510+ EAC0 87               ADD A, A                            ; idx*2
 511+ EAC1 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 512+ EAC2 83               ADD A, E                            ; +offset
 513+ EAC3 21 9C F2         LD HL, CompassWobbleTable
 514+ EAC6 5F               LD E, A
 515+ EAC7 16 00            LD D, 0
 516+ EAC9 19               ADD HL, DE
 517+ EACA 7E               LD A, (HL)
 518+ EACB 32 22 EB         LD (.dcSpriteIdx), A                ; override
 519+ EACE
 520+ EACE              .dcWobbleEnd:
 521+ EACE
 522+ EACE                  ; --- Color ---
 523+ EACE                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 524+ EACE 3A 22 EB         LD A, (.dcSpriteIdx)
 525+ EAD1 FE 04            CP 4
 526+ EAD3 28 18            JR Z, .dcWhite
 527+ EAD5 3A 32 82         LD A, (PreviousObjectiveDistance)
 528+ EAD8 FE FF            CP $FF
 529+ EADA 28 11            JR Z, .dcWhite
 530+ EADC 47               LD B, A
 531+ EADD 3A 23 EB         LD A, (.dcDistance)
 532+ EAE0 B8               CP B
 533+ EAE1 28 0A            JR Z, .dcWhite                      ; igual = blanco
 534+ EAE3 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 535+ EAE5 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 536+ EAE7 18 06            JR .dcColorDone
 537+ EAE9              .dcGreen:
 538+ EAE9 3E 44            LD A, GREEN | $40
 539+ EAEB 18 02            JR .dcColorDone
 540+ EAED              .dcWhite:
 541+ EAED 3E 47            LD A, WHITE | $40
 542+ EAEF              .dcColorDone:
