1061+ ED95              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1062+ ED95              .ucsShakeStatuePhase:
1063+ ED95 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1064+ ED98 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1065+ ED9A 30 35            JR NC, .ucsShakeStatueDone
1066+ ED9C                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1067+ ED9C                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1068+ ED9C                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1069+ ED9C                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1070+ ED9C                  ;
1071+ ED9C                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1072+ ED9C                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1073+ ED9C ED 5F            LD A, R
1074+ ED9E E6 03            AND $03
1075+ EDA0 21 CD ED         LD HL, .ucsShakeJitterTable
1076+ EDA3 5F               LD E, A
1077+ EDA4 16 00            LD D, 0
1078+ EDA6 19               ADD HL, DE
1079+ EDA7 7E               LD A, (HL)
1080+ EDA8 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1081+ EDA9                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1082+ EDA9 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1083+ EDAC FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1084+ EDAE 21 34 67         LD HL, StatueIdTable
1085+ EDB1 38 03            JR C, .ucsShakeTablePicked
1086+ EDB3 21 37 67         LD HL, StatueBrokenIdTable
1087+ EDB6              .ucsShakeTablePicked:
1088+ EDB6 78               LD A, B                                 ; restore jitter para la llamada
1089+ EDB7 CD C4 EE         CALL ChurchCutsceneShakeStatueByteShift
1090+ EDBA                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1091+ EDBA                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1092+ EDBA                  ; y al salir de la fase forzamos borde a negro explicitamente.
1093+ EDBA 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1094+ EDBD E6 01            AND $01
1095+ EDBF 28 04            JR Z, .ucsShakeBorderBlack
1096+ EDC1 3E 07            LD A, WHITE
1097+ EDC3 18 01            JR .ucsShakeBorderOut
1098+ EDC5              .ucsShakeBorderBlack:
1099+ EDC5 AF               XOR A                                   ; BLACK
1100+ EDC6              .ucsShakeBorderOut:
1101+ EDC6 D3 FE            OUT (254), A
1102+ EDC8 21 9D 5F         LD HL, ChurchCutsceneFrame
1103+ EDCB 34               INC (HL)
1104+ EDCC C9               RET
1105+ EDCD              .ucsShakeJitterTable:
1106+ EDCD 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1107+ EDD1              .ucsShakeStatueDone:
1108+ EDD1                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1109+ EDD1 AF               XOR A
1110+ EDD2 D3 FE            OUT (254), A
1111+ EDD4                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1112+ EDD4                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1113+ EDD4                  ; directo a 0 garantiza que no queden residuos.)
1114+ EDD4 CD 2F EF         CALL ChurchCutsceneEraseStatueDirect
1115+ EDD7 21 9D F1         LD HL, SFX_EnemyDeath
1116+ EDDA CD 1E F1         CALL PlaySFX
1117+ EDDD 3E 03            LD A, 3
1118+ EDDF 32 03 82         LD (ChurchCutscenePhase), A
1119+ EDE2 AF               XOR A
1120+ EDE3 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1121+ EDE6 C9               RET
1122+ EDE7
1123+ EDE7              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1124+ EDE7              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1125+ EDE7              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1126+ EDE7              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1127+ EDE7              ; Entre transiciones, solo incrementa frame counter.
1128+ EDE7              .ucsSmokePhase:
1129+ EDE7 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1130+ EDEA B7               OR A
1131+ EDEB 28 0E            JR Z, .ucsSmokeEntry
1132+ EDED FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1133+ EDEF 28 16            JR Z, .ucsSmokeStep1
1134+ EDF1 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1135+ EDF3 28 1D            JR Z, .ucsSmokeStep2
1136+ EDF5 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1137+ EDF7 28 25            JR Z, .ucsSmokeEnd
1138+ EDF9 18 35            JR .ucsSmokeIncFrame
1139+ EDFB              .ucsSmokeEntry:
1140+ EDFB                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1141+ EDFB 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1142+ EDFE CD 5F 68         CALL DrawRemainsForType
