4796+ BC25              .spawnPosOk:
4797+ BC25                  ; Velocidades aleatorias
4798+ BC25 ED 5F            LD A, R
4799+ BC27 CB 57            BIT 2, A
4800+ BC29 28 07            JR Z, .dxPos
4801+ BC2B 3A 55 90         LD A, (CurrentEnemySpeed)
4802+ BC2E ED 44            NEG
4803+ BC30 18 03            JR .setDX
4804+ BC32              .dxPos:
4805+ BC32 3A 55 90         LD A, (CurrentEnemySpeed)
4806+ BC35              .setDX:
