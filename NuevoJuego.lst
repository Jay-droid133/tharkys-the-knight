 215+ 67AA              ; ==============================================================================
 216+ 67AA              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 217+ 67AA              ; ==============================================================================
 218+ 67AA              ; IN: A = frame idx (0..2)
 219+ 67AA              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 220+ 67AA              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 221+ 67AA              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 222+ 67AA              ; Destruye: AF, BC, DE, HL, IX.
 223+ 67AA              ; ==============================================================================
 224+ 67AA              DrawSmokeFrameXor:
 225+ 67AA 87               ADD A, A                                ; *2 (entries de 2 bytes)
 226+ 67AB 6F               LD L, A
 227+ 67AC 26 00            LD H, 0
 228+ 67AE 11 A4 67         LD DE, SmokeFramePtrTable
 229+ 67B1 19               ADD HL, DE
 230+ 67B2 5E               LD E, (HL)
 231+ 67B3 23               INC HL
 232+ 67B4 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 233+ 67B5                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 234+ 67B5                  ; Source y destino accesibles sin paging (milestones bank 0,
 235+ 67B5                  ; BgSpriteBuffer en RAM principal).
 236+ 67B5 EB               EX DE, HL                               ; HL = source
 237+ 67B6 11 0A 89         LD DE, BgSpriteBuffer
 238+ 67B9 01 22 00         LD BC, 34
 239+ 67BC ED B0            LDIR
 240+ 67BE                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 241+ 67BE 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 242+ 67C1 57               LD D, A
 243+ 67C2 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 244+ 67C5 5F               LD E, A
 245+ 67C6 C3 BC 68         JP DrawBgSprite16XorAtPixel
 246+ 67C9
 247+ 67C9              ; ==============================================================================
 248+ 67C9              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 249+ 67C9              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 250+ 67C9              ; ==============================================================================
 251+ 67C9              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 252+ 67C9              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 253+ 67C9              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 254+ 67C9              ; uniformemente negro -- el efecto que pidio el usuario.
 255+ 67C9              ;
 256+ 67C9              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 257+ 67C9              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 258+ 67C9              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 259+ 67C9              ; Destruye: AF, BC, DE, HL.
 260+ 67C9              ; ==============================================================================
 261+ 67C9              ClearSmokeAttrs:
 262+ 67C9                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 263+ 67C9 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 264+ 67CC CB 3F            SRL A
 264+ 67CE CB 3F          SRL A
 264+ 67D0 CB 3F          SRL A                   ; A = char Y (post-HUD)
 265+ 67D2 26 00            LD H, 0
 266+ 67D4 6F               LD L, A
 267+ 67D5 29               ADD HL, HL                              ; *2
 268+ 67D6 29               ADD HL, HL                              ; *4
 269+ 67D7 29               ADD HL, HL                              ; *8
 270+ 67D8 29               ADD HL, HL                              ; *16
 271+ 67D9 29               ADD HL, HL                              ; *32
 272+ 67DA 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 273+ 67DD CB 3F            SRL A
 273+ 67DF CB 3F          SRL A
