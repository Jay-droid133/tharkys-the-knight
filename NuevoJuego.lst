  65+ F981              BCP_KNOCKS_1            EQU 2
  66+ F981              BCP_WAIT_1              EQU 3
  67+ F981              BCP_KNOCKS_2            EQU 4
  68+ F981              BCP_WAIT_2              EQU 5
  69+ F981              BCP_TURN_TO_CAM         EQU 6
  70+ F981              BCP_TURN_TO_DOOR        EQU 7
  71+ F981              BCP_KNOCKS_3            EQU 8
  72+ F981              BCP_WAIT_3              EQU 9
  73+ F981              BCP_PRE_HAND            EQU 10      ; antes BCP_DOOR_OPEN; ahora puerta no se abre
  74+ F981              BCP_HAND_IN             EQU 11
  75+ F981              BCP_HAND_NO_NO          EQU 12
  76+ F981              BCP_HAND_OUT            EQU 13
  77+ F981              BCP_KEY_DROP            EQU 14
  78+ F981              BCP_PLAYER_TURN_CAM     EQU 15
  79+ F981              BCP_DONE                EQU 16
