5401+ BC96              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5402+ BC96              NastyColorTable:
5403+ BC96 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5404+ BC97 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5405+ BC98 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5406+ BC99 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5407+ BC9A 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5408+ BC9B 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5409+ BC9C 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5410+ BC9D 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5411+ BC9E
5412+ BC9E              ; --- Tabla de comportamiento depredador ---
5413+ BC9E              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5414+ BC9E              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5415+ BC9E              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5416+ BC9E              PredatorTable:
5417+ BC9E 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5418+ BC9F 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5419+ BCA0 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5420+ BCA1 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5421+ BCA2 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5422+ BCA3 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5423+ BCA4 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5424+ BCA5 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5425+ BCA6
5426+ BCA6              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5427+ BCA6              PredatorSpeedTable:
5428+ BCA6 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5429+ BCA7 02               DEFB 2                              ; Ciclo 1: lento
5430+ BCA8 03               DEFB 3                              ; Ciclo 2: intermedio
5431+ BCA9 04               DEFB 4                              ; Ciclo 3+: rapido
5432+ BCAA
5433+ BCAA 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5434+ BCAB
5435+ BCAB 8E BC        CurrentNastyTable: DEFW DiurnalTypeTable
5436+ BCAD
5437+ BCAD              ; ==============================================================================
5438+ BCAD              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5439+ BCAD              ; ==============================================================================
5440+ BCAD              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5441+ BCAD              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5442+ BCAD              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5443+ BCAD              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5444+ BCAD              ;   pantalla, no diurnos.
5445+ BCAD              ; ==============================================================================
5446+ BCAD              UpdateNastyTable:
5447+ BCAD 3A 26 E2         LD A, (CurrentTimeOfDay)
5448+ BCB0 FE 02            CP 2
5449+ BCB2 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5450+ BCB4 FE 06            CP 6
5451+ BCB6 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5452+ BCB8 21 92 BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5453+ BCBB 18 03            JR .setTable
5454+ BCBD              .diurnal:
5455+ BCBD 21 8E BC         LD HL, DiurnalTypeTable
5456+ BCC0              .setTable:
5457+ BCC0 22 AB BC         LD (CurrentNastyTable), HL
5458+ BCC3 C9               RET
5459+ BCC4
5460+ BCC4              ; ==============================================================================
5461+ BCC4              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5462+ BCC4              ; ==============================================================================
5463+ BCC4              ScareAllMonsters:
5464+ BCC4 AF               XOR A
5465+ BCC5 32 15 B3         LD (MonstersActive), A              ; No respawnear mas
5466+ BCC8                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5467+ BCC8                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5468+ BCC8                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5469+ BCC8 21 96 8D         LD HL, MonsterAiFlags
5470+ BCCB 06 03            LD B, 3
5471+ BCCD              .samClearLoop:
5472+ BCCD 7E               LD A, (HL)
5473+ BCCE E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5474+ BCD0 77               LD (HL), A
5475+ BCD1 23               INC HL
5476+ BCD2 10 F9            DJNZ .samClearLoop
5477+ BCD4 3E 7D            LD A, SCARE_TIMER_DAWN
5478+ BCD6 32 AB B5         LD (ScareTimer), A
5479+ BCD9                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5480+ BCD9                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5481+ BCD9                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5482+ BCD9                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5483+ BCD9 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5484+ BCDD 06 06            LD B, NUM_MONSTERS
5485+ BCDF              .samStateLoop:
5486+ BCDF DD 7E 01         LD A, (IX+ENT_TYPE)
5487+ BCE2 FE 02            CP TYPE_MONSTER
5488+ BCE4 20 1B            JR NZ, .samStateNext
5489+ BCE6 DD 7E 02         LD A, (IX+ENT_STATE)
5490+ BCE9 FE 03            CP STATE_DYING
5491+ BCEB 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5492+ BCED FE 04            CP STATE_SPAWNING
5493+ BCEF 28 10            JR Z, .samStateNext
5494+ BCF1 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5495+ BCF5 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5496+ BCF9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5497+ BCFD DD 36 07 00      LD (IX+ENT_DELTAY), 0
5498+ BD01              .samStateNext:
5499+ BD01 11 10 00         LD DE, ENT_SIZE
5500+ BD04 DD 19            ADD IX, DE
5501+ BD06 10 D7            DJNZ .samStateLoop
5502+ BD08 C9               RET
5503+ BD09
5504+ BD09              ; ==============================================================================
5505+ BD09              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5506+ BD09              ; ==============================================================================
5507+ BD09              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5508+ BD09              ; ==============================================================================
5509+ BD09
5510+ BD09              ; ==============================================================================
5511+ BD09              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5512+ BD09              ; ==============================================================================
5513+ BD09              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5514+ BD09              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5515+ BD09              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5516+ BD09              ; ==============================================================================
5517+ BD09              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5518+ BD09              ; ==============================================================================
5519+ BD09              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5520+ BD09              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5521+ BD09              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5522+ BD09              ; ==============================================================================
5523+ BD09              MONSTERS_TO_SPAWN   EQU 3
5524+ BD09              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5525+ BD09              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5526+ BD09
5527+ BD09              ; ==============================================================================
5528+ BD09              ; SpawnMonsters - Primera aparicion tras campanadas
5529+ BD09              ; ==============================================================================
5530+ BD09              SpawnMonsters:
5531+ BD09                  IF DEBUG_NO_ENEMIES
5532+ BD09 ~                RET
5533+ BD09                  ENDIF
5534+ BD09 3A 15 B3         LD A, (MonstersActive)
5535+ BD0C B7               OR A
5536+ BD0D C0               RET NZ
5537+ BD0E                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5538+ BD0E                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5539+ BD0E CD EA B9         CALL KillAllActiveNasties
5540+ BD11 3E 01            LD A, 1
5541+ BD13 32 15 B3         LD (MonstersActive), A
5542+ BD16 CD 95 BD         CALL ShuffleMonsterTypes
5543+ BD19 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5544+ BD1D 06 03            LD B, MONSTERS_TO_SPAWN
5545+ BD1F 0E 00            LD C, 0
5546+ BD21              .smLoop:
5547+ BD21 C5               PUSH BC
5548+ BD22 DD 7E 01         LD A, (IX+ENT_TYPE)
5549+ BD25 B7               OR A
5550+ BD26 C2 82 BD         JP NZ, .smSkip
5551+ BD29                  ; Asignar tipo y color
5552+ BD29 79               LD A, C
5553+ BD2A 21 F9 BD         LD HL, MonsterTypeTable
5554+ BD2D 5F               LD E, A
5555+ BD2E 16 00            LD D, 0
5556+ BD30 19               ADD HL, DE
5557+ BD31 7E               LD A, (HL)
5558+ BD32 DD 77 08         LD (IX+ENT_ANIMBASE), A
5559+ BD35 79               LD A, C
5560+ BD36 21 FC BD         LD HL, MonsterColorTable
5561+ BD39 5F               LD E, A
5562+ BD3A 16 00            LD D, 0
5563+ BD3C 19               ADD HL, DE
5564+ BD3D 7E               LD A, (HL)
5565+ BD3E DD 77 05         LD (IX+ENT_ATTR), A
5566+ BD41                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5567+ BD41 C5               PUSH BC
5568+ BD42 CD BB 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5569+ BD45 B7               OR A
5570+ BD46 20 0E            JR NZ, .smFallbackPos
5571+ BD48 3A C3 97         LD A, (MaiSpawnX)
5572+ BD4B DD 77 03         LD (IX+ENT_POSX), A
5573+ BD4E 3A C4 97         LD A, (MaiSpawnY)
5574+ BD51 DD 77 04         LD (IX+ENT_POSY), A
5575+ BD54 18 0C            JR .smPosDone
5576+ BD56              .smFallbackPos:
5577+ BD56 3A 11 83         LD A, (LastEntryPosX)
5578+ BD59 DD 77 03         LD (IX+ENT_POSX), A
5579+ BD5C 3A 12 83         LD A, (LastEntryPosY)
5580+ BD5F DD 77 04         LD (IX+ENT_POSY), A
5581+ BD62              .smPosDone:
5582+ BD62 C1               POP BC
5583+ BD63                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5584+ BD63 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5585+ BD67 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5586+ BD6B DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5587+ BD6F DD 36 06 00      LD (IX+ENT_DELTAX), 0
5588+ BD73 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5589+ BD77                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5590+ BD77                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5591+ BD77                  ; lo empuje a un vecino (migracion por knockback).
5592+ BD77 CD B0 8E         CALL MaiGetCurrentScreenId
5593+ BD7A 21 8A 8D         LD HL, MonsterRoomId
5594+ BD7D 59               LD E, C
5595+ BD7E 16 00            LD D, 0
5596+ BD80 19               ADD HL, DE
5597+ BD81 77               LD (HL), A
5598+ BD82              .smSkip:
