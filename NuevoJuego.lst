4783+ BD44 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4784+ BD48 DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4785+ BD4C DD 36 06 00      LD (IX+ENT_DELTAX), 0
4786+ BD50 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4787+ BD54 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
4788+ BD58              .kamSkip:
4789+ BD58 11 10 00         LD DE, ENT_SIZE
4790+ BD5B DD 19            ADD IX, DE
4791+ BD5D C1               POP BC
4792+ BD5E 10 C6            DJNZ .kamLoop
4793+ BD60 C9               RET
