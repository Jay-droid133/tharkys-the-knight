3006+ AF96 DD 7E 07         LD A, (IX+ENT_DELTAY)
3007+ AF99 CB 7F            BIT 7, A
3008+ AF9B 28 02            JR Z, .moKbAbsDyOk
3009+ AF9D ED 44            NEG
3010+ AF9F              .moKbAbsDyOk:
3011+ AF9F                  ; A = |dy|, B = |dx|
3012+ AF9F B8               CP B
3013+ AFA0 30 30            JR NC, .moKbPrimY                   ; |dy| >= |dx| → Y primario
3014+ AFA2              .moKbPrimX:
3015+ AFA2                  ; Eje primario X → clamp X, mantener Y (clampeado al rango valido)
3016+ AFA2 DD 7E 06         LD A, (IX+ENT_DELTAX)
3017+ AFA5 CB 7F            BIT 7, A
3018+ AFA7 20 08            JR NZ, .moKbExitLeft
3019+ AFA9 DD 36 03 E7      LD (IX+ENT_POSX), SCREEN_MAX_X - 1
3020+ AFAD 3E 04            LD A, DIR_E
3021+ AFAF 18 06            JR .moKbClampY
3022+ AFB1              .moKbExitLeft:
3023+ AFB1 DD 36 03 00      LD (IX+ENT_POSX), 0
3024+ AFB5 3E 08            LD A, DIR_W
3025+ AFB7              .moKbClampY:
3026+ AFB7                  ; Proteger POSY: si el drift lo saco de rango, clamparlo al borde
3027+ AFB7 4F               LD C, A                             ; C = DIR_E/W
3028+ AFB8 DD 7E 04         LD A, (IX+ENT_POSY)
3029+ AFBB FE A8            CP SCREEN_MAX_Y
3030+ AFBD 38 07            JR C, .moKbClampYHigh
3031+ AFBF                  ; POSY >= MAX (salio abajo o underflow): clamp a MAX-1
