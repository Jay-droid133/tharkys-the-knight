  11  0000                  ; EQUs de variables ubicadas en low-RAM ($5D00+). No emiten bytes;
  12  0000                  ; el zero-fill + defaults se hace en Inicio: antes del primer uso.
  13  0000                  INCLUDE "variables_lo.asm"
# file opened: variables_lo.asm
   1+ 0000              ; ==============================================================================
   2+ 0000              ; LOW-RAM VARIABLES — ubicadas en $5D00+ via EQU (no emiten bytes al .tap)
   3+ 0000              ; ==============================================================================
   4+ 0000              ; Reubicacion fase A del plan de ampliacion de bank 2 (mem/expand-bank2):
   5+ 0000              ; mover los buffers/scratch que solo se acceden en cold paths a la zona libre
   6+ 0000              ; del bank 5 ($5800-$7FFF). $4000-$5AFF es VRAM; $5B00-$5CCB es system area
   7+ 0000              ; del 128 (printer buffer + system vars). Empezamos en $5D00 con margen.
   8+ 0000              ;
   9+ 0000              ; IMPORTANTE: los simbolos son EQU, asi que NO se emite ningun byte al .tap.
  10+ 0000              ; El loader deja la zona con valores indeterminados; Inicio: hace zero-fill
  11+ 0000              ; de [LOW_RAM_BASE, LOW_RAM_END) y luego pone los defaults no-cero.
  12+ 0000              ;
  13+ 0000              ; Solo entran aqui variables cuya frecuencia de acceso es practicamente nula
  14+ 0000              ; durante el inner loop. La memoria de $5D00-$7FFF es CONTENDED, asi que
  15+ 0000              ; cualquier variable hot debe seguir en bank 2 ($8000-$BFFF, no-contended).
  16+ 0000              ; ==============================================================================
  17+ 0000
  18+ 0000              LOW_RAM_BASE        EQU $5D00
  19+ 0000
  20+ 0000              ; --- Zone cell list: solo se construye al cambiar de sala (BuildZoneCellList) ---
  21+ 0000              ; y se lee en SpawnOneNasty. Cold path (transition + spawn).
  22+ 0000              ZoneCellCount       EQU LOW_RAM_BASE
  23+ 0000              ZoneCellList        EQU ZoneCellCount + 1            ; DEFS 255 * 2
  24+ 0000
  25+ 0000              ; --- BFS rescue de la muerte: solo se dispara cuando StuckCounter llega a 6 ---
  26+ 0000              DBfsQueue           EQU ZoneCellList + 510           ; DEFS 108
  27+ 0000              DBfsQHead           EQU DBfsQueue + 108              ; DEFW
  28+ 0000              DBfsQTail           EQU DBfsQHead + 2                ; DEFW
  29+ 0000              DBfsBestDir         EQU DBfsQTail + 2                ; DEFB
  30+ 0000              DBfsBestDepth       EQU DBfsBestDir + 1
  31+ 0000              DBfsBestManh        EQU DBfsBestDepth + 1
  32+ 0000              DBfsPlayerCx        EQU DBfsBestManh + 1
  33+ 0000              DBfsPlayerCy        EQU DBfsPlayerCx + 1
  34+ 0000              DBfsCurCx           EQU DBfsPlayerCy + 1
  35+ 0000              DBfsCurCy           EQU DBfsCurCx + 1
  36+ 0000              DBfsCurFirstDir     EQU DBfsCurCy + 1
  37+ 0000              DBfsCurDepth        EQU DBfsCurFirstDir + 1
  38+ 0000              DBfsTryCx           EQU DBfsCurDepth + 1
  39+ 0000              DBfsTryCy           EQU DBfsTryCx + 1
  40+ 0000              DBfsTryDir          EQU DBfsTryCy + 1
  41+ 0000
  42+ 0000              ; --- Pending erase list: la usa EraseDeadSprites; cuenta>0 es muy raro ---
  43+ 0000              PendingEraseCount   EQU DBfsTryDir + 1
  44+ 0000              PendingEraseSlots   EQU PendingEraseCount + 1        ; DEFS 3 * 5
  45+ 0000
  46+ 0000              ; --- Monster AI v2 cold state: solo se accede en transicion / scared ---
  47+ 0000              RoomHistory         EQU PendingEraseSlots + 15       ; DEFB 0,0,0
  48+ 0000              MonsterLastSeenRoom EQU RoomHistory + 3              ; DEFB $FF,$FF,$FF (init explicito)
  49+ 0000              MonsterLastSeenX    EQU MonsterLastSeenRoom + 3
  50+ 0000              MonsterLastSeenY    EQU MonsterLastSeenX + 3
  51+ 0000              MonsterShakeOrigX   EQU MonsterLastSeenY + 3
  52+ 0000              MonsterShakeOrigY   EQU MonsterShakeOrigX + 3
  53+ 0000
  54+ 0000              ; --- Cutscene de iglesia: solo accede cuando ChurchCutscenePhase != 0 ---
  55+ 0000              ; ChurchCutscenePhase se queda en bank 2 (lo lee MainLoop cada frame).
  56+ 0000              ChurchCutsceneFrame      EQU MonsterShakeOrigY + 3
  57+ 0000              ChurchCutsceneSlot       EQU ChurchCutsceneFrame + 1
  58+ 0000              ChurchCutsceneTypeIdx    EQU ChurchCutsceneSlot + 1
  59+ 0000              ChurchCutsceneStatueOrigX EQU ChurchCutsceneTypeIdx + 1
  60+ 0000              ChurchCutsceneStatueOrigY EQU ChurchCutsceneStatueOrigX + 1
  61+ 0000              ChurchCutsceneStatueLastX EQU ChurchCutsceneStatueOrigY + 1
  62+ 0000              ChurchCutsceneStatueLastY EQU ChurchCutsceneStatueLastX + 1
  63+ 0000              ChurchCutsceneLookCount  EQU ChurchCutsceneStatueLastY + 1
  64+ 0000
  65+ 0000              ; --- Cutscene final (M9): solo se accede cuando TownGatePhase != 0 ---
  66+ 0000              ; TownGatePhase vive en variables.asm (HOT, lo lee MainLoop cada frame).
  67+ 0000              TownGateTimer            EQU ChurchCutsceneLookCount + 1
  68+ 0000              TownGateShakeOffsX       EQU TownGateTimer + 1            ; signed -1 / 0 / +1
  69+ 0000              TownGateShakeOffsY       EQU TownGateShakeOffsX + 1
  70+ 0000              TownGateExitStepCnt      EQU TownGateShakeOffsY + 1       ; frames hasta sig. step
  71+ 0000              TownGateExitWalkFrame    EQU TownGateExitStepCnt + 1      ; toggle 0/1 anim WALK_S
  72+ 0000              TownGateEndDrawn         EQU TownGateExitWalkFrame + 1    ; 1 = "The End" sprite ya pintado este episodio (one-shot al pasar POSY arch top)
  73+ 0000
  74+ 0000              ; --- Random pickups: estado de la sala actual ---
  75+ 0000              ; Solo se accede en room-enter (UpdateRandomPickup). Cold path.
  76+ 0000              ;
  77+ 0000              ; Mecanismo: los markers (id RANDOM_SLOT_MARKER=210) viven en el BG stream de
  78+ 0000              ; cada room (screen_rooms.asm) — pintados en plantillas, propagados a siblings
  79+ 0000              ; via auto-sync de la library. El engine los trata como ghost: skipea render
  80+ 0000              ; en sprLoop y collision en bcmLoop. UpdateRandomPickup, en cada transicion:
  81+ 0000              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
  82+ 0000              ;      id=210. Acumula (charX, charY) en RandomSlotList.
  83+ 0000              ;   2. RNG sobre count: elige un slot.
  84+ 0000              ;   3. RNG sobre PROB_*_END: rolea tipo (life/health/stamina/none).
  85+ 0000              ;   4. Si type != none: rellena RandomSyntheticEntry con la pickup elegida en
  86+ 0000              ;      la posicion del slot. Si type == none o count == 0: marca inactiva ($FE).
  87+ 0000              ;
  88+ 0000              ; pkDrawLoop renderiza RandomSyntheticEntry como pickup adicional al final.
  89+ 0000              ; CheckPickupCollect testea AABB y dispatcha al GiveX al final.
  90+ 0000
  91+ 0000              ; SlotList: hasta RANDOM_SLOT_MAX pares (charX, charY) de markers encontrados
  92+ 0000              ; en la sala actual. SlotCount = cuantos slots validos hay.
  93+ 0000              RandomSlotCount         EQU TownGateEndDrawn + 1            ; 0..RANDOM_SLOT_MAX
  94+ 0000              RandomSlotList          EQU RandomSlotCount + 1             ; RANDOM_SLOT_MAX * 2 = 8 bytes (charX,charY)
  95+ 0000
  96+ 0000              ; RandomSyntheticEntry: 7 bytes con formato de PickupTable entry. Vive en RAM
  97+ 0000              ; para que pkDrawLoop/cpLoop puedan modificarla. mapX=$FE = inactivo.
  98+ 0000              RandomSynthMapX         EQU RandomSlotList + (4 * 2)        ; mapX (=$FE inactivo)
  99+ 0000              RandomSynthMapY         EQU RandomSynthMapX + 1
 100+ 0000              RandomSynthPtr          EQU RandomSynthMapY + 1             ; DEFW (BgGfx_<type>)
 101+ 0000              RandomSynthCharX        EQU RandomSynthPtr + 2
 102+ 0000              RandomSynthCharY        EQU RandomSynthCharX + 1
 103+ 0000              RandomSynthTint         EQU RandomSynthCharY + 1            ; 255 = sin tint
 104+ 0000              ; Attr byte raw extraido del sprite al activar el synth. Lo usa
 105+ 0000              ; PaintSynthPickupAttrs para pintar los 4 chars del 2x2 sin pasar por el
 106+ 0000              ; remap dia/noche → respeta el color que el usuario puso en el BG editor.
 107+ 0000              RandomSynthAttr         EQU RandomSynthTint + 1
 108+ 0000
 109+ 0000              ; --- Roulette: estado del ciclado del random pickup tipo "ruleta" ---
 110+ 0000              ; RouletteActive=1 mientras el synth pickup esta en modo roulette (cicla
 111+ 0000              ; tipos cada ROULETTE_CYCLE_FRAMES). UpdateRoulette tickea el counter y al
 112+ 0000              ; expirar avanza idx en RouletteOrder, recarga sprite + attr del nuevo tipo.
 113+ 0000              RouletteActive          EQU RandomSynthAttr + 1            ; 0=off, 1=on
 114+ 0000              RouletteIdx             EQU RouletteActive + 1             ; 0..ROULETTE_ORDER_LEN-1
 115+ 0000              RouletteFrameCounter    EQU RouletteIdx + 1                ; tick-down
 116+ 0000
 117+ 0000              ; --- Random pickup memory cache (anti-reroll por cambio de sala) ---
 118+ 0000              ; Recuerda el resultado del roll de las DOS ultimas salas visitadas. Al entrar
 119+ 0000              ; a una sala, si coincide con cur o prev, se RESTAURA el roll original (mismo
 120+ 0000              ; slot, mismo tipo) en vez de rerollear. Cuando el player consume el pickup
 121+ 0000              ; (CheckRandomSyntheticPickup hit), se zappea cur.rolled = ROLLED_NONE → al
 122+ 0000              ; volver, no respawnea. Cold path: leido/escrito solo en transicion (1 vez).
 123+ 0000              ;
 124+ 0000              ; Layout cur/prev: 4 bytes cada uno (mapX, mapY, slotIdx, rolled).
 125+ 0000              ;   mapX = $FF -> entrada vacia (default tras init).
 126+ 0000              ;   slotIdx = indice en RandomSlotList tras escan del BG stream.
 127+ 0000              ;   rolled = ROLLED_* (0=NONE/consumido, 1..8 = LIFE/HEALTH/.../COMPASS).
 128+ 0000              ;
 129+ 0000              ; "Scratch new" (NewSlot/NewType): valores pendientes para escribir a cur al
 130+ 0000              ; final de UpdateRandomPickup. La rotacion (prev<-cur) ocurre antes del write
 131+ 0000              ; final, por lo que necesitamos un buffer estable para los nuevos datos.
 132+ 0000              RandomCacheCurX         EQU RouletteFrameCounter + 1       ; mapX ($FF=vacio)
 133+ 0000              RandomCacheCurY         EQU RandomCacheCurX + 1
 134+ 0000              RandomCacheCurSlot      EQU RandomCacheCurY + 1
 135+ 0000              RandomCacheCurType      EQU RandomCacheCurSlot + 1         ; ROLLED_*
 136+ 0000
 137+ 0000              RandomCachePrevX        EQU RandomCacheCurType + 1         ; mapX ($FF=vacio)
 138+ 0000              RandomCachePrevY        EQU RandomCachePrevX + 1
 139+ 0000              RandomCachePrevSlot     EQU RandomCachePrevY + 1
 140+ 0000              RandomCachePrevType     EQU RandomCachePrevSlot + 1
 141+ 0000
 142+ 0000              RandomCacheNewSlot      EQU RandomCachePrevType + 1        ; scratch
 143+ 0000              RandomCacheNewType      EQU RandomCacheNewSlot + 1         ; scratch
 144+ 0000
 145+ 0000              ; --- Magic Compass: power-up que muestra ruta exacta sala-a-sala ---
 146+ 0000              ; Recogido por el player (ID34, "compass pickup"). Mientras MagicCompassTimer>0:
 147+ 0000              ;   - DrawCompass override: flecha apunta a la salida correcta (BFS reverse
 148+ 0000              ;     desde ObjectiveScreen hasta CurrentScreen via ScreenGapsTable).
 149+ 0000              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en los ultimos 5s).
 150+ 0000              ;   - SFX: jingle al recoger + tick heartbeat 1/s (2/s en warning).
 151+ 0000              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
 152+ 0000              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
 153+ 0000              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
 154+ 0000              ;
 155+ 0000              ; Cold-ish: leido cada frame mientras activo, no-op en frames inactivos.
 156+ 0000              ; 8 bytes total. Variables_lo.asm justifica la zona contended porque el
 157+ 0000              ; coste real son 3 lecturas/frame (timer + path_dir + blink_phase) ~= 30 T.
 158+ 0000              MagicCompassTimer       EQU RandomCacheNewType + 1         ; DEFW. 0 = inactivo
 159+ 0000              MagicCompassPathDir     EQU MagicCompassTimer + 2          ; 0=N,1=E,2=S,3=W,$FF=no path
 160+ 0000              MagicCompassPathDirty   EQU MagicCompassPathDir + 1        ; 1 = recalcular en update
 161+ 0000              MagicCompassTickActiveFrames EQU MagicCompassPathDirty + 1 ; frames restantes del tick "audible".
 162+ 0000                                                                          ; Se setea a MAGIC_COMPASS_TICK_DURATION en
 163+ 0000                                                                          ; cada disparo de tick y decrementa cada frame.
 164+ 0000                                                                          ; >0 = pitido sonando = char activo bright ON.
 165+ 0000                                                                          ; =0 = silencio = bright OFF.
 166+ 0000              MagicCompassTickCounter EQU MagicCompassTickActiveFrames + 1 ; frames hasta sig. AY tick
 167+ 0000              MagicCompassJingleIdx   EQU MagicCompassTickCounter + 1    ; 0..N-1 activo, $FF inactivo
 168+ 0000              MagicCompassJingleFrames EQU MagicCompassJingleIdx + 1     ; frames hasta sig. nota
 169+ 0000
 170+ 0000              ; --- Magic compass BFS multi-componente ---
 171+ 0000              ; El BFS opera con state (sid, comp_local). Comp_local 0..2 indica zona
 172+ 0000              ; walkable interna de la sala (re-indexada por tamaño descendente — comp 0
 173+ 0000              ; = la principal). Aquí solo viven head/tail + LastEntrySide; el grueso
 174+ 0000              ; del scratch (visited bitmap + cola) está en slot 1 ($7000+) declarado
 175+ 0000              ; junto al código del BFS para no empujar LOW_RAM_END > $6000.
 176+ 0000              MagicCompassBfsHead      EQU MagicCompassJingleFrames + 1   ; uint8 wrap mod 64
 177+ 0000              MagicCompassBfsTail      EQU MagicCompassBfsHead + 1        ; uint8 wrap mod 64
 178+ 0000
 179+ 0000              ; LastEntrySide: side por el que el player entró a la sala actual (0=N,1=S,
 180+ 0000              ; 2=W,3=E, $FF=sin entrada / boot / respawn). CheckScreenTransition lo set al
 181+ 0000              ; cruzar borde. ComputeMagicCompassPath lo lee para decidir el comp inicial
 182+ 0000              ; del player al iniciar el BFS reverse. Cold path (1 lectura por transición).
 183+ 0000              LastEntrySide            EQU MagicCompassBfsTail + 1        ; uint8
 184+ 0000              ; LastEntryCoord: coord aproximado del char por el que entró el player.
 185+ 0000              ;   - Cruzó N o S → POSX / 8 (charX, 0..29).
 186+ 0000              ;   - Cruzó W o E → (POSY - 16) / 8 (charY top-left, 0..19).
 187+ 0000              ; Necesario para desambiguar cuando una sala tiene múltiples gaps en el
 188+ 0000              ; mismo side pero distintos comps (e.g. (5,12) con E@3 comp 1 y E@11 comp 0).
 189+ 0000              LastEntryCoord           EQU LastEntrySide + 1              ; uint8
 190+ 0000              ; LastMagicCompassDrawn: cache del PathDir del último frame que dibujó el
 191+ 0000              ; sprite Sprite_Compass_Magic. $FF = sprite no dibujado (magic inactiva o
 192+ 0000              ; pantalla recién cargada). Permite saltarse el re-vuelco de 32 bytes pixel
 193+ 0000              ; cada frame mientras magic está activa: si el path no cambió, solo pintamos
 194+ 0000              ; los 4 attrs. Reduce CPU durante el wobble (9 frames post-transición) y
 195+ 0000              ; libera presupuesto del frame para que las agujas del reloj no parpadeen.
 196+ 0000              LastMagicCompassDrawn    EQU LastEntryCoord + 1             ; uint8 ($FF=invalid)
 197+ 0000              ; MagicCompassBfsState: 0 = BFS idle. 1 = BFS in progress (queue+visited
 198+ 0000              ; persistidos entre frames). El BFS se amortiza en chunks de
 199+ 0000              ; MAGIC_COMPASS_BFS_ITERS_PER_FRAME (8) iteraciones para evitar gastar
 200+ 0000              ; >10000 T-states de golpe en un único frame post-transición — eso quitaría
 201+ 0000              ; presupuesto al renderizado del HUD y haría parpadear las agujas del reloj.
 202+ 0000              MagicCompassBfsState     EQU LastMagicCompassDrawn + 1      ; uint8
 203+ 0000
 204+ 0000              LOW_RAM_END         EQU LastEntrySide + 1
 205+ 0000              LOW_RAM_SIZE        EQU LOW_RAM_END - LOW_RAM_BASE
 206+ 0000
# file closed: variables_lo.asm
  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD 3A 6A         CALL InitPaging
  34  6007 CD BE 9B         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 E9 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 D3 02         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; RandomSynthMapX = $FE (inactivo: no hay random pickup spawneado al boot).
  62  602B                  ; MagicCompassJingleIdx = $FF (inactivo). MagicCompassPathDir = $FF (no path).
  63  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  64  602B 3E FF            LD A, $FF
  65  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  66  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  67  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  68  6036 32 CF 5F         LD (MagicCompassJingleIdx), A
  69  6039 32 CB 5F         LD (MagicCompassPathDir), A
  70  603C 32 D3 5F         LD (LastEntrySide), A               ; sin entry side al boot → BFS fallback comp 0
  71  603F 32 D4 5F         LD (LastEntryCoord), A              ; sin coord (irrelevant si LastEntrySide=$FF)
  72  6042 32 D5 5F         LD (LastMagicCompassDrawn), A       ; sprite no dibujado todavía
  73  6045 AF               XOR A
  74  6046 32 D6 5F         LD (MagicCompassBfsState), A        ; BFS idle al boot
  75  6049 3E FE            LD A, $FE
  76  604B 32 B4 5F         LD (RandomSynthMapX), A
  77  604E
  78  604E                  ; Random pickup cache: cur/prev empiezan vacios ($FF) — ningun lookup
  79  604E                  ; matcheara hasta que se entre a una sala y se rotee. Slot/Type defaults
  80  604E                  ; a 0 estan bien (zero-fill cubre el resto). El init explicito de $FF
  81  604E                  ; es necesario porque la sala (0,0) es valida y un cur.X=0 default
  82  604E                  ; provocaria un hit espurio en la primera transicion al exterior.
  83  604E 3E FF            LD A, $FF
  84  6050 32 BF 5F         LD (RandomCacheCurX), A
  85  6053 32 C3 5F         LD (RandomCachePrevX), A
  86  6056
  87  6056                  ; Inicializar sistema de pantallas
  88  6056 CD 47 CC         CALL InitGameState      ; Reset variables de gameplay (idempotente)
  89  6059 CD 98 CF         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  90  605C CD C9 A1         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  91  605F CD B7 E5         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  92  6062 CD 06 C0         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  93  6065 CD C8 F1         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  94  6068                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  95  6068
  96  6068 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  97  606A FB               EI                      ; Habilitar interrupciones
  98  606B 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  99  606D 32 4A 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
 100  6070 C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
 101  6073
 102  6073                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
 103  6073                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
 104  6073                  ; contention pero solo durante la cinematica final, una vez por partida —
 105  6073                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
 106  6073                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
 107  6073                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
 108  6073                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
 109  6073                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
 110  6073                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 6073              ; ==============================================================================
   2+ 6073              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6073              ; ==============================================================================
   4+ 6073              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6073              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6073              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6073              ;
   8+ 6073              ; Esquema de fases:
   9+ 6073              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6073              ;   2 ARM_IN       arm aparece, pausa
  11+ 6073              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6073              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6073              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6073              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6073              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6073              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6073              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6073              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6073              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6073              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6073              ;  13 END_HOLD     "The End" sprite hold
  22+ 6073              ;  14 BLACK        wipe a negro + hold
  23+ 6073              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6073              ;
  25+ 6073              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6073              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6073              ; ==============================================================================
  28+ 6073
  29+ 6073              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6073              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6073              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6073              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6073              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6073              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6073              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6073              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6073              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 6073              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 6073              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 6073
  41+ 6073              ; --- Posiciones (pixel) ---
  42+ 6073              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 6073              TGCS_ANCHOR1_Y         EQU 80
  44+ 6073              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 6073              TGCS_END_CHARY         EQU 4
  46+ 6073              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 6073
  48+ 6073              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 6073              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 6073              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 6073              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 6073              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 6073              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 6073              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 6073              TGCS_ARM_PX_X          EQU 136
  56+ 6073              TGCS_ARM_PX_Y          EQU 64
  57+ 6073              TGCS_FINGER_PX_X       EQU 136
  58+ 6073              TGCS_FINGER_PX_Y       EQU 56
