 538+ E654              ; ==============================================================================
 539+ E654              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E654              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E654              ; ==============================================================================
 542+ E654              DrawDayCycleHUD:
 543+ E654                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E654 21 12 E9         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E657 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E65A CD C9 E6         CALL .drawChar
 547+ E65D 21 1A E9         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E660 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E663 CD C9 E6         CALL .drawChar
 550+ E666 21 22 E9         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E669 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E66C CD C9 E6         CALL .drawChar
 553+ E66F                  ; Col 7 = espacio (limpiar)
 554+ E66F 11 07 40         LD DE, $4007
 555+ E672 CD D2 E6         CALL .clearChar
