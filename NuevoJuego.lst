 278+ 8CF0              ; ==============================================================================
 279+ 8CF0              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 280+ 8CF0              ; ==============================================================================
 281+ 8CF0              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 282+ 8CF0              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 283+ 8CF0              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 284+ 8CF0              ; ==============================================================================
 285+ 8CF0              ProcessEnemies:
 286+ 8CF0 3E 00            LD A, 0
 287+ 8CF2 32 3B 8D         LD (.peCount), A
 288+ 8CF5 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 289+ 8CF7
 290+ 8CF7              .peLoop:
 291+ 8CF7 C5               PUSH BC
 292+ 8CF8
 293+ 8CF8                  ; Calcular IX desde EnemyStepIdx
 294+ 8CF8 3A 96 81         LD A, (EnemyStepIdx)
 295+ 8CFB C6 01            ADD A, SLOT_MONSTER0
 296+ 8CFD 6F               LD L, A
 297+ 8CFE 26 00            LD H, 0
 298+ 8D00 29               ADD HL, HL
 299+ 8D01 29               ADD HL, HL
 300+ 8D02 29               ADD HL, HL
 301+ 8D03 29               ADD HL, HL                          ; × ENT_SIZE (16)
 302+ 8D04 11 82 80         LD DE, EntityTable
 303+ 8D07 19               ADD HL, DE
 304+ 8D08 E5               PUSH HL
 305+ 8D09 DD E1            POP IX
 306+ 8D0B
 307+ 8D0B                  ; Avanzar indice round-robin
 308+ 8D0B 3A 96 81         LD A, (EnemyStepIdx)
 309+ 8D0E 3C               INC A
 310+ 8D0F FE 09            CP NUM_MONSTERS + NUM_NASTIES
 311+ 8D11 38 01            JR C, .peNoWrap
 312+ 8D13 AF               XOR A
 313+ 8D14              .peNoWrap:
 314+ 8D14 32 96 81         LD (EnemyStepIdx), A
 315+ 8D17
 316+ 8D17                  ; Slot activo?
 317+ 8D17 DD 7E 01         LD A, (IX+ENT_TYPE)
 318+ 8D1A B7               OR A
 319+ 8D1B 28 16            JR Z, .peSkip
 320+ 8D1D
 321+ 8D1D                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 322+ 8D1D DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 323+ 8D21 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 324+ 8D22
 325+ 8D22                  ; Procesar esta entidad completa (erase + logic + draw)
 326+ 8D22 CD 3C 8D         CALL ProcessOneEnemy
