2042+ 9775              ; ==============================================================================
2043+ 9775              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2044+ 9775              ; ==============================================================================
2045+ 9775              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2046+ 9775              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2047+ 9775              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2048+ 9775              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2049+ 9775              ; ==============================================================================
2050+ 9775              UpdateMonster:
2051+ 9775                  ; --- Stun: knockback + pausa tras golpe del player ---
2052+ 9775 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2053+ 9778 B7               OR A
2054+ 9779 CA 37 99         JP Z, .moNormal
2055+ 977C DD 35 0A         DEC (IX+ENT_DIR)
2056+ 977F 20 35            JR NZ, .moStunActive
2057+ 9781                  ; Stun terminado: comprobar si el monster debe morir (5+ golpes)
2058+ 9781 DD 7E 0B         LD A, (IX+ENT_FLAGS)
2059+ 9784 E6 F0            AND $F0
2060+ 9786 FE 50            CP MONSTER_MAX_HITS * 16            ; 5 * 16 = $50
2061+ 9788 30 0B            JR NC, .moStartDying
2062+ 978A                  ; Sigue vivo: limpiar deltas para forzar recalculo de persecucion
2063+ 978A DD 36 06 00      LD (IX+ENT_DELTAX), 0
2064+ 978E DD 36 07 00      LD (IX+ENT_DELTAY), 0
2065+ 9792 C3 37 99         JP .moNormal
2066+ 9795
