 436+ 689A              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 437+ 689A              ; ==============================================================================
 438+ 689A              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 439+ 689A              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 440+ 689A              ; OUT: -
 441+ 689A              ; Destruye: AF, BC, DE, HL, IX.
 442+ 689A              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 443+ 689A              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 444+ 689A              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 445+ 689A              ; ==============================================================================
 446+ 689A              DrawBgSpriteByIdAtChar:
 447+ 689A B7               OR A
 448+ 689B C8               RET Z                                   ; id 0 = no sprite, salir
 449+ 689C C5               PUSH BC
 450+ 689D 6F               LD L, A
 451+ 689E 26 00            LD H, 0
 452+ 68A0 54               LD D, H
 453+ 68A1 5D               LD E, L                                 ; DE = id
 454+ 68A2 29               ADD HL, HL                              ; *2
 455+ 68A3 19               ADD HL, DE                              ; *3
 456+ 68A4 11 93 DA         LD DE, BgGfxPtrById
 457+ 68A7 19               ADD HL, DE
 458+ 68A8 5E               LD E, (HL)
 459+ 68A9 23               INC HL
 460+ 68AA 56               LD D, (HL)                              ; DE = ptr
 461+ 68AB 23               INC HL
 462+ 68AC 7E               LD A, (HL)                              ; A = bank
 463+ 68AD 32 9C CE         LD (CurrentBgSpriteBank), A
 464+ 68B0 EB               EX DE, HL                               ; HL = ptr
 465+ 68B1 CD D2 90         CALL LoadBgSpriteToBuffer               ; preserva BC
 466+ 68B4 DD 21 0A 89      LD IX, BgSpriteBuffer
 467+ 68B8 C1               POP BC
 468+ 68B9 C3 90 CD         JP DrawBgGfxSprite                      ; tail call
