 184+ 6E71              ; ==============================================================================
 185+ 6E71              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 186+ 6E71              ; ==============================================================================
 187+ 6E71              ; Se llama desde:
 188+ 6E71              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 189+ 6E71              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 190+ 6E71              ;     por encima y los borro.
 191+ 6E71              ;
 192+ 6E71              ; Bypass total de tint swap + day/night remap → siempre brillan:
 193+ 6E71              ;   life          = $47 (white bright, paper black)
 194+ 6E71              ;   health_pickup = $42 (red bright,   paper black)
 195+ 6E71              ;   stamina_pickup= $45 (cyan bright,  paper black)
 196+ 6E71              ;
 197+ 6E71              ; Pickup es 16x16 = 2x2 char attrs.
 198+ 6E71              ; Early-out si RandomSynthMapX = $FE (no activo).
 199+ 6E71              ; Destruye AF, BC, DE, HL.
 200+ 6E71              ; ==============================================================================
 201+ 6E71              PaintSynthPickupAttrs:
 202+ 6E71 3A B4 5F         LD A, (RandomSynthMapX)
 203+ 6E74 FE FE            CP $FE
 204+ 6E76 C8               RET Z                               ; no activo
 205+ 6E77                  ; --- Determinar attr byte por tipo (compara ptr) ---
 206+ 6E77 2A B6 5F         LD HL, (RandomSynthPtr)
 207+ 6E7A 11 68 CC         LD DE, BgGfx_life
 208+ 6E7D B7               OR A
 209+ 6E7E ED 52            SBC HL, DE
 210+ 6E80 3E 47            LD A, $47                           ; white bright (life)
 211+ 6E82 28 0F            JR Z, .pspaAttrReady
 212+ 6E84 2A B6 5F         LD HL, (RandomSynthPtr)
 213+ 6E87 11 4D EE         LD DE, BgGfx_health_pickup
 214+ 6E8A B7               OR A
 215+ 6E8B ED 52            SBC HL, DE
 216+ 6E8D 3E 42            LD A, $42                           ; red bright (health)
 217+ 6E8F 28 02            JR Z, .pspaAttrReady
 218+ 6E91 3E 45            LD A, $45                           ; cyan bright (stamina)
 219+ 6E93              .pspaAttrReady:
 220+ 6E93 4F               LD C, A                             ; C = attr byte
 221+ 6E94                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 222+ 6E94 3A B9 5F         LD A, (RandomSynthCharY)
 223+ 6E97 C6 02            ADD A, BG_Y_OFFSET
 224+ 6E99 26 00            LD H, 0
 225+ 6E9B 6F               LD L, A
 226+ 6E9C 29               ADD HL, HL
 227+ 6E9D 29               ADD HL, HL
 228+ 6E9E 29               ADD HL, HL
 229+ 6E9F 29               ADD HL, HL
 230+ 6EA0 29               ADD HL, HL                          ; *32
 231+ 6EA1 3A B8 5F         LD A, (RandomSynthCharX)
 232+ 6EA4 85               ADD A, L
 233+ 6EA5 6F               LD L, A
 234+ 6EA6 30 01            JR NC, .pspaNoCarry
 235+ 6EA8 24               INC H
 236+ 6EA9              .pspaNoCarry:
 237+ 6EA9 11 00 58         LD DE, ATTR_BASE
 238+ 6EAC 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 239+ 6EAD                  ; --- Escribir 4 attrs (2x2) ---
 240+ 6EAD 71               LD (HL), C
 241+ 6EAE 23               INC HL
 242+ 6EAF 71               LD (HL), C                          ; fila 0
 243+ 6EB0 7D               LD A, L
 244+ 6EB1 C6 1F            ADD A, 31                           ; +32 a fila siguiente, -1 (al col 0)
 245+ 6EB3 6F               LD L, A
 246+ 6EB4 30 01            JR NC, .pspaNoCarry2
 247+ 6EB6 24               INC H
 248+ 6EB7              .pspaNoCarry2:
 249+ 6EB7 71               LD (HL), C
 250+ 6EB8 23               INC HL
 251+ 6EB9 71               LD (HL), C                          ; fila 1
 252+ 6EBA C9               RET
