 227+ 9DFE              ; ==============================================================================
 228+ 9DFE              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9DFE              ; ==============================================================================
 230+ 9DFE              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9DFE              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9DFE              ;
 233+ 9DFE              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9DFE              ; ==============================================================================
 235+ 9DFE              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9DFE              NextPixelLine:
 237+ 9DFE 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9DFF 7C               LD A, H
 239+ 9E00 E6 07            AND 7
 240+ 9E02 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9E03
 242+ 9E03                  ; --- Cruce de character row ---
 243+ 9E03 7D               LD A, L
 244+ 9E04 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9E06 6F               LD L, A
 246+ 9E07 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9E09 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9E0A
 249+ 9E0A                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9E0A 7C               LD A, H
 251+ 9E0B D6 08            SUB 8
 252+ 9E0D 67               LD H, A
 253+ 9E0E C9               RET
 254+ 9E0F
 255+ 9E0F              ; ==============================================================================
 256+ 9E0F              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9E0F              ; ==============================================================================
 258+ 9E0F              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9E0F              ; Entrada:
 260+ 9E0F              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9E0F              ;   A = atributo a pintar
 262+ 9E0F              ; ==============================================================================
 263+ 9E0F              SetEntityAttr:
 264+ 9E0F F5               PUSH AF                     ; Guardar atributo
 265+ 9E10 CD 77 A0         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9E13 F1               POP AF
 267+ 9E14
 268+ 9E14 47               LD B, A                     ; B = atributo (preservar)
 269+ 9E15 3A 0E 9F         LD A, (EntityAttrH)
 270+ 9E18 4F               LD C, A                     ; C = filas
 271+ 9E19              .rowLoop:
 272+ 9E19                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9E19 E5               PUSH HL
 274+ 9E1A 7C               LD A, H
 275+ 9E1B FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9E1D 20 08            JR NZ, .rowNotHud
 277+ 9E1F 7D               LD A, L
 278+ 9E20 FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9E22 30 03            JR NC, .rowNotHud
 280+ 9E24                  ; Fila en HUD → saltar sin pintar
 281+ 9E24 E1               POP HL
 282+ 9E25 18 0B            JR .rowSkip
 283+ 9E27              .rowNotHud:
 284+ 9E27 E1               POP HL
 285+ 9E28 3A 0D 9F         LD A, (EntityAttrW)
 286+ 9E2B E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9E2C                  ; Pintar una fila
 288+ 9E2C              .colLoop:
 289+ 9E2C 70               LD (HL), B
 290+ 9E2D 23               INC HL
 291+ 9E2E 3D               DEC A
 292+ 9E2F 20 FB            JR NZ, .colLoop
 293+ 9E31 E1               POP HL
 294+ 9E32              .rowSkip:
 295+ 9E32                  ; Siguiente fila: HL += 32
 296+ 9E32 D5               PUSH DE
 297+ 9E33 11 20 00         LD DE, 32
 298+ 9E36 19               ADD HL, DE
 299+ 9E37 D1               POP DE
 300+ 9E38 0D               DEC C
 301+ 9E39 20 DE            JR NZ, .rowLoop
 302+ 9E3B C9               RET
