4808+ B985
4809+ B985              .spawnPosOk:
4810+ B985                  ; Velocidades aleatorias
4811+ B985 ED 5F            LD A, R
4812+ B987 CB 57            BIT 2, A
4813+ B989 28 07            JR Z, .dxPos
4814+ B98B 3A 55 8D         LD A, (CurrentEnemySpeed)
4815+ B98E ED 44            NEG
4816+ B990 18 03            JR .setDX
4817+ B992              .dxPos:
4818+ B992 3A 55 8D         LD A, (CurrentEnemySpeed)
4819+ B995              .setDX:
4820+ B995 DD 77 06         LD (IX+ENT_DELTAX), A
4821+ B998 ED 5F            LD A, R
4822+ B99A CB 5F            BIT 3, A
4823+ B99C 28 07            JR Z, .dyPos
4824+ B99E 3A 55 8D         LD A, (CurrentEnemySpeed)
4825+ B9A1 ED 44            NEG
4826+ B9A3 18 03            JR .setDY
4827+ B9A5              .dyPos:
4828+ B9A5 3A 55 8D         LD A, (CurrentEnemySpeed)
4829+ B9A8              .setDY:
4830+ B9A8 DD 77 07         LD (IX+ENT_DELTAY), A
4831+ B9AB                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4832+ B9AB                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4833+ B9AB                  ; identicas y las nasties van en paralelo solapadas.
4834+ B9AB DD 7E 06         LD A, (IX+ENT_DELTAX)
4835+ B9AE E6 80            AND $80                             ; bit 7 = signo X
4836+ B9B0 47               LD B, A
4837+ B9B1 DD 7E 07         LD A, (IX+ENT_DELTAY)
4838+ B9B4 E6 80            AND $80                             ; bit 7 = signo Y
4839+ B9B6 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4840+ B9B7 B0               OR B                                ; A = signX(7) | signY(6)
4841+ B9B8 47               LD B, A
4842+ B9B9 3A F6 82         LD A, (LastSpawnDirSigns)
4843+ B9BC B8               CP B
4844+ B9BD 20 0C            JR NZ, .spawnDirOk
4845+ B9BF                  ; Coincide -> voltear DELTAY (negar)
4846+ B9BF DD 7E 07         LD A, (IX+ENT_DELTAY)
4847+ B9C2 ED 44            NEG
4848+ B9C4 DD 77 07         LD (IX+ENT_DELTAY), A
4849+ B9C7 78               LD A, B
4850+ B9C8 EE 40            XOR $40                             ; recalcular signs cacheados
4851+ B9CA 47               LD B, A
4852+ B9CB              .spawnDirOk:
4853+ B9CB 78               LD A, B
4854+ B9CC 32 F6 82         LD (LastSpawnDirSigns), A
4855+ B9CF
4856+ B9CF                  ; Inicializar old pos = pos actual
4857+ B9CF DD 7E 03         LD A, (IX+ENT_POSX)
4858+ B9D2 DD 77 0C         LD (IX+ENT_OLDX), A
4859+ B9D5 DD 77 0F         LD (IX+ENT_DRAWX), A
4860+ B9D8 DD 7E 04         LD A, (IX+ENT_POSY)
4861+ B9DB DD 77 0D         LD (IX+ENT_OLDY), A
4862+ B9DE DD 7E 00         LD A, (IX+ENT_SPRITEID)
4863+ B9E1 DD 77 0E         LD (IX+ENT_OLDSPRID), A
4864+ B9E4                  ; SFX de spawn
4865+ B9E4 21 ED F7         LD HL, SFX_EnemySpawn
4866+ B9E7 CD 50 F7         CALL PlaySFX
4867+ B9EA C9               RET
