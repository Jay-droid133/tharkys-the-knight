 839+ 66AE              ; ==============================================================================
 840+ 66AE              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 66AE              ; ==============================================================================
 842+ 66AE              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 66AE              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 66AE              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 66AE              ; 2. Compute new offset random.
 846+ 66AE              ; 3. Draw at new offset.
 847+ 66AE              ; Destruye: AF, BC, DE, HL, IX.
 848+ 66AE              ; ==============================================================================
 849+ 66AE              TownGateShakeStep:
 850+ 66AE CD F6 66         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 66B1 CD 11 67         CALL TownGateDrawFingerShifted
 852+ 66B4                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 66B4 ED 5F            LD A, R
 854+ 66B6 E6 03            AND $03
 855+ 66B8 21 D9 66         LD HL, .tgssJitterTable
 856+ 66BB 5F               LD E, A
 857+ 66BC 16 00            LD D, 0
 858+ 66BE 19               ADD HL, DE
 859+ 66BF 7E               LD A, (HL)
 860+ 66C0 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 66C3 3A 98 81         LD A, (GameFrameCounter)
 862+ 66C6 E6 03            AND $03
 863+ 66C8 21 D9 66         LD HL, .tgssJitterTable
 864+ 66CB 5F               LD E, A
 865+ 66CC 16 00            LD D, 0
 866+ 66CE 19               ADD HL, DE
 867+ 66CF 7E               LD A, (HL)
 868+ 66D0 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 66D3 CD F6 66         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 66D6 C3 11 67         JP TownGateDrawFingerShifted
 871+ 66D9              .tgssJitterTable:
 872+ 66D9 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 66DD
 874+ 66DD              ; ==============================================================================
 875+ 66DD              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 66DD              ; ==============================================================================
 877+ 66DD              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 66DD              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 66DD              ; ==============================================================================
 880+ 66DD              TownGateShakeRestore:
 881+ 66DD CD F6 66         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 66E0 CD 11 67         CALL TownGateDrawFingerShifted
 883+ 66E3 AF               XOR A
 884+ 66E4 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 66E7 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 66EA 11 4D E2         LD DE, BgGfx_arm
 887+ 66ED CD 0E D8         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 66F0 11 9A E2         LD DE, BgGfx_finger
 889+ 66F3 C3 0E D8         JP RedrawPickupByPtr
