1988+ D366 04               DEFB 4                          ; key requerida = ClockTowerKey
1989+ D367 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
1990+ D368 00 00            DEFW 0                          ; fin
1991+ D36A 00 00            DEFB 0, 0
