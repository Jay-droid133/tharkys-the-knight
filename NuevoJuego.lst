7316+ C7A7 C3 31 C7         JP .bfsLoop
7317+ C7AA
7318+ C7AA              .bfsApply:
7319+ C7AA                  ; --- Aplicar best dir si la hay ---
7320+ C7AA 3A 6F 5F         LD A, (DBfsBestDir)
7321+ C7AD FE FF            CP MAI_DIR_NONE
7322+ C7AF C8               RET Z
7323+ C7B0                  ; Setear DELTAX/Y segun dir
7324+ C7B0 FE 00            CP MAI_DIR_N
7325+ C7B2 28 12            JR Z, .bfsAppN
7326+ C7B4 FE 01            CP MAI_DIR_S
7327+ C7B6 28 18            JR Z, .bfsAppS
7328+ C7B8 FE 02            CP MAI_DIR_W
7329+ C7BA 28 1E            JR Z, .bfsAppW
7330+ C7BC DD 36 06 02      LD (IX+ENT_DELTAX), MONSTER_SPEED
7331+ C7C0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
