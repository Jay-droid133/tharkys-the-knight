4426+ B72B              ; ==============================================================================
4427+ B72B              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4428+ B72B              ; ==============================================================================
4429+ B72B              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4430+ B72B              ; ==============================================================================
4431+ B72B              TrySpawnNasty:
4432+ B72B                  IF DEBUG_NO_ENEMIES
4433+ B72B ~                RET
4434+ B72B                  ENDIF
4435+ B72B                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4436+ B72B                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4437+ B72B                  ; cuando el timer llega a 0.
4438+ B72B 3A C7 82         LD A, (PostTrapPauseTimer)
4439+ B72E B7               OR A
4440+ B72F C0               RET NZ
4441+ B730                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4442+ B730                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4443+ B730 3A E7 82         LD A, (DeathBorderPhase)
4444+ B733 B7               OR A
4445+ B734 C0               RET NZ
4446+ B735                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4447+ B735                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4448+ B735                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4449+ B735 3A EB 82         LD A, (PlayerRespawnPhase)
4450+ B738 FE 01            CP 1
4451+ B73A C8               RET Z
4452+ B73B                  ; Cooldown tras cambio de pantalla / inicio
4453+ B73B 3A F5 82         LD A, (SpawnTimer)
4454+ B73E B7               OR A
4455+ B73F 28 05            JR Z, .spawnReady
4456+ B741 3D               DEC A
4457+ B742 32 F5 82         LD (SpawnTimer), A
4458+ B745 C9               RET
4459+ B746              .spawnReady:
4460+ B746                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4461+ B746 3A A8 B5         LD A, (ScareTimer)
4462+ B749 B7               OR A
4463+ B74A C0               RET NZ
4464+ B74B                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4465+ B74B                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4466+ B74B                  ; rellenamos con nasties crepusculares hasta A2.
4467+ B74B 3A BE 82         LD A, (MonsterTrappedFlags)
4468+ B74E E6 07            AND $07
4469+ B750 FE 07            CP $07
4470+ B752 28 0E            JR Z, .spawnIgnoreNightBlocks
4471+ B754                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4472+ B754                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4473+ B754                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4474+ B754                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4475+ B754 3A 12 B3         LD A, (MonstersActive)
4476+ B757 B7               OR A
4477+ B758 C0               RET NZ
4478+ B759                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4479+ B759 3A 28 E2         LD A, (CurrentTimeOfDay)
4480+ B75C FE 04            CP 4                        ; N2
4481+ B75E C8               RET Z
4482+ B75F FE 05            CP 5                        ; A1
4483+ B761 C8               RET Z
4484+ B762              .spawnIgnoreNightBlocks:
4485+ B762                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4486+ B762                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4487+ B762                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4488+ B762                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4489+ B762 DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4490+ B766 06 04            LD B, NUM_NASTIES
4491+ B768              .spawnLoop:
4492+ B768 C5               PUSH BC
4493+ B769 DD 7E 01         LD A, (IX+ENT_TYPE)
4494+ B76C B7               OR A
4495+ B76D 20 12            JR NZ, .spawnNextSlot
4496+ B76F CD 8A B7         CALL SpawnOneNasty
4497+ B772 DD 7E 01         LD A, (IX+ENT_TYPE)
4498+ B775 B7               OR A
4499+ B776 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4500+ B778                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4501+ B778                  ; (un poco de irregularidad en la cadencia de aparicion).
4502+ B778 ED 5F            LD A, R
4503+ B77A E6 07            AND $07
4504+ B77C 32 F5 82         LD (SpawnTimer), A
4505+ B77F C1               POP BC
4506+ B780 C9               RET
4507+ B781              .spawnNextSlot:
4508+ B781 11 10 00         LD DE, ENT_SIZE
4509+ B784 DD 19            ADD IX, DE
4510+ B786 C1               POP BC
4511+ B787 10 DF            DJNZ .spawnLoop
4512+ B789 C9               RET
