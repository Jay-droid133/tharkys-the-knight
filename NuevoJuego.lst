 537+ EC7E              ; ApplyCaracolBuff - speed slow 0.5x durante 10s + player GREEN | $40
 538+ EC7E              ; ==============================================================================
 539+ EC7E              ApplyCaracolBuff:
 540+ EC7E 3E 02            LD A, SPEED_BUFF_CARACOL_RUN
 541+ EC80 32 D7 82         LD (PlayerSpeedRun), A
 542+ EC83 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 543+ EC85 32 D8 82         LD (PlayerSpeedFight), A
