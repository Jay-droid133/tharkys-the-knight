7038+ C63E              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
7039+ C63E              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
7040+ C63E              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
7041+ C63E              ; timer >= DEATH_SPAWN_FRAMES).
7042+ C63E              SpawnDeath:
7043+ C63E                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
7044+ C63E                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
7045+ C63E                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
7046+ C63E                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
7047+ C63E                  ; atravesando el mapa.
7048+ C63E CD 3A 94         CALL FindFarthestAnyFreeCell
7049+ C641 C8               RET Z                               ; sin candidato: reintento siguiente frame
7050+ C642              .sdHaveCell:
7051+ C642                  ; B = cx, C = cy
7052+ C642 DD 21 53 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7053+ C646                  ; POSX = cx * 8
7054+ C646 78               LD A, B
7055+ C647 87               ADD A, A
7056+ C648 87               ADD A, A
7057+ C649 87               ADD A, A
7058+ C64A DD 77 03         LD (IX+ENT_POSX), A
7059+ C64D DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
7060+ C650                  ; POSY = cy * 8 + SCREEN_MIN_Y
7061+ C650 79               LD A, C
7062+ C651 87               ADD A, A
7063+ C652 87               ADD A, A
7064+ C653 87               ADD A, A
7065+ C654 C6 10            ADD A, SCREEN_MIN_Y
7066+ C656 DD 77 04         LD (IX+ENT_POSY), A
7067+ C659 DD 77 0D         LD (IX+ENT_OLDY), A
7068+ C65C                  ; Tipo / estado / sprite
7069+ C65C DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
7070+ C660 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
7071+ C664 DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
7072+ C668 DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
7073+ C66C DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
7074+ C670 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7075+ C674 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7076+ C678 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7077+ C67C DD 36 0A 00      LD (IX+ENT_DIR), 0
7078+ C680                  ; Color: blanco brillante sobre negro (espectral)
7079+ C680 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7080+ C684                  ; Flags: visible + newspawn (no destructible: la muerte es invulnerable)
7081+ C684 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
7082+ C688                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
7083+ C688 AF               XOR A
7084+ C689 32 03 83         LD (DeathSubPixelAcc), A
7085+ C68C 32 06 83         LD (DeathStuckCounter), A
7086+ C68F 32 09 83         LD (DeathGhostMode), A
7087+ C692 21 00 00         LD HL, 0
