 279+ 73B6              ; ==============================================================================
 280+ 73B6              ; PaintMagicCompassAttrs - Pinta los 4 chars del HUD compass en modo magic
 281+ 73B6              ; ==============================================================================
 282+ 73B6              ; Color base lo decide el editor (sprite id 36, attrBytes). El runtime lo
 283+ 73B6              ; lee de MagicCompassBaseAttrs (auto-importado por import_magic_compass_hud.py
 284+ 73B6              ; con bit 6 BRIGHT clearado) y aplica BRIGHT solo al char correspondiente
 285+ 73B6              ; a la PathDir. Durante los últimos 5 s ese bright parpadea on/off a ~6 Hz.
 286+ 73B6              ;
 287+ 73B6              ; Mapping diagonal de las 4 esquinas del 2x2:
 288+ 73B6              ;   col1   col2
 289+ 73B6              ;     W      N    (row 1, top)     ← idx 0 (1,1) | idx 1 (2,1)
 290+ 73B6              ;     S      E    (row 2, bottom)  ← idx 2 (1,2) | idx 3 (2,2)
 291+ 73B6              ;
 292+ 73B6              ;   PathDir 0 (N) → idx 1 → offset +1
 293+ 73B6              ;   PathDir 1 (S) → idx 2 → offset +$20
 294+ 73B6              ;   PathDir 2 (W) → idx 0 → offset +0
 295+ 73B6              ;   PathDir 3 (E) → idx 3 → offset +$21
 296+ 73B6              ;
 297+ 73B6              ; Destruye: AF, BC, DE, HL.
 298+ 73B6              ; ==============================================================================
 299+ 73B6              PaintMagicCompassAttrs:
 300+ 73B6                  ; Pintar 4 chars con MagicCompassBaseAttrs (orden: 1,1 / 2,1 / 1,2 / 2,2)
 301+ 73B6 11 EE 76         LD DE, MagicCompassBaseAttrs
 302+ 73B9 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 303+ 73BC 1A               LD A, (DE)
 304+ 73BD 77               LD (HL), A
 305+ 73BE 23               INC HL
 306+ 73BF 13               INC DE
 307+ 73C0 1A               LD A, (DE)
 308+ 73C1 77               LD (HL), A
 309+ 73C2 13               INC DE
 310+ 73C3 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 311+ 73C6 1A               LD A, (DE)
 312+ 73C7 77               LD (HL), A
 313+ 73C8 23               INC HL
 314+ 73C9 13               INC DE
 315+ 73CA 1A               LD A, (DE)
 316+ 73CB 77               LD (HL), A
 317+ 73CC
 318+ 73CC                  ; Si sin path no hay char activo: solo base attrs (ya pintados).
 319+ 73CC 3A C1 5F         LD A, (MagicCompassPathDir)
 320+ 73CF FE FF            CP $FF
 321+ 73D1 C8               RET Z
 322+ 73D2
 323+ 73D2                  ; Si el tick no está sonando, char activo se queda con base attr.
 324+ 73D2                  ; Eso da el efecto visual "OFF" entre pitidos.
 325+ 73D2 3A C3 5F         LD A, (MagicCompassTickActiveFrames)
 326+ 73D5 B7               OR A
 327+ 73D6 C8               RET Z
