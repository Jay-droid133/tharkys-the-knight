2218+ D826 2E D8            DEFW BgGfx_chimes_tower_door
2219+ D828 04               DEFB 4                          ; key requerida = ClockTowerKey
2220+ D829 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2221+ D82A 00 00            DEFW 0                          ; fin
2222+ D82C 00 00            DEFB 0, 0
