 582+ AD0A 42               LD B, D                     ; B = attr_w
 583+ AD0B E5               PUSH HL
 584+ AD0C
 585+ AD0C              .attrCol:
 586+ AD0C DD 7E 00         LD A, (IX+0)
 587+ AD0F CD 2C AD         CALL ApplyTintSwap          ; Reemplazar paper si coincide con tintPaper
 588+ AD12 CD E8 EA         CALL ApplyDayCycleRemap     ; Transformar attr segun momento del dia
 589+ AD15 77               LD (HL), A
 590+ AD16 DD 23            INC IX
 591+ AD18 23               INC HL
 592+ AD19 10 F1            DJNZ .attrCol
 593+ AD1B
 594+ AD1B E1               POP HL
 595+ AD1C D5               PUSH DE
 596+ AD1D 11 20 00         LD DE, 32
 597+ AD20 19               ADD HL, DE
 598+ AD21 D1               POP DE
 599+ AD22 1D               DEC E
 600+ AD23 20 E5            JR NZ, .attrRow
 601+ AD25 C9               RET
 602+ AD26
 603+ AD26              ; Variables locales DrawBgGfxSprite
 604+ AD26 00           .heightCnt: DEFB 0
 605+ AD27 00           .widthVal:  DEFB 0
 606+ AD28 00           .xChar:     DEFB 0
 607+ AD29 00           .yChar:     DEFB 0
 608+ AD2A
 609+ AD2A              ; Variables de tint
 610+ AD2A FF           CurrentTintVar:   DEFB $FF    ; paper destino del placement (255=sin tint)
 611+ AD2B FF           CurrentTintPaper: DEFB $FF    ; paper original tintable del sprite (255=no tintable)
 612+ AD2C
 613+ AD2C              ; ==============================================================================
 614+ AD2C              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 615+ AD2C              ; ==============================================================================
 616+ AD2C              ; Entrada: A = attr byte
 617+ AD2C              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 618+ AD2C              ; Preserva: HL, DE, BC, IX
 619+ AD2C              ; ==============================================================================
 620+ AD2C              ApplyTintSwap:
 621+ AD2C C5               PUSH BC
 622+ AD2D 47               LD B, A                     ; B = attr original
 623+ AD2E 3A 2A AD         LD A, (CurrentTintVar)
 624+ AD31 FE FF            CP $FF
 625+ AD33 28 24            JR Z, .tintNoChange
 626+ AD35 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 627+ AD36 3A 2B AD         LD A, (CurrentTintPaper)
 628+ AD39 FE FF            CP $FF
 629+ AD3B 28 1C            JR Z, .tintNoChange
 630+ AD3D                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 631+ AD3D                  ; Extraer paper del attr: bits 5-3
 632+ AD3D 78               LD A, B
 633+ AD3E E6 38            AND $38                     ; A = 00PPP000
 634+ AD40 0F               RRCA
 635+ AD41 0F               RRCA
 636+ AD42 0F               RRCA                        ; A = 00000PPP = paper actual
 637+ AD43 D5               PUSH DE
 638+ AD44 57               LD D, A                     ; D = paper actual
 639+ AD45 3A 2B AD         LD A, (CurrentTintPaper)
 640+ AD48 BA               CP D                        ; paper actual == tintPaper?
 641+ AD49 D1               POP DE
 642+ AD4A 20 0D            JR NZ, .tintNoChange
 643+ AD4C                  ; Match: reemplazar paper bits con tintVar
 644+ AD4C 78               LD A, B
 645+ AD4D E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 646+ AD4F D5               PUSH DE
 647+ AD50 57               LD D, A
 648+ AD51 79               LD A, C                     ; A = tintVar (0-7)
 649+ AD52 07               RLCA
 650+ AD53 07               RLCA
 651+ AD54 07               RLCA                        ; A = 00PPP000
 652+ AD55 B2               OR D                        ; A = FBPPPIII
 653+ AD56 D1               POP DE
 654+ AD57 C1               POP BC
 655+ AD58 C9               RET
 656+ AD59              .tintNoChange:
 657+ AD59 78               LD A, B                     ; devolver sin cambio
 658+ AD5A C1               POP BC
 659+ AD5B C9               RET
 660+ AD5C
 661+ AD5C              ; ==============================================================================
 662+ AD5C              ; RemapScreenAttrs - Remap rapido de atributos (sin redibujar pixeles)
 663+ AD5C              ; ==============================================================================
 664+ AD5C              ; Solo se ejecuta cuando AttrsDirty=1 (cambio de fase day/night).
 665+ AD5C              ; Itera BG sprites saltando pixel data, solo repinta attrs con nuevo remap.
 666+ AD5C              ; ==============================================================================
 667+ AD5C              RemapScreenAttrs:
 668+ AD5C 3A B5 81         LD A, (AttrsDirty)
 669+ AD5F B7               OR A
 670+ AD60 C8               RET Z
 671+ AD61
 672+ AD61 AF               XOR A
 673+ AD62 32 B5 81         LD (AttrsDirty), A
 674+ AD65
 675+ AD65                  ; --- Iterar sprites del room (solo attrs) ---
 676+ AD65 2A B1 81         LD HL, (CurrentScreenAddr)
