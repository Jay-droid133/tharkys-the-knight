 967+ 95EF              ; MaiGetEntrySide
 968+ 95EF              ; ==============================================================================
 969+ 95EF              ; Traduce ScreenTransition (direccion en la que se movio el player al cruzar
 970+ 95EF              ; el borde) al side de ENTRADA en el nuevo room (el borde opuesto).
 971+ 95EF              ;
 972+ 95EF              ;   DIR_N (player fue al norte) → SIDE_S (entro por el sur del nuevo room)
 973+ 95EF              ;   DIR_S → SIDE_N
 974+ 95EF              ;   DIR_E → SIDE_W
 975+ 95EF              ;   DIR_W → SIDE_E
 976+ 95EF              ;
 977+ 95EF              ; OUT: A = MAI_SIDE_N/S/W/E o $FF si no hay transicion activa.
 978+ 95EF              ; ==============================================================================
 979+ 95EF              MaiGetEntrySide:
