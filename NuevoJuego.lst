4648+ BB32 3E 58            LD A, 88
4649+ BB34              .sYOk:
4650+ BB34 DD 77 04         LD (IX+ENT_POSY), A
4651+ BB37              .spwPosSet:
4652+ BB37                  ; --- Bounds check: el sprite entero debe caber en pantalla ---
4653+ BB37                  ; X: POSX + (W-1) NO debe wrap 8-bit (sprite extiende a >$FF se renderiza
4654+ BB37                  ; recortado en borde izq via wraparound visual).
4655+ BB37 DD 7E 03         LD A, (IX+ENT_POSX)
4656+ BB3A 47               LD B, A
4657+ BB3B 3A 22 BC         LD A, (.spawnW1)
