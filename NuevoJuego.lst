2367+ D82E 87               ADD A, A                        ; *2
2368+ D82F 87               ADD A, A                        ; *4
2369+ D830 87               ADD A, A                        ; *8 = width_px
2370+ D831 32 5B D9         LD (.cbtSpW), A
