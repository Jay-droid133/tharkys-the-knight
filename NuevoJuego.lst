1607+ F4E2              ; church-cutscene block (lines 1489-2181 originales) movido a code/church_cutscene.asm
1608+ F4E2              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1609+ F4E2
1610+ F4E2              ; ==============================================================================
1611+ F4E2              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1612+ F4E2              ; ==============================================================================
1613+ F4E2              ; Indice (CompassSprites[idx]):
1614+ F4E2              ;   0 = NW    1 = N    2 = NE
1615+ F4E2              ;   3 = W     4 = X    5 = E
1616+ F4E2              ;   6 = SW    7 = S    8 = SE
1617+ F4E2              ; ==============================================================================
1618+ F4E2              CompassSprites:
1619+ F4E2 01 F6            DEFW Sprite_Compass_NW
1620+ F4E4 21 F5            DEFW Sprite_Compass_N
1621+ F4E6 41 F5            DEFW Sprite_Compass_NE
1622+ F4E8 E1 F5            DEFW Sprite_Compass_W
1623+ F4EA 21 F6            DEFW Sprite_Compass_X
1624+ F4EC 61 F5            DEFW Sprite_Compass_E
1625+ F4EE C1 F5            DEFW Sprite_Compass_SW
1626+ F4F0 A1 F5            DEFW Sprite_Compass_S
1627+ F4F2 81 F5            DEFW Sprite_Compass_SE
1628+ F4F4
1629+ F4F4              ; ==============================================================================
1630+ F4F4              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1631+ F4F4              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1632+ F4F4              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1633+ F4F4              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1634+ F4F4              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1635+ F4F4              ; ==============================================================================
1636+ F4F4              CompassWobbleTable:
1637+ F4F4 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1638+ F4F8 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1639+ F4FC 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1640+ F500 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1641+ F504 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1642+ F508 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1643+ F50C 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1644+ F510 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1645+ F514 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1646+ F518
1647+ F518              ; ==============================================================================
1648+ F518              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1649+ F518              ; Indexada por (counter-1) -> 0..8. Valor:
1650+ F518              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1651+ F518              ; Con counter inicial 9 y decremento por frame:
1652+ F518              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1653+ F518              ;   counter 8 -> phase 7 -> prev
1654+ F518              ;   counter 7 -> phase 6 -> target
1655+ F518              ;   counter 6 -> phase 5 -> next
1656+ F518              ;   counter 5 -> phase 4 -> next2
1657+ F518              ;   counter 4 -> phase 3 -> prev
1658+ F518              ;   counter 3 -> phase 2 -> target
1659+ F518              ;   counter 2 -> phase 1 -> prev
1660+ F518              ;   counter 1 -> phase 0 -> target (estado final, settle)
1661+ F518              ; ==============================================================================
1662+ F518              WobblePhaseTable:
1663+ F518 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1663+ F51C 04 03 02 01
1663+ F520 00
1664+ F521
