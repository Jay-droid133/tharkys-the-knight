6835+ C533              ; ==============================================================================
6836+ C533              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6837+ C533              ; ==============================================================================
6838+ C533              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6839+ C533              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6840+ C533              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6841+ C533              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6842+ C533              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6843+ C533              ; main.asm; aqui no hace falta guard adicional).
6844+ C533              ; ==============================================================================
6845+ C533
6846+ C533              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6847+ C533              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6848+ C533              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6849+ C533              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6850+ C533              ;
6851+ C533              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6852+ C533              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6853+ C533              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6854+ C533              ;
6855+ C533              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6856+ C533              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6857+ C533              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6858+ C533              ; en vez de 8 + orientacion invertida).
6859+ C533              UpdateDeath:
6860+ C533                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6861+ C533                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6862+ C533                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6863+ C533                  ; progreso real, no solo quedar inmovil. ---
6864+ C533 2A 04 83         LD HL, (DeathGhostStuckTimer)
6865+ C536 23               INC HL
6866+ C537 22 04 83         LD (DeathGhostStuckTimer), HL
6867+ C53A 7C               LD A, H
6868+ C53B FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6869+ C53D 38 1A            JR C, .udGhostCheckDone
6870+ C53F 20 05            JR NZ, .udGhostOn
6871+ C541 7D               LD A, L
6872+ C542 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6873+ C544 38 13            JR C, .udGhostCheckDone
6874+ C546              .udGhostOn:
6875+ C546                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6876+ C546                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6877+ C546                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6878+ C546                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6879+ C546                  ; re-disparar restart).
6880+ C546 3A 06 83         LD A, (DeathGhostMode)
6881+ C549 B7               OR A
6882+ C54A 20 0D            JR NZ, .udGhostCheckDone
6883+ C54C 3E 01            LD A, 1
6884+ C54E 32 06 83         LD (DeathGhostMode), A
6885+ C551 32 E5 99         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6886+ C554 3E FE            LD A, $FE                       ; sentinel restart-current-track
6887+ C556 CD BF 99         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6888+ C559              .udGhostCheckDone:
6889+ C559
6890+ C559                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6891+ C559 3A 06 83         LD A, (DeathGhostMode)
6892+ C55C B7               OR A
6893+ C55D C2 A4 C5         JP NZ, DeathGhostChase
6894+ C560
6895+ C560                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6896+ C560 DD 7E 03         LD A, (IX+ENT_POSX)
6897+ C563 32 01 83         LD (DeathPrevX), A
6898+ C566 DD 7E 04         LD A, (IX+ENT_POSY)
6899+ C569 32 02 83         LD (DeathPrevY), A
6900+ C56C                  ; Sub-pixel acc 1/2
6901+ C56C 3A 00 83         LD A, (DeathSubPixelAcc)
6902+ C56F EE 01            XOR 1
6903+ C571 32 00 83         LD (DeathSubPixelAcc), A
6904+ C574 28 05            JR Z, .udSkip
6905+ C576 CD 13 AE         CALL UpdateMonster                  ; activo: chase + move + animate
6906+ C579 18 03            JR .udPost
6907+ C57B              .udSkip:
6908+ C57B CD F7 C5         CALL DeathAnimate                   ; skip: solo animacion
6909+ C57E              .udPost:
6910+ C57E                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6911+ C57E 3A 01 83         LD A, (DeathPrevX)
6912+ C581 DD BE 03         CP (IX+ENT_POSX)
6913+ C584 20 19            JR NZ, .udMoved
6914+ C586 3A 02 83         LD A, (DeathPrevY)
6915+ C589 DD BE 04         CP (IX+ENT_POSY)
6916+ C58C 20 11            JR NZ, .udMoved
6917+ C58E                  ; No movio: incrementar BFS counter
6918+ C58E 3A 03 83         LD A, (DeathStuckCounter)
6919+ C591 3C               INC A
6920+ C592 32 03 83         LD (DeathStuckCounter), A
6921+ C595 FE 06            CP DEATH_STUCK_THRESHOLD
6922+ C597 D8               RET C
6923+ C598 AF               XOR A
6924+ C599 32 03 83         LD (DeathStuckCounter), A
6925+ C59C C3 63 C7         JP DeathBfsRescue
6926+ C59F              .udMoved:
6927+ C59F AF               XOR A
6928+ C5A0 32 03 83         LD (DeathStuckCounter), A
6929+ C5A3 C9               RET
6930+ C5A4
6931+ C5A4              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6932+ C5A4              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6933+ C5A4              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6934+ C5A4              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6935+ C5A4              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6936+ C5A4              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6937+ C5A4              DeathGhostChase:
6938+ C5A4                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6939+ C5A4 3A A3 81         LD A, (EntityTable + ENT_POSX)
6940+ C5A7 DD 96 03         SUB (IX+ENT_POSX)
6941+ C5AA 30 02            JR NC, .udgAbsDxOk
6942+ C5AC ED 44            NEG
6943+ C5AE              .udgAbsDxOk:
6944+ C5AE 47               LD B, A                             ; B = |dx|
6945+ C5AF 3A A4 81         LD A, (EntityTable + ENT_POSY)
6946+ C5B2 DD 96 04         SUB (IX+ENT_POSY)
6947+ C5B5 30 02            JR NC, .udgAbsDyOk
6948+ C5B7 ED 44            NEG
6949+ C5B9              .udgAbsDyOk:
6950+ C5B9                  ; A = |dy|, B = |dx|
6951+ C5B9 B8               CP B
6952+ C5BA 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6953+ C5BC
6954+ C5BC                  ; --- Eje X primario ---
6955+ C5BC AF               XOR A
6956+ C5BD DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6957+ C5C0 3A A3 81         LD A, (EntityTable + ENT_POSX)
6958+ C5C3 DD 96 03         SUB (IX+ENT_POSX)
6959+ C5C6 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6960+ C5C8 3E 04            LD A, DEATH_GHOST_SPEED
6961+ C5CA 30 02            JR NC, .udgXSet
6962+ C5CC 3E FC            LD A, -DEATH_GHOST_SPEED
6963+ C5CE              .udgXSet:
6964+ C5CE DD 77 06         LD (IX+ENT_DELTAX), A
6965+ C5D1 DD 86 03         ADD A, (IX+ENT_POSX)
6966+ C5D4 DD 77 03         LD (IX+ENT_POSX), A
6967+ C5D7 18 1B            JR .udgAnim
6968+ C5D9
6969+ C5D9                  ; --- Eje Y primario ---
6970+ C5D9              .udgVertPrim:
6971+ C5D9 AF               XOR A
6972+ C5DA DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6973+ C5DD 3A A4 81         LD A, (EntityTable + ENT_POSY)
6974+ C5E0 DD 96 04         SUB (IX+ENT_POSY)
6975+ C5E3 28 0F            JR Z, .udgAnim
6976+ C5E5 3E 04            LD A, DEATH_GHOST_SPEED
6977+ C5E7 30 02            JR NC, .udgYSet
6978+ C5E9 3E FC            LD A, -DEATH_GHOST_SPEED
6979+ C5EB              .udgYSet:
6980+ C5EB DD 77 07         LD (IX+ENT_DELTAY), A
6981+ C5EE DD 86 04         ADD A, (IX+ENT_POSY)
6982+ C5F1 DD 77 04         LD (IX+ENT_POSY), A
6983+ C5F4              .udgAnim:
6984+ C5F4                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6985+ C5F4                  ; ser despawneada por una de tres condiciones externas:
6986+ C5F4                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6987+ C5F4                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6988+ C5F4                  ;   3. Player cambia de pantalla (screen_system reset)
6989+ C5F4                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6990+ C5F4                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6991+ C5F4                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6992+ C5F4 C3 F7 C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6993+ C5F7
6994+ C5F7              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6995+ C5F7              ; Llamada por:
6996+ C5F7              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6997+ C5F7              ;   - UpdateDeath en frame skip (sin movimiento).
6998+ C5F7              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6999+ C5F7              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
7000+ C5F7              DeathAnimate:
7001+ C5F7 DD 7E 06         LD A, (IX+ENT_DELTAX)
7002+ C5FA B7               OR A
7003+ C5FB 28 0A            JR Z, .daKeepDir
7004+ C5FD 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
7005+ C5FF CB 7F            BIT 7, A
7006+ C601 28 0D            JR Z, .daDir
7007+ C603 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
7008+ C605 18 09            JR .daDir
7009+ C607              .daKeepDir:
7010+ C607 DD 7E 00         LD A, (IX+ENT_SPRITEID)
7011+ C60A DD 96 08         SUB (IX+ENT_ANIMBASE)
7012+ C60D E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
7013+ C60F 4F               LD C, A
7014+ C610              .daDir:
7015+ C610 DD 35 09         DEC (IX+ENT_ANIMTIMER)
7016+ C613 20 16            JR NZ, .daFrameSet
7017+ C615 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7018+ C619 DD 7E 00         LD A, (IX+ENT_SPRITEID)
7019+ C61C 47               LD B, A
7020+ C61D DD 96 08         SUB (IX+ENT_ANIMBASE)
7021+ C620 E6 01            AND 1
7022+ C622 20 03            JR NZ, .daFrameDec
7023+ C624 04               INC B
7024+ C625 18 01            JR .daFrameStore
7025+ C627              .daFrameDec:
7026+ C627 05               DEC B
7027+ C628              .daFrameStore:
7028+ C628 DD 70 00         LD (IX+ENT_SPRITEID), B
7029+ C62B              .daFrameSet:
7030+ C62B DD 7E 00         LD A, (IX+ENT_SPRITEID)
7031+ C62E DD 96 08         SUB (IX+ENT_ANIMBASE)
7032+ C631 E6 01            AND 1
7033+ C633 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
7034+ C636 81               ADD A, C
7035+ C637 DD 77 00         LD (IX+ENT_SPRITEID), A
7036+ C63A C9               RET
7037+ C63B
7038+ C63B              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
7039+ C63B              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
7040+ C63B              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
7041+ C63B              ; timer >= DEATH_SPAWN_FRAMES).
7042+ C63B              SpawnDeath:
7043+ C63B                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
7044+ C63B                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
7045+ C63B                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
7046+ C63B                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
7047+ C63B                  ; atravesando el mapa.
7048+ C63B CD 37 94         CALL FindFarthestAnyFreeCell
7049+ C63E C8               RET Z                               ; sin candidato: reintento siguiente frame
7050+ C63F              .sdHaveCell:
7051+ C63F                  ; B = cx, C = cy
7052+ C63F DD 21 50 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7053+ C643                  ; POSX = cx * 8
7054+ C643 78               LD A, B
7055+ C644 87               ADD A, A
7056+ C645 87               ADD A, A
7057+ C646 87               ADD A, A
7058+ C647 DD 77 03         LD (IX+ENT_POSX), A
7059+ C64A DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
7060+ C64D                  ; POSY = cy * 8 + SCREEN_MIN_Y
7061+ C64D 79               LD A, C
7062+ C64E 87               ADD A, A
7063+ C64F 87               ADD A, A
7064+ C650 87               ADD A, A
7065+ C651 C6 10            ADD A, SCREEN_MIN_Y
7066+ C653 DD 77 04         LD (IX+ENT_POSY), A
7067+ C656 DD 77 0D         LD (IX+ENT_OLDY), A
7068+ C659                  ; Tipo / estado / sprite
7069+ C659 DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
7070+ C65D DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
7071+ C661 DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
7072+ C665 DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
7073+ C669 DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
7074+ C66D DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7075+ C671 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7076+ C675 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7077+ C679 DD 36 0A 00      LD (IX+ENT_DIR), 0
7078+ C67D                  ; Color: blanco brillante sobre negro (espectral)
7079+ C67D DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7080+ C681                  ; Flags: visible + newspawn (no destructible: la muerte es invulnerable)
7081+ C681 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
7082+ C685                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
7083+ C685 AF               XOR A
7084+ C686 32 00 83         LD (DeathSubPixelAcc), A
7085+ C689 32 03 83         LD (DeathStuckCounter), A
7086+ C68C 32 06 83         LD (DeathGhostMode), A
7087+ C68F 21 00 00         LD HL, 0
