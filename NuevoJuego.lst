1181+ A567              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1182+ A567              ; ==============================================================================
1183+ A567              ; IX = puntero a la entidad del player (slot 0)
1184+ A567              ; ==============================================================================
1185+ A567              UpdatePlayer:
1186+ A567 CD 8F A5         CALL UpdatePlayerState
1187+ A56A CD B3 A6         CALL UpdatePlayerMovement
1188+ A56D CD 2C A9         CALL UpdatePlayerAnimation
1189+ A570                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1190+ A570                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1191+ A570                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1192+ A570                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1193+ A570                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1194+ A570                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1195+ A570                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1196+ A570                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1197+ A570                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1198+ A570                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1199+ A570                  ; tickea a tiempo y reescribe SPRITEID).
1200+ A570 3A EE 82         LD A, (PlayerRespawnTimer)
1201+ A573 B7               OR A
1202+ A574 C8               RET Z
1203+ A575 3A 9A 81         LD A, (GameFrameCounter)
1204+ A578 E6 02            AND 2
1205+ A57A 28 0D            JR Z, .pblOffFrame
1206+ A57C                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1207+ A57C DD 7E 00         LD A, (IX+ENT_SPRITEID)
1208+ A57F FE 74            CP SPRID_PLAYER_BLANK
1209+ A581 C0               RET NZ                              ; sprite válido (anim viva) → keep
1210+ A582 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1211+ A585 DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1212+ A588 C9               RET
1213+ A589              .pblOffFrame:
1214+ A589 3E 74            LD A, SPRID_PLAYER_BLANK
1215+ A58B 32 9D 81         LD (EntityTable), A
1216+ A58E C9               RET
1217+ A58F
1218+ A58F              ; ==============================================================================
1219+ A58F              ; UpdatePlayerState - Determina estado y direccion desde input
1220+ A58F              ; ==============================================================================
1221+ A58F              UpdatePlayerState:
1222+ A58F 3A AD 82         LD A, (InputDirection)
1223+ A592 47               LD B, A
1224+ A593 3A AE 82         LD A, (InputFire)
1225+ A596 4F               LD C, A
1226+ A597
1227+ A597                  ; Sin input → idle (salvo si ataque en curso)
1228+ A597 78               LD A, B
1229+ A598 B1               OR C
1230+ A599 20 17            JR NZ, .notIdle
1231+ A59B                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1232+ A59B 3A 6D B3         LD A, (AttackTimer)
1233+ A59E B7               OR A
1234+ A59F 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1235+ A5A1 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1236+ A5A5                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1237+ A5A5 DD 7E 0A         LD A, (IX+ENT_DIR)
1238+ A5A8 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1239+ A5AA DD 77 0A         LD (IX+ENT_DIR), A
1240+ A5AD                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1241+ A5AD AF               XOR A
1242+ A5AE 32 6F B3         LD (AttackDebounce), A
1243+ A5B1 C9               RET
1244+ A5B2
1245+ A5B2              .notIdle:
1246+ A5B2                  ; Guardar direccion actual en bits 0-3
1247+ A5B2 DD 7E 0A         LD A, (IX+ENT_DIR)
1248+ A5B5 E6 F0            AND $F0                     ; Mantener lastHDir
1249+ A5B7 B0               OR B                        ; Añadir dir actual
1250+ A5B8 DD 77 0A         LD (IX+ENT_DIR), A
1251+ A5BB
1252+ A5BB                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1253+ A5BB 3A 6D B3         LD A, (AttackTimer)
1254+ A5BE B7               OR A
1255+ A5BF 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1256+ A5C1 78               LD A, B
1257+ A5C2 E6 0C            AND DIR_E | DIR_W
1258+ A5C4 28 0E            JR Z, .noHorizUpdate
1259+ A5C6                  ; Guardar en bits 4-7
1260+ A5C6 07               RLCA
1261+ A5C7 07               RLCA
1262+ A5C8 07               RLCA
1263+ A5C9 07               RLCA                        ; Shift a bits 4-7
1264+ A5CA 4F               LD C, A                     ; C = lastHDir en bits 4-7
1265+ A5CB DD 7E 0A         LD A, (IX+ENT_DIR)
1266+ A5CE E6 0F            AND $0F                     ; Mantener dir actual
1267+ A5D0 B1               OR C                        ; Añadir lastHDir
1268+ A5D1 DD 77 0A         LD (IX+ENT_DIR), A
1269+ A5D4              .noHorizUpdate:
1270+ A5D4
1271+ A5D4                  ; --- Consumir/regenerar stamina ---
1272+ A5D4 CD 5F AA         CALL UpdateStamina
1273+ A5D7                  ; --- Auto-select sword mode segun stamina ---
1274+ A5D7 CD BD AA         CALL SelectSwordMode
1275+ A5DA                  ; --- Dispatch segun SwordMode ---
1276+ A5DA 3A 71 B3         LD A, (SwordMode)
1277+ A5DD B7               OR A
1278+ A5DE 28 09            JR Z, .swordModeB
1279+ A5E0 FE 01            CP 1
1280+ A5E2 28 48            JR Z, .swordModeC
1281+ A5E4 FE 02            CP 2
1282+ A5E6 CA 55 A6         JP Z, .swordModeFree
1283+ A5E9
1284+ A5E9                  ; === MODO B: Cooldown fijo tras atacar ===
1285+ A5E9              .swordModeB:
1286+ A5E9 3A 6E B3         LD A, (AttackCooldown)
1287+ A5EC B7               OR A
1288+ A5ED 28 0D            JR Z, .bNoCooldown
1289+ A5EF 3D               DEC A
1290+ A5F0 32 6E B3         LD (AttackCooldown), A
1291+ A5F3 C2 A3 A6         JP NZ, .running                     ; En cooldown: no puede atacar
1292+ A5F6                  ; Cooldown terminado: restaurar color blanco
1293+ A5F6 CD 7C A6         CALL .setPlayerWhite
1294+ A5F9 C3 A3 A6         JP .running
1295+ A5FC              .bNoCooldown:
1296+ A5FC 3A 6D B3         LD A, (AttackTimer)
1297+ A5FF B7               OR A
1298+ A600 28 1C            JR Z, .bNoActive
1299+ A602 3D               DEC A
1300+ A603 32 6D B3         LD (AttackTimer), A
1301+ A606 20 11            JR NZ, .bActive
1302+ A608                  ; Swing terminado: iniciar cooldown + color azul.
1303+ A608                  ; ESPADA buff activo: skip cooldown + skip blue color (rapid fire).
1304+ A608 3A DA 5F         LD A, (EspadaTimer)
1305+ A60B 21 DB 5F         LD HL, EspadaTimer + 1
1306+ A60E B6               OR (HL)
1307+ A60F 20 08            JR NZ, .bActive                     ; Espada: ataca de nuevo sin cooldown
1308+ A611 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1309+ A613 32 6E B3         LD (AttackCooldown), A
1310+ A616 CD 71 A6         CALL .setPlayerBlue
1311+ A619              .bActive:
1312+ A619 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1313+ A61D C9               RET
1314+ A61E              .bNoActive:
1315+ A61E 3A AE 82         LD A, (InputFire)
1316+ A621 B7               OR A
1317+ A622 CA A3 A6         JP Z, .running
1318+ A625 3E 05            LD A, ATTACK_SWING_FRAMES
1319+ A627 32 6D B3         LD (AttackTimer), A
1320+ A62A 18 5B            JR .startAttack
1321+ A62C
1322+ A62C                  ; === MODO C: Swing fijo con debounce ===
1323+ A62C              .swordModeC:
1324+ A62C 3A 6D B3         LD A, (AttackTimer)
1325+ A62F B7               OR A
1326+ A630 28 09            JR Z, .cNoActive
1327+ A632 3D               DEC A
1328+ A633 32 6D B3         LD (AttackTimer), A
1329+ A636 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1330+ A63A C9               RET
1331+ A63B              .cNoActive:
1332+ A63B 3A AE 82         LD A, (InputFire)
1333+ A63E B7               OR A
1334+ A63F CA 9F A6         JP Z, .attackReleased
1335+ A642 3A 6F B3         LD A, (AttackDebounce)
1336+ A645 B7               OR A
1337+ A646 C2 A3 A6         JP NZ, .running                     ; Aun mantenido → no re-atacar
1338+ A649 3E 01            LD A, 1
1339+ A64B 32 6F B3         LD (AttackDebounce), A
1340+ A64E 3E 05            LD A, ATTACK_SWING_FRAMES
1341+ A650 32 6D B3         LD (AttackTimer), A
1342+ A653 18 32            JR .startAttack
1343+ A655
1344+ A655                  ; === MODO LIBRE: mantener SPACE = atacar continuo (stamina alta) ===
1345+ A655              .swordModeFree:
1346+ A655 3A 6D B3         LD A, (AttackTimer)
1347+ A658 B7               OR A
1348+ A659 28 09            JR Z, .fNoActive
