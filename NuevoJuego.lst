 227+ 9AC6              ; ==============================================================================
 228+ 9AC6              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9AC6              ; ==============================================================================
 230+ 9AC6              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9AC6              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9AC6              ;
 233+ 9AC6              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9AC6              ; ==============================================================================
 235+ 9AC6              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9AC6              NextPixelLine:
 237+ 9AC6 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9AC7 7C               LD A, H
 239+ 9AC8 E6 07            AND 7
 240+ 9ACA C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9ACB
 242+ 9ACB                  ; --- Cruce de character row ---
 243+ 9ACB 7D               LD A, L
 244+ 9ACC C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9ACE 6F               LD L, A
 246+ 9ACF E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD1 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9AD2
 249+ 9AD2                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9AD2 7C               LD A, H
 251+ 9AD3 D6 08            SUB 8
 252+ 9AD5 67               LD H, A
 253+ 9AD6 C9               RET
 254+ 9AD7
 255+ 9AD7              ; ==============================================================================
 256+ 9AD7              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9AD7              ; ==============================================================================
 258+ 9AD7              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9AD7              ; Entrada:
 260+ 9AD7              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9AD7              ;   A = atributo a pintar
 262+ 9AD7              ; ==============================================================================
 263+ 9AD7              SetEntityAttr:
 264+ 9AD7 F5               PUSH AF                     ; Guardar atributo
 265+ 9AD8 CD 3F 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9ADB F1               POP AF
 267+ 9ADC
 268+ 9ADC 47               LD B, A                     ; B = atributo (preservar)
 269+ 9ADD 3A D6 9B         LD A, (EntityAttrH)
 270+ 9AE0 4F               LD C, A                     ; C = filas
 271+ 9AE1              .rowLoop:
 272+ 9AE1                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE1 E5               PUSH HL
 274+ 9AE2 7C               LD A, H
 275+ 9AE3 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9AE5 20 08            JR NZ, .rowNotHud
 277+ 9AE7 7D               LD A, L
 278+ 9AE8 FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AEA 30 03            JR NC, .rowNotHud
 280+ 9AEC                  ; Fila en HUD → saltar sin pintar
 281+ 9AEC E1               POP HL
 282+ 9AED 18 0B            JR .rowSkip
 283+ 9AEF              .rowNotHud:
 284+ 9AEF E1               POP HL
 285+ 9AF0 3A D5 9B         LD A, (EntityAttrW)
 286+ 9AF3 E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AF4                  ; Pintar una fila
 288+ 9AF4              .colLoop:
 289+ 9AF4 70               LD (HL), B
 290+ 9AF5 23               INC HL
 291+ 9AF6 3D               DEC A
 292+ 9AF7 20 FB            JR NZ, .colLoop
 293+ 9AF9 E1               POP HL
 294+ 9AFA              .rowSkip:
 295+ 9AFA                  ; Siguiente fila: HL += 32
 296+ 9AFA D5               PUSH DE
 297+ 9AFB 11 20 00         LD DE, 32
 298+ 9AFE 19               ADD HL, DE
 299+ 9AFF D1               POP DE
 300+ 9B00 0D               DEC C
 301+ 9B01 20 DE            JR NZ, .rowLoop
 302+ 9B03 C9               RET
