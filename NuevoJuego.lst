 469+ E7A4              ; ---- Phase 9: player IDLE mirando jugador, luego inicia walk-down ----
 470+ E7A4              ; Sin teleport ni anchor2: cambia sprite a WALK_S in-place y entra directo
 471+ E7A4              ; en PLAYER_EXIT desde anchor1. Tras el redraw final del IDLE→WALK_S,
 472+ E7A4              ; ejecuta RestoreOldAttr en anchor1 para limpiar los player attrs (porque
 473+ E7A4              ; el slide-down ya no los va a re-pintar — usa clipped XOR sin attrs).
 474+ E7A4              ; Phases 10 (PLAYER_HIDE) y 11 (PLAYER_FRAMED) quedan dead-code.
 475+ E7A4              .tgPhPlayerTurn:
 476+ E7A4 CD 2B E8         CALL TownGateDecTimer
 477+ E7A7 C0               RET NZ
 478+ E7A8 DD 21 A3 81      LD IX, EntityTable
 479+ E7AC 3E 0E            LD A, SPRID_WALK_S
 480+ E7AE DD 77 00         LD (IX+ENT_SPRITEID), A
 481+ E7B1 DD 77 08         LD (IX+ENT_ANIMBASE), A
 482+ E7B4 AF               XOR A
 483+ E7B5 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 484+ E7B8 32 A8 5F         LD (TownGateExitStepCnt), A
 485+ E7BB 3E 01            LD A, 1
 486+ E7BD 32 A9 5F         LD (TownGateExitWalkFrame), A
 487+ E7C0 CD 56 6D         CALL TownGateRedrawPlayer_B7           ; turn IDLE → WALK_S + paint attrs anchor1
 488+ E7C3 DD 21 A3 81      LD IX, EntityTable
 489+ E7C7 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; anchor1 Y (= POSY tras redraw)
 490+ E7CA DD 5E 0C         LD E, (IX+ENT_OLDX)
 491+ E7CD CD 8C 6D         CALL RestoreOldAttr_B7                 ; clear player attrs en anchor1
 492+ E7D0 CD 02 EA         CALL SFX_TownGate_OnPlayerExit
 493+ E7D3 3E 0C            LD A, TGP_PLAYER_EXIT
 494+ E7D5 32 D0 82         LD (TownGatePhase), A
 495+ E7D8 C9               RET
