1009+ 6573              ; ==============================================================================
1010+ 6573              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 6573              ; ==============================================================================
1012+ 6573              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 6573              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 6573              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 6573              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 6573              ; ==============================================================================
1017+ 6573              TownGateExitStep:
1018+ 6573 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 6576 3C               INC A
1020+ 6577 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 657A FE 02            CP TGCS_T_EXIT_STEP
1022+ 657C D8               RET C                               ; aun no toca step
1023+ 657D AF               XOR A
1024+ 657E 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 6581                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 6581 DD 21 3F 81      LD IX, EntityTable
1027+ 6585 DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 6588 3C               INC A
1029+ 6589 DD 77 04         LD (IX+ENT_POSY), A
1030+ 658C 32 6E 82         LD (PlayerDrawY), A
1031+ 658F 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 6592 EE 01            XOR 1                               ; toggle 0/1
1033+ 6594 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 6597 47               LD B, A
1035+ 6598 3E 0E            LD A, SPRID_WALK_S
1036+ 659A 80               ADD A, B
1037+ 659B DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 659E                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 659E                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 659E                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 659E                  ; part1 attrs ni de door attrs.
1042+ 659E CD 10 64         CALL TownGatePlayerSlideErase
1043+ 65A1 C3 46 64         JP TownGatePlayerSlideDraw          ; tail call
1044+ 65A4
1045+ 65A4              ; ==============================================================================
1046+ 65A4              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
1047+ 65A4              ; ==============================================================================
1048+ 65A4              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
1049+ 65A4              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1050+ 65A4              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1051+ 65A4              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1052+ 65A4              ; Destruye: AF, BC, DE, HL, IX.
1053+ 65A4              ; ==============================================================================
1054+ 65A4              TownGateDrawTheEnd:
1055+ 65A4 21 9C E6         LD HL, BgGfx_the_end
1056+ 65A7 3E 03            LD A, 3
1057+ 65A9 CD 74 6A         CALL LoadBgSpriteToBuffer
1058+ 65AC DD 21 87 89      LD IX, BgSpriteBuffer
1059+ 65B0 06 0B            LD B, TGCS_END_CHARX
1060+ 65B2 0E 04            LD C, TGCS_END_CHARY
1061+ 65B4 AF               XOR A
1062+ 65B5 32 9C E4         LD (BgSpriteIsHouse), A
1063+ 65B8 32 9D D4         LD (CurrentTintVar), A              ; sin tint
1064+ 65BB C3 93 D3         JP DrawBgGfxSprite
1065+ 65BE
1066+ 65BE              ; ==============================================================================
1067+ 65BE              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1068+ 65BE              ; ==============================================================================
1069+ 65BE              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1070+ 65BE              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1071+ 65BE              ; quedara visible sobre fondo negro.
1072+ 65BE              ; ==============================================================================
1073+ 65BE              TownGateWipeBlack:
1074+ 65BE 21 00 40         LD HL, $4000
1075+ 65C1 11 01 40         LD DE, $4001
1076+ 65C4 01 FF 17         LD BC, $17FF
1077+ 65C7 36 00            LD (HL), 0
1078+ 65C9 ED B0            LDIR
1079+ 65CB 21 00 58         LD HL, $5800
1080+ 65CE 11 01 58         LD DE, $5801
1081+ 65D1 01 FF 02         LD BC, $02FF
1082+ 65D4 36 00            LD (HL), $00                        ; ink black, paper black
1083+ 65D6 ED B0            LDIR
1084+ 65D8 C9               RET
1085+ 65D9
1086+ 65D9              ; ==============================================================================
1087+ 65D9              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1088+ 65D9              ; ==============================================================================
1089+ 65D9              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1090+ 65D9              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1091+ 65D9              ; (white ink, black paper, bright) para todo el area de texto.
1092+ 65D9              ; ==============================================================================
1093+ 65D9              TownGateDrawCredits:
1094+ 65D9                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1095+ 65D9 21 00 58         LD HL, $5800
1096+ 65DC 11 01 58         LD DE, $5801
1097+ 65DF 01 FF 02         LD BC, $02FF
1098+ 65E2 36 47            LD (HL), $47
1099+ 65E4 ED B0            LDIR
1100+ 65E6                  ; Iterar credits
1101+ 65E6 21 3A 66         LD HL, TownGateCreditsData
1102+ 65E9              .tgdcLoop:
1103+ 65E9 7E               LD A, (HL)
1104+ 65EA FE FF            CP $FF
1105+ 65EC C8               RET Z
1106+ 65ED 57               LD D, A                             ; D = row
1107+ 65EE 23               INC HL
1108+ 65EF 7E               LD A, (HL)
1109+ 65F0 5F               LD E, A                             ; E = col
1110+ 65F1 23               INC HL                              ; HL → string
1111+ 65F2 CD F7 65         CALL PrintStringFontAt
1112+ 65F5 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1113+ 65F7
1114+ 65F7              ; ==============================================================================
1115+ 65F7              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1116+ 65F7              ; ==============================================================================
1117+ 65F7              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1118+ 65F7              ; siguiente byte tras el 0 (para que el caller siga iterando).
1119+ 65F7              ; Destruye: AF, BC, DE, HL.
1120+ 65F7              ; OUT: HL apunta al byte tras el 0 terminador.
1121+ 65F7              ; ==============================================================================
1122+ 65F7              PrintStringFontAt:
1123+ 65F7              .psfaCharLoop:
1124+ 65F7 7E               LD A, (HL)
1125+ 65F8 23               INC HL
1126+ 65F9 B7               OR A
1127+ 65FA C8               RET Z                               ; fin de string
1128+ 65FB E5               PUSH HL
1129+ 65FC D5               PUSH DE
1130+ 65FD CD 05 66         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1131+ 6600 D1               POP DE
1132+ 6601 E1               POP HL
1133+ 6602 1C               INC E                               ; siguiente columna
1134+ 6603 18 F2            JR .psfaCharLoop
1135+ 6605
1136+ 6605              ; ==============================================================================
1137+ 6605              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1138+ 6605              ; ==============================================================================
1139+ 6605              ; D = row (0..23), E = col (0..31), A = ASCII char.
1140+ 6605              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1141+ 6605              ;   y = row * 8, x = col * 8
1142+ 6605              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1143+ 6605              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1144+ 6605              ; Destruye: AF, BC, DE, HL.
1145+ 6605              ; ==============================================================================
1146+ 6605              DrawCharFontAt:
1147+ 6605 D5               PUSH DE
1148+ 6606                  ; HL = $3C00 + char * 8
1149+ 6606 6F               LD L, A
1150+ 6607 26 00            LD H, 0
1151+ 6609 29               ADD HL, HL
1152+ 660A 29               ADD HL, HL
1153+ 660B 29               ADD HL, HL
1154+ 660C 01 00 3C         LD BC, $3C00
1155+ 660F 09               ADD HL, BC
1156+ 6610 D1               POP DE
1157+ 6611                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1158+ 6611 E5               PUSH HL                             ; save font ptr
1159+ 6612 7A               LD A, D
1160+ 6613 87               ADD A, A
1161+ 6614 87               ADD A, A
1162+ 6615 87               ADD A, A                            ; A = row * 8 = pixel Y
1163+ 6616 57               LD D, A
1164+ 6617 7B               LD A, E
1165+ 6618 87               ADD A, A
1166+ 6619 87               ADD A, A
1167+ 661A 87               ADD A, A                            ; A = col * 8 = pixel X
1168+ 661B 5F               LD E, A
1169+ 661C CD 92 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
1170+ 661F EB               EX DE, HL                           ; DE = VRAM addr
1171+ 6620 E1               POP HL                              ; HL = font ptr
1172+ 6621 06 08            LD B, 8
1173+ 6623              .dcfaLoop:
1174+ 6623 7E               LD A, (HL)
1175+ 6624 12               LD (DE), A
1176+ 6625 23               INC HL
1177+ 6626 14               INC D                               ; siguiente scan line (within char)
1178+ 6627 10 FA            DJNZ .dcfaLoop
1179+ 6629 C9               RET
