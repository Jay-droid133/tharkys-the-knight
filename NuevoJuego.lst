 486  CCA9                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCA9              ; ==============================================================================
   2+ CCA9              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCA9              ; ==============================================================================
   4+ CCA9              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCA9              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCA9              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCA9              ; ==============================================================================
   8+ CCA9
   9+ CCA9              ; ==============================================================================
  10+ CCA9              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCA9              ; ==============================================================================
  12+ CCA9              InitScreenSystem:
  13+ CCA9 3E 08            LD A, START_SCREEN_X
  14+ CCAB 32 08 83         LD (CurrentScreenX), A
  15+ CCAE 3E 09            LD A, START_SCREEN_Y
  16+ CCB0 32 09 83         LD (CurrentScreenY), A
  17+ CCB3 3E 01            LD A, 1
  18+ CCB5 32 10 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCB8 AF               XOR A
  20+ CCB9 32 0C 83         LD (ScreenTransition), A
  21+ CCBC CD C0 CC         CALL CalcScreenAddress
  22+ CCBF C9               RET
  23+ CCC0
  24+ CCC0              ; ==============================================================================
  25+ CCC0              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CCC0              ; ==============================================================================
  27+ CCC0              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CCC0              ; ==============================================================================
  29+ CCC0              CalcScreenAddress:
  30+ CCC0 3A 09 83         LD A, (CurrentScreenY)
  31+ CCC3 6F               LD L, A
  32+ CCC4 26 00            LD H, 0
  33+ CCC6 29               ADD HL, HL                  ; x2
  34+ CCC7 29               ADD HL, HL                  ; x4
  35+ CCC8 29               ADD HL, HL                  ; x8
  36+ CCC9 29               ADD HL, HL                  ; x16
  37+ CCCA 3A 08 83         LD A, (CurrentScreenX)
  38+ CCCD 5F               LD E, A
  39+ CCCE 16 00            LD D, 0
  40+ CCD0 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CCD1 11 EA DD         LD DE, MapTable
  42+ CCD4 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CCD5 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CCD6                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CCD6 6F               LD L, A
  46+ CCD7 26 00            LD H, 0
  47+ CCD9 29               ADD HL, HL                  ; index * 2
  48+ CCDA 11 B8 DC         LD DE, RoomTable
  49+ CCDD 19               ADD HL, DE
  50+ CCDE 5E               LD E, (HL)
  51+ CCDF 23               INC HL
  52+ CCE0 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CCE1                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CCE1 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CCE2 CD 72 6C         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CCE5                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CCE5 11 F5 85         LD DE, CurrentScreenBuffer
  58+ CCE8 ED 53 0A 83      LD (CurrentScreenAddr), DE
  59+ CCEC C9               RET
  60+ CCED
  61+ CCED              ; ==============================================================================
  62+ CCED              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CCED              ; ==============================================================================
  64+ CCED              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CCED              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CCED              ; por estar atrapado cerca del borde.
  67+ CCED              ; ==============================================================================
  68+ CCED              CheckScreenTransition:
  69+ CCED AF               XOR A
  70+ CCEE 32 0C 83         LD (ScreenTransition), A
  71+ CCF1
  72+ CCF1                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CCF1                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CCF1                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CCF1                  ; dispararia transicion sur en plena animacion.
  76+ CCF1 3A C8 82         LD A, (TownGatePhase)
  77+ CCF4 B7               OR A
  78+ CCF5 C0               RET NZ
  79+ CCF6
  80+ CCF6                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CCF6                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CCF6                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CCF6                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CCF6                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CCF6                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CCF6 3A B3 82         LD A, (TimeFrozen)
  87+ CCF9 B7               OR A
  88+ CCFA 28 23            JR Z, .cstNotFrozen
  89+ CCFC 3A AB 82         LD A, (InputDirection)
  90+ CCFF CB 4F            BIT 1, A                    ; S
  91+ CD01 28 17            JR Z, .cstClearBlockFlag
  92+ CD03 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  93+ CD06 FE A8            CP SCREEN_MAX_Y
  94+ CD08 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD0A                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD0A 3A B4 82         LD A, (BlockedExitSoundFlag)
  97+ CD0D B7               OR A
  98+ CD0E C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD0F 3E 01            LD A, 1
 100+ CD11 32 B4 82         LD (BlockedExitSoundFlag), A
 101+ CD14 21 7D F8         LD HL, SFX_BlockedExit
 102+ CD17 C3 50 F7         JP PlaySFX                  ; tail call
 103+ CD1A              .cstClearBlockFlag:
 104+ CD1A AF               XOR A
 105+ CD1B 32 B4 82         LD (BlockedExitSoundFlag), A
 106+ CD1E C9               RET
 107+ CD1F              .cstNotFrozen:
 108+ CD1F                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD1F AF               XOR A
 110+ CD20 32 B4 82         LD (BlockedExitSoundFlag), A
 111+ CD23
 112+ CD23 3A AB 82         LD A, (InputDirection)
 113+ CD26 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CD27
 115+ CD27                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CD27 CB 5A            BIT 3, D                    ; W
 117+ CD29 CA 8A CD         JP Z, .noWest
