 450+ EF63 32 AE EF         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EF66 7B               LD A, E
 452+ EF67 32 AF EF         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EF6A 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EF6C 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
