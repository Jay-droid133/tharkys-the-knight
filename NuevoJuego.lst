 398+ 65A1 2A 12 83         LD HL, (CurrentScreenAddr)
 399+ 65A4              .eseLoop:
 400+ 65A4 7E               LD A, (HL)
 401+ 65A5 FE FF            CP $FF
 402+ 65A7 C8               RET Z                                   ; no encontrada en esta pantalla
 403+ 65A8 47               LD B, A                                 ; B = current id
 404+ 65A9 3A DA 65         LD A, (.eseTargetId)
 405+ 65AC B8               CP B
 406+ 65AD 28 06            JR Z, .eseFound
 407+ 65AF 11 04 00         LD DE, 4
 408+ 65B2 19               ADD HL, DE
 409+ 65B3 18 EF            JR .eseLoop
 410+ 65B5              .eseFound:
 411+ 65B5                  ; HL en id. Avanzar a charX, charY.
 412+ 65B5 23               INC HL
 413+ 65B6 46               LD B, (HL)                              ; B = charX
 414+ 65B7 23               INC HL
 415+ 65B8 4E               LD C, (HL)                              ; C = charY
 416+ 65B9                  ; Cargar sprite via BgGfxPtrById[id]: id*3 -> ptr (DEFW), bank (DEFB).
 417+ 65B9 3A DA 65         LD A, (.eseTargetId)
 418+ 65BC 6F               LD L, A
 419+ 65BD 26 00            LD H, 0
 420+ 65BF 54               LD D, H
 421+ 65C0 5D               LD E, L
 422+ 65C1 29               ADD HL, HL                              ; *2
 423+ 65C2 19               ADD HL, DE                              ; *3
 424+ 65C3 11 F6 E0         LD DE, BgGfxPtrById
 425+ 65C6 19               ADD HL, DE
 426+ 65C7 5E               LD E, (HL)
 427+ 65C8 23               INC HL
 428+ 65C9 56               LD D, (HL)                              ; DE = ptr
 429+ 65CA 23               INC HL
 430+ 65CB 7E               LD A, (HL)                              ; A = bank
 431+ 65CC C5               PUSH BC
 432+ 65CD EB               EX DE, HL                               ; HL = ptr
 433+ 65CE CD C9 67         CALL LoadBgSpriteToBuffer               ; preserva BC
 434+ 65D1 C1               POP BC
