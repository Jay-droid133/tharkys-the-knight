 124+ EA26              ; UpdateGameClock
 125+ EA26              ; ==============================================================================
 126+ EA26              UpdateGameClock:
 127+ EA26 3A B6 82         LD A, (TimeFrozen)
 128+ EA29 B7               OR A
 129+ EA2A C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EA2B 21 8C E8         LD HL, GameSubMinute
 131+ EA2E 34               INC (HL)
 132+ EA2F 3A 8F E8         LD A, (SubMinuteMax)
 133+ EA32 BE               CP (HL)
 134+ EA33 C0               RET NZ
 135+ EA34
 136+ EA34 AF               XOR A
 137+ EA35 32 8C E8         LD (GameSubMinute), A
 138+ EA38 21 8D E8         LD HL, GameMinutes
 139+ EA3B 34               INC (HL)
 140+ EA3C                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EA3C                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EA3C 3A 8D E8         LD A, (GameMinutes)
 143+ EA3F FE 3C            CP 60
 144+ EA41 C0               RET NZ
 145+ EA42
 146+ EA42 AF               XOR A
 147+ EA43 32 8D E8         LD (GameMinutes), A
 148+ EA46 21 8E E8         LD HL, GameHours
 149+ EA49 34               INC (HL)
 150+ EA4A 7E               LD A, (HL)
 151+ EA4B FE 18            CP 24
 152+ EA4D 20 04            JR NZ, .checkPhase
 153+ EA4F AF               XOR A
 154+ EA50 32 8E E8         LD (GameHours), A
 155+ EA53
 156+ EA53              .checkPhase:
 157+ EA53 3A 8E E8         LD A, (GameHours)
 158+ EA56 21 98 E8         LD HL, PhaseTable
 159+ EA59 06 07            LD B, 7
 160+ EA5B              .phaseLoop:
 161+ EA5B BE               CP (HL)
 162+ EA5C 28 05            JR Z, .phaseFound
 163+ EA5E 23               INC HL
 164+ EA5F 23               INC HL
 165+ EA60 10 F9            DJNZ .phaseLoop
 166+ EA62 C9               RET
 167+ EA63              .phaseFound:
 168+ EA63 23               INC HL
 169+ EA64 7E               LD A, (HL)
 170+ EA65 F5               PUSH AF
 171+ EA66 CD 2E E2         CALL SetTimeOfDay
 172+ EA69 F1               POP AF
 173+ EA6A FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EA6C C0               RET NZ
 175+ EA6D                  ; Nuevo dia: incrementar ciclo
 176+ EA6D 21 AA BC         LD HL, DayCycleCount
 177+ EA70 34               INC (HL)
 178+ EA71 C9               RET
