 563+ 8B42              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
 564+ 8B42              ; ==============================================================================
 565+ 8B42              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
 566+ 8B42              ; IX = puntero a la entidad
 567+ 8B42              ; ==============================================================================
 568+ 8B42              DrawEntity:
 569+ 8B42 CD 77 8B         CALL GetSpriteAddr
 570+ 8B45
 571+ 8B45                  ; Guardar attrs del fondo ANTES de pintar
 572+ 8B45 DD 56 04         LD D, (IX+ENT_POSY)
 573+ 8B48 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 574+ 8B4B 5F               LD E, A
 575+ 8B4C DD E5            PUSH IX
 576+ 8B4E DD 2A 8A 8B      LD IX, (SpriteAddrTemp)
 577+ 8B52 CD 1F 85         CALL SaveEntityAttr
 578+ 8B55 DD E1            POP IX
 579+ 8B57
 580+ 8B57                  ; Pintar atributo ANTES del draw
 581+ 8B57 DD 56 04         LD D, (IX+ENT_POSY)
 582+ 8B5A DD 7E 0F         LD A, (IX+ENT_DRAWX)
 583+ 8B5D 5F               LD E, A
 584+ 8B5E DD 7E 05         LD A, (IX+ENT_ATTR)
 585+ 8B61 CD E0 84         CALL SetEntityAttr
 586+ 8B64
 587+ 8B64                  ; XOR draw del sprite
 588+ 8B64 DD 56 04         LD D, (IX+ENT_POSY)
 589+ 8B67 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 590+ 8B6A 5F               LD E, A
 591+ 8B6B DD E5            PUSH IX
 592+ 8B6D DD 2A 8A 8B      LD IX, (SpriteAddrTemp)
