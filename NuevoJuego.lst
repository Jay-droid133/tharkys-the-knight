 466+ 8F8E C5               PUSH BC
 467+ 8F8F DD 7E 01         LD A, (IX+ENT_TYPE)
 468+ 8F92 FE 02            CP TYPE_MONSTER
 469+ 8F94 20 12            JR NZ, .dsmNext
 470+ 8F96 DD 7E 02         LD A, (IX+ENT_STATE)
 471+ 8F99 FE 05            CP STATE_SCARED
 472+ 8F9B 20 0B            JR NZ, .dsmNext
 473+ 8F9D CD 49 8F         CALL WipeMonsterSlot
 474+ 8FA0 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 8FA4 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
