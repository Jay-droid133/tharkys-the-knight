 931+ D4F8              ; ==============================================================================
 932+ D4F8              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 933+ D4F8              ; ==============================================================================
 934+ D4F8              ; Entrada: A = attr byte
 935+ D4F8              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 936+ D4F8              ; Preserva: HL, DE, BC, IX
 937+ D4F8              ; ==============================================================================
 938+ D4F8              ApplyTintSwap:
 939+ D4F8 C5               PUSH BC
 940+ D4F9 47               LD B, A                     ; B = attr original
 941+ D4FA 3A F4 D4         LD A, (CurrentTintVar)
 942+ D4FD FE FF            CP $FF
 943+ D4FF 28 24            JR Z, .tintNoChange
 944+ D501 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 945+ D502 3A F5 D4         LD A, (CurrentTintPaper)
 946+ D505 FE FF            CP $FF
 947+ D507 28 1C            JR Z, .tintNoChange
 948+ D509                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 949+ D509                  ; Extraer paper del attr: bits 5-3
 950+ D509 78               LD A, B
 951+ D50A E6 38            AND $38                     ; A = 00PPP000
 952+ D50C 0F               RRCA
 953+ D50D 0F               RRCA
 954+ D50E 0F               RRCA                        ; A = 00000PPP = paper actual
 955+ D50F D5               PUSH DE
 956+ D510 57               LD D, A                     ; D = paper actual
 957+ D511 3A F5 D4         LD A, (CurrentTintPaper)
 958+ D514 BA               CP D                        ; paper actual == tintPaper?
 959+ D515 D1               POP DE
 960+ D516 20 0D            JR NZ, .tintNoChange
 961+ D518                  ; Match: reemplazar paper bits con tintVar
 962+ D518 78               LD A, B
 963+ D519 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 964+ D51B D5               PUSH DE
 965+ D51C 57               LD D, A
 966+ D51D 79               LD A, C                     ; A = tintVar (0-7)
 967+ D51E 07               RLCA
 968+ D51F 07               RLCA
 969+ D520 07               RLCA                        ; A = 00PPP000
 970+ D521 B2               OR D                        ; A = FBPPPIII
 971+ D522 D1               POP DE
 972+ D523 C1               POP BC
 973+ D524 C9               RET
 974+ D525              .tintNoChange:
 975+ D525 78               LD A, B                     ; devolver sin cambio
 976+ D526 C1               POP BC
