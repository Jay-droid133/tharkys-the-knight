 776+ CE2A                  ; --- Run: count = (A & $7F) + 2 ---
 777+ CE2A              .rleNewRun:
 778+ CE2A E6 7F            AND $7F
 779+ CE2C C6 02            ADD A, 2
 780+ CE2E 32 98 CE         LD (.rlePending), A
 781+ CE31 DD 7E 00         LD A, (IX+0)
 782+ CE34 DD 23            INC IX
 783+ CE36 32 99 CE         LD (.rleValue), A
 784+ CE39 18 BD            JR .rleRunEmit
 785+ CE3B
 786+ CE3B              .rleRowDone:
 787+ CE3B E1               POP HL                      ; restaurar inicio fila
 788+ CE3C 3A 93 CE         LD A, (.heightCnt)
 789+ CE3F 3D               DEC A
 790+ CE40 32 93 CE         LD (.heightCnt), A
 791+ CE43 28 05            JR Z, .pixDone
 792+ CE45 CD 9D 9E         CALL NextPixelLine
