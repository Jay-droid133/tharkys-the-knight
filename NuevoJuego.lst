 132  68E1                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 133  68E1                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 134  68E1                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 135  68E1                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 136  68E1                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 137  68E1                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 68E1              ; ==============================================================================
   2+ 68E1              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 68E1              ; ==============================================================================
   4+ 68E1              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 68E1              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 68E1              ; la cinematica — invisible porque es one-shot.
   7+ 68E1              ;
   8+ 68E1              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 68E1              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 68E1              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 68E1              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 68E1              ; ==============================================================================
  13+ 68E1
  14+ 68E1              ; ==============================================================================
  15+ 68E1              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 68E1              ; ==============================================================================
  17+ 68E1              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 68E1              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 68E1              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 68E1              ; ChurchCutsceneSlot.
  21+ 68E1              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 68E1              ; ==============================================================================
  23+ 68E1              EraseChurchTrappedMonster:
  24+ 68E1 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 68E4 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 68E5 6F               LD L, A
  27+ 68E6 26 00            LD H, 0
  28+ 68E8 29               ADD HL, HL
  29+ 68E9 29               ADD HL, HL
  30+ 68EA 29               ADD HL, HL
  31+ 68EB 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 68EC 11 9E 81         LD DE, EntityTable
  33+ 68EF 19               ADD HL, DE
  34+ 68F0 E5               PUSH HL
  35+ 68F1 DD E1            POP IX
  36+ 68F3 CD F7 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 68F6 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 68F9 57               LD D, A
  39+ 68FA DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 68FD 5F               LD E, A
  41+ 68FE DD 2A 7F A4      LD IX, (OldSprAddr)
  42+ 6902 C3 EA 99         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 6905
  44+ 6905              ; ==============================================================================
  45+ 6905              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 6905              ; ==============================================================================
  47+ 6905              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 6905              ; - Despawn monster (ENT_TYPE=0).
  49+ 6905              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 6905              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 6905              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 6905              ; ==============================================================================
  53+ 6905              ApplyChurchTrapDone:
  54+ 6905                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 6905 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 6908 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 6909 6F               LD L, A
  58+ 690A 26 00            LD H, 0
  59+ 690C 29               ADD HL, HL
  60+ 690D 29               ADD HL, HL
  61+ 690E 29               ADD HL, HL
  62+ 690F 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 6910 11 9E 81         LD DE, EntityTable
  64+ 6913 19               ADD HL, DE
  65+ 6914 E5               PUSH HL
  66+ 6915 DD E1            POP IX
  67+ 6917                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 6917                  ; guardado en TriggerChurchTrap).
  69+ 6917 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 691A 21 A6 69         LD HL, ChurchTrapBitMask
  71+ 691D 5F               LD E, A
  72+ 691E 16 00            LD D, 0
  73+ 6920 19               ADD HL, DE
  74+ 6921 7E               LD A, (HL)
  75+ 6922 21 C1 82         LD HL, MonsterTrappedFlags
  76+ 6925 B6               OR (HL)
  77+ 6926 77               LD (HL), A
  78+ 6927                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 6927                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 6927                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 6927 21 C2 82         LD HL, NextChurchTrapStep
  82+ 692A 34               INC (HL)
  83+ 692B                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 692B                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 692B                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 692B                  ; antes de quedarse fija en blanco brillante.
  87+ 692B DD E5            PUSH IX
  88+ 692D CD FF F2         CALL StartStatueBlink
  89+ 6930 DD E1            POP IX
  90+ 6932                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 6932                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 6932                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 6932 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 6936 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 693A DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 693E DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 6942                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 6942                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 6942                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 6942                  ; anteriores del cutscene.)
 101+ 6942                  ; Decidir spawn: 3 atrapados?
 102+ 6942 3A C1 82         LD A, (MonsterTrappedFlags)
 103+ 6945 E6 07            AND $07
 104+ 6947 FE 07            CP $07
 105+ 6949 28 12            JR Z, .actdAllTrapped
 106+ 694B                  ; <3 atrapados: respawn church_key en AltN
 107+ 694B 3E 01            LD A, 1
 108+ 694D 32 B3 82         LD (ChurchKeySpawned), A
 109+ 6950 21 C4 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 6953 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6954 CD F7 6B         CALL RespawnChurchKeyAtAlt
 112+ 6957                  ; Dibujar surgical en su nueva posicion
 113+ 6957 11 F3 D7         LD DE, BgGfx_church_key
 114+ 695A C3 11 D8         JP RedrawPickupByPtr
 115+ 695D              .actdAllTrapped:
 116+ 695D                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 695D                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 695D                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 695D                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 695D                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 695D                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 695D AF               XOR A
 123+ 695E 32 B6 82         LD (TimeFrozen), A
 124+ 6961 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 6963 32 CA 82         LD (PostTrapPauseTimer), A
 126+ 6966 C9               RET
