 822+ F1F9              ; ==============================================================================
 823+ F1F9              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 824+ F1F9              ; ==============================================================================
 825+ F1F9              ClearCompass:
 826+ F1F9 26 40            LD H, $40
 827+ F1FB 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 828+ F1FD 06 08            LD B, 8
 829+ F1FF AF               XOR A
 830+ F200              .ccRow0:
 831+ F200 77               LD (HL), A
 832+ F201 23               INC HL
 833+ F202 77               LD (HL), A
 834+ F203 2B               DEC HL
 835+ F204 24               INC H
 836+ F205 10 F9            DJNZ .ccRow0
 837+ F207 26 40            LD H, $40
 838+ F209 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 839+ F20B 06 08            LD B, 8
 840+ F20D AF               XOR A
 841+ F20E              .ccRow1:
 842+ F20E 77               LD (HL), A
 843+ F20F 23               INC HL
 844+ F210 77               LD (HL), A
 845+ F211 2B               DEC HL
 846+ F212 24               INC H
 847+ F213 10 F9            DJNZ .ccRow1
 848+ F215 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 849+ F216 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 850+ F219 77               LD (HL), A
 851+ F21A 23               INC HL
 852+ F21B 77               LD (HL), A
 853+ F21C 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 854+ F21F 77               LD (HL), A
 855+ F220 23               INC HL
 856+ F221 77               LD (HL), A
