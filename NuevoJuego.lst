 116+ 6073              ; ==============================================================================
 117+ 6073              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ 6073              ; ==============================================================================
 119+ 6073              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ 6073              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ 6073              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ 6073              ;
 123+ 6073              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ 6073              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ 6073              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ 6073              ; Destruye: AF, BC, DE, HL, IX.
 127+ 6073              ; ==============================================================================
 128+ 6073              CheckTownGateTriggerBg:
 129+ 6073 3A 75 82         LD A, (TownGatePhase)
 130+ 6076 B7               OR A
 131+ 6077 C0               RET NZ                              ; ya en cutscene
 132+ 6078 3A 5E 82         LD A, (CurrentKey)
 133+ 607B FE 06            CP TGCS_ARCH_KEY_ID
 134+ 607D C0               RET NZ                              ; sin la key correcta
 135+ 607E 3A AE 82         LD A, (CurrentScreenX)
 136+ 6081 FE 07            CP TGCS_ARCH_ROOM_X
 137+ 6083 C0               RET NZ
 138+ 6084 3A AF 82         LD A, (CurrentScreenY)
 139+ 6087 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ 6089 C0               RET NZ
 141+ 608A                  ; --- Horizontal AABB ---
 142+ 608A 3A 4E 81         LD A, (EntityTable + ENT_POSX)
 143+ 608D 4F               LD C, A                             ; C = player_left
 144+ 608E C6 10            ADD A, 16
 145+ 6090 57               LD D, A                             ; D = player_right
 146+ 6091 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ 6093 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ 6095 30 01            JR NC, .ctgtNoUnderL
 149+ 6097 AF               XOR A
 150+ 6098              .ctgtNoUnderL:
 151+ 6098 BA               CP D
 152+ 6099 D0               RET NC                              ; ext_left >= player_right
 153+ 609A 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ 609C C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ 609E 30 02            JR NC, .ctgtNoOverR
 156+ 60A0 3E FF            LD A, $FF
 157+ 60A2              .ctgtNoOverR:
 158+ 60A2 B9               CP C
 159+ 60A3 D8               RET C                               ; ext_right < player_left
 160+ 60A4                  ; --- Vertical AABB ---
 161+ 60A4                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ 60A4                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ 60A4                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ 60A4                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ 60A4                  ; con la altura real del rect.
 166+ 60A4 3A 4F 81         LD A, (EntityTable + ENT_POSY)
 167+ 60A7 4F               LD C, A                             ; C = player_top
 168+ 60A8 C6 15            ADD A, 21
 169+ 60AA 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ 60AB 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ 60AD D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ 60AF 30 01            JR NC, .ctgtNoUnderT
 173+ 60B1 AF               XOR A
 174+ 60B2              .ctgtNoUnderT:
 175+ 60B2 BA               CP D
 176+ 60B3 D0               RET NC
 177+ 60B4 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ 60B6 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ 60B8 30 02            JR NC, .ctgtNoOverB
 180+ 60BA 3E FF            LD A, $FF
 181+ 60BC              .ctgtNoOverB:
 182+ 60BC B9               CP C
 183+ 60BD D8               RET C
 184+ 60BE                  ; HIT
 185+ 60BE CD C6 60         CALL StartTownGateCutscene
 186+ 60C1 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ 60C3 C3 40 F1         JP CheckMilestoneTrigger            ; tail call
 188+ 60C6
 189+ 60C6              ; ==============================================================================
 190+ 60C6              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 60C6              ; ==============================================================================
 192+ 60C6              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 60C6              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 60C6              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 60C6              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 60C6              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 60C6              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 60C6              ; Destruye: AF, BC, DE, HL, IX.
 199+ 60C6              ; ==============================================================================
 200+ 60C6              StartTownGateCutscene:
 201+ 60C6 AF               XOR A
 202+ 60C7 32 5E 82         LD (CurrentKey), A
 203+ 60CA CD C3 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 60CD CD 43 BD         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 60D0 CD E1 60         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 60D3 CD 45 66         CALL SFX_TownGate_OnStart
 207+ 60D6 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 60D8 32 75 82         LD (TownGatePhase), A
 209+ 60DB 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ 60DD 32 A5 5F         LD (TownGateTimer), A
 211+ 60E0 C9               RET
 212+ 60E1
 213+ 60E1              ; ==============================================================================
 214+ 60E1              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
 215+ 60E1              ; ==============================================================================
 216+ 60E1              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING
 217+ 60E1              ; con SPRID_PUFF. ProcessDeath → ProcessOneEnemy.peDying anima puff cada
 218+ 60E1              ; frame en WAIT_NASTIES (igual que nasties). Al terminar puff,
 219+ 60E1              ; UpdateDying pone TYPE_NONE y la check dinamica de WAIT_NASTIES sigue.
 220+ 60E1              ; (DeathSpawned se queda a 1 pero es inocuo: ProcessDeath ya retorna
 221+ 60E1              ; cuando ENT_TYPE=0, y no hay respawn durante cutscene.)
 222+ 60E1              ; ==============================================================================
 223+ 60E1              KillDeathIfActive:
 224+ 60E1 DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
 225+ 60E5 DD 7E 01         LD A, (IX+ENT_TYPE)
 226+ 60E8 B7               OR A
 227+ 60E9 C8               RET Z                               ; muerte ya inactiva
 228+ 60EA DD 7E 02         LD A, (IX+ENT_STATE)
 229+ 60ED FE 03            CP STATE_DYING
 230+ 60EF C8               RET Z                               ; ya muriendo
 231+ 60F0 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
 232+ 60F4 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
 233+ 60F8 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
