1166+ F595 3E 07            LD A, WHITE
1167+ F597 18 01            JR .ucsShakeBorderOut
1168+ F599              .ucsShakeBorderBlack:
1169+ F599 AF               XOR A                                   ; BLACK
1170+ F59A              .ucsShakeBorderOut:
1171+ F59A D3 FE            OUT (254), A
1172+ F59C 21 9D 5F         LD HL, ChurchCutsceneFrame
1173+ F59F 34               INC (HL)
1174+ F5A0 C9               RET
1175+ F5A1              .ucsShakeJitterTable:
1176+ F5A1 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1177+ F5A5              .ucsShakeStatueDone:
1178+ F5A5                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1179+ F5A5 AF               XOR A
1180+ F5A6 D3 FE            OUT (254), A
1181+ F5A8                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1182+ F5A8                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1183+ F5A8                  ; directo a 0 garantiza que no queden residuos.)
1184+ F5A8 CD 03 F7         CALL ChurchCutsceneEraseStatueDirect
1185+ F5AB 21 71 F9         LD HL, SFX_EnemyDeath
1186+ F5AE CD F2 F8         CALL PlaySFX
