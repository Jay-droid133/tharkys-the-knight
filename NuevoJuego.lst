 224+ EFE3 00           CurrentKeyCycleDebounce: DEFB 0
 225+ EFE4
 226+ EFE4              ; ==============================================================================
 227+ EFE4              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ EFE4              ; ==============================================================================
 229+ EFE4              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ EFE4              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ EFE4              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ EFE4              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ EFE4              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ EFE4              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ EFE4              ;               actuales; queda como salvaguarda.
 236+ EFE4              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ EFE4              ; Destruye: AF, BC, DE, HL.
 238+ EFE4              ; ==============================================================================
 239+ EFE4              ResolveObjectiveScreen:
 240+ EFE4 3A B0 82         LD A, (CurrentObjective)
 241+ EFE7 FE 0B            CP 11
 242+ EFE9 30 4D            JR NC, .rosNoTarget
 243+ EFEB 87               ADD A, A
 244+ EFEC 6F               LD L, A
 245+ EFED 26 00            LD H, 0
 246+ EFEF 11 08 EF         LD DE, MilestoneResolveTable
 247+ EFF2 19               ADD HL, DE
 248+ EFF3 7E               LD A, (HL)                          ; tipo
 249+ EFF4 23               INC HL
 250+ EFF5 46               LD B, (HL)                          ; B = ref
 251+ EFF6 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ EFF8 28 06            JR Z, .rosPickup
 253+ EFFA FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ EFFC 28 08            JR Z, .rosTrigger
 255+ EFFE 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ F000              .rosPickup:
 257+ F000 78               LD A, B
 258+ F001 CD 41 F0         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ F004 18 10            JR .rosFindPos
 260+ F006              .rosTrigger:
 261+ F006 78               LD A, B
 262+ F007 FE 04            CP 4
 263+ F009 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ F00B FE 03            CP 3
 265+ F00D 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ F00F                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ F00F                                                      ;  Necesario para que la lasting compass tras
 268+ F00F                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ F00F CD 4E F0         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ F012 7A               LD A, D
 271+ F013 B3               OR E
 272+ F014 28 22            JR Z, .rosNoTarget
 273+ F016              .rosFindPos:
 274+ F016 CD 69 F0         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ F019 78               LD A, B
 276+ F01A 32 B1 82         LD (ObjectiveScreenX), A
 277+ F01D 79               LD A, C
 278+ F01E 32 B2 82         LD (ObjectiveScreenY), A
 279+ F021 C9               RET
 280+ F022              .rosBankRoom:
 281+ F022                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ F022                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ F022 3E 08            LD A, BCS_BANK_ROOM_X
 284+ F024 32 B1 82         LD (ObjectiveScreenX), A
 285+ F027 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ F029 32 B2 82         LD (ObjectiveScreenY), A
 287+ F02C C9               RET
 288+ F02D              .rosTownGateRoom:
 289+ F02D                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ F02D                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ F02D                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ F02D 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ F02F 32 B1 82         LD (ObjectiveScreenX), A
 294+ F032 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ F034 32 B2 82         LD (ObjectiveScreenY), A
 296+ F037 C9               RET
 297+ F038              .rosNoTarget:
 298+ F038 3E FF            LD A, $FF
 299+ F03A 32 B1 82         LD (ObjectiveScreenX), A
 300+ F03D 32 B2 82         LD (ObjectiveScreenY), A
 301+ F040 C9               RET
 302+ F041
 303+ F041              ; ==============================================================================
 304+ F041              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ F041              ; ==============================================================================
 306+ F041              ; IN:  A = key id (1..6)
 307+ F041              ; OUT: DE = ptr
 308+ F041              ; Destruye: AF, HL.
 309+ F041              ; ==============================================================================
 310+ F041              KeyIdToPtr:
 311+ F041 3D               DEC A
 312+ F042 87               ADD A, A                            ; *2 (DEFW size)
 313+ F043 6F               LD L, A
 314+ F044 26 00            LD H, 0
 315+ F046 11 45 D7         LD DE, KeyLockTable
 316+ F049 19               ADD HL, DE
 317+ F04A 5E               LD E, (HL)
 318+ F04B 23               INC HL
 319+ F04C 56               LD D, (HL)
 320+ F04D C9               RET
 321+ F04E
 322+ F04E              ; ==============================================================================
 323+ F04E              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ F04E              ; ==============================================================================
 325+ F04E              ; IN:  A = action id (1, 2, ...)
 326+ F04E              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ F04E              ;      Z flag set si no encontrado.
 328+ F04E              ; Destruye: AF, BC, HL.
 329+ F04E              ; ==============================================================================
 330+ F04E              ActionToTriggerPtr:
 331+ F04E 4F               LD C, A                             ; C = action id buscada
 332+ F04F 21 DD D7         LD HL, BumpTriggerTable
 333+ F052              .attLoop:
 334+ F052 5E               LD E, (HL)
 335+ F053 23               INC HL
 336+ F054 56               LD D, (HL)
 337+ F055 23               INC HL                              ; HL -> required_key
 338+ F056 7A               LD A, D
 339+ F057 B3               OR E
 340+ F058 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ F05A 23               INC HL                              ; HL -> action
 342+ F05B 7E               LD A, (HL)
 343+ F05C 23               INC HL                              ; HL -> next entry
 344+ F05D B9               CP C
 345+ F05E 20 F2            JR NZ, .attLoop
 346+ F060 F6 01            OR 1                                ; clear Z (encontrado)
 347+ F062 C9               RET
 348+ F063              .attNotFound:
 349+ F063 16 00            LD D, 0
 350+ F065 1E 00            LD E, 0
 351+ F067 AF               XOR A                               ; set Z
 352+ F068 C9               RET
 353+ F069
 354+ F069              ; ==============================================================================
 355+ F069              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ F069              ; ==============================================================================
 357+ F069              ; PickupTable layout (per-entry, 7 bytes):
 358+ F069              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ F069              ; Terminator: $FF (single byte).
 360+ F069              ;
 361+ F069              ; IN:  DE = ptr a buscar
 362+ F069              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ F069              ;      B = C = $FF si no encontrado (Z).
 364+ F069              ; Destruye: AF, HL. Preserva DE.
 365+ F069              ; ==============================================================================
 366+ F069              FindPickupScreen:
 367+ F069 21 A8 DF         LD HL, PickupTable
 368+ F06C              .fpsLoop:
 369+ F06C 7E               LD A, (HL)
 370+ F06D FE FF            CP $FF
 371+ F06F 28 1C            JR Z, .fpsNotFound
 372+ F071 E5               PUSH HL
 373+ F072 23               INC HL                              ; -> mapY
 374+ F073 23               INC HL                              ; -> ptr_lo
 375+ F074 7E               LD A, (HL)
 376+ F075 BB               CP E
 377+ F076 20 0C            JR NZ, .fpsNoMatch
 378+ F078 23               INC HL                              ; -> ptr_hi
 379+ F079 7E               LD A, (HL)
 380+ F07A BA               CP D
 381+ F07B 20 07            JR NZ, .fpsNoMatch
 382+ F07D E1               POP HL                              ; back to entry start (mapX)
 383+ F07E 46               LD B, (HL)                          ; B = mapX
 384+ F07F 23               INC HL
 385+ F080 4E               LD C, (HL)                          ; C = mapY
 386+ F081 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F083 C9               RET
 388+ F084              .fpsNoMatch:
 389+ F084 E1               POP HL
 390+ F085 C5               PUSH BC
 391+ F086 01 07 00         LD BC, 7
 392+ F089 09               ADD HL, BC
 393+ F08A C1               POP BC
 394+ F08B 18 DF            JR .fpsLoop
 395+ F08D              .fpsNotFound:
 396+ F08D 06 FF            LD B, $FF
 397+ F08F 0E FF            LD C, $FF
 398+ F091 AF               XOR A                               ; set Z
 399+ F092 C9               RET
 400+ F093
 401+ F093              ; ==============================================================================
 402+ F093              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F093              ; ==============================================================================
 404+ F093              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F093              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F093              ; third). El brujula se redibuja solo cuando:
 407+ F093              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F093              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F093              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F093              ;
 411+ F093              ; Color (atributo de las 4 celdas):
 412+ F093              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F093              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F093              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F093              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F093              ;
 417+ F093              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F093              ; ==============================================================================
 419+ F093
 420+ F093              COMPASS_COL     EQU 24
 421+ F093              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F093
 423+ F093              ; ==============================================================================
 424+ F093              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F093              ; ==============================================================================
 426+ F093              ; Formato:
 427+ F093              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F093              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F093              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F093              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F093              ; ==============================================================================
 432+ F093              DrawMilestoneHUD:
 433+ F093 3A B0 82         LD A, (CurrentObjective)
 434+ F096 FE 0B            CP 11
 435+ F098 28 26            JR Z, .mhAllDone
 436+ F09A 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F09B 06 00            LD B, 0                     ; B = decenas
 438+ F09D              .mhDivLoop:
 439+ F09D FE 0A            CP 10
 440+ F09F 38 05            JR C, .mhDivDone
 441+ F0A1 D6 0A            SUB 10
 442+ F0A3 04               INC B
 443+ F0A4 18 F7            JR .mhDivLoop
 444+ F0A6              .mhDivDone:
 445+ F0A6 F5               PUSH AF                     ; A = unidades
 446+ F0A7 78               LD A, B
 447+ F0A8 B7               OR A
 448+ F0A9 20 04            JR NZ, .mhTensDigit
 449+ F0AB 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F0AD 18 02            JR .mhWriteTens
 451+ F0AF              .mhTensDigit:
 452+ F0AF C6 30            ADD A, '0'
 453+ F0B1              .mhWriteTens:
 454+ F0B1 1E 1E            LD E, 30
 455+ F0B3 CD 99 E6         CALL DrawHudCharRow0
 456+ F0B6 F1               POP AF                      ; A = unidades
 457+ F0B7 C6 30            ADD A, '0'
 458+ F0B9 1E 1F            LD E, 31
 459+ F0BB CD 99 E6         CALL DrawHudCharRow0
 460+ F0BE 18 0E            JR .mhAttrs
 461+ F0C0              .mhAllDone:
 462+ F0C0 3E 4F            LD A, 'O'
 463+ F0C2 1E 1E            LD E, 30
 464+ F0C4 CD 99 E6         CALL DrawHudCharRow0
 465+ F0C7 3E 4B            LD A, 'K'
 466+ F0C9 1E 1F            LD E, 31
 467+ F0CB CD 99 E6         CALL DrawHudCharRow0
 468+ F0CE              .mhAttrs:
 469+ F0CE 3E 47            LD A, $47                   ; bright white
 470+ F0D0 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F0D3 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F0D6 C9               RET
 473+ F0D7
 474+ F0D7              ; ==============================================================================
 475+ F0D7              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F0D7              ; ==============================================================================
 477+ F0D7              DrawCompass:
 478+ F0D7                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F0D7 3A B1 82         LD A, (ObjectiveScreenX)
 480+ F0DA FE FF            CP $FF
 481+ F0DC CA 93 F2         JP Z, ClearCompass
 482+ F0DF
 483+ F0DF                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F0DF                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F0DF                  ; reflejar la dir del path al cambiar de sala).
 486+ F0DF 3A 01 83         LD A, (CurrentScreenX)
 487+ F0E2 47               LD B, A
 488+ F0E3 3A B4 82         LD A, (LastCompassScreenX)
 489+ F0E6 B8               CP B
 490+ F0E7 C2 0D F1         JP NZ, .dcRedrawNewScreen
 491+ F0EA 3A 02 83         LD A, (CurrentScreenY)
 492+ F0ED 47               LD B, A
 493+ F0EE 3A B5 82         LD A, (LastCompassScreenY)
 494+ F0F1 B8               CP B
 495+ F0F2 C2 0D F1         JP NZ, .dcRedrawNewScreen
 496+ F0F5 3A B3 82         LD A, (PreviousObjectiveDistance)
 497+ F0F8 FE FF            CP $FF
 498+ F0FA 28 16            JR Z, .dcRedraw
 499+ F0FC 3A B6 82         LD A, (CompassWobbleCounter)
 500+ F0FF B7               OR A
 501+ F100 20 10            JR NZ, .dcRedraw
 502+ F102                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F102                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F102 3A BF 5F         LD A, (MagicCompassTimer)
 505+ F105 47               LD B, A
 506+ F106 3A C0 5F         LD A, (MagicCompassTimer + 1)
 507+ F109 B0               OR B
 508+ F10A C8               RET Z                               ; sin cambios + sin wobble + sin magic
 509+ F10B 18 05            JR .dcRedraw
 510+ F10D
 511+ F10D              .dcRedrawNewScreen:
 512+ F10D                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 513+ F10D                  ; sincronicamente en CheckScreenTransition.doTransition (via
 514+ F10D                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 515+ F10D                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 516+ F10D                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 517+ F10D                  ;
 518+ F10D                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 519+ F10D                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 520+ F10D                  ; hay que volver a dibujar el sprite minimo una vez.
 521+ F10D 3E FF            LD A, $FF
 522+ F10F 32 CC 5F         LD (LastMagicCompassDrawn), A
 523+ F112                  ; fall through a .dcRedraw
 524+ F112
 525+ F112              .dcRedraw:
 526+ F112                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F112 3A B1 82         LD A, (ObjectiveScreenX)
 528+ F115 47               LD B, A
 529+ F116 3A 01 83         LD A, (CurrentScreenX)
 530+ F119 4F               LD C, A
 531+ F11A 78               LD A, B
 532+ F11B 91               SUB C                               ; A = dx (signed)
 533+ F11C                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F11C F2 26 F1         JP P, .dcDxNonNeg
 535+ F11F ED 44            NEG
 536+ F121 67               LD H, A                             ; abs(dx)
 537+ F122 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F124 18 0A            JR .dcDxDone
 539+ F126              .dcDxNonNeg:
 540+ F126 67               LD H, A
 541+ F127 B7               OR A
 542+ F128 20 04            JR NZ, .dcDxPositive
 543+ F12A 2E 01            LD L, 1                             ; dx == 0
 544+ F12C 18 02            JR .dcDxDone
 545+ F12E              .dcDxPositive:
 546+ F12E 2E 02            LD L, 2
 547+ F130              .dcDxDone:
 548+ F130 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F131
 550+ F131                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F131 3A B2 82         LD A, (ObjectiveScreenY)
 552+ F134 47               LD B, A
 553+ F135 3A 02 83         LD A, (CurrentScreenY)
 554+ F138 4F               LD C, A
 555+ F139 78               LD A, B
 556+ F13A 91               SUB C
 557+ F13B F2 45 F1         JP P, .dcDyNonNeg
 558+ F13E ED 44            NEG
 559+ F140 67               LD H, A
 560+ F141 2E 00            LD L, 0
 561+ F143 18 0A            JR .dcDyDone
 562+ F145              .dcDyNonNeg:
 563+ F145 67               LD H, A
 564+ F146 B7               OR A
 565+ F147 20 04            JR NZ, .dcDyPositive
 566+ F149 2E 01            LD L, 1
 567+ F14B 18 02            JR .dcDyDone
 568+ F14D              .dcDyPositive:
 569+ F14D 2E 02            LD L, 2
 570+ F14F              .dcDyDone:
 571+ F14F                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 572+ F14F D1               POP DE                              ; D = abs_dx, E = signdx+1
 573+ F150                  ; idx = (signdy+1)*3 + (signdx+1)
 574+ F150 7D               LD A, L
 575+ F151 87               ADD A, A
 576+ F152 85               ADD A, L                            ; A = (signdy+1)*3
 577+ F153 83               ADD A, E                            ; A = idx (0..8)
 578+ F154 32 60 F2         LD (.dcSpriteIdx), A
 579+ F157                  ; distance = abs_dx + abs_dy
 580+ F157 7A               LD A, D
 581+ F158 84               ADD A, H
 582+ F159 32 61 F2         LD (.dcDistance), A
 583+ F15C
 584+ F15C                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F15C                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F15C                  ; Sprite_Compass_Magic / Sprite_Compass_MagicLasting (no oscilan); el wobble
 587+ F15C                  ; logic solo gastaría CPU durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F15C                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F15C                  ; cuando el frame de transición está apretado.
 590+ F15C 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F15F 47               LD B, A
 592+ F160 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F163 B0               OR B
 594+ F164 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F166 AF               XOR A
 596+ F167 32 B6 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F16A 18 53            JR .dcWobbleEnd
 598+ F16C              .dcWobbleStartNormal:
 599+ F16C                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F16C                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F16C                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F16C                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F16C                  ; nuevo idx.
 604+ F16C                  ; Counter == 0 -> sin override, idx = target.
 605+ F16C 3A 60 F2         LD A, (.dcSpriteIdx)
 606+ F16F FE 04            CP 4
 607+ F171 20 06            JR NZ, .dcWobbleNotX
 608+ F173                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F173                  ; frame no redibuje innecesariamente.
 610+ F173 AF               XOR A
 611+ F174 32 B6 82         LD (CompassWobbleCounter), A
 612+ F177 18 46            JR .dcWobbleEnd
 613+ F179              .dcWobbleNotX:
 614+ F179                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F179 3A 01 83         LD A, (CurrentScreenX)
 616+ F17C 47               LD B, A
 617+ F17D 3A B4 82         LD A, (LastCompassScreenX)
 618+ F180 B8               CP B
 619+ F181 20 0A            JR NZ, .dcWobbleStart
 620+ F183 3A 02 83         LD A, (CurrentScreenY)
 621+ F186 47               LD B, A
 622+ F187 3A B5 82         LD A, (LastCompassScreenY)
 623+ F18A B8               CP B
 624+ F18B 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F18D              .dcWobbleStart:
 626+ F18D 3E 09            LD A, 9
 627+ F18F 32 B6 82         LD (CompassWobbleCounter), A
 628+ F192              .dcWobbleResolve:
 629+ F192 3A B6 82         LD A, (CompassWobbleCounter)
 630+ F195 B7               OR A
 631+ F196 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F198 3D               DEC A
 633+ F199 32 B6 82         LD (CompassWobbleCounter), A
 634+ F19C                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F19C 21 C1 F6         LD HL, WobblePhaseTable
 636+ F19F 5F               LD E, A
 637+ F1A0 16 00            LD D, 0
 638+ F1A2 19               ADD HL, DE
 639+ F1A3 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F1A4 FE 02            CP 2
 641+ F1A6 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F1A8                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F1A8                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F1A8 FE 03            CP 3
 645+ F1AA 38 01            JR C, .dcWobbleOffsetReady
 646+ F1AC 3D               DEC A
 647+ F1AD              .dcWobbleOffsetReady:
 648+ F1AD 5F               LD E, A
 649+ F1AE 3A 60 F2         LD A, (.dcSpriteIdx)
 650+ F1B1 87               ADD A, A                            ; idx*2
 651+ F1B2 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F1B3 83               ADD A, E                            ; +offset
 653+ F1B4 21 9D F6         LD HL, CompassWobbleTable
 654+ F1B7 5F               LD E, A
 655+ F1B8 16 00            LD D, 0
 656+ F1BA 19               ADD HL, DE
 657+ F1BB 7E               LD A, (HL)
 658+ F1BC 32 60 F2         LD (.dcSpriteIdx), A                ; override
 659+ F1BF
 660+ F1BF              .dcWobbleEnd:
 661+ F1BF
 662+ F1BF                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F1BF                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F1BF                  ; sin bright + char activo white bright; en warning el char activo
 665+ F1BF                  ; parpadea bright on/off a ~6 Hz).
 666+ F1BF                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F1BF                  ; blanca se mantiene tal cual.
 668+ F1BF 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F1C2 47               LD B, A
 670+ F1C3 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F1C6 B0               OR B
 672+ F1C7 28 3E            JR Z, .dcMagicOff
 673+ F1C9 3A 60 F2         LD A, (.dcSpriteIdx)
 674+ F1CC FE 04            CP 4
 675+ F1CE 28 37            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F1D0 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F1D3 FE FF            CP $FF
 678+ F1D5 28 30            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F1D7                  ; --- MAGIC HUD ---
 680+ F1D7                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F1D7                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F1D7                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F1D7                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F1D7                  ;
 685+ F1D7                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F1D7                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F1D7                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F1D7                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F1D7                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F1D7                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F1D7                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F1D7 3A BE 82         LD A, (MagicCompassPermanent)
 693+ F1DA B7               OR A
 694+ F1DB 28 11            JR Z, .dcMagicTemp
 695+ F1DD                  ; --- Lasting (permanente, post-iglesia) ---
 696+ F1DD 3A C1 5F         LD A, (MagicCompassPathDir)
 697+ F1E0 F6 80            OR $80                              ; bit 7 = 1 (lasting)
 698+ F1E2 47               LD B, A
 699+ F1E3 3A CC 5F         LD A, (LastMagicCompassDrawn)
 700+ F1E6 B8               CP B
 701+ F1E7 28 19            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 702+ F1E9 11 22 6F         LD DE, Sprite_Compass_MagicLasting
 703+ F1EC 18 0D            JR .dcMagicDraw
 704+ F1EE              .dcMagicTemp:
 705+ F1EE 3A C1 5F         LD A, (MagicCompassPathDir)         ; bit 7 ya 0 (PathDir 0..3)
 706+ F1F1 47               LD B, A
 707+ F1F2 3A CC 5F         LD A, (LastMagicCompassDrawn)
 708+ F1F5 B8               CP B
 709+ F1F6 28 0A            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 710+ F1F8 11 FE 6E         LD DE, Sprite_Compass_Magic
 711+ F1FB              .dcMagicDraw:
 712+ F1FB                  ; Almacenar cache key ANTES del CALL (DrawCompassSprite destruye B usándolo
 713+ F1FB                  ; como contador de filas). Semánticamente equivalente: el call no falla.
 714+ F1FB 78               LD A, B
 715+ F1FC 32 CC 5F         LD (LastMagicCompassDrawn), A
 716+ F1FF CD 63 F2         CALL DrawCompassSprite
 717+ F202              .dcMagicAttrsOnly:
 718+ F202 CD B7 6E         CALL PaintMagicCompassAttrs
 719+ F205 18 40            JR .dcDrawDone
 720+ F207
 721+ F207              .dcMagicOff:
 722+ F207                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 723+ F207                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 724+ F207 3E FF            LD A, $FF
 725+ F209 32 CC 5F         LD (LastMagicCompassDrawn), A
 726+ F20C
 727+ F20C                  ; --- Color normal ---
 728+ F20C                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 729+ F20C 3A 60 F2         LD A, (.dcSpriteIdx)
 730+ F20F FE 04            CP 4
 731+ F211 28 18            JR Z, .dcWhite
 732+ F213 3A B3 82         LD A, (PreviousObjectiveDistance)
 733+ F216 FE FF            CP $FF
 734+ F218 28 11            JR Z, .dcWhite
 735+ F21A 47               LD B, A
 736+ F21B 3A 61 F2         LD A, (.dcDistance)
 737+ F21E B8               CP B
 738+ F21F 28 0A            JR Z, .dcWhite                      ; igual = blanco
 739+ F221 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 740+ F223 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 741+ F225 18 06            JR .dcColorDone
 742+ F227              .dcGreen:
 743+ F227 3E 44            LD A, GREEN | $40
 744+ F229 18 02            JR .dcColorDone
 745+ F22B              .dcWhite:
 746+ F22B 3E 47            LD A, WHITE | $40
 747+ F22D              .dcColorDone:
 748+ F22D 32 62 F2         LD (.dcAttr), A
 749+ F230
 750+ F230                  ; --- Sprite ptr de CompassSprites[idx] ---
 751+ F230 3A 60 F2         LD A, (.dcSpriteIdx)
 752+ F233 87               ADD A, A                            ; *2
 753+ F234 6F               LD L, A
 754+ F235 26 00            LD H, 0
 755+ F237 11 8B F6         LD DE, CompassSprites
 756+ F23A 19               ADD HL, DE
 757+ F23B 5E               LD E, (HL)
 758+ F23C 23               INC HL
 759+ F23D 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 760+ F23E CD 63 F2         CALL DrawCompassSprite
 761+ F241
 762+ F241                  ; --- Attrs ---
 763+ F241 3A 62 F2         LD A, (.dcAttr)
 764+ F244 CD 86 F2         CALL SetCompassAttrs
 765+ F247
 766+ F247              .dcDrawDone:
 767+ F247
 768+ F247                  ; --- Cachear estado ---
 769+ F247                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 770+ F247                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 771+ F247                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 772+ F247                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 773+ F247                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 774+ F247                  ; el wobble y la comparacion sigue siendo correcta.
 775+ F247 3A B6 82         LD A, (CompassWobbleCounter)
 776+ F24A B7               OR A
 777+ F24B 20 06            JR NZ, .dcSkipPrevDistSave
 778+ F24D 3A 61 F2         LD A, (.dcDistance)
 779+ F250 32 B3 82         LD (PreviousObjectiveDistance), A
