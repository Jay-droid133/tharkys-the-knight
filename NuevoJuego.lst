1254+ EE98              ; ==============================================================================
1255+ EE98              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1256+ EE98              ; ==============================================================================
1257+ EE98              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1258+ EE98              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1259+ EE98              ; ==============================================================================
1260+ EE98              ChurchCutsceneEraseStatueAtLast:
1261+ EE98              ChurchCutsceneDrawStatueAtLast:
1262+ EE98 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1263+ EE9B 21 34 67         LD HL, StatueIdTable
1264+ EE9E 5F               LD E, A
1265+ EE9F 16 00            LD D, 0
1266+ EEA1 19               ADD HL, DE
1267+ EEA2 7E               LD A, (HL)                              ; A = statue id
1268+ EEA3 B7               OR A
1269+ EEA4 C8               RET Z
1270+ EEA5                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1271+ EEA5 6F               LD L, A
1272+ EEA6 26 00            LD H, 0
1273+ EEA8 54               LD D, H
1274+ EEA9 5D               LD E, L
1275+ EEAA 29               ADD HL, HL
1276+ EEAB 19               ADD HL, DE                              ; HL = id*3
1277+ EEAC 11 93 DA         LD DE, BgGfxPtrById
1278+ EEAF 19               ADD HL, DE
1279+ EEB0 5E               LD E, (HL)
1280+ EEB1 23               INC HL
1281+ EEB2 56               LD D, (HL)                              ; DE = sprite ptr
1282+ EEB3 23               INC HL
1283+ EEB4 7E               LD A, (HL)                              ; A = bank
1284+ EEB5 EB               EX DE, HL                               ; HL = sprite ptr
1285+ EEB6 CD D2 90         CALL LoadBgSpriteToBuffer               ; preserva BC
1286+ EEB9                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1287+ EEB9 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1288+ EEBC 57               LD D, A
1289+ EEBD 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1290+ EEC0 5F               LD E, A
1291+ EEC1 C3 BC 68         JP DrawBgSprite16XorAtPixel
1292+ EEC4
1293+ EEC4              ; ==============================================================================
1294+ EEC4              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1295+ EEC4              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1296+ EEC4              ;     A  = jitter signed (-1, 0, +1) en bits.
1297+ EEC4              ; ==============================================================================
1298+ EEC4              ; IN: A = jitter signed (-1, 0, +1) en bits.
1299+ EEC4              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1300+ EEC4              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1301+ EEC4              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1302+ EEC4              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1303+ EEC4              ; version shifted, sin XOR.
1304+ EEC4              ;
1305+ EEC4              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1306+ EEC4              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1307+ EEC4              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1308+ EEC4              ; estatua se perdio cuando la estatua se pinto la primera vez con
1309+ EEC4              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1310+ EEC4              ; de la estatua, el wall perdido no se ve.
1311+ EEC4              ;
1312+ EEC4              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1313+ EEC4              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1314+ EEC4              ; shift de 1 bit no pierde pixels visibles.
1315+ EEC4              ; Destruye: AF, BC, DE, HL, IX.
1316+ EEC4              ; ==============================================================================
1317+ EEC4              ChurchCutsceneShakeStatueByteShift:
1318+ EEC4 32 2E EF         LD (.csbsJitter), A
1319+ EEC7                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1320+ EEC7 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1321+ EECA 5F               LD E, A
1322+ EECB 16 00            LD D, 0
1323+ EECD 19               ADD HL, DE
1324+ EECE 7E               LD A, (HL)
1325+ EECF B7               OR A
1326+ EED0 C8               RET Z                                   ; sin estatua
1327+ EED1 6F               LD L, A
1328+ EED2 26 00            LD H, 0
1329+ EED4 54               LD D, H
1330+ EED5 5D               LD E, L
1331+ EED6 29               ADD HL, HL
1332+ EED7 19               ADD HL, DE                              ; HL = id*3
1333+ EED8 11 93 DA         LD DE, BgGfxPtrById
1334+ EEDB 19               ADD HL, DE
1335+ EEDC 5E               LD E, (HL)
1336+ EEDD 23               INC HL
1337+ EEDE 56               LD D, (HL)                              ; DE = sprite ptr
1338+ EEDF 23               INC HL
1339+ EEE0 7E               LD A, (HL)                              ; A = bank
1340+ EEE1 EB               EX DE, HL                               ; HL = sprite ptr
1341+ EEE2 CD D2 90         CALL LoadBgSpriteToBuffer               ; preserva BC
1342+ EEE5                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1343+ EEE5 DD 21 0A 89      LD IX, BgSpriteBuffer
1344+ EEE9 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1345+ EEEC B7               OR A
1346+ EEED C8               RET Z
1347+ EEEE 47               LD B, A                                 ; B = row counter
1348+ EEEF DD 23            INC IX
1349+ EEF1 DD 23            INC IX                                  ; IX -> pixel data
1350+ EEF3                  ; Calcular addr VRAM en (origX, origY)
1351+ EEF3 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1352+ EEF6 57               LD D, A
1353+ EEF7 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1354+ EEFA 5F               LD E, A
1355+ EEFB CD 31 A1         CALL CalcPixelAddr                      ; HL = VRAM addr
1356+ EEFE              .csbsRow:
1357+ EEFE C5               PUSH BC
1358+ EEFF E5               PUSH HL                                 ; save inicio fila VRAM
1359+ EF00                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1360+ EF00 DD 7E 00         LD A, (IX+0)
1361+ EF03 2F               CPL
1362+ EF04 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1363+ EF05 DD 7E 01         LD A, (IX+1)
1364+ EF08 2F               CPL
1365+ EF09 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1366+ EF0A                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1367+ EF0A 3A 2E EF         LD A, (.csbsJitter)
1368+ EF0D B7               OR A
1369+ EF0E 28 0D            JR Z, .csbsWrite                        ; sin shift
1370+ EF10 FA 19 EF         JP M, .csbsLeft                         ; A < 0 -> shift left
1371+ EF13                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1372+ EF13 CB 3A            SRL D
1373+ EF15 CB 1B            RR E
1374+ EF17 18 04            JR .csbsWrite
1375+ EF19              .csbsLeft:
1376+ EF19 CB 23            SLA E
1377+ EF1B CB 12            RL D
1378+ EF1D              .csbsWrite:
1379+ EF1D 7A               LD A, D
1380+ EF1E 77               LD (HL), A
1381+ EF1F 23               INC HL
1382+ EF20 7B               LD A, E
1383+ EF21 77               LD (HL), A
1384+ EF22 E1               POP HL
1385+ EF23 CD 9D 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1386+ EF26 DD 23            INC IX
1387+ EF28 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1388+ EF2A C1               POP BC
1389+ EF2B 10 D1            DJNZ .csbsRow
1390+ EF2D C9               RET
1391+ EF2E 00           .csbsJitter: DEFB 0
1392+ EF2F
1393+ EF2F              ; ==============================================================================
1394+ EF2F              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1395+ EF2F              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1396+ EF2F              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1397+ EF2F              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1398+ EF2F              ; Destruye: AF, BC, HL.
1399+ EF2F              ; ==============================================================================
1400+ EF2F              ChurchCutsceneEraseStatueDirect:
1401+ EF2F 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1402+ EF32 57               LD D, A
1403+ EF33 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1404+ EF36 5F               LD E, A
1405+ EF37 CD 31 A1         CALL CalcPixelAddr
1406+ EF3A 06 18            LD B, 24                                ; statues son 24 px de alto
1407+ EF3C              .csedRow:
1408+ EF3C AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1409+ EF3D 77               LD (HL), A
1410+ EF3E 23               INC HL
1411+ EF3F 77               LD (HL), A
1412+ EF40 2B               DEC HL                                  ; volver a inicio fila
1413+ EF41 C5               PUSH BC
1414+ EF42 CD 9D 9E         CALL NextPixelLine
1415+ EF45 C1               POP BC
1416+ EF46 10 F4            DJNZ .csedRow
1417+ EF48 C9               RET
1418+ EF49
1419+ EF49              ; ==============================================================================
1420+ EF49              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1421+ EF49              ; ==============================================================================
1422+ EF49              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1423+ EF49              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1424+ EF49              ; suficiente para corromper visualmente).
1425+ EF49              ; IN: IX = entity ptr.
1426+ EF49              ; ==============================================================================
1427+ EF49              RedrawTrappedMonster:
1428+ EF49                  ; --- Erase viejo en (OLDX, OLDY) ---
1429+ EF49 CD 08 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1430+ EF4C DD 7E 0D         LD A, (IX+ENT_OLDY)
1431+ EF4F 57               LD D, A
1432+ EF50 DD 7E 0C         LD A, (IX+ENT_OLDX)
1433+ EF53 5F               LD E, A
1434+ EF54 DD E5            PUSH IX
1435+ EF56 DD 2A 90 A7      LD IX, (OldSprAddr)
1436+ EF5A CD BE 9D         CALL DrawSprite
1437+ EF5D DD E1            POP IX
1438+ EF5F                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1439+ EF5F                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1440+ EF5F DD 56 0D         LD D, (IX+ENT_OLDY)
1441+ EF62 DD 5E 0C         LD E, (IX+ENT_OLDX)
1442+ EF65 CD 36 CF         CALL RestoreOldAttr
1443+ EF68                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1444+ EF68                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1445+ EF68                  ; reponer attrs de pickups que el flujo de entidades pisa con
1446+ EF68                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1447+ EF68                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1448+ EF68                  ; estar bajo el monster.
1449+ EF68 DD E5            PUSH IX
1450+ EF6A CD 9A D5         CALL RefreshPickupAttrs
1451+ EF6D DD E1            POP IX
