 424+ 9BA5              ; ==============================================================================
 425+ 9BA5              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9BA5              ; ==============================================================================
 427+ 9BA5              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9BA5              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9BA5              ;
 430+ 9BA5              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9BA5              ; ==============================================================================
 432+ 9BA5              RestoreEntityAttr:
 433+ 9BA5 CD 3F 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BA8 11 C5 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BAB
 436+ 9BAB 3A D6 9B         LD A, (EntityAttrH)
 437+ 9BAE 4F               LD C, A
 438+ 9BAF              .restRow:
 439+ 9BAF 3A D5 9B         LD A, (EntityAttrW)
 440+ 9BB2 47               LD B, A
 441+ 9BB3 E5               PUSH HL
 442+ 9BB4              .restCol:
 443+ 9BB4 1A               LD A, (DE)
 444+ 9BB5 77               LD (HL), A
 445+ 9BB6 23               INC HL
 446+ 9BB7 13               INC DE
 447+ 9BB8 10 FA            DJNZ .restCol
 448+ 9BBA E1               POP HL
 449+ 9BBB D5               PUSH DE
 450+ 9BBC 11 20 00         LD DE, 32
 451+ 9BBF 19               ADD HL, DE
 452+ 9BC0 D1               POP DE
 453+ 9BC1 0D               DEC C
 454+ 9BC2 20 EB            JR NZ, .restRow
 455+ 9BC4 C9               RET
 456+ 9BC5
 457+ 9BC5              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BC5              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BC5              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BC5              ; ---
 461+ 9BC5 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BD5 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BD6 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BD7 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D09 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D0A
 467+ 9D0A              ; ==============================================================================
 468+ 9D0A              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D0A              ; ==============================================================================
 470+ 9D0A              ; Entrada: A = indice de entidad (0-16)
 471+ 9D0A              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D0A              ; ==============================================================================
 473+ 9D0A              SetAttrSlot:
 474+ 9D0A 32 09 9D         LD (CurrentAttrSlot), A
 475+ 9D0D                  ; Calcular offset: A * 18
 476+ 9D0D 6F               LD L, A
 477+ 9D0E 26 00            LD H, 0
 478+ 9D10 29               ADD HL, HL                  ; x2
 479+ 9D11 54               LD D, H
 480+ 9D12 5D               LD E, L                     ; DE = x2
 481+ 9D13 29               ADD HL, HL                  ; x4
 482+ 9D14 29               ADD HL, HL                  ; x8
 483+ 9D15 29               ADD HL, HL                  ; x16
 484+ 9D16 19               ADD HL, DE                  ; x18
 485+ 9D17 11 D7 9B         LD DE, SavedAttrTable
 486+ 9D1A 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D1B                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D1B 11 C5 9B         LD DE, EntitySavedAttr
 489+ 9D1E 01 12 00         LD BC, 18
 490+ 9D21 ED B0            LDIR
 491+ 9D23 C9               RET
 492+ 9D24
 493+ 9D24              ; ==============================================================================
 494+ 9D24              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D24              ; ==============================================================================
 496+ 9D24              FlushAttrSlot:
 497+ 9D24 3A 09 9D         LD A, (CurrentAttrSlot)
 498+ 9D27 6F               LD L, A
 499+ 9D28 26 00            LD H, 0
 500+ 9D2A 29               ADD HL, HL                  ; x2
 501+ 9D2B 54               LD D, H
 502+ 9D2C 5D               LD E, L
 503+ 9D2D 29               ADD HL, HL                  ; x4
 504+ 9D2E 29               ADD HL, HL                  ; x8
 505+ 9D2F 29               ADD HL, HL                  ; x16
 506+ 9D30 19               ADD HL, DE                  ; x18
 507+ 9D31 11 D7 9B         LD DE, SavedAttrTable
 508+ 9D34 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D35 EB               EX DE, HL                   ; DE = destino
 510+ 9D36 21 C5 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D39 01 12 00         LD BC, 18
 512+ 9D3C ED B0            LDIR
 513+ 9D3E C9               RET
 514+ 9D3F
 515+ 9D3F              ; ==============================================================================
 516+ 9D3F              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D3F              ; ==============================================================================
 518+ 9D3F              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D3F              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D3F              ; ==============================================================================
 521+ 9D3F              CalcAttrAddr:
 522+ 9D3F 7A               LD A, D
 523+ 9D40 0F               RRCA
 524+ 9D41 0F               RRCA
 525+ 9D42 0F               RRCA
 526+ 9D43 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D45 6F               LD L, A
 528+ 9D46 26 00            LD H, 0
 529+ 9D48 29               ADD HL, HL
 530+ 9D49 29               ADD HL, HL
 531+ 9D4A 29               ADD HL, HL
 532+ 9D4B 29               ADD HL, HL
 533+ 9D4C 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D4D 7B               LD A, E
 535+ 9D4E 0F               RRCA
 536+ 9D4F 0F               RRCA
 537+ 9D50 0F               RRCA
 538+ 9D51 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D53 B5               OR L
 540+ 9D54 6F               LD L, A
 541+ 9D55 01 00 58         LD BC, ATTR_BASE
 542+ 9D58 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D59 C9               RET
 544+ 9D5A
 545+ 9D5A              ; ==============================================================================
 546+ 9D5A              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D5A              ; ==============================================================================
 548+ 9D5A              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D5A              ; Salida: HL=direccion en VRAM
 550+ 9D5A              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D5A              ; ==============================================================================
 552+ 9D5A              CalcPixelAddr:
 553+ 9D5A 7A               LD A, D
 554+ 9D5B E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D5D 1F               RRA
 556+ 9D5E 1F               RRA
 557+ 9D5F 1F               RRA                         ; >> 3
 558+ 9D60 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D62 67               LD H, A
 560+ 9D63
 561+ 9D63 7A               LD A, D
 562+ 9D64 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D66 B4               OR H
 564+ 9D67 67               LD H, A
 565+ 9D68
 566+ 9D68 7A               LD A, D
 567+ 9D69 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D6B 87               ADD A, A
 569+ 9D6C 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D6D 6F               LD L, A
 571+ 9D6E
 572+ 9D6E 7B               LD A, E
 573+ 9D6F 1F               RRA
 574+ 9D70 1F               RRA
 575+ 9D71 1F               RRA
 576+ 9D72 E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D74 B5               OR L
 578+ 9D75 6F               LD L, A
 579+ 9D76 C9               RET
 580+ 9D77
 581+ 9D77              ; ==============================================================================
 582+ 9D77              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D77              ; ==============================================================================
 584+ 9D77              DrawDebugInfo:
 585+ 9D77 3A 08 83         LD A, (CurrentScreenX)
 586+ 9D7A 1E 00            LD E, 0
 587+ 9D7C CD 99 9D         CALL .drawHexDigit
 588+ 9D7F
 589+ 9D7F 3E 2C            LD A, ','
 590+ 9D81 1E 01            LD E, 1
 591+ 9D83 CD A5 9D         CALL .drawChar
 592+ 9D86
 593+ 9D86 3A 09 83         LD A, (CurrentScreenY)
 594+ 9D89 1E 02            LD E, 2
 595+ 9D8B CD 99 9D         CALL .drawHexDigit
 596+ 9D8E
 597+ 9D8E 21 00 58         LD HL, ATTR_BASE
 598+ 9D91 3E 47            LD A, WHITE | $40
 599+ 9D93 77               LD (HL), A
 600+ 9D94 23               INC HL
 601+ 9D95 77               LD (HL), A
 602+ 9D96 23               INC HL
 603+ 9D97 77               LD (HL), A
 604+ 9D98 C9               RET
 605+ 9D99
 606+ 9D99              .drawHexDigit:
 607+ 9D99 E6 0F            AND $0F
 608+ 9D9B FE 0A            CP 10
 609+ 9D9D 38 04            JR C, .isNum
 610+ 9D9F C6 37            ADD A, 'A' - 10
 611+ 9DA1 18 02            JR .drawChar
 612+ 9DA3              .isNum:
 613+ 9DA3 C6 30            ADD A, '0'
 614+ 9DA5              .drawChar:
 615+ 9DA5 6F               LD L, A
 616+ 9DA6 26 00            LD H, 0
 617+ 9DA8 29               ADD HL, HL
 618+ 9DA9 29               ADD HL, HL
 619+ 9DAA 29               ADD HL, HL
 620+ 9DAB 01 00 3C         LD BC, $3C00
 621+ 9DAE 09               ADD HL, BC
 622+ 9DAF
 623+ 9DAF 16 40            LD D, $40
 624+ 9DB1 06 08            LD B, 8
 625+ 9DB3              .charLoop:
 626+ 9DB3 7E               LD A, (HL)
 627+ 9DB4 12               LD (DE), A
 628+ 9DB5 23               INC HL
 629+ 9DB6 14               INC D
 630+ 9DB7 10 FA            DJNZ .charLoop
 631+ 9DB9 C9               RET
