 123  6CFB
 124  6CFB                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 125  6CFB                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 126  6CFB                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6CFB              ; ==============================================================================
   2+ 6CFB              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6CFB              ; ==============================================================================
   4+ 6CFB              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6CFB              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6CFB              ;
   7+ 6CFB              ; Diseño beeper-style:
   8+ 6CFB              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6CFB              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6CFB              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6CFB              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6CFB              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6CFB              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6CFB              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6CFB              ;     hits clasicos en 48K).
  16+ 6CFB              ;   - AY_UpdatePlayerHit se llama cada frame desde MainLoop (cold path: salta
  17+ 6CFB              ;     en RET Z si no hay sweep activo).
  18+ 6CFB              ;
  19+ 6CFB              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  20+ 6CFB              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  21+ 6CFB              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  22+ 6CFB              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  23+ 6CFB              ;
  24+ 6CFB              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  25+ 6CFB              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  26+ 6CFB              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  27+ 6CFB              ;
  28+ 6CFB              ; Llamado desde:
  29+ 6CFB              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  30+ 6CFB              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  31+ 6CFB              ;   - MainLoop cada frame — update.
  32+ 6CFB              ; ==============================================================================
  33+ 6CFB
  34+ 6CFB              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  35+ 6CFB 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  36+ 6CFC 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  37+ 6CFE 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  38+ 6D00 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  39+ 6D01                                                ; (0 = inactivo o ya muteado)
  40+ 6D01
  41+ 6D01              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  42+ 6D01              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  43+ 6D01              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  44+ 6D01              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  45+ 6D01
  46+ 6D01              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  47+ 6D01              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  48+ 6D01              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  49+ 6D01              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  50+ 6D01
  51+ 6D01              ; ==============================================================================
  52+ 6D01              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  53+ 6D01              ; ==============================================================================
  54+ 6D01              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  55+ 6D01              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  56+ 6D01              ; tabla los hardcodea.
  57+ 6D01              ; ==============================================================================
  58+ 6D01              AY_PlayPlayerHit:
  59+ 6D01 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  60+ 6D04 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  61+ 6D06 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  62+ 6D09 18 08            JR _AY_PlaySweep
  63+ 6D0B
  64+ 6D0B              AY_PlayPlayerDeath:
  65+ 6D0B 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  66+ 6D0E 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  67+ 6D10 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  68+ 6D13                  ; fall through
  69+ 6D13
  70+ 6D13              ; IN: HL=period inicial, B=frames, DE=delta.
  71+ 6D13              _AY_PlaySweep:
  72+ 6D13 22 FC 6C         LD (PlayerHitPeriod), HL
  73+ 6D16 ED 53 FE 6C      LD (PlayerHitDelta), DE
  74+ 6D1A 78               LD A, B
  75+ 6D1B 32 FB 6C         LD (PlayerHitFrames), A
  76+ 6D1E F3               DI
  77+ 6D1F 0E FD            LD C, $FD
  78+ 6D21 21 27 6D         LD HL, .phRegs
  79+ 6D24 C3 58 6D         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  80+ 6D27
  81+ 6D27              .phRegs:
  82+ 6D27 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  83+ 6D29 03 00            DEFB  3, $00          ; R3  = period B hi
  84+ 6D2B 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  85+ 6D2D 07 3D            DEFB  7, $3D          ; R7  = mixer (tono B on, A/C off, noise off)
  86+ 6D2F FF               DEFB $FF              ; sentinel
  87+ 6D30
  88+ 6D30              ; ==============================================================================
  89+ 6D30              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  90+ 6D30              ; ==============================================================================
  91+ 6D30              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  92+ 6D30              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  93+ 6D30              ; Canal B (center stereo ABC). No bloqueante.
  94+ 6D30              ;
  95+ 6D30              ; IN: HL = period AY canal B (mayor = mas grave).
  96+ 6D30              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
  97+ 6D30              ;
  98+ 6D30              ; Sugerencias:
  99+ 6D30              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 100+ 6D30              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 101+ 6D30              ; Destruye: A, BC, HL.
 102+ 6D30              ; ==============================================================================
 103+ 6D30              AY_PlayBeep:
 104+ 6D30 78               LD A, B
 105+ 6D31 32 00 6D         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 106+ 6D34 F3               DI
 107+ 6D35 0E FD            LD C, $FD
 108+ 6D37                  ; R2 = L (period B lo)
 109+ 6D37 3E 02            LD A, 2
 110+ 6D39 06 FF            LD B, $FF
 111+ 6D3B ED 79            OUT (C), A
 112+ 6D3D 7D               LD A, L
 113+ 6D3E 06 BF            LD B, $BF
 114+ 6D40 ED 79            OUT (C), A
 115+ 6D42                  ; R3 = H (period B hi)
 116+ 6D42 3E 03            LD A, 3
 117+ 6D44 06 FF            LD B, $FF
 118+ 6D46 ED 79            OUT (C), A
 119+ 6D48 7C               LD A, H
 120+ 6D49 06 BF            LD B, $BF
 121+ 6D4B ED 79            OUT (C), A
 122+ 6D4D                  ; R9 = $0F (vol max fija, SIN envelope), R7 = mixer (B tono only)
 123+ 6D4D 21 53 6D         LD HL, .beepRegs
 124+ 6D50 C3 58 6D         JP _AY_WriteRegPairs                ; tail call: EI + RET
 125+ 6D53
 126+ 6D53              .beepRegs:
 127+ 6D53 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 128+ 6D55 07 3D            DEFB  7, $3D          ; mixer (B tono on, A/C off, noise off)
 129+ 6D57 FF               DEFB $FF              ; sentinel
 130+ 6D58
 131+ 6D58              ; ==============================================================================
 132+ 6D58              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 133+ 6D58              ; ==============================================================================
 134+ 6D58              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 135+ 6D58              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 136+ 6D58              ; ==============================================================================
 137+ 6D58              _AY_WriteRegPairs:
 138+ 6D58 7E               LD A, (HL)
 139+ 6D59 FE FF            CP $FF
 140+ 6D5B 28 0D            JR Z, .awrpDone
 141+ 6D5D 06 FF            LD B, $FF
 142+ 6D5F ED 79            OUT (C), A                          ; AY register select ($FFFD)
 143+ 6D61 23               INC HL
 144+ 6D62 06 BF            LD B, $BF
 145+ 6D64 7E               LD A, (HL)
 146+ 6D65 ED 79            OUT (C), A                          ; AY data ($BFFD)
 147+ 6D67 23               INC HL
 148+ 6D68 18 EE            JR _AY_WriteRegPairs
 149+ 6D6A              .awrpDone:
 150+ 6D6A FB               EI
 151+ 6D6B C9               RET
 152+ 6D6C
 153+ 6D6C              ; ==============================================================================
 154+ 6D6C              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave
 155+ 6D6C              ; ==============================================================================
 156+ 6D6C              ; Llamar cada frame desde MainLoop. No-op si sweep inactivo (frames=0).
 157+ 6D6C              ; Destruye: A, BC, DE, HL.
 158+ 6D6C              ; ==============================================================================
 159+ 6D6C              AY_UpdatePlayerHit:
 160+ 6D6C 3A FB 6C         LD A, (PlayerHitFrames)
 161+ 6D6F B7               OR A
 162+ 6D70 28 2C            JR Z, .uphCheckBeep
 163+ 6D72 3D               DEC A
 164+ 6D73 32 FB 6C         LD (PlayerHitFrames), A
 165+ 6D76 28 30            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 166+ 6D78
 167+ 6D78 2A FC 6C         LD HL, (PlayerHitPeriod)
 168+ 6D7B ED 5B FE 6C      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 169+ 6D7F 19               ADD HL, DE
 170+ 6D80 22 FC 6C         LD (PlayerHitPeriod), HL
 171+ 6D83
 172+ 6D83                  ; Escribir R2 = L, R3 = H (period B)
 173+ 6D83 F3               DI
 174+ 6D84 0E FD            LD C, $FD
 175+ 6D86 3E 02            LD A, 2
 176+ 6D88 06 FF            LD B, $FF
 177+ 6D8A ED 79            OUT (C), A
 178+ 6D8C 7D               LD A, L
 179+ 6D8D 06 BF            LD B, $BF
 180+ 6D8F ED 79            OUT (C), A
 181+ 6D91 3E 03            LD A, 3
 182+ 6D93 06 FF            LD B, $FF
 183+ 6D95 ED 79            OUT (C), A
 184+ 6D97 7C               LD A, H
 185+ 6D98 06 BF            LD B, $BF
 186+ 6D9A ED 79            OUT (C), A
 187+ 6D9C FB               EI
 188+ 6D9D C9               RET
 189+ 6D9E
 190+ 6D9E              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 191+ 6D9E              .uphCheckBeep:
 192+ 6D9E 3A 00 6D         LD A, (BeepDurationFrames)
 193+ 6DA1 B7               OR A
 194+ 6DA2 C8               RET Z
 195+ 6DA3 3D               DEC A
 196+ 6DA4 32 00 6D         LD (BeepDurationFrames), A
 197+ 6DA7 C0               RET NZ
 198+ 6DA8                  ; fall-through al cutoff compartido
 199+ 6DA8
 200+ 6DA8              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Beeper-style. ---
 201+ 6DA8              ; Llamado al final del sweep (PlayerHit/Death) y al final del beep.
 202+ 6DA8              _uphMuteR9:
 203+ 6DA8 F3               DI
 204+ 6DA9 01 FD FF         LD BC, $FFFD
 205+ 6DAC 3E 09            LD A, 9
 206+ 6DAE ED 79            OUT (C), A
 207+ 6DB0 01 FD BF         LD BC, $BFFD
 208+ 6DB3 AF               XOR A
 209+ 6DB4 ED 79            OUT (C), A
 210+ 6DB6 FB               EI
 211+ 6DB7 C9               RET
 212+ 6DB8
# file closed: sfx_player_hit_ay.asm
