4398+ BA8A              ; ==============================================================================
4399+ BA8A              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4400+ BA8A              ; ==============================================================================
4401+ BA8A              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4402+ BA8A              ; ==============================================================================
4403+ BA8A              TrySpawnNasty:
4404+ BA8A                  IF DEBUG_NO_ENEMIES
4405+ BA8A C9               RET
4406+ BA8B                  ENDIF
4407+ BA8B                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4408+ BA8B                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4409+ BA8B                  ; cuando el timer llega a 0.
4410+ BA8B 3A 73 82         LD A, (PostTrapPauseTimer)
4411+ BA8E B7               OR A
4412+ BA8F C0               RET NZ
4413+ BA90                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4414+ BA90                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4415+ BA90 3A 8C 82         LD A, (DeathBorderPhase)
4416+ BA93 B7               OR A
4417+ BA94 C0               RET NZ
4418+ BA95                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4419+ BA95                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4420+ BA95                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4421+ BA95 3A 90 82         LD A, (PlayerRespawnPhase)
4422+ BA98 FE 01            CP 1
4423+ BA9A C8               RET Z
4424+ BA9B                  ; Cooldown tras cambio de pantalla / inicio
4425+ BA9B 3A 9A 82         LD A, (SpawnTimer)
4426+ BA9E B7               OR A
4427+ BA9F 28 05            JR Z, .spawnReady
4428+ BAA1 3D               DEC A
4429+ BAA2 32 9A 82         LD (SpawnTimer), A
4430+ BAA5 C9               RET
4431+ BAA6              .spawnReady:
4432+ BAA6                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4433+ BAA6 3A 07 B9         LD A, (ScareTimer)
4434+ BAA9 B7               OR A
4435+ BAAA C0               RET NZ
4436+ BAAB                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4437+ BAAB                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4438+ BAAB                  ; rellenamos con nasties crepusculares hasta A2.
4439+ BAAB 3A 6D 82         LD A, (MonsterTrappedFlags)
4440+ BAAE E6 07            AND $07
4441+ BAB0 FE 07            CP $07
4442+ BAB2 28 0E            JR Z, .spawnIgnoreNightBlocks
4443+ BAB4                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4444+ BAB4                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4445+ BAB4                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4446+ BAB4                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4447+ BAB4 3A 71 B6         LD A, (MonstersActive)
4448+ BAB7 B7               OR A
4449+ BAB8 C0               RET NZ
4450+ BAB9                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4451+ BAB9 3A FE E4         LD A, (CurrentTimeOfDay)
4452+ BABC FE 04            CP 4                        ; N2
4453+ BABE C8               RET Z
4454+ BABF FE 05            CP 5                        ; A1
4455+ BAC1 C8               RET Z
4456+ BAC2              .spawnIgnoreNightBlocks:
4457+ BAC2                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4458+ BAC2                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4459+ BAC2                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4460+ BAC2                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4461+ BAC2 DD 21 BB 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4462+ BAC6 06 04            LD B, NUM_NASTIES
4463+ BAC8              .spawnLoop:
4464+ BAC8 C5               PUSH BC
4465+ BAC9 DD 7E 01         LD A, (IX+ENT_TYPE)
4466+ BACC B7               OR A
4467+ BACD 20 12            JR NZ, .spawnNextSlot
4468+ BACF CD EA BA         CALL SpawnOneNasty
4469+ BAD2 DD 7E 01         LD A, (IX+ENT_TYPE)
4470+ BAD5 B7               OR A
4471+ BAD6 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4472+ BAD8                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4473+ BAD8                  ; (un poco de irregularidad en la cadencia de aparicion).
4474+ BAD8 ED 5F            LD A, R
4475+ BADA E6 07            AND $07
4476+ BADC 32 9A 82         LD (SpawnTimer), A
4477+ BADF C1               POP BC
4478+ BAE0 C9               RET
4479+ BAE1              .spawnNextSlot:
4480+ BAE1 11 10 00         LD DE, ENT_SIZE
4481+ BAE4 DD 19            ADD IX, DE
4482+ BAE6 C1               POP BC
4483+ BAE7 10 DF            DJNZ .spawnLoop
4484+ BAE9 C9               RET
