 653+ 6393              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 654+ 6393              ; ==============================================================================
 655+ 6393              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 656+ 6393              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 657+ 6393              ; el open door restaura attrs originales en sus 4 cols + pixels.
 658+ 6393              ; ==============================================================================
 659+ 6393              TownGateRedrawOpenDoor:
 660+ 6393 21 FA EC         LD HL, BgGfx_town_gate_door_open
 661+ 6396 3E 03            LD A, 3
 662+ 6398 CD 41 6A         CALL LoadBgSpriteToBuffer
 663+ 639B DD 21 7C 89      LD IX, BgSpriteBuffer
 664+ 639F 06 0E            LD B, TGCS_DOOR_CHARX
 665+ 63A1 0E 11            LD C, TGCS_DOOR_CHARY
 666+ 63A3 AF               XOR A
 667+ 63A4 32 98 E4         LD (BgSpriteIsHouse), A
 668+ 63A7 32 FB D4         LD (CurrentTintVar), A
 669+ 63AA C3 F1 D3         JP DrawBgGfxSprite
 670+ 63AD
 671+ 63AD              ; ==============================================================================
 672+ 63AD              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 673+ 63AD              ; ==============================================================================
 674+ 63AD              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 675+ 63AD              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 676+ 63AD              ; transicion dinamica a LOCK al terminar todos los puffs.
 677+ 63AD              ; Destruye: A, BC, DE, IX.
 678+ 63AD              ; ==============================================================================
 679+ 63AD              TownGateAllNastiesDeadCheck:
 680+ 63AD DD 21 A6 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 681+ 63B1 06 04            LD B, NUM_NASTIES
 682+ 63B3              .tgandcLoop:
 683+ 63B3 DD 7E 01         LD A, (IX+ENT_TYPE)
 684+ 63B6 B7               OR A
 685+ 63B7 C0               RET NZ                              ; algun nasty aun activo
 686+ 63B8 11 10 00         LD DE, ENT_SIZE
 687+ 63BB DD 19            ADD IX, DE
 688+ 63BD 10 F4            DJNZ .tgandcLoop
 689+ 63BF AF               XOR A                               ; Z = todos TYPE_NONE
 690+ 63C0 C9               RET
 691+ 63C1
 692+ 63C1              ; ==============================================================================
 693+ 63C1              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 694+ 63C1              ; ==============================================================================
 695+ 63C1              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 696+ 63C1              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 697+ 63C1              ; y abajo se dibujan normal (XOR).
 698+ 63C1              ;
 699+ 63C1              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 700+ 63C1              ; - Encima del arco (POSY+20 < 120): full draw.
 701+ 63C1              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 702+ 63C1              ;   inferiores que pasan tras el lintel skipped.
 703+ 63C1              ; - Totalmente dentro (POSY 120..131): nada drawn.
 704+ 63C1              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 705+ 63C1              ;   lintel skipped.
 706+ 63C1              ; - Bajo del arco (POSY >= 152): full draw.
 707+ 63C1              ;
 708+ 63C1              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 709+ 63C1              ;     Bank 6 paginado al entrar (caller).
 710+ 63C1              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 711+ 63C1              ; Destruye: AF, BC, DE, HL, IY.
 712+ 63C1              ; ==============================================================================
 713+ 63C1              PLAYER_H_PX              EQU 21
 714+ 63C1
 715+ 63C1              TownGatePlayerXOR_BiClip:
 716+ 63C1 FD 23            INC IY
 717+ 63C3 FD 23            INC IY                              ; skip header
 718+ 63C5 D5               PUSH DE
 719+ 63C6 CD 41 A1         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 720+ 63C9 D1               POP DE
 721+ 63CA 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 722+ 63CC 4A               LD C, D                             ; C = current pixel Y
 723+ 63CD              .tgpxbcRow:
 724+ 63CD 79               LD A, C
 725+ 63CE FE C0            CP 192
 726+ 63D0 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 727+ 63D2                                                      ; (sin este clip, NextPixelLine lleva
 728+ 63D2                                                      ; HL a $5800+ = area de attrs → XOR
 729+ 63D2                                                      ; corrompe attrs como flashes raros).
 730+ 63D2 FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 731+ 63D4 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 732+ 63D6 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 733+ 63D8 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 734+ 63DA                  ; In [120, 151] → skip pixels en esta row
 735+ 63DA 18 0C            JR .tgpxbcAdvance
 736+ 63DC              .tgpxbcDraw:
 737+ 63DC                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 738+ 63DC                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 739+ 63DC FD 7E 00         LD A, (IY+0)
 740+ 63DF AE               XOR (HL)
 741+ 63E0 77               LD (HL), A
 742+ 63E1 23               INC HL
 743+ 63E2 FD 7E 01         LD A, (IY+1)
 744+ 63E5 AE               XOR (HL)
 745+ 63E6 77               LD (HL), A
 746+ 63E7 2B               DEC HL                              ; back to row start
 747+ 63E8              .tgpxbcAdvance:
 748+ 63E8 FD 23            INC IY
 749+ 63EA FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 750+ 63EC 0C               INC C                               ; pixel Y += 1
 751+ 63ED C5               PUSH BC
 752+ 63EE CD AD 9E         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 753+ 63F1 C1               POP BC
 754+ 63F2 10 D9            DJNZ .tgpxbcRow
 755+ 63F4 C9               RET
 756+ 63F5
 757+ 63F5              ; ==============================================================================
 758+ 63F5              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 759+ 63F5              ; ==============================================================================
 760+ 63F5              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 761+ 63F5              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 762+ 63F5              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 763+ 63F5              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 764+ 63F5              ; ==============================================================================
 765+ 63F5              TownGatePlayerSlideErase:
 766+ 63F5 DD 21 36 81      LD IX, EntityTable
 767+ 63F9 DD E5            PUSH IX
 768+ 63FB CD C1 A8         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 769+ 63FE DD E1            POP IX
 770+ 6400 3A C9 90         LD A, (CurrentPaging)
 771+ 6403 E6 F8            AND $F8
 772+ 6405 F6 06            OR 6
 773+ 6407 32 C9 90         LD (CurrentPaging), A
 774+ 640A 01 FD 7F         LD BC, $7FFD
 775+ 640D ED 79            OUT (C), A
 776+ 640F FD 2A 49 A8      LD IY, (OldSprAddr)
 777+ 6413 DD 56 0D         LD D, (IX+ENT_OLDY)
 778+ 6416 DD 7E 0C         LD A, (IX+ENT_OLDX)
 779+ 6419 5F               LD E, A
 780+ 641A CD C1 63         CALL TownGatePlayerXOR_BiClip
 781+ 641D 3A C9 90         LD A, (CurrentPaging)
 782+ 6420 E6 F8            AND $F8
 783+ 6422 32 C9 90         LD (CurrentPaging), A
 784+ 6425 01 FD 7F         LD BC, $7FFD
 785+ 6428 ED 79            OUT (C), A
 786+ 642A C9               RET
 787+ 642B
 788+ 642B              TownGatePlayerSlideDraw:
 789+ 642B DD 21 36 81      LD IX, EntityTable
 790+ 642F DD E5            PUSH IX
 791+ 6431 CD 90 A8         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 792+ 6434 DD E1            POP IX
 793+ 6436 3A C9 90         LD A, (CurrentPaging)
 794+ 6439 E6 F8            AND $F8
 795+ 643B F6 06            OR 6
 796+ 643D 32 C9 90         LD (CurrentPaging), A
 797+ 6440 01 FD 7F         LD BC, $7FFD
 798+ 6443 ED 79            OUT (C), A
 799+ 6445 FD 2A BF A8      LD IY, (SpriteAddrTemp)
 800+ 6449 3A 64 82         LD A, (PlayerDrawY)
 801+ 644C 57               LD D, A
 802+ 644D DD 7E 0F         LD A, (IX+ENT_DRAWX)
 803+ 6450 5F               LD E, A
 804+ 6451 CD C1 63         CALL TownGatePlayerXOR_BiClip
 805+ 6454 3A C9 90         LD A, (CurrentPaging)
 806+ 6457 E6 F8            AND $F8
 807+ 6459 32 C9 90         LD (CurrentPaging), A
 808+ 645C 01 FD 7F         LD BC, $7FFD
 809+ 645F ED 79            OUT (C), A
 810+ 6461                  ; Update OLD = current
 811+ 6461 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 812+ 6464 DD 77 0C         LD (IX+ENT_OLDX), A
 813+ 6467 3A 64 82         LD A, (PlayerDrawY)
 814+ 646A DD 77 0D         LD (IX+ENT_OLDY), A
 815+ 646D DD 7E 00         LD A, (IX+ENT_SPRITEID)
 816+ 6470 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 817+ 6473 C9               RET
