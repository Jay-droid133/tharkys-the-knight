 673+ 6F17 ~            ; ==============================================================================
 674+ 6F17 ~            ; .cmcpFindGapBySide - Para sala A, busca el gap en side B más cercano al
 675+ 6F17 ~            ; LastEntryCoord; devuelve su comp.
 676+ 6F17 ~            ; ==============================================================================
 677+ 6F17 ~            ; IN:  A = sid, B = side (0..3)
 678+ 6F17 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no hay gap en ese side.
 679+ 6F17 ~            ;
 680+ 6F17 ~            ; Cuando hay múltiples gaps del mismo side en distintas comps (e.g. (5,12)
 681+ 6F17 ~            ; con E@3 comp 1 y E@11 comp 0), el coord físico del char donde entró el
 682+ 6F17 ~            ; player desambigua: tomamos el gap con coord más cercano al LastEntryCoord.
 683+ 6F17 ~            ;
 684+ 6F17 ~            ; Destruye: AF, BC, DE, HL.
 685+ 6F17 ~            ; ==============================================================================
 686+ 6F17 ~            .cmcpFindGapBySide:
 687+ 6F17 ~                LD (.fgbsTargetSid), A
 688+ 6F17 ~                LD A, B
 689+ 6F17 ~                LD (.fgbsTargetSide), A
 690+ 6F17 ~                LD A, $FF
 691+ 6F17 ~                LD (.fgbsBestComp), A
 692+ 6F17 ~                LD A, 255
 693+ 6F17 ~                LD (.fgbsBestDist), A                ; init bestDist = 255 (max)
 694+ 6F17 ~
 695+ 6F17 ~                LD A, (.fgbsTargetSid)
 696+ 6F17 ~                LD L, A
 697+ 6F17 ~                LD H, 0
 698+ 6F17 ~                ADD HL, HL
 699+ 6F17 ~                LD DE, RoomCompGapsTable
 700+ 6F17 ~                ADD HL, DE
 701+ 6F17 ~                LD E, (HL)
 702+ 6F17 ~                INC HL
 703+ 6F17 ~                LD D, (HL)
 704+ 6F17 ~                EX DE, HL                            ; HL = record
 705+ 6F17 ~                LD A, (HL)
 706+ 6F17 ~                OR A
 707+ 6F17 ~                JR Z, .fgbsDone
 708+ 6F17 ~                LD B, A                              ; count
 709+ 6F17 ~                INC HL
 710+ 6F17 ~            .fgbsLoop:
 711+ 6F17 ~                LD A, (HL)                           ; side_comp
 712+ 6F17 ~                INC HL
 713+ 6F17 ~                LD C, (HL)                           ; coord
 714+ 6F17 ~                INC HL
 715+ 6F17 ~                LD D, A                              ; D = side_comp
 716+ 6F17 ~                AND $03
 717+ 6F17 ~                LD E, A
 718+ 6F17 ~                LD A, (.fgbsTargetSide)
 719+ 6F17 ~                CP E
 720+ 6F17 ~                JR NZ, .fgbsNext
 721+ 6F17 ~
 722+ 6F17 ~                ; Compute |coord - LastEntryCoord|
 723+ 6F17 ~                LD A, (LastEntryCoord)
 724+ 6F17 ~                SUB C
 725+ 6F17 ~                JR NC, .fgbsAbsOk
 726+ 6F17 ~                NEG
 727+ 6F17 ~            .fgbsAbsOk:
 728+ 6F17 ~                LD E, A                              ; E = distance
 729+ 6F17 ~                LD A, (.fgbsBestDist)
 730+ 6F17 ~                CP E
 731+ 6F17 ~                JR C, .fgbsNext                      ; bestDist < E → not better
 732+ 6F17 ~                JR Z, .fgbsNext                      ; ties: keep first
 733+ 6F17 ~                ; New best
 734+ 6F17 ~                LD A, E
 735+ 6F17 ~                LD (.fgbsBestDist), A
 736+ 6F17 ~                LD A, D
 737+ 6F17 ~                SRL A
 738+ 6F17 ~                SRL A
 739+ 6F17 ~                AND $03
 740+ 6F17 ~                LD (.fgbsBestComp), A
 741+ 6F17 ~
 742+ 6F17 ~            .fgbsNext:
 743+ 6F17 ~                DJNZ .fgbsLoop
 744+ 6F17 ~            .fgbsDone:
 745+ 6F17 ~                LD A, (.fgbsBestComp)
 746+ 6F17 ~                RET
