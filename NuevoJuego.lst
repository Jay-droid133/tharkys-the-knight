 662+ 69AF 72               LD (HL), D                              ; charX = AltN_CHAR_X
 663+ 69B0 23               INC HL
 664+ 69B1 3A B6 69         LD A, (.rcaCharY)
 665+ 69B4 77               LD (HL), A                              ; charY = AltN_CHAR_Y
 666+ 69B5              .rcaSkip:
