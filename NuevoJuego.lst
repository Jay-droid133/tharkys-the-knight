1281+ F4F6              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1282+ F4F6              .ucsShakeStatuePhase:
1283+ F4F6 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1284+ F4F9 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1285+ F4FB 30 35            JR NC, .ucsShakeStatueDone
1286+ F4FD                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1287+ F4FD                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1288+ F4FD                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1289+ F4FD                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1290+ F4FD                  ;
1291+ F4FD                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1292+ F4FD                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1293+ F4FD ED 5F            LD A, R
1294+ F4FF E6 03            AND $03
1295+ F501 21 2E F5         LD HL, .ucsShakeJitterTable
1296+ F504 5F               LD E, A
1297+ F505 16 00            LD D, 0
1298+ F507 19               ADD HL, DE
1299+ F508 7E               LD A, (HL)
1300+ F509 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1301+ F50A                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1302+ F50A 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1303+ F50D FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1304+ F50F 21 B1 64         LD HL, StatueIdTable
1305+ F512 38 03            JR C, .ucsShakeTablePicked
1306+ F514 21 B4 64         LD HL, StatueBrokenIdTable
1307+ F517              .ucsShakeTablePicked:
1308+ F517 78               LD A, B                                 ; restore jitter para la llamada
1309+ F518 CD 25 F6         CALL ChurchCutsceneShakeStatueByteShift
1310+ F51B                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1311+ F51B                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1312+ F51B                  ; y al salir de la fase forzamos borde a negro explicitamente.
1313+ F51B 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1314+ F51E E6 01            AND $01
1315+ F520 28 04            JR Z, .ucsShakeBorderBlack
1316+ F522 3E 07            LD A, WHITE
1317+ F524 18 01            JR .ucsShakeBorderOut
1318+ F526              .ucsShakeBorderBlack:
1319+ F526 AF               XOR A                                   ; BLACK
1320+ F527              .ucsShakeBorderOut:
1321+ F527 D3 FE            OUT (254), A
1322+ F529 21 9D 5F         LD HL, ChurchCutsceneFrame
1323+ F52C 34               INC (HL)
1324+ F52D C9               RET
1325+ F52E              .ucsShakeJitterTable:
1326+ F52E 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1327+ F532              .ucsShakeStatueDone:
1328+ F532                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1329+ F532 AF               XOR A
1330+ F533 D3 FE            OUT (254), A
1331+ F535                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1332+ F535                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1333+ F535                  ; directo a 0 garantiza que no queden residuos.)
1334+ F535 CD 90 F6         CALL ChurchCutsceneEraseStatueDirect
1335+ F538 21 38 FA         LD HL, SFX_EnemyDeath
1336+ F53B CD B9 F9         CALL PlaySFX
1337+ F53E 3E 03            LD A, 3
1338+ F540 32 CE 82         LD (ChurchCutscenePhase), A
1339+ F543 AF               XOR A
1340+ F544 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1341+ F547 C9               RET
1342+ F548
1343+ F548              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1344+ F548              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1345+ F548              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1346+ F548              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1347+ F548              ; Entre transiciones, solo incrementa frame counter.
1348+ F548              .ucsSmokePhase:
1349+ F548 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1350+ F54B B7               OR A
1351+ F54C 28 0E            JR Z, .ucsSmokeEntry
1352+ F54E FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1353+ F550 28 16            JR Z, .ucsSmokeStep1
1354+ F552 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1355+ F554 28 1D            JR Z, .ucsSmokeStep2
1356+ F556 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1357+ F558 28 25            JR Z, .ucsSmokeEnd
1358+ F55A 18 35            JR .ucsSmokeIncFrame
1359+ F55C              .ucsSmokeEntry:
