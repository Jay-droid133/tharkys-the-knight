 579+ F700              ; ==============================================================================
 580+ F700              ; TownGateEraseDoor - XOR-erase de la puerta cerrada (id 240)
 581+ F700              ; ==============================================================================
 582+ F700              ; La puerta esta en PickupTable; RedrawPickupByPtr llamado dos veces no
 583+ F700              ; sirve (no es idempotente: solo dibuja). Cargamos sprite y XOR-redraw a su
 584+ F700              ; posicion. Como ya estaba dibujada, XOR self-cancel = erase.
 585+ F700              ; ==============================================================================
 586+ F700              TownGateEraseDoor:
 587+ F700 11 31 E6         LD DE, BgGfx_town_gate_door_closed
 588+ F703 C3 13 D3         JP RedrawPickupByPtr
 589+ F706
 590+ F706              ; ==============================================================================
 591+ F706              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 592+ F706              ; ==============================================================================
 593+ F706              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 594+ F706              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 595+ F706              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 596+ F706              ; 2. Compute new offset random.
 597+ F706              ; 3. Draw at new offset.
 598+ F706              ; Destruye: AF, BC, DE, HL, IX.
 599+ F706              ; ==============================================================================
 600+ F706              TownGateShakeStep:
 601+ F706 CD 4E F7         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 602+ F709 CD 69 F7         CALL TownGateDrawFingerShifted
 603+ F70C                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 604+ F70C ED 5F            LD A, R
 605+ F70E E6 03            AND $03
 606+ F710 21 31 F7         LD HL, .tgssJitterTable
 607+ F713 5F               LD E, A
 608+ F714 16 00            LD D, 0
 609+ F716 19               ADD HL, DE
 610+ F717 7E               LD A, (HL)
 611+ F718 32 A6 5F         LD (TownGateShakeOffsX), A
 612+ F71B 3A 11 81         LD A, (GameFrameCounter)
 613+ F71E E6 03            AND $03
 614+ F720 21 31 F7         LD HL, .tgssJitterTable
 615+ F723 5F               LD E, A
 616+ F724 16 00            LD D, 0
 617+ F726 19               ADD HL, DE
 618+ F727 7E               LD A, (HL)
 619+ F728 32 A7 5F         LD (TownGateShakeOffsY), A
 620+ F72B CD 4E F7         CALL TownGateDrawArmShifted          ; draw at new offset
 621+ F72E C3 69 F7         JP TownGateDrawFingerShifted
 622+ F731              .tgssJitterTable:
 623+ F731 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 624+ F735
 625+ F735              ; ==============================================================================
 626+ F735              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 627+ F735              ; ==============================================================================
 628+ F735              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 629+ F735              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 630+ F735              ; ==============================================================================
 631+ F735              TownGateShakeRestore:
 632+ F735 CD 4E F7         CALL TownGateDrawArmShifted          ; erase last shifted
 633+ F738 CD 69 F7         CALL TownGateDrawFingerShifted
 634+ F73B AF               XOR A
 635+ F73C 32 A6 5F         LD (TownGateShakeOffsX), A
 636+ F73F 32 A7 5F         LD (TownGateShakeOffsY), A
 637+ F742 11 D6 E5         LD DE, BgGfx_arm
 638+ F745 CD 13 D3         CALL RedrawPickupByPtr               ; restore at PickupTable position
 639+ F748 11 23 E6         LD DE, BgGfx_finger
 640+ F74B C3 13 D3         JP RedrawPickupByPtr
 641+ F74E
 642+ F74E              ; ==============================================================================
 643+ F74E              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 644+ F74E              ; ==============================================================================
 645+ F74E              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 646+ F74E              ; Destruye: AF, BC, DE, HL, IX.
 647+ F74E              ; ==============================================================================
 648+ F74E              TownGateDrawArmShifted:
 649+ F74E 21 D6 E5         LD HL, BgGfx_arm
 650+ F751 3E 03            LD A, 3
 651+ F753 CD 0A 91         CALL LoadBgSpriteToBuffer
 652+ F756 3A A6 5F         LD A, (TownGateShakeOffsX)
 653+ F759 47               LD B, A
 654+ F75A 3E 88            LD A, TGCS_ARM_PX_X
 655+ F75C 80               ADD A, B
 656+ F75D 5F               LD E, A
 657+ F75E 3A A7 5F         LD A, (TownGateShakeOffsY)
 658+ F761 47               LD B, A
 659+ F762 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 660+ F764 80               ADD A, B
 661+ F765 57               LD D, A
 662+ F766 C3 84 F7         JP DrawBgSpriteAnyXorAtPixel
 663+ F769
 664+ F769              ; ==============================================================================
 665+ F769              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 666+ F769              ; ==============================================================================
 667+ F769              TownGateDrawFingerShifted:
 668+ F769 21 23 E6         LD HL, BgGfx_finger
 669+ F76C 3E 03            LD A, 3
 670+ F76E CD 0A 91         CALL LoadBgSpriteToBuffer
 671+ F771 3A A6 5F         LD A, (TownGateShakeOffsX)
 672+ F774 47               LD B, A
 673+ F775 3E 88            LD A, TGCS_FINGER_PX_X
 674+ F777 80               ADD A, B
 675+ F778 5F               LD E, A
 676+ F779 3A A7 5F         LD A, (TownGateShakeOffsY)
 677+ F77C 47               LD B, A
 678+ F77D 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 679+ F77F 80               ADD A, B
 680+ F780 57               LD D, A
 681+ F781 C3 84 F7         JP DrawBgSpriteAnyXorAtPixel
 682+ F784
 683+ F784              ; ==============================================================================
 684+ F784              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 685+ F784              ; ==============================================================================
 686+ F784              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 687+ F784              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 688+ F784              ;     E = pixel X (0..255).
 689+ F784              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 690+ F784              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 691+ F784              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 692+ F784              ; Destruye: AF, BC, DE, HL, IX.
 693+ F784              ; ==============================================================================
 694+ F784              DrawBgSpriteAnyXorAtPixel:
 695+ F784 DD 21 42 89      LD IX, BgSpriteBuffer
 696+ F788 DD 7E 00         LD A, (IX+0)                        ; height_px
 697+ F78B B7               OR A
 698+ F78C C8               RET Z
 699+ F78D 32 E7 F7         LD (.dbsaHeight), A
 700+ F790 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 701+ F793 E6 7F            AND $7F
 702+ F795 32 E8 F7         LD (.dbsaWidth), A
 703+ F798 DD 23            INC IX
 704+ F79A DD 23            INC IX                              ; -> pixel data
 705+ F79C 7B               LD A, E
 706+ F79D E6 07            AND $07
 707+ F79F 32 E9 F7         LD (.dbsaShift), A
 708+ F7A2 7B               LD A, E
 709+ F7A3 E6 F8            AND $F8
 710+ F7A5 5F               LD E, A
 711+ F7A6 CD BA A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 712+ F7A9              .dbsaRow:
 713+ F7A9 E5               PUSH HL
 714+ F7AA 3A E8 F7         LD A, (.dbsaWidth)
 715+ F7AD 47               LD B, A                             ; B = width counter
 716+ F7AE 0E 00            LD C, 0                             ; C = carry from prev byte
 717+ F7B0              .dbsaByte:
 718+ F7B0 DD 7E 00         LD A, (IX+0)
 719+ F7B3 2F               CPL                                 ; un-invert
 720+ F7B4 57               LD D, A                             ; D = sprite byte
 721+ F7B5 1E 00            LD E, 0                             ; E = bits que caen al next byte
 722+ F7B7 3A E9 F7         LD A, (.dbsaShift)
 723+ F7BA B7               OR A
 724+ F7BB 28 09            JR Z, .dbsaNoShift
 725+ F7BD C5               PUSH BC
 726+ F7BE 47               LD B, A
 727+ F7BF              .dbsaShiftLoop:
 728+ F7BF CB 3A            SRL D
 729+ F7C1 CB 1B            RR E
 730+ F7C3 10 FA            DJNZ .dbsaShiftLoop
 731+ F7C5 C1               POP BC
 732+ F7C6              .dbsaNoShift:
 733+ F7C6 7A               LD A, D
 734+ F7C7 B1               OR C                                ; combinar con carry previo
 735+ F7C8 AE               XOR (HL)
 736+ F7C9 77               LD (HL), A
 737+ F7CA 23               INC HL
 738+ F7CB 4B               LD C, E                             ; nuevo carry para siguiente byte
 739+ F7CC DD 23            INC IX
 740+ F7CE 10 E0            DJNZ .dbsaByte
 741+ F7D0                  ; Byte final (carry) si shift > 0
 742+ F7D0 3A E9 F7         LD A, (.dbsaShift)
 743+ F7D3 B7               OR A
 744+ F7D4 28 03            JR Z, .dbsaNoFinal
 745+ F7D6 79               LD A, C
 746+ F7D7 AE               XOR (HL)
 747+ F7D8 77               LD (HL), A
 748+ F7D9              .dbsaNoFinal:
 749+ F7D9 E1               POP HL
 750+ F7DA CD 26 9E         CALL NextPixelLine
 751+ F7DD 3A E7 F7         LD A, (.dbsaHeight)
 752+ F7E0 3D               DEC A
 753+ F7E1 32 E7 F7         LD (.dbsaHeight), A
 754+ F7E4 20 C3            JR NZ, .dbsaRow
 755+ F7E6 C9               RET
 756+ F7E7 00           .dbsaHeight: DEFB 0
 757+ F7E8 00           .dbsaWidth:  DEFB 0
 758+ F7E9 00           .dbsaShift:  DEFB 0
 759+ F7EA
 760+ F7EA              ; ==============================================================================
 761+ F7EA              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 762+ F7EA              ; ==============================================================================
 763+ F7EA              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 764+ F7EA              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 765+ F7EA              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 766+ F7EA              ; visualmente la mitad inferior del player desaparece tras la HUD.
 767+ F7EA              ; ==============================================================================
 768+ F7EA              TownGateExitStep:
 769+ F7EA 3A A8 5F         LD A, (TownGateExitStepCnt)
 770+ F7ED 3C               INC A
 771+ F7EE 32 A8 5F         LD (TownGateExitStepCnt), A
 772+ F7F1 FE 02            CP TGCS_T_EXIT_STEP
 773+ F7F3 D8               RET C                               ; aun no toca step
 774+ F7F4 AF               XOR A
 775+ F7F5 32 A8 5F         LD (TownGateExitStepCnt), A
 776+ F7F8                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
 777+ F7F8 DD 21 14 81      LD IX, EntityTable
 778+ F7FC DD 7E 04         LD A, (IX+ENT_POSY)
 779+ F7FF 3C               INC A
 780+ F800 DD 77 04         LD (IX+ENT_POSY), A
 781+ F803 32 42 82         LD (PlayerDrawY), A
 782+ F806 3A A9 5F         LD A, (TownGateExitWalkFrame)
 783+ F809 EE 01            XOR 1                               ; toggle 0/1
 784+ F80B 32 A9 5F         LD (TownGateExitWalkFrame), A
 785+ F80E 47               LD B, A
 786+ F80F 3E 0E            LD A, SPRID_WALK_S
 787+ F811 80               ADD A, B
 788+ F812 DD 77 00         LD (IX+ENT_SPRITEID), A
 789+ F815 C3 D7 F6         JP TownGateRedrawPlayer
 790+ F818
 791+ F818              ; ==============================================================================
 792+ F818              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
 793+ F818              ; ==============================================================================
 794+ F818              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
 795+ F818              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
 796+ F818              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
 797+ F818              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
 798+ F818              ; Destruye: AF, BC, DE, HL, IX.
 799+ F818              ; ==============================================================================
 800+ F818              TownGateDrawTheEnd:
 801+ F818 21 A2 E6         LD HL, BgGfx_the_end
 802+ F81B 3E 03            LD A, 3
 803+ F81D CD 0A 91         CALL LoadBgSpriteToBuffer
 804+ F820 DD 21 42 89      LD IX, BgSpriteBuffer
 805+ F824 06 0B            LD B, TGCS_END_CHARX
 806+ F826 0E 04            LD C, TGCS_END_CHARY
 807+ F828 AF               XOR A
 808+ F829 32 07 DD         LD (BgSpriteIsHouse), A
 809+ F82C 32 23 CE         LD (CurrentTintVar), A              ; sin tint
 810+ F82F C3 19 CD         JP DrawBgGfxSprite
 811+ F832
 812+ F832              ; ==============================================================================
 813+ F832              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
 814+ F832              ; ==============================================================================
 815+ F832              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
 816+ F832              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
 817+ F832              ; quedara visible sobre fondo negro.
 818+ F832              ; ==============================================================================
 819+ F832              TownGateWipeBlack:
 820+ F832 21 00 40         LD HL, $4000
 821+ F835 11 01 40         LD DE, $4001
 822+ F838 01 FF 17         LD BC, $17FF
 823+ F83B 36 00            LD (HL), 0
 824+ F83D ED B0            LDIR
 825+ F83F 21 00 58         LD HL, $5800
 826+ F842 11 01 58         LD DE, $5801
 827+ F845 01 FF 02         LD BC, $02FF
 828+ F848 36 00            LD (HL), $00                        ; ink black, paper black
 829+ F84A ED B0            LDIR
 830+ F84C C9               RET
 831+ F84D
 832+ F84D              ; ==============================================================================
 833+ F84D              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
 834+ F84D              ; ==============================================================================
 835+ F84D              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
 836+ F84D              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
 837+ F84D              ; (white ink, black paper, bright) para todo el area de texto.
 838+ F84D              ; ==============================================================================
 839+ F84D              TownGateDrawCredits:
 840+ F84D                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
 841+ F84D 21 00 58         LD HL, $5800
 842+ F850 11 01 58         LD DE, $5801
 843+ F853 01 FF 02         LD BC, $02FF
 844+ F856 36 47            LD (HL), $47
 845+ F858 ED B0            LDIR
 846+ F85A                  ; Iterar credits
 847+ F85A 21 AA F8         LD HL, TownGateCreditsData
 848+ F85D              .tgdcLoop:
 849+ F85D 7E               LD A, (HL)
 850+ F85E FE FF            CP $FF
 851+ F860 C8               RET Z
 852+ F861 57               LD D, A                             ; D = row
 853+ F862 23               INC HL
 854+ F863 7E               LD A, (HL)
 855+ F864 5F               LD E, A                             ; E = col
 856+ F865 23               INC HL                              ; HL → string
 857+ F866 CD 6B F8         CALL PrintStringFontAt
 858+ F869 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
 859+ F86B
 860+ F86B              ; ==============================================================================
 861+ F86B              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
 862+ F86B              ; ==============================================================================
 863+ F86B              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
 864+ F86B              ; siguiente byte tras el 0 (para que el caller siga iterando).
 865+ F86B              ; Destruye: AF, BC, DE, HL.
 866+ F86B              ; OUT: HL apunta al byte tras el 0 terminador.
 867+ F86B              ; ==============================================================================
 868+ F86B              PrintStringFontAt:
 869+ F86B              .psfaCharLoop:
 870+ F86B 7E               LD A, (HL)
 871+ F86C 23               INC HL
 872+ F86D B7               OR A
 873+ F86E C8               RET Z                               ; fin de string
 874+ F86F E5               PUSH HL
 875+ F870 D5               PUSH DE
 876+ F871 CD 79 F8         CALL DrawCharFontAt                 ; D=row, E=col, A=char
 877+ F874 D1               POP DE
 878+ F875 E1               POP HL
 879+ F876 1C               INC E                               ; siguiente columna
 880+ F877 18 F2            JR .psfaCharLoop
 881+ F879
 882+ F879              ; ==============================================================================
 883+ F879              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
 884+ F879              ; ==============================================================================
 885+ F879              ; D = row (0..23), E = col (0..31), A = ASCII char.
 886+ F879              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
 887+ F879              ;   y = row * 8, x = col * 8
 888+ F879              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
 889+ F879              ; El char se renderiza con direct write (sobrescribe pixels y attr).
 890+ F879              ; Destruye: AF, BC, DE, HL.
 891+ F879              ; ==============================================================================
 892+ F879              DrawCharFontAt:
 893+ F879 D5               PUSH DE
 894+ F87A                  ; HL = $3C00 + char * 8
 895+ F87A 6F               LD L, A
 896+ F87B 26 00            LD H, 0
 897+ F87D 29               ADD HL, HL
 898+ F87E 29               ADD HL, HL
 899+ F87F 29               ADD HL, HL
 900+ F880 01 00 3C         LD BC, $3C00
 901+ F883 09               ADD HL, BC
 902+ F884 D1               POP DE
 903+ F885                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
 904+ F885 E5               PUSH HL                             ; save font ptr
 905+ F886 7A               LD A, D
 906+ F887 87               ADD A, A
 907+ F888 87               ADD A, A
 908+ F889 87               ADD A, A                            ; A = row * 8 = pixel Y
 909+ F88A 57               LD D, A
 910+ F88B 7B               LD A, E
 911+ F88C 87               ADD A, A
 912+ F88D 87               ADD A, A
 913+ F88E 87               ADD A, A                            ; A = col * 8 = pixel X
 914+ F88F 5F               LD E, A
 915+ F890 CD BA A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 916+ F893 EB               EX DE, HL                           ; DE = VRAM addr
 917+ F894 E1               POP HL                              ; HL = font ptr
 918+ F895 06 08            LD B, 8
 919+ F897              .dcfaLoop:
 920+ F897 7E               LD A, (HL)
 921+ F898 12               LD (DE), A
 922+ F899 23               INC HL
 923+ F89A 14               INC D                               ; siguiente scan line (within char)
 924+ F89B 10 FA            DJNZ .dcfaLoop
 925+ F89D C9               RET
 926+ F89E
