 463+ 77CD 3E 01            LD A, 1
 464+ 77CF 32 CD 5F         LD (MagicCompassBfsState), A
 465+ 77D2
 466+ 77D2              .cmcpResume:
 467+ 77D2                  ; Cargar contador de iteraciones para este chunk de frame.
 468+ 77D2 3E 20            LD A, MAGIC_COMPASS_BFS_ITERS_PER_FRAME
 469+ 77D4 32 09 7A         LD (.cmcpItersLeft), A
