 161  70EF
 162  70EF                  ; --- Random pickups: Give routines (random_pickups.asm) ---
 163  70EF                  ; GiveLife / GiveHealth / GiveStamina. Cold path (solo al recoger pickup
 164  70EF                  ; random life/health/stamina). HUD se refresca solo cada frame.
 165  70EF                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ 70EF              ; ==============================================================================
   2+ 70EF              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 70EF              ; ==============================================================================
   4+ 70EF              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 70EF              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 70EF              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 70EF              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 70EF              ; correspondiente desde CheckPickupCollect.
   9+ 70EF              ;
  10+ 70EF              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 70EF              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 70EF              ;
  13+ 70EF              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 70EF              ; Bank 0/2 quedan limpios.
  15+ 70EF              ; ==============================================================================
  16+ 70EF
  17+ 70EF              ; ==============================================================================
  18+ 70EF              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 70EF              ; ==============================================================================
  20+ 70EF              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 70EF              ; el cambio via cache .dlhLast.
  22+ 70EF              ; ==============================================================================
  23+ 70EF              GiveLife:
  24+ 70EF 3A E1 82         LD A, (PlayerLives)
  25+ 70F2 FE 05            CP PLAYER_LIVES_MAX
  26+ 70F4 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 70F5 3C               INC A
  28+ 70F6 32 E1 82         LD (PlayerLives), A
  29+ 70F9 C9               RET
  30+ 70FA
  31+ 70FA              ; ==============================================================================
  32+ 70FA              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 70FA              ; ==============================================================================
  34+ 70FA              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 70FA              ; ==============================================================================
  36+ 70FA              GiveHealth:
  37+ 70FA 3A 55 B3         LD A, (PlayerHealth)
  38+ 70FD C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 70FF 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 7101 FE 11            CP HEALTH_MAX + 1
  41+ 7103 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 7105              .ghCap:
  43+ 7105 3E 10            LD A, HEALTH_MAX
  44+ 7107              .ghStore:
  45+ 7107 32 55 B3         LD (PlayerHealth), A
  46+ 710A C9               RET
  47+ 710B
  48+ 710B              ; ==============================================================================
  49+ 710B              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ 710B              ; ==============================================================================
  51+ 710B              GiveStamina:
  52+ 710B 3A 56 B3         LD A, (PlayerStamina)
  53+ 710E C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ 7110 38 04            JR C, .gsCap
  55+ 7112 FE 11            CP STAMINA_MAX + 1
  56+ 7114 38 02            JR C, .gsStore
  57+ 7116              .gsCap:
  58+ 7116 3E 10            LD A, STAMINA_MAX
  59+ 7118              .gsStore:
  60+ 7118 32 56 B3         LD (PlayerStamina), A
  61+ 711B C9               RET
  62+ 711C
  63+ 711C              ; ==============================================================================
  64+ 711C              ; ROULETTE — datos
  65+ 711C              ; ==============================================================================
  66+ 711C              ; RouletteOrder: secuencia de type ids que recorre el ciclado. Tunable por
  67+ 711C              ; el usuario — añadir/quitar/reordenar entries y rebuild. La longitud se
  68+ 711C              ; calcula sola via ROULETTE_ORDER_LEN.
  69+ 711C              RouletteOrder:
  70+ 711C 01               DEFB ROUL_LIFE
  71+ 711D 06               DEFB ROUL_MUSHROOM
  72+ 711E 02               DEFB ROUL_HEALTH
  73+ 711F 05               DEFB ROUL_CARACOL
  74+ 7120 07               DEFB ROUL_COMPASS
  75+ 7121 06               DEFB ROUL_MUSHROOM
  76+ 7122 03               DEFB ROUL_STAMINA
  77+ 7123 04               DEFB ROUL_RAYO
  78+ 7124 05               DEFB ROUL_CARACOL
  79+ 7125              RouletteOrderEnd:
  80+ 7125              ROULETTE_ORDER_LEN  EQU RouletteOrderEnd - RouletteOrder
  81+ 7125
  82+ 7125              ; RouletteTypePtrs: tabla de lookup type id → BgGfx ptr. Indexada por
  83+ 7125              ; (type-1)*2 — el id 0 esta sin usar (no aparece en RouletteOrder).
  84+ 7125              RouletteTypePtrs:
  85+ 7125 84 CC            DEFW BgGfx_life                                     ; ROUL_LIFE     = 1
  86+ 7127 EC F1            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH   = 2
  87+ 7129 91 E7            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA  = 3
  88+ 712B BA E7            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO     = 4
  89+ 712D E3 E7            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  90+ 712F 0C E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  91+ 7131 88 F1            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
  92+ 7133
  93+ 7133              ; ==============================================================================
  94+ 7133              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ 7133              ; ==============================================================================
  96+ 7133              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  97+ 7133              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  98+ 7133              ;
  99+ 7133              ; HEALTH y STAMINA: en lugar del ptr canonical de RouletteTypePtrs, se elige
 100+ 7133              ; al azar entre las variantes (HealthVariantPtrs / StaminaVariantPtrs). Cada
 101+ 7133              ; tick del ciclo (~480ms) que toque health o stamina muestra una variante
 102+ 7133              ; potencialmente distinta — consistencia visual con el random pickup directo.
 103+ 7133              ; ==============================================================================
 104+ 7133              GetRoulettePtrByIdx:
 105+ 7133 21 1C 71         LD HL, RouletteOrder
 106+ 7136 5F               LD E, A
 107+ 7137 16 00            LD D, 0
 108+ 7139 19               ADD HL, DE
 109+ 713A 7E               LD A, (HL)                              ; A = type id (1..7)
 110+ 713B                  ; Intercept HEALTH / STAMINA -> tail call a PickRandomVariantPtr
 111+ 713B FE 02            CP ROUL_HEALTH
 112+ 713D 28 12            JR Z, .grpiHealth
 113+ 713F FE 03            CP ROUL_STAMINA
 114+ 7141 28 14            JR Z, .grpiStamina
 115+ 7143                  ; Resto: lookup en RouletteTypePtrs (canonical)
 116+ 7143 3D               DEC A                                   ; idx 0-based para tabla ptrs
 117+ 7144 26 00            LD H, 0
 118+ 7146 6F               LD L, A
 119+ 7147 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 120+ 7148 11 25 71         LD DE, RouletteTypePtrs
 121+ 714B 19               ADD HL, DE
 122+ 714C 5E               LD E, (HL)
 123+ 714D 23               INC HL
 124+ 714E 56               LD D, (HL)
 125+ 714F EB               EX DE, HL                               ; HL = ptr
 126+ 7150 C9               RET
 127+ 7151              .grpiHealth:
 128+ 7151 21 52 75         LD HL, HealthVariantPtrs
 129+ 7154 C3 60 75         JP PickRandomVariantPtr                 ; tail call: HL=tabla -> HL=ptr
 130+ 7157              .grpiStamina:
