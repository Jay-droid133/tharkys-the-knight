 976+ E9FB 3E 02            LD A, 2                         ; track 2 = EndGame
 977+ E9FD C3 8F 6D         JP StartMusic_B7                   ; tail-call: musica empieza con el cartel
 978+ EA00 C9           SFX_TownGate_OnCredits:         RET ; (musica ya sonando desde "The End")
