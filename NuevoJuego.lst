 638+ 7423              ; ==============================================================================
 639+ 7423              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 640+ 7423              ; ==============================================================================
 641+ 7423              ; Se llama desde:
 642+ 7423              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 643+ 7423              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 644+ 7423              ;     por encima y los borro.
 645+ 7423              ;
 646+ 7423              ; Bypass total del day/night remap → respeta exactamente el patrón per-celda
 647+ 7423              ; que el BG editor exporta (ej: col1 bright + col2 dim). Lee los 4 attrs
 648+ 7423              ; ya extraídos por LoadSynthSpriteAndExtractAttr (RandomSynthAttr=TL,
 649+ 7423              ; RandomSynthAttrTR, RandomSynthAttrBL, RandomSynthAttrBR) y los pinta
 650+ 7423              ; 1:1 en VRAM.
 651+ 7423              ;
 652+ 7423              ; Pickup es 16x16 = 2x2 char attrs.
 653+ 7423              ; Early-out si RandomSynthMapX = $FE (no activo).
 654+ 7423              ; Destruye AF, BC, DE, HL.
 655+ 7423              ; ==============================================================================
 656+ 7423              PaintSynthPickupAttrs:
 657+ 7423 3A B4 5F         LD A, (RandomSynthMapX)
 658+ 7426 FE FE            CP $FE
 659+ 7428 C8               RET Z                               ; no activo
 660+ 7429                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 661+ 7429 3A B9 5F         LD A, (RandomSynthCharY)
 662+ 742C C6 02            ADD A, BG_Y_OFFSET
 663+ 742E 26 00            LD H, 0
 664+ 7430 6F               LD L, A
 665+ 7431 29               ADD HL, HL
 666+ 7432 29               ADD HL, HL
 667+ 7433 29               ADD HL, HL
 668+ 7434 29               ADD HL, HL
 669+ 7435 29               ADD HL, HL                          ; *32
 670+ 7436 3A B8 5F         LD A, (RandomSynthCharX)
 671+ 7439 85               ADD A, L
 672+ 743A 6F               LD L, A
 673+ 743B 30 01            JR NC, .pspaNoCarry
 674+ 743D 24               INC H
 675+ 743E              .pspaNoCarry:
 676+ 743E 11 00 58         LD DE, ATTR_BASE
 677+ 7441 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 678+ 7442                  ; --- Fila 0: TL, TR ---
 679+ 7442 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
 680+ 7445 77               LD (HL), A
 681+ 7446 23               INC HL
 682+ 7447 3A D6 5F         LD A, (RandomSynthAttrTR)
 683+ 744A 77               LD (HL), A
 684+ 744B                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
 685+ 744B 7D               LD A, L
 686+ 744C C6 1F            ADD A, 31
 687+ 744E 6F               LD L, A
 688+ 744F 30 01            JR NC, .pspaNoCarry2
 689+ 7451 24               INC H
 690+ 7452              .pspaNoCarry2:
 691+ 7452                  ; --- Fila 1: BL, BR ---
 692+ 7452 3A D7 5F         LD A, (RandomSynthAttrBL)
 693+ 7455 77               LD (HL), A
 694+ 7456 23               INC HL
 695+ 7457 3A D8 5F         LD A, (RandomSynthAttrBR)
 696+ 745A 77               LD (HL), A
 697+ 745B C9               RET
