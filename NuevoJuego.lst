 164+ F0EA              ; ==============================================================================
 165+ F0EA              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 166+ F0EA              ; ==============================================================================
 167+ F0EA              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 168+ F0EA              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 169+ F0EA              ; inmediato del valor actual.
 170+ F0EA              ; ==============================================================================
 171+ F0EA              CheckCurrentKeyCycleKey:
 172+ F0EA 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 173+ F0EC DB FE            IN A, ($FE)
 174+ F0EE CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 175+ F0F0 20 17            JR NZ, .ckcNotPressed
 176+ F0F2 3A 0E F1         LD A, (CurrentKeyCycleDebounce)
 177+ F0F5 B7               OR A
 178+ F0F6 C0               RET NZ
 179+ F0F7 3E 01            LD A, 1
 180+ F0F9 32 0E F1         LD (CurrentKeyCycleDebounce), A
 181+ F0FC 3A 49 82         LD A, (CurrentKey)
 182+ F0FF 3C               INC A
 183+ F100 FE 07            CP 7
 184+ F102 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 185+ F104 AF               XOR A                               ; 7 -> wrap a 0
 186+ F105              .ckcSet:
 187+ F105 32 49 82         LD (CurrentKey), A
 188+ F108 C9               RET
 189+ F109              .ckcNotPressed:
 190+ F109 AF               XOR A
 191+ F10A 32 0E F1         LD (CurrentKeyCycleDebounce), A
 192+ F10D C9               RET
 193+ F10E
 194+ F10E 00           CurrentKeyCycleDebounce: DEFB 0
