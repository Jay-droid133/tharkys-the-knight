 164+ 0000
 165+ 0000              ; --- Stamina / Salud ---
 166+ 0000              STAMINA_MAX         EQU 16          ; Nivel maximo (= 16 scanlines del HUD)
 167+ 0000              HEALTH_MAX          EQU 16
 168+ 0000              STAMINA_DRAIN_RATE  EQU 13          ; 13 frames a 25fps ~0.5s (era 25 a 50fps)
 169+ 0000              STAMINA_REGEN_RATE  EQU 25          ; 25 frames a 25fps = 1s (era 50 a 50fps)
 170+ 0000              HEALTH_REGEN_RATE   EQU 50          ; 50 frames a 25fps = 2s (era 100 a 50fps)
 171+ 0000              STAMINA_THRESHOLD_HIGH EQU 12       ; >= libre (continuo)
 172+ 0000              STAMINA_THRESHOLD_MID  EQU 7        ; >= fixed swing
 173+ 0000              STAMINA_THRESHOLD_LOW  EQU 3        ; >= cooldown corto
 174+ 0000              ; < LOW = cooldown largo + 1 punto recuperado tras cada cooldown
 175+ 0000              ATTACK_COOLDOWN_FRAMES EQU 10       ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
 176+ 0000              ATTACK_SWING_FRAMES EQU ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT ; Opcion C: = 1 ciclo de animacion
 177+ 0000              SCARE_FLEE_THRESHOLD EQU 50          ; 50 a 25fps (era 100 a 50fps)
 178+ 0000              SCARE_TIMER_BELLS EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 179+ 0000              SCARE_TIMER_DAWN  EQU 125           ; 125 a 25fps = ~5s (era 250 a 50fps)
 180+ 0000              FLEE_PLAYER_AVOID EQU 12            ; Pixeles de proximidad para evitar al player al huir
 181+ 0000              NEAR_ENTRY_DIST EQU 30              ; Distancia minima monster-entrada al restaurar room
 182+ 0000
 183+ 0000              ; --- Spawn system ---
 184+ 0000              SPAWN_INTERVAL  EQU 12              ; ~0.5s a 25fps (era 25 = 1s) — primer nasty post-transition
 185+ 0000                                                  ; (Gap entre spawns consecutivos = R AND 7 frames, 0-0.28s)
 186+ 0000
 187+ 0000              ; --- La muerte (TYPE_DEATH, slot 11) ---
 188+ 0000              DEATH_SPAWN_FRAMES   EQU 125         ; DEBUG: 5s a 25fps (final: 250 = 10s). Pausa con TimeFrozen=1.
 189+ 0000              DEATH_SPEED          EQU 1           ; 1 px por update; acumulador 1/2 -> mueve cada 2 frames
 190+ 0000              DEATH_STUCK_THRESHOLD EQU 6          ; Frames sin movimiento -> activar BFS rescue
 191+ 0000              DEATH_BFS_MAX_DEPTH  EQU 3           ; Profundidad max del mini-BFS (diamond ~25 cells)
 192+ 0000              DEATH_GHOST_FRAMES   EQU 125         ; DEBUG: 5s a 25fps (final: 375 = 15s) -> ghost mode (no collision)
 193+ 0000              DEATH_GHOST_SPEED    EQU SPEED_RUN   ; Velocidad ghost = SPEED_RUN del player (4 px/frame)
 194+ 0000              DEATH_MIN_SPAWN_DIST EQU 8           ; Min distancia BFS al player en cells. Evita instakill en cul-de-sac.
 195+ 0000
 196+ 0000              ; --- Well cooldown tras curar (modo prueba; ajustar al gusto) ---
 197+ 0000              WELL_COOLDOWN_FRAMES  EQU 125        ; 5 s @ 25 fps
 198+ 0000              WELL_COOLDOWN_ATTR_L  EQU $78        ; Celda inferior-izq: BRIGHT + PAPER WHITE
 199+ 0000              WELL_COOLDOWN_ATTR_R  EQU $38        ; Celda inferior-der: PAPER WHITE (sin bright)
 200+ 0000
 201+ 0000              ; --- Round-robin (estilo Sabre Wulf) ---
 202+ 0000              MAX_ENEMIES_PER_FRAME EQU 2         ; Enemigos procesados por frame (erase+logic+draw combinados)
 203+ 0000
