4294+ BA0C 0F               RRCA
4295+ BA0D 0F               RRCA
4296+ BA0E 0F               RRCA
4297+ BA0F E6 1F            AND $1F
4298+ BA11 D6 02            SUB BG_Y_OFFSET
4299+ BA13 47               LD B, A                         ; B = charYhi
4300+ BA14 3A 57 BA         LD A, (.ecYlo)
4301+ BA17 ED 44            NEG
4302+ BA19 80               ADD A, B
4303+ BA1A 3C               INC A                           ; height_chars
4304+ BA1B 32 59 BA         LD (.ecHc), A
