1825+ ACE4              .sameAnim:
1826+ ACE4                  ; Decrementar timer
1827+ ACE4 DD 35 09         DEC (IX+ENT_ANIMTIMER)
1828+ ACE7 C0               RET NZ
1829+ ACE8
1830+ ACE8                  ; Timer expirado → avanzar frame
1831+ ACE8 DD 71 09         LD (IX+ENT_ANIMTIMER), C    ; Reset timer
1832+ ACEB
1833+ ACEB                  ; Paso: si el player esta corriendo, reproducir "tic-tac" alternado
1834+ ACEB DD 7E 02         LD A, (IX+ENT_STATE)
1835+ ACEE FE 01            CP STATE_RUNNING
1836+ ACF0 20 17            JR NZ, .noFootstep
1837+ ACF2 3A 5A 90         LD A, (FootstepToggle)
1838+ ACF5 EE 01            XOR 1
1839+ ACF7 32 5A 90         LD (FootstepToggle), A
1840+ ACFA C5               PUSH BC
1841+ ACFB D5               PUSH DE
1842+ ACFC 21 8A F1         LD HL, SFX_FootstepTic
1843+ ACFF 20 03            JR NZ, .playStep
1844+ AD01 21 8F F1         LD HL, SFX_FootstepTac
1845+ AD04              .playStep:
1846+ AD04 CD 1E F1         CALL PlaySFX
1847+ AD07 D1               POP DE
1848+ AD08 C1               POP BC
1849+ AD09              .noFootstep:
1850+ AD09
1851+ AD09 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1852+ AD0C 3C               INC A
1853+ AD0D                  ; ¿Fuera de rango?
1854+ AD0D 47               LD B, A                     ; B = nuevo SpriteID
1855+ AD0E 92               SUB D                       ; A = frame relativo (nuevo - animBase)
1856+ AD0F BB               CP E                        ; ¿>= num_frames?
1857+ AD10 38 20            JR C, .frameOk
1858+ AD12 42               LD B, D                     ; Reset al AnimBase
1859+ AD13                  ; Si es animacion de ataque → SFX en wrap (si no sono ya este ciclo)
1860+ AD13 7A               LD A, D
1861+ AD14 FE 16            CP SPRID_ATTACK_EAST
1862+ AD16 28 04            JR Z, .checkWrapSfx
1863+ AD18 FE 1B            CP SPRID_ATTACK_WEST
1864+ AD1A 20 16            JR NZ, .frameOk
