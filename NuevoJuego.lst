7564+ C934              ; ==============================================================================
7565+ C934              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7566+ C934              ; ==============================================================================
7567+ C934              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7568+ C934              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7569+ C934              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7570+ C934              ; ==============================================================================
7571+ C934              ; ==============================================================================
7572+ C934              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7573+ C934              ; ==============================================================================
7574+ C934              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7575+ C934              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7576+ C934              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7577+ C934              ; los pone a su default.
7578+ C934              ; ==============================================================================
7579+ C934              InitGameState:
7580+ C934 3E 03            LD A, PLAYER_LIVES_INIT
7581+ C936 32 D7 82         LD (PlayerLives), A
7582+ C939 3E 10            LD A, HEALTH_MAX
7583+ C93B 32 4B B3         LD (PlayerHealth), A
