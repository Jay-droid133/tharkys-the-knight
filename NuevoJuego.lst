 251+ 851F              ; ==============================================================================
 252+ 851F              SaveEntityAttr:
 253+ 851F                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 254+ 851F DD 7E 00         LD A, (IX+0)                ; width_bytes
 255+ 8522 47               LD B, A
 256+ 8523 7B               LD A, E                     ; X pixel (raw)
 257+ 8524 E6 07            AND 7
 258+ 8526 28 01            JR Z, .noExtraW
 259+ 8528 04               INC B                       ; +1 columna si no alineado
 260+ 8529              .noExtraW:
 261+ 8529 78               LD A, B
 262+ 852A 32 8F 85         LD (EntityAttrW), A
 263+ 852D
 264+ 852D                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 265+ 852D 7A               LD A, D                     ; Y pixel (raw)
 266+ 852E E6 07            AND 7                       ; Y offset dentro del char
 267+ 8530 4F               LD C, A
 268+ 8531 DD 7E 01         LD A, (IX+1)                ; height_pixels
 269+ 8534 81               ADD A, C                    ; + Y offset
 270+ 8535 C6 07            ADD A, 7
 271+ 8537 0F               RRCA
 272+ 8538 0F               RRCA
 273+ 8539 0F               RRCA
 274+ 853A E6 1F            AND $1F                     ; / 8 = height_chars
 275+ 853C 32 90 85         LD (EntityAttrH), A
 276+ 853F
 277+ 853F CD F9 86         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 278+ 8542 11 7F 85         LD DE, EntitySavedAttr      ; DE = buffer destino
 279+ 8545
 280+ 8545 3A 90 85         LD A, (EntityAttrH)
 281+ 8548 4F               LD C, A                     ; C = filas
 282+ 8549              .saveRow:
 283+ 8549 3A 8F 85         LD A, (EntityAttrW)
