 924+ B325              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
 925+ B325              ; ==============================================================================
 926+ B325              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
 927+ B325              ; Salida:  IX = primer byte tras pixel data (tintPaper)
 928+ B325              ; Modifica: AF, BC, DE, HL
 929+ B325              ; ==============================================================================
 930+ B325              SkipPixelData:
 931+ B325 DD 7E 00         LD A, (IX+0)                ; height_px
 932+ B328 57               LD D, A                     ; D = height_px
 933+ B329 DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
 934+ B32C 5F               LD E, A                     ; E = raw value con flag
