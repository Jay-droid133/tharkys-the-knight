1300+ D3C3                  ; --- Path literal: saltar height * width bytes ---
1301+ D3C3 7B               LD A, E                     ; width_bytes (sin flag, bit7=0)
1302+ D3C4              .spLitRow:
1303+ D3C4 47               LD B, A
1304+ D3C5              .spLitCol:
