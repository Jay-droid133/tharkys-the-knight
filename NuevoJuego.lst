1264+ D68C 57               LD D, A                     ; D = height_px
1265+ D68D DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
1266+ D690 5F               LD E, A                     ; E = raw value con flag
