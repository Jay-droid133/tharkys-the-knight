 560+ 6924              ; ==============================================================================
 561+ 6924              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 562+ 6924              ; ==============================================================================
 563+ 6924              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 564+ 6924              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 565+ 6924              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 566+ 6924              ;   2. Leer charX/charY de la entry
 567+ 6924              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 568+ 6924              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 569+ 6924              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 570+ 6924              ;   6. ChurchDoorOpen = 0
 571+ 6924              ; ==============================================================================
 572+ 6924              CloseChurchDoor:
 573+ 6924                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
 574+ 6924                  ; ambos sentidos). Suena ANTES del cambio visual.
 575+ 6924 21 4A F9         LD HL, SFX_ChurchDoorOpen
 576+ 6927 CD 33 F8         CALL PlaySFX
 577+ 692A 11 BE E2         LD DE, BgGfx_old_church_door_open
 578+ 692D CD B7 69         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 579+ 6930 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 580+ 6932                  ; Leer charX (HL+4) y charY (HL+5) en BC
 581+ 6932 E5               PUSH HL                                 ; save mapX ptr
 582+ 6933 01 04 00         LD BC, 4
 583+ 6936 09               ADD HL, BC
 584+ 6937 46               LD B, (HL)                              ; B = charX
 585+ 6938 23               INC HL
 586+ 6939 4E               LD C, (HL)                              ; C = charY
 587+ 693A E1               POP HL                                  ; HL = mapX ptr
 588+ 693B                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 589+ 693B E5               PUSH HL
 590+ 693C C5               PUSH BC
 591+ 693D 21 BE E2         LD HL, BgGfx_old_church_door_open
 592+ 6940 3E 03            LD A, 3
 593+ 6942 CD 41 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
 594+ 6945 C1               POP BC
 595+ 6946 C5               PUSH BC
 596+ 6947 DD 21 7C 89      LD IX, BgSpriteBuffer
 597+ 694B CD B5 DD         CALL DrawBgSpriteXOR                    ; borra
 598+ 694E C1               POP BC
 599+ 694F E1               POP HL
 600+ 6950                  ; --- Patch ptr: open -> closed ---
 601+ 6950 23               INC HL
 601+ 6951 23             INC HL                         ; -> ptr_lo
 602+ 6952 3E 05            LD A, LOW BgGfx_old_church_door_closed
 603+ 6954 77               LD (HL), A
 604+ 6955 23               INC HL
 605+ 6956 3E E2            LD A, HIGH BgGfx_old_church_door_closed
 606+ 6958 77               LD (HL), A
 607+ 6959                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 608+ 6959 C5               PUSH BC
 609+ 695A 21 05 E2         LD HL, BgGfx_old_church_door_closed
 610+ 695D 3E 03            LD A, 3
 611+ 695F CD 41 6A         CALL LoadBgSpriteToBuffer
 612+ 6962 C1               POP BC
 613+ 6963 C5               PUSH BC
 614+ 6964 DD 21 7C 89      LD IX, BgSpriteBuffer
 615+ 6968 CD B5 DD         CALL DrawBgSpriteXOR
 616+ 696B C1               POP BC
 617+ 696C DD 21 7C 89      LD IX, BgSpriteBuffer
 618+ 6970 AF               XOR A
 619+ 6971 32 98 E4         LD (BgSpriteIsHouse), A
 620+ 6974 CD FA DD         CALL DrawBgAttrOnly
 621+ 6977              .ccdFlag:
 622+ 6977 AF               XOR A
 623+ 6978 32 4C 82         LD (ChurchDoorOpen), A
 624+ 697B C9               RET
