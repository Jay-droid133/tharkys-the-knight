 658+ 63C7              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 659+ 63C7              ; ==============================================================================
 660+ 63C7              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 661+ 63C7              ;    al haberse dibujado ya en el render normal de la sala).
 662+ 63C7              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 63C7              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 63C7              ; Bank 3 para ambos (sprites baseline town).
 665+ 63C7              ; Destruye: AF, BC, DE, HL, IX.
 666+ 63C7              ; ==============================================================================
 667+ 63C7              TownGateOpenDoor:
 668+ 63C7 11 AA E2         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 63CA CD 64 D7         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 63CD                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 63CD
 672+ 63CD              ; ==============================================================================
 673+ 63CD              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 63CD              ; ==============================================================================
 675+ 63CD              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 63CD              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 63CD              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 63CD              ; ==============================================================================
 679+ 63CD              TownGateRedrawOpenDoor:
 680+ 63CD 21 69 E6         LD HL, BgGfx_town_gate_door_open
 681+ 63D0 3E 03            LD A, 3
 682+ 63D2 CD C2 6A         CALL LoadBgSpriteToBuffer
 683+ 63D5 DD 21 F8 86      LD IX, BgSpriteBuffer
 684+ 63D9 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 63DB 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 63DD AF               XOR A
 687+ 63DE 32 2B E2         LD (BgSpriteIsHouse), A
 688+ 63E1 32 F4 D1         LD (CurrentTintVar), A
 689+ 63E4 C3 EA D0         JP DrawBgGfxSprite
 690+ 63E7
 691+ 63E7              ; ==============================================================================
 692+ 63E7              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 63E7              ; ==============================================================================
 694+ 63E7              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 63E7              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 63E7              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 63E7              ; Destruye: A, BC, DE, IX.
 698+ 63E7              ; ==============================================================================
 699+ 63E7              TownGateAllNastiesDeadCheck:
 700+ 63E7 DD 21 0E 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63EB 06 04            LD B, NUM_NASTIES
 702+ 63ED              .tgandcLoop:
 703+ 63ED DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 63F0 B7               OR A
 705+ 63F1 C0               RET NZ                              ; algun nasty aun activo
 706+ 63F2 11 10 00         LD DE, ENT_SIZE
 707+ 63F5 DD 19            ADD IX, DE
 708+ 63F7 10 F4            DJNZ .tgandcLoop
 709+ 63F9 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 63FA C9               RET
 711+ 63FB
 712+ 63FB              ; ==============================================================================
 713+ 63FB              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63FB              ; ==============================================================================
 715+ 63FB              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63FB              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63FB              ; y abajo se dibujan normal (XOR).
 718+ 63FB              ;
 719+ 63FB              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63FB              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63FB              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63FB              ;   inferiores que pasan tras el lintel skipped.
 723+ 63FB              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63FB              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63FB              ;   lintel skipped.
 726+ 63FB              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63FB              ;
 728+ 63FB              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63FB              ;     Bank 6 paginado al entrar (caller).
 730+ 63FB              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63FB              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63FB              ; ==============================================================================
 733+ 63FB              PLAYER_H_PX              EQU 21
 734+ 63FB
 735+ 63FB              TownGatePlayerXOR_BiClip:
 736+ 63FB FD 23            INC IY
 737+ 63FD FD 23            INC IY                              ; skip header
 738+ 63FF D5               PUSH DE
 739+ 6400 CD 5D 9D         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 6403 D1               POP DE
 741+ 6404 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 6406 4A               LD C, D                             ; C = current pixel Y
 743+ 6407              .tgpxbcRow:
 744+ 6407 79               LD A, C
 745+ 6408 FE C0            CP 192
 746+ 640A 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 640C                                                      ; (sin este clip, NextPixelLine lleva
 748+ 640C                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 640C                                                      ; corrompe attrs como flashes raros).
 750+ 640C FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 640E 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 6410 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 6412 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 6414                  ; In [120, 151] → skip pixels en esta row
 755+ 6414 18 0C            JR .tgpxbcAdvance
 756+ 6416              .tgpxbcDraw:
 757+ 6416                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 6416                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 6416 FD 7E 00         LD A, (IY+0)
 760+ 6419 AE               XOR (HL)
 761+ 641A 77               LD (HL), A
 762+ 641B 23               INC HL
 763+ 641C FD 7E 01         LD A, (IY+1)
 764+ 641F AE               XOR (HL)
 765+ 6420 77               LD (HL), A
 766+ 6421 2B               DEC HL                              ; back to row start
 767+ 6422              .tgpxbcAdvance:
 768+ 6422 FD 23            INC IY
 769+ 6424 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 6426 0C               INC C                               ; pixel Y += 1
 771+ 6427 C5               PUSH BC
 772+ 6428 CD C9 9A         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 642B C1               POP BC
 774+ 642C 10 D9            DJNZ .tgpxbcRow
 775+ 642E C9               RET
 776+ 642F
 777+ 642F              ; ==============================================================================
 778+ 642F              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 642F              ; ==============================================================================
 780+ 642F              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 642F              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 642F              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 642F              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 642F              ; ==============================================================================
 785+ 642F              TownGatePlayerSlideErase:
 786+ 642F DD 21 9E 81      LD IX, EntityTable
 787+ 6433 DD E5            PUSH IX
 788+ 6435 CD F7 A4         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6438 DD E1            POP IX
 790+ 643A 3A 85 8D         LD A, (CurrentPaging)
 791+ 643D E6 F8            AND $F8
 792+ 643F F6 06            OR 6
 793+ 6441 32 85 8D         LD (CurrentPaging), A
 794+ 6444 01 FD 7F         LD BC, $7FFD
 795+ 6447 ED 79            OUT (C), A
 796+ 6449 FD 2A 7F A4      LD IY, (OldSprAddr)
 797+ 644D DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 6450 DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 6453 5F               LD E, A
 800+ 6454 CD FB 63         CALL TownGatePlayerXOR_BiClip
 801+ 6457 3A 85 8D         LD A, (CurrentPaging)
 802+ 645A E6 F8            AND $F8
 803+ 645C 32 85 8D         LD (CurrentPaging), A
 804+ 645F 01 FD 7F         LD BC, $7FFD
 805+ 6462 ED 79            OUT (C), A
 806+ 6464 C9               RET
 807+ 6465
 808+ 6465              TownGatePlayerSlideDraw:
 809+ 6465 DD 21 9E 81      LD IX, EntityTable
 810+ 6469 DD E5            PUSH IX
 811+ 646B CD C6 A4         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 646E DD E1            POP IX
 813+ 6470 3A 85 8D         LD A, (CurrentPaging)
 814+ 6473 E6 F8            AND $F8
 815+ 6475 F6 06            OR 6
 816+ 6477 32 85 8D         LD (CurrentPaging), A
 817+ 647A 01 FD 7F         LD BC, $7FFD
 818+ 647D ED 79            OUT (C), A
 819+ 647F FD 2A F5 A4      LD IY, (SpriteAddrTemp)
 820+ 6483 3A DF 82         LD A, (PlayerDrawY)
 821+ 6486 57               LD D, A
 822+ 6487 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 648A 5F               LD E, A
 824+ 648B CD FB 63         CALL TownGatePlayerXOR_BiClip
 825+ 648E 3A 85 8D         LD A, (CurrentPaging)
 826+ 6491 E6 F8            AND $F8
 827+ 6493 32 85 8D         LD (CurrentPaging), A
 828+ 6496 01 FD 7F         LD BC, $7FFD
 829+ 6499 ED 79            OUT (C), A
 830+ 649B                  ; Update OLD = current
 831+ 649B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 649E DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 64A1 3A DF 82         LD A, (PlayerDrawY)
 834+ 64A4 DD 77 0D         LD (IX+ENT_OLDY), A
 835+ 64A7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 836+ 64AA DD 77 0E         LD (IX+ENT_OLDSPRID), A
 837+ 64AD C9               RET
