1273+ F62E              ; ==============================================================================
1274+ F62E              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1275+ F62E              ; ==============================================================================
1276+ F62E              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1277+ F62E              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1278+ F62E              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1279+ F62E              ; ==============================================================================
1280+ F62E              ChurchCutsceneInitStatueShake:
1281+ F62E 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1282+ F631 21 67 67         LD HL, StatueIdTable
1283+ F634 5F               LD E, A
1284+ F635 16 00            LD D, 0
1285+ F637 19               ADD HL, DE
1286+ F638 7E               LD A, (HL)                              ; A = statue id
1287+ F639 B7               OR A
1288+ F63A C8               RET Z                                   ; sin estatua
1289+ F63B 32 6B F6         LD (.cisTargetId), A
1290+ F63E                  ; Buscar en CurrentScreenBuffer
1291+ F63E 2A AF 82         LD HL, (CurrentScreenAddr)
1292+ F641              .cisLoop:
1293+ F641 7E               LD A, (HL)
1294+ F642 FE FF            CP $FF
1295+ F644 C8               RET Z                                   ; no encontrada (no se hace shake)
1296+ F645 47               LD B, A
1297+ F646 3A 6B F6         LD A, (.cisTargetId)
1298+ F649 B8               CP B
1299+ F64A 28 06            JR Z, .cisFound
1300+ F64C 11 04 00         LD DE, 4
1301+ F64F 19               ADD HL, DE
1302+ F650 18 EF            JR .cisLoop
1303+ F652              .cisFound:
1304+ F652 23               INC HL
1305+ F653 7E               LD A, (HL)                              ; charX
1306+ F654                  ; Pixel X = charX * 8
1307+ F654 87               ADD A, A
1308+ F655 87               ADD A, A
1309+ F656 87               ADD A, A
1310+ F657 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1311+ F65A 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1312+ F65D 23               INC HL
1313+ F65E 7E               LD A, (HL)                              ; charY
1314+ F65F                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1315+ F65F C6 02            ADD A, BG_Y_OFFSET
1316+ F661 87               ADD A, A
1317+ F662 87               ADD A, A
1318+ F663 87               ADD A, A
1319+ F664 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1320+ F667 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1321+ F66A C9               RET
1322+ F66B 00           .cisTargetId: DEFB 0
