 107  DB2C                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ DB2C              ; ==============================================================================
   2+ DB2C              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ DB2C              ; ==============================================================================
   4+ DB2C              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ DB2C              ; Para cada shift S:
   6+ DB2C              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ DB2C              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ DB2C              ;
   9+ DB2C              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ DB2C              ;
  11+ DB2C              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ DB2C              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ DB2C              ;
  14+ DB2C              ; Calculo de B desde X%8:
  15+ DB2C              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ DB2C              ; ==============================================================================
  17+ DB2C
  18+ DB2C 00 00 00...      ALIGN 256
  19+ DC00              ShiftTables:
  20+ DC00                  LUA ALLPASS
  21+ DC00 ~                for shift = 1, 7 do
  22+ DC00 ~                    -- High part: byte >> shift
  23+ DC00 ~                    for i = 0, 255 do
  24+ DC00 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ DC00 ~                    end
  26+ DC00 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ DC00 ~                    for i = 0, 255 do
  28+ DC00 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ DC00 ~                    end
  30+ DC00 ~                end
