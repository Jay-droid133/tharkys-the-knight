 545+ EAF2                  ; --- Sprite ptr de CompassSprites[idx] ---
 546+ EAF2 3A 22 EB         LD A, (.dcSpriteIdx)
 547+ EAF5 87               ADD A, A                            ; *2
 548+ EAF6 6F               LD L, A
 549+ EAF7 26 00            LD H, 0
 550+ EAF9 11 8A F2         LD DE, CompassSprites
 551+ EAFC 19               ADD HL, DE
