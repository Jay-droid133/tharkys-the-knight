 192+ 6B28              ; ==============================================================================
 193+ 6B28              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 6B28              ; ==============================================================================
 195+ 6B28              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 6B28              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 6B28              ; ==============================================================================
 198+ 6B28              _AY_WriteRegPairs:
 199+ 6B28 7E               LD A, (HL)
 200+ 6B29 FE FF            CP $FF
 201+ 6B2B 28 0D            JR Z, .awrpDone
 202+ 6B2D 06 FF            LD B, $FF
 203+ 6B2F ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 6B31 23               INC HL
 205+ 6B32 06 BF            LD B, $BF
 206+ 6B34 7E               LD A, (HL)
 207+ 6B35 ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 6B37 23               INC HL
 209+ 6B38 18 EE            JR _AY_WriteRegPairs
 210+ 6B3A              .awrpDone:
 211+ 6B3A FB               EI
 212+ 6B3B C9               RET
 213+ 6B3C
 214+ 6B3C              ; ==============================================================================
 215+ 6B3C              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 6B3C              ; ==============================================================================
 217+ 6B3C              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 6B3C              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 6B3C              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 6B3C              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 6B3C              ; (con IFF=0), no hay race.
 222+ 6B3C              ;
 223+ 6B3C              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 6B3C              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 6B3C              ; Destruye: A, BC, DE, HL.
 226+ 6B3C              ; ==============================================================================
 227+ 6B3C              AY_UpdatePlayerHit:
 228+ 6B3C                  ; --- PendingPin tick: dispara beep diferido (lasting compass stage 2) ---
 229+ 6B3C                  ; Cuando AY_PlayLastingPickup arma una "PIN" tras el sweep, el ticker la
 230+ 6B3C                  ; dispara cuando el contador llega a 0. Escritura R2/R3/R9 inline (sin
 231+ 6B3C                  ; DI/EI: ya en contexto IRQ). Tras setear BeepDurationFrames el cutoff
 232+ 6B3C                  ; lo gestiona el path .uphCheckBeep en proximos ticks.
 233+ 6B3C 3A CC 6B         LD A, (PendingPinTimer)
 234+ 6B3F B7               OR A
 235+ 6B40 28 34            JR Z, .uphAfterPin
 236+ 6B42 3D               DEC A
 237+ 6B43 32 CC 6B         LD (PendingPinTimer), A
 238+ 6B46 20 2E            JR NZ, .uphAfterPin
 239+ 6B48 2A CD 6B         LD HL, (PendingPinPeriod)
 240+ 6B4B 0E FD            LD C, $FD
 241+ 6B4D 3E 02            LD A, 2
 242+ 6B4F 06 FF            LD B, $FF
 243+ 6B51 ED 79            OUT (C), A
 244+ 6B53 7D               LD A, L
 245+ 6B54 06 BF            LD B, $BF
 246+ 6B56 ED 79            OUT (C), A
 247+ 6B58 3E 03            LD A, 3
 248+ 6B5A 06 FF            LD B, $FF
 249+ 6B5C ED 79            OUT (C), A
 250+ 6B5E 7C               LD A, H
 251+ 6B5F 06 BF            LD B, $BF
 252+ 6B61 ED 79            OUT (C), A
 253+ 6B63 3E 09            LD A, 9
 254+ 6B65 06 FF            LD B, $FF
 255+ 6B67 ED 79            OUT (C), A
 256+ 6B69 3E 0F            LD A, $0F                           ; vol max canal B
 257+ 6B6B 06 BF            LD B, $BF
 258+ 6B6D ED 79            OUT (C), A
 259+ 6B6F 3A CF 6B         LD A, (PendingPinFrames)
 260+ 6B72 32 A4 6A         LD (BeepDurationFrames), A          ; arma cutoff
 261+ 6B75 C9               RET                                 ; skip resto del ticker este frame
 262+ 6B76              .uphAfterPin:
 263+ 6B76 3A 9F 6A         LD A, (PlayerHitFrames)
 264+ 6B79 B7               OR A
 265+ 6B7A 28 2A            JR Z, .uphCheckBeep
 266+ 6B7C 3D               DEC A
 267+ 6B7D 32 9F 6A         LD (PlayerHitFrames), A
 268+ 6B80 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 269+ 6B82
 270+ 6B82 2A A0 6A         LD HL, (PlayerHitPeriod)
 271+ 6B85 ED 5B A2 6A      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 272+ 6B89 19               ADD HL, DE
 273+ 6B8A 22 A0 6A         LD (PlayerHitPeriod), HL
 274+ 6B8D
 275+ 6B8D                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 276+ 6B8D 0E FD            LD C, $FD
 277+ 6B8F 3E 02            LD A, 2
 278+ 6B91 06 FF            LD B, $FF
 279+ 6B93 ED 79            OUT (C), A
 280+ 6B95 7D               LD A, L
 281+ 6B96 06 BF            LD B, $BF
 282+ 6B98 ED 79            OUT (C), A
 283+ 6B9A 3E 03            LD A, 3
 284+ 6B9C 06 FF            LD B, $FF
 285+ 6B9E ED 79            OUT (C), A
 286+ 6BA0 7C               LD A, H
 287+ 6BA1 06 BF            LD B, $BF
 288+ 6BA3 ED 79            OUT (C), A
 289+ 6BA5 C9               RET
 290+ 6BA6
 291+ 6BA6              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 292+ 6BA6              .uphCheckBeep:
 293+ 6BA6 3A A4 6A         LD A, (BeepDurationFrames)
 294+ 6BA9 B7               OR A
 295+ 6BAA C8               RET Z
 296+ 6BAB 3D               DEC A
 297+ 6BAC 32 A4 6A         LD (BeepDurationFrames), A
 298+ 6BAF C0               RET NZ
 299+ 6BB0                  ; fall-through al cutoff compartido
 300+ 6BB0
 301+ 6BB0              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 302+ 6BB0              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 303+ 6BB0              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 304+ 6BB0              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 305+ 6BB0              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 306+ 6BB0              _uphMuteR9:
 307+ 6BB0 01 FD FF         LD BC, $FFFD
 308+ 6BB3 3E 09            LD A, 9
 309+ 6BB5 ED 79            OUT (C), A
 310+ 6BB7 01 FD BF         LD BC, $BFFD
 311+ 6BBA AF               XOR A
 312+ 6BBB ED 79            OUT (C), A
 313+ 6BBD                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 314+ 6BBD 01 FD FF         LD BC, $FFFD
 315+ 6BC0 3E 07            LD A, 7
 316+ 6BC2 ED 79            OUT (C), A
 317+ 6BC4 01 FD BF         LD BC, $BFFD
 318+ 6BC7 3E 38            LD A, $38
 319+ 6BC9 ED 79            OUT (C), A
 320+ 6BCB C9               RET
 321+ 6BCC
 322+ 6BCC              ; AchievementJingle ELIMINADO: el chime de "llegar a la sala del hito" ahora
 323+ 6BCC              ; reusa AY_PlayCompassPickup (mismo sweep que el pickup del magic compass
 324+ 6BCC              ; random). Libera ~80 B en slot 1 y unifica el feedback "evento positivo de
 325+ 6BCC              ; navegacion" con un unico sonido.
 326+ 6BCC
 327+ 6BCC              ; ==============================================================================
 328+ 6BCC              ; CompassPickup SFX (random + lasting) - sweeps tipo PlayerHit/Death
 329+ 6BCC              ; ==============================================================================
 330+ 6BCC              ; Reusan _AY_PlaySweep (sweep continuo de pitch en canal B AY, no bloqueante,
 331+ 6BCC              ; cutoff abrupto al final via _uphMuteR9). Llamados desde ApplyMagicCompassBuff
 332+ 6BCC              ; segun MagicCompassPermanent: random -> AY_PlayCompassPickup (solo sweep),
 333+ 6BCC              ; lasting -> AY_PlayLastingPickup (sweep + PIN sostenido tipo "WHHIII-PIN").
 334+ 6BCC              ;
 335+ 6BCC              ; Direccion del sweep: GRAVE -> AGUDO ("found it!" feel). Period inicial alto,
 336+ 6BCC              ; delta NEGATIVO en two's complement ($FFE8 = -24 etc). _AY_PlaySweep usa
 337+ 6BCC              ; ADD HL, DE asi que el wrap unsigned funciona como resta.
 338+ 6BCC              ; ==============================================================================
 339+ 6BCC
 340+ 6BCC              ; Random compass: sweep ascendente ~640 ms (16 frames)
 341+ 6BCC              ;   $0200 (210 Hz, B3) -> $0080 (853 Hz, A5) — 2 octavas
 342+ 6BCC              COMPASS_SWEEP_PERIOD_INIT  EQU $0200
 343+ 6BCC              COMPASS_SWEEP_FRAMES       EQU 16
 344+ 6BCC              COMPASS_SWEEP_DELTA        EQU $FFE8         ; -24/frame
 345+ 6BCC
 346+ 6BCC              ; Lasting compass: sweep ascendente ~880 ms (22 frames) + PIN sostenido
 347+ 6BCC              ;   Sweep: $0300 (140 Hz, D3) -> $0040 (1700 Hz, ~A6) — 3+ octavas
 348+ 6BCC              ;   PIN: $0030 (~2270 Hz) por 6 frames (240 ms), 1 frame despues del sweep
 349+ 6BCC              LASTING_SWEEP_PERIOD_INIT  EQU $0300
 350+ 6BCC              LASTING_SWEEP_FRAMES       EQU 22
 351+ 6BCC              LASTING_SWEEP_DELTA        EQU $FFE0         ; -32/frame
 352+ 6BCC              LASTING_PIN_PERIOD         EQU $0030         ; ~2270 Hz, muy brillante
 353+ 6BCC              LASTING_PIN_FRAMES         EQU 6             ; 240 ms
 354+ 6BCC              LASTING_PIN_DELAY          EQU LASTING_SWEEP_FRAMES + 1   ; fire 1 frame tras cutoff
 355+ 6BCC
 356+ 6BCC              ; State del PIN diferido (tickeado por AY_UpdatePlayerHit)
 357+ 6BCC 00           PendingPinTimer:    DEFB 0       ; >0 = pendiente; 0 = nada
 358+ 6BCD 00 00        PendingPinPeriod:   DEFW 0       ; period AY canal B
 359+ 6BCF 00           PendingPinFrames:   DEFB 0       ; duracion del beep tras dispararse
 360+ 6BD0
 361+ 6BD0              ; AY_PlayCompassPickup - magic compass random
 362+ 6BD0              AY_PlayCompassPickup:
 363+ 6BD0 21 00 02         LD HL, COMPASS_SWEEP_PERIOD_INIT
 364+ 6BD3 06 10            LD B, COMPASS_SWEEP_FRAMES
 365+ 6BD5 11 E8 FF         LD DE, COMPASS_SWEEP_DELTA
 366+ 6BD8 C3 B7 6A         JP _AY_PlaySweep                  ; tail call
 367+ 6BDB
 368+ 6BDB              ; AY_PlayLastingPickup - lasting compass: sweep + PIN encadenado
 369+ 6BDB              AY_PlayLastingPickup:
 370+ 6BDB 21 00 03         LD HL, LASTING_SWEEP_PERIOD_INIT
 371+ 6BDE 06 16            LD B, LASTING_SWEEP_FRAMES
 372+ 6BE0 11 E0 FF         LD DE, LASTING_SWEEP_DELTA
 373+ 6BE3 CD B7 6A         CALL _AY_PlaySweep
 374+ 6BE6                  ; Encolar PIN (beep agudo final) para que dispare 1 frame tras el sweep
 375+ 6BE6 21 30 00         LD HL, LASTING_PIN_PERIOD
 376+ 6BE9 22 CD 6B         LD (PendingPinPeriod), HL
 377+ 6BEC 3E 06            LD A, LASTING_PIN_FRAMES
 378+ 6BEE 32 CF 6B         LD (PendingPinFrames), A
 379+ 6BF1 3E 17            LD A, LASTING_PIN_DELAY
 380+ 6BF3 32 CC 6B         LD (PendingPinTimer), A
 381+ 6BF6 C9               RET
 382+ 6BF7
# file closed: sfx_player_hit_ay.asm
 161  6BF7
 162  6BF7                  ; --- Random pickups: thunks slot 1 (random_pickups.asm body en bank 7) ---
 163  6BF7                  ; Movido a bank 7 para liberar slot 1 (~1.1 KB neto). Aqui solo viven los
 164  6BF7                  ; 9 entry thunks que paginan bank 7 + SP swap a alt_stack compartido con
 165  6BF7                  ; bank_cutscene, mas 3 _B7 wrappers nuevos (SkipPixelData/RestorePickupAttrs/
 166  6BF7                  ; ApplyMagicCompassBuff). Body en INCLUDE en PAGE 7 mas abajo.
 167  6BF7                  INCLUDE "random_pickups_thunks.asm"
# file opened: random_pickups_thunks.asm
   1+ 6BF7              ; ==============================================================================
   2+ 6BF7              ; random_pickups_thunks.asm - Wrappers slot 1 para random_pickups.asm en bank 7
   3+ 6BF7              ; ==============================================================================
   4+ 6BF7              ; random_pickups.asm vivia en slot 1 ($6BF7..$70E4, ~1.26 KB). Movido a bank 7
   5+ 6BF7              ; para liberar slot 1 (donde RoomCompGapsTable y la IM2 table compiten por el
   6+ 6BF7              ; espacio anterior a $7A00). El movimiento libera ~1.1 KB neto en slot 1.
   7+ 6BF7              ;
   8+ 6BF7              ; Body bank 7 expone 9 entry points externos. Aqui se exponen como thunks que
   9+ 6BF7              ; comparten un shell de SP swap + page switch para minimizar bytes en slot 1.
  10+ 6BF7              ;
  11+ 6BF7              ; Reutiliza de bank_cutscene_thunks.asm (slot 1, ya incluido en main.asm):
  12+ 6BF7              ;   - _PageBank0 / _PageBank7
  13+ 6BF7              ;   - BankCutsceneAltStackTop
  14+ 6BF7              ;   - LoadBgSpriteToBuffer_B7
  15+ 6BF7              ;   - DrawBgSpriteXOR_B7
  16+ 6BF7              ;   - PlaySFX_B7
  17+ 6BF7              ;
  18+ 6BF7              ; Nuevos _B7 wrappers (slot 1, para usar desde body en bank 7):
  19+ 6BF7              ;   - SkipPixelData_B7        (bank 0)
  20+ 6BF7              ;   - RestorePickupAttrs_B7   (bank 0)
  21+ 6BF7              ;   - ApplyMagicCompassBuff_B7 (slot 1, wrap por seguridad — llama helpers bank 0)
  22+ 6BF7              ;
  23+ 6BF7              ; CRITICO: stack normal en slot 3 (bank 0 paginable). Los thunks hacen SP swap
  24+ 6BF7              ; a BankCutsceneAltStackTop antes del page switch. Compartido secuencialmente
  25+ 6BF7              ; con bank_cutscene/town_gate thunks dentro del mismo frame — no conflicto
  26+ 6BF7              ; porque son single-threaded (Z80 + IRQ handler en slot 1 que no toca slot 3).
  27+ 6BF7              ; ==============================================================================
  28+ 6BF7
  29+ 6BF7              ; ==============================================================================
  30+ 6BF7              ; _RP_Thunk - shell compartido por los 9 entry thunks
  31+ 6BF7              ; ==============================================================================
  32+ 6BF7              ; IN:  HL = body address (en bank 7)
  33+ 6BF7              ; OUT: lo que devuelva el body. Regs intermedios usados por body, no preservados.
  34+ 6BF7              ; Destruye: AF, HL (la propia entrada).
  35+ 6BF7              ;
  36+ 6BF7              ; Flujo:
  37+ 6BF7              ;   1. Save SP normal en _RP_savedSP.
  38+ 6BF7              ;   2. Swap SP a alt_stack (slot 1 always-visible).
  39+ 6BF7              ;   3. Page bank 7 en slot 3.
  40+ 6BF7              ;   4. JP (HL) -> body (via CALL .callHL + JP (HL): el RET del body cae aqui).
  41+ 6BF7              ;   5. Page bank 0 en slot 3.
  42+ 6BF7              ;   6. Restore SP normal.
  43+ 6BF7              ;   7. RET al caller original (MainLoop).
  44+ 6BF7              ; ==============================================================================
  45+ 6BF7              _RP_Thunk:
  46+ 6BF7 ED 73 0D 6C      LD (_RP_savedSP), SP
  47+ 6BFB 31 00 80         LD SP, BankCutsceneAltStackTop
  48+ 6BFE CD 98 6C         CALL _PageBank7
  49+ 6C01 CD 0C 6C         CALL .callHL
  50+ 6C04 CD 86 6C         CALL _PageBank0
  51+ 6C07 ED 7B 0D 6C      LD SP, (_RP_savedSP)
  52+ 6C0B C9               RET
  53+ 6C0C              .callHL:
  54+ 6C0C E9               JP (HL)
  55+ 6C0D 00 00        _RP_savedSP: DEFW 0
  56+ 6C0F
  57+ 6C0F              ; ==============================================================================
  58+ 6C0F              ; Entry thunks - cada uno carga HL=body y salta al shell shared
  59+ 6C0F              ; ==============================================================================
  60+ 6C0F              ; 5 bytes cada uno (LD HL = 3 B + JR = 2 B). JR backward al shell. Como el
  61+ 6C0F              ; shell mide ~18 B + las entries son ~45 B, todos los offsets caben en signed 8.
  62+ 6C0F              ;
  63+ 6C0F              ; Callers externos (registros sin args):
  64+ 6C0F              ;   UpdateRandomPickup, UpdateRoulette, PaintSynthPickupAttrs, UpdateSpeedBuff,
  65+ 6C0F              ;   UpdateMushroomBuff: MainLoop cada frame (early-out fast).
  66+ 6C0F              ;   CheckRandomSyntheticPickup: screen_system / pickup collect.
  67+ 6C0F              ;   GiveLife / GiveHealth / GiveStamina: screen_system (well pickup) +
  68+ 6C0F              ;       internamente desde CheckRandomSyntheticPickup body (intra-bank, no thunk).
  69+ 6C0F              ; ==============================================================================
  70+ 6C0F              UpdateRandomPickup:
  71+ 6C0F 21 08 EC         LD HL, UpdateRandomPickupBody
  72+ 6C12 18 E3            JR _RP_Thunk
  73+ 6C14              UpdateRoulette:
  74+ 6C14 21 25 EB         LD HL, UpdateRouletteBody
  75+ 6C17 18 DE            JR _RP_Thunk
  76+ 6C19              PaintSynthPickupAttrs:
  77+ 6C19 21 E1 ED         LD HL, PaintSynthPickupAttrsBody
  78+ 6C1C 18 D9            JR _RP_Thunk
  79+ 6C1E              UpdateSpeedBuff:
  80+ 6C1E 21 D3 EB         LD HL, UpdateSpeedBuffBody
  81+ 6C21 18 D4            JR _RP_Thunk
  82+ 6C23              UpdateMushroomBuff:
  83+ 6C23 21 99 EB         LD HL, UpdateMushroomBuffBody
  84+ 6C26 18 CF            JR _RP_Thunk
  85+ 6C28              CheckRandomSyntheticPickup:
  86+ 6C28 21 1A EE         LD HL, CheckRandomSyntheticPickupBody
  87+ 6C2B 18 CA            JR _RP_Thunk
  88+ 6C2D              GiveLife:
  89+ 6C2D 21 6F EA         LD HL, GiveLifeBody
  90+ 6C30 18 C5            JR _RP_Thunk
  91+ 6C32              GiveHealth:
  92+ 6C32 21 7A EA         LD HL, GiveHealthBody
  93+ 6C35 18 C0            JR _RP_Thunk
  94+ 6C37              GiveStamina:
  95+ 6C37 21 8B EA         LD HL, GiveStaminaBody
  96+ 6C3A 18 BB            JR _RP_Thunk
  97+ 6C3C
  98+ 6C3C              ; ==============================================================================
  99+ 6C3C              ; _B7 wrappers - llamados desde body en bank 7. Paginan bank 0, ejecutan el
 100+ 6C3C              ; callee, paginan bank 7 al volver. Estos viven en slot 1 (always-visible).
 101+ 6C3C              ; ==============================================================================
 102+ 6C3C              ; SkipPixelData / RestorePickupAttrs: bank 0 (slot 3 default), helpers de
 103+ 6C3C              ; pickup rendering usados por LoadSynthSpriteAndExtractAttr / CheckRandomSyntheticPickup.
 104+ 6C3C              ;
 105+ 6C3C              ; ApplyMagicCompassBuff: slot 1 (magic_compass.asm) pero llama helpers bank 0
 106+ 6C3C              ; internamente -> wrap completo. Solo se usa via JP tail-call desde dispatch
 107+ 6C3C              ; del pickup compass directo (no via ruleta).
 108+ 6C3C              ; ==============================================================================
 109+ 6C3C              SkipPixelData_B7:
 110+ 6C3C CD 86 6C         CALL _PageBank0
 111+ 6C3F CD B3 D3         CALL SkipPixelData
 112+ 6C42 C3 98 6C         JP _PageBank7
 113+ 6C45              RestorePickupAttrs_B7:
 114+ 6C45 CD 86 6C         CALL _PageBank0
 115+ 6C48 CD 6C DC         CALL RestorePickupAttrs
 116+ 6C4B C3 98 6C         JP _PageBank7
 117+ 6C4E              ApplyMagicCompassBuff_B7:
 118+ 6C4E CD 86 6C         CALL _PageBank0
 119+ 6C51 CD B4 6D         CALL ApplyMagicCompassBuff
 120+ 6C54 C3 98 6C         JP _PageBank7
 121+ 6C57
# file closed: random_pickups_thunks.asm
 168  6C57
 169  6C57                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 170  6C57                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 171  6C57                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 172  6C57                  ;
 173  6C57                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 174  6C57                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 175  6C57                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 176  6C57                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 177  6C57                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 178  6C57                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 179  6C57                  ; mantiene por estabilidad.
 180  6C57                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 6C57              ; ==============================================================================
   2+ 6C57              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 6C57              ; ==============================================================================
   4+ 6C57              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 6C57              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 6C57              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 6C57              ;
   8+ 6C57              ; Estrategia:
   9+ 6C57              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 6C57              ;      bank 0 paginado en slot 3.
  11+ 6C57              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 6C57              ;      seguro hacer la conmutación aquí).
  13+ 6C57              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 6C57              ;   4. Body retorna → restauramos bank 0.
  15+ 6C57              ;
  16+ 6C57              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 6C57              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 6C57              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 6C57              ; ==============================================================================
  20+ 6C57
  21+ 6C57              DrawTombstone2xCentered:
  22+ 6C57                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 6C57 21 39 DB         LD HL, BgGfx_little_house_cemetery
  24+ 6C5A 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 6C5C CD CA 67         CALL LoadBgSpriteToBuffer
  26+ 6C5F
  27+ 6C5F                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 6C5F F3               DI
  29+ 6C60 3A 7B 8D         LD A, (CurrentPaging)
  30+ 6C63 E6 F8            AND $F8
  31+ 6C65 F6 07            OR 7
  32+ 6C67 32 7B 8D         LD (CurrentPaging), A
  33+ 6C6A 01 FD 7F         LD BC, $7FFD
  34+ 6C6D ED 79            OUT (C), A
  35+ 6C6F
  36+ 6C6F                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 6C6F CD 7B DB         CALL DrawTombstone2xBody
  38+ 6C72
  39+ 6C72                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 6C72 3A 7B 8D         LD A, (CurrentPaging)
  41+ 6C75 E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 6C77 32 7B 8D         LD (CurrentPaging), A
  43+ 6C7A 01 FD 7F         LD BC, $7FFD
  44+ 6C7D ED 79            OUT (C), A
  45+ 6C7F
  46+ 6C7F                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 6C7F 3A 93 81         LD A, (StartupComplete)
  48+ 6C82 B7               OR A
  49+ 6C83 C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 6C84 FB               EI
  51+ 6C85 C9               RET
  52+ 6C86
# file closed: game_over_tomb_thunk.asm
 181  6C86
 182  6C86                  ; --- Bank cutscene: thunks slot 1 + body en bank 7 (M9) ---
 183  6C86                  ; OBSERVACION CRITICA: estos thunks tienen que ir ANTES de magic_compass.asm
 184  6C86                  ; (NO despues de music_irq) porque slot 1 esta apretado y meterlos al final
 185  6C86                  ; deborda el slot a $8000+ (slot 2 = bank 2) -> crash al BASIC.
 186  6C86                  ;
 187  6C86                  ; Aqui empujan magic_compass.asm ~140 B hacia $7A00, pero gracias a la
 188  6C86                  ; fusion de DrawBankDoorSprite_B7 dentro de DrawBgGfxSprite_B7 (ahorra 18 B)
 189  6C86                  ; y al stripping de los thunks al minimo, magic_compass termina en ~$79F0,
 190  6C86                  ; antes de la tabla IM2 ($7A00) -> BFS no cruza la zona reservada.
 191  6C86                  INCLUDE "bank_cutscene_thunks.asm"
# file opened: bank_cutscene_thunks.asm
   1+ 6C86              ; ==============================================================================
   2+ 6C86              ; bank_cutscene_thunks.asm - Wrappers slot 1 para bank_cutscene en bank 7
   3+ 6C86              ; ==============================================================================
   4+ 6C86              ; bank_cutscene.asm vive en bank 7 (movido desde bank 0 para descongestionar el
   5+ 6C86              ; main code). Este archivo expone los 2 entry points externos como thunks que
   6+ 6C86              ; paginan bank 7 antes del body y restauran bank 0 al volver. Tambien proporciona
   7+ 6C86              ; helpers _PageBank0 / _PageBank7 que el body bank 7 usa para envolver cada
   8+ 6C86              ; CALL a una funcion en bank 0 (o en slot 1 que internamente llame a bank 0).
   9+ 6C86              ;
  10+ 6C86              ; Funciones externas que requieren el wrap pre+post (paginar bank 0 antes,
  11+ 6C86              ; restaurar bank 7 despues):
  12+ 6C86              ;   - DrawBgSpriteXOR, DrawBgGfxSprite, RedrawPickupByPtr, PlaySFX,
  13+ 6C86              ;     CheckMilestoneTrigger    (todas en bank 0)
  14+ 6C86              ;   - TownGateRedrawPlayer     (slot 1, pero llama internamente a RestoreOldAttr
  15+ 6C86              ;                              que vive en bank 0)
  16+ 6C86              ;
  17+ 6C86              ; Funciones que requieren solo post-wrap (ya paginan bank 0 al final ellas mismas):
  18+ 6C86              ;   - LoadBgSpriteToBuffer     (slot 1, deja bank 0 paginado al RET -> repaginar
  19+ 6C86              ;                              bank 7 manualmente)
  20+ 6C86              ;
  21+ 6C86              ; Funciones que NO necesitan wrap (verificado por call graph):
  22+ 6C86              ;   - KillAllActiveNasties, SnapPuffPos, CheckEnemyCollision  (bank 2 slot 2)
  23+ 6C86              ;   - KillDeathIfActive -> StartMusic                          (bank 2 slot 2)
  24+ 6C86              ;   - TownGateAllNastiesDeadCheck                              (slot 1, no calls)
  25+ 6C86              ;   - AY_PlayKnockSoft/Loud/Beep                               (slot 1, no calls externos)
  26+ 6C86              ;   - DrawBgSprite16XorAtPixel -> CalcPixelAddr/NextPixelLine  (bank 2 slot 2)
  27+ 6C86              ;
  28+ 6C86              ; Vive en slot 1 (always-visible). Patron similar a game_over_tomb_thunk.asm.
  29+ 6C86              ;
  30+ 6C86              ; CRITICO: el stack normal del juego vive en $FF58 (slot 3, bank 0 paginable).
  31+ 6C86              ; Si los thunks paginan bank 7 en slot 3 sin tocar SP, el stack normal desaparece
  32+ 6C86              ; bajo nuestros pies -> CALL/RET dentro del body bank 7 leen basura -> crash.
  33+ 6C86              ; Solucion: los entry thunks (CheckBankTriggerBg, UpdateBankCutscene) hacen SP
  34+ 6C86              ; swap a BankCutsceneAltStack (RAM always-visible en slot 1, zona $5BE0..$5C00
  35+ 6C86              ; del printer buffer) durante toda la cutscene. Los _B7 thunks de funciones
  36+ 6C86              ; externas heredan ese SP (no necesitan su propio swap).
  37+ 6C86              ;
  38+ 6C86              ; Sin DI en los page switches: MusicIrqHandler vive en slot 1, por convencion
  39+ 6C86              ; project_irq_slot3_atomic no toca slot 3 -> IRQs corren normales durante los
  40+ 6C86              ; page switches igual que en LoadBgSpriteToBuffer.
  41+ 6C86              ; ==============================================================================
  42+ 6C86
  43+ 6C86              ; Alt stack: 64 B al final de slot 1 ($7FC0..$7FFF, hueco libre tras music_irq).
  44+ 6C86              ; Vive en bank 5 always-visible, no toca otras zonas de RAM. Pico medido:
  45+ 6C86              ; TownGateRedrawPlayer -> DrawSprite -> _DrawSpriteImpl + IRQ handler
  46+ 6C86              ; concurrente puede superar 32 B; 64 B (32 niveles) da margen amplio.
  47+ 6C86              BankCutsceneAltStackBase EQU $7FC0
  48+ 6C86              BankCutsceneAltStackTop  EQU $8000       ; SP top: first PUSH escribe a $7FFE-$7FFF
  49+ 6C86
  50+ 6C86              ; ==============================================================================
  51+ 6C86              ; _PageBank0 - Pagina bank 0 en slot 3. Preserva AF + BC + resto del caller.
  52+ 6C86              ; ==============================================================================
  53+ 6C86              ; Llamado por:
  54+ 6C86              ;   - Entry thunks al final (devolver al gameplay normal).
  55+ 6C86              ;   - Body bank 7 antes de cada CALL externo que toca bank 0.
  56+ 6C86              ; Destruye: ningun reg (todo restaurado via PUSH/POP).
  57+ 6C86              ; ==============================================================================
  58+ 6C86              _PageBank0:
  59+ 6C86 F5               PUSH AF
  60+ 6C87 C5               PUSH BC
  61+ 6C88 3A 7B 8D         LD A, (CurrentPaging)
  62+ 6C8B E6 F8            AND $F8                              ; bank 0 = bits 0-2 a cero
  63+ 6C8D 32 7B 8D         LD (CurrentPaging), A
  64+ 6C90 01 FD 7F         LD BC, $7FFD
  65+ 6C93 ED 79            OUT (C), A
  66+ 6C95 C1               POP BC
  67+ 6C96 F1               POP AF
  68+ 6C97 C9               RET
  69+ 6C98
  70+ 6C98              ; ==============================================================================
  71+ 6C98              ; _PageBank7 - Pagina bank 7 en slot 3. Preserva AF + BC + resto del caller.
  72+ 6C98              ; ==============================================================================
  73+ 6C98              ; Llamado por:
  74+ 6C98              ;   - Entry thunks al principio (para que el body bank 7 sea visible).
  75+ 6C98              ;   - Body bank 7 despues de cada CALL externo (para retomar el flujo).
  76+ 6C98              ; Destruye: ningun reg.
  77+ 6C98              ; ==============================================================================
  78+ 6C98              _PageBank7:
  79+ 6C98 F5               PUSH AF
  80+ 6C99 C5               PUSH BC
  81+ 6C9A 3A 7B 8D         LD A, (CurrentPaging)
  82+ 6C9D E6 F8            AND $F8
  83+ 6C9F F6 07            OR 7
  84+ 6CA1 32 7B 8D         LD (CurrentPaging), A
  85+ 6CA4 01 FD 7F         LD BC, $7FFD
  86+ 6CA7 ED 79            OUT (C), A
  87+ 6CA9 C1               POP BC
  88+ 6CAA F1               POP AF
  89+ 6CAB C9               RET
  90+ 6CAC
  91+ 6CAC              ; ==============================================================================
  92+ 6CAC              ; CheckBankTriggerBg - Thunk de entry. Swap SP a alt_stack, pagina bank 7,
  93+ 6CAC              ; ejecuta body, restaura bank 0 + SP normal.
  94+ 6CAC              ; ==============================================================================
  95+ 6CAC              ; Llamado desde MainLoop cada frame. Body verifica si el player toca la
  96+ 6CAC              ; puerta del banco con el cheque y dispara la cutscene + avance de hito M9.
  97+ 6CAC              ;
  98+ 6CAC              ; CRITICO: stack normal vive en bank 0 (slot 3) -> desaparece al paginar bank 7.
  99+ 6CAC              ; Por eso swap SP a alt_stack ANTES del page switch.
 100+ 6CAC              ; ==============================================================================
 101+ 6CAC              CheckBankTriggerBg:
 102+ 6CAC ED 73 C1 6C      LD (.savedSPCheck), SP                   ; save SP normal (en bank 0)
 103+ 6CB0 31 00 80         LD SP, BankCutsceneAltStackTop           ; SP -> alt_stack (slot 1 always-vis)
 104+ 6CB3 CD 98 6C         CALL _PageBank7
 105+ 6CB6 CD A3 DD         CALL CheckBankTriggerBgBody
 106+ 6CB9 CD 86 6C         CALL _PageBank0                          ; bank 0 paginado -> SP normal accesible al restaurar
 107+ 6CBC ED 7B C1 6C      LD SP, (.savedSPCheck)                   ; restore SP normal
 108+ 6CC0 C9               RET                                      ; vuelve al CALL del MainLoop
 109+ 6CC1 00 00        .savedSPCheck: DEFW 0
