 265+ 6EBB 3A B4 5F         LD A, (RandomSynthMapX)
 266+ 6EBE FE FE            CP $FE
 267+ 6EC0 C8               RET Z                               ; inactiva
 268+ 6EC1                  ; Sanity: solo procesar si estamos en su sala (deberia ser asi tras hook).
 269+ 6EC1 47               LD B, A
 270+ 6EC2 3A 9A 82         LD A, (CurrentScreenX)
 271+ 6EC5 B8               CP B
 272+ 6EC6 C0               RET NZ
 273+ 6EC7 3A B5 5F         LD A, (RandomSynthMapY)
 274+ 6ECA 47               LD B, A
 275+ 6ECB 3A 9B 82         LD A, (CurrentScreenY)
 276+ 6ECE B8               CP B
 277+ 6ECF C0               RET NZ
