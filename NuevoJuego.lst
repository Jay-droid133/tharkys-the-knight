 380+ 6A8D              ; ==============================================================================
 381+ 6A8D              ; EraseStatueAtSlot - borra (XOR) la estatua del slot N en la pantalla actual
 382+ 6A8D              ; ==============================================================================
 383+ 6A8D              ; IN: A = slot (0..2)
 384+ 6A8D              ; Solo tiene efecto si la estatua esta colocada en la pantalla actual.
 385+ 6A8D              ; Destruye: AF, BC, DE, HL, IX.
 386+ 6A8D              ; ==============================================================================
 387+ 6A8D              EraseStatueAtSlot:
 388+ 6A8D                  ; Get statue ID from table
 389+ 6A8D 21 A9 69         LD HL, StatueIdTable
 390+ 6A90 5F               LD E, A
 391+ 6A91 16 00            LD D, 0
 392+ 6A93 19               ADD HL, DE
 393+ 6A94 7E               LD A, (HL)                              ; A = statue id
 394+ 6A95 B7               OR A
 395+ 6A96 C8               RET Z                                   ; ID 0 = no estatua (no exportada)
 396+ 6A97 32 D3 6A         LD (.eseTargetId), A
 397+ 6A9A                  ; Scan CurrentScreenBuffer (formato 4B: id, charX, charY, variant; $FF = end)
 398+ 6A9A 2A 0A 83         LD HL, (CurrentScreenAddr)
 399+ 6A9D              .eseLoop:
 400+ 6A9D 7E               LD A, (HL)
 401+ 6A9E FE FF            CP $FF
 402+ 6AA0 C8               RET Z                                   ; no encontrada en esta pantalla
 403+ 6AA1 47               LD B, A                                 ; B = current id
 404+ 6AA2 3A D3 6A         LD A, (.eseTargetId)
 405+ 6AA5 B8               CP B
 406+ 6AA6 28 06            JR Z, .eseFound
 407+ 6AA8 11 04 00         LD DE, 4
 408+ 6AAB 19               ADD HL, DE
 409+ 6AAC 18 EF            JR .eseLoop
 410+ 6AAE              .eseFound:
 411+ 6AAE                  ; HL en id. Avanzar a charX, charY.
 412+ 6AAE 23               INC HL
 413+ 6AAF 46               LD B, (HL)                              ; B = charX
 414+ 6AB0 23               INC HL
 415+ 6AB1 4E               LD C, (HL)                              ; C = charY
 416+ 6AB2                  ; Cargar sprite via BgGfxPtrById[id]: id*3 -> ptr (DEFW), bank (DEFB).
 417+ 6AB2 3A D3 6A         LD A, (.eseTargetId)
 418+ 6AB5 6F               LD L, A
 419+ 6AB6 26 00            LD H, 0
 420+ 6AB8 54               LD D, H
 421+ 6AB9 5D               LD E, L
 422+ 6ABA 29               ADD HL, HL                              ; *2
 423+ 6ABB 19               ADD HL, DE                              ; *3
 424+ 6ABC 11 D0 DF         LD DE, BgGfxPtrById
 425+ 6ABF 19               ADD HL, DE
 426+ 6AC0 5E               LD E, (HL)
 427+ 6AC1 23               INC HL
 428+ 6AC2 56               LD D, (HL)                              ; DE = ptr
 429+ 6AC3 23               INC HL
 430+ 6AC4 7E               LD A, (HL)                              ; A = bank
 431+ 6AC5 C5               PUSH BC
 432+ 6AC6 EB               EX DE, HL                               ; HL = ptr
 433+ 6AC7 CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
 434+ 6ACA C1               POP BC
 435+ 6ACB DD 21 F5 86      LD IX, BgSpriteBuffer
 436+ 6ACF CD DD DB         CALL DrawBgSpriteXOR                    ; XOR-erase
 437+ 6AD2 C9               RET
 438+ 6AD3 00           .eseTargetId: DEFB 0
