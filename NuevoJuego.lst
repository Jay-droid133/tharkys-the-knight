 162+ E9D4 00           MilestoneKeyDebounce: DEFB 0
 163+ E9D5
 164+ E9D5              ; ==============================================================================
 165+ E9D5              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 166+ E9D5              ; ==============================================================================
 167+ E9D5              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 168+ E9D5              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 169+ E9D5              ; inmediato del valor actual.
 170+ E9D5              ; ==============================================================================
 171+ E9D5              CheckCurrentKeyCycleKey:
 172+ E9D5 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 173+ E9D7 DB FE            IN A, ($FE)
 174+ E9D9 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 175+ E9DB 20 17            JR NZ, .ckcNotPressed
 176+ E9DD 3A F9 E9         LD A, (CurrentKeyCycleDebounce)
 177+ E9E0 B7               OR A
 178+ E9E1 C0               RET NZ
 179+ E9E2 3E 01            LD A, 1
 180+ E9E4 32 F9 E9         LD (CurrentKeyCycleDebounce), A
 181+ E9E7 3A EF 81         LD A, (CurrentKey)
 182+ E9EA 3C               INC A
 183+ E9EB FE 07            CP 7
 184+ E9ED 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 185+ E9EF AF               XOR A                               ; 7 -> wrap a 0
 186+ E9F0              .ckcSet:
 187+ E9F0 32 EF 81         LD (CurrentKey), A
 188+ E9F3 C9               RET
 189+ E9F4              .ckcNotPressed:
 190+ E9F4 AF               XOR A
 191+ E9F5 32 F9 E9         LD (CurrentKeyCycleDebounce), A
 192+ E9F8 C9               RET
 193+ E9F9
 194+ E9F9 00           CurrentKeyCycleDebounce: DEFB 0
