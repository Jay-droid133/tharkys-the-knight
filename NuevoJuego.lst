1279+ 933A              ; ==============================================================================
1280+ 933A              ; CheckPlayerMonsterOverlap - Bloquear player contra monsters (colision solida)
1281+ 933A              ; ==============================================================================
1282+ 933A              ; IX = player entity. Comprueba AABB con todos los monsters activos.
1283+ 933A              ; Usa GetSpriteDims para dimensiones reales (soporta monsters de cualquier tamaño).
1284+ 933A              ; Retorna Z=libre, NZ=bloqueado por algun monster.
1285+ 933A              ; ==============================================================================
1286+ 933A              CheckPlayerMonsterOverlap:
1287+ 933A                  ; Guardar IX (player)
1288+ 933A DD E5            PUSH IX
1289+ 933C                  ; Siempre usar ancho de CUERPO (16px), no espada (24px)
1290+ 933C                  ; Asi la espada puede solapar pero el cuerpo no
1291+ 933C 3E 10            LD A, 16
1292+ 933E 32 C5 93         LD (.cpmoPlW), A
1293+ 9341 3E 15            LD A, 21                            ; Altura player fija
1294+ 9343 32 C6 93         LD (.cpmoPlH), A
1295+ 9346                  ; Player pos
1296+ 9346 DD E1            POP IX
1297+ 9348 DD E5            PUSH IX
1298+ 934A DD 7E 03         LD A, (IX+ENT_POSX)
1299+ 934D 32 C3 93         LD (.cpmoPlX), A
1300+ 9350 DD 7E 04         LD A, (IX+ENT_POSY)
1301+ 9353 32 C4 93         LD (.cpmoPlY), A
1302+ 9356
1303+ 9356 DD 21 95 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1304+ 935A 06 03            LD B, MONSTERS_TO_SPAWN
1305+ 935C              .cpmoLoop:
1306+ 935C C5               PUSH BC
1307+ 935D                  ; Solo monsters activos, no muriendo/spawneando, no stunned
1308+ 935D DD 7E 01         LD A, (IX+ENT_TYPE)
1309+ 9360 FE 02            CP TYPE_MONSTER
1310+ 9362 20 53            JR NZ, .cpmoNext
1311+ 9364 DD 7E 02         LD A, (IX+ENT_STATE)
1312+ 9367 FE 03            CP STATE_DYING
1313+ 9369 28 4C            JR Z, .cpmoNext
1314+ 936B FE 04            CP STATE_SPAWNING
1315+ 936D 28 48            JR Z, .cpmoNext
1316+ 936F
1317+ 936F                  ; Obtener dims del monster
1318+ 936F DD 7E 00         LD A, (IX+ENT_SPRITEID)
1319+ 9372 CD 9F 90         CALL GetSpriteDims                 ; B=monW, C=monH
1320+ 9375
1321+ 9375                  ; AABB: playerX < monX + monW AND monX < playerX + plW
1322+ 9375 DD 7E 03         LD A, (IX+ENT_POSX)
1323+ 9378 80               ADD A, B                           ; monX + monW
1324+ 9379 38 07            JR C, .cpmoXCheck2                 ; overflow → siempre true
1325+ 937B 57               LD D, A
1326+ 937C 3A C3 93         LD A, (.cpmoPlX)
1327+ 937F BA               CP D
1328+ 9380 30 35            JR NC, .cpmoNext                   ; playerX >= monX + monW → no overlap
1329+ 9382              .cpmoXCheck2:
1330+ 9382 3A C3 93         LD A, (.cpmoPlX)
1331+ 9385 57               LD D, A
1332+ 9386 3A C5 93         LD A, (.cpmoPlW)
1333+ 9389 82               ADD A, D                           ; playerX + plW
1334+ 938A 38 07            JR C, .cpmoYCheck1
1335+ 938C 57               LD D, A
1336+ 938D DD 7E 03         LD A, (IX+ENT_POSX)
1337+ 9390 BA               CP D
1338+ 9391 30 24            JR NC, .cpmoNext                   ; monX >= playerX + plW → no overlap
1339+ 9393              .cpmoYCheck1:
1340+ 9393                  ; AABB Y: playerY < monY + monH AND monY < playerY + plH
1341+ 9393 DD 7E 04         LD A, (IX+ENT_POSY)
1342+ 9396 81               ADD A, C                           ; monY + monH
1343+ 9397 38 07            JR C, .cpmoYCheck2
1344+ 9399 57               LD D, A
1345+ 939A 3A C4 93         LD A, (.cpmoPlY)
1346+ 939D BA               CP D
1347+ 939E 30 17            JR NC, .cpmoNext                   ; playerY >= monY + monH → no overlap
1348+ 93A0              .cpmoYCheck2:
1349+ 93A0 3A C4 93         LD A, (.cpmoPlY)
1350+ 93A3 57               LD D, A
1351+ 93A4 3A C6 93         LD A, (.cpmoPlH)
1352+ 93A7 82               ADD A, D                           ; playerY + plH
1353+ 93A8 38 07            JR C, .cpmoHit
1354+ 93AA 57               LD D, A
1355+ 93AB DD 7E 04         LD A, (IX+ENT_POSY)
1356+ 93AE BA               CP D
1357+ 93AF 30 06            JR NC, .cpmoNext                   ; monY >= playerY + plH → no overlap
1358+ 93B1              .cpmoHit:
1359+ 93B1                  ; Overlap! Bloqueado
1360+ 93B1 C1               POP BC
1361+ 93B2 DD E1            POP IX
1362+ 93B4 F6 01            OR 1                               ; NZ = bloqueado
1363+ 93B6 C9               RET
1364+ 93B7              .cpmoNext:
1365+ 93B7 11 10 00         LD DE, ENT_SIZE
