 390+ 6597 5F               LD E, A
 391+ 6598 16 00            LD D, 0
 392+ 659A 19               ADD HL, DE
 393+ 659B 7E               LD A, (HL)                              ; A = statue id
 394+ 659C B7               OR A
 395+ 659D C8               RET Z                                   ; ID 0 = no estatua (no exportada)
 396+ 659E 32 DA 65         LD (.eseTargetId), A
