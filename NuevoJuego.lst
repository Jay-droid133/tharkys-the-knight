 458  CF2D                  INCLUDE "screen_system.asm"
# file opened: code/screen_system.asm
   1+ CF2D              ; ==============================================================================
   2+ CF2D              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CF2D              ; ==============================================================================
   4+ CF2D              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CF2D              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CF2D              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CF2D              ; ==============================================================================
   8+ CF2D
   9+ CF2D              ; ==============================================================================
  10+ CF2D              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CF2D              ; ==============================================================================
  12+ CF2D              InitScreenSystem:
  13+ CF2D 3E 0F            LD A, START_SCREEN_X
  14+ CF2F 32 08 83         LD (CurrentScreenX), A
  15+ CF32 3E 07            LD A, START_SCREEN_Y
  16+ CF34 32 09 83         LD (CurrentScreenY), A
  17+ CF37 3E 01            LD A, 1
  18+ CF39 32 10 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CF3C AF               XOR A
  20+ CF3D 32 0C 83         LD (ScreenTransition), A
  21+ CF40 CD 44 CF         CALL CalcScreenAddress
  22+ CF43 C9               RET
  23+ CF44
  24+ CF44              ; ==============================================================================
  25+ CF44              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CF44              ; ==============================================================================
  27+ CF44              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CF44              ; ==============================================================================
  29+ CF44              CalcScreenAddress:
  30+ CF44 3A 09 83         LD A, (CurrentScreenY)
  31+ CF47 6F               LD L, A
  32+ CF48 26 00            LD H, 0
  33+ CF4A 29               ADD HL, HL                  ; x2
  34+ CF4B 29               ADD HL, HL                  ; x4
  35+ CF4C 29               ADD HL, HL                  ; x8
  36+ CF4D 29               ADD HL, HL                  ; x16
  37+ CF4E 3A 08 83         LD A, (CurrentScreenX)
  38+ CF51 5F               LD E, A
  39+ CF52 16 00            LD D, 0
  40+ CF54 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CF55 11 24 E0         LD DE, MapTable
  42+ CF58 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CF59 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CF5A                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CF5A 6F               LD L, A
  46+ CF5B 26 00            LD H, 0
  47+ CF5D 29               ADD HL, HL                  ; index * 2
  48+ CF5E 11 F2 DE         LD DE, RoomTable
  49+ CF61 19               ADD HL, DE
  50+ CF62 5E               LD E, (HL)
  51+ CF63 23               INC HL
  52+ CF64 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CF65                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CF65 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CF66 CD 72 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CF69                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CF69 11 F5 85         LD DE, CurrentScreenBuffer
  58+ CF6C ED 53 0A 83      LD (CurrentScreenAddr), DE
  59+ CF70 C9               RET
  60+ CF71
  61+ CF71              ; ==============================================================================
  62+ CF71              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CF71              ; ==============================================================================
  64+ CF71              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CF71              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CF71              ; por estar atrapado cerca del borde.
  67+ CF71              ; ==============================================================================
  68+ CF71              CheckScreenTransition:
  69+ CF71 AF               XOR A
  70+ CF72 32 0C 83         LD (ScreenTransition), A
  71+ CF75
  72+ CF75                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CF75                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CF75                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CF75                  ; dispararia transicion sur en plena animacion.
  76+ CF75 3A C8 82         LD A, (TownGatePhase)
  77+ CF78 B7               OR A
  78+ CF79 C0               RET NZ
  79+ CF7A
  80+ CF7A                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CF7A                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CF7A                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CF7A                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CF7A                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CF7A                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CF7A 3A B3 82         LD A, (TimeFrozen)
  87+ CF7D B7               OR A
  88+ CF7E 28 23            JR Z, .cstNotFrozen
  89+ CF80 3A AB 82         LD A, (InputDirection)
  90+ CF83 CB 4F            BIT 1, A                    ; S
  91+ CF85 28 17            JR Z, .cstClearBlockFlag
  92+ CF87 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  93+ CF8A FE A8            CP SCREEN_MAX_Y
  94+ CF8C 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CF8E                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CF8E 3A B4 82         LD A, (BlockedExitSoundFlag)
  97+ CF91 B7               OR A
  98+ CF92 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CF93 3E 01            LD A, 1
 100+ CF95 32 B4 82         LD (BlockedExitSoundFlag), A
 101+ CF98 21 47 FA         LD HL, SFX_BlockedExit
 102+ CF9B C3 23 F9         JP PlaySFX                  ; tail call
 103+ CF9E              .cstClearBlockFlag:
 104+ CF9E AF               XOR A
 105+ CF9F 32 B4 82         LD (BlockedExitSoundFlag), A
 106+ CFA2 C9               RET
