2505+ DBDC              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2506+ DBDC              ; ==============================================================================
2507+ DBDC              ; IN:  DE = BgGfx pointer
2508+ DBDC              ; OUT: A = 0 (normal), 1..6 (key), 7..12 (lock con key requerida = A-6)
2509+ DBDC              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2510+ DBDC              ; ==============================================================================
2511+ DBDC              GetPickupKeyBehavior:
2512+ DBDC E5               PUSH HL
2513+ DBDD C5               PUSH BC
2514+ DBDE 21 2C D9         LD HL, KeyLockTable
2515+ DBE1 06 0C            LD B, 12                    ; 12 slots
2516+ DBE3 0E 01            LD C, 1                     ; id actual (1..12)
2517+ DBE5              .gpkbLoop:
2518+ DBE5 7E               LD A, (HL)                  ; ptr_lo del slot
2519+ DBE6 BB               CP E
2520+ DBE7 20 06            JR NZ, .gpkbNext
2521+ DBE9 23               INC HL
2522+ DBEA 7E               LD A, (HL)                  ; ptr_hi
