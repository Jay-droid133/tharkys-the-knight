 333+ 6EEF              ; MagicCompassJingleTable ELIMINADO (12 B). Pickup chime ahora via _AY_PlaySweep.
 334+ 6EEF              ; .pmcaDirToOffset ELIMINADO (4 B) — blink del char activo desplazado al gap hint.
 335+ 6EEF
 336+ 6EEF              ; ==============================================================================
 337+ 6EEF              ; ComputeMagicCompassPath - BFS reverse con state (sid, comp_local)
 338+ 6EEF              ; ==============================================================================
 339+ 6EEF              ; Algoritmo:
 340+ 6EEF              ;   1. queue.push((target_sid, target_comp=0)). Mark visited.
 341+ 6EEF              ;      target_comp = 0 (heurística: el pickup vive en la comp principal).
 342+ 6EEF              ;   2. While queue not empty:
 343+ 6EEF              ;        (R, R_comp) = queue.pop()
 344+ 6EEF              ;        For each gap in RoomCompGaps[R]:
 345+ 6EEF              ;          If gap.comp != R_comp: skip.
 346+ 6EEF              ;          V = neighbor of R via gap.side.
 347+ 6EEF              ;          Find V's gap with side=opposite(gap.side) AND coord=gap.coord.
 348+ 6EEF              ;          V_comp = that gap's comp.
 349+ 6EEF              ;          If (V, V_comp) visited: skip.
 350+ 6EEF              ;          If V == current_sid AND V_comp == player_current_comp:
 351+ 6EEF              ;            dir_player = opposite(gap.side); STORE; RETURN.
 352+ 6EEF              ;          Mark visited; queue.push((V, V_comp)).
 353+ 6EEF              ;
 354+ 6EEF              ; player_current_comp se determina via LastEntrySide:
 355+ 6EEF              ;   - LastEntrySide = side por el que el player entró a current_sid.
 356+ 6EEF              ;   - player_comp = comp del gap de current_sid en LastEntrySide.
 357+ 6EEF              ;   - Si LastEntrySide = $FF (boot/respawn), comp = 0 (fallback).
 358+ 6EEF              ;
 359+ 6EEF              ; OUT: MagicCompassPathDir = 0=N, 1=E, 2=S, 3=W; o $FF si sin path.
 360+ 6EEF              ; ==============================================================================
 361+ 6EEF              ; ComputeMagicCompassPath — wrapper que pagina bank 7 alrededor del BFS.
 362+ 6EEF              ;
 363+ 6EEF              ; Tanto las tablas RoomCompGaps_XX como ahora el body _ComputeMagicCompassPath_Inner
 364+ 6EEF              ; (+ sus helpers .cmcp* / .cfmg* / .fgbs* y locales DEFB) viven en bank 7
 365+ 6EEF              ; (magic_compass_bfs_bank7.asm). Se movieron alli en mayo 2026 cuando los
 366+ 6EEF              ; thunks de bank_cutscene_thunks.asm anadieron ~135 B a slot 1 y empujaron el
 367+ 6EEF              ; BFS sobre $7A00 (la tabla IM2 sobreescribia el codigo BFS con $7B -> BFS
 368+ 6EEF              ; retornaba basura -> magic compass siempre PathDir=$FF). Mover ~690 B a
 369+ 6EEF              ; bank 7 dejo margen amplio en slot 1.
 370+ 6EEF              ;
 371+ 6EEF              ; Stack consistency: el caller (UpdateMagicCompass en slot 1) ENTRA con bank 0
 372+ 6EEF              ; paginated. El wrapper pagina bank 7, CALL _Inner (PUSH PC en bank 7 stack).
 373+ 6EEF              ; _Inner ejecuta todo (CALL/RET/PUSH/POP) con bank 7 stack consistente.
 374+ 6EEF              ; Tras RET, el wrapper pagina bank 0 antes de su propio RET, asi que el caller
 375+ 6EEF              ; recupera su return PC del bank 0 stack (donde fue pushed originalmente).
 376+ 6EEF              ;
 377+ 6EEF              ; Mantiene DI durante todo el chunk BFS (~4000 T = 1/15 frame). Riesgo de
 378+ 6EEF              ; perder ~3 IRQ por segundo de compass activo, aceptable.
 379+ 6EEF              ; ==============================================================================
 380+ 6EEF              ComputeMagicCompassPath:
 381+ 6EEF F3               DI
 382+ 6EF0                  ; --- Page bank 7 in slot 3 ---
 383+ 6EF0 3A 8A 8D         LD A, (CurrentPaging)
 384+ 6EF3 E6 F8            AND $F8
 385+ 6EF5 F6 07            OR 7
 386+ 6EF7 32 8A 8D         LD (CurrentPaging), A
 387+ 6EFA 01 FD 7F         LD BC, $7FFD
 388+ 6EFD ED 79            OUT (C), A
 389+ 6EFF
 390+ 6EFF CD D9 E2         CALL _ComputeMagicCompassPath_Inner
 391+ 6F02
 392+ 6F02                  ; --- Page bank 0 back ---
 393+ 6F02 3A 8A 8D         LD A, (CurrentPaging)
 394+ 6F05 E6 F8            AND $F8
 395+ 6F07 32 8A 8D         LD (CurrentPaging), A
 396+ 6F0A 01 FD 7F         LD BC, $7FFD
 397+ 6F0D ED 79            OUT (C), A
 398+ 6F0F
 399+ 6F0F 3A A2 81         LD A, (StartupComplete)
 400+ 6F12 B7               OR A
 401+ 6F13 C8               RET Z                                ; aún en Inicio: dejar DI
 402+ 6F14 FB               EI
 403+ 6F15 C9               RET
 404+ 6F16
 405+ 6F16              ; _ComputeMagicCompassPath_Inner — movido a magic_compass_bfs_bank7.asm.
 406+ 6F16              ;
 407+ 6F16              ; A continuacion habria seguido todo el BFS body + helpers + locales DEFB,
 408+ 6F16              ; pero ahora vive en bank 7. El label `_ComputeMagicCompassPath_Inner` se
 409+ 6F16              ; resuelve a una direccion $C000+ que solo es visible cuando bank 7 esta
 410+ 6F16              ; paginated; el wrapper de arriba se ocupa de eso.
 411+ 6F16
 412+ 6F16              ; Resto del archivo eliminado (movido a magic_compass_bfs_bank7.asm).
 413+ 6F16              ; Aqui solo quedan los includes finales que NO viven en bank 7:
 414+ 6F16
 415+ 6F16                  IF 0
 416+ 6F16 ~            ; Lo que sigue era el contenido viejo de _ComputeMagicCompassPath_Inner.
 417+ 6F16 ~            _ComputeMagicCompassPath_Inner_OLD:
