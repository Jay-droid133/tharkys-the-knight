 424+ 9E8B              ; ==============================================================================
 425+ 9E8B              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9E8B              ; ==============================================================================
 427+ 9E8B              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9E8B              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9E8B              ;
 430+ 9E8B              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9E8B              ; ==============================================================================
 432+ 9E8B              RestoreEntityAttr:
 433+ 9E8B CD 25 A0         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9E8E 11 AB 9E         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9E91
 436+ 9E91 3A BC 9E         LD A, (EntityAttrH)
 437+ 9E94 4F               LD C, A
 438+ 9E95              .restRow:
 439+ 9E95 3A BB 9E         LD A, (EntityAttrW)
 440+ 9E98 47               LD B, A
 441+ 9E99 E5               PUSH HL
 442+ 9E9A              .restCol:
 443+ 9E9A 1A               LD A, (DE)
 444+ 9E9B 77               LD (HL), A
 445+ 9E9C 23               INC HL
 446+ 9E9D 13               INC DE
 447+ 9E9E 10 FA            DJNZ .restCol
 448+ 9EA0 E1               POP HL
 449+ 9EA1 D5               PUSH DE
 450+ 9EA2 11 20 00         LD DE, 32
 451+ 9EA5 19               ADD HL, DE
 452+ 9EA6 D1               POP DE
 453+ 9EA7 0D               DEC C
 454+ 9EA8 20 EB            JR NZ, .restRow
 455+ 9EAA C9               RET
 456+ 9EAB
 457+ 9EAB              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9EAB              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9EAB              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9EAB              ; ---
 461+ 9EAB 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9EBB 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9EBC 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9EBD 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9FEF 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9FF0
 467+ 9FF0              ; ==============================================================================
 468+ 9FF0              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9FF0              ; ==============================================================================
 470+ 9FF0              ; Entrada: A = indice de entidad (0-16)
 471+ 9FF0              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9FF0              ; ==============================================================================
 473+ 9FF0              SetAttrSlot:
 474+ 9FF0 32 EF 9F         LD (CurrentAttrSlot), A
 475+ 9FF3                  ; Calcular offset: A * 18
 476+ 9FF3 6F               LD L, A
 477+ 9FF4 26 00            LD H, 0
 478+ 9FF6 29               ADD HL, HL                  ; x2
 479+ 9FF7 54               LD D, H
 480+ 9FF8 5D               LD E, L                     ; DE = x2
 481+ 9FF9 29               ADD HL, HL                  ; x4
 482+ 9FFA 29               ADD HL, HL                  ; x8
 483+ 9FFB 29               ADD HL, HL                  ; x16
 484+ 9FFC 19               ADD HL, DE                  ; x18
 485+ 9FFD 11 BD 9E         LD DE, SavedAttrTable
 486+ A000 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A001                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A001 11 AB 9E         LD DE, EntitySavedAttr
 489+ A004 01 12 00         LD BC, 18
 490+ A007 ED B0            LDIR
 491+ A009 C9               RET
 492+ A00A
 493+ A00A              ; ==============================================================================
 494+ A00A              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A00A              ; ==============================================================================
 496+ A00A              FlushAttrSlot:
 497+ A00A 3A EF 9F         LD A, (CurrentAttrSlot)
 498+ A00D 6F               LD L, A
 499+ A00E 26 00            LD H, 0
 500+ A010 29               ADD HL, HL                  ; x2
 501+ A011 54               LD D, H
 502+ A012 5D               LD E, L
 503+ A013 29               ADD HL, HL                  ; x4
 504+ A014 29               ADD HL, HL                  ; x8
 505+ A015 29               ADD HL, HL                  ; x16
 506+ A016 19               ADD HL, DE                  ; x18
 507+ A017 11 BD 9E         LD DE, SavedAttrTable
 508+ A01A 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A01B EB               EX DE, HL                   ; DE = destino
 510+ A01C 21 AB 9E         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A01F 01 12 00         LD BC, 18
 512+ A022 ED B0            LDIR
 513+ A024 C9               RET
 514+ A025
 515+ A025              ; ==============================================================================
 516+ A025              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A025              ; ==============================================================================
 518+ A025              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A025              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A025              ; ==============================================================================
 521+ A025              CalcAttrAddr:
 522+ A025 7A               LD A, D
 523+ A026 0F               RRCA
 524+ A027 0F               RRCA
 525+ A028 0F               RRCA
 526+ A029 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A02B 6F               LD L, A
 528+ A02C 26 00            LD H, 0
 529+ A02E 29               ADD HL, HL
 530+ A02F 29               ADD HL, HL
 531+ A030 29               ADD HL, HL
 532+ A031 29               ADD HL, HL
 533+ A032 29               ADD HL, HL                  ; HL = fila * 32
 534+ A033 7B               LD A, E
 535+ A034 0F               RRCA
 536+ A035 0F               RRCA
 537+ A036 0F               RRCA
 538+ A037 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A039 B5               OR L
 540+ A03A 6F               LD L, A
 541+ A03B 01 00 58         LD BC, ATTR_BASE
 542+ A03E 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A03F C9               RET
 544+ A040
 545+ A040              ; ==============================================================================
 546+ A040              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A040              ; ==============================================================================
 548+ A040              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A040              ; Salida: HL=direccion en VRAM
 550+ A040              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A040              ; ==============================================================================
 552+ A040              CalcPixelAddr:
 553+ A040 7A               LD A, D
 554+ A041 E6 C0            AND $C0                     ; Y7 Y6
 555+ A043 1F               RRA
 556+ A044 1F               RRA
 557+ A045 1F               RRA                         ; >> 3
 558+ A046 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A048 67               LD H, A
 560+ A049
 561+ A049 7A               LD A, D
 562+ A04A E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A04C B4               OR H
 564+ A04D 67               LD H, A
 565+ A04E
 566+ A04E 7A               LD A, D
 567+ A04F E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A051 87               ADD A, A
 569+ A052 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A053 6F               LD L, A
 571+ A054
 572+ A054 7B               LD A, E
 573+ A055 1F               RRA
 574+ A056 1F               RRA
 575+ A057 1F               RRA
 576+ A058 E6 1F            AND $1F                     ; X / 8 = columna
 577+ A05A B5               OR L
 578+ A05B 6F               LD L, A
 579+ A05C C9               RET
 580+ A05D
 581+ A05D              ; ==============================================================================
 582+ A05D              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A05D              ; ==============================================================================
 584+ A05D              DrawDebugInfo:
 585+ A05D 3A 08 83         LD A, (CurrentScreenX)
 586+ A060 1E 00            LD E, 0
 587+ A062 CD 7F A0         CALL .drawHexDigit
 588+ A065
 589+ A065 3E 2C            LD A, ','
 590+ A067 1E 01            LD E, 1
 591+ A069 CD 8B A0         CALL .drawChar
 592+ A06C
 593+ A06C 3A 09 83         LD A, (CurrentScreenY)
 594+ A06F 1E 02            LD E, 2
 595+ A071 CD 7F A0         CALL .drawHexDigit
 596+ A074
 597+ A074 21 00 58         LD HL, ATTR_BASE
 598+ A077 3E 47            LD A, WHITE | $40
 599+ A079 77               LD (HL), A
 600+ A07A 23               INC HL
 601+ A07B 77               LD (HL), A
 602+ A07C 23               INC HL
 603+ A07D 77               LD (HL), A
 604+ A07E C9               RET
 605+ A07F
 606+ A07F              .drawHexDigit:
 607+ A07F E6 0F            AND $0F
 608+ A081 FE 0A            CP 10
 609+ A083 38 04            JR C, .isNum
