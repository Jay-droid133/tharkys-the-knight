  40+ EF37              MilestoneTable:
  41+ EF37 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EF39 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EF3B 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EF3D 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EF3F 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EF41 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EF43 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EF45                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EF45                                                      ;    el cheque, no por tecla M en runtime)
  50+ EF45 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EF47                                                      ;    ir a recogerlo tras drop de la
  52+ EF47                                                      ;    cinematica de la iglesia)
  53+ EF47 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EF49 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EF4B 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EF4D
