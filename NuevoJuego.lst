 387+ 8F6C 77               LD (HL), A
 388+ 8F6D 23               INC HL
 389+ 8F6E 13               INC DE
 390+ 8F6F 10 FA            DJNZ .restCol
 391+ 8F71 E1               POP HL
 392+ 8F72 D5               PUSH DE
 393+ 8F73 11 20 00         LD DE, 32
 394+ 8F76 19               ADD HL, DE
 395+ 8F77 D1               POP DE
 396+ 8F78 0D               DEC C
 397+ 8F79 20 EB            JR NZ, .restRow
 398+ 8F7B C9               RET
 399+ 8F7C
 400+ 8F7C              ; --- Buffer de atributos guardados POR ENTIDAD ---
 401+ 8F7C              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 402+ 8F7C              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 403+ 8F7C              ; ---
 404+ 8F7C 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 405+ 8F8C 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 406+ 8F8D 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 407+ 8F8E 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 408+ 90C0 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 409+ 90C1
 410+ 90C1              ; ==============================================================================
 411+ 90C1              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 412+ 90C1              ; ==============================================================================
 413+ 90C1              ; Entrada: A = indice de entidad (0-16)
 414+ 90C1              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 415+ 90C1              ; ==============================================================================
 416+ 90C1              SetAttrSlot:
 417+ 90C1 32 C0 90         LD (CurrentAttrSlot), A
 418+ 90C4                  ; Calcular offset: A * 18
 419+ 90C4 6F               LD L, A
 420+ 90C5 26 00            LD H, 0
 421+ 90C7 29               ADD HL, HL                  ; x2
 422+ 90C8 54               LD D, H
 423+ 90C9 5D               LD E, L                     ; DE = x2
 424+ 90CA 29               ADD HL, HL                  ; x4
 425+ 90CB 29               ADD HL, HL                  ; x8
 426+ 90CC 29               ADD HL, HL                  ; x16
 427+ 90CD 19               ADD HL, DE                  ; x18
 428+ 90CE 11 8E 8F         LD DE, SavedAttrTable
 429+ 90D1 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 430+ 90D2                  ; Copiar 18 bytes a EntitySavedAttr
 431+ 90D2 11 7C 8F         LD DE, EntitySavedAttr
 432+ 90D5 01 12 00         LD BC, 18
 433+ 90D8 ED B0            LDIR
 434+ 90DA C9               RET
