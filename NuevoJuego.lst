2146+ F267              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
2147+ F267              ; ==============================================================================
2148+ F267              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
2149+ F267              ; comparando ptr_lo/ptr_hi con DE.
2150+ F267              ; IN:  DE = ptr buscado.
2151+ F267              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
2152+ F267              ; Destruye: AF.
2153+ F267              ; ==============================================================================
2154+ F267              FindPickupEntryByPtr:
2155+ F267 21 7E D9         LD HL, PickupTable
2156+ F26A              .fpeLoop:
