1369+ F1D4              ; ==============================================================================
1370+ F1D4              ; Variantes random de health/stamina pickup
1371+ F1D4              ; ==============================================================================
1372+ F1D4              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
1373+ F1D4              ; eligen una variante visual al azar. Asi el random pickup tiene mas
1374+ F1D4              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
1375+ F1D4              ; variante — solo cambia el sprite que se ve.
1376+ F1D4              ;
1377+ F1D4              ; Formato tabla: DEFB count, ids... (1 byte por id)
1378+ F1D4              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
1379+ F1D4              ; ==============================================================================
1380+ F1D4              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
1381+ F1D4              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
1382+ F1D4              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
1383+ F1D4              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
1384+ F1D4              ; raw, asi que usamos esos labels directamente.
1385+ F1D4              HealthVariantPtrs:
1386+ F1D4 05               DEFB 5                              ; 5 variantes (1 byte count)
1387+ F1D5 89 E7            DEFW BgGfx_health_pickup            ; canonical (id 254, pan)
1388+ F1D7 A9 F1            DEFW BgGfx_health_pickup_72         ; variant id 72 (queso)
1389+ F1D9 FB F1            DEFW BgGfx_health_pickup_3          ; variant id 74 (chorizo)
1390+ F1DB 24 F2            DEFW BgGfx_health_pickup_4          ; variant id 75 (leche)
1391+ F1DD 38 F4            DEFW BgGfx_health_pickup_5          ; variant id 85 (pollo)
1392+ F1DF
1393+ F1DF              StaminaVariantPtrs:
1394+ F1DF 04               DEFB 4                              ; 4 variantes
1395+ F1E0 B2 E7            DEFW BgGfx_stamina_pickup           ; canonical (id 255, jarra de vino)
1396+ F1E2 D2 F1            DEFW BgGfx_stamina_pickup_2         ; variant id 73 (taza de cafe)
1397+ F1E4 61 F4            DEFW BgGfx_stamina_pickup_3         ; variant id 79 (pocion)
1398+ F1E6 8A F4            DEFW BgGfx_stamina_pickup_4         ; variant id 84 (copa de brandy)
1399+ F1E8
1400+ F1E8              ; ==============================================================================
1401+ F1E8              ; PickRandomVariantPtr / LookupVariantPtrByIdx
1402+ F1E8              ; ==============================================================================
1403+ F1E8              ; PickRandomVariantPtr: elige variante random Y la persiste en RP_TmpVariant.
1404+ F1E8              ;   IN:  HL = ptr a tabla "DEFB count, DEFW ptr1, DEFW ptr2, ..."
1405+ F1E8              ;   OUT: HL = sprite ptr de la variante elegida.
1406+ F1E8              ;   Side: RP_TmpVariant ← idx elegido (0..count-1), para que la cache pueda
1407+ F1E8              ;         rotarlo y reusarlo al revisitar la sala.
1408+ F1E8              ;
1409+ F1E8              ; LookupVariantPtrByIdx: lookup directo SIN random (para cache hit que ya tiene
1410+ F1E8              ;                       el idx que quiere reusar).
1411+ F1E8              ;   IN:  HL = ptr a tabla, A = idx (0..count-1)
1412+ F1E8              ;   OUT: HL = sprite ptr de la variante[idx].
1413+ F1E8              ;   Side: ninguno (NO toca RP_TmpVariant — el caller lo gestiona).
1414+ F1E8              ;
1415+ F1E8              ; Destruye: AF, BC, DE (ambas rutinas).
1416+ F1E8              ; ==============================================================================
1417+ F1E8              PickRandomVariantPtr:
1418+ F1E8 7E               LD A, (HL)                          ; A = count
1419+ F1E9 47               LD B, A
1420+ F1EA ED 5F            LD A, R
1421+ F1EC              .pvpModLoop:
1422+ F1EC 90               SUB B
1423+ F1ED 30 FD            JR NC, .pvpModLoop
1424+ F1EF 80               ADD A, B                            ; A = R mod count (0..count-1)
1425+ F1F0 32 D8 5F         LD (RP_TmpVariant), A               ; persistir para cache rotation
1426+ F1F3                  ; fall through a LookupVariantPtrByIdx (HL aun apunta al count byte, A = idx)
1427+ F1F3              LookupVariantPtrByIdx:
1428+ F1F3 23               INC HL                              ; HL @ first DEFW
1429+ F1F4 87               ADD A, A                            ; idx*2 (DEFW = 2 B)
1430+ F1F5 5F               LD E, A
1431+ F1F6 16 00            LD D, 0
1432+ F1F8 19               ADD HL, DE                          ; HL @ entry elegida
1433+ F1F9 7E               LD A, (HL)
1434+ F1FA 23               INC HL
1435+ F1FB 66               LD H, (HL)
1436+ F1FC 6F               LD L, A                             ; HL = sprite ptr
1437+ F1FD C9               RET
1438+ F1FE
# file closed: random_pickups.asm
