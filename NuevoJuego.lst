 607+ E7CC              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 608+ E7CC              ; ==============================================================================
 609+ E7CC
 610+ E7CC              ; ==============================================================================
 611+ E7CC              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 612+ E7CC              ; ==============================================================================
 613+ E7CC              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 614+ E7CC              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 615+ E7CC              ; ==============================================================================
 616+ E7CC              BuildPlazaScanAddrs:
 617+ E7CC                  ; Calcular pixel coords del top-left de la esfera
 618+ E7CC 3A 6E 90         LD A, (PlazaClockCharY)
 619+ E7CF 07               RLCA
 620+ E7D0 07               RLCA
 621+ E7D1 07               RLCA
 622+ E7D2 57               LD D, A                     ; D = pixelY = charY * 8
 623+ E7D3 3A 6D 90         LD A, (PlazaClockCharX)
 624+ E7D6 07               RLCA
 625+ E7D7 07               RLCA
 626+ E7D8 07               RLCA
 627+ E7D9 5F               LD E, A                     ; E = pixelX = charX * 8
 628+ E7DA CD BA A0         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 629+ E7DD
 630+ E7DD DD 21 6F 90      LD IX, PlazaScanAddrs
 631+ E7E1 06 10            LD B, 16
 632+ E7E3              .buildLoop:
 633+ E7E3 DD 75 00         LD (IX+0), L
 634+ E7E6 DD 74 01         LD (IX+1), H
 635+ E7E9 DD 23            INC IX
 636+ E7EB DD 23            INC IX
 637+ E7ED 05               DEC B
 638+ E7EE C8               RET Z
 639+ E7EF CD 26 9E         CALL NextPixelLine
 640+ E7F2 18 EF            JR .buildLoop
