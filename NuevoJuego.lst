  45+ 910E 0F               RRCA
  46+ 910F E6 1F            AND $1F
  47+ 9111 32 18 9B         LD (MaiFlowPlCy), A
  48+ 9114
  49+ 9114                  ; --- Swap a stack temporal (bank 2) ---
  50+ 9114 ED 73 1E 9B      LD (MaiFlowSavedSP), SP
  51+ 9118 31 BE 9B         LD SP, MaiTempStackTop
  52+ 911B
  53+ 911B                  ; --- Ventana de paginacion ---
  54+ 911B                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 911B F3               DI
  56+ 911C 3A E8 90         LD A, (CurrentPaging)
  57+ 911F E6 F8            AND $F8
  58+ 9121 F6 06            OR 6
  59+ 9123 32 E8 90         LD (CurrentPaging), A
  60+ 9126 01 FD 7F         LD BC, $7FFD
  61+ 9129 ED 79            OUT (C), A
  62+ 912B
  63+ 912B                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 912B CD 47 91         CALL MaiFlowBfs
  65+ 912E
  66+ 912E                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 912E 3A E8 90         LD A, (CurrentPaging)
  68+ 9131 E6 F8            AND $F8
  69+ 9133 32 E8 90         LD (CurrentPaging), A
  70+ 9136 01 FD 7F         LD BC, $7FFD
  71+ 9139 ED 79            OUT (C), A
  72+ 913B
  73+ 913B ED 7B 1E 9B      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 913F 3A 4A 81         LD A, (StartupComplete)
  75+ 9142 B7               OR A
  76+ 9143 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 9145 FB               EI
  78+ 9146              .mcffNoEI:
  79+ 9146 C9               RET
