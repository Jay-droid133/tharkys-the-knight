 684+ FB6D
 685+ FB6D              ; ==============================================================================
 686+ FB6D              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 687+ FB6D              ; ==============================================================================
 688+ FB6D              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 689+ FB6D              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 690+ FB6D              ;
 691+ FB6D              ; Estado:
 692+ FB6D              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 693+ FB6D              ;   BankCutsceneTimer:    decrementa por frame
 694+ FB6D              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 695+ FB6D              ;
 696+ FB6D              ; Logica:
 697+ FB6D              ;   - Tick timer. Si != 0, return 0.
 698+ FB6D              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 699+ FB6D              ;   - Si SubState=GAP y timer=0:
 700+ FB6D              ;       - increment KnockIdx
 701+ FB6D              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 702+ FB6D              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 703+ FB6D              ;
 704+ FB6D              ; Destruye: A, BC, DE, HL.
 705+ FB6D              ; ==============================================================================
 706+ FB6D              BankCutsceneTickKnockGroup:
 707+ FB6D 47               LD B, A                             ; B = total knocks
 708+ FB6E 3A CD 82         LD A, (BankCutsceneTimer)
 709+ FB71 3D               DEC A
 710+ FB72 32 CD 82         LD (BankCutsceneTimer), A
 711+ FB75 B7               OR A
 712+ FB76 28 02            JR Z, .bctkgTimer0
 713+ FB78 AF               XOR A                               ; sigue, no terminado
 714+ FB79 C9               RET
 715+ FB7A              .bctkgTimer0:
 716+ FB7A 3A CE 82         LD A, (BankCutsceneSubState)
 717+ FB7D B7               OR A
 718+ FB7E 20 0C            JR NZ, .bctkgGap0
 719+ FB80                  ; HIT acabo: switch a GAP.
 720+ FB80 3E 01            LD A, BCS_KNOCK_GAP
 721+ FB82 32 CE 82         LD (BankCutsceneSubState), A
 722+ FB85 3E 05            LD A, BCS_T_KNOCK_GAP
 723+ FB87 32 CD 82         LD (BankCutsceneTimer), A
 724+ FB8A AF               XOR A
 725+ FB8B C9               RET
 726+ FB8C              .bctkgGap0:
 727+ FB8C                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 728+ FB8C 3A CF 82         LD A, (BankCutsceneKnockIdx)
 729+ FB8F 3C               INC A
 730+ FB90 32 CF 82         LD (BankCutsceneKnockIdx), A
 731+ FB93 B8               CP B
 732+ FB94 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 733+ FB96                  ; grupo terminado.
 734+ FB96 3E 01            LD A, 1
 735+ FB98 C9               RET
 736+ FB99              .bctkgNextHit:
 737+ FB99 3E 00            LD A, BCS_KNOCK_HIT
 738+ FB9B 32 CE 82         LD (BankCutsceneSubState), A
 739+ FB9E 3E 04            LD A, BCS_T_KNOCK_HIT
 740+ FBA0 32 CD 82         LD (BankCutsceneTimer), A
 741+ FBA3 CD A8 FB         CALL BankCutsceneEmitKnockHit
 742+ FBA6 AF               XOR A
 743+ FBA7 C9               RET
 744+ FBA8
 745+ FBA8              ; ==============================================================================
 746+ FBA8              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 747+ FBA8              ; ==============================================================================
 748+ FBA8              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 749+ FBA8              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 750+ FBA8              ; Destruye: A, BC, DE, HL.
 751+ FBA8              ; ==============================================================================
 752+ FBA8              BankCutsceneEmitKnockHit:
 753+ FBA8 C3 13 FC         JP SFX_Bank_OnKnock                 ; tail-call
 754+ FBAB
 755+ FBAB              ; ==============================================================================
 756+ FBAB              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 757+ FBAB              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 758+ FBAB              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 759+ FBAB              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 760+ FBAB              ; oscuridad de la rendija".
 761+ FBAB              BCS_DOOR_HAND_ATTR      EQU $47
 762+ FBAB
 763+ FBAB              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 764+ FBAB              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 765+ FBAB              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 766+ FBAB              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 767+ FBAB              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 768+ FBAB
 769+ FBAB              ; ==============================================================================
 770+ FBAB              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 771+ FBAB              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 772+ FBAB              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 773+ FBAB              ; pixels visibles bright white sobre fondo negro.
 774+ FBAB              ;
 775+ FBAB              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 776+ FBAB              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 777+ FBAB              ; dos llamadas no cancelan, solo re-pintan.
 778+ FBAB              ; Destruye: AF, BC, DE, HL, IX.
 779+ FBAB              ; ==============================================================================
 780+ FBAB              BankCutsceneOpenDoorWithHandAttrs:
 781+ FBAB 21 FA F0         LD HL, BgGfx_bank_door_closed
 782+ FBAE 3E 03            LD A, 3                             ; bank 3
 783+ FBB0 CD C2 6A         CALL LoadBgSpriteToBuffer
 784+ FBB3 DD 21 F8 86      LD IX, BgSpriteBuffer
 785+ FBB7 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 786+ FBB9 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 787+ FBBB CD 33 DB         CALL DrawBgSpriteXOR                ; XOR-cancel pixels (attrs intactos $78)
 788+ FBBE                  ; Sobreescribir attrs a "hand mode" = $47.
 789+ FBBE 3E 47            LD A, BCS_DOOR_HAND_ATTR
 790+ FBC0 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 791+ FBC3 77               LD (HL), A
 792+ FBC4 23               INC HL                              ; $58D0 (16, 4)
 793+ FBC5 77               LD (HL), A
 794+ FBC6 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 795+ FBC9 77               LD (HL), A
 796+ FBCA 23               INC HL                              ; $58F0 (16, 5)
 797+ FBCB 77               LD (HL), A
 798+ FBCC C9               RET
 799+ FBCD
 800+ FBCD              ; ==============================================================================
 801+ FBCD              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 802+ FBCD              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 803+ FBCD              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 804+ FBCD              ;
 805+ FBCD              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 806+ FBCD              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 807+ FBCD              ; Destruye: AF, BC, DE, HL, IX.
 808+ FBCD              ; ==============================================================================
 809+ FBCD              BankCutsceneCloseDoorRestoreAttrs:
 810+ FBCD 21 FA F0         LD HL, BgGfx_bank_door_closed
 811+ FBD0 3E 03            LD A, 3
 812+ FBD2 CD C2 6A         CALL LoadBgSpriteToBuffer
 813+ FBD5 DD 21 F8 86      LD IX, BgSpriteBuffer
 814+ FBD9 06 0F            LD B, BCS_DOOR_CHARX
 815+ FBDB 0E 04            LD C, BCS_DOOR_CHARY
 816+ FBDD AF               XOR A
 817+ FBDE 32 2B E2         LD (BgSpriteIsHouse), A
 818+ FBE1                  ; CurrentTintVar = $FF (no tint). El sprite door tiene tintPaper=7 y attr
 819+ FBE1                  ; paper=7 — si CurrentTintVar fuera 0, ApplyTintSwap pondria paper=0 → todo
 820+ FBE1                  ; negro. Con $FF (= "sin tint") la attr queda intacta a su valor original.
 821+ FBE1 3E FF            LD A, $FF
 822+ FBE3 32 F4 D1         LD (CurrentTintVar), A
 823+ FBE6 C3 EA D0         JP DrawBgGfxSprite                  ; SET pixels + PAINT attrs ($78) sin tint
 824+ FBE9
 825+ FBE9              ; ==============================================================================
 826+ FBE9              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 827+ FBE9              ; ==============================================================================
 828+ FBE9              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 829+ FBE9              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 830+ FBE9              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 831+ FBE9              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 832+ FBE9              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 833+ FBE9              ; Destruye: AF, BC, DE, HL, IX.
 834+ FBE9              ; ==============================================================================
 835+ FBE9              BankCutsceneDrawHand:
 836+ FBE9 3A D1 82         LD A, (BankCutsceneHandFrame)
 837+ FBEC B7               OR A
 838+ FBED 20 05            JR NZ, .bcdhFrame1
 839+ FBEF 21 44 FC         LD HL, BgGfx_BankHandFrame0
 840+ FBF2 18 03            JR .bcdhCopy
 841+ FBF4              .bcdhFrame1:
 842+ FBF4 21 66 FC         LD HL, BgGfx_BankHandFrame1
 843+ FBF7              .bcdhCopy:
 844+ FBF7 11 F8 86         LD DE, BgSpriteBuffer
 845+ FBFA 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
 846+ FBFD ED B0            LDIR
 847+ FBFF 16 30            LD D, BCS_HAND_PX_Y
 848+ FC01 1E 78            LD E, BCS_HAND_PX_X
 849+ FC03 C3 31 69         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
 850+ FC06
 851+ FC06              ; ==============================================================================
 852+ FC06              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
 853+ FC06              ; ==============================================================================
 854+ FC06              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
 855+ FC06              ; Destruye: AF, BC, DE, HL, IX.
 856+ FC06              ; ==============================================================================
 857+ FC06              BankCutsceneEraseHand:
 858+ FC06 C3 E9 FB         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
 859+ FC09
 860+ FC09              ; ==============================================================================
 861+ FC09              ; Player redraw helpers — REUSADOS de town_gate_cutscene.asm (slot 1, always-vis):
 862+ FC09              ;   TownGateRedrawPlayer:    erase old + draw new (cambio sprite/posicion).
 863+ FC09              ;   TownGateDrawPlayerHere:  draw + attrs en (ENT_DRAWX, PlayerDrawY).
 864+ FC09              ;   TownGateErasePlayer:     XOR-erase en (ENT_OLDX, ENT_OLDY) + RestoreOldAttr.
 865+ FC09              ; Son rutinas puras del estado del player (no tocan ninguna var de town_gate),
 866+ FC09              ; asi que invocarlas desde aqui (bank 0) ahorra ~85 B sin cambiar comportamiento.
 867+ FC09              ; ==============================================================================
 868+ FC09
 869+ FC09              ; ==============================================================================
 870+ FC09              ; BankCutsceneDecTimer - decrementa BankCutsceneTimer, devuelve Z si llego a 0
 871+ FC09              ; ==============================================================================
 872+ FC09              BankCutsceneDecTimer:
 873+ FC09 3A CD 82         LD A, (BankCutsceneTimer)
 874+ FC0C 3D               DEC A
 875+ FC0D 32 CD 82         LD (BankCutsceneTimer), A
 876+ FC10 B7               OR A
 877+ FC11 C9               RET
 878+ FC12
 879+ FC12              ; ==============================================================================
 880+ FC12              ; SFX stubs — placeholders RET. Rellenar con AY_PlayBeep / PlaySFX cuando
 881+ FC12              ; se diseñen los timbres.
 882+ FC12              ; ==============================================================================
 883+ FC12              SFX_Bank_OnStart:
 884+ FC12 C9               RET
 885+ FC13              ; Knock: dispatch entre soft (grupos 1, 2) y loud (grupo 3) segun
 886+ FC13              ; BankCutsceneKnockType (set por la fase de entrada al grupo). Duracion
 887+ FC13              ; comun 4 frames (~160ms).
 888+ FC13              SFX_Bank_OnKnock:
 889+ FC13 3A D2 82         LD A, (BankCutsceneKnockType)
 890+ FC16 B7               OR A
 891+ FC17 20 05            JR NZ, .sokLoud
 892+ FC19 06 04            LD B, 4
 893+ FC1B C3 F0 6D         JP AY_PlayKnockSoft                 ; tail-call (grupos 1, 2: 3 knocks)
 894+ FC1E              .sokLoud:
 895+ FC1E 06 04            LD B, 4
 896+ FC20 C3 F5 6D         JP AY_PlayKnockLoud                 ; tail-call (grupo 3: 6 knocks)
 897+ FC23              SFX_Bank_OnDoorCreak:                   ; antes SFX_Bank_OnDoorOpen
 898+ FC23                  ; TODO: crujido leve para sugerir que la puerta cede mientras la mano
 899+ FC23                  ; sale por la rendija (la puerta nunca se abre del todo).
 900+ FC23 C9               RET
 901+ FC24              ; Cuando la puerta del banco se abre (PRE_HAND), reusamos el mismo crujido
 902+ FC24              ; de puerta vieja que la iglesia (.cbtActChurchDoor en screen_system.asm).
 903+ FC24              SFX_Bank_OnHandIn:
 904+ FC24 21 59 F7         LD HL, SFX_ChurchDoorOpen
 905+ FC27 C3 42 F6         JP PlaySFX                          ; tail-call
 906+ FC2A              ; SFX_Bank_OnNoSwap — dos tonos alternos por swap ("uh-oh" cartoonish).
 907+ FC2A              ; Llamado AL HACER swap, justo despues de XOR'ar BankCutsceneHandFrame:
 908+ FC2A              ;   swap 1: HandFrame=1 → aguda
 909+ FC2A              ;   swap 2: HandFrame=0 → grave
 910+ FC2A              ;   ...
 911+ FC2A              ;   swap 8: HandFrame=0 → grave
 912+ FC2A              ; → Patron 8 swaps: A G A G A G A G (4 ciclos "uh-oh").
 913+ FC2A              ; AY_PlayBeep es no-bloqueante (cutoff via BeepDurationFrames + ticker IRQ).
 914+ FC2A              SFX_Bank_OnNoSwap:
 915+ FC2A 3A D1 82         LD A, (BankCutsceneHandFrame)
 916+ FC2D B7               OR A
 917+ FC2E 28 05            JR Z, .nsLow
 918+ FC30 21 50 01         LD HL, BCS_NO_PERIOD_HI
 919+ FC33 18 03            JR .nsPlay
 920+ FC35              .nsLow:
 921+ FC35 21 A8 01         LD HL, BCS_NO_PERIOD_LO
 922+ FC38              .nsPlay:
 923+ FC38 06 06            LD B, BCS_NO_DUR_FRAMES
 924+ FC3A C3 CA 6D         JP AY_PlayBeep                      ; tail-call
 925+ FC3D              ; Cuando la puerta del banco se cierra (HAND_OUT, tras erase mano + redraw
 926+ FC3D              ; door), reusamos el mismo crujido de puerta vieja que la iglesia. La
 927+ FC3D              ; iglesia tambien comparte SFX_ChurchDoorOpen para abrir y cerrar (ver
 928+ FC3D              ; CloseChurchDoor en church_cutscene.asm:610).
 929+ FC3D              SFX_Bank_OnHandOut:
 930+ FC3D 21 59 F7         LD HL, SFX_ChurchDoorOpen
 931+ FC40 C3 42 F6         JP PlaySFX                          ; tail-call
 932+ FC43              SFX_Bank_OnPlayerTurn:
 933+ FC43 C9               RET
