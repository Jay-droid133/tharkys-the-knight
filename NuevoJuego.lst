 551+ 7F33 3E 02            LD A, 2
 552+ 7F35 CD BB 7D         CALL AY_WriteRegSlot1
 553+ 7F38 2A AC 7B         LD HL, (MusicPeriodB)
 554+ 7F3B 5C               LD E, H
 555+ 7F3C 3E 03            LD A, 3
 556+ 7F3E CD BB 7D         CALL AY_WriteRegSlot1
 557+ 7F41              .map3DoC:
 558+ 7F41                  ; --- Canal C: R4/R5 + R10 ---
 559+ 7F41 2A AE 7B         LD HL, (MusicPeriodC)
 560+ 7F44 7C               LD A, H
 561+ 7F45 B5               OR L
 562+ 7F46 20 07            JR NZ, .map3NoteC
 563+ 7F48 3E 0A            LD A, 10
 564+ 7F4A 1E 00            LD E, 0
 565+ 7F4C C3 BB 7D         JP AY_WriteRegSlot1             ; tail-call
 566+ 7F4F              .map3NoteC:
 567+ 7F4F E5               PUSH HL
 568+ 7F50 3E 0A            LD A, 10
 569+ 7F52 1E 0C            LD E, 12
 570+ 7F54 CD BB 7D         CALL AY_WriteRegSlot1
 571+ 7F57 E1               POP HL
 572+ 7F58 5D               LD E, L
 573+ 7F59 3E 04            LD A, 4
 574+ 7F5B CD BB 7D         CALL AY_WriteRegSlot1
 575+ 7F5E 2A AE 7B         LD HL, (MusicPeriodC)
 576+ 7F61 5C               LD E, H
 577+ 7F62 3E 05            LD A, 5
 578+ 7F64 C3 BB 7D         JP AY_WriteRegSlot1             ; tail-call
