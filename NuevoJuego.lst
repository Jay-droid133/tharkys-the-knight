 454  8173 CD DB FB         CALL UpdateMonstersMusic    ; Secuencer "po-po-popo-po" (canal B AY) durante la noche
 455  8176 CD 3F F4         CALL UpdateStatueBlink      ; Parpadeo ON-OFF de la estatua que se enciende
 456  8179                  ; AY_UpdateBell removido: bell decay tickea ahora en MusicIrqHandler
 457  8179                  ; (BellTickIrq, slot 1) cada 25 Hz, inmune a la latencia de MainLoop /
 458  8179                  ; DrawScreen. Antes la campanada se "alargaba" o "apagaba raro" en
 459  8179                  ; transiciones porque el catchup desde MainLoop daba saltos.
 460  8179 CD 26 B6         CALL UpdateScareTimer       ; Countdown pausa+huida (bells/dawn)
 461  817C CD 88 E4         CALL CheckDebugKeys         ; Tecla T: ciclar momento del dia (debug)
 462  817F CD 2F F0         CALL CheckMilestoneDebugKey ; Tecla H: skip de hito (debug)
 463  8182 CD 60 F0         CALL CheckCurrentKeyCycleKey ; Tecla K: cicla CurrentKey 0..6 (debug)
 464  8185 CD 0B FC         CALL CheckMinimapKey        ; Tecla M: overlay de minimap
 465  8188              .skipUpdates:
