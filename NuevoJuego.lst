 189+ E688              ; ==============================================================================
 190+ E688              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ E688              ; ==============================================================================
 192+ E688              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ E688              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ E688              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ E688              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ E688              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ E688              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ E688              ; Destruye: AF, BC, DE, HL, IX.
 199+ E688              ; ==============================================================================
 200+ E688              StartTownGateCutscene:
 201+ E688 AF               XOR A
 202+ E689 32 B6 82         LD (CurrentKey), A
 203+ E68C CD DD E8         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ E68F CD E4 6E         CALL KillAllActiveNasties_B7           ; nasties → puff (animan en WAIT_NASTIES)
 205+ E692 CD EA 6E         CALL KillDeathIfActive_B7              ; muerte (slot 11) → puff y despawn
 206+ E695 CD 9D EA         CALL SFX_TownGate_OnStart
 207+ E698 3E 10            LD A, TGP_WAIT_NASTIES
 208+ E69A 32 D0 82         LD (TownGatePhase), A
 209+ E69D 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ E69F 32 A5 5F         LD (TownGateTimer), A
 211+ E6A2 C9               RET
 212+ E6A3
 213+ E6A3              ; KillDeathIfActive: vive en slot 1 (town_gate_cutscene.asm) — llamada por
 214+ E6A3              ; bank_cutscene via KillDeathIfActive_B7. NO duplicar aqui.
 215+ E6A3
 216+ E6A3              ; ==============================================================================
 217+ E6A3              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 218+ E6A3              ; ==============================================================================
 219+ E6A3              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 220+ E6A3              ; transicion a la siguiente.
 221+ E6A3              ; Destruye: AF, BC, DE, HL, IX.
 222+ E6A3              ; ==============================================================================
 223+ E6A3              UpdateTownGateCutsceneBody:
 224+ E6A3 3A D0 82         LD A, (TownGatePhase)
 225+ E6A6 FE 10            CP TGP_WAIT_NASTIES
 226+ E6A8 CA E3 E6         JP Z, .tgPhWaitNasties              ; pre-LOCK wait, ProcessEnemies sigue corriendo
 227+ E6AB FE 11            CP TGP_WALK_TO_ANCHOR
 228+ E6AD CA 02 E7         JP Z, .tgPhWalkToAnchor              ; player camina autonomo a anchor1
 229+ E6B0 3D               DEC A
 230+ E6B1 CA 88 E7         JP Z, .tgPhLock
 231+ E6B4 3D               DEC A
 232+ E6B5 CA A0 E7         JP Z, .tgPhArmIn
 233+ E6B8 3D               DEC A
 234+ E6B9 CA B8 E7         JP Z, .tgPhFingerIn
 235+ E6BC 3D               DEC A
 236+ E6BD CA D1 E7         JP Z, .tgPhShake
 237+ E6C0 3D               DEC A
 238+ E6C1 CA E9 E7         JP Z, .tgPhFingerPulse
 239+ E6C4 3D               DEC A
 240+ E6C5 CA 01 E8         JP Z, .tgPhFingerOut
 241+ E6C8 3D               DEC A
 242+ E6C9 CA 10 E8         JP Z, .tgPhArmHold
 243+ E6CC 3D               DEC A
 244+ E6CD CA 28 E8         JP Z, .tgPhArmOut
 245+ E6D0 3D               DEC A
 246+ E6D1 CA 4D E8         JP Z, .tgPhPlayerTurn
 247+ E6D4 3D               DEC A                               ; phase 10 (PLAYER_HIDE) deprecated
 248+ E6D5 3D               DEC A                               ; phase 11 (PLAYER_FRAMED) deprecated
 249+ E6D6 3D               DEC A
 250+ E6D7 CA 82 E8         JP Z, .tgPhPlayerExit
 251+ E6DA 3D               DEC A
 252+ E6DB CA B2 E8         JP Z, .tgPhEndHold
 253+ E6DE 3D               DEC A
 254+ E6DF CA C4 E8         JP Z, .tgPhBlack
 255+ E6E2                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 256+ E6E2 C9               RET
 257+ E6E3
 258+ E6E3              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 259+ E6E3              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 260+ E6E3              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 261+ E6E3              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 262+ E6E3              ;
 263+ E6E3              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 264+ E6E3              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 265+ E6E3              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 266+ E6E3              ; capturamos para meterlos en STATE_DYING.
 267+ E6E3              .tgPhWaitNasties:
 268+ E6E3 CD E4 6E         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 269+ E6E6 CD 21 63         CALL TownGateAllNastiesDeadCheck
 270+ E6E9 28 07            JR Z, .tgWaitNastiesDone
 271+ E6EB                  ; RestoreOldAttr de puffs vecinos sobreescribe attrs del player cada frame.
 272+ E6EB                  ; Repintar para que el color (buff o blanco) no se pierda mientras esperamos.
 273+ E6EB CD D5 6E         CALL TownGateRedrawPlayer_B7
 274+ E6EE CD D4 E8         CALL TownGateDecTimer               ; safety timeout
 275+ E6F1 C0               RET NZ
 276+ E6F2              .tgWaitNastiesDone:
 277+ E6F2 CD D5 6E         CALL TownGateRedrawPlayer_B7
 278+ E6F5 AF               XOR A
 279+ E6F6 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 280+ E6F9 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 281+ E6FC 3E 11            LD A, TGP_WALK_TO_ANCHOR
 282+ E6FE 32 D0 82         LD (TownGatePhase), A
 283+ E701 C9               RET
