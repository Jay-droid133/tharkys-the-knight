 689+ 90AF 47               LD B, A                         ; B = total count
 690+ 90B0 23               INC HL                          ; HL = first entry
 691+ 90B1
 692+ 90B1                  ; --- Pass 1: count entries matching wantSide ---
 693+ 90B1 E5               PUSH HL                         ; save entries ptr
 694+ 90B2 C5               PUSH BC                         ; save B (total)
 695+ 90B3 0E 00            LD C, 0                         ; C = match count
