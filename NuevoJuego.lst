2631+ AD2A              .eDeltaYNeg:
2632+ AD2A 78               LD A, B
2633+ AD2B 81               ADD A, C
2634+ AD2C 38 04            JR C, .eCheckMinY
2635+ AD2E 3E 10            LD A, SCREEN_MIN_Y
2636+ AD30 18 16            JR .eReverseY
2637+ AD32              .eCheckMinY:
2638+ AD32 FE 10            CP SCREEN_MIN_Y
