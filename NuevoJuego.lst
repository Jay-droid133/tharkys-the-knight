 150+ DDA3              ; Anchor del player durante la cinematica — siempre centrado horizontalmente
 151+ DDA3              ; con la puerta (chars 15-16, centro X = 128; player 16 px ancho → POSX = 120).
 152+ DDA3              ;
 153+ DDA3              ; Y depende de la sub-fase:
 154+ DDA3              ;   KNOCK   → 1 px de hueco bajo la puerta (door_bottom 63 → POSY 65; px 64 vacio).
 155+ DDA3              ;   RETREAT → 1 char (8 px) bajo la puerta (POSY 72; px 64-71 vacios).
 156+ DDA3              BCS_PLAYER_ANCHOR_X     EQU 120
 157+ DDA3              BCS_PLAYER_ANCHOR_Y     EQU 65      ; KNOCK: 1 px hueco bajo la puerta
 158+ DDA3              BCS_PLAYER_RETREAT_Y    EQU 72      ; RETREAT: 1 char (8 px) hueco
 159+ DDA3              BCS_PLAYER_BACKOFF_Y    EQU 80      ; BACKOFF: 2 char (16 px) hueco — reaccion al portazo final
 160+ DDA3                                                  ; (player baja 1 char extra vs RETREAT al cierre tras "no no")
 161+ DDA3
 162+ DDA3              ; Posicion de la puerta del banco — confirmada por el usuario en el editor:
 163+ DDA3              ; Cell (8,8), char (15, 4). Asumo tamaño 2x2 chars (16x16 px) — mismo
 164+ DDA3              ; tamaño que el sprite de la mano. Si el sprite real BankDoorOpen es
 165+ DDA3              ; mas grande (e.g. 3x3 o 4x4), ajustar BCS_DOOR_CHAR_W/H.
 166+ DDA3              ;
 167+ DDA3              ; Bank facade en char (12, 0), 64x48 px → (12-19, 0-5). Door en (15, 4)
 168+ DDA3              ; cae en la mitad inferior central de la facade. Pixel coords con
 169+ DDA3              ; BG_Y_OFFSET=2: top-left = (15*8, (4+2)*8) = (120, 48).
 170+ DDA3              BCS_DOOR_CHARX          EQU 15
 171+ DDA3              BCS_DOOR_CHARY          EQU 4
 172+ DDA3              BCS_DOOR_CHAR_W         EQU 2       ; ancho en chars (16 px)
 173+ DDA3              BCS_DOOR_CHAR_H         EQU 2       ; alto en chars (16 px)
 174+ DDA3
 175+ DDA3              ; AABB en pixels (derivado de char coords)
 176+ DDA3              BCS_DOOR_PX_LEFT        EQU 120     ; 15*8
 177+ DDA3              BCS_DOOR_PX_RIGHT       EQU 135     ; 120 + 16 - 1
 178+ DDA3              BCS_DOOR_PX_TOP         EQU 48      ; (4+2)*8
 179+ DDA3              BCS_DOOR_PX_BOTTOM      EQU 63      ; 48 + 16 - 1
 180+ DDA3              BCS_DOOR_TOLERANCE      EQU 4       ; mismo margen que CheckTownGateTriggerBg
 181+ DDA3
 182+ DDA3              ; Posicion de la mano cuando asoma (centrada en el hueco de la puerta)
 183+ DDA3              BCS_HAND_PX_X           EQU 120     ; mismo X que la puerta (16x16 sprite)
 184+ DDA3              BCS_HAND_PX_Y           EQU 48      ; mismo Y que la puerta
 185+ DDA3
 186+ DDA3              ; Posicion (char) donde se dibuja BankKey al final — placeholder
 187+ DDA3              ; (suelo justo delante de la puerta)
 188+ DDA3              BCS_KEY_DROP_CHARX      EQU 15
 189+ DDA3              BCS_KEY_DROP_CHARY      EQU 7
 190+ DDA3
 191+ DDA3              ; Trigger requirements
 192+ DDA3              BCS_REQUIRED_KEY        EQU 7       ; BankCheck (slot 7 en KeyLockTable, NUEVO)
 193+ DDA3
 194+ DDA3              ; ==============================================================================
 195+ DDA3              ; CheckBankTriggerBg - bump-trigger del banco (BG sprite, no en PickupTable)
 196+ DDA3              ; ==============================================================================
 197+ DDA3              ; Llamada cada frame desde MainLoop tras CheckBumpTriggers (gemelo de
 198+ DDA3              ; CheckTownGateTriggerBg). Mismo test AABB ±BCS_DOOR_TOLERANCE.
 199+ DDA3              ;
 200+ DDA3              ; Dispara: BankCutscenePhase==0, CurrentKey==7 (BankCheck), sala (8,8),
 201+ DDA3              ; player AABB (16x21) overlapea rect de la puerta. HIT → StartBankCutscene
 202+ DDA3              ; + CheckMilestoneTrigger(4) (avanza M9).
 203+ DDA3              ; Destruye: AF, BC, DE, HL, IX.
 204+ DDA3              ;
 205+ DDA3              ; NOTA: llamado a traves del thunk CheckBankTriggerBg (slot 1), que pagina
 206+ DDA3              ; bank 7 antes de saltar aqui. Por eso este label es ...Body (el nombre publico
 207+ DDA3              ; sin sufijo lo lleva el thunk).
 208+ DDA3              ; ==============================================================================
 209+ DDA3              CheckBankTriggerBgBody:
 210+ DDA3 3A CE 82         LD A, (BankCutscenePhase)
 211+ DDA6 B7               OR A
 212+ DDA7 C0               RET NZ                              ; ya en cutscene
 213+ DDA8 3A B3 82         LD A, (CurrentKey)
 214+ DDAB FE 07            CP BCS_REQUIRED_KEY
 215+ DDAD C0               RET NZ                              ; sin cheque
 216+ DDAE 3A 0D 83         LD A, (CurrentScreenX)
 217+ DDB1 FE 08            CP BCS_BANK_ROOM_X
 218+ DDB3 C0               RET NZ
 219+ DDB4 3A 0E 83         LD A, (CurrentScreenY)
 220+ DDB7 FE 08            CP BCS_BANK_ROOM_Y
 221+ DDB9 C0               RET NZ
 222+ DDBA                  ; --- Horizontal AABB ---
 223+ DDBA 3A A3 81         LD A, (EntityTable + ENT_POSX)
 224+ DDBD 4F               LD C, A                             ; C = player_left
 225+ DDBE C6 10            ADD A, 16
 226+ DDC0 57               LD D, A                             ; D = player_right
 227+ DDC1 3E 78            LD A, BCS_DOOR_PX_LEFT
 228+ DDC3 D6 04            SUB BCS_DOOR_TOLERANCE
 229+ DDC5 30 01            JR NC, .cbtNoUnderL
 230+ DDC7 AF               XOR A
 231+ DDC8              .cbtNoUnderL:
 232+ DDC8 BA               CP D
 233+ DDC9 D0               RET NC
 234+ DDCA 3E 87            LD A, BCS_DOOR_PX_RIGHT
 235+ DDCC C6 04            ADD A, BCS_DOOR_TOLERANCE
 236+ DDCE 30 02            JR NC, .cbtNoOverR
 237+ DDD0 3E FF            LD A, $FF
 238+ DDD2              .cbtNoOverR:
 239+ DDD2 B9               CP C
 240+ DDD3 D8               RET C
 241+ DDD4                  ; --- Vertical AABB (player rect 16x21) ---
 242+ DDD4 3A A4 81         LD A, (EntityTable + ENT_POSY)
 243+ DDD7 4F               LD C, A
 244+ DDD8 C6 15            ADD A, 21
 245+ DDDA 57               LD D, A
 246+ DDDB 3E 30            LD A, BCS_DOOR_PX_TOP
 247+ DDDD D6 04            SUB BCS_DOOR_TOLERANCE
 248+ DDDF 30 01            JR NC, .cbtNoUnderT
 249+ DDE1 AF               XOR A
 250+ DDE2              .cbtNoUnderT:
 251+ DDE2 BA               CP D
 252+ DDE3 D0               RET NC
 253+ DDE4 3E 3F            LD A, BCS_DOOR_PX_BOTTOM
 254+ DDE6 C6 04            ADD A, BCS_DOOR_TOLERANCE
 255+ DDE8 30 02            JR NC, .cbtNoOverB
 256+ DDEA 3E FF            LD A, $FF
 257+ DDEC              .cbtNoOverB:
 258+ DDEC B9               CP C
 259+ DDED D8               RET C
 260+ DDEE                  ; HIT
 261+ DDEE CD F6 DD         CALL StartBankCutscene
 262+ DDF1 3E 04            LD A, 4                             ; action 4 = BankDoor
 263+ DDF3 C3 4E 6D         JP CheckMilestoneTrigger_B7         ; tail-call al thunk slot 1 (que repagina bank 7 antes de RET)
 264+ DDF6
 265+ DDF6              ; ==============================================================================
 266+ DDF6              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 267+ DDF6              ; ==============================================================================
 268+ DDF6              ; 1. NO consume cheque aqui — se consume despues, en la transicion
 269+ DDF6              ;    HAND_OPEN_IN -> HAND_OPEN_TAKE (la mano abierta "coge" el cheque
 270+ DDF6              ;    visualmente). El bloqueo del re-trigger lo da el check de phase != 0
 271+ DDF6              ;    en CheckBankTriggerBg.
 272+ DDF6              ; 2. Snap player a anchor frente a la puerta, facing N.
 273+ DDF6              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 274+ DDF6              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 275+ DDF6              ;    para limpiar la pantalla durante la cutscene.
 276+ DDF6              ; Destruye: AF, BC, DE, HL, IX.
 277+ DDF6              ; ==============================================================================
 278+ DDF6              StartBankCutscene:
 279+ DDF6 AF               XOR A
 280+ DDF7 32 D1 82         LD (BankCutsceneKnockIdx), A
 281+ DDFA 32 D0 82         LD (BankCutsceneSubState), A
 282+ DDFD 32 D2 82         LD (BankCutsceneNoIdx), A
 283+ DE00 32 D3 82         LD (BankCutsceneHandFrame), A
 284+ DE03                  ; Resetea el color del player al default (WHITE | $40 = $47). Si el player
 285+ DE03                  ; tenia color de un buff (speed, mushroom...) o de un hit (BLUE flash), se
 286+ DE03                  ; pierde aqui. Sino el player aparece tintado durante toda la cinematica.
 287+ DE03 3E 47            LD A, WHITE | $40
 288+ DE05 32 A5 81         LD (EntityTable + ENT_ATTR), A
 289+ DE08 CD 66 6D         CALL KillAllActiveNasties_B7           ; nasties → STATE_DYING + puff anim
 290+ DE0B CD 6C 6D         CALL KillDeathIfActive_B7               ; muerte (slot 11) → puff y despawn
 291+ DE0E                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 292+ DE0E                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 293+ DE0E                  ; cambiamos el sprite a facing N para preparar.
 294+ DE0E CD 91 DE         CALL BankCutsceneFacingNRedraw
 295+ DE11 CD 19 E2         CALL SFX_Bank_OnStart
 296+ DE14                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 297+ DE14                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 298+ DE14                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 299+ DE14 3E 64            LD A, BCS_T_PUFF_WAIT
 300+ DE16 32 CF 82         LD (BankCutsceneTimer), A
 301+ DE19 3E 11            LD A, BCP_WAIT_NASTIES
 302+ DE1B 32 CE 82         LD (BankCutscenePhase), A
 303+ DE1E C9               RET
 304+ DE1F
 305+ DE1F              ; ==============================================================================
 306+ DE1F              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 307+ DE1F              ; ==============================================================================
 308+ DE1F              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 309+ DE1F              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 310+ DE1F              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 311+ DE1F              BankCutsceneSnapToDoor:
 312+ DE1F DD 21 A0 81      LD IX, EntityTable
 313+ DE23 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 314+ DE27 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 315+ DE2B DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 316+ DE2F 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 317+ DE31 32 E1 82         LD (PlayerDrawY), A
 318+ DE34 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 319+ DE36 DD 77 00         LD (IX+ENT_SPRITEID), A
 320+ DE39 3E 0A            LD A, SPRID_WALK_N
 321+ DE3B DD 77 08         LD (IX+ENT_ANIMBASE), A
 322+ DE3E AF               XOR A
 323+ DE3F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 324+ DE42 C3 57 6D         JP TownGateRedrawPlayer_B7
 325+ DE45
 326+ DE45              ; ==============================================================================
 327+ DE45              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 328+ DE45              ; ==============================================================================
 329+ DE45              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 330+ DE45              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 331+ DE45              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 332+ DE45              BankCutsceneSnapToRetreat:
 333+ DE45 DD 21 A0 81      LD IX, EntityTable
 334+ DE49 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 335+ DE4D DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 336+ DE51 DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 337+ DE55 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 338+ DE57 32 E1 82         LD (PlayerDrawY), A
 339+ DE5A 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 340+ DE5C DD 77 00         LD (IX+ENT_SPRITEID), A
 341+ DE5F 3E 0A            LD A, SPRID_WALK_N
 342+ DE61 DD 77 08         LD (IX+ENT_ANIMBASE), A
 343+ DE64 AF               XOR A
 344+ DE65 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 345+ DE68 C3 57 6D         JP TownGateRedrawPlayer_B7
 346+ DE6B
 347+ DE6B              ; ==============================================================================
 348+ DE6B              ; BankCutsceneSnapToBackOff - teleport player a anchor BACKOFF (centrado + 2 char hueco)
 349+ DE6B              ; ==============================================================================
 350+ DE6B              ; Llamado al cerrarse la puerta tras el "no no" (.bcPhHandOut). El player baja
 351+ DE6B              ; 1 char extra respecto a RETREAT como reaccion al portazo final.
 352+ DE6B              ; Mismo X que los demas anchors (centrado con la puerta), Y=80 (door bottom 63,
 353+ DE6B              ; 16 px de hueco, top del player en 80). Sigue facing N.
 354+ DE6B              BankCutsceneSnapToBackOff:
 355+ DE6B DD 21 A0 81      LD IX, EntityTable
 356+ DE6F DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 357+ DE73 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 358+ DE77 DD 36 04 50      LD (IX+ENT_POSY), BCS_PLAYER_BACKOFF_Y
 359+ DE7B 3E 50            LD A, BCS_PLAYER_BACKOFF_Y
 360+ DE7D 32 E1 82         LD (PlayerDrawY), A
 361+ DE80 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 362+ DE82 DD 77 00         LD (IX+ENT_SPRITEID), A
 363+ DE85 3E 0A            LD A, SPRID_WALK_N
 364+ DE87 DD 77 08         LD (IX+ENT_ANIMBASE), A
 365+ DE8A AF               XOR A
 366+ DE8B DD 77 09         LD (IX+ENT_ANIMTIMER), A
 367+ DE8E C3 57 6D         JP TownGateRedrawPlayer_B7
 368+ DE91
 369+ DE91              ; ==============================================================================
 370+ DE91              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 371+ DE91              ; ==============================================================================
 372+ DE91              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 373+ DE91              ; para asegurar que el player mira a la puerta antes del primer snap.
 374+ DE91              BankCutsceneFacingNRedraw:
 375+ DE91 DD 21 A0 81      LD IX, EntityTable
 376+ DE95 DD 7E 04         LD A, (IX+ENT_POSY)
 377+ DE98 32 E1 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 378+ DE9B 3E 0B            LD A, SPRID_WALK_N + 1
 379+ DE9D DD 77 00         LD (IX+ENT_SPRITEID), A
 380+ DEA0 3E 0A            LD A, SPRID_WALK_N
 381+ DEA2 DD 77 08         LD (IX+ENT_ANIMBASE), A
 382+ DEA5 AF               XOR A
 383+ DEA6 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 384+ DEA9 C3 57 6D         JP TownGateRedrawPlayer_B7
 385+ DEAC
 386+ DEAC              ; ==============================================================================
 387+ DEAC              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 388+ DEAC              ; ==============================================================================
 389+ DEAC              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 390+ DEAC              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 391+ DEAC              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 392+ DEAC              ; resuelve KillAllActiveNasties de StartBankCutscene).
 393+ DEAC              ; Destruye: AF, BC, DE, HL, IX.
 394+ DEAC              ; ==============================================================================
 395+ DEAC              UpdateBankCutsceneBody:
 396+ DEAC 3A CE 82         LD A, (BankCutscenePhase)
 397+ DEAF FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 398+ DEB1 CA 04 DF         JP Z, .bcPhWaitNasties
 399+ DEB4 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 400+ DEB6 CA 0E E1         JP Z, .bcPhDoorClosed
 401+ DEB9 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 402+ DEBB                                                      ;   clink + consume cheque + erase mano + cierra puerta
 403+ DEBB CA 35 E0         JP Z, .bcPhHandOpenIn
 404+ DEBE FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 405+ DEC0 CA 94 E0         JP Z, .bcPhHandOpenOut
 406+ DEC3 3D               DEC A
 407+ DEC4 CA 1E DF         JP Z, .bcPhLock
 408+ DEC7 3D               DEC A
 409+ DEC8 CA 3C DF         JP Z, .bcPhKnocks1
 410+ DECB 3D               DEC A
 411+ DECC CA 51 DF         JP Z, .bcPhWait1
 412+ DECF 3D               DEC A
 413+ DED0 CA 72 DF         JP Z, .bcPhKnocks2
 414+ DED3 3D               DEC A
 415+ DED4 CA 87 DF         JP Z, .bcPhWait2
 416+ DED7 3D               DEC A
 417+ DED8 CA A9 DF         JP Z, .bcPhTurnToCam
 418+ DEDB 3D               DEC A
 419+ DEDC CA CD DF         JP Z, .bcPhTurnToDoor
 420+ DEDF 3D               DEC A
 421+ DEE0 CA EF DF         JP Z, .bcPhKnocks3
 422+ DEE3 3D               DEC A
 423+ DEE4 CA 04 E0         JP Z, .bcPhWait3
 424+ DEE7 3D               DEC A
 425+ DEE8 CA 16 E0         JP Z, .bcPhPreHand
 426+ DEEB 3D               DEC A
 427+ DEEC CA B3 E0         JP Z, .bcPhHandIn
 428+ DEEF 3D               DEC A
 429+ DEF0 CA C2 E0         JP Z, .bcPhHandNoNo
 430+ DEF3 3D               DEC A
 431+ DEF4 CA F3 E0         JP Z, .bcPhHandOut
 432+ DEF7 3D               DEC A
 433+ DEF8 CA 2E E1         JP Z, .bcPhKeyDrop
 434+ DEFB 3D               DEC A
 435+ DEFC CA 53 E1         JP Z, .bcPhPlayerTurnCam
 436+ DEFF                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 437+ DEFF AF               XOR A
 438+ DF00 32 CE 82         LD (BankCutscenePhase), A
 439+ DF03 C9               RET
 440+ DF04
 441+ DF04              ; ---- Phase 17: WAIT_NASTIES ----
 442+ DF04              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 443+ DF04              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 444+ DF04              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 445+ DF04              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 446+ DF04              ;
 447+ DF04              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 448+ DF04              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 449+ DF04              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 450+ DF04              .bcPhWaitNasties:
 451+ DF04 CD 66 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 452+ DF07 CD 22 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 453+ DF0A 28 04            JR Z, .bcWaitNastiesDone
 454+ DF0C CD 10 E2         CALL BankCutsceneDecTimer           ; safety timeout
 455+ DF0F C0               RET NZ
 456+ DF10              .bcWaitNastiesDone:
 457+ DF10 CD 1F DE         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 458+ DF13 3E 1E            LD A, BCS_T_LOCK
 459+ DF15 32 CF 82         LD (BankCutsceneTimer), A
 460+ DF18 3E 01            LD A, BCP_LOCK
 461+ DF1A 32 CE 82         LD (BankCutscenePhase), A
 462+ DF1D C9               RET
 463+ DF1E
 464+ DF1E              ; ---- Phase 1: lock + facing UP ----
 465+ DF1E              .bcPhLock:
 466+ DF1E CD 10 E2         CALL BankCutsceneDecTimer
 467+ DF21 C0               RET NZ
 468+ DF22                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DF22 AF               XOR A
 470+ DF23 32 D1 82         LD (BankCutsceneKnockIdx), A
 471+ DF26 32 D4 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DF29 3E 00            LD A, BCS_KNOCK_HIT
 473+ DF2B 32 D0 82         LD (BankCutsceneSubState), A
 474+ DF2E 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DF30 32 CF 82         LD (BankCutsceneTimer), A
 476+ DF33 CD 98 E1         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DF36 3E 02            LD A, BCP_KNOCKS_1
 478+ DF38 32 CE 82         LD (BankCutscenePhase), A
 479+ DF3B C9               RET
 480+ DF3C
 481+ DF3C              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 482+ DF3C              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 483+ DF3C              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 484+ DF3C              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 485+ DF3C              .bcPhKnocks1:
 486+ DF3C 3E 03            LD A, BCS_GROUP1_KNOCKS
 487+ DF3E CD 5D E1         CALL BankCutsceneTickKnockGroup
 488+ DF41 B7               OR A
 489+ DF42 C8               RET Z                               ; sigue
 490+ DF43                  ; grupo 1 terminado → retirarse a ORIG + wait
 491+ DF43 CD 45 DE         CALL BankCutsceneSnapToRetreat
 492+ DF46 3E 32            LD A, BCS_T_GROUP_WAIT
 493+ DF48 32 CF 82         LD (BankCutsceneTimer), A
 494+ DF4B 3E 03            LD A, BCP_WAIT_1
 495+ DF4D 32 CE 82         LD (BankCutscenePhase), A
 496+ DF50 C9               RET
 497+ DF51
 498+ DF51              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 499+ DF51              .bcPhWait1:
 500+ DF51 CD 10 E2         CALL BankCutsceneDecTimer
 501+ DF54 C0               RET NZ
 502+ DF55                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 503+ DF55 CD 1F DE         CALL BankCutsceneSnapToDoor
 504+ DF58 AF               XOR A
 505+ DF59 32 D1 82         LD (BankCutsceneKnockIdx), A
 506+ DF5C 32 D4 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 507+ DF5F 3E 00            LD A, BCS_KNOCK_HIT
 508+ DF61 32 D0 82         LD (BankCutsceneSubState), A
 509+ DF64 3E 04            LD A, BCS_T_KNOCK_HIT
 510+ DF66 32 CF 82         LD (BankCutsceneTimer), A
 511+ DF69 CD 98 E1         CALL BankCutsceneEmitKnockHit
 512+ DF6C 3E 04            LD A, BCP_KNOCKS_2
 513+ DF6E 32 CE 82         LD (BankCutscenePhase), A
 514+ DF71 C9               RET
 515+ DF72
 516+ DF72              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 517+ DF72              .bcPhKnocks2:
 518+ DF72 3E 03            LD A, BCS_GROUP2_KNOCKS
 519+ DF74 CD 5D E1         CALL BankCutsceneTickKnockGroup
 520+ DF77 B7               OR A
 521+ DF78 C8               RET Z
 522+ DF79                  ; grupo 2 terminado → retirarse a ORIG + wait
 523+ DF79 CD 45 DE         CALL BankCutsceneSnapToRetreat
 524+ DF7C 3E 32            LD A, BCS_T_GROUP_WAIT
 525+ DF7E 32 CF 82         LD (BankCutsceneTimer), A
 526+ DF81 3E 05            LD A, BCP_WAIT_2
 527+ DF83 32 CE 82         LD (BankCutscenePhase), A
 528+ DF86 C9               RET
 529+ DF87
 530+ DF87              ; ---- Phase 5: WAIT_2 ----
 531+ DF87              .bcPhWait2:
 532+ DF87 CD 10 E2         CALL BankCutsceneDecTimer
 533+ DF8A C0               RET NZ
 534+ DF8B                  ; Player gira a S (cara camara).
 535+ DF8B DD 21 A0 81      LD IX, EntityTable
 536+ DF8F 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 537+ DF91 DD 77 00         LD (IX+ENT_SPRITEID), A
 538+ DF94 DD 77 08         LD (IX+ENT_ANIMBASE), A
 539+ DF97 AF               XOR A
 540+ DF98 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 541+ DF9B CD 57 6D         CALL TownGateRedrawPlayer_B7
 542+ DF9E 3E 28            LD A, BCS_T_TURN_CAM
 543+ DFA0 32 CF 82         LD (BankCutsceneTimer), A
 544+ DFA3 3E 06            LD A, BCP_TURN_TO_CAM
 545+ DFA5 32 CE 82         LD (BankCutscenePhase), A
 546+ DFA8 C9               RET
 547+ DFA9
 548+ DFA9              ; ---- Phase 6: player mirando camara mid-cutscene ----
 549+ DFA9              .bcPhTurnToCam:
 550+ DFA9 CD 10 E2         CALL BankCutsceneDecTimer
 551+ DFAC C0               RET NZ
 552+ DFAD                  ; Player vuelve a N (cara puerta).
 553+ DFAD DD 21 A0 81      LD IX, EntityTable
 554+ DFB1 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 555+ DFB3 DD 77 00         LD (IX+ENT_SPRITEID), A
 556+ DFB6 3E 0A            LD A, SPRID_WALK_N
 557+ DFB8 DD 77 08         LD (IX+ENT_ANIMBASE), A
 558+ DFBB AF               XOR A
 559+ DFBC DD 77 09         LD (IX+ENT_ANIMTIMER), A
 560+ DFBF CD 57 6D         CALL TownGateRedrawPlayer_B7
 561+ DFC2 3E 0A            LD A, BCS_T_TURN_BACK
 562+ DFC4 32 CF 82         LD (BankCutsceneTimer), A
 563+ DFC7 3E 07            LD A, BCP_TURN_TO_DOOR
 564+ DFC9 32 CE 82         LD (BankCutscenePhase), A
 565+ DFCC C9               RET
 566+ DFCD
 567+ DFCD              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 568+ DFCD              .bcPhTurnToDoor:
 569+ DFCD CD 10 E2         CALL BankCutsceneDecTimer
 570+ DFD0 C0               RET NZ
 571+ DFD1                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 572+ DFD1 CD 1F DE         CALL BankCutsceneSnapToDoor
 573+ DFD4 AF               XOR A
 574+ DFD5 32 D1 82         LD (BankCutsceneKnockIdx), A
 575+ DFD8 3E 01            LD A, 1
 576+ DFDA 32 D4 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 577+ DFDD AF               XOR A
 578+ DFDE 32 D0 82         LD (BankCutsceneSubState), A        ; HIT
 579+ DFE1 3E 04            LD A, BCS_T_KNOCK_HIT
 580+ DFE3 32 CF 82         LD (BankCutsceneTimer), A
 581+ DFE6 CD 98 E1         CALL BankCutsceneEmitKnockHit
 582+ DFE9 3E 08            LD A, BCP_KNOCKS_3
 583+ DFEB 32 CE 82         LD (BankCutscenePhase), A
 584+ DFEE C9               RET
 585+ DFEF
 586+ DFEF              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 587+ DFEF              .bcPhKnocks3:
 588+ DFEF 3E 06            LD A, BCS_GROUP3_KNOCKS
 589+ DFF1 CD 5D E1         CALL BankCutsceneTickKnockGroup
 590+ DFF4 B7               OR A
 591+ DFF5 C8               RET Z
 592+ DFF6                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 593+ DFF6                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 594+ DFF6                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 595+ DFF6 CD 45 DE         CALL BankCutsceneSnapToRetreat
 596+ DFF9 3E 1E            LD A, BCS_T_PRE_HAND
 597+ DFFB 32 CF 82         LD (BankCutsceneTimer), A
 598+ DFFE 3E 09            LD A, BCP_WAIT_3
 599+ E000 32 CE 82         LD (BankCutscenePhase), A
 600+ E003 C9               RET
 601+ E004
 602+ E004              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 603+ E004              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 604+ E004              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 605+ E004              .bcPhWait3:
 606+ E004 CD 10 E2         CALL BankCutsceneDecTimer
 607+ E007 C0               RET NZ
 608+ E008 CD 2A E2         CALL SFX_Bank_OnDoorCreak
 609+ E00B 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 610+ E00D 32 CF 82         LD (BankCutsceneTimer), A
 611+ E010 3E 0A            LD A, BCP_PRE_HAND
 612+ E012 32 CE 82         LD (BankCutscenePhase), A
 613+ E015 C9               RET
 614+ E016
 615+ E016              ; ---- Phase 10: hold corto antes de la mano ----
 616+ E016              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 617+ E016              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 618+ E016              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 619+ E016              ;
 620+ E016              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 621+ E016              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 622+ E016              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 623+ E016              ; mano "no no" aparece (HAND_NO_NO).
 624+ E016              ;
 625+ E016              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 626+ E016              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 627+ E016              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 628+ E016              .bcPhPreHand:
 629+ E016 CD 10 E2         CALL BankCutsceneDecTimer
 630+ E019 C0               RET NZ
 631+ E01A AF               XOR A
 632+ E01B 32 D3 82         LD (BankCutsceneHandFrame), A           ; frame 1 (= seq[0])
 633+ E01E 32 D2 82         LD (BankCutsceneNoIdx), A               ; 0 slots completados
 634+ E021 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 635+ E024 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 636+ E027 CD 2B E2         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 637+ E02A 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 638+ E02C 32 CF 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 639+ E02F 3E 13            LD A, BCP_HAND_OPEN_IN
 640+ E031 32 CE 82         LD (BankCutscenePhase), A
 641+ E034 C9               RET
 642+ E035
 643+ E035              ; ---- Phase 19: HAND_OPEN_IN — anim scripted + hold + cobro ----
 644+ E035              ; Tabla BCS_OpenHandSeq dicta la secuencia visible (1 byte por estado:
 645+ E035              ; 0=frame 1, 1=frame 2). NoIdx = nº de slots COMPLETADOS hasta ahora; al
 646+ E035              ; entrar HAND_OPEN_IN el slot 0 (seq[0]) ya esta dibujado por PRE_HAND.
 647+ E035              ;
 648+ E035              ; Cada tick (timer=0):
 649+ E035              ;   - NoIdx >= LEN: hold expirado -> cobro
 650+ E035              ;   - NoIdx <  LEN: avanzar al siguiente slot:
 651+ E035              ;       leer seq[NoIdx], swap al frame indicado si != HandFrame
 652+ E035              ;       NoIdx++
 653+ E035              ;       si NoIdx == LEN: timer = HOLD (ultimo slot ya dibujado, hold estatico)
 654+ E035              ;       si NoIdx <  LEN: timer = SWAP
 655+ E035              ;
 656+ E035              ; Cobro: clink -> CurrentKey=0 -> erase mano -> cierra puerta -> chof
 657+ E035              ;   -> BCP_HAND_OPEN_OUT.
 658+ E035              .bcPhHandOpenIn:
 659+ E035 CD 10 E2         CALL BankCutsceneDecTimer
 660+ E038 C0               RET NZ
 661+ E039 3A D2 82         LD A, (BankCutsceneNoIdx)
 662+ E03C FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 663+ E03E 30 32            JR NC, .bcOpenInCobro                   ; anim + hold acabados -> cobro
 664+ E040                  ; Avanzar al siguiente slot. NoIdx ya esta en A.
 665+ E040 21 8D E0         LD HL, .openHandSeq
 666+ E043 5F               LD E, A
 667+ E044 16 00            LD D, 0
 668+ E046 19               ADD HL, DE
 669+ E047 7E               LD A, (HL)                              ; A = frame deseado en este slot
 670+ E048 47               LD B, A                                 ; B = frame deseado
 671+ E049 3A D3 82         LD A, (BankCutsceneHandFrame)
 672+ E04C B8               CP B
 673+ E04D 28 0C            JR Z, .bcOpenInNoSwap                   ; mismo frame, no hace falta swap
 674+ E04F                  ; OJO: BankCutsceneEraseHandOpen -> DrawHandOpen -> LDIR (con BC=34)
 675+ E04F                  ; corrompe BC. Sin PUSH/POP, B queda a 0 al volver y HandFrame siempre se
 676+ E04F                  ; setea a frame 1 -> animacion invisible (parece estatica).
 677+ E04F C5               PUSH BC                                 ; preserva frame deseado
 678+ E050 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; XOR self-cancel frame actual
 679+ E053 C1               POP BC                                  ; recupera frame deseado
 680+ E054 78               LD A, B
 681+ E055 32 D3 82         LD (BankCutsceneHandFrame), A
 682+ E058 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; draw frame nuevo
 683+ E05B              .bcOpenInNoSwap:
 684+ E05B 3A D2 82         LD A, (BankCutsceneNoIdx)
 685+ E05E 3C               INC A
 686+ E05F 32 D2 82         LD (BankCutsceneNoIdx), A
 687+ E062 FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 688+ E064 28 06            JR Z, .bcOpenInLastSlot
 689+ E066 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 690+ E068 32 CF 82         LD (BankCutsceneTimer), A
 691+ E06B C9               RET
 692+ E06C              .bcOpenInLastSlot:
 693+ E06C 3E 1E            LD A, BCS_T_OPEN_HAND_HOLD
 694+ E06E 32 CF 82         LD (BankCutsceneTimer), A
 695+ E071 C9               RET
 696+ E072              .bcOpenInCobro:
 697+ E072 CD 4B E2         CALL SFX_Bank_OnTake                    ; (1) clink (suena primero)
 698+ E075 AF               XOR A
 699+ E076 32 B3 82         LD (CurrentKey), A                      ; (2) consume cheque
 700+ E079 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; (3) mano desaparece (frame final)
 701+ E07C CD BD E1         CALL BankCutsceneCloseDoorRestoreAttrs  ; (4) puerta se cierra
 702+ E07F CD 44 E2         CALL SFX_Bank_OnDoorClose               ; (5) "chof"
 703+ E082 3E 4B            LD A, BCS_T_HAND_OPEN_OUT
 704+ E084 32 CF 82         LD (BankCutsceneTimer), A
 705+ E087 3E 15            LD A, BCP_HAND_OPEN_OUT
 706+ E089 32 CE 82         LD (BankCutscenePhase), A
 707+ E08C C9               RET
 708+ E08D
 709+ E08D              ; Tabla scripted de la animacion de la mano abierta. 1 byte por slot visible:
 710+ E08D              ;   0 = BgGfx_BankHandOpen1 (frame 1, primera pose)
 711+ E08D              ;   1 = BgGfx_BankHandOpen2 (frame 2, segunda pose)
 712+ E08D              ; Secuencia: 1 1 2 1 2 1 1 (visible al usuario). Termina en frame 1.
 713+ E08D              ; LABEL LOCAL (con dot) para preservar el scope sjasmplus de UpdateBankCutscene
 714+ E08D              ; — un label global aqui rompe el scope de los .bcPhXxx posteriores en el
 715+ E08D              ; dispatcher.
 716+ E08D              .openHandSeq:
 717+ E08D 00 00 01 00      DEFB 0, 0, 1, 0, 1, 0, 0
 717+ E091 01 00 00
 718+ E094
 719+ E094              ; ---- Phase 21: HAND_OPEN_OUT — puerta cerrada, pausa antes del "no no" ----
 720+ E094              ; Al expirar: la puerta se reabre y arranca el ciclo "no no":
 721+ E094              ;   1. Re-XOR-cancel pixels puerta + attrs $47 (mismo helper que PRE_HAND).
 722+ E094              ;   2. SFX creak de puerta abrir.
 723+ E094              ;   3. Reset HandFrame/NoIdx (defensivo — ya 0).
 724+ E094              ;   4. Dibuja "no no" frame 0.
 725+ E094              ;   5. -> BCP_HAND_NO_NO con timer BCS_T_NO_FRAME.
 726+ E094              .bcPhHandOpenOut:
 727+ E094 CD 10 E2         CALL BankCutsceneDecTimer
 728+ E097 C0               RET NZ
 729+ E098 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; (1) reabre puerta (pixels + attrs $47)
 730+ E09B CD 2B E2         CALL SFX_Bank_OnHandIn                  ; (2) creak (mismo SFX que PRE_HAND)
 731+ E09E AF               XOR A
 732+ E09F 32 D3 82         LD (BankCutsceneHandFrame), A           ; (3) reset
 733+ E0A2 32 D2 82         LD (BankCutsceneNoIdx), A
 734+ E0A5 CD D0 E1         CALL BankCutsceneDrawHand               ; (4) "no no" frame 0
 735+ E0A8 3E 0C            LD A, BCS_T_NO_FRAME
 736+ E0AA 32 CF 82         LD (BankCutsceneTimer), A
 737+ E0AD 3E 0C            LD A, BCP_HAND_NO_NO                    ; (5)
 738+ E0AF 32 CE 82         LD (BankCutscenePhase), A
 739+ E0B2 C9               RET
 740+ E0B3
 741+ E0B3              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 742+ E0B3              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 743+ E0B3              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 744+ E0B3              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 745+ E0B3              .bcPhHandIn:
 746+ E0B3 CD 10 E2         CALL BankCutsceneDecTimer
 747+ E0B6 C0               RET NZ
 748+ E0B7 3E 0C            LD A, BCS_T_NO_FRAME
 749+ E0B9 32 CF 82         LD (BankCutsceneTimer), A
 750+ E0BC 3E 0C            LD A, BCP_HAND_NO_NO
 751+ E0BE 32 CE 82         LD (BankCutscenePhase), A
 752+ E0C1 C9               RET
 753+ E0C2
 754+ E0C2              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 755+ E0C2              .bcPhHandNoNo:
 756+ E0C2 CD 10 E2         CALL BankCutsceneDecTimer
 757+ E0C5 C0               RET NZ
 758+ E0C6                  ; Swap frame: erase actual + draw el otro.
 759+ E0C6 CD ED E1         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 760+ E0C9 3A D3 82         LD A, (BankCutsceneHandFrame)
 761+ E0CC EE 01            XOR 1
 762+ E0CE 32 D3 82         LD (BankCutsceneHandFrame), A
 763+ E0D1 CD D0 E1         CALL BankCutsceneDrawHand           ; draw frame nuevo
 764+ E0D4 CD 31 E2         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 765+ E0D7                  ; Increment swap idx, check completion.
 766+ E0D7 3A D2 82         LD A, (BankCutsceneNoIdx)
 767+ E0DA 3C               INC A
 768+ E0DB 32 D2 82         LD (BankCutsceneNoIdx), A
 769+ E0DE FE 08            CP BCS_NO_SWAPS_TOTAL
 770+ E0E0 38 0B            JR C, .bcNoNoMoreSwaps
 771+ E0E2                  ; Todos los swaps hechos — pausa antes de erase mano.
 772+ E0E2 3E 0F            LD A, BCS_T_HAND_HOLD
 773+ E0E4 32 CF 82         LD (BankCutsceneTimer), A
 774+ E0E7                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 775+ E0E7                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 776+ E0E7 3E 0D            LD A, BCP_HAND_OUT
 777+ E0E9 32 CE 82         LD (BankCutscenePhase), A
 778+ E0EC C9               RET
 779+ E0ED              .bcNoNoMoreSwaps:
 780+ E0ED 3E 0C            LD A, BCS_T_NO_FRAME
 781+ E0EF 32 CF 82         LD (BankCutsceneTimer), A
 782+ E0F2 C9               RET
 783+ E0F3
 784+ E0F3              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 785+ E0F3              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 786+ E0F3              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 787+ E0F3              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 788+ E0F3              ; del pickup dormant).
 789+ E0F3              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 790+ E0F3              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 791+ E0F3              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 792+ E0F3              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 793+ E0F3              ; de la llave.
 794+ E0F3              .bcPhHandOut:
 795+ E0F3 CD 10 E2         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 796+ E0F6 C0               RET NZ
 797+ E0F7 CD ED E1         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 798+ E0FA CD BD E1         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 799+ E0FD CD 44 E2         CALL SFX_Bank_OnDoorClose           ; SFX "chof" cierre de puerta
 800+ E100 CD 6B DE         CALL BankCutsceneSnapToBackOff      ; player baja 1 char extra (reaccion al portazo final)
 801+ E103 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 802+ E105 32 CF 82         LD (BankCutsceneTimer), A
 803+ E108 3E 12            LD A, BCP_DOOR_CLOSED
 804+ E10A 32 CE 82         LD (BankCutscenePhase), A
 805+ E10D C9               RET
 806+ E10E
 807+ E10E              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 808+ E10E              .bcPhDoorClosed:
 809+ E10E CD 10 E2         CALL BankCutsceneDecTimer
 810+ E111 C0               RET NZ
 811+ E112                  ; --- Spawn de la llave de la ciudad ---
 812+ E112 3E 01            LD A, 1
 813+ E114 32 C7 82         LD (TownGateKeySpawned), A
 814+ E117 21 B0 FA         LD HL, SFX_KeyDrop
 815+ E11A CD 45 6D         CALL PlaySFX_B7
 816+ E11D 11 B8 D7         LD DE, BgGfx_town_gate_key
 817+ E120 CD 3C 6D         CALL RedrawPickupByPtr_B7
 818+ E123                  ; Pausa KEY_HOLD con la llave visible antes de que el player gire.
 819+ E123 3E 1E            LD A, BCS_T_KEY_HOLD
 820+ E125 32 CF 82         LD (BankCutsceneTimer), A
 821+ E128 3E 0E            LD A, BCP_KEY_DROP
 822+ E12A 32 CE 82         LD (BankCutscenePhase), A
 823+ E12D C9               RET
 824+ E12E
 825+ E12E              ; ---- Phase 14: pausa con la llave visible → giro a camara ----
 826+ E12E              .bcPhKeyDrop:
 827+ E12E CD 10 E2         CALL BankCutsceneDecTimer
 828+ E131 C0               RET NZ
 829+ E132                  ; Player gira a camara final.
 830+ E132 DD 21 A0 81      LD IX, EntityTable
 831+ E136 3E 00            LD A, SPRID_IDLE
 832+ E138 DD 77 00         LD (IX+ENT_SPRITEID), A
 833+ E13B DD 77 08         LD (IX+ENT_ANIMBASE), A
 834+ E13E AF               XOR A
 835+ E13F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 836+ E142 CD 57 6D         CALL TownGateRedrawPlayer_B7
 837+ E145 CD 4A E2         CALL SFX_Bank_OnPlayerTurn
 838+ E148 3E 1E            LD A, BCS_T_PLAYER_TURN_FINAL
 839+ E14A 32 CF 82         LD (BankCutsceneTimer), A
 840+ E14D 3E 0F            LD A, BCP_PLAYER_TURN_CAM
 841+ E14F 32 CE 82         LD (BankCutscenePhase), A
 842+ E152 C9               RET
 843+ E153
 844+ E153              ; ---- Phase 15: player mirando camara antes de devolver control ----
 845+ E153              .bcPhPlayerTurnCam:
 846+ E153 CD 10 E2         CALL BankCutsceneDecTimer
 847+ E156 C0               RET NZ
 848+ E157                  ; Setear DONE → siguiente UpdateBankCutscene cae al fallthrough y pone IDLE.
 849+ E157 3E 10            LD A, BCP_DONE
 850+ E159 32 CE 82         LD (BankCutscenePhase), A
 851+ E15C C9               RET
 852+ E15D
 853+ E15D              ; ==============================================================================
 854+ E15D              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 855+ E15D              ; ==============================================================================
 856+ E15D              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 857+ E15D              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 858+ E15D              ;
 859+ E15D              ; Estado:
 860+ E15D              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 861+ E15D              ;   BankCutsceneTimer:    decrementa por frame
 862+ E15D              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 863+ E15D              ;
 864+ E15D              ; Logica:
 865+ E15D              ;   - Tick timer. Si != 0, return 0.
 866+ E15D              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 867+ E15D              ;   - Si SubState=GAP y timer=0:
 868+ E15D              ;       - increment KnockIdx
 869+ E15D              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 870+ E15D              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 871+ E15D              ;
 872+ E15D              ; Destruye: A, BC, DE, HL.
 873+ E15D              ; ==============================================================================
 874+ E15D              BankCutsceneTickKnockGroup:
 875+ E15D 47               LD B, A                             ; B = total knocks
 876+ E15E 3A CF 82         LD A, (BankCutsceneTimer)
 877+ E161 3D               DEC A
 878+ E162 32 CF 82         LD (BankCutsceneTimer), A
 879+ E165 B7               OR A
 880+ E166 28 02            JR Z, .bctkgTimer0
 881+ E168 AF               XOR A                               ; sigue, no terminado
 882+ E169 C9               RET
 883+ E16A              .bctkgTimer0:
 884+ E16A 3A D0 82         LD A, (BankCutsceneSubState)
 885+ E16D B7               OR A
 886+ E16E 20 0C            JR NZ, .bctkgGap0
 887+ E170                  ; HIT acabo: switch a GAP.
 888+ E170 3E 01            LD A, BCS_KNOCK_GAP
 889+ E172 32 D0 82         LD (BankCutsceneSubState), A
 890+ E175 3E 05            LD A, BCS_T_KNOCK_GAP
 891+ E177 32 CF 82         LD (BankCutsceneTimer), A
 892+ E17A AF               XOR A
 893+ E17B C9               RET
 894+ E17C              .bctkgGap0:
 895+ E17C                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 896+ E17C 3A D1 82         LD A, (BankCutsceneKnockIdx)
 897+ E17F 3C               INC A
 898+ E180 32 D1 82         LD (BankCutsceneKnockIdx), A
 899+ E183 B8               CP B
 900+ E184 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 901+ E186                  ; grupo terminado.
 902+ E186 3E 01            LD A, 1
 903+ E188 C9               RET
 904+ E189              .bctkgNextHit:
 905+ E189 3E 00            LD A, BCS_KNOCK_HIT
 906+ E18B 32 D0 82         LD (BankCutsceneSubState), A
 907+ E18E 3E 04            LD A, BCS_T_KNOCK_HIT
 908+ E190 32 CF 82         LD (BankCutsceneTimer), A
 909+ E193 CD 98 E1         CALL BankCutsceneEmitKnockHit
 910+ E196 AF               XOR A
 911+ E197 C9               RET
 912+ E198
 913+ E198              ; ==============================================================================
 914+ E198              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 915+ E198              ; ==============================================================================
 916+ E198              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 917+ E198              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 918+ E198              ; Destruye: A, BC, DE, HL.
 919+ E198              ; ==============================================================================
 920+ E198              BankCutsceneEmitKnockHit:
 921+ E198 C3 1A E2         JP SFX_Bank_OnKnock                 ; tail-call
 922+ E19B
 923+ E19B              ; ==============================================================================
 924+ E19B              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 925+ E19B              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 926+ E19B              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 927+ E19B              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 928+ E19B              ; oscuridad de la rendija".
 929+ E19B              BCS_DOOR_HAND_ATTR      EQU $47
 930+ E19B
 931+ E19B              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 932+ E19B              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 933+ E19B              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 934+ E19B              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 935+ E19B              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 936+ E19B
 937+ E19B              ; ==============================================================================
 938+ E19B              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 939+ E19B              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 940+ E19B              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 941+ E19B              ; pixels visibles bright white sobre fondo negro.
 942+ E19B              ;
 943+ E19B              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 944+ E19B              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 945+ E19B              ; dos llamadas no cancelan, solo re-pintan.
 946+ E19B              ; Destruye: AF, BC, DE, HL, IX.
 947+ E19B              ; ==============================================================================
 948+ E19B              BankCutsceneOpenDoorWithHandAttrs:
 949+ E19B 21 00 F1         LD HL, BgGfx_bank_door_closed
 950+ E19E 3E 03            LD A, 3                             ; bank 3
 951+ E1A0 CD 60 6D         CALL LoadBgSpriteToBuffer_B7        ; thunk slot 1: carga + repagina bank 7 al RET
 952+ E1A3 DD 21 FA 86      LD IX, BgSpriteBuffer
 953+ E1A7 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 954+ E1A9 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 955+ E1AB CD 21 6D         CALL DrawBgSpriteXOR_B7             ; XOR-cancel pixels (attrs intactos $78)
