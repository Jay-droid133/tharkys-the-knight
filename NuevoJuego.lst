 378+ ED26              ; ==============================================================================
 379+ ED26              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ ED26              ; ==============================================================================
 381+ ED26              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ ED26              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ ED26              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ ED26              ; ==============================================================================
 385+ ED26              DrawHealthStaminaHUD:
 386+ ED26                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ ED26 3A 72 B3         LD A, (PlayerHealth)
 388+ ED29 4F               LD C, A                             ; C = nivel (0-16)
 389+ ED2A 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ ED2D 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ ED30 DD 21 0C E9      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ ED34 FD 21 7D E9      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ ED38 CD 9E ED         CALL .drawBar
 394+ ED3B
 395+ ED3B                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ ED3B 3A 73 B3         LD A, (PlayerStamina)
 397+ ED3E 4F               LD C, A
 398+ ED3F 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ ED42 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ ED45 DD 21 10 E9      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ ED49 FD 21 81 E9      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ ED4D CD 9E ED         CALL .drawBar
 403+ ED50
 404+ ED50                  ; --- Flash de recuperacion del pozo ---
 405+ ED50 3A 5C 8D         LD A, (WellFlashTimer)
 406+ ED53 B7               OR A
 407+ ED54 28 23            JR Z, .noFlash
 408+ ED56 3D               DEC A
 409+ ED57 32 5C 8D         LD (WellFlashTimer), A
 410+ ED5A                  ; Flash: alternar blanco/normal cada 4 frames
 411+ ED5A E6 04            AND $04
 412+ ED5C 28 1B            JR Z, .noFlash
 413+ ED5E                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ ED5E                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ ED5E 3E 47            LD A, WHITE | $40
 416+ ED60 32 0D 58         LD ($580D), A
 417+ ED63 32 0E 58         LD ($580E), A
 418+ ED66 32 2D 58         LD ($582D), A
 419+ ED69 32 2E 58         LD ($582E), A
 420+ ED6C 32 11 58         LD ($5811), A
 421+ ED6F 32 12 58         LD ($5812), A
 422+ ED72 32 31 58         LD ($5831), A
 423+ ED75 32 32 58         LD ($5832), A
 424+ ED78 C9               RET
 425+ ED79              .noFlash:
 426+ ED79                  ; --- Attrs segun nivel (normal) ---
 427+ ED79                  ; Salud
 428+ ED79 3A 72 B3         LD A, (PlayerHealth)
 429+ ED7C CD EC ED         CALL .levelToColor
 430+ ED7F 32 0D 58         LD ($580D), A
 431+ ED82 32 0E 58         LD ($580E), A
 432+ ED85 32 2D 58         LD ($582D), A
 433+ ED88 32 2E 58         LD ($582E), A
 434+ ED8B                  ; Stamina
 435+ ED8B 3A 73 B3         LD A, (PlayerStamina)
 436+ ED8E CD EC ED         CALL .levelToColor
 437+ ED91 32 11 58         LD ($5811), A
 438+ ED94 32 12 58         LD ($5812), A
 439+ ED97 32 31 58         LD ($5831), A
 440+ ED9A 32 32 58         LD ($5832), A
