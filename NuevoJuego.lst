 673+ CD93 32 80 CE         LD (.xChar), A
 674+ CD96 79               LD A, C
 675+ CD97 32 81 CE         LD (.yChar), A
 676+ CD9A
 677+ CD9A DD 23            INC IX
 678+ CD9C DD 23            INC IX                      ; IX -> pixel data
 679+ CD9E
 680+ CD9E                  ; Calcular dir VRAM inicio: x_pixel = x_char*8, y_pixel = y_char*8
 681+ CD9E 79               LD A, C
 682+ CD9F 07               RLCA
 683+ CDA0 07               RLCA
 684+ CDA1 07               RLCA
 685+ CDA2 57               LD D, A                     ; D = y_pixel
 686+ CDA3 78               LD A, B
 687+ CDA4 07               RLCA
 688+ CDA5 07               RLCA
 689+ CDA6 07               RLCA
