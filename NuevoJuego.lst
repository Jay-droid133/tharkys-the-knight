1451+ F4CA              ; ==============================================================================
1452+ F4CA              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1453+ F4CA              ; ==============================================================================
1454+ F4CA              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1455+ F4CA              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1456+ F4CA              ; ==============================================================================
1457+ F4CA              ChurchCutsceneEraseStatueAtLast:
1458+ F4CA              ChurchCutsceneDrawStatueAtLast:
1459+ F4CA 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1460+ F4CD 21 A9 69         LD HL, StatueIdTable
1461+ F4D0 5F               LD E, A
1462+ F4D1 16 00            LD D, 0
1463+ F4D3 19               ADD HL, DE
1464+ F4D4 7E               LD A, (HL)                              ; A = statue id
1465+ F4D5 B7               OR A
1466+ F4D6 C8               RET Z
1467+ F4D7                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1468+ F4D7 6F               LD L, A
1469+ F4D8 26 00            LD H, 0
1470+ F4DA 54               LD D, H
1471+ F4DB 5D               LD E, L
1472+ F4DC 29               ADD HL, HL
1473+ F4DD 19               ADD HL, DE                              ; HL = id*3
1474+ F4DE 11 D0 DF         LD DE, BgGfxPtrById
1475+ F4E1 19               ADD HL, DE
1476+ F4E2 5E               LD E, (HL)
1477+ F4E3 23               INC HL
1478+ F4E4 56               LD D, (HL)                              ; DE = sprite ptr
1479+ F4E5 23               INC HL
1480+ F4E6 7E               LD A, (HL)                              ; A = bank
1481+ F4E7 EB               EX DE, HL                               ; HL = sprite ptr
1482+ F4E8 CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
1483+ F4EB                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1484+ F4EB 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1485+ F4EE 57               LD D, A
1486+ F4EF 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1487+ F4F2 5F               LD E, A
1488+ F4F3 C3 31 6B         JP DrawBgSprite16XorAtPixel
1489+ F4F6
1490+ F4F6              ; ==============================================================================
1491+ F4F6              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1492+ F4F6              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1493+ F4F6              ;     A  = jitter signed (-1, 0, +1) en bits.
1494+ F4F6              ; ==============================================================================
1495+ F4F6              ; IN: A = jitter signed (-1, 0, +1) en bits.
1496+ F4F6              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1497+ F4F6              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1498+ F4F6              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1499+ F4F6              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1500+ F4F6              ; version shifted, sin XOR.
1501+ F4F6              ;
1502+ F4F6              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1503+ F4F6              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1504+ F4F6              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1505+ F4F6              ; estatua se perdio cuando la estatua se pinto la primera vez con
1506+ F4F6              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1507+ F4F6              ; de la estatua, el wall perdido no se ve.
1508+ F4F6              ;
1509+ F4F6              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1510+ F4F6              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1511+ F4F6              ; shift de 1 bit no pierde pixels visibles.
1512+ F4F6              ; Destruye: AF, BC, DE, HL, IX.
1513+ F4F6              ; ==============================================================================
1514+ F4F6              ChurchCutsceneShakeStatueByteShift:
1515+ F4F6 32 60 F5         LD (.csbsJitter), A
1516+ F4F9                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1517+ F4F9 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1518+ F4FC 5F               LD E, A
1519+ F4FD 16 00            LD D, 0
1520+ F4FF 19               ADD HL, DE
1521+ F500 7E               LD A, (HL)
1522+ F501 B7               OR A
1523+ F502 C8               RET Z                                   ; sin estatua
1524+ F503 6F               LD L, A
1525+ F504 26 00            LD H, 0
1526+ F506 54               LD D, H
1527+ F507 5D               LD E, L
1528+ F508 29               ADD HL, HL
1529+ F509 19               ADD HL, DE                              ; HL = id*3
1530+ F50A 11 D0 DF         LD DE, BgGfxPtrById
1531+ F50D 19               ADD HL, DE
1532+ F50E 5E               LD E, (HL)
1533+ F50F 23               INC HL
1534+ F510 56               LD D, (HL)                              ; DE = sprite ptr
1535+ F511 23               INC HL
1536+ F512 7E               LD A, (HL)                              ; A = bank
1537+ F513 EB               EX DE, HL                               ; HL = sprite ptr
1538+ F514 CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
1539+ F517                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1540+ F517 DD 21 F5 86      LD IX, BgSpriteBuffer
1541+ F51B DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1542+ F51E B7               OR A
1543+ F51F C8               RET Z
1544+ F520 47               LD B, A                                 ; B = row counter
1545+ F521 DD 23            INC IX
1546+ F523 DD 23            INC IX                                  ; IX -> pixel data
1547+ F525                  ; Calcular addr VRAM en (origX, origY)
1548+ F525 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1549+ F528 57               LD D, A
1550+ F529 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1551+ F52C 5F               LD E, A
1552+ F52D CD 5A 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1553+ F530              .csbsRow:
1554+ F530 C5               PUSH BC
1555+ F531 E5               PUSH HL                                 ; save inicio fila VRAM
1556+ F532                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1557+ F532 DD 7E 00         LD A, (IX+0)
1558+ F535 2F               CPL
1559+ F536 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1560+ F537 DD 7E 01         LD A, (IX+1)
1561+ F53A 2F               CPL
1562+ F53B 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1563+ F53C                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1564+ F53C 3A 60 F5         LD A, (.csbsJitter)
1565+ F53F B7               OR A
1566+ F540 28 0D            JR Z, .csbsWrite                        ; sin shift
1567+ F542 FA 4B F5         JP M, .csbsLeft                         ; A < 0 -> shift left
1568+ F545                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1569+ F545 CB 3A            SRL D
1570+ F547 CB 1B            RR E
1571+ F549 18 04            JR .csbsWrite
1572+ F54B              .csbsLeft:
1573+ F54B CB 23            SLA E
1574+ F54D CB 12            RL D
1575+ F54F              .csbsWrite:
1576+ F54F 7A               LD A, D
1577+ F550 77               LD (HL), A
1578+ F551 23               INC HL
1579+ F552 7B               LD A, E
1580+ F553 77               LD (HL), A
1581+ F554 E1               POP HL
1582+ F555 CD C6 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1583+ F558 DD 23            INC IX
1584+ F55A DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1585+ F55C C1               POP BC
1586+ F55D 10 D1            DJNZ .csbsRow
1587+ F55F C9               RET
1588+ F560 00           .csbsJitter: DEFB 0
1589+ F561
1590+ F561              ; ==============================================================================
1591+ F561              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1592+ F561              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1593+ F561              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1594+ F561              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1595+ F561              ; Destruye: AF, BC, HL.
1596+ F561              ; ==============================================================================
1597+ F561              ChurchCutsceneEraseStatueDirect:
1598+ F561 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1599+ F564 57               LD D, A
1600+ F565 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1601+ F568 5F               LD E, A
1602+ F569 CD 5A 9D         CALL CalcPixelAddr
1603+ F56C 06 18            LD B, 24                                ; statues son 24 px de alto
1604+ F56E              .csedRow:
1605+ F56E AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1606+ F56F 77               LD (HL), A
1607+ F570 23               INC HL
1608+ F571 77               LD (HL), A
1609+ F572 2B               DEC HL                                  ; volver a inicio fila
1610+ F573 C5               PUSH BC
1611+ F574 CD C6 9A         CALL NextPixelLine
1612+ F577 C1               POP BC
1613+ F578 10 F4            DJNZ .csedRow
1614+ F57A C9               RET
