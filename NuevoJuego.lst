 497  CCD3                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCD3              ; ==============================================================================
   2+ CCD3              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCD3              ; ==============================================================================
   4+ CCD3              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCD3              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCD3              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCD3              ; ==============================================================================
   8+ CCD3
   9+ CCD3              ; ==============================================================================
  10+ CCD3              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCD3              ; ==============================================================================
  12+ CCD3              InitScreenSystem:
  13+ CCD3 3E 0F            LD A, START_SCREEN_X
  14+ CCD5 32 0A 83         LD (CurrentScreenX), A
  15+ CCD8 3E 07            LD A, START_SCREEN_Y
  16+ CCDA 32 0B 83         LD (CurrentScreenY), A
  17+ CCDD 3E 01            LD A, 1
  18+ CCDF 32 12 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCE2 AF               XOR A
  20+ CCE3 32 0E 83         LD (ScreenTransition), A
  21+ CCE6 CD EA CC         CALL CalcScreenAddress
  22+ CCE9 C9               RET
  23+ CCEA
  24+ CCEA              ; ==============================================================================
  25+ CCEA              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CCEA              ; ==============================================================================
  27+ CCEA              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CCEA              ; ==============================================================================
  29+ CCEA              CalcScreenAddress:
  30+ CCEA 3A 0B 83         LD A, (CurrentScreenY)
  31+ CCED 6F               LD L, A
  32+ CCEE 26 00            LD H, 0
  33+ CCF0 29               ADD HL, HL                  ; x2
  34+ CCF1 29               ADD HL, HL                  ; x4
  35+ CCF2 29               ADD HL, HL                  ; x8
  36+ CCF3 29               ADD HL, HL                  ; x16
  37+ CCF4 3A 0A 83         LD A, (CurrentScreenX)
  38+ CCF7 5F               LD E, A
  39+ CCF8 16 00            LD D, 0
  40+ CCFA 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CCFB 11 14 DE         LD DE, MapTable
  42+ CCFE 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CCFF 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CD00                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CD00 6F               LD L, A
  46+ CD01 26 00            LD H, 0
  47+ CD03 29               ADD HL, HL                  ; index * 2
  48+ CD04 11 E2 DC         LD DE, RoomTable
  49+ CD07 19               ADD HL, DE
  50+ CD08 5E               LD E, (HL)
  51+ CD09 23               INC HL
  52+ CD0A 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CD0B                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CD0B EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CD0C CD 7A 67         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CD0F                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CD0F 11 F7 85         LD DE, CurrentScreenBuffer
  58+ CD12 ED 53 0C 83      LD (CurrentScreenAddr), DE
  59+ CD16 C9               RET
  60+ CD17
  61+ CD17              ; ==============================================================================
  62+ CD17              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CD17              ; ==============================================================================
  64+ CD17              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CD17              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CD17              ; por estar atrapado cerca del borde.
  67+ CD17              ; ==============================================================================
  68+ CD17              CheckScreenTransition:
  69+ CD17 AF               XOR A
  70+ CD18 32 0E 83         LD (ScreenTransition), A
  71+ CD1B
  72+ CD1B                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CD1B                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CD1B                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CD1B                  ; dispararia transicion sur en plena animacion.
  76+ CD1B 3A CA 82         LD A, (TownGatePhase)
  77+ CD1E B7               OR A
  78+ CD1F C0               RET NZ
  79+ CD20
  80+ CD20                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CD20                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CD20                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CD20                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CD20                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CD20                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CD20 3A B5 82         LD A, (TimeFrozen)
  87+ CD23 B7               OR A
  88+ CD24 28 23            JR Z, .cstNotFrozen
  89+ CD26 3A AD 82         LD A, (InputDirection)
  90+ CD29 CB 4F            BIT 1, A                    ; S
  91+ CD2B 28 17            JR Z, .cstClearBlockFlag
  92+ CD2D 3A A1 81         LD A, (EntityTable + ENT_POSY)
  93+ CD30 FE A8            CP SCREEN_MAX_Y
  94+ CD32 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD34                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD34 3A B6 82         LD A, (BlockedExitSoundFlag)
  97+ CD37 B7               OR A
  98+ CD38 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD39 3E 01            LD A, 1
 100+ CD3B 32 B6 82         LD (BlockedExitSoundFlag), A
 101+ CD3E 21 82 FA         LD HL, SFX_BlockedExit
 102+ CD41 C3 55 F9         JP PlaySFX                  ; tail call
 103+ CD44              .cstClearBlockFlag:
 104+ CD44 AF               XOR A
 105+ CD45 32 B6 82         LD (BlockedExitSoundFlag), A
 106+ CD48 C9               RET
 107+ CD49              .cstNotFrozen:
 108+ CD49                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD49 AF               XOR A
 110+ CD4A 32 B6 82         LD (BlockedExitSoundFlag), A
 111+ CD4D
 112+ CD4D 3A AD 82         LD A, (InputDirection)
 113+ CD50 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CD51
 115+ CD51                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CD51 CB 5A            BIT 3, D                    ; W
 117+ CD53 CA B4 CD         JP Z, .noWest
