 342+ 7271              ; UpdateRandomPickup - room-enter hook
 343+ 7271              ; ==============================================================================
 344+ 7271              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 345+ 7271              ; Early-out si ScreenDirty=0 (no transition).
 346+ 7271              ;
 347+ 7271              ; En transition:
 348+ 7271              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 349+ 7271              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 350+ 7271              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 351+ 7271              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 352+ 7271              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 353+ 7271              ;
 354+ 7271              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 355+ 7271              ; fijos (id, charX, charY, v) terminados con id=$FF.
 356+ 7271              ;
 357+ 7271              ; Destruye AF, BC, DE, HL.
 358+ 7271              ; ==============================================================================
 359+ 7271              UpdateRandomPickup:
 360+ 7271 3A 13 83         LD A, (ScreenDirty)
 361+ 7274 B7               OR A
 362+ 7275 C8               RET Z
