 771+ E657 09               ADD HL, BC                  ; HL = font data
 772+ E658
 773+ E658                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E658 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E65A 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E65C 83               ADD A, E
 777+ E65D 5F               LD E, A                     ; DE = dir VRAM
 778+ E65E
 779+ E65E 06 08            LD B, 8
