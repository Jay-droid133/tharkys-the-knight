 123+ ECFB              ; ==============================================================================
 124+ ECFB              ; UpdateGameClock
 125+ ECFB              ; ==============================================================================
 126+ ECFB              UpdateGameClock:
 127+ ECFB 3A 63 82         LD A, (TimeFrozen)
 128+ ECFE B7               OR A
 129+ ECFF C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ ED00 21 61 EB         LD HL, GameSubMinute
 131+ ED03 34               INC (HL)
 132+ ED04 3A 64 EB         LD A, (SubMinuteMax)
 133+ ED07 BE               CP (HL)
 134+ ED08 C0               RET NZ
 135+ ED09
 136+ ED09 AF               XOR A
 137+ ED0A 32 61 EB         LD (GameSubMinute), A
 138+ ED0D 21 62 EB         LD HL, GameMinutes
 139+ ED10 34               INC (HL)
 140+ ED11                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ ED11                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ ED11 3A 62 EB         LD A, (GameMinutes)
 143+ ED14 FE 3C            CP 60
 144+ ED16 C0               RET NZ
 145+ ED17
 146+ ED17 AF               XOR A
 147+ ED18 32 62 EB         LD (GameMinutes), A
 148+ ED1B 21 63 EB         LD HL, GameHours
 149+ ED1E 34               INC (HL)
 150+ ED1F 7E               LD A, (HL)
 151+ ED20 FE 18            CP 24
 152+ ED22 20 04            JR NZ, .checkPhase
 153+ ED24 AF               XOR A
 154+ ED25 32 63 EB         LD (GameHours), A
 155+ ED28
 156+ ED28              .checkPhase:
 157+ ED28 3A 63 EB         LD A, (GameHours)
 158+ ED2B 21 6D EB         LD HL, PhaseTable
 159+ ED2E 06 07            LD B, 7
 160+ ED30              .phaseLoop:
 161+ ED30 BE               CP (HL)
 162+ ED31 28 05            JR Z, .phaseFound
 163+ ED33 23               INC HL
 164+ ED34 23               INC HL
 165+ ED35 10 F9            DJNZ .phaseLoop
 166+ ED37 C9               RET
 167+ ED38              .phaseFound:
 168+ ED38 23               INC HL
 169+ ED39 7E               LD A, (HL)
 170+ ED3A F5               PUSH AF
 171+ ED3B CD 06 E5         CALL SetTimeOfDay
 172+ ED3E F1               POP AF
 173+ ED3F FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ ED41 C0               RET NZ
 175+ ED42                  ; Nuevo dia: incrementar ciclo
 176+ ED42 21 07 C0         LD HL, DayCycleCount
 177+ ED45 34               INC (HL)
 178+ ED46 C9               RET
 179+ ED47
 180+ ED47              ; ==============================================================================
 181+ ED47              ; SetClockToPhaseHour
 182+ ED47              ; ==============================================================================
 183+ ED47              SetClockToPhaseHour:
 184+ ED47 21 66 EB         LD HL, PhaseStartHour
 185+ ED4A 4F               LD C, A
 186+ ED4B 06 00            LD B, 0
 187+ ED4D 09               ADD HL, BC
 188+ ED4E 7E               LD A, (HL)
 189+ ED4F 32 63 EB         LD (GameHours), A
 190+ ED52 AF               XOR A
 191+ ED53 32 62 EB         LD (GameMinutes), A
 192+ ED56 32 61 EB         LD (GameSubMinute), A
 193+ ED59 C9               RET
 194+ ED5A
 195+ ED5A              ; ==============================================================================
 196+ ED5A              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ ED5A              ; ==============================================================================
 198+ ED5A              DrawClockHUD:
 199+ ED5A                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ ED5A                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ ED5A                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ ED5A                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ ED5A                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ ED5A                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ ED5A 3A 63 82         LD A, (TimeFrozen)
 206+ ED5D FE 01            CP 1
 207+ ED5F 20 07            JR NZ, .clkDrawNormal
 208+ ED61 3A 48 81         LD A, (GameFrameCounter)
 209+ ED64 E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ ED66 28 2D            JR Z, .clkBlinkOff
 211+ ED68              .clkDrawNormal:
 212+ ED68 CD A3 ED         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ ED6B
 214+ ED6B                  ; --- Aguja de horas ---
 215+ ED6B 3A 63 EB         LD A, (GameHours)
 216+ ED6E FE 0C            CP 12
 217+ ED70 38 02            JR C, .hourOk
 218+ ED72 D6 0C            SUB 12
 219+ ED74              .hourOk:
 220+ ED74 21 5F EC         LD HL, HourHandPtrs
 221+ ED77 CD 79 EF         CALL DrawHandLine
 222+ ED7A
 223+ ED7A                  ; --- Aguja de minutos ---
 224+ ED7A 3A 62 EB         LD A, (GameMinutes)
 225+ ED7D 06 00            LD B, 0
 226+ ED7F              .divMin:
 227+ ED7F FE 05            CP 5
 228+ ED81 38 05            JR C, .minOk
 229+ ED83 D6 05            SUB 5
 230+ ED85 04               INC B
 231+ ED86 18 F7            JR .divMin
 232+ ED88              .minOk:
