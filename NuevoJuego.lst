 442+ ED9E
 443+ ED9E              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ ED9E              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ ED9E              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ ED9E              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ ED9E              ; las (16-C) superiores con $00 (vacio/negro)
 448+ ED9E              .drawBar:
 449+ ED9E 7D               LD A, L
 450+ ED9F 32 EA ED         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EDA2 7B               LD A, E
 452+ EDA3 32 EB ED         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EDA6 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EDA8 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EDAA                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EDAA 3E 10            LD A, 16
 457+ EDAC 91               SUB C
 458+ EDAD 5F               LD E, A                             ; E = primera scanline llena
 459+ EDAE              .dbLoop:
 460+ EDAE                  ; Calcular direccion VRAM
 461+ EDAE 7A               LD A, D
 462+ EDAF FE 08            CP 8
 463+ EDB1 30 09            JR NC, .dbCalcR1
 464+ EDB3                  ; Char row 0
 465+ EDB3 67               LD H, A
 466+ EDB4 CB F4            SET 6, H
 467+ EDB6 3A EA ED         LD A, (.dbCol)
 468+ EDB9 6F               LD L, A
 469+ EDBA 18 09            JR .dbWrite
 470+ EDBC              .dbCalcR1:
 471+ EDBC                  ; Char row 1
 472+ EDBC D6 08            SUB 8
 473+ EDBE 67               LD H, A
 474+ EDBF CB F4            SET 6, H
 475+ EDC1 3A EB ED         LD A, (.dbCol1)
 476+ EDC4 6F               LD L, A
 477+ EDC5              .dbWrite:
 478+ EDC5                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EDC5 7A               LD A, D
 480+ EDC6 BB               CP E
 481+ EDC7 30 0B            JR NC, .dbFull
 482+ EDC9                  ; Marchito: copiar sprite decayed
 483+ EDC9 FD 7E 00         LD A, (IY+0)
 484+ EDCC 77               LD (HL), A
 485+ EDCD 23               INC HL
 486+ EDCE FD 7E 01         LD A, (IY+1)
 487+ EDD1 77               LD (HL), A
 488+ EDD2 18 09            JR .dbAdvanceSpr
 489+ EDD4              .dbFull:
 490+ EDD4                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EDD4 DD 7E 00         LD A, (IX+0)
 492+ EDD7 77               LD (HL), A
 493+ EDD8 23               INC HL
 494+ EDD9 DD 7E 01         LD A, (IX+1)
 495+ EDDC 77               LD (HL), A
 496+ EDDD              .dbAdvanceSpr:
 497+ EDDD                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EDDD D5               PUSH DE
 499+ EDDE 11 06 00         LD DE, 6
 500+ EDE1 DD 19            ADD IX, DE
 501+ EDE3 FD 19            ADD IY, DE
 502+ EDE5 D1               POP DE
 503+ EDE6 14               INC D
 504+ EDE7 10 C5            DJNZ .dbLoop
 505+ EDE9 C9               RET
 506+ EDEA
 507+ EDEA 00           .dbCol:  DEFB 0
 508+ EDEB 00           .dbCol1: DEFB 0
 509+ EDEC
 510+ EDEC              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EDEC              .levelToColor:
 512+ EDEC FE 0C            CP 12
 513+ EDEE 30 11            JR NC, .lcGreen
 514+ EDF0 FE 07            CP 7
 515+ EDF2 30 0A            JR NC, .lcCyan
 516+ EDF4 FE 03            CP 3
 517+ EDF6 30 03            JR NC, .lcYellow
 518+ EDF8 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EDFA C9               RET
 520+ EDFB              .lcYellow:
 521+ EDFB 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EDFD C9               RET
 523+ EDFE              .lcCyan:
 524+ EDFE 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EE00 C9               RET
 526+ EE01              .lcGreen:
 527+ EE01 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EE03 C9               RET
 529+ EE04
 530+ EE04              ; ==============================================================================
 531+ EE04              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EE04              ; ==============================================================================
 533+ EE04              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EE04              ; ==============================================================================
 535+ EE04              DrawHandLine:
 536+ EE04 87               ADD A, A
 537+ EE05 4F               LD C, A
 538+ EE06 06 00            LD B, 0
 539+ EE08 09               ADD HL, BC
 540+ EE09 7E               LD A, (HL)
 541+ EE0A 23               INC HL
 542+ EE0B 66               LD H, (HL)
 543+ EE0C 6F               LD L, A             ; HL = puntero a datos de línea
 544+ EE0D
 545+ EE0D              .pixLoop:
 546+ EE0D 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EE0E B7               OR A
 548+ EE0F C8               RET Z
 549+ EE10 57               LD D, A
 550+ EE11 23               INC HL
 551+ EE12 7E               LD A, (HL)          ; VRAM L
 552+ EE13 23               INC HL
 553+ EE14 5F               LD E, A
 554+ EE15 7E               LD A, (HL)          ; mask
 555+ EE16 23               INC HL
 556+ EE17 E5               PUSH HL
 557+ EE18 2F               CPL                 ; ~mask
 558+ EE19 62               LD H, D
 559+ EE1A 6B               LD L, E
 560+ EE1B A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EE1C 77               LD (HL), A
 562+ EE1D E1               POP HL
 563+ EE1E 18 ED            JR .pixLoop
 564+ EE20
 565+ EE20              ; ==============================================================================
 566+ EE20              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
