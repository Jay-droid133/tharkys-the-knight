1049+ A7FD              ; ==============================================================================
1050+ A7FD              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1051+ A7FD              ; ==============================================================================
1052+ A7FD              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1053+ A7FD              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1054+ A7FD              ; ==============================================================================
1055+ A7FD              GetSpriteAddr:
1056+ A7FD                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1057+ A7FD                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1058+ A7FD 3A E8 90         LD A, (CurrentPaging)
1059+ A800 E6 F8            AND $F8
1060+ A802 F6 06            OR 6
1061+ A804 32 E8 90         LD (CurrentPaging), A
1062+ A807 01 FD 7F         LD BC, $7FFD
1063+ A80A ED 79            OUT (C), A                  ; bank 6 paginado
1064+ A80C DD 7E 00         LD A, (IX+ENT_SPRITEID)
1065+ A80F 6F               LD L, A
1066+ A810 26 00            LD H, 0
1067+ A812 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1068+ A813 11 B7 E7         LD DE, SpriteFrameTable
1069+ A816 19               ADD HL, DE
1070+ A817 5E               LD E, (HL)
1071+ A818 23               INC HL
1072+ A819 56               LD D, (HL)
1073+ A81A ED 53 2C A8      LD (SpriteAddrTemp), DE
1074+ A81E 3A E8 90         LD A, (CurrentPaging)
1075+ A821 E6 F8            AND $F8
1076+ A823 32 E8 90         LD (CurrentPaging), A
1077+ A826 01 FD 7F         LD BC, $7FFD
1078+ A829 ED 79            OUT (C), A                  ; bank 0 de vuelta
1079+ A82B C9               RET
1080+ A82C
1081+ A82C 00 00        SpriteAddrTemp: DEFW 0
1082+ A82E
1083+ A82E              ; ==============================================================================
1084+ A82E              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1085+ A82E              ; ==============================================================================
1086+ A82E              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1087+ A82E              ; Salida:   DE = puntero al sprite data
1088+ A82E              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1089+ A82E              ; Preserva: IX
1090+ A82E              ; Destruye: A, HL
1091+ A82E              ; ==============================================================================
1092+ A82E              GetOldSpriteAddr:
1093+ A82E                  ; Paging inline (ver GetSpriteAddr)
1094+ A82E 3A E8 90         LD A, (CurrentPaging)
1095+ A831 E6 F8            AND $F8
1096+ A833 F6 06            OR 6
1097+ A835 32 E8 90         LD (CurrentPaging), A
1098+ A838 01 FD 7F         LD BC, $7FFD
1099+ A83B ED 79            OUT (C), A
1100+ A83D DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1101+ A840 6F               LD L, A
1102+ A841 26 00            LD H, 0
1103+ A843 29               ADD HL, HL
1104+ A844 11 B7 E7         LD DE, SpriteFrameTable
1105+ A847 19               ADD HL, DE
1106+ A848 5E               LD E, (HL)
1107+ A849 23               INC HL
1108+ A84A 56               LD D, (HL)
1109+ A84B ED 53 B6 A7      LD (OldSprAddr), DE
1110+ A84F 3A E8 90         LD A, (CurrentPaging)
1111+ A852 E6 F8            AND $F8
1112+ A854 32 E8 90         LD (CurrentPaging), A
1113+ A857 01 FD 7F         LD BC, $7FFD
1114+ A85A ED 79            OUT (C), A
1115+ A85C C9               RET
1116+ A85D
1117+ A85D              ; ==============================================================================
1118+ A85D              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1119+ A85D              ; ==============================================================================
1120+ A85D              ; Entrada: A = SpriteID
1121+ A85D              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1122+ A85D              ; Destruye: A, DE, HL
1123+ A85D              ; ==============================================================================
1124+ A85D              GetSpriteDims:
1125+ A85D                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1126+ A85D                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1127+ A85D 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1128+ A85E 26 00            LD H, 0
1129+ A860 3A E8 90         LD A, (CurrentPaging)
1130+ A863 E6 F8            AND $F8
1131+ A865 F6 06            OR 6
1132+ A867 32 E8 90         LD (CurrentPaging), A
1133+ A86A 01 FD 7F         LD BC, $7FFD
1134+ A86D ED 79            OUT (C), A                  ; bank 6 paginado
1135+ A86F 29               ADD HL, HL
1136+ A870 11 B7 E7         LD DE, SpriteFrameTable
1137+ A873 19               ADD HL, DE
1138+ A874 5E               LD E, (HL)
1139+ A875 23               INC HL
1140+ A876 56               LD D, (HL)                  ; DE = ptr al sprite data
1141+ A877 1A               LD A, (DE)                  ; width_bytes
1142+ A878 87               ADD A, A
1143+ A879 87               ADD A, A
1144+ A87A 87               ADD A, A                    ; × 8 = width_px
1145+ A87B 47               LD B, A
1146+ A87C 13               INC DE
1147+ A87D 1A               LD A, (DE)                  ; height_px
1148+ A87E 4F               LD C, A
1149+ A87F                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1150+ A87F 78               LD A, B
1151+ A880 32 9D A8         LD (GsdSavedB), A
1152+ A883 79               LD A, C
1153+ A884 32 9E A8         LD (GsdSavedC), A
1154+ A887 3A E8 90         LD A, (CurrentPaging)
1155+ A88A E6 F8            AND $F8
1156+ A88C 32 E8 90         LD (CurrentPaging), A
1157+ A88F 01 FD 7F         LD BC, $7FFD
1158+ A892 ED 79            OUT (C), A                  ; bank 0 de vuelta
1159+ A894 3A 9D A8         LD A, (GsdSavedB)
1160+ A897 47               LD B, A
1161+ A898 3A 9E A8         LD A, (GsdSavedC)
1162+ A89B 4F               LD C, A
1163+ A89C C9               RET
1164+ A89D
1165+ A89D 00           GsdSavedB: DEFB 0
1166+ A89E 00           GsdSavedC: DEFB 0
1167+ A89F
1168+ A89F              ; ==============================================================================
1169+ A89F              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1170+ A89F              ; ==============================================================================
1171+ A89F              ; IX = puntero a la entidad del player (slot 0)
1172+ A89F              ; ==============================================================================
1173+ A89F              UpdatePlayer:
1174+ A89F CD B9 A8         CALL UpdatePlayerState
1175+ A8A2 CD D4 A9         CALL UpdatePlayerMovement
1176+ A8A5 CD 4D AC         CALL UpdatePlayerAnimation
1177+ A8A8                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1178+ A8A8                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1179+ A8A8                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1180+ A8A8                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1181+ A8A8                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1182+ A8A8                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1183+ A8A8 3A 92 82         LD A, (PlayerRespawnTimer)
1184+ A8AB B7               OR A
1185+ A8AC C8               RET Z
1186+ A8AD 3A 48 81         LD A, (GameFrameCounter)
1187+ A8B0 E6 02            AND 2
