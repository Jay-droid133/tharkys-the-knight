 870+ E22C                  ; Igual que NocheT: Blue conserva bright original. C+ -> C-.
 871+ E22C                  ;       B-  Bl-  R-  M-  G-  C-  Y-  W-   B+  Bl+  R+  M+  G+  C+  Y+  W+
 872+ E22C 00 01 01 01      DEFB    0,   1,  1,  1,  1,  5,  1,  1,   8,   9,  9,  9,  9,  5,  9,  9
