 186+ 9CAD AF               XOR A
 187+ 9CAE ED 79            OUT (C), A
 188+ 9CB0                  ; R10 = 0 (silenciar canal C)
 189+ 9CB0 3E 0A            LD A, 10
 190+ 9CB2 01 FD FF         LD BC, $FFFD
 191+ 9CB5 ED 79            OUT (C), A
 192+ 9CB7 01 FD BF         LD BC, $BFFD
 193+ 9CBA AF               XOR A
 194+ 9CBB ED 79            OUT (C), A
 195+ 9CBD                  ; R7 = $3E (mixer: solo tono A activo)
 196+ 9CBD 3E 07            LD A, 7
 197+ 9CBF 01 FD FF         LD BC, $FFFD
 198+ 9CC2 ED 79            OUT (C), A
 199+ 9CC4 01 FD BF         LD BC, $BFFD
 200+ 9CC7 3E 3E            LD A, $3E
 201+ 9CC9 ED 79            OUT (C), A
 202+ 9CCB                  ; R8 = 13 (volumen A alto)
 203+ 9CCB 3E 08            LD A, 8
 204+ 9CCD 01 FD FF         LD BC, $FFFD
 205+ 9CD0 ED 79            OUT (C), A
 206+ 9CD2 01 FD BF         LD BC, $BFFD
 207+ 9CD5 3E 0D            LD A, 13
 208+ 9CD7 ED 79            OUT (C), A
 209+ 9CD9                  ; --- Busy loop B × ~12.4ms ---
 210+ 9CD9              .aypbOuter:
 211+ 9CD9 21 80 06         LD HL, $0680                ; ~1664 inner iters
 212+ 9CDC              .aypbInner:
 213+ 9CDC 2B               DEC HL
 214+ 9CDD 7C               LD A, H
 215+ 9CDE B5               OR L
 216+ 9CDF 20 FB            JR NZ, .aypbInner
 217+ 9CE1 10 F6            DJNZ .aypbOuter
 218+ 9CE3                  ; --- Silenciar canal A (volumen 0) ---
 219+ 9CE3 3E 08            LD A, 8
 220+ 9CE5 01 FD FF         LD BC, $FFFD
 221+ 9CE8 ED 79            OUT (C), A
 222+ 9CEA 01 FD BF         LD BC, $BFFD
 223+ 9CED AF               XOR A
 224+ 9CEE ED 79            OUT (C), A
 225+ 9CF0 FB               EI
 226+ 9CF1 C9               RET
 227+ 9CF2
 228+ 9CF2              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 229+ 9CF2              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 230+ 9CF2              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 231+ 9CF2              ;
 232+ 9CF2              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 233+ 9CF2              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 234+ 9CF2              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 235+ 9CF2              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 236+ 9CF2              StartMusic:
 237+ 9CF2 32 17 9D         LD (MusicTrackArg), A
 238+ 9CF5 F3               DI
 239+ 9CF6 3A D4 90         LD A, (CurrentPaging)
 240+ 9CF9 E6 F8            AND $F8
 241+ 9CFB F6 04            OR 4
 242+ 9CFD 32 D4 90         LD (CurrentPaging), A
 243+ 9D00 01 FD 7F         LD BC, $7FFD
 244+ 9D03 ED 79            OUT (C), A
 245+ 9D05 CD 1D E6         CALL StartMusicImpl
 246+ 9D08 3A D4 90         LD A, (CurrentPaging)
 247+ 9D0B E6 F8            AND $F8
 248+ 9D0D 32 D4 90         LD (CurrentPaging), A
 249+ 9D10 01 FD 7F         LD BC, $7FFD
 250+ 9D13 ED 79            OUT (C), A
 251+ 9D15 FB               EI
 252+ 9D16 C9               RET
 253+ 9D17
 254+ 9D17              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 255+ 9D17              ; desde el Impl en bank 4 sin trampa de paging.
 256+ 9D17 00           MusicTrackArg: DEFB 0
 257+ 9D18
 258+ 9D18              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 259+ 9D18              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 260+ 9D18              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 261+ 9D18              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 262+ 9D18              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 263+ 9D18              ; (bank 0/2) puedan leer/escribir sin paging.
 264+ 9D18 00           MusicSpeedShift: DEFB 0
 265+ 9D19
 266+ 9D19              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 267+ 9D19              ; transiciones de pantalla u otros frames lentos) ---
 268+ 9D19              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 269+ 9D19              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 270+ 9D19              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 271+ 9D19              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 272+ 9D19              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 273+ 9D19              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 274+ 9D19              ; tick daria 0, drift acumulando.
 275+ 9D19 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 276+ 9D1A 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 277+ 9D1B
# file closed: ay_sound_thunks.asm
