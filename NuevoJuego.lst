 167+ 6767              ; STATUES - 3 estatuas en la iglesia, una por TIPO de monster
 168+ 6767              ; ==============================================================================
 169+ 6767              ; Mapeo (indexado por monster type idx = (ANIMBASE - SPRID_MONSTER_0) / 8):
 170+ 6767              ;   idx 0 (SPRID_MONSTER_0 = zombi)    -> statue_zombi (213)
 171+ 6767              ;   idx 1 (SPRID_MONSTER_1 = skeleton) -> statue_skeleton (212)
 172+ 6767              ;   idx 2 (SPRID_MONSTER_2 = ghost)    -> statue_ghost (211)
 173+ 6767              ; Indexar por tipo y no por slot porque ShuffleMonsterTypes baraja la
 174+ 6767              ; asignacion slot->tipo al inicio: el "slot 0" no tiene tipo fijo.
 175+ 6767              ; MonsterTrappedFlags pasa a indexarse por tipo tambien.
 176+ 6767              ; ==============================================================================
 177+ 6767              StatueIdTable:
 178+ 6767 D5               DEFB 213        ; type idx 0: statue_zombi
 179+ 6768 E1               DEFB 225        ; type idx 1: statue_skeleton
 180+ 6769 D3               DEFB 211        ; type idx 2: statue_ghost
