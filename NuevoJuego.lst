  69+ 989F E6 F8            AND $F8
  70+ 98A1 32 84 8D         LD (CurrentPaging), A
  71+ 98A4 01 FD 7F         LD BC, $7FFD
  72+ 98A7 ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98A9 ED 7B AE 98      LD SP, (.aubSavedSP)
  74+ 98AD C9               RET
  75+ 98AE 00 00        .aubSavedSP: DEFW 0
