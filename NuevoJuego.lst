# file opened: sfx_player_hit_ay.asm
   1+ 6AA5              ; ==============================================================================
   2+ 6AA5              ; sfx_player_hit_ay.asm - Wrappers legacy → AY_PlaySFX (Fase 5 migration done)
   3+ 6AA5              ; ==============================================================================
   4+ 6AA5              ; Histórico: este archivo albergaba AY_PlayPlayerHit y un puñado de SFX AY
   5+ 6AA5              ; hard-codeados (Beep, Knock, CompassPickup, LastingPickup, VictoryFanfare,
   6+ 6AA5              ; PlayerDeath) con su propio ticker (AY_UpdatePlayerHit) y state.
   7+ 6AA5              ;
   8+ 6AA5              ; Post Fase 5: todos esos SFX viven ahora como datos en sfx_library.json,
   9+ 6AA5              ; compilados a opcode streams por tools/build_sfx.py, interpretados por
  10+ 6AA5              ; sfx_interp.asm via AY_PlaySFX. Las entries AY_Play* permanecen como
  11+ 6AA5              ; wrappers de 1 instruccion para no tocar los call sites legacy.
  12+ 6AA5              ;
  13+ 6AA5              ; AY_PlayBeep ELIMINADO: sus 5 callers (logic_game, magic_compass, sound,
  14+ 6AA5              ; bank_cutscene) ya hacen LD A, AYSFX_X : CALL AY_PlaySFX directamente.
  15+ 6AA5              ;
  16+ 6AA5              ; Slot 1, siempre visible. JP a AY_PlaySFX (tail call) — sin coste de stack.
  17+ 6AA5              ; ==============================================================================
  18+ 6AA5
  19+ 6AA5              AY_PlayPlayerHit:
  20+ 6AA5 3E 00            LD A, AYSFX_PLAYER_HIT
  21+ 6AA7 C3 D2 6A         JP AY_PlaySFX
  22+ 6AAA
  23+ 6AAA              AY_PlayPlayerDeath:
  24+ 6AAA 3E 01            LD A, AYSFX_PLAYER_DEATH
  25+ 6AAC C3 D2 6A         JP AY_PlaySFX
  26+ 6AAF
  27+ 6AAF              AY_PlayCompassPickup:
