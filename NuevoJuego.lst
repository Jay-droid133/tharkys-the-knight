1009+ 6579              ; ==============================================================================
1010+ 6579              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 6579              ; ==============================================================================
1012+ 6579              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 6579              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 6579              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 6579              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 6579              ; ==============================================================================
1017+ 6579              TownGateExitStep:
1018+ 6579 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 657C 3C               INC A
1020+ 657D 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 6580 FE 02            CP TGCS_T_EXIT_STEP
1022+ 6582 D8               RET C                               ; aun no toca step
1023+ 6583 AF               XOR A
1024+ 6584 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 6587                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 6587 DD 21 4B 81      LD IX, EntityTable
1027+ 658B DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 658E 3C               INC A
1029+ 658F DD 77 04         LD (IX+ENT_POSY), A
1030+ 6592 32 81 82         LD (PlayerDrawY), A
1031+ 6595 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 6598 EE 01            XOR 1                               ; toggle 0/1
1033+ 659A 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 659D 47               LD B, A
1035+ 659E 3E 0E            LD A, SPRID_WALK_S
1036+ 65A0 80               ADD A, B
1037+ 65A1 DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 65A4                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 65A4                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 65A4                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 65A4                  ; part1 attrs ni de door attrs.
1042+ 65A4 CD 16 64         CALL TownGatePlayerSlideErase
1043+ 65A7 C3 4C 64         JP TownGatePlayerSlideDraw          ; tail call
1044+ 65AA
1045+ 65AA              ; ==============================================================================
1046+ 65AA              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
1047+ 65AA              ; ==============================================================================
1048+ 65AA              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
1049+ 65AA              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1050+ 65AA              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1051+ 65AA              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1052+ 65AA              ; Destruye: AF, BC, DE, HL, IX.
1053+ 65AA              ; ==============================================================================
1054+ 65AA              TownGateDrawTheEnd:
1055+ 65AA 21 A2 E6         LD HL, BgGfx_the_end
1056+ 65AD 3E 03            LD A, 3
1057+ 65AF CD 7A 6A         CALL LoadBgSpriteToBuffer
1058+ 65B2 DD 21 9A 89      LD IX, BgSpriteBuffer
1059+ 65B6 06 0B            LD B, TGCS_END_CHARX
1060+ 65B8 0E 04            LD C, TGCS_END_CHARY
1061+ 65BA AF               XOR A
1062+ 65BB 32 03 E5         LD (BgSpriteIsHouse), A
1063+ 65BE 32 F4 D4         LD (CurrentTintVar), A              ; sin tint
1064+ 65C1 C3 EA D3         JP DrawBgGfxSprite
1065+ 65C4
1066+ 65C4              ; ==============================================================================
1067+ 65C4              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1068+ 65C4              ; ==============================================================================
1069+ 65C4              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1070+ 65C4              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1071+ 65C4              ; quedara visible sobre fondo negro.
1072+ 65C4              ; ==============================================================================
1073+ 65C4              TownGateWipeBlack:
1074+ 65C4 21 00 40         LD HL, $4000
1075+ 65C7 11 01 40         LD DE, $4001
1076+ 65CA 01 FF 17         LD BC, $17FF
1077+ 65CD 36 00            LD (HL), 0
1078+ 65CF ED B0            LDIR
1079+ 65D1 21 00 58         LD HL, $5800
1080+ 65D4 11 01 58         LD DE, $5801
1081+ 65D7 01 FF 02         LD BC, $02FF
1082+ 65DA 36 00            LD (HL), $00                        ; ink black, paper black
1083+ 65DC ED B0            LDIR
1084+ 65DE C9               RET
1085+ 65DF
1086+ 65DF              ; ==============================================================================
1087+ 65DF              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1088+ 65DF              ; ==============================================================================
1089+ 65DF              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1090+ 65DF              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1091+ 65DF              ; (white ink, black paper, bright) para todo el area de texto.
1092+ 65DF              ; ==============================================================================
1093+ 65DF              TownGateDrawCredits:
1094+ 65DF                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1095+ 65DF 21 00 58         LD HL, $5800
1096+ 65E2 11 01 58         LD DE, $5801
1097+ 65E5 01 FF 02         LD BC, $02FF
1098+ 65E8 36 47            LD (HL), $47
1099+ 65EA ED B0            LDIR
1100+ 65EC                  ; Iterar credits
1101+ 65EC 21 40 66         LD HL, TownGateCreditsData
1102+ 65EF              .tgdcLoop:
1103+ 65EF 7E               LD A, (HL)
1104+ 65F0 FE FF            CP $FF
1105+ 65F2 C8               RET Z
1106+ 65F3 57               LD D, A                             ; D = row
1107+ 65F4 23               INC HL
1108+ 65F5 7E               LD A, (HL)
1109+ 65F6 5F               LD E, A                             ; E = col
1110+ 65F7 23               INC HL                              ; HL → string
1111+ 65F8 CD FD 65         CALL PrintStringFontAt
1112+ 65FB 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1113+ 65FD
1114+ 65FD              ; ==============================================================================
1115+ 65FD              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1116+ 65FD              ; ==============================================================================
1117+ 65FD              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1118+ 65FD              ; siguiente byte tras el 0 (para que el caller siga iterando).
1119+ 65FD              ; Destruye: AF, BC, DE, HL.
1120+ 65FD              ; OUT: HL apunta al byte tras el 0 terminador.
1121+ 65FD              ; ==============================================================================
1122+ 65FD              PrintStringFontAt:
1123+ 65FD              .psfaCharLoop:
1124+ 65FD 7E               LD A, (HL)
1125+ 65FE 23               INC HL
1126+ 65FF B7               OR A
1127+ 6600 C8               RET Z                               ; fin de string
1128+ 6601 E5               PUSH HL
1129+ 6602 D5               PUSH DE
1130+ 6603 CD 0B 66         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1131+ 6606 D1               POP DE
1132+ 6607 E1               POP HL
1133+ 6608 1C               INC E                               ; siguiente columna
1134+ 6609 18 F2            JR .psfaCharLoop
1135+ 660B
1136+ 660B              ; ==============================================================================
1137+ 660B              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1138+ 660B              ; ==============================================================================
1139+ 660B              ; D = row (0..23), E = col (0..31), A = ASCII char.
1140+ 660B              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1141+ 660B              ;   y = row * 8, x = col * 8
1142+ 660B              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1143+ 660B              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1144+ 660B              ; Destruye: AF, BC, DE, HL.
1145+ 660B              ; ==============================================================================
1146+ 660B              DrawCharFontAt:
1147+ 660B D5               PUSH DE
1148+ 660C                  ; HL = $3C00 + char * 8
1149+ 660C 6F               LD L, A
1150+ 660D 26 00            LD H, 0
1151+ 660F 29               ADD HL, HL
1152+ 6610 29               ADD HL, HL
1153+ 6611 29               ADD HL, HL
1154+ 6612 01 00 3C         LD BC, $3C00
1155+ 6615 09               ADD HL, BC
1156+ 6616 D1               POP DE
1157+ 6617                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1158+ 6617 E5               PUSH HL                             ; save font ptr
1159+ 6618 7A               LD A, D
1160+ 6619 87               ADD A, A
1161+ 661A 87               ADD A, A
1162+ 661B 87               ADD A, A                            ; A = row * 8 = pixel Y
1163+ 661C 57               LD D, A
1164+ 661D 7B               LD A, E
1165+ 661E 87               ADD A, A
1166+ 661F 87               ADD A, A
1167+ 6620 87               ADD A, A                            ; A = col * 8 = pixel X
1168+ 6621 5F               LD E, A
1169+ 6622 CD A5 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
1170+ 6625 EB               EX DE, HL                           ; DE = VRAM addr
1171+ 6626 E1               POP HL                              ; HL = font ptr
1172+ 6627 06 08            LD B, 8
1173+ 6629              .dcfaLoop:
1174+ 6629 7E               LD A, (HL)
1175+ 662A 12               LD (DE), A
1176+ 662B 23               INC HL
1177+ 662C 14               INC D                               ; siguiente scan line (within char)
1178+ 662D 10 FA            DJNZ .dcfaLoop
1179+ 662F C9               RET
1180+ 6630
