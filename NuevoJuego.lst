1605+ F802              ; ==============================================================================
1606+ F802              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1607+ F802              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1608+ F802              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1609+ F802              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1610+ F802              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1611+ F802              ; ==============================================================================
1612+ F802              CompassWobbleTable:
1613+ F802 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1614+ F806 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1615+ F80A 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1616+ F80E 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1617+ F812 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1618+ F816 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1619+ F81A 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1620+ F81E 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1621+ F822 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
