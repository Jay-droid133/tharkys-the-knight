  22+ 6B03              ; ==============================================================================
  23+ 6B03              ; TombStore - Anade una tumba en la sala/posicion actual del player muerto
  24+ 6B03              ; ==============================================================================
  25+ 6B03              ; Lee CurrentScreenX/Y + EntityTable[player].POSX/POSY. Si TombstoneCount<MAX,
  26+ 6B03              ; escribe entry en bank 7 y bumpea el contador. No-op si tope alcanzado.
  27+ 6B03              ; Destruye: A, BC, DE, HL.
  28+ 6B03              ; ==============================================================================
  29+ 6B03              TombStore:
  30+ 6B03 3A 7B 82         LD A, (TombstoneCount)
  31+ 6B06 FE C8            CP TOMBSTONE_MAX
  32+ 6B08 D0               RET NC                                  ; tope alcanzado
  33+ 6B09
  34+ 6B09                  ; HL = TOMBSTONE_ADDR + count * 4
  35+ 6B09 26 00            LD H, 0
  36+ 6B0B 6F               LD L, A
  37+ 6B0C 29               ADD HL, HL                              ; *2
  38+ 6B0D 29               ADD HL, HL                              ; *4
  39+ 6B0E 11 00 E0         LD DE, TOMBSTONE_ADDR
  40+ 6B11 19               ADD HL, DE                              ; HL = slot a escribir (bank 7)
  41+ 6B12
  42+ 6B12 F3               DI
  43+ 6B13                  ; --- Page bank 7 en slot 3 (inline; no CALL — stack vive en slot 3) ---
  44+ 6B13 3A C9 90         LD A, (CurrentPaging)
  45+ 6B16 E6 F8            AND $F8
  46+ 6B18 F6 07            OR TOMBSTONE_BANK
  47+ 6B1A 32 C9 90         LD (CurrentPaging), A
  48+ 6B1D 01 FD 7F         LD BC, $7FFD
  49+ 6B20 ED 79            OUT (C), A
  50+ 6B22
