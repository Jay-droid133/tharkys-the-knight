3708+ A749 C9               RET
3709+ A74A              .spawnReady:
3710+ A74A                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
3711+ A74A 3A B1 A5         LD A, (ScareTimer)
3712+ A74D B7               OR A
3713+ A74E C0               RET NZ
3714+ A74F                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
3715+ A74F 3A 00 D6         LD A, (CurrentTimeOfDay)
3716+ A752 FE 04            CP 4                        ; N2
3717+ A754 C8               RET Z
3718+ A755 FE 05            CP 5                        ; A1
3719+ A757 C8               RET Z
3720+ A758                  ; Rellenar slots vacios cada frame (respawn inmediato)
3721+ A758 DD 21 0E 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
3722+ A75C 06 03            LD B, NUM_NASTIES
3723+ A75E              .spawnLoop:
3724+ A75E C5               PUSH BC
3725+ A75F DD 7E 01         LD A, (IX+ENT_TYPE)
3726+ A762 B7               OR A
3727+ A763 CC 6F A7         CALL Z, SpawnOneNasty
3728+ A766 11 10 00         LD DE, ENT_SIZE
3729+ A769 DD 19            ADD IX, DE
3730+ A76B C1               POP BC
3731+ A76C 10 F0            DJNZ .spawnLoop
3732+ A76E C9               RET
3733+ A76F
3734+ A76F              ; ==============================================================================
3735+ A76F              ; SpawnOneNasty - Inicializa un nasty en el slot IX
3736+ A76F              ; ==============================================================================
3737+ A76F              SpawnOneNasty:
3738+ A76F                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
3739+ A76F ED 5F            LD A, R
3740+ A771 E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
3741+ A773 6F               LD L, A
3742+ A774 26 00            LD H, 0
3743+ A776 ED 5B 96 A9      LD DE, (CurrentNastyTable)
3744+ A77A 19               ADD HL, DE
3745+ A77B 7E               LD A, (HL)
3746+ A77C
3747+ A77C                  ; Configurar entidad base
3748+ A77C DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
3749+ A77F DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
3750+ A783 DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
3751+ A787 DD 36 00 46      LD (IX+ENT_SPRITEID), SPRID_SPAWN
3752+ A78B DD 36 08 46      LD (IX+ENT_ANIMBASE), SPRID_SPAWN
3753+ A78F DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
3754+ A793 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
3755+ A797
3756+ A797                  ; Color segun tipo (cada tipo tiene color fijo)
3757+ A797 DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real (guardado arriba)
3758+ A79A 21 81 A9         LD HL, NastyColorTable
3759+ A79D D5               PUSH DE
3760+ A79E 11 20 00         LD DE, SPRID_ENEMY_0
3761+ A7A1 93               SUB E                       ; A = SPRID offset desde ENEMY_0
3762+ A7A2 CB 3F            SRL A
3763+ A7A4 CB 3F            SRL A                       ; A = indice de tipo (cada 4 SPRIDs)
3764+ A7A6 5F               LD E, A
3765+ A7A7 16 00            LD D, 0
3766+ A7A9 19               ADD HL, DE
3767+ A7AA 7E               LD A, (HL)
3768+ A7AB D1               POP DE
3769+ A7AC              .setAttr:
3770+ A7AC DD 77 05         LD (IX+ENT_ATTR), A
3771+ A7AF
3772+ A7AF                  ; Obtener dims del sprite real del enemigo (para colision de spawn)
3773+ A7AF DD 7E 0A         LD A, (IX+ENT_DIR)          ; ANIMBASE real
3774+ A7B2 CD F4 96         CALL GetSpriteDims          ; B=width_px, C=height_px
3775+ A7B5 78               LD A, B
3776+ A7B6 3D               DEC A
