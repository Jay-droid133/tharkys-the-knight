 435+ 6894              ; ==============================================================================
 436+ 6894              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 437+ 6894              ; ==============================================================================
 438+ 6894              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 439+ 6894              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 440+ 6894              ; OUT: -
 441+ 6894              ; Destruye: AF, BC, DE, HL, IX.
 442+ 6894              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 443+ 6894              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 444+ 6894              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 445+ 6894              ; ==============================================================================
 446+ 6894              DrawBgSpriteByIdAtChar:
 447+ 6894 B7               OR A
 448+ 6895 C8               RET Z                                   ; id 0 = no sprite, salir
 449+ 6896 C5               PUSH BC
 450+ 6897 6F               LD L, A
 451+ 6898 26 00            LD H, 0
 452+ 689A 54               LD D, H
 453+ 689B 5D               LD E, L                                 ; DE = id
 454+ 689C 29               ADD HL, HL                              ; *2
