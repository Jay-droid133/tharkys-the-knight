 140+ E403              ; UpdateGameClock
 141+ E403              ; ==============================================================================
 142+ E403              UpdateGameClock:
 143+ E403 21 69 E2         LD HL, GameSubMinute
 144+ E406 34               INC (HL)
 145+ E407 3A 6C E2         LD A, (SubMinuteMax)
 146+ E40A BE               CP (HL)
 147+ E40B C0               RET NZ
 148+ E40C
 149+ E40C AF               XOR A
 150+ E40D 32 69 E2         LD (GameSubMinute), A
 151+ E410 21 6A E2         LD HL, GameMinutes
 152+ E413 34               INC (HL)
 153+ E414                  ; --- Check 00:30 → spawnear monstruos ---
 154+ E414 3A 6B E2         LD A, (GameHours)
 155+ E417 B7               OR A
 156+ E418 20 08            JR NZ, .noMonsterSpawn          ; No es hora 0
 157+ E41A 7E               LD A, (HL)                      ; HL = GameMinutes
 158+ E41B FE 1E            CP 30
 159+ E41D 20 03            JR NZ, .noMonsterSpawn
 160+ E41F CD 99 A1         CALL SpawnMonsters
 161+ E422              .noMonsterSpawn:
 162+ E422 3A 6A E2         LD A, (GameMinutes)
 163+ E425 FE 3C            CP 60
 164+ E427 C0               RET NZ
 165+ E428
 166+ E428 AF               XOR A
 167+ E429 32 6A E2         LD (GameMinutes), A
 168+ E42C 21 6B E2         LD HL, GameHours
 169+ E42F 34               INC (HL)
 170+ E430 7E               LD A, (HL)
 171+ E431 FE 18            CP 24
 172+ E433 20 04            JR NZ, .checkPhase
 173+ E435 AF               XOR A
 174+ E436 32 6B E2         LD (GameHours), A
 175+ E439
 176+ E439              .checkPhase:
 177+ E439 3A 6B E2         LD A, (GameHours)
 178+ E43C 21 75 E2         LD HL, PhaseTable
 179+ E43F 06 07            LD B, 7
 180+ E441              .phaseLoop:
 181+ E441 BE               CP (HL)
 182+ E442 28 05            JR Z, .phaseFound
 183+ E444 23               INC HL
 184+ E445 23               INC HL
 185+ E446 10 F9            DJNZ .phaseLoop
 186+ E448 C9               RET
 187+ E449              .phaseFound:
 188+ E449 23               INC HL
 189+ E44A 7E               LD A, (HL)
 190+ E44B F5               PUSH AF
 191+ E44C CD 07 DE         CALL SetTimeOfDay
 192+ E44F F1               POP AF
 193+ E450 B7               OR A                                ; Fase 0 = DY (amanecer 7:00)?
 194+ E451 C0               RET NZ
 195+ E452                  ; Nuevo dia: incrementar ciclo
 196+ E452 21 75 A1         LD HL, DayCycleCount
 197+ E455 34               INC (HL)
 198+ E456 C9               RET
