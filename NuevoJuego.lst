 595+ E6B5 06 06            LD B, 6
 596+ E6B7              .attrLoop:
 597+ E6B7 77               LD (HL), A
 598+ E6B8 23               INC HL
 599+ E6B9 10 FC            DJNZ .attrLoop
 600+ E6BB C9               RET
 601+ E6BC
 602+ E6BC              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E6BC              ; A se destruye
 604+ E6BC              .getDigitFont:
 605+ E6BC C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E6BE 6F               LD L, A
 607+ E6BF 26 00            LD H, 0
