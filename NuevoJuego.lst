  76+ 9D6B                  ; === Y CLIPPING ===
  77+ 9D6B                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9D6B 3A 0D 9E         LD A, (.posY)
  79+ 9D6E FE 10            CP SCREEN_MIN_Y
