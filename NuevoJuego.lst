 470+ 68BC              ; ==============================================================================
 471+ 68BC              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 472+ 68BC              ; ==============================================================================
 473+ 68BC              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 474+ 68BC              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 475+ 68BC              ;
 476+ 68BC              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 477+ 68BC              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 478+ 68BC              ;     E = pixel X (0-255).
 479+ 68BC              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 480+ 68BC              ; Solo XOR de pixels (no toca attrs).
 481+ 68BC              ; Destruye: AF, BC, DE, HL, IX.
 482+ 68BC              ; ==============================================================================
 483+ 68BC              DrawBgSprite16XorAtPixel:
 484+ 68BC DD 21 0A 89      LD IX, BgSpriteBuffer
 485+ 68C0 DD 7E 00         LD A, (IX+0)                            ; height_px
 486+ 68C3 B7               OR A
 487+ 68C4 C8               RET Z
 488+ 68C5 32 28 69         LD (.dbsHeight), A
 489+ 68C8 DD 23            INC IX
 490+ 68CA DD 23            INC IX                                  ; -> pixel data
 491+ 68CC                  ; Shift = E & 7 ; aligned X = E & ~7
 492+ 68CC 7B               LD A, E
 493+ 68CD E6 07            AND $07
 494+ 68CF 32 29 69         LD (.dbsShift), A
 495+ 68D2 7B               LD A, E
 496+ 68D3 E6 F8            AND $F8
 497+ 68D5 5F               LD E, A
 498+ 68D6 CD 31 A1         CALL CalcPixelAddr                      ; HL = VRAM addr
 499+ 68D9              .dbsRow:
 500+ 68D9 E5               PUSH HL                                 ; save row start
 501+ 68DA                  ; --- Byte 0 del sprite ---
 502+ 68DA DD 7E 00         LD A, (IX+0)
 503+ 68DD 2F               CPL                                     ; un-invert
 504+ 68DE 57               LD D, A                                 ; D = sprite byte
 505+ 68DF 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 506+ 68E1 3A 29 69         LD A, (.dbsShift)
 507+ 68E4 B7               OR A
 508+ 68E5 28 07            JR Z, .dbsNoShift0
 509+ 68E7 47               LD B, A
 510+ 68E8              .dbsShift0Loop:
 511+ 68E8 CB 3A            SRL D
 512+ 68EA CB 1B            RR E
 513+ 68EC 10 FA            DJNZ .dbsShift0Loop
 514+ 68EE              .dbsNoShift0:
 515+ 68EE 7A               LD A, D
 516+ 68EF AE               XOR (HL)
 517+ 68F0 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 518+ 68F1 23               INC HL
 519+ 68F2 4B               LD C, E                                 ; C = carry para siguiente byte
 520+ 68F3                  ; --- Byte 1 del sprite ---
 521+ 68F3 DD 7E 01         LD A, (IX+1)
 522+ 68F6 2F               CPL
 523+ 68F7 57               LD D, A
 524+ 68F8 1E 00            LD E, 0
 525+ 68FA 3A 29 69         LD A, (.dbsShift)
 526+ 68FD B7               OR A
 527+ 68FE 28 07            JR Z, .dbsNoShift1
 528+ 6900 47               LD B, A
 529+ 6901              .dbsShift1Loop:
 530+ 6901 CB 3A            SRL D
 531+ 6903 CB 1B            RR E
 532+ 6905 10 FA            DJNZ .dbsShift1Loop
 533+ 6907              .dbsNoShift1:
 534+ 6907 7A               LD A, D
 535+ 6908 B1               OR C                                    ; combinar con carry de byte 0
 536+ 6909 AE               XOR (HL)
 537+ 690A 77               LD (HL), A
 538+ 690B 23               INC HL
 539+ 690C 4B               LD C, E                                 ; carry para byte final
 540+ 690D                  ; --- Byte final (solo si shift>0) ---
 541+ 690D 3A 29 69         LD A, (.dbsShift)
 542+ 6910 B7               OR A
 543+ 6911 28 03            JR Z, .dbsNoFinal
 544+ 6913 79               LD A, C
 545+ 6914 AE               XOR (HL)
 546+ 6915 77               LD (HL), A
 547+ 6916              .dbsNoFinal:
 548+ 6916 E1               POP HL                                  ; restore row start
 549+ 6917 CD 9D 9E         CALL NextPixelLine
 550+ 691A DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 551+ 691C DD 23            INC IX
 552+ 691E 3A 28 69         LD A, (.dbsHeight)
 553+ 6921 3D               DEC A
 554+ 6922 32 28 69         LD (.dbsHeight), A
 555+ 6925 20 B2            JR NZ, .dbsRow
 556+ 6927 C9               RET
 557+ 6928 00           .dbsHeight: DEFB 0
 558+ 6929 00           .dbsShift:  DEFB 0
