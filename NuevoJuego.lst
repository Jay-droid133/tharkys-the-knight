2680+ DA33 47               LD B, A                     ; mapX
2681+ DA34 23               INC HL
2682+ DA35 4E               LD C, (HL)                  ; mapY
2683+ DA36 23               INC HL                      ; HL en ptr_lo
2684+ DA37 3A 01 83         LD A, (CurrentScreenX)
2685+ DA3A B8               CP B
2686+ DA3B 20 2A            JR NZ, .rpaSkip
2687+ DA3D 3A 02 83         LD A, (CurrentScreenY)
2688+ DA40 B9               CP C
2689+ DA41 20 24            JR NZ, .rpaSkip
2690+ DA43                  ; Pantalla correcta: cargar sprite y pintar attrs
2691+ DA43 5E               LD E, (HL)
2692+ DA44 23               INC HL
2693+ DA45 56               LD D, (HL)                  ; DE = BgGfx ptr
2694+ DA46 23               INC HL                      ; HL en charX
2695+ DA47 46               LD B, (HL)                  ; charX
2696+ DA48 23               INC HL
2697+ DA49 4E               LD C, (HL)                  ; charY
2698+ DA4A 23               INC HL
2699+ DA4B 7E               LD A, (HL)                  ; tint variant
2700+ DA4C 23               INC HL                      ; HL en siguiente mapX
2701+ DA4D 32 6D D2         LD (CurrentTintVar), A
2702+ DA50 E5               PUSH HL                     ; guardar puntero a siguiente entry
2703+ DA51 C5               PUSH BC                     ; charX, charY (LoadBgSpriteToBuffer preserva BC, pero por seguridad)
2704+ DA52 EB               EX DE, HL                   ; HL = BgGfx ptr
2705+ DA53 3E 03            LD A, 3                     ; ObjectTable (attrs) ptrs viven en bank 3
2706+ DA55 CD CA 67         CALL LoadBgSpriteToBuffer
