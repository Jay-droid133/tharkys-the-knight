 828+ 96F4              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
 829+ 96F4              ; ==============================================================================
 830+ 96F4              ; Entrada: A = SpriteID
 831+ 96F4              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
 832+ 96F4              ; Destruye: A, DE, HL
 833+ 96F4              ; ==============================================================================
 834+ 96F4              GetSpriteDims:
 835+ 96F4 6F               LD L, A
 836+ 96F5 26 00            LD H, 0
 837+ 96F7 29               ADD HL, HL                  ; × 2 (DEFW entries)
 838+ 96F8 11 F8 C6         LD DE, SpriteFrameTable
 839+ 96FB 19               ADD HL, DE
 840+ 96FC 5E               LD E, (HL)
 841+ 96FD 23               INC HL
 842+ 96FE 56               LD D, (HL)                  ; DE = puntero a datos del sprite
 843+ 96FF 1A               LD A, (DE)                  ; width_bytes
 844+ 9700 87               ADD A, A
 845+ 9701 87               ADD A, A
 846+ 9702 87               ADD A, A                    ; × 8 = width_px
 847+ 9703 47               LD B, A
 848+ 9704 13               INC DE
 849+ 9705 1A               LD A, (DE)                  ; height_px
 850+ 9706 4F               LD C, A
 851+ 9707 C9               RET
