 302+ E43B              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E43B              ; ==============================================================================
 304+ E43B              ; Entrada: A = attr original
 305+ E43B              ; Salida:  A = attr transformado
 306+ E43B              ; Preserva: HL, DE, BC, IX
 307+ E43B              ; ==============================================================================
 308+ E43B              ApplyDayCycleRemap:
 309+ E43B E5               PUSH HL
 310+ E43C 67               LD H, A                     ; H = attr (temp save)
 311+ E43D                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E43D 3A D6 E2         LD A, (BgSpriteSkipRemap)
 313+ E440 B7               OR A
 314+ E441 20 06            JR NZ, .skipRemap
 315+ E443 3A D0 E2         LD A, (CurrentTimeOfDay)
 316+ E446 B7               OR A
 317+ E447 20 03            JR NZ, .doRemap
 318+ E449              .skipRemap:
 319+ E449 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E44A E1               POP HL
 321+ E44B C9               RET
 322+ E44C
 323+ E44C              .doRemap:
 324+ E44C D5               PUSH DE
 325+ E44D C5               PUSH BC
 326+ E44E
 327+ E44E 7C               LD A, H                     ; A = attr original
 328+ E44F 4F               LD C, A                     ; C = attr original
 329+ E450
 330+ E450                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E450 E6 87            AND $87                     ; A = F000_0III
 332+ E452 47               LD B, A                     ; B = flash | ink
 333+ E453
 334+ E453                  ; Extraer paper+bright como indice 0-15
 335+ E453 79               LD A, C
 336+ E454 E6 78            AND $78                     ; A = 0BPPP000
 337+ E456 0F               RRCA
 338+ E457 0F               RRCA
 339+ E458 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E459
 341+ E459                  ; Elegir tabla segun tipo de sprite
 342+ E459 5F               LD E, A
 343+ E45A 16 00            LD D, 0
 344+ E45C 3A D5 E2         LD A, (BgSpriteIsHouse)
 345+ E45F B7               OR A
 346+ E460 28 05            JR Z, .useStdTable
 347+ E462 2A D3 E2         LD HL, (CurrentHouseRemapTable)
