 261+ 6EDB 32 7B 82         LD (PlayerSpeedRun), A
 262+ 6EDE 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 263+ 6EE0 32 7C 82         LD (PlayerSpeedFight), A
 264+ 6EE3 21 7D 00         LD HL, SPEED_BUFF_CARACOL_FRAMES
 265+ 6EE6 22 7D 82         LD (SpeedBuffTimer), HL
 266+ 6EE9 3E 02            LD A, SPEED_BUFF_TYPE_CARACOL
 267+ 6EEB 32 7F 82         LD (SpeedBuffType), A
 268+ 6EEE 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR
 269+ 6EF0 32 50 81         LD (EntityTable + ENT_ATTR), A
 270+ 6EF3 C9               RET
 271+ 6EF4
 272+ 6EF4              ; ==============================================================================
 273+ 6EF4              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 274+ 6EF4              ; ==============================================================================
 275+ 6EF4              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 276+ 6EF4              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 277+ 6EF4              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 278+ 6EF4              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 279+ 6EF4              ; ==============================================================================
 280+ 6EF4              UpdateSpeedBuff:
 281+ 6EF4 3A 7F 82         LD A, (SpeedBuffType)
