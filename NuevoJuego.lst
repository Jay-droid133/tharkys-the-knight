2215+ D7DD 25 E1            DEFW BgGfx_old_church_door_closed
2216+ D7DF 05               DEFB 5                          ; key requerida = ChurchKey
2217+ D7E0 02               DEFB 2                          ; action = ChurchDoor open
2218+ D7E1 CE DA            DEFW BgGfx_chimes_tower_door
2219+ D7E3 04               DEFB 4                          ; key requerida = ClockTowerKey
2220+ D7E4 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2221+ D7E5 00 00            DEFW 0                          ; fin
2222+ D7E7 00 00            DEFB 0, 0
