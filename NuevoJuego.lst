 270+ 9F3E              ; ==============================================================================
 271+ 9F3E              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 272+ 9F3E              ; ==============================================================================
 273+ 9F3E              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 274+ 9F3E              ; ==============================================================================
 275+ 9F3E              ProcessPlayer:
 276+ 9F3E DD 21 9E 81      LD IX, EntityTable
 277+ 9F42
 278+ 9F42                  ; --- Fresh check ---
 279+ 9F42 3A 15 83         LD A, (ScreenJustRedrawn)
 280+ 9F45 B7               OR A
 281+ 9F46 C2 12 A0         JP NZ, .plFresh
 282+ 9F49 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 283+ 9F4D C2 12 A0         JP NZ, .plFresh
 284+ 9F50
 285+ 9F50                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 286+ 9F50                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 287+ 9F50                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 288+ 9F50                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 289+ 9F50                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 290+ 9F50                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 291+ 9F50                  ; y UpdatePlayerAnimation lo sobrescribiria.
 292+ 9F50 3A EA 82         LD A, (DeathBorderPhase)
 293+ 9F53 B7               OR A
 294+ 9F54 20 0A            JR NZ, .plSkipUpdate
 295+ 9F56 3A EE 82         LD A, (PlayerRespawnPhase)
 296+ 9F59 FE 01            CP 1
 297+ 9F5B 28 03            JR Z, .plSkipUpdate
 298+ 9F5D CD 68 A5         CALL UpdatePlayer
 299+ 9F60              .plSkipUpdate:
 300+ 9F60 CD 81 A4         CALL CalcDrawX
 301+ 9F63 CD EB 9E         CALL ComputePlayerDrawY
 302+ 9F66
 303+ 9F66                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 304+ 9F66 DD 7E 0F         LD A, (IX+ENT_DRAWX)
