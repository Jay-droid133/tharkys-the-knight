 442+ 65DC              ; su estatua (charY + 2). Localiza la estatua en CurrentScreenBuffer.
 443+ 65DC              ; ==============================================================================
 444+ 65DC              ; IN:  A = type idx (0..2)
 445+ 65DC              ; OUT: -
