7611+ C97C              ; ==============================================================================
7612+ C97C              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7613+ C97C              ; ==============================================================================
7614+ C97C              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7615+ C97C              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7616+ C97C              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7617+ C97C              ; ==============================================================================
7618+ C97C              ; ==============================================================================
7619+ C97C              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7620+ C97C              ; ==============================================================================
7621+ C97C              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7622+ C97C              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7623+ C97C              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7624+ C97C              ; los pone a su default.
7625+ C97C              ; ==============================================================================
7626+ C97C              InitGameState:
7627+ C97C 3E 03            LD A, PLAYER_LIVES_INIT
7628+ C97E 32 E6 82         LD (PlayerLives), A
7629+ C981 3E 10            LD A, HEALTH_MAX
7630+ C983 32 89 B3         LD (PlayerHealth), A
7631+ C986 3E 10            LD A, STAMINA_MAX
7632+ C988 32 8A B3         LD (PlayerStamina), A
7633+ C98B AF               XOR A
7634+ C98C 32 E7 82         LD (GameOver), A
7635+ C98F 32 BF 82         LD (CurrentObjective), A
7636+ C992 32 B6 82         LD (CurrentKey), A
7637+ C995 32 BA 82         LD (ChurchEverOpened), A
7638+ C998 32 B9 82         LD (ChurchDoorOpen), A
7639+ C99B 32 BB 82         LD (TimeFrozen), A
7640+ C99E 32 B8 82         LD (ChurchKeySpawned), A
7641+ C9A1 32 CA 82         LD (TownGateKeySpawned), A
7642+ C9A4 32 D8 82         LD (ArmRevealed), A
7643+ C9A7 32 D9 82         LD (FingerRevealed), A
7644+ C9AA 32 8F B3         LD (MonstersActive), A
7645+ C9AD 32 C6 82         LD (MonsterTrappedFlags), A
7646+ C9B0 32 02 83         LD (DeathSpawned), A
7647+ C9B3 32 D0 82         LD (TownGatePhase), A
7648+ C9B6 32 CE 82         LD (ChurchCutscenePhase), A
7649+ C9B9 32 EA E3         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7650+ C9BC 32 BE 82         LD (BellsTriggered), A
7651+ C9BF 32 C7 82         LD (NextChurchTrapStep), A
7652+ C9C2 32 C8 82         LD (StatueBlinkCounter), A
7653+ C9C5 32 C9 82         LD (ChurchKeyAltSpawnIdx), A
7654+ C9C8 32 35 C5         LD (PlayerHitTimer), A
7655+ C9CB 32 FB 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7656+ C9CE 32 FC 82         LD (TombDrawPending), A
7657+ C9D1 32 EF 82         LD (DeathBorderPhase), A
7658+ C9D4 32 F0 82         LD (DeathBorderTimer), A
7659+ C9D7 32 F1 82         LD (PlayerDeathAnimTimer), A
7660+ C9DA 32 F2 82         LD (PlayerDeathAnimFrame), A
7661+ C9DD 32 F3 82         LD (PlayerRespawnPhase), A
7662+ C9E0 32 F4 82         LD (PlayerRespawnTimer), A
7663+ C9E3 32 F5 82         LD (PlayerRespawnBlinkTimer), A
7664+ C9E6 32 F7 82         LD (PlayerRespawnBeatIdx), A
7665+ C9E9 32 E8 82         LD (GameOverAnimX), A
7666+ C9EC 32 E9 82         LD (GameOverAnimDir), A
7667+ C9EF 32 EA 82         LD (GameOverAnimFrame), A
7668+ C9F2 32 EB 82         LD (GameOverAnimFrameTimer), A
7669+ C9F5 32 EE 82         LD (GameOverAnimLastX), A
7670+ C9F8 21 00 00         LD HL, 0
7671+ C9FB 22 EC 82         LD (GameOverAnimLastSpr), HL
7672+ C9FE 22 FF 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7673+ CA01 3E 01            LD A, 1
7674+ CA03 32 F6 82         LD (PlayerRespawnVisible), A
7675+ CA06 3E 00            LD A, BLACK
7676+ CA08 32 8B 8D         LD (CurrentBorderColor), A
7677+ CA0B D3 FE            OUT (254), A
7678+ CA0D 3E 01            LD A, 1
7679+ CA0F 32 24 BD         LD (DayCycleCount), A
7680+ CA12 21 08 BD         LD HL, DiurnalTypeTable
7681+ CA15 22 25 BD         LD (CurrentNastyTable), HL
7682+ CA18                  ; Reset speed + buff (en caso de restart con buff activo).
7683+ CA18 3E 04            LD A, SPEED_RUN
7684+ CA1A 32 DD 82         LD (PlayerSpeedRun), A
7685+ CA1D 3E 02            LD A, SPEED_FIGHT
7686+ CA1F 32 DE 82         LD (PlayerSpeedFight), A
7687+ CA22 21 00 00         LD HL, 0
7688+ CA25 22 DF 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7689+ CA28 22 E2 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7690+ CA2B AF               XOR A
7691+ CA2C 32 E1 82         LD (SpeedBuffType), A
7692+ CA2F                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7693+ CA2F                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7694+ CA2F                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7695+ CA2F                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7696+ CA2F                  ; recupera el control. Mismo flujo que tras una muerte.
7697+ CA2F 3E 01            LD A, 1
7698+ CA31 32 F3 82         LD (PlayerRespawnPhase), A
7699+ CA34 C9               RET
7700+ CA35
7701+ CA35              OnPlayerHealthDepleted:
7702+ CA35                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7703+ CA35                  ; coste real). Idempotente si no estaba activo.
7704+ CA35 CD F0 6D         CALL CancelMagicCompass
7705+ CA38                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7706+ CA38                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7707+ CA38                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7708+ CA38                  ; (combate, Death catch, drain de salud por cualquier via).
7709+ CA38 F5               PUSH AF
7710+ CA39 3E FF            LD A, $FF
7711+ CA3B CD C2 99         CALL StartMusic
7712+ CA3E F1               POP AF
7713+ CA3F                  ; Tambien parar el secuencer ad-hoc de MonstersMusic (no va por el driver
7714+ CA3F                  ; tabular; tiene su propia variable de estado MonstersMusicStep).
7715+ CA3F CD B4 FB         CALL StopMonstersMusic
7716+ CA42                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7717+ CA42                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7718+ CA42 CD AF 6A         CALL AY_PlayPlayerDeath
7719+ CA45                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7720+ CA45                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7721+ CA45 3E 02            LD A, 2
7722+ CA47 32 BB 82         LD (TimeFrozen), A
7723+ CA4A                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7724+ CA4A CD D6 68         CALL TombStore
7725+ CA4D                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7726+ CA4D CD 64 BA         CALL KillAllActiveNasties
7727+ CA50                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7728+ CA50 CD 32 BB         CALL SilentKillDeath
7729+ CA53                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7730+ CA53 CD 4D BB         CALL FreezeMonstersFacingCorpse
7731+ CA56                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7732+ CA56 CD FF CA         CALL TriggerDeathBorder
7733+ CA59                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7734+ CA59                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7735+ CA59                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7736+ CA59 DD 21 A3 81      LD IX, EntityTable
7737+ CA5D                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7738+ CA5D DD 7E 0A         LD A, (IX+ENT_DIR)
7739+ CA60 E6 80            AND $80
7740+ CA62 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7741+ CA64 28 02            JR Z, .ophdRightBase
7742+ CA66 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7743+ CA68              .ophdRightBase:
7744+ CA68 DD 77 00         LD (IX+ENT_SPRITEID), A
7745+ CA6B DD 36 06 00      LD (IX+ENT_DELTAX), 0
7746+ CA6F DD 36 07 00      LD (IX+ENT_DELTAY), 0
7747+ CA73 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7748+ CA75 32 F1 82         LD (PlayerDeathAnimTimer), A
7749+ CA78 AF               XOR A
7750+ CA79 32 F2 82         LD (PlayerDeathAnimFrame), A
7751+ CA7C                  ; Decrementar vida (clamp a 0)
7752+ CA7C 3A E6 82         LD A, (PlayerLives)
7753+ CA7F B7               OR A
7754+ CA80 C8               RET Z
7755+ CA81 3D               DEC A
7756+ CA82 32 E6 82         LD (PlayerLives), A
7757+ CA85 C9               RET
7758+ CA86
7759+ CA86              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7760+ CA86              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7761+ CA86              ErasePlayerSpriteAtOldPos:
7762+ CA86 DD 21 A3 81      LD IX, EntityTable
7763+ CA8A CD 23 A5         CALL GetOldSpriteAddr
7764+ CA8D DD 56 0D         LD D, (IX+ENT_OLDY)
7765+ CA90 DD 7E 0C         LD A, (IX+ENT_OLDX)
7766+ CA93 5F               LD E, A
7767+ CA94 DD E5            PUSH IX
7768+ CA96 DD 2A AB A4      LD IX, (OldSprAddr)
7769+ CA9A CD EF 99         CALL DrawSprite
7770+ CA9D DD E1            POP IX
7771+ CA9F DD 56 0D         LD D, (IX+ENT_OLDY)
7772+ CAA2 DD 5E 0C         LD E, (IX+ENT_OLDX)
7773+ CAA5 C3 5D D3         JP RestoreOldAttr                   ; tail-call
7774+ CAA8
7775+ CAA8              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7776+ CAA8              RespawnPlayerAtEntry:
7777+ CAA8 DD 21 A3 81      LD IX, EntityTable
7778+ CAAC 3A 16 83         LD A, (LastEntryPosX)
7779+ CAAF DD 77 03         LD (IX+ENT_POSX), A
7780+ CAB2 DD 77 0C         LD (IX+ENT_OLDX), A
7781+ CAB5 DD 77 0F         LD (IX+ENT_DRAWX), A
7782+ CAB8 3A 17 83         LD A, (LastEntryPosY)
7783+ CABB DD 77 04         LD (IX+ENT_POSY), A
7784+ CABE DD 77 0D         LD (IX+ENT_OLDY), A
7785+ CAC1 3E 10            LD A, HEALTH_MAX
7786+ CAC3 32 89 B3         LD (PlayerHealth), A
7787+ CAC6 3E 10            LD A, STAMINA_MAX
7788+ CAC8 32 8A B3         LD (PlayerStamina), A
7789+ CACB DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7790+ CACF DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7791+ CAD3 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7792+ CAD7 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7793+ CADB DD 36 06 00      LD (IX+ENT_DELTAX), 0
7794+ CADF DD 36 07 00      LD (IX+ENT_DELTAY), 0
7795+ CAE3                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7796+ CAE3                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7797+ CAE3                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7798+ CAE3                  ; libre, y .swordModeFree no toca el color.
7799+ CAE3 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7800+ CAE7 AF               XOR A
7801+ CAE8 32 85 B3         LD (AttackCooldown), A
7802+ CAEB 32 84 B3         LD (AttackTimer), A
7803+ CAEE DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7804+ CAF2                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7805+ CAF2                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7806+ CAF2 3E 01            LD A, 1
7807+ CAF4 32 F3 82         LD (PlayerRespawnPhase), A
7808+ CAF7 AF               XOR A
7809+ CAF8 32 F4 82         LD (PlayerRespawnTimer), A
7810+ CAFB 32 F7 82         LD (PlayerRespawnBeatIdx), A
7811+ CAFE C9               RET
7812+ CAFF
7813+ CAFF              ; ==============================================================================
7814+ CAFF              ; TriggerDeathBorder - arranca el flash del borde tras morir
7815+ CAFF              ; ==============================================================================
7816+ CAFF              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7817+ CAFF              ; luego vuelve a negro y se desactiva.
7818+ CAFF              ; ==============================================================================
7819+ CAFF              TriggerDeathBorder:
7820+ CAFF 3E 01            LD A, 1
7821+ CB01 32 EF 82         LD (DeathBorderPhase), A
7822+ CB04 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7823+ CB06 32 F0 82         LD (DeathBorderTimer), A
7824+ CB09 3E 06            LD A, YELLOW
7825+ CB0B 32 8B 8D         LD (CurrentBorderColor), A
7826+ CB0E D3 FE            OUT (254), A
7827+ CB10 C9               RET
7828+ CB11
7829+ CB11              ; ==============================================================================
7830+ CB11              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7831+ CB11              ; ==============================================================================
7832+ CB11              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7833+ CB11              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7834+ CB11              ; ==============================================================================
7835+ CB11              UpdateRespawnBlink:
7836+ CB11 3A F3 82         LD A, (PlayerRespawnPhase)
7837+ CB14 B7               OR A
7838+ CB15 C8               RET Z
7839+ CB16 3D               DEC A
7840+ CB17 28 0D            JR Z, .urbPhase1
7841+ CB19                  ; Phase 2: solo timer (sin parpadeo)
7842+ CB19 3A F4 82         LD A, (PlayerRespawnTimer)
7843+ CB1C 3D               DEC A
7844+ CB1D 32 F4 82         LD (PlayerRespawnTimer), A
7845+ CB20 C0               RET NZ
7846+ CB21 AF               XOR A
7847+ CB22 32 F3 82         LD (PlayerRespawnPhase), A
7848+ CB25 C9               RET
7849+ CB26
7850+ CB26              .urbPhase1:
7851+ CB26                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7852+ CB26                  ; Zero input (sin control)
7853+ CB26 AF               XOR A
7854+ CB27 32 B3 82         LD (InputDirection), A
7855+ CB2A 32 B4 82         LD (InputFire), A
7856+ CB2D                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7857+ CB2D                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7858+ CB2D 3A A4 6A         LD A, (BeepDurationFrames)
7859+ CB30 D6 01            SUB 1                               ; CY si era 0 (silencio)
7860+ CB32 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7861+ CB33 E6 74            AND SPRID_PLAYER_BLANK
7862+ CB35 32 A3 81         LD (EntityTable), A
7863+ CB38                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7864+ CB38 3A F4 82         LD A, (PlayerRespawnTimer)
7865+ CB3B B7               OR A
7866+ CB3C 28 05            JR Z, .urb1FireBeat
7867+ CB3E 3D               DEC A
7868+ CB3F 32 F4 82         LD (PlayerRespawnTimer), A
7869+ CB42 C9               RET
7870+ CB43              .urb1FireBeat:
7871+ CB43 3A F7 82         LD A, (PlayerRespawnBeatIdx)
7872+ CB46 3C               INC A
7873+ CB47 32 F7 82         LD (PlayerRespawnBeatIdx), A
7874+ CB4A FE 04            CP 4
7875+ CB4C 28 12            JR Z, .urb1LastBeat
7876+ CB4E FE 05            CP 5
7877+ CB50 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7878+ CB52                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7879+ CB52 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7880+ CB55 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7881+ CB57 CD D2 6A         CALL AY_PlayBeep
7882+ CB5A                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7883+ CB5A                  ; (mitad) para mantener ON/OFF ~50/50.
7884+ CB5A 3E 14            LD A, 20
7885+ CB5C 32 F4 82         LD (PlayerRespawnTimer), A
7886+ CB5F C9               RET
7887+ CB60              .urb1LastBeat:
7888+ CB60                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7889+ CB60                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7890+ CB60                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7891+ CB60                  ; entra grace EXACTAMENTE al terminar el beep.
7892+ CB60 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7893+ CB63 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7894+ CB65 CD D2 6A         CALL AY_PlayBeep
7895+ CB68 3E 0B            LD A, 11                    ; espera = duracion del beep
7896+ CB6A 32 F4 82         LD (PlayerRespawnTimer), A
7897+ CB6D C9               RET
7898+ CB6E              .urb1AfterBeep:
7899+ CB6E                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7900+ CB6E                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7901+ CB6E CD 96 CB         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7902+ CB71 3E 0C            LD A, SPAWN_INTERVAL
7903+ CB73 32 FD 82         LD (SpawnTimer), A
7904+ CB76 AF               XOR A
7905+ CB77 32 02 83         LD (DeathSpawned), A
7906+ CB7A 32 F8 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7907+ CB7D 32 BB 82         LD (TimeFrozen), A              ; Reanudar reloj
7908+ CB80 21 00 00         LD HL, 0
7909+ CB83 22 FF 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7910+ CB86                  ; Si los monsters siguen activos (no era game over), reanudar el
7911+ CB86                  ; secuencer "po-po-popo-po" — fue parado en OnPlayerHealthDepleted.
7912+ CB86 3A 8F B3         LD A, (MonstersActive)
7913+ CB89 B7               OR A
7914+ CB8A C8               RET Z
7915+ CB8B                  ; No re-arrancar si los 3 monsters estan atrapados en la iglesia
7916+ CB8B                  ; (StopMonstersMusic se llamo en TriggerChurchTrap del 3o; ya no hay
7917+ CB8B                  ; monsters jugables en pantalla aunque MonstersActive siga 1).
7918+ CB8B 3A C6 82         LD A, (MonsterTrappedFlags)
7919+ CB8E E6 07            AND $07
7920+ CB90 FE 07            CP $07
7921+ CB92 C8               RET Z
7922+ CB93 C3 AB FB         JP StartMonstersMusic           ; tail-call
7923+ CB96
7924+ CB96              ; ==============================================================================
7925+ CB96              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7926+ CB96              ; ==============================================================================
7927+ CB96              ; Llamado desde:
7928+ CB96              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7929+ CB96              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7930+ CB96              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7931+ CB96              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7932+ CB96              ; ==============================================================================
7933+ CB96              EnterGracePhase:
7934+ CB96 3E 02            LD A, 2
7935+ CB98 32 F3 82         LD (PlayerRespawnPhase), A
7936+ CB9B 3E 19            LD A, RESPAWN_GRACE_FRAMES
7937+ CB9D 32 F4 82         LD (PlayerRespawnTimer), A
7938+ CBA0 C9               RET
7939+ CBA1
7940+ CBA1              ; ==============================================================================
7941+ CBA1              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7942+ CBA1              ; ==============================================================================
7943+ CBA1              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7944+ CBA1              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7945+ CBA1              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7946+ CBA1              ; ==============================================================================
7947+ CBA1              UpdateDeathAnim:
7948+ CBA1 3A EF 82         LD A, (DeathBorderPhase)
7949+ CBA4 FE 01            CP 1
7950+ CBA6 C0               RET NZ
7951+ CBA7 3A F1 82         LD A, (PlayerDeathAnimTimer)
7952+ CBAA 3D               DEC A
7953+ CBAB 32 F1 82         LD (PlayerDeathAnimTimer), A
7954+ CBAE C0               RET NZ
7955+ CBAF                  ; Tick consumido: avanzar frame
7956+ CBAF 3A F2 82         LD A, (PlayerDeathAnimFrame)
7957+ CBB2 3C               INC A
7958+ CBB3 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7959+ CBB5 D0               RET NC                              ; ya en ultimo frame (clamp)
7960+ CBB6 32 F2 82         LD (PlayerDeathAnimFrame), A
7961+ CBB9 DD 21 A3 81      LD IX, EntityTable
7962+ CBBD DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7963+ CBC0                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7964+ CBC0                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7965+ CBC0                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7966+ CBC0 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7967+ CBC2 20 06            JR NZ, .udaSkipSplatSfx
7968+ CBC4 21 38 FA         LD HL, SFX_EnemyDeath
7969+ CBC7 CD B9 F9         CALL PlaySFX
7970+ CBCA              .udaSkipSplatSfx:
7971+ CBCA 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7972+ CBCC 32 F1 82         LD (PlayerDeathAnimTimer), A
7973+ CBCF C9               RET
7974+ CBD0
7975+ CBD0              ; ==============================================================================
7976+ CBD0              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7977+ CBD0              ; ==============================================================================
7978+ CBD0              UpdateDeathBorder:
7979+ CBD0 3A EF 82         LD A, (DeathBorderPhase)
7980+ CBD3 B7               OR A
7981+ CBD4 C8               RET Z
7982+ CBD5 3A F0 82         LD A, (DeathBorderTimer)
7983+ CBD8 3D               DEC A
7984+ CBD9 32 F0 82         LD (DeathBorderTimer), A
7985+ CBDC C0               RET NZ
7986+ CBDD                  ; Timer expiro: avanzar fase
7987+ CBDD 3A EF 82         LD A, (DeathBorderPhase)
7988+ CBE0 FE 01            CP 1
7989+ CBE2 20 33            JR NZ, .udbToBlack
7990+ CBE4                  ; --- Fin fase amarillo ---
7991+ CBE4                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7992+ CBE4                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7993+ CBE4 3A E6 82         LD A, (PlayerLives)
7994+ CBE7 B7               OR A
7995+ CBE8 28 1F            JR Z, .udbToGameOver
7996+ CBEA DD 21 A3 81      LD IX, EntityTable
7997+ CBEE DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7998+ CBF2 3E 02            LD A, 2
7999+ CBF4 32 EF 82         LD (DeathBorderPhase), A
8000+ CBF7 3E 32            LD A, DEATH_BORDER_RED_FRAMES
8001+ CBF9 32 F0 82         LD (DeathBorderTimer), A
8002+ CBFC 3E 02            LD A, RED
8003+ CBFE 32 8B 8D         LD (CurrentBorderColor), A
8004+ CC01 D3 FE            OUT (254), A
8005+ CC03                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
8006+ CC03                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
8007+ CC03 3E 01            LD A, 1
8008+ CC05 32 FC 82         LD (TombDrawPending), A
8009+ CC08 C9               RET
8010+ CC09              .udbToGameOver:
8011+ CC09                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
8012+ CC09 AF               XOR A
8013+ CC0A 32 EF 82         LD (DeathBorderPhase), A
8014+ CC0D 3E 00            LD A, BLACK
8015+ CC0F 32 8B 8D         LD (CurrentBorderColor), A
8016+ CC12 D3 FE            OUT (254), A
8017+ CC14 C3 25 CC         JP ShowGameOver
8018+ CC17              .udbToBlack:
8019+ CC17                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
8020+ CC17 AF               XOR A
8021+ CC18 32 EF 82         LD (DeathBorderPhase), A
8022+ CC1B 3E 00            LD A, BLACK
8023+ CC1D 32 8B 8D         LD (CurrentBorderColor), A
8024+ CC20 D3 FE            OUT (254), A
8025+ CC22 C3 A8 CA         JP RespawnPlayerAtEntry             ; tail-call
8026+ CC25
8027+ CC25              ; ==============================================================================
8028+ CC25              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
8029+ CC25              ; ==============================================================================
8030+ CC25              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
8031+ CC25              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
8032+ CC25              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
8033+ CC25              ; ==============================================================================
8034+ CC25              ShowGameOver:
8035+ CC25 3E 01            LD A, 1
8036+ CC27 32 E7 82         LD (GameOver), A
8037+ CC2A C9               RET
8038+ CC2B
8039+ CC2B              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
8040+ CC2B              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
8041+ CC2B              PaintGameOverScreen:
8042+ CC2B                  ; Wipe pixels
8043+ CC2B 21 00 40         LD HL, $4000
8044+ CC2E 11 01 40         LD DE, $4001
8045+ CC31 01 FF 17         LD BC, $17FF
8046+ CC34 36 00            LD (HL), 0
8047+ CC36 ED B0            LDIR
8048+ CC38                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
8049+ CC38 21 00 58         LD HL, $5800
8050+ CC3B 11 01 58         LD DE, $5801
8051+ CC3E 01 FF 02         LD BC, $02FF
8052+ CC41 36 47            LD (HL), $47
8053+ CC43 ED B0            LDIR
8054+ CC45                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
8055+ CC45                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
8056+ CC45 CD 70 6C         CALL DrawTombstone2xCentered
8057+ CC48                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
8058+ CC48 3E 88            LD A, GAMEOVER_ANIM_X_MAX
8059+ CC4A 32 E8 82         LD (GameOverAnimX), A
8060+ CC4D AF               XOR A
8061+ CC4E 32 E9 82         LD (GameOverAnimDir), A
8062+ CC51 32 EA 82         LD (GameOverAnimFrame), A
8063+ CC54 32 EE 82         LD (GameOverAnimLastX), A
8064+ CC57 21 00 00         LD HL, 0
8065+ CC5A 22 EC 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
8066+ CC5D 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8067+ CC5F 32 EB 82         LD (GameOverAnimFrameTimer), A
8068+ CC62                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
8069+ CC62                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
8070+ CC62                  ; congelado en GameOver=2.
8071+ CC62 3E 03            LD A, 3
8072+ CC64 C3 C2 99         JP StartMusic                   ; tail-call
8073+ CC67
8074+ CC67              ; ==============================================================================
8075+ CC67              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
8076+ CC67              ; ==============================================================================
8077+ CC67              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
8078+ CC67              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
8079+ CC67              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
8080+ CC67              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
8081+ CC67              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
8082+ CC67              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
8083+ CC67              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
8084+ CC67              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
8085+ CC67              ;
8086+ CC67              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
8087+ CC67              ; shifted (que ocupa 4 chars = 32 px).
8088+ CC67              ; ==============================================================================
8089+ CC67              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
8090+ CC67              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8091+ CC67              ; X swing centrado sobre la tumba:
8092+ CC67              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8093+ CC67              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8094+ CC67              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8095+ CC67              GAMEOVER_ANIM_Y           EQU 56
8096+ CC67              GAMEOVER_ANIM_X_MIN       EQU 96
8097+ CC67              GAMEOVER_ANIM_X_MAX       EQU 136
8098+ CC67              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8099+ CC67
8100+ CC67              UpdateGameOverAnim:
8101+ CC67                  ; --- Erase del sprite previo (si lo hubo) ---
8102+ CC67 2A EC 82         LD HL, (GameOverAnimLastSpr)
8103+ CC6A 7C               LD A, H
8104+ CC6B B5               OR L
8105+ CC6C 28 0C            JR Z, .ugoaNoErase
8106+ CC6E E5               PUSH HL
8107+ CC6F DD E1            POP IX
8108+ CC71 3A EE 82         LD A, (GameOverAnimLastX)
8109+ CC74 5F               LD E, A
8110+ CC75 16 38            LD D, GAMEOVER_ANIM_Y
8111+ CC77 CD EF 99         CALL DrawSprite
8112+ CC7A              .ugoaNoErase:
8113+ CC7A
8114+ CC7A                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8115+ CC7A 3A EB 82         LD A, (GameOverAnimFrameTimer)
8116+ CC7D 3D               DEC A
8117+ CC7E 20 0A            JR NZ, .ugoaTimerSet
8118+ CC80 3A EA 82         LD A, (GameOverAnimFrame)
8119+ CC83 EE 01            XOR 1
8120+ CC85 32 EA 82         LD (GameOverAnimFrame), A
8121+ CC88 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8122+ CC8A              .ugoaTimerSet:
8123+ CC8A 32 EB 82         LD (GameOverAnimFrameTimer), A
8124+ CC8D
8125+ CC8D                  ; --- Avanzar X segun direccion (ping-pong) ---
8126+ CC8D 3A E9 82         LD A, (GameOverAnimDir)
8127+ CC90 B7               OR A
8128+ CC91 20 14            JR NZ, .ugoaSlideRight
8129+ CC93                  ; Dir 0: facing R, slide LEFT (X--)
8130+ CC93 3A E8 82         LD A, (GameOverAnimX)
8131+ CC96 FE 60            CP GAMEOVER_ANIM_X_MIN
8132+ CC98 28 06            JR Z, .ugoaFlipToL
8133+ CC9A 3D               DEC A
8134+ CC9B 32 E8 82         LD (GameOverAnimX), A
8135+ CC9E 18 18            JR .ugoaPickSprite
8136+ CCA0              .ugoaFlipToL:
8137+ CCA0 3E 01            LD A, 1
8138+ CCA2 32 E9 82         LD (GameOverAnimDir), A
8139+ CCA5 18 11            JR .ugoaPickSprite
8140+ CCA7              .ugoaSlideRight:
8141+ CCA7                  ; Dir 1: facing L, slide RIGHT (X++)
8142+ CCA7 3A E8 82         LD A, (GameOverAnimX)
8143+ CCAA FE 88            CP GAMEOVER_ANIM_X_MAX
8144+ CCAC 28 06            JR Z, .ugoaFlipToR
8145+ CCAE 3C               INC A
8146+ CCAF 32 E8 82         LD (GameOverAnimX), A
8147+ CCB2 18 04            JR .ugoaPickSprite
8148+ CCB4              .ugoaFlipToR:
8149+ CCB4 AF               XOR A
8150+ CCB5 32 E9 82         LD (GameOverAnimDir), A
8151+ CCB8
8152+ CCB8              .ugoaPickSprite:
8153+ CCB8                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8154+ CCB8                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8155+ CCB8                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8156+ CCB8 3A E9 82         LD A, (GameOverAnimDir)
8157+ CCBB B7               OR A
8158+ CCBC 20 0E            JR NZ, .ugoaPickR
8159+ CCBE 3A EA 82         LD A, (GameOverAnimFrame)
8160+ CCC1 B7               OR A
8161+ CCC2 21 DF DD         LD HL, SprDeath_L0
8162+ CCC5 28 11            JR Z, .ugoaSprSet
8163+ CCC7 21 29 DE         LD HL, SprDeath_L1
8164+ CCCA 18 0C            JR .ugoaSprSet
8165+ CCCC              .ugoaPickR:
8166+ CCCC 3A EA 82         LD A, (GameOverAnimFrame)
8167+ CCCF B7               OR A
8168+ CCD0 21 4B DD         LD HL, SprDeath_0
8169+ CCD3 28 03            JR Z, .ugoaSprSet
8170+ CCD5 21 95 DD         LD HL, SprDeath_1
8171+ CCD8              .ugoaSprSet:
8172+ CCD8 22 EC 82         LD (GameOverAnimLastSpr), HL
8173+ CCDB 3A E8 82         LD A, (GameOverAnimX)
8174+ CCDE 32 EE 82         LD (GameOverAnimLastX), A
8175+ CCE1
8176+ CCE1                  ; --- Draw nuevo sprite ---
8177+ CCE1 E5               PUSH HL
8178+ CCE2 DD E1            POP IX
8179+ CCE4 5F               LD E, A
8180+ CCE5 16 38            LD D, GAMEOVER_ANIM_Y
8181+ CCE7 C3 EF 99         JP DrawSprite                   ; tail-call
8182+ CCEA
