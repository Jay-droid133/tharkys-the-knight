5780+ C23D              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5781+ C23D              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5782+ C23D              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5783+ C23D              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5784+ C23D              ; empujado).
5785+ C23D              .rmUpdateReturnTimers:
5786+ C23D 21 72 B6         LD HL, MonsterReturnTimer
5787+ C240 DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5788+ C244 06 03            LD B, MONSTERS_TO_SPAWN
5789+ C246              .rmRtLoop:
