2523+ AD0F
2524+ AD0F 00           .savedEX: DEFB 0
2525+ AD10 00           .savedEY: DEFB 0
2526+ AD11
2527+ AD11              ; ==============================================================================
2528+ AD11              ; ==============================================================================
2529+ AD11              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2530+ AD11              ; ==============================================================================
2531+ AD11              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2532+ AD11              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2533+ AD11              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2534+ AD11              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2535+ AD11              ; ==============================================================================
2536+ AD11              UpdateMonster:
2537+ AD11                  ; --- Stun: knockback + pausa tras golpe del player ---
2538+ AD11 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2539+ AD14 B7               OR A
2540+ AD15 CA 39 AF         JP Z, .moNormal
2541+ AD18 DD 35 0A         DEC (IX+ENT_DIR)
2542+ AD1B 20 0B            JR NZ, .moStunActive
2543+ AD1D                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2544+ AD1D DD 36 06 00      LD (IX+ENT_DELTAX), 0
2545+ AD21 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2546+ AD25 C3 39 AF         JP .moNormal
2547+ AD28
2548+ AD28              .moStunActive:
2549+ AD28                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2550+ AD28 FE 06            CP MONSTER_STUN_PAUSE
2551+ AD2A DA C3 B0         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2552+ AD2D                  ; Knockback: aplicar movimiento con collision check
2553+ AD2D DD 56 06         LD D, (IX+ENT_DELTAX)
2554+ AD30 DD 5E 07         LD E, (IX+ENT_DELTAY)
2555+ AD33 7A               LD A, D
2556+ AD34 B3               OR E
2557+ AD35 CA C3 B0         JP Z, .moAnimate
2558+ AD38                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2559+ AD38 D5               PUSH DE
2560+ AD39 DD 7E 03         LD A, (IX+ENT_POSX)
2561+ AD3C 32 4C B2         LD (.moSvX), A
2562+ AD3F DD 7E 04         LD A, (IX+ENT_POSY)
2563+ AD42 32 4D B2         LD (.moSvY), A
2564+ AD45                  ; Calcular nueva posicion
2565+ AD45 DD 7E 03         LD A, (IX+ENT_POSX)
2566+ AD48 82               ADD A, D
2567+ AD49 DD 77 03         LD (IX+ENT_POSX), A
2568+ AD4C DD 7E 04         LD A, (IX+ENT_POSY)
2569+ AD4F 83               ADD A, E
2570+ AD50 DD 77 04         LD (IX+ENT_POSY), A
