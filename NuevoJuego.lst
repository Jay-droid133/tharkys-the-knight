 457+ 9BC8              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BC8              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BC8              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BC8              ; ---
 461+ 9BC8 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BD8 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BD9 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BDA 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D0C 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D0D
 467+ 9D0D              ; ==============================================================================
 468+ 9D0D              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D0D              ; ==============================================================================
 470+ 9D0D              ; Entrada: A = indice de entidad (0-16)
 471+ 9D0D              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D0D              ; ==============================================================================
 473+ 9D0D              SetAttrSlot:
 474+ 9D0D 32 0C 9D         LD (CurrentAttrSlot), A
 475+ 9D10                  ; Calcular offset: A * 18
 476+ 9D10 6F               LD L, A
 477+ 9D11 26 00            LD H, 0
 478+ 9D13 29               ADD HL, HL                  ; x2
 479+ 9D14 54               LD D, H
 480+ 9D15 5D               LD E, L                     ; DE = x2
 481+ 9D16 29               ADD HL, HL                  ; x4
 482+ 9D17 29               ADD HL, HL                  ; x8
 483+ 9D18 29               ADD HL, HL                  ; x16
 484+ 9D19 19               ADD HL, DE                  ; x18
 485+ 9D1A 11 DA 9B         LD DE, SavedAttrTable
 486+ 9D1D 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D1E                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D1E 11 C8 9B         LD DE, EntitySavedAttr
 489+ 9D21 01 12 00         LD BC, 18
 490+ 9D24 ED B0            LDIR
 491+ 9D26 C9               RET
 492+ 9D27
 493+ 9D27              ; ==============================================================================
 494+ 9D27              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D27              ; ==============================================================================
 496+ 9D27              FlushAttrSlot:
 497+ 9D27 3A 0C 9D         LD A, (CurrentAttrSlot)
 498+ 9D2A 6F               LD L, A
 499+ 9D2B 26 00            LD H, 0
 500+ 9D2D 29               ADD HL, HL                  ; x2
 501+ 9D2E 54               LD D, H
 502+ 9D2F 5D               LD E, L
 503+ 9D30 29               ADD HL, HL                  ; x4
 504+ 9D31 29               ADD HL, HL                  ; x8
 505+ 9D32 29               ADD HL, HL                  ; x16
 506+ 9D33 19               ADD HL, DE                  ; x18
 507+ 9D34 11 DA 9B         LD DE, SavedAttrTable
 508+ 9D37 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D38 EB               EX DE, HL                   ; DE = destino
 510+ 9D39 21 C8 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D3C 01 12 00         LD BC, 18
 512+ 9D3F ED B0            LDIR
 513+ 9D41 C9               RET
 514+ 9D42
 515+ 9D42              ; ==============================================================================
 516+ 9D42              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D42              ; ==============================================================================
 518+ 9D42              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D42              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D42              ; ==============================================================================
 521+ 9D42              CalcAttrAddr:
 522+ 9D42 7A               LD A, D
 523+ 9D43 0F               RRCA
 524+ 9D44 0F               RRCA
 525+ 9D45 0F               RRCA
 526+ 9D46 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D48 6F               LD L, A
 528+ 9D49 26 00            LD H, 0
 529+ 9D4B 29               ADD HL, HL
 530+ 9D4C 29               ADD HL, HL
 531+ 9D4D 29               ADD HL, HL
 532+ 9D4E 29               ADD HL, HL
 533+ 9D4F 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D50 7B               LD A, E
 535+ 9D51 0F               RRCA
 536+ 9D52 0F               RRCA
 537+ 9D53 0F               RRCA
 538+ 9D54 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D56 B5               OR L
 540+ 9D57 6F               LD L, A
 541+ 9D58 01 00 58         LD BC, ATTR_BASE
 542+ 9D5B 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D5C C9               RET
 544+ 9D5D
 545+ 9D5D              ; ==============================================================================
 546+ 9D5D              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D5D              ; ==============================================================================
 548+ 9D5D              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D5D              ; Salida: HL=direccion en VRAM
 550+ 9D5D              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D5D              ; ==============================================================================
 552+ 9D5D              CalcPixelAddr:
 553+ 9D5D 7A               LD A, D
 554+ 9D5E E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D60 1F               RRA
 556+ 9D61 1F               RRA
 557+ 9D62 1F               RRA                         ; >> 3
 558+ 9D63 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D65 67               LD H, A
 560+ 9D66
 561+ 9D66 7A               LD A, D
 562+ 9D67 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D69 B4               OR H
 564+ 9D6A 67               LD H, A
 565+ 9D6B
 566+ 9D6B 7A               LD A, D
 567+ 9D6C E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D6E 87               ADD A, A
 569+ 9D6F 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D70 6F               LD L, A
 571+ 9D71
 572+ 9D71 7B               LD A, E
 573+ 9D72 1F               RRA
 574+ 9D73 1F               RRA
 575+ 9D74 1F               RRA
 576+ 9D75 E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D77 B5               OR L
 578+ 9D78 6F               LD L, A
 579+ 9D79 C9               RET
 580+ 9D7A
 581+ 9D7A              ; ==============================================================================
