6925+ C909              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6926+ C909              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6927+ C909              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6928+ C909              ; timer >= DEATH_SPAWN_FRAMES).
6929+ C909              SpawnDeath:
6930+ C909                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6931+ C909                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6932+ C909                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6933+ C909                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6934+ C909                  ; atravesando el mapa.
6935+ C909 CD 98 97         CALL FindFarthestAnyFreeCell
6936+ C90C C8               RET Z                               ; sin candidato: reintento siguiente frame
6937+ C90D              .sdHaveCell:
6938+ C90D                  ; B = cx, C = cy
6939+ C90D DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6940+ C911                  ; POSX = cx * 8
6941+ C911 78               LD A, B
6942+ C912 87               ADD A, A
6943+ C913 87               ADD A, A
6944+ C914 87               ADD A, A
6945+ C915 DD 77 03         LD (IX+ENT_POSX), A
6946+ C918 DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
6947+ C91B                  ; POSY = cy * 8 + SCREEN_MIN_Y
6948+ C91B 79               LD A, C
6949+ C91C 87               ADD A, A
6950+ C91D 87               ADD A, A
6951+ C91E 87               ADD A, A
6952+ C91F C6 10            ADD A, SCREEN_MIN_Y
6953+ C921 DD 77 04         LD (IX+ENT_POSY), A
6954+ C924 DD 77 0D         LD (IX+ENT_OLDY), A
