1623+ F6F8              ; ==============================================================================
1624+ F6F8              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1625+ F6F8              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1626+ F6F8              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1627+ F6F8              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1628+ F6F8              ; Destruye: AF, BC, HL.
1629+ F6F8              ; ==============================================================================
1630+ F6F8              ChurchCutsceneEraseStatueDirect:
1631+ F6F8 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1632+ F6FB 57               LD D, A
1633+ F6FC 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1634+ F6FF 5F               LD E, A
1635+ F700 CD 62 9D         CALL CalcPixelAddr
1636+ F703 06 18            LD B, 24                                ; statues son 24 px de alto
1637+ F705              .csedRow:
1638+ F705 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1639+ F706 77               LD (HL), A
1640+ F707 23               INC HL
1641+ F708 77               LD (HL), A
1642+ F709 2B               DEC HL                                  ; volver a inicio fila
1643+ F70A C5               PUSH BC
1644+ F70B CD CE 9A         CALL NextPixelLine
1645+ F70E C1               POP BC
1646+ F70F 10 F4            DJNZ .csedRow
1647+ F711 C9               RET
