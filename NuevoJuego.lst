2899+ DB51 EB               EX DE, HL                   ; HL = BgGfx ptr
2900+ DB52 3E 03            LD A, 3                     ; KeyLockTable ptrs viven en bank 3
2901+ DB54 CD CA 67         CALL LoadBgSpriteToBuffer
2902+ DB57 DD 21 EE 86      LD IX, BgSpriteBuffer
2903+ DB5B 06 14            LD B, 20                    ; charX (col 20)
