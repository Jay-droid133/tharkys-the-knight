 760+ 7574              ; ==============================================================================
 761+ 7574              ; .cmcpFindMatchingGap - Busca en sala A un gap (side=B, coord=C)
 762+ 7574              ; ==============================================================================
 763+ 7574              ; Devuelve la comp del gap matching (side AND coord). Permite resolver la
 764+ 7574              ; correspondencia gap-físico cuando hay múltiples gaps del mismo side en
 765+ 7574              ; comps distintas.
 766+ 7574              ; IN:  A = sid, B = coord, C = side
 767+ 7574              ; OUT: A = comp (0..2) si encontrado; $FF si no match.
 768+ 7574              ; Destruye: AF, BC, DE, HL.
 769+ 7574              ; ==============================================================================
 770+ 7574              .cmcpFindMatchingGap:
 771+ 7574 32 13 76         LD (.cfmgSid), A
 772+ 7577 78               LD A, B
 773+ 7578 32 14 76         LD (.cfmgCoord), A
 774+ 757B 79               LD A, C
 775+ 757C 32 15 76         LD (.cfmgSide), A
 776+ 757F 3A 13 76         LD A, (.cfmgSid)
 777+ 7582 6F               LD L, A
 778+ 7583 26 00            LD H, 0
 779+ 7585 29               ADD HL, HL
 780+ 7586 11 1F 77         LD DE, RoomCompGapsTable
 781+ 7589 19               ADD HL, DE
 782+ 758A 5E               LD E, (HL)
 783+ 758B 23               INC HL
 784+ 758C 56               LD D, (HL)
 785+ 758D EB               EX DE, HL                            ; HL = record
 786+ 758E 7E               LD A, (HL)
 787+ 758F B7               OR A
 788+ 7590 28 20            JR Z, .cfmgNotFound
 789+ 7592 47               LD B, A
 790+ 7593 23               INC HL
 791+ 7594              .cfmgLoop:
 792+ 7594 7E               LD A, (HL)                           ; side_comp
 793+ 7595 23               INC HL
 794+ 7596 4E               LD C, (HL)                           ; coord
 795+ 7597 23               INC HL
 796+ 7598 57               LD D, A                              ; D = side_comp
 797+ 7599 E6 03            AND $03                              ; side
 798+ 759B 5F               LD E, A
 799+ 759C 3A 15 76         LD A, (.cfmgSide)
 800+ 759F BB               CP E
 801+ 75A0 20 0E            JR NZ, .cfmgSkip
 802+ 75A2 3A 14 76         LD A, (.cfmgCoord)
 803+ 75A5 B9               CP C
 804+ 75A6 20 08            JR NZ, .cfmgSkip
 805+ 75A8                  ; Match. Extract comp.
 806+ 75A8 7A               LD A, D
 807+ 75A9 CB 3F            SRL A
 808+ 75AB CB 3F            SRL A
 809+ 75AD E6 03            AND $03
 810+ 75AF C9               RET
 811+ 75B0              .cfmgSkip:
 812+ 75B0 10 E2            DJNZ .cfmgLoop
 813+ 75B2              .cfmgNotFound:
 814+ 75B2 3E FF            LD A, $FF
 815+ 75B4 C9               RET
