4803+ B980 00           .spawnTries:      DEFB 0
4804+ B981 00           .spawnIgnoreZone: DEFB 0
4805+ B982 00           .spawnW1:         DEFB 0
4806+ B983 00           .spawnH1:         DEFB 0
