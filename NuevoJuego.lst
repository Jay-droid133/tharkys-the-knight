 499  E2D3                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 500  E2D3                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 501  E2D3                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
