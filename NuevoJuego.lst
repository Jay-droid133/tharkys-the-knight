 132  6B51                  ; --- Tumbas persistentes (tombstones.asm) ---
 133  6B51                  ; TombStore + DrawTombstonesInRoom. Usan inline page switch como
 134  6B51                  ; LoadBgSpriteToBuffer para acceder al storage en bank 7 ($E000+).
 135  6B51                  ; Cold path: muerte del player + carga de pantalla. Coste invisible.
 136  6B51                  INCLUDE "tombstones.asm"
# file opened: tombstones.asm
   1+ 6B51              ; ==============================================================================
   2+ 6B51              ; TOMBSTONES - Tumbas persistentes en el mundo donde el player muere
   3+ 6B51              ; ==============================================================================
   4+ 6B51              ; Storage: bank 7 a $E000, 800 bytes (200 entradas x 4 bytes cada una).
   5+ 6B51              ; Layout por entrada: DEFB roomX, roomY, posX, posY  (todos 8-bit).
   6+ 6B51              ; TombstoneCount (1 byte, 0..200) en bank 2 (variables.asm, siempre visible).
   7+ 6B51              ;
   8+ 6B51              ; Vive en slot 1 ($6000+) tras paging.asm: las rutinas hacen el page switch
   9+ 6B51              ; siguiendo el patron de LoadBgSpriteToBuffer (DI durante la ventana, IFF
  10+ 6B51              ; tracking via StartupComplete, no CALLs/PUSH/POP entre los OUT).
  11+ 6B51              ;
  12+ 6B51              ; Cold paths: TombStore se llama 1 vez por muerte; DrawTombstonesInRoom al
  13+ 6B51              ; cargar pantalla. Coste invisible.
  14+ 6B51              ; ==============================================================================
  15+ 6B51
  16+ 6B51              TOMBSTONE_MAX     EQU 200
  17+ 6B51              TOMBSTONE_BYTES   EQU 4
  18+ 6B51              TOMBSTONE_BANK    EQU 7
