2541+ B096              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2542+ B096              ; ==============================================================================
2543+ B096              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2544+ B096              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2545+ B096              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2546+ B096              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2547+ B096              ; ==============================================================================
2548+ B096              UpdateMonster:
2549+ B096                  ; --- Stun: knockback + pausa tras golpe del player ---
2550+ B096 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
