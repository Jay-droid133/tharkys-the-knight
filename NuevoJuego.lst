 243+ FAF5 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 244+ FAF9 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 245+ FAFD 00               DEFB  0                       ; fin
