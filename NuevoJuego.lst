7298+ C786 B7               OR A
7299+ C787 28 0B            JR Z, .bfsTryE
7300+ C789 3D               DEC A
7301+ C78A 47               LD B, A
7302+ C78B 3A 75 5F         LD A, (DBfsCurCy)
7303+ C78E 4F               LD C, A
7304+ C78F 3E 02            LD A, MAI_DIR_W
7305+ C791 CD 13 C8         CALL .bfsTryNbr
7306+ C794              .bfsTryE:
7307+ C794 3A 74 5F         LD A, (DBfsCurCx)
7308+ C797 FE 1F            CP 31
7309+ C799 D2 31 C7         JP NC, .bfsLoop
7310+ C79C 3C               INC A
7311+ C79D 47               LD B, A
7312+ C79E 3A 75 5F         LD A, (DBfsCurCy)
7313+ C7A1 4F               LD C, A
