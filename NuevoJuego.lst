1916+ F800
1917+ F800              ; ==============================================================================
1918+ F800              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1919+ F800              ; ==============================================================================
1920+ F800              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1921+ F800              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1922+ F800              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1923+ F800              ;
1924+ F800              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1925+ F800              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1926+ F800              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1927+ F800              ; la zona de atributos ($5800+).
1928+ F800              ; Destruye: A.
1929+ F800              ; ==============================================================================
1930+ F800              ComputeHintPos:
1931+ F800 78               LD A, B
1932+ F801 B7               OR A
1933+ F802 28 0A            JR Z, .chpNorth                     ; 0 = N
1934+ F804 3D               DEC A
1935+ F805 28 0B            JR Z, .chpSouth                     ; 1 = S
1936+ F807 3D               DEC A
1937+ F808 28 0C            JR Z, .chpWest                      ; 2 = W
1938+ F80A                  ; Fall-through: 3 = E
1939+ F80A 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1940+ F80C 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1941+ F80E              .chpNorth:
1942+ F80E 41               LD B, C                             ; charX = coord
1943+ F80F 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1944+ F811 C9               RET
1945+ F812              .chpSouth:
1946+ F812 41               LD B, C
1947+ F813 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1948+ F815 C9               RET
1949+ F816              .chpWest:
1950+ F816 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1951+ F818                  ; fall-through a .chpVertShift
1952+ F818              .chpVertShift:
1953+ F818                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1954+ F818                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1955+ F818                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1956+ F818 79               LD A, C
1957+ F819 FE 07            CP 7
1958+ F81B D8               RET C                               ; coord < 7: gap superior, charY = coord
1959+ F81C 3C               INC A                               ; gap inferior: charY = coord + 1
1960+ F81D 4F               LD C, A
1961+ F81E C9               RET
1962+ F81F
1963+ F81F              ; ==============================================================================
1964+ F81F              ; DrawHintAtPos - Load sprite + XOR-draw flecha en (B=dir, C=coord)
1965+ F81F              ; ==============================================================================
1966+ F81F              ; IN:  B = PathDir (0=N, 1=S, 2=W, 3=E)
1967+ F81F              ;      C = PathCoord (char col para N/S, char row para W/E)
1968+ F81F              ; Destruye: AF, BC, DE, HL, IX.
1969+ F81F              ; ==============================================================================
1970+ F81F              DrawHintAtPos:
1971+ F81F CD 49 F8         CALL LoadHintSprite                 ; HL = ptr cargado a BgSpriteBuffer; preserva BC
1972+ F822 CD 00 F8         CALL ComputeHintPos                 ; B=charX, C=charY
1973+ F825 DD 21 F8 86      LD IX, BgSpriteBuffer
1974+ F829 C3 E0 DB         JP DrawBgSpriteXOR                  ; tail call
1975+ F82C
1976+ F82C              ; ==============================================================================
1977+ F82C              ; EraseHintAtPos - XOR-erase + restore attrs en (B=dir, C=coord)
1978+ F82C              ; ==============================================================================
1979+ F82C              ; Llamado al cambiar de path/sala/cancel. Mismo XOR-draw que erase los pixels,
1980+ F82C              ; mas RestorePickupAttrs para limpiar las attrs (de lo contrario quedan
1981+ F82C              ; cuadrados verdes huerfanos en pantalla).
1982+ F82C              ; ==============================================================================
1983+ F82C              EraseHintAtPos:
1984+ F82C CD 49 F8         CALL LoadHintSprite                 ; HL=ptr; BgSpriteBuffer poblado
1985+ F82F CD 00 F8         CALL ComputeHintPos                 ; B=charX, C=charY
1986+ F832 C5               PUSH BC                             ; save charX, charY for RestorePickupAttrs
1987+ F833 DD 21 F8 86      LD IX, BgSpriteBuffer
1988+ F837 CD E0 DB         CALL DrawBgSpriteXOR                ; XOR-erase pixels
1989+ F83A C1               POP BC
1990+ F83B                  ; height_chars depende del sprite (2 para 16x16, 3 para 16x24).
1991+ F83B                  ; Leer del header: BgSpriteBuffer[0] = height_px; /8 = char rows.
1992+ F83B 3A F8 86         LD A, (BgSpriteBuffer)
1993+ F83E 0F               RRCA
1993+ F83F 0F             RRCA
1993+ F840 0F             RRCA                  ; /8
1994+ F841 E6 1F            AND $1F
1995+ F843 57               LD D, A                             ; height_chars
1996+ F844 1E 02            LD E, 2                             ; width_chars (siempre 2 para flechas)
1997+ F846 C3 76 DC         JP RestorePickupAttrs               ; tail call: restaura attrs desde CleanAttrMap
1998+ F849
1999+ F849              ; ==============================================================================
2000+ F849              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2001+ F849              ; ==============================================================================
2002+ F849              ; IN:  B = PathDir, C = PathCoord
2003+ F849              ; OUT: BgSpriteBuffer poblado con sprite
2004+ F849              ; Destruye: AF, DE, HL. Preserva BC.
2005+ F849              ;
2006+ F849              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2007+ F849              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2008+ F849              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2009+ F849              ; ==============================================================================
2010+ F849              LoadHintSprite:
2011+ F849 78               LD A, B
2012+ F84A FE 02            CP 2                                ; W?
2013+ F84C 28 12            JR Z, .lhsW
2014+ F84E FE 03            CP 3                                ; E?
2015+ F850 28 1D            JR Z, .lhsE
2016+ F852                  ; N o S -> tabla base
2017+ F852 87               ADD A, A                            ; *2
2018+ F853 5F               LD E, A
2019+ F854 16 00            LD D, 0
2020+ F856 21 81 F8         LD HL, HintArrowPtrs
2021+ F859 19               ADD HL, DE
2022+ F85A 5E               LD E, (HL)
2023+ F85B 23               INC HL
2024+ F85C 56               LD D, (HL)
2025+ F85D EB               EX DE, HL                           ; HL = sprite ptr
2026+ F85E 18 1C            JR .lhsLoad
2027+ F860              .lhsW:
2028+ F860 79               LD A, C
2029+ F861 FE 07            CP 7
2030+ F863 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2031+ F865 21 5D F3         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
2032+ F868 18 12            JR .lhsLoad
2033+ F86A              .lhsWBase:
2034+ F86A 21 0B F3         LD HL, BgGfx_arrow_2x2_west
2035+ F86D 18 0D            JR .lhsLoad
2036+ F86F              .lhsE:
2037+ F86F 79               LD A, C
2038+ F870 FE 07            CP 7
2039+ F872 30 05            JR NC, .lhsEBase
2040+ F874 21 98 F3         LD HL, BgGfx_arrow_2x3_east
2041+ F877 18 03            JR .lhsLoad
2042+ F879              .lhsEBase:
2043+ F879 21 34 F3         LD HL, BgGfx_arrow_2x2_east
2044+ F87C              .lhsLoad:
2045+ F87C 3E 03            LD A, 3                             ; bank 3 (bg_gfx.asm)
2046+ F87E C3 C2 6C         JP LoadBgSpriteToBuffer             ; tail call (preserva BC)
2047+ F881
2048+ F881              ; Sprite ptrs ordenados por PathDir: 0=N, 1=S, 2=W, 3=E. 16x16 = 2x2 chars.
2049+ F881              ; Los labels los crea inject_pickup_sprites.py si no estan placed.
2050+ F881              HintArrowPtrs:
2051+ F881 B9 F2            DEFW BgGfx_arrow_2x2_north          ; 0 = N (id 42)
2052+ F883 E2 F2            DEFW BgGfx_arrow_2x2_south          ; 1 = S (id 49)
2053+ F885 0B F3            DEFW BgGfx_arrow_2x2_west           ; 2 = W (id 80)
2054+ F887 34 F3            DEFW BgGfx_arrow_2x2_east           ; 3 = E (id 82)
2055+ F889
2056+ F889              ; Cache: ultima posicion dibujada (para erase + skip-no-op). 4 B en bank 0.
2057+ F889 FF           HintLastDir:        DEFB $FF            ; $FF = nada dibujado
2058+ F88A 00           HintLastCoord:      DEFB 0
