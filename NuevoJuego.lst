2234+ AB39              .cwDoCheck:
2235+ AB39                  ; AABB con margen de 8px (1 celda) por cada lado:
2236+ AB39                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2237+ AB39                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2238+ AB39                  ; --- Check X ---
2239+ AB39 3A 60 8D         LD A, (WellPosX)
2240+ AB3C C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2241+ AB3E 4F               LD C, A
2242+ AB3F 3A A6 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2243+ AB42 B9               CP C                                ; playerX < wellRight+margen?
2244+ AB43 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2245+ AB45 3A A6 81         LD A, (EntityTable + ENT_POSX)
2246+ AB48 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2247+ AB4A 4F               LD C, A
2248+ AB4B 3A 60 8D         LD A, (WellPosX)                    ; A = wellX
2249+ AB4E B9               CP C                                ; wellX < playerRight+margen?
2250+ AB4F 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2251+ AB51                  ; --- Check Y ---
2252+ AB51 3A 61 8D         LD A, (WellPosY)
2253+ AB54 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2254+ AB56 4F               LD C, A
2255+ AB57 3A A7 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2256+ AB5A B9               CP C                                ; playerY < wellBottom+margen?
2257+ AB5B 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2258+ AB5D 3A A7 81         LD A, (EntityTable + ENT_POSY)
2259+ AB60 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2260+ AB62 4F               LD C, A
2261+ AB63 3A 61 8D         LD A, (WellPosY)                    ; A = wellY
2262+ AB66 B9               CP C                                ; wellY < playerBottom+margen?
2263+ AB67 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2264+ AB69                  ; --- Overlap! Recuperar salud y stamina ---
2265+ AB69 3E 10            LD A, HEALTH_MAX
2266+ AB6B 32 89 B3         LD (PlayerHealth), A
