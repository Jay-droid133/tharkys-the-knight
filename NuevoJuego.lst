 166  7562
 167  7562                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 168  7562                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 169  7562                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 170  7562                  ;
 171  7562                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 172  7562                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 173  7562                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 174  7562                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 175  7562                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 176  7562                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 177  7562                  ; mantiene por estabilidad.
 178  7562                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 7562              ; ==============================================================================
   2+ 7562              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 7562              ; ==============================================================================
   4+ 7562              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 7562              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 7562              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 7562              ;
   8+ 7562              ; Estrategia:
   9+ 7562              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 7562              ;      bank 0 paginado en slot 3.
  11+ 7562              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 7562              ;      seguro hacer la conmutación aquí).
  13+ 7562              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 7562              ;   4. Body retorna → restauramos bank 0.
  15+ 7562              ;
  16+ 7562              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 7562              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 7562              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 7562              ; ==============================================================================
  20+ 7562
  21+ 7562              DrawTombstone2xCentered:
  22+ 7562                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 7562 21 6C D9         LD HL, BgGfx_little_house_cemetery
  24+ 7565 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 7567 CD C2 6C         CALL LoadBgSpriteToBuffer
  26+ 756A
  27+ 756A                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 756A F3               DI
  29+ 756B 3A 82 8D         LD A, (CurrentPaging)
  30+ 756E E6 F8            AND $F8
  31+ 7570 F6 07            OR 7
  32+ 7572 32 82 8D         LD (CurrentPaging), A
  33+ 7575 01 FD 7F         LD BC, $7FFD
  34+ 7578 ED 79            OUT (C), A
  35+ 757A
  36+ 757A                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 757A CD BC D9         CALL DrawTombstone2xBody
  38+ 757D
  39+ 757D                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 757D 3A 82 8D         LD A, (CurrentPaging)
  41+ 7580 E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 7582 32 82 8D         LD (CurrentPaging), A
  43+ 7585 01 FD 7F         LD BC, $7FFD
  44+ 7588 ED 79            OUT (C), A
  45+ 758A
  46+ 758A                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 758A 3A 9A 81         LD A, (StartupComplete)
  48+ 758D B7               OR A
  49+ 758E C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 758F FB               EI
  51+ 7590 C9               RET
  52+ 7591
# file closed: game_over_tomb_thunk.asm
 179  7591
 180  7591                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 181  7591                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 182  7591                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 183  7591                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 184  7591                  ;
 185  7591                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 186  7591                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 187  7591                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 188  7591                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 189  7591                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 190  7591                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 191  7591                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 7591              ; ==============================================================================
   2+ 7591              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 7591              ; ==============================================================================
   4+ 7591              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 7591              ; Mientras MagicCompassTimer>0:
   6+ 7591              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 7591              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 7591              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 7591              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 7591              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 7591              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 7591              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 7591              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 7591              ;
  15+ 7591              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 7591              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 7591              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 7591              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 7591              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 7591              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 7591              ;
  22+ 7591              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 7591              ; ==============================================================================
  24+ 7591
  25+ 7591              ; ==============================================================================
  26+ 7591              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 7591              ; ==============================================================================
  28+ 7591              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 7591              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 7591              ; Destruye: AF, HL.
  31+ 7591              ; ==============================================================================
