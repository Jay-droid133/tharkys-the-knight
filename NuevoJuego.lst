 852+ E209
 853+ E209              ; ==============================================================================
 854+ E209              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 855+ E209              ; ==============================================================================
 856+ E209              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 857+ E209              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 858+ E209              ;
 859+ E209              ; Estado:
 860+ E209              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 861+ E209              ;   BankCutsceneTimer:    decrementa por frame
 862+ E209              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 863+ E209              ;
 864+ E209              ; Logica:
 865+ E209              ;   - Tick timer. Si != 0, return 0.
 866+ E209              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 867+ E209              ;   - Si SubState=GAP y timer=0:
 868+ E209              ;       - increment KnockIdx
 869+ E209              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 870+ E209              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 871+ E209              ;
 872+ E209              ; Destruye: A, BC, DE, HL.
 873+ E209              ; ==============================================================================
 874+ E209              BankCutsceneTickKnockGroup:
 875+ E209 47               LD B, A                             ; B = total knocks
 876+ E20A 3A D2 82         LD A, (BankCutsceneTimer)
 877+ E20D 3D               DEC A
 878+ E20E 32 D2 82         LD (BankCutsceneTimer), A
 879+ E211 B7               OR A
 880+ E212 28 02            JR Z, .bctkgTimer0
 881+ E214 AF               XOR A                               ; sigue, no terminado
 882+ E215 C9               RET
 883+ E216              .bctkgTimer0:
 884+ E216 3A D3 82         LD A, (BankCutsceneSubState)
 885+ E219 B7               OR A
 886+ E21A 20 0C            JR NZ, .bctkgGap0
 887+ E21C                  ; HIT acabo: switch a GAP.
 888+ E21C 3E 01            LD A, BCS_KNOCK_GAP
 889+ E21E 32 D3 82         LD (BankCutsceneSubState), A
 890+ E221 3E 05            LD A, BCS_T_KNOCK_GAP
 891+ E223 32 D2 82         LD (BankCutsceneTimer), A
 892+ E226 AF               XOR A
 893+ E227 C9               RET
 894+ E228              .bctkgGap0:
 895+ E228                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 896+ E228 3A D4 82         LD A, (BankCutsceneKnockIdx)
 897+ E22B 3C               INC A
 898+ E22C 32 D4 82         LD (BankCutsceneKnockIdx), A
 899+ E22F B8               CP B
 900+ E230 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 901+ E232                  ; grupo terminado.
 902+ E232 3E 01            LD A, 1
 903+ E234 C9               RET
 904+ E235              .bctkgNextHit:
 905+ E235 3E 00            LD A, BCS_KNOCK_HIT
 906+ E237 32 D3 82         LD (BankCutsceneSubState), A
 907+ E23A 3E 04            LD A, BCS_T_KNOCK_HIT
 908+ E23C 32 D2 82         LD (BankCutsceneTimer), A
 909+ E23F CD 44 E2         CALL BankCutsceneEmitKnockHit
 910+ E242 AF               XOR A
 911+ E243 C9               RET
 912+ E244
 913+ E244              ; ==============================================================================
 914+ E244              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 915+ E244              ; ==============================================================================
 916+ E244              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 917+ E244              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 918+ E244              ; Destruye: A, BC, DE, HL.
 919+ E244              ; ==============================================================================
 920+ E244              BankCutsceneEmitKnockHit:
 921+ E244 C3 C6 E2         JP SFX_Bank_OnKnock                 ; tail-call
 922+ E247
 923+ E247              ; ==============================================================================
 924+ E247              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 925+ E247              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 926+ E247              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 927+ E247              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 928+ E247              ; oscuridad de la rendija".
 929+ E247              BCS_DOOR_HAND_ATTR      EQU $47
 930+ E247
 931+ E247              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 932+ E247              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 933+ E247              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 934+ E247              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 935+ E247              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 936+ E247
 937+ E247              ; ==============================================================================
 938+ E247              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 939+ E247              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 940+ E247              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 941+ E247              ; pixels visibles bright white sobre fondo negro.
 942+ E247              ;
 943+ E247              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 944+ E247              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 945+ E247              ; dos llamadas no cancelan, solo re-pintan.
 946+ E247              ; Destruye: AF, BC, DE, HL, IX.
 947+ E247              ; ==============================================================================
 948+ E247              BankCutsceneOpenDoorWithHandAttrs:
 949+ E247 21 21 F1         LD HL, BgGfx_bank_door_closed
 950+ E24A 3E 03            LD A, 3                             ; bank 3
 951+ E24C CD DE 6E         CALL LoadBgSpriteToBuffer_B7        ; thunk slot 1: carga + repagina bank 7 al RET
 952+ E24F DD 21 FD 86      LD IX, BgSpriteBuffer
 953+ E253 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 954+ E255 0E 04            LD C, BCS_DOOR_CHARY                ; 4
