 172+ 9E8D 21 DA 9B         LD HL, SavedAttrTable
 173+ 9E90 11 DB 9B         LD DE, SavedAttrTable + 1
 174+ 9E93 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E96 AF               XOR A
 176+ 9E97 77               LD (HL), A
 177+ 9E98 ED B0            LDIR
