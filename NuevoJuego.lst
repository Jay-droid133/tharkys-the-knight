1282+ D436              ; ==============================================================================
1283+ D436              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
1284+ D436              ; ==============================================================================
1285+ D436              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
1286+ D436              ; Salida:  IX = primer byte tras pixel data (tintPaper)
1287+ D436              ; Modifica: AF, BC, DE, HL
1288+ D436              ; ==============================================================================
1289+ D436              SkipPixelData:
1290+ D436 DD 7E 00         LD A, (IX+0)                ; height_px
1291+ D439 57               LD D, A                     ; D = height_px
1292+ D43A DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
1293+ D43D 5F               LD E, A                     ; E = raw value con flag
1294+ D43E DD 23            INC IX
1295+ D440 DD 23            INC IX                      ; IX -> pixel data
1296+ D442
1297+ D442 CB 7B            BIT 7, E
1298+ D444 20 0A            JR NZ, .spSkipRle
1299+ D446
1300+ D446                  ; --- Path literal: saltar height * width bytes ---
1301+ D446 7B               LD A, E                     ; width_bytes (sin flag, bit7=0)
1302+ D447              .spLitRow:
1303+ D447 47               LD B, A
1304+ D448              .spLitCol:
1305+ D448 DD 23            INC IX
1306+ D44A 10 FC            DJNZ .spLitCol
1307+ D44C 15               DEC D
1308+ D44D 20 F8            JR NZ, .spLitRow
1309+ D44F C9               RET
1310+ D450
1311+ D450                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1312+ D450                  ; Total pixeles = height_px * (width_bytes & $7F)
1313+ D450              .spSkipRle:
1314+ D450 7B               LD A, E
1315+ D451 E6 7F            AND $7F                     ; width_bytes real
1316+ D453                  ; Calcular total = D * A (height * width)
1317+ D453 42               LD B, D                     ; B = height
1318+ D454 21 00 00         LD HL, 0
1319+ D457 16 00            LD D, 0
1320+ D459 5F               LD E, A                     ; DE = width
1321+ D45A              .spMul:
1322+ D45A 19               ADD HL, DE
1323+ D45B 10 FD            DJNZ .spMul
1324+ D45D                  ; HL = total pixeles a consumir
1325+ D45D                  ; Recorrer tokens RLE hasta consumir HL pixeles
1326+ D45D              .spRleLoop:
1327+ D45D 7C               LD A, H
1328+ D45E B5               OR L
1329+ D45F C8               RET Z                       ; 0 pixeles restantes → IX en posicion correcta
1330+ D460 DD 7E 00         LD A, (IX+0)
1331+ D463 DD 23            INC IX
1332+ D465 CB 7F            BIT 7, A
1333+ D467 20 0C            JR NZ, .spRleRun
1334+ D469                  ; Literal group: consume A bytes de datos (A = count 1-127)
1335+ D469 5F               LD E, A
1336+ D46A 16 00            LD D, 0
1337+ D46C ED 52            SBC HL, DE                  ; HL -= count
1338+ D46E                  ; Saltar los bytes literales
1339+ D46E 43               LD B, E
1340+ D46F              .spRleLitSkip:
1341+ D46F DD 23            INC IX
1342+ D471 10 FC            DJNZ .spRleLitSkip
1343+ D473 18 E8            JR .spRleLoop
1344+ D475              .spRleRun:
1345+ D475                  ; Run: consume (A & $7F)+2 pixeles, saltar 1 byte valor
1346+ D475 E6 7F            AND $7F
1347+ D477 C6 02            ADD A, 2
1348+ D479 5F               LD E, A
1349+ D47A 16 00            LD D, 0
1350+ D47C ED 52            SBC HL, DE                  ; HL -= count
1351+ D47E DD 23            INC IX                      ; saltar byte valor
1352+ D480 18 DB            JR .spRleLoop
