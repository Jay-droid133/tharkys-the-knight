 467  8188                  ; Incrementar contador de frames
 468  8188 3A A0 81         LD A, (GameFrameCounter)
 469  818B 3C               INC A
 470  818C 32 A0 81         LD (GameFrameCounter), A
 471  818F
 472  818F                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 473  818F              .frameSync:
 474  818F 76               HALT                        ; Dormir hasta siguiente interrupt
 475  8190 3A 9F 81         LD A, (.frameStart)
 476  8193 47               LD B, A
 477  8194 3A 78 5C         LD A, ($5C78)
 478  8197 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 479  8198 FE 02            CP 2
 480  819A 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
 481  819C
 482  819C C3 00 80         JP MainLoop
 483  819F 00           .frameStart: DEFB 0
