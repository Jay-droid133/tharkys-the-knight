4718+ B8FE                  ; (Zone garantizada por el picker desde ZoneCellList; si fallback random,
4719+ B8FE                  ; .spawnIgnoreZone=1 y aceptamos cualquier zona.)
4720+ B8FE                  ; --- Solapamiento con player (AABB ambos ejes < 24 px = overlap real) ---
4721+ B8FE                  ; Antes el check era OR (cualquiera de los ejes < 24 → block). Eso es una
4722+ B8FE                  ; CRUZ de exclusion: si player en el pasillo, TODA la fila del pasillo se
4723+ B8FE                  ; rechaza por Y cercana → nunca aparecen nasties en el pasillo. AND es
4724+ B8FE                  ; correcto: solo bloquear si los rectangulos solapan en 2D.
4725+ B8FE 3A 9E 81         LD A, (EntityTable + ENT_POSX)
4726+ B901 DD 96 03         SUB (IX+ENT_POSX)
4727+ B904 30 02            JR NC, .spAbsX
4728+ B906 ED 44            NEG
4729+ B908              .spAbsX:
4730+ B908 FE 18            CP 24
4731+ B90A 30 0E            JR NC, .spPlayerOk                  ; |dx| >= 24 → no overlap posible, skip Y
4732+ B90C 3A 9F 81         LD A, (EntityTable + ENT_POSY)
4733+ B90F DD 96 04         SUB (IX+ENT_POSY)
4734+ B912 30 02            JR NC, .spAbsY
4735+ B914 ED 44            NEG
4736+ B916              .spAbsY:
4737+ B916 FE 18            CP 24
4738+ B918 38 44            JR C, .spawnBlocked                 ; |dx| < 24 AND |dy| < 24 → demasiado cerca
4739+ B91A              .spPlayerOk:
4740+ B91A                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4741+ B91A                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4742+ B91A DD E5            PUSH IX
4743+ B91C E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4744+ B91D FD 21 0B 82      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4745+ B921 06 03            LD B, NUM_NASTIES
4746+ B923              .spDistLoop:
4747+ B923 C5               PUSH BC
4748+ B924 E5               PUSH HL
4749+ B925 FD E5            PUSH IY
4750+ B927 D1               POP DE                              ; DE = ptr al slot vecino
4751+ B928 B7               OR A
4752+ B929 ED 52            SBC HL, DE                          ; HL == 0 → mismo slot, skip
4753+ B92B E1               POP HL
4754+ B92C 28 25            JR Z, .spDistNext
4755+ B92E FD 7E 01         LD A, (IY+ENT_TYPE)
4756+ B931 B7               OR A
4757+ B932 28 1F            JR Z, .spDistNext                   ; vecino vacio
4758+ B934                  ; |dx|
4759+ B934 DD 7E 03         LD A, (IX+ENT_POSX)
4760+ B937 FD 96 03         SUB (IY+ENT_POSX)
4761+ B93A 30 02            JR NC, .spdAbsX
4762+ B93C ED 44            NEG
4763+ B93E              .spdAbsX:
4764+ B93E FE 20            CP 32
4765+ B940 30 11            JR NC, .spDistNext                  ; suficiente separacion en X
4766+ B942                  ; |dy|
4767+ B942 DD 7E 04         LD A, (IX+ENT_POSY)
4768+ B945 FD 96 04         SUB (IY+ENT_POSY)
4769+ B948 30 02            JR NC, .spdAbsY
4770+ B94A ED 44            NEG
4771+ B94C              .spdAbsY:
4772+ B94C FE 20            CP 32
4773+ B94E 30 03            JR NC, .spDistNext
4774+ B950                  ; Demasiado cerca en ambos ejes → retry
4775+ B950 C1               POP BC
4776+ B951 18 0B            JR .spawnBlocked
4777+ B953              .spDistNext:
4778+ B953 11 10 00         LD DE, ENT_SIZE
4779+ B956 FD 19            ADD IY, DE
4780+ B958 C1               POP BC
4781+ B959 10 C8            DJNZ .spDistLoop
4782+ B95B C3 85 B9         JP .spawnPosOk
4783+ B95E              .spawnBlocked:
4784+ B95E 3A 80 B9         LD A, (.spawnTries)
4785+ B961 3D               DEC A
4786+ B962 32 80 B9         LD (.spawnTries), A
4787+ B965 C2 35 B8         JP NZ, .spawnRetry
4788+ B968                  ; Primera ronda fallida. Si respetabamos zona (8 retries quemados sin
4789+ B968                  ; encontrar celda alcanzable), hacer 4 mas ignorando zona como fallback.
4790+ B968 3A 81 B9         LD A, (.spawnIgnoreZone)
4791+ B96B B7               OR A
4792+ B96C 20 0D            JR NZ, .spawnGiveUp
4793+ B96E 3E 01            LD A, 1
4794+ B970 32 81 B9         LD (.spawnIgnoreZone), A
4795+ B973 3E 04            LD A, 4
4796+ B975 32 80 B9         LD (.spawnTries), A
4797+ B978 C3 35 B8         JP .spawnRetry
4798+ B97B              .spawnGiveUp:
4799+ B97B                  ; Todos los intentos fallaron → cancelar spawn
4800+ B97B DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4801+ B97F C9               RET
