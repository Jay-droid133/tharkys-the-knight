 531+ 663F              ; ==============================================================================
 532+ 663F              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 533+ 663F              ; ==============================================================================
 534+ 663F              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 535+ 663F              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 536+ 663F              ;
 537+ 663F              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 538+ 663F              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 539+ 663F              ;     E = pixel X (0-255).
 540+ 663F              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 541+ 663F              ; Solo XOR de pixels (no toca attrs).
 542+ 663F              ; Destruye: AF, BC, DE, HL, IX.
 543+ 663F              ; ==============================================================================
 544+ 663F              DrawBgSprite16XorAtPixel:
 545+ 663F DD 21 FD 86      LD IX, BgSpriteBuffer
 546+ 6643 DD 7E 00         LD A, (IX+0)                            ; height_px
 547+ 6646 B7               OR A
 548+ 6647 C8               RET Z
 549+ 6648 32 AB 66         LD (.dbsHeight), A
 550+ 664B DD 23            INC IX
 551+ 664D DD 23            INC IX                                  ; -> pixel data
 552+ 664F                  ; Shift = E & 7 ; aligned X = E & ~7
 553+ 664F 7B               LD A, E
 554+ 6650 E6 07            AND $07
 555+ 6652 32 AC 66         LD (.dbsShift), A
 556+ 6655 7B               LD A, E
 557+ 6656 E6 F8            AND $F8
 558+ 6658 5F               LD E, A
 559+ 6659 CD 62 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
 560+ 665C              .dbsRow:
 561+ 665C E5               PUSH HL                                 ; save row start
 562+ 665D                  ; --- Byte 0 del sprite ---
 563+ 665D DD 7E 00         LD A, (IX+0)
 564+ 6660 2F               CPL                                     ; un-invert
 565+ 6661 57               LD D, A                                 ; D = sprite byte
 566+ 6662 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 567+ 6664 3A AC 66         LD A, (.dbsShift)
 568+ 6667 B7               OR A
 569+ 6668 28 07            JR Z, .dbsNoShift0
 570+ 666A 47               LD B, A
 571+ 666B              .dbsShift0Loop:
 572+ 666B CB 3A            SRL D
 573+ 666D CB 1B            RR E
 574+ 666F 10 FA            DJNZ .dbsShift0Loop
 575+ 6671              .dbsNoShift0:
 576+ 6671 7A               LD A, D
 577+ 6672 AE               XOR (HL)
 578+ 6673 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 579+ 6674 23               INC HL
 580+ 6675 4B               LD C, E                                 ; C = carry para siguiente byte
 581+ 6676                  ; --- Byte 1 del sprite ---
 582+ 6676 DD 7E 01         LD A, (IX+1)
