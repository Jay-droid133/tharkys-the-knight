5863+ BF4F DD 19            ADD IX, DE
5864+ BF51 C1               POP BC
5865+ BF52 0C               INC C
5866+ BF53 05               DEC B
5867+ BF54 C2 9B BE         JP NZ, .rmLoop
5868+ BF57 C9               RET
5869+ BF58
5870+ BF58 00           .rmTimer: DEFB 0
5871+ BF59 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5872+ BF5C
5873+ BF5C              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5874+ BF5C              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5875+ BF5C              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5876+ BF5C              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5877+ BF5C              ; empujado).
5878+ BF5C              .rmUpdateReturnTimers:
5879+ BF5C 21 8D B3         LD HL, MonsterReturnTimer
5880+ BF5F DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5881+ BF63 06 03            LD B, MONSTERS_TO_SPAWN
5882+ BF65              .rmRtLoop:
5883+ BF65 7E               LD A, (HL)
5884+ BF66 B7               OR A
5885+ BF67 CA 3C C0         JP Z, .rmRtNext
5886+ BF6A 3D               DEC A
5887+ BF6B 77               LD (HL), A
5888+ BF6C C2 3C C0         JP NZ, .rmRtNext
5889+ BF6F                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5890+ BF6F                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5891+ BF6F                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5892+ BF6F                  ; Calcular target coord: axis variable segun borde de salida.
5893+ BF6F                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5894+ BF6F DD 7E 0A         LD A, (IX+ENT_DIR)
5895+ BF72 FE 01            CP DIR_N
5896+ BF74 28 11            JR Z, .rmRtSideN
5897+ BF76 FE 02            CP DIR_S
5898+ BF78 28 1C            JR Z, .rmRtSideS
5899+ BF7A FE 04            CP DIR_E
5900+ BF7C CA B6 BF         JP Z, .rmRtSideE
5901+ BF7F FE 08            CP DIR_W
5902+ BF81 CA A5 BF         JP Z, .rmRtSideW
5903+ BF84 C3 13 C0         JP .rmRtFallback
5904+ BF87              .rmRtSideN:
5905+ BF87                  ; target coord = cx = POSX / 8
5906+ BF87 DD 7E 03         LD A, (IX+ENT_POSX)
5907+ BF8A 0F               RRCA
5908+ BF8B 0F               RRCA
5909+ BF8C 0F               RRCA
5910+ BF8D E6 1F            AND $1F
5911+ BF8F 32 C4 97         LD (MaiGapTargetCoord), A
5912+ BF92 3E 00            LD A, MAI_SIDE_N
5913+ BF94 18 2F            JR .rmRtPickGap
5914+ BF96              .rmRtSideS:
5915+ BF96 DD 7E 03         LD A, (IX+ENT_POSX)
5916+ BF99 0F               RRCA
5917+ BF9A 0F               RRCA
5918+ BF9B 0F               RRCA
5919+ BF9C E6 1F            AND $1F
5920+ BF9E 32 C4 97         LD (MaiGapTargetCoord), A
5921+ BFA1 3E 01            LD A, MAI_SIDE_S
5922+ BFA3 18 20            JR .rmRtPickGap
5923+ BFA5              .rmRtSideW:
5924+ BFA5                  ; target coord = cy = (POSY - 16) / 8
5925+ BFA5 DD 7E 04         LD A, (IX+ENT_POSY)
5926+ BFA8 D6 10            SUB SCREEN_MIN_Y
5927+ BFAA 0F               RRCA
5928+ BFAB 0F               RRCA
5929+ BFAC 0F               RRCA
5930+ BFAD E6 1F            AND $1F
5931+ BFAF 32 C4 97         LD (MaiGapTargetCoord), A
5932+ BFB2 3E 02            LD A, MAI_SIDE_W
5933+ BFB4 18 0F            JR .rmRtPickGap
5934+ BFB6              .rmRtSideE:
5935+ BFB6 DD 7E 04         LD A, (IX+ENT_POSY)
5936+ BFB9 D6 10            SUB SCREEN_MIN_Y
5937+ BFBB 0F               RRCA
5938+ BFBC 0F               RRCA
5939+ BFBD 0F               RRCA
5940+ BFBE E6 1F            AND $1F
5941+ BFC0 32 C4 97         LD (MaiGapTargetCoord), A
