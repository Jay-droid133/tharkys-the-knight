 616  EA6F
 617  EA6F                  ; --- Random pickups body (~1.26 KB, slot 1 -> bank 7 move) ---
 618  EA6F                  ; Antes vivia en slot 1 entre $6BF7..$70E4. Movido aqui para liberar slot 1
 619  EA6F                  ; (RoomCompGapsTable y la IM2 table compiten por el espacio anterior a $7A00).
 620  EA6F                  ; Los 9 entry points externos (UpdateRandomPickup, UpdateRoulette, ...) viven
 621  EA6F                  ; como thunks en slot 1 (random_pickups_thunks.asm). El body usa _B7 wrappers
 622  EA6F                  ; (LoadBgSpriteToBuffer_B7, DrawBgSpriteXOR_B7, PlaySFX_B7, SkipPixelData_B7,
 623  EA6F                  ; RestorePickupAttrs_B7, ApplyMagicCompassBuff_B7) para envolver cada CALL
 624  EA6F                  ; externo. Internamente las dispatch tail-JPs (GiveLife etc.) usan los Body
 625  EA6F                  ; suffix (intra-bank, no thunk).
 626  EA6F                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ EA6F              ; ==============================================================================
   2+ EA6F              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ EA6F              ; ==============================================================================
   4+ EA6F              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ EA6F              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ EA6F              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ EA6F              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ EA6F              ; correspondiente desde CheckPickupCollect.
   9+ EA6F              ;
  10+ EA6F              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ EA6F              ; si en el futuro se ponen pickups fijos en el editor.
  12+ EA6F              ;
  13+ EA6F              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ EA6F              ; Bank 0/2 quedan limpios.
  15+ EA6F              ; ==============================================================================
  16+ EA6F
  17+ EA6F              ; ==============================================================================
  18+ EA6F              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ EA6F              ; ==============================================================================
  20+ EA6F              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ EA6F              ; el cambio via cache .dlhLast.
  22+ EA6F              ; ==============================================================================
  23+ EA6F              GiveLifeBody:
  24+ EA6F 3A E3 82         LD A, (PlayerLives)
  25+ EA72 FE 05            CP PLAYER_LIVES_MAX
  26+ EA74 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ EA75 3C               INC A
  28+ EA76 32 E3 82         LD (PlayerLives), A
  29+ EA79 C9               RET
  30+ EA7A
  31+ EA7A              ; ==============================================================================
  32+ EA7A              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ EA7A              ; ==============================================================================
  34+ EA7A              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ EA7A              ; ==============================================================================
  36+ EA7A              GiveHealthBody:
  37+ EA7A 3A 86 B3         LD A, (PlayerHealth)
  38+ EA7D C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ EA7F 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ EA81 FE 11            CP HEALTH_MAX + 1
  41+ EA83 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ EA85              .ghCap:
  43+ EA85 3E 10            LD A, HEALTH_MAX
  44+ EA87              .ghStore:
  45+ EA87 32 86 B3         LD (PlayerHealth), A
  46+ EA8A C9               RET
  47+ EA8B
  48+ EA8B              ; ==============================================================================
  49+ EA8B              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ EA8B              ; ==============================================================================
  51+ EA8B              GiveStaminaBody:
  52+ EA8B 3A 87 B3         LD A, (PlayerStamina)
  53+ EA8E C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ EA90 38 04            JR C, .gsCap
  55+ EA92 FE 11            CP STAMINA_MAX + 1
  56+ EA94 38 02            JR C, .gsStore
  57+ EA96              .gsCap:
  58+ EA96 3E 10            LD A, STAMINA_MAX
  59+ EA98              .gsStore:
  60+ EA98 32 87 B3         LD (PlayerStamina), A
  61+ EA9B C9               RET
  62+ EA9C
  63+ EA9C              ; ==============================================================================
  64+ EA9C              ; ROULETTE — datos (fase 5: por categorias)
  65+ EA9C              ; ==============================================================================
  66+ EA9C              ; La ruleta cicla 6 caras en orden fijo:
  67+ EA9C              ;   ESPECIAL -> MALO -> RECURSO -> MALO -> STATS -> MALO -> (wrap)
  68+ EA9C              ; 50% de las caras son MALO -> tension al recoger sin mirar. Cada cara pica
  69+ EA9C              ; un item RANDOM dentro de su categoria cada tick (~480ms).
  70+ EA9C              ROULETTE_ORDER_LEN  EQU 6
  71+ EA9C
  72+ EA9C              ; Secuencia de las 6 caras (CAT_* enum):
  73+ EA9C              RouletteCatOrder:
  74+ EA9C 00               DEFB CAT_ESPECIAL                       ; cara 0
  75+ EA9D 01               DEFB CAT_MALO                           ; cara 1
  76+ EA9E 02               DEFB CAT_RECURSO                        ; cara 2
  77+ EA9F 01               DEFB CAT_MALO                           ; cara 3
  78+ EAA0 03               DEFB CAT_STATS                          ; cara 4
  79+ EAA1 01               DEFB CAT_MALO                           ; cara 5
  80+ EAA2
  81+ EAA2              ; Items por categoria (formato: DEFB count, ROUL_* items...):
  82+ EAA2              RouletteCatEspecial:
  83+ EAA2 03               DEFB 3
  84+ EAA3 01 07 0A         DEFB ROUL_LIFE, ROUL_COMPASS, ROUL_ESCUDO_RAYO
  85+ EAA6              RouletteCatMalo:
  86+ EAA6 03               DEFB 3
  87+ EAA7 06 05 0B         DEFB ROUL_MUSHROOM, ROUL_CARACOL, ROUL_REVERSE
  88+ EAAA              RouletteCatRecurso:
  89+ EAAA 02               DEFB 2
  90+ EAAB 02 03            DEFB ROUL_HEALTH, ROUL_STAMINA
  91+ EAAD              RouletteCatStats:
  92+ EAAD 03               DEFB 3
  93+ EAAE 04 08 09         DEFB ROUL_RAYO, ROUL_ESPADA, ROUL_ESCUDO
  94+ EAB1
  95+ EAB1              ; Lookup CAT_* -> cat table ptr (DEFW):
  96+ EAB1              RouletteCatItemTables:
  97+ EAB1 A2 EA            DEFW RouletteCatEspecial                ; CAT_ESPECIAL = 0
  98+ EAB3 A6 EA            DEFW RouletteCatMalo                    ; CAT_MALO = 1
  99+ EAB5 AA EA            DEFW RouletteCatRecurso                 ; CAT_RECURSO = 2
 100+ EAB7 AD EA            DEFW RouletteCatStats                   ; CAT_STATS = 3
 101+ EAB9
 102+ EAB9              ; RouletteTypePtrs: lookup ROUL_* (1..11) -> BgGfx canonical ptr.
 103+ EAB9              ; HEALTH/STAMINA usan variant pick (PickRandomVariantPtr), no esta tabla.
 104+ EAB9              RouletteTypePtrs:
 105+ EAB9 84 CC            DEFW BgGfx_life                                     ; ROUL_LIFE        = 1
 106+ EABB EC F1            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH      = 2 (unused: variants)
 107+ EABD 91 E7            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA     = 3 (unused: variants)
 108+ EABF BA E7            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO        = 4
 109+ EAC1 E3 E7            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL     = 5
 110+ EAC3 0C E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM    = 6
 111+ EAC5 88 F1            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS     = 7
 112+ EAC7 86 F3            DEFW BgGfx_pickup_sword                             ; ROUL_ESPADA      = 8
 113+ EAC9 34 F3            DEFW BgGfx_pickup_shield                            ; ROUL_ESCUDO      = 9
 114+ EACB 5D F3            DEFW BgGfx_pickup_shield_ray                        ; ROUL_ESCUDO_RAYO = 10
 115+ EACD AF F3            DEFW BgGfx_pickup_reverse                           ; ROUL_REVERSE     = 11
 116+ EACF
 117+ EACF              ; ==============================================================================
 118+ EACF              ; GetRoulettePtrByIdx - dado RouletteIdx (0..5), pica un item random de la cat
 119+ EACF              ; ==============================================================================
 120+ EACF              ; IN:  A = RouletteIdx (0..5)
 121+ EACF              ; OUT: HL = BgGfx ptr al sprite picado.
 122+ EACF              ;      Side: RouletteDisplayedType <- ROUL_* picado (para .crsApplyRouletteHit).
 123+ EACF              ; Destruye: AF, BC, DE, HL.
 124+ EACF              ;
 125+ EACF              ; Logica:
 126+ EACF              ;   1. cat = RouletteCatOrder[idx]
 127+ EACF              ;   2. table = RouletteCatItemTables[cat]    (DEFB count, DEFB items...)
 128+ EACF              ;   3. R mod count -> pick. Si pick == ROUL_COMPASS y MagicCompassPermanent
 129+ EACF              ;      activo, re-pica (loop). RouletteCatEspecial tiene 2 items non-compass
 130+ EACF              ;      => terminacion garantizada.
 131+ EACF              ;   4. Store ROUL_* en RouletteDisplayedType.
 132+ EACF              ;   5. Si ROUL_HEALTH / ROUL_STAMINA -> PickRandomVariantPtr (variante random).
 133+ EACF              ;      Resto -> lookup canonical en RouletteTypePtrs.
 134+ EACF              ;
 135+ EACF              ; .grpiCount / .grpiItems: scratch DEFB/DEFW al final de la rutina (bank 7).
 136+ EACF              ; ==============================================================================
 137+ EACF              GetRoulettePtrByIdx:
 138+ EACF                  ; --- 1. Resolve cat ptr ---
 139+ EACF 21 9C EA         LD HL, RouletteCatOrder
 140+ EAD2 5F               LD E, A
 141+ EAD3 16 00            LD D, 0
 142+ EAD5 19               ADD HL, DE
 143+ EAD6 7E               LD A, (HL)                              ; A = cat (0..3)
 144+ EAD7 87               ADD A, A
 145+ EAD8 5F               LD E, A
 146+ EAD9 21 B1 EA         LD HL, RouletteCatItemTables
 147+ EADC 19               ADD HL, DE
 148+ EADD 7E               LD A, (HL)
 149+ EADE 23               INC HL
 150+ EADF 66               LD H, (HL)
 151+ EAE0 6F               LD L, A                                 ; HL = cat table (count + items)
 152+ EAE1 7E               LD A, (HL)
 153+ EAE2 32 2B EB         LD (.grpiCount), A                      ; save count en scratch
 154+ EAE5 23               INC HL
 155+ EAE6 22 2C EB         LD (.grpiItems), HL                     ; save items ptr en scratch
 156+ EAE9
 157+ EAE9              .grpiPick:
 158+ EAE9 3A 2B EB         LD A, (.grpiCount)
 159+ EAEC 47               LD B, A
 160+ EAED ED 5F            LD A, R
 161+ EAEF              .grpiMod:
 162+ EAEF 90               SUB B
 163+ EAF0 30 FD            JR NC, .grpiMod
 164+ EAF2 80               ADD A, B                                ; A = R mod count
 165+ EAF3 5F               LD E, A
 166+ EAF4 16 00            LD D, 0
 167+ EAF6 2A 2C EB         LD HL, (.grpiItems)
 168+ EAF9 19               ADD HL, DE
 169+ EAFA 7E               LD A, (HL)                              ; A = ROUL_* picado
 170+ EAFB
 171+ EAFB                  ; --- Skip compass si lasting permanent ---
 172+ EAFB 21 CA 82         LD HL, MagicCompassPermanent
 173+ EAFE CB 46            BIT 0, (HL)
 174+ EB00 28 04            JR Z, .grpiPicked
 175+ EB02 FE 07            CP ROUL_COMPASS
 176+ EB04 28 E3            JR Z, .grpiPick                         ; compass + permanent -> re-pica
 177+ EB06
 178+ EB06              .grpiPicked:
 179+ EB06 32 E0 5F         LD (RouletteDisplayedType), A           ; persistir para dispatcher al recoger
 180+ EB09
 181+ EB09                  ; --- Lookup sprite ptr ---
 182+ EB09 FE 02            CP ROUL_HEALTH
 183+ EB0B 28 12            JR Z, .grpiHealth
 184+ EB0D FE 03            CP ROUL_STAMINA
 185+ EB0F 28 14            JR Z, .grpiStamina
 186+ EB11                  ; Resto: canonical en RouletteTypePtrs[A-1]
 187+ EB11 3D               DEC A
 188+ EB12 26 00            LD H, 0
 189+ EB14 6F               LD L, A
 190+ EB15 29               ADD HL, HL
 191+ EB16 11 B9 EA         LD DE, RouletteTypePtrs
 192+ EB19 19               ADD HL, DE
 193+ EB1A 7E               LD A, (HL)
 194+ EB1B 23               INC HL
 195+ EB1C 66               LD H, (HL)
 196+ EB1D 6F               LD L, A                                 ; HL = sprite ptr
 197+ EB1E C9               RET
 198+ EB1F              .grpiHealth:
 199+ EB1F 21 DA F0         LD HL, HealthVariantPtrs
 200+ EB22 C3 EE F0         JP PickRandomVariantPtr
 201+ EB25              .grpiStamina:
 202+ EB25 21 E5 F0         LD HL, StaminaVariantPtrs
 203+ EB28 C3 EE F0         JP PickRandomVariantPtr
 204+ EB2B
 205+ EB2B              ; Scratch usado por GetRoulettePtrByIdx (vive en bank 7 con el body):
 206+ EB2B 00           .grpiCount: DEFB 0
 207+ EB2C 00 00        .grpiItems: DEFW 0
 208+ EB2E
 209+ EB2E              ; ==============================================================================
 210+ EB2E              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 211+ EB2E              ;                                 store los 4 attr bytes (TL,TR,BL,BR) del 2x2.
 212+ EB2E              ; ==============================================================================
 213+ EB2E              ; Antes guardaba solo attr[0] (TL) y PaintSynthPickupAttrs lo replicaba a las
 214+ EB2E              ; 4 celdas, perdiendo el patrón per-celda del BG editor (ej: col1 bright,
 215+ EB2E              ; col2 dim). Ahora extraemos los 4 → preservación 1:1.
 216+ EB2E              ; ==============================================================================
 217+ EB2E              LoadSynthSpriteAndExtractAttr:
 218+ EB2E 22 B6 5F         LD (RandomSynthPtr), HL
 219+ EB31 3E 03            LD A, 3
 220+ EB33 CD 60 6D         CALL LoadBgSpriteToBuffer_B7
 221+ EB36 DD 21 FA 86      LD IX, BgSpriteBuffer
 222+ EB3A CD 55 6C         CALL SkipPixelData_B7                      ; IX @ tintPaper
 223+ EB3D DD 23            INC IX                                  ; @ attr_h
 224+ EB3F DD 23            INC IX                                  ; @ attr_w
 225+ EB41 DD 23            INC IX                                  ; @ attr_data[0] = TL
 226+ EB43 DD 7E 00         LD A, (IX+0)
 227+ EB46 32 BB 5F         LD (RandomSynthAttr), A                 ; TL
 228+ EB49 DD 7E 01         LD A, (IX+1)
 229+ EB4C 32 E1 5F         LD (RandomSynthAttrTR), A
 230+ EB4F DD 7E 02         LD A, (IX+2)
 231+ EB52 32 E2 5F         LD (RandomSynthAttrBL), A
 232+ EB55 DD 7E 03         LD A, (IX+3)
 233+ EB58 32 E3 5F         LD (RandomSynthAttrBR), A
 234+ EB5B C9               RET
 235+ EB5C
 236+ EB5C              ; ==============================================================================
 237+ EB5C              ; AdvanceRouletteIdx / SkipCompassIfNeeded - INC con wrap mod ROULETTE_ORDER_LEN
 238+ EB5C              ; ==============================================================================
 239+ EB5C              ; Tras fase 5 (ruleta por categorias), el skip-compass vive en GetRoulettePtrByIdx
 240+ EB5C              ; (re-pica dentro de la cat si sale COMPASS + permanent). Aqui solo queda el
 241+ EB5C              ; INC + wrap. SkipCompassIfNeeded mantiene su nombre por compatibilidad con
 242+ EB5C              ; .urpDoRoulette init (caller).
 243+ EB5C              ;
 244+ EB5C              ; IN:  A = idx actual (0..ROULETTE_ORDER_LEN-1)
 245+ EB5C              ; OUT: A = idx avanzado (mod 6). Para SkipCompassIfNeeded: A sin cambios.
 246+ EB5C              ; Destruye: AF.
 247+ EB5C              ; ==============================================================================
 248+ EB5C              AdvanceRouletteIdx:
 249+ EB5C 3C               INC A
 250+ EB5D FE 06            CP ROULETTE_ORDER_LEN
 251+ EB5F D8               RET C
 252+ EB60 AF               XOR A
 253+ EB61 C9               RET
 254+ EB62              SkipCompassIfNeeded:
 255+ EB62                  ; No-op: el skip-compass vive en GetRoulettePtrByIdx (re-pick within cat).
 256+ EB62 C9               RET
 257+ EB63
 258+ EB63              ; ==============================================================================
 259+ EB63              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 260+ EB63              ; ==============================================================================
 261+ EB63              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 262+ EB63              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 263+ EB63              ; carga sprite nuevo, dibuja, repaint attrs.
 264+ EB63              ; ==============================================================================
 265+ EB63              UpdateRouletteBody:
 266+ EB63 3A BC 5F         LD A, (RouletteActive)
 267+ EB66 B7               OR A
 268+ EB67 C8               RET Z
 269+ EB68 3A B4 5F         LD A, (RandomSynthMapX)
 270+ EB6B FE FE            CP $FE
 271+ EB6D C8               RET Z                                   ; recogido / inactivo: no ciclar
 272+ EB6E
 273+ EB6E                  ; Tick frame counter
 274+ EB6E 21 BE 5F         LD HL, RouletteFrameCounter
 275+ EB71 35               DEC (HL)
 276+ EB72 C0               RET NZ                                  ; aun no toca avanzar
 277+ EB73
 278+ EB73                  ; --- Counter expirado: ciclar al siguiente tipo ---
 279+ EB73 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 280+ EB75 32 BE 5F         LD (RouletteFrameCounter), A
 281+ EB78
 282+ EB78                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 283+ EB78 2A B6 5F         LD HL, (RandomSynthPtr)
 284+ EB7B 3E 03            LD A, 3
 285+ EB7D CD 60 6D         CALL LoadBgSpriteToBuffer_B7
 286+ EB80 3A B8 5F         LD A, (RandomSynthCharX)
 287+ EB83 47               LD B, A
 288+ EB84 3A B9 5F         LD A, (RandomSynthCharY)
 289+ EB87 4F               LD C, A
 290+ EB88 DD 21 FA 86      LD IX, BgSpriteBuffer
 291+ EB8C CD 21 6D         CALL DrawBgSpriteXOR_B7
 292+ EB8F
 293+ EB8F                  ; Avanzar idx con wrap (AdvanceRouletteIdx skipea ROUL_COMPASS si la
 294+ EB8F                  ; brujula permanente esta activa — no se ve un solo frame de compass).
 295+ EB8F 3A BD 5F         LD A, (RouletteIdx)
 296+ EB92 CD 5C EB         CALL AdvanceRouletteIdx
 297+ EB95 32 BD 5F         LD (RouletteIdx), A
 298+ EB98
 299+ EB98                  ; Lookup nuevo tipo, cargar sprite, extraer attr
 300+ EB98 CD CF EA         CALL GetRoulettePtrByIdx                ; HL = nuevo ptr
 301+ EB9B CD 2E EB         CALL LoadSynthSpriteAndExtractAttr
 302+ EB9E
 303+ EB9E                  ; Dibujar sprite nuevo
 304+ EB9E 3A B8 5F         LD A, (RandomSynthCharX)
 305+ EBA1 47               LD B, A
 306+ EBA2 3A B9 5F         LD A, (RandomSynthCharY)
 307+ EBA5 4F               LD C, A
 308+ EBA6 DD 21 FA 86      LD IX, BgSpriteBuffer
 309+ EBAA CD 21 6D         CALL DrawBgSpriteXOR_B7
