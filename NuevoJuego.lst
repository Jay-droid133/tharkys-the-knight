 362+ 73FD              ; ==============================================================================
 363+ 73FD              ; ComputeMagicCompassPath - BFS reverse con state (sid, comp_local)
 364+ 73FD              ; ==============================================================================
 365+ 73FD              ; Algoritmo:
 366+ 73FD              ;   1. queue.push((target_sid, target_comp=0)). Mark visited.
 367+ 73FD              ;      target_comp = 0 (heurística: el pickup vive en la comp principal).
 368+ 73FD              ;   2. While queue not empty:
 369+ 73FD              ;        (R, R_comp) = queue.pop()
 370+ 73FD              ;        For each gap in RoomCompGaps[R]:
 371+ 73FD              ;          If gap.comp != R_comp: skip.
 372+ 73FD              ;          V = neighbor of R via gap.side.
 373+ 73FD              ;          Find V's gap with side=opposite(gap.side) AND coord=gap.coord.
 374+ 73FD              ;          V_comp = that gap's comp.
 375+ 73FD              ;          If (V, V_comp) visited: skip.
 376+ 73FD              ;          If V == current_sid AND V_comp == player_current_comp:
 377+ 73FD              ;            dir_player = opposite(gap.side); STORE; RETURN.
 378+ 73FD              ;          Mark visited; queue.push((V, V_comp)).
 379+ 73FD              ;
 380+ 73FD              ; player_current_comp se determina via LastEntrySide:
 381+ 73FD              ;   - LastEntrySide = side por el que el player entró a current_sid.
 382+ 73FD              ;   - player_comp = comp del gap de current_sid en LastEntrySide.
 383+ 73FD              ;   - Si LastEntrySide = $FF (boot/respawn), comp = 0 (fallback).
 384+ 73FD              ;
 385+ 73FD              ; OUT: MagicCompassPathDir = 0=N, 1=E, 2=S, 3=W; o $FF si sin path.
 386+ 73FD              ; ==============================================================================
 387+ 73FD              ; ComputeMagicCompassPath — wrapper que pagina bank 7 alrededor del BFS.
 388+ 73FD              ; Las tablas RoomCompGaps_XX viven en bank 7 (movidas para liberar slot 1
 389+ 73FD              ; del overflow). RoomCompGapsTable (pointer table) sigue en slot 1, pero
 390+ 73FD              ; sus valores son addresses en $C000+ que solo se dereferencian con bank 7
 391+ 73FD              ; paginado. El BFS body (renombrado a _Inner) solo llama a helpers .cmcp*
 392+ 73FD              ; (todos en slot 1) — ningun CALL externo a bank 0.
 393+ 73FD              ;
 394+ 73FD              ; Mantiene DI durante todo el chunk BFS (~4000 T = 1/15 frame). Riesgo de
 395+ 73FD              ; perder ~3 IRQ por segundo de compass activo, aceptable.
 396+ 73FD              ; ==============================================================================
 397+ 73FD              ComputeMagicCompassPath:
 398+ 73FD F3               DI
 399+ 73FE                  ; --- Page bank 7 in slot 3 ---
 400+ 73FE 3A 82 90         LD A, (CurrentPaging)
 401+ 7401 E6 F8            AND $F8
 402+ 7403 F6 07            OR 7
 403+ 7405 32 82 90         LD (CurrentPaging), A
 404+ 7408 01 FD 7F         LD BC, $7FFD
 405+ 740B ED 79            OUT (C), A
 406+ 740D
 407+ 740D CD 24 74         CALL _ComputeMagicCompassPath_Inner
 408+ 7410
 409+ 7410                  ; --- Page bank 0 back ---
 410+ 7410 3A 82 90         LD A, (CurrentPaging)
 411+ 7413 E6 F8            AND $F8
 412+ 7415 32 82 90         LD (CurrentPaging), A
 413+ 7418 01 FD 7F         LD BC, $7FFD
 414+ 741B ED 79            OUT (C), A
 415+ 741D
 416+ 741D 3A 9A 81         LD A, (StartupComplete)
 417+ 7420 B7               OR A
 418+ 7421 C8               RET Z                                ; aún en Inicio: dejar DI
 419+ 7422 FB               EI
 420+ 7423 C9               RET
