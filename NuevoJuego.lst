 110+ 62FF              ; ==============================================================================
 111+ 62FF              ; TownGateErasePlayer - XOR-erase del sprite del player en (OLDX, OLDY)
 112+ 62FF              ; ==============================================================================
 113+ 62FF              TownGateErasePlayer:
 114+ 62FF DD 21 A3 81      LD IX, EntityTable
 115+ 6303 DD E5            PUSH IX
 116+ 6305 CD 23 A5         CALL GetOldSpriteAddr
 117+ 6308 DD 56 0D         LD D, (IX+ENT_OLDY)
 118+ 630B DD 7E 0C         LD A, (IX+ENT_OLDX)
 119+ 630E 5F               LD E, A
 120+ 630F DD 2A AB A4      LD IX, (OldSprAddr)
 121+ 6313 CD EF 99         CALL DrawSprite
 122+ 6316 DD E1            POP IX
 123+ 6318 DD 56 0D         LD D, (IX+ENT_OLDY)
 124+ 631B DD 5E 0C         LD E, (IX+ENT_OLDX)
 125+ 631E CD 5D D3         CALL RestoreOldAttr
 126+ 6321 C9               RET
 127+ 6322
 128+ 6322              ; ==============================================================================
 129+ 6322              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 130+ 6322              ; ==============================================================================
 131+ 6322              TownGateAllNastiesDeadCheck:
 132+ 6322 DD 21 13 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 133+ 6326 06 03            LD B, NUM_NASTIES
 134+ 6328              .tgandcLoop:
 135+ 6328 DD 7E 01         LD A, (IX+ENT_TYPE)
 136+ 632B B7               OR A
 137+ 632C C0               RET NZ                              ; algun nasty aun activo
 138+ 632D 11 10 00         LD DE, ENT_SIZE
 139+ 6330 DD 19            ADD IX, DE
 140+ 6332 10 F4            DJNZ .tgandcLoop
 141+ 6334 AF               XOR A                               ; Z = todos TYPE_NONE
 142+ 6335 C9               RET
 143+ 6336
 144+ 6336              ; ==============================================================================
 145+ 6336              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 146+ 6336              ; ==============================================================================
 147+ 6336              ; Vive aqui porque TownGatePlayerSlideErase/Draw (slot 1) la llaman tras
 148+ 6336              ; paginar bank 6. Si BiClip viviera en bank 7, las Slide* no podrian llamarla
 149+ 6336              ; sin paginar bank 7 antes — sobrecarga innecesaria.
 150+ 6336              ;
 151+ 6336              ; Las constantes TGCS_ARCH_PX_TOP / BOTTOM las define town_gate_cutscene_bank7.asm.
 152+ 6336              ; Necesitan estar disponibles aqui. Para evitar duplicate EQU error, las
 153+ 6336              ; declaramos solo en el archivo bank 7 y dejamos que sjasmplus las resuelva
 154+ 6336              ; cross-file via include order.
 155+ 6336              ;
 156+ 6336              ; IN: D = Y, E = X (aligned a 8). IY = sprite ptr CON header. Bank 6 paginado.
 157+ 6336              ; ==============================================================================
 158+ 6336              TownGatePlayerXOR_BiClip:
 159+ 6336 FD 23            INC IY
 160+ 6338 FD 23            INC IY                              ; skip header
 161+ 633A D5               PUSH DE
 162+ 633B CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 163+ 633E D1               POP DE
 164+ 633F 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 165+ 6341 4A               LD C, D                             ; C = current pixel Y
 166+ 6342              .tgpxbcRow:
 167+ 6342 79               LD A, C
 168+ 6343 FE C0            CP 192
 169+ 6345 30 16            JR NC, .tgpxbcAdvance               ; off-screen
 170+ 6347 FE 78            CP TGCS_ARCH_PX_TOP
 171+ 6349 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 172+ 634B FE 98            CP TGCS_ARCH_PX_BOTTOM + 1
 173+ 634D 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 174+ 634F 18 0C            JR .tgpxbcAdvance                   ; in [120, 151] → skip
 175+ 6351              .tgpxbcDraw:
 176+ 6351 FD 7E 00         LD A, (IY+0)
 177+ 6354 AE               XOR (HL)
 178+ 6355 77               LD (HL), A
 179+ 6356 23               INC HL
 180+ 6357 FD 7E 01         LD A, (IY+1)
 181+ 635A AE               XOR (HL)
 182+ 635B 77               LD (HL), A
 183+ 635C 2B               DEC HL
 184+ 635D              .tgpxbcAdvance:
 185+ 635D FD 23            INC IY
 186+ 635F FD 23            INC IY
 187+ 6361 0C               INC C
 188+ 6362 C5               PUSH BC
 189+ 6363 CD CE 9A         CALL NextPixelLine
 190+ 6366 C1               POP BC
 191+ 6367 10 D9            DJNZ .tgpxbcRow
 192+ 6369 C9               RET
 193+ 636A
 194+ 636A              ; ==============================================================================
 195+ 636A              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 196+ 636A              ; ==============================================================================
 197+ 636A              ; Paginan slot 3 a bank 6 internamente para que TownGatePlayerXOR_BiClip
 198+ 636A              ; lea los pixels del player sprite. Llamadas por el body bank 7 via
 199+ 636A              ; TownGatePlayerSlideErase_B7 / SlideDraw_B7 thunks (que solo añaden el
 200+ 636A              ; post-wrap a bank 7).
 201+ 636A              ; ==============================================================================
 202+ 636A              TownGatePlayerSlideErase:
 203+ 636A DD 21 A3 81      LD IX, EntityTable
 204+ 636E DD E5            PUSH IX
 205+ 6370 CD 23 A5         CALL GetOldSpriteAddr               ; pages bank 6, restora bank 0
 206+ 6373 DD E1            POP IX
 207+ 6375 3A 8A 8D         LD A, (CurrentPaging)
 208+ 6378 E6 F8            AND $F8
 209+ 637A F6 06            OR 6
 210+ 637C 32 8A 8D         LD (CurrentPaging), A
 211+ 637F 01 FD 7F         LD BC, $7FFD
 212+ 6382 ED 79            OUT (C), A
 213+ 6384 FD 2A AB A4      LD IY, (OldSprAddr)
 214+ 6388 DD 56 0D         LD D, (IX+ENT_OLDY)
 215+ 638B DD 7E 0C         LD A, (IX+ENT_OLDX)
 216+ 638E 5F               LD E, A
 217+ 638F CD 36 63         CALL TownGatePlayerXOR_BiClip
 218+ 6392 3A 8A 8D         LD A, (CurrentPaging)
 219+ 6395 E6 F8            AND $F8
 220+ 6397 32 8A 8D         LD (CurrentPaging), A
 221+ 639A 01 FD 7F         LD BC, $7FFD
 222+ 639D ED 79            OUT (C), A
 223+ 639F C9               RET
 224+ 63A0
 225+ 63A0              TownGatePlayerSlideDraw:
 226+ 63A0 DD 21 A3 81      LD IX, EntityTable
 227+ 63A4 DD E5            PUSH IX
 228+ 63A6 CD F2 A4         CALL GetSpriteAddr
 229+ 63A9 DD E1            POP IX
 230+ 63AB 3A 8A 8D         LD A, (CurrentPaging)
 231+ 63AE E6 F8            AND $F8
 232+ 63B0 F6 06            OR 6
 233+ 63B2 32 8A 8D         LD (CurrentPaging), A
 234+ 63B5 01 FD 7F         LD BC, $7FFD
 235+ 63B8 ED 79            OUT (C), A
 236+ 63BA FD 2A 21 A5      LD IY, (SpriteAddrTemp)
 237+ 63BE 3A E4 82         LD A, (PlayerDrawY)
 238+ 63C1 57               LD D, A
 239+ 63C2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 240+ 63C5 5F               LD E, A
 241+ 63C6 CD 36 63         CALL TownGatePlayerXOR_BiClip
 242+ 63C9 3A 8A 8D         LD A, (CurrentPaging)
 243+ 63CC E6 F8            AND $F8
 244+ 63CE 32 8A 8D         LD (CurrentPaging), A
 245+ 63D1 01 FD 7F         LD BC, $7FFD
 246+ 63D4 ED 79            OUT (C), A
 247+ 63D6 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 248+ 63D9 DD 77 0C         LD (IX+ENT_OLDX), A
 249+ 63DC 3A E4 82         LD A, (PlayerDrawY)
 250+ 63DF DD 77 0D         LD (IX+ENT_OLDY), A
 251+ 63E2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 252+ 63E5 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 253+ 63E8 C9               RET
