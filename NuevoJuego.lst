 142+ F069 CD D2 F0         CALL ResolveObjectiveScreen
 143+ F06C 3E FF            LD A, $FF
 144+ F06E 32 C2 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 145+ F071 CD 6C 6F         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 146+ F074 CD 9C 6F         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 147+ F077              .cmtDone:
 148+ F077 F1               POP AF
 149+ F078 C1               POP BC
 150+ F079 D1               POP DE
 151+ F07A E1               POP HL
 152+ F07B C9               RET
 153+ F07C
 154+ F07C              ; ==============================================================================
 155+ F07C              ; CheckMilestoneDebugKey - Tecla H: skip de hito (debug). Siempre avanza.
 156+ F07C              ; ==============================================================================
 157+ F07C              CheckMilestoneDebugKey:
 158+ F07C 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 159+ F07E DB FE            IN A, ($FE)
 160+ F080 CB 67            BIT 4, A                            ; H = bit 4 (0 = pulsada)
 161+ F082 20 23            JR NZ, .cmdkNotPressed
 162+ F084 3A AC F0         LD A, (MilestoneKeyDebounce)
 163+ F087 B7               OR A
 164+ F088 C0               RET NZ
 165+ F089 3E 01            LD A, 1
 166+ F08B 32 AC F0         LD (MilestoneKeyDebounce), A
 167+ F08E 3A BF 82         LD A, (CurrentObjective)
 168+ F091 FE 0B            CP 11
 169+ F093 D0               RET NC
 170+ F094 3C               INC A
 171+ F095 32 BF 82         LD (CurrentObjective), A
 172+ F098 CD D2 F0         CALL ResolveObjectiveScreen
 173+ F09B 3E FF            LD A, $FF
 174+ F09D 32 C2 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 175+ F0A0 CD 6C 6F         CALL CancelMagicCompass             ; magic compass normal: cancela al saltar hito
 176+ F0A3 CD 9C 6F         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 177+ F0A6 C9               RET
 178+ F0A7              .cmdkNotPressed:
 179+ F0A7 AF               XOR A
 180+ F0A8 32 AC F0         LD (MilestoneKeyDebounce), A
 181+ F0AB C9               RET
 182+ F0AC
 183+ F0AC 00           MilestoneKeyDebounce: DEFB 0
 184+ F0AD
 185+ F0AD              ; ==============================================================================
 186+ F0AD              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->7->0 (debug)
 187+ F0AD              ; ==============================================================================
 188+ F0AD              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 189+ F0AD              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 190+ F0AD              ; inmediato del valor actual.
 191+ F0AD              ;
 192+ F0AD              ; Rango: 1..6 son keys clasicas (forest/ruins/cemetery/clock/church/towngate),
 193+ F0AD              ; 7 es BankCheck (cheque del banco, slot 7 en KeyLockTable). Util para
 194+ F0AD              ; probar el bump trigger del banco sin tener que completar M7 antes.
 195+ F0AD              ;
 196+ F0AD              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 197+ F0AD              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 198+ F0AD              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 199+ F0AD              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 200+ F0AD              ; ==============================================================================
 201+ F0AD              CheckCurrentKeyCycleKey:
 202+ F0AD 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 203+ F0AF DB FE            IN A, ($FE)
 204+ F0B1 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 205+ F0B3 20 17            JR NZ, .ckcNotPressed
 206+ F0B5 3A D1 F0         LD A, (CurrentKeyCycleDebounce)
 207+ F0B8 B7               OR A
 208+ F0B9 C0               RET NZ
 209+ F0BA 3E 01            LD A, 1
 210+ F0BC 32 D1 F0         LD (CurrentKeyCycleDebounce), A
 211+ F0BF 3A B6 82         LD A, (CurrentKey)
 212+ F0C2 3C               INC A
 213+ F0C3 FE 08            CP 8
 214+ F0C5 38 01            JR C, .ckcSet                       ; 1..7 dentro de rango (7 = BankCheck)
 215+ F0C7 AF               XOR A                               ; 8 -> wrap a 0
 216+ F0C8              .ckcSet:
 217+ F0C8 32 B6 82         LD (CurrentKey), A
 218+ F0CB C9               RET
 219+ F0CC              .ckcNotPressed:
 220+ F0CC AF               XOR A
 221+ F0CD 32 D1 F0         LD (CurrentKeyCycleDebounce), A
 222+ F0D0 C9               RET
 223+ F0D1
 224+ F0D1 00           CurrentKeyCycleDebounce: DEFB 0
 225+ F0D2
 226+ F0D2              ; ==============================================================================
 227+ F0D2              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ F0D2              ; ==============================================================================
 229+ F0D2              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ F0D2              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ F0D2              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ F0D2              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ F0D2              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ F0D2              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ F0D2              ;               actuales; queda como salvaguarda.
 236+ F0D2              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ F0D2              ; Destruye: AF, BC, DE, HL.
 238+ F0D2              ; ==============================================================================
 239+ F0D2              ResolveObjectiveScreen:
 240+ F0D2 3A BF 82         LD A, (CurrentObjective)
 241+ F0D5 FE 0B            CP 11
 242+ F0D7 30 4D            JR NC, .rosNoTarget
 243+ F0D9 87               ADD A, A
 244+ F0DA 6F               LD L, A
 245+ F0DB 26 00            LD H, 0
 246+ F0DD 11 F6 EF         LD DE, MilestoneResolveTable
 247+ F0E0 19               ADD HL, DE
 248+ F0E1 7E               LD A, (HL)                          ; tipo
 249+ F0E2 23               INC HL
 250+ F0E3 46               LD B, (HL)                          ; B = ref
 251+ F0E4 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ F0E6 28 06            JR Z, .rosPickup
 253+ F0E8 FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ F0EA 28 08            JR Z, .rosTrigger
 255+ F0EC 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ F0EE              .rosPickup:
 257+ F0EE 78               LD A, B
 258+ F0EF CD 2F F1         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ F0F2 18 10            JR .rosFindPos
 260+ F0F4              .rosTrigger:
 261+ F0F4 78               LD A, B
 262+ F0F5 FE 04            CP 4
 263+ F0F7 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ F0F9 FE 03            CP 3
 265+ F0FB 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ F0FD                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ F0FD                                                      ;  Necesario para que la lasting compass tras
 268+ F0FD                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ F0FD CD 3C F1         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ F100 7A               LD A, D
 271+ F101 B3               OR E
 272+ F102 28 22            JR Z, .rosNoTarget
 273+ F104              .rosFindPos:
 274+ F104 CD 57 F1         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ F107 78               LD A, B
 276+ F108 32 C0 82         LD (ObjectiveScreenX), A
 277+ F10B 79               LD A, C
 278+ F10C 32 C1 82         LD (ObjectiveScreenY), A
 279+ F10F C9               RET
 280+ F110              .rosBankRoom:
 281+ F110                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ F110                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ F110 3E 08            LD A, BCS_BANK_ROOM_X
 284+ F112 32 C0 82         LD (ObjectiveScreenX), A
 285+ F115 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ F117 32 C1 82         LD (ObjectiveScreenY), A
 287+ F11A C9               RET
 288+ F11B              .rosTownGateRoom:
 289+ F11B                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ F11B                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ F11B                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ F11B 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ F11D 32 C0 82         LD (ObjectiveScreenX), A
 294+ F120 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ F122 32 C1 82         LD (ObjectiveScreenY), A
 296+ F125 C9               RET
 297+ F126              .rosNoTarget:
 298+ F126 3E FF            LD A, $FF
 299+ F128 32 C0 82         LD (ObjectiveScreenX), A
 300+ F12B 32 C1 82         LD (ObjectiveScreenY), A
 301+ F12E C9               RET
 302+ F12F
 303+ F12F              ; ==============================================================================
 304+ F12F              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ F12F              ; ==============================================================================
 306+ F12F              ; IN:  A = key id (1..6)
 307+ F12F              ; OUT: DE = ptr
 308+ F12F              ; Destruye: AF, HL.
 309+ F12F              ; ==============================================================================
 310+ F12F              KeyIdToPtr:
 311+ F12F 3D               DEC A
 312+ F130 87               ADD A, A                            ; *2 (DEFW size)
 313+ F131 6F               LD L, A
 314+ F132 26 00            LD H, 0
 315+ F134 11 E2 D7         LD DE, KeyLockTable
 316+ F137 19               ADD HL, DE
 317+ F138 5E               LD E, (HL)
 318+ F139 23               INC HL
 319+ F13A 56               LD D, (HL)
 320+ F13B C9               RET
 321+ F13C
 322+ F13C              ; ==============================================================================
 323+ F13C              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ F13C              ; ==============================================================================
 325+ F13C              ; IN:  A = action id (1, 2, ...)
 326+ F13C              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ F13C              ;      Z flag set si no encontrado.
 328+ F13C              ; Destruye: AF, BC, HL.
 329+ F13C              ; ==============================================================================
 330+ F13C              ActionToTriggerPtr:
 331+ F13C 4F               LD C, A                             ; C = action id buscada
 332+ F13D 21 7A D8         LD HL, BumpTriggerTable
 333+ F140              .attLoop:
 334+ F140 5E               LD E, (HL)
 335+ F141 23               INC HL
 336+ F142 56               LD D, (HL)
 337+ F143 23               INC HL                              ; HL -> required_key
 338+ F144 7A               LD A, D
 339+ F145 B3               OR E
 340+ F146 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ F148 23               INC HL                              ; HL -> action
 342+ F149 7E               LD A, (HL)
 343+ F14A 23               INC HL                              ; HL -> next entry
 344+ F14B B9               CP C
 345+ F14C 20 F2            JR NZ, .attLoop
 346+ F14E F6 01            OR 1                                ; clear Z (encontrado)
 347+ F150 C9               RET
 348+ F151              .attNotFound:
 349+ F151 16 00            LD D, 0
 350+ F153 1E 00            LD E, 0
 351+ F155 AF               XOR A                               ; set Z
 352+ F156 C9               RET
 353+ F157
 354+ F157              ; ==============================================================================
 355+ F157              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ F157              ; ==============================================================================
 357+ F157              ; PickupTable layout (per-entry, 7 bytes):
 358+ F157              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ F157              ; Terminator: $FF (single byte).
 360+ F157              ;
 361+ F157              ; IN:  DE = ptr a buscar
 362+ F157              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ F157              ;      B = C = $FF si no encontrado (Z).
 364+ F157              ; Destruye: AF, HL. Preserva DE.
 365+ F157              ; ==============================================================================
 366+ F157              FindPickupScreen:
 367+ F157 21 96 E0         LD HL, PickupTable
 368+ F15A              .fpsLoop:
 369+ F15A 7E               LD A, (HL)
 370+ F15B FE FF            CP $FF
 371+ F15D 28 1C            JR Z, .fpsNotFound
 372+ F15F E5               PUSH HL
 373+ F160 23               INC HL                              ; -> mapY
 374+ F161 23               INC HL                              ; -> ptr_lo
 375+ F162 7E               LD A, (HL)
 376+ F163 BB               CP E
 377+ F164 20 0C            JR NZ, .fpsNoMatch
 378+ F166 23               INC HL                              ; -> ptr_hi
 379+ F167 7E               LD A, (HL)
 380+ F168 BA               CP D
 381+ F169 20 07            JR NZ, .fpsNoMatch
 382+ F16B E1               POP HL                              ; back to entry start (mapX)
 383+ F16C 46               LD B, (HL)                          ; B = mapX
 384+ F16D 23               INC HL
 385+ F16E 4E               LD C, (HL)                          ; C = mapY
 386+ F16F F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F171 C9               RET
 388+ F172              .fpsNoMatch:
 389+ F172 E1               POP HL
 390+ F173 C5               PUSH BC
 391+ F174 01 07 00         LD BC, 7
 392+ F177 09               ADD HL, BC
 393+ F178 C1               POP BC
 394+ F179 18 DF            JR .fpsLoop
 395+ F17B              .fpsNotFound:
 396+ F17B 06 FF            LD B, $FF
 397+ F17D 0E FF            LD C, $FF
 398+ F17F AF               XOR A                               ; set Z
 399+ F180 C9               RET
 400+ F181
 401+ F181              ; ==============================================================================
 402+ F181              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F181              ; ==============================================================================
 404+ F181              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F181              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F181              ; third). El brujula se redibuja solo cuando:
 407+ F181              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F181              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F181              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F181              ;
 411+ F181              ; Color (atributo de las 4 celdas):
 412+ F181              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F181              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F181              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F181              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F181              ;
 417+ F181              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F181              ; ==============================================================================
 419+ F181
 420+ F181              COMPASS_COL     EQU 24
 421+ F181              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F181
 423+ F181              ; ==============================================================================
 424+ F181              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F181              ; ==============================================================================
 426+ F181              ; Formato:
 427+ F181              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F181              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F181              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F181              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F181              ; ==============================================================================
 432+ F181              DrawMilestoneHUD:
 433+ F181 3A BF 82         LD A, (CurrentObjective)
 434+ F184 FE 0B            CP 11
 435+ F186 28 26            JR Z, .mhAllDone
 436+ F188 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F189 06 00            LD B, 0                     ; B = decenas
 438+ F18B              .mhDivLoop:
 439+ F18B FE 0A            CP 10
 440+ F18D 38 05            JR C, .mhDivDone
 441+ F18F D6 0A            SUB 10
 442+ F191 04               INC B
 443+ F192 18 F7            JR .mhDivLoop
 444+ F194              .mhDivDone:
 445+ F194 F5               PUSH AF                     ; A = unidades
 446+ F195 78               LD A, B
 447+ F196 B7               OR A
 448+ F197 20 04            JR NZ, .mhTensDigit
 449+ F199 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F19B 18 02            JR .mhWriteTens
 451+ F19D              .mhTensDigit:
 452+ F19D C6 30            ADD A, '0'
 453+ F19F              .mhWriteTens:
 454+ F19F 1E 1E            LD E, 30
 455+ F1A1 CD 87 E7         CALL DrawHudCharRow0
 456+ F1A4 F1               POP AF                      ; A = unidades
 457+ F1A5 C6 30            ADD A, '0'
 458+ F1A7 1E 1F            LD E, 31
 459+ F1A9 CD 87 E7         CALL DrawHudCharRow0
 460+ F1AC 18 0E            JR .mhAttrs
 461+ F1AE              .mhAllDone:
 462+ F1AE 3E 4F            LD A, 'O'
 463+ F1B0 1E 1E            LD E, 30
 464+ F1B2 CD 87 E7         CALL DrawHudCharRow0
 465+ F1B5 3E 4B            LD A, 'K'
 466+ F1B7 1E 1F            LD E, 31
 467+ F1B9 CD 87 E7         CALL DrawHudCharRow0
 468+ F1BC              .mhAttrs:
 469+ F1BC 3E 47            LD A, $47                   ; bright white
 470+ F1BE 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F1C1 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F1C4 C9               RET
 473+ F1C5
 474+ F1C5              ; ==============================================================================
 475+ F1C5              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F1C5              ; ==============================================================================
 477+ F1C5              DrawCompass:
 478+ F1C5                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F1C5 3A C0 82         LD A, (ObjectiveScreenX)
 480+ F1C8 FE FF            CP $FF
 481+ F1CA CA 81 F3         JP Z, ClearCompass
 482+ F1CD
 483+ F1CD                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F1CD                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F1CD                  ; reflejar la dir del path al cambiar de sala).
 486+ F1CD 3A 10 83         LD A, (CurrentScreenX)
 487+ F1D0 47               LD B, A
 488+ F1D1 3A C3 82         LD A, (LastCompassScreenX)
 489+ F1D4 B8               CP B
 490+ F1D5 C2 FB F1         JP NZ, .dcRedrawNewScreen
 491+ F1D8 3A 11 83         LD A, (CurrentScreenY)
 492+ F1DB 47               LD B, A
 493+ F1DC 3A C4 82         LD A, (LastCompassScreenY)
 494+ F1DF B8               CP B
 495+ F1E0 C2 FB F1         JP NZ, .dcRedrawNewScreen
 496+ F1E3 3A C2 82         LD A, (PreviousObjectiveDistance)
 497+ F1E6 FE FF            CP $FF
 498+ F1E8 28 16            JR Z, .dcRedraw
 499+ F1EA 3A C5 82         LD A, (CompassWobbleCounter)
 500+ F1ED B7               OR A
 501+ F1EE 20 10            JR NZ, .dcRedraw
 502+ F1F0                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F1F0                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F1F0 3A BF 5F         LD A, (MagicCompassTimer)
 505+ F1F3 47               LD B, A
 506+ F1F4 3A C0 5F         LD A, (MagicCompassTimer + 1)
 507+ F1F7 B0               OR B
 508+ F1F8 C8               RET Z                               ; sin cambios + sin wobble + sin magic
 509+ F1F9 18 05            JR .dcRedraw
 510+ F1FB
 511+ F1FB              .dcRedrawNewScreen:
 512+ F1FB                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 513+ F1FB                  ; sincronicamente en CheckScreenTransition.doTransition (via
 514+ F1FB                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 515+ F1FB                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 516+ F1FB                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 517+ F1FB                  ;
 518+ F1FB                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 519+ F1FB                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 520+ F1FB                  ; hay que volver a dibujar el sprite minimo una vez.
 521+ F1FB 3E FF            LD A, $FF
 522+ F1FD 32 CC 5F         LD (LastMagicCompassDrawn), A
 523+ F200                  ; fall through a .dcRedraw
 524+ F200
 525+ F200              .dcRedraw:
 526+ F200                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F200 3A C0 82         LD A, (ObjectiveScreenX)
 528+ F203 47               LD B, A
 529+ F204 3A 10 83         LD A, (CurrentScreenX)
 530+ F207 4F               LD C, A
 531+ F208 78               LD A, B
 532+ F209 91               SUB C                               ; A = dx (signed)
 533+ F20A                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F20A F2 14 F2         JP P, .dcDxNonNeg
 535+ F20D ED 44            NEG
 536+ F20F 67               LD H, A                             ; abs(dx)
 537+ F210 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F212 18 0A            JR .dcDxDone
 539+ F214              .dcDxNonNeg:
 540+ F214 67               LD H, A
 541+ F215 B7               OR A
 542+ F216 20 04            JR NZ, .dcDxPositive
 543+ F218 2E 01            LD L, 1                             ; dx == 0
 544+ F21A 18 02            JR .dcDxDone
 545+ F21C              .dcDxPositive:
 546+ F21C 2E 02            LD L, 2
 547+ F21E              .dcDxDone:
 548+ F21E E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F21F
 550+ F21F                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F21F 3A C1 82         LD A, (ObjectiveScreenY)
 552+ F222 47               LD B, A
 553+ F223 3A 11 83         LD A, (CurrentScreenY)
 554+ F226 4F               LD C, A
 555+ F227 78               LD A, B
 556+ F228 91               SUB C
 557+ F229 F2 33 F2         JP P, .dcDyNonNeg
 558+ F22C ED 44            NEG
 559+ F22E 67               LD H, A
 560+ F22F 2E 00            LD L, 0
 561+ F231 18 0A            JR .dcDyDone
 562+ F233              .dcDyNonNeg:
 563+ F233 67               LD H, A
 564+ F234 B7               OR A
 565+ F235 20 04            JR NZ, .dcDyPositive
 566+ F237 2E 01            LD L, 1
 567+ F239 18 02            JR .dcDyDone
 568+ F23B              .dcDyPositive:
 569+ F23B 2E 02            LD L, 2
 570+ F23D              .dcDyDone:
 571+ F23D                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 572+ F23D D1               POP DE                              ; D = abs_dx, E = signdx+1
 573+ F23E                  ; idx = (signdy+1)*3 + (signdx+1)
 574+ F23E 7D               LD A, L
 575+ F23F 87               ADD A, A
 576+ F240 85               ADD A, L                            ; A = (signdy+1)*3
 577+ F241 83               ADD A, E                            ; A = idx (0..8)
 578+ F242 32 4E F3         LD (.dcSpriteIdx), A
 579+ F245                  ; distance = abs_dx + abs_dy
 580+ F245 7A               LD A, D
 581+ F246 84               ADD A, H
 582+ F247 32 4F F3         LD (.dcDistance), A
 583+ F24A
 584+ F24A                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F24A                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F24A                  ; Sprite_Compass_Magic / Sprite_Compass_MagicLasting (no oscilan); el wobble
 587+ F24A                  ; logic solo gastaría CPU durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F24A                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F24A                  ; cuando el frame de transición está apretado.
 590+ F24A 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F24D 47               LD B, A
 592+ F24E 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F251 B0               OR B
 594+ F252 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F254 AF               XOR A
 596+ F255 32 C5 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F258 18 53            JR .dcWobbleEnd
 598+ F25A              .dcWobbleStartNormal:
 599+ F25A                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F25A                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F25A                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F25A                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F25A                  ; nuevo idx.
 604+ F25A                  ; Counter == 0 -> sin override, idx = target.
 605+ F25A 3A 4E F3         LD A, (.dcSpriteIdx)
 606+ F25D FE 04            CP 4
 607+ F25F 20 06            JR NZ, .dcWobbleNotX
 608+ F261                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F261                  ; frame no redibuje innecesariamente.
 610+ F261 AF               XOR A
 611+ F262 32 C5 82         LD (CompassWobbleCounter), A
 612+ F265 18 46            JR .dcWobbleEnd
 613+ F267              .dcWobbleNotX:
 614+ F267                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F267 3A 10 83         LD A, (CurrentScreenX)
 616+ F26A 47               LD B, A
 617+ F26B 3A C3 82         LD A, (LastCompassScreenX)
 618+ F26E B8               CP B
 619+ F26F 20 0A            JR NZ, .dcWobbleStart
 620+ F271 3A 11 83         LD A, (CurrentScreenY)
 621+ F274 47               LD B, A
 622+ F275 3A C4 82         LD A, (LastCompassScreenY)
 623+ F278 B8               CP B
 624+ F279 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F27B              .dcWobbleStart:
 626+ F27B 3E 09            LD A, 9
 627+ F27D 32 C5 82         LD (CompassWobbleCounter), A
 628+ F280              .dcWobbleResolve:
 629+ F280 3A C5 82         LD A, (CompassWobbleCounter)
 630+ F283 B7               OR A
 631+ F284 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F286 3D               DEC A
 633+ F287 32 C5 82         LD (CompassWobbleCounter), A
 634+ F28A                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F28A 21 BE F7         LD HL, WobblePhaseTable
 636+ F28D 5F               LD E, A
 637+ F28E 16 00            LD D, 0
 638+ F290 19               ADD HL, DE
 639+ F291 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F292 FE 02            CP 2
 641+ F294 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F296                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F296                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F296 FE 03            CP 3
 645+ F298 38 01            JR C, .dcWobbleOffsetReady
 646+ F29A 3D               DEC A
 647+ F29B              .dcWobbleOffsetReady:
 648+ F29B 5F               LD E, A
 649+ F29C 3A 4E F3         LD A, (.dcSpriteIdx)
 650+ F29F 87               ADD A, A                            ; idx*2
 651+ F2A0 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F2A1 83               ADD A, E                            ; +offset
 653+ F2A2 21 9A F7         LD HL, CompassWobbleTable
 654+ F2A5 5F               LD E, A
 655+ F2A6 16 00            LD D, 0
 656+ F2A8 19               ADD HL, DE
 657+ F2A9 7E               LD A, (HL)
 658+ F2AA 32 4E F3         LD (.dcSpriteIdx), A                ; override
 659+ F2AD
 660+ F2AD              .dcWobbleEnd:
 661+ F2AD
 662+ F2AD                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F2AD                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F2AD                  ; sin bright + char activo white bright; en warning el char activo
 665+ F2AD                  ; parpadea bright on/off a ~6 Hz).
 666+ F2AD                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F2AD                  ; blanca se mantiene tal cual.
 668+ F2AD 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F2B0 47               LD B, A
 670+ F2B1 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F2B4 B0               OR B
 672+ F2B5 28 3E            JR Z, .dcMagicOff
 673+ F2B7 3A 4E F3         LD A, (.dcSpriteIdx)
 674+ F2BA FE 04            CP 4
 675+ F2BC 28 37            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F2BE 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F2C1 FE FF            CP $FF
 678+ F2C3 28 30            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F2C5                  ; --- MAGIC HUD ---
 680+ F2C5                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F2C5                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F2C5                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F2C5                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F2C5                  ;
 685+ F2C5                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F2C5                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F2C5                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F2C5                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F2C5                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F2C5                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F2C5                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F2C5 3A CD 82         LD A, (MagicCompassPermanent)
 693+ F2C8 B7               OR A
 694+ F2C9 28 11            JR Z, .dcMagicTemp
 695+ F2CB                  ; --- Lasting (permanente, post-iglesia) ---
 696+ F2CB 3A C1 5F         LD A, (MagicCompassPathDir)
 697+ F2CE F6 80            OR $80                              ; bit 7 = 1 (lasting)
 698+ F2D0 47               LD B, A
 699+ F2D1 3A CC 5F         LD A, (LastMagicCompassDrawn)
 700+ F2D4 B8               CP B
 701+ F2D5 28 19            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 702+ F2D7 11 B4 70         LD DE, Sprite_Compass_MagicLasting
 703+ F2DA 18 0D            JR .dcMagicDraw
 704+ F2DC              .dcMagicTemp:
 705+ F2DC 3A C1 5F         LD A, (MagicCompassPathDir)         ; bit 7 ya 0 (PathDir 0..3)
 706+ F2DF 47               LD B, A
 707+ F2E0 3A CC 5F         LD A, (LastMagicCompassDrawn)
 708+ F2E3 B8               CP B
 709+ F2E4 28 0A            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 710+ F2E6 11 90 70         LD DE, Sprite_Compass_Magic
 711+ F2E9              .dcMagicDraw:
 712+ F2E9                  ; Almacenar cache key ANTES del CALL (DrawCompassSprite destruye B usándolo
 713+ F2E9                  ; como contador de filas). Semánticamente equivalente: el call no falla.
 714+ F2E9 78               LD A, B
 715+ F2EA 32 CC 5F         LD (LastMagicCompassDrawn), A
 716+ F2ED CD 51 F3         CALL DrawCompassSprite
 717+ F2F0              .dcMagicAttrsOnly:
 718+ F2F0 CD 49 70         CALL PaintMagicCompassAttrs
 719+ F2F3 18 40            JR .dcDrawDone
 720+ F2F5
 721+ F2F5              .dcMagicOff:
 722+ F2F5                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 723+ F2F5                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 724+ F2F5 3E FF            LD A, $FF
 725+ F2F7 32 CC 5F         LD (LastMagicCompassDrawn), A
 726+ F2FA
 727+ F2FA                  ; --- Color normal ---
 728+ F2FA                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 729+ F2FA 3A 4E F3         LD A, (.dcSpriteIdx)
 730+ F2FD FE 04            CP 4
 731+ F2FF 28 18            JR Z, .dcWhite
 732+ F301 3A C2 82         LD A, (PreviousObjectiveDistance)
 733+ F304 FE FF            CP $FF
 734+ F306 28 11            JR Z, .dcWhite
 735+ F308 47               LD B, A
 736+ F309 3A 4F F3         LD A, (.dcDistance)
 737+ F30C B8               CP B
 738+ F30D 28 0A            JR Z, .dcWhite                      ; igual = blanco
 739+ F30F 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 740+ F311 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 741+ F313 18 06            JR .dcColorDone
 742+ F315              .dcGreen:
 743+ F315 3E 44            LD A, GREEN | $40
 744+ F317 18 02            JR .dcColorDone
 745+ F319              .dcWhite:
 746+ F319 3E 47            LD A, WHITE | $40
 747+ F31B              .dcColorDone:
 748+ F31B 32 50 F3         LD (.dcAttr), A
 749+ F31E
 750+ F31E                  ; --- Sprite ptr de CompassSprites[idx] ---
 751+ F31E 3A 4E F3         LD A, (.dcSpriteIdx)
 752+ F321 87               ADD A, A                            ; *2
 753+ F322 6F               LD L, A
 754+ F323 26 00            LD H, 0
 755+ F325 11 88 F7         LD DE, CompassSprites
 756+ F328 19               ADD HL, DE
 757+ F329 5E               LD E, (HL)
 758+ F32A 23               INC HL
 759+ F32B 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 760+ F32C CD 51 F3         CALL DrawCompassSprite
 761+ F32F
 762+ F32F                  ; --- Attrs ---
 763+ F32F 3A 50 F3         LD A, (.dcAttr)
 764+ F332 CD 74 F3         CALL SetCompassAttrs
 765+ F335
 766+ F335              .dcDrawDone:
 767+ F335
 768+ F335                  ; --- Cachear estado ---
 769+ F335                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 770+ F335                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 771+ F335                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 772+ F335                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 773+ F335                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 774+ F335                  ; el wobble y la comparacion sigue siendo correcta.
 775+ F335 3A C5 82         LD A, (CompassWobbleCounter)
 776+ F338 B7               OR A
 777+ F339 20 06            JR NZ, .dcSkipPrevDistSave
 778+ F33B 3A 4F F3         LD A, (.dcDistance)
 779+ F33E 32 C2 82         LD (PreviousObjectiveDistance), A
 780+ F341              .dcSkipPrevDistSave:
 781+ F341 3A 10 83         LD A, (CurrentScreenX)
 782+ F344 32 C3 82         LD (LastCompassScreenX), A
 783+ F347 3A 11 83         LD A, (CurrentScreenY)
 784+ F34A 32 C4 82         LD (LastCompassScreenY), A
 785+ F34D C9               RET
 786+ F34E
 787+ F34E 00           .dcSpriteIdx: DEFB 0
 788+ F34F 00           .dcDistance:  DEFB 0
 789+ F350 00           .dcAttr:      DEFB 0
 790+ F351
 791+ F351              ; ==============================================================================
 792+ F351              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 793+ F351              ; ==============================================================================
 794+ F351              ; IN: DE = ptr a 16 filas x 2 bytes
 795+ F351              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 796+ F351              ; Destruye: AF, B, HL.
 797+ F351              ; ==============================================================================
 798+ F351              DrawCompassSprite:
 799+ F351                  ; Char row 0 (rows 0-7 del sprite)
 800+ F351 26 40            LD H, $40
 801+ F353 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 802+ F355 06 08            LD B, 8
 803+ F357              .dcsRow0:
 804+ F357 1A               LD A, (DE)
 805+ F358 77               LD (HL), A
 806+ F359 13               INC DE
 807+ F35A 23               INC HL
 808+ F35B 1A               LD A, (DE)
 809+ F35C 77               LD (HL), A
 810+ F35D 13               INC DE
 811+ F35E 2B               DEC HL
 812+ F35F 24               INC H
 813+ F360 10 F5            DJNZ .dcsRow0
 814+ F362                  ; Char row 1 (rows 8-15 del sprite)
 815+ F362 26 40            LD H, $40
 816+ F364 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F366 06 08            LD B, 8
 818+ F368              .dcsRow1:
 819+ F368 1A               LD A, (DE)
 820+ F369 77               LD (HL), A
 821+ F36A 13               INC DE
 822+ F36B 23               INC HL
 823+ F36C 1A               LD A, (DE)
 824+ F36D 77               LD (HL), A
 825+ F36E 13               INC DE
 826+ F36F 2B               DEC HL
 827+ F370 24               INC H
 828+ F371 10 F5            DJNZ .dcsRow1
 829+ F373 C9               RET
 830+ F374
 831+ F374              ; ==============================================================================
 832+ F374              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 833+ F374              ; ==============================================================================
 834+ F374              SetCompassAttrs:
 835+ F374 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 836+ F377 77               LD (HL), A
 837+ F378 23               INC HL
 838+ F379 77               LD (HL), A
 839+ F37A 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 840+ F37D 77               LD (HL), A
 841+ F37E 23               INC HL
 842+ F37F 77               LD (HL), A
 843+ F380 C9               RET
 844+ F381
 845+ F381              ; ==============================================================================
 846+ F381              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 847+ F381              ; ==============================================================================
 848+ F381              ClearCompass:
 849+ F381 26 40            LD H, $40
 850+ F383 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 851+ F385 06 08            LD B, 8
 852+ F387 AF               XOR A
 853+ F388              .ccRow0:
 854+ F388 77               LD (HL), A
 855+ F389 23               INC HL
 856+ F38A 77               LD (HL), A
 857+ F38B 2B               DEC HL
 858+ F38C 24               INC H
 859+ F38D 10 F9            DJNZ .ccRow0
 860+ F38F 26 40            LD H, $40
 861+ F391 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 862+ F393 06 08            LD B, 8
 863+ F395 AF               XOR A
 864+ F396              .ccRow1:
 865+ F396 77               LD (HL), A
 866+ F397 23               INC HL
 867+ F398 77               LD (HL), A
 868+ F399 2B               DEC HL
 869+ F39A 24               INC H
 870+ F39B 10 F9            DJNZ .ccRow1
 871+ F39D AF               XOR A                               ; attr 0 (negro/negro, invisible)
 872+ F39E 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 873+ F3A1 77               LD (HL), A
 874+ F3A2 23               INC HL
 875+ F3A3 77               LD (HL), A
 876+ F3A4 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 877+ F3A7 77               LD (HL), A
 878+ F3A8 23               INC HL
 879+ F3A9 77               LD (HL), A
 880+ F3AA C9               RET
 881+ F3AB
 882+ F3AB              ; ==============================================================================
 883+ F3AB              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 884+ F3AB              ; ==============================================================================
 885+ F3AB              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 886+ F3AB              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 887+ F3AB              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 888+ F3AB              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 889+ F3AB              ; monstruo cae alli con la puerta abierta:
 890+ F3AB              ;   - Bit slot en MonsterTrappedFlags
 891+ F3AB              ;   - Despawn del monstruo (puff)
 892+ F3AB              ;   - Puerta se re-cierra (sprite + flag)
 893+ F3AB              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 894+ F3AB              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 895+ F3AB              ;
 896+ F3AB              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 897+ F3AB              ; auto-generadas por el level editor segun la posicion de la puerta y los
 898+ F3AB              ; markers AltKey1/AltKey2.
 899+ F3AB              ; ==============================================================================
 900+ F3AB
 901+ F3AB              ; ==============================================================================
 902+ F3AB              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 903+ F3AB              ; ==============================================================================
 904+ F3AB              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 905+ F3AB              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 906+ F3AB              ; Destruye: AF, BC.
 907+ F3AB              ; ==============================================================================
 908+ F3AB              CheckChurchTrap:
 909+ F3AB                  ; --- Solo en pantalla de la iglesia ---
 910+ F3AB 3A 10 83         LD A, (CurrentScreenX)
 911+ F3AE FE 0F            CP CHURCH_TRAP_SCREEN_X
 912+ F3B0 20 5D            JR NZ, .cctNoTrap
 913+ F3B2 3A 11 83         LD A, (CurrentScreenY)
 914+ F3B5 FE 06            CP CHURCH_TRAP_SCREEN_Y
 915+ F3B7 20 56            JR NZ, .cctNoTrap
 916+ F3B9                  ; --- Solo con la puerta abierta ---
 917+ F3B9 3A B9 82         LD A, (ChurchDoorOpen)
 918+ F3BC B7               OR A
 919+ F3BD 28 50            JR Z, .cctNoTrap
 920+ F3BF                  ; --- Solo si el knockback es DIRECTO del player ---
 921+ F3BF                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 922+ F3BF                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 923+ F3BF                  ; espada y se clear cuando se hereda kb por colision.
 924+ F3BF DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 925+ F3C3 28 4A            JR Z, .cctNoTrap
 926+ F3C5                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 927+ F3C5                  ; (acepta sprites de 16, 21 o 24 px de alto)
 928+ F3C5 DD 7E 04         LD A, (IX+ENT_POSY)
 929+ F3C8 CB 3F            SRL A
 930+ F3CA CB 3F            SRL A
 931+ F3CC CB 3F            SRL A                                   ; A = top charY del monster
 932+ F3CE 47               LD B, A
 933+ F3CF 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 934+ F3D1 90               SUB B                                   ; A = trap_charY - mon_charY
 935+ F3D2 FE 03            CP 3
 936+ F3D4 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 937+ F3D6                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 938+ F3D6 DD 7E 03         LD A, (IX+ENT_POSX)
 939+ F3D9 CB 3F            SRL A
 940+ F3DB CB 3F            SRL A
 941+ F3DD CB 3F            SRL A
 942+ F3DF 47               LD B, A                                 ; B = left charX del monster
 943+ F3E0 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 944+ F3E2 3C               INC A                                   ; A = LO_X + 1
 945+ F3E3 90               SUB B                                   ; A = LO_X+1 - charX
 946+ F3E4 FE 03            CP 3
 947+ F3E6 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 948+ F3E8                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 949+ F3E8                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 950+ F3E8 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 951+ F3EB D6 4C            SUB SPRID_MONSTER_0
 952+ F3ED CB 3F            SRL A
 953+ F3EF CB 3F            SRL A
 954+ F3F1 CB 3F            SRL A                                   ; A = type idx 0..2
 955+ F3F3 47               LD B, A
 956+ F3F4                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 957+ F3F4 3A C7 82         LD A, (NextChurchTrapStep)
 958+ F3F7 FE 03            CP 3
 959+ F3F9 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 960+ F3FB 21 11 F4         LD HL, ChurchTrapOrderTable
 961+ F3FE 5F               LD E, A
 962+ F3FF 16 00            LD D, 0
 963+ F401 19               ADD HL, DE
 964+ F402 7E               LD A, (HL)                              ; A = type esperado
 965+ F403 B8               CP B
 966+ F404 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 967+ F406                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 968+ F406 CD A9 F4         CALL TriggerChurchTrap
 969+ F409 3E 01            LD A, 1
 970+ F40B C9               RET
 971+ F40C              .cctBlockAsWall:
 972+ F40C                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 973+ F40C                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 974+ F40C 3E 02            LD A, 2
 975+ F40E C9               RET
 976+ F40F              .cctNoTrap:
 977+ F40F AF               XOR A
 978+ F410 C9               RET
 979+ F411
 980+ F411              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 981+ F411              ChurchTrapOrderTable:
 982+ F411 00 02 01         DEFB 0, 2, 1
 983+ F414
 984+ F414              ; ==============================================================================
 985+ F414              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 986+ F414              ; blanco brillante sobre paper negro ($47).
 987+ F414              ; ==============================================================================
 988+ F414              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 989+ F414              ; - No-op fuera de la sala de la iglesia.
 990+ F414              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 991+ F414              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 992+ F414              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 993+ F414              ;   aun no toca) conservan sus attrs originales del sprite.
 994+ F414              ; Destruye: AF, BC, DE, HL.
 995+ F414              ; ==============================================================================
 996+ F414              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 997+ F414              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 998+ F414              HighlightExpectedStatue:
 999+ F414 3E 47            LD A, $47
1000+ F416 18 00            JR PaintExpectedStatueAttr
1001+ F418
1002+ F418              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
1003+ F418              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
1004+ F418              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
1005+ F418              PaintExpectedStatueAttr:
1006+ F418 32 82 F4         LD (.hesAttr), A
1007+ F41B                  ; --- Solo en la sala de la iglesia ---
1008+ F41B 3A 10 83         LD A, (CurrentScreenX)
1009+ F41E FE 0F            CP CHURCH_TRAP_SCREEN_X
1010+ F420 C0               RET NZ
1011+ F421 3A 11 83         LD A, (CurrentScreenY)
1012+ F424 FE 06            CP CHURCH_TRAP_SCREEN_Y
1013+ F426 C0               RET NZ
1014+ F427                  ; --- Solo tras abrir la iglesia 1a vez ---
1015+ F427                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
1016+ F427                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
1017+ F427                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
1018+ F427                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
1019+ F427                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
1020+ F427 3A BA 82         LD A, (ChurchEverOpened)
1021+ F42A B7               OR A
1022+ F42B C8               RET Z
1023+ F42C                  ; --- Solo si quedan monstruos por atrapar ---
1024+ F42C 3A C7 82         LD A, (NextChurchTrapStep)
1025+ F42F FE 03            CP 3
1026+ F431 D0               RET NC
1027+ F432                  ; --- Type esperado -> statue id ---
1028+ F432 21 11 F4         LD HL, ChurchTrapOrderTable
1029+ F435 5F               LD E, A
1030+ F436 16 00            LD D, 0
1031+ F438 19               ADD HL, DE
1032+ F439 7E               LD A, (HL)                              ; type idx esperado
1033+ F43A 21 B7 64         LD HL, StatueIdTable
1034+ F43D 5F               LD E, A
1035+ F43E 16 00            LD D, 0
1036+ F440 19               ADD HL, DE
1037+ F441 7E               LD A, (HL)                              ; A = statue id
1038+ F442 B7               OR A
1039+ F443 C8               RET Z
1040+ F444 32 83 F4         LD (.hesTargetId), A
1041+ F447                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1042+ F447 2A 12 83         LD HL, (CurrentScreenAddr)
1043+ F44A              .hesLoop:
1044+ F44A 7E               LD A, (HL)
1045+ F44B FE FF            CP $FF
1046+ F44D C8               RET Z                                   ; estatua no en esta sala
1047+ F44E 47               LD B, A
1048+ F44F 3A 83 F4         LD A, (.hesTargetId)
1049+ F452 B8               CP B
1050+ F453 28 06            JR Z, .hesFound
1051+ F455 11 04 00         LD DE, 4
1052+ F458 19               ADD HL, DE
1053+ F459 18 EF            JR .hesLoop
1054+ F45B              .hesFound:
1055+ F45B 23               INC HL
1056+ F45C 7E               LD A, (HL)                              ; charX
1057+ F45D 47               LD B, A
1058+ F45E 23               INC HL
1059+ F45F 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1060+ F460 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1061+ F462 4F               LD C, A                                 ; C = charY (post-HUD)
1062+ F463                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1063+ F463 26 00            LD H, 0
1064+ F465 69               LD L, C
1065+ F466 29               ADD HL, HL
1066+ F467 29               ADD HL, HL
1067+ F468 29               ADD HL, HL
1068+ F469 29               ADD HL, HL
1069+ F46A 29               ADD HL, HL                              ; HL = charY * 32
1070+ F46B 58               LD E, B
1071+ F46C 16 00            LD D, 0
1072+ F46E 19               ADD HL, DE                              ; + charX
1073+ F46F 11 00 58         LD DE, $5800
1074+ F472 19               ADD HL, DE                              ; HL = attr addr top-left
1075+ F473                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1076+ F473                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1077+ F473                  ; no hace falta sincronizar CleanAttrMap.
1078+ F473 3A 82 F4         LD A, (.hesAttr)
1079+ F476 06 03            LD B, 3                                 ; 3 filas de chars
1080+ F478              .hesRow:
1081+ F478 77               LD (HL), A
1082+ F479 23               INC HL
1083+ F47A 77               LD (HL), A                              ; (charX+1)
1084+ F47B 11 1F 00         LD DE, 31
1085+ F47E 19               ADD HL, DE                              ; siguiente fila col 0
1086+ F47F 10 F7            DJNZ .hesRow
1087+ F481 C9               RET
1088+ F482 00           .hesAttr:     DEFB 0
1089+ F483 00           .hesTargetId: DEFB 0
1090+ F484
1091+ F484              ; ==============================================================================
1092+ F484              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1093+ F484              ; ==============================================================================
1094+ F484              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1095+ F484              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1096+ F484              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1097+ F484              ; + ON final settle): 8 ciclos de ON-OFF en total.
1098+ F484              ; ==============================================================================
1099+ F484              STATUE_BLINK_FRAMES   EQU 32
1100+ F484
1101+ F484              StartStatueBlink:
1102+ F484                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1103+ F484                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1104+ F484                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1105+ F484                  ; (caso A), .cbtActChurchDoor (caso B).
1106+ F484 3E 20            LD A, STATUE_BLINK_FRAMES
1107+ F486 32 C8 82         LD (StatueBlinkCounter), A
1108+ F489 C3 14 F4         JP HighlightExpectedStatue              ; initial ON paint
1109+ F48C
1110+ F48C              UpdateStatueBlink:
1111+ F48C                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1112+ F48C 3A C8 82         LD A, (StatueBlinkCounter)
1113+ F48F B7               OR A
1114+ F490 C8               RET Z
1115+ F491 3D               DEC A
1116+ F492 32 C8 82         LD (StatueBlinkCounter), A
1117+ F495 20 03            JR NZ, .usbInProgress
1118+ F497                  ; Counter recien llego a 0: settle ON
1119+ F497 C3 14 F4         JP HighlightExpectedStatue
1120+ F49A              .usbInProgress:
1121+ F49A                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1122+ F49A                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1123+ F49A CB 3F            SRL A
1124+ F49C E6 01            AND $01
1125+ F49E 28 05            JR Z, .usbOff
1126+ F4A0 3E 47            LD A, $47
1127+ F4A2 C3 18 F4         JP PaintExpectedStatueAttr
1128+ F4A5              .usbOff:
1129+ F4A5 AF               XOR A
1130+ F4A6 C3 18 F4         JP PaintExpectedStatueAttr
1131+ F4A9
1132+ F4A9              ; ==============================================================================
1133+ F4A9              ; CUTSCENE - parametros ajustables
1134+ F4A9              ; ==============================================================================
1135+ F4A9              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1136+ F4A9              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1137+ F4A9              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1138+ F4A9              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1139+ F4A9
1140+ F4A9              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1141+ F4A9              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1142+ F4A9              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1143+ F4A9
1144+ F4A9              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1145+ F4A9              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1146+ F4A9              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1147+ F4A9              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1148+ F4A9              ;   tick 12 -> erase smoke[2], pasar a DONE
1149+ F4A9              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1150+ F4A9              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1151+ F4A9
1152+ F4A9              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1153+ F4A9              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1154+ F4A9              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1155+ F4A9              ; centrado dentro del vano de la puerta.
1156+ F4A9              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1157+ F4A9              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1158+ F4A9              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1159+ F4A9              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1160+ F4A9
1161+ F4A9              ; ==============================================================================
1162+ F4A9              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1163+ F4A9              ; ==============================================================================
1164+ F4A9              ; IN: IX = monster atrapado.
1165+ F4A9              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1166+ F4A9              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1167+ F4A9              ; en ApplyChurchTrapEffects al final del cutscene.
1168+ F4A9              ; ==============================================================================
1169+ F4A9              TriggerChurchTrap:
1170+ F4A9                  ; --- 1. Calcular slot 0..2 ---
1171+ F4A9 DD E5            PUSH IX
1172+ F4AB E1               POP HL
1173+ F4AC 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1174+ F4AF B7               OR A
1175+ F4B0 ED 52            SBC HL, DE
1176+ F4B2 CB 3D            SRL L
1177+ F4B4 CB 3D            SRL L
1178+ F4B6 CB 3D            SRL L
1179+ F4B8 CB 3D            SRL L                                   ; L = slot 0..2
1180+ F4BA 7D               LD A, L
1181+ F4BB 32 9E 5F         LD (ChurchCutsceneSlot), A
1182+ F4BE                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1183+ F4BE DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1184+ F4C1 D6 4C            SUB SPRID_MONSTER_0
1185+ F4C3 CB 3F            SRL A
1186+ F4C5 CB 3F            SRL A
1187+ F4C7 CB 3F            SRL A                                   ; A = type idx
1188+ F4C9 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1189+ F4CC                  ; --- 2. Mover monster al centro del vano ---
1190+ F4CC 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1191+ F4CE DD 77 03         LD (IX+ENT_POSX), A
1192+ F4D1 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1193+ F4D3 DD 77 04         LD (IX+ENT_POSY), A
1194+ F4D6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1195+ F4DA DD 36 07 00      LD (IX+ENT_DELTAY), 0
1196+ F4DE DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1197+ F4E2                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1198+ F4E2                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1199+ F4E2                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1200+ F4E2                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1201+ F4E2                  ; temblor se vea con ink blanco brillante sobre paper negro.
1202+ F4E2 AF               XOR A
1203+ F4E3 32 C8 82         LD (StatueBlinkCounter), A              ; parar blink
1204+ F4E6 DD E5            PUSH IX
1205+ F4E8 CD 14 F4         CALL HighlightExpectedStatue            ; pintar $47
1206+ F4EB                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1207+ F4EB                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1208+ F4EB                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1209+ F4EB                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1210+ F4EB CD 71 BB         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1211+ F4EE 3E FF            LD A, $FF
1212+ F4F0 CD C2 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1213+ F4F3                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1214+ F4F3                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1215+ F4F3                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1216+ F4F3 3A C7 82         LD A, (NextChurchTrapStep)
1217+ F4F6 FE 02            CP 2
1218+ F4F8 CC 3E FC         CALL Z, StopMonstersMusic
1219+ F4FB DD E1            POP IX
1220+ F4FD                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1221+ F4FD 3E 01            LD A, 1
1222+ F4FF 32 CE 82         LD (ChurchCutscenePhase), A
1223+ F502 AF               XOR A
1224+ F503 32 9D 5F         LD (ChurchCutsceneFrame), A
1225+ F506 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1226+ F508 32 A4 5F         LD (ChurchCutsceneLookCount), A
1227+ F50B C9               RET
1228+ F50C
1229+ F50C              ; ==============================================================================
1230+ F50C              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1231+ F50C              ; ==============================================================================
1232+ F50C              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1233+ F50C              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1234+ F50C              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1235+ F50C              ; ==============================================================================
1236+ F50C              UpdateChurchCutscene:
1237+ F50C 3A CE 82         LD A, (ChurchCutscenePhase)
1238+ F50F B7               OR A
1239+ F510 C8               RET Z
1240+ F511 3D               DEC A
1241+ F512 28 12            JR Z, .ucsLookPhase
1242+ F514 3D               DEC A
1243+ F515 28 38            JR Z, .ucsShakeStatuePhase
1244+ F517 3D               DEC A
1245+ F518 CA B0 F5         JP Z, .ucsSmokePhase
1246+ F51B                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1247+ F51B CD 0C 64         CALL ApplyChurchTrapDone
1248+ F51E AF               XOR A
1249+ F51F 32 CE 82         LD (ChurchCutscenePhase), A
1250+ F522 32 9D 5F         LD (ChurchCutsceneFrame), A
1251+ F525 C9               RET
1252+ F526
1253+ F526              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1254+ F526              .ucsLookPhase:
1255+ F526                  ; Frame counter (para detectar fin de fase)
1256+ F526 21 9D 5F         LD HL, ChurchCutsceneFrame
1257+ F529 34               INC (HL)
1258+ F52A                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1259+ F52A 21 A4 5F         LD HL, ChurchCutsceneLookCount
1260+ F52D 35               DEC (HL)
1261+ F52E 20 06            JR NZ, .ucsLookCheckEnd
1262+ F530 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1263+ F532 77               LD (HL), A
1264+ F533 CD FE F5         CALL ChurchCutsceneToggleMonsterDir
1265+ F536              .ucsLookCheckEnd:
1266+ F536 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1267+ F539 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1268+ F53B D8               RET C                                   ; sigue mirando
1269+ F53C                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1270+ F53C                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1271+ F53C                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1272+ F53C CD E8 63         CALL EraseChurchTrappedMonster
1273+ F53F CD AD 66         CALL CloseChurchDoor
1274+ F542 CD 23 F6         CALL ChurchCutsceneInitStatueShake
1275+ F545 3E 02            LD A, 2
1276+ F547 32 CE 82         LD (ChurchCutscenePhase), A
1277+ F54A AF               XOR A
1278+ F54B 32 9D 5F         LD (ChurchCutsceneFrame), A
1279+ F54E C9               RET
1280+ F54F
1281+ F54F              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1282+ F54F              .ucsShakeStatuePhase:
1283+ F54F 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1284+ F552 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1285+ F554 30 44            JR NC, .ucsShakeStatueDone
1286+ F556                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1287+ F556                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1288+ F556                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1289+ F556                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1290+ F556                  ;
1291+ F556                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1292+ F556                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1293+ F556 ED 5F            LD A, R
1294+ F558 E6 03            AND $03
1295+ F55A 21 96 F5         LD HL, .ucsShakeJitterTable
1296+ F55D 5F               LD E, A
1297+ F55E 16 00            LD D, 0
1298+ F560 19               ADD HL, DE
1299+ F561 7E               LD A, (HL)
1300+ F562 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1301+ F563                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1302+ F563 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1303+ F566 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1304+ F568 21 B7 64         LD HL, StatueIdTable
1305+ F56B 38 03            JR C, .ucsShakeTablePicked
1306+ F56D 21 BA 64         LD HL, StatueBrokenIdTable
1307+ F570              .ucsShakeTablePicked:
1308+ F570 78               LD A, B                                 ; restore jitter para la llamada
1309+ F571 CD 8D F6         CALL ChurchCutsceneShakeStatueByteShift
1310+ F574                  ; Border flicker blanco/negro cada frame (efecto "alarma"). Frame 0 es
1311+ F574                  ; especial: borde blanco + trueno bloqueante (el jugador ve el flash blanco
1312+ F574                  ; durante todo el SFX). Frames siguientes alternan normalmente.
1313+ F574 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1314+ F577 B7               OR A
1315+ F578 20 0C            JR NZ, .ucsShakeNormalBorder
1316+ F57A                  ; Frame 0: flash blanco + trueno
1317+ F57A 3E 07            LD A, WHITE
1318+ F57C D3 FE            OUT (254), A
1319+ F57E 21 12 FB         LD HL, SFX_Thunder
1320+ F581 CD 21 FA         CALL PlaySFX
1321+ F584 18 0B            JR .ucsShakeBorderDone
1322+ F586              .ucsShakeNormalBorder:
1323+ F586 E6 01            AND $01
1324+ F588 28 04            JR Z, .ucsShakeBorderBlack
1325+ F58A 3E 07            LD A, WHITE
1326+ F58C 18 01            JR .ucsShakeBorderOut
1327+ F58E              .ucsShakeBorderBlack:
1328+ F58E AF               XOR A                                   ; BLACK
1329+ F58F              .ucsShakeBorderOut:
1330+ F58F D3 FE            OUT (254), A
1331+ F591              .ucsShakeBorderDone:
1332+ F591 21 9D 5F         LD HL, ChurchCutsceneFrame
1333+ F594 34               INC (HL)
1334+ F595 C9               RET
1335+ F596              .ucsShakeJitterTable:
1336+ F596 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1337+ F59A              .ucsShakeStatueDone:
1338+ F59A                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1339+ F59A AF               XOR A
1340+ F59B D3 FE            OUT (254), A
1341+ F59D                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1342+ F59D                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1343+ F59D                  ; directo a 0 garantiza que no queden residuos.)
1344+ F59D CD F8 F6         CALL ChurchCutsceneEraseStatueDirect
1345+ F5A0 21 A0 FA         LD HL, SFX_EnemyDeath
1346+ F5A3 CD 21 FA         CALL PlaySFX
1347+ F5A6 3E 03            LD A, 3
1348+ F5A8 32 CE 82         LD (ChurchCutscenePhase), A
1349+ F5AB AF               XOR A
1350+ F5AC 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1351+ F5AF C9               RET
1352+ F5B0
1353+ F5B0              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1354+ F5B0              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1355+ F5B0              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1356+ F5B0              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1357+ F5B0              ; Entre transiciones, solo incrementa frame counter.
1358+ F5B0              .ucsSmokePhase:
1359+ F5B0 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1360+ F5B3 B7               OR A
1361+ F5B4 28 0E            JR Z, .ucsSmokeEntry
1362+ F5B6 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1363+ F5B8 28 16            JR Z, .ucsSmokeStep1
1364+ F5BA FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1365+ F5BC 28 1D            JR Z, .ucsSmokeStep2
1366+ F5BE FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1367+ F5C0 28 25            JR Z, .ucsSmokeEnd
1368+ F5C2 18 35            JR .ucsSmokeIncFrame
1369+ F5C4              .ucsSmokeEntry:
1370+ F5C4                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1371+ F5C4 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1372+ F5C7 CD E2 65         CALL DrawRemainsForType
1373+ F5CA                  ; Dibujar smoke[0] (XOR)
1374+ F5CA AF               XOR A
1375+ F5CB CD 2D 65         CALL DrawSmokeFrameXor
1376+ F5CE 18 29            JR .ucsSmokeIncFrame
1377+ F5D0              .ucsSmokeStep1:
1378+ F5D0 AF               XOR A
1379+ F5D1 CD 2D 65         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1380+ F5D4 3E 01            LD A, 1
1381+ F5D6 CD 2D 65         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1382+ F5D9 18 1E            JR .ucsSmokeIncFrame
