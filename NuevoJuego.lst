  31+ 0000              ; --- Rutinas de la ROM ---
  32+ 0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
  33+ 0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
  34+ 0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
