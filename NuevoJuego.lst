 280+ E530 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 281+ E533
 282+ E533              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 283+ E533              DrawNoclipHUD:
 284+ E533 3A B5 82         LD A, (NoclipMode)
