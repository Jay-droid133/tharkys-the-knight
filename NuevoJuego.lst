  98  69DA
  99  69DA                  ; --- Rutinas de paginacion (paging.asm) ---
 100  69DA                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 101  69DA                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 102  69DA                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 103  69DA                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 104  69DA                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 105  69DA                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 106  69DA                  ; criterio (siempre visible) pero contended.
 107  69DA                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 108  69DA                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 109  69DA                  ; el inner loop, asi que el overhead es invisible.
 110  69DA                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 69DA              ; ==============================================================================
   2+ 69DA              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 69DA              ; ==============================================================================
   4+ 69DA              ; Port $7FFD (write-only):
   5+ 69DA              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 69DA              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 69DA              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 69DA              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 69DA              ;
  10+ 69DA              ; Bancos disponibles:
  11+ 69DA              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 69DA              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 69DA              ;   Bank 1: libre para datos nuevos (contended)
  14+ 69DA              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 69DA              ;   Bank 3: libre para datos nuevos (contended)
  16+ 69DA              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 69DA              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 69DA              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 69DA              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 69DA              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 69DA              ; ==============================================================================
  22+ 69DA
  23+ 69DA              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 69DA              ; para no machacarse a si mismas al cambiar de banco.
  25+ 69DA
  26+ 69DA              ; ==============================================================================
  27+ 69DA              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 69DA              ; ==============================================================================
  29+ 69DA              ; Entrada: A = banco (0-7)
  30+ 69DA              ; Preserva: HL, DE, IX, IY
  31+ 69DA              ; Destruye: A, BC
  32+ 69DA              ; ==============================================================================
  33+ 69DA              PageBankSlot3:
  34+ 69DA E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 69DC 47               LD B, A                     ; guardar banco nuevo
  36+ 69DD 3A C9 90         LD A, (CurrentPaging)
  37+ 69E0 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 69E2 B0               OR B                        ; poner nuevo banco
  39+ 69E3 32 C9 90         LD (CurrentPaging), A
  40+ 69E6 01 FD 7F         LD BC, $7FFD
  41+ 69E9 ED 79            OUT (C), A
  42+ 69EB C9               RET
  43+ 69EC
  44+ 69EC              ; ==============================================================================
  45+ 69EC              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 69EC              ; ==============================================================================
  47+ 69EC              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 69EC              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 69EC              ; ==============================================================================
  50+ 69EC              InitPaging:
  51+ 69EC 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 69EE 32 C9 90         LD (CurrentPaging), A
  53+ 69F1 01 FD 7F         LD BC, $7FFD
  54+ 69F4 ED 79            OUT (C), A
  55+ 69F6 C9               RET
  56+ 69F7
  57+ 69F7              ; ==============================================================================
  58+ 69F7              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 69F7              ; ==============================================================================
  60+ 69F7              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 69F7              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 69F7              ;      Paginacion restaurada a bank 0.
  63+ 69F7              ; Destruye: A, BC, DE, HL
  64+ 69F7              ;
  65+ 69F7              ; Formato del room en FUENTE (variable-length):
  66+ 69F7              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 69F7              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 69F7              ;   terminador:                  DEFB $FF
  69+ 69F7              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 69F7              ;
  71+ 69F7              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 69F7              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 69F7              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 69F7              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 69F7              ; ==============================================================================
  76+ 69F7              LoadRoomToBuffer:
  77+ 69F7                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 69F7                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 69F7                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 69F7                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 69F7                  ;
  82+ 69F7                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 69F7                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 69F7                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 69F7                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 69F7 F3               DI
  87+ 69F8                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 69F8 3A C9 90         LD A, (CurrentPaging)
  89+ 69FB E6 F8            AND $F8
  90+ 69FD F6 01            OR 1
  91+ 69FF 32 C9 90         LD (CurrentPaging), A
  92+ 6A02 01 FD 7F         LD BC, $7FFD
  93+ 6A05 ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 6A07                  ; --- Copy + decompress loop ---
  95+ 6A07                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 6A07                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 6A07 11 7C 85         LD DE, CurrentScreenBuffer
  98+ 6A0A              .lrbLoop:
  99+ 6A0A 7E               LD A, (HL)                      ; id
 100+ 6A0B 12               LD (DE), A
 101+ 6A0C 23               INC HL
 102+ 6A0D 13               INC DE
 103+ 6A0E FE FF            CP $FF                          ; terminador?
 104+ 6A10 28 1B            JR Z, .lrbDone
 105+ 6A12                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 6A12                  ; al buffer escribimos x limpio (AND $7F).
 107+ 6A12 7E               LD A, (HL)
 108+ 6A13 23               INC HL
 109+ 6A14 47               LD B, A                         ; B = x raw (con flag)
 110+ 6A15 E6 7F            AND $7F
 111+ 6A17 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 6A18 13               INC DE
 113+ 6A19                  ; Copiar y
 114+ 6A19 7E               LD A, (HL)
 115+ 6A1A 12               LD (DE), A
 116+ 6A1B 23               INC HL
 117+ 6A1C 13               INC DE
 118+ 6A1D                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 6A1D CB 78            BIT 7, B
 120+ 6A1F 28 06            JR Z, .lrbNoTint
 121+ 6A21 7E               LD A, (HL)                      ; v desde source
 122+ 6A22 23               INC HL
 123+ 6A23 12               LD (DE), A
 124+ 6A24 13               INC DE
 125+ 6A25 18 E3            JR .lrbLoop
 126+ 6A27              .lrbNoTint:
 127+ 6A27 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 6A29 12               LD (DE), A
 129+ 6A2A 13               INC DE
 130+ 6A2B 18 DD            JR .lrbLoop
 131+ 6A2D              .lrbDone:
 132+ 6A2D                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 6A2D 3A C9 90         LD A, (CurrentPaging)
 134+ 6A30 E6 F8            AND $F8                         ; bank 0
 135+ 6A32 32 C9 90         LD (CurrentPaging), A
 136+ 6A35 01 FD 7F         LD BC, $7FFD
 137+ 6A38 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
