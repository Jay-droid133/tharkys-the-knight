 357+ 9B45              ; ==============================================================================
 358+ 9B45              SaveEntityAttr:
 359+ 9B45                  ; Paging inline (ver nota en DrawSprite)
 360+ 9B45 3A 82 8D         LD A, (CurrentPaging)
 361+ 9B48 E6 F8            AND $F8
 362+ 9B4A F6 06            OR 6
 363+ 9B4C 32 82 8D         LD (CurrentPaging), A
 364+ 9B4F 01 FD 7F         LD BC, $7FFD
 365+ 9B52 ED 79            OUT (C), A
 366+ 9B54 CD 65 9B         CALL _SaveEntityAttrImpl
 367+ 9B57 3A 82 8D         LD A, (CurrentPaging)
 368+ 9B5A E6 F8            AND $F8
 369+ 9B5C 32 82 8D         LD (CurrentPaging), A
 370+ 9B5F 01 FD 7F         LD BC, $7FFD
 371+ 9B62 ED 79            OUT (C), A
 372+ 9B64 C9               RET
 373+ 9B65
 374+ 9B65              _SaveEntityAttrImpl:
 375+ 9B65                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B65 DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B68 47               LD B, A
 378+ 9B69 7B               LD A, E                     ; X pixel (raw)
 379+ 9B6A E6 07            AND 7
 380+ 9B6C 28 01            JR Z, .noExtraW
 381+ 9B6E 04               INC B                       ; +1 columna si no alineado
 382+ 9B6F              .noExtraW:
 383+ 9B6F 78               LD A, B
 384+ 9B70 32 D5 9B         LD (EntityAttrW), A
 385+ 9B73
 386+ 9B73                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B73 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B74 E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B76 4F               LD C, A
 390+ 9B77 DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9B7A 81               ADD A, C                    ; + Y offset
 392+ 9B7B C6 07            ADD A, 7
 393+ 9B7D 0F               RRCA
 394+ 9B7E 0F               RRCA
 395+ 9B7F 0F               RRCA
 396+ 9B80 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9B82 32 D6 9B         LD (EntityAttrH), A
 398+ 9B85
 399+ 9B85 CD 3F 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9B88 11 C5 9B         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9B8B
 402+ 9B8B 3A D6 9B         LD A, (EntityAttrH)
 403+ 9B8E 4F               LD C, A                     ; C = filas
 404+ 9B8F              .saveRow:
 405+ 9B8F 3A D5 9B         LD A, (EntityAttrW)
 406+ 9B92 47               LD B, A                     ; B = columnas
 407+ 9B93 E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9B94              .saveCol:
 409+ 9B94 7E               LD A, (HL)
 410+ 9B95 12               LD (DE), A
 411+ 9B96 23               INC HL
 412+ 9B97 13               INC DE
 413+ 9B98 10 FA            DJNZ .saveCol
 414+ 9B9A E1               POP HL
 415+ 9B9B                  ; Siguiente fila attr: HL += 32
 416+ 9B9B D5               PUSH DE
 417+ 9B9C 11 20 00         LD DE, 32
 418+ 9B9F 19               ADD HL, DE
 419+ 9BA0 D1               POP DE
 420+ 9BA1 0D               DEC C
 421+ 9BA2 20 EB            JR NZ, .saveRow
 422+ 9BA4 C9               RET
