 359+ 657A              .cshLoop:
 360+ 657A BE               CP (HL)
 361+ 657B 28 06            JR Z, .cshMatch
 362+ 657D 23               INC HL
 363+ 657E 0C               INC C
 364+ 657F 10 F9            DJNZ .cshLoop
 365+ 6581 AF               XOR A                                   ; not statue -> Z (visible)
 366+ 6582 C9               RET
 367+ 6583              .cshMatch:
 368+ 6583                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 369+ 6583 79               LD A, C
 370+ 6584 32 B9 64         LD (LastHiddenStatueType), A            ; expose type para el caller
 371+ 6587 21 AD 64         LD HL, ChurchTrapBitMask
 372+ 658A 5F               LD E, A
 373+ 658B 16 00            LD D, 0
 374+ 658D 19               ADD HL, DE
 375+ 658E 7E               LD A, (HL)                              ; bit mask
 376+ 658F 21 C6 82         LD HL, MonsterTrappedFlags
 377+ 6592 A6               AND (HL)
 378+ 6593 C9               RET                                     ; NZ si bit set (hidden), Z si no
