  51+ F055 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ F057 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
