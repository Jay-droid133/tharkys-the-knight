 356  9BBD                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 357  9BBD                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 358  9BBD                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9BBD              ; ==============================================================================
   2+ 9BBD              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9BBD              ; ==============================================================================
   4+ 9BBD              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9BBD              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9BBD              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9BBD              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9BBD              ;
   9+ 9BBD              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9BBD              ; fallo en el intento previo):
  11+ 9BBD              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9BBD              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9BBD              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9BBD              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9BBD              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9BBD              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9BBD              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9BBD              ;
  19+ 9BBD              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9BBD              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9BBD              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9BBD              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9BBD              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9BBD              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9BBD              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9BBD              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9BBD              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9BBD              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9BBD              ; ==============================================================================
  30+ 9BBD
  31+ 9BBD              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9BBD              AY_Init:
  33+ 9BBD F3               DI
  34+ 9BBE 3A E7 90         LD A, (CurrentPaging)
  35+ 9BC1 E6 F8            AND $F8
  36+ 9BC3 F6 04            OR 4
  37+ 9BC5 32 E7 90         LD (CurrentPaging), A
  38+ 9BC8 01 FD 7F         LD BC, $7FFD
  39+ 9BCB ED 79            OUT (C), A
  40+ 9BCD CD 7E E4         CALL AY_InitImpl
  41+ 9BD0 3A E7 90         LD A, (CurrentPaging)
  42+ 9BD3 E6 F8            AND $F8
  43+ 9BD5 32 E7 90         LD (CurrentPaging), A
  44+ 9BD8 01 FD 7F         LD BC, $7FFD
  45+ 9BDB ED 79            OUT (C), A
  46+ 9BDD 3A 4A 81         LD A, (StartupComplete)
  47+ 9BE0 B7               OR A
  48+ 9BE1 C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9BE2 FB               EI
  50+ 9BE3 C9               RET
  51+ 9BE4
