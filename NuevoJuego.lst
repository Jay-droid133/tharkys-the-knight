 293+ EC7C                  ; Atributos de la esfera (filas 0-1, cols 15-16)
 294+ EC7C 3E 47            LD A, $47              ; col 15: bright white
 295+ EC7E 32 0F 58         LD ($580F), A
 296+ EC81 32 2F 58         LD ($582F), A
 297+ EC84 3E 07            LD A, $07              ; col 16: white
 298+ EC86 32 10 58         LD ($5810), A
