 733+ D409 DD 23            INC IX
 734+ D40B DD 23            INC IX                      ; IX -> pixel data
 735+ D40D
 736+ D40D                  ; Calcular dir VRAM inicio: x_pixel = x_char*8, y_pixel = y_char*8
 737+ D40D 79               LD A, C
 738+ D40E 07               RLCA
 739+ D40F 07               RLCA
 740+ D410 07               RLCA
 741+ D411 57               LD D, A                     ; D = y_pixel
 742+ D412 78               LD A, B
 743+ D413 07               RLCA
 744+ D414 07               RLCA
 745+ D415 07               RLCA
