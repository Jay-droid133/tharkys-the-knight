 648+ 70D7 23               INC HL
 649+ 70D8 71               LD (HL), C                          ; fila 0
 650+ 70D9 7D               LD A, L
 651+ 70DA C6 1F            ADD A, 31                           ; +32 a fila siguiente, -1 (al col 0)
 652+ 70DC 6F               LD L, A
 653+ 70DD 30 01            JR NC, .pspaNoCarry2
 654+ 70DF 24               INC H
