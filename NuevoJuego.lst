 647+ F373              ; ==============================================================================
 648+ F373              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 649+ F373              ; ==============================================================================
 650+ F373              ; IN: DE = ptr a 16 filas x 2 bytes
 651+ F373              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 652+ F373              ; Destruye: AF, B, HL.
 653+ F373              ; ==============================================================================
 654+ F373              DrawCompassSprite:
 655+ F373                  ; Char row 0 (rows 0-7 del sprite)
 656+ F373 26 40            LD H, $40
 657+ F375 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 658+ F377 06 08            LD B, 8
 659+ F379              .dcsRow0:
 660+ F379 1A               LD A, (DE)
 661+ F37A 77               LD (HL), A
 662+ F37B 13               INC DE
 663+ F37C 23               INC HL
 664+ F37D 1A               LD A, (DE)
 665+ F37E 77               LD (HL), A
 666+ F37F 13               INC DE
 667+ F380 2B               DEC HL
 668+ F381 24               INC H
 669+ F382 10 F5            DJNZ .dcsRow0
 670+ F384                  ; Char row 1 (rows 8-15 del sprite)
 671+ F384 26 40            LD H, $40
 672+ F386 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 673+ F388 06 08            LD B, 8
 674+ F38A              .dcsRow1:
 675+ F38A 1A               LD A, (DE)
 676+ F38B 77               LD (HL), A
 677+ F38C 13               INC DE
 678+ F38D 23               INC HL
 679+ F38E 1A               LD A, (DE)
 680+ F38F 77               LD (HL), A
 681+ F390 13               INC DE
 682+ F391 2B               DEC HL
 683+ F392 24               INC H
 684+ F393 10 F5            DJNZ .dcsRow1
 685+ F395 C9               RET
 686+ F396
 687+ F396              ; ==============================================================================
 688+ F396              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 689+ F396              ; ==============================================================================
 690+ F396              SetCompassAttrs:
 691+ F396 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 692+ F399 77               LD (HL), A
 693+ F39A 23               INC HL
 694+ F39B 77               LD (HL), A
 695+ F39C 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 696+ F39F 77               LD (HL), A
 697+ F3A0 23               INC HL
 698+ F3A1 77               LD (HL), A
 699+ F3A2 C9               RET
