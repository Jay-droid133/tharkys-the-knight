 761+ E768              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 762+ E768              ; A = codigo ASCII, E = columna (0-31)
 763+ E768              DrawHudChar:
 764+ E768                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 765+ E768 6F               LD L, A
 766+ E769 26 00            LD H, 0
 767+ E76B 29               ADD HL, HL
 768+ E76C 29               ADD HL, HL
 769+ E76D 29               ADD HL, HL
 770+ E76E 01 00 3C         LD BC, $3C00
 771+ E771 09               ADD HL, BC                  ; HL = font data
 772+ E772
 773+ E772                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E772 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E774 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E776 83               ADD A, E
 777+ E777 5F               LD E, A                     ; DE = dir VRAM
 778+ E778
 779+ E778 06 08            LD B, 8
 780+ E77A              .hudCharLoop:
 781+ E77A 7E               LD A, (HL)
 782+ E77B 12               LD (DE), A
 783+ E77C 23               INC HL
 784+ E77D 14               INC D                       ; Siguiente scan line
 785+ E77E 10 FA            DJNZ .hudCharLoop
 786+ E780 C9               RET
