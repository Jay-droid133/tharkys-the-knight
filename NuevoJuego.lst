 158  6A9E                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 159  6A9E                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 160  6A9E                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6A9E              ; ==============================================================================
   2+ 6A9E              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6A9E              ; ==============================================================================
   4+ 6A9E              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6A9E              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6A9E              ;
   7+ 6A9E              ; Diseño beeper-style:
   8+ 6A9E              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6A9E              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6A9E              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6A9E              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6A9E              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6A9E              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6A9E              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6A9E              ;     hits clasicos en 48K).
  16+ 6A9E              ;   - AY_UpdatePlayerHit se llama cada 2 IRQs (= 25 Hz) desde el handler IM 2
  17+ 6A9E              ;     en music_irq.asm (cold path: salta en RET Z si no hay sweep activo).
  18+ 6A9E              ;     Tickear desde IRQ inmuniza la duracion del beep frente a la latencia
  19+ 6A9E              ;     de MainLoop (transiciones lentas estiraban el beep antes).
  20+ 6A9E              ;
  21+ 6A9E              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  22+ 6A9E              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  23+ 6A9E              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  24+ 6A9E              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  25+ 6A9E              ;
  26+ 6A9E              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  27+ 6A9E              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  28+ 6A9E              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  29+ 6A9E              ;
  30+ 6A9E              ; Llamado desde:
  31+ 6A9E              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  32+ 6A9E              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  33+ 6A9E              ;   - MainLoop cada frame — update.
  34+ 6A9E              ; ==============================================================================
  35+ 6A9E
  36+ 6A9E              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  37+ 6A9E 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  38+ 6A9F 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  39+ 6AA1 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  40+ 6AA3 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  41+ 6AA4                                                ; (0 = inactivo o ya muteado)
  42+ 6AA4
  43+ 6AA4              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  44+ 6AA4              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  45+ 6AA4              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  46+ 6AA4              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  47+ 6AA4
  48+ 6AA4              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  49+ 6AA4              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  50+ 6AA4              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  51+ 6AA4              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  52+ 6AA4
  53+ 6AA4              ; ==============================================================================
  54+ 6AA4              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  55+ 6AA4              ; ==============================================================================
  56+ 6AA4              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  57+ 6AA4              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  58+ 6AA4              ; tabla los hardcodea.
  59+ 6AA4              ; ==============================================================================
  60+ 6AA4              AY_PlayPlayerHit:
  61+ 6AA4 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  62+ 6AA7 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  63+ 6AA9 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  64+ 6AAC 18 08            JR _AY_PlaySweep
  65+ 6AAE
  66+ 6AAE              AY_PlayPlayerDeath:
  67+ 6AAE 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  68+ 6AB1 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  69+ 6AB3 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  70+ 6AB6                  ; fall through
  71+ 6AB6
  72+ 6AB6              ; IN: HL=period inicial, B=frames, DE=delta.
  73+ 6AB6              _AY_PlaySweep:
  74+ 6AB6 22 9F 6A         LD (PlayerHitPeriod), HL
  75+ 6AB9 ED 53 A1 6A      LD (PlayerHitDelta), DE
  76+ 6ABD 78               LD A, B
  77+ 6ABE 32 9E 6A         LD (PlayerHitFrames), A
  78+ 6AC1 F3               DI
  79+ 6AC2 0E FD            LD C, $FD
  80+ 6AC4 21 CA 6A         LD HL, .phRegs
  81+ 6AC7 C3 27 6B         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  82+ 6ACA
  83+ 6ACA              .phRegs:
  84+ 6ACA 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  85+ 6ACC 03 00            DEFB  3, $00          ; R3  = period B hi
  86+ 6ACE 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  87+ 6AD0                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
  88+ 6AD0                                        ; aqui para no cortar las voces A/C de la musica poly2)
  89+ 6AD0 FF               DEFB $FF              ; sentinel
  90+ 6AD1
  91+ 6AD1              ; ==============================================================================
  92+ 6AD1              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  93+ 6AD1              ; ==============================================================================
  94+ 6AD1              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  95+ 6AD1              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  96+ 6AD1              ; Canal B (center stereo ABC). No bloqueante.
  97+ 6AD1              ;
  98+ 6AD1              ; IN: HL = period AY canal B (mayor = mas grave).
  99+ 6AD1              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
 100+ 6AD1              ;
 101+ 6AD1              ; Sugerencias:
 102+ 6AD1              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 103+ 6AD1              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 104+ 6AD1              ; Destruye: A, BC, HL.
 105+ 6AD1              ; ==============================================================================
 106+ 6AD1              AY_PlayBeep:
 107+ 6AD1 78               LD A, B
 108+ 6AD2 32 A3 6A         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 109+ 6AD5 F3               DI
 110+ 6AD6 0E FD            LD C, $FD
 111+ 6AD8                  ; R2 = L (period B lo)
 112+ 6AD8 3E 02            LD A, 2
 113+ 6ADA 06 FF            LD B, $FF
 114+ 6ADC ED 79            OUT (C), A
 115+ 6ADE 7D               LD A, L
 116+ 6ADF 06 BF            LD B, $BF
 117+ 6AE1 ED 79            OUT (C), A
 118+ 6AE3                  ; R3 = H (period B hi)
 119+ 6AE3 3E 03            LD A, 3
 120+ 6AE5 06 FF            LD B, $FF
 121+ 6AE7 ED 79            OUT (C), A
 122+ 6AE9 7C               LD A, H
 123+ 6AEA 06 BF            LD B, $BF
 124+ 6AEC ED 79            OUT (C), A
 125+ 6AEE                  ; R9 = $0F (vol max fija, SIN envelope). R7 mixer ya esta en $38 (set por
 126+ 6AEE                  ; AY_Init) — no tocar para no apagar las voces A/C de la musica poly2.
 127+ 6AEE 21 F4 6A         LD HL, .beepRegs
 128+ 6AF1 C3 27 6B         JP _AY_WriteRegPairs                ; tail call: EI + RET
 129+ 6AF4
 130+ 6AF4              .beepRegs:
 131+ 6AF4 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 132+ 6AF6                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
 133+ 6AF6                                        ; aqui para no cortar las voces A/C de la musica poly2)
 134+ 6AF6 FF               DEFB $FF              ; sentinel
 135+ 6AF7
 136+ 6AF7              ; ==============================================================================
 137+ 6AF7              ; AY_PlayKnockSoft / AY_PlayKnockLoud - Knock percusivo en canal B
 138+ 6AF7              ; ==============================================================================
 139+ 6AF7              ; Dos variantes de knock que comparten cutoff mechanism (BeepDurationFrames):
 140+ 6AF7              ;
 141+ 6AF7              ; Soft (grupos de 3 toques): noise B solo (tone B off), envelope $0200 (~1.2s
 142+ 6AF7              ;   decay). Knock seco, mas discreto. R7 = $2A.
 143+ 6AF7              ;
 144+ 6AF7              ; Loud (grupo de 6 toques): noise B + tone B mix (~217 Hz), envelope $0400
 145+ 6AF7              ;   (~2.4s decay). Knock con "body" del tone, vol perceptual ~3 dB mayor.
 146+ 6AF7              ;   R7 = $28.
 147+ 6AF7              ;
 148+ 6AF7              ; Ambos:
 149+ 6AF7              ;   - R6 = $05 (noise period, chasquido seco/agudo).
 150+ 6AF7              ;   - R9 = $10 (use envelope, bit 4 set).
 151+ 6AF7              ;   - R13 = $09 (decay shape, \___, retrigger en cada call). Va ULTIMO.
 152+ 6AF7              ;   - _uphMuteR9 restaura R7 = $38 al cutoff (cleanup tras knock).
 153+ 6AF7              ;
 154+ 6AF7              ; IN: B = duracion frames cutoff (recomendado 4 = ~160ms).
 155+ 6AF7              ; Destruye: A, BC, HL.
 156+ 6AF7              ; ==============================================================================
 157+ 6AF7              AY_PlayKnockSoft:
 158+ 6AF7 21 09 6B         LD HL, _knockSoftRegs
 159+ 6AFA 18 03            JR _ay_play_knock_seq
 160+ 6AFC
 161+ 6AFC              AY_PlayKnockLoud:
 162+ 6AFC 21 16 6B         LD HL, _knockLoudRegs
 163+ 6AFF                  ; fall through
 164+ 6AFF
 165+ 6AFF              _ay_play_knock_seq:
 166+ 6AFF 78               LD A, B
 167+ 6B00 32 A3 6A         LD (BeepDurationFrames), A          ; arma cutoff via ticker
 168+ 6B03 F3               DI
 169+ 6B04 0E FD            LD C, $FD
 170+ 6B06 C3 27 6B         JP _AY_WriteRegPairs                ; tail-call: EI + RET
 171+ 6B09
 172+ 6B09              _knockSoftRegs:
 173+ 6B09 06 05            DEFB  6, $05          ; R6 noise period
 174+ 6B0B 07 2A            DEFB  7, $2A          ; R7 mixer: noise B on, tone B off
 175+ 6B0D 0B 00            DEFB 11, $00          ; R11 envelope period lo
 176+ 6B0F 0C 02            DEFB 12, $02          ; R12 envelope period hi ($0200 ~1.2s decay)
 177+ 6B11 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 178+ 6B13 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 179+ 6B15 FF               DEFB $FF
 180+ 6B16
 181+ 6B16              _knockLoudRegs:
 182+ 6B16 02 00            DEFB  2, $00          ; R2 tone B period lo
 183+ 6B18 03 02            DEFB  3, $02          ; R3 tone B period hi ($0200 ~217 Hz, body grave)
 184+ 6B1A 06 05            DEFB  6, $05          ; R6 noise period
 185+ 6B1C 07 28            DEFB  7, $28          ; R7 mixer: tone B + noise B both on
 186+ 6B1E 0B 00            DEFB 11, $00          ; R11 envelope period lo
 187+ 6B20 0C 04            DEFB 12, $04          ; R12 envelope period hi ($0400 ~2.4s decay)
 188+ 6B22 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 189+ 6B24 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 190+ 6B26 FF               DEFB $FF
