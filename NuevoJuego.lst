4607+ A681 78               LD A, B
4608+ A682 32 71 A8         LD (.enW), A
4609+ A685 79               LD A, C
4610+ A686 32 72 A8         LD (.enH), A
4611+ A689
4612+ A689                  ; === AABB CUERPO (16px, sin espada) ===
4613+ A689                  ; playerBodyX = ENT_POSX siempre (cuerpo), playerBodyW = 16
