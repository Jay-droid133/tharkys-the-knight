 771+ E88F
 772+ E88F                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 773+ E88F 16 40            LD D, $40                   ; Tercio 0, scan line 0
 774+ E891 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 775+ E893 83               ADD A, E
 776+ E894 5F               LD E, A                     ; DE = dir VRAM
