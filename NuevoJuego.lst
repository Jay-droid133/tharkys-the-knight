 538+ E483              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 539+ E483              ; Usa font custom (DayHudFont) en vez de ROM font
 540+ E483              ; ==============================================================================
 541+ E483              DrawDayCycleHUD:
 542+ E483                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 543+ E483 21 41 E7         LD HL, DayHudFont + 0 * 8          ; 'D'
 544+ E486 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 545+ E489 CD F8 E4         CALL .drawChar
 546+ E48C 21 49 E7         LD HL, DayHudFont + 1 * 8          ; 'A'
 547+ E48F 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 548+ E492 CD F8 E4         CALL .drawChar
 549+ E495 21 51 E7         LD HL, DayHudFont + 2 * 8          ; 'Y'
 550+ E498 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 551+ E49B CD F8 E4         CALL .drawChar
 552+ E49E                  ; Col 7 = espacio (limpiar)
 553+ E49E 11 07 40         LD DE, $4007
 554+ E4A1 CD 01 E5         CALL .clearChar
 555+ E4A4
 556+ E4A4                  ; --- Digito decenas (col 8) ---
 557+ E4A4 3A A7 BC         LD A, (DayCycleCount)
 558+ E4A7 FE 0A            CP 10
 559+ E4A9 38 20            JR C, .singleDigit
 560+ E4AB                  ; Dos digitos: dividir A / 10
 561+ E4AB 06 00            LD B, 0
 562+ E4AD              .divLoop:
 563+ E4AD D6 0A            SUB 10
 564+ E4AF 04               INC B
 565+ E4B0 FE 0A            CP 10
 566+ E4B2 30 F9            JR NC, .divLoop
 567+ E4B4                  ; B = decenas, A = unidades
 568+ E4B4 F5               PUSH AF                             ; Guardar unidades
 569+ E4B5 78               LD A, B
 570+ E4B6 CD EB E4         CALL .getDigitFont
 571+ E4B9 11 08 40         LD DE, $4008                        ; Col 8
 572+ E4BC CD F8 E4         CALL .drawChar
 573+ E4BF F1               POP AF                              ; Recuperar unidades
 574+ E4C0 CD EB E4         CALL .getDigitFont
 575+ E4C3 11 09 40         LD DE, $4009                        ; Col 9
 576+ E4C6 CD F8 E4         CALL .drawChar
 577+ E4C9 18 14            JR .setAttrs
 578+ E4CB
 579+ E4CB              .singleDigit:
 580+ E4CB                  ; Una cifra: decena = 0, unidad = A
 581+ E4CB F5               PUSH AF
 582+ E4CC 21 59 E7         LD HL, DayHudFont + 3 * 8          ; '0'
 583+ E4CF 11 08 40         LD DE, $4008                        ; Col 8
 584+ E4D2 CD F8 E4         CALL .drawChar
 585+ E4D5 F1               POP AF
 586+ E4D6 CD EB E4         CALL .getDigitFont
 587+ E4D9 11 09 40         LD DE, $4009                        ; Col 9
 588+ E4DC CD F8 E4         CALL .drawChar
 589+ E4DF
 590+ E4DF              .setAttrs:
 591+ E4DF                  ; Atributos: bright white en cols 4-9
 592+ E4DF 3E 47            LD A, $47
 593+ E4E1 21 04 58         LD HL, ATTR_BASE + 4
 594+ E4E4 06 06            LD B, 6
 595+ E4E6              .attrLoop:
 596+ E4E6 77               LD (HL), A
 597+ E4E7 23               INC HL
 598+ E4E8 10 FC            DJNZ .attrLoop
 599+ E4EA C9               RET
 600+ E4EB
 601+ E4EB              ; Devuelve HL = puntero a font data del digito en A (0-9)
 602+ E4EB              ; A se destruye
 603+ E4EB              .getDigitFont:
 604+ E4EB C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 605+ E4ED 6F               LD L, A
 606+ E4EE 26 00            LD H, 0
 607+ E4F0 29               ADD HL, HL
 608+ E4F1 29               ADD HL, HL
 609+ E4F2 29               ADD HL, HL                          ; HL = indice * 8
 610+ E4F3 01 41 E7         LD BC, DayHudFont
 611+ E4F6 09               ADD HL, BC
 612+ E4F7 C9               RET
 613+ E4F8
 614+ E4F8              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 615+ E4F8              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 616+ E4F8              .drawChar:
 617+ E4F8 06 08            LD B, 8
 618+ E4FA              .charLoop:
 619+ E4FA 7E               LD A, (HL)
 620+ E4FB 12               LD (DE), A
 621+ E4FC 23               INC HL
 622+ E4FD 14               INC D
 623+ E4FE 10 FA            DJNZ .charLoop
 624+ E500 C9               RET
 625+ E501
 626+ E501              ; Limpia 8 scan lines en VRAM (DE)
 627+ E501              .clearChar:
 628+ E501 06 08            LD B, 8
 629+ E503 AF               XOR A
 630+ E504              .clearLoop:
 631+ E504 12               LD (DE), A
 632+ E505 14               INC D
 633+ E506 10 FC            DJNZ .clearLoop
 634+ E508 C9               RET
