6957+ C893              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6958+ C893              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6959+ C893              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6960+ C893              ; timer >= DEATH_SPAWN_FRAMES).
6961+ C893              SpawnDeath:
6962+ C893                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6963+ C893                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6964+ C893                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6965+ C893                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6966+ C893                  ; atravesando el mapa.
6967+ C893 CD 32 97         CALL FindFarthestAnyFreeCell
6968+ C896 C8               RET Z                               ; sin candidato: reintento siguiente frame
6969+ C897              .sdHaveCell:
