 656+ 63AE
 657+ 63AE              ; ==============================================================================
 658+ 63AE              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 659+ 63AE              ; ==============================================================================
 660+ 63AE              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 661+ 63AE              ;    al haberse dibujado ya en el render normal de la sala).
 662+ 63AE              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 63AE              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 63AE              ; Bank 3 para ambos (sprites baseline town).
 665+ 63AE              ; Destruye: AF, BC, DE, HL, IX.
 666+ 63AE              ; ==============================================================================
 667+ 63AE              TownGateOpenDoor:
 668+ 63AE 11 9B E9         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 63B1 CD 4B DA         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 63B4                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 63B4
 672+ 63B4              ; ==============================================================================
 673+ 63B4              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 63B4              ; ==============================================================================
 675+ 63B4              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 63B4              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 63B4              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 63B4              ; ==============================================================================
 679+ 63B4              TownGateRedrawOpenDoor:
 680+ 63B4 21 5A ED         LD HL, BgGfx_town_gate_door_open
 681+ 63B7 3E 03            LD A, 3
 682+ 63B9 CD 7A 6A         CALL LoadBgSpriteToBuffer
 683+ 63BC DD 21 9A 89      LD IX, BgSpriteBuffer
 684+ 63C0 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 63C2 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 63C4 AF               XOR A
 687+ 63C5 32 03 E5         LD (BgSpriteIsHouse), A
 688+ 63C8 32 F4 D4         LD (CurrentTintVar), A
 689+ 63CB C3 EA D3         JP DrawBgGfxSprite
 690+ 63CE
 691+ 63CE              ; ==============================================================================
 692+ 63CE              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 63CE              ; ==============================================================================
 694+ 63CE              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 63CE              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 63CE              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 63CE              ; Destruye: A, BC, DE, IX.
 698+ 63CE              ; ==============================================================================
 699+ 63CE              TownGateAllNastiesDeadCheck:
 700+ 63CE DD 21 BB 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63D2 06 04            LD B, NUM_NASTIES
 702+ 63D4              .tgandcLoop:
 703+ 63D4 DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 63D7 B7               OR A
 705+ 63D8 C0               RET NZ                              ; algun nasty aun activo
 706+ 63D9 11 10 00         LD DE, ENT_SIZE
 707+ 63DC DD 19            ADD IX, DE
 708+ 63DE 10 F4            DJNZ .tgandcLoop
 709+ 63E0 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 63E1 C9               RET
 711+ 63E2
 712+ 63E2              ; ==============================================================================
 713+ 63E2              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63E2              ; ==============================================================================
 715+ 63E2              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63E2              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63E2              ; y abajo se dibujan normal (XOR).
 718+ 63E2              ;
 719+ 63E2              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63E2              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63E2              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63E2              ;   inferiores que pasan tras el lintel skipped.
 723+ 63E2              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63E2              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63E2              ;   lintel skipped.
 726+ 63E2              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63E2              ;
 728+ 63E2              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63E2              ;     Bank 6 paginado al entrar (caller).
 730+ 63E2              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63E2              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63E2              ; ==============================================================================
 733+ 63E2              PLAYER_H_PX              EQU 21
 734+ 63E2
 735+ 63E2              TownGatePlayerXOR_BiClip:
 736+ 63E2 FD 23            INC IY
 737+ 63E4 FD 23            INC IY                              ; skip header
 738+ 63E6 D5               PUSH DE
 739+ 63E7 CD A5 A0         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 63EA D1               POP DE
 741+ 63EB 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 63ED 4A               LD C, D                             ; C = current pixel Y
 743+ 63EE              .tgpxbcRow:
 744+ 63EE 79               LD A, C
 745+ 63EF FE C0            CP 192
 746+ 63F1 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 63F3                                                      ; (sin este clip, NextPixelLine lleva
 748+ 63F3                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 63F3                                                      ; corrompe attrs como flashes raros).
 750+ 63F3 FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 63F5 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 63F7 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 63F9 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 63FB                  ; In [120, 151] → skip pixels en esta row
 755+ 63FB 18 0C            JR .tgpxbcAdvance
 756+ 63FD              .tgpxbcDraw:
 757+ 63FD                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 63FD                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 63FD FD 7E 00         LD A, (IY+0)
 760+ 6400 AE               XOR (HL)
 761+ 6401 77               LD (HL), A
 762+ 6402 23               INC HL
 763+ 6403 FD 7E 01         LD A, (IY+1)
 764+ 6406 AE               XOR (HL)
 765+ 6407 77               LD (HL), A
 766+ 6408 2B               DEC HL                              ; back to row start
 767+ 6409              .tgpxbcAdvance:
 768+ 6409 FD 23            INC IY
 769+ 640B FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 640D 0C               INC C                               ; pixel Y += 1
 771+ 640E C5               PUSH BC
 772+ 640F CD 11 9E         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 6412 C1               POP BC
 774+ 6413 10 D9            DJNZ .tgpxbcRow
 775+ 6415 C9               RET
 776+ 6416
 777+ 6416              ; ==============================================================================
 778+ 6416              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 6416              ; ==============================================================================
 780+ 6416              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 6416              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 6416              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 6416              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 6416              ; ==============================================================================
 785+ 6416              TownGatePlayerSlideErase:
 786+ 6416 DD 21 4B 81      LD IX, EntityTable
 787+ 641A DD E5            PUSH IX
 788+ 641C CD 31 A8         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 641F DD E1            POP IX
 790+ 6421 3A E7 90         LD A, (CurrentPaging)
 791+ 6424 E6 F8            AND $F8
 792+ 6426 F6 06            OR 6
