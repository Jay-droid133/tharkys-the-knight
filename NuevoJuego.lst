 627+ E71F              ; Limpia 8 scan lines en VRAM (DE)
 628+ E71F              .clearChar:
 629+ E71F 06 08            LD B, 8
 630+ E721 AF               XOR A
 631+ E722              .clearLoop:
 632+ E722 12               LD (DE), A
 633+ E723 14               INC D
 634+ E724 10 FC            DJNZ .clearLoop
 635+ E726 C9               RET
