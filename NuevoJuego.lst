4777+ B954 DD 7E 03         LD A, (IX+ENT_POSX)
4778+ B957 FD 96 03         SUB (IY+ENT_POSX)
4779+ B95A 30 02            JR NC, .spdAbsX
4780+ B95C ED 44            NEG
4781+ B95E              .spdAbsX:
4782+ B95E FE 20            CP 32
4783+ B960 30 11            JR NC, .spDistNext                  ; suficiente separacion en X
4784+ B962                  ; |dy|
4785+ B962 DD 7E 04         LD A, (IX+ENT_POSY)
4786+ B965 FD 96 04         SUB (IY+ENT_POSY)
4787+ B968 30 02            JR NC, .spdAbsY
4788+ B96A ED 44            NEG
4789+ B96C              .spdAbsY:
4790+ B96C FE 20            CP 32
4791+ B96E 30 03            JR NC, .spDistNext
4792+ B970                  ; Demasiado cerca en ambos ejes → retry
4793+ B970 C1               POP BC
4794+ B971 18 0B            JR .spawnBlocked
4795+ B973              .spDistNext:
4796+ B973 11 10 00         LD DE, ENT_SIZE
