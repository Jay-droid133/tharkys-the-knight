 145+ 6A7A              ; ==============================================================================
 146+ 6A7A              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 147+ 6A7A              ; ==============================================================================
 148+ 6A7A              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 149+ 6A7A              ;      A  = bank (0-7) donde vive el sprite
 150+ 6A7A              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 151+ 6A7A              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 152+ 6A7A              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 153+ 6A7A              ;
 154+ 6A7A              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 155+ 6A7A              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 156+ 6A7A              ; forzar EI prematuro en startup.
 157+ 6A7A              ;
 158+ 6A7A              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 159+ 6A7A              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 160+ 6A7A              ; ==============================================================================
 161+ 6A7A              LoadBgSpriteToBuffer:
 162+ 6A7A                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 163+ 6A7A                  ; necesitan intacto, y los registros alternos se usan abajo).
 164+ 6A7A 32 09 6B         LD (.lbsBankSave), A
 165+ 6A7D                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 166+ 6A7D                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 167+ 6A7D C5               PUSH BC
 168+ 6A7E                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 169+ 6A7E F3               DI
 170+ 6A7F                  ; Page bank deseado inline
 171+ 6A7F 3A E7 90         LD A, (CurrentPaging)
 172+ 6A82 E6 F8            AND $F8
 173+ 6A84 47               LD B, A                         ; B = paging limpio sin bank
 174+ 6A85 3A 09 6B         LD A, (.lbsBankSave)
 175+ 6A88 E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 6A8A B0               OR B                            ; merge bank en paging
 177+ 6A8B 32 E7 90         LD (CurrentPaging), A
 178+ 6A8E 01 FD 7F         LD BC, $7FFD
 179+ 6A91 ED 79            OUT (C), A
 180+ 6A93                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 6A93                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 6A93                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 6A93                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 6A93 11 9A 89         LD DE, BgSpriteBuffer
 185+ 6A96                  ; Copiar H (header byte 0)
 186+ 6A96 7E               LD A, (HL)
 187+ 6A97 12               LD (DE), A
 188+ 6A98 32 07 6B         LD (.lbsHsave), A
 189+ 6A9B 23               INC HL
 190+ 6A9C 13               INC DE
 191+ 6A9D                  ; Copiar W|RLE (header byte 1)
 192+ 6A9D 7E               LD A, (HL)
 193+ 6A9E 12               LD (DE), A
 194+ 6A9F 23               INC HL
 195+ 6AA0 13               INC DE
 196+ 6AA1 CB 7F            BIT 7, A
 197+ 6AA3 20 47            JR NZ, .lbsRleFallback
 198+ 6AA5 E6 7F            AND $7F
 199+ 6AA7 32 08 6B         LD (.lbsWsave), A
 200+ 6AAA                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 6AAA 3A 07 6B         LD A, (.lbsHsave)
 202+ 6AAD B7               OR A
 203+ 6AAE 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 6AB0 47               LD B, A                         ; B = H (outer loop)
 205+ 6AB1              .lbsPixRow:
 206+ 6AB1 3A 08 6B         LD A, (.lbsWsave)
 207+ 6AB4 B7               OR A
 208+ 6AB5 28 08            JR Z, .lbsPixRowDone
 209+ 6AB7 4F               LD C, A                         ; C = W (inner loop)
 210+ 6AB8              .lbsPixCol:
 211+ 6AB8 7E               LD A, (HL)
 212+ 6AB9 12               LD (DE), A
 213+ 6ABA 23               INC HL
 214+ 6ABB 13               INC DE
 215+ 6ABC 0D               DEC C
 216+ 6ABD 20 F9            JR NZ, .lbsPixCol
 217+ 6ABF              .lbsPixRowDone:
 218+ 6ABF 10 F0            DJNZ .lbsPixRow
 219+ 6AC1              .lbsAfterPixels:
 220+ 6AC1                  ; --- Copiar 1 byte tint ---
 221+ 6AC1 7E               LD A, (HL)
 222+ 6AC2 12               LD (DE), A
 223+ 6AC3 23               INC HL
 224+ 6AC4 13               INC DE
 225+ 6AC5                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 226+ 6AC5 7E               LD A, (HL)
 227+ 6AC6 12               LD (DE), A
 228+ 6AC7 32 07 6B         LD (.lbsHsave), A               ; reusar var
 229+ 6ACA 23               INC HL
 230+ 6ACB 13               INC DE
 231+ 6ACC 7E               LD A, (HL)
 232+ 6ACD 12               LD (DE), A
 233+ 6ACE 32 08 6B         LD (.lbsWsave), A
 234+ 6AD1 23               INC HL
 235+ 6AD2 13               INC DE
 236+ 6AD3 3A 07 6B         LD A, (.lbsHsave)
 237+ 6AD6 B7               OR A
 238+ 6AD7 28 18            JR Z, .lbsLoadDone              ; sin attrs
 239+ 6AD9 47               LD B, A
 240+ 6ADA              .lbsAttrRow:
 241+ 6ADA 3A 08 6B         LD A, (.lbsWsave)
 242+ 6ADD B7               OR A
 243+ 6ADE 28 08            JR Z, .lbsAttrRowDone
 244+ 6AE0 4F               LD C, A
 245+ 6AE1              .lbsAttrCol:
 246+ 6AE1 7E               LD A, (HL)
 247+ 6AE2 12               LD (DE), A
 248+ 6AE3 23               INC HL
 249+ 6AE4 13               INC DE
 250+ 6AE5 0D               DEC C
 251+ 6AE6 20 F9            JR NZ, .lbsAttrCol
