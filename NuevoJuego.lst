 157+ A163              ; ==============================================================================
 158+ A163              ; InitEntities - Inicializa la tabla de entidades
 159+ A163              ; ==============================================================================
 160+ A163              ; Limpia todos los slots y configura el slot 0 como player.
 161+ A163              ; ==============================================================================
 162+ A163              InitEntities:
 163+ A163                  ; Limpiar toda la tabla a ceros
 164+ A163 21 9B 81         LD HL, EntityTable
 165+ A166 11 9C 81         LD DE, EntityTable + 1
 166+ A169 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ A16C AF               XOR A
 168+ A16D 77               LD (HL), A
 169+ A16E ED B0            LDIR
