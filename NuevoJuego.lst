 449+ 92D6              ; ==============================================================================
 450+ 92D6              ; DespawnScaredMonsters - Limpia monsters en STATE_SCARED al cambiar de room
 451+ 92D6              ; ==============================================================================
 452+ 92D6              ; Llamado desde screen_system.asm en la transicion de pantalla. Cualquier
 453+ 92D6              ; monster que aun este en STATE_SCARED (atrapado entre obstaculos durante el
 454+ 92D6              ; flee de amanecer) se elimina del slot. Sin esto, sus POSX/POSY persisten y
 455+ 92D6              ; el sprite reaparece en la pantalla nueva en la misma coord, "siguiendo" al
 456+ 92D6              ; player visualmente aunque RepositionMonstersAtEntry no los toca (porque
 457+ 92D6              ; MonstersActive=0 durante dawn).
 458+ 92D6              ;
 459+ 92D6              ; Solo afecta a monsters scared. Monsters en RUNNING / DYING / SPAWNING los
 460+ 92D6              ; gestiona RepositionMonstersAtEntry (cuando MonstersActive=1).
 461+ 92D6              ; ==============================================================================
 462+ 92D6              DespawnScaredMonsters:
 463+ 92D6 DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 464+ 92DA 06 06            LD B, NUM_MONSTERS
 465+ 92DC              .dsmLoop:
 466+ 92DC C5               PUSH BC
 467+ 92DD DD 7E 01         LD A, (IX+ENT_TYPE)
 468+ 92E0 FE 02            CP TYPE_MONSTER
 469+ 92E2 20 12            JR NZ, .dsmNext
 470+ 92E4 DD 7E 02         LD A, (IX+ENT_STATE)
 471+ 92E7 FE 05            CP STATE_SCARED
 472+ 92E9 20 0B            JR NZ, .dsmNext
 473+ 92EB CD 97 92         CALL WipeMonsterSlot
 474+ 92EE DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 92F2 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 476+ 92F6              .dsmNext:
 477+ 92F6 11 10 00         LD DE, ENT_SIZE
 478+ 92F9 DD 19            ADD IX, DE
 479+ 92FB C1               POP BC
 480+ 92FC 10 DE            DJNZ .dsmLoop
 481+ 92FE C9               RET
