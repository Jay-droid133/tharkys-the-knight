 131  63E9
 132  63E9                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 133  63E9                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 134  63E9                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 135  63E9                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 136  63E9                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 137  63E9                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 63E9              ; ==============================================================================
   2+ 63E9              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 63E9              ; ==============================================================================
   4+ 63E9              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 63E9              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 63E9              ; la cinematica — invisible porque es one-shot.
   7+ 63E9              ;
   8+ 63E9              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 63E9              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 63E9              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 63E9              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 63E9              ; ==============================================================================
  13+ 63E9
  14+ 63E9              ; ==============================================================================
  15+ 63E9              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 63E9              ; ==============================================================================
  17+ 63E9              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 63E9              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 63E9              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 63E9              ; ChurchCutsceneSlot.
  21+ 63E9              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 63E9              ; ==============================================================================
  23+ 63E9              EraseChurchTrappedMonster:
  24+ 63E9 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 63EC 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 63ED 6F               LD L, A
  27+ 63EE 26 00            LD H, 0
  28+ 63F0 29               ADD HL, HL
  29+ 63F1 29               ADD HL, HL
  30+ 63F2 29               ADD HL, HL
  31+ 63F3 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 63F4 11 A0 81         LD DE, EntityTable
  33+ 63F7 19               ADD HL, DE
  34+ 63F8 E5               PUSH HL
  35+ 63F9 DD E1            POP IX
  36+ 63FB CD 20 A5         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 63FE DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 6401 57               LD D, A
  39+ 6402 DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 6405 5F               LD E, A
  41+ 6406 DD 2A A8 A4      LD IX, (OldSprAddr)
  42+ 640A C3 EC 99         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 640D
  44+ 640D              ; ==============================================================================
  45+ 640D              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 640D              ; ==============================================================================
  47+ 640D              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 640D              ; - Despawn monster (ENT_TYPE=0).
  49+ 640D              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 640D              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 640D              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 640D              ; ==============================================================================
  53+ 640D              ApplyChurchTrapDone:
  54+ 640D                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 640D 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 6410 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 6411 6F               LD L, A
  58+ 6412 26 00            LD H, 0
  59+ 6414 29               ADD HL, HL
