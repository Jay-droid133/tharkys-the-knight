2153+ AE1B C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2154+ AE1D 4F               LD C, A
2155+ AE1E 3A 4E 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2156+ AE21 B9               CP C                                ; playerX < wellRight+margen?
2157+ AE22 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2158+ AE24 3A 4E 81         LD A, (EntityTable + ENT_POSX)
2159+ AE27 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2160+ AE29 4F               LD C, A
2161+ AE2A 3A BE 90         LD A, (WellPosX)                    ; A = wellX
2162+ AE2D B9               CP C                                ; wellX < playerRight+margen?
