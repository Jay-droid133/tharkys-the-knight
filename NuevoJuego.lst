4207+ B994              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
4208+ B994              ; ==============================================================================
4209+ B994              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
4210+ B994              ; ENT_DIR contiene el ANIMBASE real del enemigo.
4211+ B994              ; Cuando el ultimo frame expira → restaura sprite real y activa movimiento.
4212+ B994              ; ==============================================================================
4213+ B994              UpdateSpawning:
4214+ B994 DD 35 09         DEC (IX+ENT_ANIMTIMER)
4215+ B997 20 39            JR NZ, .spAnimDone
4216+ B999                  ; Timer expirado → avanzar frame
4217+ B999 3E 01            LD A, ANIM_DELAY_SPAWN
4218+ B99B DD 77 09         LD (IX+ENT_ANIMTIMER), A
4219+ B99E DD 7E 00         LD A, (IX+ENT_SPRITEID)
4220+ B9A1 3C               INC A
4221+ B9A2 47               LD B, A
4222+ B9A3 DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de spawn
4223+ B9A6 FE 06            CP ANIM_FRAMES_SPAWN            ; >= 6 → animacion terminada
4224+ B9A8 38 25            JR C, .spFrameOk
4225+ B9AA                  ; Spawn terminado: transicionar a STATE_RUNNING
4226+ B9AA DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
4227+ B9AE DD 7E 0A         LD A, (IX+ENT_DIR)              ; Recuperar ANIMBASE real del enemigo
4228+ B9B1 DD 77 08         LD (IX+ENT_ANIMBASE), A
4229+ B9B4 DD 77 00         LD (IX+ENT_SPRITEID), A
4230+ B9B7 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
4231+ B9BB                  ; Monsters: breve pausa antes de empezar a perseguir
4232+ B9BB DD 7E 01         LD A, (IX+ENT_TYPE)
4233+ B9BE FE 02            CP TYPE_MONSTER
4234+ B9C0 20 0C            JR NZ, .spNotMonster
4235+ B9C2 DD 36 0A 06      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE ; Pausa sin knockback (deltas=0)
4236+ B9C6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4237+ B9CA DD 36 07 00      LD (IX+ENT_DELTAY), 0
4238+ B9CE              .spNotMonster:
4239+ B9CE C9               RET
4240+ B9CF              .spFrameOk:
