 279+ 88A6              ; ==============================================================================
 280+ 88A6              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 281+ 88A6              ; ==============================================================================
 282+ 88A6              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 283+ 88A6              ; Se llama ANTES de pintar el sprite.
 284+ 88A6              ;
 285+ 88A6              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 286+ 88A6              ;          IX = puntero al sprite (para leer width/height)
 287+ 88A6              ; ==============================================================================
 288+ 88A6              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 289+ 88A6              ; ==============================================================================
 290+ 88A6              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 291+ 88A6              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 292+ 88A6              ; ==============================================================================
 293+ 88A6              CalcEntityAttrSize:
 294+ 88A6 DD 7E 00         LD A, (IX+0)                ; width_bytes
 295+ 88A9 47               LD B, A
 296+ 88AA 7B               LD A, E
 297+ 88AB E6 07            AND 7
 298+ 88AD 28 01            JR Z, .ceNoExtra
 299+ 88AF 04               INC B
 300+ 88B0              .ceNoExtra:
 301+ 88B0 78               LD A, B
 302+ 88B1 32 37 89         LD (EntityAttrW), A
 303+ 88B4 7A               LD A, D
 304+ 88B5 E6 07            AND 7
 305+ 88B7 4F               LD C, A
 306+ 88B8 DD 7E 01         LD A, (IX+1)                ; height_pixels
 307+ 88BB 81               ADD A, C
 308+ 88BC C6 07            ADD A, 7
 309+ 88BE 0F               RRCA
 310+ 88BF 0F               RRCA
 311+ 88C0 0F               RRCA
 312+ 88C1 E6 1F            AND $1F
 313+ 88C3 32 38 89         LD (EntityAttrH), A
 314+ 88C6 C9               RET
