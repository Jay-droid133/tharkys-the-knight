 215+ 677D              ; ==============================================================================
 216+ 677D              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 217+ 677D              ; ==============================================================================
 218+ 677D              ; IN: A = frame idx (0..2)
 219+ 677D              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 220+ 677D              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 221+ 677D              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 222+ 677D              ; Destruye: AF, BC, DE, HL, IX.
 223+ 677D              ; ==============================================================================
 224+ 677D              DrawSmokeFrameXor:
 225+ 677D 87               ADD A, A                                ; *2 (entries de 2 bytes)
 226+ 677E 6F               LD L, A
 227+ 677F 26 00            LD H, 0
 228+ 6781 11 77 67         LD DE, SmokeFramePtrTable
 229+ 6784 19               ADD HL, DE
 230+ 6785 5E               LD E, (HL)
 231+ 6786 23               INC HL
 232+ 6787 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 233+ 6788                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 234+ 6788                  ; Source y destino accesibles sin paging (milestones bank 0,
 235+ 6788                  ; BgSpriteBuffer en RAM principal).
 236+ 6788 EB               EX DE, HL                               ; HL = source
 237+ 6789 11 F5 88         LD DE, BgSpriteBuffer
 238+ 678C 01 22 00         LD BC, 34
 239+ 678F ED B0            LDIR
 240+ 6791                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 241+ 6791 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 242+ 6794 57               LD D, A
 243+ 6795 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 244+ 6798 5F               LD E, A
 245+ 6799 C3 8F 68         JP DrawBgSprite16XorAtPixel
 246+ 679C
 247+ 679C              ; ==============================================================================
 248+ 679C              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 249+ 679C              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 250+ 679C              ; ==============================================================================
 251+ 679C              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 252+ 679C              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 253+ 679C              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 254+ 679C              ; uniformemente negro -- el efecto que pidio el usuario.
 255+ 679C              ;
 256+ 679C              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 257+ 679C              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 258+ 679C              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 259+ 679C              ; Destruye: AF, BC, DE, HL.
 260+ 679C              ; ==============================================================================
 261+ 679C              ClearSmokeAttrs:
 262+ 679C                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 263+ 679C 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 264+ 679F CB 3F            SRL A
 264+ 67A1 CB 3F          SRL A
 264+ 67A3 CB 3F          SRL A                   ; A = char Y (post-HUD)
 265+ 67A5 26 00            LD H, 0
 266+ 67A7 6F               LD L, A
 267+ 67A8 29               ADD HL, HL                              ; *2
 268+ 67A9 29               ADD HL, HL                              ; *4
 269+ 67AA 29               ADD HL, HL                              ; *8
 270+ 67AB 29               ADD HL, HL                              ; *16
 271+ 67AC 29               ADD HL, HL                              ; *32
 272+ 67AD 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 273+ 67B0 CB 3F            SRL A
 273+ 67B2 CB 3F          SRL A
 273+ 67B4 CB 3F          SRL A                   ; A = char X
 274+ 67B6 5F               LD E, A
 275+ 67B7 16 00            LD D, 0
 276+ 67B9 19               ADD HL, DE
 277+ 67BA 11 00 58         LD DE, $5800
 278+ 67BD 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 279+ 67BE AF               XOR A                                   ; paper black, ink black
 280+ 67BF 77               LD (HL), A                              ; (charY, charX)
 281+ 67C0 23               INC HL
 282+ 67C1 77               LD (HL), A                              ; (charY, charX+1)
 283+ 67C2 11 1F 00         LD DE, 31
 284+ 67C5 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 285+ 67C6 77               LD (HL), A
 286+ 67C7 23               INC HL
 287+ 67C8 77               LD (HL), A                              ; (charY+1, charX+1)
 288+ 67C9 C9               RET
 289+ 67CA
 290+ 67CA              ; ==============================================================================
 291+ 67CA              ; CheckStatueHidden - es esta entry de BG una estatua oculta?
 292+ 67CA              ; ==============================================================================
 293+ 67CA              ; IN:  A = sprite id
 294+ 67CA              ; OUT: NZ si es estatua y su slot esta atrapado (skip drawing).
 295+ 67CA              ;      Z si no es estatua o esta visible (draw normalmente).
 296+ 67CA              ; Destruye: AF, BC, HL.
 297+ 67CA              ; ==============================================================================
 298+ 67CA              CheckStatueHidden:
 299+ 67CA 21 07 67         LD HL, StatueIdTable
 300+ 67CD 06 03            LD B, 3
 301+ 67CF 0E 00            LD C, 0                                 ; slot index 0..2
 302+ 67D1              .cshLoop:
 303+ 67D1 BE               CP (HL)
 304+ 67D2 28 06            JR Z, .cshMatch
 305+ 67D4 23               INC HL
 306+ 67D5 0C               INC C
 307+ 67D6 10 F9            DJNZ .cshLoop
 308+ 67D8 AF               XOR A                                   ; not statue -> Z (visible)
 309+ 67D9 C9               RET
 310+ 67DA              .cshMatch:
 311+ 67DA                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 312+ 67DA 79               LD A, C
 313+ 67DB 32 10 67         LD (LastHiddenStatueType), A            ; expose type para el caller
 314+ 67DE 21 04 67         LD HL, ChurchTrapBitMask
 315+ 67E1 5F               LD E, A
 316+ 67E2 16 00            LD D, 0
 317+ 67E4 19               ADD HL, DE
 318+ 67E5 7E               LD A, (HL)                              ; bit mask
 319+ 67E6 21 E9 81         LD HL, MonsterTrappedFlags
 320+ 67E9 A6               AND (HL)
 321+ 67EA C9               RET                                     ; NZ si bit set (hidden), Z si no
 322+ 67EB
 323+ 67EB              ; ==============================================================================
 324+ 67EB              ; EraseStatueAtSlot - borra (XOR) la estatua del slot N en la pantalla actual
 325+ 67EB              ; ==============================================================================
 326+ 67EB              ; IN: A = slot (0..2)
 327+ 67EB              ; Solo tiene efecto si la estatua esta colocada en la pantalla actual.
 328+ 67EB              ; Destruye: AF, BC, DE, HL, IX.
 329+ 67EB              ; ==============================================================================
 330+ 67EB              EraseStatueAtSlot:
 331+ 67EB                  ; Get statue ID from table
 332+ 67EB 21 07 67         LD HL, StatueIdTable
 333+ 67EE 5F               LD E, A
 334+ 67EF 16 00            LD D, 0
 335+ 67F1 19               ADD HL, DE
 336+ 67F2 7E               LD A, (HL)                              ; A = statue id
 337+ 67F3 B7               OR A
 338+ 67F4 C8               RET Z                                   ; ID 0 = no estatua (no exportada)
 339+ 67F5 32 31 68         LD (.eseTargetId), A
 340+ 67F8                  ; Scan CurrentScreenBuffer (formato 4B: id, charX, charY, variant; $FF = end)
 341+ 67F8 2A 0A 82         LD HL, (CurrentScreenAddr)
 342+ 67FB              .eseLoop:
 343+ 67FB 7E               LD A, (HL)
 344+ 67FC FE FF            CP $FF
 345+ 67FE C8               RET Z                                   ; no encontrada en esta pantalla
 346+ 67FF 47               LD B, A                                 ; B = current id
 347+ 6800 3A 31 68         LD A, (.eseTargetId)
 348+ 6803 B8               CP B
 349+ 6804 28 06            JR Z, .eseFound
 350+ 6806 11 04 00         LD DE, 4
 351+ 6809 19               ADD HL, DE
 352+ 680A 18 EF            JR .eseLoop
 353+ 680C              .eseFound:
 354+ 680C                  ; HL en id. Avanzar a charX, charY.
 355+ 680C 23               INC HL
 356+ 680D 46               LD B, (HL)                              ; B = charX
 357+ 680E 23               INC HL
 358+ 680F 4E               LD C, (HL)                              ; C = charY
 359+ 6810                  ; Cargar sprite via BgGfxPtrById[id]: id*3 -> ptr (DEFW), bank (DEFB).
 360+ 6810 3A 31 68         LD A, (.eseTargetId)
 361+ 6813 6F               LD L, A
 362+ 6814 26 00            LD H, 0
 363+ 6816 54               LD D, H
 364+ 6817 5D               LD E, L
 365+ 6818 29               ADD HL, HL                              ; *2
 366+ 6819 19               ADD HL, DE                              ; *3
 367+ 681A 11 7E DA         LD DE, BgGfxPtrById
 368+ 681D 19               ADD HL, DE
 369+ 681E 5E               LD E, (HL)
 370+ 681F 23               INC HL
 371+ 6820 56               LD D, (HL)                              ; DE = ptr
 372+ 6821 23               INC HL
 373+ 6822 7E               LD A, (HL)                              ; A = bank
 374+ 6823 C5               PUSH BC
 375+ 6824 EB               EX DE, HL                               ; HL = ptr
 376+ 6825 CD BD 90         CALL LoadBgSpriteToBuffer               ; preserva BC
 377+ 6828 C1               POP BC
 378+ 6829 DD 21 F5 88      LD IX, BgSpriteBuffer
 379+ 682D CD C4 D6         CALL DrawBgSpriteXOR                    ; XOR-erase
 380+ 6830 C9               RET
 381+ 6831 00           .eseTargetId: DEFB 0
