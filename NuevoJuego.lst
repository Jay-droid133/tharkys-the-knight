2778+ B192 D1               POP DE
2779+ B193 C3 45 B2         JP .moKbApply
2780+ B196              .moKbBilliard:
2781+ B196                  ; Billar: A para en su sitio, B hereda la fuerza
2782+ B196 3A 5A B6         LD A, (.moSvX)
2783+ B199 DD 77 03         LD (IX+ENT_POSX), A
2784+ B19C 3A 5B B6         LD A, (.moSvY)
2785+ B19F DD 77 04         LD (IX+ENT_POSY), A
2786+ B1A2 D1               POP DE
2787+ B1A3                  ; Transferir knockback al monster impactado
2788+ B1A3 DD E5            PUSH IX
2789+ B1A5 DD 2A 64 B6      LD IX, (.moHitMonster)
2790+ B1A9                  ; Solo transferir si no esta ya en stun
2791+ B1A9 DD 7E 0A         LD A, (IX+ENT_DIR)
2792+ B1AC B7               OR A
2793+ B1AD 20 2A            JR NZ, .moKbBilliardDone
2794+ B1AF                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2795+ B1AF 7A               LD A, D
2796+ B1B0 B7               OR A
2797+ B1B1 28 0D            JR Z, .moBillNoX
2798+ B1B3 CB 7A            BIT 7, D
2799+ B1B5 20 04            JR NZ, .moBillXNeg
2800+ B1B7 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2801+ B1B9 18 02            JR .moBillSetX
2802+ B1BB              .moBillXNeg:
2803+ B1BB 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2804+ B1BD              .moBillSetX:
2805+ B1BD DD 77 06         LD (IX+ENT_DELTAX), A
2806+ B1C0              .moBillNoX:
2807+ B1C0 7B               LD A, E
2808+ B1C1 B7               OR A
2809+ B1C2 28 0D            JR Z, .moBillNoY
2810+ B1C4 CB 7B            BIT 7, E
2811+ B1C6 20 04            JR NZ, .moBillYNeg
2812+ B1C8 3E 03            LD A, MONSTER_KB_SPEED - 1
2813+ B1CA 18 02            JR .moBillSetY
2814+ B1CC              .moBillYNeg:
2815+ B1CC 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2816+ B1CE              .moBillSetY:
2817+ B1CE DD 77 07         LD (IX+ENT_DELTAY), A
2818+ B1D1              .moBillNoY:
2819+ B1D1 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2820+ B1D5                  ; Kb heredado por billar: NO es directo del player.
2821+ B1D5                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2822+ B1D5 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2823+ B1D9              .moKbBilliardDone:
2824+ B1D9 DD E1            POP IX
2825+ B1DB                  ; A continua con fuerza reducida (no para del todo)
2826+ B1DB                  ; Reducir velocidad de A a la mitad
2827+ B1DB DD 7E 06         LD A, (IX+ENT_DELTAX)
2828+ B1DE CB 2F            SRA A                               ; /2 con signo
2829+ B1E0 DD 77 06         LD (IX+ENT_DELTAX), A
2830+ B1E3 57               LD D, A
2831+ B1E4 DD 7E 07         LD A, (IX+ENT_DELTAY)
2832+ B1E7 CB 2F            SRA A
2833+ B1E9 DD 77 07         LD (IX+ENT_DELTAY), A
2834+ B1EC 5F               LD E, A
