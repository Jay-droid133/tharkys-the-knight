 272+ 6526              ; ==============================================================================
 273+ 6526              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 274+ 6526              ; ==============================================================================
 275+ 6526              ; IN: A = frame idx (0..2)
 276+ 6526              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 277+ 6526              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 278+ 6526              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 279+ 6526              ; Destruye: AF, BC, DE, HL, IX.
 280+ 6526              ; ==============================================================================
 281+ 6526              DrawSmokeFrameXor:
 282+ 6526 87               ADD A, A                                ; *2 (entries de 2 bytes)
 283+ 6527 6F               LD L, A
 284+ 6528 26 00            LD H, 0
 285+ 652A 11 20 65         LD DE, SmokeFramePtrTable
 286+ 652D 19               ADD HL, DE
 287+ 652E 5E               LD E, (HL)
 288+ 652F 23               INC HL
 289+ 6530 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 290+ 6531                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 291+ 6531                  ; Source y destino accesibles sin paging (milestones bank 0,
 292+ 6531                  ; BgSpriteBuffer en RAM principal).
 293+ 6531 EB               EX DE, HL                               ; HL = source
 294+ 6532 11 FD 86         LD DE, BgSpriteBuffer
 295+ 6535 01 22 00         LD BC, 34
 296+ 6538 ED B0            LDIR
 297+ 653A                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 298+ 653A 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 299+ 653D 57               LD D, A
 300+ 653E 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 301+ 6541 5F               LD E, A
 302+ 6542 C3 38 66         JP DrawBgSprite16XorAtPixel
