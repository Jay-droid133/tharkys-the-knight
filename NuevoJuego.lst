2046+ AA54              ; UpdateEnemy - AI patrol + bounce (estilo Sabre Wulf)
2047+ AA54              ; ==============================================================================
2048+ AA54              ; Cada frame: posicion += delta. Si choca con borde o fondo, invierte delta.
2049+ AA54              ; Animacion: cicla SpriteID dentro del rango del tipo.
2050+ AA54              ; IX = puntero a la entidad enemiga.
2051+ AA54              ; ==============================================================================
2052+ AA54              ; ==============================================================================
2053+ AA54              ; CheckPredatorAttack - Comprueba si nasty debe lanzarse como depredador
2054+ AA54              ; ==============================================================================
2055+ AA54              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
2056+ AA54              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
2057+ AA54              ; ==============================================================================
2058+ AA54              ; ==============================================================================
2059+ AA54              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2060+ AA54              ; ==============================================================================
2061+ AA54              UpdateStamina:
2062+ AA54                  ; --- Regenerar salud (1 unidad cada HEALTH_REGEN_RATE = 100 f = 4 s) ---
2063+ AA54 3A 52 B3         LD A, (PlayerHealth)
2064+ AA57 FE 10            CP HEALTH_MAX
2065+ AA59 28 12            JR Z, .usHealthFull
2066+ AA5B 21 56 B3         LD HL, HealthRegenCtr
2067+ AA5E 34               INC (HL)
2068+ AA5F 7E               LD A, (HL)
2069+ AA60 FE 64            CP HEALTH_REGEN_RATE
2070+ AA62 38 09            JR C, .usHealthFull
2071+ AA64 36 00            LD (HL), 0
2072+ AA66 3A 52 B3         LD A, (PlayerHealth)
2073+ AA69 3C               INC A
2074+ AA6A 32 52 B3         LD (PlayerHealth), A
2075+ AA6D              .usHealthFull:
2076+ AA6D                  ; --- Stamina: consumir o regenerar ---
2077+ AA6D DD 7E 02         LD A, (IX+ENT_STATE)
2078+ AA70 FE 02            CP STATE_FIGHTING
2079+ AA72 28 18            JR Z, .usDrain
2080+ AA74                  ; --- Regenerar stamina (1 unidad cada STAMINA_REGEN_RATE = 50 f = 2 s) ---
2081+ AA74 3A 53 B3         LD A, (PlayerStamina)
2082+ AA77 FE 10            CP STAMINA_MAX
2083+ AA79 C8               RET Z                               ; Ya al maximo
2084+ AA7A 21 55 B3         LD HL, StaminaRegenCtr
2085+ AA7D 34               INC (HL)
2086+ AA7E 7E               LD A, (HL)
2087+ AA7F FE 32            CP STAMINA_REGEN_RATE
2088+ AA81 D8               RET C                               ; Aun no toca
2089+ AA82 36 00            LD (HL), 0                          ; Reset counter
2090+ AA84 3A 53 B3         LD A, (PlayerStamina)
2091+ AA87 3C               INC A
2092+ AA88 32 53 B3         LD (PlayerStamina), A
2093+ AA8B C9               RET
2094+ AA8C              .usDrain:
2095+ AA8C                  ; Atacando: consumir stamina
2096+ AA8C 3A 53 B3         LD A, (PlayerStamina)
2097+ AA8F B7               OR A
2098+ AA90 C8               RET Z                               ; Ya vacia
2099+ AA91 21 54 B3         LD HL, StaminaDrainCtr
2100+ AA94 34               INC (HL)
2101+ AA95 7E               LD A, (HL)
2102+ AA96 FE 0D            CP STAMINA_DRAIN_RATE
2103+ AA98 D8               RET C
2104+ AA99 36 00            LD (HL), 0
2105+ AA9B 3A 53 B3         LD A, (PlayerStamina)
2106+ AA9E 3D               DEC A
2107+ AA9F 32 53 B3         LD (PlayerStamina), A
2108+ AAA2                  ; Si stamina llega a 0, dar 1 punto tras cooldown
2109+ AAA2 B7               OR A
2110+ AAA3 C0               RET NZ
2111+ AAA4 3E 01            LD A, 1
2112+ AAA6 32 53 B3         LD (PlayerStamina), A               ; Minimo 1 para un swing
2113+ AAA9 C9               RET
2114+ AAAA
2115+ AAAA              ; ==============================================================================
2116+ AAAA              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2117+ AAAA              ; ==============================================================================
2118+ AAAA              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2119+ AAAA              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2120+ AAAA              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2121+ AAAA              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2122+ AAAA              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2123+ AAAA              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2124+ AAAA              ; ==============================================================================
2125+ AAAA              SelectSwordMode:
2126+ AAAA 3A 53 B3         LD A, (PlayerStamina)
2127+ AAAD FE 0C            CP STAMINA_THRESHOLD_HIGH
2128+ AAAF 38 04            JR C, .smNotHigh
2129+ AAB1 3E 02            LD A, 2                             ; Libre (continuo)
2130+ AAB3 18 09            JR .smSet
2131+ AAB5              .smNotHigh:
2132+ AAB5 FE 07            CP STAMINA_THRESHOLD_MID
2133+ AAB7 38 04            JR C, .smNotMid
2134+ AAB9 3E 01            LD A, 1                             ; Fixed swing
2135+ AABB 18 01            JR .smSet
2136+ AABD              .smNotMid:
2137+ AABD AF               XOR A                               ; Cooldown (0)
2138+ AABE              .smSet:
2139+ AABE 32 51 B3         LD (SwordMode), A
2140+ AAC1 B7               OR A
2141+ AAC2 C8               RET Z                               ; Mode B → cooldown legítimo, no tocar
2142+ AAC3                  ; Mode C/Free: cooldown sin sentido. Limpiar + reset color si quedó azul.
2143+ AAC3 AF               XOR A
2144+ AAC4 32 4E B3         LD (AttackCooldown), A
2145+ AAC7 3A A0 81         LD A, (EntityTable + ENT_ATTR)
2146+ AACA FE 41            CP BLUE | $40
2147+ AACC C0               RET NZ                              ; No estaba azul → nada que hacer
2148+ AACD 3A F4 C4         LD A, (PlayerHitTimer)
2149+ AAD0 B7               OR A
2150+ AAD1 C0               RET NZ                              ; En flash de daño → no pisar el rojo
2151+ AAD2 3E 47            LD A, WHITE | $40
2152+ AAD4 32 A0 81         LD (EntityTable + ENT_ATTR), A
2153+ AAD7 C9               RET
2154+ AAD8
2155+ AAD8              ; ==============================================================================
2156+ AAD8              ; GetStaminaColor - Devuelve color del player segun estado actual
2157+ AAD8              ; ==============================================================================
2158+ AAD8              ; Salida: A = atributo de color (bright)
2159+ AAD8              ; ==============================================================================
2160+ AAD8              GetStaminaColor:
2161+ AAD8 3A 51 B3         LD A, (SwordMode)
2162+ AADB B7               OR A
2163+ AADC 20 09            JR NZ, .gscWhite                   ; Modo C o libre → blanco
2164+ AADE 3A 4E B3         LD A, (AttackCooldown)
2165+ AAE1 B7               OR A
2166+ AAE2 28 03            JR Z, .gscWhite
2167+ AAE4 3E 41            LD A, BLUE | $40                    ; Modo B + cooldown activo → azul
2168+ AAE6 C9               RET
2169+ AAE7              .gscWhite:
2170+ AAE7 3E 47            LD A, WHITE | $40                   ; Normal → blanco
2171+ AAE9 C9               RET
2172+ AAEA
2173+ AAEA              ; ==============================================================================
2174+ AAEA              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2175+ AAEA              ; ==============================================================================
2176+ AAEA              CheckWellPickup:
2177+ AAEA 3A 57 8D         LD A, (WellActive)
2178+ AAED B7               OR A
2179+ AAEE C8               RET Z                               ; No hay pozo en esta pantalla
2180+ AAEF                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2181+ AAEF 2A 5B 8D         LD HL, (WellCooldownTimer)
2182+ AAF2 7C               LD A, H
2183+ AAF3 B5               OR L
2184+ AAF4 C0               RET NZ                              ; timer > 0 → skip
2185+ AAF5                  ; Ya esta al maximo? No hacer nada
2186+ AAF5 3A 52 B3         LD A, (PlayerHealth)
2187+ AAF8 FE 10            CP HEALTH_MAX
2188+ AAFA 20 06            JR NZ, .cwDoCheck
2189+ AAFC 3A 53 B3         LD A, (PlayerStamina)
2190+ AAFF FE 10            CP STAMINA_MAX
2191+ AB01 C8               RET Z                               ; Ambos al maximo → nada
