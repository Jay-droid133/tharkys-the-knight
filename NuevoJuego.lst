 540+ ECA3              ; ==============================================================================
 541+ ECA3              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 542+ ECA3              ; ==============================================================================
 543+ ECA3              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 544+ ECA3              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 545+ ECA3              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 546+ ECA3              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 547+ ECA3              ; si no, restaura WHITE | $40.
 548+ ECA3              ; ==============================================================================
 549+ ECA3              UpdateMushroomBuffBody:
 550+ ECA3 2A E2 82         LD HL, (MushroomLockTimer)
 551+ ECA6 7C               LD A, H
 552+ ECA7 B5               OR L
 553+ ECA8 C8               RET Z                               ; sin debuff
 554+ ECA9 2B               DEC HL
 555+ ECAA 22 E2 82         LD (MushroomLockTimer), HL
 556+ ECAD C9               RET                                 ; (color lo pinta el cycler segun timer)
 557+ ECAE
 558+ ECAE              ; ==============================================================================
 559+ ECAE              ; ApplyEspadaBuff - ESPADA (no consume stamina + ataca a 0 + cancela cooldown)
 560+ ECAE              ; ==============================================================================
 561+ ECAE              ; Duracion: ESPADA_BUFF_FRAMES (12s). Player rojo bright (color via cycler).
 562+ ECAE              ; Antagonista 'last wins' con SETA — cancela MushroomLockTimer al activarse.
 563+ ECAE              ; Gates en logic_game.asm: SelectSwordMode fuerza mode 2, stamina drain skip,
 564+ ECAE              ; AttackCooldown set skip.
 565+ ECAE              ; ==============================================================================
 566+ ECAE              ApplyEspadaBuff:
 567+ ECAE 21 2C 01         LD HL, ESPADA_BUFF_FRAMES
 568+ ECB1 22 DA 5F         LD (EspadaTimer), HL
 569+ ECB4 21 00 00         LD HL, 0
 570+ ECB7 22 E2 82         LD (MushroomLockTimer), HL          ; antagonista last wins
 571+ ECBA C9               RET
