 652+ 699E D5               PUSH DE                                 ; preservar D=charX
 653+ 699F 11 AE DB         LD DE, BgGfx_church_key
 654+ 69A2 CD B7 69         CALL FindPickupEntryByPtr               ; HL = mapX byte
 655+ 69A5 D1               POP DE
