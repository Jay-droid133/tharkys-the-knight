2589+ B07C              .eYDone:
2590+ B07C
2591+ B07C                  ; --- Animacion: seleccionar par de frames segun direccion horizontal ---
2592+ B07C                  ; DELTAX >= 0 → base+0,base+1 (derecha). DELTAX < 0 → base+2,base+3 (izquierda).
2593+ B07C DD 7E 06         LD A, (IX+ENT_DELTAX)
2594+ B07F 0E 00            LD C, ENEMY_FRAMES_RIGHT    ; C = offset de direccion (0 = derecha)
2595+ B081 CB 7F            BIT 7, A
2596+ B083 28 02            JR Z, .eAnimDir
2597+ B085 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2598+ B087              .eAnimDir:
2599+ B087 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2600+ B08A 20 27            JR NZ, .eAnimDone
2601+ B08C 3A A8 90         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2602+ B08F 47               LD B, A
2603+ B090 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2604+ B093 FE 34            CP SPRID_ENEMY_5
2605+ B095 78               LD A, B
2606+ B096 20 06            JR NZ, .eAnimDelaySet
2607+ B098 CB 3F            SRL A                               ; Rata: mitad del delay
2608+ B09A B7               OR A
2609+ B09B 20 01            JR NZ, .eAnimDelaySet
2610+ B09D 3C               INC A                               ; Minimo 1
2611+ B09E              .eAnimDelaySet:
2612+ B09E DD 77 09         LD (IX+ENT_ANIMTIMER), A
2613+ B0A1                  ; Avanzar frame dentro del par (2 frames por direccion)
2614+ B0A1 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2615+ B0A4 47               LD B, A
2616+ B0A5 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2617+ B0A8                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2618+ B0A8 E6 01            AND 1
2619+ B0AA 20 03            JR NZ, .eFrameReset
2620+ B0AC                  ; Frame 0 del par → avanzar a frame 1
2621+ B0AC 04               INC B
2622+ B0AD 18 01            JR .eFrameSet
2623+ B0AF              .eFrameReset:
2624+ B0AF                  ; Frame 1 del par → volver a frame 0
2625+ B0AF 05               DEC B
2626+ B0B0              .eFrameSet:
2627+ B0B0 DD 70 00         LD (IX+ENT_SPRITEID), B
2628+ B0B3              .eAnimDone:
2629+ B0B3                  ; Ajustar sprite al par correcto segun direccion
2630+ B0B3 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2631+ B0B6 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset actual
2632+ B0B9 E6 01            AND 1                       ; preservar frame (0 o 1) dentro del par
2633+ B0BB DD 86 08         ADD A, (IX+ENT_ANIMBASE)
2634+ B0BE 81               ADD A, C                    ; sumar offset de direccion (0 o 2)
2635+ B0BF DD 77 00         LD (IX+ENT_SPRITEID), A
