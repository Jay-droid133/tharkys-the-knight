2309+ ABB7 CD C1 AB         CALL StartWellCooldown
2310+ ABBA 21 CB FA         LD HL, SFX_WellRecover
2311+ ABBD CD 21 FA         CALL PlaySFX
2312+ ABC0              .cwNoOverlap:
2313+ ABC0 C9               RET
2314+ ABC1
2315+ ABC1              ; ==============================================================================
2316+ ABC1              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2317+ ABC1              ; ==============================================================================
2318+ ABC1              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2319+ ABC1              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2320+ ABC1              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2321+ ABC1              ; ==============================================================================
2322+ ABC1              StartWellCooldown:
2323+ ABC1 CD EE AB         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2324+ ABC4 E5               PUSH HL
2325+ ABC5 11 5D 8A         LD DE, CleanAttrMap
2326+ ABC8 19               ADD HL, DE
2327+ ABC9 7E               LD A, (HL)
2328+ ABCA 32 65 8D         LD (WellOrigAttr0), A
2329+ ABCD 23               INC HL
2330+ ABCE 7E               LD A, (HL)
2331+ ABCF 32 66 8D         LD (WellOrigAttr1), A
2332+ ABD2 E1               POP HL
2333+ ABD3 CD 08 AC         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2334+ ABD6 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2335+ ABD9 22 63 8D         LD (WellCooldownTimer), HL
2336+ ABDC C9               RET
2337+ ABDD
2338+ ABDD              ; ==============================================================================
2339+ ABDD              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2340+ ABDD              ; ==============================================================================
2341+ ABDD              ; Solo pinta blanco (no re-captura originals; los almacenados en
2342+ ABDD              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2343+ ABDD              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2344+ ABDD              ; para que el flash de cian dure lo mínimo posible.
2345+ ABDD              ; ==============================================================================
2346+ ABDD              ApplyWellCooldownIfActive:
2347+ ABDD 3A 5F 8D         LD A, (WellActive)
2348+ ABE0 B7               OR A
2349+ ABE1 C8               RET Z
2350+ ABE2 2A 63 8D         LD HL, (WellCooldownTimer)
2351+ ABE5 7C               LD A, H
2352+ ABE6 B5               OR L
2353+ ABE7 C8               RET Z
2354+ ABE8 CD EE AB         CALL GetWellBottomOffset
2355+ ABEB C3 08 AC         JP PaintWellWhiteAt
2356+ ABEE
2357+ ABEE              ; ==============================================================================
2358+ ABEE              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2359+ ABEE              ; ==============================================================================
2360+ ABEE              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2361+ ABEE              ; CleanAttrMap suma CleanAttrMap.
2362+ ABEE              ; Destruye: A, DE
2363+ ABEE              ; ==============================================================================
2364+ ABEE              GetWellBottomOffset:
2365+ ABEE 3A 61 8D         LD A, (WellPosY)
2366+ ABF1 26 00            LD H, 0
2367+ ABF3 6F               LD L, A
2368+ ABF4 29               ADD HL, HL
2369+ ABF5 29               ADD HL, HL                          ; (pixel_y/8)*32
2370+ ABF6 3A 60 8D         LD A, (WellPosX)
2371+ ABF9 0F               RRCA
2372+ ABFA 0F               RRCA
2373+ ABFB 0F               RRCA
2374+ ABFC E6 1F            AND $1F
2375+ ABFE 85               ADD A, L
2376+ ABFF 6F               LD L, A
2377+ AC00 30 01            JR NC, .gwbNoCarry
2378+ AC02 24               INC H
2379+ AC03              .gwbNoCarry:
2380+ AC03 11 20 00         LD DE, 32
2381+ AC06 19               ADD HL, DE                          ; offset fila inferior
2382+ AC07 C9               RET
2383+ AC08
2384+ AC08              ; ==============================================================================
2385+ AC08              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2386+ AC08              ; ==============================================================================
2387+ AC08              ; IN: HL = offset fila inferior (relativo a attr map)
2388+ AC08              ; ==============================================================================
2389+ AC08              PaintWellWhiteAt:
2390+ AC08 E5               PUSH HL
2391+ AC09                  ; VRAM
2392+ AC09 11 00 58         LD DE, ATTR_BASE
2393+ AC0C 19               ADD HL, DE
2394+ AC0D 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2395+ AC0F 77               LD (HL), A
2396+ AC10 23               INC HL
2397+ AC11 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2398+ AC13 77               LD (HL), A
2399+ AC14 E1               POP HL
2400+ AC15                  ; CleanAttrMap
2401+ AC15 11 5D 8A         LD DE, CleanAttrMap
2402+ AC18 19               ADD HL, DE
2403+ AC19 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2404+ AC1B 77               LD (HL), A
2405+ AC1C 23               INC HL
2406+ AC1D 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2407+ AC1F 77               LD (HL), A
2408+ AC20 C9               RET
2409+ AC21
2410+ AC21              ; ==============================================================================
2411+ AC21              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2412+ AC21              ; ==============================================================================
2413+ AC21              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2414+ AC21              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2415+ AC21              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2416+ AC21              ; ==============================================================================
2417+ AC21              UpdateWellCooldown:
2418+ AC21 2A 63 8D         LD HL, (WellCooldownTimer)
2419+ AC24 7C               LD A, H
2420+ AC25 B5               OR L
2421+ AC26 C8               RET Z                               ; 0 → nada que hacer
2422+ AC27 2B               DEC HL
2423+ AC28 22 63 8D         LD (WellCooldownTimer), HL
