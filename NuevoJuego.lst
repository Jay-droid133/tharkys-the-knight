 529+ E697              .hexToAscii:
 530+ E697 FE 0A            CP 10
 531+ E699 38 03            JR C, .isDigit
 532+ E69B C6 37            ADD A, 'A' - 10
 533+ E69D C9               RET
 534+ E69E              .isDigit:
 535+ E69E C6 30            ADD A, '0'
 536+ E6A0 C9               RET
