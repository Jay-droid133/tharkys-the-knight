2122+ F246 16 04            LD D, CHURCH_KEY_ALT2_CHAR_X
2123+ F248 3E 03            LD A, CHURCH_KEY_ALT2_CHAR_Y
2124+ F24A              .rcaPatch:
2125+ F24A 32 66 F2         LD (.rcaCharY), A
2126+ F24D C5               PUSH BC                                 ; preservar B=mapX, C=mapY
2127+ F24E D5               PUSH DE                                 ; preservar D=charX
2128+ F24F 11 9D DB         LD DE, BgGfx_church_key
2129+ F252 CD 67 F2         CALL FindPickupEntryByPtr               ; HL = mapX byte
2130+ F255 D1               POP DE
2131+ F256 C1               POP BC
2132+ F257 20 0C            JR NZ, .rcaSkip
2133+ F259 70               LD (HL), B                              ; mapX = AltN_SCREEN_X
2134+ F25A 23               INC HL
2135+ F25B 71               LD (HL), C                              ; mapY = AltN_SCREEN_Y
2136+ F25C 23               INC HL
2136+ F25D 23             INC HL
2136+ F25E 23             INC HL                ; skip ptr_lo, ptr_hi
2137+ F25F 72               LD (HL), D                              ; charX = AltN_CHAR_X
2138+ F260 23               INC HL
2139+ F261 3A 66 F2         LD A, (.rcaCharY)
2140+ F264 77               LD (HL), A                              ; charY = AltN_CHAR_Y
2141+ F265              .rcaSkip:
2142+ F265 C9               RET
2143+ F266 00           .rcaCharY: DEFB 0
