4171+ B64C              ; CountActiveNasties / CountActiveMonsters
4172+ B64C              ; ==============================================================================
4173+ B64C              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4174+ B64C              ; Ambas usan _CountSlots internamente.
4175+ B64C              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4176+ B64C              ; ==============================================================================
4177+ B64C              CountActiveNasties:
4178+ B64C 21 21 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4179+ B64F 06 03            LD B, NUM_NASTIES
4180+ B651 18 05            JR _CountSlots
4181+ B653
4182+ B653              CountActiveMonsters:
4183+ B653 21 C1 80         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4184+ B656 06 06            LD B, NUM_MONSTERS
4185+ B658
4186+ B658              _CountSlots:
4187+ B658 0E 00            LD C, 0                         ; Contador
4188+ B65A              .countLoop:
4189+ B65A 7E               LD A, (HL)
4190+ B65B B7               OR A
4191+ B65C 28 16            JR Z, .countNext                ; Slot vacio: no contar
4192+ B65E                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4193+ B65E D5               PUSH DE
4194+ B65F 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4195+ B662 19               ADD HL, DE
4196+ B663 7E               LD A, (HL)
4197+ B664 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4198+ B666 D1               POP DE
4199+ B667 FE 03            CP STATE_DYING
4200+ B669 28 09            JR Z, .countNext
4201+ B66B FE 04            CP STATE_SPAWNING
4202+ B66D 28 05            JR Z, .countNext
4203+ B66F FE 05            CP STATE_SCARED
4204+ B671 28 01            JR Z, .countNext
4205+ B673 0C               INC C
4206+ B674              .countNext:
4207+ B674 11 10 00         LD DE, ENT_SIZE
4208+ B677 19               ADD HL, DE
4209+ B678 10 E0            DJNZ .countLoop
4210+ B67A 79               LD A, C
4211+ B67B C9               RET
