 401+ A422
 402+ A422              ; ==============================================================================
 403+ A422              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 404+ A422              ; ==============================================================================
 405+ A422              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 406+ A422              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 407+ A422              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 408+ A422              ; ==============================================================================
 409+ A422              ProcessEnemies:
 410+ A422 3E 00            LD A, 0
 411+ A424 32 6D A4         LD (.peCount), A
 412+ A427 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 413+ A429
 414+ A429              .peLoop:
 415+ A429 C5               PUSH BC
 416+ A42A
 417+ A42A                  ; Calcular IX desde EnemyStepIdx
 418+ A42A 3A 89 82         LD A, (EnemyStepIdx)
 419+ A42D C6 01            ADD A, SLOT_MONSTER0
 420+ A42F 6F               LD L, A
 421+ A430 26 00            LD H, 0
 422+ A432 29               ADD HL, HL
 423+ A433 29               ADD HL, HL
 424+ A434 29               ADD HL, HL
 425+ A435 29               ADD HL, HL                          ; × ENT_SIZE (16)
 426+ A436 11 36 81         LD DE, EntityTable
 427+ A439 19               ADD HL, DE
 428+ A43A E5               PUSH HL
 429+ A43B DD E1            POP IX
 430+ A43D
 431+ A43D                  ; Avanzar indice round-robin
 432+ A43D 3A 89 82         LD A, (EnemyStepIdx)
 433+ A440 3C               INC A
 434+ A441 FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 435+ A443 38 01            JR C, .peNoWrap
 436+ A445 AF               XOR A
 437+ A446              .peNoWrap:
 438+ A446 32 89 82         LD (EnemyStepIdx), A
 439+ A449
 440+ A449                  ; Slot activo?
 441+ A449 DD 7E 01         LD A, (IX+ENT_TYPE)
 442+ A44C B7               OR A
 443+ A44D 28 16            JR Z, .peSkip
 444+ A44F
 445+ A44F                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 446+ A44F DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 447+ A453 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 448+ A454
 449+ A454                  ; Procesar esta entidad completa (erase + logic + draw)
 450+ A454 CD 6E A4         CALL ProcessOneEnemy
 451+ A457
 452+ A457                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 453+ A457 F1               POP AF
 454+ A458 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 455+ A45A
 456+ A45A                  ; Budget check
 457+ A45A 3A 6D A4         LD A, (.peCount)
 458+ A45D 3C               INC A
 459+ A45E 32 6D A4         LD (.peCount), A
 460+ A461 FE 02            CP MAX_ENEMIES_PER_FRAME
 461+ A463 30 06            JR NC, .peDone
 462+ A465
 463+ A465              .peSkip:
 464+ A465 C1               POP BC
 465+ A466 05               DEC B
 466+ A467 C2 29 A4         JP NZ, .peLoop
 467+ A46A C9               RET
 468+ A46B
 469+ A46B              .peDone:
 470+ A46B C1               POP BC
 471+ A46C C9               RET
 472+ A46D
 473+ A46D 00           .peCount: DEFB 0
 474+ A46E
 475+ A46E              ; ==============================================================================
 476+ A46E              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 477+ A46E              ; ==============================================================================
 478+ A46E              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 479+ A46E              ; ==============================================================================
 480+ A46E              ProcessOneEnemy:
 481+ A46E                  ; --- Frozen monster gate (durante muerte del player) ---
 482+ A46E                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 483+ A46E                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 484+ A46E                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 485+ A46E 3A 78 82         LD A, (MonstersFrozen)
 486+ A471 B7               OR A
 487+ A472 28 08            JR Z, .peDispatch
 488+ A474 DD 7E 01         LD A, (IX+ENT_TYPE)
 489+ A477 FE 02            CP TYPE_MONSTER
 490+ A479 CA E1 A4         JP Z, .peCalcAndDraw
 491+ A47C              .peDispatch:
 492+ A47C                  ; --- Dispatch segun estado ---
 493+ A47C DD 7E 02         LD A, (IX+ENT_STATE)
 494+ A47F FE 03            CP STATE_DYING
 495+ A481 CA F3 A6         JP Z, .peDying
 496+ A484 FE 04            CP STATE_SPAWNING
 497+ A486 CA A8 A7         JP Z, .peSpawning
 498+ A489 FE 05            CP STATE_SCARED
 499+ A48B CA D0 A5         JP Z, .peScared
 500+ A48E FE 06            CP STATE_ATTACKING
 501+ A490 CA C3 A5         JP Z, .peAttacking
 502+ A493
 503+ A493                  ; === STATE_RUNNING ===
 504+ A493                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 505+ A493 3A 75 B9         LD A, (ScareTimer)
 506+ A496 B7               OR A
 507+ A497 28 1E            JR Z, .peRunning
 508+ A499 DD 7E 01         LD A, (IX+ENT_TYPE)
 509+ A49C FE 03            CP TYPE_NASTY
 510+ A49E 28 08            JR Z, .peDoScare
 511+ A4A0 FE 02            CP TYPE_MONSTER
 512+ A4A2 20 13            JR NZ, .peRunning
 513+ A4A4                  ; Monster: limpiar stun antes de asustar
 514+ A4A4 DD 36 0A 00      LD (IX+ENT_DIR), 0
 515+ A4A8              .peDoScare:
 516+ A4A8 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 517+ A4AC DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 518+ A4B0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 519+ A4B4 C3 D0 A5         JP .peScared
 520+ A4B7              .peRunning:
 521+ A4B7 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 522+ A4BB C2 67 A5         JP NZ, .peFresh
 523+ A4BE
 524+ A4BE                  ; --- Logica: AI + movimiento + animacion ---
 525+ A4BE DD 7E 01         LD A, (IX+ENT_TYPE)
 526+ A4C1 FE 05            CP TYPE_DEATH
 527+ A4C3 28 14            JR Z, .peDeathAI
 528+ A4C5 FE 02            CP TYPE_MONSTER
 529+ A4C7 20 15            JR NZ, .peNormalAI
 530+ A4C9 AF               XOR A
 531+ A4CA 32 DE B6         LD (MonsterKbDespawn), A        ; Reset flag
 532+ A4CD CD 74 B1         CALL UpdateMonster
 533+ A4D0 3A DE B6         LD A, (MonsterKbDespawn)
 534+ A4D3 B7               OR A
 535+ A4D4 C2 CB A6         JP NZ, .peScaredDespawn         ; Knockback offscreen → borrar y despawnear
 536+ A4D7 18 08            JR .peCalcAndDraw
 537+ A4D9              .peDeathAI:
 538+ A4D9 CD 6D C8         CALL UpdateDeath
 539+ A4DC 18 03            JR .peCalcAndDraw
 540+ A4DE              .peNormalAI:
 541+ A4DE CD B3 B0         CALL UpdateEnemy
 542+ A4E1
 543+ A4E1                  ; --- Compartido: CalcDraw + skip check + erase + draw + save ---
 544+ A4E1              .peCalcAndDraw:
 545+ A4E1 CD 4B A8         CALL CalcDrawX
 546+ A4E4 CD C2 A2         CALL ComputeEnemyDrawY              ; → EnemyDrawY = POSY o POSY+1 (monster+techo)
 547+ A4E7
 548+ A4E7                  ; --- Skip si nada cambio ---
 549+ A4E7 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 550+ A4EA DD BE 0C         CP (IX+ENT_OLDX)
 551+ A4ED 20 0F            JR NZ, .peDoErase
 552+ A4EF 3A 65 82         LD A, (EnemyDrawY)
 553+ A4F2 DD BE 0D         CP (IX+ENT_OLDY)
 554+ A4F5 20 07            JR NZ, .peDoErase
 555+ A4F7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 556+ A4FA DD BE 0E         CP (IX+ENT_OLDSPRID)
 557+ A4FD C8               RET Z                               ; Nada cambio → skip todo
 558+ A4FE
 559+ A4FE              .peDoErase:
 560+ A4FE                  ; --- Erase viejo ---
 561+ A4FE CD C1 A8         CALL GetOldSpriteAddr
 562+ A501 DD 7E 0D         LD A, (IX+ENT_OLDY)
 563+ A504 57               LD D, A
 564+ A505 DD 7E 0C         LD A, (IX+ENT_OLDX)
 565+ A508 5F               LD E, A
 566+ A509 DD E5            PUSH IX
 567+ A50B DD 2A 49 A8      LD IX, (OldSprAddr)
 568+ A50F CD CE 9D         CALL DrawSprite
 569+ A512 DD E1            POP IX
 570+ A514                  ; Restaurar atributos del fondo en posicion vieja
 571+ A514 DD 56 0D         LD D, (IX+ENT_OLDY)
 572+ A517 DD 5E 0C         LD E, (IX+ENT_OLDX)
 573+ A51A CD 9A D5         CALL RestoreOldAttr
 574+ A51D                  ; --- Pintar attr nuevo ANTES de dibujar sprite (evita flash bg) ---
 575+ A51D CD 90 A8         CALL GetSpriteAddr
 576+ A520 3A 65 82         LD A, (EnemyDrawY)
 577+ A523 57               LD D, A
 578+ A524 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 579+ A527 5F               LD E, A
 580+ A528 DD E5            PUSH IX
 581+ A52A DD 2A BF A8      LD IX, (SpriteAddrTemp)
 582+ A52E CD EB 9E         CALL CalcEntityAttrSize
 583+ A531 DD E1            POP IX
 584+ A533 3A 65 82         LD A, (EnemyDrawY)
 585+ A536 57               LD D, A
 586+ A537 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 587+ A53A 5F               LD E, A
 588+ A53B DD 7E 05         LD A, (IX+ENT_ATTR)
 589+ A53E CD BE 9E         CALL SetEntityAttr
 590+ A541                  ; --- Draw sprite nuevo ---
 591+ A541 3A 65 82         LD A, (EnemyDrawY)
 592+ A544 57               LD D, A
 593+ A545 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 594+ A548 5F               LD E, A
 595+ A549 DD E5            PUSH IX
 596+ A54B DD 2A BF A8      LD IX, (SpriteAddrTemp)
 597+ A54F CD CE 9D         CALL DrawSprite
 598+ A552 DD E1            POP IX
 599+ A554
 600+ A554                  ; Guardar old = actual
 601+ A554              .peSaveOld:
 602+ A554 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 603+ A557 DD 77 0C         LD (IX+ENT_OLDX), A
 604+ A55A 3A 65 82         LD A, (EnemyDrawY)
 605+ A55D DD 77 0D         LD (IX+ENT_OLDY), A
 606+ A560 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 607+ A563 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 608+ A566 C9               RET
