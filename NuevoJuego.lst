 423  C9ED                  INCLUDE "monster_ai_bank6.asm"
# file opened: monster_ai_bank6.asm
   1+ C9ED              ; ==============================================================================
   2+ C9ED              ; MONSTER AI v2 — buffers runtime en bank 6
   3+ C9ED              ; ==============================================================================
   4+ C9ED              ; Se incluye en main.asm dentro del bloque PAGE 6, DESPUES de screen_gaps.asm.
   5+ C9ED              ; Los buffers viven en $Cxxx y se acceden paginando bank 6 al slot 3.
   6+ C9ED              ;
   7+ C9ED              ;   FlowField   — 704 B, distancia-al-player por celda (32×22 chars)
   8+ C9ED              ;                 Formato: 1 byte por celda. Valor $FF = inalcanzable.
   9+ C9ED              ;                 Offset lineal: cellY * 32 + cellX
  10+ C9ED              ;
  11+ C9ED              ;   BfsQueue    — 1408 B, FIFO para el BFS (cola de celdas a procesar)
  12+ C9ED              ;                 Cada entrada: 2 bytes = (cx, cy) con cx 0-31, cy 0-21.
  13+ C9ED              ;                 Capacidad 704 entradas = todo el grid. Suficiente en peor caso.
  14+ C9ED              ;
  15+ C9ED              ; Escritura y lectura: los clientes deben paginar bank 6 antes, repaginar bank 0
  16+ C9ED              ; despues (ver PageBankSlot3 en paging.asm).
  17+ C9ED              ; ==============================================================================
  18+ C9ED
  19+ C9ED 00 00 00...  FlowField:      DEFS 704
  20+ CCAD 00 00 00...  BfsQueue:       DEFS 1408
  21+ D22D
  22+ D22D              MonsterAiBank6End:
  23+ D22D
# file closed: monster_ai_bank6.asm
 424  D22D                  INCLUDE "sprite_data.asm"
# file opened: sprite_data.asm
   1+ D22D              ; ==============================================================================
   2+ D22D              ; DATOS DE SPRITES DEL JUGADOR (con cabecera width/height)
   3+ D22D              ; ==============================================================================
   4+ D22D              ; Formato por sprite:
   5+ D22D              ;   DEFB width_bytes   (2=16px, 3=24px)
   6+ D22D              ;   DEFB height_pixels
   7+ D22D              ;   DEFB pixel_data... (width * height bytes)
   8+ D22D              ;
   9+ D22D              ; Organizacion:
  10+ D22D              ;   SpriteID 0-1:   Idle (2 frames)
  11+ D22D              ;   SpriteID 2-5:   Walk East (4 frames: 0,1,2,1)
  12+ D22D              ;   SpriteID 5-8:   Walk West (4 frames: 0,1,2,1)
  13+ D22D              ;   SpriteID 8-10:  Walk North (3 frames)
  14+ D22D              ;   SpriteID 11-13: Walk South (3 frames)
  15+ D22D              ;   SpriteID 14-15: Fight East (2 frames)
  16+ D22D              ;   SpriteID 16-17: Fight West (2 frames)
  17+ D22D              ; ==============================================================================
  18+ D22D
