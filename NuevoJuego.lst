 189+ 60B1              ; ==============================================================================
 190+ 60B1              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 60B1              ; ==============================================================================
 192+ 60B1              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 60B1              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 60B1              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 60B1              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 60B1              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 60B1              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 60B1              ; Destruye: AF, BC, DE, HL, IX.
 199+ 60B1              ; ==============================================================================
 200+ 60B1              StartTownGateCutscene:
 201+ 60B1 AF               XOR A
 202+ 60B2 32 5E 82         LD (CurrentKey), A
 203+ 60B5 CD AE 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 60B8 CD 47 BD         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 60BB CD CC 60         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 60BE CD 30 66         CALL SFX_TownGate_OnStart
 207+ 60C1 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 60C3 32 74 82         LD (TownGatePhase), A
 209+ 60C6 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ 60C8 32 A5 5F         LD (TownGateTimer), A
 211+ 60CB C9               RET
 212+ 60CC
 213+ 60CC              ; ==============================================================================
 214+ 60CC              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
 215+ 60CC              ; ==============================================================================
 216+ 60CC              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING
 217+ 60CC              ; con SPRID_PUFF. ProcessDeath → ProcessOneEnemy.peDying anima puff cada
 218+ 60CC              ; frame en WAIT_NASTIES (igual que nasties). Al terminar puff,
 219+ 60CC              ; UpdateDying pone TYPE_NONE y la check dinamica de WAIT_NASTIES sigue.
 220+ 60CC              ; (DeathSpawned se queda a 1 pero es inocuo: ProcessDeath ya retorna
 221+ 60CC              ; cuando ENT_TYPE=0, y no hay respawn durante cutscene.)
 222+ 60CC              ; ==============================================================================
 223+ 60CC              KillDeathIfActive:
 224+ 60CC DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
 225+ 60D0 DD 7E 01         LD A, (IX+ENT_TYPE)
 226+ 60D3 B7               OR A
 227+ 60D4 C8               RET Z                               ; muerte ya inactiva
 228+ 60D5 DD 7E 02         LD A, (IX+ENT_STATE)
 229+ 60D8 FE 03            CP STATE_DYING
 230+ 60DA C8               RET Z                               ; ya muriendo
 231+ 60DB DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
 232+ 60DF DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
 233+ 60E3 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
 234+ 60E7 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
 235+ 60EB DD 36 06 00      LD (IX+ENT_DELTAX), 0
 236+ 60EF DD 36 07 00      LD (IX+ENT_DELTAY), 0
 237+ 60F3 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
 238+ 60F7                  ; Death se va con puff -> parar musica de la muerte. Tail-call al sentinel
 239+ 60F7                  ; STOP del dispatcher (mute R9 + clear timer + clear loop/speed flags).
 240+ 60F7 3E FF            LD A, $FF
 241+ 60F9 C3 05 9D         JP StartMusic
 242+ 60FC
 243+ 60FC              ; ==============================================================================
