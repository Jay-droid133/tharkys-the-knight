 753+ E76B                  ; Atributos del indicador (bright white on black)
 754+ E76B 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 755+ E76E 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 756+ E770 77               LD (HL), A
