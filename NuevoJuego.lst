 959+ 6535              ; ==============================================================================
 960+ 6535              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 961+ 6535              ; ==============================================================================
 962+ 6535              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 963+ 6535              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 964+ 6535              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 965+ 6535              ; visualmente la mitad inferior del player desaparece tras la HUD.
 966+ 6535              ; ==============================================================================
 967+ 6535              TownGateExitStep:
 968+ 6535 3A A8 5F         LD A, (TownGateExitStepCnt)
 969+ 6538 3C               INC A
 970+ 6539 32 A8 5F         LD (TownGateExitStepCnt), A
 971+ 653C FE 02            CP TGCS_T_EXIT_STEP
 972+ 653E D8               RET C                               ; aun no toca step
 973+ 653F AF               XOR A
 974+ 6540 32 A8 5F         LD (TownGateExitStepCnt), A
 975+ 6543                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
 976+ 6543 DD 21 C7 80      LD IX, EntityTable
 977+ 6547 DD 7E 04         LD A, (IX+ENT_POSY)
 978+ 654A 3C               INC A
 979+ 654B DD 77 04         LD (IX+ENT_POSY), A
 980+ 654E 32 F5 81         LD (PlayerDrawY), A
 981+ 6551 3A A9 5F         LD A, (TownGateExitWalkFrame)
 982+ 6554 EE 01            XOR 1                               ; toggle 0/1
 983+ 6556 32 A9 5F         LD (TownGateExitWalkFrame), A
 984+ 6559 47               LD B, A
 985+ 655A 3E 0E            LD A, SPRID_WALK_S
 986+ 655C 80               ADD A, B
 987+ 655D DD 77 00         LD (IX+ENT_SPRITEID), A
 988+ 6560                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
 989+ 6560                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
 990+ 6560                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
 991+ 6560                  ; part1 attrs ni de door attrs.
 992+ 6560 CD D2 63         CALL TownGatePlayerSlideErase
 993+ 6563 C3 08 64         JP TownGatePlayerSlideDraw          ; tail call
 994+ 6566
 995+ 6566              ; ==============================================================================
 996+ 6566              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
 997+ 6566              ; ==============================================================================
 998+ 6566              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
 999+ 6566              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1000+ 6566              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1001+ 6566              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1002+ 6566              ; Destruye: AF, BC, DE, HL, IX.
1003+ 6566              ; ==============================================================================
1004+ 6566              TownGateDrawTheEnd:
1005+ 6566 21 3E E6         LD HL, BgGfx_the_end
1006+ 6569 3E 03            LD A, 3
1007+ 656B CD BD 90         CALL LoadBgSpriteToBuffer
1008+ 656E DD 21 F5 88      LD IX, BgSpriteBuffer
1009+ 6572 06 0B            LD B, TGCS_END_CHARX
1010+ 6574 0E 04            LD C, TGCS_END_CHARY
1011+ 6576 AF               XOR A
1012+ 6577 32 74 DD         LD (BgSpriteIsHouse), A
1013+ 657A 32 85 CE         LD (CurrentTintVar), A              ; sin tint
1014+ 657D C3 7B CD         JP DrawBgGfxSprite
1015+ 6580
1016+ 6580              ; ==============================================================================
1017+ 6580              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1018+ 6580              ; ==============================================================================
1019+ 6580              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1020+ 6580              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1021+ 6580              ; quedara visible sobre fondo negro.
1022+ 6580              ; ==============================================================================
1023+ 6580              TownGateWipeBlack:
1024+ 6580 21 00 40         LD HL, $4000
1025+ 6583 11 01 40         LD DE, $4001
1026+ 6586 01 FF 17         LD BC, $17FF
1027+ 6589 36 00            LD (HL), 0
1028+ 658B ED B0            LDIR
1029+ 658D 21 00 58         LD HL, $5800
1030+ 6590 11 01 58         LD DE, $5801
1031+ 6593 01 FF 02         LD BC, $02FF
1032+ 6596 36 00            LD (HL), $00                        ; ink black, paper black
1033+ 6598 ED B0            LDIR
1034+ 659A C9               RET
1035+ 659B
1036+ 659B              ; ==============================================================================
1037+ 659B              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1038+ 659B              ; ==============================================================================
1039+ 659B              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1040+ 659B              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1041+ 659B              ; (white ink, black paper, bright) para todo el area de texto.
1042+ 659B              ; ==============================================================================
1043+ 659B              TownGateDrawCredits:
1044+ 659B                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1045+ 659B 21 00 58         LD HL, $5800
1046+ 659E 11 01 58         LD DE, $5801
1047+ 65A1 01 FF 02         LD BC, $02FF
1048+ 65A4 36 47            LD (HL), $47
1049+ 65A6 ED B0            LDIR
1050+ 65A8                  ; Iterar credits
1051+ 65A8 21 F8 65         LD HL, TownGateCreditsData
1052+ 65AB              .tgdcLoop:
1053+ 65AB 7E               LD A, (HL)
1054+ 65AC FE FF            CP $FF
1055+ 65AE C8               RET Z
1056+ 65AF 57               LD D, A                             ; D = row
1057+ 65B0 23               INC HL
1058+ 65B1 7E               LD A, (HL)
1059+ 65B2 5F               LD E, A                             ; E = col
1060+ 65B3 23               INC HL                              ; HL → string
1061+ 65B4 CD B9 65         CALL PrintStringFontAt
1062+ 65B7 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1063+ 65B9
1064+ 65B9              ; ==============================================================================
1065+ 65B9              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1066+ 65B9              ; ==============================================================================
1067+ 65B9              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1068+ 65B9              ; siguiente byte tras el 0 (para que el caller siga iterando).
1069+ 65B9              ; Destruye: AF, BC, DE, HL.
1070+ 65B9              ; OUT: HL apunta al byte tras el 0 terminador.
1071+ 65B9              ; ==============================================================================
1072+ 65B9              PrintStringFontAt:
1073+ 65B9              .psfaCharLoop:
1074+ 65B9 7E               LD A, (HL)
1075+ 65BA 23               INC HL
1076+ 65BB B7               OR A
1077+ 65BC C8               RET Z                               ; fin de string
1078+ 65BD E5               PUSH HL
1079+ 65BE D5               PUSH DE
1080+ 65BF CD C7 65         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1081+ 65C2 D1               POP DE
1082+ 65C3 E1               POP HL
1083+ 65C4 1C               INC E                               ; siguiente columna
1084+ 65C5 18 F2            JR .psfaCharLoop
1085+ 65C7
1086+ 65C7              ; ==============================================================================
1087+ 65C7              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1088+ 65C7              ; ==============================================================================
1089+ 65C7              ; D = row (0..23), E = col (0..31), A = ASCII char.
1090+ 65C7              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1091+ 65C7              ;   y = row * 8, x = col * 8
1092+ 65C7              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1093+ 65C7              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1094+ 65C7              ; Destruye: AF, BC, DE, HL.
1095+ 65C7              ; ==============================================================================
1096+ 65C7              DrawCharFontAt:
1097+ 65C7 D5               PUSH DE
1098+ 65C8                  ; HL = $3C00 + char * 8
1099+ 65C8 6F               LD L, A
1100+ 65C9 26 00            LD H, 0
1101+ 65CB 29               ADD HL, HL
1102+ 65CC 29               ADD HL, HL
1103+ 65CD 29               ADD HL, HL
1104+ 65CE 01 00 3C         LD BC, $3C00
1105+ 65D1 09               ADD HL, BC
1106+ 65D2 D1               POP DE
1107+ 65D3                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1108+ 65D3 E5               PUSH HL                             ; save font ptr
1109+ 65D4 7A               LD A, D
1110+ 65D5 87               ADD A, A
1111+ 65D6 87               ADD A, A
1112+ 65D7 87               ADD A, A                            ; A = row * 8 = pixel Y
1113+ 65D8 57               LD D, A
1114+ 65D9 7B               LD A, E
1115+ 65DA 87               ADD A, A
1116+ 65DB 87               ADD A, A
1117+ 65DC 87               ADD A, A                            ; A = col * 8 = pixel X
1118+ 65DD 5F               LD E, A
1119+ 65DE CD 1C A1         CALL CalcPixelAddr                  ; HL = VRAM addr
1120+ 65E1 EB               EX DE, HL                           ; DE = VRAM addr
1121+ 65E2 E1               POP HL                              ; HL = font ptr
1122+ 65E3 06 08            LD B, 8
1123+ 65E5              .dcfaLoop:
1124+ 65E5 7E               LD A, (HL)
1125+ 65E6 12               LD (DE), A
1126+ 65E7 23               INC HL
