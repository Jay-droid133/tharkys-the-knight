2321+ AEE2              ; ==============================================================================
2322+ AEE2              ; UpdatePredatorAttack - Movimiento recto del nasty depredador
2323+ AEE2              ; ==============================================================================
2324+ AEE2              ; IX = nasty en STATE_ATTACKING. Se mueve recto a PREDATOR_SPEED.
2325+ AEE2              ; Si choca con pared/borde, vuelve a STATE_RUNNING con velocidad normal.
2326+ AEE2              ; ==============================================================================
2327+ AEE2              UpdatePredatorAttack:
2328+ AEE2                  ; Guardar posicion para revert
2329+ AEE2 DD 7E 03         LD A, (IX+ENT_POSX)
2330+ AEE5 32 71 AF         LD (.paOldX), A
2331+ AEE8 DD 7E 04         LD A, (IX+ENT_POSY)
2332+ AEEB 32 72 AF         LD (.paOldY), A
2333+ AEEE
2334+ AEEE                  ; Aplicar movimiento X
2335+ AEEE DD 7E 03         LD A, (IX+ENT_POSX)
2336+ AEF1 DD 86 06         ADD A, (IX+ENT_DELTAX)
2337+ AEF4 FE E8            CP SCREEN_MAX_X
2338+ AEF6 30 3C            JR NC, .paRevert                    ; Fuera de rango X
2339+ AEF8 FE 01            CP 1
2340+ AEFA 38 38            JR C, .paRevert
2341+ AEFC DD 77 03         LD (IX+ENT_POSX), A
2342+ AEFF
2343+ AEFF                  ; Aplicar movimiento Y
2344+ AEFF DD 7E 04         LD A, (IX+ENT_POSY)
2345+ AF02 DD 86 07         ADD A, (IX+ENT_DELTAY)
2346+ AF05 FE A8            CP SCREEN_MAX_Y
2347+ AF07 30 2B            JR NC, .paRevert                    ; Fuera de rango Y
2348+ AF09 FE 10            CP SCREEN_MIN_Y
2349+ AF0B 38 27            JR C, .paRevert
2350+ AF0D DD 77 04         LD (IX+ENT_POSY), A
2351+ AF10
2352+ AF10                  ; Comprobar colision con fondo
2353+ AF10 CD 04 B9         CALL CheckEnemyCollision
2354+ AF13 20 1F            JR NZ, .paRevert                    ; Choco con pared
2355+ AF15
2356+ AF15                  ; --- Animacion durante ataque ---
2357+ AF15 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2358+ AF18 20 19            JR NZ, .paAnimDone
2359+ AF1A 3E 04            LD A, 4                             ; Delay fijo rapido durante ataque
2360+ AF1C DD 77 09         LD (IX+ENT_ANIMTIMER), A
2361+ AF1F DD 7E 00         LD A, (IX+ENT_SPRITEID)
2362+ AF22 DD 96 08         SUB (IX+ENT_ANIMBASE)
2363+ AF25 E6 01            AND 1
2364+ AF27 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2365+ AF2A 20 03            JR NZ, .paFrame1
2366+ AF2C 3C               INC A                               ; Frame 0 → 1
2367+ AF2D 18 01            JR .paFrameSet
2368+ AF2F              .paFrame1:
