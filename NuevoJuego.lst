 672+ FB1D 3E 0F            LD A, BCP_PLAYER_TURN_CAM
 673+ FB1F 32 C9 82         LD (BankCutscenePhase), A
 674+ FB22 C9               RET
 675+ FB23
 676+ FB23              ; ---- Phase 15: player mirando camara antes de devolver control ----
 677+ FB23              .bcPhPlayerTurnCam:
 678+ FB23 CD C9 FB         CALL BankCutsceneDecTimer
 679+ FB26 C0               RET NZ
 680+ FB27                  ; Setear DONE → siguiente UpdateBankCutscene cae al fallthrough y pone IDLE.
 681+ FB27 3E 10            LD A, BCP_DONE
 682+ FB29 32 C9 82         LD (BankCutscenePhase), A
