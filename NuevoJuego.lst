 190+ 9A9A              .shiftedLine:
 191+ 9A9A E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9A9B 3A BB 9A         LD A, (.widthSave)
 193+ 9A9E DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9AA0
 195+ 9AA0              .shiftedByte:
 196+ 9AA0                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AA0 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AA1 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AA2 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AA3 AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AA4 77               LD (HL), A                  ; Escribir
 202+ 9AA5 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AA6 04               INC B                       ; Pagina overflow
 204+ 9AA7 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AA8 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AA9 77               LD (HL), A                  ; Escribir
 207+ 9AAA 05               DEC B                       ; Restaurar pagina high
 208+ 9AAB 13               INC DE                      ; Siguiente byte de sprite
 209+ 9AAC                  ; Siguiente byte de ancho
 210+ 9AAC DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9AAE 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9AB0
 213+ 9AB0 E1               POP HL                      ; Restaurar inicio de linea
 214+ 9AB1 DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9AB3 C8               RET Z                       ; Terminamos todas las lineas
 216+ 9AB4 CD BF 9A         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9AB7 18 E1            JR .shiftedLine
