2450+ D8FD                  ; ext_right: sprite_right + 4 con clamp superior
2451+ D8FD 3A FC D9         LD A, (.cbtSpW)
2452+ D900 47               LD B, A
2453+ D901 3A FA D9         LD A, (.cbtSpX)
2454+ D904 80               ADD A, B                        ; sprite_right
2455+ D905 C6 04            ADD A, 4                        ; +4
2456+ D907 30 02            JR NC, .cbtNoOverflowR
2457+ D909 3E FF            LD A, $FF
2458+ D90B              .cbtNoOverflowR:
2459+ D90B B9               CP C
2460+ D90C DA E4 D9         JP C, .cbtPopNext               ; ext_right < player_left → fuera por la derecha
