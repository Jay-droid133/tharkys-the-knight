1197+ EFE4 80               ADD A, B                            ; pk_right
1198+ EFE5 47               LD B, A
1199+ EFE6 3A DA EF         LD A, (.crsPlX+1)
1200+ EFE9 B8               CP B
1201+ EFEA D0               RET NC                              ; player_left >= pk_right -> miss
1202+ EFEB
1203+ EFEB 3A A7 81         LD A, (EntityTable + ENT_POSY)
1204+ EFEE 32 F2 EF         LD (.crsPlY+1), A
1205+ EFF1              .crsPlY:
1206+ EFF1 3E 00            LD A, 0                             ; player_top
1207+ EFF3 C6 15            ADD A, 21                           ; player_bottom (player es 21 alto)
1208+ EFF5              .crsPkTop:
1209+ EFF5 06 00            LD B, 0
1210+ EFF7 B8               CP B
1211+ EFF8 D8               RET C
1212+ EFF9 C8               RET Z
