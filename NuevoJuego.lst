 240+ EB5A                  ; Lookup nuevo tipo, cargar sprite, extraer attr
 241+ EB5A CD B3 EA         CALL GetRoulettePtrByIdx                ; HL = nuevo ptr
 242+ EB5D CD DD EA         CALL LoadSynthSpriteAndExtractAttr
 243+ EB60
 244+ EB60                  ; Dibujar sprite nuevo
 245+ EB60 3A B8 5F         LD A, (RandomSynthCharX)
 246+ EB63 47               LD B, A
