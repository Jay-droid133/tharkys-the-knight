 493+ A0A4              ; ==============================================================================
 494+ A0A4              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 495+ A0A4              ; ==============================================================================
 496+ A0A4              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 497+ A0A4              ; ==============================================================================
 498+ A0A4              ProcessOneEnemy:
 499+ A0A4                  ; --- Frozen monster gate (durante muerte del player) ---
 500+ A0A4                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 501+ A0A4                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 502+ A0A4                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 503+ A0A4 3A F3 82         LD A, (MonstersFrozen)
 504+ A0A7 B7               OR A
 505+ A0A8 28 08            JR Z, .peDispatch
 506+ A0AA DD 7E 01         LD A, (IX+ENT_TYPE)
 507+ A0AD FE 02            CP TYPE_MONSTER
 508+ A0AF CA 17 A1         JP Z, .peCalcAndDraw
 509+ A0B2              .peDispatch:
 510+ A0B2                  ; --- Dispatch segun estado ---
 511+ A0B2 DD 7E 02         LD A, (IX+ENT_STATE)
 512+ A0B5 FE 03            CP STATE_DYING
 513+ A0B7 CA 29 A3         JP Z, .peDying
 514+ A0BA FE 04            CP STATE_SPAWNING
 515+ A0BC CA DE A3         JP Z, .peSpawning
 516+ A0BF FE 05            CP STATE_SCARED
 517+ A0C1 CA 06 A2         JP Z, .peScared
 518+ A0C4 FE 06            CP STATE_ATTACKING
 519+ A0C6 CA F9 A1         JP Z, .peAttacking
 520+ A0C9
 521+ A0C9                  ; === STATE_RUNNING ===
 522+ A0C9                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 523+ A0C9 3A AB B5         LD A, (ScareTimer)
 524+ A0CC B7               OR A
 525+ A0CD 28 1E            JR Z, .peRunning
 526+ A0CF DD 7E 01         LD A, (IX+ENT_TYPE)
 527+ A0D2 FE 03            CP TYPE_NASTY
 528+ A0D4 28 08            JR Z, .peDoScare
 529+ A0D6 FE 02            CP TYPE_MONSTER
 530+ A0D8 20 13            JR NZ, .peRunning
