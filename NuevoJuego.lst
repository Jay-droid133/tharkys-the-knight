  19+ 8D8F              ; MaiComputeFlowField
  20+ 8D8F              ; ==============================================================================
  21+ 8D8F              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 8D8F              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 8D8F              ; quedan en $FF).
  24+ 8D8F              ;
  25+ 8D8F              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 8D8F              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 8D8F              ;
  28+ 8D8F              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 8D8F              ; Output: FlowField relleno en bank 6
  30+ 8D8F              ; Destruye: AF, BC, DE, HL
  31+ 8D8F              ; ==============================================================================
  32+ 8D8F              MaiComputeFlowField:
  33+ 8D8F                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 8D8F 3A 97 81         LD A, (EntityTable + ENT_POSX)
  35+ 8D92 0F               RRCA
  36+ 8D93 0F               RRCA
  37+ 8D94 0F               RRCA
  38+ 8D95 E6 1F            AND $1F
  39+ 8D97 32 AA 97         LD (MaiFlowPlCx), A
  40+ 8D9A
