  4+  8034
  5+  8034 00           GameFrameCounter:   DEFB 0      ; Contador que incrementa cada frame (0-255)
  6+  8035 00           GameState:          DEFB 0      ; Estado: 0=Menu, 1=InGame, 2=GameOver
  7+  8036
  8+  8036              ; ==============================================================================
  9+  8036              ; TABLA DE ENTIDADES (estilo Sabre Wulf)
 10+  8036              ; ==============================================================================
 11+  8036              ; 17 slots × 12 bytes = 204 bytes.
 12+  8036              ; Slot 0: Player. Slots 1-6: Inmortales. Slots 7-12: Nasties. 13-16: Objetos.
 13+  8036              ; Cada entidad: SpriteID, Type, State, PosX, PosY, Attr, DeltaX, DeltaY,
 14+  8036              ;               AnimBase, AnimTimer, Dir, Flags
 15+  8036              ; ==============================================================================
 16+  8036 00 00 00...  EntityTable:        DEFS NUM_ENTITIES * ENT_SIZE
 17+  8102
 18+  8102              ; --- Input crudo ---
 19+  8102 00           InputDirection:     DEFB 0      ; Direccion leida del teclado este frame
 20+  8103 00           InputFire:          DEFB 0      ; Fuego leido del teclado este frame
 21+  8104
 22+  8104              ; ==============================================================================
 23+  8104              ; SISTEMA DE PANTALLAS
 24+  8104              ; ==============================================================================
 25+  8104
 26+  8104              ; --- Posicion actual en el mapa de pantallas (grid 16x16) ---
 27+  8104 08           CurrentScreenX:     DEFB START_SCREEN_X  ; Columna actual (0-15)
 28+  8105 08           CurrentScreenY:     DEFB START_SCREEN_Y  ; Fila actual (0-15)
 29+  8106
 30+  8106              ; --- Puntero a los datos de la pantalla actual ---
 31+  8106 00 00        CurrentScreenAddr:  DEFW 0      ; Direccion en memoria de los datos de la pantalla actual
 32+  8108
 33+  8108              ; --- Flag de transicion ---
 34+  8108 00           ScreenTransition:   DEFB 0      ; 0=sin transicion, 1=N, 2=S, 4=E, 8=W
 35+  8109
 36+  8109              ; --- Flag de redibujado ---
 37+  8109 01           ScreenDirty:        DEFB 1      ; 1=hay que redibujar la pantalla completa
 38+  810A
