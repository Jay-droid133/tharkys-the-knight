  55+ 916D F5               PUSH AF                         ; push en stack temporal (bank 2, OK)
  56+ 916E F3               DI
  57+ 916F 3A FB 8F         LD A, (CurrentPaging)
  58+ 9172 E6 F8            AND $F8
  59+ 9174 F6 06            OR 6
  60+ 9176 32 FB 8F         LD (CurrentPaging), A
  61+ 9179 01 FD 7F         LD BC, $7FFD
  62+ 917C ED 79            OUT (C), A
  63+ 917E
  64+ 917E                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  65+ 917E CD 98 91         CALL MaiFlowBfs
  66+ 9181
  67+ 9181                  ; --- Cerrar ventana: repaginar bank 0 ---
  68+ 9181 3A FB 8F         LD A, (CurrentPaging)
  69+ 9184 E6 F8            AND $F8
  70+ 9186 32 FB 8F         LD (CurrentPaging), A
  71+ 9189 01 FD 7F         LD BC, $7FFD
  72+ 918C ED 79            OUT (C), A
  73+ 918E
