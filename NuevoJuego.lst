2205+ DA9A              RedrawPickupByPtr:
2206+ DA9A 21 AF E1         LD HL, PickupTable
2207+ DA9D              .rpbpLoop:
2208+ DA9D 7E               LD A, (HL)
2209+ DA9E FE FF            CP $FF
2210+ DAA0 C8               RET Z                       ; fin de tabla, no encontrado
2211+ DAA1 FE FE            CP $FE
2212+ DAA3 28 41            JR Z, .rpbpSkipInactive
2213+ DAA5 47               LD B, A                     ; mapX
2214+ DAA6 23               INC HL
2215+ DAA7 3A AE 82         LD A, (CurrentScreenX)
2216+ DAAA B8               CP B
2217+ DAAB 20 3F            JR NZ, .rpbpSkipMapY
2218+ DAAD 4E               LD C, (HL)                  ; mapY
