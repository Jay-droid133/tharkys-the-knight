 178+ A1F7              ; ==============================================================================
 179+ A1F7              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ A1F7              ; ==============================================================================
 181+ A1F7              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ A1F7              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ A1F7              ; que los pies parezcan hundirse en el suelo.
 184+ A1F7              ; ==============================================================================
 185+ A1F7              ComputePlayerDrawY:
 186+ A1F7 3A 42 81         LD A, (EntityTable + ENT_POSX)
 187+ A1FA C6 08            ADD A, 8                    ; center X del player
 188+ A1FC 47               LD B, A
 189+ A1FD 3A 43 81         LD A, (EntityTable + ENT_POSY)
 190+ A200 4F               LD C, A
 191+ A201 32 6E 82         LD (PlayerDrawY), A         ; default: sin offset
 192+ A204 B7               OR A
 193+ A205 C8               RET Z
 194+ A206 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ A207 CD B5 D7         CALL IsPointBlocked
 196+ A20A C8               RET Z                       ; libre → sin offset
 197+ A20B 3A 43 81         LD A, (EntityTable + ENT_POSY)
 198+ A20E 3C               INC A
 199+ A20F 32 6E 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ A212 C9               RET
