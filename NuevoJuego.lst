 584+ F1F1                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F1F1                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F1F1                  ; Sprite_Compass_Magic / Sprite_Compass_MagicLasting (no oscilan); el wobble
 587+ F1F1                  ; logic solo gastaría CPU durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F1F1                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F1F1                  ; cuando el frame de transición está apretado.
 590+ F1F1 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F1F4 47               LD B, A
 592+ F1F5 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F1F8 B0               OR B
 594+ F1F9 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F1FB AF               XOR A
 596+ F1FC 32 C5 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F1FF 18 53            JR .dcWobbleEnd
 598+ F201              .dcWobbleStartNormal:
 599+ F201                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F201                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F201                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F201                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F201                  ; nuevo idx.
 604+ F201                  ; Counter == 0 -> sin override, idx = target.
 605+ F201 3A F5 F2         LD A, (.dcSpriteIdx)
 606+ F204 FE 04            CP 4
 607+ F206 20 06            JR NZ, .dcWobbleNotX
 608+ F208                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F208                  ; frame no redibuje innecesariamente.
 610+ F208 AF               XOR A
 611+ F209 32 C5 82         LD (CompassWobbleCounter), A
 612+ F20C 18 46            JR .dcWobbleEnd
 613+ F20E              .dcWobbleNotX:
 614+ F20E                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F20E 3A 10 83         LD A, (CurrentScreenX)
 616+ F211 47               LD B, A
 617+ F212 3A C3 82         LD A, (LastCompassScreenX)
 618+ F215 B8               CP B
 619+ F216 20 0A            JR NZ, .dcWobbleStart
 620+ F218 3A 11 83         LD A, (CurrentScreenY)
 621+ F21B 47               LD B, A
 622+ F21C 3A C4 82         LD A, (LastCompassScreenY)
 623+ F21F B8               CP B
 624+ F220 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F222              .dcWobbleStart:
 626+ F222 3E 09            LD A, 9
 627+ F224 32 C5 82         LD (CompassWobbleCounter), A
 628+ F227              .dcWobbleResolve:
 629+ F227 3A C5 82         LD A, (CompassWobbleCounter)
 630+ F22A B7               OR A
 631+ F22B 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F22D 3D               DEC A
 633+ F22E 32 C5 82         LD (CompassWobbleCounter), A
 634+ F231                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F231 21 56 F7         LD HL, WobblePhaseTable
 636+ F234 5F               LD E, A
 637+ F235 16 00            LD D, 0
 638+ F237 19               ADD HL, DE
 639+ F238 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F239 FE 02            CP 2
 641+ F23B 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F23D                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F23D                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F23D FE 03            CP 3
 645+ F23F 38 01            JR C, .dcWobbleOffsetReady
 646+ F241 3D               DEC A
 647+ F242              .dcWobbleOffsetReady:
 648+ F242 5F               LD E, A
 649+ F243 3A F5 F2         LD A, (.dcSpriteIdx)
 650+ F246 87               ADD A, A                            ; idx*2
 651+ F247 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F248 83               ADD A, E                            ; +offset
 653+ F249 21 32 F7         LD HL, CompassWobbleTable
 654+ F24C 5F               LD E, A
 655+ F24D 16 00            LD D, 0
 656+ F24F 19               ADD HL, DE
 657+ F250 7E               LD A, (HL)
 658+ F251 32 F5 F2         LD (.dcSpriteIdx), A                ; override
 659+ F254
 660+ F254              .dcWobbleEnd:
 661+ F254
 662+ F254                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F254                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F254                  ; sin bright + char activo white bright; en warning el char activo
 665+ F254                  ; parpadea bright on/off a ~6 Hz).
 666+ F254                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F254                  ; blanca se mantiene tal cual.
 668+ F254 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F257 47               LD B, A
 670+ F258 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F25B B0               OR B
 672+ F25C 28 3E            JR Z, .dcMagicOff
 673+ F25E 3A F5 F2         LD A, (.dcSpriteIdx)
 674+ F261 FE 04            CP 4
 675+ F263 28 37            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F265 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F268 FE FF            CP $FF
 678+ F26A 28 30            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F26C                  ; --- MAGIC HUD ---
 680+ F26C                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F26C                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F26C                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F26C                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F26C                  ;
 685+ F26C                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F26C                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F26C                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F26C                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F26C                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F26C                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F26C                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F26C 3A CD 82         LD A, (MagicCompassPermanent)
 693+ F26F B7               OR A
 694+ F270 28 11            JR Z, .dcMagicTemp
 695+ F272                  ; --- Lasting (permanente, post-iglesia) ---
 696+ F272 3A C1 5F         LD A, (MagicCompassPathDir)
 697+ F275 F6 80            OR $80                              ; bit 7 = 1 (lasting)
 698+ F277 47               LD B, A
 699+ F278 3A CC 5F         LD A, (LastMagicCompassDrawn)
 700+ F27B B8               CP B
 701+ F27C 28 19            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 702+ F27E 11 3B 6F         LD DE, Sprite_Compass_MagicLasting
 703+ F281 18 0D            JR .dcMagicDraw
 704+ F283              .dcMagicTemp:
 705+ F283 3A C1 5F         LD A, (MagicCompassPathDir)         ; bit 7 ya 0 (PathDir 0..3)
 706+ F286 47               LD B, A
 707+ F287 3A CC 5F         LD A, (LastMagicCompassDrawn)
 708+ F28A B8               CP B
 709+ F28B 28 0A            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 710+ F28D 11 17 6F         LD DE, Sprite_Compass_Magic
 711+ F290              .dcMagicDraw:
 712+ F290                  ; Almacenar cache key ANTES del CALL (DrawCompassSprite destruye B usándolo
 713+ F290                  ; como contador de filas). Semánticamente equivalente: el call no falla.
 714+ F290 78               LD A, B
 715+ F291 32 CC 5F         LD (LastMagicCompassDrawn), A
 716+ F294 CD F8 F2         CALL DrawCompassSprite
 717+ F297              .dcMagicAttrsOnly:
 718+ F297 CD D0 6E         CALL PaintMagicCompassAttrs
 719+ F29A 18 40            JR .dcDrawDone
 720+ F29C
 721+ F29C              .dcMagicOff:
 722+ F29C                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 723+ F29C                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 724+ F29C 3E FF            LD A, $FF
 725+ F29E 32 CC 5F         LD (LastMagicCompassDrawn), A
 726+ F2A1
 727+ F2A1                  ; --- Color normal ---
 728+ F2A1                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 729+ F2A1 3A F5 F2         LD A, (.dcSpriteIdx)
 730+ F2A4 FE 04            CP 4
 731+ F2A6 28 18            JR Z, .dcWhite
 732+ F2A8 3A C2 82         LD A, (PreviousObjectiveDistance)
 733+ F2AB FE FF            CP $FF
 734+ F2AD 28 11            JR Z, .dcWhite
 735+ F2AF 47               LD B, A
 736+ F2B0 3A F6 F2         LD A, (.dcDistance)
 737+ F2B3 B8               CP B
 738+ F2B4 28 0A            JR Z, .dcWhite                      ; igual = blanco
 739+ F2B6 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 740+ F2B8 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 741+ F2BA 18 06            JR .dcColorDone
 742+ F2BC              .dcGreen:
 743+ F2BC 3E 44            LD A, GREEN | $40
 744+ F2BE 18 02            JR .dcColorDone
 745+ F2C0              .dcWhite:
 746+ F2C0 3E 47            LD A, WHITE | $40
 747+ F2C2              .dcColorDone:
 748+ F2C2 32 F7 F2         LD (.dcAttr), A
 749+ F2C5
 750+ F2C5                  ; --- Sprite ptr de CompassSprites[idx] ---
 751+ F2C5 3A F5 F2         LD A, (.dcSpriteIdx)
 752+ F2C8 87               ADD A, A                            ; *2
 753+ F2C9 6F               LD L, A
 754+ F2CA 26 00            LD H, 0
 755+ F2CC 11 20 F7         LD DE, CompassSprites
 756+ F2CF 19               ADD HL, DE
 757+ F2D0 5E               LD E, (HL)
 758+ F2D1 23               INC HL
 759+ F2D2 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 760+ F2D3 CD F8 F2         CALL DrawCompassSprite
 761+ F2D6
 762+ F2D6                  ; --- Attrs ---
 763+ F2D6 3A F7 F2         LD A, (.dcAttr)
 764+ F2D9 CD 1B F3         CALL SetCompassAttrs
 765+ F2DC
 766+ F2DC              .dcDrawDone:
 767+ F2DC
 768+ F2DC                  ; --- Cachear estado ---
 769+ F2DC                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 770+ F2DC                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 771+ F2DC                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 772+ F2DC                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 773+ F2DC                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 774+ F2DC                  ; el wobble y la comparacion sigue siendo correcta.
 775+ F2DC 3A C5 82         LD A, (CompassWobbleCounter)
 776+ F2DF B7               OR A
 777+ F2E0 20 06            JR NZ, .dcSkipPrevDistSave
 778+ F2E2 3A F6 F2         LD A, (.dcDistance)
 779+ F2E5 32 C2 82         LD (PreviousObjectiveDistance), A
 780+ F2E8              .dcSkipPrevDistSave:
 781+ F2E8 3A 10 83         LD A, (CurrentScreenX)
 782+ F2EB 32 C3 82         LD (LastCompassScreenX), A
 783+ F2EE 3A 11 83         LD A, (CurrentScreenY)
 784+ F2F1 32 C4 82         LD (LastCompassScreenY), A
 785+ F2F4 C9               RET
 786+ F2F5
 787+ F2F5 00           .dcSpriteIdx: DEFB 0
 788+ F2F6 00           .dcDistance:  DEFB 0
 789+ F2F7 00           .dcAttr:      DEFB 0
