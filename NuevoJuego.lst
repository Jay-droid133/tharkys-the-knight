 191+ DE48 21 7D BD         LD HL, DayCycleCount
 192+ DE4B 7E               LD A, (HL)
 193+ DE4C FE 0A            CP 10
 194+ DE4E D0               RET NC                  ; Ya en maximo
 195+ DE4F 34               INC (HL)
 196+ DE50 C9               RET
 197+ DE51              .sNotPressed:
 198+ DE51                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 199+ DE51 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 200+ DE53 20 13            JR NZ, .dNotPressed
 201+ DE55 3A 8C DE         LD A, (SpeedKeyDebounce)
 202+ DE58 B7               OR A
