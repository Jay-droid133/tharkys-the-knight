 424+ EC1D              ; ==============================================================================
 425+ EC1D              ; ApplyRayoBuff - speed boost 1.5x durante 15s (color via cycler)
 426+ EC1D              ; ==============================================================================
 427+ EC1D              ; "Last wins": llamar de nuevo resetea timer + override estado actual.
 428+ EC1D              ; ==============================================================================
 429+ EC1D              ApplyRayoBuff:
 430+ EC1D 3E 06            LD A, SPEED_BUFF_RAYO_RUN
 431+ EC1F 32 D7 82         LD (PlayerSpeedRun), A
 432+ EC22 3E 03            LD A, SPEED_BUFF_RAYO_FIGHT
 433+ EC24 32 D8 82         LD (PlayerSpeedFight), A
 434+ EC27 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 435+ EC2A 22 D9 82         LD (SpeedBuffTimer), HL
 436+ EC2D 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 437+ EC2F 32 DB 82         LD (SpeedBuffType), A
