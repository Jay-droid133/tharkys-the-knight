6913+ C583 3E 04            LD A, DEATH_GHOST_SPEED
6914+ C585 30 02            JR NC, .udgXSet
6915+ C587 3E FC            LD A, -DEATH_GHOST_SPEED
6916+ C589              .udgXSet:
6917+ C589 DD 77 06         LD (IX+ENT_DELTAX), A
6918+ C58C DD 86 03         ADD A, (IX+ENT_POSX)
6919+ C58F DD 77 03         LD (IX+ENT_POSX), A
6920+ C592 18 1B            JR .udgAnim
