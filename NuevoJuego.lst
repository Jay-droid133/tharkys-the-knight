2115+ F23A 0E 06            LD C, CHURCH_KEY_ALT1_SCREEN_Y
2116+ F23C 16 1A            LD D, CHURCH_KEY_ALT1_CHAR_X
2117+ F23E 3E 03            LD A, CHURCH_KEY_ALT1_CHAR_Y
