2493+ B094              .paRndSetDX:
2494+ B094 DD 77 06         LD (IX+ENT_DELTAX), A
2495+ B097 ED 5F            LD A, R
2496+ B099 CB 5F            BIT 3, A
2497+ B09B 28 07            JR Z, .paRndDown
2498+ B09D 3A 9C 90         LD A, (CurrentEnemySpeed)
2499+ B0A0 ED 44            NEG
2500+ B0A2 18 03            JR .paRndSetDY
2501+ B0A4              .paRndDown:
2502+ B0A4 3A 9C 90         LD A, (CurrentEnemySpeed)
2503+ B0A7              .paRndSetDY:
2504+ B0A7 DD 77 07         LD (IX+ENT_DELTAY), A
