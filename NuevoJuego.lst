 622+ 66AD              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 623+ 66AD              ; ==============================================================================
 624+ 66AD              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 625+ 66AD              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 626+ 66AD              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 627+ 66AD              ;   2. Leer charX/charY de la entry
 628+ 66AD              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 629+ 66AD              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 630+ 66AD              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 631+ 66AD              ;   6. ChurchDoorOpen = 0
 632+ 66AD              ; ==============================================================================
 633+ 66AD              CloseChurchDoor:
 634+ 66AD                  ; SFX "chof" del cierre — distinto del creak (SFX_ChurchDoorOpen) que
 635+ 66AD                  ; usa la misma puerta al ABRIR. ABRIR = creak (madera girando con esfuerzo);
 636+ 66AD                  ; CERRAR = chof (impacto contra el marco). SFX_DoorClose compartido con la
 637+ 66AD                  ; cinematica del banco (HAND_OUT + HAND_OPEN_IN). Suena ANTES del cambio visual.
 638+ 66AD 21 67 FB         LD HL, SFX_DoorClose
 639+ 66B0 CD 21 FA         CALL PlaySFX
 640+ 66B3 11 4D DF         LD DE, BgGfx_old_church_door_open
 641+ 66B6 CD 40 67         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 642+ 66B9 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 643+ 66BB                  ; Leer charX (HL+4) y charY (HL+5) en BC
 644+ 66BB E5               PUSH HL                                 ; save mapX ptr
 645+ 66BC 01 04 00         LD BC, 4
 646+ 66BF 09               ADD HL, BC
 647+ 66C0 46               LD B, (HL)                              ; B = charX
 648+ 66C1 23               INC HL
 649+ 66C2 4E               LD C, (HL)                              ; C = charY
 650+ 66C3 E1               POP HL                                  ; HL = mapX ptr
 651+ 66C4                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 652+ 66C4 E5               PUSH HL
 653+ 66C5 C5               PUSH BC
 654+ 66C6 21 4D DF         LD HL, BgGfx_old_church_door_open
 655+ 66C9 3E 03            LD A, 3
 656+ 66CB CD D0 67         CALL LoadBgSpriteToBuffer               ; preserva BC
 657+ 66CE C1               POP BC
 658+ 66CF C5               PUSH BC
 659+ 66D0 DD 21 FD 86      LD IX, BgSpriteBuffer
 660+ 66D4 CD 73 DC         CALL DrawBgSpriteXOR                    ; borra
 661+ 66D7 C1               POP BC
 662+ 66D8 E1               POP HL
 663+ 66D9                  ; --- Patch ptr: open -> closed ---
 664+ 66D9 23               INC HL
 664+ 66DA 23             INC HL                         ; -> ptr_lo
 665+ 66DB 3E 94            LD A, LOW BgGfx_old_church_door_closed
 666+ 66DD 77               LD (HL), A
 667+ 66DE 23               INC HL
 668+ 66DF 3E DE            LD A, HIGH BgGfx_old_church_door_closed
 669+ 66E1 77               LD (HL), A
 670+ 66E2                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 671+ 66E2 C5               PUSH BC
 672+ 66E3 21 94 DE         LD HL, BgGfx_old_church_door_closed
 673+ 66E6 3E 03            LD A, 3
 674+ 66E8 CD D0 67         CALL LoadBgSpriteToBuffer
 675+ 66EB C1               POP BC
 676+ 66EC C5               PUSH BC
 677+ 66ED DD 21 FD 86      LD IX, BgSpriteBuffer
 678+ 66F1 CD 73 DC         CALL DrawBgSpriteXOR
 679+ 66F4 C1               POP BC
 680+ 66F5 DD 21 FD 86      LD IX, BgSpriteBuffer
 681+ 66F9 AF               XOR A
 682+ 66FA 32 48 E4         LD (BgSpriteIsHouse), A
 683+ 66FD CD B8 DC         CALL DrawBgAttrOnly
