2914+ DB69              ; DrawLivesHUD - Renderiza N iconos "Lives" (BG253, 8x8) en row 1 cols 26-30
2915+ DB69              ; ==============================================================================
2916+ DB69              ; N = min(PlayerLives, PLAYER_LIVES_MAX). Limpia el strip y dibuja N iconos.
2917+ DB69              ; ==============================================================================
2918+ DB69              DrawLivesHUD:
2919+ DB69                  ; --- Determinar N (cap a PLAYER_LIVES_MAX) ---
2920+ DB69 3A D7 82         LD A, (PlayerLives)
2921+ DB6C FE 06            CP PLAYER_LIVES_MAX + 1
2922+ DB6E 38 02            JR C, .dlhCapOk
2923+ DB70 3E 05            LD A, PLAYER_LIVES_MAX
2924+ DB72              .dlhCapOk:
2925+ DB72 47               LD B, A                         ; B = N actual
2926+ DB73                  ; --- Skip si mismo valor que el ultimo dibujo (evita flicker) ---
2927+ DB73 3A D5 DB         LD A, (.dlhLast)
2928+ DB76 B8               CP B
2929+ DB77 C8               RET Z
2930+ DB78 78               LD A, B
2931+ DB79 32 D5 DB         LD (.dlhLast), A
2932+ DB7C 32 D4 DB         LD (.dlhCount), A
