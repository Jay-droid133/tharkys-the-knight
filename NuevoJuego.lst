 389+ A081              ; ==============================================================================
 390+ A081              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 391+ A081              ; ==============================================================================
 392+ A081              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 393+ A081              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 394+ A081              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 395+ A081              ; ==============================================================================
 396+ A081              ProcessEnemies:
 397+ A081 3E 00            LD A, 0
 398+ A083 32 CC A0         LD (.peCount), A
 399+ A086 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 400+ A088
 401+ A088              .peLoop:
 402+ A088 C5               PUSH BC
 403+ A089
 404+ A089                  ; Calcular IX desde EnemyStepIdx
 405+ A089 3A CD 81         LD A, (EnemyStepIdx)
 406+ A08C C6 01            ADD A, SLOT_MONSTER0
 407+ A08E 6F               LD L, A
 408+ A08F 26 00            LD H, 0
 409+ A091 29               ADD HL, HL
 410+ A092 29               ADD HL, HL
 411+ A093 29               ADD HL, HL
 412+ A094 29               ADD HL, HL                          ; × ENT_SIZE (16)
 413+ A095 11 B0 80         LD DE, EntityTable
 414+ A098 19               ADD HL, DE
 415+ A099 E5               PUSH HL
 416+ A09A DD E1            POP IX
 417+ A09C
 418+ A09C                  ; Avanzar indice round-robin
 419+ A09C 3A CD 81         LD A, (EnemyStepIdx)
 420+ A09F 3C               INC A
 421+ A0A0 FE 09            CP NUM_MONSTERS + NUM_NASTIES
 422+ A0A2 38 01            JR C, .peNoWrap
 423+ A0A4 AF               XOR A
 424+ A0A5              .peNoWrap:
 425+ A0A5 32 CD 81         LD (EnemyStepIdx), A
 426+ A0A8
 427+ A0A8                  ; Slot activo?
 428+ A0A8 DD 7E 01         LD A, (IX+ENT_TYPE)
 429+ A0AB B7               OR A
 430+ A0AC 28 16            JR Z, .peSkip
 431+ A0AE
 432+ A0AE                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 433+ A0AE DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 434+ A0B2 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 435+ A0B3
 436+ A0B3                  ; Procesar esta entidad completa (erase + logic + draw)
 437+ A0B3 CD CD A0         CALL ProcessOneEnemy
 438+ A0B6
 439+ A0B6                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 440+ A0B6 F1               POP AF
 441+ A0B7 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 442+ A0B9
 443+ A0B9                  ; Budget check
 444+ A0B9 3A CC A0         LD A, (.peCount)
 445+ A0BC 3C               INC A
 446+ A0BD 32 CC A0         LD (.peCount), A
 447+ A0C0 FE 02            CP MAX_ENEMIES_PER_FRAME
 448+ A0C2 30 06            JR NC, .peDone
 449+ A0C4
 450+ A0C4              .peSkip:
 451+ A0C4 C1               POP BC
 452+ A0C5 05               DEC B
 453+ A0C6 C2 88 A0         JP NZ, .peLoop
 454+ A0C9 C9               RET
 455+ A0CA
 456+ A0CA              .peDone:
 457+ A0CA C1               POP BC
 458+ A0CB C9               RET
