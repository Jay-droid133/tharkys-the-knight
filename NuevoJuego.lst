 436+ 90DB              ; ==============================================================================
 437+ 90DB              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 438+ 90DB              ; ==============================================================================
 439+ 90DB              FlushAttrSlot:
 440+ 90DB 3A C0 90         LD A, (CurrentAttrSlot)
 441+ 90DE 6F               LD L, A
 442+ 90DF 26 00            LD H, 0
 443+ 90E1 29               ADD HL, HL                  ; x2
 444+ 90E2 54               LD D, H
 445+ 90E3 5D               LD E, L
 446+ 90E4 29               ADD HL, HL                  ; x4
 447+ 90E5 29               ADD HL, HL                  ; x8
 448+ 90E6 29               ADD HL, HL                  ; x16
 449+ 90E7 19               ADD HL, DE                  ; x18
 450+ 90E8 11 8E 8F         LD DE, SavedAttrTable
 451+ 90EB 19               ADD HL, DE                  ; HL = destino en tabla
 452+ 90EC EB               EX DE, HL                   ; DE = destino
 453+ 90ED 21 7C 8F         LD HL, EntitySavedAttr      ; HL = fuente
 454+ 90F0 01 12 00         LD BC, 18
 455+ 90F3 ED B0            LDIR
 456+ 90F5 C9               RET
