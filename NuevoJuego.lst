 255+ 9EAE              ; ==============================================================================
 256+ 9EAE              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9EAE              ; ==============================================================================
 258+ 9EAE              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9EAE              ; Entrada:
 260+ 9EAE              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9EAE              ;   A = atributo a pintar
 262+ 9EAE              ; ==============================================================================
 263+ 9EAE              SetEntityAttr:
 264+ 9EAE F5               PUSH AF                     ; Guardar atributo
 265+ 9EAF CD 16 A1         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9EB2 F1               POP AF
 267+ 9EB3
 268+ 9EB3 47               LD B, A                     ; B = atributo (preservar)
 269+ 9EB4 3A AD 9F         LD A, (EntityAttrH)
 270+ 9EB7 4F               LD C, A                     ; C = filas
 271+ 9EB8              .rowLoop:
 272+ 9EB8                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9EB8 E5               PUSH HL
 274+ 9EB9 7C               LD A, H
 275+ 9EBA FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9EBC 20 08            JR NZ, .rowNotHud
 277+ 9EBE 7D               LD A, L
 278+ 9EBF FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9EC1 30 03            JR NC, .rowNotHud
 280+ 9EC3                  ; Fila en HUD → saltar sin pintar
 281+ 9EC3 E1               POP HL
 282+ 9EC4 18 0B            JR .rowSkip
 283+ 9EC6              .rowNotHud:
 284+ 9EC6 E1               POP HL
 285+ 9EC7 3A AC 9F         LD A, (EntityAttrW)
 286+ 9ECA E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9ECB                  ; Pintar una fila
 288+ 9ECB              .colLoop:
 289+ 9ECB 70               LD (HL), B
 290+ 9ECC 23               INC HL
 291+ 9ECD 3D               DEC A
 292+ 9ECE 20 FB            JR NZ, .colLoop
 293+ 9ED0 E1               POP HL
 294+ 9ED1              .rowSkip:
 295+ 9ED1                  ; Siguiente fila: HL += 32
 296+ 9ED1 D5               PUSH DE
 297+ 9ED2 11 20 00         LD DE, 32
 298+ 9ED5 19               ADD HL, DE
 299+ 9ED6 D1               POP DE
 300+ 9ED7 0D               DEC C
 301+ 9ED8 20 DE            JR NZ, .rowLoop
 302+ 9EDA C9               RET
