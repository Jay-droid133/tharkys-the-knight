4207+ B9EA              ; ==============================================================================
4208+ B9EA              ; CountActiveNasties / CountActiveMonsters
4209+ B9EA              ; ==============================================================================
4210+ B9EA              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4211+ B9EA              ; Ambas usan _CountSlots internamente.
4212+ B9EA              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4213+ B9EA              ; ==============================================================================
4214+ B9EA              CountActiveNasties:
4215+ B9EA 21 38 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4216+ B9ED 06 04            LD B, NUM_NASTIES
4217+ B9EF 18 05            JR _CountSlots
4218+ B9F1
4219+ B9F1              CountActiveMonsters:
4220+ B9F1 21 D8 80         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4221+ B9F4 06 06            LD B, NUM_MONSTERS
4222+ B9F6
4223+ B9F6              _CountSlots:
4224+ B9F6 0E 00            LD C, 0                         ; Contador
4225+ B9F8              .countLoop:
4226+ B9F8 7E               LD A, (HL)
4227+ B9F9 B7               OR A
4228+ B9FA 28 16            JR Z, .countNext                ; Slot vacio: no contar
4229+ B9FC                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4230+ B9FC D5               PUSH DE
4231+ B9FD 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4232+ BA00 19               ADD HL, DE
4233+ BA01 7E               LD A, (HL)
4234+ BA02 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4235+ BA04 D1               POP DE
4236+ BA05 FE 03            CP STATE_DYING
4237+ BA07 28 09            JR Z, .countNext
4238+ BA09 FE 04            CP STATE_SPAWNING
4239+ BA0B 28 05            JR Z, .countNext
4240+ BA0D FE 05            CP STATE_SCARED
4241+ BA0F 28 01            JR Z, .countNext
4242+ BA11 0C               INC C
4243+ BA12              .countNext:
4244+ BA12 11 10 00         LD DE, ENT_SIZE
4245+ BA15 19               ADD HL, DE
4246+ BA16 10 E0            DJNZ .countLoop
4247+ BA18 79               LD A, C
4248+ BA19 C9               RET
