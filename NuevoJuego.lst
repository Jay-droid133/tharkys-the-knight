 195+ EC49              ; ==============================================================================
 196+ EC49              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EC49              ; ==============================================================================
 198+ EC49              DrawClockHUD:
 199+ EC49                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EC49                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EC49                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EC49                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EC49                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EC49                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EC49 3A BB 82         LD A, (TimeFrozen)
 206+ EC4C FE 01            CP 1
 207+ EC4E 20 07            JR NZ, .clkDrawNormal
 208+ EC50 3A A0 81         LD A, (GameFrameCounter)
 209+ EC53 E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EC55 28 2D            JR Z, .clkBlinkOff
 211+ EC57              .clkDrawNormal:
 212+ EC57 CD 92 EC         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EC5A
 214+ EC5A                  ; --- Aguja de horas ---
 215+ EC5A 3A 52 EA         LD A, (GameHours)
 216+ EC5D FE 0C            CP 12
 217+ EC5F 38 02            JR C, .hourOk
 218+ EC61 D6 0C            SUB 12
 219+ EC63              .hourOk:
 220+ EC63 21 4E EB         LD HL, HourHandPtrs
 221+ EC66 CD 68 EE         CALL DrawHandLine
