2820+ AEE9                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2821+ AEE9                  ;
2822+ AEE9                  ; Doble comportamiento:
2823+ AEE9                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2824+ AEE9                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2825+ AEE9                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2826+ AEE9                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2827+ AEE9                  ;   y lo activa).
2828+ AEE9                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2829+ AEE9                  ;   El monster queda en destino (memoria) hasta que el player visite.
2830+ AEE9                  ;
2831+ AEE9                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2832+ AEE9                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2833+ AEE9 DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2834+ AEEC 32 2D AF         LD (.moKbSavedDir), A
2835+ AEEF 3E 01            LD A, 1
2836+ AEF1 32 62 B2         LD (MonsterKbDespawn), A
2837+ AEF4                  ; Calcular slot (0-2) en E, D=0
2838+ AEF4 DD E5            PUSH IX
2839+ AEF6 E1               POP HL
2840+ AEF7 11 C0 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
2841+ AEFA B7               OR A
2842+ AEFB ED 52            SBC HL, DE
2843+ AEFD CB 3D            SRL L
2844+ AEFF CB 3D            SRL L
2845+ AF01 CB 3D            SRL L
2846+ AF03 CB 3D            SRL L
2847+ AF05 5D               LD E, L
2848+ AF06 16 00            LD D, 0
2849+ AF08                  ; Clear MAI_FLAG_LEAVING
2850+ AF08 21 0C 90         LD HL, MonsterAiFlags
2851+ AF0B 19               ADD HL, DE
2852+ AF0C 7E               LD A, (HL)
2853+ AF0D E6 FD            AND ~MAI_FLAG_LEAVING & $FF
2854+ AF0F 77               LD (HL), A
2855+ AF10                  ; MonsterRoomId[slot] = neighbor_id (destino)
2856+ AF10 3A 2D AF         LD A, (.moKbSavedDir)
2857+ AF13 CD 72 92         CALL MaiGetNeighborScreenId
2858+ AF16 21 00 90         LD HL, MonsterRoomId
2859+ AF19 19               ADD HL, DE
2860+ AF1A 77               LD (HL), A
2861+ AF1B                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
2862+ AF1B 3A 2D AF         LD A, (.moKbSavedDir)
2863+ AF1E CD D1 92         CALL MaiDirToEntrySide
2864+ AF21 21 06 90         LD HL, MonsterEntryBorder
2865+ AF24 19               ADD HL, DE
2866+ AF25 77               LD (HL), A
2867+ AF26                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
2868+ AF26 21 64 B2         LD HL, MonsterReturnTimer
2869+ AF29 19               ADD HL, DE
2870+ AF2A 36 32            LD (HL), MAI_LINGER_PUSHED
2871+ AF2C C9               RET
2872+ AF2D
