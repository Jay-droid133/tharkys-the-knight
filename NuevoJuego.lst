 173  7A01                  ; --- Music IRQ handler + driver musica (slot 1) ---
 174  7A01                  ; Tabla IM 2 en $7A00, JP en $7B7B, handler en $7B7E. State + tablas + tick
 175  7A01                  ; al final del archivo. Ver music_irq.asm. Independiza el ritmo musical de
 176  7A01                  ; la latencia de MainLoop sin paginar slot 3 desde el handler.
 177  7A01                  INCLUDE "music_irq.asm"
# file opened: code/music_irq.asm
   1+ 7A01              ; ==============================================================================
   2+ 7A01              ; MUSIC_IRQ - IM 2 handler para tick de musica a 25 Hz
   3+ 7A01              ; ==============================================================================
   4+ 7A01              ; Vive en slot 1 ($7A00+, contended pero siempre visible).
   5+ 7A01              ;
   6+ 7A01              ; Por que existe: la latencia de MainLoop (especialmente en transiciones de
   7+ 7A01              ; pantalla, ~200 ms) provocaba que la musica avanzara N notas en una sola
   8+ 7A01              ; iteracion, escribiendo solo el ultimo period al AY. El usuario percibia
   9+ 7A01              ; notas "saltadas" o ritmo desplazado. Con IM 2 + handler propio, el tick de
  10+ 7A01              ; musica ocurre cada 2 IRQs (= 25 Hz) independientemente de la carga del
  11+ 7A01              ; MainLoop. Las escrituras AY caen en el wall-clock exacto, ritmo intacto.
  12+ 7A01              ;
  13+ 7A01              ; IM 2 setup (Inicio):
  14+ 7A01              ;   I = $7A
  15+ 7A01              ;   Tabla 257 bytes en $7A00-$7B00, todos $7B (cualquier byte del data bus
  16+ 7A01              ;     da vector = $7B7B).
  17+ 7A01              ;   $7B7B: JP MusicIrqHandler.
  18+ 7A01              ;
  19+ 7A01              ; Race condition con AY desde MainLoop: las rutinas que escriben AY desde
  20+ 7A01              ; gameplay (StartMusic thunk, AY_PlayBeep, AY_PlayBellChime, etc.) ya hacen
  21+ 7A01              ; DI/EI alrededor de sus AY OUTs, asi que no son interrumpidas. Las
  22+ 7A01              ; escrituras AY desde el IRQ handler no necesitan DI extra (CPU ya tiene
  23+ 7A01              ; interrupts deshabilitados al entrar al handler).
  24+ 7A01              ; ==============================================================================
  25+ 7A01
  26+ 7A01              ; --- Vector table (257 bytes all $7B) ---
  27+ 7A01              ; Cualquier byte del data bus da vector = $7B7B (.im2Vector).
  28+ 7A01                  ORG $7A00
  29+ 7A00              .im2Table:
  30+ 7A00 7B 7B 7B...      DEFS 257, $7B                       ; $7A00-$7B00 inclusive
  31+ 7B01
  32+ 7B01              ; --- Vector target: JP MusicIrqHandler ---
  33+ 7B01                  ORG $7B7B
  34+ 7B7B              .im2Vector:
  35+ 7B7B C3 7E 7B         JP MusicIrqHandler
  36+ 7B7E
  37+ 7B7E              ; --- IRQ handler proper ---
  38+ 7B7E              ; Cada IRQ:
  39+ 7B7E              ;   1. INC $5C78 (system frames counter — ROM IRQ no se ejecuta con IM 2).
  40+ 7B7E              ;   2. Toggle MusicIrqDivisor: solo tickea musica cada 2 IRQs (= 25 Hz).
  41+ 7B7E              ;   3. Si toca tick: CALL UpdateMusicTick (en slot 1, sin paginar nada).
  42+ 7B7E              ;   4. EI + RET.
  43+ 7B7E              ;
  44+ 7B7E              ; Atomicidad: el handler NO toca slot 3, asi que los PUSH/POP del propio
  45+ 7B7E              ; handler operan sobre el mismo bank fisico de principio a fin —
  46+ 7B7E              ; inmune al race con MainLoop que paga slots sin DI.
  47+ 7B7E              ;
  48+ 7B7E              ; Coste: ~80 T-states en frame skip (no tick), ~250 T-states en frame tick.
  49+ 7B7E              ; Per-second: ~12500 T = 0.36% del CPU. Despreciable.
  50+ 7B7E              MusicIrqHandler:
  51+ 7B7E F5               PUSH AF
  52+ 7B7F C5               PUSH BC
  53+ 7B80 D5               PUSH DE
  54+ 7B81 E5               PUSH HL
  55+ 7B82
  56+ 7B82                  ; --- Increment $5C78 ---
  57+ 7B82 21 78 5C         LD HL, $5C78
  58+ 7B85 34               INC (HL)
  59+ 7B86 20 02            JR NZ, .mihNoWrap
  60+ 7B88 23               INC HL
  61+ 7B89 34               INC (HL)
  62+ 7B8A              .mihNoWrap:
  63+ 7B8A
  64+ 7B8A                  ; --- Toggle divisor (25 Hz) ---
  65+ 7B8A 21 A2 7B         LD HL, MusicIrqDivisor
  66+ 7B8D 7E               LD A, (HL)
  67+ 7B8E EE 01            XOR 1
  68+ 7B90 77               LD (HL), A
  69+ 7B91 28 09            JR Z, .mihEpilogue
  70+ 7B93
  71+ 7B93                  ; --- Tick SFX + MUSICA (slot 1, siempre visible). ---
  72+ 7B93                  ; SFX countdown (Beep, PlayerHit) tickea aqui para inmunizar la duracion
  73+ 7B93                  ; al wall-clock (commit 1759338: "TIC del compass no se estira en
  74+ 7B93                  ; transiciones").
  75+ 7B93                  ;
  76+ 7B93                  ; La MUSICA tambien tickea aqui (avance de nota + re-arm AY). Asi el ritmo
  77+ 7B93                  ; sigue exacto durante DrawScreen/transiciones de pantalla, donde MainLoop
  78+ 7B93                  ; queda bloqueado varios frames y antes la nota actual se "alargaba" hasta
  79+ 7B93                  ; que MainLoop volvia y hacia catchup.
  80+ 7B93                  ;
  81+ 7B93                  ; Concurrencia AY: TODAS las escrituras al AY desde MainLoop estan
  82+ 7B93                  ; envueltas en DI/EI (auditoria en ay_sound_thunks.asm + sfx_player_hit_ay
  83+ 7B93                  ; .asm). Por tanto el handler IRQ nunca cae a media secuencia
  84+ 7B93                  ; select($FFFD)+data($BFFD) y no corrompe el index del AY.
  85+ 7B93                  ;
  86+ 7B93                  ; Inline tick: equivale a CALL UpdateMusicTick pero ahorra el stub (-3 B).
  87+ 7B93 CD E4 6D         CALL AY_UpdatePlayerHit
  88+ 7B96 CD 0E 7E         CALL UpdateMusicImpl.upmiTickOnce
  89+ 7B99 CD 9D 7D         CALL UpdateMusicImpl.upmiPostLoop
  90+ 7B9C
  91+ 7B9C              .mihEpilogue:
  92+ 7B9C E1               POP HL
  93+ 7B9D D1               POP DE
  94+ 7B9E C1               POP BC
  95+ 7B9F F1               POP AF
  96+ 7BA0 FB               EI
  97+ 7BA1 C9               RET
  98+ 7BA2
  99+ 7BA2              ; --- Estado del divisor (1 byte) ---
 100+ 7BA2 00           MusicIrqDivisor: DEFB 0
 101+ 7BA3
 102+ 7BA3              ; ==============================================================================
 103+ 7BA3              ; MUSIC DRIVER STATE + TABLES + TICK (movido de bank 4 a slot 1)
 104+ 7BA3              ; ==============================================================================
 105+ 7BA3              ; Vive aqui porque el IRQ handler debe acceder a este codigo/datos sin paginar
 106+ 7BA3              ; (paginar slot 3 dentro del IRQ rompe los PUSH/POP del propio handler — ver
 107+ 7BA3              ; project_ay_thunk_stack_bug.md). Slot 1 = $6000-$7FFF siempre visible, asi
 108+ 7BA3              ; que tanto el handler IRQ como StartMusicImpl (en bank 4) llegan aqui sin
 109+ 7BA3              ; problemas: bank 4 paga slot 3, slot 1 sigue intacto.
 110+ 7BA3              ;
 111+ 7BA3              ; Tracks (mismo dispatcher que antes, vive en bank 4 / ay_sound.asm):
 112+ 7BA3              ;   0    = Tension     (TensionMusicTable)
 113+ 7BA3              ;   1    = Sunrise     (SunriseMusicTable)
 114+ 7BA3              ;   2    = EndGame     (EndGameMusicTable)  LOOPABLE
 115+ 7BA3              ;   3    = GameOver    (GameOverMusicTable)
 116+ 7BA3              ;   4    = Death       (DeathMusicTable)    LOOPABLE
 117+ 7BA3              ;   $FF  = STOP, $FE = restart, $FD = stop-if-loopable
 118+ 7BA3              ; ==============================================================================
 119+ 7BA3
 120+ 7BA3              ; --- State (13 B) ---
 121+ 7BA3              ; Driver poly: tracks in-game (Tension/Sunrise/Death) usan poly2 (canales A+C,
 122+ 7BA3              ; B reservado a SFX). Tracks game-end (EndGame/GameOver) usan poly3 (A+B+C, sin
 123+ 7BA3              ; SFX en escena). El modo se setea en StartMusicImpl segun track id; dicta el
 124+ 7BA3              ; stride de tabla (5 vs 7 B/nota) y qué canales re-armar cada frame.
 125+ 7BA3 00 00        MusicPtr:           DEFW 0      ; Ptr a la nota actual en la tabla activa
 126+ 7BA5 00           MusicTimer:         DEFB 0      ; Frames restantes en la nota actual (0 = inactivo)
 127+ 7BA6 00 00        MusicTableStart:    DEFW 0      ; Ptr al inicio de la tabla activa (para loop)
 128+ 7BA8 00           MusicLoop:          DEFB 0      ; 1 = al terminator reiniciar; 0 = mute y parar
 129+ 7BA9 00           MusicMode:          DEFB 0      ; 2 = poly2 (5 B/entry, A+C), 3 = poly3 (7 B/entry, A+B+C)
 130+ 7BAA 00 00        MusicPeriodA:       DEFW 0      ; Period activo canal A (0 = mute A en re-arm)
 131+ 7BAC 00 00        MusicPeriodB:       DEFW 0      ; Period activo canal B (solo poly3; 0 = mute)
 132+ 7BAE 00 00        MusicPeriodC:       DEFW 0      ; Period activo canal C (0 = mute C en re-arm)
 133+ 7BB0
 134+ 7BB0              ; ==============================================================================
 135+ 7BB0              ; TRACK TABLES (polifonicas)
 136+ 7BB0              ; ==============================================================================
 137+ 7BB0              ; Period AY = 1750000 / (16 * frequency). Duraciones en frames a 25fps (1f=40ms).
 138+ 7BB0              ;
 139+ 7BB0              ; Formato Poly2 (5 B/entry): periodA(2) + periodC(2) + duration(1)
 140+ 7BB0              ;   Tracks 0/1/4 (Tension/Sunrise/Death). Canal B libre para SFX.
 141+ 7BB0              ; Formato Poly3 (7 B/entry): periodA(2) + periodB(2) + periodC(2) + duration(1)
 142+ 7BB0              ;   Tracks 2/3 (EndGame/GameOver). Sin SFX en escena → 3 voces simultaneas.
 143+ 7BB0              ;
 144+ 7BB0              ; period=$0000 en un canal = ese canal en silencio durante la nota (vol mute).
 145+ 7BB0              ; Terminator: entry completa con todo a 0 (5 B en poly2, 7 B en poly3).
 146+ 7BB0              ;
 147+ 7BB0              ; Por ahora todas las melodias siguen monofonicas (voz original en A, B/C en
 148+ 7BB0              ; silencio) hasta que el converter genere las versiones polifonicas reales.
 149+ 7BB0              ; ==============================================================================
