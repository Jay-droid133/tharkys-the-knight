# file opened: logic_game.asm
   1+ 9DBF              ; ==============================================================================
   2+ 9DBF              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DBF              ; ==============================================================================
   4+ 9DBF              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DBF              ; - Game loop per-entity: erase → update → draw
   6+ 9DBF              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DBF              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DBF              ; - XOR draw/erase (una sola rutina)
   9+ 9DBF              ; ==============================================================================
  10+ 9DBF
  11+ 9DBF              ; ==============================================================================
  12+ 9DBF              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DBF              ; ==============================================================================
  14+ 9DBF              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DBF              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DBF              ; ==============================================================================
  17+ 9DBF              ReadInput:
  18+ 9DBF 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DC1 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DC3
  21+ 9DC3                  ; -- 1. QAOP --
  22+ 9DC3 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC6 ED 78            IN A, (C)
  24+ 9DC8 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DCA 20 02            JR NZ, .no_q
  26+ 9DCC CB C2            SET 0, D
  27+ 9DCE              .no_q:
  28+ 9DCE 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DD1 ED 78            IN A, (C)
  30+ 9DD3 CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD5 20 02            JR NZ, .no_a
  32+ 9DD7 CB CA            SET 1, D
  33+ 9DD9              .no_a:
  34+ 9DD9 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DDC ED 78            IN A, (C)
  36+ 9DDE CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DE0 20 02            JR NZ, .no_o
  38+ 9DE2 CB DA            SET 3, D
  39+ 9DE4              .no_o:
  40+ 9DE4 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE6 20 02            JR NZ, .no_p
  42+ 9DE8 CB D2            SET 2, D
  43+ 9DEA              .no_p:
  44+ 9DEA
  45+ 9DEA                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DEA                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DEA DB 1F            IN A, (31)
  48+ 9DEC 4F               LD C, A             ; guardar para fire
  49+ 9DED CB 5F            BIT 3, A            ; Up
  50+ 9DEF 28 02            JR Z, .no_k_up
  51+ 9DF1 CB C2            SET 0, D
  52+ 9DF3              .no_k_up:
  53+ 9DF3 CB 57            BIT 2, A            ; Down
  54+ 9DF5 28 02            JR Z, .no_k_down
  55+ 9DF7 CB CA            SET 1, D
  56+ 9DF9              .no_k_down:
  57+ 9DF9 CB 4F            BIT 1, A            ; Left
  58+ 9DFB 28 02            JR Z, .no_k_left
  59+ 9DFD CB DA            SET 3, D
  60+ 9DFF              .no_k_left:
  61+ 9DFF CB 47            BIT 0, A            ; Right
  62+ 9E01 28 02            JR Z, .no_k_right
  63+ 9E03 CB D2            SET 2, D
  64+ 9E05              .no_k_right:
  65+ 9E05 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E07 28 02            JR Z, .no_k_fire
  67+ 9E09 CB C3            SET 0, E
  68+ 9E0B              .no_k_fire:
  69+ 9E0B
  70+ 9E0B                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E0B                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E0B 01 FE F7         LD BC, $F7FE
  73+ 9E0E ED 78            IN A, (C)
  74+ 9E10 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E12 20 02            JR NZ, .no_s1_up
  76+ 9E14 CB C2            SET 0, D
  77+ 9E16              .no_s1_up:
  78+ 9E16 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E18 20 02            JR NZ, .no_s1_down
  80+ 9E1A CB CA            SET 1, D
  81+ 9E1C              .no_s1_down:
  82+ 9E1C CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E1E 20 02            JR NZ, .no_s1_left
  84+ 9E20 CB DA            SET 3, D
  85+ 9E22              .no_s1_left:
  86+ 9E22 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E24 20 02            JR NZ, .no_s1_right
  88+ 9E26 CB D2            SET 2, D
  89+ 9E28              .no_s1_right:
  90+ 9E28 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E2A 20 02            JR NZ, .no_s1_fire
  92+ 9E2C CB C3            SET 0, E
  93+ 9E2E              .no_s1_fire:
  94+ 9E2E
  95+ 9E2E                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E2E 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E31 ED 78            IN A, (C)
  98+ 9E33 CB 47            BIT 0, A            ; SPACE
  99+ 9E35 20 02            JR NZ, .no_space
 100+ 9E37 CB C3            SET 0, E
 101+ 9E39              .no_space:
 102+ 9E39
 103+ 9E39                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E39 7B               LD A, E
 105+ 9E3A 32 B1 82         LD (InputFire), A
 106+ 9E3D
 107+ 9E3D                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E3D 21 DF 82         LD HL, MushroomLockTimer
 109+ 9E40 7E               LD A, (HL)
 110+ 9E41 23               INC HL
 111+ 9E42 B6               OR (HL)
 112+ 9E43 28 21            JR Z, .noMushLock
 113+ 9E45 AF               XOR A
 114+ 9E46 32 B1 82         LD (InputFire), A
 115+ 9E49                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E49                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E49 7B               LD A, E
 118+ 9E4A B7               OR A
 119+ 9E4B 28 15            JR Z, .resetNoSwordFlag
 120+ 9E4D 3A BA 82         LD A, (NoSwordSoundFlag)
 121+ 9E50 B7               OR A
 122+ 9E51 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E53 3E 01            LD A, 1
 124+ 9E55 32 BA 82         LD (NoSwordSoundFlag), A
 125+ 9E58 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E59 21 AB FA         LD HL, SFX_NoSwordError
 127+ 9E5C CD 69 F9         CALL PlaySFX
 128+ 9E5F D1               POP DE
 129+ 9E60 18 04            JR .noMushLock
 130+ 9E62              .resetNoSwordFlag:
 131+ 9E62 AF               XOR A
 132+ 9E63 32 BA 82         LD (NoSwordSoundFlag), A
 133+ 9E66              .noMushLock:
 134+ 9E66
 135+ 9E66                  ; -- REVERSE debuff: si timer > 0, swap N<->S y E<->W en D --
 136+ 9E66                  ; Para que las dos parejas se "intercambien" solo cuando difieren (caso
 137+ 9E66                  ; 01 o 10), comprobamos cada pareja por separado y XOR'eamos $03 / $0C
 138+ 9E66                  ; respectivamente. Si ambos bits estan igual (00 o 11), no se toca.
 139+ 9E66 3A DE 5F         LD A, (ReverseTimer)
 140+ 9E69 21 DF 5F         LD HL, ReverseTimer + 1
 141+ 9E6C B6               OR (HL)
 142+ 9E6D 28 1E            JR Z, .revOff
 143+ 9E6F                  ; Swap bits 0 (N) y 1 (S)
 144+ 9E6F 7A               LD A, D
 145+ 9E70 E6 03            AND $03
 146+ 9E72 FE 01            CP $01
 147+ 9E74 28 04            JR Z, .revFlipNS
 148+ 9E76 FE 02            CP $02
 149+ 9E78 20 04            JR NZ, .revAfterNS
 150+ 9E7A              .revFlipNS:
 151+ 9E7A 7A               LD A, D
 152+ 9E7B EE 03            XOR $03
 153+ 9E7D 57               LD D, A
 154+ 9E7E              .revAfterNS:
 155+ 9E7E                  ; Swap bits 2 (E) y 3 (W)
 156+ 9E7E 7A               LD A, D
 157+ 9E7F E6 0C            AND $0C
 158+ 9E81 FE 04            CP $04
 159+ 9E83 28 04            JR Z, .revFlipEW
 160+ 9E85 FE 08            CP $08
 161+ 9E87 20 04            JR NZ, .revAfterEW
 162+ 9E89              .revFlipEW:
 163+ 9E89 7A               LD A, D
 164+ 9E8A EE 0C            XOR $0C
 165+ 9E8C 57               LD D, A
 166+ 9E8D              .revAfterEW:
 167+ 9E8D              .revOff:
 168+ 9E8D
 169+ 9E8D                  ; -- 6. Cancelar opuestos --
 170+ 9E8D 7A               LD A, D
 171+ 9E8E 47               LD B, A
 172+ 9E8F E6 03            AND DIR_N | DIR_S
 173+ 9E91 FE 03            CP DIR_N | DIR_S
 174+ 9E93 20 04            JR NZ, .noVC
 175+ 9E95 78               LD A, B
 176+ 9E96 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 177+ 9E98 47               LD B, A
 178+ 9E99              .noVC:
 179+ 9E99 78               LD A, B
 180+ 9E9A E6 0C            AND DIR_E | DIR_W
 181+ 9E9C FE 0C            CP DIR_E | DIR_W
 182+ 9E9E 20 04            JR NZ, .noHC
 183+ 9EA0 78               LD A, B
 184+ 9EA1 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 185+ 9EA3 47               LD B, A
 186+ 9EA4              .noHC:
 187+ 9EA4 78               LD A, B
 188+ 9EA5 32 B0 82         LD (InputDirection), A
 189+ 9EA8 C9               RET
