2183+ F28A              ; ==============================================================================
2184+ F28A              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
2185+ F28A              ; ==============================================================================
2186+ F28A              ; Indice (CompassSprites[idx]):
2187+ F28A              ;   0 = NW    1 = N    2 = NE
2188+ F28A              ;   3 = W     4 = X    5 = E
2189+ F28A              ;   6 = SW    7 = S    8 = SE
2190+ F28A              ; ==============================================================================
2191+ F28A              CompassSprites:
2192+ F28A A9 F3            DEFW Sprite_Compass_NW
2193+ F28C C9 F2            DEFW Sprite_Compass_N
2194+ F28E E9 F2            DEFW Sprite_Compass_NE
2195+ F290 89 F3            DEFW Sprite_Compass_W
2196+ F292 C9 F3            DEFW Sprite_Compass_X
2197+ F294 09 F3            DEFW Sprite_Compass_E
2198+ F296 69 F3            DEFW Sprite_Compass_SW
2199+ F298 49 F3            DEFW Sprite_Compass_S
2200+ F29A 29 F3            DEFW Sprite_Compass_SE
