 202+ 8EBD              ; ==============================================================================
 203+ 8EBD              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 204+ 8EBD              ; ==============================================================================
 205+ 8EBD              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 206+ 8EBD              ; y los cruces de tercio de pantalla (cada 64 lineas).
 207+ 8EBD              ;
 208+ 8EBD              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 209+ 8EBD              ; ==============================================================================
 210+ 8EBD              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 211+ 8EBD              NextPixelLine:
 212+ 8EBD 24               INC H                       ; Siguiente scanline dentro del char
 213+ 8EBE 7C               LD A, H
 214+ 8EBF E6 07            AND 7
 215+ 8EC1 C0               RET NZ                      ; Sin cruce de char row → listo
 216+ 8EC2
 217+ 8EC2                  ; --- Cruce de character row ---
 218+ 8EC2 7D               LD A, L
 219+ 8EC3 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 220+ 8EC5 6F               LD L, A
 221+ 8EC6 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 222+ 8EC8 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 223+ 8EC9
 224+ 8EC9                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 225+ 8EC9 7C               LD A, H
 226+ 8ECA D6 08            SUB 8
 227+ 8ECC 67               LD H, A
 228+ 8ECD C9               RET
 229+ 8ECE
 230+ 8ECE              ; ==============================================================================
 231+ 8ECE              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 232+ 8ECE              ; ==============================================================================
 233+ 8ECE              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 234+ 8ECE              ; Entrada:
 235+ 8ECE              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 236+ 8ECE              ;   A = atributo a pintar
 237+ 8ECE              ; ==============================================================================
 238+ 8ECE              SetEntityAttr:
 239+ 8ECE F5               PUSH AF                     ; Guardar atributo
 240+ 8ECF CD F6 90         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 241+ 8ED2 F1               POP AF
 242+ 8ED3
 243+ 8ED3 47               LD B, A                     ; B = atributo (preservar)
 244+ 8ED4 3A 8D 8F         LD A, (EntityAttrH)
 245+ 8ED7 4F               LD C, A                     ; C = filas
 246+ 8ED8              .rowLoop:
 247+ 8ED8                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 248+ 8ED8 E5               PUSH HL
 249+ 8ED9 7C               LD A, H
 250+ 8EDA FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 251+ 8EDC 20 08            JR NZ, .rowNotHud
 252+ 8EDE 7D               LD A, L
 253+ 8EDF FE 40            CP (ATTR_BASE + 64) & $FF
 254+ 8EE1 30 03            JR NC, .rowNotHud
 255+ 8EE3                  ; Fila en HUD → saltar sin pintar
 256+ 8EE3 E1               POP HL
 257+ 8EE4 18 0B            JR .rowSkip
 258+ 8EE6              .rowNotHud:
 259+ 8EE6 E1               POP HL
 260+ 8EE7 3A 8C 8F         LD A, (EntityAttrW)
 261+ 8EEA E5               PUSH HL                     ; Guardar inicio de fila
 262+ 8EEB                  ; Pintar una fila
 263+ 8EEB              .colLoop:
 264+ 8EEB 70               LD (HL), B
 265+ 8EEC 23               INC HL
 266+ 8EED 3D               DEC A
 267+ 8EEE 20 FB            JR NZ, .colLoop
 268+ 8EF0 E1               POP HL
 269+ 8EF1              .rowSkip:
 270+ 8EF1                  ; Siguiente fila: HL += 32
 271+ 8EF1 D5               PUSH DE
 272+ 8EF2 11 20 00         LD DE, 32
 273+ 8EF5 19               ADD HL, DE
 274+ 8EF6 D1               POP DE
 275+ 8EF7 0D               DEC C
 276+ 8EF8 20 DE            JR NZ, .rowLoop
 277+ 8EFA C9               RET
