 772+ 9043 26 00            LD H, 0
 773+ 9045 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 774+ 9046 11 A7 CA         LD DE, SpriteFrameTable
 775+ 9049 19               ADD HL, DE
 776+ 904A 5E               LD E, (HL)
 777+ 904B 23               INC HL
 778+ 904C 56               LD D, (HL)
 779+ 904D ED 53 52 90      LD (SpriteAddrTemp), DE
 780+ 9051 C9               RET
