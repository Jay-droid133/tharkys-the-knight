 650+ CD19              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 651+ CD19              ; ==============================================================================
 652+ CD19              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 653+ CD19              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 654+ CD19              ;          DEFB tintPaper, attr_h, attr_w, attr_data
