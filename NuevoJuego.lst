2107+ DA21 65 E2            DEFW BgGfx_old_church_door_closed
2108+ DA23 05               DEFB 5                          ; key requerida = ChurchKey
2109+ DA24 02               DEFB 2                          ; action = ChurchDoor open
2110+ DA25 20 DC            DEFW BgGfx_chimes_tower_door
2111+ DA27 04               DEFB 4                          ; key requerida = ClockTowerKey
2112+ DA28 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2113+ DA29 00 00            DEFW 0                          ; fin
2114+ DA2B 00 00            DEFB 0, 0
