 927+ D25C DD 7E 01         LD A, (IX+1)                ; attr_w
 928+ D25F 57               LD D, A                     ; D = columnas de atributos
 929+ D260 DD 23            INC IX
 930+ D262 DD 23            INC IX                      ; IX -> attr data
 931+ D264
 932+ D264                  ; Calcular dir atributos: ATTR_BASE + y_char*32 + x_char
 933+ D264 3A 9A D2         LD A, (.yChar)
