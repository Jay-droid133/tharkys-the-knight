1523+ F68D              ; ==============================================================================
1524+ F68D              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1525+ F68D              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1526+ F68D              ;     A  = jitter signed (-1, 0, +1) en bits.
1527+ F68D              ; ==============================================================================
1528+ F68D              ; IN: A = jitter signed (-1, 0, +1) en bits.
1529+ F68D              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1530+ F68D              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1531+ F68D              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1532+ F68D              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1533+ F68D              ; version shifted, sin XOR.
1534+ F68D              ;
1535+ F68D              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1536+ F68D              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1537+ F68D              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1538+ F68D              ; estatua se perdio cuando la estatua se pinto la primera vez con
1539+ F68D              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1540+ F68D              ; de la estatua, el wall perdido no se ve.
1541+ F68D              ;
1542+ F68D              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1543+ F68D              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1544+ F68D              ; shift de 1 bit no pierde pixels visibles.
1545+ F68D              ; Destruye: AF, BC, DE, HL, IX.
1546+ F68D              ; ==============================================================================
1547+ F68D              ChurchCutsceneShakeStatueByteShift:
1548+ F68D 32 F7 F6         LD (.csbsJitter), A
1549+ F690                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1550+ F690 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1551+ F693 5F               LD E, A
1552+ F694 16 00            LD D, 0
1553+ F696 19               ADD HL, DE
1554+ F697 7E               LD A, (HL)
1555+ F698 B7               OR A
1556+ F699 C8               RET Z                                   ; sin estatua
1557+ F69A 6F               LD L, A
1558+ F69B 26 00            LD H, 0
1559+ F69D 54               LD D, H
1560+ F69E 5D               LD E, L
1561+ F69F 29               ADD HL, HL
1562+ F6A0 19               ADD HL, DE                              ; HL = id*3
1563+ F6A1 11 43 E1         LD DE, BgGfxPtrById
1564+ F6A4 19               ADD HL, DE
1565+ F6A5 5E               LD E, (HL)
1566+ F6A6 23               INC HL
1567+ F6A7 56               LD D, (HL)                              ; DE = sprite ptr
1568+ F6A8 23               INC HL
1569+ F6A9 7E               LD A, (HL)                              ; A = bank
1570+ F6AA EB               EX DE, HL                               ; HL = sprite ptr
1571+ F6AB CD D0 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1572+ F6AE                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1573+ F6AE DD 21 FD 86      LD IX, BgSpriteBuffer
1574+ F6B2 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1575+ F6B5 B7               OR A
1576+ F6B6 C8               RET Z
1577+ F6B7 47               LD B, A                                 ; B = row counter
1578+ F6B8 DD 23            INC IX
1579+ F6BA DD 23            INC IX                                  ; IX -> pixel data
1580+ F6BC                  ; Calcular addr VRAM en (origX, origY)
1581+ F6BC 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1582+ F6BF 57               LD D, A
1583+ F6C0 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1584+ F6C3 5F               LD E, A
1585+ F6C4 CD 62 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1586+ F6C7              .csbsRow:
1587+ F6C7 C5               PUSH BC
1588+ F6C8 E5               PUSH HL                                 ; save inicio fila VRAM
1589+ F6C9                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1590+ F6C9 DD 7E 00         LD A, (IX+0)
1591+ F6CC 2F               CPL
1592+ F6CD 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1593+ F6CE DD 7E 01         LD A, (IX+1)
1594+ F6D1 2F               CPL
1595+ F6D2 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1596+ F6D3                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1597+ F6D3 3A F7 F6         LD A, (.csbsJitter)
1598+ F6D6 B7               OR A
1599+ F6D7 28 0D            JR Z, .csbsWrite                        ; sin shift
1600+ F6D9 FA E2 F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1601+ F6DC                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1602+ F6DC CB 3A            SRL D
1603+ F6DE CB 1B            RR E
1604+ F6E0 18 04            JR .csbsWrite
1605+ F6E2              .csbsLeft:
1606+ F6E2 CB 23            SLA E
1607+ F6E4 CB 12            RL D
1608+ F6E6              .csbsWrite:
1609+ F6E6 7A               LD A, D
1610+ F6E7 77               LD (HL), A
1611+ F6E8 23               INC HL
1612+ F6E9 7B               LD A, E
1613+ F6EA 77               LD (HL), A
1614+ F6EB E1               POP HL
1615+ F6EC CD CE 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1616+ F6EF DD 23            INC IX
1617+ F6F1 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1618+ F6F3 C1               POP BC
1619+ F6F4 10 D1            DJNZ .csbsRow
1620+ F6F6 C9               RET
1621+ F6F7 00           .csbsJitter: DEFB 0
