1194+ A570 87               ADD A, A
1195+ A571 87               ADD A, A
1196+ A572 87               ADD A, A                    ; × 8 = width_px
1197+ A573 47               LD B, A
1198+ A574 13               INC DE
1199+ A575 1A               LD A, (DE)                  ; height_px
1200+ A576 4F               LD C, A
1201+ A577                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1202+ A577 78               LD A, B
1203+ A578 32 95 A5         LD (GsdSavedB), A
1204+ A57B 79               LD A, C
1205+ A57C 32 96 A5         LD (GsdSavedC), A
1206+ A57F 3A 8A 8D         LD A, (CurrentPaging)
1207+ A582 E6 F8            AND $F8
1208+ A584 32 8A 8D         LD (CurrentPaging), A
1209+ A587 01 FD 7F         LD BC, $7FFD
