 320+ E5A5 E2 03            DEFW $03E2                      ; A2  ~110 Hz
 321+ E5A7 09               DEFB 9                          ; ~360ms
 322+ E5A8 44 03            DEFW $0344                      ; C3  ~131 Hz
 323+ E5AA 09               DEFB 9
 324+ E5AB E2 03            DEFW $03E2                      ; A2
 325+ E5AD 09               DEFB 9
 326+ E5AE E9 02            DEFW $02E9                      ; D3  ~147 Hz (climax mas alto)
 327+ E5B0 0B               DEFB 11                         ; ~440ms sostenido
 328+ E5B1 00 00            DEFW 0
 329+ E5B3 00               DEFB 0                          ; fin
 330+ E5B4
 331+ E5B4              ; --- Track 1: SunriseMusic ---
 332+ E5B4              ; Arpegio ascendente C major + resolucion, ~5s. Borrador inicial — iterar.
 333+ E5B4              SunriseMusicTable:
 334+ E5B4 44 03            DEFW $0344                      ; C3  ~131 Hz
 335+ E5B6 06               DEFB 6
 336+ E5B7 97 02            DEFW $0297                      ; E3  ~165 Hz
 337+ E5B9 06               DEFB 6
 338+ E5BA 2E 02            DEFW $022E                      ; G3  ~196 Hz
 339+ E5BC 06               DEFB 6
 340+ E5BD A2 01            DEFW $01A2                      ; C4  ~262 Hz
 341+ E5BF 06               DEFB 6
 342+ E5C0 4C 01            DEFW $014C                      ; E4  ~330 Hz
 343+ E5C2 0C               DEFB 12                         ; sostenido
 344+ E5C3 A2 01            DEFW $01A2                      ; C4
 345+ E5C5 06               DEFB 6
 346+ E5C6 2E 02            DEFW $022E                      ; G3
 347+ E5C8 06               DEFB 6
 348+ E5C9 A2 01            DEFW $01A2                      ; C4
 349+ E5CB 06               DEFB 6
 350+ E5CC 4C 01            DEFW $014C                      ; E4
 351+ E5CE 06               DEFB 6
 352+ E5CF 17 01            DEFW $0117                      ; G4  ~392 Hz climax
 353+ E5D1 1E               DEFB 30                         ; ~1.2s final brillante
 354+ E5D2 00 00            DEFW 0
 355+ E5D4 00               DEFB 0
