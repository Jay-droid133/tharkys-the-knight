 904+ EE28 3D               DEC A
 905+ EE29 28 2A            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 906+ EE2B 3D               DEC A
 907+ EE2C CA 90 EE         JP Z, .urpDoRayo
 908+ EE2F 3D               DEC A
 909+ EE30 CA 9B EE         JP Z, .urpDoCaracol
 910+ EE33 3D               DEC A
 911+ EE34 CA E8 EE         JP Z, .urpDoRoulette
 912+ EE37 3D               DEC A
 913+ EE38 CA A6 EE         JP Z, .urpDoMushroom
 914+ EE3B 3D               DEC A
 915+ EE3C CA B1 EE         JP Z, .urpDoCompass                 ; ROLLED_COMPASS
 916+ EE3F 3D               DEC A
 917+ EE40 CA BC EE         JP Z, .urpDoEspada                  ; ROLLED_ESPADA
 918+ EE43 3D               DEC A
 919+ EE44 CA C7 EE         JP Z, .urpDoEscudo                  ; ROLLED_ESCUDO
 920+ EE47 3D               DEC A
 921+ EE48 CA D2 EE         JP Z, .urpDoEscudoRayo              ; ROLLED_ESCUDO_RAYO
 922+ EE4B C3 DD EE         JP .urpDoReverse                    ; ROLLED_REVERSE (resto)
