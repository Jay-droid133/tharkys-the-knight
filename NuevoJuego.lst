 764+ E879 6F               LD L, A
 765+ E87A 26 00            LD H, 0
 766+ E87C 29               ADD HL, HL
 767+ E87D 29               ADD HL, HL
 768+ E87E 29               ADD HL, HL
 769+ E87F 01 00 3C         LD BC, $3C00
 770+ E882 09               ADD HL, BC                  ; HL = font data
 771+ E883
 772+ E883                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 773+ E883 16 40            LD D, $40                   ; Tercio 0, scan line 0
 774+ E885 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 775+ E887 83               ADD A, E
 776+ E888 5F               LD E, A                     ; DE = dir VRAM
