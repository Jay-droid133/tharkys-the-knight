5785+ BEA3 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5786+ BEA7 DD 36 0A 00      LD (IX+ENT_DIR), 0
5787+ BEAB DD 36 06 00      LD (IX+ENT_DELTAX), 0
5788+ BEAF DD 36 07 00      LD (IX+ENT_DELTAY), 0
