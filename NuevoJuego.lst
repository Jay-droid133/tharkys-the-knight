 615  EA6F
 616  EA6F                  ; --- Random pickups body (~1.26 KB, slot 1 -> bank 7 move) ---
 617  EA6F                  ; Antes vivia en slot 1 entre $6BF7..$70E4. Movido aqui para liberar slot 1
 618  EA6F                  ; (RoomCompGapsTable y la IM2 table compiten por el espacio anterior a $7A00).
 619  EA6F                  ; Los 9 entry points externos (UpdateRandomPickup, UpdateRoulette, ...) viven
 620  EA6F                  ; como thunks en slot 1 (random_pickups_thunks.asm). El body usa _B7 wrappers
 621  EA6F                  ; (LoadBgSpriteToBuffer_B7, DrawBgSpriteXOR_B7, PlaySFX_B7, SkipPixelData_B7,
 622  EA6F                  ; RestorePickupAttrs_B7, ApplyMagicCompassBuff_B7) para envolver cada CALL
 623  EA6F                  ; externo. Internamente las dispatch tail-JPs (GiveLife etc.) usan los Body
 624  EA6F                  ; suffix (intra-bank, no thunk).
 625  EA6F                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ EA6F              ; ==============================================================================
   2+ EA6F              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ EA6F              ; ==============================================================================
   4+ EA6F              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ EA6F              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ EA6F              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ EA6F              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ EA6F              ; correspondiente desde CheckPickupCollect.
   9+ EA6F              ;
  10+ EA6F              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ EA6F              ; si en el futuro se ponen pickups fijos en el editor.
  12+ EA6F              ;
  13+ EA6F              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ EA6F              ; Bank 0/2 quedan limpios.
  15+ EA6F              ; ==============================================================================
  16+ EA6F
  17+ EA6F              ; ==============================================================================
  18+ EA6F              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ EA6F              ; ==============================================================================
  20+ EA6F              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ EA6F              ; el cambio via cache .dlhLast.
  22+ EA6F              ; ==============================================================================
  23+ EA6F              GiveLifeBody:
  24+ EA6F 3A E0 82         LD A, (PlayerLives)
  25+ EA72 FE 05            CP PLAYER_LIVES_MAX
  26+ EA74 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ EA75 3C               INC A
  28+ EA76 32 E0 82         LD (PlayerLives), A
  29+ EA79 C9               RET
  30+ EA7A
  31+ EA7A              ; ==============================================================================
  32+ EA7A              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ EA7A              ; ==============================================================================
  34+ EA7A              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ EA7A              ; ==============================================================================
  36+ EA7A              GiveHealthBody:
  37+ EA7A 3A 72 B3         LD A, (PlayerHealth)
  38+ EA7D C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ EA7F 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ EA81 FE 11            CP HEALTH_MAX + 1
  41+ EA83 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ EA85              .ghCap:
  43+ EA85 3E 10            LD A, HEALTH_MAX
  44+ EA87              .ghStore:
  45+ EA87 32 72 B3         LD (PlayerHealth), A
  46+ EA8A C9               RET
  47+ EA8B
  48+ EA8B              ; ==============================================================================
  49+ EA8B              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ EA8B              ; ==============================================================================
  51+ EA8B              GiveStaminaBody:
  52+ EA8B 3A 73 B3         LD A, (PlayerStamina)
  53+ EA8E C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ EA90 38 04            JR C, .gsCap
  55+ EA92 FE 11            CP STAMINA_MAX + 1
  56+ EA94 38 02            JR C, .gsStore
  57+ EA96              .gsCap:
  58+ EA96 3E 10            LD A, STAMINA_MAX
  59+ EA98              .gsStore:
  60+ EA98 32 73 B3         LD (PlayerStamina), A
  61+ EA9B C9               RET
  62+ EA9C
  63+ EA9C              ; ==============================================================================
  64+ EA9C              ; ROULETTE — datos
  65+ EA9C              ; ==============================================================================
  66+ EA9C              ; RouletteOrder: secuencia de type ids que recorre el ciclado. Tunable por
  67+ EA9C              ; el usuario — añadir/quitar/reordenar entries y rebuild. La longitud se
  68+ EA9C              ; calcula sola via ROULETTE_ORDER_LEN.
  69+ EA9C              RouletteOrder:
  70+ EA9C 01               DEFB ROUL_LIFE
  71+ EA9D 06               DEFB ROUL_MUSHROOM
  72+ EA9E 02               DEFB ROUL_HEALTH
  73+ EA9F 05               DEFB ROUL_CARACOL
  74+ EAA0 07               DEFB ROUL_COMPASS
  75+ EAA1 06               DEFB ROUL_MUSHROOM
  76+ EAA2 03               DEFB ROUL_STAMINA
  77+ EAA3 04               DEFB ROUL_RAYO
  78+ EAA4 05               DEFB ROUL_CARACOL
  79+ EAA5              RouletteOrderEnd:
  80+ EAA5              ROULETTE_ORDER_LEN  EQU RouletteOrderEnd - RouletteOrder
  81+ EAA5
  82+ EAA5              ; RouletteTypePtrs: tabla de lookup type id → BgGfx ptr. Indexada por
  83+ EAA5              ; (type-1)*2 — el id 0 esta sin usar (no aparece en RouletteOrder).
  84+ EAA5              RouletteTypePtrs:
  85+ EAA5 84 CC            DEFW BgGfx_life                                     ; ROUL_LIFE     = 1
  86+ EAA7 EC F1            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH   = 2
  87+ EAA9 91 E7            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA  = 3
  88+ EAAB BA E7            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO     = 4
  89+ EAAD E3 E7            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  90+ EAAF 0C E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  91+ EAB1 88 F1            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
  92+ EAB3
  93+ EAB3              ; ==============================================================================
  94+ EAB3              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ EAB3              ; ==============================================================================
  96+ EAB3              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  97+ EAB3              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  98+ EAB3              ;
  99+ EAB3              ; HEALTH y STAMINA: en lugar del ptr canonical de RouletteTypePtrs, se elige
 100+ EAB3              ; al azar entre las variantes (HealthVariantPtrs / StaminaVariantPtrs). Cada
 101+ EAB3              ; tick del ciclo (~480ms) que toque health o stamina muestra una variante
 102+ EAB3              ; potencialmente distinta — consistencia visual con el random pickup directo.
 103+ EAB3              ; ==============================================================================
 104+ EAB3              GetRoulettePtrByIdx:
 105+ EAB3 21 9C EA         LD HL, RouletteOrder
 106+ EAB6 5F               LD E, A
 107+ EAB7 16 00            LD D, 0
 108+ EAB9 19               ADD HL, DE
 109+ EABA 7E               LD A, (HL)                              ; A = type id (1..7)
 110+ EABB                  ; Intercept HEALTH / STAMINA -> tail call a PickRandomVariantPtr
 111+ EABB FE 02            CP ROUL_HEALTH
 112+ EABD 28 12            JR Z, .grpiHealth
 113+ EABF FE 03            CP ROUL_STAMINA
 114+ EAC1 28 14            JR Z, .grpiStamina
 115+ EAC3                  ; Resto: lookup en RouletteTypePtrs (canonical)
 116+ EAC3 3D               DEC A                                   ; idx 0-based para tabla ptrs
 117+ EAC4 26 00            LD H, 0
 118+ EAC6 6F               LD L, A
 119+ EAC7 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 120+ EAC8 11 A5 EA         LD DE, RouletteTypePtrs
 121+ EACB 19               ADD HL, DE
 122+ EACC 5E               LD E, (HL)
 123+ EACD 23               INC HL
 124+ EACE 56               LD D, (HL)
 125+ EACF EB               EX DE, HL                               ; HL = ptr
 126+ EAD0 C9               RET
 127+ EAD1              .grpiHealth:
 128+ EAD1 21 31 F0         LD HL, HealthVariantPtrs
 129+ EAD4 C3 45 F0         JP PickRandomVariantPtr                 ; tail call: HL=tabla -> HL=ptr
 130+ EAD7              .grpiStamina:
 131+ EAD7 21 3C F0         LD HL, StaminaVariantPtrs
 132+ EADA C3 45 F0         JP PickRandomVariantPtr
 133+ EADD
 134+ EADD              ; ==============================================================================
 135+ EADD              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 136+ EADD              ;                                 store los 4 attr bytes (TL,TR,BL,BR) del 2x2.
 137+ EADD              ; ==============================================================================
 138+ EADD              ; Antes guardaba solo attr[0] (TL) y PaintSynthPickupAttrs lo replicaba a las
 139+ EADD              ; 4 celdas, perdiendo el patrón per-celda del BG editor (ej: col1 bright,
 140+ EADD              ; col2 dim). Ahora extraemos los 4 → preservación 1:1.
 141+ EADD              ; ==============================================================================
 142+ EADD              LoadSynthSpriteAndExtractAttr:
 143+ EADD 22 B6 5F         LD (RandomSynthPtr), HL
 144+ EAE0 3E 03            LD A, 3
 145+ EAE2 CD 5B 6D         CALL LoadBgSpriteToBuffer_B7
 146+ EAE5 DD 21 F7 86      LD IX, BgSpriteBuffer
