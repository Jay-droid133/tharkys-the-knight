 605+ E839
 606+ E839              ; ==============================================================================
 607+ E839              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 608+ E839              ; ==============================================================================
 609+ E839
 610+ E839              ; ==============================================================================
 611+ E839              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 612+ E839              ; ==============================================================================
 613+ E839              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 614+ E839              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 615+ E839              ; ==============================================================================
 616+ E839              BuildPlazaScanAddrs:
 617+ E839                  ; Calcular pixel coords del top-left de la esfera
 618+ E839 3A 21 90         LD A, (PlazaClockCharY)
 619+ E83C 07               RLCA
 620+ E83D 07               RLCA
 621+ E83E 07               RLCA
 622+ E83F 57               LD D, A                     ; D = pixelY = charY * 8
 623+ E840 3A 20 90         LD A, (PlazaClockCharX)
 624+ E843 07               RLCA
 625+ E844 07               RLCA
 626+ E845 07               RLCA
 627+ E846 5F               LD E, A                     ; E = pixelX = charX * 8
 628+ E847 CD 1C A1         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 629+ E84A
 630+ E84A DD 21 22 90      LD IX, PlazaScanAddrs
 631+ E84E 06 10            LD B, 16
 632+ E850              .buildLoop:
 633+ E850 DD 75 00         LD (IX+0), L
 634+ E853 DD 74 01         LD (IX+1), H
 635+ E856 DD 23            INC IX
 636+ E858 DD 23            INC IX
 637+ E85A 05               DEC B
 638+ E85B C8               RET Z
 639+ E85C CD 88 9E         CALL NextPixelLine
 640+ E85F 18 EF            JR .buildLoop
 641+ E861
 642+ E861              ; ==============================================================================
 643+ E861              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 644+ E861              ; ==============================================================================
 645+ E861              ; Llamar cada frame desde el main loop.
 646+ E861              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 647+ E861              ; ==============================================================================
 648+ E861              DrawPlazaClock:
 649+ E861 3A 1F 90         LD A, (PlazaClockActive)
 650+ E864 B7               OR A
 651+ E865 C8               RET Z
 652+ E866
 653+ E866                  ; --- Calcular posicion actual de las agujas ---
 654+ E866 3A C8 E3         LD A, (GameHours)
 655+ E869 FE 0C            CP 12
 656+ E86B 38 02            JR C, .pCalcHourOk
 657+ E86D D6 0C            SUB 12
 658+ E86F              .pCalcHourOk:
 659+ E86F 57               LD D, A                     ; D = display hour (0-11)
 660+ E870 3A C7 E3         LD A, (GameMinutes)
 661+ E873 1E 00            LD E, 0
 662+ E875              .pCalcDiv5:
 663+ E875 FE 05            CP 5
 664+ E877 38 05            JR C, .pCalcMinOk
 665+ E879 D6 05            SUB 5
 666+ E87B 1C               INC E
 667+ E87C 18 F7            JR .pCalcDiv5
 668+ E87E              .pCalcMinOk:
 669+ E87E                  ; D = hour pos (0-11), E = minute pos (0-11)
 670+ E87E
 671+ E87E                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 672+ E87E 3A D2 E8         LD A, (PlazaLastHour)
 673+ E881 BA               CP D
 674+ E882 20 05            JR NZ, .pNeedsRedraw
 675+ E884 3A D3 E8         LD A, (PlazaLastMin)
 676+ E887 BB               CP E
 677+ E888 C8               RET Z                       ; sin cambio → no redibujar
 678+ E889
 679+ E889              .pNeedsRedraw:
 680+ E889 7A               LD A, D
 681+ E88A 32 D2 E8         LD (PlazaLastHour), A
 682+ E88D 7B               LD A, E
 683+ E88E 32 D3 E8         LD (PlazaLastMin), A
 684+ E891
 685+ E891                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 686+ E891                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 687+ E891 DD 21 F5 8C      LD IX, PlazaClockPixels
 688+ E895 FD 21 22 90      LD IY, PlazaScanAddrs
 689+ E899 06 10            LD B, 16
 690+ E89B              .faceRow:
 691+ E89B FD 6E 00         LD L, (IY+0)
 692+ E89E FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 693+ E8A1 DD 7E 00         LD A, (IX+0)
 694+ E8A4 2F               CPL                         ; des-invertir (dato CPL'd)
 695+ E8A5 77               LD (HL), A                  ; byte izquierdo
 696+ E8A6 23               INC HL
 697+ E8A7 DD 7E 01         LD A, (IX+1)
 698+ E8AA 2F               CPL
 699+ E8AB 77               LD (HL), A                  ; byte derecho
 700+ E8AC DD 23            INC IX
 701+ E8AE DD 23            INC IX
 702+ E8B0 FD 23            INC IY
 703+ E8B2 FD 23            INC IY
 704+ E8B4 10 E5            DJNZ .faceRow
 705+ E8B6
 706+ E8B6                  ; --- Aguja de horas ---
 707+ E8B6 3A D2 E8         LD A, (PlazaLastHour)
 708+ E8B9 21 C4 E4         LD HL, HourHandPtrs
 709+ E8BC CD D4 E8         CALL DrawPlazaHandLine
 710+ E8BF
 711+ E8BF                  ; --- Aguja de minutos ---
 712+ E8BF 3A D3 E8         LD A, (PlazaLastMin)
 713+ E8C2 21 E0 E3         LD HL, MinHandPtrs
 714+ E8C5 CD D4 E8         CALL DrawPlazaHandLine
 715+ E8C8
 716+ E8C8                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 717+ E8C8 21 30 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 718+ E8CB 7E               LD A, (HL)
 719+ E8CC 23               INC HL
 720+ E8CD 66               LD H, (HL)
 721+ E8CE 6F               LD L, A                     ; HL = dir VRAM scan line 7
 722+ E8CF CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 723+ E8D1 C9               RET
 724+ E8D2
 725+ E8D2              ; Variables locales reloj plaza
 726+ E8D2 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 727+ E8D3 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 728+ E8D4
 729+ E8D4              ; ==============================================================================
 730+ E8D4              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 731+ E8D4              ; ==============================================================================
 732+ E8D4              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 733+ E8D4              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 734+ E8D4              ; a posiciones relativas y las busca en PlazaScanAddrs.
 735+ E8D4              ; ==============================================================================
 736+ E8D4              DrawPlazaHandLine:
 737+ E8D4                  ; Indexar en tabla de punteros
 738+ E8D4 87               ADD A, A
 739+ E8D5 4F               LD C, A
 740+ E8D6 06 00            LD B, 0
 741+ E8D8 09               ADD HL, BC
 742+ E8D9 7E               LD A, (HL)
 743+ E8DA 23               INC HL
 744+ E8DB 66               LD H, (HL)
 745+ E8DC 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 746+ E8DD
 747+ E8DD              .pxLoop:
 748+ E8DD 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 749+ E8DE B7               OR A
 750+ E8DF C8               RET Z
 751+ E8E0
 752+ E8E0                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 753+ E8E0 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 754+ E8E1 23               INC HL
 755+ E8E2 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 756+ E8E3 23               INC HL
 757+ E8E4 56               LD D, (HL)                  ; D = mask
 758+ E8E5 23               INC HL
 759+ E8E6 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 760+ E8E7
 761+ E8E7                  ; --- Calcular scanLine (0-15) ---
 762+ E8E7 78               LD A, B
 763+ E8E8 E6 07            AND $07                     ; scan dentro del char row (0-7)
 764+ E8EA CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 765+ E8EC 28 02            JR Z, .pxIsTop
 766+ E8EE C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 767+ E8F0              .pxIsTop:
 768+ E8F0                  ; A = scanLine (0-15)
 769+ E8F0
 770+ E8F0                  ; --- Calcular colOffset (0 o 1) ---
 771+ E8F0 5F               LD E, A                     ; E = scanLine (guardar)
 772+ E8F1 79               LD A, C
 773+ E8F2 E6 1F            AND $1F                     ; extraer columna
 774+ E8F4 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 775+ E8F6 4F               LD C, A                     ; C = colOffset
 776+ E8F7
 777+ E8F7                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 778+ E8F7 7B               LD A, E                     ; A = scanLine
 779+ E8F8 87               ADD A, A                    ; *2 (word index)
 780+ E8F9 21 22 90         LD HL, PlazaScanAddrs
 781+ E8FC 85               ADD A, L
 782+ E8FD 6F               LD L, A
 783+ E8FE 30 01            JR NC, .pxNC
 784+ E900 24               INC H
 785+ E901              .pxNC:
 786+ E901 7E               LD A, (HL)
 787+ E902 23               INC HL
 788+ E903 66               LD H, (HL)
 789+ E904 81               ADD A, C                    ; sumar colOffset
 790+ E905 6F               LD L, A                     ; HL = dir VRAM destino
 791+ E906
 792+ E906                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 793+ E906 7A               LD A, D
 794+ E907 2F               CPL
 795+ E908 A6               AND (HL)
 796+ E909 77               LD (HL), A
 797+ E90A
 798+ E90A E1               POP HL                      ; restaurar puntero datos
 799+ E90B 18 D0            JR .pxLoop
