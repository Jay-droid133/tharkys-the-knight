1889+ A99C              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1890+ A99C              ; ==============================================================================
1891+ A99C              UpdateStamina:
1892+ A99C                  ; --- Regenerar salud (siempre, lento) ---
1893+ A99C 3A 5D B2         LD A, (PlayerHealth)
1894+ A99F FE 10            CP HEALTH_MAX
1895+ A9A1 28 12            JR Z, .usHealthFull
1896+ A9A3 21 61 B2         LD HL, HealthRegenCtr
1897+ A9A6 34               INC (HL)
1898+ A9A7 7E               LD A, (HL)
1899+ A9A8 FE 32            CP HEALTH_REGEN_RATE
1900+ A9AA 38 09            JR C, .usHealthFull
1901+ A9AC 36 00            LD (HL), 0
1902+ A9AE 3A 5D B2         LD A, (PlayerHealth)
1903+ A9B1 3C               INC A
1904+ A9B2 32 5D B2         LD (PlayerHealth), A
1905+ A9B5              .usHealthFull:
1906+ A9B5                  ; --- Stamina: consumir o regenerar ---
1907+ A9B5 DD 7E 02         LD A, (IX+ENT_STATE)
1908+ A9B8 FE 02            CP STATE_FIGHTING
1909+ A9BA 28 18            JR Z, .usDrain
1910+ A9BC                  ; No atacando: regenerar
1911+ A9BC 3A 5E B2         LD A, (PlayerStamina)
1912+ A9BF FE 10            CP STAMINA_MAX
1913+ A9C1 C8               RET Z                               ; Ya al maximo
1914+ A9C2 21 60 B2         LD HL, StaminaRegenCtr
1915+ A9C5 34               INC (HL)
1916+ A9C6 7E               LD A, (HL)
1917+ A9C7 FE 19            CP STAMINA_REGEN_RATE
1918+ A9C9 D8               RET C                               ; Aun no toca
1919+ A9CA 36 00            LD (HL), 0                          ; Reset counter
1920+ A9CC 3A 5E B2         LD A, (PlayerStamina)
1921+ A9CF 3C               INC A
1922+ A9D0 32 5E B2         LD (PlayerStamina), A
1923+ A9D3 C9               RET
1924+ A9D4              .usDrain:
1925+ A9D4                  ; Atacando: consumir stamina
1926+ A9D4 3A 5E B2         LD A, (PlayerStamina)
1927+ A9D7 B7               OR A
1928+ A9D8 C8               RET Z                               ; Ya vacia
1929+ A9D9 21 5F B2         LD HL, StaminaDrainCtr
1930+ A9DC 34               INC (HL)
1931+ A9DD 7E               LD A, (HL)
1932+ A9DE FE 0D            CP STAMINA_DRAIN_RATE
1933+ A9E0 D8               RET C
1934+ A9E1 36 00            LD (HL), 0
1935+ A9E3 3A 5E B2         LD A, (PlayerStamina)
1936+ A9E6 3D               DEC A
1937+ A9E7 32 5E B2         LD (PlayerStamina), A
1938+ A9EA                  ; Si stamina llega a 0, dar 1 punto tras cooldown
1939+ A9EA B7               OR A
1940+ A9EB C0               RET NZ
1941+ A9EC 3E 01            LD A, 1
1942+ A9EE 32 5E B2         LD (PlayerStamina), A               ; Minimo 1 para un swing
1943+ A9F1 C9               RET
