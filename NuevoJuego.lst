 255+ 9AD0              ; ==============================================================================
 256+ 9AD0              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9AD0              ; ==============================================================================
 258+ 9AD0              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9AD0              ; Entrada:
 260+ 9AD0              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9AD0              ;   A = atributo a pintar
 262+ 9AD0              ; ==============================================================================
 263+ 9AD0              SetEntityAttr:
 264+ 9AD0 F5               PUSH AF                     ; Guardar atributo
 265+ 9AD1 CD 38 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9AD4 F1               POP AF
