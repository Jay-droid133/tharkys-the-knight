5300+ BC2C              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5301+ BC2C              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5302+ BC2C              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5303+ BC2C              CheckMonsterOverlap:
5304+ BC2C C5               PUSH BC
5305+ BC2D FD E5            PUSH IY
5306+ BC2F FD 21 A4 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5307+ BC33 06 06            LD B, NUM_MONSTERS
5308+ BC35              .cmoLoop:
5309+ BC35                  ; Skip self (IY == IX)
5310+ BC35 DD E5            PUSH IX
5311+ BC37 E1               POP HL
5312+ BC38 FD E5            PUSH IY
5313+ BC3A D1               POP DE
5314+ BC3B B7               OR A
5315+ BC3C ED 52            SBC HL, DE
5316+ BC3E 28 3D            JR Z, .cmoNext                  ; same slot
5317+ BC40
5318+ BC40 FD 7E 01         LD A, (IY+ENT_TYPE)
5319+ BC43 FE 02            CP TYPE_MONSTER
5320+ BC45 20 36            JR NZ, .cmoNext
5321+ BC47
5322+ BC47                  ; AABB overlap (rect 16x21 cada uno):
5323+ BC47                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5324+ BC47                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5325+ BC47 DD 7E 03         LD A, (IX+ENT_POSX)
5326+ BC4A C6 10            ADD A, 16
5327+ BC4C 4F               LD C, A
5328+ BC4D FD 7E 03         LD A, (IY+ENT_POSX)
5329+ BC50 B9               CP C                            ; iy.x cmp ix.x+16
5330+ BC51 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5331+ BC53 FD 7E 03         LD A, (IY+ENT_POSX)
5332+ BC56 C6 10            ADD A, 16
5333+ BC58 4F               LD C, A
5334+ BC59 DD 7E 03         LD A, (IX+ENT_POSX)
5335+ BC5C B9               CP C
5336+ BC5D 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5337+ BC5F DD 7E 04         LD A, (IX+ENT_POSY)
5338+ BC62 C6 15            ADD A, 21
5339+ BC64 4F               LD C, A
5340+ BC65 FD 7E 04         LD A, (IY+ENT_POSY)
5341+ BC68 B9               CP C
5342+ BC69 30 12            JR NC, .cmoNext
5343+ BC6B FD 7E 04         LD A, (IY+ENT_POSY)
5344+ BC6E C6 15            ADD A, 21
5345+ BC70 4F               LD C, A
5346+ BC71 DD 7E 04         LD A, (IX+ENT_POSY)
5347+ BC74 B9               CP C
5348+ BC75 30 06            JR NC, .cmoNext
5349+ BC77                  ; Overlap en ambos ejes
5350+ BC77 FD E1            POP IY
5351+ BC79 C1               POP BC
5352+ BC7A F6 01            OR 1                            ; NZ
5353+ BC7C C9               RET
5354+ BC7D              .cmoNext:
5355+ BC7D 11 10 00         LD DE, ENT_SIZE
5356+ BC80 FD 19            ADD IY, DE
5357+ BC82 10 B1            DJNZ .cmoLoop
5358+ BC84 FD E1            POP IY
5359+ BC86 C1               POP BC
5360+ BC87 AF               XOR A                           ; Z = no overlap
5361+ BC88 C9               RET
5362+ BC89
5363+ BC89              ; ==============================================================================
5364+ BC89              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5365+ BC89              ; ==============================================================================
5366+ BC89              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5367+ BC89              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5368+ BC89              ; ==============================================================================
5369+ BC89              KillAllActiveMonsters:
5370+ BC89 AF               XOR A
5371+ BC8A 32 51 B3         LD (MonstersActive), A              ; No respawnear mas
5372+ BC8D DD 21 A4 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5373+ BC91 06 06            LD B, NUM_MONSTERS
5374+ BC93              .kamLoop:
5375+ BC93 C5               PUSH BC
5376+ BC94 DD 7E 01         LD A, (IX+ENT_TYPE)
5377+ BC97 B7               OR A
5378+ BC98 28 27            JR Z, .kamSkip                      ; slot vacio
5379+ BC9A FE 02            CP TYPE_MONSTER
5380+ BC9C 20 23            JR NZ, .kamSkip                     ; no es monster
5381+ BC9E DD 7E 02         LD A, (IX+ENT_STATE)
5382+ BCA1 FE 03            CP STATE_DYING
5383+ BCA3 28 1C            JR Z, .kamSkip
5384+ BCA5 FE 04            CP STATE_SPAWNING
5385+ BCA7 28 18            JR Z, .kamSkip
5386+ BCA9 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5387+ BCAD DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5388+ BCB1 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5389+ BCB5 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5390+ BCB9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5391+ BCBD DD 36 07 00      LD (IX+ENT_DELTAY), 0
5392+ BCC1                  ; ENT_ATTR conservado: puff hereda color del monster
5393+ BCC1              .kamSkip:
5394+ BCC1 11 10 00         LD DE, ENT_SIZE
5395+ BCC4 DD 19            ADD IX, DE
5396+ BCC6 C1               POP BC
5397+ BCC7 10 CA            DJNZ .kamLoop
5398+ BCC9 C9               RET
5399+ BCCA
5400+ BCCA              ; --- Tabla de tipos de nasty (SpriteID base) ---
5401+ BCCA              ; --- Tablas de nasties por momento del dia ---
5402+ BCCA              NUM_NASTY_TYPES EQU 4
5403+ BCCA              DiurnalTypeTable:                       ; DY, C1, A2
5404+ BCCA 30               DEFB SPRID_ENEMY_4          ; Eagle
5405+ BCCB 20               DEFB SPRID_ENEMY_0          ; Spider
5406+ BCCC 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5407+ BCCD 2C               DEFB SPRID_ENEMY_3          ; Snake
5408+ BCCE              CrepuscularTypeTable:                   ; C2, N1
5409+ BCCE 34               DEFB SPRID_ENEMY_5          ; Rat
5410+ BCCF 28               DEFB SPRID_ENEMY_2          ; Bat
5411+ BCD0 24               DEFB SPRID_ENEMY_1          ; Scorpion
5412+ BCD1 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5413+ BCD2
5414+ BCD2              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5415+ BCD2              NastyColorTable:
5416+ BCD2 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5417+ BCD3 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5418+ BCD4 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5419+ BCD5 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5420+ BCD6 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5421+ BCD7 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5422+ BCD8 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5423+ BCD9 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5424+ BCDA
5425+ BCDA              ; --- Tabla de comportamiento depredador ---
5426+ BCDA              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5427+ BCDA              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5428+ BCDA              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5429+ BCDA              PredatorTable:
5430+ BCDA 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5431+ BCDB 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5432+ BCDC 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5433+ BCDD 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5434+ BCDE 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5435+ BCDF 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5436+ BCE0 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5437+ BCE1 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5438+ BCE2
5439+ BCE2              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5440+ BCE2              PredatorSpeedTable:
5441+ BCE2 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5442+ BCE3 02               DEFB 2                              ; Ciclo 1: lento
5443+ BCE4 03               DEFB 3                              ; Ciclo 2: intermedio
5444+ BCE5 04               DEFB 4                              ; Ciclo 3+: rapido
5445+ BCE6
5446+ BCE6 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5447+ BCE7
5448+ BCE7 CA BC        CurrentNastyTable: DEFW DiurnalTypeTable
5449+ BCE9
5450+ BCE9              ; ==============================================================================
5451+ BCE9              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5452+ BCE9              ; ==============================================================================
5453+ BCE9              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5454+ BCE9              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5455+ BCE9              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5456+ BCE9              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5457+ BCE9              ;   pantalla, no diurnos.
5458+ BCE9              ; ==============================================================================
5459+ BCE9              UpdateNastyTable:
5460+ BCE9 3A 55 E3         LD A, (CurrentTimeOfDay)
5461+ BCEC FE 02            CP 2
5462+ BCEE 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5463+ BCF0 FE 06            CP 6
5464+ BCF2 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5465+ BCF4 21 CE BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5466+ BCF7 18 03            JR .setTable
5467+ BCF9              .diurnal:
5468+ BCF9 21 CA BC         LD HL, DiurnalTypeTable
5469+ BCFC              .setTable:
5470+ BCFC 22 E7 BC         LD (CurrentNastyTable), HL
5471+ BCFF C9               RET
5472+ BD00
5473+ BD00              ; ==============================================================================
5474+ BD00              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5475+ BD00              ; ==============================================================================
5476+ BD00              ScareAllMonsters:
5477+ BD00 AF               XOR A
5478+ BD01 32 51 B3         LD (MonstersActive), A              ; No respawnear mas
5479+ BD04                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5480+ BD04                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5481+ BD04                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5482+ BD04 21 8C 8D         LD HL, MonsterAiFlags
5483+ BD07 06 03            LD B, 3
5484+ BD09              .samClearLoop:
5485+ BD09 7E               LD A, (HL)
5486+ BD0A E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5487+ BD0C 77               LD (HL), A
5488+ BD0D 23               INC HL
5489+ BD0E 10 F9            DJNZ .samClearLoop
5490+ BD10 3E 7D            LD A, SCARE_TIMER_DAWN
5491+ BD12 32 E7 B5         LD (ScareTimer), A
5492+ BD15                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5493+ BD15                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5494+ BD15                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5495+ BD15                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5496+ BD15 DD 21 A4 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5497+ BD19 06 06            LD B, NUM_MONSTERS
5498+ BD1B              .samStateLoop:
5499+ BD1B DD 7E 01         LD A, (IX+ENT_TYPE)
5500+ BD1E FE 02            CP TYPE_MONSTER
5501+ BD20 20 1B            JR NZ, .samStateNext
5502+ BD22 DD 7E 02         LD A, (IX+ENT_STATE)
5503+ BD25 FE 03            CP STATE_DYING
5504+ BD27 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5505+ BD29 FE 04            CP STATE_SPAWNING
5506+ BD2B 28 10            JR Z, .samStateNext
5507+ BD2D DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5508+ BD31 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5509+ BD35 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5510+ BD39 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5511+ BD3D              .samStateNext:
5512+ BD3D 11 10 00         LD DE, ENT_SIZE
5513+ BD40 DD 19            ADD IX, DE
5514+ BD42 10 D7            DJNZ .samStateLoop
5515+ BD44 C9               RET
5516+ BD45
5517+ BD45              ; ==============================================================================
5518+ BD45              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5519+ BD45              ; ==============================================================================
5520+ BD45              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5521+ BD45              ; ==============================================================================
5522+ BD45
5523+ BD45              ; ==============================================================================
5524+ BD45              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5525+ BD45              ; ==============================================================================
5526+ BD45              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5527+ BD45              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5528+ BD45              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5529+ BD45              ; ==============================================================================
5530+ BD45              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5531+ BD45              ; ==============================================================================
5532+ BD45              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5533+ BD45              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5534+ BD45              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5535+ BD45              ; ==============================================================================
5536+ BD45              MONSTERS_TO_SPAWN   EQU 3
5537+ BD45              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5538+ BD45              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5539+ BD45
5540+ BD45              ; ==============================================================================
5541+ BD45              ; SpawnMonsters - Primera aparicion tras campanadas
5542+ BD45              ; ==============================================================================
5543+ BD45              SpawnMonsters:
5544+ BD45                  IF DEBUG_NO_ENEMIES
5545+ BD45 ~                RET
5546+ BD45                  ENDIF
5547+ BD45 3A 51 B3         LD A, (MonstersActive)
5548+ BD48 B7               OR A
5549+ BD49 C0               RET NZ
5550+ BD4A                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5551+ BD4A                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5552+ BD4A CD 26 BA         CALL KillAllActiveNasties
5553+ BD4D 3E 01            LD A, 1
5554+ BD4F 32 51 B3         LD (MonstersActive), A
5555+ BD52 CD CF BD         CALL ShuffleMonsterTypes
5556+ BD55 DD 21 A4 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5557+ BD59 06 03            LD B, MONSTERS_TO_SPAWN
5558+ BD5B 0E 00            LD C, 0
5559+ BD5D              .smLoop:
5560+ BD5D C5               PUSH BC
5561+ BD5E DD 7E 01         LD A, (IX+ENT_TYPE)
5562+ BD61 B7               OR A
5563+ BD62 C2 BE BD         JP NZ, .smSkip
5564+ BD65                  ; Asignar tipo y color
5565+ BD65 79               LD A, C
5566+ BD66 21 33 BE         LD HL, MonsterTypeTable
5567+ BD69 5F               LD E, A
5568+ BD6A 16 00            LD D, 0
5569+ BD6C 19               ADD HL, DE
5570+ BD6D 7E               LD A, (HL)
5571+ BD6E DD 77 08         LD (IX+ENT_ANIMBASE), A
5572+ BD71 79               LD A, C
5573+ BD72 21 36 BE         LD HL, MonsterColorTable
5574+ BD75 5F               LD E, A
5575+ BD76 16 00            LD D, 0
5576+ BD78 19               ADD HL, DE
5577+ BD79 7E               LD A, (HL)
5578+ BD7A DD 77 05         LD (IX+ENT_ATTR), A
5579+ BD7D                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5580+ BD7D C5               PUSH BC
5581+ BD7E CD B1 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5582+ BD81 B7               OR A
5583+ BD82 20 0E            JR NZ, .smFallbackPos
5584+ BD84 3A B9 97         LD A, (MaiSpawnX)
5585+ BD87 DD 77 03         LD (IX+ENT_POSX), A
5586+ BD8A 3A BA 97         LD A, (MaiSpawnY)
5587+ BD8D DD 77 04         LD (IX+ENT_POSY), A
5588+ BD90 18 0C            JR .smPosDone
5589+ BD92              .smFallbackPos:
5590+ BD92 3A 07 83         LD A, (LastEntryPosX)
5591+ BD95 DD 77 03         LD (IX+ENT_POSX), A
5592+ BD98 3A 08 83         LD A, (LastEntryPosY)
5593+ BD9B DD 77 04         LD (IX+ENT_POSY), A
5594+ BD9E              .smPosDone:
5595+ BD9E C1               POP BC
5596+ BD9F                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5597+ BD9F DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5598+ BDA3 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5599+ BDA7 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5600+ BDAB DD 36 06 00      LD (IX+ENT_DELTAX), 0
5601+ BDAF DD 36 07 00      LD (IX+ENT_DELTAY), 0
5602+ BDB3                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5603+ BDB3                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5604+ BDB3                  ; lo empuje a un vecino (migracion por knockback).
5605+ BDB3 CD A6 8E         CALL MaiGetCurrentScreenId
5606+ BDB6 21 80 8D         LD HL, MonsterRoomId
5607+ BDB9 59               LD E, C
5608+ BDBA 16 00            LD D, 0
5609+ BDBC 19               ADD HL, DE
5610+ BDBD 77               LD (HL), A
5611+ BDBE              .smSkip:
5612+ BDBE 11 10 00         LD DE, ENT_SIZE
5613+ BDC1 DD 19            ADD IX, DE
5614+ BDC3 C1               POP BC
5615+ BDC4 0C               INC C
5616+ BDC5 05               DEC B
5617+ BDC6 C2 5D BD         JP NZ, .smLoop
5618+ BDC9 3E 14            LD A, MONSTER_ENTRY_BASE
5619+ BDCB 32 1D BF         LD (TryRespawnMonsters.rmTimer), A
5620+ BDCE                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5621+ BDCE                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5622+ BDCE                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5623+ BDCE C9               RET
5624+ BDCF
5625+ BDCF              ; --- Barajar tablas tipo/color ---
5626+ BDCF              ShuffleMonsterTypes:
5627+ BDCF ED 5F            LD A, R
5628+ BDD1 E6 03            AND 3
5629+ BDD3 C8               RET Z
5630+ BDD4 FE 01            CP 1
5631+ BDD6 28 21            JR Z, .shSwap01
5632+ BDD8 FE 02            CP 2
5633+ BDDA 28 3A            JR Z, .shSwap12
5634+ BDDC 3A 33 BE         LD A, (MonsterTypeTable)
5635+ BDDF 57               LD D, A
5636+ BDE0 3A 35 BE         LD A, (MonsterTypeTable + 2)
5637+ BDE3 32 33 BE         LD (MonsterTypeTable), A
5638+ BDE6 7A               LD A, D
5639+ BDE7 32 35 BE         LD (MonsterTypeTable + 2), A
5640+ BDEA 3A 36 BE         LD A, (MonsterColorTable)
5641+ BDED 57               LD D, A
5642+ BDEE 3A 38 BE         LD A, (MonsterColorTable + 2)
5643+ BDF1 32 36 BE         LD (MonsterColorTable), A
5644+ BDF4 7A               LD A, D
5645+ BDF5 32 38 BE         LD (MonsterColorTable + 2), A
5646+ BDF8 C9               RET
5647+ BDF9              .shSwap01:
5648+ BDF9 3A 33 BE         LD A, (MonsterTypeTable)
5649+ BDFC 57               LD D, A
