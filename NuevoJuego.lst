 807+ EDB9 32 B9 5F         LD (RandomSynthCharY), A
 808+ EDBC
 809+ EDBC                  ; --- Roll type usando R XOR SYS_FRAMES ---
 810+ EDBC                  IF DEBUG_FORCE_COMPASS
 811+ EDBC ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 812+ EDBC ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 813+ EDBC ~                    JP .urpDoCompass
 814+ EDBC                  ENDIF
 815+ EDBC                  IF DEBUG_FORCE_MUSHROOM
 816+ EDBC ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 817+ EDBC ~                    JP .urpDoMushroom
 818+ EDBC                  ENDIF
 819+ EDBC                  IF DEBUG_FORCE_ROULETTE
 820+ EDBC ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 821+ EDBC ~                    JP .urpDoRoulette
 822+ EDBC                  ENDIF
 823+ EDBC                  IF DEBUG_FORCE_COLOR_CHANGER
 824+ EDBC ~                    ; DEBUG: rotar entre RAYO/CARACOL/MUSHROOM al 33% para testar el color
 825+ EDBC ~                    ; cycler. R XOR SYS_FRAMES da pseudo-random uniform 0..255, partido en
 826+ EDBC ~                    ; 3 bandas de 85.3 c/u.
 827+ EDBC ~                    LD A, R
 828+ EDBC ~                    LD HL, $5C78
 829+ EDBC ~                    XOR (HL)
 830+ EDBC ~                    CP 85
 831+ EDBC ~                    JP C, .urpDoRayo
 832+ EDBC ~                    CP 170
 833+ EDBC ~                    JP C, .urpDoCaracol
 834+ EDBC ~                    JP .urpDoMushroom
 835+ EDBC                  ENDIF
 836+ EDBC                  IF DEBUG_FORCE_NEW_BUFFS
 837+ EDBC ~                    ; DEBUG: rotar entre ESPADA/ESCUDO/ESCUDO_RAYO al 33% para testar
 838+ EDBC ~                    ; fase 3 (buffs nuevos).
 839+ EDBC ~                    LD A, R
 840+ EDBC ~                    LD HL, $5C78
 841+ EDBC ~                    XOR (HL)
 842+ EDBC ~                    CP 85
 843+ EDBC ~                    JP C, .urpDoEspada
 844+ EDBC ~                    CP 170
 845+ EDBC ~                    JP C, .urpDoEscudo
 846+ EDBC ~                    JP .urpDoEscudoRayo
 847+ EDBC                  ENDIF
 848+ EDBC                  IF DEBUG_FORCE_REVERSE
 849+ EDBC ~                    ; DEBUG: forzar siempre REVERSE para testar fase 4.
 850+ EDBC ~                    JP .urpDoReverse
 851+ EDBC                  ENDIF
 852+ EDBC ED 5F            LD A, R
 853+ EDBE 21 78 5C         LD HL, $5C78
 854+ EDC1 AE               XOR (HL)
 855+ EDC2                  ; Bands cumulativos. Orden de chequeo en codigo NO afecta las
 856+ EDC2                  ; probabilidades — solo importa los valores de PROB_*_END. Aqui van
 857+ EDC2                  ; agrupados por categoria (Recursos, Especiales, Buffs, Debuffs, Meta).
 858+ EDC2                  ; JP C (no JR C) por rango con cache hit dispatch.
 859+ EDC2                  ; --- Recursos ---
 860+ EDC2 FE 14            CP PROB_HEALTH_END
