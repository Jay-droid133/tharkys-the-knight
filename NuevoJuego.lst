 327  9C5A                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 328  9C5A                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 329  9C5A                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9C5A              ; ==============================================================================
   2+ 9C5A              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9C5A              ; ==============================================================================
   4+ 9C5A              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9C5A              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9C5A              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9C5A              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9C5A              ;
   9+ 9C5A              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9C5A              ; fallo en el intento previo):
  11+ 9C5A              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9C5A              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9C5A              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9C5A              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9C5A              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9C5A              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9C5A              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9C5A              ;
  19+ 9C5A              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9C5A              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9C5A              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9C5A              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9C5A              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9C5A              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9C5A              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9C5A              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9C5A              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9C5A              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9C5A              ; ==============================================================================
  30+ 9C5A
  31+ 9C5A              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9C5A              AY_Init:
  33+ 9C5A F3               DI
  34+ 9C5B 3A C9 90         LD A, (CurrentPaging)
  35+ 9C5E E6 F8            AND $F8
  36+ 9C60 F6 04            OR 4
  37+ 9C62 32 C9 90         LD (CurrentPaging), A
  38+ 9C65 01 FD 7F         LD BC, $7FFD
  39+ 9C68 ED 79            OUT (C), A
  40+ 9C6A CD 7E E4         CALL AY_InitImpl
  41+ 9C6D 3A C9 90         LD A, (CurrentPaging)
  42+ 9C70 E6 F8            AND $F8
  43+ 9C72 32 C9 90         LD (CurrentPaging), A
  44+ 9C75 01 FD 7F         LD BC, $7FFD
  45+ 9C78 ED 79            OUT (C), A
  46+ 9C7A 3A 35 81         LD A, (StartupComplete)
  47+ 9C7D B7               OR A
  48+ 9C7E C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9C7F FB               EI
  50+ 9C80 C9               RET
  51+ 9C81
