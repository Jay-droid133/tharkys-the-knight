 367+ 72EB E6 0F            AND $0F                              ; R % 16
 368+ 72ED 28 0E            JR Z, .cmcpTryE                      ; col 0 → no W neighbor
 369+ 72EF 3A E5 73         LD A, (.cmcpR)
 370+ 72F2 3D               DEC A
 371+ 72F3 CD 2A 73         CALL .cmcpVisitNeighbor
 372+ 72F6 3A E7 73         LD A, (.cmcpFound)
 373+ 72F9 B7               OR A
 374+ 72FA C2 1D 73         JP NZ, .cmcpFoundDone
