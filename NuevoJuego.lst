   9+ 784E              ;       bits 0-1 = side (0=N, 1=S, 2=W, 3=E)
  10+ 784E              ;       bits 2-3 = local comp idx (0..2)
  11+ 784E              ;     coord: char col (0-31) N/S; char row (0-21) W/E (mismo que ScreenGaps)
