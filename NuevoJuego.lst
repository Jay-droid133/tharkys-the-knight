2725+ DA7D              ; ==============================================================================
2726+ DA7D              ; BuildPickupRectCache - Para cada pickup ACTIVO (no dormant) en la pantalla
2727+ DA7D              ; actual, lee H/W del sprite header y guarda (charX, charY, charXEnd, charYEnd)
2728+ DA7D              ; inclusivo en PickupRectCache. Llamada al final de DrawScreen y tras
2729+ DA7D              ; RedrawPickupByPtr (cuando un pickup pasa de dormant->active).
2730+ DA7D              ; Usado por RestoreOldAttr para AABB-check sin paginar bank cada frame.
2731+ DA7D              ; Tambien resetea PickupAttrsDirty (DrawScreen acaba de pintar attrs frescos).
2732+ DA7D              ; Destruye: AF, BC, DE, HL.
2733+ DA7D              ; ==============================================================================
2734+ DA7D              BuildPickupRectCache:
2735+ DA7D AF               XOR A
2736+ DA7E 32 17 83         LD (NumPickupsCached), A
2737+ DA81 32 16 83         LD (PickupAttrsDirty), A    ; attrs frescos tras DrawScreen
2738+ DA84 21 26 DF         LD HL, PickupTable
2739+ DA87              .bprcLoop:
2740+ DA87 7E               LD A, (HL)
2741+ DA88 FE FF            CP $FF
2742+ DA8A C8               RET Z
2743+ DA8B FE FE            CP $FE
2744+ DA8D 28 7E            JR Z, .bprcInactive
2745+ DA8F 47               LD B, A                     ; B = mapX
2746+ DA90 23               INC HL
2747+ DA91 4E               LD C, (HL)                  ; C = mapY
2748+ DA92 23               INC HL                      ; HL -> ptr_lo
2749+ DA93 3A 0B 83         LD A, (CurrentScreenX)
2750+ DA96 B8               CP B
2751+ DA97 20 6D            JR NZ, .bprcSkipFromPtrLo
2752+ DA99 3A 0C 83         LD A, (CurrentScreenY)
2753+ DA9C B9               CP C
2754+ DA9D 20 67            JR NZ, .bprcSkipFromPtrLo
2755+ DA9F                  ; Pickup en esta sala. Leer ptr.
2756+ DA9F 5E               LD E, (HL)
2757+ DAA0 23               INC HL
2758+ DAA1 56               LD D, (HL)                  ; DE = BgGfx ptr
2759+ DAA2 23               INC HL                      ; HL -> charX
2760+ DAA3                  ; Random pickup marker: no es pickup activo (no se dibuja). No cachear.
2761+ DAA3 E5               PUSH HL
2762+ DAA4 21 7C D8         LD HL, BgGfx_random_pickup
2763+ DAA7 B7               OR A
2764+ DAA8 ED 52            SBC HL, DE
2765+ DAAA E1               POP HL
2766+ DAAB 28 53            JR Z, .bprcSkipFromCharX
2767+ DAAD                  ; Dormant? IsPickupDormant preserva BC, DE, HL.
2768+ DAAD CD 83 D7         CALL IsPickupDormant
2769+ DAB0 20 4E            JR NZ, .bprcSkipFromCharX
2770+ DAB2                  ; Cache lleno?
2771+ DAB2 3A 17 83         LD A, (NumPickupsCached)
2772+ DAB5 FE 08            CP MAX_PICKUPS_CACHED
2773+ DAB7 30 47            JR NC, .bprcSkipFromCharX
2774+ DAB9                  ; Cargar header del sprite (necesario para H, W).
2775+ DAB9 E5               PUSH HL                     ; save HL @ charX
2776+ DABA EB               EX DE, HL                   ; HL = BgGfx ptr
2777+ DABB 3E 03            LD A, 3
2778+ DABD CD C2 6C         CALL LoadBgSpriteToBuffer   ; preserva BC
2779+ DAC0 E1               POP HL                      ; HL @ charX
2780+ DAC1                  ; Append a cache: IX = PickupRectCache + idx*4
2781+ DAC1 E5               PUSH HL                     ; save HL @ charX
2782+ DAC2 3A 17 83         LD A, (NumPickupsCached)
2783+ DAC5 3C               INC A
2784+ DAC6 32 17 83         LD (NumPickupsCached), A
2785+ DAC9 3D               DEC A
2786+ DACA 87               ADD A, A
2787+ DACB 87               ADD A, A                    ; A = idx*4
2788+ DACC 5F               LD E, A
2789+ DACD 16 00            LD D, 0
2790+ DACF 21 18 83         LD HL, PickupRectCache
2791+ DAD2 19               ADD HL, DE                  ; HL = slot
2792+ DAD3 E5               PUSH HL
2793+ DAD4 DD E1            POP IX                      ; IX = slot
2794+ DAD6 E1               POP HL                      ; HL @ charX
2795+ DAD7                  ; Escribir [0]=charX, [2]=charXEnd
2796+ DAD7 7E               LD A, (HL)                  ; charX
2797+ DAD8 DD 77 00         LD (IX+0), A
2798+ DADB 47               LD B, A                     ; B = charX
2799+ DADC 3A F9 86         LD A, (BgSpriteBuffer + 1)
2800+ DADF E6 7F            AND $7F                     ; charW (bit 7 = RLE flag, ignorar)
2801+ DAE1 80               ADD A, B
2802+ DAE2 3D               DEC A                       ; charXEnd = charX + W - 1
2803+ DAE3 DD 77 02         LD (IX+2), A
2804+ DAE6 23               INC HL                      ; HL @ charY
2805+ DAE7                  ; Escribir [1]=charY (con BG_Y_OFFSET para alinear con ATTR_BASE), [3]=charYEnd
2806+ DAE7 7E               LD A, (HL)
2807+ DAE8 C6 02            ADD A, BG_Y_OFFSET
2808+ DAEA DD 77 01         LD (IX+1), A
2809+ DAED 47               LD B, A                     ; B = charY post-offset
2810+ DAEE 3A F8 86         LD A, (BgSpriteBuffer)      ; H_px
2811+ DAF1 CB 3F            SRL A
2812+ DAF3 CB 3F            SRL A
2813+ DAF5 CB 3F            SRL A                       ; charH
2814+ DAF7 80               ADD A, B
2815+ DAF8 3D               DEC A                       ; charYEnd
2816+ DAF9 DD 77 03         LD (IX+3), A
2817+ DAFC                  ; HL @ charY. Skip 2 (charY, tint) al siguiente mapX.
2818+ DAFC 23               INC HL
2819+ DAFD 23               INC HL
2820+ DAFE 18 87            JR .bprcLoop
