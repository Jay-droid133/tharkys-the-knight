  19+ 90DD              ; MaiComputeFlowField
  20+ 90DD              ; ==============================================================================
  21+ 90DD              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 90DD              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 90DD              ; quedan en $FF).
  24+ 90DD              ;
  25+ 90DD              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 90DD              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 90DD              ;
  28+ 90DD              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 90DD              ; Output: FlowField relleno en bank 6
  30+ 90DD              ; Destruye: AF, BC, DE, HL
  31+ 90DD              ; ==============================================================================
  32+ 90DD              MaiComputeFlowField:
  33+ 90DD                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 90DD 3A 39 81         LD A, (EntityTable + ENT_POSX)
  35+ 90E0 0F               RRCA
  36+ 90E1 0F               RRCA
  37+ 90E2 0F               RRCA
  38+ 90E3 E6 1F            AND $1F
  39+ 90E5 32 B3 9B         LD (MaiFlowPlCx), A
  40+ 90E8
  41+ 90E8 3A 3A 81         LD A, (EntityTable + ENT_POSY)
  42+ 90EB D6 10            SUB SCREEN_MIN_Y
  43+ 90ED 0F               RRCA
  44+ 90EE 0F               RRCA
  45+ 90EF 0F               RRCA
  46+ 90F0 E6 1F            AND $1F
  47+ 90F2 32 B4 9B         LD (MaiFlowPlCy), A
  48+ 90F5
  49+ 90F5                  ; --- Swap a stack temporal (bank 2) ---
  50+ 90F5 ED 73 BA 9B      LD (MaiFlowSavedSP), SP
  51+ 90F9 31 5A 9C         LD SP, MaiTempStackTop
  52+ 90FC
  53+ 90FC                  ; --- Ventana de paginacion ---
  54+ 90FC                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 90FC F3               DI
  56+ 90FD 3A C9 90         LD A, (CurrentPaging)
  57+ 9100 E6 F8            AND $F8
  58+ 9102 F6 06            OR 6
  59+ 9104 32 C9 90         LD (CurrentPaging), A
  60+ 9107 01 FD 7F         LD BC, $7FFD
  61+ 910A ED 79            OUT (C), A
  62+ 910C
  63+ 910C                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 910C CD 28 91         CALL MaiFlowBfs
  65+ 910F
  66+ 910F                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 910F 3A C9 90         LD A, (CurrentPaging)
  68+ 9112 E6 F8            AND $F8
  69+ 9114 32 C9 90         LD (CurrentPaging), A
  70+ 9117 01 FD 7F         LD BC, $7FFD
  71+ 911A ED 79            OUT (C), A
  72+ 911C
  73+ 911C ED 7B BA 9B      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 9120 3A 35 81         LD A, (StartupComplete)
  75+ 9123 B7               OR A
  76+ 9124 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 9126 FB               EI
  78+ 9127              .mcffNoEI:
  79+ 9127 C9               RET
