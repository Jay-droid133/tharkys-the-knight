# file opened: code/bank_cutscene.asm
   1+ FB08              ; ==============================================================================
   2+ FB08              ; bank_cutscene.asm - Cutscene del banco (M9 propuesto)
   3+ FB08              ; ==============================================================================
   4+ FB08              ; ESTADO: DRAFT — este archivo NO esta INCLUDE'd en main.asm. Cero impacto
   5+ FB08              ; en el binario hasta wire-up.
   6+ FB08              ;
   7+ FB08              ; Placement decidido (verificado con tools/memory_map.py): **bank 0**
   8+ FB08              ; (slot 3 default). Razones:
   9+ FB08              ;   - Slot 1 (bank 5) tiene 294 B libres — no cabe.
  10+ FB08              ;   - Bank 2 (slot 2) tiene 2 B libres — full.
  11+ FB08              ;   - Bank 0 tiene 1404 B libres → margen ~150-400 B tras meter el cuerpo.
  12+ FB08              ;   - Todos los helpers que llama el cutscene son: bank 0 (no cross-bank),
  13+ FB08              ;     slot 1 always-vis, o slot 2 always-vis → CERO thunks necesarios.
  14+ FB08              ;
  15+ FB08              ; INCLUDE va entre sound.asm y PAGE 1 en main.asm (zona bank 0 default).
  16+ FB08              ;
  17+ FB08              ; Diseno doc: docs/bank_cutscene.md.
  18+ FB08              ;
  19+ FB08              ; Disparada al chocar contra la puerta del banco (sprite Bank id 39, en
  20+ FB08              ; sala (8,8)) llevando el cheque (BankCheck id 44, key id 7).
  21+ FB08              ;
  22+ FB08              ; Phase machine indexada por BankCutscenePhase. Cuando != 0, MainLoop salta
  23+ FB08              ; el bloque normal de gameplay y llama UpdateBankCutscene cada frame.
  24+ FB08              ;
  25+ FB08              ; Esquema de fases:
  26+ FB08              ;   0  IDLE              no en cutscene
  27+ FB08              ;   1  LOCK              snap player a anchor, facing N, pausa breve
  28+ FB08              ;   2  KNOCKS_1          3 toques (sub-state HIT/GAP)
  29+ FB08              ;   3  WAIT_1            espera silenciosa tras grupo 1
  30+ FB08              ;   4  KNOCKS_2          3 toques mas
  31+ FB08              ;   5  WAIT_2            espera tras grupo 2
  32+ FB08              ;   6  TURN_TO_CAM       player gira a S (cara camara)
  33+ FB08              ;   7  TURN_TO_DOOR      player vuelve a N
  34+ FB08              ;   8  KNOCKS_3          6 toques
  35+ FB08              ;   9  WAIT_3            pausa antes de aparecer la mano
  36+ FB08              ;  10  PRE_HAND          hold corto; la puerta NO se abre (mano sale por la
  37+ FB08              ;                        rendija de la puerta cerrada)
  38+ FB08              ;  11  HAND_IN           aparece mano (frame 0) sobre la puerta cerrada
  39+ FB08              ;  12  HAND_NO_NO        anim swaps frame 0/1, BCS_NO_SWAPS_TOTAL veces
  40+ FB08              ;  13  HAND_OUT          erase mano
  41+ FB08              ;  14  KEY_DROP          BankKeySpawned=1 + RedrawPickupByPtr
  42+ FB08              ;  15  PLAYER_TURN_CAM   player mira a camara un instante
  43+ FB08              ;  16  DONE              sentinel; setear phase=IDLE devuelve control
  44+ FB08              ;  17  WAIT_NASTIES      pre-LOCK: nasties + death animan puff antes de LOCK
  45+ FB08              ;                        (mismo patron que TGP_WAIT_NASTIES de town_gate;
  46+ FB08              ;                        MainLoop ramifica especial para mantener
  47+ FB08              ;                        ProcessEnemies + ProcessDeath corriendo).
  48+ FB08              ;
  49+ FB08              ; NOTA visual: la mano se dibuja con XOR sobre la puerta cerrada del banco.
  50+ FB08              ; Hereda los attrs de la facade (no pinta los suyos), asi que XOR self-cancel
  51+ FB08              ; en HAND_OUT deja la facade intacta. Por eso el draft inline +
  52+ FB08              ; DrawBgSprite16XorAtPixel es el match exacto: cero gestion de attrs.
  53+ FB08              ;
  54+ FB08              ; Patron de placement: bank 0 (slot 3 default). Helpers en bank 0 (mismo
  55+ FB08              ; bank, sin thunks), slot 1 (always-vis), slot 2 (always-vis). Las CALLs a
  56+ FB08              ; LoadBgSpriteToBuffer (slot 1) restauran bank 0 al volver via su patron
  57+ FB08              ; estandar — el body en bank 0 reaparece tras el RET sin problemas.
  58+ FB08              ; ==============================================================================
  59+ FB08
  60+ FB08              ; ==============================================================================
  61+ FB08              ; Phase enum
  62+ FB08              ; ==============================================================================
  63+ FB08              BCP_IDLE                EQU 0
  64+ FB08              BCP_LOCK                EQU 1
  65+ FB08              BCP_KNOCKS_1            EQU 2
  66+ FB08              BCP_WAIT_1              EQU 3
  67+ FB08              BCP_KNOCKS_2            EQU 4
  68+ FB08              BCP_WAIT_2              EQU 5
  69+ FB08              BCP_TURN_TO_CAM         EQU 6
  70+ FB08              BCP_TURN_TO_DOOR        EQU 7
  71+ FB08              BCP_KNOCKS_3            EQU 8
  72+ FB08              BCP_WAIT_3              EQU 9
  73+ FB08              BCP_PRE_HAND            EQU 10      ; antes BCP_DOOR_OPEN; ahora puerta no se abre
  74+ FB08              BCP_HAND_IN             EQU 11
  75+ FB08              BCP_HAND_NO_NO          EQU 12
  76+ FB08              BCP_HAND_OUT            EQU 13
  77+ FB08              BCP_KEY_DROP            EQU 14
  78+ FB08              BCP_PLAYER_TURN_CAM     EQU 15
  79+ FB08              BCP_DONE                EQU 16
  80+ FB08              BCP_WAIT_NASTIES        EQU 17
  81+ FB08              BCP_DOOR_CLOSED         EQU 18      ; pausa con puerta visible cerrada antes del key drop
  82+ FB08
  83+ FB08              ; Sub-states del knock-loop (BankCutsceneSubState)
  84+ FB08              BCS_KNOCK_HIT           EQU 0
  85+ FB08              BCS_KNOCK_GAP           EQU 1
  86+ FB08
  87+ FB08              ; ==============================================================================
  88+ FB08              ; Timings (frames a 50 Hz). Ajustables sin tocar logica.
  89+ FB08              ; ==============================================================================
  90+ FB08              BCS_T_LOCK              EQU 30      ; 1.2s lock inicial
  91+ FB08              BCS_T_KNOCK_HIT         EQU 4       ; cada hit (door shake + sfx) — was 6
  92+ FB08              BCS_T_KNOCK_GAP         EQU 5       ; gap entre toques — was 8
  93+ FB08              BCS_T_GROUP_WAIT        EQU 50      ; 2s espera silenciosa tras cada grupo
  94+ FB08              BCS_T_TURN_CAM          EQU 40      ; 1.6s mid-cutscene mirando camara
  95+ FB08              BCS_T_TURN_BACK         EQU 10      ; transicion rapida de vuelta
  96+ FB08              BCS_T_PRE_HAND          EQU 30      ; pausa tras los 6 toques antes de la mano
  97+ FB08              BCS_T_PRE_HAND_HOLD     EQU 20      ; hold corto antes de hacer aparecer la mano
  98+ FB08              BCS_T_HAND_IN           EQU 20      ; pause tras aparecer mano
  99+ FB08              BCS_T_NO_FRAME          EQU 12      ; cada swap de "no no"
 100+ FB08              BCS_T_HAND_HOLD         EQU 15      ; pausa tras ultimo swap
 101+ FB08              ; (BCS_T_HAND_OUT eliminado: ahora HAND_OUT erase + key spawn van juntos.)
 102+ FB08              BCS_T_DOOR_CLOSED_HOLD  EQU 30      ; pausa con puerta cerrada antes del key drop
 103+ FB08              BCS_T_KEY_HOLD          EQU 30      ; pausa tras drop antes de turn-cam
 104+ FB08              BCS_T_PLAYER_TURN_FINAL EQU 30      ; 1.2s mirando camara antes de devolver control
 105+ FB08              BCS_T_PUFF_WAIT         EQU 100     ; safety timeout WAIT_NASTIES (transicion real
 106+ FB08                                                  ; es por check dinamico de "all nasties dead").
 107+ FB08
 108+ FB08              ; Cuentas
 109+ FB08              BCS_GROUP1_KNOCKS       EQU 3
 110+ FB08              BCS_GROUP2_KNOCKS       EQU 3
 111+ FB08              BCS_GROUP3_KNOCKS       EQU 6
 112+ FB08              BCS_NO_SWAPS_TOTAL      EQU 8       ; 4 "no" × 2 swaps = 8 transiciones
 113+ FB08
 114+ FB08              ; SFX "no no" — dos tonos alternos en canal B, tipo "uh-oh" cartoonish.
 115+ FB08              ; Period AY = 1.7734 MHz / (16 * freq). Tercera mayor descendente Mi→Do.
 116+ FB08              ; AY_PlayBeep recibe HL = period, B = duracion frames.
 117+ FB08              BCS_NO_PERIOD_HI        EQU $0150   ; Mi (E4, ~330 Hz) — nota aguda
 118+ FB08              BCS_NO_PERIOD_LO        EQU $01A8   ; Do (C4, ~262 Hz) — nota grave
 119+ FB08              BCS_NO_DUR_FRAMES       EQU 6       ; ~240ms staccato (gap antes del proximo swap @12f)
 120+ FB08
 121+ FB08              ; ==============================================================================
 122+ FB08              ; Sala + posiciones (placeholders; verificar in-game)
 123+ FB08              ; ==============================================================================
 124+ FB08              BCS_BANK_ROOM_X         EQU 8       ; sala del banco (norte del ayuntamiento)
 125+ FB08              BCS_BANK_ROOM_Y         EQU 8
 126+ FB08
 127+ FB08              ; Anchor del player durante la cinematica — siempre centrado horizontalmente
 128+ FB08              ; con la puerta (chars 15-16, centro X = 128; player 16 px ancho → POSX = 120).
 129+ FB08              ;
 130+ FB08              ; Y depende de la sub-fase:
 131+ FB08              ;   KNOCK   → 1 px de hueco bajo la puerta (door_bottom 63 → POSY 65; px 64 vacio).
 132+ FB08              ;   RETREAT → 1 char (8 px) bajo la puerta (POSY 72; px 64-71 vacios).
 133+ FB08              BCS_PLAYER_ANCHOR_X     EQU 120
 134+ FB08              BCS_PLAYER_ANCHOR_Y     EQU 65      ; KNOCK: 1 px hueco bajo la puerta
 135+ FB08              BCS_PLAYER_RETREAT_Y    EQU 72      ; RETREAT: 1 char (8 px) hueco
 136+ FB08
 137+ FB08              ; Posicion de la puerta del banco — confirmada por el usuario en el editor:
 138+ FB08              ; Cell (8,8), char (15, 4). Asumo tamaño 2x2 chars (16x16 px) — mismo
 139+ FB08              ; tamaño que el sprite de la mano. Si el sprite real BankDoorOpen es
 140+ FB08              ; mas grande (e.g. 3x3 o 4x4), ajustar BCS_DOOR_CHAR_W/H.
 141+ FB08              ;
 142+ FB08              ; Bank facade en char (12, 0), 64x48 px → (12-19, 0-5). Door en (15, 4)
 143+ FB08              ; cae en la mitad inferior central de la facade. Pixel coords con
 144+ FB08              ; BG_Y_OFFSET=2: top-left = (15*8, (4+2)*8) = (120, 48).
 145+ FB08              BCS_DOOR_CHARX          EQU 15
 146+ FB08              BCS_DOOR_CHARY          EQU 4
 147+ FB08              BCS_DOOR_CHAR_W         EQU 2       ; ancho en chars (16 px)
 148+ FB08              BCS_DOOR_CHAR_H         EQU 2       ; alto en chars (16 px)
 149+ FB08
 150+ FB08              ; AABB en pixels (derivado de char coords)
 151+ FB08              BCS_DOOR_PX_LEFT        EQU 120     ; 15*8
 152+ FB08              BCS_DOOR_PX_RIGHT       EQU 135     ; 120 + 16 - 1
 153+ FB08              BCS_DOOR_PX_TOP         EQU 48      ; (4+2)*8
 154+ FB08              BCS_DOOR_PX_BOTTOM      EQU 63      ; 48 + 16 - 1
 155+ FB08              BCS_DOOR_TOLERANCE      EQU 4       ; mismo margen que CheckTownGateTriggerBg
 156+ FB08
 157+ FB08              ; Posicion de la mano cuando asoma (centrada en el hueco de la puerta)
 158+ FB08              BCS_HAND_PX_X           EQU 120     ; mismo X que la puerta (16x16 sprite)
 159+ FB08              BCS_HAND_PX_Y           EQU 48      ; mismo Y que la puerta
 160+ FB08
 161+ FB08              ; Posicion (char) donde se dibuja BankKey al final — placeholder
 162+ FB08              ; (suelo justo delante de la puerta)
 163+ FB08              BCS_KEY_DROP_CHARX      EQU 15
 164+ FB08              BCS_KEY_DROP_CHARY      EQU 7
 165+ FB08
 166+ FB08              ; Trigger requirements
 167+ FB08              BCS_REQUIRED_KEY        EQU 7       ; BankCheck (slot 7 en KeyLockTable, NUEVO)
 168+ FB08
 169+ FB08              ; ==============================================================================
 170+ FB08              ; CheckBankTriggerBg - bump-trigger del banco (BG sprite, no en PickupTable)
 171+ FB08              ; ==============================================================================
 172+ FB08              ; Llamada cada frame desde MainLoop tras CheckBumpTriggers (gemelo de
 173+ FB08              ; CheckTownGateTriggerBg). Mismo test AABB ±BCS_DOOR_TOLERANCE.
 174+ FB08              ;
 175+ FB08              ; Dispara: BankCutscenePhase==0, CurrentKey==7 (BankCheck), sala (8,8),
 176+ FB08              ; player AABB (16x21) overlapea rect de la puerta. HIT → StartBankCutscene
 177+ FB08              ; + CheckMilestoneTrigger(4) (avanza M9).
 178+ FB08              ; Destruye: AF, BC, DE, HL, IX.
 179+ FB08              ; ==============================================================================
 180+ FB08              CheckBankTriggerBg:
 181+ FB08 3A C9 82         LD A, (BankCutscenePhase)
 182+ FB0B B7               OR A
 183+ FB0C C0               RET NZ                              ; ya en cutscene
 184+ FB0D 3A AE 82         LD A, (CurrentKey)
 185+ FB10 FE 07            CP BCS_REQUIRED_KEY
 186+ FB12 C0               RET NZ                              ; sin cheque
 187+ FB13 3A 08 83         LD A, (CurrentScreenX)
 188+ FB16 FE 08            CP BCS_BANK_ROOM_X
 189+ FB18 C0               RET NZ
 190+ FB19 3A 09 83         LD A, (CurrentScreenY)
 191+ FB1C FE 08            CP BCS_BANK_ROOM_Y
 192+ FB1E C0               RET NZ
 193+ FB1F                  ; --- Horizontal AABB ---
 194+ FB1F 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 195+ FB22 4F               LD C, A                             ; C = player_left
 196+ FB23 C6 10            ADD A, 16
 197+ FB25 57               LD D, A                             ; D = player_right
 198+ FB26 3E 78            LD A, BCS_DOOR_PX_LEFT
 199+ FB28 D6 04            SUB BCS_DOOR_TOLERANCE
 200+ FB2A 30 01            JR NC, .cbtNoUnderL
 201+ FB2C AF               XOR A
 202+ FB2D              .cbtNoUnderL:
 203+ FB2D BA               CP D
 204+ FB2E D0               RET NC
 205+ FB2F 3E 87            LD A, BCS_DOOR_PX_RIGHT
 206+ FB31 C6 04            ADD A, BCS_DOOR_TOLERANCE
 207+ FB33 30 02            JR NC, .cbtNoOverR
 208+ FB35 3E FF            LD A, $FF
 209+ FB37              .cbtNoOverR:
 210+ FB37 B9               CP C
 211+ FB38 D8               RET C
 212+ FB39                  ; --- Vertical AABB (player rect 16x21) ---
 213+ FB39 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 214+ FB3C 4F               LD C, A
 215+ FB3D C6 15            ADD A, 21
 216+ FB3F 57               LD D, A
 217+ FB40 3E 30            LD A, BCS_DOOR_PX_TOP
 218+ FB42 D6 04            SUB BCS_DOOR_TOLERANCE
 219+ FB44 30 01            JR NC, .cbtNoUnderT
 220+ FB46 AF               XOR A
 221+ FB47              .cbtNoUnderT:
 222+ FB47 BA               CP D
 223+ FB48 D0               RET NC
 224+ FB49 3E 3F            LD A, BCS_DOOR_PX_BOTTOM
 225+ FB4B C6 04            ADD A, BCS_DOOR_TOLERANCE
 226+ FB4D 30 02            JR NC, .cbtNoOverB
 227+ FB4F 3E FF            LD A, $FF
 228+ FB51              .cbtNoOverB:
 229+ FB51 B9               CP C
 230+ FB52 D8               RET C
 231+ FB53                  ; HIT
 232+ FB53 CD 5B FB         CALL StartBankCutscene
 233+ FB56 3E 04            LD A, 4                             ; action 4 = BankDoor
 234+ FB58 C3 05 F1         JP CheckMilestoneTrigger            ; tail call
 235+ FB5B
 236+ FB5B              ; ==============================================================================
 237+ FB5B              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 238+ FB5B              ; ==============================================================================
 239+ FB5B              ; 1. Consume cheque (CurrentKey = 0).
 240+ FB5B              ; 2. Snap player a anchor frente a la puerta, facing N.
 241+ FB5B              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 242+ FB5B              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 243+ FB5B              ;    para limpiar la pantalla durante la cutscene.
 244+ FB5B              ; Destruye: AF, BC, DE, HL, IX.
 245+ FB5B              ; ==============================================================================
 246+ FB5B              StartBankCutscene:
 247+ FB5B AF               XOR A
 248+ FB5C 32 AE 82         LD (CurrentKey), A                  ; consume cheque
 249+ FB5F 32 CC 82         LD (BankCutsceneKnockIdx), A
 250+ FB62 32 CB 82         LD (BankCutsceneSubState), A
 251+ FB65 32 CD 82         LD (BankCutsceneNoIdx), A
 252+ FB68 32 CE 82         LD (BankCutsceneHandFrame), A
 253+ FB6B CD CD BC         CALL KillAllActiveNasties           ; nasties → STATE_DYING + puff anim
 254+ FB6E CD E5 60         CALL KillDeathIfActive               ; muerte (slot 11) → puff y despawn
 255+ FB71                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 256+ FB71                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 257+ FB71                  ; cambiamos el sprite a facing N para preparar.
 258+ FB71 CD CE FB         CALL BankCutsceneFacingNRedraw
 259+ FB74 CD B4 FE         CALL SFX_Bank_OnStart
 260+ FB77                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 261+ FB77                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 262+ FB77                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 263+ FB77 3E 64            LD A, BCS_T_PUFF_WAIT
 264+ FB79 32 CA 82         LD (BankCutsceneTimer), A
 265+ FB7C 3E 11            LD A, BCP_WAIT_NASTIES
 266+ FB7E 32 C9 82         LD (BankCutscenePhase), A
 267+ FB81 C9               RET
 268+ FB82
 269+ FB82              ; ==============================================================================
 270+ FB82              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 271+ FB82              ; ==============================================================================
 272+ FB82              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 273+ FB82              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 274+ FB82              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 275+ FB82              BankCutsceneSnapToDoor:
 276+ FB82 DD 21 9B 81      LD IX, EntityTable
 277+ FB86 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 278+ FB8A DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 279+ FB8E DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 280+ FB92 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 281+ FB94 32 DC 82         LD (PlayerDrawY), A
 282+ FB97 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 283+ FB99 DD 77 00         LD (IX+ENT_SPRITEID), A
 284+ FB9C 3E 0A            LD A, SPRID_WALK_N
 285+ FB9E DD 77 08         LD (IX+ENT_ANIMBASE), A
 286+ FBA1 AF               XOR A
 287+ FBA2 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 288+ FBA5 C3 9E 63         JP TownGateRedrawPlayer
 289+ FBA8
 290+ FBA8              ; ==============================================================================
 291+ FBA8              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 292+ FBA8              ; ==============================================================================
 293+ FBA8              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 294+ FBA8              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 295+ FBA8              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 296+ FBA8              BankCutsceneSnapToRetreat:
 297+ FBA8 DD 21 9B 81      LD IX, EntityTable
 298+ FBAC DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 299+ FBB0 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 300+ FBB4 DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 301+ FBB8 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 302+ FBBA 32 DC 82         LD (PlayerDrawY), A
 303+ FBBD 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 304+ FBBF DD 77 00         LD (IX+ENT_SPRITEID), A
 305+ FBC2 3E 0A            LD A, SPRID_WALK_N
 306+ FBC4 DD 77 08         LD (IX+ENT_ANIMBASE), A
 307+ FBC7 AF               XOR A
 308+ FBC8 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 309+ FBCB C3 9E 63         JP TownGateRedrawPlayer
 310+ FBCE
 311+ FBCE              ; ==============================================================================
 312+ FBCE              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 313+ FBCE              ; ==============================================================================
 314+ FBCE              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 315+ FBCE              ; para asegurar que el player mira a la puerta antes del primer snap.
 316+ FBCE              BankCutsceneFacingNRedraw:
 317+ FBCE DD 21 9B 81      LD IX, EntityTable
 318+ FBD2 DD 7E 04         LD A, (IX+ENT_POSY)
 319+ FBD5 32 DC 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 320+ FBD8 3E 0B            LD A, SPRID_WALK_N + 1
 321+ FBDA DD 77 00         LD (IX+ENT_SPRITEID), A
 322+ FBDD 3E 0A            LD A, SPRID_WALK_N
 323+ FBDF DD 77 08         LD (IX+ENT_ANIMBASE), A
 324+ FBE2 AF               XOR A
 325+ FBE3 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 326+ FBE6 C3 9E 63         JP TownGateRedrawPlayer
 327+ FBE9
 328+ FBE9              ; ==============================================================================
 329+ FBE9              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 330+ FBE9              ; ==============================================================================
 331+ FBE9              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 332+ FBE9              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 333+ FBE9              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 334+ FBE9              ; resuelve KillAllActiveNasties de StartBankCutscene).
 335+ FBE9              ; Destruye: AF, BC, DE, HL, IX.
 336+ FBE9              ; ==============================================================================
 337+ FBE9              UpdateBankCutscene:
 338+ FBE9 3A C9 82         LD A, (BankCutscenePhase)
 339+ FBEC FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 340+ FBEE CA 37 FC         JP Z, .bcPhWaitNasties
 341+ FBF1 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 342+ FBF3 CA C0 FD         JP Z, .bcPhDoorClosed
 343+ FBF6 3D               DEC A
 344+ FBF7 CA 51 FC         JP Z, .bcPhLock
 345+ FBFA 3D               DEC A
 346+ FBFB CA 6F FC         JP Z, .bcPhKnocks1
 347+ FBFE 3D               DEC A
 348+ FBFF CA 84 FC         JP Z, .bcPhWait1
 349+ FC02 3D               DEC A
 350+ FC03 CA A5 FC         JP Z, .bcPhKnocks2
 351+ FC06 3D               DEC A
 352+ FC07 CA BA FC         JP Z, .bcPhWait2
 353+ FC0A 3D               DEC A
 354+ FC0B CA DC FC         JP Z, .bcPhTurnToCam
 355+ FC0E 3D               DEC A
 356+ FC0F CA 00 FD         JP Z, .bcPhTurnToDoor
 357+ FC12 3D               DEC A
 358+ FC13 CA 22 FD         JP Z, .bcPhKnocks3
 359+ FC16 3D               DEC A
 360+ FC17 CA 37 FD         JP Z, .bcPhWait3
 361+ FC1A 3D               DEC A
 362+ FC1B CA 49 FD         JP Z, .bcPhPreHand
 363+ FC1E 3D               DEC A
 364+ FC1F CA 68 FD         JP Z, .bcPhHandIn
 365+ FC22 3D               DEC A
 366+ FC23 CA 77 FD         JP Z, .bcPhHandNoNo
 367+ FC26 3D               DEC A
 368+ FC27 CA A8 FD         JP Z, .bcPhHandOut
 369+ FC2A 3D               DEC A
 370+ FC2B CA E0 FD         JP Z, .bcPhKeyDrop
 371+ FC2E 3D               DEC A
 372+ FC2F CA 05 FE         JP Z, .bcPhPlayerTurnCam
 373+ FC32                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 374+ FC32 AF               XOR A
 375+ FC33 32 C9 82         LD (BankCutscenePhase), A
 376+ FC36 C9               RET
 377+ FC37
 378+ FC37              ; ---- Phase 17: WAIT_NASTIES ----
 379+ FC37              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 380+ FC37              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 381+ FC37              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 382+ FC37              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 383+ FC37              ;
 384+ FC37              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 385+ FC37              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 386+ FC37              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 387+ FC37              .bcPhWaitNasties:
 388+ FC37 CD CD BC         CALL KillAllActiveNasties           ; cazar spawnings recien terminados
 389+ FC3A CD E7 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 390+ FC3D 28 04            JR Z, .bcWaitNastiesDone
 391+ FC3F CD AB FE         CALL BankCutsceneDecTimer           ; safety timeout
 392+ FC42 C0               RET NZ
 393+ FC43              .bcWaitNastiesDone:
 394+ FC43 CD 82 FB         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 395+ FC46 3E 1E            LD A, BCS_T_LOCK
 396+ FC48 32 CA 82         LD (BankCutsceneTimer), A
 397+ FC4B 3E 01            LD A, BCP_LOCK
 398+ FC4D 32 C9 82         LD (BankCutscenePhase), A
 399+ FC50 C9               RET
 400+ FC51
 401+ FC51              ; ---- Phase 1: lock + facing UP ----
 402+ FC51              .bcPhLock:
 403+ FC51 CD AB FE         CALL BankCutsceneDecTimer
 404+ FC54 C0               RET NZ
 405+ FC55                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 406+ FC55 AF               XOR A
 407+ FC56 32 CC 82         LD (BankCutsceneKnockIdx), A
 408+ FC59 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 409+ FC5C 3E 00            LD A, BCS_KNOCK_HIT
 410+ FC5E 32 CB 82         LD (BankCutsceneSubState), A
 411+ FC61 3E 04            LD A, BCS_T_KNOCK_HIT
 412+ FC63 32 CA 82         LD (BankCutsceneTimer), A
 413+ FC66 CD 4A FE         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 414+ FC69 3E 02            LD A, BCP_KNOCKS_1
 415+ FC6B 32 C9 82         LD (BankCutscenePhase), A
 416+ FC6E C9               RET
 417+ FC6F
 418+ FC6F              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 419+ FC6F              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 420+ FC6F              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 421+ FC6F              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 422+ FC6F              .bcPhKnocks1:
 423+ FC6F 3E 03            LD A, BCS_GROUP1_KNOCKS
 424+ FC71 CD 0F FE         CALL BankCutsceneTickKnockGroup
 425+ FC74 B7               OR A
 426+ FC75 C8               RET Z                               ; sigue
 427+ FC76                  ; grupo 1 terminado → retirarse a ORIG + wait
 428+ FC76 CD A8 FB         CALL BankCutsceneSnapToRetreat
 429+ FC79 3E 32            LD A, BCS_T_GROUP_WAIT
 430+ FC7B 32 CA 82         LD (BankCutsceneTimer), A
 431+ FC7E 3E 03            LD A, BCP_WAIT_1
 432+ FC80 32 C9 82         LD (BankCutscenePhase), A
 433+ FC83 C9               RET
 434+ FC84
 435+ FC84              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 436+ FC84              .bcPhWait1:
 437+ FC84 CD AB FE         CALL BankCutsceneDecTimer
 438+ FC87 C0               RET NZ
 439+ FC88                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 440+ FC88 CD 82 FB         CALL BankCutsceneSnapToDoor
 441+ FC8B AF               XOR A
 442+ FC8C 32 CC 82         LD (BankCutsceneKnockIdx), A
 443+ FC8F 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 444+ FC92 3E 00            LD A, BCS_KNOCK_HIT
 445+ FC94 32 CB 82         LD (BankCutsceneSubState), A
 446+ FC97 3E 04            LD A, BCS_T_KNOCK_HIT
 447+ FC99 32 CA 82         LD (BankCutsceneTimer), A
 448+ FC9C CD 4A FE         CALL BankCutsceneEmitKnockHit
 449+ FC9F 3E 04            LD A, BCP_KNOCKS_2
 450+ FCA1 32 C9 82         LD (BankCutscenePhase), A
 451+ FCA4 C9               RET
 452+ FCA5
 453+ FCA5              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 454+ FCA5              .bcPhKnocks2:
 455+ FCA5 3E 03            LD A, BCS_GROUP2_KNOCKS
 456+ FCA7 CD 0F FE         CALL BankCutsceneTickKnockGroup
 457+ FCAA B7               OR A
 458+ FCAB C8               RET Z
 459+ FCAC                  ; grupo 2 terminado → retirarse a ORIG + wait
 460+ FCAC CD A8 FB         CALL BankCutsceneSnapToRetreat
 461+ FCAF 3E 32            LD A, BCS_T_GROUP_WAIT
 462+ FCB1 32 CA 82         LD (BankCutsceneTimer), A
 463+ FCB4 3E 05            LD A, BCP_WAIT_2
 464+ FCB6 32 C9 82         LD (BankCutscenePhase), A
 465+ FCB9 C9               RET
 466+ FCBA
 467+ FCBA              ; ---- Phase 5: WAIT_2 ----
 468+ FCBA              .bcPhWait2:
 469+ FCBA CD AB FE         CALL BankCutsceneDecTimer
 470+ FCBD C0               RET NZ
 471+ FCBE                  ; Player gira a S (cara camara).
 472+ FCBE DD 21 9B 81      LD IX, EntityTable
 473+ FCC2 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 474+ FCC4 DD 77 00         LD (IX+ENT_SPRITEID), A
 475+ FCC7 DD 77 08         LD (IX+ENT_ANIMBASE), A
 476+ FCCA AF               XOR A
 477+ FCCB DD 77 09         LD (IX+ENT_ANIMTIMER), A
 478+ FCCE CD 9E 63         CALL TownGateRedrawPlayer
 479+ FCD1 3E 28            LD A, BCS_T_TURN_CAM
 480+ FCD3 32 CA 82         LD (BankCutsceneTimer), A
 481+ FCD6 3E 06            LD A, BCP_TURN_TO_CAM
 482+ FCD8 32 C9 82         LD (BankCutscenePhase), A
 483+ FCDB C9               RET
 484+ FCDC
 485+ FCDC              ; ---- Phase 6: player mirando camara mid-cutscene ----
 486+ FCDC              .bcPhTurnToCam:
 487+ FCDC CD AB FE         CALL BankCutsceneDecTimer
 488+ FCDF C0               RET NZ
 489+ FCE0                  ; Player vuelve a N (cara puerta).
 490+ FCE0 DD 21 9B 81      LD IX, EntityTable
 491+ FCE4 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 492+ FCE6 DD 77 00         LD (IX+ENT_SPRITEID), A
 493+ FCE9 3E 0A            LD A, SPRID_WALK_N
 494+ FCEB DD 77 08         LD (IX+ENT_ANIMBASE), A
 495+ FCEE AF               XOR A
 496+ FCEF DD 77 09         LD (IX+ENT_ANIMTIMER), A
 497+ FCF2 CD 9E 63         CALL TownGateRedrawPlayer
 498+ FCF5 3E 0A            LD A, BCS_T_TURN_BACK
 499+ FCF7 32 CA 82         LD (BankCutsceneTimer), A
 500+ FCFA 3E 07            LD A, BCP_TURN_TO_DOOR
 501+ FCFC 32 C9 82         LD (BankCutscenePhase), A
 502+ FCFF C9               RET
 503+ FD00
 504+ FD00              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 505+ FD00              .bcPhTurnToDoor:
 506+ FD00 CD AB FE         CALL BankCutsceneDecTimer
 507+ FD03 C0               RET NZ
 508+ FD04                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 509+ FD04 CD 82 FB         CALL BankCutsceneSnapToDoor
 510+ FD07 AF               XOR A
 511+ FD08 32 CC 82         LD (BankCutsceneKnockIdx), A
 512+ FD0B 3E 01            LD A, 1
 513+ FD0D 32 CF 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 514+ FD10 AF               XOR A
 515+ FD11 32 CB 82         LD (BankCutsceneSubState), A        ; HIT
 516+ FD14 3E 04            LD A, BCS_T_KNOCK_HIT
 517+ FD16 32 CA 82         LD (BankCutsceneTimer), A
 518+ FD19 CD 4A FE         CALL BankCutsceneEmitKnockHit
 519+ FD1C 3E 08            LD A, BCP_KNOCKS_3
 520+ FD1E 32 C9 82         LD (BankCutscenePhase), A
 521+ FD21 C9               RET
 522+ FD22
 523+ FD22              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 524+ FD22              .bcPhKnocks3:
 525+ FD22 3E 06            LD A, BCS_GROUP3_KNOCKS
 526+ FD24 CD 0F FE         CALL BankCutsceneTickKnockGroup
 527+ FD27 B7               OR A
 528+ FD28 C8               RET Z
 529+ FD29                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 530+ FD29                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 531+ FD29                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 532+ FD29 CD A8 FB         CALL BankCutsceneSnapToRetreat
 533+ FD2C 3E 1E            LD A, BCS_T_PRE_HAND
 534+ FD2E 32 CA 82         LD (BankCutsceneTimer), A
 535+ FD31 3E 09            LD A, BCP_WAIT_3
 536+ FD33 32 C9 82         LD (BankCutscenePhase), A
 537+ FD36 C9               RET
 538+ FD37
 539+ FD37              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 540+ FD37              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 541+ FD37              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 542+ FD37              .bcPhWait3:
 543+ FD37 CD AB FE         CALL BankCutsceneDecTimer
 544+ FD3A C0               RET NZ
 545+ FD3B CD C5 FE         CALL SFX_Bank_OnDoorCreak
 546+ FD3E 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 547+ FD40 32 CA 82         LD (BankCutsceneTimer), A
 548+ FD43 3E 0A            LD A, BCP_PRE_HAND
 549+ FD45 32 C9 82         LD (BankCutscenePhase), A
 550+ FD48 C9               RET
 551+ FD49
 552+ FD49              ; ---- Phase 10: hold corto antes de la mano ----
 553+ FD49              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 554+ FD49              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 555+ FD49              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 556+ FD49              .bcPhPreHand:
 557+ FD49 CD AB FE         CALL BankCutsceneDecTimer
 558+ FD4C C0               RET NZ
 559+ FD4D AF               XOR A
 560+ FD4E 32 CE 82         LD (BankCutsceneHandFrame), A
 561+ FD51 32 CD 82         LD (BankCutsceneNoIdx), A
 562+ FD54 CD 4D FE         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 563+ FD57 CD 8B FE         CALL BankCutsceneDrawHand           ; frame 0 sobre area en negro
 564+ FD5A CD C6 FE         CALL SFX_Bank_OnHandIn
 565+ FD5D                  ; HAND_IN saltado — la mano arranca el ciclo "no no" inmediatamente
 566+ FD5D                  ; tras aparecer (sin pausa quieta). Para revertir: usar BCS_T_HAND_IN
 567+ FD5D                  ; + BCP_HAND_IN aqui en vez de NO_FRAME + HAND_NO_NO.
 568+ FD5D 3E 0C            LD A, BCS_T_NO_FRAME
 569+ FD5F 32 CA 82         LD (BankCutsceneTimer), A
 570+ FD62 3E 0C            LD A, BCP_HAND_NO_NO
 571+ FD64 32 C9 82         LD (BankCutscenePhase), A
 572+ FD67 C9               RET
 573+ FD68
 574+ FD68              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 575+ FD68              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 576+ FD68              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 577+ FD68              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 578+ FD68              .bcPhHandIn:
 579+ FD68 CD AB FE         CALL BankCutsceneDecTimer
 580+ FD6B C0               RET NZ
 581+ FD6C 3E 0C            LD A, BCS_T_NO_FRAME
 582+ FD6E 32 CA 82         LD (BankCutsceneTimer), A
 583+ FD71 3E 0C            LD A, BCP_HAND_NO_NO
 584+ FD73 32 C9 82         LD (BankCutscenePhase), A
 585+ FD76 C9               RET
 586+ FD77
 587+ FD77              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 588+ FD77              .bcPhHandNoNo:
 589+ FD77 CD AB FE         CALL BankCutsceneDecTimer
 590+ FD7A C0               RET NZ
 591+ FD7B                  ; Swap frame: erase actual + draw el otro.
 592+ FD7B CD A8 FE         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 593+ FD7E 3A CE 82         LD A, (BankCutsceneHandFrame)
 594+ FD81 EE 01            XOR 1
 595+ FD83 32 CE 82         LD (BankCutsceneHandFrame), A
 596+ FD86 CD 8B FE         CALL BankCutsceneDrawHand           ; draw frame nuevo
 597+ FD89 CD CC FE         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 598+ FD8C                  ; Increment swap idx, check completion.
 599+ FD8C 3A CD 82         LD A, (BankCutsceneNoIdx)
 600+ FD8F 3C               INC A
 601+ FD90 32 CD 82         LD (BankCutsceneNoIdx), A
 602+ FD93 FE 08            CP BCS_NO_SWAPS_TOTAL
 603+ FD95 38 0B            JR C, .bcNoNoMoreSwaps
 604+ FD97                  ; Todos los swaps hechos — pausa antes de erase mano.
 605+ FD97 3E 0F            LD A, BCS_T_HAND_HOLD
 606+ FD99 32 CA 82         LD (BankCutsceneTimer), A
 607+ FD9C                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 608+ FD9C                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 609+ FD9C 3E 0D            LD A, BCP_HAND_OUT
 610+ FD9E 32 C9 82         LD (BankCutscenePhase), A
 611+ FDA1 C9               RET
 612+ FDA2              .bcNoNoMoreSwaps:
 613+ FDA2 3E 0C            LD A, BCS_T_NO_FRAME
 614+ FDA4 32 CA 82         LD (BankCutsceneTimer), A
 615+ FDA7 C9               RET
 616+ FDA8
 617+ FDA8              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 618+ FDA8              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 619+ FDA8              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 620+ FDA8              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 621+ FDA8              ; del pickup dormant).
 622+ FDA8              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 623+ FDA8              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 624+ FDA8              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 625+ FDA8              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 626+ FDA8              ; de la llave.
 627+ FDA8              .bcPhHandOut:
 628+ FDA8 CD AB FE         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 629+ FDAB C0               RET NZ
 630+ FDAC CD A8 FE         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 631+ FDAF CD 6F FE         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 632+ FDB2 CD DF FE         CALL SFX_Bank_OnHandOut             ; SFX cierre de puerta (placeholder hoy)
 633+ FDB5 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 634+ FDB7 32 CA 82         LD (BankCutsceneTimer), A
 635+ FDBA 3E 12            LD A, BCP_DOOR_CLOSED
 636+ FDBC 32 C9 82         LD (BankCutscenePhase), A
 637+ FDBF C9               RET
 638+ FDC0
 639+ FDC0              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 640+ FDC0              .bcPhDoorClosed:
 641+ FDC0 CD AB FE         CALL BankCutsceneDecTimer
 642+ FDC3 C0               RET NZ
 643+ FDC4                  ; --- Spawn de la llave de la ciudad ---
 644+ FDC4 3E 01            LD A, 1
 645+ FDC6 32 C2 82         LD (TownGateKeySpawned), A
 646+ FDC9 21 61 FA         LD HL, SFX_KeyDrop
 647+ FDCC CD 23 F9         CALL PlaySFX
 648+ FDCF 11 B2 D7         LD DE, BgGfx_town_gate_key
 649+ FDD2 CD 48 DA         CALL RedrawPickupByPtr
 650+ FDD5                  ; Pausa KEY_HOLD con la llave visible antes de que el player gire.
 651+ FDD5 3E 1E            LD A, BCS_T_KEY_HOLD
 652+ FDD7 32 CA 82         LD (BankCutsceneTimer), A
 653+ FDDA 3E 0E            LD A, BCP_KEY_DROP
 654+ FDDC 32 C9 82         LD (BankCutscenePhase), A
 655+ FDDF C9               RET
 656+ FDE0
 657+ FDE0              ; ---- Phase 14: pausa con la llave visible → giro a camara ----
 658+ FDE0              .bcPhKeyDrop:
 659+ FDE0 CD AB FE         CALL BankCutsceneDecTimer
 660+ FDE3 C0               RET NZ
 661+ FDE4                  ; Player gira a camara final.
 662+ FDE4 DD 21 9B 81      LD IX, EntityTable
 663+ FDE8 3E 00            LD A, SPRID_IDLE
 664+ FDEA DD 77 00         LD (IX+ENT_SPRITEID), A
 665+ FDED DD 77 08         LD (IX+ENT_ANIMBASE), A
 666+ FDF0 AF               XOR A
 667+ FDF1 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 668+ FDF4 CD 9E 63         CALL TownGateRedrawPlayer
 669+ FDF7 CD E5 FE         CALL SFX_Bank_OnPlayerTurn
 670+ FDFA 3E 1E            LD A, BCS_T_PLAYER_TURN_FINAL
 671+ FDFC 32 CA 82         LD (BankCutsceneTimer), A
 672+ FDFF 3E 0F            LD A, BCP_PLAYER_TURN_CAM
 673+ FE01 32 C9 82         LD (BankCutscenePhase), A
 674+ FE04 C9               RET
 675+ FE05
 676+ FE05              ; ---- Phase 15: player mirando camara antes de devolver control ----
 677+ FE05              .bcPhPlayerTurnCam:
 678+ FE05 CD AB FE         CALL BankCutsceneDecTimer
 679+ FE08 C0               RET NZ
 680+ FE09                  ; Setear DONE → siguiente UpdateBankCutscene cae al fallthrough y pone IDLE.
 681+ FE09 3E 10            LD A, BCP_DONE
 682+ FE0B 32 C9 82         LD (BankCutscenePhase), A
 683+ FE0E C9               RET
 684+ FE0F
 685+ FE0F              ; ==============================================================================
 686+ FE0F              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 687+ FE0F              ; ==============================================================================
 688+ FE0F              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 689+ FE0F              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 690+ FE0F              ;
 691+ FE0F              ; Estado:
 692+ FE0F              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 693+ FE0F              ;   BankCutsceneTimer:    decrementa por frame
 694+ FE0F              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 695+ FE0F              ;
 696+ FE0F              ; Logica:
 697+ FE0F              ;   - Tick timer. Si != 0, return 0.
 698+ FE0F              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 699+ FE0F              ;   - Si SubState=GAP y timer=0:
 700+ FE0F              ;       - increment KnockIdx
 701+ FE0F              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 702+ FE0F              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 703+ FE0F              ;
 704+ FE0F              ; Destruye: A, BC, DE, HL.
 705+ FE0F              ; ==============================================================================
 706+ FE0F              BankCutsceneTickKnockGroup:
 707+ FE0F 47               LD B, A                             ; B = total knocks
 708+ FE10 3A CA 82         LD A, (BankCutsceneTimer)
 709+ FE13 3D               DEC A
 710+ FE14 32 CA 82         LD (BankCutsceneTimer), A
 711+ FE17 B7               OR A
 712+ FE18 28 02            JR Z, .bctkgTimer0
 713+ FE1A AF               XOR A                               ; sigue, no terminado
 714+ FE1B C9               RET
 715+ FE1C              .bctkgTimer0:
 716+ FE1C 3A CB 82         LD A, (BankCutsceneSubState)
 717+ FE1F B7               OR A
 718+ FE20 20 0C            JR NZ, .bctkgGap0
 719+ FE22                  ; HIT acabo: switch a GAP.
 720+ FE22 3E 01            LD A, BCS_KNOCK_GAP
 721+ FE24 32 CB 82         LD (BankCutsceneSubState), A
 722+ FE27 3E 05            LD A, BCS_T_KNOCK_GAP
 723+ FE29 32 CA 82         LD (BankCutsceneTimer), A
 724+ FE2C AF               XOR A
 725+ FE2D C9               RET
 726+ FE2E              .bctkgGap0:
 727+ FE2E                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 728+ FE2E 3A CC 82         LD A, (BankCutsceneKnockIdx)
 729+ FE31 3C               INC A
 730+ FE32 32 CC 82         LD (BankCutsceneKnockIdx), A
 731+ FE35 B8               CP B
 732+ FE36 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 733+ FE38                  ; grupo terminado.
 734+ FE38 3E 01            LD A, 1
 735+ FE3A C9               RET
 736+ FE3B              .bctkgNextHit:
 737+ FE3B 3E 00            LD A, BCS_KNOCK_HIT
 738+ FE3D 32 CB 82         LD (BankCutsceneSubState), A
 739+ FE40 3E 04            LD A, BCS_T_KNOCK_HIT
 740+ FE42 32 CA 82         LD (BankCutsceneTimer), A
 741+ FE45 CD 4A FE         CALL BankCutsceneEmitKnockHit
 742+ FE48 AF               XOR A
 743+ FE49 C9               RET
 744+ FE4A
 745+ FE4A              ; ==============================================================================
 746+ FE4A              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 747+ FE4A              ; ==============================================================================
 748+ FE4A              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 749+ FE4A              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 750+ FE4A              ; Destruye: A, BC, DE, HL.
 751+ FE4A              ; ==============================================================================
 752+ FE4A              BankCutsceneEmitKnockHit:
 753+ FE4A C3 B5 FE         JP SFX_Bank_OnKnock                 ; tail-call
 754+ FE4D
 755+ FE4D              ; ==============================================================================
 756+ FE4D              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 757+ FE4D              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 758+ FE4D              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 759+ FE4D              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 760+ FE4D              ; oscuridad de la rendija".
 761+ FE4D              BCS_DOOR_HAND_ATTR      EQU $47
 762+ FE4D
 763+ FE4D              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 764+ FE4D              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 765+ FE4D              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 766+ FE4D              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 767+ FE4D              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 768+ FE4D
 769+ FE4D              ; ==============================================================================
 770+ FE4D              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 771+ FE4D              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 772+ FE4D              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 773+ FE4D              ; pixels visibles bright white sobre fondo negro.
 774+ FE4D              ;
 775+ FE4D              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 776+ FE4D              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 777+ FE4D              ; dos llamadas no cancelan, solo re-pintan.
 778+ FE4D              ; Destruye: AF, BC, DE, HL, IX.
 779+ FE4D              ; ==============================================================================
 780+ FE4D              BankCutsceneOpenDoorWithHandAttrs:
 781+ FE4D 21 FA F0         LD HL, BgGfx_bank_door_closed
 782+ FE50 3E 03            LD A, 3                             ; bank 3
 783+ FE52 CD BC 6A         CALL LoadBgSpriteToBuffer
 784+ FE55 DD 21 F5 89      LD IX, BgSpriteBuffer
 785+ FE59 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 786+ FE5B 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 787+ FE5D CD 17 DE         CALL DrawBgSpriteXOR                ; XOR-cancel pixels (attrs intactos $78)
 788+ FE60                  ; Sobreescribir attrs a "hand mode" = $47.
 789+ FE60 3E 47            LD A, BCS_DOOR_HAND_ATTR
 790+ FE62 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 791+ FE65 77               LD (HL), A
 792+ FE66 23               INC HL                              ; $58D0 (16, 4)
 793+ FE67 77               LD (HL), A
 794+ FE68 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 795+ FE6B 77               LD (HL), A
 796+ FE6C 23               INC HL                              ; $58F0 (16, 5)
 797+ FE6D 77               LD (HL), A
 798+ FE6E C9               RET
 799+ FE6F
 800+ FE6F              ; ==============================================================================
 801+ FE6F              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 802+ FE6F              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 803+ FE6F              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 804+ FE6F              ;
 805+ FE6F              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 806+ FE6F              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 807+ FE6F              ; Destruye: AF, BC, DE, HL, IX.
 808+ FE6F              ; ==============================================================================
 809+ FE6F              BankCutsceneCloseDoorRestoreAttrs:
 810+ FE6F 21 FA F0         LD HL, BgGfx_bank_door_closed
 811+ FE72 3E 03            LD A, 3
 812+ FE74 CD BC 6A         CALL LoadBgSpriteToBuffer
 813+ FE77 DD 21 F5 89      LD IX, BgSpriteBuffer
 814+ FE7B 06 0F            LD B, BCS_DOOR_CHARX
 815+ FE7D 0E 04            LD C, BCS_DOOR_CHARY
 816+ FE7F AF               XOR A
 817+ FE80 32 0F E5         LD (BgSpriteIsHouse), A
 818+ FE83                  ; CurrentTintVar = $FF (no tint). El sprite door tiene tintPaper=7 y attr
 819+ FE83                  ; paper=7 — si CurrentTintVar fuera 0, ApplyTintSwap pondria paper=0 → todo
 820+ FE83                  ; negro. Con $FF (= "sin tint") la attr queda intacta a su valor original.
 821+ FE83 3E FF            LD A, $FF
 822+ FE85 32 D8 D4         LD (CurrentTintVar), A
 823+ FE88 C3 CE D3         JP DrawBgGfxSprite                  ; SET pixels + PAINT attrs ($78) sin tint
 824+ FE8B
 825+ FE8B              ; ==============================================================================
 826+ FE8B              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 827+ FE8B              ; ==============================================================================
 828+ FE8B              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 829+ FE8B              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 830+ FE8B              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 831+ FE8B              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 832+ FE8B              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 833+ FE8B              ; Destruye: AF, BC, DE, HL, IX.
 834+ FE8B              ; ==============================================================================
 835+ FE8B              BankCutsceneDrawHand:
 836+ FE8B 3A CE 82         LD A, (BankCutsceneHandFrame)
 837+ FE8E B7               OR A
 838+ FE8F 20 05            JR NZ, .bcdhFrame1
 839+ FE91 21 E6 FE         LD HL, BgGfx_BankHandFrame0
 840+ FE94 18 03            JR .bcdhCopy
 841+ FE96              .bcdhFrame1:
 842+ FE96 21 08 FF         LD HL, BgGfx_BankHandFrame1
 843+ FE99              .bcdhCopy:
 844+ FE99 11 F5 89         LD DE, BgSpriteBuffer
 845+ FE9C 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
 846+ FE9F ED B0            LDIR
 847+ FEA1 16 30            LD D, BCS_HAND_PX_Y
 848+ FEA3 1E 78            LD E, BCS_HAND_PX_X
 849+ FEA5 C3 31 69         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
 850+ FEA8
 851+ FEA8              ; ==============================================================================
 852+ FEA8              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
 853+ FEA8              ; ==============================================================================
 854+ FEA8              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
 855+ FEA8              ; Destruye: AF, BC, DE, HL, IX.
 856+ FEA8              ; ==============================================================================
 857+ FEA8              BankCutsceneEraseHand:
 858+ FEA8 C3 8B FE         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
 859+ FEAB
 860+ FEAB              ; ==============================================================================
 861+ FEAB              ; Player redraw helpers — REUSADOS de town_gate_cutscene.asm (slot 1, always-vis):
 862+ FEAB              ;   TownGateRedrawPlayer:    erase old + draw new (cambio sprite/posicion).
 863+ FEAB              ;   TownGateDrawPlayerHere:  draw + attrs en (ENT_DRAWX, PlayerDrawY).
 864+ FEAB              ;   TownGateErasePlayer:     XOR-erase en (ENT_OLDX, ENT_OLDY) + RestoreOldAttr.
 865+ FEAB              ; Son rutinas puras del estado del player (no tocan ninguna var de town_gate),
 866+ FEAB              ; asi que invocarlas desde aqui (bank 0) ahorra ~85 B sin cambiar comportamiento.
 867+ FEAB              ; ==============================================================================
 868+ FEAB
 869+ FEAB              ; ==============================================================================
 870+ FEAB              ; BankCutsceneDecTimer - decrementa BankCutsceneTimer, devuelve Z si llego a 0
 871+ FEAB              ; ==============================================================================
 872+ FEAB              BankCutsceneDecTimer:
 873+ FEAB 3A CA 82         LD A, (BankCutsceneTimer)
 874+ FEAE 3D               DEC A
 875+ FEAF 32 CA 82         LD (BankCutsceneTimer), A
 876+ FEB2 B7               OR A
 877+ FEB3 C9               RET
 878+ FEB4
 879+ FEB4              ; ==============================================================================
 880+ FEB4              ; SFX stubs — placeholders RET. Rellenar con AY_PlayBeep / PlaySFX cuando
 881+ FEB4              ; se diseñen los timbres.
 882+ FEB4              ; ==============================================================================
 883+ FEB4              SFX_Bank_OnStart:
 884+ FEB4 C9               RET
 885+ FEB5              ; Knock: dispatch entre soft (grupos 1, 2) y loud (grupo 3) segun
 886+ FEB5              ; BankCutsceneKnockType (set por la fase de entrada al grupo). Duracion
 887+ FEB5              ; comun 4 frames (~160ms).
 888+ FEB5              SFX_Bank_OnKnock:
 889+ FEB5 3A CF 82         LD A, (BankCutsceneKnockType)
 890+ FEB8 B7               OR A
 891+ FEB9 20 05            JR NZ, .sokLoud
 892+ FEBB 06 04            LD B, 4
 893+ FEBD C3 A0 6D         JP AY_PlayKnockSoft                 ; tail-call (grupos 1, 2: 3 knocks)
 894+ FEC0              .sokLoud:
 895+ FEC0 06 04            LD B, 4
 896+ FEC2 C3 A5 6D         JP AY_PlayKnockLoud                 ; tail-call (grupo 3: 6 knocks)
 897+ FEC5              SFX_Bank_OnDoorCreak:                   ; antes SFX_Bank_OnDoorOpen
 898+ FEC5                  ; TODO: crujido leve para sugerir que la puerta cede mientras la mano
 899+ FEC5                  ; sale por la rendija (la puerta nunca se abre del todo).
 900+ FEC5 C9               RET
 901+ FEC6              ; Cuando la puerta del banco se abre (PRE_HAND), reusamos el mismo crujido
 902+ FEC6              ; de puerta vieja que la iglesia (.cbtActChurchDoor en screen_system.asm).
 903+ FEC6              SFX_Bank_OnHandIn:
 904+ FEC6 21 3A FA         LD HL, SFX_ChurchDoorOpen
 905+ FEC9 C3 23 F9         JP PlaySFX                          ; tail-call
 906+ FECC              ; SFX_Bank_OnNoSwap — dos tonos alternos por swap ("uh-oh" cartoonish).
 907+ FECC              ; Llamado AL HACER swap, justo despues de XOR'ar BankCutsceneHandFrame:
 908+ FECC              ;   swap 1: HandFrame=1 → aguda
 909+ FECC              ;   swap 2: HandFrame=0 → grave
 910+ FECC              ;   ...
 911+ FECC              ;   swap 8: HandFrame=0 → grave
 912+ FECC              ; → Patron 8 swaps: A G A G A G A G (4 ciclos "uh-oh").
 913+ FECC              ; AY_PlayBeep es no-bloqueante (cutoff via BeepDurationFrames + ticker IRQ).
 914+ FECC              SFX_Bank_OnNoSwap:
 915+ FECC 3A CE 82         LD A, (BankCutsceneHandFrame)
 916+ FECF B7               OR A
 917+ FED0 28 05            JR Z, .nsLow
 918+ FED2 21 50 01         LD HL, BCS_NO_PERIOD_HI
 919+ FED5 18 03            JR .nsPlay
 920+ FED7              .nsLow:
 921+ FED7 21 A8 01         LD HL, BCS_NO_PERIOD_LO
 922+ FEDA              .nsPlay:
 923+ FEDA 06 06            LD B, BCS_NO_DUR_FRAMES
 924+ FEDC C3 7A 6D         JP AY_PlayBeep                      ; tail-call
 925+ FEDF              ; Cuando la puerta del banco se cierra (HAND_OUT, tras erase mano + redraw
 926+ FEDF              ; door), reusamos el mismo crujido de puerta vieja que la iglesia. La
 927+ FEDF              ; iglesia tambien comparte SFX_ChurchDoorOpen para abrir y cerrar (ver
 928+ FEDF              ; CloseChurchDoor en church_cutscene.asm:610).
 929+ FEDF              SFX_Bank_OnHandOut:
 930+ FEDF 21 3A FA         LD HL, SFX_ChurchDoorOpen
 931+ FEE2 C3 23 F9         JP PlaySFX                          ; tail-call
 932+ FEE5              SFX_Bank_OnPlayerTurn:
 933+ FEE5 C9               RET
