 817+ 75B5              ; ==============================================================================
 818+ 75B5              ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 819+ 75B5              ; ==============================================================================
 820+ 75B5              ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 821+ 75B5              ; bit_idx en 16-bit: HL.
 822+ 75B5              ;
 823+ 75B5              ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 824+ 75B5              ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 825+ 75B5              ; ==============================================================================
 826+ 75B5              .cmcpMarkVisited:
 827+ 75B5                  ; bit_idx = sid*3 + comp; HL = bit_idx
 828+ 75B5 26 00            LD H, 0
 829+ 75B7 6F               LD L, A                              ; HL = sid
 830+ 75B8 E5               PUSH HL
 831+ 75B9 29               ADD HL, HL                           ; HL = sid*2
 832+ 75BA D1               POP DE
 833+ 75BB 19               ADD HL, DE                           ; HL = sid*3
 834+ 75BC 58               LD E, B
 835+ 75BD 16 00            LD D, 0
 836+ 75BF 19               ADD HL, DE                           ; HL = sid*3 + comp
 837+ 75C0                  ; bit pos = HL & 7; byte idx = HL >> 3
 838+ 75C0 7D               LD A, L
 839+ 75C1 E6 07            AND $07
 840+ 75C3 4F               LD C, A                              ; C = bit pos
 841+ 75C4 CB 3C            SRL H
 842+ 75C6 CB 1D            RR L
 843+ 75C8 CB 3C            SRL H
 844+ 75CA CB 1D            RR L
 845+ 75CC CB 3C            SRL H
 846+ 75CE CB 1D            RR L                                 ; HL = HL/8 (byte idx)
 847+ 75D0 11 BF 76         LD DE, MagicCompassVisited
 848+ 75D3 19               ADD HL, DE                           ; HL = byte addr
 849+ 75D4 3E 01            LD A, 1
 850+ 75D6 0C               INC C
 851+ 75D7              .cmvShift:
 852+ 75D7 0D               DEC C
 853+ 75D8 28 03            JR Z, .cmvDone
 854+ 75DA 87               ADD A, A
 855+ 75DB 18 FA            JR .cmvShift
 856+ 75DD              .cmvDone:
 857+ 75DD B6               OR (HL)
 858+ 75DE 77               LD (HL), A
 859+ 75DF C9               RET
 860+ 75E0
 861+ 75E0              .cmcpCheckVisitedBC:
 862+ 75E0                  ; bit_idx = sid*3 + comp; HL = bit_idx
 863+ 75E0 26 00            LD H, 0
 864+ 75E2 68               LD L, B                              ; HL = sid
 865+ 75E3 E5               PUSH HL
 866+ 75E4 29               ADD HL, HL
 867+ 75E5 D1               POP DE
 868+ 75E6 19               ADD HL, DE                           ; HL = sid*3
 869+ 75E7 59               LD E, C
 870+ 75E8 16 00            LD D, 0
 871+ 75EA 19               ADD HL, DE                           ; HL = sid*3 + comp
 872+ 75EB 7D               LD A, L
 873+ 75EC E6 07            AND $07
 874+ 75EE 4F               LD C, A
 875+ 75EF CB 3C            SRL H
 876+ 75F1 CB 1D            RR L
 877+ 75F3 CB 3C            SRL H
 878+ 75F5 CB 1D            RR L
 879+ 75F7 CB 3C            SRL H
 880+ 75F9 CB 1D            RR L
 881+ 75FB 11 BF 76         LD DE, MagicCompassVisited
 882+ 75FE 19               ADD HL, DE
 883+ 75FF 3E 01            LD A, 1
 884+ 7601 0C               INC C
 885+ 7602              .ccvShift:
 886+ 7602 0D               DEC C
 887+ 7603 28 03            JR Z, .ccvDone
 888+ 7605 87               ADD A, A
 889+ 7606 18 FA            JR .ccvShift
 890+ 7608              .ccvDone:
 891+ 7608 A6               AND (HL)
 892+ 7609 C9               RET
