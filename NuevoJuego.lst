4481+ B7A5              ; ==============================================================================
4482+ B7A5              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4483+ B7A5              ; ==============================================================================
4484+ B7A5              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4485+ B7A5              ; ==============================================================================
4486+ B7A5              TrySpawnNasty:
4487+ B7A5                  IF DEBUG_NO_ENEMIES
4488+ B7A5 ~                RET
4489+ B7A5                  ENDIF
4490+ B7A5                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4491+ B7A5                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4492+ B7A5                  ; cuando el timer llega a 0.
4493+ B7A5 3A CC 82         LD A, (PostTrapPauseTimer)
4494+ B7A8 B7               OR A
4495+ B7A9 C0               RET NZ
4496+ B7AA                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4497+ B7AA                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4498+ B7AA 3A EC 82         LD A, (DeathBorderPhase)
4499+ B7AD B7               OR A
4500+ B7AE C0               RET NZ
4501+ B7AF                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4502+ B7AF                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4503+ B7AF                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4504+ B7AF 3A F0 82         LD A, (PlayerRespawnPhase)
4505+ B7B2 FE 01            CP 1
4506+ B7B4 C8               RET Z
4507+ B7B5                  ; Cooldown tras cambio de pantalla / inicio
4508+ B7B5 3A FA 82         LD A, (SpawnTimer)
4509+ B7B8 B7               OR A
4510+ B7B9 28 05            JR Z, .spawnReady
4511+ B7BB 3D               DEC A
4512+ B7BC 32 FA 82         LD (SpawnTimer), A
4513+ B7BF C9               RET
4514+ B7C0              .spawnReady:
4515+ B7C0                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4516+ B7C0 3A 22 B6         LD A, (ScareTimer)
4517+ B7C3 B7               OR A
4518+ B7C4 C0               RET NZ
4519+ B7C5                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4520+ B7C5                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4521+ B7C5                  ; rellenamos con nasties crepusculares hasta A2.
4522+ B7C5 3A C3 82         LD A, (MonsterTrappedFlags)
4523+ B7C8 E6 07            AND $07
4524+ B7CA FE 07            CP $07
4525+ B7CC 28 0E            JR Z, .spawnIgnoreNightBlocks
4526+ B7CE                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4527+ B7CE                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4528+ B7CE                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4529+ B7CE                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4530+ B7CE 3A 8C B3         LD A, (MonstersActive)
4531+ B7D1 B7               OR A
4532+ B7D2 C0               RET NZ
4533+ B7D3                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4534+ B7D3 3A 9A E3         LD A, (CurrentTimeOfDay)
4535+ B7D6 FE 04            CP 4                        ; N2
4536+ B7D8 C8               RET Z
4537+ B7D9 FE 05            CP 5                        ; A1
4538+ B7DB C8               RET Z
4539+ B7DC              .spawnIgnoreNightBlocks:
4540+ B7DC                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4541+ B7DC                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4542+ B7DC                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4543+ B7DC                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4544+ B7DC DD 21 10 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4545+ B7E0 06 03            LD B, NUM_NASTIES
