 694+ A21C DD 7E 01         LD A, (IX+ENT_TYPE)
 695+ A21F FE 02            CP TYPE_MONSTER
 696+ A221 C2 97 A2         JP NZ, .peScaredSpriteToggle
 697+ A224                  ; --- Shake ---
 698+ A224 CD 3B 8F         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 699+ A227 5F               LD E, A
 700+ A228 16 00            LD D, 0
 701+ A22A 21 95 8D         LD HL, MonsterAiFlags
 702+ A22D 19               ADD HL, DE
 703+ A22E 7E               LD A, (HL)
 704+ A22F CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 705+ A231 20 15            JR NZ, .peShakeActive
 706+ A233                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 707+ A233 F6 08            OR MAI_FLAG_SHAKE_SAVED
 708+ A235 77               LD (HL), A
