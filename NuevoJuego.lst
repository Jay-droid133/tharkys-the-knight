7587+ C965              ; ==============================================================================
7588+ C965              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7589+ C965              ; ==============================================================================
7590+ C965              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7591+ C965              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7592+ C965              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7593+ C965              ; ==============================================================================
7594+ C965              ; ==============================================================================
7595+ C965              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7596+ C965              ; ==============================================================================
7597+ C965              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7598+ C965              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7599+ C965              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7600+ C965              ; los pone a su default.
7601+ C965              ; ==============================================================================
7602+ C965              InitGameState:
7603+ C965 3E 03            LD A, PLAYER_LIVES_INIT
7604+ C967 32 E0 82         LD (PlayerLives), A
7605+ C96A 3E 10            LD A, HEALTH_MAX
7606+ C96C 32 72 B3         LD (PlayerHealth), A
7607+ C96F 3E 10            LD A, STAMINA_MAX
7608+ C971 32 73 B3         LD (PlayerStamina), A
7609+ C974 AF               XOR A
7610+ C975 32 E1 82         LD (GameOver), A
7611+ C978 32 B9 82         LD (CurrentObjective), A
7612+ C97B 32 B0 82         LD (CurrentKey), A
7613+ C97E 32 B4 82         LD (ChurchEverOpened), A
7614+ C981 32 B3 82         LD (ChurchDoorOpen), A
7615+ C984 32 B5 82         LD (TimeFrozen), A
7616+ C987 32 B2 82         LD (ChurchKeySpawned), A
7617+ C98A 32 C4 82         LD (TownGateKeySpawned), A
7618+ C98D 32 D2 82         LD (ArmRevealed), A
7619+ C990 32 D3 82         LD (FingerRevealed), A
7620+ C993 32 78 B3         LD (MonstersActive), A
7621+ C996 32 C0 82         LD (MonsterTrappedFlags), A
7622+ C999 32 FC 82         LD (DeathSpawned), A
7623+ C99C 32 CA 82         LD (TownGatePhase), A
7624+ C99F 32 C8 82         LD (ChurchCutscenePhase), A
7625+ C9A2 32 86 E3         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7626+ C9A5 32 B8 82         LD (BellsTriggered), A
7627+ C9A8 32 C1 82         LD (NextChurchTrapStep), A
7628+ C9AB 32 C2 82         LD (StatueBlinkCounter), A
7629+ C9AE 32 C3 82         LD (ChurchKeyAltSpawnIdx), A
7630+ C9B1 32 1E C5         LD (PlayerHitTimer), A
7631+ C9B4 32 F5 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7632+ C9B7 32 F6 82         LD (TombDrawPending), A
7633+ C9BA 32 E9 82         LD (DeathBorderPhase), A
7634+ C9BD 32 EA 82         LD (DeathBorderTimer), A
7635+ C9C0 32 EB 82         LD (PlayerDeathAnimTimer), A
7636+ C9C3 32 EC 82         LD (PlayerDeathAnimFrame), A
7637+ C9C6 32 ED 82         LD (PlayerRespawnPhase), A
7638+ C9C9 32 EE 82         LD (PlayerRespawnTimer), A
7639+ C9CC 32 EF 82         LD (PlayerRespawnBlinkTimer), A
7640+ C9CF 32 F1 82         LD (PlayerRespawnBeatIdx), A
7641+ C9D2 32 E2 82         LD (GameOverAnimX), A
7642+ C9D5 32 E3 82         LD (GameOverAnimDir), A
7643+ C9D8 32 E4 82         LD (GameOverAnimFrame), A
7644+ C9DB 32 E5 82         LD (GameOverAnimFrameTimer), A
7645+ C9DE 32 E8 82         LD (GameOverAnimLastX), A
7646+ C9E1 21 00 00         LD HL, 0
7647+ C9E4 22 E6 82         LD (GameOverAnimLastSpr), HL
7648+ C9E7 22 F9 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7649+ C9EA 3E 01            LD A, 1
7650+ C9EC 32 F0 82         LD (PlayerRespawnVisible), A
7651+ C9EF 3E 00            LD A, BLACK
7652+ C9F1 32 85 8D         LD (CurrentBorderColor), A
7653+ C9F4 D3 FE            OUT (254), A
7654+ C9F6 3E 01            LD A, 1
7655+ C9F8 32 0D BD         LD (DayCycleCount), A
7656+ C9FB 21 F1 BC         LD HL, DiurnalTypeTable
7657+ C9FE 22 0E BD         LD (CurrentNastyTable), HL
7658+ CA01                  ; Reset speed + buff (en caso de restart con buff activo).
7659+ CA01 3E 04            LD A, SPEED_RUN
7660+ CA03 32 D7 82         LD (PlayerSpeedRun), A
7661+ CA06 3E 02            LD A, SPEED_FIGHT
7662+ CA08 32 D8 82         LD (PlayerSpeedFight), A
7663+ CA0B 21 00 00         LD HL, 0
7664+ CA0E 22 D9 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7665+ CA11 22 DC 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7666+ CA14 AF               XOR A
7667+ CA15 32 DB 82         LD (SpeedBuffType), A
7668+ CA18                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7669+ CA18                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7670+ CA18                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7671+ CA18                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7672+ CA18                  ; recupera el control. Mismo flujo que tras una muerte.
7673+ CA18 3E 01            LD A, 1
7674+ CA1A 32 ED 82         LD (PlayerRespawnPhase), A
7675+ CA1D C9               RET
7676+ CA1E
7677+ CA1E              OnPlayerHealthDepleted:
7678+ CA1E                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7679+ CA1E                  ; coste real). Idempotente si no estaba activo.
7680+ CA1E CD EB 6D         CALL CancelMagicCompass
7681+ CA21                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7682+ CA21                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7683+ CA21                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7684+ CA21                  ; (combate, Death catch, drain de salud por cualquier via).
7685+ CA21 F5               PUSH AF
7686+ CA22 3E FF            LD A, $FF
7687+ CA24 CD BC 99         CALL StartMusic
7688+ CA27 F1               POP AF
7689+ CA28                  ; Tambien parar el secuencer ad-hoc de MonstersMusic (no va por el driver
7690+ CA28                  ; tabular; tiene su propia variable de estado MonstersMusicStep).
7691+ CA28 CD 50 FB         CALL StopMonstersMusic
7692+ CA2B                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7693+ CA2B                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7694+ CA2B CD AF 6A         CALL AY_PlayPlayerDeath
7695+ CA2E                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7696+ CA2E                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7697+ CA2E 3E 02            LD A, 2
7698+ CA30 32 B5 82         LD (TimeFrozen), A
7699+ CA33                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7700+ CA33 CD D6 68         CALL TombStore
7701+ CA36                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7702+ CA36 CD 4D BA         CALL KillAllActiveNasties
7703+ CA39                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7704+ CA39 CD 1B BB         CALL SilentKillDeath
7705+ CA3C                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7706+ CA3C CD 36 BB         CALL FreezeMonstersFacingCorpse
7707+ CA3F                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7708+ CA3F CD E8 CA         CALL TriggerDeathBorder
7709+ CA42                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7710+ CA42                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7711+ CA42                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7712+ CA42 DD 21 9D 81      LD IX, EntityTable
7713+ CA46                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7714+ CA46 DD 7E 0A         LD A, (IX+ENT_DIR)
7715+ CA49 E6 80            AND $80
7716+ CA4B 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7717+ CA4D 28 02            JR Z, .ophdRightBase
7718+ CA4F 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7719+ CA51              .ophdRightBase:
7720+ CA51 DD 77 00         LD (IX+ENT_SPRITEID), A
7721+ CA54 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7722+ CA58 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7723+ CA5C 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7724+ CA5E 32 EB 82         LD (PlayerDeathAnimTimer), A
7725+ CA61 AF               XOR A
7726+ CA62 32 EC 82         LD (PlayerDeathAnimFrame), A
7727+ CA65                  ; Decrementar vida (clamp a 0)
7728+ CA65 3A E0 82         LD A, (PlayerLives)
7729+ CA68 B7               OR A
7730+ CA69 C8               RET Z
7731+ CA6A 3D               DEC A
7732+ CA6B 32 E0 82         LD (PlayerLives), A
7733+ CA6E C9               RET
7734+ CA6F
7735+ CA6F              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7736+ CA6F              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7737+ CA6F              ErasePlayerSpriteAtOldPos:
7738+ CA6F DD 21 9D 81      LD IX, EntityTable
7739+ CA73 CD F6 A4         CALL GetOldSpriteAddr
7740+ CA76 DD 56 0D         LD D, (IX+ENT_OLDY)
7741+ CA79 DD 7E 0C         LD A, (IX+ENT_OLDX)
7742+ CA7C 5F               LD E, A
7743+ CA7D DD E5            PUSH IX
7744+ CA7F DD 2A 7E A4      LD IX, (OldSprAddr)
7745+ CA83 CD E9 99         CALL DrawSprite
7746+ CA86 DD E1            POP IX
7747+ CA88 DD 56 0D         LD D, (IX+ENT_OLDY)
7748+ CA8B DD 5E 0C         LD E, (IX+ENT_OLDX)
7749+ CA8E C3 46 D3         JP RestoreOldAttr                   ; tail-call
7750+ CA91
7751+ CA91              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7752+ CA91              RespawnPlayerAtEntry:
7753+ CA91 DD 21 9D 81      LD IX, EntityTable
7754+ CA95 3A 10 83         LD A, (LastEntryPosX)
7755+ CA98 DD 77 03         LD (IX+ENT_POSX), A
7756+ CA9B DD 77 0C         LD (IX+ENT_OLDX), A
7757+ CA9E DD 77 0F         LD (IX+ENT_DRAWX), A
7758+ CAA1 3A 11 83         LD A, (LastEntryPosY)
7759+ CAA4 DD 77 04         LD (IX+ENT_POSY), A
7760+ CAA7 DD 77 0D         LD (IX+ENT_OLDY), A
7761+ CAAA 3E 10            LD A, HEALTH_MAX
7762+ CAAC 32 72 B3         LD (PlayerHealth), A
7763+ CAAF 3E 10            LD A, STAMINA_MAX
7764+ CAB1 32 73 B3         LD (PlayerStamina), A
7765+ CAB4 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7766+ CAB8 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7767+ CABC DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7768+ CAC0 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7769+ CAC4 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7770+ CAC8 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7771+ CACC                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7772+ CACC                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7773+ CACC                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7774+ CACC                  ; libre, y .swordModeFree no toca el color.
7775+ CACC DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7776+ CAD0 AF               XOR A
7777+ CAD1 32 6E B3         LD (AttackCooldown), A
7778+ CAD4 32 6D B3         LD (AttackTimer), A
7779+ CAD7 DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7780+ CADB                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7781+ CADB                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7782+ CADB 3E 01            LD A, 1
7783+ CADD 32 ED 82         LD (PlayerRespawnPhase), A
7784+ CAE0 AF               XOR A
7785+ CAE1 32 EE 82         LD (PlayerRespawnTimer), A
7786+ CAE4 32 F1 82         LD (PlayerRespawnBeatIdx), A
7787+ CAE7 C9               RET
7788+ CAE8
7789+ CAE8              ; ==============================================================================
7790+ CAE8              ; TriggerDeathBorder - arranca el flash del borde tras morir
7791+ CAE8              ; ==============================================================================
7792+ CAE8              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7793+ CAE8              ; luego vuelve a negro y se desactiva.
7794+ CAE8              ; ==============================================================================
7795+ CAE8              TriggerDeathBorder:
7796+ CAE8 3E 01            LD A, 1
7797+ CAEA 32 E9 82         LD (DeathBorderPhase), A
7798+ CAED 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7799+ CAEF 32 EA 82         LD (DeathBorderTimer), A
7800+ CAF2 3E 06            LD A, YELLOW
7801+ CAF4 32 85 8D         LD (CurrentBorderColor), A
7802+ CAF7 D3 FE            OUT (254), A
7803+ CAF9 C9               RET
7804+ CAFA
7805+ CAFA              ; ==============================================================================
7806+ CAFA              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7807+ CAFA              ; ==============================================================================
7808+ CAFA              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7809+ CAFA              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7810+ CAFA              ; ==============================================================================
7811+ CAFA              UpdateRespawnBlink:
7812+ CAFA 3A ED 82         LD A, (PlayerRespawnPhase)
7813+ CAFD B7               OR A
7814+ CAFE C8               RET Z
7815+ CAFF 3D               DEC A
7816+ CB00 28 0D            JR Z, .urbPhase1
7817+ CB02                  ; Phase 2: solo timer (sin parpadeo)
7818+ CB02 3A EE 82         LD A, (PlayerRespawnTimer)
7819+ CB05 3D               DEC A
7820+ CB06 32 EE 82         LD (PlayerRespawnTimer), A
7821+ CB09 C0               RET NZ
7822+ CB0A AF               XOR A
7823+ CB0B 32 ED 82         LD (PlayerRespawnPhase), A
7824+ CB0E C9               RET
7825+ CB0F
7826+ CB0F              .urbPhase1:
7827+ CB0F                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7828+ CB0F                  ; Zero input (sin control)
7829+ CB0F AF               XOR A
7830+ CB10 32 AD 82         LD (InputDirection), A
7831+ CB13 32 AE 82         LD (InputFire), A
7832+ CB16                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7833+ CB16                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7834+ CB16 3A A4 6A         LD A, (BeepDurationFrames)
7835+ CB19 D6 01            SUB 1                               ; CY si era 0 (silencio)
7836+ CB1B 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7837+ CB1C E6 74            AND SPRID_PLAYER_BLANK
7838+ CB1E 32 9D 81         LD (EntityTable), A
7839+ CB21                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7840+ CB21 3A EE 82         LD A, (PlayerRespawnTimer)
7841+ CB24 B7               OR A
7842+ CB25 28 05            JR Z, .urb1FireBeat
7843+ CB27 3D               DEC A
7844+ CB28 32 EE 82         LD (PlayerRespawnTimer), A
7845+ CB2B C9               RET
7846+ CB2C              .urb1FireBeat:
7847+ CB2C 3A F1 82         LD A, (PlayerRespawnBeatIdx)
7848+ CB2F 3C               INC A
7849+ CB30 32 F1 82         LD (PlayerRespawnBeatIdx), A
7850+ CB33 FE 04            CP 4
7851+ CB35 28 12            JR Z, .urb1LastBeat
7852+ CB37 FE 05            CP 5
7853+ CB39 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7854+ CB3B                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7855+ CB3B 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7856+ CB3E 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7857+ CB40 CD D2 6A         CALL AY_PlayBeep
7858+ CB43                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7859+ CB43                  ; (mitad) para mantener ON/OFF ~50/50.
7860+ CB43 3E 14            LD A, 20
7861+ CB45 32 EE 82         LD (PlayerRespawnTimer), A
7862+ CB48 C9               RET
7863+ CB49              .urb1LastBeat:
7864+ CB49                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7865+ CB49                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7866+ CB49                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7867+ CB49                  ; entra grace EXACTAMENTE al terminar el beep.
7868+ CB49 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7869+ CB4C 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7870+ CB4E CD D2 6A         CALL AY_PlayBeep
7871+ CB51 3E 0B            LD A, 11                    ; espera = duracion del beep
7872+ CB53 32 EE 82         LD (PlayerRespawnTimer), A
7873+ CB56 C9               RET
7874+ CB57              .urb1AfterBeep:
7875+ CB57                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7876+ CB57                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7877+ CB57 CD 7F CB         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7878+ CB5A 3E 0C            LD A, SPAWN_INTERVAL
7879+ CB5C 32 F7 82         LD (SpawnTimer), A
7880+ CB5F AF               XOR A
7881+ CB60 32 FC 82         LD (DeathSpawned), A
7882+ CB63 32 F2 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7883+ CB66 32 B5 82         LD (TimeFrozen), A              ; Reanudar reloj
7884+ CB69 21 00 00         LD HL, 0
7885+ CB6C 22 F9 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7886+ CB6F                  ; Si los monsters siguen activos (no era game over), reanudar el
7887+ CB6F                  ; secuencer "po-po-popo-po" — fue parado en OnPlayerHealthDepleted.
7888+ CB6F 3A 78 B3         LD A, (MonstersActive)
7889+ CB72 B7               OR A
7890+ CB73 C8               RET Z
7891+ CB74                  ; No re-arrancar si los 3 monsters estan atrapados en la iglesia
7892+ CB74                  ; (StopMonstersMusic se llamo en TriggerChurchTrap del 3o; ya no hay
7893+ CB74                  ; monsters jugables en pantalla aunque MonstersActive siga 1).
7894+ CB74 3A C0 82         LD A, (MonsterTrappedFlags)
7895+ CB77 E6 07            AND $07
7896+ CB79 FE 07            CP $07
7897+ CB7B C8               RET Z
7898+ CB7C C3 47 FB         JP StartMonstersMusic           ; tail-call
7899+ CB7F
7900+ CB7F              ; ==============================================================================
7901+ CB7F              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7902+ CB7F              ; ==============================================================================
7903+ CB7F              ; Llamado desde:
7904+ CB7F              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7905+ CB7F              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7906+ CB7F              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7907+ CB7F              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7908+ CB7F              ; ==============================================================================
7909+ CB7F              EnterGracePhase:
7910+ CB7F 3E 02            LD A, 2
7911+ CB81 32 ED 82         LD (PlayerRespawnPhase), A
7912+ CB84 3E 19            LD A, RESPAWN_GRACE_FRAMES
7913+ CB86 32 EE 82         LD (PlayerRespawnTimer), A
7914+ CB89 C9               RET
7915+ CB8A
7916+ CB8A              ; ==============================================================================
7917+ CB8A              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7918+ CB8A              ; ==============================================================================
7919+ CB8A              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7920+ CB8A              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7921+ CB8A              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7922+ CB8A              ; ==============================================================================
7923+ CB8A              UpdateDeathAnim:
7924+ CB8A 3A E9 82         LD A, (DeathBorderPhase)
7925+ CB8D FE 01            CP 1
7926+ CB8F C0               RET NZ
7927+ CB90 3A EB 82         LD A, (PlayerDeathAnimTimer)
7928+ CB93 3D               DEC A
7929+ CB94 32 EB 82         LD (PlayerDeathAnimTimer), A
7930+ CB97 C0               RET NZ
7931+ CB98                  ; Tick consumido: avanzar frame
7932+ CB98 3A EC 82         LD A, (PlayerDeathAnimFrame)
7933+ CB9B 3C               INC A
7934+ CB9C FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7935+ CB9E D0               RET NC                              ; ya en ultimo frame (clamp)
7936+ CB9F 32 EC 82         LD (PlayerDeathAnimFrame), A
7937+ CBA2 DD 21 9D 81      LD IX, EntityTable
7938+ CBA6 DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7939+ CBA9                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7940+ CBA9                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7941+ CBA9                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7942+ CBA9 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7943+ CBAB 20 06            JR NZ, .udaSkipSplatSfx
7944+ CBAD 21 D4 F9         LD HL, SFX_EnemyDeath
7945+ CBB0 CD 55 F9         CALL PlaySFX
7946+ CBB3              .udaSkipSplatSfx:
7947+ CBB3 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7948+ CBB5 32 EB 82         LD (PlayerDeathAnimTimer), A
7949+ CBB8 C9               RET
7950+ CBB9
7951+ CBB9              ; ==============================================================================
7952+ CBB9              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7953+ CBB9              ; ==============================================================================
7954+ CBB9              UpdateDeathBorder:
7955+ CBB9 3A E9 82         LD A, (DeathBorderPhase)
7956+ CBBC B7               OR A
7957+ CBBD C8               RET Z
7958+ CBBE 3A EA 82         LD A, (DeathBorderTimer)
7959+ CBC1 3D               DEC A
7960+ CBC2 32 EA 82         LD (DeathBorderTimer), A
7961+ CBC5 C0               RET NZ
7962+ CBC6                  ; Timer expiro: avanzar fase
7963+ CBC6 3A E9 82         LD A, (DeathBorderPhase)
7964+ CBC9 FE 01            CP 1
7965+ CBCB 20 33            JR NZ, .udbToBlack
7966+ CBCD                  ; --- Fin fase amarillo ---
7967+ CBCD                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7968+ CBCD                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7969+ CBCD 3A E0 82         LD A, (PlayerLives)
7970+ CBD0 B7               OR A
7971+ CBD1 28 1F            JR Z, .udbToGameOver
7972+ CBD3 DD 21 9D 81      LD IX, EntityTable
7973+ CBD7 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7974+ CBDB 3E 02            LD A, 2
7975+ CBDD 32 E9 82         LD (DeathBorderPhase), A
7976+ CBE0 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7977+ CBE2 32 EA 82         LD (DeathBorderTimer), A
7978+ CBE5 3E 02            LD A, RED
7979+ CBE7 32 85 8D         LD (CurrentBorderColor), A
7980+ CBEA D3 FE            OUT (254), A
7981+ CBEC                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7982+ CBEC                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7983+ CBEC 3E 01            LD A, 1
7984+ CBEE 32 F6 82         LD (TombDrawPending), A
7985+ CBF1 C9               RET
7986+ CBF2              .udbToGameOver:
7987+ CBF2                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7988+ CBF2 AF               XOR A
7989+ CBF3 32 E9 82         LD (DeathBorderPhase), A
7990+ CBF6 3E 00            LD A, BLACK
7991+ CBF8 32 85 8D         LD (CurrentBorderColor), A
7992+ CBFB D3 FE            OUT (254), A
7993+ CBFD C3 0E CC         JP ShowGameOver
7994+ CC00              .udbToBlack:
7995+ CC00                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7996+ CC00 AF               XOR A
7997+ CC01 32 E9 82         LD (DeathBorderPhase), A
7998+ CC04 3E 00            LD A, BLACK
7999+ CC06 32 85 8D         LD (CurrentBorderColor), A
8000+ CC09 D3 FE            OUT (254), A
8001+ CC0B C3 91 CA         JP RespawnPlayerAtEntry             ; tail-call
8002+ CC0E
8003+ CC0E              ; ==============================================================================
8004+ CC0E              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
8005+ CC0E              ; ==============================================================================
8006+ CC0E              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
8007+ CC0E              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
8008+ CC0E              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
8009+ CC0E              ; ==============================================================================
8010+ CC0E              ShowGameOver:
8011+ CC0E 3E 01            LD A, 1
8012+ CC10 32 E1 82         LD (GameOver), A
8013+ CC13 C9               RET
8014+ CC14
8015+ CC14              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
8016+ CC14              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
8017+ CC14              PaintGameOverScreen:
8018+ CC14                  ; Wipe pixels
8019+ CC14 21 00 40         LD HL, $4000
8020+ CC17 11 01 40         LD DE, $4001
8021+ CC1A 01 FF 17         LD BC, $17FF
8022+ CC1D 36 00            LD (HL), 0
8023+ CC1F ED B0            LDIR
8024+ CC21                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
8025+ CC21 21 00 58         LD HL, $5800
8026+ CC24 11 01 58         LD DE, $5801
8027+ CC27 01 FF 02         LD BC, $02FF
8028+ CC2A 36 47            LD (HL), $47
8029+ CC2C ED B0            LDIR
8030+ CC2E                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
8031+ CC2E                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
8032+ CC2E CD 6B 6C         CALL DrawTombstone2xCentered
8033+ CC31                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
8034+ CC31 3E 88            LD A, GAMEOVER_ANIM_X_MAX
8035+ CC33 32 E2 82         LD (GameOverAnimX), A
8036+ CC36 AF               XOR A
8037+ CC37 32 E3 82         LD (GameOverAnimDir), A
8038+ CC3A 32 E4 82         LD (GameOverAnimFrame), A
8039+ CC3D 32 E8 82         LD (GameOverAnimLastX), A
8040+ CC40 21 00 00         LD HL, 0
8041+ CC43 22 E6 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
8042+ CC46 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8043+ CC48 32 E5 82         LD (GameOverAnimFrameTimer), A
8044+ CC4B                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
8045+ CC4B                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
8046+ CC4B                  ; congelado en GameOver=2.
8047+ CC4B 3E 03            LD A, 3
8048+ CC4D C3 BC 99         JP StartMusic                   ; tail-call
8049+ CC50
8050+ CC50              ; ==============================================================================
8051+ CC50              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
8052+ CC50              ; ==============================================================================
8053+ CC50              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
8054+ CC50              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
8055+ CC50              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
8056+ CC50              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
8057+ CC50              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
8058+ CC50              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
8059+ CC50              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
8060+ CC50              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
8061+ CC50              ;
8062+ CC50              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
8063+ CC50              ; shifted (que ocupa 4 chars = 32 px).
8064+ CC50              ; ==============================================================================
8065+ CC50              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
8066+ CC50              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8067+ CC50              ; X swing centrado sobre la tumba:
8068+ CC50              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8069+ CC50              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8070+ CC50              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8071+ CC50              GAMEOVER_ANIM_Y           EQU 56
8072+ CC50              GAMEOVER_ANIM_X_MIN       EQU 96
8073+ CC50              GAMEOVER_ANIM_X_MAX       EQU 136
8074+ CC50              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8075+ CC50
8076+ CC50              UpdateGameOverAnim:
8077+ CC50                  ; --- Erase del sprite previo (si lo hubo) ---
8078+ CC50 2A E6 82         LD HL, (GameOverAnimLastSpr)
8079+ CC53 7C               LD A, H
8080+ CC54 B5               OR L
8081+ CC55 28 0C            JR Z, .ugoaNoErase
8082+ CC57 E5               PUSH HL
8083+ CC58 DD E1            POP IX
8084+ CC5A 3A E8 82         LD A, (GameOverAnimLastX)
8085+ CC5D 5F               LD E, A
8086+ CC5E 16 38            LD D, GAMEOVER_ANIM_Y
8087+ CC60 CD E9 99         CALL DrawSprite
8088+ CC63              .ugoaNoErase:
8089+ CC63
8090+ CC63                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8091+ CC63 3A E5 82         LD A, (GameOverAnimFrameTimer)
8092+ CC66 3D               DEC A
8093+ CC67 20 0A            JR NZ, .ugoaTimerSet
8094+ CC69 3A E4 82         LD A, (GameOverAnimFrame)
8095+ CC6C EE 01            XOR 1
8096+ CC6E 32 E4 82         LD (GameOverAnimFrame), A
8097+ CC71 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8098+ CC73              .ugoaTimerSet:
8099+ CC73 32 E5 82         LD (GameOverAnimFrameTimer), A
8100+ CC76
8101+ CC76                  ; --- Avanzar X segun direccion (ping-pong) ---
8102+ CC76 3A E3 82         LD A, (GameOverAnimDir)
8103+ CC79 B7               OR A
8104+ CC7A 20 14            JR NZ, .ugoaSlideRight
8105+ CC7C                  ; Dir 0: facing R, slide LEFT (X--)
8106+ CC7C 3A E2 82         LD A, (GameOverAnimX)
8107+ CC7F FE 60            CP GAMEOVER_ANIM_X_MIN
8108+ CC81 28 06            JR Z, .ugoaFlipToL
8109+ CC83 3D               DEC A
8110+ CC84 32 E2 82         LD (GameOverAnimX), A
8111+ CC87 18 18            JR .ugoaPickSprite
8112+ CC89              .ugoaFlipToL:
8113+ CC89 3E 01            LD A, 1
8114+ CC8B 32 E3 82         LD (GameOverAnimDir), A
8115+ CC8E 18 11            JR .ugoaPickSprite
8116+ CC90              .ugoaSlideRight:
8117+ CC90                  ; Dir 1: facing L, slide RIGHT (X++)
8118+ CC90 3A E2 82         LD A, (GameOverAnimX)
8119+ CC93 FE 88            CP GAMEOVER_ANIM_X_MAX
8120+ CC95 28 06            JR Z, .ugoaFlipToR
8121+ CC97 3C               INC A
8122+ CC98 32 E2 82         LD (GameOverAnimX), A
8123+ CC9B 18 04            JR .ugoaPickSprite
8124+ CC9D              .ugoaFlipToR:
8125+ CC9D AF               XOR A
8126+ CC9E 32 E3 82         LD (GameOverAnimDir), A
8127+ CCA1
8128+ CCA1              .ugoaPickSprite:
8129+ CCA1                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8130+ CCA1                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8131+ CCA1                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8132+ CCA1 3A E3 82         LD A, (GameOverAnimDir)
8133+ CCA4 B7               OR A
8134+ CCA5 20 0E            JR NZ, .ugoaPickR
8135+ CCA7 3A E4 82         LD A, (GameOverAnimFrame)
8136+ CCAA B7               OR A
8137+ CCAB 21 DF DD         LD HL, SprDeath_L0
8138+ CCAE 28 11            JR Z, .ugoaSprSet
8139+ CCB0 21 29 DE         LD HL, SprDeath_L1
8140+ CCB3 18 0C            JR .ugoaSprSet
8141+ CCB5              .ugoaPickR:
8142+ CCB5 3A E4 82         LD A, (GameOverAnimFrame)
8143+ CCB8 B7               OR A
8144+ CCB9 21 4B DD         LD HL, SprDeath_0
8145+ CCBC 28 03            JR Z, .ugoaSprSet
8146+ CCBE 21 95 DD         LD HL, SprDeath_1
8147+ CCC1              .ugoaSprSet:
8148+ CCC1 22 E6 82         LD (GameOverAnimLastSpr), HL
8149+ CCC4 3A E2 82         LD A, (GameOverAnimX)
