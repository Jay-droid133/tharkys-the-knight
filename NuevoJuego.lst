# file closed: bg_gfx_b.asm
 558  E759                  ; ay_sound.asm vive aqui (bank 4, no-contended). MainLoop entra via thunks
 559  E759                  ; en ay_sound_thunks.asm. ay_sound es self-contained: cero CALL/JP a
