 256+ 9144              .lbsRleFallback:
 257+ 9144                  ; Sprite RLE: tamaño desconocido sin parsear, copia BG_SPRITE_BUFFER_SIZE-2
 258+ 9144 01 FE 03         LD BC, BG_SPRITE_BUFFER_SIZE - 2
 259+ 9147 ED B0            LDIR
