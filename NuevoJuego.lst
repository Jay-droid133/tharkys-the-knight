 479+ A468                  ; === STATE_RUNNING ===
 480+ A468                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 481+ A468 3A AC B8         LD A, (ScareTimer)
 482+ A46B B7               OR A
 483+ A46C 28 1E            JR Z, .peRunning
 484+ A46E DD 7E 01         LD A, (IX+ENT_TYPE)
 485+ A471 FE 03            CP TYPE_NASTY
 486+ A473 28 08            JR Z, .peDoScare
 487+ A475 FE 02            CP TYPE_MONSTER
