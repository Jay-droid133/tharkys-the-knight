2682+ AD9C FE A8            CP SCREEN_MAX_Y
2683+ AD9E 38 14            JR C, .eClampYOk
2684+ ADA0 3E A7            LD A, SCREEN_MAX_Y - 1
2685+ ADA2 18 1E            JR .eReverseY
2686+ ADA4              .eDeltaYNeg:
2687+ ADA4 78               LD A, B
2688+ ADA5 81               ADD A, C
2689+ ADA6 38 04            JR C, .eCheckMinY
2690+ ADA8 3E 10            LD A, SCREEN_MIN_Y
2691+ ADAA 18 16            JR .eReverseY
2692+ ADAC              .eCheckMinY:
2693+ ADAC FE 10            CP SCREEN_MIN_Y
2694+ ADAE 30 04            JR NC, .eClampYOk
2695+ ADB0 3E 10            LD A, SCREEN_MIN_Y
