 274+ E493 10 FA            DJNZ .drawChar
 275+ E495                  ; Attr: fila 0, col 0 = $5800
 276+ E495 3E 47            LD A, $47                           ; blanco bright
 277+ E497 32 00 58         LD ($5800), A
 278+ E49A C9               RET
