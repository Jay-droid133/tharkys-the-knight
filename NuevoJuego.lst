 149+ F7CF 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ F7D3 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ F7D7 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ F7DB 00               DEFB 0                      ; fin
