 503+ E506              ; --- Helpers ---
 504+ E506              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E506              .drawDec2:
 506+ E506 4B               LD C, E                     ; guardar columna inicial
 507+ E507 06 00            LD B, 0                     ; decenas
 508+ E509              .divLoop:
 509+ E509 FE 0A            CP 10
 510+ E50B 38 05            JR C, .divDone
 511+ E50D D6 0A            SUB 10
 512+ E50F 04               INC B
 513+ E510 18 F7            JR .divLoop
 514+ E512              .divDone:
 515+ E512                  ; B = decenas, A = unidades
 516+ E512 F5               PUSH AF                     ; guardar unidades
 517+ E513 78               LD A, B
 518+ E514 C6 30            ADD A, '0'
 519+ E516 59               LD E, C
 520+ E517 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E518 CD 4E E6         CALL DrawHudChar
 522+ E51B C1               POP BC                      ; restaurar C
 523+ E51C F1               POP AF
 524+ E51D C6 30            ADD A, '0'
 525+ E51F 59               LD E, C
 526+ E520 1C               INC E
 527+ E521 C3 4E E6         JP DrawHudChar              ; tail call
