 359+ 7371              ; ==============================================================================
 360+ 7371              ; ComputeMagicCompassPath - BFS reverse con state (sid, comp_local)
 361+ 7371              ; ==============================================================================
 362+ 7371              ; Algoritmo:
 363+ 7371              ;   1. queue.push((target_sid, target_comp=0)). Mark visited.
 364+ 7371              ;      target_comp = 0 (heurística: el pickup vive en la comp principal).
 365+ 7371              ;   2. While queue not empty:
 366+ 7371              ;        (R, R_comp) = queue.pop()
 367+ 7371              ;        For each gap in RoomCompGaps[R]:
 368+ 7371              ;          If gap.comp != R_comp: skip.
 369+ 7371              ;          V = neighbor of R via gap.side.
 370+ 7371              ;          Find V's gap with side=opposite(gap.side) AND coord=gap.coord.
 371+ 7371              ;          V_comp = that gap's comp.
 372+ 7371              ;          If (V, V_comp) visited: skip.
 373+ 7371              ;          If V == current_sid AND V_comp == player_current_comp:
 374+ 7371              ;            dir_player = opposite(gap.side); STORE; RETURN.
 375+ 7371              ;          Mark visited; queue.push((V, V_comp)).
 376+ 7371              ;
 377+ 7371              ; player_current_comp se determina via LastEntrySide:
 378+ 7371              ;   - LastEntrySide = side por el que el player entró a current_sid.
 379+ 7371              ;   - player_comp = comp del gap de current_sid en LastEntrySide.
 380+ 7371              ;   - Si LastEntrySide = $FF (boot/respawn), comp = 0 (fallback).
 381+ 7371              ;
 382+ 7371              ; OUT: MagicCompassPathDir = 0=N, 1=E, 2=S, 3=W; o $FF si sin path.
 383+ 7371              ; ==============================================================================
 384+ 7371              ComputeMagicCompassPath:
