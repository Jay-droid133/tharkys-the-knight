  19+ 9096              ; MaiComputeFlowField
  20+ 9096              ; ==============================================================================
  21+ 9096              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 9096              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 9096              ; quedan en $FF).
  24+ 9096              ;
  25+ 9096              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 9096              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 9096              ;
  28+ 9096              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 9096              ; Output: FlowField relleno en bank 6
  30+ 9096              ; Destruye: AF, BC, DE, HL
  31+ 9096              ; ==============================================================================
  32+ 9096              MaiComputeFlowField:
  33+ 9096                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 9096 3A 9E 81         LD A, (EntityTable + ENT_POSX)
  35+ 9099 0F               RRCA
  36+ 909A 0F               RRCA
  37+ 909B 0F               RRCA
  38+ 909C E6 1F            AND $1F
  39+ 909E 32 B1 9A         LD (MaiFlowPlCx), A
  40+ 90A1
  41+ 90A1 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  42+ 90A4 D6 10            SUB SCREEN_MIN_Y
  43+ 90A6 0F               RRCA
  44+ 90A7 0F               RRCA
  45+ 90A8 0F               RRCA
  46+ 90A9 E6 1F            AND $1F
  47+ 90AB 32 B2 9A         LD (MaiFlowPlCy), A
  48+ 90AE
  49+ 90AE                  ; --- Swap a stack temporal (bank 2) ---
  50+ 90AE ED 73 B8 9A      LD (MaiFlowSavedSP), SP
  51+ 90B2 31 58 9B         LD SP, MaiTempStackTop
  52+ 90B5
  53+ 90B5                  ; --- Ventana de paginacion ---
  54+ 90B5                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 90B5 F3               DI
  56+ 90B6 3A 82 90         LD A, (CurrentPaging)
  57+ 90B9 E6 F8            AND $F8
  58+ 90BB F6 06            OR 6
  59+ 90BD 32 82 90         LD (CurrentPaging), A
  60+ 90C0 01 FD 7F         LD BC, $7FFD
  61+ 90C3 ED 79            OUT (C), A
  62+ 90C5
  63+ 90C5                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 90C5 CD E1 90         CALL MaiFlowBfs
  65+ 90C8
  66+ 90C8                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 90C8 3A 82 90         LD A, (CurrentPaging)
  68+ 90CB E6 F8            AND $F8
  69+ 90CD 32 82 90         LD (CurrentPaging), A
  70+ 90D0 01 FD 7F         LD BC, $7FFD
  71+ 90D3 ED 79            OUT (C), A
  72+ 90D5
  73+ 90D5 ED 7B B8 9A      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 90D9 3A 9A 81         LD A, (StartupComplete)
  75+ 90DC B7               OR A
  76+ 90DD 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 90DF FB               EI
  78+ 90E0              .mcffNoEI:
  79+ 90E0 C9               RET
  80+ 90E1
  81+ 90E1              ; ------------------------------------------------------------------------------
  82+ 90E1              ; MaiFlowBfs — cuerpo del BFS (asumiendo bank 6 ya paginado, SP en temp stack)
  83+ 90E1              ; ------------------------------------------------------------------------------
  84+ 90E1              MaiFlowBfs:
  85+ 90E1                  ; Limpiar FlowField a $FF
  86+ 90E1 21 D1 C9         LD HL, FlowField
  87+ 90E4 54               LD D, H
  88+ 90E5 5D               LD E, L
  89+ 90E6 13               INC DE
  90+ 90E7 01 BF 02         LD BC, 703
  91+ 90EA 36 FF            LD (HL), $FF
  92+ 90EC ED B0            LDIR
  93+ 90EE
  94+ 90EE                  ; Init punteros de cola
  95+ 90EE 21 91 CC         LD HL, BfsQueue
  96+ 90F1 22 B4 9A         LD (MaiFlowQHead), HL
  97+ 90F4 22 B6 9A         LD (MaiFlowQTail), HL
  98+ 90F7
  99+ 90F7                  ; Semilla: celda del player
 100+ 90F7 3A B2 9A         LD A, (MaiFlowPlCy)
 101+ 90FA CD 6D 91         CALL MaiOffsetFromCy            ; HL = cy*32
 102+ 90FD 3A B1 9A         LD A, (MaiFlowPlCx)
 103+ 9100 5F               LD E, A
 104+ 9101 16 00            LD D, 0
 105+ 9103 19               ADD HL, DE                      ; HL = cy*32 + cx
