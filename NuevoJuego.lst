  29+ 6D75              ; ==============================================================================
  30+ 6D75              ; _RP_Thunk - shell compartido por los 9 entry thunks
  31+ 6D75              ; ==============================================================================
  32+ 6D75              ; IN:  HL = body address (en bank 7)
  33+ 6D75              ; OUT: lo que devuelva el body. Regs intermedios usados por body, no preservados.
  34+ 6D75              ; Destruye: AF, HL (la propia entrada).
  35+ 6D75              ;
  36+ 6D75              ; Flujo:
  37+ 6D75              ;   1. Save SP normal en _RP_savedSP.
  38+ 6D75              ;   2. Swap SP a alt_stack (slot 1 always-visible).
  39+ 6D75              ;   3. Page bank 7 en slot 3.
  40+ 6D75              ;   4. JP (HL) -> body (via CALL .callHL + JP (HL): el RET del body cae aqui).
  41+ 6D75              ;   5. Page bank 0 en slot 3.
  42+ 6D75              ;   6. Restore SP normal.
  43+ 6D75              ;   7. RET al caller original (MainLoop).
  44+ 6D75              ; ==============================================================================
  45+ 6D75              _RP_Thunk:
  46+ 6D75 ED 73 8B 6D      LD (_RP_savedSP), SP
  47+ 6D79 31 00 80         LD SP, BankCutsceneAltStackTop
  48+ 6D7C CD 2F 6E         CALL _PageBank7
  49+ 6D7F CD 8A 6D         CALL .callHL
  50+ 6D82 CD 1D 6E         CALL _PageBank0
  51+ 6D85 ED 7B 8B 6D      LD SP, (_RP_savedSP)
  52+ 6D89 C9               RET
  53+ 6D8A              .callHL:
  54+ 6D8A E9               JP (HL)
  55+ 6D8B 00 00        _RP_savedSP: DEFW 0
  56+ 6D8D
  57+ 6D8D              ; ==============================================================================
  58+ 6D8D              ; Entry thunks - cada uno carga HL=body y salta al shell shared
  59+ 6D8D              ; ==============================================================================
  60+ 6D8D              ; 5 bytes cada uno (LD HL = 3 B + JR = 2 B). JR backward al shell. Como el
  61+ 6D8D              ; shell mide ~18 B + las entries son ~45 B, todos los offsets caben en signed 8.
  62+ 6D8D              ;
  63+ 6D8D              ; Callers externos (registros sin args):
  64+ 6D8D              ;   UpdateRandomPickup, UpdateRoulette, PaintSynthPickupAttrs, UpdateSpeedBuff,
  65+ 6D8D              ;   UpdateMushroomBuff: MainLoop cada frame (early-out fast).
  66+ 6D8D              ;   CheckRandomSyntheticPickup: screen_system / pickup collect.
  67+ 6D8D              ;   GiveLife / GiveHealth / GiveStamina: screen_system (well pickup) +
  68+ 6D8D              ;       internamente desde CheckRandomSyntheticPickup body (intra-bank, no thunk).
  69+ 6D8D              ; ==============================================================================
  70+ 6D8D              UpdateRandomPickup:
  71+ 6D8D 21 D8 ED         LD HL, UpdateRandomPickupBody
  72+ 6D90 18 E3            JR _RP_Thunk
  73+ 6D92              UpdateRoulette:
  74+ 6D92 21 14 EC         LD HL, UpdateRouletteBody
  75+ 6D95 18 DE            JR _RP_Thunk
  76+ 6D97              PaintSynthPickupAttrs:
  77+ 6D97 21 09 F0         LD HL, PaintSynthPickupAttrsBody
  78+ 6D9A 18 D9            JR _RP_Thunk
  79+ 6D9C              UpdateSpeedBuff:
  80+ 6D9C 21 BA ED         LD HL, UpdateSpeedBuffBody
  81+ 6D9F 18 D4            JR _RP_Thunk
  82+ 6DA1              UpdateMushroomBuff:
  83+ 6DA1 21 54 ED         LD HL, UpdateMushroomBuffBody
  84+ 6DA4 18 CF            JR _RP_Thunk
  85+ 6DA6              CheckRandomSyntheticPickup:
  86+ 6DA6 21 42 F0         LD HL, CheckRandomSyntheticPickupBody
  87+ 6DA9 18 CA            JR _RP_Thunk
  88+ 6DAB              GiveLife:
  89+ 6DAB 21 20 EB         LD HL, GiveLifeBody
  90+ 6DAE 18 C5            JR _RP_Thunk
  91+ 6DB0              GiveHealth:
  92+ 6DB0 21 2B EB         LD HL, GiveHealthBody
  93+ 6DB3 18 C0            JR _RP_Thunk
  94+ 6DB5              GiveStamina:
  95+ 6DB5 21 3C EB         LD HL, GiveStaminaBody
  96+ 6DB8 18 BB            JR _RP_Thunk
  97+ 6DBA              UpdatePlayerColorCycler:
  98+ 6DBA                  ; CRITICO: PlayerHitTimer vive en bank 0 (slot 3). Hay que leerlo AQUI
  99+ 6DBA                  ; (con slot 3 = bank 0 default) antes de paginar bank 7 en el shell. Si
 100+ 6DBA                  ; lo lee el body, leeria de bank 7 (basura) y abortaria casi siempre.
 101+ 6DBA 3A 74 C5         LD A, (PlayerHitTimer)
 102+ 6DBD B7               OR A
 103+ 6DBE C0               RET NZ                              ; damage flash priority -> no cyclar
 104+ 6DBF 21 61 EC         LD HL, UpdatePlayerColorCyclerBody
 105+ 6DC2 18 B1            JR _RP_Thunk
 106+ 6DC4              UpdateEspadaBuff:
 107+ 6DC4 21 6C ED         LD HL, UpdateEspadaBuffBody
 108+ 6DC7 18 AC            JR _RP_Thunk
 109+ 6DC9              UpdateEscudoBuff:
 110+ 6DC9 21 7E ED         LD HL, UpdateEscudoBuffBody
 111+ 6DCC 18 A7            JR _RP_Thunk
 112+ 6DCE              UpdateReverseBuff:
 113+ 6DCE 21 99 ED         LD HL, UpdateReverseBuffBody
 114+ 6DD1 18 A2            JR _RP_Thunk
 115+ 6DD3
 116+ 6DD3              ; ==============================================================================
 117+ 6DD3              ; _B7 wrappers - llamados desde body en bank 7. Paginan bank 0, ejecutan el
 118+ 6DD3              ; callee, paginan bank 7 al volver. Estos viven en slot 1 (always-visible).
 119+ 6DD3              ; ==============================================================================
 120+ 6DD3              ; SkipPixelData / RestorePickupAttrs: bank 0 (slot 3 default), helpers de
 121+ 6DD3              ; pickup rendering usados por LoadSynthSpriteAndExtractAttr / CheckRandomSyntheticPickup.
 122+ 6DD3              ;
 123+ 6DD3              ; ApplyMagicCompassBuff: slot 1 (magic_compass.asm) pero llama helpers bank 0
 124+ 6DD3              ; internamente -> wrap completo. Solo se usa via JP tail-call desde dispatch
 125+ 6DD3              ; del pickup compass directo (no via ruleta).
 126+ 6DD3              ; ==============================================================================
 127+ 6DD3              SkipPixelData_B7:
 128+ 6DD3 CD 1D 6E         CALL _PageBank0
 129+ 6DD6 CD 36 D4         CALL SkipPixelData
 130+ 6DD9 C3 2F 6E         JP _PageBank7
 131+ 6DDC              RestorePickupAttrs_B7:
 132+ 6DDC CD 1D 6E         CALL _PageBank0
 133+ 6DDF CD 09 DD         CALL RestorePickupAttrs
 134+ 6DE2 C3 2F 6E         JP _PageBank7
 135+ 6DE5              ApplyMagicCompassBuff_B7:
 136+ 6DE5 CD 1D 6E         CALL _PageBank0
 137+ 6DE8 CD 4B 6F         CALL ApplyMagicCompassBuff
 138+ 6DEB C3 2F 6E         JP _PageBank7
 139+ 6DEE
# file closed: random_pickups_thunks.asm
 175  6DEE
 176  6DEE                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 177  6DEE                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 178  6DEE                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 179  6DEE                  ;
 180  6DEE                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 181  6DEE                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 182  6DEE                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 183  6DEE                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 184  6DEE                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 185  6DEE                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 186  6DEE                  ; mantiene por estabilidad.
 187  6DEE                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 6DEE              ; ==============================================================================
   2+ 6DEE              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 6DEE              ; ==============================================================================
   4+ 6DEE              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 6DEE              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 6DEE              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 6DEE              ;
   8+ 6DEE              ; Estrategia:
   9+ 6DEE              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 6DEE              ;      bank 0 paginado en slot 3.
  11+ 6DEE              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 6DEE              ;      seguro hacer la conmutación aquí).
  13+ 6DEE              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 6DEE              ;   4. Body retorna → restauramos bank 0.
  15+ 6DEE              ;
  16+ 6DEE              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 6DEE              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 6DEE              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 6DEE              ; ==============================================================================
  20+ 6DEE
  21+ 6DEE              DrawTombstone2xCentered:
  22+ 6DEE                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 6DEE 21 75 D9         LD HL, BgGfx_little_house_cemetery
  24+ 6DF1 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 6DF3 CD D0 67         CALL LoadBgSpriteToBuffer
  26+ 6DF6
  27+ 6DF6                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 6DF6 F3               DI
  29+ 6DF7 3A 8A 8D         LD A, (CurrentPaging)
  30+ 6DFA E6 F8            AND $F8
  31+ 6DFC F6 07            OR 7
  32+ 6DFE 32 8A 8D         LD (CurrentPaging), A
  33+ 6E01 01 FD 7F         LD BC, $7FFD
  34+ 6E04 ED 79            OUT (C), A
  35+ 6E06
  36+ 6E06                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 6E06 CD 27 DC         CALL DrawTombstone2xBody
  38+ 6E09
  39+ 6E09                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 6E09 3A 8A 8D         LD A, (CurrentPaging)
  41+ 6E0C E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 6E0E 32 8A 8D         LD (CurrentPaging), A
  43+ 6E11 01 FD 7F         LD BC, $7FFD
  44+ 6E14 ED 79            OUT (C), A
  45+ 6E16
  46+ 6E16                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 6E16 3A A2 81         LD A, (StartupComplete)
  48+ 6E19 B7               OR A
  49+ 6E1A C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 6E1B FB               EI
  51+ 6E1C C9               RET
  52+ 6E1D
# file closed: game_over_tomb_thunk.asm
 188  6E1D
 189  6E1D                  ; --- Bank cutscene: thunks slot 1 + body en bank 7 (M9) ---
 190  6E1D                  ; OBSERVACION CRITICA: estos thunks tienen que ir ANTES de magic_compass.asm
 191  6E1D                  ; (NO despues de music_irq) porque slot 1 esta apretado y meterlos al final
 192  6E1D                  ; deborda el slot a $8000+ (slot 2 = bank 2) -> crash al BASIC.
 193  6E1D                  ;
 194  6E1D                  ; Aqui empujan magic_compass.asm ~140 B hacia $7A00, pero gracias a la
 195  6E1D                  ; fusion de DrawBankDoorSprite_B7 dentro de DrawBgGfxSprite_B7 (ahorra 18 B)
 196  6E1D                  ; y al stripping de los thunks al minimo, magic_compass termina en ~$79F0,
 197  6E1D                  ; antes de la tabla IM2 ($7A00) -> BFS no cruza la zona reservada.
 198  6E1D                  INCLUDE "bank_cutscene_thunks.asm"
# file opened: bank_cutscene_thunks.asm
   1+ 6E1D              ; ==============================================================================
   2+ 6E1D              ; bank_cutscene_thunks.asm - Wrappers slot 1 para bank_cutscene en bank 7
   3+ 6E1D              ; ==============================================================================
   4+ 6E1D              ; bank_cutscene.asm vive en bank 7 (movido desde bank 0 para descongestionar el
   5+ 6E1D              ; main code). Este archivo expone los 2 entry points externos como thunks que
   6+ 6E1D              ; paginan bank 7 antes del body y restauran bank 0 al volver. Tambien proporciona
   7+ 6E1D              ; helpers _PageBank0 / _PageBank7 que el body bank 7 usa para envolver cada
   8+ 6E1D              ; CALL a una funcion en bank 0 (o en slot 1 que internamente llame a bank 0).
   9+ 6E1D              ;
  10+ 6E1D              ; Funciones externas que requieren el wrap pre+post (paginar bank 0 antes,
  11+ 6E1D              ; restaurar bank 7 despues):
  12+ 6E1D              ;   - DrawBgSpriteXOR, DrawBgGfxSprite, RedrawPickupByPtr, PlaySFX,
  13+ 6E1D              ;     CheckMilestoneTrigger    (todas en bank 0)
  14+ 6E1D              ;   - TownGateRedrawPlayer     (slot 1, pero llama internamente a RestoreOldAttr
  15+ 6E1D              ;                              que vive en bank 0)
  16+ 6E1D              ;
  17+ 6E1D              ; Funciones que requieren solo post-wrap (ya paginan bank 0 al final ellas mismas):
  18+ 6E1D              ;   - LoadBgSpriteToBuffer     (slot 1, deja bank 0 paginado al RET -> repaginar
  19+ 6E1D              ;                              bank 7 manualmente)
  20+ 6E1D              ;
  21+ 6E1D              ; Funciones que NO necesitan wrap (verificado por call graph):
  22+ 6E1D              ;   - KillAllActiveNasties, SnapPuffPos, CheckEnemyCollision  (bank 2 slot 2)
  23+ 6E1D              ;   - KillDeathIfActive -> StartMusic                          (bank 2 slot 2)
  24+ 6E1D              ;   - TownGateAllNastiesDeadCheck                              (slot 1, no calls)
  25+ 6E1D              ;   - AY_PlayKnockSoft/Loud/Beep                               (slot 1, no calls externos)
  26+ 6E1D              ;   - DrawBgSprite16XorAtPixel -> CalcPixelAddr/NextPixelLine  (bank 2 slot 2)
  27+ 6E1D              ;
  28+ 6E1D              ; Vive en slot 1 (always-visible). Patron similar a game_over_tomb_thunk.asm.
  29+ 6E1D              ;
  30+ 6E1D              ; CRITICO: el stack normal del juego vive en $FF58 (slot 3, bank 0 paginable).
  31+ 6E1D              ; Si los thunks paginan bank 7 en slot 3 sin tocar SP, el stack normal desaparece
  32+ 6E1D              ; bajo nuestros pies -> CALL/RET dentro del body bank 7 leen basura -> crash.
  33+ 6E1D              ; Solucion: los entry thunks (CheckBankTriggerBg, UpdateBankCutscene) hacen SP
  34+ 6E1D              ; swap a BankCutsceneAltStack (RAM always-visible en slot 1, zona $5BE0..$5C00
  35+ 6E1D              ; del printer buffer) durante toda la cutscene. Los _B7 thunks de funciones
  36+ 6E1D              ; externas heredan ese SP (no necesitan su propio swap).
  37+ 6E1D              ;
  38+ 6E1D              ; Sin DI en los page switches: MusicIrqHandler vive en slot 1, por convencion
  39+ 6E1D              ; project_irq_slot3_atomic no toca slot 3 -> IRQs corren normales durante los
  40+ 6E1D              ; page switches igual que en LoadBgSpriteToBuffer.
  41+ 6E1D              ; ==============================================================================
  42+ 6E1D
  43+ 6E1D              ; Alt stack: 64 B al final de slot 1 ($7FC0..$7FFF, hueco libre tras music_irq).
  44+ 6E1D              ; Vive en bank 5 always-visible, no toca otras zonas de RAM. Pico medido:
  45+ 6E1D              ; TownGateRedrawPlayer -> DrawSprite -> _DrawSpriteImpl + IRQ handler
  46+ 6E1D              ; concurrente puede superar 32 B; 64 B (32 niveles) da margen amplio.
  47+ 6E1D              BankCutsceneAltStackBase EQU $7FC0
  48+ 6E1D              BankCutsceneAltStackTop  EQU $8000       ; SP top: first PUSH escribe a $7FFE-$7FFF
  49+ 6E1D
  50+ 6E1D              ; ==============================================================================
  51+ 6E1D              ; _PageBank0 - Pagina bank 0 en slot 3. Preserva AF + BC + resto del caller.
  52+ 6E1D              ; ==============================================================================
  53+ 6E1D              ; Llamado por:
  54+ 6E1D              ;   - Entry thunks al final (devolver al gameplay normal).
  55+ 6E1D              ;   - Body bank 7 antes de cada CALL externo que toca bank 0.
  56+ 6E1D              ; Destruye: ningun reg (todo restaurado via PUSH/POP).
  57+ 6E1D              ; ==============================================================================
  58+ 6E1D              _PageBank0:
  59+ 6E1D F5               PUSH AF
  60+ 6E1E C5               PUSH BC
  61+ 6E1F 3A 8A 8D         LD A, (CurrentPaging)
  62+ 6E22 E6 F8            AND $F8                              ; bank 0 = bits 0-2 a cero
  63+ 6E24 32 8A 8D         LD (CurrentPaging), A
  64+ 6E27 01 FD 7F         LD BC, $7FFD
  65+ 6E2A ED 79            OUT (C), A
  66+ 6E2C C1               POP BC
  67+ 6E2D F1               POP AF
  68+ 6E2E C9               RET
  69+ 6E2F
  70+ 6E2F              ; ==============================================================================
  71+ 6E2F              ; _PageBank7 - Pagina bank 7 en slot 3. Preserva AF + BC + resto del caller.
  72+ 6E2F              ; ==============================================================================
  73+ 6E2F              ; Llamado por:
  74+ 6E2F              ;   - Entry thunks al principio (para que el body bank 7 sea visible).
  75+ 6E2F              ;   - Body bank 7 despues de cada CALL externo (para retomar el flujo).
  76+ 6E2F              ; Destruye: ningun reg.
  77+ 6E2F              ; ==============================================================================
  78+ 6E2F              _PageBank7:
  79+ 6E2F F5               PUSH AF
  80+ 6E30 C5               PUSH BC
  81+ 6E31 3A 8A 8D         LD A, (CurrentPaging)
  82+ 6E34 E6 F8            AND $F8
  83+ 6E36 F6 07            OR 7
  84+ 6E38 32 8A 8D         LD (CurrentPaging), A
  85+ 6E3B 01 FD 7F         LD BC, $7FFD
  86+ 6E3E ED 79            OUT (C), A
  87+ 6E40 C1               POP BC
  88+ 6E41 F1               POP AF
  89+ 6E42 C9               RET
  90+ 6E43
  91+ 6E43              ; ==============================================================================
  92+ 6E43              ; CheckBankTriggerBg - Thunk de entry. Swap SP a alt_stack, pagina bank 7,
  93+ 6E43              ; ejecuta body, restaura bank 0 + SP normal.
  94+ 6E43              ; ==============================================================================
  95+ 6E43              ; Llamado desde MainLoop cada frame. Body verifica si el player toca la
  96+ 6E43              ; puerta del banco con el cheque y dispara la cutscene + avance de hito M9.
  97+ 6E43              ;
  98+ 6E43              ; CRITICO: stack normal vive en bank 0 (slot 3) -> desaparece al paginar bank 7.
  99+ 6E43              ; Por eso swap SP a alt_stack ANTES del page switch.
 100+ 6E43              ; ==============================================================================
 101+ 6E43              CheckBankTriggerBg:
 102+ 6E43 ED 73 58 6E      LD (.savedSPCheck), SP                   ; save SP normal (en bank 0)
 103+ 6E47 31 00 80         LD SP, BankCutsceneAltStackTop           ; SP -> alt_stack (slot 1 always-vis)
 104+ 6E4A CD 2F 6E         CALL _PageBank7
 105+ 6E4D CD 4F DE         CALL CheckBankTriggerBgBody
 106+ 6E50 CD 1D 6E         CALL _PageBank0                          ; bank 0 paginado -> SP normal accesible al restaurar
 107+ 6E53 ED 7B 58 6E      LD SP, (.savedSPCheck)                   ; restore SP normal
 108+ 6E57 C9               RET                                      ; vuelve al CALL del MainLoop
 109+ 6E58 00 00        .savedSPCheck: DEFW 0
 110+ 6E5A
 111+ 6E5A              ; ==============================================================================
 112+ 6E5A              ; UpdateBankCutscene - Thunk de entry para el tick por frame de la cutscene.
 113+ 6E5A              ; ==============================================================================
 114+ 6E5A              ; Mismo patron SP swap que CheckBankTriggerBg. Llamado desde MainLoop cada
 115+ 6E5A              ; frame si BankCutscenePhase != 0.
 116+ 6E5A              ; ==============================================================================
 117+ 6E5A              UpdateBankCutscene:
 118+ 6E5A ED 73 6F 6E      LD (.savedSPUpdate), SP
 119+ 6E5E 31 00 80         LD SP, BankCutsceneAltStackTop
 120+ 6E61 CD 2F 6E         CALL _PageBank7
 121+ 6E64 CD 58 DF         CALL UpdateBankCutsceneBody
 122+ 6E67 CD 1D 6E         CALL _PageBank0
 123+ 6E6A ED 7B 6F 6E      LD SP, (.savedSPUpdate)
 124+ 6E6E C9               RET
 125+ 6E6F 00 00        .savedSPUpdate: DEFW 0
 126+ 6E71
 127+ 6E71              ; ==============================================================================
 128+ 6E71              ; Entry thunks para town_gate_cutscene (body en bank 7)
 129+ 6E71              ; ==============================================================================
 130+ 6E71              ; Mutuamente exclusiva con bank_cutscene (M11 vs M9), comparte el alt_stack
 131+ 6E71              ; (no pueden estar activas a la vez por el milestone gating en MainLoop).
 132+ 6E71              ;
 133+ 6E71              ; StartTownGateCutscene NO necesita su propio entry thunk — se llama solo
 134+ 6E71              ; desde CheckTownGateTriggerBgBody (interno bank 7).
 135+ 6E71              ; ==============================================================================
 136+ 6E71              CheckTownGateTriggerBg:
 137+ 6E71 ED 73 86 6E      LD (.savedSPCheckTG), SP
 138+ 6E75 31 00 80         LD SP, BankCutsceneAltStackTop
 139+ 6E78 CD 2F 6E         CALL _PageBank7
 140+ 6E7B CD 35 E6         CALL CheckTownGateTriggerBgBody
 141+ 6E7E CD 1D 6E         CALL _PageBank0
 142+ 6E81 ED 7B 86 6E      LD SP, (.savedSPCheckTG)
 143+ 6E85 C9               RET
 144+ 6E86 00 00        .savedSPCheckTG: DEFW 0
 145+ 6E88
 146+ 6E88              UpdateTownGateCutscene:
 147+ 6E88 ED 73 9D 6E      LD (.savedSPUpdateTG), SP
 148+ 6E8C 31 00 80         LD SP, BankCutsceneAltStackTop
 149+ 6E8F CD 2F 6E         CALL _PageBank7
 150+ 6E92 CD A3 E6         CALL UpdateTownGateCutsceneBody
 151+ 6E95 CD 1D 6E         CALL _PageBank0
 152+ 6E98 ED 7B 9D 6E      LD SP, (.savedSPUpdateTG)
 153+ 6E9C C9               RET
 154+ 6E9D 00 00        .savedSPUpdateTG: DEFW 0
 155+ 6E9F
 156+ 6E9F              ; ==============================================================================
 157+ 6E9F              ; External call thunks - usados desde el body bank 7 para llamar a rutinas
 158+ 6E9F              ; que viven en bank 0 (o en slot 1 que internamente toca bank 0).
 159+ 6E9F              ; ==============================================================================
 160+ 6E9F              ; Patron: body bank 7 hace `CALL <Func>_B7`. El thunk pagina bank 0, llama a
 161+ 6E9F              ; la funcion real, repagina bank 7, y RETurnea al body. Args en HL/BC/DE/A/IX
 162+ 6E9F              ; quedan intactos (_PageBank0 / _PageBank7 preservan AF + BC via PUSH/POP).
 163+ 6E9F              ;
 164+ 6E9F              ; CRITICO: el body bank 7 NO puede llamar _PageBank0 directamente — al volver,
 165+ 6E9F              ; slot 3 estaria en bank 0 y el RET aterrizaria en bank 0 (no en bank 7) =
 166+ 6E9F              ; crash. Por eso cada wrap vive como thunk individual en slot 1 (always-vis).
 167+ 6E9F              ; ==============================================================================
 168+ 6E9F
 169+ 6E9F              ; --- bank 0 callees (paginar bank 0 antes, restaurar bank 7 al RET) ---
 170+ 6E9F
 171+ 6E9F              DrawBgSpriteXOR_B7:
 172+ 6E9F CD 1D 6E         CALL _PageBank0
 173+ 6EA2 CD 73 DC         CALL DrawBgSpriteXOR
 174+ 6EA5 C3 2F 6E         JP _PageBank7
 175+ 6EA8
 176+ 6EA8              ; DrawBgGfxSprite_B7 - draw + flags. El unico caller del body bank 7 es
 177+ 6EA8              ; BankCutsceneCloseDoorRestoreAttrs, que necesita BgSpriteIsHouse=0 y
 178+ 6EA8              ; CurrentTintVar=$FF antes del draw. Esas vars viven en BANK 0, asi que
 179+ 6EA8              ; se escriben aqui DENTRO del wrap pre-paginated. Antes era un thunk
 180+ 6EA8              ; aparte (DrawBankDoorSprite_B7) pero combinar ahorra 18 B en slot 1 —
 181+ 6EA8              ; critico para que magic_compass.asm no cruce $7A00 (im2 table).
 182+ 6EA8              DrawBgGfxSprite_B7:
 183+ 6EA8 CD 1D 6E         CALL _PageBank0
 184+ 6EAB AF               XOR A
 185+ 6EAC 32 48 E4         LD (BgSpriteIsHouse), A
 186+ 6EAF 3E FF            LD A, $FF
 187+ 6EB1 32 F0 D2         LD (CurrentTintVar), A
 188+ 6EB4 CD E6 D1         CALL DrawBgGfxSprite
 189+ 6EB7 C3 2F 6E         JP _PageBank7
 190+ 6EBA
 191+ 6EBA              RedrawPickupByPtr_B7:
