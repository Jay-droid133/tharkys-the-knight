1423+ F5BB              ; ==============================================================================
1424+ F5BB              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1425+ F5BB              ; ==============================================================================
1426+ F5BB              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1427+ F5BB              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1428+ F5BB              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1429+ F5BB              ; ==============================================================================
1430+ F5BB              ChurchCutsceneInitStatueShake:
1431+ F5BB 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1432+ F5BE 21 B1 64         LD HL, StatueIdTable
1433+ F5C1 5F               LD E, A
1434+ F5C2 16 00            LD D, 0
1435+ F5C4 19               ADD HL, DE
1436+ F5C5 7E               LD A, (HL)                              ; A = statue id
1437+ F5C6 B7               OR A
1438+ F5C7 C8               RET Z                                   ; sin estatua
1439+ F5C8 32 F8 F5         LD (.cisTargetId), A
1440+ F5CB                  ; Buscar en CurrentScreenBuffer
1441+ F5CB 2A 12 83         LD HL, (CurrentScreenAddr)
1442+ F5CE              .cisLoop:
1443+ F5CE 7E               LD A, (HL)
1444+ F5CF FE FF            CP $FF
1445+ F5D1 C8               RET Z                                   ; no encontrada (no se hace shake)
1446+ F5D2 47               LD B, A
1447+ F5D3 3A F8 F5         LD A, (.cisTargetId)
1448+ F5D6 B8               CP B
1449+ F5D7 28 06            JR Z, .cisFound
1450+ F5D9 11 04 00         LD DE, 4
1451+ F5DC 19               ADD HL, DE
1452+ F5DD 18 EF            JR .cisLoop
1453+ F5DF              .cisFound:
1454+ F5DF 23               INC HL
1455+ F5E0 7E               LD A, (HL)                              ; charX
1456+ F5E1                  ; Pixel X = charX * 8
1457+ F5E1 87               ADD A, A
1458+ F5E2 87               ADD A, A
1459+ F5E3 87               ADD A, A
1460+ F5E4 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1461+ F5E7 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1462+ F5EA 23               INC HL
1463+ F5EB 7E               LD A, (HL)                              ; charY
1464+ F5EC                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1465+ F5EC C6 02            ADD A, BG_Y_OFFSET
1466+ F5EE 87               ADD A, A
1467+ F5EF 87               ADD A, A
1468+ F5F0 87               ADD A, A
1469+ F5F1 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1470+ F5F4 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1471+ F5F7 C9               RET
1472+ F5F8 00           .cisTargetId: DEFB 0
1473+ F5F9
1474+ F5F9              ; ==============================================================================
1475+ F5F9              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1476+ F5F9              ; ==============================================================================
1477+ F5F9              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1478+ F5F9              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1479+ F5F9              ; ==============================================================================
1480+ F5F9              ChurchCutsceneEraseStatueAtLast:
1481+ F5F9              ChurchCutsceneDrawStatueAtLast:
1482+ F5F9 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1483+ F5FC 21 B1 64         LD HL, StatueIdTable
1484+ F5FF 5F               LD E, A
1485+ F600 16 00            LD D, 0
1486+ F602 19               ADD HL, DE
1487+ F603 7E               LD A, (HL)                              ; A = statue id
1488+ F604 B7               OR A
1489+ F605 C8               RET Z
1490+ F606                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1491+ F606 6F               LD L, A
1492+ F607 26 00            LD H, 0
1493+ F609 54               LD D, H
1494+ F60A 5D               LD E, L
1495+ F60B 29               ADD HL, HL
1496+ F60C 19               ADD HL, DE                              ; HL = id*3
1497+ F60D 11 EA E0         LD DE, BgGfxPtrById
1498+ F610 19               ADD HL, DE
1499+ F611 5E               LD E, (HL)
1500+ F612 23               INC HL
1501+ F613 56               LD D, (HL)                              ; DE = sprite ptr
1502+ F614 23               INC HL
1503+ F615 7E               LD A, (HL)                              ; A = bank
1504+ F616 EB               EX DE, HL                               ; HL = sprite ptr
1505+ F617 CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1506+ F61A                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1507+ F61A 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1508+ F61D 57               LD D, A
1509+ F61E 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1510+ F621 5F               LD E, A
1511+ F622 C3 39 66         JP DrawBgSprite16XorAtPixel
1512+ F625
1513+ F625              ; ==============================================================================
1514+ F625              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1515+ F625              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1516+ F625              ;     A  = jitter signed (-1, 0, +1) en bits.
1517+ F625              ; ==============================================================================
1518+ F625              ; IN: A = jitter signed (-1, 0, +1) en bits.
1519+ F625              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1520+ F625              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1521+ F625              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1522+ F625              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1523+ F625              ; version shifted, sin XOR.
1524+ F625              ;
1525+ F625              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1526+ F625              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1527+ F625              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1528+ F625              ; estatua se perdio cuando la estatua se pinto la primera vez con
1529+ F625              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1530+ F625              ; de la estatua, el wall perdido no se ve.
1531+ F625              ;
1532+ F625              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1533+ F625              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1534+ F625              ; shift de 1 bit no pierde pixels visibles.
1535+ F625              ; Destruye: AF, BC, DE, HL, IX.
1536+ F625              ; ==============================================================================
1537+ F625              ChurchCutsceneShakeStatueByteShift:
1538+ F625 32 8F F6         LD (.csbsJitter), A
1539+ F628                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1540+ F628 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1541+ F62B 5F               LD E, A
1542+ F62C 16 00            LD D, 0
1543+ F62E 19               ADD HL, DE
1544+ F62F 7E               LD A, (HL)
1545+ F630 B7               OR A
1546+ F631 C8               RET Z                                   ; sin estatua
1547+ F632 6F               LD L, A
1548+ F633 26 00            LD H, 0
1549+ F635 54               LD D, H
1550+ F636 5D               LD E, L
1551+ F637 29               ADD HL, HL
1552+ F638 19               ADD HL, DE                              ; HL = id*3
1553+ F639 11 EA E0         LD DE, BgGfxPtrById
1554+ F63C 19               ADD HL, DE
1555+ F63D 5E               LD E, (HL)
1556+ F63E 23               INC HL
1557+ F63F 56               LD D, (HL)                              ; DE = sprite ptr
1558+ F640 23               INC HL
1559+ F641 7E               LD A, (HL)                              ; A = bank
1560+ F642 EB               EX DE, HL                               ; HL = sprite ptr
1561+ F643 CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1562+ F646                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1563+ F646 DD 21 FD 86      LD IX, BgSpriteBuffer
1564+ F64A DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1565+ F64D B7               OR A
1566+ F64E C8               RET Z
1567+ F64F 47               LD B, A                                 ; B = row counter
1568+ F650 DD 23            INC IX
1569+ F652 DD 23            INC IX                                  ; IX -> pixel data
1570+ F654                  ; Calcular addr VRAM en (origX, origY)
1571+ F654 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1572+ F657 57               LD D, A
1573+ F658 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1574+ F65B 5F               LD E, A
1575+ F65C CD 62 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1576+ F65F              .csbsRow:
1577+ F65F C5               PUSH BC
1578+ F660 E5               PUSH HL                                 ; save inicio fila VRAM
1579+ F661                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1580+ F661 DD 7E 00         LD A, (IX+0)
1581+ F664 2F               CPL
1582+ F665 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1583+ F666 DD 7E 01         LD A, (IX+1)
1584+ F669 2F               CPL
1585+ F66A 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1586+ F66B                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1587+ F66B 3A 8F F6         LD A, (.csbsJitter)
1588+ F66E B7               OR A
1589+ F66F 28 0D            JR Z, .csbsWrite                        ; sin shift
1590+ F671 FA 7A F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1591+ F674                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1592+ F674 CB 3A            SRL D
1593+ F676 CB 1B            RR E
1594+ F678 18 04            JR .csbsWrite
1595+ F67A              .csbsLeft:
1596+ F67A CB 23            SLA E
1597+ F67C CB 12            RL D
1598+ F67E              .csbsWrite:
1599+ F67E 7A               LD A, D
1600+ F67F 77               LD (HL), A
1601+ F680 23               INC HL
1602+ F681 7B               LD A, E
1603+ F682 77               LD (HL), A
1604+ F683 E1               POP HL
1605+ F684 CD CE 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1606+ F687 DD 23            INC IX
1607+ F689 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1608+ F68B C1               POP BC
1609+ F68C 10 D1            DJNZ .csbsRow
1610+ F68E C9               RET
1611+ F68F 00           .csbsJitter: DEFB 0
1612+ F690
1613+ F690              ; ==============================================================================
1614+ F690              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1615+ F690              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1616+ F690              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1617+ F690              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1618+ F690              ; Destruye: AF, BC, HL.
1619+ F690              ; ==============================================================================
1620+ F690              ChurchCutsceneEraseStatueDirect:
1621+ F690 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1622+ F693 57               LD D, A
1623+ F694 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1624+ F697 5F               LD E, A
1625+ F698 CD 62 9D         CALL CalcPixelAddr
1626+ F69B 06 18            LD B, 24                                ; statues son 24 px de alto
1627+ F69D              .csedRow:
1628+ F69D AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1629+ F69E 77               LD (HL), A
1630+ F69F 23               INC HL
1631+ F6A0 77               LD (HL), A
1632+ F6A1 2B               DEC HL                                  ; volver a inicio fila
1633+ F6A2 C5               PUSH BC
1634+ F6A3 CD CE 9A         CALL NextPixelLine
1635+ F6A6 C1               POP BC
1636+ F6A7 10 F4            DJNZ .csedRow
1637+ F6A9 C9               RET
1638+ F6AA
1639+ F6AA              ; ==============================================================================
1640+ F6AA              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1641+ F6AA              ; ==============================================================================
1642+ F6AA              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1643+ F6AA              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1644+ F6AA              ; suficiente para corromper visualmente).
1645+ F6AA              ; IN: IX = entity ptr.
1646+ F6AA              ; ==============================================================================
1647+ F6AA              RedrawTrappedMonster:
1648+ F6AA                  ; --- Erase viejo en (OLDX, OLDY) ---
1649+ F6AA CD 23 A5         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1650+ F6AD DD 7E 0D         LD A, (IX+ENT_OLDY)
1651+ F6B0 57               LD D, A
1652+ F6B1 DD 7E 0C         LD A, (IX+ENT_OLDX)
1653+ F6B4 5F               LD E, A
1654+ F6B5 DD E5            PUSH IX
1655+ F6B7 DD 2A AB A4      LD IX, (OldSprAddr)
1656+ F6BB CD EF 99         CALL DrawSprite
1657+ F6BE DD E1            POP IX
1658+ F6C0                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1659+ F6C0                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1660+ F6C0 DD 56 0D         LD D, (IX+ENT_OLDY)
1661+ F6C3 DD 5E 0C         LD E, (IX+ENT_OLDX)
1662+ F6C6 CD 5D D3         CALL RestoreOldAttr
1663+ F6C9                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1664+ F6C9                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1665+ F6C9                  ; reponer attrs de pickups que el flujo de entidades pisa con
1666+ F6C9                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1667+ F6C9                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1668+ F6C9                  ; estar bajo el monster.
1669+ F6C9 DD E5            PUSH IX
1670+ F6CB CD 67 DA         CALL RefreshPickupAttrs
1671+ F6CE DD E1            POP IX
1672+ F6D0                  ; --- Compute new draw pos ---
1673+ F6D0 CD AD A4         CALL CalcDrawX
1674+ F6D3 CD 45 9F         CALL ComputeEnemyDrawY
1675+ F6D6                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1676+ F6D6 CD F2 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1677+ F6D9 3A E5 82         LD A, (EnemyDrawY)
1678+ F6DC 57               LD D, A
1679+ F6DD DD 7E 0F         LD A, (IX+ENT_DRAWX)
1680+ F6E0 5F               LD E, A
1681+ F6E1 DD E5            PUSH IX
1682+ F6E3 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
1683+ F6E7 CD 0C 9B         CALL CalcEntityAttrSize
1684+ F6EA DD E1            POP IX
1685+ F6EC 3A E5 82         LD A, (EnemyDrawY)
1686+ F6EF 57               LD D, A
1687+ F6F0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1688+ F6F3 5F               LD E, A
1689+ F6F4 DD 7E 05         LD A, (IX+ENT_ATTR)
1690+ F6F7 CD DF 9A         CALL SetEntityAttr
1691+ F6FA                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1692+ F6FA 3A E5 82         LD A, (EnemyDrawY)
1693+ F6FD 57               LD D, A
1694+ F6FE DD 7E 0F         LD A, (IX+ENT_DRAWX)
1695+ F701 5F               LD E, A
1696+ F702 DD E5            PUSH IX
1697+ F704 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
1698+ F708 CD EF 99         CALL DrawSprite
1699+ F70B DD E1            POP IX
1700+ F70D                  ; --- Save OLD = current ---
1701+ F70D DD 7E 0F         LD A, (IX+ENT_DRAWX)
1702+ F710 DD 77 0C         LD (IX+ENT_OLDX), A
1703+ F713 3A E5 82         LD A, (EnemyDrawY)
1704+ F716 DD 77 0D         LD (IX+ENT_OLDY), A
1705+ F719 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1706+ F71C DD 77 0E         LD (IX+ENT_OLDSPRID), A
1707+ F71F C9               RET
