3691+ B6D6                  ; --- Penalizar bordes sin salida (dist=255) ---
3692+ B6D6 CD B9 B8         CALL .flCheckHEdge              ; A=1 si borde H tiene salida, 0 si no
3693+ B6D9 B7               OR A
3694+ B6DA 20 05            JR NZ, .flHEdgeOk
3695+ B6DC 3E FF            LD A, 255
3696+ B6DE 32 F5 B8         LD (.flHDist), A                ; Sin salida → maxima distancia
3697+ B6E1              .flHEdgeOk:
