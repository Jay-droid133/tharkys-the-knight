3547+ A68B              ; ==============================================================================
3548+ A68B              ; CheckEnemyCollision - Colision enemigo contra fondo (2 puntos, simplificado)
3549+ A68B              ; ==============================================================================
3550+ A68B              ; IX = entidad. Salida: Z=libre, NZ=colision.
3551+ A68B              ; ==============================================================================
3552+ A68B              CheckEnemyCollision:
3553+ A68B                  ; Testea TODAS las celdas del bbox del enemigo en CollisionMap
3554+ A68B                  ; (no solo las 4 esquinas: podian dejar pasar obstaculos pequenyos
3555+ A68B                  ; como el pozo o el bench cuando el enemigo cae desalineado).
3556+ A68B DD 7E 00         LD A, (IX+ENT_SPRITEID)
3557+ A68E CD F4 96         CALL GetSpriteDims              ; B=W_px, C=H_px
3558+ A691                  ; --- Char X range ---
3559+ A691 DD 7E 03         LD A, (IX+ENT_POSX)
3560+ A694 57               LD D, A                         ; D = posX
3561+ A695 0F               RRCA
3562+ A696 0F               RRCA
3563+ A697 0F               RRCA
3564+ A698 E6 1F            AND $1F
3565+ A69A 32 0B A7         LD (.ecXlo), A                  ; charXlo
3566+ A69D 7A               LD A, D
3567+ A69E 80               ADD A, B
3568+ A69F 3D               DEC A                           ; posX + W - 1
3569+ A6A0 0F               RRCA
3570+ A6A1 0F               RRCA
3571+ A6A2 0F               RRCA
3572+ A6A3 E6 1F            AND $1F
3573+ A6A5 5F               LD E, A                         ; E = charXhi
3574+ A6A6 3A 0B A7         LD A, (.ecXlo)
3575+ A6A9 57               LD D, A
3576+ A6AA 7B               LD A, E
3577+ A6AB 92               SUB D
3578+ A6AC 3C               INC A                           ; width_chars
3579+ A6AD 32 0D A7         LD (.ecWc), A
3580+ A6B0                  ; --- Char Y range ---
3581+ A6B0 DD 7E 04         LD A, (IX+ENT_POSY)
3582+ A6B3 47               LD B, A                         ; B = posY (salvar)
3583+ A6B4 0F               RRCA
3584+ A6B5 0F               RRCA
3585+ A6B6 0F               RRCA
3586+ A6B7 E6 1F            AND $1F
3587+ A6B9 D6 02            SUB BG_Y_OFFSET
3588+ A6BB 32 0C A7         LD (.ecYlo), A
3589+ A6BE 78               LD A, B
3590+ A6BF 81               ADD A, C
3591+ A6C0 3D               DEC A                           ; posY + H - 1
3592+ A6C1 0F               RRCA
3593+ A6C2 0F               RRCA
3594+ A6C3 0F               RRCA
3595+ A6C4 E6 1F            AND $1F
3596+ A6C6 D6 02            SUB BG_Y_OFFSET
3597+ A6C8 47               LD B, A                         ; B = charYhi
3598+ A6C9 3A 0C A7         LD A, (.ecYlo)
3599+ A6CC ED 44            NEG
3600+ A6CE 80               ADD A, B
3601+ A6CF 3C               INC A                           ; height_chars
3602+ A6D0 32 0E A7         LD (.ecHc), A
3603+ A6D3                  ; --- HL = CollisionMap + charYlo*32 + charXlo ---
3604+ A6D3 3A 0C A7         LD A, (.ecYlo)
3605+ A6D6 FE 16            CP 22
3606+ A6D8 30 2C            JR NC, .ecFree                  ; fuera de rango (underflow HUD o abajo)
3607+ A6DA 6F               LD L, A
3608+ A6DB 26 00            LD H, 0
3609+ A6DD 29               ADD HL, HL
3610+ A6DE 29               ADD HL, HL
3611+ A6DF 29               ADD HL, HL
3612+ A6E0 29               ADD HL, HL
3613+ A6E1 29               ADD HL, HL                      ; *32
3614+ A6E2 3A 0B A7         LD A, (.ecXlo)
3615+ A6E5 85               ADD A, L
3616+ A6E6 6F               LD L, A
3617+ A6E7 30 01            JR NC, .ecNoCarry
3618+ A6E9 24               INC H
3619+ A6EA              .ecNoCarry:
3620+ A6EA 11 D3 81         LD DE, CollisionMap
