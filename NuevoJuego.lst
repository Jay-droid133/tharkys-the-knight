  23+ 6B3C              ; TombStore - Anade una tumba en la sala/posicion actual del player muerto
  24+ 6B3C              ; ==============================================================================
  25+ 6B3C              ; Lee CurrentScreenX/Y + EntityTable[player].POSX/POSY. Si TombstoneCount<MAX,
  26+ 6B3C              ; escribe entry en bank 7 y bumpea el contador. No-op si tope alcanzado.
  27+ 6B3C              ; Destruye: A, BC, DE, HL.
  28+ 6B3C              ; ==============================================================================
  29+ 6B3C              TombStore:
  30+ 6B3C 3A 98 82         LD A, (TombstoneCount)
  31+ 6B3F FE C8            CP TOMBSTONE_MAX
  32+ 6B41 D0               RET NC                                  ; tope alcanzado
  33+ 6B42
  34+ 6B42                  ; HL = TOMBSTONE_ADDR + count * 4
  35+ 6B42 26 00            LD H, 0
  36+ 6B44 6F               LD L, A
  37+ 6B45 29               ADD HL, HL                              ; *2
  38+ 6B46 29               ADD HL, HL                              ; *4
  39+ 6B47 11 00 E0         LD DE, TOMBSTONE_ADDR
  40+ 6B4A 19               ADD HL, DE                              ; HL = slot a escribir (bank 7)
  41+ 6B4B
  42+ 6B4B F3               DI
  43+ 6B4C                  ; --- Page bank 7 en slot 3 (inline; no CALL — stack vive en slot 3) ---
  44+ 6B4C 3A E7 90         LD A, (CurrentPaging)
  45+ 6B4F E6 F8            AND $F8
  46+ 6B51 F6 07            OR TOMBSTONE_BANK
  47+ 6B53 32 E7 90         LD (CurrentPaging), A
  48+ 6B56 01 FD 7F         LD BC, $7FFD
  49+ 6B59 ED 79            OUT (C), A
  50+ 6B5B
  51+ 6B5B                  ; --- Escribir 4 bytes (sin PUSH/POP/CALL: stack vive en bank 7 ahora) ---
  52+ 6B5B 3A AD 82         LD A, (CurrentScreenX)
  53+ 6B5E 77               LD (HL), A
  54+ 6B5F 23               INC HL
  55+ 6B60 3A AE 82         LD A, (CurrentScreenY)
  56+ 6B63 77               LD (HL), A
  57+ 6B64 23               INC HL
  58+ 6B65 3A 4E 81         LD A, (EntityTable + ENT_POSX)
  59+ 6B68 77               LD (HL), A
  60+ 6B69 23               INC HL
  61+ 6B6A 3A 4F 81         LD A, (EntityTable + ENT_POSY)
  62+ 6B6D 77               LD (HL), A
  63+ 6B6E
  64+ 6B6E                  ; --- Page bank 0 ---
  65+ 6B6E 3A E7 90         LD A, (CurrentPaging)
  66+ 6B71 E6 F8            AND $F8
  67+ 6B73 32 E7 90         LD (CurrentPaging), A
  68+ 6B76 01 FD 7F         LD BC, $7FFD
  69+ 6B79 ED 79            OUT (C), A
  70+ 6B7B
  71+ 6B7B 3A 4A 81         LD A, (StartupComplete)
  72+ 6B7E B7               OR A
  73+ 6B7F 28 01            JR Z, .tsNoEI
  74+ 6B81 FB               EI
  75+ 6B82              .tsNoEI:
  76+ 6B82 3A 98 82         LD A, (TombstoneCount)
  77+ 6B85 3C               INC A
  78+ 6B86 32 98 82         LD (TombstoneCount), A
  79+ 6B89 C9               RET
