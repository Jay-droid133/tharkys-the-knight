 529+ E64A              .hexToAscii:
 530+ E64A FE 0A            CP 10
 531+ E64C 38 03            JR C, .isDigit
 532+ E64E C6 37            ADD A, 'A' - 10
 533+ E650 C9               RET
 534+ E651              .isDigit:
 535+ E651 C6 30            ADD A, '0'
 536+ E653 C9               RET
