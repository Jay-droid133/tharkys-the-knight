  84  8443                  INCLUDE "engine_graphics.asm"
# file opened: engine_graphics.asm
   1+ 8443              ; ==============================================================================
   2+ 8443              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 8443              ; ==============================================================================
   4+ 8443              ; Sistema fiel a Sabre Wulf:
   5+ 8443              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 8443              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 8443              ; - NextPixelLine para cruzar character rows y tercios
   8+ 8443              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 8443              ; ==============================================================================
  10+ 8443
  11+ 8443              ClearScreen:
  12+ 8443 CD AF 0D         CALL ROM_CLS
  13+ 8446 C9               RET
  14+ 8447
  15+ 8447              ; ==============================================================================
  16+ 8447              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 8447              ; ==============================================================================
  18+ 8447              ; Entrada:
  19+ 8447              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 8447              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 8447              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 8447              ;
  23+ 8447              ; Formato del sprite:
  24+ 8447              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 8447              ;   DEFB height_pixels
  26+ 8447              ;   DEFB pixel_data... (width * height bytes)
  27+ 8447              ;
  28+ 8447              ; Dos paths:
  29+ 8447              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 8447              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 8447              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 8447              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 8447              ;
  34+ 8447              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 8447              ; ==============================================================================
  36+ 8447              DrawSprite:
  37+ 8447                  ; Guardar posicion
  38+ 8447 7A               LD A, D
  39+ 8448 32 CA 84         LD (.posY), A
  40+ 844B 7B               LD A, E
  41+ 844C 32 C9 84         LD (.posX), A
  42+ 844F
  43+ 844F                  ; Leer cabecera sprite
  44+ 844F DD 7E 00         LD A, (IX+0)                ; width_bytes
  45+ 8452 32 CB 84         LD (.widthSave), A
  46+ 8455 DD 7E 01         LD A, (IX+1)                ; height_pixels
  47+ 8458 32 CC 84         LD (.heightSave), A
  48+ 845B DD 23            INC IX
  49+ 845D DD 23            INC IX                      ; IX → pixel data
  50+ 845F
  51+ 845F                  ; Comprobar alineacion
  52+ 845F 7B               LD A, E
  53+ 8460 E6 07            AND 7
  54+ 8462 20 1E            JR NZ, .shifted
  55+ 8464
  56+ 8464                  ; ==================================================================
  57+ 8464                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
  58+ 8464                  ; ==================================================================
  59+ 8464 CD 14 87         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
  60+ 8467 3A CC 84         LD A, (.heightSave)
  61+ 846A 4F               LD C, A                     ; C = height counter
