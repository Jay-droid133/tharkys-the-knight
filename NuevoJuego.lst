7361+ CC7B 3A 78 5F         LD A, (DBfsTryCx)
7362+ CC7E B8               CP B
7363+ CC7F 20 0A            JR NZ, .bivNext
7364+ CC81 3A 79 5F         LD A, (DBfsTryCy)
7365+ CC84 B9               CP C
7366+ CC85 20 04            JR NZ, .bivNext
7367+ CC87                  ; Match
7368+ CC87 3E 01            LD A, 1
7369+ CC89 B7               OR A                                ; NZ
7370+ CC8A C9               RET
7371+ CC8B              .bivNext:
7372+ CC8B 3E 04            LD A, 4
7373+ CC8D 85               ADD A, L
7374+ CC8E 6F               LD L, A
7375+ CC8F 30 DD            JR NC, .bivLoop
7376+ CC91 24               INC H
7377+ CC92 18 DA            JR .bivLoop
7378+ CC94              .bivNotFound:
7379+ CC94 AF               XOR A                               ; Z
7380+ CC95 C9               RET
7381+ CC96
7382+ CC96              ; --- bfsCanFit: footprint 3x3 de Death en CollisionMap libre? ---
7383+ CC96              ; IN: DBfsTryCx, DBfsTryCy. OUT: Z=libre, NZ=bloqueado.
7384+ CC96              .bfsCanFit:
7385+ CC96 3A 79 5F         LD A, (DBfsTryCy)
7386+ CC99 26 00            LD H, 0
7387+ CC9B 6F               LD L, A
7388+ CC9C 29               ADD HL, HL
7389+ CC9D 29               ADD HL, HL
7390+ CC9E 29               ADD HL, HL
7391+ CC9F 29               ADD HL, HL
7392+ CCA0 29               ADD HL, HL                          ; HL = cy*32
7393+ CCA1 3A 78 5F         LD A, (DBfsTryCx)
7394+ CCA4 85               ADD A, L
7395+ CCA5 6F               LD L, A
7396+ CCA6 30 01            JR NC, .cfNoCarry
7397+ CCA8 24               INC H
7398+ CCA9              .cfNoCarry:
7399+ CCA9 11 BC 82         LD DE, CollisionMap
7400+ CCAC 19               ADD HL, DE                          ; HL = &CollisionMap[cy][cx]
7401+ CCAD 0E 03            LD C, 3                             ; filas restantes
7402+ CCAF              .cfRow:
7403+ CCAF E5               PUSH HL
7404+ CCB0 06 03            LD B, 3                             ; cols restantes
7405+ CCB2              .cfCol:
7406+ CCB2 7E               LD A, (HL)
7407+ CCB3 B7               OR A
7408+ CCB4 20 0D            JR NZ, .cfBlocked
7409+ CCB6 23               INC HL
7410+ CCB7 10 F9            DJNZ .cfCol
7411+ CCB9 E1               POP HL
7412+ CCBA 11 20 00         LD DE, 32
7413+ CCBD 19               ADD HL, DE
7414+ CCBE 0D               DEC C
7415+ CCBF 20 EE            JR NZ, .cfRow
7416+ CCC1 AF               XOR A                               ; Z
7417+ CCC2 C9               RET
7418+ CCC3              .cfBlocked:
7419+ CCC3 E1               POP HL
7420+ CCC4 3E 01            LD A, 1
7421+ CCC6 B7               OR A                                ; NZ
7422+ CCC7 C9               RET
7423+ CCC8
7424+ CCC8              ; ==============================================================================
7425+ CCC8              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7426+ CCC8              ; ==============================================================================
7427+ CCC8              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7428+ CCC8              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7429+ CCC8              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7430+ CCC8              ; ==============================================================================
7431+ CCC8              ; ==============================================================================
7432+ CCC8              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7433+ CCC8              ; ==============================================================================
7434+ CCC8              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7435+ CCC8              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7436+ CCC8              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7437+ CCC8              ; los pone a su default.
7438+ CCC8              ; ==============================================================================
7439+ CCC8              InitGameState:
7440+ CCC8 3E 03            LD A, PLAYER_LIVES_INIT
7441+ CCCA 32 66 82         LD (PlayerLives), A
7442+ CCCD 3E 10            LD A, HEALTH_MAX
7443+ CCCF 32 D9 B6         LD (PlayerHealth), A
7444+ CCD2 3E 10            LD A, STAMINA_MAX
7445+ CCD4 32 DA B6         LD (PlayerStamina), A
7446+ CCD7 AF               XOR A
7447+ CCD8 32 67 82         LD (GameOver), A
7448+ CCDB 32 51 82         LD (CurrentObjective), A
7449+ CCDE 32 49 82         LD (CurrentKey), A
7450+ CCE1 32 4D 82         LD (ChurchEverOpened), A
7451+ CCE4 32 4C 82         LD (ChurchDoorOpen), A
7452+ CCE7 32 4E 82         LD (TimeFrozen), A
7453+ CCEA 32 4B 82         LD (ChurchKeySpawned), A
7454+ CCED 32 5C 82         LD (TownGateKeySpawned), A
7455+ CCF0 32 5F 82         LD (ArmRevealed), A
7456+ CCF3 32 60 82         LD (FingerRevealed), A
7457+ CCF6 32 DF B6         LD (MonstersActive), A
7458+ CCF9 32 58 82         LD (MonsterTrappedFlags), A
7459+ CCFC 32 81 82         LD (DeathSpawned), A
7460+ CCFF 32 5E 82         LD (TownGatePhase), A
7461+ CD02 32 5D 82         LD (ChurchCutscenePhase), A
7462+ CD05 32 93 E4         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7463+ CD08 32 50 82         LD (BellsTriggered), A
7464+ CD0B 32 59 82         LD (NextChurchTrapStep), A
7465+ CD0E 32 5A 82         LD (StatueBlinkCounter), A
7466+ CD11 32 5B 82         LD (ChurchKeyAltSpawnIdx), A
7467+ CD14 32 6C C8         LD (PlayerHitTimer), A
7468+ CD17 32 7B 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7469+ CD1A 32 7C 82         LD (TombDrawPending), A
7470+ CD1D 32 6F 82         LD (DeathBorderPhase), A
7471+ CD20 32 70 82         LD (DeathBorderTimer), A
7472+ CD23 32 71 82         LD (PlayerDeathAnimTimer), A
7473+ CD26 32 72 82         LD (PlayerDeathAnimFrame), A
7474+ CD29 32 73 82         LD (PlayerRespawnPhase), A
7475+ CD2C 32 74 82         LD (PlayerRespawnTimer), A
7476+ CD2F 32 75 82         LD (PlayerRespawnBlinkTimer), A
7477+ CD32 32 77 82         LD (PlayerRespawnBeatIdx), A
7478+ CD35 32 68 82         LD (GameOverAnimX), A
7479+ CD38 32 69 82         LD (GameOverAnimDir), A
7480+ CD3B 32 6A 82         LD (GameOverAnimFrame), A
7481+ CD3E 32 6B 82         LD (GameOverAnimFrameTimer), A
7482+ CD41 32 6E 82         LD (GameOverAnimLastX), A
7483+ CD44 21 00 00         LD HL, 0
7484+ CD47 22 6C 82         LD (GameOverAnimLastSpr), HL
7485+ CD4A 22 7F 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7486+ CD4D 3E 01            LD A, 1
7487+ CD4F 32 76 82         LD (PlayerRespawnVisible), A
7488+ CD52 3E 00            LD A, BLACK
7489+ CD54 32 CA 90         LD (CurrentBorderColor), A
7490+ CD57 D3 FE            OUT (254), A
7491+ CD59 3E 01            LD A, 1
7492+ CD5B 32 6F C0         LD (DayCycleCount), A
7493+ CD5E 21 53 C0         LD HL, DiurnalTypeTable
7494+ CD61 22 70 C0         LD (CurrentNastyTable), HL
7495+ CD64 C9               RET
7496+ CD65
7497+ CD65              OnPlayerHealthDepleted:
7498+ CD65                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7499+ CD65                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7500+ CD65 CD D2 6C         CALL AY_PlayPlayerDeath
7501+ CD68                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7502+ CD68                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7503+ CD68 3E 02            LD A, 2
7504+ CD6A 32 4E 82         LD (TimeFrozen), A
7505+ CD6D                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7506+ CD6D CD 03 6B         CALL TombStore
7507+ CD70                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7508+ CD70 CD AF BD         CALL KillAllActiveNasties
7509+ CD73                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7510+ CD73 CD 7D BE         CALL SilentKillDeath
7511+ CD76                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7512+ CD76 CD 98 BE         CALL FreezeMonstersFacingCorpse
7513+ CD79                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7514+ CD79 CD 17 CE         CALL TriggerDeathBorder
7515+ CD7C                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7516+ CD7C                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7517+ CD7C                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7518+ CD7C DD 21 36 81      LD IX, EntityTable
7519+ CD80                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7520+ CD80 DD 7E 0A         LD A, (IX+ENT_DIR)
7521+ CD83 E6 80            AND $80
7522+ CD85 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7523+ CD87 28 02            JR Z, .ophdRightBase
7524+ CD89 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7525+ CD8B              .ophdRightBase:
7526+ CD8B DD 77 00         LD (IX+ENT_SPRITEID), A
7527+ CD8E DD 36 06 00      LD (IX+ENT_DELTAX), 0
7528+ CD92 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7529+ CD96 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7530+ CD98 32 71 82         LD (PlayerDeathAnimTimer), A
7531+ CD9B AF               XOR A
7532+ CD9C 32 72 82         LD (PlayerDeathAnimFrame), A
7533+ CD9F                  ; Decrementar vida (clamp a 0)
7534+ CD9F 3A 66 82         LD A, (PlayerLives)
7535+ CDA2 B7               OR A
7536+ CDA3 C8               RET Z
7537+ CDA4 3D               DEC A
7538+ CDA5 32 66 82         LD (PlayerLives), A
7539+ CDA8 C9               RET
7540+ CDA9
7541+ CDA9              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7542+ CDA9              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7543+ CDA9              ErasePlayerSpriteAtOldPos:
7544+ CDA9 DD 21 36 81      LD IX, EntityTable
7545+ CDAD CD C1 A8         CALL GetOldSpriteAddr
7546+ CDB0 DD 56 0D         LD D, (IX+ENT_OLDY)
7547+ CDB3 DD 7E 0C         LD A, (IX+ENT_OLDX)
7548+ CDB6 5F               LD E, A
7549+ CDB7 DD E5            PUSH IX
7550+ CDB9 DD 2A 49 A8      LD IX, (OldSprAddr)
7551+ CDBD CD CE 9D         CALL DrawSprite
7552+ CDC0 DD E1            POP IX
7553+ CDC2 DD 56 0D         LD D, (IX+ENT_OLDY)
7554+ CDC5 DD 5E 0C         LD E, (IX+ENT_OLDX)
7555+ CDC8 C3 9A D5         JP RestoreOldAttr                   ; tail-call
7556+ CDCB
7557+ CDCB              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7558+ CDCB              RespawnPlayerAtEntry:
7559+ CDCB DD 21 36 81      LD IX, EntityTable
7560+ CDCF 3A 95 82         LD A, (LastEntryPosX)
7561+ CDD2 DD 77 03         LD (IX+ENT_POSX), A
7562+ CDD5 DD 77 0C         LD (IX+ENT_OLDX), A
7563+ CDD8 DD 77 0F         LD (IX+ENT_DRAWX), A
7564+ CDDB 3A 96 82         LD A, (LastEntryPosY)
7565+ CDDE DD 77 04         LD (IX+ENT_POSY), A
7566+ CDE1 DD 77 0D         LD (IX+ENT_OLDY), A
7567+ CDE4 3E 10            LD A, HEALTH_MAX
7568+ CDE6 32 D9 B6         LD (PlayerHealth), A
7569+ CDE9 3E 10            LD A, STAMINA_MAX
7570+ CDEB 32 DA B6         LD (PlayerStamina), A
7571+ CDEE DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7572+ CDF2 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7573+ CDF6 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7574+ CDFA DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7575+ CDFE DD 36 06 00      LD (IX+ENT_DELTAX), 0
7576+ CE02 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7577+ CE06 DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7578+ CE0A                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7579+ CE0A                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7580+ CE0A 3E 01            LD A, 1
7581+ CE0C 32 73 82         LD (PlayerRespawnPhase), A
7582+ CE0F AF               XOR A
7583+ CE10 32 74 82         LD (PlayerRespawnTimer), A
7584+ CE13 32 77 82         LD (PlayerRespawnBeatIdx), A
7585+ CE16 C9               RET
7586+ CE17
7587+ CE17              ; ==============================================================================
7588+ CE17              ; TriggerDeathBorder - arranca el flash del borde tras morir
7589+ CE17              ; ==============================================================================
7590+ CE17              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7591+ CE17              ; luego vuelve a negro y se desactiva.
7592+ CE17              ; ==============================================================================
7593+ CE17              TriggerDeathBorder:
7594+ CE17 3E 01            LD A, 1
7595+ CE19 32 6F 82         LD (DeathBorderPhase), A
7596+ CE1C 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7597+ CE1E 32 70 82         LD (DeathBorderTimer), A
7598+ CE21 3E 06            LD A, YELLOW
7599+ CE23 32 CA 90         LD (CurrentBorderColor), A
7600+ CE26 D3 FE            OUT (254), A
7601+ CE28 C9               RET
7602+ CE29
7603+ CE29              ; ==============================================================================
7604+ CE29              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7605+ CE29              ; ==============================================================================
7606+ CE29              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7607+ CE29              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7608+ CE29              ; ==============================================================================
7609+ CE29              UpdateRespawnBlink:
7610+ CE29 3A 73 82         LD A, (PlayerRespawnPhase)
7611+ CE2C B7               OR A
7612+ CE2D C8               RET Z
7613+ CE2E 3D               DEC A
7614+ CE2F 28 0D            JR Z, .urbPhase1
7615+ CE31                  ; Phase 2: solo timer (sin parpadeo)
7616+ CE31 3A 74 82         LD A, (PlayerRespawnTimer)
7617+ CE34 3D               DEC A
7618+ CE35 32 74 82         LD (PlayerRespawnTimer), A
7619+ CE38 C0               RET NZ
7620+ CE39 AF               XOR A
7621+ CE3A 32 73 82         LD (PlayerRespawnPhase), A
7622+ CE3D C9               RET
7623+ CE3E
7624+ CE3E              .urbPhase1:
7625+ CE3E                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7626+ CE3E                  ; Zero input (sin control)
7627+ CE3E AF               XOR A
7628+ CE3F 32 46 82         LD (InputDirection), A
7629+ CE42 32 47 82         LD (InputFire), A
7630+ CE45                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7631+ CE45                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7632+ CE45 3A C7 6C         LD A, (BeepDurationFrames)
7633+ CE48 D6 01            SUB 1                               ; CY si era 0 (silencio)
7634+ CE4A 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7635+ CE4B E6 74            AND SPRID_PLAYER_BLANK
7636+ CE4D 32 36 81         LD (EntityTable), A
7637+ CE50                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7638+ CE50 3A 74 82         LD A, (PlayerRespawnTimer)
7639+ CE53 B7               OR A
7640+ CE54 28 05            JR Z, .urb1FireBeat
7641+ CE56 3D               DEC A
7642+ CE57 32 74 82         LD (PlayerRespawnTimer), A
7643+ CE5A C9               RET
7644+ CE5B              .urb1FireBeat:
7645+ CE5B 3A 77 82         LD A, (PlayerRespawnBeatIdx)
7646+ CE5E 3C               INC A
7647+ CE5F 32 77 82         LD (PlayerRespawnBeatIdx), A
7648+ CE62 FE 04            CP 4
7649+ CE64 28 12            JR Z, .urb1LastBeat
7650+ CE66 FE 05            CP 5
7651+ CE68 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7652+ CE6A                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7653+ CE6A 21 80 00         LD HL, $0080                ; ~853 Hz (agudo medio)
7654+ CE6D 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7655+ CE6F CD F7 6C         CALL AY_PlayBeep
7656+ CE72                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7657+ CE72                  ; (mitad) para mantener ON/OFF ~50/50.
7658+ CE72 3E 14            LD A, 20
7659+ CE74 32 74 82         LD (PlayerRespawnTimer), A
7660+ CE77 C9               RET
7661+ CE78              .urb1LastBeat:
7662+ CE78                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7663+ CE78                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7664+ CE78                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7665+ CE78                  ; entra grace EXACTAMENTE al terminar el beep.
7666+ CE78 21 40 00         LD HL, $0040                ; ~1707 Hz (octava arriba)
7667+ CE7B 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7668+ CE7D CD F7 6C         CALL AY_PlayBeep
7669+ CE80 3E 0B            LD A, 11                    ; espera = duracion del beep
7670+ CE82 32 74 82         LD (PlayerRespawnTimer), A
7671+ CE85 C9               RET
7672+ CE86              .urb1AfterBeep:
7673+ CE86                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7674+ CE86                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7675+ CE86 CD 9F CE         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7676+ CE89 3E 0C            LD A, SPAWN_INTERVAL
7677+ CE8B 32 7D 82         LD (SpawnTimer), A
7678+ CE8E AF               XOR A
7679+ CE8F 32 81 82         LD (DeathSpawned), A
7680+ CE92 32 78 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7681+ CE95 32 4E 82         LD (TimeFrozen), A              ; Reanudar reloj
7682+ CE98 21 00 00         LD HL, 0
7683+ CE9B 22 7F 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7684+ CE9E C9               RET
7685+ CE9F
7686+ CE9F              ; ==============================================================================
7687+ CE9F              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7688+ CE9F              ; ==============================================================================
7689+ CE9F              ; Llamado desde:
7690+ CE9F              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7691+ CE9F              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7692+ CE9F              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7693+ CE9F              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7694+ CE9F              ; ==============================================================================
7695+ CE9F              EnterGracePhase:
7696+ CE9F 3E 02            LD A, 2
7697+ CEA1 32 73 82         LD (PlayerRespawnPhase), A
7698+ CEA4 3E 19            LD A, RESPAWN_GRACE_FRAMES
7699+ CEA6 32 74 82         LD (PlayerRespawnTimer), A
7700+ CEA9 C9               RET
7701+ CEAA
7702+ CEAA              ; ==============================================================================
7703+ CEAA              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7704+ CEAA              ; ==============================================================================
7705+ CEAA              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7706+ CEAA              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7707+ CEAA              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7708+ CEAA              ; ==============================================================================
7709+ CEAA              UpdateDeathAnim:
7710+ CEAA 3A 6F 82         LD A, (DeathBorderPhase)
7711+ CEAD FE 01            CP 1
7712+ CEAF C0               RET NZ
7713+ CEB0 3A 71 82         LD A, (PlayerDeathAnimTimer)
7714+ CEB3 3D               DEC A
7715+ CEB4 32 71 82         LD (PlayerDeathAnimTimer), A
7716+ CEB7 C0               RET NZ
7717+ CEB8                  ; Tick consumido: avanzar frame
7718+ CEB8 3A 72 82         LD A, (PlayerDeathAnimFrame)
7719+ CEBB 3C               INC A
7720+ CEBC FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7721+ CEBE D0               RET NC                              ; ya en ultimo frame (clamp)
7722+ CEBF 32 72 82         LD (PlayerDeathAnimFrame), A
7723+ CEC2 DD 21 36 81      LD IX, EntityTable
7724+ CEC6 DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7725+ CEC9                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7726+ CEC9                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7727+ CEC9                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7728+ CEC9 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7729+ CECB 20 06            JR NZ, .udaSkipSplatSfx
7730+ CECD 21 B2 F8         LD HL, SFX_EnemyDeath
7731+ CED0 CD 33 F8         CALL PlaySFX
7732+ CED3              .udaSkipSplatSfx:
7733+ CED3 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7734+ CED5 32 71 82         LD (PlayerDeathAnimTimer), A
7735+ CED8 C9               RET
7736+ CED9
7737+ CED9              ; ==============================================================================
7738+ CED9              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7739+ CED9              ; ==============================================================================
7740+ CED9              UpdateDeathBorder:
7741+ CED9 3A 6F 82         LD A, (DeathBorderPhase)
7742+ CEDC B7               OR A
7743+ CEDD C8               RET Z
7744+ CEDE 3A 70 82         LD A, (DeathBorderTimer)
7745+ CEE1 3D               DEC A
7746+ CEE2 32 70 82         LD (DeathBorderTimer), A
7747+ CEE5 C0               RET NZ
7748+ CEE6                  ; Timer expiro: avanzar fase
7749+ CEE6 3A 6F 82         LD A, (DeathBorderPhase)
7750+ CEE9 FE 01            CP 1
7751+ CEEB 20 33            JR NZ, .udbToBlack
7752+ CEED                  ; --- Fin fase amarillo ---
7753+ CEED                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7754+ CEED                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7755+ CEED 3A 66 82         LD A, (PlayerLives)
7756+ CEF0 B7               OR A
7757+ CEF1 28 1F            JR Z, .udbToGameOver
7758+ CEF3 DD 21 36 81      LD IX, EntityTable
7759+ CEF7 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7760+ CEFB 3E 02            LD A, 2
7761+ CEFD 32 6F 82         LD (DeathBorderPhase), A
7762+ CF00 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7763+ CF02 32 70 82         LD (DeathBorderTimer), A
7764+ CF05 3E 02            LD A, RED
7765+ CF07 32 CA 90         LD (CurrentBorderColor), A
7766+ CF0A D3 FE            OUT (254), A
7767+ CF0C                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7768+ CF0C                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7769+ CF0C 3E 01            LD A, 1
7770+ CF0E 32 7C 82         LD (TombDrawPending), A
7771+ CF11 C9               RET
7772+ CF12              .udbToGameOver:
7773+ CF12                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7774+ CF12 AF               XOR A
7775+ CF13 32 6F 82         LD (DeathBorderPhase), A
7776+ CF16 3E 00            LD A, BLACK
7777+ CF18 32 CA 90         LD (CurrentBorderColor), A
7778+ CF1B D3 FE            OUT (254), A
7779+ CF1D C3 2E CF         JP ShowGameOver
7780+ CF20              .udbToBlack:
7781+ CF20                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7782+ CF20 AF               XOR A
7783+ CF21 32 6F 82         LD (DeathBorderPhase), A
7784+ CF24 3E 00            LD A, BLACK
7785+ CF26 32 CA 90         LD (CurrentBorderColor), A
7786+ CF29 D3 FE            OUT (254), A
7787+ CF2B C3 CB CD         JP RespawnPlayerAtEntry             ; tail-call
7788+ CF2E
7789+ CF2E              ; ==============================================================================
7790+ CF2E              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7791+ CF2E              ; ==============================================================================
7792+ CF2E              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7793+ CF2E              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7794+ CF2E              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7795+ CF2E              ; ==============================================================================
7796+ CF2E              ShowGameOver:
7797+ CF2E 3E 01            LD A, 1
7798+ CF30 32 67 82         LD (GameOver), A
7799+ CF33 C9               RET
7800+ CF34
7801+ CF34              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7802+ CF34              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7803+ CF34              PaintGameOverScreen:
7804+ CF34                  ; Wipe pixels
7805+ CF34 21 00 40         LD HL, $4000
7806+ CF37 11 01 40         LD DE, $4001
7807+ CF3A 01 FF 17         LD BC, $17FF
7808+ CF3D 36 00            LD (HL), 0
7809+ CF3F ED B0            LDIR
7810+ CF41                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7811+ CF41 21 00 58         LD HL, $5800
7812+ CF44 11 01 58         LD DE, $5801
7813+ CF47 01 FF 02         LD BC, $02FF
7814+ CF4A 36 47            LD (HL), $47
7815+ CF4C ED B0            LDIR
7816+ CF4E                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7817+ CF4E 3E E0            LD A, GAMEOVER_ANIM_X_MAX
7818+ CF50 32 68 82         LD (GameOverAnimX), A
7819+ CF53 AF               XOR A
7820+ CF54 32 69 82         LD (GameOverAnimDir), A
7821+ CF57 32 6A 82         LD (GameOverAnimFrame), A
7822+ CF5A 32 6E 82         LD (GameOverAnimLastX), A
7823+ CF5D 21 00 00         LD HL, 0
7824+ CF60 22 6C 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7825+ CF63 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7826+ CF65 32 6B 82         LD (GameOverAnimFrameTimer), A
7827+ CF68                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7828+ CF68                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7829+ CF68                  ; congelado en GameOver=2.
7830+ CF68 3E 03            LD A, 3
7831+ CF6A C3 A2 9D         JP StartMusic                   ; tail-call
7832+ CF6D
7833+ CF6D              ; ==============================================================================
7834+ CF6D              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7835+ CF6D              ; ==============================================================================
7836+ CF6D              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7837+ CF6D              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7838+ CF6D              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7839+ CF6D              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7840+ CF6D              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7841+ CF6D              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7842+ CF6D              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7843+ CF6D              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7844+ CF6D              ;
7845+ CF6D              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7846+ CF6D              ; shifted (que ocupa 4 chars = 32 px).
7847+ CF6D              ; ==============================================================================
7848+ CF6D              GAMEOVER_ANIM_Y           EQU 80
7849+ CF6D              GAMEOVER_ANIM_X_MIN       EQU 0
7850+ CF6D              GAMEOVER_ANIM_X_MAX       EQU 224
7851+ CF6D              GAMEOVER_ANIM_FRAME_TICKS EQU 6
7852+ CF6D
7853+ CF6D              UpdateGameOverAnim:
7854+ CF6D                  ; --- Erase del sprite previo (si lo hubo) ---
7855+ CF6D 2A 6C 82         LD HL, (GameOverAnimLastSpr)
7856+ CF70 7C               LD A, H
7857+ CF71 B5               OR L
7858+ CF72 28 0C            JR Z, .ugoaNoErase
7859+ CF74 E5               PUSH HL
7860+ CF75 DD E1            POP IX
7861+ CF77 3A 6E 82         LD A, (GameOverAnimLastX)
7862+ CF7A 5F               LD E, A
7863+ CF7B 16 50            LD D, GAMEOVER_ANIM_Y
7864+ CF7D CD CE 9D         CALL DrawSprite
7865+ CF80              .ugoaNoErase:
7866+ CF80
7867+ CF80                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
7868+ CF80 3A 6B 82         LD A, (GameOverAnimFrameTimer)
7869+ CF83 3D               DEC A
7870+ CF84 20 0A            JR NZ, .ugoaTimerSet
7871+ CF86 3A 6A 82         LD A, (GameOverAnimFrame)
7872+ CF89 EE 01            XOR 1
7873+ CF8B 32 6A 82         LD (GameOverAnimFrame), A
7874+ CF8E 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7875+ CF90              .ugoaTimerSet:
7876+ CF90 32 6B 82         LD (GameOverAnimFrameTimer), A
7877+ CF93
7878+ CF93                  ; --- Avanzar X segun direccion (ping-pong) ---
7879+ CF93 3A 69 82         LD A, (GameOverAnimDir)
7880+ CF96 B7               OR A
7881+ CF97 20 13            JR NZ, .ugoaSlideRight
7882+ CF99                  ; Dir 0: facing R, slide LEFT (X--)
7883+ CF99 3A 68 82         LD A, (GameOverAnimX)
7884+ CF9C B7               OR A
7885+ CF9D 28 06            JR Z, .ugoaFlipToL
7886+ CF9F 3D               DEC A
7887+ CFA0 32 68 82         LD (GameOverAnimX), A
7888+ CFA3 18 18            JR .ugoaPickSprite
7889+ CFA5              .ugoaFlipToL:
7890+ CFA5 3E 01            LD A, 1
7891+ CFA7 32 69 82         LD (GameOverAnimDir), A
7892+ CFAA 18 11            JR .ugoaPickSprite
7893+ CFAC              .ugoaSlideRight:
7894+ CFAC                  ; Dir 1: facing L, slide RIGHT (X++)
7895+ CFAC 3A 68 82         LD A, (GameOverAnimX)
7896+ CFAF FE E0            CP GAMEOVER_ANIM_X_MAX
7897+ CFB1 28 06            JR Z, .ugoaFlipToR
7898+ CFB3 3C               INC A
7899+ CFB4 32 68 82         LD (GameOverAnimX), A
7900+ CFB7 18 04            JR .ugoaPickSprite
7901+ CFB9              .ugoaFlipToR:
7902+ CFB9 AF               XOR A
7903+ CFBA 32 69 82         LD (GameOverAnimDir), A
7904+ CFBD
7905+ CFBD              .ugoaPickSprite:
7906+ CFBD                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
7907+ CFBD                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
7908+ CFBD                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
7909+ CFBD 3A 69 82         LD A, (GameOverAnimDir)
7910+ CFC0 B7               OR A
7911+ CFC1 20 0E            JR NZ, .ugoaPickR
7912+ CFC3 3A 6A 82         LD A, (GameOverAnimFrame)
7913+ CFC6 B7               OR A
7914+ CFC7 21 FB DD         LD HL, SprDeath_L0
7915+ CFCA 28 11            JR Z, .ugoaSprSet
7916+ CFCC 21 45 DE         LD HL, SprDeath_L1
7917+ CFCF 18 0C            JR .ugoaSprSet
7918+ CFD1              .ugoaPickR:
7919+ CFD1 3A 6A 82         LD A, (GameOverAnimFrame)
7920+ CFD4 B7               OR A
7921+ CFD5 21 67 DD         LD HL, SprDeath_0
7922+ CFD8 28 03            JR Z, .ugoaSprSet
7923+ CFDA 21 B1 DD         LD HL, SprDeath_1
7924+ CFDD              .ugoaSprSet:
7925+ CFDD 22 6C 82         LD (GameOverAnimLastSpr), HL
7926+ CFE0 3A 68 82         LD A, (GameOverAnimX)
7927+ CFE3 32 6E 82         LD (GameOverAnimLastX), A
7928+ CFE6
7929+ CFE6                  ; --- Draw nuevo sprite ---
7930+ CFE6 E5               PUSH HL
7931+ CFE7 DD E1            POP IX
7932+ CFE9 5F               LD E, A
7933+ CFEA 16 50            LD D, GAMEOVER_ANIM_Y
7934+ CFEC C3 CE 9D         JP DrawSprite                   ; tail-call
7935+ CFEF
