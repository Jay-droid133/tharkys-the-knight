 968+ B34C 7C               LD A, H
 969+ B34D B5               OR L
 970+ B34E C8               RET Z                       ; 0 pixeles restantes → IX en posicion correcta
 971+ B34F DD 7E 00         LD A, (IX+0)
 972+ B352 DD 23            INC IX
 973+ B354 CB 7F            BIT 7, A
 974+ B356 20 0C            JR NZ, .spRleRun
 975+ B358                  ; Literal group: consume A bytes de datos (A = count 1-127)
 976+ B358 5F               LD E, A
 977+ B359 16 00            LD D, 0
 978+ B35B ED 52            SBC HL, DE                  ; HL -= count
