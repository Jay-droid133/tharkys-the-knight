 642+ 6994 3E 03            LD A, CHURCH_KEY_ALT1_CHAR_Y
 643+ 6996 18 08            JR .rcaPatch
 644+ 6998              .rcaAlt2:
 645+ 6998 06 0F            LD B, CHURCH_KEY_ALT2_SCREEN_X
 646+ 699A 0E 06            LD C, CHURCH_KEY_ALT2_SCREEN_Y
 647+ 699C 16 04            LD D, CHURCH_KEY_ALT2_CHAR_X
 648+ 699E 3E 03            LD A, CHURCH_KEY_ALT2_CHAR_Y
 649+ 69A0              .rcaPatch:
 650+ 69A0 32 BC 69         LD (.rcaCharY), A
 651+ 69A3 C5               PUSH BC                                 ; preservar B=mapX, C=mapY
 652+ 69A4 D5               PUSH DE                                 ; preservar D=charX
 653+ 69A5 11 AA DB         LD DE, BgGfx_church_key
 654+ 69A8 CD BD 69         CALL FindPickupEntryByPtr               ; HL = mapX byte
 655+ 69AB D1               POP DE
 656+ 69AC C1               POP BC
 657+ 69AD 20 0C            JR NZ, .rcaSkip
 658+ 69AF 70               LD (HL), B                              ; mapX = AltN_SCREEN_X
 659+ 69B0 23               INC HL
 660+ 69B1 71               LD (HL), C                              ; mapY = AltN_SCREEN_Y
 661+ 69B2 23               INC HL
 661+ 69B3 23             INC HL
 661+ 69B4 23             INC HL                ; skip ptr_lo, ptr_hi
 662+ 69B5 72               LD (HL), D                              ; charX = AltN_CHAR_X
 663+ 69B6 23               INC HL
 664+ 69B7 3A BC 69         LD A, (.rcaCharY)
 665+ 69BA 77               LD (HL), A                              ; charY = AltN_CHAR_Y
 666+ 69BB              .rcaSkip:
 667+ 69BB C9               RET
 668+ 69BC 00           .rcaCharY: DEFB 0
 669+ 69BD
 670+ 69BD              ; ==============================================================================
 671+ 69BD              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
 672+ 69BD              ; ==============================================================================
 673+ 69BD              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
 674+ 69BD              ; comparando ptr_lo/ptr_hi con DE.
 675+ 69BD              ; IN:  DE = ptr buscado.
 676+ 69BD              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
 677+ 69BD              ; Destruye: AF.
 678+ 69BD              ; ==============================================================================
 679+ 69BD              FindPickupEntryByPtr:
 680+ 69BD 21 F5 D9         LD HL, PickupTable
 681+ 69C0              .fpeLoop:
 682+ 69C0 7E               LD A, (HL)
 683+ 69C1 FE FF            CP $FF
 684+ 69C3 28 18            JR Z, .fpeNotFound
 685+ 69C5 E5               PUSH HL
 686+ 69C6 23               INC HL
 686+ 69C7 23             INC HL                         ; -> ptr_lo
 687+ 69C8 7E               LD A, (HL)
 688+ 69C9 BB               CP E
 689+ 69CA 20 08            JR NZ, .fpeNoMatch
 690+ 69CC 23               INC HL
 691+ 69CD 7E               LD A, (HL)
 692+ 69CE BA               CP D
 693+ 69CF 20 03            JR NZ, .fpeNoMatch
 694+ 69D1 E1               POP HL
 695+ 69D2 AF               XOR A                                   ; Z = encontrado
 696+ 69D3 C9               RET
 697+ 69D4              .fpeNoMatch:
 698+ 69D4 E1               POP HL
 699+ 69D5 C5               PUSH BC
 700+ 69D6 01 07 00         LD BC, 7
 701+ 69D9 09               ADD HL, BC
 702+ 69DA C1               POP BC
 703+ 69DB 18 E3            JR .fpeLoop
 704+ 69DD              .fpeNotFound:
 705+ 69DD F6 01            OR 1                                    ; NZ
 706+ 69DF C9               RET
 707+ 69E0
