4891+ BD4F              ; ==============================================================================
4892+ BD4F              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4893+ BD4F              ; ==============================================================================
4894+ BD4F              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4895+ BD4F              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4896+ BD4F              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4897+ BD4F              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4898+ BD4F              ; deja la posicion original (puff puede asomar levemente, raro).
4899+ BD4F              ; IN:  IX = nasty entity.
4900+ BD4F              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4901+ BD4F              ; Destruye: AF, BC, DE, HL.
4902+ BD4F              ; ==============================================================================
4903+ BD4F              SnapPuffPos:
4904+ BD4F DD 7E 03         LD A, (IX+ENT_POSX)
4905+ BD52 32 C5 BD         LD (.sppOrigX), A
4906+ BD55 E6 F8            AND $F8
4907+ BD57 32 C7 BD         LD (.sppBaseX), A                   ; base char-aligned X
4908+ BD5A DD 7E 04         LD A, (IX+ENT_POSY)
4909+ BD5D 32 C6 BD         LD (.sppOrigY), A
4910+ BD60 E6 F8            AND $F8
4911+ BD62 32 C8 BD         LD (.sppBaseY), A                   ; base char-aligned Y
4912+ BD65
4913+ BD65                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4914+ BD65 CD 99 BD         CALL .sppCheckFit
4915+ BD68 C8               RET Z
4916+ BD69
4917+ BD69                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4918+ BD69                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4919+ BD69 21 C9 BD         LD HL, .sppShifts
4920+ BD6C              .sppLoop:
4921+ BD6C 7E               LD A, (HL)
4922+ BD6D 23               INC HL
4923+ BD6E 47               LD B, A                             ; dx (signed)
4924+ BD6F 7E               LD A, (HL)
4925+ BD70 23               INC HL
4926+ BD71 FE 80            CP $80
4927+ BD73 28 17            JR Z, .sppFail                      ; sentinel
4928+ BD75 4F               LD C, A                             ; dy (signed)
4929+ BD76
4930+ BD76 3A C7 BD         LD A, (.sppBaseX)
4931+ BD79 80               ADD A, B
4932+ BD7A DD 77 03         LD (IX+ENT_POSX), A
4933+ BD7D 3A C8 BD         LD A, (.sppBaseY)
4934+ BD80 81               ADD A, C
4935+ BD81 DD 77 04         LD (IX+ENT_POSY), A
4936+ BD84
4937+ BD84 E5               PUSH HL
4938+ BD85 CD 99 BD         CALL .sppCheckFit
4939+ BD88 E1               POP HL
4940+ BD89 C8               RET Z                               ; encontrado
4941+ BD8A 18 E0            JR .sppLoop
4942+ BD8C
4943+ BD8C              .sppFail:
4944+ BD8C 3A C5 BD         LD A, (.sppOrigX)
4945+ BD8F DD 77 03         LD (IX+ENT_POSX), A
4946+ BD92 3A C6 BD         LD A, (.sppOrigY)
4947+ BD95 DD 77 04         LD (IX+ENT_POSY), A
4948+ BD98 C9               RET
4949+ BD99
4950+ BD99              ; --- .sppCheckFit ---
4951+ BD99              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
4952+ BD99              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
4953+ BD99              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
4954+ BD99              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
4955+ BD99              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
4956+ BD99              .sppCheckFit:
4957+ BD99                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
4958+ BD99 DD 7E 03         LD A, (IX+ENT_POSX)
4959+ BD9C FE D1            CP SCREEN_MAX_X - 23
4960+ BD9E 30 21            JR NC, .sppOutOfBounds
4961+ BDA0 DD 7E 04         LD A, (IX+ENT_POSY)
4962+ BDA3 FE 10            CP SCREEN_MIN_Y
4963+ BDA5 38 1A            JR C, .sppOutOfBounds
4964+ BDA7 FE 91            CP SCREEN_MAX_Y - 23
4965+ BDA9 30 16            JR NC, .sppOutOfBounds
4966+ BDAB                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
4967+ BDAB DD 7E 00         LD A, (IX+ENT_SPRITEID)
4968+ BDAE 32 C4 BD         LD (.sppSpritIdSave), A
4969+ BDB1 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4970+ BDB5 CD A3 B9         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
4971+ BDB8 F5               PUSH AF
4972+ BDB9 3A C4 BD         LD A, (.sppSpritIdSave)
4973+ BDBC DD 77 00         LD (IX+ENT_SPRITEID), A
4974+ BDBF F1               POP AF
4975+ BDC0 C9               RET
4976+ BDC1              .sppOutOfBounds:
4977+ BDC1 F6 01            OR 1                                ; NZ
4978+ BDC3 C9               RET
4979+ BDC4
4980+ BDC4 00           .sppSpritIdSave: DEFB 0
4981+ BDC5
4982+ BDC5 00           .sppOrigX: DEFB 0
4983+ BDC6 00           .sppOrigY: DEFB 0
4984+ BDC7 00           .sppBaseX: DEFB 0
4985+ BDC8 00           .sppBaseY: DEFB 0
4986+ BDC9              .sppShifts:
4987+ BDC9                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
4988+ BDC9                  ; Distancia creciente. Sentinel: dy=$80.
4989+ BDC9 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
4990+ BDCB 00 F8            DEFB 0,   -8                        ; arriba 8
4991+ BDCD 00 08            DEFB 0,    8                        ; abajo 8
4992+ BDCF F8 00            DEFB -8,   0                        ; izq 8
4993+ BDD1 08 00            DEFB 8,    0                        ; der 8
4994+ BDD3 00 F0            DEFB 0,  -16                        ; arriba 16
4995+ BDD5 00 10            DEFB 0,   16                        ; abajo 16
4996+ BDD7 F8 F8            DEFB -8,  -8
4997+ BDD9 08 F8            DEFB 8,   -8
4998+ BDDB F8 08            DEFB -8,   8
4999+ BDDD 08 08            DEFB 8,    8
5000+ BDDF 00 80            DEFB 0,  $80                        ; sentinel
5001+ BDE1
5002+ BDE1              ; ==============================================================================
5003+ BDE1              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5004+ BDE1              ; ==============================================================================
5005+ BDE1              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5006+ BDE1              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5007+ BDE1              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5008+ BDE1              ; DeathSpawned. No-op si la muerte no esta activa.
5009+ BDE1              ; ==============================================================================
5010+ BDE1              SilentKillDeath:
5011+ BDE1 DD 21 EF 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5012+ BDE5 DD 7E 01         LD A, (IX+ENT_TYPE)
5013+ BDE8 B7               OR A
5014+ BDE9 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5015+ BDEB CD E1 C9         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5016+ BDEE AF               XOR A
5017+ BDEF DD 77 01         LD (IX+ENT_TYPE), A
5018+ BDF2 32 8C 82         LD (DeathSpawned), A
5019+ BDF5              .skdResetTimer:
5020+ BDF5                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5021+ BDF5                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5022+ BDF5 21 00 00         LD HL, 0
5023+ BDF8 22 89 82         LD (DeathScreenTimer), HL
5024+ BDFB                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5025+ BDFB                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5026+ BDFB                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5027+ BDFB                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5028+ BDFB                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5029+ BDFB C9               RET
5030+ BDFC
5031+ BDFC              ; ==============================================================================
5032+ BDFC              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5033+ BDFC              ; ==============================================================================
5034+ BDFC              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5035+ BDFC              ; no DYING ni SPAWNING):
5036+ BDFC              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5037+ BDFC              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5038+ BDFC              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5039+ BDFC              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5040+ BDFC              ;     Si tampoco, deja el monster donde estaba.
5041+ BDFC              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5042+ BDFC              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5043+ BDFC              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5044+ BDFC              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5045+ BDFC              ; ==============================================================================
5046+ BDFC              FreezeMonstersFacingCorpse:
5047+ BDFC                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5048+ BDFC 3A 42 81         LD A, (EntityTable + ENT_POSX)
5049+ BDFF 32 83 82         LD (CorpseX), A
5050+ BE02 3A 43 81         LD A, (EntityTable + ENT_POSY)
5051+ BE05 32 84 82         LD (CorpseY), A
5052+ BE08                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5053+ BE08                  ; ya skipea; no aplica aqui pero por simetria)
5054+ BE08 3E 01            LD A, 1
5055+ BE0A 32 82 82         LD (MonstersFrozen), A
5056+ BE0D DD 21 4F 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5057+ BE11 06 06            LD B, NUM_MONSTERS
5058+ BE13              .fmcLoop:
5059+ BE13 C5               PUSH BC
5060+ BE14 DD 7E 01         LD A, (IX+ENT_TYPE)
5061+ BE17 FE 02            CP TYPE_MONSTER
5062+ BE19 20 0E            JR NZ, .fmcNext
5063+ BE1B DD 7E 02         LD A, (IX+ENT_STATE)
5064+ BE1E FE 03            CP STATE_DYING
5065+ BE20 28 07            JR Z, .fmcNext
5066+ BE22 FE 04            CP STATE_SPAWNING
5067+ BE24 28 03            JR Z, .fmcNext
5068+ BE26 CD 32 BE         CALL FreezeOneMonster
5069+ BE29              .fmcNext:
5070+ BE29 C1               POP BC
5071+ BE2A 11 10 00         LD DE, ENT_SIZE
5072+ BE2D DD 19            ADD IX, DE
5073+ BE2F 10 E2            DJNZ .fmcLoop
5074+ BE31 C9               RET
5075+ BE32
5076+ BE32              ; --- FreezeOneMonster ---
5077+ BE32              ; IX = monster slot pointer.
5078+ BE32              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5079+ BE32              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5080+ BE32              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5081+ BE32              FreezeOneMonster:
5082+ BE32                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5083+ BE32                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5084+ BE32                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5085+ BE32 DD 7E 03         LD A, (IX+ENT_POSX)
5086+ BE35 47               LD B, A
5087+ BE36 3A 83 82         LD A, (CorpseX)
5088+ BE39 B8               CP B
5089+ BE3A 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5090+ BE3C 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5091+ BE3E              .fomFaceE:
5092+ BE3E DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5093+ BE41 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5094+ BE43 DD 77 00         LD (IX+ENT_SPRITEID), A
5095+ BE46 18 08            JR .fomFaceDone
5096+ BE48              .fomFaceW:
5097+ BE48 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5098+ BE4B C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5099+ BE4D DD 77 00         LD (IX+ENT_SPRITEID), A
5100+ BE50              .fomFaceDone:
5101+ BE50
5102+ BE50                  ; --- 2) Computar |dx| y |dy| ---
5103+ BE50 3A 83 82         LD A, (CorpseX)
5104+ BE53 4F               LD C, A
5105+ BE54 DD 7E 03         LD A, (IX+ENT_POSX)
5106+ BE57 91               SUB C                           ; A = posX - corpseX (signed)
5107+ BE58 30 02            JR NC, .fomDxPos
5108+ BE5A ED 44            NEG
5109+ BE5C              .fomDxPos:
5110+ BE5C 32 AD BE         LD (.fomAdx), A
5111+ BE5F 3A 84 82         LD A, (CorpseY)
5112+ BE62 4F               LD C, A
5113+ BE63 DD 7E 04         LD A, (IX+ENT_POSY)
5114+ BE66 91               SUB C
5115+ BE67 30 02            JR NC, .fomDyPos
5116+ BE69 ED 44            NEG
5117+ BE6B              .fomDyPos:
5118+ BE6B 32 AE BE         LD (.fomAdy), A
5119+ BE6E
5120+ BE6E                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5121+ BE6E 3A AD BE         LD A, (.fomAdx)
5122+ BE71 FE 10            CP 16
5123+ BE73 D2 9C BE         JP NC, .fomFreeze
5124+ BE76 3A AE BE         LD A, (.fomAdy)
5125+ BE79 FE 10            CP 16
5126+ BE7B D2 9C BE         JP NC, .fomFreeze
5127+ BE7E
5128+ BE7E                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5129+ BE7E 3A AD BE         LD A, (.fomAdx)
5130+ BE81 47               LD B, A
5131+ BE82 3A AE BE         LD A, (.fomAdy)
5132+ BE85 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5133+ BE86 38 0C            JR C, .fomTryX
5134+ BE88 28 0A            JR Z, .fomTryX
5135+ BE8A                  ; |dy| > |dx| -> intentar Y primero
5136+ BE8A CD E2 BE         CALL TryBackoffY
5137+ BE8D 28 0D            JR Z, .fomFreeze                ; ok
5138+ BE8F CD AF BE         CALL TryBackoffX
5139+ BE92 18 08            JR .fomFreeze
5140+ BE94              .fomTryX:
5141+ BE94 CD AF BE         CALL TryBackoffX
5142+ BE97 28 03            JR Z, .fomFreeze
5143+ BE99 CD E2 BE         CALL TryBackoffY
5144+ BE9C
5145+ BE9C              .fomFreeze:
5146+ BE9C                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5147+ BE9C                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5148+ BE9C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5149+ BEA0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5150+ BEA4 DD 36 0A 00      LD (IX+ENT_DIR), 0
5151+ BEA8 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5152+ BEAC C9               RET
5153+ BEAD
5154+ BEAD 00           .fomAdx: DEFB 0
5155+ BEAE 00           .fomAdy: DEFB 0
5156+ BEAF
5157+ BEAF              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5158+ BEAF              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5159+ BEAF              TryBackoffX:
5160+ BEAF DD 7E 03         LD A, (IX+ENT_POSX)
5161+ BEB2 32 E1 BE         LD (.tbxSavePos), A
5162+ BEB5 47               LD B, A
5163+ BEB6 3A 83 82         LD A, (CorpseX)
5164+ BEB9 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5165+ BEBA DD 7E 03         LD A, (IX+ENT_POSX)
5166+ BEBD 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5167+ BEBF C6 10            ADD A, 16
5168+ BEC1 18 02            JR .tbxApply
5169+ BEC3              .tbxNeg:
5170+ BEC3 D6 10            SUB 16
5171+ BEC5              .tbxApply:
5172+ BEC5                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5173+ BEC5 DD 77 03         LD (IX+ENT_POSX), A
5174+ BEC8 FE E8            CP SCREEN_MAX_X
5175+ BECA 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5176+ BECC CD A3 B9         CALL CheckEnemyCollision
5177+ BECF 20 07            JR NZ, .tbxFail
5178+ BED1 CD 19 BF         CALL CheckMonsterOverlap
5179+ BED4 20 02            JR NZ, .tbxFail
5180+ BED6 AF               XOR A                           ; Z = ok
5181+ BED7 C9               RET
5182+ BED8              .tbxFail:
5183+ BED8 3A E1 BE         LD A, (.tbxSavePos)
5184+ BEDB DD 77 03         LD (IX+ENT_POSX), A
5185+ BEDE F6 01            OR 1                            ; NZ
5186+ BEE0 C9               RET
5187+ BEE1 00           .tbxSavePos: DEFB 0
5188+ BEE2
5189+ BEE2              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5190+ BEE2              TryBackoffY:
5191+ BEE2 DD 7E 04         LD A, (IX+ENT_POSY)
5192+ BEE5 32 18 BF         LD (.tbySavePos), A
5193+ BEE8 47               LD B, A
5194+ BEE9 3A 84 82         LD A, (CorpseY)
5195+ BEEC B8               CP B
5196+ BEED DD 7E 04         LD A, (IX+ENT_POSY)
5197+ BEF0 30 04            JR NC, .tbyNeg
5198+ BEF2 C6 10            ADD A, 16
5199+ BEF4 18 02            JR .tbyApply
5200+ BEF6              .tbyNeg:
5201+ BEF6 D6 10            SUB 16
5202+ BEF8              .tbyApply:
5203+ BEF8 DD 77 04         LD (IX+ENT_POSY), A
5204+ BEFB FE 10            CP SCREEN_MIN_Y
5205+ BEFD 38 10            JR C, .tbyFail
5206+ BEFF FE A8            CP SCREEN_MAX_Y
5207+ BF01 30 0C            JR NC, .tbyFail
5208+ BF03 CD A3 B9         CALL CheckEnemyCollision
5209+ BF06 20 07            JR NZ, .tbyFail
5210+ BF08 CD 19 BF         CALL CheckMonsterOverlap
5211+ BF0B 20 02            JR NZ, .tbyFail
5212+ BF0D AF               XOR A
5213+ BF0E C9               RET
5214+ BF0F              .tbyFail:
5215+ BF0F 3A 18 BF         LD A, (.tbySavePos)
5216+ BF12 DD 77 04         LD (IX+ENT_POSY), A
5217+ BF15 F6 01            OR 1
5218+ BF17 C9               RET
5219+ BF18 00           .tbySavePos: DEFB 0
5220+ BF19
5221+ BF19              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5222+ BF19              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5223+ BF19              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5224+ BF19              CheckMonsterOverlap:
5225+ BF19 C5               PUSH BC
5226+ BF1A FD E5            PUSH IY
5227+ BF1C FD 21 4F 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5228+ BF20 06 06            LD B, NUM_MONSTERS
5229+ BF22              .cmoLoop:
5230+ BF22                  ; Skip self (IY == IX)
5231+ BF22 DD E5            PUSH IX
5232+ BF24 E1               POP HL
5233+ BF25 FD E5            PUSH IY
5234+ BF27 D1               POP DE
5235+ BF28 B7               OR A
5236+ BF29 ED 52            SBC HL, DE
5237+ BF2B 28 3D            JR Z, .cmoNext                  ; same slot
5238+ BF2D
5239+ BF2D FD 7E 01         LD A, (IY+ENT_TYPE)
5240+ BF30 FE 02            CP TYPE_MONSTER
5241+ BF32 20 36            JR NZ, .cmoNext
5242+ BF34
5243+ BF34                  ; AABB overlap (rect 16x21 cada uno):
5244+ BF34                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5245+ BF34                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5246+ BF34 DD 7E 03         LD A, (IX+ENT_POSX)
5247+ BF37 C6 10            ADD A, 16
5248+ BF39 4F               LD C, A
5249+ BF3A FD 7E 03         LD A, (IY+ENT_POSX)
5250+ BF3D B9               CP C                            ; iy.x cmp ix.x+16
5251+ BF3E 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5252+ BF40 FD 7E 03         LD A, (IY+ENT_POSX)
5253+ BF43 C6 10            ADD A, 16
5254+ BF45 4F               LD C, A
5255+ BF46 DD 7E 03         LD A, (IX+ENT_POSX)
5256+ BF49 B9               CP C
5257+ BF4A 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5258+ BF4C DD 7E 04         LD A, (IX+ENT_POSY)
5259+ BF4F C6 15            ADD A, 21
5260+ BF51 4F               LD C, A
5261+ BF52 FD 7E 04         LD A, (IY+ENT_POSY)
5262+ BF55 B9               CP C
5263+ BF56 30 12            JR NC, .cmoNext
5264+ BF58 FD 7E 04         LD A, (IY+ENT_POSY)
5265+ BF5B C6 15            ADD A, 21
5266+ BF5D 4F               LD C, A
5267+ BF5E DD 7E 04         LD A, (IX+ENT_POSY)
5268+ BF61 B9               CP C
5269+ BF62 30 06            JR NC, .cmoNext
5270+ BF64                  ; Overlap en ambos ejes
5271+ BF64 FD E1            POP IY
5272+ BF66 C1               POP BC
5273+ BF67 F6 01            OR 1                            ; NZ
5274+ BF69 C9               RET
5275+ BF6A              .cmoNext:
5276+ BF6A 11 10 00         LD DE, ENT_SIZE
5277+ BF6D FD 19            ADD IY, DE
5278+ BF6F 10 B1            DJNZ .cmoLoop
5279+ BF71 FD E1            POP IY
5280+ BF73 C1               POP BC
5281+ BF74 AF               XOR A                           ; Z = no overlap
5282+ BF75 C9               RET
5283+ BF76
5284+ BF76              ; ==============================================================================
5285+ BF76              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5286+ BF76              ; ==============================================================================
5287+ BF76              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5288+ BF76              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5289+ BF76              ; ==============================================================================
5290+ BF76              KillAllActiveMonsters:
5291+ BF76 AF               XOR A
5292+ BF77 32 3E B6         LD (MonstersActive), A              ; No respawnear mas
5293+ BF7A DD 21 4F 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5294+ BF7E 06 06            LD B, NUM_MONSTERS
5295+ BF80              .kamLoop:
5296+ BF80 C5               PUSH BC
5297+ BF81 DD 7E 01         LD A, (IX+ENT_TYPE)
5298+ BF84 B7               OR A
5299+ BF85 28 27            JR Z, .kamSkip                      ; slot vacio
5300+ BF87 FE 02            CP TYPE_MONSTER
5301+ BF89 20 23            JR NZ, .kamSkip                     ; no es monster
5302+ BF8B DD 7E 02         LD A, (IX+ENT_STATE)
5303+ BF8E FE 03            CP STATE_DYING
5304+ BF90 28 1C            JR Z, .kamSkip
5305+ BF92 FE 04            CP STATE_SPAWNING
5306+ BF94 28 18            JR Z, .kamSkip
5307+ BF96 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
