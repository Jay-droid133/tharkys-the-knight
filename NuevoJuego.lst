 787+ C4B4              ; ==============================================================================
 788+ C4B4              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 789+ C4B4              ; ==============================================================================
 790+ C4B4              ; Entrada: A = attr byte
 791+ C4B4              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 792+ C4B4              ; Preserva: HL, DE, BC, IX
 793+ C4B4              ; ==============================================================================
 794+ C4B4              ApplyTintSwap:
 795+ C4B4 C5               PUSH BC
 796+ C4B5 47               LD B, A                     ; B = attr original
 797+ C4B6 3A B0 C4         LD A, (CurrentTintVar)
 798+ C4B9 FE FF            CP $FF
 799+ C4BB 28 24            JR Z, .tintNoChange
 800+ C4BD 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 801+ C4BE 3A B1 C4         LD A, (CurrentTintPaper)
 802+ C4C1 FE FF            CP $FF
 803+ C4C3 28 1C            JR Z, .tintNoChange
 804+ C4C5                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 805+ C4C5                  ; Extraer paper del attr: bits 5-3
 806+ C4C5 78               LD A, B
 807+ C4C6 E6 38            AND $38                     ; A = 00PPP000
 808+ C4C8 0F               RRCA
 809+ C4C9 0F               RRCA
 810+ C4CA 0F               RRCA                        ; A = 00000PPP = paper actual
 811+ C4CB D5               PUSH DE
 812+ C4CC 57               LD D, A                     ; D = paper actual
 813+ C4CD 3A B1 C4         LD A, (CurrentTintPaper)
 814+ C4D0 BA               CP D                        ; paper actual == tintPaper?
 815+ C4D1 D1               POP DE
 816+ C4D2 20 0D            JR NZ, .tintNoChange
 817+ C4D4                  ; Match: reemplazar paper bits con tintVar
 818+ C4D4 78               LD A, B
 819+ C4D5 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 820+ C4D7 D5               PUSH DE
 821+ C4D8 57               LD D, A
 822+ C4D9 79               LD A, C                     ; A = tintVar (0-7)
 823+ C4DA 07               RLCA
 824+ C4DB 07               RLCA
 825+ C4DC 07               RLCA                        ; A = 00PPP000
 826+ C4DD B2               OR D                        ; A = FBPPPIII
 827+ C4DE D1               POP DE
 828+ C4DF C1               POP BC
 829+ C4E0 C9               RET
 830+ C4E1              .tintNoChange:
 831+ C4E1 78               LD A, B                     ; devolver sin cambio
 832+ C4E2 C1               POP BC
