 378+ EBC6              ; ==============================================================================
 379+ EBC6              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EBC6              ; ==============================================================================
 381+ EBC6              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EBC6              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EBC6              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EBC6              ; ==============================================================================
 385+ EBC6              DrawHealthStaminaHUD:
 386+ EBC6                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EBC6 3A 0F B3         LD A, (PlayerHealth)
 388+ EBC9 4F               LD C, A                             ; C = nivel (0-16)
 389+ EBCA 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EBCD 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EBD0 DD 21 AC E7      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EBD4 FD 21 1D E8      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EBD8 CD 3E EC         CALL .drawBar
 394+ EBDB
 395+ EBDB                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EBDB 3A 10 B3         LD A, (PlayerStamina)
 397+ EBDE 4F               LD C, A
 398+ EBDF 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EBE2 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EBE5 DD 21 B0 E7      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EBE9 FD 21 21 E8      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EBED CD 3E EC         CALL .drawBar
 403+ EBF0
 404+ EBF0                  ; --- Flash de recuperacion del pozo ---
 405+ EBF0 3A 5D 8D         LD A, (WellFlashTimer)
 406+ EBF3 B7               OR A
 407+ EBF4 28 23            JR Z, .noFlash
 408+ EBF6 3D               DEC A
 409+ EBF7 32 5D 8D         LD (WellFlashTimer), A
 410+ EBFA                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EBFA E6 04            AND $04
 412+ EBFC 28 1B            JR Z, .noFlash
 413+ EBFE                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ EBFE                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ EBFE 3E 47            LD A, WHITE | $40
 416+ EC00 32 0D 58         LD ($580D), A
 417+ EC03 32 0E 58         LD ($580E), A
 418+ EC06 32 2D 58         LD ($582D), A
 419+ EC09 32 2E 58         LD ($582E), A
 420+ EC0C 32 11 58         LD ($5811), A
 421+ EC0F 32 12 58         LD ($5812), A
 422+ EC12 32 31 58         LD ($5831), A
 423+ EC15 32 32 58         LD ($5832), A
 424+ EC18 C9               RET
 425+ EC19              .noFlash:
 426+ EC19                  ; --- Attrs segun nivel (normal) ---
 427+ EC19                  ; Salud
 428+ EC19 3A 0F B3         LD A, (PlayerHealth)
 429+ EC1C CD 8C EC         CALL .levelToColor
 430+ EC1F 32 0D 58         LD ($580D), A
 431+ EC22 32 0E 58         LD ($580E), A
 432+ EC25 32 2D 58         LD ($582D), A
 433+ EC28 32 2E 58         LD ($582E), A
 434+ EC2B                  ; Stamina
 435+ EC2B 3A 10 B3         LD A, (PlayerStamina)
 436+ EC2E CD 8C EC         CALL .levelToColor
 437+ EC31 32 11 58         LD ($5811), A
 438+ EC34 32 12 58         LD ($5812), A
 439+ EC37 32 31 58         LD ($5831), A
 440+ EC3A 32 32 58         LD ($5832), A
 441+ EC3D C9               RET
 442+ EC3E
 443+ EC3E              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EC3E              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EC3E              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EC3E              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EC3E              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EC3E              .drawBar:
 449+ EC3E 7D               LD A, L
 450+ EC3F 32 8A EC         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EC42 7B               LD A, E
 452+ EC43 32 8B EC         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EC46 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EC48 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EC4A                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EC4A 3E 10            LD A, 16
 457+ EC4C 91               SUB C
 458+ EC4D 5F               LD E, A                             ; E = primera scanline llena
 459+ EC4E              .dbLoop:
 460+ EC4E                  ; Calcular direccion VRAM
 461+ EC4E 7A               LD A, D
 462+ EC4F FE 08            CP 8
 463+ EC51 30 09            JR NC, .dbCalcR1
 464+ EC53                  ; Char row 0
 465+ EC53 67               LD H, A
 466+ EC54 CB F4            SET 6, H
 467+ EC56 3A 8A EC         LD A, (.dbCol)
 468+ EC59 6F               LD L, A
 469+ EC5A 18 09            JR .dbWrite
 470+ EC5C              .dbCalcR1:
 471+ EC5C                  ; Char row 1
 472+ EC5C D6 08            SUB 8
 473+ EC5E 67               LD H, A
 474+ EC5F CB F4            SET 6, H
 475+ EC61 3A 8B EC         LD A, (.dbCol1)
 476+ EC64 6F               LD L, A
 477+ EC65              .dbWrite:
 478+ EC65                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EC65 7A               LD A, D
 480+ EC66 BB               CP E
 481+ EC67 30 0B            JR NC, .dbFull
 482+ EC69                  ; Marchito: copiar sprite decayed
 483+ EC69 FD 7E 00         LD A, (IY+0)
 484+ EC6C 77               LD (HL), A
 485+ EC6D 23               INC HL
 486+ EC6E FD 7E 01         LD A, (IY+1)
 487+ EC71 77               LD (HL), A
 488+ EC72 18 09            JR .dbAdvanceSpr
 489+ EC74              .dbFull:
 490+ EC74                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EC74 DD 7E 00         LD A, (IX+0)
 492+ EC77 77               LD (HL), A
 493+ EC78 23               INC HL
 494+ EC79 DD 7E 01         LD A, (IX+1)
 495+ EC7C 77               LD (HL), A
 496+ EC7D              .dbAdvanceSpr:
 497+ EC7D                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EC7D D5               PUSH DE
 499+ EC7E 11 06 00         LD DE, 6
 500+ EC81 DD 19            ADD IX, DE
 501+ EC83 FD 19            ADD IY, DE
 502+ EC85 D1               POP DE
 503+ EC86 14               INC D
 504+ EC87 10 C5            DJNZ .dbLoop
 505+ EC89 C9               RET
 506+ EC8A
 507+ EC8A 00           .dbCol:  DEFB 0
 508+ EC8B 00           .dbCol1: DEFB 0
 509+ EC8C
 510+ EC8C              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EC8C              .levelToColor:
 512+ EC8C FE 0C            CP 12
 513+ EC8E 30 11            JR NC, .lcGreen
 514+ EC90 FE 07            CP 7
 515+ EC92 30 0A            JR NC, .lcCyan
 516+ EC94 FE 03            CP 3
 517+ EC96 30 03            JR NC, .lcYellow
 518+ EC98 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EC9A C9               RET
 520+ EC9B              .lcYellow:
 521+ EC9B 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EC9D C9               RET
 523+ EC9E              .lcCyan:
 524+ EC9E 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ ECA0 C9               RET
 526+ ECA1              .lcGreen:
 527+ ECA1 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ ECA3 C9               RET
 529+ ECA4
 530+ ECA4              ; ==============================================================================
 531+ ECA4              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ ECA4              ; ==============================================================================
 533+ ECA4              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ ECA4              ; ==============================================================================
 535+ ECA4              DrawHandLine:
 536+ ECA4 87               ADD A, A
 537+ ECA5 4F               LD C, A
 538+ ECA6 06 00            LD B, 0
 539+ ECA8 09               ADD HL, BC
 540+ ECA9 7E               LD A, (HL)
 541+ ECAA 23               INC HL
 542+ ECAB 66               LD H, (HL)
 543+ ECAC 6F               LD L, A             ; HL = puntero a datos de línea
 544+ ECAD
 545+ ECAD              .pixLoop:
 546+ ECAD 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ ECAE B7               OR A
 548+ ECAF C8               RET Z
 549+ ECB0 57               LD D, A
 550+ ECB1 23               INC HL
 551+ ECB2 7E               LD A, (HL)          ; VRAM L
 552+ ECB3 23               INC HL
 553+ ECB4 5F               LD E, A
 554+ ECB5 7E               LD A, (HL)          ; mask
 555+ ECB6 23               INC HL
 556+ ECB7 E5               PUSH HL
 557+ ECB8 2F               CPL                 ; ~mask
 558+ ECB9 62               LD H, D
 559+ ECBA 6B               LD L, E
 560+ ECBB A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ ECBC 77               LD (HL), A
 562+ ECBD E1               POP HL
 563+ ECBE 18 ED            JR .pixLoop
 564+ ECC0
 565+ ECC0              ; ==============================================================================
 566+ ECC0              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ ECC0              ; ==============================================================================
 568+ ECC0              CheckClockSpeedKeys:
 569+ ECC0 3E F7            LD A, $F7
 570+ ECC2 DB FE            IN A, ($FE)
 571+ ECC4 2F               CPL
 572+ ECC5 E6 07            AND $07
 573+ ECC7
 574+ ECC7 47               LD B, A
