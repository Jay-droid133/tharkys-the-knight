2658+ AD55 CB 7F            BIT 7, A
2659+ AD57 28 02            JR Z, .eAnimDir
2660+ AD59 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2661+ AD5B              .eAnimDir:
2662+ AD5B DD 35 09         DEC (IX+ENT_ANIMTIMER)
2663+ AD5E 20 27            JR NZ, .eAnimDone
2664+ AD60 3A 56 8D         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2665+ AD63 47               LD B, A
2666+ AD64 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2667+ AD67 FE 34            CP SPRID_ENEMY_5
2668+ AD69 78               LD A, B
2669+ AD6A 20 06            JR NZ, .eAnimDelaySet
2670+ AD6C CB 3F            SRL A                               ; Rata: mitad del delay
2671+ AD6E B7               OR A
2672+ AD6F 20 01            JR NZ, .eAnimDelaySet
2673+ AD71 3C               INC A                               ; Minimo 1
2674+ AD72              .eAnimDelaySet:
2675+ AD72 DD 77 09         LD (IX+ENT_ANIMTIMER), A
