 245+ E65D              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 246+ E65D              DrawSwordModeHUD:
 247+ E65D 3A 67 B6         LD A, (SwordMode)
 248+ E660 21 90 E6         LD HL, .modeChars
 249+ E663 5F               LD E, A
 250+ E664 16 00            LD D, 0
 251+ E666 19               ADD HL, DE
 252+ E667 7E               LD A, (HL)                          ; A = ASCII del modo
 253+ E668                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 254+ E668 21 00 40         LD HL, $4000
 255+ E66B                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 256+ E66B 5F               LD E, A
 257+ E66C 16 00            LD D, 0
 258+ E66E 42               LD B, D                             ; B = 0
 259+ E66F CB 23            SLA E
 259+ E671 CB 12          RL D                        ; *2
 260+ E673 CB 23            SLA E
 260+ E675 CB 12          RL D                        ; *4
 261+ E677 CB 23            SLA E
 261+ E679 CB 12          RL D                        ; *8
 262+ E67B E5               PUSH HL
 263+ E67C 21 00 3C         LD HL, $3C00
 264+ E67F 19               ADD HL, DE                          ; HL = direccion del glyph
 265+ E680 EB               EX DE, HL                           ; DE = glyph
 266+ E681 E1               POP HL                              ; HL = VRAM
 267+ E682 06 08            LD B, 8
 268+ E684              .drawChar:
 269+ E684 1A               LD A, (DE)
