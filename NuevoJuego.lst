   1+ A0F2              ; ==============================================================================
   2+ A0F2              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A0F2              ; ==============================================================================
   4+ A0F2              ; - Estructura de entidad de 12 bytes (universal)
   5+ A0F2              ; - Game loop per-entity: erase → update → draw
   6+ A0F2              ; - Movimiento 8-bit (sin subpixel)
   7+ A0F2              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A0F2              ; - XOR draw/erase (una sola rutina)
   9+ A0F2              ; ==============================================================================
  10+ A0F2
  11+ A0F2              ; ==============================================================================
  12+ A0F2              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A0F2              ; ==============================================================================
  14+ A0F2              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A0F2              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A0F2              ; ==============================================================================
  17+ A0F2              ReadInput:
  18+ A0F2 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A0F4 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A0F6
  21+ A0F6                  ; -- 1. QAOP --
  22+ A0F6 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A0F9 ED 78            IN A, (C)
  24+ A0FB CB 47            BIT 0, A            ; Q = Arriba
  25+ A0FD 20 02            JR NZ, .no_q
  26+ A0FF CB C2            SET 0, D
  27+ A101              .no_q:
  28+ A101 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A104 ED 78            IN A, (C)
  30+ A106 CB 47            BIT 0, A            ; A = Abajo
  31+ A108 20 02            JR NZ, .no_a
  32+ A10A CB CA            SET 1, D
  33+ A10C              .no_a:
  34+ A10C 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A10F ED 78            IN A, (C)
  36+ A111 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A113 20 02            JR NZ, .no_o
  38+ A115 CB DA            SET 3, D
  39+ A117              .no_o:
  40+ A117 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A119 20 02            JR NZ, .no_p
  42+ A11B CB D2            SET 2, D
  43+ A11D              .no_p:
  44+ A11D
  45+ A11D                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A11D                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A11D DB 1F            IN A, (31)
  48+ A11F 4F               LD C, A             ; guardar para fire
  49+ A120 CB 5F            BIT 3, A            ; Up
  50+ A122 28 02            JR Z, .no_k_up
  51+ A124 CB C2            SET 0, D
  52+ A126              .no_k_up:
  53+ A126 CB 57            BIT 2, A            ; Down
  54+ A128 28 02            JR Z, .no_k_down
  55+ A12A CB CA            SET 1, D
  56+ A12C              .no_k_down:
  57+ A12C CB 4F            BIT 1, A            ; Left
  58+ A12E 28 02            JR Z, .no_k_left
  59+ A130 CB DA            SET 3, D
  60+ A132              .no_k_left:
  61+ A132 CB 47            BIT 0, A            ; Right
  62+ A134 28 02            JR Z, .no_k_right
  63+ A136 CB D2            SET 2, D
  64+ A138              .no_k_right:
  65+ A138 CB 61            BIT 4, C            ; Kempston Fire
  66+ A13A 28 02            JR Z, .no_k_fire
  67+ A13C CB C3            SET 0, E
  68+ A13E              .no_k_fire:
  69+ A13E
  70+ A13E                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A13E                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A13E 01 FE F7         LD BC, $F7FE
  73+ A141 ED 78            IN A, (C)
  74+ A143 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A145 20 02            JR NZ, .no_s1_up
  76+ A147 CB C2            SET 0, D
  77+ A149              .no_s1_up:
  78+ A149 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A14B 20 02            JR NZ, .no_s1_down
  80+ A14D CB CA            SET 1, D
  81+ A14F              .no_s1_down:
  82+ A14F CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A151 20 02            JR NZ, .no_s1_left
  84+ A153 CB DA            SET 3, D
  85+ A155              .no_s1_left:
  86+ A155 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A157 20 02            JR NZ, .no_s1_right
  88+ A159 CB D2            SET 2, D
  89+ A15B              .no_s1_right:
  90+ A15B CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A15D 20 02            JR NZ, .no_s1_fire
  92+ A15F CB C3            SET 0, E
  93+ A161              .no_s1_fire:
  94+ A161
  95+ A161                  ; -- 4. SPACE = Fire (teclado) --
  96+ A161 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A164 ED 78            IN A, (C)
  98+ A166 CB 47            BIT 0, A            ; SPACE
  99+ A168 20 02            JR NZ, .no_space
 100+ A16A CB C3            SET 0, E
 101+ A16C              .no_space:
 102+ A16C
 103+ A16C                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A16C 7B               LD A, E
 105+ A16D 32 50 82         LD (InputFire), A
 106+ A170
 107+ A170                  ; -- 6. Cancelar opuestos --
 108+ A170 7A               LD A, D
 109+ A171 47               LD B, A
 110+ A172 E6 03            AND DIR_N | DIR_S
 111+ A174 FE 03            CP DIR_N | DIR_S
 112+ A176 20 04            JR NZ, .noVC
 113+ A178 78               LD A, B
 114+ A179 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ A17B 47               LD B, A
 116+ A17C              .noVC:
 117+ A17C 78               LD A, B
 118+ A17D E6 0C            AND DIR_E | DIR_W
 119+ A17F FE 0C            CP DIR_E | DIR_W
 120+ A181 20 04            JR NZ, .noHC
 121+ A183 78               LD A, B
 122+ A184 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ A186 47               LD B, A
 124+ A187              .noHC:
 125+ A187 78               LD A, B
 126+ A188 32 4F 82         LD (InputDirection), A
 127+ A18B C9               RET
