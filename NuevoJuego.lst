5683+ C260              .rmFaceSet:
5684+ C260 DD 77 00         LD (IX+ENT_SPRITEID), A
5685+ C263 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5686+ C267 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5687+ C26B DD 36 0A 00      LD (IX+ENT_DIR), 0
5688+ C26F DD 36 06 00      LD (IX+ENT_DELTAX), 0
5689+ C273 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5690+ C277 DD 7E 03         LD A, (IX+ENT_POSX)
5691+ C27A DD 77 0C         LD (IX+ENT_OLDX), A
5692+ C27D DD 77 0F         LD (IX+ENT_DRAWX), A
5693+ C280 DD 7E 04         LD A, (IX+ENT_POSY)
5694+ C283 DD 77 0D         LD (IX+ENT_OLDY), A
5695+ C286 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5696+ C289 DD 77 0E         LD (IX+ENT_OLDSPRID), A
5697+ C28C                  ; Solo UNO por frame
5698+ C28C C1               POP BC
5699+ C28D 3E 14            LD A, MONSTER_ENTRY_GAP
5700+ C28F 32 9F C2         LD (.rmTimer), A
5701+ C292 C9               RET
