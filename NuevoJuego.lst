 955+ A7D7              ; ==============================================================================
 956+ A7D7              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 957+ A7D7              ; ==============================================================================
 958+ A7D7              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 959+ A7D7              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 960+ A7D7              ; ==============================================================================
 961+ A7D7              GetSpriteAddr:
 962+ A7D7                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
 963+ A7D7                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
 964+ A7D7 3A 57 90         LD A, (CurrentPaging)
 965+ A7DA E6 F8            AND $F8
 966+ A7DC F6 06            OR 6
 967+ A7DE 32 57 90         LD (CurrentPaging), A
 968+ A7E1 01 FD 7F         LD BC, $7FFD
 969+ A7E4 ED 79            OUT (C), A                  ; bank 6 paginado
 970+ A7E6 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 971+ A7E9 6F               LD L, A
 972+ A7EA 26 00            LD H, 0
 973+ A7EC 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 974+ A7ED 11 03 E3         LD DE, SpriteFrameTable
 975+ A7F0 19               ADD HL, DE
 976+ A7F1 5E               LD E, (HL)
 977+ A7F2 23               INC HL
 978+ A7F3 56               LD D, (HL)
 979+ A7F4 ED 53 06 A8      LD (SpriteAddrTemp), DE
 980+ A7F8 3A 57 90         LD A, (CurrentPaging)
 981+ A7FB E6 F8            AND $F8
 982+ A7FD 32 57 90         LD (CurrentPaging), A
 983+ A800 01 FD 7F         LD BC, $7FFD
 984+ A803 ED 79            OUT (C), A                  ; bank 0 de vuelta
 985+ A805 C9               RET
 986+ A806
 987+ A806 00 00        SpriteAddrTemp: DEFW 0
 988+ A808
 989+ A808              ; ==============================================================================
 990+ A808              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
 991+ A808              ; ==============================================================================
 992+ A808              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
 993+ A808              ; Salida:   DE = puntero al sprite data
 994+ A808              ;           OldSprAddr = mismo puntero (conveniencia para caller)
 995+ A808              ; Preserva: IX
 996+ A808              ; Destruye: A, HL
 997+ A808              ; ==============================================================================
 998+ A808              GetOldSpriteAddr:
 999+ A808                  ; Paging inline (ver GetSpriteAddr)
1000+ A808 3A 57 90         LD A, (CurrentPaging)
1001+ A80B E6 F8            AND $F8
1002+ A80D F6 06            OR 6
1003+ A80F 32 57 90         LD (CurrentPaging), A
1004+ A812 01 FD 7F         LD BC, $7FFD
1005+ A815 ED 79            OUT (C), A
1006+ A817 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1007+ A81A 6F               LD L, A
1008+ A81B 26 00            LD H, 0
1009+ A81D 29               ADD HL, HL
1010+ A81E 11 03 E3         LD DE, SpriteFrameTable
1011+ A821 19               ADD HL, DE
1012+ A822 5E               LD E, (HL)
1013+ A823 23               INC HL
1014+ A824 56               LD D, (HL)
1015+ A825 ED 53 90 A7      LD (OldSprAddr), DE
1016+ A829 3A 57 90         LD A, (CurrentPaging)
1017+ A82C E6 F8            AND $F8
1018+ A82E 32 57 90         LD (CurrentPaging), A
1019+ A831 01 FD 7F         LD BC, $7FFD
1020+ A834 ED 79            OUT (C), A
1021+ A836 C9               RET
1022+ A837
1023+ A837              ; ==============================================================================
1024+ A837              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1025+ A837              ; ==============================================================================
1026+ A837              ; Entrada: A = SpriteID
1027+ A837              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1028+ A837              ; Destruye: A, DE, HL
1029+ A837              ; ==============================================================================
1030+ A837              GetSpriteDims:
1031+ A837                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1032+ A837                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1033+ A837 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1034+ A838 26 00            LD H, 0
1035+ A83A 3A 57 90         LD A, (CurrentPaging)
1036+ A83D E6 F8            AND $F8
1037+ A83F F6 06            OR 6
1038+ A841 32 57 90         LD (CurrentPaging), A
1039+ A844 01 FD 7F         LD BC, $7FFD
1040+ A847 ED 79            OUT (C), A                  ; bank 6 paginado
1041+ A849 29               ADD HL, HL
1042+ A84A 11 03 E3         LD DE, SpriteFrameTable
1043+ A84D 19               ADD HL, DE
1044+ A84E 5E               LD E, (HL)
1045+ A84F 23               INC HL
1046+ A850 56               LD D, (HL)                  ; DE = ptr al sprite data
1047+ A851 1A               LD A, (DE)                  ; width_bytes
1048+ A852 87               ADD A, A
1049+ A853 87               ADD A, A
1050+ A854 87               ADD A, A                    ; × 8 = width_px
1051+ A855 47               LD B, A
1052+ A856 13               INC DE
1053+ A857 1A               LD A, (DE)                  ; height_px
1054+ A858 4F               LD C, A
1055+ A859                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1056+ A859 78               LD A, B
1057+ A85A 32 77 A8         LD (GsdSavedB), A
1058+ A85D 79               LD A, C
1059+ A85E 32 78 A8         LD (GsdSavedC), A
1060+ A861 3A 57 90         LD A, (CurrentPaging)
1061+ A864 E6 F8            AND $F8
1062+ A866 32 57 90         LD (CurrentPaging), A
1063+ A869 01 FD 7F         LD BC, $7FFD
1064+ A86C ED 79            OUT (C), A                  ; bank 0 de vuelta
1065+ A86E 3A 77 A8         LD A, (GsdSavedB)
1066+ A871 47               LD B, A
1067+ A872 3A 78 A8         LD A, (GsdSavedC)
1068+ A875 4F               LD C, A
1069+ A876 C9               RET
1070+ A877
1071+ A877 00           GsdSavedB: DEFB 0
1072+ A878 00           GsdSavedC: DEFB 0
1073+ A879
1074+ A879              ; ==============================================================================
1075+ A879              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1076+ A879              ; ==============================================================================
1077+ A879              ; IX = puntero a la entidad del player (slot 0)
1078+ A879              ; ==============================================================================
1079+ A879              UpdatePlayer:
1080+ A879 CD 83 A8         CALL UpdatePlayerState
1081+ A87C CD 9E A9         CALL UpdatePlayerMovement
1082+ A87F CD 03 AC         CALL UpdatePlayerAnimation
1083+ A882 C9               RET
1084+ A883
1085+ A883              ; ==============================================================================
1086+ A883              ; UpdatePlayerState - Determina estado y direccion desde input
1087+ A883              ; ==============================================================================
1088+ A883              UpdatePlayerState:
1089+ A883 3A EC 81         LD A, (InputDirection)
1090+ A886 47               LD B, A
1091+ A887 3A ED 81         LD A, (InputFire)
1092+ A88A 4F               LD C, A
1093+ A88B
1094+ A88B                  ; Sin input → idle (salvo si ataque en curso)
1095+ A88B 78               LD A, B
1096+ A88C B1               OR C
1097+ A88D 20 17            JR NZ, .notIdle
1098+ A88F                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1099+ A88F 3A 0B B6         LD A, (AttackTimer)
1100+ A892 B7               OR A
1101+ A893 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1102+ A895 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1103+ A899                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1104+ A899 DD 7E 0A         LD A, (IX+ENT_DIR)
1105+ A89C E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1106+ A89E DD 77 0A         LD (IX+ENT_DIR), A
1107+ A8A1                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1108+ A8A1 AF               XOR A
1109+ A8A2 32 0D B6         LD (AttackDebounce), A
1110+ A8A5 C9               RET
1111+ A8A6
1112+ A8A6              .notIdle:
1113+ A8A6                  ; Guardar direccion actual en bits 0-3
1114+ A8A6 DD 7E 0A         LD A, (IX+ENT_DIR)
1115+ A8A9 E6 F0            AND $F0                     ; Mantener lastHDir
1116+ A8AB B0               OR B                        ; Añadir dir actual
1117+ A8AC DD 77 0A         LD (IX+ENT_DIR), A
1118+ A8AF
1119+ A8AF                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1120+ A8AF 3A 0B B6         LD A, (AttackTimer)
1121+ A8B2 B7               OR A
1122+ A8B3 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1123+ A8B5 78               LD A, B
1124+ A8B6 E6 0C            AND DIR_E | DIR_W
1125+ A8B8 28 0E            JR Z, .noHorizUpdate
1126+ A8BA                  ; Guardar en bits 4-7
1127+ A8BA 07               RLCA
1128+ A8BB 07               RLCA
1129+ A8BC 07               RLCA
1130+ A8BD 07               RLCA                        ; Shift a bits 4-7
1131+ A8BE 4F               LD C, A                     ; C = lastHDir en bits 4-7
1132+ A8BF DD 7E 0A         LD A, (IX+ENT_DIR)
1133+ A8C2 E6 0F            AND $0F                     ; Mantener dir actual
1134+ A8C4 B1               OR C                        ; Añadir lastHDir
1135+ A8C5 DD 77 0A         LD (IX+ENT_DIR), A
1136+ A8C8              .noHorizUpdate:
1137+ A8C8
1138+ A8C8                  ; --- Consumir/regenerar stamina ---
1139+ A8C8 CD 36 AD         CALL UpdateStamina
1140+ A8CB                  ; --- Auto-select sword mode segun stamina ---
1141+ A8CB CD 8C AD         CALL SelectSwordMode
1142+ A8CE                  ; --- Dispatch segun SwordMode ---
1143+ A8CE 3A 0F B6         LD A, (SwordMode)
1144+ A8D1 B7               OR A
1145+ A8D2 28 09            JR Z, .swordModeB
1146+ A8D4 FE 01            CP 1
1147+ A8D6 28 3F            JR Z, .swordModeC
1148+ A8D8 FE 02            CP 2
1149+ A8DA CA 40 A9         JP Z, .swordModeFree
1150+ A8DD
1151+ A8DD                  ; === MODO B: Cooldown fijo tras atacar ===
1152+ A8DD              .swordModeB:
1153+ A8DD 3A 0C B6         LD A, (AttackCooldown)
1154+ A8E0 B7               OR A
1155+ A8E1 28 0D            JR Z, .bNoCooldown
1156+ A8E3 3D               DEC A
1157+ A8E4 32 0C B6         LD (AttackCooldown), A
1158+ A8E7 C2 8E A9         JP NZ, .running                     ; En cooldown: no puede atacar
1159+ A8EA                  ; Cooldown terminado: restaurar color blanco
1160+ A8EA CD 67 A9         CALL .setPlayerWhite
1161+ A8ED C3 8E A9         JP .running
1162+ A8F0              .bNoCooldown:
1163+ A8F0 3A 0B B6         LD A, (AttackTimer)
1164+ A8F3 B7               OR A
1165+ A8F4 28 13            JR Z, .bNoActive
1166+ A8F6 3D               DEC A
1167+ A8F7 32 0B B6         LD (AttackTimer), A
1168+ A8FA 20 08            JR NZ, .bActive
1169+ A8FC                  ; Swing terminado: iniciar cooldown + color azul
1170+ A8FC 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1171+ A8FE 32 0C B6         LD (AttackCooldown), A
1172+ A901 CD 5C A9         CALL .setPlayerBlue
1173+ A904              .bActive:
1174+ A904 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
