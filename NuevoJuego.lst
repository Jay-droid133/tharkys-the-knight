 123+ EB9A              ; ==============================================================================
 124+ EB9A              ; UpdateGameClock
 125+ EB9A              ; ==============================================================================
 126+ EB9A              UpdateGameClock:
 127+ EB9A 3A B8 82         LD A, (TimeFrozen)
 128+ EB9D B7               OR A
 129+ EB9E C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EB9F 21 00 EA         LD HL, GameSubMinute
 131+ EBA2 34               INC (HL)
 132+ EBA3 3A 03 EA         LD A, (SubMinuteMax)
 133+ EBA6 BE               CP (HL)
 134+ EBA7 C0               RET NZ
 135+ EBA8
 136+ EBA8 AF               XOR A
 137+ EBA9 32 00 EA         LD (GameSubMinute), A
 138+ EBAC 21 01 EA         LD HL, GameMinutes
 139+ EBAF 34               INC (HL)
 140+ EBB0                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EBB0                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EBB0 3A 01 EA         LD A, (GameMinutes)
 143+ EBB3 FE 3C            CP 60
 144+ EBB5 C0               RET NZ
 145+ EBB6
 146+ EBB6 AF               XOR A
 147+ EBB7 32 01 EA         LD (GameMinutes), A
 148+ EBBA 21 02 EA         LD HL, GameHours
 149+ EBBD 34               INC (HL)
 150+ EBBE 7E               LD A, (HL)
 151+ EBBF FE 18            CP 24
 152+ EBC1 20 04            JR NZ, .checkPhase
 153+ EBC3 AF               XOR A
 154+ EBC4 32 02 EA         LD (GameHours), A
 155+ EBC7
 156+ EBC7              .checkPhase:
 157+ EBC7 3A 02 EA         LD A, (GameHours)
 158+ EBCA 21 0C EA         LD HL, PhaseTable
 159+ EBCD 06 07            LD B, 7
 160+ EBCF              .phaseLoop:
 161+ EBCF BE               CP (HL)
 162+ EBD0 28 05            JR Z, .phaseFound
 163+ EBD2 23               INC HL
 164+ EBD3 23               INC HL
 165+ EBD4 10 F9            DJNZ .phaseLoop
 166+ EBD6 C9               RET
 167+ EBD7              .phaseFound:
 168+ EBD7 23               INC HL
 169+ EBD8 7E               LD A, (HL)
 170+ EBD9 F5               PUSH AF
 171+ EBDA CD A2 E3         CALL SetTimeOfDay
 172+ EBDD F1               POP AF
 173+ EBDE FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EBE0 C0               RET NZ
 175+ EBE1                  ; Nuevo dia: incrementar ciclo
 176+ EBE1 21 21 BD         LD HL, DayCycleCount
 177+ EBE4 34               INC (HL)
 178+ EBE5 C9               RET
 179+ EBE6
 180+ EBE6              ; ==============================================================================
 181+ EBE6              ; SetClockToPhaseHour
 182+ EBE6              ; ==============================================================================
 183+ EBE6              SetClockToPhaseHour:
 184+ EBE6 21 05 EA         LD HL, PhaseStartHour
 185+ EBE9 4F               LD C, A
 186+ EBEA 06 00            LD B, 0
 187+ EBEC 09               ADD HL, BC
 188+ EBED 7E               LD A, (HL)
 189+ EBEE 32 02 EA         LD (GameHours), A
 190+ EBF1 AF               XOR A
 191+ EBF2 32 01 EA         LD (GameMinutes), A
 192+ EBF5 32 00 EA         LD (GameSubMinute), A
 193+ EBF8 C9               RET
 194+ EBF9
 195+ EBF9              ; ==============================================================================
 196+ EBF9              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EBF9              ; ==============================================================================
 198+ EBF9              DrawClockHUD:
 199+ EBF9                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EBF9                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EBF9                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EBF9                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EBF9                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EBF9                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EBF9 3A B8 82         LD A, (TimeFrozen)
 206+ EBFC FE 01            CP 1
 207+ EBFE 20 07            JR NZ, .clkDrawNormal
 208+ EC00 3A 9D 81         LD A, (GameFrameCounter)
 209+ EC03 E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EC05 28 2D            JR Z, .clkBlinkOff
 211+ EC07              .clkDrawNormal:
 212+ EC07 CD 42 EC         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EC0A
 214+ EC0A                  ; --- Aguja de horas ---
 215+ EC0A 3A 02 EA         LD A, (GameHours)
 216+ EC0D FE 0C            CP 12
 217+ EC0F 38 02            JR C, .hourOk
 218+ EC11 D6 0C            SUB 12
 219+ EC13              .hourOk:
 220+ EC13 21 FE EA         LD HL, HourHandPtrs
 221+ EC16 CD 18 EE         CALL DrawHandLine
 222+ EC19
 223+ EC19                  ; --- Aguja de minutos ---
 224+ EC19 3A 01 EA         LD A, (GameMinutes)
 225+ EC1C 06 00            LD B, 0
 226+ EC1E              .divMin:
 227+ EC1E FE 05            CP 5
 228+ EC20 38 05            JR C, .minOk
 229+ EC22 D6 05            SUB 5
 230+ EC24 04               INC B
 231+ EC25 18 F7            JR .divMin
 232+ EC27              .minOk:
 233+ EC27 78               LD A, B
 234+ EC28 21 1A EA         LD HL, MinHandPtrs
 235+ EC2B CD 18 EE         CALL DrawHandLine
 236+ EC2E
 237+ EC2E                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EC2E 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EC31 CB 86            RES 0, (HL)
 240+ EC33 C9               RET
 241+ EC34
 242+ EC34              .clkBlinkOff:
 243+ EC34                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EC34                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EC34                  ; paper=black + ink=black.
 246+ EC34 AF               XOR A
 247+ EC35 32 0F 58         LD ($580F), A
 248+ EC38 32 2F 58         LD ($582F), A
 249+ EC3B 32 10 58         LD ($5810), A
 250+ EC3E 32 30 58         LD ($5830), A
 251+ EC41 C9               RET
