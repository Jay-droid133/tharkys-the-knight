 339+ 8D46 C6 01            ADD A, SLOT_MONSTER0
 340+ 8D48 6F               LD L, A
 341+ 8D49 26 00            LD H, 0
 342+ 8D4B 29               ADD HL, HL
 343+ 8D4C 29               ADD HL, HL
 344+ 8D4D 29               ADD HL, HL
 345+ 8D4E 29               ADD HL, HL                          ; × ENT_SIZE (16)
 346+ 8D4F 11 85 80         LD DE, EntityTable
 347+ 8D52 19               ADD HL, DE
