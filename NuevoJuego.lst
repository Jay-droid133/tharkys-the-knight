 240+ 99BC              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 241+ 99BC              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 242+ 99BC              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 243+ 99BC              ;
 244+ 99BC              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 245+ 99BC              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 246+ 99BC              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 247+ 99BC              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 248+ 99BC              StartMusic:
 249+ 99BC 32 E1 99         LD (MusicTrackArg), A
 250+ 99BF F3               DI
 251+ 99C0 3A 84 8D         LD A, (CurrentPaging)
 252+ 99C3 E6 F8            AND $F8
 253+ 99C5 F6 04            OR 4
 254+ 99C7 32 84 8D         LD (CurrentPaging), A
 255+ 99CA 01 FD 7F         LD BC, $7FFD
 256+ 99CD ED 79            OUT (C), A
 257+ 99CF CD 82 E5         CALL StartMusicImpl
 258+ 99D2 3A 84 8D         LD A, (CurrentPaging)
 259+ 99D5 E6 F8            AND $F8
 260+ 99D7 32 84 8D         LD (CurrentPaging), A
 261+ 99DA 01 FD 7F         LD BC, $7FFD
 262+ 99DD ED 79            OUT (C), A
 263+ 99DF FB               EI
 264+ 99E0 C9               RET
 265+ 99E1
 266+ 99E1              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 267+ 99E1              ; desde el Impl en bank 4 sin trampa de paging.
 268+ 99E1 00           MusicTrackArg: DEFB 0
 269+ 99E2
 270+ 99E2              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 271+ 99E2              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 272+ 99E2              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 273+ 99E2              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 274+ 99E2              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 275+ 99E2              ; (bank 0/2) puedan leer/escribir sin paging.
 276+ 99E2 00           MusicSpeedShift: DEFB 0
 277+ 99E3
 278+ 99E3              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 279+ 99E3              ; transiciones de pantalla u otros frames lentos) ---
 280+ 99E3              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 281+ 99E3              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 282+ 99E3              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 283+ 99E3              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 284+ 99E3              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 285+ 99E3              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 286+ 99E3              ; tick daria 0, drift acumulando.
 287+ 99E3 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 288+ 99E4 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 289+ 99E5
