 812+ 6F17 ~                LD (.cfmgSide), A
 813+ 6F17 ~                LD A, (.cfmgSid)
 814+ 6F17 ~                LD L, A
 815+ 6F17 ~                LD H, 0
 816+ 6F17 ~                ADD HL, HL
 817+ 6F17 ~                LD DE, RoomCompGapsTable
 818+ 6F17 ~                ADD HL, DE
 819+ 6F17 ~                LD E, (HL)
 820+ 6F17 ~                INC HL
 821+ 6F17 ~                LD D, (HL)
 822+ 6F17 ~                EX DE, HL                            ; HL = record
 823+ 6F17 ~                LD A, (HL)
 824+ 6F17 ~                OR A
 825+ 6F17 ~                JR Z, .cfmgNotFound
 826+ 6F17 ~                LD B, A
 827+ 6F17 ~                INC HL
 828+ 6F17 ~            .cfmgLoop:
 829+ 6F17 ~                LD A, (HL)                           ; side_comp
 830+ 6F17 ~                INC HL
 831+ 6F17 ~                LD C, (HL)                           ; coord
 832+ 6F17 ~                INC HL
 833+ 6F17 ~                LD D, A                              ; D = side_comp
 834+ 6F17 ~                AND $03                              ; side
 835+ 6F17 ~                LD E, A
 836+ 6F17 ~                LD A, (.cfmgSide)
 837+ 6F17 ~                CP E
 838+ 6F17 ~                JR NZ, .cfmgSkip
 839+ 6F17 ~                LD A, (.cfmgCoord)
 840+ 6F17 ~                CP C
 841+ 6F17 ~                JR NZ, .cfmgSkip
