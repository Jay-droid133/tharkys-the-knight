4774+ BD6D              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4775+ BD6D              ; ==============================================================================
4776+ BD6D              UpdateEnemySpeed:
4777+ BD6D 3A 6F C0         LD A, (DayCycleCount)
4778+ BD70 3D               DEC A                               ; 0-based index
4779+ BD71 FE 0A            CP 10
4780+ BD73 38 02            JR C, .uesOk
4781+ BD75 3E 09            LD A, 9                             ; Cap en indice 9
4782+ BD77              .uesOk:
4783+ BD77 F5               PUSH AF                             ; Guardar indice para tabla de anim
4784+ BD78 21 9B BD         LD HL, EnemySpeedTable
4785+ BD7B 5F               LD E, A
4786+ BD7C 16 00            LD D, 0
4787+ BD7E 19               ADD HL, DE
4788+ BD7F 7E               LD A, (HL)                          ; A = velocidad × 2
4789+ BD80                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4790+ BD80 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4791+ BD82 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4792+ BD84                  ; Hay fraccion .5: alternar +1 en frames impares
4793+ BD84 47               LD B, A                             ; B = parte entera
4794+ BD85 3A 33 81         LD A, (GameFrameCounter)
4795+ BD88 E6 01            AND 1                               ; 0 en par, 1 en impar
4796+ BD8A 80               ADD A, B                            ; Sumar 0 o 1
4797+ BD8B              .uesNoFrac:
4798+ BD8B 32 9C 90         LD (CurrentEnemySpeed), A
4799+ BD8E                  ; Leer delay de animacion para este ciclo
4800+ BD8E F1               POP AF                              ; A = indice 0-based
4801+ BD8F 21 A5 BD         LD HL, EnemyAnimDelayTable
4802+ BD92 5F               LD E, A
4803+ BD93 16 00            LD D, 0
4804+ BD95 19               ADD HL, DE
4805+ BD96 7E               LD A, (HL)
4806+ BD97 32 9D 90         LD (CurrentEnemyAnimDelay), A
4807+ BD9A C9               RET
4808+ BD9B
4809+ BD9B              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4810+ BD9B              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4811+ BD9B              EnemySpeedTable:
4812+ BD9B 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4813+ BD9C 05               DEFB 5                              ; Ciclo 2: 2.5px
4814+ BD9D 06               DEFB 6                              ; Ciclo 3: 3px
4815+ BD9E 07               DEFB 7                              ; Ciclo 4: 3.5px
4816+ BD9F 08               DEFB 8                              ; Ciclo 5: 4px
4817+ BDA0 09               DEFB 9                              ; Ciclo 6: 4.5px
4818+ BDA1 0A               DEFB 10                             ; Ciclo 7: 5px
4819+ BDA2 0B               DEFB 11                             ; Ciclo 8: 5.5px
4820+ BDA3 0C               DEFB 12                             ; Ciclo 9: 6px
4821+ BDA4 0E               DEFB 14                             ; Ciclo 10: 7px
4822+ BDA5
4823+ BDA5              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4824+ BDA5              ; La rata usara la mitad de estos valores
4825+ BDA5              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4826+ BDA5 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4827+ BDA6 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4828+ BDA7 03               DEFB 3                              ; Ciclo 3 (era 6)
4829+ BDA8 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4830+ BDA9 02               DEFB 2                              ; Ciclo 5 (era 4)
4831+ BDAA 02               DEFB 2                              ; Ciclo 6 (era 4)
4832+ BDAB 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4833+ BDAC 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4834+ BDAD 01               DEFB 1                              ; Ciclo 9 (era 2)
4835+ BDAE 01               DEFB 1                              ; Ciclo 10 (era 2)
