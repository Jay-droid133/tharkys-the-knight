 152  72E3                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 153  72E3                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 154  72E3                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 155  72E3                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 156  72E3                  INCLUDE "magic_compass.asm"
# file opened: code/magic_compass.asm
   1+ 72E3              ; ==============================================================================
   2+ 72E3              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 72E3              ; ==============================================================================
   4+ 72E3              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 72E3              ; Mientras MagicCompassTimer>0:
   6+ 72E3              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 72E3              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 72E3              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 72E3              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 72E3              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 72E3              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 72E3              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 72E3              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 72E3              ;
  15+ 72E3              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 72E3              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 72E3              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 72E3              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 72E3              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 72E3              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 72E3              ;
  22+ 72E3              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 72E3              ; ==============================================================================
  24+ 72E3
  25+ 72E3              ; ==============================================================================
  26+ 72E3              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 72E3              ; ==============================================================================
  28+ 72E3              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 72E3              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 72E3              ; Destruye: AF, HL.
  31+ 72E3              ; ==============================================================================
  32+ 72E3              ApplyMagicCompassBuff:
  33+ 72E3 21 EE 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 72E6 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 72E9 3E 01            LD A, 1
  36+ 72EB 32 C2 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 72EE AF               XOR A
  38+ 72EF 32 C3 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 72F2 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 72F4 32 C4 5F         LD (MagicCompassTickCounter), A
  41+ 72F7                  ; Arrancar jingle: idx=0, frames=1 → primera nota se dispara YA en update
  42+ 72F7 AF               XOR A
  43+ 72F8 32 C5 5F         LD (MagicCompassJingleIdx), A
  44+ 72FB 3E 01            LD A, 1
  45+ 72FD 32 C6 5F         LD (MagicCompassJingleFrames), A
  46+ 7300 C9               RET
  47+ 7301
  48+ 7301              ; ==============================================================================
  49+ 7301              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  50+ 7301              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  51+ 7301              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  52+ 7301              ; ==============================================================================
  53+ 7301              ; Entry points:
  54+ 7301              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  55+ 7301              ;                           muerte / hito cumplido / llegar a sala destino,
  56+ 7301              ;                           sites que no saben si la brujula estaba activa.
  57+ 7301              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  58+ 7301              ;                           por el branch del timeout natural (Timer ya es 0
  59+ 7301              ;                           tras el DEC, asi que el check daria RET Z falso
  60+ 7301              ;                           positivo y se saltaria el cleanup).
  61+ 7301              ; ==============================================================================
  62+ 7301              CancelMagicCompass:
  63+ 7301 3A C5 82         LD A, (MagicCompassPermanent)
  64+ 7304 B7               OR A
  65+ 7305 C0               RET NZ                               ; lasting compass: nunca cancelar
  66+ 7306 3A BF 5F         LD A, (MagicCompassTimer)
  67+ 7309 47               LD B, A
  68+ 730A 3A C0 5F         LD A, (MagicCompassTimer + 1)
  69+ 730D B0               OR B
  70+ 730E C8               RET Z                                ; ya inactivo
  71+ 730F                  ; fall through al cleanup compartido
  72+ 730F              _DoCancelMagicCompass:
  73+ 730F AF               XOR A
  74+ 7310 32 BF 5F         LD (MagicCompassTimer), A
  75+ 7313 32 C0 5F         LD (MagicCompassTimer + 1), A
  76+ 7316 32 C4 5F         LD (MagicCompassTickCounter), A
  77+ 7319 32 C3 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  78+ 731C 32 CC 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  79+ 731F 3E FF            LD A, $FF
