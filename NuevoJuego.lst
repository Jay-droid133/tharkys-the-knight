 411+ E3E8              ; ==============================================================================
 412+ E3E8              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 413+ E3E8              ; ==============================================================================
 414+ E3E8              ; Formato: XX,YY:NN nombre_room     DY
 415+ E3E8              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 416+ E3E8              ; ==============================================================================
 417+ E3E8              DrawRoomInfo:
 418+ E3E8                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 419+ E3E8 1E 00            LD E, 0
 420+ E3EA 06 0D            LD B, 13
 421+ E3EC              .clearLoop:
 422+ E3EC C5               PUSH BC
 423+ E3ED D5               PUSH DE
 424+ E3EE 3E 20            LD A, ' '
 425+ E3F0 CD A3 E5         CALL DrawHudChar
 426+ E3F3 D1               POP DE
 427+ E3F4 C1               POP BC
 428+ E3F5 1C               INC E
 429+ E3F6 10 F4            DJNZ .clearLoop
 430+ E3F8
 431+ E3F8                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 432+ E3F8 3A 08 83         LD A, (CurrentScreenX)
 433+ E3FB 1E 00            LD E, 0
 434+ E3FD CD 5B E4         CALL .drawDec2
 435+ E400
 436+ E400                  ; --- ',' en col 2 ---
 437+ E400 3E 2C            LD A, ','
 438+ E402 1E 02            LD E, 2
 439+ E404 CD A3 E5         CALL DrawHudChar
 440+ E407
 441+ E407                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 442+ E407 3A 09 83         LD A, (CurrentScreenY)
 443+ E40A 1E 03            LD E, 3
 444+ E40C CD 5B E4         CALL .drawDec2
 445+ E40F
 446+ E40F                  ; --- ':' en col 5 ---
 447+ E40F 3E 3A            LD A, ':'
 448+ E411 1E 05            LD E, 5
 449+ E413 CD A3 E5         CALL DrawHudChar
 450+ E416
 451+ E416                  ; --- Obtener room index de MapTable[Y*16+X] ---
 452+ E416 3A 09 83         LD A, (CurrentScreenY)
 453+ E419 6F               LD L, A
 454+ E41A 26 00            LD H, 0
 455+ E41C 29               ADD HL, HL
 456+ E41D 29               ADD HL, HL
 457+ E41E 29               ADD HL, HL
 458+ E41F 29               ADD HL, HL                  ; HL = Y * 16
 459+ E420 3A 08 83         LD A, (CurrentScreenX)
 460+ E423 5F               LD E, A
 461+ E424 16 00            LD D, 0
 462+ E426 19               ADD HL, DE                  ; HL = Y*16 + X
 463+ E427 11 42 DD         LD DE, MapTable
 464+ E42A 19               ADD HL, DE
 465+ E42B 7E               LD A, (HL)                  ; A = room index (0-47)
 466+ E42C F5               PUSH AF                     ; guardar room index
 467+ E42D
 468+ E42D                  ; --- Room index como 2 hex en cols 6-7 ---
 469+ E42D F5               PUSH AF
 470+ E42E 0F               RRCA
 471+ E42F 0F               RRCA
 472+ E430 0F               RRCA
 473+ E431 0F               RRCA
 474+ E432 E6 0F            AND $0F
 475+ E434 CD 79 E4         CALL .hexToAscii
 476+ E437 1E 06            LD E, 6
 477+ E439 CD A3 E5         CALL DrawHudChar
 478+ E43C F1               POP AF
 479+ E43D E6 0F            AND $0F
 480+ E43F CD 79 E4         CALL .hexToAscii
 481+ E442 1E 07            LD E, 7
 482+ E444 CD A3 E5         CALL DrawHudChar
 483+ E447
 484+ E447                  ; --- Espacio en col 8 ---
 485+ E447 3E 20            LD A, ' '
 486+ E449 1E 08            LD E, 8
 487+ E44B CD A3 E5         CALL DrawHudChar
 488+ E44E
 489+ E44E                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 490+ E44E F1               POP AF                      ; A = room index (descartar)
 491+ E44F
 492+ E44F                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 493+ E44F 21 20 58         LD HL, ATTR_BASE + 1 * 32
 494+ E452 3E 47            LD A, $47                   ; bright white on black
 495+ E454 06 0D            LD B, 13
 496+ E456              .attrLoop:
 497+ E456 77               LD (HL), A
 498+ E457 23               INC HL
 499+ E458 10 FC            DJNZ .attrLoop
 500+ E45A C9               RET
 501+ E45B
 502+ E45B              ; --- Helpers ---
 503+ E45B              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 504+ E45B              .drawDec2:
 505+ E45B 4B               LD C, E                     ; guardar columna inicial
 506+ E45C 06 00            LD B, 0                     ; decenas
 507+ E45E              .divLoop:
 508+ E45E FE 0A            CP 10
 509+ E460 38 05            JR C, .divDone
 510+ E462 D6 0A            SUB 10
 511+ E464 04               INC B
 512+ E465 18 F7            JR .divLoop
 513+ E467              .divDone:
 514+ E467                  ; B = decenas, A = unidades
 515+ E467 F5               PUSH AF                     ; guardar unidades
 516+ E468 78               LD A, B
 517+ E469 C6 30            ADD A, '0'
 518+ E46B 59               LD E, C
 519+ E46C C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 520+ E46D CD A3 E5         CALL DrawHudChar
 521+ E470 C1               POP BC                      ; restaurar C
 522+ E471 F1               POP AF
 523+ E472 C6 30            ADD A, '0'
 524+ E474 59               LD E, C
 525+ E475 1C               INC E
 526+ E476 C3 A3 E5         JP DrawHudChar              ; tail call
 527+ E479
 528+ E479              .hexToAscii:
 529+ E479 FE 0A            CP 10
 530+ E47B 38 03            JR C, .isDigit
 531+ E47D C6 37            ADD A, 'A' - 10
 532+ E47F C9               RET
 533+ E480              .isDigit:
 534+ E480 C6 30            ADD A, '0'
 535+ E482 C9               RET
