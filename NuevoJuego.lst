 240+ 9F14              ; ==============================================================================
 241+ 9F14              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 242+ 9F14              ; ==============================================================================
 243+ 9F14              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 244+ 9F14              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 245+ 9F14              ; que los pies parezcan hundirse en el suelo.
 246+ 9F14              ; ==============================================================================
 247+ 9F14              ComputePlayerDrawY:
 248+ 9F14                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 249+ 9F14                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 250+ 9F14                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 251+ 9F14 3A A0 81         LD A, (EntityTable + ENT_SPRITEID)
 252+ 9F17 D6 6E            SUB SPRID_PLAYER_DEATH
 253+ 9F19 FE 06            CP 6
 254+ 9F1B 30 09            JR NC, .cpdyNotDeath
 255+ 9F1D 3A A4 81         LD A, (EntityTable + ENT_POSY)
 256+ 9F20 C6 05            ADD A, 5
 257+ 9F22 32 E1 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 258+ 9F25 C9               RET
 259+ 9F26              .cpdyNotDeath:
 260+ 9F26 3A A3 81         LD A, (EntityTable + ENT_POSX)
 261+ 9F29 C6 08            ADD A, 8                    ; center X del player
 262+ 9F2B 47               LD B, A
 263+ 9F2C 3A A4 81         LD A, (EntityTable + ENT_POSY)
 264+ 9F2F 4F               LD C, A
 265+ 9F30 32 E1 82         LD (PlayerDrawY), A         ; default: sin offset
 266+ 9F33 B7               OR A
 267+ 9F34 C8               RET Z
 268+ 9F35 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 269+ 9F36 CD CA D5         CALL IsPointBlocked
 270+ 9F39 C8               RET Z                       ; libre → sin offset
 271+ 9F3A 3A A4 81         LD A, (EntityTable + ENT_POSY)
 272+ 9F3D 3C               INC A
 273+ 9F3E 32 E1 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 274+ 9F41 C9               RET
 275+ 9F42
 276+ 9F42              ; ==============================================================================
 277+ 9F42              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 278+ 9F42              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 279+ 9F42              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 280+ 9F42              ; no parecer que se hunde en el techo.
 281+ 9F42              ; Preserva: IX. Destruye: AF, BC.
 282+ 9F42              ; ==============================================================================
 283+ 9F42              ComputeEnemyDrawY:
 284+ 9F42 DD 7E 04         LD A, (IX+ENT_POSY)
 285+ 9F45 32 E2 82         LD (EnemyDrawY), A          ; default = POSY
 286+ 9F48 DD 7E 01         LD A, (IX+ENT_TYPE)
 287+ 9F4B FE 02            CP TYPE_MONSTER
 288+ 9F4D C0               RET NZ                      ; no monster → sin offset
 289+ 9F4E DD 7E 03         LD A, (IX+ENT_POSX)
 290+ 9F51 C6 08            ADD A, 8                    ; center X
 291+ 9F53 47               LD B, A
 292+ 9F54 DD 7E 04         LD A, (IX+ENT_POSY)
 293+ 9F57 4F               LD C, A
 294+ 9F58 B7               OR A
 295+ 9F59 C8               RET Z
 296+ 9F5A 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 297+ 9F5B CD CA D5         CALL IsPointBlocked
 298+ 9F5E C8               RET Z                       ; libre → sin offset
 299+ 9F5F DD 7E 04         LD A, (IX+ENT_POSY)
 300+ 9F62 3C               INC A
 301+ 9F63 32 E2 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 302+ 9F66 C9               RET
 303+ 9F67
 304+ 9F67              ; ==============================================================================
 305+ 9F67              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 306+ 9F67              ; ==============================================================================
 307+ 9F67              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 308+ 9F67              ; ==============================================================================
 309+ 9F67              ProcessPlayer:
 310+ 9F67 DD 21 A0 81      LD IX, EntityTable
 311+ 9F6B
 312+ 9F6B                  ; --- Fresh check ---
 313+ 9F6B 3A 17 83         LD A, (ScreenJustRedrawn)
 314+ 9F6E B7               OR A
 315+ 9F6F C2 3B A0         JP NZ, .plFresh
 316+ 9F72 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 317+ 9F76 C2 3B A0         JP NZ, .plFresh
 318+ 9F79
 319+ 9F79                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 320+ 9F79                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 321+ 9F79                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 322+ 9F79                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 323+ 9F79                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 324+ 9F79                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 325+ 9F79                  ; y UpdatePlayerAnimation lo sobrescribiria.
 326+ 9F79 3A EC 82         LD A, (DeathBorderPhase)
 327+ 9F7C B7               OR A
 328+ 9F7D 20 0A            JR NZ, .plSkipUpdate
 329+ 9F7F 3A F0 82         LD A, (PlayerRespawnPhase)
 330+ 9F82 FE 01            CP 1
 331+ 9F84 28 03            JR Z, .plSkipUpdate
 332+ 9F86 CD 91 A5         CALL UpdatePlayer
 333+ 9F89              .plSkipUpdate:
 334+ 9F89 CD AA A4         CALL CalcDrawX
 335+ 9F8C CD 14 9F         CALL ComputePlayerDrawY
 336+ 9F8F
 337+ 9F8F                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 338+ 9F8F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 339+ 9F92 DD BE 0C         CP (IX+ENT_OLDX)
 340+ 9F95 20 3C            JR NZ, .plDoErase
 341+ 9F97 3A E1 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 342+ 9F9A DD BE 0D         CP (IX+ENT_OLDY)
 343+ 9F9D 20 34            JR NZ, .plDoErase
 344+ 9F9F DD 7E 00         LD A, (IX+ENT_SPRITEID)
 345+ 9FA2 DD BE 0E         CP (IX+ENT_OLDSPRID)
 346+ 9FA5 20 2C            JR NZ, .plDoErase
 347+ 9FA7                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 348+ 9FA7 3A 32 C5         LD A, (PlayerHitTimer)
 349+ 9FAA B7               OR A
 350+ 9FAB 20 01            JR NZ, .plRepaintAttr
 351+ 9FAD C9               RET                                 ; Nada cambio → skip todo
 352+ 9FAE              .plRepaintAttr:
 353+ 9FAE 3A E1 82         LD A, (PlayerDrawY)
 354+ 9FB1 57               LD D, A
 355+ 9FB2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 356+ 9FB5 5F               LD E, A
 357+ 9FB6 DD E5            PUSH IX
 358+ 9FB8 CD EF A4         CALL GetSpriteAddr
 359+ 9FBB DD 2A 1E A5      LD IX, (SpriteAddrTemp)
 360+ 9FBF CD 09 9B         CALL CalcEntityAttrSize
 361+ 9FC2 DD E1            POP IX
 362+ 9FC4 3A E1 82         LD A, (PlayerDrawY)
 363+ 9FC7 57               LD D, A
 364+ 9FC8 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 365+ 9FCB 5F               LD E, A
 366+ 9FCC DD 7E 05         LD A, (IX+ENT_ATTR)
 367+ 9FCF CD DC 9A         CALL SetEntityAttr
 368+ 9FD2 C9               RET
 369+ 9FD3
 370+ 9FD3              .plDoErase:
 371+ 9FD3                  ; --- Erase viejo ---
 372+ 9FD3 CD 20 A5         CALL GetOldSpriteAddr
 373+ 9FD6 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 374+ 9FD9 DD 7E 0C         LD A, (IX+ENT_OLDX)
 375+ 9FDC 5F               LD E, A
 376+ 9FDD DD E5            PUSH IX
 377+ 9FDF DD 2A A8 A4      LD IX, (OldSprAddr)
 378+ 9FE3 CD EC 99         CALL DrawSprite
 379+ 9FE6 DD E1            POP IX
 380+ 9FE8                  ; Restaurar atributos del fondo en posicion vieja
 381+ 9FE8 DD 56 0D         LD D, (IX+ENT_OLDY)
 382+ 9FEB DD 5E 0C         LD E, (IX+ENT_OLDX)
 383+ 9FEE CD 5A D3         CALL RestoreOldAttr
 384+ 9FF1                  ; --- Draw nuevo ---
 385+ 9FF1 CD EF A4         CALL GetSpriteAddr
 386+ 9FF4 3A E1 82         LD A, (PlayerDrawY)
 387+ 9FF7 57               LD D, A
 388+ 9FF8 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 389+ 9FFB 5F               LD E, A
 390+ 9FFC DD E5            PUSH IX
 391+ 9FFE DD 2A 1E A5      LD IX, (SpriteAddrTemp)
 392+ A002 CD EC 99         CALL DrawSprite
 393+ A005 DD E1            POP IX
 394+ A007
 395+ A007                  ; Pintar attr
 396+ A007 3A E1 82         LD A, (PlayerDrawY)
 397+ A00A 57               LD D, A
 398+ A00B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 399+ A00E 5F               LD E, A
 400+ A00F DD E5            PUSH IX
 401+ A011 DD 2A 1E A5      LD IX, (SpriteAddrTemp)
 402+ A015 CD 09 9B         CALL CalcEntityAttrSize
 403+ A018 DD E1            POP IX
 404+ A01A 3A E1 82         LD A, (PlayerDrawY)
 405+ A01D 57               LD D, A
 406+ A01E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 407+ A021 5F               LD E, A
 408+ A022 DD 7E 05         LD A, (IX+ENT_ATTR)
 409+ A025 CD DC 9A         CALL SetEntityAttr
 410+ A028
 411+ A028                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 412+ A028              .plSaveOld:
 413+ A028 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 414+ A02B DD 77 0C         LD (IX+ENT_OLDX), A
 415+ A02E 3A E1 82         LD A, (PlayerDrawY)
 416+ A031 DD 77 0D         LD (IX+ENT_OLDY), A
 417+ A034 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 418+ A037 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 419+ A03A C9               RET
