 858+ F223
 859+ F223              ; ==============================================================================
 860+ F223              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 861+ F223              ; ==============================================================================
 862+ F223              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 863+ F223              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 864+ F223              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 865+ F223              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 866+ F223              ; monstruo cae alli con la puerta abierta:
 867+ F223              ;   - Bit slot en MonsterTrappedFlags
 868+ F223              ;   - Despawn del monstruo (puff)
 869+ F223              ;   - Puerta se re-cierra (sprite + flag)
 870+ F223              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 871+ F223              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 872+ F223              ;
 873+ F223              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 874+ F223              ; auto-generadas por el level editor segun la posicion de la puerta y los
 875+ F223              ; markers AltKey1/AltKey2.
 876+ F223              ; ==============================================================================
 877+ F223
 878+ F223              ; ==============================================================================
 879+ F223              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 880+ F223              ; ==============================================================================
 881+ F223              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 882+ F223              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 883+ F223              ; Destruye: AF, BC.
 884+ F223              ; ==============================================================================
 885+ F223              CheckChurchTrap:
 886+ F223                  ; --- Solo en pantalla de la iglesia ---
 887+ F223 3A 08 83         LD A, (CurrentScreenX)
 888+ F226 FE 0F            CP CHURCH_TRAP_SCREEN_X
 889+ F228 20 5D            JR NZ, .cctNoTrap
 890+ F22A 3A 09 83         LD A, (CurrentScreenY)
 891+ F22D FE 06            CP CHURCH_TRAP_SCREEN_Y
 892+ F22F 20 56            JR NZ, .cctNoTrap
 893+ F231                  ; --- Solo con la puerta abierta ---
 894+ F231 3A B1 82         LD A, (ChurchDoorOpen)
 895+ F234 B7               OR A
 896+ F235 28 50            JR Z, .cctNoTrap
 897+ F237                  ; --- Solo si el knockback es DIRECTO del player ---
 898+ F237                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 899+ F237                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 900+ F237                  ; espada y se clear cuando se hereda kb por colision.
 901+ F237 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 902+ F23B 28 4A            JR Z, .cctNoTrap
 903+ F23D                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 904+ F23D                  ; (acepta sprites de 16, 21 o 24 px de alto)
 905+ F23D DD 7E 04         LD A, (IX+ENT_POSY)
 906+ F240 CB 3F            SRL A
 907+ F242 CB 3F            SRL A
 908+ F244 CB 3F            SRL A                                   ; A = top charY del monster
 909+ F246 47               LD B, A
 910+ F247 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 911+ F249 90               SUB B                                   ; A = trap_charY - mon_charY
 912+ F24A FE 03            CP 3
 913+ F24C 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 914+ F24E                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 915+ F24E DD 7E 03         LD A, (IX+ENT_POSX)
 916+ F251 CB 3F            SRL A
 917+ F253 CB 3F            SRL A
 918+ F255 CB 3F            SRL A
 919+ F257 47               LD B, A                                 ; B = left charX del monster
 920+ F258 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 921+ F25A 3C               INC A                                   ; A = LO_X + 1
 922+ F25B 90               SUB B                                   ; A = LO_X+1 - charX
 923+ F25C FE 03            CP 3
 924+ F25E 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 925+ F260                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 926+ F260                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 927+ F260 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 928+ F263 D6 4C            SUB SPRID_MONSTER_0
 929+ F265 CB 3F            SRL A
 930+ F267 CB 3F            SRL A
 931+ F269 CB 3F            SRL A                                   ; A = type idx 0..2
 932+ F26B 47               LD B, A
 933+ F26C                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 934+ F26C 3A BF 82         LD A, (NextChurchTrapStep)
 935+ F26F FE 03            CP 3
 936+ F271 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 937+ F273 21 89 F2         LD HL, ChurchTrapOrderTable
 938+ F276 5F               LD E, A
 939+ F277 16 00            LD D, 0
 940+ F279 19               ADD HL, DE
 941+ F27A 7E               LD A, (HL)                              ; A = type esperado
 942+ F27B B8               CP B
 943+ F27C 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 944+ F27E                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 945+ F27E CD 21 F3         CALL TriggerChurchTrap
 946+ F281 3E 01            LD A, 1
 947+ F283 C9               RET
 948+ F284              .cctBlockAsWall:
 949+ F284                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 950+ F284                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 951+ F284 3E 02            LD A, 2
 952+ F286 C9               RET
 953+ F287              .cctNoTrap:
 954+ F287 AF               XOR A
 955+ F288 C9               RET
 956+ F289
 957+ F289              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 958+ F289              ChurchTrapOrderTable:
 959+ F289 00 02 01         DEFB 0, 2, 1
 960+ F28C
 961+ F28C              ; ==============================================================================
 962+ F28C              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 963+ F28C              ; blanco brillante sobre paper negro ($47).
 964+ F28C              ; ==============================================================================
 965+ F28C              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 966+ F28C              ; - No-op fuera de la sala de la iglesia.
 967+ F28C              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 968+ F28C              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 969+ F28C              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 970+ F28C              ;   aun no toca) conservan sus attrs originales del sprite.
 971+ F28C              ; Destruye: AF, BC, DE, HL.
 972+ F28C              ; ==============================================================================
 973+ F28C              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 974+ F28C              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 975+ F28C              HighlightExpectedStatue:
 976+ F28C 3E 47            LD A, $47
 977+ F28E 18 00            JR PaintExpectedStatueAttr
 978+ F290
 979+ F290              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 980+ F290              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 981+ F290              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 982+ F290              PaintExpectedStatueAttr:
 983+ F290 32 FA F2         LD (.hesAttr), A
 984+ F293                  ; --- Solo en la sala de la iglesia ---
 985+ F293 3A 08 83         LD A, (CurrentScreenX)
 986+ F296 FE 0F            CP CHURCH_TRAP_SCREEN_X
 987+ F298 C0               RET NZ
 988+ F299 3A 09 83         LD A, (CurrentScreenY)
 989+ F29C FE 06            CP CHURCH_TRAP_SCREEN_Y
 990+ F29E C0               RET NZ
 991+ F29F                  ; --- Solo tras abrir la iglesia 1a vez ---
 992+ F29F                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 993+ F29F                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 994+ F29F                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 995+ F29F                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 996+ F29F                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 997+ F29F 3A B2 82         LD A, (ChurchEverOpened)
 998+ F2A2 B7               OR A
 999+ F2A3 C8               RET Z
1000+ F2A4                  ; --- Solo si quedan monstruos por atrapar ---
1001+ F2A4 3A BF 82         LD A, (NextChurchTrapStep)
1002+ F2A7 FE 03            CP 3
1003+ F2A9 D0               RET NC
1004+ F2AA                  ; --- Type esperado -> statue id ---
1005+ F2AA 21 89 F2         LD HL, ChurchTrapOrderTable
1006+ F2AD 5F               LD E, A
1007+ F2AE 16 00            LD D, 0
1008+ F2B0 19               ADD HL, DE
1009+ F2B1 7E               LD A, (HL)                              ; type idx esperado
1010+ F2B2 21 A9 69         LD HL, StatueIdTable
1011+ F2B5 5F               LD E, A
1012+ F2B6 16 00            LD D, 0
1013+ F2B8 19               ADD HL, DE
1014+ F2B9 7E               LD A, (HL)                              ; A = statue id
1015+ F2BA B7               OR A
1016+ F2BB C8               RET Z
1017+ F2BC 32 FB F2         LD (.hesTargetId), A
1018+ F2BF                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1019+ F2BF 2A 0A 83         LD HL, (CurrentScreenAddr)
1020+ F2C2              .hesLoop:
1021+ F2C2 7E               LD A, (HL)
1022+ F2C3 FE FF            CP $FF
1023+ F2C5 C8               RET Z                                   ; estatua no en esta sala
1024+ F2C6 47               LD B, A
1025+ F2C7 3A FB F2         LD A, (.hesTargetId)
1026+ F2CA B8               CP B
1027+ F2CB 28 06            JR Z, .hesFound
1028+ F2CD 11 04 00         LD DE, 4
1029+ F2D0 19               ADD HL, DE
1030+ F2D1 18 EF            JR .hesLoop
1031+ F2D3              .hesFound:
1032+ F2D3 23               INC HL
1033+ F2D4 7E               LD A, (HL)                              ; charX
1034+ F2D5 47               LD B, A
1035+ F2D6 23               INC HL
1036+ F2D7 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1037+ F2D8 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1038+ F2DA 4F               LD C, A                                 ; C = charY (post-HUD)
1039+ F2DB                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1040+ F2DB 26 00            LD H, 0
1041+ F2DD 69               LD L, C
1042+ F2DE 29               ADD HL, HL
1043+ F2DF 29               ADD HL, HL
1044+ F2E0 29               ADD HL, HL
1045+ F2E1 29               ADD HL, HL
1046+ F2E2 29               ADD HL, HL                              ; HL = charY * 32
1047+ F2E3 58               LD E, B
1048+ F2E4 16 00            LD D, 0
1049+ F2E6 19               ADD HL, DE                              ; + charX
1050+ F2E7 11 00 58         LD DE, $5800
1051+ F2EA 19               ADD HL, DE                              ; HL = attr addr top-left
1052+ F2EB                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1053+ F2EB                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1054+ F2EB                  ; no hace falta sincronizar CleanAttrMap.
1055+ F2EB 3A FA F2         LD A, (.hesAttr)
1056+ F2EE 06 03            LD B, 3                                 ; 3 filas de chars
1057+ F2F0              .hesRow:
1058+ F2F0 77               LD (HL), A
1059+ F2F1 23               INC HL
1060+ F2F2 77               LD (HL), A                              ; (charX+1)
1061+ F2F3 11 1F 00         LD DE, 31
1062+ F2F6 19               ADD HL, DE                              ; siguiente fila col 0
1063+ F2F7 10 F7            DJNZ .hesRow
1064+ F2F9 C9               RET
1065+ F2FA 00           .hesAttr:     DEFB 0
1066+ F2FB 00           .hesTargetId: DEFB 0
1067+ F2FC
1068+ F2FC              ; ==============================================================================
1069+ F2FC              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1070+ F2FC              ; ==============================================================================
1071+ F2FC              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1072+ F2FC              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1073+ F2FC              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1074+ F2FC              ; + ON final settle): 8 ciclos de ON-OFF en total.
1075+ F2FC              ; ==============================================================================
1076+ F2FC              STATUE_BLINK_FRAMES   EQU 32
1077+ F2FC
1078+ F2FC              StartStatueBlink:
1079+ F2FC                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1080+ F2FC                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1081+ F2FC                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1082+ F2FC                  ; (caso A), .cbtActChurchDoor (caso B).
1083+ F2FC 3E 20            LD A, STATUE_BLINK_FRAMES
1084+ F2FE 32 C0 82         LD (StatueBlinkCounter), A
1085+ F301 C3 8C F2         JP HighlightExpectedStatue              ; initial ON paint
1086+ F304
1087+ F304              UpdateStatueBlink:
1088+ F304                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1089+ F304 3A C0 82         LD A, (StatueBlinkCounter)
1090+ F307 B7               OR A
1091+ F308 C8               RET Z
1092+ F309 3D               DEC A
1093+ F30A 32 C0 82         LD (StatueBlinkCounter), A
1094+ F30D 20 03            JR NZ, .usbInProgress
1095+ F30F                  ; Counter recien llego a 0: settle ON
1096+ F30F C3 8C F2         JP HighlightExpectedStatue
1097+ F312              .usbInProgress:
1098+ F312                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1099+ F312                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1100+ F312 CB 3F            SRL A
1101+ F314 E6 01            AND $01
1102+ F316 28 05            JR Z, .usbOff
1103+ F318 3E 47            LD A, $47
1104+ F31A C3 90 F2         JP PaintExpectedStatueAttr
1105+ F31D              .usbOff:
1106+ F31D AF               XOR A
1107+ F31E C3 90 F2         JP PaintExpectedStatueAttr
1108+ F321
1109+ F321              ; ==============================================================================
1110+ F321              ; CUTSCENE - parametros ajustables
1111+ F321              ; ==============================================================================
1112+ F321              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1113+ F321              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1114+ F321              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1115+ F321              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1116+ F321
1117+ F321              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1118+ F321              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1119+ F321              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1120+ F321
1121+ F321              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1122+ F321              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1123+ F321              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1124+ F321              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1125+ F321              ;   tick 12 -> erase smoke[2], pasar a DONE
1126+ F321              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1127+ F321              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1128+ F321
1129+ F321              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1130+ F321              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1131+ F321              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1132+ F321              ; centrado dentro del vano de la puerta.
1133+ F321              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1134+ F321              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1135+ F321              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1136+ F321              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1137+ F321
1138+ F321              ; ==============================================================================
1139+ F321              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1140+ F321              ; ==============================================================================
1141+ F321              ; IN: IX = monster atrapado.
1142+ F321              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1143+ F321              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1144+ F321              ; en ApplyChurchTrapEffects al final del cutscene.
1145+ F321              ; ==============================================================================
1146+ F321              TriggerChurchTrap:
1147+ F321                  ; --- 1. Calcular slot 0..2 ---
1148+ F321 DD E5            PUSH IX
1149+ F323 E1               POP HL
1150+ F324 11 AB 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1151+ F327 B7               OR A
1152+ F328 ED 52            SBC HL, DE
1153+ F32A CB 3D            SRL L
1154+ F32C CB 3D            SRL L
1155+ F32E CB 3D            SRL L
1156+ F330 CB 3D            SRL L                                   ; L = slot 0..2
1157+ F332 7D               LD A, L
1158+ F333 32 9E 5F         LD (ChurchCutsceneSlot), A
1159+ F336                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1160+ F336 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1161+ F339 D6 4C            SUB SPRID_MONSTER_0
1162+ F33B CB 3F            SRL A
1163+ F33D CB 3F            SRL A
1164+ F33F CB 3F            SRL A                                   ; A = type idx
1165+ F341 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1166+ F344                  ; --- 2. Mover monster al centro del vano ---
1167+ F344 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1168+ F346 DD 77 03         LD (IX+ENT_POSX), A
1169+ F349 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1170+ F34B DD 77 04         LD (IX+ENT_POSY), A
1171+ F34E DD 36 06 00      LD (IX+ENT_DELTAX), 0
1172+ F352 DD 36 07 00      LD (IX+ENT_DELTAY), 0
1173+ F356 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1174+ F35A                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1175+ F35A                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1176+ F35A                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1177+ F35A                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1178+ F35A                  ; temblor se vea con ink blanco brillante sobre paper negro.
1179+ F35A AF               XOR A
1180+ F35B 32 C0 82         LD (StatueBlinkCounter), A              ; parar blink
1181+ F35E DD E5            PUSH IX
1182+ F360 CD 8C F2         CALL HighlightExpectedStatue            ; pintar $47
1183+ F363                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1184+ F363                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1185+ F363                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1186+ F363                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1187+ F363 CD FB BA         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1188+ F366 3E FF            LD A, $FF
1189+ F368 CD BA 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1190+ F36B                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1191+ F36B                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1192+ F36B                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1193+ F36B 3A BF 82         LD A, (NextChurchTrapStep)
1194+ F36E FE 02            CP 2
1195+ F370 CC 4B F9         CALL Z, StopMonstersMusic
1196+ F373 DD E1            POP IX
1197+ F375                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1198+ F375 3E 01            LD A, 1
1199+ F377 32 C6 82         LD (ChurchCutscenePhase), A
1200+ F37A AF               XOR A
1201+ F37B 32 9D 5F         LD (ChurchCutsceneFrame), A
1202+ F37E 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1203+ F380 32 A4 5F         LD (ChurchCutsceneLookCount), A
1204+ F383 C9               RET
1205+ F384
1206+ F384              ; ==============================================================================
1207+ F384              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1208+ F384              ; ==============================================================================
1209+ F384              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1210+ F384              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1211+ F384              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1212+ F384              ; ==============================================================================
1213+ F384              UpdateChurchCutscene:
1214+ F384 3A C6 82         LD A, (ChurchCutscenePhase)
1215+ F387 B7               OR A
1216+ F388 C8               RET Z
1217+ F389 3D               DEC A
1218+ F38A 28 12            JR Z, .ucsLookPhase
1219+ F38C 3D               DEC A
1220+ F38D 28 38            JR Z, .ucsShakeStatuePhase
1221+ F38F 3D               DEC A
1222+ F390 CA 19 F4         JP Z, .ucsSmokePhase
1223+ F393                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1224+ F393 CD 05 69         CALL ApplyChurchTrapDone
1225+ F396 AF               XOR A
1226+ F397 32 C6 82         LD (ChurchCutscenePhase), A
1227+ F39A 32 9D 5F         LD (ChurchCutsceneFrame), A
1228+ F39D C9               RET
1229+ F39E
1230+ F39E              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1231+ F39E              .ucsLookPhase:
1232+ F39E                  ; Frame counter (para detectar fin de fase)
1233+ F39E 21 9D 5F         LD HL, ChurchCutsceneFrame
1234+ F3A1 34               INC (HL)
1235+ F3A2                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1236+ F3A2 21 A4 5F         LD HL, ChurchCutsceneLookCount
1237+ F3A5 35               DEC (HL)
1238+ F3A6 20 06            JR NZ, .ucsLookCheckEnd
1239+ F3A8 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1240+ F3AA 77               LD (HL), A
1241+ F3AB CD 67 F4         CALL ChurchCutsceneToggleMonsterDir
1242+ F3AE              .ucsLookCheckEnd:
1243+ F3AE 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1244+ F3B1 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1245+ F3B3 D8               RET C                                   ; sigue mirando
1246+ F3B4                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1247+ F3B4                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1248+ F3B4                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1249+ F3B4 CD E1 68         CALL EraseChurchTrappedMonster
1250+ F3B7 CD 9F 6B         CALL CloseChurchDoor
1251+ F3BA CD 8C F4         CALL ChurchCutsceneInitStatueShake
1252+ F3BD 3E 02            LD A, 2
1253+ F3BF 32 C6 82         LD (ChurchCutscenePhase), A
1254+ F3C2 AF               XOR A
1255+ F3C3 32 9D 5F         LD (ChurchCutsceneFrame), A
1256+ F3C6 C9               RET
1257+ F3C7
1258+ F3C7              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1259+ F3C7              .ucsShakeStatuePhase:
1260+ F3C7 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1261+ F3CA FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1262+ F3CC 30 35            JR NC, .ucsShakeStatueDone
1263+ F3CE                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1264+ F3CE                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1265+ F3CE                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1266+ F3CE                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1267+ F3CE                  ;
1268+ F3CE                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1269+ F3CE                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1270+ F3CE ED 5F            LD A, R
1271+ F3D0 E6 03            AND $03
1272+ F3D2 21 FF F3         LD HL, .ucsShakeJitterTable
1273+ F3D5 5F               LD E, A
1274+ F3D6 16 00            LD D, 0
1275+ F3D8 19               ADD HL, DE
1276+ F3D9 7E               LD A, (HL)
1277+ F3DA 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1278+ F3DB                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1279+ F3DB 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1280+ F3DE FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1281+ F3E0 21 A9 69         LD HL, StatueIdTable
1282+ F3E3 38 03            JR C, .ucsShakeTablePicked
1283+ F3E5 21 AC 69         LD HL, StatueBrokenIdTable
1284+ F3E8              .ucsShakeTablePicked:
1285+ F3E8 78               LD A, B                                 ; restore jitter para la llamada
1286+ F3E9 CD F6 F4         CALL ChurchCutsceneShakeStatueByteShift
1287+ F3EC                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1288+ F3EC                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1289+ F3EC                  ; y al salir de la fase forzamos borde a negro explicitamente.
1290+ F3EC 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1291+ F3EF E6 01            AND $01
1292+ F3F1 28 04            JR Z, .ucsShakeBorderBlack
1293+ F3F3 3E 07            LD A, WHITE
1294+ F3F5 18 01            JR .ucsShakeBorderOut
1295+ F3F7              .ucsShakeBorderBlack:
1296+ F3F7 AF               XOR A                                   ; BLACK
1297+ F3F8              .ucsShakeBorderOut:
1298+ F3F8 D3 FE            OUT (254), A
1299+ F3FA 21 9D 5F         LD HL, ChurchCutsceneFrame
1300+ F3FD 34               INC (HL)
1301+ F3FE C9               RET
1302+ F3FF              .ucsShakeJitterTable:
1303+ F3FF 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1304+ F403              .ucsShakeStatueDone:
1305+ F403                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1306+ F403 AF               XOR A
1307+ F404 D3 FE            OUT (254), A
1308+ F406                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1309+ F406                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1310+ F406                  ; directo a 0 garantiza que no queden residuos.)
1311+ F406 CD 61 F5         CALL ChurchCutsceneEraseStatueDirect
1312+ F409 21 CF F7         LD HL, SFX_EnemyDeath
1313+ F40C CD 50 F7         CALL PlaySFX
1314+ F40F 3E 03            LD A, 3
1315+ F411 32 C6 82         LD (ChurchCutscenePhase), A
1316+ F414 AF               XOR A
1317+ F415 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1318+ F418 C9               RET
1319+ F419
1320+ F419              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1321+ F419              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1322+ F419              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1323+ F419              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1324+ F419              ; Entre transiciones, solo incrementa frame counter.
1325+ F419              .ucsSmokePhase:
1326+ F419 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1327+ F41C B7               OR A
1328+ F41D 28 0E            JR Z, .ucsSmokeEntry
1329+ F41F FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1330+ F421 28 16            JR Z, .ucsSmokeStep1
1331+ F423 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1332+ F425 28 1D            JR Z, .ucsSmokeStep2
1333+ F427 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1334+ F429 28 25            JR Z, .ucsSmokeEnd
1335+ F42B 18 35            JR .ucsSmokeIncFrame
1336+ F42D              .ucsSmokeEntry:
1337+ F42D                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1338+ F42D 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1339+ F430 CD D4 6A         CALL DrawRemainsForType
1340+ F433                  ; Dibujar smoke[0] (XOR)
1341+ F433 AF               XOR A
1342+ F434 CD 1F 6A         CALL DrawSmokeFrameXor
1343+ F437 18 29            JR .ucsSmokeIncFrame
1344+ F439              .ucsSmokeStep1:
1345+ F439 AF               XOR A
1346+ F43A CD 1F 6A         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1347+ F43D 3E 01            LD A, 1
1348+ F43F CD 1F 6A         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1349+ F442 18 1E            JR .ucsSmokeIncFrame
1350+ F444              .ucsSmokeStep2:
1351+ F444 3E 01            LD A, 1
1352+ F446 CD 1F 6A         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1353+ F449 3E 02            LD A, 2
1354+ F44B CD 1F 6A         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1355+ F44E 18 12            JR .ucsSmokeIncFrame
1356+ F450              .ucsSmokeEnd:
1357+ F450 3E 02            LD A, 2
1358+ F452 CD 1F 6A         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1359+ F455 CD 3E 6A         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1360+ F458 3E 04            LD A, 4
1361+ F45A 32 C6 82         LD (ChurchCutscenePhase), A
