# file opened: bank_cutscene_thunks.asm
   1+ 75A2              ; ==============================================================================
   2+ 75A2              ; bank_cutscene_thunks.asm - Wrappers slot 1 para bank_cutscene en bank 7
   3+ 75A2              ; ==============================================================================
   4+ 75A2              ; bank_cutscene.asm vive en bank 7 (movido desde bank 0 para descongestionar el
   5+ 75A2              ; main code). Este archivo expone los 2 entry points externos como thunks que
   6+ 75A2              ; paginan bank 7 antes del body y restauran bank 0 al volver. Tambien proporciona
   7+ 75A2              ; helpers _PageBank0 / _PageBank7 que el body bank 7 usa para envolver cada
   8+ 75A2              ; CALL a una funcion en bank 0 (o en slot 1 que internamente llame a bank 0).
   9+ 75A2              ;
  10+ 75A2              ; Funciones externas que requieren el wrap pre+post (paginar bank 0 antes,
  11+ 75A2              ; restaurar bank 7 despues):
  12+ 75A2              ;   - DrawBgSpriteXOR, DrawBgGfxSprite, RedrawPickupByPtr, PlaySFX,
  13+ 75A2              ;     CheckMilestoneTrigger    (todas en bank 0)
  14+ 75A2              ;   - TownGateRedrawPlayer     (slot 1, pero llama internamente a RestoreOldAttr
  15+ 75A2              ;                              que vive en bank 0)
  16+ 75A2              ;
  17+ 75A2              ; Funciones que requieren solo post-wrap (ya paginan bank 0 al final ellas mismas):
  18+ 75A2              ;   - LoadBgSpriteToBuffer     (slot 1, deja bank 0 paginado al RET -> repaginar
  19+ 75A2              ;                              bank 7 manualmente)
  20+ 75A2              ;
  21+ 75A2              ; Funciones que NO necesitan wrap (verificado por call graph):
  22+ 75A2              ;   - KillAllActiveNasties, SnapPuffPos, CheckEnemyCollision  (bank 2 slot 2)
  23+ 75A2              ;   - KillDeathIfActive -> StartMusic                          (bank 2 slot 2)
  24+ 75A2              ;   - TownGateAllNastiesDeadCheck                              (slot 1, no calls)
  25+ 75A2              ;   - AY_PlayKnockSoft/Loud/Beep                               (slot 1, no calls externos)
  26+ 75A2              ;   - DrawBgSprite16XorAtPixel -> CalcPixelAddr/NextPixelLine  (bank 2 slot 2)
  27+ 75A2              ;
  28+ 75A2              ; Vive en slot 1 (always-visible). Patron similar a game_over_tomb_thunk.asm.
  29+ 75A2              ;
  30+ 75A2              ; CRITICO: sin DI en los page switches. El stack vive en slot 1, MusicIrqHandler
  31+ 75A2              ; vive en slot 1, y por convencion (project_irq_slot3_atomic) el handler IRQ no
  32+ 75A2              ; toca slot 3. Igual que LoadBgSpriteToBuffer hace page switches sin DI sin
  33+ 75A2              ; perder ticks de musica.
  34+ 75A2              ; ==============================================================================
  35+ 75A2
  36+ 75A2              ; ==============================================================================
  37+ 75A2              ; _PageBank0 - Pagina bank 0 en slot 3. Preserva AF + BC + resto del caller.
  38+ 75A2              ; ==============================================================================
  39+ 75A2              ; Llamado por:
  40+ 75A2              ;   - Entry thunks al final (devolver al gameplay normal).
  41+ 75A2              ;   - Body bank 7 antes de cada CALL externo que toca bank 0.
  42+ 75A2              ; Destruye: ningun reg (todo restaurado via PUSH/POP).
  43+ 75A2              ; ==============================================================================
  44+ 75A2              _PageBank0:
  45+ 75A2 F5               PUSH AF
  46+ 75A3 C5               PUSH BC
  47+ 75A4 3A 85 8D         LD A, (CurrentPaging)
  48+ 75A7 E6 F8            AND $F8                              ; bank 0 = bits 0-2 a cero
  49+ 75A9 32 85 8D         LD (CurrentPaging), A
  50+ 75AC 01 FD 7F         LD BC, $7FFD
  51+ 75AF ED 79            OUT (C), A
  52+ 75B1 C1               POP BC
  53+ 75B2 F1               POP AF
  54+ 75B3 C9               RET
  55+ 75B4
  56+ 75B4              ; ==============================================================================
  57+ 75B4              ; _PageBank7 - Pagina bank 7 en slot 3. Preserva AF + BC + resto del caller.
  58+ 75B4              ; ==============================================================================
  59+ 75B4              ; Llamado por:
  60+ 75B4              ;   - Entry thunks al principio (para que el body bank 7 sea visible).
  61+ 75B4              ;   - Body bank 7 despues de cada CALL externo (para retomar el flujo).
  62+ 75B4              ; Destruye: ningun reg.
  63+ 75B4              ; ==============================================================================
  64+ 75B4              _PageBank7:
  65+ 75B4 F5               PUSH AF
  66+ 75B5 C5               PUSH BC
  67+ 75B6 3A 85 8D         LD A, (CurrentPaging)
  68+ 75B9 E6 F8            AND $F8
  69+ 75BB F6 07            OR 7
  70+ 75BD 32 85 8D         LD (CurrentPaging), A
  71+ 75C0 01 FD 7F         LD BC, $7FFD
  72+ 75C3 ED 79            OUT (C), A
  73+ 75C5 C1               POP BC
  74+ 75C6 F1               POP AF
  75+ 75C7 C9               RET
  76+ 75C8
  77+ 75C8              ; ==============================================================================
  78+ 75C8              ; CheckBankTriggerBg - Thunk de entry. Pagina bank 7, llama al body, restaura.
  79+ 75C8              ; ==============================================================================
  80+ 75C8              ; Llamado desde MainLoop cada frame. El body verifica si el player toca la
  81+ 75C8              ; puerta del banco con el cheque y dispara la cutscene + avance de hito M9.
  82+ 75C8              ; ==============================================================================
  83+ 75C8              CheckBankTriggerBg:
  84+ 75C8 CD B4 75         CALL _PageBank7
  85+ 75CB CD A3 DD         CALL CheckBankTriggerBgBody
  86+ 75CE C3 A2 75         JP _PageBank0                       ; tail-call: _PageBank0 RETs al caller (MainLoop)
  87+ 75D1
  88+ 75D1              ; ==============================================================================
  89+ 75D1              ; UpdateBankCutscene - Thunk de entry para el tick por frame de la cutscene.
  90+ 75D1              ; ==============================================================================
  91+ 75D1              ; Llamado desde MainLoop cada frame si BankCutscenePhase != 0. Phase machine
  92+ 75D1              ; dispatch + animaciones (toques, mano, "no no", spawn de llave).
  93+ 75D1              ; ==============================================================================
  94+ 75D1              UpdateBankCutscene:
  95+ 75D1 CD B4 75         CALL _PageBank7
  96+ 75D4 CD AC DE         CALL UpdateBankCutsceneBody
  97+ 75D7 C3 A2 75         JP _PageBank0
  98+ 75DA
  99+ 75DA              ; ==============================================================================
 100+ 75DA              ; External call thunks - usados desde el body bank 7 para llamar a rutinas
 101+ 75DA              ; que viven en bank 0 (o en slot 1 que internamente toca bank 0).
 102+ 75DA              ; ==============================================================================
 103+ 75DA              ; Patron: body bank 7 hace `CALL <Func>_B7`. El thunk pagina bank 0, llama a
 104+ 75DA              ; la funcion real, repagina bank 7, y RETurnea al body. Args en HL/BC/DE/A/IX
 105+ 75DA              ; quedan intactos (_PageBank0 / _PageBank7 preservan AF + BC via PUSH/POP).
 106+ 75DA              ;
 107+ 75DA              ; CRITICO: el body bank 7 NO puede llamar _PageBank0 directamente — al volver,
 108+ 75DA              ; slot 3 estaria en bank 0 y el RET aterrizaria en bank 0 (no en bank 7) =
 109+ 75DA              ; crash. Por eso cada wrap vive como thunk individual en slot 1 (always-vis).
 110+ 75DA              ; ==============================================================================
 111+ 75DA
 112+ 75DA              ; --- bank 0 callees (paginar bank 0 antes, restaurar bank 7 al RET) ---
 113+ 75DA
 114+ 75DA              DrawBgSpriteXOR_B7:
