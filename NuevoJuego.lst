  11  0000                  ; EQUs de variables ubicadas en low-RAM ($5D00+). No emiten bytes;
  12  0000                  ; el zero-fill + defaults se hace en Inicio: antes del primer uso.
  13  0000                  INCLUDE "variables_lo.asm"
# file opened: variables_lo.asm
   1+ 0000              ; ==============================================================================
   2+ 0000              ; LOW-RAM VARIABLES — ubicadas en $5D00+ via EQU (no emiten bytes al .tap)
   3+ 0000              ; ==============================================================================
   4+ 0000              ; Reubicacion fase A del plan de ampliacion de bank 2 (mem/expand-bank2):
   5+ 0000              ; mover los buffers/scratch que solo se acceden en cold paths a la zona libre
   6+ 0000              ; del bank 5 ($5800-$7FFF). $4000-$5AFF es VRAM; $5B00-$5CCB es system area
   7+ 0000              ; del 128 (printer buffer + system vars). Empezamos en $5D00 con margen.
   8+ 0000              ;
   9+ 0000              ; IMPORTANTE: los simbolos son EQU, asi que NO se emite ningun byte al .tap.
  10+ 0000              ; El loader deja la zona con valores indeterminados; Inicio: hace zero-fill
  11+ 0000              ; de [LOW_RAM_BASE, LOW_RAM_END) y luego pone los defaults no-cero.
  12+ 0000              ;
  13+ 0000              ; Solo entran aqui variables cuya frecuencia de acceso es practicamente nula
  14+ 0000              ; durante el inner loop. La memoria de $5D00-$7FFF es CONTENDED, asi que
  15+ 0000              ; cualquier variable hot debe seguir en bank 2 ($8000-$BFFF, no-contended).
  16+ 0000              ; ==============================================================================
  17+ 0000
  18+ 0000              LOW_RAM_BASE        EQU $5D00
  19+ 0000
  20+ 0000              ; --- Zone cell list: solo se construye al cambiar de sala (BuildZoneCellList) ---
  21+ 0000              ; y se lee en SpawnOneNasty. Cold path (transition + spawn).
  22+ 0000              ZoneCellCount       EQU LOW_RAM_BASE
  23+ 0000              ZoneCellList        EQU ZoneCellCount + 1            ; DEFS 255 * 2
  24+ 0000
  25+ 0000              ; --- BFS rescue de la muerte: solo se dispara cuando StuckCounter llega a 6 ---
  26+ 0000              DBfsQueue           EQU ZoneCellList + 510           ; DEFS 108
  27+ 0000              DBfsQHead           EQU DBfsQueue + 108              ; DEFW
  28+ 0000              DBfsQTail           EQU DBfsQHead + 2                ; DEFW
  29+ 0000              DBfsBestDir         EQU DBfsQTail + 2                ; DEFB
  30+ 0000              DBfsBestDepth       EQU DBfsBestDir + 1
  31+ 0000              DBfsBestManh        EQU DBfsBestDepth + 1
  32+ 0000              DBfsPlayerCx        EQU DBfsBestManh + 1
  33+ 0000              DBfsPlayerCy        EQU DBfsPlayerCx + 1
  34+ 0000              DBfsCurCx           EQU DBfsPlayerCy + 1
  35+ 0000              DBfsCurCy           EQU DBfsCurCx + 1
  36+ 0000              DBfsCurFirstDir     EQU DBfsCurCy + 1
  37+ 0000              DBfsCurDepth        EQU DBfsCurFirstDir + 1
  38+ 0000              DBfsTryCx           EQU DBfsCurDepth + 1
  39+ 0000              DBfsTryCy           EQU DBfsTryCx + 1
  40+ 0000              DBfsTryDir          EQU DBfsTryCy + 1
  41+ 0000
  42+ 0000              ; --- Pending erase list: la usa EraseDeadSprites; cuenta>0 es muy raro ---
  43+ 0000              PendingEraseCount   EQU DBfsTryDir + 1
  44+ 0000              PendingEraseSlots   EQU PendingEraseCount + 1        ; DEFS 3 * 5
  45+ 0000
  46+ 0000              ; --- Monster AI v2 cold state: solo se accede en transicion / scared ---
  47+ 0000              RoomHistory         EQU PendingEraseSlots + 15       ; DEFB 0,0,0
  48+ 0000              MonsterLastSeenRoom EQU RoomHistory + 3              ; DEFB $FF,$FF,$FF (init explicito)
  49+ 0000              MonsterLastSeenX    EQU MonsterLastSeenRoom + 3
  50+ 0000              MonsterLastSeenY    EQU MonsterLastSeenX + 3
  51+ 0000              MonsterShakeOrigX   EQU MonsterLastSeenY + 3
  52+ 0000              MonsterShakeOrigY   EQU MonsterShakeOrigX + 3
  53+ 0000
  54+ 0000              ; --- Cutscene de iglesia: solo accede cuando ChurchCutscenePhase != 0 ---
  55+ 0000              ; ChurchCutscenePhase se queda en bank 2 (lo lee MainLoop cada frame).
  56+ 0000              ChurchCutsceneFrame      EQU MonsterShakeOrigY + 3
  57+ 0000              ChurchCutsceneSlot       EQU ChurchCutsceneFrame + 1
  58+ 0000              ChurchCutsceneTypeIdx    EQU ChurchCutsceneSlot + 1
  59+ 0000              ChurchCutsceneStatueOrigX EQU ChurchCutsceneTypeIdx + 1
  60+ 0000              ChurchCutsceneStatueOrigY EQU ChurchCutsceneStatueOrigX + 1
  61+ 0000              ChurchCutsceneStatueLastX EQU ChurchCutsceneStatueOrigY + 1
  62+ 0000              ChurchCutsceneStatueLastY EQU ChurchCutsceneStatueLastX + 1
  63+ 0000              ChurchCutsceneLookCount  EQU ChurchCutsceneStatueLastY + 1
  64+ 0000
  65+ 0000              ; --- Cutscene final (M9): solo se accede cuando TownGatePhase != 0 ---
  66+ 0000              ; TownGatePhase vive en variables.asm (HOT, lo lee MainLoop cada frame).
  67+ 0000              TownGateTimer            EQU ChurchCutsceneLookCount + 1
  68+ 0000              TownGateShakeOffsX       EQU TownGateTimer + 1            ; signed -1 / 0 / +1
  69+ 0000              TownGateShakeOffsY       EQU TownGateShakeOffsX + 1
  70+ 0000              TownGateExitStepCnt      EQU TownGateShakeOffsY + 1       ; frames hasta sig. step
  71+ 0000              TownGateExitWalkFrame    EQU TownGateExitStepCnt + 1      ; toggle 0/1 anim WALK_S
  72+ 0000              TownGateEndDrawn         EQU TownGateExitWalkFrame + 1    ; 1 = "The End" sprite ya pintado este episodio (one-shot al pasar POSY arch top)
  73+ 0000
  74+ 0000              ; --- Random pickups: estado de la sala actual ---
  75+ 0000              ; Solo se accede en room-enter (UpdateRandomPickup). Cold path.
  76+ 0000              ;
  77+ 0000              ; Mecanismo: los markers (id RANDOM_SLOT_MARKER=210) viven en el BG stream de
  78+ 0000              ; cada room (screen_rooms.asm) — pintados en plantillas, propagados a siblings
  79+ 0000              ; via auto-sync de la library. El engine los trata como ghost: skipea render
  80+ 0000              ; en sprLoop y collision en bcmLoop. UpdateRandomPickup, en cada transicion:
  81+ 0000              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
  82+ 0000              ;      id=210. Acumula (charX, charY) en RandomSlotList.
  83+ 0000              ;   2. RNG sobre count: elige un slot.
  84+ 0000              ;   3. RNG sobre PROB_*_END: rolea tipo (life/health/stamina/none).
  85+ 0000              ;   4. Si type != none: rellena RandomSyntheticEntry con la pickup elegida en
  86+ 0000              ;      la posicion del slot. Si type == none o count == 0: marca inactiva ($FE).
  87+ 0000              ;
  88+ 0000              ; pkDrawLoop renderiza RandomSyntheticEntry como pickup adicional al final.
  89+ 0000              ; CheckPickupCollect testea AABB y dispatcha al GiveX al final.
  90+ 0000
  91+ 0000              ; SlotList: hasta RANDOM_SLOT_MAX pares (charX, charY) de markers encontrados
  92+ 0000              ; en la sala actual. SlotCount = cuantos slots validos hay.
  93+ 0000              RandomSlotCount         EQU TownGateEndDrawn + 1            ; 0..RANDOM_SLOT_MAX
  94+ 0000              RandomSlotList          EQU RandomSlotCount + 1             ; RANDOM_SLOT_MAX * 2 = 8 bytes (charX,charY)
  95+ 0000
  96+ 0000              ; RandomSyntheticEntry: 7 bytes con formato de PickupTable entry. Vive en RAM
  97+ 0000              ; para que pkDrawLoop/cpLoop puedan modificarla. mapX=$FE = inactivo.
  98+ 0000              RandomSynthMapX         EQU RandomSlotList + (4 * 2)        ; mapX (=$FE inactivo)
  99+ 0000              RandomSynthMapY         EQU RandomSynthMapX + 1
 100+ 0000              RandomSynthPtr          EQU RandomSynthMapY + 1             ; DEFW (BgGfx_<type>)
 101+ 0000              RandomSynthCharX        EQU RandomSynthPtr + 2
 102+ 0000              RandomSynthCharY        EQU RandomSynthCharX + 1
 103+ 0000              RandomSynthTint         EQU RandomSynthCharY + 1            ; 255 = sin tint
 104+ 0000              ; Attr byte raw extraido del sprite al activar el synth. Lo usa
 105+ 0000              ; PaintSynthPickupAttrs para pintar los 4 chars del 2x2 sin pasar por el
 106+ 0000              ; remap dia/noche → respeta el color que el usuario puso en el BG editor.
 107+ 0000              RandomSynthAttr         EQU RandomSynthTint + 1
 108+ 0000
 109+ 0000              ; --- Roulette: estado del ciclado del random pickup tipo "ruleta" ---
 110+ 0000              ; RouletteActive=1 mientras el synth pickup esta en modo roulette (cicla
 111+ 0000              ; tipos cada ROULETTE_CYCLE_FRAMES). UpdateRoulette tickea el counter y al
 112+ 0000              ; expirar avanza idx en RouletteOrder, recarga sprite + attr del nuevo tipo.
 113+ 0000              RouletteActive          EQU RandomSynthAttr + 1            ; 0=off, 1=on
 114+ 0000              RouletteIdx             EQU RouletteActive + 1             ; 0..ROULETTE_ORDER_LEN-1
 115+ 0000              RouletteFrameCounter    EQU RouletteIdx + 1                ; tick-down
 116+ 0000
 117+ 0000              ; --- Magic Compass: power-up que muestra ruta exacta sala-a-sala ---
 118+ 0000              ; Recogido por el player (ID34, "compass pickup"). Mientras MagicCompassTimer>0:
 119+ 0000              ;   - DrawCompass override: flecha apunta a la salida correcta (BFS reverse
 120+ 0000              ;     desde ObjectiveScreen hasta CurrentScreen via ScreenGapsTable).
 121+ 0000              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en los ultimos 5s).
 122+ 0000              ;   - SFX: jingle al recoger + tick heartbeat 1/s (2/s en warning).
 123+ 0000              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
 124+ 0000              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
 125+ 0000              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
 126+ 0000              ;
 127+ 0000              ; Cold-ish: leido cada frame mientras activo, no-op en frames inactivos.
 128+ 0000              ; 8 bytes total. Variables_lo.asm justifica la zona contended porque el
 129+ 0000              ; coste real son 3 lecturas/frame (timer + path_dir + blink_phase) ~= 30 T.
 130+ 0000              MagicCompassTimer       EQU RouletteFrameCounter + 1       ; DEFW. 0 = inactivo
 131+ 0000              MagicCompassPathDir     EQU MagicCompassTimer + 2          ; 0=N,1=E,2=S,3=W,$FF=no path
 132+ 0000              MagicCompassPathDirty   EQU MagicCompassPathDir + 1        ; 1 = recalcular en update
 133+ 0000              MagicCompassBlinkPhase  EQU MagicCompassPathDirty + 1      ; counter blink (0..255)
 134+ 0000              MagicCompassTickCounter EQU MagicCompassBlinkPhase + 1     ; frames hasta sig. AY tick
 135+ 0000              MagicCompassJingleIdx   EQU MagicCompassTickCounter + 1    ; 0..N-1 activo, $FF inactivo
 136+ 0000              MagicCompassJingleFrames EQU MagicCompassJingleIdx + 1     ; frames hasta sig. nota
 137+ 0000
 138+ 0000              ; --- Magic compass BFS scratch: cola + visited bitmap ---
 139+ 0000              ; Solo se accede en transicion de sala (cuando MagicCompassPathDirty=1) →
 140+ 0000              ; cold path. Ubicado en zona contended (slot 1) sin penalty perceptible:
 141+ 0000              ; ~150 accesos en una BFS típica × ~5 T cada uno = <1 ms.
 142+ 0000              ; Cola de 64 entradas (sid 1 byte). Wrap mod 64. Si overflow → fallback.
 143+ 0000              MagicCompassBfsQueue     EQU MagicCompassJingleFrames + 1   ; DEFS 64
 144+ 0000              MagicCompassBfsHead      EQU MagicCompassBfsQueue + 64      ; uint8 (wrap mod 64)
 145+ 0000              MagicCompassBfsTail      EQU MagicCompassBfsHead + 1        ; uint8 (wrap mod 64)
 146+ 0000              MagicCompassVisited      EQU MagicCompassBfsTail + 1        ; DEFS 32 (bitmap 256 sids)
 147+ 0000
 148+ 0000              LOW_RAM_END         EQU MagicCompassVisited + 32
 149+ 0000              LOW_RAM_SIZE        EQU LOW_RAM_END - LOW_RAM_BASE
 150+ 0000
# file closed: variables_lo.asm
  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD 25 6A         CALL InitPaging
  34  6007 CD BD 9B         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 E8 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 28 03         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; RandomSynthMapX = $FE (inactivo: no hay random pickup spawneado al boot).
  62  602B                  ; MagicCompassJingleIdx = $FF (inactivo). MagicCompassPathDir = $FF (no path).
  63  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  64  602B 3E FF            LD A, $FF
  65  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  66  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  67  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  68  6036 32 C5 5F         LD (MagicCompassJingleIdx), A
  69  6039 32 C1 5F         LD (MagicCompassPathDir), A
  70  603C 3E FE            LD A, $FE
  71  603E 32 B4 5F         LD (RandomSynthMapX), A
  72  6041
  73  6041                  ; Inicializar sistema de pantallas
  74  6041 CD 4E CC         CALL InitGameState      ; Reset variables de gameplay (idempotente)
  75  6044 CD 9C CF         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  76  6047 CD AB A1         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  77  604A CD 68 E5         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  78  604D CD 0A C0         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  79  6050 CD 79 F1         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  80  6053                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  81  6053
  82  6053 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  83  6055 FB               EI                      ; Habilitar interrupciones
  84  6056 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  85  6058 32 4A 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
  86  605B C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
  87  605E
  88  605E                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
  89  605E                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
  90  605E                  ; contention pero solo durante la cinematica final, una vez por partida —
  91  605E                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
  92  605E                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
  93  605E                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
  94  605E                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
  95  605E                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
  96  605E                  INCLUDE "town_gate_cutscene.asm"
# file opened: town_gate_cutscene.asm
   1+ 605E              ; ==============================================================================
   2+ 605E              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 605E              ; ==============================================================================
   4+ 605E              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 605E              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 605E              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 605E              ;
   8+ 605E              ; Esquema de fases:
   9+ 605E              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 605E              ;   2 ARM_IN       arm aparece, pausa
  11+ 605E              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 605E              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 605E              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 605E              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 605E              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 605E              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 605E              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 605E              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 605E              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 605E              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 605E              ;  13 END_HOLD     "The End" sprite hold
  22+ 605E              ;  14 BLACK        wipe a negro + hold
  23+ 605E              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 605E              ;
  25+ 605E              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 605E              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 605E              ; ==============================================================================
  28+ 605E
  29+ 605E              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 605E              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 605E              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 605E              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 605E              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 605E              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 605E              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 605E              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 605E              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 605E              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 605E              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 605E
  41+ 605E              ; --- Posiciones (pixel) ---
  42+ 605E              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 605E              TGCS_ANCHOR1_Y         EQU 80
  44+ 605E              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 605E              TGCS_END_CHARY         EQU 4
  46+ 605E              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 605E
  48+ 605E              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 605E              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 605E              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 605E              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 605E              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 605E              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 605E              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 605E              TGCS_ARM_PX_X          EQU 136
  56+ 605E              TGCS_ARM_PX_Y          EQU 64
  57+ 605E              TGCS_FINGER_PX_X       EQU 136
  58+ 605E              TGCS_FINGER_PX_Y       EQU 56
  59+ 605E
  60+ 605E              ; --- Phase enum ---
  61+ 605E              TGP_IDLE               EQU 0
  62+ 605E              TGP_LOCK               EQU 1
  63+ 605E              TGP_ARM_IN             EQU 2
  64+ 605E              TGP_FINGER_IN          EQU 3
  65+ 605E              TGP_SHAKE              EQU 4
  66+ 605E              TGP_FINGER_PULSE       EQU 5
  67+ 605E              TGP_FINGER_OUT         EQU 6
  68+ 605E              TGP_ARM_HOLD           EQU 7
  69+ 605E              TGP_ARM_OUT            EQU 8
  70+ 605E              TGP_PLAYER_TURN        EQU 9
  71+ 605E              TGP_PLAYER_HIDE        EQU 10
  72+ 605E              TGP_PLAYER_FRAMED      EQU 11
  73+ 605E              TGP_PLAYER_EXIT        EQU 12
  74+ 605E              TGP_END_HOLD           EQU 13
  75+ 605E              TGP_BLACK              EQU 14
  76+ 605E              TGP_CREDITS            EQU 15
  77+ 605E              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ 605E              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ 605E
  80+ 605E              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ 605E                                                ; check dinamico de "todos los nasties dead".
  82+ 605E                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ 605E                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ 605E                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ 605E
  86+ 605E              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ 605E              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ 605E              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ 605E              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ 605E
  91+ 605E              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ 605E              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ 605E              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ 605E              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ 605E              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ 605E              ;
  97+ 605E              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ 605E              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ 605E              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ 605E              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ 605E              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ 605E              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ 605E              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
