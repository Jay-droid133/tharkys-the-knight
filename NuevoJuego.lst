4912+ BA1F              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4913+ BA1F              ; ==============================================================================
4914+ BA1F              UpdateEnemySpeed:
4915+ BA1F 3A 21 BD         LD A, (DayCycleCount)
4916+ BA22 3D               DEC A                               ; 0-based index
4917+ BA23 FE 0A            CP 10
4918+ BA25 38 02            JR C, .uesOk
4919+ BA27 3E 09            LD A, 9                             ; Cap en indice 9
4920+ BA29              .uesOk:
4921+ BA29 F5               PUSH AF                             ; Guardar indice para tabla de anim
4922+ BA2A 21 4D BA         LD HL, EnemySpeedTable
4923+ BA2D 5F               LD E, A
4924+ BA2E 16 00            LD D, 0
4925+ BA30 19               ADD HL, DE
4926+ BA31 7E               LD A, (HL)                          ; A = velocidad × 2
4927+ BA32                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4928+ BA32 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4929+ BA34 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4930+ BA36                  ; Hay fraccion .5: alternar +1 en frames impares
4931+ BA36 47               LD B, A                             ; B = parte entera
4932+ BA37 3A 9D 81         LD A, (GameFrameCounter)
4933+ BA3A E6 01            AND 1                               ; 0 en par, 1 en impar
4934+ BA3C 80               ADD A, B                            ; Sumar 0 o 1
4935+ BA3D              .uesNoFrac:
4936+ BA3D 32 5A 8D         LD (CurrentEnemySpeed), A
4937+ BA40                  ; Leer delay de animacion para este ciclo
4938+ BA40 F1               POP AF                              ; A = indice 0-based
4939+ BA41 21 57 BA         LD HL, EnemyAnimDelayTable
4940+ BA44 5F               LD E, A
4941+ BA45 16 00            LD D, 0
4942+ BA47 19               ADD HL, DE
4943+ BA48 7E               LD A, (HL)
4944+ BA49 32 5B 8D         LD (CurrentEnemyAnimDelay), A
4945+ BA4C C9               RET
4946+ BA4D
4947+ BA4D              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4948+ BA4D              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4949+ BA4D              EnemySpeedTable:
4950+ BA4D 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4951+ BA4E 05               DEFB 5                              ; Ciclo 2: 2.5px
4952+ BA4F 06               DEFB 6                              ; Ciclo 3: 3px
4953+ BA50 07               DEFB 7                              ; Ciclo 4: 3.5px
4954+ BA51 08               DEFB 8                              ; Ciclo 5: 4px
4955+ BA52 09               DEFB 9                              ; Ciclo 6: 4.5px
4956+ BA53 0A               DEFB 10                             ; Ciclo 7: 5px
4957+ BA54 0B               DEFB 11                             ; Ciclo 8: 5.5px
4958+ BA55 0C               DEFB 12                             ; Ciclo 9: 6px
4959+ BA56 0E               DEFB 14                             ; Ciclo 10: 7px
4960+ BA57
4961+ BA57              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4962+ BA57              ; La rata usara la mitad de estos valores
4963+ BA57              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4964+ BA57 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4965+ BA58 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4966+ BA59 03               DEFB 3                              ; Ciclo 3 (era 6)
4967+ BA5A 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4968+ BA5B 02               DEFB 2                              ; Ciclo 5 (era 4)
4969+ BA5C 02               DEFB 2                              ; Ciclo 6 (era 4)
4970+ BA5D 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4971+ BA5E 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4972+ BA5F 01               DEFB 1                              ; Ciclo 9 (era 2)
4973+ BA60 01               DEFB 1                              ; Ciclo 10 (era 2)
