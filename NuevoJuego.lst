1062+ A4C6              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A4C6              ; ==============================================================================
1064+ A4C6              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A4C6              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A4C6              ; ==============================================================================
1067+ A4C6              GetSpriteAddr:
1068+ A4C6                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A4C6                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A4C6 3A 85 8D         LD A, (CurrentPaging)
1071+ A4C9 E6 F8            AND $F8
1072+ A4CB F6 06            OR 6
1073+ A4CD 32 85 8D         LD (CurrentPaging), A
1074+ A4D0 01 FD 7F         LD BC, $7FFD
1075+ A4D3 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A4D5 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A4D8 6F               LD L, A
1078+ A4D9 26 00            LD H, 0
1079+ A4DB 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A4DC 11 B7 E7         LD DE, SpriteFrameTable
1081+ A4DF 19               ADD HL, DE
1082+ A4E0 5E               LD E, (HL)
1083+ A4E1 23               INC HL
1084+ A4E2 56               LD D, (HL)
1085+ A4E3 ED 53 F5 A4      LD (SpriteAddrTemp), DE
1086+ A4E7 3A 85 8D         LD A, (CurrentPaging)
1087+ A4EA E6 F8            AND $F8
1088+ A4EC 32 85 8D         LD (CurrentPaging), A
1089+ A4EF 01 FD 7F         LD BC, $7FFD
1090+ A4F2 ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A4F4 C9               RET
1092+ A4F5
1093+ A4F5 00 00        SpriteAddrTemp: DEFW 0
1094+ A4F7
1095+ A4F7              ; ==============================================================================
1096+ A4F7              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1097+ A4F7              ; ==============================================================================
1098+ A4F7              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1099+ A4F7              ; Salida:   DE = puntero al sprite data
1100+ A4F7              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1101+ A4F7              ; Preserva: IX
1102+ A4F7              ; Destruye: A, HL
1103+ A4F7              ; ==============================================================================
1104+ A4F7              GetOldSpriteAddr:
1105+ A4F7                  ; Paging inline (ver GetSpriteAddr)
1106+ A4F7 3A 85 8D         LD A, (CurrentPaging)
1107+ A4FA E6 F8            AND $F8
1108+ A4FC F6 06            OR 6
1109+ A4FE 32 85 8D         LD (CurrentPaging), A
1110+ A501 01 FD 7F         LD BC, $7FFD
1111+ A504 ED 79            OUT (C), A
1112+ A506 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1113+ A509 6F               LD L, A
1114+ A50A 26 00            LD H, 0
1115+ A50C 29               ADD HL, HL
1116+ A50D 11 B7 E7         LD DE, SpriteFrameTable
1117+ A510 19               ADD HL, DE
1118+ A511 5E               LD E, (HL)
1119+ A512 23               INC HL
1120+ A513 56               LD D, (HL)
1121+ A514 ED 53 7F A4      LD (OldSprAddr), DE
1122+ A518 3A 85 8D         LD A, (CurrentPaging)
1123+ A51B E6 F8            AND $F8
1124+ A51D 32 85 8D         LD (CurrentPaging), A
1125+ A520 01 FD 7F         LD BC, $7FFD
1126+ A523 ED 79            OUT (C), A
1127+ A525 C9               RET
1128+ A526
1129+ A526              ; ==============================================================================
1130+ A526              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A526              ; ==============================================================================
1132+ A526              ; Entrada: A = SpriteID
1133+ A526              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A526              ; Destruye: A, DE, HL
1135+ A526              ; ==============================================================================
1136+ A526              GetSpriteDims:
1137+ A526                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A526                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A526 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A527 26 00            LD H, 0
1141+ A529 3A 85 8D         LD A, (CurrentPaging)
1142+ A52C E6 F8            AND $F8
1143+ A52E F6 06            OR 6
1144+ A530 32 85 8D         LD (CurrentPaging), A
1145+ A533 01 FD 7F         LD BC, $7FFD
1146+ A536 ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A538 29               ADD HL, HL
1148+ A539 11 B7 E7         LD DE, SpriteFrameTable
1149+ A53C 19               ADD HL, DE
1150+ A53D 5E               LD E, (HL)
1151+ A53E 23               INC HL
1152+ A53F 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A540 1A               LD A, (DE)                  ; width_bytes
1154+ A541 87               ADD A, A
1155+ A542 87               ADD A, A
1156+ A543 87               ADD A, A                    ; × 8 = width_px
1157+ A544 47               LD B, A
1158+ A545 13               INC DE
1159+ A546 1A               LD A, (DE)                  ; height_px
1160+ A547 4F               LD C, A
1161+ A548                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A548 78               LD A, B
1163+ A549 32 66 A5         LD (GsdSavedB), A
1164+ A54C 79               LD A, C
1165+ A54D 32 67 A5         LD (GsdSavedC), A
1166+ A550 3A 85 8D         LD A, (CurrentPaging)
1167+ A553 E6 F8            AND $F8
1168+ A555 32 85 8D         LD (CurrentPaging), A
1169+ A558 01 FD 7F         LD BC, $7FFD
1170+ A55B ED 79            OUT (C), A                  ; bank 0 de vuelta
1171+ A55D 3A 66 A5         LD A, (GsdSavedB)
1172+ A560 47               LD B, A
1173+ A561 3A 67 A5         LD A, (GsdSavedC)
1174+ A564 4F               LD C, A
1175+ A565 C9               RET
1176+ A566
1177+ A566 00           GsdSavedB: DEFB 0
1178+ A567 00           GsdSavedC: DEFB 0
1179+ A568
