2986+ AF81                  ; Borde superior: si Y < MIN+KB_SPEED y empujando arriba
2987+ AF81 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2988+ AF83 30 04            JR NC, .moKbYOk
2989+ AF85 CB 7B            BIT 7, E                            ; Delta Y negativo?
2990+ AF87 20 03            JR NZ, .moKbOffscreen               ; Si, empujando arriba → offscreen
2991+ AF89              .moKbYOk:
2992+ AF89 C3 E0 B1         JP .moAnimate
2993+ AF8C              .moKbOffscreen:
2994+ AF8C                  ; Elegir eje de salida por MAGNITUD DEL KNOCKBACK, no por el eje que
2995+ AF8C                  ; cruzo el borde primero. Asi el monster sale por el lado que el
2996+ AF8C                  ; player quiso empujar (eje primario) aunque llegue al borde del eje
2997+ AF8C                  ; secundario un frame antes por drift diagonal.
2998+ AF8C                  ;
2999+ AF8C                  ; |DX| vs |DY|: eje primario = mayor magnitud. En empate, horizontal.
3000+ AF8C DD 7E 06         LD A, (IX+ENT_DELTAX)
3001+ AF8F CB 7F            BIT 7, A
3002+ AF91 28 02            JR Z, .moKbAbsDxOk
3003+ AF93 ED 44            NEG
3004+ AF95              .moKbAbsDxOk:
