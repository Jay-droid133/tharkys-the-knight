4299+ BA61 20 12            JR NZ, .spawnNextSlot
4300+ BA63 CD 7E BA         CALL SpawnOneNasty
4301+ BA66 DD 7E 01         LD A, (IX+ENT_TYPE)
4302+ BA69 B7               OR A
4303+ BA6A 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4304+ BA6C                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4305+ BA6C                  ; (un poco de irregularidad en la cadencia de aparicion).
4306+ BA6C ED 5F            LD A, R
4307+ BA6E E6 07            AND $07
4308+ BA70 32 0C 82         LD (SpawnTimer), A
4309+ BA73 C1               POP BC
4310+ BA74 C9               RET
4311+ BA75              .spawnNextSlot:
4312+ BA75 11 10 00         LD DE, ENT_SIZE
4313+ BA78 DD 19            ADD IX, DE
4314+ BA7A C1               POP BC
4315+ BA7B 10 DF            DJNZ .spawnLoop
4316+ BA7D C9               RET
