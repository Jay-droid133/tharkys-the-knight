# file opened: monster_ai.asm
   1+ 917F              ; ==============================================================================
   2+ 917F              ; MONSTER AI v2 — runtime code (fase 3+)
   3+ 917F              ; ==============================================================================
   4+ 917F              ; DEBE incluirse desde main.asm en bank 2 fijo ($8000-$BFFF), antes del
   5+ 917F              ; limite $C000, porque las rutinas paginan bank 6 en slot 3 y se ejecutarian
   6+ 917F              ; ellas mismas si estuvieran en bank 0.
   7+ 917F              ;
   8+ 917F              ; Patron de paginacion (copiado de LoadRoomToBuffer en paging.asm):
   9+ 917F              ;   1. Guardar IFF (LD A,I + PUSH AF) mientras bank 0 sigue en slot 3
  10+ 917F              ;   2. DI
  11+ 917F              ;   3. Inline page-switch via OUT — NO CALLs intermedios
  12+ 917F              ;   4. Trabajo con bank 6 paginado. Sin PUSH/POP ni CALL (excepto usando
  13+ 917F              ;      un stack temporal en bank 2)
  14+ 917F              ;   5. Inline page-switch de vuelta a bank 0
  15+ 917F              ;   6. POP AF + RET PO / EI + RET
  16+ 917F              ; ==============================================================================
  17+ 917F
  18+ 917F              ; ==============================================================================
  19+ 917F              ; MaiComputeFlowField
  20+ 917F              ; ==============================================================================
  21+ 917F              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 917F              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 917F              ; quedan en $FF).
  24+ 917F              ;
  25+ 917F              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 917F              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 917F              ;
  28+ 917F              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 917F              ; Output: FlowField relleno en bank 6
  30+ 917F              ; Destruye: AF, BC, DE, HL
  31+ 917F              ; ==============================================================================
  32+ 917F              MaiComputeFlowField:
  33+ 917F                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 917F 3A CA 80         LD A, (EntityTable + ENT_POSX)
