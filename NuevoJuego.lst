 716+ A529 77               LD (HL), A
 717+ A52A 18 4F            JR .peScaredSpriteToggle
 718+ A52C              .peShakeActive:
 719+ A52C                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 720+ A52C ED 5F            LD A, R
 721+ A52E E6 03            AND 3
 722+ A530 28 0C            JR Z, .peShakeUp
 723+ A532 3D               DEC A
 724+ A533 28 0F            JR Z, .peShakeDown
 725+ A535 3D               DEC A
 726+ A536 28 12            JR Z, .peShakeLeft
 727+ A538                  ; 3: right
 728+ A538 06 01            LD B, 1
 729+ A53A 0E 00            LD C, 0
 730+ A53C 18 10            JR .peShakeApply
