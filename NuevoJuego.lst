 692+ 63B7              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 693+ 63B7              ; ==============================================================================
 694+ 63B7              ; Itera slots SLOT_NASTY0..SLOT_NASTY0+NUM_NASTIES-1. Devuelve Z si todos
 695+ 63B7              ; TYPE_NONE, NZ si alguno todavia activo. Usado por TGP_WAIT_NASTIES para
 696+ 63B7              ; transicion dinamica a LOCK al terminar todos los puffs.
 697+ 63B7              ; Destruye: A, BC, DE, IX.
 698+ 63B7              ; ==============================================================================
 699+ 63B7              TownGateAllNastiesDeadCheck:
 700+ 63B7 DD 21 4C 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63BB 06 04            LD B, NUM_NASTIES
 702+ 63BD              .tgandcLoop:
 703+ 63BD DD 7E 01         LD A, (IX+ENT_TYPE)
 704+ 63C0 B7               OR A
 705+ 63C1 C0               RET NZ                              ; algun nasty aun activo
 706+ 63C2 11 10 00         LD DE, ENT_SIZE
 707+ 63C5 DD 19            ADD IX, DE
 708+ 63C7 10 F4            DJNZ .tgandcLoop
 709+ 63C9 AF               XOR A                               ; Z = todos TYPE_NONE
 710+ 63CA C9               RET
 711+ 63CB
 712+ 63CB              ; ==============================================================================
 713+ 63CB              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63CB              ; ==============================================================================
 715+ 63CB              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63CB              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63CB              ; y abajo se dibujan normal (XOR).
 718+ 63CB              ;
 719+ 63CB              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63CB              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63CB              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63CB              ;   inferiores que pasan tras el lintel skipped.
 723+ 63CB              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63CB              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63CB              ;   lintel skipped.
 726+ 63CB              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63CB              ;
 728+ 63CB              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63CB              ;     Bank 6 paginado al entrar (caller).
 730+ 63CB              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63CB              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63CB              ; ==============================================================================
 733+ 63CB              PLAYER_H_PX              EQU 21
 734+ 63CB
 735+ 63CB              TownGatePlayerXOR_BiClip:
 736+ 63CB FD 23            INC IY
 737+ 63CD FD 23            INC IY                              ; skip header
 738+ 63CF D5               PUSH DE
 739+ 63D0 CD 31 A1         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 63D3 D1               POP DE
 741+ 63D4 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 63D6 4A               LD C, D                             ; C = current pixel Y
 743+ 63D7              .tgpxbcRow:
 744+ 63D7 79               LD A, C
 745+ 63D8 FE C0            CP 192
 746+ 63DA 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 63DC                                                      ; (sin este clip, NextPixelLine lleva
 748+ 63DC                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 63DC                                                      ; corrompe attrs como flashes raros).
 750+ 63DC FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 63DE 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 63E0 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 63E2 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 63E4                  ; In [120, 151] → skip pixels en esta row
 755+ 63E4 18 0C            JR .tgpxbcAdvance
 756+ 63E6              .tgpxbcDraw:
 757+ 63E6                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 63E6                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 63E6 FD 7E 00         LD A, (IY+0)
 760+ 63E9 AE               XOR (HL)
 761+ 63EA 77               LD (HL), A
 762+ 63EB 23               INC HL
 763+ 63EC FD 7E 01         LD A, (IY+1)
 764+ 63EF AE               XOR (HL)
 765+ 63F0 77               LD (HL), A
 766+ 63F1 2B               DEC HL                              ; back to row start
 767+ 63F2              .tgpxbcAdvance:
 768+ 63F2 FD 23            INC IY
 769+ 63F4 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 63F6 0C               INC C                               ; pixel Y += 1
 771+ 63F7 C5               PUSH BC
 772+ 63F8 CD 9D 9E         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 63FB C1               POP BC
 774+ 63FC 10 D9            DJNZ .tgpxbcRow
 775+ 63FE C9               RET
 776+ 63FF
 777+ 63FF              ; ==============================================================================
 778+ 63FF              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 63FF              ; ==============================================================================
 780+ 63FF              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 63FF              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 63FF              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 63FF              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 63FF              ; ==============================================================================
 785+ 63FF              TownGatePlayerSlideErase:
 786+ 63FF DD 21 DC 80      LD IX, EntityTable
 787+ 6403 DD E5            PUSH IX
 788+ 6405 CD 08 A8         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6408 DD E1            POP IX
 790+ 640A 3A 57 90         LD A, (CurrentPaging)
 791+ 640D E6 F8            AND $F8
 792+ 640F F6 06            OR 6
 793+ 6411 32 57 90         LD (CurrentPaging), A
 794+ 6414 01 FD 7F         LD BC, $7FFD
 795+ 6417 ED 79            OUT (C), A
 796+ 6419 FD 2A 90 A7      LD IY, (OldSprAddr)
 797+ 641D DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 6420 DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 6423 5F               LD E, A
 800+ 6424 CD CB 63         CALL TownGatePlayerXOR_BiClip
 801+ 6427 3A 57 90         LD A, (CurrentPaging)
 802+ 642A E6 F8            AND $F8
 803+ 642C 32 57 90         LD (CurrentPaging), A
 804+ 642F 01 FD 7F         LD BC, $7FFD
 805+ 6432 ED 79            OUT (C), A
 806+ 6434 C9               RET
 807+ 6435
 808+ 6435              TownGatePlayerSlideDraw:
 809+ 6435 DD 21 DC 80      LD IX, EntityTable
 810+ 6439 DD E5            PUSH IX
 811+ 643B CD D7 A7         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 643E DD E1            POP IX
 813+ 6440 3A 57 90         LD A, (CurrentPaging)
 814+ 6443 E6 F8            AND $F8
 815+ 6445 F6 06            OR 6
 816+ 6447 32 57 90         LD (CurrentPaging), A
 817+ 644A 01 FD 7F         LD BC, $7FFD
 818+ 644D ED 79            OUT (C), A
 819+ 644F FD 2A 06 A8      LD IY, (SpriteAddrTemp)
 820+ 6453 3A 0A 82         LD A, (PlayerDrawY)
 821+ 6456 57               LD D, A
 822+ 6457 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 645A 5F               LD E, A
 824+ 645B CD CB 63         CALL TownGatePlayerXOR_BiClip
 825+ 645E 3A 57 90         LD A, (CurrentPaging)
 826+ 6461 E6 F8            AND $F8
 827+ 6463 32 57 90         LD (CurrentPaging), A
 828+ 6466 01 FD 7F         LD BC, $7FFD
 829+ 6469 ED 79            OUT (C), A
 830+ 646B                  ; Update OLD = current
 831+ 646B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 646E DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 6471 3A 0A 82         LD A, (PlayerDrawY)
 834+ 6474 DD 77 0D         LD (IX+ENT_OLDY), A
 835+ 6477 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 836+ 647A DD 77 0E         LD (IX+ENT_OLDSPRID), A
 837+ 647D C9               RET
 838+ 647E
 839+ 647E              ; ==============================================================================
 840+ 647E              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 647E              ; ==============================================================================
 842+ 647E              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 647E              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 647E              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 647E              ; 2. Compute new offset random.
 846+ 647E              ; 3. Draw at new offset.
 847+ 647E              ; Destruye: AF, BC, DE, HL, IX.
 848+ 647E              ; ==============================================================================
 849+ 647E              TownGateShakeStep:
 850+ 647E CD C6 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 6481 CD E1 64         CALL TownGateDrawFingerShifted
 852+ 6484                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 6484 ED 5F            LD A, R
 854+ 6486 E6 03            AND $03
 855+ 6488 21 A9 64         LD HL, .tgssJitterTable
 856+ 648B 5F               LD E, A
 857+ 648C 16 00            LD D, 0
 858+ 648E 19               ADD HL, DE
 859+ 648F 7E               LD A, (HL)
 860+ 6490 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 6493 3A D9 80         LD A, (GameFrameCounter)
 862+ 6496 E6 03            AND $03
 863+ 6498 21 A9 64         LD HL, .tgssJitterTable
 864+ 649B 5F               LD E, A
 865+ 649C 16 00            LD D, 0
 866+ 649E 19               ADD HL, DE
 867+ 649F 7E               LD A, (HL)
 868+ 64A0 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 64A3 CD C6 64         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 64A6 C3 E1 64         JP TownGateDrawFingerShifted
 871+ 64A9              .tgssJitterTable:
 872+ 64A9 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 64AD
 874+ 64AD              ; ==============================================================================
 875+ 64AD              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 64AD              ; ==============================================================================
 877+ 64AD              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 64AD              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 64AD              ; ==============================================================================
 880+ 64AD              TownGateShakeRestore:
 881+ 64AD CD C6 64         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 64B0 CD E1 64         CALL TownGateDrawFingerShifted
 883+ 64B3 AF               XOR A
 884+ 64B4 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 64B7 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 64BA 11 E3 E5         LD DE, BgGfx_arm
 887+ 64BD CD 8A D3         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 64C0 11 30 E6         LD DE, BgGfx_finger
 889+ 64C3 C3 8A D3         JP RedrawPickupByPtr
 890+ 64C6
 891+ 64C6              ; ==============================================================================
 892+ 64C6              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 64C6              ; ==============================================================================
 894+ 64C6              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 64C6              ; Destruye: AF, BC, DE, HL, IX.
 896+ 64C6              ; ==============================================================================
 897+ 64C6              TownGateDrawArmShifted:
 898+ 64C6 21 E3 E5         LD HL, BgGfx_arm
 899+ 64C9 3E 03            LD A, 3
 900+ 64CB CD D2 90         CALL LoadBgSpriteToBuffer
 901+ 64CE 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 64D1 47               LD B, A
 903+ 64D2 3E 88            LD A, TGCS_ARM_PX_X
 904+ 64D4 80               ADD A, B
 905+ 64D5 5F               LD E, A
 906+ 64D6 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 64D9 47               LD B, A
 908+ 64DA 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 64DC 80               ADD A, B
 910+ 64DD 57               LD D, A
 911+ 64DE C3 FC 64         JP DrawBgSpriteAnyXorAtPixel
 912+ 64E1
 913+ 64E1              ; ==============================================================================
 914+ 64E1              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 64E1              ; ==============================================================================
 916+ 64E1              TownGateDrawFingerShifted:
 917+ 64E1 21 30 E6         LD HL, BgGfx_finger
 918+ 64E4 3E 03            LD A, 3
 919+ 64E6 CD D2 90         CALL LoadBgSpriteToBuffer
 920+ 64E9 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 64EC 47               LD B, A
 922+ 64ED 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 64EF 80               ADD A, B
 924+ 64F0 5F               LD E, A
 925+ 64F1 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 64F4 47               LD B, A
 927+ 64F5 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 64F7 80               ADD A, B
 929+ 64F8 57               LD D, A
 930+ 64F9 C3 FC 64         JP DrawBgSpriteAnyXorAtPixel
 931+ 64FC
 932+ 64FC              ; ==============================================================================
 933+ 64FC              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 64FC              ; ==============================================================================
 935+ 64FC              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 64FC              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 64FC              ;     E = pixel X (0..255).
 938+ 64FC              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 64FC              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 64FC              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 64FC              ; Destruye: AF, BC, DE, HL, IX.
 942+ 64FC              ; ==============================================================================
 943+ 64FC              DrawBgSpriteAnyXorAtPixel:
 944+ 64FC DD 21 0A 89      LD IX, BgSpriteBuffer
 945+ 6500 DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 6503 B7               OR A
 947+ 6504 C8               RET Z
 948+ 6505 32 5F 65         LD (.dbsaHeight), A
 949+ 6508 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 650B E6 7F            AND $7F
 951+ 650D 32 60 65         LD (.dbsaWidth), A
 952+ 6510 DD 23            INC IX
 953+ 6512 DD 23            INC IX                              ; -> pixel data
 954+ 6514 7B               LD A, E
 955+ 6515 E6 07            AND $07
 956+ 6517 32 61 65         LD (.dbsaShift), A
 957+ 651A 7B               LD A, E
 958+ 651B E6 F8            AND $F8
 959+ 651D 5F               LD E, A
 960+ 651E CD 31 A1         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 6521              .dbsaRow:
 962+ 6521 E5               PUSH HL
 963+ 6522 3A 60 65         LD A, (.dbsaWidth)
 964+ 6525 47               LD B, A                             ; B = width counter
 965+ 6526 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 6528              .dbsaByte:
 967+ 6528 DD 7E 00         LD A, (IX+0)
 968+ 652B 2F               CPL                                 ; un-invert
 969+ 652C 57               LD D, A                             ; D = sprite byte
 970+ 652D 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 652F 3A 61 65         LD A, (.dbsaShift)
 972+ 6532 B7               OR A
 973+ 6533 28 09            JR Z, .dbsaNoShift
 974+ 6535 C5               PUSH BC
 975+ 6536 47               LD B, A
 976+ 6537              .dbsaShiftLoop:
 977+ 6537 CB 3A            SRL D
 978+ 6539 CB 1B            RR E
 979+ 653B 10 FA            DJNZ .dbsaShiftLoop
 980+ 653D C1               POP BC
 981+ 653E              .dbsaNoShift:
 982+ 653E 7A               LD A, D
 983+ 653F B1               OR C                                ; combinar con carry previo
 984+ 6540 AE               XOR (HL)
 985+ 6541 77               LD (HL), A
 986+ 6542 23               INC HL
 987+ 6543 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 6544 DD 23            INC IX
 989+ 6546 10 E0            DJNZ .dbsaByte
 990+ 6548                  ; Byte final (carry) si shift > 0
 991+ 6548 3A 61 65         LD A, (.dbsaShift)
 992+ 654B B7               OR A
 993+ 654C 28 03            JR Z, .dbsaNoFinal
 994+ 654E 79               LD A, C
 995+ 654F AE               XOR (HL)
 996+ 6550 77               LD (HL), A
 997+ 6551              .dbsaNoFinal:
 998+ 6551 E1               POP HL
 999+ 6552 CD 9D 9E         CALL NextPixelLine
1000+ 6555 3A 5F 65         LD A, (.dbsaHeight)
1001+ 6558 3D               DEC A
1002+ 6559 32 5F 65         LD (.dbsaHeight), A
1003+ 655C 20 C3            JR NZ, .dbsaRow
1004+ 655E C9               RET
1005+ 655F 00           .dbsaHeight: DEFB 0
1006+ 6560 00           .dbsaWidth:  DEFB 0
1007+ 6561 00           .dbsaShift:  DEFB 0
1008+ 6562
1009+ 6562              ; ==============================================================================
1010+ 6562              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 6562              ; ==============================================================================
1012+ 6562              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 6562              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 6562              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 6562              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 6562              ; ==============================================================================
1017+ 6562              TownGateExitStep:
1018+ 6562 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 6565 3C               INC A
1020+ 6566 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 6569 FE 02            CP TGCS_T_EXIT_STEP
1022+ 656B D8               RET C                               ; aun no toca step
1023+ 656C AF               XOR A
1024+ 656D 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 6570                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 6570 DD 21 DC 80      LD IX, EntityTable
1027+ 6574 DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 6577 3C               INC A
1029+ 6578 DD 77 04         LD (IX+ENT_POSY), A
1030+ 657B 32 0A 82         LD (PlayerDrawY), A
1031+ 657E 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 6581 EE 01            XOR 1                               ; toggle 0/1
1033+ 6583 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 6586 47               LD B, A
1035+ 6587 3E 0E            LD A, SPRID_WALK_S
1036+ 6589 80               ADD A, B
1037+ 658A DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 658D                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 658D                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 658D                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 658D                  ; part1 attrs ni de door attrs.
1042+ 658D CD FF 63         CALL TownGatePlayerSlideErase
1043+ 6590 C3 35 64         JP TownGatePlayerSlideDraw          ; tail call
1044+ 6593
1045+ 6593              ; ==============================================================================
1046+ 6593              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
1047+ 6593              ; ==============================================================================
1048+ 6593              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
1049+ 6593              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1050+ 6593              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1051+ 6593              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1052+ 6593              ; Destruye: AF, BC, DE, HL, IX.
1053+ 6593              ; ==============================================================================
1054+ 6593              TownGateDrawTheEnd:
1055+ 6593 21 3E E6         LD HL, BgGfx_the_end
1056+ 6596 3E 03            LD A, 3
1057+ 6598 CD D2 90         CALL LoadBgSpriteToBuffer
1058+ 659B DD 21 0A 89      LD IX, BgSpriteBuffer
1059+ 659F 06 0B            LD B, TGCS_END_CHARX
1060+ 65A1 0E 04            LD C, TGCS_END_CHARY
1061+ 65A3 AF               XOR A
1062+ 65A4 32 89 DD         LD (BgSpriteIsHouse), A
1063+ 65A7 32 9A CE         LD (CurrentTintVar), A              ; sin tint
1064+ 65AA C3 90 CD         JP DrawBgGfxSprite
1065+ 65AD
1066+ 65AD              ; ==============================================================================
1067+ 65AD              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1068+ 65AD              ; ==============================================================================
1069+ 65AD              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1070+ 65AD              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1071+ 65AD              ; quedara visible sobre fondo negro.
1072+ 65AD              ; ==============================================================================
1073+ 65AD              TownGateWipeBlack:
1074+ 65AD 21 00 40         LD HL, $4000
1075+ 65B0 11 01 40         LD DE, $4001
1076+ 65B3 01 FF 17         LD BC, $17FF
1077+ 65B6 36 00            LD (HL), 0
1078+ 65B8 ED B0            LDIR
1079+ 65BA 21 00 58         LD HL, $5800
1080+ 65BD 11 01 58         LD DE, $5801
1081+ 65C0 01 FF 02         LD BC, $02FF
1082+ 65C3 36 00            LD (HL), $00                        ; ink black, paper black
1083+ 65C5 ED B0            LDIR
1084+ 65C7 C9               RET
1085+ 65C8
1086+ 65C8              ; ==============================================================================
1087+ 65C8              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1088+ 65C8              ; ==============================================================================
1089+ 65C8              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1090+ 65C8              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1091+ 65C8              ; (white ink, black paper, bright) para todo el area de texto.
1092+ 65C8              ; ==============================================================================
1093+ 65C8              TownGateDrawCredits:
1094+ 65C8                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1095+ 65C8 21 00 58         LD HL, $5800
1096+ 65CB 11 01 58         LD DE, $5801
1097+ 65CE 01 FF 02         LD BC, $02FF
1098+ 65D1 36 47            LD (HL), $47
1099+ 65D3 ED B0            LDIR
1100+ 65D5                  ; Iterar credits
1101+ 65D5 21 25 66         LD HL, TownGateCreditsData
1102+ 65D8              .tgdcLoop:
1103+ 65D8 7E               LD A, (HL)
1104+ 65D9 FE FF            CP $FF
1105+ 65DB C8               RET Z
1106+ 65DC 57               LD D, A                             ; D = row
1107+ 65DD 23               INC HL
1108+ 65DE 7E               LD A, (HL)
1109+ 65DF 5F               LD E, A                             ; E = col
1110+ 65E0 23               INC HL                              ; HL → string
1111+ 65E1 CD E6 65         CALL PrintStringFontAt
1112+ 65E4 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1113+ 65E6
1114+ 65E6              ; ==============================================================================
1115+ 65E6              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1116+ 65E6              ; ==============================================================================
1117+ 65E6              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1118+ 65E6              ; siguiente byte tras el 0 (para que el caller siga iterando).
1119+ 65E6              ; Destruye: AF, BC, DE, HL.
1120+ 65E6              ; OUT: HL apunta al byte tras el 0 terminador.
1121+ 65E6              ; ==============================================================================
1122+ 65E6              PrintStringFontAt:
1123+ 65E6              .psfaCharLoop:
1124+ 65E6 7E               LD A, (HL)
1125+ 65E7 23               INC HL
1126+ 65E8 B7               OR A
1127+ 65E9 C8               RET Z                               ; fin de string
1128+ 65EA E5               PUSH HL
1129+ 65EB D5               PUSH DE
1130+ 65EC CD F4 65         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1131+ 65EF D1               POP DE
1132+ 65F0 E1               POP HL
1133+ 65F1 1C               INC E                               ; siguiente columna
1134+ 65F2 18 F2            JR .psfaCharLoop
1135+ 65F4
1136+ 65F4              ; ==============================================================================
1137+ 65F4              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1138+ 65F4              ; ==============================================================================
1139+ 65F4              ; D = row (0..23), E = col (0..31), A = ASCII char.
1140+ 65F4              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1141+ 65F4              ;   y = row * 8, x = col * 8
1142+ 65F4              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1143+ 65F4              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1144+ 65F4              ; Destruye: AF, BC, DE, HL.
1145+ 65F4              ; ==============================================================================
1146+ 65F4              DrawCharFontAt:
1147+ 65F4 D5               PUSH DE
1148+ 65F5                  ; HL = $3C00 + char * 8
1149+ 65F5 6F               LD L, A
1150+ 65F6 26 00            LD H, 0
1151+ 65F8 29               ADD HL, HL
1152+ 65F9 29               ADD HL, HL
1153+ 65FA 29               ADD HL, HL
1154+ 65FB 01 00 3C         LD BC, $3C00
1155+ 65FE 09               ADD HL, BC
1156+ 65FF D1               POP DE
1157+ 6600                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1158+ 6600 E5               PUSH HL                             ; save font ptr
1159+ 6601 7A               LD A, D
1160+ 6602 87               ADD A, A
1161+ 6603 87               ADD A, A
1162+ 6604 87               ADD A, A                            ; A = row * 8 = pixel Y
1163+ 6605 57               LD D, A
1164+ 6606 7B               LD A, E
1165+ 6607 87               ADD A, A
1166+ 6608 87               ADD A, A
1167+ 6609 87               ADD A, A                            ; A = col * 8 = pixel X
1168+ 660A 5F               LD E, A
1169+ 660B CD 31 A1         CALL CalcPixelAddr                  ; HL = VRAM addr
1170+ 660E EB               EX DE, HL                           ; DE = VRAM addr
1171+ 660F E1               POP HL                              ; HL = font ptr
1172+ 6610 06 08            LD B, 8
1173+ 6612              .dcfaLoop:
1174+ 6612 7E               LD A, (HL)
1175+ 6613 12               LD (DE), A
1176+ 6614 23               INC HL
1177+ 6615 14               INC D                               ; siguiente scan line (within char)
1178+ 6616 10 FA            DJNZ .dcfaLoop
1179+ 6618 C9               RET
1180+ 6619
