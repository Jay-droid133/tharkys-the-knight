 705+ E83F              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 706+ E83F              ; A = codigo ASCII, E = columna (0-31)
 707+ E83F              DrawHudCharRow0:
 708+ E83F 6F               LD L, A
 709+ E840 26 00            LD H, 0
 710+ E842 29               ADD HL, HL
 711+ E843 29               ADD HL, HL
 712+ E844 29               ADD HL, HL
 713+ E845 01 00 3C         LD BC, $3C00
 714+ E848 09               ADD HL, BC                  ; HL = font data
 715+ E849 16 40            LD D, $40                   ; Tercio 0, scan line 0
 716+ E84B 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 717+ E84C 5F               LD E, A                     ; DE = dir VRAM
 718+ E84D 06 08            LD B, 8
