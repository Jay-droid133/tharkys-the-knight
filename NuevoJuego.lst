 617+ DC4D              ; ==============================================================================
 618+ DC4D              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 619+ DC4D              ; ==============================================================================
 620+ DC4D              ; Llamar cada frame desde el main loop.
 621+ DC4D              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 622+ DC4D              ; ==============================================================================
 623+ DC4D              DrawPlazaClock:
 624+ DC4D 3A D8 8F         LD A, (PlazaClockActive)
 625+ DC50 B7               OR A
 626+ DC51 C8               RET Z
 627+ DC52
 628+ DC52                  ; --- Calcular posicion actual de las agujas ---
 629+ DC52 3A D4 D7         LD A, (GameHours)
 630+ DC55 FE 0C            CP 12
 631+ DC57 38 02            JR C, .pCalcHourOk
 632+ DC59 D6 0C            SUB 12
 633+ DC5B              .pCalcHourOk:
 634+ DC5B 57               LD D, A                     ; D = display hour (0-11)
 635+ DC5C 3A D3 D7         LD A, (GameMinutes)
 636+ DC5F 1E 00            LD E, 0
 637+ DC61              .pCalcDiv5:
 638+ DC61 FE 05            CP 5
 639+ DC63 38 05            JR C, .pCalcMinOk
 640+ DC65 D6 05            SUB 5
 641+ DC67 1C               INC E
 642+ DC68 18 F7            JR .pCalcDiv5
 643+ DC6A              .pCalcMinOk:
 644+ DC6A                  ; D = hour pos (0-11), E = minute pos (0-11)
 645+ DC6A
 646+ DC6A                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 647+ DC6A 3A BE DC         LD A, (PlazaLastHour)
 648+ DC6D BA               CP D
 649+ DC6E 20 05            JR NZ, .pNeedsRedraw
 650+ DC70 3A BF DC         LD A, (PlazaLastMin)
 651+ DC73 BB               CP E
 652+ DC74 C8               RET Z                       ; sin cambio → no redibujar
 653+ DC75
 654+ DC75              .pNeedsRedraw:
 655+ DC75 7A               LD A, D
 656+ DC76 32 BE DC         LD (PlazaLastHour), A
 657+ DC79 7B               LD A, E
 658+ DC7A 32 BF DC         LD (PlazaLastMin), A
 659+ DC7D
 660+ DC7D                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 661+ DC7D                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 662+ DC7D DD 21 AE 8C      LD IX, PlazaClockPixels
 663+ DC81 FD 21 DB 8F      LD IY, PlazaScanAddrs
 664+ DC85 06 10            LD B, 16
 665+ DC87              .faceRow:
 666+ DC87 FD 6E 00         LD L, (IY+0)
 667+ DC8A FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 668+ DC8D DD 7E 00         LD A, (IX+0)
 669+ DC90 2F               CPL                         ; des-invertir (dato CPL'd)
 670+ DC91 77               LD (HL), A                  ; byte izquierdo
 671+ DC92 23               INC HL
 672+ DC93 DD 7E 01         LD A, (IX+1)
 673+ DC96 2F               CPL
 674+ DC97 77               LD (HL), A                  ; byte derecho
 675+ DC98 DD 23            INC IX
 676+ DC9A DD 23            INC IX
 677+ DC9C FD 23            INC IY
 678+ DC9E FD 23            INC IY
 679+ DCA0 10 E5            DJNZ .faceRow
 680+ DCA2
 681+ DCA2                  ; --- Aguja de horas ---
 682+ DCA2 3A BE DC         LD A, (PlazaLastHour)
 683+ DCA5 21 D0 D8         LD HL, HourHandPtrs
 684+ DCA8 CD C0 DC         CALL DrawPlazaHandLine
 685+ DCAB
 686+ DCAB                  ; --- Aguja de minutos ---
 687+ DCAB 3A BF DC         LD A, (PlazaLastMin)
 688+ DCAE 21 EC D7         LD HL, MinHandPtrs
 689+ DCB1 CD C0 DC         CALL DrawPlazaHandLine
 690+ DCB4
 691+ DCB4                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 692+ DCB4 21 E9 8F         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 693+ DCB7 7E               LD A, (HL)
 694+ DCB8 23               INC HL
 695+ DCB9 66               LD H, (HL)
 696+ DCBA 6F               LD L, A                     ; HL = dir VRAM scan line 7
 697+ DCBB CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 698+ DCBD C9               RET
 699+ DCBE
 700+ DCBE              ; Variables locales reloj plaza
 701+ DCBE FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 702+ DCBF FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 703+ DCC0
 704+ DCC0              ; ==============================================================================
 705+ DCC0              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 706+ DCC0              ; ==============================================================================
 707+ DCC0              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 708+ DCC0              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 709+ DCC0              ; a posiciones relativas y las busca en PlazaScanAddrs.
 710+ DCC0              ; ==============================================================================
 711+ DCC0              DrawPlazaHandLine:
 712+ DCC0                  ; Indexar en tabla de punteros
 713+ DCC0 87               ADD A, A
 714+ DCC1 4F               LD C, A
 715+ DCC2 06 00            LD B, 0
 716+ DCC4 09               ADD HL, BC
 717+ DCC5 7E               LD A, (HL)
 718+ DCC6 23               INC HL
 719+ DCC7 66               LD H, (HL)
 720+ DCC8 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 721+ DCC9
 722+ DCC9              .pxLoop:
 723+ DCC9 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 724+ DCCA B7               OR A
 725+ DCCB C8               RET Z
 726+ DCCC
 727+ DCCC                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 728+ DCCC 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 729+ DCCD 23               INC HL
 730+ DCCE 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 731+ DCCF 23               INC HL
 732+ DCD0 56               LD D, (HL)                  ; D = mask
 733+ DCD1 23               INC HL
 734+ DCD2 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 735+ DCD3
 736+ DCD3                  ; --- Calcular scanLine (0-15) ---
 737+ DCD3 78               LD A, B
 738+ DCD4 E6 07            AND $07                     ; scan dentro del char row (0-7)
 739+ DCD6 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 740+ DCD8 28 02            JR Z, .pxIsTop
 741+ DCDA C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 742+ DCDC              .pxIsTop:
 743+ DCDC                  ; A = scanLine (0-15)
 744+ DCDC
 745+ DCDC                  ; --- Calcular colOffset (0 o 1) ---
 746+ DCDC 5F               LD E, A                     ; E = scanLine (guardar)
 747+ DCDD 79               LD A, C
 748+ DCDE E6 1F            AND $1F                     ; extraer columna
 749+ DCE0 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 750+ DCE2 4F               LD C, A                     ; C = colOffset
 751+ DCE3
 752+ DCE3                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 753+ DCE3 7B               LD A, E                     ; A = scanLine
 754+ DCE4 87               ADD A, A                    ; *2 (word index)
 755+ DCE5 21 DB 8F         LD HL, PlazaScanAddrs
 756+ DCE8 85               ADD A, L
 757+ DCE9 6F               LD L, A
 758+ DCEA 30 01            JR NC, .pxNC
 759+ DCEC 24               INC H
 760+ DCED              .pxNC:
 761+ DCED 7E               LD A, (HL)
 762+ DCEE 23               INC HL
 763+ DCEF 66               LD H, (HL)
 764+ DCF0 81               ADD A, C                    ; sumar colOffset
 765+ DCF1 6F               LD L, A                     ; HL = dir VRAM destino
 766+ DCF2
 767+ DCF2                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 768+ DCF2 7A               LD A, D
 769+ DCF3 2F               CPL
 770+ DCF4 A6               AND (HL)
 771+ DCF5 77               LD (HL), A
 772+ DCF6
 773+ DCF6 E1               POP HL                      ; restaurar puntero datos
 774+ DCF7 18 D0            JR .pxLoop
 775+ DCF9
