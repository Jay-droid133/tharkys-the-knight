1391+ 93D0 28 12            JR Z, .collAttackE
1392+ 93D2 3E 00            LD A, 0
1393+ 93D4 32 7A 94         LD (.collL), A
1394+ 93D7 3E 0F            LD A, 15
1395+ 93D9 18 10            JR .collSetW
1396+ 93DB              .collAttackW:
1397+ 93DB 3E 08            LD A, 8                     ; izquierda desplazada 8 (espada)
1398+ 93DD 32 7A 94         LD (.collL), A
1399+ 93E0 3E 0F            LD A, 15                    ; derecha igual que walk (cuerpo en X..X+15)
1400+ 93E2 18 07            JR .collSetW
1401+ 93E4              .collAttackE:
1402+ 93E4 3E 00            LD A, 0
1403+ 93E6 32 7A 94         LD (.collL), A
1404+ 93E9 3E 17            LD A, 23                    ; derecha extendida (espada a la derecha)
1405+ 93EB              .collSetW:
1406+ 93EB 32 7B 94         LD (.collW), A
1407+ 93EE
1408+ 93EE                  ; Punto 1: esquina superior-izquierda (X-collL, Y)
1409+ 93EE 3A 7A 94         LD A, (.collL)
1410+ 93F1 47               LD B, A
1411+ 93F2 DD 7E 03         LD A, (IX+ENT_POSX)
1412+ 93F5 90               SUB B
1413+ 93F6 47               LD B, A
1414+ 93F7 DD 7E 04         LD A, (IX+ENT_POSY)
1415+ 93FA 4F               LD C, A
1416+ 93FB CD CC AE         CALL IsPointBlocked
