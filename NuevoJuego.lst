 420+ A055              ; ==============================================================================
 421+ A055              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A055              ; ==============================================================================
 423+ A055              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A055              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A055              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A055              ; ==============================================================================
 427+ A055              ProcessEnemies:
 428+ A055 3E 00            LD A, 0
 429+ A057 32 A0 A0         LD (.peCount), A
 430+ A05A 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A05C
 432+ A05C              .peLoop:
 433+ A05C C5               PUSH BC
 434+ A05D
 435+ A05D                  ; Calcular IX desde EnemyStepIdx
 436+ A05D 3A 02 83         LD A, (EnemyStepIdx)
 437+ A060 C6 01            ADD A, SLOT_MONSTER0
 438+ A062 6F               LD L, A
 439+ A063 26 00            LD H, 0
 440+ A065 29               ADD HL, HL
 441+ A066 29               ADD HL, HL
 442+ A067 29               ADD HL, HL
 443+ A068 29               ADD HL, HL                          ; × ENT_SIZE (16)
 444+ A069 11 9B 81         LD DE, EntityTable
 445+ A06C 19               ADD HL, DE
 446+ A06D E5               PUSH HL
 447+ A06E DD E1            POP IX
 448+ A070
 449+ A070                  ; Avanzar indice round-robin
 450+ A070 3A 02 83         LD A, (EnemyStepIdx)
 451+ A073 3C               INC A
 452+ A074 FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 453+ A076 38 01            JR C, .peNoWrap
 454+ A078 AF               XOR A
 455+ A079              .peNoWrap:
 456+ A079 32 02 83         LD (EnemyStepIdx), A
