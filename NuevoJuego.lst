 301+ E561              ; ==============================================================================
 302+ E561              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E561              ; ==============================================================================
 304+ E561              ; Entrada: A = attr original
 305+ E561              ; Salida:  A = attr transformado
 306+ E561              ; Preserva: HL, DE, BC, IX
 307+ E561              ; ==============================================================================
 308+ E561              ApplyDayCycleRemap:
 309+ E561 E5               PUSH HL
 310+ E562 67               LD H, A                     ; H = attr (temp save)
 311+ E563                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E563 3A FC E3         LD A, (BgSpriteSkipRemap)
 313+ E566 B7               OR A
 314+ E567 20 06            JR NZ, .skipRemap
 315+ E569 3A F6 E3         LD A, (CurrentTimeOfDay)
 316+ E56C B7               OR A
 317+ E56D 20 03            JR NZ, .doRemap
 318+ E56F              .skipRemap:
 319+ E56F 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E570 E1               POP HL
 321+ E571 C9               RET
 322+ E572
 323+ E572              .doRemap:
 324+ E572 D5               PUSH DE
 325+ E573 C5               PUSH BC
 326+ E574
 327+ E574 7C               LD A, H                     ; A = attr original
 328+ E575 4F               LD C, A                     ; C = attr original
