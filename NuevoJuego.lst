 352+ ED35                  ; --- Atributos del sprite (2 filas × 6 cols) ---
 353+ ED35                  ; Layout: [dec0][dec1][sfera_L][sfera_R][dec2][dec3]
 354+ ED35                  ; Decoracion (cols 0,1,4,5): remap paper via ApplyDayCycleRemap
 355+ ED35                  ; Esfera (cols 2,3): sin remap (gestionada por DrawClockFaceOnly)
 356+ ED35 DD 23            INC IX                  ; saltar attr_h
 357+ ED37 DD 23            INC IX                  ; saltar attr_w
 358+ ED39 AF               XOR A
 359+ ED3A 32 FB E3         LD (BgSpriteIsHouse), A ; clock no es house
 360+ ED3D                  ; --- Fila 0 (row 0, cols 13-18) ---
 361+ ED3D 21 0D 58         LD HL, $580D
 362+ ED40 DD 7E 00         LD A, (IX+0)
 362+ ED43 CD 61 E5       CALL ApplyDayCycleRemap
 362+ ED46 77             LD (HL), A
 362+ ED47 23             INC HL
 363+ ED48 DD 7E 01         LD A, (IX+1)
 363+ ED4B CD 61 E5       CALL ApplyDayCycleRemap
 363+ ED4E 77             LD (HL), A
 363+ ED4F 23             INC HL
 364+ ED50 DD 7E 02         LD A, (IX+2)
 364+ ED53 77                                       LD (HL), A
 364+ ED54 23             INC HL  ; esfera
 365+ ED55 DD 7E 03         LD A, (IX+3)
 365+ ED58 77                                       LD (HL), A
 365+ ED59 23             INC HL  ; esfera
 366+ ED5A DD 7E 04         LD A, (IX+4)
 366+ ED5D CD 61 E5       CALL ApplyDayCycleRemap
 366+ ED60 77             LD (HL), A
 366+ ED61 23             INC HL
 367+ ED62 DD 7E 05         LD A, (IX+5)
 367+ ED65 CD 61 E5       CALL ApplyDayCycleRemap
 367+ ED68 77             LD (HL), A
 368+ ED69                  ; --- Fila 1 (row 1, cols 13-18) ---
 369+ ED69 21 2D 58         LD HL, $582D
 370+ ED6C DD 7E 06         LD A, (IX+6)
 370+ ED6F CD 61 E5       CALL ApplyDayCycleRemap
 370+ ED72 77             LD (HL), A
 370+ ED73 23             INC HL
 371+ ED74 DD 7E 07         LD A, (IX+7)
 371+ ED77 CD 61 E5       CALL ApplyDayCycleRemap
 371+ ED7A 77             LD (HL), A
 371+ ED7B 23             INC HL
 372+ ED7C DD 7E 08         LD A, (IX+8)
 372+ ED7F 77                                       LD (HL), A
