 157  781F
 158  781F                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 159  781F                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 160  781F                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7
 161  781F                  ; aprovechando que está holgado tras mover tambien bg_gfx_c stuff allí.
 162  781F                  ; (Slot 1 ya tiene headroom limpio tras Phase A — el thunk no causa
 163  781F                  ; overflow ni siquiera estando antes de room_routes.)
 164  781F                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: code/game_over_tomb_thunk.asm
   1+ 781F              ; ==============================================================================
   2+ 781F              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 781F              ; ==============================================================================
   4+ 781F              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 781F              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 781F              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 781F              ;
   8+ 781F              ; Estrategia:
   9+ 781F              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 781F              ;      bank 0 paginado en slot 3.
  11+ 781F              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 781F              ;      seguro hacer la conmutación aquí).
  13+ 781F              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 781F              ;   4. Body retorna → restauramos bank 0.
  15+ 781F              ;
  16+ 781F              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 781F              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 781F              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 781F              ; ==============================================================================
  20+ 781F
  21+ 781F              DrawTombstone2xCentered:
  22+ 781F                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 781F 21 72 D9         LD HL, BgGfx_little_house_cemetery
  24+ 7822 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 7824 CD C2 6A         CALL LoadBgSpriteToBuffer
  26+ 7827
  27+ 7827                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 7827 F3               DI
  29+ 7828 3A 85 8D         LD A, (CurrentPaging)
  30+ 782B E6 F8            AND $F8
  31+ 782D F6 07            OR 7
  32+ 782F 32 85 8D         LD (CurrentPaging), A
  33+ 7832 01 FD 7F         LD BC, $7FFD
  34+ 7835 ED 79            OUT (C), A
  35+ 7837
  36+ 7837                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 7837 CD F7 D9         CALL DrawTombstone2xBody
  38+ 783A
  39+ 783A                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 783A 3A 85 8D         LD A, (CurrentPaging)
  41+ 783D E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 783F 32 85 8D         LD (CurrentPaging), A
  43+ 7842 01 FD 7F         LD BC, $7FFD
  44+ 7845 ED 79            OUT (C), A
  45+ 7847
  46+ 7847                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 7847 3A 9D 81         LD A, (StartupComplete)
  48+ 784A B7               OR A
  49+ 784B C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 784C FB               EI
  51+ 784D C9               RET
  52+ 784E
# file closed: code/game_over_tomb_thunk.asm
