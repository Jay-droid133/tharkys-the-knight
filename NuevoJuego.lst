2749+ AE11 CB 7F            BIT 7, A
2750+ AE13 28 02            JR Z, .eAnimDir
2751+ AE15 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2752+ AE17              .eAnimDir:
2753+ AE17 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2754+ AE1A 20 27            JR NZ, .eAnimDone
2755+ AE1C 3A 5E 8D         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2756+ AE1F 47               LD B, A
2757+ AE20 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2758+ AE23 FE 34            CP SPRID_ENEMY_5
2759+ AE25 78               LD A, B
2760+ AE26 20 06            JR NZ, .eAnimDelaySet
2761+ AE28 CB 3F            SRL A                               ; Rata: mitad del delay
2762+ AE2A B7               OR A
2763+ AE2B 20 01            JR NZ, .eAnimDelaySet
2764+ AE2D 3C               INC A                               ; Minimo 1
2765+ AE2E              .eAnimDelaySet:
