 398+ 8F58              ; ==============================================================================
 399+ 8F58              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 8F58              ; ==============================================================================
 401+ 8F58              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 8F58              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 8F58              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 8F58              ; al room vecino.
 405+ 8F58              ;
 406+ 8F58              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 8F58              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 8F58              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 8F58              ;
 410+ 8F58              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 8F58              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 8F58              ; ==============================================================================
 413+ 8F58              WipeMonsterSlot:
 414+ 8F58 DD E5            PUSH IX
 415+ 8F5A E1               POP HL
 416+ 8F5B 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 8F5E B7               OR A
 418+ 8F5F ED 52            SBC HL, DE
 419+ 8F61 CB 3D            SRL L
 420+ 8F63 CB 3D            SRL L
 421+ 8F65 CB 3D            SRL L
 422+ 8F67 CB 3D            SRL L                               ; HL = slot * 1
 423+ 8F69 5D               LD E, L
 424+ 8F6A 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 8F6C
 426+ 8F6C 21 9B 8D         LD HL, MonsterAiFlags
 427+ 8F6F 19               ADD HL, DE
 428+ 8F70 36 00            LD (HL), 0
 429+ 8F72 21 8F 8D         LD HL, MonsterRoomId
 430+ 8F75 19               ADD HL, DE
 431+ 8F76 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 8F78 21 95 8D         LD HL, MonsterEntryBorder
 433+ 8F7B 19               ADD HL, DE
 434+ 8F7C 36 00            LD (HL), 0
 435+ 8F7E 21 98 8D         LD HL, MonsterExitCoord
 436+ 8F81 19               ADD HL, DE
 437+ 8F82 36 00            LD (HL), 0
 438+ 8F84 21 90 B3         LD HL, MonsterReturnTimer
 439+ 8F87 19               ADD HL, DE
 440+ 8F88 36 00            LD (HL), 0
 441+ 8F8A 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 8F8D 19               ADD HL, DE
 443+ 8F8E 36 00            LD (HL), 0
 444+ 8F90 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 8F93 19               ADD HL, DE
 446+ 8F94 36 00            LD (HL), 0
 447+ 8F96 C9               RET
