 219+ 9AC3              ; Variables locales de DrawSprite
 220+ 9AC3 00           .posX:       DEFB 0
 221+ 9AC4 00           .posY:       DEFB 0
 222+ 9AC5 00           .widthSave:  DEFB 0
 223+ 9AC6 00           .heightSave: DEFB 0
 224+ 9AC7 00           .tablePage:  DEFB 0
 225+ 9AC8 00           .widthCount: DEFB 0
