 383+ 6FDA                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 384+ 6FDA 3A AB 5F         LD A, (RandomSlotCount)
 385+ 6FDD B7               OR A
 386+ 6FDE CA 06 71         JP Z, .urpZeroAndRotate
 387+ 6FE1
 388+ 6FE1                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 389+ 6FE1                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 390+ 6FE1                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 391+ 6FE1 3A 09 83         LD A, (CurrentScreenY)
 392+ 6FE4 07               RLCA
 392+ 6FE5 07             RLCA
 392+ 6FE6 07             RLCA
