 610+ EF63              ; ==============================================================================
 611+ EF63              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 612+ EF63              ; ==============================================================================
 613+ EF63
 614+ EF63              ; ==============================================================================
 615+ EF63              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 616+ EF63              ; ==============================================================================
 617+ EF63              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 618+ EF63              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 619+ EF63              ; ==============================================================================
 620+ EF63              BuildPlazaScanAddrs:
 621+ EF63                  ; Calcular pixel coords del top-left de la esfera
 622+ EF63 3A A8 90         LD A, (PlazaClockCharY)
 623+ EF66 07               RLCA
 624+ EF67 07               RLCA
 625+ EF68 07               RLCA
 626+ EF69 57               LD D, A                     ; D = pixelY = charY * 8
 627+ EF6A 3A A7 90         LD A, (PlazaClockCharX)
 628+ EF6D 07               RLCA
 629+ EF6E 07               RLCA
 630+ EF6F 07               RLCA
 631+ EF70 5F               LD E, A                     ; E = pixelX = charX * 8
 632+ EF71 CD 41 A1         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 633+ EF74
 634+ EF74 DD 21 A9 90      LD IX, PlazaScanAddrs
 635+ EF78 06 10            LD B, 16
 636+ EF7A              .buildLoop:
 637+ EF7A DD 75 00         LD (IX+0), L
 638+ EF7D DD 74 01         LD (IX+1), H
 639+ EF80 DD 23            INC IX
 640+ EF82 DD 23            INC IX
 641+ EF84 05               DEC B
 642+ EF85 C8               RET Z
 643+ EF86 CD AD 9E         CALL NextPixelLine
 644+ EF89 18 EF            JR .buildLoop
 645+ EF8B
 646+ EF8B              ; ==============================================================================
 647+ EF8B              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 648+ EF8B              ; ==============================================================================
 649+ EF8B              ; Llamar cada frame desde el main loop.
 650+ EF8B              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 651+ EF8B              ; ==============================================================================
 652+ EF8B              DrawPlazaClock:
 653+ EF8B 3A A6 90         LD A, (PlazaClockActive)
 654+ EF8E B7               OR A
 655+ EF8F C8               RET Z
 656+ EF90
 657+ EF90                  ; --- Calcular posicion actual de las agujas ---
 658+ EF90 3A F1 EA         LD A, (GameHours)
 659+ EF93 FE 0C            CP 12
 660+ EF95 38 02            JR C, .pCalcHourOk
 661+ EF97 D6 0C            SUB 12
 662+ EF99              .pCalcHourOk:
 663+ EF99 57               LD D, A                     ; D = display hour (0-11)
 664+ EF9A 3A F0 EA         LD A, (GameMinutes)
 665+ EF9D 1E 00            LD E, 0
 666+ EF9F              .pCalcDiv5:
 667+ EF9F FE 05            CP 5
 668+ EFA1 38 05            JR C, .pCalcMinOk
 669+ EFA3 D6 05            SUB 5
 670+ EFA5 1C               INC E
 671+ EFA6 18 F7            JR .pCalcDiv5
 672+ EFA8              .pCalcMinOk:
 673+ EFA8                  ; D = hour pos (0-11), E = minute pos (0-11)
 674+ EFA8
 675+ EFA8                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 676+ EFA8 3A FC EF         LD A, (PlazaLastHour)
 677+ EFAB BA               CP D
 678+ EFAC 20 05            JR NZ, .pNeedsRedraw
 679+ EFAE 3A FD EF         LD A, (PlazaLastMin)
 680+ EFB1 BB               CP E
 681+ EFB2 C8               RET Z                       ; sin cambio → no redibujar
 682+ EFB3
 683+ EFB3              .pNeedsRedraw:
 684+ EFB3 7A               LD A, D
 685+ EFB4 32 FC EF         LD (PlazaLastHour), A
 686+ EFB7 7B               LD A, E
 687+ EFB8 32 FD EF         LD (PlazaLastMin), A
 688+ EFBB
 689+ EFBB                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 690+ EFBB                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 691+ EFBB DD 21 7C 8D      LD IX, PlazaClockPixels
 692+ EFBF FD 21 A9 90      LD IY, PlazaScanAddrs
 693+ EFC3 06 10            LD B, 16
 694+ EFC5              .faceRow:
 695+ EFC5 FD 6E 00         LD L, (IY+0)
 696+ EFC8 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 697+ EFCB DD 7E 00         LD A, (IX+0)
 698+ EFCE 2F               CPL                         ; des-invertir (dato CPL'd)
 699+ EFCF 77               LD (HL), A                  ; byte izquierdo
 700+ EFD0 23               INC HL
 701+ EFD1 DD 7E 01         LD A, (IX+1)
 702+ EFD4 2F               CPL
 703+ EFD5 77               LD (HL), A                  ; byte derecho
 704+ EFD6 DD 23            INC IX
 705+ EFD8 DD 23            INC IX
 706+ EFDA FD 23            INC IY
 707+ EFDC FD 23            INC IY
 708+ EFDE 10 E5            DJNZ .faceRow
 709+ EFE0
 710+ EFE0                  ; --- Aguja de horas ---
 711+ EFE0 3A FC EF         LD A, (PlazaLastHour)
 712+ EFE3 21 ED EB         LD HL, HourHandPtrs
 713+ EFE6 CD FE EF         CALL DrawPlazaHandLine
 714+ EFE9
 715+ EFE9                  ; --- Aguja de minutos ---
 716+ EFE9 3A FD EF         LD A, (PlazaLastMin)
 717+ EFEC 21 09 EB         LD HL, MinHandPtrs
 718+ EFEF CD FE EF         CALL DrawPlazaHandLine
 719+ EFF2
 720+ EFF2                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 721+ EFF2 21 B7 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 722+ EFF5 7E               LD A, (HL)
 723+ EFF6 23               INC HL
 724+ EFF7 66               LD H, (HL)
 725+ EFF8 6F               LD L, A                     ; HL = dir VRAM scan line 7
 726+ EFF9 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 727+ EFFB C9               RET
 728+ EFFC
 729+ EFFC              ; Variables locales reloj plaza
 730+ EFFC FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 731+ EFFD FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 732+ EFFE
 733+ EFFE              ; ==============================================================================
 734+ EFFE              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 735+ EFFE              ; ==============================================================================
 736+ EFFE              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 737+ EFFE              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 738+ EFFE              ; a posiciones relativas y las busca en PlazaScanAddrs.
 739+ EFFE              ; ==============================================================================
 740+ EFFE              DrawPlazaHandLine:
 741+ EFFE                  ; Indexar en tabla de punteros
 742+ EFFE 87               ADD A, A
 743+ EFFF 4F               LD C, A
 744+ F000 06 00            LD B, 0
 745+ F002 09               ADD HL, BC
 746+ F003 7E               LD A, (HL)
 747+ F004 23               INC HL
 748+ F005 66               LD H, (HL)
 749+ F006 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 750+ F007
 751+ F007              .pxLoop:
 752+ F007 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 753+ F008 B7               OR A
 754+ F009 C8               RET Z
 755+ F00A
 756+ F00A                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 757+ F00A 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 758+ F00B 23               INC HL
 759+ F00C 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 760+ F00D 23               INC HL
 761+ F00E 56               LD D, (HL)                  ; D = mask
 762+ F00F 23               INC HL
 763+ F010 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 764+ F011
 765+ F011                  ; --- Calcular scanLine (0-15) ---
 766+ F011 78               LD A, B
 767+ F012 E6 07            AND $07                     ; scan dentro del char row (0-7)
 768+ F014 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 769+ F016 28 02            JR Z, .pxIsTop
 770+ F018 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 771+ F01A              .pxIsTop:
 772+ F01A                  ; A = scanLine (0-15)
 773+ F01A
 774+ F01A                  ; --- Calcular colOffset (0 o 1) ---
 775+ F01A 5F               LD E, A                     ; E = scanLine (guardar)
 776+ F01B 79               LD A, C
 777+ F01C E6 1F            AND $1F                     ; extraer columna
 778+ F01E D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 779+ F020 4F               LD C, A                     ; C = colOffset
 780+ F021
 781+ F021                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 782+ F021 7B               LD A, E                     ; A = scanLine
 783+ F022 87               ADD A, A                    ; *2 (word index)
 784+ F023 21 A9 90         LD HL, PlazaScanAddrs
 785+ F026 85               ADD A, L
 786+ F027 6F               LD L, A
 787+ F028 30 01            JR NC, .pxNC
 788+ F02A 24               INC H
 789+ F02B              .pxNC:
 790+ F02B 7E               LD A, (HL)
 791+ F02C 23               INC HL
 792+ F02D 66               LD H, (HL)
 793+ F02E 81               ADD A, C                    ; sumar colOffset
 794+ F02F 6F               LD L, A                     ; HL = dir VRAM destino
 795+ F030
 796+ F030                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 797+ F030 7A               LD A, D
 798+ F031 2F               CPL
 799+ F032 A6               AND (HL)
 800+ F033 77               LD (HL), A
 801+ F034
 802+ F034 E1               POP HL                      ; restaurar puntero datos
 803+ F035 18 D0            JR .pxLoop
 804+ F037
# file closed: hud_clock.asm
 340  F037                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ F037              ; ==============================================================================
   2+ F037              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ F037              ; ==============================================================================
   4+ F037              ; CurrentObjective vive en variables.asm. Valor:
   5+ F037              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ F037              ;   9    = todos los hitos completados (juego ganado)
   7+ F037              ;
   8+ F037              ; ----------------------------------------------------------------------------
   9+ F037              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ F037              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ F037              ;                       recoger el sprite cuyo behavior coincide.
  12+ F037              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ F037              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ F037              ;                       Avanza al disparar el trigger correspondiente.
  15+ F037              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ F037              ;
  17+ F037              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ F037              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ F037              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ F037              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ F037              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ F037              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ F037              ;
