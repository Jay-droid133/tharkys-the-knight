4828+ B9F3              ; ==============================================================================
4829+ B9F3              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
4830+ B9F3              ; ==============================================================================
4831+ B9F3              TryRespawnMonsters:
4832+ B9F3 3A DF D1         LD A, (CurrentTimeOfDay)
4833+ B9F6 FE 03            CP 3
4834+ B9F8 28 05            JR Z, .rmNight
4835+ B9FA FE 04            CP 4
4836+ B9FC 28 01            JR Z, .rmNight
4837+ B9FE C9               RET
4838+ B9FF              .rmNight:
4839+ B9FF 3A 63 B2         LD A, (MonstersActive)
4840+ BA02 B7               OR A
4841+ BA03 C8               RET Z
4842+ BA04 CD AB BA         CALL .rmUpdateReturnTimers
4843+ BA07 3A AA BA         LD A, (.rmTimer)
4844+ BA0A B7               OR A
4845+ BA0B 28 05            JR Z, .rmCheckSlots
4846+ BA0D 3D               DEC A
4847+ BA0E 32 AA BA         LD (.rmTimer), A
4848+ BA11 C9               RET
4849+ BA12              .rmCheckSlots:
4850+ BA12 DD 21 C0 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4851+ BA16 06 03            LD B, MONSTERS_TO_SPAWN
4852+ BA18 0E 00            LD C, 0
4853+ BA1A              .rmLoop:
4854+ BA1A C5               PUSH BC
4855+ BA1B DD 7E 01         LD A, (IX+ENT_TYPE)
4856+ BA1E B7               OR A
4857+ BA1F C2 9E BA         JP NZ, .rmSkip
4858+ BA22                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
4859+ BA22                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
4860+ BA22                  ; que el player visite su room.
4861+ BA22 79               LD A, C
4862+ BA23 6F               LD L, A
4863+ BA24 26 00            LD H, 0
4864+ BA26 11 00 90         LD DE, MonsterRoomId
4865+ BA29 19               ADD HL, DE
4866+ BA2A 7E               LD A, (HL)
4867+ BA2B 5F               LD E, A                             ; E = room_id del slot
4868+ BA2C CD 64 92         CALL MaiGetCurrentScreenId          ; A = current screen_id
4869+ BA2F BB               CP E
4870+ BA30 C2 9E BA         JP NZ, .rmSkip                      ; distinto room → skip
4871+ BA33                  ; === Activar SIN tocar POSX/POSY ===
4872+ BA33                  ; La posicion la fija quien puso TYPE_NONE en este slot:
4873+ BA33                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
4874+ BA33                  ;   - RepositionMonstersAtEntry: gap en entry side
4875+ BA33                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
4876+ BA33 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
4877+ BA36 B7               OR A
4878+ BA37 20 18            JR NZ, .rmHasType
4879+ BA39 79               LD A, C
4880+ BA3A 21 ED B9         LD HL, MonsterTypeTable
4881+ BA3D 5F               LD E, A
4882+ BA3E 16 00            LD D, 0
4883+ BA40 19               ADD HL, DE
4884+ BA41 7E               LD A, (HL)
4885+ BA42 DD 77 08         LD (IX+ENT_ANIMBASE), A
4886+ BA45 79               LD A, C
4887+ BA46 21 F0 B9         LD HL, MonsterColorTable
4888+ BA49 5F               LD E, A
4889+ BA4A 16 00            LD D, 0
4890+ BA4C 19               ADD HL, DE
4891+ BA4D 7E               LD A, (HL)
4892+ BA4E DD 77 05         LD (IX+ENT_ATTR), A
4893+ BA51              .rmHasType:
4894+ BA51 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
4895+ BA54 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
4896+ BA58 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
4897+ BA5C                  ; Facing
4898+ BA5C 57               LD D, A
4899+ BA5D 3A B3 80         LD A, (EntityTable + ENT_POSX)
4900+ BA60 DD BE 03         CP (IX+ENT_POSX)
4901+ BA63 30 05            JR NC, .rmFaceR
4902+ BA65 7A               LD A, D
4903+ BA66 C6 04            ADD A, MONSTER_FRAMES_LEFT
4904+ BA68 18 01            JR .rmFaceSet
4905+ BA6A              .rmFaceR:
4906+ BA6A 7A               LD A, D
4907+ BA6B              .rmFaceSet:
4908+ BA6B DD 77 00         LD (IX+ENT_SPRITEID), A
4909+ BA6E DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
4910+ BA72 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
4911+ BA76 DD 36 0A 00      LD (IX+ENT_DIR), 0
4912+ BA7A DD 36 06 00      LD (IX+ENT_DELTAX), 0
4913+ BA7E DD 36 07 00      LD (IX+ENT_DELTAY), 0
4914+ BA82 DD 7E 03         LD A, (IX+ENT_POSX)
4915+ BA85 DD 77 0C         LD (IX+ENT_OLDX), A
4916+ BA88 DD 77 0F         LD (IX+ENT_DRAWX), A
4917+ BA8B DD 7E 04         LD A, (IX+ENT_POSY)
4918+ BA8E DD 77 0D         LD (IX+ENT_OLDY), A
4919+ BA91 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4920+ BA94 DD 77 0E         LD (IX+ENT_OLDSPRID), A
4921+ BA97                  ; Solo UNO por frame
4922+ BA97 C1               POP BC
4923+ BA98 3E 28            LD A, MONSTER_ENTRY_GAP
4924+ BA9A 32 AA BA         LD (.rmTimer), A
4925+ BA9D C9               RET
4926+ BA9E              .rmSkip:
4927+ BA9E 11 10 00         LD DE, ENT_SIZE
4928+ BAA1 DD 19            ADD IX, DE
4929+ BAA3 C1               POP BC
4930+ BAA4 0C               INC C
4931+ BAA5 05               DEC B
4932+ BAA6 C2 1A BA         JP NZ, .rmLoop
4933+ BAA9 C9               RET
4934+ BAAA
4935+ BAAA 00           .rmTimer: DEFB 0
4936+ BAAB
4937+ BAAB              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
4938+ BAAB              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
4939+ BAAB              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
4940+ BAAB              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
4941+ BAAB              ; empujado).
4942+ BAAB              .rmUpdateReturnTimers:
4943+ BAAB 21 64 B2         LD HL, MonsterReturnTimer
4944+ BAAE DD 21 C0 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4945+ BAB2 06 03            LD B, MONSTERS_TO_SPAWN
4946+ BAB4              .rmRtLoop:
4947+ BAB4 7E               LD A, (HL)
4948+ BAB5 B7               OR A
4949+ BAB6 CA 8B BB         JP Z, .rmRtNext
4950+ BAB9 3D               DEC A
4951+ BABA 77               LD (HL), A
4952+ BABB C2 8B BB         JP NZ, .rmRtNext
4953+ BABE                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
4954+ BABE                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
4955+ BABE                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
4956+ BABE                  ; Calcular target coord: axis variable segun borde de salida.
4957+ BABE                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
4958+ BABE DD 7E 0A         LD A, (IX+ENT_DIR)
4959+ BAC1 FE 01            CP DIR_N
4960+ BAC3 28 11            JR Z, .rmRtSideN
4961+ BAC5 FE 02            CP DIR_S
4962+ BAC7 28 1C            JR Z, .rmRtSideS
4963+ BAC9 FE 04            CP DIR_E
4964+ BACB CA 05 BB         JP Z, .rmRtSideE
4965+ BACE FE 08            CP DIR_W
4966+ BAD0 CA F4 BA         JP Z, .rmRtSideW
4967+ BAD3 C3 62 BB         JP .rmRtFallback
4968+ BAD6              .rmRtSideN:
4969+ BAD6                  ; target coord = cx = POSX / 8
4970+ BAD6 DD 7E 03         LD A, (IX+ENT_POSX)
4971+ BAD9 0F               RRCA
4972+ BADA 0F               RRCA
4973+ BADB 0F               RRCA
4974+ BADC E6 1F            AND $1F
4975+ BADE 32 9D 99         LD (MaiGapTargetCoord), A
4976+ BAE1 3E 00            LD A, MAI_SIDE_N
4977+ BAE3 18 2F            JR .rmRtPickGap
4978+ BAE5              .rmRtSideS:
4979+ BAE5 DD 7E 03         LD A, (IX+ENT_POSX)
4980+ BAE8 0F               RRCA
4981+ BAE9 0F               RRCA
4982+ BAEA 0F               RRCA
4983+ BAEB E6 1F            AND $1F
4984+ BAED 32 9D 99         LD (MaiGapTargetCoord), A
4985+ BAF0 3E 01            LD A, MAI_SIDE_S
4986+ BAF2 18 20            JR .rmRtPickGap
4987+ BAF4              .rmRtSideW:
4988+ BAF4                  ; target coord = cy = (POSY - 16) / 8
4989+ BAF4 DD 7E 04         LD A, (IX+ENT_POSY)
4990+ BAF7 D6 10            SUB SCREEN_MIN_Y
4991+ BAF9 0F               RRCA
4992+ BAFA 0F               RRCA
4993+ BAFB 0F               RRCA
4994+ BAFC E6 1F            AND $1F
4995+ BAFE 32 9D 99         LD (MaiGapTargetCoord), A
4996+ BB01 3E 02            LD A, MAI_SIDE_W
4997+ BB03 18 0F            JR .rmRtPickGap
4998+ BB05              .rmRtSideE:
4999+ BB05 DD 7E 04         LD A, (IX+ENT_POSY)
5000+ BB08 D6 10            SUB SCREEN_MIN_Y
5001+ BB0A 0F               RRCA
5002+ BB0B 0F               RRCA
5003+ BB0C 0F               RRCA
5004+ BB0D E6 1F            AND $1F
5005+ BB0F 32 9D 99         LD (MaiGapTargetCoord), A
5006+ BB12 3E 03            LD A, MAI_SIDE_E
5007+ BB14              .rmRtPickGap:
5008+ BB14                  ; MaiPickNearestGapOnSide destruye HL y BC (paginacion bank 6, loops
5009+ BB14                  ; internos). Preservamos HL (ptr a MonsterReturnTimer[slot]) y B
5010+ BB14                  ; (contador del outer loop) para que .rmRtNext pueda iterar bien.
5011+ BB14 E5               PUSH HL
5012+ BB15 C5               PUSH BC
5013+ BB16 CD B8 94         CALL MaiPickNearestGapOnSide        ; elige gap del side mas cercano al target
5014+ BB19 C1               POP BC
5015+ BB1A E1               POP HL
5016+ BB1B B7               OR A
5017+ BB1C C2 62 BB         JP NZ, .rmRtFallback
5018+ BB1F                  ; Ajustar MaiSpawnX/Y con MAI_REENTRY_OFFSET hacia dentro. MaiPickRandomGapOnSide
5019+ BB1F                  ; usa MAI_ENTRY_OFFSET (=0) y deja el spawn al borde; aqui lo empujamos 2 chars.
5020+ BB1F 3A 99 99         LD A, (MaiGapSide)
5021+ BB22 FE 00            CP MAI_SIDE_N
5022+ BB24 28 12            JR Z, .rmRtAdjN
5023+ BB26 FE 01            CP MAI_SIDE_S
5024+ BB28 28 18            JR Z, .rmRtAdjS
5025+ BB2A FE 02            CP MAI_SIDE_W
5026+ BB2C 28 1E            JR Z, .rmRtAdjW
5027+ BB2E                  ; side E
5028+ BB2E 3A 9E 99         LD A, (MaiSpawnX)
5029+ BB31 D6 10            SUB MAI_REENTRY_OFFSET
5030+ BB33 32 9E 99         LD (MaiSpawnX), A
5031+ BB36 18 1C            JR .rmRtApplyGap
5032+ BB38              .rmRtAdjN:
5033+ BB38 3A 9F 99         LD A, (MaiSpawnY)
5034+ BB3B C6 10            ADD A, MAI_REENTRY_OFFSET
5035+ BB3D 32 9F 99         LD (MaiSpawnY), A
5036+ BB40 18 12            JR .rmRtApplyGap
5037+ BB42              .rmRtAdjS:
5038+ BB42 3A 9F 99         LD A, (MaiSpawnY)
5039+ BB45 D6 10            SUB MAI_REENTRY_OFFSET
5040+ BB47 32 9F 99         LD (MaiSpawnY), A
5041+ BB4A 18 08            JR .rmRtApplyGap
