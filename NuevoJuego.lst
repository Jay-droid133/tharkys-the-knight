 609  E58C                  ; --- Town gate cutscene body (~1200 B, slot 1 -> bank 7 move) ---
 610  E58C                  ; Body movible: phase machine + anim helpers + DrawTheEnd + DrawCredits +
 611  E58C                  ; PrintStringFontAt + DrawCharFontAt + SFX stubs + TownGateCreditsData.
 612  E58C                  ; Entry thunks (CheckTownGateTriggerBg / UpdateTownGateCutscene) viven en
 613  E58C                  ; bank_cutscene_thunks.asm (slot 1) con SP swap igual que bank_cutscene.
 614  E58C                  ; Comparten alt_stack porque las 2 cinematicas son mutuamente exclusivas
 615  E58C                  ; (M11 vs M9). Funciones que se quedan en slot 1 (town_gate_cutscene.asm):
 616  E58C                  ; KillDeathIfActive, TownGate*Player*, BiClip, SlideErase/Draw,
 617  E58C                  ; AllNastiesDeadCheck — usadas por bank_cutscene o paginan slot 3.
 618  E58C                  INCLUDE "town_gate_cutscene_bank7.asm"
# file opened: town_gate_cutscene_bank7.asm
   1+ E58C              ; ==============================================================================
   2+ E58C              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ E58C              ; ==============================================================================
   4+ E58C              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ E58C              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ E58C              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ E58C              ;
   8+ E58C              ; Esquema de fases:
   9+ E58C              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ E58C              ;   2 ARM_IN       arm aparece, pausa
  11+ E58C              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ E58C              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ E58C              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ E58C              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ E58C              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ E58C              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ E58C              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ E58C              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ E58C              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ E58C              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ E58C              ;  13 END_HOLD     "The End" sprite hold
  22+ E58C              ;  14 BLACK        wipe a negro + hold
  23+ E58C              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ E58C              ;
  25+ E58C              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ E58C              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ E58C              ; ==============================================================================
  28+ E58C
  29+ E58C              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ E58C              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ E58C              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ E58C              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ E58C              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ E58C              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ E58C              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ E58C              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ E58C              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ E58C              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ E58C              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ E58C
  41+ E58C              ; --- Posiciones (pixel) ---
  42+ E58C              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ E58C              TGCS_ANCHOR1_Y         EQU 80
  44+ E58C              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ E58C              TGCS_END_CHARY         EQU 4
  46+ E58C              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ E58C
  48+ E58C              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ E58C              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ E58C              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ E58C              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ E58C              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ E58C              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ E58C              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ E58C              TGCS_ARM_PX_X          EQU 136
  56+ E58C              TGCS_ARM_PX_Y          EQU 64
  57+ E58C              TGCS_FINGER_PX_X       EQU 136
  58+ E58C              TGCS_FINGER_PX_Y       EQU 56
  59+ E58C
  60+ E58C              ; --- Phase enum ---
  61+ E58C              TGP_IDLE               EQU 0
  62+ E58C              TGP_LOCK               EQU 1
  63+ E58C              TGP_ARM_IN             EQU 2
  64+ E58C              TGP_FINGER_IN          EQU 3
  65+ E58C              TGP_SHAKE              EQU 4
  66+ E58C              TGP_FINGER_PULSE       EQU 5
  67+ E58C              TGP_FINGER_OUT         EQU 6
  68+ E58C              TGP_ARM_HOLD           EQU 7
  69+ E58C              TGP_ARM_OUT            EQU 8
  70+ E58C              TGP_PLAYER_TURN        EQU 9
  71+ E58C              TGP_PLAYER_HIDE        EQU 10
  72+ E58C              TGP_PLAYER_FRAMED      EQU 11
  73+ E58C              TGP_PLAYER_EXIT        EQU 12
  74+ E58C              TGP_END_HOLD           EQU 13
  75+ E58C              TGP_BLACK              EQU 14
  76+ E58C              TGP_CREDITS            EQU 15
  77+ E58C              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ E58C              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ E58C
  80+ E58C              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ E58C                                                ; check dinamico de "todos los nasties dead".
  82+ E58C                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ E58C                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ E58C                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ E58C
  86+ E58C              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ E58C              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ E58C              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ E58C              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ E58C
  91+ E58C              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ E58C              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ E58C              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ E58C              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ E58C              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ E58C              ;
  97+ E58C              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ E58C              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ E58C              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ E58C              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ E58C              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ E58C              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ E58C              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 104+ E58C
 105+ E58C              ; --- Posicion de la puerta (closed v2 + open) en char ---
 106+ E58C              ; El closed v2 (id 246) vive en PickupTable a (14, 17). El open (id 250)
 107+ E58C              ; comparte posicion y tamano (4x5 chars). Cuando el cutscene erase el closed,
 108+ E58C              ; dibuja el open in-place via DrawBgGfxSprite.
 109+ E58C              TGCS_DOOR_CHARX        EQU 14
 110+ E58C              TGCS_DOOR_CHARY        EQU 17
 111+ E58C              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
 112+ E58C              TGCS_ARCH_ROOM_X       EQU 7
 113+ E58C              TGCS_ARCH_ROOM_Y       EQU 15
 114+ E58C              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
 115+ E58C
 116+ E58C              ; ==============================================================================
 117+ E58C              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ E58C              ; ==============================================================================
 119+ E58C              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ E58C              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ E58C              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ E58C              ;
 123+ E58C              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ E58C              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ E58C              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ E58C              ; Destruye: AF, BC, DE, HL, IX.
 127+ E58C              ; ==============================================================================
 128+ E58C              CheckTownGateTriggerBgBody:
 129+ E58C 3A D0 82         LD A, (TownGatePhase)
 130+ E58F B7               OR A
 131+ E590 C0               RET NZ                              ; ya en cutscene
 132+ E591 3A B6 82         LD A, (CurrentKey)
 133+ E594 FE 06            CP TGCS_ARCH_KEY_ID
 134+ E596 C0               RET NZ                              ; sin la key correcta
 135+ E597 3A 10 83         LD A, (CurrentScreenX)
 136+ E59A FE 07            CP TGCS_ARCH_ROOM_X
 137+ E59C C0               RET NZ
 138+ E59D 3A 11 83         LD A, (CurrentScreenY)
 139+ E5A0 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ E5A2 C0               RET NZ
 141+ E5A3                  ; --- Horizontal AABB ---
 142+ E5A3 3A A6 81         LD A, (EntityTable + ENT_POSX)
 143+ E5A6 4F               LD C, A                             ; C = player_left
 144+ E5A7 C6 10            ADD A, 16
 145+ E5A9 57               LD D, A                             ; D = player_right
 146+ E5AA 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ E5AC D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ E5AE 30 01            JR NC, .ctgtNoUnderL
 149+ E5B0 AF               XOR A
 150+ E5B1              .ctgtNoUnderL:
 151+ E5B1 BA               CP D
 152+ E5B2 D0               RET NC                              ; ext_left >= player_right
 153+ E5B3 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ E5B5 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ E5B7 30 02            JR NC, .ctgtNoOverR
 156+ E5B9 3E FF            LD A, $FF
 157+ E5BB              .ctgtNoOverR:
 158+ E5BB B9               CP C
 159+ E5BC D8               RET C                               ; ext_right < player_left
 160+ E5BD                  ; --- Vertical AABB ---
 161+ E5BD                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ E5BD                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ E5BD                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ E5BD                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ E5BD                  ; con la altura real del rect.
 166+ E5BD 3A A7 81         LD A, (EntityTable + ENT_POSY)
 167+ E5C0 4F               LD C, A                             ; C = player_top
 168+ E5C1 C6 15            ADD A, 21
 169+ E5C3 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ E5C4 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ E5C6 D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ E5C8 30 01            JR NC, .ctgtNoUnderT
 173+ E5CA AF               XOR A
 174+ E5CB              .ctgtNoUnderT:
 175+ E5CB BA               CP D
 176+ E5CC D0               RET NC
 177+ E5CD 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ E5CF C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ E5D1 30 02            JR NC, .ctgtNoOverB
 180+ E5D3 3E FF            LD A, $FF
 181+ E5D5              .ctgtNoOverB:
 182+ E5D5 B9               CP C
 183+ E5D6 D8               RET C
 184+ E5D7                  ; HIT
 185+ E5D7 CD DF E5         CALL StartTownGateCutscene
 186+ E5DA 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ E5DC C3 4E 6D         JP CheckMilestoneTrigger_B7            ; tail call
 188+ E5DF
 189+ E5DF              ; ==============================================================================
 190+ E5DF              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ E5DF              ; ==============================================================================
 192+ E5DF              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ E5DF              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ E5DF              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ E5DF              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ E5DF              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ E5DF              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ E5DF              ; Destruye: AF, BC, DE, HL, IX.
 199+ E5DF              ; ==============================================================================
 200+ E5DF              StartTownGateCutscene:
 201+ E5DF AF               XOR A
 202+ E5E0 32 B6 82         LD (CurrentKey), A
 203+ E5E3 CD 31 E8         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ E5E6 CD 66 6D         CALL KillAllActiveNasties_B7           ; nasties → puff (animan en WAIT_NASTIES)
 205+ E5E9 CD 6C 6D         CALL KillDeathIfActive_B7              ; muerte (slot 11) → puff y despawn
 206+ E5EC CD F1 E9         CALL SFX_TownGate_OnStart
 207+ E5EF 3E 10            LD A, TGP_WAIT_NASTIES
 208+ E5F1 32 D0 82         LD (TownGatePhase), A
 209+ E5F4 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ E5F6 32 A5 5F         LD (TownGateTimer), A
 211+ E5F9 C9               RET
 212+ E5FA
 213+ E5FA              ; KillDeathIfActive: vive en slot 1 (town_gate_cutscene.asm) — llamada por
 214+ E5FA              ; bank_cutscene via KillDeathIfActive_B7. NO duplicar aqui.
 215+ E5FA
 216+ E5FA              ; ==============================================================================
 217+ E5FA              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 218+ E5FA              ; ==============================================================================
 219+ E5FA              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 220+ E5FA              ; transicion a la siguiente.
 221+ E5FA              ; Destruye: AF, BC, DE, HL, IX.
 222+ E5FA              ; ==============================================================================
 223+ E5FA              UpdateTownGateCutsceneBody:
 224+ E5FA 3A D0 82         LD A, (TownGatePhase)
 225+ E5FD FE 10            CP TGP_WAIT_NASTIES
 226+ E5FF CA 3A E6         JP Z, .tgPhWaitNasties              ; pre-LOCK wait, ProcessEnemies sigue corriendo
 227+ E602 FE 11            CP TGP_WALK_TO_ANCHOR
 228+ E604 CA 56 E6         JP Z, .tgPhWalkToAnchor              ; player camina autonomo a anchor1
 229+ E607 3D               DEC A
 230+ E608 CA DC E6         JP Z, .tgPhLock
 231+ E60B 3D               DEC A
 232+ E60C CA F4 E6         JP Z, .tgPhArmIn
 233+ E60F 3D               DEC A
 234+ E610 CA 0C E7         JP Z, .tgPhFingerIn
 235+ E613 3D               DEC A
 236+ E614 CA 25 E7         JP Z, .tgPhShake
 237+ E617 3D               DEC A
 238+ E618 CA 3D E7         JP Z, .tgPhFingerPulse
 239+ E61B 3D               DEC A
 240+ E61C CA 55 E7         JP Z, .tgPhFingerOut
 241+ E61F 3D               DEC A
 242+ E620 CA 64 E7         JP Z, .tgPhArmHold
 243+ E623 3D               DEC A
 244+ E624 CA 7C E7         JP Z, .tgPhArmOut
 245+ E627 3D               DEC A
 246+ E628 CA A1 E7         JP Z, .tgPhPlayerTurn
 247+ E62B 3D               DEC A                               ; phase 10 (PLAYER_HIDE) deprecated
 248+ E62C 3D               DEC A                               ; phase 11 (PLAYER_FRAMED) deprecated
 249+ E62D 3D               DEC A
 250+ E62E CA D6 E7         JP Z, .tgPhPlayerExit
 251+ E631 3D               DEC A
 252+ E632 CA 06 E8         JP Z, .tgPhEndHold
 253+ E635 3D               DEC A
 254+ E636 CA 18 E8         JP Z, .tgPhBlack
 255+ E639                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 256+ E639 C9               RET
 257+ E63A
 258+ E63A              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 259+ E63A              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 260+ E63A              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 261+ E63A              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 262+ E63A              ;
 263+ E63A              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 264+ E63A              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 265+ E63A              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 266+ E63A              ; capturamos para meterlos en STATE_DYING.
 267+ E63A              .tgPhWaitNasties:
 268+ E63A CD 66 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 269+ E63D CD 22 63         CALL TownGateAllNastiesDeadCheck
 270+ E640 28 04            JR Z, .tgWaitNastiesDone
 271+ E642 CD 28 E8         CALL TownGateDecTimer               ; safety timeout
 272+ E645 C0               RET NZ
 273+ E646              .tgWaitNastiesDone:
 274+ E646                  ; Refrescar attrs del player antes del walk: los puffs de nasties cerca
 275+ E646                  ; del player pueden haber dejado attrs contaminados (color nasty) en
 276+ E646                  ; sus celdas. TownGateRedrawPlayer hace erase + RestoreOldAttr (limpia
 277+ E646                  ; desde CleanAttrMap) + draw + SetEntityAttr (player white).
 278+ E646 CD 57 6D         CALL TownGateRedrawPlayer_B7
 279+ E649 AF               XOR A
 280+ E64A 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 281+ E64D 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 282+ E650 3E 11            LD A, TGP_WALK_TO_ANCHOR
 283+ E652 32 D0 82         LD (TownGatePhase), A
 284+ E655 C9               RET
 285+ E656
 286+ E656              ; ---- Phase WALK_TO_ANCHOR: player camina autonomo en 2 fases ----
 287+ E656              ; Fase 1: movimiento vertical hasta alinear Y con TGCS_WALK_TARGET_Y
 288+ E656              ;         (sprite WALK_N o WALK_S segun direccion).
 289+ E656              ; Fase 2: movimiento horizontal hasta alinear X con TGCS_WALK_TARGET_X
 290+ E656              ;         (sprite WALK_E o WALK_W segun direccion).
 291+ E656              ; Al llegar (ambos ejes alineados): pose static WALK_N+1 + transicion a LOCK.
 292+ E656              ; Toggle frame anim 0/1 cada TGCS_WALK_ANIM_PERIOD frames.
 293+ E656              .tgPhWalkToAnchor:
 294+ E656 DD 21 A3 81      LD IX, EntityTable
 295+ E65A                  ; --- Fase 1: Y ---
 296+ E65A DD 7E 04         LD A, (IX+ENT_POSY)
 297+ E65D FE 50            CP TGCS_WALK_TARGET_Y
 298+ E65F 28 1C            JR Z, .tgwtaTryX                    ; Y aligned, pasar a fase 2
 299+ E661 38 0D            JR C, .tgwtaMoveS                   ; cur_Y < target → S (Y++)
 300+ E663                  ; cur_Y > target → N (Y--)
 301+ E663 DD 35 04         DEC (IX+ENT_POSY)
 302+ E666 DD 7E 04         LD A, (IX+ENT_POSY)
 303+ E669 32 E4 82         LD (PlayerDrawY), A
 304+ E66C 06 0A            LD B, SPRID_WALK_N
 305+ E66E 18 2F            JR .tgwtaApplyAnim
 306+ E670              .tgwtaMoveS:
 307+ E670 DD 34 04         INC (IX+ENT_POSY)
 308+ E673 DD 7E 04         LD A, (IX+ENT_POSY)
 309+ E676 32 E4 82         LD (PlayerDrawY), A
 310+ E679 06 0E            LD B, SPRID_WALK_S
 311+ E67B 18 22            JR .tgwtaApplyAnim
 312+ E67D                  ; --- Fase 2: X (solo si Y ya aligned) ---
 313+ E67D              .tgwtaTryX:
 314+ E67D DD 7E 03         LD A, (IX+ENT_POSX)
 315+ E680 FE 78            CP TGCS_WALK_TARGET_X
 316+ E682 CA C0 E6         JP Z, .tgwtaArrived                 ; ambos aligned
 317+ E685 38 0D            JR C, .tgwtaMoveE                   ; cur_X < target → E (X++)
 318+ E687 DD 35 03         DEC (IX+ENT_POSX)
 319+ E68A DD 7E 03         LD A, (IX+ENT_POSX)
 320+ E68D DD 77 0F         LD (IX+ENT_DRAWX), A
 321+ E690 06 06            LD B, SPRID_WALK_W
 322+ E692 18 0B            JR .tgwtaApplyAnim
 323+ E694              .tgwtaMoveE:
 324+ E694 DD 34 03         INC (IX+ENT_POSX)
 325+ E697 DD 7E 03         LD A, (IX+ENT_POSX)
 326+ E69A DD 77 0F         LD (IX+ENT_DRAWX), A
 327+ E69D 06 02            LD B, SPRID_WALK_E
 328+ E69F              .tgwtaApplyAnim:
 329+ E69F                  ; B = sprite base. Toggle frame 0/1 cada TGCS_WALK_ANIM_PERIOD.
 330+ E69F 3A A5 5F         LD A, (TownGateTimer)
 331+ E6A2 3C               INC A
 332+ E6A3 32 A5 5F         LD (TownGateTimer), A
 333+ E6A6 FE 04            CP TGCS_WALK_ANIM_PERIOD
 334+ E6A8 38 0C            JR C, .tgwtaSameFrame
 335+ E6AA AF               XOR A
 336+ E6AB 32 A5 5F         LD (TownGateTimer), A
 337+ E6AE 3A A9 5F         LD A, (TownGateExitWalkFrame)
 338+ E6B1 EE 01            XOR 1
 339+ E6B3 32 A9 5F         LD (TownGateExitWalkFrame), A
 340+ E6B6              .tgwtaSameFrame:
 341+ E6B6 3A A9 5F         LD A, (TownGateExitWalkFrame)
 342+ E6B9 80               ADD A, B
 343+ E6BA DD 77 00         LD (IX+ENT_SPRITEID), A
 344+ E6BD C3 57 6D         JP TownGateRedrawPlayer_B7             ; tail call
 345+ E6C0
 346+ E6C0              .tgwtaArrived:
 347+ E6C0                  ; Llegado a anchor1: pose static WALK_N+1 + transicion a LOCK.
 348+ E6C0 3E 0B            LD A, SPRID_WALK_N + 1              ; frame 2o de Walk North (mirando arriba)
 349+ E6C2 DD 77 00         LD (IX+ENT_SPRITEID), A
 350+ E6C5 3E 0A            LD A, SPRID_WALK_N
 351+ E6C7 DD 77 08         LD (IX+ENT_ANIMBASE), A
 352+ E6CA AF               XOR A
 353+ E6CB DD 77 09         LD (IX+ENT_ANIMTIMER), A
 354+ E6CE CD 57 6D         CALL TownGateRedrawPlayer_B7
 355+ E6D1 3E 3C            LD A, TGCS_T_LOCK
 356+ E6D3 32 A5 5F         LD (TownGateTimer), A
 357+ E6D6 3E 01            LD A, TGP_LOCK
 358+ E6D8 32 D0 82         LD (TownGatePhase), A
 359+ E6DB C9               RET
