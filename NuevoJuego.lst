2670+ DA54 C8               RET Z                       ; nada erased sobre un pickup -> no-op
2671+ DA55 AF               XOR A
2672+ DA56 32 15 83         LD (PickupAttrsDirty), A
2673+ DA59 21 D9 DF         LD HL, PickupTable
