 381+ E701 3E 01            LD A, TGCS_T_FINGER_IN
 382+ E703 32 A5 5F         LD (TownGateTimer), A
 383+ E706 3E 03            LD A, TGP_FINGER_IN
 384+ E708 32 D0 82         LD (TownGatePhase), A
 385+ E70B C9               RET
