 300+ EA4C              ; ==============================================================================
 301+ EA4C              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 302+ EA4C              ; ==============================================================================
 303+ EA4C              ; PickupTable layout (per-entry, 7 bytes):
 304+ EA4C              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 305+ EA4C              ; Terminator: $FF (single byte).
 306+ EA4C              ;
 307+ EA4C              ; IN:  DE = ptr a buscar
 308+ EA4C              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 309+ EA4C              ;      B = C = $FF si no encontrado (Z).
 310+ EA4C              ; Destruye: AF, HL. Preserva DE.
 311+ EA4C              ; ==============================================================================
 312+ EA4C              FindPickupScreen:
 313+ EA4C 21 E0 D9         LD HL, PickupTable
 314+ EA4F              .fpsLoop:
 315+ EA4F 7E               LD A, (HL)
 316+ EA50 FE FF            CP $FF
 317+ EA52 28 1C            JR Z, .fpsNotFound
 318+ EA54 E5               PUSH HL
 319+ EA55 23               INC HL                              ; -> mapY
 320+ EA56 23               INC HL                              ; -> ptr_lo
 321+ EA57 7E               LD A, (HL)
 322+ EA58 BB               CP E
 323+ EA59 20 0C            JR NZ, .fpsNoMatch
 324+ EA5B 23               INC HL                              ; -> ptr_hi
 325+ EA5C 7E               LD A, (HL)
 326+ EA5D BA               CP D
 327+ EA5E 20 07            JR NZ, .fpsNoMatch
 328+ EA60 E1               POP HL                              ; back to entry start (mapX)
 329+ EA61 46               LD B, (HL)                          ; B = mapX
 330+ EA62 23               INC HL
 331+ EA63 4E               LD C, (HL)                          ; C = mapY
 332+ EA64 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 333+ EA66 C9               RET
 334+ EA67              .fpsNoMatch:
 335+ EA67 E1               POP HL
 336+ EA68 C5               PUSH BC
 337+ EA69 01 07 00         LD BC, 7
 338+ EA6C 09               ADD HL, BC
 339+ EA6D C1               POP BC
 340+ EA6E 18 DF            JR .fpsLoop
 341+ EA70              .fpsNotFound:
 342+ EA70 06 FF            LD B, $FF
 343+ EA72 0E FF            LD C, $FF
 344+ EA74 AF               XOR A                               ; set Z
 345+ EA75 C9               RET
