 884+ D4FF              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 885+ D4FF              ; ==============================================================================
 886+ D4FF              ; Entrada: A = attr byte
 887+ D4FF              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 888+ D4FF              ; Preserva: HL, DE, BC, IX
 889+ D4FF              ; ==============================================================================
 890+ D4FF              ApplyTintSwap:
 891+ D4FF C5               PUSH BC
