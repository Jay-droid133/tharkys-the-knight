7407+ CBE4              ; --- bfsCanFit: footprint 3x3 de Death en CollisionMap libre? ---
7408+ CBE4              ; IN: DBfsTryCx, DBfsTryCy. OUT: Z=libre, NZ=bloqueado.
7409+ CBE4              .bfsCanFit:
7410+ CBE4 3A 79 5F         LD A, (DBfsTryCy)
7411+ CBE7 26 00            LD H, 0
7412+ CBE9 6F               LD L, A
7413+ CBEA 29               ADD HL, HL
7414+ CBEB 29               ADD HL, HL
7415+ CBEC 29               ADD HL, HL
7416+ CBED 29               ADD HL, HL
7417+ CBEE 29               ADD HL, HL                          ; HL = cy*32
7418+ CBEF 3A 78 5F         LD A, (DBfsTryCx)
7419+ CBF2 85               ADD A, L
7420+ CBF3 6F               LD L, A
7421+ CBF4 30 01            JR NC, .cfNoCarry
7422+ CBF6 24               INC H
7423+ CBF7              .cfNoCarry:
7424+ CBF7 11 C7 82         LD DE, CollisionMap
7425+ CBFA 19               ADD HL, DE                          ; HL = &CollisionMap[cy][cx]
7426+ CBFB 0E 03            LD C, 3                             ; filas restantes
7427+ CBFD              .cfRow:
