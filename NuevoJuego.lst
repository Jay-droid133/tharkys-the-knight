 462+ 7090 FE 38            CP PROB_RAYO_END
 463+ 7092 DA 01 71         JP C, .urpDoRayo
 464+ 7095 FE 48            CP PROB_CARACOL_END
 465+ 7097 DA 0B 71         JP C, .urpDoCaracol
 466+ 709A FE 58            CP PROB_ROULETTE_END
 467+ 709C DA 29 71         JP C, .urpDoRoulette
 468+ 709F FE 68            CP PROB_MUSHROOM_END
 469+ 70A1 DA 15 71         JP C, .urpDoMushroom
 470+ 70A4 FE 70            CP PROB_COMPASS_END
 471+ 70A6 DA 1F 71         JP C, .urpDoCompass
