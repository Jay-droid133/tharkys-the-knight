2462+ D90F 3A 98 81         LD A, (EntityTable + ENT_POSY)
2463+ D912 4F               LD C, A
2464+ D913 C6 10            ADD A, 16
2465+ D915 57               LD D, A
2466+ D916 3A FB D9         LD A, (.cbtSpY)
2467+ D919 D6 04            SUB 4
2468+ D91B 30 01            JR NC, .cbtNoUnderflowT
2469+ D91D AF               XOR A
2470+ D91E              .cbtNoUnderflowT:
2471+ D91E BA               CP D
2472+ D91F D2 E4 D9         JP NC, .cbtPopNext
2473+ D922 3A FD D9         LD A, (.cbtSpH)
