2063+ AA5F              ; ==============================================================================
2064+ AA5F              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2065+ AA5F              ; ==============================================================================
2066+ AA5F              UpdateStamina:
2067+ AA5F                  ; --- Regenerar salud (1 unidad cada HEALTH_REGEN_RATE = 100 f = 4 s) ---
2068+ AA5F 3A 72 B3         LD A, (PlayerHealth)
2069+ AA62 FE 10            CP HEALTH_MAX
2070+ AA64 28 12            JR Z, .usHealthFull
2071+ AA66 21 76 B3         LD HL, HealthRegenCtr
2072+ AA69 34               INC (HL)
2073+ AA6A 7E               LD A, (HL)
2074+ AA6B FE 64            CP HEALTH_REGEN_RATE
2075+ AA6D 38 09            JR C, .usHealthFull
2076+ AA6F 36 00            LD (HL), 0
2077+ AA71 3A 72 B3         LD A, (PlayerHealth)
2078+ AA74 3C               INC A
2079+ AA75 32 72 B3         LD (PlayerHealth), A
2080+ AA78              .usHealthFull:
2081+ AA78                  ; --- Stamina: consumir o regenerar ---
2082+ AA78 DD 7E 02         LD A, (IX+ENT_STATE)
2083+ AA7B FE 02            CP STATE_FIGHTING
2084+ AA7D 28 18            JR Z, .usDrain
2085+ AA7F                  ; --- Regenerar stamina (1 unidad cada STAMINA_REGEN_RATE = 50 f = 2 s) ---
2086+ AA7F 3A 73 B3         LD A, (PlayerStamina)
2087+ AA82 FE 10            CP STAMINA_MAX
2088+ AA84 C8               RET Z                               ; Ya al maximo
2089+ AA85 21 75 B3         LD HL, StaminaRegenCtr
2090+ AA88 34               INC (HL)
2091+ AA89 7E               LD A, (HL)
2092+ AA8A FE 32            CP STAMINA_REGEN_RATE
2093+ AA8C D8               RET C                               ; Aun no toca
2094+ AA8D 36 00            LD (HL), 0                          ; Reset counter
2095+ AA8F 3A 73 B3         LD A, (PlayerStamina)
2096+ AA92 3C               INC A
2097+ AA93 32 73 B3         LD (PlayerStamina), A
2098+ AA96 C9               RET
2099+ AA97              .usDrain:
2100+ AA97                  ; Atacando: consumir stamina
2101+ AA97                  ; ESPADA buff activo -> no consume stamina (gate).
2102+ AA97 3A DA 5F         LD A, (EspadaTimer)
2103+ AA9A 21 DB 5F         LD HL, EspadaTimer + 1
2104+ AA9D B6               OR (HL)
2105+ AA9E C0               RET NZ                              ; Espada activa: skip drain
2106+ AA9F 3A 73 B3         LD A, (PlayerStamina)
2107+ AAA2 B7               OR A
2108+ AAA3 C8               RET Z                               ; Ya vacia
2109+ AAA4 21 74 B3         LD HL, StaminaDrainCtr
2110+ AAA7 34               INC (HL)
2111+ AAA8 7E               LD A, (HL)
2112+ AAA9 FE 0D            CP STAMINA_DRAIN_RATE
2113+ AAAB D8               RET C
2114+ AAAC 36 00            LD (HL), 0
2115+ AAAE 3A 73 B3         LD A, (PlayerStamina)
2116+ AAB1 3D               DEC A
2117+ AAB2 32 73 B3         LD (PlayerStamina), A
2118+ AAB5                  ; Si stamina llega a 0, dar 1 punto tras cooldown
2119+ AAB5 B7               OR A
2120+ AAB6 C0               RET NZ
2121+ AAB7 3E 01            LD A, 1
2122+ AAB9 32 73 B3         LD (PlayerStamina), A               ; Minimo 1 para un swing
2123+ AABC C9               RET
2124+ AABD
2125+ AABD              ; ==============================================================================
2126+ AABD              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2127+ AABD              ; ==============================================================================
2128+ AABD              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2129+ AABD              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2130+ AABD              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2131+ AABD              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2132+ AABD              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2133+ AABD              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2134+ AABD              ; ==============================================================================
2135+ AABD              SelectSwordMode:
2136+ AABD                  ; ESPADA buff: fuerza mode 2 (libre) sin importar stamina (ataque a 0 OK).
2137+ AABD 3A DA 5F         LD A, (EspadaTimer)
2138+ AAC0 21 DB 5F         LD HL, EspadaTimer + 1
2139+ AAC3 B6               OR (HL)
2140+ AAC4 28 04            JR Z, .smCheckStamina
2141+ AAC6 3E 02            LD A, 2                             ; ESPADA: siempre libre
2142+ AAC8 18 14            JR .smSet
2143+ AACA              .smCheckStamina:
2144+ AACA 3A 73 B3         LD A, (PlayerStamina)
2145+ AACD FE 0C            CP STAMINA_THRESHOLD_HIGH
2146+ AACF 38 04            JR C, .smNotHigh
2147+ AAD1 3E 02            LD A, 2                             ; Libre (continuo)
2148+ AAD3 18 09            JR .smSet
2149+ AAD5              .smNotHigh:
2150+ AAD5 FE 07            CP STAMINA_THRESHOLD_MID
2151+ AAD7 38 04            JR C, .smNotMid
2152+ AAD9 3E 01            LD A, 1                             ; Fixed swing
2153+ AADB 18 01            JR .smSet
2154+ AADD              .smNotMid:
2155+ AADD AF               XOR A                               ; Cooldown (0)
2156+ AADE              .smSet:
2157+ AADE 32 71 B3         LD (SwordMode), A
2158+ AAE1 B7               OR A
2159+ AAE2 C8               RET Z                               ; Mode B → cooldown legítimo, no tocar
2160+ AAE3                  ; Mode C/Free: cooldown sin sentido. Limpiar + reset color si quedó azul.
2161+ AAE3 AF               XOR A
2162+ AAE4 32 6E B3         LD (AttackCooldown), A
2163+ AAE7 3A A2 81         LD A, (EntityTable + ENT_ATTR)
2164+ AAEA FE 41            CP BLUE | $40
2165+ AAEC C0               RET NZ                              ; No estaba azul → nada que hacer
2166+ AAED 3A 1E C5         LD A, (PlayerHitTimer)
2167+ AAF0 B7               OR A
2168+ AAF1 C0               RET NZ                              ; En flash de daño → no pisar el rojo
2169+ AAF2 3E 47            LD A, WHITE | $40
2170+ AAF4 32 A2 81         LD (EntityTable + ENT_ATTR), A
2171+ AAF7 C9               RET
2172+ AAF8
2173+ AAF8              ; ==============================================================================
2174+ AAF8              ; GetStaminaColor - Devuelve color del player segun estado actual
2175+ AAF8              ; ==============================================================================
2176+ AAF8              ; Salida: A = atributo de color (bright)
2177+ AAF8              ; ==============================================================================
2178+ AAF8              GetStaminaColor:
2179+ AAF8 3A 71 B3         LD A, (SwordMode)
2180+ AAFB B7               OR A
2181+ AAFC 20 09            JR NZ, .gscWhite                   ; Modo C o libre → blanco
2182+ AAFE 3A 6E B3         LD A, (AttackCooldown)
2183+ AB01 B7               OR A
2184+ AB02 28 03            JR Z, .gscWhite
2185+ AB04 3E 41            LD A, BLUE | $40                    ; Modo B + cooldown activo → azul
2186+ AB06 C9               RET
2187+ AB07              .gscWhite:
2188+ AB07 3E 47            LD A, WHITE | $40                   ; Normal → blanco
2189+ AB09 C9               RET
2190+ AB0A
2191+ AB0A              ; ==============================================================================
2192+ AB0A              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2193+ AB0A              ; ==============================================================================
2194+ AB0A              CheckWellPickup:
2195+ AB0A 3A 59 8D         LD A, (WellActive)
2196+ AB0D B7               OR A
2197+ AB0E C8               RET Z                               ; No hay pozo en esta pantalla
2198+ AB0F                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2199+ AB0F 2A 5D 8D         LD HL, (WellCooldownTimer)
2200+ AB12 7C               LD A, H
2201+ AB13 B5               OR L
2202+ AB14 C0               RET NZ                              ; timer > 0 → skip
2203+ AB15                  ; Ya esta al maximo? No hacer nada
2204+ AB15 3A 72 B3         LD A, (PlayerHealth)
2205+ AB18 FE 10            CP HEALTH_MAX
2206+ AB1A 20 06            JR NZ, .cwDoCheck
2207+ AB1C 3A 73 B3         LD A, (PlayerStamina)
2208+ AB1F FE 10            CP STAMINA_MAX
2209+ AB21 C8               RET Z                               ; Ambos al maximo → nada
2210+ AB22              .cwDoCheck:
2211+ AB22                  ; AABB con margen de 8px (1 celda) por cada lado:
2212+ AB22                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2213+ AB22                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2214+ AB22                  ; --- Check X ---
2215+ AB22 3A 5A 8D         LD A, (WellPosX)
2216+ AB25 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2217+ AB27 4F               LD C, A
2218+ AB28 3A A0 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2219+ AB2B B9               CP C                                ; playerX < wellRight+margen?
2220+ AB2C 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2221+ AB2E 3A A0 81         LD A, (EntityTable + ENT_POSX)
