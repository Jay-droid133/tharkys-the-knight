 758+ E0FC 09               ADD HL, BC                  ; HL = font data
 759+ E0FD
 760+ E0FD                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 761+ E0FD 16 40            LD D, $40                   ; Tercio 0, scan line 0
 762+ E0FF 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 763+ E101 83               ADD A, E
 764+ E102 5F               LD E, A                     ; DE = dir VRAM
