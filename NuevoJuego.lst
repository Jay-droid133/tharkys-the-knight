 190+ 912C 13               INC DE
 191+ 912D                  ; Copiar W|RLE (header byte 1)
 192+ 912D 7E               LD A, (HL)
 193+ 912E 12               LD (DE), A
 194+ 912F 23               INC HL
 195+ 9130 13               INC DE
 196+ 9131 CB 7F            BIT 7, A
 197+ 9133 20 47            JR NZ, .lbsRleFallback
 198+ 9135 E6 7F            AND $7F
 199+ 9137 32 98 91         LD (.lbsWsave), A
 200+ 913A                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 913A 3A 97 91         LD A, (.lbsHsave)
 202+ 913D B7               OR A
 203+ 913E 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 9140 47               LD B, A                         ; B = H (outer loop)
