 493+ A0A1              ; ==============================================================================
 494+ A0A1              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 495+ A0A1              ; ==============================================================================
 496+ A0A1              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 497+ A0A1              ; ==============================================================================
 498+ A0A1              ProcessOneEnemy:
 499+ A0A1                  ; --- Frozen monster gate (durante muerte del player) ---
 500+ A0A1                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 501+ A0A1                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 502+ A0A1                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 503+ A0A1 3A F0 82         LD A, (MonstersFrozen)
 504+ A0A4 B7               OR A
 505+ A0A5 28 08            JR Z, .peDispatch
 506+ A0A7 DD 7E 01         LD A, (IX+ENT_TYPE)
 507+ A0AA FE 02            CP TYPE_MONSTER
 508+ A0AC CA 14 A1         JP Z, .peCalcAndDraw
 509+ A0AF              .peDispatch:
 510+ A0AF                  ; --- Dispatch segun estado ---
 511+ A0AF DD 7E 02         LD A, (IX+ENT_STATE)
 512+ A0B2 FE 03            CP STATE_DYING
 513+ A0B4 CA 26 A3         JP Z, .peDying
 514+ A0B7 FE 04            CP STATE_SPAWNING
 515+ A0B9 CA DB A3         JP Z, .peSpawning
 516+ A0BC FE 05            CP STATE_SCARED
 517+ A0BE CA 03 A2         JP Z, .peScared
 518+ A0C1 FE 06            CP STATE_ATTACKING
 519+ A0C3 CA F6 A1         JP Z, .peAttacking
 520+ A0C6
 521+ A0C6                  ; === STATE_RUNNING ===
 522+ A0C6                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 523+ A0C6 3A EE B5         LD A, (ScareTimer)
 524+ A0C9 B7               OR A
 525+ A0CA 28 1E            JR Z, .peRunning
 526+ A0CC DD 7E 01         LD A, (IX+ENT_TYPE)
 527+ A0CF FE 03            CP TYPE_NASTY
 528+ A0D1 28 08            JR Z, .peDoScare
 529+ A0D3 FE 02            CP TYPE_MONSTER
 530+ A0D5 20 13            JR NZ, .peRunning
 531+ A0D7                  ; Monster: limpiar stun antes de asustar
 532+ A0D7 DD 36 0A 00      LD (IX+ENT_DIR), 0
 533+ A0DB              .peDoScare:
 534+ A0DB DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 535+ A0DF DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 536+ A0E3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 537+ A0E7 C3 03 A2         JP .peScared
 538+ A0EA              .peRunning:
 539+ A0EA DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 540+ A0EE C2 9A A1         JP NZ, .peFresh
