 361+ 700E 4E               LD C, (HL)                          ; C = charY
 362+ 700F E5               PUSH HL                             ; save HL @ charY
 363+ 7010 87               ADD A, A                            ; A = count*2
 364+ 7011 6F               LD L, A
 365+ 7012 26 00            LD H, 0
 366+ 7014 11 AC 5F         LD DE, RandomSlotList
 367+ 7017 19               ADD HL, DE
 368+ 7018 70               LD (HL), B                          ; charX
 369+ 7019 23               INC HL
 370+ 701A 71               LD (HL), C                          ; charY
 371+ 701B 21 AB 5F         LD HL, RandomSlotCount
 372+ 701E 34               INC (HL)
 373+ 701F E1               POP HL                              ; HL @ charY
 374+ 7020 23               INC HL                              ; HL @ v
 375+ 7021 23               INC HL                              ; HL @ next id
 376+ 7022 18 D7            JR .urpScanLoop
 377+ 7024              .urpSkipEntry:
 378+ 7024                  ; Skip entry: 4 bytes (id, charX, charY, v).
 379+ 7024 23               INC HL
 379+ 7025 23             INC HL
 379+ 7026 23             INC HL
 379+ 7027 23             INC HL
 380+ 7028 18 D1            JR .urpScanLoop
 381+ 702A              .urpScanDone:
