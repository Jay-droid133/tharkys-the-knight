 852+ E15D
 853+ E15D              ; ==============================================================================
 854+ E15D              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 855+ E15D              ; ==============================================================================
 856+ E15D              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 857+ E15D              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 858+ E15D              ;
 859+ E15D              ; Estado:
 860+ E15D              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 861+ E15D              ;   BankCutsceneTimer:    decrementa por frame
 862+ E15D              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 863+ E15D              ;
 864+ E15D              ; Logica:
 865+ E15D              ;   - Tick timer. Si != 0, return 0.
 866+ E15D              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 867+ E15D              ;   - Si SubState=GAP y timer=0:
 868+ E15D              ;       - increment KnockIdx
 869+ E15D              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 870+ E15D              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 871+ E15D              ;
 872+ E15D              ; Destruye: A, BC, DE, HL.
 873+ E15D              ; ==============================================================================
 874+ E15D              BankCutsceneTickKnockGroup:
 875+ E15D 47               LD B, A                             ; B = total knocks
 876+ E15E 3A C3 82         LD A, (BankCutsceneTimer)
 877+ E161 3D               DEC A
 878+ E162 32 C3 82         LD (BankCutsceneTimer), A
 879+ E165 B7               OR A
 880+ E166 28 02            JR Z, .bctkgTimer0
 881+ E168 AF               XOR A                               ; sigue, no terminado
 882+ E169 C9               RET
 883+ E16A              .bctkgTimer0:
 884+ E16A 3A C4 82         LD A, (BankCutsceneSubState)
 885+ E16D B7               OR A
 886+ E16E 20 0C            JR NZ, .bctkgGap0
 887+ E170                  ; HIT acabo: switch a GAP.
 888+ E170 3E 01            LD A, BCS_KNOCK_GAP
 889+ E172 32 C4 82         LD (BankCutsceneSubState), A
 890+ E175 3E 05            LD A, BCS_T_KNOCK_GAP
 891+ E177 32 C3 82         LD (BankCutsceneTimer), A
 892+ E17A AF               XOR A
 893+ E17B C9               RET
 894+ E17C              .bctkgGap0:
 895+ E17C                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 896+ E17C 3A C5 82         LD A, (BankCutsceneKnockIdx)
 897+ E17F 3C               INC A
 898+ E180 32 C5 82         LD (BankCutsceneKnockIdx), A
 899+ E183 B8               CP B
 900+ E184 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 901+ E186                  ; grupo terminado.
 902+ E186 3E 01            LD A, 1
 903+ E188 C9               RET
 904+ E189              .bctkgNextHit:
 905+ E189 3E 00            LD A, BCS_KNOCK_HIT
 906+ E18B 32 C4 82         LD (BankCutsceneSubState), A
 907+ E18E 3E 04            LD A, BCS_T_KNOCK_HIT
 908+ E190 32 C3 82         LD (BankCutsceneTimer), A
 909+ E193 CD 98 E1         CALL BankCutsceneEmitKnockHit
 910+ E196 AF               XOR A
 911+ E197 C9               RET
 912+ E198
 913+ E198              ; ==============================================================================
 914+ E198              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 915+ E198              ; ==============================================================================
 916+ E198              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 917+ E198              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 918+ E198              ; Destruye: A, BC, DE, HL.
 919+ E198              ; ==============================================================================
 920+ E198              BankCutsceneEmitKnockHit:
 921+ E198 C3 1A E2         JP SFX_Bank_OnKnock                 ; tail-call
 922+ E19B
 923+ E19B              ; ==============================================================================
 924+ E19B              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 925+ E19B              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 926+ E19B              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 927+ E19B              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 928+ E19B              ; oscuridad de la rendija".
 929+ E19B              BCS_DOOR_HAND_ATTR      EQU $47
 930+ E19B
 931+ E19B              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 932+ E19B              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 933+ E19B              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 934+ E19B              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 935+ E19B              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 936+ E19B
 937+ E19B              ; ==============================================================================
 938+ E19B              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 939+ E19B              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 940+ E19B              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 941+ E19B              ; pixels visibles bright white sobre fondo negro.
 942+ E19B              ;
 943+ E19B              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 944+ E19B              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 945+ E19B              ; dos llamadas no cancelan, solo re-pintan.
 946+ E19B              ; Destruye: AF, BC, DE, HL, IX.
 947+ E19B              ; ==============================================================================
 948+ E19B              BankCutsceneOpenDoorWithHandAttrs:
 949+ E19B 21 CA F4         LD HL, BgGfx_bank_door_closed
 950+ E19E 3E 03            LD A, 3                             ; bank 3
 951+ E1A0 CD 47 6D         CALL LoadBgSpriteToBuffer_B7        ; thunk slot 1: carga + repagina bank 7 al RET
 952+ E1A3 DD 21 EE 86      LD IX, BgSpriteBuffer
 953+ E1A7 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 954+ E1A9 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 955+ E1AB CD 08 6D         CALL DrawBgSpriteXOR_B7             ; XOR-cancel pixels (attrs intactos $78)
 956+ E1AE                  ; Sobreescribir attrs a "hand mode" = $47.
 957+ E1AE 3E 47            LD A, BCS_DOOR_HAND_ATTR
 958+ E1B0 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 959+ E1B3 77               LD (HL), A
 960+ E1B4 23               INC HL                              ; $58D0 (16, 4)
 961+ E1B5 77               LD (HL), A
 962+ E1B6 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 963+ E1B9 77               LD (HL), A
 964+ E1BA 23               INC HL                              ; $58F0 (16, 5)
 965+ E1BB 77               LD (HL), A
 966+ E1BC C9               RET
 967+ E1BD
 968+ E1BD              ; ==============================================================================
 969+ E1BD              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 970+ E1BD              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 971+ E1BD              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 972+ E1BD              ;
 973+ E1BD              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 974+ E1BD              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 975+ E1BD              ; Destruye: AF, BC, DE, HL, IX.
 976+ E1BD              ; ==============================================================================
 977+ E1BD              BankCutsceneCloseDoorRestoreAttrs:
 978+ E1BD 21 CA F4         LD HL, BgGfx_bank_door_closed
 979+ E1C0 3E 03            LD A, 3
 980+ E1C2 CD 47 6D         CALL LoadBgSpriteToBuffer_B7        ; thunk: carga + repagina bank 7
 981+ E1C5 DD 21 EE 86      LD IX, BgSpriteBuffer
 982+ E1C9 06 0F            LD B, BCS_DOOR_CHARX
 983+ E1CB 0E 04            LD C, BCS_DOOR_CHARY
 984+ E1CD                  ; BgSpriteIsHouse + CurrentTintVar viven en bank 0. El thunk DrawBgGfxSprite_B7
 985+ E1CD                  ; ahora hace las dos escrituras (XOR A; LD (BgSpriteIsHouse), A; LD A, $FF;
 986+ E1CD                  ; LD (CurrentTintVar), A) DENTRO del wrap con bank 0 paginated antes del CALL
 987+ E1CD                  ; DrawBgGfxSprite. Sin esto el draw usaria valores stale -> tint/attr
 988+ E1CD                  ; incorrectos -> puerta invisible. (Fusionado para ahorrar 18 B en slot 1.)
 989+ E1CD C3 11 6D         JP DrawBgGfxSprite_B7               ; tail-call thunk: paginate bank 0, set flags, draw, repaginate bank 7
 990+ E1D0
 991+ E1D0              ; ==============================================================================
 992+ E1D0              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 993+ E1D0              ; ==============================================================================
 994+ E1D0              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 995+ E1D0              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 996+ E1D0              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 997+ E1D0              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 998+ E1D0              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 999+ E1D0              ; Destruye: AF, BC, DE, HL, IX.
1000+ E1D0              ; ==============================================================================
1001+ E1D0              BankCutsceneDrawHand:
1002+ E1D0 3A C7 82         LD A, (BankCutsceneHandFrame)
1003+ E1D3 B7               OR A
1004+ E1D4 20 05            JR NZ, .bcdhFrame1
1005+ E1D6 21 51 E2         LD HL, BgGfx_BankHandFrame0
1006+ E1D9 18 03            JR .bcdhCopy
1007+ E1DB              .bcdhFrame1:
1008+ E1DB 21 73 E2         LD HL, BgGfx_BankHandFrame1
1009+ E1DE              .bcdhCopy:
1010+ E1DE 11 EE 86         LD DE, BgSpriteBuffer
1011+ E1E1 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
1012+ E1E4 ED B0            LDIR
1013+ E1E6 16 30            LD D, BCS_HAND_PX_Y
1014+ E1E8 1E 78            LD E, BCS_HAND_PX_X
1015+ E1EA C3 39 66         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
1016+ E1ED
1017+ E1ED              ; ==============================================================================
1018+ E1ED              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
1019+ E1ED              ; ==============================================================================
1020+ E1ED              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
1021+ E1ED              ; Destruye: AF, BC, DE, HL, IX.
1022+ E1ED              ; ==============================================================================
1023+ E1ED              BankCutsceneEraseHand:
1024+ E1ED C3 D0 E1         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
1025+ E1F0
1026+ E1F0              ; ==============================================================================
1027+ E1F0              ; BankCutsceneDrawHandOpen - draw mano abierta (palma) en (BCS_HAND_PX_X, Y)
1028+ E1F0              ; ==============================================================================
1029+ E1F0              ; Dispatcher por BankCutsceneHandFrame (mismo patron que BankCutsceneDrawHand
1030+ E1F0              ; para "no no"):
1031+ E1F0              ;   HandFrame=0 -> BgGfx_BankHandOpen1 (frame 1, primera pose)
1032+ E1F0              ;   HandFrame=1 -> BgGfx_BankHandOpen2 (frame 2, segunda pose, FINAL)
1033+ E1F0              ; Sprites 16x16 inline (34 B cada uno), CPL'd. La mano abierta usa la misma
1034+ E1F0              ; posicion que la "no no" (centrada en la rendija de la puerta) y comparte
1035+ E1F0              ; attrs $47 ya seteados por BankCutsceneOpenDoorWithHandAttrs.
1036+ E1F0              ; Destruye: AF, BC, DE, HL, IX.
1037+ E1F0              ; ==============================================================================
1038+ E1F0              BankCutsceneDrawHandOpen:
1039+ E1F0 3A C7 82         LD A, (BankCutsceneHandFrame)
1040+ E1F3 B7               OR A
1041+ E1F4 20 05            JR NZ, .bcdhoFrame2
1042+ E1F6 21 95 E2         LD HL, BgGfx_BankHandOpen1
1043+ E1F9 18 03            JR .bcdhoCopy
1044+ E1FB              .bcdhoFrame2:
1045+ E1FB 21 B7 E2         LD HL, BgGfx_BankHandOpen2
1046+ E1FE              .bcdhoCopy:
1047+ E1FE 11 EE 86         LD DE, BgSpriteBuffer
1048+ E201 01 22 00         LD BC, 34                           ; header 2 + pixel data 32
1049+ E204 ED B0            LDIR
1050+ E206 16 30            LD D, BCS_HAND_PX_Y
1051+ E208 1E 78            LD E, BCS_HAND_PX_X
1052+ E20A C3 39 66         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
1053+ E20D
1054+ E20D              ; ==============================================================================
1055+ E20D              ; BankCutsceneEraseHandOpen - XOR self-cancel de la mano abierta
1056+ E20D              ; ==============================================================================
1057+ E20D              ; Mismo draw — XOR self-cancela.
1058+ E20D              ; Destruye: AF, BC, DE, HL, IX.
