 485+ 8FBD              ; MaiPickRandomGap
 486+ 8FBD              ; ==============================================================================
 487+ 8FBD              ; Selecciona un opening aleatorio del screen actual (ScreenGaps en bank 6) y
 488+ 8FBD              ; traduce (side, coord) a posicion pixel con MAI_ENTRY_OFFSET aplicado.
 489+ 8FBD              ;
 490+ 8FBD              ; Output:
 491+ 8FBD              ;   A = 0 exito; (MaiSpawnX), (MaiSpawnY) contienen posicion spawn
 492+ 8FBD              ;   A = 1 no hay gaps validos; el caller debe usar fallback (LastEntryPos)
 493+ 8FBD              ; Destruye: AF, BC, DE, HL
 494+ 8FBD              ; ==============================================================================
 495+ 8FBD              MaiPickRandomGap:
 496+ 8FBD                  ; screen_id = Y * 16 + X
 497+ 8FBD 3A 0E 83         LD A, (CurrentScreenY)
