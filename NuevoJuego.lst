 602+ EFC4              ; ==============================================================================
 603+ EFC4              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ EFC4              ; ==============================================================================
 605+ EFC4
 606+ EFC4              ; ==============================================================================
 607+ EFC4              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ EFC4              ; ==============================================================================
 609+ EFC4              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ EFC4              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ EFC4              ; ==============================================================================
 612+ EFC4              BuildPlazaScanAddrs:
 613+ EFC4                  ; Calcular pixel coords del top-left de la esfera
 614+ EFC4 3A C6 90         LD A, (PlazaClockCharY)
 615+ EFC7 07               RLCA
 616+ EFC8 07               RLCA
 617+ EFC9 07               RLCA
 618+ EFCA 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EFCB 3A C5 90         LD A, (PlazaClockCharX)
 620+ EFCE 07               RLCA
 621+ EFCF 07               RLCA
 622+ EFD0 07               RLCA
 623+ EFD1 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EFD2 CD A5 A0         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EFD5
 626+ EFD5 DD 21 C7 90      LD IX, PlazaScanAddrs
 627+ EFD9 06 10            LD B, 16
 628+ EFDB              .buildLoop:
 629+ EFDB DD 75 00         LD (IX+0), L
 630+ EFDE DD 74 01         LD (IX+1), H
 631+ EFE1 DD 23            INC IX
 632+ EFE3 DD 23            INC IX
 633+ EFE5 05               DEC B
 634+ EFE6 C8               RET Z
 635+ EFE7 CD 11 9E         CALL NextPixelLine
 636+ EFEA 18 EF            JR .buildLoop
 637+ EFEC
 638+ EFEC              ; ==============================================================================
 639+ EFEC              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EFEC              ; ==============================================================================
 641+ EFEC              ; Llamar cada frame desde el main loop.
 642+ EFEC              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EFEC              ; ==============================================================================
 644+ EFEC              DrawPlazaClock:
 645+ EFEC 3A C4 90         LD A, (PlazaClockActive)
 646+ EFEF B7               OR A
 647+ EFF0 C8               RET Z
 648+ EFF1
 649+ EFF1                  ; --- Calcular posicion actual de las agujas ---
 650+ EFF1 3A 63 EB         LD A, (GameHours)
 651+ EFF4 FE 0C            CP 12
 652+ EFF6 38 02            JR C, .pCalcHourOk
 653+ EFF8 D6 0C            SUB 12
 654+ EFFA              .pCalcHourOk:
 655+ EFFA 57               LD D, A                     ; D = display hour (0-11)
 656+ EFFB 3A 62 EB         LD A, (GameMinutes)
 657+ EFFE 1E 00            LD E, 0
 658+ F000              .pCalcDiv5:
 659+ F000 FE 05            CP 5
 660+ F002 38 05            JR C, .pCalcMinOk
 661+ F004 D6 05            SUB 5
 662+ F006 1C               INC E
 663+ F007 18 F7            JR .pCalcDiv5
 664+ F009              .pCalcMinOk:
 665+ F009                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ F009
 667+ F009                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ F009 3A 5D F0         LD A, (PlazaLastHour)
 669+ F00C BA               CP D
 670+ F00D 20 05            JR NZ, .pNeedsRedraw
 671+ F00F 3A 5E F0         LD A, (PlazaLastMin)
 672+ F012 BB               CP E
 673+ F013 C8               RET Z                       ; sin cambio → no redibujar
 674+ F014
 675+ F014              .pNeedsRedraw:
 676+ F014 7A               LD A, D
 677+ F015 32 5D F0         LD (PlazaLastHour), A
 678+ F018 7B               LD A, E
 679+ F019 32 5E F0         LD (PlazaLastMin), A
 680+ F01C
 681+ F01C                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ F01C                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ F01C DD 21 9A 8D      LD IX, PlazaClockPixels
 684+ F020 FD 21 C7 90      LD IY, PlazaScanAddrs
 685+ F024 06 10            LD B, 16
 686+ F026              .faceRow:
 687+ F026 FD 6E 00         LD L, (IY+0)
 688+ F029 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ F02C DD 7E 00         LD A, (IX+0)
 690+ F02F 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ F030 77               LD (HL), A                  ; byte izquierdo
 692+ F031 23               INC HL
 693+ F032 DD 7E 01         LD A, (IX+1)
 694+ F035 2F               CPL
 695+ F036 77               LD (HL), A                  ; byte derecho
 696+ F037 DD 23            INC IX
 697+ F039 DD 23            INC IX
 698+ F03B FD 23            INC IY
 699+ F03D FD 23            INC IY
 700+ F03F 10 E5            DJNZ .faceRow
 701+ F041
 702+ F041                  ; --- Aguja de horas ---
 703+ F041 3A 5D F0         LD A, (PlazaLastHour)
 704+ F044 21 5F EC         LD HL, HourHandPtrs
 705+ F047 CD 5F F0         CALL DrawPlazaHandLine
 706+ F04A
 707+ F04A                  ; --- Aguja de minutos ---
 708+ F04A 3A 5E F0         LD A, (PlazaLastMin)
 709+ F04D 21 7B EB         LD HL, MinHandPtrs
 710+ F050 CD 5F F0         CALL DrawPlazaHandLine
 711+ F053
 712+ F053                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ F053 21 D5 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ F056 7E               LD A, (HL)
 715+ F057 23               INC HL
 716+ F058 66               LD H, (HL)
 717+ F059 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ F05A CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ F05C C9               RET
 720+ F05D
 721+ F05D              ; Variables locales reloj plaza
 722+ F05D FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ F05E FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ F05F
 725+ F05F              ; ==============================================================================
 726+ F05F              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ F05F              ; ==============================================================================
 728+ F05F              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ F05F              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ F05F              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ F05F              ; ==============================================================================
 732+ F05F              DrawPlazaHandLine:
 733+ F05F                  ; Indexar en tabla de punteros
 734+ F05F 87               ADD A, A
 735+ F060 4F               LD C, A
 736+ F061 06 00            LD B, 0
 737+ F063 09               ADD HL, BC
 738+ F064 7E               LD A, (HL)
 739+ F065 23               INC HL
 740+ F066 66               LD H, (HL)
 741+ F067 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ F068
 743+ F068              .pxLoop:
 744+ F068 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ F069 B7               OR A
 746+ F06A C8               RET Z
 747+ F06B
 748+ F06B                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ F06B 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ F06C 23               INC HL
 751+ F06D 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ F06E 23               INC HL
 753+ F06F 56               LD D, (HL)                  ; D = mask
 754+ F070 23               INC HL
 755+ F071 E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ F072
 757+ F072                  ; --- Calcular scanLine (0-15) ---
 758+ F072 78               LD A, B
 759+ F073 E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ F075 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ F077 28 02            JR Z, .pxIsTop
 762+ F079 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ F07B              .pxIsTop:
 764+ F07B                  ; A = scanLine (0-15)
 765+ F07B
 766+ F07B                  ; --- Calcular colOffset (0 o 1) ---
 767+ F07B 5F               LD E, A                     ; E = scanLine (guardar)
 768+ F07C 79               LD A, C
 769+ F07D E6 1F            AND $1F                     ; extraer columna
 770+ F07F D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ F081 4F               LD C, A                     ; C = colOffset
 772+ F082
 773+ F082                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ F082 7B               LD A, E                     ; A = scanLine
 775+ F083 87               ADD A, A                    ; *2 (word index)
 776+ F084 21 C7 90         LD HL, PlazaScanAddrs
 777+ F087 85               ADD A, L
 778+ F088 6F               LD L, A
 779+ F089 30 01            JR NC, .pxNC
 780+ F08B 24               INC H
 781+ F08C              .pxNC:
 782+ F08C 7E               LD A, (HL)
 783+ F08D 23               INC HL
 784+ F08E 66               LD H, (HL)
 785+ F08F 81               ADD A, C                    ; sumar colOffset
 786+ F090 6F               LD L, A                     ; HL = dir VRAM destino
 787+ F091
 788+ F091                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ F091 7A               LD A, D
 790+ F092 2F               CPL
 791+ F093 A6               AND (HL)
 792+ F094 77               LD (HL), A
 793+ F095
 794+ F095 E1               POP HL                      ; restaurar puntero datos
 795+ F096 18 D0            JR .pxLoop
 796+ F098
# file closed: hud_clock.asm
 369  F098                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ F098              ; ==============================================================================
   2+ F098              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ F098              ; ==============================================================================
   4+ F098              ; CurrentObjective vive en variables.asm. Valor:
   5+ F098              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ F098              ;   9    = todos los hitos completados (juego ganado)
   7+ F098              ;
   8+ F098              ; ----------------------------------------------------------------------------
   9+ F098              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ F098              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ F098              ;                       recoger el sprite cuyo behavior coincide.
  12+ F098              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ F098              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ F098              ;                       Avanza al disparar el trigger correspondiente.
  15+ F098              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ F098              ;
  17+ F098              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ F098              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ F098              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ F098              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ F098              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ F098              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ F098              ;
  24+ F098              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ F098              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ F098              ; mecanica real.
  27+ F098              ; ==============================================================================
  28+ F098
  29+ F098              MILESTONE_TYPE_PICKUP   EQU 1
  30+ F098              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ F098              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ F098
  33+ F098              MilestoneTable:
  34+ F098 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ F09A 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ F09C 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ F09E 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ F0A0 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ F0A2 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ F0A4 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ F0A6 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ F0A8 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ F0AA
  44+ F0AA              MilestoneResolveTable:
  45+ F0AA 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ F0AC 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ F0AE 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ F0B0 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ F0B2 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ F0B4 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ F0B6 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ F0B8 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ F0BA 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ F0BC
  55+ F0BC              ; ==============================================================================
  56+ F0BC              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ F0BC              ; ==============================================================================
  58+ F0BC              ; IN:  A = key id (1..6) recien recogida
  59+ F0BC              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ F0BC              ; ==============================================================================
  61+ F0BC              CheckMilestonePickup:
  62+ F0BC E5               PUSH HL
  63+ F0BD D5               PUSH DE
  64+ F0BE C5               PUSH BC
  65+ F0BF F5               PUSH AF
  66+ F0C0 47               LD B, A                             ; B = key id recibida
  67+ F0C1 3A 66 82         LD A, (CurrentObjective)
  68+ F0C4 FE 09            CP 9
  69+ F0C6 30 24            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ F0C8 87               ADD A, A                            ; *2 (entry size)
  71+ F0C9 6F               LD L, A
  72+ F0CA 26 00            LD H, 0
  73+ F0CC 11 98 F0         LD DE, MilestoneTable
  74+ F0CF 19               ADD HL, DE
  75+ F0D0 7E               LD A, (HL)                          ; tipo
  76+ F0D1 FE 01            CP MILESTONE_TYPE_PICKUP
  77+ F0D3 20 17            JR NZ, .cmpDone
  78+ F0D5 23               INC HL
  79+ F0D6 7E               LD A, (HL)                          ; ref esperada
  80+ F0D7 B8               CP B
  81+ F0D8 20 12            JR NZ, .cmpDone
  82+ F0DA 3A 66 82         LD A, (CurrentObjective)
  83+ F0DD 3C               INC A
  84+ F0DE 32 66 82         LD (CurrentObjective), A
  85+ F0E1 CD 79 F1         CALL ResolveObjectiveScreen
  86+ F0E4 3E FF            LD A, $FF
  87+ F0E6 32 69 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ F0E9 CD 59 71         CALL CancelMagicCompass             ; magic compass: cancela al cumplir hito
  89+ F0EC              .cmpDone:
  90+ F0EC F1               POP AF
  91+ F0ED C1               POP BC
  92+ F0EE D1               POP DE
  93+ F0EF E1               POP HL
  94+ F0F0 C9               RET
  95+ F0F1
  96+ F0F1              ; ==============================================================================
  97+ F0F1              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
  98+ F0F1              ; ==============================================================================
  99+ F0F1              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
 100+ F0F1              ; Preserva: AF, BC, DE, HL.
 101+ F0F1              ; ==============================================================================
 102+ F0F1              CheckMilestoneTrigger:
 103+ F0F1 E5               PUSH HL
 104+ F0F2 D5               PUSH DE
 105+ F0F3 C5               PUSH BC
 106+ F0F4 F5               PUSH AF
 107+ F0F5 47               LD B, A
 108+ F0F6 3A 66 82         LD A, (CurrentObjective)
 109+ F0F9 FE 09            CP 9
 110+ F0FB 30 24            JR NC, .cmtDone
 111+ F0FD 87               ADD A, A
 112+ F0FE 6F               LD L, A
 113+ F0FF 26 00            LD H, 0
 114+ F101 11 98 F0         LD DE, MilestoneTable
 115+ F104 19               ADD HL, DE
 116+ F105 7E               LD A, (HL)
 117+ F106 FE 02            CP MILESTONE_TYPE_TRIGGER
 118+ F108 20 17            JR NZ, .cmtDone
 119+ F10A 23               INC HL
 120+ F10B 7E               LD A, (HL)
 121+ F10C B8               CP B
 122+ F10D 20 12            JR NZ, .cmtDone
 123+ F10F 3A 66 82         LD A, (CurrentObjective)
 124+ F112 3C               INC A
 125+ F113 32 66 82         LD (CurrentObjective), A
 126+ F116 CD 79 F1         CALL ResolveObjectiveScreen
 127+ F119 3E FF            LD A, $FF
 128+ F11B 32 69 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 129+ F11E CD 59 71         CALL CancelMagicCompass             ; magic compass: cancela al cumplir hito
 130+ F121              .cmtDone:
 131+ F121 F1               POP AF
 132+ F122 C1               POP BC
 133+ F123 D1               POP DE
 134+ F124 E1               POP HL
 135+ F125 C9               RET
 136+ F126
 137+ F126              ; ==============================================================================
 138+ F126              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 139+ F126              ; ==============================================================================
 140+ F126              CheckMilestoneDebugKey:
 141+ F126 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 142+ F128 DB FE            IN A, ($FE)
 143+ F12A CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 144+ F12C 20 20            JR NZ, .cmdkNotPressed
 145+ F12E 3A 53 F1         LD A, (MilestoneKeyDebounce)
 146+ F131 B7               OR A
 147+ F132 C0               RET NZ
 148+ F133 3E 01            LD A, 1
 149+ F135 32 53 F1         LD (MilestoneKeyDebounce), A
 150+ F138 3A 66 82         LD A, (CurrentObjective)
 151+ F13B FE 09            CP 9
 152+ F13D D0               RET NC
 153+ F13E 3C               INC A
 154+ F13F 32 66 82         LD (CurrentObjective), A
 155+ F142 CD 79 F1         CALL ResolveObjectiveScreen
 156+ F145 3E FF            LD A, $FF
 157+ F147 32 69 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 158+ F14A CD 59 71         CALL CancelMagicCompass             ; magic compass: cancela al saltar hito
 159+ F14D C9               RET
 160+ F14E              .cmdkNotPressed:
 161+ F14E AF               XOR A
 162+ F14F 32 53 F1         LD (MilestoneKeyDebounce), A
 163+ F152 C9               RET
 164+ F153
 165+ F153 00           MilestoneKeyDebounce: DEFB 0
 166+ F154
 167+ F154              ; ==============================================================================
 168+ F154              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 169+ F154              ; ==============================================================================
 170+ F154              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 171+ F154              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 172+ F154              ; inmediato del valor actual.
 173+ F154              ; ==============================================================================
 174+ F154              CheckCurrentKeyCycleKey:
 175+ F154 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 176+ F156 DB FE            IN A, ($FE)
 177+ F158 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 178+ F15A 20 17            JR NZ, .ckcNotPressed
 179+ F15C 3A 78 F1         LD A, (CurrentKeyCycleDebounce)
 180+ F15F B7               OR A
 181+ F160 C0               RET NZ
 182+ F161 3E 01            LD A, 1
 183+ F163 32 78 F1         LD (CurrentKeyCycleDebounce), A
 184+ F166 3A 5E 82         LD A, (CurrentKey)
 185+ F169 3C               INC A
 186+ F16A FE 07            CP 7
 187+ F16C 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 188+ F16E AF               XOR A                               ; 7 -> wrap a 0
 189+ F16F              .ckcSet:
 190+ F16F 32 5E 82         LD (CurrentKey), A
 191+ F172 C9               RET
 192+ F173              .ckcNotPressed:
 193+ F173 AF               XOR A
 194+ F174 32 78 F1         LD (CurrentKeyCycleDebounce), A
 195+ F177 C9               RET
 196+ F178
 197+ F178 00           CurrentKeyCycleDebounce: DEFB 0
 198+ F179
 199+ F179              ; ==============================================================================
 200+ F179              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 201+ F179              ; ==============================================================================
 202+ F179              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 203+ F179              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 204+ F179              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 205+ F179              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 206+ F179              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 207+ F179              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 208+ F179              ;               actuales; queda como salvaguarda.
 209+ F179              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 210+ F179              ; Destruye: AF, BC, DE, HL.
 211+ F179              ; ==============================================================================
 212+ F179              ResolveObjectiveScreen:
 213+ F179 3A 66 82         LD A, (CurrentObjective)
 214+ F17C FE 09            CP 9
 215+ F17E 30 2F            JR NC, .rosNoTarget
 216+ F180 87               ADD A, A
 217+ F181 6F               LD L, A
 218+ F182 26 00            LD H, 0
 219+ F184 11 AA F0         LD DE, MilestoneResolveTable
 220+ F187 19               ADD HL, DE
 221+ F188 7E               LD A, (HL)                          ; tipo
 222+ F189 23               INC HL
 223+ F18A 46               LD B, (HL)                          ; B = ref
 224+ F18B FE 01            CP MILESTONE_TYPE_PICKUP
 225+ F18D 28 06            JR Z, .rosPickup
 226+ F18F FE 02            CP MILESTONE_TYPE_TRIGGER
 227+ F191 28 08            JR Z, .rosTrigger
 228+ F193 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 229+ F195              .rosPickup:
 230+ F195 78               LD A, B
 231+ F196 CD B8 F1         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 232+ F199 18 08            JR .rosFindPos
 233+ F19B              .rosTrigger:
 234+ F19B 78               LD A, B
 235+ F19C CD C5 F1         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 236+ F19F 7A               LD A, D
 237+ F1A0 B3               OR E
 238+ F1A1 28 0C            JR Z, .rosNoTarget
 239+ F1A3              .rosFindPos:
 240+ F1A3 CD E0 F1         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 241+ F1A6 78               LD A, B
 242+ F1A7 32 67 82         LD (ObjectiveScreenX), A
 243+ F1AA 79               LD A, C
 244+ F1AB 32 68 82         LD (ObjectiveScreenY), A
 245+ F1AE C9               RET
 246+ F1AF              .rosNoTarget:
 247+ F1AF 3E FF            LD A, $FF
 248+ F1B1 32 67 82         LD (ObjectiveScreenX), A
 249+ F1B4 32 68 82         LD (ObjectiveScreenY), A
 250+ F1B7 C9               RET
 251+ F1B8
 252+ F1B8              ; ==============================================================================
 253+ F1B8              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 254+ F1B8              ; ==============================================================================
 255+ F1B8              ; IN:  A = key id (1..6)
 256+ F1B8              ; OUT: DE = ptr
 257+ F1B8              ; Destruye: AF, HL.
 258+ F1B8              ; ==============================================================================
 259+ F1B8              KeyIdToPtr:
 260+ F1B8 3D               DEC A
 261+ F1B9 87               ADD A, A                            ; *2 (DEFW size)
 262+ F1BA 6F               LD L, A
 263+ F1BB 26 00            LD H, 0
 264+ F1BD 11 93 D9         LD DE, KeyLockTable
 265+ F1C0 19               ADD HL, DE
 266+ F1C1 5E               LD E, (HL)
 267+ F1C2 23               INC HL
 268+ F1C3 56               LD D, (HL)
 269+ F1C4 C9               RET
 270+ F1C5
 271+ F1C5              ; ==============================================================================
 272+ F1C5              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 273+ F1C5              ; ==============================================================================
 274+ F1C5              ; IN:  A = action id (1, 2, ...)
 275+ F1C5              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 276+ F1C5              ;      Z flag set si no encontrado.
 277+ F1C5              ; Destruye: AF, BC, HL.
 278+ F1C5              ; ==============================================================================
 279+ F1C5              ActionToTriggerPtr:
 280+ F1C5 4F               LD C, A                             ; C = action id buscada
 281+ F1C6 21 21 DA         LD HL, BumpTriggerTable
 282+ F1C9              .attLoop:
 283+ F1C9 5E               LD E, (HL)
 284+ F1CA 23               INC HL
 285+ F1CB 56               LD D, (HL)
 286+ F1CC 23               INC HL                              ; HL -> required_key
 287+ F1CD 7A               LD A, D
 288+ F1CE B3               OR E
 289+ F1CF 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 290+ F1D1 23               INC HL                              ; HL -> action
 291+ F1D2 7E               LD A, (HL)
 292+ F1D3 23               INC HL                              ; HL -> next entry
 293+ F1D4 B9               CP C
 294+ F1D5 20 F2            JR NZ, .attLoop
 295+ F1D7 F6 01            OR 1                                ; clear Z (encontrado)
 296+ F1D9 C9               RET
 297+ F1DA              .attNotFound:
 298+ F1DA 16 00            LD D, 0
 299+ F1DC 1E 00            LD E, 0
 300+ F1DE AF               XOR A                               ; set Z
 301+ F1DF C9               RET
 302+ F1E0
 303+ F1E0              ; ==============================================================================
 304+ F1E0              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 305+ F1E0              ; ==============================================================================
 306+ F1E0              ; PickupTable layout (per-entry, 7 bytes):
 307+ F1E0              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 308+ F1E0              ; Terminator: $FF (single byte).
 309+ F1E0              ;
 310+ F1E0              ; IN:  DE = ptr a buscar
 311+ F1E0              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 312+ F1E0              ;      B = C = $FF si no encontrado (Z).
 313+ F1E0              ; Destruye: AF, HL. Preserva DE.
 314+ F1E0              ; ==============================================================================
 315+ F1E0              FindPickupScreen:
 316+ F1E0 21 60 E1         LD HL, PickupTable
 317+ F1E3              .fpsLoop:
 318+ F1E3 7E               LD A, (HL)
 319+ F1E4 FE FF            CP $FF
 320+ F1E6 28 1C            JR Z, .fpsNotFound
 321+ F1E8 E5               PUSH HL
 322+ F1E9 23               INC HL                              ; -> mapY
 323+ F1EA 23               INC HL                              ; -> ptr_lo
 324+ F1EB 7E               LD A, (HL)
 325+ F1EC BB               CP E
 326+ F1ED 20 0C            JR NZ, .fpsNoMatch
 327+ F1EF 23               INC HL                              ; -> ptr_hi
 328+ F1F0 7E               LD A, (HL)
 329+ F1F1 BA               CP D
 330+ F1F2 20 07            JR NZ, .fpsNoMatch
 331+ F1F4 E1               POP HL                              ; back to entry start (mapX)
 332+ F1F5 46               LD B, (HL)                          ; B = mapX
 333+ F1F6 23               INC HL
 334+ F1F7 4E               LD C, (HL)                          ; C = mapY
 335+ F1F8 F6 01            OR 1                                ; clear Z (NZ = encontrado)
