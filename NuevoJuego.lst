2658+ B03B CB 7F            BIT 7, A
2659+ B03D 28 02            JR Z, .eAnimDir
2660+ B03F 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2661+ B041              .eAnimDir:
2662+ B041 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2663+ B044 20 27            JR NZ, .eAnimDone
2664+ B046 3A 56 90         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2665+ B049 47               LD B, A
2666+ B04A DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2667+ B04D FE 34            CP SPRID_ENEMY_5
2668+ B04F 78               LD A, B
2669+ B050 20 06            JR NZ, .eAnimDelaySet
