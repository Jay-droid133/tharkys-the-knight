# file opened: day_cycle.asm
   1+ D1DF              ; ==============================================================================
   2+ D1DF              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ D1DF              ; ==============================================================================
   4+ D1DF              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ D1DF              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ D1DF              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ D1DF              ; ==============================================================================
   8+ D1DF
   9+ D1DF              ; --- Constantes ---
  10+ D1DF              NUM_TIME_MOMENTS    EQU 7
  11+ D1DF
  12+ D1DF              ; --- Variables ---
  13+ D1DF 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ D1E0 08 D6        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ D1E2 08 D6        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ D1E4 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ D1E5 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ D1E6
  19+ D1E6              ; ==============================================================================
  20+ D1E6              ; SetTimeOfDay - Cambia el momento del dia
  21+ D1E6              ; ==============================================================================
  22+ D1E6              ; Entrada: A = momento (0-6)
  23+ D1E6              ; ==============================================================================
  24+ D1E6              SetTimeOfDay:
  25+ D1E6 32 DF D1         LD (CurrentTimeOfDay), A
  26+ D1E9
  27+ D1E9                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  28+ D1E9 FE 04            CP 4
  29+ D1EB 20 04            JR NZ, .notNewCycle
  30+ D1ED 21 D2 B8         LD HL, DayCycleCount
  31+ D1F0 34               INC (HL)
  32+ D1F1              .notNewCycle:
  33+ D1F1
  34+ D1F1                  ; N2 (medianoche): campanadas primero, remap al terminar
  35+ D1F1 FE 04            CP 4
  36+ D1F3 28 1C            JR Z, .bellsFirst
  37+ D1F5
  38+ D1F5                  ; Amanecer temprano (fase 5): despawnear monsters
  39+ D1F5 FE 05            CP 5
  40+ D1F7 20 05            JR NZ, .noScareMon
  41+ D1F9 CD EC B8         CALL ScareAllMonsters
  42+ D1FC 18 07            JR .noKillMon
  43+ D1FE              .noScareMon:
  44+ D1FE                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  45+ D1FE FE 06            CP 6
  46+ D200 20 03            JR NZ, .noKillMon
  47+ D202 CD 71 B8         CALL KillAllActiveMonsters
  48+ D205              .noKillMon:
  49+ D205
  50+ D205                  ; Actualizar tablas de remap y tabla de nasties
  51+ D205 CD 15 D2         CALL UpdateRemapTables
  52+ D208 CD D5 B8         CALL UpdateNastyTable
  53+ D20B
  54+ D20B                  ; Forzar remap de atributos (sin redibujar pixeles)
  55+ D20B 3E 01            LD A, 1
  56+ D20D 32 EC 81         LD (AttrsDirty), A
  57+ D210 C9               RET
  58+ D211
  59+ D211              .bellsFirst:
  60+ D211                  ; NO actualizar tablas: mantener colores de N1 durante campanadas
  61+ D211 CD FD DD         CALL StartBellChimes
  62+ D214 C9               RET
  63+ D215
  64+ D215              ; ==============================================================================
  65+ D215              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
  66+ D215              ; ==============================================================================
  67+ D215              UpdateRemapTables:
  68+ D215 3A DF D1         LD A, (CurrentTimeOfDay)
  69+ D218 21 DC D5         LD HL, RemapTablePtrs
  70+ D21B 5F               LD E, A
  71+ D21C 16 00            LD D, 0
  72+ D21E 19               ADD HL, DE
  73+ D21F 19               ADD HL, DE
  74+ D220 5E               LD E, (HL)
  75+ D221 23               INC HL
  76+ D222 56               LD D, (HL)
  77+ D223 ED 53 E0 D1      LD (CurrentRemapTable), DE
  78+ D227
  79+ D227 3A DF D1         LD A, (CurrentTimeOfDay)
  80+ D22A 21 EA D5         LD HL, RemapHouseTablePtrs
  81+ D22D 5F               LD E, A
  82+ D22E 16 00            LD D, 0
  83+ D230 19               ADD HL, DE
  84+ D231 19               ADD HL, DE
  85+ D232 5E               LD E, (HL)
  86+ D233 23               INC HL
  87+ D234 56               LD D, (HL)
  88+ D235 ED 53 E2 D1      LD (CurrentHouseRemapTable), DE
  89+ D239 C9               RET
  90+ D23A
  91+ D23A              ; ==============================================================================
  92+ D23A              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
  93+ D23A              ; ==============================================================================
  94+ D23A              CheckDebugKeys:
  95+ D23A 3E FB            LD A, $FB
  96+ D23C DB FE            IN A, ($FE)
  97+ D23E CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
  98+ D240 20 1C            JR NZ, .notPressed
  99+ D242
 100+ D242                  ; Tecla pulsada: comprobar debounce
 101+ D242 3A E5 D1         LD A, (DebugKeyDebounce)
 102+ D245 B7               OR A
 103+ D246 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 104+ D247
 105+ D247                  ; Primera pulsacion: ciclar
 106+ D247 3E 01            LD A, 1
 107+ D249 32 E5 D1         LD (DebugKeyDebounce), A
 108+ D24C
 109+ D24C 3A DF D1         LD A, (CurrentTimeOfDay)
 110+ D24F 3C               INC A
 111+ D250 FE 07            CP NUM_TIME_MOMENTS
 112+ D252 38 01            JR C, .noWrap
 113+ D254 AF               XOR A                   ; Volver a 0 (Dia)
 114+ D255              .noWrap:
 115+ D255 F5               PUSH AF
 116+ D256 CD E6 D1         CALL SetTimeOfDay
 117+ D259 F1               POP AF
 118+ D25A CD B3 D9         CALL SetClockToPhaseHour
 119+ D25D C9               RET
 120+ D25E
 121+ D25E              .notPressed:
 122+ D25E AF               XOR A
 123+ D25F 32 E5 D1         LD (DebugKeyDebounce), A
 124+ D262
 125+ D262                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 126+ D262 3E FD            LD A, $FD
 127+ D264 DB FE            IN A, ($FE)
 128+ D266 4F               LD C, A                 ; C = estado semi-fila $FDFE
 129+ D267 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 130+ D269 20 13            JR NZ, .sNotPressed
 131+ D26B 3A B9 D2         LD A, (SpeedKeyDebounce)
 132+ D26E B7               OR A
 133+ D26F C0               RET NZ
 134+ D270 3E 01            LD A, 1
 135+ D272 32 B9 D2         LD (SpeedKeyDebounce), A
 136+ D275 21 D2 B8         LD HL, DayCycleCount
 137+ D278 7E               LD A, (HL)
 138+ D279 FE 0A            CP 10
 139+ D27B D0               RET NC                  ; Ya en maximo
 140+ D27C 34               INC (HL)
 141+ D27D C9               RET
 142+ D27E              .sNotPressed:
 143+ D27E                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 144+ D27E CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 145+ D280 20 13            JR NZ, .dNotPressed
 146+ D282 3A B9 D2         LD A, (SpeedKeyDebounce)
 147+ D285 B7               OR A
 148+ D286 C0               RET NZ
 149+ D287 3E 01            LD A, 1
 150+ D289 32 B9 D2         LD (SpeedKeyDebounce), A
 151+ D28C 21 D2 B8         LD HL, DayCycleCount
 152+ D28F 7E               LD A, (HL)
 153+ D290 FE 01            CP 1
 154+ D292 C8               RET Z                   ; Ya en minimo
 155+ D293 35               DEC (HL)
 156+ D294 C9               RET
 157+ D295              .dNotPressed:
 158+ D295 AF               XOR A
 159+ D296 32 B9 D2         LD (SpeedKeyDebounce), A
 160+ D299
 161+ D299                  ; --- Tecla N: togglea NoclipMode (debug) ---
 162+ D299 3E 7F            LD A, $7F
 163+ D29B DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 164+ D29D CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 165+ D29F 20 13            JR NZ, .nNotPressed
 166+ D2A1 3A BA D2         LD A, (NoclipKeyDebounce)
 167+ D2A4 B7               OR A
 168+ D2A5 C0               RET NZ
 169+ D2A6 3E 01            LD A, 1
 170+ D2A8 32 BA D2         LD (NoclipKeyDebounce), A
 171+ D2AB 3A C2 81         LD A, (NoclipMode)
 172+ D2AE EE 01            XOR 1
 173+ D2B0 32 C2 81         LD (NoclipMode), A
 174+ D2B3 C9               RET
 175+ D2B4              .nNotPressed:
 176+ D2B4 AF               XOR A
 177+ D2B5 32 BA D2         LD (NoclipKeyDebounce), A
 178+ D2B8 C9               RET
 179+ D2B9
 180+ D2B9 00           SpeedKeyDebounce: DEFB 0
 181+ D2BA 00           NoclipKeyDebounce: DEFB 0
