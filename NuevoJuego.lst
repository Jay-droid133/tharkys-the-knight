 389+ A38E              ; ==============================================================================
 390+ A38E              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 391+ A38E              ; ==============================================================================
 392+ A38E              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 393+ A38E              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 394+ A38E              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 395+ A38E              ; ==============================================================================
 396+ A38E              ProcessEnemies:
 397+ A38E 3E 00            LD A, 0
 398+ A390 32 D9 A3         LD (.peCount), A
 399+ A393 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 400+ A395
 401+ A395              .peLoop:
 402+ A395 C5               PUSH BC
 403+ A396
 404+ A396                  ; Calcular IX desde EnemyStepIdx
 405+ A396 3A 4F 82         LD A, (EnemyStepIdx)
 406+ A399 C6 01            ADD A, SLOT_MONSTER0
 407+ A39B 6F               LD L, A
 408+ A39C 26 00            LD H, 0
 409+ A39E 29               ADD HL, HL
 410+ A39F 29               ADD HL, HL
 411+ A3A0 29               ADD HL, HL
 412+ A3A1 29               ADD HL, HL                          ; × ENT_SIZE (16)
 413+ A3A2 11 14 81         LD DE, EntityTable
 414+ A3A5 19               ADD HL, DE
 415+ A3A6 E5               PUSH HL
 416+ A3A7 DD E1            POP IX
 417+ A3A9
 418+ A3A9                  ; Avanzar indice round-robin
 419+ A3A9 3A 4F 82         LD A, (EnemyStepIdx)
 420+ A3AC 3C               INC A
 421+ A3AD FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 422+ A3AF 38 01            JR C, .peNoWrap
 423+ A3B1 AF               XOR A
 424+ A3B2              .peNoWrap:
 425+ A3B2 32 4F 82         LD (EnemyStepIdx), A
 426+ A3B5
 427+ A3B5                  ; Slot activo?
 428+ A3B5 DD 7E 01         LD A, (IX+ENT_TYPE)
 429+ A3B8 B7               OR A
 430+ A3B9 28 16            JR Z, .peSkip
 431+ A3BB
 432+ A3BB                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 433+ A3BB DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 434+ A3BF F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 435+ A3C0
 436+ A3C0                  ; Procesar esta entidad completa (erase + logic + draw)
 437+ A3C0 CD DA A3         CALL ProcessOneEnemy
 438+ A3C3
 439+ A3C3                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 440+ A3C3 F1               POP AF
 441+ A3C4 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 442+ A3C6
 443+ A3C6                  ; Budget check
 444+ A3C6 3A D9 A3         LD A, (.peCount)
 445+ A3C9 3C               INC A
 446+ A3CA 32 D9 A3         LD (.peCount), A
 447+ A3CD FE 02            CP MAX_ENEMIES_PER_FRAME
 448+ A3CF 30 06            JR NC, .peDone
 449+ A3D1
 450+ A3D1              .peSkip:
 451+ A3D1 C1               POP BC
 452+ A3D2 05               DEC B
 453+ A3D3 C2 95 A3         JP NZ, .peLoop
 454+ A3D6 C9               RET
 455+ A3D7
 456+ A3D7              .peDone:
 457+ A3D7 C1               POP BC
 458+ A3D8 C9               RET
 459+ A3D9
 460+ A3D9 00           .peCount: DEFB 0
