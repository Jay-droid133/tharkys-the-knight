 450+ 707B                  ENDIF
 451+ 707B ED 5F            LD A, R
 452+ 707D 21 78 5C         LD HL, $5C78
 453+ 7080 AE               XOR (HL)
 454+ 7081                  ; JP C en lugar de JR C: el cache hit dispatch crecio el binario, los JR
 455+ 7081                  ; quedaban fuera de rango (+127 max). JP unconditional, +1 byte por entrada.
 456+ 7081 FE 08            CP PROB_LIFE_END
 457+ 7083 DA E3 70         JP C, .urpDoLife
