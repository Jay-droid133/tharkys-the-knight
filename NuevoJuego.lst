5741+ BF97              ; DEBUG: tabla de colores por golpes recibidos
5742+ BF97              .kbHitColors:
5743+ BF97 47               DEFB $47                            ; 0 hits: blanco brillante (no deberia usarse)
5744+ BF98 44               DEFB $44                            ; 1 hit:  verde brillante
5745+ BF99 45               DEFB $45                            ; 2 hits: cyan brillante
5746+ BF9A 46               DEFB $46                            ; 3 hits: amarillo brillante
5747+ BF9B 42               DEFB $42                            ; 4 hits: rojo brillante
5748+ BF9C 43               DEFB $43                            ; 5 hits: magenta brillante
5749+ BF9D
5750+ BF9D              .killNasty:
5751+ BF9D
5752+ BF9D                  ; Matar nasty: iniciar animacion puff
5753+ BF9D DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5754+ BFA1 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5755+ BFA5 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5756+ BFA9 DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5757+ BFAD DD 36 06 00      LD (IX+ENT_DELTAX), 0          ; Parar movimiento
5758+ BFB1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5759+ BFB5 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40  ; Blanco brillante para el puff
5760+ BFB9                  ; SFX de muerte de enemigo
5761+ BFB9 DD E5            PUSH IX
5762+ BFBB C5               PUSH BC
5763+ BFBC 21 78 DD         LD HL, SFX_EnemyDeath
5764+ BFBF CD F9 DC         CALL PlaySFX
