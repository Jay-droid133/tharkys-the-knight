 117+ EAD7              ; ==============================================================================
 118+ EAD7              ; GetRoulettePtrByIdx - dado RouletteIdx (0..5), pica un item random de la cat
 119+ EAD7              ; ==============================================================================
 120+ EAD7              ; IN:  A = RouletteIdx (0..5)
 121+ EAD7              ; OUT: HL = BgGfx ptr al sprite picado.
 122+ EAD7              ;      Side: RouletteDisplayedType <- ROUL_* picado (para .crsApplyRouletteHit).
 123+ EAD7              ; Destruye: AF, BC, DE, HL.
 124+ EAD7              ;
 125+ EAD7              ; Logica:
 126+ EAD7              ;   1. cat = RouletteCatOrder[idx]
 127+ EAD7              ;   2. table = RouletteCatItemTables[cat]    (DEFB count, DEFB items...)
 128+ EAD7              ;   3. R mod count -> pick. Si pick == ROUL_COMPASS y MagicCompassPermanent
 129+ EAD7              ;      activo, re-pica (loop). RouletteCatEspecial tiene 2 items non-compass
 130+ EAD7              ;      => terminacion garantizada.
 131+ EAD7              ;   4. Store ROUL_* en RouletteDisplayedType.
 132+ EAD7              ;   5. Si ROUL_HEALTH / ROUL_STAMINA -> PickRandomVariantPtr (variante random).
 133+ EAD7              ;      Resto -> lookup canonical en RouletteTypePtrs.
 134+ EAD7              ;
 135+ EAD7              ; .grpiCount / .grpiItems: scratch DEFB/DEFW al final de la rutina (bank 7).
 136+ EAD7              ; ==============================================================================
 137+ EAD7              GetRoulettePtrByIdx:
 138+ EAD7                  ; --- 1. Resolve cat ptr ---
 139+ EAD7 21 A4 EA         LD HL, RouletteCatOrder
 140+ EADA 5F               LD E, A
 141+ EADB 16 00            LD D, 0
 142+ EADD 19               ADD HL, DE
 143+ EADE 7E               LD A, (HL)                              ; A = cat (0..3)
 144+ EADF 87               ADD A, A
 145+ EAE0 5F               LD E, A
 146+ EAE1 21 B9 EA         LD HL, RouletteCatItemTables
 147+ EAE4 19               ADD HL, DE
 148+ EAE5 7E               LD A, (HL)
 149+ EAE6 23               INC HL
 150+ EAE7 66               LD H, (HL)
 151+ EAE8 6F               LD L, A                                 ; HL = cat table (count + items)
 152+ EAE9 7E               LD A, (HL)
 153+ EAEA 32 33 EB         LD (.grpiCount), A                      ; save count en scratch
 154+ EAED 23               INC HL
 155+ EAEE 22 34 EB         LD (.grpiItems), HL                     ; save items ptr en scratch
