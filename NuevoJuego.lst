 845+ F334              ; ==============================================================================
 846+ F334              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 847+ F334              ; ==============================================================================
 848+ F334              ClearCompass:
 849+ F334 26 40            LD H, $40
 850+ F336 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 851+ F338 06 08            LD B, 8
 852+ F33A AF               XOR A
 853+ F33B              .ccRow0:
 854+ F33B 77               LD (HL), A
 855+ F33C 23               INC HL
 856+ F33D 77               LD (HL), A
 857+ F33E 2B               DEC HL
 858+ F33F 24               INC H
 859+ F340 10 F9            DJNZ .ccRow0
 860+ F342 26 40            LD H, $40
 861+ F344 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 862+ F346 06 08            LD B, 8
 863+ F348 AF               XOR A
 864+ F349              .ccRow1:
 865+ F349 77               LD (HL), A
 866+ F34A 23               INC HL
 867+ F34B 77               LD (HL), A
 868+ F34C 2B               DEC HL
 869+ F34D 24               INC H
 870+ F34E 10 F9            DJNZ .ccRow1
 871+ F350 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 872+ F351 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 873+ F354 77               LD (HL), A
 874+ F355 23               INC HL
 875+ F356 77               LD (HL), A
 876+ F357 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 877+ F35A 77               LD (HL), A
 878+ F35B 23               INC HL
 879+ F35C 77               LD (HL), A
 880+ F35D C9               RET
 881+ F35E
 882+ F35E              ; ==============================================================================
 883+ F35E              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 884+ F35E              ; ==============================================================================
 885+ F35E              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 886+ F35E              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 887+ F35E              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 888+ F35E              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 889+ F35E              ; monstruo cae alli con la puerta abierta:
 890+ F35E              ;   - Bit slot en MonsterTrappedFlags
 891+ F35E              ;   - Despawn del monstruo (puff)
 892+ F35E              ;   - Puerta se re-cierra (sprite + flag)
 893+ F35E              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 894+ F35E              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 895+ F35E              ;
 896+ F35E              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 897+ F35E              ; auto-generadas por el level editor segun la posicion de la puerta y los
 898+ F35E              ; markers AltKey1/AltKey2.
 899+ F35E              ; ==============================================================================
 900+ F35E
 901+ F35E              ; ==============================================================================
 902+ F35E              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 903+ F35E              ; ==============================================================================
 904+ F35E              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 905+ F35E              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 906+ F35E              ; Destruye: AF, BC.
 907+ F35E              ; ==============================================================================
 908+ F35E              CheckChurchTrap:
 909+ F35E                  ; --- Solo en pantalla de la iglesia ---
 910+ F35E 3A 10 83         LD A, (CurrentScreenX)
 911+ F361 FE 0F            CP CHURCH_TRAP_SCREEN_X
 912+ F363 20 5D            JR NZ, .cctNoTrap
 913+ F365 3A 11 83         LD A, (CurrentScreenY)
 914+ F368 FE 06            CP CHURCH_TRAP_SCREEN_Y
 915+ F36A 20 56            JR NZ, .cctNoTrap
 916+ F36C                  ; --- Solo con la puerta abierta ---
 917+ F36C 3A B9 82         LD A, (ChurchDoorOpen)
 918+ F36F B7               OR A
 919+ F370 28 50            JR Z, .cctNoTrap
 920+ F372                  ; --- Solo si el knockback es DIRECTO del player ---
 921+ F372                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 922+ F372                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 923+ F372                  ; espada y se clear cuando se hereda kb por colision.
 924+ F372 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 925+ F376 28 4A            JR Z, .cctNoTrap
 926+ F378                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 927+ F378                  ; (acepta sprites de 16, 21 o 24 px de alto)
 928+ F378 DD 7E 04         LD A, (IX+ENT_POSY)
 929+ F37B CB 3F            SRL A
 930+ F37D CB 3F            SRL A
 931+ F37F CB 3F            SRL A                                   ; A = top charY del monster
 932+ F381 47               LD B, A
 933+ F382 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 934+ F384 90               SUB B                                   ; A = trap_charY - mon_charY
 935+ F385 FE 03            CP 3
 936+ F387 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 937+ F389                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 938+ F389 DD 7E 03         LD A, (IX+ENT_POSX)
 939+ F38C CB 3F            SRL A
 940+ F38E CB 3F            SRL A
 941+ F390 CB 3F            SRL A
 942+ F392 47               LD B, A                                 ; B = left charX del monster
 943+ F393 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 944+ F395 3C               INC A                                   ; A = LO_X + 1
 945+ F396 90               SUB B                                   ; A = LO_X+1 - charX
 946+ F397 FE 03            CP 3
 947+ F399 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 948+ F39B                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 949+ F39B                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 950+ F39B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 951+ F39E D6 4C            SUB SPRID_MONSTER_0
 952+ F3A0 CB 3F            SRL A
 953+ F3A2 CB 3F            SRL A
 954+ F3A4 CB 3F            SRL A                                   ; A = type idx 0..2
 955+ F3A6 47               LD B, A
 956+ F3A7                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 957+ F3A7 3A C7 82         LD A, (NextChurchTrapStep)
 958+ F3AA FE 03            CP 3
 959+ F3AC 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 960+ F3AE 21 C4 F3         LD HL, ChurchTrapOrderTable
 961+ F3B1 5F               LD E, A
 962+ F3B2 16 00            LD D, 0
 963+ F3B4 19               ADD HL, DE
 964+ F3B5 7E               LD A, (HL)                              ; A = type esperado
 965+ F3B6 B8               CP B
 966+ F3B7 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 967+ F3B9                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 968+ F3B9 CD 5C F4         CALL TriggerChurchTrap
 969+ F3BC 3E 01            LD A, 1
 970+ F3BE C9               RET
 971+ F3BF              .cctBlockAsWall:
 972+ F3BF                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 973+ F3BF                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 974+ F3BF 3E 02            LD A, 2
 975+ F3C1 C9               RET
 976+ F3C2              .cctNoTrap:
 977+ F3C2 AF               XOR A
 978+ F3C3 C9               RET
 979+ F3C4
 980+ F3C4              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 981+ F3C4              ChurchTrapOrderTable:
 982+ F3C4 00 02 01         DEFB 0, 2, 1
 983+ F3C7
 984+ F3C7              ; ==============================================================================
 985+ F3C7              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 986+ F3C7              ; blanco brillante sobre paper negro ($47).
 987+ F3C7              ; ==============================================================================
 988+ F3C7              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 989+ F3C7              ; - No-op fuera de la sala de la iglesia.
 990+ F3C7              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 991+ F3C7              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 992+ F3C7              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 993+ F3C7              ;   aun no toca) conservan sus attrs originales del sprite.
 994+ F3C7              ; Destruye: AF, BC, DE, HL.
 995+ F3C7              ; ==============================================================================
 996+ F3C7              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 997+ F3C7              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 998+ F3C7              HighlightExpectedStatue:
 999+ F3C7 3E 47            LD A, $47
1000+ F3C9 18 00            JR PaintExpectedStatueAttr
1001+ F3CB
1002+ F3CB              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
1003+ F3CB              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
1004+ F3CB              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
1005+ F3CB              PaintExpectedStatueAttr:
1006+ F3CB 32 35 F4         LD (.hesAttr), A
1007+ F3CE                  ; --- Solo en la sala de la iglesia ---
1008+ F3CE 3A 10 83         LD A, (CurrentScreenX)
1009+ F3D1 FE 0F            CP CHURCH_TRAP_SCREEN_X
1010+ F3D3 C0               RET NZ
1011+ F3D4 3A 11 83         LD A, (CurrentScreenY)
1012+ F3D7 FE 06            CP CHURCH_TRAP_SCREEN_Y
1013+ F3D9 C0               RET NZ
1014+ F3DA                  ; --- Solo tras abrir la iglesia 1a vez ---
1015+ F3DA                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
1016+ F3DA                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
1017+ F3DA                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
1018+ F3DA                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
1019+ F3DA                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
1020+ F3DA 3A BA 82         LD A, (ChurchEverOpened)
1021+ F3DD B7               OR A
1022+ F3DE C8               RET Z
1023+ F3DF                  ; --- Solo si quedan monstruos por atrapar ---
1024+ F3DF 3A C7 82         LD A, (NextChurchTrapStep)
1025+ F3E2 FE 03            CP 3
1026+ F3E4 D0               RET NC
1027+ F3E5                  ; --- Type esperado -> statue id ---
1028+ F3E5 21 C4 F3         LD HL, ChurchTrapOrderTable
1029+ F3E8 5F               LD E, A
1030+ F3E9 16 00            LD D, 0
1031+ F3EB 19               ADD HL, DE
1032+ F3EC 7E               LD A, (HL)                              ; type idx esperado
1033+ F3ED 21 B0 64         LD HL, StatueIdTable
1034+ F3F0 5F               LD E, A
1035+ F3F1 16 00            LD D, 0
1036+ F3F3 19               ADD HL, DE
1037+ F3F4 7E               LD A, (HL)                              ; A = statue id
1038+ F3F5 B7               OR A
1039+ F3F6 C8               RET Z
1040+ F3F7 32 36 F4         LD (.hesTargetId), A
1041+ F3FA                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1042+ F3FA 2A 12 83         LD HL, (CurrentScreenAddr)
1043+ F3FD              .hesLoop:
1044+ F3FD 7E               LD A, (HL)
1045+ F3FE FE FF            CP $FF
1046+ F400 C8               RET Z                                   ; estatua no en esta sala
1047+ F401 47               LD B, A
1048+ F402 3A 36 F4         LD A, (.hesTargetId)
1049+ F405 B8               CP B
1050+ F406 28 06            JR Z, .hesFound
1051+ F408 11 04 00         LD DE, 4
1052+ F40B 19               ADD HL, DE
1053+ F40C 18 EF            JR .hesLoop
1054+ F40E              .hesFound:
1055+ F40E 23               INC HL
1056+ F40F 7E               LD A, (HL)                              ; charX
1057+ F410 47               LD B, A
1058+ F411 23               INC HL
1059+ F412 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1060+ F413 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1061+ F415 4F               LD C, A                                 ; C = charY (post-HUD)
1062+ F416                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1063+ F416 26 00            LD H, 0
1064+ F418 69               LD L, C
1065+ F419 29               ADD HL, HL
1066+ F41A 29               ADD HL, HL
1067+ F41B 29               ADD HL, HL
1068+ F41C 29               ADD HL, HL
1069+ F41D 29               ADD HL, HL                              ; HL = charY * 32
1070+ F41E 58               LD E, B
1071+ F41F 16 00            LD D, 0
1072+ F421 19               ADD HL, DE                              ; + charX
1073+ F422 11 00 58         LD DE, $5800
1074+ F425 19               ADD HL, DE                              ; HL = attr addr top-left
1075+ F426                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1076+ F426                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1077+ F426                  ; no hace falta sincronizar CleanAttrMap.
1078+ F426 3A 35 F4         LD A, (.hesAttr)
1079+ F429 06 03            LD B, 3                                 ; 3 filas de chars
1080+ F42B              .hesRow:
1081+ F42B 77               LD (HL), A
1082+ F42C 23               INC HL
1083+ F42D 77               LD (HL), A                              ; (charX+1)
1084+ F42E 11 1F 00         LD DE, 31
1085+ F431 19               ADD HL, DE                              ; siguiente fila col 0
1086+ F432 10 F7            DJNZ .hesRow
1087+ F434 C9               RET
1088+ F435 00           .hesAttr:     DEFB 0
1089+ F436 00           .hesTargetId: DEFB 0
1090+ F437
1091+ F437              ; ==============================================================================
1092+ F437              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1093+ F437              ; ==============================================================================
1094+ F437              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1095+ F437              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1096+ F437              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1097+ F437              ; + ON final settle): 8 ciclos de ON-OFF en total.
1098+ F437              ; ==============================================================================
1099+ F437              STATUE_BLINK_FRAMES   EQU 32
1100+ F437
1101+ F437              StartStatueBlink:
1102+ F437                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1103+ F437                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1104+ F437                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1105+ F437                  ; (caso A), .cbtActChurchDoor (caso B).
1106+ F437 3E 20            LD A, STATUE_BLINK_FRAMES
1107+ F439 32 C8 82         LD (StatueBlinkCounter), A
1108+ F43C C3 C7 F3         JP HighlightExpectedStatue              ; initial ON paint
1109+ F43F
1110+ F43F              UpdateStatueBlink:
1111+ F43F                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1112+ F43F 3A C8 82         LD A, (StatueBlinkCounter)
1113+ F442 B7               OR A
1114+ F443 C8               RET Z
1115+ F444 3D               DEC A
1116+ F445 32 C8 82         LD (StatueBlinkCounter), A
1117+ F448 20 03            JR NZ, .usbInProgress
1118+ F44A                  ; Counter recien llego a 0: settle ON
1119+ F44A C3 C7 F3         JP HighlightExpectedStatue
1120+ F44D              .usbInProgress:
1121+ F44D                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1122+ F44D                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1123+ F44D CB 3F            SRL A
1124+ F44F E6 01            AND $01
1125+ F451 28 05            JR Z, .usbOff
1126+ F453 3E 47            LD A, $47
1127+ F455 C3 CB F3         JP PaintExpectedStatueAttr
1128+ F458              .usbOff:
1129+ F458 AF               XOR A
1130+ F459 C3 CB F3         JP PaintExpectedStatueAttr
1131+ F45C
1132+ F45C              ; ==============================================================================
1133+ F45C              ; CUTSCENE - parametros ajustables
1134+ F45C              ; ==============================================================================
1135+ F45C              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1136+ F45C              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1137+ F45C              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1138+ F45C              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1139+ F45C
1140+ F45C              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1141+ F45C              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1142+ F45C              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1143+ F45C
1144+ F45C              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1145+ F45C              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1146+ F45C              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1147+ F45C              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1148+ F45C              ;   tick 12 -> erase smoke[2], pasar a DONE
1149+ F45C              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1150+ F45C              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1151+ F45C
1152+ F45C              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1153+ F45C              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1154+ F45C              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1155+ F45C              ; centrado dentro del vano de la puerta.
1156+ F45C              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1157+ F45C              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1158+ F45C              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1159+ F45C              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1160+ F45C
1161+ F45C              ; ==============================================================================
1162+ F45C              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1163+ F45C              ; ==============================================================================
1164+ F45C              ; IN: IX = monster atrapado.
1165+ F45C              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1166+ F45C              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1167+ F45C              ; en ApplyChurchTrapEffects al final del cutscene.
1168+ F45C              ; ==============================================================================
1169+ F45C              TriggerChurchTrap:
1170+ F45C                  ; --- 1. Calcular slot 0..2 ---
1171+ F45C DD E5            PUSH IX
1172+ F45E E1               POP HL
1173+ F45F 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1174+ F462 B7               OR A
1175+ F463 ED 52            SBC HL, DE
1176+ F465 CB 3D            SRL L
1177+ F467 CB 3D            SRL L
1178+ F469 CB 3D            SRL L
1179+ F46B CB 3D            SRL L                                   ; L = slot 0..2
1180+ F46D 7D               LD A, L
1181+ F46E 32 9E 5F         LD (ChurchCutsceneSlot), A
1182+ F471                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1183+ F471 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1184+ F474 D6 4C            SUB SPRID_MONSTER_0
1185+ F476 CB 3F            SRL A
1186+ F478 CB 3F            SRL A
1187+ F47A CB 3F            SRL A                                   ; A = type idx
1188+ F47C 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1189+ F47F                  ; --- 2. Mover monster al centro del vano ---
1190+ F47F 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1191+ F481 DD 77 03         LD (IX+ENT_POSX), A
1192+ F484 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1193+ F486 DD 77 04         LD (IX+ENT_POSY), A
1194+ F489 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1195+ F48D DD 36 07 00      LD (IX+ENT_DELTAY), 0
1196+ F491 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1197+ F495                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1198+ F495                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1199+ F495                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1200+ F495                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1201+ F495                  ; temblor se vea con ink blanco brillante sobre paper negro.
1202+ F495 AF               XOR A
1203+ F496 32 C8 82         LD (StatueBlinkCounter), A              ; parar blink
1204+ F499 DD E5            PUSH IX
1205+ F49B CD C7 F3         CALL HighlightExpectedStatue            ; pintar $47
1206+ F49E                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1207+ F49E                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1208+ F49E                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1209+ F49E                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1210+ F49E CD 32 BB         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1211+ F4A1 3E FF            LD A, $FF
1212+ F4A3 CD C2 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1213+ F4A6                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1214+ F4A6                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1215+ F4A6                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1216+ F4A6 3A C7 82         LD A, (NextChurchTrapStep)
1217+ F4A9 FE 02            CP 2
1218+ F4AB CC D5 FB         CALL Z, StopMonstersMusic
1219+ F4AE DD E1            POP IX
1220+ F4B0                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1221+ F4B0 3E 01            LD A, 1
1222+ F4B2 32 CE 82         LD (ChurchCutscenePhase), A
1223+ F4B5 AF               XOR A
1224+ F4B6 32 9D 5F         LD (ChurchCutsceneFrame), A
1225+ F4B9 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1226+ F4BB 32 A4 5F         LD (ChurchCutsceneLookCount), A
1227+ F4BE C9               RET
1228+ F4BF
1229+ F4BF              ; ==============================================================================
1230+ F4BF              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1231+ F4BF              ; ==============================================================================
1232+ F4BF              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1233+ F4BF              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1234+ F4BF              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1235+ F4BF              ; ==============================================================================
1236+ F4BF              UpdateChurchCutscene:
