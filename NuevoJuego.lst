# file closed: town_gate_cutscene.asm
  90  6666
  91  6666                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
  92  6666                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
  93  6666                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
  94  6666                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
  95  6666                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
  96  6666                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 6666              ; ==============================================================================
   2+ 6666              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 6666              ; ==============================================================================
   4+ 6666              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 6666              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 6666              ; la cinematica — invisible porque es one-shot.
   7+ 6666              ;
   8+ 6666              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 6666              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 6666              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 6666              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 6666              ; ==============================================================================
  13+ 6666
  14+ 6666              ; ==============================================================================
  15+ 6666              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 6666              ; ==============================================================================
  17+ 6666              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 6666              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 6666              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 6666              ; ChurchCutsceneSlot.
  21+ 6666              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 6666              ; ==============================================================================
  23+ 6666              EraseChurchTrappedMonster:
  24+ 6666 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 6669 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 666A 6F               LD L, A
  27+ 666B 26 00            LD H, 0
  28+ 666D 29               ADD HL, HL
  29+ 666E 29               ADD HL, HL
  30+ 666F 29               ADD HL, HL
  31+ 6670 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 6671 11 C7 80         LD DE, EntityTable
  33+ 6674 19               ADD HL, DE
  34+ 6675 E5               PUSH HL
  35+ 6676 DD E1            POP IX
  36+ 6678 CD F3 A7         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 667B DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 667E 57               LD D, A
  39+ 667F DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 6682 5F               LD E, A
  41+ 6683 DD 2A 7B A7      LD IX, (OldSprAddr)
  42+ 6687 C3 A9 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 668A
  44+ 668A              ; ==============================================================================
  45+ 668A              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 668A              ; ==============================================================================
  47+ 668A              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 668A              ; - Despawn monster (ENT_TYPE=0).
  49+ 668A              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 668A              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 668A              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 668A              ; ==============================================================================
  53+ 668A              ApplyChurchTrapDone:
  54+ 668A                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 668A 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 668D 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 668E 6F               LD L, A
  58+ 668F 26 00            LD H, 0
  59+ 6691 29               ADD HL, HL
  60+ 6692 29               ADD HL, HL
  61+ 6693 29               ADD HL, HL
  62+ 6694 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 6695 11 C7 80         LD DE, EntityTable
  64+ 6698 19               ADD HL, DE
  65+ 6699 E5               PUSH HL
  66+ 669A DD E1            POP IX
  67+ 669C                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 669C                  ; guardado en TriggerChurchTrap).
  69+ 669C 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 669F 21 04 67         LD HL, ChurchTrapBitMask
  71+ 66A2 5F               LD E, A
  72+ 66A3 16 00            LD D, 0
  73+ 66A5 19               ADD HL, DE
  74+ 66A6 7E               LD A, (HL)
  75+ 66A7 21 E9 81         LD HL, MonsterTrappedFlags
  76+ 66AA B6               OR (HL)
  77+ 66AB 77               LD (HL), A
  78+ 66AC                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 66AC                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 66AC                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 66AC 21 EA 81         LD HL, NextChurchTrapStep
  82+ 66AF 34               INC (HL)
  83+ 66B0                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 66B0                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 66B0                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 66B0                  ; antes de quedarse fija en blanco brillante.
  87+ 66B0 DD E5            PUSH IX
  88+ 66B2 CD C5 EC         CALL StartStatueBlink
  89+ 66B5 DD E1            POP IX
  90+ 66B7                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 66B7                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 66B7                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 66B7 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 66BB DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 66BF DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 66C3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 66C7                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 66C7                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 66C7                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 66C7                  ; anteriores del cutscene.)
 101+ 66C7                  ; Decidir spawn: 3 atrapados?
 102+ 66C7 3A E9 81         LD A, (MonsterTrappedFlags)
 103+ 66CA E6 07            AND $07
 104+ 66CC FE 07            CP $07
 105+ 66CE 28 12            JR Z, .actdAllTrapped
 106+ 66D0                  ; <3 atrapados: respawn church_key en AltN
 107+ 66D0 3E 01            LD A, 1
 108+ 66D2 32 DC 81         LD (ChurchKeySpawned), A
 109+ 66D5 21 EC 81         LD HL, ChurchKeyAltSpawnIdx
 110+ 66D8 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 66D9 CD 55 69         CALL RespawnChurchKeyAtAlt
 112+ 66DC                  ; Dibujar surgical en su nueva posicion
 113+ 66DC 11 AA DB         LD DE, BgGfx_church_key
 114+ 66DF C3 75 D3         JP RedrawPickupByPtr
 115+ 66E2              .actdAllTrapped:
 116+ 66E2                  ; Los 3 monstruos atrapados: descongelar el reloj, el ciclo dia/noche
 117+ 66E2                  ; reanuda desde donde se quedo al abrir la iglesia.
 118+ 66E2 AF               XOR A
 119+ 66E3 32 DF 81         LD (TimeFrozen), A
 120+ 66E6 3E 01            LD A, 1
 121+ 66E8 32 ED 81         LD (TownGateKeySpawned), A
 122+ 66EB 11 6F DB         LD DE, BgGfx_town_gate_key
 123+ 66EE CD 75 D3         CALL RedrawPickupByPtr
 124+ 66F1 3A E2 81         LD A, (CurrentObjective)
 125+ 66F4 FE 07            CP 7
 126+ 66F6 C0               RET NZ
 127+ 66F7 3C               INC A
 128+ 66F8 32 E2 81         LD (CurrentObjective), A
 129+ 66FB CD E5 E9         CALL ResolveObjectiveScreen
 130+ 66FE 3E FF            LD A, $FF
 131+ 6700 32 E5 81         LD (PreviousObjectiveDistance), A
 132+ 6703 C9               RET
