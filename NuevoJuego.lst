# file closed: bg_gfx_b.asm
 555  E498                  ; ay_sound.asm vive aqui (bank 4, no-contended). MainLoop entra via thunks
 556  E498                  ; en ay_sound_thunks.asm. ay_sound es self-contained: cero CALL/JP a
 557  E498                  ; rutinas externas, asi que NO hay cross-bank surface dentro del impl.
 558  E498                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ E498              ; ==============================================================================
   2+ E498              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E498              ; ==============================================================================
   4+ E498              ; Puertos:
   5+ E498              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E498              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E498              ;
   8+ E498              ; Registros AY:
   9+ E498              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E498              ;   R2/R3: tono canal B
  11+ E498              ;   R4/R5: tono canal C
  12+ E498              ;   R6:    period del ruido (5 bits)
  13+ E498              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E498              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E498              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E498              ;   R9:    volumen B
  17+ E498              ;   R10:   volumen C
  18+ E498              ;   R11/R12: period del envelope
  19+ E498              ;   R13:   forma del envelope (0-15)
  20+ E498              ; ==============================================================================
  21+ E498
  22+ E498              ; ==============================================================================
  23+ E498              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E498              ; ==============================================================================
  25+ E498              ; Entrada: A = registro (0-13), E = valor
  26+ E498              ; Destruye: BC, A
  27+ E498              ; ==============================================================================
  28+ E498              AY_WriteReg:
  29+ E498 01 FD FF         LD BC, $FFFD
  30+ E49B ED 79            OUT (C), A                  ; seleccionar registro
  31+ E49D 01 FD BF         LD BC, $BFFD
  32+ E4A0 ED 59            OUT (C), E                  ; escribir valor
  33+ E4A2 C9               RET
  34+ E4A3
  35+ E4A3              ; ==============================================================================
  36+ E4A3              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E4A3              ; ==============================================================================
  38+ E4A3              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E4A3              ; ==============================================================================
  40+ E4A3              AY_StopImpl:
  41+ E4A3 3E 08            LD A, 8
  42+ E4A5 1E 00            LD E, 0
  43+ E4A7 CD 98 E4         CALL AY_WriteReg
  44+ E4AA 3E 09            LD A, 9
  45+ E4AC 1E 00            LD E, 0
  46+ E4AE CD 98 E4         CALL AY_WriteReg
  47+ E4B1 3E 0A            LD A, 10
  48+ E4B3 1E 00            LD E, 0
  49+ E4B5 CD 98 E4         CALL AY_WriteReg
  50+ E4B8 C9               RET
  51+ E4B9
  52+ E4B9
  53+ E4B9              ; ==============================================================================
  54+ E4B9              ; AY_Init - Silencia todos los canales (volumen 0). Mixer = $38 (todos los
  55+ E4B9              ; tonos enable, ruidos off). El silencio se gestiona via volumen por canal:
  56+ E4B9              ; bell, music poly y SFX comparten el chip sin clobbear el mixer entre ellos.
  57+ E4B9              ; ==============================================================================
  58+ E4B9              AY_InitImpl:
  59+ E4B9 3E 07            LD A, 7                     ; mixer
  60+ E4BB 1E 38            LD E, $38                   ; tonos ABC on, ruidos off; muting via vol
  61+ E4BD CD 98 E4         CALL AY_WriteReg
  62+ E4C0 3E 08            LD A, 8                     ; volumen A
  63+ E4C2 1E 00            LD E, 0
  64+ E4C4 CD 98 E4         CALL AY_WriteReg
  65+ E4C7 3E 09            LD A, 9                     ; volumen B
  66+ E4C9 1E 00            LD E, 0
  67+ E4CB CD 98 E4         CALL AY_WriteReg
  68+ E4CE 3E 0A            LD A, 10                    ; volumen C
  69+ E4D0 1E 00            LD E, 0
  70+ E4D2 CD 98 E4         CALL AY_WriteReg
  71+ E4D5 C9               RET
  72+ E4D6
  73+ E4D6              ; ==============================================================================
  74+ E4D6              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  75+ E4D6              ; ==============================================================================
  76+ E4D6              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  77+ E4D6              ; el AY toca solo durante el decay.
  78+ E4D6              ; ==============================================================================
  79+ E4D6              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  80+ E4D6              ; ==============================================================================
  81+ E4D6              ; ==============================================================================
  82+ E4D6              ; Variables del decay manual de la campana — MOVIDAS a music_irq.asm (slot 1)
  83+ E4D6              ; para que el handler IRQ las pueda leer/escribir sin paginar slot 3 (regla
  84+ E4D6              ; project_irq_slot3_atomic). El tick del decay vive ahora en BellTickIrq
  85+ E4D6              ; (slot 1) y se llama desde MusicIrqHandler cada 25 Hz. Sin esto, durante
  86+ E4D6              ; DrawScreen / transiciones (varios frames sin MainLoop) el bell decay no
  87+ E4D6              ; se actualizaba -> "campanada se alarga / se apaga raro".
  88+ E4D6              ;
  89+ E4D6              ; AY_PlayBellChimeImpl (bank 4) sigue escribiendo a las vars sin cambios:
  90+ E4D6              ; slot 1 always-vis desde bank 4.
  91+ E4D6              ;
  92+ E4D6              ; Symbols importados desde music_irq.asm: BellVolL, BellVolC, BellVolR,
  93+ E4D6              ; BellDecayTimer, BELL_DECAY_RATE.
  94+ E4D6
  95+ E4D6              ; ==============================================================================
  96+ E4D6              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  97+ E4D6              ; ==============================================================================
  98+ E4D6              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  99+ E4D6              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
 100+ E4D6              ; ==============================================================================
 101+ E4D6              AY_PlayBellChimeImpl:
 102+ E4D6                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 103+ E4D6                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 104+ E4D6                  ; editor — el sonido espacial debe centrarse en la plaza real).
 105+ E4D6 3A 0D 83         LD A, (CurrentScreenX)
 106+ E4D9 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 107+ E4DB 57               LD D, A                     ; D = dx signed (player - plaza)
 108+ E4DC 30 02            JR NC, .absDxOk
 109+ E4DE ED 44            NEG
 110+ E4E0              .absDxOk:
 111+ E4E0 47               LD B, A                     ; B = |dx|
 112+ E4E1
 113+ E4E1 3A 0E 83         LD A, (CurrentScreenY)
 114+ E4E4 D6 09            SUB PLAZA_SCREEN_Y
 115+ E4E6 30 02            JR NC, .absDyOk
 116+ E4E8 ED 44            NEG
 117+ E4EA              .absDyOk:
 118+ E4EA 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 119+ E4EB
 120+ E4EB                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 121+ E4EB                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente)
 122+ E4EB                  ;   dist 3..5  -> dom=13, far=10  (medio: direccional pero audible)
 123+ E4EB                  ;   dist 6+    -> dom=11, far= 8  (lejos: direccional, MIN audible)
 124+ E4EB                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 125+ E4EB 06 0B            LD B, 11                    ; default tramo lejano: dom
 126+ E4ED 0E 08            LD C, 8                     ;                       far (subido +3 desde 5)
 127+ E4EF FE 06            CP 6
 128+ E4F1 30 0C            JR NC, .volTotalSet
 129+ E4F3 06 0D            LD B, 13                    ; tramo medio (subido +1 desde 12)
 130+ E4F5 0E 0A            LD C, 10                    ;             (subido +2 desde 8)
 131+ E4F7 FE 03            CP 3
 132+ E4F9 30 04            JR NC, .volTotalSet
 133+ E4FB 06 0F            LD B, 15                    ; tramo cercano (sin cambios)
 134+ E4FD 0E 0C            LD C, 12
 135+ E4FF              .volTotalSet:                   ; B = dom_vol, C = far_vol
 136+ E4FF
 137+ E4FF                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 138+ E4FF                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 139+ E4FF                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 140+ E4FF                  ; D == 0 → alineado X → solo canal B (centro)
 141+ E4FF 7A               LD A, D
 142+ E500 B7               OR A
 143+ E501 28 21            JR Z, .panCenter
 144+ E503 F2 15 E5         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 145+ E506                  ; D < 0: plaza al este → canal C dominante
 146+ E506              .panRight:
 147+ E506 79               LD A, C
 148+ E507 32 84 7F         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 149+ E50A 78               LD A, B
 150+ E50B 32 86 7F         LD (BellVolR), A            ; canal C = dom
 151+ E50E CB 3F            SRL A
 152+ E510 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 153+ E513 18 1A            JR .panDone
 154+ E515
 155+ E515              .panLeft:
 156+ E515                  ; D > 0: plaza al oeste → canal A dominante
 157+ E515 78               LD A, B
 158+ E516 32 84 7F         LD (BellVolL), A            ; canal A = dom
 159+ E519 CB 3F            SRL A
 160+ E51B 32 85 7F         LD (BellVolC), A            ; canal B = dom/2
 161+ E51E 79               LD A, C
 162+ E51F 32 86 7F         LD (BellVolR), A            ; canal C = far
 163+ E522 18 0B            JR .panDone
 164+ E524
 165+ E524              .panCenter:
 166+ E524                  ; Alineado: solo canal B
 167+ E524 78               LD A, B
 168+ E525 32 85 7F         LD (BellVolC), A
 169+ E528 AF               XOR A
 170+ E529 32 84 7F         LD (BellVolL), A
 171+ E52C 32 86 7F         LD (BellVolR), A
 172+ E52F
 173+ E52F              .panDone:
 174+ E52F 3E 02            LD A, BELL_DECAY_RATE
 175+ E531 32 87 7F         LD (BellDecayTimer), A
 176+ E534
 177+ E534                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 178+ E534 3E 00            LD A, 0                     ; R0: tone A LSB
 179+ E536 1E 58            LD E, $58
 180+ E538 CD 98 E4         CALL AY_WriteReg
 181+ E53B 3E 01            LD A, 1                     ; R1: tone A MSB
 182+ E53D 1E 02            LD E, $02
 183+ E53F CD 98 E4         CALL AY_WriteReg
 184+ E542 3E 02            LD A, 2                     ; R2: tone B LSB
 185+ E544 1E 58            LD E, $58
 186+ E546 CD 98 E4         CALL AY_WriteReg
 187+ E549 3E 03            LD A, 3                     ; R3: tone B MSB
 188+ E54B 1E 02            LD E, $02
 189+ E54D CD 98 E4         CALL AY_WriteReg
 190+ E550 3E 04            LD A, 4                     ; R4: tone C LSB
 191+ E552 1E 58            LD E, $58
 192+ E554 CD 98 E4         CALL AY_WriteReg
 193+ E557 3E 05            LD A, 5                     ; R5: tone C MSB
 194+ E559 1E 02            LD E, $02
 195+ E55B CD 98 E4         CALL AY_WriteReg
 196+ E55E
 197+ E55E                  ; --- Mixer: tonos A, B, C activos ---
 198+ E55E 3E 07            LD A, 7
 199+ E560 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 200+ E562 CD 98 E4         CALL AY_WriteReg
 201+ E565
 202+ E565                  ; --- Volúmenes iniciales ---
 203+ E565 3E 08            LD A, 8
 204+ E567 21 84 7F         LD HL, BellVolL
 205+ E56A 5E               LD E, (HL)
 206+ E56B CD 98 E4         CALL AY_WriteReg
 207+ E56E 3E 09            LD A, 9
 208+ E570 21 85 7F         LD HL, BellVolC
 209+ E573 5E               LD E, (HL)
 210+ E574 CD 98 E4         CALL AY_WriteReg
 211+ E577 3E 0A            LD A, 10
 212+ E579 21 86 7F         LD HL, BellVolR
 213+ E57C 5E               LD E, (HL)
 214+ E57D CD 98 E4         CALL AY_WriteReg
 215+ E580
 216+ E580 C9               RET
 217+ E581
 218+ E581              ; ==============================================================================
 219+ E581              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 220+ E581              ; ==============================================================================
 221+ E581              ; Llamar cada frame desde el main loop.
 222+ E581              ; ==============================================================================
 223+ E581              ; AY_UpdateBellImpl: STUB. El tick del decay vive ahora en BellTickIrq
 224+ E581              ; (slot 1, music_irq.asm) y se llama desde MusicIrqHandler cada 25 Hz.
 225+ E581              ; Mantenemos el thunk thunk AY_UpdateBell + Impl por compat (algunos hooks
 226+ E581              ; podrian seguir llamandolo); ya es no-op.
 227+ E581              AY_UpdateBellImpl:
 228+ E581 C9               RET
 229+ E582
 230+ E582              ; ==============================================================================
 231+ E582              ; MUSIC DRIVER - Dispatcher entre tracks (canal B AY)
 232+ E582              ; ==============================================================================
 233+ E582              ; State + tablas + tick (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote)
 234+ E582              ; viven AHORA en code/music_irq.asm (slot 1, $6000-$7FFF, siempre visible).
 235+ E582              ; El IRQ handler debe poder leer ese codigo/datos sin paginar slot 3 — paginar
 236+ E582              ; dentro del IRQ rompe los PUSH/POP del propio handler (ver
 237+ E582              ; project_ay_thunk_stack_bug.md).
 238+ E582              ;
 239+ E582              ; Aqui solo queda StartMusicImpl (dispatcher one-shot al cambiar de track):
 240+ E582              ; corre en bank 4 (paged en slot 3 por su thunk) y referencia simbolos de
 241+ E582              ; slot 1 (TensionMusicTable, MusicLoop, etc.) que estan siempre visibles.
 242+ E582              ; Tail-jumpea a MusicAdvanceNote (slot 1) tras setear mixer/vol.
 243+ E582              ;
 244+ E582              ; Tracks (mismo formato; ver music_irq.asm para tablas):
 245+ E582              ;   0=Tension, 1=Sunrise, 2=EndGame (LOOP), 3=GameOver, 4=Death (LOOP)
 246+ E582              ;   $FF=STOP, $FE=restart, $FD=stop-if-loopable
 247+ E582              ; ==============================================================================
 248+ E582
 249+ E582              ; (state vars + tablas movidas a music_irq.asm — ver bloque
 250+ E582              ; "MUSIC DRIVER STATE + TABLES + TICK" alli.)
 251+ E582
 252+ E582              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 253+ E582              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 254+ E582              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 255+ E582              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 256+ E582              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 257+ E582              StartMusicImpl:
 258+ E582 3A E4 99         LD A, (MusicTrackArg)
 259+ E585 FE FF            CP $FF
 260+ E587 28 54            JR Z, .smStop                   ; sentinel: parar musica activa
 261+ E589 FE FE            CP $FE
 262+ E58B 28 7A            JR Z, .smRestart                ; sentinel: re-armar track actual desde
 263+ E58D                                                  ; primera nota, PRESERVANDO MusicLoop y
 264+ E58D                                                  ; MusicSpeedShift (utiles para enfasis
 265+ E58D                                                  ; ej. "muerte se lanza" -> sigue loop +
 266+ E58D                                                  ; aplica nuevo tempo desde nota 0).
 267+ E58D FE FD            CP $FD
 268+ E58F 28 47            JR Z, .smStopIfLoopable         ; sentinel: parar solo si el track activo
 269+ E591                                                  ; es loopable. Usado por screen_system
 270+ E591                                                  ; al cambiar sala — corta DeathMusic (loopable,
 271+ E591                                                  ; ligada a Death entity) pero deja sonar
 272+ E591                                                  ; tension/sunrise (one-shot, music continua).
 273+ E591                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 274+ E591 F5               PUSH AF
 275+ E592 AF               XOR A
 276+ E593 32 AB 7B         LD (MusicLoop), A
 277+ E596 32 E5 99         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 278+ E599 F1               POP AF
 279+ E59A                  ; --- Resolver tabla + modo polifonico segun track id ---
 280+ E59A                  ; Tracks in-game (0/1/4) = poly2 (canal A+C, B reservado SFX).
 281+ E59A                  ; Tracks game-end (2/3) = poly3 (A+B+C, sin SFX en escena).
 282+ E59A 21 B3 7B         LD HL, TensionMusicTable
 283+ E59D B7               OR A
 284+ E59E 28 1E            JR Z, .smArmPoly2
 285+ E5A0 21 D1 7B         LD HL, SunriseMusicTable
 286+ E5A3 3D               DEC A
 287+ E5A4 28 18            JR Z, .smArmPoly2
 288+ E5A6 21 D5 7C         LD HL, EndGameMusicTable
 289+ E5A9 3D               DEC A
 290+ E5AA 28 19            JR Z, .smArmPoly3Loop            ; track 2 = LOOPABLE
 291+ E5AC 21 29 7D         LD HL, GameOverMusicTable
 292+ E5AF 3D               DEC A
 293+ E5B0 28 18            JR Z, .smArmPoly3
 294+ E5B2 21 5A 7D         LD HL, DeathMusicTable
 295+ E5B5 3D               DEC A
 296+ E5B6 28 01            JR Z, .smArmPoly2Loop            ; track 4 = LOOPABLE
 297+ E5B8 C9               RET                              ; track_id desconocido: no-op
 298+ E5B9
 299+ E5B9              .smArmPoly2Loop:
 300+ E5B9 3E 01            LD A, 1
 301+ E5BB 32 AB 7B         LD (MusicLoop), A
 302+ E5BE                  ; fall-through
 303+ E5BE              .smArmPoly2:
 304+ E5BE 3E 02            LD A, 2
 305+ E5C0 32 AC 7B         LD (MusicMode), A
 306+ E5C3 18 0A            JR .smArmCommon
 307+ E5C5
 308+ E5C5              .smArmPoly3Loop:
 309+ E5C5 3E 01            LD A, 1
 310+ E5C7 32 AB 7B         LD (MusicLoop), A
 311+ E5CA                  ; fall-through
 312+ E5CA              .smArmPoly3:
 313+ E5CA 3E 03            LD A, 3
 314+ E5CC 32 AC 7B         LD (MusicMode), A
 315+ E5CF                  ; fall-through
 316+ E5CF              .smArmCommon:
 317+ E5CF 22 A9 7B         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 318+ E5D2 22 A6 7B         LD (MusicPtr), HL
 319+ E5D5                  ; Mixer R7 vive en $38 (set por AY_Init) — los 3 tonos enable + ruidos off.
 320+ E5D5                  ; El silencio de un canal se gestiona via vol=0 (en MusicAdvanceNote y en
 321+ E5D5                  ; los SFX). No re-escribimos R7 aqui para no clobbear bell residual.
 322+ E5D5 C3 1B 7E         JP MusicAdvanceNote             ; tail-call: arma vol+period del primer nota
 323+ E5D8
 324+ E5D8              .smStopIfLoopable:
 325+ E5D8                  ; Sentinel $FD: solo para si el track activo es loopable. Tracks one-shot
 326+ E5D8                  ; (tension/sunrise/endgame) pasan de largo y siguen sonando.
 327+ E5D8 3A AB 7B         LD A, (MusicLoop)
 328+ E5DB B7               OR A
 329+ E5DC C8               RET Z
 330+ E5DD                  ; fall-through al stop normal
 331+ E5DD              .smStop:
 332+ E5DD                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 333+ E5DD                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 334+ E5DD AF               XOR A
 335+ E5DE 32 A8 7B         LD (MusicTimer), A
 336+ E5E1 32 AB 7B         LD (MusicLoop), A
 337+ E5E4 32 E5 99         LD (MusicSpeedShift), A         ; reset tempo
 338+ E5E7 67               LD H, A
 339+ E5E8 6F               LD L, A
 340+ E5E9 22 AD 7B         LD (MusicPeriodA), HL           ; clear periods → re-arm no escribe AY
 341+ E5EC 22 AF 7B         LD (MusicPeriodB), HL
 342+ E5EF 22 B1 7B         LD (MusicPeriodC), HL
 343+ E5F2                  ; Mute los 3 canales (poly2 usa A+C; poly3 usa A+B+C; vale para ambos).
 344+ E5F2 3E 08            LD A, 8
 345+ E5F4 1E 00            LD E, 0
 346+ E5F6 CD 98 E4         CALL AY_WriteReg                ; R8 = 0 (vol A)
 347+ E5F9 3E 09            LD A, 9
 348+ E5FB 1E 00            LD E, 0
 349+ E5FD CD 98 E4         CALL AY_WriteReg                ; R9 = 0 (vol B — solo era usado en poly3)
 350+ E600 3E 0A            LD A, 10
 351+ E602 1E 00            LD E, 0
 352+ E604 C3 98 E4         JP AY_WriteReg                  ; tail-call: R10 = 0 (vol C)
 353+ E607
 354+ E607              .smRestart:
 355+ E607                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 356+ E607                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 357+ E607                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 358+ E607                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 359+ E607                  ; con eventos del juego sin esperar al fin de la nota actual.
 360+ E607 2A A9 7B         LD HL, (MusicTableStart)
 361+ E60A 22 A6 7B         LD (MusicPtr), HL
 362+ E60D C3 1B 7E         JP MusicAdvanceNote
 363+ E610
 364+ E610              ; (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote movidos a music_irq.asm
 365+ E610              ; — slot 1, siempre visible, llamado desde el IRQ handler sin paginar.)
 366+ E610
# file closed: ay_sound.asm
