 255+ 9DBD              ; ==============================================================================
 256+ 9DBD              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9DBD              ; ==============================================================================
 258+ 9DBD              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9DBD              ; Entrada:
 260+ 9DBD              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9DBD              ;   A = atributo a pintar
 262+ 9DBD              ; ==============================================================================
 263+ 9DBD              SetEntityAttr:
 264+ 9DBD F5               PUSH AF                     ; Guardar atributo
 265+ 9DBE CD 25 A0         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9DC1 F1               POP AF
 267+ 9DC2
 268+ 9DC2 47               LD B, A                     ; B = atributo (preservar)
 269+ 9DC3 3A BC 9E         LD A, (EntityAttrH)
 270+ 9DC6 4F               LD C, A                     ; C = filas
 271+ 9DC7              .rowLoop:
 272+ 9DC7                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9DC7 E5               PUSH HL
 274+ 9DC8 7C               LD A, H
 275+ 9DC9 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9DCB 20 08            JR NZ, .rowNotHud
 277+ 9DCD 7D               LD A, L
 278+ 9DCE FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9DD0 30 03            JR NC, .rowNotHud
 280+ 9DD2                  ; Fila en HUD → saltar sin pintar
 281+ 9DD2 E1               POP HL
 282+ 9DD3 18 0B            JR .rowSkip
 283+ 9DD5              .rowNotHud:
 284+ 9DD5 E1               POP HL
 285+ 9DD6 3A BB 9E         LD A, (EntityAttrW)
 286+ 9DD9 E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9DDA                  ; Pintar una fila
 288+ 9DDA              .colLoop:
 289+ 9DDA 70               LD (HL), B
 290+ 9DDB 23               INC HL
 291+ 9DDC 3D               DEC A
 292+ 9DDD 20 FB            JR NZ, .colLoop
 293+ 9DDF E1               POP HL
 294+ 9DE0              .rowSkip:
 295+ 9DE0                  ; Siguiente fila: HL += 32
 296+ 9DE0 D5               PUSH DE
 297+ 9DE1 11 20 00         LD DE, 32
 298+ 9DE4 19               ADD HL, DE
 299+ 9DE5 D1               POP DE
 300+ 9DE6 0D               DEC C
 301+ 9DE7 20 DE            JR NZ, .rowLoop
 302+ 9DE9 C9               RET
