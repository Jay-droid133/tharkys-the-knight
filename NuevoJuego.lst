 443+ EC3D              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EC3D              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EC3D              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EC3D              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EC3D              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EC3D              .drawBar:
 449+ EC3D 7D               LD A, L
 450+ EC3E 32 89 EC         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EC41 7B               LD A, E
 452+ EC42 32 8A EC         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EC45 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EC47 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EC49                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EC49 3E 10            LD A, 16
 457+ EC4B 91               SUB C
 458+ EC4C 5F               LD E, A                             ; E = primera scanline llena
 459+ EC4D              .dbLoop:
 460+ EC4D                  ; Calcular direccion VRAM
 461+ EC4D 7A               LD A, D
 462+ EC4E FE 08            CP 8
 463+ EC50 30 09            JR NC, .dbCalcR1
 464+ EC52                  ; Char row 0
 465+ EC52 67               LD H, A
 466+ EC53 CB F4            SET 6, H
 467+ EC55 3A 89 EC         LD A, (.dbCol)
 468+ EC58 6F               LD L, A
 469+ EC59 18 09            JR .dbWrite
 470+ EC5B              .dbCalcR1:
 471+ EC5B                  ; Char row 1
 472+ EC5B D6 08            SUB 8
 473+ EC5D 67               LD H, A
 474+ EC5E CB F4            SET 6, H
 475+ EC60 3A 8A EC         LD A, (.dbCol1)
 476+ EC63 6F               LD L, A
 477+ EC64              .dbWrite:
 478+ EC64                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EC64 7A               LD A, D
 480+ EC65 BB               CP E
 481+ EC66 30 0B            JR NC, .dbFull
 482+ EC68                  ; Marchito: copiar sprite decayed
 483+ EC68 FD 7E 00         LD A, (IY+0)
 484+ EC6B 77               LD (HL), A
 485+ EC6C 23               INC HL
 486+ EC6D FD 7E 01         LD A, (IY+1)
 487+ EC70 77               LD (HL), A
 488+ EC71 18 09            JR .dbAdvanceSpr
 489+ EC73              .dbFull:
 490+ EC73                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EC73 DD 7E 00         LD A, (IX+0)
 492+ EC76 77               LD (HL), A
 493+ EC77 23               INC HL
 494+ EC78 DD 7E 01         LD A, (IX+1)
 495+ EC7B 77               LD (HL), A
