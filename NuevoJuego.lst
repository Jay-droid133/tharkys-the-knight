# file opened: tombstones.asm
   1+ 6B36              ; ==============================================================================
   2+ 6B36              ; TOMBSTONES - Tumbas persistentes en el mundo donde el player muere
   3+ 6B36              ; ==============================================================================
   4+ 6B36              ; Storage: bank 7 a $E000, 800 bytes (200 entradas x 4 bytes cada una).
   5+ 6B36              ; Layout por entrada: DEFB roomX, roomY, posX, posY  (todos 8-bit).
   6+ 6B36              ; TombstoneCount (1 byte, 0..200) en bank 2 (variables.asm, siempre visible).
   7+ 6B36              ;
   8+ 6B36              ; Vive en slot 1 ($6000+) tras paging.asm: las rutinas hacen el page switch
   9+ 6B36              ; siguiendo el patron de LoadBgSpriteToBuffer (DI durante la ventana, IFF
  10+ 6B36              ; tracking via StartupComplete, no CALLs/PUSH/POP entre los OUT).
  11+ 6B36              ;
  12+ 6B36              ; Cold paths: TombStore se llama 1 vez por muerte; DrawTombstonesInRoom al
  13+ 6B36              ; cargar pantalla. Coste invisible.
  14+ 6B36              ; ==============================================================================
  15+ 6B36
  16+ 6B36              TOMBSTONE_MAX     EQU 200
  17+ 6B36              TOMBSTONE_BYTES   EQU 4
  18+ 6B36              TOMBSTONE_BANK    EQU 7
