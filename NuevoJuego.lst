1193+ D652                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1194+ D652                  ; Total pixeles = height_px * (width_bytes & $7F)
1195+ D652              .spSkipRle:
1196+ D652 7B               LD A, E
1197+ D653 E6 7F            AND $7F                     ; width_bytes real
1198+ D655                  ; Calcular total = D * A (height * width)
1199+ D655 42               LD B, D                     ; B = height
1200+ D656 21 00 00         LD HL, 0
1201+ D659 16 00            LD D, 0
1202+ D65B 5F               LD E, A                     ; DE = width
1203+ D65C              .spMul:
1204+ D65C 19               ADD HL, DE
1205+ D65D 10 FD            DJNZ .spMul
1206+ D65F                  ; HL = total pixeles a consumir
1207+ D65F                  ; Recorrer tokens RLE hasta consumir HL pixeles
1208+ D65F              .spRleLoop:
1209+ D65F 7C               LD A, H
1210+ D660 B5               OR L
1211+ D661 C8               RET Z                       ; 0 pixeles restantes → IX en posicion correcta
1212+ D662 DD 7E 00         LD A, (IX+0)
1213+ D665 DD 23            INC IX
1214+ D667 CB 7F            BIT 7, A
1215+ D669 20 0C            JR NZ, .spRleRun
1216+ D66B                  ; Literal group: consume A bytes de datos (A = count 1-127)
1217+ D66B 5F               LD E, A
1218+ D66C 16 00            LD D, 0
1219+ D66E ED 52            SBC HL, DE                  ; HL -= count
1220+ D670                  ; Saltar los bytes literales
1221+ D670 43               LD B, E
1222+ D671              .spRleLitSkip:
1223+ D671 DD 23            INC IX
1224+ D673 10 FC            DJNZ .spRleLitSkip
1225+ D675 18 E8            JR .spRleLoop
1226+ D677              .spRleRun:
1227+ D677                  ; Run: consume (A & $7F)+2 pixeles, saltar 1 byte valor
1228+ D677 E6 7F            AND $7F
1229+ D679 C6 02            ADD A, 2
1230+ D67B 5F               LD E, A
1231+ D67C 16 00            LD D, 0
1232+ D67E ED 52            SBC HL, DE                  ; HL -= count
1233+ D680 DD 23            INC IX                      ; saltar byte valor
1234+ D682 18 DB            JR .spRleLoop
