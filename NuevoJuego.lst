 127+ E568              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 128+ E568              ; ==============================================================================
 129+ E568              UpdateRemapTables:
 130+ E568 3A FE E4         LD A, (CurrentTimeOfDay)
 131+ E56B 21 6B E9         LD HL, RemapTablePtrs
 132+ E56E 5F               LD E, A
 133+ E56F 16 00            LD D, 0
 134+ E571 19               ADD HL, DE
 135+ E572 19               ADD HL, DE
 136+ E573 5E               LD E, (HL)
 137+ E574 23               INC HL
 138+ E575 56               LD D, (HL)
 139+ E576 ED 53 FF E4      LD (CurrentRemapTable), DE
