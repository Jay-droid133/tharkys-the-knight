4853+ B9BC ED 5F            LD A, R
4854+ B9BE CB 57            BIT 2, A
4855+ B9C0 28 07            JR Z, .dxPos
4856+ B9C2 3A 5D 8D         LD A, (CurrentEnemySpeed)
4857+ B9C5 ED 44            NEG
4858+ B9C7 18 03            JR .setDX
4859+ B9C9              .dxPos:
4860+ B9C9 3A 5D 8D         LD A, (CurrentEnemySpeed)
4861+ B9CC              .setDX:
4862+ B9CC DD 77 06         LD (IX+ENT_DELTAX), A
4863+ B9CF ED 5F            LD A, R
4864+ B9D1 CB 5F            BIT 3, A
4865+ B9D3 28 07            JR Z, .dyPos
4866+ B9D5 3A 5D 8D         LD A, (CurrentEnemySpeed)
4867+ B9D8 ED 44            NEG
4868+ B9DA 18 03            JR .setDY
4869+ B9DC              .dyPos:
4870+ B9DC 3A 5D 8D         LD A, (CurrentEnemySpeed)
4871+ B9DF              .setDY:
4872+ B9DF DD 77 07         LD (IX+ENT_DELTAY), A
4873+ B9E2                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4874+ B9E2                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4875+ B9E2                  ; identicas y las nasties van en paralelo solapadas.
4876+ B9E2 DD 7E 06         LD A, (IX+ENT_DELTAX)
4877+ B9E5 E6 80            AND $80                             ; bit 7 = signo X
4878+ B9E7 47               LD B, A
4879+ B9E8 DD 7E 07         LD A, (IX+ENT_DELTAY)
4880+ B9EB E6 80            AND $80                             ; bit 7 = signo Y
4881+ B9ED 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4882+ B9EE B0               OR B                                ; A = signX(7) | signY(6)
4883+ B9EF 47               LD B, A
4884+ B9F0 3A FE 82         LD A, (LastSpawnDirSigns)
4885+ B9F3 B8               CP B
4886+ B9F4 20 0C            JR NZ, .spawnDirOk
4887+ B9F6                  ; Coincide -> voltear DELTAY (negar)
4888+ B9F6 DD 7E 07         LD A, (IX+ENT_DELTAY)
4889+ B9F9 ED 44            NEG
4890+ B9FB DD 77 07         LD (IX+ENT_DELTAY), A
4891+ B9FE 78               LD A, B
4892+ B9FF EE 40            XOR $40                             ; recalcular signs cacheados
4893+ BA01 47               LD B, A
4894+ BA02              .spawnDirOk:
4895+ BA02 78               LD A, B
4896+ BA03 32 FE 82         LD (LastSpawnDirSigns), A
