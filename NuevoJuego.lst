 294+ 67F9 CB 3F            SRL A
 294+ 67FB CB 3F          SRL A
 294+ 67FD CB 3F          SRL A                   ; A = char Y (post-HUD)
 295+ 67FF 26 00            LD H, 0
 296+ 6801 6F               LD L, A
 297+ 6802 29               ADD HL, HL                              ; *2
 298+ 6803 29               ADD HL, HL                              ; *4
 299+ 6804 29               ADD HL, HL                              ; *8
 300+ 6805 29               ADD HL, HL                              ; *16
 301+ 6806 29               ADD HL, HL                              ; *32
 302+ 6807 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 303+ 680A CB 3F            SRL A
 303+ 680C CB 3F          SRL A
 303+ 680E CB 3F          SRL A                   ; A = char X
 304+ 6810 5F               LD E, A
 305+ 6811 16 00            LD D, 0
 306+ 6813 19               ADD HL, DE
 307+ 6814 11 00 58         LD DE, $5800
 308+ 6817 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 309+ 6818 AF               XOR A                                   ; paper black, ink black
 310+ 6819 77               LD (HL), A                              ; (charY, charX)
 311+ 681A 23               INC HL
 312+ 681B 77               LD (HL), A                              ; (charY, charX+1)
 313+ 681C 11 1F 00         LD DE, 31
 314+ 681F 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 315+ 6820 77               LD (HL), A
 316+ 6821 23               INC HL
 317+ 6822 77               LD (HL), A                              ; (charY+1, charX+1)
