 253+ E507 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E508                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E508 21 00 40         LD HL, $4000
 256+ E50B                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E50B 5F               LD E, A
 258+ E50C 16 00            LD D, 0
 259+ E50E 42               LD B, D                             ; B = 0
 260+ E50F CB 23            SLA E
 260+ E511 CB 12          RL D                        ; *2
 261+ E513 CB 23            SLA E
 261+ E515 CB 12          RL D                        ; *4
 262+ E517 CB 23            SLA E
 262+ E519 CB 12          RL D                        ; *8
 263+ E51B E5               PUSH HL
 264+ E51C 21 00 3C         LD HL, $3C00
 265+ E51F 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E520 EB               EX DE, HL                           ; DE = glyph
 267+ E521 E1               POP HL                              ; HL = VRAM
 268+ E522 06 08            LD B, 8
 269+ E524              .drawChar:
 270+ E524 1A               LD A, (DE)
 271+ E525 77               LD (HL), A
 272+ E526 13               INC DE
 273+ E527 24               INC H                               ; siguiente scan line
 274+ E528 10 FA            DJNZ .drawChar
 275+ E52A                  ; Attr: fila 0, col 0 = $5800
 276+ E52A 3E 47            LD A, $47                           ; blanco bright
 277+ E52C 32 00 58         LD ($5800), A
 278+ E52F C9               RET
