 300+ E666              ; ==============================================================================
 301+ E666              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 302+ E666              ; ==============================================================================
 303+ E666              ; Entrada: A = attr original
 304+ E666              ; Salida:  A = attr transformado
 305+ E666              ; Preserva: HL, DE, BC, IX
 306+ E666              ; ==============================================================================
 307+ E666              ApplyDayCycleRemap:
 308+ E666 E5               PUSH HL
 309+ E667 67               LD H, A                     ; H = attr (temp save)
 310+ E668                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 311+ E668 3A 04 E5         LD A, (BgSpriteSkipRemap)
 312+ E66B B7               OR A
 313+ E66C 20 06            JR NZ, .skipRemap
 314+ E66E 3A FE E4         LD A, (CurrentTimeOfDay)
 315+ E671 B7               OR A
 316+ E672 20 03            JR NZ, .doRemap
 317+ E674              .skipRemap:
 318+ E674 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 319+ E675 E1               POP HL
 320+ E676 C9               RET
 321+ E677
 322+ E677              .doRemap:
 323+ E677 D5               PUSH DE
 324+ E678 C5               PUSH BC
 325+ E679
 326+ E679 7C               LD A, H                     ; A = attr original
 327+ E67A 4F               LD C, A                     ; C = attr original
 328+ E67B
 329+ E67B                  ; Guardar flash + ink (bits 7, 2-0)
 330+ E67B E6 87            AND $87                     ; A = F000_0III
 331+ E67D 47               LD B, A                     ; B = flash | ink
 332+ E67E
 333+ E67E                  ; Extraer paper+bright como indice 0-15
 334+ E67E 79               LD A, C
 335+ E67F E6 78            AND $78                     ; A = 0BPPP000
 336+ E681 0F               RRCA
 337+ E682 0F               RRCA
 338+ E683 0F               RRCA                        ; A = 0000BPPP = indice
 339+ E684
 340+ E684                  ; Elegir tabla segun tipo de sprite
 341+ E684 5F               LD E, A
 342+ E685 16 00            LD D, 0
 343+ E687 3A 03 E5         LD A, (BgSpriteIsHouse)
 344+ E68A B7               OR A
 345+ E68B 28 05            JR Z, .useStdTable
 346+ E68D 2A 01 E5         LD HL, (CurrentHouseRemapTable)
 347+ E690 18 03            JR .doLookup
 348+ E692              .useStdTable:
 349+ E692 2A FF E4         LD HL, (CurrentRemapTable)
 350+ E695              .doLookup:
 351+ E695 19               ADD HL, DE
 352+ E696 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 353+ E697
 354+ E697                  ; Reconstruir atributo
