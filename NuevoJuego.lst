4811+ B98E 3E 01            LD A, 1
4812+ B990 32 A1 B9         LD (.spawnIgnoreZone), A
4813+ B993 3E 04            LD A, 4
4814+ B995 32 A0 B9         LD (.spawnTries), A
4815+ B998 C3 55 B8         JP .spawnRetry
4816+ B99B              .spawnGiveUp:
4817+ B99B                  ; Todos los intentos fallaron → cancelar spawn
4818+ B99B DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4819+ B99F C9               RET
4820+ B9A0
4821+ B9A0 00           .spawnTries:      DEFB 0
4822+ B9A1 00           .spawnIgnoreZone: DEFB 0
4823+ B9A2 00           .spawnW1:         DEFB 0
4824+ B9A3 00           .spawnH1:         DEFB 0
