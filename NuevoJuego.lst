 311+ EBAD                  ; Repaint attrs en VRAM
 312+ EBAD C3 58 EF         JP PaintSynthPickupAttrsBody            ; tail call (intra-body)
 313+ EBB0
 314+ EBB0              ; ==============================================================================
 315+ EBB0              ; UpdatePlayerColorCyclerBody - cycler de color player segun buffs activos
 316+ EBB0              ; ==============================================================================
 317+ EBB0              ; Llamado desde MainLoop cada frame via thunk slot 1 (UpdatePlayerColorCycler).
 318+ EBB0              ; Lee timers de buffs/debuffs activos (16-bit cada uno), cuenta cuantos hay,
 319+ EBB0              ; cycla entre sus colores cada COLOR_CYCLER_PERIOD frames.
 320+ EBB0              ;
 321+ EBB0              ; Prioridades (en orden):
 322+ EBB0              ;   1. PlayerHitTimer > 0  -> no tocar color (RED damage flash gana)
 323+ EBB0              ;   2. >=1 buff activo     -> cyclar entre sus colores
 324+ EBB0              ;   3. AttackCooldown > 0  -> no tocar color (BLUE sword cooldown persiste)
 325+ EBB0              ;   4. Default             -> escribir WHITE | $40
 326+ EBB0              ;
 327+ EBB0              ; Orden fijo en el ciclo (afecta cual se ve primero): SpeedBuff (RAYO/CARACOL)
 328+ EBB0              ; primero, luego MushroomBuff (SETA). Fase 3/4 anadira ESPADA / ESCUDO / REVERSE.
 329+ EBB0              ;
 330+ EBB0              ; Destruye: AF, BC, DE, HL.
 331+ EBB0              ; ==============================================================================
 332+ EBB0              UpdatePlayerColorCyclerBody:
 333+ EBB0                  ; NOTA: el check de PlayerHitTimer vive en el thunk slot 1, NO aqui.
 334+ EBB0                  ; PlayerHitTimer esta en bank 0 (slot 3) y desde bank 7 body slot 3 = bank 7
 335+ EBB0                  ; -> lectura corrupta. El thunk gates el call antes de paginar.
 336+ EBB0
 337+ EBB0                  ; --- Pass 1: contar timers activos ---
 338+ EBB0 06 00            LD B, 0                                 ; B = count
 339+ EBB2 3A DC 82         LD A, (SpeedBuffTimer)
 340+ EBB5 4F               LD C, A
 341+ EBB6 3A DD 82         LD A, (SpeedBuffTimer+1)
 342+ EBB9 B1               OR C
 343+ EBBA 28 01            JR Z, .upcc_noSpeed
 344+ EBBC 04               INC B
 345+ EBBD              .upcc_noSpeed:
 346+ EBBD 3A DF 82         LD A, (MushroomLockTimer)
 347+ EBC0 4F               LD C, A
 348+ EBC1 3A E0 82         LD A, (MushroomLockTimer+1)
 349+ EBC4 B1               OR C
 350+ EBC5 28 01            JR Z, .upcc_noMush
 351+ EBC7 04               INC B
 352+ EBC8              .upcc_noMush:
 353+ EBC8 3A DA 5F         LD A, (EspadaTimer)
 354+ EBCB 4F               LD C, A
 355+ EBCC 3A DB 5F         LD A, (EspadaTimer+1)
 356+ EBCF B1               OR C
 357+ EBD0 28 01            JR Z, .upcc_noEspada
 358+ EBD2 04               INC B
 359+ EBD3              .upcc_noEspada:
 360+ EBD3 3A DC 5F         LD A, (EscudoTimer)
 361+ EBD6 4F               LD C, A
 362+ EBD7 3A DD 5F         LD A, (EscudoTimer+1)
 363+ EBDA B1               OR C
 364+ EBDB 28 01            JR Z, .upcc_noEscudo
 365+ EBDD 04               INC B
 366+ EBDE              .upcc_noEscudo:
 367+ EBDE 3A DE 5F         LD A, (ReverseTimer)
 368+ EBE1 4F               LD C, A
 369+ EBE2 3A DF 5F         LD A, (ReverseTimer+1)
 370+ EBE5 B1               OR C
 371+ EBE6 28 01            JR Z, .upcc_noReverse
 372+ EBE8 04               INC B
 373+ EBE9              .upcc_noReverse:
 374+ EBE9
 375+ EBE9 78               LD A, B
 376+ EBEA B7               OR A
 377+ EBEB 20 12            JR NZ, .upcc_haveBuffs
 378+ EBED
 379+ EBED                  ; --- Sin buffs. Prioridad 3: cooldown de espada = MAGENTA bright ---
 380+ EBED 3A 82 B3         LD A, (AttackCooldown)
 381+ EBF0 B7               OR A
 382+ EBF1 28 06            JR Z, .upcc_default
 383+ EBF3 3E 43            LD A, MAGENTA | $40                     ; $43 magenta bright (cooldown)
 384+ EBF5 32 A5 81         LD (EntityTable + ENT_ATTR), A
 385+ EBF8 C9               RET
 386+ EBF9
 387+ EBF9              .upcc_default:
 388+ EBF9                  ; --- Default: WHITE | $40 ---
 389+ EBF9 3E 47            LD A, WHITE | $40
 390+ EBFB 32 A5 81         LD (EntityTable + ENT_ATTR), A
 391+ EBFE C9               RET
 392+ EBFF
 393+ EBFF              .upcc_haveBuffs:
 394+ EBFF                  ; --- Increment frame counter (wrap natural a 256) ---
 395+ EBFF 21 D9 5F         LD HL, PlayerColorCyclerFrame
 396+ EC02 34               INC (HL)
 397+ EC03
 398+ EC03                  ; --- Slot = (frame / COLOR_CYCLER_PERIOD) mod B ---
 399+ EC03 7E               LD A, (HL)
 400+ EC04 16 00            LD D, 0                                 ; D = quotient (frame / PERIOD)
 401+ EC06              .upcc_divLoop:
 402+ EC06 D6 0C            SUB COLOR_CYCLER_PERIOD
 403+ EC08 38 03            JR C, .upcc_divDone
 404+ EC0A 14               INC D
 405+ EC0B 18 F9            JR .upcc_divLoop
 406+ EC0D              .upcc_divDone:
 407+ EC0D                  ; D = floor(frame / PERIOD). Mod B:
 408+ EC0D 7A               LD A, D
 409+ EC0E              .upcc_modLoop:
 410+ EC0E 90               SUB B
 411+ EC0F 30 FD            JR NC, .upcc_modLoop
 412+ EC11 80               ADD A, B                                ; A = slot (0..B-1)
 413+ EC12 57               LD D, A                                 ; D = target slot
 414+ EC13
 415+ EC13                  ; --- Pass 2: iterar buffs en orden fijo, aplicar color del slot-th ---
 416+ EC13 0E 00            LD C, 0                                 ; running count
 417+ EC15
 418+ EC15                  ; SpeedBuff (RAYO o CARACOL)
 419+ EC15 3A DC 82         LD A, (SpeedBuffTimer)
 420+ EC18 5F               LD E, A
 421+ EC19 3A DD 82         LD A, (SpeedBuffTimer+1)
 422+ EC1C B3               OR E
 423+ EC1D 28 05            JR Z, .upcc_skipSpeed
 424+ EC1F 7A               LD A, D
 425+ EC20 B9               CP C
 426+ EC21 28 4A            JR Z, .upcc_applySpeed
 427+ EC23 0C               INC C
 428+ EC24              .upcc_skipSpeed:
 429+ EC24
 430+ EC24                  ; MushroomBuff (SETA)
 431+ EC24 3A DF 82         LD A, (MushroomLockTimer)
 432+ EC27 5F               LD E, A
 433+ EC28 3A E0 82         LD A, (MushroomLockTimer+1)
 434+ EC2B B3               OR E
 435+ EC2C 28 05            JR Z, .upcc_skipMush
 436+ EC2E 7A               LD A, D
 437+ EC2F B9               CP C
 438+ EC30 28 48            JR Z, .upcc_applyMush
 439+ EC32 0C               INC C
 440+ EC33              .upcc_skipMush:
 441+ EC33
 442+ EC33                  ; Espada
 443+ EC33 3A DA 5F         LD A, (EspadaTimer)
 444+ EC36 5F               LD E, A
 445+ EC37 3A DB 5F         LD A, (EspadaTimer+1)
 446+ EC3A B3               OR E
 447+ EC3B 28 05            JR Z, .upcc_skipEspada
 448+ EC3D 7A               LD A, D
 449+ EC3E B9               CP C
 450+ EC3F 28 20            JR Z, .upcc_applyEspada
 451+ EC41 0C               INC C
 452+ EC42              .upcc_skipEspada:
 453+ EC42
 454+ EC42                  ; Escudo
 455+ EC42 3A DC 5F         LD A, (EscudoTimer)
 456+ EC45 5F               LD E, A
 457+ EC46 3A DD 5F         LD A, (EscudoTimer+1)
 458+ EC49 B3               OR E
 459+ EC4A 28 05            JR Z, .upcc_skipEscudo
 460+ EC4C 7A               LD A, D
 461+ EC4D B9               CP C
 462+ EC4E 28 15            JR Z, .upcc_applyEscudo
 463+ EC50 0C               INC C
 464+ EC51              .upcc_skipEscudo:
 465+ EC51
 466+ EC51                  ; Reverse
 467+ EC51 3A DE 5F         LD A, (ReverseTimer)
 468+ EC54 5F               LD E, A
 469+ EC55 3A DF 5F         LD A, (ReverseTimer+1)
 470+ EC58 B3               OR E
 471+ EC59 28 05            JR Z, .upcc_skipReverse
 472+ EC5B 7A               LD A, D
 473+ EC5C B9               CP C
 474+ EC5D 28 0A            JR Z, .upcc_applyReverse
 475+ EC5F 0C               INC C
 476+ EC60              .upcc_skipReverse:
 477+ EC60
 478+ EC60 C9               RET                                     ; unreachable si pass 1 fue correcto
