 718+ E7E1 10 FA            DJNZ .row0Char
 719+ E7E3 C9               RET
 720+ E7E4
 721+ E7E4              ; ==============================================================================
 722+ E7E4              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 723+ E7E4              ; ==============================================================================
 724+ E7E4              DrawTimeIndicator:
 725+ E7E4                  ; Calcular puntero al label de 2 chars
 726+ E7E4 3A 93 E4         LD A, (CurrentTimeOfDay)
 727+ E7E7 87               ADD A, A                    ; A = momento * 2
 728+ E7E8 5F               LD E, A
 729+ E7E9 16 00            LD D, 0
 730+ E7EB 21 EB E8         LD HL, TimeLabels
 731+ E7EE 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 732+ E7EF
 733+ E7EF                  ; Primer caracter en columna 30
 734+ E7EF 7E               LD A, (HL)
 735+ E7F0 E5               PUSH HL
 736+ E7F1 1E 1E            LD E, 30
 737+ E7F3 CD 07 E8         CALL DrawHudChar
 738+ E7F6 E1               POP HL
 739+ E7F7
 740+ E7F7                  ; Segundo caracter en columna 31
 741+ E7F7 23               INC HL
 742+ E7F8 7E               LD A, (HL)
 743+ E7F9 1E 1F            LD E, 31
 744+ E7FB CD 07 E8         CALL DrawHudChar
 745+ E7FE
 746+ E7FE                  ; Atributos del indicador (bright white on black)
 747+ E7FE 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 748+ E801 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 749+ E803 77               LD (HL), A
 750+ E804 23               INC HL
 751+ E805 77               LD (HL), A
 752+ E806 C9               RET
 753+ E807
 754+ E807              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 755+ E807              ; A = codigo ASCII, E = columna (0-31)
 756+ E807              DrawHudChar:
 757+ E807                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 758+ E807 6F               LD L, A
 759+ E808 26 00            LD H, 0
 760+ E80A 29               ADD HL, HL
 761+ E80B 29               ADD HL, HL
 762+ E80C 29               ADD HL, HL
 763+ E80D 01 00 3C         LD BC, $3C00
 764+ E810 09               ADD HL, BC                  ; HL = font data
 765+ E811
 766+ E811                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 767+ E811 16 40            LD D, $40                   ; Tercio 0, scan line 0
 768+ E813 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 769+ E815 83               ADD A, E
 770+ E816 5F               LD E, A                     ; DE = dir VRAM
 771+ E817
 772+ E817 06 08            LD B, 8
 773+ E819              .hudCharLoop:
 774+ E819 7E               LD A, (HL)
