7530+ CBD1              ; ==============================================================================
7531+ CBD1              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7532+ CBD1              ; ==============================================================================
7533+ CBD1              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7534+ CBD1              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7535+ CBD1              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7536+ CBD1              ; ==============================================================================
7537+ CBD1              ; ==============================================================================
7538+ CBD1              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7539+ CBD1              ; ==============================================================================
7540+ CBD1              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7541+ CBD1              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7542+ CBD1              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7543+ CBD1              ; los pone a su default.
7544+ CBD1              ; ==============================================================================
7545+ CBD1              InitGameState:
7546+ CBD1 3E 03            LD A, PLAYER_LIVES_INIT
7547+ CBD3 32 DE 82         LD (PlayerLives), A
7548+ CBD6 3E 10            LD A, HEALTH_MAX
7549+ CBD8 32 F2 B5         LD (PlayerHealth), A
7550+ CBDB 3E 10            LD A, STAMINA_MAX
7551+ CBDD 32 F3 B5         LD (PlayerStamina), A
7552+ CBE0 AF               XOR A
7553+ CBE1 32 DF 82         LD (GameOver), A
7554+ CBE4 32 B7 82         LD (CurrentObjective), A
7555+ CBE7 32 AE 82         LD (CurrentKey), A
7556+ CBEA 32 B2 82         LD (ChurchEverOpened), A
7557+ CBED 32 B1 82         LD (ChurchDoorOpen), A
7558+ CBF0 32 B3 82         LD (TimeFrozen), A
7559+ CBF3 32 B0 82         LD (ChurchKeySpawned), A
7560+ CBF6 32 C2 82         LD (TownGateKeySpawned), A
7561+ CBF9 32 D0 82         LD (ArmRevealed), A
7562+ CBFC 32 D1 82         LD (FingerRevealed), A
7563+ CBFF 32 F8 B5         LD (MonstersActive), A
7564+ CC02 32 BE 82         LD (MonsterTrappedFlags), A
7565+ CC05 32 FA 82         LD (DeathSpawned), A
7566+ CC08 32 C8 82         LD (TownGatePhase), A
7567+ CC0B 32 C6 82         LD (ChurchCutscenePhase), A
7568+ CC0E 32 0A E5         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7569+ CC11 32 B6 82         LD (BellsTriggered), A
7570+ CC14 32 BF 82         LD (NextChurchTrapStep), A
