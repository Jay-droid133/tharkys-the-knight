 580+ F1F8 7A               LD A, D
 581+ F1F9 84               ADD A, H
 582+ F1FA 32 02 F3         LD (.dcDistance), A
 583+ F1FD
 584+ F1FD                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F1FD                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F1FD                  ; Sprite_Compass_Magic / Sprite_Compass_MagicLasting (no oscilan); el wobble
 587+ F1FD                  ; logic solo gastaría CPU durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F1FD                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F1FD                  ; cuando el frame de transición está apretado.
 590+ F1FD 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F200 47               LD B, A
 592+ F201 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F204 B0               OR B
 594+ F205 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F207 AF               XOR A
 596+ F208 32 C5 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F20B 18 53            JR .dcWobbleEnd
 598+ F20D              .dcWobbleStartNormal:
 599+ F20D                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F20D                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F20D                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F20D                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F20D                  ; nuevo idx.
 604+ F20D                  ; Counter == 0 -> sin override, idx = target.
 605+ F20D 3A 01 F3         LD A, (.dcSpriteIdx)
 606+ F210 FE 04            CP 4
 607+ F212 20 06            JR NZ, .dcWobbleNotX
 608+ F214                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F214                  ; frame no redibuje innecesariamente.
 610+ F214 AF               XOR A
 611+ F215 32 C5 82         LD (CompassWobbleCounter), A
 612+ F218 18 46            JR .dcWobbleEnd
 613+ F21A              .dcWobbleNotX:
 614+ F21A                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F21A 3A 10 83         LD A, (CurrentScreenX)
 616+ F21D 47               LD B, A
 617+ F21E 3A C3 82         LD A, (LastCompassScreenX)
 618+ F221 B8               CP B
 619+ F222 20 0A            JR NZ, .dcWobbleStart
 620+ F224 3A 11 83         LD A, (CurrentScreenY)
 621+ F227 47               LD B, A
 622+ F228 3A C4 82         LD A, (LastCompassScreenY)
 623+ F22B B8               CP B
 624+ F22C 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F22E              .dcWobbleStart:
 626+ F22E 3E 09            LD A, 9
 627+ F230 32 C5 82         LD (CompassWobbleCounter), A
 628+ F233              .dcWobbleResolve:
 629+ F233 3A C5 82         LD A, (CompassWobbleCounter)
 630+ F236 B7               OR A
 631+ F237 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F239 3D               DEC A
 633+ F23A 32 C5 82         LD (CompassWobbleCounter), A
 634+ F23D                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F23D 21 62 F7         LD HL, WobblePhaseTable
 636+ F240 5F               LD E, A
 637+ F241 16 00            LD D, 0
 638+ F243 19               ADD HL, DE
 639+ F244 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F245 FE 02            CP 2
 641+ F247 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F249                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F249                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F249 FE 03            CP 3
 645+ F24B 38 01            JR C, .dcWobbleOffsetReady
 646+ F24D 3D               DEC A
 647+ F24E              .dcWobbleOffsetReady:
 648+ F24E 5F               LD E, A
 649+ F24F 3A 01 F3         LD A, (.dcSpriteIdx)
 650+ F252 87               ADD A, A                            ; idx*2
 651+ F253 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F254 83               ADD A, E                            ; +offset
 653+ F255 21 3E F7         LD HL, CompassWobbleTable
 654+ F258 5F               LD E, A
 655+ F259 16 00            LD D, 0
 656+ F25B 19               ADD HL, DE
 657+ F25C 7E               LD A, (HL)
 658+ F25D 32 01 F3         LD (.dcSpriteIdx), A                ; override
 659+ F260
 660+ F260              .dcWobbleEnd:
 661+ F260
 662+ F260                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F260                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F260                  ; sin bright + char activo white bright; en warning el char activo
 665+ F260                  ; parpadea bright on/off a ~6 Hz).
 666+ F260                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F260                  ; blanca se mantiene tal cual.
 668+ F260 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F263 47               LD B, A
 670+ F264 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F267 B0               OR B
 672+ F268 28 3E            JR Z, .dcMagicOff
 673+ F26A 3A 01 F3         LD A, (.dcSpriteIdx)
 674+ F26D FE 04            CP 4
 675+ F26F 28 37            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F271 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F274 FE FF            CP $FF
 678+ F276 28 30            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F278                  ; --- MAGIC HUD ---
 680+ F278                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F278                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F278                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F278                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F278                  ;
 685+ F278                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F278                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F278                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F278                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F278                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F278                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F278                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F278 3A CD 82         LD A, (MagicCompassPermanent)
 693+ F27B B7               OR A
 694+ F27C 28 11            JR Z, .dcMagicTemp
 695+ F27E                  ; --- Lasting (permanente, post-iglesia) ---
 696+ F27E 3A C1 5F         LD A, (MagicCompassPathDir)
 697+ F281 F6 80            OR $80                              ; bit 7 = 1 (lasting)
 698+ F283 47               LD B, A
 699+ F284 3A CC 5F         LD A, (LastMagicCompassDrawn)
 700+ F287 B8               CP B
 701+ F288 28 19            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 702+ F28A 11 3A 6F         LD DE, Sprite_Compass_MagicLasting
 703+ F28D 18 0D            JR .dcMagicDraw
 704+ F28F              .dcMagicTemp:
 705+ F28F 3A C1 5F         LD A, (MagicCompassPathDir)         ; bit 7 ya 0 (PathDir 0..3)
 706+ F292 47               LD B, A
 707+ F293 3A CC 5F         LD A, (LastMagicCompassDrawn)
 708+ F296 B8               CP B
 709+ F297 28 0A            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 710+ F299 11 16 6F         LD DE, Sprite_Compass_Magic
 711+ F29C              .dcMagicDraw:
 712+ F29C                  ; Almacenar cache key ANTES del CALL (DrawCompassSprite destruye B usándolo
 713+ F29C                  ; como contador de filas). Semánticamente equivalente: el call no falla.
 714+ F29C 78               LD A, B
 715+ F29D 32 CC 5F         LD (LastMagicCompassDrawn), A
 716+ F2A0 CD 04 F3         CALL DrawCompassSprite
 717+ F2A3              .dcMagicAttrsOnly:
 718+ F2A3 CD CF 6E         CALL PaintMagicCompassAttrs
 719+ F2A6 18 40            JR .dcDrawDone
 720+ F2A8
 721+ F2A8              .dcMagicOff:
 722+ F2A8                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 723+ F2A8                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 724+ F2A8 3E FF            LD A, $FF
 725+ F2AA 32 CC 5F         LD (LastMagicCompassDrawn), A
 726+ F2AD
 727+ F2AD                  ; --- Color normal ---
 728+ F2AD                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 729+ F2AD 3A 01 F3         LD A, (.dcSpriteIdx)
 730+ F2B0 FE 04            CP 4
 731+ F2B2 28 18            JR Z, .dcWhite
 732+ F2B4 3A C2 82         LD A, (PreviousObjectiveDistance)
 733+ F2B7 FE FF            CP $FF
 734+ F2B9 28 11            JR Z, .dcWhite
 735+ F2BB 47               LD B, A
 736+ F2BC 3A 02 F3         LD A, (.dcDistance)
 737+ F2BF B8               CP B
 738+ F2C0 28 0A            JR Z, .dcWhite                      ; igual = blanco
 739+ F2C2 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 740+ F2C4 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 741+ F2C6 18 06            JR .dcColorDone
 742+ F2C8              .dcGreen:
 743+ F2C8 3E 44            LD A, GREEN | $40
 744+ F2CA 18 02            JR .dcColorDone
 745+ F2CC              .dcWhite:
 746+ F2CC 3E 47            LD A, WHITE | $40
 747+ F2CE              .dcColorDone:
 748+ F2CE 32 03 F3         LD (.dcAttr), A
 749+ F2D1
 750+ F2D1                  ; --- Sprite ptr de CompassSprites[idx] ---
 751+ F2D1 3A 01 F3         LD A, (.dcSpriteIdx)
 752+ F2D4 87               ADD A, A                            ; *2
 753+ F2D5 6F               LD L, A
 754+ F2D6 26 00            LD H, 0
 755+ F2D8 11 2C F7         LD DE, CompassSprites
 756+ F2DB 19               ADD HL, DE
 757+ F2DC 5E               LD E, (HL)
 758+ F2DD 23               INC HL
 759+ F2DE 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 760+ F2DF CD 04 F3         CALL DrawCompassSprite
 761+ F2E2
 762+ F2E2                  ; --- Attrs ---
 763+ F2E2 3A 03 F3         LD A, (.dcAttr)
 764+ F2E5 CD 27 F3         CALL SetCompassAttrs
 765+ F2E8
 766+ F2E8              .dcDrawDone:
 767+ F2E8
 768+ F2E8                  ; --- Cachear estado ---
 769+ F2E8                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 770+ F2E8                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 771+ F2E8                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 772+ F2E8                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 773+ F2E8                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 774+ F2E8                  ; el wobble y la comparacion sigue siendo correcta.
 775+ F2E8 3A C5 82         LD A, (CompassWobbleCounter)
 776+ F2EB B7               OR A
 777+ F2EC 20 06            JR NZ, .dcSkipPrevDistSave
 778+ F2EE 3A 02 F3         LD A, (.dcDistance)
 779+ F2F1 32 C2 82         LD (PreviousObjectiveDistance), A
 780+ F2F4              .dcSkipPrevDistSave:
 781+ F2F4 3A 10 83         LD A, (CurrentScreenX)
 782+ F2F7 32 C3 82         LD (LastCompassScreenX), A
 783+ F2FA 3A 11 83         LD A, (CurrentScreenY)
 784+ F2FD 32 C4 82         LD (LastCompassScreenY), A
 785+ F300 C9               RET
 786+ F301
 787+ F301 00           .dcSpriteIdx: DEFB 0
 788+ F302 00           .dcDistance:  DEFB 0
 789+ F303 00           .dcAttr:      DEFB 0
