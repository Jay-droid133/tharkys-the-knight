 313+ E5A4 09               DEFB 9                          ; ~360ms
 314+ E5A5 44 03            DEFW $0344                      ; C3  ~131 Hz
 315+ E5A7 09               DEFB 9
 316+ E5A8 E2 03            DEFW $03E2                      ; A2
 317+ E5AA 09               DEFB 9
 318+ E5AB E9 02            DEFW $02E9                      ; D3  ~147 Hz (climax mas alto)
 319+ E5AD 0B               DEFB 11                         ; ~440ms sostenido
 320+ E5AE 00 00            DEFW 0
 321+ E5B0 00               DEFB 0                          ; fin
 322+ E5B1
 323+ E5B1              ; --- Track 1: SunriseMusic ---
