2305+ AEC6              ; ==============================================================================
2306+ AEC6              CheckPredatorAttack:
2307+ AEC6                  ; Buscar tipo depredador en PredatorTable
2308+ AEC6 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2309+ AEC9 D6 20            SUB SPRID_ENEMY_0
2310+ AECB CB 3F            SRL A
2311+ AECD CB 3F            SRL A                               ; indice = (ANIMBASE - ENEMY_0) / 4
2312+ AECF 21 C7 BF         LD HL, PredatorTable
2313+ AED2 5F               LD E, A
2314+ AED3 16 00            LD D, 0
2315+ AED5 19               ADD HL, DE
2316+ AED6 7E               LD A, (HL)                          ; A = byte predador
2317+ AED7 B7               OR A
2318+ AED8 C8               RET Z                               ; PRED_NONE → no es depredador
2319+ AED9
2320+ AED9                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2321+ AED9 47               LD B, A                             ; B = byte predador completo
2322+ AEDA CB 3F            SRL A
2323+ AEDC CB 3F            SRL A                               ; A = ciclo requerido (1-3)
2324+ AEDE 4F               LD C, A
2325+ AEDF 3A D3 BF         LD A, (DayCycleCount)
2326+ AEE2 B9               CP C
2327+ AEE3 D8               RET C                               ; DayCycleCount < ciclo requerido → no atacar
2328+ AEE4
2329+ AEE4                  ; Calcular velocidad de ataque segun ciclo
2330+ AEE4 3A D3 BF         LD A, (DayCycleCount)
2331+ AEE7 FE 04            CP 4
2332+ AEE9 38 02            JR C, .cpSpeedOk
2333+ AEEB 3E 03            LD A, 3                             ; Cap en 3
2334+ AEED              .cpSpeedOk:
2335+ AEED 21 CF BF         LD HL, PredatorSpeedTable
2336+ AEF0 5F               LD E, A
2337+ AEF1 16 00            LD D, 0
2338+ AEF3 19               ADD HL, DE
2339+ AEF4 7E               LD A, (HL)
2340+ AEF5 32 72 AF         LD (.cpSpeed), A
2341+ AEF8
2342+ AEF8                  ; Tipo depredador activo: comprobar alineacion
2343+ AEF8 78               LD A, B
2344+ AEF9 E6 03            AND $03                             ; A = tipo (1=arriba, 2=abajo, 3=horizontal)
2345+ AEFB FE 03            CP PRED_HORIZONTAL
2346+ AEFD 28 41            JR Z, .cpHorizontal
2347+ AEFF
2348+ AEFF                  ; === Vertical (arriba/abajo): comprobar |nastyX - playerX| < PRED_ALIGN_DIST ===
2349+ AEFF 4F               LD C, A                             ; C = tipo (1 o 2)
2350+ AF00 DD 7E 03         LD A, (IX+ENT_POSX)
2351+ AF03 57               LD D, A
2352+ AF04 3A 42 81         LD A, (EntityTable + ENT_POSX)
2353+ AF07 92               SUB D
2354+ AF08 30 02            JR NC, .cpAbsX
2355+ AF0A ED 44            NEG
2356+ AF0C              .cpAbsX:
2357+ AF0C FE 0C            CP PRED_ALIGN_DIST
2358+ AF0E D0               RET NC                              ; No alineado en X
2359+ AF0F
2360+ AF0F                  ; Comprobar posicion relativa Y
2361+ AF0F 79               LD A, C
2362+ AF10 FE 01            CP PRED_FROM_ABOVE
2363+ AF12 28 17            JR Z, .cpFromAbove
2364+ AF14                  ; Desde abajo: nastyY > playerY
2365+ AF14 DD 7E 04         LD A, (IX+ENT_POSY)
2366+ AF17 57               LD D, A
2367+ AF18 3A 43 81         LD A, (EntityTable + ENT_POSY)
2368+ AF1B BA               CP D
2369+ AF1C D0               RET NC                              ; playerY >= nastyY → no esta abajo
2370+ AF1D                  ; Lanzarse hacia arriba
2371+ AF1D 3A 72 AF         LD A, (.cpSpeed)
2372+ AF20 ED 44            NEG
2373+ AF22 DD 77 07         LD (IX+ENT_DELTAY), A
2374+ AF25 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2375+ AF29 18 42            JR .cpActivate
2376+ AF2B              .cpFromAbove:
2377+ AF2B                  ; Desde arriba: nastyY < playerY
2378+ AF2B 3A 43 81         LD A, (EntityTable + ENT_POSY)
2379+ AF2E 57               LD D, A
2380+ AF2F DD 7E 04         LD A, (IX+ENT_POSY)
2381+ AF32 BA               CP D
2382+ AF33 D0               RET NC                              ; nastyY >= playerY → no esta arriba
2383+ AF34                  ; Lanzarse hacia abajo
2384+ AF34 3A 72 AF         LD A, (.cpSpeed)
2385+ AF37 DD 77 07         LD (IX+ENT_DELTAY), A
2386+ AF3A DD 36 06 00      LD (IX+ENT_DELTAX), 0
2387+ AF3E 18 2D            JR .cpActivate
2388+ AF40
2389+ AF40              .cpHorizontal:
2390+ AF40                  ; === Horizontal: comprobar |nastyY - playerY| < PRED_ALIGN_DIST ===
2391+ AF40 DD 7E 04         LD A, (IX+ENT_POSY)
2392+ AF43 57               LD D, A
2393+ AF44 3A 43 81         LD A, (EntityTable + ENT_POSY)
2394+ AF47 92               SUB D
2395+ AF48 30 02            JR NC, .cpAbsY
2396+ AF4A ED 44            NEG
