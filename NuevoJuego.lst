 189+ 60AB              ; ==============================================================================
 190+ 60AB              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 60AB              ; ==============================================================================
 192+ 60AB              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 60AB              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 60AB              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 60AB              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 60AB              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 60AB              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 60AB              ; Destruye: AF, BC, DE, HL, IX.
 199+ 60AB              ; ==============================================================================
 200+ 60AB              StartTownGateCutscene:
 201+ 60AB AF               XOR A
 202+ 60AC 32 52 82         LD (CurrentKey), A
 203+ 60AF CD A8 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 60B2 CD 13 BD         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 60B5 CD C6 60         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 60B8 CD 2A 66         CALL SFX_TownGate_OnStart
 207+ 60BB 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 60BD 32 68 82         LD (TownGatePhase), A
