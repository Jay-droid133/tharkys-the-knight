 190+ 9EB8 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EBC DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9EC0 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
