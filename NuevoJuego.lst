5697+ BF51 30 04            JR NC, .kbPosLeft
5698+ BF53 3E 04            LD A, MONSTER_KB_SPEED          ; Monster a la derecha → empujar derecha
5699+ BF55 18 02            JR .kbSetX
5700+ BF57              .kbPosLeft:
5701+ BF57 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster a la izquierda → empujar izq
5702+ BF59              .kbSetX:
