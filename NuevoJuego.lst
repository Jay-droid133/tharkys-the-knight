 471+ 92F2 FE 05            CP STATE_SCARED
 472+ 92F4 20 0B            JR NZ, .dsmNext
 473+ 92F6 CD A2 92         CALL WipeMonsterSlot
 474+ 92F9 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 475+ 92FD DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
