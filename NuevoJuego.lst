 129+ F7BC              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F7BC              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F7BC              SFX_FootstepTic:
 132+ F7BC 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F7C0 00               DEFB 0                      ; fin
 134+ F7C1
 135+ F7C1              SFX_FootstepTac:
