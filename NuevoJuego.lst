4185+ B642                  ; Calcular posicion en buffer: count × 5
4186+ B642 6F               LD L, A
4187+ B643 26 00            LD H, 0
4188+ B645 29               ADD HL, HL
4189+ B646 29               ADD HL, HL
4190+ B647 29               ADD HL, HL                          ; count × 8 (simplificado)
4191+ B648                  ; Corregir: count × 5 = count × 4 + count
4192+ B648 6F               LD L, A
4193+ B649 26 00            LD H, 0
4194+ B64B 54               LD D, H
4195+ B64C 5D               LD E, L
4196+ B64D 29               ADD HL, HL
4197+ B64E 29               ADD HL, HL                          ; count × 4
