 557+ ECB7 2F               CPL                 ; ~mask
 558+ ECB8 62               LD H, D
 559+ ECB9 6B               LD L, E
 560+ ECBA A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ ECBB 77               LD (HL), A
 562+ ECBC E1               POP HL
 563+ ECBD 18 ED            JR .pixLoop
