 206+ 9EE8              ; ==============================================================================
 207+ 9EE8              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ 9EE8              ; ==============================================================================
 209+ 9EE8              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ 9EE8              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ 9EE8              ; que los pies parezcan hundirse en el suelo.
 212+ 9EE8              ; ==============================================================================
 213+ 9EE8              ComputePlayerDrawY:
 214+ 9EE8                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ 9EE8                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ 9EE8                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ 9EE8 3A 9B 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ 9EEB D6 6E            SUB SPRID_PLAYER_DEATH
 219+ 9EED FE 06            CP 6
 220+ 9EEF 30 09            JR NC, .cpdyNotDeath
 221+ 9EF1 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 222+ 9EF4 C6 05            ADD A, 5
 223+ 9EF6 32 DC 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ 9EF9 C9               RET
 225+ 9EFA              .cpdyNotDeath:
 226+ 9EFA 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 227+ 9EFD C6 08            ADD A, 8                    ; center X del player
 228+ 9EFF 47               LD B, A
 229+ 9F00 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 230+ 9F03 4F               LD C, A
 231+ 9F04 32 DC 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ 9F07 B7               OR A
 233+ 9F08 C8               RET Z
 234+ 9F09 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ 9F0A CD 0E D5         CALL IsPointBlocked
 236+ 9F0D C8               RET Z                       ; libre → sin offset
 237+ 9F0E 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 238+ 9F11 3C               INC A
 239+ 9F12 32 DC 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ 9F15 C9               RET
 241+ 9F16
 242+ 9F16              ; ==============================================================================
 243+ 9F16              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ 9F16              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ 9F16              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ 9F16              ; no parecer que se hunde en el techo.
 247+ 9F16              ; Preserva: IX. Destruye: AF, BC.
 248+ 9F16              ; ==============================================================================
 249+ 9F16              ComputeEnemyDrawY:
 250+ 9F16 DD 7E 04         LD A, (IX+ENT_POSY)
 251+ 9F19 32 DD 82         LD (EnemyDrawY), A          ; default = POSY
 252+ 9F1C DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ 9F1F FE 02            CP TYPE_MONSTER
 254+ 9F21 C0               RET NZ                      ; no monster → sin offset
 255+ 9F22 DD 7E 03         LD A, (IX+ENT_POSX)
 256+ 9F25 C6 08            ADD A, 8                    ; center X
 257+ 9F27 47               LD B, A
 258+ 9F28 DD 7E 04         LD A, (IX+ENT_POSY)
 259+ 9F2B 4F               LD C, A
 260+ 9F2C B7               OR A
 261+ 9F2D C8               RET Z
 262+ 9F2E 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F2F CD 0E D5         CALL IsPointBlocked
 264+ 9F32 C8               RET Z                       ; libre → sin offset
 265+ 9F33 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F36 3C               INC A
 267+ 9F37 32 DD 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F3A C9               RET
