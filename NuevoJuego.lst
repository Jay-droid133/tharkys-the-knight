 224+ D9F3              ; ==============================================================================
 225+ D9F3              ; DrawClockFaceOnly - Redibuja solo la esfera (cols 15-16, filas 22-23)
 226+ D9F3              ; ==============================================================================
 227+ D9F3              ; Salta los bytes de decoración (bytes 0-1 y 4-5 de cada fila del sprite)
 228+ D9F3              ; ==============================================================================
 229+ D9F3              DrawClockFaceOnly:
 230+ D9F3 DD 21 F2 D6      LD IX, BgGfx_hud_clock + 2  ; saltar cabecera
 231+ D9F7
 232+ D9F7 26 40            LD H, $40
 233+ D9F9 2E 0F            LD L, $0F               ; col 15, scan 0, fila 0
 234+ D9FB 0E 08            LD C, 8
 235+ D9FD              .fc22:
 236+ D9FD DD 23            INC IX
 236+ D9FF DD 23          INC IX         ; saltar bytes 0-1 (decoración izquierda)
 237+ DA01 E5               PUSH HL
 238+ DA02 C5               PUSH BC
 239+ DA03 DD 7E 00         LD A, (IX)
 239+ DA06 DD 23          INC IX
 239+ DA08 2F             CPL
 239+ DA09 77             LD (HL), A
 239+ DA0A 23             INC HL  ; byte 2 → col 15
 240+ DA0B DD 7E 00         LD A, (IX)
 240+ DA0E DD 23          INC IX
 240+ DA10 2F             CPL
 240+ DA11 77             LD (HL), A            ; byte 3 → col 16
 241+ DA12 DD 23            INC IX
 241+ DA14 DD 23          INC IX         ; saltar bytes 4-5 (decoración derecha)
 242+ DA16 C1               POP BC
 243+ DA17 E1               POP HL
 244+ DA18 24               INC H
 245+ DA19 0D               DEC C
 246+ DA1A 20 E1            JR NZ, .fc22
 247+ DA1C
 248+ DA1C 26 40            LD H, $40
 249+ DA1E 2E 2F            LD L, $2F               ; col 15, scan 0, fila 1
 250+ DA20 0E 08            LD C, 8
 251+ DA22              .fc23:
 252+ DA22 DD 23            INC IX
 252+ DA24 DD 23          INC IX
 253+ DA26 E5               PUSH HL
 254+ DA27 C5               PUSH BC
 255+ DA28 DD 7E 00         LD A, (IX)
 255+ DA2B DD 23          INC IX
 255+ DA2D 2F             CPL
 255+ DA2E 77             LD (HL), A
 255+ DA2F 23             INC HL
 256+ DA30 DD 7E 00         LD A, (IX)
 256+ DA33 DD 23          INC IX
 256+ DA35 2F             CPL
 256+ DA36 77             LD (HL), A
 257+ DA37 DD 23            INC IX
 257+ DA39 DD 23          INC IX
 258+ DA3B C1               POP BC
 259+ DA3C E1               POP HL
 260+ DA3D 24               INC H
 261+ DA3E 0D               DEC C
 262+ DA3F 20 E1            JR NZ, .fc23
 263+ DA41
 264+ DA41                  ; Atributos de la esfera (filas 0-1, cols 15-16)
 265+ DA41 3E 47            LD A, $47              ; col 15: bright white
 266+ DA43 32 0F 58         LD ($580F), A
 267+ DA46 32 2F 58         LD ($582F), A
 268+ DA49 3E 07            LD A, $07              ; col 16: white
 269+ DA4B 32 10 58         LD ($5810), A
 270+ DA4E 32 30 58         LD ($5830), A
 271+ DA51 C9               RET
 272+ DA52
 273+ DA52              ; ==============================================================================
 274+ DA52              ; DrawClockSprite - Copia BgGfx_hud_clock al HUD (filas 22-23, cols 13-18)
 275+ DA52              ; ==============================================================================
 276+ DA52              ; Aplica CPL a cada byte (datos almacenados invertidos, como en DrawBgGfxSprite)
 277+ DA52              ; ==============================================================================
 278+ DA52              DrawClockSprite:
 279+ DA52 DD 21 F2 D6      LD IX, BgGfx_hud_clock + 2  ; saltar cabecera height_px, width_bytes
 280+ DA56
 281+ DA56                  ; --- Filas 0-7 del sprite → fila 0, scans 0-7 ---
 282+ DA56 26 40            LD H, $40
 283+ DA58 2E 0D            LD L, $0D               ; col 13, scan 0
 284+ DA5A 0E 08            LD C, 8
 285+ DA5C              .r22:
 286+ DA5C E5               PUSH HL
 287+ DA5D C5               PUSH BC
 288+ DA5E 06 06            LD B, 6
 289+ DA60              .b22:
 290+ DA60 DD 7E 00         LD A, (IX)
 291+ DA63 2F               CPL
 292+ DA64 77               LD (HL), A
 293+ DA65 DD 23            INC IX
 294+ DA67 23               INC HL
 295+ DA68 10 F6            DJNZ .b22
 296+ DA6A C1               POP BC
 297+ DA6B E1               POP HL
 298+ DA6C 24               INC H                   ; siguiente scan line
 299+ DA6D 0D               DEC C
 300+ DA6E 20 EC            JR NZ, .r22
 301+ DA70
 302+ DA70                  ; --- Filas 8-15 del sprite → fila 1, scans 0-7 ---
 303+ DA70 26 40            LD H, $40
 304+ DA72 2E 2D            LD L, $2D               ; col 13, scan 0
 305+ DA74 0E 08            LD C, 8
 306+ DA76              .r23:
 307+ DA76 E5               PUSH HL
 308+ DA77 C5               PUSH BC
 309+ DA78 06 06            LD B, 6
 310+ DA7A              .b23:
 311+ DA7A DD 7E 00         LD A, (IX)
 312+ DA7D 2F               CPL
 313+ DA7E 77               LD (HL), A
 314+ DA7F DD 23            INC IX
 315+ DA81 23               INC HL
 316+ DA82 10 F6            DJNZ .b23
 317+ DA84 C1               POP BC
 318+ DA85 E1               POP HL
 319+ DA86 24               INC H
 320+ DA87 0D               DEC C
 321+ DA88 20 EC            JR NZ, .r23
 322+ DA8A
 323+ DA8A                  ; --- Atributos del sprite (2 filas × 6 cols) ---
 324+ DA8A                  ; Layout: [dec0][dec1][sfera_L][sfera_R][dec2][dec3]
 325+ DA8A                  ; Decoracion (cols 0,1,4,5): remap paper via ApplyDayCycleRemap
 326+ DA8A                  ; Esfera (cols 2,3): sin remap (gestionada por DrawClockFaceOnly)
 327+ DA8A DD 23            INC IX                  ; saltar attr_h
 328+ DA8C DD 23            INC IX                  ; saltar attr_w
 329+ DA8E AF               XOR A
 330+ DA8F 32 E4 D1         LD (BgSpriteIsHouse), A ; clock no es house
 331+ DA92                  ; --- Fila 0 (row 0, cols 13-18) ---
 332+ DA92 21 0D 58         LD HL, $580D
 333+ DA95 DD 7E 00         LD A, (IX+0)
 333+ DA98 CD 13 D3       CALL ApplyDayCycleRemap
 333+ DA9B 77             LD (HL), A
 333+ DA9C 23             INC HL
 334+ DA9D DD 7E 01         LD A, (IX+1)
 334+ DAA0 CD 13 D3       CALL ApplyDayCycleRemap
 334+ DAA3 77             LD (HL), A
 334+ DAA4 23             INC HL
 335+ DAA5 DD 7E 02         LD A, (IX+2)
 335+ DAA8 77                                       LD (HL), A
 335+ DAA9 23             INC HL  ; esfera
 336+ DAAA DD 7E 03         LD A, (IX+3)
 336+ DAAD 77                                       LD (HL), A
 336+ DAAE 23             INC HL  ; esfera
 337+ DAAF DD 7E 04         LD A, (IX+4)
 337+ DAB2 CD 13 D3       CALL ApplyDayCycleRemap
 337+ DAB5 77             LD (HL), A
 337+ DAB6 23             INC HL
 338+ DAB7 DD 7E 05         LD A, (IX+5)
 338+ DABA CD 13 D3       CALL ApplyDayCycleRemap
 338+ DABD 77             LD (HL), A
 339+ DABE                  ; --- Fila 1 (row 1, cols 13-18) ---
 340+ DABE 21 2D 58         LD HL, $582D
 341+ DAC1 DD 7E 06         LD A, (IX+6)
 341+ DAC4 CD 13 D3       CALL ApplyDayCycleRemap
 341+ DAC7 77             LD (HL), A
 341+ DAC8 23             INC HL
 342+ DAC9 DD 7E 07         LD A, (IX+7)
 342+ DACC CD 13 D3       CALL ApplyDayCycleRemap
 342+ DACF 77             LD (HL), A
 342+ DAD0 23             INC HL
 343+ DAD1 DD 7E 08         LD A, (IX+8)
 343+ DAD4 77                                       LD (HL), A
 343+ DAD5 23             INC HL  ; esfera
 344+ DAD6 DD 7E 09         LD A, (IX+9)
 344+ DAD9 77                                       LD (HL), A
 344+ DADA 23             INC HL  ; esfera
 345+ DADB DD 7E 0A         LD A, (IX+10)
 345+ DADE CD 13 D3       CALL ApplyDayCycleRemap
 345+ DAE1 77             LD (HL), A
 345+ DAE2 23             INC HL
 346+ DAE3 DD 7E 0B         LD A, (IX+11)
 346+ DAE6 CD 13 D3       CALL ApplyDayCycleRemap
 346+ DAE9 77             LD (HL), A
 347+ DAEA C9               RET
 348+ DAEB
 349+ DAEB              ; ==============================================================================
 350+ DAEB              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 351+ DAEB              ; ==============================================================================
 352+ DAEB              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 353+ DAEB              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 354+ DAEB              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 355+ DAEB              ; ==============================================================================
 356+ DAEB              DrawHealthStaminaHUD:
 357+ DAEB                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 358+ DAEB 3A 5D B2         LD A, (PlayerHealth)
 359+ DAEE 4F               LD C, A                             ; C = nivel (0-16)
 360+ DAEF 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 361+ DAF2 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 362+ DAF5 DD 21 F2 D6      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 363+ DAF9 FD 21 63 D7      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 364+ DAFD CD 74 DB         CALL .drawBar
 365+ DB00
 366+ DB00                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 367+ DB00 3A 5E B2         LD A, (PlayerStamina)
 368+ DB03 4F               LD C, A
 369+ DB04 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 370+ DB07 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 371+ DB0A DD 21 F6 D6      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 372+ DB0E FD 21 67 D7      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 373+ DB12 CD 74 DB         CALL .drawBar
 374+ DB15
 375+ DB15                  ; --- Flash de recuperacion del pozo ---
 376+ DB15 3A D3 8F         LD A, (WellFlashTimer)
 377+ DB18 B7               OR A
 378+ DB19 28 28            JR Z, .noFlash
 379+ DB1B 3D               DEC A
 380+ DB1C 32 D3 8F         LD (WellFlashTimer), A
 381+ DB1F                  ; Flash: alternar blanco/normal cada 4 frames
 382+ DB1F E6 04            AND $04
 383+ DB21 28 20            JR Z, .noFlash
 384+ DB23                  ; Flash blanco brillante en ambas barras + player verde
 385+ DB23 3E 47            LD A, WHITE | $40
 386+ DB25 32 0D 58         LD ($580D), A
 387+ DB28 32 0E 58         LD ($580E), A
 388+ DB2B 32 2D 58         LD ($582D), A
 389+ DB2E 32 2E 58         LD ($582E), A
 390+ DB31 32 11 58         LD ($5811), A
 391+ DB34 32 12 58         LD ($5812), A
 392+ DB37 32 31 58         LD ($5831), A
 393+ DB3A 32 32 58         LD ($5832), A
 394+ DB3D 3E 44            LD A, GREEN | $40
 395+ DB3F 32 B5 80         LD (EntityTable + ENT_ATTR), A
 396+ DB42 C9               RET
 397+ DB43              .noFlash:
 398+ DB43                  ; Restaurar color player si estaba en flash verde
 399+ DB43 3A B5 80         LD A, (EntityTable + ENT_ATTR)
 400+ DB46 FE 44            CP GREEN | $40
 401+ DB48 20 05            JR NZ, .noFlashPlayer
 402+ DB4A 3E 47            LD A, WHITE | $40
 403+ DB4C 32 B5 80         LD (EntityTable + ENT_ATTR), A
 404+ DB4F              .noFlashPlayer:
 405+ DB4F                  ; --- Attrs segun nivel (normal) ---
 406+ DB4F                  ; Salud
 407+ DB4F 3A 5D B2         LD A, (PlayerHealth)
 408+ DB52 CD C2 DB         CALL .levelToColor
 409+ DB55 32 0D 58         LD ($580D), A
 410+ DB58 32 0E 58         LD ($580E), A
 411+ DB5B 32 2D 58         LD ($582D), A
 412+ DB5E 32 2E 58         LD ($582E), A
 413+ DB61                  ; Stamina
 414+ DB61 3A 5E B2         LD A, (PlayerStamina)
 415+ DB64 CD C2 DB         CALL .levelToColor
 416+ DB67 32 11 58         LD ($5811), A
 417+ DB6A 32 12 58         LD ($5812), A
 418+ DB6D 32 31 58         LD ($5831), A
 419+ DB70 32 32 58         LD ($5832), A
 420+ DB73 C9               RET
 421+ DB74
 422+ DB74              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 423+ DB74              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 424+ DB74              ; IX = puntero al primer byte de la decoracion en sprite data
 425+ DB74              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 426+ DB74              ; las (16-C) superiores con $00 (vacio/negro)
 427+ DB74              .drawBar:
 428+ DB74 7D               LD A, L
 429+ DB75 32 C0 DB         LD (.dbCol), A                      ; Guardar columna base row 0
 430+ DB78 7B               LD A, E
 431+ DB79 32 C1 DB         LD (.dbCol1), A                     ; Guardar columna base row 1
 432+ DB7C 06 10            LD B, 16                            ; 16 scanlines totales
 433+ DB7E 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 434+ DB80                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 435+ DB80 3E 10            LD A, 16
 436+ DB82 91               SUB C
 437+ DB83 5F               LD E, A                             ; E = primera scanline llena
 438+ DB84              .dbLoop:
 439+ DB84                  ; Calcular direccion VRAM
 440+ DB84 7A               LD A, D
 441+ DB85 FE 08            CP 8
 442+ DB87 30 09            JR NC, .dbCalcR1
 443+ DB89                  ; Char row 0
 444+ DB89 67               LD H, A
 445+ DB8A CB F4            SET 6, H
 446+ DB8C 3A C0 DB         LD A, (.dbCol)
 447+ DB8F 6F               LD L, A
 448+ DB90 18 09            JR .dbWrite
 449+ DB92              .dbCalcR1:
 450+ DB92                  ; Char row 1
 451+ DB92 D6 08            SUB 8
 452+ DB94 67               LD H, A
 453+ DB95 CB F4            SET 6, H
 454+ DB97 3A C1 DB         LD A, (.dbCol1)
 455+ DB9A 6F               LD L, A
 456+ DB9B              .dbWrite:
 457+ DB9B                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 458+ DB9B 7A               LD A, D
 459+ DB9C BB               CP E
 460+ DB9D 30 0B            JR NC, .dbFull
 461+ DB9F                  ; Marchito: copiar sprite decayed
 462+ DB9F FD 7E 00         LD A, (IY+0)
 463+ DBA2 77               LD (HL), A
 464+ DBA3 23               INC HL
 465+ DBA4 FD 7E 01         LD A, (IY+1)
 466+ DBA7 77               LD (HL), A
 467+ DBA8 18 09            JR .dbAdvanceSpr
 468+ DBAA              .dbFull:
 469+ DBAA                  ; Sano: copiar sprite data (ya almacenado CPL'd)
