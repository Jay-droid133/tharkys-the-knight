 469+ 68E2              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 470+ 68E2              ; OUT: -
 471+ 68E2              ; Destruye: AF, BC, DE, HL, IX.
 472+ 68E2              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 473+ 68E2              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 474+ 68E2              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 475+ 68E2              ; ==============================================================================
 476+ 68E2              DrawBgSpriteByIdAtChar:
 477+ 68E2 B7               OR A
 478+ 68E3 C8               RET Z                                   ; id 0 = no sprite, salir
 479+ 68E4 C5               PUSH BC
