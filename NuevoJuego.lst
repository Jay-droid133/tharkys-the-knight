 559+ E678 FE 0A            CP 10
 560+ E67A 38 20            JR C, .singleDigit
 561+ E67C                  ; Dos digitos: dividir A / 10
 562+ E67C 06 00            LD B, 0
 563+ E67E              .divLoop:
 564+ E67E D6 0A            SUB 10
 565+ E680 04               INC B
 566+ E681 FE 0A            CP 10
 567+ E683 30 F9            JR NC, .divLoop
 568+ E685                  ; B = decenas, A = unidades
 569+ E685 F5               PUSH AF                             ; Guardar unidades
 570+ E686 78               LD A, B
 571+ E687 CD BC E6         CALL .getDigitFont
 572+ E68A 11 08 40         LD DE, $4008                        ; Col 8
 573+ E68D CD C9 E6         CALL .drawChar
 574+ E690 F1               POP AF                              ; Recuperar unidades
 575+ E691 CD BC E6         CALL .getDigitFont
