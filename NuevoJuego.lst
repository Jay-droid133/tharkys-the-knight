 618+ 8B8C              ; ==============================================================================
 619+ 8B8C              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
 620+ 8B8C              ; ==============================================================================
 621+ 8B8C              ; Entrada: A = SpriteID
 622+ 8B8C              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
 623+ 8B8C              ; Destruye: A, DE, HL
 624+ 8B8C              ; ==============================================================================
 625+ 8B8C              GetSpriteDims:
 626+ 8B8C 6F               LD L, A
 627+ 8B8D 26 00            LD H, 0
 628+ 8B8F 29               ADD HL, HL                  ; × 2 (DEFW entries)
 629+ 8B90 11 98 AD         LD DE, SpriteFrameTable
 630+ 8B93 19               ADD HL, DE
 631+ 8B94 5E               LD E, (HL)
 632+ 8B95 23               INC HL
 633+ 8B96 56               LD D, (HL)                  ; DE = puntero a datos del sprite
 634+ 8B97 1A               LD A, (DE)                  ; width_bytes
 635+ 8B98 87               ADD A, A
 636+ 8B99 87               ADD A, A
 637+ 8B9A 87               ADD A, A                    ; × 8 = width_px
 638+ 8B9B 47               LD B, A
 639+ 8B9C 13               INC DE
 640+ 8B9D 1A               LD A, (DE)                  ; height_px
 641+ 8B9E 4F               LD C, A
 642+ 8B9F C9               RET
