 367+ E53E              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E53E              ; ==============================================================================
 369+ E53E              ; Entrada: A = sprite ID
 370+ E53E              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E53E              ; Preserva: A, DE, IX
 372+ E53E              ;
 373+ E53E              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E53E              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E53E              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E53E              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E53E              ; ==============================================================================
 378+ E53E              CheckIfHouseSprite:
 379+ E53E F5               PUSH AF
 380+ E53F E5               PUSH HL
 381+ E540 C5               PUSH BC
 382+ E541
 383+ E541 47               LD B, A                     ; B = id buscado
 384+ E542
 385+ E542 AF               XOR A
 386+ E543 32 9F E3         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E546
 388+ E546 21 57 E0         LD HL, HouseIdList
 389+ E549              .checkLoop:
 390+ E549 7E               LD A, (HL)
 391+ E54A FE FF            CP $FF
 392+ E54C 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E54E B8               CP B
 394+ E54F 28 03            JR Z, .checkFound
 395+ E551 23               INC HL
 396+ E552 18 F5            JR .checkLoop
 397+ E554
 398+ E554              .checkFound:
 399+ E554 3E 01            LD A, 1
 400+ E556 32 9F E3         LD (BgSpriteIsHouse), A
 401+ E559
 402+ E559              .checkDone:
 403+ E559 C1               POP BC
 404+ E55A E1               POP HL
 405+ E55B F1               POP AF
 406+ E55C C9               RET
