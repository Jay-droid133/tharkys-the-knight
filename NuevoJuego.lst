   1+ 8080              ; ==============================================================================
   2+ 8080              ; VARIABLES EN RAM MANTENIDAS POR EL JUEGO
   3+ 8080              ; ==============================================================================
   4+ 8080
   5+ 8080 00           GameFrameCounter:   DEFB 0      ; Contador que incrementa cada frame (0-255)
   6+ 8081 00           GameState:          DEFB 0      ; Estado: 0=Menu, 1=InGame, 2=GameOver
   7+ 8082
   8+ 8082              ; ==============================================================================
   9+ 8082              ; TABLA DE ENTIDADES (estilo Sabre Wulf)
  10+ 8082              ; ==============================================================================
  11+ 8082              ; 17 slots × 12 bytes = 204 bytes.
  12+ 8082              ; Slot 0: Player. Slots 1-6: Inmortales. Slots 7-12: Nasties. 13-16: Objetos.
  13+ 8082              ; Cada entidad: SpriteID, Type, State, PosX, PosY, Attr, DeltaX, DeltaY,
  14+ 8082              ;               AnimBase, AnimTimer, Dir, Flags
  15+ 8082              ; ==============================================================================
  16+ 8082 00 00 00...  EntityTable:        DEFS NUM_ENTITIES * ENT_SIZE
  17+ 8192
  18+ 8192              ; --- Input crudo ---
  19+ 8192 00           InputDirection:     DEFB 0      ; Direccion leida del teclado este frame
  20+ 8193 00           InputFire:          DEFB 0      ; Fuego leido del teclado este frame
  21+ 8194
