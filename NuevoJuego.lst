 147+ FBA2              ; ==============================================================================
 148+ FBA2              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 149+ FBA2              ; ==============================================================================
 150+ FBA2              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 151+ FBA2              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 152+ FBA2              ; pareja de bytes — vertical doubling).
 153+ FBA2              ;
 154+ FBA2              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 155+ FBA2              ; Destruye: AF, BC, DE, HL.
 156+ FBA2              ; ==============================================================================
 157+ FBA2              DrawTombPixels2x:
 158+ FBA2 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 159+ FBA4 32 23 FC         LD (.dpxRowsLeft), A
 160+ FBA7 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
 161+ FBA9 32 24 FC         LD (.dpxDstY), A
 162+ FBAC 21 72 FC         LD HL, TombDecodedPixels
 163+ FBAF 22 25 FC         LD (.dpxSrcPtr), HL
 164+ FBB2
 165+ FBB2              .dpxNextRow:
 166+ FBB2                  ; Calc dst top addr at (TOMB_2X_DST_PIXEL_X, dstY)
 167+ FBB2 3A 24 FC         LD A, (.dpxDstY)
 168+ FBB5 57               LD D, A
 169+ FBB6 1E 50            LD E, TOMB_2X_DST_PIXEL_X
 170+ FBB8 CD A6 A0         CALL CalcPixelAddr
 171+ FBBB 22 27 FC         LD (.dpxDstTop), HL
 172+ FBBE
 173+ FBBE                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 174+ FBBE CD 12 9E         CALL NextPixelLine
 175+ FBC1 22 29 FC         LD (.dpxDstBot), HL
 176+ FBC4
 177+ FBC4                  ; Procesar 6 src bytes para esta src row
 178+ FBC4 2A 25 FC         LD HL, (.dpxSrcPtr)
 179+ FBC7 06 06            LD B, TOMB_SRC_W_BYTES
 180+ FBC9              .dpxByteLoop:
 181+ FBC9 7E               LD A, (HL)
 182+ FBCA 23               INC HL
 183+ FBCB 4F               LD C, A                         ; C = src byte original
 184+ FBCC E5               PUSH HL                         ; save src ptr
 185+ FBCD C5               PUSH BC                         ; save count + src byte
 186+ FBCE
 187+ FBCE                  ; --- High nibble doubled ---
 188+ FBCE E6 F0            AND $F0
 189+ FBD0 0F               RRCA
 189+ FBD1 0F             RRCA
 189+ FBD2 0F             RRCA
 189+ FBD3 0F             RRCA       ; high nibble en posición baja
 190+ FBD4 5F               LD E, A
 191+ FBD5 16 00            LD D, 0
 192+ FBD7 21 62 FC         LD HL, NibbleDoubleLUT
 193+ FBDA 19               ADD HL, DE
 194+ FBDB 7E               LD A, (HL)                      ; A = high doubled
 195+ FBDC 2A 27 FC         LD HL, (.dpxDstTop)
 196+ FBDF 77               LD (HL), A
 197+ FBE0 23               INC HL
 198+ FBE1 22 27 FC         LD (.dpxDstTop), HL
 199+ FBE4 2A 29 FC         LD HL, (.dpxDstBot)
 200+ FBE7 77               LD (HL), A
 201+ FBE8 23               INC HL
 202+ FBE9 22 29 FC         LD (.dpxDstBot), HL
 203+ FBEC
 204+ FBEC                  ; --- Low nibble doubled ---
 205+ FBEC C1               POP BC                          ; recover src byte (en C)
 206+ FBED C5               PUSH BC
 207+ FBEE 79               LD A, C
 208+ FBEF E6 0F            AND $0F
 209+ FBF1 5F               LD E, A
 210+ FBF2 16 00            LD D, 0
 211+ FBF4 21 62 FC         LD HL, NibbleDoubleLUT
 212+ FBF7 19               ADD HL, DE
 213+ FBF8 7E               LD A, (HL)                      ; A = low doubled
 214+ FBF9 2A 27 FC         LD HL, (.dpxDstTop)
 215+ FBFC 77               LD (HL), A
 216+ FBFD 23               INC HL
 217+ FBFE 22 27 FC         LD (.dpxDstTop), HL
 218+ FC01 2A 29 FC         LD HL, (.dpxDstBot)
 219+ FC04 77               LD (HL), A
 220+ FC05 23               INC HL
 221+ FC06 22 29 FC         LD (.dpxDstBot), HL
