 657+ 65C7              ; ==============================================================================
 658+ 65C7              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 659+ 65C7              ; ==============================================================================
 660+ 65C7              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 661+ 65C7              ;    al haberse dibujado ya en el render normal de la sala).
 662+ 65C7              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 663+ 65C7              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 664+ 65C7              ; Bank 3 para ambos (sprites baseline town).
 665+ 65C7              ; Destruye: AF, BC, DE, HL, IX.
 666+ 65C7              ; ==============================================================================
 667+ 65C7              TownGateOpenDoor:
 668+ 65C7 11 B0 E2         LD DE, BgGfx_town_gate_door_closed_v2
 669+ 65CA CD 11 D8         CALL RedrawPickupByPtr               ; XOR-erase del closed
 670+ 65CD                  ; Fall-through a TownGateRedrawOpenDoor
 671+ 65CD
 672+ 65CD              ; ==============================================================================
 673+ 65CD              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 674+ 65CD              ; ==============================================================================
 675+ 65CD              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 676+ 65CD              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 677+ 65CD              ; el open door restaura attrs originales en sus 4 cols + pixels.
 678+ 65CD              ; ==============================================================================
 679+ 65CD              TownGateRedrawOpenDoor:
 680+ 65CD 21 6F E6         LD HL, BgGfx_town_gate_door_open
 681+ 65D0 3E 03            LD A, 3
 682+ 65D2 CD C2 6C         CALL LoadBgSpriteToBuffer
 683+ 65D5 DD 21 F8 86      LD IX, BgSpriteBuffer
 684+ 65D9 06 0E            LD B, TGCS_DOOR_CHARX
 685+ 65DB 0E 11            LD C, TGCS_DOOR_CHARY
 686+ 65DD AF               XOR A
 687+ 65DE 32 D8 E2         LD (BgSpriteIsHouse), A
 688+ 65E1 32 77 D2         LD (CurrentTintVar), A
 689+ 65E4 C3 6D D1         JP DrawBgGfxSprite
