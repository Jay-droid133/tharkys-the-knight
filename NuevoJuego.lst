 196  C922                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ C922              ; ==============================================================================
   2+ C922              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ C922              ; ==============================================================================
   4+ C922              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ C922              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ C922              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ C922              ; ==============================================================================
   8+ C922
   9+ C922              ; ==============================================================================
  10+ C922              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ C922              ; ==============================================================================
  12+ C922              InitScreenSystem:
  13+ C922 3E 07            LD A, START_SCREEN_X
  14+ C924 32 55 82         LD (CurrentScreenX), A
  15+ C927 3E 0E            LD A, START_SCREEN_Y
  16+ C929 32 56 82         LD (CurrentScreenY), A
  17+ C92C 3E 01            LD A, 1
  18+ C92E 32 5D 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ C931 AF               XOR A
  20+ C932 32 59 82         LD (ScreenTransition), A
  21+ C935 CD 39 C9         CALL CalcScreenAddress
  22+ C938 C9               RET
  23+ C939
  24+ C939              ; ==============================================================================
  25+ C939              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ C939              ; ==============================================================================
  27+ C939              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ C939              ; ==============================================================================
  29+ C939              CalcScreenAddress:
  30+ C939 3A 56 82         LD A, (CurrentScreenY)
  31+ C93C 6F               LD L, A
  32+ C93D 26 00            LD H, 0
  33+ C93F 29               ADD HL, HL                  ; x2
  34+ C940 29               ADD HL, HL                  ; x4
  35+ C941 29               ADD HL, HL                  ; x8
  36+ C942 29               ADD HL, HL                  ; x16
  37+ C943 3A 55 82         LD A, (CurrentScreenX)
  38+ C946 5F               LD E, A
  39+ C947 16 00            LD D, 0
  40+ C949 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ C94A 11 6F D8         LD DE, MapTable
  42+ C94D 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ C94E 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ C94F                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ C94F 6F               LD L, A
  46+ C950 26 00            LD H, 0
  47+ C952 29               ADD HL, HL                  ; index * 2
  48+ C953 11 3D D7         LD DE, RoomTable
  49+ C956 19               ADD HL, DE
  50+ C957 5E               LD E, (HL)
  51+ C958 23               INC HL
  52+ C959 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ C95A                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ C95A EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ C95B CD C0 90         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ C95E                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ C95E 11 42 85         LD DE, CurrentScreenBuffer
  58+ C961 ED 53 57 82      LD (CurrentScreenAddr), DE
  59+ C965 C9               RET
  60+ C966
  61+ C966              ; ==============================================================================
  62+ C966              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ C966              ; ==============================================================================
  64+ C966              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ C966              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ C966              ; por estar atrapado cerca del borde.
  67+ C966              ; ==============================================================================
  68+ C966              CheckScreenTransition:
  69+ C966 AF               XOR A
  70+ C967 32 59 82         LD (ScreenTransition), A
  71+ C96A
  72+ C96A                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ C96A                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ C96A                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ C96A                  ; dispararia transicion sur en plena animacion.
  76+ C96A 3A 3C 82         LD A, (TownGatePhase)
  77+ C96D B7               OR A
  78+ C96E C0               RET NZ
  79+ C96F
  80+ C96F                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ C96F                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ C96F                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ C96F                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ C96F                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ C96F                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ C96F 3A 2C 82         LD A, (TimeFrozen)
  87+ C972 B7               OR A
  88+ C973 28 23            JR Z, .cstNotFrozen
  89+ C975 3A 24 82         LD A, (InputDirection)
  90+ C978 CB 4F            BIT 1, A                    ; S
  91+ C97A 28 17            JR Z, .cstClearBlockFlag
  92+ C97C 3A 18 81         LD A, (EntityTable + ENT_POSY)
  93+ C97F FE A8            CP SCREEN_MAX_Y
  94+ C981 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ C983                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ C983 3A 2D 82         LD A, (BlockedExitSoundFlag)
  97+ C986 B7               OR A
  98+ C987 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ C988 3E 01            LD A, 1
 100+ C98A 32 2D 82         LD (BlockedExitSoundFlag), A
 101+ C98D 21 17 FA         LD HL, SFX_BlockedExit
 102+ C990 C3 18 F9         JP PlaySFX                  ; tail call
 103+ C993              .cstClearBlockFlag:
 104+ C993 AF               XOR A
 105+ C994 32 2D 82         LD (BlockedExitSoundFlag), A
 106+ C997 C9               RET
 107+ C998              .cstNotFrozen:
 108+ C998                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ C998 AF               XOR A
 110+ C999 32 2D 82         LD (BlockedExitSoundFlag), A
 111+ C99C
 112+ C99C 3A 24 82         LD A, (InputDirection)
 113+ C99F 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
