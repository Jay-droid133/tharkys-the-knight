 347+ 6A6C              ; ==============================================================================
 348+ 6A6C              ; CheckStatueHidden - es esta entry de BG una estatua oculta?
 349+ 6A6C              ; ==============================================================================
 350+ 6A6C              ; IN:  A = sprite id
 351+ 6A6C              ; OUT: NZ si es estatua y su slot esta atrapado (skip drawing).
 352+ 6A6C              ;      Z si no es estatua o esta visible (draw normalmente).
 353+ 6A6C              ; Destruye: AF, BC, HL.
 354+ 6A6C              ; ==============================================================================
 355+ 6A6C              CheckStatueHidden:
 356+ 6A6C 21 A9 69         LD HL, StatueIdTable
 357+ 6A6F 06 03            LD B, 3
 358+ 6A71 0E 00            LD C, 0                                 ; slot index 0..2
 359+ 6A73              .cshLoop:
 360+ 6A73 BE               CP (HL)
 361+ 6A74 28 06            JR Z, .cshMatch
 362+ 6A76 23               INC HL
 363+ 6A77 0C               INC C
 364+ 6A78 10 F9            DJNZ .cshLoop
 365+ 6A7A AF               XOR A                                   ; not statue -> Z (visible)
 366+ 6A7B C9               RET
 367+ 6A7C              .cshMatch:
 368+ 6A7C                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 369+ 6A7C 79               LD A, C
 370+ 6A7D 32 B2 69         LD (LastHiddenStatueType), A            ; expose type para el caller
 371+ 6A80 21 A6 69         LD HL, ChurchTrapBitMask
 372+ 6A83 5F               LD E, A
 373+ 6A84 16 00            LD D, 0
 374+ 6A86 19               ADD HL, DE
 375+ 6A87 7E               LD A, (HL)                              ; bit mask
 376+ 6A88 21 BE 82         LD HL, MonsterTrappedFlags
