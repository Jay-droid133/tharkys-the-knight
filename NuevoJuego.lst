 257+ 6B01                  ; Sprite RLE: tamaño desconocido sin parsear, copia BG_SPRITE_BUFFER_SIZE-2
 258+ 6B01 01 FE 03         LD BC, BG_SPRITE_BUFFER_SIZE - 2
 259+ 6B04 ED B0            LDIR
