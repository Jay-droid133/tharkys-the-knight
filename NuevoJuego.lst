 426+ 92B6 21 E5 90         LD HL, MonsterAiFlags
 427+ 92B9 19               ADD HL, DE
 428+ 92BA 36 00            LD (HL), 0
 429+ 92BC 21 D9 90         LD HL, MonsterRoomId
 430+ 92BF 19               ADD HL, DE
 431+ 92C0 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 92C2 21 DF 90         LD HL, MonsterEntryBorder
 433+ 92C5 19               ADD HL, DE
 434+ 92C6 36 00            LD (HL), 0
 435+ 92C8 21 E2 90         LD HL, MonsterExitCoord
 436+ 92CB 19               ADD HL, DE
 437+ 92CC 36 00            LD (HL), 0
 438+ 92CE 21 3F B6         LD HL, MonsterReturnTimer
 439+ 92D1 19               ADD HL, DE
 440+ 92D2 36 00            LD (HL), 0
 441+ 92D4 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 92D7 19               ADD HL, DE
 443+ 92D8 36 00            LD (HL), 0
 444+ 92DA 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 92DD 19               ADD HL, DE
 446+ 92DE 36 00            LD (HL), 0
 447+ 92E0 C9               RET
