 754+ B276              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 755+ B276              ; ==============================================================================
 756+ B276              ; Entrada: A = attr byte
 757+ B276              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 758+ B276              ; Preserva: HL, DE, BC, IX
 759+ B276              ; ==============================================================================
