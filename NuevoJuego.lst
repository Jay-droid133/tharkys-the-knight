 212+ 6EAE              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 213+ 6EAE              ; ==============================================================================
 214+ 6EAE              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 215+ 6EAE              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 216+ 6EAE              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 217+ 6EAE              ; ==============================================================================
 218+ 6EAE              ApplyMushroomBuff:
 219+ 6EAE 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 220+ 6EB1 22 80 82         LD (MushroomLockTimer), HL
 221+ 6EB4 3E 43            LD A, MUSHROOM_LOCK_ATTR
 222+ 6EB6 32 50 81         LD (EntityTable + ENT_ATTR), A
 223+ 6EB9 C9               RET
 224+ 6EBA
 225+ 6EBA              ; ==============================================================================
 226+ 6EBA              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 227+ 6EBA              ; ==============================================================================
 228+ 6EBA              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 229+ 6EBA              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 230+ 6EBA              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 231+ 6EBA              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 232+ 6EBA              ; si no, restaura WHITE | $40.
 233+ 6EBA              ; ==============================================================================
 234+ 6EBA              UpdateMushroomBuff:
 235+ 6EBA 2A 80 82         LD HL, (MushroomLockTimer)
 236+ 6EBD 7C               LD A, H
 237+ 6EBE B5               OR L
 238+ 6EBF C8               RET Z                               ; sin debuff
 239+ 6EC0 2B               DEC HL
 240+ 6EC1 22 80 82         LD (MushroomLockTimer), HL
 241+ 6EC4 7C               LD A, H
 242+ 6EC5 B5               OR L
 243+ 6EC6 20 0B            JR NZ, .umbActive
 244+ 6EC8                  ; --- Justo expirado: restaurar segun estado de speed buff ---
 245+ 6EC8 3A 7F 82         LD A, (SpeedBuffType)
 246+ 6ECB B7               OR A
 247+ 6ECC C0               RET NZ                              ; speed buff activo: ya pinto color, no tocar
 248+ 6ECD 3E 47            LD A, WHITE | $40
 249+ 6ECF 32 50 81         LD (EntityTable + ENT_ATTR), A
 250+ 6ED2 C9               RET
 251+ 6ED3              .umbActive:
 252+ 6ED3 3E 43            LD A, MUSHROOM_LOCK_ATTR
 253+ 6ED5 32 50 81         LD (EntityTable + ENT_ATTR), A
 254+ 6ED8 C9               RET
