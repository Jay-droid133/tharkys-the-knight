 201+ D9D2 21 D0 D8         LD HL, HourHandPtrs
 202+ D9D5 CD DA DB         CALL DrawHandLine
 203+ D9D8
 204+ D9D8                  ; --- Aguja de minutos ---
 205+ D9D8 3A D3 D7         LD A, (GameMinutes)
 206+ D9DB 06 00            LD B, 0
 207+ D9DD              .divMin:
 208+ D9DD FE 05            CP 5
 209+ D9DF 38 05            JR C, .minOk
 210+ D9E1 D6 05            SUB 5
 211+ D9E3 04               INC B
 212+ D9E4 18 F7            JR .divMin
 213+ D9E6              .minOk:
 214+ D9E6 78               LD A, B
 215+ D9E7 21 EC D7         LD HL, MinHandPtrs
 216+ D9EA CD DA DB         CALL DrawHandLine
