 452+ 65DF 21 B1 64         LD HL, StatueIdTable
 453+ 65E2 5F               LD E, A
 454+ 65E3 16 00            LD D, 0
 455+ 65E5 19               ADD HL, DE
 456+ 65E6 7E               LD A, (HL)                              ; A = statue id
 457+ 65E7 B7               OR A
 458+ 65E8 C8               RET Z                                   ; sin estatua exportada
 459+ 65E9 32 16 66         LD (.drftStatueId), A
 460+ 65EC                  ; Scan CurrentScreenBuffer para encontrar la estatua (formato 4B)
 461+ 65EC 2A 03 83         LD HL, (CurrentScreenAddr)
 462+ 65EF              .drftLoop:
 463+ 65EF 7E               LD A, (HL)
 464+ 65F0 FE FF            CP $FF
 465+ 65F2 C8               RET Z                                   ; estatua no esta en esta sala
 466+ 65F3 47               LD B, A                                 ; B = current id
 467+ 65F4 3A 16 66         LD A, (.drftStatueId)
 468+ 65F7 B8               CP B
 469+ 65F8 28 06            JR Z, .drftFound
 470+ 65FA 11 04 00         LD DE, 4
 471+ 65FD 19               ADD HL, DE
