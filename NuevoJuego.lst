 218+ D9ED                  ; --- Punto central (borra el pixel = marca negra) ---
 219+ D9ED 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 220+ D9F0 CB 86            RES 0, (HL)
 221+ D9F2
 222+ D9F2 C9               RET
