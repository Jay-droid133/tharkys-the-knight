5980+ C00C              ; ==============================================================================
5981+ C00C              ; RepositionMonstersAtEntry - Al cambiar de room
5982+ C00C              ; ==============================================================================
5983+ C00C              RepositionMonstersAtEntry:
5984+ C00C 3A 51 B3         LD A, (MonstersActive)
5985+ C00F B7               OR A
5986+ C010 C8               RET Z
5987+ C011                  ; Pre-construir CollisionMap del room NEW aqui (DrawScreen lo reconstruira
5988+ C011                  ; de nuevo poco despues, pero necesitamos datos frescos para el collision
5989+ C011                  ; check de la Fase 8 .reInNewStepBack — sin esto usariamos el map del room
5990+ C011                  ; anterior y el migrado acabaria sobre BG sprites).
5991+ C011 CD 52 D4         CALL BuildCollisionMap
5992+ C014                  ; Memoria de ubicacion: solo reposicionar monsters cuyo RoomId == OLD
5993+ C014                  ; (siguen al player desde el room anterior) o RoomId == NEW (ya vivian
5994+ C014                  ; en este room, migrados por knockback previo). Los que vivan en otro
5995+ C014                  ; room quedan intactos (TYPE_NONE en su posicion clampada) y no se
5996+ C014                  ; activaran hasta que el player visite su room.
5997+ C014 CD A6 8E         CALL MaiGetCurrentScreenId
5998+ C017 32 61 C2         LD (.reNewId), A
5999+ C01A CD E9 8E         CALL MaiGetOldScreenId
6000+ C01D 32 62 C2         LD (.reOldId), A
6001+ C020                  ; Cache entry side del player (solo valido para monsters que vienen de OLD)
6002+ C020 CD FF 91         CALL MaiGetEntrySide            ; A = MAI_SIDE_N/S/W/E o $FF
6003+ C023 32 63 C2         LD (.reFollowSide), A
6004+ C026 DD 21 A4 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
6005+ C02A 06 03            LD B, MONSTERS_TO_SPAWN
6006+ C02C 0E 00            LD C, 0                         ; C = slot index
6007+ C02E              .reLoop:
6008+ C02E C5               PUSH BC
6009+ C02F                  ; --- Pass 1 (solo TYPE_MONSTER): snapshot pre-transition para poder
6010+ C02F                  ; restaurar si player vuelve antes de que este monster active en NEW. ---
6011+ C02F DD 7E 01         LD A, (IX+ENT_TYPE)
6012+ C032 FE 02            CP TYPE_MONSTER
6013+ C034 20 1D            JR NZ, .reCheckRestore
6014+ C036                  ; Guardar LastSeenRoom = OLD, LastSeenX/Y = POSX/POSY actuales
6015+ C036 59               LD E, C
6016+ C037 16 00            LD D, 0
6017+ C039 21 8E 5F         LD HL, MonsterLastSeenRoom
6018+ C03C 19               ADD HL, DE
6019+ C03D 3A 62 C2         LD A, (.reOldId)
6020+ C040 77               LD (HL), A
6021+ C041 21 91 5F         LD HL, MonsterLastSeenX
6022+ C044 19               ADD HL, DE
6023+ C045 DD 7E 03         LD A, (IX+ENT_POSX)
6024+ C048 77               LD (HL), A
6025+ C049 21 94 5F         LD HL, MonsterLastSeenY
6026+ C04C 19               ADD HL, DE
6027+ C04D DD 7E 04         LD A, (IX+ENT_POSY)
6028+ C050 77               LD (HL), A
6029+ C051 18 1E            JR .reCheckReposition
6030+ C053              .reCheckRestore:
6031+ C053                  ; TYPE_NONE: check si debemos restaurar (player vuelve rapido antes de
6032+ C053                  ; que este slot active en el NEW previo). Condicion:
6033+ C053                  ;   RoomId[slot] == OLD_actual && LastSeenRoom[slot] == NEW_actual
6034+ C053                  ; Significa: este monster estaba tracked como siguiendo al player (RoomId
6035+ C053                  ; = OLD = donde el player vino), y su ultima vista visible fue en el
6036+ C053                  ; room al que el player vuelve.
6037+ C053 59               LD E, C
6038+ C054 16 00            LD D, 0
6039+ C056 21 80 8D         LD HL, MonsterRoomId
6040+ C059 19               ADD HL, DE
6041+ C05A 7E               LD A, (HL)
6042+ C05B 47               LD B, A
6043+ C05C 3A 62 C2         LD A, (.reOldId)
6044+ C05F B8               CP B
6045+ C060 20 0F            JR NZ, .reCheckReposition       ; RoomId != OLD → no follow-in-transit
6046+ C062 21 8E 5F         LD HL, MonsterLastSeenRoom
6047+ C065 19               ADD HL, DE
6048+ C066 7E               LD A, (HL)
6049+ C067 47               LD B, A
6050+ C068 3A 61 C2         LD A, (.reNewId)
6051+ C06B B8               CP B
6052+ C06C 20 03            JR NZ, .reCheckReposition       ; LastSeen != NEW
6053+ C06E C3 5F C1         JP .reRestore                   ; ambas condiciones OK → restore
6054+ C071              .reCheckReposition:
6055+ C071                  ; Fetch MonsterRoomId[slot] para comparaciones OLD/NEW (logica original)
6056+ C071 59               LD E, C
6057+ C072 16 00            LD D, 0
6058+ C074 21 80 8D         LD HL, MonsterRoomId
6059+ C077 19               ADD HL, DE
6060+ C078 7E               LD A, (HL)
6061+ C079 5F               LD E, A                         ; E = room_id
6062+ C07A 3A 62 C2         LD A, (.reOldId)
6063+ C07D BB               CP E
6064+ C07E 28 09            JR Z, .reFromOld
6065+ C080 3A 61 C2         LD A, (.reNewId)
6066+ C083 BB               CP E
6067+ C084 28 09            JR Z, .reInNew
6068+ C086 C3 46 C2         JP .reSkip                      ; Otro room: no tocar
6069+ C089              .reFromOld:
