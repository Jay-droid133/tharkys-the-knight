4126+ B93B                  ; Calcular posicion en buffer: count × 5
4127+ B93B 6F               LD L, A
4128+ B93C 26 00            LD H, 0
4129+ B93E 29               ADD HL, HL
4130+ B93F 29               ADD HL, HL
4131+ B940 29               ADD HL, HL                          ; count × 8 (simplificado)
4132+ B941                  ; Corregir: count × 5 = count × 4 + count
4133+ B941 6F               LD L, A
4134+ B942 26 00            LD H, 0
4135+ B944 54               LD D, H
4136+ B945 5D               LD E, L
4137+ B946 29               ADD HL, HL
