 451+ EEBD              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 452+ EEBD              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 453+ EEBD              ; IX = puntero al primer byte de la decoracion en sprite data
 454+ EEBD              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 455+ EEBD              ; las (16-C) superiores con $00 (vacio/negro)
 456+ EEBD              .drawBar:
 457+ EEBD 7D               LD A, L
 458+ EEBE 32 09 EF         LD (.dbCol), A                      ; Guardar columna base row 0
 459+ EEC1 7B               LD A, E
 460+ EEC2 32 0A EF         LD (.dbCol1), A                     ; Guardar columna base row 1
 461+ EEC5 06 10            LD B, 16                            ; 16 scanlines totales
 462+ EEC7 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 463+ EEC9                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 464+ EEC9 3E 10            LD A, 16
 465+ EECB 91               SUB C
 466+ EECC 5F               LD E, A                             ; E = primera scanline llena
 467+ EECD              .dbLoop:
 468+ EECD                  ; Calcular direccion VRAM
 469+ EECD 7A               LD A, D
 470+ EECE FE 08            CP 8
 471+ EED0 30 09            JR NC, .dbCalcR1
 472+ EED2                  ; Char row 0
 473+ EED2 67               LD H, A
 474+ EED3 CB F4            SET 6, H
 475+ EED5 3A 09 EF         LD A, (.dbCol)
 476+ EED8 6F               LD L, A
 477+ EED9 18 09            JR .dbWrite
 478+ EEDB              .dbCalcR1:
 479+ EEDB                  ; Char row 1
 480+ EEDB D6 08            SUB 8
 481+ EEDD 67               LD H, A
 482+ EEDE CB F4            SET 6, H
 483+ EEE0 3A 0A EF         LD A, (.dbCol1)
 484+ EEE3 6F               LD L, A
 485+ EEE4              .dbWrite:
 486+ EEE4                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 487+ EEE4 7A               LD A, D
 488+ EEE5 BB               CP E
 489+ EEE6 30 0B            JR NC, .dbFull
 490+ EEE8                  ; Marchito: copiar sprite decayed
 491+ EEE8 FD 7E 00         LD A, (IY+0)
 492+ EEEB 77               LD (HL), A
 493+ EEEC 23               INC HL
 494+ EEED FD 7E 01         LD A, (IY+1)
 495+ EEF0 77               LD (HL), A
 496+ EEF1 18 09            JR .dbAdvanceSpr
 497+ EEF3              .dbFull:
 498+ EEF3                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 499+ EEF3 DD 7E 00         LD A, (IX+0)
 500+ EEF6 77               LD (HL), A
 501+ EEF7 23               INC HL
 502+ EEF8 DD 7E 01         LD A, (IX+1)
 503+ EEFB 77               LD (HL), A
 504+ EEFC              .dbAdvanceSpr:
 505+ EEFC                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 506+ EEFC D5               PUSH DE
 507+ EEFD 11 06 00         LD DE, 6
 508+ EF00 DD 19            ADD IX, DE
 509+ EF02 FD 19            ADD IY, DE
 510+ EF04 D1               POP DE
 511+ EF05 14               INC D
 512+ EF06 10 C5            DJNZ .dbLoop
 513+ EF08 C9               RET
 514+ EF09
 515+ EF09 00           .dbCol:  DEFB 0
 516+ EF0A 00           .dbCol1: DEFB 0
 517+ EF0B
 518+ EF0B              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 519+ EF0B              .levelToColor:
 520+ EF0B FE 0C            CP 12
 521+ EF0D 30 11            JR NC, .lcGreen
 522+ EF0F FE 07            CP 7
 523+ EF11 30 0A            JR NC, .lcCyan
 524+ EF13 FE 03            CP 3
 525+ EF15 30 03            JR NC, .lcYellow
 526+ EF17 3E 42            LD A, RED | $40                     ; 0-2: rojo
 527+ EF19 C9               RET
 528+ EF1A              .lcYellow:
 529+ EF1A 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 530+ EF1C C9               RET
 531+ EF1D              .lcCyan:
 532+ EF1D 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 533+ EF1F C9               RET
 534+ EF20              .lcGreen:
 535+ EF20 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 536+ EF22 C9               RET
