 287+ E5E0              ; ==============================================================================
 288+ E5E0              ; MUSIC DRIVER - Dispatcher entre tracks (canal B AY)
 289+ E5E0              ; ==============================================================================
 290+ E5E0              ; State + tablas + tick (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote)
 291+ E5E0              ; viven AHORA en code/music_irq.asm (slot 1, $6000-$7FFF, siempre visible).
 292+ E5E0              ; El IRQ handler debe poder leer ese codigo/datos sin paginar slot 3 — paginar
 293+ E5E0              ; dentro del IRQ rompe los PUSH/POP del propio handler (ver
 294+ E5E0              ; project_ay_thunk_stack_bug.md).
 295+ E5E0              ;
 296+ E5E0              ; Aqui solo queda StartMusicImpl (dispatcher one-shot al cambiar de track):
 297+ E5E0              ; corre en bank 4 (paged en slot 3 por su thunk) y referencia simbolos de
 298+ E5E0              ; slot 1 (TensionMusicTable, MusicLoop, etc.) que estan siempre visibles.
 299+ E5E0              ; Tail-jumpea a MusicAdvanceNote (slot 1) tras setear mixer/vol.
 300+ E5E0              ;
 301+ E5E0              ; Tracks (mismo formato; ver music_irq.asm para tablas):
 302+ E5E0              ;   0=Tension, 1=Sunrise, 2=EndGame (LOOP), 3=GameOver, 4=Death (LOOP)
 303+ E5E0              ;   $FF=STOP, $FE=restart, $FD=stop-if-loopable
 304+ E5E0              ; ==============================================================================
 305+ E5E0
 306+ E5E0              ; (state vars + tablas movidas a music_irq.asm — ver bloque
 307+ E5E0              ; "MUSIC DRIVER STATE + TABLES + TICK" alli.)
 308+ E5E0
 309+ E5E0              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 310+ E5E0              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 311+ E5E0              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 312+ E5E0              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 313+ E5E0              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 314+ E5E0              StartMusicImpl:
 315+ E5E0 3A C5 9C         LD A, (MusicTrackArg)
 316+ E5E3 FE FF            CP $FF
 317+ E5E5 28 54            JR Z, .smStop                   ; sentinel: parar musica activa
 318+ E5E7 FE FE            CP $FE
 319+ E5E9 28 7A            JR Z, .smRestart                ; sentinel: re-armar track actual desde
 320+ E5EB                                                  ; primera nota, PRESERVANDO MusicLoop y
 321+ E5EB                                                  ; MusicSpeedShift (utiles para enfasis
 322+ E5EB                                                  ; ej. "muerte se lanza" -> sigue loop +
 323+ E5EB                                                  ; aplica nuevo tempo desde nota 0).
 324+ E5EB FE FD            CP $FD
 325+ E5ED 28 47            JR Z, .smStopIfLoopable         ; sentinel: parar solo si el track activo
 326+ E5EF                                                  ; es loopable. Usado por screen_system
 327+ E5EF                                                  ; al cambiar sala — corta DeathMusic (loopable,
 328+ E5EF                                                  ; ligada a Death entity) pero deja sonar
 329+ E5EF                                                  ; tension/sunrise (one-shot, music continua).
 330+ E5EF                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 331+ E5EF F5               PUSH AF
 332+ E5F0 AF               XOR A
 333+ E5F1 32 A8 7B         LD (MusicLoop), A
 334+ E5F4 32 C6 9C         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 335+ E5F7 F1               POP AF
 336+ E5F8                  ; --- Resolver tabla + modo polifonico segun track id ---
 337+ E5F8                  ; Tracks in-game (0/1/4) = poly2 (canal A+C, B reservado SFX).
 338+ E5F8                  ; Tracks game-end (2/3) = poly3 (A+B+C, sin SFX en escena).
 339+ E5F8 21 B0 7B         LD HL, TensionMusicTable
 340+ E5FB B7               OR A
 341+ E5FC 28 1E            JR Z, .smArmPoly2
 342+ E5FE 21 CE 7B         LD HL, SunriseMusicTable
 343+ E601 3D               DEC A
 344+ E602 28 18            JR Z, .smArmPoly2
 345+ E604 21 D2 7C         LD HL, EndGameMusicTable
 346+ E607 3D               DEC A
 347+ E608 28 19            JR Z, .smArmPoly3Loop            ; track 2 = LOOPABLE
 348+ E60A 21 26 7D         LD HL, GameOverMusicTable
 349+ E60D 3D               DEC A
 350+ E60E 28 18            JR Z, .smArmPoly3
 351+ E610 21 57 7D         LD HL, DeathMusicTable
 352+ E613 3D               DEC A
 353+ E614 28 01            JR Z, .smArmPoly2Loop            ; track 4 = LOOPABLE
 354+ E616 C9               RET                              ; track_id desconocido: no-op
 355+ E617
 356+ E617              .smArmPoly2Loop:
 357+ E617 3E 01            LD A, 1
 358+ E619 32 A8 7B         LD (MusicLoop), A
 359+ E61C                  ; fall-through
 360+ E61C              .smArmPoly2:
 361+ E61C 3E 02            LD A, 2
 362+ E61E 32 A9 7B         LD (MusicMode), A
 363+ E621 18 0A            JR .smArmCommon
 364+ E623
 365+ E623              .smArmPoly3Loop:
 366+ E623 3E 01            LD A, 1
 367+ E625 32 A8 7B         LD (MusicLoop), A
 368+ E628                  ; fall-through
 369+ E628              .smArmPoly3:
 370+ E628 3E 03            LD A, 3
 371+ E62A 32 A9 7B         LD (MusicMode), A
 372+ E62D                  ; fall-through
 373+ E62D              .smArmCommon:
 374+ E62D 22 A6 7B         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 375+ E630 22 A3 7B         LD (MusicPtr), HL
 376+ E633                  ; Mixer R7 vive en $38 (set por AY_Init) — los 3 tonos enable + ruidos off.
 377+ E633                  ; El silencio de un canal se gestiona via vol=0 (en MusicAdvanceNote y en
 378+ E633                  ; los SFX). No re-escribimos R7 aqui para no clobbear bell residual.
 379+ E633 C3 18 7E         JP MusicAdvanceNote             ; tail-call: arma vol+period del primer nota
 380+ E636
 381+ E636              .smStopIfLoopable:
 382+ E636                  ; Sentinel $FD: solo para si el track activo es loopable. Tracks one-shot
 383+ E636                  ; (tension/sunrise/endgame) pasan de largo y siguen sonando.
 384+ E636 3A A8 7B         LD A, (MusicLoop)
 385+ E639 B7               OR A
 386+ E63A C8               RET Z
 387+ E63B                  ; fall-through al stop normal
 388+ E63B              .smStop:
 389+ E63B                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 390+ E63B                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 391+ E63B AF               XOR A
 392+ E63C 32 A5 7B         LD (MusicTimer), A
 393+ E63F 32 A8 7B         LD (MusicLoop), A
 394+ E642 32 C6 9C         LD (MusicSpeedShift), A         ; reset tempo
 395+ E645 67               LD H, A
 396+ E646 6F               LD L, A
 397+ E647 22 AA 7B         LD (MusicPeriodA), HL           ; clear periods → re-arm no escribe AY
 398+ E64A 22 AC 7B         LD (MusicPeriodB), HL
 399+ E64D 22 AE 7B         LD (MusicPeriodC), HL
 400+ E650                  ; Mute los 3 canales (poly2 usa A+C; poly3 usa A+B+C; vale para ambos).
 401+ E650 3E 08            LD A, 8
 402+ E652 1E 00            LD E, 0
 403+ E654 CD 9E E4         CALL AY_WriteReg                ; R8 = 0 (vol A)
 404+ E657 3E 09            LD A, 9
 405+ E659 1E 00            LD E, 0
 406+ E65B CD 9E E4         CALL AY_WriteReg                ; R9 = 0 (vol B — solo era usado en poly3)
 407+ E65E 3E 0A            LD A, 10
 408+ E660 1E 00            LD E, 0
 409+ E662 C3 9E E4         JP AY_WriteReg                  ; tail-call: R10 = 0 (vol C)
 410+ E665
 411+ E665              .smRestart:
 412+ E665                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 413+ E665                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 414+ E665                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 415+ E665                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 416+ E665                  ; con eventos del juego sin esperar al fin de la nota actual.
 417+ E665 2A A6 7B         LD HL, (MusicTableStart)
 418+ E668 22 A3 7B         LD (MusicPtr), HL
 419+ E66B C3 18 7E         JP MusicAdvanceNote
 420+ E66E
 421+ E66E              ; (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote movidos a music_irq.asm
 422+ E66E              ; — slot 1, siempre visible, llamado desde el IRQ handler sin paginar.)
