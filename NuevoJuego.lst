   1+ E386              ; ==============================================================================
   2+ E386              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E386              ; ==============================================================================
   4+ E386              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E386              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E386              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E386              ; ==============================================================================
   8+ E386
   9+ E386              ; --- Constantes ---
  10+ E386              NUM_TIME_MOMENTS    EQU 7
  11+ E386
  12+ E386              ; --- Variables ---
  13+ E386 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E387 22 E8        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E389 22 E8        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E38B 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E38C 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E38D 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E38E
  20+ E38E              ; ==============================================================================
  21+ E38E              ; SetTimeOfDay - Cambia el momento del dia
  22+ E38E              ; ==============================================================================
  23+ E38E              ; Entrada: A = momento (0-6)
  24+ E38E              ; ==============================================================================
  25+ E38E              SetTimeOfDay:
  26+ E38E 32 86 E3         LD (CurrentTimeOfDay), A
  27+ E391
  28+ E391                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E391 FE 04            CP 4
  30+ E393 20 06            JR NZ, .notNewCycle
  31+ E395 21 0D BD         LD HL, DayCycleCount
  32+ E398 34               INC (HL)
  33+ E399 18 04            JR .skipBellsReset
  34+ E39B              .notNewCycle:
  35+ E39B                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E39B                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E39B                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E39B AF               XOR A
  39+ E39C 32 B8 82         LD (BellsTriggered), A
  40+ E39F              .skipBellsReset:
  41+ E39F 3A 86 E3         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E3A2
  43+ E3A2                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E3A2 FE 04            CP 4
  45+ E3A4 28 24            JR Z, .bellsFirst
  46+ E3A6
  47+ E3A6                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E3A6 FE 05            CP 5
  49+ E3A8 20 0D            JR NZ, .noScareMon
  50+ E3AA CD 27 BD         CALL ScareAllMonsters
  51+ E3AD CD 50 FB         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E3B0                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E3B0                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E3B0                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E3B0                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E3B0 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E3B2 CD BC 99         CALL StartMusic
  58+ E3B5 18 07            JR .noKillMon
  59+ E3B7              .noScareMon:
  60+ E3B7                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E3B7 FE 06            CP 6
  62+ E3B9 20 03            JR NZ, .noKillMon
  63+ E3BB CD B0 BC         CALL KillAllActiveMonsters
  64+ E3BE              .noKillMon:
  65+ E3BE
  66+ E3BE                  ; Actualizar tablas de remap y tabla de nasties
  67+ E3BE CD F3 E3         CALL UpdateRemapTables
  68+ E3C1 CD 10 BD         CALL UpdateNastyTable
  69+ E3C4
  70+ E3C4                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E3C4 3E 01            LD A, 1
  72+ E3C6 32 13 83         LD (AttrsDirty), A
  73+ E3C9 C9               RET
  74+ E3CA
  75+ E3CA              .bellsFirst:
  76+ E3CA                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E3CA                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E3CA                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E3CA                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E3CA                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E3CA CD 10 BD         CALL UpdateNastyTable
  82+ E3CD                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E3CD                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E3CD 3A B8 82         LD A, (BellsTriggered)
  85+ E3D0 B7               OR A
  86+ E3D1 C0               RET NZ
  87+ E3D2 3E 01            LD A, 1
  88+ E3D4 32 B8 82         LD (BellsTriggered), A
  89+ E3D7 CD C6 FA         CALL StartBellChimes
  90+ E3DA C9               RET
  91+ E3DB
  92+ E3DB              ; ==============================================================================
  93+ E3DB              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E3DB              ; ==============================================================================
  95+ E3DB              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E3DB              ;   - Salta reloj a 00:00.
  97+ E3DB              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E3DB              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E3DB              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E3DB              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E3DB              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E3DB              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E3DB              ;     pero ya esta en N2 -> no-op visual.
 104+ E3DB              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E3DB              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E3DB              ;
 107+ E3DB              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E3DB              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E3DB              ; aqui no re-dispara nada.
 110+ E3DB              ; ==============================================================================
 111+ E3DB              TriggerChurchMidnight:
 112+ E3DB 3A B8 82         LD A, (BellsTriggered)
 113+ E3DE B7               OR A
 114+ E3DF C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E3E0 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E3E2 CD D2 EB         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E3E5 3E 04            LD A, 4
 118+ E3E7 CD 8E E3         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E3EA                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E3EA                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E3EA                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E3EA CD F3 E3         CALL UpdateRemapTables
 123+ E3ED 3E 01            LD A, 1
 124+ E3EF 32 13 83         LD (AttrsDirty), A
 125+ E3F2 C9               RET
 126+ E3F3
 127+ E3F3              ; ==============================================================================
