5456+ BD15 28 27            JR Z, .kamSkip                      ; slot vacio
5457+ BD17 FE 02            CP TYPE_MONSTER
5458+ BD19 20 23            JR NZ, .kamSkip                     ; no es monster
5459+ BD1B DD 7E 02         LD A, (IX+ENT_STATE)
5460+ BD1E FE 03            CP STATE_DYING
5461+ BD20 28 1C            JR Z, .kamSkip
5462+ BD22 FE 04            CP STATE_SPAWNING
5463+ BD24 28 18            JR Z, .kamSkip
5464+ BD26 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5465+ BD2A DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5466+ BD2E DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5467+ BD32 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5468+ BD36 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5469+ BD3A DD 36 07 00      LD (IX+ENT_DELTAY), 0
5470+ BD3E                  ; ENT_ATTR conservado: puff hereda color del monster
5471+ BD3E              .kamSkip:
5472+ BD3E 11 10 00         LD DE, ENT_SIZE
5473+ BD41 DD 19            ADD IX, DE
5474+ BD43 C1               POP BC
5475+ BD44 10 CA            DJNZ .kamLoop
5476+ BD46 C9               RET
