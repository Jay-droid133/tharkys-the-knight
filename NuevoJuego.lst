  15+ 9D32              ; ==============================================================================
  16+ 9D32              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9D32              ; ==============================================================================
  18+ 9D32              ; Entrada:
  19+ 9D32              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9D32              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9D32              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9D32              ;
  23+ 9D32              ; Formato del sprite:
  24+ 9D32              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9D32              ;   DEFB height_pixels
  26+ 9D32              ;   DEFB pixel_data... (width * height bytes)
  27+ 9D32              ;
  28+ 9D32              ; Dos paths:
  29+ 9D32              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9D32              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9D32              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9D32              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9D32              ;
  34+ 9D32              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9D32              ;
  36+ 9D32              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9D32              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9D32              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9D32              ; alto la restauracion del bank.
  40+ 9D32              ; ==============================================================================
  41+ 9D32              DrawSprite:
  42+ 9D32                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9D32                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9D32                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9D32 3A E7 90         LD A, (CurrentPaging)
  46+ 9D35 E6 F8            AND $F8
  47+ 9D37 F6 06            OR 6
  48+ 9D39 32 E7 90         LD (CurrentPaging), A
  49+ 9D3C 01 FD 7F         LD BC, $7FFD
  50+ 9D3F ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9D41 CD 52 9D         CALL _DrawSpriteImpl
  52+ 9D44                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9D44                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9D44 3A E7 90         LD A, (CurrentPaging)
  55+ 9D47 E6 F8            AND $F8
  56+ 9D49 32 E7 90         LD (CurrentPaging), A
  57+ 9D4C 01 FD 7F         LD BC, $7FFD
  58+ 9D4F ED 79            OUT (C), A
  59+ 9D51 C9               RET
  60+ 9D52
  61+ 9D52              _DrawSpriteImpl:
  62+ 9D52                  ; Guardar posicion
  63+ 9D52 7A               LD A, D
  64+ 9D53 32 0C 9E         LD (.posY), A
  65+ 9D56 7B               LD A, E
  66+ 9D57 32 0B 9E         LD (.posX), A
  67+ 9D5A
  68+ 9D5A                  ; Leer cabecera sprite
  69+ 9D5A DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9D5D 32 0D 9E         LD (.widthSave), A
  71+ 9D60 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9D63 32 0E 9E         LD (.heightSave), A
  73+ 9D66 DD 23            INC IX
  74+ 9D68 DD 23            INC IX                      ; IX → pixel data
  75+ 9D6A
  76+ 9D6A                  ; === Y CLIPPING ===
  77+ 9D6A                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9D6A 3A 0C 9E         LD A, (.posY)
  79+ 9D6D FE 10            CP SCREEN_MIN_Y
  80+ 9D6F 30 20            JR NC, .clipTopDone
  81+ 9D71                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9D71 47               LD B, A                     ; B = Y
  83+ 9D72 3E 10            LD A, SCREEN_MIN_Y
  84+ 9D74 90               SUB B                       ; A = filas a saltar
  85+ 9D75 47               LD B, A                     ; B = skip rows
  86+ 9D76                  ; Reducir altura
  87+ 9D76 3A 0E 9E         LD A, (.heightSave)
  88+ 9D79 90               SUB B
  89+ 9D7A C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9D7B D8               RET C                       ; Idem
  91+ 9D7C 32 0E 9E         LD (.heightSave), A
  92+ 9D7F                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9D7F 3A 0D 9E         LD A, (.widthSave)
  94+ 9D82 4F               LD C, A
  95+ 9D83              .clipSkipRow:
  96+ 9D83 79               LD A, C
  97+ 9D84              .clipSkipByte:
  98+ 9D84 DD 23            INC IX
  99+ 9D86 3D               DEC A
 100+ 9D87 20 FB            JR NZ, .clipSkipByte
 101+ 9D89 10 F8            DJNZ .clipSkipRow
 102+ 9D8B                  ; Ajustar Y al borde
