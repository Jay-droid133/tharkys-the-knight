7493+ CC42 E1               POP HL
7494+ CC43 3E 01            LD A, 1
7495+ CC45 B7               OR A                                ; NZ
7496+ CC46 C9               RET
7497+ CC47
7498+ CC47              ; ==============================================================================
7499+ CC47              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7500+ CC47              ; ==============================================================================
7501+ CC47              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7502+ CC47              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7503+ CC47              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7504+ CC47              ; ==============================================================================
7505+ CC47              ; ==============================================================================
7506+ CC47              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7507+ CC47              ; ==============================================================================
7508+ CC47              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7509+ CC47              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7510+ CC47              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7511+ CC47              ; los pone a su default.
7512+ CC47              ; ==============================================================================
7513+ CC47              InitGameState:
7514+ CC47 3E 03            LD A, PLAYER_LIVES_INIT
7515+ CC49 32 84 82         LD (PlayerLives), A
7516+ CC4C 3E 10            LD A, HEALTH_MAX
7517+ CC4E 32 68 B6         LD (PlayerHealth), A
7518+ CC51 3E 10            LD A, STAMINA_MAX
7519+ CC53 32 69 B6         LD (PlayerStamina), A
7520+ CC56 AF               XOR A
7521+ CC57 32 85 82         LD (GameOver), A
7522+ CC5A 32 67 82         LD (CurrentObjective), A
7523+ CC5D 32 5E 82         LD (CurrentKey), A
7524+ CC60 32 62 82         LD (ChurchEverOpened), A
7525+ CC63 32 61 82         LD (ChurchDoorOpen), A
7526+ CC66 32 63 82         LD (TimeFrozen), A
7527+ CC69 32 60 82         LD (ChurchKeySpawned), A
7528+ CC6C 32 72 82         LD (TownGateKeySpawned), A
7529+ CC6F 32 76 82         LD (ArmRevealed), A
7530+ CC72 32 77 82         LD (FingerRevealed), A
7531+ CC75 32 6E B6         LD (MonstersActive), A
7532+ CC78 32 6E 82         LD (MonsterTrappedFlags), A
7533+ CC7B 32 A0 82         LD (DeathSpawned), A
7534+ CC7E 32 75 82         LD (TownGatePhase), A
7535+ CC81 32 73 82         LD (ChurchCutscenePhase), A
7536+ CC84 32 4D E5         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7537+ CC87 32 66 82         LD (BellsTriggered), A
7538+ CC8A 32 6F 82         LD (NextChurchTrapStep), A
7539+ CC8D 32 70 82         LD (StatueBlinkCounter), A
7540+ CC90 32 71 82         LD (ChurchKeyAltSpawnIdx), A
7541+ CC93 32 00 C8         LD (PlayerHitTimer), A
7542+ CC96 32 99 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7543+ CC99 32 9A 82         LD (TombDrawPending), A
7544+ CC9C 32 8D 82         LD (DeathBorderPhase), A
7545+ CC9F 32 8E 82         LD (DeathBorderTimer), A
7546+ CCA2 32 8F 82         LD (PlayerDeathAnimTimer), A
7547+ CCA5 32 90 82         LD (PlayerDeathAnimFrame), A
7548+ CCA8 32 91 82         LD (PlayerRespawnPhase), A
7549+ CCAB 32 92 82         LD (PlayerRespawnTimer), A
7550+ CCAE 32 93 82         LD (PlayerRespawnBlinkTimer), A
7551+ CCB1 32 95 82         LD (PlayerRespawnBeatIdx), A
7552+ CCB4 32 86 82         LD (GameOverAnimX), A
7553+ CCB7 32 87 82         LD (GameOverAnimDir), A
7554+ CCBA 32 88 82         LD (GameOverAnimFrame), A
7555+ CCBD 32 89 82         LD (GameOverAnimFrameTimer), A
7556+ CCC0 32 8C 82         LD (GameOverAnimLastX), A
7557+ CCC3 21 00 00         LD HL, 0
7558+ CCC6 22 8A 82         LD (GameOverAnimLastSpr), HL
7559+ CCC9 22 9D 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7560+ CCCC 3E 01            LD A, 1
7561+ CCCE 32 94 82         LD (PlayerRespawnVisible), A
7562+ CCD1 3E 00            LD A, BLACK
7563+ CCD3 32 E9 90         LD (CurrentBorderColor), A
7564+ CCD6 D3 FE            OUT (254), A
7565+ CCD8 3E 01            LD A, 1
7566+ CCDA 32 03 C0         LD (DayCycleCount), A
7567+ CCDD 21 E7 BF         LD HL, DiurnalTypeTable
7568+ CCE0 22 04 C0         LD (CurrentNastyTable), HL
7569+ CCE3                  ; Reset speed + buff (en caso de restart con buff activo).
7570+ CCE3 3E 04            LD A, SPEED_RUN
7571+ CCE5 32 7B 82         LD (PlayerSpeedRun), A
7572+ CCE8 3E 02            LD A, SPEED_FIGHT
7573+ CCEA 32 7C 82         LD (PlayerSpeedFight), A
7574+ CCED 21 00 00         LD HL, 0
7575+ CCF0 22 7D 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7576+ CCF3 22 80 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7577+ CCF6 AF               XOR A
7578+ CCF7 32 7F 82         LD (SpeedBuffType), A
7579+ CCFA                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7580+ CCFA                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7581+ CCFA                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7582+ CCFA                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7583+ CCFA                  ; recupera el control. Mismo flujo que tras una muerte.
7584+ CCFA 3E 01            LD A, 1
7585+ CCFC 32 91 82         LD (PlayerRespawnPhase), A
7586+ CCFF C9               RET
7587+ CD00
7588+ CD00              OnPlayerHealthDepleted:
7589+ CD00                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7590+ CD00                  ; coste real). Idempotente si no estaba activo.
7591+ CD00 CD 2A 72         CALL CancelMagicCompass
7592+ CD03                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7593+ CD03                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7594+ CD03                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7595+ CD03                  ; (combate, Death catch, drain de salud por cualquier via).
7596+ CD03 F5               PUSH AF
7597+ CD04 3E FF            LD A, $FF
7598+ CD06 CD 06 9D         CALL StartMusic
7599+ CD09 F1               POP AF
7600+ CD0A                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7601+ CD0A                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7602+ CD0A CD 20 6D         CALL AY_PlayPlayerDeath
7603+ CD0D                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7604+ CD0D                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7605+ CD0D 3E 02            LD A, 2
7606+ CD0F 32 63 82         LD (TimeFrozen), A
7607+ CD12                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7608+ CD12 CD 51 6B         CALL TombStore
7609+ CD15                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7610+ CD15 CD 43 BD         CALL KillAllActiveNasties
7611+ CD18                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7612+ CD18 CD 11 BE         CALL SilentKillDeath
7613+ CD1B                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7614+ CD1B CD 2C BE         CALL FreezeMonstersFacingCorpse
7615+ CD1E                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7616+ CD1E CD BC CD         CALL TriggerDeathBorder
7617+ CD21                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7618+ CD21                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7619+ CD21                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7620+ CD21 DD 21 4B 81      LD IX, EntityTable
7621+ CD25                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7622+ CD25 DD 7E 0A         LD A, (IX+ENT_DIR)
7623+ CD28 E6 80            AND $80
7624+ CD2A 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7625+ CD2C 28 02            JR Z, .ophdRightBase
7626+ CD2E 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7627+ CD30              .ophdRightBase:
7628+ CD30 DD 77 00         LD (IX+ENT_SPRITEID), A
7629+ CD33 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7630+ CD37 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7631+ CD3B 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7632+ CD3D 32 8F 82         LD (PlayerDeathAnimTimer), A
7633+ CD40 AF               XOR A
7634+ CD41 32 90 82         LD (PlayerDeathAnimFrame), A
7635+ CD44                  ; Decrementar vida (clamp a 0)
7636+ CD44 3A 84 82         LD A, (PlayerLives)
7637+ CD47 B7               OR A
7638+ CD48 C8               RET Z
7639+ CD49 3D               DEC A
7640+ CD4A 32 84 82         LD (PlayerLives), A
7641+ CD4D C9               RET
7642+ CD4E
7643+ CD4E              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7644+ CD4E              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7645+ CD4E              ErasePlayerSpriteAtOldPos:
7646+ CD4E DD 21 4B 81      LD IX, EntityTable
7647+ CD52 CD 2E A8         CALL GetOldSpriteAddr
7648+ CD55 DD 56 0D         LD D, (IX+ENT_OLDY)
7649+ CD58 DD 7E 0C         LD A, (IX+ENT_OLDX)
7650+ CD5B 5F               LD E, A
7651+ CD5C DD E5            PUSH IX
7652+ CD5E DD 2A B6 A7      LD IX, (OldSprAddr)
7653+ CD62 CD 33 9D         CALL DrawSprite
7654+ CD65 DD E1            POP IX
7655+ CD67 DD 56 0D         LD D, (IX+ENT_OLDY)
7656+ CD6A DD 5E 0C         LD E, (IX+ENT_OLDX)
7657+ CD6D C3 EB D5         JP RestoreOldAttr                   ; tail-call
7658+ CD70
7659+ CD70              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7660+ CD70              RespawnPlayerAtEntry:
7661+ CD70 DD 21 4B 81      LD IX, EntityTable
7662+ CD74 3A B4 82         LD A, (LastEntryPosX)
7663+ CD77 DD 77 03         LD (IX+ENT_POSX), A
7664+ CD7A DD 77 0C         LD (IX+ENT_OLDX), A
7665+ CD7D DD 77 0F         LD (IX+ENT_DRAWX), A
7666+ CD80 3A B5 82         LD A, (LastEntryPosY)
7667+ CD83 DD 77 04         LD (IX+ENT_POSY), A
7668+ CD86 DD 77 0D         LD (IX+ENT_OLDY), A
7669+ CD89 3E 10            LD A, HEALTH_MAX
7670+ CD8B 32 68 B6         LD (PlayerHealth), A
7671+ CD8E 3E 10            LD A, STAMINA_MAX
7672+ CD90 32 69 B6         LD (PlayerStamina), A
7673+ CD93 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7674+ CD97 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7675+ CD9B DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7676+ CD9F DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7677+ CDA3 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7678+ CDA7 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7679+ CDAB DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7680+ CDAF                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7681+ CDAF                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7682+ CDAF 3E 01            LD A, 1
7683+ CDB1 32 91 82         LD (PlayerRespawnPhase), A
7684+ CDB4 AF               XOR A
7685+ CDB5 32 92 82         LD (PlayerRespawnTimer), A
7686+ CDB8 32 95 82         LD (PlayerRespawnBeatIdx), A
7687+ CDBB C9               RET
7688+ CDBC
7689+ CDBC              ; ==============================================================================
7690+ CDBC              ; TriggerDeathBorder - arranca el flash del borde tras morir
7691+ CDBC              ; ==============================================================================
7692+ CDBC              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7693+ CDBC              ; luego vuelve a negro y se desactiva.
7694+ CDBC              ; ==============================================================================
7695+ CDBC              TriggerDeathBorder:
7696+ CDBC 3E 01            LD A, 1
7697+ CDBE 32 8D 82         LD (DeathBorderPhase), A
7698+ CDC1 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7699+ CDC3 32 8E 82         LD (DeathBorderTimer), A
7700+ CDC6 3E 06            LD A, YELLOW
7701+ CDC8 32 E9 90         LD (CurrentBorderColor), A
7702+ CDCB D3 FE            OUT (254), A
7703+ CDCD C9               RET
7704+ CDCE
7705+ CDCE              ; ==============================================================================
7706+ CDCE              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7707+ CDCE              ; ==============================================================================
7708+ CDCE              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7709+ CDCE              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7710+ CDCE              ; ==============================================================================
7711+ CDCE              UpdateRespawnBlink:
7712+ CDCE 3A 91 82         LD A, (PlayerRespawnPhase)
7713+ CDD1 B7               OR A
7714+ CDD2 C8               RET Z
7715+ CDD3 3D               DEC A
7716+ CDD4 28 0D            JR Z, .urbPhase1
7717+ CDD6                  ; Phase 2: solo timer (sin parpadeo)
7718+ CDD6 3A 92 82         LD A, (PlayerRespawnTimer)
7719+ CDD9 3D               DEC A
7720+ CDDA 32 92 82         LD (PlayerRespawnTimer), A
7721+ CDDD C0               RET NZ
7722+ CDDE AF               XOR A
7723+ CDDF 32 91 82         LD (PlayerRespawnPhase), A
7724+ CDE2 C9               RET
7725+ CDE3
7726+ CDE3              .urbPhase1:
7727+ CDE3                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7728+ CDE3                  ; Zero input (sin control)
7729+ CDE3 AF               XOR A
7730+ CDE4 32 5B 82         LD (InputDirection), A
7731+ CDE7 32 5C 82         LD (InputFire), A
7732+ CDEA                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7733+ CDEA                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7734+ CDEA 3A 15 6D         LD A, (BeepDurationFrames)
7735+ CDED D6 01            SUB 1                               ; CY si era 0 (silencio)
7736+ CDEF 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7737+ CDF0 E6 74            AND SPRID_PLAYER_BLANK
7738+ CDF2 32 4B 81         LD (EntityTable), A
7739+ CDF5                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7740+ CDF5 3A 92 82         LD A, (PlayerRespawnTimer)
7741+ CDF8 B7               OR A
7742+ CDF9 28 05            JR Z, .urb1FireBeat
7743+ CDFB 3D               DEC A
7744+ CDFC 32 92 82         LD (PlayerRespawnTimer), A
7745+ CDFF C9               RET
7746+ CE00              .urb1FireBeat:
7747+ CE00 3A 95 82         LD A, (PlayerRespawnBeatIdx)
7748+ CE03 3C               INC A
7749+ CE04 32 95 82         LD (PlayerRespawnBeatIdx), A
7750+ CE07 FE 04            CP 4
7751+ CE09 28 12            JR Z, .urb1LastBeat
7752+ CE0B FE 05            CP 5
7753+ CE0D 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7754+ CE0F                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7755+ CE0F 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7756+ CE12 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7757+ CE14 CD 45 6D         CALL AY_PlayBeep
7758+ CE17                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7759+ CE17                  ; (mitad) para mantener ON/OFF ~50/50.
7760+ CE17 3E 14            LD A, 20
7761+ CE19 32 92 82         LD (PlayerRespawnTimer), A
7762+ CE1C C9               RET
7763+ CE1D              .urb1LastBeat:
7764+ CE1D                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7765+ CE1D                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7766+ CE1D                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7767+ CE1D                  ; entra grace EXACTAMENTE al terminar el beep.
7768+ CE1D 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7769+ CE20 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7770+ CE22 CD 45 6D         CALL AY_PlayBeep
7771+ CE25 3E 0B            LD A, 11                    ; espera = duracion del beep
7772+ CE27 32 92 82         LD (PlayerRespawnTimer), A
7773+ CE2A C9               RET
7774+ CE2B              .urb1AfterBeep:
7775+ CE2B                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7776+ CE2B                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7777+ CE2B CD 44 CE         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7778+ CE2E 3E 0C            LD A, SPAWN_INTERVAL
7779+ CE30 32 9B 82         LD (SpawnTimer), A
7780+ CE33 AF               XOR A
7781+ CE34 32 A0 82         LD (DeathSpawned), A
7782+ CE37 32 96 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7783+ CE3A 32 63 82         LD (TimeFrozen), A              ; Reanudar reloj
7784+ CE3D 21 00 00         LD HL, 0
7785+ CE40 22 9D 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7786+ CE43 C9               RET
7787+ CE44
7788+ CE44              ; ==============================================================================
7789+ CE44              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7790+ CE44              ; ==============================================================================
7791+ CE44              ; Llamado desde:
7792+ CE44              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7793+ CE44              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7794+ CE44              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7795+ CE44              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7796+ CE44              ; ==============================================================================
7797+ CE44              EnterGracePhase:
7798+ CE44 3E 02            LD A, 2
7799+ CE46 32 91 82         LD (PlayerRespawnPhase), A
7800+ CE49 3E 19            LD A, RESPAWN_GRACE_FRAMES
7801+ CE4B 32 92 82         LD (PlayerRespawnTimer), A
7802+ CE4E C9               RET
7803+ CE4F
7804+ CE4F              ; ==============================================================================
7805+ CE4F              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7806+ CE4F              ; ==============================================================================
7807+ CE4F              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7808+ CE4F              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7809+ CE4F              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7810+ CE4F              ; ==============================================================================
7811+ CE4F              UpdateDeathAnim:
7812+ CE4F 3A 8D 82         LD A, (DeathBorderPhase)
7813+ CE52 FE 01            CP 1
7814+ CE54 C0               RET NZ
7815+ CE55 3A 8F 82         LD A, (PlayerDeathAnimTimer)
7816+ CE58 3D               DEC A
7817+ CE59 32 8F 82         LD (PlayerDeathAnimTimer), A
7818+ CE5C C0               RET NZ
7819+ CE5D                  ; Tick consumido: avanzar frame
7820+ CE5D 3A 90 82         LD A, (PlayerDeathAnimFrame)
7821+ CE60 3C               INC A
7822+ CE61 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7823+ CE63 D0               RET NC                              ; ya en ultimo frame (clamp)
7824+ CE64 32 90 82         LD (PlayerDeathAnimFrame), A
7825+ CE67 DD 21 4B 81      LD IX, EntityTable
7826+ CE6B DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7827+ CE6E                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7828+ CE6E                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7829+ CE6E                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7830+ CE6E FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7831+ CE70 20 06            JR NZ, .udaSkipSplatSfx
7832+ CE72 21 CE F9         LD HL, SFX_EnemyDeath
7833+ CE75 CD 4F F9         CALL PlaySFX
7834+ CE78              .udaSkipSplatSfx:
7835+ CE78 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7836+ CE7A 32 8F 82         LD (PlayerDeathAnimTimer), A
7837+ CE7D C9               RET
7838+ CE7E
7839+ CE7E              ; ==============================================================================
7840+ CE7E              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7841+ CE7E              ; ==============================================================================
7842+ CE7E              UpdateDeathBorder:
7843+ CE7E 3A 8D 82         LD A, (DeathBorderPhase)
7844+ CE81 B7               OR A
7845+ CE82 C8               RET Z
7846+ CE83 3A 8E 82         LD A, (DeathBorderTimer)
7847+ CE86 3D               DEC A
7848+ CE87 32 8E 82         LD (DeathBorderTimer), A
7849+ CE8A C0               RET NZ
7850+ CE8B                  ; Timer expiro: avanzar fase
7851+ CE8B 3A 8D 82         LD A, (DeathBorderPhase)
7852+ CE8E FE 01            CP 1
7853+ CE90 20 33            JR NZ, .udbToBlack
7854+ CE92                  ; --- Fin fase amarillo ---
7855+ CE92                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7856+ CE92                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7857+ CE92 3A 84 82         LD A, (PlayerLives)
7858+ CE95 B7               OR A
7859+ CE96 28 1F            JR Z, .udbToGameOver
7860+ CE98 DD 21 4B 81      LD IX, EntityTable
7861+ CE9C DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7862+ CEA0 3E 02            LD A, 2
7863+ CEA2 32 8D 82         LD (DeathBorderPhase), A
7864+ CEA5 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7865+ CEA7 32 8E 82         LD (DeathBorderTimer), A
7866+ CEAA 3E 02            LD A, RED
7867+ CEAC 32 E9 90         LD (CurrentBorderColor), A
7868+ CEAF D3 FE            OUT (254), A
7869+ CEB1                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7870+ CEB1                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7871+ CEB1 3E 01            LD A, 1
7872+ CEB3 32 9A 82         LD (TombDrawPending), A
7873+ CEB6 C9               RET
7874+ CEB7              .udbToGameOver:
7875+ CEB7                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7876+ CEB7 AF               XOR A
7877+ CEB8 32 8D 82         LD (DeathBorderPhase), A
7878+ CEBB 3E 00            LD A, BLACK
7879+ CEBD 32 E9 90         LD (CurrentBorderColor), A
7880+ CEC0 D3 FE            OUT (254), A
7881+ CEC2 C3 D3 CE         JP ShowGameOver
7882+ CEC5              .udbToBlack:
7883+ CEC5                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7884+ CEC5 AF               XOR A
7885+ CEC6 32 8D 82         LD (DeathBorderPhase), A
7886+ CEC9 3E 00            LD A, BLACK
7887+ CECB 32 E9 90         LD (CurrentBorderColor), A
7888+ CECE D3 FE            OUT (254), A
7889+ CED0 C3 70 CD         JP RespawnPlayerAtEntry             ; tail-call
7890+ CED3
7891+ CED3              ; ==============================================================================
7892+ CED3              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7893+ CED3              ; ==============================================================================
7894+ CED3              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7895+ CED3              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7896+ CED3              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7897+ CED3              ; ==============================================================================
7898+ CED3              ShowGameOver:
7899+ CED3 3E 01            LD A, 1
7900+ CED5 32 85 82         LD (GameOver), A
7901+ CED8 C9               RET
7902+ CED9
7903+ CED9              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7904+ CED9              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7905+ CED9              PaintGameOverScreen:
7906+ CED9                  ; Wipe pixels
7907+ CED9 21 00 40         LD HL, $4000
7908+ CEDC 11 01 40         LD DE, $4001
7909+ CEDF 01 FF 17         LD BC, $17FF
7910+ CEE2 36 00            LD (HL), 0
7911+ CEE4 ED B0            LDIR
7912+ CEE6                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7913+ CEE6 21 00 58         LD HL, $5800
7914+ CEE9 11 01 58         LD DE, $5801
7915+ CEEC 01 FF 02         LD BC, $02FF
7916+ CEEF 36 47            LD (HL), $47
7917+ CEF1 ED B0            LDIR
7918+ CEF3                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
7919+ CEF3                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
7920+ CEF3 CD 34 FB         CALL DrawTombstone2xCentered
7921+ CEF6                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7922+ CEF6 3E 88            LD A, GAMEOVER_ANIM_X_MAX
7923+ CEF8 32 86 82         LD (GameOverAnimX), A
7924+ CEFB AF               XOR A
7925+ CEFC 32 87 82         LD (GameOverAnimDir), A
7926+ CEFF 32 88 82         LD (GameOverAnimFrame), A
7927+ CF02 32 8C 82         LD (GameOverAnimLastX), A
7928+ CF05 21 00 00         LD HL, 0
7929+ CF08 22 8A 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7930+ CF0B 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7931+ CF0D 32 89 82         LD (GameOverAnimFrameTimer), A
7932+ CF10                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7933+ CF10                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7934+ CF10                  ; congelado en GameOver=2.
7935+ CF10 3E 03            LD A, 3
7936+ CF12 C3 06 9D         JP StartMusic                   ; tail-call
7937+ CF15
7938+ CF15              ; ==============================================================================
7939+ CF15              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7940+ CF15              ; ==============================================================================
7941+ CF15              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7942+ CF15              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7943+ CF15              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7944+ CF15              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7945+ CF15              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7946+ CF15              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7947+ CF15              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7948+ CF15              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7949+ CF15              ;
7950+ CF15              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7951+ CF15              ; shifted (que ocupa 4 chars = 32 px).
7952+ CF15              ; ==============================================================================
7953+ CF15              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
7954+ CF15              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
7955+ CF15              ; X swing centrado sobre la tumba:
7956+ CF15              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
7957+ CF15              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
7958+ CF15              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
7959+ CF15              GAMEOVER_ANIM_Y           EQU 56
7960+ CF15              GAMEOVER_ANIM_X_MIN       EQU 96
7961+ CF15              GAMEOVER_ANIM_X_MAX       EQU 136
7962+ CF15              GAMEOVER_ANIM_FRAME_TICKS EQU 6
7963+ CF15
7964+ CF15              UpdateGameOverAnim:
7965+ CF15                  ; --- Erase del sprite previo (si lo hubo) ---
7966+ CF15 2A 8A 82         LD HL, (GameOverAnimLastSpr)
7967+ CF18 7C               LD A, H
7968+ CF19 B5               OR L
7969+ CF1A 28 0C            JR Z, .ugoaNoErase
7970+ CF1C E5               PUSH HL
7971+ CF1D DD E1            POP IX
7972+ CF1F 3A 8C 82         LD A, (GameOverAnimLastX)
7973+ CF22 5F               LD E, A
7974+ CF23 16 38            LD D, GAMEOVER_ANIM_Y
7975+ CF25 CD 33 9D         CALL DrawSprite
7976+ CF28              .ugoaNoErase:
7977+ CF28
7978+ CF28                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
7979+ CF28 3A 89 82         LD A, (GameOverAnimFrameTimer)
7980+ CF2B 3D               DEC A
7981+ CF2C 20 0A            JR NZ, .ugoaTimerSet
7982+ CF2E 3A 88 82         LD A, (GameOverAnimFrame)
7983+ CF31 EE 01            XOR 1
7984+ CF33 32 88 82         LD (GameOverAnimFrame), A
7985+ CF36 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7986+ CF38              .ugoaTimerSet:
7987+ CF38 32 89 82         LD (GameOverAnimFrameTimer), A
7988+ CF3B
7989+ CF3B                  ; --- Avanzar X segun direccion (ping-pong) ---
7990+ CF3B 3A 87 82         LD A, (GameOverAnimDir)
7991+ CF3E B7               OR A
7992+ CF3F 20 14            JR NZ, .ugoaSlideRight
7993+ CF41                  ; Dir 0: facing R, slide LEFT (X--)
7994+ CF41 3A 86 82         LD A, (GameOverAnimX)
7995+ CF44 FE 60            CP GAMEOVER_ANIM_X_MIN
7996+ CF46 28 06            JR Z, .ugoaFlipToL
7997+ CF48 3D               DEC A
7998+ CF49 32 86 82         LD (GameOverAnimX), A
7999+ CF4C 18 18            JR .ugoaPickSprite
8000+ CF4E              .ugoaFlipToL:
8001+ CF4E 3E 01            LD A, 1
8002+ CF50 32 87 82         LD (GameOverAnimDir), A
8003+ CF53 18 11            JR .ugoaPickSprite
8004+ CF55              .ugoaSlideRight:
8005+ CF55                  ; Dir 1: facing L, slide RIGHT (X++)
8006+ CF55 3A 86 82         LD A, (GameOverAnimX)
8007+ CF58 FE 88            CP GAMEOVER_ANIM_X_MAX
8008+ CF5A 28 06            JR Z, .ugoaFlipToR
8009+ CF5C 3C               INC A
8010+ CF5D 32 86 82         LD (GameOverAnimX), A
8011+ CF60 18 04            JR .ugoaPickSprite
8012+ CF62              .ugoaFlipToR:
8013+ CF62 AF               XOR A
8014+ CF63 32 87 82         LD (GameOverAnimDir), A
8015+ CF66
8016+ CF66              .ugoaPickSprite:
8017+ CF66                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8018+ CF66                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8019+ CF66                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8020+ CF66 3A 87 82         LD A, (GameOverAnimDir)
8021+ CF69 B7               OR A
8022+ CF6A 20 0E            JR NZ, .ugoaPickR
8023+ CF6C 3A 88 82         LD A, (GameOverAnimFrame)
8024+ CF6F B7               OR A
8025+ CF70 21 DF DD         LD HL, SprDeath_L0
8026+ CF73 28 11            JR Z, .ugoaSprSet
8027+ CF75 21 29 DE         LD HL, SprDeath_L1
8028+ CF78 18 0C            JR .ugoaSprSet
8029+ CF7A              .ugoaPickR:
8030+ CF7A 3A 88 82         LD A, (GameOverAnimFrame)
8031+ CF7D B7               OR A
8032+ CF7E 21 4B DD         LD HL, SprDeath_0
8033+ CF81 28 03            JR Z, .ugoaSprSet
8034+ CF83 21 95 DD         LD HL, SprDeath_1
8035+ CF86              .ugoaSprSet:
8036+ CF86 22 8A 82         LD (GameOverAnimLastSpr), HL
8037+ CF89 3A 86 82         LD A, (GameOverAnimX)
8038+ CF8C 32 8C 82         LD (GameOverAnimLastX), A
8039+ CF8F
8040+ CF8F                  ; --- Draw nuevo sprite ---
8041+ CF8F E5               PUSH HL
8042+ CF90 DD E1            POP IX
8043+ CF92 5F               LD E, A
8044+ CF93 16 38            LD D, GAMEOVER_ANIM_Y
8045+ CF95 C3 33 9D         JP DrawSprite                   ; tail-call
