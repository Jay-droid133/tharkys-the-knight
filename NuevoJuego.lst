 123+ EC89              ; ==============================================================================
 124+ EC89              ; UpdateGameClock
 125+ EC89              ; ==============================================================================
 126+ EC89              UpdateGameClock:
 127+ EC89 3A 4E 82         LD A, (TimeFrozen)
 128+ EC8C B7               OR A
 129+ EC8D C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EC8E 21 EF EA         LD HL, GameSubMinute
 131+ EC91 34               INC (HL)
 132+ EC92 3A F2 EA         LD A, (SubMinuteMax)
 133+ EC95 BE               CP (HL)
 134+ EC96 C0               RET NZ
 135+ EC97
 136+ EC97 AF               XOR A
 137+ EC98 32 EF EA         LD (GameSubMinute), A
 138+ EC9B 21 F0 EA         LD HL, GameMinutes
 139+ EC9E 34               INC (HL)
 140+ EC9F                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EC9F                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EC9F 3A F0 EA         LD A, (GameMinutes)
 143+ ECA2 FE 3C            CP 60
 144+ ECA4 C0               RET NZ
 145+ ECA5
 146+ ECA5 AF               XOR A
 147+ ECA6 32 F0 EA         LD (GameMinutes), A
 148+ ECA9 21 F1 EA         LD HL, GameHours
 149+ ECAC 34               INC (HL)
 150+ ECAD 7E               LD A, (HL)
 151+ ECAE FE 18            CP 24
 152+ ECB0 20 04            JR NZ, .checkPhase
 153+ ECB2 AF               XOR A
 154+ ECB3 32 F1 EA         LD (GameHours), A
 155+ ECB6
 156+ ECB6              .checkPhase:
 157+ ECB6 3A F1 EA         LD A, (GameHours)
 158+ ECB9 21 FB EA         LD HL, PhaseTable
 159+ ECBC 06 07            LD B, 7
 160+ ECBE              .phaseLoop:
 161+ ECBE BE               CP (HL)
 162+ ECBF 28 05            JR Z, .phaseFound
 163+ ECC1 23               INC HL
 164+ ECC2 23               INC HL
 165+ ECC3 10 F9            DJNZ .phaseLoop
 166+ ECC5 C9               RET
 167+ ECC6              .phaseFound:
 168+ ECC6 23               INC HL
 169+ ECC7 7E               LD A, (HL)
 170+ ECC8 F5               PUSH AF
 171+ ECC9 CD 9A E4         CALL SetTimeOfDay
 172+ ECCC F1               POP AF
 173+ ECCD FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ ECCF C0               RET NZ
 175+ ECD0                  ; Nuevo dia: incrementar ciclo
 176+ ECD0 21 6F C0         LD HL, DayCycleCount
 177+ ECD3 34               INC (HL)
 178+ ECD4 C9               RET
 179+ ECD5
 180+ ECD5              ; ==============================================================================
 181+ ECD5              ; SetClockToPhaseHour
 182+ ECD5              ; ==============================================================================
 183+ ECD5              SetClockToPhaseHour:
 184+ ECD5 21 F4 EA         LD HL, PhaseStartHour
 185+ ECD8 4F               LD C, A
 186+ ECD9 06 00            LD B, 0
 187+ ECDB 09               ADD HL, BC
 188+ ECDC 7E               LD A, (HL)
 189+ ECDD 32 F1 EA         LD (GameHours), A
 190+ ECE0 AF               XOR A
 191+ ECE1 32 F0 EA         LD (GameMinutes), A
 192+ ECE4 32 EF EA         LD (GameSubMinute), A
 193+ ECE7 C9               RET
 194+ ECE8
 195+ ECE8              ; ==============================================================================
 196+ ECE8              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ ECE8              ; ==============================================================================
 198+ ECE8              DrawClockHUD:
 199+ ECE8                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ ECE8                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ ECE8                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ ECE8                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ ECE8                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ ECE8                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ ECE8 3A 4E 82         LD A, (TimeFrozen)
 206+ ECEB FE 01            CP 1
 207+ ECED 20 07            JR NZ, .clkDrawNormal
 208+ ECEF 3A 33 81         LD A, (GameFrameCounter)
 209+ ECF2 E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ ECF4 28 2D            JR Z, .clkBlinkOff
 211+ ECF6              .clkDrawNormal:
 212+ ECF6 CD 31 ED         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ ECF9
 214+ ECF9                  ; --- Aguja de horas ---
 215+ ECF9 3A F1 EA         LD A, (GameHours)
 216+ ECFC FE 0C            CP 12
 217+ ECFE 38 02            JR C, .hourOk
 218+ ED00 D6 0C            SUB 12
 219+ ED02              .hourOk:
 220+ ED02 21 ED EB         LD HL, HourHandPtrs
 221+ ED05 CD 18 EF         CALL DrawHandLine
 222+ ED08
 223+ ED08                  ; --- Aguja de minutos ---
 224+ ED08 3A F0 EA         LD A, (GameMinutes)
 225+ ED0B 06 00            LD B, 0
 226+ ED0D              .divMin:
 227+ ED0D FE 05            CP 5
 228+ ED0F 38 05            JR C, .minOk
 229+ ED11 D6 05            SUB 5
 230+ ED13 04               INC B
 231+ ED14 18 F7            JR .divMin
 232+ ED16              .minOk:
 233+ ED16 78               LD A, B
 234+ ED17 21 09 EB         LD HL, MinHandPtrs
 235+ ED1A CD 18 EF         CALL DrawHandLine
 236+ ED1D
 237+ ED1D                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ ED1D 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ ED20 CB 86            RES 0, (HL)
 240+ ED22 C9               RET
 241+ ED23
 242+ ED23              .clkBlinkOff:
 243+ ED23                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ ED23                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ ED23                  ; paper=black + ink=black.
 246+ ED23 AF               XOR A
 247+ ED24 32 0F 58         LD ($580F), A
 248+ ED27 32 2F 58         LD ($582F), A
 249+ ED2A 32 10 58         LD ($5810), A
 250+ ED2D 32 30 58         LD ($5830), A
 251+ ED30 C9               RET
