 123  6A55
 124  6A55                  ; --- Rutinas de paginacion (paging.asm) ---
 125  6A55                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 126  6A55                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 127  6A55                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 128  6A55                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 129  6A55                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 130  6A55                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 131  6A55                  ; criterio (siempre visible) pero contended.
 132  6A55                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 133  6A55                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 134  6A55                  ; el inner loop, asi que el overhead es invisible.
 135  6A55                  INCLUDE "paging.asm"
# file opened: code/paging.asm
   1+ 6A55              ; ==============================================================================
   2+ 6A55              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6A55              ; ==============================================================================
   4+ 6A55              ; Port $7FFD (write-only):
   5+ 6A55              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6A55              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6A55              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6A55              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6A55              ;
  10+ 6A55              ; Bancos disponibles:
  11+ 6A55              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6A55              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6A55              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6A55              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6A55              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6A55              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6A55              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6A55              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6A55              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6A55              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6A55              ; ==============================================================================
  22+ 6A55
  23+ 6A55              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6A55              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6A55
  26+ 6A55              ; ==============================================================================
  27+ 6A55              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6A55              ; ==============================================================================
  29+ 6A55              ; Entrada: A = banco (0-7)
  30+ 6A55              ; Preserva: HL, DE, IX, IY
  31+ 6A55              ; Destruye: A, BC
  32+ 6A55              ; ==============================================================================
  33+ 6A55              PageBankSlot3:
  34+ 6A55 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6A57 47               LD B, A                     ; guardar banco nuevo
  36+ 6A58 3A 85 8D         LD A, (CurrentPaging)
  37+ 6A5B E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6A5D B0               OR B                        ; poner nuevo banco
  39+ 6A5E 32 85 8D         LD (CurrentPaging), A
  40+ 6A61 01 FD 7F         LD BC, $7FFD
  41+ 6A64 ED 79            OUT (C), A
  42+ 6A66 C9               RET
  43+ 6A67
  44+ 6A67              ; ==============================================================================
  45+ 6A67              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6A67              ; ==============================================================================
  47+ 6A67              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6A67              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6A67              ; ==============================================================================
  50+ 6A67              InitPaging:
  51+ 6A67 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6A69 32 85 8D         LD (CurrentPaging), A
  53+ 6A6C 01 FD 7F         LD BC, $7FFD
  54+ 6A6F ED 79            OUT (C), A
  55+ 6A71 C9               RET
  56+ 6A72
  57+ 6A72              ; ==============================================================================
  58+ 6A72              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6A72              ; ==============================================================================
  60+ 6A72              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6A72              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6A72              ;      Paginacion restaurada a bank 0.
  63+ 6A72              ; Destruye: A, BC, DE, HL
  64+ 6A72              ;
  65+ 6A72              ; Formato del room en FUENTE (variable-length):
  66+ 6A72              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6A72              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6A72              ;   terminador:                  DEFB $FF
  69+ 6A72              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6A72              ;
  71+ 6A72              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6A72              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6A72              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6A72              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6A72              ; ==============================================================================
  76+ 6A72              LoadRoomToBuffer:
  77+ 6A72                  ; El stack normal vive en slot 3 ($FF58). Mientras paginamos slot 3 al
  78+ 6A72                  ; bank de datos, el stack normal queda fisicamente "oculto" (pero intacto
  79+ 6A72                  ; en bank 0). Si una IRQ entra durante el LDIR, su PUSH PC iria al bank
  80+ 6A72                  ; de datos -> corrupcion del room data que estamos leyendo.
  81+ 6A72                  ;
  82+ 6A72                  ; Solucion: cambiar SP a un buffer alterno en slot 1 (siempre visible)
  83+ 6A72                  ; durante la copia. Asi las IRQs siguen procesandose normalmente y el
  84+ 6A72                  ; tick de musica no pierde frames durante DrawScreen / transiciones.
  85+ 6A72                  ;
  86+ 6A72                  ; INLINEAMOS el page-switch (sin CALL intermedios) porque al inicio el
  87+ 6A72                  ; SP aun apunta al stack normal con la PC del CALL pushed; un CALL aqui
  88+ 6A72                  ; usaria stack normal y no podriamos garantizar atomicidad.
  89+ 6A72 ED 73 C0 6A      LD (.lrbSavedSP), SP            ; salva SP normal (con PC + caller frame)
  90+ 6A76 31 CE 6B         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
  91+ 6A79                  ; --- Page bank 1 en slot 3 (inline, SIN DI) ---
  92+ 6A79 3A 85 8D         LD A, (CurrentPaging)
  93+ 6A7C E6 F8            AND $F8
  94+ 6A7E F6 01            OR 1
  95+ 6A80 32 85 8D         LD (CurrentPaging), A
  96+ 6A83 01 FD 7F         LD BC, $7FFD
  97+ 6A86 ED 79            OUT (C), A                      ; slot 3 = bank 1
  98+ 6A88                  ; --- Copy + decompress loop ---
  99+ 6A88                  ; HL = source (Room_Txx en bank 1, formato variable)
 100+ 6A88                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
 101+ 6A88 11 F8 85         LD DE, CurrentScreenBuffer
 102+ 6A8B              .lrbLoop:
 103+ 6A8B 7E               LD A, (HL)                      ; id
 104+ 6A8C 12               LD (DE), A
 105+ 6A8D 23               INC HL
 106+ 6A8E 13               INC DE
 107+ 6A8F FE FF            CP $FF                          ; terminador?
 108+ 6A91 28 1B            JR Z, .lrbDone
 109+ 6A93                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 110+ 6A93                  ; al buffer escribimos x limpio (AND $7F).
 111+ 6A93 7E               LD A, (HL)
 112+ 6A94 23               INC HL
 113+ 6A95 47               LD B, A                         ; B = x raw (con flag)
 114+ 6A96 E6 7F            AND $7F
 115+ 6A98 12               LD (DE), A                      ; buffer: x limpio 0-31
 116+ 6A99 13               INC DE
 117+ 6A9A                  ; Copiar y
 118+ 6A9A 7E               LD A, (HL)
 119+ 6A9B 12               LD (DE), A
 120+ 6A9C 23               INC HL
 121+ 6A9D 13               INC DE
 122+ 6A9E                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 123+ 6A9E CB 78            BIT 7, B
 124+ 6AA0 28 06            JR Z, .lrbNoTint
 125+ 6AA2 7E               LD A, (HL)                      ; v desde source
 126+ 6AA3 23               INC HL
 127+ 6AA4 12               LD (DE), A
 128+ 6AA5 13               INC DE
 129+ 6AA6 18 E3            JR .lrbLoop
 130+ 6AA8              .lrbNoTint:
 131+ 6AA8 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 132+ 6AAA 12               LD (DE), A
 133+ 6AAB 13               INC DE
 134+ 6AAC 18 DD            JR .lrbLoop
 135+ 6AAE              .lrbDone:
 136+ 6AAE                  ; --- Page bank 0 en slot 3 (inline) ---
 137+ 6AAE 3A 85 8D         LD A, (CurrentPaging)
 138+ 6AB1 E6 F8            AND $F8                         ; bank 0
 139+ 6AB3 32 85 8D         LD (CurrentPaging), A
 140+ 6AB6 01 FD 7F         LD BC, $7FFD
 141+ 6AB9 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack normal accesible
 142+ 6ABB ED 7B C0 6A      LD SP, (.lrbSavedSP)            ; restaurar SP al stack normal
