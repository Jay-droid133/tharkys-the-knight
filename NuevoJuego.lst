4857+ B9A5              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4858+ B9A5              ; ==============================================================================
4859+ B9A5              UpdateEnemySpeed:
4860+ B9A5 3A A7 BC         LD A, (DayCycleCount)
4861+ B9A8 3D               DEC A                               ; 0-based index
4862+ B9A9 FE 0A            CP 10
4863+ B9AB 38 02            JR C, .uesOk
4864+ B9AD 3E 09            LD A, 9                             ; Cap en indice 9
4865+ B9AF              .uesOk:
4866+ B9AF F5               PUSH AF                             ; Guardar indice para tabla de anim
4867+ B9B0 21 D3 B9         LD HL, EnemySpeedTable
4868+ B9B3 5F               LD E, A
4869+ B9B4 16 00            LD D, 0
4870+ B9B6 19               ADD HL, DE
4871+ B9B7 7E               LD A, (HL)                          ; A = velocidad × 2
4872+ B9B8                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4873+ B9B8 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4874+ B9BA 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4875+ B9BC                  ; Hay fraccion .5: alternar +1 en frames impares
4876+ B9BC 47               LD B, A                             ; B = parte entera
4877+ B9BD 3A 98 81         LD A, (GameFrameCounter)
4878+ B9C0 E6 01            AND 1                               ; 0 en par, 1 en impar
4879+ B9C2 80               ADD A, B                            ; Sumar 0 o 1
4880+ B9C3              .uesNoFrac:
4881+ B9C3 32 55 8D         LD (CurrentEnemySpeed), A
4882+ B9C6                  ; Leer delay de animacion para este ciclo
4883+ B9C6 F1               POP AF                              ; A = indice 0-based
4884+ B9C7 21 DD B9         LD HL, EnemyAnimDelayTable
4885+ B9CA 5F               LD E, A
4886+ B9CB 16 00            LD D, 0
4887+ B9CD 19               ADD HL, DE
4888+ B9CE 7E               LD A, (HL)
4889+ B9CF 32 56 8D         LD (CurrentEnemyAnimDelay), A
4890+ B9D2 C9               RET
4891+ B9D3
4892+ B9D3              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4893+ B9D3              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4894+ B9D3              EnemySpeedTable:
4895+ B9D3 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4896+ B9D4 05               DEFB 5                              ; Ciclo 2: 2.5px
4897+ B9D5 06               DEFB 6                              ; Ciclo 3: 3px
4898+ B9D6 07               DEFB 7                              ; Ciclo 4: 3.5px
4899+ B9D7 08               DEFB 8                              ; Ciclo 5: 4px
4900+ B9D8 09               DEFB 9                              ; Ciclo 6: 4.5px
4901+ B9D9 0A               DEFB 10                             ; Ciclo 7: 5px
4902+ B9DA 0B               DEFB 11                             ; Ciclo 8: 5.5px
4903+ B9DB 0C               DEFB 12                             ; Ciclo 9: 6px
4904+ B9DC 0E               DEFB 14                             ; Ciclo 10: 7px
4905+ B9DD
4906+ B9DD              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4907+ B9DD              ; La rata usara la mitad de estos valores
4908+ B9DD              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4909+ B9DD 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4910+ B9DE 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4911+ B9DF 03               DEFB 3                              ; Ciclo 3 (era 6)
4912+ B9E0 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4913+ B9E1 02               DEFB 2                              ; Ciclo 5 (era 4)
4914+ B9E2 02               DEFB 2                              ; Ciclo 6 (era 4)
4915+ B9E3 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4916+ B9E4 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4917+ B9E5 01               DEFB 1                              ; Ciclo 9 (era 2)
4918+ B9E6 01               DEFB 1                              ; Ciclo 10 (era 2)
