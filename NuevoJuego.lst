 152+ 9D5D E1               POP HL                      ; Restaurar inicio de linea
 153+ 9D5E 0D               DEC C
 154+ 9D5F C8               RET Z                       ; Terminamos todas las lineas
 155+ 9D60 CD AC 9D         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9D63 18 EC            JR .alignedLine
