  19+ 8D99              ; MaiComputeFlowField
  20+ 8D99              ; ==============================================================================
  21+ 8D99              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 8D99              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 8D99              ; quedan en $FF).
  24+ 8D99              ;
  25+ 8D99              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 8D99              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 8D99              ;
  28+ 8D99              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 8D99              ; Output: FlowField relleno en bank 6
  30+ 8D99              ; Destruye: AF, BC, DE, HL
  31+ 8D99              ; ==============================================================================
  32+ 8D99              MaiComputeFlowField:
  33+ 8D99                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 8D99 3A A1 81         LD A, (EntityTable + ENT_POSX)
  35+ 8D9C 0F               RRCA
  36+ 8D9D 0F               RRCA
  37+ 8D9E 0F               RRCA
  38+ 8D9F E6 1F            AND $1F
  39+ 8DA1 32 B4 97         LD (MaiFlowPlCx), A
  40+ 8DA4
  41+ 8DA4 3A A2 81         LD A, (EntityTable + ENT_POSY)
  42+ 8DA7 D6 10            SUB SCREEN_MIN_Y
  43+ 8DA9 0F               RRCA
  44+ 8DAA 0F               RRCA
  45+ 8DAB 0F               RRCA
  46+ 8DAC E6 1F            AND $1F
  47+ 8DAE 32 B5 97         LD (MaiFlowPlCy), A
  48+ 8DB1
  49+ 8DB1                  ; --- Swap a stack temporal (bank 2) ---
  50+ 8DB1 ED 73 BB 97      LD (MaiFlowSavedSP), SP
  51+ 8DB5 31 5B 98         LD SP, MaiTempStackTop
  52+ 8DB8
  53+ 8DB8                  ; --- Ventana de paginacion ---
  54+ 8DB8                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 8DB8 F3               DI
  56+ 8DB9 3A 85 8D         LD A, (CurrentPaging)
  57+ 8DBC E6 F8            AND $F8
  58+ 8DBE F6 06            OR 6
  59+ 8DC0 32 85 8D         LD (CurrentPaging), A
  60+ 8DC3 01 FD 7F         LD BC, $7FFD
  61+ 8DC6 ED 79            OUT (C), A
  62+ 8DC8
  63+ 8DC8                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 8DC8 CD E4 8D         CALL MaiFlowBfs
  65+ 8DCB
  66+ 8DCB                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 8DCB 3A 85 8D         LD A, (CurrentPaging)
  68+ 8DCE E6 F8            AND $F8
  69+ 8DD0 32 85 8D         LD (CurrentPaging), A
  70+ 8DD3 01 FD 7F         LD BC, $7FFD
  71+ 8DD6 ED 79            OUT (C), A
  72+ 8DD8
  73+ 8DD8 ED 7B BB 97      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 8DDC 3A 9D 81         LD A, (StartupComplete)
  75+ 8DDF B7               OR A
  76+ 8DE0 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 8DE2 FB               EI
  78+ 8DE3              .mcffNoEI:
  79+ 8DE3 C9               RET
