 240+ 99BF              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 241+ 99BF              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 242+ 99BF              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 243+ 99BF              ;
 244+ 99BF              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 245+ 99BF              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 246+ 99BF              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 247+ 99BF              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 248+ 99BF              StartMusic:
 249+ 99BF 32 E4 99         LD (MusicTrackArg), A
 250+ 99C2 F3               DI
 251+ 99C3 3A 87 8D         LD A, (CurrentPaging)
 252+ 99C6 E6 F8            AND $F8
 253+ 99C8 F6 04            OR 4
 254+ 99CA 32 87 8D         LD (CurrentPaging), A
 255+ 99CD 01 FD 7F         LD BC, $7FFD
 256+ 99D0 ED 79            OUT (C), A
 257+ 99D2 CD 82 E5         CALL StartMusicImpl
 258+ 99D5 3A 87 8D         LD A, (CurrentPaging)
 259+ 99D8 E6 F8            AND $F8
 260+ 99DA 32 87 8D         LD (CurrentPaging), A
 261+ 99DD 01 FD 7F         LD BC, $7FFD
 262+ 99E0 ED 79            OUT (C), A
 263+ 99E2 FB               EI
 264+ 99E3 C9               RET
 265+ 99E4
 266+ 99E4              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 267+ 99E4              ; desde el Impl en bank 4 sin trampa de paging.
 268+ 99E4 00           MusicTrackArg: DEFB 0
 269+ 99E5
 270+ 99E5              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 271+ 99E5              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 272+ 99E5              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 273+ 99E5              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 274+ 99E5              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 275+ 99E5              ; (bank 0/2) puedan leer/escribir sin paging.
 276+ 99E5 00           MusicSpeedShift: DEFB 0
 277+ 99E6
 278+ 99E6              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 279+ 99E6              ; transiciones de pantalla u otros frames lentos) ---
 280+ 99E6              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 281+ 99E6              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 282+ 99E6              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 283+ 99E6              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 284+ 99E6              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 285+ 99E6              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 286+ 99E6              ; tick daria 0, drift acumulando.
 287+ 99E6 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 288+ 99E7 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 289+ 99E8
