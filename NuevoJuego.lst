 192+ E5D4              ; ==============================================================================
 193+ E5D4              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 194+ E5D4              ; ==============================================================================
 195+ E5D4              DrawClockHUD:
 196+ E5D4                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 197+ E5D4                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 198+ E5D4                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 199+ E5D4                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 200+ E5D4                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 201+ E5D4 3A F4 81         LD A, (TimeFrozen)
 202+ E5D7 B7               OR A
 203+ E5D8 28 07            JR Z, .clkDrawNormal
 204+ E5DA 3A D9 80         LD A, (GameFrameCounter)
 205+ E5DD E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 206+ E5DF 28 2D            JR Z, .clkBlinkOff
 207+ E5E1              .clkDrawNormal:
 208+ E5E1 CD 1C E6         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 209+ E5E4
 210+ E5E4                  ; --- Aguja de horas ---
 211+ E5E4 3A DD E3         LD A, (GameHours)
 212+ E5E7 FE 0C            CP 12
 213+ E5E9 38 02            JR C, .hourOk
 214+ E5EB D6 0C            SUB 12
 215+ E5ED              .hourOk:
 216+ E5ED 21 D9 E4         LD HL, HourHandPtrs
 217+ E5F0 CD 03 E8         CALL DrawHandLine
 218+ E5F3
 219+ E5F3                  ; --- Aguja de minutos ---
 220+ E5F3 3A DC E3         LD A, (GameMinutes)
 221+ E5F6 06 00            LD B, 0
 222+ E5F8              .divMin:
 223+ E5F8 FE 05            CP 5
 224+ E5FA 38 05            JR C, .minOk
 225+ E5FC D6 05            SUB 5
 226+ E5FE 04               INC B
 227+ E5FF 18 F7            JR .divMin
 228+ E601              .minOk:
 229+ E601 78               LD A, B
 230+ E602 21 F5 E3         LD HL, MinHandPtrs
 231+ E605 CD 03 E8         CALL DrawHandLine
