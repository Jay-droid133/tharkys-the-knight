 129+ 9D02                  ; R2/R3 (canal B)
 130+ 9D02 5D               LD E, L
 131+ 9D03 3E 02            LD A, 2
 132+ 9D05 01 FD FF         LD BC, $FFFD
 133+ 9D08 ED 79            OUT (C), A
 134+ 9D0A 01 FD BF         LD BC, $BFFD
 135+ 9D0D ED 59            OUT (C), E
 136+ 9D0F 5C               LD E, H
 137+ 9D10 3E 03            LD A, 3
 138+ 9D12 01 FD FF         LD BC, $FFFD
 139+ 9D15 ED 79            OUT (C), A
 140+ 9D17 01 FD BF         LD BC, $BFFD
 141+ 9D1A ED 59            OUT (C), E
 142+ 9D1C                  ; R4/R5 (canal C)
 143+ 9D1C 5D               LD E, L
 144+ 9D1D 3E 04            LD A, 4
 145+ 9D1F 01 FD FF         LD BC, $FFFD
 146+ 9D22 ED 79            OUT (C), A
 147+ 9D24 01 FD BF         LD BC, $BFFD
 148+ 9D27 ED 59            OUT (C), E
 149+ 9D29 5C               LD E, H
