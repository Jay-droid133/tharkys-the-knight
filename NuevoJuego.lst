5844+ BF2F 3D               DEC A
5845+ BF30 77               LD (HL), A
5846+ BF31 C2 01 C0         JP NZ, .rmRtNext
5847+ BF34                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5848+ BF34                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5849+ BF34                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5850+ BF34                  ; Calcular target coord: axis variable segun borde de salida.
5851+ BF34                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5852+ BF34 DD 7E 0A         LD A, (IX+ENT_DIR)
5853+ BF37 FE 01            CP DIR_N
5854+ BF39 28 11            JR Z, .rmRtSideN
5855+ BF3B FE 02            CP DIR_S
5856+ BF3D 28 1C            JR Z, .rmRtSideS
