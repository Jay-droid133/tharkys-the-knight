 485+ 93EE              ; MaiPickRandomGap
 486+ 93EE              ; ==============================================================================
 487+ 93EE              ; Selecciona un opening aleatorio del screen actual (ScreenGaps en bank 6) y
 488+ 93EE              ; traduce (side, coord) a posicion pixel con MAI_ENTRY_OFFSET aplicado.
 489+ 93EE              ;
 490+ 93EE              ; Output:
 491+ 93EE              ;   A = 0 exito; (MaiSpawnX), (MaiSpawnY) contienen posicion spawn
 492+ 93EE              ;   A = 1 no hay gaps validos; el caller debe usar fallback (LastEntryPos)
 493+ 93EE              ; Destruye: AF, BC, DE, HL
 494+ 93EE              ; ==============================================================================
 495+ 93EE              MaiPickRandomGap:
 496+ 93EE                  ; screen_id = Y * 16 + X
 497+ 93EE 3A 56 82         LD A, (CurrentScreenY)
 498+ 93F1 07               RLCA
 499+ 93F2 07               RLCA
 500+ 93F3 07               RLCA
 501+ 93F4 07               RLCA
