 219+ 9DF8              ; Variables locales de DrawSprite
 220+ 9DF8 00           .posX:       DEFB 0
 221+ 9DF9 00           .posY:       DEFB 0
 222+ 9DFA 00           .widthSave:  DEFB 0
 223+ 9DFB 00           .heightSave: DEFB 0
 224+ 9DFC 00           .tablePage:  DEFB 0
 225+ 9DFD 00           .widthCount: DEFB 0
