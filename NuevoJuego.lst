 194+ F82C
 195+ F82C              ; --- SFX_CountdownTick: bip ~700ms para "3" y "2" del countdown ---
 196+ F82C              ; Pitch 102 = ~1047 Hz. Calibrado para octava precisa con pitch 50 (ratio 1.992).
 197+ F82C              ; (PlaySFX tiene ~78T de overhead por ciclo ademas de 32*pitch -> ratio puro
 198+ F82C              ; 100/50 quedaria desafinado ~30 cents. Compensado a 102 da ~7 cents.)
 199+ F82C              SFX_CountdownTick:
 200+ F82C FA 66 00 00      DEFB 250, 102, 0, 0         ; ~239ms
 201+ F830 FA 66 00 00      DEFB 250, 102, 0, 0         ; ~478ms
 202+ F834 E6 66 00 00      DEFB 230, 102, 0, 0         ; ~219ms (total ~718ms)
 203+ F838 00               DEFB 0
 204+ F839
 205+ F839              ; --- SFX_CountdownGo: octava arriba del Tick, ~1s ---
 206+ F839              ; Pitch 50 = ~2086 Hz. Ratio period(102)/period(50) = 3342/1678 = 1.992.
 207+ F839              SFX_CountdownGo:
 208+ F839 FA 32 00 00      DEFB 250, 50, 0, 0          ; ~120ms cada step
 209+ F83D FA 32 00 00      DEFB 250, 50, 0, 0
 210+ F841 FA 32 00 00      DEFB 250, 50, 0, 0
 211+ F845 FA 32 00 00      DEFB 250, 50, 0, 0
 212+ F849 FA 32 00 00      DEFB 250, 50, 0, 0
 213+ F84D FA 32 00 00      DEFB 250, 50, 0, 0
 214+ F851 FA 32 00 00      DEFB 250, 50, 0, 0
 215+ F855 FA 32 00 00      DEFB 250, 50, 0, 0
 216+ F859 5A 32 00 00      DEFB 90, 50, 0, 0           ; total ~1003ms
 217+ F85D 00               DEFB 0
 218+ F85E
 219+ F85E              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 220+ F85E              ; Tono grave resonante con decay lento, como campana de iglesia
 221+ F85E              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 222+ F85E              SFX_BellChime:
 223+ F85E FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 224+ F862 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 225+ F866 00               DEFB 0                      ; fin
 226+ F867
 227+ F867              ; --- SFX_ChurchDoorOpen: "click + creak" puerta de iglesia (~300ms) ---
 228+ F867              ; Click corto inicial (cerrojo), luego crujido lento ascendente (madera vieja
 229+ F867              ; girando con esfuerzo). Valores iniciales — afinar en el emulador.
 230+ F867              SFX_ChurchDoorOpen:
 231+ F867 0C 32 00 01      DEFB 12,  50,  0, 1          ; click: 12 iter ruido pitch 50
 232+ F86B 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 233+ F86F 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 234+ F873 00               DEFB  0                       ; fin
 235+ F874
 236+ F874              ; --- SFX_DoorClose: "chof" sordo de puerta cerrandose (~120ms) ---
 237+ F874              ; Compartido por: bank cutscene HAND_OPEN_IN (cierre tras cobro), bank
 238+ F874              ; HAND_OUT (cierre final), church cutscene CloseChurchDoor.
 239+ F874              ;
 240+ F874              ; Caracter: thud blando, no metalico. Burst de noise denso (textura rugosa)
 241+ F874              ; seguido de un rumble grave muy breve. Distinto del creak (SFX_ChurchDoorOpen)
 242+ F874              ; — la puerta ABRE con creak (madera girando) y CIERRA con chof (impacto contra
 243+ F874              ; el marco).
 244+ F874              ;
 245+ F874              ; pitch=0 en noise mode -> delay = (R AND $1F) | 1 -> rango completo 1-31
 246+ F874              ; (textura densa). Distinto a pitch=18 (= AND $1F) del SFX_ChurchDoorOpen
 247+ F874              ; click, que sesgaba mas agudo.
 248+ F874              SFX_DoorClose:
 249+ F874 23 00 00 01      DEFB 35,   0,  0, 1          ; chof: noise denso 35 iter (impacto contundente)
 250+ F878 19 F0 00 00      DEFB 25, 240,  0, 0          ; rumble grave sostenido: pitch 240, sweep 0 (sin decay,
 251+ F87C                                               ; rumble plano = peso maximo). Si demasiado largo,
 252+ F87C                                               ; bajar duracion (25 -> 20 / 15).
 253+ F87C 00               DEFB  0                       ; fin
 254+ F87D
 255+ F87D              ; --- SFX_BlockedExit: "BUZZ - BUZZ - BUZZ" triple tono profundo (~500 ticks) ---
 256+ F87D              ; Disparado cuando el jugador intenta salir de la iglesia hacia el sur
 257+ F87D              ; mientras el reloj esta congelado (fase de captura). Tres tonos cuadrados
 258+ F87D              ; muy graves separados por breves pausas para sugerir "no, no, no" como
 259+ F87D              ; un buzzer triple de concurso televisivo.
 260+ F87D              ;
 261+ F87D              ; En modo noise el pitch real esta limitado a 0-31 por AND $1F, por eso
 262+ F87D              ; usamos modo tono (noise=0) con pitch alto: el delay loop usa C
 263+ F87D              ; directamente, asi que pitch=220 da un periodo mucho mas largo (~7x mas
 264+ F87D              ; profundo que el max del modo noise).
 265+ F87D              SFX_BlockedExit:
 266+ F87D                  ; "Contraseña incorrecta" estilo pelicula: dos pulsos cortos harsh
 267+ F87D                  ; con noise (texture digital "BRRRT-BRRRT" tipo "ACCESS DENIED").
 268+ F87D                  ; Cada burst se hace con dos phases consecutivas porque cada phase
 269+ F87D                  ; en modo noise tiene duracion real corta (iter ~80us a pitch=8).
 270+ F87D FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1a: noise harsh
 271+ F881 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1b: continua
 272+ F885 50 28 00 00      DEFB  80, 40, 0, 0          ; gap tonal audible para separacion
 273+ F889 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2a
 274+ F88D FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2b
 275+ F891 00               DEFB   0                    ; fin
 276+ F892
 277+ F892              ; --- SFX_NoSwordError: "BRRT" corto, ruido grave (~150 ticks). Disparado
 278+ F892              ; cuando el jugador pulsa fire con la seta activa (mushroom bloquea ataque).
 279+ F892              ;
 280+ F892              ; Modo noise (flag=1) puro: el delay del toggle es (R XOR C) AND $1F | 1.
 281+ F892              ; pitch=0 deja el random "limpio" sin sesgar bits altos hacia delays cortos
 282+ F892              ; (probar pitch=20 hizo que el bit 4 quedara seteado a menudo via XOR,
 283+ F892              ; reduciendo delays => sonaba mas agudo). Con pitch=0 el patron usa todo
 284+ F892              ; el rango 1-31 segun R, dando textura mas densa/rugosa.
 285+ F892              ;
 286+ F892              ; Duration 150 (vs 120 antes) sostiene el ruido un poco mas: a la oreja
 287+ F892              ; se percibe como "mas cuerpo" sin pasar a beep tonal.
 288+ F892              SFX_NoSwordError:
 289+ F892 96 00 00 01      DEFB 150, 0, 0, 1           ; noise puro, pitch 0, duration mayor
 290+ F896 00               DEFB   0                    ; fin
 291+ F897
 292+ F897              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 293+ F897              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 294+ F897              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 295+ F897              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 296+ F897              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 297+ F897              SFX_KeyDrop:
 298+ F897 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 299+ F89B 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 300+ F89F 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 301+ F8A3 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 302+ F8A7 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 303+ F8AB 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 304+ F8AF 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 305+ F8B3 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 306+ F8B7 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 307+ F8BB 00               DEFB   0                       ; fin
 308+ F8BC
 309+ F8BC              ; --- Sistema de campanadas con pausa entre ellas ---
 310+ F8BC              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 311+ F8BC              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 312+ F8BC              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 313+ F8BC 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 314+ F8BD 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 315+ F8BF              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 316+ F8BF              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 317+ F8BF
 318+ F8BF              ; --- Cadena de eventos tras la ultima campanada ---
 319+ F8BF              ; last chime → (delay) → windows off → (delay) → monster spawn
 320+ F8BF              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 321+ F8BF              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 322+ F8BF 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 323+ F8C0 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 324+ F8C1
 325+ F8C1              ; ==============================================================================
 326+ F8C1              ; StartBellChimes - Inicia secuencia de 12 campanadas
 327+ F8C1              ; ==============================================================================
 328+ F8C1              StartBellChimes:
 329+ F8C1                  ; Silenciar musica activa (death o cualquier otra). Bell escribe R7 (mixer
 330+ F8C1                  ; all-on), R0-R5 (period A/B/C) y R8-R10 (vols), clobbeando lo que la musica
 331+ F8C1                  ; mantenga en canal B. Mejor parar limpiamente que oir glitches.
 332+ F8C1 F5               PUSH AF
 333+ F8C2 3E FF            LD A, $FF
 334+ F8C4 CD BA 99         CALL StartMusic
 335+ F8C7 F1               POP AF
 336+ F8C8 3E 0C            LD A, 12                            ; 12 campanadas (medianoche)
 337+ F8CA 32 BC F8         LD (BellCount), A
 338+ F8CD                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 339+ F8CD 2A 78 5C         LD HL, (SYS_FRAMES)
 340+ F8D0 22 BD F8         LD (BellNextFrame), HL
 341+ F8D3 3E 7D            LD A, SCARE_TIMER_BELLS
 342+ F8D5 32 EE B5         LD (ScareTimer), A
 343+ F8D8 C9               RET
 344+ F8D9
 345+ F8D9              ; ==============================================================================
 346+ F8D9              ; UpdateBellChimes - Llamar cada frame desde el main loop
 347+ F8D9              ; ==============================================================================
 348+ F8D9              UpdateBellChimes:
 349+ F8D9 3A BC F8         LD A, (BellCount)
 350+ F8DC B7               OR A
 351+ F8DD C8               RET Z                       ; sin campanadas pendientes
 352+ F8DE
 353+ F8DE                  ; Comparar FRAMES actual con BellNextFrame
 354+ F8DE 2A 78 5C         LD HL, (SYS_FRAMES)
 355+ F8E1 ED 5B BD F8      LD DE, (BellNextFrame)
 356+ F8E5 B7               OR A
 357+ F8E6 ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 358+ F8E8 D8               RET C                       ; FRAMES < deadline → aun no toca
 359+ F8E9
 360+ F8E9                  ; Sonar campanada (AY, no bloquea CPU)
 361+ F8E9 C5               PUSH BC
 362+ F8EA D5               PUSH DE
 363+ F8EB CD D0 98         CALL AY_PlayBellChime
 364+ F8EE D1               POP DE
 365+ F8EF C1               POP BC
 366+ F8F0
 367+ F8F0                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 368+ F8F0                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 369+ F8F0 2A 78 5C         LD HL, (SYS_FRAMES)
 370+ F8F3 11 4B 00         LD DE, BELL_PAUSE
 371+ F8F6 19               ADD HL, DE
 372+ F8F7 22 BD F8         LD (BellNextFrame), HL
 373+ F8FA
 374+ F8FA 21 BC F8         LD HL, BellCount
 375+ F8FD 35               DEC (HL)
 376+ F8FE C0               RET NZ
 377+ F8FF 18 00            JR .bellsDone
 378+ F901
 379+ F901              .bellsDone:
 380+ F901                  ; Ultima campanada:
 381+ F901                  ;   1) matar todos los nasties vivos (puff)
 382+ F901                  ;   2) arrancar cadena diferida: windows off → monster spawn
 383+ F901 CD 2D BA         CALL KillAllActiveNasties
 384+ F904 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 385+ F906 32 BF F8         LD (BellsDoneTimer), A
 386+ F909 C9               RET
 387+ F90A
 388+ F90A              ; ==============================================================================
 389+ F90A              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 390+ F90A              ; ==============================================================================
 391+ F90A              ; Maneja la cadena diferida tras la ultima campanada:
 392+ F90A              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 393+ F90A              ;      y arranca SpawnAfterWinTimer
 394+ F90A              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 395+ F90A              ; ==============================================================================
 396+ F90A              UpdateBellsDoneTimer:
 397+ F90A 3A BF F8         LD A, (BellsDoneTimer)
 398+ F90D B7               OR A
 399+ F90E 28 21            JR Z, .ubdCheckSpawn
 400+ F910 3D               DEC A
 401+ F911 32 BF F8         LD (BellsDoneTimer), A
 402+ F914 20 1B            JR NZ, .ubdCheckSpawn
 403+ F916                  ; Llego a 0: apagar ventanas
 404+ F916 CD 3D E3         CALL UpdateRemapTables
 405+ F919 3E 01            LD A, 1
 406+ F91B 32 11 83         LD (AttrsDirty), A
 407+ F91E                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 408+ F91E                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 409+ F91E                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 410+ F91E                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 411+ F91E 3A B1 82         LD A, (ChurchDoorOpen)
 412+ F921 B7               OR A
 413+ F922 28 03            JR Z, .ubdSkipHighlight
 414+ F924 CD FC F2         CALL StartStatueBlink
 415+ F927              .ubdSkipHighlight:
 416+ F927                  ; Armar el gating: SpawnAfterWinTimer = 1 = "esperando a que Tension
 417+ F927                  ; termine para spawnear". El check real esta en .ubdCheckSpawn (mira
 418+ F927                  ; MusicTimer del driver tabular). Cuando Tension acaba (MusicTimer
 419+ F927                  ; pasa a 0), dispara SpawnMonsters. Asi el primer monster aparece
 420+ F927                  ; tras Tension + el natural ~0.8s de MONSTER_ENTRY_BASE -> "calma
 421+ F927                  ; antes de la tormenta".
 422+ F927 3E 01            LD A, 1
 423+ F929 32 C0 F8         LD (SpawnAfterWinTimer), A
 424+ F92C                  ; Musica de tension organica entre lights-off y monster spawn (track 0)
 425+ F92C AF               XOR A                           ; A = 0 = MUSIC_TENSION
 426+ F92D CD BA 99         CALL StartMusic
 427+ F930 C9               RET
 428+ F931              .ubdCheckSpawn:
 429+ F931 3A C0 F8         LD A, (SpawnAfterWinTimer)
 430+ F934 B7               OR A
 431+ F935 C8               RET Z                           ; no armado (boot, ya disparado, etc.)
 432+ F936                  ; Gating dinamico: esperar a que MusicTimer del driver tabular llegue
 433+ F936                  ; a 0. Indica que Tension (la musica activa) acaba de terminar (su
 434+ F936                  ; ultima nota se cumplio y MusicEndOfTable.meotStop puso Timer=0).
 435+ F936                  ; Robusto a cambios de duracion en TensionMusicTable.
 436+ F936 3A A8 7B         LD A, (MusicTimer)
 437+ F939 B7               OR A
 438+ F93A C0               RET NZ                          ; Tension aun sonando
 439+ F93B                  ; Tension acabo: rearmar y disparar spawn.
 440+ F93B AF               XOR A
 441+ F93C 32 C0 F8         LD (SpawnAfterWinTimer), A
 442+ F93F C3 4C BD         JP SpawnMonsters
 443+ F942
 444+ F942              ; ==============================================================================
 445+ F942              ; MonstersMusic - Secuencer ad-hoc para una nota grave repetida
 446+ F942              ; ==============================================================================
 447+ F942              ; Ritmo "po-po-popo-po": 5 hits con gaps definidos en MonstersBeatGaps. Cada
 448+ F942              ; hit dispara AY_PlayBeep(period=$0688 ~C2, dur=4f) en canal B AY (~160ms).
 449+ F942              ; Loopable. Arrancado desde SpawnMonsters (StartMonstersMusic). Detenido al
 450+ F942              ; sunrise (StopMonstersMusic).
 451+ F942              ;
 452+ F942              ; NO usa el driver tabular ni reserva nada en slot 1 — el patron es puro
 453+ F942              ; codigo. Variables (Timer + Step) viven al final de esta rutina (bank 0).
 454+ F942              ;
 455+ F942              ; Para iterar: ajustar MonstersBeatGaps (frames entre hits) o el period en
 456+ F942              ; UpdateMonstersMusic (LD HL, $0688) para cambiar el tono.
 457+ F942              ; ==============================================================================
 458+ F942
 459+ F942              ; --- StartMonstersMusic: arranca el secuencer ---
 460+ F942              ; Se llama desde SpawnMonsters una vez por noche. Setea Step=0 + Timer=1
 461+ F942              ; para que el primer hit suene en el frame siguiente.
 462+ F942              StartMonstersMusic:
 463+ F942 AF               XOR A
 464+ F943 32 80 F9         LD (MonstersMusicStep), A       ; Step = 0 → primer hit
 465+ F946 3C               INC A
 466+ F947 32 7F F9         LD (MonstersMusicTimer), A      ; Timer = 1 → suena ya en proximo update
 467+ F94A C9               RET
 468+ F94B
 469+ F94B              ; --- StopMonstersMusic: detiene el secuencer ---
 470+ F94B              ; Se llama al sunrise (day_cycle.asm fase 5). Step=$FF actua como sentinel
 471+ F94B              ; "inactivo" en UpdateMonstersMusic (INC A → 0 → RET Z).
 472+ F94B              StopMonstersMusic:
 473+ F94B 3E FF            LD A, $FF
 474+ F94D 32 80 F9         LD (MonstersMusicStep), A
 475+ F950 C9               RET
 476+ F951
 477+ F951              ; --- UpdateMonstersMusic: tick por frame desde MainLoop ---
 478+ F951              ; Si activo, decrementa Timer; cuando llega a 0, dispara AY_PlayBeep y
 479+ F951              ; avanza Step (con wrap a 0 al pasar de 4). Si Step=$FF, no-op.
 480+ F951              UpdateMonstersMusic:
 481+ F951 3A 80 F9         LD A, (MonstersMusicStep)
 482+ F954 3C               INC A
 483+ F955 C8               RET Z                           ; $FF + INC = 0 → inactivo
 484+ F956 3D               DEC A                           ; restaurar Step real
 485+ F957 21 7F F9         LD HL, MonstersMusicTimer
 486+ F95A 35               DEC (HL)
 487+ F95B C0               RET NZ                          ; aun esperando proximo hit
 488+ F95C                  ; Hora del proximo "po": leer gap[Step] -> Timer
 489+ F95C 21 7A F9         LD HL, MonstersBeatGaps
 490+ F95F 5F               LD E, A
 491+ F960 16 00            LD D, 0
 492+ F962 19               ADD HL, DE
 493+ F963 7E               LD A, (HL)
 494+ F964 32 7F F9         LD (MonstersMusicTimer), A
 495+ F967                  ; Avanzar Step con wrap a 0 al llegar a 5
 496+ F967 21 80 F9         LD HL, MonstersMusicStep
 497+ F96A 34               INC (HL)
 498+ F96B 7E               LD A, (HL)
 499+ F96C FE 05            CP 5
 500+ F96E 38 02            JR C, .ummDoBeep
 501+ F970 AF               XOR A
 502+ F971 77               LD (HL), A                      ; wrap: Step=0 → vuelve al inicio del patron
 503+ F972              .ummDoBeep:
 504+ F972 21 88 06         LD HL, $0688                    ; period AY canal B (~C2 = 65 Hz, grave)
 505+ F975 06 03            LD B, 3                         ; cutoff a 3 frames (~120ms) -> "po" staccato medio
 506+ F977 C3 CA 6F         JP AY_PlayBeep                  ; tail-call
 507+ F97A
 508+ F97A              ; --- Datos del patron "po-po-popo-po" ---
 509+ F97A              ; Frames entre hits consecutivos. Total = 12+12+4+8+26 = 62 frames = ~2.48s/loop.
 510+ F97A              ; Beat 1: po (gap 12 hasta beat 2)
 511+ F97A              ; Beat 2: po (gap 12 hasta beat 3.0)
 512+ F97A              ; Beat 3.0: po (gap 4 hasta beat 3.5 = corchea)
 513+ F97A              ; Beat 3.5: po (gap 8 hasta beat 4)
 514+ F97A              ; Beat 4: po (gap 26 hasta beat 1 = loop — pausa larga al final)
 515+ F97A              MonstersBeatGaps:
 516+ F97A 0C 0C 04 08      DEFB 12, 12, 4, 8, 26
 516+ F97E 1A
 517+ F97F
 518+ F97F 00           MonstersMusicTimer: DEFB 0
 519+ F980 FF           MonstersMusicStep:  DEFB $FF             ; $FF = inactivo (sentinel)
 520+ F981
# file closed: sound.asm
