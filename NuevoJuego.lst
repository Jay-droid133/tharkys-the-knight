 845+ D1ED                  ; ===================== PATH RLE =====================
 846+ D1ED                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 847+ D1ED                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 848+ D1ED                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 849+ D1ED                  ; El estado .rlePending conserva el chunk entre filas:
 850+ D1ED                  ;   0 = necesita nuevo token
 851+ D1ED                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 852+ D1ED                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 853+ D1ED              .rlePixRow:
 854+ D1ED 3A 98 D2         LD A, (.widthVal)
 855+ D1F0 47               LD B, A
 856+ D1F1 E5               PUSH HL                     ; guardar inicio de fila VRAM
 857+ D1F2
 858+ D1F2              .rlePixCol:
 859+ D1F2 3A 9C D2         LD A, (.rlePending)
 860+ D1F5 B7               OR A
 861+ D1F6 CA 0D D2         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 862+ D1F9 FA 1B D2         JP M, .rleLitEmit           ; <0 = literal group en curso
 863+ D1FC                  ; >0 = run en curso, emitir valor
 864+ D1FC              .rleRunEmit:
 865+ D1FC 3A 9D D2         LD A, (.rleValue)
 866+ D1FF 2F               CPL
 867+ D200 77               LD (HL), A
 868+ D201 23               INC HL
 869+ D202 3A 9C D2         LD A, (.rlePending)
 870+ D205 3D               DEC A
 871+ D206 32 9C D2         LD (.rlePending), A
 872+ D209 10 E7            DJNZ .rlePixCol
 873+ D20B 18 32            JR .rleRowDone
 874+ D20D
 875+ D20D              .rleNewToken:
 876+ D20D DD 7E 00         LD A, (IX+0)
 877+ D210 DD 23            INC IX
 878+ D212 CB 7F            BIT 7, A
 879+ D214 20 18            JR NZ, .rleNewRun
 880+ D216                  ; --- Literal group: A = count (1-127) ---
 881+ D216 ED 44            NEG                         ; A = -count (negativo)
 882+ D218 32 9C D2         LD (.rlePending), A
 883+ D21B                  ; fall through: emitir primer byte literal
 884+ D21B
 885+ D21B              .rleLitEmit:
 886+ D21B DD 7E 00         LD A, (IX+0)
 887+ D21E DD 23            INC IX
 888+ D220 2F               CPL
 889+ D221 77               LD (HL), A
 890+ D222 23               INC HL
 891+ D223 3A 9C D2         LD A, (.rlePending)
 892+ D226 3C               INC A                       ; hacia 0
 893+ D227 32 9C D2         LD (.rlePending), A
 894+ D22A 10 C6            DJNZ .rlePixCol
 895+ D22C 18 11            JR .rleRowDone
 896+ D22E
 897+ D22E                  ; --- Run: count = (A & $7F) + 2 ---
 898+ D22E              .rleNewRun:
 899+ D22E E6 7F            AND $7F
 900+ D230 C6 02            ADD A, 2
 901+ D232 32 9C D2         LD (.rlePending), A
 902+ D235 DD 7E 00         LD A, (IX+0)
 903+ D238 DD 23            INC IX
 904+ D23A 32 9D D2         LD (.rleValue), A
 905+ D23D 18 BD            JR .rleRunEmit
 906+ D23F
 907+ D23F              .rleRowDone:
 908+ D23F E1               POP HL                      ; restaurar inicio fila
 909+ D240 3A 97 D2         LD A, (.heightCnt)
 910+ D243 3D               DEC A
 911+ D244 32 97 D2         LD (.heightCnt), A
 912+ D247 28 05            JR Z, .pixDone
 913+ D249 CD C8 9A         CALL NextPixelLine
 914+ D24C 18 9F            JR .rlePixRow
