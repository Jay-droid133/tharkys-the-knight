7328+ CB79 23               INC HL
7329+ CB7A 22 6D 5F         LD (DBfsQTail), HL
7330+ CB7D                  ; --- Score: max depth tie-break min manhattan ---
7331+ CB7D                  ; manhattan = |tryCx - playerCx| + |tryCy - playerCy|
7332+ CB7D 3A 78 5F         LD A, (DBfsTryCx)
7333+ CB80 57               LD D, A
7334+ CB81 3A 72 5F         LD A, (DBfsPlayerCx)
7335+ CB84 92               SUB D
7336+ CB85 30 02            JR NC, .nbrAbsX
7337+ CB87 ED 44            NEG
7338+ CB89              .nbrAbsX:
7339+ CB89 57               LD D, A
7340+ CB8A 3A 79 5F         LD A, (DBfsTryCy)
7341+ CB8D 5F               LD E, A
7342+ CB8E 3A 73 5F         LD A, (DBfsPlayerCy)
7343+ CB91 93               SUB E
7344+ CB92 30 02            JR NC, .nbrAbsY
7345+ CB94 ED 44            NEG
7346+ CB96              .nbrAbsY:
7347+ CB96 82               ADD A, D                            ; A = manhattan
7348+ CB97 57               LD D, A
7349+ CB98                  ; Compare: depth > best ? update : (depth == best && manh < bestManh ? update : skip)
7350+ CB98 79               LD A, C
7351+ CB99 21 70 5F         LD HL, DBfsBestDepth
7352+ CB9C BE               CP (HL)
7353+ CB9D 38 15            JR C, .nbrNoBest
7354+ CB9F 20 07            JR NZ, .nbrUpdate                   ; depth > bestDepth
7355+ CBA1 7A               LD A, D
7356+ CBA2 21 71 5F         LD HL, DBfsBestManh
7357+ CBA5 BE               CP (HL)
7358+ CBA6 30 0C            JR NC, .nbrNoBest                   ; manh >= best
7359+ CBA8              .nbrUpdate:
7360+ CBA8 79               LD A, C
7361+ CBA9 32 70 5F         LD (DBfsBestDepth), A
7362+ CBAC 7A               LD A, D
7363+ CBAD 32 71 5F         LD (DBfsBestManh), A
7364+ CBB0 78               LD A, B
7365+ CBB1 32 6F 5F         LD (DBfsBestDir), A
7366+ CBB4              .nbrNoBest:
7367+ CBB4 C9               RET
7368+ CBB5
7369+ CBB5              ; --- bfsIsVisited: scan queue [Queue, QTail). Z=no visited, NZ=visited ---
7370+ CBB5              .bfsIsVisited:
7371+ CBB5 21 FF 5E         LD HL, DBfsQueue
7372+ CBB8 ED 5B 6D 5F      LD DE, (DBfsQTail)
7373+ CBBC              .bivLoop:
7374+ CBBC                  ; HL == DE -> end
7375+ CBBC E5               PUSH HL
7376+ CBBD B7               OR A
7377+ CBBE ED 52            SBC HL, DE
7378+ CBC0 E1               POP HL
7379+ CBC1 28 1F            JR Z, .bivNotFound
7380+ CBC3 7E               LD A, (HL)
7381+ CBC4 47               LD B, A
7382+ CBC5 23               INC HL
7383+ CBC6 7E               LD A, (HL)
7384+ CBC7 4F               LD C, A
7385+ CBC8 2B               DEC HL
7386+ CBC9 3A 78 5F         LD A, (DBfsTryCx)
7387+ CBCC B8               CP B
7388+ CBCD 20 0A            JR NZ, .bivNext
7389+ CBCF 3A 79 5F         LD A, (DBfsTryCy)
7390+ CBD2 B9               CP C
7391+ CBD3 20 04            JR NZ, .bivNext
7392+ CBD5                  ; Match
7393+ CBD5 3E 01            LD A, 1
7394+ CBD7 B7               OR A                                ; NZ
7395+ CBD8 C9               RET
7396+ CBD9              .bivNext:
7397+ CBD9 3E 04            LD A, 4
7398+ CBDB 85               ADD A, L
7399+ CBDC 6F               LD L, A
7400+ CBDD 30 DD            JR NC, .bivLoop
7401+ CBDF 24               INC H
7402+ CBE0 18 DA            JR .bivLoop
7403+ CBE2              .bivNotFound:
7404+ CBE2 AF               XOR A                               ; Z
7405+ CBE3 C9               RET
