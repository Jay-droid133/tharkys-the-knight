7564+ C93B              ; ==============================================================================
7565+ C93B              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7566+ C93B              ; ==============================================================================
7567+ C93B              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7568+ C93B              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7569+ C93B              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7570+ C93B              ; ==============================================================================
7571+ C93B              ; ==============================================================================
7572+ C93B              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7573+ C93B              ; ==============================================================================
7574+ C93B              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7575+ C93B              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7576+ C93B              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7577+ C93B              ; los pone a su default.
7578+ C93B              ; ==============================================================================
7579+ C93B              InitGameState:
7580+ C93B 3E 03            LD A, PLAYER_LIVES_INIT
7581+ C93D 32 DE 82         LD (PlayerLives), A
7582+ C940 3E 10            LD A, HEALTH_MAX
7583+ C942 32 52 B3         LD (PlayerHealth), A
7584+ C945 3E 10            LD A, STAMINA_MAX
7585+ C947 32 53 B3         LD (PlayerStamina), A
7586+ C94A AF               XOR A
7587+ C94B 32 DF 82         LD (GameOver), A
7588+ C94E 32 B7 82         LD (CurrentObjective), A
7589+ C951 32 AE 82         LD (CurrentKey), A
7590+ C954 32 B2 82         LD (ChurchEverOpened), A
7591+ C957 32 B1 82         LD (ChurchDoorOpen), A
7592+ C95A 32 B3 82         LD (TimeFrozen), A
7593+ C95D 32 B0 82         LD (ChurchKeySpawned), A
7594+ C960 32 C2 82         LD (TownGateKeySpawned), A
7595+ C963 32 D0 82         LD (ArmRevealed), A
7596+ C966 32 D1 82         LD (FingerRevealed), A
7597+ C969 32 58 B3         LD (MonstersActive), A
7598+ C96C 32 BE 82         LD (MonsterTrappedFlags), A
7599+ C96F 32 FA 82         LD (DeathSpawned), A
7600+ C972 32 C8 82         LD (TownGatePhase), A
7601+ C975 32 C6 82         LD (ChurchCutscenePhase), A
7602+ C978 32 D0 E2         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7603+ C97B 32 B6 82         LD (BellsTriggered), A
7604+ C97E 32 BF 82         LD (NextChurchTrapStep), A
7605+ C981 32 C0 82         LD (StatueBlinkCounter), A
7606+ C984 32 C1 82         LD (ChurchKeyAltSpawnIdx), A
7607+ C987 32 F4 C4         LD (PlayerHitTimer), A
7608+ C98A 32 F3 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7609+ C98D 32 F4 82         LD (TombDrawPending), A
7610+ C990 32 E7 82         LD (DeathBorderPhase), A
7611+ C993 32 E8 82         LD (DeathBorderTimer), A
7612+ C996 32 E9 82         LD (PlayerDeathAnimTimer), A
7613+ C999 32 EA 82         LD (PlayerDeathAnimFrame), A
7614+ C99C 32 EB 82         LD (PlayerRespawnPhase), A
7615+ C99F 32 EC 82         LD (PlayerRespawnTimer), A
7616+ C9A2 32 ED 82         LD (PlayerRespawnBlinkTimer), A
7617+ C9A5 32 EF 82         LD (PlayerRespawnBeatIdx), A
7618+ C9A8 32 E0 82         LD (GameOverAnimX), A
7619+ C9AB 32 E1 82         LD (GameOverAnimDir), A
7620+ C9AE 32 E2 82         LD (GameOverAnimFrame), A
7621+ C9B1 32 E3 82         LD (GameOverAnimFrameTimer), A
7622+ C9B4 32 E6 82         LD (GameOverAnimLastX), A
7623+ C9B7 21 00 00         LD HL, 0
7624+ C9BA 22 E4 82         LD (GameOverAnimLastSpr), HL
7625+ C9BD 22 F7 82         LD (DeathScreenTimer), HL           ; 16-bit reset
7626+ C9C0 3E 01            LD A, 1
7627+ C9C2 32 EE 82         LD (PlayerRespawnVisible), A
7628+ C9C5 3E 00            LD A, BLACK
7629+ C9C7 32 83 8D         LD (CurrentBorderColor), A
7630+ C9CA D3 FE            OUT (254), A
7631+ C9CC 3E 01            LD A, 1
7632+ C9CE 32 ED BC         LD (DayCycleCount), A
7633+ C9D1 21 D1 BC         LD HL, DiurnalTypeTable
7634+ C9D4 22 EE BC         LD (CurrentNastyTable), HL
7635+ C9D7                  ; Reset speed + buff (en caso de restart con buff activo).
7636+ C9D7 3E 04            LD A, SPEED_RUN
7637+ C9D9 32 D5 82         LD (PlayerSpeedRun), A
7638+ C9DC 3E 02            LD A, SPEED_FIGHT
7639+ C9DE 32 D6 82         LD (PlayerSpeedFight), A
7640+ C9E1 21 00 00         LD HL, 0
7641+ C9E4 22 D7 82         LD (SpeedBuffTimer), HL                  ; timer + type (16-bit aligned)
7642+ C9E7 22 DA 82         LD (MushroomLockTimer), HL               ; reset mushroom debuff
7643+ C9EA AF               XOR A
7644+ C9EB 32 D9 82         LD (SpeedBuffType), A
7645+ C9EE                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7646+ C9EE                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7647+ C9EE                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7648+ C9EE                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7649+ C9EE                  ; recupera el control. Mismo flujo que tras una muerte.
7650+ C9EE 3E 01            LD A, 1
7651+ C9F0 32 EB 82         LD (PlayerRespawnPhase), A
7652+ C9F3 C9               RET
7653+ C9F4
7654+ C9F4              OnPlayerHealthDepleted:
7655+ C9F4                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7656+ C9F4                  ; coste real). Idempotente si no estaba activo.
7657+ C9F4 CD B4 75         CALL CancelMagicCompass
7658+ C9F7                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7659+ C9F7                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7660+ C9F7                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7661+ C9F7                  ; (combate, Death catch, drain de salud por cualquier via).
7662+ C9F7 F5               PUSH AF
7663+ C9F8 3E FF            LD A, $FF
7664+ C9FA CD BA 99         CALL StartMusic
7665+ C9FD F1               POP AF
7666+ C9FE                  ; Tambien parar el secuencer ad-hoc de MonstersMusic (no va por el driver
7667+ C9FE                  ; tabular; tiene su propia variable de estado MonstersMusicStep).
7668+ C9FE CD 4B F9         CALL StopMonstersMusic
7669+ CA01                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7670+ CA01                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7671+ CA01 CD A7 6F         CALL AY_PlayPlayerDeath
7672+ CA04                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7673+ CA04                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7674+ CA04 3E 02            LD A, 2
7675+ CA06 32 B3 82         LD (TimeFrozen), A
7676+ CA09                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7677+ CA09 CD CE 6D         CALL TombStore
7678+ CA0C                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7679+ CA0C CD 2D BA         CALL KillAllActiveNasties
7680+ CA0F                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7681+ CA0F CD FB BA         CALL SilentKillDeath
7682+ CA12                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7683+ CA12 CD 16 BB         CALL FreezeMonstersFacingCorpse
7684+ CA15                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7685+ CA15 CD BE CA         CALL TriggerDeathBorder
7686+ CA18                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7687+ CA18                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7688+ CA18                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7689+ CA18 DD 21 9B 81      LD IX, EntityTable
7690+ CA1C                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7691+ CA1C DD 7E 0A         LD A, (IX+ENT_DIR)
7692+ CA1F E6 80            AND $80
7693+ CA21 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7694+ CA23 28 02            JR Z, .ophdRightBase
7695+ CA25 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7696+ CA27              .ophdRightBase:
7697+ CA27 DD 77 00         LD (IX+ENT_SPRITEID), A
7698+ CA2A DD 36 06 00      LD (IX+ENT_DELTAX), 0
7699+ CA2E DD 36 07 00      LD (IX+ENT_DELTAY), 0
7700+ CA32 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7701+ CA34 32 E9 82         LD (PlayerDeathAnimTimer), A
7702+ CA37 AF               XOR A
7703+ CA38 32 EA 82         LD (PlayerDeathAnimFrame), A
7704+ CA3B                  ; Decrementar vida (clamp a 0)
7705+ CA3B 3A DE 82         LD A, (PlayerLives)
7706+ CA3E B7               OR A
7707+ CA3F C8               RET Z
7708+ CA40 3D               DEC A
7709+ CA41 32 DE 82         LD (PlayerLives), A
7710+ CA44 C9               RET
7711+ CA45
7712+ CA45              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7713+ CA45              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7714+ CA45              ErasePlayerSpriteAtOldPos:
7715+ CA45 DD 21 9B 81      LD IX, EntityTable
7716+ CA49 CD F4 A4         CALL GetOldSpriteAddr
7717+ CA4C DD 56 0D         LD D, (IX+ENT_OLDY)
7718+ CA4F DD 7E 0C         LD A, (IX+ENT_OLDX)
7719+ CA52 5F               LD E, A
7720+ CA53 DD E5            PUSH IX
7721+ CA55 DD 2A 7C A4      LD IX, (OldSprAddr)
7722+ CA59 CD E7 99         CALL DrawSprite
7723+ CA5C DD E1            POP IX
7724+ CA5E DD 56 0D         LD D, (IX+ENT_OLDY)
7725+ CA61 DD 5E 0C         LD E, (IX+ENT_OLDX)
7726+ CA64 C3 1C D3         JP RestoreOldAttr                   ; tail-call
7727+ CA67
7728+ CA67              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7729+ CA67              RespawnPlayerAtEntry:
7730+ CA67 DD 21 9B 81      LD IX, EntityTable
7731+ CA6B 3A 0E 83         LD A, (LastEntryPosX)
7732+ CA6E DD 77 03         LD (IX+ENT_POSX), A
7733+ CA71 DD 77 0C         LD (IX+ENT_OLDX), A
7734+ CA74 DD 77 0F         LD (IX+ENT_DRAWX), A
7735+ CA77 3A 0F 83         LD A, (LastEntryPosY)
7736+ CA7A DD 77 04         LD (IX+ENT_POSY), A
7737+ CA7D DD 77 0D         LD (IX+ENT_OLDY), A
7738+ CA80 3E 10            LD A, HEALTH_MAX
7739+ CA82 32 52 B3         LD (PlayerHealth), A
7740+ CA85 3E 10            LD A, STAMINA_MAX
7741+ CA87 32 53 B3         LD (PlayerStamina), A
7742+ CA8A DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7743+ CA8E DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7744+ CA92 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7745+ CA96 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7746+ CA9A DD 36 06 00      LD (IX+ENT_DELTAX), 0
7747+ CA9E DD 36 07 00      LD (IX+ENT_DELTAY), 0
7748+ CAA2                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7749+ CAA2                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7750+ CAA2                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7751+ CAA2                  ; libre, y .swordModeFree no toca el color.
7752+ CAA2 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7753+ CAA6 AF               XOR A
7754+ CAA7 32 4E B3         LD (AttackCooldown), A
7755+ CAAA 32 4D B3         LD (AttackTimer), A
7756+ CAAD DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7757+ CAB1                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7758+ CAB1                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7759+ CAB1 3E 01            LD A, 1
7760+ CAB3 32 EB 82         LD (PlayerRespawnPhase), A
7761+ CAB6 AF               XOR A
7762+ CAB7 32 EC 82         LD (PlayerRespawnTimer), A
7763+ CABA 32 EF 82         LD (PlayerRespawnBeatIdx), A
7764+ CABD C9               RET
7765+ CABE
7766+ CABE              ; ==============================================================================
7767+ CABE              ; TriggerDeathBorder - arranca el flash del borde tras morir
7768+ CABE              ; ==============================================================================
7769+ CABE              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7770+ CABE              ; luego vuelve a negro y se desactiva.
7771+ CABE              ; ==============================================================================
7772+ CABE              TriggerDeathBorder:
7773+ CABE 3E 01            LD A, 1
7774+ CAC0 32 E7 82         LD (DeathBorderPhase), A
7775+ CAC3 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7776+ CAC5 32 E8 82         LD (DeathBorderTimer), A
7777+ CAC8 3E 06            LD A, YELLOW
7778+ CACA 32 83 8D         LD (CurrentBorderColor), A
7779+ CACD D3 FE            OUT (254), A
7780+ CACF C9               RET
7781+ CAD0
7782+ CAD0              ; ==============================================================================
7783+ CAD0              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7784+ CAD0              ; ==============================================================================
7785+ CAD0              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7786+ CAD0              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7787+ CAD0              ; ==============================================================================
7788+ CAD0              UpdateRespawnBlink:
7789+ CAD0 3A EB 82         LD A, (PlayerRespawnPhase)
7790+ CAD3 B7               OR A
7791+ CAD4 C8               RET Z
7792+ CAD5 3D               DEC A
7793+ CAD6 28 0D            JR Z, .urbPhase1
7794+ CAD8                  ; Phase 2: solo timer (sin parpadeo)
7795+ CAD8 3A EC 82         LD A, (PlayerRespawnTimer)
7796+ CADB 3D               DEC A
7797+ CADC 32 EC 82         LD (PlayerRespawnTimer), A
7798+ CADF C0               RET NZ
7799+ CAE0 AF               XOR A
7800+ CAE1 32 EB 82         LD (PlayerRespawnPhase), A
7801+ CAE4 C9               RET
7802+ CAE5
7803+ CAE5              .urbPhase1:
7804+ CAE5                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7805+ CAE5                  ; Zero input (sin control)
7806+ CAE5 AF               XOR A
7807+ CAE6 32 AB 82         LD (InputDirection), A
7808+ CAE9 32 AC 82         LD (InputFire), A
7809+ CAEC                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7810+ CAEC                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7811+ CAEC 3A 9C 6F         LD A, (BeepDurationFrames)
7812+ CAEF D6 01            SUB 1                               ; CY si era 0 (silencio)
7813+ CAF1 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7814+ CAF2 E6 74            AND SPRID_PLAYER_BLANK
7815+ CAF4 32 9B 81         LD (EntityTable), A
7816+ CAF7                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7817+ CAF7 3A EC 82         LD A, (PlayerRespawnTimer)
7818+ CAFA B7               OR A
7819+ CAFB 28 05            JR Z, .urb1FireBeat
7820+ CAFD 3D               DEC A
7821+ CAFE 32 EC 82         LD (PlayerRespawnTimer), A
7822+ CB01 C9               RET
7823+ CB02              .urb1FireBeat:
7824+ CB02 3A EF 82         LD A, (PlayerRespawnBeatIdx)
7825+ CB05 3C               INC A
7826+ CB06 32 EF 82         LD (PlayerRespawnBeatIdx), A
7827+ CB09 FE 04            CP 4
7828+ CB0B 28 12            JR Z, .urb1LastBeat
7829+ CB0D FE 05            CP 5
7830+ CB0F 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7831+ CB11                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7832+ CB11 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7833+ CB14 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7834+ CB16 CD CA 6F         CALL AY_PlayBeep
7835+ CB19                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7836+ CB19                  ; (mitad) para mantener ON/OFF ~50/50.
7837+ CB19 3E 14            LD A, 20
7838+ CB1B 32 EC 82         LD (PlayerRespawnTimer), A
7839+ CB1E C9               RET
7840+ CB1F              .urb1LastBeat:
7841+ CB1F                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7842+ CB1F                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7843+ CB1F                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7844+ CB1F                  ; entra grace EXACTAMENTE al terminar el beep.
7845+ CB1F 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7846+ CB22 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7847+ CB24 CD CA 6F         CALL AY_PlayBeep
7848+ CB27 3E 0B            LD A, 11                    ; espera = duracion del beep
7849+ CB29 32 EC 82         LD (PlayerRespawnTimer), A
7850+ CB2C C9               RET
7851+ CB2D              .urb1AfterBeep:
7852+ CB2D                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7853+ CB2D                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7854+ CB2D CD 55 CB         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7855+ CB30 3E 0C            LD A, SPAWN_INTERVAL
7856+ CB32 32 F5 82         LD (SpawnTimer), A
7857+ CB35 AF               XOR A
7858+ CB36 32 FA 82         LD (DeathSpawned), A
7859+ CB39 32 F0 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7860+ CB3C 32 B3 82         LD (TimeFrozen), A              ; Reanudar reloj
7861+ CB3F 21 00 00         LD HL, 0
7862+ CB42 22 F7 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7863+ CB45                  ; Si los monsters siguen activos (no era game over), reanudar el
7864+ CB45                  ; secuencer "po-po-popo-po" — fue parado en OnPlayerHealthDepleted.
7865+ CB45 3A 58 B3         LD A, (MonstersActive)
7866+ CB48 B7               OR A
7867+ CB49 C8               RET Z
7868+ CB4A                  ; No re-arrancar si los 3 monsters estan atrapados en la iglesia
7869+ CB4A                  ; (StopMonstersMusic se llamo en TriggerChurchTrap del 3o; ya no hay
7870+ CB4A                  ; monsters jugables en pantalla aunque MonstersActive siga 1).
7871+ CB4A 3A BE 82         LD A, (MonsterTrappedFlags)
7872+ CB4D E6 07            AND $07
7873+ CB4F FE 07            CP $07
7874+ CB51 C8               RET Z
7875+ CB52 C3 42 F9         JP StartMonstersMusic           ; tail-call
7876+ CB55
7877+ CB55              ; ==============================================================================
7878+ CB55              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7879+ CB55              ; ==============================================================================
7880+ CB55              ; Llamado desde:
7881+ CB55              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7882+ CB55              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7883+ CB55              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7884+ CB55              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7885+ CB55              ; ==============================================================================
7886+ CB55              EnterGracePhase:
7887+ CB55 3E 02            LD A, 2
7888+ CB57 32 EB 82         LD (PlayerRespawnPhase), A
7889+ CB5A 3E 19            LD A, RESPAWN_GRACE_FRAMES
7890+ CB5C 32 EC 82         LD (PlayerRespawnTimer), A
7891+ CB5F C9               RET
7892+ CB60
7893+ CB60              ; ==============================================================================
7894+ CB60              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7895+ CB60              ; ==============================================================================
7896+ CB60              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7897+ CB60              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7898+ CB60              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7899+ CB60              ; ==============================================================================
7900+ CB60              UpdateDeathAnim:
7901+ CB60 3A E7 82         LD A, (DeathBorderPhase)
7902+ CB63 FE 01            CP 1
7903+ CB65 C0               RET NZ
7904+ CB66 3A E9 82         LD A, (PlayerDeathAnimTimer)
7905+ CB69 3D               DEC A
7906+ CB6A 32 E9 82         LD (PlayerDeathAnimTimer), A
7907+ CB6D C0               RET NZ
7908+ CB6E                  ; Tick consumido: avanzar frame
7909+ CB6E 3A EA 82         LD A, (PlayerDeathAnimFrame)
7910+ CB71 3C               INC A
7911+ CB72 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7912+ CB74 D0               RET NC                              ; ya en ultimo frame (clamp)
7913+ CB75 32 EA 82         LD (PlayerDeathAnimFrame), A
7914+ CB78 DD 21 9B 81      LD IX, EntityTable
7915+ CB7C DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7916+ CB7F                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7917+ CB7F                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7918+ CB7F                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7919+ CB7F FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7920+ CB81 20 06            JR NZ, .udaSkipSplatSfx
7921+ CB83 21 CF F7         LD HL, SFX_EnemyDeath
7922+ CB86 CD 50 F7         CALL PlaySFX
7923+ CB89              .udaSkipSplatSfx:
7924+ CB89 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7925+ CB8B 32 E9 82         LD (PlayerDeathAnimTimer), A
7926+ CB8E C9               RET
7927+ CB8F
7928+ CB8F              ; ==============================================================================
7929+ CB8F              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7930+ CB8F              ; ==============================================================================
7931+ CB8F              UpdateDeathBorder:
7932+ CB8F 3A E7 82         LD A, (DeathBorderPhase)
7933+ CB92 B7               OR A
7934+ CB93 C8               RET Z
7935+ CB94 3A E8 82         LD A, (DeathBorderTimer)
7936+ CB97 3D               DEC A
7937+ CB98 32 E8 82         LD (DeathBorderTimer), A
7938+ CB9B C0               RET NZ
7939+ CB9C                  ; Timer expiro: avanzar fase
7940+ CB9C 3A E7 82         LD A, (DeathBorderPhase)
7941+ CB9F FE 01            CP 1
7942+ CBA1 20 33            JR NZ, .udbToBlack
7943+ CBA3                  ; --- Fin fase amarillo ---
7944+ CBA3                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7945+ CBA3                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7946+ CBA3 3A DE 82         LD A, (PlayerLives)
7947+ CBA6 B7               OR A
7948+ CBA7 28 1F            JR Z, .udbToGameOver
7949+ CBA9 DD 21 9B 81      LD IX, EntityTable
7950+ CBAD DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7951+ CBB1 3E 02            LD A, 2
7952+ CBB3 32 E7 82         LD (DeathBorderPhase), A
7953+ CBB6 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7954+ CBB8 32 E8 82         LD (DeathBorderTimer), A
7955+ CBBB 3E 02            LD A, RED
7956+ CBBD 32 83 8D         LD (CurrentBorderColor), A
7957+ CBC0 D3 FE            OUT (254), A
7958+ CBC2                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7959+ CBC2                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7960+ CBC2 3E 01            LD A, 1
7961+ CBC4 32 F4 82         LD (TombDrawPending), A
7962+ CBC7 C9               RET
7963+ CBC8              .udbToGameOver:
7964+ CBC8                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7965+ CBC8 AF               XOR A
7966+ CBC9 32 E7 82         LD (DeathBorderPhase), A
7967+ CBCC 3E 00            LD A, BLACK
7968+ CBCE 32 83 8D         LD (CurrentBorderColor), A
7969+ CBD1 D3 FE            OUT (254), A
7970+ CBD3 C3 E4 CB         JP ShowGameOver
7971+ CBD6              .udbToBlack:
7972+ CBD6                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7973+ CBD6 AF               XOR A
7974+ CBD7 32 E7 82         LD (DeathBorderPhase), A
7975+ CBDA 3E 00            LD A, BLACK
7976+ CBDC 32 83 8D         LD (CurrentBorderColor), A
7977+ CBDF D3 FE            OUT (254), A
7978+ CBE1 C3 67 CA         JP RespawnPlayerAtEntry             ; tail-call
7979+ CBE4
7980+ CBE4              ; ==============================================================================
7981+ CBE4              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7982+ CBE4              ; ==============================================================================
7983+ CBE4              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7984+ CBE4              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7985+ CBE4              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7986+ CBE4              ; ==============================================================================
7987+ CBE4              ShowGameOver:
7988+ CBE4 3E 01            LD A, 1
7989+ CBE6 32 DF 82         LD (GameOver), A
7990+ CBE9 C9               RET
7991+ CBEA
7992+ CBEA              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7993+ CBEA              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7994+ CBEA              PaintGameOverScreen:
7995+ CBEA                  ; Wipe pixels
7996+ CBEA 21 00 40         LD HL, $4000
7997+ CBED 11 01 40         LD DE, $4001
7998+ CBF0 01 FF 17         LD BC, $17FF
7999+ CBF3 36 00            LD (HL), 0
8000+ CBF5 ED B0            LDIR
8001+ CBF7                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
8002+ CBF7 21 00 58         LD HL, $5800
8003+ CBFA 11 01 58         LD DE, $5801
8004+ CBFD 01 FF 02         LD BC, $02FF
8005+ CC00 36 47            LD (HL), $47
8006+ CC02 ED B0            LDIR
8007+ CC04                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
8008+ CC04                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
8009+ CC04 CD 62 75         CALL DrawTombstone2xCentered
8010+ CC07                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
8011+ CC07 3E 88            LD A, GAMEOVER_ANIM_X_MAX
8012+ CC09 32 E0 82         LD (GameOverAnimX), A
8013+ CC0C AF               XOR A
8014+ CC0D 32 E1 82         LD (GameOverAnimDir), A
8015+ CC10 32 E2 82         LD (GameOverAnimFrame), A
8016+ CC13 32 E6 82         LD (GameOverAnimLastX), A
8017+ CC16 21 00 00         LD HL, 0
8018+ CC19 22 E4 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
8019+ CC1C 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8020+ CC1E 32 E3 82         LD (GameOverAnimFrameTimer), A
8021+ CC21                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
8022+ CC21                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
8023+ CC21                  ; congelado en GameOver=2.
8024+ CC21 3E 03            LD A, 3
8025+ CC23 C3 BA 99         JP StartMusic                   ; tail-call
8026+ CC26
8027+ CC26              ; ==============================================================================
8028+ CC26              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
8029+ CC26              ; ==============================================================================
8030+ CC26              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
8031+ CC26              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
8032+ CC26              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
8033+ CC26              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
8034+ CC26              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
8035+ CC26              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
8036+ CC26              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
8037+ CC26              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
8038+ CC26              ;
8039+ CC26              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
8040+ CC26              ; shifted (que ocupa 4 chars = 32 px).
8041+ CC26              ; ==============================================================================
8042+ CC26              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
8043+ CC26              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8044+ CC26              ; X swing centrado sobre la tumba:
8045+ CC26              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8046+ CC26              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8047+ CC26              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8048+ CC26              GAMEOVER_ANIM_Y           EQU 56
8049+ CC26              GAMEOVER_ANIM_X_MIN       EQU 96
8050+ CC26              GAMEOVER_ANIM_X_MAX       EQU 136
8051+ CC26              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8052+ CC26
8053+ CC26              UpdateGameOverAnim:
8054+ CC26                  ; --- Erase del sprite previo (si lo hubo) ---
8055+ CC26 2A E4 82         LD HL, (GameOverAnimLastSpr)
8056+ CC29 7C               LD A, H
8057+ CC2A B5               OR L
8058+ CC2B 28 0C            JR Z, .ugoaNoErase
8059+ CC2D E5               PUSH HL
8060+ CC2E DD E1            POP IX
8061+ CC30 3A E6 82         LD A, (GameOverAnimLastX)
8062+ CC33 5F               LD E, A
8063+ CC34 16 38            LD D, GAMEOVER_ANIM_Y
8064+ CC36 CD E7 99         CALL DrawSprite
8065+ CC39              .ugoaNoErase:
8066+ CC39
8067+ CC39                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8068+ CC39 3A E3 82         LD A, (GameOverAnimFrameTimer)
8069+ CC3C 3D               DEC A
8070+ CC3D 20 0A            JR NZ, .ugoaTimerSet
8071+ CC3F 3A E2 82         LD A, (GameOverAnimFrame)
8072+ CC42 EE 01            XOR 1
8073+ CC44 32 E2 82         LD (GameOverAnimFrame), A
8074+ CC47 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8075+ CC49              .ugoaTimerSet:
8076+ CC49 32 E3 82         LD (GameOverAnimFrameTimer), A
8077+ CC4C
8078+ CC4C                  ; --- Avanzar X segun direccion (ping-pong) ---
8079+ CC4C 3A E1 82         LD A, (GameOverAnimDir)
8080+ CC4F B7               OR A
8081+ CC50 20 14            JR NZ, .ugoaSlideRight
8082+ CC52                  ; Dir 0: facing R, slide LEFT (X--)
8083+ CC52 3A E0 82         LD A, (GameOverAnimX)
8084+ CC55 FE 60            CP GAMEOVER_ANIM_X_MIN
8085+ CC57 28 06            JR Z, .ugoaFlipToL
8086+ CC59 3D               DEC A
8087+ CC5A 32 E0 82         LD (GameOverAnimX), A
8088+ CC5D 18 18            JR .ugoaPickSprite
8089+ CC5F              .ugoaFlipToL:
8090+ CC5F 3E 01            LD A, 1
8091+ CC61 32 E1 82         LD (GameOverAnimDir), A
8092+ CC64 18 11            JR .ugoaPickSprite
8093+ CC66              .ugoaSlideRight:
8094+ CC66                  ; Dir 1: facing L, slide RIGHT (X++)
8095+ CC66 3A E0 82         LD A, (GameOverAnimX)
8096+ CC69 FE 88            CP GAMEOVER_ANIM_X_MAX
8097+ CC6B 28 06            JR Z, .ugoaFlipToR
8098+ CC6D 3C               INC A
8099+ CC6E 32 E0 82         LD (GameOverAnimX), A
8100+ CC71 18 04            JR .ugoaPickSprite
8101+ CC73              .ugoaFlipToR:
8102+ CC73 AF               XOR A
8103+ CC74 32 E1 82         LD (GameOverAnimDir), A
8104+ CC77
8105+ CC77              .ugoaPickSprite:
8106+ CC77                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8107+ CC77                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8108+ CC77                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8109+ CC77 3A E1 82         LD A, (GameOverAnimDir)
8110+ CC7A B7               OR A
8111+ CC7B 20 0E            JR NZ, .ugoaPickR
8112+ CC7D 3A E2 82         LD A, (GameOverAnimFrame)
8113+ CC80 B7               OR A
8114+ CC81 21 DF DD         LD HL, SprDeath_L0
8115+ CC84 28 11            JR Z, .ugoaSprSet
8116+ CC86 21 29 DE         LD HL, SprDeath_L1
8117+ CC89 18 0C            JR .ugoaSprSet
8118+ CC8B              .ugoaPickR:
8119+ CC8B 3A E2 82         LD A, (GameOverAnimFrame)
8120+ CC8E B7               OR A
8121+ CC8F 21 4B DD         LD HL, SprDeath_0
8122+ CC92 28 03            JR Z, .ugoaSprSet
8123+ CC94 21 95 DD         LD HL, SprDeath_1
8124+ CC97              .ugoaSprSet:
8125+ CC97 22 E4 82         LD (GameOverAnimLastSpr), HL
8126+ CC9A 3A E0 82         LD A, (GameOverAnimX)
8127+ CC9D 32 E6 82         LD (GameOverAnimLastX), A
8128+ CCA0
8129+ CCA0                  ; --- Draw nuevo sprite ---
8130+ CCA0 E5               PUSH HL
8131+ CCA1 DD E1            POP IX
8132+ CCA3 5F               LD E, A
8133+ CCA4 16 38            LD D, GAMEOVER_ANIM_Y
8134+ CCA6 C3 E7 99         JP DrawSprite                   ; tail-call
