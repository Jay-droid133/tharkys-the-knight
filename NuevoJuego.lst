 853+ F2CB              .ccRow0:
 854+ F2CB 77               LD (HL), A
 855+ F2CC 23               INC HL
 856+ F2CD 77               LD (HL), A
 857+ F2CE 2B               DEC HL
 858+ F2CF 24               INC H
 859+ F2D0 10 F9            DJNZ .ccRow0
 860+ F2D2 26 40            LD H, $40
 861+ F2D4 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 862+ F2D6 06 08            LD B, 8
 863+ F2D8 AF               XOR A
 864+ F2D9              .ccRow1:
 865+ F2D9 77               LD (HL), A
 866+ F2DA 23               INC HL
 867+ F2DB 77               LD (HL), A
