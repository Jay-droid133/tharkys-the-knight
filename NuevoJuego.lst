   1+ 9DBA              ; ==============================================================================
   2+ 9DBA              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DBA              ; ==============================================================================
   4+ 9DBA              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DBA              ; - Game loop per-entity: erase → update → draw
   6+ 9DBA              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DBA              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DBA              ; - XOR draw/erase (una sola rutina)
   9+ 9DBA              ; ==============================================================================
  10+ 9DBA
  11+ 9DBA              ; ==============================================================================
  12+ 9DBA              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DBA              ; ==============================================================================
  14+ 9DBA              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DBA              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DBA              ; ==============================================================================
  17+ 9DBA              ReadInput:
  18+ 9DBA 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DBC 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DBE
  21+ 9DBE                  ; -- 1. QAOP --
  22+ 9DBE 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC1 ED 78            IN A, (C)
  24+ 9DC3 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DC5 20 02            JR NZ, .no_q
  26+ 9DC7 CB C2            SET 0, D
  27+ 9DC9              .no_q:
  28+ 9DC9 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DCC ED 78            IN A, (C)
  30+ 9DCE CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD0 20 02            JR NZ, .no_a
  32+ 9DD2 CB CA            SET 1, D
  33+ 9DD4              .no_a:
  34+ 9DD4 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DD7 ED 78            IN A, (C)
  36+ 9DD9 CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DDB 20 02            JR NZ, .no_o
  38+ 9DDD CB DA            SET 3, D
  39+ 9DDF              .no_o:
  40+ 9DDF CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE1 20 02            JR NZ, .no_p
  42+ 9DE3 CB D2            SET 2, D
  43+ 9DE5              .no_p:
  44+ 9DE5
  45+ 9DE5                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DE5                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DE5 DB 1F            IN A, (31)
  48+ 9DE7 4F               LD C, A             ; guardar para fire
  49+ 9DE8 CB 5F            BIT 3, A            ; Up
  50+ 9DEA 28 02            JR Z, .no_k_up
  51+ 9DEC CB C2            SET 0, D
  52+ 9DEE              .no_k_up:
  53+ 9DEE CB 57            BIT 2, A            ; Down
  54+ 9DF0 28 02            JR Z, .no_k_down
  55+ 9DF2 CB CA            SET 1, D
  56+ 9DF4              .no_k_down:
  57+ 9DF4 CB 4F            BIT 1, A            ; Left
  58+ 9DF6 28 02            JR Z, .no_k_left
  59+ 9DF8 CB DA            SET 3, D
  60+ 9DFA              .no_k_left:
  61+ 9DFA CB 47            BIT 0, A            ; Right
  62+ 9DFC 28 02            JR Z, .no_k_right
  63+ 9DFE CB D2            SET 2, D
  64+ 9E00              .no_k_right:
  65+ 9E00 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E02 28 02            JR Z, .no_k_fire
  67+ 9E04 CB C3            SET 0, E
  68+ 9E06              .no_k_fire:
  69+ 9E06
  70+ 9E06                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E06                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E06 01 FE F7         LD BC, $F7FE
  73+ 9E09 ED 78            IN A, (C)
  74+ 9E0B CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E0D 20 02            JR NZ, .no_s1_up
  76+ 9E0F CB C2            SET 0, D
  77+ 9E11              .no_s1_up:
  78+ 9E11 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E13 20 02            JR NZ, .no_s1_down
  80+ 9E15 CB CA            SET 1, D
  81+ 9E17              .no_s1_down:
  82+ 9E17 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E19 20 02            JR NZ, .no_s1_left
  84+ 9E1B CB DA            SET 3, D
  85+ 9E1D              .no_s1_left:
  86+ 9E1D CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E1F 20 02            JR NZ, .no_s1_right
  88+ 9E21 CB D2            SET 2, D
  89+ 9E23              .no_s1_right:
  90+ 9E23 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E25 20 02            JR NZ, .no_s1_fire
  92+ 9E27 CB C3            SET 0, E
  93+ 9E29              .no_s1_fire:
  94+ 9E29
  95+ 9E29                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E29 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E2C ED 78            IN A, (C)
  98+ 9E2E CB 47            BIT 0, A            ; SPACE
  99+ 9E30 20 02            JR NZ, .no_space
 100+ 9E32 CB C3            SET 0, E
 101+ 9E34              .no_space:
 102+ 9E34
 103+ 9E34                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E34 7B               LD A, E
 105+ 9E35 32 AC 82         LD (InputFire), A
 106+ 9E38
 107+ 9E38                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E38 21 DA 82         LD HL, MushroomLockTimer
 109+ 9E3B 7E               LD A, (HL)
 110+ 9E3C 23               INC HL
 111+ 9E3D B6               OR (HL)
 112+ 9E3E 28 21            JR Z, .noMushLock
 113+ 9E40 AF               XOR A
 114+ 9E41 32 AC 82         LD (InputFire), A
 115+ 9E44                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E44                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E44 7B               LD A, E
 118+ 9E45 B7               OR A
 119+ 9E46 28 15            JR Z, .resetNoSwordFlag
 120+ 9E48 3A B5 82         LD A, (NoSwordSoundFlag)
 121+ 9E4B B7               OR A
 122+ 9E4C 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E4E 3E 01            LD A, 1
 124+ 9E50 32 B5 82         LD (NoSwordSoundFlag), A
 125+ 9E53 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E54 21 7A F7         LD HL, SFX_NoSwordError
 127+ 9E57 CD 41 F6         CALL PlaySFX
 128+ 9E5A D1               POP DE
 129+ 9E5B 18 04            JR .noMushLock
 130+ 9E5D              .resetNoSwordFlag:
 131+ 9E5D AF               XOR A
 132+ 9E5E 32 B5 82         LD (NoSwordSoundFlag), A
 133+ 9E61              .noMushLock:
 134+ 9E61
 135+ 9E61                  ; -- 6. Cancelar opuestos --
 136+ 9E61 7A               LD A, D
 137+ 9E62 47               LD B, A
 138+ 9E63 E6 03            AND DIR_N | DIR_S
 139+ 9E65 FE 03            CP DIR_N | DIR_S
 140+ 9E67 20 04            JR NZ, .noVC
 141+ 9E69 78               LD A, B
 142+ 9E6A E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ 9E6C 47               LD B, A
 144+ 9E6D              .noVC:
 145+ 9E6D 78               LD A, B
 146+ 9E6E E6 0C            AND DIR_E | DIR_W
 147+ 9E70 FE 0C            CP DIR_E | DIR_W
 148+ 9E72 20 04            JR NZ, .noHC
 149+ 9E74 78               LD A, B
 150+ 9E75 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ 9E77 47               LD B, A
 152+ 9E78              .noHC:
 153+ 9E78 78               LD A, B
 154+ 9E79 32 AB 82         LD (InputDirection), A
 155+ 9E7C C9               RET
