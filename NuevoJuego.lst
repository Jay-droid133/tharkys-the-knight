1537+ F46C              ; ==============================================================================
1538+ F46C              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1539+ F46C              ; ==============================================================================
1540+ F46C              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1541+ F46C              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1542+ F46C              ; suficiente para corromper visualmente).
1543+ F46C              ; IN: IX = entity ptr.
1544+ F46C              ; ==============================================================================
1545+ F46C              RedrawTrappedMonster:
1546+ F46C                  ; --- Erase viejo en (OLDX, OLDY) ---
1547+ F46C CD F4 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1548+ F46F DD 7E 0D         LD A, (IX+ENT_OLDY)
1549+ F472 57               LD D, A
1550+ F473 DD 7E 0C         LD A, (IX+ENT_OLDX)
1551+ F476 5F               LD E, A
1552+ F477 DD E5            PUSH IX
1553+ F479 DD 2A 7C A4      LD IX, (OldSprAddr)
1554+ F47D CD E7 99         CALL DrawSprite
1555+ F480 DD E1            POP IX
1556+ F482                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1557+ F482                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1558+ F482 DD 56 0D         LD D, (IX+ENT_OLDY)
1559+ F485 DD 5E 0C         LD E, (IX+ENT_OLDX)
1560+ F488 CD 9E D2         CALL RestoreOldAttr
1561+ F48B                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1562+ F48B                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1563+ F48B                  ; reponer attrs de pickups que el flujo de entidades pisa con
1564+ F48B                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1565+ F48B                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1566+ F48B                  ; estar bajo el monster.
1567+ F48B DD E5            PUSH IX
1568+ F48D CD 7E D9         CALL RefreshPickupAttrs
1569+ F490 DD E1            POP IX
1570+ F492                  ; --- Compute new draw pos ---
1571+ F492 CD 7E A4         CALL CalcDrawX
1572+ F495 CD 16 9F         CALL ComputeEnemyDrawY
1573+ F498                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1574+ F498 CD C3 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1575+ F49B 3A DD 82         LD A, (EnemyDrawY)
1576+ F49E 57               LD D, A
1577+ F49F DD 7E 0F         LD A, (IX+ENT_DRAWX)
1578+ F4A2 5F               LD E, A
1579+ F4A3 DD E5            PUSH IX
1580+ F4A5 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
1581+ F4A9 CD 04 9B         CALL CalcEntityAttrSize
1582+ F4AC DD E1            POP IX
1583+ F4AE 3A DD 82         LD A, (EnemyDrawY)
1584+ F4B1 57               LD D, A
1585+ F4B2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1586+ F4B5 5F               LD E, A
1587+ F4B6 DD 7E 05         LD A, (IX+ENT_ATTR)
1588+ F4B9 CD D7 9A         CALL SetEntityAttr
1589+ F4BC                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1590+ F4BC 3A DD 82         LD A, (EnemyDrawY)
1591+ F4BF 57               LD D, A
1592+ F4C0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1593+ F4C3 5F               LD E, A
1594+ F4C4 DD E5            PUSH IX
1595+ F4C6 DD 2A F2 A4      LD IX, (SpriteAddrTemp)
1596+ F4CA CD E7 99         CALL DrawSprite
1597+ F4CD DD E1            POP IX
1598+ F4CF                  ; --- Save OLD = current ---
1599+ F4CF DD 7E 0F         LD A, (IX+ENT_DRAWX)
1600+ F4D2 DD 77 0C         LD (IX+ENT_OLDX), A
1601+ F4D5 3A DD 82         LD A, (EnemyDrawY)
1602+ F4D8 DD 77 0D         LD (IX+ENT_OLDY), A
1603+ F4DB DD 7E 00         LD A, (IX+ENT_SPRITEID)
1604+ F4DE DD 77 0E         LD (IX+ENT_OLDSPRID), A
1605+ F4E1 C9               RET
