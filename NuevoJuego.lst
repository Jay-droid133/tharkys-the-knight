 945+ A441              ; ==============================================================================
 946+ A441              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 947+ A441              ; ==============================================================================
 948+ A441              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 949+ A441              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 950+ A441              ; ==============================================================================
 951+ A441              GetSpriteAddr:
 952+ A441                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
 953+ A441                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
 954+ A441 3A FB 8F         LD A, (CurrentPaging)
 955+ A444 E6 F8            AND $F8
 956+ A446 F6 06            OR 6
 957+ A448 32 FB 8F         LD (CurrentPaging), A
 958+ A44B 01 FD 7F         LD BC, $7FFD
 959+ A44E ED 79            OUT (C), A                  ; bank 6 paginado
 960+ A450 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 961+ A453 6F               LD L, A
 962+ A454 26 00            LD H, 0
 963+ A456 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
 964+ A457 11 C6 E0         LD DE, SpriteFrameTable
 965+ A45A 19               ADD HL, DE
 966+ A45B 5E               LD E, (HL)
 967+ A45C 23               INC HL
 968+ A45D 56               LD D, (HL)
 969+ A45E ED 53 70 A4      LD (SpriteAddrTemp), DE
 970+ A462 3A FB 8F         LD A, (CurrentPaging)
 971+ A465 E6 F8            AND $F8
 972+ A467 32 FB 8F         LD (CurrentPaging), A
 973+ A46A 01 FD 7F         LD BC, $7FFD
 974+ A46D ED 79            OUT (C), A                  ; bank 0 de vuelta
 975+ A46F C9               RET
 976+ A470
 977+ A470 00 00        SpriteAddrTemp: DEFW 0
 978+ A472
 979+ A472              ; ==============================================================================
 980+ A472              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
 981+ A472              ; ==============================================================================
 982+ A472              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
 983+ A472              ; Salida:   DE = puntero al sprite data
 984+ A472              ;           OldSprAddr = mismo puntero (conveniencia para caller)
 985+ A472              ; Preserva: IX
 986+ A472              ; Destruye: A, HL
 987+ A472              ; ==============================================================================
 988+ A472              GetOldSpriteAddr:
 989+ A472                  ; Paging inline (ver GetSpriteAddr)
 990+ A472 3A FB 8F         LD A, (CurrentPaging)
 991+ A475 E6 F8            AND $F8
 992+ A477 F6 06            OR 6
 993+ A479 32 FB 8F         LD (CurrentPaging), A
 994+ A47C 01 FD 7F         LD BC, $7FFD
 995+ A47F ED 79            OUT (C), A
 996+ A481 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
 997+ A484 6F               LD L, A
 998+ A485 26 00            LD H, 0
 999+ A487 29               ADD HL, HL
1000+ A488 11 C6 E0         LD DE, SpriteFrameTable
1001+ A48B 19               ADD HL, DE
1002+ A48C 5E               LD E, (HL)
1003+ A48D 23               INC HL
1004+ A48E 56               LD D, (HL)
1005+ A48F ED 53 FA A3      LD (OldSprAddr), DE
1006+ A493 3A FB 8F         LD A, (CurrentPaging)
1007+ A496 E6 F8            AND $F8
1008+ A498 32 FB 8F         LD (CurrentPaging), A
1009+ A49B 01 FD 7F         LD BC, $7FFD
1010+ A49E ED 79            OUT (C), A
1011+ A4A0 C9               RET
1012+ A4A1
1013+ A4A1              ; ==============================================================================
1014+ A4A1              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1015+ A4A1              ; ==============================================================================
1016+ A4A1              ; Entrada: A = SpriteID
1017+ A4A1              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1018+ A4A1              ; Destruye: A, DE, HL
1019+ A4A1              ; ==============================================================================
1020+ A4A1              GetSpriteDims:
1021+ A4A1                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1022+ A4A1                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1023+ A4A1 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1024+ A4A2 26 00            LD H, 0
1025+ A4A4 3A FB 8F         LD A, (CurrentPaging)
1026+ A4A7 E6 F8            AND $F8
1027+ A4A9 F6 06            OR 6
1028+ A4AB 32 FB 8F         LD (CurrentPaging), A
1029+ A4AE 01 FD 7F         LD BC, $7FFD
1030+ A4B1 ED 79            OUT (C), A                  ; bank 6 paginado
1031+ A4B3 29               ADD HL, HL
1032+ A4B4 11 C6 E0         LD DE, SpriteFrameTable
1033+ A4B7 19               ADD HL, DE
1034+ A4B8 5E               LD E, (HL)
1035+ A4B9 23               INC HL
1036+ A4BA 56               LD D, (HL)                  ; DE = ptr al sprite data
1037+ A4BB 1A               LD A, (DE)                  ; width_bytes
1038+ A4BC 87               ADD A, A
1039+ A4BD 87               ADD A, A
1040+ A4BE 87               ADD A, A                    ; × 8 = width_px
1041+ A4BF 47               LD B, A
1042+ A4C0 13               INC DE
1043+ A4C1 1A               LD A, (DE)                  ; height_px
1044+ A4C2 4F               LD C, A
1045+ A4C3                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1046+ A4C3 78               LD A, B
1047+ A4C4 32 E1 A4         LD (GsdSavedB), A
1048+ A4C7 79               LD A, C
1049+ A4C8 32 E2 A4         LD (GsdSavedC), A
1050+ A4CB 3A FB 8F         LD A, (CurrentPaging)
1051+ A4CE E6 F8            AND $F8
1052+ A4D0 32 FB 8F         LD (CurrentPaging), A
1053+ A4D3 01 FD 7F         LD BC, $7FFD
1054+ A4D6 ED 79            OUT (C), A                  ; bank 0 de vuelta
1055+ A4D8 3A E1 A4         LD A, (GsdSavedB)
1056+ A4DB 47               LD B, A
1057+ A4DC 3A E2 A4         LD A, (GsdSavedC)
1058+ A4DF 4F               LD C, A
1059+ A4E0 C9               RET
1060+ A4E1
1061+ A4E1 00           GsdSavedB: DEFB 0
1062+ A4E2 00           GsdSavedC: DEFB 0
1063+ A4E3
1064+ A4E3              ; ==============================================================================
1065+ A4E3              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1066+ A4E3              ; ==============================================================================
1067+ A4E3              ; IX = puntero a la entidad del player (slot 0)
1068+ A4E3              ; ==============================================================================
1069+ A4E3              UpdatePlayer:
1070+ A4E3 CD ED A4         CALL UpdatePlayerState
1071+ A4E6 CD 08 A6         CALL UpdatePlayerMovement
1072+ A4E9 CD 69 A8         CALL UpdatePlayerAnimation
