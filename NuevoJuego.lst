   1+ 9182              ; ==============================================================================
   2+ 9182              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ 9182              ; ==============================================================================
   4+ 9182              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ 9182              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ 9182              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ 9182              ; ==============================================================================
   8+ 9182
   9+ 9182              ; ==============================================================================
  10+ 9182              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ 9182              ; ==============================================================================
  12+ 9182              InitScreenSystem:
  13+ 9182 3E 08            LD A, START_SCREEN_X
  14+ 9184 32 7C 81         LD (CurrentScreenX), A
  15+ 9187 3E 08            LD A, START_SCREEN_Y
  16+ 9189 32 7D 81         LD (CurrentScreenY), A
  17+ 918C 3E 01            LD A, 1
  18+ 918E 32 81 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ 9191 AF               XOR A
  20+ 9192 32 80 81         LD (ScreenTransition), A
  21+ 9195 CD 99 91         CALL CalcScreenAddress
  22+ 9198 C9               RET
  23+ 9199
  24+ 9199              ; ==============================================================================
  25+ 9199              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ 9199              ; ==============================================================================
  27+ 9199              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ 9199              ; ==============================================================================
  29+ 9199              CalcScreenAddress:
  30+ 9199 3A 7D 81         LD A, (CurrentScreenY)
  31+ 919C 6F               LD L, A
  32+ 919D 26 00            LD H, 0
  33+ 919F 29               ADD HL, HL                  ; x2
  34+ 91A0 29               ADD HL, HL                  ; x4
  35+ 91A1 29               ADD HL, HL                  ; x8
  36+ 91A2 29               ADD HL, HL                  ; x16
  37+ 91A3 3A 7C 81         LD A, (CurrentScreenX)
  38+ 91A6 5F               LD E, A
  39+ 91A7 16 00            LD D, 0
  40+ 91A9 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ 91AA 11 D6 95         LD DE, MapTable
  42+ 91AD 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ 91AE 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ 91AF                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ 91AF 6F               LD L, A
  46+ 91B0 26 00            LD H, 0
  47+ 91B2 29               ADD HL, HL                  ; index * 2
  48+ 91B3 11 74 95         LD DE, RoomTable
  49+ 91B6 19               ADD HL, DE
  50+ 91B7 5E               LD E, (HL)
  51+ 91B8 23               INC HL
  52+ 91B9 56               LD D, (HL)                  ; DE = puntero a room data
  53+ 91BA ED 53 7E 81      LD (CurrentScreenAddr), DE
  54+ 91BE C9               RET
  55+ 91BF
  56+ 91BF              ; ==============================================================================
  57+ 91BF              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  58+ 91BF              ; ==============================================================================
  59+ 91BF              CheckScreenTransition:
  60+ 91BF AF               XOR A
  61+ 91C0 32 80 81         LD (ScreenTransition), A
  62+ 91C3
  63+ 91C3                  ; --- Comprobar borde OESTE (izquierdo) ---
  64+ 91C3 3A 55 80         LD A, (EntityTable + ENT_POSX)
  65+ 91C6 FE 04            CP TRANSITION_ZONE
  66+ 91C8 30 16            JR NC, .noWest
  67+ 91CA 3A 7C 81         LD A, (CurrentScreenX)
  68+ 91CD B7               OR A
  69+ 91CE 28 10            JR Z, .noWest
  70+ 91D0 3D               DEC A
  71+ 91D1 32 7C 81         LD (CurrentScreenX), A
  72+ 91D4 3E 08            LD A, DIR_W
  73+ 91D6 32 80 81         LD (ScreenTransition), A
  74+ 91D9 3E E0            LD A, SCREEN_MAX_X - 8
  75+ 91DB 32 55 80         LD (EntityTable + ENT_POSX), A
  76+ 91DE 18 57            JR .doTransition
  77+ 91E0
  78+ 91E0              .noWest:
  79+ 91E0                  ; --- Comprobar borde ESTE (derecho) ---
  80+ 91E0 3A 55 80         LD A, (EntityTable + ENT_POSX)
  81+ 91E3 FE E8            CP SCREEN_MAX_X
  82+ 91E5 38 17            JR C, .noEast
  83+ 91E7 3A 7C 81         LD A, (CurrentScreenX)
  84+ 91EA FE 0F            CP MAP_WIDTH - 1
  85+ 91EC 28 10            JR Z, .noEast
  86+ 91EE 3C               INC A
  87+ 91EF 32 7C 81         LD (CurrentScreenX), A
  88+ 91F2 3E 04            LD A, DIR_E
  89+ 91F4 32 80 81         LD (ScreenTransition), A
  90+ 91F7 3E 05            LD A, TRANSITION_ZONE + 1
  91+ 91F9 32 55 80         LD (EntityTable + ENT_POSX), A
  92+ 91FC 18 39            JR .doTransition
  93+ 91FE
  94+ 91FE              .noEast:
  95+ 91FE                  ; --- Comprobar borde NORTE (superior) ---
  96+ 91FE 3A 56 80         LD A, (EntityTable + ENT_POSY)
  97+ 9201 FE 14            CP SCREEN_MIN_Y + TRANSITION_ZONE
  98+ 9203 30 16            JR NC, .noNorth
  99+ 9205 3A 7D 81         LD A, (CurrentScreenY)
 100+ 9208 B7               OR A
 101+ 9209 28 10            JR Z, .noNorth
 102+ 920B 3D               DEC A
 103+ 920C 32 7D 81         LD (CurrentScreenY), A
 104+ 920F 3E 01            LD A, DIR_N
 105+ 9211 32 80 81         LD (ScreenTransition), A
 106+ 9214 3E A3            LD A, SCREEN_MAX_Y - 8
 107+ 9216 32 56 80         LD (EntityTable + ENT_POSY), A
 108+ 9219 18 1C            JR .doTransition
 109+ 921B
 110+ 921B              .noNorth:
 111+ 921B                  ; --- Comprobar borde SUR (inferior) ---
 112+ 921B 3A 56 80         LD A, (EntityTable + ENT_POSY)
 113+ 921E FE AB            CP SCREEN_MAX_Y
