4266+ B9E7 3D               DEC A                           ; posX + W - 1
4267+ B9E8 0F               RRCA
4268+ B9E9 0F               RRCA
4269+ B9EA 0F               RRCA
4270+ B9EB E6 1F            AND $1F
4271+ B9ED 5F               LD E, A                         ; E = charXhi
4272+ B9EE 3A 53 BA         LD A, (.ecXlo)
4273+ B9F1 57               LD D, A
4274+ B9F2 7B               LD A, E
4275+ B9F3 92               SUB D
4276+ B9F4 3C               INC A                           ; width_chars
4277+ B9F5 32 55 BA         LD (.ecWc), A
4278+ B9F8                  ; --- Char Y range ---
4279+ B9F8 DD 7E 04         LD A, (IX+ENT_POSY)
4280+ B9FB 47               LD B, A                         ; B = posY (salvar)
4281+ B9FC 0F               RRCA
4282+ B9FD 0F               RRCA
4283+ B9FE 0F               RRCA
4284+ B9FF E6 1F            AND $1F
4285+ BA01 D6 02            SUB BG_Y_OFFSET
4286+ BA03 32 54 BA         LD (.ecYlo), A
4287+ BA06 78               LD A, B
4288+ BA07 81               ADD A, C
4289+ BA08 3D               DEC A                           ; posY + H - 1
4290+ BA09 0F               RRCA
4291+ BA0A 0F               RRCA
4292+ BA0B 0F               RRCA
4293+ BA0C E6 1F            AND $1F
4294+ BA0E D6 02            SUB BG_Y_OFFSET
4295+ BA10 47               LD B, A                         ; B = charYhi
4296+ BA11 3A 54 BA         LD A, (.ecYlo)
4297+ BA14 ED 44            NEG
4298+ BA16 80               ADD A, B
4299+ BA17 3C               INC A                           ; height_chars
4300+ BA18 32 56 BA         LD (.ecHc), A
