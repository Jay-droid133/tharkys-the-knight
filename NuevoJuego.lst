  41+ F0A6 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  42+ F0A8 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  43+ F0AA 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  44+ F0AC 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  45+ F0AE 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  46+ F0B0 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  47+ F0B2 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque del banco (dinamica)
  48+ F0B4 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  49+ F0B6 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  50+ F0B8 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  51+ F0BA
  52+ F0BA              MilestoneResolveTable:
  53+ F0BA 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  54+ F0BC 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  55+ F0BE 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  56+ F0C0 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  57+ F0C2 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  58+ F0C4 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  59+ F0C6 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  60+ F0C8 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  61+ F0CA 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  62+ F0CC 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  63+ F0CE 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
