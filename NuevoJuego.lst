  16+ 819D              ; TABLA DE ENTIDADES (estilo Sabre Wulf)
  17+ 819D              ; ==============================================================================
  18+ 819D              ; 17 slots × 16 bytes = 272 bytes.
  19+ 819D              ; Slot 0: Player. Slots 1-6: Inmortales. Slots 7-10: Nasties. Slot 11: Muerte.
  20+ 819D              ; Slot 12: libre. Slots 13-16: Objetos.
  21+ 819D              ; Cada entidad: SpriteID, Type, State, PosX, PosY, Attr, DeltaX, DeltaY,
  22+ 819D              ;               AnimBase, AnimTimer, Dir, Flags, OldX, OldY, OldSprID, DrawX
  23+ 819D              ; ==============================================================================
  24+ 819D 00 00 00...  EntityTable:        DEFS NUM_ENTITIES * ENT_SIZE
