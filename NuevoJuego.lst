 517+ 8FD9                  ; --- BANK 6 PAGED. NO STACK OPS. NO CALLs. ---
 518+ 8FD9 3A BD 97         LD A, (MaiGapScreenId)
 519+ 8FDC 6F               LD L, A
 520+ 8FDD 26 00            LD H, 0
 521+ 8FDF 29               ADD HL, HL                      ; *2
 522+ 8FE0 11 00 C0         LD DE, ScreenGapsTable
 523+ 8FE3 19               ADD HL, DE                      ; HL = &ScreenGapsTable[sid]
