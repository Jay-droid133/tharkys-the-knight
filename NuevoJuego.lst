 652+ E7FB              DrawZoneCountHUD:
 653+ E7FB 3A 00 5D         LD A, (ZoneCellCount)
 654+ E7FE                  ; Hi nibble
 655+ E7FE 47               LD B, A
 656+ E7FF CB 3F            SRL A
 657+ E801 CB 3F            SRL A
 658+ E803 CB 3F            SRL A
 659+ E805 CB 3F            SRL A
 660+ E807 FE 0A            CP 10
 661+ E809 38 04            JR C, .dzcHiDigit
 662+ E80B C6 37            ADD A, 'A' - 10
 663+ E80D 18 02            JR .dzcHiOut
