 781+ EFD4              .pxNC:
 782+ EFD4 7E               LD A, (HL)
 783+ EFD5 23               INC HL
 784+ EFD6 66               LD H, (HL)
 785+ EFD7 81               ADD A, C                    ; sumar colOffset
 786+ EFD8 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EFD9
 788+ EFD9                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EFD9 7A               LD A, D
 790+ EFDA 2F               CPL
 791+ EFDB A6               AND (HL)
 792+ EFDC 77               LD (HL), A
 793+ EFDD
 794+ EFDD E1               POP HL                      ; restaurar puntero datos
 795+ EFDE 18 D0            JR .pxLoop
