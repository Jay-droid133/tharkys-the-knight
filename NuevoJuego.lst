4371+ BA66              _CountSlots:
4372+ BA66 0E 00            LD C, 0                         ; Contador
4373+ BA68              .countLoop:
4374+ BA68 7E               LD A, (HL)
4375+ BA69 B7               OR A
4376+ BA6A 28 16            JR Z, .countNext                ; Slot vacio: no contar
4377+ BA6C                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4378+ BA6C D5               PUSH DE
4379+ BA6D 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4380+ BA70 19               ADD HL, DE
4381+ BA71 7E               LD A, (HL)
4382+ BA72 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4383+ BA74 D1               POP DE
4384+ BA75 FE 03            CP STATE_DYING
4385+ BA77 28 09            JR Z, .countNext
4386+ BA79 FE 04            CP STATE_SPAWNING
4387+ BA7B 28 05            JR Z, .countNext
4388+ BA7D FE 05            CP STATE_SCARED
4389+ BA7F 28 01            JR Z, .countNext
4390+ BA81 0C               INC C
4391+ BA82              .countNext:
4392+ BA82 11 10 00         LD DE, ENT_SIZE
4393+ BA85 19               ADD HL, DE
4394+ BA86 10 E0            DJNZ .countLoop
4395+ BA88 79               LD A, C
4396+ BA89 C9               RET
