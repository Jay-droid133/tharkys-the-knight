1555+ AAF2
1556+ AAF2 00           .speed:  DEFB 0
1557+ AAF3              ; Tablas de boost: [entero, fraccion_256] por nivel de enemigos
1558+ AAF3              ; Fraccion: 128=+0.5, 64=+0.25, 192=+0.75
1559+ AAF3              ; Monsters usan un grado menos que nasties (ralentizan menos la CPU)
1560+ AAF3 00           .savedX: DEFB 0
1561+ AAF4 00           .savedY: DEFB 0
1562+ AAF5 00           .tmpNewX: DEFB 0
1563+ AAF6 00           .tmpNewY: DEFB 0
1564+ AAF7 00           .savedYStep: DEFB 0
1565+ AAF8 00           .savedXShift: DEFB 0
1566+ AAF9              ; Flag: el step-up/down (X collision) modifico Y este frame -> el bloque
1567+ AAF9              ; vertical debe ignorar el input S/N para no compensar el snap. Simetrico
1568+ AAF9              ; para sidestep (Y collision): si modifico X, .skipHoriz no aplica porque
1569+ AAF9              ; horizontal corre primero. Solo .skipVertical es necesario.
1570+ AAF9 00           .skipVertical: DEFB 0
1571+ AAFA
1572+ AAFA              ; ==============================================================================
1573+ AAFA              ; CheckPlayerMonsterOverlap - Bloquear player contra monsters (colision solida)
1574+ AAFA              ; ==============================================================================
1575+ AAFA              ; IX = player entity. Comprueba AABB con todos los monsters activos.
1576+ AAFA              ; Usa GetSpriteDims para dimensiones reales (soporta monsters de cualquier tamaño).
1577+ AAFA              ; Retorna Z=libre, NZ=bloqueado por algun monster.
1578+ AAFA              ; ==============================================================================
1579+ AAFA              CheckPlayerMonsterOverlap:
1580+ AAFA                  ; Debug noclip: Z = libre siempre (sin bloqueo por monsters)
1581+ AAFA 3A 5D 82         LD A, (NoclipMode)
1582+ AAFD B7               OR A
1583+ AAFE 28 02            JR Z, .cpmoReal
1584+ AB00 AF               XOR A
1585+ AB01 C9               RET
1586+ AB02              .cpmoReal:
1587+ AB02                  ; Guardar IX (player)
1588+ AB02 DD E5            PUSH IX
1589+ AB04                  ; Siempre usar ancho de CUERPO (16px), no espada (24px)
1590+ AB04                  ; Asi la espada puede solapar pero el cuerpo no
1591+ AB04 3E 10            LD A, 16
1592+ AB06 32 91 AB         LD (.cpmoPlW), A
1593+ AB09 3E 15            LD A, 21                            ; Altura player fija
1594+ AB0B 32 92 AB         LD (.cpmoPlH), A
1595+ AB0E                  ; Player pos
1596+ AB0E DD E1            POP IX
1597+ AB10 DD E5            PUSH IX
1598+ AB12 DD 7E 03         LD A, (IX+ENT_POSX)
1599+ AB15 32 8F AB         LD (.cpmoPlX), A
1600+ AB18 DD 7E 04         LD A, (IX+ENT_POSY)
1601+ AB1B 32 90 AB         LD (.cpmoPlY), A
1602+ AB1E
1603+ AB1E DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1604+ AB22 06 03            LD B, MONSTERS_TO_SPAWN
1605+ AB24              .cpmoLoop:
1606+ AB24 C5               PUSH BC
1607+ AB25                  ; Solo monsters activos, no muriendo/spawneando/asustados (scared = atravesables)
1608+ AB25 DD 7E 01         LD A, (IX+ENT_TYPE)
1609+ AB28 FE 02            CP TYPE_MONSTER
1610+ AB2A 20 57            JR NZ, .cpmoNext
1611+ AB2C DD 7E 02         LD A, (IX+ENT_STATE)
1612+ AB2F FE 03            CP STATE_DYING
1613+ AB31 28 50            JR Z, .cpmoNext
1614+ AB33 FE 04            CP STATE_SPAWNING
1615+ AB35 28 4C            JR Z, .cpmoNext
