 60   85F6                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
  1+  85F6              ; ==============================================================================
  2+  85F6              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
  3+  85F6              ; ==============================================================================
  4+  85F6              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
  5+  85F6              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
  6+  85F6              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
  7+  85F6              ; ==============================================================================
  8+  85F6
  9+  85F6              ; ==============================================================================
 10+  85F6              ; InitScreenSystem - Inicializa el sistema de pantallas
 11+  85F6              ; ==============================================================================
 12+  85F6              InitScreenSystem:
 13+  85F6 3E 08            LD A, START_SCREEN_X
 14+  85F8 32 04 81         LD (CurrentScreenX), A
 15+  85FB 3E 08            LD A, START_SCREEN_Y
 16+  85FD 32 05 81         LD (CurrentScreenY), A
 17+  8600 3E 01            LD A, 1
 18+  8602 32 09 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
 19+  8605 AF               XOR A
 20+  8606 32 08 81         LD (ScreenTransition), A
 21+  8609 CD 0D 86         CALL CalcScreenAddress
 22+  860C C9               RET
 23+  860D
 24+  860D              ; ==============================================================================
 25+  860D              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
 26+  860D              ; ==============================================================================
 27+  860D              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
 28+  860D              ; ==============================================================================
 29+  860D              CalcScreenAddress:
 30+  860D 3A 05 81         LD A, (CurrentScreenY)
 31+  8610 6F               LD L, A
 32+  8611 26 00            LD H, 0
 33+  8613 29               ADD HL, HL                  ; x2
 34+  8614 29               ADD HL, HL                  ; x4
 35+  8615 29               ADD HL, HL                  ; x8
 36+  8616 29               ADD HL, HL                  ; x16
 37+  8617 3A 04 81         LD A, (CurrentScreenX)
 38+  861A 5F               LD E, A
 39+  861B 16 00            LD D, 0
 40+  861D 19               ADD HL, DE                  ; HL = Y*16 + X
 41+  861E 11 03 88         LD DE, MapTable
 42+  8621 19               ADD HL, DE                  ; HL = &MapTable[index]
 43+  8622 7E               LD A, (HL)                  ; A = room index (0-47)
 44+  8623                  ; Lookup en RoomTable (tabla de DEFWs)
 45+  8623 6F               LD L, A
 46+  8624 26 00            LD H, 0
 47+  8626 29               ADD HL, HL                  ; index * 2
 48+  8627 11 A3 87         LD DE, RoomTable
 49+  862A 19               ADD HL, DE
 50+  862B 5E               LD E, (HL)
 51+  862C 23               INC HL
 52+  862D 56               LD D, (HL)                  ; DE = puntero a room data
 53+  862E ED 53 06 81      LD (CurrentScreenAddr), DE
 54+  8632 C9               RET
 55+  8633
 56+  8633              ; ==============================================================================
 57+  8633              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
 58+  8633              ; ==============================================================================
 59+  8633              CheckScreenTransition:
 60+  8633 AF               XOR A
 61+  8634 32 08 81         LD (ScreenTransition), A
 62+  8637
 63+  8637                  ; --- Comprobar borde OESTE (izquierdo) ---
 64+  8637 3A 39 80         LD A, (EntityTable + ENT_POSX)
 65+  863A FE 04            CP TRANSITION_ZONE
 66+  863C 30 16            JR NC, .noWest
 67+  863E 3A 04 81         LD A, (CurrentScreenX)
 68+  8641 B7               OR A
 69+  8642 28 10            JR Z, .noWest
 70+  8644 3D               DEC A
 71+  8645 32 04 81         LD (CurrentScreenX), A
 72+  8648 3E 08            LD A, DIR_W
 73+  864A 32 08 81         LD (ScreenTransition), A
 74+  864D 3E E0            LD A, SCREEN_MAX_X - 8
 75+  864F 32 39 80         LD (EntityTable + ENT_POSX), A
 76+  8652 18 57            JR .doTransition
 77+  8654
 78+  8654              .noWest:
 79+  8654                  ; --- Comprobar borde ESTE (derecho) ---
 80+  8654 3A 39 80         LD A, (EntityTable + ENT_POSX)
