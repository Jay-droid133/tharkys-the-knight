 881+ F2BD
 882+ F2BD              ; ==============================================================================
 883+ F2BD              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 884+ F2BD              ; ==============================================================================
 885+ F2BD              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 886+ F2BD              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 887+ F2BD              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 888+ F2BD              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 889+ F2BD              ; monstruo cae alli con la puerta abierta:
 890+ F2BD              ;   - Bit slot en MonsterTrappedFlags
 891+ F2BD              ;   - Despawn del monstruo (puff)
 892+ F2BD              ;   - Puerta se re-cierra (sprite + flag)
 893+ F2BD              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 894+ F2BD              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 895+ F2BD              ;
 896+ F2BD              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 897+ F2BD              ; auto-generadas por el level editor segun la posicion de la puerta y los
 898+ F2BD              ; markers AltKey1/AltKey2.
 899+ F2BD              ; ==============================================================================
 900+ F2BD
 901+ F2BD              ; ==============================================================================
 902+ F2BD              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 903+ F2BD              ; ==============================================================================
 904+ F2BD              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 905+ F2BD              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 906+ F2BD              ; Destruye: AF, BC.
 907+ F2BD              ; ==============================================================================
 908+ F2BD              CheckChurchTrap:
 909+ F2BD                  ; --- Solo en pantalla de la iglesia ---
 910+ F2BD 3A 01 83         LD A, (CurrentScreenX)
 911+ F2C0 FE 0F            CP CHURCH_TRAP_SCREEN_X
 912+ F2C2 20 5D            JR NZ, .cctNoTrap
 913+ F2C4 3A 02 83         LD A, (CurrentScreenY)
 914+ F2C7 FE 06            CP CHURCH_TRAP_SCREEN_Y
 915+ F2C9 20 56            JR NZ, .cctNoTrap
 916+ F2CB                  ; --- Solo con la puerta abierta ---
 917+ F2CB 3A AA 82         LD A, (ChurchDoorOpen)
 918+ F2CE B7               OR A
 919+ F2CF 28 50            JR Z, .cctNoTrap
 920+ F2D1                  ; --- Solo si el knockback es DIRECTO del player ---
 921+ F2D1                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 922+ F2D1                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 923+ F2D1                  ; espada y se clear cuando se hereda kb por colision.
 924+ F2D1 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 925+ F2D5 28 4A            JR Z, .cctNoTrap
 926+ F2D7                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 927+ F2D7                  ; (acepta sprites de 16, 21 o 24 px de alto)
 928+ F2D7 DD 7E 04         LD A, (IX+ENT_POSY)
 929+ F2DA CB 3F            SRL A
 930+ F2DC CB 3F            SRL A
 931+ F2DE CB 3F            SRL A                                   ; A = top charY del monster
 932+ F2E0 47               LD B, A
 933+ F2E1 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 934+ F2E3 90               SUB B                                   ; A = trap_charY - mon_charY
 935+ F2E4 FE 03            CP 3
 936+ F2E6 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 937+ F2E8                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 938+ F2E8 DD 7E 03         LD A, (IX+ENT_POSX)
 939+ F2EB CB 3F            SRL A
 940+ F2ED CB 3F            SRL A
 941+ F2EF CB 3F            SRL A
 942+ F2F1 47               LD B, A                                 ; B = left charX del monster
 943+ F2F2 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 944+ F2F4 3C               INC A                                   ; A = LO_X + 1
 945+ F2F5 90               SUB B                                   ; A = LO_X+1 - charX
 946+ F2F6 FE 03            CP 3
 947+ F2F8 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 948+ F2FA                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 949+ F2FA                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 950+ F2FA DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 951+ F2FD D6 4C            SUB SPRID_MONSTER_0
 952+ F2FF CB 3F            SRL A
 953+ F301 CB 3F            SRL A
 954+ F303 CB 3F            SRL A                                   ; A = type idx 0..2
 955+ F305 47               LD B, A
 956+ F306                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 957+ F306 3A B8 82         LD A, (NextChurchTrapStep)
 958+ F309 FE 03            CP 3
 959+ F30B 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 960+ F30D 21 23 F3         LD HL, ChurchTrapOrderTable
 961+ F310 5F               LD E, A
 962+ F311 16 00            LD D, 0
 963+ F313 19               ADD HL, DE
 964+ F314 7E               LD A, (HL)                              ; A = type esperado
 965+ F315 B8               CP B
 966+ F316 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 967+ F318                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 968+ F318 CD BB F3         CALL TriggerChurchTrap
 969+ F31B 3E 01            LD A, 1
 970+ F31D C9               RET
 971+ F31E              .cctBlockAsWall:
 972+ F31E                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 973+ F31E                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 974+ F31E 3E 02            LD A, 2
 975+ F320 C9               RET
 976+ F321              .cctNoTrap:
 977+ F321 AF               XOR A
 978+ F322 C9               RET
 979+ F323
 980+ F323              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 981+ F323              ChurchTrapOrderTable:
 982+ F323 00 02 01         DEFB 0, 2, 1
 983+ F326
 984+ F326              ; ==============================================================================
 985+ F326              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 986+ F326              ; blanco brillante sobre paper negro ($47).
 987+ F326              ; ==============================================================================
 988+ F326              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 989+ F326              ; - No-op fuera de la sala de la iglesia.
 990+ F326              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 991+ F326              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 992+ F326              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 993+ F326              ;   aun no toca) conservan sus attrs originales del sprite.
 994+ F326              ; Destruye: AF, BC, DE, HL.
 995+ F326              ; ==============================================================================
 996+ F326              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 997+ F326              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 998+ F326              HighlightExpectedStatue:
 999+ F326 3E 47            LD A, $47
1000+ F328 18 00            JR PaintExpectedStatueAttr
1001+ F32A
1002+ F32A              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
1003+ F32A              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
1004+ F32A              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
1005+ F32A              PaintExpectedStatueAttr:
1006+ F32A 32 94 F3         LD (.hesAttr), A
1007+ F32D                  ; --- Solo en la sala de la iglesia ---
1008+ F32D 3A 01 83         LD A, (CurrentScreenX)
1009+ F330 FE 0F            CP CHURCH_TRAP_SCREEN_X
1010+ F332 C0               RET NZ
1011+ F333 3A 02 83         LD A, (CurrentScreenY)
1012+ F336 FE 06            CP CHURCH_TRAP_SCREEN_Y
1013+ F338 C0               RET NZ
1014+ F339                  ; --- Solo tras abrir la iglesia 1a vez ---
1015+ F339                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
1016+ F339                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
1017+ F339                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
1018+ F339                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
1019+ F339                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
1020+ F339 3A AB 82         LD A, (ChurchEverOpened)
1021+ F33C B7               OR A
1022+ F33D C8               RET Z
1023+ F33E                  ; --- Solo si quedan monstruos por atrapar ---
1024+ F33E 3A B8 82         LD A, (NextChurchTrapStep)
1025+ F341 FE 03            CP 3
1026+ F343 D0               RET NC
1027+ F344                  ; --- Type esperado -> statue id ---
1028+ F344 21 23 F3         LD HL, ChurchTrapOrderTable
1029+ F347 5F               LD E, A
1030+ F348 16 00            LD D, 0
1031+ F34A 19               ADD HL, DE
1032+ F34B 7E               LD A, (HL)                              ; type idx esperado
1033+ F34C 21 B1 64         LD HL, StatueIdTable
1034+ F34F 5F               LD E, A
1035+ F350 16 00            LD D, 0
1036+ F352 19               ADD HL, DE
1037+ F353 7E               LD A, (HL)                              ; A = statue id
1038+ F354 B7               OR A
1039+ F355 C8               RET Z
1040+ F356 32 95 F3         LD (.hesTargetId), A
1041+ F359                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1042+ F359 2A 03 83         LD HL, (CurrentScreenAddr)
1043+ F35C              .hesLoop:
1044+ F35C 7E               LD A, (HL)
1045+ F35D FE FF            CP $FF
1046+ F35F C8               RET Z                                   ; estatua no en esta sala
1047+ F360 47               LD B, A
1048+ F361 3A 95 F3         LD A, (.hesTargetId)
1049+ F364 B8               CP B
1050+ F365 28 06            JR Z, .hesFound
1051+ F367 11 04 00         LD DE, 4
1052+ F36A 19               ADD HL, DE
1053+ F36B 18 EF            JR .hesLoop
1054+ F36D              .hesFound:
1055+ F36D 23               INC HL
1056+ F36E 7E               LD A, (HL)                              ; charX
1057+ F36F 47               LD B, A
1058+ F370 23               INC HL
1059+ F371 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1060+ F372 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1061+ F374 4F               LD C, A                                 ; C = charY (post-HUD)
1062+ F375                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1063+ F375 26 00            LD H, 0
1064+ F377 69               LD L, C
1065+ F378 29               ADD HL, HL
1066+ F379 29               ADD HL, HL
1067+ F37A 29               ADD HL, HL
1068+ F37B 29               ADD HL, HL
1069+ F37C 29               ADD HL, HL                              ; HL = charY * 32
1070+ F37D 58               LD E, B
1071+ F37E 16 00            LD D, 0
1072+ F380 19               ADD HL, DE                              ; + charX
1073+ F381 11 00 58         LD DE, $5800
1074+ F384 19               ADD HL, DE                              ; HL = attr addr top-left
1075+ F385                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1076+ F385                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1077+ F385                  ; no hace falta sincronizar CleanAttrMap.
1078+ F385 3A 94 F3         LD A, (.hesAttr)
1079+ F388 06 03            LD B, 3                                 ; 3 filas de chars
1080+ F38A              .hesRow:
1081+ F38A 77               LD (HL), A
1082+ F38B 23               INC HL
1083+ F38C 77               LD (HL), A                              ; (charX+1)
1084+ F38D 11 1F 00         LD DE, 31
1085+ F390 19               ADD HL, DE                              ; siguiente fila col 0
1086+ F391 10 F7            DJNZ .hesRow
1087+ F393 C9               RET
1088+ F394 00           .hesAttr:     DEFB 0
1089+ F395 00           .hesTargetId: DEFB 0
1090+ F396
1091+ F396              ; ==============================================================================
1092+ F396              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1093+ F396              ; ==============================================================================
1094+ F396              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1095+ F396              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1096+ F396              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1097+ F396              ; + ON final settle): 8 ciclos de ON-OFF en total.
1098+ F396              ; ==============================================================================
1099+ F396              STATUE_BLINK_FRAMES   EQU 32
1100+ F396
1101+ F396              StartStatueBlink:
1102+ F396                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1103+ F396                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1104+ F396                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1105+ F396                  ; (caso A), .cbtActChurchDoor (caso B).
1106+ F396 3E 20            LD A, STATUE_BLINK_FRAMES
1107+ F398 32 B9 82         LD (StatueBlinkCounter), A
1108+ F39B C3 26 F3         JP HighlightExpectedStatue              ; initial ON paint
1109+ F39E
1110+ F39E              UpdateStatueBlink:
1111+ F39E                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1112+ F39E 3A B9 82         LD A, (StatueBlinkCounter)
1113+ F3A1 B7               OR A
1114+ F3A2 C8               RET Z
1115+ F3A3 3D               DEC A
1116+ F3A4 32 B9 82         LD (StatueBlinkCounter), A
1117+ F3A7 20 03            JR NZ, .usbInProgress
1118+ F3A9                  ; Counter recien llego a 0: settle ON
1119+ F3A9 C3 26 F3         JP HighlightExpectedStatue
1120+ F3AC              .usbInProgress:
1121+ F3AC                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1122+ F3AC                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1123+ F3AC CB 3F            SRL A
1124+ F3AE E6 01            AND $01
1125+ F3B0 28 05            JR Z, .usbOff
1126+ F3B2 3E 47            LD A, $47
1127+ F3B4 C3 2A F3         JP PaintExpectedStatueAttr
1128+ F3B7              .usbOff:
1129+ F3B7 AF               XOR A
1130+ F3B8 C3 2A F3         JP PaintExpectedStatueAttr
1131+ F3BB
1132+ F3BB              ; ==============================================================================
1133+ F3BB              ; CUTSCENE - parametros ajustables
1134+ F3BB              ; ==============================================================================
1135+ F3BB              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1136+ F3BB              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1137+ F3BB              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1138+ F3BB              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1139+ F3BB
1140+ F3BB              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1141+ F3BB              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1142+ F3BB              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1143+ F3BB
1144+ F3BB              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1145+ F3BB              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1146+ F3BB              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1147+ F3BB              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1148+ F3BB              ;   tick 12 -> erase smoke[2], pasar a DONE
1149+ F3BB              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1150+ F3BB              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1151+ F3BB
1152+ F3BB              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1153+ F3BB              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1154+ F3BB              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1155+ F3BB              ; centrado dentro del vano de la puerta.
1156+ F3BB              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1157+ F3BB              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1158+ F3BB              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1159+ F3BB              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1160+ F3BB
1161+ F3BB              ; ==============================================================================
1162+ F3BB              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1163+ F3BB              ; ==============================================================================
1164+ F3BB              ; IN: IX = monster atrapado.
1165+ F3BB              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1166+ F3BB              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1167+ F3BB              ; en ApplyChurchTrapEffects al final del cutscene.
1168+ F3BB              ; ==============================================================================
1169+ F3BB              TriggerChurchTrap:
1170+ F3BB                  ; --- 1. Calcular slot 0..2 ---
1171+ F3BB DD E5            PUSH IX
1172+ F3BD E1               POP HL
1173+ F3BE 11 A4 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1174+ F3C1 B7               OR A
1175+ F3C2 ED 52            SBC HL, DE
1176+ F3C4 CB 3D            SRL L
1177+ F3C6 CB 3D            SRL L
1178+ F3C8 CB 3D            SRL L
1179+ F3CA CB 3D            SRL L                                   ; L = slot 0..2
1180+ F3CC 7D               LD A, L
1181+ F3CD 32 9E 5F         LD (ChurchCutsceneSlot), A
1182+ F3D0                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1183+ F3D0 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1184+ F3D3 D6 4C            SUB SPRID_MONSTER_0
1185+ F3D5 CB 3F            SRL A
1186+ F3D7 CB 3F            SRL A
1187+ F3D9 CB 3F            SRL A                                   ; A = type idx
1188+ F3DB 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1189+ F3DE                  ; --- 2. Mover monster al centro del vano ---
1190+ F3DE 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1191+ F3E0 DD 77 03         LD (IX+ENT_POSX), A
1192+ F3E3 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1193+ F3E5 DD 77 04         LD (IX+ENT_POSY), A
1194+ F3E8 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1195+ F3EC DD 36 07 00      LD (IX+ENT_DELTAY), 0
1196+ F3F0 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1197+ F3F4                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1198+ F3F4                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1199+ F3F4                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1200+ F3F4                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1201+ F3F4                  ; temblor se vea con ink blanco brillante sobre paper negro.
1202+ F3F4 AF               XOR A
1203+ F3F5 32 B9 82         LD (StatueBlinkCounter), A              ; parar blink
1204+ F3F8 DD E5            PUSH IX
1205+ F3FA CD 26 F3         CALL HighlightExpectedStatue            ; pintar $47
1206+ F3FD                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1207+ F3FD                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1208+ F3FD                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1209+ F3FD                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1210+ F3FD CD F4 BA         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1211+ F400 3E FF            LD A, $FF
1212+ F402 CD B3 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1213+ F405                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1214+ F405                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1215+ F405                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1216+ F405 3A B8 82         LD A, (NextChurchTrapStep)
1217+ F408 FE 02            CP 2
1218+ F40A CC 1F FB         CALL Z, StopMonstersMusic
1219+ F40D DD E1            POP IX
1220+ F40F                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1221+ F40F 3E 01            LD A, 1
1222+ F411 32 BF 82         LD (ChurchCutscenePhase), A
1223+ F414 AF               XOR A
1224+ F415 32 9D 5F         LD (ChurchCutsceneFrame), A
1225+ F418 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1226+ F41A 32 A4 5F         LD (ChurchCutsceneLookCount), A
1227+ F41D C9               RET
1228+ F41E
1229+ F41E              ; ==============================================================================
1230+ F41E              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1231+ F41E              ; ==============================================================================
1232+ F41E              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1233+ F41E              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1234+ F41E              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1235+ F41E              ; ==============================================================================
1236+ F41E              UpdateChurchCutscene:
1237+ F41E 3A BF 82         LD A, (ChurchCutscenePhase)
1238+ F421 B7               OR A
1239+ F422 C8               RET Z
1240+ F423 3D               DEC A
1241+ F424 28 12            JR Z, .ucsLookPhase
1242+ F426 3D               DEC A
1243+ F427 28 38            JR Z, .ucsShakeStatuePhase
1244+ F429 3D               DEC A
1245+ F42A CA B3 F4         JP Z, .ucsSmokePhase
1246+ F42D                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1247+ F42D CD 0D 64         CALL ApplyChurchTrapDone
1248+ F430 AF               XOR A
1249+ F431 32 BF 82         LD (ChurchCutscenePhase), A
1250+ F434 32 9D 5F         LD (ChurchCutsceneFrame), A
1251+ F437 C9               RET
1252+ F438
1253+ F438              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1254+ F438              .ucsLookPhase:
1255+ F438                  ; Frame counter (para detectar fin de fase)
1256+ F438 21 9D 5F         LD HL, ChurchCutsceneFrame
1257+ F43B 34               INC (HL)
1258+ F43C                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1259+ F43C 21 A4 5F         LD HL, ChurchCutsceneLookCount
1260+ F43F 35               DEC (HL)
1261+ F440 20 06            JR NZ, .ucsLookCheckEnd
1262+ F442 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1263+ F444 77               LD (HL), A
1264+ F445 CD 01 F5         CALL ChurchCutsceneToggleMonsterDir
1265+ F448              .ucsLookCheckEnd:
1266+ F448 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1267+ F44B FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1268+ F44D D8               RET C                                   ; sigue mirando
1269+ F44E                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1270+ F44E                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1271+ F44E                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1272+ F44E CD E9 63         CALL EraseChurchTrappedMonster
1273+ F451 CD A7 66         CALL CloseChurchDoor
1274+ F454 CD 26 F5         CALL ChurchCutsceneInitStatueShake
1275+ F457 3E 02            LD A, 2
1276+ F459 32 BF 82         LD (ChurchCutscenePhase), A
1277+ F45C AF               XOR A
1278+ F45D 32 9D 5F         LD (ChurchCutsceneFrame), A
1279+ F460 C9               RET
1280+ F461
1281+ F461              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1282+ F461              .ucsShakeStatuePhase:
1283+ F461 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1284+ F464 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1285+ F466 30 35            JR NC, .ucsShakeStatueDone
1286+ F468                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1287+ F468                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1288+ F468                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1289+ F468                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1290+ F468                  ;
1291+ F468                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1292+ F468                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1293+ F468 ED 5F            LD A, R
1294+ F46A E6 03            AND $03
1295+ F46C 21 99 F4         LD HL, .ucsShakeJitterTable
1296+ F46F 5F               LD E, A
1297+ F470 16 00            LD D, 0
1298+ F472 19               ADD HL, DE
1299+ F473 7E               LD A, (HL)
1300+ F474 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1301+ F475                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1302+ F475 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1303+ F478 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1304+ F47A 21 B1 64         LD HL, StatueIdTable
1305+ F47D 38 03            JR C, .ucsShakeTablePicked
1306+ F47F 21 B4 64         LD HL, StatueBrokenIdTable
1307+ F482              .ucsShakeTablePicked:
1308+ F482 78               LD A, B                                 ; restore jitter para la llamada
1309+ F483 CD 90 F5         CALL ChurchCutsceneShakeStatueByteShift
1310+ F486                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1311+ F486                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1312+ F486                  ; y al salir de la fase forzamos borde a negro explicitamente.
1313+ F486 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1314+ F489 E6 01            AND $01
1315+ F48B 28 04            JR Z, .ucsShakeBorderBlack
1316+ F48D 3E 07            LD A, WHITE
1317+ F48F 18 01            JR .ucsShakeBorderOut
1318+ F491              .ucsShakeBorderBlack:
1319+ F491 AF               XOR A                                   ; BLACK
1320+ F492              .ucsShakeBorderOut:
1321+ F492 D3 FE            OUT (254), A
1322+ F494 21 9D 5F         LD HL, ChurchCutsceneFrame
1323+ F497 34               INC (HL)
1324+ F498 C9               RET
1325+ F499              .ucsShakeJitterTable:
1326+ F499 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1327+ F49D              .ucsShakeStatueDone:
1328+ F49D                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1329+ F49D AF               XOR A
1330+ F49E D3 FE            OUT (254), A
1331+ F4A0                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1332+ F4A0                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1333+ F4A0                  ; directo a 0 garantiza que no queden residuos.)
1334+ F4A0 CD FB F5         CALL ChurchCutsceneEraseStatueDirect
1335+ F4A3 21 A3 F9         LD HL, SFX_EnemyDeath
1336+ F4A6 CD 24 F9         CALL PlaySFX
1337+ F4A9 3E 03            LD A, 3
1338+ F4AB 32 BF 82         LD (ChurchCutscenePhase), A
1339+ F4AE AF               XOR A
1340+ F4AF 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1341+ F4B2 C9               RET
1342+ F4B3
1343+ F4B3              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1344+ F4B3              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1345+ F4B3              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1346+ F4B3              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1347+ F4B3              ; Entre transiciones, solo incrementa frame counter.
1348+ F4B3              .ucsSmokePhase:
1349+ F4B3 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1350+ F4B6 B7               OR A
1351+ F4B7 28 0E            JR Z, .ucsSmokeEntry
1352+ F4B9 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1353+ F4BB 28 16            JR Z, .ucsSmokeStep1
1354+ F4BD FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1355+ F4BF 28 1D            JR Z, .ucsSmokeStep2
1356+ F4C1 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1357+ F4C3 28 25            JR Z, .ucsSmokeEnd
1358+ F4C5 18 35            JR .ucsSmokeIncFrame
1359+ F4C7              .ucsSmokeEntry:
1360+ F4C7                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1361+ F4C7 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1362+ F4CA CD DC 65         CALL DrawRemainsForType
1363+ F4CD                  ; Dibujar smoke[0] (XOR)
1364+ F4CD AF               XOR A
1365+ F4CE CD 27 65         CALL DrawSmokeFrameXor
1366+ F4D1 18 29            JR .ucsSmokeIncFrame
1367+ F4D3              .ucsSmokeStep1:
1368+ F4D3 AF               XOR A
1369+ F4D4 CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1370+ F4D7 3E 01            LD A, 1
1371+ F4D9 CD 27 65         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1372+ F4DC 18 1E            JR .ucsSmokeIncFrame
1373+ F4DE              .ucsSmokeStep2:
1374+ F4DE 3E 01            LD A, 1
1375+ F4E0 CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1376+ F4E3 3E 02            LD A, 2
1377+ F4E5 CD 27 65         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1378+ F4E8 18 12            JR .ucsSmokeIncFrame
1379+ F4EA              .ucsSmokeEnd:
1380+ F4EA 3E 02            LD A, 2
1381+ F4EC CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1382+ F4EF CD 46 65         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1383+ F4F2 3E 04            LD A, 4
1384+ F4F4 32 BF 82         LD (ChurchCutscenePhase), A
1385+ F4F7 AF               XOR A
1386+ F4F8 32 9D 5F         LD (ChurchCutsceneFrame), A
1387+ F4FB C9               RET
1388+ F4FC              .ucsSmokeIncFrame:
1389+ F4FC 21 9D 5F         LD HL, ChurchCutsceneFrame
1390+ F4FF 34               INC (HL)
1391+ F500 C9               RET
1392+ F501
1393+ F501              ; ==============================================================================
1394+ F501              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1395+ F501              ; ==============================================================================
1396+ F501              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1397+ F501              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1398+ F501              ; ==============================================================================
1399+ F501              ChurchCutsceneToggleMonsterDir:
1400+ F501                  ; IX = trapped monster
1401+ F501 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1402+ F504 3C               INC A
1403+ F505 6F               LD L, A
1404+ F506 26 00            LD H, 0
1405+ F508 29               ADD HL, HL
1406+ F509 29               ADD HL, HL
1407+ F50A 29               ADD HL, HL
1408+ F50B 29               ADD HL, HL
1409+ F50C 11 94 81         LD DE, EntityTable
1410+ F50F 19               ADD HL, DE
1411+ F510 E5               PUSH HL
1412+ F511 DD E1            POP IX
1413+ F513                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1414+ F513 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1415+ F516 DD 96 08         SUB (IX+ENT_ANIMBASE)
1416+ F519 EE 04            XOR 4
1417+ F51B 47               LD B, A
1418+ F51C DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1419+ F51F 80               ADD A, B
1420+ F520 DD 77 00         LD (IX+ENT_SPRITEID), A
1421+ F523 C3 15 F6         JP RedrawTrappedMonster
1422+ F526
1423+ F526              ; ==============================================================================
1424+ F526              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1425+ F526              ; ==============================================================================
1426+ F526              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1427+ F526              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1428+ F526              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1429+ F526              ; ==============================================================================
1430+ F526              ChurchCutsceneInitStatueShake:
1431+ F526 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1432+ F529 21 B1 64         LD HL, StatueIdTable
1433+ F52C 5F               LD E, A
1434+ F52D 16 00            LD D, 0
1435+ F52F 19               ADD HL, DE
1436+ F530 7E               LD A, (HL)                              ; A = statue id
1437+ F531 B7               OR A
1438+ F532 C8               RET Z                                   ; sin estatua
1439+ F533 32 63 F5         LD (.cisTargetId), A
1440+ F536                  ; Buscar en CurrentScreenBuffer
1441+ F536 2A 03 83         LD HL, (CurrentScreenAddr)
1442+ F539              .cisLoop:
1443+ F539 7E               LD A, (HL)
1444+ F53A FE FF            CP $FF
1445+ F53C C8               RET Z                                   ; no encontrada (no se hace shake)
1446+ F53D 47               LD B, A
1447+ F53E 3A 63 F5         LD A, (.cisTargetId)
1448+ F541 B8               CP B
1449+ F542 28 06            JR Z, .cisFound
1450+ F544 11 04 00         LD DE, 4
1451+ F547 19               ADD HL, DE
1452+ F548 18 EF            JR .cisLoop
1453+ F54A              .cisFound:
1454+ F54A 23               INC HL
1455+ F54B 7E               LD A, (HL)                              ; charX
1456+ F54C                  ; Pixel X = charX * 8
1457+ F54C 87               ADD A, A
1458+ F54D 87               ADD A, A
1459+ F54E 87               ADD A, A
1460+ F54F 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1461+ F552 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1462+ F555 23               INC HL
1463+ F556 7E               LD A, (HL)                              ; charY
1464+ F557                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1465+ F557 C6 02            ADD A, BG_Y_OFFSET
1466+ F559 87               ADD A, A
1467+ F55A 87               ADD A, A
1468+ F55B 87               ADD A, A
