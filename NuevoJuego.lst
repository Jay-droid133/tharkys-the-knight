7074+ C67D              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
7075+ C67D              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
7076+ C67D              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
7077+ C67D              ; timer >= DEATH_SPAWN_FRAMES).
7078+ C67D              SpawnDeath:
7079+ C67D                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
7080+ C67D                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
7081+ C67D                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
7082+ C67D                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
7083+ C67D                  ; atravesando el mapa.
7084+ C67D CD 3A 94         CALL FindFarthestAnyFreeCell
7085+ C680 C8               RET Z                               ; sin candidato: reintento siguiente frame
7086+ C681              .sdHaveCell:
7087+ C681                  ; B = cx, C = cy
7088+ C681 DD 21 53 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7089+ C685                  ; POSX = cx * 8
7090+ C685 78               LD A, B
7091+ C686 87               ADD A, A
7092+ C687 87               ADD A, A
7093+ C688 87               ADD A, A
7094+ C689 DD 77 03         LD (IX+ENT_POSX), A
7095+ C68C DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
7096+ C68F                  ; POSY = cy * 8 + SCREEN_MIN_Y
7097+ C68F 79               LD A, C
7098+ C690 87               ADD A, A
7099+ C691 87               ADD A, A
7100+ C692 87               ADD A, A
7101+ C693 C6 10            ADD A, SCREEN_MIN_Y
7102+ C695 DD 77 04         LD (IX+ENT_POSY), A
7103+ C698 DD 77 0D         LD (IX+ENT_OLDY), A
