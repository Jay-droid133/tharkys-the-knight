   1+ 8DFA              ; ==============================================================================
   2+ 8DFA              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 8DFA              ; ==============================================================================
   4+ 8DFA              ; Sistema fiel a Sabre Wulf:
   5+ 8DFA              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 8DFA              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 8DFA              ; - NextPixelLine para cruzar character rows y tercios
   8+ 8DFA              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 8DFA              ; ==============================================================================
  10+ 8DFA
  11+ 8DFA              ClearScreen:
  12+ 8DFA CD AF 0D         CALL ROM_CLS
  13+ 8DFD C9               RET
  14+ 8DFE
  15+ 8DFE              ; ==============================================================================
  16+ 8DFE              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 8DFE              ; ==============================================================================
  18+ 8DFE              ; Entrada:
  19+ 8DFE              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 8DFE              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 8DFE              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 8DFE              ;
  23+ 8DFE              ; Formato del sprite:
  24+ 8DFE              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 8DFE              ;   DEFB height_pixels
  26+ 8DFE              ;   DEFB pixel_data... (width * height bytes)
  27+ 8DFE              ;
  28+ 8DFE              ; Dos paths:
  29+ 8DFE              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 8DFE              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 8DFE              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 8DFE              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 8DFE              ;
  34+ 8DFE              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 8DFE              ; ==============================================================================
  36+ 8DFE              DrawSprite:
  37+ 8DFE                  ; Guardar posicion
  38+ 8DFE 7A               LD A, D
  39+ 8DFF 32 B8 8E         LD (.posY), A
  40+ 8E02 7B               LD A, E
  41+ 8E03 32 B7 8E         LD (.posX), A
  42+ 8E06
  43+ 8E06                  ; Leer cabecera sprite
  44+ 8E06 DD 7E 00         LD A, (IX+0)                ; width_bytes
  45+ 8E09 32 B9 8E         LD (.widthSave), A
  46+ 8E0C DD 7E 01         LD A, (IX+1)                ; height_pixels
  47+ 8E0F 32 BA 8E         LD (.heightSave), A
  48+ 8E12 DD 23            INC IX
  49+ 8E14 DD 23            INC IX                      ; IX → pixel data
  50+ 8E16
  51+ 8E16                  ; === Y CLIPPING ===
  52+ 8E16                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  53+ 8E16 3A B8 8E         LD A, (.posY)
  54+ 8E19 FE 10            CP SCREEN_MIN_Y
  55+ 8E1B 30 20            JR NC, .clipTopDone
  56+ 8E1D                  ; Filas a saltar = SCREEN_MIN_Y - Y
  57+ 8E1D 47               LD B, A                     ; B = Y
  58+ 8E1E 3E 10            LD A, SCREEN_MIN_Y
  59+ 8E20 90               SUB B                       ; A = filas a saltar
  60+ 8E21 47               LD B, A                     ; B = skip rows
  61+ 8E22                  ; Reducir altura
  62+ 8E22 3A BA 8E         LD A, (.heightSave)
  63+ 8E25 90               SUB B
  64+ 8E26 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  65+ 8E27 D8               RET C                       ; Idem
  66+ 8E28 32 BA 8E         LD (.heightSave), A
  67+ 8E2B                  ; Avanzar IX: skip_rows * width_bytes
  68+ 8E2B 3A B9 8E         LD A, (.widthSave)
  69+ 8E2E 4F               LD C, A
  70+ 8E2F              .clipSkipRow:
  71+ 8E2F 79               LD A, C
  72+ 8E30              .clipSkipByte:
  73+ 8E30 DD 23            INC IX
  74+ 8E32 3D               DEC A
  75+ 8E33 20 FB            JR NZ, .clipSkipByte
  76+ 8E35 10 F8            DJNZ .clipSkipRow
  77+ 8E37                  ; Ajustar Y al borde
  78+ 8E37 3E 10            LD A, SCREEN_MIN_Y
  79+ 8E39 32 B8 8E         LD (.posY), A
  80+ 8E3C 57               LD D, A
  81+ 8E3D              .clipTopDone:
  82+ 8E3D                  ; Clip inferior: si Y + height > 192, reducir altura
  83+ 8E3D 3A B8 8E         LD A, (.posY)
  84+ 8E40 47               LD B, A
  85+ 8E41 3A BA 8E         LD A, (.heightSave)
  86+ 8E44 80               ADD A, B                    ; A = Y + height
  87+ 8E45 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
  88+ 8E47 FE C0            CP 192
  89+ 8E49 38 08            JR C, .clipBotDone          ; Dentro de pantalla
  90+ 8E4B              .clipBot:
  91+ 8E4B                  ; Reducir altura: new_height = 192 - Y
  92+ 8E4B 3E C0            LD A, 192
  93+ 8E4D 90               SUB B                       ; A = 192 - Y
  94+ 8E4E C8               RET Z
  95+ 8E4F D8               RET C
  96+ 8E50 32 BA 8E         LD (.heightSave), A
  97+ 8E53              .clipBotDone:
  98+ 8E53
  99+ 8E53                  ; Comprobar alineacion
 100+ 8E53 7B               LD A, E
 101+ 8E54 E6 07            AND 7
 102+ 8E56 20 1E            JR NZ, .shifted
 103+ 8E58
 104+ 8E58                  ; ==================================================================
 105+ 8E58                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 106+ 8E58                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 107+ 8E58                  ; ==================================================================
 108+ 8E58 CD 11 91         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 109+ 8E5B DD E5            PUSH IX
 110+ 8E5D D1               POP DE                      ; DE = puntero a pixel data
 111+ 8E5E 3A BA 8E         LD A, (.heightSave)
 112+ 8E61 4F               LD C, A                     ; C = height counter
 113+ 8E62
 114+ 8E62              .alignedLine:
 115+ 8E62 3A B9 8E         LD A, (.widthSave)
 116+ 8E65 47               LD B, A                     ; B = ancho en bytes
 117+ 8E66 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 118+ 8E67
 119+ 8E67              .alignedByte:
 120+ 8E67 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 121+ 8E68 AE               XOR (HL)
 122+ 8E69 77               LD (HL), A
 123+ 8E6A 23               INC HL                      ; Siguiente columna VRAM
 124+ 8E6B 13               INC DE                      ; 6T (era INC IX = 10T)
 125+ 8E6C 10 F9            DJNZ .alignedByte
 126+ 8E6E
 127+ 8E6E E1               POP HL                      ; Restaurar inicio de linea
 128+ 8E6F 0D               DEC C
 129+ 8E70 C8               RET Z                       ; Terminamos todas las lineas
 130+ 8E71 CD BD 8E         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 131+ 8E74 18 EC            JR .alignedLine
 132+ 8E76
 133+ 8E76                  ; ==================================================================
 134+ 8E76                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 135+ 8E76                  ; ==================================================================
 136+ 8E76                  ; A = shift amount (1-7) al llegar aqui
 137+ 8E76              .shifted:
 138+ 8E76                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 139+ 8E76 3D               DEC A                       ; 0-6
 140+ 8E77 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 141+ 8E78 E6 0E            AND $0E
 142+ 8E7A C6 C8            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 143+ 8E7C 32 BB 8E         LD (.tablePage), A
 144+ 8E7F
 145+ 8E7F                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 146+ 8E7F DD E5            PUSH IX
 147+ 8E81 D1               POP DE                      ; DE = puntero a pixel data
 148+ 8E82 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 149+ 8E83
 150+ 8E83                  ; Recargar D=Y, E=X para CalcPixelAddr
 151+ 8E83 3A B8 8E         LD A, (.posY)
 152+ 8E86 57               LD D, A
 153+ 8E87 3A B7 8E         LD A, (.posX)
 154+ 8E8A 5F               LD E, A
 155+ 8E8B CD 11 91         CALL CalcPixelAddr          ; HL = dir VRAM
 156+ 8E8E
 157+ 8E8E D1               POP DE                      ; DE = sprite data ptr restaurado
 158+ 8E8F 3A BB 8E         LD A, (.tablePage)
 159+ 8E92 47               LD B, A                     ; B = pagina high part
 160+ 8E93                  ; Contadores en IX (libre: se convirtio a DE arriba)
 161+ 8E93                  ; IXH = height counter, IXL = width counter (reset cada linea)
 162+ 8E93 3A BA 8E         LD A, (.heightSave)
 163+ 8E96 DD 67            LD IXH, A
 164+ 8E98
 165+ 8E98              .shiftedLine:
 166+ 8E98 E5               PUSH HL                     ; Guardar inicio de linea
 167+ 8E99 3A B9 8E         LD A, (.widthSave)
 168+ 8E9C DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 169+ 8E9E
 170+ 8E9E              .shiftedByte:
 171+ 8E9E                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 172+ 8E9E 1A               LD A, (DE)                  ; Leer byte de sprite
 173+ 8E9F 4F               LD C, A                     ; C = byte value (indice en tabla)
 174+ 8EA0 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 175+ 8EA1 AE               XOR (HL)                    ; XOR con VRAM
 176+ 8EA2 77               LD (HL), A                  ; Escribir
 177+ 8EA3 2C               INC L                       ; Siguiente columna VRAM
 178+ 8EA4 04               INC B                       ; Pagina overflow
 179+ 8EA5 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 180+ 8EA6 AE               XOR (HL)                    ; XOR con VRAM
 181+ 8EA7 77               LD (HL), A                  ; Escribir
 182+ 8EA8 05               DEC B                       ; Restaurar pagina high
 183+ 8EA9 13               INC DE                      ; Siguiente byte de sprite
 184+ 8EAA                  ; Siguiente byte de ancho
 185+ 8EAA DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 186+ 8EAC 20 F0            JR NZ, .shiftedByte         ; 12/7T
 187+ 8EAE
 188+ 8EAE E1               POP HL                      ; Restaurar inicio de linea
 189+ 8EAF DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 190+ 8EB1 C8               RET Z                       ; Terminamos todas las lineas
 191+ 8EB2 CD BD 8E         CALL NextPixelLine          ; HL = siguiente linea
 192+ 8EB5 18 E1            JR .shiftedLine
