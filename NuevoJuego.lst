 138+ AEF9 C2 10 AF         JP NZ, .noEast
 139+ AEFC 3A C8 81         LD A, (CurrentScreenX)
 140+ AEFF 3C               INC A
 141+ AF00 32 C8 81         LD (CurrentScreenX), A
 142+ AF03 3E 04            LD A, DIR_E
 143+ AF05 32 CC 81         LD (ScreenTransition), A
 144+ AF08 3E 00            LD A, SCREEN_MIN_X
 145+ AF0A 32 A1 80         LD (EntityTable + ENT_POSX), A
