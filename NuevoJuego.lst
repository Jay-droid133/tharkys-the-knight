 854+ 64A7 80               ADD A, B
 855+ 64A8 5F               LD E, A
 856+ 64A9 3A A7 5F         LD A, (TownGateShakeOffsY)
 857+ 64AC 47               LD B, A
 858+ 64AD 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 859+ 64AF 80               ADD A, B
 860+ 64B0 57               LD D, A
 861+ 64B1 C3 CF 64         JP DrawBgSpriteAnyXorAtPixel
 862+ 64B4
 863+ 64B4              ; ==============================================================================
 864+ 64B4              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 865+ 64B4              ; ==============================================================================
 866+ 64B4              TownGateDrawFingerShifted:
 867+ 64B4 21 30 E6         LD HL, BgGfx_finger
 868+ 64B7 3E 03            LD A, 3
 869+ 64B9 CD BD 90         CALL LoadBgSpriteToBuffer
 870+ 64BC 3A A6 5F         LD A, (TownGateShakeOffsX)
 871+ 64BF 47               LD B, A
 872+ 64C0 3E 88            LD A, TGCS_FINGER_PX_X
 873+ 64C2 80               ADD A, B
 874+ 64C3 5F               LD E, A
 875+ 64C4 3A A7 5F         LD A, (TownGateShakeOffsY)
 876+ 64C7 47               LD B, A
 877+ 64C8 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 878+ 64CA 80               ADD A, B
 879+ 64CB 57               LD D, A
 880+ 64CC C3 CF 64         JP DrawBgSpriteAnyXorAtPixel
 881+ 64CF
 882+ 64CF              ; ==============================================================================
 883+ 64CF              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 884+ 64CF              ; ==============================================================================
 885+ 64CF              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 886+ 64CF              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 887+ 64CF              ;     E = pixel X (0..255).
 888+ 64CF              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 889+ 64CF              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 890+ 64CF              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 891+ 64CF              ; Destruye: AF, BC, DE, HL, IX.
 892+ 64CF              ; ==============================================================================
 893+ 64CF              DrawBgSpriteAnyXorAtPixel:
 894+ 64CF DD 21 F5 88      LD IX, BgSpriteBuffer
 895+ 64D3 DD 7E 00         LD A, (IX+0)                        ; height_px
 896+ 64D6 B7               OR A
 897+ 64D7 C8               RET Z
 898+ 64D8 32 32 65         LD (.dbsaHeight), A
 899+ 64DB DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 900+ 64DE E6 7F            AND $7F
 901+ 64E0 32 33 65         LD (.dbsaWidth), A
 902+ 64E3 DD 23            INC IX
 903+ 64E5 DD 23            INC IX                              ; -> pixel data
 904+ 64E7 7B               LD A, E
 905+ 64E8 E6 07            AND $07
 906+ 64EA 32 34 65         LD (.dbsaShift), A
 907+ 64ED 7B               LD A, E
 908+ 64EE E6 F8            AND $F8
 909+ 64F0 5F               LD E, A
 910+ 64F1 CD 1C A1         CALL CalcPixelAddr                  ; HL = VRAM addr
 911+ 64F4              .dbsaRow:
 912+ 64F4 E5               PUSH HL
 913+ 64F5 3A 33 65         LD A, (.dbsaWidth)
 914+ 64F8 47               LD B, A                             ; B = width counter
 915+ 64F9 0E 00            LD C, 0                             ; C = carry from prev byte
 916+ 64FB              .dbsaByte:
 917+ 64FB DD 7E 00         LD A, (IX+0)
 918+ 64FE 2F               CPL                                 ; un-invert
 919+ 64FF 57               LD D, A                             ; D = sprite byte
 920+ 6500 1E 00            LD E, 0                             ; E = bits que caen al next byte
 921+ 6502 3A 34 65         LD A, (.dbsaShift)
 922+ 6505 B7               OR A
 923+ 6506 28 09            JR Z, .dbsaNoShift
 924+ 6508 C5               PUSH BC
 925+ 6509 47               LD B, A
 926+ 650A              .dbsaShiftLoop:
 927+ 650A CB 3A            SRL D
 928+ 650C CB 1B            RR E
 929+ 650E 10 FA            DJNZ .dbsaShiftLoop
 930+ 6510 C1               POP BC
 931+ 6511              .dbsaNoShift:
 932+ 6511 7A               LD A, D
 933+ 6512 B1               OR C                                ; combinar con carry previo
 934+ 6513 AE               XOR (HL)
 935+ 6514 77               LD (HL), A
 936+ 6515 23               INC HL
 937+ 6516 4B               LD C, E                             ; nuevo carry para siguiente byte
 938+ 6517 DD 23            INC IX
 939+ 6519 10 E0            DJNZ .dbsaByte
 940+ 651B                  ; Byte final (carry) si shift > 0
 941+ 651B 3A 34 65         LD A, (.dbsaShift)
 942+ 651E B7               OR A
 943+ 651F 28 03            JR Z, .dbsaNoFinal
 944+ 6521 79               LD A, C
 945+ 6522 AE               XOR (HL)
 946+ 6523 77               LD (HL), A
 947+ 6524              .dbsaNoFinal:
 948+ 6524 E1               POP HL
 949+ 6525 CD 88 9E         CALL NextPixelLine
 950+ 6528 3A 32 65         LD A, (.dbsaHeight)
 951+ 652B 3D               DEC A
 952+ 652C 32 32 65         LD (.dbsaHeight), A
 953+ 652F 20 C3            JR NZ, .dbsaRow
 954+ 6531 C9               RET
 955+ 6532 00           .dbsaHeight: DEFB 0
 956+ 6533 00           .dbsaWidth:  DEFB 0
 957+ 6534 00           .dbsaShift:  DEFB 0
