2147+ AE13 20 06            JR NZ, .cwDoCheck
2148+ AE15 3A 6C B6         LD A, (PlayerStamina)
2149+ AE18 FE 10            CP STAMINA_MAX
2150+ AE1A C8               RET Z                               ; Ambos al maximo → nada
2151+ AE1B              .cwDoCheck:
2152+ AE1B                  ; AABB con margen de 8px (1 celda) por cada lado:
2153+ AE1B                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2154+ AE1B                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2155+ AE1B                  ; --- Check X ---
2156+ AE1B 3A BD 90         LD A, (WellPosX)
2157+ AE1E C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2158+ AE20 4F               LD C, A
2159+ AE21 3A 4E 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2160+ AE24 B9               CP C                                ; playerX < wellRight+margen?
2161+ AE25 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2162+ AE27 3A 4E 81         LD A, (EntityTable + ENT_POSX)
2163+ AE2A C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2164+ AE2C 4F               LD C, A
2165+ AE2D 3A BD 90         LD A, (WellPosX)                    ; A = wellX
2166+ AE30 B9               CP C                                ; wellX < playerRight+margen?
2167+ AE31 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2168+ AE33                  ; --- Check Y ---
2169+ AE33 3A BE 90         LD A, (WellPosY)
2170+ AE36 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2171+ AE38 4F               LD C, A
2172+ AE39 3A 4F 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2173+ AE3C B9               CP C                                ; playerY < wellBottom+margen?
2174+ AE3D 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2175+ AE3F 3A 4F 81         LD A, (EntityTable + ENT_POSY)
2176+ AE42 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2177+ AE44 4F               LD C, A
2178+ AE45 3A BE 90         LD A, (WellPosY)                    ; A = wellY
2179+ AE48 B9               CP C                                ; wellY < playerBottom+margen?
2180+ AE49 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2181+ AE4B                  ; --- Overlap! Recuperar salud y stamina ---
2182+ AE4B 3E 10            LD A, HEALTH_MAX
2183+ AE4D 32 6B B6         LD (PlayerHealth), A
2184+ AE50 3E 10            LD A, STAMINA_MAX
