1297+ F68B              ; ==============================================================================
1298+ F68B              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1299+ F68B              ; ==============================================================================
1300+ F68B              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1301+ F68B              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1302+ F68B              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1303+ F68B              ; ==============================================================================
1304+ F68B              ChurchCutsceneInitStatueShake:
1305+ F68B 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1306+ F68E 21 7C 67         LD HL, StatueIdTable
1307+ F691 5F               LD E, A
1308+ F692 16 00            LD D, 0
1309+ F694 19               ADD HL, DE
1310+ F695 7E               LD A, (HL)                              ; A = statue id
1311+ F696 B7               OR A
1312+ F697 C8               RET Z                                   ; sin estatua
1313+ F698 32 C8 F6         LD (.cisTargetId), A
1314+ F69B                  ; Buscar en CurrentScreenBuffer
1315+ F69B 2A B0 82         LD HL, (CurrentScreenAddr)
1316+ F69E              .cisLoop:
1317+ F69E 7E               LD A, (HL)
1318+ F69F FE FF            CP $FF
1319+ F6A1 C8               RET Z                                   ; no encontrada (no se hace shake)
1320+ F6A2 47               LD B, A
1321+ F6A3 3A C8 F6         LD A, (.cisTargetId)
1322+ F6A6 B8               CP B
1323+ F6A7 28 06            JR Z, .cisFound
1324+ F6A9 11 04 00         LD DE, 4
1325+ F6AC 19               ADD HL, DE
1326+ F6AD 18 EF            JR .cisLoop
1327+ F6AF              .cisFound:
1328+ F6AF 23               INC HL
1329+ F6B0 7E               LD A, (HL)                              ; charX
1330+ F6B1                  ; Pixel X = charX * 8
1331+ F6B1 87               ADD A, A
1332+ F6B2 87               ADD A, A
1333+ F6B3 87               ADD A, A
1334+ F6B4 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1335+ F6B7 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1336+ F6BA 23               INC HL
1337+ F6BB 7E               LD A, (HL)                              ; charY
1338+ F6BC                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1339+ F6BC C6 02            ADD A, BG_Y_OFFSET
1340+ F6BE 87               ADD A, A
1341+ F6BF 87               ADD A, A
1342+ F6C0 87               ADD A, A
1343+ F6C1 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1344+ F6C4 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1345+ F6C7 C9               RET
