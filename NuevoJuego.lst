   1+ E635              ; ==============================================================================
   2+ E635              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ E635              ; ==============================================================================
   4+ E635              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ E635              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ E635              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ E635              ;
   8+ E635              ; Esquema de fases:
   9+ E635              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ E635              ;   2 ARM_IN       arm aparece, pausa
  11+ E635              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ E635              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ E635              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ E635              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ E635              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ E635              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ E635              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ E635              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ E635              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ E635              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ E635              ;  13 END_HOLD     "The End" sprite hold
  22+ E635              ;  14 BLACK        wipe a negro + hold
  23+ E635              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ E635              ;
  25+ E635              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ E635              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ E635              ; ==============================================================================
  28+ E635
  29+ E635              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ E635              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ E635              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ E635              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ E635              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ E635              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ E635              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ E635              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ E635              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ E635              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ E635              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ E635
  41+ E635              ; --- Posiciones (pixel) ---
  42+ E635              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ E635              TGCS_ANCHOR1_Y         EQU 80
  44+ E635              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ E635              TGCS_END_CHARY         EQU 4
  46+ E635              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ E635
  48+ E635              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ E635              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ E635              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ E635              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ E635              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ E635              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ E635              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ E635              TGCS_ARM_PX_X          EQU 136
  56+ E635              TGCS_ARM_PX_Y          EQU 64
  57+ E635              TGCS_FINGER_PX_X       EQU 136
  58+ E635              TGCS_FINGER_PX_Y       EQU 56
  59+ E635
  60+ E635              ; --- Phase enum ---
  61+ E635              TGP_IDLE               EQU 0
  62+ E635              TGP_LOCK               EQU 1
  63+ E635              TGP_ARM_IN             EQU 2
  64+ E635              TGP_FINGER_IN          EQU 3
  65+ E635              TGP_SHAKE              EQU 4
  66+ E635              TGP_FINGER_PULSE       EQU 5
  67+ E635              TGP_FINGER_OUT         EQU 6
  68+ E635              TGP_ARM_HOLD           EQU 7
  69+ E635              TGP_ARM_OUT            EQU 8
  70+ E635              TGP_PLAYER_TURN        EQU 9
  71+ E635              TGP_PLAYER_HIDE        EQU 10
  72+ E635              TGP_PLAYER_FRAMED      EQU 11
  73+ E635              TGP_PLAYER_EXIT        EQU 12
  74+ E635              TGP_END_HOLD           EQU 13
  75+ E635              TGP_BLACK              EQU 14
  76+ E635              TGP_CREDITS            EQU 15
  77+ E635              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ E635              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ E635
  80+ E635              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ E635                                                ; check dinamico de "todos los nasties dead".
  82+ E635                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ E635                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ E635                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ E635
  86+ E635              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ E635              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
