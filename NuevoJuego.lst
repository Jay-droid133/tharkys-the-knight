  97  69E0
  98  69E0                  ; ==========================================================================
  99  69E0                  ; ORG $8000 - codigo principal (no-contended)
 100  69E0                  ; ==========================================================================
 101  69E0                  ORG ORIGIN_ADDRESS
 102  8000
 103  8000              ; ==============================================================================
 104  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 105  8000              ; ==============================================================================
 106  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 107  8000              ;   erase viejo → AI/movimiento → draw nuevo
 108  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 109  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 110  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 111  8000              ; ==============================================================================
 112  8000              MainLoop:
 113  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 114  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 115  8003 32 D8 80         LD (.frameStart), A
 116  8006
 117  8006                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
 118  8006 CD DD C9         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
