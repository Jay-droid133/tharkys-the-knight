 746+ D3CE              ; ==============================================================================
 747+ D3CE              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 748+ D3CE              ; ==============================================================================
 749+ D3CE              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 750+ D3CE              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 751+ D3CE              ;          DEFB tintPaper, attr_h, attr_w, attr_data
