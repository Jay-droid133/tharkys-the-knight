4552+ B7EC DD 7E 01         LD A, (IX+ENT_TYPE)
4553+ B7EF B7               OR A
4554+ B7F0 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4555+ B7F2                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4556+ B7F2                  ; (un poco de irregularidad en la cadencia de aparicion).
4557+ B7F2 ED 5F            LD A, R
4558+ B7F4 E6 07            AND $07
4559+ B7F6 32 FA 82         LD (SpawnTimer), A
4560+ B7F9 C1               POP BC
4561+ B7FA C9               RET
4562+ B7FB              .spawnNextSlot:
