 711+ 63DC
 712+ 63DC              ; ==============================================================================
 713+ 63DC              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 714+ 63DC              ; ==============================================================================
 715+ 63DC              ; Clip bidireccional: salta filas cuyo pixel_y este en [TGCS_ARCH_PX_TOP,
 716+ 63DC              ; TGCS_ARCH_PX_BOTTOM] (= [120, 151] = rect vertical de part1). Filas arriba
 717+ 63DC              ; y abajo se dibujan normal (XOR).
 718+ 63DC              ;
 719+ 63DC              ; Resultado: el player nunca tiene pixels VRAM dentro del rect de part1.
 720+ 63DC              ; - Encima del arco (POSY+20 < 120): full draw.
 721+ 63DC              ; - Entrando por arriba (POSY 100..119): rows superiores visibles, rows
 722+ 63DC              ;   inferiores que pasan tras el lintel skipped.
 723+ 63DC              ; - Totalmente dentro (POSY 120..131): nada drawn.
 724+ 63DC              ; - Saliendo por abajo (POSY 132..151): rows inferiores visibles, top tras
 725+ 63DC              ;   lintel skipped.
 726+ 63DC              ; - Bajo del arco (POSY >= 152): full draw.
 727+ 63DC              ;
 728+ 63DC              ; IN: D = Y, E = X (asume aligned a 8). IY = sprite ptr CON header.
 729+ 63DC              ;     Bank 6 paginado al entrar (caller).
 730+ 63DC              ; Player es 16w x 21h. Aligned X (no shift). XOR-write.
 731+ 63DC              ; Destruye: AF, BC, DE, HL, IY.
 732+ 63DC              ; ==============================================================================
 733+ 63DC              PLAYER_H_PX              EQU 21
 734+ 63DC
 735+ 63DC              TownGatePlayerXOR_BiClip:
 736+ 63DC FD 23            INC IY
 737+ 63DE FD 23            INC IY                              ; skip header
 738+ 63E0 D5               PUSH DE
 739+ 63E1 CD 92 A0         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 740+ 63E4 D1               POP DE
 741+ 63E5 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 742+ 63E7 4A               LD C, D                             ; C = current pixel Y
 743+ 63E8              .tgpxbcRow:
 744+ 63E8 79               LD A, C
 745+ 63E9 FE C0            CP 192
 746+ 63EB 30 16            JR NC, .tgpxbcAdvance               ; pixel_y >= 192: off-screen, skip
 747+ 63ED                                                      ; (sin este clip, NextPixelLine lleva
 748+ 63ED                                                      ; HL a $5800+ = area de attrs → XOR
 749+ 63ED                                                      ; corrompe attrs como flashes raros).
 750+ 63ED FE 78            CP TGCS_ARCH_PX_TOP                 ; < 120 ?
 751+ 63EF 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 752+ 63F1 FE 98            CP TGCS_ARCH_PX_BOTTOM + 1          ; >= 152 ?
 753+ 63F3 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 754+ 63F5                  ; In [120, 151] → skip pixels en esta row
 755+ 63F5 18 0C            JR .tgpxbcAdvance
 756+ 63F7              .tgpxbcDraw:
 757+ 63F7                  ; OJO: sprites de sprite_data.asm NO estan CPL'd (a diferencia de BG en
 758+ 63F7                  ; bg_gfx.asm). DrawSprite los XOR directos. Aqui igual: sin CPL.
 759+ 63F7 FD 7E 00         LD A, (IY+0)
 760+ 63FA AE               XOR (HL)
 761+ 63FB 77               LD (HL), A
 762+ 63FC 23               INC HL
 763+ 63FD FD 7E 01         LD A, (IY+1)
 764+ 6400 AE               XOR (HL)
 765+ 6401 77               LD (HL), A
 766+ 6402 2B               DEC HL                              ; back to row start
 767+ 6403              .tgpxbcAdvance:
 768+ 6403 FD 23            INC IY
 769+ 6405 FD 23            INC IY                              ; sprite ptr → next row (2 bytes wide)
 770+ 6407 0C               INC C                               ; pixel Y += 1
 771+ 6408 C5               PUSH BC
 772+ 6409 CD FE 9D         CALL NextPixelLine                  ; HL → next pixel row in VRAM
 773+ 640C C1               POP BC
 774+ 640D 10 D9            DJNZ .tgpxbcRow
 775+ 640F C9               RET
 776+ 6410
 777+ 6410              ; ==============================================================================
 778+ 6410              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 779+ 6410              ; ==============================================================================
 780+ 6410              ; Usados en TownGateExitStep en lugar de TownGateRedrawPlayer. No tocan attrs
 781+ 6410              ; (los player attrs se pintaron en phase 9 y se limpian al salir de phase 9
 782+ 6410              ; con un RestoreOldAttr; las attrs del area por la que pasa el player se
 783+ 6410              ; quedan como BG, suficiente para que los pixels visibles se vean blancos).
 784+ 6410              ; ==============================================================================
 785+ 6410              TownGatePlayerSlideErase:
 786+ 6410 DD 21 3F 81      LD IX, EntityTable
 787+ 6414 DD E5            PUSH IX
 788+ 6416 CD 12 A8         CALL GetOldSpriteAddr               ; OldSprAddr = ptr (paginates bank 6, restaura bank 0)
 789+ 6419 DD E1            POP IX
 790+ 641B 3A D4 90         LD A, (CurrentPaging)
 791+ 641E E6 F8            AND $F8
 792+ 6420 F6 06            OR 6
 793+ 6422 32 D4 90         LD (CurrentPaging), A
 794+ 6425 01 FD 7F         LD BC, $7FFD
 795+ 6428 ED 79            OUT (C), A
 796+ 642A FD 2A 9A A7      LD IY, (OldSprAddr)
 797+ 642E DD 56 0D         LD D, (IX+ENT_OLDY)
 798+ 6431 DD 7E 0C         LD A, (IX+ENT_OLDX)
 799+ 6434 5F               LD E, A
 800+ 6435 CD DC 63         CALL TownGatePlayerXOR_BiClip
 801+ 6438 3A D4 90         LD A, (CurrentPaging)
 802+ 643B E6 F8            AND $F8
 803+ 643D 32 D4 90         LD (CurrentPaging), A
 804+ 6440 01 FD 7F         LD BC, $7FFD
 805+ 6443 ED 79            OUT (C), A
 806+ 6445 C9               RET
 807+ 6446
 808+ 6446              TownGatePlayerSlideDraw:
 809+ 6446 DD 21 3F 81      LD IX, EntityTable
 810+ 644A DD E5            PUSH IX
 811+ 644C CD E1 A7         CALL GetSpriteAddr                  ; SpriteAddrTemp = ptr
 812+ 644F DD E1            POP IX
 813+ 6451 3A D4 90         LD A, (CurrentPaging)
 814+ 6454 E6 F8            AND $F8
 815+ 6456 F6 06            OR 6
 816+ 6458 32 D4 90         LD (CurrentPaging), A
 817+ 645B 01 FD 7F         LD BC, $7FFD
 818+ 645E ED 79            OUT (C), A
 819+ 6460 FD 2A 10 A8      LD IY, (SpriteAddrTemp)
 820+ 6464 3A 6E 82         LD A, (PlayerDrawY)
 821+ 6467 57               LD D, A
 822+ 6468 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 823+ 646B 5F               LD E, A
 824+ 646C CD DC 63         CALL TownGatePlayerXOR_BiClip
 825+ 646F 3A D4 90         LD A, (CurrentPaging)
 826+ 6472 E6 F8            AND $F8
 827+ 6474 32 D4 90         LD (CurrentPaging), A
 828+ 6477 01 FD 7F         LD BC, $7FFD
 829+ 647A ED 79            OUT (C), A
 830+ 647C                  ; Update OLD = current
 831+ 647C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 832+ 647F DD 77 0C         LD (IX+ENT_OLDX), A
 833+ 6482 3A 6E 82         LD A, (PlayerDrawY)
 834+ 6485 DD 77 0D         LD (IX+ENT_OLDY), A
 835+ 6488 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 836+ 648B DD 77 0E         LD (IX+ENT_OLDSPRID), A
 837+ 648E C9               RET
 838+ 648F
 839+ 648F              ; ==============================================================================
 840+ 648F              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 841+ 648F              ; ==============================================================================
 842+ 648F              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 843+ 648F              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 844+ 648F              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 845+ 648F              ; 2. Compute new offset random.
 846+ 648F              ; 3. Draw at new offset.
 847+ 648F              ; Destruye: AF, BC, DE, HL, IX.
 848+ 648F              ; ==============================================================================
 849+ 648F              TownGateShakeStep:
 850+ 648F CD D7 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 851+ 6492 CD F2 64         CALL TownGateDrawFingerShifted
 852+ 6495                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 853+ 6495 ED 5F            LD A, R
 854+ 6497 E6 03            AND $03
 855+ 6499 21 BA 64         LD HL, .tgssJitterTable
 856+ 649C 5F               LD E, A
 857+ 649D 16 00            LD D, 0
 858+ 649F 19               ADD HL, DE
 859+ 64A0 7E               LD A, (HL)
 860+ 64A1 32 A6 5F         LD (TownGateShakeOffsX), A
 861+ 64A4 3A 3C 81         LD A, (GameFrameCounter)
 862+ 64A7 E6 03            AND $03
 863+ 64A9 21 BA 64         LD HL, .tgssJitterTable
 864+ 64AC 5F               LD E, A
 865+ 64AD 16 00            LD D, 0
 866+ 64AF 19               ADD HL, DE
 867+ 64B0 7E               LD A, (HL)
 868+ 64B1 32 A7 5F         LD (TownGateShakeOffsY), A
 869+ 64B4 CD D7 64         CALL TownGateDrawArmShifted          ; draw at new offset
 870+ 64B7 C3 F2 64         JP TownGateDrawFingerShifted
 871+ 64BA              .tgssJitterTable:
 872+ 64BA 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 873+ 64BE
 874+ 64BE              ; ==============================================================================
 875+ 64BE              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 876+ 64BE              ; ==============================================================================
 877+ 64BE              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 878+ 64BE              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 879+ 64BE              ; ==============================================================================
 880+ 64BE              TownGateShakeRestore:
 881+ 64BE CD D7 64         CALL TownGateDrawArmShifted          ; erase last shifted
 882+ 64C1 CD F2 64         CALL TownGateDrawFingerShifted
 883+ 64C4 AF               XOR A
 884+ 64C5 32 A6 5F         LD (TownGateShakeOffsX), A
 885+ 64C8 32 A7 5F         LD (TownGateShakeOffsY), A
 886+ 64CB 11 41 E6         LD DE, BgGfx_arm
 887+ 64CE CD E4 D9         CALL RedrawPickupByPtr               ; restore at PickupTable position
 888+ 64D1 11 8E E6         LD DE, BgGfx_finger
 889+ 64D4 C3 E4 D9         JP RedrawPickupByPtr
 890+ 64D7
 891+ 64D7              ; ==============================================================================
 892+ 64D7              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 893+ 64D7              ; ==============================================================================
 894+ 64D7              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 895+ 64D7              ; Destruye: AF, BC, DE, HL, IX.
 896+ 64D7              ; ==============================================================================
 897+ 64D7              TownGateDrawArmShifted:
 898+ 64D7 21 41 E6         LD HL, BgGfx_arm
 899+ 64DA 3E 03            LD A, 3
 900+ 64DC CD 74 6A         CALL LoadBgSpriteToBuffer
 901+ 64DF 3A A6 5F         LD A, (TownGateShakeOffsX)
 902+ 64E2 47               LD B, A
 903+ 64E3 3E 88            LD A, TGCS_ARM_PX_X
 904+ 64E5 80               ADD A, B
 905+ 64E6 5F               LD E, A
 906+ 64E7 3A A7 5F         LD A, (TownGateShakeOffsY)
 907+ 64EA 47               LD B, A
 908+ 64EB 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 909+ 64ED 80               ADD A, B
 910+ 64EE 57               LD D, A
 911+ 64EF C3 0D 65         JP DrawBgSpriteAnyXorAtPixel
 912+ 64F2
 913+ 64F2              ; ==============================================================================
 914+ 64F2              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 915+ 64F2              ; ==============================================================================
 916+ 64F2              TownGateDrawFingerShifted:
 917+ 64F2 21 8E E6         LD HL, BgGfx_finger
 918+ 64F5 3E 03            LD A, 3
 919+ 64F7 CD 74 6A         CALL LoadBgSpriteToBuffer
 920+ 64FA 3A A6 5F         LD A, (TownGateShakeOffsX)
 921+ 64FD 47               LD B, A
 922+ 64FE 3E 88            LD A, TGCS_FINGER_PX_X
 923+ 6500 80               ADD A, B
 924+ 6501 5F               LD E, A
 925+ 6502 3A A7 5F         LD A, (TownGateShakeOffsY)
 926+ 6505 47               LD B, A
 927+ 6506 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 928+ 6508 80               ADD A, B
 929+ 6509 57               LD D, A
 930+ 650A C3 0D 65         JP DrawBgSpriteAnyXorAtPixel
 931+ 650D
 932+ 650D              ; ==============================================================================
 933+ 650D              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 934+ 650D              ; ==============================================================================
 935+ 650D              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 936+ 650D              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 937+ 650D              ;     E = pixel X (0..255).
 938+ 650D              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 939+ 650D              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 940+ 650D              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 941+ 650D              ; Destruye: AF, BC, DE, HL, IX.
 942+ 650D              ; ==============================================================================
 943+ 650D              DrawBgSpriteAnyXorAtPixel:
 944+ 650D DD 21 87 89      LD IX, BgSpriteBuffer
 945+ 6511 DD 7E 00         LD A, (IX+0)                        ; height_px
 946+ 6514 B7               OR A
 947+ 6515 C8               RET Z
 948+ 6516 32 70 65         LD (.dbsaHeight), A
 949+ 6519 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 950+ 651C E6 7F            AND $7F
 951+ 651E 32 71 65         LD (.dbsaWidth), A
 952+ 6521 DD 23            INC IX
 953+ 6523 DD 23            INC IX                              ; -> pixel data
 954+ 6525 7B               LD A, E
 955+ 6526 E6 07            AND $07
 956+ 6528 32 72 65         LD (.dbsaShift), A
 957+ 652B 7B               LD A, E
 958+ 652C E6 F8            AND $F8
 959+ 652E 5F               LD E, A
 960+ 652F CD 92 A0         CALL CalcPixelAddr                  ; HL = VRAM addr
 961+ 6532              .dbsaRow:
 962+ 6532 E5               PUSH HL
 963+ 6533 3A 71 65         LD A, (.dbsaWidth)
 964+ 6536 47               LD B, A                             ; B = width counter
 965+ 6537 0E 00            LD C, 0                             ; C = carry from prev byte
 966+ 6539              .dbsaByte:
 967+ 6539 DD 7E 00         LD A, (IX+0)
 968+ 653C 2F               CPL                                 ; un-invert
 969+ 653D 57               LD D, A                             ; D = sprite byte
 970+ 653E 1E 00            LD E, 0                             ; E = bits que caen al next byte
 971+ 6540 3A 72 65         LD A, (.dbsaShift)
 972+ 6543 B7               OR A
 973+ 6544 28 09            JR Z, .dbsaNoShift
 974+ 6546 C5               PUSH BC
 975+ 6547 47               LD B, A
 976+ 6548              .dbsaShiftLoop:
 977+ 6548 CB 3A            SRL D
 978+ 654A CB 1B            RR E
 979+ 654C 10 FA            DJNZ .dbsaShiftLoop
 980+ 654E C1               POP BC
 981+ 654F              .dbsaNoShift:
 982+ 654F 7A               LD A, D
 983+ 6550 B1               OR C                                ; combinar con carry previo
 984+ 6551 AE               XOR (HL)
 985+ 6552 77               LD (HL), A
 986+ 6553 23               INC HL
 987+ 6554 4B               LD C, E                             ; nuevo carry para siguiente byte
 988+ 6555 DD 23            INC IX
 989+ 6557 10 E0            DJNZ .dbsaByte
 990+ 6559                  ; Byte final (carry) si shift > 0
 991+ 6559 3A 72 65         LD A, (.dbsaShift)
 992+ 655C B7               OR A
 993+ 655D 28 03            JR Z, .dbsaNoFinal
 994+ 655F 79               LD A, C
 995+ 6560 AE               XOR (HL)
 996+ 6561 77               LD (HL), A
 997+ 6562              .dbsaNoFinal:
 998+ 6562 E1               POP HL
 999+ 6563 CD FE 9D         CALL NextPixelLine
1000+ 6566 3A 70 65         LD A, (.dbsaHeight)
1001+ 6569 3D               DEC A
1002+ 656A 32 70 65         LD (.dbsaHeight), A
1003+ 656D 20 C3            JR NZ, .dbsaRow
1004+ 656F C9               RET
1005+ 6570 00           .dbsaHeight: DEFB 0
1006+ 6571 00           .dbsaWidth:  DEFB 0
1007+ 6572 00           .dbsaShift:  DEFB 0
