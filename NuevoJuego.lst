2369+ AB9A              CheckPredatorAttack:
2370+ AB9A                  ; Buscar tipo depredador en PredatorTable
2371+ AB9A DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2372+ AB9D D6 20            SUB SPRID_ENEMY_0
2373+ AB9F CB 3F            SRL A
2374+ ABA1 CB 3F            SRL A                               ; indice = (ANIMBASE - ENEMY_0) / 4
2375+ ABA3 21 9B BC         LD HL, PredatorTable
2376+ ABA6 5F               LD E, A
2377+ ABA7 16 00            LD D, 0
2378+ ABA9 19               ADD HL, DE
2379+ ABAA 7E               LD A, (HL)                          ; A = byte predador
2380+ ABAB B7               OR A
2381+ ABAC C8               RET Z                               ; PRED_NONE → no es depredador
2382+ ABAD
2383+ ABAD                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2384+ ABAD 47               LD B, A                             ; B = byte predador completo
2385+ ABAE CB 3F            SRL A
2386+ ABB0 CB 3F            SRL A                               ; A = ciclo requerido (1-3)
2387+ ABB2 4F               LD C, A
2388+ ABB3 3A A7 BC         LD A, (DayCycleCount)
2389+ ABB6 B9               CP C
2390+ ABB7 D8               RET C                               ; DayCycleCount < ciclo requerido → no atacar
2391+ ABB8
2392+ ABB8                  ; Calcular velocidad de ataque segun ciclo
2393+ ABB8 3A A7 BC         LD A, (DayCycleCount)
2394+ ABBB FE 04            CP 4
2395+ ABBD 38 02            JR C, .cpSpeedOk
2396+ ABBF 3E 03            LD A, 3                             ; Cap en 3
2397+ ABC1              .cpSpeedOk:
2398+ ABC1 21 A3 BC         LD HL, PredatorSpeedTable
2399+ ABC4 5F               LD E, A
2400+ ABC5 16 00            LD D, 0
2401+ ABC7 19               ADD HL, DE
2402+ ABC8 7E               LD A, (HL)
2403+ ABC9 32 46 AC         LD (.cpSpeed), A
2404+ ABCC
2405+ ABCC                  ; Tipo depredador activo: comprobar alineacion
2406+ ABCC 78               LD A, B
2407+ ABCD E6 03            AND $03                             ; A = tipo (1=arriba, 2=abajo, 3=horizontal)
2408+ ABCF FE 03            CP PRED_HORIZONTAL
2409+ ABD1 28 41            JR Z, .cpHorizontal
2410+ ABD3
2411+ ABD3                  ; === Vertical (arriba/abajo): comprobar |nastyX - playerX| < PRED_ALIGN_DIST ===
2412+ ABD3 4F               LD C, A                             ; C = tipo (1 o 2)
2413+ ABD4 DD 7E 03         LD A, (IX+ENT_POSX)
2414+ ABD7 57               LD D, A
2415+ ABD8 3A 9E 81         LD A, (EntityTable + ENT_POSX)
2416+ ABDB 92               SUB D
2417+ ABDC 30 02            JR NC, .cpAbsX
2418+ ABDE ED 44            NEG
2419+ ABE0              .cpAbsX:
2420+ ABE0 FE 0C            CP PRED_ALIGN_DIST
2421+ ABE2 D0               RET NC                              ; No alineado en X
2422+ ABE3
2423+ ABE3                  ; Comprobar posicion relativa Y
2424+ ABE3 79               LD A, C
2425+ ABE4 FE 01            CP PRED_FROM_ABOVE
2426+ ABE6 28 17            JR Z, .cpFromAbove
2427+ ABE8                  ; Desde abajo: nastyY > playerY
2428+ ABE8 DD 7E 04         LD A, (IX+ENT_POSY)
2429+ ABEB 57               LD D, A
2430+ ABEC 3A 9F 81         LD A, (EntityTable + ENT_POSY)
2431+ ABEF BA               CP D
2432+ ABF0 D0               RET NC                              ; playerY >= nastyY → no esta abajo
2433+ ABF1                  ; Lanzarse hacia arriba
2434+ ABF1 3A 46 AC         LD A, (.cpSpeed)
2435+ ABF4 ED 44            NEG
2436+ ABF6 DD 77 07         LD (IX+ENT_DELTAY), A
2437+ ABF9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2438+ ABFD 18 42            JR .cpActivate
2439+ ABFF              .cpFromAbove:
