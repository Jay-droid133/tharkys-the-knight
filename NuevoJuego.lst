  58+ EF4D 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EF4F 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EF51 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EF53 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EF55 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EF57 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EF59 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ EF5B 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
