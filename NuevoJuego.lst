4383+ B9E1              ; ==============================================================================
4384+ B9E1              ; CountActiveNasties / CountActiveMonsters
4385+ B9E1              ; ==============================================================================
4386+ B9E1              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4387+ B9E1              ; Ambas usan _CountSlots internamente.
4388+ B9E1              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4389+ B9E1              ; ==============================================================================
4390+ B9E1              CountActiveNasties:
4391+ B9E1 21 0C 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4392+ B9E4 06 04            LD B, NUM_NASTIES
4393+ B9E6 18 05            JR _CountSlots
4394+ B9E8
4395+ B9E8              CountActiveMonsters:
4396+ B9E8 21 AC 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4397+ B9EB 06 06            LD B, NUM_MONSTERS
4398+ B9ED
4399+ B9ED              _CountSlots:
4400+ B9ED 0E 00            LD C, 0                         ; Contador
4401+ B9EF              .countLoop:
4402+ B9EF 7E               LD A, (HL)
4403+ B9F0 B7               OR A
4404+ B9F1 28 16            JR Z, .countNext                ; Slot vacio: no contar
4405+ B9F3                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4406+ B9F3 D5               PUSH DE
4407+ B9F4 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4408+ B9F7 19               ADD HL, DE
4409+ B9F8 7E               LD A, (HL)
4410+ B9F9 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4411+ B9FB D1               POP DE
4412+ B9FC FE 03            CP STATE_DYING
4413+ B9FE 28 09            JR Z, .countNext
4414+ BA00 FE 04            CP STATE_SPAWNING
4415+ BA02 28 05            JR Z, .countNext
4416+ BA04 FE 05            CP STATE_SCARED
4417+ BA06 28 01            JR Z, .countNext
4418+ BA08 0C               INC C
4419+ BA09              .countNext:
4420+ BA09 11 10 00         LD DE, ENT_SIZE
4421+ BA0C 19               ADD HL, DE
4422+ BA0D 10 E0            DJNZ .countLoop
4423+ BA0F 79               LD A, C
4424+ BA10 C9               RET
4425+ BA11
4426+ BA11              ; ==============================================================================
4427+ BA11              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4428+ BA11              ; ==============================================================================
4429+ BA11              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4430+ BA11              ; ==============================================================================
4431+ BA11              TrySpawnNasty:
4432+ BA11                  IF DEBUG_NO_ENEMIES
4433+ BA11 ~                RET
4434+ BA11                  ENDIF
4435+ BA11                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4436+ BA11                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4437+ BA11                  ; cuando el timer llega a 0.
4438+ BA11 3A C7 82         LD A, (PostTrapPauseTimer)
4439+ BA14 B7               OR A
4440+ BA15 C0               RET NZ
4441+ BA16                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4442+ BA16                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4443+ BA16 3A E7 82         LD A, (DeathBorderPhase)
4444+ BA19 B7               OR A
4445+ BA1A C0               RET NZ
4446+ BA1B                  ; Bloquear durante phase 1 del respawn (countdown 3-2-1 sin control).
4447+ BA1B                  ; Al pasar a phase 2 se reinicia SpawnTimer = SPAWN_INTERVAL para que el
4448+ BA1B                  ; primer nasty aparezca con la misma pausa que al entrar a sala nueva.
4449+ BA1B 3A EB 82         LD A, (PlayerRespawnPhase)
4450+ BA1E FE 01            CP 1
4451+ BA20 C8               RET Z
4452+ BA21                  ; Cooldown tras cambio de pantalla / inicio
4453+ BA21 3A F5 82         LD A, (SpawnTimer)
4454+ BA24 B7               OR A
4455+ BA25 28 05            JR Z, .spawnReady
4456+ BA27 3D               DEC A
4457+ BA28 32 F5 82         LD (SpawnTimer), A
4458+ BA2B C9               RET
4459+ BA2C              .spawnReady:
4460+ BA2C                  ; Bloquear spawn durante pausa/huida (campanadas o amanecer)
4461+ BA2C 3A 8E B8         LD A, (ScareTimer)
4462+ BA2F B7               OR A
4463+ BA30 C0               RET NZ
4464+ BA31                  ; Si los 3 monsters estan atrapados, los blockers nocturnos (MonstersActive
4465+ BA31                  ; + N2 + A1) se levantan: la noche queda "vacia" sin captura/persecucion,
4466+ BA31                  ; rellenamos con nasties crepusculares hasta A2.
4467+ BA31 3A BE 82         LD A, (MonsterTrappedFlags)
4468+ BA34 E6 07            AND $07
4469+ BA36 FE 07            CP $07
4470+ BA38 28 0E            JR Z, .spawnIgnoreNightBlocks
4471+ BA3A                  ; Bloquear spawn mientras los monsters esten activos (N1+N2+A1).
4472+ BA3A                  ; Sin esto, los nasties spawneados a finales de N1 antes de las campanadas
4473+ BA3A                  ; conviven con los 3 monsters → 6 entidades en EntityTable competiendo por
4474+ BA3A                  ; el budget MAX_ENEMIES_PER_FRAME=2 → ralentizacion percibida en monsters.
4475+ BA3A 3A F8 B5         LD A, (MonstersActive)
4476+ BA3D B7               OR A
4477+ BA3E C0               RET NZ
4478+ BA3F                  ; Bloquear spawn en N2 y A1 (no reaparecen hasta A2)
4479+ BA3F 3A 0A E5         LD A, (CurrentTimeOfDay)
4480+ BA42 FE 04            CP 4                        ; N2
4481+ BA44 C8               RET Z
4482+ BA45 FE 05            CP 5                        ; A1
4483+ BA47 C8               RET Z
4484+ BA48              .spawnIgnoreNightBlocks:
4485+ BA48                  ; Spawn UNO por timer-fire para evitar que aparezcan todos a la vez.
4486+ BA48                  ; Tras un spawn exitoso (TYPE != 0), reset SpawnTimer = SPAWN_GAP y
4487+ BA48                  ; salir; el siguiente slot vacio esperara el gap. Si todos los slots
4488+ BA48                  ; estan ocupados o spawn falla, no resetea timer (sigue intentando).
4489+ BA48 DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4490+ BA4C 06 04            LD B, NUM_NASTIES
4491+ BA4E              .spawnLoop:
4492+ BA4E C5               PUSH BC
4493+ BA4F DD 7E 01         LD A, (IX+ENT_TYPE)
4494+ BA52 B7               OR A
4495+ BA53 20 12            JR NZ, .spawnNextSlot
4496+ BA55 CD 70 BA         CALL SpawnOneNasty
4497+ BA58 DD 7E 01         LD A, (IX+ENT_TYPE)
4498+ BA5B B7               OR A
4499+ BA5C 28 09            JR Z, .spawnNextSlot                ; spawn fallo (sin posiciones libres)
4500+ BA5E                  ; Spawn exitoso: gap random 0..7 frames antes del siguiente nasty
4501+ BA5E                  ; (un poco de irregularidad en la cadencia de aparicion).
4502+ BA5E ED 5F            LD A, R
4503+ BA60 E6 07            AND $07
4504+ BA62 32 F5 82         LD (SpawnTimer), A
4505+ BA65 C1               POP BC
4506+ BA66 C9               RET
4507+ BA67              .spawnNextSlot:
4508+ BA67 11 10 00         LD DE, ENT_SIZE
