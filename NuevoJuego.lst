 301+ E5AE              ; ==============================================================================
 302+ E5AE              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E5AE              ; ==============================================================================
 304+ E5AE              ; Entrada: A = attr original
 305+ E5AE              ; Salida:  A = attr transformado
 306+ E5AE              ; Preserva: HL, DE, BC, IX
 307+ E5AE              ; ==============================================================================
 308+ E5AE              ApplyDayCycleRemap:
 309+ E5AE E5               PUSH HL
 310+ E5AF 67               LD H, A                     ; H = attr (temp save)
 311+ E5B0                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E5B0 3A 49 E4         LD A, (BgSpriteSkipRemap)
 313+ E5B3 B7               OR A
 314+ E5B4 20 06            JR NZ, .skipRemap
 315+ E5B6 3A 43 E4         LD A, (CurrentTimeOfDay)
 316+ E5B9 B7               OR A
 317+ E5BA 20 03            JR NZ, .doRemap
 318+ E5BC              .skipRemap:
 319+ E5BC 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E5BD E1               POP HL
 321+ E5BE C9               RET
 322+ E5BF
 323+ E5BF              .doRemap:
 324+ E5BF D5               PUSH DE
 325+ E5C0 C5               PUSH BC
 326+ E5C1
 327+ E5C1 7C               LD A, H                     ; A = attr original
 328+ E5C2 4F               LD C, A                     ; C = attr original
 329+ E5C3
 330+ E5C3                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E5C3 E6 87            AND $87                     ; A = F000_0III
 332+ E5C5 47               LD B, A                     ; B = flash | ink
 333+ E5C6
 334+ E5C6                  ; Extraer paper+bright como indice 0-15
 335+ E5C6 79               LD A, C
 336+ E5C7 E6 78            AND $78                     ; A = 0BPPP000
 337+ E5C9 0F               RRCA
 338+ E5CA 0F               RRCA
 339+ E5CB 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E5CC
 341+ E5CC                  ; Elegir tabla segun tipo de sprite
 342+ E5CC 5F               LD E, A
 343+ E5CD 16 00            LD D, 0
 344+ E5CF 3A 48 E4         LD A, (BgSpriteIsHouse)
 345+ E5D2 B7               OR A
 346+ E5D3 28 05            JR Z, .useStdTable
 347+ E5D5 2A 46 E4         LD HL, (CurrentHouseRemapTable)
 348+ E5D8 18 03            JR .doLookup
 349+ E5DA              .useStdTable:
 350+ E5DA 2A 44 E4         LD HL, (CurrentRemapTable)
 351+ E5DD              .doLookup:
 352+ E5DD 19               ADD HL, DE
 353+ E5DE 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E5DF
 355+ E5DF                  ; Reconstruir atributo
 356+ E5DF 07               RLCA
 357+ E5E0 07               RLCA
 358+ E5E1 07               RLCA                        ; A = 0BPPP000
 359+ E5E2 B0               OR B                        ; A = FBPPPIII
 360+ E5E3
 361+ E5E3 C1               POP BC
 362+ E5E4 D1               POP DE
 363+ E5E5 E1               POP HL
 364+ E5E6 C9               RET
 365+ E5E7
 366+ E5E7              ; ==============================================================================
 367+ E5E7              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E5E7              ; ==============================================================================
 369+ E5E7              ; Entrada: A = sprite ID
 370+ E5E7              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E5E7              ; Preserva: A, DE, IX
 372+ E5E7              ;
 373+ E5E7              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E5E7              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E5E7              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E5E7              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E5E7              ; ==============================================================================
 378+ E5E7              CheckIfHouseSprite:
 379+ E5E7 F5               PUSH AF
 380+ E5E8 E5               PUSH HL
 381+ E5E9 C5               PUSH BC
 382+ E5EA
 383+ E5EA 47               LD B, A                     ; B = id buscado
 384+ E5EB
 385+ E5EB AF               XOR A
 386+ E5EC 32 48 E4         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E5EF
 388+ E5EF 21 00 E1         LD HL, HouseIdList
 389+ E5F2              .checkLoop:
 390+ E5F2 7E               LD A, (HL)
 391+ E5F3 FE FF            CP $FF
 392+ E5F5 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E5F7 B8               CP B
 394+ E5F8 28 03            JR Z, .checkFound
 395+ E5FA 23               INC HL
 396+ E5FB 18 F5            JR .checkLoop
 397+ E5FD
 398+ E5FD              .checkFound:
 399+ E5FD 3E 01            LD A, 1
 400+ E5FF 32 48 E4         LD (BgSpriteIsHouse), A
 401+ E602
 402+ E602              .checkDone:
 403+ E602 C1               POP BC
 404+ E603 E1               POP HL
 405+ E604 F1               POP AF
 406+ E605 C9               RET
 407+ E606
 408+ E606              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E606              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E606              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E606
