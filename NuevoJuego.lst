 179+ DCAF                  ; Procesar 6 src bytes para esta src row
 180+ DCAF 2A 10 DD         LD HL, (.dpxSrcPtr)
 181+ DCB2 06 06            LD B, TOMB_SRC_W_BYTES
 182+ DCB4              .dpxByteLoop:
 183+ DCB4 7E               LD A, (HL)
 184+ DCB5 23               INC HL
 185+ DCB6 4F               LD C, A                         ; C = src byte original
 186+ DCB7 E5               PUSH HL                         ; save src ptr
 187+ DCB8 C5               PUSH BC                         ; save count + src byte
 188+ DCB9
 189+ DCB9                  ; --- High nibble doubled ---
 190+ DCB9 E6 F0            AND $F0
 191+ DCBB 0F               RRCA
 191+ DCBC 0F             RRCA
 191+ DCBD 0F             RRCA
 191+ DCBE 0F             RRCA       ; high nibble en posición baja
 192+ DCBF 5F               LD E, A
 193+ DCC0 16 00            LD D, 0
 194+ DCC2 21 4D DD         LD HL, NibbleDoubleLUT
 195+ DCC5 19               ADD HL, DE
 196+ DCC6 7E               LD A, (HL)                      ; A = high doubled
 197+ DCC7 2A 12 DD         LD HL, (.dpxDstTop)
 198+ DCCA 77               LD (HL), A
 199+ DCCB 23               INC HL
 200+ DCCC 22 12 DD         LD (.dpxDstTop), HL
 201+ DCCF 2A 14 DD         LD HL, (.dpxDstBot)
 202+ DCD2 77               LD (HL), A
 203+ DCD3 23               INC HL
 204+ DCD4 22 14 DD         LD (.dpxDstBot), HL
 205+ DCD7
 206+ DCD7                  ; --- Low nibble doubled ---
 207+ DCD7 C1               POP BC                          ; recover src byte (en C)
 208+ DCD8 C5               PUSH BC
 209+ DCD9 79               LD A, C
 210+ DCDA E6 0F            AND $0F
 211+ DCDC 5F               LD E, A
 212+ DCDD 16 00            LD D, 0
 213+ DCDF 21 4D DD         LD HL, NibbleDoubleLUT
 214+ DCE2 19               ADD HL, DE
 215+ DCE3 7E               LD A, (HL)                      ; A = low doubled
 216+ DCE4 2A 12 DD         LD HL, (.dpxDstTop)
 217+ DCE7 77               LD (HL), A
 218+ DCE8 23               INC HL
 219+ DCE9 22 12 DD         LD (.dpxDstTop), HL
 220+ DCEC 2A 14 DD         LD HL, (.dpxDstBot)
 221+ DCEF 77               LD (HL), A
 222+ DCF0 23               INC HL
 223+ DCF1 22 14 DD         LD (.dpxDstBot), HL
 224+ DCF4
 225+ DCF4 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 226+ DCF5 E1               POP HL                          ; src ptr
 227+ DCF6 10 BC            DJNZ .dpxByteLoop
 228+ DCF8
 229+ DCF8                  ; Avanzar a siguiente src row
 230+ DCF8 22 10 DD         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 231+ DCFB 3A 0F DD         LD A, (.dpxDstY)
 232+ DCFE C6 02            ADD A, 2                        ; 2 dst rows por 1 src row
 233+ DD00 32 0F DD         LD (.dpxDstY), A
 234+ DD03 3A 0E DD         LD A, (.dpxRowsLeft)
 235+ DD06 3D               DEC A
 236+ DD07 32 0E DD         LD (.dpxRowsLeft), A
 237+ DD0A C2 9D DC         JP NZ, .dpxNextRow
 238+ DD0D C9               RET
 239+ DD0E
 240+ DD0E 00           .dpxRowsLeft:   DEFB 0
 241+ DD0F 00           .dpxDstY:       DEFB 0
 242+ DD10 00 00        .dpxSrcPtr:     DEFW 0
 243+ DD12 00 00        .dpxDstTop:     DEFW 0
 244+ DD14 00 00        .dpxDstBot:     DEFW 0
 245+ DD16
 246+ DD16              ; ==============================================================================
 247+ DD16              ; DrawTombAttrs2x - 30 src attrs (6×5) → 120 dst attrs (12×10) en attr VRAM
 248+ DD16              ; ==============================================================================
 249+ DD16              ; Cada src attr se replica en bloque 2×2 chars en dst.
 250+ DD16              ; Src ptr en TombAttrSrcPtr (set por DecodeTombRLEPixels).
 251+ DD16              ; Dst start: $5800 + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X.
 252+ DD16              ;
 253+ DD16              ; Destruye: AF, BC, DE, HL.
 254+ DD16              ; ==============================================================================
 255+ DD16              DrawTombAttrs2x:
 256+ DD16 2A 4D DE         LD HL, (TombAttrSrcPtr)         ; HL = src attrs (en BgSpriteBuffer)
 257+ DD19 11 4A 59         LD DE, ATTR_BASE + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X
 258+ DD1C 3E 05            LD A, TOMB_SRC_ATTR_H           ; 5 src rows
 259+ DD1E              .daxRow:
 260+ DD1E 32 4C DD         LD (.daxRowsLeft), A
 261+ DD21 D5               PUSH DE                         ; guardar dst row top start
 262+ DD22 06 06            LD B, TOMB_SRC_ATTR_W           ; 6 src attrs por row
 263+ DD24              .daxCol:
 264+ DD24 7E               LD A, (HL)
 265+ DD25 23               INC HL
 266+ DD26 12               LD (DE), A                      ; dst top col 2N
 267+ DD27 13               INC DE
 268+ DD28 12               LD (DE), A                      ; dst top col 2N+1
 269+ DD29 13               INC DE
 270+ DD2A 10 F8            DJNZ .daxCol
 271+ DD2C                  ; Replicar la dst row top a dst row top+1 (= +32 bytes)
 272+ DD2C D1               POP DE                          ; DE = dst row top start
 273+ DD2D E5               PUSH HL                         ; save src ptr
 274+ DD2E 62               LD H, D
 275+ DD2F 6B               LD L, E                         ; HL = dst row top start
 276+ DD30 7B               LD A, E
 277+ DD31 C6 20            ADD A, 32
 278+ DD33 5F               LD E, A
 279+ DD34 30 01            JR NC, .daxNoCarry1
 280+ DD36 14               INC D
 281+ DD37              .daxNoCarry1:
 282+ DD37                  ; HL = top row start, DE = bot row start. LDIR 12 bytes.
 283+ DD37 01 0C 00         LD BC, TOMB_SRC_ATTR_W * 2      ; 12
 284+ DD3A ED B0            LDIR                            ; copy 12 attrs from top row to bot row
 285+ DD3C                  ; DE ahora apunta al char tras la última col de bot row.
 286+ DD3C                  ; Necesitamos resetear DE al inicio de la siguiente "row top" = +32 desde
 287+ DD3C                  ; donde estamos. Calculemos: bot row inició en (top + 32). Tras LDIR de 12
 288+ DD3C                  ; bytes, DE = top + 32 + 12. Próxima top row = top + 64.
 289+ DD3C                  ; → DE += 32 - 12 = +20.
 290+ DD3C 7B               LD A, E
 291+ DD3D C6 14            ADD A, 32 - TOMB_SRC_ATTR_W * 2
 292+ DD3F 5F               LD E, A
 293+ DD40 30 01            JR NC, .daxNoCarry2
 294+ DD42 14               INC D
 295+ DD43              .daxNoCarry2:
 296+ DD43 E1               POP HL                          ; restore src ptr
 297+ DD44 3A 4C DD         LD A, (.daxRowsLeft)
 298+ DD47 3D               DEC A
 299+ DD48 C2 1E DD         JP NZ, .daxRow
 300+ DD4B C9               RET
 301+ DD4C
 302+ DD4C 00           .daxRowsLeft:   DEFB 0
 303+ DD4D
 304+ DD4D              ; ==============================================================================
 305+ DD4D              ; LUT: nibble (4 bits abcd) → byte doblado (aabbccdd)
 306+ DD4D              ; ==============================================================================
 307+ DD4D              NibbleDoubleLUT:
 308+ DD4D 00               DEFB %00000000  ; 0000 → 00000000
 309+ DD4E 03               DEFB %00000011  ; 0001 → 00000011
 310+ DD4F 0C               DEFB %00001100  ; 0010 → 00001100
 311+ DD50 0F               DEFB %00001111  ; 0011 → 00001111
 312+ DD51 30               DEFB %00110000  ; 0100 → 00110000
 313+ DD52 33               DEFB %00110011  ; 0101 → 00110011
 314+ DD53 3C               DEFB %00111100  ; 0110 → 00111100
 315+ DD54 3F               DEFB %00111111  ; 0111 → 00111111
 316+ DD55 C0               DEFB %11000000  ; 1000 → 11000000
 317+ DD56 C3               DEFB %11000011  ; 1001 → 11000011
 318+ DD57 CC               DEFB %11001100  ; 1010 → 11001100
 319+ DD58 CF               DEFB %11001111  ; 1011 → 11001111
 320+ DD59 F0               DEFB %11110000  ; 1100 → 11110000
 321+ DD5A F3               DEFB %11110011  ; 1101 → 11110011
 322+ DD5B FC               DEFB %11111100  ; 1110 → 11111100
 323+ DD5C FF               DEFB %11111111  ; 1111 → 11111111
 324+ DD5D
 325+ DD5D              ; ==============================================================================
 326+ DD5D              ; Buffer plano de pixeles decodificados (240 B). Cold storage en slot 1.
 327+ DD5D              ; Vivirá en .lst después del code; sjasmplus lo ubica donde el ORG actual.
 328+ DD5D              ; ==============================================================================
 329+ DD5D              TombDecodedPixels:
 330+ DD5D 00 00 00...      DEFS TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes
