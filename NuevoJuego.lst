5569+ C1BC              MonsterTypeTable:
5570+ C1BC 4C               DEFB SPRID_MONSTER_0
5571+ C1BD 54               DEFB SPRID_MONSTER_1
5572+ C1BE 5C               DEFB SPRID_MONSTER_2
5573+ C1BF              MonsterColorTable:
5574+ C1BF 44               DEFB $44                            ; Zombi: verde
5575+ C1C0 46               DEFB $46                            ; Skeleton: amarillo
5576+ C1C1 45               DEFB $45                            ; Ghost: cyan
5577+ C1C2
5578+ C1C2              ; ==============================================================================
5579+ C1C2              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5580+ C1C2              ; ==============================================================================
5581+ C1C2              TryRespawnMonsters:
5582+ C1C2 3A 93 E4         LD A, (CurrentTimeOfDay)
5583+ C1C5 FE 03            CP 3
5584+ C1C7 28 05            JR Z, .rmNight
5585+ C1C9 FE 04            CP 4
5586+ C1CB 28 01            JR Z, .rmNight
5587+ C1CD C9               RET
5588+ C1CE              .rmNight:
5589+ C1CE 3A DF B6         LD A, (MonstersActive)
5590+ C1D1 B7               OR A
5591+ C1D2 C8               RET Z
5592+ C1D3 CD A3 C2         CALL .rmUpdateReturnTimers
5593+ C1D6 3A 9F C2         LD A, (.rmTimer)
5594+ C1D9 B7               OR A
5595+ C1DA 28 05            JR Z, .rmCheckSlots
5596+ C1DC 3D               DEC A
5597+ C1DD 32 9F C2         LD (.rmTimer), A
5598+ C1E0 C9               RET
5599+ C1E1              .rmCheckSlots:
5600+ C1E1 DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5601+ C1E5 06 03            LD B, MONSTERS_TO_SPAWN
5602+ C1E7 0E 00            LD C, 0
5603+ C1E9              .rmLoop:
5604+ C1E9 C5               PUSH BC
5605+ C1EA DD 7E 01         LD A, (IX+ENT_TYPE)
5606+ C1ED B7               OR A
5607+ C1EE C2 93 C2         JP NZ, .rmSkip
5608+ C1F1                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5609+ C1F1                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5610+ C1F1                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5611+ C1F1 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5612+ C1F4 B7               OR A
5613+ C1F5 20 09            JR NZ, .rmHasTypeForTrap
5614+ C1F7                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5615+ C1F7 79               LD A, C
5616+ C1F8 21 BC C1         LD HL, MonsterTypeTable
5617+ C1FB 5F               LD E, A
5618+ C1FC 16 00            LD D, 0
5619+ C1FE 19               ADD HL, DE
5620+ C1FF 7E               LD A, (HL)
5621+ C200              .rmHasTypeForTrap:
5622+ C200 D6 4C            SUB SPRID_MONSTER_0
5623+ C202 CB 3F            SRL A
5624+ C204 CB 3F            SRL A
5625+ C206 CB 3F            SRL A                               ; A = type idx 0..2
5626+ C208 21 A0 C2         LD HL, .rmTrapBits
5627+ C20B 5F               LD E, A
5628+ C20C 16 00            LD D, 0
5629+ C20E 19               ADD HL, DE
5630+ C20F 7E               LD A, (HL)
5631+ C210 21 58 82         LD HL, MonsterTrappedFlags
5632+ C213 A6               AND (HL)
5633+ C214 C2 93 C2         JP NZ, .rmSkip
5634+ C217                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5635+ C217                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5636+ C217                  ; que el player visite su room.
5637+ C217 79               LD A, C
5638+ C218 6F               LD L, A
5639+ C219 26 00            LD H, 0
5640+ C21B 11 CE 90         LD DE, MonsterRoomId
5641+ C21E 19               ADD HL, DE
5642+ C21F 7E               LD A, (HL)
5643+ C220 5F               LD E, A                             ; E = room_id del slot
5644+ C221 CD F4 91         CALL MaiGetCurrentScreenId          ; A = current screen_id
5645+ C224 BB               CP E
5646+ C225 C2 93 C2         JP NZ, .rmSkip                      ; distinto room → skip
5647+ C228                  ; === Activar SIN tocar POSX/POSY ===
5648+ C228                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5649+ C228                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5650+ C228                  ;   - RepositionMonstersAtEntry: gap en entry side
5651+ C228                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5652+ C228 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5653+ C22B B7               OR A
5654+ C22C 20 18            JR NZ, .rmHasType
5655+ C22E 79               LD A, C
5656+ C22F 21 BC C1         LD HL, MonsterTypeTable
5657+ C232 5F               LD E, A
5658+ C233 16 00            LD D, 0
5659+ C235 19               ADD HL, DE
5660+ C236 7E               LD A, (HL)
5661+ C237 DD 77 08         LD (IX+ENT_ANIMBASE), A
5662+ C23A 79               LD A, C
5663+ C23B 21 BF C1         LD HL, MonsterColorTable
5664+ C23E 5F               LD E, A
5665+ C23F 16 00            LD D, 0
5666+ C241 19               ADD HL, DE
5667+ C242 7E               LD A, (HL)
5668+ C243 DD 77 05         LD (IX+ENT_ATTR), A
5669+ C246              .rmHasType:
5670+ C246 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5671+ C249 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5672+ C24D DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5673+ C251                  ; Facing
5674+ C251 57               LD D, A
5675+ C252 3A 39 81         LD A, (EntityTable + ENT_POSX)
5676+ C255 DD BE 03         CP (IX+ENT_POSX)
5677+ C258 30 05            JR NC, .rmFaceR
5678+ C25A 7A               LD A, D
