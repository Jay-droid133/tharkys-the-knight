 300+ E6B5              ; ==============================================================================
 301+ E6B5              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 302+ E6B5              ; ==============================================================================
 303+ E6B5              ; Entrada: A = attr original
 304+ E6B5              ; Salida:  A = attr transformado
 305+ E6B5              ; Preserva: HL, DE, BC, IX
 306+ E6B5              ; ==============================================================================
 307+ E6B5              ApplyDayCycleRemap:
 308+ E6B5 E5               PUSH HL
 309+ E6B6 67               LD H, A                     ; H = attr (temp save)
 310+ E6B7                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 311+ E6B7 3A 53 E5         LD A, (BgSpriteSkipRemap)
 312+ E6BA B7               OR A
 313+ E6BB 20 06            JR NZ, .skipRemap
 314+ E6BD 3A 4D E5         LD A, (CurrentTimeOfDay)
 315+ E6C0 B7               OR A
 316+ E6C1 20 03            JR NZ, .doRemap
 317+ E6C3              .skipRemap:
 318+ E6C3 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 319+ E6C4 E1               POP HL
 320+ E6C5 C9               RET
 321+ E6C6
 322+ E6C6              .doRemap:
 323+ E6C6 D5               PUSH DE
 324+ E6C7 C5               PUSH BC
 325+ E6C8
 326+ E6C8 7C               LD A, H                     ; A = attr original
 327+ E6C9 4F               LD C, A                     ; C = attr original
 328+ E6CA
 329+ E6CA                  ; Guardar flash + ink (bits 7, 2-0)
 330+ E6CA E6 87            AND $87                     ; A = F000_0III
 331+ E6CC 47               LD B, A                     ; B = flash | ink
 332+ E6CD
 333+ E6CD                  ; Extraer paper+bright como indice 0-15
 334+ E6CD 79               LD A, C
 335+ E6CE E6 78            AND $78                     ; A = 0BPPP000
 336+ E6D0 0F               RRCA
 337+ E6D1 0F               RRCA
 338+ E6D2 0F               RRCA                        ; A = 0000BPPP = indice
 339+ E6D3
 340+ E6D3                  ; Elegir tabla segun tipo de sprite
 341+ E6D3 5F               LD E, A
 342+ E6D4 16 00            LD D, 0
 343+ E6D6 3A 52 E5         LD A, (BgSpriteIsHouse)
 344+ E6D9 B7               OR A
 345+ E6DA 28 05            JR Z, .useStdTable
 346+ E6DC 2A 50 E5         LD HL, (CurrentHouseRemapTable)
 347+ E6DF 18 03            JR .doLookup
 348+ E6E1              .useStdTable:
 349+ E6E1 2A 4E E5         LD HL, (CurrentRemapTable)
 350+ E6E4              .doLookup:
 351+ E6E4 19               ADD HL, DE
 352+ E6E5 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 353+ E6E6
 354+ E6E6                  ; Reconstruir atributo
 355+ E6E6 07               RLCA
 356+ E6E7 07               RLCA
 357+ E6E8 07               RLCA                        ; A = 0BPPP000
 358+ E6E9 B0               OR B                        ; A = FBPPPIII
 359+ E6EA
 360+ E6EA C1               POP BC
 361+ E6EB D1               POP DE
 362+ E6EC E1               POP HL
 363+ E6ED C9               RET
 364+ E6EE
 365+ E6EE              ; ==============================================================================
 366+ E6EE              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 367+ E6EE              ; ==============================================================================
 368+ E6EE              ; Entrada: A = sprite ID
 369+ E6EE              ; Setea BgSpriteIsHouse (0 o 1)
 370+ E6EE              ; Preserva: A, DE, IX
 371+ E6EE              ;
 372+ E6EE              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 373+ E6EE              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 374+ E6EE              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 375+ E6EE              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 376+ E6EE              ; ==============================================================================
 377+ E6EE              CheckIfHouseSprite:
 378+ E6EE F5               PUSH AF
 379+ E6EF E5               PUSH HL
 380+ E6F0 C5               PUSH BC
 381+ E6F1
 382+ E6F1 47               LD B, A                     ; B = id buscado
 383+ E6F2
 384+ E6F2 AF               XOR A
 385+ E6F3 32 52 E5         LD (BgSpriteIsHouse), A     ; Default: no es house
 386+ E6F6
 387+ E6F6 21 0B E2         LD HL, HouseIdList
 388+ E6F9              .checkLoop:
 389+ E6F9 7E               LD A, (HL)
 390+ E6FA FE FF            CP $FF
 391+ E6FC 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 392+ E6FE B8               CP B
 393+ E6FF 28 03            JR Z, .checkFound
 394+ E701 23               INC HL
 395+ E702 18 F5            JR .checkLoop
 396+ E704
 397+ E704              .checkFound:
 398+ E704 3E 01            LD A, 1
 399+ E706 32 52 E5         LD (BgSpriteIsHouse), A
 400+ E709
 401+ E709              .checkDone:
 402+ E709 C1               POP BC
 403+ E70A E1               POP HL
 404+ E70B F1               POP AF
 405+ E70C C9               RET
 406+ E70D
 407+ E70D              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 408+ E70D              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 409+ E70D              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 410+ E70D
 411+ E70D              ; ==============================================================================
 412+ E70D              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 413+ E70D              ; ==============================================================================
 414+ E70D              ; Formato: XX,YY:NN nombre_room     DY
 415+ E70D              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 416+ E70D              ; ==============================================================================
 417+ E70D              DrawRoomInfo:
 418+ E70D                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 419+ E70D 1E 00            LD E, 0
 420+ E70F 06 0D            LD B, 13
 421+ E711              .clearLoop:
 422+ E711 C5               PUSH BC
 423+ E712 D5               PUSH DE
 424+ E713 3E 20            LD A, ' '
 425+ E715 CD C8 E8         CALL DrawHudChar
 426+ E718 D1               POP DE
 427+ E719 C1               POP BC
 428+ E71A 1C               INC E
 429+ E71B 10 F4            DJNZ .clearLoop
 430+ E71D
 431+ E71D                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 432+ E71D 3A AE 82         LD A, (CurrentScreenX)
 433+ E720 1E 00            LD E, 0
 434+ E722 CD 80 E7         CALL .drawDec2
 435+ E725
 436+ E725                  ; --- ',' en col 2 ---
 437+ E725 3E 2C            LD A, ','
 438+ E727 1E 02            LD E, 2
 439+ E729 CD C8 E8         CALL DrawHudChar
 440+ E72C
 441+ E72C                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 442+ E72C 3A AF 82         LD A, (CurrentScreenY)
 443+ E72F 1E 03            LD E, 3
 444+ E731 CD 80 E7         CALL .drawDec2
 445+ E734
 446+ E734                  ; --- ':' en col 5 ---
 447+ E734 3E 3A            LD A, ':'
 448+ E736 1E 05            LD E, 5
 449+ E738 CD C8 E8         CALL DrawHudChar
 450+ E73B
 451+ E73B                  ; --- Obtener room index de MapTable[Y*16+X] ---
 452+ E73B 3A AF 82         LD A, (CurrentScreenY)
 453+ E73E 6F               LD L, A
 454+ E73F 26 00            LD H, 0
 455+ E741 29               ADD HL, HL
 456+ E742 29               ADD HL, HL
 457+ E743 29               ADD HL, HL
 458+ E744 29               ADD HL, HL                  ; HL = Y * 16
 459+ E745 3A AE 82         LD A, (CurrentScreenX)
 460+ E748 5F               LD E, A
 461+ E749 16 00            LD D, 0
 462+ E74B 19               ADD HL, DE                  ; HL = Y*16 + X
 463+ E74C 11 76 E0         LD DE, MapTable
 464+ E74F 19               ADD HL, DE
 465+ E750 7E               LD A, (HL)                  ; A = room index (0-47)
 466+ E751 F5               PUSH AF                     ; guardar room index
 467+ E752
 468+ E752                  ; --- Room index como 2 hex en cols 6-7 ---
 469+ E752 F5               PUSH AF
 470+ E753 0F               RRCA
 471+ E754 0F               RRCA
 472+ E755 0F               RRCA
 473+ E756 0F               RRCA
 474+ E757 E6 0F            AND $0F
 475+ E759 CD 9E E7         CALL .hexToAscii
 476+ E75C 1E 06            LD E, 6
 477+ E75E CD C8 E8         CALL DrawHudChar
 478+ E761 F1               POP AF
 479+ E762 E6 0F            AND $0F
 480+ E764 CD 9E E7         CALL .hexToAscii
 481+ E767 1E 07            LD E, 7
 482+ E769 CD C8 E8         CALL DrawHudChar
 483+ E76C
 484+ E76C                  ; --- Espacio en col 8 ---
 485+ E76C 3E 20            LD A, ' '
 486+ E76E 1E 08            LD E, 8
 487+ E770 CD C8 E8         CALL DrawHudChar
 488+ E773
 489+ E773                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 490+ E773 F1               POP AF                      ; A = room index (descartar)
 491+ E774
 492+ E774                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 493+ E774 21 20 58         LD HL, ATTR_BASE + 1 * 32
 494+ E777 3E 47            LD A, $47                   ; bright white on black
 495+ E779 06 0D            LD B, 13
 496+ E77B              .attrLoop:
 497+ E77B 77               LD (HL), A
 498+ E77C 23               INC HL
 499+ E77D 10 FC            DJNZ .attrLoop
 500+ E77F C9               RET
 501+ E780
 502+ E780              ; --- Helpers ---
 503+ E780              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 504+ E780              .drawDec2:
 505+ E780 4B               LD C, E                     ; guardar columna inicial
 506+ E781 06 00            LD B, 0                     ; decenas
 507+ E783              .divLoop:
 508+ E783 FE 0A            CP 10
 509+ E785 38 05            JR C, .divDone
 510+ E787 D6 0A            SUB 10
 511+ E789 04               INC B
 512+ E78A 18 F7            JR .divLoop
 513+ E78C              .divDone:
 514+ E78C                  ; B = decenas, A = unidades
 515+ E78C F5               PUSH AF                     ; guardar unidades
 516+ E78D 78               LD A, B
 517+ E78E C6 30            ADD A, '0'
 518+ E790 59               LD E, C
 519+ E791 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 520+ E792 CD C8 E8         CALL DrawHudChar
 521+ E795 C1               POP BC                      ; restaurar C
 522+ E796 F1               POP AF
 523+ E797 C6 30            ADD A, '0'
 524+ E799 59               LD E, C
 525+ E79A 1C               INC E
 526+ E79B C3 C8 E8         JP DrawHudChar              ; tail call
 527+ E79E
 528+ E79E              .hexToAscii:
 529+ E79E FE 0A            CP 10
 530+ E7A0 38 03            JR C, .isDigit
 531+ E7A2 C6 37            ADD A, 'A' - 10
 532+ E7A4 C9               RET
 533+ E7A5              .isDigit:
 534+ E7A5 C6 30            ADD A, '0'
 535+ E7A7 C9               RET
 536+ E7A8
 537+ E7A8              ; ==============================================================================
 538+ E7A8              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 539+ E7A8              ; Usa font custom (DayHudFont) en vez de ROM font
 540+ E7A8              ; ==============================================================================
 541+ E7A8              DrawDayCycleHUD:
 542+ E7A8                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 543+ E7A8 21 66 EA         LD HL, DayHudFont + 0 * 8          ; 'D'
 544+ E7AB 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 545+ E7AE CD 1D E8         CALL .drawChar
 546+ E7B1 21 6E EA         LD HL, DayHudFont + 1 * 8          ; 'A'
 547+ E7B4 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 548+ E7B7 CD 1D E8         CALL .drawChar
 549+ E7BA 21 76 EA         LD HL, DayHudFont + 2 * 8          ; 'Y'
 550+ E7BD 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 551+ E7C0 CD 1D E8         CALL .drawChar
 552+ E7C3                  ; Col 7 = espacio (limpiar)
 553+ E7C3 11 07 40         LD DE, $4007
 554+ E7C6 CD 26 E8         CALL .clearChar
 555+ E7C9
 556+ E7C9                  ; --- Digito decenas (col 8) ---
 557+ E7C9 3A 03 C0         LD A, (DayCycleCount)
 558+ E7CC FE 0A            CP 10
 559+ E7CE 38 20            JR C, .singleDigit
 560+ E7D0                  ; Dos digitos: dividir A / 10
 561+ E7D0 06 00            LD B, 0
 562+ E7D2              .divLoop:
 563+ E7D2 D6 0A            SUB 10
 564+ E7D4 04               INC B
 565+ E7D5 FE 0A            CP 10
 566+ E7D7 30 F9            JR NC, .divLoop
 567+ E7D9                  ; B = decenas, A = unidades
 568+ E7D9 F5               PUSH AF                             ; Guardar unidades
 569+ E7DA 78               LD A, B
 570+ E7DB CD 10 E8         CALL .getDigitFont
 571+ E7DE 11 08 40         LD DE, $4008                        ; Col 8
 572+ E7E1 CD 1D E8         CALL .drawChar
 573+ E7E4 F1               POP AF                              ; Recuperar unidades
 574+ E7E5 CD 10 E8         CALL .getDigitFont
 575+ E7E8 11 09 40         LD DE, $4009                        ; Col 9
 576+ E7EB CD 1D E8         CALL .drawChar
 577+ E7EE 18 14            JR .setAttrs
 578+ E7F0
 579+ E7F0              .singleDigit:
 580+ E7F0                  ; Una cifra: decena = 0, unidad = A
 581+ E7F0 F5               PUSH AF
 582+ E7F1 21 7E EA         LD HL, DayHudFont + 3 * 8          ; '0'
 583+ E7F4 11 08 40         LD DE, $4008                        ; Col 8
 584+ E7F7 CD 1D E8         CALL .drawChar
 585+ E7FA F1               POP AF
 586+ E7FB CD 10 E8         CALL .getDigitFont
 587+ E7FE 11 09 40         LD DE, $4009                        ; Col 9
 588+ E801 CD 1D E8         CALL .drawChar
