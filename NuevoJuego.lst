2234+ AB36              .cwDoCheck:
2235+ AB36                  ; AABB con margen de 8px (1 celda) por cada lado:
2236+ AB36                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2237+ AB36                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2238+ AB36                  ; --- Check X ---
2239+ AB36 3A 5D 8D         LD A, (WellPosX)
2240+ AB39 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2241+ AB3B 4F               LD C, A
2242+ AB3C 3A A3 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2243+ AB3F B9               CP C                                ; playerX < wellRight+margen?
2244+ AB40 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2245+ AB42 3A A3 81         LD A, (EntityTable + ENT_POSX)
2246+ AB45 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2247+ AB47 4F               LD C, A
2248+ AB48 3A 5D 8D         LD A, (WellPosX)                    ; A = wellX
2249+ AB4B B9               CP C                                ; wellX < playerRight+margen?
2250+ AB4C 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2251+ AB4E                  ; --- Check Y ---
2252+ AB4E 3A 5E 8D         LD A, (WellPosY)
2253+ AB51 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2254+ AB53 4F               LD C, A
2255+ AB54 3A A4 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2256+ AB57 B9               CP C                                ; playerY < wellBottom+margen?
2257+ AB58 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2258+ AB5A 3A A4 81         LD A, (EntityTable + ENT_POSY)
2259+ AB5D C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2260+ AB5F 4F               LD C, A
2261+ AB60 3A 5E 8D         LD A, (WellPosY)                    ; A = wellY
2262+ AB63 B9               CP C                                ; wellY < playerBottom+margen?
2263+ AB64 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2264+ AB66                  ; --- Overlap! Recuperar salud y stamina ---
2265+ AB66 3E 10            LD A, HEALTH_MAX
2266+ AB68 32 86 B3         LD (PlayerHealth), A
2267+ AB6B 3E 10            LD A, STAMINA_MAX
2268+ AB6D 32 87 B3         LD (PlayerStamina), A
