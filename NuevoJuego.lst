 181+ DA82 06 06            LD B, TOMB_SRC_W_BYTES
 182+ DA84              .dpxByteLoop:
 183+ DA84 7E               LD A, (HL)
 184+ DA85 23               INC HL
 185+ DA86 4F               LD C, A                         ; C = src byte original
 186+ DA87 E5               PUSH HL                         ; save src ptr
 187+ DA88 C5               PUSH BC                         ; save count + src byte
