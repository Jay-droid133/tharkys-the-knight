  1+  0000              ; ==============================================================================
  2+  0000              ; CONSTANTES DEL SISTEMA Y JUEGO
  3+  0000              ; ==============================================================================
  4+  0000
  5+  0000              ; --- Direcciones de Memoria ---
  6+  0000              ORIGIN_ADDRESS  EQU 32768           ; $8000 - Inicio de nuestro juego en RAM
  7+  0000              SP_ADDRESS      EQU 65368           ; $FF58 - Tope seguro para la pila (Stack)
  8+  0000
  9+  0000              ; --- Mapa de Video ---
 10+  0000              SCREEN_BASE     EQU 16384           ; $4000 - Inicio de los píxeles
 11+  0000              ATTR_BASE       EQU 22528           ; $5800 - Inicio de los atributos (colores)
 12+  0000              ATTR_SIZE       EQU 768             ; Tamaño de la zona de atributos
 13+  0000
 14+  0000              ; --- Colores Básicos (Tinta) ---
 15+  0000              BLACK           EQU 0
 16+  0000              BLUE            EQU 1
 17+  0000              RED             EQU 2
 18+  0000              MAGENTA         EQU 3
 19+  0000              GREEN           EQU 4
 20+  0000              CYAN            EQU 5
 21+  0000              YELLOW          EQU 6
 22+  0000              WHITE           EQU 7
 23+  0000
 24+  0000              ; --- Rutinas de la ROM ---
 25+  0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
 26+  0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
 27+  0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
 28+  0000
 29+  0000              ; --- Movimiento estilo Sabre Wulf (8-bit, sin subpixel) ---
 30+  0000              ; --- Movimiento estilo Sabre Wulf ---
 31+  0000              ; Original: 4px cada 2 frames = 2px/frame de media.
 32+  0000              ; Nosotros: 2px cada frame = mismo resultado, pero sin flicker.
 33+  0000              SPEED_RUN       EQU 2               ; 2 px/frame (equivalente al original)
 34+  0000              SPEED_FIGHT     EQU 2               ; 2 px/frame peleando
 35+  0000
 36+  0000              ; --- Limites de pantalla (en pixeles) ---
 37+  0000              ; Los limites maximos asumen sprite 16px ancho, ~16px alto.
 38+  0000              ; Para sprites mas grandes, el clamp real se ajusta en runtime.
 39+  0000              SCREEN_MIN_X    EQU 0               ; Limite izquierdo
 40+  0000              SCREEN_MAX_X    EQU 232             ; Limite derecho (con margen para shift: 256 - 16 - 8)
 41+  0000              SCREEN_MIN_Y    EQU 0               ; Limite superior
 42+  0000              SCREEN_MAX_Y    EQU 160             ; Limite inferior (176 - 16)
 43+  0000
 44+  0000              ; --- Animacion (delays en frames de pantalla) ---
 45+  0000              ANIM_DELAY_RUN  EQU 4               ; Frames entre cambios de anim corriendo
 46+  0000              ANIM_DELAY_IDLE EQU 8               ; Frames entre cambios de anim idle
 47+  0000              ANIM_DELAY_FIGHT EQU 3              ; Frames entre cambios de anim peleando
 48+  0000
 49+  0000              ; --- Numero de frames de animacion por estado ---
 50+  0000              ANIM_FRAMES_WALK    EQU 3           ; Frames caminando por direccion
 51+  0000              ANIM_FRAMES_FIGHT   EQU 2           ; Frames peleando por direccion
 52+  0000              ANIM_FRAMES_IDLE    EQU 2           ; Frames idle
 53+  0000
 54+  0000              ; --- Direcciones del jugador ---
 55+  0000              DIR_NONE        EQU 0
 56+  0000              DIR_N           EQU 1
 57+  0000              DIR_S           EQU 2
 58+  0000              DIR_E           EQU 4
 59+  0000              DIR_W           EQU 8
 60+  0000              DIR_NE          EQU 5               ; DIR_N | DIR_E
 61+  0000              DIR_NW          EQU 9               ; DIR_N | DIR_W
 62+  0000              DIR_SE          EQU 6               ; DIR_S | DIR_E
 63+  0000              DIR_SW          EQU 10              ; DIR_S | DIR_W
 64+  0000
 65+  0000              ; --- Estados del jugador ---
 66+  0000              STATE_IDLE      EQU 0
 67+  0000              STATE_RUNNING   EQU 1
 68+  0000              STATE_FIGHTING  EQU 2
 69+  0000
 70+  0000              ; ==============================================================================
 71+  0000              ; SISTEMA DE ENTIDADES (estilo Sabre Wulf)
 72+  0000              ; ==============================================================================
 73+  0000              ; Estructura de 12 bytes por entidad, universal para player/enemigos/objetos.
 74+  0000              ; Acceso via IX + ENT_* offset.
 75+  0000              ; ==============================================================================
 76+  0000
 77+  0000              ; --- Offsets en la estructura de entidad (12 bytes) ---
 78+  0000              ENT_SPRITEID    EQU 0               ; Frame actual (indice en SpriteFrameTable)
 79+  0000              ENT_TYPE        EQU 1               ; Tipo de entidad
 80+  0000              ENT_STATE       EQU 2               ; Estado (idle/run/fight/dead)
 81+  0000              ENT_POSX        EQU 3               ; Pixel X en pantalla (8-bit)
 82+  0000              ENT_POSY        EQU 4               ; Pixel Y en pantalla (8-bit)
 83+  0000              ENT_ATTR        EQU 5               ; Color/atributo ZX Spectrum
 84+  0000              ENT_DELTAX      EQU 6               ; Velocidad X (signed byte)
 85+  0000              ENT_DELTAY      EQU 7               ; Velocidad Y (signed byte)
 86+  0000              ENT_ANIMBASE    EQU 8               ; SpriteID del primer frame de la anim
 87+  0000              ENT_ANIMTIMER   EQU 9               ; Countdown para cambiar frame
 88+  0000              ENT_DIR         EQU 10              ; bits 0-3: dir actual, bits 4-7: lastHDir
 89+  0000              ENT_FLAGS       EQU 11              ; bit0: visible, bit1: solid, bit2: destructible
 90+  0000
 91+  0000              ENT_SIZE        EQU 12              ; Bytes por entidad
 92+  0000              NUM_ENTITIES    EQU 17              ; Total de slots
 93+  0000
 94+  0000              ; --- Tipos de entidad ---
 95+  0000              TYPE_NONE       EQU 0               ; Slot inactivo
 96+  0000              TYPE_PLAYER     EQU 1               ; Jugador (Sabreman)
 97+  0000              TYPE_IMMORTAL   EQU 2               ; Enemigo permanente (rhino, wolf, etc.)
 98+  0000              TYPE_NASTY      EQU 3               ; Enemigo destruible (spawn aleatorio)
 99+  0000              TYPE_OBJECT     EQU 4               ; Objeto coleccionable
100+  0000
101+  0000              ; --- Flags de entidad (ENT_FLAGS) ---
102+  0000              ENTF_VISIBLE    EQU 0               ; bit 0: entidad visible
103+  0000              ENTF_SOLID      EQU 1               ; bit 1: entidad solida (colisiona)
104+  0000              ENTF_DESTRUCT   EQU 2               ; bit 2: destruible
105+  0000
106+  0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
107+  0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
108+  0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
109+  0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
110+  0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
111+  0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
112+  0000
113+  0000              ; ==============================================================================
114+  0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
115+  0000              ; ==============================================================================
116+  0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
117+  0000              ; Cada pantalla es una vista fija (flick-screen).
118+  0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
119+  0000              ;
120+  0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
121+  0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
122+  0000              ; (Las 2 filas inferiores = HUD/panel de estado)
123+  0000              ; ==============================================================================
124+  0000
125+  0000              ; --- Dimensiones del mapa ---
126+  0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
127+  0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
128+  0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
129+  0000
130+  0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
131+  0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
132+  0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
133+  0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
134+  0000
135+  0000              ; --- Dimensiones del area de juego (en pixeles) ---
136+  0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
137+  0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
138+  0000              HUD_Y_START     EQU 176             ; Pixel Y donde empieza el HUD (filas 22-23)
139+  0000
140+  0000              ; --- Tipos de tile ---
141+  0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
142+  0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
143+  0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
144+  0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
145+  0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
146+  0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
147+  0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
148+  0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
149+  0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
150+  0000              TILE_PATH_H     EQU 8               ; Camino horizontal
151+  0000              TILE_PATH_V     EQU 9               ; Camino vertical
152+  0000              ; Tiles 10-255 reservados para mas vegetacion, objetos, etc.
153+  0000
154+  0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
155+  0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
156+  0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
157+  0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
158+  0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
159+  0000
160+  0000              ; --- Posicion inicial del jugador en el mapa ---
161+  0000              START_SCREEN_X  EQU 8               ; Pantalla inicial X (centro del mapa)
162+  0000              START_SCREEN_Y  EQU 8               ; Pantalla inicial Y
163+  0000              START_PLAYER_X  EQU 120             ; Pixel X inicial dentro de la pantalla
164+  0000              START_PLAYER_Y  EQU 88              ; Pixel Y inicial dentro de la pantalla
165+  0000
166+  0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
167+  0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
168+  0000
# file closed: constants.asm
 10   0000                  INCLUDE "macros.asm"
# file opened: macros.asm
  1+  0000              ; ==============================================================================
  2+  0000              ; MACROS ÚTILES PARA EL DESARROLLO
  3+  0000              ; ==============================================================================
  4+  0000
  5+  0000                  ; Marco para pintar un color rápidamente en la pantalla
  6+  0000                  MACRO SET_COLOR color, address
  7+  0000 ~                    LD A, color
  8+  0000 ~                    LD HL, address
  9+  0000 ~                    LD (HL), A
 10+  0000                  ENDM
 11+  0000
 12+  0000                  ; Macro estándar para sumar A a HL
 13+  0000                  MACRO ADD_HL_A
 14+  0000 ~                    ADD A, L
 15+  0000 ~                    LD L, A
 16+  0000 ~                    ADC A, H
 17+  0000 ~                    SUB L
 18+  0000 ~                    LD H, A
 19+  0000                  ENDM
 20+  0000
# file closed: macros.asm
 11   0000
 12   0000                  ; Origen del programa en RAM
 13   0000                  ORG ORIGIN_ADDRESS
 14   8000
 15   8000              Inicio:
 16   8000 F3               DI                      ; Deshabilitar interrupciones
 17   8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
 18   8004
 19   8004                  ; Configuración inicial (Borde negro, etc.)
 20   8004 3E 01            LD A, BLUE              ; A = 1 (Azul oscuro)
 21   8006 D3 FE            OUT (254), A            ; Cambia el color del borde a azul oscuro
 22   8008
 23   8008                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
 24   8008                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
 25   8008 21 00 40         LD HL, SCREEN_BASE
 26   800B 11 01 40         LD DE, SCREEN_BASE + 1
 27   800E 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
 28   8011 AF               XOR A                   ; A = 0
 29   8012 77               LD (HL), A
 30   8013 ED B0            LDIR
 31   8015
 32   8015                  ; Inicializar sistema de pantallas
 33   8015 CD F6 85         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
 34   8018 CD 2A 83         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
 35   801B
 36   801B ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
 37   801D FB               EI                      ; Habilitar interrupciones
 38   801E
 39   801E              MainLoop:
 40   801E 76               HALT                    ; Esperar al barrido de pantalla (sincronizar a 50 FPS)
 41   801F
 42   801F                  ; Bucle principal estilo Sabre Wulf: Input -> Transicion -> Pantalla -> Entidades
 43   801F CD B3 82         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
 44   8022 CD 33 86         CALL CheckScreenTransition  ; Detectar y ejecutar cambio de pantalla
 45   8025 CD B7 86         CALL DrawScreen             ; Dibujar pantalla si es necesario (flick-screen)
 46   8028 CD 6C 83         CALL ProcessEntities        ; Per-entity: erase -> update -> draw
 47   802B                  ;CALL DrawDebugInfo          ; DEBUG: desactivado, corrompe XOR en tercio superior
 48   802B
 49   802B                  ; Incrementar contador de frames
 50   802B 3A 34 80         LD A, (GameFrameCounter)
 51   802E 3C               INC A
 52   802F 32 34 80         LD (GameFrameCounter), A
 53   8032
 54   8032 18 EA            JR MainLoop
 55   8034
 56   8034                  ; Inclusión de módulos
 57   8034                  INCLUDE "variables.asm"
