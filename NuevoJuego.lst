 303+ F072              ; ==============================================================================
 304+ F072              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ F072              ; ==============================================================================
 306+ F072              ; IN:  A = key id (1..6)
 307+ F072              ; OUT: DE = ptr
 308+ F072              ; Destruye: AF, HL.
 309+ F072              ; ==============================================================================
 310+ F072              KeyIdToPtr:
 311+ F072 3D               DEC A
 312+ F073 87               ADD A, A                            ; *2 (DEFW size)
 313+ F074 6F               LD L, A
 314+ F075 26 00            LD H, 0
 315+ F077 11 76 D7         LD DE, KeyLockTable
 316+ F07A 19               ADD HL, DE
 317+ F07B 5E               LD E, (HL)
 318+ F07C 23               INC HL
 319+ F07D 56               LD D, (HL)
 320+ F07E C9               RET
 321+ F07F
 322+ F07F              ; ==============================================================================
 323+ F07F              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ F07F              ; ==============================================================================
 325+ F07F              ; IN:  A = action id (1, 2, ...)
 326+ F07F              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ F07F              ;      Z flag set si no encontrado.
 328+ F07F              ; Destruye: AF, BC, HL.
 329+ F07F              ; ==============================================================================
 330+ F07F              ActionToTriggerPtr:
 331+ F07F 4F               LD C, A                             ; C = action id buscada
 332+ F080 21 0E D8         LD HL, BumpTriggerTable
 333+ F083              .attLoop:
 334+ F083 5E               LD E, (HL)
 335+ F084 23               INC HL
 336+ F085 56               LD D, (HL)
 337+ F086 23               INC HL                              ; HL -> required_key
 338+ F087 7A               LD A, D
 339+ F088 B3               OR E
 340+ F089 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ F08B 23               INC HL                              ; HL -> action
 342+ F08C 7E               LD A, (HL)
 343+ F08D 23               INC HL                              ; HL -> next entry
 344+ F08E B9               CP C
 345+ F08F 20 F2            JR NZ, .attLoop
 346+ F091 F6 01            OR 1                                ; clear Z (encontrado)
 347+ F093 C9               RET
 348+ F094              .attNotFound:
 349+ F094 16 00            LD D, 0
 350+ F096 1E 00            LD E, 0
 351+ F098 AF               XOR A                               ; set Z
 352+ F099 C9               RET
 353+ F09A
 354+ F09A              ; ==============================================================================
 355+ F09A              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ F09A              ; ==============================================================================
 357+ F09A              ; PickupTable layout (per-entry, 7 bytes):
 358+ F09A              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ F09A              ; Terminator: $FF (single byte).
 360+ F09A              ;
 361+ F09A              ; IN:  DE = ptr a buscar
 362+ F09A              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ F09A              ;      B = C = $FF si no encontrado (Z).
 364+ F09A              ; Destruye: AF, HL. Preserva DE.
 365+ F09A              ; ==============================================================================
 366+ F09A              FindPickupScreen:
 367+ F09A 21 D9 DF         LD HL, PickupTable
 368+ F09D              .fpsLoop:
 369+ F09D 7E               LD A, (HL)
 370+ F09E FE FF            CP $FF
 371+ F0A0 28 1C            JR Z, .fpsNotFound
 372+ F0A2 E5               PUSH HL
 373+ F0A3 23               INC HL                              ; -> mapY
 374+ F0A4 23               INC HL                              ; -> ptr_lo
 375+ F0A5 7E               LD A, (HL)
 376+ F0A6 BB               CP E
 377+ F0A7 20 0C            JR NZ, .fpsNoMatch
 378+ F0A9 23               INC HL                              ; -> ptr_hi
 379+ F0AA 7E               LD A, (HL)
 380+ F0AB BA               CP D
 381+ F0AC 20 07            JR NZ, .fpsNoMatch
 382+ F0AE E1               POP HL                              ; back to entry start (mapX)
 383+ F0AF 46               LD B, (HL)                          ; B = mapX
 384+ F0B0 23               INC HL
 385+ F0B1 4E               LD C, (HL)                          ; C = mapY
 386+ F0B2 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F0B4 C9               RET
 388+ F0B5              .fpsNoMatch:
 389+ F0B5 E1               POP HL
 390+ F0B6 C5               PUSH BC
 391+ F0B7 01 07 00         LD BC, 7
 392+ F0BA 09               ADD HL, BC
 393+ F0BB C1               POP BC
 394+ F0BC 18 DF            JR .fpsLoop
 395+ F0BE              .fpsNotFound:
 396+ F0BE 06 FF            LD B, $FF
 397+ F0C0 0E FF            LD C, $FF
 398+ F0C2 AF               XOR A                               ; set Z
 399+ F0C3 C9               RET
 400+ F0C4
 401+ F0C4              ; ==============================================================================
 402+ F0C4              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F0C4              ; ==============================================================================
 404+ F0C4              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F0C4              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F0C4              ; third). El brujula se redibuja solo cuando:
 407+ F0C4              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F0C4              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F0C4              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F0C4              ;
 411+ F0C4              ; Color (atributo de las 4 celdas):
 412+ F0C4              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F0C4              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F0C4              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F0C4              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F0C4              ;
 417+ F0C4              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F0C4              ; ==============================================================================
 419+ F0C4
 420+ F0C4              COMPASS_COL     EQU 24
 421+ F0C4              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F0C4
 423+ F0C4              ; ==============================================================================
 424+ F0C4              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F0C4              ; ==============================================================================
 426+ F0C4              ; Formato:
 427+ F0C4              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F0C4              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F0C4              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F0C4              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F0C4              ; ==============================================================================
 432+ F0C4              DrawMilestoneHUD:
 433+ F0C4 3A B9 82         LD A, (CurrentObjective)
 434+ F0C7 FE 0B            CP 11
 435+ F0C9 28 26            JR Z, .mhAllDone
 436+ F0CB 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F0CC 06 00            LD B, 0                     ; B = decenas
 438+ F0CE              .mhDivLoop:
 439+ F0CE FE 0A            CP 10
 440+ F0D0 38 05            JR C, .mhDivDone
 441+ F0D2 D6 0A            SUB 10
 442+ F0D4 04               INC B
 443+ F0D5 18 F7            JR .mhDivLoop
 444+ F0D7              .mhDivDone:
 445+ F0D7 F5               PUSH AF                     ; A = unidades
 446+ F0D8 78               LD A, B
 447+ F0D9 B7               OR A
 448+ F0DA 20 04            JR NZ, .mhTensDigit
 449+ F0DC 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F0DE 18 02            JR .mhWriteTens
 451+ F0E0              .mhTensDigit:
 452+ F0E0 C6 30            ADD A, '0'
 453+ F0E2              .mhWriteTens:
 454+ F0E2 1E 1E            LD E, 30
 455+ F0E4 CD CA E6         CALL DrawHudCharRow0
 456+ F0E7 F1               POP AF                      ; A = unidades
 457+ F0E8 C6 30            ADD A, '0'
 458+ F0EA 1E 1F            LD E, 31
 459+ F0EC CD CA E6         CALL DrawHudCharRow0
 460+ F0EF 18 0E            JR .mhAttrs
 461+ F0F1              .mhAllDone:
 462+ F0F1 3E 4F            LD A, 'O'
 463+ F0F3 1E 1E            LD E, 30
 464+ F0F5 CD CA E6         CALL DrawHudCharRow0
 465+ F0F8 3E 4B            LD A, 'K'
 466+ F0FA 1E 1F            LD E, 31
 467+ F0FC CD CA E6         CALL DrawHudCharRow0
 468+ F0FF              .mhAttrs:
 469+ F0FF 3E 47            LD A, $47                   ; bright white
 470+ F101 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F104 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F107 C9               RET
 473+ F108
 474+ F108              ; ==============================================================================
 475+ F108              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F108              ; ==============================================================================
 477+ F108              DrawCompass:
 478+ F108                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F108 3A BA 82         LD A, (ObjectiveScreenX)
 480+ F10B FE FF            CP $FF
 481+ F10D CA C4 F2         JP Z, ClearCompass
 482+ F110
 483+ F110                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F110                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F110                  ; reflejar la dir del path al cambiar de sala).
 486+ F110 3A 0A 83         LD A, (CurrentScreenX)
 487+ F113 47               LD B, A
 488+ F114 3A BD 82         LD A, (LastCompassScreenX)
 489+ F117 B8               CP B
 490+ F118 C2 3E F1         JP NZ, .dcRedrawNewScreen
 491+ F11B 3A 0B 83         LD A, (CurrentScreenY)
 492+ F11E 47               LD B, A
 493+ F11F 3A BE 82         LD A, (LastCompassScreenY)
 494+ F122 B8               CP B
 495+ F123 C2 3E F1         JP NZ, .dcRedrawNewScreen
 496+ F126 3A BC 82         LD A, (PreviousObjectiveDistance)
 497+ F129 FE FF            CP $FF
 498+ F12B 28 16            JR Z, .dcRedraw
 499+ F12D 3A BF 82         LD A, (CompassWobbleCounter)
 500+ F130 B7               OR A
 501+ F131 20 10            JR NZ, .dcRedraw
 502+ F133                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F133                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F133 3A BF 5F         LD A, (MagicCompassTimer)
 505+ F136 47               LD B, A
 506+ F137 3A C0 5F         LD A, (MagicCompassTimer + 1)
 507+ F13A B0               OR B
 508+ F13B C8               RET Z                               ; sin cambios + sin wobble + sin magic
 509+ F13C 18 05            JR .dcRedraw
 510+ F13E
 511+ F13E              .dcRedrawNewScreen:
 512+ F13E                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 513+ F13E                  ; sincronicamente en CheckScreenTransition.doTransition (via
 514+ F13E                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 515+ F13E                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 516+ F13E                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 517+ F13E                  ;
 518+ F13E                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 519+ F13E                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 520+ F13E                  ; hay que volver a dibujar el sprite minimo una vez.
 521+ F13E 3E FF            LD A, $FF
