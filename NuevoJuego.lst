4579+ A64F DD 21 92 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)  ; Empezar en slot 1
4580+ A653 06 09            LD B, NUM_MONSTERS + NUM_NASTIES       ; Slots 1-12
4581+ A655
4582+ A655              .checkLoop:
4583+ A655 DD 7E 01         LD A, (IX+ENT_TYPE)
