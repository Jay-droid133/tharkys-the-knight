 258+ EB6B              ; ==============================================================================
 259+ EB6B              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 260+ EB6B              ; ==============================================================================
 261+ EB6B              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 262+ EB6B              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 263+ EB6B              ; carga sprite nuevo, dibuja, repaint attrs.
 264+ EB6B              ; ==============================================================================
 265+ EB6B              UpdateRouletteBody:
 266+ EB6B 3A BC 5F         LD A, (RouletteActive)
 267+ EB6E B7               OR A
 268+ EB6F C8               RET Z
 269+ EB70 3A B4 5F         LD A, (RandomSynthMapX)
 270+ EB73 FE FE            CP $FE
 271+ EB75 C8               RET Z                                   ; recogido / inactivo: no ciclar
 272+ EB76
 273+ EB76                  ; Tick frame counter
 274+ EB76 21 BE 5F         LD HL, RouletteFrameCounter
 275+ EB79 35               DEC (HL)
 276+ EB7A C0               RET NZ                                  ; aun no toca avanzar
 277+ EB7B
 278+ EB7B                  ; --- Counter expirado: ciclar al siguiente tipo ---
 279+ EB7B 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 280+ EB7D 32 BE 5F         LD (RouletteFrameCounter), A
 281+ EB80
 282+ EB80                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 283+ EB80 2A B6 5F         LD HL, (RandomSynthPtr)
 284+ EB83 3E 03            LD A, 3
 285+ EB85 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7
 286+ EB88 3A B8 5F         LD A, (RandomSynthCharX)
 287+ EB8B 47               LD B, A
 288+ EB8C 3A B9 5F         LD A, (RandomSynthCharY)
 289+ EB8F 4F               LD C, A
 290+ EB90 DD 21 FD 86      LD IX, BgSpriteBuffer
 291+ EB94 CD 20 6D         CALL DrawBgSpriteXOR_B7
 292+ EB97
 293+ EB97                  ; Avanzar idx con wrap (AdvanceRouletteIdx skipea ROUL_COMPASS si la
 294+ EB97                  ; brujula permanente esta activa — no se ve un solo frame de compass).
 295+ EB97 3A BD 5F         LD A, (RouletteIdx)
 296+ EB9A CD 64 EB         CALL AdvanceRouletteIdx
 297+ EB9D 32 BD 5F         LD (RouletteIdx), A
 298+ EBA0
