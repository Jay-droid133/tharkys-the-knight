 745+ ED4D                  ; quedaban fuera de rango (+127 max). JP unconditional, +1 byte por entrada.
 746+ ED4D FE 08            CP PROB_LIFE_END
 747+ ED4F DA D4 ED         JP C, .urpDoLife
 748+ ED52 FE 18            CP PROB_HEALTH_END
 749+ ED54 DA DF ED         JP C, .urpDoHealth
 750+ ED57 FE 28            CP PROB_STAMINA_END
 751+ ED59 DA ED ED         JP C, .urpDoStamina
 752+ ED5C FE 38            CP PROB_RAYO_END
 753+ ED5E DA FB ED         JP C, .urpDoRayo
 754+ ED61 FE 48            CP PROB_CARACOL_END
 755+ ED63 DA 06 EE         JP C, .urpDoCaracol
 756+ ED66 FE 58            CP PROB_ROULETTE_END
 757+ ED68 DA 48 EE         JP C, .urpDoRoulette
 758+ ED6B FE 68            CP PROB_MUSHROOM_END
 759+ ED6D DA 11 EE         JP C, .urpDoMushroom
