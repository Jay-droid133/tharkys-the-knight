 336+ A28D              .plDoErase:
 337+ A28D                  ; --- Erase viejo ---
 338+ A28D CD DA A7         CALL GetOldSpriteAddr
 339+ A290 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 340+ A293 DD 7E 0C         LD A, (IX+ENT_OLDX)
 341+ A296 5F               LD E, A
 342+ A297 DD E5            PUSH IX
 343+ A299 DD 2A 62 A7      LD IX, (OldSprAddr)
 344+ A29D CD CD 9C         CALL DrawSprite
 345+ A2A0 DD E1            POP IX
 346+ A2A2                  ; Restaurar atributos del fondo en posicion vieja
 347+ A2A2 DD 56 0D         LD D, (IX+ENT_OLDY)
 348+ A2A5 DD 5E 0C         LD E, (IX+ENT_OLDX)
 349+ A2A8 CD 80 D5         CALL RestoreOldAttr
