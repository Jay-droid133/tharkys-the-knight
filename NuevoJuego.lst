2160+ AD8A              ; ==============================================================================
2161+ AD8A              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2162+ AD8A              ; ==============================================================================
2163+ AD8A              CheckWellPickup:
2164+ AD8A 3A 57 90         LD A, (WellActive)
2165+ AD8D B7               OR A
2166+ AD8E C8               RET Z                               ; No hay pozo en esta pantalla
2167+ AD8F                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2168+ AD8F 2A 5B 90         LD HL, (WellCooldownTimer)
2169+ AD92 7C               LD A, H
2170+ AD93 B5               OR L
2171+ AD94 C0               RET NZ                              ; timer > 0 → skip
2172+ AD95                  ; Ya esta al maximo? No hacer nada
2173+ AD95 3A F2 B5         LD A, (PlayerHealth)
2174+ AD98 FE 10            CP HEALTH_MAX
2175+ AD9A 20 06            JR NZ, .cwDoCheck
2176+ AD9C 3A F3 B5         LD A, (PlayerStamina)
2177+ AD9F FE 10            CP STAMINA_MAX
2178+ ADA1 C8               RET Z                               ; Ambos al maximo → nada
2179+ ADA2              .cwDoCheck:
2180+ ADA2                  ; AABB con margen de 8px (1 celda) por cada lado:
2181+ ADA2                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2182+ ADA2                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2183+ ADA2                  ; --- Check X ---
2184+ ADA2 3A 58 90         LD A, (WellPosX)
2185+ ADA5 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2186+ ADA7 4F               LD C, A
2187+ ADA8 3A 9E 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2188+ ADAB B9               CP C                                ; playerX < wellRight+margen?
2189+ ADAC 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2190+ ADAE 3A 9E 81         LD A, (EntityTable + ENT_POSX)
