 537+ E765              ; ==============================================================================
 538+ E765              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 539+ E765              ; Usa font custom (DayHudFont) en vez de ROM font
 540+ E765              ; ==============================================================================
 541+ E765              DrawDayCycleHUD:
 542+ E765                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 543+ E765 21 23 EA         LD HL, DayHudFont + 0 * 8          ; 'D'
 544+ E768 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 545+ E76B CD DA E7         CALL .drawChar
 546+ E76E 21 2B EA         LD HL, DayHudFont + 1 * 8          ; 'A'
 547+ E771 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 548+ E774 CD DA E7         CALL .drawChar
 549+ E777 21 33 EA         LD HL, DayHudFont + 2 * 8          ; 'Y'
 550+ E77A 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 551+ E77D CD DA E7         CALL .drawChar
 552+ E780                  ; Col 7 = espacio (limpiar)
 553+ E780 11 07 40         LD DE, $4007
 554+ E783 CD E3 E7         CALL .clearChar
 555+ E786
 556+ E786                  ; --- Digito decenas (col 8) ---
 557+ E786 3A 8D BF         LD A, (DayCycleCount)
 558+ E789 FE 0A            CP 10
 559+ E78B 38 20            JR C, .singleDigit
 560+ E78D                  ; Dos digitos: dividir A / 10
 561+ E78D 06 00            LD B, 0
 562+ E78F              .divLoop:
 563+ E78F D6 0A            SUB 10
 564+ E791 04               INC B
 565+ E792 FE 0A            CP 10
 566+ E794 30 F9            JR NC, .divLoop
 567+ E796                  ; B = decenas, A = unidades
 568+ E796 F5               PUSH AF                             ; Guardar unidades
 569+ E797 78               LD A, B
 570+ E798 CD CD E7         CALL .getDigitFont
 571+ E79B 11 08 40         LD DE, $4008                        ; Col 8
 572+ E79E CD DA E7         CALL .drawChar
 573+ E7A1 F1               POP AF                              ; Recuperar unidades
 574+ E7A2 CD CD E7         CALL .getDigitFont
 575+ E7A5 11 09 40         LD DE, $4009                        ; Col 9
 576+ E7A8 CD DA E7         CALL .drawChar
 577+ E7AB 18 14            JR .setAttrs
 578+ E7AD
 579+ E7AD              .singleDigit:
 580+ E7AD                  ; Una cifra: decena = 0, unidad = A
 581+ E7AD F5               PUSH AF
 582+ E7AE 21 3B EA         LD HL, DayHudFont + 3 * 8          ; '0'
 583+ E7B1 11 08 40         LD DE, $4008                        ; Col 8
 584+ E7B4 CD DA E7         CALL .drawChar
 585+ E7B7 F1               POP AF
 586+ E7B8 CD CD E7         CALL .getDigitFont
 587+ E7BB 11 09 40         LD DE, $4009                        ; Col 9
 588+ E7BE CD DA E7         CALL .drawChar
