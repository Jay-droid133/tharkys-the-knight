1084+ 9204              ; ==============================================================================
1085+ 9204              ; UpdatePlayerMovement - Fiel a Sabre Wulf: mueve cada N frames
1086+ 9204              ; ==============================================================================
1087+ 9204              ; El original usa turns_per_player_move=2: el player se mueve cada 2 frames.
1088+ 9204              ; Desplazamiento por turno: SPEED_RUN_X horizontal, SPEED_RUN_Y vertical.
1089+ 9204              ; ==============================================================================
1090+ 9204              UpdatePlayerMovement:
1091+ 9204                  ; Fiel a Sabre Wulf: mueve solo cada PLAYER_MOVE_TURNS frames
1092+ 9204 3A 97 81         LD A, (PlayerMoveTimer)
1093+ 9207 3D               DEC A
1094+ 9208 32 97 81         LD (PlayerMoveTimer), A
1095+ 920B C0               RET NZ                      ; No es el turno de moverse
1096+ 920C 3E 01            LD A, PLAYER_MOVE_TURNS
1097+ 920E 32 97 81         LD (PlayerMoveTimer), A     ; Resetear timer
1098+ 9211
1099+ 9211 DD 7E 0A         LD A, (IX+ENT_DIR)
1100+ 9214 E6 0F            AND $0F                     ; Dir actual (bits 0-3)
1101+ 9216 C8               RET Z                       ; Sin movimiento
