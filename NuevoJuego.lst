 277+ 6811              ; ==============================================================================
 278+ 6811              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 279+ 6811              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 280+ 6811              ; ==============================================================================
 281+ 6811              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 282+ 6811              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 283+ 6811              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 284+ 6811              ; uniformemente negro -- el efecto que pidio el usuario.
 285+ 6811              ;
 286+ 6811              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 287+ 6811              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 288+ 6811              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 289+ 6811              ; Destruye: AF, BC, DE, HL.
 290+ 6811              ; ==============================================================================
 291+ 6811              ClearSmokeAttrs:
 292+ 6811                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 293+ 6811 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 294+ 6814 CB 3F            SRL A
 294+ 6816 CB 3F          SRL A
 294+ 6818 CB 3F          SRL A                   ; A = char Y (post-HUD)
 295+ 681A 26 00            LD H, 0
 296+ 681C 6F               LD L, A
 297+ 681D 29               ADD HL, HL                              ; *2
 298+ 681E 29               ADD HL, HL                              ; *4
 299+ 681F 29               ADD HL, HL                              ; *8
 300+ 6820 29               ADD HL, HL                              ; *16
 301+ 6821 29               ADD HL, HL                              ; *32
 302+ 6822 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 303+ 6825 CB 3F            SRL A
 303+ 6827 CB 3F          SRL A
 303+ 6829 CB 3F          SRL A                   ; A = char X
 304+ 682B 5F               LD E, A
 305+ 682C 16 00            LD D, 0
 306+ 682E 19               ADD HL, DE
 307+ 682F 11 00 58         LD DE, $5800
 308+ 6832 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 309+ 6833 AF               XOR A                                   ; paper black, ink black
 310+ 6834 77               LD (HL), A                              ; (charY, charX)
 311+ 6835 23               INC HL
 312+ 6836 77               LD (HL), A                              ; (charY, charX+1)
 313+ 6837 11 1F 00         LD DE, 31
 314+ 683A 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 315+ 683B 77               LD (HL), A
 316+ 683C 23               INC HL
 317+ 683D 77               LD (HL), A                              ; (charY+1, charX+1)
 318+ 683E C9               RET
