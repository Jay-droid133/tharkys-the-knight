 148+ 6AC2              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 149+ 6AC2              ; ==============================================================================
 150+ 6AC2              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 151+ 6AC2              ;      A  = bank (0-7) donde vive el sprite
 152+ 6AC2              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 153+ 6AC2              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 154+ 6AC2              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 155+ 6AC2              ;
 156+ 6AC2              ; Mismo patron que LoadRoomToBuffer: inline page switch + SP alterno (slot 1)
 157+ 6AC2              ; durante la copia. IRQs siguen procesandose normalmente -> tick de musica
 158+ 6AC2              ; no se desfasa durante DrawScreen. Sin DI/EI internos.
 159+ 6AC2              ;
 160+ 6AC2              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 161+ 6AC2              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 162+ 6AC2              ; ==============================================================================
 163+ 6AC2              LoadBgSpriteToBuffer:
 164+ 6AC2                  ; Mismo patron que LoadRoomToBuffer: SP -> alterno antes del page switch
 165+ 6AC2                  ; para que las IRQs durante la copia no corrompan el stack normal (que
 166+ 6AC2                  ; queda fisicamente "oculto" mientras slot 3 = bank de sprite).
 167+ 6AC2 32 54 6B         LD (.lbsBankSave), A
 168+ 6AC5                  ; Preservar BC del caller (DrawScreen usa B=x_char, C=y_char) ANTES de
 169+ 6AC5                  ; cambiar SP — el PUSH va al stack normal. El LD SP siguiente preserva
 170+ 6AC5                  ; ese frame; al restaurar SP el POP BC final lo recupera.
 171+ 6AC5 C5               PUSH BC
 172+ 6AC6 ED 73 55 6B      LD (.lbsSavedSP), SP            ; salva SP normal (con PC + BC pushed)
 173+ 6ACA 31 CE 6B         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
 174+ 6ACD                  ; Page bank deseado inline (SIN DI)
 175+ 6ACD 3A 85 8D         LD A, (CurrentPaging)
 176+ 6AD0 E6 F8            AND $F8
 177+ 6AD2 47               LD B, A                         ; B = paging limpio sin bank
 178+ 6AD3 3A 54 6B         LD A, (.lbsBankSave)
 179+ 6AD6 E6 07            AND $07                         ; safety: solo bits 0-2
 180+ 6AD8 B0               OR B                            ; merge bank en paging
 181+ 6AD9 32 85 8D         LD (CurrentPaging), A
 182+ 6ADC 01 FD 7F         LD BC, $7FFD
 183+ 6ADF ED 79            OUT (C), A
