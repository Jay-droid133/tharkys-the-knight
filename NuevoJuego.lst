 440+ 6AD4              ; ==============================================================================
 441+ 6AD4              ; DrawRemainsForType - dibuja los restos del tipo de monstruo en la base de
 442+ 6AD4              ; su estatua (charY + 2). Localiza la estatua en CurrentScreenBuffer.
 443+ 6AD4              ; ==============================================================================
 444+ 6AD4              ; IN:  A = type idx (0..2)
 445+ 6AD4              ; OUT: -
 446+ 6AD4              ; Destruye: AF, BC, DE, HL, IX.
 447+ 6AD4              ; Si el tipo no tiene estatua en la pantalla actual, retorna sin dibujar.
 448+ 6AD4              ; ==============================================================================
 449+ 6AD4              DrawRemainsForType:
 450+ 6AD4 32 0D 6B         LD (.drftType), A
 451+ 6AD7                  ; Lookup statue id por tipo
 452+ 6AD7 21 A9 69         LD HL, StatueIdTable
 453+ 6ADA 5F               LD E, A
 454+ 6ADB 16 00            LD D, 0
 455+ 6ADD 19               ADD HL, DE
 456+ 6ADE 7E               LD A, (HL)                              ; A = statue id
 457+ 6ADF B7               OR A
 458+ 6AE0 C8               RET Z                                   ; sin estatua exportada
 459+ 6AE1 32 0E 6B         LD (.drftStatueId), A
 460+ 6AE4                  ; Scan CurrentScreenBuffer para encontrar la estatua (formato 4B)
 461+ 6AE4 2A 0A 83         LD HL, (CurrentScreenAddr)
 462+ 6AE7              .drftLoop:
 463+ 6AE7 7E               LD A, (HL)
 464+ 6AE8 FE FF            CP $FF
 465+ 6AEA C8               RET Z                                   ; estatua no esta en esta sala
 466+ 6AEB 47               LD B, A                                 ; B = current id
 467+ 6AEC 3A 0E 6B         LD A, (.drftStatueId)
 468+ 6AEF B8               CP B
 469+ 6AF0 28 06            JR Z, .drftFound
 470+ 6AF2 11 04 00         LD DE, 4
 471+ 6AF5 19               ADD HL, DE
 472+ 6AF6 18 EF            JR .drftLoop
 473+ 6AF8              .drftFound:
 474+ 6AF8                  ; HL apunta al id, +1=charX, +2=charY, +3=variant
 475+ 6AF8 23               INC HL
 476+ 6AF9 46               LD B, (HL)                              ; B = charX
 477+ 6AFA 23               INC HL
 478+ 6AFB 7E               LD A, (HL)
 479+ 6AFC C6 02            ADD A, 2                                ; charY + 2 (base de la estatua)
 480+ 6AFE 4F               LD C, A
 481+ 6AFF                  ; Lookup remains id por tipo
 482+ 6AFF 3A 0D 6B         LD A, (.drftType)
 483+ 6B02 21 AF 69         LD HL, RemainsIdTable
 484+ 6B05 5F               LD E, A
 485+ 6B06 16 00            LD D, 0
 486+ 6B08 19               ADD HL, DE
 487+ 6B09 7E               LD A, (HL)
 488+ 6B0A C3 0F 6B         JP DrawBgSpriteByIdAtChar               ; tail call (no-op si id 0)
 489+ 6B0D 00           .drftType:     DEFB 0
 490+ 6B0E 00           .drftStatueId: DEFB 0
