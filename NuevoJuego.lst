 643+ 7418 6F               LD L, A
 644+ 7419 30 01            JR NC, .pspaNoCarry
 645+ 741B 24               INC H
 646+ 741C              .pspaNoCarry:
 647+ 741C 11 00 58         LD DE, ATTR_BASE
 648+ 741F 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 649+ 7420                  ; --- Fila 0: TL, TR ---
 650+ 7420 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
 651+ 7423 77               LD (HL), A
 652+ 7424 23               INC HL
 653+ 7425 3A D5 5F         LD A, (RandomSynthAttrTR)
 654+ 7428 77               LD (HL), A
 655+ 7429                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
 656+ 7429 7D               LD A, L
 657+ 742A C6 1F            ADD A, 31
 658+ 742C 6F               LD L, A
 659+ 742D 30 01            JR NC, .pspaNoCarry2
 660+ 742F 24               INC H
