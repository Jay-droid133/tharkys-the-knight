5480+ BD47              NUM_NASTY_TYPES EQU 4
5481+ BD47              DiurnalTypeTable:                       ; DY, C1, A2
5482+ BD47 30               DEFB SPRID_ENEMY_4          ; Eagle
5483+ BD48 20               DEFB SPRID_ENEMY_0          ; Spider
5484+ BD49 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5485+ BD4A 2C               DEFB SPRID_ENEMY_3          ; Snake
5486+ BD4B              CrepuscularTypeTable:                   ; C2, N1
5487+ BD4B 34               DEFB SPRID_ENEMY_5          ; Rat
5488+ BD4C 28               DEFB SPRID_ENEMY_2          ; Bat
5489+ BD4D 24               DEFB SPRID_ENEMY_1          ; Scorpion
5490+ BD4E 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
