7400+ C836 FE FF            CP MAI_DIR_NONE
7401+ C838 C8               RET Z
7402+ C839                  ; Setear DELTAX/Y segun dir
7403+ C839 FE 00            CP MAI_DIR_N
7404+ C83B 28 12            JR Z, .bfsAppN
7405+ C83D FE 01            CP MAI_DIR_S
7406+ C83F 28 18            JR Z, .bfsAppS
7407+ C841 FE 02            CP MAI_DIR_W
7408+ C843 28 1E            JR Z, .bfsAppW
7409+ C845 DD 36 06 02      LD (IX+ENT_DELTAX), MONSTER_SPEED
7410+ C849 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7411+ C84D 18 1C            JR .bfsAppMove
7412+ C84F              .bfsAppN:
7413+ C84F DD 36 06 00      LD (IX+ENT_DELTAX), 0
7414+ C853 DD 36 07 FE      LD (IX+ENT_DELTAY), -MONSTER_SPEED
7415+ C857 18 12            JR .bfsAppMove
7416+ C859              .bfsAppS:
