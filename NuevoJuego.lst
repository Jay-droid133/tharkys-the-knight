   1+ EF93              ; ==============================================================================
   2+ EF93              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EF93              ; ==============================================================================
   4+ EF93              ; CurrentObjective vive en variables.asm. Valor:
   5+ EF93              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EF93              ;   11    = todos los hitos completados (juego ganado)
   7+ EF93              ;
   8+ EF93              ; ----------------------------------------------------------------------------
   9+ EF93              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EF93              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EF93              ;                       recoger el sprite cuyo behavior coincide.
  12+ EF93              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EF93              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EF93              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EF93              ;
  16+ EF93              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EF93              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EF93              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EF93              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EF93              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EF93              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EF93              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EF93              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EF93              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EF93              ;
  26+ EF93              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EF93              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EF93              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EF93              ;
  30+ EF93              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre.
  31+ EF93              ; Util para saltarse hitos durante test (incluido M#7 SPECIAL si quisieras
  32+ EF93              ; saltarte la cinematica de captura entera, aunque ya avanza solo desde
  33+ EF93              ; UpdatePostTrapPause.uptpKey al soltar el cheque).
  34+ EF93              ; ==============================================================================
  35+ EF93
  36+ EF93              MILESTONE_TYPE_PICKUP   EQU 1
  37+ EF93              MILESTONE_TYPE_TRIGGER  EQU 2
  38+ EF93              MILESTONE_TYPE_SPECIAL  EQU 3
  39+ EF93
  40+ EF93              MilestoneTable:
  41+ EF93 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EF95 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EF97 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EF99 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EF9B 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EF9D 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EF9F 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EFA1                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EFA1                                                      ;    el cheque, no por tecla M en runtime)
  50+ EFA1 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EFA3                                                      ;    ir a recogerlo tras drop de la
  52+ EFA3                                                      ;    cinematica de la iglesia)
  53+ EFA3 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EFA5 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EFA7 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EFA9
  57+ EFA9              MilestoneResolveTable:
  58+ EFA9 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EFAB 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EFAD 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EFAF 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EFB1 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EFB3 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EFB5 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ EFB7 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  66+ EFB9 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  67+ EFBB 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  68+ EFBD 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  69+ EFBF
  70+ EFBF              ; ==============================================================================
  71+ EFBF              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  72+ EFBF              ; ==============================================================================
  73+ EFBF              ; IN:  A = key id (1..6) recien recogida
  74+ EFBF              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  75+ EFBF              ; ==============================================================================
  76+ EFBF              CheckMilestonePickup:
  77+ EFBF E5               PUSH HL
  78+ EFC0 D5               PUSH DE
  79+ EFC1 C5               PUSH BC
  80+ EFC2 F5               PUSH AF
  81+ EFC3 47               LD B, A                             ; B = key id recibida
  82+ EFC4 3A BF 82         LD A, (CurrentObjective)
  83+ EFC7 FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  84+ EFC9 30 27            JR NC, .cmpDone                     ; sin hitos pendientes
  85+ EFCB 87               ADD A, A                            ; *2 (entry size)
  86+ EFCC 6F               LD L, A
  87+ EFCD 26 00            LD H, 0
  88+ EFCF 11 93 EF         LD DE, MilestoneTable
  89+ EFD2 19               ADD HL, DE
  90+ EFD3 7E               LD A, (HL)                          ; tipo
  91+ EFD4 FE 01            CP MILESTONE_TYPE_PICKUP
  92+ EFD6 20 1A            JR NZ, .cmpDone
  93+ EFD8 23               INC HL
  94+ EFD9 7E               LD A, (HL)                          ; ref esperada
  95+ EFDA B8               CP B
  96+ EFDB 20 15            JR NZ, .cmpDone
  97+ EFDD 3A BF 82         LD A, (CurrentObjective)
  98+ EFE0 3C               INC A
  99+ EFE1 32 BF 82         LD (CurrentObjective), A
 100+ EFE4 CD 85 F0         CALL ResolveObjectiveScreen
 101+ EFE7 3E FF            LD A, $FF
 102+ EFE9 32 C2 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 103+ EFEC CD EF 6D         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 104+ EFEF CD 1F 6E         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 105+ EFF2              .cmpDone:
 106+ EFF2 F1               POP AF
 107+ EFF3 C1               POP BC
 108+ EFF4 D1               POP DE
 109+ EFF5 E1               POP HL
 110+ EFF6 C9               RET
 111+ EFF7
 112+ EFF7              ; ==============================================================================
 113+ EFF7              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
 114+ EFF7              ; ==============================================================================
 115+ EFF7              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
 116+ EFF7              ; Preserva: AF, BC, DE, HL.
 117+ EFF7              ; ==============================================================================
 118+ EFF7              CheckMilestoneTrigger:
 119+ EFF7 E5               PUSH HL
 120+ EFF8 D5               PUSH DE
 121+ EFF9 C5               PUSH BC
 122+ EFFA F5               PUSH AF
 123+ EFFB 47               LD B, A
 124+ EFFC 3A BF 82         LD A, (CurrentObjective)
 125+ EFFF FE 0B            CP 11
 126+ F001 30 27            JR NC, .cmtDone
 127+ F003 87               ADD A, A
 128+ F004 6F               LD L, A
 129+ F005 26 00            LD H, 0
 130+ F007 11 93 EF         LD DE, MilestoneTable
 131+ F00A 19               ADD HL, DE
 132+ F00B 7E               LD A, (HL)
 133+ F00C FE 02            CP MILESTONE_TYPE_TRIGGER
 134+ F00E 20 1A            JR NZ, .cmtDone
 135+ F010 23               INC HL
 136+ F011 7E               LD A, (HL)
 137+ F012 B8               CP B
 138+ F013 20 15            JR NZ, .cmtDone
 139+ F015 3A BF 82         LD A, (CurrentObjective)
 140+ F018 3C               INC A
 141+ F019 32 BF 82         LD (CurrentObjective), A
 142+ F01C CD 85 F0         CALL ResolveObjectiveScreen
 143+ F01F 3E FF            LD A, $FF
 144+ F021 32 C2 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 145+ F024 CD EF 6D         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 146+ F027 CD 1F 6E         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 147+ F02A              .cmtDone:
 148+ F02A F1               POP AF
 149+ F02B C1               POP BC
 150+ F02C D1               POP DE
 151+ F02D E1               POP HL
 152+ F02E C9               RET
 153+ F02F
 154+ F02F              ; ==============================================================================
 155+ F02F              ; CheckMilestoneDebugKey - Tecla H: skip de hito (debug). Siempre avanza.
 156+ F02F              ; ==============================================================================
 157+ F02F              CheckMilestoneDebugKey:
 158+ F02F 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 159+ F031 DB FE            IN A, ($FE)
 160+ F033 CB 67            BIT 4, A                            ; H = bit 4 (0 = pulsada)
 161+ F035 20 23            JR NZ, .cmdkNotPressed
 162+ F037 3A 5F F0         LD A, (MilestoneKeyDebounce)
 163+ F03A B7               OR A
 164+ F03B C0               RET NZ
 165+ F03C 3E 01            LD A, 1
 166+ F03E 32 5F F0         LD (MilestoneKeyDebounce), A
 167+ F041 3A BF 82         LD A, (CurrentObjective)
 168+ F044 FE 0B            CP 11
 169+ F046 D0               RET NC
 170+ F047 3C               INC A
 171+ F048 32 BF 82         LD (CurrentObjective), A
 172+ F04B CD 85 F0         CALL ResolveObjectiveScreen
 173+ F04E 3E FF            LD A, $FF
 174+ F050 32 C2 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 175+ F053 CD EF 6D         CALL CancelMagicCompass             ; magic compass normal: cancela al saltar hito
 176+ F056 CD 1F 6E         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 177+ F059 C9               RET
 178+ F05A              .cmdkNotPressed:
 179+ F05A AF               XOR A
 180+ F05B 32 5F F0         LD (MilestoneKeyDebounce), A
 181+ F05E C9               RET
 182+ F05F
 183+ F05F 00           MilestoneKeyDebounce: DEFB 0
 184+ F060
 185+ F060              ; ==============================================================================
 186+ F060              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->7->0 (debug)
 187+ F060              ; ==============================================================================
 188+ F060              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 189+ F060              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 190+ F060              ; inmediato del valor actual.
 191+ F060              ;
 192+ F060              ; Rango: 1..6 son keys clasicas (forest/ruins/cemetery/clock/church/towngate),
 193+ F060              ; 7 es BankCheck (cheque del banco, slot 7 en KeyLockTable). Util para
 194+ F060              ; probar el bump trigger del banco sin tener que completar M7 antes.
 195+ F060              ;
 196+ F060              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 197+ F060              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 198+ F060              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 199+ F060              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 200+ F060              ; ==============================================================================
 201+ F060              CheckCurrentKeyCycleKey:
 202+ F060 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 203+ F062 DB FE            IN A, ($FE)
 204+ F064 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 205+ F066 20 17            JR NZ, .ckcNotPressed
 206+ F068 3A 84 F0         LD A, (CurrentKeyCycleDebounce)
 207+ F06B B7               OR A
 208+ F06C C0               RET NZ
 209+ F06D 3E 01            LD A, 1
 210+ F06F 32 84 F0         LD (CurrentKeyCycleDebounce), A
 211+ F072 3A B6 82         LD A, (CurrentKey)
 212+ F075 3C               INC A
 213+ F076 FE 08            CP 8
 214+ F078 38 01            JR C, .ckcSet                       ; 1..7 dentro de rango (7 = BankCheck)
 215+ F07A AF               XOR A                               ; 8 -> wrap a 0
 216+ F07B              .ckcSet:
 217+ F07B 32 B6 82         LD (CurrentKey), A
 218+ F07E C9               RET
 219+ F07F              .ckcNotPressed:
 220+ F07F AF               XOR A
 221+ F080 32 84 F0         LD (CurrentKeyCycleDebounce), A
 222+ F083 C9               RET
 223+ F084
 224+ F084 00           CurrentKeyCycleDebounce: DEFB 0
 225+ F085
 226+ F085              ; ==============================================================================
 227+ F085              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ F085              ; ==============================================================================
 229+ F085              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ F085              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ F085              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ F085              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ F085              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ F085              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ F085              ;               actuales; queda como salvaguarda.
 236+ F085              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ F085              ; Destruye: AF, BC, DE, HL.
 238+ F085              ; ==============================================================================
 239+ F085              ResolveObjectiveScreen:
 240+ F085 3A BF 82         LD A, (CurrentObjective)
 241+ F088 FE 0B            CP 11
 242+ F08A 30 4D            JR NC, .rosNoTarget
 243+ F08C 87               ADD A, A
 244+ F08D 6F               LD L, A
 245+ F08E 26 00            LD H, 0
 246+ F090 11 A9 EF         LD DE, MilestoneResolveTable
 247+ F093 19               ADD HL, DE
 248+ F094 7E               LD A, (HL)                          ; tipo
 249+ F095 23               INC HL
 250+ F096 46               LD B, (HL)                          ; B = ref
 251+ F097 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ F099 28 06            JR Z, .rosPickup
 253+ F09B FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ F09D 28 08            JR Z, .rosTrigger
 255+ F09F 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ F0A1              .rosPickup:
 257+ F0A1 78               LD A, B
 258+ F0A2 CD E2 F0         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ F0A5 18 10            JR .rosFindPos
 260+ F0A7              .rosTrigger:
 261+ F0A7 78               LD A, B
 262+ F0A8 FE 04            CP 4
 263+ F0AA 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ F0AC FE 03            CP 3
 265+ F0AE 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ F0B0                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ F0B0                                                      ;  Necesario para que la lasting compass tras
 268+ F0B0                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ F0B0 CD EF F0         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ F0B3 7A               LD A, D
 271+ F0B4 B3               OR E
 272+ F0B5 28 22            JR Z, .rosNoTarget
 273+ F0B7              .rosFindPos:
 274+ F0B7 CD 0A F1         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ F0BA 78               LD A, B
 276+ F0BB 32 C0 82         LD (ObjectiveScreenX), A
 277+ F0BE 79               LD A, C
 278+ F0BF 32 C1 82         LD (ObjectiveScreenY), A
 279+ F0C2 C9               RET
 280+ F0C3              .rosBankRoom:
 281+ F0C3                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ F0C3                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ F0C3 3E 08            LD A, BCS_BANK_ROOM_X
 284+ F0C5 32 C0 82         LD (ObjectiveScreenX), A
 285+ F0C8 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ F0CA 32 C1 82         LD (ObjectiveScreenY), A
 287+ F0CD C9               RET
 288+ F0CE              .rosTownGateRoom:
 289+ F0CE                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ F0CE                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ F0CE                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ F0CE 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ F0D0 32 C0 82         LD (ObjectiveScreenX), A
 294+ F0D3 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ F0D5 32 C1 82         LD (ObjectiveScreenY), A
 296+ F0D8 C9               RET
 297+ F0D9              .rosNoTarget:
 298+ F0D9 3E FF            LD A, $FF
 299+ F0DB 32 C0 82         LD (ObjectiveScreenX), A
 300+ F0DE 32 C1 82         LD (ObjectiveScreenY), A
 301+ F0E1 C9               RET
 302+ F0E2
 303+ F0E2              ; ==============================================================================
 304+ F0E2              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ F0E2              ; ==============================================================================
 306+ F0E2              ; IN:  A = key id (1..6)
 307+ F0E2              ; OUT: DE = ptr
 308+ F0E2              ; Destruye: AF, HL.
 309+ F0E2              ; ==============================================================================
 310+ F0E2              KeyIdToPtr:
 311+ F0E2 3D               DEC A
 312+ F0E3 87               ADD A, A                            ; *2 (DEFW size)
 313+ F0E4 6F               LD L, A
 314+ F0E5 26 00            LD H, 0
 315+ F0E7 11 99 D7         LD DE, KeyLockTable
 316+ F0EA 19               ADD HL, DE
 317+ F0EB 5E               LD E, (HL)
 318+ F0EC 23               INC HL
 319+ F0ED 56               LD D, (HL)
 320+ F0EE C9               RET
 321+ F0EF
 322+ F0EF              ; ==============================================================================
 323+ F0EF              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ F0EF              ; ==============================================================================
 325+ F0EF              ; IN:  A = action id (1, 2, ...)
 326+ F0EF              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ F0EF              ;      Z flag set si no encontrado.
 328+ F0EF              ; Destruye: AF, BC, HL.
 329+ F0EF              ; ==============================================================================
 330+ F0EF              ActionToTriggerPtr:
 331+ F0EF 4F               LD C, A                             ; C = action id buscada
 332+ F0F0 21 31 D8         LD HL, BumpTriggerTable
 333+ F0F3              .attLoop:
 334+ F0F3 5E               LD E, (HL)
 335+ F0F4 23               INC HL
 336+ F0F5 56               LD D, (HL)
 337+ F0F6 23               INC HL                              ; HL -> required_key
 338+ F0F7 7A               LD A, D
 339+ F0F8 B3               OR E
 340+ F0F9 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ F0FB 23               INC HL                              ; HL -> action
 342+ F0FC 7E               LD A, (HL)
 343+ F0FD 23               INC HL                              ; HL -> next entry
 344+ F0FE B9               CP C
 345+ F0FF 20 F2            JR NZ, .attLoop
 346+ F101 F6 01            OR 1                                ; clear Z (encontrado)
 347+ F103 C9               RET
 348+ F104              .attNotFound:
 349+ F104 16 00            LD D, 0
 350+ F106 1E 00            LD E, 0
 351+ F108 AF               XOR A                               ; set Z
 352+ F109 C9               RET
 353+ F10A
 354+ F10A              ; ==============================================================================
 355+ F10A              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ F10A              ; ==============================================================================
 357+ F10A              ; PickupTable layout (per-entry, 7 bytes):
 358+ F10A              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ F10A              ; Terminator: $FF (single byte).
 360+ F10A              ;
 361+ F10A              ; IN:  DE = ptr a buscar
 362+ F10A              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ F10A              ;      B = C = $FF si no encontrado (Z).
 364+ F10A              ; Destruye: AF, HL. Preserva DE.
 365+ F10A              ; ==============================================================================
 366+ F10A              FindPickupScreen:
 367+ F10A 21 49 E0         LD HL, PickupTable
 368+ F10D              .fpsLoop:
 369+ F10D 7E               LD A, (HL)
 370+ F10E FE FF            CP $FF
 371+ F110 28 1C            JR Z, .fpsNotFound
 372+ F112 E5               PUSH HL
 373+ F113 23               INC HL                              ; -> mapY
 374+ F114 23               INC HL                              ; -> ptr_lo
 375+ F115 7E               LD A, (HL)
 376+ F116 BB               CP E
 377+ F117 20 0C            JR NZ, .fpsNoMatch
 378+ F119 23               INC HL                              ; -> ptr_hi
 379+ F11A 7E               LD A, (HL)
 380+ F11B BA               CP D
 381+ F11C 20 07            JR NZ, .fpsNoMatch
 382+ F11E E1               POP HL                              ; back to entry start (mapX)
 383+ F11F 46               LD B, (HL)                          ; B = mapX
 384+ F120 23               INC HL
 385+ F121 4E               LD C, (HL)                          ; C = mapY
 386+ F122 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F124 C9               RET
 388+ F125              .fpsNoMatch:
 389+ F125 E1               POP HL
 390+ F126 C5               PUSH BC
 391+ F127 01 07 00         LD BC, 7
 392+ F12A 09               ADD HL, BC
 393+ F12B C1               POP BC
 394+ F12C 18 DF            JR .fpsLoop
 395+ F12E              .fpsNotFound:
 396+ F12E 06 FF            LD B, $FF
 397+ F130 0E FF            LD C, $FF
 398+ F132 AF               XOR A                               ; set Z
 399+ F133 C9               RET
 400+ F134
 401+ F134              ; ==============================================================================
 402+ F134              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F134              ; ==============================================================================
 404+ F134              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F134              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F134              ; third). El brujula se redibuja solo cuando:
 407+ F134              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F134              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F134              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F134              ;
 411+ F134              ; Color (atributo de las 4 celdas):
 412+ F134              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F134              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F134              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F134              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F134              ;
 417+ F134              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F134              ; ==============================================================================
 419+ F134
