 503+ 8FC4 86               ADD A, (HL)
 504+ 8FC5 32 BC 97         LD (MaiGapScreenId), A
 505+ 8FC8
 506+ 8FC8                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 507+ 8FC8 F3               DI
 508+ 8FC9
 509+ 8FC9                  ; Inline page bank 6
 510+ 8FC9 3A 84 8D         LD A, (CurrentPaging)
 511+ 8FCC E6 F8            AND $F8
 512+ 8FCE F6 06            OR 6
 513+ 8FD0 32 84 8D         LD (CurrentPaging), A
 514+ 8FD3 01 FD 7F         LD BC, $7FFD
 515+ 8FD6 ED 79            OUT (C), A
 516+ 8FD8
 517+ 8FD8                  ; --- BANK 6 PAGED. NO STACK OPS. NO CALLs. ---
 518+ 8FD8 3A BC 97         LD A, (MaiGapScreenId)
 519+ 8FDB 6F               LD L, A
 520+ 8FDC 26 00            LD H, 0
 521+ 8FDE 29               ADD HL, HL                      ; *2
 522+ 8FDF 11 00 C0         LD DE, ScreenGapsTable
 523+ 8FE2 19               ADD HL, DE                      ; HL = &ScreenGapsTable[sid]
