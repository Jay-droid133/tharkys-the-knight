2448+ AF96 FE A8            CP SCREEN_MAX_Y
2449+ AF98 30 2B            JR NC, .paRevert                    ; Fuera de rango Y
2450+ AF9A FE 10            CP SCREEN_MIN_Y
2451+ AF9C 38 27            JR C, .paRevert
2452+ AF9E DD 77 04         LD (IX+ENT_POSY), A
2453+ AFA1
2454+ AFA1                  ; Comprobar colision con fondo
2455+ AFA1 CD A3 B9         CALL CheckEnemyCollision
2456+ AFA4 20 1F            JR NZ, .paRevert                    ; Choco con pared
2457+ AFA6
2458+ AFA6                  ; --- Animacion durante ataque ---
2459+ AFA6 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2460+ AFA9 20 19            JR NZ, .paAnimDone
2461+ AFAB 3E 04            LD A, 4                             ; Delay fijo rapido durante ataque
2462+ AFAD DD 77 09         LD (IX+ENT_ANIMTIMER), A
2463+ AFB0 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2464+ AFB3 DD 96 08         SUB (IX+ENT_ANIMBASE)
2465+ AFB6 E6 01            AND 1
2466+ AFB8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
2467+ AFBB 20 03            JR NZ, .paFrame1
2468+ AFBD 3C               INC A                               ; Frame 0 → 1
2469+ AFBE 18 01            JR .paFrameSet
2470+ AFC0              .paFrame1:
