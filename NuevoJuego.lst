 629+ 7408 3A 0C 83         LD A, (CurrentScreenY)
 630+ 740B 07               RLCA
 630+ 740C 07             RLCA
 630+ 740D 07             RLCA
 630+ 740E 07             RLCA           ; Y*16
 631+ 740F 21 0B 83         LD HL, CurrentScreenX
 632+ 7412 86               ADD A, (HL)                         ; A = newSid
 633+ 7413 32 CE 5F         LD (RP_CurSid), A
 634+ 7416 3A D4 5F         LD A, (RP_TmpSlot)
 634+ 7419 32 CF 5F       LD (RP_CurSlot), A
 635+ 741C 3A D5 5F         LD A, (RP_TmpRolled)
 635+ 741F 32 D0 5F       LD (RP_CurRolled), A
 636+ 7422 C9               RET
