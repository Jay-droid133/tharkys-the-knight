 261+ 6B06              .lbsLoadDone:
 262+ 6B06                  ; Page bank 0 inline
 263+ 6B06 3A E8 90         LD A, (CurrentPaging)
 264+ 6B09 E6 F8            AND $F8
 265+ 6B0B 32 E8 90         LD (CurrentPaging), A
 266+ 6B0E 01 FD 7F         LD BC, $7FFD
 267+ 6B11 ED 79            OUT (C), A
 268+ 6B13                  ; Restaurar interrupciones si Inicio ya termino
 269+ 6B13 3A 4A 81         LD A, (StartupComplete)
