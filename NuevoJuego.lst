 354+ ED29                  ; Decoracion (cols 0,1,4,5): remap paper via ApplyDayCycleRemap
 355+ ED29                  ; Esfera (cols 2,3): sin remap (gestionada por DrawClockFaceOnly)
 356+ ED29 DD 23            INC IX                  ; saltar attr_h
 357+ ED2B DD 23            INC IX                  ; saltar attr_w
 358+ ED2D AF               XOR A
 359+ ED2E 32 EF E3         LD (BgSpriteIsHouse), A ; clock no es house
 360+ ED31                  ; --- Fila 0 (row 0, cols 13-18) ---
 361+ ED31 21 0D 58         LD HL, $580D
 362+ ED34 DD 7E 00         LD A, (IX+0)
 362+ ED37 CD 55 E5       CALL ApplyDayCycleRemap
 362+ ED3A 77             LD (HL), A
 362+ ED3B 23             INC HL
 363+ ED3C DD 7E 01         LD A, (IX+1)
 363+ ED3F CD 55 E5       CALL ApplyDayCycleRemap
 363+ ED42 77             LD (HL), A
 363+ ED43 23             INC HL
 364+ ED44 DD 7E 02         LD A, (IX+2)
 364+ ED47 77                                       LD (HL), A
 364+ ED48 23             INC HL  ; esfera
 365+ ED49 DD 7E 03         LD A, (IX+3)
 365+ ED4C 77                                       LD (HL), A
 365+ ED4D 23             INC HL  ; esfera
 366+ ED4E DD 7E 04         LD A, (IX+4)
 366+ ED51 CD 55 E5       CALL ApplyDayCycleRemap
 366+ ED54 77             LD (HL), A
 366+ ED55 23             INC HL
 367+ ED56 DD 7E 05         LD A, (IX+5)
 367+ ED59 CD 55 E5       CALL ApplyDayCycleRemap
 367+ ED5C 77             LD (HL), A
 368+ ED5D                  ; --- Fila 1 (row 1, cols 13-18) ---
 369+ ED5D 21 2D 58         LD HL, $582D
 370+ ED60 DD 7E 06         LD A, (IX+6)
 370+ ED63 CD 55 E5       CALL ApplyDayCycleRemap
 370+ ED66 77             LD (HL), A
 370+ ED67 23             INC HL
 371+ ED68 DD 7E 07         LD A, (IX+7)
 371+ ED6B CD 55 E5       CALL ApplyDayCycleRemap
 371+ ED6E 77             LD (HL), A
 371+ ED6F 23             INC HL
 372+ ED70 DD 7E 08         LD A, (IX+8)
 372+ ED73 77                                       LD (HL), A
 372+ ED74 23             INC HL  ; esfera
