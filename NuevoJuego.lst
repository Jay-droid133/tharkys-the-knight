 352+ ECC5                  ; --- Atributos del sprite (2 filas × 6 cols) ---
 353+ ECC5                  ; Layout: [dec0][dec1][sfera_L][sfera_R][dec2][dec3]
 354+ ECC5                  ; Decoracion (cols 0,1,4,5): remap paper via ApplyDayCycleRemap
 355+ ECC5                  ; Esfera (cols 2,3): sin remap (gestionada por DrawClockFaceOnly)
 356+ ECC5 DD 23            INC IX                  ; saltar attr_h
 357+ ECC7 DD 23            INC IX                  ; saltar attr_w
 358+ ECC9 AF               XOR A
 359+ ECCA 32 8B E3         LD (BgSpriteIsHouse), A ; clock no es house
 360+ ECCD                  ; --- Fila 0 (row 0, cols 13-18) ---
 361+ ECCD 21 0D 58         LD HL, $580D
 362+ ECD0 DD 7E 00         LD A, (IX+0)
 362+ ECD3 CD F1 E4       CALL ApplyDayCycleRemap
 362+ ECD6 77             LD (HL), A
 362+ ECD7 23             INC HL
 363+ ECD8 DD 7E 01         LD A, (IX+1)
 363+ ECDB CD F1 E4       CALL ApplyDayCycleRemap
 363+ ECDE 77             LD (HL), A
 363+ ECDF 23             INC HL
 364+ ECE0 DD 7E 02         LD A, (IX+2)
 364+ ECE3 77                                       LD (HL), A
 364+ ECE4 23             INC HL  ; esfera
 365+ ECE5 DD 7E 03         LD A, (IX+3)
 365+ ECE8 77                                       LD (HL), A
 365+ ECE9 23             INC HL  ; esfera
 366+ ECEA DD 7E 04         LD A, (IX+4)
 366+ ECED CD F1 E4       CALL ApplyDayCycleRemap
 366+ ECF0 77             LD (HL), A
 366+ ECF1 23             INC HL
 367+ ECF2 DD 7E 05         LD A, (IX+5)
 367+ ECF5 CD F1 E4       CALL ApplyDayCycleRemap
 367+ ECF8 77             LD (HL), A
 368+ ECF9                  ; --- Fila 1 (row 1, cols 13-18) ---
 369+ ECF9 21 2D 58         LD HL, $582D
 370+ ECFC DD 7E 06         LD A, (IX+6)
 370+ ECFF CD F1 E4       CALL ApplyDayCycleRemap
 370+ ED02 77             LD (HL), A
 370+ ED03 23             INC HL
 371+ ED04 DD 7E 07         LD A, (IX+7)
 371+ ED07 CD F1 E4       CALL ApplyDayCycleRemap
 371+ ED0A 77             LD (HL), A
 371+ ED0B 23             INC HL
 372+ ED0C DD 7E 08         LD A, (IX+8)
 372+ ED0F 77                                       LD (HL), A
 372+ ED10 23             INC HL  ; esfera
 373+ ED11 DD 7E 09         LD A, (IX+9)
 373+ ED14 77                                       LD (HL), A
 373+ ED15 23             INC HL  ; esfera
 374+ ED16 DD 7E 0A         LD A, (IX+10)
 374+ ED19 CD F1 E4       CALL ApplyDayCycleRemap
 374+ ED1C 77             LD (HL), A
 374+ ED1D 23             INC HL
 375+ ED1E DD 7E 0B         LD A, (IX+11)
 375+ ED21 CD F1 E4       CALL ApplyDayCycleRemap
