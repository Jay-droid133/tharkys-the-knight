 226+ EF5F              ; ==============================================================================
 227+ EF5F              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ EF5F              ; ==============================================================================
 229+ EF5F              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ EF5F              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ EF5F              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ EF5F              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ EF5F              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ EF5F              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ EF5F              ;               actuales; queda como salvaguarda.
 236+ EF5F              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ EF5F              ; Destruye: AF, BC, DE, HL.
 238+ EF5F              ; ==============================================================================
 239+ EF5F              ResolveObjectiveScreen:
 240+ EF5F 3A B7 82         LD A, (CurrentObjective)
 241+ EF62 FE 0B            CP 11
 242+ EF64 30 4D            JR NC, .rosNoTarget
 243+ EF66 87               ADD A, A
 244+ EF67 6F               LD L, A
 245+ EF68 26 00            LD H, 0
 246+ EF6A 11 83 EE         LD DE, MilestoneResolveTable
 247+ EF6D 19               ADD HL, DE
 248+ EF6E 7E               LD A, (HL)                          ; tipo
 249+ EF6F 23               INC HL
 250+ EF70 46               LD B, (HL)                          ; B = ref
 251+ EF71 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ EF73 28 06            JR Z, .rosPickup
 253+ EF75 FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ EF77 28 08            JR Z, .rosTrigger
 255+ EF79 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ EF7B              .rosPickup:
 257+ EF7B 78               LD A, B
 258+ EF7C CD BC EF         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ EF7F 18 10            JR .rosFindPos
 260+ EF81              .rosTrigger:
 261+ EF81 78               LD A, B
 262+ EF82 FE 04            CP 4
 263+ EF84 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ EF86 FE 03            CP 3
 265+ EF88 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ EF8A                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ EF8A                                                      ;  Necesario para que la lasting compass tras
 268+ EF8A                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ EF8A CD C9 EF         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ EF8D 7A               LD A, D
 271+ EF8E B3               OR E
 272+ EF8F 28 22            JR Z, .rosNoTarget
 273+ EF91              .rosFindPos:
 274+ EF91 CD E4 EF         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ EF94 78               LD A, B
 276+ EF95 32 B8 82         LD (ObjectiveScreenX), A
 277+ EF98 79               LD A, C
 278+ EF99 32 B9 82         LD (ObjectiveScreenY), A
 279+ EF9C C9               RET
 280+ EF9D              .rosBankRoom:
 281+ EF9D                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ EF9D                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ EF9D 3E 08            LD A, BCS_BANK_ROOM_X
 284+ EF9F 32 B8 82         LD (ObjectiveScreenX), A
 285+ EFA2 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ EFA4 32 B9 82         LD (ObjectiveScreenY), A
 287+ EFA7 C9               RET
 288+ EFA8              .rosTownGateRoom:
 289+ EFA8                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ EFA8                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ EFA8                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ EFA8 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ EFAA 32 B8 82         LD (ObjectiveScreenX), A
 294+ EFAD 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ EFAF 32 B9 82         LD (ObjectiveScreenY), A
 296+ EFB2 C9               RET
 297+ EFB3              .rosNoTarget:
 298+ EFB3 3E FF            LD A, $FF
 299+ EFB5 32 B8 82         LD (ObjectiveScreenX), A
 300+ EFB8 32 B9 82         LD (ObjectiveScreenY), A
 301+ EFBB C9               RET
 302+ EFBC
 303+ EFBC              ; ==============================================================================
 304+ EFBC              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ EFBC              ; ==============================================================================
 306+ EFBC              ; IN:  A = key id (1..6)
 307+ EFBC              ; OUT: DE = ptr
 308+ EFBC              ; Destruye: AF, HL.
 309+ EFBC              ; ==============================================================================
 310+ EFBC              KeyIdToPtr:
 311+ EFBC 3D               DEC A
 312+ EFBD 87               ADD A, A                            ; *2 (DEFW size)
 313+ EFBE 6F               LD L, A
 314+ EFBF 26 00            LD H, 0
 315+ EFC1 11 4C D7         LD DE, KeyLockTable
 316+ EFC4 19               ADD HL, DE
 317+ EFC5 5E               LD E, (HL)
 318+ EFC6 23               INC HL
 319+ EFC7 56               LD D, (HL)
 320+ EFC8 C9               RET
 321+ EFC9
 322+ EFC9              ; ==============================================================================
 323+ EFC9              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ EFC9              ; ==============================================================================
 325+ EFC9              ; IN:  A = action id (1, 2, ...)
 326+ EFC9              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ EFC9              ;      Z flag set si no encontrado.
 328+ EFC9              ; Destruye: AF, BC, HL.
 329+ EFC9              ; ==============================================================================
 330+ EFC9              ActionToTriggerPtr:
 331+ EFC9 4F               LD C, A                             ; C = action id buscada
 332+ EFCA 21 E4 D7         LD HL, BumpTriggerTable
 333+ EFCD              .attLoop:
 334+ EFCD 5E               LD E, (HL)
 335+ EFCE 23               INC HL
 336+ EFCF 56               LD D, (HL)
 337+ EFD0 23               INC HL                              ; HL -> required_key
 338+ EFD1 7A               LD A, D
 339+ EFD2 B3               OR E
 340+ EFD3 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ EFD5 23               INC HL                              ; HL -> action
 342+ EFD6 7E               LD A, (HL)
 343+ EFD7 23               INC HL                              ; HL -> next entry
 344+ EFD8 B9               CP C
 345+ EFD9 20 F2            JR NZ, .attLoop
 346+ EFDB F6 01            OR 1                                ; clear Z (encontrado)
 347+ EFDD C9               RET
 348+ EFDE              .attNotFound:
 349+ EFDE 16 00            LD D, 0
 350+ EFE0 1E 00            LD E, 0
 351+ EFE2 AF               XOR A                               ; set Z
 352+ EFE3 C9               RET
 353+ EFE4
 354+ EFE4              ; ==============================================================================
 355+ EFE4              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ EFE4              ; ==============================================================================
 357+ EFE4              ; PickupTable layout (per-entry, 7 bytes):
 358+ EFE4              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ EFE4              ; Terminator: $FF (single byte).
 360+ EFE4              ;
 361+ EFE4              ; IN:  DE = ptr a buscar
 362+ EFE4              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ EFE4              ;      B = C = $FF si no encontrado (Z).
 364+ EFE4              ; Destruye: AF, HL. Preserva DE.
 365+ EFE4              ; ==============================================================================
 366+ EFE4              FindPickupScreen:
 367+ EFE4 21 23 DF         LD HL, PickupTable
 368+ EFE7              .fpsLoop:
 369+ EFE7 7E               LD A, (HL)
 370+ EFE8 FE FF            CP $FF
 371+ EFEA 28 1C            JR Z, .fpsNotFound
 372+ EFEC E5               PUSH HL
 373+ EFED 23               INC HL                              ; -> mapY
 374+ EFEE 23               INC HL                              ; -> ptr_lo
 375+ EFEF 7E               LD A, (HL)
 376+ EFF0 BB               CP E
 377+ EFF1 20 0C            JR NZ, .fpsNoMatch
 378+ EFF3 23               INC HL                              ; -> ptr_hi
 379+ EFF4 7E               LD A, (HL)
 380+ EFF5 BA               CP D
 381+ EFF6 20 07            JR NZ, .fpsNoMatch
 382+ EFF8 E1               POP HL                              ; back to entry start (mapX)
 383+ EFF9 46               LD B, (HL)                          ; B = mapX
 384+ EFFA 23               INC HL
 385+ EFFB 4E               LD C, (HL)                          ; C = mapY
 386+ EFFC F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ EFFE C9               RET
 388+ EFFF              .fpsNoMatch:
 389+ EFFF E1               POP HL
 390+ F000 C5               PUSH BC
 391+ F001 01 07 00         LD BC, 7
 392+ F004 09               ADD HL, BC
 393+ F005 C1               POP BC
 394+ F006 18 DF            JR .fpsLoop
 395+ F008              .fpsNotFound:
 396+ F008 06 FF            LD B, $FF
 397+ F00A 0E FF            LD C, $FF
 398+ F00C AF               XOR A                               ; set Z
 399+ F00D C9               RET
 400+ F00E
 401+ F00E              ; ==============================================================================
 402+ F00E              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F00E              ; ==============================================================================
 404+ F00E              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F00E              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F00E              ; third). El brujula se redibuja solo cuando:
 407+ F00E              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F00E              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F00E              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F00E              ;
 411+ F00E              ; Color (atributo de las 4 celdas):
 412+ F00E              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F00E              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F00E              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F00E              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F00E              ;
 417+ F00E              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F00E              ; ==============================================================================
 419+ F00E
 420+ F00E              COMPASS_COL     EQU 24
 421+ F00E              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F00E
 423+ F00E              ; ==============================================================================
 424+ F00E              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F00E              ; ==============================================================================
 426+ F00E              ; Formato:
 427+ F00E              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F00E              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F00E              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F00E              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F00E              ; ==============================================================================
 432+ F00E              DrawMilestoneHUD:
 433+ F00E 3A B7 82         LD A, (CurrentObjective)
 434+ F011 FE 0B            CP 11
 435+ F013 28 26            JR Z, .mhAllDone
 436+ F015 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F016 06 00            LD B, 0                     ; B = decenas
 438+ F018              .mhDivLoop:
 439+ F018 FE 0A            CP 10
 440+ F01A 38 05            JR C, .mhDivDone
 441+ F01C D6 0A            SUB 10
 442+ F01E 04               INC B
 443+ F01F 18 F7            JR .mhDivLoop
 444+ F021              .mhDivDone:
 445+ F021 F5               PUSH AF                     ; A = unidades
 446+ F022 78               LD A, B
 447+ F023 B7               OR A
 448+ F024 20 04            JR NZ, .mhTensDigit
 449+ F026 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F028 18 02            JR .mhWriteTens
 451+ F02A              .mhTensDigit:
 452+ F02A C6 30            ADD A, '0'
 453+ F02C              .mhWriteTens:
 454+ F02C 1E 1E            LD E, 30
 455+ F02E CD 14 E6         CALL DrawHudCharRow0
 456+ F031 F1               POP AF                      ; A = unidades
 457+ F032 C6 30            ADD A, '0'
 458+ F034 1E 1F            LD E, 31
 459+ F036 CD 14 E6         CALL DrawHudCharRow0
 460+ F039 18 0E            JR .mhAttrs
 461+ F03B              .mhAllDone:
 462+ F03B 3E 4F            LD A, 'O'
 463+ F03D 1E 1E            LD E, 30
 464+ F03F CD 14 E6         CALL DrawHudCharRow0
 465+ F042 3E 4B            LD A, 'K'
 466+ F044 1E 1F            LD E, 31
 467+ F046 CD 14 E6         CALL DrawHudCharRow0
 468+ F049              .mhAttrs:
 469+ F049 3E 47            LD A, $47                   ; bright white
 470+ F04B 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F04E 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F051 C9               RET
 473+ F052
 474+ F052              ; ==============================================================================
 475+ F052              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 476+ F052              ; ==============================================================================
 477+ F052              DrawCompass:
 478+ F052                  ; Sin objetivo resuelto -> limpiar y salir
 479+ F052 3A B8 82         LD A, (ObjectiveScreenX)
 480+ F055 FE FF            CP $FF
 481+ F057 CA F9 F1         JP Z, ClearCompass
 482+ F05A
 483+ F05A                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F05A                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F05A                  ; reflejar la dir del path al cambiar de sala).
 486+ F05A 3A 08 83         LD A, (CurrentScreenX)
 487+ F05D 47               LD B, A
 488+ F05E 3A BB 82         LD A, (LastCompassScreenX)
 489+ F061 B8               CP B
 490+ F062 C2 88 F0         JP NZ, .dcRedrawNewScreen
 491+ F065 3A 09 83         LD A, (CurrentScreenY)
 492+ F068 47               LD B, A
 493+ F069 3A BC 82         LD A, (LastCompassScreenY)
 494+ F06C B8               CP B
 495+ F06D C2 88 F0         JP NZ, .dcRedrawNewScreen
 496+ F070 3A BA 82         LD A, (PreviousObjectiveDistance)
 497+ F073 FE FF            CP $FF
 498+ F075 28 16            JR Z, .dcRedraw
 499+ F077 3A BD 82         LD A, (CompassWobbleCounter)
 500+ F07A B7               OR A
 501+ F07B 20 10            JR NZ, .dcRedraw
 502+ F07D                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 503+ F07D                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 504+ F07D 3A BF 5F         LD A, (MagicCompassTimer)
 505+ F080 47               LD B, A
 506+ F081 3A C0 5F         LD A, (MagicCompassTimer + 1)
 507+ F084 B0               OR B
 508+ F085 C8               RET Z                               ; sin cambios + sin wobble + sin magic
 509+ F086 18 05            JR .dcRedraw
 510+ F088
 511+ F088              .dcRedrawNewScreen:
 512+ F088                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 513+ F088                  ; sincronicamente en CheckScreenTransition.doTransition (via
 514+ F088                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 515+ F088                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 516+ F088                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 517+ F088                  ;
 518+ F088                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 519+ F088                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 520+ F088                  ; hay que volver a dibujar el sprite minimo una vez.
 521+ F088 3E FF            LD A, $FF
 522+ F08A 32 CB 5F         LD (LastMagicCompassDrawn), A
 523+ F08D                  ; fall through a .dcRedraw
 524+ F08D
 525+ F08D              .dcRedraw:
 526+ F08D                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F08D 3A B8 82         LD A, (ObjectiveScreenX)
 528+ F090 47               LD B, A
 529+ F091 3A 08 83         LD A, (CurrentScreenX)
 530+ F094 4F               LD C, A
 531+ F095 78               LD A, B
 532+ F096 91               SUB C                               ; A = dx (signed)
 533+ F097                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F097 F2 A1 F0         JP P, .dcDxNonNeg
 535+ F09A ED 44            NEG
 536+ F09C 67               LD H, A                             ; abs(dx)
 537+ F09D 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F09F 18 0A            JR .dcDxDone
 539+ F0A1              .dcDxNonNeg:
 540+ F0A1 67               LD H, A
 541+ F0A2 B7               OR A
 542+ F0A3 20 04            JR NZ, .dcDxPositive
 543+ F0A5 2E 01            LD L, 1                             ; dx == 0
 544+ F0A7 18 02            JR .dcDxDone
 545+ F0A9              .dcDxPositive:
 546+ F0A9 2E 02            LD L, 2
 547+ F0AB              .dcDxDone:
 548+ F0AB E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F0AC
 550+ F0AC                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F0AC 3A B9 82         LD A, (ObjectiveScreenY)
 552+ F0AF 47               LD B, A
 553+ F0B0 3A 09 83         LD A, (CurrentScreenY)
 554+ F0B3 4F               LD C, A
 555+ F0B4 78               LD A, B
 556+ F0B5 91               SUB C
 557+ F0B6 F2 C0 F0         JP P, .dcDyNonNeg
 558+ F0B9 ED 44            NEG
 559+ F0BB 67               LD H, A
 560+ F0BC 2E 00            LD L, 0
 561+ F0BE 18 0A            JR .dcDyDone
 562+ F0C0              .dcDyNonNeg:
 563+ F0C0 67               LD H, A
 564+ F0C1 B7               OR A
 565+ F0C2 20 04            JR NZ, .dcDyPositive
 566+ F0C4 2E 01            LD L, 1
 567+ F0C6 18 02            JR .dcDyDone
 568+ F0C8              .dcDyPositive:
 569+ F0C8 2E 02            LD L, 2
 570+ F0CA              .dcDyDone:
 571+ F0CA                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 572+ F0CA D1               POP DE                              ; D = abs_dx, E = signdx+1
 573+ F0CB                  ; idx = (signdy+1)*3 + (signdx+1)
 574+ F0CB 7D               LD A, L
 575+ F0CC 87               ADD A, A
 576+ F0CD 85               ADD A, L                            ; A = (signdy+1)*3
 577+ F0CE 83               ADD A, E                            ; A = idx (0..8)
 578+ F0CF 32 C6 F1         LD (.dcSpriteIdx), A
 579+ F0D2                  ; distance = abs_dx + abs_dy
 580+ F0D2 7A               LD A, D
 581+ F0D3 84               ADD A, H
 582+ F0D4 32 C7 F1         LD (.dcDistance), A
 583+ F0D7
 584+ F0D7                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F0D7                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F0D7                  ; Sprite_Compass_Magic (no oscila); el wobble logic solo gastaría CPU
 587+ F0D7                  ; durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F0D7                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F0D7                  ; cuando el frame de transición está apretado.
 590+ F0D7 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F0DA 47               LD B, A
 592+ F0DB 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F0DE B0               OR B
 594+ F0DF 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F0E1 AF               XOR A
 596+ F0E2 32 BD 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F0E5 18 53            JR .dcWobbleEnd
 598+ F0E7              .dcWobbleStartNormal:
 599+ F0E7                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F0E7                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F0E7                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F0E7                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F0E7                  ; nuevo idx.
 604+ F0E7                  ; Counter == 0 -> sin override, idx = target.
 605+ F0E7 3A C6 F1         LD A, (.dcSpriteIdx)
 606+ F0EA FE 04            CP 4
 607+ F0EC 20 06            JR NZ, .dcWobbleNotX
 608+ F0EE                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F0EE                  ; frame no redibuje innecesariamente.
 610+ F0EE AF               XOR A
 611+ F0EF 32 BD 82         LD (CompassWobbleCounter), A
 612+ F0F2 18 46            JR .dcWobbleEnd
 613+ F0F4              .dcWobbleNotX:
 614+ F0F4                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F0F4 3A 08 83         LD A, (CurrentScreenX)
 616+ F0F7 47               LD B, A
 617+ F0F8 3A BB 82         LD A, (LastCompassScreenX)
 618+ F0FB B8               CP B
 619+ F0FC 20 0A            JR NZ, .dcWobbleStart
 620+ F0FE 3A 09 83         LD A, (CurrentScreenY)
 621+ F101 47               LD B, A
 622+ F102 3A BC 82         LD A, (LastCompassScreenY)
 623+ F105 B8               CP B
 624+ F106 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F108              .dcWobbleStart:
 626+ F108 3E 09            LD A, 9
 627+ F10A 32 BD 82         LD (CompassWobbleCounter), A
 628+ F10D              .dcWobbleResolve:
 629+ F10D 3A BD 82         LD A, (CompassWobbleCounter)
 630+ F110 B7               OR A
 631+ F111 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F113 3D               DEC A
 633+ F114 32 BD 82         LD (CompassWobbleCounter), A
 634+ F117                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F117 21 27 F6         LD HL, WobblePhaseTable
 636+ F11A 5F               LD E, A
 637+ F11B 16 00            LD D, 0
 638+ F11D 19               ADD HL, DE
 639+ F11E 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 640+ F11F FE 02            CP 2
 641+ F121 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 642+ F123                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 643+ F123                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 644+ F123 FE 03            CP 3
 645+ F125 38 01            JR C, .dcWobbleOffsetReady
 646+ F127 3D               DEC A
 647+ F128              .dcWobbleOffsetReady:
 648+ F128 5F               LD E, A
 649+ F129 3A C6 F1         LD A, (.dcSpriteIdx)
 650+ F12C 87               ADD A, A                            ; idx*2
 651+ F12D 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 652+ F12E 83               ADD A, E                            ; +offset
 653+ F12F 21 03 F6         LD HL, CompassWobbleTable
 654+ F132 5F               LD E, A
 655+ F133 16 00            LD D, 0
 656+ F135 19               ADD HL, DE
 657+ F136 7E               LD A, (HL)
 658+ F137 32 C6 F1         LD (.dcSpriteIdx), A                ; override
 659+ F13A
 660+ F13A              .dcWobbleEnd:
 661+ F13A
 662+ F13A                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F13A                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F13A                  ; sin bright + char activo white bright; en warning el char activo
 665+ F13A                  ; parpadea bright on/off a ~6 Hz).
 666+ F13A                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F13A                  ; blanca se mantiene tal cual.
 668+ F13A 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F13D 47               LD B, A
 670+ F13E 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F141 B0               OR B
 672+ F142 28 29            JR Z, .dcMagicOff
 673+ F144 3A C6 F1         LD A, (.dcSpriteIdx)
 674+ F147 FE 04            CP 4
 675+ F149 28 22            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F14B 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F14E FE FF            CP $FF
 678+ F150 28 1B            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F152                  ; --- MAGIC HUD ---
 680+ F152                  ; Cache: el sprite Sprite_Compass_Magic es siempre el mismo; sólo se
 681+ F152                  ; redibuja cuando cambia PathDir (o no estaba dibujado todavía). El
 682+ F152                  ; resto de frames basta con repintar los 4 attrs (ultra-barato), lo que
 683+ F152                  ; libera CPU durante el wobble post-transición y evita que las agujas
 684+ F152                  ; del reloj queden parcialmente actualizadas en frames con poco margen.
 685+ F152 3A C1 5F         LD A, (MagicCompassPathDir)
 686+ F155 47               LD B, A
 687+ F156 3A CB 5F         LD A, (LastMagicCompassDrawn)
 688+ F159 B8               CP B
 689+ F15A 28 0C            JR Z, .dcMagicAttrsOnly             ; mismo path → solo attrs
 690+ F15C 11 9D 79         LD DE, Sprite_Compass_Magic
 691+ F15F CD C9 F1         CALL DrawCompassSprite
 692+ F162 3A C1 5F         LD A, (MagicCompassPathDir)
 693+ F165 32 CB 5F         LD (LastMagicCompassDrawn), A
 694+ F168              .dcMagicAttrsOnly:
 695+ F168 CD 91 76         CALL PaintMagicCompassAttrs
 696+ F16B 18 40            JR .dcDrawDone
 697+ F16D
 698+ F16D              .dcMagicOff:
 699+ F16D                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 700+ F16D                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 701+ F16D 3E FF            LD A, $FF
 702+ F16F 32 CB 5F         LD (LastMagicCompassDrawn), A
 703+ F172
 704+ F172                  ; --- Color normal ---
 705+ F172                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 706+ F172 3A C6 F1         LD A, (.dcSpriteIdx)
 707+ F175 FE 04            CP 4
 708+ F177 28 18            JR Z, .dcWhite
 709+ F179 3A BA 82         LD A, (PreviousObjectiveDistance)
 710+ F17C FE FF            CP $FF
 711+ F17E 28 11            JR Z, .dcWhite
 712+ F180 47               LD B, A
 713+ F181 3A C7 F1         LD A, (.dcDistance)
 714+ F184 B8               CP B
 715+ F185 28 0A            JR Z, .dcWhite                      ; igual = blanco
 716+ F187 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 717+ F189 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 718+ F18B 18 06            JR .dcColorDone
 719+ F18D              .dcGreen:
 720+ F18D 3E 44            LD A, GREEN | $40
 721+ F18F 18 02            JR .dcColorDone
 722+ F191              .dcWhite:
 723+ F191 3E 47            LD A, WHITE | $40
 724+ F193              .dcColorDone:
 725+ F193 32 C8 F1         LD (.dcAttr), A
 726+ F196
 727+ F196                  ; --- Sprite ptr de CompassSprites[idx] ---
 728+ F196 3A C6 F1         LD A, (.dcSpriteIdx)
 729+ F199 87               ADD A, A                            ; *2
 730+ F19A 6F               LD L, A
 731+ F19B 26 00            LD H, 0
 732+ F19D 11 F1 F5         LD DE, CompassSprites
 733+ F1A0 19               ADD HL, DE
 734+ F1A1 5E               LD E, (HL)
 735+ F1A2 23               INC HL
 736+ F1A3 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 737+ F1A4 CD C9 F1         CALL DrawCompassSprite
 738+ F1A7
 739+ F1A7                  ; --- Attrs ---
 740+ F1A7 3A C8 F1         LD A, (.dcAttr)
 741+ F1AA CD EC F1         CALL SetCompassAttrs
 742+ F1AD
 743+ F1AD              .dcDrawDone:
 744+ F1AD
 745+ F1AD                  ; --- Cachear estado ---
 746+ F1AD                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 747+ F1AD                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 748+ F1AD                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 749+ F1AD                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 750+ F1AD                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 751+ F1AD                  ; el wobble y la comparacion sigue siendo correcta.
 752+ F1AD 3A BD 82         LD A, (CompassWobbleCounter)
 753+ F1B0 B7               OR A
 754+ F1B1 20 06            JR NZ, .dcSkipPrevDistSave
 755+ F1B3 3A C7 F1         LD A, (.dcDistance)
 756+ F1B6 32 BA 82         LD (PreviousObjectiveDistance), A
 757+ F1B9              .dcSkipPrevDistSave:
 758+ F1B9 3A 08 83         LD A, (CurrentScreenX)
 759+ F1BC 32 BB 82         LD (LastCompassScreenX), A
 760+ F1BF 3A 09 83         LD A, (CurrentScreenY)
 761+ F1C2 32 BC 82         LD (LastCompassScreenY), A
 762+ F1C5 C9               RET
 763+ F1C6
 764+ F1C6 00           .dcSpriteIdx: DEFB 0
 765+ F1C7 00           .dcDistance:  DEFB 0
 766+ F1C8 00           .dcAttr:      DEFB 0
 767+ F1C9
 768+ F1C9              ; ==============================================================================
 769+ F1C9              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 770+ F1C9              ; ==============================================================================
 771+ F1C9              ; IN: DE = ptr a 16 filas x 2 bytes
 772+ F1C9              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 773+ F1C9              ; Destruye: AF, B, HL.
 774+ F1C9              ; ==============================================================================
 775+ F1C9              DrawCompassSprite:
 776+ F1C9                  ; Char row 0 (rows 0-7 del sprite)
 777+ F1C9 26 40            LD H, $40
 778+ F1CB 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 779+ F1CD 06 08            LD B, 8
 780+ F1CF              .dcsRow0:
 781+ F1CF 1A               LD A, (DE)
 782+ F1D0 77               LD (HL), A
 783+ F1D1 13               INC DE
 784+ F1D2 23               INC HL
 785+ F1D3 1A               LD A, (DE)
 786+ F1D4 77               LD (HL), A
 787+ F1D5 13               INC DE
 788+ F1D6 2B               DEC HL
 789+ F1D7 24               INC H
 790+ F1D8 10 F5            DJNZ .dcsRow0
 791+ F1DA                  ; Char row 1 (rows 8-15 del sprite)
 792+ F1DA 26 40            LD H, $40
 793+ F1DC 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 794+ F1DE 06 08            LD B, 8
 795+ F1E0              .dcsRow1:
 796+ F1E0 1A               LD A, (DE)
 797+ F1E1 77               LD (HL), A
 798+ F1E2 13               INC DE
 799+ F1E3 23               INC HL
 800+ F1E4 1A               LD A, (DE)
 801+ F1E5 77               LD (HL), A
 802+ F1E6 13               INC DE
 803+ F1E7 2B               DEC HL
 804+ F1E8 24               INC H
 805+ F1E9 10 F5            DJNZ .dcsRow1
 806+ F1EB C9               RET
 807+ F1EC
 808+ F1EC              ; ==============================================================================
 809+ F1EC              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 810+ F1EC              ; ==============================================================================
 811+ F1EC              SetCompassAttrs:
 812+ F1EC 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 813+ F1EF 77               LD (HL), A
 814+ F1F0 23               INC HL
 815+ F1F1 77               LD (HL), A
 816+ F1F2 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F1F5 77               LD (HL), A
 818+ F1F6 23               INC HL
 819+ F1F7 77               LD (HL), A
 820+ F1F8 C9               RET
