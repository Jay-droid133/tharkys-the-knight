 117  6CC2
 118  6CC2                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 119  6CC2                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 120  6CC2                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6CC2              ; ==============================================================================
   2+ 6CC2              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6CC2              ; ==============================================================================
   4+ 6CC2              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6CC2              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6CC2              ;
   7+ 6CC2              ; Diseño beeper-style:
   8+ 6CC2              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6CC2              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6CC2              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6CC2              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6CC2              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6CC2              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6CC2              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6CC2              ;     hits clasicos en 48K).
  16+ 6CC2              ;   - AY_UpdatePlayerHit se llama cada frame desde MainLoop (cold path: salta
  17+ 6CC2              ;     en RET Z si no hay sweep activo).
  18+ 6CC2              ;
  19+ 6CC2              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  20+ 6CC2              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  21+ 6CC2              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  22+ 6CC2              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  23+ 6CC2              ;
  24+ 6CC2              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  25+ 6CC2              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  26+ 6CC2              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  27+ 6CC2              ;
  28+ 6CC2              ; Llamado desde:
  29+ 6CC2              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  30+ 6CC2              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  31+ 6CC2              ;   - MainLoop cada frame — update.
  32+ 6CC2              ; ==============================================================================
  33+ 6CC2
  34+ 6CC2              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  35+ 6CC2 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  36+ 6CC3 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  37+ 6CC5 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  38+ 6CC7 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  39+ 6CC8                                                ; (0 = inactivo o ya muteado)
  40+ 6CC8
  41+ 6CC8              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  42+ 6CC8              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  43+ 6CC8              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  44+ 6CC8              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  45+ 6CC8
  46+ 6CC8              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  47+ 6CC8              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  48+ 6CC8              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  49+ 6CC8              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  50+ 6CC8
  51+ 6CC8              ; ==============================================================================
  52+ 6CC8              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  53+ 6CC8              ; ==============================================================================
  54+ 6CC8              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  55+ 6CC8              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  56+ 6CC8              ; tabla los hardcodea.
  57+ 6CC8              ; ==============================================================================
  58+ 6CC8              AY_PlayPlayerHit:
  59+ 6CC8 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  60+ 6CCB 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  61+ 6CCD 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  62+ 6CD0 18 08            JR _AY_PlaySweep
  63+ 6CD2
  64+ 6CD2              AY_PlayPlayerDeath:
  65+ 6CD2 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  66+ 6CD5 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  67+ 6CD7 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  68+ 6CDA                  ; fall through
  69+ 6CDA
  70+ 6CDA              ; IN: HL=period inicial, B=frames, DE=delta.
  71+ 6CDA              _AY_PlaySweep:
  72+ 6CDA 22 C3 6C         LD (PlayerHitPeriod), HL
  73+ 6CDD ED 53 C5 6C      LD (PlayerHitDelta), DE
  74+ 6CE1 78               LD A, B
  75+ 6CE2 32 C2 6C         LD (PlayerHitFrames), A
  76+ 6CE5 F3               DI
  77+ 6CE6 0E FD            LD C, $FD
  78+ 6CE8 21 EE 6C         LD HL, .phRegs
  79+ 6CEB C3 1F 6D         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  80+ 6CEE
  81+ 6CEE              .phRegs:
  82+ 6CEE 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  83+ 6CF0 03 00            DEFB  3, $00          ; R3  = period B hi
  84+ 6CF2 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  85+ 6CF4 07 3D            DEFB  7, $3D          ; R7  = mixer (tono B on, A/C off, noise off)
  86+ 6CF6 FF               DEFB $FF              ; sentinel
  87+ 6CF7
  88+ 6CF7              ; ==============================================================================
  89+ 6CF7              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  90+ 6CF7              ; ==============================================================================
  91+ 6CF7              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  92+ 6CF7              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  93+ 6CF7              ; Canal B (center stereo ABC). No bloqueante.
  94+ 6CF7              ;
  95+ 6CF7              ; IN: HL = period AY canal B (mayor = mas grave).
  96+ 6CF7              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
  97+ 6CF7              ;
  98+ 6CF7              ; Sugerencias:
  99+ 6CF7              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 100+ 6CF7              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 101+ 6CF7              ; Destruye: A, BC, HL.
 102+ 6CF7              ; ==============================================================================
 103+ 6CF7              AY_PlayBeep:
 104+ 6CF7 78               LD A, B
 105+ 6CF8 32 C7 6C         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 106+ 6CFB F3               DI
 107+ 6CFC 0E FD            LD C, $FD
 108+ 6CFE                  ; R2 = L (period B lo)
 109+ 6CFE 3E 02            LD A, 2
 110+ 6D00 06 FF            LD B, $FF
 111+ 6D02 ED 79            OUT (C), A
 112+ 6D04 7D               LD A, L
 113+ 6D05 06 BF            LD B, $BF
 114+ 6D07 ED 79            OUT (C), A
 115+ 6D09                  ; R3 = H (period B hi)
 116+ 6D09 3E 03            LD A, 3
 117+ 6D0B 06 FF            LD B, $FF
 118+ 6D0D ED 79            OUT (C), A
 119+ 6D0F 7C               LD A, H
 120+ 6D10 06 BF            LD B, $BF
 121+ 6D12 ED 79            OUT (C), A
 122+ 6D14                  ; R9 = $0F (vol max fija, SIN envelope), R7 = mixer (B tono only)
 123+ 6D14 21 1A 6D         LD HL, .beepRegs
 124+ 6D17 C3 1F 6D         JP _AY_WriteRegPairs                ; tail call: EI + RET
 125+ 6D1A
 126+ 6D1A              .beepRegs:
 127+ 6D1A 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 128+ 6D1C 07 3D            DEFB  7, $3D          ; mixer (B tono on, A/C off, noise off)
 129+ 6D1E FF               DEFB $FF              ; sentinel
 130+ 6D1F
 131+ 6D1F              ; ==============================================================================
 132+ 6D1F              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 133+ 6D1F              ; ==============================================================================
 134+ 6D1F              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 135+ 6D1F              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 136+ 6D1F              ; ==============================================================================
 137+ 6D1F              _AY_WriteRegPairs:
 138+ 6D1F 7E               LD A, (HL)
 139+ 6D20 FE FF            CP $FF
 140+ 6D22 28 0D            JR Z, .awrpDone
 141+ 6D24 06 FF            LD B, $FF
 142+ 6D26 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 143+ 6D28 23               INC HL
 144+ 6D29 06 BF            LD B, $BF
 145+ 6D2B 7E               LD A, (HL)
 146+ 6D2C ED 79            OUT (C), A                          ; AY data ($BFFD)
 147+ 6D2E 23               INC HL
 148+ 6D2F 18 EE            JR _AY_WriteRegPairs
 149+ 6D31              .awrpDone:
 150+ 6D31 FB               EI
 151+ 6D32 C9               RET
 152+ 6D33
 153+ 6D33              ; ==============================================================================
 154+ 6D33              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave
 155+ 6D33              ; ==============================================================================
 156+ 6D33              ; Llamar cada frame desde MainLoop. No-op si sweep inactivo (frames=0).
 157+ 6D33              ; Destruye: A, BC, DE, HL.
 158+ 6D33              ; ==============================================================================
 159+ 6D33              AY_UpdatePlayerHit:
 160+ 6D33 3A C2 6C         LD A, (PlayerHitFrames)
 161+ 6D36 B7               OR A
 162+ 6D37 28 2C            JR Z, .uphCheckBeep
 163+ 6D39 3D               DEC A
 164+ 6D3A 32 C2 6C         LD (PlayerHitFrames), A
 165+ 6D3D 28 30            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 166+ 6D3F
 167+ 6D3F 2A C3 6C         LD HL, (PlayerHitPeriod)
 168+ 6D42 ED 5B C5 6C      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 169+ 6D46 19               ADD HL, DE
 170+ 6D47 22 C3 6C         LD (PlayerHitPeriod), HL
 171+ 6D4A
 172+ 6D4A                  ; Escribir R2 = L, R3 = H (period B)
 173+ 6D4A F3               DI
 174+ 6D4B 0E FD            LD C, $FD
 175+ 6D4D 3E 02            LD A, 2
 176+ 6D4F 06 FF            LD B, $FF
 177+ 6D51 ED 79            OUT (C), A
 178+ 6D53 7D               LD A, L
 179+ 6D54 06 BF            LD B, $BF
 180+ 6D56 ED 79            OUT (C), A
 181+ 6D58 3E 03            LD A, 3
 182+ 6D5A 06 FF            LD B, $FF
 183+ 6D5C ED 79            OUT (C), A
 184+ 6D5E 7C               LD A, H
 185+ 6D5F 06 BF            LD B, $BF
 186+ 6D61 ED 79            OUT (C), A
 187+ 6D63 FB               EI
 188+ 6D64 C9               RET
 189+ 6D65
 190+ 6D65              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 191+ 6D65              .uphCheckBeep:
 192+ 6D65 3A C7 6C         LD A, (BeepDurationFrames)
 193+ 6D68 B7               OR A
 194+ 6D69 C8               RET Z
 195+ 6D6A 3D               DEC A
 196+ 6D6B 32 C7 6C         LD (BeepDurationFrames), A
 197+ 6D6E C0               RET NZ
 198+ 6D6F                  ; fall-through al cutoff compartido
 199+ 6D6F
 200+ 6D6F              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Beeper-style. ---
 201+ 6D6F              ; Llamado al final del sweep (PlayerHit/Death) y al final del beep.
 202+ 6D6F              _uphMuteR9:
 203+ 6D6F F3               DI
 204+ 6D70 01 FD FF         LD BC, $FFFD
 205+ 6D73 3E 09            LD A, 9
 206+ 6D75 ED 79            OUT (C), A
 207+ 6D77 01 FD BF         LD BC, $BFFD
 208+ 6D7A AF               XOR A
 209+ 6D7B ED 79            OUT (C), A
 210+ 6D7D FB               EI
 211+ 6D7E C9               RET
 212+ 6D7F
