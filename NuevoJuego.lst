7235+ CBB6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7236+ CBBA              .bfsAppMove:
7237+ CBBA                  ; Intentar 1 paso con collision check
7238+ CBBA DD 7E 03         LD A, (IX+ENT_POSX)
7239+ CBBD 32 E9 CB         LD (.bfsSvX), A
7240+ CBC0 DD 7E 04         LD A, (IX+ENT_POSY)
7241+ CBC3 32 EA CB         LD (.bfsSvY), A
7242+ CBC6 DD 7E 03         LD A, (IX+ENT_POSX)
7243+ CBC9 DD 86 06         ADD A, (IX+ENT_DELTAX)
7244+ CBCC DD 77 03         LD (IX+ENT_POSX), A
7245+ CBCF DD 7E 04         LD A, (IX+ENT_POSY)
