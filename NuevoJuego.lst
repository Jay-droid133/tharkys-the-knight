1214+ A8CE DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1215+ A8D2                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1216+ A8D2 DD 7E 0A         LD A, (IX+ENT_DIR)
1217+ A8D5 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1218+ A8D7 DD 77 0A         LD (IX+ENT_DIR), A
1219+ A8DA                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1220+ A8DA AF               XOR A
1221+ A8DB 32 68 B6         LD (AttackDebounce), A
1222+ A8DE C9               RET
1223+ A8DF
1224+ A8DF              .notIdle:
1225+ A8DF                  ; Guardar direccion actual en bits 0-3
1226+ A8DF DD 7E 0A         LD A, (IX+ENT_DIR)
1227+ A8E2 E6 F0            AND $F0                     ; Mantener lastHDir
1228+ A8E4 B0               OR B                        ; Añadir dir actual
1229+ A8E5 DD 77 0A         LD (IX+ENT_DIR), A
1230+ A8E8
1231+ A8E8                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1232+ A8E8 3A 66 B6         LD A, (AttackTimer)
1233+ A8EB B7               OR A
1234+ A8EC 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1235+ A8EE 78               LD A, B
1236+ A8EF E6 0C            AND DIR_E | DIR_W
1237+ A8F1 28 0E            JR Z, .noHorizUpdate
1238+ A8F3                  ; Guardar en bits 4-7
1239+ A8F3 07               RLCA
1240+ A8F4 07               RLCA
1241+ A8F5 07               RLCA
1242+ A8F6 07               RLCA                        ; Shift a bits 4-7
1243+ A8F7 4F               LD C, A                     ; C = lastHDir en bits 4-7
1244+ A8F8 DD 7E 0A         LD A, (IX+ENT_DIR)
1245+ A8FB E6 0F            AND $0F                     ; Mantener dir actual
1246+ A8FD B1               OR C                        ; Añadir lastHDir
1247+ A8FE DD 77 0A         LD (IX+ENT_DIR), A
