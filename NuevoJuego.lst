 730+ F402 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 731+ F404 06 08            LD B, 8
 732+ F406 AF               XOR A
 733+ F407              .ccRow0:
 734+ F407 77               LD (HL), A
 735+ F408 23               INC HL
 736+ F409 77               LD (HL), A
