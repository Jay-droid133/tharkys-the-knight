 149+ DA5D              ; ==============================================================================
 150+ DA5D              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 151+ DA5D              ; ==============================================================================
 152+ DA5D              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 153+ DA5D              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 154+ DA5D              ; pareja de bytes — vertical doubling).
 155+ DA5D              ;
 156+ DA5D              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 157+ DA5D              ; Destruye: AF, BC, DE, HL.
 158+ DA5D              ; ==============================================================================
 159+ DA5D              DrawTombPixels2x:
 160+ DA5D 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 161+ DA5F 32 DE DA         LD (.dpxRowsLeft), A
 162+ DA62 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
 163+ DA64 32 DF DA         LD (.dpxDstY), A
 164+ DA67 21 2D DB         LD HL, TombDecodedPixels
 165+ DA6A 22 E0 DA         LD (.dpxSrcPtr), HL
 166+ DA6D
 167+ DA6D              .dpxNextRow:
 168+ DA6D                  ; Calc dst top addr at (TOMB_2X_DST_PIXEL_X, dstY)
 169+ DA6D 3A DF DA         LD A, (.dpxDstY)
 170+ DA70 57               LD D, A
 171+ DA71 1E 50            LD E, TOMB_2X_DST_PIXEL_X
 172+ DA73 CD 5A 9D         CALL CalcPixelAddr
 173+ DA76 22 E2 DA         LD (.dpxDstTop), HL
 174+ DA79
 175+ DA79                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 176+ DA79 CD C6 9A         CALL NextPixelLine
 177+ DA7C 22 E4 DA         LD (.dpxDstBot), HL
 178+ DA7F
 179+ DA7F                  ; Procesar 6 src bytes para esta src row
 180+ DA7F 2A E0 DA         LD HL, (.dpxSrcPtr)
 181+ DA82 06 06            LD B, TOMB_SRC_W_BYTES
 182+ DA84              .dpxByteLoop:
 183+ DA84 7E               LD A, (HL)
 184+ DA85 23               INC HL
 185+ DA86 4F               LD C, A                         ; C = src byte original
 186+ DA87 E5               PUSH HL                         ; save src ptr
 187+ DA88 C5               PUSH BC                         ; save count + src byte
