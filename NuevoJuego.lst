 519+ EC99 C9               RET
 520+ EC9A              .lcYellow:
 521+ EC9A 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EC9C C9               RET
 523+ EC9D              .lcCyan:
 524+ EC9D 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EC9F C9               RET
 526+ ECA0              .lcGreen:
 527+ ECA0 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ ECA2 C9               RET
 529+ ECA3
 530+ ECA3              ; ==============================================================================
 531+ ECA3              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ ECA3              ; ==============================================================================
 533+ ECA3              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ ECA3              ; ==============================================================================
 535+ ECA3              DrawHandLine:
 536+ ECA3 87               ADD A, A
 537+ ECA4 4F               LD C, A
 538+ ECA5 06 00            LD B, 0
