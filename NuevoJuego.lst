 771+ F08D 4F               LD C, A                     ; C = colOffset
 772+ F08E
 773+ F08E                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ F08E 7B               LD A, E                     ; A = scanLine
