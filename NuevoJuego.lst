 545+ EF8E              .pixLoop:
 546+ EF8E 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EF8F B7               OR A
 548+ EF90 C8               RET Z
 549+ EF91 57               LD D, A
 550+ EF92 23               INC HL
 551+ EF93 7E               LD A, (HL)          ; VRAM L
 552+ EF94 23               INC HL
 553+ EF95 5F               LD E, A
 554+ EF96 7E               LD A, (HL)          ; mask
 555+ EF97 23               INC HL
 556+ EF98 E5               PUSH HL
 557+ EF99 2F               CPL                 ; ~mask
 558+ EF9A 62               LD H, D
 559+ EF9B 6B               LD L, E
 560+ EF9C A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EF9D 77               LD (HL), A
 562+ EF9E E1               POP HL
 563+ EF9F 18 ED            JR .pixLoop
