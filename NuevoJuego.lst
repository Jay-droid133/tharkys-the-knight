 130+ A18C              ; InitEntities - Inicializa la tabla de entidades
 131+ A18C              ; ==============================================================================
 132+ A18C              ; Limpia todos los slots y configura el slot 0 como player.
 133+ A18C              ; ==============================================================================
 134+ A18C              InitEntities:
 135+ A18C                  ; Limpiar toda la tabla a ceros
 136+ A18C 21 3F 81         LD HL, EntityTable
 137+ A18F 11 40 81         LD DE, EntityTable + 1
 138+ A192 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ A195 AF               XOR A
 140+ A196 77               LD (HL), A
