 137  9E0D                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9E0D              ; ==============================================================================
   2+ 9E0D              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9E0D              ; ==============================================================================
   4+ 9E0D              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9E0D              ; - Game loop per-entity: erase → update → draw
   6+ 9E0D              ; - Movimiento 8-bit (sin subpixel)
   7+ 9E0D              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9E0D              ; - XOR draw/erase (una sola rutina)
   9+ 9E0D              ; ==============================================================================
  10+ 9E0D
  11+ 9E0D              ; ==============================================================================
  12+ 9E0D              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9E0D              ; ==============================================================================
  14+ 9E0D              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9E0D              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9E0D              ; ==============================================================================
  17+ 9E0D              ReadInput:
  18+ 9E0D 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9E0F 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9E11
  21+ 9E11                  ; -- 1. QAOP --
  22+ 9E11 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9E14 ED 78            IN A, (C)
  24+ 9E16 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9E18 20 02            JR NZ, .no_q
  26+ 9E1A CB C2            SET 0, D
  27+ 9E1C              .no_q:
  28+ 9E1C 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9E1F ED 78            IN A, (C)
  30+ 9E21 CB 47            BIT 0, A            ; A = Abajo
  31+ 9E23 20 02            JR NZ, .no_a
  32+ 9E25 CB CA            SET 1, D
  33+ 9E27              .no_a:
  34+ 9E27 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9E2A ED 78            IN A, (C)
  36+ 9E2C CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9E2E 20 02            JR NZ, .no_o
  38+ 9E30 CB DA            SET 3, D
  39+ 9E32              .no_o:
  40+ 9E32 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9E34 20 02            JR NZ, .no_p
  42+ 9E36 CB D2            SET 2, D
  43+ 9E38              .no_p:
  44+ 9E38
  45+ 9E38                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9E38                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9E38 DB 1F            IN A, (31)
  48+ 9E3A 4F               LD C, A             ; guardar para fire
  49+ 9E3B CB 5F            BIT 3, A            ; Up
  50+ 9E3D 28 02            JR Z, .no_k_up
  51+ 9E3F CB C2            SET 0, D
  52+ 9E41              .no_k_up:
  53+ 9E41 CB 57            BIT 2, A            ; Down
  54+ 9E43 28 02            JR Z, .no_k_down
  55+ 9E45 CB CA            SET 1, D
  56+ 9E47              .no_k_down:
  57+ 9E47 CB 4F            BIT 1, A            ; Left
  58+ 9E49 28 02            JR Z, .no_k_left
  59+ 9E4B CB DA            SET 3, D
  60+ 9E4D              .no_k_left:
  61+ 9E4D CB 47            BIT 0, A            ; Right
  62+ 9E4F 28 02            JR Z, .no_k_right
  63+ 9E51 CB D2            SET 2, D
  64+ 9E53              .no_k_right:
  65+ 9E53 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E55 28 02            JR Z, .no_k_fire
  67+ 9E57 CB C3            SET 0, E
  68+ 9E59              .no_k_fire:
  69+ 9E59
  70+ 9E59                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E59                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E59 01 FE F7         LD BC, $F7FE
  73+ 9E5C ED 78            IN A, (C)
  74+ 9E5E CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E60 20 02            JR NZ, .no_s1_up
  76+ 9E62 CB C2            SET 0, D
  77+ 9E64              .no_s1_up:
  78+ 9E64 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E66 20 02            JR NZ, .no_s1_down
  80+ 9E68 CB CA            SET 1, D
  81+ 9E6A              .no_s1_down:
  82+ 9E6A CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E6C 20 02            JR NZ, .no_s1_left
  84+ 9E6E CB DA            SET 3, D
  85+ 9E70              .no_s1_left:
  86+ 9E70 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E72 20 02            JR NZ, .no_s1_right
  88+ 9E74 CB D2            SET 2, D
  89+ 9E76              .no_s1_right:
  90+ 9E76 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E78 20 02            JR NZ, .no_s1_fire
  92+ 9E7A CB C3            SET 0, E
  93+ 9E7C              .no_s1_fire:
  94+ 9E7C
  95+ 9E7C                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E7C 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E7F ED 78            IN A, (C)
  98+ 9E81 CB 47            BIT 0, A            ; SPACE
  99+ 9E83 20 02            JR NZ, .no_space
 100+ 9E85 CB C3            SET 0, E
 101+ 9E87              .no_space:
 102+ 9E87
 103+ 9E87                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E87 7B               LD A, E
 105+ 9E88 32 C1 81         LD (InputFire), A
 106+ 9E8B
 107+ 9E8B                  ; -- 6. Cancelar opuestos --
 108+ 9E8B 7A               LD A, D
 109+ 9E8C 47               LD B, A
 110+ 9E8D E6 03            AND DIR_N | DIR_S
 111+ 9E8F FE 03            CP DIR_N | DIR_S
 112+ 9E91 20 04            JR NZ, .noVC
 113+ 9E93 78               LD A, B
 114+ 9E94 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ 9E96 47               LD B, A
 116+ 9E97              .noVC:
 117+ 9E97 78               LD A, B
 118+ 9E98 E6 0C            AND DIR_E | DIR_W
 119+ 9E9A FE 0C            CP DIR_E | DIR_W
 120+ 9E9C 20 04            JR NZ, .noHC
 121+ 9E9E 78               LD A, B
 122+ 9E9F E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ 9EA1 47               LD B, A
 124+ 9EA2              .noHC:
 125+ 9EA2 78               LD A, B
 126+ 9EA3 32 C0 81         LD (InputDirection), A
 127+ 9EA6 C9               RET
 128+ 9EA7
 129+ 9EA7              ; ==============================================================================
 130+ 9EA7              ; InitEntities - Inicializa la tabla de entidades
 131+ 9EA7              ; ==============================================================================
 132+ 9EA7              ; Limpia todos los slots y configura el slot 0 como player.
 133+ 9EA7              ; ==============================================================================
 134+ 9EA7              InitEntities:
 135+ 9EA7                  ; Limpiar toda la tabla a ceros
 136+ 9EA7 21 B0 80         LD HL, EntityTable
 137+ 9EAA 11 B1 80         LD DE, EntityTable + 1
 138+ 9EAD 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ 9EB0 AF               XOR A
 140+ 9EB1 77               LD (HL), A
 141+ 9EB2 ED B0            LDIR
 142+ 9EB4
 143+ 9EB4                  ; Limpiar tabla de atributos salvados
 144+ 9EB4 21 2A 9C         LD HL, SavedAttrTable
 145+ 9EB7 11 2B 9C         LD DE, SavedAttrTable + 1
 146+ 9EBA 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ 9EBD AF               XOR A
 148+ 9EBE 77               LD (HL), A
 149+ 9EBF ED B0            LDIR
 150+ 9EC1
 151+ 9EC1                  ; Configurar slot 0: Player
 152+ 9EC1 DD 21 B0 80      LD IX, EntityTable
 153+ 9EC5 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ 9EC9 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ 9ECD DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ 9ED1 DD 36 03 58      LD (IX+ENT_POSX), START_PLAYER_X
 157+ 9ED5 DD 36 04 50      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ 9ED9 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ 9EDD DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ 9EE1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ 9EE5 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ 9EE9 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ 9EED DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ 9EF1 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ 9EF5 DD 36 0C 58      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ 9EF9 DD 36 0D 50      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ 9EFD DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ 9F01 DD 36 0F 58      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ 9F05
 170+ 9F05                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ 9F05 3E 19            LD A, SPAWN_INTERVAL
 172+ 9F07 32 CC 81         LD (SpawnTimer), A
 173+ 9F0A AF               XOR A
 174+ 9F0B 32 CD 81         LD (EnemyStepIdx), A
 175+ 9F0E 32 D3 81         LD (PendingEraseCount), A
 176+ 9F11 C9               RET
 177+ 9F12
 178+ 9F12              ; ==============================================================================
 179+ 9F12              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ 9F12              ; ==============================================================================
 181+ 9F12              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ 9F12              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ 9F12              ; que los pies parezcan hundirse en el suelo.
 184+ 9F12              ; ==============================================================================
 185+ 9F12              ComputePlayerDrawY:
 186+ 9F12 3A B3 80         LD A, (EntityTable + ENT_POSX)
 187+ 9F15 C6 08            ADD A, 8                    ; center X del player
 188+ 9F17 47               LD B, A
 189+ 9F18 3A B4 80         LD A, (EntityTable + ENT_POSY)
 190+ 9F1B 4F               LD C, A
 191+ 9F1C 32 CA 81         LD (PlayerDrawY), A         ; default: sin offset
 192+ 9F1F B7               OR A
 193+ 9F20 C8               RET Z
 194+ 9F21 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ 9F22 CD 4B C7         CALL IsPointBlocked
 196+ 9F25 C8               RET Z                       ; libre → sin offset
 197+ 9F26 3A B4 80         LD A, (EntityTable + ENT_POSY)
 198+ 9F29 3C               INC A
 199+ 9F2A 32 CA 81         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ 9F2D C9               RET
 201+ 9F2E
 202+ 9F2E              ; ==============================================================================
 203+ 9F2E              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ 9F2E              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ 9F2E              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ 9F2E              ; no parecer que se hunde en el techo.
 207+ 9F2E              ; Preserva: IX. Destruye: AF, BC.
 208+ 9F2E              ; ==============================================================================
 209+ 9F2E              ComputeEnemyDrawY:
 210+ 9F2E DD 7E 04         LD A, (IX+ENT_POSY)
 211+ 9F31 32 CB 81         LD (EnemyDrawY), A          ; default = POSY
 212+ 9F34 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ 9F37 FE 02            CP TYPE_MONSTER
 214+ 9F39 C0               RET NZ                      ; no monster → sin offset
 215+ 9F3A DD 7E 03         LD A, (IX+ENT_POSX)
 216+ 9F3D C6 08            ADD A, 8                    ; center X
 217+ 9F3F 47               LD B, A
 218+ 9F40 DD 7E 04         LD A, (IX+ENT_POSY)
 219+ 9F43 4F               LD C, A
 220+ 9F44 B7               OR A
 221+ 9F45 C8               RET Z
 222+ 9F46 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ 9F47 CD 4B C7         CALL IsPointBlocked
 224+ 9F4A C8               RET Z                       ; libre → sin offset
 225+ 9F4B DD 7E 04         LD A, (IX+ENT_POSY)
 226+ 9F4E 3C               INC A
 227+ 9F4F 32 CB 81         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ 9F52 C9               RET
 229+ 9F53
 230+ 9F53              ; ==============================================================================
 231+ 9F53              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 232+ 9F53              ; ==============================================================================
 233+ 9F53              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 234+ 9F53              ; ==============================================================================
 235+ 9F53              ProcessPlayer:
 236+ 9F53 DD 21 B0 80      LD IX, EntityTable
 237+ 9F57
 238+ 9F57                  ; --- Fresh check ---
 239+ 9F57 3A ED 81         LD A, (ScreenJustRedrawn)
 240+ 9F5A B7               OR A
 241+ 9F5B C2 30 A0         JP NZ, .plFresh
 242+ 9F5E DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 243+ 9F62 C2 30 A0         JP NZ, .plFresh
 244+ 9F65
 245+ 9F65                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 246+ 9F65 CD E3 A4         CALL UpdatePlayer
 247+ 9F68 CD FC A3         CALL CalcDrawX
 248+ 9F6B CD 12 9F         CALL ComputePlayerDrawY
 249+ 9F6E
 250+ 9F6E                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 251+ 9F6E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 252+ 9F71 DD BE 0C         CP (IX+ENT_OLDX)
 253+ 9F74 20 47            JR NZ, .plDoErase
 254+ 9F76 3A CA 81         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 255+ 9F79 DD BE 0D         CP (IX+ENT_OLDY)
 256+ 9F7C 20 3F            JR NZ, .plDoErase
 257+ 9F7E DD 7E 00         LD A, (IX+ENT_SPRITEID)
 258+ 9F81 DD BE 0E         CP (IX+ENT_OLDSPRID)
 259+ 9F84 20 37            JR NZ, .plDoErase
 260+ 9F86                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 261+ 9F86 3A 30 C0         LD A, (PlayerHitTimer)
 262+ 9F89 B7               OR A
 263+ 9F8A 20 01            JR NZ, .plRepaintAttr
 264+ 9F8C C9               RET                                 ; Nada cambio → skip todo
 265+ 9F8D              .plRepaintAttr:
 266+ 9F8D 3A CA 81         LD A, (PlayerDrawY)
 267+ 9F90 57               LD D, A
 268+ 9F91 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 269+ 9F94 5F               LD E, A
 270+ 9F95 DD E5            PUSH IX
 271+ 9F97 CD 41 A4         CALL GetSpriteAddr
 272+ 9F9A DD 2A 70 A4      LD IX, (SpriteAddrTemp)
 273+ 9F9E CD 57 9B         CALL CalcEntityAttrSize
 274+ 9FA1                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 275+ 9FA1 3A 29 9C         LD A, (EntityAttrH)
 276+ 9FA4 FE 02            CP 2
 277+ 9FA6 38 04            JR C, .plAttrHOk
 278+ 9FA8 3D               DEC A
 279+ 9FA9 32 29 9C         LD (EntityAttrH), A
 280+ 9FAC              .plAttrHOk:
 281+ 9FAC DD E1            POP IX
 282+ 9FAE 3A CA 81         LD A, (PlayerDrawY)
 283+ 9FB1 57               LD D, A
 284+ 9FB2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 285+ 9FB5 5F               LD E, A
 286+ 9FB6 DD 7E 05         LD A, (IX+ENT_ATTR)
 287+ 9FB9 CD 2A 9B         CALL SetEntityAttr
 288+ 9FBC C9               RET
 289+ 9FBD
 290+ 9FBD              .plDoErase:
 291+ 9FBD                  ; --- Erase viejo ---
 292+ 9FBD CD 72 A4         CALL GetOldSpriteAddr
