 279+ 7406              ; ==============================================================================
 280+ 7406              ; PaintMagicCompassAttrs - Pinta los 4 chars del HUD compass en modo magic
 281+ 7406              ; ==============================================================================
 282+ 7406              ; Color base lo decide el editor (sprite id 36, attrBytes). El runtime lo
 283+ 7406              ; lee de MagicCompassBaseAttrs (auto-importado por import_magic_compass_hud.py
 284+ 7406              ; con bit 6 BRIGHT clearado) y aplica BRIGHT solo al char correspondiente
 285+ 7406              ; a la PathDir. Durante los últimos 5 s ese bright parpadea on/off a ~6 Hz.
 286+ 7406              ;
 287+ 7406              ; Mapping diagonal de las 4 esquinas del 2x2:
 288+ 7406              ;   col1   col2
 289+ 7406              ;     W      N    (row 1, top)     ← idx 0 (1,1) | idx 1 (2,1)
 290+ 7406              ;     S      E    (row 2, bottom)  ← idx 2 (1,2) | idx 3 (2,2)
 291+ 7406              ;
 292+ 7406              ;   PathDir 0 (N) → idx 1 → offset +1
 293+ 7406              ;   PathDir 1 (S) → idx 2 → offset +$20
 294+ 7406              ;   PathDir 2 (W) → idx 0 → offset +0
 295+ 7406              ;   PathDir 3 (E) → idx 3 → offset +$21
 296+ 7406              ;
 297+ 7406              ; Destruye: AF, BC, DE, HL.
 298+ 7406              ; ==============================================================================
 299+ 7406              PaintMagicCompassAttrs:
 300+ 7406                  ; Pintar 4 chars con MagicCompassBaseAttrs (orden: 1,1 / 2,1 / 1,2 / 2,2)
 301+ 7406 11 44 77         LD DE, MagicCompassBaseAttrs
 302+ 7409 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 303+ 740C 1A               LD A, (DE)
 304+ 740D 77               LD (HL), A
 305+ 740E 23               INC HL
 306+ 740F 13               INC DE
 307+ 7410 1A               LD A, (DE)
 308+ 7411 77               LD (HL), A
 309+ 7412 13               INC DE
 310+ 7413 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 311+ 7416 1A               LD A, (DE)
 312+ 7417 77               LD (HL), A
 313+ 7418 23               INC HL
 314+ 7419 13               INC DE
 315+ 741A 1A               LD A, (DE)
 316+ 741B 77               LD (HL), A
 317+ 741C
 318+ 741C                  ; Si sin path no hay char activo: solo base attrs (ya pintados).
 319+ 741C 3A C1 5F         LD A, (MagicCompassPathDir)
 320+ 741F FE FF            CP $FF
 321+ 7421 C8               RET Z
 322+ 7422
 323+ 7422                  ; Si el tick no está sonando, char activo se queda con base attr.
 324+ 7422                  ; Eso da el efecto visual "OFF" entre pitidos.
 325+ 7422 3A C3 5F         LD A, (MagicCompassTickActiveFrames)
 326+ 7425 B7               OR A
 327+ 7426 C8               RET Z
