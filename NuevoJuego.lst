1042+ A890
1043+ A890              ; ==============================================================================
1044+ A890              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1045+ A890              ; ==============================================================================
1046+ A890              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1047+ A890              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1048+ A890              ; ==============================================================================
1049+ A890              GetSpriteAddr:
1050+ A890                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1051+ A890                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1052+ A890 3A C9 90         LD A, (CurrentPaging)
1053+ A893 E6 F8            AND $F8
1054+ A895 F6 06            OR 6
1055+ A897 32 C9 90         LD (CurrentPaging), A
1056+ A89A 01 FD 7F         LD BC, $7FFD
1057+ A89D ED 79            OUT (C), A                  ; bank 6 paginado
1058+ A89F DD 7E 00         LD A, (IX+ENT_SPRITEID)
1059+ A8A2 6F               LD L, A
1060+ A8A3 26 00            LD H, 0
1061+ A8A5 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1062+ A8A6 11 D3 E7         LD DE, SpriteFrameTable
1063+ A8A9 19               ADD HL, DE
1064+ A8AA 5E               LD E, (HL)
1065+ A8AB 23               INC HL
1066+ A8AC 56               LD D, (HL)
1067+ A8AD ED 53 BF A8      LD (SpriteAddrTemp), DE
1068+ A8B1 3A C9 90         LD A, (CurrentPaging)
