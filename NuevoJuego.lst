  1+  82B3              ; ==============================================================================
  2+  82B3              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
  3+  82B3              ; ==============================================================================
  4+  82B3              ; - Estructura de entidad de 12 bytes (universal)
  5+  82B3              ; - Game loop per-entity: erase → update → draw
  6+  82B3              ; - Movimiento 8-bit (sin subpixel)
  7+  82B3              ; - Animacion por SpriteID (incrementar dentro de rango)
  8+  82B3              ; - XOR draw/erase (una sola rutina)
  9+  82B3              ; ==============================================================================
 10+  82B3
 11+  82B3              ; ==============================================================================
 12+  82B3              ; ReadInput - Lee teclado y genera direccion + fuego
 13+  82B3              ; ==============================================================================
 14+  82B3              ReadInput:
 15+  82B3 AF               XOR A
 16+  82B4 32 02 81         LD (InputDirection), A
 17+  82B7 32 03 81         LD (InputFire), A
 18+  82BA
 19+  82BA                  ; --- Q (Arriba) ---
 20+  82BA 01 FE FB         LD BC, $FBFE
 21+  82BD ED 78            IN A, (C)
 22+  82BF CB 47            BIT 0, A
 23+  82C1 20 08            JR NZ, .noUp
 24+  82C3 3A 02 81         LD A, (InputDirection)
 25+  82C6 F6 01            OR DIR_N
 26+  82C8 32 02 81         LD (InputDirection), A
 27+  82CB              .noUp:
 28+  82CB                  ; --- A (Abajo) ---
 29+  82CB 01 FE FD         LD BC, $FDFE
 30+  82CE ED 78            IN A, (C)
 31+  82D0 CB 47            BIT 0, A
 32+  82D2 20 08            JR NZ, .noDown
 33+  82D4 3A 02 81         LD A, (InputDirection)
 34+  82D7 F6 02            OR DIR_S
 35+  82D9 32 02 81         LD (InputDirection), A
 36+  82DC              .noDown:
 37+  82DC                  ; --- O (Izquierda) ---
 38+  82DC 01 FE DF         LD BC, $DFFE
 39+  82DF ED 78            IN A, (C)
 40+  82E1 CB 4F            BIT 1, A
 41+  82E3 20 08            JR NZ, .noLeft
 42+  82E5 3A 02 81         LD A, (InputDirection)
 43+  82E8 F6 08            OR DIR_W
 44+  82EA 32 02 81         LD (InputDirection), A
 45+  82ED              .noLeft:
 46+  82ED                  ; --- P (Derecha) ---
 47+  82ED 01 FE DF         LD BC, $DFFE
 48+  82F0 ED 78            IN A, (C)
 49+  82F2 CB 47            BIT 0, A
 50+  82F4 20 08            JR NZ, .noRight
 51+  82F6 3A 02 81         LD A, (InputDirection)
 52+  82F9 F6 04            OR DIR_E
 53+  82FB 32 02 81         LD (InputDirection), A
 54+  82FE              .noRight:
 55+  82FE                  ; --- SPACE (Fuego) ---
 56+  82FE 01 FE 7F         LD BC, $7FFE
 57+  8301 ED 78            IN A, (C)
 58+  8303 CB 47            BIT 0, A
 59+  8305 20 05            JR NZ, .noFire
 60+  8307 3E 01            LD A, 1
 61+  8309 32 03 81         LD (InputFire), A
 62+  830C              .noFire:
 63+  830C                  ; Cancelar opuestos
 64+  830C 3A 02 81         LD A, (InputDirection)
 65+  830F 47               LD B, A
 66+  8310 E6 03            AND DIR_N | DIR_S
 67+  8312 FE 03            CP DIR_N | DIR_S
 68+  8314 20 04            JR NZ, .noVC
 69+  8316 78               LD A, B
 70+  8317 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 71+  8319 47               LD B, A
 72+  831A              .noVC:
 73+  831A 78               LD A, B
 74+  831B E6 0C            AND DIR_E | DIR_W
 75+  831D FE 0C            CP DIR_E | DIR_W
 76+  831F 20 04            JR NZ, .noHC
 77+  8321 78               LD A, B
 78+  8322 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 79+  8324 47               LD B, A
 80+  8325              .noHC:
 81+  8325 78               LD A, B
 82+  8326 32 02 81         LD (InputDirection), A
 83+  8329 C9               RET
 84+  832A
 85+  832A              ; ==============================================================================
 86+  832A              ; InitEntities - Inicializa la tabla de entidades
 87+  832A              ; ==============================================================================
 88+  832A              ; Limpia todos los slots y configura el slot 0 como player.
 89+  832A              ; ==============================================================================
 90+  832A              InitEntities:
 91+  832A                  ; Limpiar toda la tabla a ceros
 92+  832A 21 36 80         LD HL, EntityTable
 93+  832D 11 37 80         LD DE, EntityTable + 1
 94+  8330 01 CB 00         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 95+  8333 AF               XOR A
 96+  8334 77               LD (HL), A
 97+  8335 ED B0            LDIR
 98+  8337
 99+  8337                  ; Configurar slot 0: Player
100+  8337 DD 21 36 80      LD IX, EntityTable
101+  833B DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE    ; Frame idle 0
102+  833F DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
103+  8343 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
104+  8347 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
105+  834B DD 36 04 58      LD (IX+ENT_POSY), START_PLAYER_Y
106+  834F DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
107+  8353 DD 36 06 00      LD (IX+ENT_DELTAX), 0
108+  8357 DD 36 07 00      LD (IX+ENT_DELTAY), 0
109+  835B DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
110+  835F DD 36 09 08      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
111+  8363 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
112+  8367 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
113+  836B C9               RET
