 419+ A33B
 420+ A33B              ; ==============================================================================
 421+ A33B              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A33B              ; ==============================================================================
 423+ A33B              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A33B              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A33B              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A33B              ; ==============================================================================
 427+ A33B              ProcessEnemies:
 428+ A33B 3E 00            LD A, 0
 429+ A33D 32 86 A3         LD (.peCount), A
 430+ A340 06 0A            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A342
 432+ A342              .peLoop:
 433+ A342 C5               PUSH BC
 434+ A343
 435+ A343                  ; Calcular IX desde EnemyStepIdx
 436+ A343 3A 02 83         LD A, (EnemyStepIdx)
 437+ A346 C6 01            ADD A, SLOT_MONSTER0
 438+ A348 6F               LD L, A
 439+ A349 26 00            LD H, 0
 440+ A34B 29               ADD HL, HL
 441+ A34C 29               ADD HL, HL
 442+ A34D 29               ADD HL, HL
 443+ A34E 29               ADD HL, HL                          ; × ENT_SIZE (16)
 444+ A34F 11 9B 81         LD DE, EntityTable
 445+ A352 19               ADD HL, DE
 446+ A353 E5               PUSH HL
 447+ A354 DD E1            POP IX
 448+ A356
 449+ A356                  ; Avanzar indice round-robin
 450+ A356 3A 02 83         LD A, (EnemyStepIdx)
 451+ A359 3C               INC A
 452+ A35A FE 0A            CP NUM_MONSTERS + NUM_NASTIES
 453+ A35C 38 01            JR C, .peNoWrap
 454+ A35E AF               XOR A
 455+ A35F              .peNoWrap:
 456+ A35F 32 02 83         LD (EnemyStepIdx), A
 457+ A362
 458+ A362                  ; Slot activo?
 459+ A362 DD 7E 01         LD A, (IX+ENT_TYPE)
 460+ A365 B7               OR A
 461+ A366 28 16            JR Z, .peSkip
 462+ A368
 463+ A368                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 464+ A368 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 465+ A36C F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 466+ A36D
 467+ A36D                  ; Procesar esta entidad completa (erase + logic + draw)
 468+ A36D CD 87 A3         CALL ProcessOneEnemy
 469+ A370
 470+ A370                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 471+ A370 F1               POP AF
 472+ A371 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 473+ A373
 474+ A373                  ; Budget check
 475+ A373 3A 86 A3         LD A, (.peCount)
 476+ A376 3C               INC A
 477+ A377 32 86 A3         LD (.peCount), A
 478+ A37A FE 02            CP MAX_ENEMIES_PER_FRAME
 479+ A37C 30 06            JR NC, .peDone
