 529+ E524              .hexToAscii:
 530+ E524 FE 0A            CP 10
 531+ E526 38 03            JR C, .isDigit
 532+ E528 C6 37            ADD A, 'A' - 10
 533+ E52A C9               RET
 534+ E52B              .isDigit:
 535+ E52B C6 30            ADD A, '0'
 536+ E52D C9               RET
