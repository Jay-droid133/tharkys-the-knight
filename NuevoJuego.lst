1237+ AFC9              ; ==============================================================================
1238+ AFC9              ; Entrada: B=charX, C=charY, D=height_chars, E=width_chars
1239+ AFC9              ; Borra los pixeles a 0 y los atributos a $07 (ink white, paper black)
