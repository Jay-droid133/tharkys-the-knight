2115+ AAA3              ; ==============================================================================
2116+ AAA3              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2117+ AAA3              ; ==============================================================================
2118+ AAA3              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2119+ AAA3              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2120+ AAA3              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2121+ AAA3              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2122+ AAA3              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2123+ AAA3              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2124+ AAA3              ; ==============================================================================
2125+ AAA3              SelectSwordMode:
2126+ AAA3 3A 4C B3         LD A, (PlayerStamina)
2127+ AAA6 FE 0C            CP STAMINA_THRESHOLD_HIGH
2128+ AAA8 38 04            JR C, .smNotHigh
2129+ AAAA 3E 02            LD A, 2                             ; Libre (continuo)
2130+ AAAC 18 09            JR .smSet
2131+ AAAE              .smNotHigh:
2132+ AAAE FE 07            CP STAMINA_THRESHOLD_MID
2133+ AAB0 38 04            JR C, .smNotMid
2134+ AAB2 3E 01            LD A, 1                             ; Fixed swing
2135+ AAB4 18 01            JR .smSet
2136+ AAB6              .smNotMid:
2137+ AAB6 AF               XOR A                               ; Cooldown (0)
2138+ AAB7              .smSet:
2139+ AAB7 32 4A B3         LD (SwordMode), A
2140+ AABA B7               OR A
2141+ AABB C8               RET Z                               ; Mode B → cooldown legítimo, no tocar
2142+ AABC                  ; Mode C/Free: cooldown sin sentido. Limpiar + reset color si quedó azul.
2143+ AABC AF               XOR A
2144+ AABD 32 47 B3         LD (AttackCooldown), A
2145+ AAC0 3A 99 81         LD A, (EntityTable + ENT_ATTR)
2146+ AAC3 FE 41            CP BLUE | $40
2147+ AAC5 C0               RET NZ                              ; No estaba azul → nada que hacer
2148+ AAC6 3A ED C4         LD A, (PlayerHitTimer)
2149+ AAC9 B7               OR A
2150+ AACA C0               RET NZ                              ; En flash de daño → no pisar el rojo
2151+ AACB 3E 47            LD A, WHITE | $40
2152+ AACD 32 99 81         LD (EntityTable + ENT_ATTR), A
2153+ AAD0 C9               RET
2154+ AAD1
2155+ AAD1              ; ==============================================================================
2156+ AAD1              ; GetStaminaColor - Devuelve color del player segun estado actual
2157+ AAD1              ; ==============================================================================
