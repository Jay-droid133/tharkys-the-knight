 222  C928                  INCLUDE "monster_ai_bank6.asm"
# file opened: monster_ai_bank6.asm
   1+ C928              ; ==============================================================================
   2+ C928              ; MONSTER AI v2 — buffers runtime en bank 6
   3+ C928              ; ==============================================================================
   4+ C928              ; Se incluye en main.asm dentro del bloque PAGE 6, DESPUES de screen_gaps.asm.
   5+ C928              ; Los buffers viven en $Cxxx y se acceden paginando bank 6 al slot 3.
   6+ C928              ;
   7+ C928              ;   FlowField   — 704 B, distancia-al-player por celda (32×22 chars)
   8+ C928              ;                 Formato: 1 byte por celda. Valor $FF = inalcanzable.
   9+ C928              ;                 Offset lineal: cellY * 32 + cellX
  10+ C928              ;
  11+ C928              ;   BfsQueue    — 1408 B, FIFO para el BFS (cola de celdas a procesar)
  12+ C928              ;                 Cada entrada: 2 bytes = (cx, cy) con cx 0-31, cy 0-21.
  13+ C928              ;                 Capacidad 704 entradas = todo el grid. Suficiente en peor caso.
  14+ C928              ;
  15+ C928              ; Escritura y lectura: los clientes deben paginar bank 6 antes, repaginar bank 0
  16+ C928              ; despues (ver PageBankSlot3 en paging.asm).
  17+ C928              ; ==============================================================================
  18+ C928
  19+ C928 00 00 00...  FlowField:      DEFS 704
  20+ CBE8 00 00 00...  BfsQueue:       DEFS 1408
  21+ D168
  22+ D168              MonsterAiBank6End:
  23+ D168
# file closed: monster_ai_bank6.asm
 223  D168                  INCLUDE "sprite_data.asm"
# file opened: sprite_data.asm
   1+ D168              ; ==============================================================================
   2+ D168              ; DATOS DE SPRITES DEL JUGADOR (con cabecera width/height)
   3+ D168              ; ==============================================================================
   4+ D168              ; Formato por sprite:
   5+ D168              ;   DEFB width_bytes   (2=16px, 3=24px)
   6+ D168              ;   DEFB height_pixels
   7+ D168              ;   DEFB pixel_data... (width * height bytes)
   8+ D168              ;
   9+ D168              ; Organizacion:
  10+ D168              ;   SpriteID 0-1:   Idle (2 frames)
  11+ D168              ;   SpriteID 2-5:   Walk East (4 frames: 0,1,2,1)
  12+ D168              ;   SpriteID 5-8:   Walk West (4 frames: 0,1,2,1)
  13+ D168              ;   SpriteID 8-10:  Walk North (3 frames)
  14+ D168              ;   SpriteID 11-13: Walk South (3 frames)
  15+ D168              ;   SpriteID 14-15: Fight East (2 frames)
  16+ D168              ;   SpriteID 16-17: Fight West (2 frames)
  17+ D168              ; ==============================================================================
  18+ D168
  19+ D168              ; --- SpriteID bases para animaciones ---
  20+ D168              SPRID_IDLE       EQU 0
  21+ D168              SPRID_WALK_E     EQU 2
  22+ D168              SPRID_WALK_W     EQU 6
  23+ D168              SPRID_WALK_N     EQU 10
  24+ D168              SPRID_WALK_S     EQU 14
  25+ D168              SPRID_FIGHT_E    EQU 18
  26+ D168              SPRID_FIGHT_W    EQU 20
  27+ D168              SPRID_ATTACK_EAST EQU 22
  28+ D168              SPRID_ATTACK_WEST EQU 27
  29+ D168
  30+ D168              ; ==============================================================================
  31+ D168              ; IDLE - Mirando al sur, quieto (2 frames, 16x16)
  32+ D168              ; ==============================================================================
