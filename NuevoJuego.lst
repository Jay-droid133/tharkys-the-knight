 471+ 9D5D              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D5D              ; ==============================================================================
 473+ 9D5D              SetAttrSlot:
 474+ 9D5D 32 5C 9D         LD (CurrentAttrSlot), A
 475+ 9D60                  ; Calcular offset: A * 18
 476+ 9D60 6F               LD L, A
 477+ 9D61 26 00            LD H, 0
 478+ 9D63 29               ADD HL, HL                  ; x2
 479+ 9D64 54               LD D, H
 480+ 9D65 5D               LD E, L                     ; DE = x2
 481+ 9D66 29               ADD HL, HL                  ; x4
 482+ 9D67 29               ADD HL, HL                  ; x8
 483+ 9D68 29               ADD HL, HL                  ; x16
 484+ 9D69 19               ADD HL, DE                  ; x18
 485+ 9D6A 11 2A 9C         LD DE, SavedAttrTable
 486+ 9D6D 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D6E                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D6E 11 18 9C         LD DE, EntitySavedAttr
 489+ 9D71 01 12 00         LD BC, 18
 490+ 9D74 ED B0            LDIR
 491+ 9D76 C9               RET
 492+ 9D77
 493+ 9D77              ; ==============================================================================
 494+ 9D77              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D77              ; ==============================================================================
 496+ 9D77              FlushAttrSlot:
 497+ 9D77 3A 5C 9D         LD A, (CurrentAttrSlot)
 498+ 9D7A 6F               LD L, A
 499+ 9D7B 26 00            LD H, 0
 500+ 9D7D 29               ADD HL, HL                  ; x2
 501+ 9D7E 54               LD D, H
 502+ 9D7F 5D               LD E, L
 503+ 9D80 29               ADD HL, HL                  ; x4
 504+ 9D81 29               ADD HL, HL                  ; x8
 505+ 9D82 29               ADD HL, HL                  ; x16
 506+ 9D83 19               ADD HL, DE                  ; x18
 507+ 9D84 11 2A 9C         LD DE, SavedAttrTable
 508+ 9D87 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D88 EB               EX DE, HL                   ; DE = destino
 510+ 9D89 21 18 9C         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D8C 01 12 00         LD BC, 18
 512+ 9D8F ED B0            LDIR
 513+ 9D91 C9               RET
 514+ 9D92
 515+ 9D92              ; ==============================================================================
 516+ 9D92              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D92              ; ==============================================================================
 518+ 9D92              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D92              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D92              ; ==============================================================================
 521+ 9D92              CalcAttrAddr:
 522+ 9D92 7A               LD A, D
 523+ 9D93 0F               RRCA
 524+ 9D94 0F               RRCA
 525+ 9D95 0F               RRCA
 526+ 9D96 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D98 6F               LD L, A
 528+ 9D99 26 00            LD H, 0
 529+ 9D9B 29               ADD HL, HL
 530+ 9D9C 29               ADD HL, HL
 531+ 9D9D 29               ADD HL, HL
 532+ 9D9E 29               ADD HL, HL
 533+ 9D9F 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9DA0 7B               LD A, E
 535+ 9DA1 0F               RRCA
 536+ 9DA2 0F               RRCA
 537+ 9DA3 0F               RRCA
 538+ 9DA4 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9DA6 B5               OR L
 540+ 9DA7 6F               LD L, A
 541+ 9DA8 01 00 58         LD BC, ATTR_BASE
 542+ 9DAB 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9DAC C9               RET
 544+ 9DAD
 545+ 9DAD              ; ==============================================================================
 546+ 9DAD              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9DAD              ; ==============================================================================
 548+ 9DAD              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9DAD              ; Salida: HL=direccion en VRAM
 550+ 9DAD              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9DAD              ; ==============================================================================
 552+ 9DAD              CalcPixelAddr:
 553+ 9DAD 7A               LD A, D
 554+ 9DAE E6 C0            AND $C0                     ; Y7 Y6
 555+ 9DB0 1F               RRA
 556+ 9DB1 1F               RRA
 557+ 9DB2 1F               RRA                         ; >> 3
 558+ 9DB3 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9DB5 67               LD H, A
 560+ 9DB6
 561+ 9DB6 7A               LD A, D
 562+ 9DB7 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9DB9 B4               OR H
 564+ 9DBA 67               LD H, A
 565+ 9DBB
 566+ 9DBB 7A               LD A, D
 567+ 9DBC E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9DBE 87               ADD A, A
 569+ 9DBF 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9DC0 6F               LD L, A
 571+ 9DC1
 572+ 9DC1 7B               LD A, E
 573+ 9DC2 1F               RRA
 574+ 9DC3 1F               RRA
 575+ 9DC4 1F               RRA
 576+ 9DC5 E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9DC7 B5               OR L
 578+ 9DC8 6F               LD L, A
 579+ 9DC9 C9               RET
 580+ 9DCA
 581+ 9DCA              ; ==============================================================================
 582+ 9DCA              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9DCA              ; ==============================================================================
 584+ 9DCA              DrawDebugInfo:
 585+ 9DCA 3A E3 81         LD A, (CurrentScreenX)
 586+ 9DCD 1E 00            LD E, 0
 587+ 9DCF CD EC 9D         CALL .drawHexDigit
 588+ 9DD2
 589+ 9DD2 3E 2C            LD A, ','
 590+ 9DD4 1E 01            LD E, 1
 591+ 9DD6 CD F8 9D         CALL .drawChar
 592+ 9DD9
 593+ 9DD9 3A E4 81         LD A, (CurrentScreenY)
 594+ 9DDC 1E 02            LD E, 2
 595+ 9DDE CD EC 9D         CALL .drawHexDigit
 596+ 9DE1
 597+ 9DE1 21 00 58         LD HL, ATTR_BASE
 598+ 9DE4 3E 47            LD A, WHITE | $40
 599+ 9DE6 77               LD (HL), A
 600+ 9DE7 23               INC HL
 601+ 9DE8 77               LD (HL), A
 602+ 9DE9 23               INC HL
 603+ 9DEA 77               LD (HL), A
 604+ 9DEB C9               RET
 605+ 9DEC
 606+ 9DEC              .drawHexDigit:
 607+ 9DEC E6 0F            AND $0F
 608+ 9DEE FE 0A            CP 10
 609+ 9DF0 38 04            JR C, .isNum
 610+ 9DF2 C6 37            ADD A, 'A' - 10
 611+ 9DF4 18 02            JR .drawChar
 612+ 9DF6              .isNum:
 613+ 9DF6 C6 30            ADD A, '0'
 614+ 9DF8              .drawChar:
 615+ 9DF8 6F               LD L, A
 616+ 9DF9 26 00            LD H, 0
 617+ 9DFB 29               ADD HL, HL
 618+ 9DFC 29               ADD HL, HL
 619+ 9DFD 29               ADD HL, HL
 620+ 9DFE 01 00 3C         LD BC, $3C00
 621+ 9E01 09               ADD HL, BC
 622+ 9E02
 623+ 9E02 16 40            LD D, $40
 624+ 9E04 06 08            LD B, 8
 625+ 9E06              .charLoop:
 626+ 9E06 7E               LD A, (HL)
 627+ 9E07 12               LD (DE), A
 628+ 9E08 23               INC HL
 629+ 9E09 14               INC D
 630+ 9E0A 10 FA            DJNZ .charLoop
 631+ 9E0C C9               RET
