 159  80F0
 160  80F0                  ; ==========================================================================
 161  80F0                  ; ORG $8000 - codigo principal (no-contended)
 162  80F0                  ; ==========================================================================
 163  80F0                  ORG ORIGIN_ADDRESS
 164  8000
 165  8000              ; ==============================================================================
 166  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 167  8000              ; ==============================================================================
 168  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 169  8000              ;   erase viejo → AI/movimiento → draw nuevo
 170  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 171  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 172  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 173  8000              ; ==============================================================================
 174  8000              MainLoop:
 175  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 176  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 177  8003 47               LD B, A                     ; B = tick actual
 178  8004
 179  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 180  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 181  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 182  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 183  8004 78               LD A, B
 184  8005 21 47 81         LD HL, .frameStart
 185  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 186  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 187  800A 21 2E 9D         LD HL, TickRemainder
 188  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 189  800E 4F               LD C, A
 190  800F E6 01            AND $01
 191  8011 77               LD (HL), A                  ; new remainder = total mod 2
 192  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 193  8014 79               LD A, C
 194  8015 32 2D 9D         LD (FramesElapsed), A
 195  8018
 196  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 197  8018 CD 7E CE         CALL UpdateDeathBorder
 198  801B CD 4F CE         CALL UpdateDeathAnim
 199  801E                  ; UpdateMusic vive aqui (no en .skipUpdates) para que las pistas tabulares
 200  801E                  ; suenen tambien durante cutscenes (TownGatePhase!=0) y GameOver. Cada
 201  801E                  ; llamada hace catchup interno via FramesElapsed (loop de N iteraciones).
 202  801E CD 07 9C         CALL UpdateMusic
