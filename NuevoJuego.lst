7032+ C63F DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7033+ C643                  ; Flags: visible + newspawn (no destructible: la muerte es invulnerable)
7034+ C643 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
7035+ C647                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
7036+ C647 AF               XOR A
