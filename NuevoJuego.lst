2164+ AAE1 3A 51 B3         LD A, (AttackCooldown)
2165+ AAE4 B7               OR A
2166+ AAE5 28 03            JR Z, .gscWhite
2167+ AAE7 3E 41            LD A, BLUE | $40                    ; Modo B + cooldown activo → azul
2168+ AAE9 C9               RET
2169+ AAEA              .gscWhite:
2170+ AAEA 3E 47            LD A, WHITE | $40                   ; Normal → blanco
2171+ AAEC C9               RET
2172+ AAED
2173+ AAED              ; ==============================================================================
2174+ AAED              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2175+ AAED              ; ==============================================================================
2176+ AAED              CheckWellPickup:
2177+ AAED 3A 5A 8D         LD A, (WellActive)
2178+ AAF0 B7               OR A
2179+ AAF1 C8               RET Z                               ; No hay pozo en esta pantalla
2180+ AAF2                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2181+ AAF2 2A 5E 8D         LD HL, (WellCooldownTimer)
2182+ AAF5 7C               LD A, H
2183+ AAF6 B5               OR L
2184+ AAF7 C0               RET NZ                              ; timer > 0 → skip
2185+ AAF8                  ; Ya esta al maximo? No hacer nada
2186+ AAF8 3A 55 B3         LD A, (PlayerHealth)
2187+ AAFB FE 10            CP HEALTH_MAX
2188+ AAFD 20 06            JR NZ, .cwDoCheck
2189+ AAFF 3A 56 B3         LD A, (PlayerStamina)
2190+ AB02 FE 10            CP STAMINA_MAX
2191+ AB04 C8               RET Z                               ; Ambos al maximo → nada
2192+ AB05              .cwDoCheck:
2193+ AB05                  ; AABB con margen de 8px (1 celda) por cada lado:
2194+ AB05                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2195+ AB05                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2196+ AB05                  ; --- Check X ---
2197+ AB05 3A 5B 8D         LD A, (WellPosX)
2198+ AB08 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2199+ AB0A 4F               LD C, A
2200+ AB0B 3A A1 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2201+ AB0E B9               CP C                                ; playerX < wellRight+margen?
2202+ AB0F 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2203+ AB11 3A A1 81         LD A, (EntityTable + ENT_POSX)
2204+ AB14 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2205+ AB16 4F               LD C, A
2206+ AB17 3A 5B 8D         LD A, (WellPosX)                    ; A = wellX
2207+ AB1A B9               CP C                                ; wellX < playerRight+margen?
2208+ AB1B 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2209+ AB1D                  ; --- Check Y ---
2210+ AB1D 3A 5C 8D         LD A, (WellPosY)
2211+ AB20 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2212+ AB22 4F               LD C, A
2213+ AB23 3A A2 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2214+ AB26 B9               CP C                                ; playerY < wellBottom+margen?
2215+ AB27 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2216+ AB29 3A A2 81         LD A, (EntityTable + ENT_POSY)
2217+ AB2C C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2218+ AB2E 4F               LD C, A
2219+ AB2F 3A 5C 8D         LD A, (WellPosY)                    ; A = wellY
2220+ AB32 B9               CP C                                ; wellY < playerBottom+margen?
2221+ AB33 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2222+ AB35                  ; --- Overlap! Recuperar salud y stamina ---
2223+ AB35 3E 10            LD A, HEALTH_MAX
2224+ AB37 32 55 B3         LD (PlayerHealth), A
2225+ AB3A 3E 10            LD A, STAMINA_MAX
2226+ AB3C 32 56 B3         LD (PlayerStamina), A
2227+ AB3F                  ; Flash HUD y SFX
2228+ AB3F 3E 0A            LD A, 10                            ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
2229+ AB41 32 5D 8D         LD (WellFlashTimer), A
2230+ AB44                  ; Arrancar cooldown: capturar attrs originales + pintar blanco
2231+ AB44 CD 4E AB         CALL StartWellCooldown
2232+ AB47 21 37 F9         LD HL, SFX_WellRecover
2233+ AB4A CD 8D F8         CALL PlaySFX
2234+ AB4D              .cwNoOverlap:
2235+ AB4D C9               RET
2236+ AB4E
2237+ AB4E              ; ==============================================================================
2238+ AB4E              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2239+ AB4E              ; ==============================================================================
2240+ AB4E              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2241+ AB4E              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2242+ AB4E              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2243+ AB4E              ; ==============================================================================
2244+ AB4E              StartWellCooldown:
2245+ AB4E CD 7B AB         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2246+ AB51 E5               PUSH HL
2247+ AB52 11 58 8A         LD DE, CleanAttrMap
2248+ AB55 19               ADD HL, DE
2249+ AB56 7E               LD A, (HL)
2250+ AB57 32 60 8D         LD (WellOrigAttr0), A
2251+ AB5A 23               INC HL
2252+ AB5B 7E               LD A, (HL)
2253+ AB5C 32 61 8D         LD (WellOrigAttr1), A
2254+ AB5F E1               POP HL
2255+ AB60 CD 95 AB         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2256+ AB63 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2257+ AB66 22 5E 8D         LD (WellCooldownTimer), HL
2258+ AB69 C9               RET
2259+ AB6A
2260+ AB6A              ; ==============================================================================
2261+ AB6A              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2262+ AB6A              ; ==============================================================================
2263+ AB6A              ; Solo pinta blanco (no re-captura originals; los almacenados en
2264+ AB6A              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2265+ AB6A              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2266+ AB6A              ; para que el flash de cian dure lo mínimo posible.
2267+ AB6A              ; ==============================================================================
2268+ AB6A              ApplyWellCooldownIfActive:
2269+ AB6A 3A 5A 8D         LD A, (WellActive)
2270+ AB6D B7               OR A
2271+ AB6E C8               RET Z
2272+ AB6F 2A 5E 8D         LD HL, (WellCooldownTimer)
2273+ AB72 7C               LD A, H
2274+ AB73 B5               OR L
2275+ AB74 C8               RET Z
2276+ AB75 CD 7B AB         CALL GetWellBottomOffset
2277+ AB78 C3 95 AB         JP PaintWellWhiteAt
2278+ AB7B
2279+ AB7B              ; ==============================================================================
2280+ AB7B              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2281+ AB7B              ; ==============================================================================
2282+ AB7B              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2283+ AB7B              ; CleanAttrMap suma CleanAttrMap.
2284+ AB7B              ; Destruye: A, DE
2285+ AB7B              ; ==============================================================================
2286+ AB7B              GetWellBottomOffset:
2287+ AB7B 3A 5C 8D         LD A, (WellPosY)
2288+ AB7E 26 00            LD H, 0
2289+ AB80 6F               LD L, A
2290+ AB81 29               ADD HL, HL
2291+ AB82 29               ADD HL, HL                          ; (pixel_y/8)*32
2292+ AB83 3A 5B 8D         LD A, (WellPosX)
2293+ AB86 0F               RRCA
2294+ AB87 0F               RRCA
2295+ AB88 0F               RRCA
2296+ AB89 E6 1F            AND $1F
2297+ AB8B 85               ADD A, L
2298+ AB8C 6F               LD L, A
2299+ AB8D 30 01            JR NC, .gwbNoCarry
2300+ AB8F 24               INC H
2301+ AB90              .gwbNoCarry:
2302+ AB90 11 20 00         LD DE, 32
2303+ AB93 19               ADD HL, DE                          ; offset fila inferior
2304+ AB94 C9               RET
2305+ AB95
2306+ AB95              ; ==============================================================================
2307+ AB95              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2308+ AB95              ; ==============================================================================
2309+ AB95              ; IN: HL = offset fila inferior (relativo a attr map)
2310+ AB95              ; ==============================================================================
2311+ AB95              PaintWellWhiteAt:
2312+ AB95 E5               PUSH HL
2313+ AB96                  ; VRAM
2314+ AB96 11 00 58         LD DE, ATTR_BASE
2315+ AB99 19               ADD HL, DE
2316+ AB9A 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2317+ AB9C 77               LD (HL), A
2318+ AB9D 23               INC HL
2319+ AB9E 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2320+ ABA0 77               LD (HL), A
2321+ ABA1 E1               POP HL
2322+ ABA2                  ; CleanAttrMap
2323+ ABA2 11 58 8A         LD DE, CleanAttrMap
2324+ ABA5 19               ADD HL, DE
2325+ ABA6 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2326+ ABA8 77               LD (HL), A
2327+ ABA9 23               INC HL
2328+ ABAA 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2329+ ABAC 77               LD (HL), A
2330+ ABAD C9               RET
2331+ ABAE
2332+ ABAE              ; ==============================================================================
2333+ ABAE              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2334+ ABAE              ; ==============================================================================
2335+ ABAE              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2336+ ABAE              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2337+ ABAE              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2338+ ABAE              ; ==============================================================================
2339+ ABAE              UpdateWellCooldown:
2340+ ABAE 2A 5E 8D         LD HL, (WellCooldownTimer)
2341+ ABB1 7C               LD A, H
2342+ ABB2 B5               OR L
2343+ ABB3 C8               RET Z                               ; 0 → nada que hacer
2344+ ABB4 2B               DEC HL
2345+ ABB5 22 5E 8D         LD (WellCooldownTimer), HL
2346+ ABB8 7C               LD A, H
2347+ ABB9 B5               OR L
2348+ ABBA C0               RET NZ                              ; > 0 → esperar
2349+ ABBB                  ; Timer acaba de llegar a 0. Si estamos en la room del pozo, restaurar
2350+ ABBB                  ; attrs originales. Si no, al volver DrawScreen ya dibuja cian normal.
2351+ ABBB 3A 5A 8D         LD A, (WellActive)
2352+ ABBE B7               OR A
2353+ ABBF C8               RET Z
2354+ ABC0 C3 C3 AB         JP RestoreWellOriginalAttrs
2355+ ABC3
2356+ ABC3              ; ==============================================================================
2357+ ABC3              ; RestoreWellOriginalAttrs - escribe WellOrigAttrN a VRAM y CleanAttrMap
2358+ ABC3              ; ==============================================================================
2359+ ABC3              RestoreWellOriginalAttrs:
2360+ ABC3 CD 7B AB         CALL GetWellBottomOffset
2361+ ABC6 E5               PUSH HL
2362+ ABC7                  ; VRAM
2363+ ABC7 11 00 58         LD DE, ATTR_BASE
2364+ ABCA 19               ADD HL, DE
2365+ ABCB 3A 60 8D         LD A, (WellOrigAttr0)
2366+ ABCE 77               LD (HL), A
2367+ ABCF 23               INC HL
2368+ ABD0 3A 61 8D         LD A, (WellOrigAttr1)
2369+ ABD3 77               LD (HL), A
2370+ ABD4 E1               POP HL
2371+ ABD5                  ; CleanAttrMap
2372+ ABD5 11 58 8A         LD DE, CleanAttrMap
2373+ ABD8 19               ADD HL, DE
2374+ ABD9 3A 60 8D         LD A, (WellOrigAttr0)
2375+ ABDC 77               LD (HL), A
2376+ ABDD 23               INC HL
2377+ ABDE 3A 61 8D         LD A, (WellOrigAttr1)
2378+ ABE1 77               LD (HL), A
2379+ ABE2 C9               RET
2380+ ABE3
2381+ ABE3              ; ==============================================================================
2382+ ABE3              CheckPredatorAttack:
2383+ ABE3                  ; Buscar tipo depredador en PredatorTable
2384+ ABE3 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2385+ ABE6 D6 20            SUB SPRID_ENEMY_0
2386+ ABE8 CB 3F            SRL A
2387+ ABEA CB 3F            SRL A                               ; indice = (ANIMBASE - ENEMY_0) / 4
2388+ ABEC 21 E4 BC         LD HL, PredatorTable
2389+ ABEF 5F               LD E, A
2390+ ABF0 16 00            LD D, 0
2391+ ABF2 19               ADD HL, DE
2392+ ABF3 7E               LD A, (HL)                          ; A = byte predador
2393+ ABF4 B7               OR A
2394+ ABF5 C8               RET Z                               ; PRED_NONE → no es depredador
2395+ ABF6
2396+ ABF6                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2397+ ABF6 47               LD B, A                             ; B = byte predador completo
2398+ ABF7 CB 3F            SRL A
