  71+ 989B 01 FD 7F         LD BC, $7FFD
  72+ 989E ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98A0 ED 7B A5 98      LD SP, (.aubSavedSP)
  74+ 98A4 C9               RET
  75+ 98A5 00 00        .aubSavedSP: DEFW 0
