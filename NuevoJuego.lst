 191+ 9EAC              ; ==============================================================================
 192+ 9EAC              ; InitEntities - Inicializa la tabla de entidades
 193+ 9EAC              ; ==============================================================================
 194+ 9EAC              ; Limpia todos los slots y configura el slot 0 como player.
 195+ 9EAC              ; ==============================================================================
 196+ 9EAC              InitEntities:
 197+ 9EAC                  ; Limpiar toda la tabla a ceros
 198+ 9EAC 21 A3 81         LD HL, EntityTable
 199+ 9EAF 11 A4 81         LD DE, EntityTable + 1
 200+ 9EB2 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 201+ 9EB5 AF               XOR A
 202+ 9EB6 77               LD (HL), A
 203+ 9EB7 ED B0            LDIR
 204+ 9EB9
 205+ 9EB9                  ; Limpiar tabla de atributos salvados
 206+ 9EB9 21 DF 9B         LD HL, SavedAttrTable
 207+ 9EBC 11 E0 9B         LD DE, SavedAttrTable + 1
 208+ 9EBF 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 209+ 9EC2 AF               XOR A
 210+ 9EC3 77               LD (HL), A
 211+ 9EC4 ED B0            LDIR
 212+ 9EC6
 213+ 9EC6                  ; Configurar slot 0: Player
 214+ 9EC6 DD 21 A3 81      LD IX, EntityTable
 215+ 9ECA DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 216+ 9ECE DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 217+ 9ED2 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 218+ 9ED6 DD 36 03 50      LD (IX+ENT_POSX), START_PLAYER_X
 219+ 9EDA DD 36 04 58      LD (IX+ENT_POSY), START_PLAYER_Y
 220+ 9EDE DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 221+ 9EE2 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 222+ 9EE6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 223+ 9EEA DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 224+ 9EEE DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 225+ 9EF2 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 226+ 9EF6 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 227+ 9EFA DD 36 0C 50      LD (IX+ENT_OLDX), START_PLAYER_X
 228+ 9EFE DD 36 0D 58      LD (IX+ENT_OLDY), START_PLAYER_Y
 229+ 9F02 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 230+ 9F06 DD 36 0F 50      LD (IX+ENT_DRAWX), START_PLAYER_X
 231+ 9F0A
 232+ 9F0A                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 233+ 9F0A 3E 0C            LD A, SPAWN_INTERVAL
 234+ 9F0C 32 FD 82         LD (SpawnTimer), A
 235+ 9F0F AF               XOR A
 236+ 9F10 32 0A 83         LD (EnemyStepIdx), A
 237+ 9F13 32 7B 5F         LD (PendingEraseCount), A
 238+ 9F16 C9               RET
 239+ 9F17
 240+ 9F17              ; ==============================================================================
 241+ 9F17              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 242+ 9F17              ; ==============================================================================
 243+ 9F17              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 244+ 9F17              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 245+ 9F17              ; que los pies parezcan hundirse en el suelo.
 246+ 9F17              ; ==============================================================================
 247+ 9F17              ComputePlayerDrawY:
 248+ 9F17                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 249+ 9F17                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 250+ 9F17                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 251+ 9F17 3A A3 81         LD A, (EntityTable + ENT_SPRITEID)
 252+ 9F1A D6 6E            SUB SPRID_PLAYER_DEATH
 253+ 9F1C FE 06            CP 6
 254+ 9F1E 30 09            JR NC, .cpdyNotDeath
 255+ 9F20 3A A7 81         LD A, (EntityTable + ENT_POSY)
 256+ 9F23 C6 05            ADD A, 5
 257+ 9F25 32 E4 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 258+ 9F28 C9               RET
 259+ 9F29              .cpdyNotDeath:
 260+ 9F29 3A A6 81         LD A, (EntityTable + ENT_POSX)
 261+ 9F2C C6 08            ADD A, 8                    ; center X del player
 262+ 9F2E 47               LD B, A
 263+ 9F2F 3A A7 81         LD A, (EntityTable + ENT_POSY)
 264+ 9F32 4F               LD C, A
 265+ 9F33 32 E4 82         LD (PlayerDrawY), A         ; default: sin offset
 266+ 9F36 B7               OR A
 267+ 9F37 C8               RET Z
 268+ 9F38 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 269+ 9F39 CD CD D5         CALL IsPointBlocked
 270+ 9F3C C8               RET Z                       ; libre → sin offset
 271+ 9F3D 3A A7 81         LD A, (EntityTable + ENT_POSY)
 272+ 9F40 3C               INC A
 273+ 9F41 32 E4 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 274+ 9F44 C9               RET
 275+ 9F45
 276+ 9F45              ; ==============================================================================
 277+ 9F45              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 278+ 9F45              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 279+ 9F45              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 280+ 9F45              ; no parecer que se hunde en el techo.
 281+ 9F45              ; Preserva: IX. Destruye: AF, BC.
 282+ 9F45              ; ==============================================================================
 283+ 9F45              ComputeEnemyDrawY:
 284+ 9F45 DD 7E 04         LD A, (IX+ENT_POSY)
 285+ 9F48 32 E5 82         LD (EnemyDrawY), A          ; default = POSY
 286+ 9F4B DD 7E 01         LD A, (IX+ENT_TYPE)
 287+ 9F4E FE 02            CP TYPE_MONSTER
 288+ 9F50 C0               RET NZ                      ; no monster → sin offset
 289+ 9F51 DD 7E 03         LD A, (IX+ENT_POSX)
 290+ 9F54 C6 08            ADD A, 8                    ; center X
 291+ 9F56 47               LD B, A
 292+ 9F57 DD 7E 04         LD A, (IX+ENT_POSY)
 293+ 9F5A 4F               LD C, A
 294+ 9F5B B7               OR A
 295+ 9F5C C8               RET Z
 296+ 9F5D 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 297+ 9F5E CD CD D5         CALL IsPointBlocked
 298+ 9F61 C8               RET Z                       ; libre → sin offset
 299+ 9F62 DD 7E 04         LD A, (IX+ENT_POSY)
 300+ 9F65 3C               INC A
 301+ 9F66 32 E5 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 302+ 9F69 C9               RET
 303+ 9F6A
 304+ 9F6A              ; ==============================================================================
 305+ 9F6A              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 306+ 9F6A              ; ==============================================================================
 307+ 9F6A              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 308+ 9F6A              ; ==============================================================================
 309+ 9F6A              ProcessPlayer:
 310+ 9F6A DD 21 A3 81      LD IX, EntityTable
 311+ 9F6E
 312+ 9F6E                  ; --- Fresh check ---
 313+ 9F6E 3A 1A 83         LD A, (ScreenJustRedrawn)
 314+ 9F71 B7               OR A
 315+ 9F72 C2 3E A0         JP NZ, .plFresh
 316+ 9F75 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 317+ 9F79 C2 3E A0         JP NZ, .plFresh
 318+ 9F7C
 319+ 9F7C                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 320+ 9F7C                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 321+ 9F7C                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 322+ 9F7C                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 323+ 9F7C                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 324+ 9F7C                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 325+ 9F7C                  ; y UpdatePlayerAnimation lo sobrescribiria.
 326+ 9F7C 3A EF 82         LD A, (DeathBorderPhase)
 327+ 9F7F B7               OR A
 328+ 9F80 20 0A            JR NZ, .plSkipUpdate
 329+ 9F82 3A F3 82         LD A, (PlayerRespawnPhase)
 330+ 9F85 FE 01            CP 1
 331+ 9F87 28 03            JR Z, .plSkipUpdate
 332+ 9F89 CD 94 A5         CALL UpdatePlayer
 333+ 9F8C              .plSkipUpdate:
 334+ 9F8C CD AD A4         CALL CalcDrawX
 335+ 9F8F CD 17 9F         CALL ComputePlayerDrawY
 336+ 9F92
 337+ 9F92                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 338+ 9F92 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 339+ 9F95 DD BE 0C         CP (IX+ENT_OLDX)
 340+ 9F98 20 3C            JR NZ, .plDoErase
 341+ 9F9A 3A E4 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 342+ 9F9D DD BE 0D         CP (IX+ENT_OLDY)
 343+ 9FA0 20 34            JR NZ, .plDoErase
 344+ 9FA2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 345+ 9FA5 DD BE 0E         CP (IX+ENT_OLDSPRID)
 346+ 9FA8 20 2C            JR NZ, .plDoErase
 347+ 9FAA                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 348+ 9FAA 3A 35 C5         LD A, (PlayerHitTimer)
 349+ 9FAD B7               OR A
 350+ 9FAE 20 01            JR NZ, .plRepaintAttr
 351+ 9FB0 C9               RET                                 ; Nada cambio → skip todo
 352+ 9FB1              .plRepaintAttr:
 353+ 9FB1 3A E4 82         LD A, (PlayerDrawY)
 354+ 9FB4 57               LD D, A
 355+ 9FB5 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 356+ 9FB8 5F               LD E, A
 357+ 9FB9 DD E5            PUSH IX
 358+ 9FBB CD F2 A4         CALL GetSpriteAddr
 359+ 9FBE DD 2A 21 A5      LD IX, (SpriteAddrTemp)
 360+ 9FC2 CD 0C 9B         CALL CalcEntityAttrSize
 361+ 9FC5 DD E1            POP IX
 362+ 9FC7 3A E4 82         LD A, (PlayerDrawY)
 363+ 9FCA 57               LD D, A
 364+ 9FCB DD 7E 0F         LD A, (IX+ENT_DRAWX)
 365+ 9FCE 5F               LD E, A
 366+ 9FCF DD 7E 05         LD A, (IX+ENT_ATTR)
 367+ 9FD2 CD DF 9A         CALL SetEntityAttr
 368+ 9FD5 C9               RET
 369+ 9FD6
 370+ 9FD6              .plDoErase:
 371+ 9FD6                  ; --- Erase viejo ---
 372+ 9FD6 CD 23 A5         CALL GetOldSpriteAddr
 373+ 9FD9 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 374+ 9FDC DD 7E 0C         LD A, (IX+ENT_OLDX)
 375+ 9FDF 5F               LD E, A
 376+ 9FE0 DD E5            PUSH IX
 377+ 9FE2 DD 2A AB A4      LD IX, (OldSprAddr)
 378+ 9FE6 CD EF 99         CALL DrawSprite
 379+ 9FE9 DD E1            POP IX
 380+ 9FEB                  ; Restaurar atributos del fondo en posicion vieja
 381+ 9FEB DD 56 0D         LD D, (IX+ENT_OLDY)
 382+ 9FEE DD 5E 0C         LD E, (IX+ENT_OLDX)
 383+ 9FF1 CD 5D D3         CALL RestoreOldAttr
 384+ 9FF4                  ; --- Draw nuevo ---
 385+ 9FF4 CD F2 A4         CALL GetSpriteAddr
 386+ 9FF7 3A E4 82         LD A, (PlayerDrawY)
 387+ 9FFA 57               LD D, A
 388+ 9FFB DD 7E 0F         LD A, (IX+ENT_DRAWX)
 389+ 9FFE 5F               LD E, A
 390+ 9FFF DD E5            PUSH IX
 391+ A001 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
 392+ A005 CD EF 99         CALL DrawSprite
 393+ A008 DD E1            POP IX
 394+ A00A
 395+ A00A                  ; Pintar attr
 396+ A00A 3A E4 82         LD A, (PlayerDrawY)
 397+ A00D 57               LD D, A
 398+ A00E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 399+ A011 5F               LD E, A
 400+ A012 DD E5            PUSH IX
 401+ A014 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
 402+ A018 CD 0C 9B         CALL CalcEntityAttrSize
 403+ A01B DD E1            POP IX
 404+ A01D 3A E4 82         LD A, (PlayerDrawY)
 405+ A020 57               LD D, A
 406+ A021 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 407+ A024 5F               LD E, A
 408+ A025 DD 7E 05         LD A, (IX+ENT_ATTR)
 409+ A028 CD DF 9A         CALL SetEntityAttr
 410+ A02B
 411+ A02B                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 412+ A02B              .plSaveOld:
 413+ A02B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 414+ A02E DD 77 0C         LD (IX+ENT_OLDX), A
 415+ A031 3A E4 82         LD A, (PlayerDrawY)
 416+ A034 DD 77 0D         LD (IX+ENT_OLDY), A
 417+ A037 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 418+ A03A DD 77 0E         LD (IX+ENT_OLDSPRID), A
 419+ A03D C9               RET
 420+ A03E
 421+ A03E                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 422+ A03E              .plFresh:
 423+ A03E DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 424+ A042 CD 94 A5         CALL UpdatePlayer
 425+ A045 CD AD A4         CALL CalcDrawX
 426+ A048 CD 17 9F         CALL ComputePlayerDrawY
 427+ A04B CD F2 A4         CALL GetSpriteAddr
 428+ A04E
 429+ A04E 3A E4 82         LD A, (PlayerDrawY)
 430+ A051 57               LD D, A
 431+ A052 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 432+ A055 5F               LD E, A
 433+ A056 DD E5            PUSH IX
 434+ A058 DD 2A 21 A5      LD IX, (SpriteAddrTemp)
 435+ A05C CD 0C 9B         CALL CalcEntityAttrSize
 436+ A05F DD E1            POP IX
