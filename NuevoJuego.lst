2358+ D8C1                  ; Reset frame counter, decrementar toggles
2359+ D8C1 3E 03            LD A, PICKUP_FLASH_PERIOD
2360+ D8C3 32 DB 82         LD (PickupFlashFrames), A
2361+ D8C6 3A DA 82         LD A, (PickupFlashToggles)
2362+ D8C9 3D               DEC A
2363+ D8CA 32 DA 82         LD (PickupFlashToggles), A
