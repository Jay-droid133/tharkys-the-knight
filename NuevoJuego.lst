# file opened: day_cycle.asm
   1+ E2D3              ; ==============================================================================
   2+ E2D3              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E2D3              ; ==============================================================================
   4+ E2D3              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E2D3              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E2D3              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E2D3              ; ==============================================================================
   8+ E2D3
   9+ E2D3              ; --- Constantes ---
  10+ E2D3              NUM_TIME_MOMENTS    EQU 7
  11+ E2D3
  12+ E2D3              ; --- Variables ---
  13+ E2D3 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E2D4 6F E7        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E2D6 6F E7        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E2D8 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E2D9 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E2DA 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E2DB
  20+ E2DB              ; ==============================================================================
  21+ E2DB              ; SetTimeOfDay - Cambia el momento del dia
  22+ E2DB              ; ==============================================================================
  23+ E2DB              ; Entrada: A = momento (0-6)
  24+ E2DB              ; ==============================================================================
  25+ E2DB              SetTimeOfDay:
  26+ E2DB 32 D3 E2         LD (CurrentTimeOfDay), A
  27+ E2DE
  28+ E2DE                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E2DE FE 04            CP 4
  30+ E2E0 20 06            JR NZ, .notNewCycle
  31+ E2E2 21 F0 BC         LD HL, DayCycleCount
  32+ E2E5 34               INC (HL)
  33+ E2E6 18 04            JR .skipBellsReset
  34+ E2E8              .notNewCycle:
  35+ E2E8                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E2E8                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E2E8                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E2E8 AF               XOR A
  39+ E2E9 32 B9 82         LD (BellsTriggered), A
  40+ E2EC              .skipBellsReset:
  41+ E2EC 3A D3 E2         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E2EF
  43+ E2EF                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E2EF FE 04            CP 4
  45+ E2F1 28 24            JR Z, .bellsFirst
  46+ E2F3
  47+ E2F3                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E2F3 FE 05            CP 5
  49+ E2F5 20 0D            JR NZ, .noScareMon
  50+ E2F7 CD 0A BD         CALL ScareAllMonsters
  51+ E2FA CD 88 FA         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E2FD                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E2FD                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E2FD                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E2FD                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E2FD 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E2FF CD BD 99         CALL StartMusic
  58+ E302 18 07            JR .noKillMon
  59+ E304              .noScareMon:
  60+ E304                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E304 FE 06            CP 6
  62+ E306 20 03            JR NZ, .noKillMon
  63+ E308 CD 93 BC         CALL KillAllActiveMonsters
  64+ E30B              .noKillMon:
  65+ E30B
  66+ E30B                  ; Actualizar tablas de remap y tabla de nasties
  67+ E30B CD 40 E3         CALL UpdateRemapTables
  68+ E30E CD F3 BC         CALL UpdateNastyTable
  69+ E311
  70+ E311                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E311 3E 01            LD A, 1
  72+ E313 32 14 83         LD (AttrsDirty), A
  73+ E316 C9               RET
  74+ E317
  75+ E317              .bellsFirst:
  76+ E317                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E317                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E317                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E317                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E317                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E317 CD F3 BC         CALL UpdateNastyTable
  82+ E31A                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E31A                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E31A 3A B9 82         LD A, (BellsTriggered)
  85+ E31D B7               OR A
  86+ E31E C0               RET NZ
  87+ E31F 3E 01            LD A, 1
  88+ E321 32 B9 82         LD (BellsTriggered), A
  89+ E324 CD FE F9         CALL StartBellChimes
  90+ E327 C9               RET
  91+ E328
  92+ E328              ; ==============================================================================
  93+ E328              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E328              ; ==============================================================================
  95+ E328              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E328              ;   - Salta reloj a 00:00.
  97+ E328              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E328              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E328              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E328              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E328              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E328              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E328              ;     pero ya esta en N2 -> no-op visual.
 104+ E328              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E328              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E328              ;
 107+ E328              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E328              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E328              ; aqui no re-dispara nada.
 110+ E328              ; ==============================================================================
 111+ E328              TriggerChurchMidnight:
 112+ E328 3A B9 82         LD A, (BellsTriggered)
 113+ E32B B7               OR A
 114+ E32C C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E32D 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E32F CD 1F EB         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E332 3E 04            LD A, 4
 118+ E334 CD DB E2         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E337                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E337                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E337                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E337 CD 40 E3         CALL UpdateRemapTables
 123+ E33A 3E 01            LD A, 1
 124+ E33C 32 14 83         LD (AttrsDirty), A
 125+ E33F C9               RET
 126+ E340
 127+ E340              ; ==============================================================================
 128+ E340              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 129+ E340              ; ==============================================================================
 130+ E340              UpdateRemapTables:
 131+ E340 3A D3 E2         LD A, (CurrentTimeOfDay)
 132+ E343 21 43 E7         LD HL, RemapTablePtrs
 133+ E346 5F               LD E, A
 134+ E347 16 00            LD D, 0
 135+ E349 19               ADD HL, DE
 136+ E34A 19               ADD HL, DE
 137+ E34B 5E               LD E, (HL)
 138+ E34C 23               INC HL
 139+ E34D 56               LD D, (HL)
 140+ E34E ED 53 D4 E2      LD (CurrentRemapTable), DE
 141+ E352
 142+ E352 3A D3 E2         LD A, (CurrentTimeOfDay)
 143+ E355 21 51 E7         LD HL, RemapHouseTablePtrs
 144+ E358 5F               LD E, A
 145+ E359 16 00            LD D, 0
 146+ E35B 19               ADD HL, DE
 147+ E35C 19               ADD HL, DE
 148+ E35D 5E               LD E, (HL)
 149+ E35E 23               INC HL
 150+ E35F 56               LD D, (HL)
 151+ E360 ED 53 D6 E2      LD (CurrentHouseRemapTable), DE
 152+ E364 C9               RET
 153+ E365
 154+ E365              ; ==============================================================================
 155+ E365              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E365              ; ==============================================================================
 157+ E365              CheckDebugKeys:
 158+ E365 3E FB            LD A, $FB
 159+ E367 DB FE            IN A, ($FE)
 160+ E369 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E36B 20 1C            JR NZ, .notPressed
 162+ E36D
 163+ E36D                  ; Tecla pulsada: comprobar debounce
 164+ E36D 3A DA E2         LD A, (DebugKeyDebounce)
 165+ E370 B7               OR A
 166+ E371 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E372
 168+ E372                  ; Primera pulsacion: ciclar
 169+ E372 3E 01            LD A, 1
 170+ E374 32 DA E2         LD (DebugKeyDebounce), A
 171+ E377
 172+ E377 3A D3 E2         LD A, (CurrentTimeOfDay)
 173+ E37A 3C               INC A
 174+ E37B FE 07            CP NUM_TIME_MOMENTS
 175+ E37D 38 01            JR C, .noWrap
 176+ E37F AF               XOR A                   ; Volver a 0 (Dia)
 177+ E380              .noWrap:
 178+ E380 F5               PUSH AF
 179+ E381 CD DB E2         CALL SetTimeOfDay
 180+ E384 F1               POP AF
 181+ E385 CD 1F EB         CALL SetClockToPhaseHour
 182+ E388 C9               RET
 183+ E389
 184+ E389              .notPressed:
 185+ E389 AF               XOR A
 186+ E38A 32 DA E2         LD (DebugKeyDebounce), A
 187+ E38D
 188+ E38D                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E38D 3E FD            LD A, $FD
 190+ E38F DB FE            IN A, ($FE)
 191+ E391 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E392 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E394 20 13            JR NZ, .sNotPressed
 194+ E396 3A E4 E3         LD A, (SpeedKeyDebounce)
 195+ E399 B7               OR A
 196+ E39A C0               RET NZ
 197+ E39B 3E 01            LD A, 1
 198+ E39D 32 E4 E3         LD (SpeedKeyDebounce), A
 199+ E3A0 21 F0 BC         LD HL, DayCycleCount
 200+ E3A3 7E               LD A, (HL)
 201+ E3A4 FE 0A            CP 10
 202+ E3A6 D0               RET NC                  ; Ya en maximo
 203+ E3A7 34               INC (HL)
 204+ E3A8 C9               RET
 205+ E3A9              .sNotPressed:
 206+ E3A9                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E3A9 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E3AB 20 13            JR NZ, .dNotPressed
 209+ E3AD 3A E4 E3         LD A, (SpeedKeyDebounce)
 210+ E3B0 B7               OR A
 211+ E3B1 C0               RET NZ
 212+ E3B2 3E 01            LD A, 1
 213+ E3B4 32 E4 E3         LD (SpeedKeyDebounce), A
 214+ E3B7 21 F0 BC         LD HL, DayCycleCount
 215+ E3BA 7E               LD A, (HL)
 216+ E3BB FE 01            CP 1
 217+ E3BD C8               RET Z                   ; Ya en minimo
 218+ E3BE 35               DEC (HL)
 219+ E3BF C9               RET
 220+ E3C0              .dNotPressed:
 221+ E3C0 AF               XOR A
 222+ E3C1 32 E4 E3         LD (SpeedKeyDebounce), A
 223+ E3C4
 224+ E3C4                  ; --- Tecla N: togglea NoclipMode (debug) ---
 225+ E3C4 3E 7F            LD A, $7F
 226+ E3C6 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 227+ E3C8 CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 228+ E3CA 20 13            JR NZ, .nNotPressed
 229+ E3CC 3A E5 E3         LD A, (NoclipKeyDebounce)
 230+ E3CF B7               OR A
 231+ E3D0 C0               RET NZ
 232+ E3D1 3E 01            LD A, 1
 233+ E3D3 32 E5 E3         LD (NoclipKeyDebounce), A
 234+ E3D6 3A B0 82         LD A, (NoclipMode)
 235+ E3D9 EE 01            XOR 1
 236+ E3DB 32 B0 82         LD (NoclipMode), A
 237+ E3DE C9               RET
 238+ E3DF              .nNotPressed:
 239+ E3DF AF               XOR A
 240+ E3E0 32 E5 E3         LD (NoclipKeyDebounce), A
 241+ E3E3 C9               RET
 242+ E3E4
 243+ E3E4 00           SpeedKeyDebounce: DEFB 0
 244+ E3E5 00           NoclipKeyDebounce: DEFB 0
 245+ E3E6
 246+ E3E6              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 247+ E3E6              DrawSwordModeHUD:
 248+ E3E6 3A 54 B3         LD A, (SwordMode)
 249+ E3E9 21 19 E4         LD HL, .modeChars
 250+ E3EC 5F               LD E, A
 251+ E3ED 16 00            LD D, 0
 252+ E3EF 19               ADD HL, DE
 253+ E3F0 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E3F1                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E3F1 21 00 40         LD HL, $4000
 256+ E3F4                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E3F4 5F               LD E, A
 258+ E3F5 16 00            LD D, 0
 259+ E3F7 42               LD B, D                             ; B = 0
 260+ E3F8 CB 23            SLA E
 260+ E3FA CB 12          RL D                        ; *2
 261+ E3FC CB 23            SLA E
 261+ E3FE CB 12          RL D                        ; *4
 262+ E400 CB 23            SLA E
 262+ E402 CB 12          RL D                        ; *8
 263+ E404 E5               PUSH HL
 264+ E405 21 00 3C         LD HL, $3C00
 265+ E408 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E409 EB               EX DE, HL                           ; DE = glyph
 267+ E40A E1               POP HL                              ; HL = VRAM
 268+ E40B 06 08            LD B, 8
 269+ E40D              .drawChar:
 270+ E40D 1A               LD A, (DE)
 271+ E40E 77               LD (HL), A
 272+ E40F 13               INC DE
 273+ E410 24               INC H                               ; siguiente scan line
 274+ E411 10 FA            DJNZ .drawChar
 275+ E413                  ; Attr: fila 0, col 0 = $5800
 276+ E413 3E 47            LD A, $47                           ; blanco bright
 277+ E415 32 00 58         LD ($5800), A
 278+ E418 C9               RET
 279+ E419
 280+ E419 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 281+ E41C
 282+ E41C              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 283+ E41C              DrawNoclipHUD:
 284+ E41C 3A B0 82         LD A, (NoclipMode)
 285+ E41F B7               OR A
 286+ E420 20 0E            JR NZ, .ncOn
 287+ E422 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 288+ E424 1E 1E            LD E, 30
 289+ E426 CD 51 E6         CALL DrawHudChar
 290+ E429 3E 20            LD A, 32
 291+ E42B 1E 1F            LD E, 31
 292+ E42D C3 51 E6         JP DrawHudChar
 293+ E430              .ncOn:
 294+ E430 3E 4E            LD A, 'N'
 295+ E432 1E 1E            LD E, 30
 296+ E434 CD 51 E6         CALL DrawHudChar
 297+ E437 3E 43            LD A, 'C'
 298+ E439 1E 1F            LD E, 31
 299+ E43B C3 51 E6         JP DrawHudChar
