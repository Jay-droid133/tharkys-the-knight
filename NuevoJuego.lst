 547+ E81F CD 00 EA         CALL SFX_TownGate_OnCredits
 548+ E822 3E 0F            LD A, TGP_CREDITS
 549+ E824 32 C1 82         LD (TownGatePhase), A
 550+ E827 C9               RET
