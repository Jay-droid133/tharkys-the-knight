1500+ 947C              ; ==============================================================================
1501+ 947C              ; UpdatePlayerAnimation - Animacion por SpriteID
1502+ 947C              ; ==============================================================================
1503+ 947C              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
1504+ 947C              ; ==============================================================================
1505+ 947C              UpdatePlayerAnimation:
1506+ 947C                  ; Determinar animacion segun estado y direccion
1507+ 947C DD 7E 02         LD A, (IX+ENT_STATE)
1508+ 947F FE 02            CP STATE_FIGHTING
1509+ 9481 28 0C            JR Z, .animFight
1510+ 9483 FE 01            CP STATE_RUNNING
1511+ 9485 28 21            JR Z, .animRun
1512+ 9487
1513+ 9487                  ; --- IDLE ---
1514+ 9487 16 00            LD D, SPRID_IDLE
1515+ 9489 1E 02            LD E, ANIM_FRAMES_IDLE
1516+ 948B 0E 14            LD C, ANIM_DELAY_IDLE
1517+ 948D 18 44            JR .applyAnim
1518+ 948F
1519+ 948F              .animFight:
1520+ 948F                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1521+ 948F DD 7E 0A         LD A, (IX+ENT_DIR)
1522+ 9492 0F               RRCA
1523+ 9493 0F               RRCA
1524+ 9494 0F               RRCA
1525+ 9495 0F               RRCA
1526+ 9496 E6 0F            AND $0F                     ; lastHDir
1527+ 9498 FE 08            CP DIR_W
1528+ 949A 28 04            JR Z, .fightW
1529+ 949C 16 16            LD D, SPRID_ATTACK_EAST
1530+ 949E 18 02            JR .fightSet
1531+ 94A0              .fightW:
1532+ 94A0 16 1B            LD D, SPRID_ATTACK_WEST
1533+ 94A2              .fightSet:
1534+ 94A2 1E 05            LD E, ANIM_FRAMES_FIGHT
1535+ 94A4 0E 02            LD C, ANIM_DELAY_FIGHT
1536+ 94A6 18 2B            JR .applyAnim
1537+ 94A8
1538+ 94A8              .animRun:
1539+ 94A8 DD 7E 0A         LD A, (IX+ENT_DIR)
1540+ 94AB E6 0F            AND $0F                     ; dir actual
1541+ 94AD                  ; Prioridad: E/W sobre N/S
1542+ 94AD CB 57            BIT 2, A
1543+ 94AF 20 0C            JR NZ, .runE
1544+ 94B1 CB 5F            BIT 3, A
1545+ 94B3 20 10            JR NZ, .runW
1546+ 94B5 CB 47            BIT 0, A
1547+ 94B7 20 14            JR NZ, .runN
1548+ 94B9 16 0E            LD D, SPRID_WALK_S
1549+ 94BB 18 12            JR .runSet
1550+ 94BD              .runE:
1551+ 94BD 16 02            LD D, SPRID_WALK_E
1552+ 94BF 1E 04            LD E, 4
1553+ 94C1 0E 04            LD C, ANIM_DELAY_RUN
1554+ 94C3 18 0E            JR .applyAnim
1555+ 94C5              .runW:
1556+ 94C5 16 06            LD D, SPRID_WALK_W
1557+ 94C7 1E 04            LD E, 4
1558+ 94C9 0E 04            LD C, ANIM_DELAY_RUN
1559+ 94CB 18 06            JR .applyAnim
1560+ 94CD              .runN:
1561+ 94CD 16 0A            LD D, SPRID_WALK_N
1562+ 94CF              .runSet:
1563+ 94CF 1E 03            LD E, ANIM_FRAMES_WALK
1564+ 94D1 0E 04            LD C, ANIM_DELAY_RUN
1565+ 94D3
1566+ 94D3              .applyAnim:
1567+ 94D3                  ; D = nuevo AnimBase, E = num frames, C = delay
1568+ 94D3                  ; Boost animacion: reducir delay segun nastis activos (mismo criterio que velocidad)
1569+ 94D3                  ; Boost animacion: reducir delay segun enemigos activos
1570+ 94D3                  ; Nasties: boost desde 2+. Monsters: boost desde 3+ (un grado menos)
1571+ 94D3 C5               PUSH BC
1572+ 94D4 D5               PUSH DE
1573+ 94D5 CD CD A0         CALL CountActiveNasties         ; A = nastis activos
1574+ 94D8 D1               POP DE
1575+ 94D9 C1               POP BC
