2186+ AAC4 4F               LD C, A
2187+ AAC5 3A A1 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2188+ AAC8 B9               CP C                                ; playerX < wellRight+margen?
2189+ AAC9 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2190+ AACB 3A A1 81         LD A, (EntityTable + ENT_POSX)
2191+ AACE C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2192+ AAD0 4F               LD C, A
2193+ AAD1 3A 5B 8D         LD A, (WellPosX)                    ; A = wellX
2194+ AAD4 B9               CP C                                ; wellX < playerRight+margen?
2195+ AAD5 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2196+ AAD7                  ; --- Check Y ---
2197+ AAD7 3A 5C 8D         LD A, (WellPosY)
2198+ AADA C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2199+ AADC 4F               LD C, A
2200+ AADD 3A A2 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2201+ AAE0 B9               CP C                                ; playerY < wellBottom+margen?
2202+ AAE1 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2203+ AAE3 3A A2 81         LD A, (EntityTable + ENT_POSY)
2204+ AAE6 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2205+ AAE8 4F               LD C, A
2206+ AAE9 3A 5C 8D         LD A, (WellPosY)                    ; A = wellY
2207+ AAEC B9               CP C                                ; wellY < playerBottom+margen?
2208+ AAED 30 18            JR NC, .cwNoOverlap                 ; no → fuera
