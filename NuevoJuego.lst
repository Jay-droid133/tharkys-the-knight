   1+ A0A0              ; ==============================================================================
   2+ A0A0              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A0A0              ; ==============================================================================
   4+ A0A0              ; - Estructura de entidad de 12 bytes (universal)
   5+ A0A0              ; - Game loop per-entity: erase → update → draw
   6+ A0A0              ; - Movimiento 8-bit (sin subpixel)
   7+ A0A0              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A0A0              ; - XOR draw/erase (una sola rutina)
   9+ A0A0              ; ==============================================================================
  10+ A0A0
  11+ A0A0              ; ==============================================================================
  12+ A0A0              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A0A0              ; ==============================================================================
  14+ A0A0              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A0A0              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A0A0              ; ==============================================================================
  17+ A0A0              ReadInput:
  18+ A0A0 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A0A2 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A0A4
  21+ A0A4                  ; -- 1. QAOP --
  22+ A0A4 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A0A7 ED 78            IN A, (C)
  24+ A0A9 CB 47            BIT 0, A            ; Q = Arriba
  25+ A0AB 20 02            JR NZ, .no_q
  26+ A0AD CB C2            SET 0, D
  27+ A0AF              .no_q:
  28+ A0AF 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A0B2 ED 78            IN A, (C)
  30+ A0B4 CB 47            BIT 0, A            ; A = Abajo
  31+ A0B6 20 02            JR NZ, .no_a
  32+ A0B8 CB CA            SET 1, D
  33+ A0BA              .no_a:
  34+ A0BA 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A0BD ED 78            IN A, (C)
  36+ A0BF CB 4F            BIT 1, A            ; O = Izquierda
  37+ A0C1 20 02            JR NZ, .no_o
  38+ A0C3 CB DA            SET 3, D
  39+ A0C5              .no_o:
  40+ A0C5 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A0C7 20 02            JR NZ, .no_p
  42+ A0C9 CB D2            SET 2, D
  43+ A0CB              .no_p:
  44+ A0CB
  45+ A0CB                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A0CB                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A0CB DB 1F            IN A, (31)
  48+ A0CD 4F               LD C, A             ; guardar para fire
  49+ A0CE CB 5F            BIT 3, A            ; Up
  50+ A0D0 28 02            JR Z, .no_k_up
  51+ A0D2 CB C2            SET 0, D
  52+ A0D4              .no_k_up:
  53+ A0D4 CB 57            BIT 2, A            ; Down
  54+ A0D6 28 02            JR Z, .no_k_down
  55+ A0D8 CB CA            SET 1, D
  56+ A0DA              .no_k_down:
  57+ A0DA CB 4F            BIT 1, A            ; Left
  58+ A0DC 28 02            JR Z, .no_k_left
  59+ A0DE CB DA            SET 3, D
  60+ A0E0              .no_k_left:
  61+ A0E0 CB 47            BIT 0, A            ; Right
  62+ A0E2 28 02            JR Z, .no_k_right
  63+ A0E4 CB D2            SET 2, D
  64+ A0E6              .no_k_right:
  65+ A0E6 CB 61            BIT 4, C            ; Kempston Fire
  66+ A0E8 28 02            JR Z, .no_k_fire
  67+ A0EA CB C3            SET 0, E
  68+ A0EC              .no_k_fire:
  69+ A0EC
  70+ A0EC                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A0EC                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A0EC 01 FE F7         LD BC, $F7FE
  73+ A0EF ED 78            IN A, (C)
  74+ A0F1 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A0F3 20 02            JR NZ, .no_s1_up
  76+ A0F5 CB C2            SET 0, D
  77+ A0F7              .no_s1_up:
  78+ A0F7 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A0F9 20 02            JR NZ, .no_s1_down
  80+ A0FB CB CA            SET 1, D
  81+ A0FD              .no_s1_down:
  82+ A0FD CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A0FF 20 02            JR NZ, .no_s1_left
  84+ A101 CB DA            SET 3, D
  85+ A103              .no_s1_left:
  86+ A103 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A105 20 02            JR NZ, .no_s1_right
  88+ A107 CB D2            SET 2, D
  89+ A109              .no_s1_right:
  90+ A109 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A10B 20 02            JR NZ, .no_s1_fire
  92+ A10D CB C3            SET 0, E
  93+ A10F              .no_s1_fire:
  94+ A10F
  95+ A10F                  ; -- 4. SPACE = Fire (teclado) --
  96+ A10F 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A112 ED 78            IN A, (C)
  98+ A114 CB 47            BIT 0, A            ; SPACE
  99+ A116 20 02            JR NZ, .no_space
 100+ A118 CB C3            SET 0, E
 101+ A11A              .no_space:
 102+ A11A
 103+ A11A                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A11A 7B               LD A, E
 105+ A11B 32 AC 82         LD (InputFire), A
 106+ A11E
 107+ A11E                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ A11E 21 DA 82         LD HL, MushroomLockTimer
 109+ A121 7E               LD A, (HL)
 110+ A122 23               INC HL
 111+ A123 B6               OR (HL)
 112+ A124 28 21            JR Z, .noMushLock
 113+ A126 AF               XOR A
 114+ A127 32 AC 82         LD (InputFire), A
 115+ A12A                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ A12A                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ A12A 7B               LD A, E
 118+ A12B B7               OR A
 119+ A12C 28 15            JR Z, .resetNoSwordFlag
 120+ A12E 3A B5 82         LD A, (NoSwordSoundFlag)
 121+ A131 B7               OR A
 122+ A132 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ A134 3E 01            LD A, 1
 124+ A136 32 B5 82         LD (NoSwordSoundFlag), A
 125+ A139 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ A13A 21 5C FA         LD HL, SFX_NoSwordError
 127+ A13D CD 23 F9         CALL PlaySFX
 128+ A140 D1               POP DE
 129+ A141 18 04            JR .noMushLock
 130+ A143              .resetNoSwordFlag:
 131+ A143 AF               XOR A
 132+ A144 32 B5 82         LD (NoSwordSoundFlag), A
 133+ A147              .noMushLock:
 134+ A147
 135+ A147                  ; -- 6. Cancelar opuestos --
 136+ A147 7A               LD A, D
 137+ A148 47               LD B, A
 138+ A149 E6 03            AND DIR_N | DIR_S
 139+ A14B FE 03            CP DIR_N | DIR_S
 140+ A14D 20 04            JR NZ, .noVC
 141+ A14F 78               LD A, B
 142+ A150 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ A152 47               LD B, A
 144+ A153              .noVC:
 145+ A153 78               LD A, B
 146+ A154 E6 0C            AND DIR_E | DIR_W
 147+ A156 FE 0C            CP DIR_E | DIR_W
 148+ A158 20 04            JR NZ, .noHC
 149+ A15A 78               LD A, B
 150+ A15B E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ A15D 47               LD B, A
 152+ A15E              .noHC:
 153+ A15E 78               LD A, B
 154+ A15F 32 AB 82         LD (InputDirection), A
 155+ A162 C9               RET
