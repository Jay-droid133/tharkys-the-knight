 195+ EB2F              ; ==============================================================================
 196+ EB2F              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EB2F              ; ==============================================================================
 198+ EB2F              DrawClockHUD:
 199+ EB2F                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EB2F                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EB2F                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EB2F                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EB2F                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EB2F                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EB2F 3A B3 82         LD A, (TimeFrozen)
 206+ EB32 FE 01            CP 1
 207+ EB34 20 07            JR NZ, .clkDrawNormal
 208+ EB36 3A 98 81         LD A, (GameFrameCounter)
 209+ EB39 E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EB3B 28 2D            JR Z, .clkBlinkOff
 211+ EB3D              .clkDrawNormal:
 212+ EB3D CD 78 EB         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EB40
 214+ EB40                  ; --- Aguja de horas ---
 215+ EB40 3A 38 E9         LD A, (GameHours)
 216+ EB43 FE 0C            CP 12
 217+ EB45 38 02            JR C, .hourOk
 218+ EB47 D6 0C            SUB 12
 219+ EB49              .hourOk:
 220+ EB49 21 34 EA         LD HL, HourHandPtrs
 221+ EB4C CD 4E ED         CALL DrawHandLine
