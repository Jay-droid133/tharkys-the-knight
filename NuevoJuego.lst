 188+ E440                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E440 3E FD            LD A, $FD
 190+ E442 DB FE            IN A, ($FE)
 191+ E444 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E445 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E447 20 13            JR NZ, .sNotPressed
 194+ E449 3A 97 E4         LD A, (SpeedKeyDebounce)
 195+ E44C B7               OR A
 196+ E44D C0               RET NZ
 197+ E44E 3E 01            LD A, 1
