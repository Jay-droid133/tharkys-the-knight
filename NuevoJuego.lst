6884+ C55F              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6885+ C55F              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6886+ C55F              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6887+ C55F              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6888+ C55F              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6889+ C55F              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6890+ C55F              DeathGhostChase:
6891+ C55F                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6892+ C55F 3A 97 81         LD A, (EntityTable + ENT_POSX)
6893+ C562 DD 96 03         SUB (IX+ENT_POSX)
6894+ C565 30 02            JR NC, .udgAbsDxOk
6895+ C567 ED 44            NEG
6896+ C569              .udgAbsDxOk:
6897+ C569 47               LD B, A                             ; B = |dx|
6898+ C56A 3A 98 81         LD A, (EntityTable + ENT_POSY)
6899+ C56D DD 96 04         SUB (IX+ENT_POSY)
6900+ C570 30 02            JR NC, .udgAbsDyOk
6901+ C572 ED 44            NEG
6902+ C574              .udgAbsDyOk:
6903+ C574                  ; A = |dy|, B = |dx|
6904+ C574 B8               CP B
6905+ C575 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
