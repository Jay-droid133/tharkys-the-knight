 126+ E364                  ; queue empty?
 127+ E364 3A C8 5F         LD A, (MagicCompassBfsHead)
 128+ E367 47               LD B, A
 129+ E368 3A C9 5F         LD A, (MagicCompassBfsTail)
 130+ E36B B8               CP B
 131+ E36C CA 4F E4         JP Z, .cmcpNoPath
 132+ E36F
 133+ E36F                  ; Pop: read queue[tail*2] = (sid, comp); tail++
 134+ E36F 5F               LD E, A
 135+ E370 3C               INC A
 136+ E371 E6 3F            AND 63
 137+ E373 32 C9 5F         LD (MagicCompassBfsTail), A
 138+ E376 7B               LD A, E
 139+ E377 87               ADD A, A                             ; *2 (entries de 2 bytes)
 140+ E378 5F               LD E, A
 141+ E379 16 00            LD D, 0
 142+ E37B 21 00 5B         LD HL, MagicCompassBfsQueue
 143+ E37E 19               ADD HL, DE
 144+ E37F 7E               LD A, (HL)                           ; sid
 145+ E380 32 7E E5         LD (.cmcpR), A
 146+ E383 23               INC HL
 147+ E384 7E               LD A, (HL)
 148+ E385 32 7F E5         LD (.cmcpRComp), A
 149+ E388
 150+ E388                  ; Iterate RoomCompGaps[R]
 151+ E388 3A 7E E5         LD A, (.cmcpR)
 152+ E38B 6F               LD L, A
 153+ E38C 26 00            LD H, 0
 154+ E38E 29               ADD HL, HL                           ; *2 (DEFW ptrs)
 155+ E38F 11 77 60         LD DE, RoomCompGapsTable
 156+ E392 19               ADD HL, DE
 157+ E393 5E               LD E, (HL)
 158+ E394 23               INC HL
 159+ E395 56               LD D, (HL)                           ; DE = record ptr
 160+ E396 EB               EX DE, HL                            ; HL = record
 161+ E397
 162+ E397 7E               LD A, (HL)                           ; count
 163+ E398 B7               OR A
 164+ E399 CA 59 E3         JP Z, .cmcpLoop                      ; no gaps → next pop
 165+ E39C 47               LD B, A                              ; B = remaining count
 166+ E39D 23               INC HL                               ; HL @ first {side_comp, coord}
 167+ E39E
 168+ E39E              .cmcpGapLoop:
 169+ E39E                  ; Read side_comp byte
 170+ E39E 7E               LD A, (HL)
 171+ E39F 32 82 E5         LD (.cmcpGapSideComp), A
 172+ E3A2 23               INC HL
 173+ E3A3 7E               LD A, (HL)
 174+ E3A4 32 83 E5         LD (.cmcpGapCoord), A
 175+ E3A7 23               INC HL
 176+ E3A8 C5               PUSH BC                              ; save count
 177+ E3A9 E5               PUSH HL                              ; save record ptr
 178+ E3AA
 179+ E3AA                  ; Match comp?
 180+ E3AA 3A 82 E5         LD A, (.cmcpGapSideComp)
 181+ E3AD CB 3F            SRL A
 182+ E3AF CB 3F            SRL A                                ; A = comp (bits 2-3 → bits 0-1)
 183+ E3B1 E6 03            AND $03
 184+ E3B3 4F               LD C, A                              ; C = gap comp
 185+ E3B4 3A 7F E5         LD A, (.cmcpRComp)
 186+ E3B7 B9               CP C
 187+ E3B8 C2 46 E4         JP NZ, .cmcpGapNext
 188+ E3BB
 189+ E3BB                  ; Compute V = neighbor of R in gap.side
 190+ E3BB 3A 82 E5         LD A, (.cmcpGapSideComp)
 191+ E3BE E6 03            AND $03                              ; A = side
 192+ E3C0 4F               LD C, A                              ; C = side
 193+ E3C1 3A 7E E5         LD A, (.cmcpR)
 194+ E3C4 47               LD B, A                              ; B = R sid
 195+ E3C5 CD B6 E4         CALL .cmcpComputeNeighbor            ; IN: B=R, C=side; OUT: A=V (or $FF if invalid)
 196+ E3C8 FE FF            CP $FF
 197+ E3CA CA 46 E4         JP Z, .cmcpGapNext
 198+ E3CD 32 80 E5         LD (.cmcpV), A
 199+ E3D0
 200+ E3D0                  ; Find V's gap with side=opposite(gap.side) AND coord=gap.coord
 201+ E3D0 79               LD A, C                              ; side
 202+ E3D1 EE 01            XOR $01                              ; opposite (N↔S, W↔E using XOR 1 — N=0,S=1,W=2,E=3)
 203+ E3D3 4F               LD C, A                              ; C = opp_side
 204+ E3D4 3A 83 E5         LD A, (.cmcpGapCoord)
 205+ E3D7 47               LD B, A                              ; B = coord
 206+ E3D8 3A 80 E5         LD A, (.cmcpV)
 207+ E3DB CD E5 E4         CALL .cmcpFindMatchingGap            ; OUT: A = V_comp (0..2) or $FF if no match
 208+ E3DE FE FF            CP $FF
 209+ E3E0 CA 46 E4         JP Z, .cmcpGapNext
 210+ E3E3 32 81 E5         LD (.cmcpVComp), A
 211+ E3E6
 212+ E3E6                  ; Check V == current_sid AND V_comp == player_current_comp
 213+ E3E6 3A 80 E5         LD A, (.cmcpV)
 214+ E3E9 47               LD B, A
