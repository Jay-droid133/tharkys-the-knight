6991+ C5FD              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6992+ C5FD              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6993+ C5FD              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6994+ C5FD              ; timer >= DEATH_SPAWN_FRAMES).
6995+ C5FD              SpawnDeath:
6996+ C5FD                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6997+ C5FD                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6998+ C5FD                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6999+ C5FD                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
7000+ C5FD                  ; atravesando el mapa.
7001+ C5FD CD 32 94         CALL FindFarthestAnyFreeCell
7002+ C600 C8               RET Z                               ; sin candidato: reintento siguiente frame
7003+ C601              .sdHaveCell:
7004+ C601                  ; B = cx, C = cy
7005+ C601 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7006+ C605                  ; POSX = cx * 8
7007+ C605 78               LD A, B
7008+ C606 87               ADD A, A
7009+ C607 87               ADD A, A
7010+ C608 87               ADD A, A
7011+ C609 DD 77 03         LD (IX+ENT_POSX), A
7012+ C60C DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
7013+ C60F                  ; POSY = cy * 8 + SCREEN_MIN_Y
7014+ C60F 79               LD A, C
7015+ C610 87               ADD A, A
7016+ C611 87               ADD A, A
7017+ C612 87               ADD A, A
7018+ C613 C6 10            ADD A, SCREEN_MIN_Y
7019+ C615 DD 77 04         LD (IX+ENT_POSY), A
7020+ C618 DD 77 0D         LD (IX+ENT_OLDY), A
7021+ C61B                  ; Tipo / estado / sprite
7022+ C61B DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
7023+ C61F DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
7024+ C623 DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
7025+ C627 DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
7026+ C62B DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
7027+ C62F DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7028+ C633 DD 36 06 00      LD (IX+ENT_DELTAX), 0
7029+ C637 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7030+ C63B DD 36 0A 00      LD (IX+ENT_DIR), 0
