 505  EE70                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ EE70              ; ==============================================================================
   2+ EE70              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EE70              ; ==============================================================================
   4+ EE70              ; CurrentObjective vive en variables.asm. Valor:
   5+ EE70              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EE70              ;   11    = todos los hitos completados (juego ganado)
   7+ EE70              ;
   8+ EE70              ; ----------------------------------------------------------------------------
   9+ EE70              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EE70              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EE70              ;                       recoger el sprite cuyo behavior coincide.
  12+ EE70              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EE70              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EE70              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EE70              ;
  16+ EE70              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EE70              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EE70              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EE70              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EE70              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EE70              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EE70              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EE70              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EE70              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EE70              ;
  26+ EE70              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EE70              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EE70              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EE70              ;
  30+ EE70              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre.
  31+ EE70              ; Util para saltarse hitos durante test (incluido M#7 SPECIAL si quisieras
  32+ EE70              ; saltarte la cinematica de captura entera, aunque ya avanza solo desde
  33+ EE70              ; UpdatePostTrapPause.uptpKey al soltar el cheque).
  34+ EE70              ; ==============================================================================
  35+ EE70
  36+ EE70              MILESTONE_TYPE_PICKUP   EQU 1
  37+ EE70              MILESTONE_TYPE_TRIGGER  EQU 2
  38+ EE70              MILESTONE_TYPE_SPECIAL  EQU 3
  39+ EE70
  40+ EE70              MilestoneTable:
  41+ EE70 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EE72 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EE74 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EE76 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EE78 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EE7A 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EE7C 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EE7E                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EE7E                                                      ;    el cheque, no por tecla M en runtime)
  50+ EE7E 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EE80                                                      ;    ir a recogerlo tras drop de la
  52+ EE80                                                      ;    cinematica de la iglesia)
  53+ EE80 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EE82 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EE84 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EE86
  57+ EE86              MilestoneResolveTable:
  58+ EE86 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EE88 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EE8A 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EE8C 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EE8E 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EE90 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EE92 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ EE94 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  66+ EE96 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  67+ EE98 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  68+ EE9A 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  69+ EE9C
  70+ EE9C              ; ==============================================================================
  71+ EE9C              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  72+ EE9C              ; ==============================================================================
  73+ EE9C              ; IN:  A = key id (1..6) recien recogida
  74+ EE9C              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  75+ EE9C              ; ==============================================================================
  76+ EE9C              CheckMilestonePickup:
  77+ EE9C E5               PUSH HL
  78+ EE9D D5               PUSH DE
  79+ EE9E C5               PUSH BC
  80+ EE9F F5               PUSH AF
  81+ EEA0 47               LD B, A                             ; B = key id recibida
  82+ EEA1 3A BA 82         LD A, (CurrentObjective)
  83+ EEA4 FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  84+ EEA6 30 27            JR NC, .cmpDone                     ; sin hitos pendientes
  85+ EEA8 87               ADD A, A                            ; *2 (entry size)
  86+ EEA9 6F               LD L, A
  87+ EEAA 26 00            LD H, 0
  88+ EEAC 11 70 EE         LD DE, MilestoneTable
  89+ EEAF 19               ADD HL, DE
  90+ EEB0 7E               LD A, (HL)                          ; tipo
  91+ EEB1 FE 01            CP MILESTONE_TYPE_PICKUP
  92+ EEB3 20 1A            JR NZ, .cmpDone
  93+ EEB5 23               INC HL
  94+ EEB6 7E               LD A, (HL)                          ; ref esperada
  95+ EEB7 B8               CP B
  96+ EEB8 20 15            JR NZ, .cmpDone
  97+ EEBA 3A BA 82         LD A, (CurrentObjective)
  98+ EEBD 3C               INC A
  99+ EEBE 32 BA 82         LD (CurrentObjective), A
 100+ EEC1 CD 62 EF         CALL ResolveObjectiveScreen
 101+ EEC4 3E FF            LD A, $FF
 102+ EEC6 32 BD 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 103+ EEC9 CD 39 76         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 104+ EECC CD 69 76         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 105+ EECF              .cmpDone:
 106+ EECF F1               POP AF
 107+ EED0 C1               POP BC
 108+ EED1 D1               POP DE
 109+ EED2 E1               POP HL
 110+ EED3 C9               RET
 111+ EED4
 112+ EED4              ; ==============================================================================
 113+ EED4              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
 114+ EED4              ; ==============================================================================
 115+ EED4              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
 116+ EED4              ; Preserva: AF, BC, DE, HL.
 117+ EED4              ; ==============================================================================
 118+ EED4              CheckMilestoneTrigger:
 119+ EED4 E5               PUSH HL
 120+ EED5 D5               PUSH DE
 121+ EED6 C5               PUSH BC
 122+ EED7 F5               PUSH AF
 123+ EED8 47               LD B, A
 124+ EED9 3A BA 82         LD A, (CurrentObjective)
 125+ EEDC FE 0B            CP 11
 126+ EEDE 30 27            JR NC, .cmtDone
 127+ EEE0 87               ADD A, A
 128+ EEE1 6F               LD L, A
 129+ EEE2 26 00            LD H, 0
 130+ EEE4 11 70 EE         LD DE, MilestoneTable
 131+ EEE7 19               ADD HL, DE
 132+ EEE8 7E               LD A, (HL)
 133+ EEE9 FE 02            CP MILESTONE_TYPE_TRIGGER
 134+ EEEB 20 1A            JR NZ, .cmtDone
 135+ EEED 23               INC HL
 136+ EEEE 7E               LD A, (HL)
 137+ EEEF B8               CP B
