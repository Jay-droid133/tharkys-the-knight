3507+ 9FF5 E5               PUSH HL
3508+ 9FF6 6F               LD L, A
3509+ 9FF7 26 00            LD H, 0
3510+ 9FF9 29               ADD HL, HL
3511+ 9FFA 11 94 DA         LD DE, SpriteFrameTable
3512+ 9FFD 19               ADD HL, DE
3513+ 9FFE 5E               LD E, (HL)
3514+ 9FFF 23               INC HL
3515+ A000 56               LD D, (HL)                          ; DE = sprite data addr
3516+ A001 E1               POP HL
3517+ A002 73               LD (HL), E
3518+ A003 23               INC HL
3519+ A004 72               LD (HL), D
3520+ A005                  ; Incrementar counter
3521+ A005 3A 9F 81         LD A, (PendingEraseCount)
3522+ A008 3C               INC A
3523+ A009 32 9F 81         LD (PendingEraseCount), A
