1282+ D3FB              ; ==============================================================================
1283+ D3FB              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
1284+ D3FB              ; ==============================================================================
1285+ D3FB              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
1286+ D3FB              ; Salida:  IX = primer byte tras pixel data (tintPaper)
1287+ D3FB              ; Modifica: AF, BC, DE, HL
1288+ D3FB              ; ==============================================================================
1289+ D3FB              SkipPixelData:
1290+ D3FB DD 7E 00         LD A, (IX+0)                ; height_px
1291+ D3FE 57               LD D, A                     ; D = height_px
1292+ D3FF DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
1293+ D402 5F               LD E, A                     ; E = raw value con flag
