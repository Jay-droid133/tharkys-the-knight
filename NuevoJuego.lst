2677+ B05B DD 7E 00         LD A, (IX+ENT_SPRITEID)
2678+ B05E 47               LD B, A
2679+ B05F DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2680+ B062                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2681+ B062 E6 01            AND 1
2682+ B064 20 03            JR NZ, .eFrameReset
2683+ B066                  ; Frame 0 del par → avanzar a frame 1
2684+ B066 04               INC B
2685+ B067 18 01            JR .eFrameSet
2686+ B069              .eFrameReset:
2687+ B069                  ; Frame 1 del par → volver a frame 0
2688+ B069 05               DEC B
2689+ B06A              .eFrameSet:
2690+ B06A DD 70 00         LD (IX+ENT_SPRITEID), B
