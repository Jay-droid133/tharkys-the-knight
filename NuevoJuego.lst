 493  9DB3                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ 9DB3              ; ==============================================================================
   2+ 9DB3              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DB3              ; ==============================================================================
   4+ 9DB3              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DB3              ; - Game loop per-entity: erase → update → draw
   6+ 9DB3              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DB3              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DB3              ; - XOR draw/erase (una sola rutina)
   9+ 9DB3              ; ==============================================================================
  10+ 9DB3
  11+ 9DB3              ; ==============================================================================
  12+ 9DB3              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DB3              ; ==============================================================================
  14+ 9DB3              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DB3              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DB3              ; ==============================================================================
  17+ 9DB3              ReadInput:
  18+ 9DB3 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DB5 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DB7
  21+ 9DB7                  ; -- 1. QAOP --
  22+ 9DB7 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DBA ED 78            IN A, (C)
  24+ 9DBC CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DBE 20 02            JR NZ, .no_q
  26+ 9DC0 CB C2            SET 0, D
  27+ 9DC2              .no_q:
  28+ 9DC2 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DC5 ED 78            IN A, (C)
  30+ 9DC7 CB 47            BIT 0, A            ; A = Abajo
  31+ 9DC9 20 02            JR NZ, .no_a
  32+ 9DCB CB CA            SET 1, D
  33+ 9DCD              .no_a:
  34+ 9DCD 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DD0 ED 78            IN A, (C)
  36+ 9DD2 CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DD4 20 02            JR NZ, .no_o
  38+ 9DD6 CB DA            SET 3, D
  39+ 9DD8              .no_o:
  40+ 9DD8 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DDA 20 02            JR NZ, .no_p
  42+ 9DDC CB D2            SET 2, D
  43+ 9DDE              .no_p:
  44+ 9DDE
  45+ 9DDE                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DDE                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DDE DB 1F            IN A, (31)
  48+ 9DE0 4F               LD C, A             ; guardar para fire
  49+ 9DE1 CB 5F            BIT 3, A            ; Up
  50+ 9DE3 28 02            JR Z, .no_k_up
  51+ 9DE5 CB C2            SET 0, D
  52+ 9DE7              .no_k_up:
  53+ 9DE7 CB 57            BIT 2, A            ; Down
  54+ 9DE9 28 02            JR Z, .no_k_down
  55+ 9DEB CB CA            SET 1, D
  56+ 9DED              .no_k_down:
  57+ 9DED CB 4F            BIT 1, A            ; Left
  58+ 9DEF 28 02            JR Z, .no_k_left
  59+ 9DF1 CB DA            SET 3, D
  60+ 9DF3              .no_k_left:
  61+ 9DF3 CB 47            BIT 0, A            ; Right
  62+ 9DF5 28 02            JR Z, .no_k_right
  63+ 9DF7 CB D2            SET 2, D
  64+ 9DF9              .no_k_right:
  65+ 9DF9 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9DFB 28 02            JR Z, .no_k_fire
  67+ 9DFD CB C3            SET 0, E
  68+ 9DFF              .no_k_fire:
  69+ 9DFF
  70+ 9DFF                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9DFF                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9DFF 01 FE F7         LD BC, $F7FE
  73+ 9E02 ED 78            IN A, (C)
  74+ 9E04 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E06 20 02            JR NZ, .no_s1_up
  76+ 9E08 CB C2            SET 0, D
  77+ 9E0A              .no_s1_up:
  78+ 9E0A CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E0C 20 02            JR NZ, .no_s1_down
  80+ 9E0E CB CA            SET 1, D
  81+ 9E10              .no_s1_down:
  82+ 9E10 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E12 20 02            JR NZ, .no_s1_left
  84+ 9E14 CB DA            SET 3, D
  85+ 9E16              .no_s1_left:
  86+ 9E16 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E18 20 02            JR NZ, .no_s1_right
  88+ 9E1A CB D2            SET 2, D
  89+ 9E1C              .no_s1_right:
  90+ 9E1C CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E1E 20 02            JR NZ, .no_s1_fire
  92+ 9E20 CB C3            SET 0, E
  93+ 9E22              .no_s1_fire:
  94+ 9E22
  95+ 9E22                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E22 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E25 ED 78            IN A, (C)
  98+ 9E27 CB 47            BIT 0, A            ; SPACE
  99+ 9E29 20 02            JR NZ, .no_space
 100+ 9E2B CB C3            SET 0, E
 101+ 9E2D              .no_space:
 102+ 9E2D
 103+ 9E2D                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E2D 7B               LD A, E
 105+ 9E2E 32 A5 82         LD (InputFire), A
 106+ 9E31
 107+ 9E31                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E31 21 D3 82         LD HL, MushroomLockTimer
 109+ 9E34 7E               LD A, (HL)
 110+ 9E35 23               INC HL
 111+ 9E36 B6               OR (HL)
 112+ 9E37 28 21            JR Z, .noMushLock
 113+ 9E39 AF               XOR A
 114+ 9E3A 32 A5 82         LD (InputFire), A
 115+ 9E3D                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E3D                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E3D 7B               LD A, E
 118+ 9E3E B7               OR A
 119+ 9E3F 28 15            JR Z, .resetNoSwordFlag
 120+ 9E41 3A AE 82         LD A, (NoSwordSoundFlag)
 121+ 9E44 B7               OR A
 122+ 9E45 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E47 3E 01            LD A, 1
 124+ 9E49 32 AE 82         LD (NoSwordSoundFlag), A
 125+ 9E4C D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E4D 21 66 FA         LD HL, SFX_NoSwordError
 127+ 9E50 CD 24 F9         CALL PlaySFX
 128+ 9E53 D1               POP DE
 129+ 9E54 18 04            JR .noMushLock
 130+ 9E56              .resetNoSwordFlag:
 131+ 9E56 AF               XOR A
 132+ 9E57 32 AE 82         LD (NoSwordSoundFlag), A
 133+ 9E5A              .noMushLock:
 134+ 9E5A
 135+ 9E5A                  ; -- 6. Cancelar opuestos --
 136+ 9E5A 7A               LD A, D
 137+ 9E5B 47               LD B, A
 138+ 9E5C E6 03            AND DIR_N | DIR_S
 139+ 9E5E FE 03            CP DIR_N | DIR_S
 140+ 9E60 20 04            JR NZ, .noVC
 141+ 9E62 78               LD A, B
 142+ 9E63 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ 9E65 47               LD B, A
