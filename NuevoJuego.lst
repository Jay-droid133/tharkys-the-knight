7347+ C7E1              .bfsAppMove:
7348+ C7E1                  ; Intentar 1 paso con collision check
7349+ C7E1 DD 7E 03         LD A, (IX+ENT_POSX)
7350+ C7E4 32 10 C8         LD (.bfsSvX), A
7351+ C7E7 DD 7E 04         LD A, (IX+ENT_POSY)
7352+ C7EA 32 11 C8         LD (.bfsSvY), A
7353+ C7ED DD 7E 03         LD A, (IX+ENT_POSX)
7354+ C7F0 DD 86 06         ADD A, (IX+ENT_DELTAX)
7355+ C7F3 DD 77 03         LD (IX+ENT_POSX), A
7356+ C7F6 DD 7E 04         LD A, (IX+ENT_POSY)
