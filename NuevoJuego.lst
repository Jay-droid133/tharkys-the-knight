5074+ BEBB              ; ==============================================================================
5075+ BEBB              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5076+ BEBB              ; ==============================================================================
5077+ BEBB              TryRespawnMonsters:
5078+ BEBB 3A 6F DD         LD A, (CurrentTimeOfDay)
5079+ BEBE FE 03            CP 3
5080+ BEC0 28 05            JR Z, .rmNight
5081+ BEC2 FE 04            CP 4
5082+ BEC4 28 01            JR Z, .rmNight
5083+ BEC6 C9               RET
5084+ BEC7              .rmNight:
5085+ BEC7 3A 01 B6         LD A, (MonstersActive)
5086+ BECA B7               OR A
5087+ BECB C8               RET Z
5088+ BECC CD 9C BF         CALL .rmUpdateReturnTimers
5089+ BECF 3A 98 BF         LD A, (.rmTimer)
5090+ BED2 B7               OR A
5091+ BED3 28 05            JR Z, .rmCheckSlots
5092+ BED5 3D               DEC A
5093+ BED6 32 98 BF         LD (.rmTimer), A
