 494  CCA2                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CCA2              ; ==============================================================================
   2+ CCA2              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CCA2              ; ==============================================================================
   4+ CCA2              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CCA2              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CCA2              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CCA2              ; ==============================================================================
   8+ CCA2
   9+ CCA2              ; ==============================================================================
  10+ CCA2              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CCA2              ; ==============================================================================
  12+ CCA2              InitScreenSystem:
  13+ CCA2 3E 0F            LD A, START_SCREEN_X
  14+ CCA4 32 01 83         LD (CurrentScreenX), A
  15+ CCA7 3E 07            LD A, START_SCREEN_Y
  16+ CCA9 32 02 83         LD (CurrentScreenY), A
  17+ CCAC 3E 01            LD A, 1
  18+ CCAE 32 09 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CCB1 AF               XOR A
  20+ CCB2 32 05 83         LD (ScreenTransition), A
  21+ CCB5 CD B9 CC         CALL CalcScreenAddress
  22+ CCB8 C9               RET
  23+ CCB9
  24+ CCB9              ; ==============================================================================
  25+ CCB9              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CCB9              ; ==============================================================================
  27+ CCB9              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CCB9              ; ==============================================================================
  29+ CCB9              CalcScreenAddress:
  30+ CCB9 3A 02 83         LD A, (CurrentScreenY)
  31+ CCBC 6F               LD L, A
  32+ CCBD 26 00            LD H, 0
  33+ CCBF 29               ADD HL, HL                  ; x2
  34+ CCC0 29               ADD HL, HL                  ; x4
  35+ CCC1 29               ADD HL, HL                  ; x8
  36+ CCC2 29               ADD HL, HL                  ; x16
  37+ CCC3 3A 01 83         LD A, (CurrentScreenX)
  38+ CCC6 5F               LD E, A
  39+ CCC7 16 00            LD D, 0
  40+ CCC9 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CCCA 11 E3 DD         LD DE, MapTable
  42+ CCCD 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CCCE 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CCCF                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CCCF 6F               LD L, A
  46+ CCD0 26 00            LD H, 0
  47+ CCD2 29               ADD HL, HL                  ; index * 2
  48+ CCD3 11 B1 DC         LD DE, RoomTable
  49+ CCD6 19               ADD HL, DE
  50+ CCD7 5E               LD E, (HL)
  51+ CCD8 23               INC HL
  52+ CCD9 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CCDA                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CCDA EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CCDB CD 7A 67         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CCDE                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CCDE 11 EE 85         LD DE, CurrentScreenBuffer
  58+ CCE1 ED 53 03 83      LD (CurrentScreenAddr), DE
  59+ CCE5 C9               RET
  60+ CCE6
  61+ CCE6              ; ==============================================================================
  62+ CCE6              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CCE6              ; ==============================================================================
  64+ CCE6              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CCE6              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CCE6              ; por estar atrapado cerca del borde.
  67+ CCE6              ; ==============================================================================
  68+ CCE6              CheckScreenTransition:
  69+ CCE6 AF               XOR A
  70+ CCE7 32 05 83         LD (ScreenTransition), A
  71+ CCEA
  72+ CCEA                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CCEA                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CCEA                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CCEA                  ; dispararia transicion sur en plena animacion.
  76+ CCEA 3A C1 82         LD A, (TownGatePhase)
  77+ CCED B7               OR A
  78+ CCEE C0               RET NZ
  79+ CCEF
  80+ CCEF                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CCEF                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CCEF                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CCEF                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CCEF                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CCEF                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CCEF 3A AC 82         LD A, (TimeFrozen)
  87+ CCF2 B7               OR A
  88+ CCF3 28 23            JR Z, .cstNotFrozen
  89+ CCF5 3A A4 82         LD A, (InputDirection)
  90+ CCF8 CB 4F            BIT 1, A                    ; S
  91+ CCFA 28 17            JR Z, .cstClearBlockFlag
  92+ CCFC 3A 98 81         LD A, (EntityTable + ENT_POSY)
  93+ CCFF FE A8            CP SCREEN_MAX_Y
  94+ CD01 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD03                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD03 3A AD 82         LD A, (BlockedExitSoundFlag)
  97+ CD06 B7               OR A
  98+ CD07 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD08 3E 01            LD A, 1
 100+ CD0A 32 AD 82         LD (BlockedExitSoundFlag), A
 101+ CD0D 21 51 FA         LD HL, SFX_BlockedExit
 102+ CD10 C3 24 F9         JP PlaySFX                  ; tail call
 103+ CD13              .cstClearBlockFlag:
 104+ CD13 AF               XOR A
 105+ CD14 32 AD 82         LD (BlockedExitSoundFlag), A
 106+ CD17 C9               RET
 107+ CD18              .cstNotFrozen:
 108+ CD18                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD18 AF               XOR A
 110+ CD19 32 AD 82         LD (BlockedExitSoundFlag), A
