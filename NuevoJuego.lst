7254+ C763              ; ==============================================================================
7255+ C763              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7256+ C763              ; ==============================================================================
7257+ C763              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7258+ C763              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7259+ C763              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7260+ C763              ; el primer paso (N/S/W/E) desde el inicio.
7261+ C763              ;
7262+ C763              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7263+ C763              ; consistente con CheckEnemyCollision en cell-aligned positions).
7264+ C763              ;
7265+ C763              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7266+ C763              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7267+ C763              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7268+ C763              ; paso pero permite llegar a una celda mas profunda con dist menor).
7269+ C763              ;
7270+ C763              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7271+ C763              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7272+ C763              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7273+ C763              ;
7274+ C763              ; IX = SLOT_DEATH al entrar.
7275+ C763              ; ==============================================================================
7276+ C763              DeathBfsRescue:
7277+ C763                  ; --- Celda inicial = celda actual de Death ---
7278+ C763 DD 7E 03         LD A, (IX+ENT_POSX)
7279+ C766 0F               RRCA
7280+ C767 0F               RRCA
7281+ C768 0F               RRCA
7282+ C769 E6 1F            AND $1F
7283+ C76B 32 74 5F         LD (DBfsCurCx), A
7284+ C76E DD 7E 04         LD A, (IX+ENT_POSY)
7285+ C771 D6 10            SUB SCREEN_MIN_Y
7286+ C773 0F               RRCA
7287+ C774 0F               RRCA
7288+ C775 0F               RRCA
7289+ C776 E6 1F            AND $1F
7290+ C778 32 75 5F         LD (DBfsCurCy), A
7291+ C77B                  ; --- Celda del player ---
7292+ C77B 3A A3 81         LD A, (EntityTable + ENT_POSX)
7293+ C77E 0F               RRCA
7294+ C77F 0F               RRCA
7295+ C780 0F               RRCA
7296+ C781 E6 1F            AND $1F
7297+ C783 32 72 5F         LD (DBfsPlayerCx), A
7298+ C786 3A A4 81         LD A, (EntityTable + ENT_POSY)
7299+ C789 D6 10            SUB SCREEN_MIN_Y
7300+ C78B 0F               RRCA
7301+ C78C 0F               RRCA
7302+ C78D 0F               RRCA
7303+ C78E E6 1F            AND $1F
7304+ C790 32 73 5F         LD (DBfsPlayerCy), A
7305+ C793                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7306+ C793 21 FF 5E         LD HL, DBfsQueue
7307+ C796 22 6B 5F         LD (DBfsQHead), HL
7308+ C799 3A 74 5F         LD A, (DBfsCurCx)
7309+ C79C 77               LD (HL), A
7310+ C79D 23               INC HL
7311+ C79E 3A 75 5F         LD A, (DBfsCurCy)
7312+ C7A1 77               LD (HL), A
7313+ C7A2 23               INC HL
7314+ C7A3 36 FF            LD (HL), MAI_DIR_NONE
7315+ C7A5 23               INC HL
7316+ C7A6 36 00            LD (HL), 0
7317+ C7A8 23               INC HL
7318+ C7A9 22 6D 5F         LD (DBfsQTail), HL
