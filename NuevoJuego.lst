 510+ ED36              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ ED36              .levelToColor:
 512+ ED36 FE 0C            CP 12
 513+ ED38 30 11            JR NC, .lcGreen
 514+ ED3A FE 07            CP 7
 515+ ED3C 30 0A            JR NC, .lcCyan
 516+ ED3E FE 03            CP 3
 517+ ED40 30 03            JR NC, .lcYellow
 518+ ED42 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ ED44 C9               RET
 520+ ED45              .lcYellow:
 521+ ED45 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ ED47 C9               RET
 523+ ED48              .lcCyan:
 524+ ED48 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ ED4A C9               RET
 526+ ED4B              .lcGreen:
 527+ ED4B 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ ED4D C9               RET
 529+ ED4E
 530+ ED4E              ; ==============================================================================
 531+ ED4E              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ ED4E              ; ==============================================================================
 533+ ED4E              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ ED4E              ; ==============================================================================
 535+ ED4E              DrawHandLine:
 536+ ED4E 87               ADD A, A
 537+ ED4F 4F               LD C, A
 538+ ED50 06 00            LD B, 0
 539+ ED52 09               ADD HL, BC
 540+ ED53 7E               LD A, (HL)
 541+ ED54 23               INC HL
 542+ ED55 66               LD H, (HL)
 543+ ED56 6F               LD L, A             ; HL = puntero a datos de línea
 544+ ED57
 545+ ED57              .pixLoop:
 546+ ED57 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ ED58 B7               OR A
 548+ ED59 C8               RET Z
 549+ ED5A 57               LD D, A
 550+ ED5B 23               INC HL
 551+ ED5C 7E               LD A, (HL)          ; VRAM L
 552+ ED5D 23               INC HL
 553+ ED5E 5F               LD E, A
 554+ ED5F 7E               LD A, (HL)          ; mask
 555+ ED60 23               INC HL
 556+ ED61 E5               PUSH HL
 557+ ED62 2F               CPL                 ; ~mask
 558+ ED63 62               LD H, D
 559+ ED64 6B               LD L, E
 560+ ED65 A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ ED66 77               LD (HL), A
 562+ ED67 E1               POP HL
 563+ ED68 18 ED            JR .pixLoop
