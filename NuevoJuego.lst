 483+ 7EC8              ; --- Poly3 (7 B/entry): periodA, periodB, periodC, duration --------------------
 484+ 7EC8              MusicAdvancePoly3:
 485+ 7EC8 2A A3 7B         LD HL, (MusicPtr)
 486+ 7ECB                  ; periodA
 487+ 7ECB 5E               LD E, (HL)
 488+ 7ECC 23               INC HL
 489+ 7ECD 56               LD D, (HL)
 490+ 7ECE 23               INC HL
 491+ 7ECF ED 53 AA 7B      LD (MusicPeriodA), DE
 492+ 7ED3                  ; periodB
 493+ 7ED3 4E               LD C, (HL)
 494+ 7ED4 23               INC HL
 495+ 7ED5 46               LD B, (HL)
 496+ 7ED6 23               INC HL
 497+ 7ED7 ED 43 AC 7B      LD (MusicPeriodB), BC
 498+ 7EDB                  ; periodC
 499+ 7EDB 5E               LD E, (HL)
 500+ 7EDC 23               INC HL
 501+ 7EDD 56               LD D, (HL)
 502+ 7EDE 23               INC HL
 503+ 7EDF ED 53 AE 7B      LD (MusicPeriodC), DE
 504+ 7EE3                  ; duration
 505+ 7EE3 7E               LD A, (HL)
 506+ 7EE4 23               INC HL
 507+ 7EE5 B7               OR A
 508+ 7EE6 28 7F            JR Z, .map3End
 509+ 7EE8 22 A3 7B         LD (MusicPtr), HL
 510+ 7EEB CD 6A 7F         CALL ApplyMusicSpeedShift
 511+ 7EEE 32 A5 7B         LD (MusicTimer), A
 512+ 7EF1                  ; --- Canal A: R0/R1 + R8 ---
 513+ 7EF1 2A AA 7B         LD HL, (MusicPeriodA)
 514+ 7EF4 7C               LD A, H
 515+ 7EF5 B5               OR L
 516+ 7EF6 20 09            JR NZ, .map3NoteA
 517+ 7EF8 3E 08            LD A, 8
 518+ 7EFA 1E 00            LD E, 0
 519+ 7EFC CD BB 7D         CALL AY_WriteRegSlot1
 520+ 7EFF 18 18            JR .map3DoB
 521+ 7F01              .map3NoteA:
 522+ 7F01 E5               PUSH HL
 523+ 7F02 3E 08            LD A, 8
 524+ 7F04 1E 0C            LD E, 12
 525+ 7F06 CD BB 7D         CALL AY_WriteRegSlot1
 526+ 7F09 E1               POP HL
 527+ 7F0A 5D               LD E, L
 528+ 7F0B 3E 00            LD A, 0
 529+ 7F0D CD BB 7D         CALL AY_WriteRegSlot1
 530+ 7F10 2A AA 7B         LD HL, (MusicPeriodA)
 531+ 7F13 5C               LD E, H
 532+ 7F14 3E 01            LD A, 1
 533+ 7F16 CD BB 7D         CALL AY_WriteRegSlot1
 534+ 7F19              .map3DoB:
 535+ 7F19                  ; --- Canal B: R2/R3 + R9 ---
 536+ 7F19 2A AC 7B         LD HL, (MusicPeriodB)
 537+ 7F1C 7C               LD A, H
 538+ 7F1D B5               OR L
 539+ 7F1E 20 09            JR NZ, .map3NoteB
 540+ 7F20 3E 09            LD A, 9
 541+ 7F22 1E 00            LD E, 0
 542+ 7F24 CD BB 7D         CALL AY_WriteRegSlot1
 543+ 7F27 18 18            JR .map3DoC
 544+ 7F29              .map3NoteB:
 545+ 7F29 E5               PUSH HL
 546+ 7F2A 3E 09            LD A, 9
 547+ 7F2C 1E 0C            LD E, 12
 548+ 7F2E CD BB 7D         CALL AY_WriteRegSlot1
 549+ 7F31 E1               POP HL
