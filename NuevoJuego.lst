 151+ 84CF              ; ==============================================================================
 152+ 84CF              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 153+ 84CF              ; ==============================================================================
 154+ 84CF              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 155+ 84CF              ; y los cruces de tercio de pantalla (cada 64 lineas).
 156+ 84CF              ;
 157+ 84CF              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 158+ 84CF              ; ==============================================================================
 159+ 84CF              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 160+ 84CF              NextPixelLine:
 161+ 84CF 24               INC H                       ; Siguiente scanline dentro del char
 162+ 84D0 7C               LD A, H
 163+ 84D1 E6 07            AND 7
 164+ 84D3 C0               RET NZ                      ; Sin cruce de char row → listo
 165+ 84D4
 166+ 84D4                  ; --- Cruce de character row ---
 167+ 84D4 7D               LD A, L
 168+ 84D5 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 169+ 84D7 6F               LD L, A
 170+ 84D8 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 171+ 84DA C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 172+ 84DB
 173+ 84DB                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 174+ 84DB 7C               LD A, H
 175+ 84DC D6 08            SUB 8
 176+ 84DE 67               LD H, A
 177+ 84DF C9               RET
