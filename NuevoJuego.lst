5432+ C021              ; ==============================================================================
5433+ C021              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5434+ C021              ; ==============================================================================
5435+ C021              ScareAllMonsters:
5436+ C021 AF               XOR A
5437+ C022 32 71 B6         LD (MonstersActive), A              ; No respawnear mas
5438+ C025                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5439+ C025                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5440+ C025                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5441+ C025 21 F8 90         LD HL, MonsterAiFlags
5442+ C028 06 03            LD B, 3
5443+ C02A              .samClearLoop:
5444+ C02A 7E               LD A, (HL)
5445+ C02B E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5446+ C02D 77               LD (HL), A
5447+ C02E 23               INC HL
5448+ C02F 10 F9            DJNZ .samClearLoop
5449+ C031 3E 7D            LD A, SCARE_TIMER_DAWN
5450+ C033 32 07 B9         LD (ScareTimer), A
5451+ C036                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5452+ C036                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5453+ C036                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5454+ C036                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5455+ C036 DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5456+ C03A 06 06            LD B, NUM_MONSTERS
5457+ C03C              .samStateLoop:
5458+ C03C DD 7E 01         LD A, (IX+ENT_TYPE)
5459+ C03F FE 02            CP TYPE_MONSTER
5460+ C041 20 1B            JR NZ, .samStateNext
5461+ C043 DD 7E 02         LD A, (IX+ENT_STATE)
5462+ C046 FE 03            CP STATE_DYING
5463+ C048 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5464+ C04A FE 04            CP STATE_SPAWNING
5465+ C04C 28 10            JR Z, .samStateNext
5466+ C04E DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5467+ C052 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5468+ C056 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5469+ C05A DD 36 07 00      LD (IX+ENT_DELTAY), 0
5470+ C05E              .samStateNext:
5471+ C05E 11 10 00         LD DE, ENT_SIZE
5472+ C061 DD 19            ADD IX, DE
5473+ C063 10 D7            DJNZ .samStateLoop
5474+ C065 C9               RET
