 365+ 6582 AF               XOR A                                   ; not statue -> Z (visible)
 366+ 6583 C9               RET
 367+ 6584              .cshMatch:
 368+ 6584                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
 369+ 6584 79               LD A, C
