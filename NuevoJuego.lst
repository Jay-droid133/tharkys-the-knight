1108+ A4F9 F6 06            OR 6
1109+ A4FB 32 82 8D         LD (CurrentPaging), A
1110+ A4FE 01 FD 7F         LD BC, $7FFD
1111+ A501 ED 79            OUT (C), A
1112+ A503 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1113+ A506 6F               LD L, A
1114+ A507 26 00            LD H, 0
1115+ A509 29               ADD HL, HL
1116+ A50A 11 B7 E7         LD DE, SpriteFrameTable
1117+ A50D 19               ADD HL, DE
1118+ A50E 5E               LD E, (HL)
1119+ A50F 23               INC HL
1120+ A510 56               LD D, (HL)
1121+ A511 ED 53 7C A4      LD (OldSprAddr), DE
1122+ A515 3A 82 8D         LD A, (CurrentPaging)
1123+ A518 E6 F8            AND $F8
1124+ A51A 32 82 8D         LD (CurrentPaging), A
1125+ A51D 01 FD 7F         LD BC, $7FFD
1126+ A520 ED 79            OUT (C), A
1127+ A522 C9               RET
1128+ A523
1129+ A523              ; ==============================================================================
1130+ A523              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A523              ; ==============================================================================
1132+ A523              ; Entrada: A = SpriteID
1133+ A523              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A523              ; Destruye: A, DE, HL
1135+ A523              ; ==============================================================================
1136+ A523              GetSpriteDims:
1137+ A523                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A523                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A523 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A524 26 00            LD H, 0
1141+ A526 3A 82 8D         LD A, (CurrentPaging)
1142+ A529 E6 F8            AND $F8
1143+ A52B F6 06            OR 6
1144+ A52D 32 82 8D         LD (CurrentPaging), A
1145+ A530 01 FD 7F         LD BC, $7FFD
1146+ A533 ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A535 29               ADD HL, HL
1148+ A536 11 B7 E7         LD DE, SpriteFrameTable
1149+ A539 19               ADD HL, DE
1150+ A53A 5E               LD E, (HL)
1151+ A53B 23               INC HL
1152+ A53C 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A53D 1A               LD A, (DE)                  ; width_bytes
1154+ A53E 87               ADD A, A
1155+ A53F 87               ADD A, A
1156+ A540 87               ADD A, A                    ; × 8 = width_px
1157+ A541 47               LD B, A
1158+ A542 13               INC DE
1159+ A543 1A               LD A, (DE)                  ; height_px
1160+ A544 4F               LD C, A
1161+ A545                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A545 78               LD A, B
1163+ A546 32 63 A5         LD (GsdSavedB), A
1164+ A549 79               LD A, C
1165+ A54A 32 64 A5         LD (GsdSavedC), A
1166+ A54D 3A 82 8D         LD A, (CurrentPaging)
1167+ A550 E6 F8            AND $F8
1168+ A552 32 82 8D         LD (CurrentPaging), A
1169+ A555 01 FD 7F         LD BC, $7FFD
1170+ A558 ED 79            OUT (C), A                  ; bank 0 de vuelta
1171+ A55A 3A 63 A5         LD A, (GsdSavedB)
1172+ A55D 47               LD B, A
1173+ A55E 3A 64 A5         LD A, (GsdSavedC)
1174+ A561 4F               LD C, A
1175+ A562 C9               RET
1176+ A563
1177+ A563 00           GsdSavedB: DEFB 0
1178+ A564 00           GsdSavedC: DEFB 0
1179+ A565
1180+ A565              ; ==============================================================================
1181+ A565              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1182+ A565              ; ==============================================================================
1183+ A565              ; IX = puntero a la entidad del player (slot 0)
1184+ A565              ; ==============================================================================
1185+ A565              UpdatePlayer:
1186+ A565 CD 8D A5         CALL UpdatePlayerState
1187+ A568 CD A8 A6         CALL UpdatePlayerMovement
1188+ A56B CD 21 A9         CALL UpdatePlayerAnimation
1189+ A56E                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1190+ A56E                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1191+ A56E                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1192+ A56E                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1193+ A56E                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1194+ A56E                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1195+ A56E                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1196+ A56E                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1197+ A56E                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1198+ A56E                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1199+ A56E                  ; tickea a tiempo y reescribe SPRITEID).
1200+ A56E 3A EC 82         LD A, (PlayerRespawnTimer)
1201+ A571 B7               OR A
1202+ A572 C8               RET Z
1203+ A573 3A 98 81         LD A, (GameFrameCounter)
1204+ A576 E6 02            AND 2
1205+ A578 28 0D            JR Z, .pblOffFrame
1206+ A57A                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1207+ A57A DD 7E 00         LD A, (IX+ENT_SPRITEID)
1208+ A57D FE 74            CP SPRID_PLAYER_BLANK
1209+ A57F C0               RET NZ                              ; sprite válido (anim viva) → keep
1210+ A580 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1211+ A583 DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1212+ A586 C9               RET
1213+ A587              .pblOffFrame:
1214+ A587 3E 74            LD A, SPRID_PLAYER_BLANK
1215+ A589 32 9B 81         LD (EntityTable), A
1216+ A58C C9               RET
1217+ A58D
1218+ A58D              ; ==============================================================================
1219+ A58D              ; UpdatePlayerState - Determina estado y direccion desde input
1220+ A58D              ; ==============================================================================
1221+ A58D              UpdatePlayerState:
1222+ A58D 3A AB 82         LD A, (InputDirection)
1223+ A590 47               LD B, A
1224+ A591 3A AC 82         LD A, (InputFire)
1225+ A594 4F               LD C, A
1226+ A595
1227+ A595                  ; Sin input → idle (salvo si ataque en curso)
1228+ A595 78               LD A, B
1229+ A596 B1               OR C
1230+ A597 20 17            JR NZ, .notIdle
1231+ A599                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1232+ A599 3A 4D B3         LD A, (AttackTimer)
1233+ A59C B7               OR A
1234+ A59D 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1235+ A59F DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1236+ A5A3                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1237+ A5A3 DD 7E 0A         LD A, (IX+ENT_DIR)
1238+ A5A6 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1239+ A5A8 DD 77 0A         LD (IX+ENT_DIR), A
1240+ A5AB                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1241+ A5AB AF               XOR A
1242+ A5AC 32 4F B3         LD (AttackDebounce), A
1243+ A5AF C9               RET
1244+ A5B0
1245+ A5B0              .notIdle:
1246+ A5B0                  ; Guardar direccion actual en bits 0-3
1247+ A5B0 DD 7E 0A         LD A, (IX+ENT_DIR)
1248+ A5B3 E6 F0            AND $F0                     ; Mantener lastHDir
1249+ A5B5 B0               OR B                        ; Añadir dir actual
1250+ A5B6 DD 77 0A         LD (IX+ENT_DIR), A
1251+ A5B9
1252+ A5B9                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1253+ A5B9 3A 4D B3         LD A, (AttackTimer)
1254+ A5BC B7               OR A
1255+ A5BD 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1256+ A5BF 78               LD A, B
1257+ A5C0 E6 0C            AND DIR_E | DIR_W
1258+ A5C2 28 0E            JR Z, .noHorizUpdate
1259+ A5C4                  ; Guardar en bits 4-7
1260+ A5C4 07               RLCA
1261+ A5C5 07               RLCA
1262+ A5C6 07               RLCA
1263+ A5C7 07               RLCA                        ; Shift a bits 4-7
1264+ A5C8 4F               LD C, A                     ; C = lastHDir en bits 4-7
1265+ A5C9 DD 7E 0A         LD A, (IX+ENT_DIR)
1266+ A5CC E6 0F            AND $0F                     ; Mantener dir actual
1267+ A5CE B1               OR C                        ; Añadir lastHDir
1268+ A5CF DD 77 0A         LD (IX+ENT_DIR), A
1269+ A5D2              .noHorizUpdate:
1270+ A5D2
1271+ A5D2                  ; --- Consumir/regenerar stamina ---
1272+ A5D2 CD 54 AA         CALL UpdateStamina
1273+ A5D5                  ; --- Auto-select sword mode segun stamina ---
1274+ A5D5 CD AA AA         CALL SelectSwordMode
1275+ A5D8                  ; --- Dispatch segun SwordMode ---
1276+ A5D8 3A 51 B3         LD A, (SwordMode)
1277+ A5DB B7               OR A
1278+ A5DC 28 09            JR Z, .swordModeB
1279+ A5DE FE 01            CP 1
1280+ A5E0 28 3F            JR Z, .swordModeC
1281+ A5E2 FE 02            CP 2
1282+ A5E4 CA 4A A6         JP Z, .swordModeFree
1283+ A5E7
1284+ A5E7                  ; === MODO B: Cooldown fijo tras atacar ===
1285+ A5E7              .swordModeB:
1286+ A5E7 3A 4E B3         LD A, (AttackCooldown)
1287+ A5EA B7               OR A
1288+ A5EB 28 0D            JR Z, .bNoCooldown
1289+ A5ED 3D               DEC A
1290+ A5EE 32 4E B3         LD (AttackCooldown), A
1291+ A5F1 C2 98 A6         JP NZ, .running                     ; En cooldown: no puede atacar
1292+ A5F4                  ; Cooldown terminado: restaurar color blanco
1293+ A5F4 CD 71 A6         CALL .setPlayerWhite
1294+ A5F7 C3 98 A6         JP .running
1295+ A5FA              .bNoCooldown:
1296+ A5FA 3A 4D B3         LD A, (AttackTimer)
1297+ A5FD B7               OR A
1298+ A5FE 28 13            JR Z, .bNoActive
1299+ A600 3D               DEC A
1300+ A601 32 4D B3         LD (AttackTimer), A
1301+ A604 20 08            JR NZ, .bActive
1302+ A606                  ; Swing terminado: iniciar cooldown + color azul
1303+ A606 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1304+ A608 32 4E B3         LD (AttackCooldown), A
1305+ A60B CD 66 A6         CALL .setPlayerBlue
1306+ A60E              .bActive:
1307+ A60E DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1308+ A612 C9               RET
1309+ A613              .bNoActive:
