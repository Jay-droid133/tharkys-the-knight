  19+ 8D9E              ; MaiComputeFlowField
  20+ 8D9E              ; ==============================================================================
  21+ 8D9E              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 8D9E              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 8D9E              ; quedan en $FF).
  24+ 8D9E              ;
  25+ 8D9E              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 8D9E              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 8D9E              ;
  28+ 8D9E              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 8D9E              ; Output: FlowField relleno en bank 6
  30+ 8D9E              ; Destruye: AF, BC, DE, HL
