5068+ BAB8              ; ==============================================================================
5069+ BAB8              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5070+ BAB8              ; ==============================================================================
5071+ BAB8              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5072+ BAB8              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5073+ BAB8              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5074+ BAB8              ; DeathSpawned. No-op si la muerte no esta activa.
5075+ BAB8              ; ==============================================================================
5076+ BAB8              SilentKillDeath:
5077+ BAB8 DD 21 4E 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5078+ BABC DD 7E 01         LD A, (IX+ENT_TYPE)
5079+ BABF B7               OR A
5080+ BAC0 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5081+ BAC2 CD BB C6         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5082+ BAC5 AF               XOR A
5083+ BAC6 DD 77 01         LD (IX+ENT_TYPE), A
5084+ BAC9 32 FD 82         LD (DeathSpawned), A
5085+ BACC              .skdResetTimer:
5086+ BACC                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5087+ BACC                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5088+ BACC 21 00 00         LD HL, 0
5089+ BACF 22 FA 82         LD (DeathScreenTimer), HL
5090+ BAD2                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5091+ BAD2                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5092+ BAD2                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5093+ BAD2                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5094+ BAD2                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5095+ BAD2 C9               RET
5096+ BAD3
5097+ BAD3              ; ==============================================================================
5098+ BAD3              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5099+ BAD3              ; ==============================================================================
5100+ BAD3              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5101+ BAD3              ; no DYING ni SPAWNING):
5102+ BAD3              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5103+ BAD3              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5104+ BAD3              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5105+ BAD3              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5106+ BAD3              ;     Si tampoco, deja el monster donde estaba.
5107+ BAD3              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5108+ BAD3              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5109+ BAD3              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5110+ BAD3              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5111+ BAD3              ; ==============================================================================
5112+ BAD3              FreezeMonstersFacingCorpse:
5113+ BAD3                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5114+ BAD3 3A A1 81         LD A, (EntityTable + ENT_POSX)
5115+ BAD6 32 F4 82         LD (CorpseX), A
5116+ BAD9 3A A2 81         LD A, (EntityTable + ENT_POSY)
5117+ BADC 32 F5 82         LD (CorpseY), A
5118+ BADF                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5119+ BADF                  ; ya skipea; no aplica aqui pero por simetria)
5120+ BADF 3E 01            LD A, 1
5121+ BAE1 32 F3 82         LD (MonstersFrozen), A
5122+ BAE4 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5123+ BAE8 06 06            LD B, NUM_MONSTERS
5124+ BAEA              .fmcLoop:
5125+ BAEA C5               PUSH BC
5126+ BAEB DD 7E 01         LD A, (IX+ENT_TYPE)
5127+ BAEE FE 02            CP TYPE_MONSTER
5128+ BAF0 20 0E            JR NZ, .fmcNext
5129+ BAF2 DD 7E 02         LD A, (IX+ENT_STATE)
5130+ BAF5 FE 03            CP STATE_DYING
5131+ BAF7 28 07            JR Z, .fmcNext
5132+ BAF9 FE 04            CP STATE_SPAWNING
5133+ BAFB 28 03            JR Z, .fmcNext
5134+ BAFD CD 09 BB         CALL FreezeOneMonster
5135+ BB00              .fmcNext:
5136+ BB00 C1               POP BC
5137+ BB01 11 10 00         LD DE, ENT_SIZE
5138+ BB04 DD 19            ADD IX, DE
5139+ BB06 10 E2            DJNZ .fmcLoop
5140+ BB08 C9               RET
5141+ BB09
5142+ BB09              ; --- FreezeOneMonster ---
5143+ BB09              ; IX = monster slot pointer.
5144+ BB09              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5145+ BB09              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5146+ BB09              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5147+ BB09              FreezeOneMonster:
5148+ BB09                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5149+ BB09                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5150+ BB09                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5151+ BB09 DD 7E 03         LD A, (IX+ENT_POSX)
5152+ BB0C 47               LD B, A
5153+ BB0D 3A F4 82         LD A, (CorpseX)
5154+ BB10 B8               CP B
5155+ BB11 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5156+ BB13 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5157+ BB15              .fomFaceE:
5158+ BB15 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5159+ BB18 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5160+ BB1A DD 77 00         LD (IX+ENT_SPRITEID), A
5161+ BB1D 18 08            JR .fomFaceDone
5162+ BB1F              .fomFaceW:
5163+ BB1F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5164+ BB22 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5165+ BB24 DD 77 00         LD (IX+ENT_SPRITEID), A
5166+ BB27              .fomFaceDone:
5167+ BB27
5168+ BB27                  ; --- 2) Computar |dx| y |dy| ---
5169+ BB27 3A F4 82         LD A, (CorpseX)
5170+ BB2A 4F               LD C, A
5171+ BB2B DD 7E 03         LD A, (IX+ENT_POSX)
5172+ BB2E 91               SUB C                           ; A = posX - corpseX (signed)
5173+ BB2F 30 02            JR NC, .fomDxPos
5174+ BB31 ED 44            NEG
5175+ BB33              .fomDxPos:
5176+ BB33 32 84 BB         LD (.fomAdx), A
5177+ BB36 3A F5 82         LD A, (CorpseY)
5178+ BB39 4F               LD C, A
5179+ BB3A DD 7E 04         LD A, (IX+ENT_POSY)
5180+ BB3D 91               SUB C
5181+ BB3E 30 02            JR NC, .fomDyPos
5182+ BB40 ED 44            NEG
5183+ BB42              .fomDyPos:
5184+ BB42 32 85 BB         LD (.fomAdy), A
5185+ BB45
5186+ BB45                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5187+ BB45 3A 84 BB         LD A, (.fomAdx)
5188+ BB48 FE 10            CP 16
5189+ BB4A D2 73 BB         JP NC, .fomFreeze
5190+ BB4D 3A 85 BB         LD A, (.fomAdy)
5191+ BB50 FE 10            CP 16
5192+ BB52 D2 73 BB         JP NC, .fomFreeze
5193+ BB55
5194+ BB55                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5195+ BB55 3A 84 BB         LD A, (.fomAdx)
5196+ BB58 47               LD B, A
5197+ BB59 3A 85 BB         LD A, (.fomAdy)
5198+ BB5C B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5199+ BB5D 38 0C            JR C, .fomTryX
5200+ BB5F 28 0A            JR Z, .fomTryX
5201+ BB61                  ; |dy| > |dx| -> intentar Y primero
5202+ BB61 CD B9 BB         CALL TryBackoffY
5203+ BB64 28 0D            JR Z, .fomFreeze                ; ok
5204+ BB66 CD 86 BB         CALL TryBackoffX
5205+ BB69 18 08            JR .fomFreeze
5206+ BB6B              .fomTryX:
5207+ BB6B CD 86 BB         CALL TryBackoffX
5208+ BB6E 28 03            JR Z, .fomFreeze
5209+ BB70 CD B9 BB         CALL TryBackoffY
5210+ BB73
5211+ BB73              .fomFreeze:
5212+ BB73                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5213+ BB73                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5214+ BB73 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5215+ BB77 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5216+ BB7B DD 36 0A 00      LD (IX+ENT_DIR), 0
5217+ BB7F DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5218+ BB83 C9               RET
5219+ BB84
5220+ BB84 00           .fomAdx: DEFB 0
5221+ BB85 00           .fomAdy: DEFB 0
5222+ BB86
5223+ BB86              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5224+ BB86              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5225+ BB86              TryBackoffX:
5226+ BB86 DD 7E 03         LD A, (IX+ENT_POSX)
5227+ BB89 32 B8 BB         LD (.tbxSavePos), A
5228+ BB8C 47               LD B, A
5229+ BB8D 3A F4 82         LD A, (CorpseX)
5230+ BB90 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5231+ BB91 DD 7E 03         LD A, (IX+ENT_POSX)
5232+ BB94 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5233+ BB96 C6 10            ADD A, 16
5234+ BB98 18 02            JR .tbxApply
5235+ BB9A              .tbxNeg:
5236+ BB9A D6 10            SUB 16
5237+ BB9C              .tbxApply:
5238+ BB9C                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5239+ BB9C DD 77 03         LD (IX+ENT_POSX), A
5240+ BB9F FE E8            CP SCREEN_MAX_X
5241+ BBA1 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5242+ BBA3 CD 7A B6         CALL CheckEnemyCollision
5243+ BBA6 20 07            JR NZ, .tbxFail
5244+ BBA8 CD F0 BB         CALL CheckMonsterOverlap
5245+ BBAB 20 02            JR NZ, .tbxFail
5246+ BBAD AF               XOR A                           ; Z = ok
5247+ BBAE C9               RET
5248+ BBAF              .tbxFail:
5249+ BBAF 3A B8 BB         LD A, (.tbxSavePos)
5250+ BBB2 DD 77 03         LD (IX+ENT_POSX), A
5251+ BBB5 F6 01            OR 1                            ; NZ
5252+ BBB7 C9               RET
5253+ BBB8 00           .tbxSavePos: DEFB 0
5254+ BBB9
5255+ BBB9              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5256+ BBB9              TryBackoffY:
5257+ BBB9 DD 7E 04         LD A, (IX+ENT_POSY)
5258+ BBBC 32 EF BB         LD (.tbySavePos), A
5259+ BBBF 47               LD B, A
5260+ BBC0 3A F5 82         LD A, (CorpseY)
5261+ BBC3 B8               CP B
5262+ BBC4 DD 7E 04         LD A, (IX+ENT_POSY)
5263+ BBC7 30 04            JR NC, .tbyNeg
5264+ BBC9 C6 10            ADD A, 16
5265+ BBCB 18 02            JR .tbyApply
5266+ BBCD              .tbyNeg:
5267+ BBCD D6 10            SUB 16
5268+ BBCF              .tbyApply:
5269+ BBCF DD 77 04         LD (IX+ENT_POSY), A
5270+ BBD2 FE 10            CP SCREEN_MIN_Y
5271+ BBD4 38 10            JR C, .tbyFail
5272+ BBD6 FE A8            CP SCREEN_MAX_Y
5273+ BBD8 30 0C            JR NC, .tbyFail
5274+ BBDA CD 7A B6         CALL CheckEnemyCollision
5275+ BBDD 20 07            JR NZ, .tbyFail
5276+ BBDF CD F0 BB         CALL CheckMonsterOverlap
5277+ BBE2 20 02            JR NZ, .tbyFail
5278+ BBE4 AF               XOR A
5279+ BBE5 C9               RET
5280+ BBE6              .tbyFail:
5281+ BBE6 3A EF BB         LD A, (.tbySavePos)
5282+ BBE9 DD 77 04         LD (IX+ENT_POSY), A
5283+ BBEC F6 01            OR 1
5284+ BBEE C9               RET
5285+ BBEF 00           .tbySavePos: DEFB 0
5286+ BBF0
5287+ BBF0              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5288+ BBF0              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5289+ BBF0              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5290+ BBF0              CheckMonsterOverlap:
5291+ BBF0 C5               PUSH BC
5292+ BBF1 FD E5            PUSH IY
5293+ BBF3 FD 21 AE 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5294+ BBF7 06 06            LD B, NUM_MONSTERS
5295+ BBF9              .cmoLoop:
5296+ BBF9                  ; Skip self (IY == IX)
5297+ BBF9 DD E5            PUSH IX
5298+ BBFB E1               POP HL
5299+ BBFC FD E5            PUSH IY
5300+ BBFE D1               POP DE
5301+ BBFF B7               OR A
5302+ BC00 ED 52            SBC HL, DE
5303+ BC02 28 3D            JR Z, .cmoNext                  ; same slot
5304+ BC04
5305+ BC04 FD 7E 01         LD A, (IY+ENT_TYPE)
5306+ BC07 FE 02            CP TYPE_MONSTER
5307+ BC09 20 36            JR NZ, .cmoNext
5308+ BC0B
5309+ BC0B                  ; AABB overlap (rect 16x21 cada uno):
5310+ BC0B                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5311+ BC0B                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5312+ BC0B DD 7E 03         LD A, (IX+ENT_POSX)
5313+ BC0E C6 10            ADD A, 16
5314+ BC10 4F               LD C, A
5315+ BC11 FD 7E 03         LD A, (IY+ENT_POSX)
5316+ BC14 B9               CP C                            ; iy.x cmp ix.x+16
5317+ BC15 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5318+ BC17 FD 7E 03         LD A, (IY+ENT_POSX)
5319+ BC1A C6 10            ADD A, 16
5320+ BC1C 4F               LD C, A
5321+ BC1D DD 7E 03         LD A, (IX+ENT_POSX)
5322+ BC20 B9               CP C
5323+ BC21 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5324+ BC23 DD 7E 04         LD A, (IX+ENT_POSY)
5325+ BC26 C6 15            ADD A, 21
5326+ BC28 4F               LD C, A
5327+ BC29 FD 7E 04         LD A, (IY+ENT_POSY)
5328+ BC2C B9               CP C
5329+ BC2D 30 12            JR NC, .cmoNext
5330+ BC2F FD 7E 04         LD A, (IY+ENT_POSY)
5331+ BC32 C6 15            ADD A, 21
5332+ BC34 4F               LD C, A
5333+ BC35 DD 7E 04         LD A, (IX+ENT_POSY)
5334+ BC38 B9               CP C
5335+ BC39 30 06            JR NC, .cmoNext
5336+ BC3B                  ; Overlap en ambos ejes
5337+ BC3B FD E1            POP IY
5338+ BC3D C1               POP BC
5339+ BC3E F6 01            OR 1                            ; NZ
5340+ BC40 C9               RET
5341+ BC41              .cmoNext:
5342+ BC41 11 10 00         LD DE, ENT_SIZE
5343+ BC44 FD 19            ADD IY, DE
5344+ BC46 10 B1            DJNZ .cmoLoop
5345+ BC48 FD E1            POP IY
5346+ BC4A C1               POP BC
5347+ BC4B AF               XOR A                           ; Z = no overlap
5348+ BC4C C9               RET
5349+ BC4D
5350+ BC4D              ; ==============================================================================
5351+ BC4D              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5352+ BC4D              ; ==============================================================================
5353+ BC4D              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5354+ BC4D              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5355+ BC4D              ; ==============================================================================
5356+ BC4D              KillAllActiveMonsters:
5357+ BC4D AF               XOR A
5358+ BC4E 32 15 B3         LD (MonstersActive), A              ; No respawnear mas
5359+ BC51 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5360+ BC55 06 06            LD B, NUM_MONSTERS
5361+ BC57              .kamLoop:
5362+ BC57 C5               PUSH BC
5363+ BC58 DD 7E 01         LD A, (IX+ENT_TYPE)
5364+ BC5B B7               OR A
5365+ BC5C 28 27            JR Z, .kamSkip                      ; slot vacio
5366+ BC5E FE 02            CP TYPE_MONSTER
5367+ BC60 20 23            JR NZ, .kamSkip                     ; no es monster
5368+ BC62 DD 7E 02         LD A, (IX+ENT_STATE)
5369+ BC65 FE 03            CP STATE_DYING
5370+ BC67 28 1C            JR Z, .kamSkip
5371+ BC69 FE 04            CP STATE_SPAWNING
5372+ BC6B 28 18            JR Z, .kamSkip
5373+ BC6D DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5374+ BC71 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5375+ BC75 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5376+ BC79 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5377+ BC7D DD 36 06 00      LD (IX+ENT_DELTAX), 0
5378+ BC81 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5379+ BC85                  ; ENT_ATTR conservado: puff hereda color del monster
5380+ BC85              .kamSkip:
5381+ BC85 11 10 00         LD DE, ENT_SIZE
5382+ BC88 DD 19            ADD IX, DE
5383+ BC8A C1               POP BC
5384+ BC8B 10 CA            DJNZ .kamLoop
5385+ BC8D C9               RET
