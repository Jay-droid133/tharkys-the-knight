 670+ 69B7              ; ==============================================================================
 671+ 69B7              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
 672+ 69B7              ; ==============================================================================
 673+ 69B7              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
 674+ 69B7              ; comparando ptr_lo/ptr_hi con DE.
 675+ 69B7              ; IN:  DE = ptr buscado.
 676+ 69B7              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
 677+ 69B7              ; Destruye: AF.
 678+ 69B7              ; ==============================================================================
 679+ 69B7              FindPickupEntryByPtr:
 680+ 69B7 21 FB E0         LD HL, PickupTable
 681+ 69BA              .fpeLoop:
 682+ 69BA 7E               LD A, (HL)
 683+ 69BB FE FF            CP $FF
 684+ 69BD 28 18            JR Z, .fpeNotFound
 685+ 69BF E5               PUSH HL
 686+ 69C0 23               INC HL
 686+ 69C1 23             INC HL                         ; -> ptr_lo
 687+ 69C2 7E               LD A, (HL)
 688+ 69C3 BB               CP E
 689+ 69C4 20 08            JR NZ, .fpeNoMatch
 690+ 69C6 23               INC HL
 691+ 69C7 7E               LD A, (HL)
 692+ 69C8 BA               CP D
 693+ 69C9 20 03            JR NZ, .fpeNoMatch
 694+ 69CB E1               POP HL
 695+ 69CC AF               XOR A                                   ; Z = encontrado
 696+ 69CD C9               RET
 697+ 69CE              .fpeNoMatch:
