 236+ F8B9              ; ==============================================================================
 237+ F8B9              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 238+ F8B9              ; ==============================================================================
 239+ F8B9              ; 1. Consume cheque (CurrentKey = 0).
 240+ F8B9              ; 2. Snap player a anchor frente a la puerta, facing N.
 241+ F8B9              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 242+ F8B9              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 243+ F8B9              ;    para limpiar la pantalla durante la cutscene.
 244+ F8B9              ; Destruye: AF, BC, DE, HL, IX.
 245+ F8B9              ; ==============================================================================
 246+ F8B9              StartBankCutscene:
 247+ F8B9 AF               XOR A
 248+ F8BA 32 B1 82         LD (CurrentKey), A                  ; consume cheque
 249+ F8BD 32 CF 82         LD (BankCutsceneKnockIdx), A
 250+ F8C0 32 CE 82         LD (BankCutsceneSubState), A
 251+ F8C3 32 D0 82         LD (BankCutsceneNoIdx), A
 252+ F8C6 32 D1 82         LD (BankCutsceneHandFrame), A
 253+ F8C9 CD EA B9         CALL KillAllActiveNasties           ; nasties → STATE_DYING + puff anim
 254+ F8CC CD E5 60         CALL KillDeathIfActive               ; muerte (slot 11) → puff y despawn
 255+ F8CF                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 256+ F8CF                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 257+ F8CF                  ; cambiamos el sprite a facing N para preparar.
 258+ F8CF CD 2C F9         CALL BankCutsceneFacingNRedraw
 259+ F8D2 CD 12 FC         CALL SFX_Bank_OnStart
 260+ F8D5                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 261+ F8D5                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 262+ F8D5                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 263+ F8D5 3E 64            LD A, BCS_T_PUFF_WAIT
