1901+ ACBF              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1902+ ACBF              ; ==============================================================================
1903+ ACBF              UpdateStamina:
1904+ ACBF                  ; --- Regenerar salud (siempre, lento) ---
1905+ ACBF 3A 99 B5         LD A, (PlayerHealth)
1906+ ACC2 FE 10            CP HEALTH_MAX
1907+ ACC4 28 12            JR Z, .usHealthFull
1908+ ACC6 21 9D B5         LD HL, HealthRegenCtr
1909+ ACC9 34               INC (HL)
1910+ ACCA 7E               LD A, (HL)
1911+ ACCB FE 32            CP HEALTH_REGEN_RATE
1912+ ACCD 38 09            JR C, .usHealthFull
1913+ ACCF 36 00            LD (HL), 0
1914+ ACD1 3A 99 B5         LD A, (PlayerHealth)
1915+ ACD4 3C               INC A
1916+ ACD5 32 99 B5         LD (PlayerHealth), A
1917+ ACD8              .usHealthFull:
1918+ ACD8                  ; --- Stamina: consumir o regenerar ---
1919+ ACD8 DD 7E 02         LD A, (IX+ENT_STATE)
1920+ ACDB FE 02            CP STATE_FIGHTING
1921+ ACDD 28 18            JR Z, .usDrain
1922+ ACDF                  ; No atacando: regenerar
1923+ ACDF 3A 9A B5         LD A, (PlayerStamina)
1924+ ACE2 FE 10            CP STAMINA_MAX
1925+ ACE4 C8               RET Z                               ; Ya al maximo
1926+ ACE5 21 9C B5         LD HL, StaminaRegenCtr
1927+ ACE8 34               INC (HL)
1928+ ACE9 7E               LD A, (HL)
1929+ ACEA FE 19            CP STAMINA_REGEN_RATE
1930+ ACEC D8               RET C                               ; Aun no toca
1931+ ACED 36 00            LD (HL), 0                          ; Reset counter
1932+ ACEF 3A 9A B5         LD A, (PlayerStamina)
1933+ ACF2 3C               INC A
1934+ ACF3 32 9A B5         LD (PlayerStamina), A
1935+ ACF6 C9               RET
1936+ ACF7              .usDrain:
1937+ ACF7                  ; Atacando: consumir stamina
1938+ ACF7 3A 9A B5         LD A, (PlayerStamina)
1939+ ACFA B7               OR A
1940+ ACFB C8               RET Z                               ; Ya vacia
1941+ ACFC 21 9B B5         LD HL, StaminaDrainCtr
1942+ ACFF 34               INC (HL)
1943+ AD00 7E               LD A, (HL)
1944+ AD01 FE 0D            CP STAMINA_DRAIN_RATE
1945+ AD03 D8               RET C
1946+ AD04 36 00            LD (HL), 0
1947+ AD06 3A 9A B5         LD A, (PlayerStamina)
1948+ AD09 3D               DEC A
1949+ AD0A 32 9A B5         LD (PlayerStamina), A
1950+ AD0D                  ; Si stamina llega a 0, dar 1 punto tras cooldown
1951+ AD0D B7               OR A
1952+ AD0E C0               RET NZ
1953+ AD0F 3E 01            LD A, 1
1954+ AD11 32 9A B5         LD (PlayerStamina), A               ; Minimo 1 para un swing
1955+ AD14 C9               RET
