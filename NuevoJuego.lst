 368+ 88DF              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 369+ 88DF              ; ==============================================================================
 370+ 88DF              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 371+ 88DF              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 372+ 88DF              ;
 373+ 88DF              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 374+ 88DF              ; ==============================================================================
 375+ 88DF              RestoreEntityAttr:
 376+ 88DF CD 79 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 377+ 88E2 11 FF 88         LD DE, EntitySavedAttr      ; DE = buffer fuente
 378+ 88E5
 379+ 88E5 3A 10 89         LD A, (EntityAttrH)
 380+ 88E8 4F               LD C, A
 381+ 88E9              .restRow:
 382+ 88E9 3A 0F 89         LD A, (EntityAttrW)
 383+ 88EC 47               LD B, A
 384+ 88ED E5               PUSH HL
 385+ 88EE              .restCol:
 386+ 88EE 1A               LD A, (DE)
 387+ 88EF 77               LD (HL), A
 388+ 88F0 23               INC HL
 389+ 88F1 13               INC DE
 390+ 88F2 10 FA            DJNZ .restCol
 391+ 88F4 E1               POP HL
 392+ 88F5 D5               PUSH DE
 393+ 88F6 11 20 00         LD DE, 32
 394+ 88F9 19               ADD HL, DE
 395+ 88FA D1               POP DE
 396+ 88FB 0D               DEC C
 397+ 88FC 20 EB            JR NZ, .restRow
 398+ 88FE C9               RET
 399+ 88FF
 400+ 88FF              ; --- Buffer de atributos guardados POR ENTIDAD ---
 401+ 88FF              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 402+ 88FF              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 403+ 88FF              ; ---
 404+ 88FF 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 405+ 890F 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 406+ 8910 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 407+ 8911 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 408+ 8A43 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 409+ 8A44
 410+ 8A44              ; ==============================================================================
 411+ 8A44              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 412+ 8A44              ; ==============================================================================
 413+ 8A44              ; Entrada: A = indice de entidad (0-16)
 414+ 8A44              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 415+ 8A44              ; ==============================================================================
 416+ 8A44              SetAttrSlot:
 417+ 8A44 32 43 8A         LD (CurrentAttrSlot), A
 418+ 8A47                  ; Calcular offset: A * 18
 419+ 8A47 6F               LD L, A
 420+ 8A48 26 00            LD H, 0
 421+ 8A4A 29               ADD HL, HL                  ; x2
 422+ 8A4B 54               LD D, H
 423+ 8A4C 5D               LD E, L                     ; DE = x2
 424+ 8A4D 29               ADD HL, HL                  ; x4
 425+ 8A4E 29               ADD HL, HL                  ; x8
 426+ 8A4F 29               ADD HL, HL                  ; x16
 427+ 8A50 19               ADD HL, DE                  ; x18
 428+ 8A51 11 11 89         LD DE, SavedAttrTable
 429+ 8A54 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 430+ 8A55                  ; Copiar 18 bytes a EntitySavedAttr
 431+ 8A55 11 FF 88         LD DE, EntitySavedAttr
 432+ 8A58 01 12 00         LD BC, 18
 433+ 8A5B ED B0            LDIR
 434+ 8A5D C9               RET
 435+ 8A5E
 436+ 8A5E              ; ==============================================================================
 437+ 8A5E              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 438+ 8A5E              ; ==============================================================================
 439+ 8A5E              FlushAttrSlot:
 440+ 8A5E 3A 43 8A         LD A, (CurrentAttrSlot)
 441+ 8A61 6F               LD L, A
 442+ 8A62 26 00            LD H, 0
 443+ 8A64 29               ADD HL, HL                  ; x2
 444+ 8A65 54               LD D, H
 445+ 8A66 5D               LD E, L
 446+ 8A67 29               ADD HL, HL                  ; x4
 447+ 8A68 29               ADD HL, HL                  ; x8
 448+ 8A69 29               ADD HL, HL                  ; x16
 449+ 8A6A 19               ADD HL, DE                  ; x18
 450+ 8A6B 11 11 89         LD DE, SavedAttrTable
 451+ 8A6E 19               ADD HL, DE                  ; HL = destino en tabla
 452+ 8A6F EB               EX DE, HL                   ; DE = destino
 453+ 8A70 21 FF 88         LD HL, EntitySavedAttr      ; HL = fuente
 454+ 8A73 01 12 00         LD BC, 18
 455+ 8A76 ED B0            LDIR
 456+ 8A78 C9               RET
 457+ 8A79
 458+ 8A79              ; ==============================================================================
 459+ 8A79              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 460+ 8A79              ; ==============================================================================
 461+ 8A79              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 462+ 8A79              ; Salida: HL = direccion en zona de atributos ($5800+)
 463+ 8A79              ; ==============================================================================
 464+ 8A79              CalcAttrAddr:
 465+ 8A79 7A               LD A, D
 466+ 8A7A 0F               RRCA
 467+ 8A7B 0F               RRCA
 468+ 8A7C 0F               RRCA
 469+ 8A7D E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 470+ 8A7F 6F               LD L, A
 471+ 8A80 26 00            LD H, 0
 472+ 8A82 29               ADD HL, HL
 473+ 8A83 29               ADD HL, HL
 474+ 8A84 29               ADD HL, HL
 475+ 8A85 29               ADD HL, HL
 476+ 8A86 29               ADD HL, HL                  ; HL = fila * 32
 477+ 8A87 7B               LD A, E
 478+ 8A88 0F               RRCA
 479+ 8A89 0F               RRCA
 480+ 8A8A 0F               RRCA
 481+ 8A8B E6 1F            AND $1F                     ; X / 8 = columna
 482+ 8A8D B5               OR L
 483+ 8A8E 6F               LD L, A
 484+ 8A8F 01 00 58         LD BC, ATTR_BASE
 485+ 8A92 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 486+ 8A93 C9               RET
 487+ 8A94
 488+ 8A94              ; ==============================================================================
 489+ 8A94              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 490+ 8A94              ; ==============================================================================
 491+ 8A94              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 492+ 8A94              ; Salida: HL=direccion en VRAM
 493+ 8A94              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 494+ 8A94              ; ==============================================================================
 495+ 8A94              CalcPixelAddr:
 496+ 8A94 7A               LD A, D
 497+ 8A95 E6 C0            AND $C0                     ; Y7 Y6
 498+ 8A97 1F               RRA
 499+ 8A98 1F               RRA
 500+ 8A99 1F               RRA                         ; >> 3
 501+ 8A9A F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 502+ 8A9C 67               LD H, A
 503+ 8A9D
 504+ 8A9D 7A               LD A, D
 505+ 8A9E E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 506+ 8AA0 B4               OR H
 507+ 8AA1 67               LD H, A
 508+ 8AA2
 509+ 8AA2 7A               LD A, D
 510+ 8AA3 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 511+ 8AA5 87               ADD A, A
 512+ 8AA6 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 513+ 8AA7 6F               LD L, A
 514+ 8AA8
 515+ 8AA8 7B               LD A, E
 516+ 8AA9 1F               RRA
 517+ 8AAA 1F               RRA
 518+ 8AAB 1F               RRA
 519+ 8AAC E6 1F            AND $1F                     ; X / 8 = columna
 520+ 8AAE B5               OR L
 521+ 8AAF 6F               LD L, A
 522+ 8AB0 C9               RET
 523+ 8AB1
 524+ 8AB1              ; ==============================================================================
 525+ 8AB1              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 526+ 8AB1              ; ==============================================================================
 527+ 8AB1              DrawDebugInfo:
 528+ 8AB1 3A AC 81         LD A, (CurrentScreenX)
 529+ 8AB4 1E 00            LD E, 0
 530+ 8AB6 CD D3 8A         CALL .drawHexDigit
 531+ 8AB9
 532+ 8AB9 3E 2C            LD A, ','
 533+ 8ABB 1E 01            LD E, 1
 534+ 8ABD CD DF 8A         CALL .drawChar
 535+ 8AC0
 536+ 8AC0 3A AD 81         LD A, (CurrentScreenY)
 537+ 8AC3 1E 02            LD E, 2
 538+ 8AC5 CD D3 8A         CALL .drawHexDigit
 539+ 8AC8
 540+ 8AC8 21 00 58         LD HL, ATTR_BASE
 541+ 8ACB 3E 47            LD A, WHITE | $40
 542+ 8ACD 77               LD (HL), A
 543+ 8ACE 23               INC HL
 544+ 8ACF 77               LD (HL), A
 545+ 8AD0 23               INC HL
 546+ 8AD1 77               LD (HL), A
 547+ 8AD2 C9               RET
 548+ 8AD3
 549+ 8AD3              .drawHexDigit:
 550+ 8AD3 E6 0F            AND $0F
 551+ 8AD5 FE 0A            CP 10
 552+ 8AD7 38 04            JR C, .isNum
 553+ 8AD9 C6 37            ADD A, 'A' - 10
 554+ 8ADB 18 02            JR .drawChar
 555+ 8ADD              .isNum:
 556+ 8ADD C6 30            ADD A, '0'
 557+ 8ADF              .drawChar:
 558+ 8ADF 6F               LD L, A
 559+ 8AE0 26 00            LD H, 0
 560+ 8AE2 29               ADD HL, HL
 561+ 8AE3 29               ADD HL, HL
 562+ 8AE4 29               ADD HL, HL
 563+ 8AE5 01 00 3C         LD BC, $3C00
 564+ 8AE8 09               ADD HL, BC
 565+ 8AE9
 566+ 8AE9 16 40            LD D, $40
 567+ 8AEB 06 08            LD B, 8
 568+ 8AED              .charLoop:
 569+ 8AED 7E               LD A, (HL)
 570+ 8AEE 12               LD (DE), A
 571+ 8AEF 23               INC HL
 572+ 8AF0 14               INC D
 573+ 8AF1 10 FA            DJNZ .charLoop
 574+ 8AF3 C9               RET
