4933+ BA2D              ; ==============================================================================
4934+ BA2D              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4935+ BA2D              ; ==============================================================================
4936+ BA2D              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4937+ BA2D              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4938+ BA2D              ; ==============================================================================
4939+ BA2D              KillAllActiveNasties:
4940+ BA2D DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4941+ BA31 06 03            LD B, NUM_NASTIES
4942+ BA33              .kanLoop:
4943+ BA33 C5               PUSH BC
4944+ BA34 DD 7E 01         LD A, (IX+ENT_TYPE)
4945+ BA37 B7               OR A
4946+ BA38 28 26            JR Z, .kanSkip                  ; slot vacio
4947+ BA3A FE 03            CP TYPE_NASTY
4948+ BA3C 20 22            JR NZ, .kanSkip                 ; no es nasty
4949+ BA3E DD 7E 02         LD A, (IX+ENT_STATE)
4950+ BA41 FE 03            CP STATE_DYING
4951+ BA43 28 1B            JR Z, .kanSkip                  ; ya muriendo
4952+ BA45                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4953+ BA45                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4954+ BA45                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4955+ BA45                  ; del nasty: peDying paintea el rect del puff con ese color)
4956+ BA45 CD 69 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4957+ BA48 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4958+ BA4C DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4959+ BA50 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4960+ BA54 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4961+ BA58 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4962+ BA5C DD 36 07 00      LD (IX+ENT_DELTAY), 0
4963+ BA60              .kanSkip:
4964+ BA60 11 10 00         LD DE, ENT_SIZE
4965+ BA63 DD 19            ADD IX, DE
4966+ BA65 C1               POP BC
4967+ BA66 10 CB            DJNZ .kanLoop
4968+ BA68 C9               RET
4969+ BA69
4970+ BA69              ; ==============================================================================
4971+ BA69              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4972+ BA69              ; ==============================================================================
4973+ BA69              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4974+ BA69              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4975+ BA69              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4976+ BA69              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4977+ BA69              ; deja la posicion original (puff puede asomar levemente, raro).
4978+ BA69              ; IN:  IX = nasty entity.
4979+ BA69              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4980+ BA69              ; Destruye: AF, BC, DE, HL.
4981+ BA69              ; ==============================================================================
4982+ BA69              SnapPuffPos:
4983+ BA69 DD 7E 03         LD A, (IX+ENT_POSX)
4984+ BA6C 32 DF BA         LD (.sppOrigX), A
4985+ BA6F E6 F8            AND $F8
4986+ BA71 32 E1 BA         LD (.sppBaseX), A                   ; base char-aligned X
4987+ BA74 DD 7E 04         LD A, (IX+ENT_POSY)
4988+ BA77 32 E0 BA         LD (.sppOrigY), A
4989+ BA7A E6 F8            AND $F8
4990+ BA7C 32 E2 BA         LD (.sppBaseY), A                   ; base char-aligned Y
4991+ BA7F
4992+ BA7F                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4993+ BA7F CD B3 BA         CALL .sppCheckFit
4994+ BA82 C8               RET Z
4995+ BA83
4996+ BA83                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4997+ BA83                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4998+ BA83 21 E3 BA         LD HL, .sppShifts
4999+ BA86              .sppLoop:
5000+ BA86 7E               LD A, (HL)
5001+ BA87 23               INC HL
5002+ BA88 47               LD B, A                             ; dx (signed)
5003+ BA89 7E               LD A, (HL)
5004+ BA8A 23               INC HL
5005+ BA8B FE 80            CP $80
5006+ BA8D 28 17            JR Z, .sppFail                      ; sentinel
5007+ BA8F 4F               LD C, A                             ; dy (signed)
5008+ BA90
5009+ BA90 3A E1 BA         LD A, (.sppBaseX)
5010+ BA93 80               ADD A, B
5011+ BA94 DD 77 03         LD (IX+ENT_POSX), A
5012+ BA97 3A E2 BA         LD A, (.sppBaseY)
5013+ BA9A 81               ADD A, C
5014+ BA9B DD 77 04         LD (IX+ENT_POSY), A
5015+ BA9E
5016+ BA9E E5               PUSH HL
5017+ BA9F CD B3 BA         CALL .sppCheckFit
5018+ BAA2 E1               POP HL
5019+ BAA3 C8               RET Z                               ; encontrado
5020+ BAA4 18 E0            JR .sppLoop
5021+ BAA6
5022+ BAA6              .sppFail:
5023+ BAA6 3A DF BA         LD A, (.sppOrigX)
5024+ BAA9 DD 77 03         LD (IX+ENT_POSX), A
5025+ BAAC 3A E0 BA         LD A, (.sppOrigY)
5026+ BAAF DD 77 04         LD (IX+ENT_POSY), A
5027+ BAB2 C9               RET
5028+ BAB3
5029+ BAB3              ; --- .sppCheckFit ---
5030+ BAB3              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5031+ BAB3              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5032+ BAB3              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5033+ BAB3              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5034+ BAB3              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5035+ BAB3              .sppCheckFit:
5036+ BAB3                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5037+ BAB3 DD 7E 03         LD A, (IX+ENT_POSX)
5038+ BAB6 FE D1            CP SCREEN_MAX_X - 23
5039+ BAB8 30 21            JR NC, .sppOutOfBounds
5040+ BABA DD 7E 04         LD A, (IX+ENT_POSY)
5041+ BABD FE 10            CP SCREEN_MIN_Y
5042+ BABF 38 1A            JR C, .sppOutOfBounds
5043+ BAC1 FE 91            CP SCREEN_MAX_Y - 23
5044+ BAC3 30 16            JR NC, .sppOutOfBounds
5045+ BAC5                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5046+ BAC5 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5047+ BAC8 32 DE BA         LD (.sppSpritIdSave), A
5048+ BACB DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5049+ BACF CD BD B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5050+ BAD2 F5               PUSH AF
5051+ BAD3 3A DE BA         LD A, (.sppSpritIdSave)
5052+ BAD6 DD 77 00         LD (IX+ENT_SPRITEID), A
5053+ BAD9 F1               POP AF
5054+ BADA C9               RET
5055+ BADB              .sppOutOfBounds:
5056+ BADB F6 01            OR 1                                ; NZ
5057+ BADD C9               RET
5058+ BADE
5059+ BADE 00           .sppSpritIdSave: DEFB 0
5060+ BADF
5061+ BADF 00           .sppOrigX: DEFB 0
5062+ BAE0 00           .sppOrigY: DEFB 0
5063+ BAE1 00           .sppBaseX: DEFB 0
5064+ BAE2 00           .sppBaseY: DEFB 0
5065+ BAE3              .sppShifts:
5066+ BAE3                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5067+ BAE3                  ; Distancia creciente. Sentinel: dy=$80.
5068+ BAE3 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5069+ BAE5 00 F8            DEFB 0,   -8                        ; arriba 8
5070+ BAE7 00 08            DEFB 0,    8                        ; abajo 8
5071+ BAE9 F8 00            DEFB -8,   0                        ; izq 8
5072+ BAEB 08 00            DEFB 8,    0                        ; der 8
5073+ BAED 00 F0            DEFB 0,  -16                        ; arriba 16
5074+ BAEF 00 10            DEFB 0,   16                        ; abajo 16
5075+ BAF1 F8 F8            DEFB -8,  -8
5076+ BAF3 08 F8            DEFB 8,   -8
5077+ BAF5 F8 08            DEFB -8,   8
5078+ BAF7 08 08            DEFB 8,    8
5079+ BAF9 00 80            DEFB 0,  $80                        ; sentinel
5080+ BAFB
5081+ BAFB              ; ==============================================================================
5082+ BAFB              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5083+ BAFB              ; ==============================================================================
5084+ BAFB              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5085+ BAFB              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5086+ BAFB              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5087+ BAFB              ; DeathSpawned. No-op si la muerte no esta activa.
5088+ BAFB              ; ==============================================================================
5089+ BAFB              SilentKillDeath:
5090+ BAFB DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5091+ BAFF DD 7E 01         LD A, (IX+ENT_TYPE)
5092+ BB02 B7               OR A
5093+ BB03 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5094+ BB05 CD 06 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5095+ BB08 AF               XOR A
5096+ BB09 DD 77 01         LD (IX+ENT_TYPE), A
5097+ BB0C 32 FA 82         LD (DeathSpawned), A
5098+ BB0F              .skdResetTimer:
5099+ BB0F                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5100+ BB0F                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5101+ BB0F 21 00 00         LD HL, 0
5102+ BB12 22 F7 82         LD (DeathScreenTimer), HL
5103+ BB15                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5104+ BB15                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5105+ BB15                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5106+ BB15                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5107+ BB15                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5108+ BB15 C9               RET
5109+ BB16
5110+ BB16              ; ==============================================================================
5111+ BB16              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5112+ BB16              ; ==============================================================================
5113+ BB16              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5114+ BB16              ; no DYING ni SPAWNING):
5115+ BB16              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5116+ BB16              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5117+ BB16              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5118+ BB16              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5119+ BB16              ;     Si tampoco, deja el monster donde estaba.
5120+ BB16              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5121+ BB16              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5122+ BB16              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5123+ BB16              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5124+ BB16              ; ==============================================================================
5125+ BB16              FreezeMonstersFacingCorpse:
5126+ BB16                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5127+ BB16 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5128+ BB19 32 F1 82         LD (CorpseX), A
5129+ BB1C 3A 9F 81         LD A, (EntityTable + ENT_POSY)
5130+ BB1F 32 F2 82         LD (CorpseY), A
5131+ BB22                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5132+ BB22                  ; ya skipea; no aplica aqui pero por simetria)
5133+ BB22 3E 01            LD A, 1
5134+ BB24 32 F0 82         LD (MonstersFrozen), A
5135+ BB27 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5136+ BB2B 06 06            LD B, NUM_MONSTERS
5137+ BB2D              .fmcLoop:
5138+ BB2D C5               PUSH BC
5139+ BB2E DD 7E 01         LD A, (IX+ENT_TYPE)
5140+ BB31 FE 02            CP TYPE_MONSTER
5141+ BB33 20 0E            JR NZ, .fmcNext
5142+ BB35 DD 7E 02         LD A, (IX+ENT_STATE)
5143+ BB38 FE 03            CP STATE_DYING
5144+ BB3A 28 07            JR Z, .fmcNext
5145+ BB3C FE 04            CP STATE_SPAWNING
5146+ BB3E 28 03            JR Z, .fmcNext
5147+ BB40 CD 4C BB         CALL FreezeOneMonster
5148+ BB43              .fmcNext:
5149+ BB43 C1               POP BC
5150+ BB44 11 10 00         LD DE, ENT_SIZE
5151+ BB47 DD 19            ADD IX, DE
5152+ BB49 10 E2            DJNZ .fmcLoop
5153+ BB4B C9               RET
5154+ BB4C
5155+ BB4C              ; --- FreezeOneMonster ---
5156+ BB4C              ; IX = monster slot pointer.
5157+ BB4C              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5158+ BB4C              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5159+ BB4C              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5160+ BB4C              FreezeOneMonster:
5161+ BB4C                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5162+ BB4C                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5163+ BB4C                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5164+ BB4C DD 7E 03         LD A, (IX+ENT_POSX)
5165+ BB4F 47               LD B, A
5166+ BB50 3A F1 82         LD A, (CorpseX)
5167+ BB53 B8               CP B
5168+ BB54 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5169+ BB56 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5170+ BB58              .fomFaceE:
5171+ BB58 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5172+ BB5B C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5173+ BB5D DD 77 00         LD (IX+ENT_SPRITEID), A
5174+ BB60 18 08            JR .fomFaceDone
5175+ BB62              .fomFaceW:
5176+ BB62 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5177+ BB65 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5178+ BB67 DD 77 00         LD (IX+ENT_SPRITEID), A
5179+ BB6A              .fomFaceDone:
5180+ BB6A
5181+ BB6A                  ; --- 2) Computar |dx| y |dy| ---
5182+ BB6A 3A F1 82         LD A, (CorpseX)
5183+ BB6D 4F               LD C, A
5184+ BB6E DD 7E 03         LD A, (IX+ENT_POSX)
5185+ BB71 91               SUB C                           ; A = posX - corpseX (signed)
5186+ BB72 30 02            JR NC, .fomDxPos
5187+ BB74 ED 44            NEG
5188+ BB76              .fomDxPos:
5189+ BB76 32 C7 BB         LD (.fomAdx), A
5190+ BB79 3A F2 82         LD A, (CorpseY)
5191+ BB7C 4F               LD C, A
5192+ BB7D DD 7E 04         LD A, (IX+ENT_POSY)
5193+ BB80 91               SUB C
5194+ BB81 30 02            JR NC, .fomDyPos
5195+ BB83 ED 44            NEG
5196+ BB85              .fomDyPos:
5197+ BB85 32 C8 BB         LD (.fomAdy), A
5198+ BB88
5199+ BB88                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5200+ BB88 3A C7 BB         LD A, (.fomAdx)
5201+ BB8B FE 10            CP 16
5202+ BB8D D2 B6 BB         JP NC, .fomFreeze
5203+ BB90 3A C8 BB         LD A, (.fomAdy)
5204+ BB93 FE 10            CP 16
5205+ BB95 D2 B6 BB         JP NC, .fomFreeze
5206+ BB98
5207+ BB98                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5208+ BB98 3A C7 BB         LD A, (.fomAdx)
5209+ BB9B 47               LD B, A
5210+ BB9C 3A C8 BB         LD A, (.fomAdy)
5211+ BB9F B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5212+ BBA0 38 0C            JR C, .fomTryX
5213+ BBA2 28 0A            JR Z, .fomTryX
5214+ BBA4                  ; |dy| > |dx| -> intentar Y primero
5215+ BBA4 CD FC BB         CALL TryBackoffY
5216+ BBA7 28 0D            JR Z, .fomFreeze                ; ok
5217+ BBA9 CD C9 BB         CALL TryBackoffX
5218+ BBAC 18 08            JR .fomFreeze
5219+ BBAE              .fomTryX:
5220+ BBAE CD C9 BB         CALL TryBackoffX
5221+ BBB1 28 03            JR Z, .fomFreeze
5222+ BBB3 CD FC BB         CALL TryBackoffY
5223+ BBB6
5224+ BBB6              .fomFreeze:
5225+ BBB6                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5226+ BBB6                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5227+ BBB6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5228+ BBBA DD 36 07 00      LD (IX+ENT_DELTAY), 0
5229+ BBBE DD 36 0A 00      LD (IX+ENT_DIR), 0
5230+ BBC2 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5231+ BBC6 C9               RET
5232+ BBC7
5233+ BBC7 00           .fomAdx: DEFB 0
5234+ BBC8 00           .fomAdy: DEFB 0
5235+ BBC9
5236+ BBC9              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5237+ BBC9              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5238+ BBC9              TryBackoffX:
5239+ BBC9 DD 7E 03         LD A, (IX+ENT_POSX)
5240+ BBCC 32 FB BB         LD (.tbxSavePos), A
5241+ BBCF 47               LD B, A
5242+ BBD0 3A F1 82         LD A, (CorpseX)
5243+ BBD3 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5244+ BBD4 DD 7E 03         LD A, (IX+ENT_POSX)
5245+ BBD7 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5246+ BBD9 C6 10            ADD A, 16
5247+ BBDB 18 02            JR .tbxApply
5248+ BBDD              .tbxNeg:
5249+ BBDD D6 10            SUB 16
5250+ BBDF              .tbxApply:
5251+ BBDF                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5252+ BBDF DD 77 03         LD (IX+ENT_POSX), A
5253+ BBE2 FE E8            CP SCREEN_MAX_X
5254+ BBE4 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5255+ BBE6 CD BD B6         CALL CheckEnemyCollision
5256+ BBE9 20 07            JR NZ, .tbxFail
5257+ BBEB CD 33 BC         CALL CheckMonsterOverlap
5258+ BBEE 20 02            JR NZ, .tbxFail
5259+ BBF0 AF               XOR A                           ; Z = ok
5260+ BBF1 C9               RET
5261+ BBF2              .tbxFail:
5262+ BBF2 3A FB BB         LD A, (.tbxSavePos)
5263+ BBF5 DD 77 03         LD (IX+ENT_POSX), A
5264+ BBF8 F6 01            OR 1                            ; NZ
5265+ BBFA C9               RET
5266+ BBFB 00           .tbxSavePos: DEFB 0
5267+ BBFC
5268+ BBFC              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5269+ BBFC              TryBackoffY:
5270+ BBFC DD 7E 04         LD A, (IX+ENT_POSY)
5271+ BBFF 32 32 BC         LD (.tbySavePos), A
5272+ BC02 47               LD B, A
5273+ BC03 3A F2 82         LD A, (CorpseY)
5274+ BC06 B8               CP B
5275+ BC07 DD 7E 04         LD A, (IX+ENT_POSY)
5276+ BC0A 30 04            JR NC, .tbyNeg
5277+ BC0C C6 10            ADD A, 16
5278+ BC0E 18 02            JR .tbyApply
5279+ BC10              .tbyNeg:
5280+ BC10 D6 10            SUB 16
5281+ BC12              .tbyApply:
5282+ BC12 DD 77 04         LD (IX+ENT_POSY), A
5283+ BC15 FE 10            CP SCREEN_MIN_Y
5284+ BC17 38 10            JR C, .tbyFail
5285+ BC19 FE A8            CP SCREEN_MAX_Y
5286+ BC1B 30 0C            JR NC, .tbyFail
5287+ BC1D CD BD B6         CALL CheckEnemyCollision
5288+ BC20 20 07            JR NZ, .tbyFail
5289+ BC22 CD 33 BC         CALL CheckMonsterOverlap
5290+ BC25 20 02            JR NZ, .tbyFail
5291+ BC27 AF               XOR A
5292+ BC28 C9               RET
5293+ BC29              .tbyFail:
5294+ BC29 3A 32 BC         LD A, (.tbySavePos)
5295+ BC2C DD 77 04         LD (IX+ENT_POSY), A
5296+ BC2F F6 01            OR 1
5297+ BC31 C9               RET
5298+ BC32 00           .tbySavePos: DEFB 0
5299+ BC33
5300+ BC33              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5301+ BC33              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5302+ BC33              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5303+ BC33              CheckMonsterOverlap:
5304+ BC33 C5               PUSH BC
5305+ BC34 FD E5            PUSH IY
5306+ BC36 FD 21 AB 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5307+ BC3A 06 06            LD B, NUM_MONSTERS
5308+ BC3C              .cmoLoop:
5309+ BC3C                  ; Skip self (IY == IX)
5310+ BC3C DD E5            PUSH IX
5311+ BC3E E1               POP HL
5312+ BC3F FD E5            PUSH IY
5313+ BC41 D1               POP DE
5314+ BC42 B7               OR A
5315+ BC43 ED 52            SBC HL, DE
5316+ BC45 28 3D            JR Z, .cmoNext                  ; same slot
5317+ BC47
5318+ BC47 FD 7E 01         LD A, (IY+ENT_TYPE)
5319+ BC4A FE 02            CP TYPE_MONSTER
5320+ BC4C 20 36            JR NZ, .cmoNext
5321+ BC4E
5322+ BC4E                  ; AABB overlap (rect 16x21 cada uno):
5323+ BC4E                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5324+ BC4E                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5325+ BC4E DD 7E 03         LD A, (IX+ENT_POSX)
5326+ BC51 C6 10            ADD A, 16
5327+ BC53 4F               LD C, A
5328+ BC54 FD 7E 03         LD A, (IY+ENT_POSX)
5329+ BC57 B9               CP C                            ; iy.x cmp ix.x+16
5330+ BC58 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5331+ BC5A FD 7E 03         LD A, (IY+ENT_POSX)
5332+ BC5D C6 10            ADD A, 16
5333+ BC5F 4F               LD C, A
5334+ BC60 DD 7E 03         LD A, (IX+ENT_POSX)
5335+ BC63 B9               CP C
5336+ BC64 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5337+ BC66 DD 7E 04         LD A, (IX+ENT_POSY)
5338+ BC69 C6 15            ADD A, 21
5339+ BC6B 4F               LD C, A
5340+ BC6C FD 7E 04         LD A, (IY+ENT_POSY)
5341+ BC6F B9               CP C
5342+ BC70 30 12            JR NC, .cmoNext
5343+ BC72 FD 7E 04         LD A, (IY+ENT_POSY)
5344+ BC75 C6 15            ADD A, 21
5345+ BC77 4F               LD C, A
5346+ BC78 DD 7E 04         LD A, (IX+ENT_POSY)
5347+ BC7B B9               CP C
5348+ BC7C 30 06            JR NC, .cmoNext
5349+ BC7E                  ; Overlap en ambos ejes
5350+ BC7E FD E1            POP IY
5351+ BC80 C1               POP BC
5352+ BC81 F6 01            OR 1                            ; NZ
5353+ BC83 C9               RET
5354+ BC84              .cmoNext:
5355+ BC84 11 10 00         LD DE, ENT_SIZE
5356+ BC87 FD 19            ADD IY, DE
5357+ BC89 10 B1            DJNZ .cmoLoop
5358+ BC8B FD E1            POP IY
5359+ BC8D C1               POP BC
5360+ BC8E AF               XOR A                           ; Z = no overlap
5361+ BC8F C9               RET
5362+ BC90
5363+ BC90              ; ==============================================================================
5364+ BC90              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5365+ BC90              ; ==============================================================================
5366+ BC90              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5367+ BC90              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5368+ BC90              ; ==============================================================================
5369+ BC90              KillAllActiveMonsters:
5370+ BC90 AF               XOR A
5371+ BC91 32 58 B3         LD (MonstersActive), A              ; No respawnear mas
5372+ BC94 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5373+ BC98 06 06            LD B, NUM_MONSTERS
5374+ BC9A              .kamLoop:
5375+ BC9A C5               PUSH BC
5376+ BC9B DD 7E 01         LD A, (IX+ENT_TYPE)
5377+ BC9E B7               OR A
5378+ BC9F 28 27            JR Z, .kamSkip                      ; slot vacio
5379+ BCA1 FE 02            CP TYPE_MONSTER
5380+ BCA3 20 23            JR NZ, .kamSkip                     ; no es monster
5381+ BCA5 DD 7E 02         LD A, (IX+ENT_STATE)
5382+ BCA8 FE 03            CP STATE_DYING
5383+ BCAA 28 1C            JR Z, .kamSkip
5384+ BCAC FE 04            CP STATE_SPAWNING
5385+ BCAE 28 18            JR Z, .kamSkip
5386+ BCB0 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5387+ BCB4 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5388+ BCB8 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5389+ BCBC DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5390+ BCC0 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5391+ BCC4 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5392+ BCC8                  ; ENT_ATTR conservado: puff hereda color del monster
5393+ BCC8              .kamSkip:
5394+ BCC8 11 10 00         LD DE, ENT_SIZE
5395+ BCCB DD 19            ADD IX, DE
5396+ BCCD C1               POP BC
5397+ BCCE 10 CA            DJNZ .kamLoop
5398+ BCD0 C9               RET
5399+ BCD1
5400+ BCD1              ; --- Tabla de tipos de nasty (SpriteID base) ---
5401+ BCD1              ; --- Tablas de nasties por momento del dia ---
5402+ BCD1              NUM_NASTY_TYPES EQU 4
5403+ BCD1              DiurnalTypeTable:                       ; DY, C1, A2
5404+ BCD1 30               DEFB SPRID_ENEMY_4          ; Eagle
5405+ BCD2 20               DEFB SPRID_ENEMY_0          ; Spider
5406+ BCD3 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5407+ BCD4 2C               DEFB SPRID_ENEMY_3          ; Snake
5408+ BCD5              CrepuscularTypeTable:                   ; C2, N1
5409+ BCD5 34               DEFB SPRID_ENEMY_5          ; Rat
5410+ BCD6 28               DEFB SPRID_ENEMY_2          ; Bat
5411+ BCD7 24               DEFB SPRID_ENEMY_1          ; Scorpion
5412+ BCD8 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5413+ BCD9
5414+ BCD9              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5415+ BCD9              NastyColorTable:
5416+ BCD9 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5417+ BCDA 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5418+ BCDB 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5419+ BCDC 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5420+ BCDD 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5421+ BCDE 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5422+ BCDF 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5423+ BCE0 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5424+ BCE1
5425+ BCE1              ; --- Tabla de comportamiento depredador ---
5426+ BCE1              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5427+ BCE1              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5428+ BCE1              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5429+ BCE1              PredatorTable:
5430+ BCE1 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5431+ BCE2 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5432+ BCE3 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5433+ BCE4 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5434+ BCE5 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5435+ BCE6 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5436+ BCE7 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5437+ BCE8 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5438+ BCE9
5439+ BCE9              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5440+ BCE9              PredatorSpeedTable:
5441+ BCE9 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5442+ BCEA 02               DEFB 2                              ; Ciclo 1: lento
5443+ BCEB 03               DEFB 3                              ; Ciclo 2: intermedio
5444+ BCEC 04               DEFB 4                              ; Ciclo 3+: rapido
5445+ BCED
5446+ BCED 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5447+ BCEE
5448+ BCEE D1 BC        CurrentNastyTable: DEFW DiurnalTypeTable
5449+ BCF0
5450+ BCF0              ; ==============================================================================
5451+ BCF0              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5452+ BCF0              ; ==============================================================================
5453+ BCF0              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5454+ BCF0              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5455+ BCF0              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5456+ BCF0              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5457+ BCF0              ;   pantalla, no diurnos.
5458+ BCF0              ; ==============================================================================
5459+ BCF0              UpdateNastyTable:
5460+ BCF0 3A D0 E2         LD A, (CurrentTimeOfDay)
5461+ BCF3 FE 02            CP 2
5462+ BCF5 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5463+ BCF7 FE 06            CP 6
5464+ BCF9 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5465+ BCFB 21 D5 BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5466+ BCFE 18 03            JR .setTable
5467+ BD00              .diurnal:
5468+ BD00 21 D1 BC         LD HL, DiurnalTypeTable
5469+ BD03              .setTable:
5470+ BD03 22 EE BC         LD (CurrentNastyTable), HL
5471+ BD06 C9               RET
5472+ BD07
5473+ BD07              ; ==============================================================================
5474+ BD07              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5475+ BD07              ; ==============================================================================
5476+ BD07              ScareAllMonsters:
5477+ BD07 AF               XOR A
5478+ BD08 32 58 B3         LD (MonstersActive), A              ; No respawnear mas
5479+ BD0B                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5480+ BD0B                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5481+ BD0B                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5482+ BD0B 21 93 8D         LD HL, MonsterAiFlags
5483+ BD0E 06 03            LD B, 3
5484+ BD10              .samClearLoop:
5485+ BD10 7E               LD A, (HL)
5486+ BD11 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5487+ BD13 77               LD (HL), A
5488+ BD14 23               INC HL
5489+ BD15 10 F9            DJNZ .samClearLoop
5490+ BD17 3E 7D            LD A, SCARE_TIMER_DAWN
5491+ BD19 32 EE B5         LD (ScareTimer), A
5492+ BD1C                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5493+ BD1C                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5494+ BD1C                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5495+ BD1C                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5496+ BD1C DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5497+ BD20 06 06            LD B, NUM_MONSTERS
5498+ BD22              .samStateLoop:
5499+ BD22 DD 7E 01         LD A, (IX+ENT_TYPE)
5500+ BD25 FE 02            CP TYPE_MONSTER
5501+ BD27 20 1B            JR NZ, .samStateNext
5502+ BD29 DD 7E 02         LD A, (IX+ENT_STATE)
5503+ BD2C FE 03            CP STATE_DYING
5504+ BD2E 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5505+ BD30 FE 04            CP STATE_SPAWNING
5506+ BD32 28 10            JR Z, .samStateNext
5507+ BD34 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5508+ BD38 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5509+ BD3C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5510+ BD40 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5511+ BD44              .samStateNext:
5512+ BD44 11 10 00         LD DE, ENT_SIZE
5513+ BD47 DD 19            ADD IX, DE
5514+ BD49 10 D7            DJNZ .samStateLoop
5515+ BD4B C9               RET
5516+ BD4C
5517+ BD4C              ; ==============================================================================
5518+ BD4C              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5519+ BD4C              ; ==============================================================================
5520+ BD4C              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5521+ BD4C              ; ==============================================================================
5522+ BD4C
5523+ BD4C              ; ==============================================================================
5524+ BD4C              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5525+ BD4C              ; ==============================================================================
5526+ BD4C              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5527+ BD4C              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5528+ BD4C              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5529+ BD4C              ; ==============================================================================
5530+ BD4C              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5531+ BD4C              ; ==============================================================================
5532+ BD4C              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5533+ BD4C              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5534+ BD4C              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5535+ BD4C              ; ==============================================================================
5536+ BD4C              MONSTERS_TO_SPAWN   EQU 3
5537+ BD4C              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5538+ BD4C              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5539+ BD4C
5540+ BD4C              ; ==============================================================================
5541+ BD4C              ; SpawnMonsters - Primera aparicion tras campanadas
5542+ BD4C              ; ==============================================================================
5543+ BD4C              SpawnMonsters:
5544+ BD4C                  IF DEBUG_NO_ENEMIES
5545+ BD4C ~                RET
5546+ BD4C                  ENDIF
5547+ BD4C 3A 58 B3         LD A, (MonstersActive)
5548+ BD4F B7               OR A
5549+ BD50 C0               RET NZ
5550+ BD51                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5551+ BD51                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5552+ BD51 CD 2D BA         CALL KillAllActiveNasties
5553+ BD54 3E 01            LD A, 1
5554+ BD56 32 58 B3         LD (MonstersActive), A
5555+ BD59 CD D6 BD         CALL ShuffleMonsterTypes
5556+ BD5C DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5557+ BD60 06 03            LD B, MONSTERS_TO_SPAWN
5558+ BD62 0E 00            LD C, 0
5559+ BD64              .smLoop:
5560+ BD64 C5               PUSH BC
5561+ BD65 DD 7E 01         LD A, (IX+ENT_TYPE)
5562+ BD68 B7               OR A
5563+ BD69 C2 C5 BD         JP NZ, .smSkip
5564+ BD6C                  ; Asignar tipo y color
5565+ BD6C 79               LD A, C
5566+ BD6D 21 3A BE         LD HL, MonsterTypeTable
5567+ BD70 5F               LD E, A
5568+ BD71 16 00            LD D, 0
5569+ BD73 19               ADD HL, DE
5570+ BD74 7E               LD A, (HL)
5571+ BD75 DD 77 08         LD (IX+ENT_ANIMBASE), A
5572+ BD78 79               LD A, C
5573+ BD79 21 3D BE         LD HL, MonsterColorTable
5574+ BD7C 5F               LD E, A
5575+ BD7D 16 00            LD D, 0
5576+ BD7F 19               ADD HL, DE
5577+ BD80 7E               LD A, (HL)
5578+ BD81 DD 77 05         LD (IX+ENT_ATTR), A
5579+ BD84                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5580+ BD84 C5               PUSH BC
5581+ BD85 CD B8 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5582+ BD88 B7               OR A
5583+ BD89 20 0E            JR NZ, .smFallbackPos
5584+ BD8B 3A C0 97         LD A, (MaiSpawnX)
5585+ BD8E DD 77 03         LD (IX+ENT_POSX), A
5586+ BD91 3A C1 97         LD A, (MaiSpawnY)
5587+ BD94 DD 77 04         LD (IX+ENT_POSY), A
5588+ BD97 18 0C            JR .smPosDone
5589+ BD99              .smFallbackPos:
5590+ BD99 3A 0E 83         LD A, (LastEntryPosX)
5591+ BD9C DD 77 03         LD (IX+ENT_POSX), A
5592+ BD9F 3A 0F 83         LD A, (LastEntryPosY)
5593+ BDA2 DD 77 04         LD (IX+ENT_POSY), A
5594+ BDA5              .smPosDone:
5595+ BDA5 C1               POP BC
5596+ BDA6                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5597+ BDA6 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5598+ BDAA DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5599+ BDAE DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5600+ BDB2 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5601+ BDB6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5602+ BDBA                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5603+ BDBA                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5604+ BDBA                  ; lo empuje a un vecino (migracion por knockback).
5605+ BDBA CD AD 8E         CALL MaiGetCurrentScreenId
5606+ BDBD 21 87 8D         LD HL, MonsterRoomId
5607+ BDC0 59               LD E, C
5608+ BDC1 16 00            LD D, 0
5609+ BDC3 19               ADD HL, DE
5610+ BDC4 77               LD (HL), A
5611+ BDC5              .smSkip:
5612+ BDC5 11 10 00         LD DE, ENT_SIZE
5613+ BDC8 DD 19            ADD IX, DE
5614+ BDCA C1               POP BC
5615+ BDCB 0C               INC C
5616+ BDCC 05               DEC B
5617+ BDCD C2 64 BD         JP NZ, .smLoop
5618+ BDD0 3E 14            LD A, MONSTER_ENTRY_BASE
5619+ BDD2 32 24 BF         LD (TryRespawnMonsters.rmTimer), A
5620+ BDD5                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5621+ BDD5                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5622+ BDD5                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5623+ BDD5 C9               RET
5624+ BDD6
5625+ BDD6              ; --- Barajar tablas tipo/color ---
5626+ BDD6              ShuffleMonsterTypes:
5627+ BDD6 ED 5F            LD A, R
5628+ BDD8 E6 03            AND 3
5629+ BDDA C8               RET Z
5630+ BDDB FE 01            CP 1
5631+ BDDD 28 21            JR Z, .shSwap01
5632+ BDDF FE 02            CP 2
5633+ BDE1 28 3A            JR Z, .shSwap12
5634+ BDE3 3A 3A BE         LD A, (MonsterTypeTable)
5635+ BDE6 57               LD D, A
5636+ BDE7 3A 3C BE         LD A, (MonsterTypeTable + 2)
5637+ BDEA 32 3A BE         LD (MonsterTypeTable), A
5638+ BDED 7A               LD A, D
5639+ BDEE 32 3C BE         LD (MonsterTypeTable + 2), A
5640+ BDF1 3A 3D BE         LD A, (MonsterColorTable)
5641+ BDF4 57               LD D, A
5642+ BDF5 3A 3F BE         LD A, (MonsterColorTable + 2)
5643+ BDF8 32 3D BE         LD (MonsterColorTable), A
5644+ BDFB 7A               LD A, D
5645+ BDFC 32 3F BE         LD (MonsterColorTable + 2), A
5646+ BDFF C9               RET
5647+ BE00              .shSwap01:
5648+ BE00 3A 3A BE         LD A, (MonsterTypeTable)
5649+ BE03 57               LD D, A
5650+ BE04 3A 3B BE         LD A, (MonsterTypeTable + 1)
5651+ BE07 32 3A BE         LD (MonsterTypeTable), A
5652+ BE0A 7A               LD A, D
5653+ BE0B 32 3B BE         LD (MonsterTypeTable + 1), A
5654+ BE0E 3A 3D BE         LD A, (MonsterColorTable)
5655+ BE11 57               LD D, A
5656+ BE12 3A 3E BE         LD A, (MonsterColorTable + 1)
5657+ BE15 32 3D BE         LD (MonsterColorTable), A
5658+ BE18 7A               LD A, D
5659+ BE19 32 3E BE         LD (MonsterColorTable + 1), A
5660+ BE1C C9               RET
5661+ BE1D              .shSwap12:
5662+ BE1D 3A 3B BE         LD A, (MonsterTypeTable + 1)
5663+ BE20 57               LD D, A
5664+ BE21 3A 3C BE         LD A, (MonsterTypeTable + 2)
5665+ BE24 32 3B BE         LD (MonsterTypeTable + 1), A
5666+ BE27 7A               LD A, D
5667+ BE28 32 3C BE         LD (MonsterTypeTable + 2), A
5668+ BE2B 3A 3E BE         LD A, (MonsterColorTable + 1)
5669+ BE2E 57               LD D, A
5670+ BE2F 3A 3F BE         LD A, (MonsterColorTable + 2)
5671+ BE32 32 3E BE         LD (MonsterColorTable + 1), A
5672+ BE35 7A               LD A, D
5673+ BE36 32 3F BE         LD (MonsterColorTable + 2), A
5674+ BE39 C9               RET
5675+ BE3A
5676+ BE3A              MonsterTypeTable:
5677+ BE3A 4C               DEFB SPRID_MONSTER_0
5678+ BE3B 54               DEFB SPRID_MONSTER_1
5679+ BE3C 5C               DEFB SPRID_MONSTER_2
5680+ BE3D              MonsterColorTable:
5681+ BE3D 44               DEFB $44                            ; Zombi: verde
5682+ BE3E 46               DEFB $46                            ; Skeleton: amarillo
5683+ BE3F 45               DEFB $45                            ; Ghost: cyan
5684+ BE40
5685+ BE40              ; ==============================================================================
5686+ BE40              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5687+ BE40              ; ==============================================================================
5688+ BE40              TryRespawnMonsters:
5689+ BE40                  IF DEBUG_NO_ENEMIES
5690+ BE40 ~                RET
5691+ BE40                  ENDIF
5692+ BE40 3A D0 E2         LD A, (CurrentTimeOfDay)
5693+ BE43 FE 03            CP 3
5694+ BE45 28 05            JR Z, .rmNight
5695+ BE47 FE 04            CP 4
5696+ BE49 28 01            JR Z, .rmNight
5697+ BE4B C9               RET
5698+ BE4C              .rmNight:
5699+ BE4C 3A 58 B3         LD A, (MonstersActive)
5700+ BE4F B7               OR A
5701+ BE50 C8               RET Z
5702+ BE51 CD 28 BF         CALL .rmUpdateReturnTimers
5703+ BE54 3A 24 BF         LD A, (.rmTimer)
5704+ BE57 B7               OR A
5705+ BE58 28 05            JR Z, .rmCheckSlots
5706+ BE5A 3D               DEC A
5707+ BE5B 32 24 BF         LD (.rmTimer), A
5708+ BE5E C9               RET
5709+ BE5F              .rmCheckSlots:
5710+ BE5F DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5711+ BE63 06 03            LD B, MONSTERS_TO_SPAWN
5712+ BE65 0E 00            LD C, 0
5713+ BE67              .rmLoop:
5714+ BE67 C5               PUSH BC
5715+ BE68 DD 7E 01         LD A, (IX+ENT_TYPE)
5716+ BE6B B7               OR A
5717+ BE6C C2 18 BF         JP NZ, .rmSkip
5718+ BE6F                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5719+ BE6F                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5720+ BE6F                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5721+ BE6F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5722+ BE72 B7               OR A
5723+ BE73 20 09            JR NZ, .rmHasTypeForTrap
5724+ BE75                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5725+ BE75 79               LD A, C
5726+ BE76 21 3A BE         LD HL, MonsterTypeTable
5727+ BE79 5F               LD E, A
5728+ BE7A 16 00            LD D, 0
5729+ BE7C 19               ADD HL, DE
5730+ BE7D 7E               LD A, (HL)
5731+ BE7E              .rmHasTypeForTrap:
5732+ BE7E D6 4C            SUB SPRID_MONSTER_0
5733+ BE80 CB 3F            SRL A
5734+ BE82 CB 3F            SRL A
5735+ BE84 CB 3F            SRL A                               ; A = type idx 0..2
5736+ BE86 21 25 BF         LD HL, .rmTrapBits
5737+ BE89 5F               LD E, A
5738+ BE8A 16 00            LD D, 0
5739+ BE8C 19               ADD HL, DE
5740+ BE8D 7E               LD A, (HL)
5741+ BE8E 21 BE 82         LD HL, MonsterTrappedFlags
5742+ BE91 A6               AND (HL)
5743+ BE92 C2 18 BF         JP NZ, .rmSkip
5744+ BE95                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5745+ BE95                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5746+ BE95                  ; que el player visite su room.
5747+ BE95 79               LD A, C
5748+ BE96 6F               LD L, A
5749+ BE97 26 00            LD H, 0
5750+ BE99 11 87 8D         LD DE, MonsterRoomId
5751+ BE9C 19               ADD HL, DE
5752+ BE9D 7E               LD A, (HL)
5753+ BE9E 5F               LD E, A                             ; E = room_id del slot
5754+ BE9F CD AD 8E         CALL MaiGetCurrentScreenId          ; A = current screen_id
5755+ BEA2 BB               CP E
5756+ BEA3 C2 18 BF         JP NZ, .rmSkip                      ; distinto room → skip
5757+ BEA6                  ; === Activar SIN tocar POSX/POSY ===
5758+ BEA6                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5759+ BEA6                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5760+ BEA6                  ;   - RepositionMonstersAtEntry: gap en entry side
5761+ BEA6                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5762+ BEA6 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5763+ BEA9 B7               OR A
5764+ BEAA 20 18            JR NZ, .rmHasType
5765+ BEAC 79               LD A, C
5766+ BEAD 21 3A BE         LD HL, MonsterTypeTable
5767+ BEB0 5F               LD E, A
5768+ BEB1 16 00            LD D, 0
5769+ BEB3 19               ADD HL, DE
5770+ BEB4 7E               LD A, (HL)
5771+ BEB5 DD 77 08         LD (IX+ENT_ANIMBASE), A
5772+ BEB8 79               LD A, C
5773+ BEB9 21 3D BE         LD HL, MonsterColorTable
5774+ BEBC 5F               LD E, A
5775+ BEBD 16 00            LD D, 0
5776+ BEBF 19               ADD HL, DE
5777+ BEC0 7E               LD A, (HL)
5778+ BEC1 DD 77 05         LD (IX+ENT_ATTR), A
5779+ BEC4              .rmHasType:
5780+ BEC4 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5781+ BEC7 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5782+ BECB DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5783+ BECF                  ; Facing
5784+ BECF 57               LD D, A
5785+ BED0 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5786+ BED3 DD BE 03         CP (IX+ENT_POSX)
5787+ BED6 30 05            JR NC, .rmFaceR
5788+ BED8 7A               LD A, D
5789+ BED9 C6 04            ADD A, MONSTER_FRAMES_LEFT
5790+ BEDB 18 01            JR .rmFaceSet
5791+ BEDD              .rmFaceR:
5792+ BEDD 7A               LD A, D
5793+ BEDE              .rmFaceSet:
5794+ BEDE DD 77 00         LD (IX+ENT_SPRITEID), A
5795+ BEE1 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5796+ BEE5 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5797+ BEE9 DD 36 0A 00      LD (IX+ENT_DIR), 0
5798+ BEED DD 36 06 00      LD (IX+ENT_DELTAX), 0
5799+ BEF1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5800+ BEF5 DD 7E 03         LD A, (IX+ENT_POSX)
5801+ BEF8 DD 77 0C         LD (IX+ENT_OLDX), A
5802+ BEFB DD 77 0F         LD (IX+ENT_DRAWX), A
5803+ BEFE DD 7E 04         LD A, (IX+ENT_POSY)
5804+ BF01 DD 77 0D         LD (IX+ENT_OLDY), A
5805+ BF04 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5806+ BF07 DD 77 0E         LD (IX+ENT_OLDSPRID), A
5807+ BF0A                  ; Solo UNO por frame
5808+ BF0A C1               POP BC
5809+ BF0B 3E 14            LD A, MONSTER_ENTRY_GAP
5810+ BF0D 32 24 BF         LD (.rmTimer), A
5811+ BF10                  ; Arrancar MonstersMusic la PRIMERA vez que un monster aparece visible.
5812+ BF10                  ; Step=$FF (sentinel inactivo) -> aun no ha sonado nunca esta noche.
5813+ BF10                  ; Tras StartMonstersMusic, Step=0 -> no re-arranca en respawns posteriores.
5814+ BF10                  ; StopMonstersMusic en sunrise restaura Step=$FF para la siguiente noche.
5815+ BF10 3A 80 F9         LD A, (MonstersMusicStep)
5816+ BF13 3C               INC A
5817+ BF14 C0               RET NZ                              ; Step != $FF -> ya arranco, salir
5818+ BF15 C3 42 F9         JP StartMonstersMusic               ; tail-call: arranca el secuencer
5819+ BF18              .rmSkip:
5820+ BF18 11 10 00         LD DE, ENT_SIZE
5821+ BF1B DD 19            ADD IX, DE
5822+ BF1D C1               POP BC
5823+ BF1E 0C               INC C
5824+ BF1F 05               DEC B
5825+ BF20 C2 67 BE         JP NZ, .rmLoop
5826+ BF23 C9               RET
5827+ BF24
5828+ BF24 00           .rmTimer: DEFB 0
5829+ BF25 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5830+ BF28
5831+ BF28              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5832+ BF28              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5833+ BF28              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5834+ BF28              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5835+ BF28              ; empujado).
5836+ BF28              .rmUpdateReturnTimers:
5837+ BF28 21 59 B3         LD HL, MonsterReturnTimer
5838+ BF2B DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5839+ BF2F 06 03            LD B, MONSTERS_TO_SPAWN
5840+ BF31              .rmRtLoop:
5841+ BF31 7E               LD A, (HL)
5842+ BF32 B7               OR A
5843+ BF33 CA 08 C0         JP Z, .rmRtNext
5844+ BF36 3D               DEC A
5845+ BF37 77               LD (HL), A
5846+ BF38 C2 08 C0         JP NZ, .rmRtNext
5847+ BF3B                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5848+ BF3B                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5849+ BF3B                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5850+ BF3B                  ; Calcular target coord: axis variable segun borde de salida.
5851+ BF3B                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5852+ BF3B DD 7E 0A         LD A, (IX+ENT_DIR)
5853+ BF3E FE 01            CP DIR_N
5854+ BF40 28 11            JR Z, .rmRtSideN
5855+ BF42 FE 02            CP DIR_S
5856+ BF44 28 1C            JR Z, .rmRtSideS
5857+ BF46 FE 04            CP DIR_E
5858+ BF48 CA 82 BF         JP Z, .rmRtSideE
5859+ BF4B FE 08            CP DIR_W
5860+ BF4D CA 71 BF         JP Z, .rmRtSideW
5861+ BF50 C3 DF BF         JP .rmRtFallback
5862+ BF53              .rmRtSideN:
5863+ BF53                  ; target coord = cx = POSX / 8
5864+ BF53 DD 7E 03         LD A, (IX+ENT_POSX)
5865+ BF56 0F               RRCA
5866+ BF57 0F               RRCA
5867+ BF58 0F               RRCA
5868+ BF59 E6 1F            AND $1F
5869+ BF5B 32 BF 97         LD (MaiGapTargetCoord), A
5870+ BF5E 3E 00            LD A, MAI_SIDE_N
5871+ BF60 18 2F            JR .rmRtPickGap
5872+ BF62              .rmRtSideS:
5873+ BF62 DD 7E 03         LD A, (IX+ENT_POSX)
5874+ BF65 0F               RRCA
5875+ BF66 0F               RRCA
5876+ BF67 0F               RRCA
5877+ BF68 E6 1F            AND $1F
5878+ BF6A 32 BF 97         LD (MaiGapTargetCoord), A
5879+ BF6D 3E 01            LD A, MAI_SIDE_S
5880+ BF6F 18 20            JR .rmRtPickGap
5881+ BF71              .rmRtSideW:
5882+ BF71                  ; target coord = cy = (POSY - 16) / 8
5883+ BF71 DD 7E 04         LD A, (IX+ENT_POSY)
5884+ BF74 D6 10            SUB SCREEN_MIN_Y
5885+ BF76 0F               RRCA
5886+ BF77 0F               RRCA
5887+ BF78 0F               RRCA
5888+ BF79 E6 1F            AND $1F
5889+ BF7B 32 BF 97         LD (MaiGapTargetCoord), A
5890+ BF7E 3E 02            LD A, MAI_SIDE_W
5891+ BF80 18 0F            JR .rmRtPickGap
5892+ BF82              .rmRtSideE:
5893+ BF82 DD 7E 04         LD A, (IX+ENT_POSY)
5894+ BF85 D6 10            SUB SCREEN_MIN_Y
5895+ BF87 0F               RRCA
5896+ BF88 0F               RRCA
5897+ BF89 0F               RRCA
5898+ BF8A E6 1F            AND $1F
5899+ BF8C 32 BF 97         LD (MaiGapTargetCoord), A
5900+ BF8F 3E 03            LD A, MAI_SIDE_E
5901+ BF91              .rmRtPickGap:
5902+ BF91                  ; MaiPickNearestGapOnSide destruye HL y BC (paginacion bank 6, loops
5903+ BF91                  ; internos). Preservamos HL (ptr a MonsterReturnTimer[slot]) y B
5904+ BF91                  ; (contador del outer loop) para que .rmRtNext pueda iterar bien.
5905+ BF91 E5               PUSH HL
5906+ BF92 C5               PUSH BC
5907+ BF93 CD 67 91         CALL MaiPickNearestGapOnSide        ; elige gap del side mas cercano al target
5908+ BF96 C1               POP BC
5909+ BF97 E1               POP HL
5910+ BF98 B7               OR A
5911+ BF99 C2 DF BF         JP NZ, .rmRtFallback
5912+ BF9C                  ; Ajustar MaiSpawnX/Y con MAI_REENTRY_OFFSET hacia dentro. MaiPickRandomGapOnSide
5913+ BF9C                  ; usa MAI_ENTRY_OFFSET (=0) y deja el spawn al borde; aqui lo empujamos 2 chars.
5914+ BF9C 3A BB 97         LD A, (MaiGapSide)
5915+ BF9F FE 00            CP MAI_SIDE_N
5916+ BFA1 28 12            JR Z, .rmRtAdjN
5917+ BFA3 FE 01            CP MAI_SIDE_S
5918+ BFA5 28 18            JR Z, .rmRtAdjS
5919+ BFA7 FE 02            CP MAI_SIDE_W
5920+ BFA9 28 1E            JR Z, .rmRtAdjW
5921+ BFAB                  ; side E
5922+ BFAB 3A C0 97         LD A, (MaiSpawnX)
5923+ BFAE D6 10            SUB MAI_REENTRY_OFFSET
5924+ BFB0 32 C0 97         LD (MaiSpawnX), A
5925+ BFB3 18 1C            JR .rmRtApplyGap
5926+ BFB5              .rmRtAdjN:
5927+ BFB5 3A C1 97         LD A, (MaiSpawnY)
5928+ BFB8 C6 10            ADD A, MAI_REENTRY_OFFSET
5929+ BFBA 32 C1 97         LD (MaiSpawnY), A
5930+ BFBD 18 12            JR .rmRtApplyGap
5931+ BFBF              .rmRtAdjS:
