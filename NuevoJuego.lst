 206+ 9EEB              ; ==============================================================================
 207+ 9EEB              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ 9EEB              ; ==============================================================================
 209+ 9EEB              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ 9EEB              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ 9EEB              ; que los pies parezcan hundirse en el suelo.
 212+ 9EEB              ; ==============================================================================
 213+ 9EEB              ComputePlayerDrawY:
 214+ 9EEB                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ 9EEB                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ 9EEB                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ 9EEB 3A 9E 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ 9EEE D6 6E            SUB SPRID_PLAYER_DEATH
 219+ 9EF0 FE 06            CP 6
 220+ 9EF2 30 09            JR NC, .cpdyNotDeath
 221+ 9EF4 3A A2 81         LD A, (EntityTable + ENT_POSY)
 222+ 9EF7 C6 05            ADD A, 5
 223+ 9EF9 32 DF 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ 9EFC C9               RET
 225+ 9EFD              .cpdyNotDeath:
 226+ 9EFD 3A A1 81         LD A, (EntityTable + ENT_POSX)
 227+ 9F00 C6 08            ADD A, 8                    ; center X del player
 228+ 9F02 47               LD B, A
 229+ 9F03 3A A2 81         LD A, (EntityTable + ENT_POSY)
 230+ 9F06 4F               LD C, A
 231+ 9F07 32 DF 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ 9F0A B7               OR A
 233+ 9F0B C8               RET Z
 234+ 9F0C 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ 9F0D CD 0C D5         CALL IsPointBlocked
 236+ 9F10 C8               RET Z                       ; libre → sin offset
 237+ 9F11 3A A2 81         LD A, (EntityTable + ENT_POSY)
 238+ 9F14 3C               INC A
 239+ 9F15 32 DF 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ 9F18 C9               RET
 241+ 9F19
 242+ 9F19              ; ==============================================================================
 243+ 9F19              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ 9F19              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ 9F19              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ 9F19              ; no parecer que se hunde en el techo.
 247+ 9F19              ; Preserva: IX. Destruye: AF, BC.
 248+ 9F19              ; ==============================================================================
 249+ 9F19              ComputeEnemyDrawY:
 250+ 9F19 DD 7E 04         LD A, (IX+ENT_POSY)
 251+ 9F1C 32 E0 82         LD (EnemyDrawY), A          ; default = POSY
 252+ 9F1F DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ 9F22 FE 02            CP TYPE_MONSTER
 254+ 9F24 C0               RET NZ                      ; no monster → sin offset
 255+ 9F25 DD 7E 03         LD A, (IX+ENT_POSX)
 256+ 9F28 C6 08            ADD A, 8                    ; center X
 257+ 9F2A 47               LD B, A
 258+ 9F2B DD 7E 04         LD A, (IX+ENT_POSY)
 259+ 9F2E 4F               LD C, A
 260+ 9F2F B7               OR A
 261+ 9F30 C8               RET Z
 262+ 9F31 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F32 CD 0C D5         CALL IsPointBlocked
 264+ 9F35 C8               RET Z                       ; libre → sin offset
 265+ 9F36 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F39 3C               INC A
 267+ 9F3A 32 E0 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F3D C9               RET
