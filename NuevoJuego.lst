 279+ 8EFB              ; ==============================================================================
 280+ 8EFB              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 281+ 8EFB              ; ==============================================================================
 282+ 8EFB              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 283+ 8EFB              ; Se llama ANTES de pintar el sprite.
 284+ 8EFB              ;
 285+ 8EFB              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 286+ 8EFB              ;          IX = puntero al sprite (para leer width/height)
 287+ 8EFB              ; ==============================================================================
 288+ 8EFB              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 289+ 8EFB              ; ==============================================================================
 290+ 8EFB              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 291+ 8EFB              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 292+ 8EFB              ; ==============================================================================
 293+ 8EFB              CalcEntityAttrSize:
 294+ 8EFB DD 7E 00         LD A, (IX+0)                ; width_bytes
 295+ 8EFE 47               LD B, A
 296+ 8EFF 7B               LD A, E
 297+ 8F00 E6 07            AND 7
 298+ 8F02 28 01            JR Z, .ceNoExtra
 299+ 8F04 04               INC B
 300+ 8F05              .ceNoExtra:
 301+ 8F05 78               LD A, B
 302+ 8F06 32 8C 8F         LD (EntityAttrW), A
 303+ 8F09 7A               LD A, D
 304+ 8F0A E6 07            AND 7
 305+ 8F0C 4F               LD C, A
 306+ 8F0D DD 7E 01         LD A, (IX+1)                ; height_pixels
 307+ 8F10 81               ADD A, C
 308+ 8F11 C6 07            ADD A, 7
 309+ 8F13 0F               RRCA
 310+ 8F14 0F               RRCA
 311+ 8F15 0F               RRCA
 312+ 8F16 E6 1F            AND $1F
 313+ 8F18 32 8D 8F         LD (EntityAttrH), A
 314+ 8F1B C9               RET
 315+ 8F1C
 316+ 8F1C              ; ==============================================================================
 317+ 8F1C              SaveEntityAttr:
 318+ 8F1C                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 319+ 8F1C DD 7E 00         LD A, (IX+0)                ; width_bytes
 320+ 8F1F 47               LD B, A
 321+ 8F20 7B               LD A, E                     ; X pixel (raw)
 322+ 8F21 E6 07            AND 7
 323+ 8F23 28 01            JR Z, .noExtraW
 324+ 8F25 04               INC B                       ; +1 columna si no alineado
 325+ 8F26              .noExtraW:
 326+ 8F26 78               LD A, B
 327+ 8F27 32 8C 8F         LD (EntityAttrW), A
 328+ 8F2A
 329+ 8F2A                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 330+ 8F2A 7A               LD A, D                     ; Y pixel (raw)
 331+ 8F2B E6 07            AND 7                       ; Y offset dentro del char
 332+ 8F2D 4F               LD C, A
 333+ 8F2E DD 7E 01         LD A, (IX+1)                ; height_pixels
 334+ 8F31 81               ADD A, C                    ; + Y offset
 335+ 8F32 C6 07            ADD A, 7
 336+ 8F34 0F               RRCA
 337+ 8F35 0F               RRCA
 338+ 8F36 0F               RRCA
 339+ 8F37 E6 1F            AND $1F                     ; / 8 = height_chars
 340+ 8F39 32 8D 8F         LD (EntityAttrH), A
 341+ 8F3C
 342+ 8F3C CD F6 90         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 343+ 8F3F 11 7C 8F         LD DE, EntitySavedAttr      ; DE = buffer destino
 344+ 8F42
 345+ 8F42 3A 8D 8F         LD A, (EntityAttrH)
 346+ 8F45 4F               LD C, A                     ; C = filas
 347+ 8F46              .saveRow:
 348+ 8F46 3A 8C 8F         LD A, (EntityAttrW)
 349+ 8F49 47               LD B, A                     ; B = columnas
 350+ 8F4A E5               PUSH HL                     ; Guardar inicio de fila
 351+ 8F4B              .saveCol:
