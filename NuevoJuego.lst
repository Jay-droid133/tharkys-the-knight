 118  6B3C                  ; --- Tumbas persistentes (tombstones.asm) ---
 119  6B3C                  ; TombStore + DrawTombstonesInRoom. Usan inline page switch como
 120  6B3C                  ; LoadBgSpriteToBuffer para acceder al storage en bank 7 ($E000+).
 121  6B3C                  ; Cold path: muerte del player + carga de pantalla. Coste invisible.
 122  6B3C                  INCLUDE "tombstones.asm"
# file opened: tombstones.asm
   1+ 6B3C              ; ==============================================================================
   2+ 6B3C              ; TOMBSTONES - Tumbas persistentes en el mundo donde el player muere
   3+ 6B3C              ; ==============================================================================
   4+ 6B3C              ; Storage: bank 7 a $E000, 800 bytes (200 entradas x 4 bytes cada una).
   5+ 6B3C              ; Layout por entrada: DEFB roomX, roomY, posX, posY  (todos 8-bit).
   6+ 6B3C              ; TombstoneCount (1 byte, 0..200) en bank 2 (variables.asm, siempre visible).
   7+ 6B3C              ;
   8+ 6B3C              ; Vive en slot 1 ($6000+) tras paging.asm: las rutinas hacen el page switch
   9+ 6B3C              ; siguiendo el patron de LoadBgSpriteToBuffer (DI durante la ventana, IFF
  10+ 6B3C              ; tracking via StartupComplete, no CALLs/PUSH/POP entre los OUT).
  11+ 6B3C              ;
  12+ 6B3C              ; Cold paths: TombStore se llama 1 vez por muerte; DrawTombstonesInRoom al
  13+ 6B3C              ; cargar pantalla. Coste invisible.
  14+ 6B3C              ; ==============================================================================
  15+ 6B3C
  16+ 6B3C              TOMBSTONE_MAX     EQU 200
  17+ 6B3C              TOMBSTONE_BYTES   EQU 4
  18+ 6B3C              TOMBSTONE_BANK    EQU 7
  19+ 6B3C              TOMBSTONE_ADDR    EQU $E000
  20+ 6B3C              SPRID_TOMBSTONE   EQU 252
  21+ 6B3C
