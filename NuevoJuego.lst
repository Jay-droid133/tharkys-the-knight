2145+ DA1E              ; ==============================================================================
2146+ DA1E              ; BumpTriggerTable - sprites que disparan acción al "chocar" (no por overlap).
2147+ DA1E              ; ==============================================================================
2148+ DA1E              ; Cada entry: ptr (DEFW), required_key (DEFB), action_id (DEFB). 4 bytes.
2149+ DA1E              ; Terminada en DEFW 0.
2150+ DA1E              ;
2151+ DA1E              ; Action_ids:
2152+ DA1E              ;   1 = TownHall: ChurchKeySpawned = 1, CurrentKey = 0.
2153+ DA1E              ;   2 = ChurchDoor: ChurchDoorOpen = 1, CurrentKey = 0, reescribe ptr de la
2154+ DA1E              ;       entry a BgGfx_old_church_door_open + rebuild CollisionMap.
2155+ DA1E              ;
2156+ DA1E              ; El sprite tiene que estar también en WallAlwaysTable para que sea sólido.
2157+ DA1E              ;
2158+ DA1E              ; NOTA: el cutscene final (action 3 = TownGate) se dispara aparte, en
2159+ DA1E              ; CheckTownGateTriggerBg (town_gate_cutscene.asm). El arco es BG sprite y
2160+ DA1E              ; no esta en PickupTable, asi que esta tabla no puede hospedarlo. La logica
2161+ DA1E              ; es equivalente: AABB del player vs rect del arco con tolerancia +-4.
2162+ DA1E              ; ==============================================================================
2163+ DA1E              BumpTriggerTable:
2164+ DA1E 6D DE            DEFW BgGfx_old_church_door_closed
2165+ DA20 05               DEFB 5                          ; key requerida = ChurchKey
2166+ DA21 02               DEFB 2                          ; action = ChurchDoor open
2167+ DA22 28 D8            DEFW BgGfx_chimes_tower_door
2168+ DA24 04               DEFB 4                          ; key requerida = ClockTowerKey
2169+ DA25 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2170+ DA26 00 00            DEFW 0                          ; fin
2171+ DA28 00 00            DEFB 0, 0
