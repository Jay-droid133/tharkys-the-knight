1537+ F46D              ; ==============================================================================
1538+ F46D              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1539+ F46D              ; ==============================================================================
1540+ F46D              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1541+ F46D              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1542+ F46D              ; suficiente para corromper visualmente).
1543+ F46D              ; IN: IX = entity ptr.
1544+ F46D              ; ==============================================================================
1545+ F46D              RedrawTrappedMonster:
1546+ F46D                  ; --- Erase viejo en (OLDX, OLDY) ---
1547+ F46D CD F7 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1548+ F470 DD 7E 0D         LD A, (IX+ENT_OLDY)
1549+ F473 57               LD D, A
1550+ F474 DD 7E 0C         LD A, (IX+ENT_OLDX)
1551+ F477 5F               LD E, A
1552+ F478 DD E5            PUSH IX
1553+ F47A DD 2A 7F A4      LD IX, (OldSprAddr)
1554+ F47E CD EA 99         CALL DrawSprite
1555+ F481 DD E1            POP IX
1556+ F483                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1557+ F483                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1558+ F483 DD 56 0D         LD D, (IX+ENT_OLDY)
1559+ F486 DD 5E 0C         LD E, (IX+ENT_OLDX)
1560+ F489 CD 9C D2         CALL RestoreOldAttr
1561+ F48C                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1562+ F48C                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1563+ F48C                  ; reponer attrs de pickups que el flujo de entidades pisa con
1564+ F48C                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1565+ F48C                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1566+ F48C                  ; estar bajo el monster.
1567+ F48C DD E5            PUSH IX
1568+ F48E CD 7C D9         CALL RefreshPickupAttrs
1569+ F491 DD E1            POP IX
1570+ F493                  ; --- Compute new draw pos ---
1571+ F493 CD 81 A4         CALL CalcDrawX
1572+ F496 CD 19 9F         CALL ComputeEnemyDrawY
1573+ F499                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1574+ F499 CD C6 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1575+ F49C 3A E0 82         LD A, (EnemyDrawY)
1576+ F49F 57               LD D, A
1577+ F4A0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1578+ F4A3 5F               LD E, A
1579+ F4A4 DD E5            PUSH IX
1580+ F4A6 DD 2A F5 A4      LD IX, (SpriteAddrTemp)
1581+ F4AA CD 07 9B         CALL CalcEntityAttrSize
1582+ F4AD DD E1            POP IX
1583+ F4AF 3A E0 82         LD A, (EnemyDrawY)
1584+ F4B2 57               LD D, A
1585+ F4B3 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1586+ F4B6 5F               LD E, A
1587+ F4B7 DD 7E 05         LD A, (IX+ENT_ATTR)
1588+ F4BA CD DA 9A         CALL SetEntityAttr
1589+ F4BD                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1590+ F4BD 3A E0 82         LD A, (EnemyDrawY)
1591+ F4C0 57               LD D, A
1592+ F4C1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1593+ F4C4 5F               LD E, A
1594+ F4C5 DD E5            PUSH IX
1595+ F4C7 DD 2A F5 A4      LD IX, (SpriteAddrTemp)
1596+ F4CB CD EA 99         CALL DrawSprite
1597+ F4CE DD E1            POP IX
1598+ F4D0                  ; --- Save OLD = current ---
1599+ F4D0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1600+ F4D3 DD 77 0C         LD (IX+ENT_OLDX), A
1601+ F4D6 3A E0 82         LD A, (EnemyDrawY)
1602+ F4D9 DD 77 0D         LD (IX+ENT_OLDY), A
1603+ F4DC DD 7E 00         LD A, (IX+ENT_SPRITEID)
1604+ F4DF DD 77 0E         LD (IX+ENT_OLDSPRID), A
1605+ F4E2 C9               RET
