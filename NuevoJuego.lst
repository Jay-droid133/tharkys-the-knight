 722+ 90CF B8               CP B
 723+ 90D0 38 03            JR C, .mosModDone
 724+ 90D2 90               SUB B
 725+ 90D3 18 FA            JR .mosMod
 726+ 90D5              .mosModDone:
 727+ 90D5                  ; A = target idx 0..matches-1. Descartar stack ANTES de moverlo a C,
 728+ 90D5                  ; porque POP BC machaca C (bug anterior: target se perdia, siempre idx 0).
 729+ 90D5 C1               POP BC                          ; discard saved total count
 730+ 90D6 E1               POP HL                          ; HL = first entry ptr again
 731+ 90D7 4F               LD C, A                         ; C = target match index
 732+ 90D8 06 00            LD B, 0                         ; B = matches seen so far
