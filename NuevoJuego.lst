 189  7616
 190  7616                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 191  7616                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 192  7616                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 193  7616                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 194  7616                  ;
 195  7616                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 196  7616                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 197  7616                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 198  7616                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 199  7616                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 200  7616                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 201  7616                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 7616              ; ==============================================================================
   2+ 7616              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 7616              ; ==============================================================================
   4+ 7616              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 7616              ; Mientras MagicCompassTimer>0:
   6+ 7616              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 7616              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 7616              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 7616              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 7616              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 7616              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 7616              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 7616              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 7616              ;
  15+ 7616              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 7616              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 7616              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 7616              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 7616              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 7616              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 7616              ;
  22+ 7616              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 7616              ; ==============================================================================
  24+ 7616
  25+ 7616              ; ==============================================================================
  26+ 7616              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 7616              ; ==============================================================================
  28+ 7616              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 7616              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 7616              ; Destruye: AF, HL.
  31+ 7616              ; ==============================================================================
  32+ 7616              ApplyMagicCompassBuff:
  33+ 7616 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 7619 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 761C 3E 01            LD A, 1
  36+ 761E 32 C3 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 7621 AF               XOR A
  38+ 7622 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 7625 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 7627 32 C5 5F         LD (MagicCompassTickCounter), A
  41+ 762A                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  42+ 762A                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  43+ 762A                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  44+ 762A                  ; el futuro se quiere reactivar.
  45+ 762A 3E FF            LD A, $FF
  46+ 762C 32 C6 5F         LD (MagicCompassJingleIdx), A
  47+ 762F                  ; SFX al recoger: sweep ascendente AY canal B. Lasting tiene PIN extra.
  48+ 762F 3A C8 82         LD A, (MagicCompassPermanent)
  49+ 7632 B7               OR A
  50+ 7633 C2 D3 70         JP NZ, AY_PlayLastingPickup         ; lasting: sweep largo + PIN (~1.12s)
  51+ 7636 C3 C8 70         JP AY_PlayCompassPickup             ; random: sweep corto (~640ms)
  52+ 7639
  53+ 7639              ; ==============================================================================
  54+ 7639              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  55+ 7639              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  56+ 7639              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  57+ 7639              ; ==============================================================================
  58+ 7639              ; Entry points:
  59+ 7639              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  60+ 7639              ;                           muerte / hito cumplido / llegar a sala destino,
  61+ 7639              ;                           sites que no saben si la brujula estaba activa.
  62+ 7639              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  63+ 7639              ;                           por el branch del timeout natural (Timer ya es 0
  64+ 7639              ;                           tras el DEC, asi que el check daria RET Z falso
  65+ 7639              ;                           positivo y se saltaria el cleanup).
  66+ 7639              ; ==============================================================================
  67+ 7639              CancelMagicCompass:
  68+ 7639 3A C8 82         LD A, (MagicCompassPermanent)
  69+ 763C B7               OR A
  70+ 763D C0               RET NZ                               ; lasting compass: nunca cancelar
  71+ 763E 3A BF 5F         LD A, (MagicCompassTimer)
  72+ 7641 47               LD B, A
  73+ 7642 3A C0 5F         LD A, (MagicCompassTimer + 1)
  74+ 7645 B0               OR B
  75+ 7646 C8               RET Z                                ; ya inactivo
  76+ 7647                  ; fall through al cleanup compartido
  77+ 7647              _DoCancelMagicCompass:
  78+ 7647 AF               XOR A
  79+ 7648 32 BF 5F         LD (MagicCompassTimer), A
  80+ 764B 32 C0 5F         LD (MagicCompassTimer + 1), A
  81+ 764E 32 C5 5F         LD (MagicCompassTickCounter), A
  82+ 7651 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  83+ 7654 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  84+ 7657 3E FF            LD A, $FF
  85+ 7659 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  86+ 765C 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  87+ 765F 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  88+ 7662 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  89+ 7665 32 BD 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  90+ 7668                                                       ; frame: DrawCompass detecta $FF y
  91+ 7668                                                       ; entra a .dcRedraw, sustituyendo el
  92+ 7668                                                       ; sprite_compass_magic stale por la
  93+ 7668                                                       ; brujula clasica (8 flechas + X).
  94+ 7668 C9               RET
  95+ 7669
  96+ 7669              ; ==============================================================================
  97+ 7669              ; RefreshMagicCompassForNewObjective - Recompute path tras avance de hito
  98+ 7669              ; ==============================================================================
  99+ 7669              ; Llamado desde CheckMilestonePickup/Trigger/DebugKey tras CancelMagicCompass.
 100+ 7669              ;
 101+ 7669              ; Caso normal (random pickup, no Permanent): CancelMagicCompass ya zappeo el
 102+ 7669              ; timer a 0; aqui retornamos inmediatamente sin tocar nada (no-op).
 103+ 7669              ;
 104+ 7669              ; Caso lasting compass (Permanent=1): CancelMagicCompass retorno sin tocar el
 105+ 7669              ; estado, asi que el timer sigue activo. El BFS anterior dejo MagicCompassPathDir
 106+ 7669              ; en $FF (current_sid == target_sid en el momento del pickup), lo que hace que
 107+ 7669              ; DrawCompass cayera en .dcMagicOff y renderizara la brujula clasica. Sin
 108+ 7669              ; recompute aqui, la brujula clasica persistia hasta el siguiente cambio de
 109+ 7669              ; sala (donde CheckScreenTransition llama a ForceComputeMagicCompassPath).
 110+ 7669              ;
 111+ 7669              ; Recompute sincrono = brujula magica vuelve a apuntar al NUEVO objetivo en el
 112+ 7669              ; mismo frame del pickup. Coste: ~10K T-states (~14% del frame), una sola vez
 113+ 7669              ; por avance de hito; gameplay normal no afectado.
 114+ 7669              ;
 115+ 7669              ; Destruye: AF, BC, DE, HL.
 116+ 7669              ; ==============================================================================
 117+ 7669              RefreshMagicCompassForNewObjective:
 118+ 7669 3A BF 5F         LD A, (MagicCompassTimer)
 119+ 766C 47               LD B, A
 120+ 766D 3A C0 5F         LD A, (MagicCompassTimer + 1)
 121+ 7670 B0               OR B
 122+ 7671 C8               RET Z                                ; magic inactiva: no-op
 123+ 7672 3E FF            LD A, $FF
 124+ 7674 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache HUD
 125+ 7677 C3 7A 76         JP ForceComputeMagicCompassPath      ; tail call: BFS sincrono al nuevo goal
 126+ 767A
 127+ 767A              ; ==============================================================================
 128+ 767A              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
 129+ 767A              ; ==============================================================================
 130+ 767A              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
 131+ 767A              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
 132+ 767A              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
 133+ 767A              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
 134+ 767A              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
 135+ 767A              ; direccion vieja (de la sala anterior).
 136+ 767A              ;
 137+ 767A              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 138+ 767A              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 139+ 767A              ; solo en transiciones — nunca en frames de gameplay normal.
 140+ 767A              ;
 141+ 767A              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 142+ 767A              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 143+ 767A              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 144+ 767A              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 145+ 767A              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 146+ 767A              ;
 147+ 767A              ; Destruye: AF, BC, DE, HL.
 148+ 767A              ; ==============================================================================
 149+ 767A              ForceComputeMagicCompassPath:
 150+ 767A AF               XOR A
 151+ 767B 32 CD 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 152+ 767E              .fcmcpLoop:
 153+ 767E CD 30 77         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 154+ 7681                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 155+ 7681 3A CD 5F         LD A, (MagicCompassBfsState)
 156+ 7684 B7               OR A
 157+ 7685 20 F7            JR NZ, .fcmcpLoop                    ; aun en progreso → otro chunk
 158+ 7687 AF               XOR A
 159+ 7688 32 C3 5F         LD (MagicCompassPathDirty), A        ; ya recalculado, no necesita rerun
 160+ 768B                  ; Forzar tick INMEDIATO en la nueva sala: TickCounter=0 hace que
 161+ 768B                  ; UpdateMagicCompass dispare .umcTickFire en el siguiente frame, sin
 162+ 768B                  ; esperar a que el contador llegue a 0 de forma natural (que podia
 163+ 768B                  ; tardar hasta 50 frames = 1 segundo). El player ve flash + suena AY
 164+ 768B                  ; al instante de cruzar, con la flecha correcta.
 165+ 768B                  ; TickActiveFrames=0 mata cualquier flash residual del tick que estaba
 166+ 768B                  ; en curso en la sala anterior — evita 1-2 frames de bright apuntando
 167+ 768B                  ; a la dir vieja entre el cruce y el nuevo tick.
 168+ 768B 32 C5 5F         LD (MagicCompassTickCounter), A
 169+ 768E 32 C4 5F         LD (MagicCompassTickActiveFrames), A
 170+ 7691 C9               RET
 171+ 7692
 172+ 7692              ; ==============================================================================
 173+ 7692              ; UpdateMagicCompass - Tick por frame (timer, blink, AY tick, path)
