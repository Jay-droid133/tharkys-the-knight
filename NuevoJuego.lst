 764+ 903F              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
 765+ 903F              ; ==============================================================================
 766+ 903F              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
 767+ 903F              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
 768+ 903F              ; ==============================================================================
 769+ 903F              GetSpriteAddr:
 770+ 903F DD 7E 00         LD A, (IX+ENT_SPRITEID)
