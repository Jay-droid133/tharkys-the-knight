 460+ 6F12 ~
 461+ 6F12 ~                ; --- Clear visited bitmap (96 bytes = 768 bits = 256 sids × 3 comps) ---
 462+ 6F12 ~                LD HL, MagicCompassVisited
 463+ 6F12 ~                LD DE, MagicCompassVisited + 1
 464+ 6F12 ~                LD BC, 95
 465+ 6F12 ~                XOR A
 466+ 6F12 ~                LD (HL), A
 467+ 6F12 ~                LDIR
 468+ 6F12 ~
 469+ 6F12 ~                ; --- Inicializar cola con (target, comp 0) ---
 470+ 6F12 ~                XOR A
 471+ 6F12 ~                LD (MagicCompassBfsHead), A
 472+ 6F12 ~                LD (MagicCompassBfsTail), A
 473+ 6F12 ~                LD A, (.cmcpTgtSid)
 474+ 6F12 ~                LD HL, MagicCompassBfsQueue
 475+ 6F12 ~                LD (HL), A                           ; queue[0].sid = target
 476+ 6F12 ~                INC HL
