4829+ BD05              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4830+ BD05              ; ==============================================================================
4831+ BD05              UpdateEnemySpeed:
4832+ BD05 3A 07 C0         LD A, (DayCycleCount)
4833+ BD08 3D               DEC A                               ; 0-based index
4834+ BD09 FE 0A            CP 10
4835+ BD0B 38 02            JR C, .uesOk
4836+ BD0D 3E 09            LD A, 9                             ; Cap en indice 9
4837+ BD0F              .uesOk:
4838+ BD0F F5               PUSH AF                             ; Guardar indice para tabla de anim
4839+ BD10 21 33 BD         LD HL, EnemySpeedTable
4840+ BD13 5F               LD E, A
4841+ BD14 16 00            LD D, 0
4842+ BD16 19               ADD HL, DE
4843+ BD17 7E               LD A, (HL)                          ; A = velocidad × 2
4844+ BD18                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4845+ BD18 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4846+ BD1A 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4847+ BD1C                  ; Hay fraccion .5: alternar +1 en frames impares
4848+ BD1C 47               LD B, A                             ; B = parte entera
4849+ BD1D 3A 48 81         LD A, (GameFrameCounter)
4850+ BD20 E6 01            AND 1                               ; 0 en par, 1 en impar
4851+ BD22 80               ADD A, B                            ; Sumar 0 o 1
4852+ BD23              .uesNoFrac:
4853+ BD23 32 BA 90         LD (CurrentEnemySpeed), A
4854+ BD26                  ; Leer delay de animacion para este ciclo
4855+ BD26 F1               POP AF                              ; A = indice 0-based
4856+ BD27 21 3D BD         LD HL, EnemyAnimDelayTable
4857+ BD2A 5F               LD E, A
4858+ BD2B 16 00            LD D, 0
4859+ BD2D 19               ADD HL, DE
4860+ BD2E 7E               LD A, (HL)
4861+ BD2F 32 BB 90         LD (CurrentEnemyAnimDelay), A
4862+ BD32 C9               RET
