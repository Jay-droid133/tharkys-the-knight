1899+ AD21              ; ==============================================================================
1900+ AD21              ; ==============================================================================
1901+ AD21              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
1902+ AD21              ; ==============================================================================
1903+ AD21              UpdateStamina:
1904+ AD21                  ; --- Regenerar salud (siempre, lento) ---
1905+ AD21 3A FB B5         LD A, (PlayerHealth)
1906+ AD24 FE 10            CP HEALTH_MAX
1907+ AD26 28 12            JR Z, .usHealthFull
1908+ AD28 21 FF B5         LD HL, HealthRegenCtr
1909+ AD2B 34               INC (HL)
1910+ AD2C 7E               LD A, (HL)
1911+ AD2D FE 32            CP HEALTH_REGEN_RATE
1912+ AD2F 38 09            JR C, .usHealthFull
1913+ AD31 36 00            LD (HL), 0
1914+ AD33 3A FB B5         LD A, (PlayerHealth)
1915+ AD36 3C               INC A
1916+ AD37 32 FB B5         LD (PlayerHealth), A
1917+ AD3A              .usHealthFull:
1918+ AD3A                  ; --- Stamina: consumir o regenerar ---
1919+ AD3A DD 7E 02         LD A, (IX+ENT_STATE)
1920+ AD3D FE 02            CP STATE_FIGHTING
1921+ AD3F 28 18            JR Z, .usDrain
1922+ AD41                  ; No atacando: regenerar
1923+ AD41 3A FC B5         LD A, (PlayerStamina)
1924+ AD44 FE 10            CP STAMINA_MAX
1925+ AD46 C8               RET Z                               ; Ya al maximo
1926+ AD47 21 FE B5         LD HL, StaminaRegenCtr
1927+ AD4A 34               INC (HL)
1928+ AD4B 7E               LD A, (HL)
1929+ AD4C FE 19            CP STAMINA_REGEN_RATE
1930+ AD4E D8               RET C                               ; Aun no toca
1931+ AD4F 36 00            LD (HL), 0                          ; Reset counter
1932+ AD51 3A FC B5         LD A, (PlayerStamina)
1933+ AD54 3C               INC A
1934+ AD55 32 FC B5         LD (PlayerStamina), A
1935+ AD58 C9               RET
1936+ AD59              .usDrain:
1937+ AD59                  ; Atacando: consumir stamina
1938+ AD59 3A FC B5         LD A, (PlayerStamina)
1939+ AD5C B7               OR A
1940+ AD5D C8               RET Z                               ; Ya vacia
1941+ AD5E 21 FD B5         LD HL, StaminaDrainCtr
1942+ AD61 34               INC (HL)
1943+ AD62 7E               LD A, (HL)
1944+ AD63 FE 0D            CP STAMINA_DRAIN_RATE
1945+ AD65 D8               RET C
1946+ AD66 36 00            LD (HL), 0
1947+ AD68 3A FC B5         LD A, (PlayerStamina)
1948+ AD6B 3D               DEC A
1949+ AD6C 32 FC B5         LD (PlayerStamina), A
1950+ AD6F                  ; Si stamina llega a 0, dar 1 punto tras cooldown
1951+ AD6F B7               OR A
1952+ AD70 C0               RET NZ
1953+ AD71 3E 01            LD A, 1
1954+ AD73 32 FC B5         LD (PlayerStamina), A               ; Minimo 1 para un swing
1955+ AD76 C9               RET
