 484+ 6F12 ~                LD B, 0
 485+ 6F12 ~                CALL .cmcpMarkVisited
 486+ 6F12 ~
 487+ 6F12 ~                ; INIT done → marcar in-progress y caer al loop con counter de iteraciones.
 488+ 6F12 ~                LD A, 1
 489+ 6F12 ~                LD (MagicCompassBfsState), A
 490+ 6F12 ~
 491+ 6F12 ~            .cmcpResume:
 492+ 6F12 ~                ; Cargar contador de iteraciones para este chunk de frame.
 493+ 6F12 ~                LD A, MAGIC_COMPASS_BFS_ITERS_PER_FRAME
 494+ 6F12 ~                LD (.cmcpItersLeft), A
 495+ 6F12 ~
 496+ 6F12 ~                ; --- BFS loop ---
 497+ 6F12 ~            .cmcpLoop:
 498+ 6F12 ~                ; Yield si se acabó el chunk de iteraciones del frame.
 499+ 6F12 ~                LD A, (.cmcpItersLeft)
 500+ 6F12 ~                OR A
 501+ 6F12 ~                JP Z, .cmcpYield
 502+ 6F12 ~                DEC A
 503+ 6F12 ~                LD (.cmcpItersLeft), A
 504+ 6F12 ~
 505+ 6F12 ~                ; queue empty?
 506+ 6F12 ~                LD A, (MagicCompassBfsHead)
 507+ 6F12 ~                LD B, A
 508+ 6F12 ~                LD A, (MagicCompassBfsTail)
 509+ 6F12 ~                CP B
 510+ 6F12 ~                JP Z, .cmcpNoPath
 511+ 6F12 ~
 512+ 6F12 ~                ; Pop: read queue[tail*2] = (sid, comp); tail++
 513+ 6F12 ~                LD E, A
 514+ 6F12 ~                INC A
 515+ 6F12 ~                AND 63
 516+ 6F12 ~                LD (MagicCompassBfsTail), A
 517+ 6F12 ~                LD A, E
 518+ 6F12 ~                ADD A, A                             ; *2 (entries de 2 bytes)
 519+ 6F12 ~                LD E, A
 520+ 6F12 ~                LD D, 0
 521+ 6F12 ~                LD HL, MagicCompassBfsQueue
 522+ 6F12 ~                ADD HL, DE
 523+ 6F12 ~                LD A, (HL)                           ; sid
 524+ 6F12 ~                LD (.cmcpR), A
 525+ 6F12 ~                INC HL
 526+ 6F12 ~                LD A, (HL)
 527+ 6F12 ~                LD (.cmcpRComp), A
 528+ 6F12 ~
 529+ 6F12 ~                ; Iterate RoomCompGaps[R]
 530+ 6F12 ~                LD A, (.cmcpR)
 531+ 6F12 ~                LD L, A
 532+ 6F12 ~                LD H, 0
 533+ 6F12 ~                ADD HL, HL                           ; *2 (DEFW ptrs)
 534+ 6F12 ~                LD DE, RoomCompGapsTable
 535+ 6F12 ~                ADD HL, DE
 536+ 6F12 ~                LD E, (HL)
 537+ 6F12 ~                INC HL
 538+ 6F12 ~                LD D, (HL)                           ; DE = record ptr
 539+ 6F12 ~                EX DE, HL                            ; HL = record
 540+ 6F12 ~
 541+ 6F12 ~                LD A, (HL)                           ; count
 542+ 6F12 ~                OR A
 543+ 6F12 ~                JP Z, .cmcpLoop                      ; no gaps → next pop
 544+ 6F12 ~                LD B, A                              ; B = remaining count
 545+ 6F12 ~                INC HL                               ; HL @ first {side_comp, coord}
 546+ 6F12 ~
 547+ 6F12 ~            .cmcpGapLoop:
 548+ 6F12 ~                ; Read side_comp byte
 549+ 6F12 ~                LD A, (HL)
 550+ 6F12 ~                LD (.cmcpGapSideComp), A
 551+ 6F12 ~                INC HL
 552+ 6F12 ~                LD A, (HL)
 553+ 6F12 ~                LD (.cmcpGapCoord), A
 554+ 6F12 ~                INC HL
 555+ 6F12 ~                PUSH BC                              ; save count
 556+ 6F12 ~                PUSH HL                              ; save record ptr
 557+ 6F12 ~
 558+ 6F12 ~                ; Match comp?
 559+ 6F12 ~                LD A, (.cmcpGapSideComp)
 560+ 6F12 ~                SRL A
 561+ 6F12 ~                SRL A                                ; A = comp (bits 2-3 → bits 0-1)
 562+ 6F12 ~                AND $03
 563+ 6F12 ~                LD C, A                              ; C = gap comp
 564+ 6F12 ~                LD A, (.cmcpRComp)
 565+ 6F12 ~                CP C
 566+ 6F12 ~                JP NZ, .cmcpGapNext
 567+ 6F12 ~
 568+ 6F12 ~                ; Compute V = neighbor of R in gap.side
 569+ 6F12 ~                LD A, (.cmcpGapSideComp)
 570+ 6F12 ~                AND $03                              ; A = side
 571+ 6F12 ~                LD C, A                              ; C = side
 572+ 6F12 ~                LD A, (.cmcpR)
 573+ 6F12 ~                LD B, A                              ; B = R sid
 574+ 6F12 ~                CALL .cmcpComputeNeighbor            ; IN: B=R, C=side; OUT: A=V (or $FF if invalid)
 575+ 6F12 ~                CP $FF
 576+ 6F12 ~                JP Z, .cmcpGapNext
 577+ 6F12 ~                LD (.cmcpV), A
 578+ 6F12 ~
 579+ 6F12 ~                ; Find V's gap with side=opposite(gap.side) AND coord=gap.coord
 580+ 6F12 ~                LD A, C                              ; side
 581+ 6F12 ~                XOR $01                              ; opposite (N↔S, W↔E using XOR 1 — N=0,S=1,W=2,E=3)
 582+ 6F12 ~                LD C, A                              ; C = opp_side
 583+ 6F12 ~                LD A, (.cmcpGapCoord)
 584+ 6F12 ~                LD B, A                              ; B = coord
 585+ 6F12 ~                LD A, (.cmcpV)
 586+ 6F12 ~                CALL .cmcpFindMatchingGap            ; OUT: A = V_comp (0..2) or $FF if no match
 587+ 6F12 ~                CP $FF
 588+ 6F12 ~                JP Z, .cmcpGapNext
 589+ 6F12 ~                LD (.cmcpVComp), A
 590+ 6F12 ~
 591+ 6F12 ~                ; Check V == current_sid AND V_comp == player_current_comp
 592+ 6F12 ~                LD A, (.cmcpV)
 593+ 6F12 ~                LD B, A
 594+ 6F12 ~                LD A, (.cmcpCurSid)
 595+ 6F12 ~                CP B
 596+ 6F12 ~                JR NZ, .cmcpNotCurrent
 597+ 6F12 ~                LD A, (.cmcpVComp)
 598+ 6F12 ~                LD B, A
 599+ 6F12 ~                LD A, (.cmcpCurComp)
 600+ 6F12 ~                CP B
 601+ 6F12 ~                JR NZ, .cmcpNotCurrent
 602+ 6F12 ~                ; FOUND: dir_player = opposite of gap.side. We already have it as opp_side
 603+ 6F12 ~                ; logic: opposite of side means the direction the player at current goes
 604+ 6F12 ~                ; to reach R. We computed opp_side earlier (used to find V's gap).
 605+ 6F12 ~                ; gap.side from R's perspective = direction to V. Player at V goes
 606+ 6F12 ~                ; opposite(gap.side) = opp_side to reach R.
 607+ 6F12 ~                LD A, (.cmcpGapSideComp)
 608+ 6F12 ~                AND $03                              ; gap.side
 609+ 6F12 ~                XOR $01                              ; player's direction (opposite)
 610+ 6F12 ~                LD (MagicCompassPathDir), A
 611+ 6F12 ~                ; Save gap coord para que DrawCompassGapHint pueda dibujar en el gap concreto
 612+ 6F12 ~                LD A, (.cmcpGapCoord)
 613+ 6F12 ~                LD (MagicCompassPathCoord), A
 614+ 6F12 ~                XOR A
 615+ 6F12 ~                LD (MagicCompassBfsState), A         ; BFS terminado
 616+ 6F12 ~                POP HL
 617+ 6F12 ~                POP BC
 618+ 6F12 ~                RET
 619+ 6F12 ~
 620+ 6F12 ~            .cmcpNotCurrent:
 621+ 6F12 ~                ; Visited check (B=sid, C=comp)
 622+ 6F12 ~                LD A, (.cmcpV)
 623+ 6F12 ~                LD B, A
 624+ 6F12 ~                LD A, (.cmcpVComp)
 625+ 6F12 ~                LD C, A
 626+ 6F12 ~                CALL .cmcpCheckVisitedBC             ; OUT: Z=not visited, NZ=visited
 627+ 6F12 ~                JP NZ, .cmcpGapNext
 628+ 6F12 ~
 629+ 6F12 ~                ; Mark visited (A=sid, B=comp)
 630+ 6F12 ~                LD A, (.cmcpVComp)
 631+ 6F12 ~                LD B, A
 632+ 6F12 ~                LD A, (.cmcpV)
 633+ 6F12 ~                CALL .cmcpMarkVisited
 634+ 6F12 ~
 635+ 6F12 ~                ; Push (V, V_comp) to queue
 636+ 6F12 ~                LD A, (MagicCompassBfsHead)
 637+ 6F12 ~                ADD A, A                             ; *2
 638+ 6F12 ~                LD E, A
 639+ 6F12 ~                LD D, 0
 640+ 6F12 ~                LD HL, MagicCompassBfsQueue
 641+ 6F12 ~                ADD HL, DE
 642+ 6F12 ~                LD A, (.cmcpV)
 643+ 6F12 ~                LD (HL), A
 644+ 6F12 ~                INC HL
 645+ 6F12 ~                LD A, (.cmcpVComp)
 646+ 6F12 ~                LD (HL), A
 647+ 6F12 ~                LD A, (MagicCompassBfsHead)
 648+ 6F12 ~                INC A
 649+ 6F12 ~                AND 63
 650+ 6F12 ~                LD (MagicCompassBfsHead), A
 651+ 6F12 ~
 652+ 6F12 ~            .cmcpGapNext:
 653+ 6F12 ~                POP HL
 654+ 6F12 ~                POP BC
 655+ 6F12 ~                DEC B
 656+ 6F12 ~                JP NZ, .cmcpGapLoop
 657+ 6F12 ~                JP .cmcpLoop
 658+ 6F12 ~
 659+ 6F12 ~            .cmcpNoPath:
 660+ 6F12 ~                XOR A
 661+ 6F12 ~                LD (MagicCompassBfsState), A         ; BFS terminado (sin path)
 662+ 6F12 ~                LD A, $FF
 663+ 6F12 ~                LD (MagicCompassPathDir), A
 664+ 6F12 ~                LD (MagicCompassPathCoord), A
 665+ 6F12 ~                RET
 666+ 6F12 ~
 667+ 6F12 ~            .cmcpYield:
 668+ 6F12 ~                ; Acabamos el chunk de iteraciones de este frame. State queda en 1, así
 669+ 6F12 ~                ; que el siguiente frame UpdateMagicCompass llamará a esta rutina de
 670+ 6F12 ~                ; nuevo y caerá en .cmcpResume (skip init, recargar contador, continuar).
 671+ 6F12 ~                RET
 672+ 6F12 ~
 673+ 6F12 ~            ; ==============================================================================
 674+ 6F12 ~            ; .cmcpFindGapBySide - Para sala A, busca el gap en side B más cercano al
 675+ 6F12 ~            ; LastEntryCoord; devuelve su comp.
 676+ 6F12 ~            ; ==============================================================================
 677+ 6F12 ~            ; IN:  A = sid, B = side (0..3)
 678+ 6F12 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no hay gap en ese side.
 679+ 6F12 ~            ;
 680+ 6F12 ~            ; Cuando hay múltiples gaps del mismo side en distintas comps (e.g. (5,12)
 681+ 6F12 ~            ; con E@3 comp 1 y E@11 comp 0), el coord físico del char donde entró el
 682+ 6F12 ~            ; player desambigua: tomamos el gap con coord más cercano al LastEntryCoord.
 683+ 6F12 ~            ;
 684+ 6F12 ~            ; Destruye: AF, BC, DE, HL.
 685+ 6F12 ~            ; ==============================================================================
 686+ 6F12 ~            .cmcpFindGapBySide:
 687+ 6F12 ~                LD (.fgbsTargetSid), A
 688+ 6F12 ~                LD A, B
 689+ 6F12 ~                LD (.fgbsTargetSide), A
 690+ 6F12 ~                LD A, $FF
 691+ 6F12 ~                LD (.fgbsBestComp), A
 692+ 6F12 ~                LD A, 255
 693+ 6F12 ~                LD (.fgbsBestDist), A                ; init bestDist = 255 (max)
 694+ 6F12 ~
 695+ 6F12 ~                LD A, (.fgbsTargetSid)
 696+ 6F12 ~                LD L, A
 697+ 6F12 ~                LD H, 0
 698+ 6F12 ~                ADD HL, HL
 699+ 6F12 ~                LD DE, RoomCompGapsTable
 700+ 6F12 ~                ADD HL, DE
 701+ 6F12 ~                LD E, (HL)
 702+ 6F12 ~                INC HL
 703+ 6F12 ~                LD D, (HL)
 704+ 6F12 ~                EX DE, HL                            ; HL = record
 705+ 6F12 ~                LD A, (HL)
 706+ 6F12 ~                OR A
 707+ 6F12 ~                JR Z, .fgbsDone
 708+ 6F12 ~                LD B, A                              ; count
 709+ 6F12 ~                INC HL
 710+ 6F12 ~            .fgbsLoop:
 711+ 6F12 ~                LD A, (HL)                           ; side_comp
 712+ 6F12 ~                INC HL
 713+ 6F12 ~                LD C, (HL)                           ; coord
 714+ 6F12 ~                INC HL
 715+ 6F12 ~                LD D, A                              ; D = side_comp
 716+ 6F12 ~                AND $03
 717+ 6F12 ~                LD E, A
 718+ 6F12 ~                LD A, (.fgbsTargetSide)
 719+ 6F12 ~                CP E
 720+ 6F12 ~                JR NZ, .fgbsNext
 721+ 6F12 ~
 722+ 6F12 ~                ; Compute |coord - LastEntryCoord|
 723+ 6F12 ~                LD A, (LastEntryCoord)
 724+ 6F12 ~                SUB C
 725+ 6F12 ~                JR NC, .fgbsAbsOk
 726+ 6F12 ~                NEG
 727+ 6F12 ~            .fgbsAbsOk:
 728+ 6F12 ~                LD E, A                              ; E = distance
 729+ 6F12 ~                LD A, (.fgbsBestDist)
 730+ 6F12 ~                CP E
 731+ 6F12 ~                JR C, .fgbsNext                      ; bestDist < E → not better
 732+ 6F12 ~                JR Z, .fgbsNext                      ; ties: keep first
 733+ 6F12 ~                ; New best
 734+ 6F12 ~                LD A, E
 735+ 6F12 ~                LD (.fgbsBestDist), A
 736+ 6F12 ~                LD A, D
 737+ 6F12 ~                SRL A
 738+ 6F12 ~                SRL A
 739+ 6F12 ~                AND $03
 740+ 6F12 ~                LD (.fgbsBestComp), A
 741+ 6F12 ~
 742+ 6F12 ~            .fgbsNext:
 743+ 6F12 ~                DJNZ .fgbsLoop
 744+ 6F12 ~            .fgbsDone:
 745+ 6F12 ~                LD A, (.fgbsBestComp)
 746+ 6F12 ~                RET
 747+ 6F12 ~
 748+ 6F12 ~            ; ==============================================================================
 749+ 6F12 ~            ; .cmcpComputeNeighbor - Calcula V dado R y side, con bounds check
 750+ 6F12 ~            ; ==============================================================================
 751+ 6F12 ~            ; IN:  B = R sid, C = side (0=N,1=S,2=W,3=E)
 752+ 6F12 ~            ; OUT: A = V sid (0..255) si valid; A = $FF si neighbor sale del mapa.
 753+ 6F12 ~            ; Destruye: AF.
 754+ 6F12 ~            ; ==============================================================================
 755+ 6F12 ~            .cmcpComputeNeighbor:
 756+ 6F12 ~                LD A, C
 757+ 6F12 ~                OR A
 758+ 6F12 ~                JR NZ, .ccnNotN
 759+ 6F12 ~                ; N: V = R - 16, valid if R >= 16
 760+ 6F12 ~                LD A, B
 761+ 6F12 ~                CP 16
 762+ 6F12 ~                JR C, .ccnInvalid
 763+ 6F12 ~                SUB 16
 764+ 6F12 ~                RET
 765+ 6F12 ~            .ccnNotN:
 766+ 6F12 ~                DEC A
 767+ 6F12 ~                JR NZ, .ccnNotS
 768+ 6F12 ~                ; S: V = R + 16, valid if R < 240
 769+ 6F12 ~                LD A, B
 770+ 6F12 ~                CP 240
 771+ 6F12 ~                JR NC, .ccnInvalid
 772+ 6F12 ~                ADD A, 16
 773+ 6F12 ~                RET
 774+ 6F12 ~            .ccnNotS:
 775+ 6F12 ~                DEC A
 776+ 6F12 ~                JR NZ, .ccnE
 777+ 6F12 ~                ; W: V = R - 1, valid if R % 16 != 0
 778+ 6F12 ~                LD A, B
 779+ 6F12 ~                AND $0F
 780+ 6F12 ~                JR Z, .ccnInvalid
 781+ 6F12 ~                LD A, B
 782+ 6F12 ~                DEC A
 783+ 6F12 ~                RET
 784+ 6F12 ~            .ccnE:
 785+ 6F12 ~                ; E: V = R + 1, valid if R % 16 != 15
 786+ 6F12 ~                LD A, B
 787+ 6F12 ~                AND $0F
 788+ 6F12 ~                CP 15
 789+ 6F12 ~                JR Z, .ccnInvalid
 790+ 6F12 ~                LD A, B
 791+ 6F12 ~                INC A
 792+ 6F12 ~                RET
 793+ 6F12 ~            .ccnInvalid:
 794+ 6F12 ~                LD A, $FF
 795+ 6F12 ~                RET
 796+ 6F12 ~
 797+ 6F12 ~            ; ==============================================================================
 798+ 6F12 ~            ; .cmcpFindMatchingGap - Busca en sala A un gap (side=B, coord=C)
 799+ 6F12 ~            ; ==============================================================================
 800+ 6F12 ~            ; Devuelve la comp del gap matching (side AND coord). Permite resolver la
 801+ 6F12 ~            ; correspondencia gap-físico cuando hay múltiples gaps del mismo side en
 802+ 6F12 ~            ; comps distintas.
 803+ 6F12 ~            ; IN:  A = sid, B = coord, C = side
 804+ 6F12 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no match.
 805+ 6F12 ~            ; Destruye: AF, BC, DE, HL.
 806+ 6F12 ~            ; ==============================================================================
 807+ 6F12 ~            .cmcpFindMatchingGap:
 808+ 6F12 ~                LD (.cfmgSid), A
 809+ 6F12 ~                LD A, B
 810+ 6F12 ~                LD (.cfmgCoord), A
 811+ 6F12 ~                LD A, C
 812+ 6F12 ~                LD (.cfmgSide), A
 813+ 6F12 ~                LD A, (.cfmgSid)
 814+ 6F12 ~                LD L, A
 815+ 6F12 ~                LD H, 0
 816+ 6F12 ~                ADD HL, HL
 817+ 6F12 ~                LD DE, RoomCompGapsTable
 818+ 6F12 ~                ADD HL, DE
 819+ 6F12 ~                LD E, (HL)
 820+ 6F12 ~                INC HL
 821+ 6F12 ~                LD D, (HL)
 822+ 6F12 ~                EX DE, HL                            ; HL = record
 823+ 6F12 ~                LD A, (HL)
 824+ 6F12 ~                OR A
 825+ 6F12 ~                JR Z, .cfmgNotFound
 826+ 6F12 ~                LD B, A
 827+ 6F12 ~                INC HL
 828+ 6F12 ~            .cfmgLoop:
 829+ 6F12 ~                LD A, (HL)                           ; side_comp
 830+ 6F12 ~                INC HL
 831+ 6F12 ~                LD C, (HL)                           ; coord
 832+ 6F12 ~                INC HL
 833+ 6F12 ~                LD D, A                              ; D = side_comp
 834+ 6F12 ~                AND $03                              ; side
 835+ 6F12 ~                LD E, A
 836+ 6F12 ~                LD A, (.cfmgSide)
 837+ 6F12 ~                CP E
 838+ 6F12 ~                JR NZ, .cfmgSkip
 839+ 6F12 ~                LD A, (.cfmgCoord)
 840+ 6F12 ~                CP C
 841+ 6F12 ~                JR NZ, .cfmgSkip
 842+ 6F12 ~                ; Match. Extract comp.
 843+ 6F12 ~                LD A, D
 844+ 6F12 ~                SRL A
 845+ 6F12 ~                SRL A
 846+ 6F12 ~                AND $03
 847+ 6F12 ~                RET
 848+ 6F12 ~            .cfmgSkip:
 849+ 6F12 ~                DJNZ .cfmgLoop
 850+ 6F12 ~            .cfmgNotFound:
 851+ 6F12 ~                LD A, $FF
 852+ 6F12 ~                RET
 853+ 6F12 ~
 854+ 6F12 ~            ; ==============================================================================
 855+ 6F12 ~            ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 856+ 6F12 ~            ; ==============================================================================
 857+ 6F12 ~            ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 858+ 6F12 ~            ; bit_idx en 16-bit: HL.
 859+ 6F12 ~            ;
 860+ 6F12 ~            ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 861+ 6F12 ~            ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 862+ 6F12 ~            ; ==============================================================================
 863+ 6F12 ~            .cmcpMarkVisited:
 864+ 6F12 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 865+ 6F12 ~                LD H, 0
 866+ 6F12 ~                LD L, A                              ; HL = sid
 867+ 6F12 ~                PUSH HL
 868+ 6F12 ~                ADD HL, HL                           ; HL = sid*2
 869+ 6F12 ~                POP DE
 870+ 6F12 ~                ADD HL, DE                           ; HL = sid*3
 871+ 6F12 ~                LD E, B
 872+ 6F12 ~                LD D, 0
 873+ 6F12 ~                ADD HL, DE                           ; HL = sid*3 + comp
 874+ 6F12 ~                ; bit pos = HL & 7; byte idx = HL >> 3
 875+ 6F12 ~                LD A, L
 876+ 6F12 ~                AND $07
 877+ 6F12 ~                LD C, A                              ; C = bit pos
 878+ 6F12 ~                SRL H
 879+ 6F12 ~                RR L
 880+ 6F12 ~                SRL H
 881+ 6F12 ~                RR L
 882+ 6F12 ~                SRL H
 883+ 6F12 ~                RR L                                 ; HL = HL/8 (byte idx)
 884+ 6F12 ~                LD DE, MagicCompassVisited
 885+ 6F12 ~                ADD HL, DE                           ; HL = byte addr
 886+ 6F12 ~                LD A, 1
 887+ 6F12 ~                INC C
 888+ 6F12 ~            .cmvShift:
 889+ 6F12 ~                DEC C
 890+ 6F12 ~                JR Z, .cmvDone
 891+ 6F12 ~                ADD A, A
 892+ 6F12 ~                JR .cmvShift
 893+ 6F12 ~            .cmvDone:
 894+ 6F12 ~                OR (HL)
 895+ 6F12 ~                LD (HL), A
 896+ 6F12 ~                RET
 897+ 6F12 ~
 898+ 6F12 ~            .cmcpCheckVisitedBC:
 899+ 6F12 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 900+ 6F12 ~                LD H, 0
 901+ 6F12 ~                LD L, B                              ; HL = sid
 902+ 6F12 ~                PUSH HL
 903+ 6F12 ~                ADD HL, HL
 904+ 6F12 ~                POP DE
 905+ 6F12 ~                ADD HL, DE                           ; HL = sid*3
 906+ 6F12 ~                LD E, C
 907+ 6F12 ~                LD D, 0
 908+ 6F12 ~                ADD HL, DE                           ; HL = sid*3 + comp
 909+ 6F12 ~                LD A, L
 910+ 6F12 ~                AND $07
 911+ 6F12 ~                LD C, A
 912+ 6F12 ~                SRL H
 913+ 6F12 ~                RR L
 914+ 6F12 ~                SRL H
 915+ 6F12 ~                RR L
 916+ 6F12 ~                SRL H
 917+ 6F12 ~                RR L
 918+ 6F12 ~                LD DE, MagicCompassVisited
 919+ 6F12 ~                ADD HL, DE
 920+ 6F12 ~                LD A, 1
 921+ 6F12 ~                INC C
 922+ 6F12 ~            .ccvShift:
 923+ 6F12 ~                DEC C
 924+ 6F12 ~                JR Z, .ccvDone
 925+ 6F12 ~                ADD A, A
 926+ 6F12 ~                JR .ccvShift
 927+ 6F12 ~            .ccvDone:
 928+ 6F12 ~                AND (HL)
 929+ 6F12 ~                RET
 930+ 6F12 ~
 931+ 6F12 ~            ; --- Locals de ComputeMagicCompassPath (deben quedar DENTRO del scope global
 932+ 6F12 ~            ; ComputeMagicCompassPath; no insertar globals entre ellas y la rutina). ---
 933+ 6F12 ~            .cmcpCurSid:        DEFB 0
 934+ 6F12 ~            .cmcpTgtSid:        DEFB 0
 935+ 6F12 ~            .cmcpCurComp:       DEFB 0
 936+ 6F12 ~            .cmcpR:             DEFB 0
 937+ 6F12 ~            .cmcpRComp:         DEFB 0
 938+ 6F12 ~            .cmcpV:             DEFB 0
 939+ 6F12 ~            .cmcpVComp:         DEFB 0
 940+ 6F12 ~            .cmcpGapSideComp:   DEFB 0
 941+ 6F12 ~            .cmcpGapCoord:      DEFB 0
 942+ 6F12 ~            .cfmgSid:           DEFB 0
 943+ 6F12 ~            .cfmgCoord:         DEFB 0
 944+ 6F12 ~            .cfmgSide:          DEFB 0
 945+ 6F12 ~            .fgbsTargetSid:     DEFB 0
 946+ 6F12 ~            .fgbsTargetSide:    DEFB 0
 947+ 6F12 ~            .fgbsBestComp:      DEFB 0
 948+ 6F12 ~            .fgbsBestDist:      DEFB 0
 949+ 6F12 ~            .cmcpItersLeft:     DEFB 0       ; chunked BFS: iteraciones que quedan en este frame
 950+ 6F12                  ENDIF                            ; fin del IF 0 que envuelve el _OLD body
