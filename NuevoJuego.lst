 460+ FA0A CD 06 F9         CALL BankCutsceneSnapToRetreat
 461+ FA0D 3E 32            LD A, BCS_T_GROUP_WAIT
 462+ FA0F 32 CD 82         LD (BankCutsceneTimer), A
 463+ FA12 3E 05            LD A, BCP_WAIT_2
 464+ FA14 32 CC 82         LD (BankCutscenePhase), A
 465+ FA17 C9               RET
 466+ FA18
 467+ FA18              ; ---- Phase 5: WAIT_2 ----
 468+ FA18              .bcPhWait2:
 469+ FA18 CD 09 FC         CALL BankCutsceneDecTimer
 470+ FA1B C0               RET NZ
 471+ FA1C                  ; Player gira a S (cara camara).
 472+ FA1C DD 21 9E 81      LD IX, EntityTable
 473+ FA20 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 474+ FA22 DD 77 00         LD (IX+ENT_SPRITEID), A
