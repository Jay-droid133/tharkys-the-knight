2621+ DA09              ; ==============================================================================
2622+ DA09              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2623+ DA09              ; ==============================================================================
2624+ DA09              ; IN:  DE = BgGfx pointer
2625+ DA09              ; OUT: A = 0 (normal), 1..7 (key), 8..13 (lock con key requerida = A-7)
2626+ DA09              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2627+ DA09              ; ==============================================================================
2628+ DA09              GetPickupKeyBehavior:
2629+ DA09 E5               PUSH HL
2630+ DA0A C5               PUSH BC
2631+ DA0B 21 4F D7         LD HL, KeyLockTable
2632+ DA0E 06 0D            LD B, 13                    ; 13 slots (insertado BankCheck en slot 7)
2633+ DA10 0E 01            LD C, 1                     ; id actual (1..13)
2634+ DA12              .gpkbLoop:
2635+ DA12 7E               LD A, (HL)                  ; ptr_lo del slot
2636+ DA13 BB               CP E
2637+ DA14 20 06            JR NZ, .gpkbNext
2638+ DA16 23               INC HL
2639+ DA17 7E               LD A, (HL)                  ; ptr_hi
2640+ DA18 2B               DEC HL
2641+ DA19 BA               CP D
2642+ DA1A 28 09            JR Z, .gpkbFound
2643+ DA1C              .gpkbNext:
2644+ DA1C 23               INC HL
2645+ DA1D 23               INC HL                      ; siguiente slot (DEFW = 2 bytes)
2646+ DA1E 0C               INC C
2647+ DA1F 10 F1            DJNZ .gpkbLoop
2648+ DA21 AF               XOR A                       ; no encontrado → comportamiento normal
2649+ DA22 C1               POP BC
2650+ DA23 E1               POP HL
2651+ DA24 C9               RET
2652+ DA25              .gpkbFound:
2653+ DA25 79               LD A, C                     ; A = id (1..8)
2654+ DA26 C1               POP BC
2655+ DA27 E1               POP HL
2656+ DA28 C9               RET
2657+ DA29
2658+ DA29              ; ==============================================================================
2659+ DA29              ; RefreshPickupAttrs - Repinta los atributos de los pickups activos del room actual
2660+ DA29              ; ==============================================================================
2661+ DA29              ; Los enemigos restauran atributos desde CleanAttrMap (que NO incluye pickups)
2662+ DA29              ; cuando se borran. Después de que pasen por encima de un pickup, los chars
2663+ DA29              ; quedan con attrs de fondo y el pickup pierde su color característico. Esta
2664+ DA29              ; función se llama una vez por frame después de ProcessEnemies para re-pintar
2665+ DA29              ; los attrs de cada pickup activo en el room actual.
2666+ DA29              ; ==============================================================================
2667+ DA29              RefreshPickupAttrs:
2668+ DA29 3A 16 83         LD A, (PickupAttrsDirty)
2669+ DA2C B7               OR A
2670+ DA2D C8               RET Z                       ; nada erased sobre un pickup -> no-op
2671+ DA2E AF               XOR A
2672+ DA2F 32 16 83         LD (PickupAttrsDirty), A
2673+ DA32 21 26 DF         LD HL, PickupTable
2674+ DA35              .rpaLoop:
2675+ DA35 7E               LD A, (HL)
2676+ DA36 FE FF            CP $FF
2677+ DA38 C8               RET Z
2678+ DA39 FE FE            CP $FE
2679+ DA3B 28 3A            JR Z, .rpaInactive          ; HL en mapX
2680+ DA3D 47               LD B, A                     ; mapX
2681+ DA3E 23               INC HL
2682+ DA3F 4E               LD C, (HL)                  ; mapY
2683+ DA40 23               INC HL                      ; HL en ptr_lo
2684+ DA41 3A 0B 83         LD A, (CurrentScreenX)
2685+ DA44 B8               CP B
2686+ DA45 20 2A            JR NZ, .rpaSkip
2687+ DA47 3A 0C 83         LD A, (CurrentScreenY)
2688+ DA4A B9               CP C
2689+ DA4B 20 24            JR NZ, .rpaSkip
2690+ DA4D                  ; Pantalla correcta: cargar sprite y pintar attrs
2691+ DA4D 5E               LD E, (HL)
2692+ DA4E 23               INC HL
2693+ DA4F 56               LD D, (HL)                  ; DE = BgGfx ptr
2694+ DA50 23               INC HL                      ; HL en charX
2695+ DA51 46               LD B, (HL)                  ; charX
2696+ DA52 23               INC HL
2697+ DA53 4E               LD C, (HL)                  ; charY
2698+ DA54 23               INC HL
2699+ DA55 7E               LD A, (HL)                  ; tint variant
2700+ DA56 23               INC HL                      ; HL en siguiente mapX
2701+ DA57 32 77 D2         LD (CurrentTintVar), A
2702+ DA5A E5               PUSH HL                     ; guardar puntero a siguiente entry
2703+ DA5B C5               PUSH BC                     ; charX, charY (LoadBgSpriteToBuffer preserva BC, pero por seguridad)
2704+ DA5C EB               EX DE, HL                   ; HL = BgGfx ptr
2705+ DA5D 3E 03            LD A, 3                     ; ObjectTable (attrs) ptrs viven en bank 3
2706+ DA5F CD C2 6C         CALL LoadBgSpriteToBuffer
2707+ DA62 C1               POP BC
2708+ DA63 DD 21 F8 86      LD IX, BgSpriteBuffer
2709+ DA67 AF               XOR A
2710+ DA68 32 D8 E2         LD (BgSpriteIsHouse), A
2711+ DA6B CD 25 DC         CALL DrawBgAttrOnly         ; solo attrs
2712+ DA6E E1               POP HL                      ; recuperar puntero a siguiente entry
2713+ DA6F 18 C4            JR .rpaLoop
2714+ DA71              .rpaSkip:
2715+ DA71                  ; HL en ptr_lo. Skip 5 (ptr_lo, ptr_hi, charX, charY, tint) al siguiente mapX.
2716+ DA71 11 05 00         LD DE, 5
2717+ DA74 19               ADD HL, DE
2718+ DA75 18 BE            JR .rpaLoop
2719+ DA77              .rpaInactive:
2720+ DA77                  ; HL en mapX ($FE). Skip 7.
2721+ DA77 11 07 00         LD DE, 7
2722+ DA7A 19               ADD HL, DE
2723+ DA7B 18 B8            JR .rpaLoop
