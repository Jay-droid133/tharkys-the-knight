 357+ 6A76 CB 3F            SRL A
 358+ 6A78 CB 3F            SRL A
 359+ 6A7A CB 3F            SRL A                               ; x_char = posX / 8
 360+ 6A7C 47               LD B, A
 361+ 6A7D 3A F4 82         LD A, (CorpseY)
 362+ 6A80 C6 05            ADD A, 5                            ; tomb 16px alineada a base del player 21px
 363+ 6A82 CB 3F            SRL A
 364+ 6A84 CB 3F            SRL A
 365+ 6A86 CB 3F            SRL A                               ; abs_char_y = (posY+5) / 8
 366+ 6A88 D6 02            SUB BG_Y_OFFSET                     ; DrawBgGfxSprite re-suma BG_Y_OFFSET
 367+ 6A8A 4F               LD C, A
 368+ 6A8B DD 21 F7 86      LD IX, BgSpriteBuffer
 369+ 6A8F CD 94 D1         CALL DrawBgGfxSprite
