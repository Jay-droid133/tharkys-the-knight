6137+ C4F1
6138+ C4F1              ; ==============================================================================
6139+ C4F1              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6140+ C4F1              ; ==============================================================================
6141+ C4F1              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6142+ C4F1              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6143+ C4F1              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6144+ C4F1              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6145+ C4F1              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6146+ C4F1              ; main.asm; aqui no hace falta guard adicional).
6147+ C4F1              ; ==============================================================================
6148+ C4F1
6149+ C4F1              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6150+ C4F1              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6151+ C4F1              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6152+ C4F1              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6153+ C4F1              ;
6154+ C4F1              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6155+ C4F1              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6156+ C4F1              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6157+ C4F1              ;
6158+ C4F1              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6159+ C4F1              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6160+ C4F1              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6161+ C4F1              ; en vez de 8 + orientacion invertida).
6162+ C4F1              UpdateDeath:
6163+ C4F1                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6164+ C4F1                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6165+ C4F1                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6166+ C4F1                  ; progreso real, no solo quedar inmovil. ---
6167+ C4F1 2A 4C 82         LD HL, (DeathGhostStuckTimer)
6168+ C4F4 23               INC HL
6169+ C4F5 22 4C 82         LD (DeathGhostStuckTimer), HL
6170+ C4F8 7C               LD A, H
6171+ C4F9 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6172+ C4FB 38 0C            JR C, .udGhostCheckDone
6173+ C4FD 20 05            JR NZ, .udGhostOn
6174+ C4FF 7D               LD A, L
6175+ C500 FE 7D            CP (DEATH_GHOST_FRAMES) & $FF
6176+ C502 38 05            JR C, .udGhostCheckDone
6177+ C504              .udGhostOn:
6178+ C504 3E 01            LD A, 1
6179+ C506 32 4E 82         LD (DeathGhostMode), A
6180+ C509              .udGhostCheckDone:
6181+ C509
6182+ C509                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6183+ C509 3A 4E 82         LD A, (DeathGhostMode)
6184+ C50C B7               OR A
6185+ C50D C2 54 C5         JP NZ, DeathGhostChase
6186+ C510
6187+ C510                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6188+ C510 DD 7E 03         LD A, (IX+ENT_POSX)
6189+ C513 32 49 82         LD (DeathPrevX), A
6190+ C516 DD 7E 04         LD A, (IX+ENT_POSY)
6191+ C519 32 4A 82         LD (DeathPrevY), A
6192+ C51C                  ; Sub-pixel acc 1/2
6193+ C51C 3A 48 82         LD A, (DeathSubPixelAcc)
6194+ C51F EE 01            XOR 1
6195+ C521 32 48 82         LD (DeathSubPixelAcc), A
6196+ C524 28 05            JR Z, .udSkip
6197+ C526 CD 34 B0         CALL UpdateMonster                  ; activo: chase + move + animate
6198+ C529 18 03            JR .udPost
6199+ C52B              .udSkip:
6200+ C52B CD B9 C5         CALL DeathAnimate                   ; skip: solo animacion
6201+ C52E              .udPost:
6202+ C52E                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6203+ C52E 3A 49 82         LD A, (DeathPrevX)
6204+ C531 DD BE 03         CP (IX+ENT_POSX)
6205+ C534 20 19            JR NZ, .udMoved
6206+ C536 3A 4A 82         LD A, (DeathPrevY)
6207+ C539 DD BE 04         CP (IX+ENT_POSY)
6208+ C53C 20 11            JR NZ, .udMoved
6209+ C53E                  ; No movio: incrementar BFS counter
6210+ C53E 3A 4B 82         LD A, (DeathStuckCounter)
6211+ C541 3C               INC A
6212+ C542 32 4B 82         LD (DeathStuckCounter), A
6213+ C545 FE 06            CP DEATH_STUCK_THRESHOLD
6214+ C547 D8               RET C
6215+ C548 AF               XOR A
6216+ C549 32 4B 82         LD (DeathStuckCounter), A
6217+ C54C C3 0C C7         JP DeathBfsRescue
6218+ C54F              .udMoved:
6219+ C54F AF               XOR A
6220+ C550 32 4B 82         LD (DeathStuckCounter), A
6221+ C553 C9               RET
6222+ C554
6223+ C554              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6224+ C554              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6225+ C554              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6226+ C554              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6227+ C554              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6228+ C554              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6229+ C554              DeathGhostChase:
6230+ C554                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6231+ C554 3A 17 81         LD A, (EntityTable + ENT_POSX)
6232+ C557 DD 96 03         SUB (IX+ENT_POSX)
6233+ C55A 30 02            JR NC, .udgAbsDxOk
6234+ C55C ED 44            NEG
6235+ C55E              .udgAbsDxOk:
6236+ C55E 47               LD B, A                             ; B = |dx|
6237+ C55F 3A 18 81         LD A, (EntityTable + ENT_POSY)
6238+ C562 DD 96 04         SUB (IX+ENT_POSY)
6239+ C565 30 02            JR NC, .udgAbsDyOk
6240+ C567 ED 44            NEG
6241+ C569              .udgAbsDyOk:
6242+ C569                  ; A = |dy|, B = |dx|
6243+ C569 B8               CP B
6244+ C56A 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6245+ C56C
6246+ C56C                  ; --- Eje X primario ---
6247+ C56C AF               XOR A
6248+ C56D DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6249+ C570 3A 17 81         LD A, (EntityTable + ENT_POSX)
6250+ C573 DD 96 03         SUB (IX+ENT_POSX)
6251+ C576 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6252+ C578 3E 04            LD A, DEATH_GHOST_SPEED
6253+ C57A 30 02            JR NC, .udgXSet
6254+ C57C 3E FC            LD A, -DEATH_GHOST_SPEED
6255+ C57E              .udgXSet:
6256+ C57E DD 77 06         LD (IX+ENT_DELTAX), A
6257+ C581 DD 86 03         ADD A, (IX+ENT_POSX)
6258+ C584 DD 77 03         LD (IX+ENT_POSX), A
6259+ C587 18 1B            JR .udgAnim
6260+ C589
6261+ C589                  ; --- Eje Y primario ---
6262+ C589              .udgVertPrim:
