 188+ 90A9 32 16 91         LD (.lbsHsave), A
 189+ 90AC 23               INC HL
 190+ 90AD 13               INC DE
 191+ 90AE                  ; Copiar W|RLE (header byte 1)
 192+ 90AE 7E               LD A, (HL)
 193+ 90AF 12               LD (DE), A
 194+ 90B0 23               INC HL
 195+ 90B1 13               INC DE
 196+ 90B2 CB 7F            BIT 7, A
 197+ 90B4 20 47            JR NZ, .lbsRleFallback
 198+ 90B6 E6 7F            AND $7F
 199+ 90B8 32 17 91         LD (.lbsWsave), A
 200+ 90BB                  ; --- Copiar H filas de W bytes de pixeles ---
 201+ 90BB 3A 16 91         LD A, (.lbsHsave)
 202+ 90BE B7               OR A
 203+ 90BF 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 204+ 90C1 47               LD B, A                         ; B = H (outer loop)
 205+ 90C2              .lbsPixRow:
 206+ 90C2 3A 17 91         LD A, (.lbsWsave)
 207+ 90C5 B7               OR A
 208+ 90C6 28 08            JR Z, .lbsPixRowDone
 209+ 90C8 4F               LD C, A                         ; C = W (inner loop)
 210+ 90C9              .lbsPixCol:
 211+ 90C9 7E               LD A, (HL)
 212+ 90CA 12               LD (DE), A
 213+ 90CB 23               INC HL
 214+ 90CC 13               INC DE
 215+ 90CD 0D               DEC C
 216+ 90CE 20 F9            JR NZ, .lbsPixCol
 217+ 90D0              .lbsPixRowDone:
 218+ 90D0 10 F0            DJNZ .lbsPixRow
 219+ 90D2              .lbsAfterPixels:
 220+ 90D2                  ; --- Copiar 1 byte tint ---
 221+ 90D2 7E               LD A, (HL)
 222+ 90D3 12               LD (DE), A
 223+ 90D4 23               INC HL
 224+ 90D5 13               INC DE
 225+ 90D6                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 226+ 90D6 7E               LD A, (HL)
 227+ 90D7 12               LD (DE), A
 228+ 90D8 32 16 91         LD (.lbsHsave), A               ; reusar var
 229+ 90DB 23               INC HL
 230+ 90DC 13               INC DE
 231+ 90DD 7E               LD A, (HL)
 232+ 90DE 12               LD (DE), A
 233+ 90DF 32 17 91         LD (.lbsWsave), A
