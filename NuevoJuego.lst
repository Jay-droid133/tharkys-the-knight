 133  713B                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 134  713B                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 135  713B                  ; via RoomExitsTable (que vive aqui mismo, slot 1, sin paginar bank 6).
 136  713B                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 713B              ; ==============================================================================
   2+ 713B              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 713B              ; ==============================================================================
   4+ 713B              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 713B              ; Mientras MagicCompassTimer>0:
   6+ 713B              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 713B              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 713B              ;     RoomExitsTable), no a la dirección directa al hito.
   9+ 713B              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 713B              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 713B              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 713B              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 713B              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 713B              ;
  15+ 713B              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  16+ 713B              ; BFS no requiere paginar bank 6: lee RoomExitsTable (slot 1, $6000+).
  17+ 713B              ; ==============================================================================
  18+ 713B
  19+ 713B              ; ==============================================================================
  20+ 713B              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  21+ 713B              ; ==============================================================================
  22+ 713B              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  23+ 713B              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  24+ 713B              ; Destruye: AF, HL.
  25+ 713B              ; ==============================================================================
  26+ 713B              ApplyMagicCompassBuff:
  27+ 713B 21 EE 02         LD HL, MAGIC_COMPASS_FRAMES
  28+ 713E 22 BF 5F         LD (MagicCompassTimer), HL
  29+ 7141 3E 01            LD A, 1
  30+ 7143 32 C2 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  31+ 7146 AF               XOR A
  32+ 7147 32 C3 5F         LD (MagicCompassBlinkPhase), A
  33+ 714A 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  34+ 714C 32 C4 5F         LD (MagicCompassTickCounter), A
  35+ 714F                  ; Arrancar jingle: idx=0, frames=1 → primera nota se dispara YA en update
  36+ 714F AF               XOR A
  37+ 7150 32 C5 5F         LD (MagicCompassJingleIdx), A
  38+ 7153 3E 01            LD A, 1
  39+ 7155 32 C6 5F         LD (MagicCompassJingleFrames), A
  40+ 7158 C9               RET
  41+ 7159
  42+ 7159              ; ==============================================================================
  43+ 7159              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido)
  44+ 7159              ; ==============================================================================
  45+ 7159              ; Si timer != 0: silenciar tick y borrar timer.  Idempotente (no-op si ya
  46+ 7159              ; estaba inactivo, NO toca jingle si ya esta sonando para no cortarlo seco).
  47+ 7159              ; Destruye: AF.
  48+ 7159              ; ==============================================================================
  49+ 7159              CancelMagicCompass:
  50+ 7159 3A BF 5F         LD A, (MagicCompassTimer)
  51+ 715C 47               LD B, A
  52+ 715D 3A C0 5F         LD A, (MagicCompassTimer + 1)
  53+ 7160 B0               OR B
  54+ 7161 C8               RET Z                                ; ya inactivo
  55+ 7162 AF               XOR A
  56+ 7163 32 BF 5F         LD (MagicCompassTimer), A
  57+ 7166 32 C0 5F         LD (MagicCompassTimer + 1), A
  58+ 7169 32 C4 5F         LD (MagicCompassTickCounter), A
  59+ 716C C9               RET
  60+ 716D
