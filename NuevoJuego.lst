2706+ ADCA DD 77 07         LD (IX+ENT_DELTAY), A
2707+ ADCD              .eYDone:
2708+ ADCD
2709+ ADCD                  ; --- Animacion: seleccionar par de frames segun direccion horizontal ---
2710+ ADCD                  ; DELTAX >= 0 → base+0,base+1 (derecha). DELTAX < 0 → base+2,base+3 (izquierda).
2711+ ADCD DD 7E 06         LD A, (IX+ENT_DELTAX)
2712+ ADD0 0E 00            LD C, ENEMY_FRAMES_RIGHT    ; C = offset de direccion (0 = derecha)
2713+ ADD2 CB 7F            BIT 7, A
2714+ ADD4 28 02            JR Z, .eAnimDir
2715+ ADD6 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2716+ ADD8              .eAnimDir:
2717+ ADD8 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2718+ ADDB 20 27            JR NZ, .eAnimDone
2719+ ADDD 3A 5E 8D         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2720+ ADE0 47               LD B, A
2721+ ADE1 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2722+ ADE4 FE 34            CP SPRID_ENEMY_5
2723+ ADE6 78               LD A, B
2724+ ADE7 20 06            JR NZ, .eAnimDelaySet
2725+ ADE9 CB 3F            SRL A                               ; Rata: mitad del delay
2726+ ADEB B7               OR A
2727+ ADEC 20 01            JR NZ, .eAnimDelaySet
2728+ ADEE 3C               INC A                               ; Minimo 1
2729+ ADEF              .eAnimDelaySet:
2730+ ADEF DD 77 09         LD (IX+ENT_ANIMTIMER), A
