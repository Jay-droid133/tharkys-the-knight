# file opened: day_cycle.asm
   1+ E3F6              ; ==============================================================================
   2+ E3F6              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E3F6              ; ==============================================================================
   4+ E3F6              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E3F6              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E3F6              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E3F6              ; ==============================================================================
   8+ E3F6
   9+ E3F6              ; --- Constantes ---
  10+ E3F6              NUM_TIME_MOMENTS    EQU 7
  11+ E3F6
  12+ E3F6              ; --- Variables ---
  13+ E3F6 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E3F7 92 E8        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E3F9 92 E8        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E3FB 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E3FC 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E3FD 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E3FE
  20+ E3FE              ; ==============================================================================
  21+ E3FE              ; SetTimeOfDay - Cambia el momento del dia
  22+ E3FE              ; ==============================================================================
  23+ E3FE              ; Entrada: A = momento (0-6)
  24+ E3FE              ; ==============================================================================
  25+ E3FE              SetTimeOfDay:
  26+ E3FE 32 F6 E3         LD (CurrentTimeOfDay), A
  27+ E401
  28+ E401                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E401 FE 04            CP 4
  30+ E403 20 06            JR NZ, .notNewCycle
  31+ E405 21 24 BD         LD HL, DayCycleCount
  32+ E408 34               INC (HL)
  33+ E409 18 04            JR .skipBellsReset
  34+ E40B              .notNewCycle:
  35+ E40B                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E40B                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E40B                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E40B AF               XOR A
  39+ E40C 32 BE 82         LD (BellsTriggered), A
  40+ E40F              .skipBellsReset:
  41+ E40F 3A F6 E3         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E412
  43+ E412                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E412 FE 04            CP 4
  45+ E414 28 24            JR Z, .bellsFirst
  46+ E416
  47+ E416                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E416 FE 05            CP 5
  49+ E418 20 0D            JR NZ, .noScareMon
  50+ E41A CD 3E BD         CALL ScareAllMonsters
  51+ E41D CD D5 FB         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E420                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E420                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E420                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E420                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E420 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E422 CD C2 99         CALL StartMusic
  58+ E425 18 07            JR .noKillMon
  59+ E427              .noScareMon:
  60+ E427                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E427 FE 06            CP 6
  62+ E429 20 03            JR NZ, .noKillMon
  63+ E42B CD C7 BC         CALL KillAllActiveMonsters
  64+ E42E              .noKillMon:
  65+ E42E
  66+ E42E                  ; Actualizar tablas de remap y tabla de nasties
  67+ E42E CD 63 E4         CALL UpdateRemapTables
  68+ E431 CD 27 BD         CALL UpdateNastyTable
  69+ E434
  70+ E434                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E434 3E 01            LD A, 1
  72+ E436 32 19 83         LD (AttrsDirty), A
  73+ E439 C9               RET
  74+ E43A
  75+ E43A              .bellsFirst:
  76+ E43A                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E43A                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E43A                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E43A                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E43A                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E43A CD 27 BD         CALL UpdateNastyTable
  82+ E43D                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E43D                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E43D 3A BE 82         LD A, (BellsTriggered)
  85+ E440 B7               OR A
  86+ E441 C0               RET NZ
  87+ E442 3E 01            LD A, 1
  88+ E444 32 BE 82         LD (BellsTriggered), A
  89+ E447 CD 4B FB         CALL StartBellChimes
  90+ E44A C9               RET
  91+ E44B
  92+ E44B              ; ==============================================================================
  93+ E44B              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E44B              ; ==============================================================================
  95+ E44B              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E44B              ;   - Salta reloj a 00:00.
  97+ E44B              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E44B              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E44B              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E44B              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E44B              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E44B              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E44B              ;     pero ya esta en N2 -> no-op visual.
 104+ E44B              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E44B              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E44B              ;
 107+ E44B              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E44B              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E44B              ; aqui no re-dispara nada.
 110+ E44B              ; ==============================================================================
 111+ E44B              TriggerChurchMidnight:
 112+ E44B 3A BE 82         LD A, (BellsTriggered)
 113+ E44E B7               OR A
 114+ E44F C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E450 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E452 CD 42 EC         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E455 3E 04            LD A, 4
 118+ E457 CD FE E3         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E45A                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E45A                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E45A                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E45A CD 63 E4         CALL UpdateRemapTables
 123+ E45D 3E 01            LD A, 1
 124+ E45F 32 19 83         LD (AttrsDirty), A
 125+ E462 C9               RET
 126+ E463
 127+ E463              ; ==============================================================================
 128+ E463              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 129+ E463              ; ==============================================================================
 130+ E463              UpdateRemapTables:
 131+ E463 3A F6 E3         LD A, (CurrentTimeOfDay)
 132+ E466 21 66 E8         LD HL, RemapTablePtrs
 133+ E469 5F               LD E, A
 134+ E46A 16 00            LD D, 0
 135+ E46C 19               ADD HL, DE
 136+ E46D 19               ADD HL, DE
 137+ E46E 5E               LD E, (HL)
 138+ E46F 23               INC HL
 139+ E470 56               LD D, (HL)
 140+ E471 ED 53 F7 E3      LD (CurrentRemapTable), DE
