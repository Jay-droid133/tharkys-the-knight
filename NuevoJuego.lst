 143  6D47                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 144  6D47                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 145  6D47                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: code/sfx_player_hit_ay.asm
   1+ 6D47              ; ==============================================================================
   2+ 6D47              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6D47              ; ==============================================================================
   4+ 6D47              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6D47              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6D47              ;
   7+ 6D47              ; Diseño beeper-style:
   8+ 6D47              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6D47              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6D47              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6D47              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6D47              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6D47              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6D47              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6D47              ;     hits clasicos en 48K).
  16+ 6D47              ;   - AY_UpdatePlayerHit se llama cada 2 IRQs (= 25 Hz) desde el handler IM 2
  17+ 6D47              ;     en music_irq.asm (cold path: salta en RET Z si no hay sweep activo).
  18+ 6D47              ;     Tickear desde IRQ inmuniza la duracion del beep frente a la latencia
  19+ 6D47              ;     de MainLoop (transiciones lentas estiraban el beep antes).
  20+ 6D47              ;
  21+ 6D47              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  22+ 6D47              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  23+ 6D47              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  24+ 6D47              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  25+ 6D47              ;
  26+ 6D47              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  27+ 6D47              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  28+ 6D47              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  29+ 6D47              ;
  30+ 6D47              ; Llamado desde:
  31+ 6D47              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  32+ 6D47              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  33+ 6D47              ;   - MainLoop cada frame — update.
  34+ 6D47              ; ==============================================================================
  35+ 6D47
  36+ 6D47              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  37+ 6D47 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  38+ 6D48 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  39+ 6D4A 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  40+ 6D4C 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  41+ 6D4D                                                ; (0 = inactivo o ya muteado)
  42+ 6D4D
  43+ 6D4D              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  44+ 6D4D              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  45+ 6D4D              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  46+ 6D4D              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  47+ 6D4D
  48+ 6D4D              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  49+ 6D4D              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  50+ 6D4D              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  51+ 6D4D              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  52+ 6D4D
  53+ 6D4D              ; ==============================================================================
  54+ 6D4D              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  55+ 6D4D              ; ==============================================================================
  56+ 6D4D              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  57+ 6D4D              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  58+ 6D4D              ; tabla los hardcodea.
  59+ 6D4D              ; ==============================================================================
  60+ 6D4D              AY_PlayPlayerHit:
  61+ 6D4D 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  62+ 6D50 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  63+ 6D52 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  64+ 6D55 18 08            JR _AY_PlaySweep
  65+ 6D57
  66+ 6D57              AY_PlayPlayerDeath:
  67+ 6D57 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  68+ 6D5A 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  69+ 6D5C 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  70+ 6D5F                  ; fall through
  71+ 6D5F
  72+ 6D5F              ; IN: HL=period inicial, B=frames, DE=delta.
  73+ 6D5F              _AY_PlaySweep:
  74+ 6D5F 22 48 6D         LD (PlayerHitPeriod), HL
  75+ 6D62 ED 53 4A 6D      LD (PlayerHitDelta), DE
  76+ 6D66 78               LD A, B
  77+ 6D67 32 47 6D         LD (PlayerHitFrames), A
  78+ 6D6A F3               DI
  79+ 6D6B 0E FD            LD C, $FD
  80+ 6D6D 21 73 6D         LD HL, .phRegs
  81+ 6D70 C3 D0 6D         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  82+ 6D73
  83+ 6D73              .phRegs:
  84+ 6D73 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  85+ 6D75 03 00            DEFB  3, $00          ; R3  = period B hi
  86+ 6D77 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  87+ 6D79                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
  88+ 6D79                                        ; aqui para no cortar las voces A/C de la musica poly2)
  89+ 6D79 FF               DEFB $FF              ; sentinel
  90+ 6D7A
  91+ 6D7A              ; ==============================================================================
  92+ 6D7A              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  93+ 6D7A              ; ==============================================================================
  94+ 6D7A              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  95+ 6D7A              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  96+ 6D7A              ; Canal B (center stereo ABC). No bloqueante.
  97+ 6D7A              ;
  98+ 6D7A              ; IN: HL = period AY canal B (mayor = mas grave).
  99+ 6D7A              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
 100+ 6D7A              ;
 101+ 6D7A              ; Sugerencias:
 102+ 6D7A              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 103+ 6D7A              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 104+ 6D7A              ; Destruye: A, BC, HL.
 105+ 6D7A              ; ==============================================================================
 106+ 6D7A              AY_PlayBeep:
 107+ 6D7A 78               LD A, B
 108+ 6D7B 32 4C 6D         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 109+ 6D7E F3               DI
 110+ 6D7F 0E FD            LD C, $FD
 111+ 6D81                  ; R2 = L (period B lo)
 112+ 6D81 3E 02            LD A, 2
 113+ 6D83 06 FF            LD B, $FF
 114+ 6D85 ED 79            OUT (C), A
 115+ 6D87 7D               LD A, L
 116+ 6D88 06 BF            LD B, $BF
 117+ 6D8A ED 79            OUT (C), A
 118+ 6D8C                  ; R3 = H (period B hi)
 119+ 6D8C 3E 03            LD A, 3
 120+ 6D8E 06 FF            LD B, $FF
 121+ 6D90 ED 79            OUT (C), A
 122+ 6D92 7C               LD A, H
 123+ 6D93 06 BF            LD B, $BF
 124+ 6D95 ED 79            OUT (C), A
 125+ 6D97                  ; R9 = $0F (vol max fija, SIN envelope). R7 mixer ya esta en $38 (set por
 126+ 6D97                  ; AY_Init) — no tocar para no apagar las voces A/C de la musica poly2.
 127+ 6D97 21 9D 6D         LD HL, .beepRegs
 128+ 6D9A C3 D0 6D         JP _AY_WriteRegPairs                ; tail call: EI + RET
 129+ 6D9D
 130+ 6D9D              .beepRegs:
 131+ 6D9D 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 132+ 6D9F                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
 133+ 6D9F                                        ; aqui para no cortar las voces A/C de la musica poly2)
 134+ 6D9F FF               DEFB $FF              ; sentinel
 135+ 6DA0
 136+ 6DA0              ; ==============================================================================
 137+ 6DA0              ; AY_PlayKnockSoft / AY_PlayKnockLoud - Knock percusivo en canal B
 138+ 6DA0              ; ==============================================================================
 139+ 6DA0              ; Dos variantes de knock que comparten cutoff mechanism (BeepDurationFrames):
 140+ 6DA0              ;
 141+ 6DA0              ; Soft (grupos de 3 toques): noise B solo (tone B off), envelope $0200 (~1.2s
 142+ 6DA0              ;   decay). Knock seco, mas discreto. R7 = $2A.
 143+ 6DA0              ;
 144+ 6DA0              ; Loud (grupo de 6 toques): noise B + tone B mix (~217 Hz), envelope $0400
 145+ 6DA0              ;   (~2.4s decay). Knock con "body" del tone, vol perceptual ~3 dB mayor.
 146+ 6DA0              ;   R7 = $28.
 147+ 6DA0              ;
 148+ 6DA0              ; Ambos:
 149+ 6DA0              ;   - R6 = $05 (noise period, chasquido seco/agudo).
 150+ 6DA0              ;   - R9 = $10 (use envelope, bit 4 set).
 151+ 6DA0              ;   - R13 = $09 (decay shape, \___, retrigger en cada call). Va ULTIMO.
 152+ 6DA0              ;   - _uphMuteR9 restaura R7 = $38 al cutoff (cleanup tras knock).
 153+ 6DA0              ;
 154+ 6DA0              ; IN: B = duracion frames cutoff (recomendado 4 = ~160ms).
 155+ 6DA0              ; Destruye: A, BC, HL.
 156+ 6DA0              ; ==============================================================================
 157+ 6DA0              AY_PlayKnockSoft:
 158+ 6DA0 21 B2 6D         LD HL, _knockSoftRegs
 159+ 6DA3 18 03            JR _ay_play_knock_seq
 160+ 6DA5
 161+ 6DA5              AY_PlayKnockLoud:
 162+ 6DA5 21 BF 6D         LD HL, _knockLoudRegs
 163+ 6DA8                  ; fall through
 164+ 6DA8
 165+ 6DA8              _ay_play_knock_seq:
 166+ 6DA8 78               LD A, B
 167+ 6DA9 32 4C 6D         LD (BeepDurationFrames), A          ; arma cutoff via ticker
 168+ 6DAC F3               DI
 169+ 6DAD 0E FD            LD C, $FD
 170+ 6DAF C3 D0 6D         JP _AY_WriteRegPairs                ; tail-call: EI + RET
 171+ 6DB2
 172+ 6DB2              _knockSoftRegs:
 173+ 6DB2 06 05            DEFB  6, $05          ; R6 noise period
 174+ 6DB4 07 2A            DEFB  7, $2A          ; R7 mixer: noise B on, tone B off
 175+ 6DB6 0B 00            DEFB 11, $00          ; R11 envelope period lo
 176+ 6DB8 0C 02            DEFB 12, $02          ; R12 envelope period hi ($0200 ~1.2s decay)
 177+ 6DBA 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 178+ 6DBC 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 179+ 6DBE FF               DEFB $FF
 180+ 6DBF
 181+ 6DBF              _knockLoudRegs:
 182+ 6DBF 02 00            DEFB  2, $00          ; R2 tone B period lo
 183+ 6DC1 03 02            DEFB  3, $02          ; R3 tone B period hi ($0200 ~217 Hz, body grave)
 184+ 6DC3 06 05            DEFB  6, $05          ; R6 noise period
 185+ 6DC5 07 28            DEFB  7, $28          ; R7 mixer: tone B + noise B both on
 186+ 6DC7 0B 00            DEFB 11, $00          ; R11 envelope period lo
 187+ 6DC9 0C 04            DEFB 12, $04          ; R12 envelope period hi ($0400 ~2.4s decay)
 188+ 6DCB 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 189+ 6DCD 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 190+ 6DCF FF               DEFB $FF
 191+ 6DD0
 192+ 6DD0              ; ==============================================================================
 193+ 6DD0              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 6DD0              ; ==============================================================================
 195+ 6DD0              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 6DD0              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 6DD0              ; ==============================================================================
 198+ 6DD0              _AY_WriteRegPairs:
 199+ 6DD0 7E               LD A, (HL)
 200+ 6DD1 FE FF            CP $FF
 201+ 6DD3 28 0D            JR Z, .awrpDone
 202+ 6DD5 06 FF            LD B, $FF
 203+ 6DD7 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 6DD9 23               INC HL
 205+ 6DDA 06 BF            LD B, $BF
 206+ 6DDC 7E               LD A, (HL)
 207+ 6DDD ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 6DDF 23               INC HL
 209+ 6DE0 18 EE            JR _AY_WriteRegPairs
 210+ 6DE2              .awrpDone:
 211+ 6DE2 FB               EI
 212+ 6DE3 C9               RET
 213+ 6DE4
 214+ 6DE4              ; ==============================================================================
 215+ 6DE4              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 6DE4              ; ==============================================================================
 217+ 6DE4              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 6DE4              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 6DE4              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 6DE4              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 6DE4              ; (con IFF=0), no hay race.
 222+ 6DE4              ;
 223+ 6DE4              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 6DE4              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 6DE4              ; Destruye: A, BC, DE, HL.
 226+ 6DE4              ; ==============================================================================
 227+ 6DE4              AY_UpdatePlayerHit:
 228+ 6DE4 3A 47 6D         LD A, (PlayerHitFrames)
 229+ 6DE7 B7               OR A
 230+ 6DE8 28 2A            JR Z, .uphCheckBeep
 231+ 6DEA 3D               DEC A
 232+ 6DEB 32 47 6D         LD (PlayerHitFrames), A
 233+ 6DEE 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 234+ 6DF0
 235+ 6DF0 2A 48 6D         LD HL, (PlayerHitPeriod)
 236+ 6DF3 ED 5B 4A 6D      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 237+ 6DF7 19               ADD HL, DE
 238+ 6DF8 22 48 6D         LD (PlayerHitPeriod), HL
 239+ 6DFB
 240+ 6DFB                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 241+ 6DFB 0E FD            LD C, $FD
 242+ 6DFD 3E 02            LD A, 2
 243+ 6DFF 06 FF            LD B, $FF
 244+ 6E01 ED 79            OUT (C), A
 245+ 6E03 7D               LD A, L
 246+ 6E04 06 BF            LD B, $BF
 247+ 6E06 ED 79            OUT (C), A
 248+ 6E08 3E 03            LD A, 3
 249+ 6E0A 06 FF            LD B, $FF
 250+ 6E0C ED 79            OUT (C), A
 251+ 6E0E 7C               LD A, H
 252+ 6E0F 06 BF            LD B, $BF
 253+ 6E11 ED 79            OUT (C), A
 254+ 6E13 C9               RET
 255+ 6E14
 256+ 6E14              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 257+ 6E14              .uphCheckBeep:
 258+ 6E14 3A 4C 6D         LD A, (BeepDurationFrames)
 259+ 6E17 B7               OR A
 260+ 6E18 C8               RET Z
 261+ 6E19 3D               DEC A
 262+ 6E1A 32 4C 6D         LD (BeepDurationFrames), A
 263+ 6E1D C0               RET NZ
 264+ 6E1E                  ; fall-through al cutoff compartido
 265+ 6E1E
 266+ 6E1E              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 267+ 6E1E              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 268+ 6E1E              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 269+ 6E1E              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 270+ 6E1E              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 271+ 6E1E              _uphMuteR9:
 272+ 6E1E 01 FD FF         LD BC, $FFFD
 273+ 6E21 3E 09            LD A, 9
 274+ 6E23 ED 79            OUT (C), A
 275+ 6E25 01 FD BF         LD BC, $BFFD
 276+ 6E28 AF               XOR A
 277+ 6E29 ED 79            OUT (C), A
 278+ 6E2B                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 279+ 6E2B 01 FD FF         LD BC, $FFFD
 280+ 6E2E 3E 07            LD A, 7
 281+ 6E30 ED 79            OUT (C), A
 282+ 6E32 01 FD BF         LD BC, $BFFD
 283+ 6E35 3E 38            LD A, $38
 284+ 6E37 ED 79            OUT (C), A
 285+ 6E39 C9               RET
