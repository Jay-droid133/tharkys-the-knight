  63+ 9117                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 9117 CD 33 91         CALL MaiFlowBfs
  65+ 911A
  66+ 911A                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 911A 3A D4 90         LD A, (CurrentPaging)
  68+ 911D E6 F8            AND $F8
  69+ 911F 32 D4 90         LD (CurrentPaging), A
  70+ 9122 01 FD 7F         LD BC, $7FFD
  71+ 9125 ED 79            OUT (C), A
  72+ 9127
  73+ 9127 ED 7B 0A 9B      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 912B 3A 3E 81         LD A, (StartupComplete)
  75+ 912E B7               OR A
  76+ 912F 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 9131 FB               EI
  78+ 9132              .mcffNoEI:
  79+ 9132 C9               RET
