 374+ 9B6D              _SaveEntityAttrImpl:
 375+ 9B6D                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B6D DD 7E 00         LD A, (IX+0)                ; width_bytes
