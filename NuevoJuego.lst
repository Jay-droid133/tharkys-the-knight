 347+ 9F0D DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9F10 81               ADD A, C
 349+ 9F11 C6 07            ADD A, 7
 350+ 9F13 0F               RRCA
 351+ 9F14 0F               RRCA
 352+ 9F15 0F               RRCA
 353+ 9F16 E6 1F            AND $1F
 354+ 9F18 32 AD 9F         LD (EntityAttrH), A
 355+ 9F1B C9               RET
