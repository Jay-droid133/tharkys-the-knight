 649+ CD7B              ; ==============================================================================
 650+ CD7B              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 651+ CD7B              ; ==============================================================================
 652+ CD7B              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 653+ CD7B              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 654+ CD7B              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 655+ CD7B              ; ==============================================================================
 656+ CD7B              DrawBgGfxSprite:
 657+ CD7B DD 7E 00         LD A, (IX+0)                ; height_px
 658+ CD7E B7               OR A
 659+ CD7F C8               RET Z                       ; sprite nulo (sin datos)
 660+ CD80 32 7E CE         LD (.heightCnt), A
 661+ CD83 DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
 662+ CD86 32 82 CE         LD (.rleFlag), A
 663+ CD89 E6 7F            AND $7F
 664+ CD8B 32 7F CE         LD (.widthVal), A
 665+ CD8E
 666+ CD8E                  ; Aplicar offset HUD: desplazar sprites BG 2 filas hacia abajo
 667+ CD8E 79               LD A, C
 668+ CD8F C6 02            ADD A, BG_Y_OFFSET
 669+ CD91 4F               LD C, A
 670+ CD92
 671+ CD92                  ; Guardar posicion para la fase de atributos
