 144+ 0000              SLOT_OBJECT0    EQU 13              ; Slots 13-16: objetos
 145+ 0000              NUM_OBJECTS     EQU 4
 146+ 0000
 147+ 0000              ; --- Velocidades de enemigos ---
 148+ 0000              ENEMY_SPEED     EQU 2               ; Pixels por update (compensar round-robin)
 149+ 0000              MONSTER_SPEED    EQU 2               ; Pixels por update (efectivo ~1 px/frame con round-robin)
 150+ 0000              MONSTER_MAX_HITS EQU 5              ; Golpes directos para matar un monster
 151+ 0000              MONSTER_KB_SPEED EQU 4              ; Pixels por update durante knockback
 152+ 0000              MONSTER_RESPAWN_DELAY EQU 75        ; 75 frames a 25fps = 3s (era 150 a 50fps)
 153+ 0000              MONSTER_STUN_TOTAL EQU 12           ; 12 frames a 25fps ~0.5s (era 24 a 50fps)
 154+ 0000              MONSTER_STUN_PAUSE EQU 6            ; 6 frames a 25fps (era 12 a 50fps)
 155+ 0000              ENEMY_ANIM_DELAY EQU 4              ; 4 frames a 25fps = 160ms (era 8 a 50fps)
 156+ 0000              ; PREDATOR_SPEED: se lee de PredatorSpeedTable segun DayCycleCount
 157+ 0000              ; Tipos de depredador (bits 0-1 de PredatorTable)
 158+ 0000              PRED_NONE       EQU 0               ; No depredador (movimiento random)
 159+ 0000              PRED_FROM_ABOVE EQU 1               ; Se lanza desde arriba (Eagle, Bat)
 160+ 0000              PRED_FROM_BELOW EQU 2               ; Se lanza desde abajo (Snake, Scorpion)
 161+ 0000              PRED_HORIZONTAL EQU 3               ; Se lanza horizontalmente (Goat, RabidCat)
 162+ 0000              PRED_ALIGN_DIST EQU 12              ; Distancia de alineacion para activar ataque
