 398+ 9297              ; ==============================================================================
 399+ 9297              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 9297              ; ==============================================================================
 401+ 9297              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 9297              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 9297              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 9297              ; al room vecino.
 405+ 9297              ;
 406+ 9297              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 9297              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 9297              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 9297              ;
 410+ 9297              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 9297              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 9297              ; ==============================================================================
 413+ 9297              WipeMonsterSlot:
 414+ 9297 DD E5            PUSH IX
 415+ 9299 E1               POP HL
 416+ 929A 11 46 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 929D B7               OR A
 418+ 929E ED 52            SBC HL, DE
 419+ 92A0 CB 3D            SRL L
 420+ 92A2 CB 3D            SRL L
 421+ 92A4 CB 3D            SRL L
 422+ 92A6 CB 3D            SRL L                               ; HL = slot * 1
 423+ 92A8 5D               LD E, L
 424+ 92A9 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 92AB
 426+ 92AB 21 DA 90         LD HL, MonsterAiFlags
 427+ 92AE 19               ADD HL, DE
 428+ 92AF 36 00            LD (HL), 0
 429+ 92B1 21 CE 90         LD HL, MonsterRoomId
 430+ 92B4 19               ADD HL, DE
 431+ 92B5 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 92B7 21 D4 90         LD HL, MonsterEntryBorder
 433+ 92BA 19               ADD HL, DE
 434+ 92BB 36 00            LD (HL), 0
 435+ 92BD 21 D7 90         LD HL, MonsterExitCoord
 436+ 92C0 19               ADD HL, DE
 437+ 92C1 36 00            LD (HL), 0
 438+ 92C3 21 E0 B6         LD HL, MonsterReturnTimer
 439+ 92C6 19               ADD HL, DE
 440+ 92C7 36 00            LD (HL), 0
 441+ 92C9 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 92CC 19               ADD HL, DE
 443+ 92CD 36 00            LD (HL), 0
 444+ 92CF 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 92D2 19               ADD HL, DE
 446+ 92D3 36 00            LD (HL), 0
 447+ 92D5 C9               RET
