 395+ E4CD              .ccnNotS:
 396+ E4CD 3D               DEC A
 397+ E4CE 20 08            JR NZ, .ccnE
 398+ E4D0                  ; W: V = R - 1, valid if R % 16 != 0
 399+ E4D0 78               LD A, B
 400+ E4D1 E6 0F            AND $0F
 401+ E4D3 28 0D            JR Z, .ccnInvalid
 402+ E4D5 78               LD A, B
 403+ E4D6 3D               DEC A
 404+ E4D7 C9               RET
 405+ E4D8              .ccnE:
 406+ E4D8                  ; E: V = R + 1, valid if R % 16 != 15
 407+ E4D8 78               LD A, B
