 120+ 9904              ; --- AY_OverrideBellPeriod: cambia el period de los 3 canales (A, B, C) ---
 121+ 9904              ; HL = nuevo period (12-bit). Para octava arriba de la campana ($0258): HL=$012C.
 122+ 9904              ; Para octava abajo: HL=$04B0. Direct port writes, no necesita paging.
 123+ 9904              ; Llamar despues de AY_PlayBellChime para modificar la frecuencia de la chime
 124+ 9904              ; en curso sin tocar la decay (que sigue gestionada por AY_UpdateBell).
 125+ 9904              AY_OverrideBellPeriod:
 126+ 9904 F3               DI
 127+ 9905                  ; R0 = period low (canal A)
 128+ 9905 5D               LD E, L
 129+ 9906 3E 00            LD A, 0
 130+ 9908 01 FD FF         LD BC, $FFFD
 131+ 990B ED 79            OUT (C), A
 132+ 990D 01 FD BF         LD BC, $BFFD
 133+ 9910 ED 59            OUT (C), E
 134+ 9912                  ; R1 = period high (canal A)
 135+ 9912 5C               LD E, H
 136+ 9913 3E 01            LD A, 1
 137+ 9915 01 FD FF         LD BC, $FFFD
 138+ 9918 ED 79            OUT (C), A
 139+ 991A 01 FD BF         LD BC, $BFFD
 140+ 991D ED 59            OUT (C), E
