 526+ DF51              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 527+ DF51              ; Usa font custom (DayHudFont) en vez de ROM font
 528+ DF51              ; ==============================================================================
 529+ DF51              DrawDayCycleHUD:
 530+ DF51                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 531+ DF51 21 0F E2         LD HL, DayHudFont + 0 * 8          ; 'D'
 532+ DF54 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 533+ DF57 CD C6 DF         CALL .drawChar
 534+ DF5A 21 17 E2         LD HL, DayHudFont + 1 * 8          ; 'A'
 535+ DF5D 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 536+ DF60 CD C6 DF         CALL .drawChar
 537+ DF63 21 1F E2         LD HL, DayHudFont + 2 * 8          ; 'Y'
 538+ DF66 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 539+ DF69 CD C6 DF         CALL .drawChar
 540+ DF6C                  ; Col 7 = espacio (limpiar)
 541+ DF6C 11 07 40         LD DE, $4007
 542+ DF6F CD CF DF         CALL .clearChar
 543+ DF72
 544+ DF72                  ; --- Digito decenas (col 8) ---
 545+ DF72 3A 06 BD         LD A, (DayCycleCount)
 546+ DF75 FE 0A            CP 10
 547+ DF77 38 20            JR C, .singleDigit
 548+ DF79                  ; Dos digitos: dividir A / 10
 549+ DF79 06 00            LD B, 0
 550+ DF7B              .divLoop:
 551+ DF7B D6 0A            SUB 10
 552+ DF7D 04               INC B
 553+ DF7E FE 0A            CP 10
 554+ DF80 30 F9            JR NC, .divLoop
 555+ DF82                  ; B = decenas, A = unidades
 556+ DF82 F5               PUSH AF                             ; Guardar unidades
 557+ DF83 78               LD A, B
 558+ DF84 CD B9 DF         CALL .getDigitFont
