 322+ EFCC              ; ==============================================================================
 323+ EFCC              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ EFCC              ; ==============================================================================
 325+ EFCC              ; IN:  A = action id (1, 2, ...)
 326+ EFCC              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ EFCC              ;      Z flag set si no encontrado.
 328+ EFCC              ; Destruye: AF, BC, HL.
 329+ EFCC              ; ==============================================================================
 330+ EFCC              ActionToTriggerPtr:
 331+ EFCC 4F               LD C, A                             ; C = action id buscada
 332+ EFCD 21 E7 D7         LD HL, BumpTriggerTable
 333+ EFD0              .attLoop:
 334+ EFD0 5E               LD E, (HL)
 335+ EFD1 23               INC HL
 336+ EFD2 56               LD D, (HL)
 337+ EFD3 23               INC HL                              ; HL -> required_key
 338+ EFD4 7A               LD A, D
 339+ EFD5 B3               OR E
 340+ EFD6 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ EFD8 23               INC HL                              ; HL -> action
 342+ EFD9 7E               LD A, (HL)
 343+ EFDA 23               INC HL                              ; HL -> next entry
 344+ EFDB B9               CP C
 345+ EFDC 20 F2            JR NZ, .attLoop
 346+ EFDE F6 01            OR 1                                ; clear Z (encontrado)
 347+ EFE0 C9               RET
 348+ EFE1              .attNotFound:
 349+ EFE1 16 00            LD D, 0
 350+ EFE3 1E 00            LD E, 0
 351+ EFE5 AF               XOR A                               ; set Z
 352+ EFE6 C9               RET
 353+ EFE7
 354+ EFE7              ; ==============================================================================
 355+ EFE7              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ EFE7              ; ==============================================================================
 357+ EFE7              ; PickupTable layout (per-entry, 7 bytes):
 358+ EFE7              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ EFE7              ; Terminator: $FF (single byte).
 360+ EFE7              ;
 361+ EFE7              ; IN:  DE = ptr a buscar
 362+ EFE7              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ EFE7              ;      B = C = $FF si no encontrado (Z).
 364+ EFE7              ; Destruye: AF, HL. Preserva DE.
 365+ EFE7              ; ==============================================================================
 366+ EFE7              FindPickupScreen:
 367+ EFE7 21 26 DF         LD HL, PickupTable
 368+ EFEA              .fpsLoop:
 369+ EFEA 7E               LD A, (HL)
 370+ EFEB FE FF            CP $FF
 371+ EFED 28 1C            JR Z, .fpsNotFound
 372+ EFEF E5               PUSH HL
 373+ EFF0 23               INC HL                              ; -> mapY
 374+ EFF1 23               INC HL                              ; -> ptr_lo
 375+ EFF2 7E               LD A, (HL)
 376+ EFF3 BB               CP E
 377+ EFF4 20 0C            JR NZ, .fpsNoMatch
 378+ EFF6 23               INC HL                              ; -> ptr_hi
 379+ EFF7 7E               LD A, (HL)
 380+ EFF8 BA               CP D
 381+ EFF9 20 07            JR NZ, .fpsNoMatch
 382+ EFFB E1               POP HL                              ; back to entry start (mapX)
 383+ EFFC 46               LD B, (HL)                          ; B = mapX
 384+ EFFD 23               INC HL
 385+ EFFE 4E               LD C, (HL)                          ; C = mapY
 386+ EFFF F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F001 C9               RET
 388+ F002              .fpsNoMatch:
 389+ F002 E1               POP HL
 390+ F003 C5               PUSH BC
 391+ F004 01 07 00         LD BC, 7
 392+ F007 09               ADD HL, BC
 393+ F008 C1               POP BC
 394+ F009 18 DF            JR .fpsLoop
 395+ F00B              .fpsNotFound:
 396+ F00B 06 FF            LD B, $FF
 397+ F00D 0E FF            LD C, $FF
 398+ F00F AF               XOR A                               ; set Z
 399+ F010 C9               RET
 400+ F011
 401+ F011              ; ==============================================================================
 402+ F011              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F011              ; ==============================================================================
 404+ F011              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F011              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F011              ; third). El brujula se redibuja solo cuando:
 407+ F011              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F011              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F011              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F011              ;
 411+ F011              ; Color (atributo de las 4 celdas):
 412+ F011              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F011              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F011              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F011              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F011              ;
 417+ F011              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F011              ; ==============================================================================
 419+ F011
 420+ F011              COMPASS_COL     EQU 24
 421+ F011              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F011
 423+ F011              ; ==============================================================================
 424+ F011              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F011              ; ==============================================================================
 426+ F011              ; Formato:
 427+ F011              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F011              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F011              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F011              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F011              ; ==============================================================================
 432+ F011              DrawMilestoneHUD:
 433+ F011 3A BA 82         LD A, (CurrentObjective)
 434+ F014 FE 0B            CP 11
 435+ F016 28 26            JR Z, .mhAllDone
 436+ F018 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F019 06 00            LD B, 0                     ; B = decenas
 438+ F01B              .mhDivLoop:
 439+ F01B FE 0A            CP 10
 440+ F01D 38 05            JR C, .mhDivDone
 441+ F01F D6 0A            SUB 10
 442+ F021 04               INC B
 443+ F022 18 F7            JR .mhDivLoop
 444+ F024              .mhDivDone:
 445+ F024 F5               PUSH AF                     ; A = unidades
 446+ F025 78               LD A, B
 447+ F026 B7               OR A
 448+ F027 20 04            JR NZ, .mhTensDigit
 449+ F029 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F02B 18 02            JR .mhWriteTens
 451+ F02D              .mhTensDigit:
 452+ F02D C6 30            ADD A, '0'
 453+ F02F              .mhWriteTens:
 454+ F02F 1E 1E            LD E, 30
 455+ F031 CD 17 E6         CALL DrawHudCharRow0
 456+ F034 F1               POP AF                      ; A = unidades
 457+ F035 C6 30            ADD A, '0'
 458+ F037 1E 1F            LD E, 31
 459+ F039 CD 17 E6         CALL DrawHudCharRow0
 460+ F03C 18 0E            JR .mhAttrs
 461+ F03E              .mhAllDone:
 462+ F03E 3E 4F            LD A, 'O'
 463+ F040 1E 1E            LD E, 30
 464+ F042 CD 17 E6         CALL DrawHudCharRow0
 465+ F045 3E 4B            LD A, 'K'
 466+ F047 1E 1F            LD E, 31
 467+ F049 CD 17 E6         CALL DrawHudCharRow0
 468+ F04C              .mhAttrs:
 469+ F04C 3E 47            LD A, $47                   ; bright white
 470+ F04E 32 1E 58         LD (ATTR_BASE + 30), A
 471+ F051 32 1F 58         LD (ATTR_BASE + 31), A
 472+ F054 C9               RET
