5671+ BDFF              ; ==============================================================================
5672+ BDFF              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5673+ BDFF              ; ==============================================================================
5674+ BDFF              TryRespawnMonsters:
5675+ BDFF                  IF DEBUG_NO_ENEMIES
5676+ BDFF ~                RET
5677+ BDFF                  ENDIF
5678+ BDFF 3A 26 E2         LD A, (CurrentTimeOfDay)
5679+ BE02 FE 03            CP 3
5680+ BE04 28 05            JR Z, .rmNight
5681+ BE06 FE 04            CP 4
5682+ BE08 28 01            JR Z, .rmNight
5683+ BE0A C9               RET
5684+ BE0B              .rmNight:
5685+ BE0B 3A 15 B3         LD A, (MonstersActive)
5686+ BE0E B7               OR A
5687+ BE0F C8               RET Z
5688+ BE10 CD E0 BE         CALL .rmUpdateReturnTimers
5689+ BE13 3A DC BE         LD A, (.rmTimer)
5690+ BE16 B7               OR A
5691+ BE17 28 05            JR Z, .rmCheckSlots
5692+ BE19 3D               DEC A
5693+ BE1A 32 DC BE         LD (.rmTimer), A
5694+ BE1D C9               RET
5695+ BE1E              .rmCheckSlots:
5696+ BE1E DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5697+ BE22 06 03            LD B, MONSTERS_TO_SPAWN
5698+ BE24 0E 00            LD C, 0
5699+ BE26              .rmLoop:
5700+ BE26 C5               PUSH BC
5701+ BE27 DD 7E 01         LD A, (IX+ENT_TYPE)
5702+ BE2A B7               OR A
5703+ BE2B C2 D0 BE         JP NZ, .rmSkip
5704+ BE2E                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5705+ BE2E                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5706+ BE2E                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5707+ BE2E DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5708+ BE31 B7               OR A
5709+ BE32 20 09            JR NZ, .rmHasTypeForTrap
5710+ BE34                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5711+ BE34 79               LD A, C
5712+ BE35 21 F9 BD         LD HL, MonsterTypeTable
5713+ BE38 5F               LD E, A
5714+ BE39 16 00            LD D, 0
5715+ BE3B 19               ADD HL, DE
5716+ BE3C 7E               LD A, (HL)
5717+ BE3D              .rmHasTypeForTrap:
5718+ BE3D D6 4C            SUB SPRID_MONSTER_0
5719+ BE3F CB 3F            SRL A
5720+ BE41 CB 3F            SRL A
5721+ BE43 CB 3F            SRL A                               ; A = type idx 0..2
5722+ BE45 21 DD BE         LD HL, .rmTrapBits
5723+ BE48 5F               LD E, A
5724+ BE49 16 00            LD D, 0
5725+ BE4B 19               ADD HL, DE
5726+ BE4C 7E               LD A, (HL)
5727+ BE4D 21 C1 82         LD HL, MonsterTrappedFlags
5728+ BE50 A6               AND (HL)
5729+ BE51 C2 D0 BE         JP NZ, .rmSkip
5730+ BE54                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5731+ BE54                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5732+ BE54                  ; que el player visite su room.
5733+ BE54 79               LD A, C
5734+ BE55 6F               LD L, A
5735+ BE56 26 00            LD H, 0
5736+ BE58 11 8A 8D         LD DE, MonsterRoomId
5737+ BE5B 19               ADD HL, DE
