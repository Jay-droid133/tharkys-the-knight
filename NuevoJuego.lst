 638+ A5A5                  ; === STATE_SCARED: pausa dramatica + huida ===
 639+ A5A5              .peScared:
 640+ A5A5 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 641+ A5A9 C2 6E A6         JP NZ, .peScaredFresh
 642+ A5AC
 643+ A5AC                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 644+ A5AC 3A AC B8         LD A, (ScareTimer)
 645+ A5AF FE 33            CP SCARE_FLEE_THRESHOLD + 1
 646+ A5B1 DA 51 A6         JP C, .peScaredFlee
 647+ A5B4                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 648+ A5B4                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 649+ A5B4 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 650+ A5B8 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 651+ A5BC                  ; Shake monster-only (nasties durante bells no se agitan)
 652+ A5BC DD 7E 01         LD A, (IX+ENT_TYPE)
 653+ A5BF FE 02            CP TYPE_MONSTER
 654+ A5C1 C2 37 A6         JP NZ, .peScaredSpriteToggle
 655+ A5C4                  ; --- Shake ---
 656+ A5C4 CD 37 93         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 657+ A5C7 5F               LD E, A
 658+ A5C8 16 00            LD D, 0
 659+ A5CA 21 68 90         LD HL, MonsterAiFlags
 660+ A5CD 19               ADD HL, DE
 661+ A5CE 7E               LD A, (HL)
 662+ A5CF CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 663+ A5D1 20 15            JR NZ, .peShakeActive
 664+ A5D3                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 665+ A5D3 F6 08            OR MAI_FLAG_SHAKE_SAVED
 666+ A5D5 77               LD (HL), A
 667+ A5D6 21 97 5F         LD HL, MonsterShakeOrigX
 668+ A5D9 19               ADD HL, DE
 669+ A5DA DD 7E 03         LD A, (IX+ENT_POSX)
 670+ A5DD 77               LD (HL), A
 671+ A5DE 21 9A 5F         LD HL, MonsterShakeOrigY
 672+ A5E1 19               ADD HL, DE
 673+ A5E2 DD 7E 04         LD A, (IX+ENT_POSY)
 674+ A5E5 77               LD (HL), A
 675+ A5E6 18 4F            JR .peScaredSpriteToggle
 676+ A5E8              .peShakeActive:
 677+ A5E8                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 678+ A5E8 ED 5F            LD A, R
 679+ A5EA E6 03            AND 3
 680+ A5EC 28 0C            JR Z, .peShakeUp
 681+ A5EE 3D               DEC A
 682+ A5EF 28 0F            JR Z, .peShakeDown
 683+ A5F1 3D               DEC A
 684+ A5F2 28 12            JR Z, .peShakeLeft
 685+ A5F4                  ; 3: right
 686+ A5F4 06 01            LD B, 1
 687+ A5F6 0E 00            LD C, 0
 688+ A5F8 18 10            JR .peShakeApply
 689+ A5FA              .peShakeUp:
 690+ A5FA 06 00            LD B, 0
 691+ A5FC 0E FF            LD C, -1
 692+ A5FE 18 0A            JR .peShakeApply
 693+ A600              .peShakeDown:
 694+ A600 06 00            LD B, 0
 695+ A602 0E 01            LD C, 1
 696+ A604 18 04            JR .peShakeApply
 697+ A606              .peShakeLeft:
 698+ A606 06 FF            LD B, -1
 699+ A608 0E 00            LD C, 0
 700+ A60A              .peShakeApply:
 701+ A60A                  ; new POSX = orig + B, new POSY = orig + C
 702+ A60A 21 97 5F         LD HL, MonsterShakeOrigX
 703+ A60D 19               ADD HL, DE
 704+ A60E 7E               LD A, (HL)
 705+ A60F 80               ADD A, B
 706+ A610 DD 77 03         LD (IX+ENT_POSX), A
 707+ A613 21 9A 5F         LD HL, MonsterShakeOrigY
 708+ A616 19               ADD HL, DE
 709+ A617 7E               LD A, (HL)
 710+ A618 81               ADD A, C
 711+ A619 DD 77 04         LD (IX+ENT_POSY), A
 712+ A61C                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 713+ A61C CD 7B B9         CALL CheckEnemyCollision
 714+ A61F 28 16            JR Z, .peScaredSpriteToggle
 715+ A621                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 716+ A621 CD 37 93         CALL MaiGetMonsterSlot
 717+ A624 5F               LD E, A
 718+ A625 16 00            LD D, 0
 719+ A627 21 97 5F         LD HL, MonsterShakeOrigX
 720+ A62A 19               ADD HL, DE
 721+ A62B 7E               LD A, (HL)
 722+ A62C DD 77 03         LD (IX+ENT_POSX), A
 723+ A62F 21 9A 5F         LD HL, MonsterShakeOrigY
 724+ A632 19               ADD HL, DE
 725+ A633 7E               LD A, (HL)
 726+ A634 DD 77 04         LD (IX+ENT_POSY), A
 727+ A637              .peScaredSpriteToggle:
 728+ A637                  ; Animacion: toggle L/R cada 8f
 729+ A637 DD 35 09         DEC (IX+ENT_ANIMTIMER)
 730+ A63A 20 12            JR NZ, .peScaredNoFlip
 731+ A63C DD 36 09 08      LD (IX+ENT_ANIMTIMER), 8
 732+ A640 DD 7E 00         LD A, (IX+ENT_SPRITEID)
