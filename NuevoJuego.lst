 561+ C3A6              ; ==============================================================================
 562+ C3A6              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 563+ C3A6              ; ==============================================================================
 564+ C3A6              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 565+ C3A6              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 566+ C3A6              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 567+ C3A6              ; ==============================================================================
 568+ C3A6              DrawBgGfxSprite:
 569+ C3A6 DD 7E 00         LD A, (IX+0)                ; height_px
