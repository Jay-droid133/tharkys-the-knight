 672+ E537 FE 0A            CP 10
 673+ E539 38 04            JR C, .dzcLoDigit
 674+ E53B C6 37            ADD A, 'A' - 10
 675+ E53D 18 02            JR .dzcLoOut
 676+ E53F              .dzcLoDigit:
