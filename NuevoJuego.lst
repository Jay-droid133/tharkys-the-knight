 396+ EA9E              .dcRedraw:
 397+ EA9E                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 398+ EA9E 3A E3 81         LD A, (ObjectiveScreenX)
 399+ EAA1 47               LD B, A
 400+ EAA2 3A 08 82         LD A, (CurrentScreenX)
 401+ EAA5 4F               LD C, A
 402+ EAA6 78               LD A, B
 403+ EAA7 91               SUB C                               ; A = dx (signed)
 404+ EAA8                  ; abs(dx) -> H, sign(dx)+1 -> L
 405+ EAA8 F2 B2 EA         JP P, .dcDxNonNeg
 406+ EAAB ED 44            NEG
 407+ EAAD 67               LD H, A                             ; abs(dx)
 408+ EAAE 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 409+ EAB0 18 0A            JR .dcDxDone
 410+ EAB2              .dcDxNonNeg:
 411+ EAB2 67               LD H, A
 412+ EAB3 B7               OR A
 413+ EAB4 20 04            JR NZ, .dcDxPositive
 414+ EAB6 2E 01            LD L, 1                             ; dx == 0
 415+ EAB8 18 02            JR .dcDxDone
 416+ EABA              .dcDxPositive:
 417+ EABA 2E 02            LD L, 2
 418+ EABC              .dcDxDone:
 419+ EABC E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 420+ EABD
 421+ EABD                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 422+ EABD 3A E4 81         LD A, (ObjectiveScreenY)
 423+ EAC0 47               LD B, A
 424+ EAC1 3A 09 82         LD A, (CurrentScreenY)
 425+ EAC4 4F               LD C, A
 426+ EAC5 78               LD A, B
 427+ EAC6 91               SUB C
 428+ EAC7 F2 D1 EA         JP P, .dcDyNonNeg
 429+ EACA ED 44            NEG
 430+ EACC 67               LD H, A
 431+ EACD 2E 00            LD L, 0
 432+ EACF 18 0A            JR .dcDyDone
 433+ EAD1              .dcDyNonNeg:
 434+ EAD1 67               LD H, A
 435+ EAD2 B7               OR A
 436+ EAD3 20 04            JR NZ, .dcDyPositive
 437+ EAD5 2E 01            LD L, 1
 438+ EAD7 18 02            JR .dcDyDone
 439+ EAD9              .dcDyPositive:
 440+ EAD9 2E 02            LD L, 2
 441+ EADB              .dcDyDone:
 442+ EADB                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 443+ EADB D1               POP DE                              ; D = abs_dx, E = signdx+1
 444+ EADC                  ; idx = (signdy+1)*3 + (signdx+1)
 445+ EADC 7D               LD A, L
 446+ EADD 87               ADD A, A
 447+ EADE 85               ADD A, L                            ; A = (signdy+1)*3
 448+ EADF 83               ADD A, E                            ; A = idx (0..8)
 449+ EAE0 32 8F EB         LD (.dcSpriteIdx), A
 450+ EAE3                  ; distance = abs_dx + abs_dy
 451+ EAE3 7A               LD A, D
 452+ EAE4 84               ADD A, H
 453+ EAE5 32 90 EB         LD (.dcDistance), A
 454+ EAE8
 455+ EAE8                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 456+ EAE8                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 457+ EAE8                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 458+ EAE8                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 459+ EAE8                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 460+ EAE8                  ; nuevo idx.
 461+ EAE8                  ; Counter == 0 -> sin override, idx = target.
 462+ EAE8                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 463+ EAE8                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 464+ EAE8                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 465+ EAE8 3A 8F EB         LD A, (.dcSpriteIdx)
 466+ EAEB FE 04            CP 4
 467+ EAED 20 06            JR NZ, .dcWobbleNotX
 468+ EAEF                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 469+ EAEF                  ; frame no redibuje innecesariamente.
 470+ EAEF AF               XOR A
 471+ EAF0 32 E8 81         LD (CompassWobbleCounter), A
 472+ EAF3 18 46            JR .dcWobbleEnd
 473+ EAF5              .dcWobbleNotX:
 474+ EAF5                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 475+ EAF5 3A 08 82         LD A, (CurrentScreenX)
 476+ EAF8 47               LD B, A
 477+ EAF9 3A E6 81         LD A, (LastCompassScreenX)
 478+ EAFC B8               CP B
 479+ EAFD 20 0A            JR NZ, .dcWobbleStart
 480+ EAFF 3A 09 82         LD A, (CurrentScreenY)
 481+ EB02 47               LD B, A
 482+ EB03 3A E7 81         LD A, (LastCompassScreenY)
 483+ EB06 B8               CP B
 484+ EB07 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 485+ EB09              .dcWobbleStart:
 486+ EB09 3E 09            LD A, 9
 487+ EB0B 32 E8 81         LD (CompassWobbleCounter), A
 488+ EB0E              .dcWobbleResolve:
 489+ EB0E 3A E8 81         LD A, (CompassWobbleCounter)
 490+ EB11 B7               OR A
 491+ EB12 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 492+ EB14 3D               DEC A
 493+ EB15 32 E8 81         LD (CompassWobbleCounter), A
 494+ EB18                                                      ; A = phase 0..8 (1 frame por fase)
 495+ EB18 21 E0 EF         LD HL, WobblePhaseTable
 496+ EB1B 5F               LD E, A
 497+ EB1C 16 00            LD D, 0
 498+ EB1E 19               ADD HL, DE
 499+ EB1F 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 500+ EB20 FE 02            CP 2
 501+ EB22 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 502+ EB24                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 503+ EB24                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 504+ EB24 FE 03            CP 3
 505+ EB26 38 01            JR C, .dcWobbleOffsetReady
 506+ EB28 3D               DEC A
 507+ EB29              .dcWobbleOffsetReady:
 508+ EB29 5F               LD E, A
 509+ EB2A 3A 8F EB         LD A, (.dcSpriteIdx)
 510+ EB2D 87               ADD A, A                            ; idx*2
 511+ EB2E 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 512+ EB2F 83               ADD A, E                            ; +offset
 513+ EB30 21 BC EF         LD HL, CompassWobbleTable
 514+ EB33 5F               LD E, A
 515+ EB34 16 00            LD D, 0
 516+ EB36 19               ADD HL, DE
 517+ EB37 7E               LD A, (HL)
 518+ EB38 32 8F EB         LD (.dcSpriteIdx), A                ; override
 519+ EB3B
 520+ EB3B              .dcWobbleEnd:
 521+ EB3B
 522+ EB3B                  ; --- Color ---
 523+ EB3B                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 524+ EB3B 3A 8F EB         LD A, (.dcSpriteIdx)
 525+ EB3E FE 04            CP 4
 526+ EB40 28 18            JR Z, .dcWhite
 527+ EB42 3A E5 81         LD A, (PreviousObjectiveDistance)
 528+ EB45 FE FF            CP $FF
 529+ EB47 28 11            JR Z, .dcWhite
 530+ EB49 47               LD B, A
 531+ EB4A 3A 90 EB         LD A, (.dcDistance)
 532+ EB4D B8               CP B
 533+ EB4E 28 0A            JR Z, .dcWhite                      ; igual = blanco
 534+ EB50 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 535+ EB52 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 536+ EB54 18 06            JR .dcColorDone
 537+ EB56              .dcGreen:
 538+ EB56 3E 44            LD A, GREEN | $40
 539+ EB58 18 02            JR .dcColorDone
 540+ EB5A              .dcWhite:
 541+ EB5A 3E 47            LD A, WHITE | $40
 542+ EB5C              .dcColorDone:
 543+ EB5C 32 91 EB         LD (.dcAttr), A
 544+ EB5F
 545+ EB5F                  ; --- Sprite ptr de CompassSprites[idx] ---
 546+ EB5F 3A 8F EB         LD A, (.dcSpriteIdx)
 547+ EB62 87               ADD A, A                            ; *2
 548+ EB63 6F               LD L, A
 549+ EB64 26 00            LD H, 0
 550+ EB66 11 AA EF         LD DE, CompassSprites
 551+ EB69 19               ADD HL, DE
 552+ EB6A 5E               LD E, (HL)
 553+ EB6B 23               INC HL
 554+ EB6C 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 555+ EB6D CD 92 EB         CALL DrawCompassSprite
 556+ EB70
 557+ EB70                  ; --- Attrs ---
 558+ EB70 3A 91 EB         LD A, (.dcAttr)
 559+ EB73 CD B5 EB         CALL SetCompassAttrs
 560+ EB76
 561+ EB76                  ; --- Cachear estado ---
 562+ EB76                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 563+ EB76                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 564+ EB76                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 565+ EB76                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 566+ EB76                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 567+ EB76                  ; el wobble y la comparacion sigue siendo correcta.
 568+ EB76 3A E8 81         LD A, (CompassWobbleCounter)
 569+ EB79 B7               OR A
 570+ EB7A 20 06            JR NZ, .dcSkipPrevDistSave
 571+ EB7C 3A 90 EB         LD A, (.dcDistance)
 572+ EB7F 32 E5 81         LD (PreviousObjectiveDistance), A
 573+ EB82              .dcSkipPrevDistSave:
 574+ EB82 3A 08 82         LD A, (CurrentScreenX)
 575+ EB85 32 E6 81         LD (LastCompassScreenX), A
 576+ EB88 3A 09 82         LD A, (CurrentScreenY)
 577+ EB8B 32 E7 81         LD (LastCompassScreenY), A
 578+ EB8E C9               RET
 579+ EB8F
 580+ EB8F 00           .dcSpriteIdx: DEFB 0
 581+ EB90 00           .dcDistance:  DEFB 0
 582+ EB91 00           .dcAttr:      DEFB 0
