4607+ BAEE 11 01 5D         LD DE, ZoneCellList
4608+ BAF1 19               ADD HL, DE
4609+ BAF2 7E               LD A, (HL)                          ; cx (ya filtrado Manhattan en BuildZoneCellList)
4610+ BAF3 87               ADD A, A
4611+ BAF4 87               ADD A, A
4612+ BAF5 87               ADD A, A                            ; cx*8
4613+ BAF6 DD 77 03         LD (IX+ENT_POSX), A
4614+ BAF9 23               INC HL
4615+ BAFA 7E               LD A, (HL)                          ; cy
