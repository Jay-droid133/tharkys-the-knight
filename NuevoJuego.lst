 485+ 8FB1              ; MaiPickRandomGap
 486+ 8FB1              ; ==============================================================================
 487+ 8FB1              ; Selecciona un opening aleatorio del screen actual (ScreenGaps en bank 6) y
 488+ 8FB1              ; traduce (side, coord) a posicion pixel con MAI_ENTRY_OFFSET aplicado.
 489+ 8FB1              ;
 490+ 8FB1              ; Output:
 491+ 8FB1              ;   A = 0 exito; (MaiSpawnX), (MaiSpawnY) contienen posicion spawn
 492+ 8FB1              ;   A = 1 no hay gaps validos; el caller debe usar fallback (LastEntryPos)
 493+ 8FB1              ; Destruye: AF, BC, DE, HL
 494+ 8FB1              ; ==============================================================================
 495+ 8FB1              MaiPickRandomGap:
 496+ 8FB1                  ; screen_id = Y * 16 + X
 497+ 8FB1 3A 02 83         LD A, (CurrentScreenY)
 498+ 8FB4 07               RLCA
 499+ 8FB5 07               RLCA
 500+ 8FB6 07               RLCA
 501+ 8FB7 07               RLCA
 502+ 8FB8 21 01 83         LD HL, CurrentScreenX
 503+ 8FBB 86               ADD A, (HL)
 504+ 8FBC 32 B3 97         LD (MaiGapScreenId), A
 505+ 8FBF
 506+ 8FBF                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 507+ 8FBF F3               DI
 508+ 8FC0
 509+ 8FC0                  ; Inline page bank 6
 510+ 8FC0 3A 7B 8D         LD A, (CurrentPaging)
 511+ 8FC3 E6 F8            AND $F8
 512+ 8FC5 F6 06            OR 6
 513+ 8FC7 32 7B 8D         LD (CurrentPaging), A
 514+ 8FCA 01 FD 7F         LD BC, $7FFD
 515+ 8FCD ED 79            OUT (C), A
 516+ 8FCF
 517+ 8FCF                  ; --- BANK 6 PAGED. NO STACK OPS. NO CALLs. ---
 518+ 8FCF 3A B3 97         LD A, (MaiGapScreenId)
 519+ 8FD2 6F               LD L, A
 520+ 8FD3 26 00            LD H, 0
 521+ 8FD5 29               ADD HL, HL                      ; *2
 522+ 8FD6 11 00 C0         LD DE, ScreenGapsTable
 523+ 8FD9 19               ADD HL, DE                      ; HL = &ScreenGapsTable[sid]
