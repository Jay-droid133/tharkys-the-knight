 161+ 9249 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ 924D DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ 9251 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ 9255 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
