 761+ E774              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 762+ E774              ; A = codigo ASCII, E = columna (0-31)
 763+ E774              DrawHudChar:
 764+ E774                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 765+ E774 6F               LD L, A
 766+ E775 26 00            LD H, 0
 767+ E777 29               ADD HL, HL
 768+ E778 29               ADD HL, HL
 769+ E779 29               ADD HL, HL
 770+ E77A 01 00 3C         LD BC, $3C00
 771+ E77D 09               ADD HL, BC                  ; HL = font data
 772+ E77E
 773+ E77E                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E77E 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E780 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E782 83               ADD A, E
 777+ E783 5F               LD E, A                     ; DE = dir VRAM
 778+ E784
 779+ E784 06 08            LD B, 8
