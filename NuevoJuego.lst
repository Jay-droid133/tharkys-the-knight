4621+ BC59                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4622+ BC59                  ; identicas y las nasties van en paralelo solapadas.
4623+ BC59 DD 7E 06         LD A, (IX+ENT_DELTAX)
4624+ BC5C E6 80            AND $80                             ; bit 7 = signo X
4625+ BC5E 47               LD B, A
4626+ BC5F DD 7E 07         LD A, (IX+ENT_DELTAY)
4627+ BC62 E6 80            AND $80                             ; bit 7 = signo Y
4628+ BC64 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4629+ BC65 B0               OR B                                ; A = signX(7) | signY(6)
4630+ BC66 47               LD B, A
4631+ BC67 3A 0D 82         LD A, (LastSpawnDirSigns)
4632+ BC6A B8               CP B
4633+ BC6B 20 0C            JR NZ, .spawnDirOk
4634+ BC6D                  ; Coincide -> voltear DELTAY (negar)
4635+ BC6D DD 7E 07         LD A, (IX+ENT_DELTAY)
4636+ BC70 ED 44            NEG
4637+ BC72 DD 77 07         LD (IX+ENT_DELTAY), A
4638+ BC75 78               LD A, B
4639+ BC76 EE 40            XOR $40                             ; recalcular signs cacheados
4640+ BC78 47               LD B, A
4641+ BC79              .spawnDirOk:
4642+ BC79 78               LD A, B
4643+ BC7A 32 0D 82         LD (LastSpawnDirSigns), A
4644+ BC7D
4645+ BC7D                  ; Inicializar old pos = pos actual
4646+ BC7D DD 7E 03         LD A, (IX+ENT_POSX)
4647+ BC80 DD 77 0C         LD (IX+ENT_OLDX), A
4648+ BC83 DD 77 0F         LD (IX+ENT_DRAWX), A
4649+ BC86 DD 7E 04         LD A, (IX+ENT_POSY)
4650+ BC89 DD 77 0D         LD (IX+ENT_OLDY), A
4651+ BC8C DD 7E 00         LD A, (IX+ENT_SPRITEID)
4652+ BC8F DD 77 0E         LD (IX+ENT_OLDSPRID), A
4653+ BC92                  ; SFX de spawn
4654+ BC92 21 C8 F1         LD HL, SFX_EnemySpawn
4655+ BC95 CD 1E F1         CALL PlaySFX
4656+ BC98 C9               RET
4657+ BC99
4658+ BC99              ; ==============================================================================
4659+ BC99              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4660+ BC99              ; ==============================================================================
4661+ BC99              UpdateEnemySpeed:
4662+ BC99 3A 7D BD         LD A, (DayCycleCount)
4663+ BC9C 3D               DEC A                               ; 0-based index
4664+ BC9D FE 0A            CP 10
4665+ BC9F 38 02            JR C, .uesOk
4666+ BCA1 3E 09            LD A, 9                             ; Cap en indice 9
4667+ BCA3              .uesOk:
4668+ BCA3 F5               PUSH AF                             ; Guardar indice para tabla de anim
4669+ BCA4 21 C7 BC         LD HL, EnemySpeedTable
4670+ BCA7 5F               LD E, A
4671+ BCA8 16 00            LD D, 0
4672+ BCAA 19               ADD HL, DE
4673+ BCAB 7E               LD A, (HL)                          ; A = velocidad × 2
4674+ BCAC                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4675+ BCAC CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4676+ BCAE 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4677+ BCB0                  ; Hay fraccion .5: alternar +1 en frames impares
4678+ BCB0 47               LD B, A                             ; B = parte entera
4679+ BCB1 3A D9 80         LD A, (GameFrameCounter)
4680+ BCB4 E6 01            AND 1                               ; 0 en par, 1 en impar
4681+ BCB6 80               ADD A, B                            ; Sumar 0 o 1
4682+ BCB7              .uesNoFrac:
4683+ BCB7 32 2A 90         LD (CurrentEnemySpeed), A
4684+ BCBA                  ; Leer delay de animacion para este ciclo
4685+ BCBA F1               POP AF                              ; A = indice 0-based
4686+ BCBB 21 D1 BC         LD HL, EnemyAnimDelayTable
4687+ BCBE 5F               LD E, A
4688+ BCBF 16 00            LD D, 0
4689+ BCC1 19               ADD HL, DE
4690+ BCC2 7E               LD A, (HL)
4691+ BCC3 32 2B 90         LD (CurrentEnemyAnimDelay), A
4692+ BCC6 C9               RET
4693+ BCC7
4694+ BCC7              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4695+ BCC7              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4696+ BCC7              EnemySpeedTable:
4697+ BCC7 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4698+ BCC8 05               DEFB 5                              ; Ciclo 2: 2.5px
4699+ BCC9 06               DEFB 6                              ; Ciclo 3: 3px
4700+ BCCA 07               DEFB 7                              ; Ciclo 4: 3.5px
4701+ BCCB 08               DEFB 8                              ; Ciclo 5: 4px
4702+ BCCC 09               DEFB 9                              ; Ciclo 6: 4.5px
4703+ BCCD 0A               DEFB 10                             ; Ciclo 7: 5px
4704+ BCCE 0B               DEFB 11                             ; Ciclo 8: 5.5px
4705+ BCCF 0C               DEFB 12                             ; Ciclo 9: 6px
4706+ BCD0 0E               DEFB 14                             ; Ciclo 10: 7px
4707+ BCD1
4708+ BCD1              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4709+ BCD1              ; La rata usara la mitad de estos valores
4710+ BCD1              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4711+ BCD1 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4712+ BCD2 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4713+ BCD3 03               DEFB 3                              ; Ciclo 3 (era 6)
4714+ BCD4 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4715+ BCD5 02               DEFB 2                              ; Ciclo 5 (era 4)
4716+ BCD6 02               DEFB 2                              ; Ciclo 6 (era 4)
4717+ BCD7 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4718+ BCD8 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4719+ BCD9 01               DEFB 1                              ; Ciclo 9 (era 2)
4720+ BCDA 01               DEFB 1                              ; Ciclo 10 (era 2)
4721+ BCDB
4722+ BCDB              ; ==============================================================================
4723+ BCDB              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4724+ BCDB              ; ==============================================================================
4725+ BCDB              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4726+ BCDB              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4727+ BCDB              ; ==============================================================================
4728+ BCDB              KillAllActiveNasties:
4729+ BCDB DD 21 4C 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4730+ BCDF 06 04            LD B, NUM_NASTIES
4731+ BCE1              .kanLoop:
4732+ BCE1 C5               PUSH BC
4733+ BCE2 DD 7E 01         LD A, (IX+ENT_TYPE)
4734+ BCE5 B7               OR A
4735+ BCE6 28 2B            JR Z, .kanSkip                  ; slot vacio
4736+ BCE8 FE 03            CP TYPE_NASTY
4737+ BCEA 20 27            JR NZ, .kanSkip                 ; no es nasty
4738+ BCEC DD 7E 02         LD A, (IX+ENT_STATE)
4739+ BCEF FE 03            CP STATE_DYING
4740+ BCF1 28 20            JR Z, .kanSkip
4741+ BCF3 FE 04            CP STATE_SPAWNING
4742+ BCF5 28 1C            JR Z, .kanSkip
4743+ BCF7                  ; Transicionar a STATE_DYING con puff
4744+ BCF7 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4745+ BCFB DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4746+ BCFF DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4747+ BD03 DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4748+ BD07 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4749+ BD0B DD 36 07 00      LD (IX+ENT_DELTAY), 0
4750+ BD0F DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
4751+ BD13              .kanSkip:
4752+ BD13 11 10 00         LD DE, ENT_SIZE
4753+ BD16 DD 19            ADD IX, DE
4754+ BD18 C1               POP BC
4755+ BD19 10 C6            DJNZ .kanLoop
4756+ BD1B C9               RET
