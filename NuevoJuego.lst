 650+ E7EF              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 651+ E7EF              ; ==============================================================================
 652+ E7EF              DrawZoneCountHUD:
 653+ E7EF 3A 00 5D         LD A, (ZoneCellCount)
 654+ E7F2                  ; Hi nibble
 655+ E7F2 47               LD B, A
 656+ E7F3 CB 3F            SRL A
 657+ E7F5 CB 3F            SRL A
 658+ E7F7 CB 3F            SRL A
 659+ E7F9 CB 3F            SRL A
 660+ E7FB FE 0A            CP 10
 661+ E7FD 38 04            JR C, .dzcHiDigit
 662+ E7FF C6 37            ADD A, 'A' - 10
 663+ E801 18 02            JR .dzcHiOut
 664+ E803              .dzcHiDigit:
 665+ E803 C6 30            ADD A, '0'
 666+ E805              .dzcHiOut:
 667+ E805 1E 0B            LD E, 11
 668+ E807 CD 3F E8         CALL DrawHudCharRow0
 669+ E80A                  ; Lo nibble
 670+ E80A 78               LD A, B
 671+ E80B E6 0F            AND $0F
 672+ E80D FE 0A            CP 10
 673+ E80F 38 04            JR C, .dzcLoDigit
 674+ E811 C6 37            ADD A, 'A' - 10
 675+ E813 18 02            JR .dzcLoOut
 676+ E815              .dzcLoDigit:
 677+ E815 C6 30            ADD A, '0'
 678+ E817              .dzcLoOut:
 679+ E817 1E 0C            LD E, 12
 680+ E819 CD 3F E8         CALL DrawHudCharRow0
 681+ E81C 3E 47            LD A, $47
 682+ E81E 32 0B 58         LD (ATTR_BASE + 11), A
 683+ E821 32 0C 58         LD (ATTR_BASE + 12), A
 684+ E824 C9               RET
