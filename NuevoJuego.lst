  64+ 6DFA              ; ROULETTE — datos
  65+ 6DFA              ; ==============================================================================
  66+ 6DFA              ; RouletteOrder: secuencia de type ids que recorre el ciclado. Tunable por
  67+ 6DFA              ; el usuario — añadir/quitar/reordenar entries y rebuild. La longitud se
  68+ 6DFA              ; calcula sola via ROULETTE_ORDER_LEN.
  69+ 6DFA              RouletteOrder:
  70+ 6DFA 01               DEFB ROUL_LIFE
  71+ 6DFB 06               DEFB ROUL_MUSHROOM
  72+ 6DFC 02               DEFB ROUL_HEALTH
  73+ 6DFD 05               DEFB ROUL_CARACOL
  74+ 6DFE 07               DEFB ROUL_COMPASS
  75+ 6DFF 06               DEFB ROUL_MUSHROOM
  76+ 6E00 03               DEFB ROUL_STAMINA
  77+ 6E01 04               DEFB ROUL_RAYO
  78+ 6E02 05               DEFB ROUL_CARACOL
  79+ 6E03              RouletteOrderEnd:
  80+ 6E03              ROULETTE_ORDER_LEN  EQU RouletteOrderEnd - RouletteOrder
  81+ 6E03
  82+ 6E03              ; RouletteTypePtrs: tabla de lookup type id → BgGfx ptr. Indexada por
  83+ 6E03              ; (type-1)*2 — el id 0 esta sin usar (no aparece en RouletteOrder).
  84+ 6E03              RouletteTypePtrs:
  85+ 6E03 6C CC            DEFW BgGfx_life                                     ; ROUL_LIFE     = 1
  86+ 6E05 E0 ED            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH   = 2
  87+ 6E07 09 EE            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA  = 3
  88+ 6E09 32 EE            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO     = 4
  89+ 6E0B 5B EE            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL  = 5
  90+ 6E0D 84 EE            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM = 6
  91+ 6E0F AD EE            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS  = 7
  92+ 6E11
  93+ 6E11              ; ==============================================================================
  94+ 6E11              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ 6E11              ; ==============================================================================
  96+ 6E11              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  97+ 6E11              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  98+ 6E11              ; ==============================================================================
  99+ 6E11              GetRoulettePtrByIdx:
 100+ 6E11 21 FA 6D         LD HL, RouletteOrder
 101+ 6E14 5F               LD E, A
 102+ 6E15 16 00            LD D, 0
 103+ 6E17 19               ADD HL, DE
 104+ 6E18 7E               LD A, (HL)                              ; A = type id (1..5)
 105+ 6E19 3D               DEC A                                   ; idx 0-based para tabla ptrs
 106+ 6E1A 26 00            LD H, 0
 107+ 6E1C 6F               LD L, A
 108+ 6E1D 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 109+ 6E1E 11 03 6E         LD DE, RouletteTypePtrs
 110+ 6E21 19               ADD HL, DE
 111+ 6E22 5E               LD E, (HL)
 112+ 6E23 23               INC HL
 113+ 6E24 56               LD D, (HL)
 114+ 6E25 EB               EX DE, HL                               ; HL = ptr
 115+ 6E26 C9               RET
