1209+ F031              ; ==============================================================================
1210+ F031              ; Variantes random de health/stamina pickup
1211+ F031              ; ==============================================================================
1212+ F031              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
1213+ F031              ; eligen una variante visual al azar. Asi el random pickup tiene mas
1214+ F031              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
1215+ F031              ; variante — solo cambia el sprite que se ve.
1216+ F031              ;
1217+ F031              ; Formato tabla: DEFB count, ids... (1 byte por id)
1218+ F031              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
1219+ F031              ; ==============================================================================
1220+ F031              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
1221+ F031              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
1222+ F031              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
1223+ F031              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
1224+ F031              ; raw, asi que usamos esos labels directamente.
1225+ F031              HealthVariantPtrs:
1226+ F031 05               DEFB 5                              ; 5 variantes (1 byte count)
1227+ F032 EC F1            DEFW BgGfx_health_pickup            ; canonical (id 254, pan)
1228+ F034 15 F2            DEFW BgGfx_health_pickup_72         ; variant id 72 (queso)
1229+ F036 3E F2            DEFW BgGfx_health_pickup_3          ; variant id 74 (chorizo)
1230+ F038 67 F2            DEFW BgGfx_health_pickup_4          ; variant id 75 (leche)
1231+ F03A 90 F2            DEFW BgGfx_health_pickup_5          ; variant id 85 (pollo)
1232+ F03C
1233+ F03C              StaminaVariantPtrs:
1234+ F03C 04               DEFB 4                              ; 4 variantes
1235+ F03D 91 E7            DEFW BgGfx_stamina_pickup           ; canonical (id 255, jarra de vino)
1236+ F03F B9 F2            DEFW BgGfx_stamina_pickup_2         ; variant id 73 (taza de cafe)
1237+ F041 E2 F2            DEFW BgGfx_stamina_pickup_3         ; variant id 79 (pocion)
1238+ F043 0B F3            DEFW BgGfx_stamina_pickup_4         ; variant id 84 (copa de brandy)
1239+ F045
1240+ F045              ; ==============================================================================
1241+ F045              ; PickRandomVariantPtr / LookupVariantPtrByIdx
1242+ F045              ; ==============================================================================
1243+ F045              ; PickRandomVariantPtr: elige variante random Y la persiste en RP_TmpVariant.
1244+ F045              ;   IN:  HL = ptr a tabla "DEFB count, DEFW ptr1, DEFW ptr2, ..."
1245+ F045              ;   OUT: HL = sprite ptr de la variante elegida.
1246+ F045              ;   Side: RP_TmpVariant ← idx elegido (0..count-1), para que la cache pueda
1247+ F045              ;         rotarlo y reusarlo al revisitar la sala.
1248+ F045              ;
1249+ F045              ; LookupVariantPtrByIdx: lookup directo SIN random (para cache hit que ya tiene
1250+ F045              ;                       el idx que quiere reusar).
1251+ F045              ;   IN:  HL = ptr a tabla, A = idx (0..count-1)
1252+ F045              ;   OUT: HL = sprite ptr de la variante[idx].
1253+ F045              ;   Side: ninguno (NO toca RP_TmpVariant — el caller lo gestiona).
1254+ F045              ;
1255+ F045              ; Destruye: AF, BC, DE (ambas rutinas).
1256+ F045              ; ==============================================================================
1257+ F045              PickRandomVariantPtr:
1258+ F045 7E               LD A, (HL)                          ; A = count
1259+ F046 47               LD B, A
1260+ F047 ED 5F            LD A, R
1261+ F049              .pvpModLoop:
1262+ F049 90               SUB B
1263+ F04A 30 FD            JR NC, .pvpModLoop
1264+ F04C 80               ADD A, B                            ; A = R mod count (0..count-1)
1265+ F04D 32 D8 5F         LD (RP_TmpVariant), A               ; persistir para cache rotation
1266+ F050                  ; fall through a LookupVariantPtrByIdx (HL aun apunta al count byte, A = idx)
1267+ F050              LookupVariantPtrByIdx:
1268+ F050 23               INC HL                              ; HL @ first DEFW
1269+ F051 87               ADD A, A                            ; idx*2 (DEFW = 2 B)
1270+ F052 5F               LD E, A
1271+ F053 16 00            LD D, 0
1272+ F055 19               ADD HL, DE                          ; HL @ entry elegida
1273+ F056 7E               LD A, (HL)
1274+ F057 23               INC HL
1275+ F058 66               LD H, (HL)
1276+ F059 6F               LD L, A                             ; HL = sprite ptr
1277+ F05A C9               RET
1278+ F05B
