 178  7FB8
 179  7FB8                  ; ==========================================================================
 180  7FB8                  ; ORG $8000 - codigo principal (no-contended)
 181  7FB8                  ; ==========================================================================
 182  7FB8                  ORG ORIGIN_ADDRESS
 183  8000
 184  8000              ; ==============================================================================
 185  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 186  8000              ; ==============================================================================
 187  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 188  8000              ;   erase viejo → AI/movimiento → draw nuevo
 189  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 190  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 191  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 192  8000              ; ==============================================================================
 193  8000              MainLoop:
 194  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 195  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 196  8003 47               LD B, A                     ; B = tick actual
 197  8004
 198  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 199  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 200  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 201  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 202  8004 78               LD A, B
 203  8005 21 97 81         LD HL, .frameStart
 204  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 205  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 206  800A 21 E2 99         LD HL, TickRemainder
 207  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 208  800E 4F               LD C, A
 209  800F E6 01            AND $01
 210  8011 77               LD (HL), A                  ; new remainder = total mod 2
 211  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 212  8014 79               LD A, C
 213  8015 32 E1 99         LD (FramesElapsed), A
 214  8018
 215  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 216  8018 CD 31 CB         CALL UpdateDeathBorder
 217  801B CD 02 CB         CALL UpdateDeathAnim
 218  801E                  ; Music tick: ahora vive en MusicIrqHandler (slot 1, cada 2 IRQs = 25 Hz).
 219  801E                  ; Auditoria de concurrencia AY confirmada: todos los AY writes desde
 220  801E                  ; MainLoop estan envueltos en DI/EI (ay_sound_thunks + sfx_player_hit_ay).
 221  801E                  ; UpdateMusicImpl sigue vivo como catchup-fallback no llamado por defecto.
 222  801E
 223  801E                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 224  801E 3A DF 82         LD A, (GameOver)
 225  8021 B7               OR A
 226  8022 28 23            JR Z, .notGameOver
 227  8024 FE 02            CP 2
 228  8026 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 229  8028                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 230  8028 CD 8C CB         CALL PaintGameOverScreen
 231  802B 3E 02            LD A, 2
 232  802D 32 DF 82         LD (GameOver), A
 233  8030 C3 87 81         JP .frameSync
 234  8033              .gameOverWaitInput:
 235  8033 CD C8 CB         CALL UpdateGameOverAnim     ; Death moonwalkea por la pantalla negra
 236  8036 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 237  8039 ED 78            IN A, (C)
 238  803B CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 239  803D C2 87 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 240  8040                  ; SPACE pulsado: reset total -> JP Inicio
 241  8040 F3               DI
 242  8041 31 58 FF         LD SP, SP_ADDRESS
 243  8044 C3 00 60         JP Inicio
 244  8047              .notGameOver:
 245  8047
 246  8047                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
 247  8047 CD 8F CC         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
 248  804A CD E6 6F         CALL UpdateRandomPickup     ; Random pickup roll (early-out si !ScreenDirty)
 249  804D                  ; Lasting compass gating (en bank 2 — 0 B en slot 1, evita overflow de
 250  804D                  ; RoomCompGapsTable). Cubre dos casos:
 251  804D                  ;   1. Roll directo a COMPASS → synth ptr = BgGfx_pickup_compass.
 252  804D                  ;   2. Roll a ROULETTE (que ciclaria a COMPASS eventualmente) → desactivar
 253  804D                  ;      la ruleta entera. Concesion: si Permanent=1, nunca aparece roulette.
 254  804D                  ; En ambos casos: mark synth $FE para que DrawScreen no lo dibuje.
 255  804D 3A C5 82         LD A, (MagicCompassPermanent)
 256  8050 B7               OR A
 257  8051 28 1A            JR Z, .lcSkipRPGate
 258  8053 2A B6 5F         LD HL, (RandomSynthPtr)
 259  8056 11 23 F1         LD DE, BgGfx_pickup_compass
 260  8059 B7               OR A
 261  805A ED 52            SBC HL, DE
 262  805C 28 0A            JR Z, .lcInvalidate
 263  805E 3A BC 5F         LD A, (RouletteActive)
 264  8061 B7               OR A
 265  8062 28 09            JR Z, .lcSkipRPGate
 266  8064 AF               XOR A
 267  8065 32 BC 5F         LD (RouletteActive), A
 268  8068              .lcInvalidate:
 269  8068 3E FE            LD A, $FE
 270  806A 32 B4 5F         LD (RandomSynthMapX), A
 271  806D              .lcSkipRPGate:
 272  806D CD AA CE         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
 273  8070 CD 2A D2         CALL RemapScreenAttrs       ; Remap attrs si cambio de fase (~fast)
 274  8073
 275  8073                  ; === CUTSCENE final (M11, puerta sur): si activa, saltar gameplay ===
 276  8073                  ; Excepcion: TGP_WAIT_NASTIES (16) deja correr ProcessEnemies para que los
 277  8073                  ; puffs de nasties recien matados se animen antes del LOCK pause.
 278  8073 3A C8 82         LD A, (TownGatePhase)
 279  8076 B7               OR A
 280  8077 28 08            JR Z, .townGateNotActive
 281  8079 FE 10            CP 16                       ; TGP_WAIT_NASTIES
 282  807B CA 0A 81         JP Z, .townGateWaitNasties
 283  807E C3 05 81         JP .townGateCutsceneActive
 284  8081              .townGateNotActive:
 285  8081
 286  8081                  ; === CUTSCENE banco (M9 nuevo): si activa, saltar gameplay ===
 287  8081                  ; Excepcion: BCP_WAIT_NASTIES (17) deja correr ProcessEnemies + ProcessDeath
 288  8081                  ; para que los puffs de nasties recien matados se animen antes del LOCK.
 289  8081 3A C9 82         LD A, (BankCutscenePhase)
 290  8084 B7               OR A
