 881+ F2EE
 882+ F2EE              ; ==============================================================================
 883+ F2EE              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 884+ F2EE              ; ==============================================================================
 885+ F2EE              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 886+ F2EE              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 887+ F2EE              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 888+ F2EE              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 889+ F2EE              ; monstruo cae alli con la puerta abierta:
 890+ F2EE              ;   - Bit slot en MonsterTrappedFlags
 891+ F2EE              ;   - Despawn del monstruo (puff)
 892+ F2EE              ;   - Puerta se re-cierra (sprite + flag)
 893+ F2EE              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 894+ F2EE              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 895+ F2EE              ;
 896+ F2EE              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 897+ F2EE              ; auto-generadas por el level editor segun la posicion de la puerta y los
 898+ F2EE              ; markers AltKey1/AltKey2.
 899+ F2EE              ; ==============================================================================
 900+ F2EE
 901+ F2EE              ; ==============================================================================
 902+ F2EE              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 903+ F2EE              ; ==============================================================================
 904+ F2EE              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 905+ F2EE              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 906+ F2EE              ; Destruye: AF, BC.
 907+ F2EE              ; ==============================================================================
 908+ F2EE              CheckChurchTrap:
 909+ F2EE                  ; --- Solo en pantalla de la iglesia ---
 910+ F2EE 3A 0A 83         LD A, (CurrentScreenX)
 911+ F2F1 FE 0F            CP CHURCH_TRAP_SCREEN_X
 912+ F2F3 20 5D            JR NZ, .cctNoTrap
 913+ F2F5 3A 0B 83         LD A, (CurrentScreenY)
 914+ F2F8 FE 06            CP CHURCH_TRAP_SCREEN_Y
 915+ F2FA 20 56            JR NZ, .cctNoTrap
 916+ F2FC                  ; --- Solo con la puerta abierta ---
 917+ F2FC 3A B3 82         LD A, (ChurchDoorOpen)
 918+ F2FF B7               OR A
 919+ F300 28 50            JR Z, .cctNoTrap
 920+ F302                  ; --- Solo si el knockback es DIRECTO del player ---
 921+ F302                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 922+ F302                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 923+ F302                  ; espada y se clear cuando se hereda kb por colision.
 924+ F302 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 925+ F306 28 4A            JR Z, .cctNoTrap
 926+ F308                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 927+ F308                  ; (acepta sprites de 16, 21 o 24 px de alto)
 928+ F308 DD 7E 04         LD A, (IX+ENT_POSY)
 929+ F30B CB 3F            SRL A
 930+ F30D CB 3F            SRL A
 931+ F30F CB 3F            SRL A                                   ; A = top charY del monster
 932+ F311 47               LD B, A
 933+ F312 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 934+ F314 90               SUB B                                   ; A = trap_charY - mon_charY
 935+ F315 FE 03            CP 3
 936+ F317 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 937+ F319                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 938+ F319 DD 7E 03         LD A, (IX+ENT_POSX)
 939+ F31C CB 3F            SRL A
 940+ F31E CB 3F            SRL A
 941+ F320 CB 3F            SRL A
 942+ F322 47               LD B, A                                 ; B = left charX del monster
 943+ F323 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 944+ F325 3C               INC A                                   ; A = LO_X + 1
 945+ F326 90               SUB B                                   ; A = LO_X+1 - charX
 946+ F327 FE 03            CP 3
 947+ F329 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 948+ F32B                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 949+ F32B                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 950+ F32B DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 951+ F32E D6 4C            SUB SPRID_MONSTER_0
 952+ F330 CB 3F            SRL A
 953+ F332 CB 3F            SRL A
 954+ F334 CB 3F            SRL A                                   ; A = type idx 0..2
 955+ F336 47               LD B, A
 956+ F337                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 957+ F337 3A C1 82         LD A, (NextChurchTrapStep)
 958+ F33A FE 03            CP 3
 959+ F33C 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 960+ F33E 21 54 F3         LD HL, ChurchTrapOrderTable
 961+ F341 5F               LD E, A
 962+ F342 16 00            LD D, 0
 963+ F344 19               ADD HL, DE
 964+ F345 7E               LD A, (HL)                              ; A = type esperado
 965+ F346 B8               CP B
 966+ F347 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 967+ F349                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 968+ F349 CD EC F3         CALL TriggerChurchTrap
 969+ F34C 3E 01            LD A, 1
 970+ F34E C9               RET
 971+ F34F              .cctBlockAsWall:
 972+ F34F                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 973+ F34F                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 974+ F34F 3E 02            LD A, 2
 975+ F351 C9               RET
 976+ F352              .cctNoTrap:
 977+ F352 AF               XOR A
 978+ F353 C9               RET
 979+ F354
 980+ F354              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 981+ F354              ChurchTrapOrderTable:
 982+ F354 00 02 01         DEFB 0, 2, 1
 983+ F357
 984+ F357              ; ==============================================================================
 985+ F357              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 986+ F357              ; blanco brillante sobre paper negro ($47).
 987+ F357              ; ==============================================================================
 988+ F357              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 989+ F357              ; - No-op fuera de la sala de la iglesia.
 990+ F357              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 991+ F357              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 992+ F357              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 993+ F357              ;   aun no toca) conservan sus attrs originales del sprite.
 994+ F357              ; Destruye: AF, BC, DE, HL.
 995+ F357              ; ==============================================================================
 996+ F357              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 997+ F357              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 998+ F357              HighlightExpectedStatue:
 999+ F357 3E 47            LD A, $47
1000+ F359 18 00            JR PaintExpectedStatueAttr
1001+ F35B
1002+ F35B              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
1003+ F35B              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
1004+ F35B              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
1005+ F35B              PaintExpectedStatueAttr:
1006+ F35B 32 C5 F3         LD (.hesAttr), A
1007+ F35E                  ; --- Solo en la sala de la iglesia ---
1008+ F35E 3A 0A 83         LD A, (CurrentScreenX)
1009+ F361 FE 0F            CP CHURCH_TRAP_SCREEN_X
1010+ F363 C0               RET NZ
1011+ F364 3A 0B 83         LD A, (CurrentScreenY)
1012+ F367 FE 06            CP CHURCH_TRAP_SCREEN_Y
1013+ F369 C0               RET NZ
1014+ F36A                  ; --- Solo tras abrir la iglesia 1a vez ---
1015+ F36A                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
1016+ F36A                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
1017+ F36A                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
1018+ F36A                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
1019+ F36A                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
1020+ F36A 3A B4 82         LD A, (ChurchEverOpened)
1021+ F36D B7               OR A
1022+ F36E C8               RET Z
1023+ F36F                  ; --- Solo si quedan monstruos por atrapar ---
1024+ F36F 3A C1 82         LD A, (NextChurchTrapStep)
1025+ F372 FE 03            CP 3
1026+ F374 D0               RET NC
1027+ F375                  ; --- Type esperado -> statue id ---
1028+ F375 21 54 F3         LD HL, ChurchTrapOrderTable
1029+ F378 5F               LD E, A
1030+ F379 16 00            LD D, 0
1031+ F37B 19               ADD HL, DE
1032+ F37C 7E               LD A, (HL)                              ; type idx esperado
1033+ F37D 21 B1 64         LD HL, StatueIdTable
1034+ F380 5F               LD E, A
1035+ F381 16 00            LD D, 0
1036+ F383 19               ADD HL, DE
1037+ F384 7E               LD A, (HL)                              ; A = statue id
1038+ F385 B7               OR A
1039+ F386 C8               RET Z
1040+ F387 32 C6 F3         LD (.hesTargetId), A
1041+ F38A                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
1042+ F38A 2A 0C 83         LD HL, (CurrentScreenAddr)
1043+ F38D              .hesLoop:
1044+ F38D 7E               LD A, (HL)
1045+ F38E FE FF            CP $FF
1046+ F390 C8               RET Z                                   ; estatua no en esta sala
1047+ F391 47               LD B, A
1048+ F392 3A C6 F3         LD A, (.hesTargetId)
1049+ F395 B8               CP B
1050+ F396 28 06            JR Z, .hesFound
1051+ F398 11 04 00         LD DE, 4
1052+ F39B 19               ADD HL, DE
1053+ F39C 18 EF            JR .hesLoop
1054+ F39E              .hesFound:
1055+ F39E 23               INC HL
1056+ F39F 7E               LD A, (HL)                              ; charX
1057+ F3A0 47               LD B, A
1058+ F3A1 23               INC HL
1059+ F3A2 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
1060+ F3A3 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
1061+ F3A5 4F               LD C, A                                 ; C = charY (post-HUD)
1062+ F3A6                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
1063+ F3A6 26 00            LD H, 0
1064+ F3A8 69               LD L, C
1065+ F3A9 29               ADD HL, HL
1066+ F3AA 29               ADD HL, HL
1067+ F3AB 29               ADD HL, HL
1068+ F3AC 29               ADD HL, HL
1069+ F3AD 29               ADD HL, HL                              ; HL = charY * 32
1070+ F3AE 58               LD E, B
1071+ F3AF 16 00            LD D, 0
1072+ F3B1 19               ADD HL, DE                              ; + charX
1073+ F3B2 11 00 58         LD DE, $5800
1074+ F3B5 19               ADD HL, DE                              ; HL = attr addr top-left
1075+ F3B6                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
1076+ F3B6                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
1077+ F3B6                  ; no hace falta sincronizar CleanAttrMap.
1078+ F3B6 3A C5 F3         LD A, (.hesAttr)
1079+ F3B9 06 03            LD B, 3                                 ; 3 filas de chars
1080+ F3BB              .hesRow:
1081+ F3BB 77               LD (HL), A
1082+ F3BC 23               INC HL
1083+ F3BD 77               LD (HL), A                              ; (charX+1)
1084+ F3BE 11 1F 00         LD DE, 31
1085+ F3C1 19               ADD HL, DE                              ; siguiente fila col 0
1086+ F3C2 10 F7            DJNZ .hesRow
1087+ F3C4 C9               RET
1088+ F3C5 00           .hesAttr:     DEFB 0
1089+ F3C6 00           .hesTargetId: DEFB 0
1090+ F3C7
1091+ F3C7              ; ==============================================================================
1092+ F3C7              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
1093+ F3C7              ; ==============================================================================
1094+ F3C7              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
1095+ F3C7              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1096+ F3C7              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1097+ F3C7              ; + ON final settle): 8 ciclos de ON-OFF en total.
1098+ F3C7              ; ==============================================================================
1099+ F3C7              STATUE_BLINK_FRAMES   EQU 32
1100+ F3C7
1101+ F3C7              StartStatueBlink:
1102+ F3C7                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1103+ F3C7                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1104+ F3C7                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1105+ F3C7                  ; (caso A), .cbtActChurchDoor (caso B).
1106+ F3C7 3E 20            LD A, STATUE_BLINK_FRAMES
1107+ F3C9 32 C2 82         LD (StatueBlinkCounter), A
1108+ F3CC C3 57 F3         JP HighlightExpectedStatue              ; initial ON paint
1109+ F3CF
1110+ F3CF              UpdateStatueBlink:
1111+ F3CF                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1112+ F3CF 3A C2 82         LD A, (StatueBlinkCounter)
1113+ F3D2 B7               OR A
1114+ F3D3 C8               RET Z
1115+ F3D4 3D               DEC A
1116+ F3D5 32 C2 82         LD (StatueBlinkCounter), A
1117+ F3D8 20 03            JR NZ, .usbInProgress
1118+ F3DA                  ; Counter recien llego a 0: settle ON
1119+ F3DA C3 57 F3         JP HighlightExpectedStatue
1120+ F3DD              .usbInProgress:
1121+ F3DD                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1122+ F3DD                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1123+ F3DD CB 3F            SRL A
1124+ F3DF E6 01            AND $01
1125+ F3E1 28 05            JR Z, .usbOff
1126+ F3E3 3E 47            LD A, $47
1127+ F3E5 C3 5B F3         JP PaintExpectedStatueAttr
1128+ F3E8              .usbOff:
1129+ F3E8 AF               XOR A
1130+ F3E9 C3 5B F3         JP PaintExpectedStatueAttr
1131+ F3EC
1132+ F3EC              ; ==============================================================================
1133+ F3EC              ; CUTSCENE - parametros ajustables
1134+ F3EC              ; ==============================================================================
1135+ F3EC              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1136+ F3EC              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1137+ F3EC              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1138+ F3EC              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1139+ F3EC
1140+ F3EC              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1141+ F3EC              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1142+ F3EC              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1143+ F3EC
1144+ F3EC              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1145+ F3EC              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1146+ F3EC              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1147+ F3EC              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1148+ F3EC              ;   tick 12 -> erase smoke[2], pasar a DONE
1149+ F3EC              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1150+ F3EC              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1151+ F3EC
1152+ F3EC              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1153+ F3EC              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1154+ F3EC              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1155+ F3EC              ; centrado dentro del vano de la puerta.
1156+ F3EC              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1157+ F3EC              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1158+ F3EC              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1159+ F3EC              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1160+ F3EC
1161+ F3EC              ; ==============================================================================
1162+ F3EC              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1163+ F3EC              ; ==============================================================================
1164+ F3EC              ; IN: IX = monster atrapado.
1165+ F3EC              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1166+ F3EC              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1167+ F3EC              ; en ApplyChurchTrapEffects al final del cutscene.
1168+ F3EC              ; ==============================================================================
1169+ F3EC              TriggerChurchTrap:
1170+ F3EC                  ; --- 1. Calcular slot 0..2 ---
1171+ F3EC DD E5            PUSH IX
1172+ F3EE E1               POP HL
1173+ F3EF 11 AD 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1174+ F3F2 B7               OR A
1175+ F3F3 ED 52            SBC HL, DE
1176+ F3F5 CB 3D            SRL L
1177+ F3F7 CB 3D            SRL L
1178+ F3F9 CB 3D            SRL L
1179+ F3FB CB 3D            SRL L                                   ; L = slot 0..2
1180+ F3FD 7D               LD A, L
1181+ F3FE 32 9E 5F         LD (ChurchCutsceneSlot), A
1182+ F401                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1183+ F401 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1184+ F404 D6 4C            SUB SPRID_MONSTER_0
1185+ F406 CB 3F            SRL A
1186+ F408 CB 3F            SRL A
1187+ F40A CB 3F            SRL A                                   ; A = type idx
1188+ F40C 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1189+ F40F                  ; --- 2. Mover monster al centro del vano ---
1190+ F40F 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1191+ F411 DD 77 03         LD (IX+ENT_POSX), A
1192+ F414 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1193+ F416 DD 77 04         LD (IX+ENT_POSY), A
1194+ F419 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1195+ F41D DD 36 07 00      LD (IX+ENT_DELTAY), 0
1196+ F421 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1197+ F425                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1198+ F425                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1199+ F425                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1200+ F425                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1201+ F425                  ; temblor se vea con ink blanco brillante sobre paper negro.
1202+ F425 AF               XOR A
1203+ F426 32 C2 82         LD (StatueBlinkCounter), A              ; parar blink
1204+ F429 DD E5            PUSH IX
1205+ F42B CD 57 F3         CALL HighlightExpectedStatue            ; pintar $47
1206+ F42E                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1207+ F42E                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1208+ F42E                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1209+ F42E                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1210+ F42E CD 1B BB         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1211+ F431 3E FF            LD A, $FF
1212+ F433 CD BC 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1213+ F436                  ; Si este es el 3er monster (esqueleto, NextChurchTrapStep=2 antes del INC
1214+ F436                  ; en ApplyChurchTrapDone), parar tambien el secuencer ad-hoc de
1215+ F436                  ; MonstersMusic — tras esta cutscene ya no quedan monsters en juego.
1216+ F436 3A C1 82         LD A, (NextChurchTrapStep)
1217+ F439 FE 02            CP 2
1218+ F43B CC 50 FB         CALL Z, StopMonstersMusic
1219+ F43E DD E1            POP IX
1220+ F440                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1221+ F440 3E 01            LD A, 1
1222+ F442 32 C8 82         LD (ChurchCutscenePhase), A
1223+ F445 AF               XOR A
1224+ F446 32 9D 5F         LD (ChurchCutsceneFrame), A
1225+ F449 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1226+ F44B 32 A4 5F         LD (ChurchCutsceneLookCount), A
1227+ F44E C9               RET
1228+ F44F
1229+ F44F              ; ==============================================================================
1230+ F44F              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1231+ F44F              ; ==============================================================================
1232+ F44F              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1233+ F44F              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1234+ F44F              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1235+ F44F              ; ==============================================================================
1236+ F44F              UpdateChurchCutscene:
1237+ F44F 3A C8 82         LD A, (ChurchCutscenePhase)
1238+ F452 B7               OR A
1239+ F453 C8               RET Z
1240+ F454 3D               DEC A
1241+ F455 28 12            JR Z, .ucsLookPhase
1242+ F457 3D               DEC A
1243+ F458 28 38            JR Z, .ucsShakeStatuePhase
1244+ F45A 3D               DEC A
1245+ F45B CA E4 F4         JP Z, .ucsSmokePhase
1246+ F45E                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1247+ F45E CD 0D 64         CALL ApplyChurchTrapDone
1248+ F461 AF               XOR A
1249+ F462 32 C8 82         LD (ChurchCutscenePhase), A
1250+ F465 32 9D 5F         LD (ChurchCutsceneFrame), A
1251+ F468 C9               RET
1252+ F469
1253+ F469              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1254+ F469              .ucsLookPhase:
1255+ F469                  ; Frame counter (para detectar fin de fase)
1256+ F469 21 9D 5F         LD HL, ChurchCutsceneFrame
1257+ F46C 34               INC (HL)
1258+ F46D                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1259+ F46D 21 A4 5F         LD HL, ChurchCutsceneLookCount
1260+ F470 35               DEC (HL)
1261+ F471 20 06            JR NZ, .ucsLookCheckEnd
1262+ F473 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1263+ F475 77               LD (HL), A
1264+ F476 CD 32 F5         CALL ChurchCutsceneToggleMonsterDir
1265+ F479              .ucsLookCheckEnd:
1266+ F479 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1267+ F47C FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1268+ F47E D8               RET C                                   ; sigue mirando
1269+ F47F                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1270+ F47F                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1271+ F47F                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1272+ F47F CD E9 63         CALL EraseChurchTrappedMonster
1273+ F482 CD A7 66         CALL CloseChurchDoor
1274+ F485 CD 57 F5         CALL ChurchCutsceneInitStatueShake
1275+ F488 3E 02            LD A, 2
1276+ F48A 32 C8 82         LD (ChurchCutscenePhase), A
1277+ F48D AF               XOR A
1278+ F48E 32 9D 5F         LD (ChurchCutsceneFrame), A
1279+ F491 C9               RET
1280+ F492
1281+ F492              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1282+ F492              .ucsShakeStatuePhase:
1283+ F492 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1284+ F495 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1285+ F497 30 35            JR NC, .ucsShakeStatueDone
1286+ F499                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1287+ F499                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1288+ F499                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1289+ F499                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1290+ F499                  ;
1291+ F499                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1292+ F499                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1293+ F499 ED 5F            LD A, R
1294+ F49B E6 03            AND $03
1295+ F49D 21 CA F4         LD HL, .ucsShakeJitterTable
1296+ F4A0 5F               LD E, A
1297+ F4A1 16 00            LD D, 0
1298+ F4A3 19               ADD HL, DE
1299+ F4A4 7E               LD A, (HL)
1300+ F4A5 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1301+ F4A6                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1302+ F4A6 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1303+ F4A9 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1304+ F4AB 21 B1 64         LD HL, StatueIdTable
1305+ F4AE 38 03            JR C, .ucsShakeTablePicked
1306+ F4B0 21 B4 64         LD HL, StatueBrokenIdTable
1307+ F4B3              .ucsShakeTablePicked:
1308+ F4B3 78               LD A, B                                 ; restore jitter para la llamada
1309+ F4B4 CD C1 F5         CALL ChurchCutsceneShakeStatueByteShift
1310+ F4B7                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1311+ F4B7                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1312+ F4B7                  ; y al salir de la fase forzamos borde a negro explicitamente.
1313+ F4B7 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1314+ F4BA E6 01            AND $01
1315+ F4BC 28 04            JR Z, .ucsShakeBorderBlack
1316+ F4BE 3E 07            LD A, WHITE
1317+ F4C0 18 01            JR .ucsShakeBorderOut
1318+ F4C2              .ucsShakeBorderBlack:
1319+ F4C2 AF               XOR A                                   ; BLACK
1320+ F4C3              .ucsShakeBorderOut:
1321+ F4C3 D3 FE            OUT (254), A
1322+ F4C5 21 9D 5F         LD HL, ChurchCutsceneFrame
1323+ F4C8 34               INC (HL)
1324+ F4C9 C9               RET
1325+ F4CA              .ucsShakeJitterTable:
1326+ F4CA 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1327+ F4CE              .ucsShakeStatueDone:
1328+ F4CE                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1329+ F4CE AF               XOR A
1330+ F4CF D3 FE            OUT (254), A
1331+ F4D1                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1332+ F4D1                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1333+ F4D1                  ; directo a 0 garantiza que no queden residuos.)
1334+ F4D1 CD 2C F6         CALL ChurchCutsceneEraseStatueDirect
1335+ F4D4 21 D4 F9         LD HL, SFX_EnemyDeath
1336+ F4D7 CD 55 F9         CALL PlaySFX
1337+ F4DA 3E 03            LD A, 3
1338+ F4DC 32 C8 82         LD (ChurchCutscenePhase), A
1339+ F4DF AF               XOR A
1340+ F4E0 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1341+ F4E3 C9               RET
1342+ F4E4
1343+ F4E4              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1344+ F4E4              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1345+ F4E4              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1346+ F4E4              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1347+ F4E4              ; Entre transiciones, solo incrementa frame counter.
1348+ F4E4              .ucsSmokePhase:
1349+ F4E4 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1350+ F4E7 B7               OR A
1351+ F4E8 28 0E            JR Z, .ucsSmokeEntry
1352+ F4EA FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1353+ F4EC 28 16            JR Z, .ucsSmokeStep1
1354+ F4EE FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1355+ F4F0 28 1D            JR Z, .ucsSmokeStep2
1356+ F4F2 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1357+ F4F4 28 25            JR Z, .ucsSmokeEnd
1358+ F4F6 18 35            JR .ucsSmokeIncFrame
1359+ F4F8              .ucsSmokeEntry:
1360+ F4F8                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1361+ F4F8 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1362+ F4FB CD DC 65         CALL DrawRemainsForType
1363+ F4FE                  ; Dibujar smoke[0] (XOR)
1364+ F4FE AF               XOR A
1365+ F4FF CD 27 65         CALL DrawSmokeFrameXor
1366+ F502 18 29            JR .ucsSmokeIncFrame
1367+ F504              .ucsSmokeStep1:
1368+ F504 AF               XOR A
1369+ F505 CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1370+ F508 3E 01            LD A, 1
1371+ F50A CD 27 65         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1372+ F50D 18 1E            JR .ucsSmokeIncFrame
1373+ F50F              .ucsSmokeStep2:
1374+ F50F 3E 01            LD A, 1
1375+ F511 CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1376+ F514 3E 02            LD A, 2
1377+ F516 CD 27 65         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1378+ F519 18 12            JR .ucsSmokeIncFrame
1379+ F51B              .ucsSmokeEnd:
1380+ F51B 3E 02            LD A, 2
1381+ F51D CD 27 65         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1382+ F520 CD 46 65         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1383+ F523 3E 04            LD A, 4
1384+ F525 32 C8 82         LD (ChurchCutscenePhase), A
1385+ F528 AF               XOR A
1386+ F529 32 9D 5F         LD (ChurchCutsceneFrame), A
1387+ F52C C9               RET
1388+ F52D              .ucsSmokeIncFrame:
1389+ F52D 21 9D 5F         LD HL, ChurchCutsceneFrame
1390+ F530 34               INC (HL)
1391+ F531 C9               RET
1392+ F532
1393+ F532              ; ==============================================================================
1394+ F532              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1395+ F532              ; ==============================================================================
1396+ F532              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1397+ F532              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1398+ F532              ; ==============================================================================
1399+ F532              ChurchCutsceneToggleMonsterDir:
1400+ F532                  ; IX = trapped monster
1401+ F532 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1402+ F535 3C               INC A
1403+ F536 6F               LD L, A
1404+ F537 26 00            LD H, 0
1405+ F539 29               ADD HL, HL
1406+ F53A 29               ADD HL, HL
1407+ F53B 29               ADD HL, HL
1408+ F53C 29               ADD HL, HL
1409+ F53D 11 9D 81         LD DE, EntityTable
1410+ F540 19               ADD HL, DE
1411+ F541 E5               PUSH HL
1412+ F542 DD E1            POP IX
1413+ F544                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1414+ F544 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1415+ F547 DD 96 08         SUB (IX+ENT_ANIMBASE)
1416+ F54A EE 04            XOR 4
1417+ F54C 47               LD B, A
1418+ F54D DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1419+ F550 80               ADD A, B
1420+ F551 DD 77 00         LD (IX+ENT_SPRITEID), A
1421+ F554 C3 46 F6         JP RedrawTrappedMonster
1422+ F557
1423+ F557              ; ==============================================================================
1424+ F557              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1425+ F557              ; ==============================================================================
1426+ F557              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1427+ F557              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1428+ F557              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1429+ F557              ; ==============================================================================
1430+ F557              ChurchCutsceneInitStatueShake:
1431+ F557 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1432+ F55A 21 B1 64         LD HL, StatueIdTable
1433+ F55D 5F               LD E, A
1434+ F55E 16 00            LD D, 0
1435+ F560 19               ADD HL, DE
1436+ F561 7E               LD A, (HL)                              ; A = statue id
1437+ F562 B7               OR A
1438+ F563 C8               RET Z                                   ; sin estatua
1439+ F564 32 94 F5         LD (.cisTargetId), A
1440+ F567                  ; Buscar en CurrentScreenBuffer
1441+ F567 2A 0C 83         LD HL, (CurrentScreenAddr)
1442+ F56A              .cisLoop:
1443+ F56A 7E               LD A, (HL)
1444+ F56B FE FF            CP $FF
1445+ F56D C8               RET Z                                   ; no encontrada (no se hace shake)
1446+ F56E 47               LD B, A
1447+ F56F 3A 94 F5         LD A, (.cisTargetId)
1448+ F572 B8               CP B
1449+ F573 28 06            JR Z, .cisFound
1450+ F575 11 04 00         LD DE, 4
1451+ F578 19               ADD HL, DE
1452+ F579 18 EF            JR .cisLoop
1453+ F57B              .cisFound:
1454+ F57B 23               INC HL
1455+ F57C 7E               LD A, (HL)                              ; charX
1456+ F57D                  ; Pixel X = charX * 8
1457+ F57D 87               ADD A, A
1458+ F57E 87               ADD A, A
1459+ F57F 87               ADD A, A
1460+ F580 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1461+ F583 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1462+ F586 23               INC HL
1463+ F587 7E               LD A, (HL)                              ; charY
1464+ F588                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1465+ F588 C6 02            ADD A, BG_Y_OFFSET
1466+ F58A 87               ADD A, A
1467+ F58B 87               ADD A, A
1468+ F58C 87               ADD A, A
1469+ F58D 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1470+ F590 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1471+ F593 C9               RET
1472+ F594 00           .cisTargetId: DEFB 0
1473+ F595
1474+ F595              ; ==============================================================================
1475+ F595              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1476+ F595              ; ==============================================================================
1477+ F595              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1478+ F595              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1479+ F595              ; ==============================================================================
1480+ F595              ChurchCutsceneEraseStatueAtLast:
1481+ F595              ChurchCutsceneDrawStatueAtLast:
1482+ F595 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1483+ F598 21 B1 64         LD HL, StatueIdTable
1484+ F59B 5F               LD E, A
1485+ F59C 16 00            LD D, 0
1486+ F59E 19               ADD HL, DE
1487+ F59F 7E               LD A, (HL)                              ; A = statue id
1488+ F5A0 B7               OR A
1489+ F5A1 C8               RET Z
1490+ F5A2                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1491+ F5A2 6F               LD L, A
1492+ F5A3 26 00            LD H, 0
1493+ F5A5 54               LD D, H
1494+ F5A6 5D               LD E, L
1495+ F5A7 29               ADD HL, HL
1496+ F5A8 19               ADD HL, DE                              ; HL = id*3
1497+ F5A9 11 86 E0         LD DE, BgGfxPtrById
1498+ F5AC 19               ADD HL, DE
1499+ F5AD 5E               LD E, (HL)
1500+ F5AE 23               INC HL
1501+ F5AF 56               LD D, (HL)                              ; DE = sprite ptr
1502+ F5B0 23               INC HL
1503+ F5B1 7E               LD A, (HL)                              ; A = bank
1504+ F5B2 EB               EX DE, HL                               ; HL = sprite ptr
1505+ F5B3 CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1506+ F5B6                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1507+ F5B6 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1508+ F5B9 57               LD D, A
1509+ F5BA 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1510+ F5BD 5F               LD E, A
1511+ F5BE C3 39 66         JP DrawBgSprite16XorAtPixel
1512+ F5C1
1513+ F5C1              ; ==============================================================================
1514+ F5C1              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1515+ F5C1              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1516+ F5C1              ;     A  = jitter signed (-1, 0, +1) en bits.
1517+ F5C1              ; ==============================================================================
1518+ F5C1              ; IN: A = jitter signed (-1, 0, +1) en bits.
1519+ F5C1              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1520+ F5C1              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1521+ F5C1              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1522+ F5C1              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1523+ F5C1              ; version shifted, sin XOR.
1524+ F5C1              ;
1525+ F5C1              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1526+ F5C1              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1527+ F5C1              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1528+ F5C1              ; estatua se perdio cuando la estatua se pinto la primera vez con
1529+ F5C1              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1530+ F5C1              ; de la estatua, el wall perdido no se ve.
1531+ F5C1              ;
1532+ F5C1              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1533+ F5C1              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1534+ F5C1              ; shift de 1 bit no pierde pixels visibles.
1535+ F5C1              ; Destruye: AF, BC, DE, HL, IX.
1536+ F5C1              ; ==============================================================================
1537+ F5C1              ChurchCutsceneShakeStatueByteShift:
1538+ F5C1 32 2B F6         LD (.csbsJitter), A
1539+ F5C4                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1540+ F5C4 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1541+ F5C7 5F               LD E, A
1542+ F5C8 16 00            LD D, 0
1543+ F5CA 19               ADD HL, DE
1544+ F5CB 7E               LD A, (HL)
1545+ F5CC B7               OR A
1546+ F5CD C8               RET Z                                   ; sin estatua
1547+ F5CE 6F               LD L, A
1548+ F5CF 26 00            LD H, 0
1549+ F5D1 54               LD D, H
1550+ F5D2 5D               LD E, L
1551+ F5D3 29               ADD HL, HL
1552+ F5D4 19               ADD HL, DE                              ; HL = id*3
1553+ F5D5 11 86 E0         LD DE, BgGfxPtrById
1554+ F5D8 19               ADD HL, DE
1555+ F5D9 5E               LD E, (HL)
1556+ F5DA 23               INC HL
1557+ F5DB 56               LD D, (HL)                              ; DE = sprite ptr
1558+ F5DC 23               INC HL
1559+ F5DD 7E               LD A, (HL)                              ; A = bank
1560+ F5DE EB               EX DE, HL                               ; HL = sprite ptr
1561+ F5DF CD CA 67         CALL LoadBgSpriteToBuffer               ; preserva BC
1562+ F5E2                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1563+ F5E2 DD 21 F7 86      LD IX, BgSpriteBuffer
1564+ F5E6 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1565+ F5E9 B7               OR A
1566+ F5EA C8               RET Z
1567+ F5EB 47               LD B, A                                 ; B = row counter
1568+ F5EC DD 23            INC IX
1569+ F5EE DD 23            INC IX                                  ; IX -> pixel data
1570+ F5F0                  ; Calcular addr VRAM en (origX, origY)
1571+ F5F0 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1572+ F5F3 57               LD D, A
1573+ F5F4 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1574+ F5F7 5F               LD E, A
1575+ F5F8 CD 5C 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1576+ F5FB              .csbsRow:
1577+ F5FB C5               PUSH BC
1578+ F5FC E5               PUSH HL                                 ; save inicio fila VRAM
1579+ F5FD                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1580+ F5FD DD 7E 00         LD A, (IX+0)
1581+ F600 2F               CPL
1582+ F601 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1583+ F602 DD 7E 01         LD A, (IX+1)
1584+ F605 2F               CPL
1585+ F606 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1586+ F607                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1587+ F607 3A 2B F6         LD A, (.csbsJitter)
1588+ F60A B7               OR A
1589+ F60B 28 0D            JR Z, .csbsWrite                        ; sin shift
1590+ F60D FA 16 F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1591+ F610                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1592+ F610 CB 3A            SRL D
1593+ F612 CB 1B            RR E
1594+ F614 18 04            JR .csbsWrite
1595+ F616              .csbsLeft:
1596+ F616 CB 23            SLA E
1597+ F618 CB 12            RL D
1598+ F61A              .csbsWrite:
1599+ F61A 7A               LD A, D
1600+ F61B 77               LD (HL), A
1601+ F61C 23               INC HL
1602+ F61D 7B               LD A, E
1603+ F61E 77               LD (HL), A
1604+ F61F E1               POP HL
1605+ F620 CD C8 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1606+ F623 DD 23            INC IX
1607+ F625 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1608+ F627 C1               POP BC
1609+ F628 10 D1            DJNZ .csbsRow
1610+ F62A C9               RET
1611+ F62B 00           .csbsJitter: DEFB 0
1612+ F62C
1613+ F62C              ; ==============================================================================
1614+ F62C              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1615+ F62C              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1616+ F62C              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1617+ F62C              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1618+ F62C              ; Destruye: AF, BC, HL.
1619+ F62C              ; ==============================================================================
1620+ F62C              ChurchCutsceneEraseStatueDirect:
1621+ F62C 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1622+ F62F 57               LD D, A
1623+ F630 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1624+ F633 5F               LD E, A
1625+ F634 CD 5C 9D         CALL CalcPixelAddr
1626+ F637 06 18            LD B, 24                                ; statues son 24 px de alto
1627+ F639              .csedRow:
1628+ F639 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1629+ F63A 77               LD (HL), A
1630+ F63B 23               INC HL
1631+ F63C 77               LD (HL), A
1632+ F63D 2B               DEC HL                                  ; volver a inicio fila
1633+ F63E C5               PUSH BC
1634+ F63F CD C8 9A         CALL NextPixelLine
1635+ F642 C1               POP BC
1636+ F643 10 F4            DJNZ .csedRow
1637+ F645 C9               RET
1638+ F646
1639+ F646              ; ==============================================================================
1640+ F646              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1641+ F646              ; ==============================================================================
1642+ F646              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1643+ F646              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1644+ F646              ; suficiente para corromper visualmente).
1645+ F646              ; IN: IX = entity ptr.
1646+ F646              ; ==============================================================================
1647+ F646              RedrawTrappedMonster:
1648+ F646                  ; --- Erase viejo en (OLDX, OLDY) ---
1649+ F646 CD F6 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1650+ F649 DD 7E 0D         LD A, (IX+ENT_OLDY)
1651+ F64C 57               LD D, A
1652+ F64D DD 7E 0C         LD A, (IX+ENT_OLDX)
1653+ F650 5F               LD E, A
1654+ F651 DD E5            PUSH IX
1655+ F653 DD 2A 7E A4      LD IX, (OldSprAddr)
1656+ F657 CD E9 99         CALL DrawSprite
1657+ F65A DD E1            POP IX
1658+ F65C                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1659+ F65C                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1660+ F65C DD 56 0D         LD D, (IX+ENT_OLDY)
1661+ F65F DD 5E 0C         LD E, (IX+ENT_OLDX)
1662+ F662 CD 46 D3         CALL RestoreOldAttr
1663+ F665                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1664+ F665                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1665+ F665                  ; reponer attrs de pickups que el flujo de entidades pisa con
1666+ F665                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1667+ F665                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1668+ F665                  ; estar bajo el monster.
1669+ F665 DD E5            PUSH IX
1670+ F667 CD 50 DA         CALL RefreshPickupAttrs
1671+ F66A DD E1            POP IX
1672+ F66C                  ; --- Compute new draw pos ---
1673+ F66C CD 80 A4         CALL CalcDrawX
1674+ F66F CD 18 9F         CALL ComputeEnemyDrawY
1675+ F672                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1676+ F672 CD C5 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1677+ F675 3A DF 82         LD A, (EnemyDrawY)
1678+ F678 57               LD D, A
1679+ F679 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1680+ F67C 5F               LD E, A
1681+ F67D DD E5            PUSH IX
1682+ F67F DD 2A F4 A4      LD IX, (SpriteAddrTemp)
1683+ F683 CD 06 9B         CALL CalcEntityAttrSize
1684+ F686 DD E1            POP IX
1685+ F688 3A DF 82         LD A, (EnemyDrawY)
1686+ F68B 57               LD D, A
1687+ F68C DD 7E 0F         LD A, (IX+ENT_DRAWX)
1688+ F68F 5F               LD E, A
1689+ F690 DD 7E 05         LD A, (IX+ENT_ATTR)
1690+ F693 CD D9 9A         CALL SetEntityAttr
1691+ F696                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1692+ F696 3A DF 82         LD A, (EnemyDrawY)
1693+ F699 57               LD D, A
1694+ F69A DD 7E 0F         LD A, (IX+ENT_DRAWX)
1695+ F69D 5F               LD E, A
1696+ F69E DD E5            PUSH IX
1697+ F6A0 DD 2A F4 A4      LD IX, (SpriteAddrTemp)
1698+ F6A4 CD E9 99         CALL DrawSprite
1699+ F6A7 DD E1            POP IX
1700+ F6A9                  ; --- Save OLD = current ---
1701+ F6A9 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1702+ F6AC DD 77 0C         LD (IX+ENT_OLDX), A
1703+ F6AF 3A DF 82         LD A, (EnemyDrawY)
1704+ F6B2 DD 77 0D         LD (IX+ENT_OLDY), A
1705+ F6B5 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1706+ F6B8 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1707+ F6BB C9               RET
1708+ F6BC
1709+ F6BC              ; church-cutscene block (lines 1489-2181 originales) movido a code/church_cutscene.asm
1710+ F6BC              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1711+ F6BC
1712+ F6BC              ; ==============================================================================
1713+ F6BC              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1714+ F6BC              ; ==============================================================================
1715+ F6BC              ; Indice (CompassSprites[idx]):
1716+ F6BC              ;   0 = NW    1 = N    2 = NE
1717+ F6BC              ;   3 = W     4 = X    5 = E
1718+ F6BC              ;   6 = SW    7 = S    8 = SE
1719+ F6BC              ; ==============================================================================
1720+ F6BC              CompassSprites:
1721+ F6BC DB F7            DEFW Sprite_Compass_NW
1722+ F6BE FB F6            DEFW Sprite_Compass_N
