 724+ CDE9                  ; ===================== PATH RLE =====================
 725+ CDE9                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 726+ CDE9                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 727+ CDE9                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 728+ CDE9                  ; El estado .rlePending conserva el chunk entre filas:
 729+ CDE9                  ;   0 = necesita nuevo token
 730+ CDE9                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 731+ CDE9                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 732+ CDE9              .rlePixRow:
 733+ CDE9 3A 94 CE         LD A, (.widthVal)
 734+ CDEC 47               LD B, A
 735+ CDED E5               PUSH HL                     ; guardar inicio de fila VRAM
 736+ CDEE
 737+ CDEE              .rlePixCol:
 738+ CDEE 3A 98 CE         LD A, (.rlePending)
 739+ CDF1 B7               OR A
 740+ CDF2 CA 09 CE         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 741+ CDF5 FA 17 CE         JP M, .rleLitEmit           ; <0 = literal group en curso
 742+ CDF8                  ; >0 = run en curso, emitir valor
 743+ CDF8              .rleRunEmit:
 744+ CDF8 3A 99 CE         LD A, (.rleValue)
 745+ CDFB 2F               CPL
 746+ CDFC 77               LD (HL), A
 747+ CDFD 23               INC HL
 748+ CDFE 3A 98 CE         LD A, (.rlePending)
 749+ CE01 3D               DEC A
 750+ CE02 32 98 CE         LD (.rlePending), A
 751+ CE05 10 E7            DJNZ .rlePixCol
 752+ CE07 18 32            JR .rleRowDone
 753+ CE09
 754+ CE09              .rleNewToken:
 755+ CE09 DD 7E 00         LD A, (IX+0)
 756+ CE0C DD 23            INC IX
 757+ CE0E CB 7F            BIT 7, A
 758+ CE10 20 18            JR NZ, .rleNewRun
 759+ CE12                  ; --- Literal group: A = count (1-127) ---
 760+ CE12 ED 44            NEG                         ; A = -count (negativo)
 761+ CE14 32 98 CE         LD (.rlePending), A
 762+ CE17                  ; fall through: emitir primer byte literal
 763+ CE17
 764+ CE17              .rleLitEmit:
 765+ CE17 DD 7E 00         LD A, (IX+0)
 766+ CE1A DD 23            INC IX
 767+ CE1C 2F               CPL
 768+ CE1D 77               LD (HL), A
 769+ CE1E 23               INC HL
 770+ CE1F 3A 98 CE         LD A, (.rlePending)
 771+ CE22 3C               INC A                       ; hacia 0
 772+ CE23 32 98 CE         LD (.rlePending), A
 773+ CE26 10 C6            DJNZ .rlePixCol
 774+ CE28 18 11            JR .rleRowDone
