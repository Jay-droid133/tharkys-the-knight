 219+ E842              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 220+ E842              ; ==============================================================================
 221+ E842              ; Llamar cada frame desde el main loop.
 222+ E842              ; ==============================================================================
 223+ E842              ; AY_UpdateBellImpl: STUB. El tick del decay vive ahora en BellTickIrq
 224+ E842              ; (slot 1, music_irq.asm) y se llama desde MusicIrqHandler cada 25 Hz.
 225+ E842              ; Mantenemos el thunk thunk AY_UpdateBell + Impl por compat (algunos hooks
 226+ E842              ; podrian seguir llamandolo); ya es no-op.
 227+ E842              AY_UpdateBellImpl:
 228+ E842 C9               RET
 229+ E843
 230+ E843              ; ==============================================================================
 231+ E843              ; MUSIC DRIVER - Dispatcher entre tracks (canal B AY)
 232+ E843              ; ==============================================================================
 233+ E843              ; State + tablas + tick (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote)
 234+ E843              ; viven AHORA en code/music_irq.asm (slot 1, $6000-$7FFF, siempre visible).
 235+ E843              ; El IRQ handler debe poder leer ese codigo/datos sin paginar slot 3 — paginar
 236+ E843              ; dentro del IRQ rompe los PUSH/POP del propio handler (ver
 237+ E843              ; project_ay_thunk_stack_bug.md).
 238+ E843              ;
 239+ E843              ; Aqui solo queda StartMusicImpl (dispatcher one-shot al cambiar de track):
 240+ E843              ; corre en bank 4 (paged en slot 3 por su thunk) y referencia simbolos de
 241+ E843              ; slot 1 (TensionMusicTable, MusicLoop, etc.) que estan siempre visibles.
 242+ E843              ; Tail-jumpea a MusicAdvanceNote (slot 1) tras setear mixer/vol.
 243+ E843              ;
 244+ E843              ; Tracks (mismo formato; ver music_irq.asm para tablas):
 245+ E843              ;   0=Tension, 1=Sunrise, 2=EndGame (LOOP), 3=GameOver, 4=Death (LOOP)
 246+ E843              ;   $FF=STOP, $FE=restart, $FD=stop-if-loopable
 247+ E843              ; ==============================================================================
 248+ E843
 249+ E843              ; (state vars + tablas movidas a music_irq.asm — ver bloque
 250+ E843              ; "MUSIC DRIVER STATE + TABLES + TICK" alli.)
 251+ E843
 252+ E843              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 253+ E843              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 254+ E843              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 255+ E843              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 256+ E843              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 257+ E843              StartMusicImpl:
 258+ E843 3A D8 99         LD A, (MusicTrackArg)
 259+ E846 FE FF            CP $FF
 260+ E848 28 54            JR Z, .smStop                   ; sentinel: parar musica activa
 261+ E84A FE FE            CP $FE
 262+ E84C 28 7A            JR Z, .smRestart                ; sentinel: re-armar track actual desde
 263+ E84E                                                  ; primera nota, PRESERVANDO MusicLoop y
 264+ E84E                                                  ; MusicSpeedShift (utiles para enfasis
 265+ E84E                                                  ; ej. "muerte se lanza" -> sigue loop +
 266+ E84E                                                  ; aplica nuevo tempo desde nota 0).
 267+ E84E FE FD            CP $FD
 268+ E850 28 47            JR Z, .smStopIfLoopable         ; sentinel: parar solo si el track activo
 269+ E852                                                  ; es loopable. Usado por screen_system
 270+ E852                                                  ; al cambiar sala — corta DeathMusic (loopable,
 271+ E852                                                  ; ligada a Death entity) pero deja sonar
 272+ E852                                                  ; tension/sunrise (one-shot, music continua).
 273+ E852                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 274+ E852 F5               PUSH AF
 275+ E853 AF               XOR A
 276+ E854 32 AB 7B         LD (MusicLoop), A
 277+ E857 32 D9 99         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 278+ E85A F1               POP AF
 279+ E85B                  ; --- Resolver tabla + modo polifonico segun track id ---
 280+ E85B                  ; Tracks in-game (0/1/4) = poly2 (canal A+C, B reservado SFX).
 281+ E85B                  ; Tracks game-end (2/3) = poly3 (A+B+C, sin SFX en escena).
 282+ E85B 21 B3 7B         LD HL, TensionMusicTable
 283+ E85E B7               OR A
 284+ E85F 28 1E            JR Z, .smArmPoly2
 285+ E861 21 D1 7B         LD HL, SunriseMusicTable
 286+ E864 3D               DEC A
 287+ E865 28 18            JR Z, .smArmPoly2
 288+ E867 21 D5 7C         LD HL, EndGameMusicTable
 289+ E86A 3D               DEC A
 290+ E86B 28 19            JR Z, .smArmPoly3Loop            ; track 2 = LOOPABLE
 291+ E86D 21 29 7D         LD HL, GameOverMusicTable
 292+ E870 3D               DEC A
 293+ E871 28 18            JR Z, .smArmPoly3
 294+ E873 21 5A 7D         LD HL, DeathMusicTable
 295+ E876 3D               DEC A
 296+ E877 28 01            JR Z, .smArmPoly2Loop            ; track 4 = LOOPABLE
 297+ E879 C9               RET                              ; track_id desconocido: no-op
 298+ E87A
 299+ E87A              .smArmPoly2Loop:
 300+ E87A 3E 01            LD A, 1
 301+ E87C 32 AB 7B         LD (MusicLoop), A
 302+ E87F                  ; fall-through
 303+ E87F              .smArmPoly2:
 304+ E87F 3E 02            LD A, 2
 305+ E881 32 AC 7B         LD (MusicMode), A
 306+ E884 18 0A            JR .smArmCommon
 307+ E886
 308+ E886              .smArmPoly3Loop:
 309+ E886 3E 01            LD A, 1
 310+ E888 32 AB 7B         LD (MusicLoop), A
 311+ E88B                  ; fall-through
 312+ E88B              .smArmPoly3:
 313+ E88B 3E 03            LD A, 3
 314+ E88D 32 AC 7B         LD (MusicMode), A
 315+ E890                  ; fall-through
 316+ E890              .smArmCommon:
 317+ E890 22 A9 7B         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 318+ E893 22 A6 7B         LD (MusicPtr), HL
 319+ E896                  ; Mixer R7 vive en $38 (set por AY_Init) — los 3 tonos enable + ruidos off.
 320+ E896                  ; El silencio de un canal se gestiona via vol=0 (en MusicAdvanceNote y en
 321+ E896                  ; los SFX). No re-escribimos R7 aqui para no clobbear bell residual.
 322+ E896 C3 1B 7E         JP MusicAdvanceNote             ; tail-call: arma vol+period del primer nota
 323+ E899
 324+ E899              .smStopIfLoopable:
 325+ E899                  ; Sentinel $FD: solo para si el track activo es loopable. Tracks one-shot
 326+ E899                  ; (tension/sunrise/endgame) pasan de largo y siguen sonando.
 327+ E899 3A AB 7B         LD A, (MusicLoop)
 328+ E89C B7               OR A
 329+ E89D C8               RET Z
 330+ E89E                  ; fall-through al stop normal
 331+ E89E              .smStop:
 332+ E89E                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 333+ E89E                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 334+ E89E AF               XOR A
 335+ E89F 32 A8 7B         LD (MusicTimer), A
 336+ E8A2 32 AB 7B         LD (MusicLoop), A
 337+ E8A5 32 D9 99         LD (MusicSpeedShift), A         ; reset tempo
 338+ E8A8 67               LD H, A
 339+ E8A9 6F               LD L, A
 340+ E8AA 22 AD 7B         LD (MusicPeriodA), HL           ; clear periods → re-arm no escribe AY
 341+ E8AD 22 AF 7B         LD (MusicPeriodB), HL
 342+ E8B0 22 B1 7B         LD (MusicPeriodC), HL
 343+ E8B3                  ; Mute los 3 canales (poly2 usa A+C; poly3 usa A+B+C; vale para ambos).
 344+ E8B3 3E 08            LD A, 8
 345+ E8B5 1E 00            LD E, 0
 346+ E8B7 CD 59 E7         CALL AY_WriteReg                ; R8 = 0 (vol A)
 347+ E8BA 3E 09            LD A, 9
 348+ E8BC 1E 00            LD E, 0
 349+ E8BE CD 59 E7         CALL AY_WriteReg                ; R9 = 0 (vol B — solo era usado en poly3)
 350+ E8C1 3E 0A            LD A, 10
 351+ E8C3 1E 00            LD E, 0
 352+ E8C5 C3 59 E7         JP AY_WriteReg                  ; tail-call: R10 = 0 (vol C)
 353+ E8C8
 354+ E8C8              .smRestart:
 355+ E8C8                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 356+ E8C8                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 357+ E8C8                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 358+ E8C8                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 359+ E8C8                  ; con eventos del juego sin esperar al fin de la nota actual.
 360+ E8C8 2A A9 7B         LD HL, (MusicTableStart)
 361+ E8CB 22 A6 7B         LD (MusicPtr), HL
 362+ E8CE C3 1B 7E         JP MusicAdvanceNote
 363+ E8D1
 364+ E8D1              ; (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote movidos a music_irq.asm
 365+ E8D1              ; — slot 1, siempre visible, llamado desde el IRQ handler sin paginar.)
 366+ E8D1
# file closed: ay_sound.asm
