1434+ F623              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1435+ F623              ; ==============================================================================
1436+ F623              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1437+ F623              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1438+ F623              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1439+ F623              ; ==============================================================================
1440+ F623              ChurchCutsceneInitStatueShake:
1441+ F623 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1442+ F626 21 B7 64         LD HL, StatueIdTable
1443+ F629 5F               LD E, A
1444+ F62A 16 00            LD D, 0
1445+ F62C 19               ADD HL, DE
1446+ F62D 7E               LD A, (HL)                              ; A = statue id
1447+ F62E B7               OR A
1448+ F62F C8               RET Z                                   ; sin estatua
1449+ F630 32 60 F6         LD (.cisTargetId), A
1450+ F633                  ; Buscar en CurrentScreenBuffer
1451+ F633 2A 12 83         LD HL, (CurrentScreenAddr)
1452+ F636              .cisLoop:
1453+ F636 7E               LD A, (HL)
1454+ F637 FE FF            CP $FF
1455+ F639 C8               RET Z                                   ; no encontrada (no se hace shake)
1456+ F63A 47               LD B, A
1457+ F63B 3A 60 F6         LD A, (.cisTargetId)
1458+ F63E B8               CP B
1459+ F63F 28 06            JR Z, .cisFound
1460+ F641 11 04 00         LD DE, 4
1461+ F644 19               ADD HL, DE
1462+ F645 18 EF            JR .cisLoop
1463+ F647              .cisFound:
1464+ F647 23               INC HL
1465+ F648 7E               LD A, (HL)                              ; charX
1466+ F649                  ; Pixel X = charX * 8
1467+ F649 87               ADD A, A
1468+ F64A 87               ADD A, A
1469+ F64B 87               ADD A, A
1470+ F64C 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1471+ F64F 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1472+ F652 23               INC HL
1473+ F653 7E               LD A, (HL)                              ; charY
1474+ F654                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1475+ F654 C6 02            ADD A, BG_Y_OFFSET
1476+ F656 87               ADD A, A
1477+ F657 87               ADD A, A
1478+ F658 87               ADD A, A
1479+ F659 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1480+ F65C 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1481+ F65F C9               RET
1482+ F660 00           .cisTargetId: DEFB 0
