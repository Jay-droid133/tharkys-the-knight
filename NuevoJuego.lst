 492+ EC6D              .upcc_applySpeed:
 493+ EC6D 3A DE 82         LD A, (SpeedBuffType)
 494+ EC70 FE 01            CP SPEED_BUFF_TYPE_RAYO
 495+ EC72 3E 45            LD A, SPEED_BUFF_RAYO_ATTR              ; $45 cyan bright
 496+ EC74 28 06            JR Z, .upcc_writeAttr
 497+ EC76 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR           ; $44 green bright
 498+ EC78 18 02            JR .upcc_writeAttr
 499+ EC7A
 500+ EC7A              .upcc_applyMush:
 501+ EC7A 3E 43            LD A, MUSHROOM_LOCK_ATTR                ; $43 magenta bright
 502+ EC7C
 503+ EC7C              .upcc_writeAttr:
