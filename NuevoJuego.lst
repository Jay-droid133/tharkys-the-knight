 523+ F1B3                  ; fall through a .dcRedraw
 524+ F1B3
 525+ F1B3              .dcRedraw:
 526+ F1B3                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F1B3 3A C0 82         LD A, (ObjectiveScreenX)
 528+ F1B6 47               LD B, A
 529+ F1B7 3A 10 83         LD A, (CurrentScreenX)
 530+ F1BA 4F               LD C, A
 531+ F1BB 78               LD A, B
 532+ F1BC 91               SUB C                               ; A = dx (signed)
 533+ F1BD                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F1BD F2 C7 F1         JP P, .dcDxNonNeg
 535+ F1C0 ED 44            NEG
 536+ F1C2 67               LD H, A                             ; abs(dx)
 537+ F1C3 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F1C5 18 0A            JR .dcDxDone
 539+ F1C7              .dcDxNonNeg:
 540+ F1C7 67               LD H, A
 541+ F1C8 B7               OR A
 542+ F1C9 20 04            JR NZ, .dcDxPositive
 543+ F1CB 2E 01            LD L, 1                             ; dx == 0
 544+ F1CD 18 02            JR .dcDxDone
 545+ F1CF              .dcDxPositive:
 546+ F1CF 2E 02            LD L, 2
 547+ F1D1              .dcDxDone:
 548+ F1D1 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F1D2
 550+ F1D2                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F1D2 3A C1 82         LD A, (ObjectiveScreenY)
 552+ F1D5 47               LD B, A
 553+ F1D6 3A 11 83         LD A, (CurrentScreenY)
 554+ F1D9 4F               LD C, A
 555+ F1DA 78               LD A, B
 556+ F1DB 91               SUB C
 557+ F1DC F2 E6 F1         JP P, .dcDyNonNeg
 558+ F1DF ED 44            NEG
 559+ F1E1 67               LD H, A
 560+ F1E2 2E 00            LD L, 0
 561+ F1E4 18 0A            JR .dcDyDone
 562+ F1E6              .dcDyNonNeg:
 563+ F1E6 67               LD H, A
 564+ F1E7 B7               OR A
 565+ F1E8 20 04            JR NZ, .dcDyPositive
 566+ F1EA 2E 01            LD L, 1
 567+ F1EC 18 02            JR .dcDyDone
 568+ F1EE              .dcDyPositive:
 569+ F1EE 2E 02            LD L, 2
 570+ F1F0              .dcDyDone:
 571+ F1F0                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 572+ F1F0 D1               POP DE                              ; D = abs_dx, E = signdx+1
