 427+ 8F69 19               ADD HL, DE
 428+ 8F6A 36 00            LD (HL), 0
 429+ 8F6C 21 89 8D         LD HL, MonsterRoomId
 430+ 8F6F 19               ADD HL, DE
 431+ 8F70 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 8F72 21 8F 8D         LD HL, MonsterEntryBorder
 433+ 8F75 19               ADD HL, DE
 434+ 8F76 36 00            LD (HL), 0
 435+ 8F78 21 92 8D         LD HL, MonsterExitCoord
 436+ 8F7B 19               ADD HL, DE
 437+ 8F7C 36 00            LD (HL), 0
 438+ 8F7E 21 79 B3         LD HL, MonsterReturnTimer
 439+ 8F81 19               ADD HL, DE
 440+ 8F82 36 00            LD (HL), 0
 441+ 8F84 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 8F87 19               ADD HL, DE
 443+ 8F88 36 00            LD (HL), 0
 444+ 8F8A 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 8F8D 19               ADD HL, DE
 446+ 8F8E 36 00            LD (HL), 0
 447+ 8F90 C9               RET
