 362+ 7DF9 E5               PUSH HL
 363+ 7DFA 3E 09            LD A, 9
 364+ 7DFC 1E 0C            LD E, 12
 365+ 7DFE CD 87 7D         CALL AY_WriteRegSlot1           ; R9 = vol B medio-alto
 366+ 7E01 E1               POP HL
 367+ 7E02 5D               LD E, L
 368+ 7E03 3E 02            LD A, 2
 369+ 7E05 CD 87 7D         CALL AY_WriteRegSlot1           ; R2 = period B lo
