 547+ E80B 6F               LD L, A             ; HL = puntero a datos de línea
 548+ E80C
 549+ E80C              .pixLoop:
 550+ E80C 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 551+ E80D B7               OR A
 552+ E80E C8               RET Z
 553+ E80F 57               LD D, A
 554+ E810 23               INC HL
 555+ E811 7E               LD A, (HL)          ; VRAM L
