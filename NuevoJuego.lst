 292+ FA6B              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 293+ FA6B              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 294+ FA6B              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 295+ FA6B              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 296+ FA6B              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 297+ FA6B              SFX_KeyDrop:
 298+ FA6B 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 299+ FA6F 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 300+ FA73 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 301+ FA77 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 302+ FA7B 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 303+ FA7F 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 304+ FA83 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 305+ FA87 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 306+ FA8B 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 307+ FA8F 00               DEFB   0                       ; fin
 308+ FA90
 309+ FA90              ; --- Sistema de campanadas con pausa entre ellas ---
 310+ FA90              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 311+ FA90              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 312+ FA90              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 313+ FA90 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 314+ FA91 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 315+ FA93              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 316+ FA93              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 317+ FA93
 318+ FA93              ; --- Cadena de eventos tras la ultima campanada ---
 319+ FA93              ; last chime → (delay) → windows off → (delay) → monster spawn
 320+ FA93              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 321+ FA93              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 322+ FA93 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 323+ FA94 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 324+ FA95
 325+ FA95              ; ==============================================================================
 326+ FA95              ; StartBellChimes - Inicia secuencia de 12 campanadas
 327+ FA95              ; ==============================================================================
 328+ FA95              StartBellChimes:
 329+ FA95                  ; Silenciar musica activa (death o cualquier otra). Bell escribe R7 (mixer
 330+ FA95                  ; all-on), R0-R5 (period A/B/C) y R8-R10 (vols), clobbeando lo que la musica
 331+ FA95                  ; mantenga en canal B. Mejor parar limpiamente que oir glitches.
 332+ FA95 F5               PUSH AF
 333+ FA96 3E FF            LD A, $FF
 334+ FA98 CD B3 99         CALL StartMusic
 335+ FA9B F1               POP AF
 336+ FA9C 3E 0C            LD A, 12                            ; 12 campanadas (medianoche)
 337+ FA9E 32 90 FA         LD (BellCount), A
 338+ FAA1                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 339+ FAA1 2A 78 5C         LD HL, (SYS_FRAMES)
 340+ FAA4 22 91 FA         LD (BellNextFrame), HL
 341+ FAA7 3E 7D            LD A, SCARE_TIMER_BELLS
 342+ FAA9 32 E7 B5         LD (ScareTimer), A
 343+ FAAC C9               RET
 344+ FAAD
 345+ FAAD              ; ==============================================================================
 346+ FAAD              ; UpdateBellChimes - Llamar cada frame desde el main loop
 347+ FAAD              ; ==============================================================================
 348+ FAAD              UpdateBellChimes:
 349+ FAAD 3A 90 FA         LD A, (BellCount)
 350+ FAB0 B7               OR A
 351+ FAB1 C8               RET Z                       ; sin campanadas pendientes
 352+ FAB2
 353+ FAB2                  ; Comparar FRAMES actual con BellNextFrame
 354+ FAB2 2A 78 5C         LD HL, (SYS_FRAMES)
 355+ FAB5 ED 5B 91 FA      LD DE, (BellNextFrame)
 356+ FAB9 B7               OR A
 357+ FABA ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 358+ FABC D8               RET C                       ; FRAMES < deadline → aun no toca
 359+ FABD
 360+ FABD                  ; Sonar campanada (AY, no bloquea CPU)
 361+ FABD C5               PUSH BC
 362+ FABE D5               PUSH DE
 363+ FABF CD C9 98         CALL AY_PlayBellChime
 364+ FAC2 D1               POP DE
 365+ FAC3 C1               POP BC
 366+ FAC4
 367+ FAC4                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 368+ FAC4                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 369+ FAC4 2A 78 5C         LD HL, (SYS_FRAMES)
 370+ FAC7 11 4B 00         LD DE, BELL_PAUSE
 371+ FACA 19               ADD HL, DE
 372+ FACB 22 91 FA         LD (BellNextFrame), HL
 373+ FACE
 374+ FACE 21 90 FA         LD HL, BellCount
 375+ FAD1 35               DEC (HL)
 376+ FAD2 C0               RET NZ
 377+ FAD3 18 00            JR .bellsDone
 378+ FAD5
 379+ FAD5              .bellsDone:
 380+ FAD5                  ; Ultima campanada:
 381+ FAD5                  ;   1) matar todos los nasties vivos (puff)
 382+ FAD5                  ;   2) arrancar cadena diferida: windows off → monster spawn
 383+ FAD5 CD 26 BA         CALL KillAllActiveNasties
 384+ FAD8 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 385+ FADA 32 93 FA         LD (BellsDoneTimer), A
 386+ FADD C9               RET
 387+ FADE
 388+ FADE              ; ==============================================================================
 389+ FADE              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 390+ FADE              ; ==============================================================================
 391+ FADE              ; Maneja la cadena diferida tras la ultima campanada:
 392+ FADE              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 393+ FADE              ;      y arranca SpawnAfterWinTimer
 394+ FADE              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 395+ FADE              ; ==============================================================================
 396+ FADE              UpdateBellsDoneTimer:
 397+ FADE 3A 93 FA         LD A, (BellsDoneTimer)
 398+ FAE1 B7               OR A
 399+ FAE2 28 21            JR Z, .ubdCheckSpawn
 400+ FAE4 3D               DEC A
 401+ FAE5 32 93 FA         LD (BellsDoneTimer), A
 402+ FAE8 20 1B            JR NZ, .ubdCheckSpawn
 403+ FAEA                  ; Llego a 0: apagar ventanas
 404+ FAEA CD C2 E3         CALL UpdateRemapTables
 405+ FAED 3E 01            LD A, 1
 406+ FAEF 32 0A 83         LD (AttrsDirty), A
 407+ FAF2                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 408+ FAF2                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 409+ FAF2                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 410+ FAF2                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 411+ FAF2 3A AA 82         LD A, (ChurchDoorOpen)
 412+ FAF5 B7               OR A
 413+ FAF6 28 03            JR Z, .ubdSkipHighlight
 414+ FAF8 CD 96 F3         CALL StartStatueBlink
 415+ FAFB              .ubdSkipHighlight:
 416+ FAFB                  ; Armar el gating: SpawnAfterWinTimer = 1 = "esperando a que Tension
 417+ FAFB                  ; termine para spawnear". El check real esta en .ubdCheckSpawn (mira
 418+ FAFB                  ; MusicTimer del driver tabular). Cuando Tension acaba (MusicTimer
 419+ FAFB                  ; pasa a 0), dispara SpawnMonsters. Asi el primer monster aparece
 420+ FAFB                  ; tras Tension + el natural ~0.8s de MONSTER_ENTRY_BASE -> "calma
 421+ FAFB                  ; antes de la tormenta".
 422+ FAFB 3E 01            LD A, 1
 423+ FAFD 32 94 FA         LD (SpawnAfterWinTimer), A
 424+ FB00                  ; Musica de tension organica entre lights-off y monster spawn (track 0)
 425+ FB00 AF               XOR A                           ; A = 0 = MUSIC_TENSION
 426+ FB01 CD B3 99         CALL StartMusic
 427+ FB04 C9               RET
 428+ FB05              .ubdCheckSpawn:
 429+ FB05 3A 94 FA         LD A, (SpawnAfterWinTimer)
 430+ FB08 B7               OR A
 431+ FB09 C8               RET Z                           ; no armado (boot, ya disparado, etc.)
 432+ FB0A                  ; Gating dinamico: esperar a que MusicTimer del driver tabular llegue
 433+ FB0A                  ; a 0. Indica que Tension (la musica activa) acaba de terminar (su
 434+ FB0A                  ; ultima nota se cumplio y MusicEndOfTable.meotStop puso Timer=0).
 435+ FB0A                  ; Robusto a cambios de duracion en TensionMusicTable.
 436+ FB0A 3A A8 7B         LD A, (MusicTimer)
 437+ FB0D B7               OR A
 438+ FB0E C0               RET NZ                          ; Tension aun sonando
 439+ FB0F                  ; Tension acabo: rearmar y disparar spawn.
 440+ FB0F AF               XOR A
 441+ FB10 32 94 FA         LD (SpawnAfterWinTimer), A
 442+ FB13 C3 45 BD         JP SpawnMonsters
 443+ FB16
 444+ FB16              ; ==============================================================================
 445+ FB16              ; MonstersMusic - Secuencer ad-hoc para una nota grave repetida
 446+ FB16              ; ==============================================================================
 447+ FB16              ; Ritmo "po-po-popo-po": 5 hits con gaps definidos en MonstersBeatGaps. Cada
 448+ FB16              ; hit dispara AY_PlayBeep(period=$0688 ~C2, dur=4f) en canal B AY (~160ms).
 449+ FB16              ; Loopable. Arrancado desde SpawnMonsters (StartMonstersMusic). Detenido al
 450+ FB16              ; sunrise (StopMonstersMusic).
 451+ FB16              ;
 452+ FB16              ; NO usa el driver tabular ni reserva nada en slot 1 — el patron es puro
 453+ FB16              ; codigo. Variables (Timer + Step) viven al final de esta rutina (bank 0).
 454+ FB16              ;
 455+ FB16              ; Para iterar: ajustar MonstersBeatGaps (frames entre hits) o el period en
 456+ FB16              ; UpdateMonstersMusic (LD HL, $0688) para cambiar el tono.
 457+ FB16              ; ==============================================================================
 458+ FB16
 459+ FB16              ; --- StartMonstersMusic: arranca el secuencer ---
 460+ FB16              ; Se llama desde SpawnMonsters una vez por noche. Setea Step=0 + Timer=1
 461+ FB16              ; para que el primer hit suene en el frame siguiente.
 462+ FB16              StartMonstersMusic:
 463+ FB16 AF               XOR A
 464+ FB17 32 54 FB         LD (MonstersMusicStep), A       ; Step = 0 → primer hit
 465+ FB1A 3C               INC A
 466+ FB1B 32 53 FB         LD (MonstersMusicTimer), A      ; Timer = 1 → suena ya en proximo update
 467+ FB1E C9               RET
 468+ FB1F
 469+ FB1F              ; --- StopMonstersMusic: detiene el secuencer ---
 470+ FB1F              ; Se llama al sunrise (day_cycle.asm fase 5). Step=$FF actua como sentinel
 471+ FB1F              ; "inactivo" en UpdateMonstersMusic (INC A → 0 → RET Z).
 472+ FB1F              StopMonstersMusic:
 473+ FB1F 3E FF            LD A, $FF
 474+ FB21 32 54 FB         LD (MonstersMusicStep), A
 475+ FB24 C9               RET
 476+ FB25
 477+ FB25              ; --- UpdateMonstersMusic: tick por frame desde MainLoop ---
 478+ FB25              ; Si activo, decrementa Timer; cuando llega a 0, dispara AY_PlayBeep y
 479+ FB25              ; avanza Step (con wrap a 0 al pasar de 4). Si Step=$FF, no-op.
 480+ FB25              UpdateMonstersMusic:
 481+ FB25 3A 54 FB         LD A, (MonstersMusicStep)
 482+ FB28 3C               INC A
 483+ FB29 C8               RET Z                           ; $FF + INC = 0 → inactivo
 484+ FB2A 3D               DEC A                           ; restaurar Step real
 485+ FB2B 21 53 FB         LD HL, MonstersMusicTimer
 486+ FB2E 35               DEC (HL)
 487+ FB2F C0               RET NZ                          ; aun esperando proximo hit
 488+ FB30                  ; Hora del proximo "po": leer gap[Step] -> Timer
 489+ FB30 21 4E FB         LD HL, MonstersBeatGaps
 490+ FB33 5F               LD E, A
 491+ FB34 16 00            LD D, 0
 492+ FB36 19               ADD HL, DE
 493+ FB37 7E               LD A, (HL)
 494+ FB38 32 53 FB         LD (MonstersMusicTimer), A
 495+ FB3B                  ; Avanzar Step con wrap a 0 al llegar a 5
 496+ FB3B 21 54 FB         LD HL, MonstersMusicStep
 497+ FB3E 34               INC (HL)
 498+ FB3F 7E               LD A, (HL)
 499+ FB40 FE 05            CP 5
 500+ FB42 38 02            JR C, .ummDoBeep
 501+ FB44 AF               XOR A
 502+ FB45 77               LD (HL), A                      ; wrap: Step=0 → vuelve al inicio del patron
 503+ FB46              .ummDoBeep:
 504+ FB46 21 88 06         LD HL, $0688                    ; period AY canal B (~C2 = 65 Hz, grave)
 505+ FB49 06 03            LD B, 3                         ; cutoff a 3 frames (~120ms) -> "po" staccato medio
 506+ FB4B C3 D2 6A         JP AY_PlayBeep                  ; tail-call
 507+ FB4E
 508+ FB4E              ; --- Datos del patron "po-po-popo-po" ---
 509+ FB4E              ; Frames entre hits consecutivos. Total = 12+12+4+8+26 = 62 frames = ~2.48s/loop.
 510+ FB4E              ; Beat 1: po (gap 12 hasta beat 2)
 511+ FB4E              ; Beat 2: po (gap 12 hasta beat 3.0)
 512+ FB4E              ; Beat 3.0: po (gap 4 hasta beat 3.5 = corchea)
 513+ FB4E              ; Beat 3.5: po (gap 8 hasta beat 4)
 514+ FB4E              ; Beat 4: po (gap 26 hasta beat 1 = loop — pausa larga al final)
 515+ FB4E              MonstersBeatGaps:
 516+ FB4E 0C 0C 04 08      DEFB 12, 12, 4, 8, 26
 516+ FB52 1A
 517+ FB53
 518+ FB53 00           MonstersMusicTimer: DEFB 0
 519+ FB54 FF           MonstersMusicStep:  DEFB $FF             ; $FF = inactivo (sentinel)
 520+ FB55
