 196+ E9FA              ; ==============================================================================
 197+ E9FA              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 198+ E9FA              ; ==============================================================================
 199+ E9FA              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 200+ E9FA              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 201+ E9FA              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 202+ E9FA              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 203+ E9FA              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 204+ E9FA              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 205+ E9FA              ;               actuales; queda como salvaguarda.
 206+ E9FA              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 207+ E9FA              ; Destruye: AF, BC, DE, HL.
 208+ E9FA              ; ==============================================================================
 209+ E9FA              ResolveObjectiveScreen:
 210+ E9FA 3A F7 81         LD A, (CurrentObjective)
 211+ E9FD FE 09            CP 9
 212+ E9FF 30 2F            JR NC, .rosNoTarget
 213+ EA01 87               ADD A, A
 214+ EA02 6F               LD L, A
 215+ EA03 26 00            LD H, 0
 216+ EA05 11 34 E9         LD DE, MilestoneResolveTable
 217+ EA08 19               ADD HL, DE
 218+ EA09 7E               LD A, (HL)                          ; tipo
 219+ EA0A 23               INC HL
 220+ EA0B 46               LD B, (HL)                          ; B = ref
 221+ EA0C FE 01            CP MILESTONE_TYPE_PICKUP
 222+ EA0E 28 06            JR Z, .rosPickup
 223+ EA10 FE 02            CP MILESTONE_TYPE_TRIGGER
 224+ EA12 28 08            JR Z, .rosTrigger
 225+ EA14 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 226+ EA16              .rosPickup:
 227+ EA16 78               LD A, B
 228+ EA17 CD 39 EA         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 229+ EA1A 18 08            JR .rosFindPos
 230+ EA1C              .rosTrigger:
 231+ EA1C 78               LD A, B
 232+ EA1D CD 46 EA         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 233+ EA20 7A               LD A, D
 234+ EA21 B3               OR E
 235+ EA22 28 0C            JR Z, .rosNoTarget
 236+ EA24              .rosFindPos:
 237+ EA24 CD 61 EA         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 238+ EA27 78               LD A, B
 239+ EA28 32 F8 81         LD (ObjectiveScreenX), A
 240+ EA2B 79               LD A, C
 241+ EA2C 32 F9 81         LD (ObjectiveScreenY), A
 242+ EA2F C9               RET
 243+ EA30              .rosNoTarget:
 244+ EA30 3E FF            LD A, $FF
 245+ EA32 32 F8 81         LD (ObjectiveScreenX), A
 246+ EA35 32 F9 81         LD (ObjectiveScreenY), A
 247+ EA38 C9               RET
 248+ EA39
 249+ EA39              ; ==============================================================================
 250+ EA39              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 251+ EA39              ; ==============================================================================
 252+ EA39              ; IN:  A = key id (1..6)
 253+ EA39              ; OUT: DE = ptr
 254+ EA39              ; Destruye: AF, HL.
 255+ EA39              ; ==============================================================================
 256+ EA39              KeyIdToPtr:
 257+ EA39 3D               DEC A
 258+ EA3A 87               ADD A, A                            ; *2 (DEFW size)
 259+ EA3B 6F               LD L, A
 260+ EA3C 26 00            LD H, 0
 261+ EA3E 11 D2 D2         LD DE, KeyLockTable
 262+ EA41 19               ADD HL, DE
 263+ EA42 5E               LD E, (HL)
 264+ EA43 23               INC HL
 265+ EA44 56               LD D, (HL)
 266+ EA45 C9               RET
 267+ EA46
 268+ EA46              ; ==============================================================================
 269+ EA46              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 270+ EA46              ; ==============================================================================
 271+ EA46              ; IN:  A = action id (1, 2, ...)
 272+ EA46              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 273+ EA46              ;      Z flag set si no encontrado.
 274+ EA46              ; Destruye: AF, BC, HL.
 275+ EA46              ; ==============================================================================
 276+ EA46              ActionToTriggerPtr:
 277+ EA46 4F               LD C, A                             ; C = action id buscada
 278+ EA47 21 60 D3         LD HL, BumpTriggerTable
 279+ EA4A              .attLoop:
 280+ EA4A 5E               LD E, (HL)
 281+ EA4B 23               INC HL
 282+ EA4C 56               LD D, (HL)
 283+ EA4D 23               INC HL                              ; HL -> required_key
 284+ EA4E 7A               LD A, D
 285+ EA4F B3               OR E
 286+ EA50 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 287+ EA52 23               INC HL                              ; HL -> action
 288+ EA53 7E               LD A, (HL)
 289+ EA54 23               INC HL                              ; HL -> next entry
 290+ EA55 B9               CP C
 291+ EA56 20 F2            JR NZ, .attLoop
 292+ EA58 F6 01            OR 1                                ; clear Z (encontrado)
 293+ EA5A C9               RET
 294+ EA5B              .attNotFound:
 295+ EA5B 16 00            LD D, 0
 296+ EA5D 1E 00            LD E, 0
 297+ EA5F AF               XOR A                               ; set Z
 298+ EA60 C9               RET
 299+ EA61
 300+ EA61              ; ==============================================================================
 301+ EA61              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 302+ EA61              ; ==============================================================================
 303+ EA61              ; PickupTable layout (per-entry, 7 bytes):
 304+ EA61              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 305+ EA61              ; Terminator: $FF (single byte).
 306+ EA61              ;
 307+ EA61              ; IN:  DE = ptr a buscar
 308+ EA61              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 309+ EA61              ;      B = C = $FF si no encontrado (Z).
 310+ EA61              ; Destruye: AF, HL. Preserva DE.
 311+ EA61              ; ==============================================================================
 312+ EA61              FindPickupScreen:
 313+ EA61 21 F5 D9         LD HL, PickupTable
 314+ EA64              .fpsLoop:
 315+ EA64 7E               LD A, (HL)
 316+ EA65 FE FF            CP $FF
 317+ EA67 28 1C            JR Z, .fpsNotFound
 318+ EA69 E5               PUSH HL
 319+ EA6A 23               INC HL                              ; -> mapY
 320+ EA6B 23               INC HL                              ; -> ptr_lo
 321+ EA6C 7E               LD A, (HL)
 322+ EA6D BB               CP E
 323+ EA6E 20 0C            JR NZ, .fpsNoMatch
 324+ EA70 23               INC HL                              ; -> ptr_hi
 325+ EA71 7E               LD A, (HL)
 326+ EA72 BA               CP D
 327+ EA73 20 07            JR NZ, .fpsNoMatch
 328+ EA75 E1               POP HL                              ; back to entry start (mapX)
 329+ EA76 46               LD B, (HL)                          ; B = mapX
 330+ EA77 23               INC HL
 331+ EA78 4E               LD C, (HL)                          ; C = mapY
 332+ EA79 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 333+ EA7B C9               RET
 334+ EA7C              .fpsNoMatch:
 335+ EA7C E1               POP HL
 336+ EA7D C5               PUSH BC
 337+ EA7E 01 07 00         LD BC, 7
 338+ EA81 09               ADD HL, BC
 339+ EA82 C1               POP BC
 340+ EA83 18 DF            JR .fpsLoop
 341+ EA85              .fpsNotFound:
 342+ EA85 06 FF            LD B, $FF
 343+ EA87 0E FF            LD C, $FF
 344+ EA89 AF               XOR A                               ; set Z
 345+ EA8A C9               RET
 346+ EA8B
 347+ EA8B              ; ==============================================================================
 348+ EA8B              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 349+ EA8B              ; ==============================================================================
 350+ EA8B              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 351+ EA8B              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 352+ EA8B              ; third). El brujula se redibuja solo cuando:
 353+ EA8B              ;   - cambias de pantalla (LastCompassScreen != Current)
 354+ EA8B              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 355+ EA8B              ; En reposo es un no-op barato (solo unas comparaciones).
 356+ EA8B              ;
 357+ EA8B              ; Color (atributo de las 4 celdas):
 358+ EA8B              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 359+ EA8B              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 360+ EA8B              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 361+ EA8B              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 362+ EA8B              ;
 363+ EA8B              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 364+ EA8B              ; ==============================================================================
 365+ EA8B
 366+ EA8B              COMPASS_COL     EQU 24
 367+ EA8B              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 368+ EA8B
 369+ EA8B              ; ==============================================================================
 370+ EA8B              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 371+ EA8B              ; ==============================================================================
 372+ EA8B              DrawCompass:
 373+ EA8B                  ; Sin objetivo resuelto -> limpiar y salir
 374+ EA8B 3A F8 81         LD A, (ObjectiveScreenX)
 375+ EA8E FE FF            CP $FF
 376+ EA90 CA D7 EB         JP Z, ClearCompass
 377+ EA93
 378+ EA93                  ; Necesita redraw? screen cambio, PrevDist == $FF, o wobble activo.
 379+ EA93 3A 1D 82         LD A, (CurrentScreenX)
 380+ EA96 47               LD B, A
 381+ EA97 3A FB 81         LD A, (LastCompassScreenX)
 382+ EA9A B8               CP B
 383+ EA9B 20 16            JR NZ, .dcRedraw
 384+ EA9D 3A 1E 82         LD A, (CurrentScreenY)
 385+ EAA0 47               LD B, A
 386+ EAA1 3A FC 81         LD A, (LastCompassScreenY)
 387+ EAA4 B8               CP B
 388+ EAA5 20 0C            JR NZ, .dcRedraw
 389+ EAA7 3A FA 81         LD A, (PreviousObjectiveDistance)
 390+ EAAA FE FF            CP $FF
 391+ EAAC 28 05            JR Z, .dcRedraw
 392+ EAAE 3A FD 81         LD A, (CompassWobbleCounter)
 393+ EAB1 B7               OR A
 394+ EAB2 C8               RET Z                               ; sin cambios y sin wobble -> nada
 395+ EAB3
 396+ EAB3              .dcRedraw:
 397+ EAB3                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 398+ EAB3 3A F8 81         LD A, (ObjectiveScreenX)
 399+ EAB6 47               LD B, A
 400+ EAB7 3A 1D 82         LD A, (CurrentScreenX)
 401+ EABA 4F               LD C, A
 402+ EABB 78               LD A, B
 403+ EABC 91               SUB C                               ; A = dx (signed)
 404+ EABD                  ; abs(dx) -> H, sign(dx)+1 -> L
 405+ EABD F2 C7 EA         JP P, .dcDxNonNeg
 406+ EAC0 ED 44            NEG
 407+ EAC2 67               LD H, A                             ; abs(dx)
 408+ EAC3 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 409+ EAC5 18 0A            JR .dcDxDone
 410+ EAC7              .dcDxNonNeg:
 411+ EAC7 67               LD H, A
 412+ EAC8 B7               OR A
 413+ EAC9 20 04            JR NZ, .dcDxPositive
 414+ EACB 2E 01            LD L, 1                             ; dx == 0
 415+ EACD 18 02            JR .dcDxDone
 416+ EACF              .dcDxPositive:
 417+ EACF 2E 02            LD L, 2
 418+ EAD1              .dcDxDone:
 419+ EAD1 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 420+ EAD2
 421+ EAD2                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 422+ EAD2 3A F9 81         LD A, (ObjectiveScreenY)
 423+ EAD5 47               LD B, A
 424+ EAD6 3A 1E 82         LD A, (CurrentScreenY)
 425+ EAD9 4F               LD C, A
 426+ EADA 78               LD A, B
 427+ EADB 91               SUB C
 428+ EADC F2 E6 EA         JP P, .dcDyNonNeg
 429+ EADF ED 44            NEG
 430+ EAE1 67               LD H, A
 431+ EAE2 2E 00            LD L, 0
 432+ EAE4 18 0A            JR .dcDyDone
 433+ EAE6              .dcDyNonNeg:
 434+ EAE6 67               LD H, A
 435+ EAE7 B7               OR A
 436+ EAE8 20 04            JR NZ, .dcDyPositive
 437+ EAEA 2E 01            LD L, 1
 438+ EAEC 18 02            JR .dcDyDone
 439+ EAEE              .dcDyPositive:
 440+ EAEE 2E 02            LD L, 2
 441+ EAF0              .dcDyDone:
 442+ EAF0                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 443+ EAF0 D1               POP DE                              ; D = abs_dx, E = signdx+1
 444+ EAF1                  ; idx = (signdy+1)*3 + (signdx+1)
 445+ EAF1 7D               LD A, L
 446+ EAF2 87               ADD A, A
 447+ EAF3 85               ADD A, L                            ; A = (signdy+1)*3
 448+ EAF4 83               ADD A, E                            ; A = idx (0..8)
 449+ EAF5 32 A4 EB         LD (.dcSpriteIdx), A
 450+ EAF8                  ; distance = abs_dx + abs_dy
 451+ EAF8 7A               LD A, D
 452+ EAF9 84               ADD A, H
 453+ EAFA 32 A5 EB         LD (.dcDistance), A
 454+ EAFD
 455+ EAFD                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 456+ EAFD                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 457+ EAFD                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 458+ EAFD                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 459+ EAFD                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 460+ EAFD                  ; nuevo idx.
 461+ EAFD                  ; Counter == 0 -> sin override, idx = target.
 462+ EAFD                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 463+ EAFD                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 464+ EAFD                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 465+ EAFD 3A A4 EB         LD A, (.dcSpriteIdx)
 466+ EB00 FE 04            CP 4
 467+ EB02 20 06            JR NZ, .dcWobbleNotX
 468+ EB04                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 469+ EB04                  ; frame no redibuje innecesariamente.
 470+ EB04 AF               XOR A
 471+ EB05 32 FD 81         LD (CompassWobbleCounter), A
 472+ EB08 18 46            JR .dcWobbleEnd
 473+ EB0A              .dcWobbleNotX:
 474+ EB0A                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 475+ EB0A 3A 1D 82         LD A, (CurrentScreenX)
 476+ EB0D 47               LD B, A
 477+ EB0E 3A FB 81         LD A, (LastCompassScreenX)
 478+ EB11 B8               CP B
 479+ EB12 20 0A            JR NZ, .dcWobbleStart
 480+ EB14 3A 1E 82         LD A, (CurrentScreenY)
 481+ EB17 47               LD B, A
 482+ EB18 3A FC 81         LD A, (LastCompassScreenY)
 483+ EB1B B8               CP B
 484+ EB1C 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 485+ EB1E              .dcWobbleStart:
 486+ EB1E 3E 09            LD A, 9
 487+ EB20 32 FD 81         LD (CompassWobbleCounter), A
 488+ EB23              .dcWobbleResolve:
 489+ EB23 3A FD 81         LD A, (CompassWobbleCounter)
 490+ EB26 B7               OR A
 491+ EB27 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 492+ EB29 3D               DEC A
 493+ EB2A 32 FD 81         LD (CompassWobbleCounter), A
 494+ EB2D                                                      ; A = phase 0..8 (1 frame por fase)
 495+ EB2D 21 F5 EF         LD HL, WobblePhaseTable
 496+ EB30 5F               LD E, A
 497+ EB31 16 00            LD D, 0
 498+ EB33 19               ADD HL, DE
 499+ EB34 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 500+ EB35 FE 02            CP 2
 501+ EB37 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 502+ EB39                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 503+ EB39                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 504+ EB39 FE 03            CP 3
 505+ EB3B 38 01            JR C, .dcWobbleOffsetReady
 506+ EB3D 3D               DEC A
 507+ EB3E              .dcWobbleOffsetReady:
 508+ EB3E 5F               LD E, A
 509+ EB3F 3A A4 EB         LD A, (.dcSpriteIdx)
 510+ EB42 87               ADD A, A                            ; idx*2
 511+ EB43 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 512+ EB44 83               ADD A, E                            ; +offset
 513+ EB45 21 D1 EF         LD HL, CompassWobbleTable
 514+ EB48 5F               LD E, A
 515+ EB49 16 00            LD D, 0
 516+ EB4B 19               ADD HL, DE
 517+ EB4C 7E               LD A, (HL)
 518+ EB4D 32 A4 EB         LD (.dcSpriteIdx), A                ; override
 519+ EB50
 520+ EB50              .dcWobbleEnd:
 521+ EB50
 522+ EB50                  ; --- Color ---
 523+ EB50                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 524+ EB50 3A A4 EB         LD A, (.dcSpriteIdx)
 525+ EB53 FE 04            CP 4
 526+ EB55 28 18            JR Z, .dcWhite
 527+ EB57 3A FA 81         LD A, (PreviousObjectiveDistance)
 528+ EB5A FE FF            CP $FF
 529+ EB5C 28 11            JR Z, .dcWhite
 530+ EB5E 47               LD B, A
 531+ EB5F 3A A5 EB         LD A, (.dcDistance)
 532+ EB62 B8               CP B
 533+ EB63 28 0A            JR Z, .dcWhite                      ; igual = blanco
 534+ EB65 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 535+ EB67 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 536+ EB69 18 06            JR .dcColorDone
 537+ EB6B              .dcGreen:
 538+ EB6B 3E 44            LD A, GREEN | $40
 539+ EB6D 18 02            JR .dcColorDone
 540+ EB6F              .dcWhite:
 541+ EB6F 3E 47            LD A, WHITE | $40
 542+ EB71              .dcColorDone:
 543+ EB71 32 A6 EB         LD (.dcAttr), A
 544+ EB74
 545+ EB74                  ; --- Sprite ptr de CompassSprites[idx] ---
 546+ EB74 3A A4 EB         LD A, (.dcSpriteIdx)
 547+ EB77 87               ADD A, A                            ; *2
 548+ EB78 6F               LD L, A
 549+ EB79 26 00            LD H, 0
 550+ EB7B 11 BF EF         LD DE, CompassSprites
 551+ EB7E 19               ADD HL, DE
 552+ EB7F 5E               LD E, (HL)
 553+ EB80 23               INC HL
 554+ EB81 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 555+ EB82 CD A7 EB         CALL DrawCompassSprite
 556+ EB85
 557+ EB85                  ; --- Attrs ---
 558+ EB85 3A A6 EB         LD A, (.dcAttr)
 559+ EB88 CD CA EB         CALL SetCompassAttrs
 560+ EB8B
 561+ EB8B                  ; --- Cachear estado ---
 562+ EB8B                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 563+ EB8B                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 564+ EB8B                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 565+ EB8B                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 566+ EB8B                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 567+ EB8B                  ; el wobble y la comparacion sigue siendo correcta.
 568+ EB8B 3A FD 81         LD A, (CompassWobbleCounter)
 569+ EB8E B7               OR A
 570+ EB8F 20 06            JR NZ, .dcSkipPrevDistSave
 571+ EB91 3A A5 EB         LD A, (.dcDistance)
 572+ EB94 32 FA 81         LD (PreviousObjectiveDistance), A
 573+ EB97              .dcSkipPrevDistSave:
 574+ EB97 3A 1D 82         LD A, (CurrentScreenX)
 575+ EB9A 32 FB 81         LD (LastCompassScreenX), A
 576+ EB9D 3A 1E 82         LD A, (CurrentScreenY)
 577+ EBA0 32 FC 81         LD (LastCompassScreenY), A
 578+ EBA3 C9               RET
 579+ EBA4
 580+ EBA4 00           .dcSpriteIdx: DEFB 0
 581+ EBA5 00           .dcDistance:  DEFB 0
 582+ EBA6 00           .dcAttr:      DEFB 0
 583+ EBA7
 584+ EBA7              ; ==============================================================================
 585+ EBA7              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 586+ EBA7              ; ==============================================================================
 587+ EBA7              ; IN: DE = ptr a 16 filas x 2 bytes
 588+ EBA7              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 589+ EBA7              ; Destruye: AF, B, HL.
 590+ EBA7              ; ==============================================================================
 591+ EBA7              DrawCompassSprite:
 592+ EBA7                  ; Char row 0 (rows 0-7 del sprite)
 593+ EBA7 26 40            LD H, $40
 594+ EBA9 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 595+ EBAB 06 08            LD B, 8
 596+ EBAD              .dcsRow0:
 597+ EBAD 1A               LD A, (DE)
 598+ EBAE 77               LD (HL), A
 599+ EBAF 13               INC DE
 600+ EBB0 23               INC HL
 601+ EBB1 1A               LD A, (DE)
 602+ EBB2 77               LD (HL), A
 603+ EBB3 13               INC DE
 604+ EBB4 2B               DEC HL
 605+ EBB5 24               INC H
 606+ EBB6 10 F5            DJNZ .dcsRow0
 607+ EBB8                  ; Char row 1 (rows 8-15 del sprite)
 608+ EBB8 26 40            LD H, $40
 609+ EBBA 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 610+ EBBC 06 08            LD B, 8
 611+ EBBE              .dcsRow1:
 612+ EBBE 1A               LD A, (DE)
 613+ EBBF 77               LD (HL), A
 614+ EBC0 13               INC DE
 615+ EBC1 23               INC HL
 616+ EBC2 1A               LD A, (DE)
 617+ EBC3 77               LD (HL), A
 618+ EBC4 13               INC DE
 619+ EBC5 2B               DEC HL
 620+ EBC6 24               INC H
 621+ EBC7 10 F5            DJNZ .dcsRow1
 622+ EBC9 C9               RET
 623+ EBCA
 624+ EBCA              ; ==============================================================================
 625+ EBCA              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 626+ EBCA              ; ==============================================================================
 627+ EBCA              SetCompassAttrs:
 628+ EBCA 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 629+ EBCD 77               LD (HL), A
 630+ EBCE 23               INC HL
 631+ EBCF 77               LD (HL), A
 632+ EBD0 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 633+ EBD3 77               LD (HL), A
 634+ EBD4 23               INC HL
 635+ EBD5 77               LD (HL), A
 636+ EBD6 C9               RET
 637+ EBD7
 638+ EBD7              ; ==============================================================================
 639+ EBD7              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 640+ EBD7              ; ==============================================================================
 641+ EBD7              ClearCompass:
 642+ EBD7 26 40            LD H, $40
 643+ EBD9 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 644+ EBDB 06 08            LD B, 8
 645+ EBDD AF               XOR A
 646+ EBDE              .ccRow0:
 647+ EBDE 77               LD (HL), A
 648+ EBDF 23               INC HL
 649+ EBE0 77               LD (HL), A
 650+ EBE1 2B               DEC HL
 651+ EBE2 24               INC H
 652+ EBE3 10 F9            DJNZ .ccRow0
 653+ EBE5 26 40            LD H, $40
 654+ EBE7 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 655+ EBE9 06 08            LD B, 8
 656+ EBEB AF               XOR A
 657+ EBEC              .ccRow1:
 658+ EBEC 77               LD (HL), A
 659+ EBED 23               INC HL
 660+ EBEE 77               LD (HL), A
 661+ EBEF 2B               DEC HL
 662+ EBF0 24               INC H
 663+ EBF1 10 F9            DJNZ .ccRow1
 664+ EBF3 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 665+ EBF4 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 666+ EBF7 77               LD (HL), A
 667+ EBF8 23               INC HL
 668+ EBF9 77               LD (HL), A
 669+ EBFA 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 670+ EBFD 77               LD (HL), A
 671+ EBFE 23               INC HL
 672+ EBFF 77               LD (HL), A
 673+ EC00 C9               RET
 674+ EC01
 675+ EC01              ; ==============================================================================
 676+ EC01              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 677+ EC01              ; ==============================================================================
 678+ EC01              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 679+ EC01              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 680+ EC01              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 681+ EC01              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 682+ EC01              ; monstruo cae alli con la puerta abierta:
 683+ EC01              ;   - Bit slot en MonsterTrappedFlags
 684+ EC01              ;   - Despawn del monstruo (puff)
 685+ EC01              ;   - Puerta se re-cierra (sprite + flag)
 686+ EC01              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 687+ EC01              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 688+ EC01              ;
 689+ EC01              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 690+ EC01              ; auto-generadas por el level editor segun la posicion de la puerta y los
 691+ EC01              ; markers AltKey1/AltKey2.
 692+ EC01              ; ==============================================================================
 693+ EC01
 694+ EC01              ; ==============================================================================
 695+ EC01              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 696+ EC01              ; ==============================================================================
 697+ EC01              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 698+ EC01              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 699+ EC01              ; Destruye: AF, BC.
 700+ EC01              ; ==============================================================================
 701+ EC01              CheckChurchTrap:
 702+ EC01                  ; --- Solo en pantalla de la iglesia ---
 703+ EC01 3A 1D 82         LD A, (CurrentScreenX)
 704+ EC04 FE 0F            CP CHURCH_TRAP_SCREEN_X
 705+ EC06 20 5D            JR NZ, .cctNoTrap
 706+ EC08 3A 1E 82         LD A, (CurrentScreenY)
 707+ EC0B FE 06            CP CHURCH_TRAP_SCREEN_Y
 708+ EC0D 20 56            JR NZ, .cctNoTrap
 709+ EC0F                  ; --- Solo con la puerta abierta ---
 710+ EC0F 3A F2 81         LD A, (ChurchDoorOpen)
 711+ EC12 B7               OR A
 712+ EC13 28 50            JR Z, .cctNoTrap
 713+ EC15                  ; --- Solo si el knockback es DIRECTO del player ---
 714+ EC15                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 715+ EC15                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 716+ EC15                  ; espada y se clear cuando se hereda kb por colision.
 717+ EC15 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 718+ EC19 28 4A            JR Z, .cctNoTrap
 719+ EC1B                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 720+ EC1B                  ; (acepta sprites de 16, 21 o 24 px de alto)
 721+ EC1B DD 7E 04         LD A, (IX+ENT_POSY)
 722+ EC1E CB 3F            SRL A
 723+ EC20 CB 3F            SRL A
 724+ EC22 CB 3F            SRL A                                   ; A = top charY del monster
 725+ EC24 47               LD B, A
 726+ EC25 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 727+ EC27 90               SUB B                                   ; A = trap_charY - mon_charY
 728+ EC28 FE 03            CP 3
 729+ EC2A 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 730+ EC2C                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 731+ EC2C DD 7E 03         LD A, (IX+ENT_POSX)
 732+ EC2F CB 3F            SRL A
 733+ EC31 CB 3F            SRL A
 734+ EC33 CB 3F            SRL A
 735+ EC35 47               LD B, A                                 ; B = left charX del monster
 736+ EC36 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 737+ EC38 3C               INC A                                   ; A = LO_X + 1
 738+ EC39 90               SUB B                                   ; A = LO_X+1 - charX
 739+ EC3A FE 03            CP 3
 740+ EC3C 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 741+ EC3E                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 742+ EC3E                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 743+ EC3E DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 744+ EC41 D6 4C            SUB SPRID_MONSTER_0
 745+ EC43 CB 3F            SRL A
 746+ EC45 CB 3F            SRL A
 747+ EC47 CB 3F            SRL A                                   ; A = type idx 0..2
 748+ EC49 47               LD B, A
 749+ EC4A                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 750+ EC4A 3A FF 81         LD A, (NextChurchTrapStep)
 751+ EC4D FE 03            CP 3
 752+ EC4F 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 753+ EC51 21 67 EC         LD HL, ChurchTrapOrderTable
 754+ EC54 5F               LD E, A
 755+ EC55 16 00            LD D, 0
 756+ EC57 19               ADD HL, DE
 757+ EC58 7E               LD A, (HL)                              ; A = type esperado
 758+ EC59 B8               CP B
 759+ EC5A 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 760+ EC5C                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 761+ EC5C CD FF EC         CALL TriggerChurchTrap
 762+ EC5F 3E 01            LD A, 1
 763+ EC61 C9               RET
 764+ EC62              .cctBlockAsWall:
 765+ EC62                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 766+ EC62                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 767+ EC62 3E 02            LD A, 2
 768+ EC64 C9               RET
 769+ EC65              .cctNoTrap:
 770+ EC65 AF               XOR A
 771+ EC66 C9               RET
 772+ EC67
 773+ EC67              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 774+ EC67              ChurchTrapOrderTable:
 775+ EC67 00 02 01         DEFB 0, 2, 1
 776+ EC6A
 777+ EC6A              ; ==============================================================================
 778+ EC6A              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 779+ EC6A              ; blanco brillante sobre paper negro ($47).
 780+ EC6A              ; ==============================================================================
 781+ EC6A              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 782+ EC6A              ; - No-op fuera de la sala de la iglesia.
 783+ EC6A              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 784+ EC6A              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 785+ EC6A              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 786+ EC6A              ;   aun no toca) conservan sus attrs originales del sprite.
 787+ EC6A              ; Destruye: AF, BC, DE, HL.
 788+ EC6A              ; ==============================================================================
 789+ EC6A              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 790+ EC6A              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 791+ EC6A              HighlightExpectedStatue:
 792+ EC6A 3E 47            LD A, $47
 793+ EC6C 18 00            JR PaintExpectedStatueAttr
 794+ EC6E
 795+ EC6E              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 796+ EC6E              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 797+ EC6E              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 798+ EC6E              PaintExpectedStatueAttr:
 799+ EC6E 32 D8 EC         LD (.hesAttr), A
 800+ EC71                  ; --- Solo en la sala de la iglesia ---
 801+ EC71 3A 1D 82         LD A, (CurrentScreenX)
 802+ EC74 FE 0F            CP CHURCH_TRAP_SCREEN_X
 803+ EC76 C0               RET NZ
 804+ EC77 3A 1E 82         LD A, (CurrentScreenY)
 805+ EC7A FE 06            CP CHURCH_TRAP_SCREEN_Y
 806+ EC7C C0               RET NZ
 807+ EC7D                  ; --- Solo tras abrir la iglesia 1a vez ---
 808+ EC7D                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 809+ EC7D                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 810+ EC7D                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 811+ EC7D                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 812+ EC7D                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 813+ EC7D 3A F3 81         LD A, (ChurchEverOpened)
 814+ EC80 B7               OR A
 815+ EC81 C8               RET Z
 816+ EC82                  ; --- Solo si quedan monstruos por atrapar ---
 817+ EC82 3A FF 81         LD A, (NextChurchTrapStep)
 818+ EC85 FE 03            CP 3
 819+ EC87 D0               RET NC
 820+ EC88                  ; --- Type esperado -> statue id ---
 821+ EC88 21 67 EC         LD HL, ChurchTrapOrderTable
 822+ EC8B 5F               LD E, A
 823+ EC8C 16 00            LD D, 0
 824+ EC8E 19               ADD HL, DE
 825+ EC8F 7E               LD A, (HL)                              ; type idx esperado
 826+ EC90 21 34 67         LD HL, StatueIdTable
 827+ EC93 5F               LD E, A
 828+ EC94 16 00            LD D, 0
 829+ EC96 19               ADD HL, DE
 830+ EC97 7E               LD A, (HL)                              ; A = statue id
 831+ EC98 B7               OR A
 832+ EC99 C8               RET Z
 833+ EC9A 32 D9 EC         LD (.hesTargetId), A
 834+ EC9D                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 835+ EC9D 2A 1F 82         LD HL, (CurrentScreenAddr)
 836+ ECA0              .hesLoop:
 837+ ECA0 7E               LD A, (HL)
 838+ ECA1 FE FF            CP $FF
 839+ ECA3 C8               RET Z                                   ; estatua no en esta sala
 840+ ECA4 47               LD B, A
 841+ ECA5 3A D9 EC         LD A, (.hesTargetId)
 842+ ECA8 B8               CP B
 843+ ECA9 28 06            JR Z, .hesFound
 844+ ECAB 11 04 00         LD DE, 4
 845+ ECAE 19               ADD HL, DE
 846+ ECAF 18 EF            JR .hesLoop
 847+ ECB1              .hesFound:
 848+ ECB1 23               INC HL
 849+ ECB2 7E               LD A, (HL)                              ; charX
 850+ ECB3 47               LD B, A
 851+ ECB4 23               INC HL
 852+ ECB5 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 853+ ECB6 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 854+ ECB8 4F               LD C, A                                 ; C = charY (post-HUD)
 855+ ECB9                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 856+ ECB9 26 00            LD H, 0
 857+ ECBB 69               LD L, C
 858+ ECBC 29               ADD HL, HL
 859+ ECBD 29               ADD HL, HL
 860+ ECBE 29               ADD HL, HL
 861+ ECBF 29               ADD HL, HL
 862+ ECC0 29               ADD HL, HL                              ; HL = charY * 32
 863+ ECC1 58               LD E, B
 864+ ECC2 16 00            LD D, 0
 865+ ECC4 19               ADD HL, DE                              ; + charX
 866+ ECC5 11 00 58         LD DE, $5800
 867+ ECC8 19               ADD HL, DE                              ; HL = attr addr top-left
 868+ ECC9                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 869+ ECC9                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 870+ ECC9                  ; no hace falta sincronizar CleanAttrMap.
 871+ ECC9 3A D8 EC         LD A, (.hesAttr)
 872+ ECCC 06 03            LD B, 3                                 ; 3 filas de chars
 873+ ECCE              .hesRow:
 874+ ECCE 77               LD (HL), A
 875+ ECCF 23               INC HL
 876+ ECD0 77               LD (HL), A                              ; (charX+1)
 877+ ECD1 11 1F 00         LD DE, 31
 878+ ECD4 19               ADD HL, DE                              ; siguiente fila col 0
 879+ ECD5 10 F7            DJNZ .hesRow
 880+ ECD7 C9               RET
 881+ ECD8 00           .hesAttr:     DEFB 0
 882+ ECD9 00           .hesTargetId: DEFB 0
 883+ ECDA
 884+ ECDA              ; ==============================================================================
 885+ ECDA              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 886+ ECDA              ; ==============================================================================
 887+ ECDA              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 888+ ECDA              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 889+ ECDA              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 890+ ECDA              ; + ON final settle): 8 ciclos de ON-OFF en total.
 891+ ECDA              ; ==============================================================================
 892+ ECDA              STATUE_BLINK_FRAMES   EQU 32
 893+ ECDA
 894+ ECDA              StartStatueBlink:
 895+ ECDA                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 896+ ECDA                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 897+ ECDA                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 898+ ECDA                  ; (caso A), .cbtActChurchDoor (caso B).
 899+ ECDA 3E 20            LD A, STATUE_BLINK_FRAMES
 900+ ECDC 32 00 82         LD (StatueBlinkCounter), A
 901+ ECDF C3 6A EC         JP HighlightExpectedStatue              ; initial ON paint
 902+ ECE2
 903+ ECE2              UpdateStatueBlink:
 904+ ECE2                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 905+ ECE2 3A 00 82         LD A, (StatueBlinkCounter)
 906+ ECE5 B7               OR A
 907+ ECE6 C8               RET Z
 908+ ECE7 3D               DEC A
 909+ ECE8 32 00 82         LD (StatueBlinkCounter), A
 910+ ECEB 20 03            JR NZ, .usbInProgress
 911+ ECED                  ; Counter recien llego a 0: settle ON
 912+ ECED C3 6A EC         JP HighlightExpectedStatue
 913+ ECF0              .usbInProgress:
 914+ ECF0                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 915+ ECF0                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 916+ ECF0 CB 3F            SRL A
 917+ ECF2 E6 01            AND $01
 918+ ECF4 28 05            JR Z, .usbOff
 919+ ECF6 3E 47            LD A, $47
 920+ ECF8 C3 6E EC         JP PaintExpectedStatueAttr
 921+ ECFB              .usbOff:
 922+ ECFB AF               XOR A
 923+ ECFC C3 6E EC         JP PaintExpectedStatueAttr
 924+ ECFF
 925+ ECFF              ; ==============================================================================
 926+ ECFF              ; CUTSCENE - parametros ajustables
 927+ ECFF              ; ==============================================================================
 928+ ECFF              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 929+ ECFF              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 930+ ECFF              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 931+ ECFF              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 932+ ECFF
 933+ ECFF              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 934+ ECFF              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 935+ ECFF              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 936+ ECFF
 937+ ECFF              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
 938+ ECFF              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
 939+ ECFF              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
 940+ ECFF              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
 941+ ECFF              ;   tick 12 -> erase smoke[2], pasar a DONE
 942+ ECFF              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
 943+ ECFF              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
 944+ ECFF
 945+ ECFF              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
 946+ ECFF              ; base del vano (auto-derivada por el editor). El monster (3 chars de
 947+ ECFF              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
 948+ ECFF              ; centrado dentro del vano de la puerta.
 949+ ECFF              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
 950+ ECFF              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
 951+ ECFF              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
 952+ ECFF              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
 953+ ECFF
 954+ ECFF              ; ==============================================================================
 955+ ECFF              ; TriggerChurchTrap - arranca la cutscene de la iglesia
 956+ ECFF              ; ==============================================================================
 957+ ECFF              ; IN: IX = monster atrapado.
 958+ ECFF              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
 959+ ECFF              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
 960+ ECFF              ; en ApplyChurchTrapEffects al final del cutscene.
 961+ ECFF              ; ==============================================================================
 962+ ECFF              TriggerChurchTrap:
 963+ ECFF                  ; --- 1. Calcular slot 0..2 ---
 964+ ECFF DD E5            PUSH IX
 965+ ED01 E1               POP HL
 966+ ED02 11 EC 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 967+ ED05 B7               OR A
 968+ ED06 ED 52            SBC HL, DE
 969+ ED08 CB 3D            SRL L
 970+ ED0A CB 3D            SRL L
 971+ ED0C CB 3D            SRL L
 972+ ED0E CB 3D            SRL L                                   ; L = slot 0..2
 973+ ED10 7D               LD A, L
 974+ ED11 32 9E 5F         LD (ChurchCutsceneSlot), A
 975+ ED14                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
 976+ ED14 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 977+ ED17 D6 4C            SUB SPRID_MONSTER_0
 978+ ED19 CB 3F            SRL A
 979+ ED1B CB 3F            SRL A
 980+ ED1D CB 3F            SRL A                                   ; A = type idx
 981+ ED1F 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
 982+ ED22                  ; --- 2. Mover monster al centro del vano ---
 983+ ED22 3E 78            LD A, CHURCH_TRAP_AREA_POSX
 984+ ED24 DD 77 03         LD (IX+ENT_POSX), A
 985+ ED27 3E 58            LD A, CHURCH_TRAP_AREA_POSY
 986+ ED29 DD 77 04         LD (IX+ENT_POSY), A
 987+ ED2C DD 36 06 00      LD (IX+ENT_DELTAX), 0
 988+ ED30 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 989+ ED34 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
 990+ ED38                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
 991+ ED38                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
 992+ ED38                  ; del shake y del humo se renderizarian invisibles (ink black sobre
 993+ ED38                  ; paper black). Forzando ON aqui garantizamos que la animacion de
 994+ ED38                  ; temblor se vea con ink blanco brillante sobre paper negro.
 995+ ED38 AF               XOR A
 996+ ED39 32 00 82         LD (StatueBlinkCounter), A              ; parar blink
 997+ ED3C DD E5            PUSH IX
 998+ ED3E CD 6A EC         CALL HighlightExpectedStatue            ; pintar $47
 999+ ED41 DD E1            POP IX
1000+ ED43                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1001+ ED43 3E 01            LD A, 1
1002+ ED45 32 03 82         LD (ChurchCutscenePhase), A
1003+ ED48 AF               XOR A
1004+ ED49 32 9D 5F         LD (ChurchCutsceneFrame), A
1005+ ED4C 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1006+ ED4E 32 A4 5F         LD (ChurchCutsceneLookCount), A
1007+ ED51 C9               RET
1008+ ED52
1009+ ED52              ; ==============================================================================
1010+ ED52              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1011+ ED52              ; ==============================================================================
1012+ ED52              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1013+ ED52              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1014+ ED52              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1015+ ED52              ; ==============================================================================
1016+ ED52              UpdateChurchCutscene:
1017+ ED52 3A 03 82         LD A, (ChurchCutscenePhase)
1018+ ED55 B7               OR A
1019+ ED56 C8               RET Z
1020+ ED57 3D               DEC A
1021+ ED58 28 12            JR Z, .ucsLookPhase
1022+ ED5A 3D               DEC A
1023+ ED5B 28 38            JR Z, .ucsShakeStatuePhase
1024+ ED5D 3D               DEC A
1025+ ED5E CA E7 ED         JP Z, .ucsSmokePhase
1026+ ED61                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1027+ ED61 CD B7 66         CALL ApplyChurchTrapDone
1028+ ED64 AF               XOR A
1029+ ED65 32 03 82         LD (ChurchCutscenePhase), A
1030+ ED68 32 9D 5F         LD (ChurchCutsceneFrame), A
1031+ ED6B C9               RET
1032+ ED6C
1033+ ED6C              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1034+ ED6C              .ucsLookPhase:
1035+ ED6C                  ; Frame counter (para detectar fin de fase)
1036+ ED6C 21 9D 5F         LD HL, ChurchCutsceneFrame
1037+ ED6F 34               INC (HL)
1038+ ED70                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1039+ ED70 21 A4 5F         LD HL, ChurchCutsceneLookCount
1040+ ED73 35               DEC (HL)
1041+ ED74 20 06            JR NZ, .ucsLookCheckEnd
1042+ ED76 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1043+ ED78 77               LD (HL), A
1044+ ED79 CD 35 EE         CALL ChurchCutsceneToggleMonsterDir
1045+ ED7C              .ucsLookCheckEnd:
1046+ ED7C 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1047+ ED7F FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1048+ ED81 D8               RET C                                   ; sigue mirando
1049+ ED82                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1050+ ED82                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1051+ ED82                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1052+ ED82 CD 93 66         CALL EraseChurchTrappedMonster
1053+ ED85 CD 2A 69         CALL CloseChurchDoor
