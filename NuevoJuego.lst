1129+ A51C              ; ==============================================================================
1130+ A51C              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A51C              ; ==============================================================================
1132+ A51C              ; Entrada: A = SpriteID
1133+ A51C              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A51C              ; Destruye: A, DE, HL
1135+ A51C              ; ==============================================================================
1136+ A51C              GetSpriteDims:
1137+ A51C                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A51C                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A51C 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A51D 26 00            LD H, 0
1141+ A51F 3A 7B 8D         LD A, (CurrentPaging)
1142+ A522 E6 F8            AND $F8
1143+ A524 F6 06            OR 6
1144+ A526 32 7B 8D         LD (CurrentPaging), A
1145+ A529 01 FD 7F         LD BC, $7FFD
1146+ A52C ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A52E 29               ADD HL, HL
1148+ A52F 11 B7 E7         LD DE, SpriteFrameTable
1149+ A532 19               ADD HL, DE
1150+ A533 5E               LD E, (HL)
1151+ A534 23               INC HL
1152+ A535 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A536 1A               LD A, (DE)                  ; width_bytes
1154+ A537 87               ADD A, A
1155+ A538 87               ADD A, A
1156+ A539 87               ADD A, A                    ; × 8 = width_px
1157+ A53A 47               LD B, A
1158+ A53B 13               INC DE
1159+ A53C 1A               LD A, (DE)                  ; height_px
1160+ A53D 4F               LD C, A
1161+ A53E                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A53E 78               LD A, B
1163+ A53F 32 5C A5         LD (GsdSavedB), A
1164+ A542 79               LD A, C
1165+ A543 32 5D A5         LD (GsdSavedC), A
1166+ A546 3A 7B 8D         LD A, (CurrentPaging)
1167+ A549 E6 F8            AND $F8
1168+ A54B 32 7B 8D         LD (CurrentPaging), A
1169+ A54E 01 FD 7F         LD BC, $7FFD
1170+ A551 ED 79            OUT (C), A                  ; bank 0 de vuelta
1171+ A553 3A 5C A5         LD A, (GsdSavedB)
1172+ A556 47               LD B, A
1173+ A557 3A 5D A5         LD A, (GsdSavedC)
1174+ A55A 4F               LD C, A
