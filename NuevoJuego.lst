 245+ 67F2              ; ==============================================================================
 246+ 67F2              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 247+ 67F2              ; ==============================================================================
 248+ 67F2              ; IN: A = frame idx (0..2)
 249+ 67F2              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 250+ 67F2              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 251+ 67F2              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 252+ 67F2              ; Destruye: AF, BC, DE, HL, IX.
 253+ 67F2              ; ==============================================================================
 254+ 67F2              DrawSmokeFrameXor:
 255+ 67F2 87               ADD A, A                                ; *2 (entries de 2 bytes)
 256+ 67F3 6F               LD L, A
 257+ 67F4 26 00            LD H, 0
 258+ 67F6 11 EC 67         LD DE, SmokeFramePtrTable
 259+ 67F9 19               ADD HL, DE
 260+ 67FA 5E               LD E, (HL)
 261+ 67FB 23               INC HL
 262+ 67FC 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 263+ 67FD                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 264+ 67FD                  ; Source y destino accesibles sin paging (milestones bank 0,
 265+ 67FD                  ; BgSpriteBuffer en RAM principal).
 266+ 67FD EB               EX DE, HL                               ; HL = source
 267+ 67FE 11 9B 89         LD DE, BgSpriteBuffer
 268+ 6801 01 22 00         LD BC, 34
 269+ 6804 ED B0            LDIR
 270+ 6806                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 271+ 6806 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 272+ 6809 57               LD D, A
 273+ 680A 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 274+ 680D 5F               LD E, A
 275+ 680E C3 04 69         JP DrawBgSprite16XorAtPixel
