 546+ 6EFE ~
 547+ 6EFE ~            .cmcpGapLoop:
 548+ 6EFE ~                ; Read side_comp byte
 549+ 6EFE ~                LD A, (HL)
 550+ 6EFE ~                LD (.cmcpGapSideComp), A
 551+ 6EFE ~                INC HL
 552+ 6EFE ~                LD A, (HL)
 553+ 6EFE ~                LD (.cmcpGapCoord), A
 554+ 6EFE ~                INC HL
