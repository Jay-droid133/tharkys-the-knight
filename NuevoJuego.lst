 154+ EF0C              ; ==============================================================================
 155+ EF0C              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 156+ EF0C              ; ==============================================================================
 157+ EF0C              CheckMilestoneDebugKey:
 158+ EF0C 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 159+ EF0E DB FE            IN A, ($FE)
 160+ EF10 CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 161+ EF12 20 23            JR NZ, .cmdkNotPressed
 162+ EF14 3A 3C EF         LD A, (MilestoneKeyDebounce)
 163+ EF17 B7               OR A
 164+ EF18 C0               RET NZ
 165+ EF19 3E 01            LD A, 1
 166+ EF1B 32 3C EF         LD (MilestoneKeyDebounce), A
 167+ EF1E 3A BA 82         LD A, (CurrentObjective)
 168+ EF21 FE 0B            CP 11
 169+ EF23 D0               RET NC
 170+ EF24 3C               INC A
 171+ EF25 32 BA 82         LD (CurrentObjective), A
 172+ EF28 CD 62 EF         CALL ResolveObjectiveScreen
 173+ EF2B 3E FF            LD A, $FF
 174+ EF2D 32 BD 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 175+ EF30 CD 39 76         CALL CancelMagicCompass             ; magic compass normal: cancela al saltar hito
 176+ EF33 CD 69 76         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 177+ EF36 C9               RET
 178+ EF37              .cmdkNotPressed:
 179+ EF37 AF               XOR A
 180+ EF38 32 3C EF         LD (MilestoneKeyDebounce), A
 181+ EF3B C9               RET
 182+ EF3C
 183+ EF3C 00           MilestoneKeyDebounce: DEFB 0
 184+ EF3D
 185+ EF3D              ; ==============================================================================
 186+ EF3D              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->7->0 (debug)
 187+ EF3D              ; ==============================================================================
 188+ EF3D              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 189+ EF3D              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 190+ EF3D              ; inmediato del valor actual.
 191+ EF3D              ;
 192+ EF3D              ; Rango: 1..6 son keys clasicas (forest/ruins/cemetery/clock/church/towngate),
 193+ EF3D              ; 7 es BankCheck (cheque del banco, slot 7 en KeyLockTable). Util para
 194+ EF3D              ; probar el bump trigger del banco sin tener que completar M7 antes.
 195+ EF3D              ;
 196+ EF3D              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 197+ EF3D              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 198+ EF3D              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 199+ EF3D              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 200+ EF3D              ; ==============================================================================
 201+ EF3D              CheckCurrentKeyCycleKey:
 202+ EF3D 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 203+ EF3F DB FE            IN A, ($FE)
 204+ EF41 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 205+ EF43 20 17            JR NZ, .ckcNotPressed
 206+ EF45 3A 61 EF         LD A, (CurrentKeyCycleDebounce)
 207+ EF48 B7               OR A
 208+ EF49 C0               RET NZ
 209+ EF4A 3E 01            LD A, 1
 210+ EF4C 32 61 EF         LD (CurrentKeyCycleDebounce), A
 211+ EF4F 3A B1 82         LD A, (CurrentKey)
 212+ EF52 3C               INC A
 213+ EF53 FE 08            CP 8
 214+ EF55 38 01            JR C, .ckcSet                       ; 1..7 dentro de rango (7 = BankCheck)
 215+ EF57 AF               XOR A                               ; 8 -> wrap a 0
 216+ EF58              .ckcSet:
 217+ EF58 32 B1 82         LD (CurrentKey), A
 218+ EF5B C9               RET
 219+ EF5C              .ckcNotPressed:
 220+ EF5C AF               XOR A
 221+ EF5D 32 61 EF         LD (CurrentKeyCycleDebounce), A
 222+ EF60 C9               RET
 223+ EF61
 224+ EF61 00           CurrentKeyCycleDebounce: DEFB 0
 225+ EF62
 226+ EF62              ; ==============================================================================
 227+ EF62              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ EF62              ; ==============================================================================
 229+ EF62              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ EF62              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ EF62              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ EF62              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ EF62              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ EF62              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ EF62              ;               actuales; queda como salvaguarda.
 236+ EF62              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ EF62              ; Destruye: AF, BC, DE, HL.
 238+ EF62              ; ==============================================================================
 239+ EF62              ResolveObjectiveScreen:
 240+ EF62 3A BA 82         LD A, (CurrentObjective)
 241+ EF65 FE 0B            CP 11
 242+ EF67 30 4D            JR NC, .rosNoTarget
 243+ EF69 87               ADD A, A
 244+ EF6A 6F               LD L, A
 245+ EF6B 26 00            LD H, 0
 246+ EF6D 11 86 EE         LD DE, MilestoneResolveTable
 247+ EF70 19               ADD HL, DE
 248+ EF71 7E               LD A, (HL)                          ; tipo
 249+ EF72 23               INC HL
 250+ EF73 46               LD B, (HL)                          ; B = ref
 251+ EF74 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ EF76 28 06            JR Z, .rosPickup
 253+ EF78 FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ EF7A 28 08            JR Z, .rosTrigger
 255+ EF7C 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ EF7E              .rosPickup:
 257+ EF7E 78               LD A, B
 258+ EF7F CD BF EF         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ EF82 18 10            JR .rosFindPos
 260+ EF84              .rosTrigger:
 261+ EF84 78               LD A, B
 262+ EF85 FE 04            CP 4
 263+ EF87 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ EF89 FE 03            CP 3
 265+ EF8B 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ EF8D                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ EF8D                                                      ;  Necesario para que la lasting compass tras
 268+ EF8D                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ EF8D CD CC EF         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ EF90 7A               LD A, D
 271+ EF91 B3               OR E
 272+ EF92 28 22            JR Z, .rosNoTarget
 273+ EF94              .rosFindPos:
 274+ EF94 CD E7 EF         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ EF97 78               LD A, B
 276+ EF98 32 BB 82         LD (ObjectiveScreenX), A
 277+ EF9B 79               LD A, C
 278+ EF9C 32 BC 82         LD (ObjectiveScreenY), A
 279+ EF9F C9               RET
 280+ EFA0              .rosBankRoom:
 281+ EFA0                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ EFA0                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ EFA0 3E 08            LD A, BCS_BANK_ROOM_X
 284+ EFA2 32 BB 82         LD (ObjectiveScreenX), A
 285+ EFA5 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ EFA7 32 BC 82         LD (ObjectiveScreenY), A
 287+ EFAA C9               RET
 288+ EFAB              .rosTownGateRoom:
 289+ EFAB                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ EFAB                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ EFAB                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ EFAB 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ EFAD 32 BB 82         LD (ObjectiveScreenX), A
 294+ EFB0 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ EFB2 32 BC 82         LD (ObjectiveScreenY), A
 296+ EFB5 C9               RET
 297+ EFB6              .rosNoTarget:
 298+ EFB6 3E FF            LD A, $FF
 299+ EFB8 32 BB 82         LD (ObjectiveScreenX), A
 300+ EFBB 32 BC 82         LD (ObjectiveScreenY), A
 301+ EFBE C9               RET
 302+ EFBF
 303+ EFBF              ; ==============================================================================
 304+ EFBF              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ EFBF              ; ==============================================================================
 306+ EFBF              ; IN:  A = key id (1..6)
 307+ EFBF              ; OUT: DE = ptr
 308+ EFBF              ; Destruye: AF, HL.
 309+ EFBF              ; ==============================================================================
 310+ EFBF              KeyIdToPtr:
 311+ EFBF 3D               DEC A
 312+ EFC0 87               ADD A, A                            ; *2 (DEFW size)
 313+ EFC1 6F               LD L, A
 314+ EFC2 26 00            LD H, 0
 315+ EFC4 11 4F D7         LD DE, KeyLockTable
 316+ EFC7 19               ADD HL, DE
 317+ EFC8 5E               LD E, (HL)
 318+ EFC9 23               INC HL
 319+ EFCA 56               LD D, (HL)
 320+ EFCB C9               RET
