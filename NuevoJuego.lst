1112+ F4F5              .ucsShakeJitterTable:
1113+ F4F5 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1114+ F4F9              .ucsShakeStatueDone:
1115+ F4F9                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1116+ F4F9 AF               XOR A
1117+ F4FA D3 FE            OUT (254), A
1118+ F4FC                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1119+ F4FC                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1120+ F4FC                  ; directo a 0 garantiza que no queden residuos.)
1121+ F4FC CD 57 F6         CALL ChurchCutsceneEraseStatueDirect
1122+ F4FF 21 C5 F8         LD HL, SFX_EnemyDeath
1123+ F502 CD 46 F8         CALL PlaySFX
1124+ F505 3E 03            LD A, 3
1125+ F507 32 66 82         LD (ChurchCutscenePhase), A
1126+ F50A AF               XOR A
1127+ F50B 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1128+ F50E C9               RET
1129+ F50F
1130+ F50F              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1131+ F50F              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1132+ F50F              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1133+ F50F              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1134+ F50F              ; Entre transiciones, solo incrementa frame counter.
1135+ F50F              .ucsSmokePhase:
1136+ F50F 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1137+ F512 B7               OR A
1138+ F513 28 0E            JR Z, .ucsSmokeEntry
1139+ F515 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1140+ F517 28 16            JR Z, .ucsSmokeStep1
1141+ F519 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1142+ F51B 28 1D            JR Z, .ucsSmokeStep2
1143+ F51D FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1144+ F51F 28 25            JR Z, .ucsSmokeEnd
1145+ F521 18 35            JR .ucsSmokeIncFrame
1146+ F523              .ucsSmokeEntry:
1147+ F523                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1148+ F523 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1149+ F526 CD 8C 68         CALL DrawRemainsForType
1150+ F529                  ; Dibujar smoke[0] (XOR)
1151+ F529 AF               XOR A
1152+ F52A CD D7 67         CALL DrawSmokeFrameXor
1153+ F52D 18 29            JR .ucsSmokeIncFrame
1154+ F52F              .ucsSmokeStep1:
1155+ F52F AF               XOR A
1156+ F530 CD D7 67         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1157+ F533 3E 01            LD A, 1
1158+ F535 CD D7 67         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1159+ F538 18 1E            JR .ucsSmokeIncFrame
1160+ F53A              .ucsSmokeStep2:
1161+ F53A 3E 01            LD A, 1
1162+ F53C CD D7 67         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1163+ F53F 3E 02            LD A, 2
1164+ F541 CD D7 67         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1165+ F544 18 12            JR .ucsSmokeIncFrame
1166+ F546              .ucsSmokeEnd:
1167+ F546 3E 02            LD A, 2
1168+ F548 CD D7 67         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1169+ F54B CD F6 67         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1170+ F54E 3E 04            LD A, 4
1171+ F550 32 66 82         LD (ChurchCutscenePhase), A
1172+ F553 AF               XOR A
1173+ F554 32 9D 5F         LD (ChurchCutsceneFrame), A
1174+ F557 C9               RET
1175+ F558              .ucsSmokeIncFrame:
1176+ F558 21 9D 5F         LD HL, ChurchCutsceneFrame
1177+ F55B 34               INC (HL)
1178+ F55C C9               RET
