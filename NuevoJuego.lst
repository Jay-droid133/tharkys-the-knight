 148+ 67C9              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 149+ 67C9              ; ==============================================================================
 150+ 67C9              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 151+ 67C9              ;      A  = bank (0-7) donde vive el sprite
 152+ 67C9              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 153+ 67C9              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 154+ 67C9              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 155+ 67C9              ;
 156+ 67C9              ; Mismo patron que LoadRoomToBuffer: inline page switch + SP alterno (slot 1)
 157+ 67C9              ; durante la copia. IRQs siguen procesandose normalmente -> tick de musica
 158+ 67C9              ; no se desfasa durante DrawScreen. Sin DI/EI internos.
 159+ 67C9              ;
 160+ 67C9              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 161+ 67C9              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 162+ 67C9              ; ==============================================================================
 163+ 67C9              LoadBgSpriteToBuffer:
 164+ 67C9                  ; Mismo patron que LoadRoomToBuffer: SP -> alterno antes del page switch
 165+ 67C9                  ; para que las IRQs durante la copia no corrompan el stack normal (que
 166+ 67C9                  ; queda fisicamente "oculto" mientras slot 3 = bank de sprite).
 167+ 67C9 32 5B 68         LD (.lbsBankSave), A
 168+ 67CC                  ; Preservar BC del caller (DrawScreen usa B=x_char, C=y_char) ANTES de
 169+ 67CC                  ; cambiar SP — el PUSH va al stack normal. El LD SP siguiente preserva
 170+ 67CC                  ; ese frame; al restaurar SP el POP BC final lo recupera.
 171+ 67CC C5               PUSH BC
 172+ 67CD ED 73 5C 68      LD (.lbsSavedSP), SP            ; salva SP normal (con PC + BC pushed)
 173+ 67D1 31 D5 68         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
 174+ 67D4                  ; Page bank deseado inline (SIN DI)
 175+ 67D4 3A 8A 8D         LD A, (CurrentPaging)
 176+ 67D7 E6 F8            AND $F8
 177+ 67D9 47               LD B, A                         ; B = paging limpio sin bank
 178+ 67DA 3A 5B 68         LD A, (.lbsBankSave)
 179+ 67DD E6 07            AND $07                         ; safety: solo bits 0-2
 180+ 67DF B0               OR B                            ; merge bank en paging
 181+ 67E0 32 8A 8D         LD (CurrentPaging), A
 182+ 67E3 01 FD 7F         LD BC, $7FFD
