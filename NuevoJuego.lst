 282+ 7403              ; ==============================================================================
 283+ 7403              ; PaintMagicCompassAttrs - Pinta los 4 chars del HUD compass en modo magic
 284+ 7403              ; ==============================================================================
 285+ 7403              ; Color base lo decide el editor (sprite id 36, attrBytes). El runtime lo
 286+ 7403              ; lee de MagicCompassBaseAttrs (auto-importado por import_magic_compass_hud.py
 287+ 7403              ; con bit 6 BRIGHT clearado) y aplica BRIGHT solo al char correspondiente
 288+ 7403              ; a la PathDir. Durante los últimos 5 s ese bright parpadea on/off a ~6 Hz.
 289+ 7403              ;
 290+ 7403              ; Mapping diagonal de las 4 esquinas del 2x2:
 291+ 7403              ;   col1   col2
 292+ 7403              ;     W      N    (row 1, top)     ← idx 0 (1,1) | idx 1 (2,1)
 293+ 7403              ;     S      E    (row 2, bottom)  ← idx 2 (1,2) | idx 3 (2,2)
 294+ 7403              ;
 295+ 7403              ;   PathDir 0 (N) → idx 1 → offset +1
 296+ 7403              ;   PathDir 1 (S) → idx 2 → offset +$20
 297+ 7403              ;   PathDir 2 (W) → idx 0 → offset +0
 298+ 7403              ;   PathDir 3 (E) → idx 3 → offset +$21
 299+ 7403              ;
 300+ 7403              ; Destruye: AF, BC, DE, HL.
 301+ 7403              ; ==============================================================================
 302+ 7403              PaintMagicCompassAttrs:
 303+ 7403                  ; Pintar 4 chars con MagicCompassBaseAttrs (orden: 1,1 / 2,1 / 1,2 / 2,2)
 304+ 7403 11 3B 77         LD DE, MagicCompassBaseAttrs
 305+ 7406 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 306+ 7409 1A               LD A, (DE)
 307+ 740A 77               LD (HL), A
 308+ 740B 23               INC HL
 309+ 740C 13               INC DE
 310+ 740D 1A               LD A, (DE)
 311+ 740E 77               LD (HL), A
 312+ 740F 13               INC DE
 313+ 7410 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 314+ 7413 1A               LD A, (DE)
 315+ 7414 77               LD (HL), A
 316+ 7415 23               INC HL
 317+ 7416 13               INC DE
 318+ 7417 1A               LD A, (DE)
 319+ 7418 77               LD (HL), A
 320+ 7419
 321+ 7419                  ; Si sin path no hay char activo: solo base attrs (ya pintados).
 322+ 7419 3A C1 5F         LD A, (MagicCompassPathDir)
 323+ 741C FE FF            CP $FF
 324+ 741E C8               RET Z
 325+ 741F
 326+ 741F                  ; Si el tick no está sonando, char activo se queda con base attr.
 327+ 741F                  ; Eso da el efecto visual "OFF" entre pitidos.
 328+ 741F 3A C3 5F         LD A, (MagicCompassTickActiveFrames)
 329+ 7422 B7               OR A
 330+ 7423 C8               RET Z
