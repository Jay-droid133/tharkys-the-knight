 195+ 9AA7              .shiftedByte:
 196+ 9AA7                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AA7 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AA8 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AA9 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AAA AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AAB 77               LD (HL), A                  ; Escribir
 202+ 9AAC 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AAD 04               INC B                       ; Pagina overflow
 204+ 9AAE 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AAF AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AB0 77               LD (HL), A                  ; Escribir
 207+ 9AB1 05               DEC B                       ; Restaurar pagina high
 208+ 9AB2 13               INC DE                      ; Siguiente byte de sprite
 209+ 9AB3                  ; Siguiente byte de ancho
 210+ 9AB3 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9AB5 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9AB7
 213+ 9AB7 E1               POP HL                      ; Restaurar inicio de linea
 214+ 9AB8 DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
