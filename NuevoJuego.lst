1172+ E275 FF CF FF 8F      DEFB $FF,$CF, $FF,$8F, $FF,$1F, $F9,$BF
1172+ E279 FF 1F F9 BF
1173+ E27D F8 DF E4 9F      DEFB $F8,$DF, $E4,$9F, $E3,$8F, $F3,$CF
1173+ E281 E3 8F F3 CF
1174+ E285 FE 0F F0 1F      DEFB $FE,$0F, $F0,$1F, $F8,$3F, $F8,$7F
1174+ E289 F8 3F F8 7F
1175+ E28D FF FF E0 2F      DEFB $FF,$FF, $E0,$2F, $E0,$1F, $FF,$FF
