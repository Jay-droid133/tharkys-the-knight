6532+ C772 0F               RRCA
6533+ C773 0F               RRCA
6534+ C774 E6 1F            AND $1F
6535+ C776 32 74 5F         LD (DBfsCurCx), A
6536+ C779 DD 7E 04         LD A, (IX+ENT_POSY)
6537+ C77C D6 10            SUB SCREEN_MIN_Y
6538+ C77E 0F               RRCA
6539+ C77F 0F               RRCA
6540+ C780 0F               RRCA
6541+ C781 E6 1F            AND $1F
6542+ C783 32 75 5F         LD (DBfsCurCy), A
