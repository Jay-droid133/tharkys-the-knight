 181+ 6C12              ; ==============================================================================
 182+ 6C12              ; WriteTombAttrsCyan - Override 6 attrs (3x2) con los valores originales del sprite
 183+ 6C12              ; ==============================================================================
 184+ 6C12              ; B = pixelX, C = pixelY del top-left de la tumba (en coords pantalla).
 185+ 6C12              ; Escribe ATTR_BASE (override del remap) y CleanAttrMap (para que entidades
 186+ 6C12              ; que pisen la tumba la preserven via RestoreOldAttr).
 187+ 6C12              ; Bypasses ApplyDayCycleRemap → tumba siempre cyan en cualquier fase del dia.
 188+ 6C12              ; Destruye: A, BC, DE, HL.
 189+ 6C12              ; ==============================================================================
 190+ 6C12              WriteTombAttrsCyan:
 191+ 6C12                  ; offset = (pixelY/8) * 32 + (pixelX/8)
 192+ 6C12 79               LD A, C
 193+ 6C13 CB 3F            SRL A
 194+ 6C15 CB 3F            SRL A
 195+ 6C17 CB 3F            SRL A
 196+ 6C19 26 00            LD H, 0
 197+ 6C1B 6F               LD L, A
 198+ 6C1C 29               ADD HL, HL
 199+ 6C1D 29               ADD HL, HL
 200+ 6C1E 29               ADD HL, HL
 201+ 6C1F 29               ADD HL, HL
 202+ 6C20 29               ADD HL, HL                          ; *32
 203+ 6C21 78               LD A, B
 204+ 6C22 CB 3F            SRL A
 205+ 6C24 CB 3F            SRL A
 206+ 6C26 CB 3F            SRL A
 207+ 6C28 5F               LD E, A
 208+ 6C29 16 00            LD D, 0
 209+ 6C2B 19               ADD HL, DE                          ; HL = char offset
 210+ 6C2C
 211+ 6C2C                  ; --- ATTR_BASE override (siempre cyan) ---
 212+ 6C2C E5               PUSH HL
 213+ 6C2D 11 00 58         LD DE, ATTR_BASE
 214+ 6C30 19               ADD HL, DE
 215+ 6C31 36 68            LD (HL), $68                        ; row 0: bright cyan paper
 216+ 6C33 23               INC HL
 217+ 6C34 36 68            LD (HL), $68
 218+ 6C36 23               INC HL
 219+ 6C37 36 68            LD (HL), $68
 220+ 6C39 11 1E 00         LD DE, 30                           ; saltar a fila 1 (32 - 2 INCs = 30)
 221+ 6C3C 19               ADD HL, DE
 222+ 6C3D 36 28            LD (HL), $28                        ; row 1: dim cyan paper
 223+ 6C3F 23               INC HL
 224+ 6C40 36 28            LD (HL), $28
 225+ 6C42 23               INC HL
 226+ 6C43 36 28            LD (HL), $28
 227+ 6C45 E1               POP HL
 228+ 6C46
 229+ 6C46                  ; --- CleanAttrMap override (necesario para DrawPendingTomb; redundante
 230+ 6C46                  ;     pero inocuo en DrawTombstonesInRoom — SaveCleanAttrs lo re-volcaria) ---
 231+ 6C46 11 BA 8D         LD DE, CleanAttrMap
 232+ 6C49 19               ADD HL, DE
 233+ 6C4A 36 68            LD (HL), $68
 234+ 6C4C 23               INC HL
 235+ 6C4D 36 68            LD (HL), $68
 236+ 6C4F 23               INC HL
 237+ 6C50 36 68            LD (HL), $68
 238+ 6C52 11 1E 00         LD DE, 30
 239+ 6C55 19               ADD HL, DE
 240+ 6C56 36 28            LD (HL), $28
 241+ 6C58 23               INC HL
 242+ 6C59 36 28            LD (HL), $28
 243+ 6C5B 23               INC HL
 244+ 6C5C 36 28            LD (HL), $28
 245+ 6C5E C9               RET
 246+ 6C5F
 247+ 6C5F              ; ==============================================================================
 248+ 6C5F              ; RefreshTombAttrsForRoom - Re-aplica attrs cyan a tumbas de la sala actual
 249+ 6C5F              ; ==============================================================================
 250+ 6C5F              ; Llamado desde RemapScreenAttrs.rsDone tras SaveCleanAttrs. Si un entity
 251+ 6C5F              ; (player/nasty/puff/spawn) estaba encima de una tumba durante el cambio de
 252+ 6C5F              ; fase, sus attrs se habrian colado en CleanAttrMap. Esta rutina re-pinta
 253+ 6C5F              ; cyan en las celdas de cada tumba de la sala (ATTR_BASE + CleanAttrMap).
 254+ 6C5F              ; No re-dibuja pixels (XOR los borraria); solo attrs.
 255+ 6C5F              ; Mismo iterador que DrawTombstonesInRoom pero sin LoadBgSpriteToBuffer ni
 256+ 6C5F              ; DrawBgGfxSprite.
 257+ 6C5F              ; Destruye: A, BC, DE, HL.
 258+ 6C5F              ; ==============================================================================
 259+ 6C5F              RefreshTombAttrsForRoom:
 260+ 6C5F 3A 98 82         LD A, (TombstoneCount)
 261+ 6C62 B7               OR A
 262+ 6C63 C8               RET Z
 263+ 6C64
 264+ 6C64 3A 98 82         LD A, (TombstoneCount)
 265+ 6C67 47               LD B, A                                 ; B = loop counter
 266+ 6C68 21 00 E0         LD HL, TOMBSTONE_ADDR
 267+ 6C6B
 268+ 6C6B              .rtfrLoop:
 269+ 6C6B C5               PUSH BC
 270+ 6C6C E5               PUSH HL
 271+ 6C6D
 272+ 6C6D                  ; --- Page bank 7 + leer entry + page bank 0 ---
 273+ 6C6D F3               DI
 274+ 6C6E 3A E7 90         LD A, (CurrentPaging)
 275+ 6C71 E6 F8            AND $F8
 276+ 6C73 F6 07            OR TOMBSTONE_BANK
 277+ 6C75 32 E7 90         LD (CurrentPaging), A
 278+ 6C78 01 FD 7F         LD BC, $7FFD
 279+ 6C7B ED 79            OUT (C), A
 280+ 6C7D
 281+ 6C7D 7E               LD A, (HL)                              ; roomX
 282+ 6C7E 57               LD D, A
 283+ 6C7F 23               INC HL
 284+ 6C80 7E               LD A, (HL)                              ; roomY
 285+ 6C81 5F               LD E, A
 286+ 6C82 23               INC HL
 287+ 6C83 7E               LD A, (HL)                              ; posX
 288+ 6C84 32 C0 6C         LD (.rtfrPosX), A
 289+ 6C87 23               INC HL
 290+ 6C88 7E               LD A, (HL)                              ; posY
 291+ 6C89 32 C1 6C         LD (.rtfrPosY), A
 292+ 6C8C
 293+ 6C8C 3A E7 90         LD A, (CurrentPaging)
 294+ 6C8F E6 F8            AND $F8
 295+ 6C91 32 E7 90         LD (CurrentPaging), A
 296+ 6C94 01 FD 7F         LD BC, $7FFD
 297+ 6C97 ED 79            OUT (C), A
 298+ 6C99 3A 4A 81         LD A, (StartupComplete)
 299+ 6C9C B7               OR A
 300+ 6C9D 28 01            JR Z, .rtfrNoEI
 301+ 6C9F FB               EI
 302+ 6CA0              .rtfrNoEI:
