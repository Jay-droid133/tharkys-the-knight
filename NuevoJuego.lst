 568  C9D1                  INCLUDE "monster_ai_bank6.asm"
# file opened: code/monster_ai_bank6.asm
   1+ C9D1              ; ==============================================================================
   2+ C9D1              ; MONSTER AI v2 — buffers runtime en bank 6
   3+ C9D1              ; ==============================================================================
   4+ C9D1              ; Se incluye en main.asm dentro del bloque PAGE 6, DESPUES de screen_gaps.asm.
   5+ C9D1              ; Los buffers viven en $Cxxx y se acceden paginando bank 6 al slot 3.
   6+ C9D1              ;
   7+ C9D1              ;   FlowField   — 704 B, distancia-al-player por celda (32×22 chars)
   8+ C9D1              ;                 Formato: 1 byte por celda. Valor $FF = inalcanzable.
   9+ C9D1              ;                 Offset lineal: cellY * 32 + cellX
  10+ C9D1              ;
  11+ C9D1              ;   BfsQueue    — 1408 B, FIFO para el BFS (cola de celdas a procesar)
  12+ C9D1              ;                 Cada entrada: 2 bytes = (cx, cy) con cx 0-31, cy 0-21.
  13+ C9D1              ;                 Capacidad 704 entradas = todo el grid. Suficiente en peor caso.
  14+ C9D1              ;
  15+ C9D1              ; Escritura y lectura: los clientes deben paginar bank 6 antes, repaginar bank 0
  16+ C9D1              ; despues (ver PageBankSlot3 en paging.asm).
  17+ C9D1              ; ==============================================================================
  18+ C9D1
  19+ C9D1 00 00 00...  FlowField:      DEFS 704
  20+ CC91 00 00 00...  BfsQueue:       DEFS 1408
  21+ D211
  22+ D211              MonsterAiBank6End:
  23+ D211
# file closed: code/monster_ai_bank6.asm
 569  D211                  INCLUDE "sprite_data.asm"
