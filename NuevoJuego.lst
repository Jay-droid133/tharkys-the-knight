2571+ D95E              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2572+ D95E              ; ==============================================================================
2573+ D95E              ; IN:  DE = BgGfx pointer
2574+ D95E              ; OUT: A = 0 (normal), 1..7 (key), 8..13 (lock con key requerida = A-7)
2575+ D95E              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2576+ D95E              ; ==============================================================================
2577+ D95E              GetPickupKeyBehavior:
2578+ D95E E5               PUSH HL
2579+ D95F C5               PUSH BC
2580+ D960 21 A4 D6         LD HL, KeyLockTable
2581+ D963 06 0D            LD B, 13                    ; 13 slots (insertado BankCheck en slot 7)
2582+ D965 0E 01            LD C, 1                     ; id actual (1..13)
2583+ D967              .gpkbLoop:
2584+ D967 7E               LD A, (HL)                  ; ptr_lo del slot
2585+ D968 BB               CP E
2586+ D969 20 06            JR NZ, .gpkbNext
2587+ D96B 23               INC HL
2588+ D96C 7E               LD A, (HL)                  ; ptr_hi
2589+ D96D 2B               DEC HL
2590+ D96E BA               CP D
2591+ D96F 28 09            JR Z, .gpkbFound
2592+ D971              .gpkbNext:
2593+ D971 23               INC HL
2594+ D972 23               INC HL                      ; siguiente slot (DEFW = 2 bytes)
2595+ D973 0C               INC C
2596+ D974 10 F1            DJNZ .gpkbLoop
2597+ D976 AF               XOR A                       ; no encontrado → comportamiento normal
2598+ D977 C1               POP BC
2599+ D978 E1               POP HL
2600+ D979 C9               RET
2601+ D97A              .gpkbFound:
2602+ D97A 79               LD A, C                     ; A = id (1..8)
2603+ D97B C1               POP BC
2604+ D97C E1               POP HL
2605+ D97D C9               RET
