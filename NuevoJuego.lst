 725+ E865              ; Variables locales reloj plaza
 726+ E865 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 727+ E866 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 728+ E867
 729+ E867              ; ==============================================================================
 730+ E867              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 731+ E867              ; ==============================================================================
 732+ E867              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 733+ E867              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 734+ E867              ; a posiciones relativas y las busca en PlazaScanAddrs.
 735+ E867              ; ==============================================================================
 736+ E867              DrawPlazaHandLine:
 737+ E867                  ; Indexar en tabla de punteros
 738+ E867 87               ADD A, A
 739+ E868 4F               LD C, A
 740+ E869 06 00            LD B, 0
 741+ E86B 09               ADD HL, BC
 742+ E86C 7E               LD A, (HL)
 743+ E86D 23               INC HL
 744+ E86E 66               LD H, (HL)
 745+ E86F 6F               LD L, A                     ; HL = puntero a datos de linea HUD
