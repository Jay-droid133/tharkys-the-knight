 117  66E1                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
 118  66E1                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
 119  66E1                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
 120  66E1                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
 121  66E1                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
 122  66E1                  INCLUDE "church_cutscene.asm"
# file opened: code/church_cutscene.asm
   1+ 66E1              ; ==============================================================================
   2+ 66E1              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 66E1              ; ==============================================================================
   4+ 66E1              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 66E1              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 66E1              ; la cinematica — invisible porque es one-shot.
   7+ 66E1              ;
   8+ 66E1              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 66E1              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 66E1              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 66E1              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 66E1              ; ==============================================================================
  13+ 66E1
  14+ 66E1              ; ==============================================================================
  15+ 66E1              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 66E1              ; ==============================================================================
  17+ 66E1              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 66E1              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 66E1              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 66E1              ; ChurchCutsceneSlot.
  21+ 66E1              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 66E1              ; ==============================================================================
  23+ 66E1              EraseChurchTrappedMonster:
  24+ 66E1 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 66E4 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 66E5 6F               LD L, A
  27+ 66E6 26 00            LD H, 0
  28+ 66E8 29               ADD HL, HL
  29+ 66E9 29               ADD HL, HL
  30+ 66EA 29               ADD HL, HL
  31+ 66EB 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 66EC 11 9E 81         LD DE, EntityTable
  33+ 66EF 19               ADD HL, DE
  34+ 66F0 E5               PUSH HL
  35+ 66F1 DD E1            POP IX
  36+ 66F3 CD F7 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66F6 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66F9 57               LD D, A
  39+ 66FA DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66FD 5F               LD E, A
  41+ 66FE DD 2A 7F A4      LD IX, (OldSprAddr)
  42+ 6702 C3 EA 99         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 6705
  44+ 6705              ; ==============================================================================
  45+ 6705              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 6705              ; ==============================================================================
  47+ 6705              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 6705              ; - Despawn monster (ENT_TYPE=0).
  49+ 6705              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 6705              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 6705              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 6705              ; ==============================================================================
  53+ 6705              ApplyChurchTrapDone:
  54+ 6705                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 6705 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 6708 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 6709 6F               LD L, A
  58+ 670A 26 00            LD H, 0
  59+ 670C 29               ADD HL, HL
  60+ 670D 29               ADD HL, HL
  61+ 670E 29               ADD HL, HL
  62+ 670F 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 6710 11 9E 81         LD DE, EntityTable
  64+ 6713 19               ADD HL, DE
  65+ 6714 E5               PUSH HL
  66+ 6715 DD E1            POP IX
  67+ 6717                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 6717                  ; guardado en TriggerChurchTrap).
  69+ 6717 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 671A 21 A6 67         LD HL, ChurchTrapBitMask
  71+ 671D 5F               LD E, A
  72+ 671E 16 00            LD D, 0
  73+ 6720 19               ADD HL, DE
  74+ 6721 7E               LD A, (HL)
  75+ 6722 21 C1 82         LD HL, MonsterTrappedFlags
  76+ 6725 B6               OR (HL)
  77+ 6726 77               LD (HL), A
  78+ 6727                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 6727                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 6727                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 6727 21 C2 82         LD HL, NextChurchTrapStep
  82+ 672A 34               INC (HL)
  83+ 672B                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 672B                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 672B                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 672B                  ; antes de quedarse fija en blanco brillante.
  87+ 672B DD E5            PUSH IX
  88+ 672D CD F6 F1         CALL StartStatueBlink
  89+ 6730 DD E1            POP IX
  90+ 6732                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 6732                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 6732                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 6732 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 6736 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 673A DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 673E DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 6742                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 6742                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 6742                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 6742                  ; anteriores del cutscene.)
 101+ 6742                  ; Decidir spawn: 3 atrapados?
 102+ 6742 3A C1 82         LD A, (MonsterTrappedFlags)
 103+ 6745 E6 07            AND $07
 104+ 6747 FE 07            CP $07
 105+ 6749 28 12            JR Z, .actdAllTrapped
 106+ 674B                  ; <3 atrapados: respawn church_key en AltN
 107+ 674B 3E 01            LD A, 1
 108+ 674D 32 B3 82         LD (ChurchKeySpawned), A
 109+ 6750 21 C4 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 6753 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6754 CD F7 69         CALL RespawnChurchKeyAtAlt
 112+ 6757                  ; Dibujar surgical en su nueva posicion
 113+ 6757 11 ED D7         LD DE, BgGfx_church_key
 114+ 675A C3 64 D7         JP RedrawPickupByPtr
 115+ 675D              .actdAllTrapped:
 116+ 675D                  ; Los 3 monstruos atrapados: descongelar el reloj inmediatamente. La
 117+ 675D                  ; aparicion de la llave y el avance del milestone se difieren con
 118+ 675D                  ; PostTrapPauseTimer para dar pacing cinematografico:
 119+ 675D                  ;   t=0 (ahora): cutscene termina, mundo descongelado, sin llave aun.
 120+ 675D                  ;   t=1s: aparece town_gate_key + advance milestone (en UpdatePostTrapPause).
 121+ 675D                  ;   t=2s: nasties resumen (TrySpawnNasty levanta su guard).
 122+ 675D AF               XOR A
 123+ 675E 32 B6 82         LD (TimeFrozen), A
 124+ 6761 3E 64            LD A, POST_TRAP_NASTY_DELAY
 125+ 6763 32 CA 82         LD (PostTrapPauseTimer), A
 126+ 6766 C9               RET
 127+ 6767
 128+ 6767              ; ==============================================================================
 129+ 6767              ; UpdatePostTrapPause - Tick + dispara eventos diferidos tras cutscene de iglesia
 130+ 6767              ; ==============================================================================
 131+ 6767              ; Llamado cada frame desde MainLoop. No-op si timer = 0 (caso normal).
 132+ 6767              ; Cuando ApplyChurchTrapDone setea el timer a 50, esta rutina decrementa cada
 133+ 6767              ; frame y dispara los eventos a los frames precisos:
 134+ 6767              ;   timer=25 (= 1s desde inicio): aparece town_gate_key + advance milestone 7→8.
 135+ 6767              ;   timer=0  (= 2s desde inicio): nasties resumen (via guard en TrySpawnNasty).
 136+ 6767              ; ==============================================================================
 137+ 6767              UpdatePostTrapPause:
 138+ 6767 3A CA 82         LD A, (PostTrapPauseTimer)
 139+ 676A B7               OR A
 140+ 676B C8               RET Z
 141+ 676C 3D               DEC A
 142+ 676D 32 CA 82         LD (PostTrapPauseTimer), A
 143+ 6770 FE 4B            CP POST_TRAP_KEY_DELAY              ; ¿cae justo en el frame del key spawn?
 144+ 6772 28 0E            JR Z, .uptpKey
 145+ 6774 FE 3C            CP POST_TRAP_LASTING_DELAY          ; ¿lasting compass spawn?
 146+ 6776 C0               RET NZ
 147+ 6777                  ; t = ~1.6s: aparece compass_lasting (sprite id 37) en ALT2 de church_key.
 148+ 6777                  ; Sin SFX (a peticion). Es pickup latente (DormantPickupTable +
 149+ 6777                  ; LastingCompassSpawned).
 150+ 6777 3E 01            LD A, 1
 151+ 6779 32 C7 82         LD (LastingCompassSpawned), A
 152+ 677C 11 58 E8         LD DE, BgGfx_compass_lasting
 153+ 677F C3 64 D7         JP RedrawPickupByPtr                ; tail call
 154+ 6782              .uptpKey:
 155+ 6782                  ; t=1s: aparece el CHEQUE (BankCheck) + avance del hito M7→M8.
 156+ 6782                  ; SFX primero (mismo "clink" que la church_key cuando aparece en la plaza
 157+ 6782                  ; del ayuntamiento): se oye antes de que se dibuje, igual que en CheckBumpTriggers.
 158+ 6782                  ;
 159+ 6782                  ; Cambio respecto a la version anterior: en vez de soltar town_gate_key
 160+ 6782                  ; (la llave de la ciudad) aqui, soltamos BankCheck. La llave de la ciudad
 161+ 6782                  ; ahora la suelta bank_cutscene (M9) tras llevar el cheque al banco. Ver
 162+ 6782                  ; docs/bank_cutscene.md.
 163+ 6782 21 80 F7         LD HL, SFX_KeyDrop
 164+ 6785 CD 42 F6         CALL PlaySFX
 165+ 6788 3E 01            LD A, 1
 166+ 678A 32 C6 82         LD (BankCheckSpawned), A
 167+ 678D 11 4C F1         LD DE, BgGfx_BankCheck
 168+ 6790 CD 64 D7         CALL RedrawPickupByPtr
 169+ 6793 3A BA 82         LD A, (CurrentObjective)
 170+ 6796 FE 07            CP 7
 171+ 6798 C0               RET NZ
 172+ 6799 3C               INC A
 173+ 679A 32 BA 82         LD (CurrentObjective), A
 174+ 679D CD AC EE         CALL ResolveObjectiveScreen
 175+ 67A0 3E FF            LD A, $FF
 176+ 67A2 32 BD 82         LD (PreviousObjectiveDistance), A
 177+ 67A5 C9               RET
