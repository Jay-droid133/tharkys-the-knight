5428+ C01D              ; ==============================================================================
5429+ C01D              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5430+ C01D              ; ==============================================================================
5431+ C01D              ScareAllMonsters:
5432+ C01D AF               XOR A
5433+ C01E 32 6E B6         LD (MonstersActive), A              ; No respawnear mas
5434+ C021                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5435+ C021                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5436+ C021                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5437+ C021 21 F9 90         LD HL, MonsterAiFlags
5438+ C024 06 03            LD B, 3
5439+ C026              .samClearLoop:
5440+ C026 7E               LD A, (HL)
5441+ C027 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5442+ C029 77               LD (HL), A
5443+ C02A 23               INC HL
5444+ C02B 10 F9            DJNZ .samClearLoop
5445+ C02D 3E 7D            LD A, SCARE_TIMER_DAWN
5446+ C02F 32 04 B9         LD (ScareTimer), A
5447+ C032                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5448+ C032                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5449+ C032                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5450+ C032                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5451+ C032 DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5452+ C036 06 06            LD B, NUM_MONSTERS
5453+ C038              .samStateLoop:
5454+ C038 DD 7E 01         LD A, (IX+ENT_TYPE)
