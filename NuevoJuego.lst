7813+ CAFC              ; ==============================================================================
7814+ CAFC              ; TriggerDeathBorder - arranca el flash del borde tras morir
7815+ CAFC              ; ==============================================================================
7816+ CAFC              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7817+ CAFC              ; luego vuelve a negro y se desactiva.
7818+ CAFC              ; ==============================================================================
7819+ CAFC              TriggerDeathBorder:
7820+ CAFC 3E 01            LD A, 1
7821+ CAFE 32 EC 82         LD (DeathBorderPhase), A
7822+ CB01 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7823+ CB03 32 ED 82         LD (DeathBorderTimer), A
7824+ CB06 3E 06            LD A, YELLOW
7825+ CB08 32 88 8D         LD (CurrentBorderColor), A
7826+ CB0B D3 FE            OUT (254), A
7827+ CB0D C9               RET
7828+ CB0E
7829+ CB0E              ; ==============================================================================
7830+ CB0E              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7831+ CB0E              ; ==============================================================================
7832+ CB0E              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7833+ CB0E              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7834+ CB0E              ; ==============================================================================
7835+ CB0E              UpdateRespawnBlink:
7836+ CB0E 3A F0 82         LD A, (PlayerRespawnPhase)
7837+ CB11 B7               OR A
7838+ CB12 C8               RET Z
7839+ CB13 3D               DEC A
7840+ CB14 28 0D            JR Z, .urbPhase1
7841+ CB16                  ; Phase 2: solo timer (sin parpadeo)
7842+ CB16 3A F1 82         LD A, (PlayerRespawnTimer)
7843+ CB19 3D               DEC A
7844+ CB1A 32 F1 82         LD (PlayerRespawnTimer), A
7845+ CB1D C0               RET NZ
7846+ CB1E AF               XOR A
7847+ CB1F 32 F0 82         LD (PlayerRespawnPhase), A
7848+ CB22 C9               RET
7849+ CB23
7850+ CB23              .urbPhase1:
7851+ CB23                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7852+ CB23                  ; Zero input (sin control)
7853+ CB23 AF               XOR A
7854+ CB24 32 B0 82         LD (InputDirection), A
7855+ CB27 32 B1 82         LD (InputFire), A
7856+ CB2A                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7857+ CB2A                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7858+ CB2A 3A A4 6A         LD A, (BeepDurationFrames)
7859+ CB2D D6 01            SUB 1                               ; CY si era 0 (silencio)
7860+ CB2F 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7861+ CB30 E6 74            AND SPRID_PLAYER_BLANK
7862+ CB32 32 A0 81         LD (EntityTable), A
7863+ CB35                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7864+ CB35 3A F1 82         LD A, (PlayerRespawnTimer)
7865+ CB38 B7               OR A
7866+ CB39 28 05            JR Z, .urb1FireBeat
7867+ CB3B 3D               DEC A
7868+ CB3C 32 F1 82         LD (PlayerRespawnTimer), A
7869+ CB3F C9               RET
7870+ CB40              .urb1FireBeat:
7871+ CB40 3A F4 82         LD A, (PlayerRespawnBeatIdx)
7872+ CB43 3C               INC A
7873+ CB44 32 F4 82         LD (PlayerRespawnBeatIdx), A
7874+ CB47 FE 04            CP 4
7875+ CB49 28 12            JR Z, .urb1LastBeat
7876+ CB4B FE 05            CP 5
7877+ CB4D 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7878+ CB4F                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7879+ CB4F 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7880+ CB52 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7881+ CB54 CD D2 6A         CALL AY_PlayBeep
7882+ CB57                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7883+ CB57                  ; (mitad) para mantener ON/OFF ~50/50.
7884+ CB57 3E 14            LD A, 20
7885+ CB59 32 F1 82         LD (PlayerRespawnTimer), A
7886+ CB5C C9               RET
7887+ CB5D              .urb1LastBeat:
7888+ CB5D                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7889+ CB5D                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7890+ CB5D                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7891+ CB5D                  ; entra grace EXACTAMENTE al terminar el beep.
7892+ CB5D 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7893+ CB60 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7894+ CB62 CD D2 6A         CALL AY_PlayBeep
7895+ CB65 3E 0B            LD A, 11                    ; espera = duracion del beep
7896+ CB67 32 F1 82         LD (PlayerRespawnTimer), A
7897+ CB6A C9               RET
7898+ CB6B              .urb1AfterBeep:
7899+ CB6B                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7900+ CB6B                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7901+ CB6B CD 93 CB         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7902+ CB6E 3E 0C            LD A, SPAWN_INTERVAL
7903+ CB70 32 FA 82         LD (SpawnTimer), A
7904+ CB73 AF               XOR A
7905+ CB74 32 FF 82         LD (DeathSpawned), A
7906+ CB77 32 F5 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7907+ CB7A 32 B8 82         LD (TimeFrozen), A              ; Reanudar reloj
7908+ CB7D 21 00 00         LD HL, 0
7909+ CB80 22 FC 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7910+ CB83                  ; Si los monsters siguen activos (no era game over), reanudar el
7911+ CB83                  ; secuencer "po-po-popo-po" — fue parado en OnPlayerHealthDepleted.
7912+ CB83 3A 8C B3         LD A, (MonstersActive)
7913+ CB86 B7               OR A
7914+ CB87 C8               RET Z
7915+ CB88                  ; No re-arrancar si los 3 monsters estan atrapados en la iglesia
7916+ CB88                  ; (StopMonstersMusic se llamo en TriggerChurchTrap del 3o; ya no hay
7917+ CB88                  ; monsters jugables en pantalla aunque MonstersActive siga 1).
7918+ CB88 3A C3 82         LD A, (MonsterTrappedFlags)
7919+ CB8B E6 07            AND $07
7920+ CB8D FE 07            CP $07
7921+ CB8F C8               RET Z
7922+ CB90 C3 5B FB         JP StartMonstersMusic           ; tail-call
7923+ CB93
7924+ CB93              ; ==============================================================================
7925+ CB93              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7926+ CB93              ; ==============================================================================
7927+ CB93              ; Llamado desde:
7928+ CB93              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7929+ CB93              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7930+ CB93              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7931+ CB93              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7932+ CB93              ; ==============================================================================
7933+ CB93              EnterGracePhase:
7934+ CB93 3E 02            LD A, 2
7935+ CB95 32 F0 82         LD (PlayerRespawnPhase), A
7936+ CB98 3E 19            LD A, RESPAWN_GRACE_FRAMES
7937+ CB9A 32 F1 82         LD (PlayerRespawnTimer), A
7938+ CB9D C9               RET
7939+ CB9E
7940+ CB9E              ; ==============================================================================
7941+ CB9E              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7942+ CB9E              ; ==============================================================================
7943+ CB9E              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7944+ CB9E              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7945+ CB9E              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7946+ CB9E              ; ==============================================================================
7947+ CB9E              UpdateDeathAnim:
7948+ CB9E 3A EC 82         LD A, (DeathBorderPhase)
7949+ CBA1 FE 01            CP 1
7950+ CBA3 C0               RET NZ
7951+ CBA4 3A EE 82         LD A, (PlayerDeathAnimTimer)
7952+ CBA7 3D               DEC A
7953+ CBA8 32 EE 82         LD (PlayerDeathAnimTimer), A
7954+ CBAB C0               RET NZ
7955+ CBAC                  ; Tick consumido: avanzar frame
7956+ CBAC 3A EF 82         LD A, (PlayerDeathAnimFrame)
7957+ CBAF 3C               INC A
7958+ CBB0 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7959+ CBB2 D0               RET NC                              ; ya en ultimo frame (clamp)
7960+ CBB3 32 EF 82         LD (PlayerDeathAnimFrame), A
7961+ CBB6 DD 21 A0 81      LD IX, EntityTable
7962+ CBBA DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7963+ CBBD                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7964+ CBBD                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7965+ CBBD                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7966+ CBBD FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7967+ CBBF 20 06            JR NZ, .udaSkipSplatSfx
7968+ CBC1 21 E8 F9         LD HL, SFX_EnemyDeath
7969+ CBC4 CD 69 F9         CALL PlaySFX
7970+ CBC7              .udaSkipSplatSfx:
7971+ CBC7 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7972+ CBC9 32 EE 82         LD (PlayerDeathAnimTimer), A
7973+ CBCC C9               RET
7974+ CBCD
7975+ CBCD              ; ==============================================================================
7976+ CBCD              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7977+ CBCD              ; ==============================================================================
7978+ CBCD              UpdateDeathBorder:
7979+ CBCD 3A EC 82         LD A, (DeathBorderPhase)
7980+ CBD0 B7               OR A
7981+ CBD1 C8               RET Z
7982+ CBD2 3A ED 82         LD A, (DeathBorderTimer)
7983+ CBD5 3D               DEC A
7984+ CBD6 32 ED 82         LD (DeathBorderTimer), A
7985+ CBD9 C0               RET NZ
7986+ CBDA                  ; Timer expiro: avanzar fase
7987+ CBDA 3A EC 82         LD A, (DeathBorderPhase)
7988+ CBDD FE 01            CP 1
7989+ CBDF 20 33            JR NZ, .udbToBlack
7990+ CBE1                  ; --- Fin fase amarillo ---
7991+ CBE1                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7992+ CBE1                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7993+ CBE1 3A E3 82         LD A, (PlayerLives)
7994+ CBE4 B7               OR A
7995+ CBE5 28 1F            JR Z, .udbToGameOver
7996+ CBE7 DD 21 A0 81      LD IX, EntityTable
7997+ CBEB DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7998+ CBEF 3E 02            LD A, 2
7999+ CBF1 32 EC 82         LD (DeathBorderPhase), A
8000+ CBF4 3E 32            LD A, DEATH_BORDER_RED_FRAMES
8001+ CBF6 32 ED 82         LD (DeathBorderTimer), A
8002+ CBF9 3E 02            LD A, RED
8003+ CBFB 32 88 8D         LD (CurrentBorderColor), A
8004+ CBFE D3 FE            OUT (254), A
8005+ CC00                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
8006+ CC00                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
8007+ CC00 3E 01            LD A, 1
8008+ CC02 32 F9 82         LD (TombDrawPending), A
8009+ CC05 C9               RET
8010+ CC06              .udbToGameOver:
8011+ CC06                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
8012+ CC06 AF               XOR A
8013+ CC07 32 EC 82         LD (DeathBorderPhase), A
8014+ CC0A 3E 00            LD A, BLACK
8015+ CC0C 32 88 8D         LD (CurrentBorderColor), A
8016+ CC0F D3 FE            OUT (254), A
8017+ CC11 C3 22 CC         JP ShowGameOver
8018+ CC14              .udbToBlack:
8019+ CC14                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
8020+ CC14 AF               XOR A
8021+ CC15 32 EC 82         LD (DeathBorderPhase), A
8022+ CC18 3E 00            LD A, BLACK
8023+ CC1A 32 88 8D         LD (CurrentBorderColor), A
8024+ CC1D D3 FE            OUT (254), A
8025+ CC1F C3 A5 CA         JP RespawnPlayerAtEntry             ; tail-call
8026+ CC22
8027+ CC22              ; ==============================================================================
8028+ CC22              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
8029+ CC22              ; ==============================================================================
8030+ CC22              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
8031+ CC22              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
8032+ CC22              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
8033+ CC22              ; ==============================================================================
8034+ CC22              ShowGameOver:
8035+ CC22 3E 01            LD A, 1
8036+ CC24 32 E4 82         LD (GameOver), A
8037+ CC27 C9               RET
8038+ CC28
8039+ CC28              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
8040+ CC28              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
8041+ CC28              PaintGameOverScreen:
8042+ CC28                  ; Wipe pixels
8043+ CC28 21 00 40         LD HL, $4000
8044+ CC2B 11 01 40         LD DE, $4001
8045+ CC2E 01 FF 17         LD BC, $17FF
8046+ CC31 36 00            LD (HL), 0
8047+ CC33 ED B0            LDIR
8048+ CC35                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
8049+ CC35 21 00 58         LD HL, $5800
8050+ CC38 11 01 58         LD DE, $5801
8051+ CC3B 01 FF 02         LD BC, $02FF
8052+ CC3E 36 47            LD (HL), $47
8053+ CC40 ED B0            LDIR
8054+ CC42                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
8055+ CC42                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
8056+ CC42 CD 70 6C         CALL DrawTombstone2xCentered
8057+ CC45                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
8058+ CC45 3E 88            LD A, GAMEOVER_ANIM_X_MAX
8059+ CC47 32 E5 82         LD (GameOverAnimX), A
8060+ CC4A AF               XOR A
8061+ CC4B 32 E6 82         LD (GameOverAnimDir), A
8062+ CC4E 32 E7 82         LD (GameOverAnimFrame), A
8063+ CC51 32 EB 82         LD (GameOverAnimLastX), A
8064+ CC54 21 00 00         LD HL, 0
8065+ CC57 22 E9 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
8066+ CC5A 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8067+ CC5C 32 E8 82         LD (GameOverAnimFrameTimer), A
8068+ CC5F                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
8069+ CC5F                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
8070+ CC5F                  ; congelado en GameOver=2.
8071+ CC5F 3E 03            LD A, 3
8072+ CC61 C3 BF 99         JP StartMusic                   ; tail-call
8073+ CC64
8074+ CC64              ; ==============================================================================
8075+ CC64              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
8076+ CC64              ; ==============================================================================
8077+ CC64              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
8078+ CC64              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
8079+ CC64              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
8080+ CC64              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
8081+ CC64              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
8082+ CC64              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
8083+ CC64              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
8084+ CC64              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
8085+ CC64              ;
8086+ CC64              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
8087+ CC64              ; shifted (que ocupa 4 chars = 32 px).
8088+ CC64              ; ==============================================================================
8089+ CC64              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
8090+ CC64              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
8091+ CC64              ; X swing centrado sobre la tumba:
8092+ CC64              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
8093+ CC64              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
8094+ CC64              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
8095+ CC64              GAMEOVER_ANIM_Y           EQU 56
8096+ CC64              GAMEOVER_ANIM_X_MIN       EQU 96
8097+ CC64              GAMEOVER_ANIM_X_MAX       EQU 136
8098+ CC64              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8099+ CC64
8100+ CC64              UpdateGameOverAnim:
8101+ CC64                  ; --- Erase del sprite previo (si lo hubo) ---
8102+ CC64 2A E9 82         LD HL, (GameOverAnimLastSpr)
8103+ CC67 7C               LD A, H
8104+ CC68 B5               OR L
8105+ CC69 28 0C            JR Z, .ugoaNoErase
8106+ CC6B E5               PUSH HL
8107+ CC6C DD E1            POP IX
8108+ CC6E 3A EB 82         LD A, (GameOverAnimLastX)
8109+ CC71 5F               LD E, A
8110+ CC72 16 38            LD D, GAMEOVER_ANIM_Y
8111+ CC74 CD EC 99         CALL DrawSprite
8112+ CC77              .ugoaNoErase:
8113+ CC77
8114+ CC77                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8115+ CC77 3A E8 82         LD A, (GameOverAnimFrameTimer)
8116+ CC7A 3D               DEC A
8117+ CC7B 20 0A            JR NZ, .ugoaTimerSet
8118+ CC7D 3A E7 82         LD A, (GameOverAnimFrame)
8119+ CC80 EE 01            XOR 1
8120+ CC82 32 E7 82         LD (GameOverAnimFrame), A
8121+ CC85 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8122+ CC87              .ugoaTimerSet:
8123+ CC87 32 E8 82         LD (GameOverAnimFrameTimer), A
8124+ CC8A
8125+ CC8A                  ; --- Avanzar X segun direccion (ping-pong) ---
8126+ CC8A 3A E6 82         LD A, (GameOverAnimDir)
8127+ CC8D B7               OR A
8128+ CC8E 20 14            JR NZ, .ugoaSlideRight
8129+ CC90                  ; Dir 0: facing R, slide LEFT (X--)
8130+ CC90 3A E5 82         LD A, (GameOverAnimX)
8131+ CC93 FE 60            CP GAMEOVER_ANIM_X_MIN
8132+ CC95 28 06            JR Z, .ugoaFlipToL
8133+ CC97 3D               DEC A
8134+ CC98 32 E5 82         LD (GameOverAnimX), A
8135+ CC9B 18 18            JR .ugoaPickSprite
8136+ CC9D              .ugoaFlipToL:
8137+ CC9D 3E 01            LD A, 1
8138+ CC9F 32 E6 82         LD (GameOverAnimDir), A
8139+ CCA2 18 11            JR .ugoaPickSprite
8140+ CCA4              .ugoaSlideRight:
8141+ CCA4                  ; Dir 1: facing L, slide RIGHT (X++)
8142+ CCA4 3A E5 82         LD A, (GameOverAnimX)
8143+ CCA7 FE 88            CP GAMEOVER_ANIM_X_MAX
8144+ CCA9 28 06            JR Z, .ugoaFlipToR
8145+ CCAB 3C               INC A
8146+ CCAC 32 E5 82         LD (GameOverAnimX), A
8147+ CCAF 18 04            JR .ugoaPickSprite
8148+ CCB1              .ugoaFlipToR:
8149+ CCB1 AF               XOR A
8150+ CCB2 32 E6 82         LD (GameOverAnimDir), A
8151+ CCB5
8152+ CCB5              .ugoaPickSprite:
8153+ CCB5                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8154+ CCB5                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8155+ CCB5                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8156+ CCB5 3A E6 82         LD A, (GameOverAnimDir)
8157+ CCB8 B7               OR A
8158+ CCB9 20 0E            JR NZ, .ugoaPickR
8159+ CCBB 3A E7 82         LD A, (GameOverAnimFrame)
8160+ CCBE B7               OR A
8161+ CCBF 21 DF DD         LD HL, SprDeath_L0
8162+ CCC2 28 11            JR Z, .ugoaSprSet
8163+ CCC4 21 29 DE         LD HL, SprDeath_L1
8164+ CCC7 18 0C            JR .ugoaSprSet
8165+ CCC9              .ugoaPickR:
8166+ CCC9 3A E7 82         LD A, (GameOverAnimFrame)
8167+ CCCC B7               OR A
8168+ CCCD 21 4B DD         LD HL, SprDeath_0
8169+ CCD0 28 03            JR Z, .ugoaSprSet
8170+ CCD2 21 95 DD         LD HL, SprDeath_1
8171+ CCD5              .ugoaSprSet:
8172+ CCD5 22 E9 82         LD (GameOverAnimLastSpr), HL
8173+ CCD8 3A E5 82         LD A, (GameOverAnimX)
8174+ CCDB 32 EB 82         LD (GameOverAnimLastX), A
8175+ CCDE
8176+ CCDE                  ; --- Draw nuevo sprite ---
8177+ CCDE E5               PUSH HL
8178+ CCDF DD E1            POP IX
8179+ CCE1 5F               LD E, A
8180+ CCE2 16 38            LD D, GAMEOVER_ANIM_Y
8181+ CCE4 C3 EC 99         JP DrawSprite                   ; tail-call
8182+ CCE7
