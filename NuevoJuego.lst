 227+ 9ACE              ; ==============================================================================
 228+ 9ACE              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9ACE              ; ==============================================================================
 230+ 9ACE              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9ACE              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9ACE              ;
 233+ 9ACE              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9ACE              ; ==============================================================================
 235+ 9ACE              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9ACE              NextPixelLine:
 237+ 9ACE 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9ACF 7C               LD A, H
 239+ 9AD0 E6 07            AND 7
 240+ 9AD2 C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9AD3
 242+ 9AD3                  ; --- Cruce de character row ---
 243+ 9AD3 7D               LD A, L
 244+ 9AD4 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AD6 6F               LD L, A
 246+ 9AD7 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD9 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9ADA
 249+ 9ADA                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9ADA 7C               LD A, H
 251+ 9ADB D6 08            SUB 8
 252+ 9ADD 67               LD H, A
 253+ 9ADE C9               RET
