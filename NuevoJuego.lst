# file closed: milestones.asm
 352  F846                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 353  F846                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F846              ; ==============================================================================
   2+ F846              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F846              ; ==============================================================================
   4+ F846              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F846              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F846              ;
   7+ F846              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F846              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F846              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F846              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F846              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F846              ; ==============================================================================
  13+ F846
  14+ F846              ; ==============================================================================
  15+ F846              ; PlaySFX - Reproduce un efecto de sonido
  16+ F846              ; ==============================================================================
  17+ F846              ; Entrada: HL = puntero a datos del efecto
  18+ F846              ; Modifica: AF, BC, DE, HL
  19+ F846              ; ==============================================================================
  20+ F846              PlaySFX:
  21+ F846 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F847 3A D5 90         LD A, (CurrentBorderColor)
  23+ F84A E6 07            AND $07                     ; Solo bits de color del borde
  24+ F84C 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F84D
  26+ F84D              .nextStep:
  27+ F84D 7E               LD A, (HL)                  ; Leer duration
  28+ F84E B7               OR A
  29+ F84F 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F851
  31+ F851 47               LD B, A                     ; B = duration (bucle externo)
  32+ F852 23               INC HL
  33+ F853 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F854 23               INC HL
  35+ F855 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F856 23               INC HL
  37+ F857 7E               LD A, (HL)                  ; A = flags
  38+ F858 23               INC HL
  39+ F859 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F85A CB 47            BIT 0, A
  41+ F85C 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F85E
  43+ F85E              ; --- Bucle de tono normal ---
  44+ F85E              .toneLoop:
  45+ F85E                  ; Semi-periodo HIGH
  46+ F85E 7B               LD A, E
  47+ F85F F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F861 D3 FE            OUT ($FE), A
  49+ F863 79               LD A, C                     ; A = pitch actual
  50+ F864              .toneDelayHi:
  51+ F864 3D               DEC A
  52+ F865 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F867
  54+ F867                  ; Semi-periodo LOW
  55+ F867 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F868 D3 FE            OUT ($FE), A
  57+ F86A 79               LD A, C
  58+ F86B              .toneDelayLo:
  59+ F86B 3D               DEC A
  60+ F86C 20 FD            JR NZ, .toneDelayLo
  61+ F86E
  62+ F86E                  ; Aplicar pitch sweep
  63+ F86E 79               LD A, C
  64+ F86F 82               ADD A, D                    ; pitch += pitchDelta
  65+ F870 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F872 FA 7A F8         JP M, .toneClamp            ; evitar pitch negativo
  67+ F875 4F               LD C, A
  68+ F876              .toneAfterClamp:
  69+ F876 10 E6            DJNZ .toneLoop
  70+ F878 18 30            JR .stepDone
  71+ F87A
  72+ F87A              .toneClamp:
  73+ F87A 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F87C 18 F8            JR .toneAfterClamp
  75+ F87E
  76+ F87E              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F87E              .noiseLoop:
  78+ F87E                  ; Semi-periodo HIGH con ruido
  79+ F87E 7B               LD A, E
  80+ F87F F6 10            OR $10
  81+ F881 D3 FE            OUT ($FE), A
  82+ F883 ED 5F            LD A, R                     ; R register como PRNG
  83+ F885 A9               XOR C                       ; mezclar con pitch base
  84+ F886 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F888 F6 01            OR $01                      ; minimo 1
  86+ F88A              .noiseDelayHi:
  87+ F88A 3D               DEC A
  88+ F88B 20 FD            JR NZ, .noiseDelayHi
  89+ F88D
  90+ F88D                  ; Semi-periodo LOW
  91+ F88D 7B               LD A, E
  92+ F88E D3 FE            OUT ($FE), A
  93+ F890 ED 5F            LD A, R
  94+ F892 A9               XOR C
  95+ F893 E6 1F            AND $1F
  96+ F895 F6 01            OR $01
  97+ F897              .noiseDelayLo:
  98+ F897 3D               DEC A
  99+ F898 20 FD            JR NZ, .noiseDelayLo
 100+ F89A
 101+ F89A                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F89A 79               LD A, C
 103+ F89B 82               ADD A, D
 104+ F89C 28 08            JR Z, .noiseClamp
 105+ F89E FA A6 F8         JP M, .noiseClamp
 106+ F8A1 4F               LD C, A
 107+ F8A2              .noiseAfterClamp:
 108+ F8A2 10 DA            DJNZ .noiseLoop
 109+ F8A4 18 04            JR .stepDone
 110+ F8A6
 111+ F8A6              .noiseClamp:
 112+ F8A6 0E 01            LD C, 1
 113+ F8A8 18 F8            JR .noiseAfterClamp
 114+ F8AA
 115+ F8AA              .stepDone:
 116+ F8AA E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F8AB 18 A0            JR .nextStep
 118+ F8AD
 119+ F8AD              .done:
 120+ F8AD 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F8AE D3 FE            OUT ($FE), A
 122+ F8B0 FB               EI
 123+ F8B1 C9               RET
