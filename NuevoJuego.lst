 195  A11A                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A11A              ; ==============================================================================
   2+ A11A              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A11A              ; ==============================================================================
   4+ A11A              ; - Estructura de entidad de 12 bytes (universal)
   5+ A11A              ; - Game loop per-entity: erase → update → draw
   6+ A11A              ; - Movimiento 8-bit (sin subpixel)
   7+ A11A              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A11A              ; - XOR draw/erase (una sola rutina)
   9+ A11A              ; ==============================================================================
  10+ A11A
  11+ A11A              ; ==============================================================================
  12+ A11A              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A11A              ; ==============================================================================
  14+ A11A              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A11A              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A11A              ; ==============================================================================
  17+ A11A              ReadInput:
  18+ A11A 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A11C 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A11E
  21+ A11E                  ; -- 1. QAOP --
  22+ A11E 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A121 ED 78            IN A, (C)
  24+ A123 CB 47            BIT 0, A            ; Q = Arriba
  25+ A125 20 02            JR NZ, .no_q
  26+ A127 CB C2            SET 0, D
  27+ A129              .no_q:
  28+ A129 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A12C ED 78            IN A, (C)
  30+ A12E CB 47            BIT 0, A            ; A = Abajo
  31+ A130 20 02            JR NZ, .no_a
  32+ A132 CB CA            SET 1, D
  33+ A134              .no_a:
  34+ A134 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A137 ED 78            IN A, (C)
  36+ A139 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A13B 20 02            JR NZ, .no_o
  38+ A13D CB DA            SET 3, D
  39+ A13F              .no_o:
  40+ A13F CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A141 20 02            JR NZ, .no_p
  42+ A143 CB D2            SET 2, D
  43+ A145              .no_p:
  44+ A145
  45+ A145                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A145                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A145 DB 1F            IN A, (31)
  48+ A147 4F               LD C, A             ; guardar para fire
  49+ A148 CB 5F            BIT 3, A            ; Up
  50+ A14A 28 02            JR Z, .no_k_up
  51+ A14C CB C2            SET 0, D
  52+ A14E              .no_k_up:
  53+ A14E CB 57            BIT 2, A            ; Down
  54+ A150 28 02            JR Z, .no_k_down
  55+ A152 CB CA            SET 1, D
  56+ A154              .no_k_down:
  57+ A154 CB 4F            BIT 1, A            ; Left
  58+ A156 28 02            JR Z, .no_k_left
  59+ A158 CB DA            SET 3, D
  60+ A15A              .no_k_left:
  61+ A15A CB 47            BIT 0, A            ; Right
  62+ A15C 28 02            JR Z, .no_k_right
  63+ A15E CB D2            SET 2, D
  64+ A160              .no_k_right:
  65+ A160 CB 61            BIT 4, C            ; Kempston Fire
  66+ A162 28 02            JR Z, .no_k_fire
  67+ A164 CB C3            SET 0, E
  68+ A166              .no_k_fire:
  69+ A166
  70+ A166                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A166                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A166 01 FE F7         LD BC, $F7FE
  73+ A169 ED 78            IN A, (C)
  74+ A16B CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A16D 20 02            JR NZ, .no_s1_up
  76+ A16F CB C2            SET 0, D
  77+ A171              .no_s1_up:
  78+ A171 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A173 20 02            JR NZ, .no_s1_down
  80+ A175 CB CA            SET 1, D
  81+ A177              .no_s1_down:
  82+ A177 CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A179 20 02            JR NZ, .no_s1_left
  84+ A17B CB DA            SET 3, D
  85+ A17D              .no_s1_left:
  86+ A17D CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A17F 20 02            JR NZ, .no_s1_right
  88+ A181 CB D2            SET 2, D
  89+ A183              .no_s1_right:
  90+ A183 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A185 20 02            JR NZ, .no_s1_fire
  92+ A187 CB C3            SET 0, E
  93+ A189              .no_s1_fire:
  94+ A189
  95+ A189                  ; -- 4. SPACE = Fire (teclado) --
  96+ A189 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A18C ED 78            IN A, (C)
  98+ A18E CB 47            BIT 0, A            ; SPACE
  99+ A190 20 02            JR NZ, .no_space
 100+ A192 CB C3            SET 0, E
 101+ A194              .no_space:
 102+ A194
 103+ A194                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A194 7B               LD A, E
 105+ A195 32 25 82         LD (InputFire), A
 106+ A198
 107+ A198                  ; -- 6. Cancelar opuestos --
 108+ A198 7A               LD A, D
 109+ A199 47               LD B, A
 110+ A19A E6 03            AND DIR_N | DIR_S
 111+ A19C FE 03            CP DIR_N | DIR_S
 112+ A19E 20 04            JR NZ, .noVC
 113+ A1A0 78               LD A, B
 114+ A1A1 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ A1A3 47               LD B, A
 116+ A1A4              .noVC:
 117+ A1A4 78               LD A, B
 118+ A1A5 E6 0C            AND DIR_E | DIR_W
 119+ A1A7 FE 0C            CP DIR_E | DIR_W
 120+ A1A9 20 04            JR NZ, .noHC
 121+ A1AB 78               LD A, B
 122+ A1AC E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ A1AE 47               LD B, A
 124+ A1AF              .noHC:
 125+ A1AF 78               LD A, B
 126+ A1B0 32 24 82         LD (InputDirection), A
 127+ A1B3 C9               RET
 128+ A1B4
 129+ A1B4              ; ==============================================================================
 130+ A1B4              ; InitEntities - Inicializa la tabla de entidades
 131+ A1B4              ; ==============================================================================
 132+ A1B4              ; Limpia todos los slots y configura el slot 0 como player.
 133+ A1B4              ; ==============================================================================
 134+ A1B4              InitEntities:
 135+ A1B4                  ; Limpiar toda la tabla a ceros
 136+ A1B4 21 14 81         LD HL, EntityTable
 137+ A1B7 11 15 81         LD DE, EntityTable + 1
 138+ A1BA 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ A1BD AF               XOR A
 140+ A1BE 77               LD (HL), A
 141+ A1BF ED B0            LDIR
 142+ A1C1
 143+ A1C1                  ; Limpiar tabla de atributos salvados
 144+ A1C1 21 37 9F         LD HL, SavedAttrTable
 145+ A1C4 11 38 9F         LD DE, SavedAttrTable + 1
 146+ A1C7 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ A1CA AF               XOR A
 148+ A1CB 77               LD (HL), A
 149+ A1CC ED B0            LDIR
 150+ A1CE
 151+ A1CE                  ; Configurar slot 0: Player
 152+ A1CE DD 21 14 81      LD IX, EntityTable
 153+ A1D2 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ A1D6 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ A1DA DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ A1DE DD 36 03 50      LD (IX+ENT_POSX), START_PLAYER_X
 157+ A1E2 DD 36 04 40      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ A1E6 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ A1EA DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ A1EE DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ A1F2 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ A1F6 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ A1FA DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ A1FE DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ A202 DD 36 0C 50      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ A206 DD 36 0D 40      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ A20A DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ A20E DD 36 0F 50      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ A212
 170+ A212                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ A212 3E 0C            LD A, SPAWN_INTERVAL
 172+ A214 32 44 82         LD (SpawnTimer), A
 173+ A217 AF               XOR A
 174+ A218 32 4F 82         LD (EnemyStepIdx), A
 175+ A21B 32 7B 5F         LD (PendingEraseCount), A
 176+ A21E C9               RET
 177+ A21F
 178+ A21F              ; ==============================================================================
 179+ A21F              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ A21F              ; ==============================================================================
 181+ A21F              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ A21F              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ A21F              ; que los pies parezcan hundirse en el suelo.
 184+ A21F              ; ==============================================================================
 185+ A21F              ComputePlayerDrawY:
 186+ A21F 3A 17 81         LD A, (EntityTable + ENT_POSX)
 187+ A222 C6 08            ADD A, 8                    ; center X del player
 188+ A224 47               LD B, A
 189+ A225 3A 18 81         LD A, (EntityTable + ENT_POSY)
 190+ A228 4F               LD C, A
 191+ A229 32 42 82         LD (PlayerDrawY), A         ; default: sin offset
 192+ A22C B7               OR A
 193+ A22D C8               RET Z
 194+ A22E 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ A22F CD 26 D1         CALL IsPointBlocked
 196+ A232 C8               RET Z                       ; libre → sin offset
 197+ A233 3A 18 81         LD A, (EntityTable + ENT_POSY)
 198+ A236 3C               INC A
 199+ A237 32 42 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ A23A C9               RET
 201+ A23B
 202+ A23B              ; ==============================================================================
 203+ A23B              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ A23B              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ A23B              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ A23B              ; no parecer que se hunde en el techo.
 207+ A23B              ; Preserva: IX. Destruye: AF, BC.
 208+ A23B              ; ==============================================================================
 209+ A23B              ComputeEnemyDrawY:
 210+ A23B DD 7E 04         LD A, (IX+ENT_POSY)
 211+ A23E 32 43 82         LD (EnemyDrawY), A          ; default = POSY
 212+ A241 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ A244 FE 02            CP TYPE_MONSTER
 214+ A246 C0               RET NZ                      ; no monster → sin offset
 215+ A247 DD 7E 03         LD A, (IX+ENT_POSX)
 216+ A24A C6 08            ADD A, 8                    ; center X
 217+ A24C 47               LD B, A
 218+ A24D DD 7E 04         LD A, (IX+ENT_POSY)
 219+ A250 4F               LD C, A
 220+ A251 B7               OR A
 221+ A252 C8               RET Z
 222+ A253 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ A254 CD 26 D1         CALL IsPointBlocked
 224+ A257 C8               RET Z                       ; libre → sin offset
 225+ A258 DD 7E 04         LD A, (IX+ENT_POSY)
 226+ A25B 3C               INC A
 227+ A25C 32 43 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ A25F C9               RET
 229+ A260
 230+ A260              ; ==============================================================================
 231+ A260              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 232+ A260              ; ==============================================================================
 233+ A260              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 234+ A260              ; ==============================================================================
 235+ A260              ProcessPlayer:
 236+ A260 DD 21 14 81      LD IX, EntityTable
 237+ A264
 238+ A264                  ; --- Fresh check ---
 239+ A264 3A 5F 82         LD A, (ScreenJustRedrawn)
 240+ A267 B7               OR A
 241+ A268 C2 3D A3         JP NZ, .plFresh
 242+ A26B DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 243+ A26F C2 3D A3         JP NZ, .plFresh
 244+ A272
 245+ A272                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 246+ A272 CD 02 A8         CALL UpdatePlayer
 247+ A275 CD 1B A7         CALL CalcDrawX
 248+ A278 CD 1F A2         CALL ComputePlayerDrawY
 249+ A27B
 250+ A27B                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 251+ A27B DD 7E 0F         LD A, (IX+ENT_DRAWX)
 252+ A27E DD BE 0C         CP (IX+ENT_OLDX)
 253+ A281 20 47            JR NZ, .plDoErase
 254+ A283 3A 42 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 255+ A286 DD BE 0D         CP (IX+ENT_OLDY)
 256+ A289 20 3F            JR NZ, .plDoErase
 257+ A28B DD 7E 00         LD A, (IX+ENT_SPRITEID)
 258+ A28E DD BE 0E         CP (IX+ENT_OLDSPRID)
 259+ A291 20 37            JR NZ, .plDoErase
 260+ A293                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 261+ A293 3A F0 C4         LD A, (PlayerHitTimer)
 262+ A296 B7               OR A
 263+ A297 20 01            JR NZ, .plRepaintAttr
 264+ A299 C9               RET                                 ; Nada cambio → skip todo
 265+ A29A              .plRepaintAttr:
 266+ A29A 3A 42 82         LD A, (PlayerDrawY)
 267+ A29D 57               LD D, A
 268+ A29E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 269+ A2A1 5F               LD E, A
 270+ A2A2 DD E5            PUSH IX
 271+ A2A4 CD 60 A7         CALL GetSpriteAddr
 272+ A2A7 DD 2A 8F A7      LD IX, (SpriteAddrTemp)
 273+ A2AB CD 64 9E         CALL CalcEntityAttrSize
 274+ A2AE                  ; Reducir altura de attrs en 1 para no invadir fila inferior
 275+ A2AE 3A 36 9F         LD A, (EntityAttrH)
 276+ A2B1 FE 02            CP 2
 277+ A2B3 38 04            JR C, .plAttrHOk
 278+ A2B5 3D               DEC A
 279+ A2B6 32 36 9F         LD (EntityAttrH), A
 280+ A2B9              .plAttrHOk:
 281+ A2B9 DD E1            POP IX
 282+ A2BB 3A 42 82         LD A, (PlayerDrawY)
 283+ A2BE 57               LD D, A
 284+ A2BF DD 7E 0F         LD A, (IX+ENT_DRAWX)
 285+ A2C2 5F               LD E, A
 286+ A2C3 DD 7E 05         LD A, (IX+ENT_ATTR)
 287+ A2C6 CD 37 9E         CALL SetEntityAttr
 288+ A2C9 C9               RET
 289+ A2CA
 290+ A2CA              .plDoErase:
 291+ A2CA                  ; --- Erase viejo ---
 292+ A2CA CD 91 A7         CALL GetOldSpriteAddr
