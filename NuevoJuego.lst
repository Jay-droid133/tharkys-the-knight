 504  E857                  INCLUDE "hud_clock.asm"
# file opened: hud_clock.asm
   1+ E857              ; ==============================================================================
   2+ E857              ; HUD CLOCK - Reloj analógico (filas 22-23, cols 13-18)
   3+ E857              ; ==============================================================================
   4+ E857              ; Sprite BgGfx_hud_clock: 48×16px (6 bytes ancho, 2 filas de chars)
