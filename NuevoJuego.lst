1451+ F4CD              ; ==============================================================================
1452+ F4CD              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1453+ F4CD              ; ==============================================================================
1454+ F4CD              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1455+ F4CD              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1456+ F4CD              ; ==============================================================================
1457+ F4CD              ChurchCutsceneEraseStatueAtLast:
1458+ F4CD              ChurchCutsceneDrawStatueAtLast:
1459+ F4CD 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1460+ F4D0 21 A9 69         LD HL, StatueIdTable
1461+ F4D3 5F               LD E, A
1462+ F4D4 16 00            LD D, 0
1463+ F4D6 19               ADD HL, DE
1464+ F4D7 7E               LD A, (HL)                              ; A = statue id
1465+ F4D8 B7               OR A
1466+ F4D9 C8               RET Z
1467+ F4DA                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1468+ F4DA 6F               LD L, A
1469+ F4DB 26 00            LD H, 0
1470+ F4DD 54               LD D, H
1471+ F4DE 5D               LD E, L
1472+ F4DF 29               ADD HL, HL
1473+ F4E0 19               ADD HL, DE                              ; HL = id*3
1474+ F4E1 11 D3 DF         LD DE, BgGfxPtrById
1475+ F4E4 19               ADD HL, DE
1476+ F4E5 5E               LD E, (HL)
1477+ F4E6 23               INC HL
1478+ F4E7 56               LD D, (HL)                              ; DE = sprite ptr
1479+ F4E8 23               INC HL
1480+ F4E9 7E               LD A, (HL)                              ; A = bank
1481+ F4EA EB               EX DE, HL                               ; HL = sprite ptr
1482+ F4EB CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
1483+ F4EE                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1484+ F4EE 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1485+ F4F1 57               LD D, A
1486+ F4F2 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1487+ F4F5 5F               LD E, A
1488+ F4F6 C3 31 6B         JP DrawBgSprite16XorAtPixel
1489+ F4F9
1490+ F4F9              ; ==============================================================================
1491+ F4F9              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1492+ F4F9              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1493+ F4F9              ;     A  = jitter signed (-1, 0, +1) en bits.
1494+ F4F9              ; ==============================================================================
1495+ F4F9              ; IN: A = jitter signed (-1, 0, +1) en bits.
1496+ F4F9              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1497+ F4F9              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1498+ F4F9              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1499+ F4F9              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1500+ F4F9              ; version shifted, sin XOR.
1501+ F4F9              ;
1502+ F4F9              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1503+ F4F9              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1504+ F4F9              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1505+ F4F9              ; estatua se perdio cuando la estatua se pinto la primera vez con
1506+ F4F9              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1507+ F4F9              ; de la estatua, el wall perdido no se ve.
1508+ F4F9              ;
1509+ F4F9              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1510+ F4F9              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1511+ F4F9              ; shift de 1 bit no pierde pixels visibles.
1512+ F4F9              ; Destruye: AF, BC, DE, HL, IX.
1513+ F4F9              ; ==============================================================================
1514+ F4F9              ChurchCutsceneShakeStatueByteShift:
1515+ F4F9 32 63 F5         LD (.csbsJitter), A
1516+ F4FC                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1517+ F4FC 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1518+ F4FF 5F               LD E, A
1519+ F500 16 00            LD D, 0
1520+ F502 19               ADD HL, DE
1521+ F503 7E               LD A, (HL)
1522+ F504 B7               OR A
1523+ F505 C8               RET Z                                   ; sin estatua
1524+ F506 6F               LD L, A
1525+ F507 26 00            LD H, 0
1526+ F509 54               LD D, H
1527+ F50A 5D               LD E, L
1528+ F50B 29               ADD HL, HL
1529+ F50C 19               ADD HL, DE                              ; HL = id*3
1530+ F50D 11 D3 DF         LD DE, BgGfxPtrById
1531+ F510 19               ADD HL, DE
1532+ F511 5E               LD E, (HL)
1533+ F512 23               INC HL
1534+ F513 56               LD D, (HL)                              ; DE = sprite ptr
1535+ F514 23               INC HL
1536+ F515 7E               LD A, (HL)                              ; A = bank
1537+ F516 EB               EX DE, HL                               ; HL = sprite ptr
1538+ F517 CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
1539+ F51A                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1540+ F51A DD 21 F8 86      LD IX, BgSpriteBuffer
1541+ F51E DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1542+ F521 B7               OR A
1543+ F522 C8               RET Z
1544+ F523 47               LD B, A                                 ; B = row counter
1545+ F524 DD 23            INC IX
1546+ F526 DD 23            INC IX                                  ; IX -> pixel data
1547+ F528                  ; Calcular addr VRAM en (origX, origY)
1548+ F528 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1549+ F52B 57               LD D, A
1550+ F52C 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1551+ F52F 5F               LD E, A
1552+ F530 CD 5D 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1553+ F533              .csbsRow:
1554+ F533 C5               PUSH BC
1555+ F534 E5               PUSH HL                                 ; save inicio fila VRAM
1556+ F535                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1557+ F535 DD 7E 00         LD A, (IX+0)
1558+ F538 2F               CPL
1559+ F539 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1560+ F53A DD 7E 01         LD A, (IX+1)
1561+ F53D 2F               CPL
1562+ F53E 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1563+ F53F                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1564+ F53F 3A 63 F5         LD A, (.csbsJitter)
1565+ F542 B7               OR A
1566+ F543 28 0D            JR Z, .csbsWrite                        ; sin shift
1567+ F545 FA 4E F5         JP M, .csbsLeft                         ; A < 0 -> shift left
1568+ F548                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1569+ F548 CB 3A            SRL D
1570+ F54A CB 1B            RR E
1571+ F54C 18 04            JR .csbsWrite
1572+ F54E              .csbsLeft:
1573+ F54E CB 23            SLA E
1574+ F550 CB 12            RL D
1575+ F552              .csbsWrite:
1576+ F552 7A               LD A, D
1577+ F553 77               LD (HL), A
1578+ F554 23               INC HL
1579+ F555 7B               LD A, E
1580+ F556 77               LD (HL), A
1581+ F557 E1               POP HL
1582+ F558 CD C9 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1583+ F55B DD 23            INC IX
1584+ F55D DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1585+ F55F C1               POP BC
1586+ F560 10 D1            DJNZ .csbsRow
1587+ F562 C9               RET
1588+ F563 00           .csbsJitter: DEFB 0
1589+ F564
1590+ F564              ; ==============================================================================
1591+ F564              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1592+ F564              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1593+ F564              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1594+ F564              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1595+ F564              ; Destruye: AF, BC, HL.
1596+ F564              ; ==============================================================================
1597+ F564              ChurchCutsceneEraseStatueDirect:
1598+ F564 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1599+ F567 57               LD D, A
1600+ F568 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1601+ F56B 5F               LD E, A
1602+ F56C CD 5D 9D         CALL CalcPixelAddr
1603+ F56F 06 18            LD B, 24                                ; statues son 24 px de alto
1604+ F571              .csedRow:
1605+ F571 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1606+ F572 77               LD (HL), A
1607+ F573 23               INC HL
1608+ F574 77               LD (HL), A
1609+ F575 2B               DEC HL                                  ; volver a inicio fila
1610+ F576 C5               PUSH BC
1611+ F577 CD C9 9A         CALL NextPixelLine
1612+ F57A C1               POP BC
1613+ F57B 10 F4            DJNZ .csedRow
1614+ F57D C9               RET
1615+ F57E
1616+ F57E              ; ==============================================================================
1617+ F57E              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1618+ F57E              ; ==============================================================================
1619+ F57E              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1620+ F57E              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1621+ F57E              ; suficiente para corromper visualmente).
1622+ F57E              ; IN: IX = entity ptr.
1623+ F57E              ; ==============================================================================
1624+ F57E              RedrawTrappedMonster:
1625+ F57E                  ; --- Erase viejo en (OLDX, OLDY) ---
1626+ F57E CD F7 A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1627+ F581 DD 7E 0D         LD A, (IX+ENT_OLDY)
1628+ F584 57               LD D, A
1629+ F585 DD 7E 0C         LD A, (IX+ENT_OLDX)
1630+ F588 5F               LD E, A
1631+ F589 DD E5            PUSH IX
1632+ F58B DD 2A 7F A4      LD IX, (OldSprAddr)
1633+ F58F CD EA 99         CALL DrawSprite
1634+ F592 DD E1            POP IX
1635+ F594                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1636+ F594                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1637+ F594 DD 56 0D         LD D, (IX+ENT_OLDY)
1638+ F597 DD 5E 0C         LD E, (IX+ENT_OLDX)
1639+ F59A CD 1F D3         CALL RestoreOldAttr
1640+ F59D                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1641+ F59D                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1642+ F59D                  ; reponer attrs de pickups que el flujo de entidades pisa con
1643+ F59D                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1644+ F59D                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1645+ F59D                  ; estar bajo el monster.
1646+ F59D DD E5            PUSH IX
1647+ F59F CD 29 DA         CALL RefreshPickupAttrs
1648+ F5A2 DD E1            POP IX
1649+ F5A4                  ; --- Compute new draw pos ---
1650+ F5A4 CD 81 A4         CALL CalcDrawX
1651+ F5A7 CD 19 9F         CALL ComputeEnemyDrawY
1652+ F5AA                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1653+ F5AA CD C6 A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1654+ F5AD 3A E0 82         LD A, (EnemyDrawY)
1655+ F5B0 57               LD D, A
1656+ F5B1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1657+ F5B4 5F               LD E, A
1658+ F5B5 DD E5            PUSH IX
1659+ F5B7 DD 2A F5 A4      LD IX, (SpriteAddrTemp)
1660+ F5BB CD 07 9B         CALL CalcEntityAttrSize
1661+ F5BE DD E1            POP IX
1662+ F5C0 3A E0 82         LD A, (EnemyDrawY)
1663+ F5C3 57               LD D, A
1664+ F5C4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1665+ F5C7 5F               LD E, A
1666+ F5C8 DD 7E 05         LD A, (IX+ENT_ATTR)
1667+ F5CB CD DA 9A         CALL SetEntityAttr
1668+ F5CE                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1669+ F5CE 3A E0 82         LD A, (EnemyDrawY)
1670+ F5D1 57               LD D, A
1671+ F5D2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1672+ F5D5 5F               LD E, A
1673+ F5D6 DD E5            PUSH IX
1674+ F5D8 DD 2A F5 A4      LD IX, (SpriteAddrTemp)
1675+ F5DC CD EA 99         CALL DrawSprite
1676+ F5DF DD E1            POP IX
1677+ F5E1                  ; --- Save OLD = current ---
1678+ F5E1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1679+ F5E4 DD 77 0C         LD (IX+ENT_OLDX), A
1680+ F5E7 3A E0 82         LD A, (EnemyDrawY)
1681+ F5EA DD 77 0D         LD (IX+ENT_OLDY), A
1682+ F5ED DD 7E 00         LD A, (IX+ENT_SPRITEID)
1683+ F5F0 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1684+ F5F3 C9               RET
