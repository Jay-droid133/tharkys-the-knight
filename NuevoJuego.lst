 360+ EBEE 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR
 361+ EBF0              .usbWriteAttr:
 362+ EBF0 32 99 81         LD (EntityTable + ENT_ATTR), A
 363+ EBF3 C9               RET
 364+ EBF4              .usbExpire:
