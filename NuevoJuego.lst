 257+ F207              ; ==============================================================================
 258+ F207              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 259+ F207              ; ==============================================================================
 260+ F207              ; IN:  A = key id (1..6)
 261+ F207              ; OUT: DE = ptr
 262+ F207              ; Destruye: AF, HL.
 263+ F207              ; ==============================================================================
 264+ F207              KeyIdToPtr:
 265+ F207 3D               DEC A
 266+ F208 87               ADD A, A                            ; *2 (DEFW size)
 267+ F209 6F               LD L, A
 268+ F20A 26 00            LD H, 0
 269+ F20C 11 E2 D9         LD DE, KeyLockTable
 270+ F20F 19               ADD HL, DE
 271+ F210 5E               LD E, (HL)
 272+ F211 23               INC HL
 273+ F212 56               LD D, (HL)
 274+ F213 C9               RET
 275+ F214
 276+ F214              ; ==============================================================================
 277+ F214              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 278+ F214              ; ==============================================================================
 279+ F214              ; IN:  A = action id (1, 2, ...)
 280+ F214              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 281+ F214              ;      Z flag set si no encontrado.
 282+ F214              ; Destruye: AF, BC, HL.
 283+ F214              ; ==============================================================================
 284+ F214              ActionToTriggerPtr:
 285+ F214 4F               LD C, A                             ; C = action id buscada
 286+ F215 21 70 DA         LD HL, BumpTriggerTable
 287+ F218              .attLoop:
 288+ F218 5E               LD E, (HL)
 289+ F219 23               INC HL
 290+ F21A 56               LD D, (HL)
 291+ F21B 23               INC HL                              ; HL -> required_key
 292+ F21C 7A               LD A, D
 293+ F21D B3               OR E
 294+ F21E 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 295+ F220 23               INC HL                              ; HL -> action
 296+ F221 7E               LD A, (HL)
 297+ F222 23               INC HL                              ; HL -> next entry
 298+ F223 B9               CP C
 299+ F224 20 F2            JR NZ, .attLoop
 300+ F226 F6 01            OR 1                                ; clear Z (encontrado)
 301+ F228 C9               RET
 302+ F229              .attNotFound:
 303+ F229 16 00            LD D, 0
 304+ F22B 1E 00            LD E, 0
 305+ F22D AF               XOR A                               ; set Z
 306+ F22E C9               RET
