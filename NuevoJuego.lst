 194+ 8EB7              ; Variables locales de DrawSprite
 195+ 8EB7 00           .posX:       DEFB 0
 196+ 8EB8 00           .posY:       DEFB 0
 197+ 8EB9 00           .widthSave:  DEFB 0
 198+ 8EBA 00           .heightSave: DEFB 0
 199+ 8EBB 00           .tablePage:  DEFB 0
 200+ 8EBC 00           .widthCount: DEFB 0
