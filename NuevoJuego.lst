 449+ F2B0 2E 02            LD L, 2
 450+ F2B2              .dcDxDone:
 451+ F2B2 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 452+ F2B3
 453+ F2B3                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 454+ F2B3 3A 69 82         LD A, (ObjectiveScreenY)
 455+ F2B6 47               LD B, A
