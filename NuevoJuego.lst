4826+ B9A5
4827+ B9A5              .spawnPosOk:
4828+ B9A5                  ; Velocidades aleatorias
4829+ B9A5 ED 5F            LD A, R
4830+ B9A7 CB 57            BIT 2, A
4831+ B9A9 28 07            JR Z, .dxPos
4832+ B9AB 3A 57 8D         LD A, (CurrentEnemySpeed)
4833+ B9AE ED 44            NEG
4834+ B9B0 18 03            JR .setDX
4835+ B9B2              .dxPos:
4836+ B9B2 3A 57 8D         LD A, (CurrentEnemySpeed)
4837+ B9B5              .setDX:
4838+ B9B5 DD 77 06         LD (IX+ENT_DELTAX), A
4839+ B9B8 ED 5F            LD A, R
4840+ B9BA CB 5F            BIT 3, A
4841+ B9BC 28 07            JR Z, .dyPos
4842+ B9BE 3A 57 8D         LD A, (CurrentEnemySpeed)
4843+ B9C1 ED 44            NEG
4844+ B9C3 18 03            JR .setDY
4845+ B9C5              .dyPos:
4846+ B9C5 3A 57 8D         LD A, (CurrentEnemySpeed)
4847+ B9C8              .setDY:
4848+ B9C8 DD 77 07         LD (IX+ENT_DELTAY), A
4849+ B9CB                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4850+ B9CB                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4851+ B9CB                  ; identicas y las nasties van en paralelo solapadas.
4852+ B9CB DD 7E 06         LD A, (IX+ENT_DELTAX)
4853+ B9CE E6 80            AND $80                             ; bit 7 = signo X
4854+ B9D0 47               LD B, A
4855+ B9D1 DD 7E 07         LD A, (IX+ENT_DELTAY)
4856+ B9D4 E6 80            AND $80                             ; bit 7 = signo Y
4857+ B9D6 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4858+ B9D7 B0               OR B                                ; A = signX(7) | signY(6)
4859+ B9D8 47               LD B, A
4860+ B9D9 3A F8 82         LD A, (LastSpawnDirSigns)
4861+ B9DC B8               CP B
4862+ B9DD 20 0C            JR NZ, .spawnDirOk
4863+ B9DF                  ; Coincide -> voltear DELTAY (negar)
4864+ B9DF DD 7E 07         LD A, (IX+ENT_DELTAY)
4865+ B9E2 ED 44            NEG
4866+ B9E4 DD 77 07         LD (IX+ENT_DELTAY), A
4867+ B9E7 78               LD A, B
4868+ B9E8 EE 40            XOR $40                             ; recalcular signs cacheados
4869+ B9EA 47               LD B, A
4870+ B9EB              .spawnDirOk:
4871+ B9EB 78               LD A, B
4872+ B9EC 32 F8 82         LD (LastSpawnDirSigns), A
4873+ B9EF
4874+ B9EF                  ; Inicializar old pos = pos actual
4875+ B9EF DD 7E 03         LD A, (IX+ENT_POSX)
4876+ B9F2 DD 77 0C         LD (IX+ENT_OLDX), A
4877+ B9F5 DD 77 0F         LD (IX+ENT_DRAWX), A
4878+ B9F8 DD 7E 04         LD A, (IX+ENT_POSY)
4879+ B9FB DD 77 0D         LD (IX+ENT_OLDY), A
4880+ B9FE DD 7E 00         LD A, (IX+ENT_SPRITEID)
4881+ BA01 DD 77 0E         LD (IX+ENT_OLDSPRID), A
