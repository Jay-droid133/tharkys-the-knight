 120+ DD5F              ; ==============================================================================
 121+ DD5F              ; UpdateGameClock
 122+ DD5F              ; ==============================================================================
 123+ DD5F              UpdateGameClock:
 124+ DD5F 21 C5 DB         LD HL, GameSubMinute
 125+ DD62 34               INC (HL)
 126+ DD63 3A C8 DB         LD A, (SubMinuteMax)
 127+ DD66 BE               CP (HL)
 128+ DD67 C0               RET NZ
 129+ DD68
 130+ DD68 AF               XOR A
 131+ DD69 32 C5 DB         LD (GameSubMinute), A
 132+ DD6C 21 C6 DB         LD HL, GameMinutes
 133+ DD6F 34               INC (HL)
 134+ DD70                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 135+ DD70                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 136+ DD70 3A C6 DB         LD A, (GameMinutes)
 137+ DD73 FE 3C            CP 60
 138+ DD75 C0               RET NZ
 139+ DD76
 140+ DD76 AF               XOR A
 141+ DD77 32 C6 DB         LD (GameMinutes), A
 142+ DD7A 21 C7 DB         LD HL, GameHours
 143+ DD7D 34               INC (HL)
 144+ DD7E 7E               LD A, (HL)
 145+ DD7F FE 18            CP 24
 146+ DD81 20 04            JR NZ, .checkPhase
 147+ DD83 AF               XOR A
 148+ DD84 32 C7 DB         LD (GameHours), A
 149+ DD87
 150+ DD87              .checkPhase:
 151+ DD87 3A C7 DB         LD A, (GameHours)
 152+ DD8A 21 D1 DB         LD HL, PhaseTable
 153+ DD8D 06 07            LD B, 7
 154+ DD8F              .phaseLoop:
 155+ DD8F BE               CP (HL)
 156+ DD90 28 05            JR Z, .phaseFound
 157+ DD92 23               INC HL
 158+ DD93 23               INC HL
 159+ DD94 10 F9            DJNZ .phaseLoop
 160+ DD96 C9               RET
 161+ DD97              .phaseFound:
 162+ DD97 23               INC HL
 163+ DD98 7E               LD A, (HL)
 164+ DD99 F5               PUSH AF
 165+ DD9A CD 07 D6         CALL SetTimeOfDay
 166+ DD9D F1               POP AF
 167+ DD9E FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 168+ DDA0 C0               RET NZ
 169+ DDA1                  ; Nuevo dia: incrementar ciclo
 170+ DDA1 21 95 A9         LD HL, DayCycleCount
 171+ DDA4 34               INC (HL)
 172+ DDA5 C9               RET
 173+ DDA6
 174+ DDA6              ; ==============================================================================
 175+ DDA6              ; SetClockToPhaseHour
 176+ DDA6              ; ==============================================================================
 177+ DDA6              SetClockToPhaseHour:
 178+ DDA6 21 CA DB         LD HL, PhaseStartHour
 179+ DDA9 4F               LD C, A
 180+ DDAA 06 00            LD B, 0
 181+ DDAC 09               ADD HL, BC
 182+ DDAD 7E               LD A, (HL)
 183+ DDAE 32 C7 DB         LD (GameHours), A
 184+ DDB1 AF               XOR A
 185+ DDB2 32 C6 DB         LD (GameMinutes), A
 186+ DDB5 32 C5 DB         LD (GameSubMinute), A
 187+ DDB8 C9               RET
 188+ DDB9
 189+ DDB9              ; ==============================================================================
 190+ DDB9              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 191+ DDB9              ; ==============================================================================
 192+ DDB9              DrawClockHUD:
 193+ DDB9 CD E6 DD         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 194+ DDBC
 195+ DDBC                  ; --- Aguja de horas ---
 196+ DDBC 3A C7 DB         LD A, (GameHours)
 197+ DDBF FE 0C            CP 12
 198+ DDC1 38 02            JR C, .hourOk
 199+ DDC3 D6 0C            SUB 12
 200+ DDC5              .hourOk:
 201+ DDC5 21 C3 DC         LD HL, HourHandPtrs
 202+ DDC8 CD CD DF         CALL DrawHandLine
 203+ DDCB
 204+ DDCB                  ; --- Aguja de minutos ---
 205+ DDCB 3A C6 DB         LD A, (GameMinutes)
 206+ DDCE 06 00            LD B, 0
