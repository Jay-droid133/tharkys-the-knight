5517+ BD4F              ; ==============================================================================
5518+ BD4F              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5519+ BD4F              ; ==============================================================================
5520+ BD4F              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5521+ BD4F              ; ==============================================================================
5522+ BD4F
5523+ BD4F              ; ==============================================================================
5524+ BD4F              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5525+ BD4F              ; ==============================================================================
5526+ BD4F              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5527+ BD4F              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5528+ BD4F              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5529+ BD4F              ; ==============================================================================
5530+ BD4F              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5531+ BD4F              ; ==============================================================================
5532+ BD4F              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5533+ BD4F              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5534+ BD4F              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5535+ BD4F              ; ==============================================================================
5536+ BD4F              MONSTERS_TO_SPAWN   EQU 3
5537+ BD4F              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5538+ BD4F              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5539+ BD4F
5540+ BD4F              ; ==============================================================================
5541+ BD4F              ; SpawnMonsters - Primera aparicion tras campanadas
5542+ BD4F              ; ==============================================================================
5543+ BD4F              SpawnMonsters:
5544+ BD4F                  IF DEBUG_NO_ENEMIES
5545+ BD4F ~                RET
5546+ BD4F                  ENDIF
5547+ BD4F 3A 5B B3         LD A, (MonstersActive)
5548+ BD52 B7               OR A
5549+ BD53 C0               RET NZ
5550+ BD54                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5551+ BD54                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5552+ BD54 CD 30 BA         CALL KillAllActiveNasties
5553+ BD57 3E 01            LD A, 1
5554+ BD59 32 5B B3         LD (MonstersActive), A
5555+ BD5C CD D9 BD         CALL ShuffleMonsterTypes
5556+ BD5F DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5557+ BD63 06 03            LD B, MONSTERS_TO_SPAWN
5558+ BD65 0E 00            LD C, 0
5559+ BD67              .smLoop:
5560+ BD67 C5               PUSH BC
5561+ BD68 DD 7E 01         LD A, (IX+ENT_TYPE)
5562+ BD6B B7               OR A
5563+ BD6C C2 C8 BD         JP NZ, .smSkip
5564+ BD6F                  ; Asignar tipo y color
5565+ BD6F 79               LD A, C
5566+ BD70 21 3D BE         LD HL, MonsterTypeTable
5567+ BD73 5F               LD E, A
5568+ BD74 16 00            LD D, 0
5569+ BD76 19               ADD HL, DE
5570+ BD77 7E               LD A, (HL)
5571+ BD78 DD 77 08         LD (IX+ENT_ANIMBASE), A
5572+ BD7B 79               LD A, C
5573+ BD7C 21 40 BE         LD HL, MonsterColorTable
5574+ BD7F 5F               LD E, A
5575+ BD80 16 00            LD D, 0
5576+ BD82 19               ADD HL, DE
5577+ BD83 7E               LD A, (HL)
5578+ BD84 DD 77 05         LD (IX+ENT_ATTR), A
5579+ BD87                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5580+ BD87 C5               PUSH BC
5581+ BD88 CD BB 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5582+ BD8B B7               OR A
5583+ BD8C 20 0E            JR NZ, .smFallbackPos
5584+ BD8E 3A C3 97         LD A, (MaiSpawnX)
5585+ BD91 DD 77 03         LD (IX+ENT_POSX), A
5586+ BD94 3A C4 97         LD A, (MaiSpawnY)
5587+ BD97 DD 77 04         LD (IX+ENT_POSY), A
5588+ BD9A 18 0C            JR .smPosDone
5589+ BD9C              .smFallbackPos:
5590+ BD9C 3A 11 83         LD A, (LastEntryPosX)
5591+ BD9F DD 77 03         LD (IX+ENT_POSX), A
5592+ BDA2 3A 12 83         LD A, (LastEntryPosY)
5593+ BDA5 DD 77 04         LD (IX+ENT_POSY), A
5594+ BDA8              .smPosDone:
5595+ BDA8 C1               POP BC
5596+ BDA9                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5597+ BDA9 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5598+ BDAD DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5599+ BDB1 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5600+ BDB5 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5601+ BDB9 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5602+ BDBD                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5603+ BDBD                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5604+ BDBD                  ; lo empuje a un vecino (migracion por knockback).
5605+ BDBD CD B0 8E         CALL MaiGetCurrentScreenId
5606+ BDC0 21 8A 8D         LD HL, MonsterRoomId
5607+ BDC3 59               LD E, C
5608+ BDC4 16 00            LD D, 0
5609+ BDC6 19               ADD HL, DE
5610+ BDC7 77               LD (HL), A
5611+ BDC8              .smSkip:
5612+ BDC8 11 10 00         LD DE, ENT_SIZE
5613+ BDCB DD 19            ADD IX, DE
5614+ BDCD C1               POP BC
5615+ BDCE 0C               INC C
5616+ BDCF 05               DEC B
5617+ BDD0 C2 67 BD         JP NZ, .smLoop
5618+ BDD3 3E 14            LD A, MONSTER_ENTRY_BASE
5619+ BDD5 32 27 BF         LD (TryRespawnMonsters.rmTimer), A
5620+ BDD8                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5621+ BDD8                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5622+ BDD8                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5623+ BDD8 C9               RET
5624+ BDD9
5625+ BDD9              ; --- Barajar tablas tipo/color ---
5626+ BDD9              ShuffleMonsterTypes:
5627+ BDD9 ED 5F            LD A, R
5628+ BDDB E6 03            AND 3
5629+ BDDD C8               RET Z
5630+ BDDE FE 01            CP 1
5631+ BDE0 28 21            JR Z, .shSwap01
5632+ BDE2 FE 02            CP 2
5633+ BDE4 28 3A            JR Z, .shSwap12
5634+ BDE6 3A 3D BE         LD A, (MonsterTypeTable)
5635+ BDE9 57               LD D, A
5636+ BDEA 3A 3F BE         LD A, (MonsterTypeTable + 2)
5637+ BDED 32 3D BE         LD (MonsterTypeTable), A
5638+ BDF0 7A               LD A, D
5639+ BDF1 32 3F BE         LD (MonsterTypeTable + 2), A
5640+ BDF4 3A 40 BE         LD A, (MonsterColorTable)
5641+ BDF7 57               LD D, A
5642+ BDF8 3A 42 BE         LD A, (MonsterColorTable + 2)
5643+ BDFB 32 40 BE         LD (MonsterColorTable), A
5644+ BDFE 7A               LD A, D
5645+ BDFF 32 42 BE         LD (MonsterColorTable + 2), A
5646+ BE02 C9               RET
5647+ BE03              .shSwap01:
5648+ BE03 3A 3D BE         LD A, (MonsterTypeTable)
5649+ BE06 57               LD D, A
5650+ BE07 3A 3E BE         LD A, (MonsterTypeTable + 1)
5651+ BE0A 32 3D BE         LD (MonsterTypeTable), A
5652+ BE0D 7A               LD A, D
5653+ BE0E 32 3E BE         LD (MonsterTypeTable + 1), A
5654+ BE11 3A 40 BE         LD A, (MonsterColorTable)
5655+ BE14 57               LD D, A
5656+ BE15 3A 41 BE         LD A, (MonsterColorTable + 1)
5657+ BE18 32 40 BE         LD (MonsterColorTable), A
5658+ BE1B 7A               LD A, D
5659+ BE1C 32 41 BE         LD (MonsterColorTable + 1), A
5660+ BE1F C9               RET
5661+ BE20              .shSwap12:
5662+ BE20 3A 3E BE         LD A, (MonsterTypeTable + 1)
5663+ BE23 57               LD D, A
5664+ BE24 3A 3F BE         LD A, (MonsterTypeTable + 2)
5665+ BE27 32 3E BE         LD (MonsterTypeTable + 1), A
5666+ BE2A 7A               LD A, D
5667+ BE2B 32 3F BE         LD (MonsterTypeTable + 2), A
5668+ BE2E 3A 41 BE         LD A, (MonsterColorTable + 1)
5669+ BE31 57               LD D, A
5670+ BE32 3A 42 BE         LD A, (MonsterColorTable + 2)
5671+ BE35 32 41 BE         LD (MonsterColorTable + 1), A
5672+ BE38 7A               LD A, D
5673+ BE39 32 42 BE         LD (MonsterColorTable + 2), A
5674+ BE3C C9               RET
5675+ BE3D
5676+ BE3D              MonsterTypeTable:
5677+ BE3D 4C               DEFB SPRID_MONSTER_0
5678+ BE3E 54               DEFB SPRID_MONSTER_1
5679+ BE3F 5C               DEFB SPRID_MONSTER_2
5680+ BE40              MonsterColorTable:
5681+ BE40 44               DEFB $44                            ; Zombi: verde
5682+ BE41 46               DEFB $46                            ; Skeleton: amarillo
5683+ BE42 45               DEFB $45                            ; Ghost: cyan
5684+ BE43
5685+ BE43              ; ==============================================================================
5686+ BE43              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5687+ BE43              ; ==============================================================================
5688+ BE43              TryRespawnMonsters:
5689+ BE43                  IF DEBUG_NO_ENEMIES
5690+ BE43 ~                RET
5691+ BE43                  ENDIF
5692+ BE43 3A D3 E2         LD A, (CurrentTimeOfDay)
5693+ BE46 FE 03            CP 3
5694+ BE48 28 05            JR Z, .rmNight
5695+ BE4A FE 04            CP 4
5696+ BE4C 28 01            JR Z, .rmNight
5697+ BE4E C9               RET
5698+ BE4F              .rmNight:
5699+ BE4F 3A 5B B3         LD A, (MonstersActive)
5700+ BE52 B7               OR A
5701+ BE53 C8               RET Z
5702+ BE54 CD 2B BF         CALL .rmUpdateReturnTimers
5703+ BE57 3A 27 BF         LD A, (.rmTimer)
5704+ BE5A B7               OR A
5705+ BE5B 28 05            JR Z, .rmCheckSlots
5706+ BE5D 3D               DEC A
5707+ BE5E 32 27 BF         LD (.rmTimer), A
5708+ BE61 C9               RET
5709+ BE62              .rmCheckSlots:
5710+ BE62 DD 21 AE 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5711+ BE66 06 03            LD B, MONSTERS_TO_SPAWN
5712+ BE68 0E 00            LD C, 0
5713+ BE6A              .rmLoop:
5714+ BE6A C5               PUSH BC
5715+ BE6B DD 7E 01         LD A, (IX+ENT_TYPE)
5716+ BE6E B7               OR A
5717+ BE6F C2 1B BF         JP NZ, .rmSkip
5718+ BE72                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
