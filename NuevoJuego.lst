 679+ F21C                  ; --- MAGIC HUD ---
 680+ F21C                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F21C                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F21C                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F21C                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F21C                  ;
 685+ F21C                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F21C                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F21C                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F21C                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F21C                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F21C                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F21C                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F21C 3A CA 82         LD A, (MagicCompassPermanent)
 693+ F21F B7               OR A
 694+ F220 28 11            JR Z, .dcMagicTemp
 695+ F222                  ; --- Lasting (permanente, post-iglesia) ---
 696+ F222 3A C1 5F         LD A, (MagicCompassPathDir)
