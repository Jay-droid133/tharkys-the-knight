 328+ F947              ; ==============================================================================
 329+ F947              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 330+ F947              ; ==============================================================================
 331+ F947              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 332+ F947              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 333+ F947              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 334+ F947              ; resuelve KillAllActiveNasties de StartBankCutscene).
 335+ F947              ; Destruye: AF, BC, DE, HL, IX.
 336+ F947              ; ==============================================================================
 337+ F947              UpdateBankCutscene:
 338+ F947 3A CC 82         LD A, (BankCutscenePhase)
 339+ F94A FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 340+ F94C CA 95 F9         JP Z, .bcPhWaitNasties
 341+ F94F FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 342+ F951 CA 1E FB         JP Z, .bcPhDoorClosed
 343+ F954 3D               DEC A
 344+ F955 CA AF F9         JP Z, .bcPhLock
 345+ F958 3D               DEC A
 346+ F959 CA CD F9         JP Z, .bcPhKnocks1
 347+ F95C 3D               DEC A
 348+ F95D CA E2 F9         JP Z, .bcPhWait1
 349+ F960 3D               DEC A
 350+ F961 CA 03 FA         JP Z, .bcPhKnocks2
 351+ F964 3D               DEC A
 352+ F965 CA 18 FA         JP Z, .bcPhWait2
 353+ F968 3D               DEC A
 354+ F969 CA 3A FA         JP Z, .bcPhTurnToCam
 355+ F96C 3D               DEC A
 356+ F96D CA 5E FA         JP Z, .bcPhTurnToDoor
 357+ F970 3D               DEC A
 358+ F971 CA 80 FA         JP Z, .bcPhKnocks3
 359+ F974 3D               DEC A
 360+ F975 CA 95 FA         JP Z, .bcPhWait3
 361+ F978 3D               DEC A
 362+ F979 CA A7 FA         JP Z, .bcPhPreHand
 363+ F97C 3D               DEC A
 364+ F97D CA C6 FA         JP Z, .bcPhHandIn
 365+ F980 3D               DEC A
 366+ F981 CA D5 FA         JP Z, .bcPhHandNoNo
 367+ F984 3D               DEC A
 368+ F985 CA 06 FB         JP Z, .bcPhHandOut
 369+ F988 3D               DEC A
 370+ F989 CA 3E FB         JP Z, .bcPhKeyDrop
 371+ F98C 3D               DEC A
 372+ F98D CA 63 FB         JP Z, .bcPhPlayerTurnCam
 373+ F990                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 374+ F990 AF               XOR A
 375+ F991 32 CC 82         LD (BankCutscenePhase), A
 376+ F994 C9               RET
