 704+ A57D 77               LD (HL), A
 705+ A57E 18 4F            JR .peScaredSpriteToggle
 706+ A580              .peShakeActive:
 707+ A580                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 708+ A580 ED 5F            LD A, R
 709+ A582 E6 03            AND 3
 710+ A584 28 0C            JR Z, .peShakeUp
 711+ A586 3D               DEC A
 712+ A587 28 0F            JR Z, .peShakeDown
 713+ A589 3D               DEC A
 714+ A58A 28 12            JR Z, .peShakeLeft
 715+ A58C                  ; 3: right
 716+ A58C 06 01            LD B, 1
 717+ A58E 0E 00            LD C, 0
 718+ A590 18 10            JR .peShakeApply
 719+ A592              .peShakeUp:
 720+ A592 06 00            LD B, 0
 721+ A594 0E FF            LD C, -1
 722+ A596 18 0A            JR .peShakeApply
 723+ A598              .peShakeDown:
 724+ A598 06 00            LD B, 0
 725+ A59A 0E 01            LD C, 1
 726+ A59C 18 04            JR .peShakeApply
 727+ A59E              .peShakeLeft:
 728+ A59E 06 FF            LD B, -1
 729+ A5A0 0E 00            LD C, 0
 730+ A5A2              .peShakeApply:
 731+ A5A2                  ; new POSX = orig + B, new POSY = orig + C
 732+ A5A2 21 97 5F         LD HL, MonsterShakeOrigX
 733+ A5A5 19               ADD HL, DE
 734+ A5A6 7E               LD A, (HL)
 735+ A5A7 80               ADD A, B
