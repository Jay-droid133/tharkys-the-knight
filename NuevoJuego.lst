2022+ F975              ; ==============================================================================
2023+ F975              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2024+ F975              ; ==============================================================================
2025+ F975              ; IN:  B = PathDir, C = PathCoord
2026+ F975              ; OUT: BgSpriteBuffer poblado con sprite
2027+ F975              ; Destruye: AF, DE, HL. Preserva BC.
2028+ F975              ;
2029+ F975              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2030+ F975              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2031+ F975              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2032+ F975              ; ==============================================================================
2033+ F975              LoadHintSprite:
2034+ F975 78               LD A, B
2035+ F976 FE 02            CP 2                                ; W?
2036+ F978 28 12            JR Z, .lhsW
2037+ F97A FE 03            CP 3                                ; E?
2038+ F97C 28 1D            JR Z, .lhsE
2039+ F97E                  ; N o S -> tabla base
2040+ F97E 87               ADD A, A                            ; *2
2041+ F97F 5F               LD E, A
2042+ F980 16 00            LD D, 0
2043+ F982 21 AD F9         LD HL, HintArrowPtrs
2044+ F985 19               ADD HL, DE
2045+ F986 5E               LD E, (HL)
2046+ F987 23               INC HL
2047+ F988 56               LD D, (HL)
2048+ F989 EB               EX DE, HL                           ; HL = sprite ptr
2049+ F98A 18 1C            JR .lhsLoad
2050+ F98C              .lhsW:
2051+ F98C 79               LD A, C
2052+ F98D FE 07            CP 7
2053+ F98F 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2054+ F991 21 33 F6         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
2055+ F994 18 12            JR .lhsLoad
2056+ F996              .lhsWBase:
2057+ F996 21 0A F6         LD HL, BgGfx_arrow_2x2_west
2058+ F999 18 0D            JR .lhsLoad
2059+ F99B              .lhsE:
2060+ F99B 79               LD A, C
2061+ F99C FE 07            CP 7
2062+ F99E 30 05            JR NC, .lhsEBase
2063+ F9A0 21 E9 F6         LD HL, BgGfx_arrow_2x3_east
2064+ F9A3 18 03            JR .lhsLoad
2065+ F9A5              .lhsEBase:
2066+ F9A5 21 C0 F6         LD HL, BgGfx_arrow_2x2_east
2067+ F9A8              .lhsLoad:
2068+ F9A8 3E 03            LD A, 3                             ; bank 3 (bg_gfx.asm)
2069+ F9AA C3 CA 67         JP LoadBgSpriteToBuffer             ; tail call (preserva BC)
