 503+ E62C              ; --- Helpers ---
 504+ E62C              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E62C              .drawDec2:
 506+ E62C 4B               LD C, E                     ; guardar columna inicial
 507+ E62D 06 00            LD B, 0                     ; decenas
 508+ E62F              .divLoop:
 509+ E62F FE 0A            CP 10
 510+ E631 38 05            JR C, .divDone
 511+ E633 D6 0A            SUB 10
 512+ E635 04               INC B
 513+ E636 18 F7            JR .divLoop
 514+ E638              .divDone:
 515+ E638                  ; B = decenas, A = unidades
 516+ E638 F5               PUSH AF                     ; guardar unidades
 517+ E639 78               LD A, B
 518+ E63A C6 30            ADD A, '0'
 519+ E63C 59               LD E, C
 520+ E63D C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E63E CD 74 E7         CALL DrawHudChar
 522+ E641 C1               POP BC                      ; restaurar C
 523+ E642 F1               POP AF
 524+ E643 C6 30            ADD A, '0'
 525+ E645 59               LD E, C
 526+ E646 1C               INC E
 527+ E647 C3 74 E7         JP DrawHudChar              ; tail call
