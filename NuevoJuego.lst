6726+ C807              ; ==============================================================================
6727+ C807              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6728+ C807              ; ==============================================================================
6729+ C807              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6730+ C807              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6731+ C807              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6732+ C807              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6733+ C807              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6734+ C807              ; main.asm; aqui no hace falta guard adicional).
6735+ C807              ; ==============================================================================
6736+ C807
6737+ C807              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6738+ C807              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6739+ C807              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6740+ C807              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6741+ C807              ;
6742+ C807              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6743+ C807              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6744+ C807              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6745+ C807              ;
6746+ C807              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6747+ C807              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6748+ C807              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6749+ C807              ; en vez de 8 + orientacion invertida).
6750+ C807              UpdateDeath:
6751+ C807                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6752+ C807                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6753+ C807                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6754+ C807                  ; progreso real, no solo quedar inmovil. ---
6755+ C807 2A A4 82         LD HL, (DeathGhostStuckTimer)
6756+ C80A 23               INC HL
6757+ C80B 22 A4 82         LD (DeathGhostStuckTimer), HL
6758+ C80E 7C               LD A, H
6759+ C80F FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6760+ C811 38 1A            JR C, .udGhostCheckDone
6761+ C813 20 05            JR NZ, .udGhostOn
6762+ C815 7D               LD A, L
6763+ C816 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6764+ C818 38 13            JR C, .udGhostCheckDone
6765+ C81A              .udGhostOn:
6766+ C81A                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6767+ C81A                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6768+ C81A                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6769+ C81A                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6770+ C81A                  ; re-disparar restart).
6771+ C81A 3A A6 82         LD A, (DeathGhostMode)
6772+ C81D B7               OR A
6773+ C81E 20 0D            JR NZ, .udGhostCheckDone
6774+ C820 3E 01            LD A, 1
6775+ C822 32 A6 82         LD (DeathGhostMode), A
6776+ C825 32 2B 9D         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6777+ C828 3E FE            LD A, $FE                       ; sentinel restart-current-track
6778+ C82A CD 05 9D         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6779+ C82D              .udGhostCheckDone:
6780+ C82D
6781+ C82D                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6782+ C82D 3A A6 82         LD A, (DeathGhostMode)
6783+ C830 B7               OR A
6784+ C831 C2 78 C8         JP NZ, DeathGhostChase
