 475+ F28F
 476+ F28F                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 477+ F28F                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 478+ F28F                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 479+ F28F                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 480+ F28F                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 481+ F28F                  ; nuevo idx.
 482+ F28F                  ; Counter == 0 -> sin override, idx = target.
 483+ F28F                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 484+ F28F                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 485+ F28F                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 486+ F28F 3A 70 F3         LD A, (.dcSpriteIdx)
 487+ F292 FE 04            CP 4
 488+ F294 20 06            JR NZ, .dcWobbleNotX
 489+ F296                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 490+ F296                  ; frame no redibuje innecesariamente.
 491+ F296 AF               XOR A
 492+ F297 32 6C 82         LD (CompassWobbleCounter), A
 493+ F29A 18 46            JR .dcWobbleEnd
 494+ F29C              .dcWobbleNotX:
 495+ F29C                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 496+ F29C 3A AD 82         LD A, (CurrentScreenX)
 497+ F29F 47               LD B, A
 498+ F2A0 3A 6A 82         LD A, (LastCompassScreenX)
 499+ F2A3 B8               CP B
 500+ F2A4 20 0A            JR NZ, .dcWobbleStart
 501+ F2A6 3A AE 82         LD A, (CurrentScreenY)
 502+ F2A9 47               LD B, A
 503+ F2AA 3A 6B 82         LD A, (LastCompassScreenY)
 504+ F2AD B8               CP B
 505+ F2AE 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 506+ F2B0              .dcWobbleStart:
 507+ F2B0 3E 09            LD A, 9
 508+ F2B2 32 6C 82         LD (CompassWobbleCounter), A
 509+ F2B5              .dcWobbleResolve:
 510+ F2B5 3A 6C 82         LD A, (CompassWobbleCounter)
 511+ F2B8 B7               OR A
 512+ F2B9 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 513+ F2BB 3D               DEC A
 514+ F2BC 32 6C 82         LD (CompassWobbleCounter), A
 515+ F2BF                                                      ; A = phase 0..8 (1 frame por fase)
 516+ F2BF 21 C9 F7         LD HL, WobblePhaseTable
 517+ F2C2 5F               LD E, A
 518+ F2C3 16 00            LD D, 0
 519+ F2C5 19               ADD HL, DE
 520+ F2C6 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 521+ F2C7 FE 02            CP 2
 522+ F2C9 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 523+ F2CB                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 524+ F2CB                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 525+ F2CB FE 03            CP 3
 526+ F2CD 38 01            JR C, .dcWobbleOffsetReady
 527+ F2CF 3D               DEC A
 528+ F2D0              .dcWobbleOffsetReady:
 529+ F2D0 5F               LD E, A
 530+ F2D1 3A 70 F3         LD A, (.dcSpriteIdx)
 531+ F2D4 87               ADD A, A                            ; idx*2
 532+ F2D5 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 533+ F2D6 83               ADD A, E                            ; +offset
 534+ F2D7 21 A5 F7         LD HL, CompassWobbleTable
 535+ F2DA 5F               LD E, A
 536+ F2DB 16 00            LD D, 0
 537+ F2DD 19               ADD HL, DE
 538+ F2DE 7E               LD A, (HL)
 539+ F2DF 32 70 F3         LD (.dcSpriteIdx), A                ; override
 540+ F2E2
 541+ F2E2              .dcWobbleEnd:
 542+ F2E2
 543+ F2E2                  ; --- Magic compass override ---
 544+ F2E2                  ; Si MagicCompassTimer != 0 AND idx != 4 (no estamos en sala destino),
 545+ F2E2                  ; se sobrescribe idx con la dir del path BFS (cardinal pura) y el attr
 546+ F2E2                  ; pasa a paper amarillo blink. En sala destino (idx 4) y sin path
 547+ F2E2                  ; ($FF), se cae al render normal (X blanca) — coincide con el diseño.
 548+ F2E2 3A BF 5F         LD A, (MagicCompassTimer)
 549+ F2E5 47               LD B, A
 550+ F2E6 3A C0 5F         LD A, (MagicCompassTimer + 1)
 551+ F2E9 B0               OR B
 552+ F2EA 28 30            JR Z, .dcMagicOff                   ; magic inactivo
 553+ F2EC 3A 70 F3         LD A, (.dcSpriteIdx)
 554+ F2EF FE 04            CP 4
 555+ F2F1 28 29            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 556+ F2F3 3A C1 5F         LD A, (MagicCompassPathDir)
 557+ F2F6 FE FF            CP $FF
 558+ F2F8 28 22            JR Z, .dcMagicOff                   ; sin path → fallback al render normal
 559+ F2FA                  ; Mapear dir a sprite idx: 0=N→1, 1=E→5, 2=S→7, 3=W→3
 560+ F2FA B7               OR A
 561+ F2FB 20 04            JR NZ, .dcMagicNotN
 562+ F2FD 3E 01            LD A, 1
 563+ F2FF 18 10            JR .dcMagicSetIdx
 564+ F301              .dcMagicNotN:
 565+ F301 3D               DEC A
 566+ F302 20 04            JR NZ, .dcMagicNotE
 567+ F304 3E 05            LD A, 5
 568+ F306 18 09            JR .dcMagicSetIdx
 569+ F308              .dcMagicNotE:
 570+ F308 3D               DEC A
 571+ F309 20 04            JR NZ, .dcMagicW
 572+ F30B 3E 07            LD A, 7
 573+ F30D 18 02            JR .dcMagicSetIdx
 574+ F30F              .dcMagicW:
 575+ F30F 3E 03            LD A, 3
 576+ F311              .dcMagicSetIdx:
 577+ F311 32 70 F3         LD (.dcSpriteIdx), A
 578+ F314                  ; Attr blink: paper amarillo ON ($70) / OFF ($30) según fase
 579+ F314 CD 03 72         CALL GetMagicCompassAttr
 580+ F317 32 72 F3         LD (.dcAttr), A
 581+ F31A 18 24            JR .dcAttrDone
 582+ F31C
 583+ F31C              .dcMagicOff:
 584+ F31C                  ; --- Color normal ---
 585+ F31C                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 586+ F31C 3A 70 F3         LD A, (.dcSpriteIdx)
 587+ F31F FE 04            CP 4
 588+ F321 28 18            JR Z, .dcWhite
 589+ F323 3A 69 82         LD A, (PreviousObjectiveDistance)
 590+ F326 FE FF            CP $FF
 591+ F328 28 11            JR Z, .dcWhite
 592+ F32A 47               LD B, A
 593+ F32B 3A 71 F3         LD A, (.dcDistance)
 594+ F32E B8               CP B
 595+ F32F 28 0A            JR Z, .dcWhite                      ; igual = blanco
 596+ F331 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 597+ F333 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 598+ F335 18 06            JR .dcColorDone
 599+ F337              .dcGreen:
 600+ F337 3E 44            LD A, GREEN | $40
 601+ F339 18 02            JR .dcColorDone
 602+ F33B              .dcWhite:
 603+ F33B 3E 47            LD A, WHITE | $40
 604+ F33D              .dcColorDone:
 605+ F33D 32 72 F3         LD (.dcAttr), A
 606+ F340              .dcAttrDone:
