 184+ F004
 185+ F004              ; ==============================================================================
 186+ F004              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->7->0 (debug)
 187+ F004              ; ==============================================================================
 188+ F004              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 189+ F004              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 190+ F004              ; inmediato del valor actual.
 191+ F004              ;
 192+ F004              ; Rango: 1..6 son keys clasicas (forest/ruins/cemetery/clock/church/towngate),
 193+ F004              ; 7 es BankCheck (cheque del banco, slot 7 en KeyLockTable). Util para
 194+ F004              ; probar el bump trigger del banco sin tener que completar M7 antes.
 195+ F004              ;
 196+ F004              ; NOTA: ciclar K dentro de la sala de un lock NO permite abrir ese lock
 197+ F004              ; (el CollisionMap se construye al ENTRAR a la sala con el CurrentKey
 198+ F004              ; del momento; cambiarlo despues no rebuild walls). Para probar locks,
 199+ F004              ; ciclar K en una sala distinta y luego cruzar al room del lock.
 200+ F004              ; ==============================================================================
 201+ F004              CheckCurrentKeyCycleKey:
 202+ F004 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 203+ F006 DB FE            IN A, ($FE)
 204+ F008 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 205+ F00A 20 17            JR NZ, .ckcNotPressed
 206+ F00C 3A 28 F0         LD A, (CurrentKeyCycleDebounce)
 207+ F00F B7               OR A
 208+ F010 C0               RET NZ
 209+ F011 3E 01            LD A, 1
 210+ F013 32 28 F0         LD (CurrentKeyCycleDebounce), A
 211+ F016 3A B3 82         LD A, (CurrentKey)
 212+ F019 3C               INC A
 213+ F01A FE 08            CP 8
 214+ F01C 38 01            JR C, .ckcSet                       ; 1..7 dentro de rango (7 = BankCheck)
 215+ F01E AF               XOR A                               ; 8 -> wrap a 0
 216+ F01F              .ckcSet:
 217+ F01F 32 B3 82         LD (CurrentKey), A
 218+ F022 C9               RET
 219+ F023              .ckcNotPressed:
 220+ F023 AF               XOR A
 221+ F024 32 28 F0         LD (CurrentKeyCycleDebounce), A
 222+ F027 C9               RET
 223+ F028
 224+ F028 00           CurrentKeyCycleDebounce: DEFB 0
 225+ F029
 226+ F029              ; ==============================================================================
 227+ F029              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ F029              ; ==============================================================================
 229+ F029              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ F029              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ F029              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ F029              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ F029              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ F029              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ F029              ;               actuales; queda como salvaguarda.
 236+ F029              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ F029              ; Destruye: AF, BC, DE, HL.
 238+ F029              ; ==============================================================================
 239+ F029              ResolveObjectiveScreen:
 240+ F029 3A BC 82         LD A, (CurrentObjective)
 241+ F02C FE 0B            CP 11
 242+ F02E 30 4D            JR NC, .rosNoTarget
 243+ F030 87               ADD A, A
 244+ F031 6F               LD L, A
 245+ F032 26 00            LD H, 0
 246+ F034 11 4D EF         LD DE, MilestoneResolveTable
 247+ F037 19               ADD HL, DE
 248+ F038 7E               LD A, (HL)                          ; tipo
 249+ F039 23               INC HL
 250+ F03A 46               LD B, (HL)                          ; B = ref
 251+ F03B FE 01            CP MILESTONE_TYPE_PICKUP
 252+ F03D 28 06            JR Z, .rosPickup
 253+ F03F FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ F041 28 08            JR Z, .rosTrigger
 255+ F043 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ F045              .rosPickup:
 257+ F045 78               LD A, B
 258+ F046 CD 86 F0         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ F049 18 10            JR .rosFindPos
 260+ F04B              .rosTrigger:
 261+ F04B 78               LD A, B
 262+ F04C FE 04            CP 4
 263+ F04E 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ F050 FE 03            CP 3
 265+ F052 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ F054                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ F054                                                      ;  Necesario para que la lasting compass tras
 268+ F054                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ F054 CD 93 F0         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ F057 7A               LD A, D
 271+ F058 B3               OR E
 272+ F059 28 22            JR Z, .rosNoTarget
 273+ F05B              .rosFindPos:
 274+ F05B CD AE F0         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ F05E 78               LD A, B
 276+ F05F 32 BD 82         LD (ObjectiveScreenX), A
 277+ F062 79               LD A, C
 278+ F063 32 BE 82         LD (ObjectiveScreenY), A
 279+ F066 C9               RET
 280+ F067              .rosBankRoom:
 281+ F067                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ F067                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ F067 3E 08            LD A, BCS_BANK_ROOM_X
 284+ F069 32 BD 82         LD (ObjectiveScreenX), A
 285+ F06C 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ F06E 32 BE 82         LD (ObjectiveScreenY), A
 287+ F071 C9               RET
 288+ F072              .rosTownGateRoom:
 289+ F072                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ F072                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ F072                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ F072 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ F074 32 BD 82         LD (ObjectiveScreenX), A
 294+ F077 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ F079 32 BE 82         LD (ObjectiveScreenY), A
 296+ F07C C9               RET
 297+ F07D              .rosNoTarget:
 298+ F07D 3E FF            LD A, $FF
 299+ F07F 32 BD 82         LD (ObjectiveScreenX), A
 300+ F082 32 BE 82         LD (ObjectiveScreenY), A
 301+ F085 C9               RET
 302+ F086
 303+ F086              ; ==============================================================================
 304+ F086              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 305+ F086              ; ==============================================================================
 306+ F086              ; IN:  A = key id (1..6)
 307+ F086              ; OUT: DE = ptr
 308+ F086              ; Destruye: AF, HL.
 309+ F086              ; ==============================================================================
 310+ F086              KeyIdToPtr:
 311+ F086 3D               DEC A
 312+ F087 87               ADD A, A                            ; *2 (DEFW size)
 313+ F088 6F               LD L, A
 314+ F089 26 00            LD H, 0
 315+ F08B 11 8A D7         LD DE, KeyLockTable
 316+ F08E 19               ADD HL, DE
 317+ F08F 5E               LD E, (HL)
 318+ F090 23               INC HL
 319+ F091 56               LD D, (HL)
 320+ F092 C9               RET
 321+ F093
 322+ F093              ; ==============================================================================
 323+ F093              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 324+ F093              ; ==============================================================================
 325+ F093              ; IN:  A = action id (1, 2, ...)
 326+ F093              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 327+ F093              ;      Z flag set si no encontrado.
 328+ F093              ; Destruye: AF, BC, HL.
 329+ F093              ; ==============================================================================
 330+ F093              ActionToTriggerPtr:
 331+ F093 4F               LD C, A                             ; C = action id buscada
 332+ F094 21 22 D8         LD HL, BumpTriggerTable
 333+ F097              .attLoop:
 334+ F097 5E               LD E, (HL)
 335+ F098 23               INC HL
 336+ F099 56               LD D, (HL)
 337+ F09A 23               INC HL                              ; HL -> required_key
 338+ F09B 7A               LD A, D
 339+ F09C B3               OR E
 340+ F09D 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 341+ F09F 23               INC HL                              ; HL -> action
 342+ F0A0 7E               LD A, (HL)
 343+ F0A1 23               INC HL                              ; HL -> next entry
 344+ F0A2 B9               CP C
 345+ F0A3 20 F2            JR NZ, .attLoop
 346+ F0A5 F6 01            OR 1                                ; clear Z (encontrado)
 347+ F0A7 C9               RET
 348+ F0A8              .attNotFound:
 349+ F0A8 16 00            LD D, 0
 350+ F0AA 1E 00            LD E, 0
 351+ F0AC AF               XOR A                               ; set Z
 352+ F0AD C9               RET
 353+ F0AE
 354+ F0AE              ; ==============================================================================
 355+ F0AE              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 356+ F0AE              ; ==============================================================================
 357+ F0AE              ; PickupTable layout (per-entry, 7 bytes):
 358+ F0AE              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 359+ F0AE              ; Terminator: $FF (single byte).
 360+ F0AE              ;
 361+ F0AE              ; IN:  DE = ptr a buscar
 362+ F0AE              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 363+ F0AE              ;      B = C = $FF si no encontrado (Z).
 364+ F0AE              ; Destruye: AF, HL. Preserva DE.
 365+ F0AE              ; ==============================================================================
 366+ F0AE              FindPickupScreen:
 367+ F0AE 21 ED DF         LD HL, PickupTable
 368+ F0B1              .fpsLoop:
 369+ F0B1 7E               LD A, (HL)
 370+ F0B2 FE FF            CP $FF
 371+ F0B4 28 1C            JR Z, .fpsNotFound
 372+ F0B6 E5               PUSH HL
 373+ F0B7 23               INC HL                              ; -> mapY
 374+ F0B8 23               INC HL                              ; -> ptr_lo
 375+ F0B9 7E               LD A, (HL)
 376+ F0BA BB               CP E
 377+ F0BB 20 0C            JR NZ, .fpsNoMatch
 378+ F0BD 23               INC HL                              ; -> ptr_hi
 379+ F0BE 7E               LD A, (HL)
 380+ F0BF BA               CP D
 381+ F0C0 20 07            JR NZ, .fpsNoMatch
 382+ F0C2 E1               POP HL                              ; back to entry start (mapX)
 383+ F0C3 46               LD B, (HL)                          ; B = mapX
 384+ F0C4 23               INC HL
 385+ F0C5 4E               LD C, (HL)                          ; C = mapY
 386+ F0C6 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 387+ F0C8 C9               RET
 388+ F0C9              .fpsNoMatch:
 389+ F0C9 E1               POP HL
 390+ F0CA C5               PUSH BC
 391+ F0CB 01 07 00         LD BC, 7
 392+ F0CE 09               ADD HL, BC
 393+ F0CF C1               POP BC
 394+ F0D0 18 DF            JR .fpsLoop
 395+ F0D2              .fpsNotFound:
 396+ F0D2 06 FF            LD B, $FF
 397+ F0D4 0E FF            LD C, $FF
 398+ F0D6 AF               XOR A                               ; set Z
 399+ F0D7 C9               RET
 400+ F0D8
 401+ F0D8              ; ==============================================================================
 402+ F0D8              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 403+ F0D8              ; ==============================================================================
 404+ F0D8              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 405+ F0D8              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 406+ F0D8              ; third). El brujula se redibuja solo cuando:
 407+ F0D8              ;   - cambias de pantalla (LastCompassScreen != Current)
 408+ F0D8              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 409+ F0D8              ; En reposo es un no-op barato (solo unas comparaciones).
 410+ F0D8              ;
 411+ F0D8              ; Color (atributo de las 4 celdas):
 412+ F0D8              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 413+ F0D8              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 414+ F0D8              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 415+ F0D8              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 416+ F0D8              ;
 417+ F0D8              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 418+ F0D8              ; ==============================================================================
 419+ F0D8
 420+ F0D8              COMPASS_COL     EQU 24
 421+ F0D8              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 422+ F0D8
 423+ F0D8              ; ==============================================================================
 424+ F0D8              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F0D8              ; ==============================================================================
 426+ F0D8              ; Formato:
 427+ F0D8              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F0D8              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F0D8              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F0D8              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F0D8              ; ==============================================================================
 432+ F0D8              DrawMilestoneHUD:
 433+ F0D8 3A BC 82         LD A, (CurrentObjective)
 434+ F0DB FE 0B            CP 11
 435+ F0DD 28 26            JR Z, .mhAllDone
 436+ F0DF 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F0E0 06 00            LD B, 0                     ; B = decenas
 438+ F0E2              .mhDivLoop:
 439+ F0E2 FE 0A            CP 10
 440+ F0E4 38 05            JR C, .mhDivDone
 441+ F0E6 D6 0A            SUB 10
 442+ F0E8 04               INC B
 443+ F0E9 18 F7            JR .mhDivLoop
 444+ F0EB              .mhDivDone:
 445+ F0EB F5               PUSH AF                     ; A = unidades
 446+ F0EC 78               LD A, B
 447+ F0ED B7               OR A
 448+ F0EE 20 04            JR NZ, .mhTensDigit
 449+ F0F0 3E 20            LD A, ' '                   ; tens=0 -> blanco
 450+ F0F2 18 02            JR .mhWriteTens
 451+ F0F4              .mhTensDigit:
 452+ F0F4 C6 30            ADD A, '0'
 453+ F0F6              .mhWriteTens:
 454+ F0F6 1E 1E            LD E, 30
 455+ F0F8 CD DE E6         CALL DrawHudCharRow0
 456+ F0FB F1               POP AF                      ; A = unidades
 457+ F0FC C6 30            ADD A, '0'
 458+ F0FE 1E 1F            LD E, 31
 459+ F100 CD DE E6         CALL DrawHudCharRow0
 460+ F103 18 0E            JR .mhAttrs
 461+ F105              .mhAllDone:
 462+ F105 3E 4F            LD A, 'O'
 463+ F107 1E 1E            LD E, 30
 464+ F109 CD DE E6         CALL DrawHudCharRow0
 465+ F10C 3E 4B            LD A, 'K'
 466+ F10E 1E 1F            LD E, 31
 467+ F110 CD DE E6         CALL DrawHudCharRow0
 468+ F113              .mhAttrs:
 469+ F113 3E 47            LD A, $47                   ; bright white
 470+ F115 32 1E 58         LD (ATTR_BASE + 30), A
