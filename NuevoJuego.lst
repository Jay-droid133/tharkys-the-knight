 819+ 6474              ; ==============================================================================
 820+ 6474              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 821+ 6474              ; ==============================================================================
 822+ 6474              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 823+ 6474              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 824+ 6474              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 825+ 6474              ; 2. Compute new offset random.
 826+ 6474              ; 3. Draw at new offset.
 827+ 6474              ; Destruye: AF, BC, DE, HL, IX.
 828+ 6474              ; ==============================================================================
 829+ 6474              TownGateShakeStep:
 830+ 6474 CD BC 64         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 831+ 6477 CD D7 64         CALL TownGateDrawFingerShifted
 832+ 647A                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 833+ 647A ED 5F            LD A, R
 834+ 647C E6 03            AND $03
 835+ 647E 21 9F 64         LD HL, .tgssJitterTable
 836+ 6481 5F               LD E, A
 837+ 6482 16 00            LD D, 0
 838+ 6484 19               ADD HL, DE
 839+ 6485 7E               LD A, (HL)
 840+ 6486 32 A6 5F         LD (TownGateShakeOffsX), A
 841+ 6489 3A 33 81         LD A, (GameFrameCounter)
 842+ 648C E6 03            AND $03
 843+ 648E 21 9F 64         LD HL, .tgssJitterTable
 844+ 6491 5F               LD E, A
 845+ 6492 16 00            LD D, 0
 846+ 6494 19               ADD HL, DE
 847+ 6495 7E               LD A, (HL)
 848+ 6496 32 A7 5F         LD (TownGateShakeOffsY), A
 849+ 6499 CD BC 64         CALL TownGateDrawArmShifted          ; draw at new offset
 850+ 649C C3 D7 64         JP TownGateDrawFingerShifted
 851+ 649F              .tgssJitterTable:
 852+ 649F 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 853+ 64A3
 854+ 64A3              ; ==============================================================================
 855+ 64A3              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 856+ 64A3              ; ==============================================================================
 857+ 64A3              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 858+ 64A3              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 859+ 64A3              ; ==============================================================================
 860+ 64A3              TownGateShakeRestore:
 861+ 64A3 CD BC 64         CALL TownGateDrawArmShifted          ; erase last shifted
 862+ 64A6 CD D7 64         CALL TownGateDrawFingerShifted
 863+ 64A9 AF               XOR A
 864+ 64AA 32 A6 5F         LD (TownGateShakeOffsX), A
 865+ 64AD 32 A7 5F         LD (TownGateShakeOffsY), A
 866+ 64B0 11 E7 E5         LD DE, BgGfx_arm
 867+ 64B3 CD EE D9         CALL RedrawPickupByPtr               ; restore at PickupTable position
 868+ 64B6 11 34 E6         LD DE, BgGfx_finger
 869+ 64B9 C3 EE D9         JP RedrawPickupByPtr
 870+ 64BC
 871+ 64BC              ; ==============================================================================
 872+ 64BC              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 873+ 64BC              ; ==============================================================================
 874+ 64BC              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 875+ 64BC              ; Destruye: AF, BC, DE, HL, IX.
 876+ 64BC              ; ==============================================================================
 877+ 64BC              TownGateDrawArmShifted:
 878+ 64BC 21 E7 E5         LD HL, BgGfx_arm
 879+ 64BF 3E 03            LD A, 3
 880+ 64C1 CD 41 6A         CALL LoadBgSpriteToBuffer
 881+ 64C4 3A A6 5F         LD A, (TownGateShakeOffsX)
 882+ 64C7 47               LD B, A
 883+ 64C8 3E 88            LD A, TGCS_ARM_PX_X
 884+ 64CA 80               ADD A, B
 885+ 64CB 5F               LD E, A
 886+ 64CC 3A A7 5F         LD A, (TownGateShakeOffsY)
 887+ 64CF 47               LD B, A
 888+ 64D0 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 889+ 64D2 80               ADD A, B
 890+ 64D3 57               LD D, A
 891+ 64D4 C3 F2 64         JP DrawBgSpriteAnyXorAtPixel
 892+ 64D7
 893+ 64D7              ; ==============================================================================
 894+ 64D7              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 895+ 64D7              ; ==============================================================================
 896+ 64D7              TownGateDrawFingerShifted:
 897+ 64D7 21 34 E6         LD HL, BgGfx_finger
 898+ 64DA 3E 03            LD A, 3
 899+ 64DC CD 41 6A         CALL LoadBgSpriteToBuffer
 900+ 64DF 3A A6 5F         LD A, (TownGateShakeOffsX)
 901+ 64E2 47               LD B, A
 902+ 64E3 3E 88            LD A, TGCS_FINGER_PX_X
 903+ 64E5 80               ADD A, B
 904+ 64E6 5F               LD E, A
 905+ 64E7 3A A7 5F         LD A, (TownGateShakeOffsY)
 906+ 64EA 47               LD B, A
 907+ 64EB 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 908+ 64ED 80               ADD A, B
 909+ 64EE 57               LD D, A
 910+ 64EF C3 F2 64         JP DrawBgSpriteAnyXorAtPixel
 911+ 64F2
 912+ 64F2              ; ==============================================================================
 913+ 64F2              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 914+ 64F2              ; ==============================================================================
 915+ 64F2              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 916+ 64F2              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 917+ 64F2              ;     E = pixel X (0..255).
 918+ 64F2              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 919+ 64F2              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 920+ 64F2              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 921+ 64F2              ; Destruye: AF, BC, DE, HL, IX.
 922+ 64F2              ; ==============================================================================
 923+ 64F2              DrawBgSpriteAnyXorAtPixel:
 924+ 64F2 DD 21 7C 89      LD IX, BgSpriteBuffer
 925+ 64F6 DD 7E 00         LD A, (IX+0)                        ; height_px
 926+ 64F9 B7               OR A
 927+ 64FA C8               RET Z
 928+ 64FB 32 55 65         LD (.dbsaHeight), A
 929+ 64FE DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 930+ 6501 E6 7F            AND $7F
 931+ 6503 32 56 65         LD (.dbsaWidth), A
 932+ 6506 DD 23            INC IX
 933+ 6508 DD 23            INC IX                              ; -> pixel data
 934+ 650A 7B               LD A, E
 935+ 650B E6 07            AND $07
 936+ 650D 32 57 65         LD (.dbsaShift), A
 937+ 6510 7B               LD A, E
 938+ 6511 E6 F8            AND $F8
 939+ 6513 5F               LD E, A
 940+ 6514 CD 41 A1         CALL CalcPixelAddr                  ; HL = VRAM addr
 941+ 6517              .dbsaRow:
 942+ 6517 E5               PUSH HL
 943+ 6518 3A 56 65         LD A, (.dbsaWidth)
 944+ 651B 47               LD B, A                             ; B = width counter
 945+ 651C 0E 00            LD C, 0                             ; C = carry from prev byte
 946+ 651E              .dbsaByte:
 947+ 651E DD 7E 00         LD A, (IX+0)
 948+ 6521 2F               CPL                                 ; un-invert
 949+ 6522 57               LD D, A                             ; D = sprite byte
 950+ 6523 1E 00            LD E, 0                             ; E = bits que caen al next byte
 951+ 6525 3A 57 65         LD A, (.dbsaShift)
 952+ 6528 B7               OR A
 953+ 6529 28 09            JR Z, .dbsaNoShift
 954+ 652B C5               PUSH BC
 955+ 652C 47               LD B, A
 956+ 652D              .dbsaShiftLoop:
 957+ 652D CB 3A            SRL D
 958+ 652F CB 1B            RR E
 959+ 6531 10 FA            DJNZ .dbsaShiftLoop
 960+ 6533 C1               POP BC
 961+ 6534              .dbsaNoShift:
 962+ 6534 7A               LD A, D
 963+ 6535 B1               OR C                                ; combinar con carry previo
 964+ 6536 AE               XOR (HL)
 965+ 6537 77               LD (HL), A
 966+ 6538 23               INC HL
 967+ 6539 4B               LD C, E                             ; nuevo carry para siguiente byte
 968+ 653A DD 23            INC IX
 969+ 653C 10 E0            DJNZ .dbsaByte
 970+ 653E                  ; Byte final (carry) si shift > 0
 971+ 653E 3A 57 65         LD A, (.dbsaShift)
 972+ 6541 B7               OR A
 973+ 6542 28 03            JR Z, .dbsaNoFinal
 974+ 6544 79               LD A, C
 975+ 6545 AE               XOR (HL)
 976+ 6546 77               LD (HL), A
 977+ 6547              .dbsaNoFinal:
 978+ 6547 E1               POP HL
 979+ 6548 CD AD 9E         CALL NextPixelLine
 980+ 654B 3A 55 65         LD A, (.dbsaHeight)
 981+ 654E 3D               DEC A
 982+ 654F 32 55 65         LD (.dbsaHeight), A
 983+ 6552 20 C3            JR NZ, .dbsaRow
 984+ 6554 C9               RET
 985+ 6555 00           .dbsaHeight: DEFB 0
 986+ 6556 00           .dbsaWidth:  DEFB 0
 987+ 6557 00           .dbsaShift:  DEFB 0
 988+ 6558
 989+ 6558              ; ==============================================================================
 990+ 6558              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 991+ 6558              ; ==============================================================================
 992+ 6558              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 993+ 6558              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 994+ 6558              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 995+ 6558              ; visualmente la mitad inferior del player desaparece tras la HUD.
 996+ 6558              ; ==============================================================================
 997+ 6558              TownGateExitStep:
 998+ 6558 3A A8 5F         LD A, (TownGateExitStepCnt)
 999+ 655B 3C               INC A
1000+ 655C 32 A8 5F         LD (TownGateExitStepCnt), A
1001+ 655F FE 02            CP TGCS_T_EXIT_STEP
1002+ 6561 D8               RET C                               ; aun no toca step
1003+ 6562 AF               XOR A
1004+ 6563 32 A8 5F         LD (TownGateExitStepCnt), A
1005+ 6566                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1006+ 6566 DD 21 36 81      LD IX, EntityTable
1007+ 656A DD 7E 04         LD A, (IX+ENT_POSY)
1008+ 656D 3C               INC A
1009+ 656E DD 77 04         LD (IX+ENT_POSY), A
1010+ 6571 32 64 82         LD (PlayerDrawY), A
1011+ 6574 3A A9 5F         LD A, (TownGateExitWalkFrame)
1012+ 6577 EE 01            XOR 1                               ; toggle 0/1
1013+ 6579 32 A9 5F         LD (TownGateExitWalkFrame), A
1014+ 657C 47               LD B, A
1015+ 657D 3E 0E            LD A, SPRID_WALK_S
1016+ 657F 80               ADD A, B
1017+ 6580 DD 77 00         LD (IX+ENT_SPRITEID), A
1018+ 6583                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1019+ 6583                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1020+ 6583                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1021+ 6583                  ; part1 attrs ni de door attrs.
1022+ 6583 CD F5 63         CALL TownGatePlayerSlideErase
1023+ 6586 C3 2B 64         JP TownGatePlayerSlideDraw          ; tail call
1024+ 6589
1025+ 6589              ; ==============================================================================
1026+ 6589              ; TownGateDrawTheEnd - dibuja el sprite "The End" (id 243) en (10,4)
1027+ 6589              ; ==============================================================================
1028+ 6589              ; Bank 3. El sprite "the end" (88x72) esta RLE-comprimido (bit 7 de
1029+ 6589              ; width_bytes set), asi que NO podemos usar DrawBgSpriteXOR (no decodifica
1030+ 6589              ; RLE — produce distorsion). Usamos DrawBgGfxSprite, la rutina normal de
1031+ 6589              ; render BG: decodifica RLE + pinta pixels (direct write) + attrs.
1032+ 6589              ; Destruye: AF, BC, DE, HL, IX.
1033+ 6589              ; ==============================================================================
1034+ 6589              TownGateDrawTheEnd:
1035+ 6589 21 42 E6         LD HL, BgGfx_the_end
1036+ 658C 3E 03            LD A, 3
1037+ 658E CD 41 6A         CALL LoadBgSpriteToBuffer
1038+ 6591 DD 21 7C 89      LD IX, BgSpriteBuffer
1039+ 6595 06 0B            LD B, TGCS_END_CHARX
1040+ 6597 0E 04            LD C, TGCS_END_CHARY
1041+ 6599 AF               XOR A
1042+ 659A 32 98 E4         LD (BgSpriteIsHouse), A
1043+ 659D 32 FB D4         LD (CurrentTintVar), A              ; sin tint
1044+ 65A0 C3 F1 D3         JP DrawBgGfxSprite
1045+ 65A3
1046+ 65A3              ; ==============================================================================
1047+ 65A3              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1048+ 65A3              ; ==============================================================================
1049+ 65A3              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1050+ 65A3              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1051+ 65A3              ; quedara visible sobre fondo negro.
1052+ 65A3              ; ==============================================================================
1053+ 65A3              TownGateWipeBlack:
1054+ 65A3 21 00 40         LD HL, $4000
1055+ 65A6 11 01 40         LD DE, $4001
1056+ 65A9 01 FF 17         LD BC, $17FF
1057+ 65AC 36 00            LD (HL), 0
1058+ 65AE ED B0            LDIR
1059+ 65B0 21 00 58         LD HL, $5800
1060+ 65B3 11 01 58         LD DE, $5801
1061+ 65B6 01 FF 02         LD BC, $02FF
1062+ 65B9 36 00            LD (HL), $00                        ; ink black, paper black
1063+ 65BB ED B0            LDIR
1064+ 65BD C9               RET
1065+ 65BE
1066+ 65BE              ; ==============================================================================
1067+ 65BE              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1068+ 65BE              ; ==============================================================================
1069+ 65BE              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1070+ 65BE              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1071+ 65BE              ; (white ink, black paper, bright) para todo el area de texto.
1072+ 65BE              ; ==============================================================================
1073+ 65BE              TownGateDrawCredits:
1074+ 65BE                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1075+ 65BE 21 00 58         LD HL, $5800
1076+ 65C1 11 01 58         LD DE, $5801
1077+ 65C4 01 FF 02         LD BC, $02FF
1078+ 65C7 36 47            LD (HL), $47
1079+ 65C9 ED B0            LDIR
1080+ 65CB                  ; Iterar credits
1081+ 65CB 21 1F 66         LD HL, TownGateCreditsData
1082+ 65CE              .tgdcLoop:
1083+ 65CE 7E               LD A, (HL)
1084+ 65CF FE FF            CP $FF
1085+ 65D1 C8               RET Z
1086+ 65D2 57               LD D, A                             ; D = row
1087+ 65D3 23               INC HL
1088+ 65D4 7E               LD A, (HL)
1089+ 65D5 5F               LD E, A                             ; E = col
1090+ 65D6 23               INC HL                              ; HL → string
1091+ 65D7 CD DC 65         CALL PrintStringFontAt
1092+ 65DA 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1093+ 65DC
1094+ 65DC              ; ==============================================================================
1095+ 65DC              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1096+ 65DC              ; ==============================================================================
1097+ 65DC              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1098+ 65DC              ; siguiente byte tras el 0 (para que el caller siga iterando).
1099+ 65DC              ; Destruye: AF, BC, DE, HL.
1100+ 65DC              ; OUT: HL apunta al byte tras el 0 terminador.
1101+ 65DC              ; ==============================================================================
1102+ 65DC              PrintStringFontAt:
1103+ 65DC              .psfaCharLoop:
1104+ 65DC 7E               LD A, (HL)
1105+ 65DD 23               INC HL
1106+ 65DE B7               OR A
1107+ 65DF C8               RET Z                               ; fin de string
1108+ 65E0 E5               PUSH HL
1109+ 65E1 D5               PUSH DE
1110+ 65E2 CD EA 65         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1111+ 65E5 D1               POP DE
1112+ 65E6 E1               POP HL
1113+ 65E7 1C               INC E                               ; siguiente columna
1114+ 65E8 18 F2            JR .psfaCharLoop
1115+ 65EA
1116+ 65EA              ; ==============================================================================
1117+ 65EA              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1118+ 65EA              ; ==============================================================================
1119+ 65EA              ; D = row (0..23), E = col (0..31), A = ASCII char.
1120+ 65EA              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1121+ 65EA              ;   y = row * 8, x = col * 8
1122+ 65EA              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1123+ 65EA              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1124+ 65EA              ; Destruye: AF, BC, DE, HL.
1125+ 65EA              ; ==============================================================================
1126+ 65EA              DrawCharFontAt:
1127+ 65EA D5               PUSH DE
1128+ 65EB                  ; HL = $3C00 + char * 8
1129+ 65EB 6F               LD L, A
1130+ 65EC 26 00            LD H, 0
1131+ 65EE 29               ADD HL, HL
1132+ 65EF 29               ADD HL, HL
1133+ 65F0 29               ADD HL, HL
1134+ 65F1 01 00 3C         LD BC, $3C00
1135+ 65F4 09               ADD HL, BC
1136+ 65F5 D1               POP DE
1137+ 65F6                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1138+ 65F6 E5               PUSH HL                             ; save font ptr
1139+ 65F7 7A               LD A, D
1140+ 65F8 87               ADD A, A
1141+ 65F9 87               ADD A, A
1142+ 65FA 87               ADD A, A                            ; A = row * 8 = pixel Y
1143+ 65FB 57               LD D, A
1144+ 65FC 7B               LD A, E
1145+ 65FD 87               ADD A, A
1146+ 65FE 87               ADD A, A
1147+ 65FF 87               ADD A, A                            ; A = col * 8 = pixel X
1148+ 6600 5F               LD E, A
1149+ 6601 CD 41 A1         CALL CalcPixelAddr                  ; HL = VRAM addr
1150+ 6604 EB               EX DE, HL                           ; DE = VRAM addr
1151+ 6605 E1               POP HL                              ; HL = font ptr
1152+ 6606 06 08            LD B, 8
1153+ 6608              .dcfaLoop:
1154+ 6608 7E               LD A, (HL)
1155+ 6609 12               LD (DE), A
1156+ 660A 23               INC HL
1157+ 660B 14               INC D                               ; siguiente scan line (within char)
1158+ 660C 10 FA            DJNZ .dcfaLoop
1159+ 660E C9               RET
1160+ 660F
1161+ 660F              ; ==============================================================================
