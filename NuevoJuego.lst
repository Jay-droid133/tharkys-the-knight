2627+ DA53              ; GetPickupKeyBehavior - Devuelve el comportamiento de un pickup según su sprite
2628+ DA53              ; ==============================================================================
2629+ DA53              ; IN:  DE = BgGfx pointer
2630+ DA53              ; OUT: A = 0 (normal), 1..7 (key), 8..13 (lock con key requerida = A-7)
2631+ DA53              ; Preserva: BC, DE, HL. Slots con DEFW 0 nunca matchean (DE es ptr válido != 0).
2632+ DA53              ; ==============================================================================
2633+ DA53              GetPickupKeyBehavior:
2634+ DA53 E5               PUSH HL
2635+ DA54 C5               PUSH BC
2636+ DA55 21 99 D7         LD HL, KeyLockTable
2637+ DA58 06 0D            LD B, 13                    ; 13 slots (insertado BankCheck en slot 7)
2638+ DA5A 0E 01            LD C, 1                     ; id actual (1..13)
2639+ DA5C              .gpkbLoop:
2640+ DA5C 7E               LD A, (HL)                  ; ptr_lo del slot
2641+ DA5D BB               CP E
2642+ DA5E 20 06            JR NZ, .gpkbNext
2643+ DA60 23               INC HL
2644+ DA61 7E               LD A, (HL)                  ; ptr_hi
2645+ DA62 2B               DEC HL
2646+ DA63 BA               CP D
2647+ DA64 28 09            JR Z, .gpkbFound
2648+ DA66              .gpkbNext:
2649+ DA66 23               INC HL
2650+ DA67 23               INC HL                      ; siguiente slot (DEFW = 2 bytes)
2651+ DA68 0C               INC C
2652+ DA69 10 F1            DJNZ .gpkbLoop
2653+ DA6B AF               XOR A                       ; no encontrado → comportamiento normal
2654+ DA6C C1               POP BC
2655+ DA6D E1               POP HL
2656+ DA6E C9               RET
2657+ DA6F              .gpkbFound:
2658+ DA6F 79               LD A, C                     ; A = id (1..8)
2659+ DA70 C1               POP BC
2660+ DA71 E1               POP HL
2661+ DA72 C9               RET
