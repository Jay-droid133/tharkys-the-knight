5371+ BFD6              ; ==============================================================================
5372+ BFD6              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5373+ BFD6              ; ==============================================================================
5374+ BFD6              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5375+ BFD6              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5376+ BFD6              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5377+ BFD6              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5378+ BFD6              ;   pantalla, no diurnos.
5379+ BFD6              ; ==============================================================================
5380+ BFD6              UpdateNastyTable:
5381+ BFD6 3A 97 E4         LD A, (CurrentTimeOfDay)
5382+ BFD9 FE 02            CP 2
5383+ BFDB 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5384+ BFDD FE 06            CP 6
5385+ BFDF 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5386+ BFE1 21 BB BF         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5387+ BFE4 18 03            JR .setTable
5388+ BFE6              .diurnal:
5389+ BFE6 21 B7 BF         LD HL, DiurnalTypeTable
5390+ BFE9              .setTable:
5391+ BFE9 22 D4 BF         LD (CurrentNastyTable), HL
5392+ BFEC C9               RET
