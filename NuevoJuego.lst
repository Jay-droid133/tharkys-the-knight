 995+ A79C              ; ==============================================================================
 996+ A79C              ; CalcDrawX - Calcula ENT_DRAWX (POSX ajustado para sprites de ataque)
 997+ A79C              ; ==============================================================================
 998+ A79C              CalcDrawX:
 999+ A79C DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1000+ A79F FE 1B            CP SPRID_ATTACK_WEST
1001+ A7A1 DD 7E 03         LD A, (IX+ENT_POSX)
1002+ A7A4 20 02            JR NZ, .noOffset
1003+ A7A6 D6 08            SUB 8
1004+ A7A8              .noOffset:
1005+ A7A8 DD 77 0F         LD (IX+ENT_DRAWX), A
1006+ A7AB C9               RET
1007+ A7AC
1008+ A7AC              ; ==============================================================================
1009+ A7AC              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
1010+ A7AC              ; ==============================================================================
1011+ A7AC              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
1012+ A7AC              ; IX = puntero a la entidad
1013+ A7AC              ; ==============================================================================
1014+ A7AC              DrawEntity:
1015+ A7AC CD E1 A7         CALL GetSpriteAddr
1016+ A7AF
1017+ A7AF                  ; Guardar attrs del fondo ANTES de pintar
1018+ A7AF DD 56 04         LD D, (IX+ENT_POSY)
1019+ A7B2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1020+ A7B5 5F               LD E, A
1021+ A7B6 DD E5            PUSH IX
1022+ A7B8 DD 2A 10 A8      LD IX, (SpriteAddrTemp)
1023+ A7BC CD 7D 9E         CALL SaveEntityAttr
1024+ A7BF DD E1            POP IX
1025+ A7C1
1026+ A7C1                  ; Pintar atributo ANTES del draw
1027+ A7C1 DD 56 04         LD D, (IX+ENT_POSY)
1028+ A7C4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1029+ A7C7 5F               LD E, A
1030+ A7C8 DD 7E 05         LD A, (IX+ENT_ATTR)
1031+ A7CB CD 0F 9E         CALL SetEntityAttr
1032+ A7CE
1033+ A7CE                  ; XOR draw del sprite
1034+ A7CE DD 56 04         LD D, (IX+ENT_POSY)
1035+ A7D1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1036+ A7D4 5F               LD E, A
1037+ A7D5 DD E5            PUSH IX
1038+ A7D7 DD 2A 10 A8      LD IX, (SpriteAddrTemp)
1039+ A7DB CD 1F 9D         CALL DrawSprite
1040+ A7DE DD E1            POP IX
1041+ A7E0 C9               RET
