2461+ DC1D 47               LD B, A                     ; mapX
2462+ DC1E 23               INC HL
2463+ DC1F 4E               LD C, (HL)                  ; mapY
2464+ DC20 23               INC HL                      ; HL en ptr_lo
2465+ DC21 3A 8F 82         LD A, (CurrentScreenX)
2466+ DC24 B8               CP B
