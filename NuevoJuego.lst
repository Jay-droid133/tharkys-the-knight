 882+ EE45 C3 6A EE         JP .urpActivate
 883+ EE48              .urpDoRoulette:
 884+ EE48                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
 885+ EE48                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
 886+ EE48                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
 887+ EE48                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
 888+ EE48 3E 06            LD A, ROLLED_ROULETTE
 889+ EE4A 32 D5 5F         LD (RP_TmpRolled), A
 890+ EE4D 3E 01            LD A, 1
 891+ EE4F 32 BC 5F         LD (RouletteActive), A
 892+ EE52                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
 893+ EE52 ED 5F            LD A, R
 894+ EE54 06 09            LD B, ROULETTE_ORDER_LEN
 895+ EE56              .urpRouletteModLoop:
 896+ EE56 90               SUB B
 897+ EE57 30 FD            JR NC, .urpRouletteModLoop
 898+ EE59 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
 899+ EE5A CD 11 EB         CALL SkipCompassIfNeeded            ; si idx cae en COMPASS y lasting activo, avanza
 900+ EE5D 32 BD 5F         LD (RouletteIdx), A
 901+ EE60 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
 902+ EE61 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 903+ EE63 32 BE 5F         LD (RouletteFrameCounter), A
 904+ EE66 78               LD A, B
 905+ EE67 CD B3 EA         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
 906+ EE6A              .urpActivate:
 907+ EE6A                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
 908+ EE6A CD DD EA         CALL LoadSynthSpriteAndExtractAttr
 909+ EE6D 3A 0A 83         LD A, (CurrentScreenX)
 910+ EE70 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
 911+ EE73 3A 0B 83         LD A, (CurrentScreenY)
 912+ EE76 32 B5 5F         LD (RandomSynthMapY), A
 913+ EE79 3E FF            LD A, $FF
 914+ EE7B 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
 915+ EE7E 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
 916+ EE80                                                      ; ya están set por .urpDoXxx — no resetear)
 917+ EE80
 918+ EE80              ; ==============================================================================
 919+ EE80              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
 920+ EE80              ; ==============================================================================
 921+ EE80              ; prev ← cur (data de la sala que dejamos).
 922+ EE80              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
 923+ EE80              ;
 924+ EE80              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
 925+ EE80              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
 926+ EE80              ; ==============================================================================
 927+ EE80              .urpZeroAndRotate:
 928+ EE80 AF               XOR A
 929+ EE81 32 D4 5F         LD (RP_TmpSlot), A
 930+ EE84 32 D5 5F         LD (RP_TmpRolled), A
 931+ EE87              .urpRotateAndRet:
 932+ EE87                  ; prev ← cur
 933+ EE87 3A CE 5F         LD A, (RP_CurSid)
 933+ EE8A 32 D1 5F       LD (RP_PrevSid), A
 934+ EE8D 3A CF 5F         LD A, (RP_CurSlot)
 934+ EE90 32 D2 5F       LD (RP_PrevSlot), A
 935+ EE93 3A D0 5F         LD A, (RP_CurRolled)
 935+ EE96 32 D3 5F       LD (RP_PrevRolled), A
 936+ EE99 3A D6 5F         LD A, (RP_CurVariant)
 936+ EE9C 32 D7 5F       LD (RP_PrevVariant), A
 937+ EE9F                  ; cur ← (newSid, TmpSlot, TmpRolled, TmpVariant)
 938+ EE9F 3A 0B 83         LD A, (CurrentScreenY)
 939+ EEA2 07               RLCA
 939+ EEA3 07             RLCA
 939+ EEA4 07             RLCA
 939+ EEA5 07             RLCA           ; Y*16
 940+ EEA6 21 0A 83         LD HL, CurrentScreenX
 941+ EEA9 86               ADD A, (HL)                         ; A = newSid
 942+ EEAA 32 CE 5F         LD (RP_CurSid), A
 943+ EEAD 3A D4 5F         LD A, (RP_TmpSlot)
 943+ EEB0 32 CF 5F       LD (RP_CurSlot), A
 944+ EEB3 3A D5 5F         LD A, (RP_TmpRolled)
 944+ EEB6 32 D0 5F       LD (RP_CurRolled), A
 945+ EEB9 3A D8 5F         LD A, (RP_TmpVariant)
 945+ EEBC 32 D6 5F       LD (RP_CurVariant), A
 946+ EEBF C9               RET
 947+ EEC0
 948+ EEC0              ; ==============================================================================
 949+ EEC0              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 950+ EEC0              ; ==============================================================================
 951+ EEC0              ; Se llama desde:
 952+ EEC0              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 953+ EEC0              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 954+ EEC0              ;     por encima y los borro.
 955+ EEC0              ;
 956+ EEC0              ; Bypass total del day/night remap → respeta exactamente el patrón per-celda
 957+ EEC0              ; que el BG editor exporta (ej: col1 bright + col2 dim). Lee los 4 attrs
 958+ EEC0              ; ya extraídos por LoadSynthSpriteAndExtractAttr (RandomSynthAttr=TL,
 959+ EEC0              ; RandomSynthAttrTR, RandomSynthAttrBL, RandomSynthAttrBR) y los pinta
 960+ EEC0              ; 1:1 en VRAM.
 961+ EEC0              ;
 962+ EEC0              ; Pickup es 16x16 = 2x2 char attrs.
 963+ EEC0              ; Early-out si RandomSynthMapX = $FE (no activo).
 964+ EEC0              ; Destruye AF, BC, DE, HL.
 965+ EEC0              ; ==============================================================================
 966+ EEC0              PaintSynthPickupAttrsBody:
 967+ EEC0 3A B4 5F         LD A, (RandomSynthMapX)
 968+ EEC3 FE FE            CP $FE
 969+ EEC5 C8               RET Z                               ; no activo
 970+ EEC6                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 971+ EEC6 3A B9 5F         LD A, (RandomSynthCharY)
 972+ EEC9 C6 02            ADD A, BG_Y_OFFSET
 973+ EECB 26 00            LD H, 0
 974+ EECD 6F               LD L, A
 975+ EECE 29               ADD HL, HL
 976+ EECF 29               ADD HL, HL
 977+ EED0 29               ADD HL, HL
 978+ EED1 29               ADD HL, HL
 979+ EED2 29               ADD HL, HL                          ; *32
 980+ EED3 3A B8 5F         LD A, (RandomSynthCharX)
 981+ EED6 85               ADD A, L
 982+ EED7 6F               LD L, A
 983+ EED8 30 01            JR NC, .pspaNoCarry
 984+ EEDA 24               INC H
