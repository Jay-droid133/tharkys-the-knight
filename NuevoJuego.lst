  90  6693
  91  6693                  ; --- Cutscene de captura en iglesia M7 (church_cutscene.asm) ---
  92  6693                  ; Mismo patron: vive en $6000+ (siempre visible). Solo se ejecuta durante
  93  6693                  ; la trampa de la iglesia (atrapar 3 monstruos). Tablas de datos
  94  6693                  ; (StatueIdTable, ChurchTrapBitMask, etc.) se referencian desde bank 0
  95  6693                  ; (logic_game, milestones) — al estar en slot 1, se leen sin paginar.
  96  6693                  INCLUDE "church_cutscene.asm"
# file opened: church_cutscene.asm
   1+ 6693              ; ==============================================================================
   2+ 6693              ; church_cutscene.asm - Cutscene de captura de monsters en la iglesia (M7)
   3+ 6693              ; ==============================================================================
   4+ 6693              ; Vive en $6000+ (slot 1, bank 5, siempre visible). Solo se ejecuta una vez por
   5+ 6693              ; partida durante la trampa de la iglesia. Penalty de contended ~5-10% durante
   6+ 6693              ; la cinematica — invisible porque es one-shot.
   7+ 6693              ;
   8+ 6693              ; Las CALLs externas a bank 0 (DrawSprite, GetOldSpriteAddr, etc.) funcionan
   9+ 6693              ; sin envoltura porque bank 0 sigue paginado por defecto en slot 3.
  10+ 6693              ; ID labels y tablas (StatueIdTable, ChurchTrapBitMask, etc.) son accedidos
  11+ 6693              ; tambien desde bank 0 — al estar en slot 1 (siempre visible), se leen OK.
  12+ 6693              ; ==============================================================================
  13+ 6693
  14+ 6693              ; ==============================================================================
  15+ 6693              ; EraseChurchTrappedMonster - borra el sprite del monster atrapado in-place
  16+ 6693              ; ==============================================================================
  17+ 6693              ; Llamada al final de la fase LOOK (antes de CloseChurchDoor) para que
  18+ 6693              ; durante la fase SHAKE la puerta cerrada no muestre pixels residuales
  19+ 6693              ; del monster por debajo del marco. Auto-carga IX desde
  20+ 6693              ; ChurchCutsceneSlot.
  21+ 6693              ; Destruye: AF, BC, DE, HL, IX (callsite debe asumir IX no preservado).
  22+ 6693              ; ==============================================================================
  23+ 6693              EraseChurchTrappedMonster:
  24+ 6693 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  25+ 6696 3C               INC A                                   ; SLOT_MONSTER0 = 1
  26+ 6697 6F               LD L, A
  27+ 6698 26 00            LD H, 0
  28+ 669A 29               ADD HL, HL
  29+ 669B 29               ADD HL, HL
  30+ 669C 29               ADD HL, HL
  31+ 669D 29               ADD HL, HL                              ; * ENT_SIZE (16)
  32+ 669E 11 DC 80         LD DE, EntityTable
  33+ 66A1 19               ADD HL, DE
  34+ 66A2 E5               PUSH HL
  35+ 66A3 DD E1            POP IX
  36+ 66A5 CD 08 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
  37+ 66A8 DD 7E 0D         LD A, (IX+ENT_OLDY)
  38+ 66AB 57               LD D, A
  39+ 66AC DD 7E 0C         LD A, (IX+ENT_OLDX)
  40+ 66AF 5F               LD E, A
  41+ 66B0 DD 2A 90 A7      LD IX, (OldSprAddr)
  42+ 66B4 C3 BE 9D         JP DrawSprite                           ; XOR-erase + RET tail-call
  43+ 66B7
  44+ 66B7              ; ==============================================================================
  45+ 66B7              ; ApplyChurchTrapEffects - efectos finales tras el cutscene
  46+ 66B7              ; ==============================================================================
  47+ 66B7              ; - Marca slot atrapado en MonsterTrappedFlags.
  48+ 66B7              ; - Despawn monster (ENT_TYPE=0).
  49+ 66B7              ; - Cierra puerta (CloseChurchDoor patchea ptr + ScreenDirty=1).
  50+ 66B7              ; - Si <3 atrapados: respawnea church_key en AltN.
  51+ 66B7              ; - Si 3 atrapados: spawnea town_gate_key + avanza hito 7 -> 8.
  52+ 66B7              ; ==============================================================================
  53+ 66B7              ApplyChurchTrapDone:
  54+ 66B7                  ; Get IX = monster atrapado (a partir del entity slot guardado)
  55+ 66B7 3A 9E 5F         LD A, (ChurchCutsceneSlot)
  56+ 66BA 3C               INC A                                   ; SLOT_MONSTER0 = 1
  57+ 66BB 6F               LD L, A
  58+ 66BC 26 00            LD H, 0
  59+ 66BE 29               ADD HL, HL
  60+ 66BF 29               ADD HL, HL
  61+ 66C0 29               ADD HL, HL
  62+ 66C1 29               ADD HL, HL                              ; * ENT_SIZE (16)
  63+ 66C2 11 DC 80         LD DE, EntityTable
  64+ 66C5 19               ADD HL, DE
  65+ 66C6 E5               PUSH HL
  66+ 66C7 DD E1            POP IX
  67+ 66C9                  ; Set bit por TIPO en MonsterTrappedFlags (TypeIdx ya calculado y
  68+ 66C9                  ; guardado en TriggerChurchTrap).
  69+ 66C9 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
  70+ 66CC 21 31 67         LD HL, ChurchTrapBitMask
  71+ 66CF 5F               LD E, A
  72+ 66D0 16 00            LD D, 0
  73+ 66D2 19               ADD HL, DE
  74+ 66D3 7E               LD A, (HL)
  75+ 66D4 21 FE 81         LD HL, MonsterTrappedFlags
  76+ 66D7 B6               OR (HL)
  77+ 66D8 77               LD (HL), A
  78+ 66D9                  ; Avanzar al siguiente paso del orden fijo de captura.
  79+ 66D9                  ; Tras step=2 (skeleton), pasa a step=3 (todos atrapados, no se resalta
  80+ 66D9                  ; ninguna estatua y CheckChurchTrap rechaza cualquier monstruo).
  81+ 66D9 21 FF 81         LD HL, NextChurchTrapStep
  82+ 66DC 34               INC (HL)
  83+ 66DD                  ; Encender ya la estatua del siguiente esperado (no-op si step==3).
  84+ 66DD                  ; Esto da feedback visual inmediato al jugador tras la cutscene de
  85+ 66DD                  ; captura: el humo se disipa y la siguiente estatua parpadea ON-OFF
  86+ 66DD                  ; antes de quedarse fija en blanco brillante.
  87+ 66DD DD E5            PUSH IX
  88+ 66DF CD DA EC         CALL StartStatueBlink
  89+ 66E2 DD E1            POP IX
  90+ 66E4                  ; (Erase ya ejecutado al final de fase LOOK por EraseChurchTrappedMonster.)
  91+ 66E4                  ; Despawn monster: TYPE = 0 (ANIMBASE preservado para que TryRespawn lo
  92+ 66E4                  ; vea y, via .rmTrapBits indexado por type, decida saltarlo).
  93+ 66E4 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
  94+ 66E8 DD 36 02 00      LD (IX+ENT_STATE), 0
  95+ 66EC DD 36 06 00      LD (IX+ENT_DELTAX), 0
  96+ 66F0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
  97+ 66F4                  ; (Restos ya dibujados al inicio de la fase SMOKE. En re-entradas a la
  98+ 66F4                  ; sala se redibujan automaticamente desde DrawScreen .sprSkipHidden.)
  99+ 66F4                  ; (CloseChurchDoor y EraseStatueAtSlot ya se ejecutaron en fases
 100+ 66F4                  ; anteriores del cutscene.)
 101+ 66F4                  ; Decidir spawn: 3 atrapados?
 102+ 66F4 3A FE 81         LD A, (MonsterTrappedFlags)
 103+ 66F7 E6 07            AND $07
 104+ 66F9 FE 07            CP $07
 105+ 66FB 28 12            JR Z, .actdAllTrapped
 106+ 66FD                  ; <3 atrapados: respawn church_key en AltN
 107+ 66FD 3E 01            LD A, 1
 108+ 66FF 32 F1 81         LD (ChurchKeySpawned), A
 109+ 6702 21 01 82         LD HL, ChurchKeyAltSpawnIdx
 110+ 6705 34               INC (HL)                                ; idx pasa a 1 o 2
 111+ 6706 CD 82 69         CALL RespawnChurchKeyAtAlt
 112+ 6709                  ; Dibujar surgical en su nueva posicion
 113+ 6709 11 AA DB         LD DE, BgGfx_church_key
 114+ 670C C3 8A D3         JP RedrawPickupByPtr
 115+ 670F              .actdAllTrapped:
 116+ 670F                  ; Los 3 monstruos atrapados: descongelar el reloj, el ciclo dia/noche
 117+ 670F                  ; reanuda desde donde se quedo al abrir la iglesia.
 118+ 670F AF               XOR A
 119+ 6710 32 F4 81         LD (TimeFrozen), A
 120+ 6713 3E 01            LD A, 1
 121+ 6715 32 02 82         LD (TownGateKeySpawned), A
 122+ 6718 11 6F DB         LD DE, BgGfx_town_gate_key
 123+ 671B CD 8A D3         CALL RedrawPickupByPtr
 124+ 671E 3A F7 81         LD A, (CurrentObjective)
 125+ 6721 FE 07            CP 7
 126+ 6723 C0               RET NZ
 127+ 6724 3C               INC A
 128+ 6725 32 F7 81         LD (CurrentObjective), A
 129+ 6728 CD FA E9         CALL ResolveObjectiveScreen
 130+ 672B 3E FF            LD A, $FF
 131+ 672D 32 FA 81         LD (PreviousObjectiveDistance), A
 132+ 6730 C9               RET
