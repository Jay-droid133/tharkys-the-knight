4835+ BD0C 21 2F BD         LD HL, EnemySpeedTable
4836+ BD0F 5F               LD E, A
4837+ BD10 16 00            LD D, 0
4838+ BD12 19               ADD HL, DE
4839+ BD13 7E               LD A, (HL)                          ; A = velocidad × 2
4840+ BD14                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4841+ BD14 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4842+ BD16 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4843+ BD18                  ; Hay fraccion .5: alternar +1 en frames impares
4844+ BD18 47               LD B, A                             ; B = parte entera
4845+ BD19 3A 48 81         LD A, (GameFrameCounter)
4846+ BD1C E6 01            AND 1                               ; 0 en par, 1 en impar
4847+ BD1E 80               ADD A, B                            ; Sumar 0 o 1
4848+ BD1F              .uesNoFrac:
4849+ BD1F 32 BB 90         LD (CurrentEnemySpeed), A
4850+ BD22                  ; Leer delay de animacion para este ciclo
4851+ BD22 F1               POP AF                              ; A = indice 0-based
4852+ BD23 21 39 BD         LD HL, EnemyAnimDelayTable
4853+ BD26 5F               LD E, A
4854+ BD27 16 00            LD D, 0
4855+ BD29 19               ADD HL, DE
4856+ BD2A 7E               LD A, (HL)
4857+ BD2B 32 BC 90         LD (CurrentEnemyAnimDelay), A
4858+ BD2E C9               RET
