 138  C031                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ C031              ; ==============================================================================
   2+ C031              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ C031              ; ==============================================================================
   4+ C031              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ C031              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ C031              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ C031              ; ==============================================================================
   8+ C031
   9+ C031              ; ==============================================================================
  10+ C031              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ C031              ; ==============================================================================
  12+ C031              InitScreenSystem:
  13+ C031 3E 09            LD A, START_SCREEN_X
  14+ C033 32 E3 81         LD (CurrentScreenX), A
  15+ C036 3E 09            LD A, START_SCREEN_Y
  16+ C038 32 E4 81         LD (CurrentScreenY), A
  17+ C03B 3E 01            LD A, 1
  18+ C03D 32 EB 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ C040 AF               XOR A
  20+ C041 32 E7 81         LD (ScreenTransition), A
  21+ C044 CD 48 C0         CALL CalcScreenAddress
  22+ C047 C9               RET
  23+ C048
  24+ C048              ; ==============================================================================
  25+ C048              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ C048              ; ==============================================================================
  27+ C048              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ C048              ; ==============================================================================
  29+ C048              CalcScreenAddress:
  30+ C048 3A E4 81         LD A, (CurrentScreenY)
  31+ C04B 6F               LD L, A
  32+ C04C 26 00            LD H, 0
  33+ C04E 29               ADD HL, HL                  ; x2
  34+ C04F 29               ADD HL, HL                  ; x4
  35+ C050 29               ADD HL, HL                  ; x8
  36+ C051 29               ADD HL, HL                  ; x16
  37+ C052 3A E3 81         LD A, (CurrentScreenX)
  38+ C055 5F               LD E, A
  39+ C056 16 00            LD D, 0
  40+ C058 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ C059 11 BF CD         LD DE, MapTable
  42+ C05C 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ C05D 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ C05E                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ C05E 6F               LD L, A
  46+ C05F 26 00            LD H, 0
  47+ C061 29               ADD HL, HL                  ; index * 2
  48+ C062 11 91 CC         LD DE, RoomTable
  49+ C065 19               ADD HL, DE
  50+ C066 5E               LD E, (HL)
  51+ C067 23               INC HL
  52+ C068 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ C069                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ C069 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ C06A CD 3E 90         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ C06D                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ C06D 11 AE 84         LD DE, CurrentScreenBuffer
  58+ C070 ED 53 E5 81      LD (CurrentScreenAddr), DE
  59+ C074 C9               RET
  60+ C075
  61+ C075              ; ==============================================================================
  62+ C075              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ C075              ; ==============================================================================
  64+ C075              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ C075              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ C075              ; por estar atrapado cerca del borde.
