 142  6DCD                  ; --- Random pickups: Give routines (random_pickups.asm) ---
 143  6DCD                  ; GiveLife / GiveHealth / GiveStamina. Cold path (solo al recoger pickup
 144  6DCD                  ; random life/health/stamina). HUD se refresca solo cada frame.
 145  6DCD                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ 6DCD              ; ==============================================================================
   2+ 6DCD              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 6DCD              ; ==============================================================================
   4+ 6DCD              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 6DCD              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 6DCD              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 6DCD              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 6DCD              ; correspondiente desde CheckPickupCollect.
   9+ 6DCD              ;
  10+ 6DCD              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 6DCD              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 6DCD              ;
  13+ 6DCD              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 6DCD              ; Bank 0/2 quedan limpios.
  15+ 6DCD              ; ==============================================================================
  16+ 6DCD
  17+ 6DCD              ; ==============================================================================
  18+ 6DCD              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 6DCD              ; ==============================================================================
  20+ 6DCD              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 6DCD              ; el cambio via cache .dlhLast.
  22+ 6DCD              ; ==============================================================================
  23+ 6DCD              GiveLife:
  24+ 6DCD 3A 84 82         LD A, (PlayerLives)
  25+ 6DD0 FE 05            CP PLAYER_LIVES_MAX
  26+ 6DD2 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 6DD3 3C               INC A
  28+ 6DD4 32 84 82         LD (PlayerLives), A
  29+ 6DD7 C9               RET
  30+ 6DD8
  31+ 6DD8              ; ==============================================================================
  32+ 6DD8              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 6DD8              ; ==============================================================================
  34+ 6DD8              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 6DD8              ; ==============================================================================
  36+ 6DD8              GiveHealth:
  37+ 6DD8 3A 68 B6         LD A, (PlayerHealth)
  38+ 6DDB C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 6DDD 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 6DDF FE 11            CP HEALTH_MAX + 1
  41+ 6DE1 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 6DE3              .ghCap:
  43+ 6DE3 3E 10            LD A, HEALTH_MAX
  44+ 6DE5              .ghStore:
  45+ 6DE5 32 68 B6         LD (PlayerHealth), A
  46+ 6DE8 C9               RET
  47+ 6DE9
  48+ 6DE9              ; ==============================================================================
  49+ 6DE9              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ 6DE9              ; ==============================================================================
  51+ 6DE9              GiveStamina:
  52+ 6DE9 3A 69 B6         LD A, (PlayerStamina)
  53+ 6DEC C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ 6DEE 38 04            JR C, .gsCap
  55+ 6DF0 FE 11            CP STAMINA_MAX + 1
  56+ 6DF2 38 02            JR C, .gsStore
  57+ 6DF4              .gsCap:
  58+ 6DF4 3E 10            LD A, STAMINA_MAX
  59+ 6DF6              .gsStore:
  60+ 6DF6 32 69 B6         LD (PlayerStamina), A
  61+ 6DF9 C9               RET
