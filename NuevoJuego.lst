 222  80C8                  ; --- Frame sync: esperar hasta que pasen 2 ticks desde el inicio ---
 223  80C8              .frameSync:
 224  80C8 76               HALT                        ; Dormir hasta siguiente interrupt
 225  80C9 3A D8 80         LD A, (.frameStart)
 226  80CC 47               LD B, A
 227  80CD 3A 78 5C         LD A, ($5C78)
 228  80D0 90               SUB B                       ; A = ticks transcurridos (byte wrap OK)
 229  80D1 FE 02            CP 2
 230  80D3 38 F3            JR C, .frameSync            ; < 2 ticks: seguir esperando
 231  80D5
 232  80D5 C3 00 80         JP MainLoop
 233  80D8 00           .frameStart: DEFB 0
