 271+ 7D87              ; ==============================================================================
 272+ 7D87              ; AY_WriteRegSlot1 - copia de AY_WriteReg en slot 1
 273+ 7D87              ; ==============================================================================
 274+ 7D87              ; Necesaria porque desde el IRQ handler (slot 1) NO podemos llamar a la
 275+ 7D87              ; AY_WriteReg de bank 4: bank 4 puede no estar paginado en slot 3, y aunque
 276+ 7D87              ; lo estuviera, paginarlo desde el IRQ trae el race que estamos eliminando.
 277+ 7D87              ; Identica a AY_WriteReg (bank 4): A=registro, E=valor; clobbea BC y A.
 278+ 7D87              ; ==============================================================================
 279+ 7D87              AY_WriteRegSlot1:
 280+ 7D87 01 FD FF         LD BC, $FFFD
 281+ 7D8A ED 79            OUT (C), A                      ; seleccionar registro
 282+ 7D8C 01 FD BF         LD BC, $BFFD
 283+ 7D8F ED 59            OUT (C), E                      ; escribir valor
 284+ 7D91 C9               RET
 285+ 7D92
 286+ 7D92              ; ==============================================================================
 287+ 7D92              ; UpdateMusicImpl - catchup wall-clock. LEGACY: ya no se llama desde MainLoop.
 288+ 7D92              ; ==============================================================================
 289+ 7D92              ; Hoy el tick vive en MusicIrqHandler (CALL .upmiTickOnce + CALL .upmiPostLoop
 290+ 7D92              ; cada 2 IRQs). Esta rutina catchup se mantiene como fallback por si alguna
 291+ 7D92              ; vez queremos forzar avance N frames desde codigo.
 292+ 7D92              ; ==============================================================================
 293+ 7D92              UpdateMusicImpl:
 294+ 7D92 3A E9 99         LD A, (FramesElapsed)
 295+ 7D95 B7               OR A
 296+ 7D96 28 08            JR Z, .upmiPostLoop
 297+ 7D98 47               LD B, A
 298+ 7D99              .upmiLoop:
 299+ 7D99 C5               PUSH BC
 300+ 7D9A CD 11 7E         CALL .upmiTickOnce
 301+ 7D9D C1               POP BC
 302+ 7D9E 10 F9            DJNZ .upmiLoop
 303+ 7DA0              .upmiPostLoop:
 304+ 7DA0                  ; --- Re-arm AY si musica activa ---
 305+ 7DA0                  ; Sin esto, la nota actual queda muda tras (a) cualquier write a R8/R9/R10
 306+ 7DA0                  ; que la mute, o (b) tras pasar por un rest. Re-escribimos vol + period de
 307+ 7DA0                  ; cada canal con period activo != 0. SFX en canal B (poly2 only) bloquean
 308+ 7DA0                  ; el re-arm de B; en poly3 no hay SFX activos (game-end), siempre re-armar.
 309+ 7DA0 3A A8 7B         LD A, (MusicTimer)
 310+ 7DA3 B7               OR A
 311+ 7DA4 C8               RET Z                           ; musica inactiva → no tocar AY
 312+ 7DA5                  ; --- Re-arm canal A: R0/R1 + R8 si MusicPeriodA != 0 ---
 313+ 7DA5 2A AD 7B         LD HL, (MusicPeriodA)
 314+ 7DA8 7C               LD A, H
 315+ 7DA9 B5               OR L
 316+ 7DAA 28 18            JR Z, .upmiSkipA
 317+ 7DAC E5               PUSH HL
 318+ 7DAD 3E 08            LD A, 8
 319+ 7DAF 1E 0C            LD E, 12
 320+ 7DB1 CD 87 7D         CALL AY_WriteRegSlot1           ; R8 = vol A medio-alto
 321+ 7DB4 E1               POP HL
 322+ 7DB5 5D               LD E, L
 323+ 7DB6 3E 00            LD A, 0
 324+ 7DB8 CD 87 7D         CALL AY_WriteRegSlot1           ; R0 = period A lo
 325+ 7DBB 2A AD 7B         LD HL, (MusicPeriodA)
 326+ 7DBE 5C               LD E, H
 327+ 7DBF 3E 01            LD A, 1
 328+ 7DC1 CD 87 7D         CALL AY_WriteRegSlot1           ; R1 = period A hi
 329+ 7DC4              .upmiSkipA:
 330+ 7DC4                  ; --- Re-arm canal C: R4/R5 + R10 si MusicPeriodC != 0 ---
 331+ 7DC4 2A B1 7B         LD HL, (MusicPeriodC)
 332+ 7DC7 7C               LD A, H
 333+ 7DC8 B5               OR L
 334+ 7DC9 28 18            JR Z, .upmiSkipC
 335+ 7DCB E5               PUSH HL
 336+ 7DCC 3E 0A            LD A, 10
 337+ 7DCE 1E 0C            LD E, 12
 338+ 7DD0 CD 87 7D         CALL AY_WriteRegSlot1           ; R10 = vol C medio-alto
 339+ 7DD3 E1               POP HL
 340+ 7DD4 5D               LD E, L
 341+ 7DD5 3E 04            LD A, 4
 342+ 7DD7 CD 87 7D         CALL AY_WriteRegSlot1           ; R4 = period C lo
 343+ 7DDA 2A B1 7B         LD HL, (MusicPeriodC)
 344+ 7DDD 5C               LD E, H
 345+ 7DDE 3E 05            LD A, 5
 346+ 7DE0 CD 87 7D         CALL AY_WriteRegSlot1           ; R5 = period C hi
 347+ 7DE3              .upmiSkipC:
 348+ 7DE3                  ; --- Re-arm canal B: solo en poly3 y solo si no hay SFX en curso ---
 349+ 7DE3 3A AC 7B         LD A, (MusicMode)
 350+ 7DE6 FE 03            CP 3
 351+ 7DE8 C0               RET NZ                          ; poly2: B reservado a SFX, no tocar
 352+ 7DE9 3A A3 6A         LD A, (BeepDurationFrames)
 353+ 7DEC B7               OR A
 354+ 7DED C0               RET NZ
 355+ 7DEE 3A 9E 6A         LD A, (PlayerHitFrames)
 356+ 7DF1 B7               OR A
 357+ 7DF2 C0               RET NZ
 358+ 7DF3 2A AF 7B         LD HL, (MusicPeriodB)
 359+ 7DF6 7C               LD A, H
 360+ 7DF7 B5               OR L
 361+ 7DF8 C8               RET Z
 362+ 7DF9 E5               PUSH HL
 363+ 7DFA 3E 09            LD A, 9
 364+ 7DFC 1E 0C            LD E, 12
 365+ 7DFE CD 87 7D         CALL AY_WriteRegSlot1           ; R9 = vol B medio-alto
 366+ 7E01 E1               POP HL
 367+ 7E02 5D               LD E, L
 368+ 7E03 3E 02            LD A, 2
 369+ 7E05 CD 87 7D         CALL AY_WriteRegSlot1           ; R2 = period B lo
 370+ 7E08 2A AF 7B         LD HL, (MusicPeriodB)
 371+ 7E0B 5C               LD E, H
 372+ 7E0C 3E 03            LD A, 3
 373+ 7E0E C3 87 7D         JP AY_WriteRegSlot1             ; tail-call: R3 = period B hi
