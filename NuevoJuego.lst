 218+ E67B              ; ==============================================================================
 219+ E67B              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 220+ E67B              ; ==============================================================================
 221+ E67B              ; Llamar cada frame desde el main loop.
 222+ E67B              ; ==============================================================================
 223+ E67B              ; AY_UpdateBellImpl: STUB. El tick del decay vive ahora en BellTickIrq
 224+ E67B              ; (slot 1, music_irq.asm) y se llama desde MusicIrqHandler cada 25 Hz.
 225+ E67B              ; Mantenemos el thunk thunk AY_UpdateBell + Impl por compat (algunos hooks
 226+ E67B              ; podrian seguir llamandolo); ya es no-op.
 227+ E67B              AY_UpdateBellImpl:
 228+ E67B C9               RET
 229+ E67C
 230+ E67C              ; ==============================================================================
 231+ E67C              ; MUSIC DRIVER - Dispatcher entre tracks (canal B AY)
 232+ E67C              ; ==============================================================================
 233+ E67C              ; State + tablas + tick (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote)
 234+ E67C              ; viven AHORA en code/music_irq.asm (slot 1, $6000-$7FFF, siempre visible).
 235+ E67C              ; El IRQ handler debe poder leer ese codigo/datos sin paginar slot 3 — paginar
 236+ E67C              ; dentro del IRQ rompe los PUSH/POP del propio handler (ver
 237+ E67C              ; project_ay_thunk_stack_bug.md).
 238+ E67C              ;
 239+ E67C              ; Aqui solo queda StartMusicImpl (dispatcher one-shot al cambiar de track):
 240+ E67C              ; corre en bank 4 (paged en slot 3 por su thunk) y referencia simbolos de
 241+ E67C              ; slot 1 (TensionMusicTable, MusicLoop, etc.) que estan siempre visibles.
 242+ E67C              ; Tail-jumpea a MusicAdvanceNote (slot 1) tras setear mixer/vol.
 243+ E67C              ;
 244+ E67C              ; Tracks (mismo formato; ver music_irq.asm para tablas):
 245+ E67C              ;   0=Tension, 1=Sunrise, 2=EndGame (LOOP), 3=GameOver, 4=Death (LOOP)
 246+ E67C              ;   $FF=STOP, $FE=restart, $FD=stop-if-loopable
 247+ E67C              ; ==============================================================================
 248+ E67C
 249+ E67C              ; (state vars + tablas movidas a music_irq.asm — ver bloque
 250+ E67C              ; "MUSIC DRIVER STATE + TABLES + TICK" alli.)
 251+ E67C
 252+ E67C              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 253+ E67C              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 254+ E67C              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 255+ E67C              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 256+ E67C              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 257+ E67C              StartMusicImpl:
 258+ E67C 3A E7 99         LD A, (MusicTrackArg)
 259+ E67F FE FF            CP $FF
 260+ E681 28 54            JR Z, .smStop                   ; sentinel: parar musica activa
 261+ E683 FE FE            CP $FE
 262+ E685 28 7A            JR Z, .smRestart                ; sentinel: re-armar track actual desde
 263+ E687                                                  ; primera nota, PRESERVANDO MusicLoop y
 264+ E687                                                  ; MusicSpeedShift (utiles para enfasis
 265+ E687                                                  ; ej. "muerte se lanza" -> sigue loop +
 266+ E687                                                  ; aplica nuevo tempo desde nota 0).
 267+ E687 FE FD            CP $FD
 268+ E689 28 47            JR Z, .smStopIfLoopable         ; sentinel: parar solo si el track activo
 269+ E68B                                                  ; es loopable. Usado por screen_system
 270+ E68B                                                  ; al cambiar sala — corta DeathMusic (loopable,
 271+ E68B                                                  ; ligada a Death entity) pero deja sonar
 272+ E68B                                                  ; tension/sunrise (one-shot, music continua).
 273+ E68B                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 274+ E68B F5               PUSH AF
 275+ E68C AF               XOR A
 276+ E68D 32 AB 7B         LD (MusicLoop), A
 277+ E690 32 E8 99         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 278+ E693 F1               POP AF
 279+ E694                  ; --- Resolver tabla + modo polifonico segun track id ---
 280+ E694                  ; Tracks in-game (0/1/4) = poly2 (canal A+C, B reservado SFX).
 281+ E694                  ; Tracks game-end (2/3) = poly3 (A+B+C, sin SFX en escena).
 282+ E694 21 B3 7B         LD HL, TensionMusicTable
 283+ E697 B7               OR A
 284+ E698 28 1E            JR Z, .smArmPoly2
 285+ E69A 21 D1 7B         LD HL, SunriseMusicTable
 286+ E69D 3D               DEC A
 287+ E69E 28 18            JR Z, .smArmPoly2
 288+ E6A0 21 D5 7C         LD HL, EndGameMusicTable
 289+ E6A3 3D               DEC A
 290+ E6A4 28 19            JR Z, .smArmPoly3Loop            ; track 2 = LOOPABLE
 291+ E6A6 21 29 7D         LD HL, GameOverMusicTable
 292+ E6A9 3D               DEC A
 293+ E6AA 28 18            JR Z, .smArmPoly3
 294+ E6AC 21 5A 7D         LD HL, DeathMusicTable
 295+ E6AF 3D               DEC A
 296+ E6B0 28 01            JR Z, .smArmPoly2Loop            ; track 4 = LOOPABLE
 297+ E6B2 C9               RET                              ; track_id desconocido: no-op
 298+ E6B3
 299+ E6B3              .smArmPoly2Loop:
 300+ E6B3 3E 01            LD A, 1
 301+ E6B5 32 AB 7B         LD (MusicLoop), A
 302+ E6B8                  ; fall-through
 303+ E6B8              .smArmPoly2:
 304+ E6B8 3E 02            LD A, 2
 305+ E6BA 32 AC 7B         LD (MusicMode), A
 306+ E6BD 18 0A            JR .smArmCommon
 307+ E6BF
 308+ E6BF              .smArmPoly3Loop:
 309+ E6BF 3E 01            LD A, 1
 310+ E6C1 32 AB 7B         LD (MusicLoop), A
 311+ E6C4                  ; fall-through
 312+ E6C4              .smArmPoly3:
 313+ E6C4 3E 03            LD A, 3
 314+ E6C6 32 AC 7B         LD (MusicMode), A
 315+ E6C9                  ; fall-through
 316+ E6C9              .smArmCommon:
 317+ E6C9 22 A9 7B         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 318+ E6CC 22 A6 7B         LD (MusicPtr), HL
 319+ E6CF                  ; Mixer R7 vive en $38 (set por AY_Init) — los 3 tonos enable + ruidos off.
 320+ E6CF                  ; El silencio de un canal se gestiona via vol=0 (en MusicAdvanceNote y en
 321+ E6CF                  ; los SFX). No re-escribimos R7 aqui para no clobbear bell residual.
 322+ E6CF C3 17 7E         JP MusicAdvanceNote             ; tail-call: arma vol+period del primer nota
 323+ E6D2
 324+ E6D2              .smStopIfLoopable:
 325+ E6D2                  ; Sentinel $FD: solo para si el track activo es loopable. Tracks one-shot
 326+ E6D2                  ; (tension/sunrise/endgame) pasan de largo y siguen sonando.
 327+ E6D2 3A AB 7B         LD A, (MusicLoop)
 328+ E6D5 B7               OR A
 329+ E6D6 C8               RET Z
 330+ E6D7                  ; fall-through al stop normal
 331+ E6D7              .smStop:
 332+ E6D7                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 333+ E6D7                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 334+ E6D7 AF               XOR A
 335+ E6D8 32 A8 7B         LD (MusicTimer), A
 336+ E6DB 32 AB 7B         LD (MusicLoop), A
 337+ E6DE 32 E8 99         LD (MusicSpeedShift), A         ; reset tempo
 338+ E6E1 67               LD H, A
 339+ E6E2 6F               LD L, A
 340+ E6E3 22 AD 7B         LD (MusicPeriodA), HL           ; clear periods → re-arm no escribe AY
 341+ E6E6 22 AF 7B         LD (MusicPeriodB), HL
 342+ E6E9 22 B1 7B         LD (MusicPeriodC), HL
 343+ E6EC                  ; Mute los 3 canales (poly2 usa A+C; poly3 usa A+B+C; vale para ambos).
 344+ E6EC 3E 08            LD A, 8
 345+ E6EE 1E 00            LD E, 0
 346+ E6F0 CD 92 E5         CALL AY_WriteReg                ; R8 = 0 (vol A)
 347+ E6F3 3E 09            LD A, 9
 348+ E6F5 1E 00            LD E, 0
 349+ E6F7 CD 92 E5         CALL AY_WriteReg                ; R9 = 0 (vol B — solo era usado en poly3)
 350+ E6FA 3E 0A            LD A, 10
 351+ E6FC 1E 00            LD E, 0
 352+ E6FE C3 92 E5         JP AY_WriteReg                  ; tail-call: R10 = 0 (vol C)
 353+ E701
 354+ E701              .smRestart:
 355+ E701                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 356+ E701                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 357+ E701                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 358+ E701                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 359+ E701                  ; con eventos del juego sin esperar al fin de la nota actual.
 360+ E701 2A A9 7B         LD HL, (MusicTableStart)
 361+ E704 22 A6 7B         LD (MusicPtr), HL
 362+ E707 C3 17 7E         JP MusicAdvanceNote
 363+ E70A
 364+ E70A              ; (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote movidos a music_irq.asm
 365+ E70A              ; — slot 1, siempre visible, llamado desde el IRQ handler sin paginar.)
 366+ E70A
