 506  CD25                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CD25              ; ==============================================================================
   2+ CD25              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CD25              ; ==============================================================================
   4+ CD25              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CD25              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CD25              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CD25              ; ==============================================================================
   8+ CD25
   9+ CD25              ; ==============================================================================
  10+ CD25              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CD25              ; ==============================================================================
  12+ CD25              InitScreenSystem:
  13+ CD25 3E 08            LD A, START_SCREEN_X
  14+ CD27 32 10 83         LD (CurrentScreenX), A
  15+ CD2A 3E 09            LD A, START_SCREEN_Y
  16+ CD2C 32 11 83         LD (CurrentScreenY), A
  17+ CD2F 3E 01            LD A, 1
  18+ CD31 32 18 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CD34 AF               XOR A
  20+ CD35 32 14 83         LD (ScreenTransition), A
  21+ CD38 CD 3C CD         CALL CalcScreenAddress
  22+ CD3B C9               RET
  23+ CD3C
  24+ CD3C              ; ==============================================================================
  25+ CD3C              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CD3C              ; ==============================================================================
  27+ CD3C              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CD3C              ; ==============================================================================
  29+ CD3C              CalcScreenAddress:
  30+ CD3C 3A 11 83         LD A, (CurrentScreenY)
  31+ CD3F 6F               LD L, A
  32+ CD40 26 00            LD H, 0
  33+ CD42 29               ADD HL, HL                  ; x2
  34+ CD43 29               ADD HL, HL                  ; x4
  35+ CD44 29               ADD HL, HL                  ; x8
  36+ CD45 29               ADD HL, HL                  ; x16
  37+ CD46 3A 10 83         LD A, (CurrentScreenX)
  38+ CD49 5F               LD E, A
  39+ CD4A 16 00            LD D, 0
  40+ CD4C 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CD4D 11 84 DE         LD DE, MapTable
  42+ CD50 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CD51 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CD52                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CD52 6F               LD L, A
  46+ CD53 26 00            LD H, 0
  47+ CD55 29               ADD HL, HL                  ; index * 2
  48+ CD56 11 4E DD         LD DE, RoomTable
  49+ CD59 19               ADD HL, DE
  50+ CD5A 5E               LD E, (HL)
  51+ CD5B 23               INC HL
  52+ CD5C 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CD5D                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CD5D EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CD5E CD 80 67         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CD61                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CD61 11 FD 85         LD DE, CurrentScreenBuffer
  58+ CD64 ED 53 12 83      LD (CurrentScreenAddr), DE
  59+ CD68 C9               RET
  60+ CD69
  61+ CD69              ; ==============================================================================
  62+ CD69              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CD69              ; ==============================================================================
  64+ CD69              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CD69              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CD69              ; por estar atrapado cerca del borde.
  67+ CD69              ; ==============================================================================
  68+ CD69              CheckScreenTransition:
  69+ CD69 AF               XOR A
  70+ CD6A 32 14 83         LD (ScreenTransition), A
  71+ CD6D
  72+ CD6D                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CD6D                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CD6D                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CD6D                  ; dispararia transicion sur en plena animacion.
  76+ CD6D 3A D0 82         LD A, (TownGatePhase)
  77+ CD70 B7               OR A
  78+ CD71 C0               RET NZ
  79+ CD72
  80+ CD72                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CD72                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CD72                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CD72                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CD72                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CD72                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CD72 3A BB 82         LD A, (TimeFrozen)
  87+ CD75 B7               OR A
  88+ CD76 28 23            JR Z, .cstNotFrozen
  89+ CD78 3A B3 82         LD A, (InputDirection)
  90+ CD7B CB 4F            BIT 1, A                    ; S
  91+ CD7D 28 17            JR Z, .cstClearBlockFlag
  92+ CD7F 3A A7 81         LD A, (EntityTable + ENT_POSY)
  93+ CD82 FE A8            CP SCREEN_MAX_Y
  94+ CD84 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CD86                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CD86 3A BC 82         LD A, (BlockedExitSoundFlag)
  97+ CD89 B7               OR A
  98+ CD8A C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CD8B 3E 01            LD A, 1
 100+ CD8D 32 BC 82         LD (BlockedExitSoundFlag), A
 101+ CD90 21 70 FB         LD HL, SFX_BlockedExit
 102+ CD93 C3 21 FA         JP PlaySFX                  ; tail call
 103+ CD96              .cstClearBlockFlag:
 104+ CD96 AF               XOR A
 105+ CD97 32 BC 82         LD (BlockedExitSoundFlag), A
 106+ CD9A C9               RET
 107+ CD9B              .cstNotFrozen:
 108+ CD9B                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CD9B AF               XOR A
 110+ CD9C 32 BC 82         LD (BlockedExitSoundFlag), A
 111+ CD9F
 112+ CD9F 3A B3 82         LD A, (InputDirection)
 113+ CDA2 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CDA3
 115+ CDA3                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CDA3 CB 5A            BIT 3, D                    ; W
 117+ CDA5 CA 06 CE         JP Z, .noWest
