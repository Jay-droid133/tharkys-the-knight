1587+ F7F0              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1588+ F7F0              ; ==============================================================================
1589+ F7F0              ; Indice (CompassSprites[idx]):
1590+ F7F0              ;   0 = NW    1 = N    2 = NE
1591+ F7F0              ;   3 = W     4 = X    5 = E
1592+ F7F0              ;   6 = SW    7 = S    8 = SE
