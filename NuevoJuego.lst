 584+ F18D                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 585+ F18D                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 586+ F18D                  ; Sprite_Compass_Magic / Sprite_Compass_MagicLasting (no oscilan); el wobble
 587+ F18D                  ; logic solo gastaría CPU durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 588+ F18D                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 589+ F18D                  ; cuando el frame de transición está apretado.
 590+ F18D 3A BF 5F         LD A, (MagicCompassTimer)
 591+ F190 47               LD B, A
 592+ F191 3A C0 5F         LD A, (MagicCompassTimer + 1)
 593+ F194 B0               OR B
 594+ F195 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 595+ F197 AF               XOR A
 596+ F198 32 BF 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 597+ F19B 18 53            JR .dcWobbleEnd
 598+ F19D              .dcWobbleStartNormal:
 599+ F19D                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 600+ F19D                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 601+ F19D                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 602+ F19D                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 603+ F19D                  ; nuevo idx.
 604+ F19D                  ; Counter == 0 -> sin override, idx = target.
 605+ F19D 3A 91 F2         LD A, (.dcSpriteIdx)
 606+ F1A0 FE 04            CP 4
 607+ F1A2 20 06            JR NZ, .dcWobbleNotX
 608+ F1A4                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 609+ F1A4                  ; frame no redibuje innecesariamente.
 610+ F1A4 AF               XOR A
 611+ F1A5 32 BF 82         LD (CompassWobbleCounter), A
 612+ F1A8 18 46            JR .dcWobbleEnd
 613+ F1AA              .dcWobbleNotX:
 614+ F1AA                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 615+ F1AA 3A 0A 83         LD A, (CurrentScreenX)
 616+ F1AD 47               LD B, A
 617+ F1AE 3A BD 82         LD A, (LastCompassScreenX)
 618+ F1B1 B8               CP B
 619+ F1B2 20 0A            JR NZ, .dcWobbleStart
 620+ F1B4 3A 0B 83         LD A, (CurrentScreenY)
 621+ F1B7 47               LD B, A
 622+ F1B8 3A BE 82         LD A, (LastCompassScreenY)
 623+ F1BB B8               CP B
 624+ F1BC 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 625+ F1BE              .dcWobbleStart:
 626+ F1BE 3E 09            LD A, 9
 627+ F1C0 32 BF 82         LD (CompassWobbleCounter), A
 628+ F1C3              .dcWobbleResolve:
 629+ F1C3 3A BF 82         LD A, (CompassWobbleCounter)
 630+ F1C6 B7               OR A
 631+ F1C7 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 632+ F1C9 3D               DEC A
 633+ F1CA 32 BF 82         LD (CompassWobbleCounter), A
 634+ F1CD                                                      ; A = phase 0..8 (1 frame por fase)
 635+ F1CD 21 F2 F6         LD HL, WobblePhaseTable
 636+ F1D0 5F               LD E, A
 637+ F1D1 16 00            LD D, 0
 638+ F1D3 19               ADD HL, DE
