 424+ F128              ; DrawMilestoneHUD - Muestra hito actual en HUD (fila 0, cols 30-31)
 425+ F128              ; ==============================================================================
 426+ F128              ; Formato:
 427+ F128              ;   CurrentObjective 0..10 -> "01".."11" (1-indexed humano)
 428+ F128              ;   CurrentObjective 11    -> "OK" (todos los hitos completados)
 429+ F128              ; Color: bright white (mismo que la velocidad nasty que reemplaza).
 430+ F128              ; Reemplaza visualmente a DrawEnemySpeedHUD para test de la cadena de hitos.
 431+ F128              ; ==============================================================================
 432+ F128              DrawMilestoneHUD:
 433+ F128 3A BF 82         LD A, (CurrentObjective)
 434+ F12B FE 0B            CP 11
 435+ F12D 28 26            JR Z, .mhAllDone
 436+ F12F 3C               INC A                       ; 0-indexed -> 1-indexed (1..11)
 437+ F130 06 00            LD B, 0                     ; B = decenas
 438+ F132              .mhDivLoop:
 439+ F132 FE 0A            CP 10
 440+ F134 38 05            JR C, .mhDivDone
 441+ F136 D6 0A            SUB 10
 442+ F138 04               INC B
 443+ F139 18 F7            JR .mhDivLoop
 444+ F13B              .mhDivDone:
 445+ F13B F5               PUSH AF                     ; A = unidades
 446+ F13C 78               LD A, B
 447+ F13D B7               OR A
 448+ F13E 20 04            JR NZ, .mhTensDigit
