 150  6E8A                  INCLUDE "random_pickups.asm"
# file opened: code/random_pickups.asm
   1+ 6E8A              ; ==============================================================================
   2+ 6E8A              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 6E8A              ; ==============================================================================
   4+ 6E8A              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 6E8A              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 6E8A              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 6E8A              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 6E8A              ; correspondiente desde CheckPickupCollect.
   9+ 6E8A              ;
  10+ 6E8A              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 6E8A              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 6E8A              ;
  13+ 6E8A              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 6E8A              ; Bank 0/2 quedan limpios.
  15+ 6E8A              ; ==============================================================================
  16+ 6E8A
  17+ 6E8A              ; ==============================================================================
  18+ 6E8A              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 6E8A              ; ==============================================================================
  20+ 6E8A              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 6E8A              ; el cambio via cache .dlhLast.
  22+ 6E8A              ; ==============================================================================
  23+ 6E8A              GiveLife:
  24+ 6E8A 3A DE 82         LD A, (PlayerLives)
  25+ 6E8D FE 05            CP PLAYER_LIVES_MAX
  26+ 6E8F D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 6E90 3C               INC A
  28+ 6E91 32 DE 82         LD (PlayerLives), A
  29+ 6E94 C9               RET
  30+ 6E95
  31+ 6E95              ; ==============================================================================
  32+ 6E95              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 6E95              ; ==============================================================================
  34+ 6E95              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 6E95              ; ==============================================================================
  36+ 6E95              GiveHealth:
  37+ 6E95 3A 0C B3         LD A, (PlayerHealth)
  38+ 6E98 C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 6E9A 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 6E9C FE 11            CP HEALTH_MAX + 1
  41+ 6E9E 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 6EA0              .ghCap:
  43+ 6EA0 3E 10            LD A, HEALTH_MAX
  44+ 6EA2              .ghStore:
  45+ 6EA2 32 0C B3         LD (PlayerHealth), A
  46+ 6EA5 C9               RET
  47+ 6EA6
  48+ 6EA6              ; ==============================================================================
  49+ 6EA6              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
