 772+ E722
 773+ E722                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E722 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E724 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E726 83               ADD A, E
 777+ E727 5F               LD E, A                     ; DE = dir VRAM
 778+ E728
 779+ E728 06 08            LD B, 8
