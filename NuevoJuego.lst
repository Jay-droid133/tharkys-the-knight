   1+ E226              ; ==============================================================================
   2+ E226              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E226              ; ==============================================================================
   4+ E226              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E226              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E226              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E226              ; ==============================================================================
   8+ E226
   9+ E226              ; --- Constantes ---
  10+ E226              NUM_TIME_MOMENTS    EQU 7
  11+ E226
  12+ E226              ; --- Variables ---
  13+ E226 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E227 C2 E6        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E229 C2 E6        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E22B 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E22C 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E22D 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E22E
  20+ E22E              ; ==============================================================================
  21+ E22E              ; SetTimeOfDay - Cambia el momento del dia
  22+ E22E              ; ==============================================================================
  23+ E22E              ; Entrada: A = momento (0-6)
  24+ E22E              ; ==============================================================================
  25+ E22E              SetTimeOfDay:
  26+ E22E 32 26 E2         LD (CurrentTimeOfDay), A
  27+ E231
  28+ E231                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E231 FE 04            CP 4
  30+ E233 20 06            JR NZ, .notNewCycle
  31+ E235 21 AA BC         LD HL, DayCycleCount
  32+ E238 34               INC (HL)
  33+ E239 18 04            JR .skipBellsReset
  34+ E23B              .notNewCycle:
  35+ E23B                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E23B                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E23B                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E23B AF               XOR A
  39+ E23C 32 B9 82         LD (BellsTriggered), A
  40+ E23F              .skipBellsReset:
  41+ E23F 3A 26 E2         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E242
  43+ E242                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E242 FE 04            CP 4
  45+ E244 28 24            JR Z, .bellsFirst
  46+ E246
  47+ E246                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E246 FE 05            CP 5
  49+ E248 20 0D            JR NZ, .noScareMon
  50+ E24A CD C4 BC         CALL ScareAllMonsters
  51+ E24D CD 30 F8         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E250                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E250                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E250                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E250                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E250 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E252 CD BD 99         CALL StartMusic
  58+ E255 18 07            JR .noKillMon
  59+ E257              .noScareMon:
  60+ E257                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E257 FE 06            CP 6
  62+ E259 20 03            JR NZ, .noKillMon
  63+ E25B CD 4D BC         CALL KillAllActiveMonsters
  64+ E25E              .noKillMon:
