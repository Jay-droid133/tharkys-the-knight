1821+ F82F
1822+ F82F              ; ==============================================================================
1823+ F82F              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1824+ F82F              ;                     debe salir (magic compass activa).
1825+ F82F              ; ==============================================================================
1826+ F82F              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1827+ F82F              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1828+ F82F              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1829+ F82F              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1830+ F82F              ; el viejo porque DrawScreen ya repinta BG limpio.
1831+ F82F              ;
1832+ F82F              ; Llamada cada frame desde MainLoop tras DrawCompass.
1833+ F82F              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1834+ F82F              ; ==============================================================================
1835+ F82F              DrawCompassGapHint:
1836+ F82F                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1837+ F82F                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1838+ F82F                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1839+ F82F                  ; produciendo el parpadeo sincronizado con el tic AY.
1840+ F82F 2A BF 5F         LD HL, (MagicCompassTimer)
1841+ F832 7C               LD A, H
1842+ F833 B5               OR L
1843+ F834 28 7B            JR Z, .dcghHide
1844+ F836 3A C1 5F         LD A, (MagicCompassPathDir)
1845+ F839 3C               INC A                               ; A=0 si era $FF
1846+ F83A 28 75            JR Z, .dcghHide
1847+ F83C 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1848+ F83F B7               OR A
1849+ F840 28 6F            JR Z, .dcghHide
1850+ F842
1851+ F842                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1852+ F842 21 65 F9         LD HL, HintLastDir
1853+ F845 7E               LD A, (HL)
1854+ F846 47               LD B, A
1855+ F847 3A C1 5F         LD A, (MagicCompassPathDir)
1856+ F84A B8               CP B
1857+ F84B 20 1A            JR NZ, .dcghDraw
1858+ F84D 23               INC HL
1859+ F84E 7E               LD A, (HL)
1860+ F84F 47               LD B, A
1861+ F850 3A C2 5F         LD A, (MagicCompassPathCoord)
1862+ F853 B8               CP B
1863+ F854 20 11            JR NZ, .dcghDraw
1864+ F856 23               INC HL
1865+ F857 7E               LD A, (HL)
1866+ F858 47               LD B, A
1867+ F859 3A 0D 83         LD A, (CurrentScreenX)
1868+ F85C B8               CP B
1869+ F85D 20 08            JR NZ, .dcghDraw
1870+ F85F 23               INC HL
1871+ F860 7E               LD A, (HL)
1872+ F861 47               LD B, A
1873+ F862 3A 0E 83         LD A, (CurrentScreenY)
1874+ F865 B8               CP B
1875+ F866 C8               RET Z                               ; sin cambio -> nada que hacer
1876+ F867
1877+ F867              .dcghDraw:
1878+ F867                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1879+ F867                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1880+ F867 3A 65 F9         LD A, (HintLastDir)
1881+ F86A FE FF            CP $FF
1882+ F86C 28 1F            JR Z, .dcghDrawNew
1883+ F86E 3A 67 F9         LD A, (HintLastScreenX)
1884+ F871 47               LD B, A
1885+ F872 3A 0D 83         LD A, (CurrentScreenX)
1886+ F875 B8               CP B
1887+ F876 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1888+ F878 3A 68 F9         LD A, (HintLastScreenY)
1889+ F87B 47               LD B, A
1890+ F87C 3A 0E 83         LD A, (CurrentScreenY)
1891+ F87F B8               CP B
1892+ F880 20 0B            JR NZ, .dcghDrawNew
1893+ F882 3A 65 F9         LD A, (HintLastDir)
1894+ F885 47               LD B, A
1895+ F886 3A 66 F9         LD A, (HintLastCoord)
1896+ F889 4F               LD C, A
1897+ F88A CD 08 F9         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1898+ F88D              .dcghDrawNew:
1899+ F88D 3A C1 5F         LD A, (MagicCompassPathDir)
1900+ F890 47               LD B, A
1901+ F891 3A C2 5F         LD A, (MagicCompassPathCoord)
1902+ F894 4F               LD C, A
1903+ F895 CD FB F8         CALL DrawHintAtPos
1904+ F898                  ; Update cache
1905+ F898 3A C1 5F         LD A, (MagicCompassPathDir)
1906+ F89B 32 65 F9         LD (HintLastDir), A
1907+ F89E 3A C2 5F         LD A, (MagicCompassPathCoord)
1908+ F8A1 32 66 F9         LD (HintLastCoord), A
1909+ F8A4 3A 0D 83         LD A, (CurrentScreenX)
1910+ F8A7 32 67 F9         LD (HintLastScreenX), A
1911+ F8AA 3A 0E 83         LD A, (CurrentScreenY)
1912+ F8AD 32 68 F9         LD (HintLastScreenY), A
1913+ F8B0 C9               RET
1914+ F8B1
1915+ F8B1              .dcghHide:
1916+ F8B1                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1917+ F8B1 3A 65 F9         LD A, (HintLastDir)
1918+ F8B4 FE FF            CP $FF
1919+ F8B6 C8               RET Z
1920+ F8B7 3A 67 F9         LD A, (HintLastScreenX)
1921+ F8BA 47               LD B, A
1922+ F8BB 3A 0D 83         LD A, (CurrentScreenX)
1923+ F8BE B8               CP B
1924+ F8BF 20 15            JR NZ, .dcghHideInvalidate
1925+ F8C1 3A 68 F9         LD A, (HintLastScreenY)
1926+ F8C4 47               LD B, A
1927+ F8C5 3A 0E 83         LD A, (CurrentScreenY)
1928+ F8C8 B8               CP B
1929+ F8C9 20 0B            JR NZ, .dcghHideInvalidate
1930+ F8CB 3A 65 F9         LD A, (HintLastDir)
1931+ F8CE 47               LD B, A
1932+ F8CF 3A 66 F9         LD A, (HintLastCoord)
1933+ F8D2 4F               LD C, A
1934+ F8D3 CD 08 F9         CALL EraseHintAtPos                 ; XOR + restore attrs
1935+ F8D6              .dcghHideInvalidate:
1936+ F8D6 3E FF            LD A, $FF
1937+ F8D8 32 65 F9         LD (HintLastDir), A
1938+ F8DB C9               RET
1939+ F8DC
1940+ F8DC              ; ==============================================================================
1941+ F8DC              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1942+ F8DC              ; ==============================================================================
1943+ F8DC              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1944+ F8DC              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1945+ F8DC              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1946+ F8DC              ;
1947+ F8DC              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1948+ F8DC              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1949+ F8DC              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1950+ F8DC              ; la zona de atributos ($5800+).
1951+ F8DC              ; Destruye: A.
1952+ F8DC              ; ==============================================================================
1953+ F8DC              ComputeHintPos:
1954+ F8DC 78               LD A, B
1955+ F8DD B7               OR A
1956+ F8DE 28 0A            JR Z, .chpNorth                     ; 0 = N
1957+ F8E0 3D               DEC A
1958+ F8E1 28 0B            JR Z, .chpSouth                     ; 1 = S
1959+ F8E3 3D               DEC A
1960+ F8E4 28 0C            JR Z, .chpWest                      ; 2 = W
1961+ F8E6                  ; Fall-through: 3 = E
1962+ F8E6 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1963+ F8E8 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1964+ F8EA              .chpNorth:
1965+ F8EA 41               LD B, C                             ; charX = coord
1966+ F8EB 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1967+ F8ED C9               RET
1968+ F8EE              .chpSouth:
1969+ F8EE 41               LD B, C
1970+ F8EF 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1971+ F8F1 C9               RET
1972+ F8F2              .chpWest:
1973+ F8F2 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1974+ F8F4                  ; fall-through a .chpVertShift
1975+ F8F4              .chpVertShift:
1976+ F8F4                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1977+ F8F4                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1978+ F8F4                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1979+ F8F4 79               LD A, C
1980+ F8F5 FE 07            CP 7
1981+ F8F7 D8               RET C                               ; coord < 7: gap superior, charY = coord
1982+ F8F8 3C               INC A                               ; gap inferior: charY = coord + 1
1983+ F8F9 4F               LD C, A
1984+ F8FA C9               RET
1985+ F8FB
1986+ F8FB              ; ==============================================================================
1987+ F8FB              ; DrawHintAtPos - Load sprite + XOR-draw flecha en (B=dir, C=coord)
1988+ F8FB              ; ==============================================================================
1989+ F8FB              ; IN:  B = PathDir (0=N, 1=S, 2=W, 3=E)
1990+ F8FB              ;      C = PathCoord (char col para N/S, char row para W/E)
1991+ F8FB              ; Destruye: AF, BC, DE, HL, IX.
1992+ F8FB              ; ==============================================================================
1993+ F8FB              DrawHintAtPos:
1994+ F8FB CD 25 F9         CALL LoadHintSprite                 ; HL = ptr cargado a BgSpriteBuffer; preserva BC
1995+ F8FE CD DC F8         CALL ComputeHintPos                 ; B=charX, C=charY
1996+ F901 DD 21 FA 86      LD IX, BgSpriteBuffer
1997+ F905 C3 1B DC         JP DrawBgSpriteXOR                  ; tail call
1998+ F908
1999+ F908              ; ==============================================================================
2000+ F908              ; EraseHintAtPos - XOR-erase + restore attrs en (B=dir, C=coord)
2001+ F908              ; ==============================================================================
2002+ F908              ; Llamado al cambiar de path/sala/cancel. Mismo XOR-draw que erase los pixels,
2003+ F908              ; mas RestorePickupAttrs para limpiar las attrs (de lo contrario quedan
2004+ F908              ; cuadrados verdes huerfanos en pantalla).
2005+ F908              ; ==============================================================================
2006+ F908              EraseHintAtPos:
2007+ F908 CD 25 F9         CALL LoadHintSprite                 ; HL=ptr; BgSpriteBuffer poblado
2008+ F90B CD DC F8         CALL ComputeHintPos                 ; B=charX, C=charY
2009+ F90E C5               PUSH BC                             ; save charX, charY for RestorePickupAttrs
2010+ F90F DD 21 FA 86      LD IX, BgSpriteBuffer
2011+ F913 CD 1B DC         CALL DrawBgSpriteXOR                ; XOR-erase pixels
2012+ F916 C1               POP BC
2013+ F917                  ; height_chars depende del sprite (2 para 16x16, 3 para 16x24).
2014+ F917                  ; Leer del header: BgSpriteBuffer[0] = height_px; /8 = char rows.
2015+ F917 3A FA 86         LD A, (BgSpriteBuffer)
2016+ F91A 0F               RRCA
2016+ F91B 0F             RRCA
2016+ F91C 0F             RRCA                  ; /8
2017+ F91D E6 1F            AND $1F
2018+ F91F 57               LD D, A                             ; height_chars
