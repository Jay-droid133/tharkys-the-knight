4976+ BA61              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4977+ BA61              ; ==============================================================================
4978+ BA61              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4979+ BA61              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4980+ BA61              ; ==============================================================================
4981+ BA61              KillAllActiveNasties:
4982+ BA61 DD 21 10 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4983+ BA65 06 03            LD B, NUM_NASTIES
4984+ BA67              .kanLoop:
4985+ BA67 C5               PUSH BC
4986+ BA68 DD 7E 01         LD A, (IX+ENT_TYPE)
4987+ BA6B B7               OR A
4988+ BA6C 28 26            JR Z, .kanSkip                  ; slot vacio
4989+ BA6E FE 03            CP TYPE_NASTY
4990+ BA70 20 22            JR NZ, .kanSkip                 ; no es nasty
4991+ BA72 DD 7E 02         LD A, (IX+ENT_STATE)
4992+ BA75 FE 03            CP STATE_DYING
4993+ BA77 28 1B            JR Z, .kanSkip                  ; ya muriendo
4994+ BA79                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4995+ BA79                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4996+ BA79                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4997+ BA79                  ; del nasty: peDying paintea el rect del puff con ese color)
4998+ BA79 CD 9D BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4999+ BA7C DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5000+ BA80 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5001+ BA84 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5002+ BA88 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5003+ BA8C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5004+ BA90 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5005+ BA94              .kanSkip:
5006+ BA94 11 10 00         LD DE, ENT_SIZE
5007+ BA97 DD 19            ADD IX, DE
5008+ BA99 C1               POP BC
5009+ BA9A 10 CB            DJNZ .kanLoop
5010+ BA9C C9               RET
5011+ BA9D
5012+ BA9D              ; ==============================================================================
5013+ BA9D              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
5014+ BA9D              ; ==============================================================================
5015+ BA9D              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
5016+ BA9D              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
5017+ BA9D              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
5018+ BA9D              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
5019+ BA9D              ; deja la posicion original (puff puede asomar levemente, raro).
5020+ BA9D              ; IN:  IX = nasty entity.
5021+ BA9D              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
5022+ BA9D              ; Destruye: AF, BC, DE, HL.
5023+ BA9D              ; ==============================================================================
5024+ BA9D              SnapPuffPos:
5025+ BA9D DD 7E 03         LD A, (IX+ENT_POSX)
5026+ BAA0 32 13 BB         LD (.sppOrigX), A
5027+ BAA3 E6 F8            AND $F8
5028+ BAA5 32 15 BB         LD (.sppBaseX), A                   ; base char-aligned X
5029+ BAA8 DD 7E 04         LD A, (IX+ENT_POSY)
5030+ BAAB 32 14 BB         LD (.sppOrigY), A
5031+ BAAE E6 F8            AND $F8
5032+ BAB0 32 16 BB         LD (.sppBaseY), A                   ; base char-aligned Y
5033+ BAB3
5034+ BAB3                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
5035+ BAB3 CD E7 BA         CALL .sppCheckFit
5036+ BAB6 C8               RET Z
5037+ BAB7
5038+ BAB7                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
5039+ BAB7                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
5040+ BAB7 21 17 BB         LD HL, .sppShifts
5041+ BABA              .sppLoop:
5042+ BABA 7E               LD A, (HL)
5043+ BABB 23               INC HL
5044+ BABC 47               LD B, A                             ; dx (signed)
5045+ BABD 7E               LD A, (HL)
5046+ BABE 23               INC HL
5047+ BABF FE 80            CP $80
5048+ BAC1 28 17            JR Z, .sppFail                      ; sentinel
5049+ BAC3 4F               LD C, A                             ; dy (signed)
5050+ BAC4
5051+ BAC4 3A 15 BB         LD A, (.sppBaseX)
5052+ BAC7 80               ADD A, B
5053+ BAC8 DD 77 03         LD (IX+ENT_POSX), A
5054+ BACB 3A 16 BB         LD A, (.sppBaseY)
5055+ BACE 81               ADD A, C
5056+ BACF DD 77 04         LD (IX+ENT_POSY), A
5057+ BAD2
5058+ BAD2 E5               PUSH HL
5059+ BAD3 CD E7 BA         CALL .sppCheckFit
5060+ BAD6 E1               POP HL
5061+ BAD7 C8               RET Z                               ; encontrado
5062+ BAD8 18 E0            JR .sppLoop
5063+ BADA
5064+ BADA              .sppFail:
5065+ BADA 3A 13 BB         LD A, (.sppOrigX)
5066+ BADD DD 77 03         LD (IX+ENT_POSX), A
5067+ BAE0 3A 14 BB         LD A, (.sppOrigY)
5068+ BAE3 DD 77 04         LD (IX+ENT_POSY), A
5069+ BAE6 C9               RET
5070+ BAE7
5071+ BAE7              ; --- .sppCheckFit ---
5072+ BAE7              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5073+ BAE7              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5074+ BAE7              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5075+ BAE7              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5076+ BAE7              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5077+ BAE7              .sppCheckFit:
5078+ BAE7                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5079+ BAE7 DD 7E 03         LD A, (IX+ENT_POSX)
5080+ BAEA FE D1            CP SCREEN_MAX_X - 23
5081+ BAEC 30 21            JR NC, .sppOutOfBounds
5082+ BAEE DD 7E 04         LD A, (IX+ENT_POSY)
5083+ BAF1 FE 10            CP SCREEN_MIN_Y
5084+ BAF3 38 1A            JR C, .sppOutOfBounds
5085+ BAF5 FE 91            CP SCREEN_MAX_Y - 23
5086+ BAF7 30 16            JR NC, .sppOutOfBounds
5087+ BAF9                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5088+ BAF9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5089+ BAFC 32 12 BB         LD (.sppSpritIdSave), A
5090+ BAFF DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5091+ BB03 CD F1 B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5092+ BB06 F5               PUSH AF
5093+ BB07 3A 12 BB         LD A, (.sppSpritIdSave)
5094+ BB0A DD 77 00         LD (IX+ENT_SPRITEID), A
5095+ BB0D F1               POP AF
5096+ BB0E C9               RET
5097+ BB0F              .sppOutOfBounds:
5098+ BB0F F6 01            OR 1                                ; NZ
5099+ BB11 C9               RET
5100+ BB12
5101+ BB12 00           .sppSpritIdSave: DEFB 0
5102+ BB13
5103+ BB13 00           .sppOrigX: DEFB 0
5104+ BB14 00           .sppOrigY: DEFB 0
5105+ BB15 00           .sppBaseX: DEFB 0
5106+ BB16 00           .sppBaseY: DEFB 0
5107+ BB17              .sppShifts:
5108+ BB17                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5109+ BB17                  ; Distancia creciente. Sentinel: dy=$80.
5110+ BB17 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5111+ BB19 00 F8            DEFB 0,   -8                        ; arriba 8
5112+ BB1B 00 08            DEFB 0,    8                        ; abajo 8
5113+ BB1D F8 00            DEFB -8,   0                        ; izq 8
5114+ BB1F 08 00            DEFB 8,    0                        ; der 8
5115+ BB21 00 F0            DEFB 0,  -16                        ; arriba 16
5116+ BB23 00 10            DEFB 0,   16                        ; abajo 16
5117+ BB25 F8 F8            DEFB -8,  -8
5118+ BB27 08 F8            DEFB 8,   -8
5119+ BB29 F8 08            DEFB -8,   8
5120+ BB2B 08 08            DEFB 8,    8
5121+ BB2D 00 80            DEFB 0,  $80                        ; sentinel
5122+ BB2F
5123+ BB2F              ; ==============================================================================
5124+ BB2F              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5125+ BB2F              ; ==============================================================================
5126+ BB2F              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5127+ BB2F              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5128+ BB2F              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5129+ BB2F              ; DeathSpawned. No-op si la muerte no esta activa.
5130+ BB2F              ; ==============================================================================
5131+ BB2F              SilentKillDeath:
5132+ BB2F DD 21 50 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5133+ BB33 DD 7E 01         LD A, (IX+ENT_TYPE)
5134+ BB36 B7               OR A
5135+ BB37 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5136+ BB39 CD 44 C7         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5137+ BB3C AF               XOR A
5138+ BB3D DD 77 01         LD (IX+ENT_TYPE), A
5139+ BB40 32 FF 82         LD (DeathSpawned), A
5140+ BB43              .skdResetTimer:
5141+ BB43                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5142+ BB43                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5143+ BB43 21 00 00         LD HL, 0
5144+ BB46 22 FC 82         LD (DeathScreenTimer), HL
5145+ BB49                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5146+ BB49                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5147+ BB49                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5148+ BB49                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5149+ BB49                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5150+ BB49 C9               RET
5151+ BB4A
5152+ BB4A              ; ==============================================================================
5153+ BB4A              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5154+ BB4A              ; ==============================================================================
5155+ BB4A              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5156+ BB4A              ; no DYING ni SPAWNING):
5157+ BB4A              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5158+ BB4A              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5159+ BB4A              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5160+ BB4A              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5161+ BB4A              ;     Si tampoco, deja el monster donde estaba.
5162+ BB4A              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5163+ BB4A              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5164+ BB4A              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5165+ BB4A              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5166+ BB4A              ; ==============================================================================
5167+ BB4A              FreezeMonstersFacingCorpse:
5168+ BB4A                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5169+ BB4A 3A A3 81         LD A, (EntityTable + ENT_POSX)
5170+ BB4D 32 F6 82         LD (CorpseX), A
5171+ BB50 3A A4 81         LD A, (EntityTable + ENT_POSY)
5172+ BB53 32 F7 82         LD (CorpseY), A
5173+ BB56                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5174+ BB56                  ; ya skipea; no aplica aqui pero por simetria)
5175+ BB56 3E 01            LD A, 1
5176+ BB58 32 F5 82         LD (MonstersFrozen), A
5177+ BB5B DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5178+ BB5F 06 06            LD B, NUM_MONSTERS
5179+ BB61              .fmcLoop:
5180+ BB61 C5               PUSH BC
5181+ BB62 DD 7E 01         LD A, (IX+ENT_TYPE)
5182+ BB65 FE 02            CP TYPE_MONSTER
5183+ BB67 20 0E            JR NZ, .fmcNext
5184+ BB69 DD 7E 02         LD A, (IX+ENT_STATE)
5185+ BB6C FE 03            CP STATE_DYING
5186+ BB6E 28 07            JR Z, .fmcNext
5187+ BB70 FE 04            CP STATE_SPAWNING
5188+ BB72 28 03            JR Z, .fmcNext
5189+ BB74 CD 80 BB         CALL FreezeOneMonster
5190+ BB77              .fmcNext:
5191+ BB77 C1               POP BC
5192+ BB78 11 10 00         LD DE, ENT_SIZE
5193+ BB7B DD 19            ADD IX, DE
5194+ BB7D 10 E2            DJNZ .fmcLoop
5195+ BB7F C9               RET
5196+ BB80
5197+ BB80              ; --- FreezeOneMonster ---
5198+ BB80              ; IX = monster slot pointer.
5199+ BB80              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5200+ BB80              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5201+ BB80              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5202+ BB80              FreezeOneMonster:
5203+ BB80                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5204+ BB80                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5205+ BB80                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5206+ BB80 DD 7E 03         LD A, (IX+ENT_POSX)
5207+ BB83 47               LD B, A
5208+ BB84 3A F6 82         LD A, (CorpseX)
5209+ BB87 B8               CP B
5210+ BB88 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5211+ BB8A 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5212+ BB8C              .fomFaceE:
5213+ BB8C DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5214+ BB8F C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5215+ BB91 DD 77 00         LD (IX+ENT_SPRITEID), A
5216+ BB94 18 08            JR .fomFaceDone
5217+ BB96              .fomFaceW:
5218+ BB96 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5219+ BB99 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5220+ BB9B DD 77 00         LD (IX+ENT_SPRITEID), A
5221+ BB9E              .fomFaceDone:
5222+ BB9E
5223+ BB9E                  ; --- 2) Computar |dx| y |dy| ---
5224+ BB9E 3A F6 82         LD A, (CorpseX)
5225+ BBA1 4F               LD C, A
5226+ BBA2 DD 7E 03         LD A, (IX+ENT_POSX)
5227+ BBA5 91               SUB C                           ; A = posX - corpseX (signed)
5228+ BBA6 30 02            JR NC, .fomDxPos
5229+ BBA8 ED 44            NEG
5230+ BBAA              .fomDxPos:
5231+ BBAA 32 FB BB         LD (.fomAdx), A
5232+ BBAD 3A F7 82         LD A, (CorpseY)
5233+ BBB0 4F               LD C, A
5234+ BBB1 DD 7E 04         LD A, (IX+ENT_POSY)
5235+ BBB4 91               SUB C
5236+ BBB5 30 02            JR NC, .fomDyPos
5237+ BBB7 ED 44            NEG
5238+ BBB9              .fomDyPos:
5239+ BBB9 32 FC BB         LD (.fomAdy), A
5240+ BBBC
5241+ BBBC                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5242+ BBBC 3A FB BB         LD A, (.fomAdx)
5243+ BBBF FE 10            CP 16
5244+ BBC1 D2 EA BB         JP NC, .fomFreeze
5245+ BBC4 3A FC BB         LD A, (.fomAdy)
5246+ BBC7 FE 10            CP 16
5247+ BBC9 D2 EA BB         JP NC, .fomFreeze
5248+ BBCC
5249+ BBCC                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5250+ BBCC 3A FB BB         LD A, (.fomAdx)
5251+ BBCF 47               LD B, A
5252+ BBD0 3A FC BB         LD A, (.fomAdy)
5253+ BBD3 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5254+ BBD4 38 0C            JR C, .fomTryX
5255+ BBD6 28 0A            JR Z, .fomTryX
5256+ BBD8                  ; |dy| > |dx| -> intentar Y primero
5257+ BBD8 CD 30 BC         CALL TryBackoffY
5258+ BBDB 28 0D            JR Z, .fomFreeze                ; ok
5259+ BBDD CD FD BB         CALL TryBackoffX
5260+ BBE0 18 08            JR .fomFreeze
5261+ BBE2              .fomTryX:
5262+ BBE2 CD FD BB         CALL TryBackoffX
5263+ BBE5 28 03            JR Z, .fomFreeze
5264+ BBE7 CD 30 BC         CALL TryBackoffY
5265+ BBEA
5266+ BBEA              .fomFreeze:
5267+ BBEA                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5268+ BBEA                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5269+ BBEA DD 36 06 00      LD (IX+ENT_DELTAX), 0
5270+ BBEE DD 36 07 00      LD (IX+ENT_DELTAY), 0
5271+ BBF2 DD 36 0A 00      LD (IX+ENT_DIR), 0
5272+ BBF6 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5273+ BBFA C9               RET
5274+ BBFB
5275+ BBFB 00           .fomAdx: DEFB 0
5276+ BBFC 00           .fomAdy: DEFB 0
5277+ BBFD
5278+ BBFD              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5279+ BBFD              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5280+ BBFD              TryBackoffX:
5281+ BBFD DD 7E 03         LD A, (IX+ENT_POSX)
5282+ BC00 32 2F BC         LD (.tbxSavePos), A
5283+ BC03 47               LD B, A
5284+ BC04 3A F6 82         LD A, (CorpseX)
5285+ BC07 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5286+ BC08 DD 7E 03         LD A, (IX+ENT_POSX)
5287+ BC0B 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5288+ BC0D C6 10            ADD A, 16
5289+ BC0F 18 02            JR .tbxApply
5290+ BC11              .tbxNeg:
5291+ BC11 D6 10            SUB 16
5292+ BC13              .tbxApply:
5293+ BC13                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5294+ BC13 DD 77 03         LD (IX+ENT_POSX), A
5295+ BC16 FE E8            CP SCREEN_MAX_X
5296+ BC18 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5297+ BC1A CD F1 B6         CALL CheckEnemyCollision
5298+ BC1D 20 07            JR NZ, .tbxFail
5299+ BC1F CD 67 BC         CALL CheckMonsterOverlap
5300+ BC22 20 02            JR NZ, .tbxFail
5301+ BC24 AF               XOR A                           ; Z = ok
5302+ BC25 C9               RET
5303+ BC26              .tbxFail:
5304+ BC26 3A 2F BC         LD A, (.tbxSavePos)
5305+ BC29 DD 77 03         LD (IX+ENT_POSX), A
5306+ BC2C F6 01            OR 1                            ; NZ
5307+ BC2E C9               RET
5308+ BC2F 00           .tbxSavePos: DEFB 0
5309+ BC30
5310+ BC30              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5311+ BC30              TryBackoffY:
5312+ BC30 DD 7E 04         LD A, (IX+ENT_POSY)
5313+ BC33 32 66 BC         LD (.tbySavePos), A
5314+ BC36 47               LD B, A
5315+ BC37 3A F7 82         LD A, (CorpseY)
5316+ BC3A B8               CP B
5317+ BC3B DD 7E 04         LD A, (IX+ENT_POSY)
5318+ BC3E 30 04            JR NC, .tbyNeg
5319+ BC40 C6 10            ADD A, 16
5320+ BC42 18 02            JR .tbyApply
5321+ BC44              .tbyNeg:
5322+ BC44 D6 10            SUB 16
5323+ BC46              .tbyApply:
5324+ BC46 DD 77 04         LD (IX+ENT_POSY), A
5325+ BC49 FE 10            CP SCREEN_MIN_Y
5326+ BC4B 38 10            JR C, .tbyFail
5327+ BC4D FE A8            CP SCREEN_MAX_Y
5328+ BC4F 30 0C            JR NC, .tbyFail
5329+ BC51 CD F1 B6         CALL CheckEnemyCollision
5330+ BC54 20 07            JR NZ, .tbyFail
5331+ BC56 CD 67 BC         CALL CheckMonsterOverlap
5332+ BC59 20 02            JR NZ, .tbyFail
5333+ BC5B AF               XOR A
5334+ BC5C C9               RET
5335+ BC5D              .tbyFail:
5336+ BC5D 3A 66 BC         LD A, (.tbySavePos)
5337+ BC60 DD 77 04         LD (IX+ENT_POSY), A
5338+ BC63 F6 01            OR 1
5339+ BC65 C9               RET
5340+ BC66 00           .tbySavePos: DEFB 0
5341+ BC67
5342+ BC67              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5343+ BC67              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5344+ BC67              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5345+ BC67              CheckMonsterOverlap:
5346+ BC67 C5               PUSH BC
5347+ BC68 FD E5            PUSH IY
5348+ BC6A FD 21 B0 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5349+ BC6E 06 06            LD B, NUM_MONSTERS
5350+ BC70              .cmoLoop:
5351+ BC70                  ; Skip self (IY == IX)
5352+ BC70 DD E5            PUSH IX
5353+ BC72 E1               POP HL
5354+ BC73 FD E5            PUSH IY
5355+ BC75 D1               POP DE
5356+ BC76 B7               OR A
5357+ BC77 ED 52            SBC HL, DE
5358+ BC79 28 3D            JR Z, .cmoNext                  ; same slot
5359+ BC7B
5360+ BC7B FD 7E 01         LD A, (IY+ENT_TYPE)
5361+ BC7E FE 02            CP TYPE_MONSTER
5362+ BC80 20 36            JR NZ, .cmoNext
5363+ BC82
5364+ BC82                  ; AABB overlap (rect 16x21 cada uno):
5365+ BC82                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5366+ BC82                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5367+ BC82 DD 7E 03         LD A, (IX+ENT_POSX)
5368+ BC85 C6 10            ADD A, 16
5369+ BC87 4F               LD C, A
5370+ BC88 FD 7E 03         LD A, (IY+ENT_POSX)
5371+ BC8B B9               CP C                            ; iy.x cmp ix.x+16
5372+ BC8C 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5373+ BC8E FD 7E 03         LD A, (IY+ENT_POSX)
5374+ BC91 C6 10            ADD A, 16
5375+ BC93 4F               LD C, A
5376+ BC94 DD 7E 03         LD A, (IX+ENT_POSX)
5377+ BC97 B9               CP C
5378+ BC98 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5379+ BC9A DD 7E 04         LD A, (IX+ENT_POSY)
5380+ BC9D C6 15            ADD A, 21
5381+ BC9F 4F               LD C, A
5382+ BCA0 FD 7E 04         LD A, (IY+ENT_POSY)
5383+ BCA3 B9               CP C
5384+ BCA4 30 12            JR NC, .cmoNext
5385+ BCA6 FD 7E 04         LD A, (IY+ENT_POSY)
5386+ BCA9 C6 15            ADD A, 21
5387+ BCAB 4F               LD C, A
5388+ BCAC DD 7E 04         LD A, (IX+ENT_POSY)
5389+ BCAF B9               CP C
5390+ BCB0 30 06            JR NC, .cmoNext
5391+ BCB2                  ; Overlap en ambos ejes
5392+ BCB2 FD E1            POP IY
5393+ BCB4 C1               POP BC
5394+ BCB5 F6 01            OR 1                            ; NZ
5395+ BCB7 C9               RET
5396+ BCB8              .cmoNext:
5397+ BCB8 11 10 00         LD DE, ENT_SIZE
5398+ BCBB FD 19            ADD IY, DE
5399+ BCBD 10 B1            DJNZ .cmoLoop
5400+ BCBF FD E1            POP IY
5401+ BCC1 C1               POP BC
5402+ BCC2 AF               XOR A                           ; Z = no overlap
5403+ BCC3 C9               RET
5404+ BCC4
5405+ BCC4              ; ==============================================================================
5406+ BCC4              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5407+ BCC4              ; ==============================================================================
5408+ BCC4              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5409+ BCC4              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5410+ BCC4              ; ==============================================================================
5411+ BCC4              KillAllActiveMonsters:
5412+ BCC4 AF               XOR A
5413+ BCC5 32 8C B3         LD (MonstersActive), A              ; No respawnear mas
5414+ BCC8 DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5415+ BCCC 06 06            LD B, NUM_MONSTERS
5416+ BCCE              .kamLoop:
5417+ BCCE C5               PUSH BC
5418+ BCCF DD 7E 01         LD A, (IX+ENT_TYPE)
5419+ BCD2 B7               OR A
5420+ BCD3 28 27            JR Z, .kamSkip                      ; slot vacio
5421+ BCD5 FE 02            CP TYPE_MONSTER
5422+ BCD7 20 23            JR NZ, .kamSkip                     ; no es monster
5423+ BCD9 DD 7E 02         LD A, (IX+ENT_STATE)
5424+ BCDC FE 03            CP STATE_DYING
5425+ BCDE 28 1C            JR Z, .kamSkip
5426+ BCE0 FE 04            CP STATE_SPAWNING
5427+ BCE2 28 18            JR Z, .kamSkip
5428+ BCE4 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5429+ BCE8 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5430+ BCEC DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5431+ BCF0 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5432+ BCF4 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5433+ BCF8 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5434+ BCFC                  ; ENT_ATTR conservado: puff hereda color del monster
5435+ BCFC              .kamSkip:
5436+ BCFC 11 10 00         LD DE, ENT_SIZE
5437+ BCFF DD 19            ADD IX, DE
5438+ BD01 C1               POP BC
5439+ BD02 10 CA            DJNZ .kamLoop
5440+ BD04 C9               RET
5441+ BD05
5442+ BD05              ; --- Tabla de tipos de nasty (SpriteID base) ---
5443+ BD05              ; --- Tablas de nasties por momento del dia ---
5444+ BD05              NUM_NASTY_TYPES EQU 4
5445+ BD05              DiurnalTypeTable:                       ; DY, C1, A2
5446+ BD05 30               DEFB SPRID_ENEMY_4          ; Eagle
5447+ BD06 20               DEFB SPRID_ENEMY_0          ; Spider
5448+ BD07 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5449+ BD08 2C               DEFB SPRID_ENEMY_3          ; Snake
5450+ BD09              CrepuscularTypeTable:                   ; C2, N1
5451+ BD09 34               DEFB SPRID_ENEMY_5          ; Rat
5452+ BD0A 28               DEFB SPRID_ENEMY_2          ; Bat
5453+ BD0B 24               DEFB SPRID_ENEMY_1          ; Scorpion
5454+ BD0C 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5455+ BD0D
5456+ BD0D              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5457+ BD0D              NastyColorTable:
5458+ BD0D 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5459+ BD0E 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5460+ BD0F 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5461+ BD10 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5462+ BD11 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5463+ BD12 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5464+ BD13 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5465+ BD14 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5466+ BD15
5467+ BD15              ; --- Tabla de comportamiento depredador ---
5468+ BD15              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5469+ BD15              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5470+ BD15              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5471+ BD15              PredatorTable:
5472+ BD15 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5473+ BD16 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5474+ BD17 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5475+ BD18 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5476+ BD19 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5477+ BD1A 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5478+ BD1B 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5479+ BD1C 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5480+ BD1D
5481+ BD1D              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5482+ BD1D              PredatorSpeedTable:
5483+ BD1D 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5484+ BD1E 02               DEFB 2                              ; Ciclo 1: lento
5485+ BD1F 03               DEFB 3                              ; Ciclo 2: intermedio
5486+ BD20 04               DEFB 4                              ; Ciclo 3+: rapido
5487+ BD21
5488+ BD21 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5489+ BD22
5490+ BD22 05 BD        CurrentNastyTable: DEFW DiurnalTypeTable
5491+ BD24
5492+ BD24              ; ==============================================================================
5493+ BD24              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5494+ BD24              ; ==============================================================================
5495+ BD24              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5496+ BD24              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5497+ BD24              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5498+ BD24              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5499+ BD24              ;   pantalla, no diurnos.
5500+ BD24              ; ==============================================================================
5501+ BD24              UpdateNastyTable:
5502+ BD24 3A 9A E3         LD A, (CurrentTimeOfDay)
5503+ BD27 FE 02            CP 2
5504+ BD29 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5505+ BD2B FE 06            CP 6
5506+ BD2D 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5507+ BD2F 21 09 BD         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5508+ BD32 18 03            JR .setTable
5509+ BD34              .diurnal:
5510+ BD34 21 05 BD         LD HL, DiurnalTypeTable
5511+ BD37              .setTable:
5512+ BD37 22 22 BD         LD (CurrentNastyTable), HL
5513+ BD3A C9               RET
5514+ BD3B
5515+ BD3B              ; ==============================================================================
5516+ BD3B              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5517+ BD3B              ; ==============================================================================
5518+ BD3B              ScareAllMonsters:
5519+ BD3B AF               XOR A
5520+ BD3C 32 8C B3         LD (MonstersActive), A              ; No respawnear mas
5521+ BD3F                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5522+ BD3F                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5523+ BD3F                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5524+ BD3F 21 98 8D         LD HL, MonsterAiFlags
5525+ BD42 06 03            LD B, 3
5526+ BD44              .samClearLoop:
5527+ BD44 7E               LD A, (HL)
5528+ BD45 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5529+ BD47 77               LD (HL), A
5530+ BD48 23               INC HL
5531+ BD49 10 F9            DJNZ .samClearLoop
5532+ BD4B 3E 7D            LD A, SCARE_TIMER_DAWN
5533+ BD4D 32 22 B6         LD (ScareTimer), A
5534+ BD50                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5535+ BD50                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5536+ BD50                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5537+ BD50                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5538+ BD50 DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5539+ BD54 06 06            LD B, NUM_MONSTERS
5540+ BD56              .samStateLoop:
5541+ BD56 DD 7E 01         LD A, (IX+ENT_TYPE)
5542+ BD59 FE 02            CP TYPE_MONSTER
5543+ BD5B 20 1B            JR NZ, .samStateNext
5544+ BD5D DD 7E 02         LD A, (IX+ENT_STATE)
5545+ BD60 FE 03            CP STATE_DYING
5546+ BD62 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5547+ BD64 FE 04            CP STATE_SPAWNING
5548+ BD66 28 10            JR Z, .samStateNext
5549+ BD68 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5550+ BD6C DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5551+ BD70 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5552+ BD74 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5553+ BD78              .samStateNext:
5554+ BD78 11 10 00         LD DE, ENT_SIZE
5555+ BD7B DD 19            ADD IX, DE
5556+ BD7D 10 D7            DJNZ .samStateLoop
5557+ BD7F C9               RET
5558+ BD80
5559+ BD80              ; ==============================================================================
5560+ BD80              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5561+ BD80              ; ==============================================================================
5562+ BD80              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5563+ BD80              ; ==============================================================================
5564+ BD80
5565+ BD80              ; ==============================================================================
5566+ BD80              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5567+ BD80              ; ==============================================================================
5568+ BD80              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5569+ BD80              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5570+ BD80              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5571+ BD80              ; ==============================================================================
5572+ BD80              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5573+ BD80              ; ==============================================================================
5574+ BD80              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5575+ BD80              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5576+ BD80              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5577+ BD80              ; ==============================================================================
5578+ BD80              MONSTERS_TO_SPAWN   EQU 3
5579+ BD80              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5580+ BD80              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5581+ BD80
5582+ BD80              ; ==============================================================================
5583+ BD80              ; SpawnMonsters - Primera aparicion tras campanadas
5584+ BD80              ; ==============================================================================
5585+ BD80              SpawnMonsters:
5586+ BD80                  IF DEBUG_NO_ENEMIES
5587+ BD80 ~                RET
5588+ BD80                  ENDIF
5589+ BD80 3A 8C B3         LD A, (MonstersActive)
5590+ BD83 B7               OR A
5591+ BD84 C0               RET NZ
5592+ BD85                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5593+ BD85                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5594+ BD85 CD 61 BA         CALL KillAllActiveNasties
5595+ BD88 3E 01            LD A, 1
5596+ BD8A 32 8C B3         LD (MonstersActive), A
5597+ BD8D CD 0A BE         CALL ShuffleMonsterTypes
5598+ BD90 DD 21 B0 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5599+ BD94 06 03            LD B, MONSTERS_TO_SPAWN
5600+ BD96 0E 00            LD C, 0
5601+ BD98              .smLoop:
5602+ BD98 C5               PUSH BC
5603+ BD99 DD 7E 01         LD A, (IX+ENT_TYPE)
5604+ BD9C B7               OR A
5605+ BD9D C2 F9 BD         JP NZ, .smSkip
5606+ BDA0                  ; Asignar tipo y color
5607+ BDA0 79               LD A, C
5608+ BDA1 21 6E BE         LD HL, MonsterTypeTable
5609+ BDA4 5F               LD E, A
5610+ BDA5 16 00            LD D, 0
5611+ BDA7 19               ADD HL, DE
5612+ BDA8 7E               LD A, (HL)
5613+ BDA9 DD 77 08         LD (IX+ENT_ANIMBASE), A
5614+ BDAC 79               LD A, C
5615+ BDAD 21 71 BE         LD HL, MonsterColorTable
5616+ BDB0 5F               LD E, A
5617+ BDB1 16 00            LD D, 0
5618+ BDB3 19               ADD HL, DE
5619+ BDB4 7E               LD A, (HL)
5620+ BDB5 DD 77 05         LD (IX+ENT_ATTR), A
5621+ BDB8                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5622+ BDB8 C5               PUSH BC
5623+ BDB9 CD BD 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5624+ BDBC B7               OR A
5625+ BDBD 20 0E            JR NZ, .smFallbackPos
5626+ BDBF 3A C5 97         LD A, (MaiSpawnX)
5627+ BDC2 DD 77 03         LD (IX+ENT_POSX), A
5628+ BDC5 3A C6 97         LD A, (MaiSpawnY)
5629+ BDC8 DD 77 04         LD (IX+ENT_POSY), A
5630+ BDCB 18 0C            JR .smPosDone
5631+ BDCD              .smFallbackPos:
5632+ BDCD 3A 13 83         LD A, (LastEntryPosX)
5633+ BDD0 DD 77 03         LD (IX+ENT_POSX), A
5634+ BDD3 3A 14 83         LD A, (LastEntryPosY)
5635+ BDD6 DD 77 04         LD (IX+ENT_POSY), A
5636+ BDD9              .smPosDone:
5637+ BDD9 C1               POP BC
5638+ BDDA                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5639+ BDDA DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5640+ BDDE DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5641+ BDE2 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5642+ BDE6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5643+ BDEA DD 36 07 00      LD (IX+ENT_DELTAY), 0
5644+ BDEE                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5645+ BDEE                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5646+ BDEE                  ; lo empuje a un vecino (migracion por knockback).
5647+ BDEE CD B2 8E         CALL MaiGetCurrentScreenId
5648+ BDF1 21 8C 8D         LD HL, MonsterRoomId
5649+ BDF4 59               LD E, C
5650+ BDF5 16 00            LD D, 0
5651+ BDF7 19               ADD HL, DE
5652+ BDF8 77               LD (HL), A
5653+ BDF9              .smSkip:
5654+ BDF9 11 10 00         LD DE, ENT_SIZE
5655+ BDFC DD 19            ADD IX, DE
5656+ BDFE C1               POP BC
5657+ BDFF 0C               INC C
5658+ BE00 05               DEC B
5659+ BE01 C2 98 BD         JP NZ, .smLoop
5660+ BE04 3E 14            LD A, MONSTER_ENTRY_BASE
5661+ BE06 32 58 BF         LD (TryRespawnMonsters.rmTimer), A
5662+ BE09                  ; MonstersMusic NO arranca aqui — arranca en TryRespawnMonsters cuando
5663+ BE09                  ; el PRIMER monster aparece visible (tras MONSTER_ENTRY_BASE frames).
5664+ BE09                  ; Asi el "po-po-popo-po" coincide con la primera aparicion en pantalla.
5665+ BE09 C9               RET
5666+ BE0A
5667+ BE0A              ; --- Barajar tablas tipo/color ---
5668+ BE0A              ShuffleMonsterTypes:
5669+ BE0A ED 5F            LD A, R
5670+ BE0C E6 03            AND 3
5671+ BE0E C8               RET Z
5672+ BE0F FE 01            CP 1
5673+ BE11 28 21            JR Z, .shSwap01
5674+ BE13 FE 02            CP 2
5675+ BE15 28 3A            JR Z, .shSwap12
5676+ BE17 3A 6E BE         LD A, (MonsterTypeTable)
5677+ BE1A 57               LD D, A
5678+ BE1B 3A 70 BE         LD A, (MonsterTypeTable + 2)
5679+ BE1E 32 6E BE         LD (MonsterTypeTable), A
5680+ BE21 7A               LD A, D
5681+ BE22 32 70 BE         LD (MonsterTypeTable + 2), A
5682+ BE25 3A 71 BE         LD A, (MonsterColorTable)
5683+ BE28 57               LD D, A
5684+ BE29 3A 73 BE         LD A, (MonsterColorTable + 2)
5685+ BE2C 32 71 BE         LD (MonsterColorTable), A
5686+ BE2F 7A               LD A, D
5687+ BE30 32 73 BE         LD (MonsterColorTable + 2), A
5688+ BE33 C9               RET
5689+ BE34              .shSwap01:
5690+ BE34 3A 6E BE         LD A, (MonsterTypeTable)
5691+ BE37 57               LD D, A
5692+ BE38 3A 6F BE         LD A, (MonsterTypeTable + 1)
5693+ BE3B 32 6E BE         LD (MonsterTypeTable), A
5694+ BE3E 7A               LD A, D
5695+ BE3F 32 6F BE         LD (MonsterTypeTable + 1), A
5696+ BE42 3A 71 BE         LD A, (MonsterColorTable)
5697+ BE45 57               LD D, A
5698+ BE46 3A 72 BE         LD A, (MonsterColorTable + 1)
5699+ BE49 32 71 BE         LD (MonsterColorTable), A
5700+ BE4C 7A               LD A, D
5701+ BE4D 32 72 BE         LD (MonsterColorTable + 1), A
5702+ BE50 C9               RET
5703+ BE51              .shSwap12:
5704+ BE51 3A 6F BE         LD A, (MonsterTypeTable + 1)
5705+ BE54 57               LD D, A
5706+ BE55 3A 70 BE         LD A, (MonsterTypeTable + 2)
5707+ BE58 32 6F BE         LD (MonsterTypeTable + 1), A
5708+ BE5B 7A               LD A, D
5709+ BE5C 32 70 BE         LD (MonsterTypeTable + 2), A
5710+ BE5F 3A 72 BE         LD A, (MonsterColorTable + 1)
