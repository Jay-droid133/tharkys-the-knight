 191+ 9EAC              ; ==============================================================================
 192+ 9EAC              ; InitEntities - Inicializa la tabla de entidades
 193+ 9EAC              ; ==============================================================================
 194+ 9EAC              ; Limpia todos los slots y configura el slot 0 como player.
 195+ 9EAC              ; ==============================================================================
 196+ 9EAC              InitEntities:
 197+ 9EAC                  ; Limpiar toda la tabla a ceros
 198+ 9EAC 21 A3 81         LD HL, EntityTable
 199+ 9EAF 11 A4 81         LD DE, EntityTable + 1
 200+ 9EB2 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 201+ 9EB5 AF               XOR A
 202+ 9EB6 77               LD (HL), A
 203+ 9EB7 ED B0            LDIR
 204+ 9EB9
 205+ 9EB9                  ; Limpiar tabla de atributos salvados
 206+ 9EB9 21 DF 9B         LD HL, SavedAttrTable
 207+ 9EBC 11 E0 9B         LD DE, SavedAttrTable + 1
 208+ 9EBF 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 209+ 9EC2 AF               XOR A
 210+ 9EC3 77               LD (HL), A
 211+ 9EC4 ED B0            LDIR
 212+ 9EC6
 213+ 9EC6                  ; Configurar slot 0: Player
 214+ 9EC6 DD 21 A3 81      LD IX, EntityTable
 215+ 9ECA DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 216+ 9ECE DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 217+ 9ED2 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 218+ 9ED6 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 219+ 9EDA DD 36 04 A0      LD (IX+ENT_POSY), START_PLAYER_Y
 220+ 9EDE DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 221+ 9EE2 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 222+ 9EE6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 223+ 9EEA DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 224+ 9EEE DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 225+ 9EF2 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 226+ 9EF6 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 227+ 9EFA DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 228+ 9EFE DD 36 0D A0      LD (IX+ENT_OLDY), START_PLAYER_Y
 229+ 9F02 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 230+ 9F06 DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
