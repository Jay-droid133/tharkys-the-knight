 579+ FBCD              ; ---- Phase 8: 6 toques (KNOCKS_3) ----
 580+ FBCD              .bcPhKnocks3:
 581+ FBCD 3E 06            LD A, BCS_GROUP3_KNOCKS
 582+ FBCF CD 3B FD         CALL BankCutsceneTickKnockGroup
 583+ FBD2 B7               OR A
 584+ FBD3 C8               RET Z
 585+ FBD4                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 586+ FBD4                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 587+ FBD4                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 588+ FBD4 CD 23 FA         CALL BankCutsceneSnapToRetreat
 589+ FBD7 3E 1E            LD A, BCS_T_PRE_HAND
 590+ FBD9 32 CA 82         LD (BankCutsceneTimer), A
 591+ FBDC 3E 09            LD A, BCP_WAIT_3
 592+ FBDE 32 C9 82         LD (BankCutscenePhase), A
 593+ FBE1 C9               RET
 594+ FBE2
 595+ FBE2              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 596+ FBE2              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 597+ FBE2              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 598+ FBE2              .bcPhWait3:
 599+ FBE2 CD F7 FD         CALL BankCutsceneDecTimer
 600+ FBE5 C0               RET NZ
 601+ FBE6 CD 11 FE         CALL SFX_Bank_OnDoorCreak
 602+ FBE9 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 603+ FBEB 32 CA 82         LD (BankCutsceneTimer), A
 604+ FBEE 3E 0A            LD A, BCP_PRE_HAND
 605+ FBF0 32 C9 82         LD (BankCutscenePhase), A
 606+ FBF3 C9               RET
 607+ FBF4
 608+ FBF4              ; ---- Phase 10: hold corto antes de la mano ----
 609+ FBF4              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 610+ FBF4              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 611+ FBF4              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 612+ FBF4              ;
 613+ FBF4              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 614+ FBF4              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 615+ FBF4              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 616+ FBF4              ; mano "no no" aparece (HAND_NO_NO).
 617+ FBF4              ;
 618+ FBF4              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 619+ FBF4              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 620+ FBF4              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 621+ FBF4              .bcPhPreHand:
 622+ FBF4 CD F7 FD         CALL BankCutsceneDecTimer
 623+ FBF7 C0               RET NZ
 624+ FBF8 AF               XOR A
 625+ FBF9 32 CE 82         LD (BankCutsceneHandFrame), A           ; frame 1 (= seq[0])
 626+ FBFC 32 CD 82         LD (BankCutsceneNoIdx), A               ; 0 slots completados
 627+ FBFF CD 79 FD         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 628+ FC02 CD D7 FD         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 629+ FC05 CD 12 FE         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 630+ FC08 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 631+ FC0A 32 CA 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 632+ FC0D 3E 13            LD A, BCP_HAND_OPEN_IN
 633+ FC0F 32 C9 82         LD (BankCutscenePhase), A
 634+ FC12 C9               RET
 635+ FC13
 636+ FC13              ; ---- Phase 19: HAND_OPEN_IN — anim scripted + hold + cobro ----
 637+ FC13              ; Tabla BCS_OpenHandSeq dicta la secuencia visible (1 byte por estado:
 638+ FC13              ; 0=frame 1, 1=frame 2). NoIdx = nº de slots COMPLETADOS hasta ahora; al
 639+ FC13              ; entrar HAND_OPEN_IN el slot 0 (seq[0]) ya esta dibujado por PRE_HAND.
 640+ FC13              ;
 641+ FC13              ; Cada tick (timer=0):
 642+ FC13              ;   - NoIdx >= LEN: hold expirado -> cobro
 643+ FC13              ;   - NoIdx <  LEN: avanzar al siguiente slot:
 644+ FC13              ;       leer seq[NoIdx], swap al frame indicado si != HandFrame
 645+ FC13              ;       NoIdx++
 646+ FC13              ;       si NoIdx == LEN: timer = HOLD (ultimo slot ya dibujado, hold estatico)
 647+ FC13              ;       si NoIdx <  LEN: timer = SWAP
 648+ FC13              ;
 649+ FC13              ; Cobro: clink -> CurrentKey=0 -> erase mano -> cierra puerta -> chof
 650+ FC13              ;   -> BCP_HAND_OPEN_OUT.
 651+ FC13              .bcPhHandOpenIn:
 652+ FC13 CD F7 FD         CALL BankCutsceneDecTimer
 653+ FC16 C0               RET NZ
 654+ FC17 3A CD 82         LD A, (BankCutsceneNoIdx)
 655+ FC1A FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 656+ FC1C 30 32            JR NC, .bcOpenInCobro                   ; anim + hold acabados -> cobro
 657+ FC1E                  ; Avanzar al siguiente slot. NoIdx ya esta en A.
 658+ FC1E 21 6B FC         LD HL, .openHandSeq
 659+ FC21 5F               LD E, A
 660+ FC22 16 00            LD D, 0
 661+ FC24 19               ADD HL, DE
 662+ FC25 7E               LD A, (HL)                              ; A = frame deseado en este slot
 663+ FC26 47               LD B, A                                 ; B = frame deseado
 664+ FC27 3A CE 82         LD A, (BankCutsceneHandFrame)
 665+ FC2A B8               CP B
 666+ FC2B 28 0C            JR Z, .bcOpenInNoSwap                   ; mismo frame, no hace falta swap
 667+ FC2D                  ; OJO: BankCutsceneEraseHandOpen -> DrawHandOpen -> LDIR (con BC=34)
 668+ FC2D                  ; corrompe BC. Sin PUSH/POP, B queda a 0 al volver y HandFrame siempre se
 669+ FC2D                  ; setea a frame 1 -> animacion invisible (parece estatica).
 670+ FC2D C5               PUSH BC                                 ; preserva frame deseado
 671+ FC2E CD F4 FD         CALL BankCutsceneEraseHandOpen          ; XOR self-cancel frame actual
 672+ FC31 C1               POP BC                                  ; recupera frame deseado
 673+ FC32 78               LD A, B
 674+ FC33 32 CE 82         LD (BankCutsceneHandFrame), A
 675+ FC36 CD D7 FD         CALL BankCutsceneDrawHandOpen           ; draw frame nuevo
 676+ FC39              .bcOpenInNoSwap:
 677+ FC39 3A CD 82         LD A, (BankCutsceneNoIdx)
 678+ FC3C 3C               INC A
 679+ FC3D 32 CD 82         LD (BankCutsceneNoIdx), A
 680+ FC40 FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 681+ FC42 28 06            JR Z, .bcOpenInLastSlot
 682+ FC44 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 683+ FC46 32 CA 82         LD (BankCutsceneTimer), A
 684+ FC49 C9               RET
 685+ FC4A              .bcOpenInLastSlot:
 686+ FC4A 3E 1E            LD A, BCS_T_OPEN_HAND_HOLD
 687+ FC4C 32 CA 82         LD (BankCutsceneTimer), A
 688+ FC4F C9               RET
 689+ FC50              .bcOpenInCobro:
 690+ FC50 CD 32 FE         CALL SFX_Bank_OnTake                    ; (1) clink (suena primero)
 691+ FC53 AF               XOR A
 692+ FC54 32 AE 82         LD (CurrentKey), A                      ; (2) consume cheque
 693+ FC57 CD F4 FD         CALL BankCutsceneEraseHandOpen          ; (3) mano desaparece (frame final)
 694+ FC5A CD 9B FD         CALL BankCutsceneCloseDoorRestoreAttrs  ; (4) puerta se cierra
 695+ FC5D CD 2B FE         CALL SFX_Bank_OnDoorClose               ; (5) "chof"
 696+ FC60 3E 4B            LD A, BCS_T_HAND_OPEN_OUT
 697+ FC62 32 CA 82         LD (BankCutsceneTimer), A
 698+ FC65 3E 15            LD A, BCP_HAND_OPEN_OUT
 699+ FC67 32 C9 82         LD (BankCutscenePhase), A
 700+ FC6A C9               RET
 701+ FC6B
 702+ FC6B              ; Tabla scripted de la animacion de la mano abierta. 1 byte por slot visible:
 703+ FC6B              ;   0 = BgGfx_BankHandOpen1 (frame 1, primera pose)
 704+ FC6B              ;   1 = BgGfx_BankHandOpen2 (frame 2, segunda pose)
 705+ FC6B              ; Secuencia: 1 1 2 1 2 1 1 (visible al usuario). Termina en frame 1.
 706+ FC6B              ; LABEL LOCAL (con dot) para preservar el scope sjasmplus de UpdateBankCutscene
 707+ FC6B              ; — un label global aqui rompe el scope de los .bcPhXxx posteriores en el
 708+ FC6B              ; dispatcher.
 709+ FC6B              .openHandSeq:
 710+ FC6B 00 00 01 00      DEFB 0, 0, 1, 0, 1, 0, 0
 710+ FC6F 01 00 00
 711+ FC72
 712+ FC72              ; ---- Phase 21: HAND_OPEN_OUT — puerta cerrada, pausa antes del "no no" ----
 713+ FC72              ; Al expirar: la puerta se reabre y arranca el ciclo "no no":
 714+ FC72              ;   1. Re-XOR-cancel pixels puerta + attrs $47 (mismo helper que PRE_HAND).
 715+ FC72              ;   2. SFX creak de puerta abrir.
 716+ FC72              ;   3. Reset HandFrame/NoIdx (defensivo — ya 0).
 717+ FC72              ;   4. Dibuja "no no" frame 0.
 718+ FC72              ;   5. -> BCP_HAND_NO_NO con timer BCS_T_NO_FRAME.
 719+ FC72              .bcPhHandOpenOut:
 720+ FC72 CD F7 FD         CALL BankCutsceneDecTimer
 721+ FC75 C0               RET NZ
 722+ FC76 CD 79 FD         CALL BankCutsceneOpenDoorWithHandAttrs  ; (1) reabre puerta (pixels + attrs $47)
 723+ FC79 CD 12 FE         CALL SFX_Bank_OnHandIn                  ; (2) creak (mismo SFX que PRE_HAND)
 724+ FC7C AF               XOR A
 725+ FC7D 32 CE 82         LD (BankCutsceneHandFrame), A           ; (3) reset
 726+ FC80 32 CD 82         LD (BankCutsceneNoIdx), A
 727+ FC83 CD B7 FD         CALL BankCutsceneDrawHand               ; (4) "no no" frame 0
 728+ FC86 3E 0C            LD A, BCS_T_NO_FRAME
 729+ FC88 32 CA 82         LD (BankCutsceneTimer), A
 730+ FC8B 3E 0C            LD A, BCP_HAND_NO_NO                    ; (5)
 731+ FC8D 32 C9 82         LD (BankCutscenePhase), A
 732+ FC90 C9               RET
 733+ FC91
 734+ FC91              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 735+ FC91              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 736+ FC91              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 737+ FC91              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 738+ FC91              .bcPhHandIn:
 739+ FC91 CD F7 FD         CALL BankCutsceneDecTimer
 740+ FC94 C0               RET NZ
 741+ FC95 3E 0C            LD A, BCS_T_NO_FRAME
 742+ FC97 32 CA 82         LD (BankCutsceneTimer), A
 743+ FC9A 3E 0C            LD A, BCP_HAND_NO_NO
 744+ FC9C 32 C9 82         LD (BankCutscenePhase), A
 745+ FC9F C9               RET
 746+ FCA0
 747+ FCA0              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 748+ FCA0              .bcPhHandNoNo:
 749+ FCA0 CD F7 FD         CALL BankCutsceneDecTimer
 750+ FCA3 C0               RET NZ
 751+ FCA4                  ; Swap frame: erase actual + draw el otro.
 752+ FCA4 CD D4 FD         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 753+ FCA7 3A CE 82         LD A, (BankCutsceneHandFrame)
 754+ FCAA EE 01            XOR 1
 755+ FCAC 32 CE 82         LD (BankCutsceneHandFrame), A
 756+ FCAF CD B7 FD         CALL BankCutsceneDrawHand           ; draw frame nuevo
 757+ FCB2 CD 18 FE         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 758+ FCB5                  ; Increment swap idx, check completion.
 759+ FCB5 3A CD 82         LD A, (BankCutsceneNoIdx)
 760+ FCB8 3C               INC A
 761+ FCB9 32 CD 82         LD (BankCutsceneNoIdx), A
 762+ FCBC FE 08            CP BCS_NO_SWAPS_TOTAL
 763+ FCBE 38 0B            JR C, .bcNoNoMoreSwaps
 764+ FCC0                  ; Todos los swaps hechos — pausa antes de erase mano.
 765+ FCC0 3E 0F            LD A, BCS_T_HAND_HOLD
 766+ FCC2 32 CA 82         LD (BankCutsceneTimer), A
 767+ FCC5                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 768+ FCC5                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 769+ FCC5 3E 0D            LD A, BCP_HAND_OUT
 770+ FCC7 32 C9 82         LD (BankCutscenePhase), A
 771+ FCCA C9               RET
 772+ FCCB              .bcNoNoMoreSwaps:
 773+ FCCB 3E 0C            LD A, BCS_T_NO_FRAME
 774+ FCCD 32 CA 82         LD (BankCutsceneTimer), A
 775+ FCD0 C9               RET
 776+ FCD1
 777+ FCD1              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 778+ FCD1              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 779+ FCD1              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 780+ FCD1              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 781+ FCD1              ; del pickup dormant).
 782+ FCD1              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 783+ FCD1              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 784+ FCD1              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 785+ FCD1              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 786+ FCD1              ; de la llave.
 787+ FCD1              .bcPhHandOut:
 788+ FCD1 CD F7 FD         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 789+ FCD4 C0               RET NZ
 790+ FCD5 CD D4 FD         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 791+ FCD8 CD 9B FD         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 792+ FCDB CD 2B FE         CALL SFX_Bank_OnDoorClose           ; SFX "chof" cierre de puerta
 793+ FCDE CD 49 FA         CALL BankCutsceneSnapToBackOff      ; player baja 1 char extra (reaccion al portazo final)
 794+ FCE1 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 795+ FCE3 32 CA 82         LD (BankCutsceneTimer), A
 796+ FCE6 3E 12            LD A, BCP_DOOR_CLOSED
 797+ FCE8 32 C9 82         LD (BankCutscenePhase), A
 798+ FCEB C9               RET
 799+ FCEC
 800+ FCEC              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 801+ FCEC              .bcPhDoorClosed:
 802+ FCEC CD F7 FD         CALL BankCutsceneDecTimer
 803+ FCEF C0               RET NZ
 804+ FCF0                  ; --- Spawn de la llave de la ciudad ---
 805+ FCF0 3E 01            LD A, 1
 806+ FCF2 32 C2 82         LD (TownGateKeySpawned), A
 807+ FCF5 21 97 F8         LD HL, SFX_KeyDrop
 808+ FCF8 CD 50 F7         CALL PlaySFX
 809+ FCFB 11 B0 D7         LD DE, BgGfx_town_gate_key
 810+ FCFE CD 0E D8         CALL RedrawPickupByPtr
 811+ FD01                  ; Pausa KEY_HOLD con la llave visible antes de que el player gire.
 812+ FD01 3E 1E            LD A, BCS_T_KEY_HOLD
 813+ FD03 32 CA 82         LD (BankCutsceneTimer), A
 814+ FD06 3E 0E            LD A, BCP_KEY_DROP
 815+ FD08 32 C9 82         LD (BankCutscenePhase), A
 816+ FD0B C9               RET
 817+ FD0C
 818+ FD0C              ; ---- Phase 14: pausa con la llave visible → giro a camara ----
 819+ FD0C              .bcPhKeyDrop:
 820+ FD0C CD F7 FD         CALL BankCutsceneDecTimer
 821+ FD0F C0               RET NZ
 822+ FD10                  ; Player gira a camara final.
 823+ FD10 DD 21 9B 81      LD IX, EntityTable
 824+ FD14 3E 00            LD A, SPRID_IDLE
 825+ FD16 DD 77 00         LD (IX+ENT_SPRITEID), A
 826+ FD19 DD 77 08         LD (IX+ENT_ANIMBASE), A
 827+ FD1C AF               XOR A
 828+ FD1D DD 77 09         LD (IX+ENT_ANIMTIMER), A
 829+ FD20 CD 9E 65         CALL TownGateRedrawPlayer
 830+ FD23 CD 31 FE         CALL SFX_Bank_OnPlayerTurn
 831+ FD26 3E 1E            LD A, BCS_T_PLAYER_TURN_FINAL
 832+ FD28 32 CA 82         LD (BankCutsceneTimer), A
 833+ FD2B 3E 0F            LD A, BCP_PLAYER_TURN_CAM
 834+ FD2D 32 C9 82         LD (BankCutscenePhase), A
 835+ FD30 C9               RET
 836+ FD31
 837+ FD31              ; ---- Phase 15: player mirando camara antes de devolver control ----
 838+ FD31              .bcPhPlayerTurnCam:
 839+ FD31 CD F7 FD         CALL BankCutsceneDecTimer
 840+ FD34 C0               RET NZ
 841+ FD35                  ; Setear DONE → siguiente UpdateBankCutscene cae al fallthrough y pone IDLE.
 842+ FD35 3E 10            LD A, BCP_DONE
 843+ FD37 32 C9 82         LD (BankCutscenePhase), A
 844+ FD3A C9               RET
 845+ FD3B
 846+ FD3B              ; ==============================================================================
 847+ FD3B              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 848+ FD3B              ; ==============================================================================
 849+ FD3B              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 850+ FD3B              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 851+ FD3B              ;
 852+ FD3B              ; Estado:
 853+ FD3B              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 854+ FD3B              ;   BankCutsceneTimer:    decrementa por frame
 855+ FD3B              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 856+ FD3B              ;
 857+ FD3B              ; Logica:
 858+ FD3B              ;   - Tick timer. Si != 0, return 0.
 859+ FD3B              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 860+ FD3B              ;   - Si SubState=GAP y timer=0:
 861+ FD3B              ;       - increment KnockIdx
 862+ FD3B              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 863+ FD3B              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 864+ FD3B              ;
 865+ FD3B              ; Destruye: A, BC, DE, HL.
 866+ FD3B              ; ==============================================================================
 867+ FD3B              BankCutsceneTickKnockGroup:
 868+ FD3B 47               LD B, A                             ; B = total knocks
 869+ FD3C 3A CA 82         LD A, (BankCutsceneTimer)
 870+ FD3F 3D               DEC A
 871+ FD40 32 CA 82         LD (BankCutsceneTimer), A
 872+ FD43 B7               OR A
 873+ FD44 28 02            JR Z, .bctkgTimer0
 874+ FD46 AF               XOR A                               ; sigue, no terminado
 875+ FD47 C9               RET
 876+ FD48              .bctkgTimer0:
 877+ FD48 3A CB 82         LD A, (BankCutsceneSubState)
 878+ FD4B B7               OR A
 879+ FD4C 20 0C            JR NZ, .bctkgGap0
 880+ FD4E                  ; HIT acabo: switch a GAP.
 881+ FD4E 3E 01            LD A, BCS_KNOCK_GAP
 882+ FD50 32 CB 82         LD (BankCutsceneSubState), A
 883+ FD53 3E 05            LD A, BCS_T_KNOCK_GAP
 884+ FD55 32 CA 82         LD (BankCutsceneTimer), A
 885+ FD58 AF               XOR A
 886+ FD59 C9               RET
 887+ FD5A              .bctkgGap0:
 888+ FD5A                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 889+ FD5A 3A CC 82         LD A, (BankCutsceneKnockIdx)
 890+ FD5D 3C               INC A
 891+ FD5E 32 CC 82         LD (BankCutsceneKnockIdx), A
 892+ FD61 B8               CP B
 893+ FD62 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 894+ FD64                  ; grupo terminado.
 895+ FD64 3E 01            LD A, 1
 896+ FD66 C9               RET
 897+ FD67              .bctkgNextHit:
 898+ FD67 3E 00            LD A, BCS_KNOCK_HIT
 899+ FD69 32 CB 82         LD (BankCutsceneSubState), A
 900+ FD6C 3E 04            LD A, BCS_T_KNOCK_HIT
