 608+ F340                  ; --- Sprite ptr de CompassSprites[idx] ---
 609+ F340 3A 70 F3         LD A, (.dcSpriteIdx)
 610+ F343 87               ADD A, A                            ; *2
 611+ F344 6F               LD L, A
 612+ F345 26 00            LD H, 0
 613+ F347 11 93 F7         LD DE, CompassSprites
 614+ F34A 19               ADD HL, DE
 615+ F34B 5E               LD E, (HL)
 616+ F34C 23               INC HL
 617+ F34D 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 618+ F34E CD 73 F3         CALL DrawCompassSprite
 619+ F351
 620+ F351                  ; --- Attrs ---
 621+ F351 3A 72 F3         LD A, (.dcAttr)
 622+ F354 CD 96 F3         CALL SetCompassAttrs
 623+ F357
 624+ F357                  ; --- Cachear estado ---
 625+ F357                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 626+ F357                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 627+ F357                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 628+ F357                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 629+ F357                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 630+ F357                  ; el wobble y la comparacion sigue siendo correcta.
 631+ F357 3A 6C 82         LD A, (CompassWobbleCounter)
 632+ F35A B7               OR A
 633+ F35B 20 06            JR NZ, .dcSkipPrevDistSave
 634+ F35D 3A 71 F3         LD A, (.dcDistance)
 635+ F360 32 69 82         LD (PreviousObjectiveDistance), A
