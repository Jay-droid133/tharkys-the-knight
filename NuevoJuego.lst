 138  6763
 139  6763                  ; --- Rutinas de paginacion (paging.asm) ---
 140  6763                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 141  6763                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 142  6763                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 143  6763                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 144  6763                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 145  6763                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 146  6763                  ; criterio (siempre visible) pero contended.
 147  6763                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 148  6763                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 149  6763                  ; el inner loop, asi que el overhead es invisible.
 150  6763                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 6763              ; ==============================================================================
   2+ 6763              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6763              ; ==============================================================================
   4+ 6763              ; Port $7FFD (write-only):
   5+ 6763              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6763              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6763              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6763              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6763              ;
  10+ 6763              ; Bancos disponibles:
  11+ 6763              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6763              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6763              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6763              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6763              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6763              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6763              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6763              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6763              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6763              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6763              ; ==============================================================================
  22+ 6763
  23+ 6763              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6763              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6763
  26+ 6763              ; ==============================================================================
  27+ 6763              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6763              ; ==============================================================================
  29+ 6763              ; Entrada: A = banco (0-7)
  30+ 6763              ; Preserva: HL, DE, IX, IY
  31+ 6763              ; Destruye: A, BC
  32+ 6763              ; ==============================================================================
  33+ 6763              PageBankSlot3:
  34+ 6763 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6765 47               LD B, A                     ; guardar banco nuevo
  36+ 6766 3A 8A 8D         LD A, (CurrentPaging)
  37+ 6769 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 676B B0               OR B                        ; poner nuevo banco
  39+ 676C 32 8A 8D         LD (CurrentPaging), A
  40+ 676F 01 FD 7F         LD BC, $7FFD
  41+ 6772 ED 79            OUT (C), A
  42+ 6774 C9               RET
  43+ 6775
  44+ 6775              ; ==============================================================================
  45+ 6775              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6775              ; ==============================================================================
  47+ 6775              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6775              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6775              ; ==============================================================================
  50+ 6775              InitPaging:
  51+ 6775 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6777 32 8A 8D         LD (CurrentPaging), A
  53+ 677A 01 FD 7F         LD BC, $7FFD
  54+ 677D ED 79            OUT (C), A
  55+ 677F C9               RET
  56+ 6780
  57+ 6780              ; ==============================================================================
  58+ 6780              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6780              ; ==============================================================================
  60+ 6780              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6780              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6780              ;      Paginacion restaurada a bank 0.
  63+ 6780              ; Destruye: A, BC, DE, HL
  64+ 6780              ;
  65+ 6780              ; Formato del room en FUENTE (variable-length):
  66+ 6780              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6780              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6780              ;   terminador:                  DEFB $FF
  69+ 6780              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6780              ;
  71+ 6780              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6780              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6780              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6780              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6780              ; ==============================================================================
  76+ 6780              LoadRoomToBuffer:
  77+ 6780                  ; El stack normal vive en slot 3 ($FF58). Mientras paginamos slot 3 al
  78+ 6780                  ; bank de datos, el stack normal queda fisicamente "oculto" (pero intacto
  79+ 6780                  ; en bank 0). Si una IRQ entra durante el LDIR, su PUSH PC iria al bank
  80+ 6780                  ; de datos -> corrupcion del room data que estamos leyendo.
  81+ 6780                  ;
  82+ 6780                  ; Solucion: cambiar SP a un buffer alterno en slot 1 (siempre visible)
  83+ 6780                  ; durante la copia. Asi las IRQs siguen procesandose normalmente y el
  84+ 6780                  ; tick de musica no pierde frames durante DrawScreen / transiciones.
  85+ 6780                  ;
  86+ 6780                  ; INLINEAMOS el page-switch (sin CALL intermedios) porque al inicio el
  87+ 6780                  ; SP aun apunta al stack normal con la PC del CALL pushed; un CALL aqui
  88+ 6780                  ; usaria stack normal y no podriamos garantizar atomicidad.
  89+ 6780 ED 73 CE 67      LD (.lrbSavedSP), SP            ; salva SP normal (con PC + caller frame)
  90+ 6784 31 DC 68         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
  91+ 6787                  ; --- Page bank 1 en slot 3 (inline, SIN DI) ---
  92+ 6787 3A 8A 8D         LD A, (CurrentPaging)
  93+ 678A E6 F8            AND $F8
  94+ 678C F6 01            OR 1
  95+ 678E 32 8A 8D         LD (CurrentPaging), A
  96+ 6791 01 FD 7F         LD BC, $7FFD
