 374+ E714              ; ==============================================================================
 375+ E714              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 376+ E714              ; ==============================================================================
 377+ E714              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 378+ E714              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 379+ E714              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 380+ E714              ; ==============================================================================
 381+ E714              DrawHealthStaminaHUD:
 382+ E714                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 383+ E714 3A 10 B6         LD A, (PlayerHealth)
 384+ E717 4F               LD C, A                             ; C = nivel (0-16)
 385+ E718 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 386+ E71B 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 387+ E71E DD 21 FB E2      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 388+ E722 FD 21 6C E3      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 389+ E726 CD 9D E7         CALL .drawBar
 390+ E729
 391+ E729                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 392+ E729 3A 11 B6         LD A, (PlayerStamina)
 393+ E72C 4F               LD C, A
 394+ E72D 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 395+ E730 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 396+ E733 DD 21 FF E2      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 397+ E737 FD 21 70 E3      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 398+ E73B CD 9D E7         CALL .drawBar
 399+ E73E
 400+ E73E                  ; --- Flash de recuperacion del pozo ---
 401+ E73E 3A 2F 90         LD A, (WellFlashTimer)
 402+ E741 B7               OR A
 403+ E742 28 28            JR Z, .noFlash
 404+ E744 3D               DEC A
 405+ E745 32 2F 90         LD (WellFlashTimer), A
 406+ E748                  ; Flash: alternar blanco/normal cada 4 frames
 407+ E748 E6 04            AND $04
 408+ E74A 28 20            JR Z, .noFlash
 409+ E74C                  ; Flash blanco brillante en ambas barras + player verde
 410+ E74C 3E 47            LD A, WHITE | $40
 411+ E74E 32 0D 58         LD ($580D), A
 412+ E751 32 0E 58         LD ($580E), A
 413+ E754 32 2D 58         LD ($582D), A
 414+ E757 32 2E 58         LD ($582E), A
 415+ E75A 32 11 58         LD ($5811), A
 416+ E75D 32 12 58         LD ($5812), A
 417+ E760 32 31 58         LD ($5831), A
 418+ E763 32 32 58         LD ($5832), A
 419+ E766 3E 44            LD A, GREEN | $40
 420+ E768 32 E1 80         LD (EntityTable + ENT_ATTR), A
 421+ E76B C9               RET
 422+ E76C              .noFlash:
 423+ E76C                  ; Restaurar color player si estaba en flash verde
 424+ E76C 3A E1 80         LD A, (EntityTable + ENT_ATTR)
 425+ E76F FE 44            CP GREEN | $40
 426+ E771 20 05            JR NZ, .noFlashPlayer
 427+ E773 3E 47            LD A, WHITE | $40
 428+ E775 32 E1 80         LD (EntityTable + ENT_ATTR), A
 429+ E778              .noFlashPlayer:
 430+ E778                  ; --- Attrs segun nivel (normal) ---
 431+ E778                  ; Salud
 432+ E778 3A 10 B6         LD A, (PlayerHealth)
 433+ E77B CD EB E7         CALL .levelToColor
 434+ E77E 32 0D 58         LD ($580D), A
 435+ E781 32 0E 58         LD ($580E), A
 436+ E784 32 2D 58         LD ($582D), A
 437+ E787 32 2E 58         LD ($582E), A
 438+ E78A                  ; Stamina
 439+ E78A 3A 11 B6         LD A, (PlayerStamina)
 440+ E78D CD EB E7         CALL .levelToColor
 441+ E790 32 11 58         LD ($5811), A
 442+ E793 32 12 58         LD ($5812), A
 443+ E796 32 31 58         LD ($5831), A
 444+ E799 32 32 58         LD ($5832), A
 445+ E79C C9               RET
 446+ E79D
 447+ E79D              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 448+ E79D              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 449+ E79D              ; IX = puntero al primer byte de la decoracion en sprite data
 450+ E79D              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 451+ E79D              ; las (16-C) superiores con $00 (vacio/negro)
 452+ E79D              .drawBar:
 453+ E79D 7D               LD A, L
 454+ E79E 32 E9 E7         LD (.dbCol), A                      ; Guardar columna base row 0
 455+ E7A1 7B               LD A, E
 456+ E7A2 32 EA E7         LD (.dbCol1), A                     ; Guardar columna base row 1
 457+ E7A5 06 10            LD B, 16                            ; 16 scanlines totales
 458+ E7A7 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 459+ E7A9                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 460+ E7A9 3E 10            LD A, 16
 461+ E7AB 91               SUB C
 462+ E7AC 5F               LD E, A                             ; E = primera scanline llena
 463+ E7AD              .dbLoop:
 464+ E7AD                  ; Calcular direccion VRAM
 465+ E7AD 7A               LD A, D
 466+ E7AE FE 08            CP 8
 467+ E7B0 30 09            JR NC, .dbCalcR1
 468+ E7B2                  ; Char row 0
 469+ E7B2 67               LD H, A
 470+ E7B3 CB F4            SET 6, H
 471+ E7B5 3A E9 E7         LD A, (.dbCol)
 472+ E7B8 6F               LD L, A
 473+ E7B9 18 09            JR .dbWrite
 474+ E7BB              .dbCalcR1:
 475+ E7BB                  ; Char row 1
 476+ E7BB D6 08            SUB 8
 477+ E7BD 67               LD H, A
 478+ E7BE CB F4            SET 6, H
 479+ E7C0 3A EA E7         LD A, (.dbCol1)
 480+ E7C3 6F               LD L, A
 481+ E7C4              .dbWrite:
 482+ E7C4                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 483+ E7C4 7A               LD A, D
 484+ E7C5 BB               CP E
 485+ E7C6 30 0B            JR NC, .dbFull
 486+ E7C8                  ; Marchito: copiar sprite decayed
 487+ E7C8 FD 7E 00         LD A, (IY+0)
 488+ E7CB 77               LD (HL), A
 489+ E7CC 23               INC HL
 490+ E7CD FD 7E 01         LD A, (IY+1)
 491+ E7D0 77               LD (HL), A
 492+ E7D1 18 09            JR .dbAdvanceSpr
 493+ E7D3              .dbFull:
 494+ E7D3                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 495+ E7D3 DD 7E 00         LD A, (IX+0)
 496+ E7D6 77               LD (HL), A
 497+ E7D7 23               INC HL
 498+ E7D8 DD 7E 01         LD A, (IX+1)
 499+ E7DB 77               LD (HL), A
 500+ E7DC              .dbAdvanceSpr:
 501+ E7DC                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 502+ E7DC D5               PUSH DE
 503+ E7DD 11 06 00         LD DE, 6
 504+ E7E0 DD 19            ADD IX, DE
 505+ E7E2 FD 19            ADD IY, DE
 506+ E7E4 D1               POP DE
 507+ E7E5 14               INC D
 508+ E7E6 10 C5            DJNZ .dbLoop
 509+ E7E8 C9               RET
 510+ E7E9
 511+ E7E9 00           .dbCol:  DEFB 0
 512+ E7EA 00           .dbCol1: DEFB 0
 513+ E7EB
