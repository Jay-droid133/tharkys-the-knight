 569  D9BC                  ; --- Game Over tumba 2x — body (~538 B) ---
 570  D9BC                  ; Cold path one-shot. Llamado via thunk en slot 1 (game_over_tomb_thunk.asm).
 571  D9BC                  ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
 572  D9BC                  ; al final → bank 7 desapareceria con el body ejecutandose). El thunk hace
 573  D9BC                  ; la carga del sprite ANTES de paginar bank 7 y llamar al body.
 574  D9BC                  INCLUDE "game_over_tomb.asm"
# file opened: game_over_tomb.asm
   1+ D9BC              ; ==============================================================================
   2+ D9BC              ; GAME OVER — TUMBA DEL JUGADOR A 2x (BODY, vive en BANK 7)
   3+ D9BC              ; ==============================================================================
   4+ D9BC              ; Cuerpo de la rutina. Vive en bank 7 (slot 3 cuando paged) por estar
   5+ D9BC              ; "holgado": tras bg_gfx_c (~$D226) y antes del storage de tombstones ($E000+),
   6+ D9BC              ; quedan ~3.5 KB libres. Bank 0 estaba al 96 % y este código es one-shot.
   7+ D9BC              ;
   8+ D9BC              ; Llamado por DrawTombstone2xCentered (thunk en slot 1) DESPUÉS de que el
   9+ D9BC              ; thunk haya cargado el sprite en BgSpriteBuffer y paginado bank 7 en slot 3.
  10+ D9BC              ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
  11+ D9BC              ; en slot 3 al final → bank 7 desaparece → crash).
  12+ D9BC              ;
  13+ D9BC              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
  14+ D9BC              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
  15+ D9BC              ; Game Over. La muerte hace moonwalk justo encima del techo.
  16+ D9BC              ;
  17+ D9BC              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  18+ D9BC              ;
  19+ D9BC              ; Algoritmo (precondición: BgSpriteBuffer ya tiene el sprite cargado):
  20+ D9BC              ;   1. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  21+ D9BC              ;      planos en TombDecodedPixels (en bank 7 RAM). Salva src ptr post-pixels.
  22+ D9BC              ;   2. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  23+ D9BC              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  24+ D9BC              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  25+ D9BC              ;   3. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  26+ D9BC              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  27+ D9BC              ;
  28+ D9BC              ; Coste: ~30K T-states one-shot. Invisible.
  29+ D9BC              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch + 2 B var = ~538 B en bank 7.
  30+ D9BC              ;
  31+ D9BC              ; Capas:
  32+ D9BC              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  33+ D9BC              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba.
  34+ D9BC              ; ==============================================================================
  35+ D9BC
  36+ D9BC              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  37+ D9BC              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  38+ D9BC              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  39+ D9BC              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  40+ D9BC              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  41+ D9BC              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  42+ D9BC              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  43+ D9BC              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  44+ D9BC              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  45+ D9BC
  46+ D9BC              ; ==============================================================================
  47+ D9BC              ; DrawTombstone2xBody - entry point del body en bank 7
  48+ D9BC              ; ==============================================================================
  49+ D9BC              ; Precondición: bank 7 paginado en slot 3 + BgSpriteBuffer ya cargado con
  50+ D9BC              ; el sprite (lo hace el thunk antes de llamar a esta rutina).
  51+ D9BC              ;
  52+ D9BC              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  53+ D9BC              ; directamente a VRAM sin XOR.
  54+ D9BC              ;
  55+ D9BC              ; Destruye: AF, BC, DE, HL, IX.
  56+ D9BC              ; ==============================================================================
  57+ D9BC              DrawTombstone2xBody:
  58+ D9BC                  ; --- 1. Decodificar pixeles RLE+CPL → flat buffer ---
  59+ D9BC CD C5 D9         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  60+ D9BF
  61+ D9BF                  ; --- 2. Dibujar pixeles 2x desde flat buffer ---
  62+ D9BF CD 22 DA         CALL DrawTombPixels2x
  63+ D9C2
  64+ D9C2                  ; --- 3. Dibujar attrs 2x desde BgSpriteBuffer ---
  65+ D9C2 C3 AB DA         JP DrawTombAttrs2x              ; tail-call
  66+ D9C5
  67+ D9C5              ; ==============================================================================
  68+ D9C5              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  69+ D9C5              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  70+ D9C5              ; ==============================================================================
  71+ D9C5              ; Formato RLE (mismo que DrawBgGfxSprite):
  72+ D9C5              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  73+ D9C5              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  74+ D9C5              ;
  75+ D9C5              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  76+ D9C5              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  77+ D9C5              ;
  78+ D9C5              ; Destruye: AF, BC, DE, HL.
  79+ D9C5              ; ==============================================================================
  80+ D9C5              DecodeTombRLEPixels:
  81+ D9C5 21 F7 86         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  82+ D9C8 11 F2 DA         LD DE, TombDecodedPixels
  83+ D9CB 01 F0 00         LD BC, TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes a emitir
  84+ D9CE AF               XOR A
  85+ D9CF 32 20 DA         LD (.drlPending), A
  86+ D9D2              .drlLoop:
  87+ D9D2 78               LD A, B
  88+ D9D3 B1               OR C
  89+ D9D4 28 43            JR Z, .drlDone                  ; remaining == 0 → done
  90+ D9D6 3A 20 DA         LD A, (.drlPending)
  91+ D9D9 B7               OR A
  92+ D9DA 28 22            JR Z, .drlNewToken
  93+ D9DC FA EF D9         JP M, .drlLitEmit
  94+ D9DF                  ; pending > 0 → run en curso
  95+ D9DF              .drlRunEmit:
  96+ D9DF 3A 21 DA         LD A, (.drlValue)
  97+ D9E2 2F               CPL
  98+ D9E3 12               LD (DE), A
  99+ D9E4 13               INC DE
 100+ D9E5 0B               DEC BC
 101+ D9E6 3A 20 DA         LD A, (.drlPending)
 102+ D9E9 3D               DEC A
 103+ D9EA 32 20 DA         LD (.drlPending), A
 104+ D9ED 18 E3            JR .drlLoop
 105+ D9EF
 106+ D9EF              .drlLitEmit:
 107+ D9EF 7E               LD A, (HL)
 108+ D9F0 23               INC HL
 109+ D9F1 2F               CPL
 110+ D9F2 12               LD (DE), A
 111+ D9F3 13               INC DE
 112+ D9F4 0B               DEC BC
 113+ D9F5 3A 20 DA         LD A, (.drlPending)
 114+ D9F8 3C               INC A                           ; hacia 0
 115+ D9F9 32 20 DA         LD (.drlPending), A
 116+ D9FC 18 D4            JR .drlLoop
 117+ D9FE
 118+ D9FE              .drlNewToken:
 119+ D9FE 7E               LD A, (HL)
 120+ D9FF 23               INC HL
 121+ DA00 CB 7F            BIT 7, A
 122+ DA02 20 07            JR NZ, .drlNewRun
 123+ DA04                  ; Literal group: pending = -count
 124+ DA04 ED 44            NEG
 125+ DA06 32 20 DA         LD (.drlPending), A
 126+ DA09 18 C7            JR .drlLoop
 127+ DA0B
 128+ DA0B              .drlNewRun:
 129+ DA0B E6 7F            AND $7F
 130+ DA0D C6 02            ADD A, 2
 131+ DA0F 32 20 DA         LD (.drlPending), A
 132+ DA12 7E               LD A, (HL)
 133+ DA13 23               INC HL
 134+ DA14 32 21 DA         LD (.drlValue), A
 135+ DA17 18 B9            JR .drlLoop
 136+ DA19
 137+ DA19              .drlDone:
 138+ DA19                  ; HL apunta al byte tras los pixeles RLE = tint byte.
 139+ DA19                  ; attrs comienzan en HL + 3 (skip tint + AH + AW).
 140+ DA19 23               INC HL
 141+ DA1A 23               INC HL
 142+ DA1B 23               INC HL
 143+ DA1C 22 E2 DB         LD (TombAttrSrcPtr), HL
 144+ DA1F C9               RET
 145+ DA20
 146+ DA20 00           .drlPending:    DEFB 0
 147+ DA21 00           .drlValue:      DEFB 0
 148+ DA22
 149+ DA22              ; ==============================================================================
 150+ DA22              ; DrawTombPixels2x - 240 src bytes (6×40) → 960 dst bytes (12×80) en VRAM
 151+ DA22              ; ==============================================================================
 152+ DA22              ; Por cada src row: calcula dst_top y dst_bot via CalcPixelAddr. Por cada src
 153+ DA22              ; byte: doble via NibbleDoubleLUT, escribe 2 bytes a top y 2 a bot (con misma
 154+ DA22              ; pareja de bytes — vertical doubling).
 155+ DA22              ;
 156+ DA22              ; Estado en .dpx* scratch (ahorra 6+ pushes en el loop interno).
 157+ DA22              ; Destruye: AF, BC, DE, HL.
 158+ DA22              ; ==============================================================================
 159+ DA22              DrawTombPixels2x:
 160+ DA22 3E 28            LD A, TOMB_SRC_H_PX             ; 40 src rows
 161+ DA24 32 A3 DA         LD (.dpxRowsLeft), A
 162+ DA27 3E 50            LD A, TOMB_2X_DST_PIXEL_Y
 163+ DA29 32 A4 DA         LD (.dpxDstY), A
 164+ DA2C 21 F2 DA         LD HL, TombDecodedPixels
 165+ DA2F 22 A5 DA         LD (.dpxSrcPtr), HL
 166+ DA32
 167+ DA32              .dpxNextRow:
 168+ DA32                  ; Calc dst top addr at (TOMB_2X_DST_PIXEL_X, dstY)
 169+ DA32 3A A4 DA         LD A, (.dpxDstY)
 170+ DA35 57               LD D, A
 171+ DA36 1E 50            LD E, TOMB_2X_DST_PIXEL_X
 172+ DA38 CD 5A 9D         CALL CalcPixelAddr
 173+ DA3B 22 A7 DA         LD (.dpxDstTop), HL
 174+ DA3E
 175+ DA3E                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 176+ DA3E CD C6 9A         CALL NextPixelLine
 177+ DA41 22 A9 DA         LD (.dpxDstBot), HL
 178+ DA44
 179+ DA44                  ; Procesar 6 src bytes para esta src row
 180+ DA44 2A A5 DA         LD HL, (.dpxSrcPtr)
 181+ DA47 06 06            LD B, TOMB_SRC_W_BYTES
 182+ DA49              .dpxByteLoop:
 183+ DA49 7E               LD A, (HL)
 184+ DA4A 23               INC HL
 185+ DA4B 4F               LD C, A                         ; C = src byte original
 186+ DA4C E5               PUSH HL                         ; save src ptr
 187+ DA4D C5               PUSH BC                         ; save count + src byte
 188+ DA4E
 189+ DA4E                  ; --- High nibble doubled ---
 190+ DA4E E6 F0            AND $F0
 191+ DA50 0F               RRCA
 191+ DA51 0F             RRCA
 191+ DA52 0F             RRCA
 191+ DA53 0F             RRCA       ; high nibble en posición baja
 192+ DA54 5F               LD E, A
 193+ DA55 16 00            LD D, 0
 194+ DA57 21 E2 DA         LD HL, NibbleDoubleLUT
 195+ DA5A 19               ADD HL, DE
 196+ DA5B 7E               LD A, (HL)                      ; A = high doubled
 197+ DA5C 2A A7 DA         LD HL, (.dpxDstTop)
 198+ DA5F 77               LD (HL), A
 199+ DA60 23               INC HL
 200+ DA61 22 A7 DA         LD (.dpxDstTop), HL
 201+ DA64 2A A9 DA         LD HL, (.dpxDstBot)
 202+ DA67 77               LD (HL), A
 203+ DA68 23               INC HL
 204+ DA69 22 A9 DA         LD (.dpxDstBot), HL
 205+ DA6C
 206+ DA6C                  ; --- Low nibble doubled ---
 207+ DA6C C1               POP BC                          ; recover src byte (en C)
 208+ DA6D C5               PUSH BC
 209+ DA6E 79               LD A, C
 210+ DA6F E6 0F            AND $0F
 211+ DA71 5F               LD E, A
 212+ DA72 16 00            LD D, 0
 213+ DA74 21 E2 DA         LD HL, NibbleDoubleLUT
 214+ DA77 19               ADD HL, DE
 215+ DA78 7E               LD A, (HL)                      ; A = low doubled
 216+ DA79 2A A7 DA         LD HL, (.dpxDstTop)
 217+ DA7C 77               LD (HL), A
 218+ DA7D 23               INC HL
 219+ DA7E 22 A7 DA         LD (.dpxDstTop), HL
 220+ DA81 2A A9 DA         LD HL, (.dpxDstBot)
 221+ DA84 77               LD (HL), A
 222+ DA85 23               INC HL
 223+ DA86 22 A9 DA         LD (.dpxDstBot), HL
 224+ DA89
 225+ DA89 C1               POP BC                          ; restaura B (counter) + C (irrelevante)
 226+ DA8A E1               POP HL                          ; src ptr
 227+ DA8B 10 BC            DJNZ .dpxByteLoop
 228+ DA8D
 229+ DA8D                  ; Avanzar a siguiente src row
 230+ DA8D 22 A5 DA         LD (.dpxSrcPtr), HL             ; HL ya apunta al siguiente row src
 231+ DA90 3A A4 DA         LD A, (.dpxDstY)
 232+ DA93 C6 02            ADD A, 2                        ; 2 dst rows por 1 src row
 233+ DA95 32 A4 DA         LD (.dpxDstY), A
 234+ DA98 3A A3 DA         LD A, (.dpxRowsLeft)
 235+ DA9B 3D               DEC A
 236+ DA9C 32 A3 DA         LD (.dpxRowsLeft), A
 237+ DA9F C2 32 DA         JP NZ, .dpxNextRow
 238+ DAA2 C9               RET
 239+ DAA3
 240+ DAA3 00           .dpxRowsLeft:   DEFB 0
 241+ DAA4 00           .dpxDstY:       DEFB 0
 242+ DAA5 00 00        .dpxSrcPtr:     DEFW 0
 243+ DAA7 00 00        .dpxDstTop:     DEFW 0
 244+ DAA9 00 00        .dpxDstBot:     DEFW 0
 245+ DAAB
 246+ DAAB              ; ==============================================================================
 247+ DAAB              ; DrawTombAttrs2x - 30 src attrs (6×5) → 120 dst attrs (12×10) en attr VRAM
 248+ DAAB              ; ==============================================================================
 249+ DAAB              ; Cada src attr se replica en bloque 2×2 chars en dst.
 250+ DAAB              ; Src ptr en TombAttrSrcPtr (set por DecodeTombRLEPixels).
 251+ DAAB              ; Dst start: $5800 + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X.
 252+ DAAB              ;
 253+ DAAB              ; Destruye: AF, BC, DE, HL.
 254+ DAAB              ; ==============================================================================
 255+ DAAB              DrawTombAttrs2x:
 256+ DAAB 2A E2 DB         LD HL, (TombAttrSrcPtr)         ; HL = src attrs (en BgSpriteBuffer)
 257+ DAAE 11 4A 59         LD DE, ATTR_BASE + TOMB_2X_DST_CHAR_Y * 32 + TOMB_2X_DST_CHAR_X
 258+ DAB1 3E 05            LD A, TOMB_SRC_ATTR_H           ; 5 src rows
 259+ DAB3              .daxRow:
 260+ DAB3 32 E1 DA         LD (.daxRowsLeft), A
 261+ DAB6 D5               PUSH DE                         ; guardar dst row top start
 262+ DAB7 06 06            LD B, TOMB_SRC_ATTR_W           ; 6 src attrs por row
 263+ DAB9              .daxCol:
 264+ DAB9 7E               LD A, (HL)
 265+ DABA 23               INC HL
 266+ DABB 12               LD (DE), A                      ; dst top col 2N
 267+ DABC 13               INC DE
 268+ DABD 12               LD (DE), A                      ; dst top col 2N+1
 269+ DABE 13               INC DE
 270+ DABF 10 F8            DJNZ .daxCol
 271+ DAC1                  ; Replicar la dst row top a dst row top+1 (= +32 bytes)
 272+ DAC1 D1               POP DE                          ; DE = dst row top start
 273+ DAC2 E5               PUSH HL                         ; save src ptr
 274+ DAC3 62               LD H, D
 275+ DAC4 6B               LD L, E                         ; HL = dst row top start
 276+ DAC5 7B               LD A, E
 277+ DAC6 C6 20            ADD A, 32
 278+ DAC8 5F               LD E, A
 279+ DAC9 30 01            JR NC, .daxNoCarry1
 280+ DACB 14               INC D
 281+ DACC              .daxNoCarry1:
 282+ DACC                  ; HL = top row start, DE = bot row start. LDIR 12 bytes.
 283+ DACC 01 0C 00         LD BC, TOMB_SRC_ATTR_W * 2      ; 12
 284+ DACF ED B0            LDIR                            ; copy 12 attrs from top row to bot row
 285+ DAD1                  ; DE ahora apunta al char tras la última col de bot row.
 286+ DAD1                  ; Necesitamos resetear DE al inicio de la siguiente "row top" = +32 desde
 287+ DAD1                  ; donde estamos. Calculemos: bot row inició en (top + 32). Tras LDIR de 12
 288+ DAD1                  ; bytes, DE = top + 32 + 12. Próxima top row = top + 64.
 289+ DAD1                  ; → DE += 32 - 12 = +20.
 290+ DAD1 7B               LD A, E
 291+ DAD2 C6 14            ADD A, 32 - TOMB_SRC_ATTR_W * 2
 292+ DAD4 5F               LD E, A
 293+ DAD5 30 01            JR NC, .daxNoCarry2
 294+ DAD7 14               INC D
 295+ DAD8              .daxNoCarry2:
 296+ DAD8 E1               POP HL                          ; restore src ptr
 297+ DAD9 3A E1 DA         LD A, (.daxRowsLeft)
 298+ DADC 3D               DEC A
 299+ DADD C2 B3 DA         JP NZ, .daxRow
 300+ DAE0 C9               RET
 301+ DAE1
 302+ DAE1 00           .daxRowsLeft:   DEFB 0
 303+ DAE2
 304+ DAE2              ; ==============================================================================
 305+ DAE2              ; LUT: nibble (4 bits abcd) → byte doblado (aabbccdd)
 306+ DAE2              ; ==============================================================================
 307+ DAE2              NibbleDoubleLUT:
 308+ DAE2 00               DEFB %00000000  ; 0000 → 00000000
 309+ DAE3 03               DEFB %00000011  ; 0001 → 00000011
 310+ DAE4 0C               DEFB %00001100  ; 0010 → 00001100
 311+ DAE5 0F               DEFB %00001111  ; 0011 → 00001111
 312+ DAE6 30               DEFB %00110000  ; 0100 → 00110000
 313+ DAE7 33               DEFB %00110011  ; 0101 → 00110011
 314+ DAE8 3C               DEFB %00111100  ; 0110 → 00111100
 315+ DAE9 3F               DEFB %00111111  ; 0111 → 00111111
 316+ DAEA C0               DEFB %11000000  ; 1000 → 11000000
 317+ DAEB C3               DEFB %11000011  ; 1001 → 11000011
 318+ DAEC CC               DEFB %11001100  ; 1010 → 11001100
 319+ DAED CF               DEFB %11001111  ; 1011 → 11001111
 320+ DAEE F0               DEFB %11110000  ; 1100 → 11110000
 321+ DAEF F3               DEFB %11110011  ; 1101 → 11110011
 322+ DAF0 FC               DEFB %11111100  ; 1110 → 11111100
 323+ DAF1 FF               DEFB %11111111  ; 1111 → 11111111
 324+ DAF2
 325+ DAF2              ; ==============================================================================
 326+ DAF2              ; Buffer plano de pixeles decodificados (240 B). Cold storage en slot 1.
 327+ DAF2              ; Vivirá en .lst después del code; sjasmplus lo ubica donde el ORG actual.
 328+ DAF2              ; ==============================================================================
 329+ DAF2              TombDecodedPixels:
 330+ DAF2 00 00 00...      DEFS TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes
 331+ DBE2
 332+ DBE2              ; ==============================================================================
 333+ DBE2              ; Variable global: ptr a la sección de attrs en BgSpriteBuffer (set por
 334+ DBE2              ; DecodeTombRLEPixels). 16-bit, en slot 1 (cold).
 335+ DBE2              ; ==============================================================================
 336+ DBE2              TombAttrSrcPtr:
 337+ DBE2 00 00            DEFW 0
 338+ DBE4
