 151  7293
 152  7293                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 153  7293                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 154  7293                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 155  7293                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 156  7293                  INCLUDE "magic_compass.asm"
# file opened: code/magic_compass.asm
   1+ 7293              ; ==============================================================================
   2+ 7293              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 7293              ; ==============================================================================
   4+ 7293              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 7293              ; Mientras MagicCompassTimer>0:
   6+ 7293              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 7293              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 7293              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 7293              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 7293              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 7293              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 7293              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 7293              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 7293              ;
  15+ 7293              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 7293              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 7293              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 7293              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 7293              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 7293              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 7293              ;
  22+ 7293              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 7293              ; ==============================================================================
  24+ 7293
  25+ 7293              ; ==============================================================================
  26+ 7293              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 7293              ; ==============================================================================
  28+ 7293              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 7293              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 7293              ; Destruye: AF, HL.
  31+ 7293              ; ==============================================================================
  32+ 7293              ApplyMagicCompassBuff:
  33+ 7293 21 EE 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 7296 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 7299 3E 01            LD A, 1
  36+ 729B 32 C2 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 729E AF               XOR A
  38+ 729F 32 C3 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 72A2 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 72A4 32 C4 5F         LD (MagicCompassTickCounter), A
  41+ 72A7                  ; Arrancar jingle: idx=0, frames=1 → primera nota se dispara YA en update
  42+ 72A7 AF               XOR A
  43+ 72A8 32 C5 5F         LD (MagicCompassJingleIdx), A
  44+ 72AB 3E 01            LD A, 1
  45+ 72AD 32 C6 5F         LD (MagicCompassJingleFrames), A
  46+ 72B0 C9               RET
  47+ 72B1
  48+ 72B1              ; ==============================================================================
  49+ 72B1              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  50+ 72B1              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  51+ 72B1              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  52+ 72B1              ; ==============================================================================
  53+ 72B1              ; Entry points:
  54+ 72B1              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  55+ 72B1              ;                           muerte / hito cumplido / llegar a sala destino,
  56+ 72B1              ;                           sites que no saben si la brujula estaba activa.
  57+ 72B1              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  58+ 72B1              ;                           por el branch del timeout natural (Timer ya es 0
  59+ 72B1              ;                           tras el DEC, asi que el check daria RET Z falso
  60+ 72B1              ;                           positivo y se saltaria el cleanup).
  61+ 72B1              ; ==============================================================================
  62+ 72B1              CancelMagicCompass:
  63+ 72B1 3A C5 82         LD A, (MagicCompassPermanent)
  64+ 72B4 B7               OR A
  65+ 72B5 C0               RET NZ                               ; lasting compass: nunca cancelar
  66+ 72B6 3A BF 5F         LD A, (MagicCompassTimer)
  67+ 72B9 47               LD B, A
  68+ 72BA 3A C0 5F         LD A, (MagicCompassTimer + 1)
  69+ 72BD B0               OR B
  70+ 72BE C8               RET Z                                ; ya inactivo
  71+ 72BF                  ; fall through al cleanup compartido
  72+ 72BF              _DoCancelMagicCompass:
  73+ 72BF AF               XOR A
  74+ 72C0 32 BF 5F         LD (MagicCompassTimer), A
  75+ 72C3 32 C0 5F         LD (MagicCompassTimer + 1), A
  76+ 72C6 32 C4 5F         LD (MagicCompassTickCounter), A
  77+ 72C9 32 C3 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  78+ 72CC 32 CC 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  79+ 72CF 3E FF            LD A, $FF
  80+ 72D1 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  81+ 72D4 32 CB 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  82+ 72D7 32 C5 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  83+ 72DA 32 BA 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  84+ 72DD                                                       ; frame: DrawCompass detecta $FF y
  85+ 72DD                                                       ; entra a .dcRedraw, sustituyendo el
  86+ 72DD                                                       ; sprite_compass_magic stale por la
  87+ 72DD                                                       ; brujula clasica (8 flechas + X).
  88+ 72DD C9               RET
  89+ 72DE
  90+ 72DE              ; ==============================================================================
  91+ 72DE              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
  92+ 72DE              ; ==============================================================================
  93+ 72DE              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
  94+ 72DE              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
  95+ 72DE              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
  96+ 72DE              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
  97+ 72DE              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
  98+ 72DE              ; direccion vieja (de la sala anterior).
  99+ 72DE              ;
 100+ 72DE              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 101+ 72DE              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 102+ 72DE              ; solo en transiciones — nunca en frames de gameplay normal.
 103+ 72DE              ;
 104+ 72DE              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 105+ 72DE              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 106+ 72DE              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 107+ 72DE              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 108+ 72DE              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
