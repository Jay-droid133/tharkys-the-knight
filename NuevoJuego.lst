 563+ F341              .dcWobbleEnd:
 564+ F341
 565+ F341                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 566+ F341                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 567+ F341                  ; sin bright + char activo white bright; en warning el char activo
 568+ F341                  ; parpadea bright on/off a ~6 Hz).
 569+ F341                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 570+ F341                  ; blanca se mantiene tal cual.
 571+ F341 3A C9 5F         LD A, (MagicCompassTimer)
 572+ F344 47               LD B, A
 573+ F345 3A CA 5F         LD A, (MagicCompassTimer + 1)
 574+ F348 B0               OR B
 575+ F349 28 29            JR Z, .dcMagicOff
 576+ F34B 3A CD F3         LD A, (.dcSpriteIdx)
 577+ F34E FE 04            CP 4
 578+ F350 28 22            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 579+ F352 3A CB 5F         LD A, (MagicCompassPathDir)
 580+ F355 FE FF            CP $FF
 581+ F357 28 1B            JR Z, .dcMagicOff                   ; sin path → render normal
 582+ F359                  ; --- MAGIC HUD ---
 583+ F359                  ; Cache: el sprite Sprite_Compass_Magic es siempre el mismo; sólo se
 584+ F359                  ; redibuja cuando cambia PathDir (o no estaba dibujado todavía). El
 585+ F359                  ; resto de frames basta con repintar los 4 attrs (ultra-barato), lo que
 586+ F359                  ; libera CPU durante el wobble post-transición y evita que las agujas
 587+ F359                  ; del reloj queden parcialmente actualizadas en frames con poco margen.
 588+ F359 3A CB 5F         LD A, (MagicCompassPathDir)
 589+ F35C 47               LD B, A
 590+ F35D 3A D5 5F         LD A, (LastMagicCompassDrawn)
 591+ F360 B8               CP B
 592+ F361 28 0C            JR Z, .dcMagicAttrsOnly             ; mismo path → solo attrs
 593+ F363 11 1B 76         LD DE, Sprite_Compass_Magic
 594+ F366 CD D0 F3         CALL DrawCompassSprite
 595+ F369 3A CB 5F         LD A, (MagicCompassPathDir)
 596+ F36C 32 D5 5F         LD (LastMagicCompassDrawn), A
 597+ F36F              .dcMagicAttrsOnly:
 598+ F36F CD 2A 73         CALL PaintMagicCompassAttrs
 599+ F372 18 40            JR .dcDrawDone
