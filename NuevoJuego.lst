5751+ BE6B 79               LD A, C
5752+ BE6C 21 F9 BD         LD HL, MonsterTypeTable
5753+ BE6F 5F               LD E, A
5754+ BE70 16 00            LD D, 0
5755+ BE72 19               ADD HL, DE
5756+ BE73 7E               LD A, (HL)
5757+ BE74 DD 77 08         LD (IX+ENT_ANIMBASE), A
5758+ BE77 79               LD A, C
5759+ BE78 21 FC BD         LD HL, MonsterColorTable
5760+ BE7B 5F               LD E, A
5761+ BE7C 16 00            LD D, 0
5762+ BE7E 19               ADD HL, DE
5763+ BE7F 7E               LD A, (HL)
5764+ BE80 DD 77 05         LD (IX+ENT_ATTR), A
