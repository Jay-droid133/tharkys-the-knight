2426+ D95B EB               EX DE, HL                       ; HL = sprite ptr
2427+ D95C 3E 03            LD A, 3                         ; PickupTable ptrs viven en bank 3
2428+ D95E CD D0 67         CALL LoadBgSpriteToBuffer
2429+ D961 21 FD 86         LD HL, BgSpriteBuffer
2430+ D964 7E               LD A, (HL)                      ; height_px
2431+ D965 32 9A DA         LD (.cbtSpH), A
