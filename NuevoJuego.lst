5770+ BE85 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5771+ BE89 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5772+ BE8D                  ; Facing
5773+ BE8D 57               LD D, A
5774+ BE8E 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5775+ BE91 DD BE 03         CP (IX+ENT_POSX)
5776+ BE94 30 05            JR NC, .rmFaceR
5777+ BE96 7A               LD A, D
