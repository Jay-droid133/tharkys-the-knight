 948+ FC06 F9 FF F8 FF      DEFB $F9,$FF, $F8,$FF, $FC,$7F, $FE,$FF
 948+ FC0A FC 7F FE FF
 949+ FC0E F9 BF F8 9F      DEFB $F9,$BF, $F8,$9F, $E4,$8F, $E3,$CF
 949+ FC12 E4 8F E3 CF
 950+ FC16 F3 0F FC 1F      DEFB $F3,$0F, $FC,$1F, $F8,$1F, $FC,$3F
 950+ FC1A F8 1F FC 3F
 951+ FC1E FF FF F0 17      DEFB $FF,$FF, $F0,$17, $F0,$0F, $FF,$FF
 951+ FC22 F0 0F FF FF
 952+ FC26
 953+ FC26              BgGfx_BankHandFrame1:
 954+ FC26 10 02            DEFB 16, 2                              ; height_px, width_bytes
 955+ FC28 FF CF FF 8F      DEFB $FF,$CF, $FF,$8F, $FF,$1F, $F9,$BF
 955+ FC2C FF 1F F9 BF
 956+ FC30 F8 DF E4 9F      DEFB $F8,$DF, $E4,$9F, $E3,$8F, $F3,$CF
 956+ FC34 E3 8F F3 CF
 957+ FC38 FE 0F F0 1F      DEFB $FE,$0F, $F0,$1F, $F8,$3F, $F8,$7F
 957+ FC3C F8 3F F8 7F
 958+ FC40 FF FF E0 2F      DEFB $FF,$FF, $E0,$2F, $E0,$1F, $FF,$FF
 958+ FC44 E0 1F FF FF
