 139+ 9A73              .alignedLine:
 140+ 9A73 3A CA 9A         LD A, (.widthSave)
 141+ 9A76 47               LD B, A                     ; B = ancho en bytes
 142+ 9A77 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A78
 144+ 9A78              .alignedByte:
 145+ 9A78 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A79 AE               XOR (HL)
 147+ 9A7A 77               LD (HL), A
 148+ 9A7B 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A7C 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A7D 10 F9            DJNZ .alignedByte
 151+ 9A7F
 152+ 9A7F E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A80 0D               DEC C
 154+ 9A81 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A82 CD CE 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A85 18 EC            JR .alignedLine
 157+ 9A87
 158+ 9A87                  ; ==================================================================
 159+ 9A87                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A87                  ; ==================================================================
 161+ 9A87                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A87              .shifted:
 163+ 9A87                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A87 3D               DEC A                       ; 0-6
 165+ 9A88 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A89 E6 0E            AND $0E
 167+ 9A8B C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A8D 32 CC 9A         LD (.tablePage), A
 169+ 9A90
 170+ 9A90                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A90 DD E5            PUSH IX
 172+ 9A92 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A93 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A94
 175+ 9A94                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A94 3A C9 9A         LD A, (.posY)
 177+ 9A97 57               LD D, A
 178+ 9A98 3A C8 9A         LD A, (.posX)
 179+ 9A9B 5F               LD E, A
 180+ 9A9C CD 62 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A9F
 182+ 9A9F D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9AA0 3A CC 9A         LD A, (.tablePage)
 184+ 9AA3 47               LD B, A                     ; B = pagina high part
 185+ 9AA4                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9AA4                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9AA4 3A CB 9A         LD A, (.heightSave)
 188+ 9AA7 DD 67            LD IXH, A
