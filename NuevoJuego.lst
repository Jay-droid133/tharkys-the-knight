 469+ F9D8 CD C9 FB         CALL BankCutsceneDecTimer
 470+ F9DB C0               RET NZ
 471+ F9DC                  ; Player gira a S (cara camara).
 472+ F9DC DD 21 9B 81      LD IX, EntityTable
 473+ F9E0 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 474+ F9E2 DD 77 00         LD (IX+ENT_SPRITEID), A
 475+ F9E5 DD 77 08         LD (IX+ENT_ANIMBASE), A
 476+ F9E8 AF               XOR A
 477+ F9E9 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 478+ F9EC CD 9E 63         CALL TownGateRedrawPlayer
 479+ F9EF 3E 28            LD A, BCS_T_TURN_CAM
 480+ F9F1 32 CA 82         LD (BankCutsceneTimer), A
 481+ F9F4 3E 06            LD A, BCP_TURN_TO_CAM
 482+ F9F6 32 C9 82         LD (BankCutscenePhase), A
 483+ F9F9 C9               RET
