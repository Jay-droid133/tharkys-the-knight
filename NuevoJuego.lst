 175+ DA79                  ; Calc dst bot addr at (TOMB_2X_DST_PIXEL_X, dstY + 1) via NextPixelLine
 176+ DA79 CD C9 9A         CALL NextPixelLine
 177+ DA7C 22 E4 DA         LD (.dpxDstBot), HL
