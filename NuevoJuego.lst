 135+ 6E43              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 136+ 6E43              ; ==============================================================================
 137+ 6E43              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 138+ 6E43              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 139+ 6E43              ; carga sprite nuevo, dibuja, repaint attrs.
 140+ 6E43              ; ==============================================================================
 141+ 6E43              UpdateRoulette:
 142+ 6E43 3A BC 5F         LD A, (RouletteActive)
 143+ 6E46 B7               OR A
 144+ 6E47 C8               RET Z
 145+ 6E48 3A B4 5F         LD A, (RandomSynthMapX)
 146+ 6E4B FE FE            CP $FE
 147+ 6E4D C8               RET Z                                   ; recogido / inactivo: no ciclar
 148+ 6E4E
 149+ 6E4E                  ; Tick frame counter
 150+ 6E4E 21 BE 5F         LD HL, RouletteFrameCounter
 151+ 6E51 35               DEC (HL)
 152+ 6E52 C0               RET NZ                                  ; aun no toca avanzar
 153+ 6E53
 154+ 6E53                  ; --- Counter expirado: ciclar al siguiente tipo ---
 155+ 6E53 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 156+ 6E55 32 BE 5F         LD (RouletteFrameCounter), A
 157+ 6E58
 158+ 6E58                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 159+ 6E58 2A B6 5F         LD HL, (RandomSynthPtr)
 160+ 6E5B 3E 03            LD A, 3
 161+ 6E5D CD 8F 6A         CALL LoadBgSpriteToBuffer
 162+ 6E60 3A B8 5F         LD A, (RandomSynthCharX)
 163+ 6E63 47               LD B, A
 164+ 6E64 3A B9 5F         LD A, (RandomSynthCharY)
 165+ 6E67 4F               LD C, A
 166+ 6E68 DD 21 9B 89      LD IX, BgSpriteBuffer
 167+ 6E6C CD 69 DE         CALL DrawBgSpriteXOR
 168+ 6E6F
