 728+ E6E1              ; ==============================================================================
 729+ E6E1              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 730+ E6E1              ; ==============================================================================
 731+ E6E1              DrawTimeIndicator:
 732+ E6E1                  ; Calcular puntero al label de 2 chars
 733+ E6E1 3A 86 E3         LD A, (CurrentTimeOfDay)
 734+ E6E4 87               ADD A, A                    ; A = momento * 2
 735+ E6E5 5F               LD E, A
 736+ E6E6 16 00            LD D, 0
 737+ E6E8 21 E8 E7         LD HL, TimeLabels
 738+ E6EB 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 739+ E6EC
 740+ E6EC                  ; Primer caracter en columna 30
 741+ E6EC 7E               LD A, (HL)
 742+ E6ED E5               PUSH HL
 743+ E6EE 1E 1E            LD E, 30
 744+ E6F0 CD 04 E7         CALL DrawHudChar
 745+ E6F3 E1               POP HL
 746+ E6F4
 747+ E6F4                  ; Segundo caracter en columna 31
 748+ E6F4 23               INC HL
 749+ E6F5 7E               LD A, (HL)
 750+ E6F6 1E 1F            LD E, 31
 751+ E6F8 CD 04 E7         CALL DrawHudChar
 752+ E6FB
 753+ E6FB                  ; Atributos del indicador (bright white on black)
 754+ E6FB 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 755+ E6FE 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 756+ E700 77               LD (HL), A
 757+ E701 23               INC HL
 758+ E702 77               LD (HL), A
 759+ E703 C9               RET
 760+ E704
 761+ E704              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 762+ E704              ; A = codigo ASCII, E = columna (0-31)
 763+ E704              DrawHudChar:
 764+ E704                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 765+ E704 6F               LD L, A
 766+ E705 26 00            LD H, 0
 767+ E707 29               ADD HL, HL
 768+ E708 29               ADD HL, HL
 769+ E709 29               ADD HL, HL
 770+ E70A 01 00 3C         LD BC, $3C00
 771+ E70D 09               ADD HL, BC                  ; HL = font data
 772+ E70E
 773+ E70E                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E70E 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E710 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E712 83               ADD A, E
 777+ E713 5F               LD E, A                     ; DE = dir VRAM
 778+ E714
 779+ E714 06 08            LD B, 8
 780+ E716              .hudCharLoop:
 781+ E716 7E               LD A, (HL)
 782+ E717 12               LD (DE), A
 783+ E718 23               INC HL
 784+ E719 14               INC D                       ; Siguiente scan line
 785+ E71A 10 FA            DJNZ .hudCharLoop
 786+ E71C C9               RET
