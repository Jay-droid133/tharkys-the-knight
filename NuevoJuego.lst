6956+ C927 DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
6957+ C92B DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
6958+ C92F DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
6959+ C933 DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
6960+ C937 DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
6961+ C93B DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6962+ C93F DD 36 06 00      LD (IX+ENT_DELTAX), 0
6963+ C943 DD 36 07 00      LD (IX+ENT_DELTAY), 0
6964+ C947 DD 36 0A 00      LD (IX+ENT_DIR), 0
6965+ C94B                  ; Color: blanco brillante sobre negro (espectral)
6966+ C94B DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
