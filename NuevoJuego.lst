 475+ E5CF              ; ==============================================================================
 476+ E5CF              ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 477+ E5CF              ; ==============================================================================
 478+ E5CF              ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 479+ E5CF              ; bit_idx en 16-bit: HL.
 480+ E5CF              ;
 481+ E5CF              ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 482+ E5CF              ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 483+ E5CF              ; ==============================================================================
 484+ E5CF              .cmcpMarkVisited:
 485+ E5CF                  ; bit_idx = sid*3 + comp; HL = bit_idx
 486+ E5CF 26 00            LD H, 0
 487+ E5D1 6F               LD L, A                              ; HL = sid
 488+ E5D2 E5               PUSH HL
 489+ E5D3 29               ADD HL, HL                           ; HL = sid*2
 490+ E5D4 D1               POP DE
 491+ E5D5 19               ADD HL, DE                           ; HL = sid*3
 492+ E5D6 58               LD E, B
 493+ E5D7 16 00            LD D, 0
 494+ E5D9 19               ADD HL, DE                           ; HL = sid*3 + comp
 495+ E5DA                  ; bit pos = HL & 7; byte idx = HL >> 3
 496+ E5DA 7D               LD A, L
 497+ E5DB E6 07            AND $07
 498+ E5DD 4F               LD C, A                              ; C = bit pos
 499+ E5DE CB 3C            SRL H
 500+ E5E0 CB 1D            RR L
 501+ E5E2 CB 3C            SRL H
 502+ E5E4 CB 1D            RR L
 503+ E5E6 CB 3C            SRL H
 504+ E5E8 CB 1D            RR L                                 ; HL = HL/8 (byte idx)
 505+ E5EA 11 80 5B         LD DE, MagicCompassVisited
 506+ E5ED 19               ADD HL, DE                           ; HL = byte addr
 507+ E5EE 3E 01            LD A, 1
 508+ E5F0 0C               INC C
 509+ E5F1              .cmvShift:
 510+ E5F1 0D               DEC C
 511+ E5F2 28 03            JR Z, .cmvDone
 512+ E5F4 87               ADD A, A
 513+ E5F5 18 FA            JR .cmvShift
 514+ E5F7              .cmvDone:
 515+ E5F7 B6               OR (HL)
 516+ E5F8 77               LD (HL), A
 517+ E5F9 C9               RET
 518+ E5FA
 519+ E5FA              .cmcpCheckVisitedBC:
 520+ E5FA                  ; bit_idx = sid*3 + comp; HL = bit_idx
 521+ E5FA 26 00            LD H, 0
 522+ E5FC 68               LD L, B                              ; HL = sid
 523+ E5FD E5               PUSH HL
 524+ E5FE 29               ADD HL, HL
