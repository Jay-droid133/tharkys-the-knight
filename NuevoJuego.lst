 354+ DE97              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 355+ DE97              ; ==============================================================================
 356+ DE97              ; Entrada: A = sprite ID
 357+ DE97              ; Setea BgSpriteIsHouse (0 o 1)
 358+ DE97              ; Preserva: A, DE, IX
 359+ DE97              ;
 360+ DE97              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 361+ DE97              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 362+ DE97              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 363+ DE97              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 364+ DE97              ; ==============================================================================
 365+ DE97              CheckIfHouseSprite:
 366+ DE97 F5               PUSH AF
 367+ DE98 E5               PUSH HL
 368+ DE99 C5               PUSH BC
 369+ DE9A
 370+ DE9A 47               LD B, A                     ; B = id buscado
 371+ DE9B
 372+ DE9B AF               XOR A
 373+ DE9C 32 07 DD         LD (BgSpriteIsHouse), A     ; Default: no es house
 374+ DE9F
 375+ DE9F 21 E1 D9         LD HL, HouseIdList
 376+ DEA2              .checkLoop:
 377+ DEA2 7E               LD A, (HL)
 378+ DEA3 FE FF            CP $FF
 379+ DEA5 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 380+ DEA7 B8               CP B
 381+ DEA8 28 03            JR Z, .checkFound
 382+ DEAA 23               INC HL
 383+ DEAB 18 F5            JR .checkLoop
 384+ DEAD
 385+ DEAD              .checkFound:
 386+ DEAD 3E 01            LD A, 1
 387+ DEAF 32 07 DD         LD (BgSpriteIsHouse), A
 388+ DEB2
 389+ DEB2              .checkDone:
 390+ DEB2 C1               POP BC
 391+ DEB3 E1               POP HL
 392+ DEB4 F1               POP AF
 393+ DEB5 C9               RET
