3933+ B527              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
3934+ B527              ; ==============================================================================
3935+ B527              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
3936+ B527              ; ==============================================================================
3937+ B527              SchedulePendingErase:
3938+ B527 3A D3 81         LD A, (PendingEraseCount)
3939+ B52A FE 03            CP 3
3940+ B52C D0               RET NC                              ; Buffer lleno (no deberia pasar)
3941+ B52D                  ; Calcular posicion en buffer: count × 5
3942+ B52D 6F               LD L, A
3943+ B52E 26 00            LD H, 0
3944+ B530 29               ADD HL, HL
3945+ B531 29               ADD HL, HL
3946+ B532 29               ADD HL, HL                          ; count × 8 (simplificado)
3947+ B533                  ; Corregir: count × 5 = count × 4 + count
3948+ B533 6F               LD L, A
3949+ B534 26 00            LD H, 0
3950+ B536 54               LD D, H
3951+ B537 5D               LD E, L
3952+ B538 29               ADD HL, HL
3953+ B539 29               ADD HL, HL                          ; count × 4
3954+ B53A 19               ADD HL, DE                          ; count × 5
3955+ B53B 11 D4 81         LD DE, PendingEraseSlots
3956+ B53E 19               ADD HL, DE
3957+ B53F                  ; Guardar OLDSPRID, OLDX, OLDY + sprite addr
3958+ B53F DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
3959+ B542 77               LD (HL), A
3960+ B543 23               INC HL
3961+ B544 DD 7E 0C         LD A, (IX+ENT_OLDX)
3962+ B547 77               LD (HL), A
3963+ B548 23               INC HL
3964+ B549 DD 7E 0D         LD A, (IX+ENT_OLDY)
3965+ B54C 77               LD (HL), A
3966+ B54D 23               INC HL
3967+ B54E                  ; Resolver sprite addr y guardarla
3968+ B54E E5               PUSH HL
3969+ B54F CD 72 A4         CALL GetOldSpriteAddr               ; DE = sprite ptr (HL trashed)
3970+ B552 E1               POP HL
3971+ B553 73               LD (HL), E
3972+ B554 23               INC HL
3973+ B555 72               LD (HL), D
3974+ B556                  ; Incrementar counter
3975+ B556 3A D3 81         LD A, (PendingEraseCount)
3976+ B559 3C               INC A
3977+ B55A 32 D3 81         LD (PendingEraseCount), A
3978+ B55D C9               RET
