  43+ 918F 0F               RRCA
  44+ 9190 0F               RRCA
  45+ 9191 0F               RRCA
  46+ 9192 E6 1F            AND $1F
  47+ 9194 32 50 9C         LD (MaiFlowPlCy), A
  48+ 9197
  49+ 9197                  ; --- Swap a stack temporal (bank 2) ---
  50+ 9197 ED 73 56 9C      LD (MaiFlowSavedSP), SP
  51+ 919B 31 F6 9C         LD SP, MaiTempStackTop
  52+ 919E
  53+ 919E                  ; --- Ventana de paginacion ---
  54+ 919E                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 919E F3               DI
  56+ 919F 3A 42 90         LD A, (CurrentPaging)
  57+ 91A2 E6 F8            AND $F8
  58+ 91A4 F6 06            OR 6
  59+ 91A6 32 42 90         LD (CurrentPaging), A
  60+ 91A9 01 FD 7F         LD BC, $7FFD
  61+ 91AC ED 79            OUT (C), A
  62+ 91AE
  63+ 91AE                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 91AE CD CA 91         CALL MaiFlowBfs
  65+ 91B1
  66+ 91B1                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 91B1 3A 42 90         LD A, (CurrentPaging)
  68+ 91B4 E6 F8            AND $F8
  69+ 91B6 32 42 90         LD (CurrentPaging), A
  70+ 91B9 01 FD 7F         LD BC, $7FFD
  71+ 91BC ED 79            OUT (C), A
  72+ 91BE
  73+ 91BE ED 7B 56 9C      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 91C2 3A C6 80         LD A, (StartupComplete)
