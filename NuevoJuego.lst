4318+ BA7E              ; ==============================================================================
4319+ BA7E              ; SpawnOneNasty - Inicializa un nasty en el slot IX
4320+ BA7E              ; ==============================================================================
4321+ BA7E              SpawnOneNasty:
4322+ BA7E                  ; Elegir tipo de nasty (pseudo-random, 4 tipos por tabla)
4323+ BA7E ED 5F            LD A, R
4324+ BA80 E6 03            AND $03                     ; 0-3 (NUM_NASTY_TYPES = 4)
4325+ BA82 6F               LD L, A
4326+ BA83 26 00            LD H, 0
4327+ BA85 ED 5B 7E BD      LD DE, (CurrentNastyTable)
4328+ BA89 19               ADD HL, DE
4329+ BA8A 7E               LD A, (HL)
4330+ BA8B
4331+ BA8B                  ; Configurar entidad base
4332+ BA8B DD 77 0A         LD (IX+ENT_DIR), A              ; Guardar ANIMBASE real en DIR (temporal)
4333+ BA8E DD 36 01 03      LD (IX+ENT_TYPE), TYPE_NASTY
4334+ BA92 DD 36 02 04      LD (IX+ENT_STATE), STATE_SPAWNING
4335+ BA96 DD 36 00 46      LD (IX+ENT_SPRITEID), SPRID_SPAWN
4336+ BA9A DD 36 08 46      LD (IX+ENT_ANIMBASE), SPRID_SPAWN
4337+ BA9E DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_SPAWN
4338+ BAA2 DD 36 0B 0D      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_DESTRUCT) | (1 << ENTF_NEWSPAWN)
