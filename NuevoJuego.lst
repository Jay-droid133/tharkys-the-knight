 216+ AB2A              ; ==============================================================================
 217+ AB2A              ; DrawScreen - Dibuja la pantalla actual iterando BG sprites
 218+ AB2A              ; ==============================================================================
 219+ AB2A              ; Formato room: DEFW BgGfx_ptr : DEFB x_char, y_char ... DEFW $0000
 220+ AB2A              ; Formato BgGfx: DEFB height_px, width_bytes, pixel_data(CPL),
 221+ AB2A              ;                DEFB attr_h, attr_w, attr_data
 222+ AB2A              ; Solo se ejecuta cuando ScreenDirty=1 (cambio de pantalla).
 223+ AB2A              ; ==============================================================================
 224+ AB2A              DrawScreen:
 225+ AB2A 3A B4 81         LD A, (ScreenDirty)
 226+ AB2D B7               OR A
 227+ AB2E C8               RET Z
 228+ AB2F
 229+ AB2F                  ; --- Reset well / plaza clock detection ---
 230+ AB2F AF               XOR A
 231+ AB30 32 79 87         LD (WellActive), A
