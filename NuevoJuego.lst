 450+ E5E4 CD 74 E7         CALL DrawHudChar
 451+ E5E7
 452+ E5E7                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E5E7 3A 11 83         LD A, (CurrentScreenY)
 454+ E5EA 6F               LD L, A
 455+ E5EB 26 00            LD H, 0
 456+ E5ED 29               ADD HL, HL
 457+ E5EE 29               ADD HL, HL
 458+ E5EF 29               ADD HL, HL
 459+ E5F0 29               ADD HL, HL                  ; HL = Y * 16
 460+ E5F1 3A 10 83         LD A, (CurrentScreenX)
 461+ E5F4 5F               LD E, A
 462+ E5F5 16 00            LD D, 0
 463+ E5F7 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E5F8 11 37 DE         LD DE, MapTable
 465+ E5FB 19               ADD HL, DE
 466+ E5FC 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E5FD F5               PUSH AF                     ; guardar room index
 468+ E5FE
 469+ E5FE                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E5FE F5               PUSH AF
 471+ E5FF 0F               RRCA
 472+ E600 0F               RRCA
 473+ E601 0F               RRCA
 474+ E602 0F               RRCA
 475+ E603 E6 0F            AND $0F
 476+ E605 CD 4A E6         CALL .hexToAscii
 477+ E608 1E 06            LD E, 6
 478+ E60A CD 74 E7         CALL DrawHudChar
 479+ E60D F1               POP AF
 480+ E60E E6 0F            AND $0F
 481+ E610 CD 4A E6         CALL .hexToAscii
 482+ E613 1E 07            LD E, 7
 483+ E615 CD 74 E7         CALL DrawHudChar
