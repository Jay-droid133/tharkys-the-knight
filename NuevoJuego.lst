2290+ AB8E 21 00 00         LD HL, 0
2291+ AB91 22 E2 82         LD (MushroomLockTimer), HL
2292+ AB94 22 DE 5F         LD (ReverseTimer), HL
2293+ AB97 3A E1 82         LD A, (SpeedBuffType)
2294+ AB9A FE 02            CP SPEED_BUFF_TYPE_CARACOL
2295+ AB9C 20 14            JR NZ, .cwSkipCaracol
2296+ AB9E 21 00 00         LD HL, 0
2297+ ABA1 22 DF 82         LD (SpeedBuffTimer), HL
2298+ ABA4 AF               XOR A
2299+ ABA5 32 E1 82         LD (SpeedBuffType), A
2300+ ABA8 3E 04            LD A, SPEED_RUN
2301+ ABAA 32 DD 82         LD (PlayerSpeedRun), A
2302+ ABAD 3E 02            LD A, SPEED_FIGHT
2303+ ABAF 32 DE 82         LD (PlayerSpeedFight), A
