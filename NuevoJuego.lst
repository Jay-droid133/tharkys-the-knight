 281+ EEF9              ; ==============================================================================
 282+ EEF9              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 283+ EEF9              ; ==============================================================================
 284+ EEF9              ; IN:  A = key id (1..6)
 285+ EEF9              ; OUT: DE = ptr
