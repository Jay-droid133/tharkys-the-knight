 878+ EE09              ; ==============================================================================
 879+ EE09              ; .urpReadSlotAndDispatchCache — path del cache HIT
 880+ EE09              ; ==============================================================================
 881+ EE09              ; Entrada: A = slot cached, RP_TmpRolled = tipo cached (ya setado).
 882+ EE09              ; Lee SlotList[A*2] → CharX/Y, luego dispatcha al .urpDoXxx correspondiente.
 883+ EE09              ; ROLLED_NONE → JP .urpZeroAndRotate (no spawn pero rota cache).
 884+ EE09              ; ==============================================================================
 885+ EE09              .urpReadSlotAndDispatchCache:
 886+ EE09 87               ADD A, A
 887+ EE0A 5F               LD E, A
 888+ EE0B 16 00            LD D, 0
 889+ EE0D 21 AC 5F         LD HL, RandomSlotList
 890+ EE10 19               ADD HL, DE
 891+ EE11 7E               LD A, (HL)
 892+ EE12 32 B8 5F         LD (RandomSynthCharX), A
 893+ EE15 23               INC HL
 894+ EE16 7E               LD A, (HL)
 895+ EE17 32 B9 5F         LD (RandomSynthCharY), A
