1189+ A567                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1190+ A567                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1191+ A567                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1192+ A567                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1193+ A567                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1194+ A567                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1195+ A567                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1196+ A567                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1197+ A567                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1198+ A567                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1199+ A567                  ; tickea a tiempo y reescribe SPRITEID).
1200+ A567 3A E5 82         LD A, (PlayerRespawnTimer)
1201+ A56A B7               OR A
1202+ A56B C8               RET Z
1203+ A56C 3A 91 81         LD A, (GameFrameCounter)
1204+ A56F E6 02            AND 2
1205+ A571 28 0D            JR Z, .pblOffFrame
1206+ A573                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1207+ A573 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1208+ A576 FE 74            CP SPRID_PLAYER_BLANK
1209+ A578 C0               RET NZ                              ; sprite válido (anim viva) → keep
1210+ A579 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1211+ A57C DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1212+ A57F C9               RET
1213+ A580              .pblOffFrame:
1214+ A580 3E 74            LD A, SPRID_PLAYER_BLANK
1215+ A582 32 94 81         LD (EntityTable), A
1216+ A585 C9               RET
