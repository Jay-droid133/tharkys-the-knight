 244+ E5A2              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 245+ E5A2              DrawSwordModeHUD:
 246+ E5A2 3A D8 B6         LD A, (SwordMode)
 247+ E5A5 21 D5 E5         LD HL, .modeChars
 248+ E5A8 5F               LD E, A
 249+ E5A9 16 00            LD D, 0
 250+ E5AB 19               ADD HL, DE
 251+ E5AC 7E               LD A, (HL)                          ; A = ASCII del modo
 252+ E5AD                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 253+ E5AD 21 00 40         LD HL, $4000
 254+ E5B0                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 255+ E5B0 5F               LD E, A
 256+ E5B1 16 00            LD D, 0
 257+ E5B3 42               LD B, D                             ; B = 0
 258+ E5B4 CB 23            SLA E
 258+ E5B6 CB 12          RL D                        ; *2
 259+ E5B8 CB 23            SLA E
 259+ E5BA CB 12          RL D                        ; *4
 260+ E5BC CB 23            SLA E
 260+ E5BE CB 12          RL D                        ; *8
 261+ E5C0 E5               PUSH HL
 262+ E5C1 21 00 3C         LD HL, $3C00
 263+ E5C4 19               ADD HL, DE                          ; HL = direccion del glyph
 264+ E5C5 EB               EX DE, HL                           ; DE = glyph
 265+ E5C6 E1               POP HL                              ; HL = VRAM
 266+ E5C7 06 08            LD B, 8
 267+ E5C9              .drawChar:
 268+ E5C9 1A               LD A, (DE)
 269+ E5CA 77               LD (HL), A
 270+ E5CB 13               INC DE
 271+ E5CC 24               INC H                               ; siguiente scan line
 272+ E5CD 10 FA            DJNZ .drawChar
 273+ E5CF                  ; Attr: fila 0, col 0 = $5800
 274+ E5CF 3E 47            LD A, $47                           ; blanco bright
 275+ E5D1 32 00 58         LD ($5800), A
 276+ E5D4 C9               RET
 277+ E5D5
 278+ E5D5 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 279+ E5D8
 280+ E5D8              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 281+ E5D8              DrawNoclipHUD:
 282+ E5D8 3A 48 82         LD A, (NoclipMode)
 283+ E5DB B7               OR A
 284+ E5DC 20 0E            JR NZ, .ncOn
 285+ E5DE 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 286+ E5E0 1E 1E            LD E, 30
 287+ E5E2 CD 07 E8         CALL DrawHudChar
 288+ E5E5 3E 20            LD A, 32
 289+ E5E7 1E 1F            LD E, 31
 290+ E5E9 C3 07 E8         JP DrawHudChar
 291+ E5EC              .ncOn:
 292+ E5EC 3E 4E            LD A, 'N'
 293+ E5EE 1E 1E            LD E, 30
 294+ E5F0 CD 07 E8         CALL DrawHudChar
 295+ E5F3 3E 43            LD A, 'C'
 296+ E5F5 1E 1F            LD E, 31
 297+ E5F7 C3 07 E8         JP DrawHudChar
 298+ E5FA
 299+ E5FA              ; ==============================================================================
 300+ E5FA              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 301+ E5FA              ; ==============================================================================
 302+ E5FA              ; Entrada: A = attr original
 303+ E5FA              ; Salida:  A = attr transformado
 304+ E5FA              ; Preserva: HL, DE, BC, IX
 305+ E5FA              ; ==============================================================================
 306+ E5FA              ApplyDayCycleRemap:
 307+ E5FA E5               PUSH HL
 308+ E5FB 67               LD H, A                     ; H = attr (temp save)
 309+ E5FC 3A 93 E4         LD A, (CurrentTimeOfDay)
 310+ E5FF B7               OR A
 311+ E600 20 03            JR NZ, .doRemap
 312+ E602 7C               LD A, H                     ; Dia: devolver sin cambio
 313+ E603 E1               POP HL
 314+ E604 C9               RET
 315+ E605
 316+ E605              .doRemap:
 317+ E605 D5               PUSH DE
 318+ E606 C5               PUSH BC
 319+ E607
 320+ E607 7C               LD A, H                     ; A = attr original
 321+ E608 4F               LD C, A                     ; C = attr original
 322+ E609
 323+ E609                  ; Guardar flash + ink (bits 7, 2-0)
 324+ E609 E6 87            AND $87                     ; A = F000_0III
 325+ E60B 47               LD B, A                     ; B = flash | ink
 326+ E60C
 327+ E60C                  ; Extraer paper+bright como indice 0-15
 328+ E60C 79               LD A, C
 329+ E60D E6 78            AND $78                     ; A = 0BPPP000
 330+ E60F 0F               RRCA
 331+ E610 0F               RRCA
 332+ E611 0F               RRCA                        ; A = 0000BPPP = indice
 333+ E612
 334+ E612                  ; Elegir tabla segun tipo de sprite
 335+ E612 5F               LD E, A
 336+ E613 16 00            LD D, 0
 337+ E615 3A 98 E4         LD A, (BgSpriteIsHouse)
 338+ E618 B7               OR A
 339+ E619 28 05            JR Z, .useStdTable
 340+ E61B 2A 96 E4         LD HL, (CurrentHouseRemapTable)
 341+ E61E 18 03            JR .doLookup
 342+ E620              .useStdTable:
 343+ E620 2A 94 E4         LD HL, (CurrentRemapTable)
 344+ E623              .doLookup:
 345+ E623 19               ADD HL, DE
 346+ E624 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 347+ E625
 348+ E625                  ; Reconstruir atributo
 349+ E625 07               RLCA
 350+ E626 07               RLCA
 351+ E627 07               RLCA                        ; A = 0BPPP000
 352+ E628 B0               OR B                        ; A = FBPPPIII
 353+ E629
 354+ E629 C1               POP BC
 355+ E62A D1               POP DE
 356+ E62B E1               POP HL
 357+ E62C C9               RET
 358+ E62D
 359+ E62D              ; ==============================================================================
 360+ E62D              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 361+ E62D              ; ==============================================================================
 362+ E62D              ; Entrada: A = sprite ID
 363+ E62D              ; Setea BgSpriteIsHouse (0 o 1)
 364+ E62D              ; Preserva: A, DE, IX
 365+ E62D              ;
 366+ E62D              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 367+ E62D              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 368+ E62D              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 369+ E62D              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 370+ E62D              ; ==============================================================================
 371+ E62D              CheckIfHouseSprite:
 372+ E62D F5               PUSH AF
 373+ E62E E5               PUSH HL
 374+ E62F C5               PUSH BC
 375+ E630
 376+ E630 47               LD B, A                     ; B = id buscado
 377+ E631
 378+ E631 AF               XOR A
 379+ E632 32 98 E4         LD (BgSpriteIsHouse), A     ; Default: no es house
 380+ E635
 381+ E635 21 57 E1         LD HL, HouseIdList
 382+ E638              .checkLoop:
 383+ E638 7E               LD A, (HL)
 384+ E639 FE FF            CP $FF
 385+ E63B 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 386+ E63D B8               CP B
 387+ E63E 28 03            JR Z, .checkFound
 388+ E640 23               INC HL
 389+ E641 18 F5            JR .checkLoop
 390+ E643
 391+ E643              .checkFound:
 392+ E643 3E 01            LD A, 1
 393+ E645 32 98 E4         LD (BgSpriteIsHouse), A
 394+ E648
 395+ E648              .checkDone:
 396+ E648 C1               POP BC
 397+ E649 E1               POP HL
 398+ E64A F1               POP AF
 399+ E64B C9               RET
 400+ E64C
 401+ E64C              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 402+ E64C              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 403+ E64C              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 404+ E64C
 405+ E64C              ; ==============================================================================
 406+ E64C              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 407+ E64C              ; ==============================================================================
 408+ E64C              ; Formato: XX,YY:NN nombre_room     DY
 409+ E64C              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 410+ E64C              ; ==============================================================================
 411+ E64C              DrawRoomInfo:
 412+ E64C                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 413+ E64C 1E 00            LD E, 0
 414+ E64E 06 0D            LD B, 13
 415+ E650              .clearLoop:
 416+ E650 C5               PUSH BC
 417+ E651 D5               PUSH DE
 418+ E652 3E 20            LD A, ' '
 419+ E654 CD 07 E8         CALL DrawHudChar
 420+ E657 D1               POP DE
 421+ E658 C1               POP BC
 422+ E659 1C               INC E
 423+ E65A 10 F4            DJNZ .clearLoop
 424+ E65C
 425+ E65C                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 426+ E65C 3A 8F 82         LD A, (CurrentScreenX)
 427+ E65F 1E 00            LD E, 0
 428+ E661 CD BF E6         CALL .drawDec2
 429+ E664
 430+ E664                  ; --- ',' en col 2 ---
 431+ E664 3E 2C            LD A, ','
 432+ E666 1E 02            LD E, 2
 433+ E668 CD 07 E8         CALL DrawHudChar
 434+ E66B
 435+ E66B                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 436+ E66B 3A 90 82         LD A, (CurrentScreenY)
 437+ E66E 1E 03            LD E, 3
 438+ E670 CD BF E6         CALL .drawDec2
 439+ E673
 440+ E673                  ; --- ':' en col 5 ---
 441+ E673 3E 3A            LD A, ':'
 442+ E675 1E 05            LD E, 5
 443+ E677 CD 07 E8         CALL DrawHudChar
 444+ E67A
 445+ E67A                  ; --- Obtener room index de MapTable[Y*16+X] ---
 446+ E67A 3A 90 82         LD A, (CurrentScreenY)
 447+ E67D 6F               LD L, A
 448+ E67E 26 00            LD H, 0
 449+ E680 29               ADD HL, HL
 450+ E681 29               ADD HL, HL
 451+ E682 29               ADD HL, HL
 452+ E683 29               ADD HL, HL                  ; HL = Y * 16
 453+ E684 3A 8F 82         LD A, (CurrentScreenX)
 454+ E687 5F               LD E, A
 455+ E688 16 00            LD D, 0
 456+ E68A 19               ADD HL, DE                  ; HL = Y*16 + X
 457+ E68B 11 C2 DF         LD DE, MapTable
 458+ E68E 19               ADD HL, DE
 459+ E68F 7E               LD A, (HL)                  ; A = room index (0-47)
 460+ E690 F5               PUSH AF                     ; guardar room index
 461+ E691
 462+ E691                  ; --- Room index como 2 hex en cols 6-7 ---
 463+ E691 F5               PUSH AF
 464+ E692 0F               RRCA
 465+ E693 0F               RRCA
 466+ E694 0F               RRCA
 467+ E695 0F               RRCA
 468+ E696 E6 0F            AND $0F
 469+ E698 CD DD E6         CALL .hexToAscii
 470+ E69B 1E 06            LD E, 6
 471+ E69D CD 07 E8         CALL DrawHudChar
 472+ E6A0 F1               POP AF
 473+ E6A1 E6 0F            AND $0F
 474+ E6A3 CD DD E6         CALL .hexToAscii
 475+ E6A6 1E 07            LD E, 7
 476+ E6A8 CD 07 E8         CALL DrawHudChar
 477+ E6AB
 478+ E6AB                  ; --- Espacio en col 8 ---
 479+ E6AB 3E 20            LD A, ' '
 480+ E6AD 1E 08            LD E, 8
 481+ E6AF CD 07 E8         CALL DrawHudChar
 482+ E6B2
 483+ E6B2                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 484+ E6B2 F1               POP AF                      ; A = room index (descartar)
 485+ E6B3
 486+ E6B3                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 487+ E6B3 21 20 58         LD HL, ATTR_BASE + 1 * 32
 488+ E6B6 3E 47            LD A, $47                   ; bright white on black
 489+ E6B8 06 0D            LD B, 13
 490+ E6BA              .attrLoop:
 491+ E6BA 77               LD (HL), A
 492+ E6BB 23               INC HL
 493+ E6BC 10 FC            DJNZ .attrLoop
 494+ E6BE C9               RET
 495+ E6BF
 496+ E6BF              ; --- Helpers ---
 497+ E6BF              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 498+ E6BF              .drawDec2:
 499+ E6BF 4B               LD C, E                     ; guardar columna inicial
 500+ E6C0 06 00            LD B, 0                     ; decenas
 501+ E6C2              .divLoop:
 502+ E6C2 FE 0A            CP 10
 503+ E6C4 38 05            JR C, .divDone
 504+ E6C6 D6 0A            SUB 10
 505+ E6C8 04               INC B
 506+ E6C9 18 F7            JR .divLoop
 507+ E6CB              .divDone:
 508+ E6CB                  ; B = decenas, A = unidades
 509+ E6CB F5               PUSH AF                     ; guardar unidades
 510+ E6CC 78               LD A, B
 511+ E6CD C6 30            ADD A, '0'
 512+ E6CF 59               LD E, C
 513+ E6D0 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 514+ E6D1 CD 07 E8         CALL DrawHudChar
 515+ E6D4 C1               POP BC                      ; restaurar C
 516+ E6D5 F1               POP AF
 517+ E6D6 C6 30            ADD A, '0'
 518+ E6D8 59               LD E, C
 519+ E6D9 1C               INC E
 520+ E6DA C3 07 E8         JP DrawHudChar              ; tail call
 521+ E6DD
 522+ E6DD              .hexToAscii:
 523+ E6DD FE 0A            CP 10
 524+ E6DF 38 03            JR C, .isDigit
 525+ E6E1 C6 37            ADD A, 'A' - 10
 526+ E6E3 C9               RET
 527+ E6E4              .isDigit:
 528+ E6E4 C6 30            ADD A, '0'
 529+ E6E6 C9               RET
