 602+ EE4F              ; ==============================================================================
 603+ EE4F              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ EE4F              ; ==============================================================================
 605+ EE4F
 606+ EE4F              ; ==============================================================================
 607+ EE4F              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ EE4F              ; ==============================================================================
 609+ EE4F              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ EE4F              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ EE4F              ; ==============================================================================
 612+ EE4F              BuildPlazaScanAddrs:
 613+ EE4F                  ; Calcular pixel coords del top-left de la esfera
 614+ EE4F 3A 63 8D         LD A, (PlazaClockCharY)
 615+ EE52 07               RLCA
 616+ EE53 07               RLCA
 617+ EE54 07               RLCA
 618+ EE55 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EE56 3A 62 8D         LD A, (PlazaClockCharX)
 620+ EE59 07               RLCA
 621+ EE5A 07               RLCA
 622+ EE5B 07               RLCA
 623+ EE5C 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EE5D CD 5C 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EE60
 626+ EE60 DD 21 64 8D      LD IX, PlazaScanAddrs
 627+ EE64 06 10            LD B, 16
 628+ EE66              .buildLoop:
 629+ EE66 DD 75 00         LD (IX+0), L
 630+ EE69 DD 74 01         LD (IX+1), H
 631+ EE6C DD 23            INC IX
 632+ EE6E DD 23            INC IX
 633+ EE70 05               DEC B
 634+ EE71 C8               RET Z
 635+ EE72 CD C8 9A         CALL NextPixelLine
 636+ EE75 18 EF            JR .buildLoop
 637+ EE77
 638+ EE77              ; ==============================================================================
 639+ EE77              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EE77              ; ==============================================================================
 641+ EE77              ; Llamar cada frame desde el main loop.
 642+ EE77              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EE77              ; ==============================================================================
 644+ EE77              DrawPlazaClock:
 645+ EE77 3A 61 8D         LD A, (PlazaClockActive)
 646+ EE7A B7               OR A
 647+ EE7B C8               RET Z
 648+ EE7C
 649+ EE7C                  ; --- Calcular posicion actual de las agujas ---
 650+ EE7C 3A EE E9         LD A, (GameHours)
 651+ EE7F FE 0C            CP 12
 652+ EE81 38 02            JR C, .pCalcHourOk
 653+ EE83 D6 0C            SUB 12
 654+ EE85              .pCalcHourOk:
 655+ EE85 57               LD D, A                     ; D = display hour (0-11)
 656+ EE86 3A ED E9         LD A, (GameMinutes)
 657+ EE89 1E 00            LD E, 0
 658+ EE8B              .pCalcDiv5:
 659+ EE8B FE 05            CP 5
 660+ EE8D 38 05            JR C, .pCalcMinOk
 661+ EE8F D6 05            SUB 5
 662+ EE91 1C               INC E
 663+ EE92 18 F7            JR .pCalcDiv5
 664+ EE94              .pCalcMinOk:
 665+ EE94                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EE94
 667+ EE94                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EE94 3A E8 EE         LD A, (PlazaLastHour)
 669+ EE97 BA               CP D
 670+ EE98 20 05            JR NZ, .pNeedsRedraw
 671+ EE9A 3A E9 EE         LD A, (PlazaLastMin)
 672+ EE9D BB               CP E
 673+ EE9E C8               RET Z                       ; sin cambio → no redibujar
 674+ EE9F
 675+ EE9F              .pNeedsRedraw:
 676+ EE9F 7A               LD A, D
 677+ EEA0 32 E8 EE         LD (PlazaLastHour), A
 678+ EEA3 7B               LD A, E
 679+ EEA4 32 E9 EE         LD (PlazaLastMin), A
 680+ EEA7
 681+ EEA7                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EEA7                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EEA7 DD 21 37 8A      LD IX, PlazaClockPixels
 684+ EEAB FD 21 64 8D      LD IY, PlazaScanAddrs
 685+ EEAF 06 10            LD B, 16
 686+ EEB1              .faceRow:
 687+ EEB1 FD 6E 00         LD L, (IY+0)
 688+ EEB4 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EEB7 DD 7E 00         LD A, (IX+0)
 690+ EEBA 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EEBB 77               LD (HL), A                  ; byte izquierdo
 692+ EEBC 23               INC HL
 693+ EEBD DD 7E 01         LD A, (IX+1)
 694+ EEC0 2F               CPL
 695+ EEC1 77               LD (HL), A                  ; byte derecho
 696+ EEC2 DD 23            INC IX
 697+ EEC4 DD 23            INC IX
 698+ EEC6 FD 23            INC IY
 699+ EEC8 FD 23            INC IY
 700+ EECA 10 E5            DJNZ .faceRow
 701+ EECC
 702+ EECC                  ; --- Aguja de horas ---
 703+ EECC 3A E8 EE         LD A, (PlazaLastHour)
 704+ EECF 21 EA EA         LD HL, HourHandPtrs
 705+ EED2 CD EA EE         CALL DrawPlazaHandLine
 706+ EED5
 707+ EED5                  ; --- Aguja de minutos ---
 708+ EED5 3A E9 EE         LD A, (PlazaLastMin)
 709+ EED8 21 06 EA         LD HL, MinHandPtrs
 710+ EEDB CD EA EE         CALL DrawPlazaHandLine
 711+ EEDE
 712+ EEDE                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EEDE 21 72 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EEE1 7E               LD A, (HL)
 715+ EEE2 23               INC HL
 716+ EEE3 66               LD H, (HL)
 717+ EEE4 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EEE5 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EEE7 C9               RET
 720+ EEE8
 721+ EEE8              ; Variables locales reloj plaza
 722+ EEE8 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EEE9 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EEEA
 725+ EEEA              ; ==============================================================================
 726+ EEEA              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EEEA              ; ==============================================================================
 728+ EEEA              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EEEA              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EEEA              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EEEA              ; ==============================================================================
 732+ EEEA              DrawPlazaHandLine:
 733+ EEEA                  ; Indexar en tabla de punteros
 734+ EEEA 87               ADD A, A
 735+ EEEB 4F               LD C, A
 736+ EEEC 06 00            LD B, 0
 737+ EEEE 09               ADD HL, BC
 738+ EEEF 7E               LD A, (HL)
 739+ EEF0 23               INC HL
 740+ EEF1 66               LD H, (HL)
 741+ EEF2 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EEF3
 743+ EEF3              .pxLoop:
 744+ EEF3 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EEF4 B7               OR A
 746+ EEF5 C8               RET Z
 747+ EEF6
 748+ EEF6                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EEF6 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EEF7 23               INC HL
 751+ EEF8 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EEF9 23               INC HL
 753+ EEFA 56               LD D, (HL)                  ; D = mask
 754+ EEFB 23               INC HL
 755+ EEFC E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EEFD
 757+ EEFD                  ; --- Calcular scanLine (0-15) ---
 758+ EEFD 78               LD A, B
 759+ EEFE E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EF00 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EF02 28 02            JR Z, .pxIsTop
 762+ EF04 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EF06              .pxIsTop:
 764+ EF06                  ; A = scanLine (0-15)
 765+ EF06
 766+ EF06                  ; --- Calcular colOffset (0 o 1) ---
 767+ EF06 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EF07 79               LD A, C
 769+ EF08 E6 1F            AND $1F                     ; extraer columna
 770+ EF0A D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EF0C 4F               LD C, A                     ; C = colOffset
 772+ EF0D
 773+ EF0D                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EF0D 7B               LD A, E                     ; A = scanLine
 775+ EF0E 87               ADD A, A                    ; *2 (word index)
 776+ EF0F 21 64 8D         LD HL, PlazaScanAddrs
 777+ EF12 85               ADD A, L
 778+ EF13 6F               LD L, A
 779+ EF14 30 01            JR NC, .pxNC
 780+ EF16 24               INC H
 781+ EF17              .pxNC:
 782+ EF17 7E               LD A, (HL)
 783+ EF18 23               INC HL
 784+ EF19 66               LD H, (HL)
 785+ EF1A 81               ADD A, C                    ; sumar colOffset
 786+ EF1B 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EF1C
 788+ EF1C                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EF1C 7A               LD A, D
 790+ EF1D 2F               CPL
 791+ EF1E A6               AND (HL)
 792+ EF1F 77               LD (HL), A
 793+ EF20
 794+ EF20 E1               POP HL                      ; restaurar puntero datos
 795+ EF21 18 D0            JR .pxLoop
 796+ EF23
