1509+ 94EE              ; ==============================================================================
1510+ 94EE              ; UpdateMonsterLeave - Salida al amanecer (Regla 7 / STATE_LEAVING)
1511+ 94EE              ; ==============================================================================
1512+ 94EE              ; IX = monster entity en STATE_SCARED.
1513+ 94EE              ;
1514+ 94EE              ; Primera llamada (flag MAI_FLAG_LEAVING clear): elige un gap aleatorio del
1515+ 94EE              ; screen actual, guarda side+coord en MonsterEntryBorder/ExitCoord[slot] y
1516+ 94EE              ; marca el flag. Llamadas posteriores: camina hacia el pixel del gap con AI
1517+ 94EE              ; hibrida simplificada (greedy + persistence + 4 candidatos). Al llegar al
1518+ 94EE              ; pixel objetivo setea NastyFleeDespawn=1 → .peScaredDespawn borra sprite
1519+ 94EE              ; limpiamente (sin puff).
1520+ 94EE              ;
1521+ 94EE              ; Fallback: si el screen no tiene gaps, tail-call a UpdateNastyFlee.
1522+ 94EE              ;
1523+ 94EE              ; Destruye: AF, BC, DE, HL. Preserva IX.
1524+ 94EE              ; ==============================================================================
1525+ 94EE              UpdateMonsterLeave:
1526+ 94EE                  ; --- Slot index (0..2) desde IX ---
1527+ 94EE DD E5            PUSH IX
1528+ 94F0 E1               POP HL
1529+ 94F1 11 B3 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1530+ 94F4 B7               OR A
1531+ 94F5 ED 52            SBC HL, DE
1532+ 94F7 CB 3D            SRL L
1533+ 94F9 CB 3D            SRL L
1534+ 94FB CB 3D            SRL L
1535+ 94FD CB 3D            SRL L                               ; /16 = ENT_SIZE
1536+ 94FF 7D               LD A, L
1537+ 9500 32 D3 97         LD (MulSlot), A
1538+ 9503
1539+ 9503                  ; --- Lazy init: picar gap si flag clear ---
1540+ 9503 5F               LD E, A
1541+ 9504 16 00            LD D, 0
1542+ 9506 21 9B 8D         LD HL, MonsterAiFlags
1543+ 9509 19               ADD HL, DE
1544+ 950A 7E               LD A, (HL)
1545+ 950B E6 02            AND MAI_FLAG_LEAVING
1546+ 950D 20 25            JR NZ, .mulHaveGap
1547+ 950F
1548+ 950F CD C0 8F         CALL MaiPickRandomGap
1549+ 9512 B7               OR A
1550+ 9513 C2 97 B3         JP NZ, UpdateNastyFlee              ; Sin gaps → fallback
1551+ 9516                  ; Guardar side/coord per-slot
1552+ 9516 3A D3 97         LD A, (MulSlot)
1553+ 9519 5F               LD E, A
1554+ 951A 16 00            LD D, 0
1555+ 951C 21 95 8D         LD HL, MonsterEntryBorder
1556+ 951F 19               ADD HL, DE
1557+ 9520 3A C3 97         LD A, (MaiGapSide)
1558+ 9523 77               LD (HL), A
1559+ 9524 21 98 8D         LD HL, MonsterExitCoord
1560+ 9527 19               ADD HL, DE
1561+ 9528 3A C4 97         LD A, (MaiGapCoord)
1562+ 952B 77               LD (HL), A
1563+ 952C 21 9B 8D         LD HL, MonsterAiFlags
1564+ 952F 19               ADD HL, DE
1565+ 9530 7E               LD A, (HL)
1566+ 9531 F6 02            OR MAI_FLAG_LEAVING
1567+ 9533 77               LD (HL), A
1568+ 9534
1569+ 9534              .mulHaveGap:
1570+ 9534                  ; --- Cargar side/coord y traducir a pixel (MaiSpawnX/Y) ---
1571+ 9534 3A D3 97         LD A, (MulSlot)
1572+ 9537 5F               LD E, A
1573+ 9538 16 00            LD D, 0
1574+ 953A 21 95 8D         LD HL, MonsterEntryBorder
1575+ 953D 19               ADD HL, DE
1576+ 953E 7E               LD A, (HL)
