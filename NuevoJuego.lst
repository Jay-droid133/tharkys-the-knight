1995+ AD3F              ; ==============================================================================
1996+ AD3F              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
1997+ AD3F              ; ==============================================================================
1998+ AD3F              CheckWellPickup:
1999+ AD3F 3A 64 90         LD A, (WellActive)
2000+ AD42 B7               OR A
2001+ AD43 C8               RET Z                               ; No hay pozo en esta pantalla
2002+ AD44                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2003+ AD44 2A 68 90         LD HL, (WellCooldownTimer)
2004+ AD47 7C               LD A, H
2005+ AD48 B5               OR L
2006+ AD49 C0               RET NZ                              ; timer > 0 → skip
2007+ AD4A                  ; Ya esta al maximo? No hacer nada
2008+ AD4A 3A 99 B5         LD A, (PlayerHealth)
2009+ AD4D FE 10            CP HEALTH_MAX
2010+ AD4F 20 06            JR NZ, .cwDoCheck
2011+ AD51 3A 9A B5         LD A, (PlayerStamina)
2012+ AD54 FE 10            CP STAMINA_MAX
2013+ AD56 C8               RET Z                               ; Ambos al maximo → nada
2014+ AD57              .cwDoCheck:
2015+ AD57                  ; AABB con margen de 8px (1 celda) por cada lado:
2016+ AD57                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2017+ AD57                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2018+ AD57                  ; --- Check X ---
2019+ AD57 3A 65 90         LD A, (WellPosX)
2020+ AD5A C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2021+ AD5C 4F               LD C, A
2022+ AD5D 3A 17 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2023+ AD60 B9               CP C                                ; playerX < wellRight+margen?
2024+ AD61 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2025+ AD63 3A 17 81         LD A, (EntityTable + ENT_POSX)
2026+ AD66 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2027+ AD68 4F               LD C, A
2028+ AD69 3A 65 90         LD A, (WellPosX)                    ; A = wellX
2029+ AD6C B9               CP C                                ; wellX < playerRight+margen?
2030+ AD6D 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2031+ AD6F                  ; --- Check Y ---
2032+ AD6F 3A 66 90         LD A, (WellPosY)
2033+ AD72 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2034+ AD74 4F               LD C, A
2035+ AD75 3A 18 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2036+ AD78 B9               CP C                                ; playerY < wellBottom+margen?
2037+ AD79 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2038+ AD7B 3A 18 81         LD A, (EntityTable + ENT_POSY)
2039+ AD7E C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2040+ AD80 4F               LD C, A
2041+ AD81 3A 66 90         LD A, (WellPosY)                    ; A = wellY
2042+ AD84 B9               CP C                                ; wellY < playerBottom+margen?
2043+ AD85 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2044+ AD87                  ; --- Overlap! Recuperar salud y stamina ---
2045+ AD87 3E 10            LD A, HEALTH_MAX
2046+ AD89 32 99 B5         LD (PlayerHealth), A
2047+ AD8C 3E 10            LD A, STAMINA_MAX
2048+ AD8E 32 9A B5         LD (PlayerStamina), A
2049+ AD91                  ; Flash HUD y SFX
2050+ AD91 3E 0A            LD A, 10                            ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
2051+ AD93 32 67 90         LD (WellFlashTimer), A
2052+ AD96                  ; Arrancar cooldown: capturar attrs originales + pintar blanco
2053+ AD96 CD A0 AD         CALL StartWellCooldown
2054+ AD99 21 CF F9         LD HL, SFX_WellRecover
2055+ AD9C CD 18 F9         CALL PlaySFX
2056+ AD9F              .cwNoOverlap:
2057+ AD9F C9               RET
2058+ ADA0
2059+ ADA0              ; ==============================================================================
2060+ ADA0              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2061+ ADA0              ; ==============================================================================
2062+ ADA0              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2063+ ADA0              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2064+ ADA0              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2065+ ADA0              ; ==============================================================================
2066+ ADA0              StartWellCooldown:
2067+ ADA0 CD CD AD         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2068+ ADA3 E5               PUSH HL
2069+ ADA4 11 62 8D         LD DE, CleanAttrMap
2070+ ADA7 19               ADD HL, DE
2071+ ADA8 7E               LD A, (HL)
2072+ ADA9 32 6A 90         LD (WellOrigAttr0), A
2073+ ADAC 23               INC HL
2074+ ADAD 7E               LD A, (HL)
2075+ ADAE 32 6B 90         LD (WellOrigAttr1), A
2076+ ADB1 E1               POP HL
2077+ ADB2 CD E7 AD         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2078+ ADB5 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2079+ ADB8 22 68 90         LD (WellCooldownTimer), HL
2080+ ADBB C9               RET
2081+ ADBC
2082+ ADBC              ; ==============================================================================
2083+ ADBC              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2084+ ADBC              ; ==============================================================================
2085+ ADBC              ; Solo pinta blanco (no re-captura originals; los almacenados en
2086+ ADBC              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2087+ ADBC              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2088+ ADBC              ; para que el flash de cian dure lo mínimo posible.
2089+ ADBC              ; ==============================================================================
2090+ ADBC              ApplyWellCooldownIfActive:
2091+ ADBC 3A 64 90         LD A, (WellActive)
2092+ ADBF B7               OR A
2093+ ADC0 C8               RET Z
2094+ ADC1 2A 68 90         LD HL, (WellCooldownTimer)
2095+ ADC4 7C               LD A, H
2096+ ADC5 B5               OR L
2097+ ADC6 C8               RET Z
2098+ ADC7 CD CD AD         CALL GetWellBottomOffset
2099+ ADCA C3 E7 AD         JP PaintWellWhiteAt
2100+ ADCD
2101+ ADCD              ; ==============================================================================
2102+ ADCD              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2103+ ADCD              ; ==============================================================================
2104+ ADCD              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2105+ ADCD              ; CleanAttrMap suma CleanAttrMap.
2106+ ADCD              ; Destruye: A, DE
2107+ ADCD              ; ==============================================================================
2108+ ADCD              GetWellBottomOffset:
2109+ ADCD 3A 66 90         LD A, (WellPosY)
2110+ ADD0 26 00            LD H, 0
2111+ ADD2 6F               LD L, A
2112+ ADD3 29               ADD HL, HL
2113+ ADD4 29               ADD HL, HL                          ; (pixel_y/8)*32
2114+ ADD5 3A 65 90         LD A, (WellPosX)
2115+ ADD8 0F               RRCA
2116+ ADD9 0F               RRCA
2117+ ADDA 0F               RRCA
2118+ ADDB E6 1F            AND $1F
2119+ ADDD 85               ADD A, L
2120+ ADDE 6F               LD L, A
2121+ ADDF 30 01            JR NC, .gwbNoCarry
2122+ ADE1 24               INC H
2123+ ADE2              .gwbNoCarry:
2124+ ADE2 11 20 00         LD DE, 32
2125+ ADE5 19               ADD HL, DE                          ; offset fila inferior
2126+ ADE6 C9               RET
2127+ ADE7
2128+ ADE7              ; ==============================================================================
2129+ ADE7              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2130+ ADE7              ; ==============================================================================
2131+ ADE7              ; IN: HL = offset fila inferior (relativo a attr map)
2132+ ADE7              ; ==============================================================================
2133+ ADE7              PaintWellWhiteAt:
2134+ ADE7 E5               PUSH HL
2135+ ADE8                  ; VRAM
2136+ ADE8 11 00 58         LD DE, ATTR_BASE
2137+ ADEB 19               ADD HL, DE
2138+ ADEC 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2139+ ADEE 77               LD (HL), A
2140+ ADEF 23               INC HL
2141+ ADF0 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2142+ ADF2 77               LD (HL), A
2143+ ADF3 E1               POP HL
2144+ ADF4                  ; CleanAttrMap
2145+ ADF4 11 62 8D         LD DE, CleanAttrMap
2146+ ADF7 19               ADD HL, DE
2147+ ADF8 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2148+ ADFA 77               LD (HL), A
2149+ ADFB 23               INC HL
2150+ ADFC 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2151+ ADFE 77               LD (HL), A
2152+ ADFF C9               RET
2153+ AE00
2154+ AE00              ; ==============================================================================
2155+ AE00              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2156+ AE00              ; ==============================================================================
2157+ AE00              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2158+ AE00              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2159+ AE00              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2160+ AE00              ; ==============================================================================
2161+ AE00              UpdateWellCooldown:
2162+ AE00 2A 68 90         LD HL, (WellCooldownTimer)
2163+ AE03 7C               LD A, H
2164+ AE04 B5               OR L
2165+ AE05 C8               RET Z                               ; 0 → nada que hacer
2166+ AE06 2B               DEC HL
2167+ AE07 22 68 90         LD (WellCooldownTimer), HL
2168+ AE0A 7C               LD A, H
2169+ AE0B B5               OR L
2170+ AE0C C0               RET NZ                              ; > 0 → esperar
2171+ AE0D                  ; Timer acaba de llegar a 0. Si estamos en la room del pozo, restaurar
2172+ AE0D                  ; attrs originales. Si no, al volver DrawScreen ya dibuja cian normal.
2173+ AE0D 3A 64 90         LD A, (WellActive)
2174+ AE10 B7               OR A
2175+ AE11 C8               RET Z
2176+ AE12 C3 15 AE         JP RestoreWellOriginalAttrs
2177+ AE15
2178+ AE15              ; ==============================================================================
2179+ AE15              ; RestoreWellOriginalAttrs - escribe WellOrigAttrN a VRAM y CleanAttrMap
2180+ AE15              ; ==============================================================================
2181+ AE15              RestoreWellOriginalAttrs:
2182+ AE15 CD CD AD         CALL GetWellBottomOffset
2183+ AE18 E5               PUSH HL
2184+ AE19                  ; VRAM
2185+ AE19 11 00 58         LD DE, ATTR_BASE
2186+ AE1C 19               ADD HL, DE
2187+ AE1D 3A 6A 90         LD A, (WellOrigAttr0)
2188+ AE20 77               LD (HL), A
2189+ AE21 23               INC HL
2190+ AE22 3A 6B 90         LD A, (WellOrigAttr1)
2191+ AE25 77               LD (HL), A
2192+ AE26 E1               POP HL
2193+ AE27                  ; CleanAttrMap
2194+ AE27 11 62 8D         LD DE, CleanAttrMap
2195+ AE2A 19               ADD HL, DE
2196+ AE2B 3A 6A 90         LD A, (WellOrigAttr0)
2197+ AE2E 77               LD (HL), A
2198+ AE2F 23               INC HL
2199+ AE30 3A 6B 90         LD A, (WellOrigAttr1)
2200+ AE33 77               LD (HL), A
2201+ AE34 C9               RET
