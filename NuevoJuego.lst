 471+ A055              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A055              ; ==============================================================================
 473+ A055              SetAttrSlot:
 474+ A055 32 54 A0         LD (CurrentAttrSlot), A
 475+ A058                  ; Calcular offset: A * 18
 476+ A058 6F               LD L, A
 477+ A059 26 00            LD H, 0
 478+ A05B 29               ADD HL, HL                  ; x2
 479+ A05C 54               LD D, H
 480+ A05D 5D               LD E, L                     ; DE = x2
 481+ A05E 29               ADD HL, HL                  ; x4
 482+ A05F 29               ADD HL, HL                  ; x8
 483+ A060 29               ADD HL, HL                  ; x16
 484+ A061 19               ADD HL, DE                  ; x18
 485+ A062 11 22 9F         LD DE, SavedAttrTable
 486+ A065 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A066                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A066 11 10 9F         LD DE, EntitySavedAttr
 489+ A069 01 12 00         LD BC, 18
 490+ A06C ED B0            LDIR
 491+ A06E C9               RET
 492+ A06F
 493+ A06F              ; ==============================================================================
 494+ A06F              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A06F              ; ==============================================================================
 496+ A06F              FlushAttrSlot:
 497+ A06F 3A 54 A0         LD A, (CurrentAttrSlot)
 498+ A072 6F               LD L, A
 499+ A073 26 00            LD H, 0
 500+ A075 29               ADD HL, HL                  ; x2
 501+ A076 54               LD D, H
 502+ A077 5D               LD E, L
 503+ A078 29               ADD HL, HL                  ; x4
 504+ A079 29               ADD HL, HL                  ; x8
 505+ A07A 29               ADD HL, HL                  ; x16
 506+ A07B 19               ADD HL, DE                  ; x18
 507+ A07C 11 22 9F         LD DE, SavedAttrTable
 508+ A07F 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A080 EB               EX DE, HL                   ; DE = destino
 510+ A081 21 10 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A084 01 12 00         LD BC, 18
 512+ A087 ED B0            LDIR
 513+ A089 C9               RET
 514+ A08A
 515+ A08A              ; ==============================================================================
 516+ A08A              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A08A              ; ==============================================================================
 518+ A08A              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A08A              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A08A              ; ==============================================================================
 521+ A08A              CalcAttrAddr:
 522+ A08A 7A               LD A, D
 523+ A08B 0F               RRCA
 524+ A08C 0F               RRCA
 525+ A08D 0F               RRCA
 526+ A08E E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A090 6F               LD L, A
 528+ A091 26 00            LD H, 0
 529+ A093 29               ADD HL, HL
 530+ A094 29               ADD HL, HL
 531+ A095 29               ADD HL, HL
 532+ A096 29               ADD HL, HL
 533+ A097 29               ADD HL, HL                  ; HL = fila * 32
 534+ A098 7B               LD A, E
 535+ A099 0F               RRCA
 536+ A09A 0F               RRCA
 537+ A09B 0F               RRCA
 538+ A09C E6 1F            AND $1F                     ; X / 8 = columna
 539+ A09E B5               OR L
 540+ A09F 6F               LD L, A
 541+ A0A0 01 00 58         LD BC, ATTR_BASE
 542+ A0A3 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A0A4 C9               RET
 544+ A0A5
 545+ A0A5              ; ==============================================================================
 546+ A0A5              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A0A5              ; ==============================================================================
 548+ A0A5              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A0A5              ; Salida: HL=direccion en VRAM
 550+ A0A5              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A0A5              ; ==============================================================================
 552+ A0A5              CalcPixelAddr:
 553+ A0A5 7A               LD A, D
 554+ A0A6 E6 C0            AND $C0                     ; Y7 Y6
 555+ A0A8 1F               RRA
 556+ A0A9 1F               RRA
 557+ A0AA 1F               RRA                         ; >> 3
 558+ A0AB F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A0AD 67               LD H, A
 560+ A0AE
 561+ A0AE 7A               LD A, D
 562+ A0AF E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A0B1 B4               OR H
 564+ A0B2 67               LD H, A
 565+ A0B3
 566+ A0B3 7A               LD A, D
 567+ A0B4 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A0B6 87               ADD A, A
 569+ A0B7 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A0B8 6F               LD L, A
 571+ A0B9
 572+ A0B9 7B               LD A, E
 573+ A0BA 1F               RRA
 574+ A0BB 1F               RRA
 575+ A0BC 1F               RRA
 576+ A0BD E6 1F            AND $1F                     ; X / 8 = columna
 577+ A0BF B5               OR L
 578+ A0C0 6F               LD L, A
 579+ A0C1 C9               RET
 580+ A0C2
 581+ A0C2              ; ==============================================================================
 582+ A0C2              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A0C2              ; ==============================================================================
 584+ A0C2              DrawDebugInfo:
 585+ A0C2 3A AD 82         LD A, (CurrentScreenX)
 586+ A0C5 1E 00            LD E, 0
 587+ A0C7 CD E4 A0         CALL .drawHexDigit
 588+ A0CA
 589+ A0CA 3E 2C            LD A, ','
 590+ A0CC 1E 01            LD E, 1
 591+ A0CE CD F0 A0         CALL .drawChar
 592+ A0D1
 593+ A0D1 3A AE 82         LD A, (CurrentScreenY)
 594+ A0D4 1E 02            LD E, 2
 595+ A0D6 CD E4 A0         CALL .drawHexDigit
 596+ A0D9
 597+ A0D9 21 00 58         LD HL, ATTR_BASE
 598+ A0DC 3E 47            LD A, WHITE | $40
 599+ A0DE 77               LD (HL), A
 600+ A0DF 23               INC HL
 601+ A0E0 77               LD (HL), A
 602+ A0E1 23               INC HL
 603+ A0E2 77               LD (HL), A
 604+ A0E3 C9               RET
 605+ A0E4
 606+ A0E4              .drawHexDigit:
 607+ A0E4 E6 0F            AND $0F
 608+ A0E6 FE 0A            CP 10
 609+ A0E8 38 04            JR C, .isNum
 610+ A0EA C6 37            ADD A, 'A' - 10
 611+ A0EC 18 02            JR .drawChar
 612+ A0EE              .isNum:
 613+ A0EE C6 30            ADD A, '0'
 614+ A0F0              .drawChar:
 615+ A0F0 6F               LD L, A
 616+ A0F1 26 00            LD H, 0
 617+ A0F3 29               ADD HL, HL
 618+ A0F4 29               ADD HL, HL
 619+ A0F5 29               ADD HL, HL
 620+ A0F6 01 00 3C         LD BC, $3C00
 621+ A0F9 09               ADD HL, BC
 622+ A0FA
 623+ A0FA 16 40            LD D, $40
 624+ A0FC 06 08            LD B, 8
 625+ A0FE              .charLoop:
 626+ A0FE 7E               LD A, (HL)
 627+ A0FF 12               LD (DE), A
 628+ A100 23               INC HL
 629+ A101 14               INC D
 630+ A102 10 FA            DJNZ .charLoop
 631+ A104 C9               RET
