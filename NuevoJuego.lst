 589+ C3C5 DD 23            INC IX
 590+ C3C7 DD 23            INC IX                      ; IX -> pixel data
 591+ C3C9
 592+ C3C9                  ; Calcular dir VRAM inicio: x_pixel = x_char*8, y_pixel = y_char*8
 593+ C3C9 79               LD A, C
 594+ C3CA 07               RLCA
 595+ C3CB 07               RLCA
 596+ C3CC 07               RLCA
 597+ C3CD 57               LD D, A                     ; D = y_pixel
 598+ C3CE 78               LD A, B
 599+ C3CF 07               RLCA
 600+ C3D0 07               RLCA
 601+ C3D1 07               RLCA
 602+ C3D2 5F               LD E, A                     ; E = x_pixel
 603+ C3D3 CD AD 9D         CALL CalcPixelAddr          ; HL = dir VRAM
