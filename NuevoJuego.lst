 684+ AD6E 28 16            JR Z, .rsDone
 685+ AD70
 686+ AD70 46               LD B, (HL)                  ; B = x_char
 687+ AD71 23               INC HL
 688+ AD72 4E               LD C, (HL)                  ; C = y_char
 689+ AD73 23               INC HL
 690+ AD74 7E               LD A, (HL)                  ; A = tint variant
 691+ AD75 23               INC HL
 692+ AD76 32 2A AD         LD (CurrentTintVar), A
 693+ AD79 E5               PUSH HL
