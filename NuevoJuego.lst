 642+ E7F4              ; ==============================================================================
 643+ E7F4              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 644+ E7F4              ; ==============================================================================
 645+ E7F4              ; Llamar cada frame desde el main loop.
 646+ E7F4              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 647+ E7F4              ; ==============================================================================
 648+ E7F4              DrawPlazaClock:
 649+ E7F4 3A 6C 90         LD A, (PlazaClockActive)
 650+ E7F7 B7               OR A
 651+ E7F8 C8               RET Z
 652+ E7F9
 653+ E7F9                  ; --- Calcular posicion actual de las agujas ---
 654+ E7F9 3A 5B E3         LD A, (GameHours)
 655+ E7FC FE 0C            CP 12
 656+ E7FE 38 02            JR C, .pCalcHourOk
 657+ E800 D6 0C            SUB 12
 658+ E802              .pCalcHourOk:
 659+ E802 57               LD D, A                     ; D = display hour (0-11)
 660+ E803 3A 5A E3         LD A, (GameMinutes)
 661+ E806 1E 00            LD E, 0
 662+ E808              .pCalcDiv5:
 663+ E808 FE 05            CP 5
 664+ E80A 38 05            JR C, .pCalcMinOk
 665+ E80C D6 05            SUB 5
 666+ E80E 1C               INC E
 667+ E80F 18 F7            JR .pCalcDiv5
 668+ E811              .pCalcMinOk:
 669+ E811                  ; D = hour pos (0-11), E = minute pos (0-11)
 670+ E811
 671+ E811                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 672+ E811 3A 65 E8         LD A, (PlazaLastHour)
 673+ E814 BA               CP D
 674+ E815 20 05            JR NZ, .pNeedsRedraw
 675+ E817 3A 66 E8         LD A, (PlazaLastMin)
 676+ E81A BB               CP E
 677+ E81B C8               RET Z                       ; sin cambio → no redibujar
 678+ E81C
 679+ E81C              .pNeedsRedraw:
 680+ E81C 7A               LD A, D
 681+ E81D 32 65 E8         LD (PlazaLastHour), A
 682+ E820 7B               LD A, E
 683+ E821 32 66 E8         LD (PlazaLastMin), A
 684+ E824
 685+ E824                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 686+ E824                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 687+ E824 DD 21 42 8D      LD IX, PlazaClockPixels
 688+ E828 FD 21 6F 90      LD IY, PlazaScanAddrs
 689+ E82C 06 10            LD B, 16
 690+ E82E              .faceRow:
 691+ E82E FD 6E 00         LD L, (IY+0)
 692+ E831 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 693+ E834 DD 7E 00         LD A, (IX+0)
 694+ E837 2F               CPL                         ; des-invertir (dato CPL'd)
 695+ E838 77               LD (HL), A                  ; byte izquierdo
 696+ E839 23               INC HL
 697+ E83A DD 7E 01         LD A, (IX+1)
 698+ E83D 2F               CPL
 699+ E83E 77               LD (HL), A                  ; byte derecho
 700+ E83F DD 23            INC IX
 701+ E841 DD 23            INC IX
 702+ E843 FD 23            INC IY
 703+ E845 FD 23            INC IY
 704+ E847 10 E5            DJNZ .faceRow
