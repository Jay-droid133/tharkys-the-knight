1411+ F6C9              ; ==============================================================================
1412+ F6C9              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1413+ F6C9              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1414+ F6C9              ;     A  = jitter signed (-1, 0, +1) en bits.
1415+ F6C9              ; ==============================================================================
1416+ F6C9              ; IN: A = jitter signed (-1, 0, +1) en bits.
1417+ F6C9              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1418+ F6C9              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1419+ F6C9              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1420+ F6C9              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1421+ F6C9              ; version shifted, sin XOR.
1422+ F6C9              ;
1423+ F6C9              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1424+ F6C9              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1425+ F6C9              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1426+ F6C9              ; estatua se perdio cuando la estatua se pinto la primera vez con
1427+ F6C9              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1428+ F6C9              ; de la estatua, el wall perdido no se ve.
1429+ F6C9              ;
1430+ F6C9              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1431+ F6C9              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1432+ F6C9              ; shift de 1 bit no pierde pixels visibles.
1433+ F6C9              ; Destruye: AF, BC, DE, HL, IX.
1434+ F6C9              ; ==============================================================================
1435+ F6C9              ChurchCutsceneShakeStatueByteShift:
1436+ F6C9 32 33 F7         LD (.csbsJitter), A
1437+ F6CC                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1438+ F6CC 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1439+ F6CF 5F               LD E, A
1440+ F6D0 16 00            LD D, 0
1441+ F6D2 19               ADD HL, DE
1442+ F6D3 7E               LD A, (HL)
1443+ F6D4 B7               OR A
1444+ F6D5 C8               RET Z                                   ; sin estatua
1445+ F6D6 6F               LD L, A
1446+ F6D7 26 00            LD H, 0
1447+ F6D9 54               LD D, H
1448+ F6DA 5D               LD E, L
1449+ F6DB 29               ADD HL, HL
1450+ F6DC 19               ADD HL, DE                              ; HL = id*3
1451+ F6DD 11 0A E2         LD DE, BgGfxPtrById
1452+ F6E0 19               ADD HL, DE
1453+ F6E1 5E               LD E, (HL)
1454+ F6E2 23               INC HL
1455+ F6E3 56               LD D, (HL)                              ; DE = sprite ptr
1456+ F6E4 23               INC HL
1457+ F6E5 7E               LD A, (HL)                              ; A = bank
1458+ F6E6 EB               EX DE, HL                               ; HL = sprite ptr
1459+ F6E7 CD BC 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1460+ F6EA                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1461+ F6EA DD 21 F5 89      LD IX, BgSpriteBuffer
1462+ F6EE DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1463+ F6F1 B7               OR A
1464+ F6F2 C8               RET Z
1465+ F6F3 47               LD B, A                                 ; B = row counter
1466+ F6F4 DD 23            INC IX
1467+ F6F6 DD 23            INC IX                                  ; IX -> pixel data
1468+ F6F8                  ; Calcular addr VRAM en (origX, origY)
1469+ F6F8 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1470+ F6FB 57               LD D, A
1471+ F6FC 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1472+ F6FF 5F               LD E, A
1473+ F700 CD 40 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1474+ F703              .csbsRow:
1475+ F703 C5               PUSH BC
1476+ F704 E5               PUSH HL                                 ; save inicio fila VRAM
1477+ F705                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1478+ F705 DD 7E 00         LD A, (IX+0)
1479+ F708 2F               CPL
1480+ F709 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1481+ F70A DD 7E 01         LD A, (IX+1)
1482+ F70D 2F               CPL
1483+ F70E 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1484+ F70F                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1485+ F70F 3A 33 F7         LD A, (.csbsJitter)
1486+ F712 B7               OR A
1487+ F713 28 0D            JR Z, .csbsWrite                        ; sin shift
1488+ F715 FA 1E F7         JP M, .csbsLeft                         ; A < 0 -> shift left
1489+ F718                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1490+ F718 CB 3A            SRL D
1491+ F71A CB 1B            RR E
1492+ F71C 18 04            JR .csbsWrite
1493+ F71E              .csbsLeft:
1494+ F71E CB 23            SLA E
1495+ F720 CB 12            RL D
1496+ F722              .csbsWrite:
1497+ F722 7A               LD A, D
1498+ F723 77               LD (HL), A
1499+ F724 23               INC HL
1500+ F725 7B               LD A, E
1501+ F726 77               LD (HL), A
1502+ F727 E1               POP HL
1503+ F728 CD AC 9D         CALL NextPixelLine                      ; HL = siguiente pixel row
1504+ F72B DD 23            INC IX
1505+ F72D DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1506+ F72F C1               POP BC
1507+ F730 10 D1            DJNZ .csbsRow
1508+ F732 C9               RET
1509+ F733 00           .csbsJitter: DEFB 0
