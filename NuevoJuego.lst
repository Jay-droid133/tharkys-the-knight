 727+ D401                  ; Guardar posicion para la fase de atributos
 728+ D401 78               LD A, B
 729+ D402 32 EF D4         LD (.xChar), A
 730+ D405 79               LD A, C
 731+ D406 32 F0 D4         LD (.yChar), A
