 129  6F76
 130  6F76                  ; ==========================================================================
 131  6F76                  ; ORG $8000 - codigo principal (no-contended)
 132  6F76                  ; ==========================================================================
 133  6F76                  ORG ORIGIN_ADDRESS
 134  8000
 135  8000              ; ==============================================================================
 136  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 137  8000              ; ==============================================================================
 138  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 139  8000              ;   erase viejo → AI/movimiento → draw nuevo
 140  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 141  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 142  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 143  8000              ; ==============================================================================
 144  8000              MainLoop:
 145  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 146  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 147  8003 47               LD B, A                     ; B = tick actual
 148  8004
 149  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 150  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 151  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 152  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 153  8004 78               LD A, B
 154  8005 21 3B 81         LD HL, .frameStart
 155  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 156  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 157  800A 21 1A 9D         LD HL, TickRemainder
 158  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 159  800E 4F               LD C, A
 160  800F E6 01            AND $01
 161  8011 77               LD (HL), A                  ; new remainder = total mod 2
 162  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 163  8014 79               LD A, C
 164  8015 32 19 9D         LD (FramesElapsed), A
 165  8018
 166  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 167  8018 CD 2E CE         CALL UpdateDeathBorder
 168  801B CD FF CD         CALL UpdateDeathAnim
 169  801E                  ; UpdateMusic vive aqui (no en .skipUpdates) para que las pistas tabulares
 170  801E                  ; suenen tambien durante cutscenes (TownGatePhase!=0) y GameOver. Cada
 171  801E                  ; llamada hace catchup interno via FramesElapsed (loop de N iteraciones).
 172  801E CD F3 9B         CALL UpdateMusic
 173  8021
 174  8021                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 175  8021 3A 71 82         LD A, (GameOver)
 176  8024 B7               OR A
 177  8025 28 23            JR Z, .notGameOver
 178  8027 FE 02            CP 2
 179  8029 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 180  802B                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 181  802B CD 89 CE         CALL PaintGameOverScreen
 182  802E 3E 02            LD A, 2
 183  8030 32 71 82         LD (GameOver), A
 184  8033 C3 2B 81         JP .frameSync
 185  8036              .gameOverWaitInput:
