 179+ 84E0              ; ==============================================================================
 180+ 84E0              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 181+ 84E0              ; ==============================================================================
 182+ 84E0              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 183+ 84E0              ; Entrada:
 184+ 84E0              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 185+ 84E0              ;   A = atributo a pintar
 186+ 84E0              ; ==============================================================================
 187+ 84E0              SetEntityAttr:
 188+ 84E0 F5               PUSH AF                     ; Guardar atributo
 189+ 84E1 CD F9 86         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 190+ 84E4 F1               POP AF
 191+ 84E5
 192+ 84E5 47               LD B, A                     ; B = atributo (preservar)
 193+ 84E6 3A 90 85         LD A, (EntityAttrH)
 194+ 84E9 4F               LD C, A                     ; C = filas
 195+ 84EA              .rowLoop:
 196+ 84EA 3A 8F 85         LD A, (EntityAttrW)
 197+ 84ED E5               PUSH HL                     ; Guardar inicio de fila
 198+ 84EE                  ; Pintar una fila
 199+ 84EE              .colLoop:
 200+ 84EE 70               LD (HL), B
 201+ 84EF 23               INC HL
 202+ 84F0 3D               DEC A
 203+ 84F1 20 FB            JR NZ, .colLoop
 204+ 84F3 E1               POP HL
 205+ 84F4                  ; Siguiente fila: HL += 32
 206+ 84F4 D5               PUSH DE
 207+ 84F5 11 20 00         LD DE, 32
 208+ 84F8 19               ADD HL, DE
 209+ 84F9 D1               POP DE
 210+ 84FA 0D               DEC C
 211+ 84FB 20 ED            JR NZ, .rowLoop
 212+ 84FD C9               RET
