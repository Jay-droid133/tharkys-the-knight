 483+ F174                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 484+ F174                  ; magic compass activo (que necesita redibujar para el blink y para
 485+ F174                  ; reflejar la dir del path al cambiar de sala).
 486+ F174 3A 10 83         LD A, (CurrentScreenX)
 487+ F177 47               LD B, A
 488+ F178 3A C3 82         LD A, (LastCompassScreenX)
 489+ F17B B8               CP B
 490+ F17C C2 A2 F1         JP NZ, .dcRedrawNewScreen
 491+ F17F 3A 11 83         LD A, (CurrentScreenY)
 492+ F182 47               LD B, A
 493+ F183 3A C4 82         LD A, (LastCompassScreenY)
 494+ F186 B8               CP B
 495+ F187 C2 A2 F1         JP NZ, .dcRedrawNewScreen
 496+ F18A 3A C2 82         LD A, (PreviousObjectiveDistance)
 497+ F18D FE FF            CP $FF
 498+ F18F 28 16            JR Z, .dcRedraw
 499+ F191 3A C5 82         LD A, (CompassWobbleCounter)
 500+ F194 B7               OR A
 501+ F195 20 10            JR NZ, .dcRedraw
