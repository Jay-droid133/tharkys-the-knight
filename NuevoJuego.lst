 349+ 6F3F FE FF            CP $FF
 350+ 6F41 28 2A            JR Z, .urpScanDone
 351+ 6F43 FE D2            CP RANDOM_SLOT_MARKER
 352+ 6F45 20 20            JR NZ, .urpSkipEntry
 353+ 6F47                  ; Es marker. Cap reached?
 354+ 6F47 3A AB 5F         LD A, (RandomSlotCount)
 355+ 6F4A FE 04            CP RANDOM_SLOT_MAX
 356+ 6F4C 30 19            JR NC, .urpSkipEntry
 357+ 6F4E                  ; SlotList[count*2] = charX, [count*2+1] = charY
 358+ 6F4E 23               INC HL                              ; HL @ charX
 359+ 6F4F 46               LD B, (HL)                          ; B = charX
