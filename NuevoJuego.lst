  63+ EAA4              ; ==============================================================================
  64+ EAA4              ; ROULETTE — datos (fase 5: por categorias)
  65+ EAA4              ; ==============================================================================
  66+ EAA4              ; La ruleta cicla 6 caras en orden fijo:
  67+ EAA4              ;   ESPECIAL -> MALO -> RECURSO -> MALO -> STATS -> MALO -> (wrap)
  68+ EAA4              ; 50% de las caras son MALO -> tension al recoger sin mirar. Cada cara pica
  69+ EAA4              ; un item RANDOM dentro de su categoria cada tick (~480ms).
  70+ EAA4              ROULETTE_ORDER_LEN  EQU 6
  71+ EAA4
  72+ EAA4              ; Secuencia de las 6 caras (CAT_* enum):
  73+ EAA4              RouletteCatOrder:
  74+ EAA4 00               DEFB CAT_ESPECIAL                       ; cara 0
  75+ EAA5 01               DEFB CAT_MALO                           ; cara 1
  76+ EAA6 02               DEFB CAT_RECURSO                        ; cara 2
  77+ EAA7 01               DEFB CAT_MALO                           ; cara 3
  78+ EAA8 03               DEFB CAT_STATS                          ; cara 4
  79+ EAA9 01               DEFB CAT_MALO                           ; cara 5
  80+ EAAA
  81+ EAAA              ; Items por categoria (formato: DEFB count, ROUL_* items...):
  82+ EAAA              RouletteCatEspecial:
  83+ EAAA 03               DEFB 3
  84+ EAAB 01 07 0A         DEFB ROUL_LIFE, ROUL_COMPASS, ROUL_ESCUDO_RAYO
  85+ EAAE              RouletteCatMalo:
  86+ EAAE 03               DEFB 3
  87+ EAAF 06 05 0B         DEFB ROUL_MUSHROOM, ROUL_CARACOL, ROUL_REVERSE
  88+ EAB2              RouletteCatRecurso:
  89+ EAB2 02               DEFB 2
  90+ EAB3 02 03            DEFB ROUL_HEALTH, ROUL_STAMINA
  91+ EAB5              RouletteCatStats:
  92+ EAB5 03               DEFB 3
  93+ EAB6 04 08 09         DEFB ROUL_RAYO, ROUL_ESPADA, ROUL_ESCUDO
  94+ EAB9
  95+ EAB9              ; Lookup CAT_* -> cat table ptr (DEFW):
  96+ EAB9              RouletteCatItemTables:
  97+ EAB9 AA EA            DEFW RouletteCatEspecial                ; CAT_ESPECIAL = 0
  98+ EABB AE EA            DEFW RouletteCatMalo                    ; CAT_MALO = 1
  99+ EABD B2 EA            DEFW RouletteCatRecurso                 ; CAT_RECURSO = 2
 100+ EABF B5 EA            DEFW RouletteCatStats                   ; CAT_STATS = 3
