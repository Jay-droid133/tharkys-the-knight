2220+ DAAF 3A AF 82         LD A, (CurrentScreenY)
2221+ DAB2 B9               CP C
2222+ DAB3 20 3D            JR NZ, .rpbpSkipPtr
2223+ DAB5                  ; HL en ptr_lo. Comparar ptr con DE.
2224+ DAB5 7E               LD A, (HL)
2225+ DAB6 BB               CP E
2226+ DAB7 20 39            JR NZ, .rpbpSkipPtr
2227+ DAB9 23               INC HL                      ; HL en ptr_hi
2228+ DABA 7E               LD A, (HL)
2229+ DABB BA               CP D
2230+ DABC 20 3A            JR NZ, .rpbpSkipPtrHi
2231+ DABE                  ; Match. HL en ptr_hi. Avanzar a charX/charY/tint.
2232+ DABE 23               INC HL                      ; HL en charX
2233+ DABF 46               LD B, (HL)                  ; charX
2234+ DAC0 23               INC HL                      ; HL en charY
2235+ DAC1 4E               LD C, (HL)                  ; charY
2236+ DAC2 23               INC HL                      ; HL en tint
2237+ DAC3 7E               LD A, (HL)
2238+ DAC4 32 43 D5         LD (CurrentTintVar), A      ; tint correcto del placement (255 = sin tint)
