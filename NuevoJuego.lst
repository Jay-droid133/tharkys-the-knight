4474+ BB67 4F               LD C, A
4475+ BB68 CD 9D D1         CALL IsPointBlocked
4476+ BB6B C2 0C BC         JP NZ, .spawnBlocked
4477+ BB6E DD 7E 03         LD A, (IX+ENT_POSX)
4478+ BB71 47               LD B, A
4479+ BB72 3A 30 BC         LD A, (.spawnW1)
4480+ BB75 80               ADD A, B
4481+ BB76 47               LD B, A
4482+ BB77 DD 7E 04         LD A, (IX+ENT_POSY)
4483+ BB7A 4F               LD C, A
4484+ BB7B CD 9D D1         CALL IsPointBlocked
4485+ BB7E C2 0C BC         JP NZ, .spawnBlocked
4486+ BB81 DD 7E 03         LD A, (IX+ENT_POSX)
4487+ BB84 47               LD B, A
4488+ BB85 DD 7E 04         LD A, (IX+ENT_POSY)
4489+ BB88 4F               LD C, A
4490+ BB89 3A 31 BC         LD A, (.spawnH1)
4491+ BB8C 81               ADD A, C
4492+ BB8D 4F               LD C, A
4493+ BB8E CD 9D D1         CALL IsPointBlocked
4494+ BB91 C2 0C BC         JP NZ, .spawnBlocked
4495+ BB94 DD 7E 03         LD A, (IX+ENT_POSX)
4496+ BB97 47               LD B, A
4497+ BB98 3A 30 BC         LD A, (.spawnW1)
4498+ BB9B 80               ADD A, B
4499+ BB9C 47               LD B, A
4500+ BB9D DD 7E 04         LD A, (IX+ENT_POSY)
4501+ BBA0 4F               LD C, A
