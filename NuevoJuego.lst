2759+ AE13              ; ==============================================================================
2760+ AE13              ; ==============================================================================
2761+ AE13              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2762+ AE13              ; ==============================================================================
2763+ AE13              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2764+ AE13              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2765+ AE13              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2766+ AE13              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2767+ AE13              ; ==============================================================================
2768+ AE13              UpdateMonster:
2769+ AE13                  ; --- Stun: knockback + pausa tras golpe del player ---
2770+ AE13 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2771+ AE16 B7               OR A
2772+ AE17 CA 4C B0         JP Z, .moNormal
2773+ AE1A DD 35 0A         DEC (IX+ENT_DIR)
2774+ AE1D 20 0B            JR NZ, .moStunActive
2775+ AE1F                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2776+ AE1F DD 36 06 00      LD (IX+ENT_DELTAX), 0
2777+ AE23 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2778+ AE27 C3 4C B0         JP .moNormal
2779+ AE2A
2780+ AE2A              .moStunActive:
2781+ AE2A                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2782+ AE2A FE 06            CP MONSTER_STUN_PAUSE
2783+ AE2C DA DD B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2784+ AE2F                  ; Knockback: aplicar movimiento con collision check
2785+ AE2F DD 56 06         LD D, (IX+ENT_DELTAX)
2786+ AE32 DD 5E 07         LD E, (IX+ENT_DELTAY)
2787+ AE35 7A               LD A, D
2788+ AE36 B3               OR E
2789+ AE37 CA DD B1         JP Z, .moAnimate
2790+ AE3A                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2791+ AE3A D5               PUSH DE
2792+ AE3B DD 7E 03         LD A, (IX+ENT_POSX)
2793+ AE3E 32 75 B3         LD (.moSvX), A
2794+ AE41 DD 7E 04         LD A, (IX+ENT_POSY)
2795+ AE44 32 76 B3         LD (.moSvY), A
2796+ AE47                  ; Calcular nueva posicion
2797+ AE47 DD 7E 03         LD A, (IX+ENT_POSX)
2798+ AE4A 82               ADD A, D
2799+ AE4B DD 77 03         LD (IX+ENT_POSX), A
2800+ AE4E DD 7E 04         LD A, (IX+ENT_POSY)
2801+ AE51 83               ADD A, E
2802+ AE52 DD 77 04         LD (IX+ENT_POSY), A
2803+ AE55                  ; Comprobar bordes ANTES de colision con paredes
2804+ AE55 DD 7E 03         LD A, (IX+ENT_POSX)
2805+ AE58 FE E8            CP SCREEN_MAX_X
2806+ AE5A 30 30            JR NC, .moKbPreOffscreen
2807+ AE5C FE 04            CP MONSTER_KB_SPEED
2808+ AE5E 38 20            JR C, .moKbPreOffscreenMaybeX
2809+ AE60              .moKbPreBorderXOk:
2810+ AE60 DD 7E 04         LD A, (IX+ENT_POSY)
2811+ AE63 FE A8            CP SCREEN_MAX_Y
2812+ AE65 30 25            JR NC, .moKbPreOffscreen
2813+ AE67 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2814+ AE69 38 1B            JR C, .moKbPreOffscreenMaybeY
2815+ AE6B              .moKbPreBorderOk:
2816+ AE6B                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2817+ AE6B                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2818+ AE6B                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2819+ AE6B                  ; CheckEnemyCollision.
2820+ AE6B                  ; CheckChurchTrap retorna:
2821+ AE6B                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2822+ AE6B                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2823+ AE6B                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2824+ AE6B CD 02 F3         CALL CheckChurchTrap
2825+ AE6E B7               OR A
2826+ AE6F 28 07            JR Z, .moKbCollCheck
2827+ AE71 FE 02            CP 2
2828+ AE73 CA 24 AF         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2829+ AE76 D1               POP DE                              ; limpiar PUSH DE previo
2830+ AE77 C9               RET                                 ; cutscene activa, salir
2831+ AE78              .moKbCollCheck:
2832+ AE78                  ; Dentro de pantalla: comprobar colision con paredes
2833+ AE78 CD F1 B6         CALL CheckEnemyCollision
2834+ AE7B C2 24 AF         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2835+ AE7E 18 1C            JR .moKbNotBlocked
2836+ AE80              .moKbPreOffscreenMaybeX:
2837+ AE80 CB 7A            BIT 7, D
2838+ AE82 20 08            JR NZ, .moKbPreOffscreen
2839+ AE84 18 DA            JR .moKbPreBorderXOk
2840+ AE86              .moKbPreOffscreenMaybeY:
2841+ AE86 CB 7B            BIT 7, E
2842+ AE88 20 02            JR NZ, .moKbPreOffscreen
2843+ AE8A 18 DF            JR .moKbPreBorderOk
2844+ AE8C              .moKbPreOffscreen:
2845+ AE8C                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2846+ AE8C 3A 75 B3         LD A, (.moSvX)
2847+ AE8F DD 77 03         LD (IX+ENT_POSX), A
2848+ AE92 3A 76 B3         LD A, (.moSvY)
2849+ AE95 DD 77 04         LD (IX+ENT_POSY), A
2850+ AE98 D1               POP DE
2851+ AE99 C3 89 AF         JP .moKbOffscreen
2852+ AE9C              .moKbNotBlocked:
2853+ AE9C                  ; Pared libre: comprobar impacto con otro monster (billar)
2854+ AE9C CD 76 B2         CALL .moCheckOverlap
2855+ AE9F 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2856+ AEA1                  ; Libre: restaurar pos y aplicar movimiento
2857+ AEA1 3A 75 B3         LD A, (.moSvX)
2858+ AEA4 DD 77 03         LD (IX+ENT_POSX), A
2859+ AEA7 3A 76 B3         LD A, (.moSvY)
2860+ AEAA DD 77 04         LD (IX+ENT_POSY), A
2861+ AEAD D1               POP DE
2862+ AEAE C3 60 AF         JP .moKbApply
2863+ AEB1              .moKbBilliard:
2864+ AEB1                  ; Billar: A para en su sitio, B hereda la fuerza
2865+ AEB1 3A 75 B3         LD A, (.moSvX)
2866+ AEB4 DD 77 03         LD (IX+ENT_POSX), A
2867+ AEB7 3A 76 B3         LD A, (.moSvY)
2868+ AEBA DD 77 04         LD (IX+ENT_POSY), A
2869+ AEBD D1               POP DE
2870+ AEBE                  ; Transferir knockback al monster impactado
2871+ AEBE DD E5            PUSH IX
2872+ AEC0 DD 2A 7F B3      LD IX, (.moHitMonster)
2873+ AEC4                  ; Solo transferir si no esta ya en stun
2874+ AEC4 DD 7E 0A         LD A, (IX+ENT_DIR)
2875+ AEC7 B7               OR A
2876+ AEC8 20 2A            JR NZ, .moKbBilliardDone
2877+ AECA                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2878+ AECA 7A               LD A, D
2879+ AECB B7               OR A
2880+ AECC 28 0D            JR Z, .moBillNoX
2881+ AECE CB 7A            BIT 7, D
2882+ AED0 20 04            JR NZ, .moBillXNeg
2883+ AED2 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2884+ AED4 18 02            JR .moBillSetX
2885+ AED6              .moBillXNeg:
2886+ AED6 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2887+ AED8              .moBillSetX:
2888+ AED8 DD 77 06         LD (IX+ENT_DELTAX), A
2889+ AEDB              .moBillNoX:
2890+ AEDB 7B               LD A, E
2891+ AEDC B7               OR A
2892+ AEDD 28 0D            JR Z, .moBillNoY
2893+ AEDF CB 7B            BIT 7, E
2894+ AEE1 20 04            JR NZ, .moBillYNeg
2895+ AEE3 3E 03            LD A, MONSTER_KB_SPEED - 1
2896+ AEE5 18 02            JR .moBillSetY
2897+ AEE7              .moBillYNeg:
2898+ AEE7 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2899+ AEE9              .moBillSetY:
2900+ AEE9 DD 77 07         LD (IX+ENT_DELTAY), A
2901+ AEEC              .moBillNoY:
2902+ AEEC DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2903+ AEF0                  ; Kb heredado por billar: NO es directo del player.
2904+ AEF0                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2905+ AEF0 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2906+ AEF4              .moKbBilliardDone:
2907+ AEF4 DD E1            POP IX
2908+ AEF6                  ; A continua con fuerza reducida (no para del todo)
2909+ AEF6                  ; Reducir velocidad de A a la mitad
2910+ AEF6 DD 7E 06         LD A, (IX+ENT_DELTAX)
2911+ AEF9 CB 2F            SRA A                               ; /2 con signo
2912+ AEFB DD 77 06         LD (IX+ENT_DELTAX), A
2913+ AEFE 57               LD D, A
2914+ AEFF DD 7E 07         LD A, (IX+ENT_DELTAY)
2915+ AF02 CB 2F            SRA A
2916+ AF04 DD 77 07         LD (IX+ENT_DELTAY), A
2917+ AF07 5F               LD E, A
2918+ AF08                  ; Reducir stun restante de A
2919+ AF08 DD 7E 0A         LD A, (IX+ENT_DIR)
2920+ AF0B FE 08            CP MONSTER_STUN_PAUSE + 2
2921+ AF0D DA 41 B0         JP C, .moStunStop                   ; Casi sin stun → parar
2922+ AF10 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2923+ AF12 DD 77 0A         LD (IX+ENT_DIR), A
2924+ AF15                  ; Aplicar movimiento reducido de A
2925+ AF15 3A 75 B3         LD A, (.moSvX)
2926+ AF18 DD 77 03         LD (IX+ENT_POSX), A
2927+ AF1B 3A 76 B3         LD A, (.moSvY)
2928+ AF1E DD 77 04         LD (IX+ENT_POSY), A
2929+ AF21 C3 60 AF         JP .moKbApply
2930+ AF24              .moKbWallBlock:
2931+ AF24                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2932+ AF24 3A 75 B3         LD A, (.moSvX)
2933+ AF27 DD 77 03         LD (IX+ENT_POSX), A
2934+ AF2A 3A 76 B3         LD A, (.moSvY)
2935+ AF2D DD 77 04         LD (IX+ENT_POSY), A
2936+ AF30 D1               POP DE
2937+ AF31                  ; Intentar solo eje X (mantener direccion del golpe)
2938+ AF31 7A               LD A, D
2939+ AF32 B7               OR A
2940+ AF33 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2941+ AF35 D5               PUSH DE
2942+ AF36 1E 00            LD E, 0
2943+ AF38 CD 37 B2         CALL .moTryPassable
2944+ AF3B D1               POP DE
2945+ AF3C 20 09            JR NZ, .moKbSlideY
2946+ AF3E                  ; Slide en X funciona
2947+ AF3E 1E 00            LD E, 0
2948+ AF40 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2949+ AF44 C3 60 AF         JP .moKbApply
2950+ AF47              .moKbSlideY:
2951+ AF47                  ; Intentar solo eje Y (mantener direccion del golpe)
2952+ AF47 7B               LD A, E
2953+ AF48 B7               OR A
2954+ AF49 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2955+ AF4B D5               PUSH DE
2956+ AF4C 16 00            LD D, 0
2957+ AF4E CD 37 B2         CALL .moTryPassable
2958+ AF51 D1               POP DE
2959+ AF52 20 09            JR NZ, .moKbSlideStop
2960+ AF54                  ; Slide en Y funciona
2961+ AF54 16 00            LD D, 0
2962+ AF56 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2963+ AF5A C3 60 AF         JP .moKbApply
2964+ AF5D              .moKbSlideStop:
2965+ AF5D C3 41 B0         JP .moStunStop
2966+ AF60                  ; (moKbMonsterHit eliminado - reemplazado por moKbBilliard arriba)
2967+ AF60              .moKbApply:
2968+ AF60 DD 7E 03         LD A, (IX+ENT_POSX)
2969+ AF63 82               ADD A, D
2970+ AF64 DD 77 03         LD (IX+ENT_POSX), A
2971+ AF67                  ; Comprobar bordes X
2972+ AF67 FE E8            CP SCREEN_MAX_X
2973+ AF69 30 1E            JR NC, .moKbOffscreen               ; Derecha o underflow pasado izquierda
2974+ AF6B                  ; Borde izquierdo: si X < KB_SPEED y empujando a la izquierda
2975+ AF6B FE 04            CP MONSTER_KB_SPEED
2976+ AF6D 30 04            JR NC, .moKbXOk
2977+ AF6F CB 7A            BIT 7, D                            ; Delta X negativo?
2978+ AF71 20 16            JR NZ, .moKbOffscreen               ; Si, empujando izquierda → offscreen
2979+ AF73              .moKbXOk:
2980+ AF73 DD 7E 04         LD A, (IX+ENT_POSY)
2981+ AF76 83               ADD A, E
2982+ AF77 DD 77 04         LD (IX+ENT_POSY), A
2983+ AF7A                  ; Comprobar bordes Y
2984+ AF7A FE A8            CP SCREEN_MAX_Y
2985+ AF7C 30 0B            JR NC, .moKbOffscreen               ; Pasado borde inferior
2986+ AF7E                  ; Borde superior: si Y < MIN+KB_SPEED y empujando arriba
2987+ AF7E FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2988+ AF80 30 04            JR NC, .moKbYOk
2989+ AF82 CB 7B            BIT 7, E                            ; Delta Y negativo?
2990+ AF84 20 03            JR NZ, .moKbOffscreen               ; Si, empujando arriba → offscreen
2991+ AF86              .moKbYOk:
2992+ AF86 C3 DD B1         JP .moAnimate
2993+ AF89              .moKbOffscreen:
2994+ AF89                  ; Elegir eje de salida por MAGNITUD DEL KNOCKBACK, no por el eje que
2995+ AF89                  ; cruzo el borde primero. Asi el monster sale por el lado que el
2996+ AF89                  ; player quiso empujar (eje primario) aunque llegue al borde del eje
2997+ AF89                  ; secundario un frame antes por drift diagonal.
2998+ AF89                  ;
2999+ AF89                  ; |DX| vs |DY|: eje primario = mayor magnitud. En empate, horizontal.
3000+ AF89 DD 7E 06         LD A, (IX+ENT_DELTAX)
3001+ AF8C CB 7F            BIT 7, A
3002+ AF8E 28 02            JR Z, .moKbAbsDxOk
3003+ AF90 ED 44            NEG
3004+ AF92              .moKbAbsDxOk:
3005+ AF92 47               LD B, A                             ; B = |dx|
3006+ AF93 DD 7E 07         LD A, (IX+ENT_DELTAY)
3007+ AF96 CB 7F            BIT 7, A
3008+ AF98 28 02            JR Z, .moKbAbsDyOk
3009+ AF9A ED 44            NEG
3010+ AF9C              .moKbAbsDyOk:
3011+ AF9C                  ; A = |dy|, B = |dx|
3012+ AF9C B8               CP B
3013+ AF9D 30 30            JR NC, .moKbPrimY                   ; |dy| >= |dx| → Y primario
3014+ AF9F              .moKbPrimX:
3015+ AF9F                  ; Eje primario X → clamp X, mantener Y (clampeado al rango valido)
3016+ AF9F DD 7E 06         LD A, (IX+ENT_DELTAX)
3017+ AFA2 CB 7F            BIT 7, A
3018+ AFA4 20 08            JR NZ, .moKbExitLeft
3019+ AFA6 DD 36 03 E7      LD (IX+ENT_POSX), SCREEN_MAX_X - 1
3020+ AFAA 3E 04            LD A, DIR_E
3021+ AFAC 18 06            JR .moKbClampY
3022+ AFAE              .moKbExitLeft:
3023+ AFAE DD 36 03 00      LD (IX+ENT_POSX), 0
3024+ AFB2 3E 08            LD A, DIR_W
3025+ AFB4              .moKbClampY:
3026+ AFB4                  ; Proteger POSY: si el drift lo saco de rango, clamparlo al borde
3027+ AFB4 4F               LD C, A                             ; C = DIR_E/W
3028+ AFB5 DD 7E 04         LD A, (IX+ENT_POSY)
3029+ AFB8 FE A8            CP SCREEN_MAX_Y
3030+ AFBA 38 07            JR C, .moKbClampYHigh
3031+ AFBC                  ; POSY >= MAX (salio abajo o underflow): clamp a MAX-1
3032+ AFBC 3E A7            LD A, SCREEN_MAX_Y - 1
