 791+ F294              ; ==============================================================================
 792+ F294              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 793+ F294              ; ==============================================================================
 794+ F294              ; IN: DE = ptr a 16 filas x 2 bytes
 795+ F294              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 796+ F294              ; Destruye: AF, B, HL.
 797+ F294              ; ==============================================================================
 798+ F294              DrawCompassSprite:
 799+ F294                  ; Char row 0 (rows 0-7 del sprite)
 800+ F294 26 40            LD H, $40
 801+ F296 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 802+ F298 06 08            LD B, 8
 803+ F29A              .dcsRow0:
 804+ F29A 1A               LD A, (DE)
 805+ F29B 77               LD (HL), A
 806+ F29C 13               INC DE
 807+ F29D 23               INC HL
 808+ F29E 1A               LD A, (DE)
 809+ F29F 77               LD (HL), A
 810+ F2A0 13               INC DE
 811+ F2A1 2B               DEC HL
 812+ F2A2 24               INC H
 813+ F2A3 10 F5            DJNZ .dcsRow0
 814+ F2A5                  ; Char row 1 (rows 8-15 del sprite)
 815+ F2A5 26 40            LD H, $40
 816+ F2A7 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F2A9 06 08            LD B, 8
 818+ F2AB              .dcsRow1:
 819+ F2AB 1A               LD A, (DE)
 820+ F2AC 77               LD (HL), A
 821+ F2AD 13               INC DE
 822+ F2AE 23               INC HL
 823+ F2AF 1A               LD A, (DE)
 824+ F2B0 77               LD (HL), A
 825+ F2B1 13               INC DE
 826+ F2B2 2B               DEC HL
 827+ F2B3 24               INC H
 828+ F2B4 10 F5            DJNZ .dcsRow1
 829+ F2B6 C9               RET
