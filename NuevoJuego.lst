7303+ C788 3D               DEC A
7304+ C789 47               LD B, A
7305+ C78A 3A 75 5F         LD A, (DBfsCurCy)
7306+ C78D 4F               LD C, A
7307+ C78E 3E 02            LD A, MAI_DIR_W
7308+ C790 CD 12 C8         CALL .bfsTryNbr
7309+ C793              .bfsTryE:
7310+ C793 3A 74 5F         LD A, (DBfsCurCx)
