 227  9CF6                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 228  9CF6                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 229  9CF6                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9CF6              ; ==============================================================================
   2+ 9CF6              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9CF6              ; ==============================================================================
   4+ 9CF6              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9CF6              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9CF6              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9CF6              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9CF6              ;
   9+ 9CF6              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9CF6              ; fallo en el intento previo):
  11+ 9CF6              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9CF6              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9CF6              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9CF6              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, TensionMusicPtr,
  15+ 9CF6              ;      TensionMusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9CF6              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9CF6              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9CF6              ;
  19+ 9CF6              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9CF6              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9CF6              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9CF6              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9CF6              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9CF6              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9CF6              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9CF6              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9CF6              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9CF6              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9CF6              ; ==============================================================================
  30+ 9CF6
  31+ 9CF6              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9CF6              AY_Init:
  33+ 9CF6 F3               DI
  34+ 9CF7 3A 42 90         LD A, (CurrentPaging)
  35+ 9CFA E6 F8            AND $F8
  36+ 9CFC F6 04            OR 4
  37+ 9CFE 32 42 90         LD (CurrentPaging), A
  38+ 9D01 01 FD 7F         LD BC, $7FFD
  39+ 9D04 ED 79            OUT (C), A
  40+ 9D06 CD 7E E4         CALL AY_InitImpl
  41+ 9D09 3A 42 90         LD A, (CurrentPaging)
  42+ 9D0C E6 F8            AND $F8
  43+ 9D0E 32 42 90         LD (CurrentPaging), A
  44+ 9D11 01 FD 7F         LD BC, $7FFD
  45+ 9D14 ED 79            OUT (C), A
  46+ 9D16 3A C6 80         LD A, (StartupComplete)
  47+ 9D19 B7               OR A
  48+ 9D1A C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9D1B FB               EI
  50+ 9D1C C9               RET
  51+ 9D1D
  52+ 9D1D              ; --- AY_UpdateBell: cada frame ---
  53+ 9D1D              AY_UpdateBell:
  54+ 9D1D F3               DI
  55+ 9D1E 3A 42 90         LD A, (CurrentPaging)
  56+ 9D21 E6 F8            AND $F8
  57+ 9D23 F6 04            OR 4
  58+ 9D25 32 42 90         LD (CurrentPaging), A
  59+ 9D28 01 FD 7F         LD BC, $7FFD
  60+ 9D2B ED 79            OUT (C), A
  61+ 9D2D CD 4C E5         CALL AY_UpdateBellImpl
  62+ 9D30 3A 42 90         LD A, (CurrentPaging)
  63+ 9D33 E6 F8            AND $F8
  64+ 9D35 32 42 90         LD (CurrentPaging), A
  65+ 9D38 01 FD 7F         LD BC, $7FFD
  66+ 9D3B ED 79            OUT (C), A
  67+ 9D3D FB               EI
  68+ 9D3E C9               RET
  69+ 9D3F
  70+ 9D3F              ; --- UpdateTensionMusic: cada frame ---
  71+ 9D3F              UpdateTensionMusic:
  72+ 9D3F F3               DI
  73+ 9D40 3A 42 90         LD A, (CurrentPaging)
  74+ 9D43 E6 F8            AND $F8
  75+ 9D45 F6 04            OR 4
  76+ 9D47 32 42 90         LD (CurrentPaging), A
  77+ 9D4A 01 FD 7F         LD BC, $7FFD
  78+ 9D4D ED 79            OUT (C), A
  79+ 9D4F CD BC E5         CALL UpdateTensionMusicImpl
  80+ 9D52 3A 42 90         LD A, (CurrentPaging)
  81+ 9D55 E6 F8            AND $F8
  82+ 9D57 32 42 90         LD (CurrentPaging), A
  83+ 9D5A 01 FD 7F         LD BC, $7FFD
  84+ 9D5D ED 79            OUT (C), A
  85+ 9D5F FB               EI
  86+ 9D60 C9               RET
