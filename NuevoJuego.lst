 485+ FA3A              ; ---- Phase 6: player mirando camara mid-cutscene ----
 486+ FA3A              .bcPhTurnToCam:
 487+ FA3A CD 09 FC         CALL BankCutsceneDecTimer
 488+ FA3D C0               RET NZ
 489+ FA3E                  ; Player vuelve a N (cara puerta).
 490+ FA3E DD 21 9E 81      LD IX, EntityTable
 491+ FA42 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 492+ FA44 DD 77 00         LD (IX+ENT_SPRITEID), A
 493+ FA47 3E 0A            LD A, SPRID_WALK_N
 494+ FA49 DD 77 08         LD (IX+ENT_ANIMBASE), A
 495+ FA4C AF               XOR A
 496+ FA4D DD 77 09         LD (IX+ENT_ANIMTIMER), A
 497+ FA50 CD 9E 63         CALL TownGateRedrawPlayer
 498+ FA53 3E 0A            LD A, BCS_T_TURN_BACK
 499+ FA55 32 CD 82         LD (BankCutsceneTimer), A
 500+ FA58 3E 07            LD A, BCP_TURN_TO_DOOR
 501+ FA5A 32 CC 82         LD (BankCutscenePhase), A
 502+ FA5D C9               RET
