4842+ BD69
4843+ BD69 4C BD        CurrentNastyTable: DEFW DiurnalTypeTable
4844+ BD6B
4845+ BD6B              ; ==============================================================================
4846+ BD6B              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
4847+ BD6B              ; ==============================================================================
4848+ BD6B              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
4849+ BD6B              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
4850+ BD6B              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
4851+ BD6B              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
4852+ BD6B              ;   pantalla, no diurnos.
4853+ BD6B              ; ==============================================================================
4854+ BD6B              UpdateNastyTable:
4855+ BD6B 3A 6F DD         LD A, (CurrentTimeOfDay)
4856+ BD6E FE 02            CP 2
4857+ BD70 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
4858+ BD72 FE 06            CP 6
4859+ BD74 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
4860+ BD76 21 50 BD         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
4861+ BD79 18 03            JR .setTable
4862+ BD7B              .diurnal:
4863+ BD7B 21 4C BD         LD HL, DiurnalTypeTable
4864+ BD7E              .setTable:
4865+ BD7E 22 69 BD         LD (CurrentNastyTable), HL
4866+ BD81 C9               RET
4867+ BD82
4868+ BD82              ; ==============================================================================
4869+ BD82              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
4870+ BD82              ; ==============================================================================
4871+ BD82              ScareAllMonsters:
4872+ BD82 AF               XOR A
4873+ BD83 32 01 B6         LD (MonstersActive), A              ; No respawnear mas
4874+ BD86                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
4875+ BD86                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
4876+ BD86                  ; del amanecer capturara el orig POSX/POSY del primer frame.
4877+ BD86 21 53 90         LD HL, MonsterAiFlags
4878+ BD89 06 03            LD B, 3
4879+ BD8B              .samClearLoop:
4880+ BD8B 7E               LD A, (HL)
4881+ BD8C E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
4882+ BD8E 77               LD (HL), A
4883+ BD8F 23               INC HL
4884+ BD90 10 F9            DJNZ .samClearLoop
4885+ BD92 3E 7D            LD A, SCARE_TIMER_DAWN
4886+ BD94 32 97 B8         LD (ScareTimer), A
4887+ BD97                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
4888+ BD97                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
4889+ BD97                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
4890+ BD97                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
4891+ BD97 DD 21 D7 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4892+ BD9B 06 06            LD B, NUM_MONSTERS
4893+ BD9D              .samStateLoop:
4894+ BD9D DD 7E 01         LD A, (IX+ENT_TYPE)
4895+ BDA0 FE 02            CP TYPE_MONSTER
4896+ BDA2 20 1B            JR NZ, .samStateNext
4897+ BDA4 DD 7E 02         LD A, (IX+ENT_STATE)
4898+ BDA7 FE 03            CP STATE_DYING
4899+ BDA9 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
4900+ BDAB FE 04            CP STATE_SPAWNING
4901+ BDAD 28 10            JR Z, .samStateNext
4902+ BDAF DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
4903+ BDB3 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
4904+ BDB7 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4905+ BDBB DD 36 07 00      LD (IX+ENT_DELTAY), 0
4906+ BDBF              .samStateNext:
4907+ BDBF 11 10 00         LD DE, ENT_SIZE
4908+ BDC2 DD 19            ADD IX, DE
4909+ BDC4 10 D7            DJNZ .samStateLoop
4910+ BDC6 C9               RET
