 401+ F9AF              ; ---- Phase 1: lock + facing UP ----
 402+ F9AF              .bcPhLock:
 403+ F9AF CD 09 FC         CALL BankCutsceneDecTimer
 404+ F9B2 C0               RET NZ
 405+ F9B3                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 406+ F9B3 AF               XOR A
 407+ F9B4 32 CF 82         LD (BankCutsceneKnockIdx), A
 408+ F9B7 32 D2 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 409+ F9BA 3E 00            LD A, BCS_KNOCK_HIT
 410+ F9BC 32 CE 82         LD (BankCutsceneSubState), A
 411+ F9BF 3E 04            LD A, BCS_T_KNOCK_HIT
 412+ F9C1 32 CD 82         LD (BankCutsceneTimer), A
 413+ F9C4 CD A8 FB         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 414+ F9C7 3E 02            LD A, BCP_KNOCKS_1
 415+ F9C9 32 CC 82         LD (BankCutscenePhase), A
 416+ F9CC C9               RET
