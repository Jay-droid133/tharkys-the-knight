 680+ A206                  ; === STATE_SCARED: pausa dramatica + huida ===
 681+ A206              .peScared:
 682+ A206 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 683+ A20A C2 CF A2         JP NZ, .peScaredFresh
 684+ A20D
 685+ A20D                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 686+ A20D 3A F1 B5         LD A, (ScareTimer)
 687+ A210 FE 33            CP SCARE_FLEE_THRESHOLD + 1
 688+ A212 DA B2 A2         JP C, .peScaredFlee
 689+ A215                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 690+ A215                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 691+ A215 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 692+ A219 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 693+ A21D                  ; Shake monster-only (nasties durante bells no se agitan)
 694+ A21D DD 7E 01         LD A, (IX+ENT_TYPE)
 695+ A220 FE 02            CP TYPE_MONSTER
 696+ A222 C2 98 A2         JP NZ, .peScaredSpriteToggle
 697+ A225                  ; --- Shake ---
 698+ A225 CD 3C 8F         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 699+ A228 5F               LD E, A
 700+ A229 16 00            LD D, 0
 701+ A22B 21 96 8D         LD HL, MonsterAiFlags
 702+ A22E 19               ADD HL, DE
 703+ A22F 7E               LD A, (HL)
 704+ A230 CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 705+ A232 20 15            JR NZ, .peShakeActive
 706+ A234                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 707+ A234 F6 08            OR MAI_FLAG_SHAKE_SAVED
 708+ A236 77               LD (HL), A
 709+ A237 21 97 5F         LD HL, MonsterShakeOrigX
 710+ A23A 19               ADD HL, DE
 711+ A23B DD 7E 03         LD A, (IX+ENT_POSX)
 712+ A23E 77               LD (HL), A
 713+ A23F 21 9A 5F         LD HL, MonsterShakeOrigY
 714+ A242 19               ADD HL, DE
 715+ A243 DD 7E 04         LD A, (IX+ENT_POSY)
 716+ A246 77               LD (HL), A
 717+ A247 18 4F            JR .peScaredSpriteToggle
 718+ A249              .peShakeActive:
 719+ A249                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 720+ A249 ED 5F            LD A, R
 721+ A24B E6 03            AND 3
 722+ A24D 28 0C            JR Z, .peShakeUp
 723+ A24F 3D               DEC A
 724+ A250 28 0F            JR Z, .peShakeDown
 725+ A252 3D               DEC A
 726+ A253 28 12            JR Z, .peShakeLeft
 727+ A255                  ; 3: right
 728+ A255 06 01            LD B, 1
 729+ A257 0E 00            LD C, 0
 730+ A259 18 10            JR .peShakeApply
 731+ A25B              .peShakeUp:
 732+ A25B 06 00            LD B, 0
 733+ A25D 0E FF            LD C, -1
 734+ A25F 18 0A            JR .peShakeApply
 735+ A261              .peShakeDown:
 736+ A261 06 00            LD B, 0
 737+ A263 0E 01            LD C, 1
 738+ A265 18 04            JR .peShakeApply
 739+ A267              .peShakeLeft:
 740+ A267 06 FF            LD B, -1
 741+ A269 0E 00            LD C, 0
 742+ A26B              .peShakeApply:
 743+ A26B                  ; new POSX = orig + B, new POSY = orig + C
 744+ A26B 21 97 5F         LD HL, MonsterShakeOrigX
 745+ A26E 19               ADD HL, DE
 746+ A26F 7E               LD A, (HL)
 747+ A270 80               ADD A, B
 748+ A271 DD 77 03         LD (IX+ENT_POSX), A
 749+ A274 21 9A 5F         LD HL, MonsterShakeOrigY
 750+ A277 19               ADD HL, DE
 751+ A278 7E               LD A, (HL)
 752+ A279 81               ADD A, C
 753+ A27A DD 77 04         LD (IX+ENT_POSY), A
