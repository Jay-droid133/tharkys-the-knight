2038+ D6DB              .ipdLoop:
2039+ D6DB 7E               LD A, (HL)
2040+ D6DC 23               INC HL
2041+ D6DD 46               LD B, (HL)                      ; B = ptr_hi de la entry
2042+ D6DE 23               INC HL
2043+ D6DF B0               OR B
2044+ D6E0 28 24            JR Z, .ipdActive                ; ptr 0 = fin de tabla → no es dormant
2045+ D6E2                  ; HL apunta ahora a flag_lo. ptr_lo está en HL-2, ptr_hi en HL-1.
2046+ D6E2 2B               DEC HL
2046+ D6E3 2B             DEC HL                 ; volver a ptr_lo
2047+ D6E4 7E               LD A, (HL)
2048+ D6E5 BB               CP E
2049+ D6E6 20 18            JR NZ, .ipdNext
2050+ D6E8 23               INC HL
2051+ D6E9 7E               LD A, (HL)
2052+ D6EA BA               CP D
2053+ D6EB 20 0E            JR NZ, .ipdNextHi
2054+ D6ED                  ; ptr matchea: leer dirección del flag y consultar
2055+ D6ED 23               INC HL
2056+ D6EE 4E               LD C, (HL)                      ; flag_lo
2057+ D6EF 23               INC HL
2058+ D6F0 46               LD B, (HL)                      ; flag_hi
2059+ D6F1 0A               LD A, (BC)
2060+ D6F2 B7               OR A
2061+ D6F3 20 11            JR NZ, .ipdActive               ; flag != 0 → activo
2062+ D6F5 3E 01            LD A, 1                         ; dormant inactivo
2063+ D6F7 C1               POP BC
2064+ D6F8 E1               POP HL
2065+ D6F9 B7               OR A                            ; NZ
2066+ D6FA C9               RET
2067+ D6FB              .ipdNextHi:
2068+ D6FB                  ; HL en ptr_hi tras la 2ª comparación → +3 = SIG ptr_lo
2069+ D6FB 23               INC HL
2070+ D6FC 23               INC HL
2071+ D6FD 23               INC HL
