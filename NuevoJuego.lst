 192  6DCC
 193  6DCC                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 194  6DCC                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 195  6DCC                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 196  6DCC                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 197  6DCC                  ;
 198  6DCC                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 199  6DCC                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 200  6DCC                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 201  6DCC                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 202  6DCC                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 203  6DCC                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 204  6DCC                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 6DCC              ; ==============================================================================
   2+ 6DCC              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 6DCC              ; ==============================================================================
   4+ 6DCC              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 6DCC              ; Mientras MagicCompassTimer>0:
   6+ 6DCC              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 6DCC              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 6DCC              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 6DCC              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 6DCC              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 6DCC              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 6DCC              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 6DCC              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 6DCC              ;
  15+ 6DCC              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 6DCC              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 6DCC              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 6DCC              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 6DCC              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 6DCC              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 6DCC              ;
  22+ 6DCC              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 6DCC              ; ==============================================================================
  24+ 6DCC
  25+ 6DCC              ; ==============================================================================
  26+ 6DCC              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 6DCC              ; ==============================================================================
  28+ 6DCC              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 6DCC              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 6DCC              ; Destruye: AF, HL.
  31+ 6DCC              ; ==============================================================================
  32+ 6DCC              ApplyMagicCompassBuff:
  33+ 6DCC 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 6DCF 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 6DD2 3E 01            LD A, 1
  36+ 6DD4 32 C3 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 6DD7 AF               XOR A
  38+ 6DD8 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 6DDB 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 6DDD 32 C5 5F         LD (MagicCompassTickCounter), A
  41+ 6DE0                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  42+ 6DE0                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  43+ 6DE0                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  44+ 6DE0                  ; el futuro se quiere reactivar.
  45+ 6DE0 3E FF            LD A, $FF
  46+ 6DE2 32 C6 5F         LD (MagicCompassJingleIdx), A
  47+ 6DE5                  ; SFX al recoger: sweep ascendente AY canal B. Lasting tiene PIN extra.
  48+ 6DE5 3A CD 82         LD A, (MagicCompassPermanent)
  49+ 6DE8 B7               OR A
  50+ 6DE9 C2 DA 6B         JP NZ, AY_PlayLastingPickup         ; lasting: sweep largo + PIN (~1.12s)
  51+ 6DEC C3 CF 6B         JP AY_PlayCompassPickup             ; random: sweep corto (~640ms)
  52+ 6DEF
  53+ 6DEF              ; ==============================================================================
  54+ 6DEF              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  55+ 6DEF              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  56+ 6DEF              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  57+ 6DEF              ; ==============================================================================
  58+ 6DEF              ; Entry points:
  59+ 6DEF              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  60+ 6DEF              ;                           muerte / hito cumplido / llegar a sala destino,
  61+ 6DEF              ;                           sites que no saben si la brujula estaba activa.
  62+ 6DEF              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  63+ 6DEF              ;                           por el branch del timeout natural (Timer ya es 0
  64+ 6DEF              ;                           tras el DEC, asi que el check daria RET Z falso
  65+ 6DEF              ;                           positivo y se saltaria el cleanup).
  66+ 6DEF              ; ==============================================================================
  67+ 6DEF              CancelMagicCompass:
  68+ 6DEF 3A CD 82         LD A, (MagicCompassPermanent)
  69+ 6DF2 B7               OR A
  70+ 6DF3 C0               RET NZ                               ; lasting compass: nunca cancelar
  71+ 6DF4 3A BF 5F         LD A, (MagicCompassTimer)
  72+ 6DF7 47               LD B, A
  73+ 6DF8 3A C0 5F         LD A, (MagicCompassTimer + 1)
  74+ 6DFB B0               OR B
  75+ 6DFC C8               RET Z                                ; ya inactivo
  76+ 6DFD                  ; fall through al cleanup compartido
  77+ 6DFD              _DoCancelMagicCompass:
  78+ 6DFD AF               XOR A
  79+ 6DFE 32 BF 5F         LD (MagicCompassTimer), A
  80+ 6E01 32 C0 5F         LD (MagicCompassTimer + 1), A
  81+ 6E04 32 C5 5F         LD (MagicCompassTickCounter), A
  82+ 6E07 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  83+ 6E0A 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  84+ 6E0D 3E FF            LD A, $FF
  85+ 6E0F 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  86+ 6E12 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  87+ 6E15 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  88+ 6E18 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  89+ 6E1B 32 C2 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  90+ 6E1E                                                       ; frame: DrawCompass detecta $FF y
  91+ 6E1E                                                       ; entra a .dcRedraw, sustituyendo el
  92+ 6E1E                                                       ; sprite_compass_magic stale por la
  93+ 6E1E                                                       ; brujula clasica (8 flechas + X).
  94+ 6E1E C9               RET
  95+ 6E1F
  96+ 6E1F              ; ==============================================================================
  97+ 6E1F              ; RefreshMagicCompassForNewObjective - Recompute path tras avance de hito
  98+ 6E1F              ; ==============================================================================
  99+ 6E1F              ; Llamado desde CheckMilestonePickup/Trigger/DebugKey tras CancelMagicCompass.
 100+ 6E1F              ;
 101+ 6E1F              ; Caso normal (random pickup, no Permanent): CancelMagicCompass ya zappeo el
 102+ 6E1F              ; timer a 0; aqui retornamos inmediatamente sin tocar nada (no-op).
 103+ 6E1F              ;
 104+ 6E1F              ; Caso lasting compass (Permanent=1): CancelMagicCompass retorno sin tocar el
 105+ 6E1F              ; estado, asi que el timer sigue activo. El BFS anterior dejo MagicCompassPathDir
 106+ 6E1F              ; en $FF (current_sid == target_sid en el momento del pickup), lo que hace que
 107+ 6E1F              ; DrawCompass cayera en .dcMagicOff y renderizara la brujula clasica. Sin
 108+ 6E1F              ; recompute aqui, la brujula clasica persistia hasta el siguiente cambio de
 109+ 6E1F              ; sala (donde CheckScreenTransition llama a ForceComputeMagicCompassPath).
 110+ 6E1F              ;
 111+ 6E1F              ; Recompute sincrono = brujula magica vuelve a apuntar al NUEVO objetivo en el
 112+ 6E1F              ; mismo frame del pickup. Coste: ~10K T-states (~14% del frame), una sola vez
 113+ 6E1F              ; por avance de hito; gameplay normal no afectado.
 114+ 6E1F              ;
 115+ 6E1F              ; Destruye: AF, BC, DE, HL.
 116+ 6E1F              ; ==============================================================================
 117+ 6E1F              RefreshMagicCompassForNewObjective:
 118+ 6E1F 3A BF 5F         LD A, (MagicCompassTimer)
 119+ 6E22 47               LD B, A
 120+ 6E23 3A C0 5F         LD A, (MagicCompassTimer + 1)
 121+ 6E26 B0               OR B
 122+ 6E27 C8               RET Z                                ; magic inactiva: no-op
 123+ 6E28 3E FF            LD A, $FF
 124+ 6E2A 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache HUD
 125+ 6E2D C3 30 6E         JP ForceComputeMagicCompassPath      ; tail call: BFS sincrono al nuevo goal
 126+ 6E30
 127+ 6E30              ; ==============================================================================
 128+ 6E30              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
 129+ 6E30              ; ==============================================================================
 130+ 6E30              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
 131+ 6E30              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
 132+ 6E30              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
 133+ 6E30              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
 134+ 6E30              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
 135+ 6E30              ; direccion vieja (de la sala anterior).
 136+ 6E30              ;
 137+ 6E30              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 138+ 6E30              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 139+ 6E30              ; solo en transiciones — nunca en frames de gameplay normal.
 140+ 6E30              ;
 141+ 6E30              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 142+ 6E30              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 143+ 6E30              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 144+ 6E30              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 145+ 6E30              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 146+ 6E30              ;
 147+ 6E30              ; Destruye: AF, BC, DE, HL.
 148+ 6E30              ; ==============================================================================
 149+ 6E30              ForceComputeMagicCompassPath:
 150+ 6E30 AF               XOR A
 151+ 6E31 32 CD 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 152+ 6E34              .fcmcpLoop:
 153+ 6E34 CD EF 6E         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 154+ 6E37                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 155+ 6E37 3A CD 5F         LD A, (MagicCompassBfsState)
 156+ 6E3A B7               OR A
 157+ 6E3B 20 F7            JR NZ, .fcmcpLoop                    ; aun en progreso → otro chunk
 158+ 6E3D AF               XOR A
 159+ 6E3E 32 C3 5F         LD (MagicCompassPathDirty), A        ; ya recalculado, no necesita rerun
 160+ 6E41                  ; Forzar tick INMEDIATO en la nueva sala: TickCounter=0 hace que
 161+ 6E41                  ; UpdateMagicCompass dispare .umcTickFire en el siguiente frame, sin
 162+ 6E41                  ; esperar a que el contador llegue a 0 de forma natural (que podia
 163+ 6E41                  ; tardar hasta 50 frames = 1 segundo). El player ve flash + suena AY
 164+ 6E41                  ; al instante de cruzar, con la flecha correcta.
 165+ 6E41                  ; TickActiveFrames=0 mata cualquier flash residual del tick que estaba
 166+ 6E41                  ; en curso en la sala anterior — evita 1-2 frames de bright apuntando
 167+ 6E41                  ; a la dir vieja entre el cruce y el nuevo tick.
 168+ 6E41 32 C5 5F         LD (MagicCompassTickCounter), A
 169+ 6E44 32 C4 5F         LD (MagicCompassTickActiveFrames), A
 170+ 6E47 C9               RET
 171+ 6E48
 172+ 6E48              ; ==============================================================================
 173+ 6E48              ; UpdateMagicCompass - Tick por frame (timer, blink, AY tick, path)
 174+ 6E48              ; ==============================================================================
 175+ 6E48              ; (Jingle viejo de 3 notas eliminado — el SFX de pickup ahora usa _AY_PlaySweep
 176+ 6E48              ; via AY_PlayCompassPickup/AY_PlayLastingPickup, no necesita ticker).
 177+ 6E48              ; ==============================================================================
 178+ 6E48              UpdateMagicCompass:
 179+ 6E48 2A BF 5F         LD HL, (MagicCompassTimer)
 180+ 6E4B 7C               LD A, H
 181+ 6E4C B5               OR L
 182+ 6E4D C8               RET Z                                ; inactivo
 183+ 6E4E
 184+ 6E4E 2B               DEC HL
 185+ 6E4F 22 BF 5F         LD (MagicCompassTimer), HL
 186+ 6E52
 187+ 6E52 7C               LD A, H
 188+ 6E53 B5               OR L
 189+ 6E54 20 08            JR NZ, .umcStillActive
 190+ 6E56                  ; Timeout natural: Timer acaba de pasar a 0. Cleanup completo (saltando
 191+ 6E56                  ; el check del entry point publico, que daria RET Z falso positivo).
 192+ 6E56                  ; Disparar wobble del HUD compass clasico como senal visual de que el
 193+ 6E56                  ; power-up se acabo: 9 frames de oscilacion antes de quedarse en la
 194+ 6E56                  ; flecha del target. .dcWobbleStartNormal en DrawCompass aplica los
 195+ 6E56                  ; overrides per-frame; idx==4 (X) sigue sin oscilar (early-skip ya en
 196+ 6E56                  ; el codigo del wobble).
 197+ 6E56 3E 09            LD A, 9
 198+ 6E58 32 C5 82         LD (CompassWobbleCounter), A
 199+ 6E5B C3 FD 6D         JP _DoCancelMagicCompass             ; tail call: cleanup + force HUD redraw
 200+ 6E5E              .umcStillActive:
 201+ 6E5E
 202+ 6E5E                  ; ¿Llegamos a la sala del hito? Si sí, cancelar el power-up entero —
 203+ 6E5E                  ; no esperamos a coger el pickup. Esto detiene tick AY, jingle y libera
 204+ 6E5E                  ; el HUD compass al estado clásico (X blanca normal vía DrawCompass).
 205+ 6E5E 3A C0 82         LD A, (ObjectiveScreenX)
 206+ 6E61 FE FF            CP $FF
 207+ 6E63 28 12            JR Z, .umcNotAtTarget                ; sin objetivo resuelto → skip
 208+ 6E65 21 10 83         LD HL, CurrentScreenX
