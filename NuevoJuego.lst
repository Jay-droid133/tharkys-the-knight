4888+ B9F3 DD 7E 07         LD A, (IX+ENT_DELTAY)
4889+ B9F6 ED 44            NEG
4890+ B9F8 DD 77 07         LD (IX+ENT_DELTAY), A
4891+ B9FB 78               LD A, B
4892+ B9FC EE 40            XOR $40                             ; recalcular signs cacheados
4893+ B9FE 47               LD B, A
4894+ B9FF              .spawnDirOk:
4895+ B9FF 78               LD A, B
4896+ BA00 32 FB 82         LD (LastSpawnDirSigns), A
