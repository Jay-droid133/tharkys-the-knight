# file closed: room_routes_bank7.asm
 583  DB7B                  ; --- Game Over tumba 2x — body (~538 B) ---
 584  DB7B                  ; Cold path one-shot. Llamado via thunk en slot 1 (game_over_tomb_thunk.asm).
 585  DB7B                  ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
 586  DB7B                  ; al final → bank 7 desapareceria con el body ejecutandose). El thunk hace
 587  DB7B                  ; la carga del sprite ANTES de paginar bank 7 y llamar al body.
 588  DB7B                  INCLUDE "game_over_tomb.asm"
# file opened: game_over_tomb.asm
   1+ DB7B              ; ==============================================================================
   2+ DB7B              ; GAME OVER — TUMBA DEL JUGADOR A 2x (BODY, vive en BANK 7)
   3+ DB7B              ; ==============================================================================
   4+ DB7B              ; Cuerpo de la rutina. Vive en bank 7 (slot 3 cuando paged) por estar
   5+ DB7B              ; "holgado": tras bg_gfx_c (~$D226) y antes del storage de tombstones ($E000+),
   6+ DB7B              ; quedan ~3.5 KB libres. Bank 0 estaba al 96 % y este código es one-shot.
   7+ DB7B              ;
   8+ DB7B              ; Llamado por DrawTombstone2xCentered (thunk en slot 1) DESPUÉS de que el
   9+ DB7B              ; thunk haya cargado el sprite en BgSpriteBuffer y paginado bank 7 en slot 3.
  10+ DB7B              ; El body NO debe llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0
  11+ DB7B              ; en slot 3 al final → bank 7 desaparece → crash).
  12+ DB7B              ;
  13+ DB7B              ; Sprite ID 144 (BgGfx_little_house_cemetery, 48x40 px = 6x5 chars) renderizado
  14+ DB7B              ; al doble de tamaño (96x80 px = 12x10 chars) centrado en la pantalla de
  15+ DB7B              ; Game Over. La muerte hace moonwalk justo encima del techo.
  16+ DB7B              ;
  17+ DB7B              ; Sprite original: bg_gfx_b.asm (bank 4), formato BG con pixeles RLE+CPL'd.
  18+ DB7B              ;
  19+ DB7B              ; Algoritmo (precondición: BgSpriteBuffer ya tiene el sprite cargado):
  20+ DB7B              ;   1. DecodeRLEPixels: walk RLE stream, decodifica + CPL → escribe 240 bytes
  21+ DB7B              ;      planos en TombDecodedPixels (en bank 7 RAM). Salva src ptr post-pixels.
  22+ DB7B              ;   2. Draw2xPixels: itera 40 src rows × 6 src bytes. Por cada src byte: doble
  23+ DB7B              ;      via NibbleDoubleLUT (16 B), escribe 2 bytes a VRAM dst row top y dst
  24+ DB7B              ;      row bot (vertical doubling). Posicion final: pixel(80, 80)..(175, 159).
  25+ DB7B              ;   3. Draw2xAttrs: 5 src rows × 6 src attrs → 10 dst rows × 12 dst attrs.
  26+ DB7B              ;      Cada src attr replicado 2x2. Posicion final: char(10, 10)..(21, 19).
  27+ DB7B              ;
  28+ DB7B              ; Coste: ~30K T-states one-shot. Invisible.
  29+ DB7B              ; Tamaño: ~280 B código + 16 B LUT + 240 B scratch + 2 B var = ~538 B en bank 7.
  30+ DB7B              ;
  31+ DB7B              ; Capas:
  32+ DB7B              ;   - Tumba 2x: pixel Y range 80..159 (charY 10..19).
  33+ DB7B              ;   - Muerte moonwalk: pixel Y range 56..79 (charY 7..9). NO solapa con tumba.
  34+ DB7B              ; ==============================================================================
  35+ DB7B
  36+ DB7B              TOMB_2X_DST_PIXEL_X     EQU 80      ; centrar 96 px en 256: (256-96)/2 = 80
  37+ DB7B              TOMB_2X_DST_PIXEL_Y     EQU 80      ; deja Y 0..79 para HUD/título y la muerte
  38+ DB7B              TOMB_2X_DST_CHAR_X      EQU 10      ; = TOMB_2X_DST_PIXEL_X / 8
  39+ DB7B              TOMB_2X_DST_CHAR_Y      EQU 10      ; = TOMB_2X_DST_PIXEL_Y / 8
  40+ DB7B              TOMB_SRC_W_BYTES        EQU 6       ; 48 px / 8
  41+ DB7B              TOMB_SRC_H_PX           EQU 40      ; height en pixeles
  42+ DB7B              TOMB_SRC_ATTR_H         EQU 5       ; attr rows
  43+ DB7B              TOMB_SRC_ATTR_W         EQU 6       ; attr cols
  44+ DB7B              TOMB_SRC_BANK           EQU 4       ; bg_gfx_b.asm vive en bank 4 (cemetery)
  45+ DB7B
  46+ DB7B              ; ==============================================================================
  47+ DB7B              ; DrawTombstone2xBody - entry point del body en bank 7
  48+ DB7B              ; ==============================================================================
  49+ DB7B              ; Precondición: bank 7 paginado en slot 3 + BgSpriteBuffer ya cargado con
  50+ DB7B              ; el sprite (lo hace el thunk antes de llamar a esta rutina).
  51+ DB7B              ;
  52+ DB7B              ; Asume que la pantalla está limpia (pixels=0, attrs=$47) — el render escribe
  53+ DB7B              ; directamente a VRAM sin XOR.
  54+ DB7B              ;
  55+ DB7B              ; Destruye: AF, BC, DE, HL, IX.
  56+ DB7B              ; ==============================================================================
  57+ DB7B              DrawTombstone2xBody:
  58+ DB7B                  ; --- 1. Decodificar pixeles RLE+CPL → flat buffer ---
  59+ DB7B CD 84 DB         CALL DecodeTombRLEPixels        ; out: TombAttrSrcPtr = ptr a attr data
  60+ DB7E
  61+ DB7E                  ; --- 2. Dibujar pixeles 2x desde flat buffer ---
  62+ DB7E CD E1 DB         CALL DrawTombPixels2x
