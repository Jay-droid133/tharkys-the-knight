 637+ 66AF CD 39 67         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 638+ 66B2 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 639+ 66B4                  ; Leer charX (HL+4) y charY (HL+5) en BC
 640+ 66B4 E5               PUSH HL                                 ; save mapX ptr
 641+ 66B5 01 04 00         LD BC, 4
 642+ 66B8 09               ADD HL, BC
 643+ 66B9 46               LD B, (HL)                              ; B = charX
 644+ 66BA 23               INC HL
 645+ 66BB 4E               LD C, (HL)                              ; C = charY
 646+ 66BC E1               POP HL                                  ; HL = mapX ptr
 647+ 66BD                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 648+ 66BD E5               PUSH HL
 649+ 66BE C5               PUSH BC
 650+ 66BF 21 40 DF         LD HL, BgGfx_old_church_door_open
 651+ 66C2 3E 03            LD A, 3
 652+ 66C4 CD C9 67         CALL LoadBgSpriteToBuffer               ; preserva BC
 653+ 66C7 C1               POP BC
 654+ 66C8 C5               PUSH BC
 655+ 66C9 DD 21 FD 86      LD IX, BgSpriteBuffer
 656+ 66CD CD 2A DC         CALL DrawBgSpriteXOR                    ; borra
 657+ 66D0 C1               POP BC
 658+ 66D1 E1               POP HL
 659+ 66D2                  ; --- Patch ptr: open -> closed ---
 660+ 66D2 23               INC HL
