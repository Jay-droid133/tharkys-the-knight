 754+ F07C 23               INC HL
 755+ F07D E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ F07E
 757+ F07E                  ; --- Calcular scanLine (0-15) ---
 758+ F07E 78               LD A, B
 759+ F07F E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ F081 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ F083 28 02            JR Z, .pxIsTop
 762+ F085 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ F087              .pxIsTop:
