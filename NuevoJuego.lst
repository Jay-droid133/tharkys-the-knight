# file closed: monster_ai.asm
 492  985A                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 493  985A                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 494  985A                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 985A              ; ==============================================================================
   2+ 985A              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 985A              ; ==============================================================================
   4+ 985A              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 985A              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 985A              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 985A              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 985A              ;
   9+ 985A              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 985A              ; fallo en el intento previo):
  11+ 985A              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 985A              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 985A              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 985A              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 985A              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 985A              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 985A              ;      nadie las toca, asi que no hay corrupcion.
  18+ 985A              ;
  19+ 985A              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 985A              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 985A              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 985A              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 985A              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 985A              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 985A              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 985A              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 985A              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 985A              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 985A              ; ==============================================================================
  30+ 985A
  31+ 985A              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 985A              AY_Init:
  33+ 985A F3               DI
  34+ 985B 3A 84 8D         LD A, (CurrentPaging)
  35+ 985E E6 F8            AND $F8
  36+ 9860 F6 04            OR 4
  37+ 9862 32 84 8D         LD (CurrentPaging), A
  38+ 9865 01 FD 7F         LD BC, $7FFD
  39+ 9868 ED 79            OUT (C), A
  40+ 986A CD B9 E4         CALL AY_InitImpl
  41+ 986D 3A 84 8D         LD A, (CurrentPaging)
  42+ 9870 E6 F8            AND $F8
  43+ 9872 32 84 8D         LD (CurrentPaging), A
  44+ 9875 01 FD 7F         LD BC, $7FFD
  45+ 9878 ED 79            OUT (C), A
  46+ 987A 3A 9C 81         LD A, (StartupComplete)
  47+ 987D B7               OR A
  48+ 987E C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 987F FB               EI
  50+ 9880 C9               RET
  51+ 9881
  52+ 9881              ; --- AY_UpdateBell: cada frame ---
  53+ 9881              ; SP alterno (slot 1) durante el page switch para no enmascarar IRQs. DI corto
  54+ 9881              ; SOLO alrededor del Impl (que hace varios OUTs AY que deben ser atomicos
  55+ 9881              ; respecto al handler IRQ que tambien escribe AY). Ver project_paging_alt_stack.
  56+ 9881              AY_UpdateBell:
  57+ 9881 ED 73 AE 98      LD (.aubSavedSP), SP
  58+ 9885 31 D6 68         LD SP, PagingAltStackTop
  59+ 9888 3A 84 8D         LD A, (CurrentPaging)
  60+ 988B E6 F8            AND $F8
  61+ 988D F6 04            OR 4
  62+ 988F 32 84 8D         LD (CurrentPaging), A
  63+ 9892 01 FD 7F         LD BC, $7FFD
  64+ 9895 ED 79            OUT (C), A                      ; slot 3 = bank 4 (sin DI; SP alterno)
  65+ 9897 F3               DI                              ; cierra ventana antes de los OUTs AY del Impl
  66+ 9898 CD 81 E5         CALL AY_UpdateBellImpl
