2472+ DC2D 5E               LD E, (HL)
2473+ DC2E 23               INC HL
2474+ DC2F 56               LD D, (HL)                  ; DE = BgGfx ptr
2475+ DC30 23               INC HL                      ; HL en charX
2476+ DC31 46               LD B, (HL)                  ; charX
2477+ DC32 23               INC HL
2478+ DC33 4E               LD C, (HL)                  ; charY
2479+ DC34 23               INC HL
2480+ DC35 7E               LD A, (HL)                  ; tint variant
2481+ DC36 23               INC HL                      ; HL en siguiente mapX
2482+ DC37 32 FB D4         LD (CurrentTintVar), A
2483+ DC3A E5               PUSH HL                     ; guardar puntero a siguiente entry
2484+ DC3B C5               PUSH BC                     ; charX, charY (LoadBgSpriteToBuffer preserva BC, pero por seguridad)
2485+ DC3C EB               EX DE, HL                   ; HL = BgGfx ptr
2486+ DC3D 3E 03            LD A, 3                     ; ObjectTable (attrs) ptrs viven en bank 3
2487+ DC3F CD 41 6A         CALL LoadBgSpriteToBuffer
2488+ DC42 C1               POP BC
