2168+ AADF C9               RET
2169+ AAE0              .gscWhite:
2170+ AAE0 3E 47            LD A, WHITE | $40                   ; Normal → blanco
2171+ AAE2 C9               RET
2172+ AAE3
2173+ AAE3              ; ==============================================================================
2174+ AAE3              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2175+ AAE3              ; ==============================================================================
2176+ AAE3              CheckWellPickup:
2177+ AAE3 3A 50 8D         LD A, (WellActive)
2178+ AAE6 B7               OR A
2179+ AAE7 C8               RET Z                               ; No hay pozo en esta pantalla
2180+ AAE8                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2181+ AAE8 2A 54 8D         LD HL, (WellCooldownTimer)
2182+ AAEB 7C               LD A, H
2183+ AAEC B5               OR L
2184+ AAED C0               RET NZ                              ; timer > 0 → skip
2185+ AAEE                  ; Ya esta al maximo? No hacer nada
2186+ AAEE 3A 4B B3         LD A, (PlayerHealth)
2187+ AAF1 FE 10            CP HEALTH_MAX
2188+ AAF3 20 06            JR NZ, .cwDoCheck
2189+ AAF5 3A 4C B3         LD A, (PlayerStamina)
2190+ AAF8 FE 10            CP STAMINA_MAX
2191+ AAFA C8               RET Z                               ; Ambos al maximo → nada
2192+ AAFB              .cwDoCheck:
2193+ AAFB                  ; AABB con margen de 8px (1 celda) por cada lado:
2194+ AAFB                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2195+ AAFB                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2196+ AAFB                  ; --- Check X ---
2197+ AAFB 3A 51 8D         LD A, (WellPosX)
2198+ AAFE C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2199+ AB00 4F               LD C, A
2200+ AB01 3A 97 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2201+ AB04 B9               CP C                                ; playerX < wellRight+margen?
2202+ AB05 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2203+ AB07 3A 97 81         LD A, (EntityTable + ENT_POSX)
2204+ AB0A C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2205+ AB0C 4F               LD C, A
2206+ AB0D 3A 51 8D         LD A, (WellPosX)                    ; A = wellX
2207+ AB10 B9               CP C                                ; wellX < playerRight+margen?
2208+ AB11 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2209+ AB13                  ; --- Check Y ---
2210+ AB13 3A 52 8D         LD A, (WellPosY)
2211+ AB16 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2212+ AB18 4F               LD C, A
2213+ AB19 3A 98 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2214+ AB1C B9               CP C                                ; playerY < wellBottom+margen?
2215+ AB1D 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2216+ AB1F 3A 98 81         LD A, (EntityTable + ENT_POSY)
2217+ AB22 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2218+ AB24 4F               LD C, A
2219+ AB25 3A 52 8D         LD A, (WellPosY)                    ; A = wellY
2220+ AB28 B9               CP C                                ; wellY < playerBottom+margen?
2221+ AB29 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2222+ AB2B                  ; --- Overlap! Recuperar salud y stamina ---
2223+ AB2B 3E 10            LD A, HEALTH_MAX
2224+ AB2D 32 4B B3         LD (PlayerHealth), A
2225+ AB30 3E 10            LD A, STAMINA_MAX
2226+ AB32 32 4C B3         LD (PlayerStamina), A
2227+ AB35                  ; Flash HUD y SFX
2228+ AB35 3E 0A            LD A, 10                            ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
2229+ AB37 32 53 8D         LD (WellFlashTimer), A
2230+ AB3A                  ; Arrancar cooldown: capturar attrs originales + pintar blanco
2231+ AB3A CD 44 AB         CALL StartWellCooldown
2232+ AB3D 21 CE F9         LD HL, SFX_WellRecover
2233+ AB40 CD 24 F9         CALL PlaySFX
2234+ AB43              .cwNoOverlap:
2235+ AB43 C9               RET
2236+ AB44
2237+ AB44              ; ==============================================================================
2238+ AB44              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2239+ AB44              ; ==============================================================================
2240+ AB44              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2241+ AB44              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2242+ AB44              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2243+ AB44              ; ==============================================================================
2244+ AB44              StartWellCooldown:
2245+ AB44 CD 71 AB         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2246+ AB47 E5               PUSH HL
2247+ AB48 11 4E 8A         LD DE, CleanAttrMap
2248+ AB4B 19               ADD HL, DE
2249+ AB4C 7E               LD A, (HL)
2250+ AB4D 32 56 8D         LD (WellOrigAttr0), A
2251+ AB50 23               INC HL
2252+ AB51 7E               LD A, (HL)
2253+ AB52 32 57 8D         LD (WellOrigAttr1), A
2254+ AB55 E1               POP HL
2255+ AB56 CD 8B AB         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2256+ AB59 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2257+ AB5C 22 54 8D         LD (WellCooldownTimer), HL
2258+ AB5F C9               RET
2259+ AB60
2260+ AB60              ; ==============================================================================
2261+ AB60              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2262+ AB60              ; ==============================================================================
2263+ AB60              ; Solo pinta blanco (no re-captura originals; los almacenados en
2264+ AB60              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2265+ AB60              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2266+ AB60              ; para que el flash de cian dure lo mínimo posible.
2267+ AB60              ; ==============================================================================
2268+ AB60              ApplyWellCooldownIfActive:
2269+ AB60 3A 50 8D         LD A, (WellActive)
2270+ AB63 B7               OR A
2271+ AB64 C8               RET Z
2272+ AB65 2A 54 8D         LD HL, (WellCooldownTimer)
2273+ AB68 7C               LD A, H
2274+ AB69 B5               OR L
2275+ AB6A C8               RET Z
2276+ AB6B CD 71 AB         CALL GetWellBottomOffset
2277+ AB6E C3 8B AB         JP PaintWellWhiteAt
2278+ AB71
2279+ AB71              ; ==============================================================================
2280+ AB71              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2281+ AB71              ; ==============================================================================
2282+ AB71              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2283+ AB71              ; CleanAttrMap suma CleanAttrMap.
2284+ AB71              ; Destruye: A, DE
2285+ AB71              ; ==============================================================================
2286+ AB71              GetWellBottomOffset:
2287+ AB71 3A 52 8D         LD A, (WellPosY)
2288+ AB74 26 00            LD H, 0
2289+ AB76 6F               LD L, A
2290+ AB77 29               ADD HL, HL
2291+ AB78 29               ADD HL, HL                          ; (pixel_y/8)*32
2292+ AB79 3A 51 8D         LD A, (WellPosX)
2293+ AB7C 0F               RRCA
2294+ AB7D 0F               RRCA
2295+ AB7E 0F               RRCA
2296+ AB7F E6 1F            AND $1F
2297+ AB81 85               ADD A, L
2298+ AB82 6F               LD L, A
2299+ AB83 30 01            JR NC, .gwbNoCarry
2300+ AB85 24               INC H
2301+ AB86              .gwbNoCarry:
2302+ AB86 11 20 00         LD DE, 32
2303+ AB89 19               ADD HL, DE                          ; offset fila inferior
2304+ AB8A C9               RET
2305+ AB8B
2306+ AB8B              ; ==============================================================================
2307+ AB8B              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2308+ AB8B              ; ==============================================================================
2309+ AB8B              ; IN: HL = offset fila inferior (relativo a attr map)
2310+ AB8B              ; ==============================================================================
2311+ AB8B              PaintWellWhiteAt:
2312+ AB8B E5               PUSH HL
2313+ AB8C                  ; VRAM
2314+ AB8C 11 00 58         LD DE, ATTR_BASE
2315+ AB8F 19               ADD HL, DE
2316+ AB90 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2317+ AB92 77               LD (HL), A
2318+ AB93 23               INC HL
2319+ AB94 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2320+ AB96 77               LD (HL), A
2321+ AB97 E1               POP HL
2322+ AB98                  ; CleanAttrMap
2323+ AB98 11 4E 8A         LD DE, CleanAttrMap
2324+ AB9B 19               ADD HL, DE
