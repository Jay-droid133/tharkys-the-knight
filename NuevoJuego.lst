# file closed: screen_data.asm
 363  E4FE                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 364  E4FE                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 365  E4FE                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 366  E4FE                  ; deben vivir en el mismo banco paginado.
 367  E4FE                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E4FE              ; ==============================================================================
   2+ E4FE              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E4FE              ; ==============================================================================
   4+ E4FE              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E4FE              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E4FE              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E4FE              ; ==============================================================================
   8+ E4FE
   9+ E4FE              ; --- Constantes ---
  10+ E4FE              NUM_TIME_MOMENTS    EQU 7
  11+ E4FE
  12+ E4FE              ; --- Variables ---
  13+ E4FE 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E4FF 97 E9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E501 97 E9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E503 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E504 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E505 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E506
  20+ E506              ; ==============================================================================
  21+ E506              ; SetTimeOfDay - Cambia el momento del dia
  22+ E506              ; ==============================================================================
  23+ E506              ; Entrada: A = momento (0-6)
  24+ E506              ; ==============================================================================
  25+ E506              SetTimeOfDay:
  26+ E506 32 FE E4         LD (CurrentTimeOfDay), A
  27+ E509
  28+ E509                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E509 FE 04            CP 4
  30+ E50B 20 06            JR NZ, .notNewCycle
  31+ E50D 21 07 C0         LD HL, DayCycleCount
  32+ E510 34               INC (HL)
  33+ E511 18 04            JR .skipBellsReset
  34+ E513              .notNewCycle:
  35+ E513                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E513                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E513                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E513 AF               XOR A
  39+ E514 32 65 82         LD (BellsTriggered), A
  40+ E517              .skipBellsReset:
  41+ E517 3A FE E4         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E51A
  43+ E51A                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E51A FE 04            CP 4
  45+ E51C 28 21            JR Z, .bellsFirst
  46+ E51E
  47+ E51E                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E51E FE 05            CP 5
  49+ E520 20 0A            JR NZ, .noScareMon
  50+ E522 CD 21 C0         CALL ScareAllMonsters
  51+ E525                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  52+ E525                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  53+ E525                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  54+ E525                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  55+ E525 3E 01            LD A, 1                         ; track 1 = Sunrise
  56+ E527 CD 05 9D         CALL StartMusic
  57+ E52A 18 07            JR .noKillMon
  58+ E52C              .noScareMon:
  59+ E52C                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  60+ E52C FE 06            CP 6
  61+ E52E 20 03            JR NZ, .noKillMon
  62+ E530 CD AA BF         CALL KillAllActiveMonsters
  63+ E533              .noKillMon:
  64+ E533
  65+ E533                  ; Actualizar tablas de remap y tabla de nasties
  66+ E533 CD 68 E5         CALL UpdateRemapTables
  67+ E536 CD 0A C0         CALL UpdateNastyTable
  68+ E539
  69+ E539                  ; Forzar remap de atributos (sin redibujar pixeles)
  70+ E539 3E 01            LD A, 1
  71+ E53B 32 B6 82         LD (AttrsDirty), A
  72+ E53E C9               RET
  73+ E53F
  74+ E53F              .bellsFirst:
  75+ E53F                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  76+ E53F                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  77+ E53F                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  78+ E53F                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  79+ E53F                  ; que sean nocturnos (Crepuscular), no diurnos.
  80+ E53F CD 0A C0         CALL UpdateNastyTable
  81+ E542                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  82+ E542                  ; antes de medianoche natural y forzo el evento), saltamos.
  83+ E542 3A 65 82         LD A, (BellsTriggered)
  84+ E545 B7               OR A
  85+ E546 C0               RET NZ
  86+ E547 3E 01            LD A, 1
  87+ E549 32 65 82         LD (BellsTriggered), A
  88+ E54C CD 55 FA         CALL StartBellChimes
  89+ E54F C9               RET
  90+ E550
  91+ E550              ; ==============================================================================
  92+ E550              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  93+ E550              ; ==============================================================================
  94+ E550              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  95+ E550              ;   - Salta reloj a 00:00.
  96+ E550              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  97+ E550              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  98+ E550              ;     campanadas como hace el path natural). El usuario quiere que la
  99+ E550              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 100+ E550              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 101+ E550              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 102+ E550              ;     pero ya esta en N2 -> no-op visual.
 103+ E550              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 104+ E550              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 105+ E550              ;
 106+ E550              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 107+ E550              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 108+ E550              ; aqui no re-dispara nada.
 109+ E550              ; ==============================================================================
 110+ E550              TriggerChurchMidnight:
 111+ E550 3A 65 82         LD A, (BellsTriggered)
 112+ E553 B7               OR A
 113+ E554 C0               RET NZ                              ; bells ya sonaron -> no-op
 114+ E555 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 115+ E557 CD 47 ED         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 116+ E55A 3E 04            LD A, 4
 117+ E55C CD 06 E5         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 118+ E55F                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 119+ E55F                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 120+ E55F                  ; diurnos durante chimes). En este path queremos lo contrario.
 121+ E55F CD 68 E5         CALL UpdateRemapTables
 122+ E562 3E 01            LD A, 1
 123+ E564 32 B6 82         LD (AttrsDirty), A
