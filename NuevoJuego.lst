 301+ E43E              ; ==============================================================================
 302+ E43E              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E43E              ; ==============================================================================
 304+ E43E              ; Entrada: A = attr original
 305+ E43E              ; Salida:  A = attr transformado
 306+ E43E              ; Preserva: HL, DE, BC, IX
 307+ E43E              ; ==============================================================================
 308+ E43E              ApplyDayCycleRemap:
 309+ E43E E5               PUSH HL
 310+ E43F 67               LD H, A                     ; H = attr (temp save)
 311+ E440                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E440 3A D9 E2         LD A, (BgSpriteSkipRemap)
 313+ E443 B7               OR A
 314+ E444 20 06            JR NZ, .skipRemap
 315+ E446 3A D3 E2         LD A, (CurrentTimeOfDay)
 316+ E449 B7               OR A
 317+ E44A 20 03            JR NZ, .doRemap
 318+ E44C              .skipRemap:
 319+ E44C 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E44D E1               POP HL
 321+ E44E C9               RET
 322+ E44F
 323+ E44F              .doRemap:
 324+ E44F D5               PUSH DE
 325+ E450 C5               PUSH BC
 326+ E451
 327+ E451 7C               LD A, H                     ; A = attr original
 328+ E452 4F               LD C, A                     ; C = attr original
 329+ E453
 330+ E453                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E453 E6 87            AND $87                     ; A = F000_0III
 332+ E455 47               LD B, A                     ; B = flash | ink
 333+ E456
 334+ E456                  ; Extraer paper+bright como indice 0-15
 335+ E456 79               LD A, C
 336+ E457 E6 78            AND $78                     ; A = 0BPPP000
 337+ E459 0F               RRCA
 338+ E45A 0F               RRCA
 339+ E45B 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E45C
 341+ E45C                  ; Elegir tabla segun tipo de sprite
 342+ E45C 5F               LD E, A
 343+ E45D 16 00            LD D, 0
 344+ E45F 3A D8 E2         LD A, (BgSpriteIsHouse)
 345+ E462 B7               OR A
 346+ E463 28 05            JR Z, .useStdTable
 347+ E465 2A D6 E2         LD HL, (CurrentHouseRemapTable)
 348+ E468 18 03            JR .doLookup
 349+ E46A              .useStdTable:
 350+ E46A 2A D4 E2         LD HL, (CurrentRemapTable)
 351+ E46D              .doLookup:
 352+ E46D 19               ADD HL, DE
 353+ E46E 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E46F
 355+ E46F                  ; Reconstruir atributo
 356+ E46F 07               RLCA
 357+ E470 07               RLCA
 358+ E471 07               RLCA                        ; A = 0BPPP000
 359+ E472 B0               OR B                        ; A = FBPPPIII
 360+ E473
 361+ E473 C1               POP BC
 362+ E474 D1               POP DE
 363+ E475 E1               POP HL
 364+ E476 C9               RET
