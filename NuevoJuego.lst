 527+ 6639              ; ==============================================================================
 528+ 6639              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 529+ 6639              ; ==============================================================================
 530+ 6639              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 531+ 6639              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 532+ 6639              ;
 533+ 6639              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 534+ 6639              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 535+ 6639              ;     E = pixel X (0-255).
 536+ 6639              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 537+ 6639              ; Solo XOR de pixels (no toca attrs).
 538+ 6639              ; Destruye: AF, BC, DE, HL, IX.
 539+ 6639              ; ==============================================================================
 540+ 6639              DrawBgSprite16XorAtPixel:
 541+ 6639 DD 21 EE 86      LD IX, BgSpriteBuffer
 542+ 663D DD 7E 00         LD A, (IX+0)                            ; height_px
 543+ 6640 B7               OR A
 544+ 6641 C8               RET Z
 545+ 6642 32 A5 66         LD (.dbsHeight), A
 546+ 6645 DD 23            INC IX
 547+ 6647 DD 23            INC IX                                  ; -> pixel data
 548+ 6649                  ; Shift = E & 7 ; aligned X = E & ~7
 549+ 6649 7B               LD A, E
 550+ 664A E6 07            AND $07
 551+ 664C 32 A6 66         LD (.dbsShift), A
 552+ 664F 7B               LD A, E
