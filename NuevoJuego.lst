 257  F11E                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 258  F11E                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F11E              ; ==============================================================================
   2+ F11E              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F11E              ; ==============================================================================
   4+ F11E              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F11E              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F11E              ;
   7+ F11E              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F11E              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F11E              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F11E              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F11E              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F11E              ; ==============================================================================
  13+ F11E
  14+ F11E              ; ==============================================================================
  15+ F11E              ; PlaySFX - Reproduce un efecto de sonido
  16+ F11E              ; ==============================================================================
  17+ F11E              ; Entrada: HL = puntero a datos del efecto
  18+ F11E              ; Modifica: AF, BC, DE, HL
  19+ F11E              ; ==============================================================================
  20+ F11E              PlaySFX:
  21+ F11E F3               DI                          ; Sin interrupciones para audio limpio
  22+ F11F 3A 58 90         LD A, (CurrentBorderColor)
  23+ F122 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F124 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F125
  26+ F125              .nextStep:
  27+ F125 7E               LD A, (HL)                  ; Leer duration
  28+ F126 B7               OR A
  29+ F127 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F129
  31+ F129 47               LD B, A                     ; B = duration (bucle externo)
  32+ F12A 23               INC HL
  33+ F12B 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F12C 23               INC HL
  35+ F12D 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F12E 23               INC HL
  37+ F12F 7E               LD A, (HL)                  ; A = flags
  38+ F130 23               INC HL
  39+ F131 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F132 CB 47            BIT 0, A
  41+ F134 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F136
  43+ F136              ; --- Bucle de tono normal ---
  44+ F136              .toneLoop:
  45+ F136                  ; Semi-periodo HIGH
  46+ F136 7B               LD A, E
  47+ F137 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F139 D3 FE            OUT ($FE), A
  49+ F13B 79               LD A, C                     ; A = pitch actual
  50+ F13C              .toneDelayHi:
  51+ F13C 3D               DEC A
  52+ F13D 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F13F
  54+ F13F                  ; Semi-periodo LOW
  55+ F13F 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F140 D3 FE            OUT ($FE), A
  57+ F142 79               LD A, C
  58+ F143              .toneDelayLo:
  59+ F143 3D               DEC A
  60+ F144 20 FD            JR NZ, .toneDelayLo
  61+ F146
  62+ F146                  ; Aplicar pitch sweep
  63+ F146 79               LD A, C
  64+ F147 82               ADD A, D                    ; pitch += pitchDelta
  65+ F148 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F14A FA 52 F1         JP M, .toneClamp            ; evitar pitch negativo
  67+ F14D 4F               LD C, A
  68+ F14E              .toneAfterClamp:
  69+ F14E 10 E6            DJNZ .toneLoop
  70+ F150 18 30            JR .stepDone
  71+ F152
  72+ F152              .toneClamp:
  73+ F152 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F154 18 F8            JR .toneAfterClamp
  75+ F156
  76+ F156              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F156              .noiseLoop:
  78+ F156                  ; Semi-periodo HIGH con ruido
  79+ F156 7B               LD A, E
  80+ F157 F6 10            OR $10
  81+ F159 D3 FE            OUT ($FE), A
  82+ F15B ED 5F            LD A, R                     ; R register como PRNG
  83+ F15D A9               XOR C                       ; mezclar con pitch base
  84+ F15E E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F160 F6 01            OR $01                      ; minimo 1
  86+ F162              .noiseDelayHi:
  87+ F162 3D               DEC A
  88+ F163 20 FD            JR NZ, .noiseDelayHi
  89+ F165
  90+ F165                  ; Semi-periodo LOW
  91+ F165 7B               LD A, E
  92+ F166 D3 FE            OUT ($FE), A
  93+ F168 ED 5F            LD A, R
  94+ F16A A9               XOR C
  95+ F16B E6 1F            AND $1F
  96+ F16D F6 01            OR $01
  97+ F16F              .noiseDelayLo:
  98+ F16F 3D               DEC A
  99+ F170 20 FD            JR NZ, .noiseDelayLo
 100+ F172
 101+ F172                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F172 79               LD A, C
 103+ F173 82               ADD A, D
 104+ F174 28 08            JR Z, .noiseClamp
 105+ F176 FA 7E F1         JP M, .noiseClamp
 106+ F179 4F               LD C, A
 107+ F17A              .noiseAfterClamp:
 108+ F17A 10 DA            DJNZ .noiseLoop
 109+ F17C 18 04            JR .stepDone
 110+ F17E
 111+ F17E              .noiseClamp:
 112+ F17E 0E 01            LD C, 1
 113+ F180 18 F8            JR .noiseAfterClamp
 114+ F182
 115+ F182              .stepDone:
 116+ F182 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F183 18 A0            JR .nextStep
 118+ F185
 119+ F185              .done:
 120+ F185 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F186 D3 FE            OUT ($FE), A
 122+ F188 FB               EI
 123+ F189 C9               RET
 124+ F18A
