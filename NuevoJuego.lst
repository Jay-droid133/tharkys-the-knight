 511+ F08B              .dcRedrawNewScreen:
 512+ F08B                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 513+ F08B                  ; sincronicamente en CheckScreenTransition.doTransition (via
 514+ F08B                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 515+ F08B                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 516+ F08B                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 517+ F08B                  ;
 518+ F08B                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 519+ F08B                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 520+ F08B                  ; hay que volver a dibujar el sprite minimo una vez.
 521+ F08B 3E FF            LD A, $FF
 522+ F08D 32 CC 5F         LD (LastMagicCompassDrawn), A
 523+ F090                  ; fall through a .dcRedraw
 524+ F090
 525+ F090              .dcRedraw:
 526+ F090                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F090 3A BB 82         LD A, (ObjectiveScreenX)
 528+ F093 47               LD B, A
 529+ F094 3A 0B 83         LD A, (CurrentScreenX)
 530+ F097 4F               LD C, A
 531+ F098 78               LD A, B
 532+ F099 91               SUB C                               ; A = dx (signed)
 533+ F09A                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F09A F2 A4 F0         JP P, .dcDxNonNeg
 535+ F09D ED 44            NEG
 536+ F09F 67               LD H, A                             ; abs(dx)
 537+ F0A0 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F0A2 18 0A            JR .dcDxDone
 539+ F0A4              .dcDxNonNeg:
 540+ F0A4 67               LD H, A
 541+ F0A5 B7               OR A
 542+ F0A6 20 04            JR NZ, .dcDxPositive
 543+ F0A8 2E 01            LD L, 1                             ; dx == 0
 544+ F0AA 18 02            JR .dcDxDone
 545+ F0AC              .dcDxPositive:
 546+ F0AC 2E 02            LD L, 2
 547+ F0AE              .dcDxDone:
 548+ F0AE E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 549+ F0AF
 550+ F0AF                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 551+ F0AF 3A BC 82         LD A, (ObjectiveScreenY)
 552+ F0B2 47               LD B, A
 553+ F0B3 3A 0C 83         LD A, (CurrentScreenY)
 554+ F0B6 4F               LD C, A
 555+ F0B7 78               LD A, B
 556+ F0B8 91               SUB C
 557+ F0B9 F2 C3 F0         JP P, .dcDyNonNeg
 558+ F0BC ED 44            NEG
 559+ F0BE 67               LD H, A
 560+ F0BF 2E 00            LD L, 0
 561+ F0C1 18 0A            JR .dcDyDone
 562+ F0C3              .dcDyNonNeg:
 563+ F0C3 67               LD H, A
 564+ F0C4 B7               OR A
 565+ F0C5 20 04            JR NZ, .dcDyPositive
 566+ F0C7 2E 01            LD L, 1
 567+ F0C9 18 02            JR .dcDyDone
 568+ F0CB              .dcDyPositive:
 569+ F0CB 2E 02            LD L, 2
 570+ F0CD              .dcDyDone:
 571+ F0CD                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 572+ F0CD D1               POP DE                              ; D = abs_dx, E = signdx+1
 573+ F0CE                  ; idx = (signdy+1)*3 + (signdx+1)
 574+ F0CE 7D               LD A, L
 575+ F0CF 87               ADD A, A
 576+ F0D0 85               ADD A, L                            ; A = (signdy+1)*3
 577+ F0D1 83               ADD A, E                            ; A = idx (0..8)
 578+ F0D2 32 C9 F1         LD (.dcSpriteIdx), A
