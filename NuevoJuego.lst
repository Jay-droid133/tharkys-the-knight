2078+ AA83              ; ==============================================================================
2079+ AA83              ; SISTEMA DE ENEMIGOS
2080+ AA83              ; ==============================================================================
2081+ AA83
2082+ AA83              ; ==============================================================================
2083+ AA83              ; UpdateEnemy - AI patrol + bounce (estilo Sabre Wulf)
2084+ AA83              ; ==============================================================================
2085+ AA83              ; Cada frame: posicion += delta. Si choca con borde o fondo, invierte delta.
2086+ AA83              ; Animacion: cicla SpriteID dentro del rango del tipo.
2087+ AA83              ; IX = puntero a la entidad enemiga.
2088+ AA83              ; ==============================================================================
2089+ AA83              ; ==============================================================================
2090+ AA83              ; CheckPredatorAttack - Comprueba si nasty debe lanzarse como depredador
2091+ AA83              ; ==============================================================================
2092+ AA83              ; IX = nasty en STATE_RUNNING. Si alineado con player y es depredador
2093+ AA83              ; activo en el ciclo actual, transiciona a STATE_ATTACKING.
2094+ AA83              ; ==============================================================================
2095+ AA83              ; ==============================================================================
2096+ AA83              ; UpdateStamina - Consume stamina al atacar, regenera al no atacar
2097+ AA83              ; ==============================================================================
2098+ AA83              UpdateStamina:
2099+ AA83                  ; --- Regenerar salud (1 unidad cada HEALTH_REGEN_RATE = 100 f = 4 s) ---
2100+ AA83 3A 86 B3         LD A, (PlayerHealth)
2101+ AA86 FE 10            CP HEALTH_MAX
2102+ AA88 28 12            JR Z, .usHealthFull
2103+ AA8A 21 8A B3         LD HL, HealthRegenCtr
2104+ AA8D 34               INC (HL)
2105+ AA8E 7E               LD A, (HL)
2106+ AA8F FE 64            CP HEALTH_REGEN_RATE
2107+ AA91 38 09            JR C, .usHealthFull
2108+ AA93 36 00            LD (HL), 0
2109+ AA95 3A 86 B3         LD A, (PlayerHealth)
2110+ AA98 3C               INC A
2111+ AA99 32 86 B3         LD (PlayerHealth), A
2112+ AA9C              .usHealthFull:
2113+ AA9C                  ; --- Stamina: consumir o regenerar ---
2114+ AA9C DD 7E 02         LD A, (IX+ENT_STATE)
2115+ AA9F FE 02            CP STATE_FIGHTING
2116+ AAA1 28 18            JR Z, .usDrain
2117+ AAA3                  ; --- Regenerar stamina (1 unidad cada STAMINA_REGEN_RATE = 50 f = 2 s) ---
2118+ AAA3 3A 87 B3         LD A, (PlayerStamina)
2119+ AAA6 FE 10            CP STAMINA_MAX
2120+ AAA8 C8               RET Z                               ; Ya al maximo
2121+ AAA9 21 89 B3         LD HL, StaminaRegenCtr
2122+ AAAC 34               INC (HL)
2123+ AAAD 7E               LD A, (HL)
2124+ AAAE FE 32            CP STAMINA_REGEN_RATE
2125+ AAB0 D8               RET C                               ; Aun no toca
2126+ AAB1 36 00            LD (HL), 0                          ; Reset counter
2127+ AAB3 3A 87 B3         LD A, (PlayerStamina)
2128+ AAB6 3C               INC A
2129+ AAB7 32 87 B3         LD (PlayerStamina), A
2130+ AABA C9               RET
2131+ AABB              .usDrain:
2132+ AABB                  ; Atacando: consumir stamina
2133+ AABB                  ; ESPADA buff activo -> no consume stamina (gate).
2134+ AABB 3A DA 5F         LD A, (EspadaTimer)
2135+ AABE 21 DB 5F         LD HL, EspadaTimer + 1
2136+ AAC1 B6               OR (HL)
2137+ AAC2 C0               RET NZ                              ; Espada activa: skip drain
2138+ AAC3 3A 87 B3         LD A, (PlayerStamina)
2139+ AAC6 B7               OR A
2140+ AAC7 C8               RET Z                               ; Ya vacia
2141+ AAC8 21 88 B3         LD HL, StaminaDrainCtr
2142+ AACB 34               INC (HL)
2143+ AACC 7E               LD A, (HL)
2144+ AACD FE 0D            CP STAMINA_DRAIN_RATE
2145+ AACF D8               RET C
2146+ AAD0 36 00            LD (HL), 0
2147+ AAD2 3A 87 B3         LD A, (PlayerStamina)
2148+ AAD5 3D               DEC A
2149+ AAD6 32 87 B3         LD (PlayerStamina), A
2150+ AAD9                  ; Si stamina llega a 0, dar 1 punto tras cooldown
2151+ AAD9 B7               OR A
2152+ AADA C0               RET NZ
2153+ AADB 3E 01            LD A, 1
2154+ AADD 32 87 B3         LD (PlayerStamina), A               ; Minimo 1 para un swing
2155+ AAE0 C9               RET
2156+ AAE1
2157+ AAE1              ; ==============================================================================
2158+ AAE1              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2159+ AAE1              ; ==============================================================================
2160+ AAE1              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2161+ AAE1              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2162+ AAE1              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2163+ AAE1              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2164+ AAE1              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2165+ AAE1              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2166+ AAE1              ; ==============================================================================
2167+ AAE1              SelectSwordMode:
2168+ AAE1                  ; ESPADA buff: fuerza mode 2 (libre) sin importar stamina (ataque a 0 OK).
2169+ AAE1 3A DA 5F         LD A, (EspadaTimer)
2170+ AAE4 21 DB 5F         LD HL, EspadaTimer + 1
2171+ AAE7 B6               OR (HL)
2172+ AAE8 28 04            JR Z, .smCheckStamina
2173+ AAEA 3E 02            LD A, 2                             ; ESPADA: siempre libre
2174+ AAEC 18 14            JR .smSet
2175+ AAEE              .smCheckStamina:
2176+ AAEE 3A 87 B3         LD A, (PlayerStamina)
2177+ AAF1 FE 0C            CP STAMINA_THRESHOLD_HIGH
2178+ AAF3 38 04            JR C, .smNotHigh
2179+ AAF5 3E 02            LD A, 2                             ; Libre (continuo)
2180+ AAF7 18 09            JR .smSet
2181+ AAF9              .smNotHigh:
2182+ AAF9 FE 07            CP STAMINA_THRESHOLD_MID
2183+ AAFB 38 04            JR C, .smNotMid
2184+ AAFD 3E 01            LD A, 1                             ; Fixed swing
2185+ AAFF 18 01            JR .smSet
2186+ AB01              .smNotMid:
