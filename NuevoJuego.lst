5492+ BD4F              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5493+ BD4F              NastyColorTable:
5494+ BD4F 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5495+ BD50 42               DEFB RED | $40              ; Enemy 1: Scorpion - rojo
5496+ BD51 43               DEFB MAGENTA | $40          ; Enemy 2: Bat - magenta
5497+ BD52 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5498+ BD53 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5499+ BD54 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5500+ BD55 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5501+ BD56 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
