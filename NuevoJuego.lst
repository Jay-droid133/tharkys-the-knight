  19+ 91CC              ; MaiComputeFlowField
  20+ 91CC              ; ==============================================================================
  21+ 91CC              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 91CC              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 91CC              ; quedan en $FF).
  24+ 91CC              ;
  25+ 91CC              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 91CC              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 91CC              ;
  28+ 91CC              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 91CC              ; Output: FlowField relleno en bank 6
  30+ 91CC              ; Destruye: AF, BC, DE, HL
