 510+ E7E0 FE 78            CP TGCS_ARCH_PX_TOP
 511+ E7E2 38 11            JR C, .tgPhExitCheckBottom          ; aun por encima del arco
 512+ E7E4 3A AA 5F         LD A, (TownGateEndDrawn)
 513+ E7E7 B7               OR A
 514+ E7E8 20 0B            JR NZ, .tgPhExitCheckBottom         ; ya pintado este episodio
 515+ E7EA CD 5F E9         CALL TownGateDrawTheEnd
 516+ E7ED CD FB E9         CALL SFX_TownGate_OnTheEnd
 517+ E7F0 3E 01            LD A, 1
 518+ E7F2 32 AA 5F         LD (TownGateEndDrawn), A
 519+ E7F5              .tgPhExitCheckBottom:
 520+ E7F5                  ; --- El slide continua hasta que POSY alcanza el bottom off-screen ---
 521+ E7F5 3A A7 81         LD A, (EntityTable + ENT_POSY)
 522+ E7F8 FE C0            CP TGCS_PLAYER_BOTTOM_Y
 523+ E7FA D8               RET C                               ; aun deslizandose
 524+ E7FB                  ; Player completamente off-screen: transicion a END_HOLD.
 525+ E7FB 3E 96            LD A, TGCS_T_END_HOLD
 526+ E7FD 32 A5 5F         LD (TownGateTimer), A
 527+ E800 3E 0D            LD A, TGP_END_HOLD
 528+ E802 32 D0 82         LD (TownGatePhase), A
 529+ E805 C9               RET
