4795+ BD61              ; --- Tabla de tipos de nasty (SpriteID base) ---
4796+ BD61              ; --- Tablas de nasties por momento del dia ---
4797+ BD61              NUM_NASTY_TYPES EQU 4
4798+ BD61              DiurnalTypeTable:                       ; DY, C1, A2
4799+ BD61 30               DEFB SPRID_ENEMY_4          ; Eagle
4800+ BD62 20               DEFB SPRID_ENEMY_0          ; Spider
4801+ BD63 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
4802+ BD64 2C               DEFB SPRID_ENEMY_3          ; Snake
4803+ BD65              CrepuscularTypeTable:                   ; C2, N1
4804+ BD65 34               DEFB SPRID_ENEMY_5          ; Rat
4805+ BD66 28               DEFB SPRID_ENEMY_2          ; Bat
4806+ BD67 24               DEFB SPRID_ENEMY_1          ; Scorpion
4807+ BD68 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
4808+ BD69
4809+ BD69              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
4810+ BD69              NastyColorTable:
4811+ BD69 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
4812+ BD6A 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
4813+ BD6B 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
4814+ BD6C 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
4815+ BD6D 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
4816+ BD6E 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
4817+ BD6F 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
4818+ BD70 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
4819+ BD71
4820+ BD71              ; --- Tabla de comportamiento depredador ---
4821+ BD71              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
4822+ BD71              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
4823+ BD71              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
4824+ BD71              PredatorTable:
4825+ BD71 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
4826+ BD72 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
4827+ BD73 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
4828+ BD74 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
4829+ BD75 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
4830+ BD76 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
4831+ BD77 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
4832+ BD78 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
4833+ BD79
4834+ BD79              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
4835+ BD79              PredatorSpeedTable:
4836+ BD79 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
4837+ BD7A 02               DEFB 2                              ; Ciclo 1: lento
4838+ BD7B 03               DEFB 3                              ; Ciclo 2: intermedio
4839+ BD7C 04               DEFB 4                              ; Ciclo 3+: rapido
4840+ BD7D
4841+ BD7D 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
4842+ BD7E
4843+ BD7E 61 BD        CurrentNastyTable: DEFW DiurnalTypeTable
4844+ BD80
4845+ BD80              ; ==============================================================================
4846+ BD80              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
4847+ BD80              ; ==============================================================================
4848+ BD80              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
4849+ BD80              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
4850+ BD80              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
4851+ BD80              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
4852+ BD80              ;   pantalla, no diurnos.
4853+ BD80              ; ==============================================================================
4854+ BD80              UpdateNastyTable:
4855+ BD80 3A 84 DD         LD A, (CurrentTimeOfDay)
4856+ BD83 FE 02            CP 2
4857+ BD85 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
4858+ BD87 FE 06            CP 6
4859+ BD89 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
4860+ BD8B 21 65 BD         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
4861+ BD8E 18 03            JR .setTable
4862+ BD90              .diurnal:
4863+ BD90 21 61 BD         LD HL, DiurnalTypeTable
4864+ BD93              .setTable:
4865+ BD93 22 7E BD         LD (CurrentNastyTable), HL
4866+ BD96 C9               RET
4867+ BD97
4868+ BD97              ; ==============================================================================
4869+ BD97              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
4870+ BD97              ; ==============================================================================
4871+ BD97              ScareAllMonsters:
4872+ BD97 AF               XOR A
4873+ BD98 32 16 B6         LD (MonstersActive), A              ; No respawnear mas
4874+ BD9B                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
4875+ BD9B                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
4876+ BD9B                  ; del amanecer capturara el orig POSX/POSY del primer frame.
4877+ BD9B 21 68 90         LD HL, MonsterAiFlags
4878+ BD9E 06 03            LD B, 3
4879+ BDA0              .samClearLoop:
4880+ BDA0 7E               LD A, (HL)
4881+ BDA1 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
4882+ BDA3 77               LD (HL), A
4883+ BDA4 23               INC HL
4884+ BDA5 10 F9            DJNZ .samClearLoop
4885+ BDA7 3E 7D            LD A, SCARE_TIMER_DAWN
4886+ BDA9 32 AC B8         LD (ScareTimer), A
4887+ BDAC                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
4888+ BDAC                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
4889+ BDAC                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
4890+ BDAC                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
4891+ BDAC DD 21 EC 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4892+ BDB0 06 06            LD B, NUM_MONSTERS
4893+ BDB2              .samStateLoop:
4894+ BDB2 DD 7E 01         LD A, (IX+ENT_TYPE)
4895+ BDB5 FE 02            CP TYPE_MONSTER
4896+ BDB7 20 1B            JR NZ, .samStateNext
4897+ BDB9 DD 7E 02         LD A, (IX+ENT_STATE)
4898+ BDBC FE 03            CP STATE_DYING
4899+ BDBE 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
4900+ BDC0 FE 04            CP STATE_SPAWNING
4901+ BDC2 28 10            JR Z, .samStateNext
4902+ BDC4 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
4903+ BDC8 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
4904+ BDCC DD 36 06 00      LD (IX+ENT_DELTAX), 0
4905+ BDD0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4906+ BDD4              .samStateNext:
4907+ BDD4 11 10 00         LD DE, ENT_SIZE
4908+ BDD7 DD 19            ADD IX, DE
4909+ BDD9 10 D7            DJNZ .samStateLoop
4910+ BDDB C9               RET
4911+ BDDC
4912+ BDDC              ; ==============================================================================
4913+ BDDC              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
4914+ BDDC              ; ==============================================================================
4915+ BDDC              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
4916+ BDDC              ; ==============================================================================
4917+ BDDC
4918+ BDDC              ; ==============================================================================
4919+ BDDC              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
4920+ BDDC              ; ==============================================================================
4921+ BDDC              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
4922+ BDDC              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
4923+ BDDC              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4924+ BDDC              ; ==============================================================================
4925+ BDDC              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
4926+ BDDC              ; ==============================================================================
4927+ BDDC              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
4928+ BDDC              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
4929+ BDDC              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4930+ BDDC              ; ==============================================================================
4931+ BDDC              MONSTERS_TO_SPAWN   EQU 3
4932+ BDDC              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
4933+ BDDC              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
4934+ BDDC
4935+ BDDC              ; ==============================================================================
4936+ BDDC              ; SpawnMonsters - Primera aparicion tras campanadas
4937+ BDDC              ; ==============================================================================
4938+ BDDC              SpawnMonsters:
4939+ BDDC 3A 16 B6         LD A, (MonstersActive)
4940+ BDDF B7               OR A
4941+ BDE0 C0               RET NZ
4942+ BDE1                  ; Matar nasties activos antes de poblar slots de monster: liberar el
4943+ BDE1                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
4944+ BDE1 CD DB BC         CALL KillAllActiveNasties
4945+ BDE4 3E 01            LD A, 1
4946+ BDE6 32 16 B6         LD (MonstersActive), A
4947+ BDE9 CD 66 BE         CALL ShuffleMonsterTypes
4948+ BDEC DD 21 EC 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4949+ BDF0 06 03            LD B, MONSTERS_TO_SPAWN
4950+ BDF2 0E 00            LD C, 0
4951+ BDF4              .smLoop:
4952+ BDF4 C5               PUSH BC
4953+ BDF5 DD 7E 01         LD A, (IX+ENT_TYPE)
4954+ BDF8 B7               OR A
4955+ BDF9 C2 55 BE         JP NZ, .smSkip
4956+ BDFC                  ; Asignar tipo y color
4957+ BDFC 79               LD A, C
4958+ BDFD 21 CA BE         LD HL, MonsterTypeTable
4959+ BE00 5F               LD E, A
4960+ BE01 16 00            LD D, 0
4961+ BE03 19               ADD HL, DE
4962+ BE04 7E               LD A, (HL)
4963+ BE05 DD 77 08         LD (IX+ENT_ANIMBASE), A
4964+ BE08 79               LD A, C
4965+ BE09 21 CD BE         LD HL, MonsterColorTable
4966+ BE0C 5F               LD E, A
4967+ BE0D 16 00            LD D, 0
4968+ BE0F 19               ADD HL, DE
4969+ BE10 7E               LD A, (HL)
4970+ BE11 DD 77 05         LD (IX+ENT_ATTR), A
4971+ BE14                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
4972+ BE14 C5               PUSH BC
4973+ BE15 CD B6 93         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
4974+ BE18 B7               OR A
4975+ BE19 20 0E            JR NZ, .smFallbackPos
4976+ BE1B 3A 73 9C         LD A, (MaiSpawnX)
4977+ BE1E DD 77 03         LD (IX+ENT_POSX), A
4978+ BE21 3A 74 9C         LD A, (MaiSpawnY)
4979+ BE24 DD 77 04         LD (IX+ENT_POSY), A
4980+ BE27 18 0C            JR .smPosDone
4981+ BE29              .smFallbackPos:
4982+ BE29 3A 23 82         LD A, (LastEntryPosX)
4983+ BE2C DD 77 03         LD (IX+ENT_POSX), A
4984+ BE2F 3A 24 82         LD A, (LastEntryPosY)
4985+ BE32 DD 77 04         LD (IX+ENT_POSY), A
4986+ BE35              .smPosDone:
4987+ BE35 C1               POP BC
4988+ BE36                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
4989+ BE36 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4990+ BE3A DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
4991+ BE3E DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
4992+ BE42 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4993+ BE46 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4994+ BE4A                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
4995+ BE4A                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
4996+ BE4A                  ; lo empuje a un vecino (migracion por knockback).
4997+ BE4A CD AB 92         CALL MaiGetCurrentScreenId
4998+ BE4D 21 5C 90         LD HL, MonsterRoomId
4999+ BE50 59               LD E, C
5000+ BE51 16 00            LD D, 0
5001+ BE53 19               ADD HL, DE
5002+ BE54 77               LD (HL), A
5003+ BE55              .smSkip:
5004+ BE55 11 10 00         LD DE, ENT_SIZE
5005+ BE58 DD 19            ADD IX, DE
5006+ BE5A C1               POP BC
5007+ BE5B 0C               INC C
5008+ BE5C 05               DEC B
5009+ BE5D C2 F4 BD         JP NZ, .smLoop
5010+ BE60 3E 14            LD A, MONSTER_ENTRY_BASE
5011+ BE62 32 AD BF         LD (TryRespawnMonsters.rmTimer), A
5012+ BE65 C9               RET
5013+ BE66
5014+ BE66              ; --- Barajar tablas tipo/color ---
5015+ BE66              ShuffleMonsterTypes:
5016+ BE66 ED 5F            LD A, R
