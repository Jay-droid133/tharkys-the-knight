   1+ E58C              ; ==============================================================================
   2+ E58C              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ E58C              ; ==============================================================================
   4+ E58C              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ E58C              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ E58C              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ E58C              ;
   8+ E58C              ; Esquema de fases:
   9+ E58C              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ E58C              ;   2 ARM_IN       arm aparece, pausa
  11+ E58C              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ E58C              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ E58C              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ E58C              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ E58C              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ E58C              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ E58C              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ E58C              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ E58C              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ E58C              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ E58C              ;  13 END_HOLD     "The End" sprite hold
  22+ E58C              ;  14 BLACK        wipe a negro + hold
  23+ E58C              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ E58C              ;
  25+ E58C              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ E58C              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ E58C              ; ==============================================================================
  28+ E58C
  29+ E58C              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ E58C              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ E58C              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ E58C              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ E58C              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ E58C              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ E58C              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ E58C              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ E58C              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ E58C              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ E58C              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ E58C
  41+ E58C              ; --- Posiciones (pixel) ---
  42+ E58C              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ E58C              TGCS_ANCHOR1_Y         EQU 80
  44+ E58C              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ E58C              TGCS_END_CHARY         EQU 4
  46+ E58C              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ E58C
  48+ E58C              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ E58C              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ E58C              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ E58C              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ E58C              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ E58C              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ E58C              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ E58C              TGCS_ARM_PX_X          EQU 136
  56+ E58C              TGCS_ARM_PX_Y          EQU 64
  57+ E58C              TGCS_FINGER_PX_X       EQU 136
  58+ E58C              TGCS_FINGER_PX_Y       EQU 56
  59+ E58C
  60+ E58C              ; --- Phase enum ---
  61+ E58C              TGP_IDLE               EQU 0
  62+ E58C              TGP_LOCK               EQU 1
  63+ E58C              TGP_ARM_IN             EQU 2
  64+ E58C              TGP_FINGER_IN          EQU 3
  65+ E58C              TGP_SHAKE              EQU 4
  66+ E58C              TGP_FINGER_PULSE       EQU 5
  67+ E58C              TGP_FINGER_OUT         EQU 6
  68+ E58C              TGP_ARM_HOLD           EQU 7
  69+ E58C              TGP_ARM_OUT            EQU 8
  70+ E58C              TGP_PLAYER_TURN        EQU 9
  71+ E58C              TGP_PLAYER_HIDE        EQU 10
  72+ E58C              TGP_PLAYER_FRAMED      EQU 11
  73+ E58C              TGP_PLAYER_EXIT        EQU 12
  74+ E58C              TGP_END_HOLD           EQU 13
  75+ E58C              TGP_BLACK              EQU 14
  76+ E58C              TGP_CREDITS            EQU 15
  77+ E58C              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ E58C              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ E58C
  80+ E58C              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ E58C                                                ; check dinamico de "todos los nasties dead".
  82+ E58C                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ E58C                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ E58C                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ E58C
  86+ E58C              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ E58C              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ E58C              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ E58C              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ E58C
  91+ E58C              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ E58C              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ E58C              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ E58C              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ E58C              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ E58C              ;
  97+ E58C              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ E58C              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ E58C              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ E58C              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ E58C              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ E58C              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ E58C              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 104+ E58C
 105+ E58C              ; --- Posicion de la puerta (closed v2 + open) en char ---
 106+ E58C              ; El closed v2 (id 246) vive en PickupTable a (14, 17). El open (id 250)
 107+ E58C              ; comparte posicion y tamano (4x5 chars). Cuando el cutscene erase el closed,
 108+ E58C              ; dibuja el open in-place via DrawBgGfxSprite.
 109+ E58C              TGCS_DOOR_CHARX        EQU 14
 110+ E58C              TGCS_DOOR_CHARY        EQU 17
 111+ E58C              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
 112+ E58C              TGCS_ARCH_ROOM_X       EQU 7
 113+ E58C              TGCS_ARCH_ROOM_Y       EQU 15
 114+ E58C              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
 115+ E58C
 116+ E58C              ; ==============================================================================
 117+ E58C              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ E58C              ; ==============================================================================
 119+ E58C              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ E58C              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ E58C              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ E58C              ;
 123+ E58C              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ E58C              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ E58C              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ E58C              ; Destruye: AF, BC, DE, HL, IX.
 127+ E58C              ; ==============================================================================
 128+ E58C              CheckTownGateTriggerBgBody:
 129+ E58C 3A C1 82         LD A, (TownGatePhase)
 130+ E58F B7               OR A
 131+ E590 C0               RET NZ                              ; ya en cutscene
 132+ E591 3A A7 82         LD A, (CurrentKey)
 133+ E594 FE 06            CP TGCS_ARCH_KEY_ID
 134+ E596 C0               RET NZ                              ; sin la key correcta
 135+ E597 3A 01 83         LD A, (CurrentScreenX)
 136+ E59A FE 07            CP TGCS_ARCH_ROOM_X
 137+ E59C C0               RET NZ
 138+ E59D 3A 02 83         LD A, (CurrentScreenY)
 139+ E5A0 FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ E5A2 C0               RET NZ
 141+ E5A3                  ; --- Horizontal AABB ---
 142+ E5A3 3A 97 81         LD A, (EntityTable + ENT_POSX)
 143+ E5A6 4F               LD C, A                             ; C = player_left
 144+ E5A7 C6 10            ADD A, 16
 145+ E5A9 57               LD D, A                             ; D = player_right
 146+ E5AA 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ E5AC D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ E5AE 30 01            JR NC, .ctgtNoUnderL
 149+ E5B0 AF               XOR A
 150+ E5B1              .ctgtNoUnderL:
 151+ E5B1 BA               CP D
 152+ E5B2 D0               RET NC                              ; ext_left >= player_right
 153+ E5B3 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ E5B5 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ E5B7 30 02            JR NC, .ctgtNoOverR
 156+ E5B9 3E FF            LD A, $FF
 157+ E5BB              .ctgtNoOverR:
 158+ E5BB B9               CP C
 159+ E5BC D8               RET C                               ; ext_right < player_left
 160+ E5BD                  ; --- Vertical AABB ---
 161+ E5BD                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ E5BD                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ E5BD                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ E5BD                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ E5BD                  ; con la altura real del rect.
 166+ E5BD 3A 98 81         LD A, (EntityTable + ENT_POSY)
 167+ E5C0 4F               LD C, A                             ; C = player_top
 168+ E5C1 C6 15            ADD A, 21
 169+ E5C3 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ E5C4 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ E5C6 D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ E5C8 30 01            JR NC, .ctgtNoUnderT
 173+ E5CA AF               XOR A
 174+ E5CB              .ctgtNoUnderT:
 175+ E5CB BA               CP D
 176+ E5CC D0               RET NC
 177+ E5CD 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ E5CF C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ E5D1 30 02            JR NC, .ctgtNoOverB
 180+ E5D3 3E FF            LD A, $FF
 181+ E5D5              .ctgtNoOverB:
 182+ E5D5 B9               CP C
 183+ E5D6 D8               RET C
 184+ E5D7                  ; HIT
 185+ E5D7 CD DF E5         CALL StartTownGateCutscene
 186+ E5DA 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ E5DC C3 35 6D         JP CheckMilestoneTrigger_B7            ; tail call
