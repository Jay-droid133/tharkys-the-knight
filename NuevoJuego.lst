 337+ 6F2E                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 338+ 6F2E 3E FE            LD A, $FE
 339+ 6F30 32 B4 5F         LD (RandomSynthMapX), A
 340+ 6F33 AF               XOR A
 341+ 6F34 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
