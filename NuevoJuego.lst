 348+ 743D              .pmcaDirToOffset:
 349+ 743D 01               DEFB $01                             ; 0 (N) → col 2 row 1 → +1
 350+ 743E 20               DEFB $20                             ; 1 (S) → col 1 row 2 → +$20
 351+ 743F 00               DEFB $00                             ; 2 (W) → col 1 row 1 → +0
 352+ 7440 21               DEFB $21                             ; 3 (E) → col 2 row 2 → +$21
