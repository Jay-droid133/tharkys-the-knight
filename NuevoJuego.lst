  70+ EF63              ; ==============================================================================
  71+ EF63              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  72+ EF63              ; ==============================================================================
  73+ EF63              ; IN:  A = key id (1..6) recien recogida
  74+ EF63              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  75+ EF63              ; ==============================================================================
  76+ EF63              CheckMilestonePickup:
  77+ EF63 E5               PUSH HL
  78+ EF64 D5               PUSH DE
  79+ EF65 C5               PUSH BC
  80+ EF66 F5               PUSH AF
  81+ EF67 47               LD B, A                             ; B = key id recibida
  82+ EF68 3A BC 82         LD A, (CurrentObjective)
  83+ EF6B FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  84+ EF6D 30 27            JR NC, .cmpDone                     ; sin hitos pendientes
  85+ EF6F 87               ADD A, A                            ; *2 (entry size)
  86+ EF70 6F               LD L, A
  87+ EF71 26 00            LD H, 0
  88+ EF73 11 37 EF         LD DE, MilestoneTable
  89+ EF76 19               ADD HL, DE
  90+ EF77 7E               LD A, (HL)                          ; tipo
  91+ EF78 FE 01            CP MILESTONE_TYPE_PICKUP
  92+ EF7A 20 1A            JR NZ, .cmpDone
  93+ EF7C 23               INC HL
  94+ EF7D 7E               LD A, (HL)                          ; ref esperada
  95+ EF7E B8               CP B
  96+ EF7F 20 15            JR NZ, .cmpDone
  97+ EF81 3A BC 82         LD A, (CurrentObjective)
  98+ EF84 3C               INC A
  99+ EF85 32 BC 82         LD (CurrentObjective), A
 100+ EF88 CD 29 F0         CALL ResolveObjectiveScreen
