4132+ B5C5 DD 96 08         SUB (IX+ENT_ANIMBASE)           ; offset dentro de puff
4133+ B5C8 FE 06            CP ANIM_FRAMES_PUFF             ; >= 6 → animacion terminada
4134+ B5CA 38 09            JR C, .dyFrameOk
4135+ B5CC                  ; Animacion puff terminada: desactivar entidad
4136+ B5CC                  ; (el erase del ultimo frame ya se hizo en ProcessOneEnemy.peDying)
4137+ B5CC DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4138+ B5D0 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
4139+ B5D4 C9               RET
