 398+ 9386              ; ==============================================================================
 399+ 9386              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 9386              ; ==============================================================================
 401+ 9386              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 9386              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 9386              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 9386              ; al room vecino.
 405+ 9386              ;
 406+ 9386              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 9386              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 9386              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 9386              ;
 410+ 9386              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 9386              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 9386              ; ==============================================================================
 413+ 9386              WipeMonsterSlot:
 414+ 9386 DD E5            PUSH IX
 415+ 9388 E1               POP HL
 416+ 9389 11 24 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 938C B7               OR A
 418+ 938D ED 52            SBC HL, DE
 419+ 938F CB 3D            SRL L
 420+ 9391 CB 3D            SRL L
 421+ 9393 CB 3D            SRL L
 422+ 9395 CB 3D            SRL L                               ; HL = slot * 1
 423+ 9397 5D               LD E, L
 424+ 9398 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 939A
 426+ 939A 21 A0 90         LD HL, MonsterAiFlags
 427+ 939D 19               ADD HL, DE
 428+ 939E 36 00            LD (HL), 0
 429+ 93A0 21 94 90         LD HL, MonsterRoomId
 430+ 93A3 19               ADD HL, DE
 431+ 93A4 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 93A6 21 9A 90         LD HL, MonsterEntryBorder
 433+ 93A9 19               ADD HL, DE
 434+ 93AA 36 00            LD (HL), 0
 435+ 93AC 21 9D 90         LD HL, MonsterExitCoord
 436+ 93AF 19               ADD HL, DE
 437+ 93B0 36 00            LD (HL), 0
 438+ 93B2 21 A0 B5         LD HL, MonsterReturnTimer
 439+ 93B5 19               ADD HL, DE
 440+ 93B6 36 00            LD (HL), 0
 441+ 93B8 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 93BB 19               ADD HL, DE
 443+ 93BC 36 00            LD (HL), 0
 444+ 93BE 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 93C1 19               ADD HL, DE
 446+ 93C2 36 00            LD (HL), 0
 447+ 93C4 C9               RET
