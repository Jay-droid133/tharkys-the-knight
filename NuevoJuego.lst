2686+ ADA7              .eDeltaYNeg:
2687+ ADA7 78               LD A, B
2688+ ADA8 81               ADD A, C
2689+ ADA9 38 04            JR C, .eCheckMinY
2690+ ADAB 3E 10            LD A, SCREEN_MIN_Y
2691+ ADAD 18 16            JR .eReverseY
2692+ ADAF              .eCheckMinY:
2693+ ADAF FE 10            CP SCREEN_MIN_Y
2694+ ADB1 30 04            JR NC, .eClampYOk
2695+ ADB3 3E 10            LD A, SCREEN_MIN_Y
