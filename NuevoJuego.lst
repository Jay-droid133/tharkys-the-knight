5481+ C066
5482+ C066              ; ==============================================================================
5483+ C066              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5484+ C066              ; ==============================================================================
5485+ C066              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5486+ C066              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5487+ C066              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5488+ C066              ; ==============================================================================
5489+ C066              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5490+ C066              ; ==============================================================================
5491+ C066              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5492+ C066              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5493+ C066              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5494+ C066              ; ==============================================================================
5495+ C066              MONSTERS_TO_SPAWN   EQU 3
5496+ C066              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5497+ C066              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5498+ C066
5499+ C066              ; ==============================================================================
5500+ C066              ; SpawnMonsters - Primera aparicion tras campanadas
5501+ C066              ; ==============================================================================
5502+ C066              SpawnMonsters:
5503+ C066                  IF DEBUG_NO_ENEMIES
5504+ C066 C9               RET
5505+ C067                  ENDIF
5506+ C067 3A 71 B6         LD A, (MonstersActive)
5507+ C06A B7               OR A
5508+ C06B C0               RET NZ
5509+ C06C                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5510+ C06C                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5511+ C06C CD 47 BD         CALL KillAllActiveNasties
5512+ C06F 3E 01            LD A, 1
5513+ C071 32 71 B6         LD (MonstersActive), A
5514+ C074 CD F1 C0         CALL ShuffleMonsterTypes
5515+ C077 DD 21 5B 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5516+ C07B 06 03            LD B, MONSTERS_TO_SPAWN
5517+ C07D 0E 00            LD C, 0
5518+ C07F              .smLoop:
5519+ C07F C5               PUSH BC
5520+ C080 DD 7E 01         LD A, (IX+ENT_TYPE)
5521+ C083 B7               OR A
5522+ C084 C2 E0 C0         JP NZ, .smSkip
