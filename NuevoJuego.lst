  82+ 9D72 47               LD B, A                     ; B = Y
  83+ 9D73 3E 10            LD A, SCREEN_MIN_Y
  84+ 9D75 90               SUB B                       ; A = filas a saltar
  85+ 9D76 47               LD B, A                     ; B = skip rows
