5332+ C074 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N                  ; sentinel (!=0 para skip spawn anim)
5333+ C078 AF               XOR A
5334+ C079 32 AD BF         LD (.rmTimer), A
5335+ C07C                  ; Memoria de ubicacion: el monster ha vuelto al room actual (Regla 4).
5336+ C07C                  ; Actualizar MonsterRoomId[slot] = current para que TryRespawnMonsters
5337+ C07C                  ; lo active en este room. slot = HL - MonsterReturnTimer.
5338+ C07C E5               PUSH HL
5339+ C07D C5               PUSH BC
5340+ C07E 11 17 B6         LD DE, MonsterReturnTimer
5341+ C081 B7               OR A
5342+ C082 ED 52            SBC HL, DE                              ; HL = slot (0/1/2)
5343+ C084 5D               LD E, L
5344+ C085 16 00            LD D, 0
5345+ C087 CD AB 92         CALL MaiGetCurrentScreenId              ; A = current id, preserva DE
5346+ C08A 21 5C 90         LD HL, MonsterRoomId
5347+ C08D 19               ADD HL, DE
5348+ C08E 77               LD (HL), A
