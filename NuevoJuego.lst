 448+ 7E8A 1E 0C            LD E, 12
 449+ 7E8C CD BB 7D         CALL AY_WriteRegSlot1           ; R8 = vol A
 450+ 7E8F E1               POP HL
 451+ 7E90 5D               LD E, L
 452+ 7E91 3E 00            LD A, 0
 453+ 7E93 CD BB 7D         CALL AY_WriteRegSlot1           ; R0
 454+ 7E96 2A AA 7B         LD HL, (MusicPeriodA)
 455+ 7E99 5C               LD E, H
 456+ 7E9A 3E 01            LD A, 1
 457+ 7E9C CD BB 7D         CALL AY_WriteRegSlot1           ; R1
 458+ 7E9F              .map2DoC:
 459+ 7E9F                  ; --- Aplicar canal C: igual logica con R4/R5 + R10 ---
 460+ 7E9F 2A AE 7B         LD HL, (MusicPeriodC)
 461+ 7EA2 7C               LD A, H
 462+ 7EA3 B5               OR L
 463+ 7EA4 20 07            JR NZ, .map2NoteC
 464+ 7EA6 3E 0A            LD A, 10
 465+ 7EA8 1E 00            LD E, 0
 466+ 7EAA C3 BB 7D         JP AY_WriteRegSlot1             ; tail-call: mute C
 467+ 7EAD              .map2NoteC:
 468+ 7EAD E5               PUSH HL
 469+ 7EAE 3E 0A            LD A, 10
 470+ 7EB0 1E 0C            LD E, 12
 471+ 7EB2 CD BB 7D         CALL AY_WriteRegSlot1           ; R10 = vol C
 472+ 7EB5 E1               POP HL
 473+ 7EB6 5D               LD E, L
 474+ 7EB7 3E 04            LD A, 4
 475+ 7EB9 CD BB 7D         CALL AY_WriteRegSlot1           ; R4
 476+ 7EBC 2A AE 7B         LD HL, (MusicPeriodC)
 477+ 7EBF 5C               LD E, H
 478+ 7EC0 3E 05            LD A, 5
 479+ 7EC2 C3 BB 7D         JP AY_WriteRegSlot1             ; tail-call: R5
 480+ 7EC5              .map2End:
 481+ 7EC5 C3 7F 7F         JP MusicEndOfTable
