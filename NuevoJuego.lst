151+  8197              ; ==============================================================================
152+  8197              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
153+  8197              ; ==============================================================================
154+  8197              ; Maneja correctamente los cruces de character row (cada 8 lineas)
155+  8197              ; y los cruces de tercio de pantalla (cada 64 lineas).
156+  8197              ;
157+  8197              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
158+  8197              ; ==============================================================================
159+  8197              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
160+  8197              NextPixelLine:
161+  8197 24               INC H                       ; Siguiente scanline dentro del char
162+  8198 7C               LD A, H
163+  8199 E6 07            AND 7
164+  819B C0               RET NZ                      ; Sin cruce de char row → listo
165+  819C
166+  819C                  ; --- Cruce de character row ---
167+  819C 7D               LD A, L
168+  819D C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
169+  819F 6F               LD L, A
170+  81A0 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
171+  81A2 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
172+  81A3
173+  81A3                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
174+  81A3 7C               LD A, H
175+  81A4 D6 08            SUB 8
176+  81A6 67               LD H, A
177+  81A7 C9               RET
178+  81A8
179+  81A8              ; ==============================================================================
180+  81A8              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
181+  81A8              ; ==============================================================================
182+  81A8              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
183+  81A8              ; Entrada:
184+  81A8              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
185+  81A8              ;   A = atributo a pintar
186+  81A8              ; ==============================================================================
187+  81A8              SetEntityAttr:
188+  81A8 F5               PUSH AF                     ; Guardar atributo
189+  81A9 CD 38 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
190+  81AC F1               POP AF
191+  81AD
192+  81AD 47               LD B, A                     ; B = atributo (preservar)
193+  81AE 3A 37 82         LD A, (EntityAttrH)
194+  81B1 4F               LD C, A                     ; C = filas
195+  81B2              .rowLoop:
196+  81B2 3A 36 82         LD A, (EntityAttrW)
197+  81B5 E5               PUSH HL                     ; Guardar inicio de fila
198+  81B6                  ; Pintar una fila
199+  81B6              .colLoop:
200+  81B6 70               LD (HL), B
201+  81B7 23               INC HL
202+  81B8 3D               DEC A
203+  81B9 20 FB            JR NZ, .colLoop
204+  81BB E1               POP HL
205+  81BC                  ; Siguiente fila: HL += 32
206+  81BC D5               PUSH DE
207+  81BD 11 20 00         LD DE, 32
208+  81C0 19               ADD HL, DE
209+  81C1 D1               POP DE
210+  81C2 0D               DEC C
211+  81C3 20 ED            JR NZ, .rowLoop
212+  81C5 C9               RET
213+  81C6
214+  81C6              ; ==============================================================================
215+  81C6              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
216+  81C6              ; ==============================================================================
217+  81C6              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
218+  81C6              ; Se llama ANTES de pintar el sprite.
219+  81C6              ;
220+  81C6              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
221+  81C6              ;          IX = puntero al sprite (para leer width/height)
222+  81C6              ; ==============================================================================
223+  81C6              SaveEntityAttr:
224+  81C6                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
225+  81C6 DD 7E 00         LD A, (IX+0)                ; width_bytes
226+  81C9 47               LD B, A
227+  81CA 7B               LD A, E                     ; X pixel (raw)
228+  81CB E6 07            AND 7
229+  81CD 28 01            JR Z, .noExtraW
230+  81CF 04               INC B                       ; +1 columna si no alineado
231+  81D0              .noExtraW:
232+  81D0 78               LD A, B
233+  81D1 32 36 82         LD (EntityAttrW), A
234+  81D4
235+  81D4                  ; Calcular height_chars = (Y%8 + height + 7) / 8
236+  81D4 7A               LD A, D                     ; Y pixel (raw)
237+  81D5 E6 07            AND 7                       ; Y offset dentro del char
238+  81D7 4F               LD C, A
239+  81D8 DD 7E 01         LD A, (IX+1)                ; height_pixels
240+  81DB 81               ADD A, C                    ; + Y offset
241+  81DC C6 07            ADD A, 7
242+  81DE 0F               RRCA
243+  81DF 0F               RRCA
244+  81E0 0F               RRCA
245+  81E1 E6 1F            AND $1F                     ; / 8 = height_chars
246+  81E3 32 37 82         LD (EntityAttrH), A
247+  81E6
248+  81E6 CD 38 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
249+  81E9 11 26 82         LD DE, EntitySavedAttr      ; DE = buffer destino
250+  81EC
251+  81EC 3A 37 82         LD A, (EntityAttrH)
252+  81EF 4F               LD C, A                     ; C = filas
253+  81F0              .saveRow:
254+  81F0 3A 36 82         LD A, (EntityAttrW)
255+  81F3 47               LD B, A                     ; B = columnas
256+  81F4 E5               PUSH HL                     ; Guardar inicio de fila
257+  81F5              .saveCol:
258+  81F5 7E               LD A, (HL)
259+  81F6 12               LD (DE), A
260+  81F7 23               INC HL
261+  81F8 13               INC DE
262+  81F9 10 FA            DJNZ .saveCol
263+  81FB E1               POP HL
264+  81FC                  ; Siguiente fila attr: HL += 32
265+  81FC D5               PUSH DE
266+  81FD 11 20 00         LD DE, 32
267+  8200 19               ADD HL, DE
268+  8201 D1               POP DE
269+  8202 0D               DEC C
270+  8203 20 EB            JR NZ, .saveRow
271+  8205 C9               RET
272+  8206
273+  8206              ; ==============================================================================
274+  8206              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
275+  8206              ; ==============================================================================
276+  8206              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
277+  8206              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
278+  8206              ;
279+  8206              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
280+  8206              ; ==============================================================================
281+  8206              RestoreEntityAttr:
282+  8206 CD 38 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
283+  8209 11 26 82         LD DE, EntitySavedAttr      ; DE = buffer fuente
284+  820C
285+  820C 3A 37 82         LD A, (EntityAttrH)
286+  820F 4F               LD C, A
287+  8210              .restRow:
288+  8210 3A 36 82         LD A, (EntityAttrW)
289+  8213 47               LD B, A
290+  8214 E5               PUSH HL
291+  8215              .restCol:
292+  8215 1A               LD A, (DE)
293+  8216 77               LD (HL), A
294+  8217 23               INC HL
295+  8218 13               INC DE
296+  8219 10 FA            DJNZ .restCol
297+  821B E1               POP HL
298+  821C D5               PUSH DE
299+  821D 11 20 00         LD DE, 32
300+  8220 19               ADD HL, DE
301+  8221 D1               POP DE
302+  8222 0D               DEC C
303+  8223 20 EB            JR NZ, .restRow
304+  8225 C9               RET
305+  8226
306+  8226              ; --- Buffer de atributos guardados (max 4×4 = 16 bytes, shifted + Y offset) ---
307+  8226 00 00 00...  EntitySavedAttr:    DEFS 16
308+  8236 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
309+  8237 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
310+  8238
311+  8238              ; ==============================================================================
312+  8238              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
313+  8238              ; ==============================================================================
314+  8238              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
315+  8238              ; Salida: HL = direccion en zona de atributos ($5800+)
316+  8238              ; ==============================================================================
317+  8238              CalcAttrAddr:
318+  8238 7A               LD A, D
319+  8239 0F               RRCA
320+  823A 0F               RRCA
321+  823B 0F               RRCA
322+  823C E6 1F            AND $1F                     ; Y / 8 = fila de atributo
323+  823E 6F               LD L, A
324+  823F 26 00            LD H, 0
325+  8241 29               ADD HL, HL
326+  8242 29               ADD HL, HL
327+  8243 29               ADD HL, HL
328+  8244 29               ADD HL, HL
329+  8245 29               ADD HL, HL                  ; HL = fila * 32
330+  8246 7B               LD A, E
331+  8247 0F               RRCA
332+  8248 0F               RRCA
333+  8249 0F               RRCA
334+  824A E6 1F            AND $1F                     ; X / 8 = columna
335+  824C B5               OR L
336+  824D 6F               LD L, A
337+  824E 01 00 58         LD BC, ATTR_BASE
338+  8251 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
339+  8252 C9               RET
340+  8253
341+  8253              ; ==============================================================================
342+  8253              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
343+  8253              ; ==============================================================================
344+  8253              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
345+  8253              ; Salida: HL=direccion en VRAM
346+  8253              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
347+  8253              ; ==============================================================================
348+  8253              CalcPixelAddr:
349+  8253 7A               LD A, D
350+  8254 E6 C0            AND $C0                     ; Y7 Y6
351+  8256 1F               RRA
352+  8257 1F               RRA
353+  8258 1F               RRA                         ; >> 3
354+  8259 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
355+  825B 67               LD H, A
356+  825C
357+  825C 7A               LD A, D
358+  825D E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
359+  825F B4               OR H
360+  8260 67               LD H, A
361+  8261
362+  8261 7A               LD A, D
363+  8262 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
364+  8264 87               ADD A, A
365+  8265 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
366+  8266 6F               LD L, A
367+  8267
368+  8267 7B               LD A, E
369+  8268 1F               RRA
370+  8269 1F               RRA
371+  826A 1F               RRA
372+  826B E6 1F            AND $1F                     ; X / 8 = columna
373+  826D B5               OR L
374+  826E 6F               LD L, A
375+  826F C9               RET
376+  8270
377+  8270              ; ==============================================================================
378+  8270              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
379+  8270              ; ==============================================================================
380+  8270              DrawDebugInfo:
381+  8270 3A 04 81         LD A, (CurrentScreenX)
382+  8273 1E 00            LD E, 0
383+  8275 CD 92 82         CALL .drawHexDigit
384+  8278
385+  8278 3E 2C            LD A, ','
386+  827A 1E 01            LD E, 1
387+  827C CD 9E 82         CALL .drawChar
388+  827F
389+  827F 3A 05 81         LD A, (CurrentScreenY)
390+  8282 1E 02            LD E, 2
391+  8284 CD 92 82         CALL .drawHexDigit
392+  8287
393+  8287 21 00 58         LD HL, ATTR_BASE
394+  828A 3E 47            LD A, WHITE | $40
395+  828C 77               LD (HL), A
396+  828D 23               INC HL
397+  828E 77               LD (HL), A
398+  828F 23               INC HL
399+  8290 77               LD (HL), A
400+  8291 C9               RET
401+  8292
402+  8292              .drawHexDigit:
403+  8292 E6 0F            AND $0F
404+  8294 FE 0A            CP 10
405+  8296 38 04            JR C, .isNum
406+  8298 C6 37            ADD A, 'A' - 10
407+  829A 18 02            JR .drawChar
408+  829C              .isNum:
409+  829C C6 30            ADD A, '0'
410+  829E              .drawChar:
411+  829E 6F               LD L, A
412+  829F 26 00            LD H, 0
413+  82A1 29               ADD HL, HL
414+  82A2 29               ADD HL, HL
415+  82A3 29               ADD HL, HL
416+  82A4 01 00 3C         LD BC, $3C00
417+  82A7 09               ADD HL, BC
418+  82A8
419+  82A8 16 40            LD D, $40
420+  82AA 06 08            LD B, 8
421+  82AC              .charLoop:
422+  82AC 7E               LD A, (HL)
423+  82AD 12               LD (DE), A
424+  82AE 23               INC HL
425+  82AF 14               INC D
426+  82B0 10 FA            DJNZ .charLoop
427+  82B2 C9               RET
