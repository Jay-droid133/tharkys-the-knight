 341+ 742D 19               ADD HL, DE
 342+ 742E 7E               LD A, (HL)
 343+ 742F 5F               LD E, A
 344+ 7430 16 00            LD D, 0
 345+ 7432 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 346+ 7435 19               ADD HL, DE                           ; HL = addr del char activo (attr area)
 347+ 7436 3E 47            LD A, MAGIC_COMPASS_ACTIVE_ATTR
