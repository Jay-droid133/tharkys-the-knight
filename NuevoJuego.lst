 201  7FCF
 202  7FCF                  ; ==========================================================================
 203  7FCF                  ; ORG $8000 - codigo principal (no-contended)
 204  7FCF                  ; ==========================================================================
 205  7FCF                  ORG ORIGIN_ADDRESS
 206  8000
 207  8000              ; ==============================================================================
 208  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 209  8000              ; ==============================================================================
 210  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 211  8000              ;   erase viejo → AI/movimiento → draw nuevo
 212  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 213  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 214  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 215  8000              ; ==============================================================================
 216  8000              MainLoop:
 217  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 218  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 219  8003 47               LD B, A                     ; B = tick actual
 220  8004
 221  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 222  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 223  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 224  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 225  8004 78               LD A, B
 226  8005 21 97 81         LD HL, .frameStart
 227  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 228  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 229  800A 21 E2 99         LD HL, TickRemainder
 230  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 231  800E 4F               LD C, A
 232  800F E6 01            AND $01
 233  8011 77               LD (HL), A                  ; new remainder = total mod 2
 234  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 235  8014 79               LD A, C
 236  8015 32 E1 99         LD (FramesElapsed), A
 237  8018
 238  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 239  8018 CD 8F CB         CALL UpdateDeathBorder
 240  801B CD 60 CB         CALL UpdateDeathAnim
 241  801E                  ; Music tick: ahora vive en MusicIrqHandler (slot 1, cada 2 IRQs = 25 Hz).
 242  801E                  ; Auditoria de concurrencia AY confirmada: todos los AY writes desde
 243  801E                  ; MainLoop estan envueltos en DI/EI (ay_sound_thunks + sfx_player_hit_ay).
 244  801E                  ; UpdateMusicImpl sigue vivo como catchup-fallback no llamado por defecto.
 245  801E
 246  801E                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 247  801E 3A DF 82         LD A, (GameOver)
 248  8021 B7               OR A
 249  8022 28 23            JR Z, .notGameOver
 250  8024 FE 02            CP 2
 251  8026 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 252  8028                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 253  8028 CD EA CB         CALL PaintGameOverScreen
 254  802B 3E 02            LD A, 2
 255  802D 32 DF 82         LD (GameOver), A
 256  8030 C3 87 81         JP .frameSync
 257  8033              .gameOverWaitInput:
 258  8033 CD 26 CC         CALL UpdateGameOverAnim     ; Death moonwalkea por la pantalla negra
 259  8036 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
 260  8039 ED 78            IN A, (C)
 261  803B CB 47            BIT 0, A                    ; SPACE = bit 0 (active low)
 262  803D C2 87 81         JP NZ, .frameSync           ; SPACE no pulsado: seguir esperando
 263  8040                  ; SPACE pulsado: reset total -> JP Inicio
 264  8040 F3               DI
 265  8041 31 58 FF         LD SP, SP_ADDRESS
 266  8044 C3 00 60         JP Inicio
