1690+ F054              ; ==============================================================================
1691+ F054              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
1692+ F054              ; ==============================================================================
1693+ F054              ; IN: A = frame idx (0..2)
1694+ F054              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
1695+ F054              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
1696+ F054              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
1697+ F054              ; Destruye: AF, BC, DE, HL, IX.
1698+ F054              ; ==============================================================================
1699+ F054              DrawSmokeFrameXor:
1700+ F054 87               ADD A, A                                ; *2 (entries de 2 bytes)
1701+ F055 6F               LD L, A
1702+ F056 26 00            LD H, 0
1703+ F058 11 4E F0         LD DE, SmokeFramePtrTable
1704+ F05B 19               ADD HL, DE
1705+ F05C 5E               LD E, (HL)
1706+ F05D 23               INC HL
1707+ F05E 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
1708+ F05F                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
1709+ F05F                  ; Source y destino accesibles sin paging (milestones bank 0,
1710+ F05F                  ; BgSpriteBuffer en RAM principal).
1711+ F05F EB               EX DE, HL                               ; HL = source
1712+ F060 11 42 89         LD DE, BgSpriteBuffer
1713+ F063 01 22 00         LD BC, 34
1714+ F066 ED B0            LDIR
1715+ F068                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
1716+ F068 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1717+ F06B 57               LD D, A
1718+ F06C 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1719+ F06F 5F               LD E, A
1720+ F070 C3 66 F1         JP DrawBgSprite16XorAtPixel
1721+ F073
1722+ F073              ; ==============================================================================
1723+ F073              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
1724+ F073              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
1725+ F073              ; ==============================================================================
1726+ F073              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
1727+ F073              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
1728+ F073              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
1729+ F073              ; uniformemente negro -- el efecto que pidio el usuario.
1730+ F073              ;
1731+ F073              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
1732+ F073              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
1733+ F073              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
1734+ F073              ; Destruye: AF, BC, DE, HL.
1735+ F073              ; ==============================================================================
1736+ F073              ClearSmokeAttrs:
1737+ F073                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
1738+ F073 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1739+ F076 CB 3F            SRL A
1739+ F078 CB 3F          SRL A
1739+ F07A CB 3F          SRL A                   ; A = char Y (post-HUD)
1740+ F07C 26 00            LD H, 0
1741+ F07E 6F               LD L, A
1742+ F07F 29               ADD HL, HL                              ; *2
1743+ F080 29               ADD HL, HL                              ; *4
1744+ F081 29               ADD HL, HL                              ; *8
1745+ F082 29               ADD HL, HL                              ; *16
1746+ F083 29               ADD HL, HL                              ; *32
1747+ F084 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1748+ F087 CB 3F            SRL A
1748+ F089 CB 3F          SRL A
1748+ F08B CB 3F          SRL A                   ; A = char X
1749+ F08D 5F               LD E, A
1750+ F08E 16 00            LD D, 0
1751+ F090 19               ADD HL, DE
1752+ F091 11 00 58         LD DE, $5800
1753+ F094 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
1754+ F095 AF               XOR A                                   ; paper black, ink black
1755+ F096 77               LD (HL), A                              ; (charY, charX)
1756+ F097 23               INC HL
1757+ F098 77               LD (HL), A                              ; (charY, charX+1)
1758+ F099 11 1F 00         LD DE, 31
1759+ F09C 19               ADD HL, DE                              ; saltar a (charY+1, charX)
1760+ F09D 77               LD (HL), A
1761+ F09E 23               INC HL
1762+ F09F 77               LD (HL), A                              ; (charY+1, charX+1)
1763+ F0A0 C9               RET
1764+ F0A1
1765+ F0A1              ; ==============================================================================
1766+ F0A1              ; CheckStatueHidden - es esta entry de BG una estatua oculta?
1767+ F0A1              ; ==============================================================================
1768+ F0A1              ; IN:  A = sprite id
1769+ F0A1              ; OUT: NZ si es estatua y su slot esta atrapado (skip drawing).
1770+ F0A1              ;      Z si no es estatua o esta visible (draw normalmente).
1771+ F0A1              ; Destruye: AF, BC, HL.
1772+ F0A1              ; ==============================================================================
1773+ F0A1              CheckStatueHidden:
1774+ F0A1 21 DE EF         LD HL, StatueIdTable
1775+ F0A4 06 03            LD B, 3
1776+ F0A6 0E 00            LD C, 0                                 ; slot index 0..2
1777+ F0A8              .cshLoop:
1778+ F0A8 BE               CP (HL)
1779+ F0A9 28 06            JR Z, .cshMatch
1780+ F0AB 23               INC HL
1781+ F0AC 0C               INC C
1782+ F0AD 10 F9            DJNZ .cshLoop
1783+ F0AF AF               XOR A                                   ; not statue -> Z (visible)
1784+ F0B0 C9               RET
1785+ F0B1              .cshMatch:
1786+ F0B1                  ; A es statue id. C = slot/type idx. Comprobar bit en MonsterTrappedFlags.
1787+ F0B1 79               LD A, C
1788+ F0B2 32 E7 EF         LD (LastHiddenStatueType), A            ; expose type para el caller
1789+ F0B5 21 DB EF         LD HL, ChurchTrapBitMask
1790+ F0B8 5F               LD E, A
1791+ F0B9 16 00            LD D, 0
1792+ F0BB 19               ADD HL, DE
1793+ F0BC 7E               LD A, (HL)                              ; bit mask
1794+ F0BD 21 36 82         LD HL, MonsterTrappedFlags
1795+ F0C0 A6               AND (HL)
1796+ F0C1 C9               RET                                     ; NZ si bit set (hidden), Z si no
1797+ F0C2
1798+ F0C2              ; ==============================================================================
1799+ F0C2              ; EraseStatueAtSlot - borra (XOR) la estatua del slot N en la pantalla actual
1800+ F0C2              ; ==============================================================================
1801+ F0C2              ; IN: A = slot (0..2)
1802+ F0C2              ; Solo tiene efecto si la estatua esta colocada en la pantalla actual.
1803+ F0C2              ; Destruye: AF, BC, DE, HL, IX.
1804+ F0C2              ; ==============================================================================
1805+ F0C2              EraseStatueAtSlot:
1806+ F0C2                  ; Get statue ID from table
1807+ F0C2 21 DE EF         LD HL, StatueIdTable
1808+ F0C5 5F               LD E, A
1809+ F0C6 16 00            LD D, 0
1810+ F0C8 19               ADD HL, DE
1811+ F0C9 7E               LD A, (HL)                              ; A = statue id
1812+ F0CA B7               OR A
1813+ F0CB C8               RET Z                                   ; ID 0 = no estatua (no exportada)
1814+ F0CC 32 08 F1         LD (.eseTargetId), A
1815+ F0CF                  ; Scan CurrentScreenBuffer (formato 4B: id, charX, charY, variant; $FF = end)
1816+ F0CF 2A 57 82         LD HL, (CurrentScreenAddr)
1817+ F0D2              .eseLoop:
1818+ F0D2 7E               LD A, (HL)
1819+ F0D3 FE FF            CP $FF
1820+ F0D5 C8               RET Z                                   ; no encontrada en esta pantalla
1821+ F0D6 47               LD B, A                                 ; B = current id
1822+ F0D7 3A 08 F1         LD A, (.eseTargetId)
1823+ F0DA B8               CP B
1824+ F0DB 28 06            JR Z, .eseFound
1825+ F0DD 11 04 00         LD DE, 4
1826+ F0E0 19               ADD HL, DE
1827+ F0E1 18 EF            JR .eseLoop
1828+ F0E3              .eseFound:
1829+ F0E3                  ; HL en id. Avanzar a charX, charY.
1830+ F0E3 23               INC HL
1831+ F0E4 46               LD B, (HL)                              ; B = charX
1832+ F0E5 23               INC HL
1833+ F0E6 4E               LD C, (HL)                              ; C = charY
1834+ F0E7                  ; Cargar sprite via BgGfxPtrById[id]: id*3 -> ptr (DEFW), bank (DEFB).
1835+ F0E7 3A 08 F1         LD A, (.eseTargetId)
1836+ F0EA 6F               LD L, A
1837+ F0EB 26 00            LD H, 0
1838+ F0ED 54               LD D, H
1839+ F0EE 5D               LD E, L
1840+ F0EF 29               ADD HL, HL                              ; *2
1841+ F0F0 19               ADD HL, DE                              ; *3
1842+ F0F1 11 23 DA         LD DE, BgGfxPtrById
1843+ F0F4 19               ADD HL, DE
1844+ F0F5 5E               LD E, (HL)
1845+ F0F6 23               INC HL
1846+ F0F7 56               LD D, (HL)                              ; DE = ptr
1847+ F0F8 23               INC HL
1848+ F0F9 7E               LD A, (HL)                              ; A = bank
1849+ F0FA C5               PUSH BC
1850+ F0FB EB               EX DE, HL                               ; HL = ptr
1851+ F0FC CD 0A 91         CALL LoadBgSpriteToBuffer               ; preserva BC
1852+ F0FF C1               POP BC
1853+ F100 DD 21 42 89      LD IX, BgSpriteBuffer
1854+ F104 CD 62 D6         CALL DrawBgSpriteXOR                    ; XOR-erase
1855+ F107 C9               RET
1856+ F108 00           .eseTargetId: DEFB 0
