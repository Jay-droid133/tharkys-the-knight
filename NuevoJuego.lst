 417+ E4E5
 418+ E4E5              ; ==============================================================================
 419+ E4E5              ; .cmcpFindMatchingGap - Busca en sala A un gap (side=B, coord=C)
 420+ E4E5              ; ==============================================================================
 421+ E4E5              ; Devuelve la comp del gap matching (side AND coord). Permite resolver la
 422+ E4E5              ; correspondencia gap-físico cuando hay múltiples gaps del mismo side en
 423+ E4E5              ; comps distintas.
 424+ E4E5              ; IN:  A = sid, B = coord, C = side
 425+ E4E5              ; OUT: A = comp (0..2) si encontrado; $FF si no match.
 426+ E4E5              ; Destruye: AF, BC, DE, HL.
 427+ E4E5              ; ==============================================================================
 428+ E4E5              .cmcpFindMatchingGap:
 429+ E4E5 32 84 E5         LD (.cfmgSid), A
 430+ E4E8 78               LD A, B
 431+ E4E9 32 85 E5         LD (.cfmgCoord), A
 432+ E4EC 79               LD A, C
 433+ E4ED 32 86 E5         LD (.cfmgSide), A
 434+ E4F0 3A 84 E5         LD A, (.cfmgSid)
 435+ E4F3 6F               LD L, A
 436+ E4F4 26 00            LD H, 0
 437+ E4F6 29               ADD HL, HL
 438+ E4F7 11 77 60         LD DE, RoomCompGapsTable
 439+ E4FA 19               ADD HL, DE
 440+ E4FB 5E               LD E, (HL)
 441+ E4FC 23               INC HL
 442+ E4FD 56               LD D, (HL)
 443+ E4FE EB               EX DE, HL                            ; HL = record
 444+ E4FF 7E               LD A, (HL)
 445+ E500 B7               OR A
 446+ E501 28 20            JR Z, .cfmgNotFound
 447+ E503 47               LD B, A
 448+ E504 23               INC HL
 449+ E505              .cfmgLoop:
 450+ E505 7E               LD A, (HL)                           ; side_comp
 451+ E506 23               INC HL
 452+ E507 4E               LD C, (HL)                           ; coord
 453+ E508 23               INC HL
 454+ E509 57               LD D, A                              ; D = side_comp
 455+ E50A E6 03            AND $03                              ; side
 456+ E50C 5F               LD E, A
 457+ E50D 3A 86 E5         LD A, (.cfmgSide)
 458+ E510 BB               CP E
 459+ E511 20 0E            JR NZ, .cfmgSkip
 460+ E513 3A 85 E5         LD A, (.cfmgCoord)
 461+ E516 B9               CP C
 462+ E517 20 08            JR NZ, .cfmgSkip
 463+ E519                  ; Match. Extract comp.
 464+ E519 7A               LD A, D
 465+ E51A CB 3F            SRL A
 466+ E51C CB 3F            SRL A
 467+ E51E E6 03            AND $03
 468+ E520 C9               RET
 469+ E521              .cfmgSkip:
 470+ E521 10 E2            DJNZ .cfmgLoop
 471+ E523              .cfmgNotFound:
 472+ E523 3E FF            LD A, $FF
 473+ E525 C9               RET
 474+ E526
 475+ E526              ; ==============================================================================
 476+ E526              ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 477+ E526              ; ==============================================================================
 478+ E526              ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 479+ E526              ; bit_idx en 16-bit: HL.
 480+ E526              ;
 481+ E526              ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 482+ E526              ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 483+ E526              ; ==============================================================================
 484+ E526              .cmcpMarkVisited:
 485+ E526                  ; bit_idx = sid*3 + comp; HL = bit_idx
 486+ E526 26 00            LD H, 0
 487+ E528 6F               LD L, A                              ; HL = sid
 488+ E529 E5               PUSH HL
 489+ E52A 29               ADD HL, HL                           ; HL = sid*2
 490+ E52B D1               POP DE
 491+ E52C 19               ADD HL, DE                           ; HL = sid*3
 492+ E52D 58               LD E, B
 493+ E52E 16 00            LD D, 0
 494+ E530 19               ADD HL, DE                           ; HL = sid*3 + comp
 495+ E531                  ; bit pos = HL & 7; byte idx = HL >> 3
 496+ E531 7D               LD A, L
 497+ E532 E6 07            AND $07
 498+ E534 4F               LD C, A                              ; C = bit pos
 499+ E535 CB 3C            SRL H
 500+ E537 CB 1D            RR L
 501+ E539 CB 3C            SRL H
 502+ E53B CB 1D            RR L
 503+ E53D CB 3C            SRL H
 504+ E53F CB 1D            RR L                                 ; HL = HL/8 (byte idx)
 505+ E541 11 80 5B         LD DE, MagicCompassVisited
 506+ E544 19               ADD HL, DE                           ; HL = byte addr
 507+ E545 3E 01            LD A, 1
 508+ E547 0C               INC C
 509+ E548              .cmvShift:
 510+ E548 0D               DEC C
 511+ E549 28 03            JR Z, .cmvDone
 512+ E54B 87               ADD A, A
 513+ E54C 18 FA            JR .cmvShift
 514+ E54E              .cmvDone:
 515+ E54E B6               OR (HL)
 516+ E54F 77               LD (HL), A
 517+ E550 C9               RET
 518+ E551
 519+ E551              .cmcpCheckVisitedBC:
 520+ E551                  ; bit_idx = sid*3 + comp; HL = bit_idx
 521+ E551 26 00            LD H, 0
 522+ E553 68               LD L, B                              ; HL = sid
 523+ E554 E5               PUSH HL
 524+ E555 29               ADD HL, HL
 525+ E556 D1               POP DE
 526+ E557 19               ADD HL, DE                           ; HL = sid*3
 527+ E558 59               LD E, C
 528+ E559 16 00            LD D, 0
 529+ E55B 19               ADD HL, DE                           ; HL = sid*3 + comp
 530+ E55C 7D               LD A, L
 531+ E55D E6 07            AND $07
 532+ E55F 4F               LD C, A
 533+ E560 CB 3C            SRL H
 534+ E562 CB 1D            RR L
 535+ E564 CB 3C            SRL H
 536+ E566 CB 1D            RR L
 537+ E568 CB 3C            SRL H
 538+ E56A CB 1D            RR L
 539+ E56C 11 80 5B         LD DE, MagicCompassVisited
 540+ E56F 19               ADD HL, DE
 541+ E570 3E 01            LD A, 1
 542+ E572 0C               INC C
 543+ E573              .ccvShift:
 544+ E573 0D               DEC C
 545+ E574 28 03            JR Z, .ccvDone
 546+ E576 87               ADD A, A
 547+ E577 18 FA            JR .ccvShift
 548+ E579              .ccvDone:
 549+ E579 A6               AND (HL)
 550+ E57A C9               RET
