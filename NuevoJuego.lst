1254+ F60E 26 00            LD H, 0
1255+ F610 29               ADD HL, HL
1256+ F611 29               ADD HL, HL
1257+ F612 29               ADD HL, HL
1258+ F613 29               ADD HL, HL
1259+ F614 11 4B 81         LD DE, EntityTable
1260+ F617 19               ADD HL, DE
1261+ F618 E5               PUSH HL
1262+ F619 DD E1            POP IX
1263+ F61B                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1264+ F61B DD 7E 00         LD A, (IX+ENT_SPRITEID)
