 191+ 9EA9              ; ==============================================================================
 192+ 9EA9              ; InitEntities - Inicializa la tabla de entidades
 193+ 9EA9              ; ==============================================================================
 194+ 9EA9              ; Limpia todos los slots y configura el slot 0 como player.
 195+ 9EA9              ; ==============================================================================
 196+ 9EA9              InitEntities:
 197+ 9EA9                  ; Limpiar toda la tabla a ceros
 198+ 9EA9 21 A0 81         LD HL, EntityTable
 199+ 9EAC 11 A1 81         LD DE, EntityTable + 1
 200+ 9EAF 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 201+ 9EB2 AF               XOR A
 202+ 9EB3 77               LD (HL), A
 203+ 9EB4 ED B0            LDIR
 204+ 9EB6
 205+ 9EB6                  ; Limpiar tabla de atributos salvados
 206+ 9EB6 21 DC 9B         LD HL, SavedAttrTable
 207+ 9EB9 11 DD 9B         LD DE, SavedAttrTable + 1
 208+ 9EBC 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 209+ 9EBF AF               XOR A
 210+ 9EC0 77               LD (HL), A
 211+ 9EC1 ED B0            LDIR
 212+ 9EC3
 213+ 9EC3                  ; Configurar slot 0: Player
 214+ 9EC3 DD 21 A0 81      LD IX, EntityTable
 215+ 9EC7 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 216+ 9ECB DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 217+ 9ECF DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 218+ 9ED3 DD 36 03 98      LD (IX+ENT_POSX), START_PLAYER_X
 219+ 9ED7 DD 36 04 48      LD (IX+ENT_POSY), START_PLAYER_Y
 220+ 9EDB DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 221+ 9EDF DD 36 06 00      LD (IX+ENT_DELTAX), 0
 222+ 9EE3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 223+ 9EE7 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 224+ 9EEB DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 225+ 9EEF DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 226+ 9EF3 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 227+ 9EF7 DD 36 0C 98      LD (IX+ENT_OLDX), START_PLAYER_X
 228+ 9EFB DD 36 0D 48      LD (IX+ENT_OLDY), START_PLAYER_Y
 229+ 9EFF DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 230+ 9F03 DD 36 0F 98      LD (IX+ENT_DRAWX), START_PLAYER_X
 231+ 9F07
 232+ 9F07                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 233+ 9F07 3E 0C            LD A, SPAWN_INTERVAL
 234+ 9F09 32 FA 82         LD (SpawnTimer), A
 235+ 9F0C AF               XOR A
 236+ 9F0D 32 07 83         LD (EnemyStepIdx), A
 237+ 9F10 32 7B 5F         LD (PendingEraseCount), A
 238+ 9F13 C9               RET
