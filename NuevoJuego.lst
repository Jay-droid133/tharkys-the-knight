3477+ A62A              .edLoop:
3478+ A62A C5               PUSH BC
3479+ A62B E5               PUSH HL
3480+ A62C                  ; Leer datos: OLDSPRID(1), OLDX(1), OLDY(1), SprAddr(2)
3481+ A62C 23               INC HL                              ; skip OLDSPRID (ya resuelto)
3482+ A62D 5E               LD E, (HL)                          ; OLDX
3483+ A62E 23               INC HL
3484+ A62F 56               LD D, (HL)                          ; OLDY
3485+ A630 23               INC HL
3486+ A631 7E               LD A, (HL)
3487+ A632 23               INC HL
3488+ A633 66               LD H, (HL)
3489+ A634 6F               LD L, A                             ; HL = sprite data addr
3490+ A635                  ; D=Y, E=X para DrawSprite
3491+ A635 DD E5            PUSH IX
3492+ A637 E5               PUSH HL
3493+ A638 DD E1            POP IX                              ; IX = sprite data
3494+ A63A CD FE 8D         CALL DrawSprite
3495+ A63D DD E1            POP IX
3496+ A63F
3497+ A63F E1               POP HL
3498+ A640 11 05 00         LD DE, 5
