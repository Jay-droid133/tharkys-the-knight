2096+ AE7F
2097+ AE7F              ; ==============================================================================
2098+ AE7F              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2099+ AE7F              ; ==============================================================================
2100+ AE7F              CheckWellPickup:
2101+ AE7F 3A 9E 90         LD A, (WellActive)
2102+ AE82 B7               OR A
2103+ AE83 C8               RET Z                               ; No hay pozo en esta pantalla
2104+ AE84                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2105+ AE84 2A A2 90         LD HL, (WellCooldownTimer)
2106+ AE87 7C               LD A, H
2107+ AE88 B5               OR L
2108+ AE89 C0               RET NZ                              ; timer > 0 → skip
2109+ AE8A                  ; Ya esta al maximo? No hacer nada
2110+ AE8A 3A D9 B6         LD A, (PlayerHealth)
2111+ AE8D FE 10            CP HEALTH_MAX
2112+ AE8F 20 06            JR NZ, .cwDoCheck
2113+ AE91 3A DA B6         LD A, (PlayerStamina)
2114+ AE94 FE 10            CP STAMINA_MAX
2115+ AE96 C8               RET Z                               ; Ambos al maximo → nada
2116+ AE97              .cwDoCheck:
2117+ AE97                  ; AABB con margen de 8px (1 celda) por cada lado:
2118+ AE97                  ; playerX < wellX+24 AND wellX-8 < playerX+16
2119+ AE97                  ; playerY < wellY+24 AND wellY-8 < playerY+21
2120+ AE97                  ; --- Check X ---
2121+ AE97 3A 9F 90         LD A, (WellPosX)
2122+ AE9A C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
2123+ AE9C 4F               LD C, A
2124+ AE9D 3A 39 81         LD A, (EntityTable + ENT_POSX)      ; A = playerX
2125+ AEA0 B9               CP C                                ; playerX < wellRight+margen?
2126+ AEA1 30 3C            JR NC, .cwNoOverlap                 ; no → fuera
2127+ AEA3 3A 39 81         LD A, (EntityTable + ENT_POSX)
2128+ AEA6 C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
2129+ AEA8 4F               LD C, A
2130+ AEA9 3A 9F 90         LD A, (WellPosX)                    ; A = wellX
2131+ AEAC B9               CP C                                ; wellX < playerRight+margen?
2132+ AEAD 30 30            JR NC, .cwNoOverlap                 ; no → fuera
2133+ AEAF                  ; --- Check Y ---
2134+ AEAF 3A A0 90         LD A, (WellPosY)
2135+ AEB2 C6 18            ADD A, 24                           ; C = wellY + 16 + 8
2136+ AEB4 4F               LD C, A
2137+ AEB5 3A 3A 81         LD A, (EntityTable + ENT_POSY)      ; A = playerY
2138+ AEB8 B9               CP C                                ; playerY < wellBottom+margen?
2139+ AEB9 30 24            JR NC, .cwNoOverlap                 ; no → fuera
2140+ AEBB 3A 3A 81         LD A, (EntityTable + ENT_POSY)
2141+ AEBE C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
2142+ AEC0 4F               LD C, A
2143+ AEC1 3A A0 90         LD A, (WellPosY)                    ; A = wellY
2144+ AEC4 B9               CP C                                ; wellY < playerBottom+margen?
2145+ AEC5 30 18            JR NC, .cwNoOverlap                 ; no → fuera
2146+ AEC7                  ; --- Overlap! Recuperar salud y stamina ---
2147+ AEC7 3E 10            LD A, HEALTH_MAX
2148+ AEC9 32 D9 B6         LD (PlayerHealth), A
2149+ AECC 3E 10            LD A, STAMINA_MAX
2150+ AECE 32 DA B6         LD (PlayerStamina), A
2151+ AED1                  ; Flash HUD y SFX
2152+ AED1 3E 0A            LD A, 10                            ; 10 frames a 25fps = 0.4s (era 20 a 50fps)
2153+ AED3 32 A1 90         LD (WellFlashTimer), A
2154+ AED6                  ; Arrancar cooldown: capturar attrs originales + pintar blanco
2155+ AED6 CD E0 AE         CALL StartWellCooldown
2156+ AED9 21 DD F8         LD HL, SFX_WellRecover
2157+ AEDC CD 33 F8         CALL PlaySFX
2158+ AEDF              .cwNoOverlap:
2159+ AEDF C9               RET
2160+ AEE0
2161+ AEE0              ; ==============================================================================
2162+ AEE0              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2163+ AEE0              ; ==============================================================================
2164+ AEE0              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2165+ AEE0              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2166+ AEE0              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2167+ AEE0              ; ==============================================================================
2168+ AEE0              StartWellCooldown:
2169+ AEE0 CD 0D AF         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2170+ AEE3 E5               PUSH HL
2171+ AEE4 11 9C 8D         LD DE, CleanAttrMap
2172+ AEE7 19               ADD HL, DE
2173+ AEE8 7E               LD A, (HL)
2174+ AEE9 32 A4 90         LD (WellOrigAttr0), A
2175+ AEEC 23               INC HL
2176+ AEED 7E               LD A, (HL)
2177+ AEEE 32 A5 90         LD (WellOrigAttr1), A
2178+ AEF1 E1               POP HL
2179+ AEF2 CD 27 AF         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2180+ AEF5 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2181+ AEF8 22 A2 90         LD (WellCooldownTimer), HL
2182+ AEFB C9               RET
2183+ AEFC
2184+ AEFC              ; ==============================================================================
2185+ AEFC              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2186+ AEFC              ; ==============================================================================
2187+ AEFC              ; Solo pinta blanco (no re-captura originals; los almacenados en
2188+ AEFC              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2189+ AEFC              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2190+ AEFC              ; para que el flash de cian dure lo mínimo posible.
2191+ AEFC              ; ==============================================================================
2192+ AEFC              ApplyWellCooldownIfActive:
2193+ AEFC 3A 9E 90         LD A, (WellActive)
2194+ AEFF B7               OR A
2195+ AF00 C8               RET Z
2196+ AF01 2A A2 90         LD HL, (WellCooldownTimer)
2197+ AF04 7C               LD A, H
2198+ AF05 B5               OR L
2199+ AF06 C8               RET Z
2200+ AF07 CD 0D AF         CALL GetWellBottomOffset
2201+ AF0A C3 27 AF         JP PaintWellWhiteAt
2202+ AF0D
2203+ AF0D              ; ==============================================================================
2204+ AF0D              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2205+ AF0D              ; ==============================================================================
2206+ AF0D              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2207+ AF0D              ; CleanAttrMap suma CleanAttrMap.
2208+ AF0D              ; Destruye: A, DE
2209+ AF0D              ; ==============================================================================
2210+ AF0D              GetWellBottomOffset:
2211+ AF0D 3A A0 90         LD A, (WellPosY)
2212+ AF10 26 00            LD H, 0
2213+ AF12 6F               LD L, A
2214+ AF13 29               ADD HL, HL
2215+ AF14 29               ADD HL, HL                          ; (pixel_y/8)*32
2216+ AF15 3A 9F 90         LD A, (WellPosX)
2217+ AF18 0F               RRCA
2218+ AF19 0F               RRCA
2219+ AF1A 0F               RRCA
2220+ AF1B E6 1F            AND $1F
2221+ AF1D 85               ADD A, L
2222+ AF1E 6F               LD L, A
2223+ AF1F 30 01            JR NC, .gwbNoCarry
2224+ AF21 24               INC H
2225+ AF22              .gwbNoCarry:
2226+ AF22 11 20 00         LD DE, 32
2227+ AF25 19               ADD HL, DE                          ; offset fila inferior
2228+ AF26 C9               RET
2229+ AF27
2230+ AF27              ; ==============================================================================
2231+ AF27              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2232+ AF27              ; ==============================================================================
2233+ AF27              ; IN: HL = offset fila inferior (relativo a attr map)
2234+ AF27              ; ==============================================================================
2235+ AF27              PaintWellWhiteAt:
2236+ AF27 E5               PUSH HL
2237+ AF28                  ; VRAM
2238+ AF28 11 00 58         LD DE, ATTR_BASE
2239+ AF2B 19               ADD HL, DE
2240+ AF2C 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2241+ AF2E 77               LD (HL), A
2242+ AF2F 23               INC HL
2243+ AF30 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2244+ AF32 77               LD (HL), A
2245+ AF33 E1               POP HL
2246+ AF34                  ; CleanAttrMap
2247+ AF34 11 9C 8D         LD DE, CleanAttrMap
2248+ AF37 19               ADD HL, DE
2249+ AF38 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2250+ AF3A 77               LD (HL), A
2251+ AF3B 23               INC HL
2252+ AF3C 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2253+ AF3E 77               LD (HL), A
2254+ AF3F C9               RET
2255+ AF40
2256+ AF40              ; ==============================================================================
2257+ AF40              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2258+ AF40              ; ==============================================================================
2259+ AF40              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2260+ AF40              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2261+ AF40              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2262+ AF40              ; ==============================================================================
2263+ AF40              UpdateWellCooldown:
2264+ AF40 2A A2 90         LD HL, (WellCooldownTimer)
2265+ AF43 7C               LD A, H
2266+ AF44 B5               OR L
2267+ AF45 C8               RET Z                               ; 0 → nada que hacer
2268+ AF46 2B               DEC HL
2269+ AF47 22 A2 90         LD (WellCooldownTimer), HL
2270+ AF4A 7C               LD A, H
2271+ AF4B B5               OR L
2272+ AF4C C0               RET NZ                              ; > 0 → esperar
2273+ AF4D                  ; Timer acaba de llegar a 0. Si estamos en la room del pozo, restaurar
2274+ AF4D                  ; attrs originales. Si no, al volver DrawScreen ya dibuja cian normal.
2275+ AF4D 3A 9E 90         LD A, (WellActive)
2276+ AF50 B7               OR A
2277+ AF51 C8               RET Z
2278+ AF52 C3 55 AF         JP RestoreWellOriginalAttrs
2279+ AF55
2280+ AF55              ; ==============================================================================
2281+ AF55              ; RestoreWellOriginalAttrs - escribe WellOrigAttrN a VRAM y CleanAttrMap
2282+ AF55              ; ==============================================================================
2283+ AF55              RestoreWellOriginalAttrs:
2284+ AF55 CD 0D AF         CALL GetWellBottomOffset
2285+ AF58 E5               PUSH HL
2286+ AF59                  ; VRAM
2287+ AF59 11 00 58         LD DE, ATTR_BASE
2288+ AF5C 19               ADD HL, DE
2289+ AF5D 3A A4 90         LD A, (WellOrigAttr0)
2290+ AF60 77               LD (HL), A
2291+ AF61 23               INC HL
2292+ AF62 3A A5 90         LD A, (WellOrigAttr1)
2293+ AF65 77               LD (HL), A
2294+ AF66 E1               POP HL
2295+ AF67                  ; CleanAttrMap
2296+ AF67 11 9C 8D         LD DE, CleanAttrMap
2297+ AF6A 19               ADD HL, DE
2298+ AF6B 3A A4 90         LD A, (WellOrigAttr0)
2299+ AF6E 77               LD (HL), A
2300+ AF6F 23               INC HL
2301+ AF70 3A A5 90         LD A, (WellOrigAttr1)
2302+ AF73 77               LD (HL), A
2303+ AF74 C9               RET
2304+ AF75
2305+ AF75              ; ==============================================================================
2306+ AF75              CheckPredatorAttack:
2307+ AF75                  ; Buscar tipo depredador en PredatorTable
2308+ AF75 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2309+ AF78 D6 20            SUB SPRID_ENEMY_0
2310+ AF7A CB 3F            SRL A
2311+ AF7C CB 3F            SRL A                               ; indice = (ANIMBASE - ENEMY_0) / 4
2312+ AF7E 21 63 C0         LD HL, PredatorTable
2313+ AF81 5F               LD E, A
2314+ AF82 16 00            LD D, 0
2315+ AF84 19               ADD HL, DE
2316+ AF85 7E               LD A, (HL)                          ; A = byte predador
2317+ AF86 B7               OR A
2318+ AF87 C8               RET Z                               ; PRED_NONE → no es depredador
2319+ AF88
2320+ AF88                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2321+ AF88 47               LD B, A                             ; B = byte predador completo
2322+ AF89 CB 3F            SRL A
2323+ AF8B CB 3F            SRL A                               ; A = ciclo requerido (1-3)
2324+ AF8D 4F               LD C, A
2325+ AF8E 3A 6F C0         LD A, (DayCycleCount)
2326+ AF91 B9               CP C
2327+ AF92 D8               RET C                               ; DayCycleCount < ciclo requerido → no atacar
2328+ AF93
2329+ AF93                  ; Calcular velocidad de ataque segun ciclo
2330+ AF93 3A 6F C0         LD A, (DayCycleCount)
2331+ AF96 FE 04            CP 4
2332+ AF98 38 02            JR C, .cpSpeedOk
2333+ AF9A 3E 03            LD A, 3                             ; Cap en 3
2334+ AF9C              .cpSpeedOk:
2335+ AF9C 21 6B C0         LD HL, PredatorSpeedTable
2336+ AF9F 5F               LD E, A
2337+ AFA0 16 00            LD D, 0
2338+ AFA2 19               ADD HL, DE
2339+ AFA3 7E               LD A, (HL)
2340+ AFA4 32 21 B0         LD (.cpSpeed), A
2341+ AFA7
2342+ AFA7                  ; Tipo depredador activo: comprobar alineacion
2343+ AFA7 78               LD A, B
2344+ AFA8 E6 03            AND $03                             ; A = tipo (1=arriba, 2=abajo, 3=horizontal)
2345+ AFAA FE 03            CP PRED_HORIZONTAL
2346+ AFAC 28 41            JR Z, .cpHorizontal
2347+ AFAE
2348+ AFAE                  ; === Vertical (arriba/abajo): comprobar |nastyX - playerX| < PRED_ALIGN_DIST ===
2349+ AFAE 4F               LD C, A                             ; C = tipo (1 o 2)
2350+ AFAF DD 7E 03         LD A, (IX+ENT_POSX)
2351+ AFB2 57               LD D, A
2352+ AFB3 3A 39 81         LD A, (EntityTable + ENT_POSX)
2353+ AFB6 92               SUB D
2354+ AFB7 30 02            JR NC, .cpAbsX
2355+ AFB9 ED 44            NEG
2356+ AFBB              .cpAbsX:
2357+ AFBB FE 0C            CP PRED_ALIGN_DIST
2358+ AFBD D0               RET NC                              ; No alineado en X
2359+ AFBE
2360+ AFBE                  ; Comprobar posicion relativa Y
2361+ AFBE 79               LD A, C
2362+ AFBF FE 01            CP PRED_FROM_ABOVE
2363+ AFC1 28 17            JR Z, .cpFromAbove
2364+ AFC3                  ; Desde abajo: nastyY > playerY
2365+ AFC3 DD 7E 04         LD A, (IX+ENT_POSY)
2366+ AFC6 57               LD D, A
2367+ AFC7 3A 3A 81         LD A, (EntityTable + ENT_POSY)
2368+ AFCA BA               CP D
2369+ AFCB D0               RET NC                              ; playerY >= nastyY → no esta abajo
2370+ AFCC                  ; Lanzarse hacia arriba
2371+ AFCC 3A 21 B0         LD A, (.cpSpeed)
2372+ AFCF ED 44            NEG
2373+ AFD1 DD 77 07         LD (IX+ENT_DELTAY), A
2374+ AFD4 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2375+ AFD8 18 42            JR .cpActivate
2376+ AFDA              .cpFromAbove:
2377+ AFDA                  ; Desde arriba: nastyY < playerY
2378+ AFDA 3A 3A 81         LD A, (EntityTable + ENT_POSY)
2379+ AFDD 57               LD D, A
2380+ AFDE DD 7E 04         LD A, (IX+ENT_POSY)
2381+ AFE1 BA               CP D
2382+ AFE2 D0               RET NC                              ; nastyY >= playerY → no esta arriba
2383+ AFE3                  ; Lanzarse hacia abajo
2384+ AFE3 3A 21 B0         LD A, (.cpSpeed)
2385+ AFE6 DD 77 07         LD (IX+ENT_DELTAY), A
2386+ AFE9 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2387+ AFED 18 2D            JR .cpActivate
2388+ AFEF
2389+ AFEF              .cpHorizontal:
2390+ AFEF                  ; === Horizontal: comprobar |nastyY - playerY| < PRED_ALIGN_DIST ===
2391+ AFEF DD 7E 04         LD A, (IX+ENT_POSY)
2392+ AFF2 57               LD D, A
2393+ AFF3 3A 3A 81         LD A, (EntityTable + ENT_POSY)
2394+ AFF6 92               SUB D
2395+ AFF7 30 02            JR NC, .cpAbsY
2396+ AFF9 ED 44            NEG
2397+ AFFB              .cpAbsY:
2398+ AFFB FE 0C            CP PRED_ALIGN_DIST
2399+ AFFD D0               RET NC                              ; No alineado en Y
2400+ AFFE                  ; Lanzarse hacia el player en X
2401+ AFFE 3A 39 81         LD A, (EntityTable + ENT_POSX)
2402+ B001 57               LD D, A
2403+ B002 DD 7E 03         LD A, (IX+ENT_POSX)
2404+ B005 BA               CP D
2405+ B006 30 08            JR NC, .cpChargeLeft
2406+ B008                  ; Player esta a la derecha
2407+ B008 3A 21 B0         LD A, (.cpSpeed)
2408+ B00B DD 77 06         LD (IX+ENT_DELTAX), A
2409+ B00E 18 08            JR .cpChargeSetY
2410+ B010              .cpChargeLeft:
2411+ B010 3A 21 B0         LD A, (.cpSpeed)
2412+ B013 ED 44            NEG
2413+ B015 DD 77 06         LD (IX+ENT_DELTAX), A
2414+ B018              .cpChargeSetY:
2415+ B018 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2416+ B01C
