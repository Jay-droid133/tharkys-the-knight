4920+ B9E7              ; ==============================================================================
4921+ B9E7              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4922+ B9E7              ; ==============================================================================
4923+ B9E7              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4924+ B9E7              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4925+ B9E7              ; ==============================================================================
4926+ B9E7              KillAllActiveNasties:
4927+ B9E7 DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4928+ B9EB 06 04            LD B, NUM_NASTIES
4929+ B9ED              .kanLoop:
4930+ B9ED C5               PUSH BC
4931+ B9EE DD 7E 01         LD A, (IX+ENT_TYPE)
4932+ B9F1 B7               OR A
4933+ B9F2 28 26            JR Z, .kanSkip                  ; slot vacio
4934+ B9F4 FE 03            CP TYPE_NASTY
4935+ B9F6 20 22            JR NZ, .kanSkip                 ; no es nasty
4936+ B9F8 DD 7E 02         LD A, (IX+ENT_STATE)
4937+ B9FB FE 03            CP STATE_DYING
4938+ B9FD 28 1B            JR Z, .kanSkip                  ; ya muriendo
4939+ B9FF                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4940+ B9FF                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4941+ B9FF                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4942+ B9FF                  ; del nasty: peDying paintea el rect del puff con ese color)
4943+ B9FF CD 23 BA         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4944+ BA02 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4945+ BA06 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4946+ BA0A DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4947+ BA0E DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4948+ BA12 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4949+ BA16 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4950+ BA1A              .kanSkip:
4951+ BA1A 11 10 00         LD DE, ENT_SIZE
4952+ BA1D DD 19            ADD IX, DE
4953+ BA1F C1               POP BC
4954+ BA20 10 CB            DJNZ .kanLoop
4955+ BA22 C9               RET
4956+ BA23
4957+ BA23              ; ==============================================================================
4958+ BA23              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4959+ BA23              ; ==============================================================================
4960+ BA23              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4961+ BA23              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4962+ BA23              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4963+ BA23              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4964+ BA23              ; deja la posicion original (puff puede asomar levemente, raro).
4965+ BA23              ; IN:  IX = nasty entity.
4966+ BA23              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4967+ BA23              ; Destruye: AF, BC, DE, HL.
4968+ BA23              ; ==============================================================================
4969+ BA23              SnapPuffPos:
4970+ BA23 DD 7E 03         LD A, (IX+ENT_POSX)
4971+ BA26 32 99 BA         LD (.sppOrigX), A
4972+ BA29 E6 F8            AND $F8
4973+ BA2B 32 9B BA         LD (.sppBaseX), A                   ; base char-aligned X
4974+ BA2E DD 7E 04         LD A, (IX+ENT_POSY)
4975+ BA31 32 9A BA         LD (.sppOrigY), A
4976+ BA34 E6 F8            AND $F8
4977+ BA36 32 9C BA         LD (.sppBaseY), A                   ; base char-aligned Y
4978+ BA39
4979+ BA39                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4980+ BA39 CD 6D BA         CALL .sppCheckFit
4981+ BA3C C8               RET Z
4982+ BA3D
4983+ BA3D                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4984+ BA3D                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4985+ BA3D 21 9D BA         LD HL, .sppShifts
4986+ BA40              .sppLoop:
4987+ BA40 7E               LD A, (HL)
4988+ BA41 23               INC HL
4989+ BA42 47               LD B, A                             ; dx (signed)
4990+ BA43 7E               LD A, (HL)
4991+ BA44 23               INC HL
4992+ BA45 FE 80            CP $80
4993+ BA47 28 17            JR Z, .sppFail                      ; sentinel
4994+ BA49 4F               LD C, A                             ; dy (signed)
4995+ BA4A
4996+ BA4A 3A 9B BA         LD A, (.sppBaseX)
4997+ BA4D 80               ADD A, B
4998+ BA4E DD 77 03         LD (IX+ENT_POSX), A
4999+ BA51 3A 9C BA         LD A, (.sppBaseY)
5000+ BA54 81               ADD A, C
5001+ BA55 DD 77 04         LD (IX+ENT_POSY), A
5002+ BA58
5003+ BA58 E5               PUSH HL
5004+ BA59 CD 6D BA         CALL .sppCheckFit
5005+ BA5C E1               POP HL
5006+ BA5D C8               RET Z                               ; encontrado
5007+ BA5E 18 E0            JR .sppLoop
5008+ BA60
5009+ BA60              .sppFail:
5010+ BA60 3A 99 BA         LD A, (.sppOrigX)
5011+ BA63 DD 77 03         LD (IX+ENT_POSX), A
5012+ BA66 3A 9A BA         LD A, (.sppOrigY)
5013+ BA69 DD 77 04         LD (IX+ENT_POSY), A
5014+ BA6C C9               RET
5015+ BA6D
5016+ BA6D              ; --- .sppCheckFit ---
5017+ BA6D              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5018+ BA6D              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5019+ BA6D              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5020+ BA6D              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5021+ BA6D              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5022+ BA6D              .sppCheckFit:
5023+ BA6D                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5024+ BA6D DD 7E 03         LD A, (IX+ENT_POSX)
5025+ BA70 FE D1            CP SCREEN_MAX_X - 23
5026+ BA72 30 21            JR NC, .sppOutOfBounds
5027+ BA74 DD 7E 04         LD A, (IX+ENT_POSY)
5028+ BA77 FE 10            CP SCREEN_MIN_Y
5029+ BA79 38 1A            JR C, .sppOutOfBounds
5030+ BA7B FE 91            CP SCREEN_MAX_Y - 23
5031+ BA7D 30 16            JR NC, .sppOutOfBounds
5032+ BA7F                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5033+ BA7F DD 7E 00         LD A, (IX+ENT_SPRITEID)
5034+ BA82 32 98 BA         LD (.sppSpritIdSave), A
5035+ BA85 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5036+ BA89 CD 77 B6         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5037+ BA8C F5               PUSH AF
5038+ BA8D 3A 98 BA         LD A, (.sppSpritIdSave)
5039+ BA90 DD 77 00         LD (IX+ENT_SPRITEID), A
5040+ BA93 F1               POP AF
5041+ BA94 C9               RET
5042+ BA95              .sppOutOfBounds:
5043+ BA95 F6 01            OR 1                                ; NZ
5044+ BA97 C9               RET
5045+ BA98
5046+ BA98 00           .sppSpritIdSave: DEFB 0
5047+ BA99
5048+ BA99 00           .sppOrigX: DEFB 0
5049+ BA9A 00           .sppOrigY: DEFB 0
5050+ BA9B 00           .sppBaseX: DEFB 0
5051+ BA9C 00           .sppBaseY: DEFB 0
5052+ BA9D              .sppShifts:
5053+ BA9D                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5054+ BA9D                  ; Distancia creciente. Sentinel: dy=$80.
5055+ BA9D 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5056+ BA9F 00 F8            DEFB 0,   -8                        ; arriba 8
5057+ BAA1 00 08            DEFB 0,    8                        ; abajo 8
5058+ BAA3 F8 00            DEFB -8,   0                        ; izq 8
5059+ BAA5 08 00            DEFB 8,    0                        ; der 8
5060+ BAA7 00 F0            DEFB 0,  -16                        ; arriba 16
5061+ BAA9 00 10            DEFB 0,   16                        ; abajo 16
5062+ BAAB F8 F8            DEFB -8,  -8
5063+ BAAD 08 F8            DEFB 8,   -8
5064+ BAAF F8 08            DEFB -8,   8
5065+ BAB1 08 08            DEFB 8,    8
5066+ BAB3 00 80            DEFB 0,  $80                        ; sentinel
5067+ BAB5
5068+ BAB5              ; ==============================================================================
5069+ BAB5              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5070+ BAB5              ; ==============================================================================
5071+ BAB5              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5072+ BAB5              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5073+ BAB5              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5074+ BAB5              ; DeathSpawned. No-op si la muerte no esta activa.
5075+ BAB5              ; ==============================================================================
5076+ BAB5              SilentKillDeath:
5077+ BAB5 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5078+ BAB9 DD 7E 01         LD A, (IX+ENT_TYPE)
5079+ BABC B7               OR A
5080+ BABD 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5081+ BABF CD BA C6         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5082+ BAC2 AF               XOR A
5083+ BAC3 DD 77 01         LD (IX+ENT_TYPE), A
5084+ BAC6 32 FA 82         LD (DeathSpawned), A
5085+ BAC9              .skdResetTimer:
5086+ BAC9                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5087+ BAC9                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5088+ BAC9 21 00 00         LD HL, 0
5089+ BACC 22 F7 82         LD (DeathScreenTimer), HL
5090+ BACF                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5091+ BACF                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5092+ BACF                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5093+ BACF                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5094+ BACF                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5095+ BACF C9               RET
5096+ BAD0
5097+ BAD0              ; ==============================================================================
5098+ BAD0              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5099+ BAD0              ; ==============================================================================
5100+ BAD0              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5101+ BAD0              ; no DYING ni SPAWNING):
5102+ BAD0              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5103+ BAD0              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5104+ BAD0              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5105+ BAD0              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5106+ BAD0              ;     Si tampoco, deja el monster donde estaba.
5107+ BAD0              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5108+ BAD0              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5109+ BAD0              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5110+ BAD0              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5111+ BAD0              ; ==============================================================================
5112+ BAD0              FreezeMonstersFacingCorpse:
5113+ BAD0                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5114+ BAD0 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5115+ BAD3 32 F1 82         LD (CorpseX), A
5116+ BAD6 3A 9F 81         LD A, (EntityTable + ENT_POSY)
5117+ BAD9 32 F2 82         LD (CorpseY), A
5118+ BADC                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5119+ BADC                  ; ya skipea; no aplica aqui pero por simetria)
5120+ BADC 3E 01            LD A, 1
5121+ BADE 32 F0 82         LD (MonstersFrozen), A
5122+ BAE1 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5123+ BAE5 06 06            LD B, NUM_MONSTERS
5124+ BAE7              .fmcLoop:
5125+ BAE7 C5               PUSH BC
5126+ BAE8 DD 7E 01         LD A, (IX+ENT_TYPE)
5127+ BAEB FE 02            CP TYPE_MONSTER
5128+ BAED 20 0E            JR NZ, .fmcNext
5129+ BAEF DD 7E 02         LD A, (IX+ENT_STATE)
5130+ BAF2 FE 03            CP STATE_DYING
5131+ BAF4 28 07            JR Z, .fmcNext
5132+ BAF6 FE 04            CP STATE_SPAWNING
5133+ BAF8 28 03            JR Z, .fmcNext
5134+ BAFA CD 06 BB         CALL FreezeOneMonster
5135+ BAFD              .fmcNext:
5136+ BAFD C1               POP BC
5137+ BAFE 11 10 00         LD DE, ENT_SIZE
5138+ BB01 DD 19            ADD IX, DE
5139+ BB03 10 E2            DJNZ .fmcLoop
5140+ BB05 C9               RET
5141+ BB06
5142+ BB06              ; --- FreezeOneMonster ---
5143+ BB06              ; IX = monster slot pointer.
5144+ BB06              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5145+ BB06              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5146+ BB06              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5147+ BB06              FreezeOneMonster:
5148+ BB06                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5149+ BB06                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5150+ BB06                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5151+ BB06 DD 7E 03         LD A, (IX+ENT_POSX)
5152+ BB09 47               LD B, A
5153+ BB0A 3A F1 82         LD A, (CorpseX)
5154+ BB0D B8               CP B
5155+ BB0E 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5156+ BB10 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5157+ BB12              .fomFaceE:
5158+ BB12 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5159+ BB15 C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5160+ BB17 DD 77 00         LD (IX+ENT_SPRITEID), A
5161+ BB1A 18 08            JR .fomFaceDone
5162+ BB1C              .fomFaceW:
5163+ BB1C DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5164+ BB1F C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5165+ BB21 DD 77 00         LD (IX+ENT_SPRITEID), A
5166+ BB24              .fomFaceDone:
5167+ BB24
5168+ BB24                  ; --- 2) Computar |dx| y |dy| ---
5169+ BB24 3A F1 82         LD A, (CorpseX)
5170+ BB27 4F               LD C, A
5171+ BB28 DD 7E 03         LD A, (IX+ENT_POSX)
5172+ BB2B 91               SUB C                           ; A = posX - corpseX (signed)
5173+ BB2C 30 02            JR NC, .fomDxPos
5174+ BB2E ED 44            NEG
5175+ BB30              .fomDxPos:
5176+ BB30 32 81 BB         LD (.fomAdx), A
5177+ BB33 3A F2 82         LD A, (CorpseY)
5178+ BB36 4F               LD C, A
5179+ BB37 DD 7E 04         LD A, (IX+ENT_POSY)
5180+ BB3A 91               SUB C
5181+ BB3B 30 02            JR NC, .fomDyPos
5182+ BB3D ED 44            NEG
5183+ BB3F              .fomDyPos:
5184+ BB3F 32 82 BB         LD (.fomAdy), A
5185+ BB42
5186+ BB42                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5187+ BB42 3A 81 BB         LD A, (.fomAdx)
5188+ BB45 FE 10            CP 16
5189+ BB47 D2 70 BB         JP NC, .fomFreeze
5190+ BB4A 3A 82 BB         LD A, (.fomAdy)
5191+ BB4D FE 10            CP 16
5192+ BB4F D2 70 BB         JP NC, .fomFreeze
5193+ BB52
5194+ BB52                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5195+ BB52 3A 81 BB         LD A, (.fomAdx)
5196+ BB55 47               LD B, A
5197+ BB56 3A 82 BB         LD A, (.fomAdy)
5198+ BB59 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5199+ BB5A 38 0C            JR C, .fomTryX
5200+ BB5C 28 0A            JR Z, .fomTryX
5201+ BB5E                  ; |dy| > |dx| -> intentar Y primero
5202+ BB5E CD B6 BB         CALL TryBackoffY
5203+ BB61 28 0D            JR Z, .fomFreeze                ; ok
5204+ BB63 CD 83 BB         CALL TryBackoffX
5205+ BB66 18 08            JR .fomFreeze
5206+ BB68              .fomTryX:
5207+ BB68 CD 83 BB         CALL TryBackoffX
5208+ BB6B 28 03            JR Z, .fomFreeze
5209+ BB6D CD B6 BB         CALL TryBackoffY
5210+ BB70
5211+ BB70              .fomFreeze:
5212+ BB70                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5213+ BB70                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5214+ BB70 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5215+ BB74 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5216+ BB78 DD 36 0A 00      LD (IX+ENT_DIR), 0
5217+ BB7C DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5218+ BB80 C9               RET
5219+ BB81
5220+ BB81 00           .fomAdx: DEFB 0
5221+ BB82 00           .fomAdy: DEFB 0
5222+ BB83
5223+ BB83              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5224+ BB83              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5225+ BB83              TryBackoffX:
5226+ BB83 DD 7E 03         LD A, (IX+ENT_POSX)
5227+ BB86 32 B5 BB         LD (.tbxSavePos), A
5228+ BB89 47               LD B, A
5229+ BB8A 3A F1 82         LD A, (CorpseX)
5230+ BB8D B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5231+ BB8E DD 7E 03         LD A, (IX+ENT_POSX)
5232+ BB91 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5233+ BB93 C6 10            ADD A, 16
5234+ BB95 18 02            JR .tbxApply
5235+ BB97              .tbxNeg:
5236+ BB97 D6 10            SUB 16
5237+ BB99              .tbxApply:
5238+ BB99                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5239+ BB99 DD 77 03         LD (IX+ENT_POSX), A
5240+ BB9C FE E8            CP SCREEN_MAX_X
5241+ BB9E 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5242+ BBA0 CD 77 B6         CALL CheckEnemyCollision
5243+ BBA3 20 07            JR NZ, .tbxFail
5244+ BBA5 CD ED BB         CALL CheckMonsterOverlap
5245+ BBA8 20 02            JR NZ, .tbxFail
5246+ BBAA AF               XOR A                           ; Z = ok
5247+ BBAB C9               RET
5248+ BBAC              .tbxFail:
5249+ BBAC 3A B5 BB         LD A, (.tbxSavePos)
5250+ BBAF DD 77 03         LD (IX+ENT_POSX), A
5251+ BBB2 F6 01            OR 1                            ; NZ
5252+ BBB4 C9               RET
5253+ BBB5 00           .tbxSavePos: DEFB 0
5254+ BBB6
5255+ BBB6              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5256+ BBB6              TryBackoffY:
5257+ BBB6 DD 7E 04         LD A, (IX+ENT_POSY)
5258+ BBB9 32 EC BB         LD (.tbySavePos), A
5259+ BBBC 47               LD B, A
5260+ BBBD 3A F2 82         LD A, (CorpseY)
5261+ BBC0 B8               CP B
5262+ BBC1 DD 7E 04         LD A, (IX+ENT_POSY)
5263+ BBC4 30 04            JR NC, .tbyNeg
5264+ BBC6 C6 10            ADD A, 16
5265+ BBC8 18 02            JR .tbyApply
5266+ BBCA              .tbyNeg:
5267+ BBCA D6 10            SUB 16
5268+ BBCC              .tbyApply:
5269+ BBCC DD 77 04         LD (IX+ENT_POSY), A
5270+ BBCF FE 10            CP SCREEN_MIN_Y
5271+ BBD1 38 10            JR C, .tbyFail
5272+ BBD3 FE A8            CP SCREEN_MAX_Y
5273+ BBD5 30 0C            JR NC, .tbyFail
5274+ BBD7 CD 77 B6         CALL CheckEnemyCollision
5275+ BBDA 20 07            JR NZ, .tbyFail
5276+ BBDC CD ED BB         CALL CheckMonsterOverlap
5277+ BBDF 20 02            JR NZ, .tbyFail
5278+ BBE1 AF               XOR A
5279+ BBE2 C9               RET
5280+ BBE3              .tbyFail:
5281+ BBE3 3A EC BB         LD A, (.tbySavePos)
5282+ BBE6 DD 77 04         LD (IX+ENT_POSY), A
5283+ BBE9 F6 01            OR 1
5284+ BBEB C9               RET
5285+ BBEC 00           .tbySavePos: DEFB 0
5286+ BBED
5287+ BBED              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5288+ BBED              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5289+ BBED              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5290+ BBED              CheckMonsterOverlap:
5291+ BBED C5               PUSH BC
5292+ BBEE FD E5            PUSH IY
5293+ BBF0 FD 21 AB 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5294+ BBF4 06 06            LD B, NUM_MONSTERS
5295+ BBF6              .cmoLoop:
5296+ BBF6                  ; Skip self (IY == IX)
5297+ BBF6 DD E5            PUSH IX
5298+ BBF8 E1               POP HL
5299+ BBF9 FD E5            PUSH IY
5300+ BBFB D1               POP DE
5301+ BBFC B7               OR A
5302+ BBFD ED 52            SBC HL, DE
5303+ BBFF 28 3D            JR Z, .cmoNext                  ; same slot
5304+ BC01
5305+ BC01 FD 7E 01         LD A, (IY+ENT_TYPE)
5306+ BC04 FE 02            CP TYPE_MONSTER
5307+ BC06 20 36            JR NZ, .cmoNext
5308+ BC08
5309+ BC08                  ; AABB overlap (rect 16x21 cada uno):
5310+ BC08                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5311+ BC08                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5312+ BC08 DD 7E 03         LD A, (IX+ENT_POSX)
5313+ BC0B C6 10            ADD A, 16
5314+ BC0D 4F               LD C, A
5315+ BC0E FD 7E 03         LD A, (IY+ENT_POSX)
5316+ BC11 B9               CP C                            ; iy.x cmp ix.x+16
5317+ BC12 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5318+ BC14 FD 7E 03         LD A, (IY+ENT_POSX)
5319+ BC17 C6 10            ADD A, 16
5320+ BC19 4F               LD C, A
5321+ BC1A DD 7E 03         LD A, (IX+ENT_POSX)
5322+ BC1D B9               CP C
5323+ BC1E 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5324+ BC20 DD 7E 04         LD A, (IX+ENT_POSY)
5325+ BC23 C6 15            ADD A, 21
5326+ BC25 4F               LD C, A
5327+ BC26 FD 7E 04         LD A, (IY+ENT_POSY)
5328+ BC29 B9               CP C
5329+ BC2A 30 12            JR NC, .cmoNext
5330+ BC2C FD 7E 04         LD A, (IY+ENT_POSY)
5331+ BC2F C6 15            ADD A, 21
5332+ BC31 4F               LD C, A
5333+ BC32 DD 7E 04         LD A, (IX+ENT_POSY)
5334+ BC35 B9               CP C
5335+ BC36 30 06            JR NC, .cmoNext
5336+ BC38                  ; Overlap en ambos ejes
5337+ BC38 FD E1            POP IY
5338+ BC3A C1               POP BC
5339+ BC3B F6 01            OR 1                            ; NZ
5340+ BC3D C9               RET
5341+ BC3E              .cmoNext:
5342+ BC3E 11 10 00         LD DE, ENT_SIZE
5343+ BC41 FD 19            ADD IY, DE
5344+ BC43 10 B1            DJNZ .cmoLoop
5345+ BC45 FD E1            POP IY
5346+ BC47 C1               POP BC
5347+ BC48 AF               XOR A                           ; Z = no overlap
5348+ BC49 C9               RET
5349+ BC4A
5350+ BC4A              ; ==============================================================================
5351+ BC4A              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5352+ BC4A              ; ==============================================================================
5353+ BC4A              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5354+ BC4A              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5355+ BC4A              ; ==============================================================================
5356+ BC4A              KillAllActiveMonsters:
5357+ BC4A AF               XOR A
5358+ BC4B 32 12 B3         LD (MonstersActive), A              ; No respawnear mas
5359+ BC4E DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5360+ BC52 06 06            LD B, NUM_MONSTERS
5361+ BC54              .kamLoop:
5362+ BC54 C5               PUSH BC
5363+ BC55 DD 7E 01         LD A, (IX+ENT_TYPE)
5364+ BC58 B7               OR A
5365+ BC59 28 27            JR Z, .kamSkip                      ; slot vacio
5366+ BC5B FE 02            CP TYPE_MONSTER
5367+ BC5D 20 23            JR NZ, .kamSkip                     ; no es monster
5368+ BC5F DD 7E 02         LD A, (IX+ENT_STATE)
5369+ BC62 FE 03            CP STATE_DYING
5370+ BC64 28 1C            JR Z, .kamSkip
5371+ BC66 FE 04            CP STATE_SPAWNING
5372+ BC68 28 18            JR Z, .kamSkip
5373+ BC6A DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5374+ BC6E DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5375+ BC72 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5376+ BC76 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5377+ BC7A DD 36 06 00      LD (IX+ENT_DELTAX), 0
5378+ BC7E DD 36 07 00      LD (IX+ENT_DELTAY), 0
5379+ BC82                  ; ENT_ATTR conservado: puff hereda color del monster
5380+ BC82              .kamSkip:
5381+ BC82 11 10 00         LD DE, ENT_SIZE
5382+ BC85 DD 19            ADD IX, DE
5383+ BC87 C1               POP BC
5384+ BC88 10 CA            DJNZ .kamLoop
5385+ BC8A C9               RET
