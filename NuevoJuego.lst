 562+ E831              ; TownGateDrawPlayerHere / TownGateRedrawPlayer / TownGateErasePlayer:
 563+ E831              ; viven en slot 1 (town_gate_cutscene.asm) — llamadas por bank_cutscene via
 564+ E831              ; TownGateRedrawPlayer_B7. Aqui las omitimos para evitar duplicacion.
 565+ E831
 566+ E831              ; ==============================================================================
 567+ E831              ; TownGateOpenDoor - erase puerta cerrada v2 (id 246) + dibuja open (id 250)
 568+ E831              ; ==============================================================================
 569+ E831              ; 1. Erase del closed v2 (in PickupTable) via RedrawPickupByPtr (XOR self-cancel
 570+ E831              ;    al haberse dibujado ya en el render normal de la sala).
 571+ E831              ; 2. Direct-write del open (NO en PickupTable, hardcodeado en char 14,17) via
 572+ E831              ;    DrawBgGfxSprite (que decodifica RLE + pinta attrs).
 573+ E831              ; Bank 3 para ambos (sprites baseline town).
 574+ E831              ; Destruye: AF, BC, DE, HL, IX.
 575+ E831              ; ==============================================================================
 576+ E831              TownGateOpenDoor:
 577+ E831 11 67 E5         LD DE, BgGfx_town_gate_door_closed_v2
 578+ E834 CD 23 6D         CALL RedrawPickupByPtr_B7               ; XOR-erase del closed
 579+ E837                  ; Fall-through a TownGateRedrawOpenDoor
 580+ E837
 581+ E837              ; ==============================================================================
 582+ E837              ; TownGateRedrawOpenDoor - direct-write del open door en (14, 17)
 583+ E837              ; ==============================================================================
 584+ E837              ; Usado al final del slide-out: el player paint sus attrs sobre cols 14-16, y
 585+ E837              ; RestoreOldAttr restaura desde CleanAttrMap (no desde el door). Re-emitir
 586+ E837              ; el open door restaura attrs originales en sus 4 cols + pixels.
 587+ E837              ; ==============================================================================
 588+ E837              TownGateRedrawOpenDoor:
 589+ E837 21 47 E9         LD HL, BgGfx_town_gate_door_open
 590+ E83A 3E 03            LD A, 3
 591+ E83C CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 592+ E83F DD 21 EE 86      LD IX, BgSpriteBuffer
 593+ E843 06 0E            LD B, TGCS_DOOR_CHARX
 594+ E845 0E 11            LD C, TGCS_DOOR_CHARY
 595+ E847                  ; BgSpriteIsHouse=0, CurrentTintVar=0 escritas dentro de DrawBgGfxSpriteBlackTint_B7
 596+ E847                  ; (esas vars viven en bank 0, no se pueden escribir desde bank 7 sin paginar).
 597+ E847 C3 A4 6D         JP DrawBgGfxSpriteBlackTint_B7
 598+ E84A
 599+ E84A              ; TownGateAllNastiesDeadCheck: vive en slot 1 (town_gate_cutscene.asm) —
 600+ E84A              ; llamada por bank_cutscene directamente (CALL TownGateAllNastiesDeadCheck).
 601+ E84A              ; Es safe sin _B7 wrap porque NO toca paging.
 602+ E84A
 603+ E84A              ; TownGatePlayerXOR_BiClip: vive en slot 1 (usada por TownGatePlayerSlideErase
 604+ E84A              ; y SlideDraw que viven en slot 1). El body bank 7 no la llama directamente.
 605+ E84A
 606+ E84A              ; TownGatePlayerSlideErase / SlideDraw: viven en slot 1 (paginan bank 6
 607+ E84A              ; internamente con OUT, no se pueden mover a bank 7 sin reorganizacion mayor).
 608+ E84A              ; El body bank 7 las llama via TownGatePlayerSlideErase_B7 / SlideDraw_B7.
 609+ E84A
 610+ E84A              ; ==============================================================================
 611+ E84A              ; TownGateShakeStep - shake 2D random ±1 H/V de arm + finger
 612+ E84A              ; ==============================================================================
 613+ E84A              ; 1. Erase last drawn (XOR draw en TownGateShakeOffsX/Y actuales).
 614+ E84A              ;    Primera iteracion: offsets son (0,0), erase a la posicion exacta donde
 615+ E84A              ;    los dibujo RedrawPickupByPtr en phases 2/3 (XOR self-cancel).
 616+ E84A              ; 2. Compute new offset random.
 617+ E84A              ; 3. Draw at new offset.
 618+ E84A              ; Destruye: AF, BC, DE, HL, IX.
 619+ E84A              ; ==============================================================================
 620+ E84A              TownGateShakeStep:
 621+ E84A CD 92 E8         CALL TownGateDrawArmShifted          ; erase last (XOR cancel)
 622+ E84D CD AD E8         CALL TownGateDrawFingerShifted
 623+ E850                  ; Compute new offsets via R y GameFrameCounter (lookup en .tgssJitterTable)
 624+ E850 ED 5F            LD A, R
 625+ E852 E6 03            AND $03
 626+ E854 21 75 E8         LD HL, .tgssJitterTable
 627+ E857 5F               LD E, A
 628+ E858 16 00            LD D, 0
 629+ E85A 19               ADD HL, DE
 630+ E85B 7E               LD A, (HL)
 631+ E85C 32 A6 5F         LD (TownGateShakeOffsX), A
 632+ E85F 3A 91 81         LD A, (GameFrameCounter)
 633+ E862 E6 03            AND $03
 634+ E864 21 75 E8         LD HL, .tgssJitterTable
 635+ E867 5F               LD E, A
 636+ E868 16 00            LD D, 0
 637+ E86A 19               ADD HL, DE
 638+ E86B 7E               LD A, (HL)
 639+ E86C 32 A7 5F         LD (TownGateShakeOffsY), A
 640+ E86F CD 92 E8         CALL TownGateDrawArmShifted          ; draw at new offset
 641+ E872 C3 AD E8         JP TownGateDrawFingerShifted
 642+ E875              .tgssJitterTable:
 643+ E875 00 FF 00 01      DEFB 0, $FF, 0, 1                    ; map(R&3) -> {0, -1, 0, +1}
 644+ E879
 645+ E879              ; ==============================================================================
 646+ E879              ; TownGateShakeRestore - cierra SHAKE: erase last shifted + redraw aligned
 647+ E879              ; ==============================================================================
 648+ E879              ; Garantiza que arm/finger queden en su posicion char-aligned exacta
 649+ E879              ; (la de RedrawPickupByPtr) para las fases siguientes (finger pulse, erases).
 650+ E879              ; ==============================================================================
 651+ E879              TownGateShakeRestore:
 652+ E879 CD 92 E8         CALL TownGateDrawArmShifted          ; erase last shifted
 653+ E87C CD AD E8         CALL TownGateDrawFingerShifted
 654+ E87F AF               XOR A
 655+ E880 32 A6 5F         LD (TownGateShakeOffsX), A
 656+ E883 32 A7 5F         LD (TownGateShakeOffsY), A
 657+ E886 11 0C E5         LD DE, BgGfx_arm
 658+ E889 CD 23 6D         CALL RedrawPickupByPtr_B7               ; restore at PickupTable position
 659+ E88C 11 59 E5         LD DE, BgGfx_finger
 660+ E88F C3 23 6D         JP RedrawPickupByPtr_B7
 661+ E892
 662+ E892              ; ==============================================================================
 663+ E892              ; TownGateDrawArmShifted - XOR draw del arm en (TGCS_ARM_PX_X+offX, +offY)
 664+ E892              ; ==============================================================================
 665+ E892              ; Carga sprite al BgSpriteBuffer + DrawBgSpriteAnyXorAtPixel.
 666+ E892              ; Destruye: AF, BC, DE, HL, IX.
 667+ E892              ; ==============================================================================
 668+ E892              TownGateDrawArmShifted:
 669+ E892 21 0C E5         LD HL, BgGfx_arm
 670+ E895 3E 03            LD A, 3
 671+ E897 CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 672+ E89A 3A A6 5F         LD A, (TownGateShakeOffsX)
 673+ E89D 47               LD B, A
 674+ E89E 3E 88            LD A, TGCS_ARM_PX_X
 675+ E8A0 80               ADD A, B
 676+ E8A1 5F               LD E, A
 677+ E8A2 3A A7 5F         LD A, (TownGateShakeOffsY)
 678+ E8A5 47               LD B, A
 679+ E8A6 3E 40            LD A, TGCS_ARM_PX_Y                 ; ya es pixel Y final, sin BG offset
 680+ E8A8 80               ADD A, B
 681+ E8A9 57               LD D, A
 682+ E8AA C3 C8 E8         JP DrawBgSpriteAnyXorAtPixel
 683+ E8AD
 684+ E8AD              ; ==============================================================================
 685+ E8AD              ; TownGateDrawFingerShifted - XOR draw del finger en (TGCS_FINGER_PX_X+offX, +offY)
 686+ E8AD              ; ==============================================================================
 687+ E8AD              TownGateDrawFingerShifted:
 688+ E8AD 21 59 E5         LD HL, BgGfx_finger
 689+ E8B0 3E 03            LD A, 3
 690+ E8B2 CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 691+ E8B5 3A A6 5F         LD A, (TownGateShakeOffsX)
 692+ E8B8 47               LD B, A
 693+ E8B9 3E 88            LD A, TGCS_FINGER_PX_X
 694+ E8BB 80               ADD A, B
 695+ E8BC 5F               LD E, A
 696+ E8BD 3A A7 5F         LD A, (TownGateShakeOffsY)
 697+ E8C0 47               LD B, A
 698+ E8C1 3E 38            LD A, TGCS_FINGER_PX_Y              ; ya es pixel Y final, sin BG offset
 699+ E8C3 80               ADD A, B
 700+ E8C4 57               LD D, A
 701+ E8C5 C3 C8 E8         JP DrawBgSpriteAnyXorAtPixel
 702+ E8C8
 703+ E8C8              ; ==============================================================================
 704+ E8C8              ; DrawBgSpriteAnyXorAtPixel - generaliza DrawBgSprite16XorAtPixel a N bytes
 705+ E8C8              ; ==============================================================================
 706+ E8C8              ; IN: BgSpriteBuffer pre-cargado (header height/width + pixel data CPL'd).
 707+ E8C8              ;     D = pixel Y (0..191, no aplica BG_Y_OFFSET — el caller suma si aplica).
 708+ E8C8              ;     E = pixel X (0..255).
 709+ E8C8              ; XOR de pixels (no toca attrs). Soporta width 1..N bytes.
 710+ E8C8              ; Para shift > 0 escribe (width+1) bytes por scan line; para shift = 0 escribe
 711+ E8C8              ; width bytes. Igual que DrawBgSprite16XorAtPixel pero con loop por width.
 712+ E8C8              ; Destruye: AF, BC, DE, HL, IX.
 713+ E8C8              ; ==============================================================================
 714+ E8C8              DrawBgSpriteAnyXorAtPixel:
 715+ E8C8 DD 21 EE 86      LD IX, BgSpriteBuffer
 716+ E8CC DD 7E 00         LD A, (IX+0)                        ; height_px
 717+ E8CF B7               OR A
 718+ E8D0 C8               RET Z
 719+ E8D1 32 2B E9         LD (.dbsaHeight), A
 720+ E8D4 DD 7E 01         LD A, (IX+1)                        ; width_bytes (bit 7 RLE → ignorar)
 721+ E8D7 E6 7F            AND $7F
 722+ E8D9 32 2C E9         LD (.dbsaWidth), A
 723+ E8DC DD 23            INC IX
 724+ E8DE DD 23            INC IX                              ; -> pixel data
 725+ E8E0 7B               LD A, E
 726+ E8E1 E6 07            AND $07
 727+ E8E3 32 2D E9         LD (.dbsaShift), A
 728+ E8E6 7B               LD A, E
 729+ E8E7 E6 F8            AND $F8
 730+ E8E9 5F               LD E, A
 731+ E8EA CD 53 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 732+ E8ED              .dbsaRow:
 733+ E8ED E5               PUSH HL
 734+ E8EE 3A 2C E9         LD A, (.dbsaWidth)
 735+ E8F1 47               LD B, A                             ; B = width counter
 736+ E8F2 0E 00            LD C, 0                             ; C = carry from prev byte
 737+ E8F4              .dbsaByte:
 738+ E8F4 DD 7E 00         LD A, (IX+0)
 739+ E8F7 2F               CPL                                 ; un-invert
 740+ E8F8 57               LD D, A                             ; D = sprite byte
 741+ E8F9 1E 00            LD E, 0                             ; E = bits que caen al next byte
 742+ E8FB 3A 2D E9         LD A, (.dbsaShift)
 743+ E8FE B7               OR A
 744+ E8FF 28 09            JR Z, .dbsaNoShift
 745+ E901 C5               PUSH BC
 746+ E902 47               LD B, A
 747+ E903              .dbsaShiftLoop:
 748+ E903 CB 3A            SRL D
 749+ E905 CB 1B            RR E
 750+ E907 10 FA            DJNZ .dbsaShiftLoop
 751+ E909 C1               POP BC
 752+ E90A              .dbsaNoShift:
 753+ E90A 7A               LD A, D
 754+ E90B B1               OR C                                ; combinar con carry previo
 755+ E90C AE               XOR (HL)
 756+ E90D 77               LD (HL), A
 757+ E90E 23               INC HL
 758+ E90F 4B               LD C, E                             ; nuevo carry para siguiente byte
 759+ E910 DD 23            INC IX
 760+ E912 10 E0            DJNZ .dbsaByte
 761+ E914                  ; Byte final (carry) si shift > 0
 762+ E914 3A 2D E9         LD A, (.dbsaShift)
 763+ E917 B7               OR A
 764+ E918 28 03            JR Z, .dbsaNoFinal
 765+ E91A 79               LD A, C
 766+ E91B AE               XOR (HL)
 767+ E91C 77               LD (HL), A
 768+ E91D              .dbsaNoFinal:
 769+ E91D E1               POP HL
 770+ E91E CD BF 9A         CALL NextPixelLine
 771+ E921 3A 2B E9         LD A, (.dbsaHeight)
 772+ E924 3D               DEC A
 773+ E925 32 2B E9         LD (.dbsaHeight), A
 774+ E928 20 C3            JR NZ, .dbsaRow
 775+ E92A C9               RET
 776+ E92B 00           .dbsaHeight: DEFB 0
 777+ E92C 00           .dbsaWidth:  DEFB 0
 778+ E92D 00           .dbsaShift:  DEFB 0
 779+ E92E
 780+ E92E              ; ==============================================================================
 781+ E92E              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
 782+ E92E              ; ==============================================================================
 783+ E92E              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
 784+ E92E              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
 785+ E92E              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
 786+ E92E              ; visualmente la mitad inferior del player desaparece tras la HUD.
 787+ E92E              ; ==============================================================================
 788+ E92E              TownGateExitStep:
 789+ E92E 3A A8 5F         LD A, (TownGateExitStepCnt)
 790+ E931 3C               INC A
 791+ E932 32 A8 5F         LD (TownGateExitStepCnt), A
 792+ E935 FE 02            CP TGCS_T_EXIT_STEP
 793+ E937 D8               RET C                               ; aun no toca step
 794+ E938 AF               XOR A
 795+ E939 32 A8 5F         LD (TownGateExitStepCnt), A
 796+ E93C                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
 797+ E93C DD 21 94 81      LD IX, EntityTable
 798+ E940 DD 7E 04         LD A, (IX+ENT_POSY)
 799+ E943 3C               INC A
 800+ E944 DD 77 04         LD (IX+ENT_POSY), A
 801+ E947 32 D5 82         LD (PlayerDrawY), A
 802+ E94A 3A A9 5F         LD A, (TownGateExitWalkFrame)
 803+ E94D EE 01            XOR 1                               ; toggle 0/1
 804+ E94F 32 A9 5F         LD (TownGateExitWalkFrame), A
 805+ E952 47               LD B, A
 806+ E953 3E 0E            LD A, SPRID_WALK_S
 807+ E955 80               ADD A, B
 808+ E956 DD 77 00         LD (IX+ENT_SPRITEID), A
 809+ E959                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
 810+ E959                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
 811+ E959                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
 812+ E959                  ; part1 attrs ni de door attrs.
 813+ E959 CD 98 6D         CALL TownGatePlayerSlideErase_B7
 814+ E95C C3 9E 6D         JP TownGatePlayerSlideDraw_B7       ; tail call via thunk (paging-safe desde bank 7)
 815+ E95F
 816+ E95F              ; ==============================================================================
 817+ E95F              ; TownGateDrawTheEnd - dibuja el sprite "The End" en (TGCS_END_CHARX, _Y)
 818+ E95F              ; ==============================================================================
 819+ E95F              ; El sprite original "the end" (id 243, 88x72=891 B) se troceo en dos partes
 820+ E95F              ; horizontales para no consumir el 87% de BgSpriteBuffer:
 821+ E95F              ;   - the_end_part1 (id 47, 88x32 = 11x4 chars, 396 B): mitad superior.
 822+ E95F              ;   - the_end_part2 (id 48, 88x40 = 11x5 chars, 495 B): mitad inferior.
 823+ E95F              ; Bank 3. RLE-comprimidos (bit 7 de width_bytes set), asi que NO podemos
 824+ E95F              ; usar DrawBgSpriteXOR (produce distorsion). Usamos DrawBgGfxSprite, la
 825+ E95F              ; rutina normal de render BG: decodifica RLE + pinta pixels + attrs.
 826+ E95F              ; Destruye: AF, BC, DE, HL, IX.
 827+ E95F              ; ==============================================================================
 828+ E95F              TownGateDrawTheEnd:
 829+ E95F                  ; --- Part 1: mitad superior (11x4 chars) ---
 830+ E95F 21 AA EF         LD HL, BgGfx_the_end_part1
 831+ E962 3E 03            LD A, 3
 832+ E964 CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 833+ E967 DD 21 EE 86      LD IX, BgSpriteBuffer
 834+ E96B 06 0B            LD B, TGCS_END_CHARX
 835+ E96D 0E 04            LD C, TGCS_END_CHARY
 836+ E96F CD A4 6D         CALL DrawBgGfxSpriteBlackTint_B7    ; flags=0 escritas dentro del thunk
 837+ E972
 838+ E972                  ; --- Part 2: mitad inferior (11x5 chars), 4 chars debajo de part1 ---
 839+ E972 21 3B F1         LD HL, BgGfx_the_end_part2
 840+ E975 3E 03            LD A, 3
 841+ E977 CD 47 6D         CALL LoadBgSpriteToBuffer_B7
 842+ E97A DD 21 EE 86      LD IX, BgSpriteBuffer
 843+ E97E 06 0B            LD B, TGCS_END_CHARX
 844+ E980 0E 08            LD C, TGCS_END_CHARY + 4
 845+ E982 C3 A4 6D         JP DrawBgGfxSpriteBlackTint_B7      ; tail call
 846+ E985
 847+ E985              ; ==============================================================================
 848+ E985              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
 849+ E985              ; ==============================================================================
 850+ E985              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
 851+ E985              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
 852+ E985              ; quedara visible sobre fondo negro.
 853+ E985              ; ==============================================================================
 854+ E985              TownGateWipeBlack:
 855+ E985 21 00 40         LD HL, $4000
 856+ E988 11 01 40         LD DE, $4001
 857+ E98B 01 FF 17         LD BC, $17FF
 858+ E98E 36 00            LD (HL), 0
 859+ E990 ED B0            LDIR
 860+ E992 21 00 58         LD HL, $5800
 861+ E995 11 01 58         LD DE, $5801
 862+ E998 01 FF 02         LD BC, $02FF
 863+ E99B 36 00            LD (HL), $00                        ; ink black, paper black
 864+ E99D ED B0            LDIR
 865+ E99F C9               RET
 866+ E9A0
 867+ E9A0              ; ==============================================================================
 868+ E9A0              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
 869+ E9A0              ; ==============================================================================
 870+ E9A0              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
 871+ E9A0              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
 872+ E9A0              ; (white ink, black paper, bright) para todo el area de texto.
 873+ E9A0              ; ==============================================================================
 874+ E9A0              TownGateDrawCredits:
 875+ E9A0                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
 876+ E9A0 21 00 58         LD HL, $5800
 877+ E9A3 11 01 58         LD DE, $5801
 878+ E9A6 01 FF 02         LD BC, $02FF
 879+ E9A9 36 47            LD (HL), $47
 880+ E9AB ED B0            LDIR
 881+ E9AD                  ; Iterar credits
 882+ E9AD 21 01 EA         LD HL, TownGateCreditsData
 883+ E9B0              .tgdcLoop:
 884+ E9B0 7E               LD A, (HL)
 885+ E9B1 FE FF            CP $FF
 886+ E9B3 C8               RET Z
 887+ E9B4 57               LD D, A                             ; D = row
 888+ E9B5 23               INC HL
 889+ E9B6 7E               LD A, (HL)
 890+ E9B7 5F               LD E, A                             ; E = col
 891+ E9B8 23               INC HL                              ; HL → string
 892+ E9B9 CD BE E9         CALL PrintStringFontAt
 893+ E9BC 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
 894+ E9BE
 895+ E9BE              ; ==============================================================================
 896+ E9BE              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
 897+ E9BE              ; ==============================================================================
 898+ E9BE              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
 899+ E9BE              ; siguiente byte tras el 0 (para que el caller siga iterando).
 900+ E9BE              ; Destruye: AF, BC, DE, HL.
 901+ E9BE              ; OUT: HL apunta al byte tras el 0 terminador.
 902+ E9BE              ; ==============================================================================
 903+ E9BE              PrintStringFontAt:
 904+ E9BE              .psfaCharLoop:
 905+ E9BE 7E               LD A, (HL)
 906+ E9BF 23               INC HL
 907+ E9C0 B7               OR A
 908+ E9C1 C8               RET Z                               ; fin de string
 909+ E9C2 E5               PUSH HL
 910+ E9C3 D5               PUSH DE
 911+ E9C4 CD CC E9         CALL DrawCharFontAt                 ; D=row, E=col, A=char
 912+ E9C7 D1               POP DE
 913+ E9C8 E1               POP HL
 914+ E9C9 1C               INC E                               ; siguiente columna
 915+ E9CA 18 F2            JR .psfaCharLoop
 916+ E9CC
 917+ E9CC              ; ==============================================================================
 918+ E9CC              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
 919+ E9CC              ; ==============================================================================
 920+ E9CC              ; D = row (0..23), E = col (0..31), A = ASCII char.
 921+ E9CC              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
 922+ E9CC              ;   y = row * 8, x = col * 8
 923+ E9CC              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
 924+ E9CC              ; El char se renderiza con direct write (sobrescribe pixels y attr).
 925+ E9CC              ; Destruye: AF, BC, DE, HL.
 926+ E9CC              ; ==============================================================================
 927+ E9CC              DrawCharFontAt:
 928+ E9CC D5               PUSH DE
 929+ E9CD                  ; HL = $3C00 + char * 8
 930+ E9CD 6F               LD L, A
 931+ E9CE 26 00            LD H, 0
 932+ E9D0 29               ADD HL, HL
 933+ E9D1 29               ADD HL, HL
 934+ E9D2 29               ADD HL, HL
 935+ E9D3 01 00 3C         LD BC, $3C00
 936+ E9D6 09               ADD HL, BC
 937+ E9D7 D1               POP DE
 938+ E9D8                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
 939+ E9D8 E5               PUSH HL                             ; save font ptr
 940+ E9D9 7A               LD A, D
 941+ E9DA 87               ADD A, A
 942+ E9DB 87               ADD A, A
 943+ E9DC 87               ADD A, A                            ; A = row * 8 = pixel Y
 944+ E9DD 57               LD D, A
 945+ E9DE 7B               LD A, E
 946+ E9DF 87               ADD A, A
 947+ E9E0 87               ADD A, A
 948+ E9E1 87               ADD A, A                            ; A = col * 8 = pixel X
 949+ E9E2 5F               LD E, A
 950+ E9E3 CD 53 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
 951+ E9E6 EB               EX DE, HL                           ; DE = VRAM addr
 952+ E9E7 E1               POP HL                              ; HL = font ptr
 953+ E9E8 06 08            LD B, 8
 954+ E9EA              .dcfaLoop:
 955+ E9EA 7E               LD A, (HL)
 956+ E9EB 12               LD (DE), A
 957+ E9EC 23               INC HL
 958+ E9ED 14               INC D                               ; siguiente scan line (within char)
 959+ E9EE 10 FA            DJNZ .dcfaLoop
 960+ E9F0 C9               RET
 961+ E9F1
 962+ E9F1              ; ==============================================================================
