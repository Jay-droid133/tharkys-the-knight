 107  DE00                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ DE00              ; ==============================================================================
   2+ DE00              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ DE00              ; ==============================================================================
   4+ DE00              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ DE00              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ DE00              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ DE00              ; ==============================================================================
   8+ DE00
   9+ DE00              ; --- Constantes ---
  10+ DE00              NUM_TIME_MOMENTS    EQU 7
  11+ DE00
  12+ DE00              ; --- Variables ---
  13+ DE00 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ DE01 79 E1        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ DE03 79 E1        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ DE05 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ DE06 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ DE07
  19+ DE07              ; ==============================================================================
  20+ DE07              ; SetTimeOfDay - Cambia el momento del dia
  21+ DE07              ; ==============================================================================
  22+ DE07              ; Entrada: A = momento (0-6)
  23+ DE07              ; ==============================================================================
  24+ DE07              SetTimeOfDay:
  25+ DE07 32 00 DE         LD (CurrentTimeOfDay), A
  26+ DE0A
  27+ DE0A                  ; DY (fase 0): incrementar ciclo de dia
  28+ DE0A B7               OR A
  29+ DE0B 20 04            JR NZ, .notNewCycle
  30+ DE0D 21 75 A1         LD HL, DayCycleCount
  31+ DE10 34               INC (HL)
  32+ DE11              .notNewCycle:
  33+ DE11
  34+ DE11                  ; N2 (medianoche): campanadas primero, remap al terminar
  35+ DE11 FE 04            CP 4
  36+ DE13 28 13            JR Z, .bellsFirst
  37+ DE15
  38+ DE15                  ; Amanecer temprano (fase 5): despawnear monsters
  39+ DE15 FE 05            CP 5
  40+ DE17 20 03            JR NZ, .noDespawn
  41+ DE19 CD 8F A1         CALL ScareAllMonsters
  42+ DE1C              .noDespawn:
  43+ DE1C
  44+ DE1C                  ; Actualizar tablas de remap y tabla de nasties
  45+ DE1C CD 2C DE         CALL UpdateRemapTables
  46+ DE1F CD 78 A1         CALL UpdateNastyTable
  47+ DE22
  48+ DE22                  ; Forzar remap de atributos (sin redibujar pixeles)
  49+ DE22 3E 01            LD A, 1
  50+ DE24 32 B2 81         LD (AttrsDirty), A
  51+ DE27 C9               RET
  52+ DE28
  53+ DE28              .bellsFirst:
  54+ DE28                  ; NO actualizar tablas: mantener colores de N1 durante campanadas
  55+ DE28 CD AE E7         CALL StartBellChimes
  56+ DE2B C9               RET
  57+ DE2C
  58+ DE2C              ; ==============================================================================
  59+ DE2C              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
  60+ DE2C              ; ==============================================================================
  61+ DE2C              UpdateRemapTables:
  62+ DE2C 3A 00 DE         LD A, (CurrentTimeOfDay)
  63+ DE2F 21 4D E1         LD HL, RemapTablePtrs
  64+ DE32 5F               LD E, A
  65+ DE33 16 00            LD D, 0
  66+ DE35 19               ADD HL, DE
  67+ DE36 19               ADD HL, DE
  68+ DE37 5E               LD E, (HL)
  69+ DE38 23               INC HL
  70+ DE39 56               LD D, (HL)
  71+ DE3A ED 53 01 DE      LD (CurrentRemapTable), DE
  72+ DE3E
  73+ DE3E 3A 00 DE         LD A, (CurrentTimeOfDay)
  74+ DE41 21 5B E1         LD HL, RemapHouseTablePtrs
  75+ DE44 5F               LD E, A
  76+ DE45 16 00            LD D, 0
  77+ DE47 19               ADD HL, DE
  78+ DE48 19               ADD HL, DE
  79+ DE49 5E               LD E, (HL)
  80+ DE4A 23               INC HL
  81+ DE4B 56               LD D, (HL)
  82+ DE4C ED 53 03 DE      LD (CurrentHouseRemapTable), DE
  83+ DE50 C9               RET
  84+ DE51
  85+ DE51              ; ==============================================================================
  86+ DE51              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
  87+ DE51              ; ==============================================================================
  88+ DE51              CheckDebugKeys:
  89+ DE51 3E FB            LD A, $FB
  90+ DE53 DB FE            IN A, ($FE)
  91+ DE55 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
  92+ DE57 20 1C            JR NZ, .notPressed
  93+ DE59
  94+ DE59                  ; Tecla pulsada: comprobar debounce
  95+ DE59 3A 06 DE         LD A, (DebugKeyDebounce)
  96+ DE5C B7               OR A
  97+ DE5D C0               RET NZ                  ; Ya estaba pulsada, ignorar
  98+ DE5E
  99+ DE5E                  ; Primera pulsacion: ciclar
 100+ DE5E 3E 01            LD A, 1
 101+ DE60 32 06 DE         LD (DebugKeyDebounce), A
 102+ DE63
 103+ DE63 3A 00 DE         LD A, (CurrentTimeOfDay)
 104+ DE66 3C               INC A
 105+ DE67 FE 07            CP NUM_TIME_MOMENTS
 106+ DE69 38 01            JR C, .noWrap
 107+ DE6B AF               XOR A                   ; Volver a 0 (Dia)
 108+ DE6C              .noWrap:
 109+ DE6C F5               PUSH AF
 110+ DE6D CD 07 DE         CALL SetTimeOfDay
 111+ DE70 F1               POP AF
 112+ DE71 CD 57 E4         CALL SetClockToPhaseHour
 113+ DE74 C9               RET
 114+ DE75
 115+ DE75              .notPressed:
 116+ DE75 AF               XOR A
 117+ DE76 32 06 DE         LD (DebugKeyDebounce), A
 118+ DE79
 119+ DE79                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 120+ DE79 3E FD            LD A, $FD
 121+ DE7B DB FE            IN A, ($FE)
 122+ DE7D 4F               LD C, A                 ; C = estado semi-fila $FDFE
 123+ DE7E CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 124+ DE80 20 13            JR NZ, .sNotPressed
 125+ DE82 3A B1 DE         LD A, (SpeedKeyDebounce)
 126+ DE85 B7               OR A
 127+ DE86 C0               RET NZ
 128+ DE87 3E 01            LD A, 1
 129+ DE89 32 B1 DE         LD (SpeedKeyDebounce), A
 130+ DE8C 21 75 A1         LD HL, DayCycleCount
 131+ DE8F 7E               LD A, (HL)
 132+ DE90 FE 0A            CP 10
 133+ DE92 D0               RET NC                  ; Ya en maximo
 134+ DE93 34               INC (HL)
 135+ DE94 C9               RET
 136+ DE95              .sNotPressed:
 137+ DE95                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 138+ DE95 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 139+ DE97 20 13            JR NZ, .dNotPressed
 140+ DE99 3A B1 DE         LD A, (SpeedKeyDebounce)
 141+ DE9C B7               OR A
 142+ DE9D C0               RET NZ
 143+ DE9E 3E 01            LD A, 1
 144+ DEA0 32 B1 DE         LD (SpeedKeyDebounce), A
 145+ DEA3 21 75 A1         LD HL, DayCycleCount
 146+ DEA6 7E               LD A, (HL)
 147+ DEA7 FE 01            CP 1
 148+ DEA9 C8               RET Z                   ; Ya en minimo
 149+ DEAA 35               DEC (HL)
 150+ DEAB C9               RET
 151+ DEAC              .dNotPressed:
 152+ DEAC AF               XOR A
 153+ DEAD 32 B1 DE         LD (SpeedKeyDebounce), A
 154+ DEB0 C9               RET
 155+ DEB1
 156+ DEB1 00           SpeedKeyDebounce: DEFB 0
 157+ DEB2
 158+ DEB2              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 159+ DEB2              DrawSwordModeHUD:
 160+ DEB2 3A 1E 9C         LD A, (SwordMode)
 161+ DEB5 21 E5 DE         LD HL, .modeChars
 162+ DEB8 5F               LD E, A
 163+ DEB9 16 00            LD D, 0
 164+ DEBB 19               ADD HL, DE
 165+ DEBC 7E               LD A, (HL)                          ; A = ASCII del modo
 166+ DEBD                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 167+ DEBD 21 00 40         LD HL, $4000
 168+ DEC0                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 169+ DEC0 5F               LD E, A
 170+ DEC1 16 00            LD D, 0
 171+ DEC3 42               LD B, D                             ; B = 0
 172+ DEC4 CB 23            SLA E
 172+ DEC6 CB 12          RL D                        ; *2
 173+ DEC8 CB 23            SLA E
 173+ DECA CB 12          RL D                        ; *4
 174+ DECC CB 23            SLA E
 174+ DECE CB 12          RL D                        ; *8
 175+ DED0 E5               PUSH HL
 176+ DED1 21 00 3C         LD HL, $3C00
 177+ DED4 19               ADD HL, DE                          ; HL = direccion del glyph
 178+ DED5 EB               EX DE, HL                           ; DE = glyph
 179+ DED6 E1               POP HL                              ; HL = VRAM
 180+ DED7 06 08            LD B, 8
 181+ DED9              .drawChar:
 182+ DED9 1A               LD A, (DE)
 183+ DEDA 77               LD (HL), A
 184+ DEDB 13               INC DE
 185+ DEDC 24               INC H                               ; siguiente scan line
 186+ DEDD 10 FA            DJNZ .drawChar
 187+ DEDF                  ; Attr: fila 0, col 0 = $5800
 188+ DEDF 3E 47            LD A, $47                           ; blanco bright
 189+ DEE1 32 00 58         LD ($5800), A
 190+ DEE4 C9               RET
 191+ DEE5
 192+ DEE5 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 193+ DEE8
 194+ DEE8              ; ==============================================================================
 195+ DEE8              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 196+ DEE8              ; ==============================================================================
 197+ DEE8              ; Entrada: A = attr original
 198+ DEE8              ; Salida:  A = attr transformado
 199+ DEE8              ; Preserva: HL, DE, BC, IX
 200+ DEE8              ; ==============================================================================
 201+ DEE8              ApplyDayCycleRemap:
 202+ DEE8 E5               PUSH HL
 203+ DEE9 67               LD H, A                     ; H = attr (temp save)
 204+ DEEA 3A 00 DE         LD A, (CurrentTimeOfDay)
 205+ DEED B7               OR A
 206+ DEEE 20 03            JR NZ, .doRemap
 207+ DEF0 7C               LD A, H                     ; Dia: devolver sin cambio
 208+ DEF1 E1               POP HL
 209+ DEF2 C9               RET
 210+ DEF3
 211+ DEF3              .doRemap:
 212+ DEF3 D5               PUSH DE
 213+ DEF4 C5               PUSH BC
 214+ DEF5
 215+ DEF5 7C               LD A, H                     ; A = attr original
 216+ DEF6 4F               LD C, A                     ; C = attr original
 217+ DEF7
 218+ DEF7                  ; Guardar flash + ink (bits 7, 2-0)
 219+ DEF7 E6 87            AND $87                     ; A = F000_0III
 220+ DEF9 47               LD B, A                     ; B = flash | ink
 221+ DEFA
 222+ DEFA                  ; Extraer paper+bright como indice 0-15
 223+ DEFA 79               LD A, C
 224+ DEFB E6 78            AND $78                     ; A = 0BPPP000
 225+ DEFD 0F               RRCA
 226+ DEFE 0F               RRCA
 227+ DEFF 0F               RRCA                        ; A = 0000BPPP = indice
 228+ DF00
 229+ DF00                  ; Elegir tabla segun tipo de sprite
 230+ DF00 5F               LD E, A
 231+ DF01 16 00            LD D, 0
 232+ DF03 3A 05 DE         LD A, (BgSpriteIsHouse)
 233+ DF06 B7               OR A
 234+ DF07 28 05            JR Z, .useStdTable
 235+ DF09 2A 03 DE         LD HL, (CurrentHouseRemapTable)
 236+ DF0C 18 03            JR .doLookup
 237+ DF0E              .useStdTable:
 238+ DF0E 2A 01 DE         LD HL, (CurrentRemapTable)
 239+ DF11              .doLookup:
 240+ DF11 19               ADD HL, DE
 241+ DF12 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 242+ DF13
 243+ DF13                  ; Reconstruir atributo
 244+ DF13 07               RLCA
 245+ DF14 07               RLCA
 246+ DF15 07               RLCA                        ; A = 0BPPP000
 247+ DF16 B0               OR B                        ; A = FBPPPIII
 248+ DF17
 249+ DF17 C1               POP BC
 250+ DF18 D1               POP DE
 251+ DF19 E1               POP HL
 252+ DF1A C9               RET
 253+ DF1B
 254+ DF1B              ; ==============================================================================
 255+ DF1B              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 256+ DF1B              ; ==============================================================================
 257+ DF1B              ; Entrada: DE = direccion datos del sprite
 258+ DF1B              ; Setea BgSpriteIsHouse (0 o 1)
 259+ DF1B              ; Preserva: DE, IX
 260+ DF1B              ; ==============================================================================
 261+ DF1B              CheckIfHouseSprite:
 262+ DF1B E5               PUSH HL
 263+ DF1C C5               PUSH BC
 264+ DF1D
 265+ DF1D AF               XOR A
 266+ DF1E 32 05 DE         LD (BgSpriteIsHouse), A     ; Default: no es house
 267+ DF21
 268+ DF21 21 DF BF         LD HL, HouseSpriteList
 269+ DF24              .checkLoop:
 270+ DF24 4E               LD C, (HL)
 271+ DF25 23               INC HL
 272+ DF26 46               LD B, (HL)
 273+ DF27 23               INC HL                      ; BC = direccion sprite house
 274+ DF28 78               LD A, B
 275+ DF29 B1               OR C
 276+ DF2A 28 0D            JR Z, .checkDone            ; Terminador: no encontrado
 277+ DF2C
 278+ DF2C 78               LD A, B
 279+ DF2D BA               CP D
 280+ DF2E 20 F4            JR NZ, .checkLoop
 281+ DF30 79               LD A, C
 282+ DF31 BB               CP E
 283+ DF32 20 F0            JR NZ, .checkLoop
 284+ DF34
 285+ DF34                  ; Encontrado: es house
 286+ DF34 3E 01            LD A, 1
 287+ DF36 32 05 DE         LD (BgSpriteIsHouse), A
 288+ DF39
 289+ DF39              .checkDone:
 290+ DF39 C1               POP BC
 291+ DF3A E1               POP HL
 292+ DF3B C9               RET
 293+ DF3C
 294+ DF3C              ; ==============================================================================
 295+ DF3C              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 296+ DF3C              ; ==============================================================================
 297+ DF3C              ; Formato: XX,YY:NN nombre_room     DY
 298+ DF3C              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 299+ DF3C              ; ==============================================================================
 300+ DF3C              DrawRoomInfo:
 301+ DF3C                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 302+ DF3C 1E 00            LD E, 0
 303+ DF3E 06 0D            LD B, 13
 304+ DF40              .clearLoop:
 305+ DF40 C5               PUSH BC
 306+ DF41 D5               PUSH DE
 307+ DF42 3E 20            LD A, ' '
 308+ DF44 CD 5B E0         CALL DrawHudChar
 309+ DF47 D1               POP DE
 310+ DF48 C1               POP BC
 311+ DF49 1C               INC E
 312+ DF4A 10 F4            DJNZ .clearLoop
 313+ DF4C
 314+ DF4C                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 315+ DF4C 3A AC 81         LD A, (CurrentScreenX)
 316+ DF4F 1E 00            LD E, 0
 317+ DF51 CD AF DF         CALL .drawDec2
 318+ DF54
 319+ DF54                  ; --- ',' en col 2 ---
 320+ DF54 3E 2C            LD A, ','
 321+ DF56 1E 02            LD E, 2
 322+ DF58 CD 5B E0         CALL DrawHudChar
 323+ DF5B
 324+ DF5B                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 325+ DF5B 3A AD 81         LD A, (CurrentScreenY)
 326+ DF5E 1E 03            LD E, 3
 327+ DF60 CD AF DF         CALL .drawDec2
 328+ DF63
 329+ DF63                  ; --- ':' en col 5 ---
 330+ DF63 3E 3A            LD A, ':'
 331+ DF65 1E 05            LD E, 5
 332+ DF67 CD 5B E0         CALL DrawHudChar
 333+ DF6A
 334+ DF6A                  ; --- Obtener room index de MapTable[Y*16+X] ---
 335+ DF6A 3A AD 81         LD A, (CurrentScreenY)
 336+ DF6D 6F               LD L, A
 337+ DF6E 26 00            LD H, 0
 338+ DF70 29               ADD HL, HL
 339+ DF71 29               ADD HL, HL
 340+ DF72 29               ADD HL, HL
 341+ DF73 29               ADD HL, HL                  ; HL = Y * 16
 342+ DF74 3A AC 81         LD A, (CurrentScreenX)
 343+ DF77 5F               LD E, A
 344+ DF78 16 00            LD D, 0
 345+ DF7A 19               ADD HL, DE                  ; HL = Y*16 + X
 346+ DF7B 11 75 B1         LD DE, MapTable
 347+ DF7E 19               ADD HL, DE
 348+ DF7F 7E               LD A, (HL)                  ; A = room index (0-47)
 349+ DF80 F5               PUSH AF                     ; guardar room index
 350+ DF81
 351+ DF81                  ; --- Room index como 2 hex en cols 6-7 ---
 352+ DF81 F5               PUSH AF
 353+ DF82 0F               RRCA
 354+ DF83 0F               RRCA
 355+ DF84 0F               RRCA
 356+ DF85 0F               RRCA
 357+ DF86 E6 0F            AND $0F
 358+ DF88 CD CD DF         CALL .hexToAscii
 359+ DF8B 1E 06            LD E, 6
 360+ DF8D CD 5B E0         CALL DrawHudChar
 361+ DF90 F1               POP AF
 362+ DF91 E6 0F            AND $0F
 363+ DF93 CD CD DF         CALL .hexToAscii
 364+ DF96 1E 07            LD E, 7
 365+ DF98 CD 5B E0         CALL DrawHudChar
 366+ DF9B
 367+ DF9B                  ; --- Espacio en col 8 ---
 368+ DF9B 3E 20            LD A, ' '
 369+ DF9D 1E 08            LD E, 8
 370+ DF9F CD 5B E0         CALL DrawHudChar
 371+ DFA2
 372+ DFA2                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 373+ DFA2 F1               POP AF                      ; A = room index (descartar)
 374+ DFA3
 375+ DFA3                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 376+ DFA3 21 20 58         LD HL, ATTR_BASE + 1 * 32
 377+ DFA6 3E 47            LD A, $47                   ; bright white on black
 378+ DFA8 06 0D            LD B, 13
 379+ DFAA              .attrLoop:
 380+ DFAA 77               LD (HL), A
 381+ DFAB 23               INC HL
 382+ DFAC 10 FC            DJNZ .attrLoop
 383+ DFAE C9               RET
 384+ DFAF
 385+ DFAF              ; --- Helpers ---
 386+ DFAF              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 387+ DFAF              .drawDec2:
 388+ DFAF 4B               LD C, E                     ; guardar columna inicial
 389+ DFB0 06 00            LD B, 0                     ; decenas
 390+ DFB2              .divLoop:
 391+ DFB2 FE 0A            CP 10
 392+ DFB4 38 05            JR C, .divDone
 393+ DFB6 D6 0A            SUB 10
 394+ DFB8 04               INC B
 395+ DFB9 18 F7            JR .divLoop
 396+ DFBB              .divDone:
 397+ DFBB                  ; B = decenas, A = unidades
 398+ DFBB F5               PUSH AF                     ; guardar unidades
 399+ DFBC 78               LD A, B
 400+ DFBD C6 30            ADD A, '0'
 401+ DFBF 59               LD E, C
 402+ DFC0 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 403+ DFC1 CD 5B E0         CALL DrawHudChar
 404+ DFC4 C1               POP BC                      ; restaurar C
 405+ DFC5 F1               POP AF
 406+ DFC6 C6 30            ADD A, '0'
 407+ DFC8 59               LD E, C
 408+ DFC9 1C               INC E
 409+ DFCA C3 5B E0         JP DrawHudChar              ; tail call
 410+ DFCD
 411+ DFCD              .hexToAscii:
 412+ DFCD FE 0A            CP 10
 413+ DFCF 38 03            JR C, .isDigit
 414+ DFD1 C6 37            ADD A, 'A' - 10
 415+ DFD3 C9               RET
 416+ DFD4              .isDigit:
 417+ DFD4 C6 30            ADD A, '0'
 418+ DFD6 C9               RET
 419+ DFD7
 420+ DFD7              ; ==============================================================================
 421+ DFD7              ; DrawDayCycleHUD - Muestra numero de dia en HUD (fila 1, col 28-29)
 422+ DFD7              ; ==============================================================================
 423+ DFD7              DrawDayCycleHUD:
 424+ DFD7                  ; "D" en columna 28
 425+ DFD7 3E 44            LD A, 'D'
 426+ DFD9 1E 1C            LD E, 28
 427+ DFDB CD 5B E0         CALL DrawHudChar
 428+ DFDE                  ; Numero del ciclo en columna 29 (1-9, luego letras)
 429+ DFDE 3A 75 A1         LD A, (DayCycleCount)
 430+ DFE1 FE 0A            CP 10
 431+ DFE3 38 02            JR C, .dchDigit
 432+ DFE5 3E 09            LD A, 9                             ; Cap visual en 9
 433+ DFE7              .dchDigit:
 434+ DFE7 C6 30            ADD A, '0'                          ; Convertir a ASCII
 435+ DFE9 1E 1D            LD E, 29
 436+ DFEB CD 5B E0         CALL DrawHudChar
 437+ DFEE                  ; Atributos (bright white)
 438+ DFEE 3E 47            LD A, $47
 439+ DFF0 32 3C 58         LD (ATTR_BASE + 1 * 32 + 28), A
 440+ DFF3 32 3D 58         LD (ATTR_BASE + 1 * 32 + 29), A
 441+ DFF6 C9               RET
 442+ DFF7
 443+ DFF7              ; ==============================================================================
 444+ DFF7              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 445+ DFF7              ; ==============================================================================
 446+ DFF7              DrawPlayerSpeedHUD:
 447+ DFF7 3A 7C 87         LD A, (PlayerCurrentSpeed)
 448+ DFFA C6 30            ADD A, '0'
 449+ DFFC 1E 02            LD E, 2
 450+ DFFE CD 21 E0         CALL DrawHudCharRow0
 451+ E001                  ; Atributo (bright white)
 452+ E001 3E 47            LD A, $47
 453+ E003 32 02 58         LD (ATTR_BASE + 2), A
 454+ E006 C9               RET
 455+ E007
 456+ E007              ; ==============================================================================
 457+ E007              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 458+ E007              ; ==============================================================================
 459+ E007              DrawEnemySpeedHUD:
 460+ E007                  ; "V" en columna 30
 461+ E007 3E 56            LD A, 'V'
 462+ E009 1E 1E            LD E, 30
 463+ E00B CD 21 E0         CALL DrawHudCharRow0
 464+ E00E                  ; Numero de velocidad en columna 31
 465+ E00E 3A 74 87         LD A, (CurrentEnemySpeed)
 466+ E011 C6 30            ADD A, '0'
 467+ E013 1E 1F            LD E, 31
 468+ E015 CD 21 E0         CALL DrawHudCharRow0
 469+ E018                  ; Atributos (bright white)
 470+ E018 3E 47            LD A, $47
 471+ E01A 32 1E 58         LD (ATTR_BASE + 30), A
 472+ E01D 32 1F 58         LD (ATTR_BASE + 31), A
 473+ E020 C9               RET
 474+ E021
 475+ E021              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 476+ E021              ; A = codigo ASCII, E = columna (0-31)
 477+ E021              DrawHudCharRow0:
 478+ E021 6F               LD L, A
 479+ E022 26 00            LD H, 0
 480+ E024 29               ADD HL, HL
 481+ E025 29               ADD HL, HL
 482+ E026 29               ADD HL, HL
 483+ E027 01 00 3C         LD BC, $3C00
 484+ E02A 09               ADD HL, BC                  ; HL = font data
 485+ E02B 16 40            LD D, $40                   ; Tercio 0, scan line 0
 486+ E02D 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 487+ E02E 5F               LD E, A                     ; DE = dir VRAM
 488+ E02F 06 08            LD B, 8
 489+ E031              .row0Char:
 490+ E031 7E               LD A, (HL)
 491+ E032 12               LD (DE), A
 492+ E033 23               INC HL
 493+ E034 14               INC D                       ; siguiente scan line
 494+ E035 10 FA            DJNZ .row0Char
 495+ E037 C9               RET
 496+ E038
 497+ E038              ; ==============================================================================
 498+ E038              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 499+ E038              ; ==============================================================================
 500+ E038              DrawTimeIndicator:
 501+ E038                  ; Calcular puntero al label de 2 chars
 502+ E038 3A 00 DE         LD A, (CurrentTimeOfDay)
 503+ E03B 87               ADD A, A                    ; A = momento * 2
 504+ E03C 5F               LD E, A
 505+ E03D 16 00            LD D, 0
 506+ E03F 21 3F E1         LD HL, TimeLabels
 507+ E042 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 508+ E043
 509+ E043                  ; Primer caracter en columna 30
 510+ E043 7E               LD A, (HL)
 511+ E044 E5               PUSH HL
 512+ E045 1E 1E            LD E, 30
 513+ E047 CD 5B E0         CALL DrawHudChar
 514+ E04A E1               POP HL
 515+ E04B
 516+ E04B                  ; Segundo caracter en columna 31
 517+ E04B 23               INC HL
 518+ E04C 7E               LD A, (HL)
 519+ E04D 1E 1F            LD E, 31
 520+ E04F CD 5B E0         CALL DrawHudChar
 521+ E052
 522+ E052                  ; Atributos del indicador (bright white on black)
 523+ E052 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 524+ E055 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 525+ E057 77               LD (HL), A
 526+ E058 23               INC HL
 527+ E059 77               LD (HL), A
 528+ E05A C9               RET
 529+ E05B
 530+ E05B              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 531+ E05B              ; A = codigo ASCII, E = columna (0-31)
 532+ E05B              DrawHudChar:
 533+ E05B                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 534+ E05B 6F               LD L, A
 535+ E05C 26 00            LD H, 0
 536+ E05E 29               ADD HL, HL
 537+ E05F 29               ADD HL, HL
 538+ E060 29               ADD HL, HL
 539+ E061 01 00 3C         LD BC, $3C00
 540+ E064 09               ADD HL, BC                  ; HL = font data
 541+ E065
 542+ E065                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 543+ E065 16 40            LD D, $40                   ; Tercio 0, scan line 0
 544+ E067 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 545+ E069 83               ADD A, E
 546+ E06A 5F               LD E, A                     ; DE = dir VRAM
 547+ E06B
 548+ E06B 06 08            LD B, 8
 549+ E06D              .hudCharLoop:
 550+ E06D 7E               LD A, (HL)
 551+ E06E 12               LD (DE), A
 552+ E06F 23               INC HL
 553+ E070 14               INC D                       ; Siguiente scan line
 554+ E071 10 FA            DJNZ .hudCharLoop
 555+ E073 C9               RET
