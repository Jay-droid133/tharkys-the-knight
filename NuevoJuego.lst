 426+ F9D3 C8               RET Z                               ; sigue
 427+ F9D4                  ; grupo 1 terminado → retirarse a ORIG + wait
 428+ F9D4 CD 06 F9         CALL BankCutsceneSnapToRetreat
 429+ F9D7 3E 32            LD A, BCS_T_GROUP_WAIT
 430+ F9D9 32 CD 82         LD (BankCutsceneTimer), A
 431+ F9DC 3E 03            LD A, BCP_WAIT_1
 432+ F9DE 32 CC 82         LD (BankCutscenePhase), A
 433+ F9E1 C9               RET
 434+ F9E2
 435+ F9E2              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 436+ F9E2              .bcPhWait1:
 437+ F9E2 CD 09 FC         CALL BankCutsceneDecTimer
 438+ F9E5 C0               RET NZ
 439+ F9E6                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 440+ F9E6 CD E0 F8         CALL BankCutsceneSnapToDoor
 441+ F9E9 AF               XOR A
 442+ F9EA 32 CF 82         LD (BankCutsceneKnockIdx), A
 443+ F9ED 32 D2 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 444+ F9F0 3E 00            LD A, BCS_KNOCK_HIT
 445+ F9F2 32 CE 82         LD (BankCutsceneSubState), A
 446+ F9F5 3E 04            LD A, BCS_T_KNOCK_HIT
 447+ F9F7 32 CD 82         LD (BankCutsceneTimer), A
 448+ F9FA CD A8 FB         CALL BankCutsceneEmitKnockHit
 449+ F9FD 3E 04            LD A, BCP_KNOCKS_2
 450+ F9FF 32 CC 82         LD (BankCutscenePhase), A
 451+ FA02 C9               RET
