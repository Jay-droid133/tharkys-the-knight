 305+ FC62              NibbleDoubleLUT:
 306+ FC62 00               DEFB %00000000  ; 0000 → 00000000
 307+ FC63 03               DEFB %00000011  ; 0001 → 00000011
 308+ FC64 0C               DEFB %00001100  ; 0010 → 00001100
 309+ FC65 0F               DEFB %00001111  ; 0011 → 00001111
 310+ FC66 30               DEFB %00110000  ; 0100 → 00110000
 311+ FC67 33               DEFB %00110011  ; 0101 → 00110011
 312+ FC68 3C               DEFB %00111100  ; 0110 → 00111100
 313+ FC69 3F               DEFB %00111111  ; 0111 → 00111111
 314+ FC6A C0               DEFB %11000000  ; 1000 → 11000000
 315+ FC6B C3               DEFB %11000011  ; 1001 → 11000011
 316+ FC6C CC               DEFB %11001100  ; 1010 → 11001100
 317+ FC6D CF               DEFB %11001111  ; 1011 → 11001111
 318+ FC6E F0               DEFB %11110000  ; 1100 → 11110000
 319+ FC6F F3               DEFB %11110011  ; 1101 → 11110011
 320+ FC70 FC               DEFB %11111100  ; 1110 → 11111100
 321+ FC71 FF               DEFB %11111111  ; 1111 → 11111111
