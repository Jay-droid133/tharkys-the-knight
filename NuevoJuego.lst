3653+ A70F              ; ==============================================================================
3654+ A70F              ; CountActiveNasties / CountActiveMonsters
3655+ A70F              ; ==============================================================================
3656+ A70F              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
3657+ A70F              ; Ambas usan _CountSlots internamente.
3658+ A70F              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
3659+ A70F              ; ==============================================================================
3660+ A70F              CountActiveNasties:
3661+ A70F 21 0F 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
3662+ A712 06 03            LD B, NUM_NASTIES
3663+ A714 18 05            JR _CountSlots
3664+ A716
3665+ A716              CountActiveMonsters:
3666+ A716 21 AF 80         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
3667+ A719 06 06            LD B, NUM_MONSTERS
3668+ A71B
3669+ A71B              _CountSlots:
3670+ A71B 0E 00            LD C, 0                         ; Contador
3671+ A71D              .countLoop:
3672+ A71D 7E               LD A, (HL)
3673+ A71E B7               OR A
3674+ A71F 28 16            JR Z, .countNext                ; Slot vacio: no contar
3675+ A721                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
3676+ A721 D5               PUSH DE
3677+ A722 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
3678+ A725 19               ADD HL, DE
3679+ A726 7E               LD A, (HL)
3680+ A727 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
3681+ A729 D1               POP DE
3682+ A72A FE 03            CP STATE_DYING
3683+ A72C 28 09            JR Z, .countNext
3684+ A72E FE 04            CP STATE_SPAWNING
3685+ A730 28 05            JR Z, .countNext
3686+ A732 FE 05            CP STATE_SCARED
3687+ A734 28 01            JR Z, .countNext
3688+ A736 0C               INC C
3689+ A737              .countNext:
3690+ A737 11 10 00         LD DE, ENT_SIZE
3691+ A73A 19               ADD HL, DE
3692+ A73B 10 E0            DJNZ .countLoop
3693+ A73D 79               LD A, C
3694+ A73E C9               RET
