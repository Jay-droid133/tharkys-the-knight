 157  6F97
 158  6F97                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 159  6F97                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 160  6F97                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6F97              ; ==============================================================================
   2+ 6F97              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6F97              ; ==============================================================================
   4+ 6F97              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6F97              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6F97              ;
   7+ 6F97              ; Diseño beeper-style:
   8+ 6F97              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6F97              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6F97              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6F97              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6F97              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6F97              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6F97              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6F97              ;     hits clasicos en 48K).
  16+ 6F97              ;   - AY_UpdatePlayerHit se llama cada 2 IRQs (= 25 Hz) desde el handler IM 2
  17+ 6F97              ;     en music_irq.asm (cold path: salta en RET Z si no hay sweep activo).
  18+ 6F97              ;     Tickear desde IRQ inmuniza la duracion del beep frente a la latencia
  19+ 6F97              ;     de MainLoop (transiciones lentas estiraban el beep antes).
  20+ 6F97              ;
  21+ 6F97              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  22+ 6F97              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  23+ 6F97              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  24+ 6F97              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  25+ 6F97              ;
  26+ 6F97              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  27+ 6F97              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  28+ 6F97              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  29+ 6F97              ;
  30+ 6F97              ; Llamado desde:
  31+ 6F97              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  32+ 6F97              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  33+ 6F97              ;   - MainLoop cada frame — update.
  34+ 6F97              ; ==============================================================================
  35+ 6F97
  36+ 6F97              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  37+ 6F97 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  38+ 6F98 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  39+ 6F9A 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  40+ 6F9C 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  41+ 6F9D                                                ; (0 = inactivo o ya muteado)
  42+ 6F9D
  43+ 6F9D              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  44+ 6F9D              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  45+ 6F9D              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  46+ 6F9D              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  47+ 6F9D
  48+ 6F9D              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  49+ 6F9D              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  50+ 6F9D              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  51+ 6F9D              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  52+ 6F9D
  53+ 6F9D              ; ==============================================================================
  54+ 6F9D              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  55+ 6F9D              ; ==============================================================================
  56+ 6F9D              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  57+ 6F9D              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  58+ 6F9D              ; tabla los hardcodea.
  59+ 6F9D              ; ==============================================================================
  60+ 6F9D              AY_PlayPlayerHit:
  61+ 6F9D 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  62+ 6FA0 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  63+ 6FA2 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  64+ 6FA5 18 08            JR _AY_PlaySweep
  65+ 6FA7
  66+ 6FA7              AY_PlayPlayerDeath:
  67+ 6FA7 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  68+ 6FAA 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  69+ 6FAC 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  70+ 6FAF                  ; fall through
  71+ 6FAF
  72+ 6FAF              ; IN: HL=period inicial, B=frames, DE=delta.
  73+ 6FAF              _AY_PlaySweep:
  74+ 6FAF 22 98 6F         LD (PlayerHitPeriod), HL
  75+ 6FB2 ED 53 9A 6F      LD (PlayerHitDelta), DE
  76+ 6FB6 78               LD A, B
  77+ 6FB7 32 97 6F         LD (PlayerHitFrames), A
  78+ 6FBA F3               DI
  79+ 6FBB 0E FD            LD C, $FD
  80+ 6FBD 21 C3 6F         LD HL, .phRegs
  81+ 6FC0 C3 20 70         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  82+ 6FC3
  83+ 6FC3              .phRegs:
  84+ 6FC3 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  85+ 6FC5 03 00            DEFB  3, $00          ; R3  = period B hi
  86+ 6FC7 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  87+ 6FC9                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
  88+ 6FC9                                        ; aqui para no cortar las voces A/C de la musica poly2)
  89+ 6FC9 FF               DEFB $FF              ; sentinel
  90+ 6FCA
  91+ 6FCA              ; ==============================================================================
  92+ 6FCA              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  93+ 6FCA              ; ==============================================================================
  94+ 6FCA              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  95+ 6FCA              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  96+ 6FCA              ; Canal B (center stereo ABC). No bloqueante.
  97+ 6FCA              ;
  98+ 6FCA              ; IN: HL = period AY canal B (mayor = mas grave).
  99+ 6FCA              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
 100+ 6FCA              ;
 101+ 6FCA              ; Sugerencias:
 102+ 6FCA              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 103+ 6FCA              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 104+ 6FCA              ; Destruye: A, BC, HL.
 105+ 6FCA              ; ==============================================================================
 106+ 6FCA              AY_PlayBeep:
 107+ 6FCA 78               LD A, B
 108+ 6FCB 32 9C 6F         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 109+ 6FCE F3               DI
 110+ 6FCF 0E FD            LD C, $FD
 111+ 6FD1                  ; R2 = L (period B lo)
 112+ 6FD1 3E 02            LD A, 2
 113+ 6FD3 06 FF            LD B, $FF
 114+ 6FD5 ED 79            OUT (C), A
 115+ 6FD7 7D               LD A, L
 116+ 6FD8 06 BF            LD B, $BF
 117+ 6FDA ED 79            OUT (C), A
 118+ 6FDC                  ; R3 = H (period B hi)
 119+ 6FDC 3E 03            LD A, 3
 120+ 6FDE 06 FF            LD B, $FF
 121+ 6FE0 ED 79            OUT (C), A
 122+ 6FE2 7C               LD A, H
 123+ 6FE3 06 BF            LD B, $BF
 124+ 6FE5 ED 79            OUT (C), A
 125+ 6FE7                  ; R9 = $0F (vol max fija, SIN envelope). R7 mixer ya esta en $38 (set por
 126+ 6FE7                  ; AY_Init) — no tocar para no apagar las voces A/C de la musica poly2.
 127+ 6FE7 21 ED 6F         LD HL, .beepRegs
 128+ 6FEA C3 20 70         JP _AY_WriteRegPairs                ; tail call: EI + RET
 129+ 6FED
 130+ 6FED              .beepRegs:
 131+ 6FED 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 132+ 6FEF                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
 133+ 6FEF                                        ; aqui para no cortar las voces A/C de la musica poly2)
 134+ 6FEF FF               DEFB $FF              ; sentinel
 135+ 6FF0
 136+ 6FF0              ; ==============================================================================
 137+ 6FF0              ; AY_PlayKnockSoft / AY_PlayKnockLoud - Knock percusivo en canal B
 138+ 6FF0              ; ==============================================================================
 139+ 6FF0              ; Dos variantes de knock que comparten cutoff mechanism (BeepDurationFrames):
 140+ 6FF0              ;
 141+ 6FF0              ; Soft (grupos de 3 toques): noise B solo (tone B off), envelope $0200 (~1.2s
 142+ 6FF0              ;   decay). Knock seco, mas discreto. R7 = $2A.
 143+ 6FF0              ;
 144+ 6FF0              ; Loud (grupo de 6 toques): noise B + tone B mix (~217 Hz), envelope $0400
 145+ 6FF0              ;   (~2.4s decay). Knock con "body" del tone, vol perceptual ~3 dB mayor.
 146+ 6FF0              ;   R7 = $28.
 147+ 6FF0              ;
 148+ 6FF0              ; Ambos:
 149+ 6FF0              ;   - R6 = $05 (noise period, chasquido seco/agudo).
 150+ 6FF0              ;   - R9 = $10 (use envelope, bit 4 set).
 151+ 6FF0              ;   - R13 = $09 (decay shape, \___, retrigger en cada call). Va ULTIMO.
 152+ 6FF0              ;   - _uphMuteR9 restaura R7 = $38 al cutoff (cleanup tras knock).
 153+ 6FF0              ;
 154+ 6FF0              ; IN: B = duracion frames cutoff (recomendado 4 = ~160ms).
 155+ 6FF0              ; Destruye: A, BC, HL.
 156+ 6FF0              ; ==============================================================================
 157+ 6FF0              AY_PlayKnockSoft:
 158+ 6FF0 21 02 70         LD HL, _knockSoftRegs
 159+ 6FF3 18 03            JR _ay_play_knock_seq
 160+ 6FF5
 161+ 6FF5              AY_PlayKnockLoud:
 162+ 6FF5 21 0F 70         LD HL, _knockLoudRegs
 163+ 6FF8                  ; fall through
 164+ 6FF8
 165+ 6FF8              _ay_play_knock_seq:
 166+ 6FF8 78               LD A, B
 167+ 6FF9 32 9C 6F         LD (BeepDurationFrames), A          ; arma cutoff via ticker
 168+ 6FFC F3               DI
 169+ 6FFD 0E FD            LD C, $FD
 170+ 6FFF C3 20 70         JP _AY_WriteRegPairs                ; tail-call: EI + RET
 171+ 7002
 172+ 7002              _knockSoftRegs:
 173+ 7002 06 05            DEFB  6, $05          ; R6 noise period
 174+ 7004 07 2A            DEFB  7, $2A          ; R7 mixer: noise B on, tone B off
 175+ 7006 0B 00            DEFB 11, $00          ; R11 envelope period lo
 176+ 7008 0C 02            DEFB 12, $02          ; R12 envelope period hi ($0200 ~1.2s decay)
 177+ 700A 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 178+ 700C 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 179+ 700E FF               DEFB $FF
 180+ 700F
 181+ 700F              _knockLoudRegs:
 182+ 700F 02 00            DEFB  2, $00          ; R2 tone B period lo
 183+ 7011 03 02            DEFB  3, $02          ; R3 tone B period hi ($0200 ~217 Hz, body grave)
 184+ 7013 06 05            DEFB  6, $05          ; R6 noise period
 185+ 7015 07 28            DEFB  7, $28          ; R7 mixer: tone B + noise B both on
 186+ 7017 0B 00            DEFB 11, $00          ; R11 envelope period lo
 187+ 7019 0C 04            DEFB 12, $04          ; R12 envelope period hi ($0400 ~2.4s decay)
 188+ 701B 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 189+ 701D 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 190+ 701F FF               DEFB $FF
 191+ 7020
 192+ 7020              ; ==============================================================================
 193+ 7020              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 7020              ; ==============================================================================
 195+ 7020              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 7020              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 7020              ; ==============================================================================
 198+ 7020              _AY_WriteRegPairs:
 199+ 7020 7E               LD A, (HL)
 200+ 7021 FE FF            CP $FF
 201+ 7023 28 0D            JR Z, .awrpDone
 202+ 7025 06 FF            LD B, $FF
 203+ 7027 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 7029 23               INC HL
 205+ 702A 06 BF            LD B, $BF
 206+ 702C 7E               LD A, (HL)
 207+ 702D ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 702F 23               INC HL
 209+ 7030 18 EE            JR _AY_WriteRegPairs
 210+ 7032              .awrpDone:
 211+ 7032 FB               EI
 212+ 7033 C9               RET
 213+ 7034
 214+ 7034              ; ==============================================================================
 215+ 7034              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 7034              ; ==============================================================================
 217+ 7034              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 7034              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 7034              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 7034              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 7034              ; (con IFF=0), no hay race.
 222+ 7034              ;
 223+ 7034              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 7034              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 7034              ; Destruye: A, BC, DE, HL.
 226+ 7034              ; ==============================================================================
 227+ 7034              AY_UpdatePlayerHit:
 228+ 7034                  ; --- PendingPin tick: dispara beep diferido (lasting compass stage 2) ---
 229+ 7034                  ; Cuando AY_PlayLastingPickup arma una "PIN" tras el sweep, el ticker la
 230+ 7034                  ; dispara cuando el contador llega a 0. Escritura R2/R3/R9 inline (sin
 231+ 7034                  ; DI/EI: ya en contexto IRQ). Tras setear BeepDurationFrames el cutoff
 232+ 7034                  ; lo gestiona el path .uphCheckBeep en proximos ticks.
 233+ 7034 3A C4 70         LD A, (PendingPinTimer)
 234+ 7037 B7               OR A
 235+ 7038 28 34            JR Z, .uphAfterPin
 236+ 703A 3D               DEC A
 237+ 703B 32 C4 70         LD (PendingPinTimer), A
 238+ 703E 20 2E            JR NZ, .uphAfterPin
 239+ 7040 2A C5 70         LD HL, (PendingPinPeriod)
 240+ 7043 0E FD            LD C, $FD
 241+ 7045 3E 02            LD A, 2
 242+ 7047 06 FF            LD B, $FF
 243+ 7049 ED 79            OUT (C), A
 244+ 704B 7D               LD A, L
 245+ 704C 06 BF            LD B, $BF
 246+ 704E ED 79            OUT (C), A
 247+ 7050 3E 03            LD A, 3
 248+ 7052 06 FF            LD B, $FF
 249+ 7054 ED 79            OUT (C), A
 250+ 7056 7C               LD A, H
 251+ 7057 06 BF            LD B, $BF
 252+ 7059 ED 79            OUT (C), A
 253+ 705B 3E 09            LD A, 9
 254+ 705D 06 FF            LD B, $FF
 255+ 705F ED 79            OUT (C), A
 256+ 7061 3E 0F            LD A, $0F                           ; vol max canal B
 257+ 7063 06 BF            LD B, $BF
 258+ 7065 ED 79            OUT (C), A
 259+ 7067 3A C7 70         LD A, (PendingPinFrames)
 260+ 706A 32 9C 6F         LD (BeepDurationFrames), A          ; arma cutoff
 261+ 706D C9               RET                                 ; skip resto del ticker este frame
 262+ 706E              .uphAfterPin:
 263+ 706E 3A 97 6F         LD A, (PlayerHitFrames)
 264+ 7071 B7               OR A
 265+ 7072 28 2A            JR Z, .uphCheckBeep
 266+ 7074 3D               DEC A
 267+ 7075 32 97 6F         LD (PlayerHitFrames), A
 268+ 7078 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 269+ 707A
 270+ 707A 2A 98 6F         LD HL, (PlayerHitPeriod)
 271+ 707D ED 5B 9A 6F      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 272+ 7081 19               ADD HL, DE
 273+ 7082 22 98 6F         LD (PlayerHitPeriod), HL
 274+ 7085
 275+ 7085                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 276+ 7085 0E FD            LD C, $FD
 277+ 7087 3E 02            LD A, 2
 278+ 7089 06 FF            LD B, $FF
 279+ 708B ED 79            OUT (C), A
 280+ 708D 7D               LD A, L
 281+ 708E 06 BF            LD B, $BF
 282+ 7090 ED 79            OUT (C), A
 283+ 7092 3E 03            LD A, 3
 284+ 7094 06 FF            LD B, $FF
 285+ 7096 ED 79            OUT (C), A
 286+ 7098 7C               LD A, H
 287+ 7099 06 BF            LD B, $BF
 288+ 709B ED 79            OUT (C), A
 289+ 709D C9               RET
 290+ 709E
 291+ 709E              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 292+ 709E              .uphCheckBeep:
 293+ 709E 3A 9C 6F         LD A, (BeepDurationFrames)
 294+ 70A1 B7               OR A
 295+ 70A2 C8               RET Z
 296+ 70A3 3D               DEC A
 297+ 70A4 32 9C 6F         LD (BeepDurationFrames), A
 298+ 70A7 C0               RET NZ
 299+ 70A8                  ; fall-through al cutoff compartido
 300+ 70A8
 301+ 70A8              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 302+ 70A8              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 303+ 70A8              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 304+ 70A8              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 305+ 70A8              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 306+ 70A8              _uphMuteR9:
 307+ 70A8 01 FD FF         LD BC, $FFFD
 308+ 70AB 3E 09            LD A, 9
 309+ 70AD ED 79            OUT (C), A
 310+ 70AF 01 FD BF         LD BC, $BFFD
 311+ 70B2 AF               XOR A
 312+ 70B3 ED 79            OUT (C), A
 313+ 70B5                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 314+ 70B5 01 FD FF         LD BC, $FFFD
 315+ 70B8 3E 07            LD A, 7
 316+ 70BA ED 79            OUT (C), A
 317+ 70BC 01 FD BF         LD BC, $BFFD
 318+ 70BF 3E 38            LD A, $38
 319+ 70C1 ED 79            OUT (C), A
 320+ 70C3 C9               RET
 321+ 70C4
 322+ 70C4              ; AchievementJingle ELIMINADO: el chime de "llegar a la sala del hito" ahora
 323+ 70C4              ; reusa AY_PlayCompassPickup (mismo sweep que el pickup del magic compass
 324+ 70C4              ; random). Libera ~80 B en slot 1 y unifica el feedback "evento positivo de
 325+ 70C4              ; navegacion" con un unico sonido.
 326+ 70C4
 327+ 70C4              ; ==============================================================================
 328+ 70C4              ; CompassPickup SFX (random + lasting) - sweeps tipo PlayerHit/Death
 329+ 70C4              ; ==============================================================================
 330+ 70C4              ; Reusan _AY_PlaySweep (sweep continuo de pitch en canal B AY, no bloqueante,
 331+ 70C4              ; cutoff abrupto al final via _uphMuteR9). Llamados desde ApplyMagicCompassBuff
 332+ 70C4              ; segun MagicCompassPermanent: random -> AY_PlayCompassPickup (solo sweep),
 333+ 70C4              ; lasting -> AY_PlayLastingPickup (sweep + PIN sostenido tipo "WHHIII-PIN").
 334+ 70C4              ;
 335+ 70C4              ; Direccion del sweep: GRAVE -> AGUDO ("found it!" feel). Period inicial alto,
 336+ 70C4              ; delta NEGATIVO en two's complement ($FFE8 = -24 etc). _AY_PlaySweep usa
 337+ 70C4              ; ADD HL, DE asi que el wrap unsigned funciona como resta.
 338+ 70C4              ; ==============================================================================
 339+ 70C4
 340+ 70C4              ; Random compass: sweep ascendente ~640 ms (16 frames)
 341+ 70C4              ;   $0200 (210 Hz, B3) -> $0080 (853 Hz, A5) — 2 octavas
 342+ 70C4              COMPASS_SWEEP_PERIOD_INIT  EQU $0200
 343+ 70C4              COMPASS_SWEEP_FRAMES       EQU 16
 344+ 70C4              COMPASS_SWEEP_DELTA        EQU $FFE8         ; -24/frame
 345+ 70C4
 346+ 70C4              ; Lasting compass: sweep ascendente ~880 ms (22 frames) + PIN sostenido
 347+ 70C4              ;   Sweep: $0300 (140 Hz, D3) -> $0040 (1700 Hz, ~A6) — 3+ octavas
 348+ 70C4              ;   PIN: $0030 (~2270 Hz) por 6 frames (240 ms), 1 frame despues del sweep
 349+ 70C4              LASTING_SWEEP_PERIOD_INIT  EQU $0300
 350+ 70C4              LASTING_SWEEP_FRAMES       EQU 22
 351+ 70C4              LASTING_SWEEP_DELTA        EQU $FFE0         ; -32/frame
 352+ 70C4              LASTING_PIN_PERIOD         EQU $0030         ; ~2270 Hz, muy brillante
 353+ 70C4              LASTING_PIN_FRAMES         EQU 6             ; 240 ms
 354+ 70C4              LASTING_PIN_DELAY          EQU LASTING_SWEEP_FRAMES + 1   ; fire 1 frame tras cutoff
 355+ 70C4
 356+ 70C4              ; State del PIN diferido (tickeado por AY_UpdatePlayerHit)
 357+ 70C4 00           PendingPinTimer:    DEFB 0       ; >0 = pendiente; 0 = nada
 358+ 70C5 00 00        PendingPinPeriod:   DEFW 0       ; period AY canal B
 359+ 70C7 00           PendingPinFrames:   DEFB 0       ; duracion del beep tras dispararse
 360+ 70C8
 361+ 70C8              ; AY_PlayCompassPickup - magic compass random
 362+ 70C8              AY_PlayCompassPickup:
 363+ 70C8 21 00 02         LD HL, COMPASS_SWEEP_PERIOD_INIT
 364+ 70CB 06 10            LD B, COMPASS_SWEEP_FRAMES
 365+ 70CD 11 E8 FF         LD DE, COMPASS_SWEEP_DELTA
 366+ 70D0 C3 AF 6F         JP _AY_PlaySweep                  ; tail call
 367+ 70D3
 368+ 70D3              ; AY_PlayLastingPickup - lasting compass: sweep + PIN encadenado
 369+ 70D3              AY_PlayLastingPickup:
 370+ 70D3 21 00 03         LD HL, LASTING_SWEEP_PERIOD_INIT
 371+ 70D6 06 16            LD B, LASTING_SWEEP_FRAMES
 372+ 70D8 11 E0 FF         LD DE, LASTING_SWEEP_DELTA
 373+ 70DB CD AF 6F         CALL _AY_PlaySweep
 374+ 70DE                  ; Encolar PIN (beep agudo final) para que dispare 1 frame tras el sweep
 375+ 70DE 21 30 00         LD HL, LASTING_PIN_PERIOD
 376+ 70E1 22 C5 70         LD (PendingPinPeriod), HL
 377+ 70E4 3E 06            LD A, LASTING_PIN_FRAMES
 378+ 70E6 32 C7 70         LD (PendingPinFrames), A
 379+ 70E9 3E 17            LD A, LASTING_PIN_DELAY
 380+ 70EB 32 C4 70         LD (PendingPinTimer), A
 381+ 70EE C9               RET
 382+ 70EF
