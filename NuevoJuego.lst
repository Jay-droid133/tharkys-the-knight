 218+ EEAC              ; ==============================================================================
 219+ EEAC              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 220+ EEAC              ; ==============================================================================
 221+ EEAC              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 222+ EEAC              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 223+ EEAC              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 224+ EEAC              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 225+ EEAC              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 226+ EEAC              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 227+ EEAC              ;               actuales; queda como salvaguarda.
 228+ EEAC              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 229+ EEAC              ; Destruye: AF, BC, DE, HL.
 230+ EEAC              ; ==============================================================================
 231+ EEAC              ResolveObjectiveScreen:
 232+ EEAC 3A BA 82         LD A, (CurrentObjective)
 233+ EEAF FE 0B            CP 11
 234+ EEB1 30 3E            JR NC, .rosNoTarget
 235+ EEB3 87               ADD A, A
 236+ EEB4 6F               LD L, A
 237+ EEB5 26 00            LD H, 0
 238+ EEB7 11 D9 ED         LD DE, MilestoneResolveTable
 239+ EEBA 19               ADD HL, DE
 240+ EEBB 7E               LD A, (HL)                          ; tipo
 241+ EEBC 23               INC HL
 242+ EEBD 46               LD B, (HL)                          ; B = ref
 243+ EEBE FE 01            CP MILESTONE_TYPE_PICKUP
 244+ EEC0 28 06            JR Z, .rosPickup
 245+ EEC2 FE 02            CP MILESTONE_TYPE_TRIGGER
 246+ EEC4 28 08            JR Z, .rosTrigger
 247+ EEC6 18 29            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 248+ EEC8              .rosPickup:
 249+ EEC8 78               LD A, B
 250+ EEC9 CD FA EE         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 251+ EECC 18 0C            JR .rosFindPos
 252+ EECE              .rosTrigger:
 253+ EECE 78               LD A, B
 254+ EECF FE 04            CP 4
 255+ EED1 28 13            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 256+ EED3 CD 07 EF         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 257+ EED6 7A               LD A, D
 258+ EED7 B3               OR E
 259+ EED8 28 17            JR Z, .rosNoTarget
 260+ EEDA              .rosFindPos:
 261+ EEDA CD 22 EF         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 262+ EEDD 78               LD A, B
 263+ EEDE 32 BB 82         LD (ObjectiveScreenX), A
 264+ EEE1 79               LD A, C
 265+ EEE2 32 BC 82         LD (ObjectiveScreenY), A
 266+ EEE5 C9               RET
 267+ EEE6              .rosBankRoom:
 268+ EEE6                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 269+ EEE6                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 270+ EEE6 3E 08            LD A, BCS_BANK_ROOM_X
 271+ EEE8 32 BB 82         LD (ObjectiveScreenX), A
 272+ EEEB 3E 08            LD A, BCS_BANK_ROOM_Y
 273+ EEED 32 BC 82         LD (ObjectiveScreenY), A
 274+ EEF0 C9               RET
 275+ EEF1              .rosNoTarget:
 276+ EEF1 3E FF            LD A, $FF
 277+ EEF3 32 BB 82         LD (ObjectiveScreenX), A
 278+ EEF6 32 BC 82         LD (ObjectiveScreenY), A
 279+ EEF9 C9               RET
