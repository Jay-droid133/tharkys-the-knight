  67+ DB84              ; ==============================================================================
  68+ DB84              ; DecodeTombRLEPixels - parsea el stream RLE de BgSpriteBuffer y emite 240 bytes
  69+ DB84              ; planos (CPL'd → des-CPL'd) a TombDecodedPixels.
  70+ DB84              ; ==============================================================================
  71+ DB84              ; Formato RLE (mismo que DrawBgGfxSprite):
  72+ DB84              ;   Control $01-$7F: literal group, siguen (control) bytes raw.
  73+ DB84              ;   Control $80-$FF: run, count = (control & $7F) + 2, sigue 1 byte valor.
  74+ DB84              ;
  75+ DB84              ; Tras emitir 240 bytes, HL apunta al siguiente byte del buffer = tint.
  76+ DB84              ; Salvamos HL+3 (saltar tint, AH, AW) en TombAttrSrcPtr → ptr a attrs.
  77+ DB84              ;
  78+ DB84              ; Destruye: AF, BC, DE, HL.
  79+ DB84              ; ==============================================================================
  80+ DB84              DecodeTombRLEPixels:
  81+ DB84 21 FF 86         LD HL, BgSpriteBuffer + 2       ; saltar header (H, W|RLE)
  82+ DB87 11 B1 DC         LD DE, TombDecodedPixels
  83+ DB8A 01 F0 00         LD BC, TOMB_SRC_W_BYTES * TOMB_SRC_H_PX   ; 240 bytes a emitir
  84+ DB8D AF               XOR A
  85+ DB8E 32 DF DB         LD (.drlPending), A
