 334  E493                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 335  E493                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 336  E493                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 337  E493                  ; deben vivir en el mismo banco paginado.
 338  E493                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ E493              ; ==============================================================================
   2+ E493              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E493              ; ==============================================================================
   4+ E493              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E493              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E493              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E493              ; ==============================================================================
   8+ E493
   9+ E493              ; --- Constantes ---
  10+ E493              NUM_TIME_MOMENTS    EQU 7
  11+ E493
  12+ E493              ; --- Variables ---
  13+ E493 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E494 25 E9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E496 25 E9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E498 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E499 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ E49A
  19+ E49A              ; ==============================================================================
  20+ E49A              ; SetTimeOfDay - Cambia el momento del dia
  21+ E49A              ; ==============================================================================
  22+ E49A              ; Entrada: A = momento (0-6)
  23+ E49A              ; ==============================================================================
  24+ E49A              SetTimeOfDay:
  25+ E49A 32 93 E4         LD (CurrentTimeOfDay), A
  26+ E49D
  27+ E49D                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  28+ E49D FE 04            CP 4
  29+ E49F 20 06            JR NZ, .notNewCycle
  30+ E4A1 21 6F C0         LD HL, DayCycleCount
  31+ E4A4 34               INC (HL)
  32+ E4A5 18 04            JR .skipBellsReset
  33+ E4A7              .notNewCycle:
  34+ E4A7                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  35+ E4A7                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  36+ E4A7                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  37+ E4A7 AF               XOR A
  38+ E4A8 32 50 82         LD (BellsTriggered), A
  39+ E4AB              .skipBellsReset:
  40+ E4AB 3A 93 E4         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  41+ E4AE
  42+ E4AE                  ; N2 (medianoche): campanadas primero, remap al terminar
  43+ E4AE FE 04            CP 4
  44+ E4B0 28 21            JR Z, .bellsFirst
  45+ E4B2
  46+ E4B2                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  47+ E4B2 FE 05            CP 5
  48+ E4B4 20 0A            JR NZ, .noScareMon
  49+ E4B6 CD 89 C0         CALL ScareAllMonsters
  50+ E4B9                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  51+ E4B9                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  52+ E4B9                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  53+ E4B9                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  54+ E4B9 3E 01            LD A, 1                         ; track 1 = Sunrise
  55+ E4BB CD A2 9D         CALL StartMusic
  56+ E4BE 18 07            JR .noKillMon
  57+ E4C0              .noScareMon:
  58+ E4C0                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  59+ E4C0 FE 06            CP 6
  60+ E4C2 20 03            JR NZ, .noKillMon
  61+ E4C4 CD 12 C0         CALL KillAllActiveMonsters
  62+ E4C7              .noKillMon:
  63+ E4C7
  64+ E4C7                  ; Actualizar tablas de remap y tabla de nasties
  65+ E4C7 CD FC E4         CALL UpdateRemapTables
  66+ E4CA CD 72 C0         CALL UpdateNastyTable
  67+ E4CD
  68+ E4CD                  ; Forzar remap de atributos (sin redibujar pixeles)
  69+ E4CD 3E 01            LD A, 1
  70+ E4CF 32 98 82         LD (AttrsDirty), A
  71+ E4D2 C9               RET
  72+ E4D3
  73+ E4D3              .bellsFirst:
  74+ E4D3                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  75+ E4D3                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  76+ E4D3                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  77+ E4D3                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  78+ E4D3                  ; que sean nocturnos (Crepuscular), no diurnos.
  79+ E4D3 CD 72 C0         CALL UpdateNastyTable
  80+ E4D6                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  81+ E4D6                  ; antes de medianoche natural y forzo el evento), saltamos.
  82+ E4D6 3A 50 82         LD A, (BellsTriggered)
  83+ E4D9 B7               OR A
  84+ E4DA C0               RET NZ
  85+ E4DB 3E 01            LD A, 1
  86+ E4DD 32 50 82         LD (BellsTriggered), A
  87+ E4E0 CD 96 F9         CALL StartBellChimes
  88+ E4E3 C9               RET
  89+ E4E4
  90+ E4E4              ; ==============================================================================
  91+ E4E4              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  92+ E4E4              ; ==============================================================================
  93+ E4E4              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  94+ E4E4              ;   - Salta reloj a 00:00.
  95+ E4E4              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  96+ E4E4              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  97+ E4E4              ;     campanadas como hace el path natural). El usuario quiere que la
  98+ E4E4              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
  99+ E4E4              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 100+ E4E4              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 101+ E4E4              ;     pero ya esta en N2 -> no-op visual.
 102+ E4E4              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 103+ E4E4              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 104+ E4E4              ;
 105+ E4E4              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 106+ E4E4              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 107+ E4E4              ; aqui no re-dispara nada.
 108+ E4E4              ; ==============================================================================
 109+ E4E4              TriggerChurchMidnight:
 110+ E4E4 3A 50 82         LD A, (BellsTriggered)
 111+ E4E7 B7               OR A
 112+ E4E8 C0               RET NZ                              ; bells ya sonaron -> no-op
 113+ E4E9 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 114+ E4EB CD D5 EC         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 115+ E4EE 3E 04            LD A, 4
 116+ E4F0 CD 9A E4         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 117+ E4F3                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 118+ E4F3                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 119+ E4F3                  ; diurnos durante chimes). En este path queremos lo contrario.
 120+ E4F3 CD FC E4         CALL UpdateRemapTables
 121+ E4F6 3E 01            LD A, 1
 122+ E4F8 32 98 82         LD (AttrsDirty), A
 123+ E4FB C9               RET
 124+ E4FC
 125+ E4FC              ; ==============================================================================
 126+ E4FC              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 127+ E4FC              ; ==============================================================================
 128+ E4FC              UpdateRemapTables:
 129+ E4FC 3A 93 E4         LD A, (CurrentTimeOfDay)
 130+ E4FF 21 F9 E8         LD HL, RemapTablePtrs
 131+ E502 5F               LD E, A
 132+ E503 16 00            LD D, 0
 133+ E505 19               ADD HL, DE
 134+ E506 19               ADD HL, DE
 135+ E507 5E               LD E, (HL)
 136+ E508 23               INC HL
 137+ E509 56               LD D, (HL)
 138+ E50A ED 53 94 E4      LD (CurrentRemapTable), DE
 139+ E50E
 140+ E50E 3A 93 E4         LD A, (CurrentTimeOfDay)
 141+ E511 21 07 E9         LD HL, RemapHouseTablePtrs
 142+ E514 5F               LD E, A
 143+ E515 16 00            LD D, 0
 144+ E517 19               ADD HL, DE
 145+ E518 19               ADD HL, DE
 146+ E519 5E               LD E, (HL)
 147+ E51A 23               INC HL
 148+ E51B 56               LD D, (HL)
 149+ E51C ED 53 96 E4      LD (CurrentHouseRemapTable), DE
 150+ E520 C9               RET
 151+ E521
 152+ E521              ; ==============================================================================
 153+ E521              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 154+ E521              ; ==============================================================================
 155+ E521              CheckDebugKeys:
 156+ E521 3E FB            LD A, $FB
 157+ E523 DB FE            IN A, ($FE)
 158+ E525 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 159+ E527 20 1C            JR NZ, .notPressed
 160+ E529
 161+ E529                  ; Tecla pulsada: comprobar debounce
 162+ E529 3A 99 E4         LD A, (DebugKeyDebounce)
 163+ E52C B7               OR A
 164+ E52D C0               RET NZ                  ; Ya estaba pulsada, ignorar
 165+ E52E
 166+ E52E                  ; Primera pulsacion: ciclar
 167+ E52E 3E 01            LD A, 1
 168+ E530 32 99 E4         LD (DebugKeyDebounce), A
 169+ E533
 170+ E533 3A 93 E4         LD A, (CurrentTimeOfDay)
 171+ E536 3C               INC A
 172+ E537 FE 07            CP NUM_TIME_MOMENTS
 173+ E539 38 01            JR C, .noWrap
 174+ E53B AF               XOR A                   ; Volver a 0 (Dia)
 175+ E53C              .noWrap:
 176+ E53C F5               PUSH AF
 177+ E53D CD 9A E4         CALL SetTimeOfDay
 178+ E540 F1               POP AF
 179+ E541 CD D5 EC         CALL SetClockToPhaseHour
 180+ E544 C9               RET
 181+ E545
 182+ E545              .notPressed:
 183+ E545 AF               XOR A
 184+ E546 32 99 E4         LD (DebugKeyDebounce), A
 185+ E549
 186+ E549                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 187+ E549 3E FD            LD A, $FD
 188+ E54B DB FE            IN A, ($FE)
 189+ E54D 4F               LD C, A                 ; C = estado semi-fila $FDFE
 190+ E54E CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 191+ E550 20 13            JR NZ, .sNotPressed
 192+ E552 3A A0 E5         LD A, (SpeedKeyDebounce)
 193+ E555 B7               OR A
 194+ E556 C0               RET NZ
 195+ E557 3E 01            LD A, 1
 196+ E559 32 A0 E5         LD (SpeedKeyDebounce), A
 197+ E55C 21 6F C0         LD HL, DayCycleCount
 198+ E55F 7E               LD A, (HL)
 199+ E560 FE 0A            CP 10
 200+ E562 D0               RET NC                  ; Ya en maximo
 201+ E563 34               INC (HL)
 202+ E564 C9               RET
 203+ E565              .sNotPressed:
 204+ E565                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 205+ E565 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 206+ E567 20 13            JR NZ, .dNotPressed
 207+ E569 3A A0 E5         LD A, (SpeedKeyDebounce)
 208+ E56C B7               OR A
 209+ E56D C0               RET NZ
 210+ E56E 3E 01            LD A, 1
 211+ E570 32 A0 E5         LD (SpeedKeyDebounce), A
 212+ E573 21 6F C0         LD HL, DayCycleCount
 213+ E576 7E               LD A, (HL)
 214+ E577 FE 01            CP 1
 215+ E579 C8               RET Z                   ; Ya en minimo
 216+ E57A 35               DEC (HL)
 217+ E57B C9               RET
 218+ E57C              .dNotPressed:
 219+ E57C AF               XOR A
 220+ E57D 32 A0 E5         LD (SpeedKeyDebounce), A
 221+ E580
 222+ E580                  ; --- Tecla N: togglea NoclipMode (debug) ---
 223+ E580 3E 7F            LD A, $7F
 224+ E582 DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 225+ E584 CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 226+ E586 20 13            JR NZ, .nNotPressed
 227+ E588 3A A1 E5         LD A, (NoclipKeyDebounce)
 228+ E58B B7               OR A
 229+ E58C C0               RET NZ
 230+ E58D 3E 01            LD A, 1
 231+ E58F 32 A1 E5         LD (NoclipKeyDebounce), A
 232+ E592 3A 48 82         LD A, (NoclipMode)
 233+ E595 EE 01            XOR 1
 234+ E597 32 48 82         LD (NoclipMode), A
 235+ E59A C9               RET
 236+ E59B              .nNotPressed:
 237+ E59B AF               XOR A
 238+ E59C 32 A1 E5         LD (NoclipKeyDebounce), A
 239+ E59F C9               RET
 240+ E5A0
 241+ E5A0 00           SpeedKeyDebounce: DEFB 0
 242+ E5A1 00           NoclipKeyDebounce: DEFB 0
