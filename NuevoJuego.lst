 764+ E8C8 6F               LD L, A
 765+ E8C9 26 00            LD H, 0
 766+ E8CB 29               ADD HL, HL
 767+ E8CC 29               ADD HL, HL
 768+ E8CD 29               ADD HL, HL
 769+ E8CE 01 00 3C         LD BC, $3C00
 770+ E8D1 09               ADD HL, BC                  ; HL = font data
 771+ E8D2
 772+ E8D2                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 773+ E8D2 16 40            LD D, $40                   ; Tercio 0, scan line 0
 774+ E8D4 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 775+ E8D6 83               ADD A, E
 776+ E8D7 5F               LD E, A                     ; DE = dir VRAM
 777+ E8D8
 778+ E8D8 06 08            LD B, 8
