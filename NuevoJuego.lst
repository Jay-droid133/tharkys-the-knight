2693+ DA8A 56               LD D, (HL)                  ; DE = BgGfx ptr
2694+ DA8B 23               INC HL                      ; HL en charX
2695+ DA8C 46               LD B, (HL)                  ; charX
2696+ DA8D 23               INC HL
2697+ DA8E 4E               LD C, (HL)                  ; charY
2698+ DA8F 23               INC HL
