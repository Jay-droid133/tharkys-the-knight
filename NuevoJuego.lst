 460+ 68F6 18 EF            JR .drftLoop
 461+ 68F8              .drftFound:
 462+ 68F8                  ; HL apunta al id, +1=charX, +2=charY, +3=variant
 463+ 68F8 23               INC HL
 464+ 68F9 46               LD B, (HL)                              ; B = charX
 465+ 68FA 23               INC HL
 466+ 68FB 7E               LD A, (HL)
 467+ 68FC C6 02            ADD A, 2                                ; charY + 2 (base de la estatua)
 468+ 68FE 4F               LD C, A
 469+ 68FF                  ; Lookup remains id por tipo
 470+ 68FF 3A 0D 69         LD A, (.drftType)
 471+ 6902 21 AF 67         LD HL, RemainsIdTable
 472+ 6905 5F               LD E, A
 473+ 6906 16 00            LD D, 0
 474+ 6908 19               ADD HL, DE
 475+ 6909 7E               LD A, (HL)
