2768+ AE2C DD 7E 04         LD A, (IX+ENT_POSY)
2769+ AE2F FE A8            CP SCREEN_MAX_Y
2770+ AE31 30 25            JR NC, .moKbPreOffscreen
2771+ AE33 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2772+ AE35 38 1B            JR C, .moKbPreOffscreenMaybeY
2773+ AE37              .moKbPreBorderOk:
2774+ AE37                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2775+ AE37                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2776+ AE37                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2777+ AE37                  ; CheckEnemyCollision.
2778+ AE37                  ; CheckChurchTrap retorna:
2779+ AE37                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2780+ AE37                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2781+ AE37                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2782+ AE37 CD 23 F2         CALL CheckChurchTrap
2783+ AE3A B7               OR A
2784+ AE3B 28 07            JR Z, .moKbCollCheck
2785+ AE3D FE 02            CP 2
