 103+ 9D8C 3E 10            LD A, SCREEN_MIN_Y
 104+ 9D8E 32 0D 9E         LD (.posY), A
 105+ 9D91 57               LD D, A
 106+ 9D92              .clipTopDone:
 107+ 9D92                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9D92 3A 0D 9E         LD A, (.posY)
 109+ 9D95 47               LD B, A
 110+ 9D96 3A 0F 9E         LD A, (.heightSave)
 111+ 9D99 80               ADD A, B                    ; A = Y + height
 112+ 9D9A 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9D9C FE C0            CP 192
 114+ 9D9E 38 08            JR C, .clipBotDone          ; Dentro de pantalla
