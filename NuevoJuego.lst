 337+ F244 46               LD B, (HL)                          ; B = mapX
 338+ F245 23               INC HL
 339+ F246 4E               LD C, (HL)                          ; C = mapY
 340+ F247 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 341+ F249 C9               RET
