 751+ D0EA              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 752+ D0EA              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 753+ D0EA              ;          DEFB tintPaper, attr_h, attr_w, attr_data
