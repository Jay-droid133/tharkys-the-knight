1252+ 97CC              ; BuildZoneCellList - construye ZoneCellList (main RAM) iterando FlowField
1253+ 97CC              ; ==============================================================================
1254+ 97CC              ; Llamada desde DrawScreen al entrar a una sala (tras MaiComputeFlowField).
1255+ 97CC              ; Anade (cx, cy) a la lista para CADA celda alcanzable desde el player en su
1256+ 97CC              ; posicion de entrada (FlowField byte != $FF). La lista representa el "hueco"
1257+ 97CC              ; completo donde puedo estar, sin filtro de proximidad.
1258+ 97CC              ; Cap 255 entradas. SpawnOneNasty elige idx random de aqui.
1259+ 97CC              ; Destruye: AF, BC, DE, HL.
1260+ 97CC              ; ==============================================================================
1261+ 97CC              BuildZoneCellList:
1262+ 97CC AF               XOR A
1263+ 97CD 32 00 5D         LD (ZoneCellCount), A
1264+ 97D0 21 01 5D         LD HL, ZoneCellList
1265+ 97D3 22 29 98         LD (.bzclPtr), HL
