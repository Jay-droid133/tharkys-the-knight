1197+ A8BC              ; ==============================================================================
1198+ A8BC              ; UpdatePlayerState - Determina estado y direccion desde input
1199+ A8BC              ; ==============================================================================
1200+ A8BC              UpdatePlayerState:
1201+ A8BC 3A 5B 82         LD A, (InputDirection)
1202+ A8BF 47               LD B, A
1203+ A8C0 3A 5C 82         LD A, (InputFire)
1204+ A8C3 4F               LD C, A
1205+ A8C4
1206+ A8C4                  ; Sin input → idle (salvo si ataque en curso)
1207+ A8C4 78               LD A, B
1208+ A8C5 B1               OR C
1209+ A8C6 20 17            JR NZ, .notIdle
1210+ A8C8                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1211+ A8C8 3A 66 B6         LD A, (AttackTimer)
1212+ A8CB B7               OR A
