 659+ EB6B 23               INC HL
 660+ EB6C 77               LD (HL), A
 661+ EB6D 2B               DEC HL
 662+ EB6E 24               INC H
 663+ EB6F 10 F9            DJNZ .ccRow1
 664+ EB71 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 665+ EB72 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 666+ EB75 77               LD (HL), A
 667+ EB76 23               INC HL
 668+ EB77 77               LD (HL), A
 669+ EB78 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 670+ EB7B 77               LD (HL), A
 671+ EB7C 23               INC HL
 672+ EB7D 77               LD (HL), A
 673+ EB7E C9               RET
 674+ EB7F
 675+ EB7F              ; ==============================================================================
 676+ EB7F              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 677+ EB7F              ; ==============================================================================
 678+ EB7F              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 679+ EB7F              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 680+ EB7F              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 681+ EB7F              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 682+ EB7F              ; monstruo cae alli con la puerta abierta:
 683+ EB7F              ;   - Bit slot en MonsterTrappedFlags
 684+ EB7F              ;   - Despawn del monstruo (puff)
 685+ EB7F              ;   - Puerta se re-cierra (sprite + flag)
 686+ EB7F              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 687+ EB7F              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 688+ EB7F              ;
 689+ EB7F              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 690+ EB7F              ; auto-generadas por el level editor segun la posicion de la puerta y los
 691+ EB7F              ; markers AltKey1/AltKey2.
 692+ EB7F              ; ==============================================================================
 693+ EB7F
 694+ EB7F              ; ==============================================================================
 695+ EB7F              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 696+ EB7F              ; ==============================================================================
 697+ EB7F              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 698+ EB7F              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 699+ EB7F              ; Destruye: AF, BC.
 700+ EB7F              ; ==============================================================================
 701+ EB7F              CheckChurchTrap:
 702+ EB7F                  ; --- Solo en pantalla de la iglesia ---
 703+ EB7F 3A 55 82         LD A, (CurrentScreenX)
 704+ EB82 FE 0F            CP CHURCH_TRAP_SCREEN_X
 705+ EB84 20 5D            JR NZ, .cctNoTrap
 706+ EB86 3A 56 82         LD A, (CurrentScreenY)
 707+ EB89 FE 06            CP CHURCH_TRAP_SCREEN_Y
 708+ EB8B 20 56            JR NZ, .cctNoTrap
 709+ EB8D                  ; --- Solo con la puerta abierta ---
 710+ EB8D 3A 2A 82         LD A, (ChurchDoorOpen)
 711+ EB90 B7               OR A
 712+ EB91 28 50            JR Z, .cctNoTrap
 713+ EB93                  ; --- Solo si el knockback es DIRECTO del player ---
 714+ EB93                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 715+ EB93                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 716+ EB93                  ; espada y se clear cuando se hereda kb por colision.
 717+ EB93 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 718+ EB97 28 4A            JR Z, .cctNoTrap
 719+ EB99                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 720+ EB99                  ; (acepta sprites de 16, 21 o 24 px de alto)
 721+ EB99 DD 7E 04         LD A, (IX+ENT_POSY)
 722+ EB9C CB 3F            SRL A
 723+ EB9E CB 3F            SRL A
 724+ EBA0 CB 3F            SRL A                                   ; A = top charY del monster
 725+ EBA2 47               LD B, A
 726+ EBA3 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 727+ EBA5 90               SUB B                                   ; A = trap_charY - mon_charY
 728+ EBA6 FE 03            CP 3
 729+ EBA8 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 730+ EBAA                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 731+ EBAA DD 7E 03         LD A, (IX+ENT_POSX)
 732+ EBAD CB 3F            SRL A
 733+ EBAF CB 3F            SRL A
 734+ EBB1 CB 3F            SRL A
 735+ EBB3 47               LD B, A                                 ; B = left charX del monster
 736+ EBB4 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 737+ EBB6 3C               INC A                                   ; A = LO_X + 1
 738+ EBB7 90               SUB B                                   ; A = LO_X+1 - charX
 739+ EBB8 FE 03            CP 3
 740+ EBBA 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 741+ EBBC                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 742+ EBBC                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 743+ EBBC DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 744+ EBBF D6 4C            SUB SPRID_MONSTER_0
 745+ EBC1 CB 3F            SRL A
 746+ EBC3 CB 3F            SRL A
 747+ EBC5 CB 3F            SRL A                                   ; A = type idx 0..2
 748+ EBC7 47               LD B, A
 749+ EBC8                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 750+ EBC8 3A 37 82         LD A, (NextChurchTrapStep)
 751+ EBCB FE 03            CP 3
 752+ EBCD 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 753+ EBCF 21 E5 EB         LD HL, ChurchTrapOrderTable
 754+ EBD2 5F               LD E, A
 755+ EBD3 16 00            LD D, 0
 756+ EBD5 19               ADD HL, DE
 757+ EBD6 7E               LD A, (HL)                              ; A = type esperado
 758+ EBD7 B8               CP B
 759+ EBD8 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 760+ EBDA                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 761+ EBDA CD 7D EC         CALL TriggerChurchTrap
 762+ EBDD 3E 01            LD A, 1
 763+ EBDF C9               RET
 764+ EBE0              .cctBlockAsWall:
 765+ EBE0                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 766+ EBE0                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 767+ EBE0 3E 02            LD A, 2
 768+ EBE2 C9               RET
 769+ EBE3              .cctNoTrap:
 770+ EBE3 AF               XOR A
 771+ EBE4 C9               RET
 772+ EBE5
 773+ EBE5              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 774+ EBE5              ChurchTrapOrderTable:
 775+ EBE5 00 02 01         DEFB 0, 2, 1
 776+ EBE8
 777+ EBE8              ; ==============================================================================
 778+ EBE8              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 779+ EBE8              ; blanco brillante sobre paper negro ($47).
 780+ EBE8              ; ==============================================================================
 781+ EBE8              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 782+ EBE8              ; - No-op fuera de la sala de la iglesia.
 783+ EBE8              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 784+ EBE8              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 785+ EBE8              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 786+ EBE8              ;   aun no toca) conservan sus attrs originales del sprite.
 787+ EBE8              ; Destruye: AF, BC, DE, HL.
 788+ EBE8              ; ==============================================================================
 789+ EBE8              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 790+ EBE8              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 791+ EBE8              HighlightExpectedStatue:
 792+ EBE8 3E 47            LD A, $47
 793+ EBEA 18 00            JR PaintExpectedStatueAttr
 794+ EBEC
 795+ EBEC              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 796+ EBEC              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 797+ EBEC              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 798+ EBEC              PaintExpectedStatueAttr:
 799+ EBEC 32 56 EC         LD (.hesAttr), A
 800+ EBEF                  ; --- Solo en la sala de la iglesia ---
 801+ EBEF 3A 55 82         LD A, (CurrentScreenX)
 802+ EBF2 FE 0F            CP CHURCH_TRAP_SCREEN_X
 803+ EBF4 C0               RET NZ
 804+ EBF5 3A 56 82         LD A, (CurrentScreenY)
 805+ EBF8 FE 06            CP CHURCH_TRAP_SCREEN_Y
 806+ EBFA C0               RET NZ
 807+ EBFB                  ; --- Solo tras abrir la iglesia 1a vez ---
 808+ EBFB                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 809+ EBFB                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 810+ EBFB                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 811+ EBFB                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 812+ EBFB                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 813+ EBFB 3A 2B 82         LD A, (ChurchEverOpened)
 814+ EBFE B7               OR A
 815+ EBFF C8               RET Z
 816+ EC00                  ; --- Solo si quedan monstruos por atrapar ---
 817+ EC00 3A 37 82         LD A, (NextChurchTrapStep)
 818+ EC03 FE 03            CP 3
 819+ EC05 D0               RET NC
 820+ EC06                  ; --- Type esperado -> statue id ---
 821+ EC06 21 E5 EB         LD HL, ChurchTrapOrderTable
 822+ EC09 5F               LD E, A
 823+ EC0A 16 00            LD D, 0
 824+ EC0C 19               ADD HL, DE
 825+ EC0D 7E               LD A, (HL)                              ; type idx esperado
 826+ EC0E 21 DE EF         LD HL, StatueIdTable
 827+ EC11 5F               LD E, A
 828+ EC12 16 00            LD D, 0
 829+ EC14 19               ADD HL, DE
 830+ EC15 7E               LD A, (HL)                              ; A = statue id
 831+ EC16 B7               OR A
 832+ EC17 C8               RET Z
 833+ EC18 32 57 EC         LD (.hesTargetId), A
 834+ EC1B                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 835+ EC1B 2A 57 82         LD HL, (CurrentScreenAddr)
 836+ EC1E              .hesLoop:
 837+ EC1E 7E               LD A, (HL)
 838+ EC1F FE FF            CP $FF
 839+ EC21 C8               RET Z                                   ; estatua no en esta sala
 840+ EC22 47               LD B, A
 841+ EC23 3A 57 EC         LD A, (.hesTargetId)
 842+ EC26 B8               CP B
 843+ EC27 28 06            JR Z, .hesFound
 844+ EC29 11 04 00         LD DE, 4
 845+ EC2C 19               ADD HL, DE
 846+ EC2D 18 EF            JR .hesLoop
 847+ EC2F              .hesFound:
 848+ EC2F 23               INC HL
 849+ EC30 7E               LD A, (HL)                              ; charX
 850+ EC31 47               LD B, A
 851+ EC32 23               INC HL
 852+ EC33 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 853+ EC34 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 854+ EC36 4F               LD C, A                                 ; C = charY (post-HUD)
 855+ EC37                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 856+ EC37 26 00            LD H, 0
 857+ EC39 69               LD L, C
 858+ EC3A 29               ADD HL, HL
 859+ EC3B 29               ADD HL, HL
 860+ EC3C 29               ADD HL, HL
 861+ EC3D 29               ADD HL, HL
 862+ EC3E 29               ADD HL, HL                              ; HL = charY * 32
 863+ EC3F 58               LD E, B
 864+ EC40 16 00            LD D, 0
 865+ EC42 19               ADD HL, DE                              ; + charX
 866+ EC43 11 00 58         LD DE, $5800
 867+ EC46 19               ADD HL, DE                              ; HL = attr addr top-left
 868+ EC47                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 869+ EC47                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 870+ EC47                  ; no hace falta sincronizar CleanAttrMap.
 871+ EC47 3A 56 EC         LD A, (.hesAttr)
 872+ EC4A 06 03            LD B, 3                                 ; 3 filas de chars
 873+ EC4C              .hesRow:
 874+ EC4C 77               LD (HL), A
 875+ EC4D 23               INC HL
 876+ EC4E 77               LD (HL), A                              ; (charX+1)
 877+ EC4F 11 1F 00         LD DE, 31
 878+ EC52 19               ADD HL, DE                              ; siguiente fila col 0
 879+ EC53 10 F7            DJNZ .hesRow
 880+ EC55 C9               RET
 881+ EC56 00           .hesAttr:     DEFB 0
 882+ EC57 00           .hesTargetId: DEFB 0
 883+ EC58
 884+ EC58              ; ==============================================================================
 885+ EC58              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 886+ EC58              ; ==============================================================================
 887+ EC58              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 888+ EC58              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 889+ EC58              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 890+ EC58              ; + ON final settle): 8 ciclos de ON-OFF en total.
 891+ EC58              ; ==============================================================================
 892+ EC58              STATUE_BLINK_FRAMES   EQU 32
 893+ EC58
 894+ EC58              StartStatueBlink:
 895+ EC58                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 896+ EC58                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 897+ EC58                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 898+ EC58                  ; (caso A), .cbtActChurchDoor (caso B).
 899+ EC58 3E 20            LD A, STATUE_BLINK_FRAMES
 900+ EC5A 32 38 82         LD (StatueBlinkCounter), A
 901+ EC5D C3 E8 EB         JP HighlightExpectedStatue              ; initial ON paint
 902+ EC60
 903+ EC60              UpdateStatueBlink:
 904+ EC60                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 905+ EC60 3A 38 82         LD A, (StatueBlinkCounter)
 906+ EC63 B7               OR A
 907+ EC64 C8               RET Z
 908+ EC65 3D               DEC A
 909+ EC66 32 38 82         LD (StatueBlinkCounter), A
 910+ EC69 20 03            JR NZ, .usbInProgress
 911+ EC6B                  ; Counter recien llego a 0: settle ON
 912+ EC6B C3 E8 EB         JP HighlightExpectedStatue
 913+ EC6E              .usbInProgress:
 914+ EC6E                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 915+ EC6E                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 916+ EC6E CB 3F            SRL A
 917+ EC70 E6 01            AND $01
 918+ EC72 28 05            JR Z, .usbOff
 919+ EC74 3E 47            LD A, $47
 920+ EC76 C3 EC EB         JP PaintExpectedStatueAttr
 921+ EC79              .usbOff:
 922+ EC79 AF               XOR A
 923+ EC7A C3 EC EB         JP PaintExpectedStatueAttr
 924+ EC7D
 925+ EC7D              ; ==============================================================================
 926+ EC7D              ; CUTSCENE - parametros ajustables
 927+ EC7D              ; ==============================================================================
 928+ EC7D              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 929+ EC7D              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 930+ EC7D              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 931+ EC7D              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 932+ EC7D
 933+ EC7D              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 934+ EC7D              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 935+ EC7D              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 936+ EC7D
 937+ EC7D              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
 938+ EC7D              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
 939+ EC7D              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
 940+ EC7D              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
 941+ EC7D              ;   tick 12 -> erase smoke[2], pasar a DONE
 942+ EC7D              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
 943+ EC7D              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
 944+ EC7D
 945+ EC7D              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
 946+ EC7D              ; base del vano (auto-derivada por el editor). El monster (3 chars de
 947+ EC7D              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
 948+ EC7D              ; centrado dentro del vano de la puerta.
 949+ EC7D              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
 950+ EC7D              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
 951+ EC7D              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
 952+ EC7D              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
 953+ EC7D
 954+ EC7D              ; ==============================================================================
 955+ EC7D              ; TriggerChurchTrap - arranca la cutscene de la iglesia
 956+ EC7D              ; ==============================================================================
 957+ EC7D              ; IN: IX = monster atrapado.
 958+ EC7D              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
 959+ EC7D              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
 960+ EC7D              ; en ApplyChurchTrapEffects al final del cutscene.
 961+ EC7D              ; ==============================================================================
 962+ EC7D              TriggerChurchTrap:
 963+ EC7D                  ; --- 1. Calcular slot 0..2 ---
 964+ EC7D DD E5            PUSH IX
 965+ EC7F E1               POP HL
 966+ EC80 11 24 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 967+ EC83 B7               OR A
 968+ EC84 ED 52            SBC HL, DE
 969+ EC86 CB 3D            SRL L
 970+ EC88 CB 3D            SRL L
 971+ EC8A CB 3D            SRL L
 972+ EC8C CB 3D            SRL L                                   ; L = slot 0..2
 973+ EC8E 7D               LD A, L
 974+ EC8F 32 9E 5F         LD (ChurchCutsceneSlot), A
 975+ EC92                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
 976+ EC92 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 977+ EC95 D6 4C            SUB SPRID_MONSTER_0
 978+ EC97 CB 3F            SRL A
 979+ EC99 CB 3F            SRL A
 980+ EC9B CB 3F            SRL A                                   ; A = type idx
 981+ EC9D 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
 982+ ECA0                  ; --- 2. Mover monster al centro del vano ---
 983+ ECA0 3E 78            LD A, CHURCH_TRAP_AREA_POSX
 984+ ECA2 DD 77 03         LD (IX+ENT_POSX), A
 985+ ECA5 3E 58            LD A, CHURCH_TRAP_AREA_POSY
 986+ ECA7 DD 77 04         LD (IX+ENT_POSY), A
 987+ ECAA DD 36 06 00      LD (IX+ENT_DELTAX), 0
 988+ ECAE DD 36 07 00      LD (IX+ENT_DELTAY), 0
 989+ ECB2 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
 990+ ECB6                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
 991+ ECB6                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
 992+ ECB6                  ; del shake y del humo se renderizarian invisibles (ink black sobre
 993+ ECB6                  ; paper black). Forzando ON aqui garantizamos que la animacion de
 994+ ECB6                  ; temblor se vea con ink blanco brillante sobre paper negro.
 995+ ECB6 AF               XOR A
 996+ ECB7 32 38 82         LD (StatueBlinkCounter), A              ; parar blink
 997+ ECBA DD E5            PUSH IX
 998+ ECBC CD E8 EB         CALL HighlightExpectedStatue            ; pintar $47
 999+ ECBF DD E1            POP IX
1000+ ECC1                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1001+ ECC1 3E 01            LD A, 1
1002+ ECC3 32 3B 82         LD (ChurchCutscenePhase), A
1003+ ECC6 AF               XOR A
1004+ ECC7 32 9D 5F         LD (ChurchCutsceneFrame), A
1005+ ECCA 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1006+ ECCC 32 A4 5F         LD (ChurchCutsceneLookCount), A
1007+ ECCF C9               RET
1008+ ECD0
1009+ ECD0              ; ==============================================================================
1010+ ECD0              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1011+ ECD0              ; ==============================================================================
1012+ ECD0              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1013+ ECD0              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1014+ ECD0              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1015+ ECD0              ; ==============================================================================
1016+ ECD0              UpdateChurchCutscene:
1017+ ECD0 3A 3B 82         LD A, (ChurchCutscenePhase)
1018+ ECD3 B7               OR A
1019+ ECD4 C8               RET Z
1020+ ECD5 3D               DEC A
1021+ ECD6 28 12            JR Z, .ucsLookPhase
1022+ ECD8 3D               DEC A
1023+ ECD9 28 38            JR Z, .ucsShakeStatuePhase
1024+ ECDB 3D               DEC A
1025+ ECDC CA 65 ED         JP Z, .ucsSmokePhase
1026+ ECDF                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1027+ ECDF CD 61 EF         CALL ApplyChurchTrapDone
1028+ ECE2 AF               XOR A
1029+ ECE3 32 3B 82         LD (ChurchCutscenePhase), A
1030+ ECE6 32 9D 5F         LD (ChurchCutsceneFrame), A
1031+ ECE9 C9               RET
1032+ ECEA
1033+ ECEA              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1034+ ECEA              .ucsLookPhase:
1035+ ECEA                  ; Frame counter (para detectar fin de fase)
1036+ ECEA 21 9D 5F         LD HL, ChurchCutsceneFrame
1037+ ECED 34               INC (HL)
1038+ ECEE                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1039+ ECEE 21 A4 5F         LD HL, ChurchCutsceneLookCount
1040+ ECF1 35               DEC (HL)
1041+ ECF2 20 06            JR NZ, .ucsLookCheckEnd
1042+ ECF4 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1043+ ECF6 77               LD (HL), A
1044+ ECF7 CD B3 ED         CALL ChurchCutsceneToggleMonsterDir
1045+ ECFA              .ucsLookCheckEnd:
1046+ ECFA 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1047+ ECFD FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1048+ ECFF D8               RET C                                   ; sigue mirando
1049+ ED00                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1050+ ED00                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1051+ ED00                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1052+ ED00 CD 3D EF         CALL EraseChurchTrappedMonster
1053+ ED03 CD D4 F1         CALL CloseChurchDoor
1054+ ED06 CD D8 ED         CALL ChurchCutsceneInitStatueShake
1055+ ED09 3E 02            LD A, 2
