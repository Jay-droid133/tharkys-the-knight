4838+ BDAF              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4839+ BDAF              ; ==============================================================================
4840+ BDAF              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4841+ BDAF              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4842+ BDAF              ; ==============================================================================
4843+ BDAF              KillAllActiveNasties:
4844+ BDAF DD 21 A6 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4845+ BDB3 06 04            LD B, NUM_NASTIES
4846+ BDB5              .kanLoop:
4847+ BDB5 C5               PUSH BC
4848+ BDB6 DD 7E 01         LD A, (IX+ENT_TYPE)
4849+ BDB9 B7               OR A
4850+ BDBA 28 26            JR Z, .kanSkip                  ; slot vacio
4851+ BDBC FE 03            CP TYPE_NASTY
4852+ BDBE 20 22            JR NZ, .kanSkip                 ; no es nasty
4853+ BDC0 DD 7E 02         LD A, (IX+ENT_STATE)
4854+ BDC3 FE 03            CP STATE_DYING
4855+ BDC5 28 1B            JR Z, .kanSkip                  ; ya muriendo
4856+ BDC7                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4857+ BDC7                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4858+ BDC7                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4859+ BDC7                  ; del nasty: peDying paintea el rect del puff con ese color)
4860+ BDC7 CD EB BD         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4861+ BDCA DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4862+ BDCE DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4863+ BDD2 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4864+ BDD6 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4865+ BDDA DD 36 06 00      LD (IX+ENT_DELTAX), 0
4866+ BDDE DD 36 07 00      LD (IX+ENT_DELTAY), 0
4867+ BDE2              .kanSkip:
4868+ BDE2 11 10 00         LD DE, ENT_SIZE
4869+ BDE5 DD 19            ADD IX, DE
4870+ BDE7 C1               POP BC
4871+ BDE8 10 CB            DJNZ .kanLoop
4872+ BDEA C9               RET
4873+ BDEB
4874+ BDEB              ; ==============================================================================
4875+ BDEB              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4876+ BDEB              ; ==============================================================================
4877+ BDEB              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4878+ BDEB              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4879+ BDEB              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4880+ BDEB              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4881+ BDEB              ; deja la posicion original (puff puede asomar levemente, raro).
4882+ BDEB              ; IN:  IX = nasty entity.
4883+ BDEB              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4884+ BDEB              ; Destruye: AF, BC, DE, HL.
4885+ BDEB              ; ==============================================================================
4886+ BDEB              SnapPuffPos:
4887+ BDEB DD 7E 03         LD A, (IX+ENT_POSX)
4888+ BDEE 32 61 BE         LD (.sppOrigX), A
4889+ BDF1 E6 F8            AND $F8
4890+ BDF3 32 63 BE         LD (.sppBaseX), A                   ; base char-aligned X
4891+ BDF6 DD 7E 04         LD A, (IX+ENT_POSY)
4892+ BDF9 32 62 BE         LD (.sppOrigY), A
4893+ BDFC E6 F8            AND $F8
4894+ BDFE 32 64 BE         LD (.sppBaseY), A                   ; base char-aligned Y
4895+ BE01
4896+ BE01                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4897+ BE01 CD 35 BE         CALL .sppCheckFit
4898+ BE04 C8               RET Z
4899+ BE05
4900+ BE05                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4901+ BE05                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4902+ BE05 21 65 BE         LD HL, .sppShifts
4903+ BE08              .sppLoop:
4904+ BE08 7E               LD A, (HL)
4905+ BE09 23               INC HL
4906+ BE0A 47               LD B, A                             ; dx (signed)
4907+ BE0B 7E               LD A, (HL)
4908+ BE0C 23               INC HL
4909+ BE0D FE 80            CP $80
4910+ BE0F 28 17            JR Z, .sppFail                      ; sentinel
4911+ BE11 4F               LD C, A                             ; dy (signed)
4912+ BE12
4913+ BE12 3A 63 BE         LD A, (.sppBaseX)
4914+ BE15 80               ADD A, B
4915+ BE16 DD 77 03         LD (IX+ENT_POSX), A
4916+ BE19 3A 64 BE         LD A, (.sppBaseY)
4917+ BE1C 81               ADD A, C
4918+ BE1D DD 77 04         LD (IX+ENT_POSY), A
4919+ BE20
4920+ BE20 E5               PUSH HL
4921+ BE21 CD 35 BE         CALL .sppCheckFit
4922+ BE24 E1               POP HL
4923+ BE25 C8               RET Z                               ; encontrado
4924+ BE26 18 E0            JR .sppLoop
4925+ BE28
4926+ BE28              .sppFail:
4927+ BE28 3A 61 BE         LD A, (.sppOrigX)
4928+ BE2B DD 77 03         LD (IX+ENT_POSX), A
4929+ BE2E 3A 62 BE         LD A, (.sppOrigY)
4930+ BE31 DD 77 04         LD (IX+ENT_POSY), A
4931+ BE34 C9               RET
4932+ BE35
4933+ BE35              ; --- .sppCheckFit ---
4934+ BE35              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
4935+ BE35              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
4936+ BE35              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
4937+ BE35              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
4938+ BE35              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
4939+ BE35              .sppCheckFit:
4940+ BE35                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
4941+ BE35 DD 7E 03         LD A, (IX+ENT_POSX)
4942+ BE38 FE D1            CP SCREEN_MAX_X - 23
4943+ BE3A 30 21            JR NC, .sppOutOfBounds
4944+ BE3C DD 7E 04         LD A, (IX+ENT_POSY)
4945+ BE3F FE 10            CP SCREEN_MIN_Y
4946+ BE41 38 1A            JR C, .sppOutOfBounds
4947+ BE43 FE 91            CP SCREEN_MAX_Y - 23
4948+ BE45 30 16            JR NC, .sppOutOfBounds
4949+ BE47                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
4950+ BE47 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4951+ BE4A 32 60 BE         LD (.sppSpritIdSave), A
4952+ BE4D DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4953+ BE51 CD 44 BA         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
4954+ BE54 F5               PUSH AF
4955+ BE55 3A 60 BE         LD A, (.sppSpritIdSave)
4956+ BE58 DD 77 00         LD (IX+ENT_SPRITEID), A
4957+ BE5B F1               POP AF
4958+ BE5C C9               RET
4959+ BE5D              .sppOutOfBounds:
4960+ BE5D F6 01            OR 1                                ; NZ
4961+ BE5F C9               RET
4962+ BE60
4963+ BE60 00           .sppSpritIdSave: DEFB 0
4964+ BE61
4965+ BE61 00           .sppOrigX: DEFB 0
4966+ BE62 00           .sppOrigY: DEFB 0
4967+ BE63 00           .sppBaseX: DEFB 0
4968+ BE64 00           .sppBaseY: DEFB 0
4969+ BE65              .sppShifts:
4970+ BE65                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
4971+ BE65                  ; Distancia creciente. Sentinel: dy=$80.
4972+ BE65 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
4973+ BE67 00 F8            DEFB 0,   -8                        ; arriba 8
4974+ BE69 00 08            DEFB 0,    8                        ; abajo 8
4975+ BE6B F8 00            DEFB -8,   0                        ; izq 8
4976+ BE6D 08 00            DEFB 8,    0                        ; der 8
4977+ BE6F 00 F0            DEFB 0,  -16                        ; arriba 16
4978+ BE71 00 10            DEFB 0,   16                        ; abajo 16
4979+ BE73 F8 F8            DEFB -8,  -8
4980+ BE75 08 F8            DEFB 8,   -8
4981+ BE77 F8 08            DEFB -8,   8
4982+ BE79 08 08            DEFB 8,    8
4983+ BE7B 00 80            DEFB 0,  $80                        ; sentinel
4984+ BE7D
4985+ BE7D              ; ==============================================================================
4986+ BE7D              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
4987+ BE7D              ; ==============================================================================
4988+ BE7D              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
4989+ BE7D              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
4990+ BE7D              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
4991+ BE7D              ; DeathSpawned. No-op si la muerte no esta activa.
4992+ BE7D              ; ==============================================================================
4993+ BE7D              SilentKillDeath:
4994+ BE7D DD 21 E6 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
4995+ BE81 DD 7E 01         LD A, (IX+ENT_TYPE)
4996+ BE84 B7               OR A
4997+ BE85 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
4998+ BE87 CD 93 CA         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
4999+ BE8A AF               XOR A
5000+ BE8B DD 77 01         LD (IX+ENT_TYPE), A
5001+ BE8E 32 81 82         LD (DeathSpawned), A
5002+ BE91              .skdResetTimer:
5003+ BE91                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5004+ BE91                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5005+ BE91 21 00 00         LD HL, 0
5006+ BE94 22 7F 82         LD (DeathScreenTimer), HL
5007+ BE97 C9               RET
5008+ BE98
5009+ BE98              ; ==============================================================================
5010+ BE98              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5011+ BE98              ; ==============================================================================
5012+ BE98              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5013+ BE98              ; no DYING ni SPAWNING):
5014+ BE98              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5015+ BE98              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5016+ BE98              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5017+ BE98              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5018+ BE98              ;     Si tampoco, deja el monster donde estaba.
5019+ BE98              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5020+ BE98              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5021+ BE98              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5022+ BE98              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5023+ BE98              ; ==============================================================================
5024+ BE98              FreezeMonstersFacingCorpse:
5025+ BE98                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5026+ BE98 3A 39 81         LD A, (EntityTable + ENT_POSX)
5027+ BE9B 32 79 82         LD (CorpseX), A
5028+ BE9E 3A 3A 81         LD A, (EntityTable + ENT_POSY)
5029+ BEA1 32 7A 82         LD (CorpseY), A
5030+ BEA4                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5031+ BEA4                  ; ya skipea; no aplica aqui pero por simetria)
5032+ BEA4 3E 01            LD A, 1
5033+ BEA6 32 78 82         LD (MonstersFrozen), A
5034+ BEA9 DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5035+ BEAD 06 06            LD B, NUM_MONSTERS
5036+ BEAF              .fmcLoop:
5037+ BEAF C5               PUSH BC
5038+ BEB0 DD 7E 01         LD A, (IX+ENT_TYPE)
5039+ BEB3 FE 02            CP TYPE_MONSTER
5040+ BEB5 20 0E            JR NZ, .fmcNext
5041+ BEB7 DD 7E 02         LD A, (IX+ENT_STATE)
5042+ BEBA FE 03            CP STATE_DYING
5043+ BEBC 28 07            JR Z, .fmcNext
5044+ BEBE FE 04            CP STATE_SPAWNING
5045+ BEC0 28 03            JR Z, .fmcNext
5046+ BEC2 CD CE BE         CALL FreezeOneMonster
5047+ BEC5              .fmcNext:
5048+ BEC5 C1               POP BC
5049+ BEC6 11 10 00         LD DE, ENT_SIZE
5050+ BEC9 DD 19            ADD IX, DE
5051+ BECB 10 E2            DJNZ .fmcLoop
5052+ BECD C9               RET
5053+ BECE
5054+ BECE              ; --- FreezeOneMonster ---
5055+ BECE              ; IX = monster slot pointer.
5056+ BECE              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5057+ BECE              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5058+ BECE              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5059+ BECE              FreezeOneMonster:
5060+ BECE                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5061+ BECE                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5062+ BECE                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5063+ BECE DD 7E 03         LD A, (IX+ENT_POSX)
5064+ BED1 47               LD B, A
5065+ BED2 3A 79 82         LD A, (CorpseX)
5066+ BED5 B8               CP B
5067+ BED6 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5068+ BED8 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5069+ BEDA              .fomFaceE:
5070+ BEDA DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5071+ BEDD C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5072+ BEDF DD 77 00         LD (IX+ENT_SPRITEID), A
5073+ BEE2 18 08            JR .fomFaceDone
5074+ BEE4              .fomFaceW:
5075+ BEE4 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5076+ BEE7 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5077+ BEE9 DD 77 00         LD (IX+ENT_SPRITEID), A
5078+ BEEC              .fomFaceDone:
5079+ BEEC
5080+ BEEC                  ; --- 2) Computar |dx| y |dy| ---
5081+ BEEC 3A 79 82         LD A, (CorpseX)
5082+ BEEF 4F               LD C, A
5083+ BEF0 DD 7E 03         LD A, (IX+ENT_POSX)
5084+ BEF3 91               SUB C                           ; A = posX - corpseX (signed)
5085+ BEF4 30 02            JR NC, .fomDxPos
5086+ BEF6 ED 44            NEG
5087+ BEF8              .fomDxPos:
5088+ BEF8 32 49 BF         LD (.fomAdx), A
5089+ BEFB 3A 7A 82         LD A, (CorpseY)
5090+ BEFE 4F               LD C, A
5091+ BEFF DD 7E 04         LD A, (IX+ENT_POSY)
5092+ BF02 91               SUB C
5093+ BF03 30 02            JR NC, .fomDyPos
5094+ BF05 ED 44            NEG
5095+ BF07              .fomDyPos:
5096+ BF07 32 4A BF         LD (.fomAdy), A
5097+ BF0A
5098+ BF0A                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5099+ BF0A 3A 49 BF         LD A, (.fomAdx)
5100+ BF0D FE 10            CP 16
5101+ BF0F D2 38 BF         JP NC, .fomFreeze
5102+ BF12 3A 4A BF         LD A, (.fomAdy)
5103+ BF15 FE 10            CP 16
5104+ BF17 D2 38 BF         JP NC, .fomFreeze
5105+ BF1A
5106+ BF1A                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5107+ BF1A 3A 49 BF         LD A, (.fomAdx)
5108+ BF1D 47               LD B, A
5109+ BF1E 3A 4A BF         LD A, (.fomAdy)
5110+ BF21 B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5111+ BF22 38 0C            JR C, .fomTryX
5112+ BF24 28 0A            JR Z, .fomTryX
5113+ BF26                  ; |dy| > |dx| -> intentar Y primero
5114+ BF26 CD 7E BF         CALL TryBackoffY
5115+ BF29 28 0D            JR Z, .fomFreeze                ; ok
5116+ BF2B CD 4B BF         CALL TryBackoffX
5117+ BF2E 18 08            JR .fomFreeze
5118+ BF30              .fomTryX:
5119+ BF30 CD 4B BF         CALL TryBackoffX
5120+ BF33 28 03            JR Z, .fomFreeze
5121+ BF35 CD 7E BF         CALL TryBackoffY
5122+ BF38
5123+ BF38              .fomFreeze:
5124+ BF38                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5125+ BF38                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5126+ BF38 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5127+ BF3C DD 36 07 00      LD (IX+ENT_DELTAY), 0
5128+ BF40 DD 36 0A 00      LD (IX+ENT_DIR), 0
5129+ BF44 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5130+ BF48 C9               RET
5131+ BF49
5132+ BF49 00           .fomAdx: DEFB 0
5133+ BF4A 00           .fomAdy: DEFB 0
5134+ BF4B
5135+ BF4B              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5136+ BF4B              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5137+ BF4B              TryBackoffX:
5138+ BF4B DD 7E 03         LD A, (IX+ENT_POSX)
5139+ BF4E 32 7D BF         LD (.tbxSavePos), A
5140+ BF51 47               LD B, A
5141+ BF52 3A 79 82         LD A, (CorpseX)
5142+ BF55 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5143+ BF56 DD 7E 03         LD A, (IX+ENT_POSX)
5144+ BF59 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5145+ BF5B C6 10            ADD A, 16
5146+ BF5D 18 02            JR .tbxApply
5147+ BF5F              .tbxNeg:
5148+ BF5F D6 10            SUB 16
5149+ BF61              .tbxApply:
5150+ BF61                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5151+ BF61 DD 77 03         LD (IX+ENT_POSX), A
5152+ BF64 FE E8            CP SCREEN_MAX_X
5153+ BF66 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5154+ BF68 CD 44 BA         CALL CheckEnemyCollision
5155+ BF6B 20 07            JR NZ, .tbxFail
5156+ BF6D CD B5 BF         CALL CheckMonsterOverlap
5157+ BF70 20 02            JR NZ, .tbxFail
5158+ BF72 AF               XOR A                           ; Z = ok
5159+ BF73 C9               RET
5160+ BF74              .tbxFail:
5161+ BF74 3A 7D BF         LD A, (.tbxSavePos)
5162+ BF77 DD 77 03         LD (IX+ENT_POSX), A
5163+ BF7A F6 01            OR 1                            ; NZ
5164+ BF7C C9               RET
5165+ BF7D 00           .tbxSavePos: DEFB 0
5166+ BF7E
5167+ BF7E              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5168+ BF7E              TryBackoffY:
5169+ BF7E DD 7E 04         LD A, (IX+ENT_POSY)
5170+ BF81 32 B4 BF         LD (.tbySavePos), A
5171+ BF84 47               LD B, A
5172+ BF85 3A 7A 82         LD A, (CorpseY)
5173+ BF88 B8               CP B
5174+ BF89 DD 7E 04         LD A, (IX+ENT_POSY)
5175+ BF8C 30 04            JR NC, .tbyNeg
5176+ BF8E C6 10            ADD A, 16
5177+ BF90 18 02            JR .tbyApply
5178+ BF92              .tbyNeg:
5179+ BF92 D6 10            SUB 16
5180+ BF94              .tbyApply:
5181+ BF94 DD 77 04         LD (IX+ENT_POSY), A
5182+ BF97 FE 10            CP SCREEN_MIN_Y
5183+ BF99 38 10            JR C, .tbyFail
5184+ BF9B FE A8            CP SCREEN_MAX_Y
5185+ BF9D 30 0C            JR NC, .tbyFail
5186+ BF9F CD 44 BA         CALL CheckEnemyCollision
5187+ BFA2 20 07            JR NZ, .tbyFail
5188+ BFA4 CD B5 BF         CALL CheckMonsterOverlap
5189+ BFA7 20 02            JR NZ, .tbyFail
5190+ BFA9 AF               XOR A
5191+ BFAA C9               RET
5192+ BFAB              .tbyFail:
5193+ BFAB 3A B4 BF         LD A, (.tbySavePos)
5194+ BFAE DD 77 04         LD (IX+ENT_POSY), A
5195+ BFB1 F6 01            OR 1
5196+ BFB3 C9               RET
5197+ BFB4 00           .tbySavePos: DEFB 0
5198+ BFB5
5199+ BFB5              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5200+ BFB5              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5201+ BFB5              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5202+ BFB5              CheckMonsterOverlap:
5203+ BFB5 C5               PUSH BC
5204+ BFB6 FD E5            PUSH IY
5205+ BFB8 FD 21 46 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5206+ BFBC 06 06            LD B, NUM_MONSTERS
5207+ BFBE              .cmoLoop:
5208+ BFBE                  ; Skip self (IY == IX)
5209+ BFBE DD E5            PUSH IX
5210+ BFC0 E1               POP HL
5211+ BFC1 FD E5            PUSH IY
5212+ BFC3 D1               POP DE
5213+ BFC4 B7               OR A
5214+ BFC5 ED 52            SBC HL, DE
5215+ BFC7 28 3D            JR Z, .cmoNext                  ; same slot
5216+ BFC9
5217+ BFC9 FD 7E 01         LD A, (IY+ENT_TYPE)
5218+ BFCC FE 02            CP TYPE_MONSTER
5219+ BFCE 20 36            JR NZ, .cmoNext
5220+ BFD0
5221+ BFD0                  ; AABB overlap (rect 16x21 cada uno):
5222+ BFD0                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5223+ BFD0                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5224+ BFD0 DD 7E 03         LD A, (IX+ENT_POSX)
5225+ BFD3 C6 10            ADD A, 16
5226+ BFD5 4F               LD C, A
5227+ BFD6 FD 7E 03         LD A, (IY+ENT_POSX)
5228+ BFD9 B9               CP C                            ; iy.x cmp ix.x+16
5229+ BFDA 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5230+ BFDC FD 7E 03         LD A, (IY+ENT_POSX)
5231+ BFDF C6 10            ADD A, 16
5232+ BFE1 4F               LD C, A
5233+ BFE2 DD 7E 03         LD A, (IX+ENT_POSX)
5234+ BFE5 B9               CP C
5235+ BFE6 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5236+ BFE8 DD 7E 04         LD A, (IX+ENT_POSY)
5237+ BFEB C6 15            ADD A, 21
5238+ BFED 4F               LD C, A
5239+ BFEE FD 7E 04         LD A, (IY+ENT_POSY)
5240+ BFF1 B9               CP C
5241+ BFF2 30 12            JR NC, .cmoNext
5242+ BFF4 FD 7E 04         LD A, (IY+ENT_POSY)
5243+ BFF7 C6 15            ADD A, 21
5244+ BFF9 4F               LD C, A
5245+ BFFA DD 7E 04         LD A, (IX+ENT_POSY)
5246+ BFFD B9               CP C
5247+ BFFE 30 06            JR NC, .cmoNext
5248+ C000                  ; Overlap en ambos ejes
5249+ C000 FD E1            POP IY
5250+ C002 C1               POP BC
5251+ C003 F6 01            OR 1                            ; NZ
5252+ C005 C9               RET
5253+ C006              .cmoNext:
5254+ C006 11 10 00         LD DE, ENT_SIZE
5255+ C009 FD 19            ADD IY, DE
5256+ C00B 10 B1            DJNZ .cmoLoop
5257+ C00D FD E1            POP IY
5258+ C00F C1               POP BC
5259+ C010 AF               XOR A                           ; Z = no overlap
5260+ C011 C9               RET
5261+ C012
5262+ C012              ; ==============================================================================
5263+ C012              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5264+ C012              ; ==============================================================================
5265+ C012              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5266+ C012              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5267+ C012              ; ==============================================================================
5268+ C012              KillAllActiveMonsters:
5269+ C012 AF               XOR A
5270+ C013 32 DF B6         LD (MonstersActive), A              ; No respawnear mas
5271+ C016 DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5272+ C01A 06 06            LD B, NUM_MONSTERS
5273+ C01C              .kamLoop:
5274+ C01C C5               PUSH BC
5275+ C01D DD 7E 01         LD A, (IX+ENT_TYPE)
5276+ C020 B7               OR A
5277+ C021 28 27            JR Z, .kamSkip                      ; slot vacio
5278+ C023 FE 02            CP TYPE_MONSTER
5279+ C025 20 23            JR NZ, .kamSkip                     ; no es monster
5280+ C027 DD 7E 02         LD A, (IX+ENT_STATE)
5281+ C02A FE 03            CP STATE_DYING
5282+ C02C 28 1C            JR Z, .kamSkip
5283+ C02E FE 04            CP STATE_SPAWNING
5284+ C030 28 18            JR Z, .kamSkip
5285+ C032 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5286+ C036 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5287+ C03A DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5288+ C03E DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5289+ C042 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5290+ C046 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5291+ C04A                  ; ENT_ATTR conservado: puff hereda color del monster
5292+ C04A              .kamSkip:
5293+ C04A 11 10 00         LD DE, ENT_SIZE
5294+ C04D DD 19            ADD IX, DE
5295+ C04F C1               POP BC
5296+ C050 10 CA            DJNZ .kamLoop
5297+ C052 C9               RET
5298+ C053
5299+ C053              ; --- Tabla de tipos de nasty (SpriteID base) ---
5300+ C053              ; --- Tablas de nasties por momento del dia ---
5301+ C053              NUM_NASTY_TYPES EQU 4
5302+ C053              DiurnalTypeTable:                       ; DY, C1, A2
5303+ C053 30               DEFB SPRID_ENEMY_4          ; Eagle
5304+ C054 20               DEFB SPRID_ENEMY_0          ; Spider
5305+ C055 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5306+ C056 2C               DEFB SPRID_ENEMY_3          ; Snake
5307+ C057              CrepuscularTypeTable:                   ; C2, N1
5308+ C057 34               DEFB SPRID_ENEMY_5          ; Rat
5309+ C058 28               DEFB SPRID_ENEMY_2          ; Bat
5310+ C059 24               DEFB SPRID_ENEMY_1          ; Scorpion
5311+ C05A 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5312+ C05B
5313+ C05B              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5314+ C05B              NastyColorTable:
5315+ C05B 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5316+ C05C 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5317+ C05D 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5318+ C05E 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5319+ C05F 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5320+ C060 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5321+ C061 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5322+ C062 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5323+ C063
5324+ C063              ; --- Tabla de comportamiento depredador ---
5325+ C063              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5326+ C063              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5327+ C063              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5328+ C063              PredatorTable:
5329+ C063 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5330+ C064 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5331+ C065 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5332+ C066 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5333+ C067 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5334+ C068 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5335+ C069 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5336+ C06A 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5337+ C06B
5338+ C06B              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5339+ C06B              PredatorSpeedTable:
5340+ C06B 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5341+ C06C 02               DEFB 2                              ; Ciclo 1: lento
5342+ C06D 03               DEFB 3                              ; Ciclo 2: intermedio
5343+ C06E 04               DEFB 4                              ; Ciclo 3+: rapido
5344+ C06F
5345+ C06F 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5346+ C070
5347+ C070 53 C0        CurrentNastyTable: DEFW DiurnalTypeTable
5348+ C072
5349+ C072              ; ==============================================================================
5350+ C072              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5351+ C072              ; ==============================================================================
5352+ C072              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5353+ C072              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5354+ C072              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5355+ C072              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5356+ C072              ;   pantalla, no diurnos.
5357+ C072              ; ==============================================================================
5358+ C072              UpdateNastyTable:
5359+ C072 3A 93 E4         LD A, (CurrentTimeOfDay)
5360+ C075 FE 02            CP 2
5361+ C077 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5362+ C079 FE 06            CP 6
5363+ C07B 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5364+ C07D 21 57 C0         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5365+ C080 18 03            JR .setTable
5366+ C082              .diurnal:
5367+ C082 21 53 C0         LD HL, DiurnalTypeTable
5368+ C085              .setTable:
5369+ C085 22 70 C0         LD (CurrentNastyTable), HL
5370+ C088 C9               RET
5371+ C089
5372+ C089              ; ==============================================================================
5373+ C089              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5374+ C089              ; ==============================================================================
5375+ C089              ScareAllMonsters:
5376+ C089 AF               XOR A
5377+ C08A 32 DF B6         LD (MonstersActive), A              ; No respawnear mas
5378+ C08D                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5379+ C08D                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5380+ C08D                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5381+ C08D 21 DA 90         LD HL, MonsterAiFlags
5382+ C090 06 03            LD B, 3
5383+ C092              .samClearLoop:
5384+ C092 7E               LD A, (HL)
5385+ C093 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5386+ C095 77               LD (HL), A
5387+ C096 23               INC HL
5388+ C097 10 F9            DJNZ .samClearLoop
5389+ C099 3E 7D            LD A, SCARE_TIMER_DAWN
5390+ C09B 32 75 B9         LD (ScareTimer), A
5391+ C09E                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5392+ C09E                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5393+ C09E                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5394+ C09E                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5395+ C09E DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5396+ C0A2 06 06            LD B, NUM_MONSTERS
5397+ C0A4              .samStateLoop:
5398+ C0A4 DD 7E 01         LD A, (IX+ENT_TYPE)
5399+ C0A7 FE 02            CP TYPE_MONSTER
5400+ C0A9 20 1B            JR NZ, .samStateNext
5401+ C0AB DD 7E 02         LD A, (IX+ENT_STATE)
5402+ C0AE FE 03            CP STATE_DYING
5403+ C0B0 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5404+ C0B2 FE 04            CP STATE_SPAWNING
5405+ C0B4 28 10            JR Z, .samStateNext
5406+ C0B6 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5407+ C0BA DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5408+ C0BE DD 36 06 00      LD (IX+ENT_DELTAX), 0
5409+ C0C2 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5410+ C0C6              .samStateNext:
5411+ C0C6 11 10 00         LD DE, ENT_SIZE
5412+ C0C9 DD 19            ADD IX, DE
5413+ C0CB 10 D7            DJNZ .samStateLoop
5414+ C0CD C9               RET
5415+ C0CE
5416+ C0CE              ; ==============================================================================
5417+ C0CE              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5418+ C0CE              ; ==============================================================================
5419+ C0CE              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5420+ C0CE              ; ==============================================================================
5421+ C0CE
5422+ C0CE              ; ==============================================================================
5423+ C0CE              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5424+ C0CE              ; ==============================================================================
5425+ C0CE              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5426+ C0CE              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5427+ C0CE              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5428+ C0CE              ; ==============================================================================
5429+ C0CE              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5430+ C0CE              ; ==============================================================================
5431+ C0CE              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5432+ C0CE              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5433+ C0CE              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5434+ C0CE              ; ==============================================================================
5435+ C0CE              MONSTERS_TO_SPAWN   EQU 3
5436+ C0CE              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5437+ C0CE              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5438+ C0CE
5439+ C0CE              ; ==============================================================================
5440+ C0CE              ; SpawnMonsters - Primera aparicion tras campanadas
5441+ C0CE              ; ==============================================================================
5442+ C0CE              SpawnMonsters:
5443+ C0CE 3A DF B6         LD A, (MonstersActive)
5444+ C0D1 B7               OR A
5445+ C0D2 C0               RET NZ
5446+ C0D3                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5447+ C0D3                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5448+ C0D3 CD AF BD         CALL KillAllActiveNasties
5449+ C0D6 3E 01            LD A, 1
5450+ C0D8 32 DF B6         LD (MonstersActive), A
5451+ C0DB CD 58 C1         CALL ShuffleMonsterTypes
5452+ C0DE DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5453+ C0E2 06 03            LD B, MONSTERS_TO_SPAWN
5454+ C0E4 0E 00            LD C, 0
5455+ C0E6              .smLoop:
5456+ C0E6 C5               PUSH BC
5457+ C0E7 DD 7E 01         LD A, (IX+ENT_TYPE)
5458+ C0EA B7               OR A
5459+ C0EB C2 47 C1         JP NZ, .smSkip
5460+ C0EE                  ; Asignar tipo y color
5461+ C0EE 79               LD A, C
5462+ C0EF 21 BC C1         LD HL, MonsterTypeTable
5463+ C0F2 5F               LD E, A
5464+ C0F3 16 00            LD D, 0
5465+ C0F5 19               ADD HL, DE
5466+ C0F6 7E               LD A, (HL)
5467+ C0F7 DD 77 08         LD (IX+ENT_ANIMBASE), A
5468+ C0FA 79               LD A, C
5469+ C0FB 21 BF C1         LD HL, MonsterColorTable
5470+ C0FE 5F               LD E, A
5471+ C0FF 16 00            LD D, 0
5472+ C101 19               ADD HL, DE
5473+ C102 7E               LD A, (HL)
5474+ C103 DD 77 05         LD (IX+ENT_ATTR), A
5475+ C106                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5476+ C106 C5               PUSH BC
5477+ C107 CD FF 92         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5478+ C10A B7               OR A
5479+ C10B 20 0E            JR NZ, .smFallbackPos
5480+ C10D 3A C2 9B         LD A, (MaiSpawnX)
5481+ C110 DD 77 03         LD (IX+ENT_POSX), A
5482+ C113 3A C3 9B         LD A, (MaiSpawnY)
5483+ C116 DD 77 04         LD (IX+ENT_POSY), A
5484+ C119 18 0C            JR .smPosDone
5485+ C11B              .smFallbackPos:
5486+ C11B 3A 95 82         LD A, (LastEntryPosX)
5487+ C11E DD 77 03         LD (IX+ENT_POSX), A
5488+ C121 3A 96 82         LD A, (LastEntryPosY)
5489+ C124 DD 77 04         LD (IX+ENT_POSY), A
5490+ C127              .smPosDone:
5491+ C127 C1               POP BC
5492+ C128                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5493+ C128 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5494+ C12C DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5495+ C130 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5496+ C134 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5497+ C138 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5498+ C13C                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5499+ C13C                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5500+ C13C                  ; lo empuje a un vecino (migracion por knockback).
5501+ C13C CD F4 91         CALL MaiGetCurrentScreenId
5502+ C13F 21 CE 90         LD HL, MonsterRoomId
5503+ C142 59               LD E, C
5504+ C143 16 00            LD D, 0
5505+ C145 19               ADD HL, DE
5506+ C146 77               LD (HL), A
5507+ C147              .smSkip:
5508+ C147 11 10 00         LD DE, ENT_SIZE
5509+ C14A DD 19            ADD IX, DE
5510+ C14C C1               POP BC
5511+ C14D 0C               INC C
5512+ C14E 05               DEC B
5513+ C14F C2 E6 C0         JP NZ, .smLoop
5514+ C152 3E 14            LD A, MONSTER_ENTRY_BASE
5515+ C154 32 9F C2         LD (TryRespawnMonsters.rmTimer), A
5516+ C157 C9               RET
5517+ C158
5518+ C158              ; --- Barajar tablas tipo/color ---
5519+ C158              ShuffleMonsterTypes:
5520+ C158 ED 5F            LD A, R
5521+ C15A E6 03            AND 3
5522+ C15C C8               RET Z
5523+ C15D FE 01            CP 1
5524+ C15F 28 21            JR Z, .shSwap01
5525+ C161 FE 02            CP 2
5526+ C163 28 3A            JR Z, .shSwap12
5527+ C165 3A BC C1         LD A, (MonsterTypeTable)
5528+ C168 57               LD D, A
5529+ C169 3A BE C1         LD A, (MonsterTypeTable + 2)
5530+ C16C 32 BC C1         LD (MonsterTypeTable), A
5531+ C16F 7A               LD A, D
5532+ C170 32 BE C1         LD (MonsterTypeTable + 2), A
5533+ C173 3A BF C1         LD A, (MonsterColorTable)
5534+ C176 57               LD D, A
5535+ C177 3A C1 C1         LD A, (MonsterColorTable + 2)
5536+ C17A 32 BF C1         LD (MonsterColorTable), A
5537+ C17D 7A               LD A, D
5538+ C17E 32 C1 C1         LD (MonsterColorTable + 2), A
5539+ C181 C9               RET
5540+ C182              .shSwap01:
5541+ C182 3A BC C1         LD A, (MonsterTypeTable)
5542+ C185 57               LD D, A
5543+ C186 3A BD C1         LD A, (MonsterTypeTable + 1)
5544+ C189 32 BC C1         LD (MonsterTypeTable), A
5545+ C18C 7A               LD A, D
5546+ C18D 32 BD C1         LD (MonsterTypeTable + 1), A
5547+ C190 3A BF C1         LD A, (MonsterColorTable)
5548+ C193 57               LD D, A
5549+ C194 3A C0 C1         LD A, (MonsterColorTable + 1)
5550+ C197 32 BF C1         LD (MonsterColorTable), A
5551+ C19A 7A               LD A, D
5552+ C19B 32 C0 C1         LD (MonsterColorTable + 1), A
5553+ C19E C9               RET
5554+ C19F              .shSwap12:
5555+ C19F 3A BD C1         LD A, (MonsterTypeTable + 1)
5556+ C1A2 57               LD D, A
5557+ C1A3 3A BE C1         LD A, (MonsterTypeTable + 2)
5558+ C1A6 32 BD C1         LD (MonsterTypeTable + 1), A
5559+ C1A9 7A               LD A, D
5560+ C1AA 32 BE C1         LD (MonsterTypeTable + 2), A
5561+ C1AD 3A C0 C1         LD A, (MonsterColorTable + 1)
5562+ C1B0 57               LD D, A
5563+ C1B1 3A C1 C1         LD A, (MonsterColorTable + 2)
5564+ C1B4 32 C0 C1         LD (MonsterColorTable + 1), A
5565+ C1B7 7A               LD A, D
5566+ C1B8 32 C1 C1         LD (MonsterColorTable + 2), A
5567+ C1BB C9               RET
