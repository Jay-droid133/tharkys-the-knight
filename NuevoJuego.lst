  93+ 6ECE              ; ==============================================================================
  94+ 6ECE              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ 6ECE              ; ==============================================================================
  96+ 6ECE              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
