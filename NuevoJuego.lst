2023+ F925              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2024+ F925              ; ==============================================================================
2025+ F925              ; IN:  B = PathDir, C = PathCoord
2026+ F925              ; OUT: BgSpriteBuffer poblado con sprite
2027+ F925              ; Destruye: AF, DE, HL. Preserva BC.
2028+ F925              ;
2029+ F925              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2030+ F925              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2031+ F925              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2032+ F925              ; ==============================================================================
2033+ F925              LoadHintSprite:
2034+ F925 78               LD A, B
2035+ F926 FE 02            CP 2                                ; W?
2036+ F928 28 12            JR Z, .lhsW
2037+ F92A FE 03            CP 3                                ; E?
2038+ F92C 28 1D            JR Z, .lhsE
2039+ F92E                  ; N o S -> tabla base
2040+ F92E 87               ADD A, A                            ; *2
2041+ F92F 5F               LD E, A
2042+ F930 16 00            LD D, 0
2043+ F932 21 5D F9         LD HL, HintArrowPtrs
2044+ F935 19               ADD HL, DE
2045+ F936 5E               LD E, (HL)
2046+ F937 23               INC HL
2047+ F938 56               LD D, (HL)
2048+ F939 EB               EX DE, HL                           ; HL = sprite ptr
2049+ F93A 18 1C            JR .lhsLoad
2050+ F93C              .lhsW:
2051+ F93C 79               LD A, C
2052+ F93D FE 07            CP 7
2053+ F93F 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2054+ F941 21 7C F4         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
2055+ F944 18 12            JR .lhsLoad
2056+ F946              .lhsWBase:
2057+ F946 21 2A F4         LD HL, BgGfx_arrow_2x2_west
2058+ F949 18 0D            JR .lhsLoad
2059+ F94B              .lhsE:
2060+ F94B 79               LD A, C
2061+ F94C FE 07            CP 7
2062+ F94E 30 05            JR NC, .lhsEBase
2063+ F950 21 B7 F4         LD HL, BgGfx_arrow_2x3_east
2064+ F953 18 03            JR .lhsLoad
2065+ F955              .lhsEBase:
2066+ F955 21 53 F4         LD HL, BgGfx_arrow_2x2_east
2067+ F958              .lhsLoad:
2068+ F958 3E 03            LD A, 3                             ; bank 3 (bg_gfx.asm)
2069+ F95A C3 CA 67         JP LoadBgSpriteToBuffer             ; tail call (preserva BC)
2070+ F95D
2071+ F95D              ; Sprite ptrs ordenados por PathDir: 0=N, 1=S, 2=W, 3=E. 16x16 = 2x2 chars.
2072+ F95D              ; Los labels los crea inject_pickup_sprites.py si no estan placed.
2073+ F95D              HintArrowPtrs:
2074+ F95D D8 F3            DEFW BgGfx_arrow_2x2_north          ; 0 = N (id 42)
2075+ F95F 01 F4            DEFW BgGfx_arrow_2x2_south          ; 1 = S (id 49)
2076+ F961 2A F4            DEFW BgGfx_arrow_2x2_west           ; 2 = W (id 80)
2077+ F963 53 F4            DEFW BgGfx_arrow_2x2_east           ; 3 = E (id 82)
2078+ F965
