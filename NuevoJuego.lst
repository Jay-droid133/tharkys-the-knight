1731+ F6E2              ; ==============================================================================
1732+ F6E2              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1733+ F6E2              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1734+ F6E2              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1735+ F6E2              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1736+ F6E2              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1737+ F6E2              ; ==============================================================================
1738+ F6E2              CompassWobbleTable:
1739+ F6E2 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1740+ F6E6 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1741+ F6EA 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1742+ F6EE 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1743+ F6F2 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1744+ F6F6 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1745+ F6FA 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1746+ F6FE 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1747+ F702 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1748+ F706
1749+ F706              ; ==============================================================================
1750+ F706              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1751+ F706              ; Indexada por (counter-1) -> 0..8. Valor:
1752+ F706              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1753+ F706              ; Con counter inicial 9 y decremento por frame:
1754+ F706              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1755+ F706              ;   counter 8 -> phase 7 -> prev
1756+ F706              ;   counter 7 -> phase 6 -> target
1757+ F706              ;   counter 6 -> phase 5 -> next
1758+ F706              ;   counter 5 -> phase 4 -> next2
1759+ F706              ;   counter 4 -> phase 3 -> prev
1760+ F706              ;   counter 3 -> phase 2 -> target
1761+ F706              ;   counter 2 -> phase 1 -> prev
1762+ F706              ;   counter 1 -> phase 0 -> target (estado final, settle)
1763+ F706              ; ==============================================================================
1764+ F706              WobblePhaseTable:
1765+ F706 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1765+ F70A 04 03 02 01
1765+ F70E 00
