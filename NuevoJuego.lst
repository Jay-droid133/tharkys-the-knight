 626  EB20
 627  EB20                  ; --- Random pickups body (~1.26 KB, slot 1 -> bank 7 move) ---
 628  EB20                  ; Antes vivia en slot 1 entre $6BF7..$70E4. Movido aqui para liberar slot 1
 629  EB20                  ; (RoomCompGapsTable y la IM2 table compiten por el espacio anterior a $7A00).
 630  EB20                  ; Los 9 entry points externos (UpdateRandomPickup, UpdateRoulette, ...) viven
 631  EB20                  ; como thunks en slot 1 (random_pickups_thunks.asm). El body usa _B7 wrappers
 632  EB20                  ; (LoadBgSpriteToBuffer_B7, DrawBgSpriteXOR_B7, PlaySFX_B7, SkipPixelData_B7,
 633  EB20                  ; RestorePickupAttrs_B7, ApplyMagicCompassBuff_B7) para envolver cada CALL
 634  EB20                  ; externo. Internamente las dispatch tail-JPs (GiveLife etc.) usan los Body
 635  EB20                  ; suffix (intra-bank, no thunk).
 636  EB20                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ EB20              ; ==============================================================================
   2+ EB20              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ EB20              ; ==============================================================================
   4+ EB20              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ EB20              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ EB20              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ EB20              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ EB20              ; correspondiente desde CheckPickupCollect.
   9+ EB20              ;
  10+ EB20              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ EB20              ; si en el futuro se ponen pickups fijos en el editor.
  12+ EB20              ;
  13+ EB20              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ EB20              ; Bank 0/2 quedan limpios.
  15+ EB20              ; ==============================================================================
  16+ EB20
  17+ EB20              ; ==============================================================================
  18+ EB20              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ EB20              ; ==============================================================================
  20+ EB20              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ EB20              ; el cambio via cache .dlhLast.
  22+ EB20              ; ==============================================================================
  23+ EB20              GiveLifeBody:
  24+ EB20 3A E6 82         LD A, (PlayerLives)
  25+ EB23 FE 05            CP PLAYER_LIVES_MAX
  26+ EB25 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ EB26 3C               INC A
  28+ EB27 32 E6 82         LD (PlayerLives), A
  29+ EB2A C9               RET
  30+ EB2B
  31+ EB2B              ; ==============================================================================
  32+ EB2B              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ EB2B              ; ==============================================================================
  34+ EB2B              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ EB2B              ; ==============================================================================
  36+ EB2B              GiveHealthBody:
  37+ EB2B 3A C8 B3         LD A, (PlayerHealth)
  38+ EB2E C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ EB30 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ EB32 FE 11            CP HEALTH_MAX + 1
  41+ EB34 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ EB36              .ghCap:
  43+ EB36 3E 10            LD A, HEALTH_MAX
  44+ EB38              .ghStore:
  45+ EB38 32 C8 B3         LD (PlayerHealth), A
  46+ EB3B C9               RET
  47+ EB3C
  48+ EB3C              ; ==============================================================================
  49+ EB3C              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ EB3C              ; ==============================================================================
  51+ EB3C              GiveStaminaBody:
  52+ EB3C 3A C9 B3         LD A, (PlayerStamina)
  53+ EB3F C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ EB41 38 04            JR C, .gsCap
  55+ EB43 FE 11            CP STAMINA_MAX + 1
  56+ EB45 38 02            JR C, .gsStore
  57+ EB47              .gsCap:
  58+ EB47 3E 10            LD A, STAMINA_MAX
  59+ EB49              .gsStore:
  60+ EB49 32 C9 B3         LD (PlayerStamina), A
  61+ EB4C C9               RET
  62+ EB4D
  63+ EB4D              ; ==============================================================================
  64+ EB4D              ; ROULETTE — datos (fase 5: por categorias)
  65+ EB4D              ; ==============================================================================
  66+ EB4D              ; La ruleta cicla 6 caras en orden fijo:
  67+ EB4D              ;   ESPECIAL -> MALO -> RECURSO -> MALO -> STATS -> MALO -> (wrap)
  68+ EB4D              ; 50% de las caras son MALO -> tension al recoger sin mirar. Cada cara pica
  69+ EB4D              ; un item RANDOM dentro de su categoria cada tick (~480ms).
  70+ EB4D              ROULETTE_ORDER_LEN  EQU 6
  71+ EB4D
  72+ EB4D              ; Secuencia de las 6 caras (CAT_* enum):
  73+ EB4D              RouletteCatOrder:
  74+ EB4D 00               DEFB CAT_ESPECIAL                       ; cara 0
  75+ EB4E 01               DEFB CAT_MALO                           ; cara 1
  76+ EB4F 02               DEFB CAT_RECURSO                        ; cara 2
  77+ EB50 01               DEFB CAT_MALO                           ; cara 3
  78+ EB51 03               DEFB CAT_STATS                          ; cara 4
  79+ EB52 01               DEFB CAT_MALO                           ; cara 5
  80+ EB53
  81+ EB53              ; Items por categoria (formato: DEFB count, ROUL_* items...):
  82+ EB53              RouletteCatEspecial:
  83+ EB53 03               DEFB 3
  84+ EB54 01 07 0A         DEFB ROUL_LIFE, ROUL_COMPASS, ROUL_ESCUDO_RAYO
  85+ EB57              RouletteCatMalo:
  86+ EB57 03               DEFB 3
  87+ EB58 06 05 0B         DEFB ROUL_MUSHROOM, ROUL_CARACOL, ROUL_REVERSE
  88+ EB5B              RouletteCatRecurso:
  89+ EB5B 02               DEFB 2
  90+ EB5C 02 03            DEFB ROUL_HEALTH, ROUL_STAMINA
  91+ EB5E              RouletteCatStats:
  92+ EB5E 03               DEFB 3
  93+ EB5F 04 08 09         DEFB ROUL_RAYO, ROUL_ESPADA, ROUL_ESCUDO
  94+ EB62
  95+ EB62              ; Lookup CAT_* -> cat table ptr (DEFW):
  96+ EB62              RouletteCatItemTables:
  97+ EB62 53 EB            DEFW RouletteCatEspecial                ; CAT_ESPECIAL = 0
  98+ EB64 57 EB            DEFW RouletteCatMalo                    ; CAT_MALO = 1
  99+ EB66 5B EB            DEFW RouletteCatRecurso                 ; CAT_RECURSO = 2
 100+ EB68 5E EB            DEFW RouletteCatStats                   ; CAT_STATS = 3
 101+ EB6A
 102+ EB6A              ; RouletteTypePtrs: lookup ROUL_* (1..11) -> BgGfx canonical ptr.
 103+ EB6A              ; HEALTH/STAMINA usan variant pick (PickRandomVariantPtr), no esta tabla.
 104+ EB6A              RouletteTypePtrs:
 105+ EB6A A5 CC            DEFW BgGfx_life                                     ; ROUL_LIFE        = 1
 106+ EB6C 89 E7            DEFW BgGfx_health_pickup                            ; ROUL_HEALTH      = 2 (unused: variants)
 107+ EB6E B2 E7            DEFW BgGfx_stamina_pickup                           ; ROUL_STAMINA     = 3 (unused: variants)
 108+ EB70 DB E7            DEFW BgGfx_pickup_ray                               ; ROUL_RAYO        = 4
 109+ EB72 04 E8            DEFW BgGfx_pickup_snail                             ; ROUL_CARACOL     = 5
 110+ EB74 2D E8            DEFW BgGfx_pickup_mushroom                          ; ROUL_MUSHROOM    = 6
 111+ EB76 D4 F3            DEFW BgGfx_pickup_compass                           ; ROUL_COMPASS     = 7
 112+ EB78 05 F5            DEFW BgGfx_pickup_sword                             ; ROUL_ESPADA      = 8
 113+ EB7A B3 F4            DEFW BgGfx_pickup_shield                            ; ROUL_ESCUDO      = 9
 114+ EB7C DC F4            DEFW BgGfx_pickup_shield_ray                        ; ROUL_ESCUDO_RAYO = 10
 115+ EB7E 2E F5            DEFW BgGfx_pickup_reverse                           ; ROUL_REVERSE     = 11
 116+ EB80
 117+ EB80              ; ==============================================================================
 118+ EB80              ; GetRoulettePtrByIdx - dado RouletteIdx (0..5), pica un item random de la cat
 119+ EB80              ; ==============================================================================
 120+ EB80              ; IN:  A = RouletteIdx (0..5)
 121+ EB80              ; OUT: HL = BgGfx ptr al sprite picado.
 122+ EB80              ;      Side: RouletteDisplayedType <- ROUL_* picado (para .crsApplyRouletteHit).
 123+ EB80              ; Destruye: AF, BC, DE, HL.
 124+ EB80              ;
 125+ EB80              ; Logica:
 126+ EB80              ;   1. cat = RouletteCatOrder[idx]
 127+ EB80              ;   2. table = RouletteCatItemTables[cat]    (DEFB count, DEFB items...)
 128+ EB80              ;   3. R mod count -> pick. Si pick == ROUL_COMPASS y MagicCompassPermanent
 129+ EB80              ;      activo, re-pica (loop). RouletteCatEspecial tiene 2 items non-compass
 130+ EB80              ;      => terminacion garantizada.
 131+ EB80              ;   4. Store ROUL_* en RouletteDisplayedType.
 132+ EB80              ;   5. Si ROUL_HEALTH / ROUL_STAMINA -> PickRandomVariantPtr (variante random).
 133+ EB80              ;      Resto -> lookup canonical en RouletteTypePtrs.
 134+ EB80              ;
 135+ EB80              ; .grpiCount / .grpiItems: scratch DEFB/DEFW al final de la rutina (bank 7).
 136+ EB80              ; ==============================================================================
 137+ EB80              GetRoulettePtrByIdx:
 138+ EB80                  ; --- 1. Resolve cat ptr ---
 139+ EB80 21 4D EB         LD HL, RouletteCatOrder
 140+ EB83 5F               LD E, A
 141+ EB84 16 00            LD D, 0
 142+ EB86 19               ADD HL, DE
 143+ EB87 7E               LD A, (HL)                              ; A = cat (0..3)
 144+ EB88 87               ADD A, A
 145+ EB89 5F               LD E, A
 146+ EB8A 21 62 EB         LD HL, RouletteCatItemTables
 147+ EB8D 19               ADD HL, DE
 148+ EB8E 7E               LD A, (HL)
 149+ EB8F 23               INC HL
 150+ EB90 66               LD H, (HL)
 151+ EB91 6F               LD L, A                                 ; HL = cat table (count + items)
 152+ EB92 7E               LD A, (HL)
 153+ EB93 32 DC EB         LD (.grpiCount), A                      ; save count en scratch
 154+ EB96 23               INC HL
 155+ EB97 22 DD EB         LD (.grpiItems), HL                     ; save items ptr en scratch
 156+ EB9A
 157+ EB9A              .grpiPick:
 158+ EB9A 3A DC EB         LD A, (.grpiCount)
 159+ EB9D 47               LD B, A
 160+ EB9E ED 5F            LD A, R
 161+ EBA0              .grpiMod:
 162+ EBA0 90               SUB B
 163+ EBA1 30 FD            JR NC, .grpiMod
 164+ EBA3 80               ADD A, B                                ; A = R mod count
 165+ EBA4 5F               LD E, A
 166+ EBA5 16 00            LD D, 0
 167+ EBA7 2A DD EB         LD HL, (.grpiItems)
 168+ EBAA 19               ADD HL, DE
 169+ EBAB 7E               LD A, (HL)                              ; A = ROUL_* picado
 170+ EBAC
 171+ EBAC                  ; --- Skip compass si lasting permanent ---
 172+ EBAC 21 CD 82         LD HL, MagicCompassPermanent
 173+ EBAF CB 46            BIT 0, (HL)
 174+ EBB1 28 04            JR Z, .grpiPicked
 175+ EBB3 FE 07            CP ROUL_COMPASS
 176+ EBB5 28 E3            JR Z, .grpiPick                         ; compass + permanent -> re-pica
 177+ EBB7
 178+ EBB7              .grpiPicked:
 179+ EBB7 32 E0 5F         LD (RouletteDisplayedType), A           ; persistir para dispatcher al recoger
 180+ EBBA
 181+ EBBA                  ; --- Lookup sprite ptr ---
 182+ EBBA FE 02            CP ROUL_HEALTH
 183+ EBBC 28 12            JR Z, .grpiHealth
 184+ EBBE FE 03            CP ROUL_STAMINA
 185+ EBC0 28 14            JR Z, .grpiStamina
 186+ EBC2                  ; Resto: canonical en RouletteTypePtrs[A-1]
 187+ EBC2 3D               DEC A
 188+ EBC3 26 00            LD H, 0
 189+ EBC5 6F               LD L, A
 190+ EBC6 29               ADD HL, HL
 191+ EBC7 11 6A EB         LD DE, RouletteTypePtrs
 192+ EBCA 19               ADD HL, DE
 193+ EBCB 7E               LD A, (HL)
 194+ EBCC 23               INC HL
 195+ EBCD 66               LD H, (HL)
 196+ EBCE 6F               LD L, A                                 ; HL = sprite ptr
 197+ EBCF C9               RET
 198+ EBD0              .grpiHealth:
 199+ EBD0 21 D4 F1         LD HL, HealthVariantPtrs
 200+ EBD3 C3 E8 F1         JP PickRandomVariantPtr
 201+ EBD6              .grpiStamina:
 202+ EBD6 21 DF F1         LD HL, StaminaVariantPtrs
 203+ EBD9 C3 E8 F1         JP PickRandomVariantPtr
 204+ EBDC
 205+ EBDC              ; Scratch usado por GetRoulettePtrByIdx (vive en bank 7 con el body):
 206+ EBDC 00           .grpiCount: DEFB 0
 207+ EBDD 00 00        .grpiItems: DEFW 0
 208+ EBDF
 209+ EBDF              ; ==============================================================================
 210+ EBDF              ; LoadSynthSpriteAndExtractAttr - HL=ptr → set RandomSynthPtr, load buffer,
 211+ EBDF              ;                                 store los 4 attr bytes (TL,TR,BL,BR) del 2x2.
 212+ EBDF              ; ==============================================================================
 213+ EBDF              ; Antes guardaba solo attr[0] (TL) y PaintSynthPickupAttrs lo replicaba a las
 214+ EBDF              ; 4 celdas, perdiendo el patrón per-celda del BG editor (ej: col1 bright,
 215+ EBDF              ; col2 dim). Ahora extraemos los 4 → preservación 1:1.
 216+ EBDF              ; ==============================================================================
 217+ EBDF              LoadSynthSpriteAndExtractAttr:
 218+ EBDF 22 B6 5F         LD (RandomSynthPtr), HL
 219+ EBE2 3E 03            LD A, 3
 220+ EBE4 CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 221+ EBE7 DD 21 FD 86      LD IX, BgSpriteBuffer
 222+ EBEB CD D3 6D         CALL SkipPixelData_B7                      ; IX @ tintPaper
 223+ EBEE DD 23            INC IX                                  ; @ attr_h
 224+ EBF0 DD 23            INC IX                                  ; @ attr_w
 225+ EBF2 DD 23            INC IX                                  ; @ attr_data[0] = TL
 226+ EBF4 DD 7E 00         LD A, (IX+0)
 227+ EBF7 32 BB 5F         LD (RandomSynthAttr), A                 ; TL
 228+ EBFA DD 7E 01         LD A, (IX+1)
 229+ EBFD 32 E1 5F         LD (RandomSynthAttrTR), A
 230+ EC00 DD 7E 02         LD A, (IX+2)
 231+ EC03 32 E2 5F         LD (RandomSynthAttrBL), A
 232+ EC06 DD 7E 03         LD A, (IX+3)
 233+ EC09 32 E3 5F         LD (RandomSynthAttrBR), A
 234+ EC0C C9               RET
 235+ EC0D
 236+ EC0D              ; ==============================================================================
 237+ EC0D              ; AdvanceRouletteIdx / SkipCompassIfNeeded - INC con wrap mod ROULETTE_ORDER_LEN
 238+ EC0D              ; ==============================================================================
 239+ EC0D              ; Tras fase 5 (ruleta por categorias), el skip-compass vive en GetRoulettePtrByIdx
 240+ EC0D              ; (re-pica dentro de la cat si sale COMPASS + permanent). Aqui solo queda el
 241+ EC0D              ; INC + wrap. SkipCompassIfNeeded mantiene su nombre por compatibilidad con
 242+ EC0D              ; .urpDoRoulette init (caller).
 243+ EC0D              ;
 244+ EC0D              ; IN:  A = idx actual (0..ROULETTE_ORDER_LEN-1)
 245+ EC0D              ; OUT: A = idx avanzado (mod 6). Para SkipCompassIfNeeded: A sin cambios.
 246+ EC0D              ; Destruye: AF.
 247+ EC0D              ; ==============================================================================
 248+ EC0D              AdvanceRouletteIdx:
 249+ EC0D 3C               INC A
 250+ EC0E FE 06            CP ROULETTE_ORDER_LEN
 251+ EC10 D8               RET C
 252+ EC11 AF               XOR A
 253+ EC12 C9               RET
 254+ EC13              SkipCompassIfNeeded:
 255+ EC13                  ; No-op: el skip-compass vive en GetRoulettePtrByIdx (re-pick within cat).
 256+ EC13 C9               RET
 257+ EC14
 258+ EC14              ; ==============================================================================
 259+ EC14              ; UpdateRoulette - tick del ciclado de la ruleta (slot 1, MainLoop)
 260+ EC14              ; ==============================================================================
 261+ EC14              ; Llamado cada frame. Si RouletteActive=0, no-op. Si el synth fue recogido
 262+ EC14              ; ($FE en MapX), no-op. En cada paso: erase sprite actual, avanza idx,
 263+ EC14              ; carga sprite nuevo, dibuja, repaint attrs.
 264+ EC14              ; ==============================================================================
 265+ EC14              UpdateRouletteBody:
 266+ EC14 3A BC 5F         LD A, (RouletteActive)
 267+ EC17 B7               OR A
 268+ EC18 C8               RET Z
 269+ EC19 3A B4 5F         LD A, (RandomSynthMapX)
 270+ EC1C FE FE            CP $FE
 271+ EC1E C8               RET Z                                   ; recogido / inactivo: no ciclar
 272+ EC1F
 273+ EC1F                  ; Tick frame counter
 274+ EC1F 21 BE 5F         LD HL, RouletteFrameCounter
 275+ EC22 35               DEC (HL)
 276+ EC23 C0               RET NZ                                  ; aun no toca avanzar
 277+ EC24
 278+ EC24                  ; --- Counter expirado: ciclar al siguiente tipo ---
 279+ EC24 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 280+ EC26 32 BE 5F         LD (RouletteFrameCounter), A
 281+ EC29
 282+ EC29                  ; Erase sprite actual (XOR redraw del sprite actualmente en RandomSynthPtr).
 283+ EC29 2A B6 5F         LD HL, (RandomSynthPtr)
 284+ EC2C 3E 03            LD A, 3
 285+ EC2E CD DE 6E         CALL LoadBgSpriteToBuffer_B7
 286+ EC31 3A B8 5F         LD A, (RandomSynthCharX)
 287+ EC34 47               LD B, A
 288+ EC35 3A B9 5F         LD A, (RandomSynthCharY)
 289+ EC38 4F               LD C, A
 290+ EC39 DD 21 FD 86      LD IX, BgSpriteBuffer
 291+ EC3D CD 9F 6E         CALL DrawBgSpriteXOR_B7
 292+ EC40
 293+ EC40                  ; Avanzar idx con wrap (AdvanceRouletteIdx skipea ROUL_COMPASS si la
 294+ EC40                  ; brujula permanente esta activa — no se ve un solo frame de compass).
 295+ EC40 3A BD 5F         LD A, (RouletteIdx)
 296+ EC43 CD 0D EC         CALL AdvanceRouletteIdx
 297+ EC46 32 BD 5F         LD (RouletteIdx), A
 298+ EC49
 299+ EC49                  ; Lookup nuevo tipo, cargar sprite, extraer attr
 300+ EC49 CD 80 EB         CALL GetRoulettePtrByIdx                ; HL = nuevo ptr
 301+ EC4C CD DF EB         CALL LoadSynthSpriteAndExtractAttr
 302+ EC4F
 303+ EC4F                  ; Dibujar sprite nuevo
 304+ EC4F 3A B8 5F         LD A, (RandomSynthCharX)
 305+ EC52 47               LD B, A
 306+ EC53 3A B9 5F         LD A, (RandomSynthCharY)
 307+ EC56 4F               LD C, A
 308+ EC57 DD 21 FD 86      LD IX, BgSpriteBuffer
 309+ EC5B CD 9F 6E         CALL DrawBgSpriteXOR_B7
 310+ EC5E
 311+ EC5E                  ; Repaint attrs en VRAM
 312+ EC5E C3 09 F0         JP PaintSynthPickupAttrsBody            ; tail call (intra-body)
 313+ EC61
 314+ EC61              ; ==============================================================================
 315+ EC61              ; UpdatePlayerColorCyclerBody - cycler de color player segun buffs activos
 316+ EC61              ; ==============================================================================
 317+ EC61              ; Llamado desde MainLoop cada frame via thunk slot 1 (UpdatePlayerColorCycler).
 318+ EC61              ; Lee timers de buffs/debuffs activos (16-bit cada uno), cuenta cuantos hay,
 319+ EC61              ; cycla entre sus colores cada COLOR_CYCLER_PERIOD frames.
 320+ EC61              ;
 321+ EC61              ; Prioridades (en orden):
 322+ EC61              ;   1. PlayerHitTimer > 0  -> no tocar color (RED damage flash gana)
 323+ EC61              ;   2. >=1 buff activo     -> cyclar entre sus colores
 324+ EC61              ;   3. AttackCooldown > 0  -> no tocar color (BLUE sword cooldown persiste)
 325+ EC61              ;   4. Default             -> escribir WHITE | $40
 326+ EC61              ;
 327+ EC61              ; Orden fijo en el ciclo (afecta cual se ve primero): SpeedBuff (RAYO/CARACOL)
 328+ EC61              ; primero, luego MushroomBuff (SETA). Fase 3/4 anadira ESPADA / ESCUDO / REVERSE.
 329+ EC61              ;
 330+ EC61              ; Destruye: AF, BC, DE, HL.
 331+ EC61              ; ==============================================================================
 332+ EC61              UpdatePlayerColorCyclerBody:
 333+ EC61                  ; NOTA: el check de PlayerHitTimer vive en el thunk slot 1, NO aqui.
 334+ EC61                  ; PlayerHitTimer esta en bank 0 (slot 3) y desde bank 7 body slot 3 = bank 7
 335+ EC61                  ; -> lectura corrupta. El thunk gates el call antes de paginar.
 336+ EC61
 337+ EC61                  ; --- Pass 1: contar timers activos ---
 338+ EC61 06 00            LD B, 0                                 ; B = count
 339+ EC63 3A DF 82         LD A, (SpeedBuffTimer)
 340+ EC66 4F               LD C, A
 341+ EC67 3A E0 82         LD A, (SpeedBuffTimer+1)
 342+ EC6A B1               OR C
 343+ EC6B 28 01            JR Z, .upcc_noSpeed
 344+ EC6D 04               INC B
 345+ EC6E              .upcc_noSpeed:
 346+ EC6E 3A E2 82         LD A, (MushroomLockTimer)
 347+ EC71 4F               LD C, A
 348+ EC72 3A E3 82         LD A, (MushroomLockTimer+1)
 349+ EC75 B1               OR C
 350+ EC76 28 01            JR Z, .upcc_noMush
 351+ EC78 04               INC B
 352+ EC79              .upcc_noMush:
 353+ EC79 3A DA 5F         LD A, (EspadaTimer)
 354+ EC7C 4F               LD C, A
 355+ EC7D 3A DB 5F         LD A, (EspadaTimer+1)
 356+ EC80 B1               OR C
 357+ EC81 28 01            JR Z, .upcc_noEspada
 358+ EC83 04               INC B
 359+ EC84              .upcc_noEspada:
 360+ EC84 3A DC 5F         LD A, (EscudoTimer)
 361+ EC87 4F               LD C, A
 362+ EC88 3A DD 5F         LD A, (EscudoTimer+1)
 363+ EC8B B1               OR C
 364+ EC8C 28 01            JR Z, .upcc_noEscudo
 365+ EC8E 04               INC B
 366+ EC8F              .upcc_noEscudo:
 367+ EC8F 3A DE 5F         LD A, (ReverseTimer)
 368+ EC92 4F               LD C, A
 369+ EC93 3A DF 5F         LD A, (ReverseTimer+1)
 370+ EC96 B1               OR C
 371+ EC97 28 01            JR Z, .upcc_noReverse
 372+ EC99 04               INC B
 373+ EC9A              .upcc_noReverse:
 374+ EC9A
 375+ EC9A 78               LD A, B
 376+ EC9B B7               OR A
 377+ EC9C 20 12            JR NZ, .upcc_haveBuffs
 378+ EC9E
 379+ EC9E                  ; --- Sin buffs. Prioridad 3: cooldown de espada = MAGENTA bright ---
 380+ EC9E 3A C4 B3         LD A, (AttackCooldown)
 381+ ECA1 B7               OR A
 382+ ECA2 28 06            JR Z, .upcc_default
 383+ ECA4 3E 43            LD A, MAGENTA | $40                     ; $43 magenta bright (cooldown)
 384+ ECA6 32 A8 81         LD (EntityTable + ENT_ATTR), A
 385+ ECA9 C9               RET
 386+ ECAA
 387+ ECAA              .upcc_default:
 388+ ECAA                  ; --- Default: WHITE | $40 ---
 389+ ECAA 3E 47            LD A, WHITE | $40
 390+ ECAC 32 A8 81         LD (EntityTable + ENT_ATTR), A
 391+ ECAF C9               RET
 392+ ECB0
 393+ ECB0              .upcc_haveBuffs:
 394+ ECB0                  ; --- Increment frame counter (wrap natural a 256) ---
 395+ ECB0 21 D9 5F         LD HL, PlayerColorCyclerFrame
 396+ ECB3 34               INC (HL)
 397+ ECB4
 398+ ECB4                  ; --- Slot = (frame / COLOR_CYCLER_PERIOD) mod B ---
 399+ ECB4 7E               LD A, (HL)
 400+ ECB5 16 00            LD D, 0                                 ; D = quotient (frame / PERIOD)
 401+ ECB7              .upcc_divLoop:
 402+ ECB7 D6 0C            SUB COLOR_CYCLER_PERIOD
 403+ ECB9 38 03            JR C, .upcc_divDone
 404+ ECBB 14               INC D
 405+ ECBC 18 F9            JR .upcc_divLoop
 406+ ECBE              .upcc_divDone:
 407+ ECBE                  ; D = floor(frame / PERIOD). Mod B:
 408+ ECBE 7A               LD A, D
 409+ ECBF              .upcc_modLoop:
 410+ ECBF 90               SUB B
 411+ ECC0 30 FD            JR NC, .upcc_modLoop
 412+ ECC2 80               ADD A, B                                ; A = slot (0..B-1)
 413+ ECC3 57               LD D, A                                 ; D = target slot
 414+ ECC4
 415+ ECC4                  ; --- Pass 2: iterar buffs en orden fijo, aplicar color del slot-th ---
 416+ ECC4 0E 00            LD C, 0                                 ; running count
 417+ ECC6
 418+ ECC6                  ; SpeedBuff (RAYO o CARACOL)
 419+ ECC6 3A DF 82         LD A, (SpeedBuffTimer)
 420+ ECC9 5F               LD E, A
 421+ ECCA 3A E0 82         LD A, (SpeedBuffTimer+1)
 422+ ECCD B3               OR E
 423+ ECCE 28 05            JR Z, .upcc_skipSpeed
 424+ ECD0 7A               LD A, D
 425+ ECD1 B9               CP C
 426+ ECD2 28 4A            JR Z, .upcc_applySpeed
 427+ ECD4 0C               INC C
 428+ ECD5              .upcc_skipSpeed:
 429+ ECD5
 430+ ECD5                  ; MushroomBuff (SETA)
 431+ ECD5 3A E2 82         LD A, (MushroomLockTimer)
 432+ ECD8 5F               LD E, A
 433+ ECD9 3A E3 82         LD A, (MushroomLockTimer+1)
 434+ ECDC B3               OR E
 435+ ECDD 28 05            JR Z, .upcc_skipMush
 436+ ECDF 7A               LD A, D
 437+ ECE0 B9               CP C
 438+ ECE1 28 48            JR Z, .upcc_applyMush
 439+ ECE3 0C               INC C
 440+ ECE4              .upcc_skipMush:
 441+ ECE4
 442+ ECE4                  ; Espada
 443+ ECE4 3A DA 5F         LD A, (EspadaTimer)
 444+ ECE7 5F               LD E, A
 445+ ECE8 3A DB 5F         LD A, (EspadaTimer+1)
 446+ ECEB B3               OR E
 447+ ECEC 28 05            JR Z, .upcc_skipEspada
 448+ ECEE 7A               LD A, D
 449+ ECEF B9               CP C
 450+ ECF0 28 20            JR Z, .upcc_applyEspada
 451+ ECF2 0C               INC C
 452+ ECF3              .upcc_skipEspada:
 453+ ECF3
 454+ ECF3                  ; Escudo
 455+ ECF3 3A DC 5F         LD A, (EscudoTimer)
 456+ ECF6 5F               LD E, A
 457+ ECF7 3A DD 5F         LD A, (EscudoTimer+1)
 458+ ECFA B3               OR E
 459+ ECFB 28 05            JR Z, .upcc_skipEscudo
 460+ ECFD 7A               LD A, D
 461+ ECFE B9               CP C
 462+ ECFF 28 15            JR Z, .upcc_applyEscudo
 463+ ED01 0C               INC C
 464+ ED02              .upcc_skipEscudo:
 465+ ED02
 466+ ED02                  ; Reverse
 467+ ED02 3A DE 5F         LD A, (ReverseTimer)
 468+ ED05 5F               LD E, A
 469+ ED06 3A DF 5F         LD A, (ReverseTimer+1)
 470+ ED09 B3               OR E
 471+ ED0A 28 05            JR Z, .upcc_skipReverse
 472+ ED0C 7A               LD A, D
 473+ ED0D B9               CP C
 474+ ED0E 28 0A            JR Z, .upcc_applyReverse
 475+ ED10 0C               INC C
 476+ ED11              .upcc_skipReverse:
 477+ ED11
 478+ ED11 C9               RET                                     ; unreachable si pass 1 fue correcto
 479+ ED12
 480+ ED12              .upcc_applyEspada:
 481+ ED12 3E 42            LD A, ESPADA_BUFF_ATTR                  ; $42 red bright
 482+ ED14 18 17            JR .upcc_writeAttr
 483+ ED16
 484+ ED16              .upcc_applyEscudo:
 485+ ED16 3E 46            LD A, ESCUDO_BUFF_ATTR                  ; $46 yellow bright
 486+ ED18 18 13            JR .upcc_writeAttr
 487+ ED1A
 488+ ED1A              .upcc_applyReverse:
 489+ ED1A 3E 41            LD A, REVERSE_BUFF_ATTR                 ; $41 blue bright
 490+ ED1C 18 0F            JR .upcc_writeAttr
 491+ ED1E
 492+ ED1E              .upcc_applySpeed:
 493+ ED1E 3A E1 82         LD A, (SpeedBuffType)
 494+ ED21 FE 01            CP SPEED_BUFF_TYPE_RAYO
 495+ ED23 3E 45            LD A, SPEED_BUFF_RAYO_ATTR              ; $45 cyan bright
 496+ ED25 28 06            JR Z, .upcc_writeAttr
 497+ ED27 3E 44            LD A, SPEED_BUFF_CARACOL_ATTR           ; $44 green bright
 498+ ED29 18 02            JR .upcc_writeAttr
 499+ ED2B
 500+ ED2B              .upcc_applyMush:
 501+ ED2B 3E 43            LD A, MUSHROOM_LOCK_ATTR                ; $43 magenta bright
 502+ ED2D
 503+ ED2D              .upcc_writeAttr:
 504+ ED2D 32 A8 81         LD (EntityTable + ENT_ATTR), A
 505+ ED30 C9               RET
 506+ ED31
 507+ ED31              ; ==============================================================================
 508+ ED31              ; ApplyRayoBuff - speed boost 1.5x durante 15s (color via cycler)
 509+ ED31              ; ==============================================================================
 510+ ED31              ; "Last wins": llamar de nuevo resetea timer + override estado actual.
 511+ ED31              ; ==============================================================================
 512+ ED31              ApplyRayoBuff:
 513+ ED31 3E 06            LD A, SPEED_BUFF_RAYO_RUN
 514+ ED33 32 DD 82         LD (PlayerSpeedRun), A
 515+ ED36 3E 03            LD A, SPEED_BUFF_RAYO_FIGHT
 516+ ED38 32 DE 82         LD (PlayerSpeedFight), A
 517+ ED3B 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 518+ ED3E 22 DF 82         LD (SpeedBuffTimer), HL
 519+ ED41 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 520+ ED43 32 E1 82         LD (SpeedBuffType), A
 521+ ED46                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 522+ ED46 C9               RET
 523+ ED47
 524+ ED47              ; ==============================================================================
 525+ ED47              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 526+ ED47              ; ==============================================================================
 527+ ED47              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 528+ ED47              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 529+ ED47              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 530+ ED47              ; ==============================================================================
 531+ ED47              ApplyMushroomBuff:
 532+ ED47 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 533+ ED4A 22 E2 82         LD (MushroomLockTimer), HL
 534+ ED4D                  ; Antagonista 'last wins': SETA cancela ESPADA (ambos tocan can-attack).
 535+ ED4D 21 00 00         LD HL, 0
 536+ ED50 22 DA 5F         LD (EspadaTimer), HL
 537+ ED53                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 538+ ED53 C9               RET
 539+ ED54
 540+ ED54              ; ==============================================================================
 541+ ED54              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 542+ ED54              ; ==============================================================================
 543+ ED54              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 544+ ED54              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 545+ ED54              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 546+ ED54              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 547+ ED54              ; si no, restaura WHITE | $40.
 548+ ED54              ; ==============================================================================
 549+ ED54              UpdateMushroomBuffBody:
 550+ ED54 2A E2 82         LD HL, (MushroomLockTimer)
 551+ ED57 7C               LD A, H
 552+ ED58 B5               OR L
 553+ ED59 C8               RET Z                               ; sin debuff
 554+ ED5A 2B               DEC HL
 555+ ED5B 22 E2 82         LD (MushroomLockTimer), HL
 556+ ED5E C9               RET                                 ; (color lo pinta el cycler segun timer)
 557+ ED5F
 558+ ED5F              ; ==============================================================================
 559+ ED5F              ; ApplyEspadaBuff - ESPADA (no consume stamina + ataca a 0 + cancela cooldown)
 560+ ED5F              ; ==============================================================================
 561+ ED5F              ; Duracion: ESPADA_BUFF_FRAMES (12s). Player rojo bright (color via cycler).
 562+ ED5F              ; Antagonista 'last wins' con SETA — cancela MushroomLockTimer al activarse.
 563+ ED5F              ; Gates en logic_game.asm: SelectSwordMode fuerza mode 2, stamina drain skip,
 564+ ED5F              ; AttackCooldown set skip.
 565+ ED5F              ; ==============================================================================
 566+ ED5F              ApplyEspadaBuff:
 567+ ED5F 21 2C 01         LD HL, ESPADA_BUFF_FRAMES
 568+ ED62 22 DA 5F         LD (EspadaTimer), HL
 569+ ED65 21 00 00         LD HL, 0
 570+ ED68 22 E2 82         LD (MushroomLockTimer), HL          ; antagonista last wins
 571+ ED6B C9               RET
 572+ ED6C
 573+ ED6C              ; ==============================================================================
 574+ ED6C              ; UpdateEspadaBuffBody - tick 16-bit EspadaTimer
 575+ ED6C              ; ==============================================================================
 576+ ED6C              UpdateEspadaBuffBody:
 577+ ED6C 2A DA 5F         LD HL, (EspadaTimer)
 578+ ED6F 7C               LD A, H
 579+ ED70 B5               OR L
 580+ ED71 C8               RET Z
 581+ ED72 2B               DEC HL
 582+ ED73 22 DA 5F         LD (EspadaTimer), HL
 583+ ED76 C9               RET                                 ; (color via cycler, gates via logic_game)
 584+ ED77
 585+ ED77              ; ==============================================================================
 586+ ED77              ; ApplyEscudoBuff - ESCUDO (invuln nasti/monster, knockback persiste)
 587+ ED77              ; ==============================================================================
 588+ ED77              ; Duracion: ESCUDO_BUFF_FRAMES (15s). Player amarillo bright (color via cycler).
 589+ ED77              ; Gate en CheckPlayerEnemyCollision: skip HP decrement si EscudoTimer > 0.
 590+ ED77              ; ==============================================================================
 591+ ED77              ApplyEscudoBuff:
 592+ ED77 21 77 01         LD HL, ESCUDO_BUFF_FRAMES
 593+ ED7A 22 DC 5F         LD (EscudoTimer), HL
 594+ ED7D C9               RET
 595+ ED7E
 596+ ED7E              ; ==============================================================================
 597+ ED7E              ; UpdateEscudoBuffBody - tick 16-bit EscudoTimer
 598+ ED7E              ; ==============================================================================
 599+ ED7E              UpdateEscudoBuffBody:
 600+ ED7E 2A DC 5F         LD HL, (EscudoTimer)
 601+ ED81 7C               LD A, H
 602+ ED82 B5               OR L
 603+ ED83 C8               RET Z
 604+ ED84 2B               DEC HL
 605+ ED85 22 DC 5F         LD (EscudoTimer), HL
 606+ ED88 C9               RET
 607+ ED89
 608+ ED89              ; ==============================================================================
 609+ ED89              ; ApplyEscudoRayoBuff - combo ESCUDO + RAYO (atajo)
 610+ ED89              ; ==============================================================================
 611+ ED89              ; Es un solo pickup raro (categoria 'Especiales') que setea ambos timers a su
 612+ ED89              ; duracion completa. El cycler ve dos timers activos -> cycla CYAN + YELLOW.
 613+ ED89              ; ==============================================================================
 614+ ED89              ApplyEscudoRayoBuff:
 615+ ED89 21 77 01         LD HL, ESCUDO_BUFF_FRAMES
 616+ ED8C 22 DC 5F         LD (EscudoTimer), HL
 617+ ED8F C3 31 ED         JP ApplyRayoBuff                    ; tail call intra-body (set RAYO timer + type)
 618+ ED92
 619+ ED92              ; ==============================================================================
 620+ ED92              ; ApplyReverseBuff - REVERSE (controles Q<->A, O<->P invertidos durante 7s)
 621+ ED92              ; ==============================================================================
 622+ ED92              ; Player azul oscuro bright (color via cycler). Sin antagonistas — REVERSE
 623+ ED92              ; no comparte eje con ningun otro buff (toca solo input direction).
 624+ ED92              ; Gate en ReadInput de logic_game.asm: swap bits N<->S y E<->W si timer > 0.
 625+ ED92              ; ==============================================================================
 626+ ED92              ApplyReverseBuff:
 627+ ED92 21 AF 00         LD HL, REVERSE_BUFF_FRAMES
 628+ ED95 22 DE 5F         LD (ReverseTimer), HL
 629+ ED98 C9               RET
 630+ ED99
 631+ ED99              ; ==============================================================================
 632+ ED99              ; UpdateReverseBuffBody - tick 16-bit ReverseTimer
 633+ ED99              ; ==============================================================================
 634+ ED99              UpdateReverseBuffBody:
 635+ ED99 2A DE 5F         LD HL, (ReverseTimer)
 636+ ED9C 7C               LD A, H
 637+ ED9D B5               OR L
 638+ ED9E C8               RET Z
 639+ ED9F 2B               DEC HL
 640+ EDA0 22 DE 5F         LD (ReverseTimer), HL
 641+ EDA3 C9               RET                                 ; (color via cycler, gate via ReadInput)
 642+ EDA4
 643+ EDA4              ; ==============================================================================
 644+ EDA4              ; ApplyCaracolBuff - speed slow 0.5x durante 10s + player GREEN | $40
 645+ EDA4              ; ==============================================================================
 646+ EDA4              ApplyCaracolBuff:
 647+ EDA4 3E 02            LD A, SPEED_BUFF_CARACOL_RUN
 648+ EDA6 32 DD 82         LD (PlayerSpeedRun), A
 649+ EDA9 3E 01            LD A, SPEED_BUFF_CARACOL_FIGHT
 650+ EDAB 32 DE 82         LD (PlayerSpeedFight), A
 651+ EDAE 21 7D 00         LD HL, SPEED_BUFF_CARACOL_FRAMES
 652+ EDB1 22 DF 82         LD (SpeedBuffTimer), HL
 653+ EDB4 3E 02            LD A, SPEED_BUFF_TYPE_CARACOL
 654+ EDB6 32 E1 82         LD (SpeedBuffType), A
 655+ EDB9                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 656+ EDB9 C9               RET
 657+ EDBA
 658+ EDBA              ; ==============================================================================
 659+ EDBA              ; UpdateSpeedBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 660+ EDBA              ; ==============================================================================
 661+ EDBA              ; Llamado desde MainLoop tras DrawHealthStaminaHUD. Si SpeedBuffType=NONE,
 662+ EDBA              ; no-op rapido. Mientras buff activo: reescribe player ENT_ATTR cada frame
 663+ EDBA              ; (defensivo contra otros sistemas que puedan tocar el attr). Al expirar:
 664+ EDBA              ; restaura speeds default + ENT_ATTR a WHITE | $40 + type a NONE.
 665+ EDBA              ; ==============================================================================
 666+ EDBA              UpdateSpeedBuffBody:
 667+ EDBA 3A E1 82         LD A, (SpeedBuffType)
 668+ EDBD B7               OR A
 669+ EDBE C8               RET Z                               ; sin buff activo
 670+ EDBF                  ; Tick 16-bit timer.
 671+ EDBF 2A DF 82         LD HL, (SpeedBuffTimer)
 672+ EDC2 2B               DEC HL
 673+ EDC3 22 DF 82         LD (SpeedBuffTimer), HL
 674+ EDC6 7C               LD A, H
 675+ EDC7 B5               OR L
 676+ EDC8 C0               RET NZ                              ; buff aun activo (color via cycler)
 677+ EDC9                  ; Buff terminado: reset speeds + clear type. Color lo pinta el cycler.
 678+ EDC9 3E 04            LD A, SPEED_RUN
 679+ EDCB 32 DD 82         LD (PlayerSpeedRun), A
 680+ EDCE 3E 02            LD A, SPEED_FIGHT
 681+ EDD0 32 DE 82         LD (PlayerSpeedFight), A
 682+ EDD3 AF               XOR A
 683+ EDD4 32 E1 82         LD (SpeedBuffType), A
 684+ EDD7 C9               RET
 685+ EDD8
 686+ EDD8              ; ==============================================================================
 687+ EDD8              ; UpdateRandomPickup - room-enter hook
 688+ EDD8              ; ==============================================================================
 689+ EDD8              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
 690+ EDD8              ; Early-out si ScreenDirty=0 (no transition).
 691+ EDD8              ;
 692+ EDD8              ; En transition:
 693+ EDD8              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
 694+ EDD8              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
 695+ EDD8              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
 696+ EDD8              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
 697+ EDD8              ;      Si tipo == none o count == 0, marca inactiva ($FE).
 698+ EDD8              ;
 699+ EDD8              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
 700+ EDD8              ; fijos (id, charX, charY, v) terminados con id=$FF.
 701+ EDD8              ;
 702+ EDD8              ; Destruye AF, BC, DE, HL.
 703+ EDD8              ; ==============================================================================
 704+ EDD8              UpdateRandomPickupBody:
 705+ EDD8 3A 18 83         LD A, (ScreenDirty)
 706+ EDDB B7               OR A
 707+ EDDC C8               RET Z
 708+ EDDD
 709+ EDDD                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
 710+ EDDD 3E FE            LD A, $FE
 711+ EDDF 32 B4 5F         LD (RandomSynthMapX), A
 712+ EDE2 AF               XOR A
 713+ EDE3 32 BC 5F         LD (RouletteActive), A          ; reset roulette state en cada transicion
 714+ EDE6
 715+ EDE6                  ; --- Scan BG stream, build SlotList ---
 716+ EDE6 AF               XOR A
 717+ EDE7 32 AB 5F         LD (RandomSlotCount), A
 718+ EDEA 2A 12 83         LD HL, (CurrentScreenAddr)
 719+ EDED              .urpScanLoop:
 720+ EDED 7E               LD A, (HL)                          ; A = id
 721+ EDEE FE FF            CP $FF
 722+ EDF0 28 2A            JR Z, .urpScanDone
 723+ EDF2 FE D2            CP RANDOM_SLOT_MARKER
 724+ EDF4 20 20            JR NZ, .urpSkipEntry
 725+ EDF6                  ; Es marker. Cap reached?
 726+ EDF6 3A AB 5F         LD A, (RandomSlotCount)
 727+ EDF9 FE 04            CP RANDOM_SLOT_MAX
 728+ EDFB 30 19            JR NC, .urpSkipEntry
 729+ EDFD                  ; SlotList[count*2] = charX, [count*2+1] = charY
 730+ EDFD 23               INC HL                              ; HL @ charX
 731+ EDFE 46               LD B, (HL)                          ; B = charX
 732+ EDFF 23               INC HL                              ; HL @ charY
 733+ EE00 4E               LD C, (HL)                          ; C = charY
 734+ EE01 E5               PUSH HL                             ; save HL @ charY
 735+ EE02 87               ADD A, A                            ; A = count*2
 736+ EE03 6F               LD L, A
 737+ EE04 26 00            LD H, 0
 738+ EE06 11 AC 5F         LD DE, RandomSlotList
 739+ EE09 19               ADD HL, DE
 740+ EE0A 70               LD (HL), B                          ; charX
 741+ EE0B 23               INC HL
 742+ EE0C 71               LD (HL), C                          ; charY
 743+ EE0D 21 AB 5F         LD HL, RandomSlotCount
 744+ EE10 34               INC (HL)
 745+ EE11 E1               POP HL                              ; HL @ charY
 746+ EE12 23               INC HL                              ; HL @ v
 747+ EE13 23               INC HL                              ; HL @ next id
 748+ EE14 18 D7            JR .urpScanLoop
 749+ EE16              .urpSkipEntry:
 750+ EE16                  ; Skip entry: 4 bytes (id, charX, charY, v).
 751+ EE16 23               INC HL
 751+ EE17 23             INC HL
 751+ EE18 23             INC HL
 751+ EE19 23             INC HL
 752+ EE1A 18 D1            JR .urpScanLoop
 753+ EE1C              .urpScanDone:
 754+ EE1C
 755+ EE1C                  ; --- count == 0 -> rotar cache (rolled=NONE) y RET ---
 756+ EE1C 3A AB 5F         LD A, (RandomSlotCount)
 757+ EE1F B7               OR A
 758+ EE20 CA C9 EF         JP Z, .urpZeroAndRotate
 759+ EE23
 760+ EE23                  ; --- Cache lookup: ¿newSid coincide con prev? ---
 761+ EE23                  ; Calcular newSid y comparar contra RP_PrevSid. Hit = volviendo a la sala
 762+ EE23                  ; inmediatamente anterior; restauramos slot+tipo. Miss = roll fresco.
 763+ EE23 3A 11 83         LD A, (CurrentScreenY)
 764+ EE26 07               RLCA
 764+ EE27 07             RLCA
 764+ EE28 07             RLCA
 764+ EE29 07             RLCA           ; Y*16
 765+ EE2A 21 10 83         LD HL, CurrentScreenX
 766+ EE2D 86               ADD A, (HL)                         ; A = newSid
 767+ EE2E 47               LD B, A                             ; B = newSid (preservar)
 768+ EE2F 3A D1 5F         LD A, (RP_PrevSid)
 769+ EE32 B8               CP B
 770+ EE33 20 1A            JR NZ, .urpCacheMiss
 771+ EE35                  ; HIT prev. Validar slot < count.
 772+ EE35 3A D2 5F         LD A, (RP_PrevSlot)
 773+ EE38 4F               LD C, A                             ; C = cached slot
 774+ EE39 3A AB 5F         LD A, (RandomSlotCount)
 775+ EE3C B9               CP C
 776+ EE3D 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 777+ EE3F 38 0E            JR C, .urpCacheMiss
 778+ EE41                  ; Restaurar: usar cached slot + cached rolled.
 779+ EE41 79               LD A, C
 780+ EE42 32 D4 5F         LD (RP_TmpSlot), A
 781+ EE45 3A D3 5F         LD A, (RP_PrevRolled)
 782+ EE48 32 D5 5F         LD (RP_TmpRolled), A
 783+ EE4B 79               LD A, C                             ; A = slot
 784+ EE4C C3 B2 EE         JP .urpReadSlotAndDispatchCache
 785+ EE4F
 786+ EE4F              .urpCacheMiss:
 787+ EE4F 3A AB 5F         LD A, (RandomSlotCount)
 788+ EE52                  ; --- Pick slot via R mod count ---
 789+ EE52 47               LD B, A                             ; B = count
 790+ EE53 ED 5F            LD A, R
 791+ EE55              .urpModLoop:
 792+ EE55 90               SUB B
 793+ EE56 30 FD            JR NC, .urpModLoop
 794+ EE58 80               ADD A, B                            ; A = R mod count, [0..count-1]
 795+ EE59 32 D4 5F         LD (RP_TmpSlot), A                  ; guardar slot para rotación
 796+ EE5C
 797+ EE5C                  ; --- Read SlotList[A*2] = (charX, charY) ---
 798+ EE5C 87               ADD A, A
 799+ EE5D 5F               LD E, A
 800+ EE5E 16 00            LD D, 0
 801+ EE60 21 AC 5F         LD HL, RandomSlotList
 802+ EE63 19               ADD HL, DE
 803+ EE64 7E               LD A, (HL)                          ; charX
 804+ EE65 32 B8 5F         LD (RandomSynthCharX), A
 805+ EE68 23               INC HL
 806+ EE69 7E               LD A, (HL)                          ; charY
 807+ EE6A 32 B9 5F         LD (RandomSynthCharY), A
 808+ EE6D
 809+ EE6D                  ; --- Roll type usando R XOR SYS_FRAMES ---
 810+ EE6D                  IF DEBUG_FORCE_COMPASS
 811+ EE6D ~                    ; DEBUG: bypass del roll - siempre compass para test rápido del power-up.
 812+ EE6D ~                    ; Pone DEBUG_FORCE_COMPASS=0 en constants.asm para volver a distribución normal.
 813+ EE6D ~                    JP .urpDoCompass
 814+ EE6D                  ENDIF
 815+ EE6D                  IF DEBUG_FORCE_MUSHROOM
 816+ EE6D ~                    ; DEBUG: bypass del roll - siempre mushroom para probar el debuff.
 817+ EE6D ~                    JP .urpDoMushroom
 818+ EE6D                  ENDIF
 819+ EE6D                  IF DEBUG_FORCE_ROULETTE
 820+ EE6D ~                    ; DEBUG: bypass del roll - siempre roulette para probar RouletteOrder.
 821+ EE6D ~                    JP .urpDoRoulette
 822+ EE6D                  ENDIF
 823+ EE6D                  IF DEBUG_FORCE_COLOR_CHANGER
 824+ EE6D ~                    ; DEBUG: rotar entre RAYO/CARACOL/MUSHROOM al 33% para testar el color
 825+ EE6D ~                    ; cycler. R XOR SYS_FRAMES da pseudo-random uniform 0..255, partido en
 826+ EE6D ~                    ; 3 bandas de 85.3 c/u.
 827+ EE6D ~                    LD A, R
 828+ EE6D ~                    LD HL, $5C78
 829+ EE6D ~                    XOR (HL)
 830+ EE6D ~                    CP 85
 831+ EE6D ~                    JP C, .urpDoRayo
 832+ EE6D ~                    CP 170
 833+ EE6D ~                    JP C, .urpDoCaracol
 834+ EE6D ~                    JP .urpDoMushroom
 835+ EE6D                  ENDIF
 836+ EE6D                  IF DEBUG_FORCE_NEW_BUFFS
 837+ EE6D ~                    ; DEBUG: rotar entre ESPADA/ESCUDO/ESCUDO_RAYO al 33% para testar
 838+ EE6D ~                    ; fase 3 (buffs nuevos).
 839+ EE6D ~                    LD A, R
 840+ EE6D ~                    LD HL, $5C78
 841+ EE6D ~                    XOR (HL)
 842+ EE6D ~                    CP 85
 843+ EE6D ~                    JP C, .urpDoEspada
 844+ EE6D ~                    CP 170
 845+ EE6D ~                    JP C, .urpDoEscudo
 846+ EE6D ~                    JP .urpDoEscudoRayo
 847+ EE6D                  ENDIF
 848+ EE6D                  IF DEBUG_FORCE_REVERSE
 849+ EE6D ~                    ; DEBUG: forzar siempre REVERSE para testar fase 4.
 850+ EE6D ~                    JP .urpDoReverse
 851+ EE6D                  ENDIF
 852+ EE6D ED 5F            LD A, R
 853+ EE6F 21 78 5C         LD HL, $5C78
 854+ EE72 AE               XOR (HL)
 855+ EE73                  ; Bands cumulativos. Orden de chequeo en codigo NO afecta las
 856+ EE73                  ; probabilidades — solo importa los valores de PROB_*_END. Aqui van
 857+ EE73                  ; agrupados por categoria (Recursos, Especiales, Buffs, Debuffs, Meta).
 858+ EE73                  ; JP C (no JR C) por rango con cache hit dispatch.
 859+ EE73                  ; --- Recursos ---
 860+ EE73 FE 14            CP PROB_HEALTH_END
 860+ EE75 DA 1D EF       JP C, .urpDoHealth
 861+ EE78 FE 28            CP PROB_STAMINA_END
 861+ EE7A DA 2B EF       JP C, .urpDoStamina
 862+ EE7D                  ; --- Especiales ---
 863+ EE7D FE 2A            CP PROB_LIFE_END
 863+ EE7F DA 12 EF       JP C, .urpDoLife
 864+ EE82 FE 2E            CP PROB_COMPASS_END
 864+ EE84 DA 5A EF       JP C, .urpDoCompass
 865+ EE87 FE 33            CP PROB_ESCUDORAYO_END
 865+ EE89 DA 7B EF       JP C, .urpDoEscudoRayo
 866+ EE8C                  ; --- Buffs ---
 867+ EE8C FE 3C            CP PROB_RAYO_END
 867+ EE8E DA 39 EF       JP C, .urpDoRayo
 868+ EE91 FE 44            CP PROB_ESPADA_END
 868+ EE93 DA 65 EF       JP C, .urpDoEspada
 869+ EE96 FE 4C            CP PROB_ESCUDO_END
 869+ EE98 DA 70 EF       JP C, .urpDoEscudo
 870+ EE9B                  ; --- Debuffs ---
 871+ EE9B FE 58            CP PROB_MUSHROOM_END
 871+ EE9D DA 4F EF       JP C, .urpDoMushroom
 872+ EEA0 FE 64            CP PROB_CARACOL_END
 872+ EEA2 DA 44 EF       JP C, .urpDoCaracol
 873+ EEA5 FE 70            CP PROB_REVERSE_END
 873+ EEA7 DA 86 EF       JP C, .urpDoReverse
 874+ EEAA                  ; --- Meta ---
 875+ EEAA FE 84            CP PROB_ROULETTE_END
 875+ EEAC DA 91 EF       JP C, .urpDoRoulette
 876+ EEAF C3 C9 EF         JP .urpZeroAndRotate                ; tipo nada, RandomSynthMapX ya esta a $FE
 877+ EEB2
 878+ EEB2              ; ==============================================================================
 879+ EEB2              ; .urpReadSlotAndDispatchCache — path del cache HIT
 880+ EEB2              ; ==============================================================================
 881+ EEB2              ; Entrada: A = slot cached, RP_TmpRolled = tipo cached (ya setado).
 882+ EEB2              ; Lee SlotList[A*2] → CharX/Y, luego dispatcha al .urpDoXxx correspondiente.
 883+ EEB2              ; ROLLED_NONE → JP .urpZeroAndRotate (no spawn pero rota cache).
 884+ EEB2              ; ==============================================================================
 885+ EEB2              .urpReadSlotAndDispatchCache:
 886+ EEB2 87               ADD A, A
 887+ EEB3 5F               LD E, A
 888+ EEB4 16 00            LD D, 0
 889+ EEB6 21 AC 5F         LD HL, RandomSlotList
 890+ EEB9 19               ADD HL, DE
 891+ EEBA 7E               LD A, (HL)
 892+ EEBB 32 B8 5F         LD (RandomSynthCharX), A
 893+ EEBE 23               INC HL
 894+ EEBF 7E               LD A, (HL)
 895+ EEC0 32 B9 5F         LD (RandomSynthCharY), A
 896+ EEC3
 897+ EEC3 3A D5 5F         LD A, (RP_TmpRolled)
 898+ EEC6 B7               OR A
 899+ EEC7 CA C9 EF         JP Z, .urpZeroAndRotate             ; ROLLED_NONE (consumido) → no spawn
 900+ EECA 3D               DEC A
 901+ EECB CA 12 EF         JP Z, .urpDoLife                    ; ROLLED_LIFE
 902+ EECE 3D               DEC A
 903+ EECF 28 26            JR Z, .urpDoHealthFromCache         ; ROLLED_HEALTH: reusa variant cacheada
 904+ EED1 3D               DEC A
 905+ EED2 28 2A            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 906+ EED4 3D               DEC A
 907+ EED5 CA 39 EF         JP Z, .urpDoRayo
 908+ EED8 3D               DEC A
 909+ EED9 CA 44 EF         JP Z, .urpDoCaracol
 910+ EEDC 3D               DEC A
 911+ EEDD CA 91 EF         JP Z, .urpDoRoulette
 912+ EEE0 3D               DEC A
 913+ EEE1 CA 4F EF         JP Z, .urpDoMushroom
 914+ EEE4 3D               DEC A
 915+ EEE5 CA 5A EF         JP Z, .urpDoCompass                 ; ROLLED_COMPASS
 916+ EEE8 3D               DEC A
 917+ EEE9 CA 65 EF         JP Z, .urpDoEspada                  ; ROLLED_ESPADA
 918+ EEEC 3D               DEC A
 919+ EEED CA 70 EF         JP Z, .urpDoEscudo                  ; ROLLED_ESCUDO
 920+ EEF0 3D               DEC A
 921+ EEF1 CA 7B EF         JP Z, .urpDoEscudoRayo              ; ROLLED_ESCUDO_RAYO
 922+ EEF4 C3 86 EF         JP .urpDoReverse                    ; ROLLED_REVERSE (resto)
 923+ EEF7
 924+ EEF7              ; ==============================================================================
 925+ EEF7              ; .urpDoHealthFromCache / .urpDoStaminaFromCache - cache hit path
 926+ EEF7              ; ==============================================================================
 927+ EEF7              ; Llamadas solo desde .urpReadSlotAndDispatchCache. Restauran la variante exacta
 928+ EEF7              ; que el player vio la última vez en esta sala (vía RP_PrevVariant) en lugar de
 929+ EEF7              ; re-rollear con PickRandomVariantPtr. El usuario ve consistencia visual.
 930+ EEF7              ;
 931+ EEF7              ; Comparten .urpDoVariantFromCache: HL ya cargado con la tabla, A con ROLLED_*.
 932+ EEF7              ; ==============================================================================
 933+ EEF7              .urpDoHealthFromCache:
 934+ EEF7 3E 02            LD A, ROLLED_HEALTH
 935+ EEF9 21 D4 F1         LD HL, HealthVariantPtrs
 936+ EEFC 18 05            JR .urpDoVariantFromCache
 937+ EEFE              .urpDoStaminaFromCache:
 938+ EEFE 3E 03            LD A, ROLLED_STAMINA
 939+ EF00 21 DF F1         LD HL, StaminaVariantPtrs
 940+ EF03              .urpDoVariantFromCache:
 941+ EF03 32 D5 5F         LD (RP_TmpRolled), A
 942+ EF06 3A D7 5F         LD A, (RP_PrevVariant)
 943+ EF09 32 D8 5F         LD (RP_TmpVariant), A               ; restore: la próxima rotación lo lleva a Cur
 944+ EF0C CD F3 F1         CALL LookupVariantPtrByIdx          ; HL = tabla, A = idx → HL = sprite ptr
 945+ EF0F C3 B3 EF         JP .urpActivate
 946+ EF12
 947+ EF12              .urpDoLife:
 948+ EF12 3E 01            LD A, ROLLED_LIFE
 949+ EF14 32 D5 5F         LD (RP_TmpRolled), A
 950+ EF17 21 A5 CC         LD HL, BgGfx_life
 951+ EF1A C3 B3 EF         JP .urpActivate
 952+ EF1D              .urpDoHealth:
 953+ EF1D 3E 02            LD A, ROLLED_HEALTH
 954+ EF1F 32 D5 5F         LD (RP_TmpRolled), A
 955+ EF22 21 D4 F1         LD HL, HealthVariantPtrs             ; variantes 72/74/75/254
 956+ EF25 CD E8 F1         CALL PickRandomVariantPtr             ; OUT: HL = sprite ptr (raw)
 957+ EF28 C3 B3 EF         JP .urpActivate
 958+ EF2B              .urpDoStamina:
 959+ EF2B 3E 03            LD A, ROLLED_STAMINA
 960+ EF2D 32 D5 5F         LD (RP_TmpRolled), A
 961+ EF30 21 DF F1         LD HL, StaminaVariantPtrs            ; variantes 73/255
 962+ EF33 CD E8 F1         CALL PickRandomVariantPtr
 963+ EF36 C3 B3 EF         JP .urpActivate
 964+ EF39              .urpDoRayo:
 965+ EF39 3E 04            LD A, ROLLED_RAYO
 966+ EF3B 32 D5 5F         LD (RP_TmpRolled), A
 967+ EF3E 21 DB E7         LD HL, BgGfx_pickup_ray
 968+ EF41 C3 B3 EF         JP .urpActivate
 969+ EF44              .urpDoCaracol:
