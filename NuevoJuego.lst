  91  BE00                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ BE00              ; ==============================================================================
   2+ BE00              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ BE00              ; ==============================================================================
   4+ BE00              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ BE00              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ BE00              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ BE00              ; ==============================================================================
   8+ BE00
   9+ BE00              ; --- Constantes ---
  10+ BE00              NUM_TIME_MOMENTS    EQU 7
  11+ BE00
  12+ BE00              ; --- Variables ---
  13+ BE00 00           CurrentTimeOfDay:       DEFB 0      ; Momento actual (0-6)
  14+ BE01 7A C0        CurrentRemapTable:      DEFW RemapTable_Day
  15+ BE03 7A C0        CurrentHouseRemapTable: DEFW RemapTable_Day
  16+ BE05 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ BE06 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ BE07
  19+ BE07              ; ==============================================================================
  20+ BE07              ; SetTimeOfDay - Cambia el momento del dia
  21+ BE07              ; ==============================================================================
  22+ BE07              ; Entrada: A = momento (0-6)
  23+ BE07              ; ==============================================================================
  24+ BE07              SetTimeOfDay:
  25+ BE07 32 00 BE         LD (CurrentTimeOfDay), A
  26+ BE0A
  27+ BE0A                  ; Buscar puntero tabla standard
  28+ BE0A 21 5E C0         LD HL, RemapTablePtrs
  29+ BE0D 5F               LD E, A
  30+ BE0E 16 00            LD D, 0
  31+ BE10 19               ADD HL, DE
  32+ BE11 19               ADD HL, DE              ; HL = RemapTablePtrs + momento*2
  33+ BE12 5E               LD E, (HL)
  34+ BE13 23               INC HL
  35+ BE14 56               LD D, (HL)
  36+ BE15 ED 53 01 BE      LD (CurrentRemapTable), DE
  37+ BE19
  38+ BE19                  ; Buscar puntero tabla house
  39+ BE19 3A 00 BE         LD A, (CurrentTimeOfDay)
  40+ BE1C 21 6C C0         LD HL, RemapHouseTablePtrs
  41+ BE1F 5F               LD E, A
  42+ BE20 16 00            LD D, 0
  43+ BE22 19               ADD HL, DE
  44+ BE23 19               ADD HL, DE
  45+ BE24 5E               LD E, (HL)
  46+ BE25 23               INC HL
  47+ BE26 56               LD D, (HL)
  48+ BE27 ED 53 03 BE      LD (CurrentHouseRemapTable), DE
  49+ BE2B
  50+ BE2B                  ; Forzar redibujado de pantalla
  51+ BE2B 3E 01            LD A, 1
  52+ BE2D 32 81 81         LD (ScreenDirty), A
  53+ BE30 C9               RET
  54+ BE31
  55+ BE31              ; ==============================================================================
  56+ BE31              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
  57+ BE31              ; ==============================================================================
  58+ BE31              CheckDebugKeys:
  59+ BE31 3E FB            LD A, $FB
  60+ BE33 DB FE            IN A, ($FE)
  61+ BE35 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
  62+ BE37 20 1C            JR NZ, .notPressed
  63+ BE39
  64+ BE39                  ; Tecla pulsada: comprobar debounce
  65+ BE39 3A 06 BE         LD A, (DebugKeyDebounce)
  66+ BE3C B7               OR A
  67+ BE3D C0               RET NZ                  ; Ya estaba pulsada, ignorar
  68+ BE3E
  69+ BE3E                  ; Primera pulsacion: ciclar
  70+ BE3E 3E 01            LD A, 1
  71+ BE40 32 06 BE         LD (DebugKeyDebounce), A
  72+ BE43
  73+ BE43 3A 00 BE         LD A, (CurrentTimeOfDay)
  74+ BE46 3C               INC A
  75+ BE47 FE 07            CP NUM_TIME_MOMENTS
  76+ BE49 38 01            JR C, .noWrap
  77+ BE4B AF               XOR A                   ; Volver a 0 (Dia)
  78+ BE4C              .noWrap:
  79+ BE4C F5               PUSH AF
  80+ BE4D CD 07 BE         CALL SetTimeOfDay
  81+ BE50 F1               POP AF
  82+ BE51 CD 50 C3         CALL SetClockToPhaseHour
  83+ BE54 C9               RET
  84+ BE55
  85+ BE55              .notPressed:
  86+ BE55 AF               XOR A
  87+ BE56 32 06 BE         LD (DebugKeyDebounce), A
  88+ BE59 C9               RET
  89+ BE5A
  90+ BE5A              ; ==============================================================================
  91+ BE5A              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
  92+ BE5A              ; ==============================================================================
  93+ BE5A              ; Entrada: A = attr original
  94+ BE5A              ; Salida:  A = attr transformado
  95+ BE5A              ; Preserva: HL, DE, BC, IX
  96+ BE5A              ; ==============================================================================
  97+ BE5A              ApplyDayCycleRemap:
  98+ BE5A E5               PUSH HL
  99+ BE5B 67               LD H, A                     ; H = attr (temp save)
 100+ BE5C 3A 00 BE         LD A, (CurrentTimeOfDay)
 101+ BE5F B7               OR A
 102+ BE60 20 03            JR NZ, .doRemap
 103+ BE62 7C               LD A, H                     ; Dia: devolver sin cambio
 104+ BE63 E1               POP HL
 105+ BE64 C9               RET
 106+ BE65
 107+ BE65              .doRemap:
 108+ BE65 D5               PUSH DE
 109+ BE66 C5               PUSH BC
 110+ BE67
 111+ BE67 7C               LD A, H                     ; A = attr original
 112+ BE68 4F               LD C, A                     ; C = attr original
 113+ BE69
 114+ BE69                  ; Guardar flash + ink (bits 7, 2-0)
 115+ BE69 E6 87            AND $87                     ; A = F000_0III
 116+ BE6B 47               LD B, A                     ; B = flash | ink
 117+ BE6C
 118+ BE6C                  ; Extraer paper+bright como indice 0-15
 119+ BE6C 79               LD A, C
 120+ BE6D E6 78            AND $78                     ; A = 0BPPP000
 121+ BE6F 0F               RRCA
 122+ BE70 0F               RRCA
 123+ BE71 0F               RRCA                        ; A = 0000BPPP = indice
 124+ BE72
 125+ BE72                  ; Elegir tabla segun tipo de sprite
 126+ BE72 5F               LD E, A
 127+ BE73 16 00            LD D, 0
 128+ BE75 3A 05 BE         LD A, (BgSpriteIsHouse)
 129+ BE78 B7               OR A
 130+ BE79 28 05            JR Z, .useStdTable
 131+ BE7B 2A 03 BE         LD HL, (CurrentHouseRemapTable)
 132+ BE7E 18 03            JR .doLookup
 133+ BE80              .useStdTable:
 134+ BE80 2A 01 BE         LD HL, (CurrentRemapTable)
 135+ BE83              .doLookup:
 136+ BE83 19               ADD HL, DE
 137+ BE84 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 138+ BE85
 139+ BE85                  ; Reconstruir atributo
 140+ BE85 07               RLCA
 141+ BE86 07               RLCA
 142+ BE87 07               RLCA                        ; A = 0BPPP000
 143+ BE88 B0               OR B                        ; A = FBPPPIII
 144+ BE89
 145+ BE89 C1               POP BC
 146+ BE8A D1               POP DE
 147+ BE8B E1               POP HL
 148+ BE8C C9               RET
 149+ BE8D
 150+ BE8D              ; ==============================================================================
 151+ BE8D              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 152+ BE8D              ; ==============================================================================
 153+ BE8D              ; Entrada: DE = direccion datos del sprite
 154+ BE8D              ; Setea BgSpriteIsHouse (0 o 1)
 155+ BE8D              ; Preserva: DE, IX
 156+ BE8D              ; ==============================================================================
 157+ BE8D              CheckIfHouseSprite:
 158+ BE8D E5               PUSH HL
 159+ BE8E C5               PUSH BC
 160+ BE8F
 161+ BE8F AF               XOR A
 162+ BE90 32 05 BE         LD (BgSpriteIsHouse), A     ; Default: no es house
 163+ BE93
 164+ BE93 21 C0 A3         LD HL, HouseSpriteList
 165+ BE96              .checkLoop:
 166+ BE96 4E               LD C, (HL)
 167+ BE97 23               INC HL
 168+ BE98 46               LD B, (HL)
 169+ BE99 23               INC HL                      ; BC = direccion sprite house
 170+ BE9A 78               LD A, B
 171+ BE9B B1               OR C
 172+ BE9C 28 0D            JR Z, .checkDone            ; Terminador: no encontrado
 173+ BE9E
 174+ BE9E 78               LD A, B
 175+ BE9F BA               CP D
 176+ BEA0 20 F4            JR NZ, .checkLoop
 177+ BEA2 79               LD A, C
 178+ BEA3 BB               CP E
 179+ BEA4 20 F0            JR NZ, .checkLoop
 180+ BEA6
 181+ BEA6                  ; Encontrado: es house
 182+ BEA6 3E 01            LD A, 1
 183+ BEA8 32 05 BE         LD (BgSpriteIsHouse), A
 184+ BEAB
 185+ BEAB              .checkDone:
 186+ BEAB C1               POP BC
 187+ BEAC E1               POP HL
 188+ BEAD C9               RET
 189+ BEAE
 190+ BEAE              ; ==============================================================================
 191+ BEAE              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 192+ BEAE              ; ==============================================================================
 193+ BEAE              ; Formato: XX,YY:NN nombre_room     DY
 194+ BEAE              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 195+ BEAE              ; ==============================================================================
 196+ BEAE              DrawRoomInfo:
 197+ BEAE                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 198+ BEAE 1E 00            LD E, 0
 199+ BEB0 06 0D            LD B, 13
 200+ BEB2              .clearLoop:
 201+ BEB2 C5               PUSH BC
 202+ BEB3 D5               PUSH DE
 203+ BEB4 3E 20            LD A, ' '
 204+ BEB6 CD 6C BF         CALL DrawHudChar
 205+ BEB9 D1               POP DE
 206+ BEBA C1               POP BC
 207+ BEBB 1C               INC E
 208+ BEBC 10 F4            DJNZ .clearLoop
 209+ BEBE
 210+ BEBE                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 211+ BEBE 3A 7C 81         LD A, (CurrentScreenX)
 212+ BEC1 1E 00            LD E, 0
 213+ BEC3 CD 21 BF         CALL .drawDec2
 214+ BEC6
 215+ BEC6                  ; --- ',' en col 2 ---
 216+ BEC6 3E 2C            LD A, ','
 217+ BEC8 1E 02            LD E, 2
 218+ BECA CD 6C BF         CALL DrawHudChar
 219+ BECD
 220+ BECD                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 221+ BECD 3A 7D 81         LD A, (CurrentScreenY)
 222+ BED0 1E 03            LD E, 3
 223+ BED2 CD 21 BF         CALL .drawDec2
 224+ BED5
 225+ BED5                  ; --- ':' en col 5 ---
 226+ BED5 3E 3A            LD A, ':'
 227+ BED7 1E 05            LD E, 5
 228+ BED9 CD 6C BF         CALL DrawHudChar
 229+ BEDC
 230+ BEDC                  ; --- Obtener room index de MapTable[Y*16+X] ---
 231+ BEDC 3A 7D 81         LD A, (CurrentScreenY)
 232+ BEDF 6F               LD L, A
 233+ BEE0 26 00            LD H, 0
 234+ BEE2 29               ADD HL, HL
 235+ BEE3 29               ADD HL, HL
 236+ BEE4 29               ADD HL, HL
 237+ BEE5 29               ADD HL, HL                  ; HL = Y * 16
 238+ BEE6 3A 7C 81         LD A, (CurrentScreenX)
 239+ BEE9 5F               LD E, A
 240+ BEEA 16 00            LD D, 0
 241+ BEEC 19               ADD HL, DE                  ; HL = Y*16 + X
 242+ BEED 11 D6 95         LD DE, MapTable
 243+ BEF0 19               ADD HL, DE
 244+ BEF1 7E               LD A, (HL)                  ; A = room index (0-47)
 245+ BEF2 F5               PUSH AF                     ; guardar room index
 246+ BEF3
 247+ BEF3                  ; --- Room index como 2 hex en cols 6-7 ---
 248+ BEF3 F5               PUSH AF
 249+ BEF4 0F               RRCA
 250+ BEF5 0F               RRCA
 251+ BEF6 0F               RRCA
 252+ BEF7 0F               RRCA
 253+ BEF8 E6 0F            AND $0F
 254+ BEFA CD 3F BF         CALL .hexToAscii
 255+ BEFD 1E 06            LD E, 6
 256+ BEFF CD 6C BF         CALL DrawHudChar
 257+ BF02 F1               POP AF
 258+ BF03 E6 0F            AND $0F
 259+ BF05 CD 3F BF         CALL .hexToAscii
 260+ BF08 1E 07            LD E, 7
 261+ BF0A CD 6C BF         CALL DrawHudChar
 262+ BF0D
 263+ BF0D                  ; --- Espacio en col 8 ---
 264+ BF0D 3E 20            LD A, ' '
 265+ BF0F 1E 08            LD E, 8
 266+ BF11 CD 6C BF         CALL DrawHudChar
 267+ BF14
 268+ BF14                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 269+ BF14 F1               POP AF                      ; A = room index (descartar)
 270+ BF15
 271+ BF15                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 272+ BF15 21 20 58         LD HL, ATTR_BASE + 1 * 32
 273+ BF18 3E 47            LD A, $47                   ; bright white on black
 274+ BF1A 06 0D            LD B, 13
 275+ BF1C              .attrLoop:
 276+ BF1C 77               LD (HL), A
 277+ BF1D 23               INC HL
 278+ BF1E 10 FC            DJNZ .attrLoop
 279+ BF20 C9               RET
 280+ BF21
 281+ BF21              ; --- Helpers ---
 282+ BF21              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 283+ BF21              .drawDec2:
 284+ BF21 4B               LD C, E                     ; guardar columna inicial
 285+ BF22 06 00            LD B, 0                     ; decenas
 286+ BF24              .divLoop:
 287+ BF24 FE 0A            CP 10
 288+ BF26 38 05            JR C, .divDone
 289+ BF28 D6 0A            SUB 10
 290+ BF2A 04               INC B
 291+ BF2B 18 F7            JR .divLoop
 292+ BF2D              .divDone:
 293+ BF2D                  ; B = decenas, A = unidades
 294+ BF2D F5               PUSH AF                     ; guardar unidades
 295+ BF2E 78               LD A, B
 296+ BF2F C6 30            ADD A, '0'
 297+ BF31 59               LD E, C
 298+ BF32 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 299+ BF33 CD 6C BF         CALL DrawHudChar
 300+ BF36 C1               POP BC                      ; restaurar C
 301+ BF37 F1               POP AF
 302+ BF38 C6 30            ADD A, '0'
 303+ BF3A 59               LD E, C
 304+ BF3B 1C               INC E
 305+ BF3C C3 6C BF         JP DrawHudChar              ; tail call
 306+ BF3F
 307+ BF3F              .hexToAscii:
 308+ BF3F FE 0A            CP 10
 309+ BF41 38 03            JR C, .isDigit
 310+ BF43 C6 37            ADD A, 'A' - 10
 311+ BF45 C9               RET
 312+ BF46              .isDigit:
 313+ BF46 C6 30            ADD A, '0'
 314+ BF48 C9               RET
 315+ BF49
 316+ BF49              ; ==============================================================================
 317+ BF49              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 23, col 30-31)
 318+ BF49              ; ==============================================================================
 319+ BF49              DrawTimeIndicator:
 320+ BF49                  ; Calcular puntero al label de 2 chars
 321+ BF49 3A 00 BE         LD A, (CurrentTimeOfDay)
 322+ BF4C 87               ADD A, A                    ; A = momento * 2
 323+ BF4D 5F               LD E, A
 324+ BF4E 16 00            LD D, 0
 325+ BF50 21 50 C0         LD HL, TimeLabels
 326+ BF53 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 327+ BF54
 328+ BF54                  ; Primer caracter en columna 30
 329+ BF54 7E               LD A, (HL)
 330+ BF55 E5               PUSH HL
 331+ BF56 1E 1E            LD E, 30
 332+ BF58 CD 6C BF         CALL DrawHudChar
 333+ BF5B E1               POP HL
 334+ BF5C
 335+ BF5C                  ; Segundo caracter en columna 31
 336+ BF5C 23               INC HL
 337+ BF5D 7E               LD A, (HL)
 338+ BF5E 1E 1F            LD E, 31
 339+ BF60 CD 6C BF         CALL DrawHudChar
 340+ BF63
 341+ BF63                  ; Atributos del indicador (bright white on black)
 342+ BF63 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 343+ BF66 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 344+ BF68 77               LD (HL), A
 345+ BF69 23               INC HL
 346+ BF6A 77               LD (HL), A
 347+ BF6B C9               RET
 348+ BF6C
 349+ BF6C              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 350+ BF6C              ; A = codigo ASCII, E = columna (0-31)
 351+ BF6C              DrawHudChar:
 352+ BF6C                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 353+ BF6C 6F               LD L, A
 354+ BF6D 26 00            LD H, 0
 355+ BF6F 29               ADD HL, HL
 356+ BF70 29               ADD HL, HL
 357+ BF71 29               ADD HL, HL
 358+ BF72 01 00 3C         LD BC, $3C00
 359+ BF75 09               ADD HL, BC                  ; HL = font data
 360+ BF76
 361+ BF76                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 362+ BF76 16 40            LD D, $40                   ; Tercio 0, scan line 0
 363+ BF78 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 364+ BF7A 83               ADD A, E
 365+ BF7B 5F               LD E, A                     ; DE = dir VRAM
 366+ BF7C
 367+ BF7C 06 08            LD B, 8
 368+ BF7E              .hudCharLoop:
 369+ BF7E 7E               LD A, (HL)
 370+ BF7F 12               LD (DE), A
 371+ BF80 23               INC HL
 372+ BF81 14               INC D                       ; Siguiente scan line
 373+ BF82 10 FA            DJNZ .hudCharLoop
 374+ BF84 C9               RET
