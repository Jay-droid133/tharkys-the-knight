 378+ 8F62
 379+ 8F62 3A 8D 8F         LD A, (EntityAttrH)
 380+ 8F65 4F               LD C, A
 381+ 8F66              .restRow:
 382+ 8F66 3A 8C 8F         LD A, (EntityAttrW)
 383+ 8F69 47               LD B, A
 384+ 8F6A E5               PUSH HL
 385+ 8F6B              .restCol:
