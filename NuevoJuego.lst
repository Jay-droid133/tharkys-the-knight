 601+ E7CD              ; Devuelve HL = puntero a font data del digito en A (0-9)
 602+ E7CD              ; A se destruye
 603+ E7CD              .getDigitFont:
 604+ E7CD C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 605+ E7CF 6F               LD L, A
 606+ E7D0 26 00            LD H, 0
 607+ E7D2 29               ADD HL, HL
 608+ E7D3 29               ADD HL, HL
 609+ E7D4 29               ADD HL, HL                          ; HL = indice * 8
 610+ E7D5 01 23 EA         LD BC, DayHudFont
 611+ E7D8 09               ADD HL, BC
 612+ E7D9 C9               RET
 613+ E7DA
 614+ E7DA              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 615+ E7DA              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 616+ E7DA              .drawChar:
 617+ E7DA 06 08            LD B, 8
 618+ E7DC              .charLoop:
 619+ E7DC 7E               LD A, (HL)
 620+ E7DD 12               LD (DE), A
 621+ E7DE 23               INC HL
 622+ E7DF 14               INC D
 623+ E7E0 10 FA            DJNZ .charLoop
 624+ E7E2 C9               RET
