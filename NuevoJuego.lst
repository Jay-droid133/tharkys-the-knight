 548+ E827 32 D0 82         LD (TownGatePhase), A
 549+ E82A C9               RET
 550+ E82B
 551+ E82B              ; ==============================================================================
 552+ E82B              ; TownGateDecTimer - decrementa TownGateTimer, devuelve Z si llego a 0
 553+ E82B              ; ==============================================================================
 554+ E82B              TownGateDecTimer:
 555+ E82B 3A A5 5F         LD A, (TownGateTimer)
 556+ E82E 3D               DEC A
