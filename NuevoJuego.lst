2626+ D98D C8               RET Z
2627+ D98E FE FE            CP $FE
2628+ D990 28 3A            JR Z, .rpaInactive          ; HL en mapX
2629+ D992 47               LD B, A                     ; mapX
2630+ D993 23               INC HL
2631+ D994 4E               LD C, (HL)                  ; mapY
2632+ D995 23               INC HL                      ; HL en ptr_lo
2633+ D996 3A 08 83         LD A, (CurrentScreenX)
2634+ D999 B8               CP B
2635+ D99A 20 2A            JR NZ, .rpaSkip
2636+ D99C 3A 09 83         LD A, (CurrentScreenY)
2637+ D99F B9               CP C
2638+ D9A0 20 24            JR NZ, .rpaSkip
2639+ D9A2                  ; Pantalla correcta: cargar sprite y pintar attrs
2640+ D9A2 5E               LD E, (HL)
2641+ D9A3 23               INC HL
2642+ D9A4 56               LD D, (HL)                  ; DE = BgGfx ptr
2643+ D9A5 23               INC HL                      ; HL en charX
2644+ D9A6 46               LD B, (HL)                  ; charX
2645+ D9A7 23               INC HL
2646+ D9A8 4E               LD C, (HL)                  ; charY
2647+ D9A9 23               INC HL
2648+ D9AA 7E               LD A, (HL)                  ; tint variant
2649+ D9AB 23               INC HL                      ; HL en siguiente mapX
2650+ D9AC 32 F6 D1         LD (CurrentTintVar), A
2651+ D9AF E5               PUSH HL                     ; guardar puntero a siguiente entry
2652+ D9B0 C5               PUSH BC                     ; charX, charY (LoadBgSpriteToBuffer preserva BC, pero por seguridad)
2653+ D9B1 EB               EX DE, HL                   ; HL = BgGfx ptr
2654+ D9B2 3E 03            LD A, 3                     ; ObjectTable (attrs) ptrs viven en bank 3
2655+ D9B4 CD C2 6A         CALL LoadBgSpriteToBuffer
2656+ D9B7 C1               POP BC
2657+ D9B8 DD 21 F5 86      LD IX, BgSpriteBuffer
