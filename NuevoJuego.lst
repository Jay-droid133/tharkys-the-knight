 372  9BBE                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 373  9BBE                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 374  9BBE                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9BBE              ; ==============================================================================
   2+ 9BBE              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9BBE              ; ==============================================================================
   4+ 9BBE              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9BBE              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9BBE              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9BBE              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9BBE              ;
   9+ 9BBE              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9BBE              ; fallo en el intento previo):
  11+ 9BBE              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9BBE              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9BBE              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9BBE              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9BBE              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9BBE              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9BBE              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9BBE              ;
  19+ 9BBE              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9BBE              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9BBE              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9BBE              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9BBE              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9BBE              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9BBE              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9BBE              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9BBE              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9BBE              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9BBE              ; ==============================================================================
  30+ 9BBE
  31+ 9BBE              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9BBE              AY_Init:
  33+ 9BBE F3               DI
  34+ 9BBF 3A E8 90         LD A, (CurrentPaging)
  35+ 9BC2 E6 F8            AND $F8
  36+ 9BC4 F6 04            OR 4
  37+ 9BC6 32 E8 90         LD (CurrentPaging), A
  38+ 9BC9 01 FD 7F         LD BC, $7FFD
  39+ 9BCC ED 79            OUT (C), A
  40+ 9BCE CD 7E E4         CALL AY_InitImpl
  41+ 9BD1 3A E8 90         LD A, (CurrentPaging)
  42+ 9BD4 E6 F8            AND $F8
  43+ 9BD6 32 E8 90         LD (CurrentPaging), A
  44+ 9BD9 01 FD 7F         LD BC, $7FFD
  45+ 9BDC ED 79            OUT (C), A
  46+ 9BDE 3A 4A 81         LD A, (StartupComplete)
  47+ 9BE1 B7               OR A
  48+ 9BE2 C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9BE3 FB               EI
  50+ 9BE4 C9               RET
  51+ 9BE5
