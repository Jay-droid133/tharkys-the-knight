3970+ B8C5              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
3971+ B8C5              ; ==============================================================================
3972+ B8C5              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
3973+ B8C5              ; ==============================================================================
3974+ B8C5              SchedulePendingErase:
3975+ B8C5 3A 7B 5F         LD A, (PendingEraseCount)
3976+ B8C8 FE 03            CP 3
3977+ B8CA D0               RET NC                              ; Buffer lleno (no deberia pasar)
3978+ B8CB                  ; Calcular posicion en buffer: count × 5
3979+ B8CB 6F               LD L, A
3980+ B8CC 26 00            LD H, 0
3981+ B8CE 29               ADD HL, HL
3982+ B8CF 29               ADD HL, HL
3983+ B8D0 29               ADD HL, HL                          ; count × 8 (simplificado)
3984+ B8D1                  ; Corregir: count × 5 = count × 4 + count
3985+ B8D1 6F               LD L, A
3986+ B8D2 26 00            LD H, 0
3987+ B8D4 54               LD D, H
3988+ B8D5 5D               LD E, L
3989+ B8D6 29               ADD HL, HL
3990+ B8D7 29               ADD HL, HL                          ; count × 4
3991+ B8D8 19               ADD HL, DE                          ; count × 5
3992+ B8D9 11 7C 5F         LD DE, PendingEraseSlots
3993+ B8DC 19               ADD HL, DE
3994+ B8DD                  ; Guardar OLDSPRID, OLDX, OLDY + sprite addr
3995+ B8DD DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
3996+ B8E0 77               LD (HL), A
3997+ B8E1 23               INC HL
3998+ B8E2 DD 7E 0C         LD A, (IX+ENT_OLDX)
3999+ B8E5 77               LD (HL), A
4000+ B8E6 23               INC HL
4001+ B8E7 DD 7E 0D         LD A, (IX+ENT_OLDY)
4002+ B8EA 77               LD (HL), A
4003+ B8EB 23               INC HL
4004+ B8EC                  ; Resolver sprite addr y guardarla
4005+ B8EC E5               PUSH HL
4006+ B8ED CD F3 A7         CALL GetOldSpriteAddr               ; DE = sprite ptr (HL trashed)
4007+ B8F0 E1               POP HL
4008+ B8F1 73               LD (HL), E
4009+ B8F2 23               INC HL
4010+ B8F3 72               LD (HL), D
4011+ B8F4                  ; Incrementar counter
4012+ B8F4 3A 7B 5F         LD A, (PendingEraseCount)
4013+ B8F7 3C               INC A
4014+ B8F8 32 7B 5F         LD (PendingEraseCount), A
4015+ B8FB C9               RET
