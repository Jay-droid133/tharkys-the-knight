7681+ C9EC 32 C6 82         LD (MonsterTrappedFlags), A
7682+ C9EF 32 02 83         LD (DeathSpawned), A
7683+ C9F2 32 D0 82         LD (TownGatePhase), A
7684+ C9F5 32 CE 82         LD (ChurchCutscenePhase), A
7685+ C9F8 32 43 E4         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7686+ C9FB 32 BE 82         LD (BellsTriggered), A
7687+ C9FE 32 C7 82         LD (NextChurchTrapStep), A
7688+ CA01 32 C8 82         LD (StatueBlinkCounter), A
7689+ CA04 32 C9 82         LD (ChurchKeyAltSpawnIdx), A
7690+ CA07 32 74 C5         LD (PlayerHitTimer), A
7691+ CA0A 32 FB 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7692+ CA0D 32 FC 82         LD (TombDrawPending), A
7693+ CA10 32 EF 82         LD (DeathBorderPhase), A
7694+ CA13 32 F0 82         LD (DeathBorderTimer), A
7695+ CA16 32 F1 82         LD (PlayerDeathAnimTimer), A
7696+ CA19 32 F2 82         LD (PlayerDeathAnimFrame), A
7697+ CA1C 32 F3 82         LD (PlayerRespawnPhase), A
7698+ CA1F 32 F4 82         LD (PlayerRespawnTimer), A
7699+ CA22 32 F5 82         LD (PlayerRespawnBlinkTimer), A
7700+ CA25 32 F7 82         LD (PlayerRespawnBeatIdx), A
7701+ CA28 32 E8 82         LD (GameOverAnimX), A
7702+ CA2B 32 E9 82         LD (GameOverAnimDir), A
7703+ CA2E 32 EA 82         LD (GameOverAnimFrame), A
7704+ CA31 32 EB 82         LD (GameOverAnimFrameTimer), A
