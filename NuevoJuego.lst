 729+ E856              ; ==============================================================================
 730+ E856              DrawTimeIndicator:
 731+ E856                  ; Calcular puntero al label de 2 chars
 732+ E856 3A FE E4         LD A, (CurrentTimeOfDay)
 733+ E859 87               ADD A, A                    ; A = momento * 2
 734+ E85A 5F               LD E, A
 735+ E85B 16 00            LD D, 0
 736+ E85D 21 5D E9         LD HL, TimeLabels
 737+ E860 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
