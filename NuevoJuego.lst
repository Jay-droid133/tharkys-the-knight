4621+ B8D3
4622+ B8D3 B6 B8        CurrentNastyTable: DEFW DiurnalTypeTable
4623+ B8D5
4624+ B8D5              ; ==============================================================================
4625+ B8D5              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
4626+ B8D5              ; ==============================================================================
4627+ B8D5              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
4628+ B8D5              ; Fases 2(C2), 3(N1) → CrepuscularTypeTable
4629+ B8D5              ; Fases 4(N2), 5(A1) → no importa (spawn bloqueado)
4630+ B8D5              ; ==============================================================================
4631+ B8D5              UpdateNastyTable:
4632+ B8D5 3A DF D1         LD A, (CurrentTimeOfDay)
4633+ B8D8 FE 02            CP 2
4634+ B8DA 28 09            JR Z, .crepuscular
4635+ B8DC FE 03            CP 3
4636+ B8DE 28 05            JR Z, .crepuscular
4637+ B8E0                  ; Diurnal (0, 1, 6) o fases sin spawn (4, 5)
4638+ B8E0 21 B6 B8         LD HL, DiurnalTypeTable
4639+ B8E3 18 03            JR .setTable
4640+ B8E5              .crepuscular:
4641+ B8E5 21 BA B8         LD HL, CrepuscularTypeTable
4642+ B8E8              .setTable:
4643+ B8E8 22 D3 B8         LD (CurrentNastyTable), HL
4644+ B8EB C9               RET
4645+ B8EC
4646+ B8EC              ; ==============================================================================
4647+ B8EC              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
4648+ B8EC              ; ==============================================================================
4649+ B8EC              ScareAllMonsters:
4650+ B8EC AF               XOR A
4651+ B8ED 32 63 B2         LD (MonstersActive), A              ; No respawnear mas
4652+ B8F0                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
4653+ B8F0                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
4654+ B8F0                  ; del amanecer capturara el orig POSX/POSY del primer frame.
4655+ B8F0 21 0C 90         LD HL, MonsterAiFlags
4656+ B8F3 06 03            LD B, 3
4657+ B8F5              .samClearLoop:
4658+ B8F5 7E               LD A, (HL)
4659+ B8F6 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
4660+ B8F8 77               LD (HL), A
4661+ B8F9 23               INC HL
4662+ B8FA 10 F9            DJNZ .samClearLoop
4663+ B8FC 3E 7D            LD A, SCARE_TIMER_DAWN
4664+ B8FE 32 F9 B4         LD (ScareTimer), A
