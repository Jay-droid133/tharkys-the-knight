5436+ BCAA
5437+ BCAA              ; ==============================================================================
5438+ BCAA              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5439+ BCAA              ; ==============================================================================
5440+ BCAA              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5441+ BCAA              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5442+ BCAA              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5443+ BCAA              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5444+ BCAA              ;   pantalla, no diurnos.
5445+ BCAA              ; ==============================================================================
5446+ BCAA              UpdateNastyTable:
5447+ BCAA 3A 28 E2         LD A, (CurrentTimeOfDay)
5448+ BCAD FE 02            CP 2
5449+ BCAF 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5450+ BCB1 FE 06            CP 6
5451+ BCB3 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5452+ BCB5 21 8F BC         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5453+ BCB8 18 03            JR .setTable
5454+ BCBA              .diurnal:
5455+ BCBA 21 8B BC         LD HL, DiurnalTypeTable
5456+ BCBD              .setTable:
5457+ BCBD 22 A8 BC         LD (CurrentNastyTable), HL
5458+ BCC0 C9               RET
5459+ BCC1
5460+ BCC1              ; ==============================================================================
5461+ BCC1              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5462+ BCC1              ; ==============================================================================
5463+ BCC1              ScareAllMonsters:
5464+ BCC1 AF               XOR A
5465+ BCC2 32 12 B3         LD (MonstersActive), A              ; No respawnear mas
5466+ BCC5                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5467+ BCC5                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5468+ BCC5                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5469+ BCC5 21 93 8D         LD HL, MonsterAiFlags
5470+ BCC8 06 03            LD B, 3
5471+ BCCA              .samClearLoop:
5472+ BCCA 7E               LD A, (HL)
5473+ BCCB E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5474+ BCCD 77               LD (HL), A
5475+ BCCE 23               INC HL
5476+ BCCF 10 F9            DJNZ .samClearLoop
5477+ BCD1 3E 7D            LD A, SCARE_TIMER_DAWN
5478+ BCD3 32 A8 B5         LD (ScareTimer), A
5479+ BCD6                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5480+ BCD6                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5481+ BCD6                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5482+ BCD6                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5483+ BCD6 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5484+ BCDA 06 06            LD B, NUM_MONSTERS
5485+ BCDC              .samStateLoop:
5486+ BCDC DD 7E 01         LD A, (IX+ENT_TYPE)
5487+ BCDF FE 02            CP TYPE_MONSTER
5488+ BCE1 20 1B            JR NZ, .samStateNext
5489+ BCE3 DD 7E 02         LD A, (IX+ENT_STATE)
5490+ BCE6 FE 03            CP STATE_DYING
5491+ BCE8 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5492+ BCEA FE 04            CP STATE_SPAWNING
5493+ BCEC 28 10            JR Z, .samStateNext
5494+ BCEE DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5495+ BCF2 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5496+ BCF6 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5497+ BCFA DD 36 07 00      LD (IX+ENT_DELTAY), 0
5498+ BCFE              .samStateNext:
5499+ BCFE 11 10 00         LD DE, ENT_SIZE
5500+ BD01 DD 19            ADD IX, DE
5501+ BD03 10 D7            DJNZ .samStateLoop
5502+ BD05 C9               RET
5503+ BD06
5504+ BD06              ; ==============================================================================
5505+ BD06              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5506+ BD06              ; ==============================================================================
5507+ BD06              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5508+ BD06              ; ==============================================================================
5509+ BD06
5510+ BD06              ; ==============================================================================
5511+ BD06              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5512+ BD06              ; ==============================================================================
5513+ BD06              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5514+ BD06              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5515+ BD06              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5516+ BD06              ; ==============================================================================
5517+ BD06              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5518+ BD06              ; ==============================================================================
5519+ BD06              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5520+ BD06              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5521+ BD06              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5522+ BD06              ; ==============================================================================
5523+ BD06              MONSTERS_TO_SPAWN   EQU 3
5524+ BD06              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5525+ BD06              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5526+ BD06
5527+ BD06              ; ==============================================================================
5528+ BD06              ; SpawnMonsters - Primera aparicion tras campanadas
5529+ BD06              ; ==============================================================================
5530+ BD06              SpawnMonsters:
5531+ BD06                  IF DEBUG_NO_ENEMIES
5532+ BD06 ~                RET
5533+ BD06                  ENDIF
5534+ BD06 3A 12 B3         LD A, (MonstersActive)
5535+ BD09 B7               OR A
5536+ BD0A C0               RET NZ
5537+ BD0B                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5538+ BD0B                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5539+ BD0B CD E7 B9         CALL KillAllActiveNasties
5540+ BD0E 3E 01            LD A, 1
5541+ BD10 32 12 B3         LD (MonstersActive), A
5542+ BD13 CD 94 BD         CALL ShuffleMonsterTypes
5543+ BD16 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5544+ BD1A 06 03            LD B, MONSTERS_TO_SPAWN
5545+ BD1C 0E 00            LD C, 0
5546+ BD1E              .smLoop:
5547+ BD1E C5               PUSH BC
5548+ BD1F DD 7E 01         LD A, (IX+ENT_TYPE)
5549+ BD22 B7               OR A
5550+ BD23 C2 7F BD         JP NZ, .smSkip
5551+ BD26                  ; Asignar tipo y color
5552+ BD26 79               LD A, C
5553+ BD27 21 F8 BD         LD HL, MonsterTypeTable
5554+ BD2A 5F               LD E, A
5555+ BD2B 16 00            LD D, 0
5556+ BD2D 19               ADD HL, DE
5557+ BD2E 7E               LD A, (HL)
5558+ BD2F DD 77 08         LD (IX+ENT_ANIMBASE), A
5559+ BD32 79               LD A, C
5560+ BD33 21 FB BD         LD HL, MonsterColorTable
5561+ BD36 5F               LD E, A
5562+ BD37 16 00            LD D, 0
5563+ BD39 19               ADD HL, DE
5564+ BD3A 7E               LD A, (HL)
5565+ BD3B DD 77 05         LD (IX+ENT_ATTR), A
5566+ BD3E                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5567+ BD3E C5               PUSH BC
5568+ BD3F CD B8 8F         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5569+ BD42 B7               OR A
5570+ BD43 20 0E            JR NZ, .smFallbackPos
5571+ BD45 3A C0 97         LD A, (MaiSpawnX)
5572+ BD48 DD 77 03         LD (IX+ENT_POSX), A
5573+ BD4B 3A C1 97         LD A, (MaiSpawnY)
5574+ BD4E DD 77 04         LD (IX+ENT_POSY), A
5575+ BD51 18 0C            JR .smPosDone
5576+ BD53              .smFallbackPos:
5577+ BD53 3A 0E 83         LD A, (LastEntryPosX)
5578+ BD56 DD 77 03         LD (IX+ENT_POSX), A
5579+ BD59 3A 0F 83         LD A, (LastEntryPosY)
5580+ BD5C DD 77 04         LD (IX+ENT_POSY), A
5581+ BD5F              .smPosDone:
5582+ BD5F C1               POP BC
5583+ BD60                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5584+ BD60 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5585+ BD64 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5586+ BD68 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5587+ BD6C DD 36 06 00      LD (IX+ENT_DELTAX), 0
5588+ BD70 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5589+ BD74                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5590+ BD74                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5591+ BD74                  ; lo empuje a un vecino (migracion por knockback).
5592+ BD74 CD AD 8E         CALL MaiGetCurrentScreenId
5593+ BD77 21 87 8D         LD HL, MonsterRoomId
5594+ BD7A 59               LD E, C
5595+ BD7B 16 00            LD D, 0
5596+ BD7D 19               ADD HL, DE
5597+ BD7E 77               LD (HL), A
5598+ BD7F              .smSkip:
5599+ BD7F 11 10 00         LD DE, ENT_SIZE
5600+ BD82 DD 19            ADD IX, DE
5601+ BD84 C1               POP BC
5602+ BD85 0C               INC C
5603+ BD86 05               DEC B
5604+ BD87 C2 1E BD         JP NZ, .smLoop
5605+ BD8A 3E 14            LD A, MONSTER_ENTRY_BASE
5606+ BD8C 32 DB BE         LD (TryRespawnMonsters.rmTimer), A
5607+ BD8F                  ; Musica de monsters (track 5 = MonstersMusicTable, poly2 LOOPABLE).
5608+ BD8F                  ; Sustituye a TensionMusicTable que sono entre lights-off y este spawn.
5609+ BD8F                  ; Se sustituira automaticamente por SunriseMusicTable cuando arranque
5610+ BD8F                  ; el amanecer (StartMusic(1) en SetTimeOfDay fase 5).
5611+ BD8F 3E 05            LD A, 5
5612+ BD91 C3 BA 99         JP StartMusic                   ; tail-call: sustituye RET
5613+ BD94
5614+ BD94              ; --- Barajar tablas tipo/color ---
5615+ BD94              ShuffleMonsterTypes:
