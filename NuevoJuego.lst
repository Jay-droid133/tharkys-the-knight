1123+ EDD2              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1124+ EDD2              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1125+ EDD2              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1126+ EDD2              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1127+ EDD2              ; Entre transiciones, solo incrementa frame counter.
1128+ EDD2              .ucsSmokePhase:
1129+ EDD2 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1130+ EDD5 B7               OR A
1131+ EDD6 28 0E            JR Z, .ucsSmokeEntry
1132+ EDD8 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1133+ EDDA 28 16            JR Z, .ucsSmokeStep1
1134+ EDDC FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1135+ EDDE 28 1D            JR Z, .ucsSmokeStep2
1136+ EDE0 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1137+ EDE2 28 25            JR Z, .ucsSmokeEnd
1138+ EDE4 18 35            JR .ucsSmokeIncFrame
1139+ EDE6              .ucsSmokeEntry:
1140+ EDE6                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1141+ EDE6 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1142+ EDE9 CD 32 68         CALL DrawRemainsForType
1143+ EDEC                  ; Dibujar smoke[0] (XOR)
1144+ EDEC AF               XOR A
1145+ EDED CD 7D 67         CALL DrawSmokeFrameXor
1146+ EDF0 18 29            JR .ucsSmokeIncFrame
1147+ EDF2              .ucsSmokeStep1:
1148+ EDF2 AF               XOR A
1149+ EDF3 CD 7D 67         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1150+ EDF6 3E 01            LD A, 1
1151+ EDF8 CD 7D 67         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1152+ EDFB 18 1E            JR .ucsSmokeIncFrame
1153+ EDFD              .ucsSmokeStep2:
1154+ EDFD 3E 01            LD A, 1
1155+ EDFF CD 7D 67         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1156+ EE02 3E 02            LD A, 2
1157+ EE04 CD 7D 67         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1158+ EE07 18 12            JR .ucsSmokeIncFrame
1159+ EE09              .ucsSmokeEnd:
1160+ EE09 3E 02            LD A, 2
1161+ EE0B CD 7D 67         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1162+ EE0E CD 9C 67         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1163+ EE11 3E 04            LD A, 4
