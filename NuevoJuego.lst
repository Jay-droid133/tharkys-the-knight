  65+ 6073              TGP_SHAKE              EQU 4
  66+ 6073              TGP_FINGER_PULSE       EQU 5
  67+ 6073              TGP_FINGER_OUT         EQU 6
  68+ 6073              TGP_ARM_HOLD           EQU 7
  69+ 6073              TGP_ARM_OUT            EQU 8
  70+ 6073              TGP_PLAYER_TURN        EQU 9
  71+ 6073              TGP_PLAYER_HIDE        EQU 10
  72+ 6073              TGP_PLAYER_FRAMED      EQU 11
  73+ 6073              TGP_PLAYER_EXIT        EQU 12
  74+ 6073              TGP_END_HOLD           EQU 13
  75+ 6073              TGP_BLACK              EQU 14
  76+ 6073              TGP_CREDITS            EQU 15
  77+ 6073              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ 6073              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ 6073
  80+ 6073              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ 6073                                                ; check dinamico de "todos los nasties dead".
  82+ 6073                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ 6073                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ 6073                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ 6073
  86+ 6073              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ 6073              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ 6073              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ 6073              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ 6073
  91+ 6073              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ 6073              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ 6073              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ 6073              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ 6073              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ 6073              ;
  97+ 6073              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ 6073              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ 6073              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ 6073              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ 6073              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ 6073              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ 6073              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
