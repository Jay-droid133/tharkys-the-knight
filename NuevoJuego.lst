 202+ 8868              ; ==============================================================================
 203+ 8868              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 204+ 8868              ; ==============================================================================
 205+ 8868              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 206+ 8868              ; y los cruces de tercio de pantalla (cada 64 lineas).
 207+ 8868              ;
 208+ 8868              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 209+ 8868              ; ==============================================================================
 210+ 8868              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 211+ 8868              NextPixelLine:
 212+ 8868 24               INC H                       ; Siguiente scanline dentro del char
 213+ 8869 7C               LD A, H
 214+ 886A E6 07            AND 7
 215+ 886C C0               RET NZ                      ; Sin cruce de char row → listo
 216+ 886D
 217+ 886D                  ; --- Cruce de character row ---
 218+ 886D 7D               LD A, L
 219+ 886E C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 220+ 8870 6F               LD L, A
 221+ 8871 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 222+ 8873 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 223+ 8874
 224+ 8874                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 225+ 8874 7C               LD A, H
 226+ 8875 D6 08            SUB 8
 227+ 8877 67               LD H, A
 228+ 8878 C9               RET
 229+ 8879
 230+ 8879              ; ==============================================================================
 231+ 8879              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 232+ 8879              ; ==============================================================================
 233+ 8879              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 234+ 8879              ; Entrada:
 235+ 8879              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 236+ 8879              ;   A = atributo a pintar
 237+ 8879              ; ==============================================================================
 238+ 8879              SetEntityAttr:
 239+ 8879 F5               PUSH AF                     ; Guardar atributo
 240+ 887A CD A1 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 241+ 887D F1               POP AF
 242+ 887E
 243+ 887E 47               LD B, A                     ; B = atributo (preservar)
 244+ 887F 3A 38 89         LD A, (EntityAttrH)
 245+ 8882 4F               LD C, A                     ; C = filas
 246+ 8883              .rowLoop:
 247+ 8883                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 248+ 8883 E5               PUSH HL
 249+ 8884 7C               LD A, H
 250+ 8885 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 251+ 8887 20 08            JR NZ, .rowNotHud
 252+ 8889 7D               LD A, L
 253+ 888A FE 40            CP (ATTR_BASE + 64) & $FF
 254+ 888C 30 03            JR NC, .rowNotHud
 255+ 888E                  ; Fila en HUD → saltar sin pintar
 256+ 888E E1               POP HL
 257+ 888F 18 0B            JR .rowSkip
 258+ 8891              .rowNotHud:
 259+ 8891 E1               POP HL
 260+ 8892 3A 37 89         LD A, (EntityAttrW)
 261+ 8895 E5               PUSH HL                     ; Guardar inicio de fila
 262+ 8896                  ; Pintar una fila
 263+ 8896              .colLoop:
 264+ 8896 70               LD (HL), B
 265+ 8897 23               INC HL
 266+ 8898 3D               DEC A
 267+ 8899 20 FB            JR NZ, .colLoop
 268+ 889B E1               POP HL
 269+ 889C              .rowSkip:
 270+ 889C                  ; Siguiente fila: HL += 32
 271+ 889C D5               PUSH DE
 272+ 889D 11 20 00         LD DE, 32
 273+ 88A0 19               ADD HL, DE
 274+ 88A1 D1               POP DE
 275+ 88A2 0D               DEC C
 276+ 88A3 20 DE            JR NZ, .rowLoop
 277+ 88A5 C9               RET
