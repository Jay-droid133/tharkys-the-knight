4239+ B63B              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
4240+ B63B              ; ==============================================================================
4241+ B63B              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
4242+ B63B              ; ENT_DIR contiene el ANIMBASE real del enemigo.
