  72+ E49B              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  73+ E49B              ; ==============================================================================
  74+ E49B              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  75+ E49B              ; el AY toca solo durante el decay.
  76+ E49B              ; ==============================================================================
  77+ E49B              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  78+ E49B              ; ==============================================================================
  79+ E49B              ; ==============================================================================
  80+ E49B              ; Variables del decay manual de la campana (con pan estereo)
  81+ E49B              ; ==============================================================================
  82+ E49B              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  83+ E49B              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  84+ E49B              ; Cuando los 3 son 0, la campana esta silenciada.
  85+ E49B 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  86+ E49C 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  87+ E49D 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  88+ E49E 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  89+ E49F
  90+ E49F              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  91+ E49F
  92+ E49F              ; ==============================================================================
  93+ E49F              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  94+ E49F              ; ==============================================================================
  95+ E49F              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  96+ E49F              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  97+ E49F              ; ==============================================================================
  98+ E49F              AY_PlayBellChimeImpl:
  99+ E49F                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 100+ E49F                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 101+ E49F                  ; editor — el sonido espacial debe centrarse en la plaza real).
 102+ E49F 3A 9A 82         LD A, (CurrentScreenX)
 103+ E4A2 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 104+ E4A4 57               LD D, A                     ; D = dx signed (player - plaza)
 105+ E4A5 30 02            JR NC, .absDxOk
 106+ E4A7 ED 44            NEG
 107+ E4A9              .absDxOk:
 108+ E4A9 47               LD B, A                     ; B = |dx|
 109+ E4AA
 110+ E4AA 3A 9B 82         LD A, (CurrentScreenY)
 111+ E4AD D6 09            SUB PLAZA_SCREEN_Y
 112+ E4AF 30 02            JR NC, .absDyOk
 113+ E4B1 ED 44            NEG
 114+ E4B3              .absDyOk:
 115+ E4B3 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 116+ E4B4
 117+ E4B4                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 118+ E4B4                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente, dom +9dB)
 119+ E4B4                  ;   dist 3..5  -> dom=12, far= 8  (medio: mas direccional, dom +12dB)
 120+ E4B4                  ;   dist 6+    -> dom= 9, far= 5  (lejos: muy direccional, dom +12dB)
 121+ E4B4                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 122+ E4B4 06 09            LD B, 9                     ; default tramo lejano: dom
 123+ E4B6 0E 05            LD C, 5                     ;                       far
 124+ E4B8 FE 06            CP 6
 125+ E4BA 30 0C            JR NC, .volTotalSet
 126+ E4BC 06 0C            LD B, 12                    ; tramo medio
 127+ E4BE 0E 08            LD C, 8
 128+ E4C0 FE 03            CP 3
 129+ E4C2 30 04            JR NC, .volTotalSet
 130+ E4C4 06 0F            LD B, 15                    ; tramo cercano
 131+ E4C6 0E 0C            LD C, 12
 132+ E4C8              .volTotalSet:                   ; B = dom_vol, C = far_vol
 133+ E4C8
 134+ E4C8                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 135+ E4C8                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 136+ E4C8                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 137+ E4C8                  ; D == 0 → alineado X → solo canal B (centro)
 138+ E4C8 7A               LD A, D
 139+ E4C9 B7               OR A
 140+ E4CA 28 21            JR Z, .panCenter
 141+ E4CC F2 DE E4         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 142+ E4CF                  ; D < 0: plaza al este → canal C dominante
 143+ E4CF              .panRight:
 144+ E4CF 79               LD A, C
 145+ E4D0 32 9B E4         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 146+ E4D3 78               LD A, B
 147+ E4D4 32 9D E4         LD (BellVolR), A            ; canal C = dom
 148+ E4D7 CB 3F            SRL A
 149+ E4D9 32 9C E4         LD (BellVolC), A            ; canal B = dom/2
 150+ E4DC 18 1A            JR .panDone
 151+ E4DE
 152+ E4DE              .panLeft:
 153+ E4DE                  ; D > 0: plaza al oeste → canal A dominante
 154+ E4DE 78               LD A, B
 155+ E4DF 32 9B E4         LD (BellVolL), A            ; canal A = dom
 156+ E4E2 CB 3F            SRL A
 157+ E4E4 32 9C E4         LD (BellVolC), A            ; canal B = dom/2
 158+ E4E7 79               LD A, C
 159+ E4E8 32 9D E4         LD (BellVolR), A            ; canal C = far
 160+ E4EB 18 0B            JR .panDone
 161+ E4ED
 162+ E4ED              .panCenter:
 163+ E4ED                  ; Alineado: solo canal B
 164+ E4ED 78               LD A, B
 165+ E4EE 32 9C E4         LD (BellVolC), A
 166+ E4F1 AF               XOR A
 167+ E4F2 32 9B E4         LD (BellVolL), A
 168+ E4F5 32 9D E4         LD (BellVolR), A
 169+ E4F8
 170+ E4F8              .panDone:
 171+ E4F8 3E 02            LD A, BELL_DECAY_RATE
 172+ E4FA 32 9E E4         LD (BellDecayTimer), A
