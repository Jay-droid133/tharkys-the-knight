# file closed: code/screen_data.asm
 460  E50A                  ; bg_gfx.asm: movido a bank 3 (ver PAGE 3 abajo)
 461  E50A                  ; sprite_data.asm + shift_tables.asm: movidos a bank 6. DrawSprite
 462  E50A                  ; lee ambos simultaneamente (sprite + tablas de shift), por lo que
 463  E50A                  ; deben vivir en el mismo banco paginado.
 464  E50A                  INCLUDE "day_cycle.asm"
# file opened: code/day_cycle.asm
   1+ E50A              ; ==============================================================================
   2+ E50A              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E50A              ; ==============================================================================
   4+ E50A              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E50A              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E50A              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E50A              ; ==============================================================================
   8+ E50A
   9+ E50A              ; --- Constantes ---
  10+ E50A              NUM_TIME_MOMENTS    EQU 7
  11+ E50A
  12+ E50A              ; --- Variables ---
  13+ E50A 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E50B A3 E9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E50D A3 E9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E50F 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E510 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E511 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E512
  20+ E512              ; ==============================================================================
  21+ E512              ; SetTimeOfDay - Cambia el momento del dia
  22+ E512              ; ==============================================================================
  23+ E512              ; Entrada: A = momento (0-6)
  24+ E512              ; ==============================================================================
  25+ E512              SetTimeOfDay:
  26+ E512 32 0A E5         LD (CurrentTimeOfDay), A
  27+ E515
  28+ E515                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E515 FE 04            CP 4
  30+ E517 20 06            JR NZ, .notNewCycle
  31+ E519 21 8D BF         LD HL, DayCycleCount
  32+ E51C 34               INC (HL)
  33+ E51D 18 04            JR .skipBellsReset
  34+ E51F              .notNewCycle:
  35+ E51F                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E51F                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E51F                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E51F AF               XOR A
  39+ E520 32 B6 82         LD (BellsTriggered), A
  40+ E523              .skipBellsReset:
  41+ E523 3A 0A E5         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E526
  43+ E526                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E526 FE 04            CP 4
  45+ E528 28 21            JR Z, .bellsFirst
  46+ E52A
  47+ E52A                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E52A FE 05            CP 5
  49+ E52C 20 0A            JR NZ, .noScareMon
  50+ E52E CD A7 BF         CALL ScareAllMonsters
  51+ E531                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  52+ E531                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  53+ E531                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  54+ E531                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  55+ E531 3E 01            LD A, 1                         ; track 1 = Sunrise
  56+ E533 CD A0 9C         CALL StartMusic
  57+ E536 18 07            JR .noKillMon
  58+ E538              .noScareMon:
  59+ E538                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  60+ E538 FE 06            CP 6
  61+ E53A 20 03            JR NZ, .noKillMon
  62+ E53C CD 30 BF         CALL KillAllActiveMonsters
  63+ E53F              .noKillMon:
  64+ E53F
  65+ E53F                  ; Actualizar tablas de remap y tabla de nasties
  66+ E53F CD 74 E5         CALL UpdateRemapTables
  67+ E542 CD 90 BF         CALL UpdateNastyTable
  68+ E545
  69+ E545                  ; Forzar remap de atributos (sin redibujar pixeles)
  70+ E545 3E 01            LD A, 1
  71+ E547 32 11 83         LD (AttrsDirty), A
  72+ E54A C9               RET
  73+ E54B
  74+ E54B              .bellsFirst:
  75+ E54B                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  76+ E54B                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  77+ E54B                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  78+ E54B                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  79+ E54B                  ; que sean nocturnos (Crepuscular), no diurnos.
  80+ E54B CD 90 BF         CALL UpdateNastyTable
  81+ E54E                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  82+ E54E                  ; antes de medianoche natural y forzo el evento), saltamos.
  83+ E54E 3A B6 82         LD A, (BellsTriggered)
  84+ E551 B7               OR A
  85+ E552 C0               RET NZ
  86+ E553 3E 01            LD A, 1
  87+ E555 32 B6 82         LD (BellsTriggered), A
  88+ E558 CD 8B FA         CALL StartBellChimes
  89+ E55B C9               RET
  90+ E55C
  91+ E55C              ; ==============================================================================
  92+ E55C              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  93+ E55C              ; ==============================================================================
  94+ E55C              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  95+ E55C              ;   - Salta reloj a 00:00.
  96+ E55C              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  97+ E55C              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  98+ E55C              ;     campanadas como hace el path natural). El usuario quiere que la
  99+ E55C              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 100+ E55C              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 101+ E55C              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 102+ E55C              ;     pero ya esta en N2 -> no-op visual.
 103+ E55C              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 104+ E55C              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 105+ E55C              ;
 106+ E55C              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 107+ E55C              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 108+ E55C              ; aqui no re-dispara nada.
 109+ E55C              ; ==============================================================================
 110+ E55C              TriggerChurchMidnight:
 111+ E55C 3A B6 82         LD A, (BellsTriggered)
 112+ E55F B7               OR A
 113+ E560 C0               RET NZ                              ; bells ya sonaron -> no-op
 114+ E561 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 115+ E563 CD 53 ED         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 116+ E566 3E 04            LD A, 4
 117+ E568 CD 12 E5         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 118+ E56B                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 119+ E56B                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 120+ E56B                  ; diurnos durante chimes). En este path queremos lo contrario.
 121+ E56B CD 74 E5         CALL UpdateRemapTables
 122+ E56E 3E 01            LD A, 1
 123+ E570 32 11 83         LD (AttrsDirty), A
 124+ E573 C9               RET
 125+ E574
 126+ E574              ; ==============================================================================
 127+ E574              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 128+ E574              ; ==============================================================================
 129+ E574              UpdateRemapTables:
 130+ E574 3A 0A E5         LD A, (CurrentTimeOfDay)
 131+ E577 21 77 E9         LD HL, RemapTablePtrs
 132+ E57A 5F               LD E, A
 133+ E57B 16 00            LD D, 0
 134+ E57D 19               ADD HL, DE
 135+ E57E 19               ADD HL, DE
 136+ E57F 5E               LD E, (HL)
 137+ E580 23               INC HL
 138+ E581 56               LD D, (HL)
 139+ E582 ED 53 0B E5      LD (CurrentRemapTable), DE
 140+ E586
 141+ E586 3A 0A E5         LD A, (CurrentTimeOfDay)
 142+ E589 21 85 E9         LD HL, RemapHouseTablePtrs
 143+ E58C 5F               LD E, A
 144+ E58D 16 00            LD D, 0
 145+ E58F 19               ADD HL, DE
 146+ E590 19               ADD HL, DE
 147+ E591 5E               LD E, (HL)
 148+ E592 23               INC HL
 149+ E593 56               LD D, (HL)
 150+ E594 ED 53 0D E5      LD (CurrentHouseRemapTable), DE
 151+ E598 C9               RET
 152+ E599
 153+ E599              ; ==============================================================================
 154+ E599              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 155+ E599              ; ==============================================================================
 156+ E599              CheckDebugKeys:
 157+ E599 3E FB            LD A, $FB
 158+ E59B DB FE            IN A, ($FE)
 159+ E59D CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 160+ E59F 20 1C            JR NZ, .notPressed
 161+ E5A1
 162+ E5A1                  ; Tecla pulsada: comprobar debounce
 163+ E5A1 3A 11 E5         LD A, (DebugKeyDebounce)
 164+ E5A4 B7               OR A
 165+ E5A5 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 166+ E5A6
 167+ E5A6                  ; Primera pulsacion: ciclar
 168+ E5A6 3E 01            LD A, 1
 169+ E5A8 32 11 E5         LD (DebugKeyDebounce), A
 170+ E5AB
 171+ E5AB 3A 0A E5         LD A, (CurrentTimeOfDay)
 172+ E5AE 3C               INC A
 173+ E5AF FE 07            CP NUM_TIME_MOMENTS
 174+ E5B1 38 01            JR C, .noWrap
 175+ E5B3 AF               XOR A                   ; Volver a 0 (Dia)
 176+ E5B4              .noWrap:
 177+ E5B4 F5               PUSH AF
 178+ E5B5 CD 12 E5         CALL SetTimeOfDay
 179+ E5B8 F1               POP AF
 180+ E5B9 CD 53 ED         CALL SetClockToPhaseHour
 181+ E5BC C9               RET
 182+ E5BD
 183+ E5BD              .notPressed:
 184+ E5BD AF               XOR A
 185+ E5BE 32 11 E5         LD (DebugKeyDebounce), A
 186+ E5C1
 187+ E5C1                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 188+ E5C1 3E FD            LD A, $FD
 189+ E5C3 DB FE            IN A, ($FE)
 190+ E5C5 4F               LD C, A                 ; C = estado semi-fila $FDFE
 191+ E5C6 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 192+ E5C8 20 13            JR NZ, .sNotPressed
 193+ E5CA 3A 18 E6         LD A, (SpeedKeyDebounce)
 194+ E5CD B7               OR A
 195+ E5CE C0               RET NZ
 196+ E5CF 3E 01            LD A, 1
 197+ E5D1 32 18 E6         LD (SpeedKeyDebounce), A
 198+ E5D4 21 8D BF         LD HL, DayCycleCount
 199+ E5D7 7E               LD A, (HL)
 200+ E5D8 FE 0A            CP 10
 201+ E5DA D0               RET NC                  ; Ya en maximo
 202+ E5DB 34               INC (HL)
 203+ E5DC C9               RET
 204+ E5DD              .sNotPressed:
 205+ E5DD                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 206+ E5DD CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 207+ E5DF 20 13            JR NZ, .dNotPressed
 208+ E5E1 3A 18 E6         LD A, (SpeedKeyDebounce)
 209+ E5E4 B7               OR A
 210+ E5E5 C0               RET NZ
 211+ E5E6 3E 01            LD A, 1
 212+ E5E8 32 18 E6         LD (SpeedKeyDebounce), A
 213+ E5EB 21 8D BF         LD HL, DayCycleCount
 214+ E5EE 7E               LD A, (HL)
 215+ E5EF FE 01            CP 1
 216+ E5F1 C8               RET Z                   ; Ya en minimo
 217+ E5F2 35               DEC (HL)
 218+ E5F3 C9               RET
 219+ E5F4              .dNotPressed:
 220+ E5F4 AF               XOR A
 221+ E5F5 32 18 E6         LD (SpeedKeyDebounce), A
 222+ E5F8
 223+ E5F8                  ; --- Tecla N: togglea NoclipMode (debug) ---
 224+ E5F8 3E 7F            LD A, $7F
 225+ E5FA DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 226+ E5FC CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 227+ E5FE 20 13            JR NZ, .nNotPressed
 228+ E600 3A 19 E6         LD A, (NoclipKeyDebounce)
 229+ E603 B7               OR A
 230+ E604 C0               RET NZ
 231+ E605 3E 01            LD A, 1
 232+ E607 32 19 E6         LD (NoclipKeyDebounce), A
 233+ E60A 3A AD 82         LD A, (NoclipMode)
 234+ E60D EE 01            XOR 1
 235+ E60F 32 AD 82         LD (NoclipMode), A
 236+ E612 C9               RET
 237+ E613              .nNotPressed:
 238+ E613 AF               XOR A
 239+ E614 32 19 E6         LD (NoclipKeyDebounce), A
 240+ E617 C9               RET
 241+ E618
 242+ E618 00           SpeedKeyDebounce: DEFB 0
 243+ E619 00           NoclipKeyDebounce: DEFB 0
