 401+ 65A6 FE FF            CP $FF
 402+ 65A8 C8               RET Z                                   ; no encontrada en esta pantalla
 403+ 65A9 47               LD B, A                                 ; B = current id
 404+ 65AA 3A DB 65         LD A, (.eseTargetId)
 405+ 65AD B8               CP B
