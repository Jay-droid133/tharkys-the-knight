 228+ 9D06              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 229+ 9D06              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 230+ 9D06              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 231+ 9D06              ;
 232+ 9D06              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 233+ 9D06              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 234+ 9D06              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 235+ 9D06              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 236+ 9D06              StartMusic:
 237+ 9D06 32 2B 9D         LD (MusicTrackArg), A
 238+ 9D09 F3               DI
 239+ 9D0A 3A E8 90         LD A, (CurrentPaging)
 240+ 9D0D E6 F8            AND $F8
 241+ 9D0F F6 04            OR 4
 242+ 9D11 32 E8 90         LD (CurrentPaging), A
 243+ 9D14 01 FD 7F         LD BC, $7FFD
 244+ 9D17 ED 79            OUT (C), A
 245+ 9D19 CD 1D E6         CALL StartMusicImpl
 246+ 9D1C 3A E8 90         LD A, (CurrentPaging)
 247+ 9D1F E6 F8            AND $F8
 248+ 9D21 32 E8 90         LD (CurrentPaging), A
 249+ 9D24 01 FD 7F         LD BC, $7FFD
 250+ 9D27 ED 79            OUT (C), A
 251+ 9D29 FB               EI
 252+ 9D2A C9               RET
 253+ 9D2B
 254+ 9D2B              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 255+ 9D2B              ; desde el Impl en bank 4 sin trampa de paging.
 256+ 9D2B 00           MusicTrackArg: DEFB 0
 257+ 9D2C
 258+ 9D2C              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 259+ 9D2C              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 260+ 9D2C              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 261+ 9D2C              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 262+ 9D2C              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 263+ 9D2C              ; (bank 0/2) puedan leer/escribir sin paging.
 264+ 9D2C 00           MusicSpeedShift: DEFB 0
 265+ 9D2D
 266+ 9D2D              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 267+ 9D2D              ; transiciones de pantalla u otros frames lentos) ---
 268+ 9D2D              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 269+ 9D2D              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 270+ 9D2D              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 271+ 9D2D              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 272+ 9D2D              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 273+ 9D2D              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 274+ 9D2D              ; tick daria 0, drift acumulando.
 275+ 9D2D 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 276+ 9D2E 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 277+ 9D2F
