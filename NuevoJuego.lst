6904+ C8E3 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6905+ C8E7 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6906+ C8EA 47               LD B, A
6907+ C8EB DD 96 08         SUB (IX+ENT_ANIMBASE)
6908+ C8EE E6 01            AND 1
6909+ C8F0 20 03            JR NZ, .daFrameDec
6910+ C8F2 04               INC B
6911+ C8F3 18 01            JR .daFrameStore
6912+ C8F5              .daFrameDec:
6913+ C8F5 05               DEC B
6914+ C8F6              .daFrameStore:
6915+ C8F6 DD 70 00         LD (IX+ENT_SPRITEID), B
6916+ C8F9              .daFrameSet:
6917+ C8F9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6918+ C8FC DD 96 08         SUB (IX+ENT_ANIMBASE)
6919+ C8FF E6 01            AND 1
6920+ C901 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6921+ C904 81               ADD A, C
6922+ C905 DD 77 00         LD (IX+ENT_SPRITEID), A
6923+ C908 C9               RET
