2829+ B1F7 DD 36 04 A7      LD (IX+ENT_POSY), SCREEN_MAX_Y - 1
2830+ B1FB 3E 02            LD A, DIR_S
2831+ B1FD 18 06            JR .moKbClampX
2832+ B1FF              .moKbExitTop:
2833+ B1FF DD 36 04 10      LD (IX+ENT_POSY), SCREEN_MIN_Y
2834+ B203 3E 01            LD A, DIR_N
2835+ B205              .moKbClampX:
