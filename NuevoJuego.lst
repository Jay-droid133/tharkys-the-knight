 202+ 8840              ; ==============================================================================
 203+ 8840              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 204+ 8840              ; ==============================================================================
 205+ 8840              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 206+ 8840              ; y los cruces de tercio de pantalla (cada 64 lineas).
 207+ 8840              ;
 208+ 8840              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 209+ 8840              ; ==============================================================================
 210+ 8840              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 211+ 8840              NextPixelLine:
 212+ 8840 24               INC H                       ; Siguiente scanline dentro del char
 213+ 8841 7C               LD A, H
 214+ 8842 E6 07            AND 7
 215+ 8844 C0               RET NZ                      ; Sin cruce de char row → listo
 216+ 8845
 217+ 8845                  ; --- Cruce de character row ---
 218+ 8845 7D               LD A, L
 219+ 8846 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 220+ 8848 6F               LD L, A
 221+ 8849 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 222+ 884B C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 223+ 884C
 224+ 884C                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 225+ 884C 7C               LD A, H
 226+ 884D D6 08            SUB 8
 227+ 884F 67               LD H, A
 228+ 8850 C9               RET
 229+ 8851
 230+ 8851              ; ==============================================================================
 231+ 8851              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 232+ 8851              ; ==============================================================================
 233+ 8851              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 234+ 8851              ; Entrada:
 235+ 8851              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 236+ 8851              ;   A = atributo a pintar
 237+ 8851              ; ==============================================================================
 238+ 8851              SetEntityAttr:
 239+ 8851 F5               PUSH AF                     ; Guardar atributo
 240+ 8852 CD 79 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 241+ 8855 F1               POP AF
 242+ 8856
 243+ 8856 47               LD B, A                     ; B = atributo (preservar)
 244+ 8857 3A 10 89         LD A, (EntityAttrH)
 245+ 885A 4F               LD C, A                     ; C = filas
 246+ 885B              .rowLoop:
 247+ 885B                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 248+ 885B E5               PUSH HL
 249+ 885C 7C               LD A, H
 250+ 885D FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 251+ 885F 20 08            JR NZ, .rowNotHud
 252+ 8861 7D               LD A, L
 253+ 8862 FE 40            CP (ATTR_BASE + 64) & $FF
 254+ 8864 30 03            JR NC, .rowNotHud
 255+ 8866                  ; Fila en HUD → saltar sin pintar
 256+ 8866 E1               POP HL
 257+ 8867 18 0B            JR .rowSkip
 258+ 8869              .rowNotHud:
 259+ 8869 E1               POP HL
 260+ 886A 3A 0F 89         LD A, (EntityAttrW)
 261+ 886D E5               PUSH HL                     ; Guardar inicio de fila
 262+ 886E                  ; Pintar una fila
 263+ 886E              .colLoop:
 264+ 886E 70               LD (HL), B
 265+ 886F 23               INC HL
 266+ 8870 3D               DEC A
 267+ 8871 20 FB            JR NZ, .colLoop
 268+ 8873 E1               POP HL
 269+ 8874              .rowSkip:
 270+ 8874                  ; Siguiente fila: HL += 32
 271+ 8874 D5               PUSH DE
 272+ 8875 11 20 00         LD DE, 32
 273+ 8878 19               ADD HL, DE
 274+ 8879 D1               POP DE
 275+ 887A 0D               DEC C
 276+ 887B 20 DE            JR NZ, .rowLoop
 277+ 887D C9               RET
