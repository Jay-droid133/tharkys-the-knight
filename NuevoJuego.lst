2196+ D822              ; ==============================================================================
2197+ D822              ; BumpTriggerTable - sprites que disparan acción al "chocar" (no por overlap).
2198+ D822              ; ==============================================================================
2199+ D822              ; Cada entry: ptr (DEFW), required_key (DEFB), action_id (DEFB). 4 bytes.
2200+ D822              ; Terminada en DEFW 0.
2201+ D822              ;
2202+ D822              ; Action_ids:
2203+ D822              ;   1 = TownHall: ChurchKeySpawned = 1, CurrentKey = 0.
2204+ D822              ;   2 = ChurchDoor: ChurchDoorOpen = 1, CurrentKey = 0, reescribe ptr de la
2205+ D822              ;       entry a BgGfx_old_church_door_open + rebuild CollisionMap.
2206+ D822              ;
2207+ D822              ; El sprite tiene que estar también en WallAlwaysTable para que sea sólido.
2208+ D822              ;
2209+ D822              ; NOTA: el cutscene final (action 3 = TownGate) se dispara aparte, en
2210+ D822              ; CheckTownGateTriggerBg (town_gate_cutscene.asm). El arco es BG sprite y
2211+ D822              ; no esta en PickupTable, asi que esta tabla no puede hospedarlo. La logica
2212+ D822              ; es equivalente: AABB del player vs rect del arco con tolerancia +-4.
2213+ D822              ; ==============================================================================
2214+ D822              BumpTriggerTable:
2215+ D822 73 DE            DEFW BgGfx_old_church_door_closed
2216+ D824 05               DEFB 5                          ; key requerida = ChurchKey
