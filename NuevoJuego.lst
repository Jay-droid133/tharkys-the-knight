 670+ E0F4 47               LD B, A                                 ; B = frame deseado
 671+ E0F5 3A D6 82         LD A, (BankCutsceneHandFrame)
 672+ E0F8 B8               CP B
 673+ E0F9 28 0C            JR Z, .bcOpenInNoSwap                   ; mismo frame, no hace falta swap
 674+ E0FB                  ; OJO: BankCutsceneEraseHandOpen -> DrawHandOpen -> LDIR (con BC=34)
 675+ E0FB                  ; corrompe BC. Sin PUSH/POP, B queda a 0 al volver y HandFrame siempre se
 676+ E0FB                  ; setea a frame 1 -> animacion invisible (parece estatica).
 677+ E0FB C5               PUSH BC                                 ; preserva frame deseado
 678+ E0FC CD B9 E2         CALL BankCutsceneEraseHandOpen          ; XOR self-cancel frame actual
 679+ E0FF C1               POP BC                                  ; recupera frame deseado
 680+ E100 78               LD A, B
