1074+ A4ED
1075+ A4ED              ; ==============================================================================
1076+ A4ED              ; UpdatePlayerState - Determina estado y direccion desde input
1077+ A4ED              ; ==============================================================================
1078+ A4ED              UpdatePlayerState:
1079+ A4ED 3A C0 81         LD A, (InputDirection)
1080+ A4F0 47               LD B, A
1081+ A4F1 3A C1 81         LD A, (InputFire)
1082+ A4F4 4F               LD C, A
1083+ A4F5
1084+ A4F5                  ; Sin input → idle (salvo si ataque en curso)
1085+ A4F5 78               LD A, B
1086+ A4F6 B1               OR C
1087+ A4F7 20 17            JR NZ, .notIdle
1088+ A4F9                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1089+ A4F9 3A 58 B2         LD A, (AttackTimer)
1090+ A4FC B7               OR A
1091+ A4FD 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1092+ A4FF DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1093+ A503                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1094+ A503 DD 7E 0A         LD A, (IX+ENT_DIR)
1095+ A506 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1096+ A508 DD 77 0A         LD (IX+ENT_DIR), A
1097+ A50B                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1098+ A50B AF               XOR A
1099+ A50C 32 5A B2         LD (AttackDebounce), A
1100+ A50F C9               RET
1101+ A510
1102+ A510              .notIdle:
1103+ A510                  ; Guardar direccion actual en bits 0-3
1104+ A510 DD 7E 0A         LD A, (IX+ENT_DIR)
1105+ A513 E6 F0            AND $F0                     ; Mantener lastHDir
1106+ A515 B0               OR B                        ; Añadir dir actual
1107+ A516 DD 77 0A         LD (IX+ENT_DIR), A
1108+ A519
1109+ A519                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1110+ A519 3A 58 B2         LD A, (AttackTimer)
1111+ A51C B7               OR A
1112+ A51D 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1113+ A51F 78               LD A, B
1114+ A520 E6 0C            AND DIR_E | DIR_W
1115+ A522 28 0E            JR Z, .noHorizUpdate
1116+ A524                  ; Guardar en bits 4-7
1117+ A524 07               RLCA
1118+ A525 07               RLCA
1119+ A526 07               RLCA
1120+ A527 07               RLCA                        ; Shift a bits 4-7
1121+ A528 4F               LD C, A                     ; C = lastHDir en bits 4-7
1122+ A529 DD 7E 0A         LD A, (IX+ENT_DIR)
1123+ A52C E6 0F            AND $0F                     ; Mantener dir actual
1124+ A52E B1               OR C                        ; Añadir lastHDir
1125+ A52F DD 77 0A         LD (IX+ENT_DIR), A
1126+ A532              .noHorizUpdate:
1127+ A532
1128+ A532                  ; --- Consumir/regenerar stamina ---
1129+ A532 CD 9C A9         CALL UpdateStamina
1130+ A535                  ; --- Auto-select sword mode segun stamina ---
1131+ A535 CD F2 A9         CALL SelectSwordMode
1132+ A538                  ; --- Dispatch segun SwordMode ---
1133+ A538 3A 5C B2         LD A, (SwordMode)
1134+ A53B B7               OR A
1135+ A53C 28 09            JR Z, .swordModeB
1136+ A53E FE 01            CP 1
1137+ A540 28 3F            JR Z, .swordModeC
1138+ A542 FE 02            CP 2
1139+ A544 CA AA A5         JP Z, .swordModeFree
1140+ A547
1141+ A547                  ; === MODO B: Cooldown fijo tras atacar ===
1142+ A547              .swordModeB:
1143+ A547 3A 59 B2         LD A, (AttackCooldown)
1144+ A54A B7               OR A
1145+ A54B 28 0D            JR Z, .bNoCooldown
1146+ A54D 3D               DEC A
1147+ A54E 32 59 B2         LD (AttackCooldown), A
1148+ A551 C2 F8 A5         JP NZ, .running                     ; En cooldown: no puede atacar
1149+ A554                  ; Cooldown terminado: restaurar color blanco
1150+ A554 CD D1 A5         CALL .setPlayerWhite
1151+ A557 C3 F8 A5         JP .running
1152+ A55A              .bNoCooldown:
1153+ A55A 3A 58 B2         LD A, (AttackTimer)
1154+ A55D B7               OR A
1155+ A55E 28 13            JR Z, .bNoActive
1156+ A560 3D               DEC A
1157+ A561 32 58 B2         LD (AttackTimer), A
1158+ A564 20 08            JR NZ, .bActive
1159+ A566                  ; Swing terminado: iniciar cooldown + color azul
1160+ A566 3E 0A            LD A, ATTACK_COOLDOWN_FRAMES
1161+ A568 32 59 B2         LD (AttackCooldown), A
1162+ A56B CD C6 A5         CALL .setPlayerBlue
1163+ A56E              .bActive:
1164+ A56E DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1165+ A572 C9               RET
1166+ A573              .bNoActive:
1167+ A573 3A C1 81         LD A, (InputFire)
1168+ A576 B7               OR A
1169+ A577 CA F8 A5         JP Z, .running
1170+ A57A 3E 05            LD A, ATTACK_SWING_FRAMES
1171+ A57C 32 58 B2         LD (AttackTimer), A
1172+ A57F 18 5B            JR .startAttack
1173+ A581
1174+ A581                  ; === MODO C: Swing fijo con debounce ===
1175+ A581              .swordModeC:
1176+ A581 3A 58 B2         LD A, (AttackTimer)
1177+ A584 B7               OR A
1178+ A585 28 09            JR Z, .cNoActive
1179+ A587 3D               DEC A
1180+ A588 32 58 B2         LD (AttackTimer), A
1181+ A58B DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
1182+ A58F C9               RET
1183+ A590              .cNoActive:
1184+ A590 3A C1 81         LD A, (InputFire)
1185+ A593 B7               OR A
1186+ A594 CA F4 A5         JP Z, .attackReleased
1187+ A597 3A 5A B2         LD A, (AttackDebounce)
1188+ A59A B7               OR A
1189+ A59B C2 F8 A5         JP NZ, .running                     ; Aun mantenido → no re-atacar
1190+ A59E 3E 01            LD A, 1
