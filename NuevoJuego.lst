 748+ E594 7E               LD A, (HL)
 749+ E595 1E 1F            LD E, 31
 750+ E597 CD A3 E5         CALL DrawHudChar
 751+ E59A
 752+ E59A                  ; Atributos del indicador (bright white on black)
 753+ E59A 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 754+ E59D 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 755+ E59F 77               LD (HL), A
 756+ E5A0 23               INC HL
 757+ E5A1 77               LD (HL), A
 758+ E5A2 C9               RET
