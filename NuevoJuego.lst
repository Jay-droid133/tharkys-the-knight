 288+ A293 3A 0E 9F         LD A, (EntityAttrH)
 289+ A296 FE 02            CP 2
 290+ A298 38 04            JR C, .plAttrHOk
 291+ A29A 3D               DEC A
 292+ A29B 32 0E 9F         LD (EntityAttrH), A
 293+ A29E              .plAttrHOk:
 294+ A29E DD E1            POP IX
 295+ A2A0 3A 6E 82         LD A, (PlayerDrawY)
 296+ A2A3 57               LD D, A
 297+ A2A4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 298+ A2A7 5F               LD E, A
 299+ A2A8 DD 7E 05         LD A, (IX+ENT_ATTR)
 300+ A2AB CD 0F 9E         CALL SetEntityAttr
 301+ A2AE C9               RET
