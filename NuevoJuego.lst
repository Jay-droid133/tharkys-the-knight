 237+ EC8A                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EC8A 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EC8D CB 86            RES 0, (HL)
 240+ EC8F C9               RET
 241+ EC90
 242+ EC90              .clkBlinkOff:
 243+ EC90                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EC90                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EC90                  ; paper=black + ink=black.
 246+ EC90 AF               XOR A
 247+ EC91 32 0F 58         LD ($580F), A
 248+ EC94 32 2F 58         LD ($582F), A
 249+ EC97 32 10 58         LD ($5810), A
 250+ EC9A 32 30 58         LD ($5830), A
