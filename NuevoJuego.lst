2178+ DA2A              ;      C = required_key (válido si A != 0).
2179+ DA2A              ; Preserva: DE, IX, IY. Destruye: A, BC, HL.
2180+ DA2A              ; ==============================================================================
2181+ DA2A              LookupBumpTrigger:
2182+ DA2A 21 1E DA         LD HL, BumpTriggerTable
2183+ DA2D              .lbtLoop:
