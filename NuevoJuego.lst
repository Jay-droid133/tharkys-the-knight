1822+ F7EA              ; ==============================================================================
1823+ F7EA              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1824+ F7EA              ;                     debe salir (magic compass activa).
1825+ F7EA              ; ==============================================================================
1826+ F7EA              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1827+ F7EA              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1828+ F7EA              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1829+ F7EA              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1830+ F7EA              ; el viejo porque DrawScreen ya repinta BG limpio.
1831+ F7EA              ;
1832+ F7EA              ; Llamada cada frame desde MainLoop tras DrawCompass.
1833+ F7EA              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1834+ F7EA              ; ==============================================================================
1835+ F7EA              DrawCompassGapHint:
1836+ F7EA                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1837+ F7EA                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1838+ F7EA                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1839+ F7EA                  ; produciendo el parpadeo sincronizado con el tic AY.
1840+ F7EA 2A BF 5F         LD HL, (MagicCompassTimer)
1841+ F7ED 7C               LD A, H
1842+ F7EE B5               OR L
1843+ F7EF 28 7B            JR Z, .dcghHide
1844+ F7F1 3A C1 5F         LD A, (MagicCompassPathDir)
1845+ F7F4 3C               INC A                               ; A=0 si era $FF
1846+ F7F5 28 75            JR Z, .dcghHide
1847+ F7F7 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1848+ F7FA B7               OR A
1849+ F7FB 28 6F            JR Z, .dcghHide
1850+ F7FD
1851+ F7FD                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1852+ F7FD 21 20 F9         LD HL, HintLastDir
1853+ F800 7E               LD A, (HL)
1854+ F801 47               LD B, A
1855+ F802 3A C1 5F         LD A, (MagicCompassPathDir)
1856+ F805 B8               CP B
1857+ F806 20 1A            JR NZ, .dcghDraw
1858+ F808 23               INC HL
1859+ F809 7E               LD A, (HL)
1860+ F80A 47               LD B, A
1861+ F80B 3A C2 5F         LD A, (MagicCompassPathCoord)
1862+ F80E B8               CP B
1863+ F80F 20 11            JR NZ, .dcghDraw
1864+ F811 23               INC HL
1865+ F812 7E               LD A, (HL)
1866+ F813 47               LD B, A
1867+ F814 3A 01 83         LD A, (CurrentScreenX)
1868+ F817 B8               CP B
1869+ F818 20 08            JR NZ, .dcghDraw
1870+ F81A 23               INC HL
1871+ F81B 7E               LD A, (HL)
1872+ F81C 47               LD B, A
1873+ F81D 3A 02 83         LD A, (CurrentScreenY)
1874+ F820 B8               CP B
1875+ F821 C8               RET Z                               ; sin cambio -> nada que hacer
1876+ F822
1877+ F822              .dcghDraw:
1878+ F822                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1879+ F822                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1880+ F822 3A 20 F9         LD A, (HintLastDir)
1881+ F825 FE FF            CP $FF
1882+ F827 28 1F            JR Z, .dcghDrawNew
1883+ F829 3A 22 F9         LD A, (HintLastScreenX)
1884+ F82C 47               LD B, A
1885+ F82D 3A 01 83         LD A, (CurrentScreenX)
1886+ F830 B8               CP B
1887+ F831 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1888+ F833 3A 23 F9         LD A, (HintLastScreenY)
1889+ F836 47               LD B, A
1890+ F837 3A 02 83         LD A, (CurrentScreenY)
1891+ F83A B8               CP B
1892+ F83B 20 0B            JR NZ, .dcghDrawNew
1893+ F83D 3A 20 F9         LD A, (HintLastDir)
1894+ F840 47               LD B, A
1895+ F841 3A 21 F9         LD A, (HintLastCoord)
1896+ F844 4F               LD C, A
1897+ F845 CD C3 F8         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1898+ F848              .dcghDrawNew:
1899+ F848 3A C1 5F         LD A, (MagicCompassPathDir)
1900+ F84B 47               LD B, A
1901+ F84C 3A C2 5F         LD A, (MagicCompassPathCoord)
1902+ F84F 4F               LD C, A
1903+ F850 CD B6 F8         CALL DrawHintAtPos
1904+ F853                  ; Update cache
1905+ F853 3A C1 5F         LD A, (MagicCompassPathDir)
1906+ F856 32 20 F9         LD (HintLastDir), A
1907+ F859 3A C2 5F         LD A, (MagicCompassPathCoord)
1908+ F85C 32 21 F9         LD (HintLastCoord), A
1909+ F85F 3A 01 83         LD A, (CurrentScreenX)
1910+ F862 32 22 F9         LD (HintLastScreenX), A
1911+ F865 3A 02 83         LD A, (CurrentScreenY)
1912+ F868 32 23 F9         LD (HintLastScreenY), A
1913+ F86B C9               RET
