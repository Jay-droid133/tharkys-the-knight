 332+ EF22              ; ==============================================================================
 333+ EF22              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 334+ EF22              ; ==============================================================================
 335+ EF22              ; PickupTable layout (per-entry, 7 bytes):
 336+ EF22              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 337+ EF22              ; Terminator: $FF (single byte).
 338+ EF22              ;
 339+ EF22              ; IN:  DE = ptr a buscar
 340+ EF22              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 341+ EF22              ;      B = C = $FF si no encontrado (Z).
 342+ EF22              ; Destruye: AF, HL. Preserva DE.
 343+ EF22              ; ==============================================================================
 344+ EF22              FindPickupScreen:
 345+ EF22 21 79 DE         LD HL, PickupTable
 346+ EF25              .fpsLoop:
 347+ EF25 7E               LD A, (HL)
 348+ EF26 FE FF            CP $FF
 349+ EF28 28 1C            JR Z, .fpsNotFound
 350+ EF2A E5               PUSH HL
 351+ EF2B 23               INC HL                              ; -> mapY
 352+ EF2C 23               INC HL                              ; -> ptr_lo
 353+ EF2D 7E               LD A, (HL)
 354+ EF2E BB               CP E
 355+ EF2F 20 0C            JR NZ, .fpsNoMatch
 356+ EF31 23               INC HL                              ; -> ptr_hi
 357+ EF32 7E               LD A, (HL)
 358+ EF33 BA               CP D
 359+ EF34 20 07            JR NZ, .fpsNoMatch
 360+ EF36 E1               POP HL                              ; back to entry start (mapX)
 361+ EF37 46               LD B, (HL)                          ; B = mapX
 362+ EF38 23               INC HL
 363+ EF39 4E               LD C, (HL)                          ; C = mapY
 364+ EF3A F6 01            OR 1                                ; clear Z (NZ = encontrado)
 365+ EF3C C9               RET
 366+ EF3D              .fpsNoMatch:
 367+ EF3D E1               POP HL
 368+ EF3E C5               PUSH BC
 369+ EF3F 01 07 00         LD BC, 7
 370+ EF42 09               ADD HL, BC
 371+ EF43 C1               POP BC
 372+ EF44 18 DF            JR .fpsLoop
 373+ EF46              .fpsNotFound:
 374+ EF46 06 FF            LD B, $FF
 375+ EF48 0E FF            LD C, $FF
 376+ EF4A AF               XOR A                               ; set Z
 377+ EF4B C9               RET
