 458  CC4B                  INCLUDE "screen_system.asm"
# file opened: code/screen_system.asm
   1+ CC4B              ; ==============================================================================
   2+ CC4B              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CC4B              ; ==============================================================================
   4+ CC4B              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CC4B              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CC4B              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CC4B              ; ==============================================================================
   8+ CC4B
   9+ CC4B              ; ==============================================================================
  10+ CC4B              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CC4B              ; ==============================================================================
  12+ CC4B              InitScreenSystem:
  13+ CC4B 3E 08            LD A, START_SCREEN_X
  14+ CC4D 32 08 83         LD (CurrentScreenX), A
  15+ CC50 3E 09            LD A, START_SCREEN_Y
  16+ CC52 32 09 83         LD (CurrentScreenY), A
  17+ CC55 3E 01            LD A, 1
  18+ CC57 32 10 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CC5A AF               XOR A
  20+ CC5B 32 0C 83         LD (ScreenTransition), A
  21+ CC5E CD 62 CC         CALL CalcScreenAddress
  22+ CC61 C9               RET
  23+ CC62
  24+ CC62              ; ==============================================================================
  25+ CC62              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CC62              ; ==============================================================================
  27+ CC62              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CC62              ; ==============================================================================
  29+ CC62              CalcScreenAddress:
  30+ CC62 3A 09 83         LD A, (CurrentScreenY)
  31+ CC65 6F               LD L, A
  32+ CC66 26 00            LD H, 0
  33+ CC68 29               ADD HL, HL                  ; x2
  34+ CC69 29               ADD HL, HL                  ; x4
  35+ CC6A 29               ADD HL, HL                  ; x8
  36+ CC6B 29               ADD HL, HL                  ; x16
  37+ CC6C 3A 08 83         LD A, (CurrentScreenX)
  38+ CC6F 5F               LD E, A
  39+ CC70 16 00            LD D, 0
  40+ CC72 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CC73 11 42 DD         LD DE, MapTable
  42+ CC76 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CC77 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CC78                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CC78 6F               LD L, A
  46+ CC79 26 00            LD H, 0
  47+ CC7B 29               ADD HL, HL                  ; index * 2
  48+ CC7C 11 10 DC         LD DE, RoomTable
  49+ CC7F 19               ADD HL, DE
  50+ CC80 5E               LD E, (HL)
  51+ CC81 23               INC HL
  52+ CC82 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CC83                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CC83 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CC84 CD 72 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CC87                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CC87 11 F5 85         LD DE, CurrentScreenBuffer
  58+ CC8A ED 53 0A 83      LD (CurrentScreenAddr), DE
  59+ CC8E C9               RET
  60+ CC8F
  61+ CC8F              ; ==============================================================================
  62+ CC8F              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CC8F              ; ==============================================================================
  64+ CC8F              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CC8F              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CC8F              ; por estar atrapado cerca del borde.
  67+ CC8F              ; ==============================================================================
  68+ CC8F              CheckScreenTransition:
  69+ CC8F AF               XOR A
  70+ CC90 32 0C 83         LD (ScreenTransition), A
  71+ CC93
  72+ CC93                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CC93                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CC93                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CC93                  ; dispararia transicion sur en plena animacion.
  76+ CC93 3A C8 82         LD A, (TownGatePhase)
  77+ CC96 B7               OR A
  78+ CC97 C0               RET NZ
  79+ CC98
  80+ CC98                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CC98                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CC98                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CC98                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CC98                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CC98                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CC98 3A B3 82         LD A, (TimeFrozen)
  87+ CC9B B7               OR A
  88+ CC9C 28 23            JR Z, .cstNotFrozen
  89+ CC9E 3A AB 82         LD A, (InputDirection)
  90+ CCA1 CB 4F            BIT 1, A                    ; S
  91+ CCA3 28 17            JR Z, .cstClearBlockFlag
  92+ CCA5 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  93+ CCA8 FE A8            CP SCREEN_MAX_Y
  94+ CCAA 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CCAC                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CCAC 3A B4 82         LD A, (BlockedExitSoundFlag)
  97+ CCAF B7               OR A
  98+ CCB0 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CCB1 3E 01            LD A, 1
 100+ CCB3 32 B4 82         LD (BlockedExitSoundFlag), A
 101+ CCB6 21 65 F7         LD HL, SFX_BlockedExit
 102+ CCB9 C3 41 F6         JP PlaySFX                  ; tail call
 103+ CCBC              .cstClearBlockFlag:
 104+ CCBC AF               XOR A
 105+ CCBD 32 B4 82         LD (BlockedExitSoundFlag), A
 106+ CCC0 C9               RET
 107+ CCC1              .cstNotFrozen:
 108+ CCC1                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CCC1 AF               XOR A
 110+ CCC2 32 B4 82         LD (BlockedExitSoundFlag), A
 111+ CCC5
 112+ CCC5 3A AB 82         LD A, (InputDirection)
 113+ CCC8 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CCC9
 115+ CCC9                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CCC9 CB 5A            BIT 3, D                    ; W
 117+ CCCB CA 2C CD         JP Z, .noWest
 118+ CCCE 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 119+ CCD1 FE 04            CP TRANSITION_ZONE
 120+ CCD3 D2 2C CD         JP NC, .noWest
 121+ CCD6 3A 08 83         LD A, (CurrentScreenX)
 122+ CCD9 B7               OR A
 123+ CCDA CA 2C CD         JP Z, .noWest
 124+ CCDD                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CCDD 06 00            LD B, 0
 126+ CCDF 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 127+ CCE2 4F               LD C, A
 128+ CCE3 CD 0E D5         CALL IsPointBlocked
 129+ CCE6 C2 2C CD         JP NZ, .noWest
 130+ CCE9 06 00            LD B, 0
 131+ CCEB 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 132+ CCEE C6 0A            ADD A, 10
