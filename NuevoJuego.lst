 462+ A3DA              ; ==============================================================================
 463+ A3DA              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 464+ A3DA              ; ==============================================================================
 465+ A3DA              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 466+ A3DA              ; ==============================================================================
 467+ A3DA              ProcessOneEnemy:
 468+ A3DA                  ; --- Dispatch segun estado ---
 469+ A3DA DD 7E 02         LD A, (IX+ENT_STATE)
 470+ A3DD FE 03            CP STATE_DYING
 471+ A3DF CA 51 A6         JP Z, .peDying
 472+ A3E2 FE 04            CP STATE_SPAWNING
 473+ A3E4 CA BA A6         JP Z, .peSpawning
 474+ A3E7 FE 05            CP STATE_SCARED
 475+ A3E9 CA 2E A5         JP Z, .peScared
 476+ A3EC FE 06            CP STATE_ATTACKING
 477+ A3EE CA 21 A5         JP Z, .peAttacking
 478+ A3F1
 479+ A3F1                  ; === STATE_RUNNING ===
 480+ A3F1                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 481+ A3F1 3A 35 B8         LD A, (ScareTimer)
 482+ A3F4 B7               OR A
 483+ A3F5 28 1E            JR Z, .peRunning
 484+ A3F7 DD 7E 01         LD A, (IX+ENT_TYPE)
 485+ A3FA FE 03            CP TYPE_NASTY
 486+ A3FC 28 08            JR Z, .peDoScare
 487+ A3FE FE 02            CP TYPE_MONSTER
 488+ A400 20 13            JR NZ, .peRunning
 489+ A402                  ; Monster: limpiar stun antes de asustar
 490+ A402 DD 36 0A 00      LD (IX+ENT_DIR), 0
 491+ A406              .peDoScare:
 492+ A406 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 493+ A40A DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 494+ A40E DD 36 07 00      LD (IX+ENT_DELTAY), 0
 495+ A412 C3 2E A5         JP .peScared
 496+ A415              .peRunning:
 497+ A415 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 498+ A419 C2 C5 A4         JP NZ, .peFresh
 499+ A41C
 500+ A41C                  ; --- Logica: AI + movimiento + animacion ---
 501+ A41C DD 7E 01         LD A, (IX+ENT_TYPE)
 502+ A41F FE 05            CP TYPE_DEATH
 503+ A421 28 14            JR Z, .peDeathAI
