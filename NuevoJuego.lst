2699+ B129 DD 7E 0A         LD A, (IX+ENT_DIR)
2700+ B12C FE 08            CP MONSTER_STUN_PAUSE + 2
2701+ B12E DA 62 B2         JP C, .moStunStop                   ; Casi sin stun → parar
2702+ B131 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2703+ B133 DD 77 0A         LD (IX+ENT_DIR), A
2704+ B136                  ; Aplicar movimiento reducido de A
2705+ B136 3A 88 B5         LD A, (.moSvX)
2706+ B139 DD 77 03         LD (IX+ENT_POSX), A
2707+ B13C 3A 89 B5         LD A, (.moSvY)
2708+ B13F DD 77 04         LD (IX+ENT_POSY), A
2709+ B142 C3 81 B1         JP .moKbApply
