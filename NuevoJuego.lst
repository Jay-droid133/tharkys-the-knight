 487+ F2DE                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 488+ F2DE                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 489+ F2DE                  ; Sprite_Compass_Magic (no oscila); el wobble logic solo gastaría CPU
 490+ F2DE                  ; durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 491+ F2DE                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 492+ F2DE                  ; cuando el frame de transición está apretado.
 493+ F2DE 3A C9 5F         LD A, (MagicCompassTimer)
 494+ F2E1 47               LD B, A
 495+ F2E2 3A CA 5F         LD A, (MagicCompassTimer + 1)
 496+ F2E5 B0               OR B
 497+ F2E6 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 498+ F2E8 AF               XOR A
 499+ F2E9 32 6D 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 500+ F2EC 18 53            JR .dcWobbleEnd
 501+ F2EE              .dcWobbleStartNormal:
 502+ F2EE                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 503+ F2EE                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 504+ F2EE                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 505+ F2EE                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 506+ F2EE                  ; nuevo idx.
 507+ F2EE                  ; Counter == 0 -> sin override, idx = target.
 508+ F2EE 3A CD F3         LD A, (.dcSpriteIdx)
 509+ F2F1 FE 04            CP 4
 510+ F2F3 20 06            JR NZ, .dcWobbleNotX
 511+ F2F5                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 512+ F2F5                  ; frame no redibuje innecesariamente.
 513+ F2F5 AF               XOR A
 514+ F2F6 32 6D 82         LD (CompassWobbleCounter), A
 515+ F2F9 18 46            JR .dcWobbleEnd
 516+ F2FB              .dcWobbleNotX:
 517+ F2FB                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 518+ F2FB 3A AE 82         LD A, (CurrentScreenX)
 519+ F2FE 47               LD B, A
 520+ F2FF 3A 6B 82         LD A, (LastCompassScreenX)
 521+ F302 B8               CP B
 522+ F303 20 0A            JR NZ, .dcWobbleStart
 523+ F305 3A AF 82         LD A, (CurrentScreenY)
 524+ F308 47               LD B, A
 525+ F309 3A 6C 82         LD A, (LastCompassScreenY)
 526+ F30C B8               CP B
 527+ F30D 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 528+ F30F              .dcWobbleStart:
 529+ F30F 3E 09            LD A, 9
 530+ F311 32 6D 82         LD (CompassWobbleCounter), A
 531+ F314              .dcWobbleResolve:
 532+ F314 3A 6D 82         LD A, (CompassWobbleCounter)
 533+ F317 B7               OR A
 534+ F318 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 535+ F31A 3D               DEC A
 536+ F31B 32 6D 82         LD (CompassWobbleCounter), A
 537+ F31E                                                      ; A = phase 0..8 (1 frame por fase)
 538+ F31E 21 26 F8         LD HL, WobblePhaseTable
 539+ F321 5F               LD E, A
 540+ F322 16 00            LD D, 0
 541+ F324 19               ADD HL, DE
 542+ F325 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 543+ F326 FE 02            CP 2
 544+ F328 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 545+ F32A                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 546+ F32A                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 547+ F32A FE 03            CP 3
 548+ F32C 38 01            JR C, .dcWobbleOffsetReady
 549+ F32E 3D               DEC A
 550+ F32F              .dcWobbleOffsetReady:
 551+ F32F 5F               LD E, A
 552+ F330 3A CD F3         LD A, (.dcSpriteIdx)
 553+ F333 87               ADD A, A                            ; idx*2
 554+ F334 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 555+ F335 83               ADD A, E                            ; +offset
 556+ F336 21 02 F8         LD HL, CompassWobbleTable
 557+ F339 5F               LD E, A
 558+ F33A 16 00            LD D, 0
 559+ F33C 19               ADD HL, DE
 560+ F33D 7E               LD A, (HL)
 561+ F33E 32 CD F3         LD (.dcSpriteIdx), A                ; override
