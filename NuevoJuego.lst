 301+ E555              ; ==============================================================================
 302+ E555              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E555              ; ==============================================================================
 304+ E555              ; Entrada: A = attr original
 305+ E555              ; Salida:  A = attr transformado
 306+ E555              ; Preserva: HL, DE, BC, IX
 307+ E555              ; ==============================================================================
 308+ E555              ApplyDayCycleRemap:
 309+ E555 E5               PUSH HL
 310+ E556 67               LD H, A                     ; H = attr (temp save)
 311+ E557                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E557 3A F0 E3         LD A, (BgSpriteSkipRemap)
 313+ E55A B7               OR A
 314+ E55B 20 06            JR NZ, .skipRemap
 315+ E55D 3A EA E3         LD A, (CurrentTimeOfDay)
 316+ E560 B7               OR A
 317+ E561 20 03            JR NZ, .doRemap
 318+ E563              .skipRemap:
 319+ E563 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E564 E1               POP HL
 321+ E565 C9               RET
 322+ E566
 323+ E566              .doRemap:
 324+ E566 D5               PUSH DE
 325+ E567 C5               PUSH BC
 326+ E568
 327+ E568 7C               LD A, H                     ; A = attr original
 328+ E569 4F               LD C, A                     ; C = attr original
 329+ E56A
 330+ E56A                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E56A E6 87            AND $87                     ; A = F000_0III
 332+ E56C 47               LD B, A                     ; B = flash | ink
 333+ E56D
 334+ E56D                  ; Extraer paper+bright como indice 0-15
 335+ E56D 79               LD A, C
 336+ E56E E6 78            AND $78                     ; A = 0BPPP000
 337+ E570 0F               RRCA
 338+ E571 0F               RRCA
 339+ E572 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E573
 341+ E573                  ; Elegir tabla segun tipo de sprite
 342+ E573 5F               LD E, A
 343+ E574 16 00            LD D, 0
 344+ E576 3A EF E3         LD A, (BgSpriteIsHouse)
 345+ E579 B7               OR A
 346+ E57A 28 05            JR Z, .useStdTable
 347+ E57C 2A ED E3         LD HL, (CurrentHouseRemapTable)
 348+ E57F 18 03            JR .doLookup
 349+ E581              .useStdTable:
 350+ E581 2A EB E3         LD HL, (CurrentRemapTable)
 351+ E584              .doLookup:
 352+ E584 19               ADD HL, DE
 353+ E585 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E586
 355+ E586                  ; Reconstruir atributo
 356+ E586 07               RLCA
 357+ E587 07               RLCA
 358+ E588 07               RLCA                        ; A = 0BPPP000
 359+ E589 B0               OR B                        ; A = FBPPPIII
 360+ E58A
 361+ E58A C1               POP BC
 362+ E58B D1               POP DE
 363+ E58C E1               POP HL
 364+ E58D C9               RET
 365+ E58E
 366+ E58E              ; ==============================================================================
 367+ E58E              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E58E              ; ==============================================================================
 369+ E58E              ; Entrada: A = sprite ID
 370+ E58E              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E58E              ; Preserva: A, DE, IX
 372+ E58E              ;
 373+ E58E              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E58E              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E58E              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E58E              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E58E              ; ==============================================================================
 378+ E58E              CheckIfHouseSprite:
 379+ E58E F5               PUSH AF
 380+ E58F E5               PUSH HL
 381+ E590 C5               PUSH BC
 382+ E591
 383+ E591 47               LD B, A                     ; B = id buscado
 384+ E592
 385+ E592 AF               XOR A
 386+ E593 32 EF E3         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E596
 388+ E596 21 A7 E0         LD HL, HouseIdList
 389+ E599              .checkLoop:
 390+ E599 7E               LD A, (HL)
 391+ E59A FE FF            CP $FF
 392+ E59C 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E59E B8               CP B
 394+ E59F 28 03            JR Z, .checkFound
 395+ E5A1 23               INC HL
 396+ E5A2 18 F5            JR .checkLoop
 397+ E5A4
 398+ E5A4              .checkFound:
 399+ E5A4 3E 01            LD A, 1
 400+ E5A6 32 EF E3         LD (BgSpriteIsHouse), A
 401+ E5A9
 402+ E5A9              .checkDone:
 403+ E5A9 C1               POP BC
 404+ E5AA E1               POP HL
 405+ E5AB F1               POP AF
 406+ E5AC C9               RET
 407+ E5AD
 408+ E5AD              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E5AD              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E5AD              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E5AD
 412+ E5AD              ; ==============================================================================
 413+ E5AD              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 414+ E5AD              ; ==============================================================================
 415+ E5AD              ; Formato: XX,YY:NN nombre_room     DY
 416+ E5AD              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 417+ E5AD              ; ==============================================================================
 418+ E5AD              DrawRoomInfo:
 419+ E5AD                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E5AD 1E 00            LD E, 0
 421+ E5AF 06 0D            LD B, 13
 422+ E5B1              .clearLoop:
 423+ E5B1 C5               PUSH BC
 424+ E5B2 D5               PUSH DE
 425+ E5B3 3E 20            LD A, ' '
 426+ E5B5 CD 68 E7         CALL DrawHudChar
 427+ E5B8 D1               POP DE
 428+ E5B9 C1               POP BC
 429+ E5BA 1C               INC E
 430+ E5BB 10 F4            DJNZ .clearLoop
 431+ E5BD
 432+ E5BD                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 433+ E5BD 3A 10 83         LD A, (CurrentScreenX)
 434+ E5C0 1E 00            LD E, 0
 435+ E5C2 CD 20 E6         CALL .drawDec2
 436+ E5C5
 437+ E5C5                  ; --- ',' en col 2 ---
 438+ E5C5 3E 2C            LD A, ','
 439+ E5C7 1E 02            LD E, 2
 440+ E5C9 CD 68 E7         CALL DrawHudChar
 441+ E5CC
 442+ E5CC                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E5CC 3A 11 83         LD A, (CurrentScreenY)
 444+ E5CF 1E 03            LD E, 3
 445+ E5D1 CD 20 E6         CALL .drawDec2
 446+ E5D4
 447+ E5D4                  ; --- ':' en col 5 ---
 448+ E5D4 3E 3A            LD A, ':'
 449+ E5D6 1E 05            LD E, 5
 450+ E5D8 CD 68 E7         CALL DrawHudChar
 451+ E5DB
 452+ E5DB                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E5DB 3A 11 83         LD A, (CurrentScreenY)
 454+ E5DE 6F               LD L, A
 455+ E5DF 26 00            LD H, 0
 456+ E5E1 29               ADD HL, HL
 457+ E5E2 29               ADD HL, HL
 458+ E5E3 29               ADD HL, HL
 459+ E5E4 29               ADD HL, HL                  ; HL = Y * 16
 460+ E5E5 3A 10 83         LD A, (CurrentScreenX)
 461+ E5E8 5F               LD E, A
 462+ E5E9 16 00            LD D, 0
 463+ E5EB 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E5EC 11 2B DE         LD DE, MapTable
 465+ E5EF 19               ADD HL, DE
 466+ E5F0 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E5F1 F5               PUSH AF                     ; guardar room index
 468+ E5F2
 469+ E5F2                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E5F2 F5               PUSH AF
 471+ E5F3 0F               RRCA
 472+ E5F4 0F               RRCA
 473+ E5F5 0F               RRCA
 474+ E5F6 0F               RRCA
 475+ E5F7 E6 0F            AND $0F
 476+ E5F9 CD 3E E6         CALL .hexToAscii
 477+ E5FC 1E 06            LD E, 6
 478+ E5FE CD 68 E7         CALL DrawHudChar
 479+ E601 F1               POP AF
 480+ E602 E6 0F            AND $0F
 481+ E604 CD 3E E6         CALL .hexToAscii
 482+ E607 1E 07            LD E, 7
 483+ E609 CD 68 E7         CALL DrawHudChar
 484+ E60C
 485+ E60C                  ; --- Espacio en col 8 ---
 486+ E60C 3E 20            LD A, ' '
 487+ E60E 1E 08            LD E, 8
 488+ E610 CD 68 E7         CALL DrawHudChar
 489+ E613
 490+ E613                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E613 F1               POP AF                      ; A = room index (descartar)
 492+ E614
 493+ E614                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E614 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E617 3E 47            LD A, $47                   ; bright white on black
 496+ E619 06 0D            LD B, 13
 497+ E61B              .attrLoop:
 498+ E61B 77               LD (HL), A
 499+ E61C 23               INC HL
 500+ E61D 10 FC            DJNZ .attrLoop
 501+ E61F C9               RET
 502+ E620
 503+ E620              ; --- Helpers ---
 504+ E620              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E620              .drawDec2:
 506+ E620 4B               LD C, E                     ; guardar columna inicial
 507+ E621 06 00            LD B, 0                     ; decenas
 508+ E623              .divLoop:
 509+ E623 FE 0A            CP 10
 510+ E625 38 05            JR C, .divDone
 511+ E627 D6 0A            SUB 10
 512+ E629 04               INC B
 513+ E62A 18 F7            JR .divLoop
 514+ E62C              .divDone:
 515+ E62C                  ; B = decenas, A = unidades
 516+ E62C F5               PUSH AF                     ; guardar unidades
 517+ E62D 78               LD A, B
 518+ E62E C6 30            ADD A, '0'
 519+ E630 59               LD E, C
 520+ E631 C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E632 CD 68 E7         CALL DrawHudChar
 522+ E635 C1               POP BC                      ; restaurar C
 523+ E636 F1               POP AF
 524+ E637 C6 30            ADD A, '0'
 525+ E639 59               LD E, C
 526+ E63A 1C               INC E
 527+ E63B C3 68 E7         JP DrawHudChar              ; tail call
 528+ E63E
 529+ E63E              .hexToAscii:
 530+ E63E FE 0A            CP 10
 531+ E640 38 03            JR C, .isDigit
 532+ E642 C6 37            ADD A, 'A' - 10
 533+ E644 C9               RET
 534+ E645              .isDigit:
 535+ E645 C6 30            ADD A, '0'
 536+ E647 C9               RET
