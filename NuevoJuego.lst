1324+ D089                  ; Resolver id -> (ptr, bank) via BgGfxPtrById (formato 3B: ptr + bank)
1325+ D089 E5               PUSH HL
1326+ D08A 6F               LD L, A
1327+ D08B 26 00            LD H, 0
1328+ D08D 54               LD D, H
1329+ D08E 5D               LD E, L                     ; DE = id
1330+ D08F 29               ADD HL, HL                  ; HL = id*2
1331+ D090 19               ADD HL, DE                  ; HL = id*3
1332+ D091 11 93 DA         LD DE, BgGfxPtrById
1333+ D094 19               ADD HL, DE
1334+ D095 5E               LD E, (HL)
1335+ D096 23               INC HL
1336+ D097 56               LD D, (HL)                  ; DE = ptr al sprite data
1337+ D098 23               INC HL
1338+ D099 7E               LD A, (HL)                  ; A = bank
1339+ D09A 32 9C CE         LD (CurrentBgSpriteBank), A
1340+ D09D E1               POP HL
1341+ D09E
1342+ D09E 46               LD B, (HL)                  ; B = x_char
1343+ D09F 23               INC HL
1344+ D0A0 4E               LD C, (HL)                  ; C = y_char
1345+ D0A1 23               INC HL
1346+ D0A2 23               INC HL                      ; skip tint variant byte
1347+ D0A3 E5               PUSH HL                     ; Guardar puntero room data
1348+ D0A4 C5               PUSH BC                     ; Guardar x_char, y_char
1349+ D0A5
1350+ D0A5                  ; Cargar sprite al buffer (bank variable) para leer sus dimensiones
