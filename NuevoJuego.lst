 699+ 63C8              TownGateAllNastiesDeadCheck:
 700+ 63C8 DD 21 AF 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 701+ 63CC 06 04            LD B, NUM_NASTIES
 702+ 63CE              .tgandcLoop:
 703+ 63CE DD 7E 01         LD A, (IX+ENT_TYPE)
