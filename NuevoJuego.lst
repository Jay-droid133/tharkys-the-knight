1351+ A9AB                  ; === Comun: iniciar ataque ===
1352+ A9AB                  ; AttackTimer ya viene cargado con ATTACK_SWING_FRAMES (valor base).
1353+ A9AB                  ; Recalculamos usando el delay boosteado real para que la animacion
1354+ A9AB                  ; no wrappee: timer = ANIM_FRAMES_FIGHT * delay_boosteado.
1355+ A9AB              .startAttack:
1356+ A9AB AF               XOR A
1357+ A9AC 32 75 B6         LD (MonsterHitThisAttack), A
1358+ A9AF 32 76 B6         LD (MonsterHitThisAttack+1), A
1359+ A9B2 32 77 B6         LD (MonsterHitThisAttack+2), A
1360+ A9B5
1361+ A9B5                  ; Timer = ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT (fijo, 25fps constante)
1362+ A9B5 3E 05            LD A, ANIM_FRAMES_FIGHT * ANIM_DELAY_FIGHT
1363+ A9B7 32 66 B6         LD (AttackTimer), A
1364+ A9BA
1365+ A9BA                  ; Marcar que el SFX de este ciclo aun no sono
1366+ A9BA                  ; (evita doble: newAnimSfx + wrapSfx en el mismo ciclo)
1367+ A9BA AF               XOR A
1368+ A9BB 32 69 B6         LD (AttackSfxPlayed), A
1369+ A9BE
1370+ A9BE DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
