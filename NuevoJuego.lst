 385+ DEAC
 386+ DEAC              ; ==============================================================================
 387+ DEAC              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 388+ DEAC              ; ==============================================================================
 389+ DEAC              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 390+ DEAC              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 391+ DEAC              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 392+ DEAC              ; resuelve KillAllActiveNasties de StartBankCutscene).
 393+ DEAC              ; Destruye: AF, BC, DE, HL, IX.
 394+ DEAC              ; ==============================================================================
 395+ DEAC              UpdateBankCutsceneBody:
 396+ DEAC 3A C2 82         LD A, (BankCutscenePhase)
 397+ DEAF FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 398+ DEB1 CA 04 DF         JP Z, .bcPhWaitNasties
 399+ DEB4 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 400+ DEB6 CA 0E E1         JP Z, .bcPhDoorClosed
 401+ DEB9 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 402+ DEBB                                                      ;   clink + consume cheque + erase mano + cierra puerta
 403+ DEBB CA 35 E0         JP Z, .bcPhHandOpenIn
 404+ DEBE FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 405+ DEC0 CA 94 E0         JP Z, .bcPhHandOpenOut
 406+ DEC3 3D               DEC A
 407+ DEC4 CA 1E DF         JP Z, .bcPhLock
 408+ DEC7 3D               DEC A
 409+ DEC8 CA 3C DF         JP Z, .bcPhKnocks1
 410+ DECB 3D               DEC A
 411+ DECC CA 51 DF         JP Z, .bcPhWait1
 412+ DECF 3D               DEC A
 413+ DED0 CA 72 DF         JP Z, .bcPhKnocks2
 414+ DED3 3D               DEC A
 415+ DED4 CA 87 DF         JP Z, .bcPhWait2
 416+ DED7 3D               DEC A
 417+ DED8 CA A9 DF         JP Z, .bcPhTurnToCam
 418+ DEDB 3D               DEC A
 419+ DEDC CA CD DF         JP Z, .bcPhTurnToDoor
 420+ DEDF 3D               DEC A
 421+ DEE0 CA EF DF         JP Z, .bcPhKnocks3
 422+ DEE3 3D               DEC A
 423+ DEE4 CA 04 E0         JP Z, .bcPhWait3
 424+ DEE7 3D               DEC A
 425+ DEE8 CA 16 E0         JP Z, .bcPhPreHand
 426+ DEEB 3D               DEC A
 427+ DEEC CA B3 E0         JP Z, .bcPhHandIn
 428+ DEEF 3D               DEC A
 429+ DEF0 CA C2 E0         JP Z, .bcPhHandNoNo
 430+ DEF3 3D               DEC A
 431+ DEF4 CA F3 E0         JP Z, .bcPhHandOut
 432+ DEF7 3D               DEC A
 433+ DEF8 CA 2E E1         JP Z, .bcPhKeyDrop
 434+ DEFB 3D               DEC A
 435+ DEFC CA 53 E1         JP Z, .bcPhPlayerTurnCam
 436+ DEFF                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 437+ DEFF AF               XOR A
 438+ DF00 32 C2 82         LD (BankCutscenePhase), A
 439+ DF03 C9               RET
