 176+ DDAF              .notPressed:
 177+ DDAF AF               XOR A
 178+ DDB0 32 08 DD         LD (DebugKeyDebounce), A
 179+ DDB3
 180+ DDB3                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 181+ DDB3 3E FD            LD A, $FD
 182+ DDB5 DB FE            IN A, ($FE)
 183+ DDB7 4F               LD C, A                 ; C = estado semi-fila $FDFE
 184+ DDB8 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 185+ DDBA 20 13            JR NZ, .sNotPressed
 186+ DDBC 3A 0A DE         LD A, (SpeedKeyDebounce)
 187+ DDBF B7               OR A
 188+ DDC0 C0               RET NZ
 189+ DDC1 3E 01            LD A, 1
 190+ DDC3 32 0A DE         LD (SpeedKeyDebounce), A
 191+ DDC6 21 06 BD         LD HL, DayCycleCount
 192+ DDC9 7E               LD A, (HL)
 193+ DDCA FE 0A            CP 10
 194+ DDCC D0               RET NC                  ; Ya en maximo
 195+ DDCD 34               INC (HL)
 196+ DDCE C9               RET
 197+ DDCF              .sNotPressed:
 198+ DDCF                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 199+ DDCF CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 200+ DDD1 20 13            JR NZ, .dNotPressed
 201+ DDD3 3A 0A DE         LD A, (SpeedKeyDebounce)
 202+ DDD6 B7               OR A
 203+ DDD7 C0               RET NZ
 204+ DDD8 3E 01            LD A, 1
 205+ DDDA 32 0A DE         LD (SpeedKeyDebounce), A
 206+ DDDD 21 06 BD         LD HL, DayCycleCount
