4633+ BBF4 20 0C            JR NZ, .spawnDirOk
4634+ BBF6                  ; Coincide -> voltear DELTAY (negar)
4635+ BBF6 DD 7E 07         LD A, (IX+ENT_DELTAY)
4636+ BBF9 ED 44            NEG
4637+ BBFB DD 77 07         LD (IX+ENT_DELTAY), A
4638+ BBFE 78               LD A, B
4639+ BBFF EE 40            XOR $40                             ; recalcular signs cacheados
4640+ BC01 47               LD B, A
4641+ BC02              .spawnDirOk:
4642+ BC02 78               LD A, B
4643+ BC03 32 45 82         LD (LastSpawnDirSigns), A
4644+ BC06
4645+ BC06                  ; Inicializar old pos = pos actual
4646+ BC06 DD 7E 03         LD A, (IX+ENT_POSX)
4647+ BC09 DD 77 0C         LD (IX+ENT_OLDX), A
4648+ BC0C DD 77 0F         LD (IX+ENT_DRAWX), A
4649+ BC0F DD 7E 04         LD A, (IX+ENT_POSY)
4650+ BC12 DD 77 0D         LD (IX+ENT_OLDY), A
4651+ BC15 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4652+ BC18 DD 77 0E         LD (IX+ENT_OLDSPRID), A
4653+ BC1B                  ; SFX de spawn
4654+ BC1B 21 C2 F9         LD HL, SFX_EnemySpawn
4655+ BC1E CD 18 F9         CALL PlaySFX
4656+ BC21 C9               RET
4657+ BC22
4658+ BC22              ; ==============================================================================
4659+ BC22              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4660+ BC22              ; ==============================================================================
4661+ BC22              UpdateEnemySpeed:
4662+ BC22 3A 06 BD         LD A, (DayCycleCount)
4663+ BC25 3D               DEC A                               ; 0-based index
4664+ BC26 FE 0A            CP 10
4665+ BC28 38 02            JR C, .uesOk
4666+ BC2A 3E 09            LD A, 9                             ; Cap en indice 9
4667+ BC2C              .uesOk:
4668+ BC2C F5               PUSH AF                             ; Guardar indice para tabla de anim
4669+ BC2D 21 50 BC         LD HL, EnemySpeedTable
4670+ BC30 5F               LD E, A
4671+ BC31 16 00            LD D, 0
4672+ BC33 19               ADD HL, DE
4673+ BC34 7E               LD A, (HL)                          ; A = velocidad × 2
4674+ BC35                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4675+ BC35 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4676+ BC37 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4677+ BC39                  ; Hay fraccion .5: alternar +1 en frames impares
4678+ BC39 47               LD B, A                             ; B = parte entera
4679+ BC3A 3A 11 81         LD A, (GameFrameCounter)
4680+ BC3D E6 01            AND 1                               ; 0 en par, 1 en impar
4681+ BC3F 80               ADD A, B                            ; Sumar 0 o 1
4682+ BC40              .uesNoFrac:
4683+ BC40 32 62 90         LD (CurrentEnemySpeed), A
4684+ BC43                  ; Leer delay de animacion para este ciclo
4685+ BC43 F1               POP AF                              ; A = indice 0-based
4686+ BC44 21 5A BC         LD HL, EnemyAnimDelayTable
4687+ BC47 5F               LD E, A
4688+ BC48 16 00            LD D, 0
4689+ BC4A 19               ADD HL, DE
4690+ BC4B 7E               LD A, (HL)
4691+ BC4C 32 63 90         LD (CurrentEnemyAnimDelay), A
4692+ BC4F C9               RET
4693+ BC50
4694+ BC50              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4695+ BC50              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4696+ BC50              EnemySpeedTable:
4697+ BC50 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4698+ BC51 05               DEFB 5                              ; Ciclo 2: 2.5px
4699+ BC52 06               DEFB 6                              ; Ciclo 3: 3px
4700+ BC53 07               DEFB 7                              ; Ciclo 4: 3.5px
4701+ BC54 08               DEFB 8                              ; Ciclo 5: 4px
4702+ BC55 09               DEFB 9                              ; Ciclo 6: 4.5px
4703+ BC56 0A               DEFB 10                             ; Ciclo 7: 5px
4704+ BC57 0B               DEFB 11                             ; Ciclo 8: 5.5px
4705+ BC58 0C               DEFB 12                             ; Ciclo 9: 6px
4706+ BC59 0E               DEFB 14                             ; Ciclo 10: 7px
4707+ BC5A
4708+ BC5A              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4709+ BC5A              ; La rata usara la mitad de estos valores
4710+ BC5A              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4711+ BC5A 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4712+ BC5B 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4713+ BC5C 03               DEFB 3                              ; Ciclo 3 (era 6)
4714+ BC5D 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4715+ BC5E 02               DEFB 2                              ; Ciclo 5 (era 4)
4716+ BC5F 02               DEFB 2                              ; Ciclo 6 (era 4)
4717+ BC60 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4718+ BC61 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4719+ BC62 01               DEFB 1                              ; Ciclo 9 (era 2)
4720+ BC63 01               DEFB 1                              ; Ciclo 10 (era 2)
