5725+ BF7E 18 02            JR .kbSetY
5726+ BF80              .kbPosUp:
5727+ BF80 3E FC            LD A, -MONSTER_KB_SPEED         ; Monster arriba → empujar arriba
5728+ BF82              .kbSetY:
5729+ BF82 DD 77 07         LD (IX+ENT_DELTAY), A
5730+ BF85                  ; Iniciar stun timer (usa ENT_DIR como contador)
5731+ BF85 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_TOTAL
5732+ BF89                  ; SFX de golpe al monster
5733+ BF89 DD E5            PUSH IX
5734+ BF8B C5               PUSH BC
