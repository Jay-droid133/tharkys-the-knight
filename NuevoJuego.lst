 486+ E7B8 3E 01            LD A, 1
 487+ E7BA 32 A9 5F         LD (TownGateExitWalkFrame), A
 488+ E7BD CD 57 6D         CALL TownGateRedrawPlayer_B7           ; turn IDLE → WALK_S + paint attrs anchor1
 489+ E7C0 DD 21 A3 81      LD IX, EntityTable
 490+ E7C4 DD 56 0D         LD D, (IX+ENT_OLDY)                 ; anchor1 Y (= POSY tras redraw)
 491+ E7C7 DD 5E 0C         LD E, (IX+ENT_OLDX)
 492+ E7CA CD 8D 6D         CALL RestoreOldAttr_B7                 ; clear player attrs en anchor1
