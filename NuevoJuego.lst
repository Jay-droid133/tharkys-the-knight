 459  CC4C                  INCLUDE "screen_system.asm"
# file opened: code/screen_system.asm
   1+ CC4C              ; ==============================================================================
   2+ CC4C              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CC4C              ; ==============================================================================
   4+ CC4C              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CC4C              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CC4C              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CC4C              ; ==============================================================================
   8+ CC4C
   9+ CC4C              ; ==============================================================================
  10+ CC4C              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CC4C              ; ==============================================================================
  12+ CC4C              InitScreenSystem:
  13+ CC4C 3E 08            LD A, START_SCREEN_X
  14+ CC4E 32 0B 83         LD (CurrentScreenX), A
  15+ CC51 3E 09            LD A, START_SCREEN_Y
  16+ CC53 32 0C 83         LD (CurrentScreenY), A
  17+ CC56 3E 01            LD A, 1
  18+ CC58 32 13 83         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CC5B AF               XOR A
  20+ CC5C 32 0F 83         LD (ScreenTransition), A
  21+ CC5F CD 63 CC         CALL CalcScreenAddress
  22+ CC62 C9               RET
  23+ CC63
  24+ CC63              ; ==============================================================================
  25+ CC63              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CC63              ; ==============================================================================
  27+ CC63              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CC63              ; ==============================================================================
  29+ CC63              CalcScreenAddress:
  30+ CC63 3A 0C 83         LD A, (CurrentScreenY)
  31+ CC66 6F               LD L, A
  32+ CC67 26 00            LD H, 0
  33+ CC69 29               ADD HL, HL                  ; x2
  34+ CC6A 29               ADD HL, HL                  ; x4
  35+ CC6B 29               ADD HL, HL                  ; x8
  36+ CC6C 29               ADD HL, HL                  ; x16
  37+ CC6D 3A 0B 83         LD A, (CurrentScreenX)
  38+ CC70 5F               LD E, A
  39+ CC71 16 00            LD D, 0
  40+ CC73 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CC74 11 40 DD         LD DE, MapTable
  42+ CC77 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CC78 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CC79                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CC79 6F               LD L, A
  46+ CC7A 26 00            LD H, 0
  47+ CC7C 29               ADD HL, HL                  ; index * 2
  48+ CC7D 11 0E DC         LD DE, RoomTable
  49+ CC80 19               ADD HL, DE
  50+ CC81 5E               LD E, (HL)
  51+ CC82 23               INC HL
  52+ CC83 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CC84                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CC84 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CC85 CD 72 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CC88                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CC88 11 F8 85         LD DE, CurrentScreenBuffer
  58+ CC8B ED 53 0D 83      LD (CurrentScreenAddr), DE
  59+ CC8F C9               RET
  60+ CC90
  61+ CC90              ; ==============================================================================
  62+ CC90              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CC90              ; ==============================================================================
  64+ CC90              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CC90              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CC90              ; por estar atrapado cerca del borde.
  67+ CC90              ; ==============================================================================
  68+ CC90              CheckScreenTransition:
  69+ CC90 AF               XOR A
  70+ CC91 32 0F 83         LD (ScreenTransition), A
  71+ CC94
  72+ CC94                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CC94                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CC94                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CC94                  ; dispararia transicion sur en plena animacion.
  76+ CC94 3A CB 82         LD A, (TownGatePhase)
  77+ CC97 B7               OR A
  78+ CC98 C0               RET NZ
  79+ CC99
  80+ CC99                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CC99                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CC99                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CC99                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CC99                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CC99                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CC99 3A B6 82         LD A, (TimeFrozen)
  87+ CC9C B7               OR A
  88+ CC9D 28 23            JR Z, .cstNotFrozen
  89+ CC9F 3A AE 82         LD A, (InputDirection)
  90+ CCA2 CB 4F            BIT 1, A                    ; S
  91+ CCA4 28 17            JR Z, .cstClearBlockFlag
  92+ CCA6 3A A2 81         LD A, (EntityTable + ENT_POSY)
  93+ CCA9 FE A8            CP SCREEN_MAX_Y
  94+ CCAB 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CCAD                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CCAD 3A B7 82         LD A, (BlockedExitSoundFlag)
  97+ CCB0 B7               OR A
  98+ CCB1 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CCB2 3E 01            LD A, 1
 100+ CCB4 32 B7 82         LD (BlockedExitSoundFlag), A
 101+ CCB7 21 66 F7         LD HL, SFX_BlockedExit
 102+ CCBA C3 42 F6         JP PlaySFX                  ; tail call
 103+ CCBD              .cstClearBlockFlag:
 104+ CCBD AF               XOR A
 105+ CCBE 32 B7 82         LD (BlockedExitSoundFlag), A
 106+ CCC1 C9               RET
 107+ CCC2              .cstNotFrozen:
 108+ CCC2                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ CCC2 AF               XOR A
 110+ CCC3 32 B7 82         LD (BlockedExitSoundFlag), A
 111+ CCC6
 112+ CCC6 3A AE 82         LD A, (InputDirection)
 113+ CCC9 57               LD D, A                     ; D = input direction (bits 0-3: N S E W)
 114+ CCCA
 115+ CCCA                  ; --- Comprobar borde OESTE (solo si pulsa W) ---
 116+ CCCA CB 5A            BIT 3, D                    ; W
 117+ CCCC CA 2D CD         JP Z, .noWest
 118+ CCCF 3A A1 81         LD A, (EntityTable + ENT_POSX)
 119+ CCD2 FE 04            CP TRANSITION_ZONE
 120+ CCD4 D2 2D CD         JP NC, .noWest
 121+ CCD7 3A 0B 83         LD A, (CurrentScreenX)
 122+ CCDA B7               OR A
 123+ CCDB CA 2D CD         JP Z, .noWest
 124+ CCDE                  ; Check collision at col 0 (top + mid + bottom del player)
 125+ CCDE 06 00            LD B, 0
 126+ CCE0 3A A2 81         LD A, (EntityTable + ENT_POSY)
 127+ CCE3 4F               LD C, A
 128+ CCE4 CD 0C D5         CALL IsPointBlocked
 129+ CCE7 C2 2D CD         JP NZ, .noWest
 130+ CCEA 06 00            LD B, 0
 131+ CCEC 3A A2 81         LD A, (EntityTable + ENT_POSY)
 132+ CCEF C6 0A            ADD A, 10
 133+ CCF1 4F               LD C, A
 134+ CCF2 CD 0C D5         CALL IsPointBlocked
 135+ CCF5 C2 2D CD         JP NZ, .noWest
 136+ CCF8 06 00            LD B, 0
 137+ CCFA 3A A2 81         LD A, (EntityTable + ENT_POSY)
 138+ CCFD C6 14            ADD A, 20
 139+ CCFF 4F               LD C, A
 140+ CD00 CD 0C D5         CALL IsPointBlocked
 141+ CD03 C2 2D CD         JP NZ, .noWest
 142+ CD06 3A 0B 83         LD A, (CurrentScreenX)
 143+ CD09 3D               DEC A
 144+ CD0A 32 0B 83         LD (CurrentScreenX), A
 145+ CD0D 3E 08            LD A, DIR_W
 146+ CD0F 32 0F 83         LD (ScreenTransition), A
 147+ CD12 3E 03            LD A, 3                             ; entró por E (cruzó W) → side 3 = E
 148+ CD14 32 C9 5F         LD (LastEntrySide), A
 149+ CD17                  ; LastEntryCoord = (POSY - 16) / 8 (charY top-left aprox)
 150+ CD17 3A A2 81         LD A, (EntityTable + ENT_POSY)
 151+ CD1A D6 10            SUB 16
 152+ CD1C CB 3F            SRL A
 152+ CD1E CB 3F          SRL A
 152+ CD20 CB 3F          SRL A
 153+ CD22 32 CA 5F         LD (LastEntryCoord), A
 154+ CD25 3E E8            LD A, SCREEN_MAX_X
 155+ CD27 32 A1 81         LD (EntityTable + ENT_POSX), A
 156+ CD2A C3 54 CE         JP .doTransition
 157+ CD2D
 158+ CD2D              .noWest:
 159+ CD2D                  ; --- Comprobar borde ESTE (solo si pulsa E) ---
 160+ CD2D CB 52            BIT 2, D                    ; E
 161+ CD2F CA 91 CD         JP Z, .noEast
 162+ CD32 3A A1 81         LD A, (EntityTable + ENT_POSX)
