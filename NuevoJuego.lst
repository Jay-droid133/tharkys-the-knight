4925+ BD7F              ; ==============================================================================
4926+ BD7F              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4927+ BD7F              ; ==============================================================================
4928+ BD7F              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4929+ BD7F              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4930+ BD7F              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4931+ BD7F              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4932+ BD7F              ; deja la posicion original (puff puede asomar levemente, raro).
4933+ BD7F              ; IN:  IX = nasty entity.
4934+ BD7F              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4935+ BD7F              ; Destruye: AF, BC, DE, HL.
4936+ BD7F              ; ==============================================================================
4937+ BD7F              SnapPuffPos:
4938+ BD7F DD 7E 03         LD A, (IX+ENT_POSX)
4939+ BD82 32 F5 BD         LD (.sppOrigX), A
4940+ BD85 E6 F8            AND $F8
4941+ BD87 32 F7 BD         LD (.sppBaseX), A                   ; base char-aligned X
4942+ BD8A DD 7E 04         LD A, (IX+ENT_POSY)
4943+ BD8D 32 F6 BD         LD (.sppOrigY), A
4944+ BD90 E6 F8            AND $F8
4945+ BD92 32 F8 BD         LD (.sppBaseY), A                   ; base char-aligned Y
4946+ BD95
4947+ BD95                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4948+ BD95 CD C9 BD         CALL .sppCheckFit
4949+ BD98 C8               RET Z
4950+ BD99
4951+ BD99                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4952+ BD99                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4953+ BD99 21 F9 BD         LD HL, .sppShifts
4954+ BD9C              .sppLoop:
4955+ BD9C 7E               LD A, (HL)
4956+ BD9D 23               INC HL
4957+ BD9E 47               LD B, A                             ; dx (signed)
4958+ BD9F 7E               LD A, (HL)
4959+ BDA0 23               INC HL
4960+ BDA1 FE 80            CP $80
4961+ BDA3 28 17            JR Z, .sppFail                      ; sentinel
4962+ BDA5 4F               LD C, A                             ; dy (signed)
4963+ BDA6
4964+ BDA6 3A F7 BD         LD A, (.sppBaseX)
4965+ BDA9 80               ADD A, B
4966+ BDAA DD 77 03         LD (IX+ENT_POSX), A
4967+ BDAD 3A F8 BD         LD A, (.sppBaseY)
4968+ BDB0 81               ADD A, C
