 797+ 6F17 ~            ; ==============================================================================
 798+ 6F17 ~            ; .cmcpFindMatchingGap - Busca en sala A un gap (side=B, coord=C)
 799+ 6F17 ~            ; ==============================================================================
 800+ 6F17 ~            ; Devuelve la comp del gap matching (side AND coord). Permite resolver la
 801+ 6F17 ~            ; correspondencia gap-físico cuando hay múltiples gaps del mismo side en
 802+ 6F17 ~            ; comps distintas.
 803+ 6F17 ~            ; IN:  A = sid, B = coord, C = side
 804+ 6F17 ~            ; OUT: A = comp (0..2) si encontrado; $FF si no match.
 805+ 6F17 ~            ; Destruye: AF, BC, DE, HL.
 806+ 6F17 ~            ; ==============================================================================
 807+ 6F17 ~            .cmcpFindMatchingGap:
 808+ 6F17 ~                LD (.cfmgSid), A
 809+ 6F17 ~                LD A, B
 810+ 6F17 ~                LD (.cfmgCoord), A
 811+ 6F17 ~                LD A, C
 812+ 6F17 ~                LD (.cfmgSide), A
 813+ 6F17 ~                LD A, (.cfmgSid)
 814+ 6F17 ~                LD L, A
 815+ 6F17 ~                LD H, 0
 816+ 6F17 ~                ADD HL, HL
 817+ 6F17 ~                LD DE, RoomCompGapsTable
 818+ 6F17 ~                ADD HL, DE
 819+ 6F17 ~                LD E, (HL)
 820+ 6F17 ~                INC HL
 821+ 6F17 ~                LD D, (HL)
 822+ 6F17 ~                EX DE, HL                            ; HL = record
 823+ 6F17 ~                LD A, (HL)
 824+ 6F17 ~                OR A
 825+ 6F17 ~                JR Z, .cfmgNotFound
 826+ 6F17 ~                LD B, A
 827+ 6F17 ~                INC HL
 828+ 6F17 ~            .cfmgLoop:
 829+ 6F17 ~                LD A, (HL)                           ; side_comp
 830+ 6F17 ~                INC HL
 831+ 6F17 ~                LD C, (HL)                           ; coord
 832+ 6F17 ~                INC HL
 833+ 6F17 ~                LD D, A                              ; D = side_comp
 834+ 6F17 ~                AND $03                              ; side
 835+ 6F17 ~                LD E, A
 836+ 6F17 ~                LD A, (.cfmgSide)
 837+ 6F17 ~                CP E
 838+ 6F17 ~                JR NZ, .cfmgSkip
 839+ 6F17 ~                LD A, (.cfmgCoord)
 840+ 6F17 ~                CP C
 841+ 6F17 ~                JR NZ, .cfmgSkip
 842+ 6F17 ~                ; Match. Extract comp.
 843+ 6F17 ~                LD A, D
 844+ 6F17 ~                SRL A
 845+ 6F17 ~                SRL A
 846+ 6F17 ~                AND $03
 847+ 6F17 ~                RET
 848+ 6F17 ~            .cfmgSkip:
 849+ 6F17 ~                DJNZ .cfmgLoop
 850+ 6F17 ~            .cfmgNotFound:
 851+ 6F17 ~                LD A, $FF
 852+ 6F17 ~                RET
