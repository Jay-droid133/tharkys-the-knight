1112+ A841              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1113+ A841              ; ==============================================================================
1114+ A841              ; Entrada: A = SpriteID
1115+ A841              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1116+ A841              ; Destruye: A, DE, HL
1117+ A841              ; ==============================================================================
1118+ A841              GetSpriteDims:
1119+ A841                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1120+ A841                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1121+ A841 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1122+ A842 26 00            LD H, 0
1123+ A844 3A D4 90         LD A, (CurrentPaging)
1124+ A847 E6 F8            AND $F8
1125+ A849 F6 06            OR 6
1126+ A84B 32 D4 90         LD (CurrentPaging), A
1127+ A84E 01 FD 7F         LD BC, $7FFD
1128+ A851 ED 79            OUT (C), A                  ; bank 6 paginado
1129+ A853 29               ADD HL, HL
1130+ A854 11 D3 E7         LD DE, SpriteFrameTable
1131+ A857 19               ADD HL, DE
1132+ A858 5E               LD E, (HL)
1133+ A859 23               INC HL
1134+ A85A 56               LD D, (HL)                  ; DE = ptr al sprite data
1135+ A85B 1A               LD A, (DE)                  ; width_bytes
1136+ A85C 87               ADD A, A
1137+ A85D 87               ADD A, A
1138+ A85E 87               ADD A, A                    ; × 8 = width_px
1139+ A85F 47               LD B, A
1140+ A860 13               INC DE
1141+ A861 1A               LD A, (DE)                  ; height_px
1142+ A862 4F               LD C, A
1143+ A863                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1144+ A863 78               LD A, B
1145+ A864 32 81 A8         LD (GsdSavedB), A
1146+ A867 79               LD A, C
1147+ A868 32 82 A8         LD (GsdSavedC), A
1148+ A86B 3A D4 90         LD A, (CurrentPaging)
1149+ A86E E6 F8            AND $F8
1150+ A870 32 D4 90         LD (CurrentPaging), A
1151+ A873 01 FD 7F         LD BC, $7FFD
1152+ A876 ED 79            OUT (C), A                  ; bank 0 de vuelta
1153+ A878 3A 81 A8         LD A, (GsdSavedB)
1154+ A87B 47               LD B, A
1155+ A87C 3A 82 A8         LD A, (GsdSavedC)
1156+ A87F 4F               LD C, A
1157+ A880 C9               RET
1158+ A881
1159+ A881 00           GsdSavedB: DEFB 0
1160+ A882 00           GsdSavedC: DEFB 0
