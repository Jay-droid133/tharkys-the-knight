4903+ BD4E DD 7E 01         LD A, (IX+ENT_TYPE)
4904+ BD51 B7               OR A
4905+ BD52 28 26            JR Z, .kanSkip                  ; slot vacio
4906+ BD54 FE 03            CP TYPE_NASTY
4907+ BD56 20 22            JR NZ, .kanSkip                 ; no es nasty
4908+ BD58 DD 7E 02         LD A, (IX+ENT_STATE)
4909+ BD5B FE 03            CP STATE_DYING
4910+ BD5D 28 1B            JR Z, .kanSkip                  ; ya muriendo
4911+ BD5F                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4912+ BD5F                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4913+ BD5F                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4914+ BD5F                  ; del nasty: peDying paintea el rect del puff con ese color)
4915+ BD5F CD 83 BD         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4916+ BD62 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4917+ BD66 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4918+ BD6A DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4919+ BD6E DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4920+ BD72 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4921+ BD76 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4922+ BD7A              .kanSkip:
4923+ BD7A 11 10 00         LD DE, ENT_SIZE
4924+ BD7D DD 19            ADD IX, DE
4925+ BD7F C1               POP BC
4926+ BD80 10 CB            DJNZ .kanLoop
4927+ BD82 C9               RET
