7207+ C71E              ; ==============================================================================
7208+ C71E              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7209+ C71E              ; ==============================================================================
7210+ C71E              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7211+ C71E              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7212+ C71E              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7213+ C71E              ; el primer paso (N/S/W/E) desde el inicio.
7214+ C71E              ;
7215+ C71E              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7216+ C71E              ; consistente con CheckEnemyCollision en cell-aligned positions).
7217+ C71E              ;
7218+ C71E              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7219+ C71E              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7220+ C71E              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7221+ C71E              ; paso pero permite llegar a una celda mas profunda con dist menor).
7222+ C71E              ;
7223+ C71E              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7224+ C71E              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7225+ C71E              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7226+ C71E              ;
7227+ C71E              ; IX = SLOT_DEATH al entrar.
7228+ C71E              ; ==============================================================================
7229+ C71E              DeathBfsRescue:
7230+ C71E                  ; --- Celda inicial = celda actual de Death ---
7231+ C71E DD 7E 03         LD A, (IX+ENT_POSX)
7232+ C721 0F               RRCA
7233+ C722 0F               RRCA
7234+ C723 0F               RRCA
7235+ C724 E6 1F            AND $1F
7236+ C726 32 74 5F         LD (DBfsCurCx), A
7237+ C729 DD 7E 04         LD A, (IX+ENT_POSY)
7238+ C72C D6 10            SUB SCREEN_MIN_Y
7239+ C72E 0F               RRCA
7240+ C72F 0F               RRCA
7241+ C730 0F               RRCA
7242+ C731 E6 1F            AND $1F
7243+ C733 32 75 5F         LD (DBfsCurCy), A
7244+ C736                  ; --- Celda del player ---
7245+ C736 3A 97 81         LD A, (EntityTable + ENT_POSX)
7246+ C739 0F               RRCA
7247+ C73A 0F               RRCA
7248+ C73B 0F               RRCA
7249+ C73C E6 1F            AND $1F
7250+ C73E 32 72 5F         LD (DBfsPlayerCx), A
7251+ C741 3A 98 81         LD A, (EntityTable + ENT_POSY)
7252+ C744 D6 10            SUB SCREEN_MIN_Y
7253+ C746 0F               RRCA
7254+ C747 0F               RRCA
7255+ C748 0F               RRCA
7256+ C749 E6 1F            AND $1F
7257+ C74B 32 73 5F         LD (DBfsPlayerCy), A
7258+ C74E                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7259+ C74E 21 FF 5E         LD HL, DBfsQueue
7260+ C751 22 6B 5F         LD (DBfsQHead), HL
7261+ C754 3A 74 5F         LD A, (DBfsCurCx)
7262+ C757 77               LD (HL), A
7263+ C758 23               INC HL
