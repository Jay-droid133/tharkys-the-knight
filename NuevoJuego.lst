# file closed: monster_ai.asm
 481  9858                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 482  9858                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 483  9858                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9858              ; ==============================================================================
   2+ 9858              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9858              ; ==============================================================================
   4+ 9858              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9858              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9858              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9858              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9858              ;
   9+ 9858              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9858              ; fallo en el intento previo):
  11+ 9858              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9858              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9858              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9858              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9858              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9858              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9858              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9858              ;
  19+ 9858              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9858              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9858              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9858              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9858              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9858              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9858              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9858              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9858              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9858              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9858              ; ==============================================================================
  30+ 9858
  31+ 9858              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9858              AY_Init:
  33+ 9858 F3               DI
  34+ 9859 3A 82 8D         LD A, (CurrentPaging)
  35+ 985C E6 F8            AND $F8
  36+ 985E F6 04            OR 4
  37+ 9860 32 82 8D         LD (CurrentPaging), A
  38+ 9863 01 FD 7F         LD BC, $7FFD
  39+ 9866 ED 79            OUT (C), A
  40+ 9868 CD B9 E4         CALL AY_InitImpl
  41+ 986B 3A 82 8D         LD A, (CurrentPaging)
  42+ 986E E6 F8            AND $F8
  43+ 9870 32 82 8D         LD (CurrentPaging), A
  44+ 9873 01 FD 7F         LD BC, $7FFD
  45+ 9876 ED 79            OUT (C), A
  46+ 9878 3A 9A 81         LD A, (StartupComplete)
  47+ 987B B7               OR A
  48+ 987C C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 987D FB               EI
  50+ 987E C9               RET
