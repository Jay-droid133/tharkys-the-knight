4474+ B7B7              ; ==============================================================================
4475+ B7B7              ; CountActiveNasties / CountActiveMonsters
4476+ B7B7              ; ==============================================================================
4477+ B7B7              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4478+ B7B7              ; Ambas usan _CountSlots internamente.
4479+ B7B7              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4480+ B7B7              ; ==============================================================================
4481+ B7B7              CountActiveNasties:
4482+ B7B7 21 14 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4483+ B7BA 06 03            LD B, NUM_NASTIES
4484+ B7BC 18 05            JR _CountSlots
4485+ B7BE
4486+ B7BE              CountActiveMonsters:
4487+ B7BE 21 B4 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4488+ B7C1 06 06            LD B, NUM_MONSTERS
4489+ B7C3
4490+ B7C3              _CountSlots:
4491+ B7C3 0E 00            LD C, 0                         ; Contador
4492+ B7C5              .countLoop:
4493+ B7C5 7E               LD A, (HL)
4494+ B7C6 B7               OR A
4495+ B7C7 28 16            JR Z, .countNext                ; Slot vacio: no contar
4496+ B7C9                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4497+ B7C9 D5               PUSH DE
4498+ B7CA 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4499+ B7CD 19               ADD HL, DE
4500+ B7CE 7E               LD A, (HL)
4501+ B7CF ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4502+ B7D1 D1               POP DE
4503+ B7D2 FE 03            CP STATE_DYING
4504+ B7D4 28 09            JR Z, .countNext
4505+ B7D6 FE 04            CP STATE_SPAWNING
4506+ B7D8 28 05            JR Z, .countNext
4507+ B7DA FE 05            CP STATE_SCARED
4508+ B7DC 28 01            JR Z, .countNext
4509+ B7DE 0C               INC C
4510+ B7DF              .countNext:
4511+ B7DF 11 10 00         LD DE, ENT_SIZE
4512+ B7E2 19               ADD HL, DE
4513+ B7E3 10 E0            DJNZ .countLoop
4514+ B7E5 79               LD A, C
4515+ B7E6 C9               RET
4516+ B7E7
4517+ B7E7              ; ==============================================================================
4518+ B7E7              ; TrySpawnNasty - Intenta crear un nasty en un slot vacio
4519+ B7E7              ; ==============================================================================
4520+ B7E7              ; Llamado cada frame. Solo spawnea cuando el timer llega a 0.
4521+ B7E7              ; ==============================================================================
4522+ B7E7              TrySpawnNasty:
4523+ B7E7                  IF DEBUG_NO_ENEMIES
4524+ B7E7 ~                RET
4525+ B7E7                  ENDIF
4526+ B7E7                  ; Bloquear durante la pausa cinematografica post-cutscene de iglesia.
4527+ B7E7                  ; Timer cuenta de 50 (=2s) a 0; key aparece en t=1s; nasties resumen
4528+ B7E7                  ; cuando el timer llega a 0.
4529+ B7E7 3A CF 82         LD A, (PostTrapPauseTimer)
4530+ B7EA B7               OR A
4531+ B7EB C0               RET NZ
4532+ B7EC                  ; Bloquear durante la fase de muerte del player (yellow + red): nasties
4533+ B7EC                  ; no respawnean hasta que termine el rojo y el player reaparezca en LastEntryPos.
4534+ B7EC 3A EF 82         LD A, (DeathBorderPhase)
4535+ B7EF B7               OR A
