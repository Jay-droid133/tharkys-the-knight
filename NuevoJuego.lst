 120+ D96C              ; ==============================================================================
 121+ D96C              ; UpdateGameClock
 122+ D96C              ; ==============================================================================
 123+ D96C              UpdateGameClock:
 124+ D96C 21 D2 D7         LD HL, GameSubMinute
 125+ D96F 34               INC (HL)
 126+ D970 3A D5 D7         LD A, (SubMinuteMax)
 127+ D973 BE               CP (HL)
 128+ D974 C0               RET NZ
 129+ D975
 130+ D975 AF               XOR A
 131+ D976 32 D2 D7         LD (GameSubMinute), A
 132+ D979 21 D3 D7         LD HL, GameMinutes
 133+ D97C 34               INC (HL)
 134+ D97D                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 135+ D97D                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 136+ D97D 3A D3 D7         LD A, (GameMinutes)
 137+ D980 FE 3C            CP 60
 138+ D982 C0               RET NZ
 139+ D983
 140+ D983 AF               XOR A
 141+ D984 32 D3 D7         LD (GameMinutes), A
 142+ D987 21 D4 D7         LD HL, GameHours
 143+ D98A 34               INC (HL)
 144+ D98B 7E               LD A, (HL)
 145+ D98C FE 18            CP 24
 146+ D98E 20 04            JR NZ, .checkPhase
 147+ D990 AF               XOR A
 148+ D991 32 D4 D7         LD (GameHours), A
 149+ D994
 150+ D994              .checkPhase:
 151+ D994 3A D4 D7         LD A, (GameHours)
 152+ D997 21 DE D7         LD HL, PhaseTable
 153+ D99A 06 07            LD B, 7
 154+ D99C              .phaseLoop:
 155+ D99C BE               CP (HL)
 156+ D99D 28 05            JR Z, .phaseFound
 157+ D99F 23               INC HL
 158+ D9A0 23               INC HL
 159+ D9A1 10 F9            DJNZ .phaseLoop
 160+ D9A3 C9               RET
 161+ D9A4              .phaseFound:
 162+ D9A4 23               INC HL
 163+ D9A5 7E               LD A, (HL)
 164+ D9A6 F5               PUSH AF
 165+ D9A7 CD E6 D1         CALL SetTimeOfDay
 166+ D9AA F1               POP AF
 167+ D9AB FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 168+ D9AD C0               RET NZ
 169+ D9AE                  ; Nuevo dia: incrementar ciclo
 170+ D9AE 21 D2 B8         LD HL, DayCycleCount
 171+ D9B1 34               INC (HL)
 172+ D9B2 C9               RET
 173+ D9B3
 174+ D9B3              ; ==============================================================================
 175+ D9B3              ; SetClockToPhaseHour
 176+ D9B3              ; ==============================================================================
 177+ D9B3              SetClockToPhaseHour:
 178+ D9B3 21 D7 D7         LD HL, PhaseStartHour
 179+ D9B6 4F               LD C, A
 180+ D9B7 06 00            LD B, 0
 181+ D9B9 09               ADD HL, BC
 182+ D9BA 7E               LD A, (HL)
 183+ D9BB 32 D4 D7         LD (GameHours), A
 184+ D9BE AF               XOR A
 185+ D9BF 32 D3 D7         LD (GameMinutes), A
 186+ D9C2 32 D2 D7         LD (GameSubMinute), A
 187+ D9C5 C9               RET
