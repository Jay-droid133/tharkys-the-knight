 395+ EBFF 21 D9 5F         LD HL, PlayerColorCyclerFrame
 396+ EC02 34               INC (HL)
 397+ EC03
 398+ EC03                  ; --- Slot = (frame / COLOR_CYCLER_PERIOD) mod B ---
 399+ EC03 7E               LD A, (HL)
 400+ EC04 16 00            LD D, 0                                 ; D = quotient (frame / PERIOD)
 401+ EC06              .upcc_divLoop:
 402+ EC06 D6 0C            SUB COLOR_CYCLER_PERIOD
