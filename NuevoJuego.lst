 627+ ED5A 21 ED EA         LD HL, BgGfx_pickup_mushroom
 628+ ED5D 18 2C            JR .urpActivate
 629+ ED5F              .urpDoCompass:
 630+ ED5F 3E 08            LD A, ROLLED_COMPASS
 631+ ED61 32 D5 5F         LD (RP_TmpRolled), A
 632+ ED64 21 52 F5         LD HL, BgGfx_pickup_compass
 633+ ED67 18 22            JR .urpActivate
 634+ ED69              .urpDoRoulette:
 635+ ED69                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
 636+ ED69                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
 637+ ED69                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
 638+ ED69                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
 639+ ED69 3E 06            LD A, ROLLED_ROULETTE
 640+ ED6B 32 D5 5F         LD (RP_TmpRolled), A
 641+ ED6E 3E 01            LD A, 1
 642+ ED70 32 BC 5F         LD (RouletteActive), A
 643+ ED73                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
 644+ ED73 ED 5F            LD A, R
 645+ ED75 06 09            LD B, ROULETTE_ORDER_LEN
 646+ ED77              .urpRouletteModLoop:
 647+ ED77 90               SUB B
 648+ ED78 30 FD            JR NC, .urpRouletteModLoop
 649+ ED7A 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
 650+ ED7B CD 11 EB         CALL SkipCompassIfNeeded            ; si idx cae en COMPASS y lasting activo, avanza
 651+ ED7E 32 BD 5F         LD (RouletteIdx), A
 652+ ED81 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
 653+ ED82 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
 654+ ED84 32 BE 5F         LD (RouletteFrameCounter), A
 655+ ED87 78               LD A, B
 656+ ED88 CD B3 EA         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
 657+ ED8B              .urpActivate:
 658+ ED8B                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
 659+ ED8B CD DD EA         CALL LoadSynthSpriteAndExtractAttr
 660+ ED8E 3A 01 83         LD A, (CurrentScreenX)
 661+ ED91 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
 662+ ED94 3A 02 83         LD A, (CurrentScreenY)
 663+ ED97 32 B5 5F         LD (RandomSynthMapY), A
 664+ ED9A 3E FF            LD A, $FF
 665+ ED9C 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
 666+ ED9F 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
 667+ EDA1                                                      ; ya están set por .urpDoXxx — no resetear)
 668+ EDA1
 669+ EDA1              ; ==============================================================================
 670+ EDA1              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
 671+ EDA1              ; ==============================================================================
 672+ EDA1              ; prev ← cur (data de la sala que dejamos).
 673+ EDA1              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
 674+ EDA1              ;
 675+ EDA1              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
 676+ EDA1              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
 677+ EDA1              ; ==============================================================================
 678+ EDA1              .urpZeroAndRotate:
