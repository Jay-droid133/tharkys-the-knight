5551+ BD7D              ; ==============================================================================
5552+ BD7D              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5553+ BD7D              ; ==============================================================================
5554+ BD7D              ScareAllMonsters:
5555+ BD7D AF               XOR A
5556+ BD7E 32 CE B3         LD (MonstersActive), A              ; No respawnear mas
5557+ BD81                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5558+ BD81                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5559+ BD81                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5560+ BD81 21 9B 8D         LD HL, MonsterAiFlags
5561+ BD84 06 03            LD B, 3
5562+ BD86              .samClearLoop:
5563+ BD86 7E               LD A, (HL)
5564+ BD87 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5565+ BD89 77               LD (HL), A
5566+ BD8A 23               INC HL
5567+ BD8B 10 F9            DJNZ .samClearLoop
5568+ BD8D 3E 7D            LD A, SCARE_TIMER_DAWN
5569+ BD8F 32 64 B6         LD (ScareTimer), A
5570+ BD92                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5571+ BD92                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5572+ BD92                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5573+ BD92                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5574+ BD92 DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5575+ BD96 06 06            LD B, NUM_MONSTERS
5576+ BD98              .samStateLoop:
5577+ BD98 DD 7E 01         LD A, (IX+ENT_TYPE)
5578+ BD9B FE 02            CP TYPE_MONSTER
5579+ BD9D 20 1B            JR NZ, .samStateNext
5580+ BD9F DD 7E 02         LD A, (IX+ENT_STATE)
5581+ BDA2 FE 03            CP STATE_DYING
5582+ BDA4 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5583+ BDA6 FE 04            CP STATE_SPAWNING
5584+ BDA8 28 10            JR Z, .samStateNext
5585+ BDAA DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5586+ BDAE DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5587+ BDB2 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5588+ BDB6 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5589+ BDBA              .samStateNext:
5590+ BDBA 11 10 00         LD DE, ENT_SIZE
5591+ BDBD DD 19            ADD IX, DE
5592+ BDBF 10 D7            DJNZ .samStateLoop
5593+ BDC1 C9               RET
