1164+ D638              ; ==============================================================================
1165+ D638              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
1166+ D638              ; ==============================================================================
1167+ D638              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
1168+ D638              ; Salida:  IX = primer byte tras pixel data (tintPaper)
1169+ D638              ; Modifica: AF, BC, DE, HL
1170+ D638              ; ==============================================================================
1171+ D638              SkipPixelData:
1172+ D638 DD 7E 00         LD A, (IX+0)                ; height_px
1173+ D63B 57               LD D, A                     ; D = height_px
1174+ D63C DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
