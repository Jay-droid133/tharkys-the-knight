 139+ 9DCB              .alignedLine:
 140+ 9DCB 3A 22 9E         LD A, (.widthSave)
 141+ 9DCE 47               LD B, A                     ; B = ancho en bytes
 142+ 9DCF E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9DD0
 144+ 9DD0              .alignedByte:
 145+ 9DD0 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9DD1 AE               XOR (HL)
 147+ 9DD2 77               LD (HL), A
 148+ 9DD3 23               INC HL                      ; Siguiente columna VRAM
 149+ 9DD4 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9DD5 10 F9            DJNZ .alignedByte
 151+ 9DD7
 152+ 9DD7 E1               POP HL                      ; Restaurar inicio de linea
 153+ 9DD8 0D               DEC C
 154+ 9DD9 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9DDA CD 26 9E         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9DDD 18 EC            JR .alignedLine
