 353+ 8F4C 12               LD (DE), A
 354+ 8F4D 23               INC HL
 355+ 8F4E 13               INC DE
 356+ 8F4F 10 FA            DJNZ .saveCol
 357+ 8F51 E1               POP HL
 358+ 8F52                  ; Siguiente fila attr: HL += 32
 359+ 8F52 D5               PUSH DE
 360+ 8F53 11 20 00         LD DE, 32
 361+ 8F56 19               ADD HL, DE
 362+ 8F57 D1               POP DE
 363+ 8F58 0D               DEC C
 364+ 8F59 20 EB            JR NZ, .saveRow
 365+ 8F5B C9               RET
