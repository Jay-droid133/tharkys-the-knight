 156+ EAFD              .checkPhase:
 157+ EAFD 3A 38 E9         LD A, (GameHours)
 158+ EB00 21 42 E9         LD HL, PhaseTable
 159+ EB03 06 07            LD B, 7
 160+ EB05              .phaseLoop:
 161+ EB05 BE               CP (HL)
 162+ EB06 28 05            JR Z, .phaseFound
 163+ EB08 23               INC HL
 164+ EB09 23               INC HL
 165+ EB0A 10 F9            DJNZ .phaseLoop
 166+ EB0C C9               RET
 167+ EB0D              .phaseFound:
 168+ EB0D 23               INC HL
 169+ EB0E 7E               LD A, (HL)
 170+ EB0F F5               PUSH AF
 171+ EB10 CD D8 E2         CALL SetTimeOfDay
 172+ EB13 F1               POP AF
 173+ EB14 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EB16 C0               RET NZ
 175+ EB17                  ; Nuevo dia: incrementar ciclo
 176+ EB17 21 ED BC         LD HL, DayCycleCount
 177+ EB1A 34               INC (HL)
 178+ EB1B C9               RET
