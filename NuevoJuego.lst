 331  A1A1                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
   1+ A1A1              ; ==============================================================================
   2+ A1A1              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ A1A1              ; ==============================================================================
   4+ A1A1              ; - Estructura de entidad de 12 bytes (universal)
   5+ A1A1              ; - Game loop per-entity: erase → update → draw
   6+ A1A1              ; - Movimiento 8-bit (sin subpixel)
   7+ A1A1              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ A1A1              ; - XOR draw/erase (una sola rutina)
   9+ A1A1              ; ==============================================================================
  10+ A1A1
  11+ A1A1              ; ==============================================================================
  12+ A1A1              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ A1A1              ; ==============================================================================
  14+ A1A1              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ A1A1              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ A1A1              ; ==============================================================================
  17+ A1A1              ReadInput:
  18+ A1A1 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ A1A3 1E 00            LD E, 0             ; E = fuego acumulado
  20+ A1A5
  21+ A1A5                  ; -- 1. QAOP --
  22+ A1A5 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ A1A8 ED 78            IN A, (C)
  24+ A1AA CB 47            BIT 0, A            ; Q = Arriba
  25+ A1AC 20 02            JR NZ, .no_q
  26+ A1AE CB C2            SET 0, D
  27+ A1B0              .no_q:
  28+ A1B0 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ A1B3 ED 78            IN A, (C)
  30+ A1B5 CB 47            BIT 0, A            ; A = Abajo
  31+ A1B7 20 02            JR NZ, .no_a
  32+ A1B9 CB CA            SET 1, D
  33+ A1BB              .no_a:
  34+ A1BB 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ A1BE ED 78            IN A, (C)
  36+ A1C0 CB 4F            BIT 1, A            ; O = Izquierda
  37+ A1C2 20 02            JR NZ, .no_o
  38+ A1C4 CB DA            SET 3, D
  39+ A1C6              .no_o:
  40+ A1C6 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ A1C8 20 02            JR NZ, .no_p
  42+ A1CA CB D2            SET 2, D
  43+ A1CC              .no_p:
  44+ A1CC
  45+ A1CC                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ A1CC                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ A1CC DB 1F            IN A, (31)
  48+ A1CE 4F               LD C, A             ; guardar para fire
  49+ A1CF CB 5F            BIT 3, A            ; Up
  50+ A1D1 28 02            JR Z, .no_k_up
  51+ A1D3 CB C2            SET 0, D
  52+ A1D5              .no_k_up:
  53+ A1D5 CB 57            BIT 2, A            ; Down
  54+ A1D7 28 02            JR Z, .no_k_down
  55+ A1D9 CB CA            SET 1, D
  56+ A1DB              .no_k_down:
  57+ A1DB CB 4F            BIT 1, A            ; Left
  58+ A1DD 28 02            JR Z, .no_k_left
  59+ A1DF CB DA            SET 3, D
  60+ A1E1              .no_k_left:
  61+ A1E1 CB 47            BIT 0, A            ; Right
  62+ A1E3 28 02            JR Z, .no_k_right
  63+ A1E5 CB D2            SET 2, D
  64+ A1E7              .no_k_right:
  65+ A1E7 CB 61            BIT 4, C            ; Kempston Fire
  66+ A1E9 28 02            JR Z, .no_k_fire
  67+ A1EB CB C3            SET 0, E
  68+ A1ED              .no_k_fire:
  69+ A1ED
  70+ A1ED                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ A1ED                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ A1ED 01 FE F7         LD BC, $F7FE
  73+ A1F0 ED 78            IN A, (C)
  74+ A1F2 CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ A1F4 20 02            JR NZ, .no_s1_up
  76+ A1F6 CB C2            SET 0, D
  77+ A1F8              .no_s1_up:
  78+ A1F8 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ A1FA 20 02            JR NZ, .no_s1_down
  80+ A1FC CB CA            SET 1, D
  81+ A1FE              .no_s1_down:
  82+ A1FE CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ A200 20 02            JR NZ, .no_s1_left
  84+ A202 CB DA            SET 3, D
  85+ A204              .no_s1_left:
  86+ A204 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ A206 20 02            JR NZ, .no_s1_right
  88+ A208 CB D2            SET 2, D
  89+ A20A              .no_s1_right:
  90+ A20A CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ A20C 20 02            JR NZ, .no_s1_fire
  92+ A20E CB C3            SET 0, E
  93+ A210              .no_s1_fire:
  94+ A210
  95+ A210                  ; -- 4. SPACE = Fire (teclado) --
  96+ A210 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ A213 ED 78            IN A, (C)
  98+ A215 CB 47            BIT 0, A            ; SPACE
  99+ A217 20 02            JR NZ, .no_space
 100+ A219 CB C3            SET 0, E
 101+ A21B              .no_space:
 102+ A21B
 103+ A21B                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ A21B 7B               LD A, E
 105+ A21C 32 47 82         LD (InputFire), A
 106+ A21F
 107+ A21F                  ; -- 6. Cancelar opuestos --
 108+ A21F 7A               LD A, D
 109+ A220 47               LD B, A
 110+ A221 E6 03            AND DIR_N | DIR_S
 111+ A223 FE 03            CP DIR_N | DIR_S
 112+ A225 20 04            JR NZ, .noVC
 113+ A227 78               LD A, B
 114+ A228 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 115+ A22A 47               LD B, A
 116+ A22B              .noVC:
 117+ A22B 78               LD A, B
 118+ A22C E6 0C            AND DIR_E | DIR_W
 119+ A22E FE 0C            CP DIR_E | DIR_W
 120+ A230 20 04            JR NZ, .noHC
 121+ A232 78               LD A, B
 122+ A233 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 123+ A235 47               LD B, A
 124+ A236              .noHC:
 125+ A236 78               LD A, B
 126+ A237 32 46 82         LD (InputDirection), A
 127+ A23A C9               RET
 128+ A23B
 129+ A23B              ; ==============================================================================
 130+ A23B              ; InitEntities - Inicializa la tabla de entidades
 131+ A23B              ; ==============================================================================
 132+ A23B              ; Limpia todos los slots y configura el slot 0 como player.
 133+ A23B              ; ==============================================================================
 134+ A23B              InitEntities:
 135+ A23B                  ; Limpiar toda la tabla a ceros
 136+ A23B 21 36 81         LD HL, EntityTable
 137+ A23E 11 37 81         LD DE, EntityTable + 1
 138+ A241 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 139+ A244 AF               XOR A
 140+ A245 77               LD (HL), A
 141+ A246 ED B0            LDIR
 142+ A248
 143+ A248                  ; Limpiar tabla de atributos salvados
 144+ A248 21 BE 9F         LD HL, SavedAttrTable
 145+ A24B 11 BF 9F         LD DE, SavedAttrTable + 1
 146+ A24E 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 147+ A251 AF               XOR A
 148+ A252 77               LD (HL), A
 149+ A253 ED B0            LDIR
 150+ A255
 151+ A255                  ; Configurar slot 0: Player
 152+ A255 DD 21 36 81      LD IX, EntityTable
 153+ A259 DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 154+ A25D DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 155+ A261 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 156+ A265 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 157+ A269 DD 36 04 90      LD (IX+ENT_POSY), START_PLAYER_Y
 158+ A26D DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 159+ A271 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 160+ A275 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 161+ A279 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 162+ A27D DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 163+ A281 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 164+ A285 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 165+ A289 DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 166+ A28D DD 36 0D 90      LD (IX+ENT_OLDY), START_PLAYER_Y
 167+ A291 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 168+ A295 DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
 169+ A299
 170+ A299                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 171+ A299 3E 0C            LD A, SPAWN_INTERVAL
 172+ A29B 32 7D 82         LD (SpawnTimer), A
 173+ A29E AF               XOR A
 174+ A29F 32 89 82         LD (EnemyStepIdx), A
 175+ A2A2 32 7B 5F         LD (PendingEraseCount), A
 176+ A2A5 C9               RET
 177+ A2A6
 178+ A2A6              ; ==============================================================================
 179+ A2A6              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 180+ A2A6              ; ==============================================================================
 181+ A2A6              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 182+ A2A6              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 183+ A2A6              ; que los pies parezcan hundirse en el suelo.
 184+ A2A6              ; ==============================================================================
 185+ A2A6              ComputePlayerDrawY:
 186+ A2A6 3A 39 81         LD A, (EntityTable + ENT_POSX)
 187+ A2A9 C6 08            ADD A, 8                    ; center X del player
 188+ A2AB 47               LD B, A
 189+ A2AC 3A 3A 81         LD A, (EntityTable + ENT_POSY)
 190+ A2AF 4F               LD C, A
 191+ A2B0 32 64 82         LD (PlayerDrawY), A         ; default: sin offset
 192+ A2B3 B7               OR A
 193+ A2B4 C8               RET Z
 194+ A2B5 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 195+ A2B6 CD 01 D8         CALL IsPointBlocked
 196+ A2B9 C8               RET Z                       ; libre → sin offset
 197+ A2BA 3A 3A 81         LD A, (EntityTable + ENT_POSY)
 198+ A2BD 3C               INC A
 199+ A2BE 32 64 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 200+ A2C1 C9               RET
 201+ A2C2
 202+ A2C2              ; ==============================================================================
 203+ A2C2              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 204+ A2C2              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 205+ A2C2              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 206+ A2C2              ; no parecer que se hunde en el techo.
 207+ A2C2              ; Preserva: IX. Destruye: AF, BC.
 208+ A2C2              ; ==============================================================================
 209+ A2C2              ComputeEnemyDrawY:
 210+ A2C2 DD 7E 04         LD A, (IX+ENT_POSY)
 211+ A2C5 32 65 82         LD (EnemyDrawY), A          ; default = POSY
 212+ A2C8 DD 7E 01         LD A, (IX+ENT_TYPE)
 213+ A2CB FE 02            CP TYPE_MONSTER
 214+ A2CD C0               RET NZ                      ; no monster → sin offset
 215+ A2CE DD 7E 03         LD A, (IX+ENT_POSX)
 216+ A2D1 C6 08            ADD A, 8                    ; center X
 217+ A2D3 47               LD B, A
 218+ A2D4 DD 7E 04         LD A, (IX+ENT_POSY)
 219+ A2D7 4F               LD C, A
 220+ A2D8 B7               OR A
 221+ A2D9 C8               RET Z
 222+ A2DA 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 223+ A2DB CD 01 D8         CALL IsPointBlocked
 224+ A2DE C8               RET Z                       ; libre → sin offset
 225+ A2DF DD 7E 04         LD A, (IX+ENT_POSY)
 226+ A2E2 3C               INC A
 227+ A2E3 32 65 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 228+ A2E6 C9               RET
