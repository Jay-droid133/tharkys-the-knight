2669+ AD98 FE 10            CP SCREEN_MIN_Y
2670+ AD9A 30 04            JR NC, .eClampYOk
2671+ AD9C 3E 10            LD A, SCREEN_MIN_Y
2672+ AD9E 18 0E            JR .eReverseY
2673+ ADA0              .eClampYOk:
2674+ ADA0 DD 77 04         LD (IX+ENT_POSY), A
2675+ ADA3 CD DD B6         CALL CheckEnemyCollision
2676+ ADA6 28 0E            JR Z, .eYDone
2677+ ADA8 3A FE AD         LD A, (.savedEY)
2678+ ADAB DD 77 04         LD (IX+ENT_POSY), A
2679+ ADAE              .eReverseY:
2680+ ADAE DD 7E 07         LD A, (IX+ENT_DELTAY)
2681+ ADB1 ED 44            NEG
2682+ ADB3 DD 77 07         LD (IX+ENT_DELTAY), A
2683+ ADB6              .eYDone:
2684+ ADB6
2685+ ADB6                  ; --- Animacion: seleccionar par de frames segun direccion horizontal ---
2686+ ADB6                  ; DELTAX >= 0 → base+0,base+1 (derecha). DELTAX < 0 → base+2,base+3 (izquierda).
2687+ ADB6 DD 7E 06         LD A, (IX+ENT_DELTAX)
2688+ ADB9 0E 00            LD C, ENEMY_FRAMES_RIGHT    ; C = offset de direccion (0 = derecha)
2689+ ADBB CB 7F            BIT 7, A
2690+ ADBD 28 02            JR Z, .eAnimDir
2691+ ADBF 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2692+ ADC1              .eAnimDir:
2693+ ADC1 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2694+ ADC4 20 27            JR NZ, .eAnimDone
2695+ ADC6 3A 58 8D         LD A, (CurrentEnemyAnimDelay)         ; Delay escalado por ciclo
2696+ ADC9 47               LD B, A
2697+ ADCA DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2698+ ADCD FE 34            CP SPRID_ENEMY_5
2699+ ADCF 78               LD A, B
2700+ ADD0 20 06            JR NZ, .eAnimDelaySet
2701+ ADD2 CB 3F            SRL A                               ; Rata: mitad del delay
2702+ ADD4 B7               OR A
2703+ ADD5 20 01            JR NZ, .eAnimDelaySet
2704+ ADD7 3C               INC A                               ; Minimo 1
2705+ ADD8              .eAnimDelaySet:
2706+ ADD8 DD 77 09         LD (IX+ENT_ANIMTIMER), A
2707+ ADDB                  ; Avanzar frame dentro del par (2 frames por direccion)
2708+ ADDB DD 7E 00         LD A, (IX+ENT_SPRITEID)
2709+ ADDE 47               LD B, A
2710+ ADDF DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset absoluto dentro del tipo
2711+ ADE2                  ; Determinar frame dentro del par: si offset AND 1 → reset, sino avanzar
2712+ ADE2 E6 01            AND 1
2713+ ADE4 20 03            JR NZ, .eFrameReset
2714+ ADE6                  ; Frame 0 del par → avanzar a frame 1
2715+ ADE6 04               INC B
2716+ ADE7 18 01            JR .eFrameSet
2717+ ADE9              .eFrameReset:
2718+ ADE9                  ; Frame 1 del par → volver a frame 0
2719+ ADE9 05               DEC B
2720+ ADEA              .eFrameSet:
2721+ ADEA DD 70 00         LD (IX+ENT_SPRITEID), B
2722+ ADED              .eAnimDone:
2723+ ADED                  ; Ajustar sprite al par correcto segun direccion
2724+ ADED DD 7E 00         LD A, (IX+ENT_SPRITEID)
2725+ ADF0 DD 96 08         SUB (IX+ENT_ANIMBASE)       ; offset actual
2726+ ADF3 E6 01            AND 1                       ; preservar frame (0 o 1) dentro del par
2727+ ADF5 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
2728+ ADF8 81               ADD A, C                    ; sumar offset de direccion (0 o 2)
2729+ ADF9 DD 77 00         LD (IX+ENT_SPRITEID), A
2730+ ADFC C9               RET
2731+ ADFD
2732+ ADFD 00           .savedEX: DEFB 0
2733+ ADFE 00           .savedEY: DEFB 0
2734+ ADFF
2735+ ADFF              ; ==============================================================================
2736+ ADFF              ; ==============================================================================
2737+ ADFF              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2738+ ADFF              ; ==============================================================================
2739+ ADFF              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2740+ ADFF              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2741+ ADFF              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2742+ ADFF              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2743+ ADFF              ; ==============================================================================
2744+ ADFF              UpdateMonster:
2745+ ADFF                  ; --- Stun: knockback + pausa tras golpe del player ---
2746+ ADFF DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2747+ AE02 B7               OR A
2748+ AE03 CA 38 B0         JP Z, .moNormal
2749+ AE06 DD 35 0A         DEC (IX+ENT_DIR)
2750+ AE09 20 0B            JR NZ, .moStunActive
2751+ AE0B                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2752+ AE0B DD 36 06 00      LD (IX+ENT_DELTAX), 0
2753+ AE0F DD 36 07 00      LD (IX+ENT_DELTAY), 0
2754+ AE13 C3 38 B0         JP .moNormal
2755+ AE16
2756+ AE16              .moStunActive:
2757+ AE16                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2758+ AE16 FE 06            CP MONSTER_STUN_PAUSE
2759+ AE18 DA C9 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2760+ AE1B                  ; Knockback: aplicar movimiento con collision check
2761+ AE1B DD 56 06         LD D, (IX+ENT_DELTAX)
2762+ AE1E DD 5E 07         LD E, (IX+ENT_DELTAY)
2763+ AE21 7A               LD A, D
2764+ AE22 B3               OR E
2765+ AE23 CA C9 B1         JP Z, .moAnimate
2766+ AE26                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2767+ AE26 D5               PUSH DE
2768+ AE27 DD 7E 03         LD A, (IX+ENT_POSX)
2769+ AE2A 32 61 B3         LD (.moSvX), A
2770+ AE2D DD 7E 04         LD A, (IX+ENT_POSY)
2771+ AE30 32 62 B3         LD (.moSvY), A
2772+ AE33                  ; Calcular nueva posicion
2773+ AE33 DD 7E 03         LD A, (IX+ENT_POSX)
2774+ AE36 82               ADD A, D
2775+ AE37 DD 77 03         LD (IX+ENT_POSX), A
2776+ AE3A DD 7E 04         LD A, (IX+ENT_POSY)
2777+ AE3D 83               ADD A, E
2778+ AE3E DD 77 04         LD (IX+ENT_POSY), A
2779+ AE41                  ; Comprobar bordes ANTES de colision con paredes
2780+ AE41 DD 7E 03         LD A, (IX+ENT_POSX)
2781+ AE44 FE E8            CP SCREEN_MAX_X
2782+ AE46 30 30            JR NC, .moKbPreOffscreen
2783+ AE48 FE 04            CP MONSTER_KB_SPEED
2784+ AE4A 38 20            JR C, .moKbPreOffscreenMaybeX
2785+ AE4C              .moKbPreBorderXOk:
2786+ AE4C DD 7E 04         LD A, (IX+ENT_POSY)
2787+ AE4F FE A8            CP SCREEN_MAX_Y
2788+ AE51 30 25            JR NC, .moKbPreOffscreen
2789+ AE53 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2790+ AE55 38 1B            JR C, .moKbPreOffscreenMaybeY
2791+ AE57              .moKbPreBorderOk:
2792+ AE57                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2793+ AE57                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2794+ AE57                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2795+ AE57                  ; CheckEnemyCollision.
2796+ AE57                  ; CheckChurchTrap retorna:
2797+ AE57                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2798+ AE57                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2799+ AE57                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2800+ AE57 CD EE F2         CALL CheckChurchTrap
2801+ AE5A B7               OR A
2802+ AE5B 28 07            JR Z, .moKbCollCheck
2803+ AE5D FE 02            CP 2
2804+ AE5F CA 10 AF         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2805+ AE62 D1               POP DE                              ; limpiar PUSH DE previo
2806+ AE63 C9               RET                                 ; cutscene activa, salir
2807+ AE64              .moKbCollCheck:
2808+ AE64                  ; Dentro de pantalla: comprobar colision con paredes
2809+ AE64 CD DD B6         CALL CheckEnemyCollision
2810+ AE67 C2 10 AF         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2811+ AE6A 18 1C            JR .moKbNotBlocked
2812+ AE6C              .moKbPreOffscreenMaybeX:
2813+ AE6C CB 7A            BIT 7, D
2814+ AE6E 20 08            JR NZ, .moKbPreOffscreen
2815+ AE70 18 DA            JR .moKbPreBorderXOk
2816+ AE72              .moKbPreOffscreenMaybeY:
2817+ AE72 CB 7B            BIT 7, E
2818+ AE74 20 02            JR NZ, .moKbPreOffscreen
2819+ AE76 18 DF            JR .moKbPreBorderOk
2820+ AE78              .moKbPreOffscreen:
2821+ AE78                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2822+ AE78 3A 61 B3         LD A, (.moSvX)
2823+ AE7B DD 77 03         LD (IX+ENT_POSX), A
2824+ AE7E 3A 62 B3         LD A, (.moSvY)
2825+ AE81 DD 77 04         LD (IX+ENT_POSY), A
2826+ AE84 D1               POP DE
2827+ AE85 C3 75 AF         JP .moKbOffscreen
2828+ AE88              .moKbNotBlocked:
2829+ AE88                  ; Pared libre: comprobar impacto con otro monster (billar)
2830+ AE88 CD 62 B2         CALL .moCheckOverlap
2831+ AE8B 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2832+ AE8D                  ; Libre: restaurar pos y aplicar movimiento
2833+ AE8D 3A 61 B3         LD A, (.moSvX)
2834+ AE90 DD 77 03         LD (IX+ENT_POSX), A
2835+ AE93 3A 62 B3         LD A, (.moSvY)
2836+ AE96 DD 77 04         LD (IX+ENT_POSY), A
2837+ AE99 D1               POP DE
2838+ AE9A C3 4C AF         JP .moKbApply
2839+ AE9D              .moKbBilliard:
2840+ AE9D                  ; Billar: A para en su sitio, B hereda la fuerza
2841+ AE9D 3A 61 B3         LD A, (.moSvX)
2842+ AEA0 DD 77 03         LD (IX+ENT_POSX), A
2843+ AEA3 3A 62 B3         LD A, (.moSvY)
2844+ AEA6 DD 77 04         LD (IX+ENT_POSY), A
2845+ AEA9 D1               POP DE
2846+ AEAA                  ; Transferir knockback al monster impactado
2847+ AEAA DD E5            PUSH IX
2848+ AEAC DD 2A 6B B3      LD IX, (.moHitMonster)
2849+ AEB0                  ; Solo transferir si no esta ya en stun
2850+ AEB0 DD 7E 0A         LD A, (IX+ENT_DIR)
2851+ AEB3 B7               OR A
2852+ AEB4 20 2A            JR NZ, .moKbBilliardDone
2853+ AEB6                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2854+ AEB6 7A               LD A, D
2855+ AEB7 B7               OR A
2856+ AEB8 28 0D            JR Z, .moBillNoX
2857+ AEBA CB 7A            BIT 7, D
2858+ AEBC 20 04            JR NZ, .moBillXNeg
2859+ AEBE 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2860+ AEC0 18 02            JR .moBillSetX
2861+ AEC2              .moBillXNeg:
2862+ AEC2 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2863+ AEC4              .moBillSetX:
2864+ AEC4 DD 77 06         LD (IX+ENT_DELTAX), A
2865+ AEC7              .moBillNoX:
2866+ AEC7 7B               LD A, E
2867+ AEC8 B7               OR A
2868+ AEC9 28 0D            JR Z, .moBillNoY
2869+ AECB CB 7B            BIT 7, E
2870+ AECD 20 04            JR NZ, .moBillYNeg
2871+ AECF 3E 03            LD A, MONSTER_KB_SPEED - 1
2872+ AED1 18 02            JR .moBillSetY
2873+ AED3              .moBillYNeg:
2874+ AED3 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2875+ AED5              .moBillSetY:
2876+ AED5 DD 77 07         LD (IX+ENT_DELTAY), A
2877+ AED8              .moBillNoY:
2878+ AED8 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2879+ AEDC                  ; Kb heredado por billar: NO es directo del player.
2880+ AEDC                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2881+ AEDC DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2882+ AEE0              .moKbBilliardDone:
2883+ AEE0 DD E1            POP IX
2884+ AEE2                  ; A continua con fuerza reducida (no para del todo)
2885+ AEE2                  ; Reducir velocidad de A a la mitad
2886+ AEE2 DD 7E 06         LD A, (IX+ENT_DELTAX)
2887+ AEE5 CB 2F            SRA A                               ; /2 con signo
2888+ AEE7 DD 77 06         LD (IX+ENT_DELTAX), A
2889+ AEEA 57               LD D, A
2890+ AEEB DD 7E 07         LD A, (IX+ENT_DELTAY)
2891+ AEEE CB 2F            SRA A
2892+ AEF0 DD 77 07         LD (IX+ENT_DELTAY), A
2893+ AEF3 5F               LD E, A
2894+ AEF4                  ; Reducir stun restante de A
2895+ AEF4 DD 7E 0A         LD A, (IX+ENT_DIR)
2896+ AEF7 FE 08            CP MONSTER_STUN_PAUSE + 2
2897+ AEF9 DA 2D B0         JP C, .moStunStop                   ; Casi sin stun → parar
2898+ AEFC D6 04            SUB 4                               ; Quitar 4 frames de knockback
2899+ AEFE DD 77 0A         LD (IX+ENT_DIR), A
2900+ AF01                  ; Aplicar movimiento reducido de A
2901+ AF01 3A 61 B3         LD A, (.moSvX)
2902+ AF04 DD 77 03         LD (IX+ENT_POSX), A
2903+ AF07 3A 62 B3         LD A, (.moSvY)
2904+ AF0A DD 77 04         LD (IX+ENT_POSY), A
2905+ AF0D C3 4C AF         JP .moKbApply
2906+ AF10              .moKbWallBlock:
2907+ AF10                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2908+ AF10 3A 61 B3         LD A, (.moSvX)
2909+ AF13 DD 77 03         LD (IX+ENT_POSX), A
2910+ AF16 3A 62 B3         LD A, (.moSvY)
2911+ AF19 DD 77 04         LD (IX+ENT_POSY), A
2912+ AF1C D1               POP DE
2913+ AF1D                  ; Intentar solo eje X (mantener direccion del golpe)
2914+ AF1D 7A               LD A, D
2915+ AF1E B7               OR A
2916+ AF1F 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2917+ AF21 D5               PUSH DE
2918+ AF22 1E 00            LD E, 0
2919+ AF24 CD 23 B2         CALL .moTryPassable
2920+ AF27 D1               POP DE
2921+ AF28 20 09            JR NZ, .moKbSlideY
