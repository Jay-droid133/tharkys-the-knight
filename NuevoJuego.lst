2869+ B22C 7B               LD A, E
2870+ B22D B7               OR A
2871+ B22E 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2872+ B230 D5               PUSH DE
2873+ B231 16 00            LD D, 0
2874+ B233 CD 1C B5         CALL .moTryPassable
2875+ B236 D1               POP DE
2876+ B237 20 09            JR NZ, .moKbSlideStop
2877+ B239                  ; Slide en Y funciona
2878+ B239 16 00            LD D, 0
2879+ B23B DD 36 06 00      LD (IX+ENT_DELTAX), 0
2880+ B23F C3 45 B2         JP .moKbApply
