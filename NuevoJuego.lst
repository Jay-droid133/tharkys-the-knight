2526+ ACB4 FE 10            CP SCREEN_MIN_Y
2527+ ACB6 38 27            JR C, .paRevert
2528+ ACB8 DD 77 04         LD (IX+ENT_POSY), A
2529+ ACBB
2530+ ACBB                  ; Comprobar colision con fondo
2531+ ACBB CD BD B6         CALL CheckEnemyCollision
2532+ ACBE 20 1F            JR NZ, .paRevert                    ; Choco con pared
2533+ ACC0
2534+ ACC0                  ; --- Animacion durante ataque ---
2535+ ACC0 DD 35 09         DEC (IX+ENT_ANIMTIMER)
2536+ ACC3 20 19            JR NZ, .paAnimDone
2537+ ACC5 3E 04            LD A, 4                             ; Delay fijo rapido durante ataque
2538+ ACC7 DD 77 09         LD (IX+ENT_ANIMTIMER), A
2539+ ACCA DD 7E 00         LD A, (IX+ENT_SPRITEID)
