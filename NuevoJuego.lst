 643  C000                  INCLUDE "screen_gaps.asm"
# file opened: screen_gaps.asm
   1+ C000              ; ==============================================================================
   2+ C000              ; SCREEN GAPS (bank 6)
   3+ C000              ; Auto-generated by tools/build_screen_gaps.py — DO NOT EDIT BY HAND.
   4+ C000              ;
   5+ C000              ; Each opening = a contiguous run of walkable border cells that reach
   6+ C000              ; the main walkable region (MIN_POCKET_SIZE filter). Coord = midpoint.
   7+ C000              ;
   8+ C000              ;   ScreenGapsTable   — 256 DEFW ptrs (screen_id = Y*16+X)
   9+ C000              ;   ScreenGaps_YX     — DEFB count; then {side, coord} × count
  10+ C000              ;     side: 0=N, 1=S, 2=W, 3=E
  11+ C000              ;     coord: char col (0-31) N/S; char row (0-21) W/E
  12+ C000              ;   ScreenGapsNone    — shared zero record (DEFB 0)
  13+ C000              ; ==============================================================================
