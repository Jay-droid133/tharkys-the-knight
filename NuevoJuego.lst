 791+ F304              ; ==============================================================================
 792+ F304              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 793+ F304              ; ==============================================================================
 794+ F304              ; IN: DE = ptr a 16 filas x 2 bytes
 795+ F304              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 796+ F304              ; Destruye: AF, B, HL.
 797+ F304              ; ==============================================================================
 798+ F304              DrawCompassSprite:
 799+ F304                  ; Char row 0 (rows 0-7 del sprite)
 800+ F304 26 40            LD H, $40
 801+ F306 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 802+ F308 06 08            LD B, 8
 803+ F30A              .dcsRow0:
 804+ F30A 1A               LD A, (DE)
 805+ F30B 77               LD (HL), A
 806+ F30C 13               INC DE
 807+ F30D 23               INC HL
 808+ F30E 1A               LD A, (DE)
 809+ F30F 77               LD (HL), A
 810+ F310 13               INC DE
 811+ F311 2B               DEC HL
 812+ F312 24               INC H
 813+ F313 10 F5            DJNZ .dcsRow0
 814+ F315                  ; Char row 1 (rows 8-15 del sprite)
 815+ F315 26 40            LD H, $40
 816+ F317 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 817+ F319 06 08            LD B, 8
 818+ F31B              .dcsRow1:
 819+ F31B 1A               LD A, (DE)
 820+ F31C 77               LD (HL), A
 821+ F31D 13               INC DE
 822+ F31E 23               INC HL
 823+ F31F 1A               LD A, (DE)
 824+ F320 77               LD (HL), A
 825+ F321 13               INC DE
 826+ F322 2B               DEC HL
 827+ F323 24               INC H
 828+ F324 10 F5            DJNZ .dcsRow1
 829+ F326 C9               RET
 830+ F327
 831+ F327              ; ==============================================================================
 832+ F327              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 833+ F327              ; ==============================================================================
 834+ F327              SetCompassAttrs:
 835+ F327 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 836+ F32A 77               LD (HL), A
 837+ F32B 23               INC HL
 838+ F32C 77               LD (HL), A
 839+ F32D 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 840+ F330 77               LD (HL), A
 841+ F331 23               INC HL
 842+ F332 77               LD (HL), A
 843+ F333 C9               RET
