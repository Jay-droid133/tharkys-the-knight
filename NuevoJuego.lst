1324+ F66C              ; ==============================================================================
1325+ F66C              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1326+ F66C              ; ==============================================================================
1327+ F66C              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1328+ F66C              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1329+ F66C              ; ==============================================================================
1330+ F66C              ChurchCutsceneEraseStatueAtLast:
1331+ F66C              ChurchCutsceneDrawStatueAtLast:
1332+ F66C 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1333+ F66F 21 67 67         LD HL, StatueIdTable
1334+ F672 5F               LD E, A
1335+ F673 16 00            LD D, 0
1336+ F675 19               ADD HL, DE
1337+ F676 7E               LD A, (HL)                              ; A = statue id
1338+ F677 B7               OR A
1339+ F678 C8               RET Z
1340+ F679                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1341+ F679 6F               LD L, A
1342+ F67A 26 00            LD H, 0
1343+ F67C 54               LD D, H
1344+ F67D 5D               LD E, L
1345+ F67E 29               ADD HL, HL
1346+ F67F 19               ADD HL, DE                              ; HL = id*3
1347+ F680 11 FE E1         LD DE, BgGfxPtrById
1348+ F683 19               ADD HL, DE
1349+ F684 5E               LD E, (HL)
1350+ F685 23               INC HL
1351+ F686 56               LD D, (HL)                              ; DE = sprite ptr
1352+ F687 23               INC HL
1353+ F688 7E               LD A, (HL)                              ; A = bank
1354+ F689 EB               EX DE, HL                               ; HL = sprite ptr
1355+ F68A CD 7A 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1356+ F68D                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1357+ F68D 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1358+ F690 57               LD D, A
1359+ F691 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1360+ F694 5F               LD E, A
1361+ F695 C3 EF 68         JP DrawBgSprite16XorAtPixel
1362+ F698
1363+ F698              ; ==============================================================================
1364+ F698              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1365+ F698              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1366+ F698              ;     A  = jitter signed (-1, 0, +1) en bits.
1367+ F698              ; ==============================================================================
1368+ F698              ; IN: A = jitter signed (-1, 0, +1) en bits.
1369+ F698              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1370+ F698              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1371+ F698              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1372+ F698              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1373+ F698              ; version shifted, sin XOR.
1374+ F698              ;
1375+ F698              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1376+ F698              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1377+ F698              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1378+ F698              ; estatua se perdio cuando la estatua se pinto la primera vez con
1379+ F698              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1380+ F698              ; de la estatua, el wall perdido no se ve.
1381+ F698              ;
1382+ F698              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1383+ F698              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1384+ F698              ; shift de 1 bit no pierde pixels visibles.
1385+ F698              ; Destruye: AF, BC, DE, HL, IX.
1386+ F698              ; ==============================================================================
1387+ F698              ChurchCutsceneShakeStatueByteShift:
1388+ F698 32 02 F7         LD (.csbsJitter), A
1389+ F69B                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1390+ F69B 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1391+ F69E 5F               LD E, A
1392+ F69F 16 00            LD D, 0
1393+ F6A1 19               ADD HL, DE
1394+ F6A2 7E               LD A, (HL)
1395+ F6A3 B7               OR A
1396+ F6A4 C8               RET Z                                   ; sin estatua
1397+ F6A5 6F               LD L, A
1398+ F6A6 26 00            LD H, 0
1399+ F6A8 54               LD D, H
1400+ F6A9 5D               LD E, L
1401+ F6AA 29               ADD HL, HL
1402+ F6AB 19               ADD HL, DE                              ; HL = id*3
1403+ F6AC 11 FE E1         LD DE, BgGfxPtrById
1404+ F6AF 19               ADD HL, DE
1405+ F6B0 5E               LD E, (HL)
1406+ F6B1 23               INC HL
1407+ F6B2 56               LD D, (HL)                              ; DE = sprite ptr
1408+ F6B3 23               INC HL
1409+ F6B4 7E               LD A, (HL)                              ; A = bank
1410+ F6B5 EB               EX DE, HL                               ; HL = sprite ptr
1411+ F6B6 CD 7A 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1412+ F6B9                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1413+ F6B9 DD 21 9A 89      LD IX, BgSpriteBuffer
1414+ F6BD DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1415+ F6C0 B7               OR A
1416+ F6C1 C8               RET Z
1417+ F6C2 47               LD B, A                                 ; B = row counter
1418+ F6C3 DD 23            INC IX
1419+ F6C5 DD 23            INC IX                                  ; IX -> pixel data
1420+ F6C7                  ; Calcular addr VRAM en (origX, origY)
1421+ F6C7 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1422+ F6CA 57               LD D, A
1423+ F6CB 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1424+ F6CE 5F               LD E, A
1425+ F6CF CD A5 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1426+ F6D2              .csbsRow:
1427+ F6D2 C5               PUSH BC
1428+ F6D3 E5               PUSH HL                                 ; save inicio fila VRAM
1429+ F6D4                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1430+ F6D4 DD 7E 00         LD A, (IX+0)
1431+ F6D7 2F               CPL
1432+ F6D8 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1433+ F6D9 DD 7E 01         LD A, (IX+1)
1434+ F6DC 2F               CPL
1435+ F6DD 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1436+ F6DE                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1437+ F6DE 3A 02 F7         LD A, (.csbsJitter)
1438+ F6E1 B7               OR A
1439+ F6E2 28 0D            JR Z, .csbsWrite                        ; sin shift
1440+ F6E4 FA ED F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1441+ F6E7                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1442+ F6E7 CB 3A            SRL D
1443+ F6E9 CB 1B            RR E
1444+ F6EB 18 04            JR .csbsWrite
1445+ F6ED              .csbsLeft:
1446+ F6ED CB 23            SLA E
1447+ F6EF CB 12            RL D
1448+ F6F1              .csbsWrite:
1449+ F6F1 7A               LD A, D
1450+ F6F2 77               LD (HL), A
1451+ F6F3 23               INC HL
1452+ F6F4 7B               LD A, E
1453+ F6F5 77               LD (HL), A
1454+ F6F6 E1               POP HL
1455+ F6F7 CD 11 9E         CALL NextPixelLine                      ; HL = siguiente pixel row
1456+ F6FA DD 23            INC IX
1457+ F6FC DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1458+ F6FE C1               POP BC
1459+ F6FF 10 D1            DJNZ .csbsRow
1460+ F701 C9               RET
1461+ F702 00           .csbsJitter: DEFB 0
1462+ F703
1463+ F703              ; ==============================================================================
1464+ F703              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1465+ F703              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1466+ F703              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1467+ F703              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1468+ F703              ; Destruye: AF, BC, HL.
1469+ F703              ; ==============================================================================
1470+ F703              ChurchCutsceneEraseStatueDirect:
1471+ F703 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1472+ F706 57               LD D, A
1473+ F707 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1474+ F70A 5F               LD E, A
1475+ F70B CD A5 A0         CALL CalcPixelAddr
1476+ F70E 06 18            LD B, 24                                ; statues son 24 px de alto
1477+ F710              .csedRow:
1478+ F710 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1479+ F711 77               LD (HL), A
1480+ F712 23               INC HL
1481+ F713 77               LD (HL), A
1482+ F714 2B               DEC HL                                  ; volver a inicio fila
1483+ F715 C5               PUSH BC
1484+ F716 CD 11 9E         CALL NextPixelLine
1485+ F719 C1               POP BC
1486+ F71A 10 F4            DJNZ .csedRow
1487+ F71C C9               RET
1488+ F71D
1489+ F71D              ; ==============================================================================
1490+ F71D              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1491+ F71D              ; ==============================================================================
1492+ F71D              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1493+ F71D              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1494+ F71D              ; suficiente para corromper visualmente).
1495+ F71D              ; IN: IX = entity ptr.
1496+ F71D              ; ==============================================================================
1497+ F71D              RedrawTrappedMonster:
1498+ F71D                  ; --- Erase viejo en (OLDX, OLDY) ---
1499+ F71D CD 31 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1500+ F720 DD 7E 0D         LD A, (IX+ENT_OLDY)
1501+ F723 57               LD D, A
1502+ F724 DD 7E 0C         LD A, (IX+ENT_OLDX)
1503+ F727 5F               LD E, A
1504+ F728 DD E5            PUSH IX
1505+ F72A DD 2A B9 A7      LD IX, (OldSprAddr)
1506+ F72E CD 32 9D         CALL DrawSprite
1507+ F731 DD E1            POP IX
1508+ F733                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1509+ F733                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1510+ F733 DD 56 0D         LD D, (IX+ENT_OLDY)
1511+ F736 DD 5E 0C         LD E, (IX+ENT_OLDX)
1512+ F739 CD 9C D5         CALL RestoreOldAttr
1513+ F73C                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1514+ F73C                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1515+ F73C                  ; reponer attrs de pickups que el flujo de entidades pisa con
1516+ F73C                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1517+ F73C                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1518+ F73C                  ; estar bajo el monster.
1519+ F73C DD E5            PUSH IX
1520+ F73E CD 63 DC         CALL RefreshPickupAttrs
1521+ F741 DD E1            POP IX
1522+ F743                  ; --- Compute new draw pos ---
1523+ F743 CD BB A7         CALL CalcDrawX
1524+ F746 CD 32 A2         CALL ComputeEnemyDrawY
1525+ F749                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1526+ F749 CD 00 A8         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1527+ F74C 3A 82 82         LD A, (EnemyDrawY)
1528+ F74F 57               LD D, A
1529+ F750 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1530+ F753 5F               LD E, A
1531+ F754 DD E5            PUSH IX
1532+ F756 DD 2A 2F A8      LD IX, (SpriteAddrTemp)
1533+ F75A CD 4F 9E         CALL CalcEntityAttrSize
1534+ F75D DD E1            POP IX
1535+ F75F 3A 82 82         LD A, (EnemyDrawY)
1536+ F762 57               LD D, A
1537+ F763 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1538+ F766 5F               LD E, A
1539+ F767 DD 7E 05         LD A, (IX+ENT_ATTR)
1540+ F76A CD 22 9E         CALL SetEntityAttr
1541+ F76D                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1542+ F76D 3A 82 82         LD A, (EnemyDrawY)
1543+ F770 57               LD D, A
1544+ F771 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1545+ F774 5F               LD E, A
1546+ F775 DD E5            PUSH IX
1547+ F777 DD 2A 2F A8      LD IX, (SpriteAddrTemp)
1548+ F77B CD 32 9D         CALL DrawSprite
1549+ F77E DD E1            POP IX
1550+ F780                  ; --- Save OLD = current ---
1551+ F780 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1552+ F783 DD 77 0C         LD (IX+ENT_OLDX), A
1553+ F786 3A 82 82         LD A, (EnemyDrawY)
1554+ F789 DD 77 0D         LD (IX+ENT_OLDY), A
1555+ F78C DD 7E 00         LD A, (IX+ENT_SPRITEID)
1556+ F78F DD 77 0E         LD (IX+ENT_OLDSPRID), A
1557+ F792 C9               RET
