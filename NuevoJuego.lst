  11+ 87A5              ClearScreen:
  12+ 87A5 CD AF 0D         CALL ROM_CLS
  13+ 87A8 C9               RET
  14+ 87A9
  15+ 87A9              ; ==============================================================================
  16+ 87A9              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 87A9              ; ==============================================================================
  18+ 87A9              ; Entrada:
  19+ 87A9              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 87A9              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 87A9              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 87A9              ;
  23+ 87A9              ; Formato del sprite:
  24+ 87A9              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 87A9              ;   DEFB height_pixels
  26+ 87A9              ;   DEFB pixel_data... (width * height bytes)
  27+ 87A9              ;
  28+ 87A9              ; Dos paths:
  29+ 87A9              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 87A9              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 87A9              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 87A9              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 87A9              ;
  34+ 87A9              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 87A9              ; ==============================================================================
  36+ 87A9              DrawSprite:
  37+ 87A9                  ; Guardar posicion
  38+ 87A9 7A               LD A, D
  39+ 87AA 32 63 88         LD (.posY), A
  40+ 87AD 7B               LD A, E
  41+ 87AE 32 62 88         LD (.posX), A
  42+ 87B1
  43+ 87B1                  ; Leer cabecera sprite
  44+ 87B1 DD 7E 00         LD A, (IX+0)                ; width_bytes
  45+ 87B4 32 64 88         LD (.widthSave), A
  46+ 87B7 DD 7E 01         LD A, (IX+1)                ; height_pixels
  47+ 87BA 32 65 88         LD (.heightSave), A
  48+ 87BD DD 23            INC IX
  49+ 87BF DD 23            INC IX                      ; IX → pixel data
  50+ 87C1
  51+ 87C1                  ; === Y CLIPPING ===
  52+ 87C1                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  53+ 87C1 3A 63 88         LD A, (.posY)
  54+ 87C4 FE 10            CP SCREEN_MIN_Y
  55+ 87C6 30 20            JR NC, .clipTopDone
  56+ 87C8                  ; Filas a saltar = SCREEN_MIN_Y - Y
  57+ 87C8 47               LD B, A                     ; B = Y
  58+ 87C9 3E 10            LD A, SCREEN_MIN_Y
  59+ 87CB 90               SUB B                       ; A = filas a saltar
  60+ 87CC 47               LD B, A                     ; B = skip rows
  61+ 87CD                  ; Reducir altura
  62+ 87CD 3A 65 88         LD A, (.heightSave)
  63+ 87D0 90               SUB B
  64+ 87D1 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  65+ 87D2 D8               RET C                       ; Idem
  66+ 87D3 32 65 88         LD (.heightSave), A
  67+ 87D6                  ; Avanzar IX: skip_rows * width_bytes
  68+ 87D6 3A 64 88         LD A, (.widthSave)
  69+ 87D9 4F               LD C, A
  70+ 87DA              .clipSkipRow:
  71+ 87DA 79               LD A, C
  72+ 87DB              .clipSkipByte:
  73+ 87DB DD 23            INC IX
  74+ 87DD 3D               DEC A
  75+ 87DE 20 FB            JR NZ, .clipSkipByte
  76+ 87E0 10 F8            DJNZ .clipSkipRow
  77+ 87E2                  ; Ajustar Y al borde
  78+ 87E2 3E 10            LD A, SCREEN_MIN_Y
  79+ 87E4 32 63 88         LD (.posY), A
  80+ 87E7 57               LD D, A
  81+ 87E8              .clipTopDone:
  82+ 87E8                  ; Clip inferior: si Y + height > 192, reducir altura
  83+ 87E8 3A 63 88         LD A, (.posY)
  84+ 87EB 47               LD B, A
  85+ 87EC 3A 65 88         LD A, (.heightSave)
  86+ 87EF 80               ADD A, B                    ; A = Y + height
  87+ 87F0 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
  88+ 87F2 FE C0            CP 192
  89+ 87F4 38 08            JR C, .clipBotDone          ; Dentro de pantalla
  90+ 87F6              .clipBot:
  91+ 87F6                  ; Reducir altura: new_height = 192 - Y
  92+ 87F6 3E C0            LD A, 192
  93+ 87F8 90               SUB B                       ; A = 192 - Y
  94+ 87F9 C8               RET Z
  95+ 87FA D8               RET C
  96+ 87FB 32 65 88         LD (.heightSave), A
  97+ 87FE              .clipBotDone:
  98+ 87FE
  99+ 87FE                  ; Comprobar alineacion
 100+ 87FE 7B               LD A, E
 101+ 87FF E6 07            AND 7
 102+ 8801 20 1E            JR NZ, .shifted
