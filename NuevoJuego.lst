 269+ F8E0              ; ==============================================================================
 270+ F8E0              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 271+ F8E0              ; ==============================================================================
 272+ F8E0              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 273+ F8E0              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 274+ F8E0              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 275+ F8E0              BankCutsceneSnapToDoor:
 276+ F8E0 DD 21 9E 81      LD IX, EntityTable
 277+ F8E4 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 278+ F8E8 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 279+ F8EC DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 280+ F8F0 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 281+ F8F2 32 DF 82         LD (PlayerDrawY), A
 282+ F8F5 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 283+ F8F7 DD 77 00         LD (IX+ENT_SPRITEID), A
 284+ F8FA 3E 0A            LD A, SPRID_WALK_N
 285+ F8FC DD 77 08         LD (IX+ENT_ANIMBASE), A
 286+ F8FF AF               XOR A
 287+ F900 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 288+ F903 C3 9E 63         JP TownGateRedrawPlayer
