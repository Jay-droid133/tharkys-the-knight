4795+ BD4C              ; --- Tabla de tipos de nasty (SpriteID base) ---
4796+ BD4C              ; --- Tablas de nasties por momento del dia ---
4797+ BD4C              NUM_NASTY_TYPES EQU 4
4798+ BD4C              DiurnalTypeTable:                       ; DY, C1, A2
4799+ BD4C 30               DEFB SPRID_ENEMY_4          ; Eagle
4800+ BD4D 20               DEFB SPRID_ENEMY_0          ; Spider
4801+ BD4E 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
4802+ BD4F 2C               DEFB SPRID_ENEMY_3          ; Snake
4803+ BD50              CrepuscularTypeTable:                   ; C2, N1
4804+ BD50 34               DEFB SPRID_ENEMY_5          ; Rat
