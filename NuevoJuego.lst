 706+ E849                  ; --- Aguja de horas ---
 707+ E849 3A 65 E8         LD A, (PlazaLastHour)
 708+ E84C 21 57 E4         LD HL, HourHandPtrs
 709+ E84F CD 67 E8         CALL DrawPlazaHandLine
 710+ E852
 711+ E852                  ; --- Aguja de minutos ---
 712+ E852 3A 66 E8         LD A, (PlazaLastMin)
 713+ E855 21 73 E3         LD HL, MinHandPtrs
 714+ E858 CD 67 E8         CALL DrawPlazaHandLine
 715+ E85B
 716+ E85B                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 717+ E85B 21 7D 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 718+ E85E 7E               LD A, (HL)
 719+ E85F 23               INC HL
 720+ E860 66               LD H, (HL)
 721+ E861 6F               LD L, A                     ; HL = dir VRAM scan line 7
 722+ E862 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 723+ E864 C9               RET
