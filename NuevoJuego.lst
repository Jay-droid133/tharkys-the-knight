 246+ E499              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 247+ E499              DrawSwordModeHUD:
 248+ E499 3A 71 B3         LD A, (SwordMode)
 249+ E49C 21 CC E4         LD HL, .modeChars
 250+ E49F 5F               LD E, A
 251+ E4A0 16 00            LD D, 0
 252+ E4A2 19               ADD HL, DE
 253+ E4A3 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E4A4                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E4A4 21 00 40         LD HL, $4000
 256+ E4A7                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E4A7 5F               LD E, A
 258+ E4A8 16 00            LD D, 0
 259+ E4AA 42               LD B, D                             ; B = 0
 260+ E4AB CB 23            SLA E
 260+ E4AD CB 12          RL D                        ; *2
 261+ E4AF CB 23            SLA E
 261+ E4B1 CB 12          RL D                        ; *4
 262+ E4B3 CB 23            SLA E
 262+ E4B5 CB 12          RL D                        ; *8
 263+ E4B7 E5               PUSH HL
 264+ E4B8 21 00 3C         LD HL, $3C00
 265+ E4BB 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E4BC EB               EX DE, HL                           ; DE = glyph
 267+ E4BD E1               POP HL                              ; HL = VRAM
 268+ E4BE 06 08            LD B, 8
 269+ E4C0              .drawChar:
 270+ E4C0 1A               LD A, (DE)
 271+ E4C1 77               LD (HL), A
 272+ E4C2 13               INC DE
 273+ E4C3 24               INC H                               ; siguiente scan line
 274+ E4C4 10 FA            DJNZ .drawChar
 275+ E4C6                  ; Attr: fila 0, col 0 = $5800
 276+ E4C6 3E 47            LD A, $47                           ; blanco bright
 277+ E4C8 32 00 58         LD ($5800), A
 278+ E4CB C9               RET
 279+ E4CC
 280+ E4CC 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 281+ E4CF
 282+ E4CF              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 283+ E4CF              DrawNoclipHUD:
 284+ E4CF 3A AF 82         LD A, (NoclipMode)
 285+ E4D2 B7               OR A
 286+ E4D3 20 0E            JR NZ, .ncOn
 287+ E4D5 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 288+ E4D7 1E 1E            LD E, 30
 289+ E4D9 CD 04 E7         CALL DrawHudChar
 290+ E4DC 3E 20            LD A, 32
 291+ E4DE 1E 1F            LD E, 31
 292+ E4E0 C3 04 E7         JP DrawHudChar
 293+ E4E3              .ncOn:
 294+ E4E3 3E 4E            LD A, 'N'
 295+ E4E5 1E 1E            LD E, 30
