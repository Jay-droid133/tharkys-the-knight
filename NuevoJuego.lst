 329+ 73D7                  ; Tick sonando: override del char activo a MAGIC_COMPASS_ACTIVE_ATTR
 330+ 73D7                  ; ($47 = white bright). Los pixels del sprite los pinta el editor;
 331+ 73D7                  ; para que la silueta no se "invierta" al cambiar paper/ink, diseña
 332+ 73D7                  ; el char correspondiente con paper black + ink negro (la silueta vive
 333+ 73D7                  ; en los píxeles encendidos, que pasan a ink white bright en el flash).
 334+ 73D7 3A C1 5F         LD A, (MagicCompassPathDir)
 335+ 73DA 5F               LD E, A
 336+ 73DB 16 00            LD D, 0
 337+ 73DD 21 ED 73         LD HL, .pmcaDirToOffset
 338+ 73E0 19               ADD HL, DE
 339+ 73E1 7E               LD A, (HL)
 340+ 73E2 5F               LD E, A
 341+ 73E3 16 00            LD D, 0
 342+ 73E5 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 343+ 73E8 19               ADD HL, DE                           ; HL = addr del char activo (attr area)
 344+ 73E9 3E 47            LD A, MAGIC_COMPASS_ACTIVE_ATTR
