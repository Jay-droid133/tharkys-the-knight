 398+ 8F49              ; ==============================================================================
 399+ 8F49              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 8F49              ; ==============================================================================
 401+ 8F49              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 8F49              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 8F49              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 8F49              ; al room vecino.
 405+ 8F49              ;
 406+ 8F49              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 8F49              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 8F49              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 8F49              ;
 410+ 8F49              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 8F49              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 8F49              ; ==============================================================================
 413+ 8F49              WipeMonsterSlot:
 414+ 8F49 DD E5            PUSH IX
 415+ 8F4B E1               POP HL
 416+ 8F4C 11 A4 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 8F4F B7               OR A
 418+ 8F50 ED 52            SBC HL, DE
 419+ 8F52 CB 3D            SRL L
 420+ 8F54 CB 3D            SRL L
 421+ 8F56 CB 3D            SRL L
 422+ 8F58 CB 3D            SRL L                               ; HL = slot * 1
 423+ 8F5A 5D               LD E, L
 424+ 8F5B 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 8F5D
 426+ 8F5D 21 8C 8D         LD HL, MonsterAiFlags
 427+ 8F60 19               ADD HL, DE
 428+ 8F61 36 00            LD (HL), 0
 429+ 8F63 21 80 8D         LD HL, MonsterRoomId
 430+ 8F66 19               ADD HL, DE
 431+ 8F67 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 8F69 21 86 8D         LD HL, MonsterEntryBorder
 433+ 8F6C 19               ADD HL, DE
 434+ 8F6D 36 00            LD (HL), 0
 435+ 8F6F 21 89 8D         LD HL, MonsterExitCoord
 436+ 8F72 19               ADD HL, DE
 437+ 8F73 36 00            LD (HL), 0
 438+ 8F75 21 52 B3         LD HL, MonsterReturnTimer
 439+ 8F78 19               ADD HL, DE
 440+ 8F79 36 00            LD (HL), 0
 441+ 8F7B 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 8F7E 19               ADD HL, DE
 443+ 8F7F 36 00            LD (HL), 0
 444+ 8F81 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 8F84 19               ADD HL, DE
 446+ 8F85 36 00            LD (HL), 0
 447+ 8F87 C9               RET
