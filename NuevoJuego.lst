 507+ EC88              ; ==============================================================================
 508+ EC88              ; ApplyRayoBuff - speed boost 1.5x durante 15s (color via cycler)
 509+ EC88              ; ==============================================================================
 510+ EC88              ; "Last wins": llamar de nuevo resetea timer + override estado actual.
 511+ EC88              ; ==============================================================================
 512+ EC88              ApplyRayoBuff:
 513+ EC88 3E 06            LD A, SPEED_BUFF_RAYO_RUN
 514+ EC8A 32 DD 82         LD (PlayerSpeedRun), A
 515+ EC8D 3E 03            LD A, SPEED_BUFF_RAYO_FIGHT
 516+ EC8F 32 DE 82         LD (PlayerSpeedFight), A
 517+ EC92 21 FA 00         LD HL, SPEED_BUFF_RAYO_FRAMES
 518+ EC95 22 DF 82         LD (SpeedBuffTimer), HL
 519+ EC98 3E 01            LD A, SPEED_BUFF_TYPE_RAYO
 520+ EC9A 32 E1 82         LD (SpeedBuffType), A
 521+ EC9D                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 522+ EC9D C9               RET
 523+ EC9E
 524+ EC9E              ; ==============================================================================
 525+ EC9E              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 526+ EC9E              ; ==============================================================================
 527+ EC9E              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 528+ EC9E              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 529+ EC9E              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 530+ EC9E              ; ==============================================================================
 531+ EC9E              ApplyMushroomBuff:
 532+ EC9E 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 533+ ECA1 22 E2 82         LD (MushroomLockTimer), HL
 534+ ECA4                  ; Antagonista 'last wins': SETA cancela ESPADA (ambos tocan can-attack).
 535+ ECA4 21 00 00         LD HL, 0
 536+ ECA7 22 DA 5F         LD (EspadaTimer), HL
 537+ ECAA                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 538+ ECAA C9               RET
 539+ ECAB
 540+ ECAB              ; ==============================================================================
 541+ ECAB              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 542+ ECAB              ; ==============================================================================
 543+ ECAB              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 544+ ECAB              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 545+ ECAB              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 546+ ECAB              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 547+ ECAB              ; si no, restaura WHITE | $40.
 548+ ECAB              ; ==============================================================================
 549+ ECAB              UpdateMushroomBuffBody:
 550+ ECAB 2A E2 82         LD HL, (MushroomLockTimer)
 551+ ECAE 7C               LD A, H
 552+ ECAF B5               OR L
 553+ ECB0 C8               RET Z                               ; sin debuff
 554+ ECB1 2B               DEC HL
 555+ ECB2 22 E2 82         LD (MushroomLockTimer), HL
 556+ ECB5 C9               RET                                 ; (color lo pinta el cycler segun timer)
 557+ ECB6
 558+ ECB6              ; ==============================================================================
 559+ ECB6              ; ApplyEspadaBuff - ESPADA (no consume stamina + ataca a 0 + cancela cooldown)
 560+ ECB6              ; ==============================================================================
 561+ ECB6              ; Duracion: ESPADA_BUFF_FRAMES (12s). Player rojo bright (color via cycler).
 562+ ECB6              ; Antagonista 'last wins' con SETA — cancela MushroomLockTimer al activarse.
 563+ ECB6              ; Gates en logic_game.asm: SelectSwordMode fuerza mode 2, stamina drain skip,
 564+ ECB6              ; AttackCooldown set skip.
