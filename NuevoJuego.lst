 137  6D10
 138  6D10                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 139  6D10                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 140  6D10                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6D10              ; ==============================================================================
   2+ 6D10              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6D10              ; ==============================================================================
   4+ 6D10              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6D10              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6D10              ;
   7+ 6D10              ; Diseño beeper-style:
   8+ 6D10              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6D10              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6D10              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6D10              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6D10              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6D10              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6D10              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6D10              ;     hits clasicos en 48K).
  16+ 6D10              ;   - AY_UpdatePlayerHit se llama cada frame desde MainLoop (cold path: salta
  17+ 6D10              ;     en RET Z si no hay sweep activo).
  18+ 6D10              ;
  19+ 6D10              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  20+ 6D10              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  21+ 6D10              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  22+ 6D10              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  23+ 6D10              ;
  24+ 6D10              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  25+ 6D10              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  26+ 6D10              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  27+ 6D10              ;
  28+ 6D10              ; Llamado desde:
  29+ 6D10              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  30+ 6D10              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  31+ 6D10              ;   - MainLoop cada frame — update.
  32+ 6D10              ; ==============================================================================
  33+ 6D10
  34+ 6D10              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  35+ 6D10 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  36+ 6D11 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  37+ 6D13 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  38+ 6D15 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  39+ 6D16                                                ; (0 = inactivo o ya muteado)
  40+ 6D16
  41+ 6D16              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  42+ 6D16              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  43+ 6D16              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  44+ 6D16              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  45+ 6D16
  46+ 6D16              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  47+ 6D16              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  48+ 6D16              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  49+ 6D16              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  50+ 6D16
  51+ 6D16              ; ==============================================================================
  52+ 6D16              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  53+ 6D16              ; ==============================================================================
  54+ 6D16              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  55+ 6D16              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  56+ 6D16              ; tabla los hardcodea.
  57+ 6D16              ; ==============================================================================
  58+ 6D16              AY_PlayPlayerHit:
  59+ 6D16 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  60+ 6D19 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  61+ 6D1B 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  62+ 6D1E 18 08            JR _AY_PlaySweep
  63+ 6D20
  64+ 6D20              AY_PlayPlayerDeath:
  65+ 6D20 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  66+ 6D23 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  67+ 6D25 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  68+ 6D28                  ; fall through
  69+ 6D28
  70+ 6D28              ; IN: HL=period inicial, B=frames, DE=delta.
  71+ 6D28              _AY_PlaySweep:
  72+ 6D28 22 11 6D         LD (PlayerHitPeriod), HL
  73+ 6D2B ED 53 13 6D      LD (PlayerHitDelta), DE
  74+ 6D2F 78               LD A, B
  75+ 6D30 32 10 6D         LD (PlayerHitFrames), A
  76+ 6D33 F3               DI
  77+ 6D34 0E FD            LD C, $FD
  78+ 6D36 21 3C 6D         LD HL, .phRegs
  79+ 6D39 C3 6D 6D         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  80+ 6D3C
  81+ 6D3C              .phRegs:
  82+ 6D3C 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  83+ 6D3E 03 00            DEFB  3, $00          ; R3  = period B hi
  84+ 6D40 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  85+ 6D42 07 3D            DEFB  7, $3D          ; R7  = mixer (tono B on, A/C off, noise off)
  86+ 6D44 FF               DEFB $FF              ; sentinel
  87+ 6D45
  88+ 6D45              ; ==============================================================================
  89+ 6D45              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  90+ 6D45              ; ==============================================================================
  91+ 6D45              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  92+ 6D45              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  93+ 6D45              ; Canal B (center stereo ABC). No bloqueante.
  94+ 6D45              ;
  95+ 6D45              ; IN: HL = period AY canal B (mayor = mas grave).
  96+ 6D45              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
  97+ 6D45              ;
  98+ 6D45              ; Sugerencias:
  99+ 6D45              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 100+ 6D45              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 101+ 6D45              ; Destruye: A, BC, HL.
 102+ 6D45              ; ==============================================================================
 103+ 6D45              AY_PlayBeep:
 104+ 6D45 78               LD A, B
 105+ 6D46 32 15 6D         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 106+ 6D49 F3               DI
 107+ 6D4A 0E FD            LD C, $FD
 108+ 6D4C                  ; R2 = L (period B lo)
 109+ 6D4C 3E 02            LD A, 2
 110+ 6D4E 06 FF            LD B, $FF
 111+ 6D50 ED 79            OUT (C), A
 112+ 6D52 7D               LD A, L
 113+ 6D53 06 BF            LD B, $BF
 114+ 6D55 ED 79            OUT (C), A
 115+ 6D57                  ; R3 = H (period B hi)
 116+ 6D57 3E 03            LD A, 3
 117+ 6D59 06 FF            LD B, $FF
 118+ 6D5B ED 79            OUT (C), A
 119+ 6D5D 7C               LD A, H
 120+ 6D5E 06 BF            LD B, $BF
 121+ 6D60 ED 79            OUT (C), A
 122+ 6D62                  ; R9 = $0F (vol max fija, SIN envelope), R7 = mixer (B tono only)
 123+ 6D62 21 68 6D         LD HL, .beepRegs
 124+ 6D65 C3 6D 6D         JP _AY_WriteRegPairs                ; tail call: EI + RET
 125+ 6D68
 126+ 6D68              .beepRegs:
 127+ 6D68 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 128+ 6D6A 07 3D            DEFB  7, $3D          ; mixer (B tono on, A/C off, noise off)
 129+ 6D6C FF               DEFB $FF              ; sentinel
 130+ 6D6D
 131+ 6D6D              ; ==============================================================================
 132+ 6D6D              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 133+ 6D6D              ; ==============================================================================
 134+ 6D6D              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 135+ 6D6D              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 136+ 6D6D              ; ==============================================================================
 137+ 6D6D              _AY_WriteRegPairs:
 138+ 6D6D 7E               LD A, (HL)
 139+ 6D6E FE FF            CP $FF
 140+ 6D70 28 0D            JR Z, .awrpDone
 141+ 6D72 06 FF            LD B, $FF
 142+ 6D74 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 143+ 6D76 23               INC HL
 144+ 6D77 06 BF            LD B, $BF
 145+ 6D79 7E               LD A, (HL)
 146+ 6D7A ED 79            OUT (C), A                          ; AY data ($BFFD)
 147+ 6D7C 23               INC HL
 148+ 6D7D 18 EE            JR _AY_WriteRegPairs
 149+ 6D7F              .awrpDone:
 150+ 6D7F FB               EI
 151+ 6D80 C9               RET
 152+ 6D81
 153+ 6D81              ; ==============================================================================
 154+ 6D81              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave
 155+ 6D81              ; ==============================================================================
 156+ 6D81              ; Llamar cada frame desde MainLoop. No-op si sweep inactivo (frames=0).
 157+ 6D81              ; Destruye: A, BC, DE, HL.
 158+ 6D81              ; ==============================================================================
 159+ 6D81              AY_UpdatePlayerHit:
 160+ 6D81 3A 10 6D         LD A, (PlayerHitFrames)
 161+ 6D84 B7               OR A
 162+ 6D85 28 2C            JR Z, .uphCheckBeep
 163+ 6D87 3D               DEC A
 164+ 6D88 32 10 6D         LD (PlayerHitFrames), A
 165+ 6D8B 28 30            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 166+ 6D8D
 167+ 6D8D 2A 11 6D         LD HL, (PlayerHitPeriod)
 168+ 6D90 ED 5B 13 6D      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 169+ 6D94 19               ADD HL, DE
 170+ 6D95 22 11 6D         LD (PlayerHitPeriod), HL
 171+ 6D98
 172+ 6D98                  ; Escribir R2 = L, R3 = H (period B)
 173+ 6D98 F3               DI
 174+ 6D99 0E FD            LD C, $FD
 175+ 6D9B 3E 02            LD A, 2
 176+ 6D9D 06 FF            LD B, $FF
 177+ 6D9F ED 79            OUT (C), A
 178+ 6DA1 7D               LD A, L
 179+ 6DA2 06 BF            LD B, $BF
 180+ 6DA4 ED 79            OUT (C), A
 181+ 6DA6 3E 03            LD A, 3
 182+ 6DA8 06 FF            LD B, $FF
 183+ 6DAA ED 79            OUT (C), A
 184+ 6DAC 7C               LD A, H
 185+ 6DAD 06 BF            LD B, $BF
 186+ 6DAF ED 79            OUT (C), A
 187+ 6DB1 FB               EI
 188+ 6DB2 C9               RET
 189+ 6DB3
 190+ 6DB3              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 191+ 6DB3              .uphCheckBeep:
 192+ 6DB3 3A 15 6D         LD A, (BeepDurationFrames)
 193+ 6DB6 B7               OR A
 194+ 6DB7 C8               RET Z
 195+ 6DB8 3D               DEC A
 196+ 6DB9 32 15 6D         LD (BeepDurationFrames), A
 197+ 6DBC C0               RET NZ
 198+ 6DBD                  ; fall-through al cutoff compartido
 199+ 6DBD
 200+ 6DBD              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Beeper-style. ---
 201+ 6DBD              ; Llamado al final del sweep (PlayerHit/Death) y al final del beep.
 202+ 6DBD              _uphMuteR9:
 203+ 6DBD F3               DI
 204+ 6DBE 01 FD FF         LD BC, $FFFD
 205+ 6DC1 3E 09            LD A, 9
 206+ 6DC3 ED 79            OUT (C), A
 207+ 6DC5 01 FD BF         LD BC, $BFFD
 208+ 6DC8 AF               XOR A
 209+ 6DC9 ED 79            OUT (C), A
 210+ 6DCB FB               EI
 211+ 6DCC C9               RET
