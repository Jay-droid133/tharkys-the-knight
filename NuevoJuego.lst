 503+ E679              ; --- Helpers ---
 504+ E679              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E679              .drawDec2:
 506+ E679 4B               LD C, E                     ; guardar columna inicial
 507+ E67A 06 00            LD B, 0                     ; decenas
 508+ E67C              .divLoop:
 509+ E67C FE 0A            CP 10
 510+ E67E 38 05            JR C, .divDone
 511+ E680 D6 0A            SUB 10
 512+ E682 04               INC B
 513+ E683 18 F7            JR .divLoop
 514+ E685              .divDone:
 515+ E685                  ; B = decenas, A = unidades
 516+ E685 F5               PUSH AF                     ; guardar unidades
 517+ E686 78               LD A, B
 518+ E687 C6 30            ADD A, '0'
 519+ E689 59               LD E, C
 520+ E68A C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E68B CD C1 E7         CALL DrawHudChar
 522+ E68E C1               POP BC                      ; restaurar C
 523+ E68F F1               POP AF
 524+ E690 C6 30            ADD A, '0'
 525+ E692 59               LD E, C
 526+ E693 1C               INC E
 527+ E694 C3 C1 E7         JP DrawHudChar              ; tail call
