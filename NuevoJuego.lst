 441+ EC33              ; ==============================================================================
 442+ EC33              ; ApplyMushroomBuff - bloquea ataque durante MUSHROOM_LOCK_FRAMES + player MAGENTA
 443+ EC33              ; ==============================================================================
 444+ EC33              ; Concurrencia: convive con speed buffs (rayo/caracol). El color magenta
 445+ EC33              ; gana mientras el mushroom timer > 0 (UpdateMushroomBuff corre tras
 446+ EC33              ; UpdateSpeedBuff y sobreescribe ENT_ATTR).
 447+ EC33              ; ==============================================================================
 448+ EC33              ApplyMushroomBuff:
 449+ EC33 21 7D 00         LD HL, MUSHROOM_LOCK_FRAMES
 450+ EC36 22 DC 82         LD (MushroomLockTimer), HL
 451+ EC39                  ; Antagonista 'last wins': SETA cancela ESPADA (ambos tocan can-attack).
 452+ EC39 21 00 00         LD HL, 0
 453+ EC3C 22 DA 5F         LD (EspadaTimer), HL
 454+ EC3F                  ; (color player lo pinta UpdatePlayerColorCycler segun timer activo)
 455+ EC3F C9               RET
 456+ EC40
 457+ EC40              ; ==============================================================================
 458+ EC40              ; UpdateMushroomBuff - tick 16-bit timer; reaplica color cada frame; expira al 0
 459+ EC40              ; ==============================================================================
 460+ EC40              ; Llamado desde MainLoop tras UpdateSpeedBuff. Si timer=0, no-op rapido.
 461+ EC40              ; Mientras timer>0: reescribe player ENT_ATTR a magenta cada frame (gana
 462+ EC40              ; sobre cualquier color de speed buff). Al expirar: si hay speed buff
 463+ EC40              ; activo, lo deja con su color (UpdateSpeedBuff ya lo escribio este frame);
 464+ EC40              ; si no, restaura WHITE | $40.
 465+ EC40              ; ==============================================================================
 466+ EC40              UpdateMushroomBuffBody:
 467+ EC40 2A DC 82         LD HL, (MushroomLockTimer)
 468+ EC43 7C               LD A, H
 469+ EC44 B5               OR L
 470+ EC45 C8               RET Z                               ; sin debuff
 471+ EC46 2B               DEC HL
 472+ EC47 22 DC 82         LD (MushroomLockTimer), HL
 473+ EC4A C9               RET                                 ; (color lo pinta el cycler segun timer)
 474+ EC4B
 475+ EC4B              ; ==============================================================================
 476+ EC4B              ; ApplyEspadaBuff - ESPADA (no consume stamina + ataca a 0 + cancela cooldown)
 477+ EC4B              ; ==============================================================================
 478+ EC4B              ; Duracion: ESPADA_BUFF_FRAMES (12s). Player rojo bright (color via cycler).
 479+ EC4B              ; Antagonista 'last wins' con SETA — cancela MushroomLockTimer al activarse.
 480+ EC4B              ; Gates en logic_game.asm: SelectSwordMode fuerza mode 2, stamina drain skip,
 481+ EC4B              ; AttackCooldown set skip.
 482+ EC4B              ; ==============================================================================
 483+ EC4B              ApplyEspadaBuff:
 484+ EC4B 21 2C 01         LD HL, ESPADA_BUFF_FRAMES
 485+ EC4E 22 DA 5F         LD (EspadaTimer), HL
 486+ EC51 21 00 00         LD HL, 0
 487+ EC54 22 DC 82         LD (MushroomLockTimer), HL          ; antagonista last wins
 488+ EC57 C9               RET
