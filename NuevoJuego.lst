1008+ A85B              ; ==============================================================================
1009+ A85B              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
1010+ A85B              ; ==============================================================================
1011+ A85B              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
1012+ A85B              ; IX = puntero a la entidad
1013+ A85B              ; ==============================================================================
1014+ A85B              DrawEntity:
1015+ A85B CD 90 A8         CALL GetSpriteAddr
1016+ A85E
1017+ A85E                  ; Guardar attrs del fondo ANTES de pintar
1018+ A85E DD 56 04         LD D, (IX+ENT_POSY)
1019+ A861 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1020+ A864 5F               LD E, A
1021+ A865 DD E5            PUSH IX
1022+ A867 DD 2A BF A8      LD IX, (SpriteAddrTemp)
1023+ A86B CD 2C 9F         CALL SaveEntityAttr
1024+ A86E DD E1            POP IX
1025+ A870
1026+ A870                  ; Pintar atributo ANTES del draw
1027+ A870 DD 56 04         LD D, (IX+ENT_POSY)
1028+ A873 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1029+ A876 5F               LD E, A
1030+ A877 DD 7E 05         LD A, (IX+ENT_ATTR)
1031+ A87A CD BE 9E         CALL SetEntityAttr
1032+ A87D
1033+ A87D                  ; XOR draw del sprite
1034+ A87D DD 56 04         LD D, (IX+ENT_POSY)
1035+ A880 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1036+ A883 5F               LD E, A
1037+ A884 DD E5            PUSH IX
1038+ A886 DD 2A BF A8      LD IX, (SpriteAddrTemp)
