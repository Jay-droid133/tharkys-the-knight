 171+ A170                  ; Limpiar tabla de atributos salvados
 172+ A170 21 BD 9E         LD HL, SavedAttrTable
 173+ A173 11 BE 9E         LD DE, SavedAttrTable + 1
 174+ A176 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ A179 AF               XOR A
 176+ A17A 77               LD (HL), A
 177+ A17B ED B0            LDIR
