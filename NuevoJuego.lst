 366+ E477              ; ==============================================================================
 367+ E477              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E477              ; ==============================================================================
 369+ E477              ; Entrada: A = sprite ID
 370+ E477              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E477              ; Preserva: A, DE, IX
 372+ E477              ;
 373+ E477              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E477              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E477              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E477              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E477              ; ==============================================================================
 378+ E477              CheckIfHouseSprite:
 379+ E477 F5               PUSH AF
 380+ E478 E5               PUSH HL
 381+ E479 C5               PUSH BC
 382+ E47A
 383+ E47A 47               LD B, A                     ; B = id buscado
 384+ E47B
 385+ E47B AF               XOR A
 386+ E47C 32 D8 E2         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E47F
 388+ E47F 21 90 DF         LD HL, HouseIdList
 389+ E482              .checkLoop:
 390+ E482 7E               LD A, (HL)
 391+ E483 FE FF            CP $FF
 392+ E485 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E487 B8               CP B
 394+ E488 28 03            JR Z, .checkFound
 395+ E48A 23               INC HL
 396+ E48B 18 F5            JR .checkLoop
 397+ E48D
 398+ E48D              .checkFound:
 399+ E48D 3E 01            LD A, 1
 400+ E48F 32 D8 E2         LD (BgSpriteIsHouse), A
 401+ E492
 402+ E492              .checkDone:
 403+ E492 C1               POP BC
 404+ E493 E1               POP HL
 405+ E494 F1               POP AF
 406+ E495 C9               RET
 407+ E496
 408+ E496              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E496              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E496              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E496
 412+ E496              ; ==============================================================================
 413+ E496              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 414+ E496              ; ==============================================================================
 415+ E496              ; Formato: XX,YY:NN nombre_room     DY
 416+ E496              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 417+ E496              ; ==============================================================================
 418+ E496              DrawRoomInfo:
 419+ E496                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E496 1E 00            LD E, 0
 421+ E498 06 0D            LD B, 13
 422+ E49A              .clearLoop:
 423+ E49A C5               PUSH BC
 424+ E49B D5               PUSH DE
 425+ E49C 3E 20            LD A, ' '
 426+ E49E CD 51 E6         CALL DrawHudChar
 427+ E4A1 D1               POP DE
 428+ E4A2 C1               POP BC
 429+ E4A3 1C               INC E
 430+ E4A4 10 F4            DJNZ .clearLoop
 431+ E4A6
 432+ E4A6                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 433+ E4A6 3A 0B 83         LD A, (CurrentScreenX)
 434+ E4A9 1E 00            LD E, 0
 435+ E4AB CD 09 E5         CALL .drawDec2
 436+ E4AE
 437+ E4AE                  ; --- ',' en col 2 ---
 438+ E4AE 3E 2C            LD A, ','
 439+ E4B0 1E 02            LD E, 2
 440+ E4B2 CD 51 E6         CALL DrawHudChar
 441+ E4B5
 442+ E4B5                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E4B5 3A 0C 83         LD A, (CurrentScreenY)
 444+ E4B8 1E 03            LD E, 3
 445+ E4BA CD 09 E5         CALL .drawDec2
 446+ E4BD
 447+ E4BD                  ; --- ':' en col 5 ---
 448+ E4BD 3E 3A            LD A, ':'
 449+ E4BF 1E 05            LD E, 5
 450+ E4C1 CD 51 E6         CALL DrawHudChar
 451+ E4C4
 452+ E4C4                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E4C4 3A 0C 83         LD A, (CurrentScreenY)
 454+ E4C7 6F               LD L, A
 455+ E4C8 26 00            LD H, 0
 456+ E4CA 29               ADD HL, HL
 457+ E4CB 29               ADD HL, HL
 458+ E4CC 29               ADD HL, HL
 459+ E4CD 29               ADD HL, HL                  ; HL = Y * 16
 460+ E4CE 3A 0B 83         LD A, (CurrentScreenX)
 461+ E4D1 5F               LD E, A
 462+ E4D2 16 00            LD D, 0
 463+ E4D4 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E4D5 11 ED DD         LD DE, MapTable
 465+ E4D8 19               ADD HL, DE
 466+ E4D9 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E4DA F5               PUSH AF                     ; guardar room index
 468+ E4DB
 469+ E4DB                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E4DB F5               PUSH AF
 471+ E4DC 0F               RRCA
 472+ E4DD 0F               RRCA
 473+ E4DE 0F               RRCA
 474+ E4DF 0F               RRCA
 475+ E4E0 E6 0F            AND $0F
 476+ E4E2 CD 27 E5         CALL .hexToAscii
 477+ E4E5 1E 06            LD E, 6
 478+ E4E7 CD 51 E6         CALL DrawHudChar
 479+ E4EA F1               POP AF
 480+ E4EB E6 0F            AND $0F
 481+ E4ED CD 27 E5         CALL .hexToAscii
 482+ E4F0 1E 07            LD E, 7
 483+ E4F2 CD 51 E6         CALL DrawHudChar
 484+ E4F5
 485+ E4F5                  ; --- Espacio en col 8 ---
 486+ E4F5 3E 20            LD A, ' '
 487+ E4F7 1E 08            LD E, 8
 488+ E4F9 CD 51 E6         CALL DrawHudChar
 489+ E4FC
 490+ E4FC                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E4FC F1               POP AF                      ; A = room index (descartar)
 492+ E4FD
 493+ E4FD                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E4FD 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E500 3E 47            LD A, $47                   ; bright white on black
 496+ E502 06 0D            LD B, 13
 497+ E504              .attrLoop:
 498+ E504 77               LD (HL), A
 499+ E505 23               INC HL
 500+ E506 10 FC            DJNZ .attrLoop
 501+ E508 C9               RET
 502+ E509
 503+ E509              ; --- Helpers ---
 504+ E509              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E509              .drawDec2:
 506+ E509 4B               LD C, E                     ; guardar columna inicial
 507+ E50A 06 00            LD B, 0                     ; decenas
 508+ E50C              .divLoop:
 509+ E50C FE 0A            CP 10
 510+ E50E 38 05            JR C, .divDone
 511+ E510 D6 0A            SUB 10
 512+ E512 04               INC B
 513+ E513 18 F7            JR .divLoop
 514+ E515              .divDone:
 515+ E515                  ; B = decenas, A = unidades
 516+ E515 F5               PUSH AF                     ; guardar unidades
 517+ E516 78               LD A, B
 518+ E517 C6 30            ADD A, '0'
 519+ E519 59               LD E, C
 520+ E51A C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E51B CD 51 E6         CALL DrawHudChar
 522+ E51E C1               POP BC                      ; restaurar C
 523+ E51F F1               POP AF
 524+ E520 C6 30            ADD A, '0'
 525+ E522 59               LD E, C
 526+ E523 1C               INC E
 527+ E524 C3 51 E6         JP DrawHudChar              ; tail call
 528+ E527
 529+ E527              .hexToAscii:
 530+ E527 FE 0A            CP 10
 531+ E529 38 03            JR C, .isDigit
 532+ E52B C6 37            ADD A, 'A' - 10
 533+ E52D C9               RET
 534+ E52E              .isDigit:
 535+ E52E C6 30            ADD A, '0'
 536+ E530 C9               RET
 537+ E531
 538+ E531              ; ==============================================================================
 539+ E531              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E531              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E531              ; ==============================================================================
 542+ E531              DrawDayCycleHUD:
 543+ E531                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E531 21 EF E7         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E534 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E537 CD A6 E5         CALL .drawChar
 547+ E53A 21 F7 E7         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E53D 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E540 CD A6 E5         CALL .drawChar
 550+ E543 21 FF E7         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E546 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E549 CD A6 E5         CALL .drawChar
 553+ E54C                  ; Col 7 = espacio (limpiar)
 554+ E54C 11 07 40         LD DE, $4007
 555+ E54F CD AF E5         CALL .clearChar
 556+ E552
 557+ E552                  ; --- Digito decenas (col 8) ---
 558+ E552 3A F0 BC         LD A, (DayCycleCount)
 559+ E555 FE 0A            CP 10
 560+ E557 38 20            JR C, .singleDigit
 561+ E559                  ; Dos digitos: dividir A / 10
 562+ E559 06 00            LD B, 0
 563+ E55B              .divLoop:
 564+ E55B D6 0A            SUB 10
 565+ E55D 04               INC B
 566+ E55E FE 0A            CP 10
 567+ E560 30 F9            JR NC, .divLoop
 568+ E562                  ; B = decenas, A = unidades
 569+ E562 F5               PUSH AF                             ; Guardar unidades
 570+ E563 78               LD A, B
 571+ E564 CD 99 E5         CALL .getDigitFont
 572+ E567 11 08 40         LD DE, $4008                        ; Col 8
 573+ E56A CD A6 E5         CALL .drawChar
 574+ E56D F1               POP AF                              ; Recuperar unidades
 575+ E56E CD 99 E5         CALL .getDigitFont
 576+ E571 11 09 40         LD DE, $4009                        ; Col 9
 577+ E574 CD A6 E5         CALL .drawChar
 578+ E577 18 14            JR .setAttrs
 579+ E579
 580+ E579              .singleDigit:
 581+ E579                  ; Una cifra: decena = 0, unidad = A
 582+ E579 F5               PUSH AF
 583+ E57A 21 07 E8         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E57D 11 08 40         LD DE, $4008                        ; Col 8
 585+ E580 CD A6 E5         CALL .drawChar
 586+ E583 F1               POP AF
 587+ E584 CD 99 E5         CALL .getDigitFont
 588+ E587 11 09 40         LD DE, $4009                        ; Col 9
 589+ E58A CD A6 E5         CALL .drawChar
 590+ E58D
 591+ E58D              .setAttrs:
 592+ E58D                  ; Atributos: bright white en cols 4-9
 593+ E58D 3E 47            LD A, $47
 594+ E58F 21 04 58         LD HL, ATTR_BASE + 4
 595+ E592 06 06            LD B, 6
 596+ E594              .attrLoop:
 597+ E594 77               LD (HL), A
 598+ E595 23               INC HL
 599+ E596 10 FC            DJNZ .attrLoop
 600+ E598 C9               RET
 601+ E599
 602+ E599              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E599              ; A se destruye
 604+ E599              .getDigitFont:
 605+ E599 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E59B 6F               LD L, A
 607+ E59C 26 00            LD H, 0
 608+ E59E 29               ADD HL, HL
 609+ E59F 29               ADD HL, HL
 610+ E5A0 29               ADD HL, HL                          ; HL = indice * 8
 611+ E5A1 01 EF E7         LD BC, DayHudFont
 612+ E5A4 09               ADD HL, BC
 613+ E5A5 C9               RET
 614+ E5A6
 615+ E5A6              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 616+ E5A6              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 617+ E5A6              .drawChar:
 618+ E5A6 06 08            LD B, 8
 619+ E5A8              .charLoop:
 620+ E5A8 7E               LD A, (HL)
 621+ E5A9 12               LD (DE), A
 622+ E5AA 23               INC HL
 623+ E5AB 14               INC D
 624+ E5AC 10 FA            DJNZ .charLoop
 625+ E5AE C9               RET
 626+ E5AF
 627+ E5AF              ; Limpia 8 scan lines en VRAM (DE)
 628+ E5AF              .clearChar:
 629+ E5AF 06 08            LD B, 8
 630+ E5B1 AF               XOR A
 631+ E5B2              .clearLoop:
 632+ E5B2 12               LD (DE), A
 633+ E5B3 14               INC D
 634+ E5B4 10 FC            DJNZ .clearLoop
 635+ E5B6 C9               RET
 636+ E5B7
 637+ E5B7              ; ==============================================================================
 638+ E5B7              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 639+ E5B7              ; ==============================================================================
 640+ E5B7              DrawPlayerSpeedHUD:
 641+ E5B7 3A 89 8D         LD A, (PlayerCurrentSpeed)
 642+ E5BA C6 30            ADD A, '0'
 643+ E5BC 1E 02            LD E, 2
 644+ E5BE CD 17 E6         CALL DrawHudCharRow0
 645+ E5C1                  ; Atributo (bright white)
 646+ E5C1 3E 47            LD A, $47
 647+ E5C3 32 02 58         LD (ATTR_BASE + 2), A
 648+ E5C6 C9               RET
