1434+ 9A6B 18 44            JR .applyAnim
1435+ 9A6D
1436+ 9A6D              .animFight:
1437+ 9A6D                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1438+ 9A6D DD 7E 0A         LD A, (IX+ENT_DIR)
1439+ 9A70 0F               RRCA
1440+ 9A71 0F               RRCA
1441+ 9A72 0F               RRCA
1442+ 9A73 0F               RRCA
1443+ 9A74 E6 0F            AND $0F                     ; lastHDir
1444+ 9A76 FE 08            CP DIR_W
1445+ 9A78 28 04            JR Z, .fightW
1446+ 9A7A 16 16            LD D, SPRID_ATTACK_EAST
1447+ 9A7C 18 02            JR .fightSet
1448+ 9A7E              .fightW:
1449+ 9A7E 16 1B            LD D, SPRID_ATTACK_WEST
1450+ 9A80              .fightSet:
