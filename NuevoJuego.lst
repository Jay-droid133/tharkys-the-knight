 457+ 9C18              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9C18              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9C18              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9C18              ; ---
 461+ 9C18 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9C28 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9C29 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9C2A 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D5C 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
