7476+ C8C6 2A 6D 5F         LD HL, (DBfsQTail)
7477+ C8C9 3A 78 5F         LD A, (DBfsTryCx)
7478+ C8CC 77               LD (HL), A
7479+ C8CD 23               INC HL
7480+ C8CE 3A 79 5F         LD A, (DBfsTryCy)
7481+ C8D1 77               LD (HL), A
7482+ C8D2 23               INC HL
7483+ C8D3 78               LD A, B
7484+ C8D4 77               LD (HL), A
7485+ C8D5 23               INC HL
7486+ C8D6 3A 77 5F         LD A, (DBfsCurDepth)
7487+ C8D9 3C               INC A
