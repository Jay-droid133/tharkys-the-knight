 498+ E7D6              ; ---- Phase 12: walk-S con slide-out ----
 499+ E7D6              ; El slide del player continua hasta TGCS_PLAYER_BOTTOM_Y (off-screen total).
 500+ E7D6              ; Pero el cartel "The End" se dispara antes — en el momento en que el ultimo
 501+ E7D6              ; pixel de la cabeza entra detras del arco (POSY = TGCS_ARCH_PX_TOP = 120).
 502+ E7D6              ; Asi el "The End" aparece sincronizado con la desaparicion visual del player,
 503+ E7D6              ; y el slide subsecuente queda detras del arco (invisible) hasta off-screen.
 504+ E7D6              ; TownGateEndDrawn evita redibujar el sprite cada frame entre 120 y 192.
 505+ E7D6              .tgPhPlayerExit:
 506+ E7D6 CD 2E E9         CALL TownGateExitStep
 507+ E7D9 DD 21 94 81      LD IX, EntityTable
 508+ E7DD DD 7E 04         LD A, (IX+ENT_POSY)
 509+ E7E0                  ; --- Trigger one-shot del "The End" cuando POSY cruza arch top ---
 510+ E7E0 FE 78            CP TGCS_ARCH_PX_TOP
 511+ E7E2 38 11            JR C, .tgPhExitCheckBottom          ; aun por encima del arco
 512+ E7E4 3A AA 5F         LD A, (TownGateEndDrawn)
 513+ E7E7 B7               OR A
 514+ E7E8 20 0B            JR NZ, .tgPhExitCheckBottom         ; ya pintado este episodio
 515+ E7EA CD 5F E9         CALL TownGateDrawTheEnd
 516+ E7ED CD FB E9         CALL SFX_TownGate_OnTheEnd
 517+ E7F0 3E 01            LD A, 1
 518+ E7F2 32 AA 5F         LD (TownGateEndDrawn), A
 519+ E7F5              .tgPhExitCheckBottom:
 520+ E7F5                  ; --- El slide continua hasta que POSY alcanza el bottom off-screen ---
 521+ E7F5 3A 98 81         LD A, (EntityTable + ENT_POSY)
 522+ E7F8 FE C0            CP TGCS_PLAYER_BOTTOM_Y
 523+ E7FA D8               RET C                               ; aun deslizandose
 524+ E7FB                  ; Player completamente off-screen: transicion a END_HOLD.
 525+ E7FB 3E 96            LD A, TGCS_T_END_HOLD
 526+ E7FD 32 A5 5F         LD (TownGateTimer), A
 527+ E800 3E 0D            LD A, TGP_END_HOLD
 528+ E802 32 C1 82         LD (TownGatePhase), A
 529+ E805 C9               RET
 530+ E806
 531+ E806              ; ---- Phase 13: "The End" hold ----
 532+ E806              .tgPhEndHold:
 533+ E806 CD 28 E8         CALL TownGateDecTimer
 534+ E809 C0               RET NZ
 535+ E80A CD 85 E9         CALL TownGateWipeBlack
 536+ E80D 3E 1E            LD A, TGCS_T_BLACK_HOLD
 537+ E80F 32 A5 5F         LD (TownGateTimer), A
 538+ E812 3E 0E            LD A, TGP_BLACK
 539+ E814 32 C1 82         LD (TownGatePhase), A
 540+ E817 C9               RET
 541+ E818
 542+ E818              ; ---- Phase 14: pantalla negra hold ----
 543+ E818              .tgPhBlack:
 544+ E818 CD 28 E8         CALL TownGateDecTimer
