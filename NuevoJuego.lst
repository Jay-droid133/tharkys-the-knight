1280+ 93C1 FE FF            CP $FF
1281+ 93C3 28 15            JR Z, .bzclSkipCell
1282+ 93C5                  ; Append (cx, cy)
1283+ 93C5 3A 00 5D         LD A, (ZoneCellCount)
1284+ 93C8 FE FF            CP 255
1285+ 93CA 28 0E            JR Z, .bzclSkipCell
1286+ 93CC 3C               INC A
1287+ 93CD 32 00 5D         LD (ZoneCellCount), A
1288+ 93D0 2A FB 93         LD HL, (.bzclPtr)
1289+ 93D3 70               LD (HL), B                              ; cx
1290+ 93D4 23               INC HL
1291+ 93D5 71               LD (HL), C                              ; cy
1292+ 93D6 23               INC HL
1293+ 93D7 22 FB 93         LD (.bzclPtr), HL
