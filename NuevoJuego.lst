 641+ 94AE              ; ==============================================================================
 642+ 94AE              ; MaiPickRandomGapOnSide
 643+ 94AE              ; ==============================================================================
 644+ 94AE              ; Variante de MaiPickRandomGap que filtra por side concreto (N/S/W/E).
 645+ 94AE              ; Usado por Regla 2 (follow al cambiar room) para que los monsters entren
 646+ 94AE              ; por el mismo borde que uso el player.
 647+ 94AE              ;
 648+ 94AE              ; IN:  A = side deseado (MAI_SIDE_N/S/W/E)
 649+ 94AE              ; OUT: A = 0 ok (MaiSpawnX/Y llenos); A = 1 sin gaps en ese side → fallback
 650+ 94AE              ; ==============================================================================
 651+ 94AE              MaiPickRandomGapOnSide:
 652+ 94AE 32 A9 9C         LD (MaiGapWantSide), A
 653+ 94B1
 654+ 94B1                  ; screen_id
 655+ 94B1 3A 56 82         LD A, (CurrentScreenY)
 656+ 94B4 07               RLCA
 657+ 94B5 07               RLCA
 658+ 94B6 07               RLCA
 659+ 94B7 07               RLCA
 660+ 94B8 21 55 82         LD HL, CurrentScreenX
 661+ 94BB 86               ADD A, (HL)
 662+ 94BC 32 A5 9C         LD (MaiGapScreenId), A
 663+ 94BF
 664+ 94BF                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 665+ 94BF F3               DI
 666+ 94C0
 667+ 94C0 3A 8F 90         LD A, (CurrentPaging)
 668+ 94C3 E6 F8            AND $F8
 669+ 94C5 F6 06            OR 6
 670+ 94C7 32 8F 90         LD (CurrentPaging), A
 671+ 94CA 01 FD 7F         LD BC, $7FFD
 672+ 94CD ED 79            OUT (C), A
 673+ 94CF
 674+ 94CF                  ; HL = pointer al record
 675+ 94CF 3A A5 9C         LD A, (MaiGapScreenId)
 676+ 94D2 6F               LD L, A
 677+ 94D3 26 00            LD H, 0
 678+ 94D5 29               ADD HL, HL
 679+ 94D6 11 00 C0         LD DE, ScreenGapsTable
 680+ 94D9 19               ADD HL, DE
 681+ 94DA 5E               LD E, (HL)
 682+ 94DB 23               INC HL
 683+ 94DC 56               LD D, (HL)
 684+ 94DD EB               EX DE, HL                       ; HL = record ptr
 685+ 94DE
 686+ 94DE 7E               LD A, (HL)
 687+ 94DF B7               OR A
 688+ 94E0 CA 2C 95         JP Z, .mosNoGaps
 689+ 94E3 47               LD B, A                         ; B = total count
 690+ 94E4 23               INC HL                          ; HL = first entry
 691+ 94E5
 692+ 94E5                  ; --- Pass 1: count entries matching wantSide ---
 693+ 94E5 E5               PUSH HL                         ; save entries ptr
 694+ 94E6 C5               PUSH BC                         ; save B (total)
 695+ 94E7 0E 00            LD C, 0                         ; C = match count
 696+ 94E9              .mosCountLoop:
 697+ 94E9 7E               LD A, (HL)                      ; side
 698+ 94EA 23               INC HL
 699+ 94EB 23               INC HL                          ; skip coord byte → next entry
 700+ 94EC 5F               LD E, A                         ; E = entry side
 701+ 94ED 3A A9 9C         LD A, (MaiGapWantSide)
 702+ 94F0 BB               CP E
 703+ 94F1 20 01            JR NZ, .mosCountSkip
 704+ 94F3 0C               INC C
 705+ 94F4              .mosCountSkip:
 706+ 94F4 10 F3            DJNZ .mosCountLoop
 707+ 94F6
 708+ 94F6 79               LD A, C
 709+ 94F7 B7               OR A
 710+ 94F8 20 05            JR NZ, .mosHaveMatch
 711+ 94FA
 712+ 94FA                  ; Sin matches en este side
 713+ 94FA C1               POP BC
 714+ 94FB E1               POP HL
 715+ 94FC C3 2C 95         JP .mosNoGaps
 716+ 94FF
 717+ 94FF              .mosHaveMatch:
 718+ 94FF                  ; C = count of matches. Pick random idx (into A, keep off C/B registers).
 719+ 94FF 41               LD B, C                         ; B = matches (divisor)
 720+ 9500 ED 5F            LD A, R
 721+ 9502              .mosMod:
 722+ 9502 B8               CP B
