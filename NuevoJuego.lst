 173+ E4EA 3C               INC A
 174+ E4EB FE 07            CP NUM_TIME_MOMENTS
 175+ E4ED 38 01            JR C, .noWrap
 176+ E4EF AF               XOR A                   ; Volver a 0 (Dia)
 177+ E4F0              .noWrap:
 178+ E4F0 F5               PUSH AF
 179+ E4F1 CD 4B E4         CALL SetTimeOfDay
