5766+ BE83 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5767+ BE86 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5768+ BE8A DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5769+ BE8E                  ; Facing
5770+ BE8E 57               LD D, A
5771+ BE8F 3A A1 81         LD A, (EntityTable + ENT_POSX)
5772+ BE92 DD BE 03         CP (IX+ENT_POSX)
