1537+ F74E              ; ==============================================================================
1538+ F74E              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1539+ F74E              ; ==============================================================================
1540+ F74E              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1541+ F74E              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1542+ F74E              ; suficiente para corromper visualmente).
1543+ F74E              ; IN: IX = entity ptr.
1544+ F74E              ; ==============================================================================
1545+ F74E              RedrawTrappedMonster:
1546+ F74E                  ; --- Erase viejo en (OLDX, OLDY) ---
1547+ F74E CD DA A7         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1548+ F751 DD 7E 0D         LD A, (IX+ENT_OLDY)
1549+ F754 57               LD D, A
1550+ F755 DD 7E 0C         LD A, (IX+ENT_OLDX)
1551+ F758 5F               LD E, A
1552+ F759 DD E5            PUSH IX
1553+ F75B DD 2A 62 A7      LD IX, (OldSprAddr)
1554+ F75F CD CD 9C         CALL DrawSprite
1555+ F762 DD E1            POP IX
1556+ F764                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1557+ F764                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1558+ F764 DD 56 0D         LD D, (IX+ENT_OLDY)
1559+ F767 DD 5E 0C         LD E, (IX+ENT_OLDX)
1560+ F76A CD 80 D5         CALL RestoreOldAttr
1561+ F76D                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1562+ F76D                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1563+ F76D                  ; reponer attrs de pickups que el flujo de entidades pisa con
1564+ F76D                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1565+ F76D                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1566+ F76D                  ; estar bajo el monster.
1567+ F76D DD E5            PUSH IX
1568+ F76F CD 60 DC         CALL RefreshPickupAttrs
1569+ F772 DD E1            POP IX
1570+ F774                  ; --- Compute new draw pos ---
1571+ F774 CD 64 A7         CALL CalcDrawX
1572+ F777 CD FC A1         CALL ComputeEnemyDrawY
1573+ F77A                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1574+ F77A CD A9 A7         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1575+ F77D 3A DD 82         LD A, (EnemyDrawY)
1576+ F780 57               LD D, A
1577+ F781 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1578+ F784 5F               LD E, A
1579+ F785 DD E5            PUSH IX
1580+ F787 DD 2A D8 A7      LD IX, (SpriteAddrTemp)
1581+ F78B CD EA 9D         CALL CalcEntityAttrSize
1582+ F78E DD E1            POP IX
1583+ F790 3A DD 82         LD A, (EnemyDrawY)
1584+ F793 57               LD D, A
1585+ F794 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1586+ F797 5F               LD E, A
1587+ F798 DD 7E 05         LD A, (IX+ENT_ATTR)
1588+ F79B CD BD 9D         CALL SetEntityAttr
1589+ F79E                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1590+ F79E 3A DD 82         LD A, (EnemyDrawY)
1591+ F7A1 57               LD D, A
1592+ F7A2 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1593+ F7A5 5F               LD E, A
1594+ F7A6 DD E5            PUSH IX
1595+ F7A8 DD 2A D8 A7      LD IX, (SpriteAddrTemp)
1596+ F7AC CD CD 9C         CALL DrawSprite
1597+ F7AF DD E1            POP IX
1598+ F7B1                  ; --- Save OLD = current ---
1599+ F7B1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1600+ F7B4 DD 77 0C         LD (IX+ENT_OLDX), A
1601+ F7B7 3A DD 82         LD A, (EnemyDrawY)
1602+ F7BA DD 77 0D         LD (IX+ENT_OLDY), A
1603+ F7BD DD 7E 00         LD A, (IX+ENT_SPRITEID)
1604+ F7C0 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1605+ F7C3 C9               RET
