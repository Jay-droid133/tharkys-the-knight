 189+ E5DF              ; ==============================================================================
 190+ E5DF              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ E5DF              ; ==============================================================================
 192+ E5DF              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ E5DF              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ E5DF              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ E5DF              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ E5DF              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ E5DF              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ E5DF              ; Destruye: AF, BC, DE, HL, IX.
 199+ E5DF              ; ==============================================================================
 200+ E5DF              StartTownGateCutscene:
 201+ E5DF AF               XOR A
 202+ E5E0 32 B0 82         LD (CurrentKey), A
 203+ E5E3 CD 31 E8         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ E5E6 CD 61 6D         CALL KillAllActiveNasties_B7           ; nasties → puff (animan en WAIT_NASTIES)
 205+ E5E9 CD 67 6D         CALL KillDeathIfActive_B7              ; muerte (slot 11) → puff y despawn
 206+ E5EC CD F1 E9         CALL SFX_TownGate_OnStart
 207+ E5EF 3E 10            LD A, TGP_WAIT_NASTIES
 208+ E5F1 32 CA 82         LD (TownGatePhase), A
 209+ E5F4 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ E5F6 32 A5 5F         LD (TownGateTimer), A
 211+ E5F9 C9               RET
 212+ E5FA
 213+ E5FA              ; KillDeathIfActive: vive en slot 1 (town_gate_cutscene.asm) — llamada por
 214+ E5FA              ; bank_cutscene via KillDeathIfActive_B7. NO duplicar aqui.
 215+ E5FA
 216+ E5FA              ; ==============================================================================
 217+ E5FA              ; UpdateTownGateCutscene - llamada cada frame desde MainLoop si phase != 0
 218+ E5FA              ; ==============================================================================
 219+ E5FA              ; Dispatch por TownGatePhase. Cada fase: trabajo de tick, decremento timer,
 220+ E5FA              ; transicion a la siguiente.
 221+ E5FA              ; Destruye: AF, BC, DE, HL, IX.
 222+ E5FA              ; ==============================================================================
 223+ E5FA              UpdateTownGateCutsceneBody:
 224+ E5FA 3A CA 82         LD A, (TownGatePhase)
 225+ E5FD FE 10            CP TGP_WAIT_NASTIES
 226+ E5FF CA 3A E6         JP Z, .tgPhWaitNasties              ; pre-LOCK wait, ProcessEnemies sigue corriendo
 227+ E602 FE 11            CP TGP_WALK_TO_ANCHOR
 228+ E604 CA 56 E6         JP Z, .tgPhWalkToAnchor              ; player camina autonomo a anchor1
 229+ E607 3D               DEC A
 230+ E608 CA DC E6         JP Z, .tgPhLock
 231+ E60B 3D               DEC A
 232+ E60C CA F4 E6         JP Z, .tgPhArmIn
 233+ E60F 3D               DEC A
 234+ E610 CA 0C E7         JP Z, .tgPhFingerIn
 235+ E613 3D               DEC A
 236+ E614 CA 25 E7         JP Z, .tgPhShake
 237+ E617 3D               DEC A
 238+ E618 CA 3D E7         JP Z, .tgPhFingerPulse
 239+ E61B 3D               DEC A
 240+ E61C CA 55 E7         JP Z, .tgPhFingerOut
 241+ E61F 3D               DEC A
 242+ E620 CA 64 E7         JP Z, .tgPhArmHold
 243+ E623 3D               DEC A
 244+ E624 CA 7C E7         JP Z, .tgPhArmOut
 245+ E627 3D               DEC A
 246+ E628 CA A1 E7         JP Z, .tgPhPlayerTurn
 247+ E62B 3D               DEC A                               ; phase 10 (PLAYER_HIDE) deprecated
 248+ E62C 3D               DEC A                               ; phase 11 (PLAYER_FRAMED) deprecated
 249+ E62D 3D               DEC A
 250+ E62E CA D6 E7         JP Z, .tgPhPlayerExit
 251+ E631 3D               DEC A
 252+ E632 CA 06 E8         JP Z, .tgPhEndHold
 253+ E635 3D               DEC A
 254+ E636 CA 18 E8         JP Z, .tgPhBlack
 255+ E639                  ; TGP_CREDITS o cualquier valor mayor: loop infinito, no-op.
 256+ E639 C9               RET
 257+ E63A
 258+ E63A              ; ---- Phase WAIT_NASTIES: espera a que terminen los puffs antes de WALK ----
 259+ E63A              ; ProcessEnemies sigue corriendo en MainLoop (rama especial) → cada nasty
 260+ E63A              ; STATE_DYING avanza su anim puff y queda TYPE_NONE al terminar. Cuando
 261+ E63A              ; todos muertos (check dinamico), transicion a WALK_TO_ANCHOR.
 262+ E63A              ;
 263+ E63A              ; Re-llamada a KillAllActiveNasties cada frame: nasties que estaban en
 264+ E63A              ; STATE_SPAWNING al disparar el trigger (saltados por la primera llamada)
 265+ E63A              ; transicionan a STATE_RUNNING al terminar el spawn anim, y aqui los
 266+ E63A              ; capturamos para meterlos en STATE_DYING.
 267+ E63A              .tgPhWaitNasties:
 268+ E63A CD 61 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 269+ E63D CD 22 63         CALL TownGateAllNastiesDeadCheck
 270+ E640 28 04            JR Z, .tgWaitNastiesDone
 271+ E642 CD 28 E8         CALL TownGateDecTimer               ; safety timeout
 272+ E645 C0               RET NZ
 273+ E646              .tgWaitNastiesDone:
 274+ E646                  ; Refrescar attrs del player antes del walk: los puffs de nasties cerca
 275+ E646                  ; del player pueden haber dejado attrs contaminados (color nasty) en
 276+ E646                  ; sus celdas. TownGateRedrawPlayer hace erase + RestoreOldAttr (limpia
 277+ E646                  ; desde CleanAttrMap) + draw + SetEntityAttr (player white).
 278+ E646 CD 52 6D         CALL TownGateRedrawPlayer_B7
 279+ E649 AF               XOR A
 280+ E64A 32 A9 5F         LD (TownGateExitWalkFrame), A       ; reset toggle anim 0/1
 281+ E64D 32 A5 5F         LD (TownGateTimer), A               ; reuse Timer como contador anim period
 282+ E650 3E 11            LD A, TGP_WALK_TO_ANCHOR
 283+ E652 32 CA 82         LD (TownGatePhase), A
 284+ E655 C9               RET
 285+ E656
 286+ E656              ; ---- Phase WALK_TO_ANCHOR: player camina autonomo en 2 fases ----
 287+ E656              ; Fase 1: movimiento vertical hasta alinear Y con TGCS_WALK_TARGET_Y
 288+ E656              ;         (sprite WALK_N o WALK_S segun direccion).
 289+ E656              ; Fase 2: movimiento horizontal hasta alinear X con TGCS_WALK_TARGET_X
 290+ E656              ;         (sprite WALK_E o WALK_W segun direccion).
 291+ E656              ; Al llegar (ambos ejes alineados): pose static WALK_N+1 + transicion a LOCK.
 292+ E656              ; Toggle frame anim 0/1 cada TGCS_WALK_ANIM_PERIOD frames.
 293+ E656              .tgPhWalkToAnchor:
 294+ E656 DD 21 9D 81      LD IX, EntityTable
 295+ E65A                  ; --- Fase 1: Y ---
 296+ E65A DD 7E 04         LD A, (IX+ENT_POSY)
 297+ E65D FE 50            CP TGCS_WALK_TARGET_Y
 298+ E65F 28 1C            JR Z, .tgwtaTryX                    ; Y aligned, pasar a fase 2
 299+ E661 38 0D            JR C, .tgwtaMoveS                   ; cur_Y < target → S (Y++)
 300+ E663                  ; cur_Y > target → N (Y--)
 301+ E663 DD 35 04         DEC (IX+ENT_POSY)
 302+ E666 DD 7E 04         LD A, (IX+ENT_POSY)
 303+ E669 32 DE 82         LD (PlayerDrawY), A
 304+ E66C 06 0A            LD B, SPRID_WALK_N
 305+ E66E 18 2F            JR .tgwtaApplyAnim
 306+ E670              .tgwtaMoveS:
 307+ E670 DD 34 04         INC (IX+ENT_POSY)
 308+ E673 DD 7E 04         LD A, (IX+ENT_POSY)
 309+ E676 32 DE 82         LD (PlayerDrawY), A
 310+ E679 06 0E            LD B, SPRID_WALK_S
 311+ E67B 18 22            JR .tgwtaApplyAnim
 312+ E67D                  ; --- Fase 2: X (solo si Y ya aligned) ---
 313+ E67D              .tgwtaTryX:
 314+ E67D DD 7E 03         LD A, (IX+ENT_POSX)
 315+ E680 FE 78            CP TGCS_WALK_TARGET_X
 316+ E682 CA C0 E6         JP Z, .tgwtaArrived                 ; ambos aligned
 317+ E685 38 0D            JR C, .tgwtaMoveE                   ; cur_X < target → E (X++)
 318+ E687 DD 35 03         DEC (IX+ENT_POSX)
 319+ E68A DD 7E 03         LD A, (IX+ENT_POSX)
 320+ E68D DD 77 0F         LD (IX+ENT_DRAWX), A
 321+ E690 06 06            LD B, SPRID_WALK_W
 322+ E692 18 0B            JR .tgwtaApplyAnim
 323+ E694              .tgwtaMoveE:
 324+ E694 DD 34 03         INC (IX+ENT_POSX)
 325+ E697 DD 7E 03         LD A, (IX+ENT_POSX)
 326+ E69A DD 77 0F         LD (IX+ENT_DRAWX), A
 327+ E69D 06 02            LD B, SPRID_WALK_E
 328+ E69F              .tgwtaApplyAnim:
 329+ E69F                  ; B = sprite base. Toggle frame 0/1 cada TGCS_WALK_ANIM_PERIOD.
 330+ E69F 3A A5 5F         LD A, (TownGateTimer)
 331+ E6A2 3C               INC A
 332+ E6A3 32 A5 5F         LD (TownGateTimer), A
 333+ E6A6 FE 04            CP TGCS_WALK_ANIM_PERIOD
 334+ E6A8 38 0C            JR C, .tgwtaSameFrame
 335+ E6AA AF               XOR A
 336+ E6AB 32 A5 5F         LD (TownGateTimer), A
 337+ E6AE 3A A9 5F         LD A, (TownGateExitWalkFrame)
 338+ E6B1 EE 01            XOR 1
 339+ E6B3 32 A9 5F         LD (TownGateExitWalkFrame), A
 340+ E6B6              .tgwtaSameFrame:
 341+ E6B6 3A A9 5F         LD A, (TownGateExitWalkFrame)
 342+ E6B9 80               ADD A, B
 343+ E6BA DD 77 00         LD (IX+ENT_SPRITEID), A
 344+ E6BD C3 52 6D         JP TownGateRedrawPlayer_B7             ; tail call
 345+ E6C0
 346+ E6C0              .tgwtaArrived:
 347+ E6C0                  ; Llegado a anchor1: pose static WALK_N+1 + transicion a LOCK.
 348+ E6C0 3E 0B            LD A, SPRID_WALK_N + 1              ; frame 2o de Walk North (mirando arriba)
 349+ E6C2 DD 77 00         LD (IX+ENT_SPRITEID), A
 350+ E6C5 3E 0A            LD A, SPRID_WALK_N
 351+ E6C7 DD 77 08         LD (IX+ENT_ANIMBASE), A
