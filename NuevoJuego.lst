 796+ 905B 19               ADD HL, DE
 797+ 905C 5E               LD E, (HL)
 798+ 905D 23               INC HL
 799+ 905E 56               LD D, (HL)                  ; DE = puntero a datos del sprite
 800+ 905F 1A               LD A, (DE)                  ; width_bytes
 801+ 9060 87               ADD A, A
 802+ 9061 87               ADD A, A
 803+ 9062 87               ADD A, A                    ; × 8 = width_px
 804+ 9063 47               LD B, A
 805+ 9064 13               INC DE
 806+ 9065 1A               LD A, (DE)                  ; height_px
 807+ 9066 4F               LD C, A
 808+ 9067 C9               RET
