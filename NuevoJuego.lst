 378+ ECF5              ; ==============================================================================
 379+ ECF5              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ ECF5              ; ==============================================================================
 381+ ECF5              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ ECF5              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ ECF5              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ ECF5              ; ==============================================================================
 385+ ECF5              DrawHealthStaminaHUD:
 386+ ECF5                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ ECF5 3A 4B B3         LD A, (PlayerHealth)
 388+ ECF8 4F               LD C, A                             ; C = nivel (0-16)
 389+ ECF9 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ ECFC 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ ECFF DD 21 DB E8      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ ED03 FD 21 4C E9      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ ED07 CD 6D ED         CALL .drawBar
 394+ ED0A
 395+ ED0A                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ ED0A 3A 4C B3         LD A, (PlayerStamina)
 397+ ED0D 4F               LD C, A
 398+ ED0E 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ ED11 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ ED14 DD 21 DF E8      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ ED18 FD 21 50 E9      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ ED1C CD 6D ED         CALL .drawBar
 403+ ED1F
 404+ ED1F                  ; --- Flash de recuperacion del pozo ---
 405+ ED1F 3A 53 8D         LD A, (WellFlashTimer)
 406+ ED22 B7               OR A
 407+ ED23 28 23            JR Z, .noFlash
 408+ ED25 3D               DEC A
 409+ ED26 32 53 8D         LD (WellFlashTimer), A
 410+ ED29                  ; Flash: alternar blanco/normal cada 4 frames
 411+ ED29 E6 04            AND $04
 412+ ED2B 28 1B            JR Z, .noFlash
 413+ ED2D                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ ED2D                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ ED2D 3E 47            LD A, WHITE | $40
 416+ ED2F 32 0D 58         LD ($580D), A
 417+ ED32 32 0E 58         LD ($580E), A
 418+ ED35 32 2D 58         LD ($582D), A
 419+ ED38 32 2E 58         LD ($582E), A
 420+ ED3B 32 11 58         LD ($5811), A
 421+ ED3E 32 12 58         LD ($5812), A
 422+ ED41 32 31 58         LD ($5831), A
 423+ ED44 32 32 58         LD ($5832), A
 424+ ED47 C9               RET
 425+ ED48              .noFlash:
