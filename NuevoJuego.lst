 674+ E7A7 CD CD E7         CALL DrawHudCharRow0
 675+ E7AA 3E 47            LD A, $47
 676+ E7AC 32 0B 58         LD (ATTR_BASE + 11), A
 677+ E7AF 32 0C 58         LD (ATTR_BASE + 12), A
 678+ E7B2 C9               RET
 679+ E7B3
 680+ E7B3              ; ==============================================================================
 681+ E7B3              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 682+ E7B3              ; ==============================================================================
 683+ E7B3              DrawEnemySpeedHUD:
 684+ E7B3                  ; "V" en columna 30
 685+ E7B3 3E 56            LD A, 'V'
