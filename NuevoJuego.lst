 126+ F18A              ; DATOS DE EFECTOS DE SONIDO
 127+ F18A              ; ==============================================================================
 128+ F18A
 129+ F18A              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F18A              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F18A              SFX_FootstepTic:
 132+ F18A 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F18E 00               DEFB 0                      ; fin
 134+ F18F
 135+ F18F              SFX_FootstepTac:
 136+ F18F 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ F193 00               DEFB 0                      ; fin
 138+ F194
 139+ F194              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 140+ F194              ; Dos pasos: sweep rapido de agudo a grave
 141+ F194              SFX_Attack:
 142+ F194 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 143+ F198 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 144+ F19C 00               DEFB 0                      ; fin
 145+ F19D
