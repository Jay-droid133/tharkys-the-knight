 260+ 681F              ; ==============================================================================
 261+ 681F              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 262+ 681F              ; ==============================================================================
 263+ 681F              ; IN: A = frame idx (0..2)
 264+ 681F              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 265+ 681F              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 266+ 681F              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 267+ 681F              ; Destruye: AF, BC, DE, HL, IX.
 268+ 681F              ; ==============================================================================
 269+ 681F              DrawSmokeFrameXor:
 270+ 681F 87               ADD A, A                                ; *2 (entries de 2 bytes)
 271+ 6820 6F               LD L, A
 272+ 6821 26 00            LD H, 0
 273+ 6823 11 19 68         LD DE, SmokeFramePtrTable
 274+ 6826 19               ADD HL, DE
 275+ 6827 5E               LD E, (HL)
 276+ 6828 23               INC HL
 277+ 6829 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 278+ 682A                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 279+ 682A                  ; Source y destino accesibles sin paging (milestones bank 0,
 280+ 682A                  ; BgSpriteBuffer en RAM principal).
 281+ 682A EB               EX DE, HL                               ; HL = source
 282+ 682B 11 F5 89         LD DE, BgSpriteBuffer
 283+ 682E 01 22 00         LD BC, 34
 284+ 6831 ED B0            LDIR
 285+ 6833                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 286+ 6833 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 287+ 6836 57               LD D, A
 288+ 6837 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 289+ 683A 5F               LD E, A
 290+ 683B C3 31 69         JP DrawBgSprite16XorAtPixel
