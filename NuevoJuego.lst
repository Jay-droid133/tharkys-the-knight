 714+ E61D 01 00 3C         LD BC, $3C00
 715+ E620 09               ADD HL, BC                  ; HL = font data
 716+ E621 16 40            LD D, $40                   ; Tercio 0, scan line 0
 717+ E623 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 718+ E624 5F               LD E, A                     ; DE = dir VRAM
 719+ E625 06 08            LD B, 8
