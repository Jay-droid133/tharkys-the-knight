# file opened: day_cycle.asm
   1+ E3EA              ; ==============================================================================
   2+ E3EA              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ E3EA              ; ==============================================================================
   4+ E3EA              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ E3EA              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ E3EA              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ E3EA              ; ==============================================================================
   8+ E3EA
   9+ E3EA              ; --- Constantes ---
  10+ E3EA              NUM_TIME_MOMENTS    EQU 7
  11+ E3EA
  12+ E3EA              ; --- Variables ---
  13+ E3EA 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ E3EB 86 E8        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ E3ED 86 E8        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ E3EF 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ E3F0 00           BgSpriteSkipRemap:      DEFB 0      ; 1 = ApplyDayCycleRemap retorna sin remap (preserva attrs raw del sprite). Usado por random pickups (life/health/stamina) que deben mantener su brillo siempre.
  18+ E3F1 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  19+ E3F2
  20+ E3F2              ; ==============================================================================
  21+ E3F2              ; SetTimeOfDay - Cambia el momento del dia
  22+ E3F2              ; ==============================================================================
  23+ E3F2              ; Entrada: A = momento (0-6)
  24+ E3F2              ; ==============================================================================
  25+ E3F2              SetTimeOfDay:
  26+ E3F2 32 EA E3         LD (CurrentTimeOfDay), A
  27+ E3F5
  28+ E3F5                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  29+ E3F5 FE 04            CP 4
  30+ E3F7 20 06            JR NZ, .notNewCycle
  31+ E3F9 21 24 BD         LD HL, DayCycleCount
  32+ E3FC 34               INC (HL)
  33+ E3FD 18 04            JR .skipBellsReset
  34+ E3FF              .notNewCycle:
  35+ E3FF                  ; Salir de phase 4 (o entrar a cualquier no-4): rearmar BellsTriggered para
  36+ E3FF                  ; que la proxima medianoche (natural o por T) vuelva a disparar campanadas.
  37+ E3FF                  ; Sin esto, ciclar con T pasa por N2 una sola vez por sesion.
  38+ E3FF AF               XOR A
  39+ E400 32 BE 82         LD (BellsTriggered), A
  40+ E403              .skipBellsReset:
  41+ E403 3A EA E3         LD A, (CurrentTimeOfDay)            ; recuperar phase (XOR A clobbeo A)
  42+ E406
  43+ E406                  ; N2 (medianoche): campanadas primero, remap al terminar
  44+ E406 FE 04            CP 4
  45+ E408 28 24            JR Z, .bellsFirst
  46+ E40A
  47+ E40A                  ; Amanecer temprano (fase 5): despawnear monsters + musica de amanecer
  48+ E40A FE 05            CP 5
  49+ E40C 20 0D            JR NZ, .noScareMon
  50+ E40E CD 3E BD         CALL ScareAllMonsters
  51+ E411 CD B4 FB         CALL StopMonstersMusic          ; cortar el secuencer "po-po-popo-po"
  52+ E414                  ; En el path natural el bell decay (max 30f) termino hace minutos de game
  53+ E414                  ; time, asi que BellVol* esta a 0 con seguridad. Debug T-key 4->5 inmediato
  54+ E414                  ; podria solapar bell decay con sunrise music por ~1s; aceptado como
  55+ E414                  ; artefacto debug-only sin chequeo cruzado a bank 4.
  56+ E414 3E 01            LD A, 1                         ; track 1 = Sunrise
  57+ E416 CD C2 99         CALL StartMusic
  58+ E419 18 07            JR .noKillMon
  59+ E41B              .noScareMon:
  60+ E41B                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  61+ E41B FE 06            CP 6
  62+ E41D 20 03            JR NZ, .noKillMon
  63+ E41F CD C7 BC         CALL KillAllActiveMonsters
  64+ E422              .noKillMon:
  65+ E422
  66+ E422                  ; Actualizar tablas de remap y tabla de nasties
  67+ E422 CD 57 E4         CALL UpdateRemapTables
  68+ E425 CD 27 BD         CALL UpdateNastyTable
  69+ E428
  70+ E428                  ; Forzar remap de atributos (sin redibujar pixeles)
  71+ E428 3E 01            LD A, 1
  72+ E42A 32 19 83         LD (AttrsDirty), A
  73+ E42D C9               RET
  74+ E42E
  75+ E42E              .bellsFirst:
  76+ E42E                  ; NO actualizar tablas de REMAP: mantener colores de N1 durante campanadas.
  77+ E42E                  ; SI actualizar nasty table: la tabla de tipos a spawnear depende de la
  78+ E42E                  ; fase, no del remap visual. Si capturamos los 3 monsters durante este
  79+ E42E                  ; intervalo de N2, post-captura se desbloquea spawn de nasties y queremos
  80+ E42E                  ; que sean nocturnos (Crepuscular), no diurnos.
  81+ E42E CD 27 BD         CALL UpdateNastyTable
  82+ E431                  ; Idempotente: si bells ya sonaron (porque el jugador abrio la iglesia
  83+ E431                  ; antes de medianoche natural y forzo el evento), saltamos.
  84+ E431 3A BE 82         LD A, (BellsTriggered)
  85+ E434 B7               OR A
  86+ E435 C0               RET NZ
  87+ E436 3E 01            LD A, 1
  88+ E438 32 BE 82         LD (BellsTriggered), A
  89+ E43B CD 2A FB         CALL StartBellChimes
  90+ E43E C9               RET
  91+ E43F
  92+ E43F              ; ==============================================================================
  93+ E43F              ; TriggerChurchMidnight - llamada al abrir la puerta de la iglesia 1a vez
  94+ E43F              ; ==============================================================================
  95+ E43F              ; Si bells aun no han sonado (estamos antes de medianoche natural):
  96+ E43F              ;   - Salta reloj a 00:00.
  97+ E43F              ;   - Dispara phase 4 (N2 = medianoche) -> bells, ventanas off, monsters spawn.
  98+ E43F              ;   - Aplica remap de colores INMEDIATAMENTE (no espera al final de las
  99+ E43F              ;     campanadas como hace el path natural). El usuario quiere que la
 100+ E43F              ;     iglesia se vea en colores de noche desde el momento mismo de abrir
 101+ E43F              ;     la puerta, no que conserve el color diurno hasta que terminen las 12
 102+ E43F              ;     campanadas. La cadena post-bell vuelve a llamar UpdateRemapTables
 103+ E43F              ;     pero ya esta en N2 -> no-op visual.
 104+ E43F              ; Si bells ya sonaron (medianoche pasada de forma natural antes de abrir
 105+ E43F              ; iglesia): no-op. La puerta se abre normal sin clock-jump anti-climatico.
 106+ E43F              ;
 107+ E43F              ; El guard via BellsTriggered hace esto idempotente: el path natural de
 108+ E43F              ; medianoche en .bellsFirst tambien lo setea, asi que segundo trigger desde
 109+ E43F              ; aqui no re-dispara nada.
 110+ E43F              ; ==============================================================================
 111+ E43F              TriggerChurchMidnight:
 112+ E43F 3A BE 82         LD A, (BellsTriggered)
 113+ E442 B7               OR A
 114+ E443 C0               RET NZ                              ; bells ya sonaron -> no-op
 115+ E444 3E 04            LD A, 4                             ; phase 4 = N2 (medianoche)
 116+ E446 CD 36 EC         CALL SetClockToPhaseHour            ; GameHours=0, Min=0, SubMinute=0
 117+ E449 3E 04            LD A, 4
 118+ E44B CD F2 E3         CALL SetTimeOfDay                   ; setea phase + .bellsFirst
 119+ E44E                  ; Aplicar remap N2 ya: por defecto SetTimeOfDay(4) NO toca remap
 120+ E44E                  ; (lo hace .bellsDoneTimer al terminar campanadas para mantener colores
 121+ E44E                  ; diurnos durante chimes). En este path queremos lo contrario.
 122+ E44E CD 57 E4         CALL UpdateRemapTables
 123+ E451 3E 01            LD A, 1
 124+ E453 32 19 83         LD (AttrsDirty), A
 125+ E456 C9               RET
 126+ E457
 127+ E457              ; ==============================================================================
 128+ E457              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
 129+ E457              ; ==============================================================================
 130+ E457              UpdateRemapTables:
 131+ E457 3A EA E3         LD A, (CurrentTimeOfDay)
 132+ E45A 21 5A E8         LD HL, RemapTablePtrs
 133+ E45D 5F               LD E, A
 134+ E45E 16 00            LD D, 0
 135+ E460 19               ADD HL, DE
 136+ E461 19               ADD HL, DE
 137+ E462 5E               LD E, (HL)
 138+ E463 23               INC HL
 139+ E464 56               LD D, (HL)
 140+ E465 ED 53 EB E3      LD (CurrentRemapTable), DE
 141+ E469
 142+ E469 3A EA E3         LD A, (CurrentTimeOfDay)
 143+ E46C 21 68 E8         LD HL, RemapHouseTablePtrs
 144+ E46F 5F               LD E, A
 145+ E470 16 00            LD D, 0
 146+ E472 19               ADD HL, DE
 147+ E473 19               ADD HL, DE
 148+ E474 5E               LD E, (HL)
 149+ E475 23               INC HL
 150+ E476 56               LD D, (HL)
 151+ E477 ED 53 ED E3      LD (CurrentHouseRemapTable), DE
 152+ E47B C9               RET
 153+ E47C
 154+ E47C              ; ==============================================================================
 155+ E47C              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E47C              ; ==============================================================================
 157+ E47C              CheckDebugKeys:
 158+ E47C 3E FB            LD A, $FB
 159+ E47E DB FE            IN A, ($FE)
 160+ E480 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E482 20 1C            JR NZ, .notPressed
 162+ E484
 163+ E484                  ; Tecla pulsada: comprobar debounce
 164+ E484 3A F1 E3         LD A, (DebugKeyDebounce)
 165+ E487 B7               OR A
 166+ E488 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E489
 168+ E489                  ; Primera pulsacion: ciclar
 169+ E489 3E 01            LD A, 1
 170+ E48B 32 F1 E3         LD (DebugKeyDebounce), A
 171+ E48E
 172+ E48E 3A EA E3         LD A, (CurrentTimeOfDay)
 173+ E491 3C               INC A
 174+ E492 FE 07            CP NUM_TIME_MOMENTS
 175+ E494 38 01            JR C, .noWrap
 176+ E496 AF               XOR A                   ; Volver a 0 (Dia)
 177+ E497              .noWrap:
 178+ E497 F5               PUSH AF
 179+ E498 CD F2 E3         CALL SetTimeOfDay
 180+ E49B F1               POP AF
 181+ E49C CD 36 EC         CALL SetClockToPhaseHour
 182+ E49F C9               RET
 183+ E4A0
 184+ E4A0              .notPressed:
 185+ E4A0 AF               XOR A
 186+ E4A1 32 F1 E3         LD (DebugKeyDebounce), A
 187+ E4A4
 188+ E4A4                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E4A4 3E FD            LD A, $FD
 190+ E4A6 DB FE            IN A, ($FE)
 191+ E4A8 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E4A9 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E4AB 20 13            JR NZ, .sNotPressed
 194+ E4AD 3A FB E4         LD A, (SpeedKeyDebounce)
 195+ E4B0 B7               OR A
 196+ E4B1 C0               RET NZ
 197+ E4B2 3E 01            LD A, 1
 198+ E4B4 32 FB E4         LD (SpeedKeyDebounce), A
 199+ E4B7 21 24 BD         LD HL, DayCycleCount
 200+ E4BA 7E               LD A, (HL)
 201+ E4BB FE 0A            CP 10
 202+ E4BD D0               RET NC                  ; Ya en maximo
 203+ E4BE 34               INC (HL)
 204+ E4BF C9               RET
 205+ E4C0              .sNotPressed:
 206+ E4C0                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E4C0 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E4C2 20 13            JR NZ, .dNotPressed
 209+ E4C4 3A FB E4         LD A, (SpeedKeyDebounce)
 210+ E4C7 B7               OR A
 211+ E4C8 C0               RET NZ
 212+ E4C9 3E 01            LD A, 1
 213+ E4CB 32 FB E4         LD (SpeedKeyDebounce), A
 214+ E4CE 21 24 BD         LD HL, DayCycleCount
 215+ E4D1 7E               LD A, (HL)
 216+ E4D2 FE 01            CP 1
 217+ E4D4 C8               RET Z                   ; Ya en minimo
 218+ E4D5 35               DEC (HL)
 219+ E4D6 C9               RET
 220+ E4D7              .dNotPressed:
 221+ E4D7 AF               XOR A
 222+ E4D8 32 FB E4         LD (SpeedKeyDebounce), A
 223+ E4DB
 224+ E4DB                  ; --- Tecla N: togglea NoclipMode (debug) ---
 225+ E4DB 3E 7F            LD A, $7F
 226+ E4DD DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 227+ E4DF CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 228+ E4E1 20 13            JR NZ, .nNotPressed
 229+ E4E3 3A FC E4         LD A, (NoclipKeyDebounce)
 230+ E4E6 B7               OR A
 231+ E4E7 C0               RET NZ
 232+ E4E8 3E 01            LD A, 1
 233+ E4EA 32 FC E4         LD (NoclipKeyDebounce), A
 234+ E4ED 3A B5 82         LD A, (NoclipMode)
 235+ E4F0 EE 01            XOR 1
 236+ E4F2 32 B5 82         LD (NoclipMode), A
 237+ E4F5 C9               RET
 238+ E4F6              .nNotPressed:
 239+ E4F6 AF               XOR A
 240+ E4F7 32 FC E4         LD (NoclipKeyDebounce), A
