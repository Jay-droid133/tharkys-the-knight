 587+ DFEF              .bcPhKnocks3:
 588+ DFEF 3E 06            LD A, BCS_GROUP3_KNOCKS
 589+ DFF1 CD 5D E1         CALL BankCutsceneTickKnockGroup
 590+ DFF4 B7               OR A
 591+ DFF5 C8               RET Z
 592+ DFF6                  ; Tras el ultimo de los 6 toques loud, el player se retira a la pos
 593+ DFF6                  ; RETREAT (1 char bajo la puerta) para todo lo que sigue: WAIT_3,
 594+ DFF6                  ; PRE_HAND, HAND_*, KEY_DROP, PLAYER_TURN_CAM.
 595+ DFF6 CD 45 DE         CALL BankCutsceneSnapToRetreat
 596+ DFF9 3E 1E            LD A, BCS_T_PRE_HAND
 597+ DFFB 32 D2 82         LD (BankCutsceneTimer), A
 598+ DFFE 3E 09            LD A, BCP_WAIT_3
 599+ E000 32 D1 82         LD (BankCutscenePhase), A
 600+ E003 C9               RET
 601+ E004
 602+ E004              ; ---- Phase 9: pausa tras toques antes de la aparicion de la mano ----
 603+ E004              ; La puerta NO se abre — la mano sale por la rendija de la puerta cerrada.
 604+ E004              ; SFX_Bank_OnDoorCreak puede sugerir un crujido leve (placeholder RET hoy).
 605+ E004              .bcPhWait3:
 606+ E004 CD 10 E2         CALL BankCutsceneDecTimer
 607+ E007 C0               RET NZ
 608+ E008 CD 2A E2         CALL SFX_Bank_OnDoorCreak
 609+ E00B 3E 14            LD A, BCS_T_PRE_HAND_HOLD
 610+ E00D 32 D2 82         LD (BankCutsceneTimer), A
 611+ E010 3E 0A            LD A, BCP_PRE_HAND
 612+ E012 32 D1 82         LD (BankCutscenePhase), A
 613+ E015 C9               RET
 614+ E016
 615+ E016              ; ---- Phase 10: hold corto antes de la mano ----
 616+ E016              ; Aqui hacemos el "swap" puerta cerrada → mano: XOR-cancel del sprite
 617+ E016              ; bank_door_closed (chars (15,4) en sala (8,8)) → area en negro → drawhand
 618+ E016              ; sobre area limpia. Mismo patron que TownGateOpenDoor con el closed_v2.
 619+ E016              ;
 620+ E016              ; La PRIMERA mano que sale es la abierta (palma) — pide el cheque. Tras un
 621+ E016              ; instante el cheque desaparece del HUD (HAND_OPEN_IN -> HAND_OPEN_TAKE).
 622+ E016              ; Despues la mano abierta se retira (HAND_OPEN_OUT) y, tras una pausa, la
 623+ E016              ; mano "no no" aparece (HAND_NO_NO).
 624+ E016              ;
 625+ E016              ; HandFrame=0 al entrar -> dibuja BgGfx_BankHandOpen1 (frame 1 = seq[0]).
 626+ E016              ; NoIdx=0 -> arranca con 0 slots completados (slot 0 ya dibujado por aqui).
 627+ E016              ; La anim corre dentro de HAND_OPEN_IN consumiendo BCS_OpenHandSeq.
 628+ E016              .bcPhPreHand:
 629+ E016 CD 10 E2         CALL BankCutsceneDecTimer
 630+ E019 C0               RET NZ
 631+ E01A AF               XOR A
 632+ E01B 32 D6 82         LD (BankCutsceneHandFrame), A           ; frame 1 (= seq[0])
 633+ E01E 32 D5 82         LD (BankCutsceneNoIdx), A               ; 0 slots completados
 634+ E021 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; XOR pixels (puerta off) + attrs invertidos
 635+ E024 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; mano abierta frame 1
 636+ E027 CD 2B E2         CALL SFX_Bank_OnHandIn                  ; mismo crujido que cuando se abre la puerta
 637+ E02A 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 638+ E02C 32 D2 82         LD (BankCutsceneTimer), A               ; siguiente slot en SWAP frames
 639+ E02F 3E 13            LD A, BCP_HAND_OPEN_IN
 640+ E031 32 D1 82         LD (BankCutscenePhase), A
 641+ E034 C9               RET
 642+ E035
 643+ E035              ; ---- Phase 19: HAND_OPEN_IN — anim scripted + hold + cobro ----
 644+ E035              ; Tabla BCS_OpenHandSeq dicta la secuencia visible (1 byte por estado:
 645+ E035              ; 0=frame 1, 1=frame 2). NoIdx = nº de slots COMPLETADOS hasta ahora; al
 646+ E035              ; entrar HAND_OPEN_IN el slot 0 (seq[0]) ya esta dibujado por PRE_HAND.
 647+ E035              ;
 648+ E035              ; Cada tick (timer=0):
 649+ E035              ;   - NoIdx >= LEN: hold expirado -> cobro
 650+ E035              ;   - NoIdx <  LEN: avanzar al siguiente slot:
 651+ E035              ;       leer seq[NoIdx], swap al frame indicado si != HandFrame
 652+ E035              ;       NoIdx++
 653+ E035              ;       si NoIdx == LEN: timer = HOLD (ultimo slot ya dibujado, hold estatico)
 654+ E035              ;       si NoIdx <  LEN: timer = SWAP
 655+ E035              ;
 656+ E035              ; Cobro: clink -> CurrentKey=0 -> erase mano -> cierra puerta -> chof
 657+ E035              ;   -> BCP_HAND_OPEN_OUT.
 658+ E035              .bcPhHandOpenIn:
 659+ E035 CD 10 E2         CALL BankCutsceneDecTimer
 660+ E038 C0               RET NZ
 661+ E039 3A D5 82         LD A, (BankCutsceneNoIdx)
 662+ E03C FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 663+ E03E 30 32            JR NC, .bcOpenInCobro                   ; anim + hold acabados -> cobro
 664+ E040                  ; Avanzar al siguiente slot. NoIdx ya esta en A.
 665+ E040 21 8D E0         LD HL, .openHandSeq
 666+ E043 5F               LD E, A
 667+ E044 16 00            LD D, 0
 668+ E046 19               ADD HL, DE
 669+ E047 7E               LD A, (HL)                              ; A = frame deseado en este slot
 670+ E048 47               LD B, A                                 ; B = frame deseado
 671+ E049 3A D6 82         LD A, (BankCutsceneHandFrame)
 672+ E04C B8               CP B
 673+ E04D 28 0C            JR Z, .bcOpenInNoSwap                   ; mismo frame, no hace falta swap
 674+ E04F                  ; OJO: BankCutsceneEraseHandOpen -> DrawHandOpen -> LDIR (con BC=34)
 675+ E04F                  ; corrompe BC. Sin PUSH/POP, B queda a 0 al volver y HandFrame siempre se
 676+ E04F                  ; setea a frame 1 -> animacion invisible (parece estatica).
 677+ E04F C5               PUSH BC                                 ; preserva frame deseado
 678+ E050 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; XOR self-cancel frame actual
 679+ E053 C1               POP BC                                  ; recupera frame deseado
 680+ E054 78               LD A, B
 681+ E055 32 D6 82         LD (BankCutsceneHandFrame), A
 682+ E058 CD F0 E1         CALL BankCutsceneDrawHandOpen           ; draw frame nuevo
 683+ E05B              .bcOpenInNoSwap:
 684+ E05B 3A D5 82         LD A, (BankCutsceneNoIdx)
 685+ E05E 3C               INC A
 686+ E05F 32 D5 82         LD (BankCutsceneNoIdx), A
 687+ E062 FE 07            CP BCS_OPEN_HAND_SEQ_LEN
 688+ E064 28 06            JR Z, .bcOpenInLastSlot
 689+ E066 3E 0A            LD A, BCS_T_OPEN_HAND_SWAP
 690+ E068 32 D2 82         LD (BankCutsceneTimer), A
 691+ E06B C9               RET
 692+ E06C              .bcOpenInLastSlot:
 693+ E06C 3E 1E            LD A, BCS_T_OPEN_HAND_HOLD
 694+ E06E 32 D2 82         LD (BankCutsceneTimer), A
 695+ E071 C9               RET
 696+ E072              .bcOpenInCobro:
 697+ E072 CD 4B E2         CALL SFX_Bank_OnTake                    ; (1) clink (suena primero)
 698+ E075 AF               XOR A
 699+ E076 32 B6 82         LD (CurrentKey), A                      ; (2) consume cheque
 700+ E079 CD 0D E2         CALL BankCutsceneEraseHandOpen          ; (3) mano desaparece (frame final)
 701+ E07C CD BD E1         CALL BankCutsceneCloseDoorRestoreAttrs  ; (4) puerta se cierra
 702+ E07F CD 44 E2         CALL SFX_Bank_OnDoorClose               ; (5) "chof"
 703+ E082 3E 4B            LD A, BCS_T_HAND_OPEN_OUT
 704+ E084 32 D2 82         LD (BankCutsceneTimer), A
 705+ E087 3E 15            LD A, BCP_HAND_OPEN_OUT
 706+ E089 32 D1 82         LD (BankCutscenePhase), A
 707+ E08C C9               RET
 708+ E08D
 709+ E08D              ; Tabla scripted de la animacion de la mano abierta. 1 byte por slot visible:
 710+ E08D              ;   0 = BgGfx_BankHandOpen1 (frame 1, primera pose)
 711+ E08D              ;   1 = BgGfx_BankHandOpen2 (frame 2, segunda pose)
 712+ E08D              ; Secuencia: 1 1 2 1 2 1 1 (visible al usuario). Termina en frame 1.
 713+ E08D              ; LABEL LOCAL (con dot) para preservar el scope sjasmplus de UpdateBankCutscene
 714+ E08D              ; — un label global aqui rompe el scope de los .bcPhXxx posteriores en el
 715+ E08D              ; dispatcher.
 716+ E08D              .openHandSeq:
 717+ E08D 00 00 01 00      DEFB 0, 0, 1, 0, 1, 0, 0
 717+ E091 01 00 00
 718+ E094
 719+ E094              ; ---- Phase 21: HAND_OPEN_OUT — puerta cerrada, pausa antes del "no no" ----
 720+ E094              ; Al expirar: la puerta se reabre y arranca el ciclo "no no":
 721+ E094              ;   1. Re-XOR-cancel pixels puerta + attrs $47 (mismo helper que PRE_HAND).
 722+ E094              ;   2. SFX creak de puerta abrir.
 723+ E094              ;   3. Reset HandFrame/NoIdx (defensivo — ya 0).
 724+ E094              ;   4. Dibuja "no no" frame 0.
 725+ E094              ;   5. -> BCP_HAND_NO_NO con timer BCS_T_NO_FRAME.
 726+ E094              .bcPhHandOpenOut:
 727+ E094 CD 10 E2         CALL BankCutsceneDecTimer
 728+ E097 C0               RET NZ
 729+ E098 CD 9B E1         CALL BankCutsceneOpenDoorWithHandAttrs  ; (1) reabre puerta (pixels + attrs $47)
 730+ E09B CD 2B E2         CALL SFX_Bank_OnHandIn                  ; (2) creak (mismo SFX que PRE_HAND)
 731+ E09E AF               XOR A
 732+ E09F 32 D6 82         LD (BankCutsceneHandFrame), A           ; (3) reset
 733+ E0A2 32 D5 82         LD (BankCutsceneNoIdx), A
 734+ E0A5 CD D0 E1         CALL BankCutsceneDrawHand               ; (4) "no no" frame 0
 735+ E0A8 3E 0C            LD A, BCS_T_NO_FRAME
 736+ E0AA 32 D2 82         LD (BankCutsceneTimer), A
 737+ E0AD 3E 0C            LD A, BCP_HAND_NO_NO                    ; (5)
 738+ E0AF 32 D1 82         LD (BankCutscenePhase), A
 739+ E0B2 C9               RET
 740+ E0B3
 741+ E0B3              ; ---- Phase 11: hand visible + pause antes de "no no" ----
 742+ E0B3              ; SALTADA. Codigo conservado por si se revierte el skip (ver .bcPhPreHand).
 743+ E0B3              ; Mientras nadie ponga BankCutscenePhase = BCP_HAND_IN, este branch es
 744+ E0B3              ; inalcanzable; el dispatcher JP Z, .bcPhHandIn (linea ~357) nunca matchea.
 745+ E0B3              .bcPhHandIn:
 746+ E0B3 CD 10 E2         CALL BankCutsceneDecTimer
 747+ E0B6 C0               RET NZ
 748+ E0B7 3E 0C            LD A, BCS_T_NO_FRAME
 749+ E0B9 32 D2 82         LD (BankCutsceneTimer), A
 750+ E0BC 3E 0C            LD A, BCP_HAND_NO_NO
 751+ E0BE 32 D1 82         LD (BankCutscenePhase), A
 752+ E0C1 C9               RET
 753+ E0C2
 754+ E0C2              ; ---- Phase 12: anim "no no" — swaps frame 0/1, 8 veces (4 "no" cycles) ----
 755+ E0C2              .bcPhHandNoNo:
 756+ E0C2 CD 10 E2         CALL BankCutsceneDecTimer
 757+ E0C5 C0               RET NZ
 758+ E0C6                  ; Swap frame: erase actual + draw el otro.
 759+ E0C6 CD ED E1         CALL BankCutsceneEraseHand          ; erase frame actual (XOR self-cancel)
 760+ E0C9 3A D6 82         LD A, (BankCutsceneHandFrame)
 761+ E0CC EE 01            XOR 1
 762+ E0CE 32 D6 82         LD (BankCutsceneHandFrame), A
 763+ E0D1 CD D0 E1         CALL BankCutsceneDrawHand           ; draw frame nuevo
 764+ E0D4 CD 31 E2         CALL SFX_Bank_OnNoSwap              ; cada swap suena (placeholder)
 765+ E0D7                  ; Increment swap idx, check completion.
 766+ E0D7 3A D5 82         LD A, (BankCutsceneNoIdx)
 767+ E0DA 3C               INC A
 768+ E0DB 32 D5 82         LD (BankCutsceneNoIdx), A
 769+ E0DE FE 08            CP BCS_NO_SWAPS_TOTAL
 770+ E0E0 38 0B            JR C, .bcNoNoMoreSwaps
 771+ E0E2                  ; Todos los swaps hechos — pausa antes de erase mano.
 772+ E0E2 3E 0F            LD A, BCS_T_HAND_HOLD
 773+ E0E4 32 D2 82         LD (BankCutsceneTimer), A
 774+ E0E7                  ; Avanzar phase implicitamente al siguiente (HAND_OUT pasa por
 775+ E0E7                  ; eraseHand pero queremos un frame de hold antes — gestionado abajo).
 776+ E0E7 3E 0D            LD A, BCP_HAND_OUT
 777+ E0E9 32 D1 82         LD (BankCutscenePhase), A
 778+ E0EC C9               RET
 779+ E0ED              .bcNoNoMoreSwaps:
 780+ E0ED 3E 0C            LD A, BCS_T_NO_FRAME
 781+ E0EF 32 D2 82         LD (BankCutsceneTimer), A
 782+ E0F2 C9               RET
 783+ E0F3
 784+ E0F3              ; ---- Phase 13: erase mano → spawn llave de la ciudad → pausa antes del giro ----
 785+ E0F3              ; Reutiliza TownGateKeySpawned + BgGfx_town_gate_key (el sprite que antes
 786+ E0F3              ; soltaba la iglesia; ahora su placement vive en sala (8,8) por placement
 787+ E0F3              ; del editor y lo revela esta cinematica via RedrawPickupByPtr — XOR-show
 788+ E0F3              ; del pickup dormant).
 789+ E0F3              ; ---- Phase 13: HAND_OUT — erase mano + cierre visible de la puerta ----
 790+ E0F3              ; Beat dedicado para el cierre de puerta: el player ve la mano irse y la
 791+ E0F3              ; puerta cerrarse como evento, ANTES del drop de la llave. Tras esto, una
 792+ E0F3              ; pausa BCS_T_DOOR_CLOSED_HOLD permite "asentar" el cierre antes del clink
 793+ E0F3              ; de la llave.
 794+ E0F3              .bcPhHandOut:
 795+ E0F3 CD 10 E2         CALL BankCutsceneDecTimer           ; HAND_HOLD: pausa con mano visible
 796+ E0F6 C0               RET NZ
 797+ E0F7 CD ED E1         CALL BankCutsceneEraseHand          ; erase XOR self-cancel
 798+ E0FA CD BD E1         CALL BankCutsceneCloseDoorRestoreAttrs ; SET pixels + restaurar attrs originales
 799+ E0FD CD 44 E2         CALL SFX_Bank_OnDoorClose           ; SFX "chof" cierre de puerta
 800+ E100 CD 6B DE         CALL BankCutsceneSnapToBackOff      ; player baja 1 char extra (reaccion al portazo final)
 801+ E103 3E 1E            LD A, BCS_T_DOOR_CLOSED_HOLD
 802+ E105 32 D2 82         LD (BankCutsceneTimer), A
 803+ E108 3E 12            LD A, BCP_DOOR_CLOSED
 804+ E10A 32 D1 82         LD (BankCutscenePhase), A
 805+ E10D C9               RET
 806+ E10E
 807+ E10E              ; ---- Phase 18: DOOR_CLOSED — pausa con puerta cerrada → spawn de la llave ----
 808+ E10E              .bcPhDoorClosed:
 809+ E10E CD 10 E2         CALL BankCutsceneDecTimer
 810+ E111 C0               RET NZ
 811+ E112                  ; --- Spawn de la llave de la ciudad ---
 812+ E112 3E 01            LD A, 1
 813+ E114 32 CA 82         LD (TownGateKeySpawned), A
 814+ E117 21 21 FB         LD HL, SFX_KeyDrop
 815+ E11A CD 44 6D         CALL PlaySFX_B7
 816+ E11D 11 CC D7         LD DE, BgGfx_town_gate_key
 817+ E120 CD 3B 6D         CALL RedrawPickupByPtr_B7
 818+ E123                  ; Pausa KEY_HOLD con la llave visible antes de que el player gire.
 819+ E123 3E 1E            LD A, BCS_T_KEY_HOLD
 820+ E125 32 D2 82         LD (BankCutsceneTimer), A
 821+ E128 3E 0E            LD A, BCP_KEY_DROP
 822+ E12A 32 D1 82         LD (BankCutscenePhase), A
 823+ E12D C9               RET
 824+ E12E
 825+ E12E              ; ---- Phase 14: pausa con la llave visible → giro a camara ----
 826+ E12E              .bcPhKeyDrop:
 827+ E12E CD 10 E2         CALL BankCutsceneDecTimer
 828+ E131 C0               RET NZ
 829+ E132                  ; Player gira a camara final.
 830+ E132 DD 21 A3 81      LD IX, EntityTable
 831+ E136 3E 00            LD A, SPRID_IDLE
 832+ E138 DD 77 00         LD (IX+ENT_SPRITEID), A
 833+ E13B DD 77 08         LD (IX+ENT_ANIMBASE), A
 834+ E13E AF               XOR A
 835+ E13F DD 77 09         LD (IX+ENT_ANIMTIMER), A
 836+ E142 CD 56 6D         CALL TownGateRedrawPlayer_B7
 837+ E145 CD 4A E2         CALL SFX_Bank_OnPlayerTurn
 838+ E148 3E 1E            LD A, BCS_T_PLAYER_TURN_FINAL
 839+ E14A 32 D2 82         LD (BankCutsceneTimer), A
 840+ E14D 3E 0F            LD A, BCP_PLAYER_TURN_CAM
 841+ E14F 32 D1 82         LD (BankCutscenePhase), A
 842+ E152 C9               RET
 843+ E153
 844+ E153              ; ---- Phase 15: player mirando camara antes de devolver control ----
 845+ E153              .bcPhPlayerTurnCam:
 846+ E153 CD 10 E2         CALL BankCutsceneDecTimer
 847+ E156 C0               RET NZ
 848+ E157                  ; Setear DONE → siguiente UpdateBankCutscene cae al fallthrough y pone IDLE.
 849+ E157 3E 10            LD A, BCP_DONE
 850+ E159 32 D1 82         LD (BankCutscenePhase), A
 851+ E15C C9               RET
 852+ E15D
 853+ E15D              ; ==============================================================================
 854+ E15D              ; BankCutsceneTickKnockGroup - tick comun del knock-loop
 855+ E15D              ; ==============================================================================
 856+ E15D              ; IN:  A = total knocks del grupo (BCS_GROUP1_KNOCKS / GROUP2 / GROUP3).
 857+ E15D              ; OUT: A = 1 si grupo terminado, 0 si sigue. Caller decide phase next.
 858+ E15D              ;
 859+ E15D              ; Estado:
 860+ E15D              ;   BankCutsceneSubState: 0=HIT, 1=GAP
 861+ E15D              ;   BankCutsceneTimer:    decrementa por frame
 862+ E15D              ;   BankCutsceneKnockIdx: knocks emitidos hasta ahora
 863+ E15D              ;
 864+ E15D              ; Logica:
 865+ E15D              ;   - Tick timer. Si != 0, return 0.
 866+ E15D              ;   - Si SubState=HIT y timer=0 → switch a GAP, set timer = T_KNOCK_GAP.
 867+ E15D              ;   - Si SubState=GAP y timer=0:
 868+ E15D              ;       - increment KnockIdx
 869+ E15D              ;       - if KnockIdx >= total: return 1 (grupo terminado)
 870+ E15D              ;       - else: switch a HIT, emit knock, set timer = T_KNOCK_HIT.
 871+ E15D              ;
 872+ E15D              ; Destruye: A, BC, DE, HL.
 873+ E15D              ; ==============================================================================
 874+ E15D              BankCutsceneTickKnockGroup:
 875+ E15D 47               LD B, A                             ; B = total knocks
 876+ E15E 3A D2 82         LD A, (BankCutsceneTimer)
 877+ E161 3D               DEC A
 878+ E162 32 D2 82         LD (BankCutsceneTimer), A
 879+ E165 B7               OR A
 880+ E166 28 02            JR Z, .bctkgTimer0
 881+ E168 AF               XOR A                               ; sigue, no terminado
 882+ E169 C9               RET
 883+ E16A              .bctkgTimer0:
 884+ E16A 3A D3 82         LD A, (BankCutsceneSubState)
 885+ E16D B7               OR A
 886+ E16E 20 0C            JR NZ, .bctkgGap0
 887+ E170                  ; HIT acabo: switch a GAP.
 888+ E170 3E 01            LD A, BCS_KNOCK_GAP
 889+ E172 32 D3 82         LD (BankCutsceneSubState), A
 890+ E175 3E 05            LD A, BCS_T_KNOCK_GAP
 891+ E177 32 D2 82         LD (BankCutsceneTimer), A
 892+ E17A AF               XOR A
 893+ E17B C9               RET
 894+ E17C              .bctkgGap0:
 895+ E17C                  ; GAP acabo: increment KnockIdx, comparar con B (total).
 896+ E17C 3A D4 82         LD A, (BankCutsceneKnockIdx)
 897+ E17F 3C               INC A
 898+ E180 32 D4 82         LD (BankCutsceneKnockIdx), A
 899+ E183 B8               CP B
 900+ E184 38 03            JR C, .bctkgNextHit                 ; aun queda al menos 1 toque
 901+ E186                  ; grupo terminado.
 902+ E186 3E 01            LD A, 1
 903+ E188 C9               RET
 904+ E189              .bctkgNextHit:
 905+ E189 3E 00            LD A, BCS_KNOCK_HIT
 906+ E18B 32 D3 82         LD (BankCutsceneSubState), A
 907+ E18E 3E 04            LD A, BCS_T_KNOCK_HIT
 908+ E190 32 D2 82         LD (BankCutsceneTimer), A
 909+ E193 CD 98 E1         CALL BankCutsceneEmitKnockHit
 910+ E196 AF               XOR A
 911+ E197 C9               RET
 912+ E198
 913+ E198              ; ==============================================================================
 914+ E198              ; BankCutsceneEmitKnockHit - SFX + (TODO) door shake del toque actual
 915+ E198              ; ==============================================================================
 916+ E198              ; Llamado al inicio de cada hit. Por ahora: solo SFX placeholder.
 917+ E198              ; TODO: door shake — XOR-redraw del Bank facade con offset ±1 px en eje X.
 918+ E198              ; Destruye: A, BC, DE, HL.
 919+ E198              ; ==============================================================================
 920+ E198              BankCutsceneEmitKnockHit:
 921+ E198 C3 1A E2         JP SFX_Bank_OnKnock                 ; tail-call
 922+ E19B
 923+ E19B              ; ==============================================================================
 924+ E19B              ; BCS_DOOR_HAND_ATTR  — attrs durante la fase de mano (paper=000 black,
 925+ E19B              ; ink=111 white, bright=1). Inversion respecto a $78 (paper bright white,
 926+ E19B              ; ink black) que es el attr base del door sprite. Hace que la mano (XOR
 927+ E19B              ; pixels) se vea bright white sobre fondo negro = "mano emerge de la
 928+ E19B              ; oscuridad de la rendija".
 929+ E19B              BCS_DOOR_HAND_ATTR      EQU $47
 930+ E19B
 931+ E19B              ; Direcciones de attrs en VRAM para los 4 chars (15-16, 4-5).
 932+ E19B              ; Display row = char_row + BG_Y_OFFSET (2). attr_addr = $5800 + row*32 + col.
 933+ E19B              ; Char (15, 4) → display row 6 → $5800 + 192 + 15 = $58CF.
 934+ E19B              ; Char (16, 4) → $58D0. (15, 5) → $58EF. (16, 5) → $58F0.
 935+ E19B              BCS_DOOR_ATTR_ADDR_TL   EQU $58CF       ; top-left
 936+ E19B
 937+ E19B              ; ==============================================================================
 938+ E19B              ; BankCutsceneOpenDoorWithHandAttrs - XOR-cancel pixels de bank_door_closed
 939+ E19B              ; + sobreescribir los 4 attrs de los chars (15-16, 4-5) con el attr "hand mode"
 940+ E19B              ; (paper black, ink bright white). El hand sprite drawing posterior dejara
 941+ E19B              ; pixels visibles bright white sobre fondo negro.
 942+ E19B              ;
 943+ E19B              ; CRITICO: usar DrawBgSpriteXOR (XOR), NO DrawBgGfxSprite (LD destructivo).
 944+ E19B              ; DrawBgGfxSprite hace `LD (HL), A` que reescribe pixels en lugar de XOR —
 945+ E19B              ; dos llamadas no cancelan, solo re-pintan.
 946+ E19B              ; Destruye: AF, BC, DE, HL, IX.
 947+ E19B              ; ==============================================================================
 948+ E19B              BankCutsceneOpenDoorWithHandAttrs:
 949+ E19B 21 14 F1         LD HL, BgGfx_bank_door_closed
 950+ E19E 3E 03            LD A, 3                             ; bank 3
 951+ E1A0 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7        ; thunk slot 1: carga + repagina bank 7 al RET
 952+ E1A3 DD 21 FD 86      LD IX, BgSpriteBuffer
 953+ E1A7 06 0F            LD B, BCS_DOOR_CHARX                ; 15
 954+ E1A9 0E 04            LD C, BCS_DOOR_CHARY                ; 4
 955+ E1AB CD 20 6D         CALL DrawBgSpriteXOR_B7             ; XOR-cancel pixels (attrs intactos $78)
 956+ E1AE                  ; Sobreescribir attrs a "hand mode" = $47.
 957+ E1AE 3E 47            LD A, BCS_DOOR_HAND_ATTR
 958+ E1B0 21 CF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL        ; $58CF (15, 4 display row 6)
 959+ E1B3 77               LD (HL), A
 960+ E1B4 23               INC HL                              ; $58D0 (16, 4)
 961+ E1B5 77               LD (HL), A
 962+ E1B6 21 EF 58         LD HL, BCS_DOOR_ATTR_ADDR_TL + 32   ; $58EF (15, 5)
 963+ E1B9 77               LD (HL), A
 964+ E1BA 23               INC HL                              ; $58F0 (16, 5)
 965+ E1BB 77               LD (HL), A
 966+ E1BC C9               RET
 967+ E1BD
 968+ E1BD              ; ==============================================================================
 969+ E1BD              ; BankCutsceneCloseDoorRestoreAttrs - usa DrawBgGfxSprite (SET pixels + PAINT
 970+ E1BD              ; attrs originales del sprite, $78). Esto restaura tanto los pixels de la
 971+ E1BD              ; puerta cerrada como los attrs originales (paper bright white, ink black).
 972+ E1BD              ;
 973+ E1BD              ; Asume que VRAM en el area de la puerta esta a 0 (post-EraseHand).
 974+ E1BD              ; DrawBgGfxSprite SET pixels = mismo resultado que XOR sobre 0.
 975+ E1BD              ; Destruye: AF, BC, DE, HL, IX.
 976+ E1BD              ; ==============================================================================
 977+ E1BD              BankCutsceneCloseDoorRestoreAttrs:
 978+ E1BD 21 14 F1         LD HL, BgGfx_bank_door_closed
 979+ E1C0 3E 03            LD A, 3
 980+ E1C2 CD 5F 6D         CALL LoadBgSpriteToBuffer_B7        ; thunk: carga + repagina bank 7
 981+ E1C5 DD 21 FD 86      LD IX, BgSpriteBuffer
 982+ E1C9 06 0F            LD B, BCS_DOOR_CHARX
 983+ E1CB 0E 04            LD C, BCS_DOOR_CHARY
 984+ E1CD                  ; BgSpriteIsHouse + CurrentTintVar viven en bank 0. El thunk DrawBgGfxSprite_B7
 985+ E1CD                  ; ahora hace las dos escrituras (XOR A; LD (BgSpriteIsHouse), A; LD A, $FF;
 986+ E1CD                  ; LD (CurrentTintVar), A) DENTRO del wrap con bank 0 paginated antes del CALL
 987+ E1CD                  ; DrawBgGfxSprite. Sin esto el draw usaria valores stale -> tint/attr
 988+ E1CD                  ; incorrectos -> puerta invisible. (Fusionado para ahorrar 18 B en slot 1.)
 989+ E1CD C3 29 6D         JP DrawBgGfxSprite_B7               ; tail-call thunk: paginate bank 0, set flags, draw, repaginate bank 7
 990+ E1D0
 991+ E1D0              ; ==============================================================================
 992+ E1D0              ; BankCutsceneDrawHand - draw mano frame actual en (BCS_HAND_PX_X, Y)
 993+ E1D0              ; ==============================================================================
 994+ E1D0              ; DrawBgSprite16XorAtPixel lee el sprite de BgSpriteBuffer (NO de HL).
 995+ E1D0              ; Antes de llamarlo, LDIR los 34 bytes del frame (header 2 + pixel 32) a
 996+ E1D0              ; BgSpriteBuffer — mismo patron que DrawSmokeFrameXor en church_cutscene.
 997+ E1D0              ; Esto es critico aqui porque la llamada previa (BankCutsceneRedrawClosedDoor)
 998+ E1D0              ; deja el sprite de la puerta en BgSpriteBuffer, no la mano.
 999+ E1D0              ; Destruye: AF, BC, DE, HL, IX.
1000+ E1D0              ; ==============================================================================
1001+ E1D0              BankCutsceneDrawHand:
1002+ E1D0 3A D6 82         LD A, (BankCutsceneHandFrame)
1003+ E1D3 B7               OR A
1004+ E1D4 20 05            JR NZ, .bcdhFrame1
1005+ E1D6 21 51 E2         LD HL, BgGfx_BankHandFrame0
1006+ E1D9 18 03            JR .bcdhCopy
1007+ E1DB              .bcdhFrame1:
1008+ E1DB 21 73 E2         LD HL, BgGfx_BankHandFrame1
1009+ E1DE              .bcdhCopy:
1010+ E1DE 11 FD 86         LD DE, BgSpriteBuffer
1011+ E1E1 01 22 00         LD BC, 34                           ; header 2 + pixel data 32 = 34 bytes
1012+ E1E4 ED B0            LDIR
1013+ E1E6 16 30            LD D, BCS_HAND_PX_Y
1014+ E1E8 1E 78            LD E, BCS_HAND_PX_X
1015+ E1EA C3 38 66         JP DrawBgSprite16XorAtPixel         ; tail-call (lee BgSpriteBuffer)
1016+ E1ED
1017+ E1ED              ; ==============================================================================
1018+ E1ED              ; BankCutsceneEraseHand - XOR self-cancel del frame actual
1019+ E1ED              ; ==============================================================================
1020+ E1ED              ; Mismo draw — XOR self-cancela. NO incrementa BankCutsceneHandFrame.
1021+ E1ED              ; Destruye: AF, BC, DE, HL, IX.
1022+ E1ED              ; ==============================================================================
1023+ E1ED              BankCutsceneEraseHand:
1024+ E1ED C3 D0 E1         JP BankCutsceneDrawHand             ; tail-call (XOR self-cancel)
