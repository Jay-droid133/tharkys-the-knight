1009+ 6792              ; ==============================================================================
1010+ 6792              ; TownGateExitStep - 1 step del slide-out. Cada TGCS_T_EXIT_STEP frames
1011+ 6792              ; ==============================================================================
1012+ 6792              ; avanza POSY +1 y alterna animacion de WALK_S. Dibujo via DrawSprite que
1013+ 6792              ; clipea a 192 internamente. La parte que cae en HUD (rows 22-23) se ve
1014+ 6792              ; sobreescrita por DrawClockHUD/DrawKeyHUD/etc en el mismo frame, asi que
1015+ 6792              ; visualmente la mitad inferior del player desaparece tras la HUD.
1016+ 6792              ; ==============================================================================
1017+ 6792              TownGateExitStep:
1018+ 6792 3A A8 5F         LD A, (TownGateExitStepCnt)
1019+ 6795 3C               INC A
1020+ 6796 32 A8 5F         LD (TownGateExitStepCnt), A
1021+ 6799 FE 02            CP TGCS_T_EXIT_STEP
1022+ 679B D8               RET C                               ; aun no toca step
1023+ 679C AF               XOR A
1024+ 679D 32 A8 5F         LD (TownGateExitStepCnt), A
1025+ 67A0                  ; Avanzar POSY +1, alternar frame WALK_S (toggle base+0 / base+1)
1026+ 67A0 DD 21 9B 81      LD IX, EntityTable
1027+ 67A4 DD 7E 04         LD A, (IX+ENT_POSY)
1028+ 67A7 3C               INC A
1029+ 67A8 DD 77 04         LD (IX+ENT_POSY), A
1030+ 67AB 32 DC 82         LD (PlayerDrawY), A
1031+ 67AE 3A A9 5F         LD A, (TownGateExitWalkFrame)
1032+ 67B1 EE 01            XOR 1                               ; toggle 0/1
1033+ 67B3 32 A9 5F         LD (TownGateExitWalkFrame), A
1034+ 67B6 47               LD B, A
1035+ 67B7 3E 0E            LD A, SPRID_WALK_S
1036+ 67B9 80               ADD A, B
1037+ 67BA DD 77 00         LD (IX+ENT_SPRITEID), A
1038+ 67BD                  ; Clipped XOR: pixels del player NUNCA se escriben dentro del rect
1039+ 67BD                  ; vertical de part1 (rows 120-151). Eliminacion limpia del solapamiento.
1040+ 67BD                  ; Sin RestoreOldAttr ni SetEntityAttr en cada step → no hay clobber de
1041+ 67BD                  ; part1 attrs ni de door attrs.
1042+ 67BD CD 2F 66         CALL TownGatePlayerSlideErase
1043+ 67C0 C3 65 66         JP TownGatePlayerSlideDraw          ; tail call
1044+ 67C3
1045+ 67C3              ; ==============================================================================
1046+ 67C3              ; TownGateDrawTheEnd - dibuja el sprite "The End" en (TGCS_END_CHARX, _Y)
1047+ 67C3              ; ==============================================================================
1048+ 67C3              ; El sprite original "the end" (id 243, 88x72=891 B) se troceo en dos partes
1049+ 67C3              ; horizontales para no consumir el 87% de BgSpriteBuffer:
1050+ 67C3              ;   - the_end_part1 (id 47, 88x32 = 11x4 chars, 396 B): mitad superior.
1051+ 67C3              ;   - the_end_part2 (id 48, 88x40 = 11x5 chars, 495 B): mitad inferior.
1052+ 67C3              ; Bank 3. RLE-comprimidos (bit 7 de width_bytes set), asi que NO podemos
1053+ 67C3              ; usar DrawBgSpriteXOR (produce distorsion). Usamos DrawBgGfxSprite, la
1054+ 67C3              ; rutina normal de render BG: decodifica RLE + pinta pixels + attrs.
1055+ 67C3              ; Destruye: AF, BC, DE, HL, IX.
1056+ 67C3              ; ==============================================================================
1057+ 67C3              TownGateDrawTheEnd:
1058+ 67C3                  ; --- Part 1: mitad superior (11x4 chars) ---
1059+ 67C3 21 72 EC         LD HL, BgGfx_the_end_part1
1060+ 67C6 3E 03            LD A, 3
1061+ 67C8 CD C2 6C         CALL LoadBgSpriteToBuffer
1062+ 67CB DD 21 F5 86      LD IX, BgSpriteBuffer
1063+ 67CF 06 0B            LD B, TGCS_END_CHARX
1064+ 67D1 0E 04            LD C, TGCS_END_CHARY
1065+ 67D3 AF               XOR A
1066+ 67D4 32 D5 E2         LD (BgSpriteIsHouse), A
1067+ 67D7 32 74 D2         LD (CurrentTintVar), A              ; sin tint
1068+ 67DA CD 6A D1         CALL DrawBgGfxSprite
1069+ 67DD
1070+ 67DD                  ; --- Part 2: mitad inferior (11x5 chars), 4 chars debajo de part1 ---
1071+ 67DD 21 E5 ED         LD HL, BgGfx_the_end_part2
1072+ 67E0 3E 03            LD A, 3
1073+ 67E2 CD C2 6C         CALL LoadBgSpriteToBuffer
1074+ 67E5 DD 21 F5 86      LD IX, BgSpriteBuffer
1075+ 67E9 06 0B            LD B, TGCS_END_CHARX
1076+ 67EB 0E 08            LD C, TGCS_END_CHARY + 4
1077+ 67ED AF               XOR A
1078+ 67EE 32 D5 E2         LD (BgSpriteIsHouse), A
1079+ 67F1 32 74 D2         LD (CurrentTintVar), A
1080+ 67F4 C3 6A D1         JP DrawBgGfxSprite                  ; tail call
1081+ 67F7
1082+ 67F7              ; ==============================================================================
1083+ 67F7              ; TownGateWipeBlack - rellena VRAM (pixels + attrs) con 0
1084+ 67F7              ; ==============================================================================
1085+ 67F7              ; LDIR a $4000-$57FF (pixels) y $5800-$5AFF (attrs) con 0. Tras esto, el
1086+ 67F7              ; HUD se redibujara (DrawClockHUD etc se llaman cada frame en MainLoop) y
1087+ 67F7              ; quedara visible sobre fondo negro.
1088+ 67F7              ; ==============================================================================
1089+ 67F7              TownGateWipeBlack:
1090+ 67F7 21 00 40         LD HL, $4000
1091+ 67FA 11 01 40         LD DE, $4001
1092+ 67FD 01 FF 17         LD BC, $17FF
1093+ 6800 36 00            LD (HL), 0
1094+ 6802 ED B0            LDIR
1095+ 6804 21 00 58         LD HL, $5800
1096+ 6807 11 01 58         LD DE, $5801
1097+ 680A 01 FF 02         LD BC, $02FF
1098+ 680D 36 00            LD (HL), $00                        ; ink black, paper black
1099+ 680F ED B0            LDIR
1100+ 6811 C9               RET
1101+ 6812
1102+ 6812              ; ==============================================================================
1103+ 6812              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1104+ 6812              ; ==============================================================================
1105+ 6812              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1106+ 6812              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1107+ 6812              ; (white ink, black paper, bright) para todo el area de texto.
1108+ 6812              ; ==============================================================================
1109+ 6812              TownGateDrawCredits:
1110+ 6812                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1111+ 6812 21 00 58         LD HL, $5800
1112+ 6815 11 01 58         LD DE, $5801
1113+ 6818 01 FF 02         LD BC, $02FF
1114+ 681B 36 47            LD (HL), $47
1115+ 681D ED B0            LDIR
1116+ 681F                  ; Iterar credits
1117+ 681F 21 73 68         LD HL, TownGateCreditsData
1118+ 6822              .tgdcLoop:
1119+ 6822 7E               LD A, (HL)
1120+ 6823 FE FF            CP $FF
1121+ 6825 C8               RET Z
1122+ 6826 57               LD D, A                             ; D = row
1123+ 6827 23               INC HL
1124+ 6828 7E               LD A, (HL)
1125+ 6829 5F               LD E, A                             ; E = col
1126+ 682A 23               INC HL                              ; HL → string
1127+ 682B CD 30 68         CALL PrintStringFontAt
1128+ 682E 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1129+ 6830
1130+ 6830              ; ==============================================================================
1131+ 6830              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1132+ 6830              ; ==============================================================================
1133+ 6830              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1134+ 6830              ; siguiente byte tras el 0 (para que el caller siga iterando).
1135+ 6830              ; Destruye: AF, BC, DE, HL.
1136+ 6830              ; OUT: HL apunta al byte tras el 0 terminador.
1137+ 6830              ; ==============================================================================
1138+ 6830              PrintStringFontAt:
1139+ 6830              .psfaCharLoop:
1140+ 6830 7E               LD A, (HL)
1141+ 6831 23               INC HL
1142+ 6832 B7               OR A
1143+ 6833 C8               RET Z                               ; fin de string
1144+ 6834 E5               PUSH HL
1145+ 6835 D5               PUSH DE
1146+ 6836 CD 3E 68         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1147+ 6839 D1               POP DE
1148+ 683A E1               POP HL
1149+ 683B 1C               INC E                               ; siguiente columna
1150+ 683C 18 F2            JR .psfaCharLoop
1151+ 683E
1152+ 683E              ; ==============================================================================
1153+ 683E              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1154+ 683E              ; ==============================================================================
1155+ 683E              ; D = row (0..23), E = col (0..31), A = ASCII char.
1156+ 683E              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1157+ 683E              ;   y = row * 8, x = col * 8
1158+ 683E              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1159+ 683E              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1160+ 683E              ; Destruye: AF, BC, DE, HL.
1161+ 683E              ; ==============================================================================
1162+ 683E              DrawCharFontAt:
1163+ 683E D5               PUSH DE
1164+ 683F                  ; HL = $3C00 + char * 8
1165+ 683F 6F               LD L, A
1166+ 6840 26 00            LD H, 0
1167+ 6842 29               ADD HL, HL
1168+ 6843 29               ADD HL, HL
1169+ 6844 29               ADD HL, HL
1170+ 6845 01 00 3C         LD BC, $3C00
1171+ 6848 09               ADD HL, BC
1172+ 6849 D1               POP DE
1173+ 684A                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1174+ 684A E5               PUSH HL                             ; save font ptr
1175+ 684B 7A               LD A, D
1176+ 684C 87               ADD A, A
1177+ 684D 87               ADD A, A
1178+ 684E 87               ADD A, A                            ; A = row * 8 = pixel Y
1179+ 684F 57               LD D, A
1180+ 6850 7B               LD A, E
1181+ 6851 87               ADD A, A
1182+ 6852 87               ADD A, A
1183+ 6853 87               ADD A, A                            ; A = col * 8 = pixel X
1184+ 6854 5F               LD E, A
1185+ 6855 CD 5A 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
1186+ 6858 EB               EX DE, HL                           ; DE = VRAM addr
1187+ 6859 E1               POP HL                              ; HL = font ptr
1188+ 685A 06 08            LD B, 8
1189+ 685C              .dcfaLoop:
1190+ 685C 7E               LD A, (HL)
1191+ 685D 12               LD (DE), A
1192+ 685E 23               INC HL
1193+ 685F 14               INC D                               ; siguiente scan line (within char)
1194+ 6860 10 FA            DJNZ .dcfaLoop
1195+ 6862 C9               RET
