 606  E382                  ; --- Magic compass BFS Inner body (~690 B, slot 1 -> bank 7 move) ---
 607  E382                  ; _ComputeMagicCompassPath_Inner + helpers + locales DEFB. Antes vivian
 608  E382                  ; al final de magic_compass.asm en slot 1, pero los thunks de
 609  E382                  ; bank_cutscene_thunks.asm los empujaron sobre $7A00 (la tabla IM2 los
 610  E382                  ; sobreescribia con $7B). Movido aqui para preservar magic compass.
 611  E382                  ; ComputeMagicCompassPath en slot 1 pagina bank 7 antes de CALL _Inner;
 612  E382                  ; el wrapper se encarga del paging. Sin SP swap necesario porque el body
 613  E382                  ; permanece visible toda su ejecucion.
 614  E382                  INCLUDE "magic_compass_bfs_bank7.asm"
# file opened: magic_compass_bfs_bank7.asm
   1+ E382              ; ==============================================================================
   2+ E382              ; magic_compass_bfs_bank7.asm - BFS Inner body movido a bank 7
   3+ E382              ; ==============================================================================
   4+ E382              ; _ComputeMagicCompassPath_Inner + sus helpers + locales DEFB. Antes vivía
   5+ E382              ; al final de magic_compass.asm en slot 1, pero al añadir los thunks de
   6+ E382              ; bank_cutscene_thunks.asm (~135 B), el código se desplazaba sobre $7A00 ->
   7+ E382              ; la tabla IM2 lo sobreescribia con $7B -> BFS retornaba basura -> magic
   8+ E382              ; compass siempre PathDir=$FF -> brújula clásica blanca inmóvil.
   9+ E382              ;
  10+ E382              ; Solución: mover ~690 B del BFS Inner aquí, a bank 7. ComputeMagicCompassPath
  11+ E382              ; en slot 1 ya pagina bank 7 antes de llamar a _Inner, así que el cuerpo
  12+ E382              ; permanece visible durante toda su ejecución. Sin SP swap necesario:
  13+ E382              ;   - ComputeMagicCompassPath ENTERS con bank 0 paginated, SP en stack normal.
  14+ E382              ;   - Pagina bank 7, CALL _Inner. PUSH PC va a stack-2 en bank 7 (slot 3).
  15+ E382              ;   - _Inner ejecuta, PUSHes/POPs/CALLs internos en bank 7 stack. RET pops
  16+ E382              ;     de bank 7. Stack consistent durante toda la ejecución.
  17+ E382              ;   - Tras RET, ComputeMagicCompassPath pagina bank 0. Stack-2 en bank 0
  18+ E382              ;     tiene la PC return original (pushed por el caller cuando bank 0
  19+ E382              ;     paginated). ✓
  20+ E382              ;
  21+ E382              ; _Inner accede a:
  22+ E382              ;   - Vars en bank 2 / slot 1 (always-visible): LastEntrySide, LastEntryCoord,
  23+ E382              ;     CurrentScreenX/Y, ObjectiveScreenX/Y, MagicCompassPathDir, *PathCoord,
  24+ E382              ;     *BfsState, *BfsHead, *BfsTail.
  25+ E382              ;   - MagicCompassBfsQueue / MagicCompassVisited (printer buffer, $5B00+).
  26+ E382              ;   - RoomCompGapsTable (slot 1) -> DEFW pointers a RoomCompGaps_XX records
  27+ E382              ;     (bank 7). Bank 7 paginated -> los records son legibles directamente.
  28+ E382              ;   - Locales DEFB (.cmcpCurSid etc.) - ahora viven en bank 7 también.
  29+ E382              ;
  30+ E382              ; Sjasmplus scope: `_ComputeMagicCompassPath_Inner` es global; todos los
  31+ E382              ; labels `.cmcpXxx`, `.cfmgXxx`, `.fgbsXxx`, `.cmvXxx`, `.ccvXxx` heredan
  32+ E382              ; ese scope (no se inserta ningun otro global hasta el final del archivo).
  33+ E382              ; ==============================================================================
  34+ E382
  35+ E382              ; ==============================================================================
  36+ E382              ; _ComputeMagicCompassPath_Inner — BFS sin paging (asume bank 7 paginado).
  37+ E382              ; ==============================================================================
  38+ E382              _ComputeMagicCompassPath_Inner:
  39+ E382                  ; ¿BFS in-progress? Si sí, saltar init y reanudar.
  40+ E382 3A CD 5F         LD A, (MagicCompassBfsState)
  41+ E385 B7               OR A
  42+ E386 C2 FD E3         JP NZ, .cmcpResume
  43+ E389
  44+ E389                  ; --- INIT (solo cuando arranca un BFS nuevo) ---
  45+ E389 3A 11 83         LD A, (CurrentScreenY)
  46+ E38C 07               RLCA
  46+ E38D 07             RLCA
  46+ E38E 07             RLCA
  46+ E38F 07             RLCA            ; Y*16
  47+ E390 21 10 83         LD HL, CurrentScreenX
  48+ E393 86               ADD A, (HL)
  49+ E394 32 24 E6         LD (.cmcpCurSid), A
  50+ E397
  51+ E397 3A C0 82         LD A, (ObjectiveScreenX)
  52+ E39A FE FF            CP $FF
  53+ E39C CA F8 E4         JP Z, .cmcpNoPath
  54+ E39F 3A C1 82         LD A, (ObjectiveScreenY)
  55+ E3A2 07               RLCA
  55+ E3A3 07             RLCA
  55+ E3A4 07             RLCA
  55+ E3A5 07             RLCA
