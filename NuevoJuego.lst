   1+ 9DBD              ; ==============================================================================
   2+ 9DBD              ; LOGICA DEL JUEGO - Sistema de entidades estilo Sabre Wulf
   3+ 9DBD              ; ==============================================================================
   4+ 9DBD              ; - Estructura de entidad de 12 bytes (universal)
   5+ 9DBD              ; - Game loop per-entity: erase → update → draw
   6+ 9DBD              ; - Movimiento 8-bit (sin subpixel)
   7+ 9DBD              ; - Animacion por SpriteID (incrementar dentro de rango)
   8+ 9DBD              ; - XOR draw/erase (una sola rutina)
   9+ 9DBD              ; ==============================================================================
  10+ 9DBD
  11+ 9DBD              ; ==============================================================================
  12+ 9DBD              ; ReadInput - Lee teclado + joystick y genera direccion + fuego
  13+ 9DBD              ; ==============================================================================
  14+ 9DBD              ; Universal Control: QAOP + Kempston + Sinclair 1, fusionados en D.
  15+ 9DBD              ; D bits: 0=N, 1=S, 2=E, 3=W.  E bit 0 = Fire.
  16+ 9DBD              ; ==============================================================================
  17+ 9DBD              ReadInput:
  18+ 9DBD 16 00            LD D, 0             ; D = direcciones acumuladas
  19+ 9DBF 1E 00            LD E, 0             ; E = fuego acumulado
  20+ 9DC1
  21+ 9DC1                  ; -- 1. QAOP --
  22+ 9DC1 01 FE FB         LD BC, $FBFE        ; Fila Q-W-E-R-T
  23+ 9DC4 ED 78            IN A, (C)
  24+ 9DC6 CB 47            BIT 0, A            ; Q = Arriba
  25+ 9DC8 20 02            JR NZ, .no_q
  26+ 9DCA CB C2            SET 0, D
  27+ 9DCC              .no_q:
  28+ 9DCC 01 FE FD         LD BC, $FDFE        ; Fila A-S-D-F-G
  29+ 9DCF ED 78            IN A, (C)
  30+ 9DD1 CB 47            BIT 0, A            ; A = Abajo
  31+ 9DD3 20 02            JR NZ, .no_a
  32+ 9DD5 CB CA            SET 1, D
  33+ 9DD7              .no_a:
  34+ 9DD7 01 FE DF         LD BC, $DFFE        ; Fila P-O-I-U-Y
  35+ 9DDA ED 78            IN A, (C)
  36+ 9DDC CB 4F            BIT 1, A            ; O = Izquierda
  37+ 9DDE 20 02            JR NZ, .no_o
  38+ 9DE0 CB DA            SET 3, D
  39+ 9DE2              .no_o:
  40+ 9DE2 CB 47            BIT 0, A            ; P = Derecha (misma lectura de puerto)
  41+ 9DE4 20 02            JR NZ, .no_p
  42+ 9DE6 CB D2            SET 2, D
  43+ 9DE8              .no_p:
  44+ 9DE8
  45+ 9DE8                  ; -- 2. KEMPSTON JOYSTICK (Puerto 31) --
  46+ 9DE8                  ; Kempston: bit 0=Right, 1=Left, 2=Down, 3=Up, 4=Fire
  47+ 9DE8 DB 1F            IN A, (31)
  48+ 9DEA 4F               LD C, A             ; guardar para fire
  49+ 9DEB CB 5F            BIT 3, A            ; Up
  50+ 9DED 28 02            JR Z, .no_k_up
  51+ 9DEF CB C2            SET 0, D
  52+ 9DF1              .no_k_up:
  53+ 9DF1 CB 57            BIT 2, A            ; Down
  54+ 9DF3 28 02            JR Z, .no_k_down
  55+ 9DF5 CB CA            SET 1, D
  56+ 9DF7              .no_k_down:
  57+ 9DF7 CB 4F            BIT 1, A            ; Left
  58+ 9DF9 28 02            JR Z, .no_k_left
  59+ 9DFB CB DA            SET 3, D
  60+ 9DFD              .no_k_left:
  61+ 9DFD CB 47            BIT 0, A            ; Right
  62+ 9DFF 28 02            JR Z, .no_k_right
  63+ 9E01 CB D2            SET 2, D
  64+ 9E03              .no_k_right:
  65+ 9E03 CB 61            BIT 4, C            ; Kempston Fire
  66+ 9E05 28 02            JR Z, .no_k_fire
  67+ 9E07 CB C3            SET 0, E
  68+ 9E09              .no_k_fire:
  69+ 9E09
  70+ 9E09                  ; -- 3. SINCLAIR 1 (Puerto $F7FE, teclas 1-5) --
  71+ 9E09                  ; 1=Left, 2=Right, 3=Down, 4=Up, 5=Fire
  72+ 9E09 01 FE F7         LD BC, $F7FE
  73+ 9E0C ED 78            IN A, (C)
  74+ 9E0E CB 5F            BIT 3, A            ; Tecla 4 = Up
  75+ 9E10 20 02            JR NZ, .no_s1_up
  76+ 9E12 CB C2            SET 0, D
  77+ 9E14              .no_s1_up:
  78+ 9E14 CB 57            BIT 2, A            ; Tecla 3 = Down
  79+ 9E16 20 02            JR NZ, .no_s1_down
  80+ 9E18 CB CA            SET 1, D
  81+ 9E1A              .no_s1_down:
  82+ 9E1A CB 47            BIT 0, A            ; Tecla 1 = Left
  83+ 9E1C 20 02            JR NZ, .no_s1_left
  84+ 9E1E CB DA            SET 3, D
  85+ 9E20              .no_s1_left:
  86+ 9E20 CB 4F            BIT 1, A            ; Tecla 2 = Right
  87+ 9E22 20 02            JR NZ, .no_s1_right
  88+ 9E24 CB D2            SET 2, D
  89+ 9E26              .no_s1_right:
  90+ 9E26 CB 67            BIT 4, A            ; Tecla 5 = Fire
  91+ 9E28 20 02            JR NZ, .no_s1_fire
  92+ 9E2A CB C3            SET 0, E
  93+ 9E2C              .no_s1_fire:
  94+ 9E2C
  95+ 9E2C                  ; -- 4. SPACE = Fire (teclado) --
  96+ 9E2C 01 FE 7F         LD BC, $7FFE        ; Fila SPACE-SS-M-N-B
  97+ 9E2F ED 78            IN A, (C)
  98+ 9E31 CB 47            BIT 0, A            ; SPACE
  99+ 9E33 20 02            JR NZ, .no_space
 100+ 9E35 CB C3            SET 0, E
 101+ 9E37              .no_space:
 102+ 9E37
 103+ 9E37                  ; -- 5. Volcar D → InputDirection, E → InputFire --
 104+ 9E37 7B               LD A, E
 105+ 9E38 32 AF 82         LD (InputFire), A
 106+ 9E3B
 107+ 9E3B                  ; -- Mushroom debuff: si timer != 0, mascara InputFire a 0 + SFX error --
 108+ 9E3B 21 DD 82         LD HL, MushroomLockTimer
 109+ 9E3E 7E               LD A, (HL)
 110+ 9E3F 23               INC HL
 111+ 9E40 B6               OR (HL)
 112+ 9E41 28 21            JR Z, .noMushLock
 113+ 9E43 AF               XOR A
 114+ 9E44 32 AF 82         LD (InputFire), A
 115+ 9E47                  ; Player pulsa fire con seta activa: feedback sonoro de "no puedes".
 116+ 9E47                  ; Debounce con NoSwordSoundFlag: 1 sonido por pulsacion (E=0 => libera).
 117+ 9E47 7B               LD A, E
 118+ 9E48 B7               OR A
 119+ 9E49 28 15            JR Z, .resetNoSwordFlag
 120+ 9E4B 3A B8 82         LD A, (NoSwordSoundFlag)
 121+ 9E4E B7               OR A
 122+ 9E4F 20 13            JR NZ, .noMushLock                   ; ya sono este press, no repetir
 123+ 9E51 3E 01            LD A, 1
 124+ 9E53 32 B8 82         LD (NoSwordSoundFlag), A
 125+ 9E56 D5               PUSH DE                              ; PlaySFX destruye DE; D = direction
 126+ 9E57 21 CF F9         LD HL, SFX_NoSwordError
 127+ 9E5A CD 8D F8         CALL PlaySFX
 128+ 9E5D D1               POP DE
 129+ 9E5E 18 04            JR .noMushLock
 130+ 9E60              .resetNoSwordFlag:
 131+ 9E60 AF               XOR A
 132+ 9E61 32 B8 82         LD (NoSwordSoundFlag), A
 133+ 9E64              .noMushLock:
 134+ 9E64
 135+ 9E64                  ; -- 6. Cancelar opuestos --
 136+ 9E64 7A               LD A, D
 137+ 9E65 47               LD B, A
 138+ 9E66 E6 03            AND DIR_N | DIR_S
 139+ 9E68 FE 03            CP DIR_N | DIR_S
 140+ 9E6A 20 04            JR NZ, .noVC
 141+ 9E6C 78               LD A, B
 142+ 9E6D E6 FC            AND ~(DIR_N | DIR_S) & $FF
 143+ 9E6F 47               LD B, A
 144+ 9E70              .noVC:
 145+ 9E70 78               LD A, B
 146+ 9E71 E6 0C            AND DIR_E | DIR_W
 147+ 9E73 FE 0C            CP DIR_E | DIR_W
 148+ 9E75 20 04            JR NZ, .noHC
 149+ 9E77 78               LD A, B
 150+ 9E78 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 151+ 9E7A 47               LD B, A
 152+ 9E7B              .noHC:
 153+ 9E7B 78               LD A, B
 154+ 9E7C 32 AE 82         LD (InputDirection), A
 155+ 9E7F C9               RET
