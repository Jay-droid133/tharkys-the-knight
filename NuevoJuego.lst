6933+ C5A6 DD 77 07         LD (IX+ENT_DELTAY), A
6934+ C5A9 DD 86 04         ADD A, (IX+ENT_POSY)
6935+ C5AC DD 77 04         LD (IX+ENT_POSY), A
6936+ C5AF              .udgAnim:
6937+ C5AF                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6938+ C5AF                  ; ser despawneada por una de tres condiciones externas:
6939+ C5AF                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6940+ C5AF                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6941+ C5AF                  ;   3. Player cambia de pantalla (screen_system reset)
6942+ C5AF                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6943+ C5AF                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6944+ C5AF                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6945+ C5AF C3 B2 C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6946+ C5B2
6947+ C5B2              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6948+ C5B2              ; Llamada por:
6949+ C5B2              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6950+ C5B2              ;   - UpdateDeath en frame skip (sin movimiento).
6951+ C5B2              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6952+ C5B2              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6953+ C5B2              DeathAnimate:
6954+ C5B2 DD 7E 06         LD A, (IX+ENT_DELTAX)
6955+ C5B5 B7               OR A
6956+ C5B6 28 0A            JR Z, .daKeepDir
6957+ C5B8 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6958+ C5BA CB 7F            BIT 7, A
6959+ C5BC 28 0D            JR Z, .daDir
6960+ C5BE 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6961+ C5C0 18 09            JR .daDir
6962+ C5C2              .daKeepDir:
6963+ C5C2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6964+ C5C5 DD 96 08         SUB (IX+ENT_ANIMBASE)
6965+ C5C8 E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6966+ C5CA 4F               LD C, A
6967+ C5CB              .daDir:
6968+ C5CB DD 35 09         DEC (IX+ENT_ANIMTIMER)
6969+ C5CE 20 16            JR NZ, .daFrameSet
6970+ C5D0 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6971+ C5D4 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6972+ C5D7 47               LD B, A
6973+ C5D8 DD 96 08         SUB (IX+ENT_ANIMBASE)
6974+ C5DB E6 01            AND 1
6975+ C5DD 20 03            JR NZ, .daFrameDec
6976+ C5DF 04               INC B
6977+ C5E0 18 01            JR .daFrameStore
6978+ C5E2              .daFrameDec:
6979+ C5E2 05               DEC B
6980+ C5E3              .daFrameStore:
6981+ C5E3 DD 70 00         LD (IX+ENT_SPRITEID), B
6982+ C5E6              .daFrameSet:
6983+ C5E6 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6984+ C5E9 DD 96 08         SUB (IX+ENT_ANIMBASE)
6985+ C5EC E6 01            AND 1
6986+ C5EE DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6987+ C5F1 81               ADD A, C
6988+ C5F2 DD 77 00         LD (IX+ENT_SPRITEID), A
6989+ C5F5 C9               RET
