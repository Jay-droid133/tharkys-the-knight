1063+ 8DE7              ; UpdateEnemy - AI patrol + bounce (estilo Sabre Wulf)
1064+ 8DE7              ; ==============================================================================
1065+ 8DE7              ; Cada frame: posicion += delta. Si choca con borde o fondo, invierte delta.
1066+ 8DE7              ; Animacion: cicla SpriteID dentro del rango del tipo.
1067+ 8DE7              ; IX = puntero a la entidad enemiga.
1068+ 8DE7              ; ==============================================================================
1069+ 8DE7              UpdateEnemy:
1070+ 8DE7                  ; --- Movimiento horizontal ---
1071+ 8DE7 DD 7E 03         LD A, (IX+ENT_POSX)
1072+ 8DEA 32 93 8E         LD (.savedEX), A
1073+ 8DED 47               LD B, A
1074+ 8DEE DD 7E 06         LD A, (IX+ENT_DELTAX)
1075+ 8DF1 4F               LD C, A
1076+ 8DF2                  ; Test signo para ADD signed
1077+ 8DF2 CB 79            BIT 7, C
1078+ 8DF4 20 0A            JR NZ, .eDeltaXNeg
1079+ 8DF6                  ; Positivo: mover derecha
1080+ 8DF6 78               LD A, B
1081+ 8DF7 81               ADD A, C
1082+ 8DF8 FE E8            CP SCREEN_MAX_X
1083+ 8DFA 38 0B            JR C, .eClampXOk
1084+ 8DFC 3E E7            LD A, SCREEN_MAX_X - 1
1085+ 8DFE 18 15            JR .eReverseX
1086+ 8E00              .eDeltaXNeg:
1087+ 8E00                  ; Negativo: mover izquierda
1088+ 8E00 78               LD A, B
1089+ 8E01 81               ADD A, C                    ; ADD signed (C es negativo)
1090+ 8E02 38 03            JR C, .eClampXOk            ; No underflow → ok
1091+ 8E04 AF               XOR A                       ; Clamp a 0
1092+ 8E05 18 0E            JR .eReverseX
1093+ 8E07              .eClampXOk:
1094+ 8E07 DD 77 03         LD (IX+ENT_POSX), A
1095+ 8E0A                  ; Check colision fondo en X
1096+ 8E0A CD 51 8F         CALL CheckEnemyCollision
1097+ 8E0D 28 0E            JR Z, .eXDone
1098+ 8E0F                  ; Colision → revertir X e invertir delta
1099+ 8E0F 3A 93 8E         LD A, (.savedEX)
1100+ 8E12 DD 77 03         LD (IX+ENT_POSX), A
1101+ 8E15              .eReverseX:
