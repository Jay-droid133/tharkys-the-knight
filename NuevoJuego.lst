 705+ D3EA              ; ==============================================================================
 706+ D3EA              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 707+ D3EA              ; ==============================================================================
 708+ D3EA              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 709+ D3EA              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 710+ D3EA              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 711+ D3EA              ; ==============================================================================
 712+ D3EA              DrawBgGfxSprite:
 713+ D3EA DD 7E 00         LD A, (IX+0)                ; height_px
 714+ D3ED B7               OR A
