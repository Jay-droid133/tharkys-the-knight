 956+ EF43
 957+ EF43              ; ==============================================================================
 958+ EF43              ; Variantes random de health/stamina pickup
 959+ EF43              ; ==============================================================================
 960+ EF43              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
 961+ EF43              ; eligen una variante visual al azar. Asi el random pickup tiene mas
 962+ EF43              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
 963+ EF43              ; variante — solo cambia el sprite que se ve.
 964+ EF43              ;
 965+ EF43              ; Formato tabla: DEFB count, ids... (1 byte por id)
 966+ EF43              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
 967+ EF43              ; ==============================================================================
 968+ EF43              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
 969+ EF43              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
 970+ EF43              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
 971+ EF43              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
 972+ EF43              ; raw, asi que usamos esos labels directamente.
 973+ EF43              HealthVariantPtrs:
 974+ EF43 04               DEFB 4                              ; 4 variantes (1 byte count)
 975+ EF44 B6 F5            DEFW BgGfx_health_pickup            ; canonical (id 254 injected raw)
 976+ EF46 DF F5            DEFW BgGfx_health_pickup_72         ; variant id 72
 977+ EF48 08 F6            DEFW BgGfx_health_pickup_3          ; variant id 74 ("health pickup 3")
 978+ EF4A 31 F6            DEFW BgGfx_health_pickup_4          ; variant id 75 ("health pickup 4")
 979+ EF4C
 980+ EF4C              StaminaVariantPtrs:
 981+ EF4C 02               DEFB 2                              ; 2 variantes
 982+ EF4D 72 EA            DEFW BgGfx_stamina_pickup           ; canonical (id 255)
 983+ EF4F 5A F6            DEFW BgGfx_stamina_pickup_2         ; variant id 73
 984+ EF51
 985+ EF51              ; ==============================================================================
 986+ EF51              ; PickRandomVariantPtr / LookupVariantPtrByIdx
 987+ EF51              ; ==============================================================================
 988+ EF51              ; PickRandomVariantPtr: elige variante random Y la persiste en RP_TmpVariant.
 989+ EF51              ;   IN:  HL = ptr a tabla "DEFB count, DEFW ptr1, DEFW ptr2, ..."
 990+ EF51              ;   OUT: HL = sprite ptr de la variante elegida.
 991+ EF51              ;   Side: RP_TmpVariant ← idx elegido (0..count-1), para que la cache pueda
 992+ EF51              ;         rotarlo y reusarlo al revisitar la sala.
 993+ EF51              ;
 994+ EF51              ; LookupVariantPtrByIdx: lookup directo SIN random (para cache hit que ya tiene
 995+ EF51              ;                       el idx que quiere reusar).
 996+ EF51              ;   IN:  HL = ptr a tabla, A = idx (0..count-1)
 997+ EF51              ;   OUT: HL = sprite ptr de la variante[idx].
 998+ EF51              ;   Side: ninguno (NO toca RP_TmpVariant — el caller lo gestiona).
 999+ EF51              ;
1000+ EF51              ; Destruye: AF, BC, DE (ambas rutinas).
1001+ EF51              ; ==============================================================================
1002+ EF51              PickRandomVariantPtr:
1003+ EF51 7E               LD A, (HL)                          ; A = count
1004+ EF52 47               LD B, A
1005+ EF53 ED 5F            LD A, R
1006+ EF55              .pvpModLoop:
1007+ EF55 90               SUB B
1008+ EF56 30 FD            JR NC, .pvpModLoop
1009+ EF58 80               ADD A, B                            ; A = R mod count (0..count-1)
1010+ EF59 32 D8 5F         LD (RP_TmpVariant), A               ; persistir para cache rotation
1011+ EF5C                  ; fall through a LookupVariantPtrByIdx (HL aun apunta al count byte, A = idx)
1012+ EF5C              LookupVariantPtrByIdx:
1013+ EF5C 23               INC HL                              ; HL @ first DEFW
1014+ EF5D 87               ADD A, A                            ; idx*2 (DEFW = 2 B)
1015+ EF5E 5F               LD E, A
1016+ EF5F 16 00            LD D, 0
1017+ EF61 19               ADD HL, DE                          ; HL @ entry elegida
1018+ EF62 7E               LD A, (HL)
1019+ EF63 23               INC HL
1020+ EF64 66               LD H, (HL)
1021+ EF65 6F               LD L, A                             ; HL = sprite ptr
1022+ EF66 C9               RET
1023+ EF67
