 531+ E6E7              ; ==============================================================================
 532+ E6E7              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 533+ E6E7              ; Usa font custom (DayHudFont) en vez de ROM font
 534+ E6E7              ; ==============================================================================
 535+ E6E7              DrawDayCycleHUD:
 536+ E6E7                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 537+ E6E7 21 A5 E9         LD HL, DayHudFont + 0 * 8          ; 'D'
 538+ E6EA 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 539+ E6ED CD 5C E7         CALL .drawChar
 540+ E6F0 21 AD E9         LD HL, DayHudFont + 1 * 8          ; 'A'
 541+ E6F3 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 542+ E6F6 CD 5C E7         CALL .drawChar
 543+ E6F9 21 B5 E9         LD HL, DayHudFont + 2 * 8          ; 'Y'
 544+ E6FC 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 545+ E6FF CD 5C E7         CALL .drawChar
 546+ E702                  ; Col 7 = espacio (limpiar)
 547+ E702 11 07 40         LD DE, $4007
 548+ E705 CD 65 E7         CALL .clearChar
 549+ E708
 550+ E708                  ; --- Digito decenas (col 8) ---
 551+ E708 3A 6F C0         LD A, (DayCycleCount)
 552+ E70B FE 0A            CP 10
 553+ E70D 38 20            JR C, .singleDigit
 554+ E70F                  ; Dos digitos: dividir A / 10
 555+ E70F 06 00            LD B, 0
 556+ E711              .divLoop:
 557+ E711 D6 0A            SUB 10
 558+ E713 04               INC B
 559+ E714 FE 0A            CP 10
 560+ E716 30 F9            JR NC, .divLoop
 561+ E718                  ; B = decenas, A = unidades
 562+ E718 F5               PUSH AF                             ; Guardar unidades
 563+ E719 78               LD A, B
 564+ E71A CD 4F E7         CALL .getDigitFont
 565+ E71D 11 08 40         LD DE, $4008                        ; Col 8
 566+ E720 CD 5C E7         CALL .drawChar
 567+ E723 F1               POP AF                              ; Recuperar unidades
 568+ E724 CD 4F E7         CALL .getDigitFont
 569+ E727 11 09 40         LD DE, $4009                        ; Col 9
 570+ E72A CD 5C E7         CALL .drawChar
 571+ E72D 18 14            JR .setAttrs
 572+ E72F
 573+ E72F              .singleDigit:
 574+ E72F                  ; Una cifra: decena = 0, unidad = A
 575+ E72F F5               PUSH AF
 576+ E730 21 BD E9         LD HL, DayHudFont + 3 * 8          ; '0'
 577+ E733 11 08 40         LD DE, $4008                        ; Col 8
 578+ E736 CD 5C E7         CALL .drawChar
 579+ E739 F1               POP AF
 580+ E73A CD 4F E7         CALL .getDigitFont
 581+ E73D 11 09 40         LD DE, $4009                        ; Col 9
 582+ E740 CD 5C E7         CALL .drawChar
 583+ E743
 584+ E743              .setAttrs:
 585+ E743                  ; Atributos: bright white en cols 4-9
 586+ E743 3E 47            LD A, $47
 587+ E745 21 04 58         LD HL, ATTR_BASE + 4
 588+ E748 06 06            LD B, 6
 589+ E74A              .attrLoop:
 590+ E74A 77               LD (HL), A
 591+ E74B 23               INC HL
 592+ E74C 10 FC            DJNZ .attrLoop
 593+ E74E C9               RET
 594+ E74F
 595+ E74F              ; Devuelve HL = puntero a font data del digito en A (0-9)
 596+ E74F              ; A se destruye
 597+ E74F              .getDigitFont:
 598+ E74F C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 599+ E751 6F               LD L, A
 600+ E752 26 00            LD H, 0
 601+ E754 29               ADD HL, HL
 602+ E755 29               ADD HL, HL
 603+ E756 29               ADD HL, HL                          ; HL = indice * 8
 604+ E757 01 A5 E9         LD BC, DayHudFont
 605+ E75A 09               ADD HL, BC
 606+ E75B C9               RET
 607+ E75C
 608+ E75C              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 609+ E75C              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 610+ E75C              .drawChar:
 611+ E75C 06 08            LD B, 8
 612+ E75E              .charLoop:
 613+ E75E 7E               LD A, (HL)
 614+ E75F 12               LD (DE), A
 615+ E760 23               INC HL
 616+ E761 14               INC D
 617+ E762 10 FA            DJNZ .charLoop
 618+ E764 C9               RET
 619+ E765
 620+ E765              ; Limpia 8 scan lines en VRAM (DE)
 621+ E765              .clearChar:
 622+ E765 06 08            LD B, 8
 623+ E767 AF               XOR A
 624+ E768              .clearLoop:
 625+ E768 12               LD (DE), A
 626+ E769 14               INC D
 627+ E76A 10 FC            DJNZ .clearLoop
 628+ E76C C9               RET
 629+ E76D
