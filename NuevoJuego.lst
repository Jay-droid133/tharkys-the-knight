 904+ EE20 3D               DEC A
 905+ EE21 28 2A            JR Z, .urpDoStaminaFromCache        ; ROLLED_STAMINA: reusa variant cacheada
 906+ EE23 3D               DEC A
 907+ EE24 CA 88 EE         JP Z, .urpDoRayo
 908+ EE27 3D               DEC A
 909+ EE28 CA 93 EE         JP Z, .urpDoCaracol
 910+ EE2B 3D               DEC A
 911+ EE2C CA E0 EE         JP Z, .urpDoRoulette
 912+ EE2F 3D               DEC A
 913+ EE30 CA 9E EE         JP Z, .urpDoMushroom
 914+ EE33 3D               DEC A
 915+ EE34 CA A9 EE         JP Z, .urpDoCompass                 ; ROLLED_COMPASS
 916+ EE37 3D               DEC A
 917+ EE38 CA B4 EE         JP Z, .urpDoEspada                  ; ROLLED_ESPADA
 918+ EE3B 3D               DEC A
 919+ EE3C CA BF EE         JP Z, .urpDoEscudo                  ; ROLLED_ESCUDO
