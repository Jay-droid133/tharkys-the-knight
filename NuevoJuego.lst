 127+ F981
 128+ F981              ; Cuentas
 129+ F981              BCS_GROUP1_KNOCKS       EQU 3
 130+ F981              BCS_GROUP2_KNOCKS       EQU 3
 131+ F981              BCS_GROUP3_KNOCKS       EQU 6
 132+ F981              BCS_NO_SWAPS_TOTAL      EQU 8       ; 4 "no" × 2 swaps = 8 transiciones
 133+ F981
 134+ F981              ; SFX "no no" — dos tonos alternos en canal B, tipo "uh-oh" cartoonish.
 135+ F981              ; Period AY = 1.7734 MHz / (16 * freq). Tercera mayor descendente Mi→Do.
 136+ F981              ; AY_PlayBeep recibe HL = period, B = duracion frames.
 137+ F981              BCS_NO_PERIOD_HI        EQU $0150   ; Mi (E4, ~330 Hz) — nota aguda
 138+ F981              BCS_NO_PERIOD_LO        EQU $01A8   ; Do (C4, ~262 Hz) — nota grave
 139+ F981              BCS_NO_DUR_FRAMES       EQU 6       ; ~240ms staccato (gap antes del proximo swap @12f)
 140+ F981
 141+ F981              ; ==============================================================================
 142+ F981              ; Sala + posiciones (placeholders; verificar in-game)
 143+ F981              ; ==============================================================================
 144+ F981              BCS_BANK_ROOM_X         EQU 8       ; sala del banco (norte del ayuntamiento)
 145+ F981              BCS_BANK_ROOM_Y         EQU 8
 146+ F981
 147+ F981              ; Anchor del player durante la cinematica — siempre centrado horizontalmente
 148+ F981              ; con la puerta (chars 15-16, centro X = 128; player 16 px ancho → POSX = 120).
 149+ F981              ;
 150+ F981              ; Y depende de la sub-fase:
 151+ F981              ;   KNOCK   → 1 px de hueco bajo la puerta (door_bottom 63 → POSY 65; px 64 vacio).
 152+ F981              ;   RETREAT → 1 char (8 px) bajo la puerta (POSY 72; px 64-71 vacios).
 153+ F981              BCS_PLAYER_ANCHOR_X     EQU 120
 154+ F981              BCS_PLAYER_ANCHOR_Y     EQU 65      ; KNOCK: 1 px hueco bajo la puerta
 155+ F981              BCS_PLAYER_RETREAT_Y    EQU 72      ; RETREAT: 1 char (8 px) hueco
 156+ F981              BCS_PLAYER_BACKOFF_Y    EQU 80      ; BACKOFF: 2 char (16 px) hueco — reaccion al portazo final
 157+ F981                                                  ; (player baja 1 char extra vs RETREAT al cierre tras "no no")
 158+ F981
 159+ F981              ; Posicion de la puerta del banco — confirmada por el usuario en el editor:
 160+ F981              ; Cell (8,8), char (15, 4). Asumo tamaño 2x2 chars (16x16 px) — mismo
 161+ F981              ; tamaño que el sprite de la mano. Si el sprite real BankDoorOpen es
 162+ F981              ; mas grande (e.g. 3x3 o 4x4), ajustar BCS_DOOR_CHAR_W/H.
 163+ F981              ;
 164+ F981              ; Bank facade en char (12, 0), 64x48 px → (12-19, 0-5). Door en (15, 4)
 165+ F981              ; cae en la mitad inferior central de la facade. Pixel coords con
 166+ F981              ; BG_Y_OFFSET=2: top-left = (15*8, (4+2)*8) = (120, 48).
 167+ F981              BCS_DOOR_CHARX          EQU 15
 168+ F981              BCS_DOOR_CHARY          EQU 4
 169+ F981              BCS_DOOR_CHAR_W         EQU 2       ; ancho en chars (16 px)
 170+ F981              BCS_DOOR_CHAR_H         EQU 2       ; alto en chars (16 px)
 171+ F981
 172+ F981              ; AABB en pixels (derivado de char coords)
 173+ F981              BCS_DOOR_PX_LEFT        EQU 120     ; 15*8
 174+ F981              BCS_DOOR_PX_RIGHT       EQU 135     ; 120 + 16 - 1
 175+ F981              BCS_DOOR_PX_TOP         EQU 48      ; (4+2)*8
 176+ F981              BCS_DOOR_PX_BOTTOM      EQU 63      ; 48 + 16 - 1
 177+ F981              BCS_DOOR_TOLERANCE      EQU 4       ; mismo margen que CheckTownGateTriggerBg
 178+ F981
 179+ F981              ; Posicion de la mano cuando asoma (centrada en el hueco de la puerta)
 180+ F981              BCS_HAND_PX_X           EQU 120     ; mismo X que la puerta (16x16 sprite)
 181+ F981              BCS_HAND_PX_Y           EQU 48      ; mismo Y que la puerta
 182+ F981
 183+ F981              ; Posicion (char) donde se dibuja BankKey al final — placeholder
 184+ F981              ; (suelo justo delante de la puerta)
 185+ F981              BCS_KEY_DROP_CHARX      EQU 15
 186+ F981              BCS_KEY_DROP_CHARY      EQU 7
 187+ F981
 188+ F981              ; Trigger requirements
 189+ F981              BCS_REQUIRED_KEY        EQU 7       ; BankCheck (slot 7 en KeyLockTable, NUEVO)
 190+ F981
 191+ F981              ; ==============================================================================
 192+ F981              ; CheckBankTriggerBg - bump-trigger del banco (BG sprite, no en PickupTable)
 193+ F981              ; ==============================================================================
 194+ F981              ; Llamada cada frame desde MainLoop tras CheckBumpTriggers (gemelo de
 195+ F981              ; CheckTownGateTriggerBg). Mismo test AABB ±BCS_DOOR_TOLERANCE.
 196+ F981              ;
 197+ F981              ; Dispara: BankCutscenePhase==0, CurrentKey==7 (BankCheck), sala (8,8),
 198+ F981              ; player AABB (16x21) overlapea rect de la puerta. HIT → StartBankCutscene
 199+ F981              ; + CheckMilestoneTrigger(4) (avanza M9).
 200+ F981              ; Destruye: AF, BC, DE, HL, IX.
 201+ F981              ; ==============================================================================
 202+ F981              CheckBankTriggerBg:
 203+ F981 3A C9 82         LD A, (BankCutscenePhase)
 204+ F984 B7               OR A
 205+ F985 C0               RET NZ                              ; ya en cutscene
 206+ F986 3A AE 82         LD A, (CurrentKey)
 207+ F989 FE 07            CP BCS_REQUIRED_KEY
 208+ F98B C0               RET NZ                              ; sin cheque
 209+ F98C 3A 08 83         LD A, (CurrentScreenX)
 210+ F98F FE 08            CP BCS_BANK_ROOM_X
 211+ F991 C0               RET NZ
 212+ F992 3A 09 83         LD A, (CurrentScreenY)
 213+ F995 FE 08            CP BCS_BANK_ROOM_Y
 214+ F997 C0               RET NZ
 215+ F998                  ; --- Horizontal AABB ---
 216+ F998 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 217+ F99B 4F               LD C, A                             ; C = player_left
 218+ F99C C6 10            ADD A, 16
 219+ F99E 57               LD D, A                             ; D = player_right
 220+ F99F 3E 78            LD A, BCS_DOOR_PX_LEFT
 221+ F9A1 D6 04            SUB BCS_DOOR_TOLERANCE
 222+ F9A3 30 01            JR NC, .cbtNoUnderL
 223+ F9A5 AF               XOR A
 224+ F9A6              .cbtNoUnderL:
 225+ F9A6 BA               CP D
 226+ F9A7 D0               RET NC
 227+ F9A8 3E 87            LD A, BCS_DOOR_PX_RIGHT
 228+ F9AA C6 04            ADD A, BCS_DOOR_TOLERANCE
 229+ F9AC 30 02            JR NC, .cbtNoOverR
 230+ F9AE 3E FF            LD A, $FF
 231+ F9B0              .cbtNoOverR:
 232+ F9B0 B9               CP C
 233+ F9B1 D8               RET C
 234+ F9B2                  ; --- Vertical AABB (player rect 16x21) ---
 235+ F9B2 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 236+ F9B5 4F               LD C, A
 237+ F9B6 C6 15            ADD A, 21
 238+ F9B8 57               LD D, A
 239+ F9B9 3E 30            LD A, BCS_DOOR_PX_TOP
 240+ F9BB D6 04            SUB BCS_DOOR_TOLERANCE
 241+ F9BD 30 01            JR NC, .cbtNoUnderT
 242+ F9BF AF               XOR A
 243+ F9C0              .cbtNoUnderT:
 244+ F9C0 BA               CP D
 245+ F9C1 D0               RET NC
 246+ F9C2 3E 3F            LD A, BCS_DOOR_PX_BOTTOM
 247+ F9C4 C6 04            ADD A, BCS_DOOR_TOLERANCE
 248+ F9C6 30 02            JR NC, .cbtNoOverB
 249+ F9C8 3E FF            LD A, $FF
 250+ F9CA              .cbtNoOverB:
 251+ F9CA B9               CP C
 252+ F9CB D8               RET C
 253+ F9CC                  ; HIT
 254+ F9CC CD D4 F9         CALL StartBankCutscene
 255+ F9CF 3E 04            LD A, 4                             ; action 4 = BankDoor
 256+ F9D1 C3 D1 EE         JP CheckMilestoneTrigger            ; tail call
 257+ F9D4
 258+ F9D4              ; ==============================================================================
 259+ F9D4              ; StartBankCutscene - llamada desde el handler del bump-trigger action 4
 260+ F9D4              ; ==============================================================================
 261+ F9D4              ; 1. NO consume cheque aqui — se consume despues, en la transicion
 262+ F9D4              ;    HAND_OPEN_IN -> HAND_OPEN_TAKE (la mano abierta "coge" el cheque
 263+ F9D4              ;    visualmente). El bloqueo del re-trigger lo da el check de phase != 0
 264+ F9D4              ;    en CheckBankTriggerBg.
 265+ F9D4              ; 2. Snap player a anchor frente a la puerta, facing N.
 266+ F9D4              ; 3. Entra en BCP_LOCK con timer = BCS_T_LOCK.
 267+ F9D4              ; 4. KillAllActiveNasties + KillDeathIfActive (mismo paradigma town_gate)
 268+ F9D4              ;    para limpiar la pantalla durante la cutscene.
 269+ F9D4              ; Destruye: AF, BC, DE, HL, IX.
 270+ F9D4              ; ==============================================================================
 271+ F9D4              StartBankCutscene:
 272+ F9D4 AF               XOR A
 273+ F9D5 32 CC 82         LD (BankCutsceneKnockIdx), A
 274+ F9D8 32 CB 82         LD (BankCutsceneSubState), A
 275+ F9DB 32 CD 82         LD (BankCutsceneNoIdx), A
 276+ F9DE 32 CE 82         LD (BankCutsceneHandFrame), A
 277+ F9E1                  ; Resetea el color del player al default (WHITE | $40 = $47). Si el player
 278+ F9E1                  ; tenia color de un buff (speed, mushroom...) o de un hit (BLUE flash), se
 279+ F9E1                  ; pierde aqui. Sino el player aparece tintado durante toda la cinematica.
 280+ F9E1 3E 47            LD A, WHITE | $40
 281+ F9E3 32 A0 81         LD (EntityTable + ENT_ATTR), A
 282+ F9E6 CD 2D BA         CALL KillAllActiveNasties           ; nasties → STATE_DYING + puff anim
 283+ F9E9 CD E5 62         CALL KillDeathIfActive               ; muerte (slot 11) → puff y despawn
 284+ F9EC                  ; El snap a DOOR se hace al entrar a LOCK (post WAIT_NASTIES). El player
 285+ F9EC                  ; se queda en su pos original (de bump) durante WAIT_NASTIES — solo
 286+ F9EC                  ; cambiamos el sprite a facing N para preparar.
 287+ F9EC CD 6F FA         CALL BankCutsceneFacingNRedraw
 288+ F9EF CD 00 FE         CALL SFX_Bank_OnStart
 289+ F9F2                  ; Entrar en WAIT_NASTIES: MainLoop ramifica para mantener
 290+ F9F2                  ; ProcessEnemies + ProcessDeath corriendo (animan puffs). Cuando
 291+ F9F2                  ; todos los slots TYPE_NONE → transicion a LOCK + arranca la cutscene.
 292+ F9F2 3E 64            LD A, BCS_T_PUFF_WAIT
 293+ F9F4 32 CA 82         LD (BankCutsceneTimer), A
 294+ F9F7 3E 11            LD A, BCP_WAIT_NASTIES
 295+ F9F9 32 C9 82         LD (BankCutscenePhase), A
 296+ F9FC C9               RET
 297+ F9FD
 298+ F9FD              ; ==============================================================================
 299+ F9FD              ; BankCutsceneSnapToDoor - teleport player a anchor KNOCK (centrado + 1 px hueco)
 300+ F9FD              ; ==============================================================================
 301+ F9FD              ; Llamado al entrar a cada grupo de toques (KNOCKS_1, _2, _3) y al iniciar
 302+ F9FD              ; LOCK. ANCHOR_X = 120 (centrado con puerta, door span 120-135 → centro 128).
 303+ F9FD              ; ANCHOR_Y = 65 (door bottom 63, hueco en px 64, top del player en 65).
 304+ F9FD              BankCutsceneSnapToDoor:
 305+ F9FD DD 21 9B 81      LD IX, EntityTable
 306+ FA01 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 307+ FA05 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 308+ FA09 DD 36 04 41      LD (IX+ENT_POSY), BCS_PLAYER_ANCHOR_Y
 309+ FA0D 3E 41            LD A, BCS_PLAYER_ANCHOR_Y
 310+ FA0F 32 DC 82         LD (PlayerDrawY), A
 311+ FA12 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static facing N
 312+ FA14 DD 77 00         LD (IX+ENT_SPRITEID), A
 313+ FA17 3E 0A            LD A, SPRID_WALK_N
 314+ FA19 DD 77 08         LD (IX+ENT_ANIMBASE), A
 315+ FA1C AF               XOR A
 316+ FA1D DD 77 09         LD (IX+ENT_ANIMTIMER), A
 317+ FA20 C3 9E 65         JP TownGateRedrawPlayer
 318+ FA23
 319+ FA23              ; ==============================================================================
 320+ FA23              ; BankCutsceneSnapToRetreat - teleport player a anchor RETREAT (centrado + 1 char hueco)
 321+ FA23              ; ==============================================================================
 322+ FA23              ; Llamado al SALIR de cada grupo de toques (KNOCKS_1 → WAIT_1, _2 → WAIT_2).
 323+ FA23              ; Mismo X que KNOCK (centrado con la puerta) pero 1 char (8 px) por debajo:
 324+ FA23              ; door bottom 63, 8 px de hueco (px 64-71), top del player en 72.
 325+ FA23              BankCutsceneSnapToRetreat:
 326+ FA23 DD 21 9B 81      LD IX, EntityTable
 327+ FA27 DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 328+ FA2B DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 329+ FA2F DD 36 04 48      LD (IX+ENT_POSY), BCS_PLAYER_RETREAT_Y
 330+ FA33 3E 48            LD A, BCS_PLAYER_RETREAT_Y
 331+ FA35 32 DC 82         LD (PlayerDrawY), A
 332+ FA38 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 333+ FA3A DD 77 00         LD (IX+ENT_SPRITEID), A
 334+ FA3D 3E 0A            LD A, SPRID_WALK_N
 335+ FA3F DD 77 08         LD (IX+ENT_ANIMBASE), A
 336+ FA42 AF               XOR A
 337+ FA43 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 338+ FA46 C3 9E 65         JP TownGateRedrawPlayer
 339+ FA49
 340+ FA49              ; ==============================================================================
 341+ FA49              ; BankCutsceneSnapToBackOff - teleport player a anchor BACKOFF (centrado + 2 char hueco)
 342+ FA49              ; ==============================================================================
 343+ FA49              ; Llamado al cerrarse la puerta tras el "no no" (.bcPhHandOut). El player baja
 344+ FA49              ; 1 char extra respecto a RETREAT como reaccion al portazo final.
 345+ FA49              ; Mismo X que los demas anchors (centrado con la puerta), Y=80 (door bottom 63,
 346+ FA49              ; 16 px de hueco, top del player en 80). Sigue facing N.
 347+ FA49              BankCutsceneSnapToBackOff:
 348+ FA49 DD 21 9B 81      LD IX, EntityTable
 349+ FA4D DD 36 03 78      LD (IX+ENT_POSX), BCS_PLAYER_ANCHOR_X
 350+ FA51 DD 36 0F 78      LD (IX+ENT_DRAWX), BCS_PLAYER_ANCHOR_X
 351+ FA55 DD 36 04 50      LD (IX+ENT_POSY), BCS_PLAYER_BACKOFF_Y
 352+ FA59 3E 50            LD A, BCS_PLAYER_BACKOFF_Y
 353+ FA5B 32 DC 82         LD (PlayerDrawY), A
 354+ FA5E 3E 0B            LD A, SPRID_WALK_N + 1              ; sigue facing N
 355+ FA60 DD 77 00         LD (IX+ENT_SPRITEID), A
 356+ FA63 3E 0A            LD A, SPRID_WALK_N
 357+ FA65 DD 77 08         LD (IX+ENT_ANIMBASE), A
 358+ FA68 AF               XOR A
 359+ FA69 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 360+ FA6C C3 9E 65         JP TownGateRedrawPlayer
 361+ FA6F
 362+ FA6F              ; ==============================================================================
 363+ FA6F              ; BankCutsceneFacingNRedraw - cambia sprite a facing N en posicion actual
 364+ FA6F              ; ==============================================================================
 365+ FA6F              ; Sin teleport — solo set sprite + redraw. Llamado en StartBankCutscene
 366+ FA6F              ; para asegurar que el player mira a la puerta antes del primer snap.
 367+ FA6F              BankCutsceneFacingNRedraw:
 368+ FA6F DD 21 9B 81      LD IX, EntityTable
 369+ FA73 DD 7E 04         LD A, (IX+ENT_POSY)
 370+ FA76 32 DC 82         LD (PlayerDrawY), A                 ; sync DrawY = POSY actual
 371+ FA79 3E 0B            LD A, SPRID_WALK_N + 1
 372+ FA7B DD 77 00         LD (IX+ENT_SPRITEID), A
 373+ FA7E 3E 0A            LD A, SPRID_WALK_N
 374+ FA80 DD 77 08         LD (IX+ENT_ANIMBASE), A
 375+ FA83 AF               XOR A
 376+ FA84 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 377+ FA87 C3 9E 65         JP TownGateRedrawPlayer
 378+ FA8A
 379+ FA8A              ; ==============================================================================
 380+ FA8A              ; UpdateBankCutscene - llamada cada frame desde MainLoop si phase != 0
 381+ FA8A              ; ==============================================================================
 382+ FA8A              ; Dispatch por BankCutscenePhase. Cada fase: trabajo de tick, decremento
 383+ FA8A              ; timer, transicion a la siguiente. Imitando town_gate sin nasty wait pre-LOCK
 384+ FA8A              ; porque aqui asumimos que en sala (8,8) no hay nasties que esperar (lo
 385+ FA8A              ; resuelve KillAllActiveNasties de StartBankCutscene).
 386+ FA8A              ; Destruye: AF, BC, DE, HL, IX.
 387+ FA8A              ; ==============================================================================
 388+ FA8A              UpdateBankCutscene:
 389+ FA8A 3A C9 82         LD A, (BankCutscenePhase)
 390+ FA8D FE 11            CP BCP_WAIT_NASTIES                 ; pre-LOCK (ramificado en MainLoop)
 391+ FA8F CA E2 FA         JP Z, .bcPhWaitNasties
 392+ FA92 FE 12            CP BCP_DOOR_CLOSED                  ; post-hand pause con puerta cerrada
 393+ FA94 CA EC FC         JP Z, .bcPhDoorClosed
 394+ FA97 FE 13            CP BCP_HAND_OPEN_IN                 ; mano abierta visible -> al expirar:
 395+ FA99                                                      ;   clink + consume cheque + erase mano + cierra puerta
 396+ FA99 CA 13 FC         JP Z, .bcPhHandOpenIn
 397+ FA9C FE 15            CP BCP_HAND_OPEN_OUT                ; puerta cerrada -> reabre + dibuja "no no"
 398+ FA9E CA 72 FC         JP Z, .bcPhHandOpenOut
 399+ FAA1 3D               DEC A
 400+ FAA2 CA FC FA         JP Z, .bcPhLock
 401+ FAA5 3D               DEC A
 402+ FAA6 CA 1A FB         JP Z, .bcPhKnocks1
 403+ FAA9 3D               DEC A
 404+ FAAA CA 2F FB         JP Z, .bcPhWait1
 405+ FAAD 3D               DEC A
 406+ FAAE CA 50 FB         JP Z, .bcPhKnocks2
 407+ FAB1 3D               DEC A
 408+ FAB2 CA 65 FB         JP Z, .bcPhWait2
 409+ FAB5 3D               DEC A
 410+ FAB6 CA 87 FB         JP Z, .bcPhTurnToCam
 411+ FAB9 3D               DEC A
 412+ FABA CA AB FB         JP Z, .bcPhTurnToDoor
 413+ FABD 3D               DEC A
 414+ FABE CA CD FB         JP Z, .bcPhKnocks3
 415+ FAC1 3D               DEC A
 416+ FAC2 CA E2 FB         JP Z, .bcPhWait3
 417+ FAC5 3D               DEC A
 418+ FAC6 CA F4 FB         JP Z, .bcPhPreHand
 419+ FAC9 3D               DEC A
 420+ FACA CA 91 FC         JP Z, .bcPhHandIn
 421+ FACD 3D               DEC A
 422+ FACE CA A0 FC         JP Z, .bcPhHandNoNo
 423+ FAD1 3D               DEC A
 424+ FAD2 CA D1 FC         JP Z, .bcPhHandOut
 425+ FAD5 3D               DEC A
 426+ FAD6 CA 0C FD         JP Z, .bcPhKeyDrop
 427+ FAD9 3D               DEC A
 428+ FADA CA 31 FD         JP Z, .bcPhPlayerTurnCam
 429+ FADD                  ; BCP_DONE: setear phase=IDLE y devolver control. La cutscene termina.
 430+ FADD AF               XOR A
 431+ FADE 32 C9 82         LD (BankCutscenePhase), A
 432+ FAE1 C9               RET
 433+ FAE2
 434+ FAE2              ; ---- Phase 17: WAIT_NASTIES ----
 435+ FAE2              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 436+ FAE2              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 437+ FAE2              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 438+ FAE2              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 439+ FAE2              ;
 440+ FAE2              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 441+ FAE2              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 442+ FAE2              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 443+ FAE2              .bcPhWaitNasties:
 444+ FAE2 CD 2D BA         CALL KillAllActiveNasties           ; cazar spawnings recien terminados
 445+ FAE5 CD E7 65         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 446+ FAE8 28 04            JR Z, .bcWaitNastiesDone
 447+ FAEA CD F7 FD         CALL BankCutsceneDecTimer           ; safety timeout
 448+ FAED C0               RET NZ
 449+ FAEE              .bcWaitNastiesDone:
 450+ FAEE CD FD F9         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 451+ FAF1 3E 1E            LD A, BCS_T_LOCK
 452+ FAF3 32 CA 82         LD (BankCutsceneTimer), A
 453+ FAF6 3E 01            LD A, BCP_LOCK
 454+ FAF8 32 C9 82         LD (BankCutscenePhase), A
 455+ FAFB C9               RET
 456+ FAFC
 457+ FAFC              ; ---- Phase 1: lock + facing UP ----
 458+ FAFC              .bcPhLock:
 459+ FAFC CD F7 FD         CALL BankCutsceneDecTimer
 460+ FAFF C0               RET NZ
 461+ FB00                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 462+ FB00 AF               XOR A
 463+ FB01 32 CC 82         LD (BankCutsceneKnockIdx), A
 464+ FB04 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 465+ FB07 3E 00            LD A, BCS_KNOCK_HIT
 466+ FB09 32 CB 82         LD (BankCutsceneSubState), A
 467+ FB0C 3E 04            LD A, BCS_T_KNOCK_HIT
 468+ FB0E 32 CA 82         LD (BankCutsceneTimer), A
 469+ FB11 CD 76 FD         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 470+ FB14 3E 02            LD A, BCP_KNOCKS_1
 471+ FB16 32 C9 82         LD (BankCutscenePhase), A
 472+ FB19 C9               RET
 473+ FB1A
 474+ FB1A              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 475+ FB1A              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 476+ FB1A              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 477+ FB1A              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 478+ FB1A              .bcPhKnocks1:
 479+ FB1A 3E 03            LD A, BCS_GROUP1_KNOCKS
 480+ FB1C CD 3B FD         CALL BankCutsceneTickKnockGroup
 481+ FB1F B7               OR A
 482+ FB20 C8               RET Z                               ; sigue
 483+ FB21                  ; grupo 1 terminado → retirarse a ORIG + wait
 484+ FB21 CD 23 FA         CALL BankCutsceneSnapToRetreat
 485+ FB24 3E 32            LD A, BCS_T_GROUP_WAIT
 486+ FB26 32 CA 82         LD (BankCutsceneTimer), A
 487+ FB29 3E 03            LD A, BCP_WAIT_1
 488+ FB2B 32 C9 82         LD (BankCutscenePhase), A
 489+ FB2E C9               RET
 490+ FB2F
 491+ FB2F              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 492+ FB2F              .bcPhWait1:
 493+ FB2F CD F7 FD         CALL BankCutsceneDecTimer
 494+ FB32 C0               RET NZ
 495+ FB33                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 496+ FB33 CD FD F9         CALL BankCutsceneSnapToDoor
 497+ FB36 AF               XOR A
 498+ FB37 32 CC 82         LD (BankCutsceneKnockIdx), A
 499+ FB3A 32 CF 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 500+ FB3D 3E 00            LD A, BCS_KNOCK_HIT
 501+ FB3F 32 CB 82         LD (BankCutsceneSubState), A
 502+ FB42 3E 04            LD A, BCS_T_KNOCK_HIT
 503+ FB44 32 CA 82         LD (BankCutsceneTimer), A
 504+ FB47 CD 76 FD         CALL BankCutsceneEmitKnockHit
 505+ FB4A 3E 04            LD A, BCP_KNOCKS_2
 506+ FB4C 32 C9 82         LD (BankCutscenePhase), A
 507+ FB4F C9               RET
 508+ FB50
 509+ FB50              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 510+ FB50              .bcPhKnocks2:
 511+ FB50 3E 03            LD A, BCS_GROUP2_KNOCKS
 512+ FB52 CD 3B FD         CALL BankCutsceneTickKnockGroup
 513+ FB55 B7               OR A
 514+ FB56 C8               RET Z
 515+ FB57                  ; grupo 2 terminado → retirarse a ORIG + wait
 516+ FB57 CD 23 FA         CALL BankCutsceneSnapToRetreat
 517+ FB5A 3E 32            LD A, BCS_T_GROUP_WAIT
 518+ FB5C 32 CA 82         LD (BankCutsceneTimer), A
 519+ FB5F 3E 05            LD A, BCP_WAIT_2
 520+ FB61 32 C9 82         LD (BankCutscenePhase), A
 521+ FB64 C9               RET
 522+ FB65
 523+ FB65              ; ---- Phase 5: WAIT_2 ----
 524+ FB65              .bcPhWait2:
 525+ FB65 CD F7 FD         CALL BankCutsceneDecTimer
 526+ FB68 C0               RET NZ
 527+ FB69                  ; Player gira a S (cara camara).
 528+ FB69 DD 21 9B 81      LD IX, EntityTable
