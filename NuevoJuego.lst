  18  8000              Inicio:
  19  8000 F3               DI                      ; Deshabilitar interrupciones
  20  8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  21  8004
  22  8004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  23  8004 CD B5 90         CALL InitPaging
  24  8007 CD EC FA         CALL AY_Init                ; silenciar AY al arrancar
  25  800A
  26  800A                  ; Configuración inicial (Borde negro, etc.)
  27  800A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  28  800C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  29  800E 32 90 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  30  8011
  31  8011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  32  8011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  33  8011 21 00 40         LD HL, SCREEN_BASE
  34  8014 11 01 40         LD DE, SCREEN_BASE + 1
  35  8017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  36  801A AF               XOR A                   ; A = 0
  37  801B 77               LD (HL), A
  38  801C ED B0            LDIR
  39  801E
  40  801E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  41  801E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  42  801E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  43  801E 21 00 5D         LD HL, LOW_RAM_BASE
  44  8021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  45  8024 01 A9 02         LD BC, LOW_RAM_SIZE - 1
  46  8027 AF               XOR A
  47  8028 77               LD (HL), A
  48  8029 ED B0            LDIR
  49  802B
  50  802B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  51  802B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  52  802B 3E FF            LD A, $FF
  53  802D 32 8E 5F         LD (MonsterLastSeenRoom), A
  54  8030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  55  8033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  56  8036
  57  8036                  ; Inicializar sistema de pantallas
  58  8036 CD 22 C9         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  59  8039 CD B4 A1         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  60  803C CD 66 DD         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  61  803F CD 09 BD         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  62  8042 CD 78 E9         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  63  8045                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  64  8045
  65  8045 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
  66  8047 FB               EI                      ; Habilitar interrupciones
  67  8048 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
  68  804A 32 13 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
  69  804D
  70  804D              ; ==============================================================================
  71  804D              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
  72  804D              ; ==============================================================================
  73  804D              ; El original NO separa render de logica. Cada entidad hace todo junto:
  74  804D              ;   erase viejo → AI/movimiento → draw nuevo
  75  804D              ; Player: siempre se procesa completo cada frame (tras HALT).
  76  804D              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
  77  804D              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
  78  804D              ; ==============================================================================
  79  804D              MainLoop:
  80  804D                  ; --- Marcar inicio de frame (referencia para sync al final) ---
  81  804D 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
  82  8050 32 10 81         LD (.frameStart), A
  83  8053
  84  8053                  ; === PRE-RENDER: gestionar pantalla (NOP en frames normales) ===
  85  8053 CD 66 C9         CALL CheckScreenTransition  ; Detectar cambio de pantalla (~100T normal)
  86  8056 CD 27 CB         CALL DrawScreen             ; Redibujar BG si necesario (~20T normal)
  87  8059 CD 57 CE         CALL RemapScreenAttrs       ; Remap attrs si cambio de fase (~fast)
  88  805C
  89  805C                  ; === CUTSCENE final (M9, puerta sur): si activa, saltar gameplay ===
  90  805C 3A 3C 82         LD A, (TownGatePhase)
  91  805F B7               OR A
  92  8060 C2 A5 80         JP NZ, .townGateCutsceneActive
  93  8063
  94  8063                  ; === CUTSCENE de la iglesia (paso 7): si activa, saltar gameplay ===
  95  8063 3A 3B 82         LD A, (ChurchCutscenePhase)
  96  8066 B7               OR A
  97  8067 C2 A0 80         JP NZ, .cutsceneActive
  98  806A
  99  806A                  ; === PLAYER: siempre cada frame, completo (erase+logic+draw) ===
 100  806A CD 9A B8         CALL EraseDeadSprites       ; Cleanup puff terminadas (~20T normal)
 101  806D CD 1A A1         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
 102  8070 CD 60 A2         CALL ProcessPlayer          ; Erase + logic + draw player (todo junto)
 103  8073 CD 3F AD         CALL CheckWellPickup        ; Recuperar salud/stamina si pisa un pozo
 104  8076 CD 58 D1         CALL CheckPickupCollect     ; Detectar pickups (borrado diferido al siguiente frame)
 105  8079 CD 97 D3         CALL CheckBumpTriggers      ; Sprites trigger por colisión (puerta iglesia/ayuntamiento)
 106  807C CD E9 F3         CALL CheckTownGateTriggerBg ; Cutscene final: arco sur (BG sprite, no en PickupTable)
 107  807F
 108  807F                  ; Limpiar flag de pantalla recien dibujada (tras renderizar player)
 109  807F AF               XOR A
 110  8080 32 5F 82         LD (ScreenJustRedrawn), A
