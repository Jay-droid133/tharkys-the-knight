# file opened: minimap.asm
   1+ FC71              ; ==============================================================================
   2+ FC71              ; MINIMAP - Overlay de mapa 16x16 (tecla I)
   3+ FC71              ; Bank 0
   4+ FC71              ; ==============================================================================
   5+ FC71              ; Dibuja un sprite 8x8 por sala en la capa de pixeles + attrs.
   6+ FC71              ; Las conexiones reales (gaps walkables) se leen de MinimapConnTable (bank 0,
   7+ FC71              ; generada por tools/build_screen_gaps.py).
   8+ FC71              ;
   9+ FC71              ;   Sala valida:  borde azul oscuro, lados abiertos segun conexiones reales
  10+ FC71              ;                   attr: $01 (paper=0 ink=1 no-bright)
  11+ FC71              ;   Jugador:      bloque solido amarillo brillante
  12+ FC71              ;                   attr: $76 (bright paper=6 ink=6)
  13+ FC71              ;   Objetivo:     bloque solido cyan brillante
  14+ FC71              ;                   attr: $6D (bright paper=5 ink=5)
  15+ FC71              ;   Vacio:        negro (attr ya $00, pixeles irrelevantes con paper=ink=0)
  16+ FC71              ;
  17+ FC71              ; Patron de sala (bit 3=N bit 2=S bit 1=W bit 0=E en flags, 1=abierto):
  18+ FC71              ;   fila 0: $FF si N cerrado, $00 si N abierto
  19+ FC71              ;   filas 1-6: bit7=1 si W cerrado, bit0=1 si E cerrado
  20+ FC71              ;   fila 7: $FF si S cerrado, $00 si S abierto
  21+ FC71              ;
  22+ FC71              ; Tecla M: abrir. Tecla M otra vez: cerrar.
  23+ FC71              ; ScreenDirty=1 al cerrar -> repintado completo en el siguiente frame.
  24+ FC71              ;
  25+ FC71              ; INC H avanza scanlines dentro de un char (siempre en el mismo third:
  26+ FC71              ; $40xx/$48xx/$50xx). Las dir. de fila 0 vienen de mmRowTable (16 DEFW).
  27+ FC71              ; ==============================================================================
  28+ FC71
  29+ FC71              MINIMAP_ATTR_BASE   EQU $5888   ; char(8,4): $5800 + 4*32 + 8
  30+ FC71
  31+ FC71              MM_EMPTY    EQU $00
  32+ FC71              MM_ROOM     EQU $01     ; azul oscuro (paper=0 ink=1 no-bright)
  33+ FC71              MM_PLAYER   EQU $76     ; amarillo brillante (paper=6 ink=6 bright)
  34+ FC71              MM_GOAL     EQU $6D     ; cyan brillante    (paper=5 ink=5 bright)
  35+ FC71
  36+ FC71              ; ------------------------------------------------------------------------------
