4857+ BC8B              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4858+ BC8B              ; ==============================================================================
4859+ BC8B              UpdateEnemySpeed:
4860+ BC8B 3A 8D BF         LD A, (DayCycleCount)
4861+ BC8E 3D               DEC A                               ; 0-based index
4862+ BC8F FE 0A            CP 10
4863+ BC91 38 02            JR C, .uesOk
4864+ BC93 3E 09            LD A, 9                             ; Cap en indice 9
4865+ BC95              .uesOk:
4866+ BC95 F5               PUSH AF                             ; Guardar indice para tabla de anim
4867+ BC96 21 B9 BC         LD HL, EnemySpeedTable
4868+ BC99 5F               LD E, A
4869+ BC9A 16 00            LD D, 0
4870+ BC9C 19               ADD HL, DE
4871+ BC9D 7E               LD A, (HL)                          ; A = velocidad × 2
4872+ BC9E                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4873+ BC9E CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4874+ BCA0 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4875+ BCA2                  ; Hay fraccion .5: alternar +1 en frames impares
4876+ BCA2 47               LD B, A                             ; B = parte entera
4877+ BCA3 3A 98 81         LD A, (GameFrameCounter)
4878+ BCA6 E6 01            AND 1                               ; 0 en par, 1 en impar
4879+ BCA8 80               ADD A, B                            ; Sumar 0 o 1
4880+ BCA9              .uesNoFrac:
4881+ BCA9 32 55 90         LD (CurrentEnemySpeed), A
4882+ BCAC                  ; Leer delay de animacion para este ciclo
4883+ BCAC F1               POP AF                              ; A = indice 0-based
4884+ BCAD 21 C3 BC         LD HL, EnemyAnimDelayTable
4885+ BCB0 5F               LD E, A
4886+ BCB1 16 00            LD D, 0
4887+ BCB3 19               ADD HL, DE
4888+ BCB4 7E               LD A, (HL)
4889+ BCB5 32 56 90         LD (CurrentEnemyAnimDelay), A
4890+ BCB8 C9               RET
4891+ BCB9
4892+ BCB9              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4893+ BCB9              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4894+ BCB9              EnemySpeedTable:
4895+ BCB9 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4896+ BCBA 05               DEFB 5                              ; Ciclo 2: 2.5px
4897+ BCBB 06               DEFB 6                              ; Ciclo 3: 3px
4898+ BCBC 07               DEFB 7                              ; Ciclo 4: 3.5px
4899+ BCBD 08               DEFB 8                              ; Ciclo 5: 4px
4900+ BCBE 09               DEFB 9                              ; Ciclo 6: 4.5px
4901+ BCBF 0A               DEFB 10                             ; Ciclo 7: 5px
4902+ BCC0 0B               DEFB 11                             ; Ciclo 8: 5.5px
4903+ BCC1 0C               DEFB 12                             ; Ciclo 9: 6px
4904+ BCC2 0E               DEFB 14                             ; Ciclo 10: 7px
4905+ BCC3
4906+ BCC3              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4907+ BCC3              ; La rata usara la mitad de estos valores
4908+ BCC3              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4909+ BCC3 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4910+ BCC4 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4911+ BCC5 03               DEFB 3                              ; Ciclo 3 (era 6)
4912+ BCC6 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4913+ BCC7 02               DEFB 2                              ; Ciclo 5 (era 4)
4914+ BCC8 02               DEFB 2                              ; Ciclo 6 (era 4)
4915+ BCC9 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4916+ BCCA 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4917+ BCCB 01               DEFB 1                              ; Ciclo 9 (era 2)
4918+ BCCC 01               DEFB 1                              ; Ciclo 10 (era 2)
