2368+ D88B              ; ==============================================================================
2369+ D88B              ; CheckBumpTriggers - cada frame, si player AABB toca un sprite bump-trigger
2370+ D88B              ; ==============================================================================
2371+ D88B              ; en la pantalla actual y tiene la key correcta, dispara la acción.
2372+ D88B              ; Player AABB = 16×16 en (EntityTable[ENT_POSX/POSY]).
2373+ D88B              ; Sprite AABB se extiende +1 pixel en cada lado para detectar "pegado".
2374+ D88B              ; Como los chars del sprite son walls (vía WallAlwaysTable), el player nunca
2375+ D88B              ; se solapa físicamente con él — solo puede estar pegado por algún borde.
2376+ D88B              ; ==============================================================================
2377+ D88B              CheckBumpTriggers:
2378+ D88B 21 A8 DF         LD HL, PickupTable
2379+ D88E              .cbtLoop:
2380+ D88E 7E               LD A, (HL)
2381+ D88F FE FF            CP $FF
2382+ D891 C8               RET Z
2383+ D892 FE FE            CP $FE
2384+ D894 CA F3 D9         JP Z, .cbtSkipInactive
2385+ D897 47               LD B, A                         ; mapX
2386+ D898 23               INC HL
2387+ D899 3A 01 83         LD A, (CurrentScreenX)
2388+ D89C B8               CP B
2389+ D89D C2 EC D9         JP NZ, .cbtSkipMapY
2390+ D8A0 4E               LD C, (HL)                      ; mapY
2391+ D8A1 23               INC HL
2392+ D8A2 3A 02 83         LD A, (CurrentScreenY)
2393+ D8A5 B9               CP C
2394+ D8A6 C2 E5 D9         JP NZ, .cbtSkipPtr
2395+ D8A9                  ; Pantalla actual: leer ptr
2396+ D8A9 E5               PUSH HL                         ; entry en ptr_lo
2397+ D8AA 5E               LD E, (HL)
2398+ D8AB 23               INC HL
2399+ D8AC 56               LD D, (HL)                      ; DE = ptr
2400+ D8AD CD E9 D7         CALL LookupBumpTrigger          ; A = action, C = key
2401+ D8B0 B7               OR A
2402+ D8B1 CA E4 D9         JP Z, .cbtPopNext               ; no es bump-trigger
2403+ D8B4 32 FE D9         LD (.cbtAction), A              ; salvar action (B se reusa abajo)
2404+ D8B7 3A A7 82         LD A, (CurrentKey)
2405+ D8BA B9               CP C
2406+ D8BB C2 E4 D9         JP NZ, .cbtPopNext              ; sin la key correcta
