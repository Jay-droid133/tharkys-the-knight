2350+ AB7E 11 00 58         LD DE, ATTR_BASE
2351+ AB81 19               ADD HL, DE
2352+ AB82 3A 5D 8D         LD A, (WellOrigAttr0)
2353+ AB85 77               LD (HL), A
2354+ AB86 23               INC HL
2355+ AB87 3A 5E 8D         LD A, (WellOrigAttr1)
2356+ AB8A 77               LD (HL), A
2357+ AB8B E1               POP HL
2358+ AB8C                  ; CleanAttrMap
2359+ AB8C 11 55 8A         LD DE, CleanAttrMap
2360+ AB8F 19               ADD HL, DE
2361+ AB90 3A 5D 8D         LD A, (WellOrigAttr0)
2362+ AB93 77               LD (HL), A
2363+ AB94 23               INC HL
2364+ AB95 3A 5E 8D         LD A, (WellOrigAttr1)
2365+ AB98 77               LD (HL), A
2366+ AB99 C9               RET
