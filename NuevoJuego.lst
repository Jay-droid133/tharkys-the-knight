 854+ 6F17 ~            ; ==============================================================================
 855+ 6F17 ~            ; Visited bitmap helpers — 768 bits = 96 bytes (256 sids × 3 comps)
 856+ 6F17 ~            ; ==============================================================================
 857+ 6F17 ~            ; Bit index = sid*3 + comp (0..767). Byte = bit_idx / 8. Bit pos = bit_idx % 8.
 858+ 6F17 ~            ; bit_idx en 16-bit: HL.
 859+ 6F17 ~            ;
 860+ 6F17 ~            ; .cmcpMarkVisited     - IN: A=sid, B=comp. Set bit. Destruye AF, BC, HL.
 861+ 6F17 ~            ; .cmcpCheckVisitedBC  - IN: B=sid, C=comp. OUT: Z=not visited, NZ=visited.
 862+ 6F17 ~            ; ==============================================================================
 863+ 6F17 ~            .cmcpMarkVisited:
 864+ 6F17 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 865+ 6F17 ~                LD H, 0
 866+ 6F17 ~                LD L, A                              ; HL = sid
 867+ 6F17 ~                PUSH HL
 868+ 6F17 ~                ADD HL, HL                           ; HL = sid*2
 869+ 6F17 ~                POP DE
 870+ 6F17 ~                ADD HL, DE                           ; HL = sid*3
 871+ 6F17 ~                LD E, B
 872+ 6F17 ~                LD D, 0
 873+ 6F17 ~                ADD HL, DE                           ; HL = sid*3 + comp
 874+ 6F17 ~                ; bit pos = HL & 7; byte idx = HL >> 3
 875+ 6F17 ~                LD A, L
 876+ 6F17 ~                AND $07
 877+ 6F17 ~                LD C, A                              ; C = bit pos
 878+ 6F17 ~                SRL H
 879+ 6F17 ~                RR L
 880+ 6F17 ~                SRL H
 881+ 6F17 ~                RR L
 882+ 6F17 ~                SRL H
 883+ 6F17 ~                RR L                                 ; HL = HL/8 (byte idx)
 884+ 6F17 ~                LD DE, MagicCompassVisited
 885+ 6F17 ~                ADD HL, DE                           ; HL = byte addr
 886+ 6F17 ~                LD A, 1
 887+ 6F17 ~                INC C
 888+ 6F17 ~            .cmvShift:
 889+ 6F17 ~                DEC C
 890+ 6F17 ~                JR Z, .cmvDone
 891+ 6F17 ~                ADD A, A
 892+ 6F17 ~                JR .cmvShift
 893+ 6F17 ~            .cmvDone:
 894+ 6F17 ~                OR (HL)
 895+ 6F17 ~                LD (HL), A
 896+ 6F17 ~                RET
 897+ 6F17 ~
 898+ 6F17 ~            .cmcpCheckVisitedBC:
 899+ 6F17 ~                ; bit_idx = sid*3 + comp; HL = bit_idx
 900+ 6F17 ~                LD H, 0
 901+ 6F17 ~                LD L, B                              ; HL = sid
 902+ 6F17 ~                PUSH HL
 903+ 6F17 ~                ADD HL, HL
 904+ 6F17 ~                POP DE
 905+ 6F17 ~                ADD HL, DE                           ; HL = sid*3
 906+ 6F17 ~                LD E, C
 907+ 6F17 ~                LD D, 0
 908+ 6F17 ~                ADD HL, DE                           ; HL = sid*3 + comp
 909+ 6F17 ~                LD A, L
 910+ 6F17 ~                AND $07
 911+ 6F17 ~                LD C, A
 912+ 6F17 ~                SRL H
 913+ 6F17 ~                RR L
 914+ 6F17 ~                SRL H
 915+ 6F17 ~                RR L
 916+ 6F17 ~                SRL H
 917+ 6F17 ~                RR L
 918+ 6F17 ~                LD DE, MagicCompassVisited
 919+ 6F17 ~                ADD HL, DE
 920+ 6F17 ~                LD A, 1
 921+ 6F17 ~                INC C
 922+ 6F17 ~            .ccvShift:
 923+ 6F17 ~                DEC C
 924+ 6F17 ~                JR Z, .ccvDone
 925+ 6F17 ~                ADD A, A
 926+ 6F17 ~                JR .ccvShift
 927+ 6F17 ~            .ccvDone:
 928+ 6F17 ~                AND (HL)
 929+ 6F17 ~                RET
