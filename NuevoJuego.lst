 618+ 66A7              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 619+ 66A7              ; ==============================================================================
 620+ 66A7              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 621+ 66A7              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 622+ 66A7              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 623+ 66A7              ;   2. Leer charX/charY de la entry
 624+ 66A7              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 625+ 66A7              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 626+ 66A7              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 627+ 66A7              ;   6. ChurchDoorOpen = 0
 628+ 66A7              ; ==============================================================================
 629+ 66A7              CloseChurchDoor:
 630+ 66A7                  ; SFX "chof" del cierre — distinto del creak (SFX_ChurchDoorOpen) que
 631+ 66A7                  ; usa la misma puerta al ABRIR. ABRIR = creak (madera girando con esfuerzo);
 632+ 66A7                  ; CERRAR = chof (impacto contra el marco). SFX_DoorClose compartido con la
 633+ 66A7                  ; cinematica del banco (HAND_OUT + HAND_OPEN_IN). Suena ANTES del cambio visual.
 634+ 66A7 21 79 FA         LD HL, SFX_DoorClose
