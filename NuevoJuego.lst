 226+ F015              ; ==============================================================================
 227+ F015              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 228+ F015              ; ==============================================================================
 229+ F015              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 230+ F015              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 231+ F015              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 232+ F015              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 233+ F015              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 234+ F015              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 235+ F015              ;               actuales; queda como salvaguarda.
 236+ F015              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 237+ F015              ; Destruye: AF, BC, DE, HL.
 238+ F015              ; ==============================================================================
 239+ F015              ResolveObjectiveScreen:
 240+ F015 3A B9 82         LD A, (CurrentObjective)
 241+ F018 FE 0B            CP 11
 242+ F01A 30 4D            JR NC, .rosNoTarget
 243+ F01C 87               ADD A, A
 244+ F01D 6F               LD L, A
 245+ F01E 26 00            LD H, 0
 246+ F020 11 39 EF         LD DE, MilestoneResolveTable
 247+ F023 19               ADD HL, DE
 248+ F024 7E               LD A, (HL)                          ; tipo
 249+ F025 23               INC HL
 250+ F026 46               LD B, (HL)                          ; B = ref
 251+ F027 FE 01            CP MILESTONE_TYPE_PICKUP
 252+ F029 28 06            JR Z, .rosPickup
 253+ F02B FE 02            CP MILESTONE_TYPE_TRIGGER
 254+ F02D 28 08            JR Z, .rosTrigger
 255+ F02F 18 38            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 256+ F031              .rosPickup:
 257+ F031 78               LD A, B
 258+ F032 CD 72 F0         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 259+ F035 18 10            JR .rosFindPos
 260+ F037              .rosTrigger:
 261+ F037 78               LD A, B
 262+ F038 FE 04            CP 4
 263+ F03A 28 17            JR Z, .rosBankRoom                  ; M9 bank trigger: sin entry en BumpTriggerTable
 264+ F03C FE 03            CP 3
 265+ F03E 28 1E            JR Z, .rosTownGateRoom              ; M11 south door: sin entry en BumpTriggerTable
 266+ F040                                                      ;  (CheckTownGateTriggerBg gestiona aparte).
 267+ F040                                                      ;  Necesario para que la lasting compass tras
 268+ F040                                                      ;  recoger town_gate_key apunte al arco sur.
 269+ F040 CD 7F F0         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 270+ F043 7A               LD A, D
 271+ F044 B3               OR E
 272+ F045 28 22            JR Z, .rosNoTarget
 273+ F047              .rosFindPos:
 274+ F047 CD 9A F0         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 275+ F04A 78               LD A, B
 276+ F04B 32 BA 82         LD (ObjectiveScreenX), A
 277+ F04E 79               LD A, C
 278+ F04F 32 BB 82         LD (ObjectiveScreenY), A
 279+ F052 C9               RET
 280+ F053              .rosBankRoom:
 281+ F053                  ; M9 (post-cheque): apunta al banco. CheckBankTriggerBg dispara la
 282+ F053                  ; cinematica al chocar contra BgGfx_bank_door_closed en sala (8,8).
 283+ F053 3E 08            LD A, BCS_BANK_ROOM_X
 284+ F055 32 BA 82         LD (ObjectiveScreenX), A
 285+ F058 3E 08            LD A, BCS_BANK_ROOM_Y
 286+ F05A 32 BB 82         LD (ObjectiveScreenY), A
 287+ F05D C9               RET
 288+ F05E              .rosTownGateRoom:
 289+ F05E                  ; M11 (post-town_gate_key): apunta al arco sur (sala 7,15).
 290+ F05E                  ; CheckTownGateTriggerBg dispara la cinematica final al chocar.
 291+ F05E                  ; Sin esto, M11 cae en $FF y la lasting compass no se dibuja en el HUD.
 292+ F05E 3E 07            LD A, TGCS_ARCH_ROOM_X
 293+ F060 32 BA 82         LD (ObjectiveScreenX), A
 294+ F063 3E 0F            LD A, TGCS_ARCH_ROOM_Y
 295+ F065 32 BB 82         LD (ObjectiveScreenY), A
 296+ F068 C9               RET
 297+ F069              .rosNoTarget:
 298+ F069 3E FF            LD A, $FF
 299+ F06B 32 BA 82         LD (ObjectiveScreenX), A
 300+ F06E 32 BB 82         LD (ObjectiveScreenY), A
 301+ F071 C9               RET
