 192+ 6B27              ; ==============================================================================
 193+ 6B27              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 6B27              ; ==============================================================================
 195+ 6B27              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 6B27              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 6B27              ; ==============================================================================
 198+ 6B27              _AY_WriteRegPairs:
 199+ 6B27 7E               LD A, (HL)
 200+ 6B28 FE FF            CP $FF
 201+ 6B2A 28 0D            JR Z, .awrpDone
 202+ 6B2C 06 FF            LD B, $FF
 203+ 6B2E ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 6B30 23               INC HL
 205+ 6B31 06 BF            LD B, $BF
 206+ 6B33 7E               LD A, (HL)
 207+ 6B34 ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 6B36 23               INC HL
 209+ 6B37 18 EE            JR _AY_WriteRegPairs
 210+ 6B39              .awrpDone:
 211+ 6B39 FB               EI
 212+ 6B3A C9               RET
 213+ 6B3B
 214+ 6B3B              ; ==============================================================================
 215+ 6B3B              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 6B3B              ; ==============================================================================
 217+ 6B3B              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 6B3B              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 6B3B              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 6B3B              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 6B3B              ; (con IFF=0), no hay race.
 222+ 6B3B              ;
 223+ 6B3B              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 6B3B              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 6B3B              ; Destruye: A, BC, DE, HL.
 226+ 6B3B              ; ==============================================================================
 227+ 6B3B              AY_UpdatePlayerHit:
 228+ 6B3B                  ; --- PendingPin tick: dispara beep diferido (lasting compass stage 2) ---
 229+ 6B3B                  ; Cuando AY_PlayLastingPickup arma una "PIN" tras el sweep, el ticker la
 230+ 6B3B                  ; dispara cuando el contador llega a 0. Escritura R2/R3/R9 inline (sin
 231+ 6B3B                  ; DI/EI: ya en contexto IRQ). Tras setear BeepDurationFrames el cutoff
 232+ 6B3B                  ; lo gestiona el path .uphCheckBeep en proximos ticks.
 233+ 6B3B 3A CB 6B         LD A, (PendingPinTimer)
 234+ 6B3E B7               OR A
 235+ 6B3F 28 34            JR Z, .uphAfterPin
 236+ 6B41 3D               DEC A
 237+ 6B42 32 CB 6B         LD (PendingPinTimer), A
 238+ 6B45 20 2E            JR NZ, .uphAfterPin
 239+ 6B47 2A CC 6B         LD HL, (PendingPinPeriod)
 240+ 6B4A 0E FD            LD C, $FD
 241+ 6B4C 3E 02            LD A, 2
 242+ 6B4E 06 FF            LD B, $FF
 243+ 6B50 ED 79            OUT (C), A
 244+ 6B52 7D               LD A, L
 245+ 6B53 06 BF            LD B, $BF
 246+ 6B55 ED 79            OUT (C), A
 247+ 6B57 3E 03            LD A, 3
 248+ 6B59 06 FF            LD B, $FF
 249+ 6B5B ED 79            OUT (C), A
 250+ 6B5D 7C               LD A, H
 251+ 6B5E 06 BF            LD B, $BF
 252+ 6B60 ED 79            OUT (C), A
 253+ 6B62 3E 09            LD A, 9
 254+ 6B64 06 FF            LD B, $FF
 255+ 6B66 ED 79            OUT (C), A
 256+ 6B68 3E 0F            LD A, $0F                           ; vol max canal B
 257+ 6B6A 06 BF            LD B, $BF
 258+ 6B6C ED 79            OUT (C), A
 259+ 6B6E 3A CE 6B         LD A, (PendingPinFrames)
 260+ 6B71 32 A3 6A         LD (BeepDurationFrames), A          ; arma cutoff
 261+ 6B74 C9               RET                                 ; skip resto del ticker este frame
 262+ 6B75              .uphAfterPin:
 263+ 6B75 3A 9E 6A         LD A, (PlayerHitFrames)
 264+ 6B78 B7               OR A
 265+ 6B79 28 2A            JR Z, .uphCheckBeep
 266+ 6B7B 3D               DEC A
 267+ 6B7C 32 9E 6A         LD (PlayerHitFrames), A
 268+ 6B7F 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 269+ 6B81
 270+ 6B81 2A 9F 6A         LD HL, (PlayerHitPeriod)
 271+ 6B84 ED 5B A1 6A      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 272+ 6B88 19               ADD HL, DE
 273+ 6B89 22 9F 6A         LD (PlayerHitPeriod), HL
 274+ 6B8C
 275+ 6B8C                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 276+ 6B8C 0E FD            LD C, $FD
 277+ 6B8E 3E 02            LD A, 2
 278+ 6B90 06 FF            LD B, $FF
 279+ 6B92 ED 79            OUT (C), A
 280+ 6B94 7D               LD A, L
 281+ 6B95 06 BF            LD B, $BF
 282+ 6B97 ED 79            OUT (C), A
 283+ 6B99 3E 03            LD A, 3
 284+ 6B9B 06 FF            LD B, $FF
 285+ 6B9D ED 79            OUT (C), A
 286+ 6B9F 7C               LD A, H
 287+ 6BA0 06 BF            LD B, $BF
 288+ 6BA2 ED 79            OUT (C), A
 289+ 6BA4 C9               RET
 290+ 6BA5
 291+ 6BA5              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 292+ 6BA5              .uphCheckBeep:
 293+ 6BA5 3A A3 6A         LD A, (BeepDurationFrames)
 294+ 6BA8 B7               OR A
 295+ 6BA9 C8               RET Z
 296+ 6BAA 3D               DEC A
 297+ 6BAB 32 A3 6A         LD (BeepDurationFrames), A
 298+ 6BAE C0               RET NZ
 299+ 6BAF                  ; fall-through al cutoff compartido
 300+ 6BAF
 301+ 6BAF              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 302+ 6BAF              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 303+ 6BAF              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 304+ 6BAF              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 305+ 6BAF              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 306+ 6BAF              _uphMuteR9:
 307+ 6BAF 01 FD FF         LD BC, $FFFD
 308+ 6BB2 3E 09            LD A, 9
 309+ 6BB4 ED 79            OUT (C), A
 310+ 6BB6 01 FD BF         LD BC, $BFFD
 311+ 6BB9 AF               XOR A
 312+ 6BBA ED 79            OUT (C), A
 313+ 6BBC                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 314+ 6BBC 01 FD FF         LD BC, $FFFD
 315+ 6BBF 3E 07            LD A, 7
 316+ 6BC1 ED 79            OUT (C), A
 317+ 6BC3 01 FD BF         LD BC, $BFFD
 318+ 6BC6 3E 38            LD A, $38
 319+ 6BC8 ED 79            OUT (C), A
 320+ 6BCA C9               RET
 321+ 6BCB
 322+ 6BCB              ; AchievementJingle ELIMINADO: el chime de "llegar a la sala del hito" ahora
 323+ 6BCB              ; reusa AY_PlayCompassPickup (mismo sweep que el pickup del magic compass
 324+ 6BCB              ; random). Libera ~80 B en slot 1 y unifica el feedback "evento positivo de
 325+ 6BCB              ; navegacion" con un unico sonido.
 326+ 6BCB
 327+ 6BCB              ; ==============================================================================
 328+ 6BCB              ; CompassPickup SFX (random + lasting) - sweeps tipo PlayerHit/Death
 329+ 6BCB              ; ==============================================================================
 330+ 6BCB              ; Reusan _AY_PlaySweep (sweep continuo de pitch en canal B AY, no bloqueante,
 331+ 6BCB              ; cutoff abrupto al final via _uphMuteR9). Llamados desde ApplyMagicCompassBuff
 332+ 6BCB              ; segun MagicCompassPermanent: random -> AY_PlayCompassPickup (solo sweep),
 333+ 6BCB              ; lasting -> AY_PlayLastingPickup (sweep + PIN sostenido tipo "WHHIII-PIN").
 334+ 6BCB              ;
 335+ 6BCB              ; Direccion del sweep: GRAVE -> AGUDO ("found it!" feel). Period inicial alto,
 336+ 6BCB              ; delta NEGATIVO en two's complement ($FFE8 = -24 etc). _AY_PlaySweep usa
 337+ 6BCB              ; ADD HL, DE asi que el wrap unsigned funciona como resta.
 338+ 6BCB              ; ==============================================================================
 339+ 6BCB
 340+ 6BCB              ; Random compass: sweep ascendente ~640 ms (16 frames)
 341+ 6BCB              ;   $0200 (210 Hz, B3) -> $0080 (853 Hz, A5) — 2 octavas
 342+ 6BCB              COMPASS_SWEEP_PERIOD_INIT  EQU $0200
 343+ 6BCB              COMPASS_SWEEP_FRAMES       EQU 16
 344+ 6BCB              COMPASS_SWEEP_DELTA        EQU $FFE8         ; -24/frame
 345+ 6BCB
 346+ 6BCB              ; Lasting compass: sweep ascendente ~880 ms (22 frames) + PIN sostenido
 347+ 6BCB              ;   Sweep: $0300 (140 Hz, D3) -> $0040 (1700 Hz, ~A6) — 3+ octavas
 348+ 6BCB              ;   PIN: $0030 (~2270 Hz) por 6 frames (240 ms), 1 frame despues del sweep
 349+ 6BCB              LASTING_SWEEP_PERIOD_INIT  EQU $0300
 350+ 6BCB              LASTING_SWEEP_FRAMES       EQU 22
 351+ 6BCB              LASTING_SWEEP_DELTA        EQU $FFE0         ; -32/frame
 352+ 6BCB              LASTING_PIN_PERIOD         EQU $0030         ; ~2270 Hz, muy brillante
 353+ 6BCB              LASTING_PIN_FRAMES         EQU 6             ; 240 ms
 354+ 6BCB              LASTING_PIN_DELAY          EQU LASTING_SWEEP_FRAMES + 1   ; fire 1 frame tras cutoff
 355+ 6BCB
 356+ 6BCB              ; State del PIN diferido (tickeado por AY_UpdatePlayerHit)
 357+ 6BCB 00           PendingPinTimer:    DEFB 0       ; >0 = pendiente; 0 = nada
 358+ 6BCC 00 00        PendingPinPeriod:   DEFW 0       ; period AY canal B
 359+ 6BCE 00           PendingPinFrames:   DEFB 0       ; duracion del beep tras dispararse
 360+ 6BCF
 361+ 6BCF              ; AY_PlayCompassPickup - magic compass random
 362+ 6BCF              AY_PlayCompassPickup:
 363+ 6BCF 21 00 02         LD HL, COMPASS_SWEEP_PERIOD_INIT
 364+ 6BD2 06 10            LD B, COMPASS_SWEEP_FRAMES
 365+ 6BD4 11 E8 FF         LD DE, COMPASS_SWEEP_DELTA
 366+ 6BD7 C3 B6 6A         JP _AY_PlaySweep                  ; tail call
 367+ 6BDA
 368+ 6BDA              ; AY_PlayLastingPickup - lasting compass: sweep + PIN encadenado
 369+ 6BDA              AY_PlayLastingPickup:
 370+ 6BDA 21 00 03         LD HL, LASTING_SWEEP_PERIOD_INIT
 371+ 6BDD 06 16            LD B, LASTING_SWEEP_FRAMES
 372+ 6BDF 11 E0 FF         LD DE, LASTING_SWEEP_DELTA
 373+ 6BE2 CD B6 6A         CALL _AY_PlaySweep
 374+ 6BE5                  ; Encolar PIN (beep agudo final) para que dispare 1 frame tras el sweep
 375+ 6BE5 21 30 00         LD HL, LASTING_PIN_PERIOD
 376+ 6BE8 22 CC 6B         LD (PendingPinPeriod), HL
 377+ 6BEB 3E 06            LD A, LASTING_PIN_FRAMES
 378+ 6BED 32 CE 6B         LD (PendingPinFrames), A
 379+ 6BF0 3E 17            LD A, LASTING_PIN_DELAY
 380+ 6BF2 32 CB 6B         LD (PendingPinTimer), A
 381+ 6BF5 C9               RET
 382+ 6BF6
# file closed: sfx_player_hit_ay.asm
 161  6BF6
 162  6BF6                  ; --- Random pickups: thunks slot 1 (random_pickups.asm body en bank 7) ---
 163  6BF6                  ; Movido a bank 7 para liberar slot 1 (~1.1 KB neto). Aqui solo viven los
 164  6BF6                  ; 9 entry thunks que paginan bank 7 + SP swap a alt_stack compartido con
 165  6BF6                  ; bank_cutscene, mas 3 _B7 wrappers nuevos (SkipPixelData/RestorePickupAttrs/
 166  6BF6                  ; ApplyMagicCompassBuff). Body en INCLUDE en PAGE 7 mas abajo.
 167  6BF6                  INCLUDE "random_pickups_thunks.asm"
# file opened: random_pickups_thunks.asm
   1+ 6BF6              ; ==============================================================================
   2+ 6BF6              ; random_pickups_thunks.asm - Wrappers slot 1 para random_pickups.asm en bank 7
   3+ 6BF6              ; ==============================================================================
   4+ 6BF6              ; random_pickups.asm vivia en slot 1 ($6BF7..$70E4, ~1.26 KB). Movido a bank 7
   5+ 6BF6              ; para liberar slot 1 (donde RoomCompGapsTable y la IM2 table compiten por el
   6+ 6BF6              ; espacio anterior a $7A00). El movimiento libera ~1.1 KB neto en slot 1.
   7+ 6BF6              ;
   8+ 6BF6              ; Body bank 7 expone 9 entry points externos. Aqui se exponen como thunks que
   9+ 6BF6              ; comparten un shell de SP swap + page switch para minimizar bytes en slot 1.
  10+ 6BF6              ;
  11+ 6BF6              ; Reutiliza de bank_cutscene_thunks.asm (slot 1, ya incluido en main.asm):
  12+ 6BF6              ;   - _PageBank0 / _PageBank7
  13+ 6BF6              ;   - BankCutsceneAltStackTop
  14+ 6BF6              ;   - LoadBgSpriteToBuffer_B7
  15+ 6BF6              ;   - DrawBgSpriteXOR_B7
  16+ 6BF6              ;   - PlaySFX_B7
  17+ 6BF6              ;
  18+ 6BF6              ; Nuevos _B7 wrappers (slot 1, para usar desde body en bank 7):
  19+ 6BF6              ;   - SkipPixelData_B7        (bank 0)
  20+ 6BF6              ;   - RestorePickupAttrs_B7   (bank 0)
  21+ 6BF6              ;   - ApplyMagicCompassBuff_B7 (slot 1, wrap por seguridad — llama helpers bank 0)
  22+ 6BF6              ;
  23+ 6BF6              ; CRITICO: stack normal en slot 3 (bank 0 paginable). Los thunks hacen SP swap
  24+ 6BF6              ; a BankCutsceneAltStackTop antes del page switch. Compartido secuencialmente
  25+ 6BF6              ; con bank_cutscene/town_gate thunks dentro del mismo frame — no conflicto
  26+ 6BF6              ; porque son single-threaded (Z80 + IRQ handler en slot 1 que no toca slot 3).
  27+ 6BF6              ; ==============================================================================
  28+ 6BF6
  29+ 6BF6              ; ==============================================================================
  30+ 6BF6              ; _RP_Thunk - shell compartido por los 9 entry thunks
  31+ 6BF6              ; ==============================================================================
  32+ 6BF6              ; IN:  HL = body address (en bank 7)
  33+ 6BF6              ; OUT: lo que devuelva el body. Regs intermedios usados por body, no preservados.
  34+ 6BF6              ; Destruye: AF, HL (la propia entrada).
  35+ 6BF6              ;
  36+ 6BF6              ; Flujo:
  37+ 6BF6              ;   1. Save SP normal en _RP_savedSP.
  38+ 6BF6              ;   2. Swap SP a alt_stack (slot 1 always-visible).
  39+ 6BF6              ;   3. Page bank 7 en slot 3.
  40+ 6BF6              ;   4. JP (HL) -> body (via CALL .callHL + JP (HL): el RET del body cae aqui).
  41+ 6BF6              ;   5. Page bank 0 en slot 3.
  42+ 6BF6              ;   6. Restore SP normal.
  43+ 6BF6              ;   7. RET al caller original (MainLoop).
  44+ 6BF6              ; ==============================================================================
  45+ 6BF6              _RP_Thunk:
  46+ 6BF6 ED 73 0C 6C      LD (_RP_savedSP), SP
  47+ 6BFA 31 00 80         LD SP, BankCutsceneAltStackTop
  48+ 6BFD CD B0 6C         CALL _PageBank7
  49+ 6C00 CD 0B 6C         CALL .callHL
  50+ 6C03 CD 9E 6C         CALL _PageBank0
  51+ 6C06 ED 7B 0C 6C      LD SP, (_RP_savedSP)
  52+ 6C0A C9               RET
  53+ 6C0B              .callHL:
  54+ 6C0B E9               JP (HL)
  55+ 6C0C 00 00        _RP_savedSP: DEFW 0
  56+ 6C0E
  57+ 6C0E              ; ==============================================================================
  58+ 6C0E              ; Entry thunks - cada uno carga HL=body y salta al shell shared
  59+ 6C0E              ; ==============================================================================
  60+ 6C0E              ; 5 bytes cada uno (LD HL = 3 B + JR = 2 B). JR backward al shell. Como el
  61+ 6C0E              ; shell mide ~18 B + las entries son ~45 B, todos los offsets caben en signed 8.
  62+ 6C0E              ;
  63+ 6C0E              ; Callers externos (registros sin args):
  64+ 6C0E              ;   UpdateRandomPickup, UpdateRoulette, PaintSynthPickupAttrs, UpdateSpeedBuff,
  65+ 6C0E              ;   UpdateMushroomBuff: MainLoop cada frame (early-out fast).
  66+ 6C0E              ;   CheckRandomSyntheticPickup: screen_system / pickup collect.
  67+ 6C0E              ;   GiveLife / GiveHealth / GiveStamina: screen_system (well pickup) +
  68+ 6C0E              ;       internamente desde CheckRandomSyntheticPickup body (intra-bank, no thunk).
  69+ 6C0E              ; ==============================================================================
  70+ 6C0E              UpdateRandomPickup:
  71+ 6C0E 21 2F ED         LD HL, UpdateRandomPickupBody
  72+ 6C11 18 E3            JR _RP_Thunk
  73+ 6C13              UpdateRoulette:
  74+ 6C13 21 6B EB         LD HL, UpdateRouletteBody
  75+ 6C16 18 DE            JR _RP_Thunk
  76+ 6C18              PaintSynthPickupAttrs:
  77+ 6C18 21 60 EF         LD HL, PaintSynthPickupAttrsBody
  78+ 6C1B 18 D9            JR _RP_Thunk
  79+ 6C1D              UpdateSpeedBuff:
  80+ 6C1D 21 11 ED         LD HL, UpdateSpeedBuffBody
  81+ 6C20 18 D4            JR _RP_Thunk
  82+ 6C22              UpdateMushroomBuff:
  83+ 6C22 21 AB EC         LD HL, UpdateMushroomBuffBody
  84+ 6C25 18 CF            JR _RP_Thunk
  85+ 6C27              CheckRandomSyntheticPickup:
  86+ 6C27 21 99 EF         LD HL, CheckRandomSyntheticPickupBody
  87+ 6C2A 18 CA            JR _RP_Thunk
  88+ 6C2C              GiveLife:
  89+ 6C2C 21 77 EA         LD HL, GiveLifeBody
  90+ 6C2F 18 C5            JR _RP_Thunk
  91+ 6C31              GiveHealth:
  92+ 6C31 21 82 EA         LD HL, GiveHealthBody
  93+ 6C34 18 C0            JR _RP_Thunk
  94+ 6C36              GiveStamina:
  95+ 6C36 21 93 EA         LD HL, GiveStaminaBody
  96+ 6C39 18 BB            JR _RP_Thunk
  97+ 6C3B              UpdatePlayerColorCycler:
  98+ 6C3B                  ; CRITICO: PlayerHitTimer vive en bank 0 (slot 3). Hay que leerlo AQUI
  99+ 6C3B                  ; (con slot 3 = bank 0 default) antes de paginar bank 7 en el shell. Si
 100+ 6C3B                  ; lo lee el body, leeria de bank 7 (basura) y abortaria casi siempre.
 101+ 6C3B 3A 35 C5         LD A, (PlayerHitTimer)
 102+ 6C3E B7               OR A
 103+ 6C3F C0               RET NZ                              ; damage flash priority -> no cyclar
 104+ 6C40 21 B8 EB         LD HL, UpdatePlayerColorCyclerBody
 105+ 6C43 18 B1            JR _RP_Thunk
 106+ 6C45              UpdateEspadaBuff:
 107+ 6C45 21 C3 EC         LD HL, UpdateEspadaBuffBody
 108+ 6C48 18 AC            JR _RP_Thunk
 109+ 6C4A              UpdateEscudoBuff:
 110+ 6C4A 21 D5 EC         LD HL, UpdateEscudoBuffBody
 111+ 6C4D 18 A7            JR _RP_Thunk
 112+ 6C4F              UpdateReverseBuff:
 113+ 6C4F 21 F0 EC         LD HL, UpdateReverseBuffBody
 114+ 6C52 18 A2            JR _RP_Thunk
 115+ 6C54
 116+ 6C54              ; ==============================================================================
 117+ 6C54              ; _B7 wrappers - llamados desde body en bank 7. Paginan bank 0, ejecutan el
 118+ 6C54              ; callee, paginan bank 7 al volver. Estos viven en slot 1 (always-visible).
 119+ 6C54              ; ==============================================================================
 120+ 6C54              ; SkipPixelData / RestorePickupAttrs: bank 0 (slot 3 default), helpers de
 121+ 6C54              ; pickup rendering usados por LoadSynthSpriteAndExtractAttr / CheckRandomSyntheticPickup.
 122+ 6C54              ;
 123+ 6C54              ; ApplyMagicCompassBuff: slot 1 (magic_compass.asm) pero llama helpers bank 0
 124+ 6C54              ; internamente -> wrap completo. Solo se usa via JP tail-call desde dispatch
 125+ 6C54              ; del pickup compass directo (no via ruleta).
 126+ 6C54              ; ==============================================================================
 127+ 6C54              SkipPixelData_B7:
 128+ 6C54 CD 9E 6C         CALL _PageBank0
 129+ 6C57 CD FB D3         CALL SkipPixelData
 130+ 6C5A C3 B0 6C         JP _PageBank7
 131+ 6C5D              RestorePickupAttrs_B7:
 132+ 6C5D CD 9E 6C         CALL _PageBank0
 133+ 6C60 CD C0 DC         CALL RestorePickupAttrs
 134+ 6C63 C3 B0 6C         JP _PageBank7
 135+ 6C66              ApplyMagicCompassBuff_B7:
 136+ 6C66 CD 9E 6C         CALL _PageBank0
 137+ 6C69 CD CC 6D         CALL ApplyMagicCompassBuff
 138+ 6C6C C3 B0 6C         JP _PageBank7
 139+ 6C6F
# file closed: random_pickups_thunks.asm
 168  6C6F
 169  6C6F                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 170  6C6F                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 171  6C6F                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 172  6C6F                  ;
 173  6C6F                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 174  6C6F                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 175  6C6F                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 176  6C6F                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 177  6C6F                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 178  6C6F                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 179  6C6F                  ; mantiene por estabilidad.
 180  6C6F                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 6C6F              ; ==============================================================================
   2+ 6C6F              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 6C6F              ; ==============================================================================
   4+ 6C6F              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 6C6F              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 6C6F              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 6C6F              ;
   8+ 6C6F              ; Estrategia:
   9+ 6C6F              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 6C6F              ;      bank 0 paginado en slot 3.
  11+ 6C6F              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 6C6F              ;      seguro hacer la conmutación aquí).
  13+ 6C6F              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 6C6F              ;   4. Body retorna → restauramos bank 0.
  15+ 6C6F              ;
  16+ 6C6F              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 6C6F              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 6C6F              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 6C6F              ; ==============================================================================
  20+ 6C6F
  21+ 6C6F              DrawTombstone2xCentered:
  22+ 6C6F                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 6C6F 21 6C D9         LD HL, BgGfx_little_house_cemetery
  24+ 6C72 3E 04            LD A, TOMB_SRC_BANK             ; 4
  25+ 6C74 CD C9 67         CALL LoadBgSpriteToBuffer
  26+ 6C77
  27+ 6C77                  ; --- 2. Paginar bank 7 en slot 3 para acceder al body ---
  28+ 6C77 F3               DI
  29+ 6C78 3A 8A 8D         LD A, (CurrentPaging)
  30+ 6C7B E6 F8            AND $F8
  31+ 6C7D F6 07            OR 7
  32+ 6C7F 32 8A 8D         LD (CurrentPaging), A
  33+ 6C82 01 FD 7F         LD BC, $7FFD
  34+ 6C85 ED 79            OUT (C), A
  35+ 6C87
  36+ 6C87                  ; --- 3. CALL al body (vive en bank 7, ahora visible en slot 3) ---
  37+ 6C87 CD 7B DB         CALL DrawTombstone2xBody
  38+ 6C8A
  39+ 6C8A                  ; --- 4. Restaurar bank 0 (estado por defecto del juego) ---
  40+ 6C8A 3A 8A 8D         LD A, (CurrentPaging)
  41+ 6C8D E6 F8            AND $F8                         ; bank 0 = bits 0-2 a cero
  42+ 6C8F 32 8A 8D         LD (CurrentPaging), A
  43+ 6C92 01 FD 7F         LD BC, $7FFD
  44+ 6C95 ED 79            OUT (C), A
  45+ 6C97
  46+ 6C97                  ; Restaurar interrupciones (mismo patrón que LoadBgSpriteToBuffer)
  47+ 6C97 3A A2 81         LD A, (StartupComplete)
  48+ 6C9A B7               OR A
  49+ 6C9B C8               RET Z                           ; aún en Inicio → dejar DI
  50+ 6C9C FB               EI
  51+ 6C9D C9               RET
  52+ 6C9E
# file closed: game_over_tomb_thunk.asm
