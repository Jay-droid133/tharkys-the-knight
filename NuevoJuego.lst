2641+ B0C5              ; ==============================================================================
2642+ B0C5              ; ==============================================================================
2643+ B0C5              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2644+ B0C5              ; ==============================================================================
2645+ B0C5              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2646+ B0C5              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2647+ B0C5              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2648+ B0C5              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2649+ B0C5              ; ==============================================================================
2650+ B0C5              UpdateMonster:
2651+ B0C5                  ; --- Stun: knockback + pausa tras golpe del player ---
2652+ B0C5 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2653+ B0C8 B7               OR A
2654+ B0C9 CA FE B2         JP Z, .moNormal
2655+ B0CC DD 35 0A         DEC (IX+ENT_DIR)
2656+ B0CF 20 0B            JR NZ, .moStunActive
2657+ B0D1                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2658+ B0D1 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2659+ B0D5 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2660+ B0D9 C3 FE B2         JP .moNormal
2661+ B0DC
2662+ B0DC              .moStunActive:
2663+ B0DC                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2664+ B0DC FE 06            CP MONSTER_STUN_PAUSE
2665+ B0DE DA 8F B4         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2666+ B0E1                  ; Knockback: aplicar movimiento con collision check
2667+ B0E1 DD 56 06         LD D, (IX+ENT_DELTAX)
2668+ B0E4 DD 5E 07         LD E, (IX+ENT_DELTAY)
2669+ B0E7 7A               LD A, D
2670+ B0E8 B3               OR E
2671+ B0E9 CA 8F B4         JP Z, .moAnimate
2672+ B0EC                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2673+ B0EC D5               PUSH DE
2674+ B0ED DD 7E 03         LD A, (IX+ENT_POSX)
2675+ B0F0 32 27 B6         LD (.moSvX), A
2676+ B0F3 DD 7E 04         LD A, (IX+ENT_POSY)
2677+ B0F6 32 28 B6         LD (.moSvY), A
2678+ B0F9                  ; Calcular nueva posicion
2679+ B0F9 DD 7E 03         LD A, (IX+ENT_POSX)
2680+ B0FC 82               ADD A, D
2681+ B0FD DD 77 03         LD (IX+ENT_POSX), A
2682+ B100 DD 7E 04         LD A, (IX+ENT_POSY)
2683+ B103 83               ADD A, E
2684+ B104 DD 77 04         LD (IX+ENT_POSY), A
2685+ B107                  ; Comprobar bordes ANTES de colision con paredes
2686+ B107 DD 7E 03         LD A, (IX+ENT_POSX)
2687+ B10A FE E8            CP SCREEN_MAX_X
2688+ B10C 30 30            JR NC, .moKbPreOffscreen
2689+ B10E FE 04            CP MONSTER_KB_SPEED
2690+ B110 38 20            JR C, .moKbPreOffscreenMaybeX
2691+ B112              .moKbPreBorderXOk:
2692+ B112 DD 7E 04         LD A, (IX+ENT_POSY)
2693+ B115 FE A8            CP SCREEN_MAX_Y
2694+ B117 30 25            JR NC, .moKbPreOffscreen
2695+ B119 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2696+ B11B 38 1B            JR C, .moKbPreOffscreenMaybeY
2697+ B11D              .moKbPreBorderOk:
2698+ B11D                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2699+ B11D                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2700+ B11D                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2701+ B11D                  ; CheckEnemyCollision.
2702+ B11D                  ; CheckChurchTrap retorna:
2703+ B11D                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2704+ B11D                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2705+ B11D                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2706+ B11D CD 21 F3         CALL CheckChurchTrap
2707+ B120 B7               OR A
2708+ B121 28 07            JR Z, .moKbCollCheck
2709+ B123 FE 02            CP 2
2710+ B125 CA D6 B1         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2711+ B128 D1               POP DE                              ; limpiar PUSH DE previo
2712+ B129 C9               RET                                 ; cutscene activa, salir
2713+ B12A              .moKbCollCheck:
2714+ B12A                  ; Dentro de pantalla: comprobar colision con paredes
2715+ B12A CD A3 B9         CALL CheckEnemyCollision
2716+ B12D C2 D6 B1         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2717+ B130 18 1C            JR .moKbNotBlocked
2718+ B132              .moKbPreOffscreenMaybeX:
2719+ B132 CB 7A            BIT 7, D
2720+ B134 20 08            JR NZ, .moKbPreOffscreen
2721+ B136 18 DA            JR .moKbPreBorderXOk
2722+ B138              .moKbPreOffscreenMaybeY:
2723+ B138 CB 7B            BIT 7, E
2724+ B13A 20 02            JR NZ, .moKbPreOffscreen
2725+ B13C 18 DF            JR .moKbPreBorderOk
2726+ B13E              .moKbPreOffscreen:
2727+ B13E                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2728+ B13E 3A 27 B6         LD A, (.moSvX)
2729+ B141 DD 77 03         LD (IX+ENT_POSX), A
2730+ B144 3A 28 B6         LD A, (.moSvY)
2731+ B147 DD 77 04         LD (IX+ENT_POSY), A
2732+ B14A D1               POP DE
2733+ B14B C3 3B B2         JP .moKbOffscreen
2734+ B14E              .moKbNotBlocked:
2735+ B14E                  ; Pared libre: comprobar impacto con otro monster (billar)
2736+ B14E CD 28 B5         CALL .moCheckOverlap
2737+ B151 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2738+ B153                  ; Libre: restaurar pos y aplicar movimiento
2739+ B153 3A 27 B6         LD A, (.moSvX)
2740+ B156 DD 77 03         LD (IX+ENT_POSX), A
2741+ B159 3A 28 B6         LD A, (.moSvY)
2742+ B15C DD 77 04         LD (IX+ENT_POSY), A
2743+ B15F D1               POP DE
2744+ B160 C3 12 B2         JP .moKbApply
2745+ B163              .moKbBilliard:
2746+ B163                  ; Billar: A para en su sitio, B hereda la fuerza
2747+ B163 3A 27 B6         LD A, (.moSvX)
2748+ B166 DD 77 03         LD (IX+ENT_POSX), A
2749+ B169 3A 28 B6         LD A, (.moSvY)
2750+ B16C DD 77 04         LD (IX+ENT_POSY), A
2751+ B16F D1               POP DE
2752+ B170                  ; Transferir knockback al monster impactado
2753+ B170 DD E5            PUSH IX
2754+ B172 DD 2A 31 B6      LD IX, (.moHitMonster)
2755+ B176                  ; Solo transferir si no esta ya en stun
2756+ B176 DD 7E 0A         LD A, (IX+ENT_DIR)
2757+ B179 B7               OR A
2758+ B17A 20 2A            JR NZ, .moKbBilliardDone
2759+ B17C                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2760+ B17C 7A               LD A, D
2761+ B17D B7               OR A
2762+ B17E 28 0D            JR Z, .moBillNoX
2763+ B180 CB 7A            BIT 7, D
2764+ B182 20 04            JR NZ, .moBillXNeg
2765+ B184 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2766+ B186 18 02            JR .moBillSetX
2767+ B188              .moBillXNeg:
2768+ B188 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2769+ B18A              .moBillSetX:
2770+ B18A DD 77 06         LD (IX+ENT_DELTAX), A
2771+ B18D              .moBillNoX:
2772+ B18D 7B               LD A, E
2773+ B18E B7               OR A
2774+ B18F 28 0D            JR Z, .moBillNoY
2775+ B191 CB 7B            BIT 7, E
2776+ B193 20 04            JR NZ, .moBillYNeg
2777+ B195 3E 03            LD A, MONSTER_KB_SPEED - 1
2778+ B197 18 02            JR .moBillSetY
2779+ B199              .moBillYNeg:
2780+ B199 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2781+ B19B              .moBillSetY:
2782+ B19B DD 77 07         LD (IX+ENT_DELTAY), A
2783+ B19E              .moBillNoY:
2784+ B19E DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2785+ B1A2                  ; Kb heredado por billar: NO es directo del player.
2786+ B1A2                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2787+ B1A2 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2788+ B1A6              .moKbBilliardDone:
2789+ B1A6 DD E1            POP IX
2790+ B1A8                  ; A continua con fuerza reducida (no para del todo)
2791+ B1A8                  ; Reducir velocidad de A a la mitad
2792+ B1A8 DD 7E 06         LD A, (IX+ENT_DELTAX)
2793+ B1AB CB 2F            SRA A                               ; /2 con signo
2794+ B1AD DD 77 06         LD (IX+ENT_DELTAX), A
2795+ B1B0 57               LD D, A
2796+ B1B1 DD 7E 07         LD A, (IX+ENT_DELTAY)
2797+ B1B4 CB 2F            SRA A
2798+ B1B6 DD 77 07         LD (IX+ENT_DELTAY), A
2799+ B1B9 5F               LD E, A
2800+ B1BA                  ; Reducir stun restante de A
2801+ B1BA DD 7E 0A         LD A, (IX+ENT_DIR)
2802+ B1BD FE 08            CP MONSTER_STUN_PAUSE + 2
2803+ B1BF DA F3 B2         JP C, .moStunStop                   ; Casi sin stun → parar
2804+ B1C2 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2805+ B1C4 DD 77 0A         LD (IX+ENT_DIR), A
2806+ B1C7                  ; Aplicar movimiento reducido de A
2807+ B1C7 3A 27 B6         LD A, (.moSvX)
