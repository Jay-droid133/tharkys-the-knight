 120  6CF5
 121  6CF5                  ; --- SFX hit del player no bloqueante (sfx_player_hit_ay.asm) ---
 122  6CF5                  ; AY hardware envelope, direct OUTs sin paging. ~35 B en slot 1.
 123  6CF5                  INCLUDE "sfx_player_hit_ay.asm"
# file opened: sfx_player_hit_ay.asm
   1+ 6CF5              ; ==============================================================================
   2+ 6CF5              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6CF5              ; ==============================================================================
   4+ 6CF5              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6CF5              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6CF5              ;
   7+ 6CF5              ; Diseño beeper-style:
   8+ 6CF5              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6CF5              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6CF5              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6CF5              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6CF5              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6CF5              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6CF5              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6CF5              ;     hits clasicos en 48K).
  16+ 6CF5              ;   - AY_UpdatePlayerHit se llama cada frame desde MainLoop (cold path: salta
  17+ 6CF5              ;     en RET Z si no hay sweep activo).
  18+ 6CF5              ;
  19+ 6CF5              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  20+ 6CF5              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  21+ 6CF5              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  22+ 6CF5              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  23+ 6CF5              ;
  24+ 6CF5              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  25+ 6CF5              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  26+ 6CF5              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  27+ 6CF5              ;
  28+ 6CF5              ; Llamado desde:
  29+ 6CF5              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  30+ 6CF5              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  31+ 6CF5              ;   - MainLoop cada frame — update.
  32+ 6CF5              ; ==============================================================================
  33+ 6CF5
  34+ 6CF5              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  35+ 6CF5 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  36+ 6CF6 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  37+ 6CF8 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  38+ 6CFA 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  39+ 6CFB                                                ; (0 = inactivo o ya muteado)
  40+ 6CFB
  41+ 6CFB              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  42+ 6CFB              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  43+ 6CFB              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  44+ 6CFB              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  45+ 6CFB
  46+ 6CFB              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  47+ 6CFB              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  48+ 6CFB              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  49+ 6CFB              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  50+ 6CFB
  51+ 6CFB              ; ==============================================================================
  52+ 6CFB              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  53+ 6CFB              ; ==============================================================================
  54+ 6CFB              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  55+ 6CFB              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  56+ 6CFB              ; tabla los hardcodea.
  57+ 6CFB              ; ==============================================================================
  58+ 6CFB              AY_PlayPlayerHit:
  59+ 6CFB 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  60+ 6CFE 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  61+ 6D00 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  62+ 6D03 18 08            JR _AY_PlaySweep
  63+ 6D05
  64+ 6D05              AY_PlayPlayerDeath:
  65+ 6D05 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  66+ 6D08 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  67+ 6D0A 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  68+ 6D0D                  ; fall through
  69+ 6D0D
  70+ 6D0D              ; IN: HL=period inicial, B=frames, DE=delta.
  71+ 6D0D              _AY_PlaySweep:
  72+ 6D0D 22 F6 6C         LD (PlayerHitPeriod), HL
  73+ 6D10 ED 53 F8 6C      LD (PlayerHitDelta), DE
  74+ 6D14 78               LD A, B
  75+ 6D15 32 F5 6C         LD (PlayerHitFrames), A
  76+ 6D18 F3               DI
  77+ 6D19 0E FD            LD C, $FD
  78+ 6D1B 21 21 6D         LD HL, .phRegs
  79+ 6D1E C3 52 6D         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  80+ 6D21
  81+ 6D21              .phRegs:
  82+ 6D21 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  83+ 6D23 03 00            DEFB  3, $00          ; R3  = period B hi
  84+ 6D25 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  85+ 6D27 07 3D            DEFB  7, $3D          ; R7  = mixer (tono B on, A/C off, noise off)
  86+ 6D29 FF               DEFB $FF              ; sentinel
  87+ 6D2A
  88+ 6D2A              ; ==============================================================================
  89+ 6D2A              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  90+ 6D2A              ; ==============================================================================
  91+ 6D2A              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  92+ 6D2A              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  93+ 6D2A              ; Canal B (center stereo ABC). No bloqueante.
  94+ 6D2A              ;
  95+ 6D2A              ; IN: HL = period AY canal B (mayor = mas grave).
  96+ 6D2A              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
  97+ 6D2A              ;
  98+ 6D2A              ; Sugerencias:
  99+ 6D2A              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 100+ 6D2A              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 101+ 6D2A              ; Destruye: A, BC, HL.
 102+ 6D2A              ; ==============================================================================
 103+ 6D2A              AY_PlayBeep:
 104+ 6D2A 78               LD A, B
 105+ 6D2B 32 FA 6C         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 106+ 6D2E F3               DI
 107+ 6D2F 0E FD            LD C, $FD
 108+ 6D31                  ; R2 = L (period B lo)
 109+ 6D31 3E 02            LD A, 2
 110+ 6D33 06 FF            LD B, $FF
 111+ 6D35 ED 79            OUT (C), A
 112+ 6D37 7D               LD A, L
 113+ 6D38 06 BF            LD B, $BF
 114+ 6D3A ED 79            OUT (C), A
 115+ 6D3C                  ; R3 = H (period B hi)
 116+ 6D3C 3E 03            LD A, 3
 117+ 6D3E 06 FF            LD B, $FF
 118+ 6D40 ED 79            OUT (C), A
 119+ 6D42 7C               LD A, H
 120+ 6D43 06 BF            LD B, $BF
 121+ 6D45 ED 79            OUT (C), A
 122+ 6D47                  ; R9 = $0F (vol max fija, SIN envelope), R7 = mixer (B tono only)
 123+ 6D47 21 4D 6D         LD HL, .beepRegs
 124+ 6D4A C3 52 6D         JP _AY_WriteRegPairs                ; tail call: EI + RET
 125+ 6D4D
 126+ 6D4D              .beepRegs:
 127+ 6D4D 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 128+ 6D4F 07 3D            DEFB  7, $3D          ; mixer (B tono on, A/C off, noise off)
 129+ 6D51 FF               DEFB $FF              ; sentinel
 130+ 6D52
 131+ 6D52              ; ==============================================================================
 132+ 6D52              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 133+ 6D52              ; ==============================================================================
 134+ 6D52              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 135+ 6D52              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 136+ 6D52              ; ==============================================================================
 137+ 6D52              _AY_WriteRegPairs:
 138+ 6D52 7E               LD A, (HL)
 139+ 6D53 FE FF            CP $FF
 140+ 6D55 28 0D            JR Z, .awrpDone
 141+ 6D57 06 FF            LD B, $FF
 142+ 6D59 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 143+ 6D5B 23               INC HL
 144+ 6D5C 06 BF            LD B, $BF
 145+ 6D5E 7E               LD A, (HL)
 146+ 6D5F ED 79            OUT (C), A                          ; AY data ($BFFD)
 147+ 6D61 23               INC HL
 148+ 6D62 18 EE            JR _AY_WriteRegPairs
 149+ 6D64              .awrpDone:
 150+ 6D64 FB               EI
 151+ 6D65 C9               RET
 152+ 6D66
 153+ 6D66              ; ==============================================================================
 154+ 6D66              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave
 155+ 6D66              ; ==============================================================================
 156+ 6D66              ; Llamar cada frame desde MainLoop. No-op si sweep inactivo (frames=0).
 157+ 6D66              ; Destruye: A, BC, DE, HL.
 158+ 6D66              ; ==============================================================================
 159+ 6D66              AY_UpdatePlayerHit:
 160+ 6D66 3A F5 6C         LD A, (PlayerHitFrames)
 161+ 6D69 B7               OR A
 162+ 6D6A 28 2C            JR Z, .uphCheckBeep
 163+ 6D6C 3D               DEC A
 164+ 6D6D 32 F5 6C         LD (PlayerHitFrames), A
 165+ 6D70 28 30            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 166+ 6D72
 167+ 6D72 2A F6 6C         LD HL, (PlayerHitPeriod)
 168+ 6D75 ED 5B F8 6C      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 169+ 6D79 19               ADD HL, DE
 170+ 6D7A 22 F6 6C         LD (PlayerHitPeriod), HL
 171+ 6D7D
 172+ 6D7D                  ; Escribir R2 = L, R3 = H (period B)
 173+ 6D7D F3               DI
 174+ 6D7E 0E FD            LD C, $FD
 175+ 6D80 3E 02            LD A, 2
 176+ 6D82 06 FF            LD B, $FF
 177+ 6D84 ED 79            OUT (C), A
 178+ 6D86 7D               LD A, L
 179+ 6D87 06 BF            LD B, $BF
 180+ 6D89 ED 79            OUT (C), A
 181+ 6D8B 3E 03            LD A, 3
 182+ 6D8D 06 FF            LD B, $FF
 183+ 6D8F ED 79            OUT (C), A
 184+ 6D91 7C               LD A, H
 185+ 6D92 06 BF            LD B, $BF
 186+ 6D94 ED 79            OUT (C), A
 187+ 6D96 FB               EI
 188+ 6D97 C9               RET
 189+ 6D98
 190+ 6D98              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 191+ 6D98              .uphCheckBeep:
 192+ 6D98 3A FA 6C         LD A, (BeepDurationFrames)
 193+ 6D9B B7               OR A
 194+ 6D9C C8               RET Z
 195+ 6D9D 3D               DEC A
 196+ 6D9E 32 FA 6C         LD (BeepDurationFrames), A
 197+ 6DA1 C0               RET NZ
 198+ 6DA2                  ; fall-through al cutoff compartido
 199+ 6DA2
 200+ 6DA2              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Beeper-style. ---
 201+ 6DA2              ; Llamado al final del sweep (PlayerHit/Death) y al final del beep.
 202+ 6DA2              _uphMuteR9:
 203+ 6DA2 F3               DI
 204+ 6DA3 01 FD FF         LD BC, $FFFD
 205+ 6DA6 3E 09            LD A, 9
 206+ 6DA8 ED 79            OUT (C), A
 207+ 6DAA 01 FD BF         LD BC, $BFFD
 208+ 6DAD AF               XOR A
 209+ 6DAE ED 79            OUT (C), A
 210+ 6DB0 FB               EI
 211+ 6DB1 C9               RET
 212+ 6DB2
# file closed: sfx_player_hit_ay.asm
 124  6DB2
 125  6DB2                  ; --- Random pickups: Give routines (random_pickups.asm) ---
 126  6DB2                  ; GiveLife / GiveHealth / GiveStamina. Cold path (solo al recoger pickup
 127  6DB2                  ; random life/health/stamina). HUD se refresca solo cada frame.
 128  6DB2                  INCLUDE "random_pickups.asm"
# file opened: random_pickups.asm
   1+ 6DB2              ; ==============================================================================
   2+ 6DB2              ; RANDOM PICKUPS — rutinas Give (slot 1, cold path)
   3+ 6DB2              ; ==============================================================================
   4+ 6DB2              ; Sistema: cada plantilla puede llevar hasta RANDOM_SLOT_MAX placements con id
   5+ 6DB2              ; RANDOM_SLOT_MARKER (210). Al entrar a una sala se elige un slot via RNG y se
   6+ 6DB2              ; rolea su contenido (life / health / stamina / nada) por probabilidad. El
   7+ 6DB2              ; pickup elegido aparece en pantalla; al recogerlo se llama a la Give
   8+ 6DB2              ; correspondiente desde CheckPickupCollect.
   9+ 6DB2              ;
  10+ 6DB2              ; Las Give routines tambien cubren placements explicitos de life/health/stamina
  11+ 6DB2              ; si en el futuro se ponen pickups fijos en el editor.
  12+ 6DB2              ;
  13+ 6DB2              ; Vive en slot 1 (cold path): solo se invoca al recoger un pickup raro.
  14+ 6DB2              ; Bank 0/2 quedan limpios.
  15+ 6DB2              ; ==============================================================================
  16+ 6DB2
  17+ 6DB2              ; ==============================================================================
  18+ 6DB2              ; GiveLife - +1 vida, clamp a PLAYER_LIVES_MAX
  19+ 6DB2              ; ==============================================================================
  20+ 6DB2              ; HUD se refresca solo: DrawLivesHUD se llama cada frame en MainLoop y detecta
  21+ 6DB2              ; el cambio via cache .dlhLast.
  22+ 6DB2              ; ==============================================================================
  23+ 6DB2              GiveLife:
  24+ 6DB2 3A 70 82         LD A, (PlayerLives)
  25+ 6DB5 FE 05            CP PLAYER_LIVES_MAX
  26+ 6DB7 D0               RET NC                              ; ya en max (>= MAX) -> no-op
  27+ 6DB8 3C               INC A
  28+ 6DB9 32 70 82         LD (PlayerLives), A
  29+ 6DBC C9               RET
  30+ 6DBD
  31+ 6DBD              ; ==============================================================================
  32+ 6DBD              ; GiveHealth - +PICKUP_HEALTH_AMT, clamp a HEALTH_MAX
  33+ 6DBD              ; ==============================================================================
  34+ 6DBD              ; HUD se refresca solo via DrawHealthStaminaHUD (lee PlayerHealth cada frame).
  35+ 6DBD              ; ==============================================================================
  36+ 6DBD              GiveHealth:
  37+ 6DBD 3A 38 B6         LD A, (PlayerHealth)
  38+ 6DC0 C6 08            ADD A, PICKUP_HEALTH_AMT
  39+ 6DC2 38 04            JR C, .ghCap                        ; overflow 8-bit -> definitivo cap
  40+ 6DC4 FE 11            CP HEALTH_MAX + 1
  41+ 6DC6 38 02            JR C, .ghStore                      ; A <= HEALTH_MAX
  42+ 6DC8              .ghCap:
  43+ 6DC8 3E 10            LD A, HEALTH_MAX
  44+ 6DCA              .ghStore:
  45+ 6DCA 32 38 B6         LD (PlayerHealth), A
  46+ 6DCD C9               RET
  47+ 6DCE
  48+ 6DCE              ; ==============================================================================
  49+ 6DCE              ; GiveStamina - +PICKUP_STAMINA_AMT, clamp a STAMINA_MAX
  50+ 6DCE              ; ==============================================================================
  51+ 6DCE              GiveStamina:
  52+ 6DCE 3A 39 B6         LD A, (PlayerStamina)
  53+ 6DD1 C6 08            ADD A, PICKUP_STAMINA_AMT
  54+ 6DD3 38 04            JR C, .gsCap
  55+ 6DD5 FE 11            CP STAMINA_MAX + 1
  56+ 6DD7 38 02            JR C, .gsStore
  57+ 6DD9              .gsCap:
  58+ 6DD9 3E 10            LD A, STAMINA_MAX
  59+ 6DDB              .gsStore:
  60+ 6DDB 32 39 B6         LD (PlayerStamina), A
  61+ 6DDE C9               RET
  62+ 6DDF
  63+ 6DDF              ; ==============================================================================
  64+ 6DDF              ; UpdateRandomPickup - room-enter hook
  65+ 6DDF              ; ==============================================================================
  66+ 6DDF              ; Llamado por MainLoop entre CheckScreenTransition y DrawScreen, cada frame.
  67+ 6DDF              ; Early-out si ScreenDirty=0 (no transition).
  68+ 6DDF              ;
  69+ 6DDF              ; En transition:
  70+ 6DDF              ;   1. Recorre el BG stream de la sala actual (CurrentScreenAddr) buscando
  71+ 6DDF              ;      placements id=RANDOM_SLOT_MARKER. Acumula (charX, charY) en RandomSlotList.
  72+ 6DDF              ;   2. Si count > 0: RNG slot, RNG tipo. Si tipo != none, rellena
  73+ 6DDF              ;      RandomSyntheticEntry con la pickup elegida en la posicion del slot.
  74+ 6DDF              ;      Si tipo == none o count == 0, marca inactiva ($FE).
  75+ 6DDF              ;
  76+ 6DDF              ; Buffer format (CurrentScreenAddr → CurrentScreenBuffer): entries de 4 bytes
  77+ 6DDF              ; fijos (id, charX, charY, v) terminados con id=$FF.
  78+ 6DDF              ;
  79+ 6DDF              ; Destruye AF, BC, DE, HL.
  80+ 6DDF              ; ==============================================================================
  81+ 6DDF              UpdateRandomPickup:
  82+ 6DDF 3A A2 82         LD A, (ScreenDirty)
  83+ 6DE2 B7               OR A
  84+ 6DE3 C8               RET Z
  85+ 6DE4
  86+ 6DE4                  ; --- Default: synthetic entry inactiva (sera reactivada si roll spawneara) ---
  87+ 6DE4 3E FE            LD A, $FE
  88+ 6DE6 32 B4 5F         LD (RandomSynthMapX), A
  89+ 6DE9
  90+ 6DE9                  ; --- Scan BG stream, build SlotList ---
  91+ 6DE9 AF               XOR A
  92+ 6DEA 32 AB 5F         LD (RandomSlotCount), A
  93+ 6DED 2A 9C 82         LD HL, (CurrentScreenAddr)
  94+ 6DF0              .urpScanLoop:
  95+ 6DF0 7E               LD A, (HL)                          ; A = id
  96+ 6DF1 FE FF            CP $FF
  97+ 6DF3 28 2A            JR Z, .urpScanDone
  98+ 6DF5 FE D2            CP RANDOM_SLOT_MARKER
  99+ 6DF7 20 20            JR NZ, .urpSkipEntry
 100+ 6DF9                  ; Es marker. Cap reached?
 101+ 6DF9 3A AB 5F         LD A, (RandomSlotCount)
 102+ 6DFC FE 04            CP RANDOM_SLOT_MAX
 103+ 6DFE 30 19            JR NC, .urpSkipEntry
 104+ 6E00                  ; SlotList[count*2] = charX, [count*2+1] = charY
 105+ 6E00 23               INC HL                              ; HL @ charX
 106+ 6E01 46               LD B, (HL)                          ; B = charX
 107+ 6E02 23               INC HL                              ; HL @ charY
 108+ 6E03 4E               LD C, (HL)                          ; C = charY
 109+ 6E04 E5               PUSH HL                             ; save HL @ charY
 110+ 6E05 87               ADD A, A                            ; A = count*2
 111+ 6E06 6F               LD L, A
 112+ 6E07 26 00            LD H, 0
 113+ 6E09 11 AC 5F         LD DE, RandomSlotList
 114+ 6E0C 19               ADD HL, DE
 115+ 6E0D 70               LD (HL), B                          ; charX
 116+ 6E0E 23               INC HL
 117+ 6E0F 71               LD (HL), C                          ; charY
 118+ 6E10 21 AB 5F         LD HL, RandomSlotCount
 119+ 6E13 34               INC (HL)
 120+ 6E14 E1               POP HL                              ; HL @ charY
 121+ 6E15 23               INC HL                              ; HL @ v
 122+ 6E16 23               INC HL                              ; HL @ next id
 123+ 6E17 18 D7            JR .urpScanLoop
 124+ 6E19              .urpSkipEntry:
 125+ 6E19                  ; Skip entry: 4 bytes (id, charX, charY, v).
 126+ 6E19 23               INC HL
 126+ 6E1A 23             INC HL
 126+ 6E1B 23             INC HL
 126+ 6E1C 23             INC HL
 127+ 6E1D 18 D1            JR .urpScanLoop
 128+ 6E1F              .urpScanDone:
 129+ 6E1F
 130+ 6E1F                  ; --- count == 0 -> nada que hacer ---
 131+ 6E1F 3A AB 5F         LD A, (RandomSlotCount)
 132+ 6E22 B7               OR A
 133+ 6E23 C8               RET Z
 134+ 6E24
 135+ 6E24                  ; --- Pick slot via R mod count ---
 136+ 6E24 47               LD B, A                             ; B = count
 137+ 6E25 ED 5F            LD A, R
 138+ 6E27              .urpModLoop:
 139+ 6E27 90               SUB B
 140+ 6E28 30 FD            JR NC, .urpModLoop
 141+ 6E2A 80               ADD A, B                            ; A = R mod count, [0..count-1]
 142+ 6E2B
 143+ 6E2B                  ; --- Read SlotList[A*2] = (charX, charY) ---
 144+ 6E2B 87               ADD A, A
 145+ 6E2C 5F               LD E, A
 146+ 6E2D 16 00            LD D, 0
 147+ 6E2F 21 AC 5F         LD HL, RandomSlotList
 148+ 6E32 19               ADD HL, DE
 149+ 6E33 7E               LD A, (HL)                          ; charX
 150+ 6E34 32 B8 5F         LD (RandomSynthCharX), A
 151+ 6E37 23               INC HL
 152+ 6E38 7E               LD A, (HL)                          ; charY
 153+ 6E39 32 B9 5F         LD (RandomSynthCharY), A
 154+ 6E3C
 155+ 6E3C                  ; --- Roll type usando R XOR SYS_FRAMES ---
 156+ 6E3C ED 5F            LD A, R
 157+ 6E3E 21 78 5C         LD HL, $5C78
 158+ 6E41 AE               XOR (HL)
 159+ 6E42 FE 14            CP PROB_LIFE_END
 160+ 6E44 38 09            JR C, .urpDoLife
 161+ 6E46 FE 3C            CP PROB_HEALTH_END
 162+ 6E48 38 0A            JR C, .urpDoHealth
 163+ 6E4A FE 64            CP PROB_STAMINA_END
 164+ 6E4C 38 0B            JR C, .urpDoStamina
 165+ 6E4E C9               RET                                 ; tipo nada, RandomSynthMapX ya esta a $FE
 166+ 6E4F              .urpDoLife:
 167+ 6E4F 21 68 CC         LD HL, BgGfx_life
 168+ 6E52 18 08            JR .urpActivate
 169+ 6E54              .urpDoHealth:
 170+ 6E54 21 4D EE         LD HL, BgGfx_health_pickup
 171+ 6E57 18 03            JR .urpActivate
 172+ 6E59              .urpDoStamina:
 173+ 6E59 21 76 EE         LD HL, BgGfx_stamina_pickup
 174+ 6E5C              .urpActivate:
 175+ 6E5C 22 B6 5F         LD (RandomSynthPtr), HL             ; ptr al sprite elegido
 176+ 6E5F 3A 9A 82         LD A, (CurrentScreenX)
 177+ 6E62 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
 178+ 6E65 3A 9B 82         LD A, (CurrentScreenY)
 179+ 6E68 32 B5 5F         LD (RandomSynthMapY), A
 180+ 6E6B 3E FF            LD A, $FF
