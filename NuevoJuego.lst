 465+ 68C7              ; ==============================================================================
 466+ 68C7              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 467+ 68C7              ; ==============================================================================
 468+ 68C7              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 469+ 68C7              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 470+ 68C7              ; OUT: -
 471+ 68C7              ; Destruye: AF, BC, DE, HL, IX.
 472+ 68C7              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 473+ 68C7              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 474+ 68C7              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 475+ 68C7              ; ==============================================================================
 476+ 68C7              DrawBgSpriteByIdAtChar:
 477+ 68C7 B7               OR A
 478+ 68C8 C8               RET Z                                   ; id 0 = no sprite, salir
 479+ 68C9 C5               PUSH BC
