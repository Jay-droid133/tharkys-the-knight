 351  F042                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ F042              ; ==============================================================================
   2+ F042              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ F042              ; ==============================================================================
   4+ F042              ; CurrentObjective vive en variables.asm. Valor:
   5+ F042              ;   0..8 = hito que el jugador esta buscando ahora mismo (1..9 humano)
   6+ F042              ;   9    = todos los hitos completados (juego ganado)
   7+ F042              ;
   8+ F042              ; ----------------------------------------------------------------------------
   9+ F042              ; MilestoneTable: 9 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ F042              ;   tipo 1 (PICKUP)  -> ref es key id 1..6 (ver KeyLockTable). Avanza al
  11+ F042              ;                       recoger el sprite cuyo behavior coincide.
  12+ F042              ;   tipo 2 (TRIGGER) -> ref es action id de BumpTriggerTable
  13+ F042              ;                       (1=townhall, 2=churchdoor, futuro 3=towngate).
  14+ F042              ;                       Avanza al disparar el trigger correspondiente.
  15+ F042              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  16+ F042              ;
  17+ F042              ; MilestoneResolveTable: 9 x 2 bytes {tipo, ref} - regla de RESOLUCION
  18+ F042              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  19+ F042              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  20+ F042              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  21+ F042              ;   - Hito 9 (SPECIAL para advance): se resuelve como TRIGGER action 3
  22+ F042              ;     (puerta sur, sin trigger todavia -> $FF, $FF hasta que exista).
  23+ F042              ;
  24+ F042              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre,
  25+ F042              ; util para probar la cadena entera mientras los hitos 7 y 9 no tienen
  26+ F042              ; mecanica real.
  27+ F042              ; ==============================================================================
  28+ F042
  29+ F042              MILESTONE_TYPE_PICKUP   EQU 1
  30+ F042              MILESTONE_TYPE_TRIGGER  EQU 2
  31+ F042              MILESTONE_TYPE_SPECIAL  EQU 3
  32+ F042
  33+ F042              MilestoneTable:
  34+ F042 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  35+ F044 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  36+ F046 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  37+ F048 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  38+ F04A 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  39+ F04C 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  40+ F04E 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (stub: tecla M)
  41+ F050 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 llave de la puerta sur (dinamica)
  42+ F052 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 puerta sur (cutscene final)
  43+ F054
  44+ F054              MilestoneResolveTable:
  45+ F054 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  46+ F056 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  47+ F058 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  48+ F05A 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  49+ F05C 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  50+ F05E 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  51+ F060 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  52+ F062 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #8 south gate key
  53+ F064 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #9 south door (sin trigger todavia)
  54+ F066
  55+ F066              ; ==============================================================================
  56+ F066              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  57+ F066              ; ==============================================================================
  58+ F066              ; IN:  A = key id (1..6) recien recogida
  59+ F066              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  60+ F066              ; ==============================================================================
  61+ F066              CheckMilestonePickup:
  62+ F066 E5               PUSH HL
  63+ F067 D5               PUSH DE
  64+ F068 C5               PUSH BC
  65+ F069 F5               PUSH AF
  66+ F06A 47               LD B, A                             ; B = key id recibida
  67+ F06B 3A 5A 82         LD A, (CurrentObjective)
  68+ F06E FE 09            CP 9
  69+ F070 30 21            JR NC, .cmpDone                     ; sin hitos pendientes
  70+ F072 87               ADD A, A                            ; *2 (entry size)
  71+ F073 6F               LD L, A
  72+ F074 26 00            LD H, 0
  73+ F076 11 42 F0         LD DE, MilestoneTable
  74+ F079 19               ADD HL, DE
  75+ F07A 7E               LD A, (HL)                          ; tipo
  76+ F07B FE 01            CP MILESTONE_TYPE_PICKUP
  77+ F07D 20 14            JR NZ, .cmpDone
  78+ F07F 23               INC HL
  79+ F080 7E               LD A, (HL)                          ; ref esperada
  80+ F081 B8               CP B
  81+ F082 20 0F            JR NZ, .cmpDone
  82+ F084 3A 5A 82         LD A, (CurrentObjective)
  83+ F087 3C               INC A
  84+ F088 32 5A 82         LD (CurrentObjective), A
  85+ F08B CD 1A F1         CALL ResolveObjectiveScreen
  86+ F08E 3E FF            LD A, $FF
  87+ F090 32 5D 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
  88+ F093              .cmpDone:
  89+ F093 F1               POP AF
  90+ F094 C1               POP BC
  91+ F095 D1               POP DE
  92+ F096 E1               POP HL
  93+ F097 C9               RET
  94+ F098
  95+ F098              ; ==============================================================================
  96+ F098              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
  97+ F098              ; ==============================================================================
  98+ F098              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
  99+ F098              ; Preserva: AF, BC, DE, HL.
 100+ F098              ; ==============================================================================
 101+ F098              CheckMilestoneTrigger:
 102+ F098 E5               PUSH HL
 103+ F099 D5               PUSH DE
 104+ F09A C5               PUSH BC
 105+ F09B F5               PUSH AF
 106+ F09C 47               LD B, A
 107+ F09D 3A 5A 82         LD A, (CurrentObjective)
 108+ F0A0 FE 09            CP 9
 109+ F0A2 30 21            JR NC, .cmtDone
 110+ F0A4 87               ADD A, A
 111+ F0A5 6F               LD L, A
 112+ F0A6 26 00            LD H, 0
 113+ F0A8 11 42 F0         LD DE, MilestoneTable
 114+ F0AB 19               ADD HL, DE
 115+ F0AC 7E               LD A, (HL)
 116+ F0AD FE 02            CP MILESTONE_TYPE_TRIGGER
 117+ F0AF 20 14            JR NZ, .cmtDone
 118+ F0B1 23               INC HL
 119+ F0B2 7E               LD A, (HL)
 120+ F0B3 B8               CP B
 121+ F0B4 20 0F            JR NZ, .cmtDone
 122+ F0B6 3A 5A 82         LD A, (CurrentObjective)
 123+ F0B9 3C               INC A
 124+ F0BA 32 5A 82         LD (CurrentObjective), A
 125+ F0BD CD 1A F1         CALL ResolveObjectiveScreen
 126+ F0C0 3E FF            LD A, $FF
 127+ F0C2 32 5D 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 128+ F0C5              .cmtDone:
 129+ F0C5 F1               POP AF
 130+ F0C6 C1               POP BC
 131+ F0C7 D1               POP DE
 132+ F0C8 E1               POP HL
 133+ F0C9 C9               RET
 134+ F0CA
 135+ F0CA              ; ==============================================================================
 136+ F0CA              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 137+ F0CA              ; ==============================================================================
 138+ F0CA              CheckMilestoneDebugKey:
 139+ F0CA 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 140+ F0CC DB FE            IN A, ($FE)
 141+ F0CE CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 142+ F0D0 20 1D            JR NZ, .cmdkNotPressed
 143+ F0D2 3A F4 F0         LD A, (MilestoneKeyDebounce)
 144+ F0D5 B7               OR A
 145+ F0D6 C0               RET NZ
 146+ F0D7 3E 01            LD A, 1
 147+ F0D9 32 F4 F0         LD (MilestoneKeyDebounce), A
 148+ F0DC 3A 5A 82         LD A, (CurrentObjective)
 149+ F0DF FE 09            CP 9
 150+ F0E1 D0               RET NC
 151+ F0E2 3C               INC A
 152+ F0E3 32 5A 82         LD (CurrentObjective), A
 153+ F0E6 CD 1A F1         CALL ResolveObjectiveScreen
 154+ F0E9 3E FF            LD A, $FF
 155+ F0EB 32 5D 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 156+ F0EE C9               RET
 157+ F0EF              .cmdkNotPressed:
 158+ F0EF AF               XOR A
 159+ F0F0 32 F4 F0         LD (MilestoneKeyDebounce), A
 160+ F0F3 C9               RET
 161+ F0F4
 162+ F0F4 00           MilestoneKeyDebounce: DEFB 0
 163+ F0F5
 164+ F0F5              ; ==============================================================================
 165+ F0F5              ; CheckCurrentKeyCycleKey - Tecla K: cicla CurrentKey 0->1->...->6->0 (debug)
 166+ F0F5              ; ==============================================================================
 167+ F0F5              ; Para probar cerraduras / triggers sin tener que jugar la cadena entera.
 168+ F0F5              ; El HUD de llave (DrawKeyHUD) ya lee CurrentKey cada frame -> feedback
 169+ F0F5              ; inmediato del valor actual.
 170+ F0F5              ; ==============================================================================
 171+ F0F5              CheckCurrentKeyCycleKey:
 172+ F0F5 3E BF            LD A, $BF                           ; semi-fila ENTER-L-K-J-H
 173+ F0F7 DB FE            IN A, ($FE)
 174+ F0F9 CB 57            BIT 2, A                            ; K = bit 2 (0 = pulsada)
 175+ F0FB 20 17            JR NZ, .ckcNotPressed
 176+ F0FD 3A 19 F1         LD A, (CurrentKeyCycleDebounce)
 177+ F100 B7               OR A
 178+ F101 C0               RET NZ
 179+ F102 3E 01            LD A, 1
 180+ F104 32 19 F1         LD (CurrentKeyCycleDebounce), A
 181+ F107 3A 52 82         LD A, (CurrentKey)
 182+ F10A 3C               INC A
 183+ F10B FE 07            CP 7
 184+ F10D 38 01            JR C, .ckcSet                       ; 1..6 dentro de rango
 185+ F10F AF               XOR A                               ; 7 -> wrap a 0
 186+ F110              .ckcSet:
 187+ F110 32 52 82         LD (CurrentKey), A
 188+ F113 C9               RET
 189+ F114              .ckcNotPressed:
 190+ F114 AF               XOR A
 191+ F115 32 19 F1         LD (CurrentKeyCycleDebounce), A
 192+ F118 C9               RET
 193+ F119
 194+ F119 00           CurrentKeyCycleDebounce: DEFB 0
 195+ F11A
 196+ F11A              ; ==============================================================================
 197+ F11A              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 198+ F11A              ; ==============================================================================
 199+ F11A              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 200+ F11A              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 201+ F11A              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 202+ F11A              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 203+ F11A              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 204+ F11A              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 205+ F11A              ;               actuales; queda como salvaguarda.
 206+ F11A              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 207+ F11A              ; Destruye: AF, BC, DE, HL.
 208+ F11A              ; ==============================================================================
 209+ F11A              ResolveObjectiveScreen:
 210+ F11A 3A 5A 82         LD A, (CurrentObjective)
 211+ F11D FE 09            CP 9
 212+ F11F 30 2F            JR NC, .rosNoTarget
 213+ F121 87               ADD A, A
 214+ F122 6F               LD L, A
 215+ F123 26 00            LD H, 0
 216+ F125 11 54 F0         LD DE, MilestoneResolveTable
 217+ F128 19               ADD HL, DE
 218+ F129 7E               LD A, (HL)                          ; tipo
 219+ F12A 23               INC HL
 220+ F12B 46               LD B, (HL)                          ; B = ref
 221+ F12C FE 01            CP MILESTONE_TYPE_PICKUP
 222+ F12E 28 06            JR Z, .rosPickup
 223+ F130 FE 02            CP MILESTONE_TYPE_TRIGGER
 224+ F132 28 08            JR Z, .rosTrigger
 225+ F134 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 226+ F136              .rosPickup:
 227+ F136 78               LD A, B
 228+ F137 CD 59 F1         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 229+ F13A 18 08            JR .rosFindPos
 230+ F13C              .rosTrigger:
 231+ F13C 78               LD A, B
 232+ F13D CD 66 F1         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 233+ F140 7A               LD A, D
 234+ F141 B3               OR E
 235+ F142 28 0C            JR Z, .rosNoTarget
 236+ F144              .rosFindPos:
 237+ F144 CD 81 F1         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 238+ F147 78               LD A, B
 239+ F148 32 5B 82         LD (ObjectiveScreenX), A
 240+ F14B 79               LD A, C
 241+ F14C 32 5C 82         LD (ObjectiveScreenY), A
 242+ F14F C9               RET
 243+ F150              .rosNoTarget:
 244+ F150 3E FF            LD A, $FF
 245+ F152 32 5B 82         LD (ObjectiveScreenX), A
 246+ F155 32 5C 82         LD (ObjectiveScreenY), A
 247+ F158 C9               RET
 248+ F159
 249+ F159              ; ==============================================================================
 250+ F159              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 251+ F159              ; ==============================================================================
 252+ F159              ; IN:  A = key id (1..6)
 253+ F159              ; OUT: DE = ptr
 254+ F159              ; Destruye: AF, HL.
 255+ F159              ; ==============================================================================
 256+ F159              KeyIdToPtr:
 257+ F159 3D               DEC A
 258+ F15A 87               ADD A, A                            ; *2 (DEFW size)
 259+ F15B 6F               LD L, A
 260+ F15C 26 00            LD H, 0
 261+ F15E 11 2C D9         LD DE, KeyLockTable
 262+ F161 19               ADD HL, DE
 263+ F162 5E               LD E, (HL)
 264+ F163 23               INC HL
 265+ F164 56               LD D, (HL)
 266+ F165 C9               RET
 267+ F166
 268+ F166              ; ==============================================================================
 269+ F166              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 270+ F166              ; ==============================================================================
 271+ F166              ; IN:  A = action id (1, 2, ...)
 272+ F166              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 273+ F166              ;      Z flag set si no encontrado.
 274+ F166              ; Destruye: AF, BC, HL.
 275+ F166              ; ==============================================================================
 276+ F166              ActionToTriggerPtr:
 277+ F166 4F               LD C, A                             ; C = action id buscada
 278+ F167 21 BA D9         LD HL, BumpTriggerTable
 279+ F16A              .attLoop:
 280+ F16A 5E               LD E, (HL)
 281+ F16B 23               INC HL
 282+ F16C 56               LD D, (HL)
 283+ F16D 23               INC HL                              ; HL -> required_key
 284+ F16E 7A               LD A, D
 285+ F16F B3               OR E
 286+ F170 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 287+ F172 23               INC HL                              ; HL -> action
 288+ F173 7E               LD A, (HL)
 289+ F174 23               INC HL                              ; HL -> next entry
 290+ F175 B9               CP C
 291+ F176 20 F2            JR NZ, .attLoop
 292+ F178 F6 01            OR 1                                ; clear Z (encontrado)
 293+ F17A C9               RET
 294+ F17B              .attNotFound:
 295+ F17B 16 00            LD D, 0
 296+ F17D 1E 00            LD E, 0
 297+ F17F AF               XOR A                               ; set Z
 298+ F180 C9               RET
 299+ F181
 300+ F181              ; ==============================================================================
 301+ F181              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 302+ F181              ; ==============================================================================
 303+ F181              ; PickupTable layout (per-entry, 7 bytes):
 304+ F181              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 305+ F181              ; Terminator: $FF (single byte).
 306+ F181              ;
 307+ F181              ; IN:  DE = ptr a buscar
 308+ F181              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 309+ F181              ;      B = C = $FF si no encontrado (Z).
 310+ F181              ; Destruye: AF, HL. Preserva DE.
 311+ F181              ; ==============================================================================
 312+ F181              FindPickupScreen:
 313+ F181 21 F9 E0         LD HL, PickupTable
 314+ F184              .fpsLoop:
 315+ F184 7E               LD A, (HL)
 316+ F185 FE FF            CP $FF
 317+ F187 28 1C            JR Z, .fpsNotFound
 318+ F189 E5               PUSH HL
 319+ F18A 23               INC HL                              ; -> mapY
 320+ F18B 23               INC HL                              ; -> ptr_lo
 321+ F18C 7E               LD A, (HL)
 322+ F18D BB               CP E
 323+ F18E 20 0C            JR NZ, .fpsNoMatch
 324+ F190 23               INC HL                              ; -> ptr_hi
 325+ F191 7E               LD A, (HL)
 326+ F192 BA               CP D
 327+ F193 20 07            JR NZ, .fpsNoMatch
 328+ F195 E1               POP HL                              ; back to entry start (mapX)
 329+ F196 46               LD B, (HL)                          ; B = mapX
 330+ F197 23               INC HL
 331+ F198 4E               LD C, (HL)                          ; C = mapY
 332+ F199 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 333+ F19B C9               RET
 334+ F19C              .fpsNoMatch:
 335+ F19C E1               POP HL
 336+ F19D C5               PUSH BC
 337+ F19E 01 07 00         LD BC, 7
 338+ F1A1 09               ADD HL, BC
 339+ F1A2 C1               POP BC
 340+ F1A3 18 DF            JR .fpsLoop
 341+ F1A5              .fpsNotFound:
 342+ F1A5 06 FF            LD B, $FF
 343+ F1A7 0E FF            LD C, $FF
 344+ F1A9 AF               XOR A                               ; set Z
 345+ F1AA C9               RET
 346+ F1AB
 347+ F1AB              ; ==============================================================================
 348+ F1AB              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 349+ F1AB              ; ==============================================================================
 350+ F1AB              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 351+ F1AB              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 352+ F1AB              ; third). El brujula se redibuja solo cuando:
 353+ F1AB              ;   - cambias de pantalla (LastCompassScreen != Current)
 354+ F1AB              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 355+ F1AB              ; En reposo es un no-op barato (solo unas comparaciones).
 356+ F1AB              ;
 357+ F1AB              ; Color (atributo de las 4 celdas):
 358+ F1AB              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 359+ F1AB              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 360+ F1AB              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 361+ F1AB              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 362+ F1AB              ;
 363+ F1AB              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 364+ F1AB              ; ==============================================================================
 365+ F1AB
 366+ F1AB              COMPASS_COL     EQU 24
 367+ F1AB              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 368+ F1AB
 369+ F1AB              ; ==============================================================================
 370+ F1AB              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 371+ F1AB              ; ==============================================================================
 372+ F1AB              DrawCompass:
 373+ F1AB                  ; Sin objetivo resuelto -> limpiar y salir
 374+ F1AB 3A 5B 82         LD A, (ObjectiveScreenX)
 375+ F1AE FE FF            CP $FF
 376+ F1B0 CA F7 F2         JP Z, ClearCompass
 377+ F1B3
 378+ F1B3                  ; Necesita redraw? screen cambio, PrevDist == $FF, o wobble activo.
 379+ F1B3 3A 9A 82         LD A, (CurrentScreenX)
 380+ F1B6 47               LD B, A
 381+ F1B7 3A 5E 82         LD A, (LastCompassScreenX)
 382+ F1BA B8               CP B
 383+ F1BB 20 16            JR NZ, .dcRedraw
 384+ F1BD 3A 9B 82         LD A, (CurrentScreenY)
 385+ F1C0 47               LD B, A
 386+ F1C1 3A 5F 82         LD A, (LastCompassScreenY)
 387+ F1C4 B8               CP B
 388+ F1C5 20 0C            JR NZ, .dcRedraw
 389+ F1C7 3A 5D 82         LD A, (PreviousObjectiveDistance)
 390+ F1CA FE FF            CP $FF
 391+ F1CC 28 05            JR Z, .dcRedraw
 392+ F1CE 3A 60 82         LD A, (CompassWobbleCounter)
 393+ F1D1 B7               OR A
 394+ F1D2 C8               RET Z                               ; sin cambios y sin wobble -> nada
 395+ F1D3
 396+ F1D3              .dcRedraw:
 397+ F1D3                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 398+ F1D3 3A 5B 82         LD A, (ObjectiveScreenX)
 399+ F1D6 47               LD B, A
 400+ F1D7 3A 9A 82         LD A, (CurrentScreenX)
 401+ F1DA 4F               LD C, A
 402+ F1DB 78               LD A, B
 403+ F1DC 91               SUB C                               ; A = dx (signed)
 404+ F1DD                  ; abs(dx) -> H, sign(dx)+1 -> L
 405+ F1DD F2 E7 F1         JP P, .dcDxNonNeg
 406+ F1E0 ED 44            NEG
 407+ F1E2 67               LD H, A                             ; abs(dx)
 408+ F1E3 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 409+ F1E5 18 0A            JR .dcDxDone
 410+ F1E7              .dcDxNonNeg:
 411+ F1E7 67               LD H, A
 412+ F1E8 B7               OR A
 413+ F1E9 20 04            JR NZ, .dcDxPositive
 414+ F1EB 2E 01            LD L, 1                             ; dx == 0
 415+ F1ED 18 02            JR .dcDxDone
 416+ F1EF              .dcDxPositive:
 417+ F1EF 2E 02            LD L, 2
 418+ F1F1              .dcDxDone:
 419+ F1F1 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 420+ F1F2
 421+ F1F2                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 422+ F1F2 3A 5C 82         LD A, (ObjectiveScreenY)
 423+ F1F5 47               LD B, A
 424+ F1F6 3A 9B 82         LD A, (CurrentScreenY)
 425+ F1F9 4F               LD C, A
 426+ F1FA 78               LD A, B
 427+ F1FB 91               SUB C
 428+ F1FC F2 06 F2         JP P, .dcDyNonNeg
 429+ F1FF ED 44            NEG
 430+ F201 67               LD H, A
 431+ F202 2E 00            LD L, 0
 432+ F204 18 0A            JR .dcDyDone
 433+ F206              .dcDyNonNeg:
 434+ F206 67               LD H, A
 435+ F207 B7               OR A
 436+ F208 20 04            JR NZ, .dcDyPositive
 437+ F20A 2E 01            LD L, 1
 438+ F20C 18 02            JR .dcDyDone
 439+ F20E              .dcDyPositive:
 440+ F20E 2E 02            LD L, 2
 441+ F210              .dcDyDone:
 442+ F210                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 443+ F210 D1               POP DE                              ; D = abs_dx, E = signdx+1
 444+ F211                  ; idx = (signdy+1)*3 + (signdx+1)
 445+ F211 7D               LD A, L
 446+ F212 87               ADD A, A
 447+ F213 85               ADD A, L                            ; A = (signdy+1)*3
 448+ F214 83               ADD A, E                            ; A = idx (0..8)
 449+ F215 32 C4 F2         LD (.dcSpriteIdx), A
 450+ F218                  ; distance = abs_dx + abs_dy
 451+ F218 7A               LD A, D
 452+ F219 84               ADD A, H
 453+ F21A 32 C5 F2         LD (.dcDistance), A
 454+ F21D
 455+ F21D                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 456+ F21D                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 457+ F21D                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 458+ F21D                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 459+ F21D                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 460+ F21D                  ; nuevo idx.
 461+ F21D                  ; Counter == 0 -> sin override, idx = target.
 462+ F21D                  ; Para velocidades mayores ya no se puede ir mas rapido. Para ralentizar:
 463+ F21D                  ;   LD A, 18 + SRL A (1x)         -> 18 frames, 2 fr/fase
 464+ F21D                  ;   LD A, 36 + SRL A : SRL A (2x) -> 36 frames, 4 fr/fase
 465+ F21D 3A C4 F2         LD A, (.dcSpriteIdx)
 466+ F220 FE 04            CP 4
 467+ F222 20 06            JR NZ, .dcWobbleNotX
 468+ F224                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 469+ F224                  ; frame no redibuje innecesariamente.
 470+ F224 AF               XOR A
 471+ F225 32 60 82         LD (CompassWobbleCounter), A
 472+ F228 18 46            JR .dcWobbleEnd
 473+ F22A              .dcWobbleNotX:
 474+ F22A                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 475+ F22A 3A 9A 82         LD A, (CurrentScreenX)
 476+ F22D 47               LD B, A
 477+ F22E 3A 5E 82         LD A, (LastCompassScreenX)
 478+ F231 B8               CP B
 479+ F232 20 0A            JR NZ, .dcWobbleStart
 480+ F234 3A 9B 82         LD A, (CurrentScreenY)
 481+ F237 47               LD B, A
 482+ F238 3A 5F 82         LD A, (LastCompassScreenY)
 483+ F23B B8               CP B
 484+ F23C 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 485+ F23E              .dcWobbleStart:
 486+ F23E 3E 09            LD A, 9
 487+ F240 32 60 82         LD (CompassWobbleCounter), A
 488+ F243              .dcWobbleResolve:
 489+ F243 3A 60 82         LD A, (CompassWobbleCounter)
 490+ F246 B7               OR A
 491+ F247 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 492+ F249 3D               DEC A
 493+ F24A 32 60 82         LD (CompassWobbleCounter), A
 494+ F24D                                                      ; A = phase 0..8 (1 frame por fase)
 495+ F24D 21 1D F7         LD HL, WobblePhaseTable
 496+ F250 5F               LD E, A
 497+ F251 16 00            LD D, 0
 498+ F253 19               ADD HL, DE
 499+ F254 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 500+ F255 FE 02            CP 2
 501+ F257 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 502+ F259                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 503+ F259                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 504+ F259 FE 03            CP 3
 505+ F25B 38 01            JR C, .dcWobbleOffsetReady
 506+ F25D 3D               DEC A
 507+ F25E              .dcWobbleOffsetReady:
 508+ F25E 5F               LD E, A
 509+ F25F 3A C4 F2         LD A, (.dcSpriteIdx)
 510+ F262 87               ADD A, A                            ; idx*2
 511+ F263 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 512+ F264 83               ADD A, E                            ; +offset
 513+ F265 21 F9 F6         LD HL, CompassWobbleTable
 514+ F268 5F               LD E, A
 515+ F269 16 00            LD D, 0
 516+ F26B 19               ADD HL, DE
 517+ F26C 7E               LD A, (HL)
 518+ F26D 32 C4 F2         LD (.dcSpriteIdx), A                ; override
 519+ F270
 520+ F270              .dcWobbleEnd:
 521+ F270
 522+ F270                  ; --- Color ---
 523+ F270                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 524+ F270 3A C4 F2         LD A, (.dcSpriteIdx)
 525+ F273 FE 04            CP 4
 526+ F275 28 18            JR Z, .dcWhite
 527+ F277 3A 5D 82         LD A, (PreviousObjectiveDistance)
 528+ F27A FE FF            CP $FF
 529+ F27C 28 11            JR Z, .dcWhite
 530+ F27E 47               LD B, A
 531+ F27F 3A C5 F2         LD A, (.dcDistance)
 532+ F282 B8               CP B
 533+ F283 28 0A            JR Z, .dcWhite                      ; igual = blanco
 534+ F285 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 535+ F287 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 536+ F289 18 06            JR .dcColorDone
 537+ F28B              .dcGreen:
 538+ F28B 3E 44            LD A, GREEN | $40
 539+ F28D 18 02            JR .dcColorDone
 540+ F28F              .dcWhite:
 541+ F28F 3E 47            LD A, WHITE | $40
 542+ F291              .dcColorDone:
 543+ F291 32 C6 F2         LD (.dcAttr), A
 544+ F294
 545+ F294                  ; --- Sprite ptr de CompassSprites[idx] ---
 546+ F294 3A C4 F2         LD A, (.dcSpriteIdx)
 547+ F297 87               ADD A, A                            ; *2
 548+ F298 6F               LD L, A
 549+ F299 26 00            LD H, 0
 550+ F29B 11 E7 F6         LD DE, CompassSprites
 551+ F29E 19               ADD HL, DE
 552+ F29F 5E               LD E, (HL)
 553+ F2A0 23               INC HL
 554+ F2A1 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 555+ F2A2 CD C7 F2         CALL DrawCompassSprite
 556+ F2A5
 557+ F2A5                  ; --- Attrs ---
 558+ F2A5 3A C6 F2         LD A, (.dcAttr)
 559+ F2A8 CD EA F2         CALL SetCompassAttrs
 560+ F2AB
 561+ F2AB                  ; --- Cachear estado ---
 562+ F2AB                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 563+ F2AB                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 564+ F2AB                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 565+ F2AB                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 566+ F2AB                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 567+ F2AB                  ; el wobble y la comparacion sigue siendo correcta.
 568+ F2AB 3A 60 82         LD A, (CompassWobbleCounter)
 569+ F2AE B7               OR A
 570+ F2AF 20 06            JR NZ, .dcSkipPrevDistSave
 571+ F2B1 3A C5 F2         LD A, (.dcDistance)
 572+ F2B4 32 5D 82         LD (PreviousObjectiveDistance), A
 573+ F2B7              .dcSkipPrevDistSave:
 574+ F2B7 3A 9A 82         LD A, (CurrentScreenX)
 575+ F2BA 32 5E 82         LD (LastCompassScreenX), A
 576+ F2BD 3A 9B 82         LD A, (CurrentScreenY)
 577+ F2C0 32 5F 82         LD (LastCompassScreenY), A
 578+ F2C3 C9               RET
 579+ F2C4
 580+ F2C4 00           .dcSpriteIdx: DEFB 0
 581+ F2C5 00           .dcDistance:  DEFB 0
 582+ F2C6 00           .dcAttr:      DEFB 0
 583+ F2C7
 584+ F2C7              ; ==============================================================================
 585+ F2C7              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 586+ F2C7              ; ==============================================================================
 587+ F2C7              ; IN: DE = ptr a 16 filas x 2 bytes
 588+ F2C7              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 589+ F2C7              ; Destruye: AF, B, HL.
 590+ F2C7              ; ==============================================================================
 591+ F2C7              DrawCompassSprite:
 592+ F2C7                  ; Char row 0 (rows 0-7 del sprite)
 593+ F2C7 26 40            LD H, $40
 594+ F2C9 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 595+ F2CB 06 08            LD B, 8
 596+ F2CD              .dcsRow0:
 597+ F2CD 1A               LD A, (DE)
 598+ F2CE 77               LD (HL), A
 599+ F2CF 13               INC DE
 600+ F2D0 23               INC HL
 601+ F2D1 1A               LD A, (DE)
 602+ F2D2 77               LD (HL), A
 603+ F2D3 13               INC DE
 604+ F2D4 2B               DEC HL
 605+ F2D5 24               INC H
 606+ F2D6 10 F5            DJNZ .dcsRow0
 607+ F2D8                  ; Char row 1 (rows 8-15 del sprite)
 608+ F2D8 26 40            LD H, $40
 609+ F2DA 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 610+ F2DC 06 08            LD B, 8
 611+ F2DE              .dcsRow1:
 612+ F2DE 1A               LD A, (DE)
 613+ F2DF 77               LD (HL), A
 614+ F2E0 13               INC DE
 615+ F2E1 23               INC HL
 616+ F2E2 1A               LD A, (DE)
 617+ F2E3 77               LD (HL), A
 618+ F2E4 13               INC DE
 619+ F2E5 2B               DEC HL
 620+ F2E6 24               INC H
 621+ F2E7 10 F5            DJNZ .dcsRow1
 622+ F2E9 C9               RET
 623+ F2EA
 624+ F2EA              ; ==============================================================================
 625+ F2EA              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 626+ F2EA              ; ==============================================================================
 627+ F2EA              SetCompassAttrs:
 628+ F2EA 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 629+ F2ED 77               LD (HL), A
 630+ F2EE 23               INC HL
 631+ F2EF 77               LD (HL), A
 632+ F2F0 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 633+ F2F3 77               LD (HL), A
 634+ F2F4 23               INC HL
 635+ F2F5 77               LD (HL), A
 636+ F2F6 C9               RET
 637+ F2F7
 638+ F2F7              ; ==============================================================================
 639+ F2F7              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 640+ F2F7              ; ==============================================================================
 641+ F2F7              ClearCompass:
 642+ F2F7 26 40            LD H, $40
 643+ F2F9 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 644+ F2FB 06 08            LD B, 8
 645+ F2FD AF               XOR A
 646+ F2FE              .ccRow0:
 647+ F2FE 77               LD (HL), A
 648+ F2FF 23               INC HL
 649+ F300 77               LD (HL), A
 650+ F301 2B               DEC HL
 651+ F302 24               INC H
 652+ F303 10 F9            DJNZ .ccRow0
 653+ F305 26 40            LD H, $40
 654+ F307 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 655+ F309 06 08            LD B, 8
 656+ F30B AF               XOR A
 657+ F30C              .ccRow1:
 658+ F30C 77               LD (HL), A
 659+ F30D 23               INC HL
 660+ F30E 77               LD (HL), A
 661+ F30F 2B               DEC HL
 662+ F310 24               INC H
 663+ F311 10 F9            DJNZ .ccRow1
 664+ F313 AF               XOR A                               ; attr 0 (negro/negro, invisible)
 665+ F314 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 666+ F317 77               LD (HL), A
 667+ F318 23               INC HL
 668+ F319 77               LD (HL), A
 669+ F31A 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 670+ F31D 77               LD (HL), A
 671+ F31E 23               INC HL
 672+ F31F 77               LD (HL), A
 673+ F320 C9               RET
 674+ F321
 675+ F321              ; ==============================================================================
 676+ F321              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 677+ F321              ; ==============================================================================
 678+ F321              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 679+ F321              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 680+ F321              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 681+ F321              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 682+ F321              ; monstruo cae alli con la puerta abierta:
 683+ F321              ;   - Bit slot en MonsterTrappedFlags
 684+ F321              ;   - Despawn del monstruo (puff)
 685+ F321              ;   - Puerta se re-cierra (sprite + flag)
 686+ F321              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 687+ F321              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 688+ F321              ;
 689+ F321              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 690+ F321              ; auto-generadas por el level editor segun la posicion de la puerta y los
 691+ F321              ; markers AltKey1/AltKey2.
 692+ F321              ; ==============================================================================
 693+ F321
 694+ F321              ; ==============================================================================
 695+ F321              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 696+ F321              ; ==============================================================================
 697+ F321              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 698+ F321              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 699+ F321              ; Destruye: AF, BC.
 700+ F321              ; ==============================================================================
 701+ F321              CheckChurchTrap:
 702+ F321                  ; --- Solo en pantalla de la iglesia ---
 703+ F321 3A 9A 82         LD A, (CurrentScreenX)
 704+ F324 FE 0F            CP CHURCH_TRAP_SCREEN_X
 705+ F326 20 5D            JR NZ, .cctNoTrap
 706+ F328 3A 9B 82         LD A, (CurrentScreenY)
 707+ F32B FE 06            CP CHURCH_TRAP_SCREEN_Y
 708+ F32D 20 56            JR NZ, .cctNoTrap
 709+ F32F                  ; --- Solo con la puerta abierta ---
 710+ F32F 3A 55 82         LD A, (ChurchDoorOpen)
 711+ F332 B7               OR A
 712+ F333 28 50            JR Z, .cctNoTrap
 713+ F335                  ; --- Solo si el knockback es DIRECTO del player ---
 714+ F335                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 715+ F335                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 716+ F335                  ; espada y se clear cuando se hereda kb por colision.
 717+ F335 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 718+ F339 28 4A            JR Z, .cctNoTrap
 719+ F33B                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 720+ F33B                  ; (acepta sprites de 16, 21 o 24 px de alto)
 721+ F33B DD 7E 04         LD A, (IX+ENT_POSY)
 722+ F33E CB 3F            SRL A
 723+ F340 CB 3F            SRL A
 724+ F342 CB 3F            SRL A                                   ; A = top charY del monster
 725+ F344 47               LD B, A
 726+ F345 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 727+ F347 90               SUB B                                   ; A = trap_charY - mon_charY
 728+ F348 FE 03            CP 3
 729+ F34A 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 730+ F34C                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 731+ F34C DD 7E 03         LD A, (IX+ENT_POSX)
 732+ F34F CB 3F            SRL A
 733+ F351 CB 3F            SRL A
 734+ F353 CB 3F            SRL A
 735+ F355 47               LD B, A                                 ; B = left charX del monster
 736+ F356 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 737+ F358 3C               INC A                                   ; A = LO_X + 1
 738+ F359 90               SUB B                                   ; A = LO_X+1 - charX
 739+ F35A FE 03            CP 3
 740+ F35C 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 741+ F35E                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 742+ F35E                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 743+ F35E DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 744+ F361 D6 4C            SUB SPRID_MONSTER_0
 745+ F363 CB 3F            SRL A
 746+ F365 CB 3F            SRL A
 747+ F367 CB 3F            SRL A                                   ; A = type idx 0..2
 748+ F369 47               LD B, A
 749+ F36A                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 750+ F36A 3A 62 82         LD A, (NextChurchTrapStep)
 751+ F36D FE 03            CP 3
 752+ F36F 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 753+ F371 21 87 F3         LD HL, ChurchTrapOrderTable
 754+ F374 5F               LD E, A
 755+ F375 16 00            LD D, 0
 756+ F377 19               ADD HL, DE
 757+ F378 7E               LD A, (HL)                              ; A = type esperado
 758+ F379 B8               CP B
 759+ F37A 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 760+ F37C                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 761+ F37C CD 1F F4         CALL TriggerChurchTrap
 762+ F37F 3E 01            LD A, 1
 763+ F381 C9               RET
 764+ F382              .cctBlockAsWall:
 765+ F382                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 766+ F382                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 767+ F382 3E 02            LD A, 2
 768+ F384 C9               RET
 769+ F385              .cctNoTrap:
 770+ F385 AF               XOR A
 771+ F386 C9               RET
 772+ F387
 773+ F387              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 774+ F387              ChurchTrapOrderTable:
 775+ F387 00 02 01         DEFB 0, 2, 1
 776+ F38A
 777+ F38A              ; ==============================================================================
 778+ F38A              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 779+ F38A              ; blanco brillante sobre paper negro ($47).
 780+ F38A              ; ==============================================================================
 781+ F38A              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 782+ F38A              ; - No-op fuera de la sala de la iglesia.
 783+ F38A              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 784+ F38A              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 785+ F38A              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 786+ F38A              ;   aun no toca) conservan sus attrs originales del sprite.
 787+ F38A              ; Destruye: AF, BC, DE, HL.
 788+ F38A              ; ==============================================================================
 789+ F38A              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 790+ F38A              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 791+ F38A              HighlightExpectedStatue:
 792+ F38A 3E 47            LD A, $47
 793+ F38C 18 00            JR PaintExpectedStatueAttr
 794+ F38E
 795+ F38E              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 796+ F38E              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 797+ F38E              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 798+ F38E              PaintExpectedStatueAttr:
 799+ F38E 32 F8 F3         LD (.hesAttr), A
 800+ F391                  ; --- Solo en la sala de la iglesia ---
 801+ F391 3A 9A 82         LD A, (CurrentScreenX)
 802+ F394 FE 0F            CP CHURCH_TRAP_SCREEN_X
 803+ F396 C0               RET NZ
 804+ F397 3A 9B 82         LD A, (CurrentScreenY)
 805+ F39A FE 06            CP CHURCH_TRAP_SCREEN_Y
 806+ F39C C0               RET NZ
 807+ F39D                  ; --- Solo tras abrir la iglesia 1a vez ---
 808+ F39D                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 809+ F39D                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 810+ F39D                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 811+ F39D                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 812+ F39D                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 813+ F39D 3A 56 82         LD A, (ChurchEverOpened)
 814+ F3A0 B7               OR A
 815+ F3A1 C8               RET Z
 816+ F3A2                  ; --- Solo si quedan monstruos por atrapar ---
 817+ F3A2 3A 62 82         LD A, (NextChurchTrapStep)
 818+ F3A5 FE 03            CP 3
 819+ F3A7 D0               RET NC
 820+ F3A8                  ; --- Type esperado -> statue id ---
 821+ F3A8 21 87 F3         LD HL, ChurchTrapOrderTable
 822+ F3AB 5F               LD E, A
 823+ F3AC 16 00            LD D, 0
 824+ F3AE 19               ADD HL, DE
 825+ F3AF 7E               LD A, (HL)                              ; type idx esperado
 826+ F3B0 21 61 67         LD HL, StatueIdTable
 827+ F3B3 5F               LD E, A
 828+ F3B4 16 00            LD D, 0
 829+ F3B6 19               ADD HL, DE
 830+ F3B7 7E               LD A, (HL)                              ; A = statue id
 831+ F3B8 B7               OR A
 832+ F3B9 C8               RET Z
 833+ F3BA 32 F9 F3         LD (.hesTargetId), A
 834+ F3BD                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 835+ F3BD 2A 9C 82         LD HL, (CurrentScreenAddr)
 836+ F3C0              .hesLoop:
 837+ F3C0 7E               LD A, (HL)
 838+ F3C1 FE FF            CP $FF
 839+ F3C3 C8               RET Z                                   ; estatua no en esta sala
 840+ F3C4 47               LD B, A
 841+ F3C5 3A F9 F3         LD A, (.hesTargetId)
 842+ F3C8 B8               CP B
 843+ F3C9 28 06            JR Z, .hesFound
 844+ F3CB 11 04 00         LD DE, 4
 845+ F3CE 19               ADD HL, DE
 846+ F3CF 18 EF            JR .hesLoop
 847+ F3D1              .hesFound:
 848+ F3D1 23               INC HL
 849+ F3D2 7E               LD A, (HL)                              ; charX
 850+ F3D3 47               LD B, A
 851+ F3D4 23               INC HL
 852+ F3D5 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 853+ F3D6 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 854+ F3D8 4F               LD C, A                                 ; C = charY (post-HUD)
 855+ F3D9                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 856+ F3D9 26 00            LD H, 0
 857+ F3DB 69               LD L, C
 858+ F3DC 29               ADD HL, HL
 859+ F3DD 29               ADD HL, HL
 860+ F3DE 29               ADD HL, HL
 861+ F3DF 29               ADD HL, HL
 862+ F3E0 29               ADD HL, HL                              ; HL = charY * 32
 863+ F3E1 58               LD E, B
 864+ F3E2 16 00            LD D, 0
 865+ F3E4 19               ADD HL, DE                              ; + charX
 866+ F3E5 11 00 58         LD DE, $5800
 867+ F3E8 19               ADD HL, DE                              ; HL = attr addr top-left
 868+ F3E9                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 869+ F3E9                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 870+ F3E9                  ; no hace falta sincronizar CleanAttrMap.
 871+ F3E9 3A F8 F3         LD A, (.hesAttr)
 872+ F3EC 06 03            LD B, 3                                 ; 3 filas de chars
 873+ F3EE              .hesRow:
 874+ F3EE 77               LD (HL), A
 875+ F3EF 23               INC HL
 876+ F3F0 77               LD (HL), A                              ; (charX+1)
 877+ F3F1 11 1F 00         LD DE, 31
 878+ F3F4 19               ADD HL, DE                              ; siguiente fila col 0
 879+ F3F5 10 F7            DJNZ .hesRow
 880+ F3F7 C9               RET
 881+ F3F8 00           .hesAttr:     DEFB 0
 882+ F3F9 00           .hesTargetId: DEFB 0
 883+ F3FA
 884+ F3FA              ; ==============================================================================
 885+ F3FA              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 886+ F3FA              ; ==============================================================================
 887+ F3FA              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 888+ F3FA              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 889+ F3FA              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 890+ F3FA              ; + ON final settle): 8 ciclos de ON-OFF en total.
 891+ F3FA              ; ==============================================================================
 892+ F3FA              STATUE_BLINK_FRAMES   EQU 32
 893+ F3FA
 894+ F3FA              StartStatueBlink:
 895+ F3FA                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 896+ F3FA                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 897+ F3FA                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 898+ F3FA                  ; (caso A), .cbtActChurchDoor (caso B).
 899+ F3FA 3E 20            LD A, STATUE_BLINK_FRAMES
 900+ F3FC 32 63 82         LD (StatueBlinkCounter), A
 901+ F3FF C3 8A F3         JP HighlightExpectedStatue              ; initial ON paint
 902+ F402
 903+ F402              UpdateStatueBlink:
 904+ F402                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 905+ F402 3A 63 82         LD A, (StatueBlinkCounter)
 906+ F405 B7               OR A
 907+ F406 C8               RET Z
 908+ F407 3D               DEC A
 909+ F408 32 63 82         LD (StatueBlinkCounter), A
 910+ F40B 20 03            JR NZ, .usbInProgress
 911+ F40D                  ; Counter recien llego a 0: settle ON
 912+ F40D C3 8A F3         JP HighlightExpectedStatue
 913+ F410              .usbInProgress:
 914+ F410                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 915+ F410                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 916+ F410 CB 3F            SRL A
 917+ F412 E6 01            AND $01
 918+ F414 28 05            JR Z, .usbOff
 919+ F416 3E 47            LD A, $47
 920+ F418 C3 8E F3         JP PaintExpectedStatueAttr
 921+ F41B              .usbOff:
 922+ F41B AF               XOR A
 923+ F41C C3 8E F3         JP PaintExpectedStatueAttr
 924+ F41F
 925+ F41F              ; ==============================================================================
 926+ F41F              ; CUTSCENE - parametros ajustables
 927+ F41F              ; ==============================================================================
 928+ F41F              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 929+ F41F              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 930+ F41F              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 931+ F41F              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 932+ F41F
 933+ F41F              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 934+ F41F              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 935+ F41F              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 936+ F41F
 937+ F41F              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
 938+ F41F              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
 939+ F41F              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
 940+ F41F              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
 941+ F41F              ;   tick 12 -> erase smoke[2], pasar a DONE
 942+ F41F              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
 943+ F41F              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
 944+ F41F
 945+ F41F              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
 946+ F41F              ; base del vano (auto-derivada por el editor). El monster (3 chars de
 947+ F41F              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
 948+ F41F              ; centrado dentro del vano de la puerta.
 949+ F41F              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
 950+ F41F              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
 951+ F41F              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
 952+ F41F              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
 953+ F41F
 954+ F41F              ; ==============================================================================
 955+ F41F              ; TriggerChurchTrap - arranca la cutscene de la iglesia
 956+ F41F              ; ==============================================================================
 957+ F41F              ; IN: IX = monster atrapado.
 958+ F41F              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
 959+ F41F              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
 960+ F41F              ; en ApplyChurchTrapEffects al final del cutscene.
 961+ F41F              ; ==============================================================================
 962+ F41F              TriggerChurchTrap:
 963+ F41F                  ; --- 1. Calcular slot 0..2 ---
 964+ F41F DD E5            PUSH IX
 965+ F421 E1               POP HL
 966+ F422 11 4F 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 967+ F425 B7               OR A
 968+ F426 ED 52            SBC HL, DE
 969+ F428 CB 3D            SRL L
 970+ F42A CB 3D            SRL L
 971+ F42C CB 3D            SRL L
 972+ F42E CB 3D            SRL L                                   ; L = slot 0..2
 973+ F430 7D               LD A, L
 974+ F431 32 9E 5F         LD (ChurchCutsceneSlot), A
 975+ F434                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
 976+ F434 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 977+ F437 D6 4C            SUB SPRID_MONSTER_0
 978+ F439 CB 3F            SRL A
 979+ F43B CB 3F            SRL A
 980+ F43D CB 3F            SRL A                                   ; A = type idx
 981+ F43F 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
 982+ F442                  ; --- 2. Mover monster al centro del vano ---
 983+ F442 3E 78            LD A, CHURCH_TRAP_AREA_POSX
 984+ F444 DD 77 03         LD (IX+ENT_POSX), A
 985+ F447 3E 58            LD A, CHURCH_TRAP_AREA_POSY
 986+ F449 DD 77 04         LD (IX+ENT_POSY), A
 987+ F44C DD 36 06 00      LD (IX+ENT_DELTAX), 0
 988+ F450 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 989+ F454 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
 990+ F458                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
 991+ F458                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
 992+ F458                  ; del shake y del humo se renderizarian invisibles (ink black sobre
 993+ F458                  ; paper black). Forzando ON aqui garantizamos que la animacion de
 994+ F458                  ; temblor se vea con ink blanco brillante sobre paper negro.
 995+ F458 AF               XOR A
 996+ F459 32 63 82         LD (StatueBlinkCounter), A              ; parar blink
 997+ F45C DD E5            PUSH IX
 998+ F45E CD 8A F3         CALL HighlightExpectedStatue            ; pintar $47
 999+ F461                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1000+ F461                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1001+ F461                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1002+ F461                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1003+ F461 CD E1 BD         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1004+ F464 3E FF            LD A, $FF
1005+ F466 CD F2 9C         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1006+ F469 DD E1            POP IX
1007+ F46B                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1008+ F46B 3E 01            LD A, 1
1009+ F46D 32 66 82         LD (ChurchCutscenePhase), A
1010+ F470 AF               XOR A
1011+ F471 32 9D 5F         LD (ChurchCutsceneFrame), A
1012+ F474 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1013+ F476 32 A4 5F         LD (ChurchCutsceneLookCount), A
1014+ F479 C9               RET
1015+ F47A
1016+ F47A              ; ==============================================================================
1017+ F47A              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1018+ F47A              ; ==============================================================================
1019+ F47A              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1020+ F47A              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1021+ F47A              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1022+ F47A              ; ==============================================================================
1023+ F47A              UpdateChurchCutscene:
1024+ F47A 3A 66 82         LD A, (ChurchCutscenePhase)
1025+ F47D B7               OR A
1026+ F47E C8               RET Z
1027+ F47F 3D               DEC A
1028+ F480 28 12            JR Z, .ucsLookPhase
1029+ F482 3D               DEC A
1030+ F483 28 38            JR Z, .ucsShakeStatuePhase
1031+ F485 3D               DEC A
1032+ F486 CA 0F F5         JP Z, .ucsSmokePhase
1033+ F489                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1034+ F489 CD CC 66         CALL ApplyChurchTrapDone
1035+ F48C AF               XOR A
1036+ F48D 32 66 82         LD (ChurchCutscenePhase), A
1037+ F490 32 9D 5F         LD (ChurchCutsceneFrame), A
1038+ F493 C9               RET
1039+ F494
1040+ F494              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1041+ F494              .ucsLookPhase:
1042+ F494                  ; Frame counter (para detectar fin de fase)
1043+ F494 21 9D 5F         LD HL, ChurchCutsceneFrame
1044+ F497 34               INC (HL)
1045+ F498                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1046+ F498 21 A4 5F         LD HL, ChurchCutsceneLookCount
1047+ F49B 35               DEC (HL)
1048+ F49C 20 06            JR NZ, .ucsLookCheckEnd
1049+ F49E 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1050+ F4A0 77               LD (HL), A
1051+ F4A1 CD 5D F5         CALL ChurchCutsceneToggleMonsterDir
1052+ F4A4              .ucsLookCheckEnd:
1053+ F4A4 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1054+ F4A7 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1055+ F4A9 D8               RET C                                   ; sigue mirando
1056+ F4AA                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1057+ F4AA                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1058+ F4AA                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1059+ F4AA CD A8 66         CALL EraseChurchTrappedMonster
1060+ F4AD CD 57 69         CALL CloseChurchDoor
1061+ F4B0 CD 82 F5         CALL ChurchCutsceneInitStatueShake
1062+ F4B3 3E 02            LD A, 2
1063+ F4B5 32 66 82         LD (ChurchCutscenePhase), A
1064+ F4B8 AF               XOR A
1065+ F4B9 32 9D 5F         LD (ChurchCutsceneFrame), A
1066+ F4BC C9               RET
1067+ F4BD
1068+ F4BD              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1069+ F4BD              .ucsShakeStatuePhase:
1070+ F4BD 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1071+ F4C0 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1072+ F4C2 30 35            JR NC, .ucsShakeStatueDone
1073+ F4C4                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1074+ F4C4                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1075+ F4C4                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1076+ F4C4                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1077+ F4C4                  ;
1078+ F4C4                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1079+ F4C4                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1080+ F4C4 ED 5F            LD A, R
1081+ F4C6 E6 03            AND $03
1082+ F4C8 21 F5 F4         LD HL, .ucsShakeJitterTable
1083+ F4CB 5F               LD E, A
1084+ F4CC 16 00            LD D, 0
1085+ F4CE 19               ADD HL, DE
1086+ F4CF 7E               LD A, (HL)
1087+ F4D0 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1088+ F4D1                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1089+ F4D1 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1090+ F4D4 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1091+ F4D6 21 61 67         LD HL, StatueIdTable
1092+ F4D9 38 03            JR C, .ucsShakeTablePicked
1093+ F4DB 21 64 67         LD HL, StatueBrokenIdTable
1094+ F4DE              .ucsShakeTablePicked:
1095+ F4DE 78               LD A, B                                 ; restore jitter para la llamada
1096+ F4DF CD EC F5         CALL ChurchCutsceneShakeStatueByteShift
1097+ F4E2                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1098+ F4E2                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1099+ F4E2                  ; y al salir de la fase forzamos borde a negro explicitamente.
1100+ F4E2 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1101+ F4E5 E6 01            AND $01
