 300+ E390              ; ==============================================================================
 301+ E390              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 302+ E390              ; ==============================================================================
 303+ E390              ; Entrada: A = attr original
 304+ E390              ; Salida:  A = attr transformado
 305+ E390              ; Preserva: HL, DE, BC, IX
 306+ E390              ; ==============================================================================
 307+ E390              ApplyDayCycleRemap:
 308+ E390 E5               PUSH HL
 309+ E391 67               LD H, A                     ; H = attr (temp save)
 310+ E392                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 311+ E392 3A 2E E2         LD A, (BgSpriteSkipRemap)
 312+ E395 B7               OR A
 313+ E396 20 06            JR NZ, .skipRemap
 314+ E398 3A 28 E2         LD A, (CurrentTimeOfDay)
 315+ E39B B7               OR A
 316+ E39C 20 03            JR NZ, .doRemap
 317+ E39E              .skipRemap:
 318+ E39E 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 319+ E39F E1               POP HL
 320+ E3A0 C9               RET
 321+ E3A1
 322+ E3A1              .doRemap:
 323+ E3A1 D5               PUSH DE
 324+ E3A2 C5               PUSH BC
 325+ E3A3
 326+ E3A3 7C               LD A, H                     ; A = attr original
 327+ E3A4 4F               LD C, A                     ; C = attr original
 328+ E3A5
 329+ E3A5                  ; Guardar flash + ink (bits 7, 2-0)
 330+ E3A5 E6 87            AND $87                     ; A = F000_0III
 331+ E3A7 47               LD B, A                     ; B = flash | ink
 332+ E3A8
 333+ E3A8                  ; Extraer paper+bright como indice 0-15
 334+ E3A8 79               LD A, C
 335+ E3A9 E6 78            AND $78                     ; A = 0BPPP000
 336+ E3AB 0F               RRCA
 337+ E3AC 0F               RRCA
 338+ E3AD 0F               RRCA                        ; A = 0000BPPP = indice
 339+ E3AE
 340+ E3AE                  ; Elegir tabla segun tipo de sprite
 341+ E3AE 5F               LD E, A
 342+ E3AF 16 00            LD D, 0
 343+ E3B1 3A 2D E2         LD A, (BgSpriteIsHouse)
 344+ E3B4 B7               OR A
 345+ E3B5 28 05            JR Z, .useStdTable
 346+ E3B7 2A 2B E2         LD HL, (CurrentHouseRemapTable)
 347+ E3BA 18 03            JR .doLookup
 348+ E3BC              .useStdTable:
 349+ E3BC 2A 29 E2         LD HL, (CurrentRemapTable)
 350+ E3BF              .doLookup:
 351+ E3BF 19               ADD HL, DE
 352+ E3C0 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 353+ E3C1
 354+ E3C1                  ; Reconstruir atributo
 355+ E3C1 07               RLCA
 356+ E3C2 07               RLCA
 357+ E3C3 07               RLCA                        ; A = 0BPPP000
 358+ E3C4 B0               OR B                        ; A = FBPPPIII
 359+ E3C5
 360+ E3C5 C1               POP BC
 361+ E3C6 D1               POP DE
 362+ E3C7 E1               POP HL
 363+ E3C8 C9               RET
 364+ E3C9
 365+ E3C9              ; ==============================================================================
 366+ E3C9              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 367+ E3C9              ; ==============================================================================
 368+ E3C9              ; Entrada: A = sprite ID
 369+ E3C9              ; Setea BgSpriteIsHouse (0 o 1)
 370+ E3C9              ; Preserva: A, DE, IX
 371+ E3C9              ;
 372+ E3C9              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 373+ E3C9              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 374+ E3C9              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 375+ E3C9              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 376+ E3C9              ; ==============================================================================
 377+ E3C9              CheckIfHouseSprite:
 378+ E3C9 F5               PUSH AF
 379+ E3CA E5               PUSH HL
 380+ E3CB C5               PUSH BC
 381+ E3CC
 382+ E3CC 47               LD B, A                     ; B = id buscado
