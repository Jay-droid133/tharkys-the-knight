7076+ C659              ; --- CheckDeathTouchPlayer: AABB completo 24x24 vs player (no margen) ---
7077+ C659              ; Si overlap: PlayerHealth=0, erase sprite, despawn.
7078+ C659              CheckDeathTouchPlayer:
7079+ C659 3A FD 82         LD A, (DeathSpawned)
7080+ C65C B7               OR A
7081+ C65D C8               RET Z
7082+ C65E DD 21 4E 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7083+ C662 DD 7E 01         LD A, (IX+ENT_TYPE)
7084+ C665 B7               OR A
7085+ C666 C8               RET Z
7086+ C667                  ; Invulnerable SOLO durante el countdown phase 1 (sin control). NO durante
7087+ C667                  ; phase 2 (grace post-respawn O post-nasty-hit) — la phase 2 se setea tambien
7088+ C667                  ; al recibir un hit de nasty (EnterGracePhase desde .pHpDmgNotZero), y eso
7089+ C667                  ; daba 1s en el que Death te seguia pegada sin matarte. Death es instakill
7090+ C667                  ; sin importar inmunidades temporales. En el path post-respawn legitimo,
7091+ C667                  ; SilentKillDeath ya la despawneo, asi que no hay riesgo de instakill al
7092+ C667                  ; recuperar control.
7093+ C667 3A EE 82         LD A, (PlayerRespawnPhase)
7094+ C66A FE 01            CP 1
7095+ C66C C8               RET Z
