4527+ BBC6 38 44            JR C, .spawnBlocked                 ; |dx| < 24 AND |dy| < 24 → demasiado cerca
4528+ BBC8              .spPlayerOk:
4529+ BBC8                  ; Min-distance check vs otras nasties activas (32 px en cualquier eje).
4530+ BBC8                  ; Sin esto, dos nasties pueden spawnear pegadas y solaparse visualmente.
4531+ BBC8 DD E5            PUSH IX
4532+ BBCA E1               POP HL                              ; HL = ptr al slot que estamos spawneando
4533+ BBCB FD 21 4C 81      LD IY, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4534+ BBCF 06 04            LD B, NUM_NASTIES
4535+ BBD1              .spDistLoop:
4536+ BBD1 C5               PUSH BC
4537+ BBD2 E5               PUSH HL
4538+ BBD3 FD E5            PUSH IY
4539+ BBD5 D1               POP DE                              ; DE = ptr al slot vecino
4540+ BBD6 B7               OR A
4541+ BBD7 ED 52            SBC HL, DE                          ; HL == 0 → mismo slot, skip
4542+ BBD9 E1               POP HL
4543+ BBDA 28 25            JR Z, .spDistNext
4544+ BBDC FD 7E 01         LD A, (IY+ENT_TYPE)
