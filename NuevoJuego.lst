 196+ E978              ; ==============================================================================
 197+ E978              ; ResolveObjectiveScreen - Calcula (sx, sy) del hito actual y la cachea
 198+ E978              ; ==============================================================================
 199+ E978              ; Lee MilestoneResolveTable[CurrentObjective] -> {tipo, ref}, traduce a un
 200+ E978              ; ptr de sprite, y busca su (mapX, mapY) en PickupTable.
 201+ E978              ;   PICKUP   -> ptr via KeyLockTable[ref-1]
 202+ E978              ;   TRIGGER  -> ptr via scan de BumpTriggerTable por action=ref
 203+ E978              ;   SPECIAL  -> no resuelto ($FF, $FF). El resolver no debe ver SPECIAL aqui
 204+ E978              ;               porque MilestoneResolveTable no usa SPECIAL para los hitos
 205+ E978              ;               actuales; queda como salvaguarda.
 206+ E978              ; Salida: ObjectiveScreenX/Y = (mapX, mapY) o $FF si no resuelto.
 207+ E978              ; Destruye: AF, BC, DE, HL.
 208+ E978              ; ==============================================================================
 209+ E978              ResolveObjectiveScreen:
 210+ E978 3A 2F 82         LD A, (CurrentObjective)
 211+ E97B FE 09            CP 9
 212+ E97D 30 2F            JR NC, .rosNoTarget
 213+ E97F 87               ADD A, A
 214+ E980 6F               LD L, A
 215+ E981 26 00            LD H, 0
 216+ E983 11 B2 E8         LD DE, MilestoneResolveTable
 217+ E986 19               ADD HL, DE
 218+ E987 7E               LD A, (HL)                          ; tipo
 219+ E988 23               INC HL
 220+ E989 46               LD B, (HL)                          ; B = ref
 221+ E98A FE 01            CP MILESTONE_TYPE_PICKUP
 222+ E98C 28 06            JR Z, .rosPickup
 223+ E98E FE 02            CP MILESTONE_TYPE_TRIGGER
 224+ E990 28 08            JR Z, .rosTrigger
 225+ E992 18 1A            JR .rosNoTarget                     ; SPECIAL u otro: sin coords
 226+ E994              .rosPickup:
 227+ E994 78               LD A, B
 228+ E995 CD B7 E9         CALL KeyIdToPtr                     ; DE = ptr del sprite key
 229+ E998 18 08            JR .rosFindPos
 230+ E99A              .rosTrigger:
 231+ E99A 78               LD A, B
 232+ E99B CD C4 E9         CALL ActionToTriggerPtr             ; DE = ptr (0 si no encontrado)
 233+ E99E 7A               LD A, D
 234+ E99F B3               OR E
 235+ E9A0 28 0C            JR Z, .rosNoTarget
 236+ E9A2              .rosFindPos:
 237+ E9A2 CD DF E9         CALL FindPickupScreen               ; B = mapX, C = mapY (o $FF, $FF)
 238+ E9A5 78               LD A, B
 239+ E9A6 32 30 82         LD (ObjectiveScreenX), A
 240+ E9A9 79               LD A, C
 241+ E9AA 32 31 82         LD (ObjectiveScreenY), A
 242+ E9AD C9               RET
 243+ E9AE              .rosNoTarget:
 244+ E9AE 3E FF            LD A, $FF
 245+ E9B0 32 30 82         LD (ObjectiveScreenX), A
 246+ E9B3 32 31 82         LD (ObjectiveScreenY), A
 247+ E9B6 C9               RET
 248+ E9B7
 249+ E9B7              ; ==============================================================================
 250+ E9B7              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 251+ E9B7              ; ==============================================================================
 252+ E9B7              ; IN:  A = key id (1..6)
 253+ E9B7              ; OUT: DE = ptr
 254+ E9B7              ; Destruye: AF, HL.
 255+ E9B7              ; ==============================================================================
 256+ E9B7              KeyIdToPtr:
 257+ E9B7 3D               DEC A
 258+ E9B8 87               ADD A, A                            ; *2 (DEFW size)
 259+ E9B9 6F               LD L, A
 260+ E9BA 26 00            LD H, 0
 261+ E9BC 11 5B D2         LD DE, KeyLockTable
 262+ E9BF 19               ADD HL, DE
 263+ E9C0 5E               LD E, (HL)
 264+ E9C1 23               INC HL
 265+ E9C2 56               LD D, (HL)
 266+ E9C3 C9               RET
 267+ E9C4
 268+ E9C4              ; ==============================================================================
 269+ E9C4              ; ActionToTriggerPtr - Busca un action en BumpTriggerTable y devuelve su ptr
 270+ E9C4              ; ==============================================================================
 271+ E9C4              ; IN:  A = action id (1, 2, ...)
 272+ E9C4              ; OUT: DE = ptr al BgGfx del trigger (0 si no encontrado)
 273+ E9C4              ;      Z flag set si no encontrado.
 274+ E9C4              ; Destruye: AF, BC, HL.
 275+ E9C4              ; ==============================================================================
 276+ E9C4              ActionToTriggerPtr:
 277+ E9C4 4F               LD C, A                             ; C = action id buscada
 278+ E9C5 21 E9 D2         LD HL, BumpTriggerTable
 279+ E9C8              .attLoop:
 280+ E9C8 5E               LD E, (HL)
 281+ E9C9 23               INC HL
 282+ E9CA 56               LD D, (HL)
 283+ E9CB 23               INC HL                              ; HL -> required_key
 284+ E9CC 7A               LD A, D
 285+ E9CD B3               OR E
 286+ E9CE 28 09            JR Z, .attNotFound                  ; ptr 0 = fin de tabla
 287+ E9D0 23               INC HL                              ; HL -> action
 288+ E9D1 7E               LD A, (HL)
 289+ E9D2 23               INC HL                              ; HL -> next entry
 290+ E9D3 B9               CP C
 291+ E9D4 20 F2            JR NZ, .attLoop
 292+ E9D6 F6 01            OR 1                                ; clear Z (encontrado)
 293+ E9D8 C9               RET
 294+ E9D9              .attNotFound:
 295+ E9D9 16 00            LD D, 0
 296+ E9DB 1E 00            LD E, 0
 297+ E9DD AF               XOR A                               ; set Z
 298+ E9DE C9               RET
