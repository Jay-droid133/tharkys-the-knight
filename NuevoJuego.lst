 154+ F0DE 3E FF            LD A, $FF
 155+ F0E0 32 54 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 156+ F0E3 C9               RET
 157+ F0E4              .cmdkNotPressed:
 158+ F0E4 AF               XOR A
 159+ F0E5 32 E9 F0         LD (MilestoneKeyDebounce), A
 160+ F0E8 C9               RET
