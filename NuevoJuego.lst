 584+ EB92              ; ==============================================================================
 585+ EB92              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 586+ EB92              ; ==============================================================================
 587+ EB92              ; IN: DE = ptr a 16 filas x 2 bytes
 588+ EB92              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 589+ EB92              ; Destruye: AF, B, HL.
 590+ EB92              ; ==============================================================================
 591+ EB92              DrawCompassSprite:
 592+ EB92                  ; Char row 0 (rows 0-7 del sprite)
 593+ EB92 26 40            LD H, $40
 594+ EB94 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 595+ EB96 06 08            LD B, 8
 596+ EB98              .dcsRow0:
 597+ EB98 1A               LD A, (DE)
 598+ EB99 77               LD (HL), A
 599+ EB9A 13               INC DE
 600+ EB9B 23               INC HL
 601+ EB9C 1A               LD A, (DE)
 602+ EB9D 77               LD (HL), A
 603+ EB9E 13               INC DE
 604+ EB9F 2B               DEC HL
 605+ EBA0 24               INC H
 606+ EBA1 10 F5            DJNZ .dcsRow0
 607+ EBA3                  ; Char row 1 (rows 8-15 del sprite)
 608+ EBA3 26 40            LD H, $40
 609+ EBA5 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 610+ EBA7 06 08            LD B, 8
 611+ EBA9              .dcsRow1:
 612+ EBA9 1A               LD A, (DE)
 613+ EBAA 77               LD (HL), A
 614+ EBAB 13               INC DE
 615+ EBAC 23               INC HL
 616+ EBAD 1A               LD A, (DE)
 617+ EBAE 77               LD (HL), A
 618+ EBAF 13               INC DE
 619+ EBB0 2B               DEC HL
 620+ EBB1 24               INC H
 621+ EBB2 10 F5            DJNZ .dcsRow1
 622+ EBB4 C9               RET
 623+ EBB5
 624+ EBB5              ; ==============================================================================
 625+ EBB5              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 626+ EBB5              ; ==============================================================================
 627+ EBB5              SetCompassAttrs:
 628+ EBB5 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 629+ EBB8 77               LD (HL), A
 630+ EBB9 23               INC HL
 631+ EBBA 77               LD (HL), A
 632+ EBBB 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 633+ EBBE 77               LD (HL), A
 634+ EBBF 23               INC HL
 635+ EBC0 77               LD (HL), A
 636+ EBC1 C9               RET
 637+ EBC2
 638+ EBC2              ; ==============================================================================
 639+ EBC2              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 640+ EBC2              ; ==============================================================================
 641+ EBC2              ClearCompass:
 642+ EBC2 26 40            LD H, $40
 643+ EBC4 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 644+ EBC6 06 08            LD B, 8
 645+ EBC8 AF               XOR A
 646+ EBC9              .ccRow0:
 647+ EBC9 77               LD (HL), A
 648+ EBCA 23               INC HL
 649+ EBCB 77               LD (HL), A
 650+ EBCC 2B               DEC HL
 651+ EBCD 24               INC H
 652+ EBCE 10 F9            DJNZ .ccRow0
 653+ EBD0 26 40            LD H, $40
 654+ EBD2 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 655+ EBD4 06 08            LD B, 8
 656+ EBD6 AF               XOR A
 657+ EBD7              .ccRow1:
 658+ EBD7 77               LD (HL), A
 659+ EBD8 23               INC HL
 660+ EBD9 77               LD (HL), A
 661+ EBDA 2B               DEC HL
 662+ EBDB 24               INC H
 663+ EBDC 10 F9            DJNZ .ccRow1
 664+ EBDE AF               XOR A                               ; attr 0 (negro/negro, invisible)
 665+ EBDF 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 666+ EBE2 77               LD (HL), A
 667+ EBE3 23               INC HL
 668+ EBE4 77               LD (HL), A
 669+ EBE5 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 670+ EBE8 77               LD (HL), A
 671+ EBE9 23               INC HL
 672+ EBEA 77               LD (HL), A
 673+ EBEB C9               RET
 674+ EBEC
 675+ EBEC              ; ==============================================================================
 676+ EBEC              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 677+ EBEC              ; ==============================================================================
 678+ EBEC              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 679+ EBEC              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 680+ EBEC              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 681+ EBEC              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 682+ EBEC              ; monstruo cae alli con la puerta abierta:
 683+ EBEC              ;   - Bit slot en MonsterTrappedFlags
 684+ EBEC              ;   - Despawn del monstruo (puff)
 685+ EBEC              ;   - Puerta se re-cierra (sprite + flag)
 686+ EBEC              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 687+ EBEC              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 688+ EBEC              ;
 689+ EBEC              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 690+ EBEC              ; auto-generadas por el level editor segun la posicion de la puerta y los
 691+ EBEC              ; markers AltKey1/AltKey2.
 692+ EBEC              ; ==============================================================================
 693+ EBEC
 694+ EBEC              ; ==============================================================================
 695+ EBEC              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 696+ EBEC              ; ==============================================================================
 697+ EBEC              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 698+ EBEC              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 699+ EBEC              ; Destruye: AF, BC.
 700+ EBEC              ; ==============================================================================
 701+ EBEC              CheckChurchTrap:
 702+ EBEC                  ; --- Solo en pantalla de la iglesia ---
 703+ EBEC 3A 08 82         LD A, (CurrentScreenX)
 704+ EBEF FE 0F            CP CHURCH_TRAP_SCREEN_X
 705+ EBF1 20 5D            JR NZ, .cctNoTrap
 706+ EBF3 3A 09 82         LD A, (CurrentScreenY)
 707+ EBF6 FE 06            CP CHURCH_TRAP_SCREEN_Y
 708+ EBF8 20 56            JR NZ, .cctNoTrap
 709+ EBFA                  ; --- Solo con la puerta abierta ---
 710+ EBFA 3A DD 81         LD A, (ChurchDoorOpen)
 711+ EBFD B7               OR A
 712+ EBFE 28 50            JR Z, .cctNoTrap
 713+ EC00                  ; --- Solo si el knockback es DIRECTO del player ---
 714+ EC00                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 715+ EC00                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 716+ EC00                  ; espada y se clear cuando se hereda kb por colision.
 717+ EC00 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 718+ EC04 28 4A            JR Z, .cctNoTrap
 719+ EC06                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 720+ EC06                  ; (acepta sprites de 16, 21 o 24 px de alto)
 721+ EC06 DD 7E 04         LD A, (IX+ENT_POSY)
 722+ EC09 CB 3F            SRL A
 723+ EC0B CB 3F            SRL A
 724+ EC0D CB 3F            SRL A                                   ; A = top charY del monster
 725+ EC0F 47               LD B, A
 726+ EC10 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 727+ EC12 90               SUB B                                   ; A = trap_charY - mon_charY
 728+ EC13 FE 03            CP 3
 729+ EC15 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 730+ EC17                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 731+ EC17 DD 7E 03         LD A, (IX+ENT_POSX)
 732+ EC1A CB 3F            SRL A
 733+ EC1C CB 3F            SRL A
 734+ EC1E CB 3F            SRL A
 735+ EC20 47               LD B, A                                 ; B = left charX del monster
 736+ EC21 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 737+ EC23 3C               INC A                                   ; A = LO_X + 1
 738+ EC24 90               SUB B                                   ; A = LO_X+1 - charX
 739+ EC25 FE 03            CP 3
 740+ EC27 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 741+ EC29                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 742+ EC29                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 743+ EC29 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 744+ EC2C D6 4C            SUB SPRID_MONSTER_0
 745+ EC2E CB 3F            SRL A
 746+ EC30 CB 3F            SRL A
 747+ EC32 CB 3F            SRL A                                   ; A = type idx 0..2
 748+ EC34 47               LD B, A
 749+ EC35                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 750+ EC35 3A EA 81         LD A, (NextChurchTrapStep)
 751+ EC38 FE 03            CP 3
 752+ EC3A 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 753+ EC3C 21 52 EC         LD HL, ChurchTrapOrderTable
 754+ EC3F 5F               LD E, A
 755+ EC40 16 00            LD D, 0
 756+ EC42 19               ADD HL, DE
 757+ EC43 7E               LD A, (HL)                              ; A = type esperado
 758+ EC44 B8               CP B
 759+ EC45 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 760+ EC47                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 761+ EC47 CD EA EC         CALL TriggerChurchTrap
 762+ EC4A 3E 01            LD A, 1
 763+ EC4C C9               RET
 764+ EC4D              .cctBlockAsWall:
 765+ EC4D                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 766+ EC4D                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 767+ EC4D 3E 02            LD A, 2
 768+ EC4F C9               RET
 769+ EC50              .cctNoTrap:
 770+ EC50 AF               XOR A
 771+ EC51 C9               RET
 772+ EC52
 773+ EC52              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 774+ EC52              ChurchTrapOrderTable:
 775+ EC52 00 02 01         DEFB 0, 2, 1
 776+ EC55
 777+ EC55              ; ==============================================================================
 778+ EC55              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 779+ EC55              ; blanco brillante sobre paper negro ($47).
 780+ EC55              ; ==============================================================================
 781+ EC55              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 782+ EC55              ; - No-op fuera de la sala de la iglesia.
 783+ EC55              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 784+ EC55              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 785+ EC55              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 786+ EC55              ;   aun no toca) conservan sus attrs originales del sprite.
 787+ EC55              ; Destruye: AF, BC, DE, HL.
 788+ EC55              ; ==============================================================================
 789+ EC55              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 790+ EC55              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 791+ EC55              HighlightExpectedStatue:
 792+ EC55 3E 47            LD A, $47
 793+ EC57 18 00            JR PaintExpectedStatueAttr
 794+ EC59
 795+ EC59              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 796+ EC59              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 797+ EC59              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 798+ EC59              PaintExpectedStatueAttr:
 799+ EC59 32 C3 EC         LD (.hesAttr), A
 800+ EC5C                  ; --- Solo en la sala de la iglesia ---
 801+ EC5C 3A 08 82         LD A, (CurrentScreenX)
 802+ EC5F FE 0F            CP CHURCH_TRAP_SCREEN_X
 803+ EC61 C0               RET NZ
 804+ EC62 3A 09 82         LD A, (CurrentScreenY)
 805+ EC65 FE 06            CP CHURCH_TRAP_SCREEN_Y
 806+ EC67 C0               RET NZ
 807+ EC68                  ; --- Solo tras abrir la iglesia 1a vez ---
 808+ EC68                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 809+ EC68                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 810+ EC68                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 811+ EC68                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 812+ EC68                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 813+ EC68 3A DE 81         LD A, (ChurchEverOpened)
 814+ EC6B B7               OR A
 815+ EC6C C8               RET Z
 816+ EC6D                  ; --- Solo si quedan monstruos por atrapar ---
 817+ EC6D 3A EA 81         LD A, (NextChurchTrapStep)
 818+ EC70 FE 03            CP 3
 819+ EC72 D0               RET NC
 820+ EC73                  ; --- Type esperado -> statue id ---
 821+ EC73 21 52 EC         LD HL, ChurchTrapOrderTable
 822+ EC76 5F               LD E, A
 823+ EC77 16 00            LD D, 0
 824+ EC79 19               ADD HL, DE
 825+ EC7A 7E               LD A, (HL)                              ; type idx esperado
 826+ EC7B 21 07 67         LD HL, StatueIdTable
 827+ EC7E 5F               LD E, A
 828+ EC7F 16 00            LD D, 0
 829+ EC81 19               ADD HL, DE
 830+ EC82 7E               LD A, (HL)                              ; A = statue id
 831+ EC83 B7               OR A
 832+ EC84 C8               RET Z
 833+ EC85 32 C4 EC         LD (.hesTargetId), A
 834+ EC88                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 835+ EC88 2A 0A 82         LD HL, (CurrentScreenAddr)
 836+ EC8B              .hesLoop:
 837+ EC8B 7E               LD A, (HL)
 838+ EC8C FE FF            CP $FF
 839+ EC8E C8               RET Z                                   ; estatua no en esta sala
 840+ EC8F 47               LD B, A
 841+ EC90 3A C4 EC         LD A, (.hesTargetId)
 842+ EC93 B8               CP B
 843+ EC94 28 06            JR Z, .hesFound
 844+ EC96 11 04 00         LD DE, 4
 845+ EC99 19               ADD HL, DE
 846+ EC9A 18 EF            JR .hesLoop
 847+ EC9C              .hesFound:
 848+ EC9C 23               INC HL
 849+ EC9D 7E               LD A, (HL)                              ; charX
 850+ EC9E 47               LD B, A
 851+ EC9F 23               INC HL
 852+ ECA0 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 853+ ECA1 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 854+ ECA3 4F               LD C, A                                 ; C = charY (post-HUD)
 855+ ECA4                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 856+ ECA4 26 00            LD H, 0
 857+ ECA6 69               LD L, C
 858+ ECA7 29               ADD HL, HL
 859+ ECA8 29               ADD HL, HL
 860+ ECA9 29               ADD HL, HL
 861+ ECAA 29               ADD HL, HL
 862+ ECAB 29               ADD HL, HL                              ; HL = charY * 32
 863+ ECAC 58               LD E, B
 864+ ECAD 16 00            LD D, 0
 865+ ECAF 19               ADD HL, DE                              ; + charX
 866+ ECB0 11 00 58         LD DE, $5800
 867+ ECB3 19               ADD HL, DE                              ; HL = attr addr top-left
 868+ ECB4                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 869+ ECB4                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 870+ ECB4                  ; no hace falta sincronizar CleanAttrMap.
 871+ ECB4 3A C3 EC         LD A, (.hesAttr)
 872+ ECB7 06 03            LD B, 3                                 ; 3 filas de chars
 873+ ECB9              .hesRow:
 874+ ECB9 77               LD (HL), A
 875+ ECBA 23               INC HL
 876+ ECBB 77               LD (HL), A                              ; (charX+1)
 877+ ECBC 11 1F 00         LD DE, 31
 878+ ECBF 19               ADD HL, DE                              ; siguiente fila col 0
 879+ ECC0 10 F7            DJNZ .hesRow
 880+ ECC2 C9               RET
 881+ ECC3 00           .hesAttr:     DEFB 0
 882+ ECC4 00           .hesTargetId: DEFB 0
 883+ ECC5
 884+ ECC5              ; ==============================================================================
 885+ ECC5              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 886+ ECC5              ; ==============================================================================
 887+ ECC5              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 888+ ECC5              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 889+ ECC5              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 890+ ECC5              ; + ON final settle): 8 ciclos de ON-OFF en total.
 891+ ECC5              ; ==============================================================================
 892+ ECC5              STATUE_BLINK_FRAMES   EQU 32
 893+ ECC5
 894+ ECC5              StartStatueBlink:
 895+ ECC5                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 896+ ECC5                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 897+ ECC5                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 898+ ECC5                  ; (caso A), .cbtActChurchDoor (caso B).
 899+ ECC5 3E 20            LD A, STATUE_BLINK_FRAMES
 900+ ECC7 32 EB 81         LD (StatueBlinkCounter), A
 901+ ECCA C3 55 EC         JP HighlightExpectedStatue              ; initial ON paint
 902+ ECCD
 903+ ECCD              UpdateStatueBlink:
 904+ ECCD                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 905+ ECCD 3A EB 81         LD A, (StatueBlinkCounter)
 906+ ECD0 B7               OR A
 907+ ECD1 C8               RET Z
 908+ ECD2 3D               DEC A
 909+ ECD3 32 EB 81         LD (StatueBlinkCounter), A
 910+ ECD6 20 03            JR NZ, .usbInProgress
 911+ ECD8                  ; Counter recien llego a 0: settle ON
 912+ ECD8 C3 55 EC         JP HighlightExpectedStatue
 913+ ECDB              .usbInProgress:
 914+ ECDB                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 915+ ECDB                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 916+ ECDB CB 3F            SRL A
 917+ ECDD E6 01            AND $01
 918+ ECDF 28 05            JR Z, .usbOff
 919+ ECE1 3E 47            LD A, $47
 920+ ECE3 C3 59 EC         JP PaintExpectedStatueAttr
 921+ ECE6              .usbOff:
 922+ ECE6 AF               XOR A
 923+ ECE7 C3 59 EC         JP PaintExpectedStatueAttr
 924+ ECEA
 925+ ECEA              ; ==============================================================================
 926+ ECEA              ; CUTSCENE - parametros ajustables
 927+ ECEA              ; ==============================================================================
 928+ ECEA              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 929+ ECEA              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 930+ ECEA              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 931+ ECEA              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 932+ ECEA
 933+ ECEA              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 934+ ECEA              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 935+ ECEA              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 936+ ECEA
 937+ ECEA              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
 938+ ECEA              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
 939+ ECEA              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
 940+ ECEA              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
 941+ ECEA              ;   tick 12 -> erase smoke[2], pasar a DONE
 942+ ECEA              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
 943+ ECEA              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
 944+ ECEA
 945+ ECEA              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
 946+ ECEA              ; base del vano (auto-derivada por el editor). El monster (3 chars de
 947+ ECEA              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
 948+ ECEA              ; centrado dentro del vano de la puerta.
 949+ ECEA              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
 950+ ECEA              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
 951+ ECEA              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
 952+ ECEA              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
 953+ ECEA
 954+ ECEA              ; ==============================================================================
 955+ ECEA              ; TriggerChurchTrap - arranca la cutscene de la iglesia
 956+ ECEA              ; ==============================================================================
 957+ ECEA              ; IN: IX = monster atrapado.
 958+ ECEA              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
 959+ ECEA              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
 960+ ECEA              ; en ApplyChurchTrapEffects al final del cutscene.
 961+ ECEA              ; ==============================================================================
 962+ ECEA              TriggerChurchTrap:
 963+ ECEA                  ; --- 1. Calcular slot 0..2 ---
 964+ ECEA DD E5            PUSH IX
 965+ ECEC E1               POP HL
 966+ ECED 11 D7 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 967+ ECF0 B7               OR A
 968+ ECF1 ED 52            SBC HL, DE
 969+ ECF3 CB 3D            SRL L
 970+ ECF5 CB 3D            SRL L
 971+ ECF7 CB 3D            SRL L
 972+ ECF9 CB 3D            SRL L                                   ; L = slot 0..2
 973+ ECFB 7D               LD A, L
 974+ ECFC 32 9E 5F         LD (ChurchCutsceneSlot), A
 975+ ECFF                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
 976+ ECFF DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 977+ ED02 D6 4C            SUB SPRID_MONSTER_0
 978+ ED04 CB 3F            SRL A
 979+ ED06 CB 3F            SRL A
 980+ ED08 CB 3F            SRL A                                   ; A = type idx
 981+ ED0A 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
 982+ ED0D                  ; --- 2. Mover monster al centro del vano ---
 983+ ED0D 3E 78            LD A, CHURCH_TRAP_AREA_POSX
 984+ ED0F DD 77 03         LD (IX+ENT_POSX), A
 985+ ED12 3E 58            LD A, CHURCH_TRAP_AREA_POSY
 986+ ED14 DD 77 04         LD (IX+ENT_POSY), A
 987+ ED17 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 988+ ED1B DD 36 07 00      LD (IX+ENT_DELTAY), 0
 989+ ED1F DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
 990+ ED23                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
 991+ ED23                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
 992+ ED23                  ; del shake y del humo se renderizarian invisibles (ink black sobre
 993+ ED23                  ; paper black). Forzando ON aqui garantizamos que la animacion de
 994+ ED23                  ; temblor se vea con ink blanco brillante sobre paper negro.
 995+ ED23 AF               XOR A
 996+ ED24 32 EB 81         LD (StatueBlinkCounter), A              ; parar blink
 997+ ED27 DD E5            PUSH IX
 998+ ED29 CD 55 EC         CALL HighlightExpectedStatue            ; pintar $47
 999+ ED2C DD E1            POP IX
1000+ ED2E                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1001+ ED2E 3E 01            LD A, 1
1002+ ED30 32 EE 81         LD (ChurchCutscenePhase), A
1003+ ED33 AF               XOR A
1004+ ED34 32 9D 5F         LD (ChurchCutsceneFrame), A
1005+ ED37 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1006+ ED39 32 A4 5F         LD (ChurchCutsceneLookCount), A
1007+ ED3C C9               RET
1008+ ED3D
1009+ ED3D              ; ==============================================================================
1010+ ED3D              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1011+ ED3D              ; ==============================================================================
1012+ ED3D              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1013+ ED3D              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1014+ ED3D              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1015+ ED3D              ; ==============================================================================
1016+ ED3D              UpdateChurchCutscene:
1017+ ED3D 3A EE 81         LD A, (ChurchCutscenePhase)
1018+ ED40 B7               OR A
1019+ ED41 C8               RET Z
1020+ ED42 3D               DEC A
1021+ ED43 28 12            JR Z, .ucsLookPhase
1022+ ED45 3D               DEC A
1023+ ED46 28 38            JR Z, .ucsShakeStatuePhase
1024+ ED48 3D               DEC A
1025+ ED49 CA D2 ED         JP Z, .ucsSmokePhase
1026+ ED4C                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1027+ ED4C CD 8A 66         CALL ApplyChurchTrapDone
1028+ ED4F AF               XOR A
1029+ ED50 32 EE 81         LD (ChurchCutscenePhase), A
1030+ ED53 32 9D 5F         LD (ChurchCutsceneFrame), A
1031+ ED56 C9               RET
1032+ ED57
1033+ ED57              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1034+ ED57              .ucsLookPhase:
1035+ ED57                  ; Frame counter (para detectar fin de fase)
1036+ ED57 21 9D 5F         LD HL, ChurchCutsceneFrame
1037+ ED5A 34               INC (HL)
1038+ ED5B                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1039+ ED5B 21 A4 5F         LD HL, ChurchCutsceneLookCount
1040+ ED5E 35               DEC (HL)
1041+ ED5F 20 06            JR NZ, .ucsLookCheckEnd
1042+ ED61 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1043+ ED63 77               LD (HL), A
1044+ ED64 CD 20 EE         CALL ChurchCutsceneToggleMonsterDir
1045+ ED67              .ucsLookCheckEnd:
1046+ ED67 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1047+ ED6A FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1048+ ED6C D8               RET C                                   ; sigue mirando
1049+ ED6D                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1050+ ED6D                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1051+ ED6D                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1052+ ED6D CD 66 66         CALL EraseChurchTrappedMonster
1053+ ED70 CD FD 68         CALL CloseChurchDoor
1054+ ED73 CD 45 EE         CALL ChurchCutsceneInitStatueShake
1055+ ED76 3E 02            LD A, 2
1056+ ED78 32 EE 81         LD (ChurchCutscenePhase), A
1057+ ED7B AF               XOR A
1058+ ED7C 32 9D 5F         LD (ChurchCutsceneFrame), A
1059+ ED7F C9               RET
1060+ ED80
1061+ ED80              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1062+ ED80              .ucsShakeStatuePhase:
1063+ ED80 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1064+ ED83 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1065+ ED85 30 35            JR NC, .ucsShakeStatueDone
1066+ ED87                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1067+ ED87                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1068+ ED87                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1069+ ED87                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1070+ ED87                  ;
1071+ ED87                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1072+ ED87                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1073+ ED87 ED 5F            LD A, R
1074+ ED89 E6 03            AND $03
1075+ ED8B 21 B8 ED         LD HL, .ucsShakeJitterTable
1076+ ED8E 5F               LD E, A
1077+ ED8F 16 00            LD D, 0
1078+ ED91 19               ADD HL, DE
1079+ ED92 7E               LD A, (HL)
1080+ ED93 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1081+ ED94                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1082+ ED94 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1083+ ED97 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1084+ ED99 21 07 67         LD HL, StatueIdTable
1085+ ED9C 38 03            JR C, .ucsShakeTablePicked
1086+ ED9E 21 0A 67         LD HL, StatueBrokenIdTable
1087+ EDA1              .ucsShakeTablePicked:
