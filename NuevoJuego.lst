2341+ AEF9              CheckPredatorAttack:
2342+ AEF9                  ; Buscar tipo depredador en PredatorTable
2343+ AEF9 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
2344+ AEFC D6 20            SUB SPRID_ENEMY_0
2345+ AEFE CB 3F            SRL A
2346+ AF00 CB 3F            SRL A                               ; indice = (ANIMBASE - ENEMY_0) / 4
2347+ AF02 21 FB BF         LD HL, PredatorTable
2348+ AF05 5F               LD E, A
2349+ AF06 16 00            LD D, 0
2350+ AF08 19               ADD HL, DE
2351+ AF09 7E               LD A, (HL)                          ; A = byte predador
2352+ AF0A B7               OR A
2353+ AF0B C8               RET Z                               ; PRED_NONE → no es depredador
2354+ AF0C
2355+ AF0C                  ; Comprobar ciclo minimo: bits 2-3 = ciclo requerido
2356+ AF0C 47               LD B, A                             ; B = byte predador completo
2357+ AF0D CB 3F            SRL A
2358+ AF0F CB 3F            SRL A                               ; A = ciclo requerido (1-3)
2359+ AF11 4F               LD C, A
2360+ AF12 3A 07 C0         LD A, (DayCycleCount)
2361+ AF15 B9               CP C
2362+ AF16 D8               RET C                               ; DayCycleCount < ciclo requerido → no atacar
2363+ AF17
2364+ AF17                  ; Calcular velocidad de ataque segun ciclo
2365+ AF17 3A 07 C0         LD A, (DayCycleCount)
2366+ AF1A FE 04            CP 4
2367+ AF1C 38 02            JR C, .cpSpeedOk
2368+ AF1E 3E 03            LD A, 3                             ; Cap en 3
2369+ AF20              .cpSpeedOk:
2370+ AF20 21 03 C0         LD HL, PredatorSpeedTable
2371+ AF23 5F               LD E, A
2372+ AF24 16 00            LD D, 0
2373+ AF26 19               ADD HL, DE
2374+ AF27 7E               LD A, (HL)
2375+ AF28 32 A5 AF         LD (.cpSpeed), A
2376+ AF2B
2377+ AF2B                  ; Tipo depredador activo: comprobar alineacion
2378+ AF2B 78               LD A, B
2379+ AF2C E6 03            AND $03                             ; A = tipo (1=arriba, 2=abajo, 3=horizontal)
2380+ AF2E FE 03            CP PRED_HORIZONTAL
2381+ AF30 28 41            JR Z, .cpHorizontal
2382+ AF32
2383+ AF32                  ; === Vertical (arriba/abajo): comprobar |nastyX - playerX| < PRED_ALIGN_DIST ===
2384+ AF32 4F               LD C, A                             ; C = tipo (1 o 2)
2385+ AF33 DD 7E 03         LD A, (IX+ENT_POSX)
2386+ AF36 57               LD D, A
2387+ AF37 3A 4E 81         LD A, (EntityTable + ENT_POSX)
2388+ AF3A 92               SUB D
2389+ AF3B 30 02            JR NC, .cpAbsX
2390+ AF3D ED 44            NEG
2391+ AF3F              .cpAbsX:
2392+ AF3F FE 0C            CP PRED_ALIGN_DIST
