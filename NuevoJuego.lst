2165+ AAEA              ; ==============================================================================
2166+ AAEA              ; SelectSwordMode - Elige modo de espada segun nivel de stamina
2167+ AAEA              ; ==============================================================================
2168+ AAEA              ; Tras setear el modo: si nuevo mode != B (mode 0), limpiar AttackCooldown
2169+ AAEA              ; stale y, si el sprite quedó azul del cooldown previo de mode B, restaurar
2170+ AAEA              ; a blanco. Sin esto, recuperar stamina mientras estás en cooldown deja al
2171+ AAEA              ; player azul para siempre (mode C/Free no decrementan AttackCooldown ni
2172+ AAEA              ; tocan el color → blue stuck). Mismo problema que arregló a4f5d5e para el
2173+ AAEA              ; respawn, pero centralizado aquí cubre también pickup-stamina + well.
2174+ AAEA              ; ==============================================================================
2175+ AAEA              SelectSwordMode:
2176+ AAEA                  ; ESPADA buff: fuerza mode 2 (libre) sin importar stamina (ataque a 0 OK).
2177+ AAEA 3A DA 5F         LD A, (EspadaTimer)
2178+ AAED 21 DB 5F         LD HL, EspadaTimer + 1
2179+ AAF0 B6               OR (HL)
2180+ AAF1 28 04            JR Z, .smCheckStamina
2181+ AAF3 3E 02            LD A, 2                             ; ESPADA: siempre libre
2182+ AAF5 18 14            JR .smSet
2183+ AAF7              .smCheckStamina:
2184+ AAF7 3A C9 B3         LD A, (PlayerStamina)
2185+ AAFA FE 0C            CP STAMINA_THRESHOLD_HIGH
2186+ AAFC 38 04            JR C, .smNotHigh
2187+ AAFE 3E 02            LD A, 2                             ; Libre (continuo)
2188+ AB00 18 09            JR .smSet
2189+ AB02              .smNotHigh:
2190+ AB02 FE 07            CP STAMINA_THRESHOLD_MID
2191+ AB04 38 04            JR C, .smNotMid
2192+ AB06 3E 01            LD A, 1                             ; Fixed swing
2193+ AB08 18 01            JR .smSet
2194+ AB0A              .smNotMid:
2195+ AB0A AF               XOR A                               ; Cooldown (0)
2196+ AB0B              .smSet:
2197+ AB0B 32 C7 B3         LD (SwordMode), A
2198+ AB0E B7               OR A
2199+ AB0F C8               RET Z                               ; Mode B → cooldown legítimo, no tocar
2200+ AB10                  ; Mode C/Free: cooldown sin sentido. Limpiar (color lo pinta el cycler).
2201+ AB10 AF               XOR A
2202+ AB11 32 C4 B3         LD (AttackCooldown), A
2203+ AB14 C9               RET
