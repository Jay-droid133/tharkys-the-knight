1673+ AC03              ; UpdatePlayerAnimation - Animacion por SpriteID
1674+ AC03              ; ==============================================================================
1675+ AC03              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
1676+ AC03              ; ==============================================================================
1677+ AC03              UpdatePlayerAnimation:
1678+ AC03                  ; Determinar animacion segun estado y direccion
1679+ AC03 DD 7E 02         LD A, (IX+ENT_STATE)
1680+ AC06 FE 02            CP STATE_FIGHTING
1681+ AC08 28 0C            JR Z, .animFight
1682+ AC0A FE 01            CP STATE_RUNNING
1683+ AC0C 28 21            JR Z, .animRun
1684+ AC0E
1685+ AC0E                  ; --- IDLE ---
1686+ AC0E 16 00            LD D, SPRID_IDLE
1687+ AC10 1E 02            LD E, ANIM_FRAMES_IDLE
1688+ AC12 0E 0A            LD C, ANIM_DELAY_IDLE
1689+ AC14 18 44            JR .applyAnim
1690+ AC16
1691+ AC16              .animFight:
1692+ AC16                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
1693+ AC16 DD 7E 0A         LD A, (IX+ENT_DIR)
1694+ AC19 0F               RRCA
1695+ AC1A 0F               RRCA
1696+ AC1B 0F               RRCA
1697+ AC1C 0F               RRCA
1698+ AC1D E6 0F            AND $0F                     ; lastHDir
1699+ AC1F FE 08            CP DIR_W
1700+ AC21 28 04            JR Z, .fightW
1701+ AC23 16 16            LD D, SPRID_ATTACK_EAST
1702+ AC25 18 02            JR .fightSet
1703+ AC27              .fightW:
1704+ AC27 16 1B            LD D, SPRID_ATTACK_WEST
1705+ AC29              .fightSet:
