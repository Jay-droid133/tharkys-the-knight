 127  D600                  INCLUDE "day_cycle.asm"
# file opened: day_cycle.asm
   1+ D600              ; ==============================================================================
   2+ D600              ; DAY/NIGHT CYCLE SYSTEM - Debug Mode
   3+ D600              ; ==============================================================================
   4+ D600              ; Sistema de transformacion de atributos de BG sprites segun momento del dia.
   5+ D600              ; En modo debug, la tecla T cicla entre 7 momentos.
   6+ D600              ; Sprites "house" tienen override especial para ventanas (Cyan).
   7+ D600              ; ==============================================================================
   8+ D600
   9+ D600              ; --- Constantes ---
  10+ D600              NUM_TIME_MOMENTS    EQU 7
  11+ D600
  12+ D600              ; --- Variables ---
  13+ D600 00           CurrentTimeOfDay:       DEFB 0      ; Crepusculo temprano
  14+ D601 FB D9        CurrentRemapTable:      DEFW RemapTable_CrepT
  15+ D603 FB D9        CurrentHouseRemapTable: DEFW RemapTable_CrepT
  16+ D605 00           BgSpriteIsHouse:        DEFB 0      ; Flag temporal por sprite
  17+ D606 00           DebugKeyDebounce:       DEFB 0      ; Anti-rebote tecla T
  18+ D607
  19+ D607              ; ==============================================================================
  20+ D607              ; SetTimeOfDay - Cambia el momento del dia
  21+ D607              ; ==============================================================================
  22+ D607              ; Entrada: A = momento (0-6)
  23+ D607              ; ==============================================================================
  24+ D607              SetTimeOfDay:
  25+ D607 32 00 D6         LD (CurrentTimeOfDay), A
  26+ D60A
  27+ D60A                  ; N2 (fase 4 = medianoche 00:00): incrementar ciclo de dia
  28+ D60A FE 04            CP 4
  29+ D60C 20 04            JR NZ, .notNewCycle
  30+ D60E 21 95 A9         LD HL, DayCycleCount
  31+ D611 34               INC (HL)
  32+ D612              .notNewCycle:
  33+ D612
  34+ D612                  ; N2 (medianoche): campanadas primero, remap al terminar
  35+ D612 FE 04            CP 4
  36+ D614 28 1C            JR Z, .bellsFirst
  37+ D616
  38+ D616                  ; Amanecer temprano (fase 5): despawnear monsters
  39+ D616 FE 05            CP 5
  40+ D618 20 05            JR NZ, .noScareMon
  41+ D61A CD AF A9         CALL ScareAllMonsters
  42+ D61D 18 07            JR .noKillMon
  43+ D61F              .noScareMon:
  44+ D61F                  ; Amanecer tardio (fase 6): matar monsters supervivientes
  45+ D61F FE 06            CP 6
  46+ D621 20 03            JR NZ, .noKillMon
  47+ D623 CD 34 A9         CALL KillAllActiveMonsters
  48+ D626              .noKillMon:
  49+ D626
  50+ D626                  ; Actualizar tablas de remap y tabla de nasties
  51+ D626 CD 36 D6         CALL UpdateRemapTables
  52+ D629 CD 98 A9         CALL UpdateNastyTable
  53+ D62C
  54+ D62C                  ; Forzar remap de atributos (sin redibujar pixeles)
  55+ D62C 3E 01            LD A, 1
  56+ D62E 32 D1 81         LD (AttrsDirty), A
  57+ D631 C9               RET
  58+ D632
  59+ D632              .bellsFirst:
  60+ D632                  ; NO actualizar tablas: mantener colores de N1 durante campanadas
  61+ D632 CD E3 E1         CALL StartBellChimes
  62+ D635 C9               RET
  63+ D636
  64+ D636              ; ==============================================================================
  65+ D636              ; UpdateRemapTables - Actualiza punteros de remap segun CurrentTimeOfDay
  66+ D636              ; ==============================================================================
  67+ D636              UpdateRemapTables:
  68+ D636 3A 00 D6         LD A, (CurrentTimeOfDay)
  69+ D639 21 CF D9         LD HL, RemapTablePtrs
  70+ D63C 5F               LD E, A
  71+ D63D 16 00            LD D, 0
  72+ D63F 19               ADD HL, DE
  73+ D640 19               ADD HL, DE
  74+ D641 5E               LD E, (HL)
  75+ D642 23               INC HL
  76+ D643 56               LD D, (HL)
  77+ D644 ED 53 01 D6      LD (CurrentRemapTable), DE
  78+ D648
  79+ D648 3A 00 D6         LD A, (CurrentTimeOfDay)
  80+ D64B 21 DD D9         LD HL, RemapHouseTablePtrs
  81+ D64E 5F               LD E, A
  82+ D64F 16 00            LD D, 0
  83+ D651 19               ADD HL, DE
  84+ D652 19               ADD HL, DE
  85+ D653 5E               LD E, (HL)
  86+ D654 23               INC HL
  87+ D655 56               LD D, (HL)
  88+ D656 ED 53 03 D6      LD (CurrentHouseRemapTable), DE
  89+ D65A C9               RET
  90+ D65B
  91+ D65B              ; ==============================================================================
  92+ D65B              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
  93+ D65B              ; ==============================================================================
  94+ D65B              CheckDebugKeys:
  95+ D65B 3E FB            LD A, $FB
  96+ D65D DB FE            IN A, ($FE)
  97+ D65F CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
  98+ D661 20 1C            JR NZ, .notPressed
  99+ D663
 100+ D663                  ; Tecla pulsada: comprobar debounce
 101+ D663 3A 06 D6         LD A, (DebugKeyDebounce)
 102+ D666 B7               OR A
 103+ D667 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 104+ D668
 105+ D668                  ; Primera pulsacion: ciclar
 106+ D668 3E 01            LD A, 1
 107+ D66A 32 06 D6         LD (DebugKeyDebounce), A
 108+ D66D
 109+ D66D 3A 00 D6         LD A, (CurrentTimeOfDay)
 110+ D670 3C               INC A
 111+ D671 FE 07            CP NUM_TIME_MOMENTS
 112+ D673 38 01            JR C, .noWrap
 113+ D675 AF               XOR A                   ; Volver a 0 (Dia)
 114+ D676              .noWrap:
 115+ D676 F5               PUSH AF
 116+ D677 CD 07 D6         CALL SetTimeOfDay
 117+ D67A F1               POP AF
 118+ D67B CD A6 DD         CALL SetClockToPhaseHour
 119+ D67E C9               RET
 120+ D67F
 121+ D67F              .notPressed:
 122+ D67F AF               XOR A
 123+ D680 32 06 D6         LD (DebugKeyDebounce), A
 124+ D683
 125+ D683                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 126+ D683 3E FD            LD A, $FD
 127+ D685 DB FE            IN A, ($FE)
 128+ D687 4F               LD C, A                 ; C = estado semi-fila $FDFE
 129+ D688 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 130+ D68A 20 13            JR NZ, .sNotPressed
 131+ D68C 3A BB D6         LD A, (SpeedKeyDebounce)
 132+ D68F B7               OR A
 133+ D690 C0               RET NZ
 134+ D691 3E 01            LD A, 1
 135+ D693 32 BB D6         LD (SpeedKeyDebounce), A
 136+ D696 21 95 A9         LD HL, DayCycleCount
 137+ D699 7E               LD A, (HL)
 138+ D69A FE 0A            CP 10
 139+ D69C D0               RET NC                  ; Ya en maximo
 140+ D69D 34               INC (HL)
 141+ D69E C9               RET
 142+ D69F              .sNotPressed:
 143+ D69F                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 144+ D69F CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 145+ D6A1 20 13            JR NZ, .dNotPressed
 146+ D6A3 3A BB D6         LD A, (SpeedKeyDebounce)
 147+ D6A6 B7               OR A
 148+ D6A7 C0               RET NZ
 149+ D6A8 3E 01            LD A, 1
 150+ D6AA 32 BB D6         LD (SpeedKeyDebounce), A
 151+ D6AD 21 95 A9         LD HL, DayCycleCount
 152+ D6B0 7E               LD A, (HL)
 153+ D6B1 FE 01            CP 1
 154+ D6B3 C8               RET Z                   ; Ya en minimo
 155+ D6B4 35               DEC (HL)
 156+ D6B5 C9               RET
 157+ D6B6              .dNotPressed:
 158+ D6B6 AF               XOR A
 159+ D6B7 32 BB D6         LD (SpeedKeyDebounce), A
 160+ D6BA C9               RET
 161+ D6BB
 162+ D6BB 00           SpeedKeyDebounce: DEFB 0
 163+ D6BC
 164+ D6BC              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 165+ D6BC              DrawSwordModeHUD:
 166+ D6BC 3A 14 A3         LD A, (SwordMode)
 167+ D6BF 21 EF D6         LD HL, .modeChars
 168+ D6C2 5F               LD E, A
 169+ D6C3 16 00            LD D, 0
 170+ D6C5 19               ADD HL, DE
 171+ D6C6 7E               LD A, (HL)                          ; A = ASCII del modo
 172+ D6C7                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 173+ D6C7 21 00 40         LD HL, $4000
 174+ D6CA                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 175+ D6CA 5F               LD E, A
 176+ D6CB 16 00            LD D, 0
 177+ D6CD 42               LD B, D                             ; B = 0
 178+ D6CE CB 23            SLA E
 178+ D6D0 CB 12          RL D                        ; *2
 179+ D6D2 CB 23            SLA E
 179+ D6D4 CB 12          RL D                        ; *4
 180+ D6D6 CB 23            SLA E
 180+ D6D8 CB 12          RL D                        ; *8
 181+ D6DA E5               PUSH HL
 182+ D6DB 21 00 3C         LD HL, $3C00
 183+ D6DE 19               ADD HL, DE                          ; HL = direccion del glyph
 184+ D6DF EB               EX DE, HL                           ; DE = glyph
 185+ D6E0 E1               POP HL                              ; HL = VRAM
 186+ D6E1 06 08            LD B, 8
 187+ D6E3              .drawChar:
 188+ D6E3 1A               LD A, (DE)
 189+ D6E4 77               LD (HL), A
 190+ D6E5 13               INC DE
 191+ D6E6 24               INC H                               ; siguiente scan line
 192+ D6E7 10 FA            DJNZ .drawChar
 193+ D6E9                  ; Attr: fila 0, col 0 = $5800
 194+ D6E9 3E 47            LD A, $47                           ; blanco bright
 195+ D6EB 32 00 58         LD ($5800), A
 196+ D6EE C9               RET
 197+ D6EF
 198+ D6EF 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 199+ D6F2
 200+ D6F2              ; ==============================================================================
 201+ D6F2              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 202+ D6F2              ; ==============================================================================
 203+ D6F2              ; Entrada: A = attr original
 204+ D6F2              ; Salida:  A = attr transformado
 205+ D6F2              ; Preserva: HL, DE, BC, IX
 206+ D6F2              ; ==============================================================================
 207+ D6F2              ApplyDayCycleRemap:
 208+ D6F2 E5               PUSH HL
 209+ D6F3 67               LD H, A                     ; H = attr (temp save)
 210+ D6F4 3A 00 D6         LD A, (CurrentTimeOfDay)
 211+ D6F7 B7               OR A
 212+ D6F8 20 03            JR NZ, .doRemap
 213+ D6FA 7C               LD A, H                     ; Dia: devolver sin cambio
 214+ D6FB E1               POP HL
 215+ D6FC C9               RET
 216+ D6FD
 217+ D6FD              .doRemap:
 218+ D6FD D5               PUSH DE
 219+ D6FE C5               PUSH BC
 220+ D6FF
 221+ D6FF 7C               LD A, H                     ; A = attr original
 222+ D700 4F               LD C, A                     ; C = attr original
 223+ D701
 224+ D701                  ; Guardar flash + ink (bits 7, 2-0)
 225+ D701 E6 87            AND $87                     ; A = F000_0III
 226+ D703 47               LD B, A                     ; B = flash | ink
 227+ D704
 228+ D704                  ; Extraer paper+bright como indice 0-15
 229+ D704 79               LD A, C
 230+ D705 E6 78            AND $78                     ; A = 0BPPP000
 231+ D707 0F               RRCA
 232+ D708 0F               RRCA
 233+ D709 0F               RRCA                        ; A = 0000BPPP = indice
 234+ D70A
 235+ D70A                  ; Elegir tabla segun tipo de sprite
 236+ D70A 5F               LD E, A
 237+ D70B 16 00            LD D, 0
 238+ D70D 3A 05 D6         LD A, (BgSpriteIsHouse)
 239+ D710 B7               OR A
 240+ D711 28 05            JR Z, .useStdTable
 241+ D713 2A 03 D6         LD HL, (CurrentHouseRemapTable)
 242+ D716 18 03            JR .doLookup
 243+ D718              .useStdTable:
 244+ D718 2A 01 D6         LD HL, (CurrentRemapTable)
 245+ D71B              .doLookup:
 246+ D71B 19               ADD HL, DE
 247+ D71C 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 248+ D71D
 249+ D71D                  ; Reconstruir atributo
 250+ D71D 07               RLCA
 251+ D71E 07               RLCA
 252+ D71F 07               RLCA                        ; A = 0BPPP000
 253+ D720 B0               OR B                        ; A = FBPPPIII
 254+ D721
 255+ D721 C1               POP BC
 256+ D722 D1               POP DE
 257+ D723 E1               POP HL
 258+ D724 C9               RET
 259+ D725
 260+ D725              ; ==============================================================================
 261+ D725              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 262+ D725              ; ==============================================================================
 263+ D725              ; Entrada: DE = direccion datos del sprite
 264+ D725              ; Setea BgSpriteIsHouse (0 o 1)
 265+ D725              ; Preserva: DE, IX
 266+ D725              ; ==============================================================================
 267+ D725              CheckIfHouseSprite:
 268+ D725 E5               PUSH HL
 269+ D726 C5               PUSH BC
 270+ D727
 271+ D727 AF               XOR A
 272+ D728 32 05 D6         LD (BgSpriteIsHouse), A     ; Default: no es house
 273+ D72B
 274+ D72B 21 46 D7         LD HL, HouseSpriteList
 275+ D72E              .checkLoop:
 276+ D72E 4E               LD C, (HL)
 277+ D72F 23               INC HL
 278+ D730 46               LD B, (HL)
 279+ D731 23               INC HL                      ; BC = direccion sprite house
 280+ D732 78               LD A, B
 281+ D733 B1               OR C
 282+ D734 28 0D            JR Z, .checkDone            ; Terminador: no encontrado
 283+ D736
 284+ D736 78               LD A, B
 285+ D737 BA               CP D
 286+ D738 20 F4            JR NZ, .checkLoop
 287+ D73A 79               LD A, C
 288+ D73B BB               CP E
 289+ D73C 20 F0            JR NZ, .checkLoop
 290+ D73E
 291+ D73E                  ; Encontrado: es house
 292+ D73E 3E 01            LD A, 1
 293+ D740 32 05 D6         LD (BgSpriteIsHouse), A
 294+ D743
 295+ D743              .checkDone:
 296+ D743 C1               POP BC
 297+ D744 E1               POP HL
 298+ D745 C9               RET
 299+ D746
 300+ D746              ; --- Lista de sprites tipo "house" (terminada en $0000) ---
 301+ D746              ; Las etiquetas BgGfx_* viven en bank 3 pero esta lista las compara como
 302+ D746              ; ADDRESSES, no las deferencia. La lista vive en bank 0 para que
 303+ D746              ; CheckIfHouseSprite pueda leerla sin paginar.
 304+ D746              HouseSpriteList:
 305+ D746 89 C0            DEFW BgGfx_big_house
 306+ D748 86 C2            DEFW BgGfx_tall_house
 307+ D74A A3 C5            DEFW BgGfx_narrow_tall_house
 308+ D74C 34 C7            DEFW BgGfx_house_short
 309+ D74E E9 C8            DEFW BgGfx_small_house
 310+ D750 68 CA            DEFW BgGfx_little_house
 311+ D752 7B CB            DEFW BgGfx_very_little_house
 312+ D754 EC CB            DEFW BgGfx_minimal_house
 313+ D756 00 00            DEFW $0000
 314+ D758
 315+ D758              ; ==============================================================================
 316+ D758              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 317+ D758              ; ==============================================================================
 318+ D758              ; Formato: XX,YY:NN nombre_room     DY
 319+ D758              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 320+ D758              ; ==============================================================================
 321+ D758              DrawRoomInfo:
 322+ D758                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 323+ D758 1E 00            LD E, 0
 324+ D75A 06 0D            LD B, 13
 325+ D75C              .clearLoop:
 326+ D75C C5               PUSH BC
 327+ D75D D5               PUSH DE
 328+ D75E 3E 20            LD A, ' '
 329+ D760 CD DD D8         CALL DrawHudChar
 330+ D763 D1               POP DE
 331+ D764 C1               POP BC
 332+ D765 1C               INC E
 333+ D766 10 F4            DJNZ .clearLoop
 334+ D768
 335+ D768                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 336+ D768 3A C8 81         LD A, (CurrentScreenX)
 337+ D76B 1E 00            LD E, 0
 338+ D76D CD CB D7         CALL .drawDec2
 339+ D770
 340+ D770                  ; --- ',' en col 2 ---
 341+ D770 3E 2C            LD A, ','
 342+ D772 1E 02            LD E, 2
 343+ D774 CD DD D8         CALL DrawHudChar
 344+ D777
 345+ D777                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 346+ D777 3A C9 81         LD A, (CurrentScreenY)
 347+ D77A 1E 03            LD E, 3
 348+ D77C CD CB D7         CALL .drawDec2
 349+ D77F
 350+ D77F                  ; --- ':' en col 5 ---
 351+ D77F 3E 3A            LD A, ':'
 352+ D781 1E 05            LD E, 5
 353+ D783 CD DD D8         CALL DrawHudChar
 354+ D786
 355+ D786                  ; --- Obtener room index de MapTable[Y*16+X] ---
 356+ D786 3A C9 81         LD A, (CurrentScreenY)
 357+ D789 6F               LD L, A
 358+ D78A 26 00            LD H, 0
 359+ D78C 29               ADD HL, HL
 360+ D78D 29               ADD HL, HL
 361+ D78E 29               ADD HL, HL
 362+ D78F 29               ADD HL, HL                  ; HL = Y * 16
 363+ D790 3A C8 81         LD A, (CurrentScreenX)
 364+ D793 5F               LD E, A
 365+ D794 16 00            LD D, 0
 366+ D796 19               ADD HL, DE                  ; HL = Y*16 + X
 367+ D797 11 98 B6         LD DE, MapTable
 368+ D79A 19               ADD HL, DE
 369+ D79B 7E               LD A, (HL)                  ; A = room index (0-47)
 370+ D79C F5               PUSH AF                     ; guardar room index
 371+ D79D
 372+ D79D                  ; --- Room index como 2 hex en cols 6-7 ---
 373+ D79D F5               PUSH AF
 374+ D79E 0F               RRCA
 375+ D79F 0F               RRCA
 376+ D7A0 0F               RRCA
 377+ D7A1 0F               RRCA
 378+ D7A2 E6 0F            AND $0F
 379+ D7A4 CD E9 D7         CALL .hexToAscii
 380+ D7A7 1E 06            LD E, 6
 381+ D7A9 CD DD D8         CALL DrawHudChar
 382+ D7AC F1               POP AF
 383+ D7AD E6 0F            AND $0F
 384+ D7AF CD E9 D7         CALL .hexToAscii
 385+ D7B2 1E 07            LD E, 7
 386+ D7B4 CD DD D8         CALL DrawHudChar
 387+ D7B7
 388+ D7B7                  ; --- Espacio en col 8 ---
 389+ D7B7 3E 20            LD A, ' '
 390+ D7B9 1E 08            LD E, 8
 391+ D7BB CD DD D8         CALL DrawHudChar
 392+ D7BE
 393+ D7BE                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 394+ D7BE F1               POP AF                      ; A = room index (descartar)
 395+ D7BF
 396+ D7BF                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 397+ D7BF 21 20 58         LD HL, ATTR_BASE + 1 * 32
 398+ D7C2 3E 47            LD A, $47                   ; bright white on black
 399+ D7C4 06 0D            LD B, 13
 400+ D7C6              .attrLoop:
 401+ D7C6 77               LD (HL), A
 402+ D7C7 23               INC HL
 403+ D7C8 10 FC            DJNZ .attrLoop
 404+ D7CA C9               RET
 405+ D7CB
 406+ D7CB              ; --- Helpers ---
 407+ D7CB              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 408+ D7CB              .drawDec2:
 409+ D7CB 4B               LD C, E                     ; guardar columna inicial
 410+ D7CC 06 00            LD B, 0                     ; decenas
 411+ D7CE              .divLoop:
 412+ D7CE FE 0A            CP 10
 413+ D7D0 38 05            JR C, .divDone
 414+ D7D2 D6 0A            SUB 10
 415+ D7D4 04               INC B
 416+ D7D5 18 F7            JR .divLoop
 417+ D7D7              .divDone:
 418+ D7D7                  ; B = decenas, A = unidades
 419+ D7D7 F5               PUSH AF                     ; guardar unidades
 420+ D7D8 78               LD A, B
 421+ D7D9 C6 30            ADD A, '0'
 422+ D7DB 59               LD E, C
 423+ D7DC C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 424+ D7DD CD DD D8         CALL DrawHudChar
 425+ D7E0 C1               POP BC                      ; restaurar C
 426+ D7E1 F1               POP AF
 427+ D7E2 C6 30            ADD A, '0'
 428+ D7E4 59               LD E, C
 429+ D7E5 1C               INC E
 430+ D7E6 C3 DD D8         JP DrawHudChar              ; tail call
 431+ D7E9
 432+ D7E9              .hexToAscii:
 433+ D7E9 FE 0A            CP 10
 434+ D7EB 38 03            JR C, .isDigit
 435+ D7ED C6 37            ADD A, 'A' - 10
 436+ D7EF C9               RET
 437+ D7F0              .isDigit:
 438+ D7F0 C6 30            ADD A, '0'
 439+ D7F2 C9               RET
 440+ D7F3
 441+ D7F3              ; ==============================================================================
 442+ D7F3              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 443+ D7F3              ; Usa font custom (DayHudFont) en vez de ROM font
 444+ D7F3              ; ==============================================================================
 445+ D7F3              DrawDayCycleHUD:
 446+ D7F3                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 447+ D7F3 21 7B DA         LD HL, DayHudFont + 0 * 8          ; 'D'
 448+ D7F6 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 449+ D7F9 CD 68 D8         CALL .drawChar
 450+ D7FC 21 83 DA         LD HL, DayHudFont + 1 * 8          ; 'A'
 451+ D7FF 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 452+ D802 CD 68 D8         CALL .drawChar
 453+ D805 21 8B DA         LD HL, DayHudFont + 2 * 8          ; 'Y'
 454+ D808 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 455+ D80B CD 68 D8         CALL .drawChar
 456+ D80E                  ; Col 7 = espacio (limpiar)
 457+ D80E 11 07 40         LD DE, $4007
 458+ D811 CD 71 D8         CALL .clearChar
 459+ D814
 460+ D814                  ; --- Digito decenas (col 8) ---
 461+ D814 3A 95 A9         LD A, (DayCycleCount)
 462+ D817 FE 0A            CP 10
 463+ D819 38 20            JR C, .singleDigit
 464+ D81B                  ; Dos digitos: dividir A / 10
 465+ D81B 06 00            LD B, 0
 466+ D81D              .divLoop:
 467+ D81D D6 0A            SUB 10
 468+ D81F 04               INC B
 469+ D820 FE 0A            CP 10
 470+ D822 30 F9            JR NC, .divLoop
 471+ D824                  ; B = decenas, A = unidades
 472+ D824 F5               PUSH AF                             ; Guardar unidades
 473+ D825 78               LD A, B
 474+ D826 CD 5B D8         CALL .getDigitFont
 475+ D829 11 08 40         LD DE, $4008                        ; Col 8
 476+ D82C CD 68 D8         CALL .drawChar
 477+ D82F F1               POP AF                              ; Recuperar unidades
 478+ D830 CD 5B D8         CALL .getDigitFont
 479+ D833 11 09 40         LD DE, $4009                        ; Col 9
 480+ D836 CD 68 D8         CALL .drawChar
 481+ D839 18 14            JR .setAttrs
 482+ D83B
 483+ D83B              .singleDigit:
 484+ D83B                  ; Una cifra: decena = 0, unidad = A
 485+ D83B F5               PUSH AF
 486+ D83C 21 93 DA         LD HL, DayHudFont + 3 * 8          ; '0'
 487+ D83F 11 08 40         LD DE, $4008                        ; Col 8
 488+ D842 CD 68 D8         CALL .drawChar
 489+ D845 F1               POP AF
 490+ D846 CD 5B D8         CALL .getDigitFont
 491+ D849 11 09 40         LD DE, $4009                        ; Col 9
 492+ D84C CD 68 D8         CALL .drawChar
 493+ D84F
 494+ D84F              .setAttrs:
 495+ D84F                  ; Atributos: bright white en cols 4-9
 496+ D84F 3E 47            LD A, $47
 497+ D851 21 04 58         LD HL, ATTR_BASE + 4
 498+ D854 06 06            LD B, 6
 499+ D856              .attrLoop:
 500+ D856 77               LD (HL), A
 501+ D857 23               INC HL
 502+ D858 10 FC            DJNZ .attrLoop
 503+ D85A C9               RET
 504+ D85B
 505+ D85B              ; Devuelve HL = puntero a font data del digito en A (0-9)
 506+ D85B              ; A se destruye
 507+ D85B              .getDigitFont:
 508+ D85B C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 509+ D85D 6F               LD L, A
 510+ D85E 26 00            LD H, 0
 511+ D860 29               ADD HL, HL
 512+ D861 29               ADD HL, HL
 513+ D862 29               ADD HL, HL                          ; HL = indice * 8
 514+ D863 01 7B DA         LD BC, DayHudFont
 515+ D866 09               ADD HL, BC
 516+ D867 C9               RET
 517+ D868
 518+ D868              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 519+ D868              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 520+ D868              .drawChar:
 521+ D868 06 08            LD B, 8
 522+ D86A              .charLoop:
 523+ D86A 7E               LD A, (HL)
 524+ D86B 12               LD (DE), A
 525+ D86C 23               INC HL
 526+ D86D 14               INC D
 527+ D86E 10 FA            DJNZ .charLoop
 528+ D870 C9               RET
 529+ D871
 530+ D871              ; Limpia 8 scan lines en VRAM (DE)
 531+ D871              .clearChar:
 532+ D871 06 08            LD B, 8
 533+ D873 AF               XOR A
 534+ D874              .clearLoop:
 535+ D874 12               LD (DE), A
 536+ D875 14               INC D
 537+ D876 10 FC            DJNZ .clearLoop
 538+ D878 C9               RET
 539+ D879
 540+ D879              ; ==============================================================================
 541+ D879              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 542+ D879              ; ==============================================================================
 543+ D879              DrawPlayerSpeedHUD:
 544+ D879 3A E0 8C         LD A, (PlayerCurrentSpeed)
 545+ D87C C6 30            ADD A, '0'
 546+ D87E 1E 02            LD E, 2
 547+ D880 CD A3 D8         CALL DrawHudCharRow0
 548+ D883                  ; Atributo (bright white)
 549+ D883 3E 47            LD A, $47
 550+ D885 32 02 58         LD (ATTR_BASE + 2), A
 551+ D888 C9               RET
 552+ D889
 553+ D889              ; ==============================================================================
 554+ D889              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 555+ D889              ; ==============================================================================
 556+ D889              DrawEnemySpeedHUD:
 557+ D889                  ; "V" en columna 30
 558+ D889 3E 56            LD A, 'V'
 559+ D88B 1E 1E            LD E, 30
 560+ D88D CD A3 D8         CALL DrawHudCharRow0
 561+ D890                  ; Numero de velocidad en columna 31
 562+ D890 3A B3 8C         LD A, (CurrentEnemySpeed)
 563+ D893 C6 30            ADD A, '0'
 564+ D895 1E 1F            LD E, 31
 565+ D897 CD A3 D8         CALL DrawHudCharRow0
 566+ D89A                  ; Atributos (bright white)
 567+ D89A 3E 47            LD A, $47
 568+ D89C 32 1E 58         LD (ATTR_BASE + 30), A
 569+ D89F 32 1F 58         LD (ATTR_BASE + 31), A
 570+ D8A2 C9               RET
 571+ D8A3
 572+ D8A3              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 573+ D8A3              ; A = codigo ASCII, E = columna (0-31)
 574+ D8A3              DrawHudCharRow0:
 575+ D8A3 6F               LD L, A
 576+ D8A4 26 00            LD H, 0
 577+ D8A6 29               ADD HL, HL
 578+ D8A7 29               ADD HL, HL
 579+ D8A8 29               ADD HL, HL
 580+ D8A9 01 00 3C         LD BC, $3C00
 581+ D8AC 09               ADD HL, BC                  ; HL = font data
 582+ D8AD 16 40            LD D, $40                   ; Tercio 0, scan line 0
 583+ D8AF 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 584+ D8B0 5F               LD E, A                     ; DE = dir VRAM
 585+ D8B1 06 08            LD B, 8
 586+ D8B3              .row0Char:
 587+ D8B3 7E               LD A, (HL)
 588+ D8B4 12               LD (DE), A
 589+ D8B5 23               INC HL
 590+ D8B6 14               INC D                       ; siguiente scan line
 591+ D8B7 10 FA            DJNZ .row0Char
 592+ D8B9 C9               RET
 593+ D8BA
 594+ D8BA              ; ==============================================================================
 595+ D8BA              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 596+ D8BA              ; ==============================================================================
 597+ D8BA              DrawTimeIndicator:
 598+ D8BA                  ; Calcular puntero al label de 2 chars
 599+ D8BA 3A 00 D6         LD A, (CurrentTimeOfDay)
 600+ D8BD 87               ADD A, A                    ; A = momento * 2
 601+ D8BE 5F               LD E, A
 602+ D8BF 16 00            LD D, 0
 603+ D8C1 21 C1 D9         LD HL, TimeLabels
 604+ D8C4 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 605+ D8C5
 606+ D8C5                  ; Primer caracter en columna 30
 607+ D8C5 7E               LD A, (HL)
 608+ D8C6 E5               PUSH HL
 609+ D8C7 1E 1E            LD E, 30
 610+ D8C9 CD DD D8         CALL DrawHudChar
 611+ D8CC E1               POP HL
 612+ D8CD
 613+ D8CD                  ; Segundo caracter en columna 31
 614+ D8CD 23               INC HL
 615+ D8CE 7E               LD A, (HL)
 616+ D8CF 1E 1F            LD E, 31
 617+ D8D1 CD DD D8         CALL DrawHudChar
 618+ D8D4
 619+ D8D4                  ; Atributos del indicador (bright white on black)
 620+ D8D4 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 621+ D8D7 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 622+ D8D9 77               LD (HL), A
 623+ D8DA 23               INC HL
 624+ D8DB 77               LD (HL), A
 625+ D8DC C9               RET
 626+ D8DD
 627+ D8DD              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 628+ D8DD              ; A = codigo ASCII, E = columna (0-31)
 629+ D8DD              DrawHudChar:
 630+ D8DD                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 631+ D8DD 6F               LD L, A
 632+ D8DE 26 00            LD H, 0
 633+ D8E0 29               ADD HL, HL
 634+ D8E1 29               ADD HL, HL
 635+ D8E2 29               ADD HL, HL
 636+ D8E3 01 00 3C         LD BC, $3C00
 637+ D8E6 09               ADD HL, BC                  ; HL = font data
 638+ D8E7
 639+ D8E7                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 640+ D8E7 16 40            LD D, $40                   ; Tercio 0, scan line 0
 641+ D8E9 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 642+ D8EB 83               ADD A, E
 643+ D8EC 5F               LD E, A                     ; DE = dir VRAM
 644+ D8ED
 645+ D8ED 06 08            LD B, 8
 646+ D8EF              .hudCharLoop:
 647+ D8EF 7E               LD A, (HL)
 648+ D8F0 12               LD (DE), A
 649+ D8F1 23               INC HL
 650+ D8F2 14               INC D                       ; Siguiente scan line
 651+ D8F3 10 FA            DJNZ .hudCharLoop
 652+ D8F5 C9               RET
