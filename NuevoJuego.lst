  71+ 6E68 06               DEFB ROUL_MUSHROOM
  72+ 6E69 02               DEFB ROUL_HEALTH
  73+ 6E6A 05               DEFB ROUL_CARACOL
  74+ 6E6B 07               DEFB ROUL_COMPASS
  75+ 6E6C 06               DEFB ROUL_MUSHROOM
  76+ 6E6D 03               DEFB ROUL_STAMINA
  77+ 6E6E 04               DEFB ROUL_RAYO
  78+ 6E6F 05               DEFB ROUL_CARACOL
