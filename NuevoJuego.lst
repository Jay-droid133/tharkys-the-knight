 378+ EA7E                  ; Necesita redraw? screen cambio, PrevDist == $FF, o wobble activo.
 379+ EA7E 3A 08 82         LD A, (CurrentScreenX)
 380+ EA81 47               LD B, A
 381+ EA82 3A E6 81         LD A, (LastCompassScreenX)
 382+ EA85 B8               CP B
 383+ EA86 20 16            JR NZ, .dcRedraw
 384+ EA88 3A 09 82         LD A, (CurrentScreenY)
 385+ EA8B 47               LD B, A
 386+ EA8C 3A E7 81         LD A, (LastCompassScreenY)
 387+ EA8F B8               CP B
 388+ EA90 20 0C            JR NZ, .dcRedraw
 389+ EA92 3A E5 81         LD A, (PreviousObjectiveDistance)
 390+ EA95 FE FF            CP $FF
 391+ EA97 28 05            JR Z, .dcRedraw
 392+ EA99 3A E8 81         LD A, (CompassWobbleCounter)
