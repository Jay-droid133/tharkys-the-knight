1404+ 979B 13               INC DE
1405+ 979C FE FF            CP $FF
1406+ 979E 28 58            JR Z, .ffzSkip                          ; inalcanzable
1407+ 97A0 32 33 98         LD (.ffzCurDist), A                     ; cachear dist
1408+ 97A3                  ; Bounds del sprite 24x24
1409+ 97A3 78               LD A, B
1410+ 97A4 FE 1E            CP FFZ_MAX_CX + 1
1411+ 97A6 30 50            JR NC, .ffzSkip
1412+ 97A8 79               LD A, C
1413+ 97A9 FE 11            CP FFZ_MAX_CY + 1
