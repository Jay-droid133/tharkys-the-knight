7611+ CC84                  ; Activar phase 1 del respawn al boot/game-restart: 4 pitidos (3 cortos +
7612+ CC84                  ; GO largo) + grace de 1s con control. Durante phase 1: input zero,
7613+ CC84                  ; nasties bloqueados, Death no aparece. Tras urb1AfterBeep: SpawnTimer
7614+ CC84                  ; reseteado a SPAWN_INTERVAL -> nasties cuentan desde que el player
7615+ CC84                  ; recupera el control. Mismo flujo que tras una muerte.
7616+ CC84 3E 01            LD A, 1
7617+ CC86 32 EB 82         LD (PlayerRespawnPhase), A
7618+ CC89 C9               RET
7619+ CC8A
7620+ CC8A              OnPlayerHealthDepleted:
7621+ CC8A                  ; Cancelar magic compass: el power-up se pierde con la muerte (refuerza
7622+ CC8A                  ; coste real). Idempotente si no estaba activo.
7623+ CC8A CD B1 72         CALL CancelMagicCompass
7624+ CC8D                  ; Silenciar inmediatamente cualquier musica activa (DeathMusic o cualquier
7625+ CC8D                  ; otra). Va ANTES de AY_PlayPlayerDeath: ambos usan canal B, sin este stop
7626+ CC8D                  ; el sweep clobbearia residuos. Es el punto canonico de "player muere"
7627+ CC8D                  ; (combate, Death catch, drain de salud por cualquier via).
7628+ CC8D F5               PUSH AF
7629+ CC8E 3E FF            LD A, $FF
7630+ CC90 CD A0 9C         CALL StartMusic
7631+ CC93 F1               POP AF
7632+ CC94                  ; SFX de muerte (sweep largo agudo→muy grave + decay lento ~2s).
7633+ CC94                  ; No bloqueante, canal B. Va antes que el resto para no perder el ataque.
7634+ CC94 CD 57 6D         CALL AY_PlayPlayerDeath
7635+ CC97                  ; Congelar tiempo (silencioso, sin parpadeo de la esfera). El feedback
7636+ CC97                  ; visual ya viene del border yellow/red. Limpiado en urb1LastBeat.
7637+ CC97 3E 02            LD A, 2
7638+ CC99 32 B3 82         LD (TimeFrozen), A
7639+ CC9C                  ; Guardar tumba en la posicion donde ha muerto (player POSX/POSY actuales)
7640+ CC9C CD 7E 6B         CALL TombStore
7641+ CC9F                  ; Despawn de todos los nasties activos con puff (visual de "shockwave")
7642+ CC9F CD CD BC         CALL KillAllActiveNasties
7643+ CCA2                  ; La muerte (slot 11) tambien desaparece, pero sin puff
7644+ CCA2 CD 9B BD         CALL SilentKillDeath
7645+ CCA5                  ; Monsters quedan congelados mirando al cadaver hasta que vuelva el control
7646+ CCA5 CD B6 BD         CALL FreezeMonstersFacingCorpse
7647+ CCA8                  ; Trigger del flash del borde: 2s amarillo (anim muerte) + 3s rojo (invisible) o GAME OVER
7648+ CCA8 CD 51 CD         CALL TriggerDeathBorder
7649+ CCAB                  ; Override sprite a frame 0 de la anim de muerte. ProcessPlayer en la
7650+ CCAB                  ; siguiente frame hara .plDoErase (erase del sprite anterior + draw del
7651+ CCAB                  ; nuevo) automaticamente porque SPRITEID != OLDSPRID.
7652+ CCAB DD 21 9B 81      LD IX, EntityTable
7653+ CCAF                  ; Base de la anim segun lastHDir (bits 4-7 de ENT_DIR): DIR_W<<4 = $80
7654+ CCAF DD 7E 0A         LD A, (IX+ENT_DIR)
7655+ CCB2 E6 80            AND $80
7656+ CCB4 3E 6E            LD A, SPRID_PLAYER_DEATH            ; default = right base (110)
7657+ CCB6 28 02            JR Z, .ophdRightBase
7658+ CCB8 3E 71            LD A, SPRID_PLAYER_DEATH_LEFT       ; lastHDir = W → left base (113)
7659+ CCBA              .ophdRightBase:
7660+ CCBA DD 77 00         LD (IX+ENT_SPRITEID), A
7661+ CCBD DD 36 06 00      LD (IX+ENT_DELTAX), 0
7662+ CCC1 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7663+ CCC5 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7664+ CCC7 32 E9 82         LD (PlayerDeathAnimTimer), A
7665+ CCCA AF               XOR A
7666+ CCCB 32 EA 82         LD (PlayerDeathAnimFrame), A
7667+ CCCE                  ; Decrementar vida (clamp a 0)
7668+ CCCE 3A DE 82         LD A, (PlayerLives)
7669+ CCD1 B7               OR A
7670+ CCD2 C8               RET Z
7671+ CCD3 3D               DEC A
7672+ CCD4 32 DE 82         LD (PlayerLives), A
7673+ CCD7 C9               RET
7674+ CCD8
7675+ CCD8              ; --- ErasePlayerSpriteAtOldPos: XOR-redraw del ultimo sprite + restore attrs ---
7676+ CCD8              ; Mismo patron que .plDoErase: GetOldSpriteAddr -> DrawSprite -> RestoreOldAttr.
7677+ CCD8              ErasePlayerSpriteAtOldPos:
7678+ CCD8 DD 21 9B 81      LD IX, EntityTable
7679+ CCDC CD DA A7         CALL GetOldSpriteAddr
7680+ CCDF DD 56 0D         LD D, (IX+ENT_OLDY)
7681+ CCE2 DD 7E 0C         LD A, (IX+ENT_OLDX)
7682+ CCE5 5F               LD E, A
7683+ CCE6 DD E5            PUSH IX
7684+ CCE8 DD 2A 62 A7      LD IX, (OldSprAddr)
7685+ CCEC CD CD 9C         CALL DrawSprite
7686+ CCEF DD E1            POP IX
7687+ CCF1 DD 56 0D         LD D, (IX+ENT_OLDY)
7688+ CCF4 DD 5E 0C         LD E, (IX+ENT_OLDX)
7689+ CCF7 C3 80 D5         JP RestoreOldAttr                   ; tail-call
7690+ CCFA
7691+ CCFA              ; --- RespawnPlayerAtEntry: mover a LastEntryPos, refill HP/stamina, NEWSPAWN ---
7692+ CCFA              RespawnPlayerAtEntry:
7693+ CCFA DD 21 9B 81      LD IX, EntityTable
7694+ CCFE 3A 0E 83         LD A, (LastEntryPosX)
7695+ CD01 DD 77 03         LD (IX+ENT_POSX), A
7696+ CD04 DD 77 0C         LD (IX+ENT_OLDX), A
7697+ CD07 DD 77 0F         LD (IX+ENT_DRAWX), A
7698+ CD0A 3A 0F 83         LD A, (LastEntryPosY)
7699+ CD0D DD 77 04         LD (IX+ENT_POSY), A
7700+ CD10 DD 77 0D         LD (IX+ENT_OLDY), A
7701+ CD13 3E 10            LD A, HEALTH_MAX
7702+ CD15 32 F2 B5         LD (PlayerHealth), A
7703+ CD18 3E 10            LD A, STAMINA_MAX
7704+ CD1A 32 F3 B5         LD (PlayerStamina), A
7705+ CD1D DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
7706+ CD21 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
7707+ CD25 DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
7708+ CD29 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
7709+ CD2D DD 36 06 00      LD (IX+ENT_DELTAX), 0
7710+ CD31 DD 36 07 00      LD (IX+ENT_DELTAY), 0
7711+ CD35                  ; Reset color a blanco + cooldowns: si moriste con AttackCooldown activo
7712+ CD35                  ; (modo B post-swing), ENT_ATTR estaba en BLUE. Sin esto, el azul stale
7713+ CD35                  ; persiste tras respawn porque SelectSwordMode ve stamina=MAX -> modo
7714+ CD35                  ; libre, y .swordModeFree no toca el color.
7715+ CD35 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7716+ CD39 AF               XOR A
7717+ CD3A 32 EE B5         LD (AttackCooldown), A
7718+ CD3D 32 ED B5         LD (AttackTimer), A
7719+ CD40 DD CB 0B DE      SET ENTF_NEWSPAWN, (IX+ENT_FLAGS)
7720+ CD44                  ; Activar phase 1 del respawn: countdown 3-2-1 con bips.
7721+ CD44                  ; Timer=0 -> primer beat al siguiente frame. BeatIdx=0.
7722+ CD44 3E 01            LD A, 1
7723+ CD46 32 EB 82         LD (PlayerRespawnPhase), A
7724+ CD49 AF               XOR A
7725+ CD4A 32 EC 82         LD (PlayerRespawnTimer), A
7726+ CD4D 32 EF 82         LD (PlayerRespawnBeatIdx), A
7727+ CD50 C9               RET
7728+ CD51
7729+ CD51              ; ==============================================================================
7730+ CD51              ; TriggerDeathBorder - arranca el flash del borde tras morir
7731+ CD51              ; ==============================================================================
7732+ CD51              ; Phase 1 (yellow) DEATH_BORDER_YELLOW_FRAMES, luego phase 2 (red) DEATH_BORDER_RED_FRAMES,
7733+ CD51              ; luego vuelve a negro y se desactiva.
7734+ CD51              ; ==============================================================================
7735+ CD51              TriggerDeathBorder:
7736+ CD51 3E 01            LD A, 1
7737+ CD53 32 E7 82         LD (DeathBorderPhase), A
7738+ CD56 3E 32            LD A, DEATH_BORDER_YELLOW_FRAMES
7739+ CD58 32 E8 82         LD (DeathBorderTimer), A
7740+ CD5B 3E 06            LD A, YELLOW
7741+ CD5D 32 83 90         LD (CurrentBorderColor), A
7742+ CD60 D3 FE            OUT (254), A
7743+ CD62 C9               RET
7744+ CD63
7745+ CD63              ; ==============================================================================
7746+ CD63              ; UpdateRespawnBlink - state machine post-respawn (countdown audio + grace timer)
7747+ CD63              ; ==============================================================================
7748+ CD63              ; Phase 1: countdown "3, 2, 1" con 3 bips bloqueantes (sin control, invulnerable).
7749+ CD63              ; Phase 2: 2s grace (con control, invulnerable). No hay efecto visual de momento.
7750+ CD63              ; ==============================================================================
7751+ CD63              UpdateRespawnBlink:
7752+ CD63 3A EB 82         LD A, (PlayerRespawnPhase)
7753+ CD66 B7               OR A
7754+ CD67 C8               RET Z
7755+ CD68 3D               DEC A
7756+ CD69 28 0D            JR Z, .urbPhase1
7757+ CD6B                  ; Phase 2: solo timer (sin parpadeo)
7758+ CD6B 3A EC 82         LD A, (PlayerRespawnTimer)
7759+ CD6E 3D               DEC A
7760+ CD6F 32 EC 82         LD (PlayerRespawnTimer), A
7761+ CD72 C0               RET NZ
7762+ CD73 AF               XOR A
7763+ CD74 32 EB 82         LD (PlayerRespawnPhase), A
7764+ CD77 C9               RET
7765+ CD78
7766+ CD78              .urbPhase1:
7767+ CD78                  ; Phase 1: countdown 3-2-1 con bips bloqueantes y silencios entre ellos.
7768+ CD78                  ; Zero input (sin control)
7769+ CD78 AF               XOR A
7770+ CD79 32 AB 82         LD (InputDirection), A
7771+ CD7C 32 AC 82         LD (InputFire), A
7772+ CD7F                  ; Blink sync con beep audible: BeepDurationFrames != 0 (sonando) → IDLE,
7773+ CD7F                  ; == 0 (silencio) → PLAYER_BLANK. Sin RAM extra (variable ya existente).
7774+ CD7F 3A 4C 6D         LD A, (BeepDurationFrames)
7775+ CD82 D6 01            SUB 1                               ; CY si era 0 (silencio)
7776+ CD84 9F               SBC A, A                            ; $FF si silencio, $00 si sonando
7777+ CD85 E6 74            AND SPRID_PLAYER_BLANK
7778+ CD87 32 9B 81         LD (EntityTable), A
7779+ CD8A                  ; Si Timer > 0 estamos en silencio entre beats: tickear y volver
7780+ CD8A 3A EC 82         LD A, (PlayerRespawnTimer)
7781+ CD8D B7               OR A
7782+ CD8E 28 05            JR Z, .urb1FireBeat
7783+ CD90 3D               DEC A
7784+ CD91 32 EC 82         LD (PlayerRespawnTimer), A
7785+ CD94 C9               RET
7786+ CD95              .urb1FireBeat:
7787+ CD95 3A EF 82         LD A, (PlayerRespawnBeatIdx)
7788+ CD98 3C               INC A
7789+ CD99 32 EF 82         LD (PlayerRespawnBeatIdx), A
7790+ CD9C FE 04            CP 4
7791+ CD9E 28 12            JR Z, .urb1LastBeat
7792+ CDA0 FE 05            CP 5
7793+ CDA2 28 1C            JR Z, .urb1AfterBeep        ; beat 5 = "post-GO": grace tras beep largo
7794+ CDA4                  ; Beats 1, 2, 3: pitido corto BASIC-BEEP-style (vol fija + cutoff abrupto)
7795+ CDA4 21 C0 00         LD HL, $00C0                ; ~569 Hz (≈D5, 7 semitonos bajo el A5 original)
7796+ CDA7 06 04            LD B, 4                     ; ~160 ms (4 frames @ 25fps)
7797+ CDA9 CD 7A 6D         CALL AY_PlayBeep
7798+ CDAC                  ; Intervalo entre beeps: 20 frames @ 25fps = 0.8 s. El blink usa CP 10
7799+ CDAC                  ; (mitad) para mantener ON/OFF ~50/50.
7800+ CDAC 3E 14            LD A, 20
7801+ CDAE 32 EC 82         LD (PlayerRespawnTimer), A
7802+ CDB1 C9               RET
7803+ CDB2              .urb1LastBeat:
7804+ CDB2                  ; Beat 4: pitido octava arriba mas largo (= "GO!"). Vol max sostenida +
7805+ CDB2                  ; cutoff abrupto tras 11 frames (~440 ms). NO entra en grace todavia:
7806+ CDB2                  ; setea timer = 11 (= duracion del beep) → el siguiente fire (idx=5)
7807+ CDB2                  ; entra grace EXACTAMENTE al terminar el beep.
7808+ CDB2 21 60 00         LD HL, $0060                ; ~1139 Hz (≈D6, octava arriba del corto, 7 semitonos bajo el A6 original)
7809+ CDB5 06 0B            LD B, 11                    ; ~440 ms (11 frames @ 25fps)
7810+ CDB7 CD 7A 6D         CALL AY_PlayBeep
7811+ CDBA 3E 0B            LD A, 11                    ; espera = duracion del beep
7812+ CDBC 32 EC 82         LD (PlayerRespawnTimer), A
7813+ CDBF C9               RET
7814+ CDC0              .urb1AfterBeep:
7815+ CDC0                  ; Beep largo terminado. Phase 2 = control vuelve. Resets ligados al fin
7816+ CDC0                  ; del countdown (igual que la version v3 anterior, solo movidos aqui).
7817+ CDC0 CD D9 CD         CALL EnterGracePhase            ; phase 2 + timer = RESPAWN_GRACE_FRAMES
7818+ CDC3 3E 0C            LD A, SPAWN_INTERVAL
7819+ CDC5 32 F5 82         LD (SpawnTimer), A
7820+ CDC8 AF               XOR A
7821+ CDC9 32 FA 82         LD (DeathSpawned), A
7822+ CDCC 32 F0 82         LD (MonstersFrozen), A          ; Liberar monsters: AI normal vuelve
7823+ CDCF 32 B3 82         LD (TimeFrozen), A              ; Reanudar reloj
7824+ CDD2 21 00 00         LD HL, 0
7825+ CDD5 22 F7 82         LD (DeathScreenTimer), HL       ; 16-bit reset
7826+ CDD8 C9               RET
7827+ CDD9
7828+ CDD9              ; ==============================================================================
7829+ CDD9              ; EnterGracePhase - Activa Phase 2 (gracia con blink) por RESPAWN_GRACE_FRAMES
7830+ CDD9              ; ==============================================================================
7831+ CDD9              ; Llamado desde:
7832+ CDD9              ;   - urb1LastBeat: tras los 3 pitidos del countdown del respawn.
7833+ CDD9              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero: tras cada hit de nasty/monster.
7834+ CDD9              ; Activa invulnerabilidad (.playerHit chequea PlayerRespawnPhase != 0) y blink
7835+ CDD9              ; (UpdatePlayer chequea PlayerRespawnTimer != 0).
7836+ CDD9              ; ==============================================================================
7837+ CDD9              EnterGracePhase:
7838+ CDD9 3E 02            LD A, 2
7839+ CDDB 32 EB 82         LD (PlayerRespawnPhase), A
7840+ CDDE 3E 19            LD A, RESPAWN_GRACE_FRAMES
7841+ CDE0 32 EC 82         LD (PlayerRespawnTimer), A
7842+ CDE3 C9               RET
7843+ CDE4
7844+ CDE4              ; ==============================================================================
7845+ CDE4              ; UpdateDeathAnim - tick de la anim de muerte del player durante phase 1 (yellow)
7846+ CDE4              ; ==============================================================================
7847+ CDE4              ; Avanza ENT_SPRITEID +1 cada PLAYER_DEATH_ANIM_DELAY frames. La base (110 right
7848+ CDE4              ; o 113 left) se fija en OnPlayerHealthDepleted; aqui solo incrementamos.
7849+ CDE4              ; Al llegar al ultimo frame, se queda ahi (resto del yellow en frame final).
7850+ CDE4              ; ==============================================================================
7851+ CDE4              UpdateDeathAnim:
7852+ CDE4 3A E7 82         LD A, (DeathBorderPhase)
7853+ CDE7 FE 01            CP 1
7854+ CDE9 C0               RET NZ
7855+ CDEA 3A E9 82         LD A, (PlayerDeathAnimTimer)
7856+ CDED 3D               DEC A
7857+ CDEE 32 E9 82         LD (PlayerDeathAnimTimer), A
7858+ CDF1 C0               RET NZ
7859+ CDF2                  ; Tick consumido: avanzar frame
7860+ CDF2 3A EA 82         LD A, (PlayerDeathAnimFrame)
7861+ CDF5 3C               INC A
7862+ CDF6 FE 03            CP PLAYER_DEATH_ANIM_FRAMES
7863+ CDF8 D0               RET NC                              ; ya en ultimo frame (clamp)
7864+ CDF9 32 EA 82         LD (PlayerDeathAnimFrame), A
7865+ CDFC DD 21 9B 81      LD IX, EntityTable
7866+ CE00 DD 34 00         INC (IX+ENT_SPRITEID)               ; siguiente frame de la anim
7867+ CE03                  ; Al entrar en el ULTIMO frame (= "desparramado en el suelo") reproducir
7868+ CE03                  ; el SFX del puff (mismo que la muerte de un nasty). El A actual contiene
7869+ CE03                  ; el frame recien escrito; comparamos con el ultimo (FRAMES-1).
7870+ CE03 FE 02            CP PLAYER_DEATH_ANIM_FRAMES - 1
7871+ CE05 20 06            JR NZ, .udaSkipSplatSfx
7872+ CE07 21 A2 F9         LD HL, SFX_EnemyDeath
7873+ CE0A CD 23 F9         CALL PlaySFX
7874+ CE0D              .udaSkipSplatSfx:
7875+ CE0D 3E 0D            LD A, PLAYER_DEATH_ANIM_DELAY
7876+ CE0F 32 E9 82         LD (PlayerDeathAnimTimer), A
7877+ CE12 C9               RET
7878+ CE13
7879+ CE13              ; ==============================================================================
7880+ CE13              ; UpdateDeathBorder - tick por frame; transiciona fase amarillo -> rojo -> negro
7881+ CE13              ; ==============================================================================
7882+ CE13              UpdateDeathBorder:
7883+ CE13 3A E7 82         LD A, (DeathBorderPhase)
7884+ CE16 B7               OR A
7885+ CE17 C8               RET Z
7886+ CE18 3A E8 82         LD A, (DeathBorderTimer)
7887+ CE1B 3D               DEC A
7888+ CE1C 32 E8 82         LD (DeathBorderTimer), A
7889+ CE1F C0               RET NZ
7890+ CE20                  ; Timer expiro: avanzar fase
7891+ CE20 3A E7 82         LD A, (DeathBorderPhase)
7892+ CE23 FE 01            CP 1
7893+ CE25 20 33            JR NZ, .udbToBlack
7894+ CE27                  ; --- Fin fase amarillo ---
7895+ CE27                  ; Si PlayerLives==0 -> game over directo (sin pasar por rojo).
7896+ CE27                  ; Si quedan vidas -> fase rojo 3s + sprite a BLANK (player invisible).
7897+ CE27 3A DE 82         LD A, (PlayerLives)
7898+ CE2A B7               OR A
7899+ CE2B 28 1F            JR Z, .udbToGameOver
7900+ CE2D DD 21 9B 81      LD IX, EntityTable
7901+ CE31 DD 36 00 74      LD (IX+ENT_SPRITEID), SPRID_PLAYER_BLANK
7902+ CE35 3E 02            LD A, 2
7903+ CE37 32 E7 82         LD (DeathBorderPhase), A
7904+ CE3A 3E 32            LD A, DEATH_BORDER_RED_FRAMES
7905+ CE3C 32 E8 82         LD (DeathBorderTimer), A
7906+ CE3F 3E 02            LD A, RED
7907+ CE41 32 83 90         LD (CurrentBorderColor), A
7908+ CE44 D3 FE            OUT (254), A
7909+ CE46                  ; Pedir tumba in-place: ProcessPlayer va a borrar el sprite muerte este
7910+ CE46                  ; mismo frame; DrawPendingTomb (tras ProcessPlayer) la pintara encima.
7911+ CE46 3E 01            LD A, 1
7912+ CE48 32 F4 82         LD (TombDrawPending), A
7913+ CE4B C9               RET
7914+ CE4C              .udbToGameOver:
7915+ CE4C                  ; Pasar borde a negro y disparar pantalla GAME OVER (reemplaza al rojo).
7916+ CE4C AF               XOR A
7917+ CE4D 32 E7 82         LD (DeathBorderPhase), A
7918+ CE50 3E 00            LD A, BLACK
7919+ CE52 32 83 90         LD (CurrentBorderColor), A
7920+ CE55 D3 FE            OUT (254), A
7921+ CE57 C3 68 CE         JP ShowGameOver
7922+ CE5A              .udbToBlack:
7923+ CE5A                  ; Phase 2 (rojo) terminado -> negro + respawn del player en LastEntryPos
7924+ CE5A AF               XOR A
7925+ CE5B 32 E7 82         LD (DeathBorderPhase), A
7926+ CE5E 3E 00            LD A, BLACK
7927+ CE60 32 83 90         LD (CurrentBorderColor), A
7928+ CE63 D3 FE            OUT (254), A
7929+ CE65 C3 FA CC         JP RespawnPlayerAtEntry             ; tail-call
7930+ CE68
7931+ CE68              ; ==============================================================================
7932+ CE68              ; ShowGameOver - solo arma el flag; MainLoop pinta la pantalla en la siguiente iter
7933+ CE68              ; ==============================================================================
7934+ CE68              ; Llamado desde mid-frame en OnPlayerHealthDepleted. NO pinta aqui porque el
7935+ CE68              ; resto del frame (ProcessEnemies, HUD, etc.) sobreescribiria la pantalla.
7936+ CE68              ; MainLoop al ver GameOver=1 hace PaintGameOverScreen y pasa a GameOver=2.
7937+ CE68              ; ==============================================================================
7938+ CE68              ShowGameOver:
7939+ CE68 3E 01            LD A, 1
7940+ CE6A 32 DF 82         LD (GameOver), A
7941+ CE6D C9               RET
7942+ CE6E
7943+ CE6E              ; --- PaintGameOverScreen: wipe + init moonwalk anim. Llamado UNA vez por MainLoop. ---
7944+ CE6E              ; La animacion en si la dibuja UpdateGameOverAnim cada frame mientras GameOver=2.
7945+ CE6E              PaintGameOverScreen:
7946+ CE6E                  ; Wipe pixels
7947+ CE6E 21 00 40         LD HL, $4000
7948+ CE71 11 01 40         LD DE, $4001
7949+ CE74 01 FF 17         LD BC, $17FF
7950+ CE77 36 00            LD (HL), 0
7951+ CE79 ED B0            LDIR
7952+ CE7B                  ; Attrs $47 (white ink, black paper, bright) en toda la pantalla
7953+ CE7B 21 00 58         LD HL, $5800
7954+ CE7E 11 01 58         LD DE, $5801
7955+ CE81 01 FF 02         LD BC, $02FF
7956+ CE84 36 47            LD (HL), $47
7957+ CE86 ED B0            LDIR
7958+ CE88                  ; Tumba 2x centrada (sprite ID 144, "little house cemetery") sobre la que
7959+ CE88                  ; la muerte hará el moonwalk. Cold path: 1 vez por partida.
7960+ CE88 CD D2 77         CALL DrawTombstone2xCentered
7961+ CE8B                  ; Init anim moonwalk: empieza en X_MAX facing R (slide left).
7962+ CE8B 3E 88            LD A, GAMEOVER_ANIM_X_MAX
7963+ CE8D 32 E0 82         LD (GameOverAnimX), A
7964+ CE90 AF               XOR A
7965+ CE91 32 E1 82         LD (GameOverAnimDir), A
7966+ CE94 32 E2 82         LD (GameOverAnimFrame), A
7967+ CE97 32 E6 82         LD (GameOverAnimLastX), A
7968+ CE9A 21 00 00         LD HL, 0
7969+ CE9D 22 E4 82         LD (GameOverAnimLastSpr), HL    ; Sin erase la primera vez
7970+ CEA0 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
7971+ CEA2 32 E3 82         LD (GameOverAnimFrameTimer), A
7972+ CEA5                  ; Jingle de game over (track 3). UpdateMusic se llama cada frame en MainLoop
7973+ CEA5                  ; antes del guard de GameOver, asi que la pista sigue avanzando con el juego
7974+ CEA5                  ; congelado en GameOver=2.
7975+ CEA5 3E 03            LD A, 3
7976+ CEA7 C3 A0 9C         JP StartMusic                   ; tail-call
7977+ CEAA
7978+ CEAA              ; ==============================================================================
7979+ CEAA              ; UpdateGameOverAnim — Death moonwalkea por la pantalla negra
7980+ CEAA              ; ==============================================================================
7981+ CEAA              ; Llamado cada frame desde MainLoop mientras GameOver=2. Anim ping-pong:
7982+ CEAA              ;   dir=0 → slide LEFT  (X: MAX → 0) usando sprites de movimiento DERECHO
7983+ CEAA              ;   dir=1 → slide RIGHT (X: 0 → MAX) usando sprites de movimiento IZQUIERDO
7984+ CEAA              ; Sprites invertidos vs direccion = efecto moonwalk: el cuerpo desliza al
7985+ CEAA              ; contrario de los pies. Aprovecha que en este juego SprDeath_0/1 son el par
7986+ CEAA              ; usado para DELTAX<0 (mover izquierda) y SprDeath_L0/L1 para DELTAX>0.
7987+ CEAA              ; XOR-erase con el ptr+X guardado del frame anterior. Toggle del frame interno
7988+ CEAA              ; cada FRAME_TICKS frames. Init via PaintGameOverScreen.
7989+ CEAA              ;
7990+ CEAA              ; X bound a [0, 224] para que el sprite 24x24 no overflow VRAM en path
7991+ CEAA              ; shifted (que ocupa 4 chars = 32 px).
7992+ CEAA              ; ==============================================================================
7993+ CEAA              ; Tumba 2x ocupa pixel Y range 80..159 (charY 10..19). La muerte (24x24) baila
7994+ CEAA              ; justo encima del techo: Y_top=56 → Y_bottom=79, 1 px de hueco al techo.
7995+ CEAA              ; X swing centrado sobre la tumba:
7996+ CEAA              ;   X_MIN: 96  = char 12 (2 chars dentro del borde izq de la tumba en char 10)
7997+ CEAA              ;   X_MAX: 136 = char 17 (3 chars dentro del borde der de la tumba en char 22)
7998+ CEAA              ;   Death sprite 24 px wide → visual cubre chars 12..19 (centrado).
7999+ CEAA              GAMEOVER_ANIM_Y           EQU 56
8000+ CEAA              GAMEOVER_ANIM_X_MIN       EQU 96
8001+ CEAA              GAMEOVER_ANIM_X_MAX       EQU 136
8002+ CEAA              GAMEOVER_ANIM_FRAME_TICKS EQU 6
8003+ CEAA
8004+ CEAA              UpdateGameOverAnim:
8005+ CEAA                  ; --- Erase del sprite previo (si lo hubo) ---
8006+ CEAA 2A E4 82         LD HL, (GameOverAnimLastSpr)
8007+ CEAD 7C               LD A, H
8008+ CEAE B5               OR L
8009+ CEAF 28 0C            JR Z, .ugoaNoErase
8010+ CEB1 E5               PUSH HL
8011+ CEB2 DD E1            POP IX
8012+ CEB4 3A E6 82         LD A, (GameOverAnimLastX)
8013+ CEB7 5F               LD E, A
8014+ CEB8 16 38            LD D, GAMEOVER_ANIM_Y
8015+ CEBA CD CD 9C         CALL DrawSprite
8016+ CEBD              .ugoaNoErase:
8017+ CEBD
8018+ CEBD                  ; --- Tick frame timer (R0 ↔ R1 cada FRAME_TICKS frames) ---
8019+ CEBD 3A E3 82         LD A, (GameOverAnimFrameTimer)
8020+ CEC0 3D               DEC A
8021+ CEC1 20 0A            JR NZ, .ugoaTimerSet
8022+ CEC3 3A E2 82         LD A, (GameOverAnimFrame)
8023+ CEC6 EE 01            XOR 1
8024+ CEC8 32 E2 82         LD (GameOverAnimFrame), A
8025+ CECB 3E 06            LD A, GAMEOVER_ANIM_FRAME_TICKS
8026+ CECD              .ugoaTimerSet:
8027+ CECD 32 E3 82         LD (GameOverAnimFrameTimer), A
8028+ CED0
8029+ CED0                  ; --- Avanzar X segun direccion (ping-pong) ---
8030+ CED0 3A E1 82         LD A, (GameOverAnimDir)
8031+ CED3 B7               OR A
8032+ CED4 20 14            JR NZ, .ugoaSlideRight
8033+ CED6                  ; Dir 0: facing R, slide LEFT (X--)
8034+ CED6 3A E0 82         LD A, (GameOverAnimX)
8035+ CED9 FE 60            CP GAMEOVER_ANIM_X_MIN
8036+ CEDB 28 06            JR Z, .ugoaFlipToL
8037+ CEDD 3D               DEC A
8038+ CEDE 32 E0 82         LD (GameOverAnimX), A
8039+ CEE1 18 18            JR .ugoaPickSprite
8040+ CEE3              .ugoaFlipToL:
8041+ CEE3 3E 01            LD A, 1
8042+ CEE5 32 E1 82         LD (GameOverAnimDir), A
8043+ CEE8 18 11            JR .ugoaPickSprite
8044+ CEEA              .ugoaSlideRight:
8045+ CEEA                  ; Dir 1: facing L, slide RIGHT (X++)
8046+ CEEA 3A E0 82         LD A, (GameOverAnimX)
8047+ CEED FE 88            CP GAMEOVER_ANIM_X_MAX
8048+ CEEF 28 06            JR Z, .ugoaFlipToR
8049+ CEF1 3C               INC A
8050+ CEF2 32 E0 82         LD (GameOverAnimX), A
8051+ CEF5 18 04            JR .ugoaPickSprite
8052+ CEF7              .ugoaFlipToR:
8053+ CEF7 AF               XOR A
8054+ CEF8 32 E1 82         LD (GameOverAnimDir), A
8055+ CEFB
8056+ CEFB              .ugoaPickSprite:
8057+ CEFB                  ; Moonwalk: usar sprites del eje OPUESTO al deslizamiento.
8058+ CEFB                  ;   dir=0 (slide L) → par L (sprites de "mover derecha")
8059+ CEFB                  ;   dir=1 (slide R) → par R (sprites de "mover izquierda")
8060+ CEFB 3A E1 82         LD A, (GameOverAnimDir)
8061+ CEFE B7               OR A
8062+ CEFF 20 0E            JR NZ, .ugoaPickR
8063+ CF01 3A E2 82         LD A, (GameOverAnimFrame)
8064+ CF04 B7               OR A
8065+ CF05 21 DF DD         LD HL, SprDeath_L0
8066+ CF08 28 11            JR Z, .ugoaSprSet
8067+ CF0A 21 29 DE         LD HL, SprDeath_L1
8068+ CF0D 18 0C            JR .ugoaSprSet
8069+ CF0F              .ugoaPickR:
8070+ CF0F 3A E2 82         LD A, (GameOverAnimFrame)
