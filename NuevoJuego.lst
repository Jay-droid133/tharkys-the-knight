 495  99E6                  INCLUDE "engine_graphics.asm"
# file opened: engine_graphics.asm
   1+ 99E6              ; ==============================================================================
   2+ 99E6              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99E6              ; ==============================================================================
   4+ 99E6              ; Sistema fiel a Sabre Wulf:
   5+ 99E6              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99E6              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99E6              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99E6              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99E6              ; ==============================================================================
  10+ 99E6
  11+ 99E6              ClearScreen:
  12+ 99E6 CD AF 0D         CALL ROM_CLS
  13+ 99E9 C9               RET
  14+ 99EA
  15+ 99EA              ; ==============================================================================
  16+ 99EA              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99EA              ; ==============================================================================
  18+ 99EA              ; Entrada:
  19+ 99EA              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99EA              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99EA              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99EA              ;
  23+ 99EA              ; Formato del sprite:
  24+ 99EA              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99EA              ;   DEFB height_pixels
  26+ 99EA              ;   DEFB pixel_data... (width * height bytes)
  27+ 99EA              ;
  28+ 99EA              ; Dos paths:
  29+ 99EA              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99EA              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99EA              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99EA              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99EA              ;
  34+ 99EA              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99EA              ;
  36+ 99EA              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99EA              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99EA              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99EA              ; alto la restauracion del bank.
  40+ 99EA              ; ==============================================================================
  41+ 99EA              DrawSprite:
  42+ 99EA                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99EA                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99EA                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99EA 3A 85 8D         LD A, (CurrentPaging)
  46+ 99ED E6 F8            AND $F8
  47+ 99EF F6 06            OR 6
  48+ 99F1 32 85 8D         LD (CurrentPaging), A
  49+ 99F4 01 FD 7F         LD BC, $7FFD
  50+ 99F7 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99F9 CD 0A 9A         CALL _DrawSpriteImpl
  52+ 99FC                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 99FC                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 99FC 3A 85 8D         LD A, (CurrentPaging)
  55+ 99FF E6 F8            AND $F8
  56+ 9A01 32 85 8D         LD (CurrentPaging), A
  57+ 9A04 01 FD 7F         LD BC, $7FFD
  58+ 9A07 ED 79            OUT (C), A
  59+ 9A09 C9               RET
  60+ 9A0A
  61+ 9A0A              _DrawSpriteImpl:
  62+ 9A0A                  ; Guardar posicion
  63+ 9A0A 7A               LD A, D
  64+ 9A0B 32 C4 9A         LD (.posY), A
  65+ 9A0E 7B               LD A, E
  66+ 9A0F 32 C3 9A         LD (.posX), A
  67+ 9A12
  68+ 9A12                  ; Leer cabecera sprite
  69+ 9A12 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A15 32 C5 9A         LD (.widthSave), A
  71+ 9A18 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A1B 32 C6 9A         LD (.heightSave), A
  73+ 9A1E DD 23            INC IX
  74+ 9A20 DD 23            INC IX                      ; IX → pixel data
  75+ 9A22
  76+ 9A22                  ; === Y CLIPPING ===
  77+ 9A22                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A22 3A C4 9A         LD A, (.posY)
  79+ 9A25 FE 10            CP SCREEN_MIN_Y
  80+ 9A27 30 20            JR NC, .clipTopDone
  81+ 9A29                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A29 47               LD B, A                     ; B = Y
  83+ 9A2A 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A2C 90               SUB B                       ; A = filas a saltar
  85+ 9A2D 47               LD B, A                     ; B = skip rows
  86+ 9A2E                  ; Reducir altura
  87+ 9A2E 3A C6 9A         LD A, (.heightSave)
  88+ 9A31 90               SUB B
  89+ 9A32 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A33 D8               RET C                       ; Idem
  91+ 9A34 32 C6 9A         LD (.heightSave), A
  92+ 9A37                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A37 3A C5 9A         LD A, (.widthSave)
  94+ 9A3A 4F               LD C, A
  95+ 9A3B              .clipSkipRow:
  96+ 9A3B 79               LD A, C
  97+ 9A3C              .clipSkipByte:
  98+ 9A3C DD 23            INC IX
  99+ 9A3E 3D               DEC A
 100+ 9A3F 20 FB            JR NZ, .clipSkipByte
 101+ 9A41 10 F8            DJNZ .clipSkipRow
 102+ 9A43                  ; Ajustar Y al borde
 103+ 9A43 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A45 32 C4 9A         LD (.posY), A
 105+ 9A48 57               LD D, A
 106+ 9A49              .clipTopDone:
 107+ 9A49                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A49 3A C4 9A         LD A, (.posY)
 109+ 9A4C 47               LD B, A
 110+ 9A4D 3A C6 9A         LD A, (.heightSave)
 111+ 9A50 80               ADD A, B                    ; A = Y + height
 112+ 9A51 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A53 FE C0            CP 192
 114+ 9A55 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A57              .clipBot:
 116+ 9A57                  ; Reducir altura: new_height = 192 - Y
 117+ 9A57 3E C0            LD A, 192
 118+ 9A59 90               SUB B                       ; A = 192 - Y
 119+ 9A5A C8               RET Z
 120+ 9A5B D8               RET C
 121+ 9A5C 32 C6 9A         LD (.heightSave), A
 122+ 9A5F              .clipBotDone:
 123+ 9A5F
 124+ 9A5F                  ; Comprobar alineacion
 125+ 9A5F 7B               LD A, E
 126+ 9A60 E6 07            AND 7
 127+ 9A62 20 1E            JR NZ, .shifted
 128+ 9A64
 129+ 9A64                  ; ==================================================================
 130+ 9A64                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9A64                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9A64                  ; ==================================================================
 133+ 9A64 CD 5D 9D         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9A67 DD E5            PUSH IX
 135+ 9A69 D1               POP DE                      ; DE = puntero a pixel data
 136+ 9A6A 3A C6 9A         LD A, (.heightSave)
 137+ 9A6D 4F               LD C, A                     ; C = height counter
 138+ 9A6E
 139+ 9A6E              .alignedLine:
 140+ 9A6E 3A C5 9A         LD A, (.widthSave)
 141+ 9A71 47               LD B, A                     ; B = ancho en bytes
 142+ 9A72 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A73
 144+ 9A73              .alignedByte:
 145+ 9A73 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A74 AE               XOR (HL)
 147+ 9A75 77               LD (HL), A
 148+ 9A76 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A77 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A78 10 F9            DJNZ .alignedByte
 151+ 9A7A
 152+ 9A7A E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A7B 0D               DEC C
 154+ 9A7C C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A7D CD C9 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A80 18 EC            JR .alignedLine
 157+ 9A82
 158+ 9A82                  ; ==================================================================
 159+ 9A82                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A82                  ; ==================================================================
 161+ 9A82                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A82              .shifted:
 163+ 9A82                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A82 3D               DEC A                       ; 0-6
 165+ 9A83 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A84 E6 0E            AND $0E
 167+ 9A86 C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A88 32 C7 9A         LD (.tablePage), A
 169+ 9A8B
 170+ 9A8B                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A8B DD E5            PUSH IX
 172+ 9A8D D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A8E D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A8F
 175+ 9A8F                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A8F 3A C4 9A         LD A, (.posY)
 177+ 9A92 57               LD D, A
 178+ 9A93 3A C3 9A         LD A, (.posX)
 179+ 9A96 5F               LD E, A
 180+ 9A97 CD 5D 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A9A
 182+ 9A9A D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9A9B 3A C7 9A         LD A, (.tablePage)
 184+ 9A9E 47               LD B, A                     ; B = pagina high part
 185+ 9A9F                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9A9F                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9A9F 3A C6 9A         LD A, (.heightSave)
 188+ 9AA2 DD 67            LD IXH, A
