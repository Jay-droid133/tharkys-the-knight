1710+ F68B              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1711+ F68B
1712+ F68B              ; ==============================================================================
1713+ F68B              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1714+ F68B              ; ==============================================================================
1715+ F68B              ; Indice (CompassSprites[idx]):
1716+ F68B              ;   0 = NW    1 = N    2 = NE
1717+ F68B              ;   3 = W     4 = X    5 = E
1718+ F68B              ;   6 = SW    7 = S    8 = SE
1719+ F68B              ; ==============================================================================
1720+ F68B              CompassSprites:
1721+ F68B AA F7            DEFW Sprite_Compass_NW
1722+ F68D CA F6            DEFW Sprite_Compass_N
1723+ F68F EA F6            DEFW Sprite_Compass_NE
1724+ F691 8A F7            DEFW Sprite_Compass_W
1725+ F693 CA F7            DEFW Sprite_Compass_X
1726+ F695 0A F7            DEFW Sprite_Compass_E
1727+ F697 6A F7            DEFW Sprite_Compass_SW
1728+ F699 4A F7            DEFW Sprite_Compass_S
1729+ F69B 2A F7            DEFW Sprite_Compass_SE
1730+ F69D
1731+ F69D              ; ==============================================================================
1732+ F69D              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1733+ F69D              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1734+ F69D              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1735+ F69D              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1736+ F69D              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1737+ F69D              ; ==============================================================================
1738+ F69D              CompassWobbleTable:
1739+ F69D 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1740+ F6A1 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1741+ F6A5 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1742+ F6A9 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1743+ F6AD 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1744+ F6B1 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1745+ F6B5 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1746+ F6B9 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1747+ F6BD 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1748+ F6C1
1749+ F6C1              ; ==============================================================================
1750+ F6C1              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1751+ F6C1              ; Indexada por (counter-1) -> 0..8. Valor:
1752+ F6C1              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1753+ F6C1              ; Con counter inicial 9 y decremento por frame:
1754+ F6C1              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1755+ F6C1              ;   counter 8 -> phase 7 -> prev
1756+ F6C1              ;   counter 7 -> phase 6 -> target
1757+ F6C1              ;   counter 6 -> phase 5 -> next
1758+ F6C1              ;   counter 5 -> phase 4 -> next2
1759+ F6C1              ;   counter 4 -> phase 3 -> prev
1760+ F6C1              ;   counter 3 -> phase 2 -> target
1761+ F6C1              ;   counter 2 -> phase 1 -> prev
1762+ F6C1              ;   counter 1 -> phase 0 -> target (estado final, settle)
1763+ F6C1              ; ==============================================================================
1764+ F6C1              WobblePhaseTable:
1765+ F6C1 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1765+ F6C5 04 03 02 01
1765+ F6C9 00
