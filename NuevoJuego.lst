5528+ BE54 32 2E C0         LD (.enW), A                ; guardar (A=B tras GetSpriteDims? no, usar B)
5529+ BE57 78               LD A, B
5530+ BE58 32 2E C0         LD (.enW), A
5531+ BE5B 79               LD A, C
5532+ BE5C 32 2F C0         LD (.enH), A
