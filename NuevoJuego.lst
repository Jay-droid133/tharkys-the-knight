6929+ C90F              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6930+ C90F              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6931+ C90F              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6932+ C90F              ; timer >= DEATH_SPAWN_FRAMES).
6933+ C90F              SpawnDeath:
6934+ C90F                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6935+ C90F                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6936+ C90F                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6937+ C90F                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6938+ C90F                  ; atravesando el mapa.
6939+ C90F CD 97 97         CALL FindFarthestAnyFreeCell
6940+ C912 C8               RET Z                               ; sin candidato: reintento siguiente frame
6941+ C913              .sdHaveCell:
6942+ C913                  ; B = cx, C = cy
6943+ C913 DD 21 FB 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6944+ C917                  ; POSX = cx * 8
6945+ C917 78               LD A, B
