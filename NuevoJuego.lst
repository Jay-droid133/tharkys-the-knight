 304+ 6545              ; ==============================================================================
 305+ 6545              ; ClearSmokeAttrs - pone a $00 (paper black, ink black) los 2x2 chars
 306+ 6545              ; donde estaba el humo, al terminar la fase SMOKE de la cutscene.
 307+ 6545              ; ==============================================================================
 308+ 6545              ; Sin esto, los attrs originales de la estatua (paper coloreado) quedan
 309+ 6545              ; visibles en esos 4 chars tras el XOR-erase del ultimo smoke frame, dando
 310+ 6545              ; la sensacion de "celda de color, sin pixels". Limpiando attrs queda
 311+ 6545              ; uniformemente negro -- el efecto que pidio el usuario.
 312+ 6545              ;
 313+ 6545              ; Posicion: (ChurchCutsceneStatueOrigX/8, ChurchCutsceneStatueOrigY/8) en
 314+ 6545              ; coords de char, area 2x2. Ojo: OrigY ya tiene BG_Y_OFFSET aplicado
 315+ 6545              ; (asi se guardo en ChurchCutsceneInitStatueShake), por eso es directo.
 316+ 6545              ; Destruye: AF, BC, DE, HL.
 317+ 6545              ; ==============================================================================
 318+ 6545              ClearSmokeAttrs:
 319+ 6545                  ; HL = $5800 + (origY/8) * 32 + (origX/8)
 320+ 6545 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 321+ 6548 CB 3F            SRL A
 321+ 654A CB 3F          SRL A
 321+ 654C CB 3F          SRL A                   ; A = char Y (post-HUD)
 322+ 654E 26 00            LD H, 0
 323+ 6550 6F               LD L, A
 324+ 6551 29               ADD HL, HL                              ; *2
 325+ 6552 29               ADD HL, HL                              ; *4
 326+ 6553 29               ADD HL, HL                              ; *8
 327+ 6554 29               ADD HL, HL                              ; *16
 328+ 6555 29               ADD HL, HL                              ; *32
 329+ 6556 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 330+ 6559 CB 3F            SRL A
 330+ 655B CB 3F          SRL A
 330+ 655D CB 3F          SRL A                   ; A = char X
 331+ 655F 5F               LD E, A
 332+ 6560 16 00            LD D, 0
 333+ 6562 19               ADD HL, DE
 334+ 6563 11 00 58         LD DE, $5800
 335+ 6566 19               ADD HL, DE                              ; HL = attr addr top-left del 2x2
 336+ 6567 AF               XOR A                                   ; paper black, ink black
 337+ 6568 77               LD (HL), A                              ; (charY, charX)
 338+ 6569 23               INC HL
 339+ 656A 77               LD (HL), A                              ; (charY, charX+1)
 340+ 656B 11 1F 00         LD DE, 31
 341+ 656E 19               ADD HL, DE                              ; saltar a (charY+1, charX)
 342+ 656F 77               LD (HL), A
 343+ 6570 23               INC HL
 344+ 6571 77               LD (HL), A                              ; (charY+1, charX+1)
 345+ 6572 C9               RET
