2224+ AB05              ; ==============================================================================
2225+ AB05              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2226+ AB05              ; ==============================================================================
2227+ AB05              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2228+ AB05              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2229+ AB05              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2230+ AB05              ; ==============================================================================
2231+ AB05              StartWellCooldown:
2232+ AB05 CD 32 AB         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2233+ AB08 E5               PUSH HL
2234+ AB09 11 55 8A         LD DE, CleanAttrMap
2235+ AB0C 19               ADD HL, DE
2236+ AB0D 7E               LD A, (HL)
2237+ AB0E 32 5D 8D         LD (WellOrigAttr0), A
2238+ AB11 23               INC HL
2239+ AB12 7E               LD A, (HL)
2240+ AB13 32 5E 8D         LD (WellOrigAttr1), A
2241+ AB16 E1               POP HL
2242+ AB17 CD 4C AB         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2243+ AB1A 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2244+ AB1D 22 5B 8D         LD (WellCooldownTimer), HL
2245+ AB20 C9               RET
2246+ AB21
2247+ AB21              ; ==============================================================================
2248+ AB21              ; ApplyWellCooldownIfActive - al entrar en la room con cooldown activo
2249+ AB21              ; ==============================================================================
2250+ AB21              ; Solo pinta blanco (no re-captura originals; los almacenados en
2251+ AB21              ; WellOrigAttrN siguen siendo válidos del cooldown inicial). Se llama tras
2252+ AB21              ; CADA DrawBgGfxSprite dentro del loop de DrawScreen y tras SaveCleanAttrs
2253+ AB21              ; para que el flash de cian dure lo mínimo posible.
2254+ AB21              ; ==============================================================================
2255+ AB21              ApplyWellCooldownIfActive:
2256+ AB21 3A 57 8D         LD A, (WellActive)
2257+ AB24 B7               OR A
2258+ AB25 C8               RET Z
2259+ AB26 2A 5B 8D         LD HL, (WellCooldownTimer)
2260+ AB29 7C               LD A, H
2261+ AB2A B5               OR L
2262+ AB2B C8               RET Z
2263+ AB2C CD 32 AB         CALL GetWellBottomOffset
2264+ AB2F C3 4C AB         JP PaintWellWhiteAt
2265+ AB32
2266+ AB32              ; ==============================================================================
2267+ AB32              ; GetWellBottomOffset - HL = offset de la celda inferior-izquierda del pozo
2268+ AB32              ; ==============================================================================
2269+ AB32              ; Relativo a attr map (sin base). Para VRAM suma ATTR_BASE, para
2270+ AB32              ; CleanAttrMap suma CleanAttrMap.
2271+ AB32              ; Destruye: A, DE
2272+ AB32              ; ==============================================================================
2273+ AB32              GetWellBottomOffset:
2274+ AB32 3A 59 8D         LD A, (WellPosY)
2275+ AB35 26 00            LD H, 0
2276+ AB37 6F               LD L, A
2277+ AB38 29               ADD HL, HL
2278+ AB39 29               ADD HL, HL                          ; (pixel_y/8)*32
2279+ AB3A 3A 58 8D         LD A, (WellPosX)
2280+ AB3D 0F               RRCA
2281+ AB3E 0F               RRCA
2282+ AB3F 0F               RRCA
2283+ AB40 E6 1F            AND $1F
2284+ AB42 85               ADD A, L
2285+ AB43 6F               LD L, A
2286+ AB44 30 01            JR NC, .gwbNoCarry
2287+ AB46 24               INC H
2288+ AB47              .gwbNoCarry:
2289+ AB47 11 20 00         LD DE, 32
2290+ AB4A 19               ADD HL, DE                          ; offset fila inferior
2291+ AB4B C9               RET
2292+ AB4C
2293+ AB4C              ; ==============================================================================
2294+ AB4C              ; PaintWellWhiteAt - escribe blanco (L=bright, R=no bright) en VRAM + CleanAttrMap
2295+ AB4C              ; ==============================================================================
2296+ AB4C              ; IN: HL = offset fila inferior (relativo a attr map)
2297+ AB4C              ; ==============================================================================
2298+ AB4C              PaintWellWhiteAt:
2299+ AB4C E5               PUSH HL
2300+ AB4D                  ; VRAM
2301+ AB4D 11 00 58         LD DE, ATTR_BASE
2302+ AB50 19               ADD HL, DE
2303+ AB51 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2304+ AB53 77               LD (HL), A
2305+ AB54 23               INC HL
2306+ AB55 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2307+ AB57 77               LD (HL), A
2308+ AB58 E1               POP HL
2309+ AB59                  ; CleanAttrMap
2310+ AB59 11 55 8A         LD DE, CleanAttrMap
2311+ AB5C 19               ADD HL, DE
2312+ AB5D 3E 78            LD A, WELL_COOLDOWN_ATTR_L
2313+ AB5F 77               LD (HL), A
2314+ AB60 23               INC HL
2315+ AB61 3E 38            LD A, WELL_COOLDOWN_ATTR_R
2316+ AB63 77               LD (HL), A
2317+ AB64 C9               RET
2318+ AB65
2319+ AB65              ; ==============================================================================
2320+ AB65              ; UpdateWellCooldown - decrementa timer; al llegar a 0 restaura attrs originales
2321+ AB65              ; ==============================================================================
2322+ AB65              ; Llamar 1x por frame. Durante cooldown NO hay repaint: StartWellCooldown ya
2323+ AB65              ; dejó blanco en VRAM y en CleanAttrMap, así que todo restore de entidades
2324+ AB65              ; lee blanco del mapa limpio. Solo en la transición a 0 restauramos cian.
2325+ AB65              ; ==============================================================================
2326+ AB65              UpdateWellCooldown:
2327+ AB65 2A 5B 8D         LD HL, (WellCooldownTimer)
2328+ AB68 7C               LD A, H
2329+ AB69 B5               OR L
2330+ AB6A C8               RET Z                               ; 0 → nada que hacer
2331+ AB6B 2B               DEC HL
2332+ AB6C 22 5B 8D         LD (WellCooldownTimer), HL
2333+ AB6F 7C               LD A, H
2334+ AB70 B5               OR L
2335+ AB71 C0               RET NZ                              ; > 0 → esperar
2336+ AB72                  ; Timer acaba de llegar a 0. Si estamos en la room del pozo, restaurar
2337+ AB72                  ; attrs originales. Si no, al volver DrawScreen ya dibuja cian normal.
2338+ AB72 3A 57 8D         LD A, (WellActive)
2339+ AB75 B7               OR A
2340+ AB76 C8               RET Z
2341+ AB77 C3 7A AB         JP RestoreWellOriginalAttrs
