2697+ DA98 23               INC HL
2698+ DA99 56               LD D, (HL)                  ; DE = BgGfx ptr
2699+ DA9A 23               INC HL                      ; HL en charX
2700+ DA9B 46               LD B, (HL)                  ; charX
2701+ DA9C 23               INC HL
2702+ DA9D 4E               LD C, (HL)                  ; charY
2703+ DA9E 23               INC HL
2704+ DA9F 7E               LD A, (HL)                  ; tint variant
2705+ DAA0 23               INC HL                      ; HL en siguiente mapX
2706+ DAA1 32 B5 D2         LD (CurrentTintVar), A
