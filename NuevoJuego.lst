4869+ B9EB              ; ==============================================================================
4870+ B9EB              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
4871+ B9EB              ; ==============================================================================
4872+ B9EB              UpdateEnemySpeed:
4873+ B9EB 3A ED BC         LD A, (DayCycleCount)
4874+ B9EE 3D               DEC A                               ; 0-based index
4875+ B9EF FE 0A            CP 10
4876+ B9F1 38 02            JR C, .uesOk
4877+ B9F3 3E 09            LD A, 9                             ; Cap en indice 9
4878+ B9F5              .uesOk:
4879+ B9F5 F5               PUSH AF                             ; Guardar indice para tabla de anim
4880+ B9F6 21 19 BA         LD HL, EnemySpeedTable
4881+ B9F9 5F               LD E, A
4882+ B9FA 16 00            LD D, 0
4883+ B9FC 19               ADD HL, DE
4884+ B9FD 7E               LD A, (HL)                          ; A = velocidad × 2
4885+ B9FE                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
4886+ B9FE CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
4887+ BA00 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
4888+ BA02                  ; Hay fraccion .5: alternar +1 en frames impares
4889+ BA02 47               LD B, A                             ; B = parte entera
4890+ BA03 3A 98 81         LD A, (GameFrameCounter)
4891+ BA06 E6 01            AND 1                               ; 0 en par, 1 en impar
4892+ BA08 80               ADD A, B                            ; Sumar 0 o 1
4893+ BA09              .uesNoFrac:
4894+ BA09 32 55 8D         LD (CurrentEnemySpeed), A
4895+ BA0C                  ; Leer delay de animacion para este ciclo
4896+ BA0C F1               POP AF                              ; A = indice 0-based
4897+ BA0D 21 23 BA         LD HL, EnemyAnimDelayTable
4898+ BA10 5F               LD E, A
4899+ BA11 16 00            LD D, 0
4900+ BA13 19               ADD HL, DE
4901+ BA14 7E               LD A, (HL)
4902+ BA15 32 56 8D         LD (CurrentEnemyAnimDelay), A
4903+ BA18 C9               RET
4904+ BA19
4905+ BA19              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
4906+ BA19              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
4907+ BA19              EnemySpeedTable:
4908+ BA19 04               DEFB 4                              ; Ciclo 1: 2px (subido desde 1px)
4909+ BA1A 05               DEFB 5                              ; Ciclo 2: 2.5px
4910+ BA1B 06               DEFB 6                              ; Ciclo 3: 3px
4911+ BA1C 07               DEFB 7                              ; Ciclo 4: 3.5px
4912+ BA1D 08               DEFB 8                              ; Ciclo 5: 4px
4913+ BA1E 09               DEFB 9                              ; Ciclo 6: 4.5px
4914+ BA1F 0A               DEFB 10                             ; Ciclo 7: 5px
4915+ BA20 0B               DEFB 11                             ; Ciclo 8: 5.5px
4916+ BA21 0C               DEFB 12                             ; Ciclo 9: 6px
4917+ BA22 0E               DEFB 14                             ; Ciclo 10: 7px
4918+ BA23
4919+ BA23              ; Delay de animacion nasties por ciclo (menor = mas rapido)
4920+ BA23              ; La rata usara la mitad de estos valores
4921+ BA23              EnemyAnimDelayTable:                    ; Ajustado a 25fps (mitad de los valores a 50fps)
4922+ BA23 04               DEFB 4                              ; Ciclo 1: 4 frames = 160ms (era 8 a 50fps)
4923+ BA24 04               DEFB 4                              ; Ciclo 2 (era 7, redondeado)
4924+ BA25 03               DEFB 3                              ; Ciclo 3 (era 6)
4925+ BA26 03               DEFB 3                              ; Ciclo 4 (era 5, redondeado)
4926+ BA27 02               DEFB 2                              ; Ciclo 5 (era 4)
4927+ BA28 02               DEFB 2                              ; Ciclo 6 (era 4)
4928+ BA29 02               DEFB 2                              ; Ciclo 7 (era 3, min 2 para fluidez)
4929+ BA2A 02               DEFB 2                              ; Ciclo 8 (era 3, min 2)
4930+ BA2B 01               DEFB 1                              ; Ciclo 9 (era 2)
4931+ BA2C 01               DEFB 1                              ; Ciclo 10 (era 2)
