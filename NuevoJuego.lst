 452+ 9F97 D1               POP DE
 453+ 9F98 0D               DEC C
 454+ 9F99 20 EB            JR NZ, .restRow
 455+ 9F9B C9               RET
 456+ 9F9C
 457+ 9F9C              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9F9C              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9F9C              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9F9C              ; ---
 461+ 9F9C 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9FAC 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9FAD 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9FAE 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ A0E0 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ A0E1
 467+ A0E1              ; ==============================================================================
 468+ A0E1              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A0E1              ; ==============================================================================
 470+ A0E1              ; Entrada: A = indice de entidad (0-16)
 471+ A0E1              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A0E1              ; ==============================================================================
 473+ A0E1              SetAttrSlot:
 474+ A0E1 32 E0 A0         LD (CurrentAttrSlot), A
 475+ A0E4                  ; Calcular offset: A * 18
 476+ A0E4 6F               LD L, A
 477+ A0E5 26 00            LD H, 0
 478+ A0E7 29               ADD HL, HL                  ; x2
 479+ A0E8 54               LD D, H
 480+ A0E9 5D               LD E, L                     ; DE = x2
 481+ A0EA 29               ADD HL, HL                  ; x4
 482+ A0EB 29               ADD HL, HL                  ; x8
 483+ A0EC 29               ADD HL, HL                  ; x16
 484+ A0ED 19               ADD HL, DE                  ; x18
 485+ A0EE 11 AE 9F         LD DE, SavedAttrTable
 486+ A0F1 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A0F2                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A0F2 11 9C 9F         LD DE, EntitySavedAttr
 489+ A0F5 01 12 00         LD BC, 18
 490+ A0F8 ED B0            LDIR
 491+ A0FA C9               RET
 492+ A0FB
 493+ A0FB              ; ==============================================================================
 494+ A0FB              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A0FB              ; ==============================================================================
 496+ A0FB              FlushAttrSlot:
 497+ A0FB 3A E0 A0         LD A, (CurrentAttrSlot)
 498+ A0FE 6F               LD L, A
 499+ A0FF 26 00            LD H, 0
 500+ A101 29               ADD HL, HL                  ; x2
 501+ A102 54               LD D, H
 502+ A103 5D               LD E, L
 503+ A104 29               ADD HL, HL                  ; x4
 504+ A105 29               ADD HL, HL                  ; x8
 505+ A106 29               ADD HL, HL                  ; x16
 506+ A107 19               ADD HL, DE                  ; x18
 507+ A108 11 AE 9F         LD DE, SavedAttrTable
 508+ A10B 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A10C EB               EX DE, HL                   ; DE = destino
 510+ A10D 21 9C 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A110 01 12 00         LD BC, 18
 512+ A113 ED B0            LDIR
 513+ A115 C9               RET
 514+ A116
 515+ A116              ; ==============================================================================
 516+ A116              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A116              ; ==============================================================================
 518+ A116              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A116              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A116              ; ==============================================================================
 521+ A116              CalcAttrAddr:
 522+ A116 7A               LD A, D
 523+ A117 0F               RRCA
 524+ A118 0F               RRCA
 525+ A119 0F               RRCA
 526+ A11A E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A11C 6F               LD L, A
 528+ A11D 26 00            LD H, 0
 529+ A11F 29               ADD HL, HL
 530+ A120 29               ADD HL, HL
 531+ A121 29               ADD HL, HL
 532+ A122 29               ADD HL, HL
 533+ A123 29               ADD HL, HL                  ; HL = fila * 32
 534+ A124 7B               LD A, E
 535+ A125 0F               RRCA
 536+ A126 0F               RRCA
 537+ A127 0F               RRCA
 538+ A128 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A12A B5               OR L
 540+ A12B 6F               LD L, A
 541+ A12C 01 00 58         LD BC, ATTR_BASE
 542+ A12F 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A130 C9               RET
 544+ A131
 545+ A131              ; ==============================================================================
 546+ A131              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A131              ; ==============================================================================
 548+ A131              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A131              ; Salida: HL=direccion en VRAM
 550+ A131              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A131              ; ==============================================================================
 552+ A131              CalcPixelAddr:
 553+ A131 7A               LD A, D
 554+ A132 E6 C0            AND $C0                     ; Y7 Y6
 555+ A134 1F               RRA
 556+ A135 1F               RRA
 557+ A136 1F               RRA                         ; >> 3
 558+ A137 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A139 67               LD H, A
 560+ A13A
 561+ A13A 7A               LD A, D
 562+ A13B E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A13D B4               OR H
 564+ A13E 67               LD H, A
 565+ A13F
 566+ A13F 7A               LD A, D
 567+ A140 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A142 87               ADD A, A
 569+ A143 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A144 6F               LD L, A
 571+ A145
 572+ A145 7B               LD A, E
 573+ A146 1F               RRA
 574+ A147 1F               RRA
 575+ A148 1F               RRA
 576+ A149 E6 1F            AND $1F                     ; X / 8 = columna
 577+ A14B B5               OR L
 578+ A14C 6F               LD L, A
 579+ A14D C9               RET
 580+ A14E
 581+ A14E              ; ==============================================================================
 582+ A14E              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A14E              ; ==============================================================================
 584+ A14E              DrawDebugInfo:
 585+ A14E 3A 1D 82         LD A, (CurrentScreenX)
 586+ A151 1E 00            LD E, 0
 587+ A153 CD 70 A1         CALL .drawHexDigit
 588+ A156
 589+ A156 3E 2C            LD A, ','
 590+ A158 1E 01            LD E, 1
 591+ A15A CD 7C A1         CALL .drawChar
 592+ A15D
 593+ A15D 3A 1E 82         LD A, (CurrentScreenY)
 594+ A160 1E 02            LD E, 2
 595+ A162 CD 70 A1         CALL .drawHexDigit
 596+ A165
 597+ A165 21 00 58         LD HL, ATTR_BASE
 598+ A168 3E 47            LD A, WHITE | $40
 599+ A16A 77               LD (HL), A
 600+ A16B 23               INC HL
 601+ A16C 77               LD (HL), A
 602+ A16D 23               INC HL
 603+ A16E 77               LD (HL), A
 604+ A16F C9               RET
 605+ A170
 606+ A170              .drawHexDigit:
 607+ A170 E6 0F            AND $0F
 608+ A172 FE 0A            CP 10
 609+ A174 38 04            JR C, .isNum
 610+ A176 C6 37            ADD A, 'A' - 10
 611+ A178 18 02            JR .drawChar
 612+ A17A              .isNum:
 613+ A17A C6 30            ADD A, '0'
 614+ A17C              .drawChar:
 615+ A17C 6F               LD L, A
 616+ A17D 26 00            LD H, 0
 617+ A17F 29               ADD HL, HL
 618+ A180 29               ADD HL, HL
 619+ A181 29               ADD HL, HL
 620+ A182 01 00 3C         LD BC, $3C00
 621+ A185 09               ADD HL, BC
 622+ A186
 623+ A186 16 40            LD D, $40
 624+ A188 06 08            LD B, 8
 625+ A18A              .charLoop:
 626+ A18A 7E               LD A, (HL)
 627+ A18B 12               LD (DE), A
 628+ A18C 23               INC HL
 629+ A18D 14               INC D
 630+ A18E 10 FA            DJNZ .charLoop
 631+ A190 C9               RET
