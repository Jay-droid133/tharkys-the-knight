6137+ C568
6138+ C568              ; ==============================================================================
6139+ C568              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6140+ C568              ; ==============================================================================
6141+ C568              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6142+ C568              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6143+ C568              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6144+ C568              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6145+ C568              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6146+ C568              ; main.asm; aqui no hace falta guard adicional).
6147+ C568              ; ==============================================================================
6148+ C568
6149+ C568              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6150+ C568              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6151+ C568              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6152+ C568              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6153+ C568              ;
6154+ C568              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6155+ C568              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6156+ C568              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6157+ C568              ;
6158+ C568              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6159+ C568              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6160+ C568              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6161+ C568              ; en vez de 8 + orientacion invertida).
6162+ C568              UpdateDeath:
6163+ C568                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6164+ C568                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6165+ C568                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6166+ C568                  ; progreso real, no solo quedar inmovil. ---
6167+ C568 2A 14 82         LD HL, (DeathGhostStuckTimer)
6168+ C56B 23               INC HL
6169+ C56C 22 14 82         LD (DeathGhostStuckTimer), HL
6170+ C56F 7C               LD A, H
6171+ C570 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6172+ C572 38 0C            JR C, .udGhostCheckDone
6173+ C574 20 05            JR NZ, .udGhostOn
6174+ C576 7D               LD A, L
6175+ C577 FE 7D            CP (DEATH_GHOST_FRAMES) & $FF
6176+ C579 38 05            JR C, .udGhostCheckDone
6177+ C57B              .udGhostOn:
6178+ C57B 3E 01            LD A, 1
6179+ C57D 32 16 82         LD (DeathGhostMode), A
6180+ C580              .udGhostCheckDone:
6181+ C580
6182+ C580                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6183+ C580 3A 16 82         LD A, (DeathGhostMode)
6184+ C583 B7               OR A
6185+ C584 C2 CB C5         JP NZ, DeathGhostChase
6186+ C587
6187+ C587                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6188+ C587 DD 7E 03         LD A, (IX+ENT_POSX)
6189+ C58A 32 11 82         LD (DeathPrevX), A
6190+ C58D DD 7E 04         LD A, (IX+ENT_POSY)
6191+ C590 32 12 82         LD (DeathPrevY), A
6192+ C593                  ; Sub-pixel acc 1/2
6193+ C593 3A 10 82         LD A, (DeathSubPixelAcc)
6194+ C596 EE 01            XOR 1
6195+ C598 32 10 82         LD (DeathSubPixelAcc), A
6196+ C59B 28 05            JR Z, .udSkip
6197+ C59D CD AB B0         CALL UpdateMonster                  ; activo: chase + move + animate
6198+ C5A0 18 03            JR .udPost
6199+ C5A2              .udSkip:
6200+ C5A2 CD 30 C6         CALL DeathAnimate                   ; skip: solo animacion
6201+ C5A5              .udPost:
6202+ C5A5                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6203+ C5A5 3A 11 82         LD A, (DeathPrevX)
6204+ C5A8 DD BE 03         CP (IX+ENT_POSX)
6205+ C5AB 20 19            JR NZ, .udMoved
6206+ C5AD 3A 12 82         LD A, (DeathPrevY)
6207+ C5B0 DD BE 04         CP (IX+ENT_POSY)
6208+ C5B3 20 11            JR NZ, .udMoved
6209+ C5B5                  ; No movio: incrementar BFS counter
6210+ C5B5 3A 13 82         LD A, (DeathStuckCounter)
6211+ C5B8 3C               INC A
6212+ C5B9 32 13 82         LD (DeathStuckCounter), A
6213+ C5BC FE 06            CP DEATH_STUCK_THRESHOLD
6214+ C5BE D8               RET C
6215+ C5BF AF               XOR A
6216+ C5C0 32 13 82         LD (DeathStuckCounter), A
6217+ C5C3 C3 83 C7         JP DeathBfsRescue
6218+ C5C6              .udMoved:
6219+ C5C6 AF               XOR A
6220+ C5C7 32 13 82         LD (DeathStuckCounter), A
6221+ C5CA C9               RET
6222+ C5CB
6223+ C5CB              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6224+ C5CB              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6225+ C5CB              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6226+ C5CB              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6227+ C5CB              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6228+ C5CB              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6229+ C5CB              DeathGhostChase:
6230+ C5CB                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6231+ C5CB 3A DF 80         LD A, (EntityTable + ENT_POSX)
6232+ C5CE DD 96 03         SUB (IX+ENT_POSX)
6233+ C5D1 30 02            JR NC, .udgAbsDxOk
6234+ C5D3 ED 44            NEG
6235+ C5D5              .udgAbsDxOk:
6236+ C5D5 47               LD B, A                             ; B = |dx|
6237+ C5D6 3A E0 80         LD A, (EntityTable + ENT_POSY)
6238+ C5D9 DD 96 04         SUB (IX+ENT_POSY)
6239+ C5DC 30 02            JR NC, .udgAbsDyOk
6240+ C5DE ED 44            NEG
6241+ C5E0              .udgAbsDyOk:
6242+ C5E0                  ; A = |dy|, B = |dx|
6243+ C5E0 B8               CP B
6244+ C5E1 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6245+ C5E3
6246+ C5E3                  ; --- Eje X primario ---
6247+ C5E3 AF               XOR A
6248+ C5E4 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6249+ C5E7 3A DF 80         LD A, (EntityTable + ENT_POSX)
6250+ C5EA DD 96 03         SUB (IX+ENT_POSX)
6251+ C5ED 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6252+ C5EF 3E 04            LD A, DEATH_GHOST_SPEED
