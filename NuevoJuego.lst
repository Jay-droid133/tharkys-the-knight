 691+ E7BF 1E 1F            LD E, 31
 692+ E7C1 CD CD E7         CALL DrawHudCharRow0
 693+ E7C4                  ; Atributos (bright white)
 694+ E7C4 3E 47            LD A, $47
 695+ E7C6 32 1E 58         LD (ATTR_BASE + 30), A
 696+ E7C9 32 1F 58         LD (ATTR_BASE + 31), A
 697+ E7CC C9               RET
 698+ E7CD
 699+ E7CD              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 700+ E7CD              ; A = codigo ASCII, E = columna (0-31)
 701+ E7CD              DrawHudCharRow0:
 702+ E7CD 6F               LD L, A
 703+ E7CE 26 00            LD H, 0
 704+ E7D0 29               ADD HL, HL
 705+ E7D1 29               ADD HL, HL
 706+ E7D2 29               ADD HL, HL
 707+ E7D3 01 00 3C         LD BC, $3C00
 708+ E7D6 09               ADD HL, BC                  ; HL = font data
 709+ E7D7 16 40            LD D, $40                   ; Tercio 0, scan line 0
 710+ E7D9 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 711+ E7DA 5F               LD E, A                     ; DE = dir VRAM
 712+ E7DB 06 08            LD B, 8
 713+ E7DD              .row0Char:
 714+ E7DD 7E               LD A, (HL)
 715+ E7DE 12               LD (DE), A
