 146  DCF9                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ DCF9              ; ==============================================================================
   2+ DCF9              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ DCF9              ; ==============================================================================
   4+ DCF9              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ DCF9              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ DCF9              ;
   7+ DCF9              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ DCF9              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ DCF9              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ DCF9              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ DCF9              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ DCF9              ; ==============================================================================
  13+ DCF9
  14+ DCF9              ; ==============================================================================
  15+ DCF9              ; PlaySFX - Reproduce un efecto de sonido
  16+ DCF9              ; ==============================================================================
  17+ DCF9              ; Entrada: HL = puntero a datos del efecto
  18+ DCF9              ; Modifica: AF, BC, DE, HL
  19+ DCF9              ; ==============================================================================
  20+ DCF9              PlaySFX:
  21+ DCF9 F3               DI                          ; Sin interrupciones para audio limpio
  22+ DCFA 3A FC 8F         LD A, (CurrentBorderColor)
  23+ DCFD E6 07            AND $07                     ; Solo bits de color del borde
  24+ DCFF 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ DD00
  26+ DD00              .nextStep:
  27+ DD00 7E               LD A, (HL)                  ; Leer duration
  28+ DD01 B7               OR A
  29+ DD02 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ DD04
  31+ DD04 47               LD B, A                     ; B = duration (bucle externo)
  32+ DD05 23               INC HL
  33+ DD06 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ DD07 23               INC HL
  35+ DD08 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ DD09 23               INC HL
  37+ DD0A 7E               LD A, (HL)                  ; A = flags
  38+ DD0B 23               INC HL
  39+ DD0C E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ DD0D CB 47            BIT 0, A
  41+ DD0F 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ DD11
  43+ DD11              ; --- Bucle de tono normal ---
  44+ DD11              .toneLoop:
  45+ DD11                  ; Semi-periodo HIGH
  46+ DD11 7B               LD A, E
  47+ DD12 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ DD14 D3 FE            OUT ($FE), A
  49+ DD16 79               LD A, C                     ; A = pitch actual
  50+ DD17              .toneDelayHi:
  51+ DD17 3D               DEC A
  52+ DD18 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ DD1A
  54+ DD1A                  ; Semi-periodo LOW
  55+ DD1A 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ DD1B D3 FE            OUT ($FE), A
  57+ DD1D 79               LD A, C
  58+ DD1E              .toneDelayLo:
  59+ DD1E 3D               DEC A
  60+ DD1F 20 FD            JR NZ, .toneDelayLo
  61+ DD21
  62+ DD21                  ; Aplicar pitch sweep
  63+ DD21 79               LD A, C
  64+ DD22 82               ADD A, D                    ; pitch += pitchDelta
  65+ DD23 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ DD25 FA 2D DD         JP M, .toneClamp            ; evitar pitch negativo
  67+ DD28 4F               LD C, A
  68+ DD29              .toneAfterClamp:
  69+ DD29 10 E6            DJNZ .toneLoop
  70+ DD2B 18 30            JR .stepDone
  71+ DD2D
  72+ DD2D              .toneClamp:
  73+ DD2D 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ DD2F 18 F8            JR .toneAfterClamp
  75+ DD31
  76+ DD31              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ DD31              .noiseLoop:
  78+ DD31                  ; Semi-periodo HIGH con ruido
  79+ DD31 7B               LD A, E
  80+ DD32 F6 10            OR $10
  81+ DD34 D3 FE            OUT ($FE), A
  82+ DD36 ED 5F            LD A, R                     ; R register como PRNG
  83+ DD38 A9               XOR C                       ; mezclar con pitch base
  84+ DD39 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ DD3B F6 01            OR $01                      ; minimo 1
  86+ DD3D              .noiseDelayHi:
  87+ DD3D 3D               DEC A
  88+ DD3E 20 FD            JR NZ, .noiseDelayHi
  89+ DD40
  90+ DD40                  ; Semi-periodo LOW
  91+ DD40 7B               LD A, E
  92+ DD41 D3 FE            OUT ($FE), A
  93+ DD43 ED 5F            LD A, R
  94+ DD45 A9               XOR C
  95+ DD46 E6 1F            AND $1F
  96+ DD48 F6 01            OR $01
  97+ DD4A              .noiseDelayLo:
  98+ DD4A 3D               DEC A
  99+ DD4B 20 FD            JR NZ, .noiseDelayLo
 100+ DD4D
 101+ DD4D                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ DD4D 79               LD A, C
 103+ DD4E 82               ADD A, D
 104+ DD4F 28 08            JR Z, .noiseClamp
 105+ DD51 FA 59 DD         JP M, .noiseClamp
 106+ DD54 4F               LD C, A
 107+ DD55              .noiseAfterClamp:
 108+ DD55 10 DA            DJNZ .noiseLoop
 109+ DD57 18 04            JR .stepDone
 110+ DD59
 111+ DD59              .noiseClamp:
 112+ DD59 0E 01            LD C, 1
 113+ DD5B 18 F8            JR .noiseAfterClamp
 114+ DD5D
 115+ DD5D              .stepDone:
 116+ DD5D E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ DD5E 18 A0            JR .nextStep
 118+ DD60
 119+ DD60              .done:
 120+ DD60 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ DD61 D3 FE            OUT ($FE), A
 122+ DD63 FB               EI
 123+ DD64 C9               RET
 124+ DD65
 125+ DD65              ; ==============================================================================
 126+ DD65              ; DATOS DE EFECTOS DE SONIDO
 127+ DD65              ; ==============================================================================
 128+ DD65
 129+ DD65              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ DD65              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ DD65              SFX_FootstepTic:
 132+ DD65 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ DD69 00               DEFB 0                      ; fin
 134+ DD6A
 135+ DD6A              SFX_FootstepTac:
 136+ DD6A 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ DD6E 00               DEFB 0                      ; fin
 138+ DD6F
 139+ DD6F              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 140+ DD6F              ; Dos pasos: sweep rapido de agudo a grave
 141+ DD6F              SFX_Attack:
 142+ DD6F 28 08 01 00      DEFB 40, 8, 1, 0           ; sweep descendente rapido (agudo → medio)
 143+ DD73 19 14 02 00      DEFB 25, 20, 2, 0          ; continua bajando (medio → grave)
 144+ DD77 00               DEFB 0                      ; fin
 145+ DD78
 146+ DD78              ; --- SFX_EnemyDeath: "explosion" con ruido (~100ms) ---
 147+ DD78              ; Ruido percusivo seguido de tono descendente
 148+ DD78              SFX_EnemyDeath:
 149+ DD78 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ DD7C 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ DD80 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ DD84 00               DEFB 0                      ; fin
 153+ DD85
 154+ DD85              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 155+ DD85              ; Tono ascendente rapido seguido de ruido seco
 156+ DD85              SFX_PlayerHit:
 157+ DD85 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 158+ DD89 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 159+ DD8D 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 160+ DD91 00               DEFB 0                      ; fin
 161+ DD92
 162+ DD92              ; --- SFX_ScreenTransition: "chime" ascendente (~120ms) ---
 163+ DD92              ; Tres tonos escalonados ascendentes
 164+ DD92              SFX_ScreenTransition:
 165+ DD92 1E 1E 00 00      DEFB 30, 30, 0, 0          ; tono grave
 166+ DD96 1E 14 00 00      DEFB 30, 20, 0, 0          ; tono medio
 167+ DD9A 1E 0C 00 00      DEFB 30, 12, 0, 0          ; tono agudo
 168+ DD9E 14 08 FF 00      DEFB 20, 8, -1, 0          ; cola con sweep ascendente
 169+ DDA2 00               DEFB 0                      ; fin
 170+ DDA3
 171+ DDA3              ; --- SFX_EnemySpawn: "pop" ascendente + crackle (~70ms) ---
 172+ DDA3              ; Tono rapido ascendente y crujido
 173+ DDA3              SFX_EnemySpawn:
 174+ DDA3 19 23 FE 00      DEFB 25, 35, -2, 0         ; tono ascendente rapido
 175+ DDA7 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 176+ DDAB 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 177+ DDAF 00               DEFB 0                      ; fin
 178+ DDB0
 179+ DDB0              ; --- SFX_WellRecover: tono ascendente "power-up" (~100ms) ---
 180+ DDB0              ; Tres escalones ascendentes, tipo recarga
 181+ DDB0              SFX_WellRecover:
 182+ DDB0 32 3C 00 00      DEFB 50, 60, 0, 0          ; grave profundo
 183+ DDB4 32 2D 00 00      DEFB 50, 45, 0, 0          ; medio-grave
 184+ DDB8 32 23 00 00      DEFB 50, 35, 0, 0          ; medio
 185+ DDBC 32 19 00 00      DEFB 50, 25, 0, 0          ; medio-agudo
 186+ DDC0 32 12 00 00      DEFB 50, 18, 0, 0          ; agudo
 187+ DDC4 3C 0C FF 00      DEFB 60, 12, -1, 0         ; sweep ascendente
 188+ DDC8 28 08 00 00      DEFB 40, 8, 0, 0           ; agudo brillante sostenido
 189+ DDCC 00               DEFB 0                      ; fin
 190+ DDCD
 191+ DDCD              ; --- SFX_Pickup: "ding" ascendente corto al recoger objeto (~50ms) ---
 192+ DDCD              SFX_Pickup:
 193+ DDCD 28 32 00 00      DEFB 40, 50, 0, 0          ; tono grave largo
 194+ DDD1 28 23 00 00      DEFB 40, 35, 0, 0          ; tono medio
 195+ DDD5 28 19 00 00      DEFB 40, 25, 0, 0          ; tono medio-agudo
 196+ DDD9 28 12 00 00      DEFB 40, 18, 0, 0          ; tono agudo
 197+ DDDD 32 0C FF 00      DEFB 50, 12, -1, 0         ; sweep ascendente final
 198+ DDE1 00               DEFB 0                      ; fin
 199+ DDE2
 200+ DDE2              ; --- SFX_BellChime: campanada grave de medianoche (~200ms) ---
 201+ DDE2              ; Tono grave resonante con decay lento, como campana de iglesia
 202+ DDE2              ; --- SFX_BellChime: una campanada grave (~corta, para repetir) ---
 203+ DDE2              SFX_BellChime:
 204+ DDE2 FA DC 00 00      DEFB 250, 220, 0, 0        ; golpe grave
 205+ DDE6 50 F0 01 00      DEFB 80, 240, 1, 0         ; decay
 206+ DDEA 00               DEFB 0                      ; fin
 207+ DDEB
 208+ DDEB              ; --- SFX_ChurchDoorOpen: "click + creak" puerta de iglesia (~300ms) ---
 209+ DDEB              ; Click corto inicial (cerrojo), luego crujido lento ascendente (madera vieja
 210+ DDEB              ; girando con esfuerzo). Valores iniciales — afinar en el emulador.
 211+ DDEB              SFX_ChurchDoorOpen:
 212+ DDEB 0C 32 00 01      DEFB 12,  50,  0, 1          ; click: 12 iter ruido pitch 50
 213+ DDEF 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 214+ DDF3 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 215+ DDF7 00               DEFB  0                       ; fin
 216+ DDF8
 217+ DDF8              ; --- Sistema de campanadas con pausa entre ellas ---
 218+ DDF8              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 219+ DDF8              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 220+ DDF8              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 221+ DDF8 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 222+ DDF9 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 223+ DDFB              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 224+ DDFB              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 225+ DDFB
 226+ DDFB              ; --- Cadena de eventos tras la ultima campanada ---
 227+ DDFB              ; last chime → (delay) → windows off → (delay) → monster spawn
 228+ DDFB              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 229+ DDFB              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 230+ DDFB 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 231+ DDFC 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 232+ DDFD
 233+ DDFD              ; ==============================================================================
 234+ DDFD              ; StartBellChimes - Inicia secuencia de 12 campanadas
 235+ DDFD              ; ==============================================================================
 236+ DDFD              StartBellChimes:
 237+ DDFD 3E 03            LD A, 3                             ; DEBUG: 3 campanadas (era 12)
 238+ DDFF 32 F8 DD         LD (BellCount), A
 239+ DE02                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 240+ DE02 2A 78 5C         LD HL, (SYS_FRAMES)
 241+ DE05 22 F9 DD         LD (BellNextFrame), HL
 242+ DE08 3E 7D            LD A, SCARE_TIMER_BELLS
 243+ DE0A 32 F9 B4         LD (ScareTimer), A
 244+ DE0D C9               RET
 245+ DE0E
 246+ DE0E              ; ==============================================================================
 247+ DE0E              ; UpdateBellChimes - Llamar cada frame desde el main loop
 248+ DE0E              ; ==============================================================================
 249+ DE0E              UpdateBellChimes:
 250+ DE0E 3A F8 DD         LD A, (BellCount)
 251+ DE11 B7               OR A
 252+ DE12 C8               RET Z                       ; sin campanadas pendientes
 253+ DE13
 254+ DE13                  ; Comparar FRAMES actual con BellNextFrame
 255+ DE13 2A 78 5C         LD HL, (SYS_FRAMES)
 256+ DE16 ED 5B F9 DD      LD DE, (BellNextFrame)
 257+ DE1A B7               OR A
 258+ DE1B ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 259+ DE1D D8               RET C                       ; FRAMES < deadline → aun no toca
 260+ DE1E
 261+ DE1E                  ; Sonar campanada (AY, no bloquea CPU)
 262+ DE1E C5               PUSH BC
 263+ DE1F D5               PUSH DE
 264+ DE20 CD A8 DE         CALL AY_PlayBellChime
 265+ DE23 D1               POP DE
 266+ DE24 C1               POP BC
 267+ DE25
 268+ DE25                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 269+ DE25                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 270+ DE25 2A 78 5C         LD HL, (SYS_FRAMES)
 271+ DE28 11 4B 00         LD DE, BELL_PAUSE
 272+ DE2B 19               ADD HL, DE
 273+ DE2C 22 F9 DD         LD (BellNextFrame), HL
 274+ DE2F
 275+ DE2F 21 F8 DD         LD HL, BellCount
 276+ DE32 35               DEC (HL)
 277+ DE33 C0               RET NZ
 278+ DE34 18 00            JR .bellsDone
 279+ DE36
 280+ DE36              .bellsDone:
 281+ DE36                  ; Ultima campanada:
 282+ DE36                  ;   1) matar todos los nasties vivos (puff)
 283+ DE36                  ;   2) arrancar cadena diferida: windows off → monster spawn
 284+ DE36 CD 30 B8         CALL KillAllActiveNasties
 285+ DE39 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 286+ DE3B 32 FB DD         LD (BellsDoneTimer), A
 287+ DE3E C9               RET
 288+ DE3F
 289+ DE3F              ; ==============================================================================
 290+ DE3F              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 291+ DE3F              ; ==============================================================================
 292+ DE3F              ; Maneja la cadena diferida tras la ultima campanada:
 293+ DE3F              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 294+ DE3F              ;      y arranca SpawnAfterWinTimer
 295+ DE3F              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 296+ DE3F              ; ==============================================================================
 297+ DE3F              UpdateBellsDoneTimer:
 298+ DE3F 3A FB DD         LD A, (BellsDoneTimer)
 299+ DE42 B7               OR A
 300+ DE43 28 14            JR Z, .ubdCheckSpawn
 301+ DE45 3D               DEC A
 302+ DE46 32 FB DD         LD (BellsDoneTimer), A
 303+ DE49 20 0E            JR NZ, .ubdCheckSpawn
 304+ DE4B                  ; Llego a 0: apagar ventanas
 305+ DE4B CD 15 D2         CALL UpdateRemapTables
 306+ DE4E 3E 01            LD A, 1
 307+ DE50 32 EC 81         LD (AttrsDirty), A
 308+ DE53 3E 26            LD A, POST_WINDOWS_SPAWN_DELAY
 309+ DE55 32 FC DD         LD (SpawnAfterWinTimer), A
 310+ DE58 C9               RET
 311+ DE59              .ubdCheckSpawn:
 312+ DE59 3A FC DD         LD A, (SpawnAfterWinTimer)
 313+ DE5C B7               OR A
 314+ DE5D C8               RET Z
 315+ DE5E 3D               DEC A
 316+ DE5F 32 FC DD         LD (SpawnAfterWinTimer), A
 317+ DE62 C0               RET NZ
 318+ DE63                  ; Llego a 0: spawnear monsters
 319+ DE63 C3 02 B9         JP SpawnMonsters
 320+ DE66
# file closed: sound.asm
 147  DE66                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ DE66              ; ==============================================================================
   2+ DE66              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ DE66              ; ==============================================================================
   4+ DE66              ; Puertos:
   5+ DE66              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ DE66              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ DE66              ;
   8+ DE66              ; Registros AY:
   9+ DE66              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ DE66              ;   R2/R3: tono canal B
  11+ DE66              ;   R4/R5: tono canal C
  12+ DE66              ;   R6:    period del ruido (5 bits)
  13+ DE66              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ DE66              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ DE66              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ DE66              ;   R9:    volumen B
  17+ DE66              ;   R10:   volumen C
  18+ DE66              ;   R11/R12: period del envelope
  19+ DE66              ;   R13:   forma del envelope (0-15)
  20+ DE66              ; ==============================================================================
  21+ DE66
  22+ DE66              ; ==============================================================================
  23+ DE66              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ DE66              ; ==============================================================================
  25+ DE66              ; Entrada: A = registro (0-13), E = valor
  26+ DE66              ; Destruye: BC, A
  27+ DE66              ; ==============================================================================
  28+ DE66              AY_WriteReg:
  29+ DE66 01 FD FF         LD BC, $FFFD
  30+ DE69 ED 79            OUT (C), A                  ; seleccionar registro
  31+ DE6B 01 FD BF         LD BC, $BFFD
  32+ DE6E ED 59            OUT (C), E                  ; escribir valor
  33+ DE70 C9               RET
  34+ DE71
  35+ DE71              ; ==============================================================================
  36+ DE71              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ DE71              ; ==============================================================================
  38+ DE71              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ DE71              ; ==============================================================================
  40+ DE71              AY_Stop:
  41+ DE71 3E 08            LD A, 8
  42+ DE73 1E 00            LD E, 0
  43+ DE75 CD 66 DE         CALL AY_WriteReg
  44+ DE78 3E 09            LD A, 9
  45+ DE7A 1E 00            LD E, 0
  46+ DE7C CD 66 DE         CALL AY_WriteReg
  47+ DE7F 3E 0A            LD A, 10
  48+ DE81 1E 00            LD E, 0
  49+ DE83 CD 66 DE         CALL AY_WriteReg
  50+ DE86 C9               RET
  51+ DE87
  52+ DE87              ; ==============================================================================
  53+ DE87              ; AY_Init - Silencia todos los canales (volumen 0, mixer todo off)
  54+ DE87              ; ==============================================================================
  55+ DE87              AY_Init:
  56+ DE87 3E 07            LD A, 7                     ; mixer
  57+ DE89 1E 3F            LD E, $3F                   ; todos los tonos y ruidos en off
  58+ DE8B CD 66 DE         CALL AY_WriteReg
  59+ DE8E 3E 08            LD A, 8                     ; volumen A
  60+ DE90 1E 00            LD E, 0
  61+ DE92 CD 66 DE         CALL AY_WriteReg
  62+ DE95 3E 09            LD A, 9                     ; volumen B
  63+ DE97 1E 00            LD E, 0
  64+ DE99 CD 66 DE         CALL AY_WriteReg
  65+ DE9C 3E 0A            LD A, 10                    ; volumen C
  66+ DE9E 1E 00            LD E, 0
  67+ DEA0 CD 66 DE         CALL AY_WriteReg
  68+ DEA3 C9               RET
  69+ DEA4
  70+ DEA4              ; ==============================================================================
  71+ DEA4              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  72+ DEA4              ; ==============================================================================
  73+ DEA4              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  74+ DEA4              ; el AY toca solo durante el decay.
  75+ DEA4              ; ==============================================================================
  76+ DEA4              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  77+ DEA4              ; ==============================================================================
  78+ DEA4              ; ==============================================================================
  79+ DEA4              ; Variables del decay manual de la campana (con pan estereo)
  80+ DEA4              ; ==============================================================================
  81+ DEA4              ; BellVolL/C/R: volumen actual de cada canal (0-15)
  82+ DEA4              ; BellMaxL/C/R: volumen inicial de cada canal (set en AY_PlayBellChime)
  83+ DEA4              ; Cuando los 3 son 0, la campana esta silenciada.
  84+ DEA4 00           BellVolL:       DEFB 0          ; volumen actual canal A (izquierdo)
  85+ DEA5 00           BellVolC:       DEFB 0          ; volumen actual canal B (centro)
  86+ DEA6 00           BellVolR:       DEFB 0          ; volumen actual canal C (derecho)
  87+ DEA7 00           BellDecayTimer: DEFB 0          ; frames hasta el siguiente decremento
  88+ DEA8
  89+ DEA8              BELL_DECAY_RATE EQU 2           ; 2 frames a 25fps (era 4 a 50fps)
  90+ DEA8
  91+ DEA8              ; ==============================================================================
  92+ DEA8              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  93+ DEA8              ; ==============================================================================
  94+ DEA8              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  95+ DEA8              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
  96+ DEA8              ; ==============================================================================
  97+ DEA8              AY_PlayBellChime:
  98+ DEA8                  ; --- Calcular dx (signed) y |dx|, |dy| ---
  99+ DEA8 3A E3 81         LD A, (CurrentScreenX)
 100+ DEAB D6 09            SUB START_SCREEN_X          ; A = dx (signed: + plaza al oeste, - plaza al este)
 101+ DEAD 57               LD D, A                     ; D = dx signed (player - plaza)
 102+ DEAE 30 02            JR NC, .absDxOk
 103+ DEB0 ED 44            NEG
 104+ DEB2              .absDxOk:
 105+ DEB2 47               LD B, A                     ; B = |dx|
 106+ DEB3
 107+ DEB3 3A E4 81         LD A, (CurrentScreenY)
 108+ DEB6 D6 09            SUB START_SCREEN_Y
 109+ DEB8 30 02            JR NC, .absDyOk
 110+ DEBA ED 44            NEG
 111+ DEBC              .absDyOk:
 112+ DEBC 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 113+ DEBD 4F               LD C, A                     ; C = distancia
 114+ DEBE
 115+ DEBE                  ; --- Volumen total = max(15 - dist*2, 1) ---
 116+ DEBE 87               ADD A, A                    ; A = dist * 2
 117+ DEBF 47               LD B, A
 118+ DEC0 3E 0F            LD A, 15
 119+ DEC2 90               SUB B                       ; A = 15 - dist*2
 120+ DEC3 30 02            JR NC, .volTotalOk
 121+ DEC5 3E 01            LD A, 1
 122+ DEC7              .volTotalOk:
 123+ DEC7 B7               OR A
 124+ DEC8 20 02            JR NZ, .volTotalSet
 125+ DECA 3E 01            LD A, 1
 126+ DECC              .volTotalSet:
 127+ DECC 47               LD B, A                     ; B = volumen total (1-15)
 128+ DECD
 129+ DECD                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 130+ DECD                  ; D > 0  → player está al ESTE de plaza → plaza al oeste (canal A más fuerte)
 131+ DECD                  ; D < 0  → player está al OESTE de plaza → plaza al este (canal C más fuerte)
 132+ DECD                  ; D == 0 → alineado X → canal B
 133+ DECD 7A               LD A, D
 134+ DECE B7               OR A
 135+ DECF 28 27            JR Z, .panCenter
 136+ DED1 F2 E6 DE         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 137+ DED4                  ; D < 0: plaza al este → canal C dominante
 138+ DED4 78               LD A, B                     ; A = vol total
 139+ DED5 32 A6 DE         LD (BellVolR), A            ; canal C = full
 140+ DED8 CB 38            SRL B
 141+ DEDA 78               LD A, B
 142+ DEDB 32 A5 DE         LD (BellVolC), A            ; canal B = mitad
 143+ DEDE CB 38            SRL B
 144+ DEE0 78               LD A, B
 145+ DEE1 32 A4 DE         LD (BellVolL), A            ; canal A = cuarto
 146+ DEE4 18 1D            JR .panDone
 147+ DEE6
 148+ DEE6              .panLeft:
 149+ DEE6                  ; D > 0: plaza al oeste → canal A dominante
 150+ DEE6 78               LD A, B
 151+ DEE7 32 A4 DE         LD (BellVolL), A
 152+ DEEA CB 38            SRL B
 153+ DEEC 78               LD A, B
 154+ DEED 32 A5 DE         LD (BellVolC), A
 155+ DEF0 CB 38            SRL B
 156+ DEF2 78               LD A, B
 157+ DEF3 32 A6 DE         LD (BellVolR), A
 158+ DEF6 18 0B            JR .panDone
 159+ DEF8
 160+ DEF8              .panCenter:
 161+ DEF8                  ; Alineado: solo canal B
 162+ DEF8 78               LD A, B
 163+ DEF9 32 A5 DE         LD (BellVolC), A
 164+ DEFC AF               XOR A
 165+ DEFD 32 A4 DE         LD (BellVolL), A
 166+ DF00 32 A6 DE         LD (BellVolR), A
 167+ DF03
 168+ DF03              .panDone:
 169+ DF03 3E 02            LD A, BELL_DECAY_RATE
 170+ DF05 32 A7 DE         LD (BellDecayTimer), A
 171+ DF08
 172+ DF08                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 173+ DF08 3E 00            LD A, 0                     ; R0: tone A LSB
 174+ DF0A 1E 58            LD E, $58
 175+ DF0C CD 66 DE         CALL AY_WriteReg
 176+ DF0F 3E 01            LD A, 1                     ; R1: tone A MSB
 177+ DF11 1E 02            LD E, $02
 178+ DF13 CD 66 DE         CALL AY_WriteReg
 179+ DF16 3E 02            LD A, 2                     ; R2: tone B LSB
 180+ DF18 1E 58            LD E, $58
 181+ DF1A CD 66 DE         CALL AY_WriteReg
 182+ DF1D 3E 03            LD A, 3                     ; R3: tone B MSB
 183+ DF1F 1E 02            LD E, $02
 184+ DF21 CD 66 DE         CALL AY_WriteReg
 185+ DF24 3E 04            LD A, 4                     ; R4: tone C LSB
 186+ DF26 1E 58            LD E, $58
 187+ DF28 CD 66 DE         CALL AY_WriteReg
 188+ DF2B 3E 05            LD A, 5                     ; R5: tone C MSB
 189+ DF2D 1E 02            LD E, $02
 190+ DF2F CD 66 DE         CALL AY_WriteReg
 191+ DF32
 192+ DF32                  ; --- Mixer: tonos A, B, C activos ---
 193+ DF32 3E 07            LD A, 7
 194+ DF34 1E 38            LD E, $38                   ; 00111000: ruidos off, tonos ABC on
 195+ DF36 CD 66 DE         CALL AY_WriteReg
 196+ DF39
 197+ DF39                  ; --- Volúmenes iniciales ---
 198+ DF39 3E 08            LD A, 8
 199+ DF3B 21 A4 DE         LD HL, BellVolL
 200+ DF3E 5E               LD E, (HL)
 201+ DF3F CD 66 DE         CALL AY_WriteReg
 202+ DF42 3E 09            LD A, 9
 203+ DF44 21 A5 DE         LD HL, BellVolC
 204+ DF47 5E               LD E, (HL)
 205+ DF48 CD 66 DE         CALL AY_WriteReg
 206+ DF4B 3E 0A            LD A, 10
 207+ DF4D 21 A6 DE         LD HL, BellVolR
 208+ DF50 5E               LD E, (HL)
 209+ DF51 CD 66 DE         CALL AY_WriteReg
 210+ DF54
 211+ DF54 C9               RET
 212+ DF55
 213+ DF55              ; ==============================================================================
 214+ DF55              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 215+ DF55              ; ==============================================================================
 216+ DF55              ; Llamar cada frame desde el main loop.
 217+ DF55              ; ==============================================================================
 218+ DF55              AY_UpdateBell:
 219+ DF55                  ; ¿alguno de los 3 canales aún suena?
 220+ DF55 3A A4 DE         LD A, (BellVolL)
 221+ DF58 47               LD B, A
 222+ DF59 3A A5 DE         LD A, (BellVolC)
 223+ DF5C B0               OR B
 224+ DF5D 47               LD B, A
 225+ DF5E 3A A6 DE         LD A, (BellVolR)
 226+ DF61 B0               OR B
 227+ DF62 C8               RET Z                       ; los 3 a 0 → silenciado
 228+ DF63
 229+ DF63 21 A7 DE         LD HL, BellDecayTimer
 230+ DF66 35               DEC (HL)
 231+ DF67 C0               RET NZ                      ; aun no toca decrementar
 232+ DF68
 233+ DF68 3E 02            LD A, BELL_DECAY_RATE
 234+ DF6A 32 A7 DE         LD (BellDecayTimer), A
 235+ DF6D
 236+ DF6D                  ; Decrementar canal A (si > 0)
 237+ DF6D 3A A4 DE         LD A, (BellVolL)
 238+ DF70 B7               OR A
 239+ DF71 28 0A            JR Z, .skipA
 240+ DF73 3D               DEC A
 241+ DF74 32 A4 DE         LD (BellVolL), A
 242+ DF77 5F               LD E, A
 243+ DF78 3E 08            LD A, 8
 244+ DF7A CD 66 DE         CALL AY_WriteReg
 245+ DF7D              .skipA:
 246+ DF7D
 247+ DF7D                  ; Decrementar canal B (si > 0)
 248+ DF7D 3A A5 DE         LD A, (BellVolC)
 249+ DF80 B7               OR A
 250+ DF81 28 0A            JR Z, .skipB
 251+ DF83 3D               DEC A
 252+ DF84 32 A5 DE         LD (BellVolC), A
 253+ DF87 5F               LD E, A
 254+ DF88 3E 09            LD A, 9
 255+ DF8A CD 66 DE         CALL AY_WriteReg
 256+ DF8D              .skipB:
 257+ DF8D
 258+ DF8D                  ; Decrementar canal C (si > 0)
 259+ DF8D 3A A6 DE         LD A, (BellVolR)
 260+ DF90 B7               OR A
 261+ DF91 C8               RET Z
 262+ DF92 3D               DEC A
 263+ DF93 32 A6 DE         LD (BellVolR), A
 264+ DF96 5F               LD E, A
 265+ DF97 3E 0A            LD A, 10
 266+ DF99 C3 66 DE         JP AY_WriteReg              ; tail call
 267+ DF9C
