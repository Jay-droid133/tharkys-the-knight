7178+ C6D9              ; ==============================================================================
7179+ C6D9              ; DeathBfsRescue - Mini-BFS local cuando UpdateMonster no consigue mover Death
7180+ C6D9              ; ==============================================================================
7181+ C6D9              ; Activado por UpdateDeath tras DEATH_STUCK_THRESHOLD frames consecutivos sin
7182+ C6D9              ; movimiento. Hace BFS de 4-conectividad desde la celda de Death hasta
7183+ C6D9              ; profundidad DEATH_BFS_MAX_DEPTH, tracking para cada celda visitada cual fue
7184+ C6D9              ; el primer paso (N/S/W/E) desde el inicio.
7185+ C6D9              ;
7186+ C6D9              ; Pasability: 9 celdas del footprint 3x3 deben ser 0 en CollisionMap (criterio
7187+ C6D9              ; consistente con CheckEnemyCollision en cell-aligned positions).
7188+ C6D9              ;
7189+ C6D9              ; Score: maximizar profundidad alcanzada, tie-break por minima manhattan al
7190+ C6D9              ; player. El "max depth" rompe la trampa Manhattan del greedy puro (ej. wall
7191+ C6D9              ; al pie + player justo debajo: ir lateral aumenta manhattan en 1 al primer
7192+ C6D9              ; paso pero permite llegar a una celda mas profunda con dist menor).
7193+ C6D9              ;
7194+ C6D9              ; Tras encontrar best dir: setea DELTAX/Y a ±MONSTER_SPEED, intenta UN paso
7195+ C6D9              ; con CheckEnemyCollision. Si falla, no-op (siguiente frame retry). Si OK,
7196+ C6D9              ; persistencia de UpdateMonster mantendra la direccion en frames sucesivos.
7197+ C6D9              ;
7198+ C6D9              ; IX = SLOT_DEATH al entrar.
7199+ C6D9              ; ==============================================================================
7200+ C6D9              DeathBfsRescue:
7201+ C6D9                  ; --- Celda inicial = celda actual de Death ---
7202+ C6D9 DD 7E 03         LD A, (IX+ENT_POSX)
7203+ C6DC 0F               RRCA
7204+ C6DD 0F               RRCA
7205+ C6DE 0F               RRCA
7206+ C6DF E6 1F            AND $1F
7207+ C6E1 32 74 5F         LD (DBfsCurCx), A
7208+ C6E4 DD 7E 04         LD A, (IX+ENT_POSY)
7209+ C6E7 D6 10            SUB SCREEN_MIN_Y
7210+ C6E9 0F               RRCA
7211+ C6EA 0F               RRCA
7212+ C6EB 0F               RRCA
7213+ C6EC E6 1F            AND $1F
7214+ C6EE 32 75 5F         LD (DBfsCurCy), A
7215+ C6F1                  ; --- Celda del player ---
7216+ C6F1 3A 9E 81         LD A, (EntityTable + ENT_POSX)
7217+ C6F4 0F               RRCA
7218+ C6F5 0F               RRCA
7219+ C6F6 0F               RRCA
7220+ C6F7 E6 1F            AND $1F
7221+ C6F9 32 72 5F         LD (DBfsPlayerCx), A
7222+ C6FC 3A 9F 81         LD A, (EntityTable + ENT_POSY)
7223+ C6FF D6 10            SUB SCREEN_MIN_Y
7224+ C701 0F               RRCA
7225+ C702 0F               RRCA
7226+ C703 0F               RRCA
7227+ C704 E6 1F            AND $1F
7228+ C706 32 73 5F         LD (DBfsPlayerCy), A
7229+ C709                  ; --- Init queue con celda inicial (depth=0, first_dir=NONE) ---
7230+ C709 21 FF 5E         LD HL, DBfsQueue
7231+ C70C 22 6B 5F         LD (DBfsQHead), HL
7232+ C70F 3A 74 5F         LD A, (DBfsCurCx)
7233+ C712 77               LD (HL), A
7234+ C713 23               INC HL
7235+ C714 3A 75 5F         LD A, (DBfsCurCy)
7236+ C717 77               LD (HL), A
7237+ C718 23               INC HL
7238+ C719 36 FF            LD (HL), MAI_DIR_NONE
7239+ C71B 23               INC HL
7240+ C71C 36 00            LD (HL), 0
7241+ C71E 23               INC HL
7242+ C71F 22 6D 5F         LD (DBfsQTail), HL
