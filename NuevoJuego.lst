 500+ 6904              ; ==============================================================================
 501+ 6904              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 502+ 6904              ; ==============================================================================
 503+ 6904              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 504+ 6904              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 505+ 6904              ;
 506+ 6904              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 507+ 6904              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 508+ 6904              ;     E = pixel X (0-255).
 509+ 6904              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 510+ 6904              ; Solo XOR de pixels (no toca attrs).
 511+ 6904              ; Destruye: AF, BC, DE, HL, IX.
 512+ 6904              ; ==============================================================================
 513+ 6904              DrawBgSprite16XorAtPixel:
 514+ 6904 DD 21 9B 89      LD IX, BgSpriteBuffer
 515+ 6908 DD 7E 00         LD A, (IX+0)                            ; height_px
 516+ 690B B7               OR A
 517+ 690C C8               RET Z
 518+ 690D 32 70 69         LD (.dbsHeight), A
 519+ 6910 DD 23            INC IX
 520+ 6912 DD 23            INC IX                                  ; -> pixel data
 521+ 6914                  ; Shift = E & 7 ; aligned X = E & ~7
 522+ 6914 7B               LD A, E
 523+ 6915 E6 07            AND $07
 524+ 6917 32 71 69         LD (.dbsShift), A
 525+ 691A 7B               LD A, E
 526+ 691B E6 F8            AND $F8
 527+ 691D 5F               LD E, A
 528+ 691E CD A6 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
 529+ 6921              .dbsRow:
 530+ 6921 E5               PUSH HL                                 ; save row start
 531+ 6922                  ; --- Byte 0 del sprite ---
 532+ 6922 DD 7E 00         LD A, (IX+0)
 533+ 6925 2F               CPL                                     ; un-invert
 534+ 6926 57               LD D, A                                 ; D = sprite byte
 535+ 6927 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 536+ 6929 3A 71 69         LD A, (.dbsShift)
 537+ 692C B7               OR A
 538+ 692D 28 07            JR Z, .dbsNoShift0
 539+ 692F 47               LD B, A
 540+ 6930              .dbsShift0Loop:
 541+ 6930 CB 3A            SRL D
 542+ 6932 CB 1B            RR E
 543+ 6934 10 FA            DJNZ .dbsShift0Loop
 544+ 6936              .dbsNoShift0:
 545+ 6936 7A               LD A, D
 546+ 6937 AE               XOR (HL)
 547+ 6938 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 548+ 6939 23               INC HL
 549+ 693A 4B               LD C, E                                 ; C = carry para siguiente byte
 550+ 693B                  ; --- Byte 1 del sprite ---
 551+ 693B DD 7E 01         LD A, (IX+1)
 552+ 693E 2F               CPL
 553+ 693F 57               LD D, A
 554+ 6940 1E 00            LD E, 0
 555+ 6942 3A 71 69         LD A, (.dbsShift)
 556+ 6945 B7               OR A
 557+ 6946 28 07            JR Z, .dbsNoShift1
 558+ 6948 47               LD B, A
 559+ 6949              .dbsShift1Loop:
 560+ 6949 CB 3A            SRL D
 561+ 694B CB 1B            RR E
 562+ 694D 10 FA            DJNZ .dbsShift1Loop
 563+ 694F              .dbsNoShift1:
 564+ 694F 7A               LD A, D
 565+ 6950 B1               OR C                                    ; combinar con carry de byte 0
 566+ 6951 AE               XOR (HL)
 567+ 6952 77               LD (HL), A
 568+ 6953 23               INC HL
 569+ 6954 4B               LD C, E                                 ; carry para byte final
 570+ 6955                  ; --- Byte final (solo si shift>0) ---
 571+ 6955 3A 71 69         LD A, (.dbsShift)
 572+ 6958 B7               OR A
 573+ 6959 28 03            JR Z, .dbsNoFinal
 574+ 695B 79               LD A, C
 575+ 695C AE               XOR (HL)
 576+ 695D 77               LD (HL), A
 577+ 695E              .dbsNoFinal:
 578+ 695E E1               POP HL                                  ; restore row start
 579+ 695F CD 12 9E         CALL NextPixelLine
 580+ 6962 DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 581+ 6964 DD 23            INC IX
 582+ 6966 3A 70 69         LD A, (.dbsHeight)
 583+ 6969 3D               DEC A
 584+ 696A 32 70 69         LD (.dbsHeight), A
 585+ 696D 20 B2            JR NZ, .dbsRow
 586+ 696F C9               RET
 587+ 6970 00           .dbsHeight: DEFB 0
 588+ 6971 00           .dbsShift:  DEFB 0
