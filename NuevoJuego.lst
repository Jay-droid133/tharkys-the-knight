1707+ AC2B 0E 01            LD C, ANIM_DELAY_FIGHT
1708+ AC2D 18 2B            JR .applyAnim
1709+ AC2F
1710+ AC2F              .animRun:
1711+ AC2F DD 7E 0A         LD A, (IX+ENT_DIR)
1712+ AC32 E6 0F            AND $0F                     ; dir actual
1713+ AC34                  ; Prioridad: E/W sobre N/S
1714+ AC34 CB 57            BIT 2, A
1715+ AC36 20 0C            JR NZ, .runE
1716+ AC38 CB 5F            BIT 3, A
1717+ AC3A 20 10            JR NZ, .runW
1718+ AC3C CB 47            BIT 0, A
1719+ AC3E 20 14            JR NZ, .runN
1720+ AC40 16 0E            LD D, SPRID_WALK_S
1721+ AC42 18 12            JR .runSet
1722+ AC44              .runE:
1723+ AC44 16 02            LD D, SPRID_WALK_E
1724+ AC46 1E 04            LD E, 4
1725+ AC48 0E 02            LD C, ANIM_DELAY_RUN
1726+ AC4A 18 0E            JR .applyAnim
1727+ AC4C              .runW:
1728+ AC4C 16 06            LD D, SPRID_WALK_W
1729+ AC4E 1E 04            LD E, 4
1730+ AC50 0E 02            LD C, ANIM_DELAY_RUN
1731+ AC52 18 06            JR .applyAnim
1732+ AC54              .runN:
1733+ AC54 16 0A            LD D, SPRID_WALK_N
1734+ AC56              .runSet:
