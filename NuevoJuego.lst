7098+ C6A2              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
7099+ C6A2              UpdateDeathTimer:
7100+ C6A2                  IF DEBUG_NO_ENEMIES
7101+ C6A2 ~                RET
7102+ C6A2                  ENDIF
7103+ C6A2 3A 02 83         LD A, (DeathSpawned)
7104+ C6A5 B7               OR A
7105+ C6A6 C0               RET NZ                              ; ya spawneada: nada que hacer
7106+ C6A7                  ; Inhibida en esta sala (puerta de iglesia abierta -> cinematica de
7107+ C6A7                  ; captura corre sin interferencia). Se limpia al cambiar de sala.
7108+ C6A7 3A 01 83         LD A, (DeathInhibitInRoom)
7109+ C6AA B7               OR A
7110+ C6AB C0               RET NZ
7111+ C6AC                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
7112+ C6AC                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
7113+ C6AC                  ; arranca de cero al recuperar el control (urb1LastBeat).
7114+ C6AC 3A EF 82         LD A, (DeathBorderPhase)
7115+ C6AF B7               OR A
7116+ C6B0 C0               RET NZ
7117+ C6B1 3A F3 82         LD A, (PlayerRespawnPhase)
7118+ C6B4 FE 01            CP 1
7119+ C6B6 C8               RET Z
7120+ C6B7                  ; Death aparece normalmente desde medianoche en adelante, en cualquier
7121+ C6B7                  ; sala. NO bloqueamos por MonstersActive — eso era confundir "monsters
7122+ C6B7                  ; activos en general" con "fase del cutscene de trampa de iglesia",
7123+ C6B7                  ; cosas distintas. Si el player esta en cutscene de iglesia su input
7124+ C6B7                  ; ya esta congelado, asi que Death no presiona ahi tampoco.
7125+ C6B7 2A FF 82         LD HL, (DeathScreenTimer)
7126+ C6BA 11 FA 00         LD DE, DEATH_SPAWN_FRAMES
7127+ C6BD E5               PUSH HL
7128+ C6BE B7               OR A
