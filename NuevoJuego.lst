 687+ B227 32 75 B2         LD (CurrentTintPaper), A
 688+ B22A DD 23            INC IX
 689+ B22C
 690+ B22C                  ; --- Pintar atributos ---
 691+ B22C DD 7E 00         LD A, (IX+0)                ; attr_h
 692+ B22F B7               OR A
 693+ B230 C8               RET Z
 694+ B231 5F               LD E, A                     ; E = filas de atributos
 695+ B232 DD 7E 01         LD A, (IX+1)                ; attr_w
 696+ B235 57               LD D, A                     ; D = columnas de atributos
 697+ B236 DD 23            INC IX
 698+ B238 DD 23            INC IX                      ; IX -> attr data
