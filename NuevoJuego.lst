 706+ E56A              ; Dibuja un caracter de la ROM font en fila 0 del HUD
 707+ E56A              ; A = codigo ASCII, E = columna (0-31)
 708+ E56A              DrawHudCharRow0:
 709+ E56A 6F               LD L, A
 710+ E56B 26 00            LD H, 0
 711+ E56D 29               ADD HL, HL
 712+ E56E 29               ADD HL, HL
