 639+ 7F8B 47               LD B, A
 640+ 7F8C 3A 85 7F         LD A, (BellVolC)
 641+ 7F8F B0               OR B
 642+ 7F90 47               LD B, A
 643+ 7F91 3A 86 7F         LD A, (BellVolR)
 644+ 7F94 B0               OR B
 645+ 7F95 C8               RET Z                           ; los 3 a 0 -> silenciada
 646+ 7F96
 647+ 7F96 21 87 7F         LD HL, BellDecayTimer
 648+ 7F99 35               DEC (HL)
 649+ 7F9A C0               RET NZ                          ; aun no toca decrementar
 650+ 7F9B
 651+ 7F9B 3E 02            LD A, BELL_DECAY_RATE
 652+ 7F9D 32 87 7F         LD (BellDecayTimer), A
 653+ 7FA0
 654+ 7FA0                  ; Decrementar canal A (R8) si > 0
 655+ 7FA0 3A 84 7F         LD A, (BellVolL)
 656+ 7FA3 B7               OR A
 657+ 7FA4 28 0A            JR Z, .btiSkipA
 658+ 7FA6 3D               DEC A
 659+ 7FA7 32 84 7F         LD (BellVolL), A
 660+ 7FAA 5F               LD E, A
 661+ 7FAB 3E 08            LD A, 8
 662+ 7FAD CD 87 7D         CALL AY_WriteRegSlot1
 663+ 7FB0              .btiSkipA:
 664+ 7FB0                  ; Decrementar canal B (R9) si > 0
 665+ 7FB0 3A 85 7F         LD A, (BellVolC)
 666+ 7FB3 B7               OR A
 667+ 7FB4 28 0A            JR Z, .btiSkipB
 668+ 7FB6 3D               DEC A
 669+ 7FB7 32 85 7F         LD (BellVolC), A
 670+ 7FBA 5F               LD E, A
 671+ 7FBB 3E 09            LD A, 9
 672+ 7FBD CD 87 7D         CALL AY_WriteRegSlot1
 673+ 7FC0              .btiSkipB:
