 144+ 9088              ; ==============================================================================
 145+ 9088              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 146+ 9088              ; ==============================================================================
 147+ 9088              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 148+ 9088              ;      A  = bank (0-7) donde vive el sprite
 149+ 9088              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 150+ 9088              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 151+ 9088              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 152+ 9088              ;
 153+ 9088              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 154+ 9088              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 155+ 9088              ; forzar EI prematuro en startup.
 156+ 9088              ;
 157+ 9088              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 158+ 9088              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 159+ 9088              ; ==============================================================================
 160+ 9088              LoadBgSpriteToBuffer:
 161+ 9088                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 162+ 9088                  ; necesitan intacto, y los registros alternos se usan abajo).
 163+ 9088 32 18 91         LD (.lbsBankSave), A
 164+ 908B                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 165+ 908B                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 166+ 908B C5               PUSH BC
 167+ 908C ED 57            LD A, I
 168+ 908E F5               PUSH AF                         ; P/V = IFF2
 169+ 908F F3               DI
 170+ 9090                  ; Page bank deseado inline
 171+ 9090 3A FB 8F         LD A, (CurrentPaging)
 172+ 9093 E6 F8            AND $F8
 173+ 9095 47               LD B, A                         ; B = paging limpio sin bank
 174+ 9096 3A 18 91         LD A, (.lbsBankSave)
 175+ 9099 E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 909B B0               OR B                            ; merge bank en paging
 177+ 909C 32 FB 8F         LD (CurrentPaging), A
 178+ 909F 01 FD 7F         LD BC, $7FFD
 179+ 90A2 ED 79            OUT (C), A
 180+ 90A4                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 90A4                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 90A4                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 90A4                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 90A4 11 AE 88         LD DE, BgSpriteBuffer
 185+ 90A7                  ; Copiar H (header byte 0)
 186+ 90A7 7E               LD A, (HL)
