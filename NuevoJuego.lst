2704+ AD9C              ; ==============================================================================
2705+ AD9C              ; ==============================================================================
2706+ AD9C              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2707+ AD9C              ; ==============================================================================
2708+ AD9C              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2709+ AD9C              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2710+ AD9C              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2711+ AD9C              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2712+ AD9C              ; ==============================================================================
2713+ AD9C              UpdateMonster:
2714+ AD9C                  ; --- Stun: knockback + pausa tras golpe del player ---
2715+ AD9C DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2716+ AD9F B7               OR A
2717+ ADA0 CA D5 AF         JP Z, .moNormal
2718+ ADA3 DD 35 0A         DEC (IX+ENT_DIR)
2719+ ADA6 20 0B            JR NZ, .moStunActive
2720+ ADA8                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2721+ ADA8 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2722+ ADAC DD 36 07 00      LD (IX+ENT_DELTAY), 0
2723+ ADB0 C3 D5 AF         JP .moNormal
2724+ ADB3
2725+ ADB3              .moStunActive:
2726+ ADB3                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2727+ ADB3 FE 06            CP MONSTER_STUN_PAUSE
2728+ ADB5 DA 66 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2729+ ADB8                  ; Knockback: aplicar movimiento con collision check
2730+ ADB8 DD 56 06         LD D, (IX+ENT_DELTAX)
2731+ ADBB DD 5E 07         LD E, (IX+ENT_DELTAY)
2732+ ADBE 7A               LD A, D
2733+ ADBF B3               OR E
2734+ ADC0 CA 66 B1         JP Z, .moAnimate
2735+ ADC3                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2736+ ADC3 D5               PUSH DE
2737+ ADC4 DD 7E 03         LD A, (IX+ENT_POSX)
2738+ ADC7 32 FE B2         LD (.moSvX), A
2739+ ADCA DD 7E 04         LD A, (IX+ENT_POSY)
2740+ ADCD 32 FF B2         LD (.moSvY), A
2741+ ADD0                  ; Calcular nueva posicion
2742+ ADD0 DD 7E 03         LD A, (IX+ENT_POSX)
2743+ ADD3 82               ADD A, D
2744+ ADD4 DD 77 03         LD (IX+ENT_POSX), A
2745+ ADD7 DD 7E 04         LD A, (IX+ENT_POSY)
2746+ ADDA 83               ADD A, E
2747+ ADDB DD 77 04         LD (IX+ENT_POSY), A
2748+ ADDE                  ; Comprobar bordes ANTES de colision con paredes
2749+ ADDE DD 7E 03         LD A, (IX+ENT_POSX)
2750+ ADE1 FE E8            CP SCREEN_MAX_X
2751+ ADE3 30 30            JR NC, .moKbPreOffscreen
2752+ ADE5 FE 04            CP MONSTER_KB_SPEED
2753+ ADE7 38 20            JR C, .moKbPreOffscreenMaybeX
2754+ ADE9              .moKbPreBorderXOk:
2755+ ADE9 DD 7E 04         LD A, (IX+ENT_POSY)
2756+ ADEC FE A8            CP SCREEN_MAX_Y
2757+ ADEE 30 25            JR NC, .moKbPreOffscreen
2758+ ADF0 FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2759+ ADF2 38 1B            JR C, .moKbPreOffscreenMaybeY
2760+ ADF4              .moKbPreBorderOk:
2761+ ADF4                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2762+ ADF4                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2763+ ADF4                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2764+ ADF4                  ; CheckEnemyCollision.
2765+ ADF4                  ; CheckChurchTrap retorna:
2766+ ADF4                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2767+ ADF4                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2768+ ADF4                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2769+ ADF4 CD 1D F1         CALL CheckChurchTrap
2770+ ADF7 B7               OR A
2771+ ADF8 28 07            JR Z, .moKbCollCheck
2772+ ADFA FE 02            CP 2
2773+ ADFC CA AD AE         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2774+ ADFF D1               POP DE                              ; limpiar PUSH DE previo
2775+ AE00 C9               RET                                 ; cutscene activa, salir
2776+ AE01              .moKbCollCheck:
2777+ AE01                  ; Dentro de pantalla: comprobar colision con paredes
2778+ AE01 CD 7A B6         CALL CheckEnemyCollision
2779+ AE04 C2 AD AE         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2780+ AE07 18 1C            JR .moKbNotBlocked
2781+ AE09              .moKbPreOffscreenMaybeX:
2782+ AE09 CB 7A            BIT 7, D
2783+ AE0B 20 08            JR NZ, .moKbPreOffscreen
2784+ AE0D 18 DA            JR .moKbPreBorderXOk
2785+ AE0F              .moKbPreOffscreenMaybeY:
2786+ AE0F CB 7B            BIT 7, E
2787+ AE11 20 02            JR NZ, .moKbPreOffscreen
2788+ AE13 18 DF            JR .moKbPreBorderOk
2789+ AE15              .moKbPreOffscreen:
2790+ AE15                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2791+ AE15 3A FE B2         LD A, (.moSvX)
2792+ AE18 DD 77 03         LD (IX+ENT_POSX), A
2793+ AE1B 3A FF B2         LD A, (.moSvY)
2794+ AE1E DD 77 04         LD (IX+ENT_POSY), A
2795+ AE21 D1               POP DE
2796+ AE22 C3 12 AF         JP .moKbOffscreen
2797+ AE25              .moKbNotBlocked:
2798+ AE25                  ; Pared libre: comprobar impacto con otro monster (billar)
2799+ AE25 CD FF B1         CALL .moCheckOverlap
2800+ AE28 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2801+ AE2A                  ; Libre: restaurar pos y aplicar movimiento
2802+ AE2A 3A FE B2         LD A, (.moSvX)
2803+ AE2D DD 77 03         LD (IX+ENT_POSX), A
2804+ AE30 3A FF B2         LD A, (.moSvY)
2805+ AE33 DD 77 04         LD (IX+ENT_POSY), A
2806+ AE36 D1               POP DE
2807+ AE37 C3 E9 AE         JP .moKbApply
2808+ AE3A              .moKbBilliard:
2809+ AE3A                  ; Billar: A para en su sitio, B hereda la fuerza
2810+ AE3A 3A FE B2         LD A, (.moSvX)
2811+ AE3D DD 77 03         LD (IX+ENT_POSX), A
2812+ AE40 3A FF B2         LD A, (.moSvY)
2813+ AE43 DD 77 04         LD (IX+ENT_POSY), A
2814+ AE46 D1               POP DE
2815+ AE47                  ; Transferir knockback al monster impactado
2816+ AE47 DD E5            PUSH IX
2817+ AE49 DD 2A 08 B3      LD IX, (.moHitMonster)
2818+ AE4D                  ; Solo transferir si no esta ya en stun
2819+ AE4D DD 7E 0A         LD A, (IX+ENT_DIR)
2820+ AE50 B7               OR A
2821+ AE51 20 2A            JR NZ, .moKbBilliardDone
2822+ AE53                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2823+ AE53 7A               LD A, D
2824+ AE54 B7               OR A
2825+ AE55 28 0D            JR Z, .moBillNoX
2826+ AE57 CB 7A            BIT 7, D
2827+ AE59 20 04            JR NZ, .moBillXNeg
2828+ AE5B 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2829+ AE5D 18 02            JR .moBillSetX
2830+ AE5F              .moBillXNeg:
2831+ AE5F 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2832+ AE61              .moBillSetX:
2833+ AE61 DD 77 06         LD (IX+ENT_DELTAX), A
2834+ AE64              .moBillNoX:
2835+ AE64 7B               LD A, E
2836+ AE65 B7               OR A
2837+ AE66 28 0D            JR Z, .moBillNoY
2838+ AE68 CB 7B            BIT 7, E
2839+ AE6A 20 04            JR NZ, .moBillYNeg
2840+ AE6C 3E 03            LD A, MONSTER_KB_SPEED - 1
2841+ AE6E 18 02            JR .moBillSetY
2842+ AE70              .moBillYNeg:
2843+ AE70 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2844+ AE72              .moBillSetY:
2845+ AE72 DD 77 07         LD (IX+ENT_DELTAY), A
2846+ AE75              .moBillNoY:
2847+ AE75 DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2848+ AE79                  ; Kb heredado por billar: NO es directo del player.
2849+ AE79                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2850+ AE79 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2851+ AE7D              .moKbBilliardDone:
2852+ AE7D DD E1            POP IX
2853+ AE7F                  ; A continua con fuerza reducida (no para del todo)
2854+ AE7F                  ; Reducir velocidad de A a la mitad
2855+ AE7F DD 7E 06         LD A, (IX+ENT_DELTAX)
2856+ AE82 CB 2F            SRA A                               ; /2 con signo
2857+ AE84 DD 77 06         LD (IX+ENT_DELTAX), A
2858+ AE87 57               LD D, A
2859+ AE88 DD 7E 07         LD A, (IX+ENT_DELTAY)
2860+ AE8B CB 2F            SRA A
2861+ AE8D DD 77 07         LD (IX+ENT_DELTAY), A
2862+ AE90 5F               LD E, A
2863+ AE91                  ; Reducir stun restante de A
2864+ AE91 DD 7E 0A         LD A, (IX+ENT_DIR)
2865+ AE94 FE 08            CP MONSTER_STUN_PAUSE + 2
2866+ AE96 DA CA AF         JP C, .moStunStop                   ; Casi sin stun → parar
2867+ AE99 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2868+ AE9B DD 77 0A         LD (IX+ENT_DIR), A
2869+ AE9E                  ; Aplicar movimiento reducido de A
2870+ AE9E 3A FE B2         LD A, (.moSvX)
2871+ AEA1 DD 77 03         LD (IX+ENT_POSX), A
2872+ AEA4 3A FF B2         LD A, (.moSvY)
2873+ AEA7 DD 77 04         LD (IX+ENT_POSY), A
2874+ AEAA C3 E9 AE         JP .moKbApply
2875+ AEAD              .moKbWallBlock:
2876+ AEAD                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2877+ AEAD 3A FE B2         LD A, (.moSvX)
2878+ AEB0 DD 77 03         LD (IX+ENT_POSX), A
2879+ AEB3 3A FF B2         LD A, (.moSvY)
2880+ AEB6 DD 77 04         LD (IX+ENT_POSY), A
2881+ AEB9 D1               POP DE
2882+ AEBA                  ; Intentar solo eje X (mantener direccion del golpe)
2883+ AEBA 7A               LD A, D
2884+ AEBB B7               OR A
2885+ AEBC 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2886+ AEBE D5               PUSH DE
2887+ AEBF 1E 00            LD E, 0
2888+ AEC1 CD C0 B1         CALL .moTryPassable
2889+ AEC4 D1               POP DE
2890+ AEC5 20 09            JR NZ, .moKbSlideY
2891+ AEC7                  ; Slide en X funciona
2892+ AEC7 1E 00            LD E, 0
2893+ AEC9 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2894+ AECD C3 E9 AE         JP .moKbApply
2895+ AED0              .moKbSlideY:
2896+ AED0                  ; Intentar solo eje Y (mantener direccion del golpe)
2897+ AED0 7B               LD A, E
2898+ AED1 B7               OR A
2899+ AED2 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2900+ AED4 D5               PUSH DE
2901+ AED5 16 00            LD D, 0
2902+ AED7 CD C0 B1         CALL .moTryPassable
2903+ AEDA D1               POP DE
2904+ AEDB 20 09            JR NZ, .moKbSlideStop
2905+ AEDD                  ; Slide en Y funciona
2906+ AEDD 16 00            LD D, 0
2907+ AEDF DD 36 06 00      LD (IX+ENT_DELTAX), 0
2908+ AEE3 C3 E9 AE         JP .moKbApply
2909+ AEE6              .moKbSlideStop:
2910+ AEE6 C3 CA AF         JP .moStunStop
2911+ AEE9                  ; (moKbMonsterHit eliminado - reemplazado por moKbBilliard arriba)
2912+ AEE9              .moKbApply:
2913+ AEE9 DD 7E 03         LD A, (IX+ENT_POSX)
2914+ AEEC 82               ADD A, D
2915+ AEED DD 77 03         LD (IX+ENT_POSX), A
2916+ AEF0                  ; Comprobar bordes X
2917+ AEF0 FE E8            CP SCREEN_MAX_X
2918+ AEF2 30 1E            JR NC, .moKbOffscreen               ; Derecha o underflow pasado izquierda
2919+ AEF4                  ; Borde izquierdo: si X < KB_SPEED y empujando a la izquierda
2920+ AEF4 FE 04            CP MONSTER_KB_SPEED
2921+ AEF6 30 04            JR NC, .moKbXOk
