 972+ D297              ; Variables locales DrawBgGfxSprite
 973+ D297 00           .heightCnt: DEFB 0
 974+ D298 00           .widthVal:  DEFB 0
 975+ D299 00           .xChar:     DEFB 0
 976+ D29A 00           .yChar:     DEFB 0
 977+ D29B 00           .rleFlag:   DEFB 0              ; bit 7 = sprite RLE comprimido
 978+ D29C 00           .rlePending: DEFB 0             ; bytes restantes del run actual
 979+ D29D 00           .rleValue:  DEFB 0              ; valor del run actual
 980+ D29E
 981+ D29E              ; Variables de tint
 982+ D29E FF           CurrentTintVar:   DEFB $FF    ; paper destino del placement (255=sin tint)
 983+ D29F FF           CurrentTintPaper: DEFB $FF    ; paper original tintable del sprite (255=no tintable)
 984+ D2A0
 985+ D2A0              ; Bank del sprite que se va a cargar con LoadBgSpriteToBuffer. Los iteradores
 986+ D2A0              ; de placements (DrawScreen, RemapScreenAttrs, CollisionMap) lo leen de
 987+ D2A0              ; BgGfxPtrById[id].bank tras resolver el ID. HUD y otros callers con labels
 988+ D2A0              ; hardcoded (DrawKeyHUD, etc.) asignan 3 directamente.
 989+ D2A0 03           CurrentBgSpriteBank: DEFB 3
 990+ D2A1
 991+ D2A1              ; ID del sprite actualmente siendo procesado en los iteradores (Stage B.2).
 992+ D2A1              ; Usado por CheckIfHouseSprite (compara por ID contra HouseIdList) y por
 993+ D2A1              ; comparaciones con WELL_POZO_ID / RELOJ_PLAZA_ID en DrawScreen.
 994+ D2A1 00           CurrentBgSpriteId: DEFB 0
 995+ D2A2
 996+ D2A2              ; ==============================================================================
 997+ D2A2              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 998+ D2A2              ; ==============================================================================
 999+ D2A2              ; Entrada: A = attr byte
1000+ D2A2              ; Salida:  A = attr con paper reemplazado (o sin cambio)
1001+ D2A2              ; Preserva: HL, DE, BC, IX
1002+ D2A2              ; ==============================================================================
1003+ D2A2              ApplyTintSwap:
1004+ D2A2 C5               PUSH BC
1005+ D2A3 47               LD B, A                     ; B = attr original
1006+ D2A4 3A 9E D2         LD A, (CurrentTintVar)
1007+ D2A7 FE FF            CP $FF
1008+ D2A9 28 24            JR Z, .tintNoChange
1009+ D2AB 4F               LD C, A                     ; C = tint variant (new paper 0-7)
1010+ D2AC 3A 9F D2         LD A, (CurrentTintPaper)
1011+ D2AF FE FF            CP $FF
1012+ D2B1 28 1C            JR Z, .tintNoChange
1013+ D2B3                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
1014+ D2B3                  ; Extraer paper del attr: bits 5-3
1015+ D2B3 78               LD A, B
1016+ D2B4 E6 38            AND $38                     ; A = 00PPP000
1017+ D2B6 0F               RRCA
1018+ D2B7 0F               RRCA
1019+ D2B8 0F               RRCA                        ; A = 00000PPP = paper actual
1020+ D2B9 D5               PUSH DE
1021+ D2BA 57               LD D, A                     ; D = paper actual
1022+ D2BB 3A 9F D2         LD A, (CurrentTintPaper)
1023+ D2BE BA               CP D                        ; paper actual == tintPaper?
1024+ D2BF D1               POP DE
1025+ D2C0 20 0D            JR NZ, .tintNoChange
1026+ D2C2                  ; Match: reemplazar paper bits con tintVar
1027+ D2C2 78               LD A, B
1028+ D2C3 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
1029+ D2C5 D5               PUSH DE
1030+ D2C6 57               LD D, A
1031+ D2C7 79               LD A, C                     ; A = tintVar (0-7)
1032+ D2C8 07               RLCA
1033+ D2C9 07               RLCA
1034+ D2CA 07               RLCA                        ; A = 00PPP000
1035+ D2CB B2               OR D                        ; A = FBPPPIII
1036+ D2CC D1               POP DE
1037+ D2CD C1               POP BC
1038+ D2CE C9               RET
1039+ D2CF              .tintNoChange:
1040+ D2CF 78               LD A, B                     ; devolver sin cambio
1041+ D2D0 C1               POP BC
1042+ D2D1 C9               RET
1043+ D2D2
1044+ D2D2              ; ==============================================================================
1045+ D2D2              ; RemapScreenAttrs - Remap rapido de atributos (sin redibujar pixeles)
1046+ D2D2              ; ==============================================================================
1047+ D2D2              ; Solo se ejecuta cuando AttrsDirty=1 (cambio de fase day/night).
1048+ D2D2              ; Itera BG sprites saltando pixel data, solo repinta attrs con nuevo remap.
1049+ D2D2              ; ==============================================================================
1050+ D2D2              RemapScreenAttrs:
1051+ D2D2 3A 13 83         LD A, (AttrsDirty)
1052+ D2D5 B7               OR A
1053+ D2D6 C8               RET Z
1054+ D2D7
1055+ D2D7 AF               XOR A
1056+ D2D8 32 13 83         LD (AttrsDirty), A
1057+ D2DB
1058+ D2DB                  ; --- Iterar sprites del room (solo attrs, formato Stage A) ---
1059+ D2DB 2A 0C 83         LD HL, (CurrentScreenAddr)
1060+ D2DE              .rsLoop:
1061+ D2DE 7E               LD A, (HL)                  ; A = id
1062+ D2DF 23               INC HL
1063+ D2E0 FE FF            CP $FF
1064+ D2E2 28 42            JR Z, .rsDone
1065+ D2E4 FE D2            CP RANDOM_SLOT_MARKER       ; id 210: ghost (no remap, no attrs).
1066+ D2E6 20 05            JR NZ, .rsNotMarker
1067+ D2E8 23               INC HL
1067+ D2E9 23             INC HL
1067+ D2EA 23             INC HL    ; skip x, y, v
1068+ D2EB 18 F1            JR .rsLoop
1069+ D2ED              .rsNotMarker:
1070+ D2ED 32 A1 D2         LD (CurrentBgSpriteId), A
1071+ D2F0
1072+ D2F0                  ; Resolver id -> (ptr, bank) via BgGfxPtrById (formato 3B: ptr + bank)
1073+ D2F0 E5               PUSH HL
1074+ D2F1 6F               LD L, A
1075+ D2F2 26 00            LD H, 0
1076+ D2F4 54               LD D, H
1077+ D2F5 5D               LD E, L                     ; DE = id
1078+ D2F6 29               ADD HL, HL                  ; HL = id*2
1079+ D2F7 19               ADD HL, DE                  ; HL = id*3
1080+ D2F8 11 86 E0         LD DE, BgGfxPtrById
1081+ D2FB 19               ADD HL, DE
1082+ D2FC 5E               LD E, (HL)
1083+ D2FD 23               INC HL
1084+ D2FE 56               LD D, (HL)                  ; DE = ptr al sprite data
1085+ D2FF 23               INC HL
1086+ D300 7E               LD A, (HL)                  ; A = bank
1087+ D301 32 A0 D2         LD (CurrentBgSpriteBank), A
1088+ D304 E1               POP HL
1089+ D305
1090+ D305 46               LD B, (HL)                  ; B = x_char
1091+ D306 23               INC HL
