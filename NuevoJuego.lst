 383+ 7E1B
 384+ 7E1B              ; ==============================================================================
 385+ 7E1B              ; MusicAdvanceNote - lee siguiente nota y aplica al AY. Despacha por MusicMode.
 386+ 7E1B              ; ==============================================================================
 387+ 7E1B              ; Poly2 entry (5 B): periodA(2) + periodC(2) + duration(1)
 388+ 7E1B              ; Poly3 entry (7 B): periodA(2) + periodB(2) + periodC(2) + duration(1)
 389+ 7E1B              ; period=$0000 en un canal = mute (vol=0) durante esa nota.
 390+ 7E1B              ; duration=$00 (con todos los periods=0) = terminator → loop o stop.
 391+ 7E1B              ; ==============================================================================
 392+ 7E1B              MusicAdvanceNote:
 393+ 7E1B 3A AC 7B         LD A, (MusicMode)
 394+ 7E1E FE 03            CP 3
 395+ 7E20 28 72            JR Z, MusicAdvancePoly3
 396+ 7E22                  ; fall-through a MusicAdvancePoly2
 397+ 7E22
 398+ 7E22              ; --- Poly2 (5 B/entry): periodA, periodC, duration -----------------------------
 399+ 7E22              MusicAdvancePoly2:
 400+ 7E22 2A A6 7B         LD HL, (MusicPtr)
 401+ 7E25                  ; Leer periodA (HL+0..1)
 402+ 7E25 5E               LD E, (HL)
 403+ 7E26 23               INC HL
 404+ 7E27 56               LD D, (HL)
 405+ 7E28 23               INC HL
 406+ 7E29 ED 53 AD 7B      LD (MusicPeriodA), DE
 407+ 7E2D                  ; Leer periodC (HL+2..3) y guardarlo via BC para no clobbearlo
 408+ 7E2D 4E               LD C, (HL)
 409+ 7E2E 23               INC HL
 410+ 7E2F 46               LD B, (HL)
 411+ 7E30 23               INC HL
 412+ 7E31 ED 43 B1 7B      LD (MusicPeriodC), BC
 413+ 7E35                  ; Duration (HL+4)
 414+ 7E35 7E               LD A, (HL)
 415+ 7E36 23               INC HL
 416+ 7E37 B7               OR A
 417+ 7E38 28 57            JR Z, .map2End                  ; duration=0 → terminator
 418+ 7E3A 22 A6 7B         LD (MusicPtr), HL
 419+ 7E3D CD 36 7F         CALL ApplyMusicSpeedShift       ; A in/out: A = duration ajustada
 420+ 7E40 32 A8 7B         LD (MusicTimer), A
 421+ 7E43                  ; --- Aplicar canal A: si period != 0 escribir R0/R1 + R8=vol; si =0, R8=0 ---
 422+ 7E43 2A AD 7B         LD HL, (MusicPeriodA)
 423+ 7E46 7C               LD A, H
 424+ 7E47 B5               OR L
 425+ 7E48 20 09            JR NZ, .map2NoteA
 426+ 7E4A 3E 08            LD A, 8
 427+ 7E4C 1E 00            LD E, 0
 428+ 7E4E CD 87 7D         CALL AY_WriteRegSlot1           ; mute A
 429+ 7E51 18 18            JR .map2DoC
 430+ 7E53              .map2NoteA:
 431+ 7E53 E5               PUSH HL
 432+ 7E54 3E 08            LD A, 8
 433+ 7E56 1E 0C            LD E, 12
 434+ 7E58 CD 87 7D         CALL AY_WriteRegSlot1           ; R8 = vol A
 435+ 7E5B E1               POP HL
 436+ 7E5C 5D               LD E, L
 437+ 7E5D 3E 00            LD A, 0
 438+ 7E5F CD 87 7D         CALL AY_WriteRegSlot1           ; R0
 439+ 7E62 2A AD 7B         LD HL, (MusicPeriodA)
 440+ 7E65 5C               LD E, H
 441+ 7E66 3E 01            LD A, 1
 442+ 7E68 CD 87 7D         CALL AY_WriteRegSlot1           ; R1
 443+ 7E6B              .map2DoC:
 444+ 7E6B                  ; --- Aplicar canal C: igual logica con R4/R5 + R10 ---
 445+ 7E6B 2A B1 7B         LD HL, (MusicPeriodC)
 446+ 7E6E 7C               LD A, H
 447+ 7E6F B5               OR L
 448+ 7E70 20 07            JR NZ, .map2NoteC
 449+ 7E72 3E 0A            LD A, 10
 450+ 7E74 1E 00            LD E, 0
 451+ 7E76 C3 87 7D         JP AY_WriteRegSlot1             ; tail-call: mute C
 452+ 7E79              .map2NoteC:
 453+ 7E79 E5               PUSH HL
 454+ 7E7A 3E 0A            LD A, 10
 455+ 7E7C 1E 0C            LD E, 12
 456+ 7E7E CD 87 7D         CALL AY_WriteRegSlot1           ; R10 = vol C
 457+ 7E81 E1               POP HL
 458+ 7E82 5D               LD E, L
 459+ 7E83 3E 04            LD A, 4
 460+ 7E85 CD 87 7D         CALL AY_WriteRegSlot1           ; R4
 461+ 7E88 2A B1 7B         LD HL, (MusicPeriodC)
 462+ 7E8B 5C               LD E, H
 463+ 7E8C 3E 05            LD A, 5
 464+ 7E8E C3 87 7D         JP AY_WriteRegSlot1             ; tail-call: R5
 465+ 7E91              .map2End:
 466+ 7E91 C3 4B 7F         JP MusicEndOfTable
