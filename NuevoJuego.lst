# file closed: monster_ai.asm
 493  985D                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 494  985D                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 495  985D                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 985D              ; ==============================================================================
   2+ 985D              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 985D              ; ==============================================================================
   4+ 985D              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 985D              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 985D              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 985D              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 985D              ;
   9+ 985D              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 985D              ; fallo en el intento previo):
  11+ 985D              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 985D              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 985D              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 985D              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 985D              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 985D              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 985D              ;      nadie las toca, asi que no hay corrupcion.
  18+ 985D              ;
  19+ 985D              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 985D              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 985D              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 985D              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 985D              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 985D              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 985D              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 985D              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 985D              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 985D              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 985D              ; ==============================================================================
  30+ 985D
  31+ 985D              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 985D              AY_Init:
  33+ 985D F3               DI
  34+ 985E 3A 87 8D         LD A, (CurrentPaging)
  35+ 9861 E6 F8            AND $F8
  36+ 9863 F6 04            OR 4
  37+ 9865 32 87 8D         LD (CurrentPaging), A
  38+ 9868 01 FD 7F         LD BC, $7FFD
  39+ 986B ED 79            OUT (C), A
  40+ 986D CD B9 E4         CALL AY_InitImpl
  41+ 9870 3A 87 8D         LD A, (CurrentPaging)
  42+ 9873 E6 F8            AND $F8
  43+ 9875 32 87 8D         LD (CurrentPaging), A
  44+ 9878 01 FD 7F         LD BC, $7FFD
  45+ 987B ED 79            OUT (C), A
  46+ 987D 3A 9F 81         LD A, (StartupComplete)
  47+ 9880 B7               OR A
  48+ 9881 C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9882 FB               EI
  50+ 9883 C9               RET
