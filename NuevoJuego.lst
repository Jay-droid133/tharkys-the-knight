 392+ E711 32 A6 5F         LD (TownGateShakeOffsX), A
 393+ E714 32 A7 5F         LD (TownGateShakeOffsY), A
 394+ E717 CD F4 E9         CALL SFX_TownGate_OnShake
 395+ E71A 3E 28            LD A, TGCS_T_SHAKE
 396+ E71C 32 A5 5F         LD (TownGateTimer), A
 397+ E71F 3E 04            LD A, TGP_SHAKE
 398+ E721 32 D0 82         LD (TownGatePhase), A
 399+ E724 C9               RET
