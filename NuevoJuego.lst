6835+ C536              ; ==============================================================================
6836+ C536              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6837+ C536              ; ==============================================================================
6838+ C536              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6839+ C536              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6840+ C536              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6841+ C536              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6842+ C536              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6843+ C536              ; main.asm; aqui no hace falta guard adicional).
6844+ C536              ; ==============================================================================
6845+ C536
6846+ C536              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6847+ C536              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6848+ C536              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6849+ C536              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6850+ C536              ;
6851+ C536              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6852+ C536              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6853+ C536              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6854+ C536              ;
6855+ C536              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6856+ C536              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6857+ C536              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6858+ C536              ; en vez de 8 + orientacion invertida).
6859+ C536              UpdateDeath:
6860+ C536                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6861+ C536                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6862+ C536                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6863+ C536                  ; progreso real, no solo quedar inmovil. ---
6864+ C536 2A 07 83         LD HL, (DeathGhostStuckTimer)
6865+ C539 23               INC HL
6866+ C53A 22 07 83         LD (DeathGhostStuckTimer), HL
6867+ C53D 7C               LD A, H
6868+ C53E FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6869+ C540 38 1A            JR C, .udGhostCheckDone
6870+ C542 20 05            JR NZ, .udGhostOn
6871+ C544 7D               LD A, L
6872+ C545 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6873+ C547 38 13            JR C, .udGhostCheckDone
6874+ C549              .udGhostOn:
6875+ C549                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6876+ C549                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6877+ C549                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6878+ C549                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6879+ C549                  ; re-disparar restart).
6880+ C549 3A 09 83         LD A, (DeathGhostMode)
6881+ C54C B7               OR A
6882+ C54D 20 0D            JR NZ, .udGhostCheckDone
6883+ C54F 3E 01            LD A, 1
6884+ C551 32 09 83         LD (DeathGhostMode), A
6885+ C554 32 E8 99         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6886+ C557 3E FE            LD A, $FE                       ; sentinel restart-current-track
6887+ C559 CD C2 99         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6888+ C55C              .udGhostCheckDone:
6889+ C55C
6890+ C55C                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6891+ C55C 3A 09 83         LD A, (DeathGhostMode)
6892+ C55F B7               OR A
6893+ C560 C2 A7 C5         JP NZ, DeathGhostChase
6894+ C563
6895+ C563                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6896+ C563 DD 7E 03         LD A, (IX+ENT_POSX)
6897+ C566 32 04 83         LD (DeathPrevX), A
6898+ C569 DD 7E 04         LD A, (IX+ENT_POSY)
6899+ C56C 32 05 83         LD (DeathPrevY), A
6900+ C56F                  ; Sub-pixel acc 1/2
6901+ C56F 3A 03 83         LD A, (DeathSubPixelAcc)
6902+ C572 EE 01            XOR 1
6903+ C574 32 03 83         LD (DeathSubPixelAcc), A
6904+ C577 28 05            JR Z, .udSkip
