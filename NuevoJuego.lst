 156+ EC70              .checkPhase:
 157+ EC70 3A AB EA         LD A, (GameHours)
 158+ EC73 21 B5 EA         LD HL, PhaseTable
 159+ EC76 06 07            LD B, 7
 160+ EC78              .phaseLoop:
 161+ EC78 BE               CP (HL)
 162+ EC79 28 05            JR Z, .phaseFound
 163+ EC7B 23               INC HL
 164+ EC7C 23               INC HL
 165+ EC7D 10 F9            DJNZ .phaseLoop
 166+ EC7F C9               RET
 167+ EC80              .phaseFound:
 168+ EC80 23               INC HL
 169+ EC81 7E               LD A, (HL)
 170+ EC82 F5               PUSH AF
 171+ EC83 CD 4B E4         CALL SetTimeOfDay
 172+ EC86 F1               POP AF
 173+ EC87 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EC89 C0               RET NZ
 175+ EC8A                  ; Nuevo dia: incrementar ciclo
 176+ EC8A 21 63 BD         LD HL, DayCycleCount
 177+ EC8D 34               INC (HL)
 178+ EC8E C9               RET
