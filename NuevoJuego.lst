 115+ 6050              ; ==============================================================================
 116+ 6050              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 117+ 6050              ; ==============================================================================
 118+ 6050              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 119+ 6050              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 120+ 6050              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 121+ 6050              ;
 122+ 6050              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 123+ 6050              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 124+ 6050              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 125+ 6050              ; Destruye: AF, BC, DE, HL, IX.
 126+ 6050              ; ==============================================================================
 127+ 6050              CheckTownGateTriggerBg:
 128+ 6050 3A 04 82         LD A, (TownGatePhase)
 129+ 6053 B7               OR A
 130+ 6054 C0               RET NZ                              ; ya en cutscene
 131+ 6055 3A EF 81         LD A, (CurrentKey)
 132+ 6058 FE 06            CP TGCS_ARCH_KEY_ID
 133+ 605A C0               RET NZ                              ; sin la key correcta
 134+ 605B 3A 1D 82         LD A, (CurrentScreenX)
 135+ 605E FE 07            CP TGCS_ARCH_ROOM_X
 136+ 6060 C0               RET NZ
 137+ 6061 3A 1E 82         LD A, (CurrentScreenY)
 138+ 6064 FE 0F            CP TGCS_ARCH_ROOM_Y
 139+ 6066 C0               RET NZ
 140+ 6067                  ; --- Horizontal AABB ---
 141+ 6067 3A DF 80         LD A, (EntityTable + ENT_POSX)
 142+ 606A 4F               LD C, A                             ; C = player_left
 143+ 606B C6 10            ADD A, 16
 144+ 606D 57               LD D, A                             ; D = player_right
 145+ 606E 3E 50            LD A, TGCS_ARCH_PX_LEFT
 146+ 6070 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 147+ 6072 30 01            JR NC, .ctgtNoUnderL
 148+ 6074 AF               XOR A
 149+ 6075              .ctgtNoUnderL:
 150+ 6075 BA               CP D
 151+ 6076 D0               RET NC                              ; ext_left >= player_right
 152+ 6077 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 153+ 6079 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 154+ 607B 30 02            JR NC, .ctgtNoOverR
 155+ 607D 3E FF            LD A, $FF
 156+ 607F              .ctgtNoOverR:
 157+ 607F B9               CP C
 158+ 6080 D8               RET C                               ; ext_right < player_left
 159+ 6081                  ; --- Vertical AABB ---
 160+ 6081                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 161+ 6081                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 162+ 6081                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 163+ 6081                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 164+ 6081                  ; con la altura real del rect.
 165+ 6081 3A E0 80         LD A, (EntityTable + ENT_POSY)
 166+ 6084 4F               LD C, A                             ; C = player_top
 167+ 6085 C6 15            ADD A, 21
 168+ 6087 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 169+ 6088 3E 78            LD A, TGCS_ARCH_PX_TOP
 170+ 608A D6 04            SUB TGCS_ARCH_TOLERANCE
 171+ 608C 30 01            JR NC, .ctgtNoUnderT
 172+ 608E AF               XOR A
 173+ 608F              .ctgtNoUnderT:
 174+ 608F BA               CP D
 175+ 6090 D0               RET NC
 176+ 6091 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 177+ 6093 C6 04            ADD A, TGCS_ARCH_TOLERANCE
 178+ 6095 30 02            JR NC, .ctgtNoOverB
 179+ 6097 3E FF            LD A, $FF
 180+ 6099              .ctgtNoOverB:
 181+ 6099 B9               CP C
 182+ 609A D8               RET C
 183+ 609B                  ; HIT
 184+ 609B CD EC 60         CALL StartTownGateCutscene
 185+ 609E 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 186+ 60A0 C3 78 E9         JP CheckMilestoneTrigger            ; tail call
 187+ 60A3
 188+ 60A3              ; ==============================================================================
 189+ 60A3              ; TownGateWipeAllEnemies - erase XOR + clear de nastys/monsters/death
 190+ 60A3              ; ==============================================================================
 191+ 60A3              ; Itera slots 1..NUM_ENTITIES-1 (slot 0 = player, lo dejamos). Para cada
 192+ 60A3              ; entidad activa que NO sea TYPE_OBJECT/PLAYER: erase via OldSprite XOR +
 193+ 60A3              ; RestoreOldAttr + TYPE_NONE. Igual al pattern de despawn limpio en
 194+ 60A3              ; .peScaredDespawn de logic_game.asm.
 195+ 60A3              ;
 196+ 60A3              ; Llamado desde StartTownGateCutscene antes del snap del player. Asi el
 197+ 60A3              ; mundo queda en silencio durante el cutscene final, sin enemigos
 198+ 60A3              ; congelados (skip de ProcessEnemies durante cutscene los dejaria pintados
 199+ 60A3              ; en su ultima posicion para siempre).
 200+ 60A3              ; Destruye: AF, BC, DE, HL, IX.
 201+ 60A3              ; ==============================================================================
 202+ 60A3              TownGateWipeAllEnemies:
 203+ 60A3 DD 21 EC 80      LD IX, EntityTable + ENT_SIZE       ; slot 1 (skip player)
 204+ 60A7 06 10            LD B, NUM_ENTITIES - 1
 205+ 60A9              .tgwaeLoop:
 206+ 60A9 DD 7E 01         LD A, (IX+ENT_TYPE)
 207+ 60AC B7               OR A
 208+ 60AD 28 31            JR Z, .tgwaeNext                    ; TYPE_NONE: nada que borrar
 209+ 60AF FE 04            CP TYPE_OBJECT
 210+ 60B1 28 2D            JR Z, .tgwaeNext                    ; objetos coleccionables: respetar
 211+ 60B3 FE 01            CP TYPE_PLAYER
 212+ 60B5 28 29            JR Z, .tgwaeNext                    ; (defensivo)
 213+ 60B7 C5               PUSH BC                             ; preservar B (loop counter)
 214+ 60B8 DD E5            PUSH IX                             ; preservar slot ptr
 215+ 60BA CD 08 A8         CALL GetOldSpriteAddr               ; OldSprAddr setado, IX intacto
 216+ 60BD DD 7E 0D         LD A, (IX+ENT_OLDY)
 217+ 60C0 57               LD D, A
 218+ 60C1 DD 7E 0C         LD A, (IX+ENT_OLDX)
 219+ 60C4 5F               LD E, A
 220+ 60C5 DD 2A 90 A7      LD IX, (OldSprAddr)
 221+ 60C9 CD BE 9D         CALL DrawSprite                     ; XOR erase
 222+ 60CC DD E1            POP IX                              ; recuperar slot ptr
 223+ 60CE DD 56 0D         LD D, (IX+ENT_OLDY)
 224+ 60D1 DD 5E 0C         LD E, (IX+ENT_OLDX)
 225+ 60D4 CD 36 CF         CALL RestoreOldAttr                 ; restaurar attrs del fondo
 226+ 60D7 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
 227+ 60DB DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 228+ 60DF C1               POP BC
 229+ 60E0              .tgwaeNext:
 230+ 60E0 11 10 00         LD DE, ENT_SIZE
 231+ 60E3 DD 19            ADD IX, DE
 232+ 60E5 10 C2            DJNZ .tgwaeLoop
 233+ 60E7                  ; Limpiar tambien la cola de pending erases para que EraseDeadSprites
 234+ 60E7                  ; no intente procesar slots que ya hemos borrado (frame en curso).
 235+ 60E7 AF               XOR A
 236+ 60E8 32 7B 5F         LD (PendingEraseCount), A
 237+ 60EB C9               RET
 238+ 60EC
 239+ 60EC              ; ==============================================================================
 240+ 60EC              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 241+ 60EC              ; ==============================================================================
 242+ 60EC              ; 1. Consume key, abre puerta, snap player a anchor1 con frame WALK_N+1.
 243+ 60EC              ; 2. KillAllActiveNasties: nasties pasan a STATE_DYING (puff anim).
 244+ 60EC              ; 3. Entra en TGP_WAIT_NASTIES con TownGateTimer = TGCS_T_PUFF_WAIT.
 245+ 60EC              ;    Durante esta fase MainLoop deja correr ProcessEnemies para que los
 246+ 60EC              ;    puffs se animen y desaparezcan limpiamente. Al expirar el timer,
 247+ 60EC              ;    transicion natural a TGP_LOCK (cutscene continua).
 248+ 60EC              ; Destruye: AF, BC, DE, HL, IX.
 249+ 60EC              ; ==============================================================================
 250+ 60EC              StartTownGateCutscene:
