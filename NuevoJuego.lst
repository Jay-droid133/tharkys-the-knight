 696+ F20E 3A C1 5F         LD A, (MagicCompassPathDir)
 697+ F211 F6 80            OR $80                              ; bit 7 = 1 (lasting)
 698+ F213 47               LD B, A
 699+ F214 3A CC 5F         LD A, (LastMagicCompassDrawn)
 700+ F217 B8               CP B
 701+ F218 28 19            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 702+ F21A 11 36 6F         LD DE, Sprite_Compass_MagicLasting
 703+ F21D 18 0D            JR .dcMagicDraw
 704+ F21F              .dcMagicTemp:
 705+ F21F 3A C1 5F         LD A, (MagicCompassPathDir)         ; bit 7 ya 0 (PathDir 0..3)
 706+ F222 47               LD B, A
 707+ F223 3A CC 5F         LD A, (LastMagicCompassDrawn)
 708+ F226 B8               CP B
 709+ F227 28 0A            JR Z, .dcMagicAttrsOnly             ; mismo path + mismo modo → solo attrs
 710+ F229 11 12 6F         LD DE, Sprite_Compass_Magic
