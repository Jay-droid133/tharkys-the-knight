 741+ F410 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 742+ F412 06 08            LD B, 8
 743+ F414 AF               XOR A
 744+ F415              .ccRow1:
 745+ F415 77               LD (HL), A
