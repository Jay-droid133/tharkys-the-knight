1210+ F582              ; ==============================================================================
1211+ F582              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1212+ F582              ; ==============================================================================
1213+ F582              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1214+ F582              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1215+ F582              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1216+ F582              ; ==============================================================================
1217+ F582              ChurchCutsceneInitStatueShake:
1218+ F582 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1219+ F585 21 61 67         LD HL, StatueIdTable
1220+ F588 5F               LD E, A
1221+ F589 16 00            LD D, 0
1222+ F58B 19               ADD HL, DE
1223+ F58C 7E               LD A, (HL)                              ; A = statue id
1224+ F58D B7               OR A
1225+ F58E C8               RET Z                                   ; sin estatua
1226+ F58F 32 BF F5         LD (.cisTargetId), A
1227+ F592                  ; Buscar en CurrentScreenBuffer
1228+ F592 2A 9C 82         LD HL, (CurrentScreenAddr)
1229+ F595              .cisLoop:
1230+ F595 7E               LD A, (HL)
1231+ F596 FE FF            CP $FF
1232+ F598 C8               RET Z                                   ; no encontrada (no se hace shake)
1233+ F599 47               LD B, A
1234+ F59A 3A BF F5         LD A, (.cisTargetId)
1235+ F59D B8               CP B
1236+ F59E 28 06            JR Z, .cisFound
1237+ F5A0 11 04 00         LD DE, 4
1238+ F5A3 19               ADD HL, DE
1239+ F5A4 18 EF            JR .cisLoop
1240+ F5A6              .cisFound:
1241+ F5A6 23               INC HL
1242+ F5A7 7E               LD A, (HL)                              ; charX
1243+ F5A8                  ; Pixel X = charX * 8
1244+ F5A8 87               ADD A, A
1245+ F5A9 87               ADD A, A
1246+ F5AA 87               ADD A, A
1247+ F5AB 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1248+ F5AE 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1249+ F5B1 23               INC HL
1250+ F5B2 7E               LD A, (HL)                              ; charY
1251+ F5B3                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1252+ F5B3 C6 02            ADD A, BG_Y_OFFSET
1253+ F5B5 87               ADD A, A
1254+ F5B6 87               ADD A, A
1255+ F5B7 87               ADD A, A
1256+ F5B8 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1257+ F5BB 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1258+ F5BE C9               RET
1259+ F5BF 00           .cisTargetId: DEFB 0
1260+ F5C0
1261+ F5C0              ; ==============================================================================
1262+ F5C0              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1263+ F5C0              ; ==============================================================================
1264+ F5C0              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1265+ F5C0              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1266+ F5C0              ; ==============================================================================
1267+ F5C0              ChurchCutsceneEraseStatueAtLast:
1268+ F5C0              ChurchCutsceneDrawStatueAtLast:
1269+ F5C0 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1270+ F5C3 21 61 67         LD HL, StatueIdTable
1271+ F5C6 5F               LD E, A
1272+ F5C7 16 00            LD D, 0
1273+ F5C9 19               ADD HL, DE
1274+ F5CA 7E               LD A, (HL)                              ; A = statue id
1275+ F5CB B7               OR A
1276+ F5CC C8               RET Z
1277+ F5CD                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1278+ F5CD 6F               LD L, A
1279+ F5CE 26 00            LD H, 0
1280+ F5D0 54               LD D, H
1281+ F5D1 5D               LD E, L
1282+ F5D2 29               ADD HL, HL
1283+ F5D3 19               ADD HL, DE                              ; HL = id*3
1284+ F5D4 11 97 E1         LD DE, BgGfxPtrById
1285+ F5D7 19               ADD HL, DE
1286+ F5D8 5E               LD E, (HL)
1287+ F5D9 23               INC HL
1288+ F5DA 56               LD D, (HL)                              ; DE = sprite ptr
1289+ F5DB 23               INC HL
1290+ F5DC 7E               LD A, (HL)                              ; A = bank
1291+ F5DD EB               EX DE, HL                               ; HL = sprite ptr
1292+ F5DE CD 74 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1293+ F5E1                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1294+ F5E1 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1295+ F5E4 57               LD D, A
1296+ F5E5 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1297+ F5E8 5F               LD E, A
1298+ F5E9 C3 E9 68         JP DrawBgSprite16XorAtPixel
1299+ F5EC
1300+ F5EC              ; ==============================================================================
1301+ F5EC              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1302+ F5EC              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1303+ F5EC              ;     A  = jitter signed (-1, 0, +1) en bits.
1304+ F5EC              ; ==============================================================================
1305+ F5EC              ; IN: A = jitter signed (-1, 0, +1) en bits.
1306+ F5EC              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1307+ F5EC              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1308+ F5EC              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1309+ F5EC              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1310+ F5EC              ; version shifted, sin XOR.
1311+ F5EC              ;
1312+ F5EC              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1313+ F5EC              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1314+ F5EC              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1315+ F5EC              ; estatua se perdio cuando la estatua se pinto la primera vez con
1316+ F5EC              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1317+ F5EC              ; de la estatua, el wall perdido no se ve.
1318+ F5EC              ;
1319+ F5EC              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1320+ F5EC              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1321+ F5EC              ; shift de 1 bit no pierde pixels visibles.
1322+ F5EC              ; Destruye: AF, BC, DE, HL, IX.
1323+ F5EC              ; ==============================================================================
1324+ F5EC              ChurchCutsceneShakeStatueByteShift:
1325+ F5EC 32 56 F6         LD (.csbsJitter), A
1326+ F5EF                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1327+ F5EF 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1328+ F5F2 5F               LD E, A
1329+ F5F3 16 00            LD D, 0
1330+ F5F5 19               ADD HL, DE
1331+ F5F6 7E               LD A, (HL)
1332+ F5F7 B7               OR A
1333+ F5F8 C8               RET Z                                   ; sin estatua
1334+ F5F9 6F               LD L, A
1335+ F5FA 26 00            LD H, 0
1336+ F5FC 54               LD D, H
1337+ F5FD 5D               LD E, L
1338+ F5FE 29               ADD HL, HL
1339+ F5FF 19               ADD HL, DE                              ; HL = id*3
1340+ F600 11 97 E1         LD DE, BgGfxPtrById
1341+ F603 19               ADD HL, DE
1342+ F604 5E               LD E, (HL)
1343+ F605 23               INC HL
1344+ F606 56               LD D, (HL)                              ; DE = sprite ptr
1345+ F607 23               INC HL
1346+ F608 7E               LD A, (HL)                              ; A = bank
1347+ F609 EB               EX DE, HL                               ; HL = sprite ptr
1348+ F60A CD 74 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1349+ F60D                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1350+ F60D DD 21 87 89      LD IX, BgSpriteBuffer
1351+ F611 DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1352+ F614 B7               OR A
1353+ F615 C8               RET Z
1354+ F616 47               LD B, A                                 ; B = row counter
1355+ F617 DD 23            INC IX
1356+ F619 DD 23            INC IX                                  ; IX -> pixel data
1357+ F61B                  ; Calcular addr VRAM en (origX, origY)
1358+ F61B 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1359+ F61E 57               LD D, A
1360+ F61F 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1361+ F622 5F               LD E, A
1362+ F623 CD 92 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
1363+ F626              .csbsRow:
1364+ F626 C5               PUSH BC
1365+ F627 E5               PUSH HL                                 ; save inicio fila VRAM
1366+ F628                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1367+ F628 DD 7E 00         LD A, (IX+0)
1368+ F62B 2F               CPL
1369+ F62C 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1370+ F62D DD 7E 01         LD A, (IX+1)
1371+ F630 2F               CPL
1372+ F631 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1373+ F632                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1374+ F632 3A 56 F6         LD A, (.csbsJitter)
1375+ F635 B7               OR A
1376+ F636 28 0D            JR Z, .csbsWrite                        ; sin shift
1377+ F638 FA 41 F6         JP M, .csbsLeft                         ; A < 0 -> shift left
1378+ F63B                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1379+ F63B CB 3A            SRL D
1380+ F63D CB 1B            RR E
1381+ F63F 18 04            JR .csbsWrite
1382+ F641              .csbsLeft:
1383+ F641 CB 23            SLA E
1384+ F643 CB 12            RL D
1385+ F645              .csbsWrite:
1386+ F645 7A               LD A, D
1387+ F646 77               LD (HL), A
1388+ F647 23               INC HL
1389+ F648 7B               LD A, E
1390+ F649 77               LD (HL), A
1391+ F64A E1               POP HL
1392+ F64B CD FE 9D         CALL NextPixelLine                      ; HL = siguiente pixel row
1393+ F64E DD 23            INC IX
1394+ F650 DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1395+ F652 C1               POP BC
1396+ F653 10 D1            DJNZ .csbsRow
1397+ F655 C9               RET
1398+ F656 00           .csbsJitter: DEFB 0
1399+ F657
1400+ F657              ; ==============================================================================
1401+ F657              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1402+ F657              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1403+ F657              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1404+ F657              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1405+ F657              ; Destruye: AF, BC, HL.
1406+ F657              ; ==============================================================================
1407+ F657              ChurchCutsceneEraseStatueDirect:
1408+ F657 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1409+ F65A 57               LD D, A
1410+ F65B 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1411+ F65E 5F               LD E, A
1412+ F65F CD 92 A0         CALL CalcPixelAddr
1413+ F662 06 18            LD B, 24                                ; statues son 24 px de alto
1414+ F664              .csedRow:
1415+ F664 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1416+ F665 77               LD (HL), A
1417+ F666 23               INC HL
1418+ F667 77               LD (HL), A
1419+ F668 2B               DEC HL                                  ; volver a inicio fila
1420+ F669 C5               PUSH BC
1421+ F66A CD FE 9D         CALL NextPixelLine
1422+ F66D C1               POP BC
1423+ F66E 10 F4            DJNZ .csedRow
1424+ F670 C9               RET
1425+ F671
1426+ F671              ; ==============================================================================
1427+ F671              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1428+ F671              ; ==============================================================================
1429+ F671              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1430+ F671              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1431+ F671              ; suficiente para corromper visualmente).
1432+ F671              ; IN: IX = entity ptr.
1433+ F671              ; ==============================================================================
1434+ F671              RedrawTrappedMonster:
1435+ F671                  ; --- Erase viejo en (OLDX, OLDY) ---
1436+ F671 CD 12 A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1437+ F674 DD 7E 0D         LD A, (IX+ENT_OLDY)
1438+ F677 57               LD D, A
1439+ F678 DD 7E 0C         LD A, (IX+ENT_OLDX)
1440+ F67B 5F               LD E, A
1441+ F67C DD E5            PUSH IX
1442+ F67E DD 2A 9A A7      LD IX, (OldSprAddr)
1443+ F682 CD 1F 9D         CALL DrawSprite
1444+ F685 DD E1            POP IX
1445+ F687                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1446+ F687                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1447+ F687 DD 56 0D         LD D, (IX+ENT_OLDY)
1448+ F68A DD 5E 0C         LD E, (IX+ENT_OLDX)
1449+ F68D CD 45 D5         CALL RestoreOldAttr
1450+ F690                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1451+ F690                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1452+ F690                  ; reponer attrs de pickups que el flujo de entidades pisa con
1453+ F690                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1454+ F690                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1455+ F690                  ; estar bajo el monster.
1456+ F690 DD E5            PUSH IX
1457+ F692 CD FC DB         CALL RefreshPickupAttrs
1458+ F695 DD E1            POP IX
1459+ F697                  ; --- Compute new draw pos ---
1460+ F697 CD 9C A7         CALL CalcDrawX
1461+ F69A CD 13 A2         CALL ComputeEnemyDrawY
1462+ F69D                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1463+ F69D CD E1 A7         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1464+ F6A0 3A 6F 82         LD A, (EnemyDrawY)
1465+ F6A3 57               LD D, A
1466+ F6A4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1467+ F6A7 5F               LD E, A
1468+ F6A8 DD E5            PUSH IX
1469+ F6AA DD 2A 10 A8      LD IX, (SpriteAddrTemp)
1470+ F6AE CD 3C 9E         CALL CalcEntityAttrSize
1471+ F6B1 DD E1            POP IX
1472+ F6B3 3A 6F 82         LD A, (EnemyDrawY)
1473+ F6B6 57               LD D, A
1474+ F6B7 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1475+ F6BA 5F               LD E, A
1476+ F6BB DD 7E 05         LD A, (IX+ENT_ATTR)
1477+ F6BE CD 0F 9E         CALL SetEntityAttr
1478+ F6C1                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1479+ F6C1 3A 6F 82         LD A, (EnemyDrawY)
1480+ F6C4 57               LD D, A
1481+ F6C5 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1482+ F6C8 5F               LD E, A
1483+ F6C9 DD E5            PUSH IX
1484+ F6CB DD 2A 10 A8      LD IX, (SpriteAddrTemp)
1485+ F6CF CD 1F 9D         CALL DrawSprite
1486+ F6D2 DD E1            POP IX
1487+ F6D4                  ; --- Save OLD = current ---
1488+ F6D4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1489+ F6D7 DD 77 0C         LD (IX+ENT_OLDX), A
1490+ F6DA 3A 6F 82         LD A, (EnemyDrawY)
1491+ F6DD DD 77 0D         LD (IX+ENT_OLDY), A
1492+ F6E0 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1493+ F6E3 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1494+ F6E6 C9               RET
