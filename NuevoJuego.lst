4313+ B6A3 0F               RRCA
4314+ B6A4 0F               RRCA
4315+ B6A5 0F               RRCA
4316+ B6A6 E6 1F            AND $1F
4317+ B6A8 D6 02            SUB BG_Y_OFFSET
4318+ B6AA 32 FB B6         LD (.ecYlo), A
4319+ B6AD 78               LD A, B
4320+ B6AE 81               ADD A, C
4321+ B6AF 3D               DEC A                           ; posY + H - 1
4322+ B6B0 0F               RRCA
4323+ B6B1 0F               RRCA
4324+ B6B2 0F               RRCA
4325+ B6B3 E6 1F            AND $1F
4326+ B6B5 D6 02            SUB BG_Y_OFFSET
4327+ B6B7 47               LD B, A                         ; B = charYhi
4328+ B6B8 3A FB B6         LD A, (.ecYlo)
4329+ B6BB ED 44            NEG
4330+ B6BD 80               ADD A, B
4331+ B6BE 3C               INC A                           ; height_chars
4332+ B6BF 32 FD B6         LD (.ecHc), A
4333+ B6C2                  ; --- HL = CollisionMap + charYlo*32 + charXlo ---
4334+ B6C2 3A FB B6         LD A, (.ecYlo)
