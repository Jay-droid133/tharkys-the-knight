 377  CF98                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ CF98              ; ==============================================================================
   2+ CF98              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ CF98              ; ==============================================================================
   4+ CF98              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ CF98              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ CF98              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ CF98              ; ==============================================================================
   8+ CF98
   9+ CF98              ; ==============================================================================
  10+ CF98              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ CF98              ; ==============================================================================
  12+ CF98              InitScreenSystem:
  13+ CF98 3E 05            LD A, START_SCREEN_X
  14+ CF9A 32 AE 82         LD (CurrentScreenX), A
  15+ CF9D 3E 04            LD A, START_SCREEN_Y
  16+ CF9F 32 AF 82         LD (CurrentScreenY), A
  17+ CFA2 3E 01            LD A, 1
  18+ CFA4 32 B6 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ CFA7 AF               XOR A
  20+ CFA8 32 B2 82         LD (ScreenTransition), A
  21+ CFAB CD AF CF         CALL CalcScreenAddress
  22+ CFAE C9               RET
  23+ CFAF
  24+ CFAF              ; ==============================================================================
  25+ CFAF              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ CFAF              ; ==============================================================================
  27+ CFAF              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ CFAF              ; ==============================================================================
  29+ CFAF              CalcScreenAddress:
  30+ CFAF 3A AF 82         LD A, (CurrentScreenY)
  31+ CFB2 6F               LD L, A
  32+ CFB3 26 00            LD H, 0
  33+ CFB5 29               ADD HL, HL                  ; x2
  34+ CFB6 29               ADD HL, HL                  ; x4
  35+ CFB7 29               ADD HL, HL                  ; x8
  36+ CFB8 29               ADD HL, HL                  ; x16
  37+ CFB9 3A AE 82         LD A, (CurrentScreenX)
  38+ CFBC 5F               LD E, A
  39+ CFBD 16 00            LD D, 0
  40+ CFBF 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ CFC0 11 76 E0         LD DE, MapTable
  42+ CFC3 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ CFC4 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ CFC5                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ CFC5 6F               LD L, A
  46+ CFC6 26 00            LD H, 0
  47+ CFC8 29               ADD HL, HL                  ; index * 2
  48+ CFC9 11 44 DF         LD DE, RoomTable
  49+ CFCC 19               ADD HL, DE
  50+ CFCD 5E               LD E, (HL)
  51+ CFCE 23               INC HL
  52+ CFCF 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ CFD0                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ CFD0 EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ CFD1 CD 45 6A         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ CFD4                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ CFD4 11 9B 85         LD DE, CurrentScreenBuffer
  58+ CFD7 ED 53 B0 82      LD (CurrentScreenAddr), DE
  59+ CFDB C9               RET
  60+ CFDC
  61+ CFDC              ; ==============================================================================
  62+ CFDC              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ CFDC              ; ==============================================================================
  64+ CFDC              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ CFDC              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ CFDC              ; por estar atrapado cerca del borde.
  67+ CFDC              ; ==============================================================================
  68+ CFDC              CheckScreenTransition:
  69+ CFDC AF               XOR A
  70+ CFDD 32 B2 82         LD (ScreenTransition), A
  71+ CFE0
  72+ CFE0                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ CFE0                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ CFE0                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ CFE0                  ; dispararia transicion sur en plena animacion.
  76+ CFE0 3A 75 82         LD A, (TownGatePhase)
  77+ CFE3 B7               OR A
  78+ CFE4 C0               RET NZ
  79+ CFE5
  80+ CFE5                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ CFE5                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ CFE5                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ CFE5                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ CFE5                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ CFE5                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ CFE5 3A 63 82         LD A, (TimeFrozen)
  87+ CFE8 B7               OR A
  88+ CFE9 28 23            JR Z, .cstNotFrozen
  89+ CFEB 3A 5B 82         LD A, (InputDirection)
  90+ CFEE CB 4F            BIT 1, A                    ; S
  91+ CFF0 28 17            JR Z, .cstClearBlockFlag
  92+ CFF2 3A 4F 81         LD A, (EntityTable + ENT_POSY)
  93+ CFF5 FE A8            CP SCREEN_MAX_Y
  94+ CFF7 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ CFF9                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ CFF9 3A 64 82         LD A, (BlockedExitSoundFlag)
  97+ CFFC B7               OR A
  98+ CFFD C0               RET NZ                      ; ya sonó, esperar release o move
  99+ CFFE 3E 01            LD A, 1
 100+ D000 32 64 82         LD (BlockedExitSoundFlag), A
 101+ D003 21 73 FA         LD HL, SFX_BlockedExit
 102+ D006 C3 4F F9         JP PlaySFX                  ; tail call
 103+ D009              .cstClearBlockFlag:
 104+ D009 AF               XOR A
 105+ D00A 32 64 82         LD (BlockedExitSoundFlag), A
 106+ D00D C9               RET
 107+ D00E              .cstNotFrozen:
 108+ D00E                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ D00E AF               XOR A
 110+ D00F 32 64 82         LD (BlockedExitSoundFlag), A
