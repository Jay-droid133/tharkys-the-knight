 377+ ED96
 378+ ED96              ; ==============================================================================
 379+ ED96              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ ED96              ; ==============================================================================
 381+ ED96              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ ED96              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ ED96              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ ED96              ; ==============================================================================
 385+ ED96              DrawHealthStaminaHUD:
 386+ ED96                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ ED96 3A 89 B3         LD A, (PlayerHealth)
 388+ ED99 4F               LD C, A                             ; C = nivel (0-16)
 389+ ED9A 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ ED9D 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EDA0 DD 21 7C E9      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EDA4 FD 21 ED E9      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EDA8 CD 0E EE         CALL .drawBar
 394+ EDAB
 395+ EDAB                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EDAB 3A 8A B3         LD A, (PlayerStamina)
 397+ EDAE 4F               LD C, A
 398+ EDAF 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EDB2 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EDB5 DD 21 80 E9      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EDB9 FD 21 F1 E9      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EDBD CD 0E EE         CALL .drawBar
 403+ EDC0
 404+ EDC0                  ; --- Flash de recuperacion del pozo ---
 405+ EDC0 3A 62 8D         LD A, (WellFlashTimer)
 406+ EDC3 B7               OR A
 407+ EDC4 28 23            JR Z, .noFlash
 408+ EDC6 3D               DEC A
 409+ EDC7 32 62 8D         LD (WellFlashTimer), A
 410+ EDCA                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EDCA E6 04            AND $04
 412+ EDCC 28 1B            JR Z, .noFlash
 413+ EDCE                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ EDCE                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ EDCE 3E 47            LD A, WHITE | $40
 416+ EDD0 32 0D 58         LD ($580D), A
 417+ EDD3 32 0E 58         LD ($580E), A
 418+ EDD6 32 2D 58         LD ($582D), A
 419+ EDD9 32 2E 58         LD ($582E), A
 420+ EDDC 32 11 58         LD ($5811), A
 421+ EDDF 32 12 58         LD ($5812), A
 422+ EDE2 32 31 58         LD ($5831), A
 423+ EDE5 32 32 58         LD ($5832), A
 424+ EDE8 C9               RET
 425+ EDE9              .noFlash:
 426+ EDE9                  ; --- Attrs segun nivel (normal) ---
 427+ EDE9                  ; Salud
 428+ EDE9 3A 89 B3         LD A, (PlayerHealth)
 429+ EDEC CD 5C EE         CALL .levelToColor
 430+ EDEF 32 0D 58         LD ($580D), A
 431+ EDF2 32 0E 58         LD ($580E), A
 432+ EDF5 32 2D 58         LD ($582D), A
 433+ EDF8 32 2E 58         LD ($582E), A
 434+ EDFB                  ; Stamina
 435+ EDFB 3A 8A B3         LD A, (PlayerStamina)
 436+ EDFE CD 5C EE         CALL .levelToColor
 437+ EE01 32 11 58         LD ($5811), A
 438+ EE04 32 12 58         LD ($5812), A
 439+ EE07 32 31 58         LD ($5831), A
 440+ EE0A 32 32 58         LD ($5832), A
 441+ EE0D C9               RET
 442+ EE0E
 443+ EE0E              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EE0E              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EE0E              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EE0E              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EE0E              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EE0E              .drawBar:
 449+ EE0E 7D               LD A, L
 450+ EE0F 32 5A EE         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EE12 7B               LD A, E
 452+ EE13 32 5B EE         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EE16 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EE18 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EE1A                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EE1A 3E 10            LD A, 16
 457+ EE1C 91               SUB C
 458+ EE1D 5F               LD E, A                             ; E = primera scanline llena
 459+ EE1E              .dbLoop:
 460+ EE1E                  ; Calcular direccion VRAM
 461+ EE1E 7A               LD A, D
 462+ EE1F FE 08            CP 8
 463+ EE21 30 09            JR NC, .dbCalcR1
 464+ EE23                  ; Char row 0
 465+ EE23 67               LD H, A
 466+ EE24 CB F4            SET 6, H
 467+ EE26 3A 5A EE         LD A, (.dbCol)
 468+ EE29 6F               LD L, A
 469+ EE2A 18 09            JR .dbWrite
 470+ EE2C              .dbCalcR1:
 471+ EE2C                  ; Char row 1
 472+ EE2C D6 08            SUB 8
 473+ EE2E 67               LD H, A
 474+ EE2F CB F4            SET 6, H
 475+ EE31 3A 5B EE         LD A, (.dbCol1)
 476+ EE34 6F               LD L, A
 477+ EE35              .dbWrite:
 478+ EE35                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EE35 7A               LD A, D
 480+ EE36 BB               CP E
 481+ EE37 30 0B            JR NC, .dbFull
 482+ EE39                  ; Marchito: copiar sprite decayed
 483+ EE39 FD 7E 00         LD A, (IY+0)
 484+ EE3C 77               LD (HL), A
 485+ EE3D 23               INC HL
 486+ EE3E FD 7E 01         LD A, (IY+1)
 487+ EE41 77               LD (HL), A
 488+ EE42 18 09            JR .dbAdvanceSpr
 489+ EE44              .dbFull:
 490+ EE44                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EE44 DD 7E 00         LD A, (IX+0)
 492+ EE47 77               LD (HL), A
 493+ EE48 23               INC HL
 494+ EE49 DD 7E 01         LD A, (IX+1)
 495+ EE4C 77               LD (HL), A
 496+ EE4D              .dbAdvanceSpr:
 497+ EE4D                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 498+ EE4D D5               PUSH DE
 499+ EE4E 11 06 00         LD DE, 6
 500+ EE51 DD 19            ADD IX, DE
 501+ EE53 FD 19            ADD IY, DE
 502+ EE55 D1               POP DE
 503+ EE56 14               INC D
 504+ EE57 10 C5            DJNZ .dbLoop
 505+ EE59 C9               RET
 506+ EE5A
 507+ EE5A 00           .dbCol:  DEFB 0
 508+ EE5B 00           .dbCol1: DEFB 0
 509+ EE5C
 510+ EE5C              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 511+ EE5C              .levelToColor:
 512+ EE5C FE 0C            CP 12
 513+ EE5E 30 11            JR NC, .lcGreen
 514+ EE60 FE 07            CP 7
 515+ EE62 30 0A            JR NC, .lcCyan
 516+ EE64 FE 03            CP 3
 517+ EE66 30 03            JR NC, .lcYellow
 518+ EE68 3E 42            LD A, RED | $40                     ; 0-2: rojo
 519+ EE6A C9               RET
 520+ EE6B              .lcYellow:
 521+ EE6B 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 522+ EE6D C9               RET
 523+ EE6E              .lcCyan:
 524+ EE6E 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 525+ EE70 C9               RET
 526+ EE71              .lcGreen:
 527+ EE71 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 528+ EE73 C9               RET
 529+ EE74
 530+ EE74              ; ==============================================================================
 531+ EE74              ; DrawHandLine - Borra pixels de la aguja (AND ~mask = marca negra)
 532+ EE74              ; ==============================================================================
 533+ EE74              ; Entrada: A = posición (0-11), HL = tabla de punteros
 534+ EE74              ; ==============================================================================
 535+ EE74              DrawHandLine:
 536+ EE74 87               ADD A, A
 537+ EE75 4F               LD C, A
 538+ EE76 06 00            LD B, 0
 539+ EE78 09               ADD HL, BC
 540+ EE79 7E               LD A, (HL)
 541+ EE7A 23               INC HL
 542+ EE7B 66               LD H, (HL)
 543+ EE7C 6F               LD L, A             ; HL = puntero a datos de línea
 544+ EE7D
 545+ EE7D              .pixLoop:
 546+ EE7D 7E               LD A, (HL)          ; VRAM H ($00 = fin)
 547+ EE7E B7               OR A
 548+ EE7F C8               RET Z
 549+ EE80 57               LD D, A
 550+ EE81 23               INC HL
 551+ EE82 7E               LD A, (HL)          ; VRAM L
 552+ EE83 23               INC HL
 553+ EE84 5F               LD E, A
 554+ EE85 7E               LD A, (HL)          ; mask
 555+ EE86 23               INC HL
 556+ EE87 E5               PUSH HL
 557+ EE88 2F               CPL                 ; ~mask
 558+ EE89 62               LD H, D
 559+ EE8A 6B               LD L, E
 560+ EE8B A6               AND (HL)            ; borrar bit: (HL) AND ~mask
 561+ EE8C 77               LD (HL), A
 562+ EE8D E1               POP HL
 563+ EE8E 18 ED            JR .pixLoop
 564+ EE90
 565+ EE90              ; ==============================================================================
 566+ EE90              ; CheckClockSpeedKeys - Teclas 1/2/3 (debug)
 567+ EE90              ; ==============================================================================
 568+ EE90              CheckClockSpeedKeys:
 569+ EE90 3E F7            LD A, $F7
 570+ EE92 DB FE            IN A, ($FE)
 571+ EE94 2F               CPL
 572+ EE95 E6 07            AND $07
 573+ EE97
 574+ EE97 47               LD B, A
 575+ EE98 3A 60 EA         LD A, (ClockDebounce)
 576+ EE9B 4F               LD C, A
 577+ EE9C 78               LD A, B
 578+ EE9D 32 60 EA         LD (ClockDebounce), A
 579+ EEA0 78               LD A, B
 580+ EEA1
 581+ EEA1 79               LD A, C
 582+ EEA2 2F               CPL
 583+ EEA3 A0               AND B
 584+ EEA4 C8               RET Z
 585+ EEA5
 586+ EEA5 CB 47            BIT 0, A
 587+ EEA7 28 06            JR Z, .try2
 588+ EEA9 3E 01            LD A, 1
 589+ EEAB 32 5F EA         LD (SubMinuteMax), A
 590+ EEAE C9               RET
 591+ EEAF              .try2:
 592+ EEAF CB 4F            BIT 1, A
 593+ EEB1 28 06            JR Z, .try3
 594+ EEB3 3E 05            LD A, 5
 595+ EEB5 32 5F EA         LD (SubMinuteMax), A
 596+ EEB8 C9               RET
 597+ EEB9              .try3:
 598+ EEB9 3E 15            LD A, 21
 599+ EEBB 32 5F EA         LD (SubMinuteMax), A
 600+ EEBE C9               RET
 601+ EEBF
 602+ EEBF              ; ==============================================================================
 603+ EEBF              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ EEBF              ; ==============================================================================
 605+ EEBF
 606+ EEBF              ; ==============================================================================
 607+ EEBF              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ EEBF              ; ==============================================================================
 609+ EEBF              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ EEBF              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ EEBF              ; ==============================================================================
 612+ EEBF              BuildPlazaScanAddrs:
 613+ EEBF                  ; Calcular pixel coords del top-left de la esfera
 614+ EEBF 3A 69 8D         LD A, (PlazaClockCharY)
 615+ EEC2 07               RLCA
 616+ EEC3 07               RLCA
 617+ EEC4 07               RLCA
 618+ EEC5 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EEC6 3A 68 8D         LD A, (PlazaClockCharX)
 620+ EEC9 07               RLCA
 621+ EECA 07               RLCA
 622+ EECB 07               RLCA
 623+ EECC 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EECD CD 62 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EED0
 626+ EED0 DD 21 6A 8D      LD IX, PlazaScanAddrs
 627+ EED4 06 10            LD B, 16
 628+ EED6              .buildLoop:
 629+ EED6 DD 75 00         LD (IX+0), L
 630+ EED9 DD 74 01         LD (IX+1), H
 631+ EEDC DD 23            INC IX
 632+ EEDE DD 23            INC IX
 633+ EEE0 05               DEC B
 634+ EEE1 C8               RET Z
 635+ EEE2 CD CE 9A         CALL NextPixelLine
 636+ EEE5 18 EF            JR .buildLoop
 637+ EEE7
 638+ EEE7              ; ==============================================================================
 639+ EEE7              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EEE7              ; ==============================================================================
 641+ EEE7              ; Llamar cada frame desde el main loop.
 642+ EEE7              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EEE7              ; ==============================================================================
 644+ EEE7              DrawPlazaClock:
 645+ EEE7 3A 67 8D         LD A, (PlazaClockActive)
 646+ EEEA B7               OR A
 647+ EEEB C8               RET Z
 648+ EEEC
 649+ EEEC                  ; --- Calcular posicion actual de las agujas ---
 650+ EEEC 3A 5E EA         LD A, (GameHours)
 651+ EEEF FE 0C            CP 12
 652+ EEF1 38 02            JR C, .pCalcHourOk
 653+ EEF3 D6 0C            SUB 12
 654+ EEF5              .pCalcHourOk:
 655+ EEF5 57               LD D, A                     ; D = display hour (0-11)
 656+ EEF6 3A 5D EA         LD A, (GameMinutes)
 657+ EEF9 1E 00            LD E, 0
 658+ EEFB              .pCalcDiv5:
 659+ EEFB FE 05            CP 5
 660+ EEFD 38 05            JR C, .pCalcMinOk
 661+ EEFF D6 05            SUB 5
 662+ EF01 1C               INC E
 663+ EF02 18 F7            JR .pCalcDiv5
 664+ EF04              .pCalcMinOk:
 665+ EF04                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EF04
 667+ EF04                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EF04 3A 58 EF         LD A, (PlazaLastHour)
 669+ EF07 BA               CP D
 670+ EF08 20 05            JR NZ, .pNeedsRedraw
 671+ EF0A 3A 59 EF         LD A, (PlazaLastMin)
 672+ EF0D BB               CP E
 673+ EF0E C8               RET Z                       ; sin cambio → no redibujar
 674+ EF0F
 675+ EF0F              .pNeedsRedraw:
 676+ EF0F 7A               LD A, D
 677+ EF10 32 58 EF         LD (PlazaLastHour), A
 678+ EF13 7B               LD A, E
 679+ EF14 32 59 EF         LD (PlazaLastMin), A
 680+ EF17
 681+ EF17                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EF17                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EF17 DD 21 3D 8A      LD IX, PlazaClockPixels
 684+ EF1B FD 21 6A 8D      LD IY, PlazaScanAddrs
 685+ EF1F 06 10            LD B, 16
 686+ EF21              .faceRow:
 687+ EF21 FD 6E 00         LD L, (IY+0)
 688+ EF24 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EF27 DD 7E 00         LD A, (IX+0)
 690+ EF2A 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EF2B 77               LD (HL), A                  ; byte izquierdo
 692+ EF2C 23               INC HL
 693+ EF2D DD 7E 01         LD A, (IX+1)
 694+ EF30 2F               CPL
 695+ EF31 77               LD (HL), A                  ; byte derecho
 696+ EF32 DD 23            INC IX
 697+ EF34 DD 23            INC IX
 698+ EF36 FD 23            INC IY
 699+ EF38 FD 23            INC IY
 700+ EF3A 10 E5            DJNZ .faceRow
 701+ EF3C
 702+ EF3C                  ; --- Aguja de horas ---
 703+ EF3C 3A 58 EF         LD A, (PlazaLastHour)
 704+ EF3F 21 5A EB         LD HL, HourHandPtrs
 705+ EF42 CD 5A EF         CALL DrawPlazaHandLine
 706+ EF45
 707+ EF45                  ; --- Aguja de minutos ---
 708+ EF45 3A 59 EF         LD A, (PlazaLastMin)
 709+ EF48 21 76 EA         LD HL, MinHandPtrs
 710+ EF4B CD 5A EF         CALL DrawPlazaHandLine
 711+ EF4E
 712+ EF4E                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EF4E 21 78 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EF51 7E               LD A, (HL)
 715+ EF52 23               INC HL
 716+ EF53 66               LD H, (HL)
 717+ EF54 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EF55 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EF57 C9               RET
 720+ EF58
 721+ EF58              ; Variables locales reloj plaza
 722+ EF58 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EF59 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EF5A
 725+ EF5A              ; ==============================================================================
 726+ EF5A              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EF5A              ; ==============================================================================
 728+ EF5A              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EF5A              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EF5A              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EF5A              ; ==============================================================================
 732+ EF5A              DrawPlazaHandLine:
 733+ EF5A                  ; Indexar en tabla de punteros
 734+ EF5A 87               ADD A, A
 735+ EF5B 4F               LD C, A
 736+ EF5C 06 00            LD B, 0
 737+ EF5E 09               ADD HL, BC
 738+ EF5F 7E               LD A, (HL)
 739+ EF60 23               INC HL
 740+ EF61 66               LD H, (HL)
 741+ EF62 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EF63
 743+ EF63              .pxLoop:
 744+ EF63 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EF64 B7               OR A
 746+ EF65 C8               RET Z
 747+ EF66
 748+ EF66                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EF66 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EF67 23               INC HL
 751+ EF68 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EF69 23               INC HL
 753+ EF6A 56               LD D, (HL)                  ; D = mask
 754+ EF6B 23               INC HL
 755+ EF6C E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EF6D
 757+ EF6D                  ; --- Calcular scanLine (0-15) ---
 758+ EF6D 78               LD A, B
 759+ EF6E E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EF70 CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EF72 28 02            JR Z, .pxIsTop
 762+ EF74 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EF76              .pxIsTop:
 764+ EF76                  ; A = scanLine (0-15)
 765+ EF76
 766+ EF76                  ; --- Calcular colOffset (0 o 1) ---
 767+ EF76 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EF77 79               LD A, C
 769+ EF78 E6 1F            AND $1F                     ; extraer columna
 770+ EF7A D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EF7C 4F               LD C, A                     ; C = colOffset
 772+ EF7D
 773+ EF7D                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EF7D 7B               LD A, E                     ; A = scanLine
 775+ EF7E 87               ADD A, A                    ; *2 (word index)
 776+ EF7F 21 6A 8D         LD HL, PlazaScanAddrs
 777+ EF82 85               ADD A, L
 778+ EF83 6F               LD L, A
 779+ EF84 30 01            JR NC, .pxNC
 780+ EF86 24               INC H
 781+ EF87              .pxNC:
 782+ EF87 7E               LD A, (HL)
 783+ EF88 23               INC HL
 784+ EF89 66               LD H, (HL)
 785+ EF8A 81               ADD A, C                    ; sumar colOffset
 786+ EF8B 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EF8C
 788+ EF8C                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EF8C 7A               LD A, D
 790+ EF8D 2F               CPL
 791+ EF8E A6               AND (HL)
 792+ EF8F 77               LD (HL), A
 793+ EF90
 794+ EF90 E1               POP HL                      ; restaurar puntero datos
 795+ EF91 18 D0            JR .pxLoop
 796+ EF93
