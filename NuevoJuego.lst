2219+ D814 04               DEFB 4                          ; key requerida = ClockTowerKey
2220+ D815 01               DEFB 1                          ; action = TownHall (ChurchKeySpawned=1)
2221+ D816 00 00            DEFW 0                          ; fin
2222+ D818 00 00            DEFB 0, 0
