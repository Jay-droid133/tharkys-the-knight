 650+ E83E              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 651+ E83E              ; ==============================================================================
 652+ E83E              DrawZoneCountHUD:
 653+ E83E 3A 00 5D         LD A, (ZoneCellCount)
 654+ E841                  ; Hi nibble
 655+ E841 47               LD B, A
 656+ E842 CB 3F            SRL A
 657+ E844 CB 3F            SRL A
 658+ E846 CB 3F            SRL A
 659+ E848 CB 3F            SRL A
 660+ E84A FE 0A            CP 10
 661+ E84C 38 04            JR C, .dzcHiDigit
 662+ E84E C6 37            ADD A, 'A' - 10
 663+ E850 18 02            JR .dzcHiOut
 664+ E852              .dzcHiDigit:
 665+ E852 C6 30            ADD A, '0'
 666+ E854              .dzcHiOut:
 667+ E854 1E 0B            LD E, 11
 668+ E856 CD 8E E8         CALL DrawHudCharRow0
 669+ E859                  ; Lo nibble
 670+ E859 78               LD A, B
 671+ E85A E6 0F            AND $0F
 672+ E85C FE 0A            CP 10
 673+ E85E 38 04            JR C, .dzcLoDigit
 674+ E860 C6 37            ADD A, 'A' - 10
 675+ E862 18 02            JR .dzcLoOut
 676+ E864              .dzcLoDigit:
 677+ E864 C6 30            ADD A, '0'
 678+ E866              .dzcLoOut:
 679+ E866 1E 0C            LD E, 12
 680+ E868 CD 8E E8         CALL DrawHudCharRow0
 681+ E86B 3E 47            LD A, $47
 682+ E86D 32 0B 58         LD (ATTR_BASE + 11), A
 683+ E870 32 0C 58         LD (ATTR_BASE + 12), A
 684+ E873 C9               RET
