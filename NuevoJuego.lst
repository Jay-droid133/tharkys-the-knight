 615+ F387 47               LD B, A
 616+ F388 3A CE F3         LD A, (.dcDistance)
 617+ F38B B8               CP B
 618+ F38C 28 0A            JR Z, .dcWhite                      ; igual = blanco
 619+ F38E 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 620+ F390 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 621+ F392 18 06            JR .dcColorDone
 622+ F394              .dcGreen:
 623+ F394 3E 44            LD A, GREEN | $40
 624+ F396 18 02            JR .dcColorDone
 625+ F398              .dcWhite:
 626+ F398 3E 47            LD A, WHITE | $40
 627+ F39A              .dcColorDone:
 628+ F39A 32 CF F3         LD (.dcAttr), A
 629+ F39D
 630+ F39D                  ; --- Sprite ptr de CompassSprites[idx] ---
 631+ F39D 3A CD F3         LD A, (.dcSpriteIdx)
 632+ F3A0 87               ADD A, A                            ; *2
 633+ F3A1 6F               LD L, A
 634+ F3A2 26 00            LD H, 0
 635+ F3A4 11 F0 F7         LD DE, CompassSprites
 636+ F3A7 19               ADD HL, DE
 637+ F3A8 5E               LD E, (HL)
 638+ F3A9 23               INC HL
