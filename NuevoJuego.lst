 729+ E581              ; DrawTimeIndicator - Muestra momento del dia en HUD (fila 1, col 30-31)
 730+ E581              ; ==============================================================================
 731+ E581              DrawTimeIndicator:
 732+ E581                  ; Calcular puntero al label de 2 chars
 733+ E581 3A 26 E2         LD A, (CurrentTimeOfDay)
 734+ E584 87               ADD A, A                    ; A = momento * 2
 735+ E585 5F               LD E, A
 736+ E586 16 00            LD D, 0
 737+ E588 21 88 E6         LD HL, TimeLabels
 738+ E58B 19               ADD HL, DE                  ; HL = &TimeLabels[momento*2]
 739+ E58C
 740+ E58C                  ; Primer caracter en columna 30
 741+ E58C 7E               LD A, (HL)
 742+ E58D E5               PUSH HL
 743+ E58E 1E 1E            LD E, 30
 744+ E590 CD A4 E5         CALL DrawHudChar
 745+ E593 E1               POP HL
 746+ E594
 747+ E594                  ; Segundo caracter en columna 31
 748+ E594 23               INC HL
 749+ E595 7E               LD A, (HL)
 750+ E596 1E 1F            LD E, 31
 751+ E598 CD A4 E5         CALL DrawHudChar
 752+ E59B
 753+ E59B                  ; Atributos del indicador (bright white on black)
 754+ E59B 21 3E 58         LD HL, ATTR_BASE + 1 * 32 + 30
 755+ E59E 3E 47            LD A, $47                   ; bright, paper=black, ink=white
 756+ E5A0 77               LD (HL), A
 757+ E5A1 23               INC HL
 758+ E5A2 77               LD (HL), A
 759+ E5A3 C9               RET
 760+ E5A4
 761+ E5A4              ; Dibuja un caracter de la ROM font en fila 1 del HUD
 762+ E5A4              ; A = codigo ASCII, E = columna (0-31)
 763+ E5A4              DrawHudChar:
 764+ E5A4                  ; Calcular puntero a font data: $3C00 + ASCII * 8
 765+ E5A4 6F               LD L, A
 766+ E5A5 26 00            LD H, 0
 767+ E5A7 29               ADD HL, HL
 768+ E5A8 29               ADD HL, HL
 769+ E5A9 29               ADD HL, HL
 770+ E5AA 01 00 3C         LD BC, $3C00
 771+ E5AD 09               ADD HL, BC                  ; HL = font data
 772+ E5AE
 773+ E5AE                  ; Calcular dir VRAM para fila 1: $40xx + $20 + columna
 774+ E5AE 16 40            LD D, $40                   ; Tercio 0, scan line 0
 775+ E5B0 3E 20            LD A, $20                   ; Fila 1 dentro del tercio (1*32=$20)
 776+ E5B2 83               ADD A, E
 777+ E5B3 5F               LD E, A                     ; DE = dir VRAM
 778+ E5B4
 779+ E5B4 06 08            LD B, 8
 780+ E5B6              .hudCharLoop:
 781+ E5B6 7E               LD A, (HL)
 782+ E5B7 12               LD (DE), A
 783+ E5B8 23               INC HL
 784+ E5B9 14               INC D                       ; Siguiente scan line
 785+ E5BA 10 FA            DJNZ .hudCharLoop
 786+ E5BC C9               RET
