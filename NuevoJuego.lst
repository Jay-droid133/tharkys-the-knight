 163+ 993D 01 FD FF         LD BC, $FFFD
 164+ 9940 ED 79            OUT (C), A
 165+ 9942 01 FD BF         LD BC, $BFFD
 166+ 9945 ED 59            OUT (C), E
 167+ 9947 FB               EI
 168+ 9948 C9               RET
 169+ 9949
 170+ 9949              ; --- AY_PlayToneBlocking: tono limpio en canal A, bloqueante ---
 171+ 9949              ; HL = period (12-bit), B = duracion (10ms units).
 172+ 9949              ; Self-contained en bank 2 (slot 2 fijo): no necesita page switch porque
 173+ 9949              ; los I/O ports de la AY ($FFFD/$BFFD) son bank-agnostic. Asi evitamos
 174+ 9949              ; el bug del stack viviendo en slot 3 (las PUSH/POP perderian el dato si
 175+ 9949              ; cambiaramos de bank en slot 3 entre el push y el pop).
 176+ 9949              AY_PlayToneBlocking:
 177+ 9949 F3               DI
 178+ 994A                  ; --- Escribir registros AY directamente (sin pasar por AY_WriteReg en bank 4) ---
 179+ 994A                  ; R1 = period high (lo escribimos primero para no tener que stashear H)
 180+ 994A 5C               LD E, H                     ; E = period high
 181+ 994B 3E 01            LD A, 1
 182+ 994D 01 FD FF         LD BC, $FFFD
 183+ 9950 ED 79            OUT (C), A
 184+ 9952 01 FD BF         LD BC, $BFFD
 185+ 9955 ED 59            OUT (C), E
 186+ 9957                  ; R0 = period low
 187+ 9957 5D               LD E, L                     ; E = period low
 188+ 9958 3E 00            LD A, 0
 189+ 995A 01 FD FF         LD BC, $FFFD
 190+ 995D ED 79            OUT (C), A
 191+ 995F 01 FD BF         LD BC, $BFFD
 192+ 9962 ED 59            OUT (C), E
 193+ 9964                  ; R9 = 0 (silenciar canal B por si campana dejo residuo)
 194+ 9964 3E 09            LD A, 9
 195+ 9966 01 FD FF         LD BC, $FFFD
 196+ 9969 ED 79            OUT (C), A
 197+ 996B 01 FD BF         LD BC, $BFFD
 198+ 996E AF               XOR A
 199+ 996F ED 79            OUT (C), A
 200+ 9971                  ; R10 = 0 (silenciar canal C)
 201+ 9971 3E 0A            LD A, 10
 202+ 9973 01 FD FF         LD BC, $FFFD
 203+ 9976 ED 79            OUT (C), A
 204+ 9978 01 FD BF         LD BC, $BFFD
 205+ 997B AF               XOR A
 206+ 997C ED 79            OUT (C), A
 207+ 997E                  ; R7 = $3E (mixer: solo tono A activo)
 208+ 997E 3E 07            LD A, 7
 209+ 9980 01 FD FF         LD BC, $FFFD
 210+ 9983 ED 79            OUT (C), A
 211+ 9985 01 FD BF         LD BC, $BFFD
 212+ 9988 3E 3E            LD A, $3E
 213+ 998A ED 79            OUT (C), A
 214+ 998C                  ; R8 = 13 (volumen A alto)
 215+ 998C 3E 08            LD A, 8
 216+ 998E 01 FD FF         LD BC, $FFFD
 217+ 9991 ED 79            OUT (C), A
 218+ 9993 01 FD BF         LD BC, $BFFD
 219+ 9996 3E 0D            LD A, 13
 220+ 9998 ED 79            OUT (C), A
 221+ 999A                  ; --- Busy loop B × ~12.4ms ---
 222+ 999A              .aypbOuter:
 223+ 999A 21 80 06         LD HL, $0680                ; ~1664 inner iters
 224+ 999D              .aypbInner:
 225+ 999D 2B               DEC HL
 226+ 999E 7C               LD A, H
 227+ 999F B5               OR L
 228+ 99A0 20 FB            JR NZ, .aypbInner
 229+ 99A2 10 F6            DJNZ .aypbOuter
 230+ 99A4                  ; --- Silenciar canal A (volumen 0) ---
 231+ 99A4 3E 08            LD A, 8
 232+ 99A6 01 FD FF         LD BC, $FFFD
 233+ 99A9 ED 79            OUT (C), A
 234+ 99AB 01 FD BF         LD BC, $BFFD
 235+ 99AE AF               XOR A
 236+ 99AF ED 79            OUT (C), A
 237+ 99B1 FB               EI
 238+ 99B2 C9               RET
 239+ 99B3
 240+ 99B3              ; --- StartMusic: dispatcher generico. A = track_id (0..3) ---
 241+ 99B3              ; Un solo thunk para todas las pistas: anadir tracks futuros = 0 bytes en bank 2.
 242+ 99B3              ; Track ids: 0=Tension, 1=Sunrise, 2=EndGame, 3=GameOver. Ids desconocidos = no-op.
 243+ 99B3              ;
 244+ 99B3              ; OJO: el track_id NO puede pasarse por registro a traves del page switch (el
 245+ 99B3              ; Impl en bank 4 no lo veria con seguridad si A se clobbea). Tampoco por PUSH/POP
 246+ 99B3              ; (stack vive en slot 3, el page switch corrompe el dato — ver
 247+ 99B3              ; project_ay_thunk_stack_bug.md). Lo pasamos via byte estatico en bank 2.
 248+ 99B3              StartMusic:
 249+ 99B3 32 D8 99         LD (MusicTrackArg), A
 250+ 99B6 F3               DI
 251+ 99B7 3A 7B 8D         LD A, (CurrentPaging)
 252+ 99BA E6 F8            AND $F8
 253+ 99BC F6 04            OR 4
 254+ 99BE 32 7B 8D         LD (CurrentPaging), A
 255+ 99C1 01 FD 7F         LD BC, $7FFD
 256+ 99C4 ED 79            OUT (C), A
 257+ 99C6 CD 43 E8         CALL StartMusicImpl
 258+ 99C9 3A 7B 8D         LD A, (CurrentPaging)
 259+ 99CC E6 F8            AND $F8
 260+ 99CE 32 7B 8D         LD (CurrentPaging), A
 261+ 99D1 01 FD 7F         LD BC, $7FFD
 262+ 99D4 ED 79            OUT (C), A
 263+ 99D6 FB               EI
 264+ 99D7 C9               RET
 265+ 99D8
 266+ 99D8              ; Stash del arg para el dispatcher. Vive en bank 2 (slot 2 fijo), accesible
 267+ 99D8              ; desde el Impl en bank 4 sin trampa de paging.
 268+ 99D8 00           MusicTrackArg: DEFB 0
 269+ 99D9
 270+ 99D9              ; Multiplicador de tempo del driver: 0=normal, 1=doble (SRL una vez la
 271+ 99D9              ; duracion de cada nota), 2=cuadruple. Aplicado en MusicAdvanceNote al
 272+ 99D9              ; cargar duration. StartMusicImpl lo resetea a 0 en cada arranque; el
 273+ 99D9              ; juego lo modifica para acelerar (p.ej. DeathGhostMode -> 1).
 274+ 99D9              ; Vive en bank 2 (always-visible) para que driver (bank 4) y juego
 275+ 99D9              ; (bank 0/2) puedan leer/escribir sin paging.
 276+ 99D9 00           MusicSpeedShift: DEFB 0
 277+ 99DA
 278+ 99DA              ; --- Catchup contra wall-clock (evita estiramiento de notas/decay tras
 279+ 99DA              ; transiciones de pantalla u otros frames lentos) ---
 280+ 99DA              ; MainLoop calcula al inicio de cada iteracion cuantos game frames (25fps =
 281+ 99DA              ; 2 ticks de IRQ a 50Hz) han pasado desde el iter anterior, y lo deja en
 282+ 99DA              ; FramesElapsed. UpdateMusic y AY_UpdateBell hacen N iteraciones segun ese
 283+ 99DA              ; valor (= "catchup completo": ritmo preservado en wall-clock).
 284+ 99DA              ; TickRemainder acumula la mitad-frame impar (1 tick) entre iteraciones para
 285+ 99DA              ; no perderla — sin esto un iter de 3 ticks daria 1 frame y un iter de 1
 286+ 99DA              ; tick daria 0, drift acumulando.
 287+ 99DA 00           FramesElapsed:  DEFB 0          ; Frames de juego a avanzar este iter (0..N)
 288+ 99DB 00           TickRemainder:  DEFB 0          ; Ticks de IRQ pendientes (0 o 1, mod 2)
 289+ 99DC
