5656+ BF15 DD E5            PUSH IX
5657+ BF17 E1               POP HL
5658+ BF18 11 C0 80         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5659+ BF1B B7               OR A
5660+ BF1C ED 52            SBC HL, DE                          ; HL = offset desde MONSTER0
5661+ BF1E                  ; HL / ENT_SIZE = indice monster (0, 1, 2)
5662+ BF1E 7D               LD A, L
5663+ BF1F 0F               RRCA
5664+ BF20 0F               RRCA
5665+ BF21 0F               RRCA
5666+ BF22 0F               RRCA                                ; /16 = ENT_SIZE
5667+ BF23 E6 03            AND $03                             ; indice 0-2
5668+ BF25 5F               LD E, A
5669+ BF26 16 00            LD D, 0
5670+ BF28 21 67 B2         LD HL, MonsterHitThisAttack
