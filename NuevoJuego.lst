 317+ 88C7              SaveEntityAttr:
 318+ 88C7                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 319+ 88C7 DD 7E 00         LD A, (IX+0)                ; width_bytes
 320+ 88CA 47               LD B, A
 321+ 88CB 7B               LD A, E                     ; X pixel (raw)
 322+ 88CC E6 07            AND 7
 323+ 88CE 28 01            JR Z, .noExtraW
 324+ 88D0 04               INC B                       ; +1 columna si no alineado
 325+ 88D1              .noExtraW:
 326+ 88D1 78               LD A, B
 327+ 88D2 32 37 89         LD (EntityAttrW), A
 328+ 88D5
 329+ 88D5                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 330+ 88D5 7A               LD A, D                     ; Y pixel (raw)
 331+ 88D6 E6 07            AND 7                       ; Y offset dentro del char
 332+ 88D8 4F               LD C, A
 333+ 88D9 DD 7E 01         LD A, (IX+1)                ; height_pixels
 334+ 88DC 81               ADD A, C                    ; + Y offset
 335+ 88DD C6 07            ADD A, 7
 336+ 88DF 0F               RRCA
 337+ 88E0 0F               RRCA
 338+ 88E1 0F               RRCA
 339+ 88E2 E6 1F            AND $1F                     ; / 8 = height_chars
 340+ 88E4 32 38 89         LD (EntityAttrH), A
 341+ 88E7
 342+ 88E7 CD A1 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 343+ 88EA 11 27 89         LD DE, EntitySavedAttr      ; DE = buffer destino
 344+ 88ED
 345+ 88ED 3A 38 89         LD A, (EntityAttrH)
 346+ 88F0 4F               LD C, A                     ; C = filas
 347+ 88F1              .saveRow:
 348+ 88F1 3A 37 89         LD A, (EntityAttrW)
 349+ 88F4 47               LD B, A                     ; B = columnas
 350+ 88F5 E5               PUSH HL                     ; Guardar inicio de fila
 351+ 88F6              .saveCol:
 352+ 88F6 7E               LD A, (HL)
 353+ 88F7 12               LD (DE), A
 354+ 88F8 23               INC HL
 355+ 88F9 13               INC DE
 356+ 88FA 10 FA            DJNZ .saveCol
 357+ 88FC E1               POP HL
 358+ 88FD                  ; Siguiente fila attr: HL += 32
 359+ 88FD D5               PUSH DE
 360+ 88FE 11 20 00         LD DE, 32
 361+ 8901 19               ADD HL, DE
 362+ 8902 D1               POP DE
 363+ 8903 0D               DEC C
 364+ 8904 20 EB            JR NZ, .saveRow
 365+ 8906 C9               RET
 366+ 8907
 367+ 8907              ; ==============================================================================
 368+ 8907              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 369+ 8907              ; ==============================================================================
 370+ 8907              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 371+ 8907              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 372+ 8907              ;
 373+ 8907              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 374+ 8907              ; ==============================================================================
 375+ 8907              RestoreEntityAttr:
 376+ 8907 CD A1 8A         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 377+ 890A 11 27 89         LD DE, EntitySavedAttr      ; DE = buffer fuente
 378+ 890D
 379+ 890D 3A 38 89         LD A, (EntityAttrH)
 380+ 8910 4F               LD C, A
 381+ 8911              .restRow:
 382+ 8911 3A 37 89         LD A, (EntityAttrW)
 383+ 8914 47               LD B, A
 384+ 8915 E5               PUSH HL
 385+ 8916              .restCol:
 386+ 8916 1A               LD A, (DE)
 387+ 8917 77               LD (HL), A
 388+ 8918 23               INC HL
 389+ 8919 13               INC DE
 390+ 891A 10 FA            DJNZ .restCol
 391+ 891C E1               POP HL
 392+ 891D D5               PUSH DE
 393+ 891E 11 20 00         LD DE, 32
 394+ 8921 19               ADD HL, DE
 395+ 8922 D1               POP DE
 396+ 8923 0D               DEC C
 397+ 8924 20 EB            JR NZ, .restRow
 398+ 8926 C9               RET
 399+ 8927
 400+ 8927              ; --- Buffer de atributos guardados POR ENTIDAD ---
 401+ 8927              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 402+ 8927              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 403+ 8927              ; ---
 404+ 8927 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 405+ 8937 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 406+ 8938 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 407+ 8939 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 408+ 8A6B 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 409+ 8A6C
 410+ 8A6C              ; ==============================================================================
 411+ 8A6C              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 412+ 8A6C              ; ==============================================================================
 413+ 8A6C              ; Entrada: A = indice de entidad (0-16)
 414+ 8A6C              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 415+ 8A6C              ; ==============================================================================
 416+ 8A6C              SetAttrSlot:
 417+ 8A6C 32 6B 8A         LD (CurrentAttrSlot), A
 418+ 8A6F                  ; Calcular offset: A * 18
 419+ 8A6F 6F               LD L, A
 420+ 8A70 26 00            LD H, 0
 421+ 8A72 29               ADD HL, HL                  ; x2
 422+ 8A73 54               LD D, H
 423+ 8A74 5D               LD E, L                     ; DE = x2
 424+ 8A75 29               ADD HL, HL                  ; x4
 425+ 8A76 29               ADD HL, HL                  ; x8
 426+ 8A77 29               ADD HL, HL                  ; x16
 427+ 8A78 19               ADD HL, DE                  ; x18
 428+ 8A79 11 39 89         LD DE, SavedAttrTable
 429+ 8A7C 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 430+ 8A7D                  ; Copiar 18 bytes a EntitySavedAttr
 431+ 8A7D 11 27 89         LD DE, EntitySavedAttr
 432+ 8A80 01 12 00         LD BC, 18
 433+ 8A83 ED B0            LDIR
 434+ 8A85 C9               RET
 435+ 8A86
 436+ 8A86              ; ==============================================================================
 437+ 8A86              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 438+ 8A86              ; ==============================================================================
 439+ 8A86              FlushAttrSlot:
 440+ 8A86 3A 6B 8A         LD A, (CurrentAttrSlot)
 441+ 8A89 6F               LD L, A
 442+ 8A8A 26 00            LD H, 0
 443+ 8A8C 29               ADD HL, HL                  ; x2
 444+ 8A8D 54               LD D, H
 445+ 8A8E 5D               LD E, L
 446+ 8A8F 29               ADD HL, HL                  ; x4
 447+ 8A90 29               ADD HL, HL                  ; x8
 448+ 8A91 29               ADD HL, HL                  ; x16
 449+ 8A92 19               ADD HL, DE                  ; x18
 450+ 8A93 11 39 89         LD DE, SavedAttrTable
 451+ 8A96 19               ADD HL, DE                  ; HL = destino en tabla
 452+ 8A97 EB               EX DE, HL                   ; DE = destino
 453+ 8A98 21 27 89         LD HL, EntitySavedAttr      ; HL = fuente
 454+ 8A9B 01 12 00         LD BC, 18
 455+ 8A9E ED B0            LDIR
 456+ 8AA0 C9               RET
 457+ 8AA1
 458+ 8AA1              ; ==============================================================================
 459+ 8AA1              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 460+ 8AA1              ; ==============================================================================
 461+ 8AA1              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 462+ 8AA1              ; Salida: HL = direccion en zona de atributos ($5800+)
 463+ 8AA1              ; ==============================================================================
 464+ 8AA1              CalcAttrAddr:
 465+ 8AA1 7A               LD A, D
 466+ 8AA2 0F               RRCA
 467+ 8AA3 0F               RRCA
 468+ 8AA4 0F               RRCA
 469+ 8AA5 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 470+ 8AA7 6F               LD L, A
 471+ 8AA8 26 00            LD H, 0
 472+ 8AAA 29               ADD HL, HL
 473+ 8AAB 29               ADD HL, HL
 474+ 8AAC 29               ADD HL, HL
 475+ 8AAD 29               ADD HL, HL
 476+ 8AAE 29               ADD HL, HL                  ; HL = fila * 32
 477+ 8AAF 7B               LD A, E
 478+ 8AB0 0F               RRCA
 479+ 8AB1 0F               RRCA
 480+ 8AB2 0F               RRCA
 481+ 8AB3 E6 1F            AND $1F                     ; X / 8 = columna
 482+ 8AB5 B5               OR L
 483+ 8AB6 6F               LD L, A
 484+ 8AB7 01 00 58         LD BC, ATTR_BASE
 485+ 8ABA 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 486+ 8ABB C9               RET
 487+ 8ABC
 488+ 8ABC              ; ==============================================================================
 489+ 8ABC              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 490+ 8ABC              ; ==============================================================================
 491+ 8ABC              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 492+ 8ABC              ; Salida: HL=direccion en VRAM
 493+ 8ABC              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 494+ 8ABC              ; ==============================================================================
 495+ 8ABC              CalcPixelAddr:
 496+ 8ABC 7A               LD A, D
 497+ 8ABD E6 C0            AND $C0                     ; Y7 Y6
 498+ 8ABF 1F               RRA
 499+ 8AC0 1F               RRA
 500+ 8AC1 1F               RRA                         ; >> 3
 501+ 8AC2 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 502+ 8AC4 67               LD H, A
 503+ 8AC5
 504+ 8AC5 7A               LD A, D
 505+ 8AC6 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 506+ 8AC8 B4               OR H
 507+ 8AC9 67               LD H, A
 508+ 8ACA
 509+ 8ACA 7A               LD A, D
 510+ 8ACB E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 511+ 8ACD 87               ADD A, A
 512+ 8ACE 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 513+ 8ACF 6F               LD L, A
 514+ 8AD0
 515+ 8AD0 7B               LD A, E
 516+ 8AD1 1F               RRA
 517+ 8AD2 1F               RRA
 518+ 8AD3 1F               RRA
 519+ 8AD4 E6 1F            AND $1F                     ; X / 8 = columna
 520+ 8AD6 B5               OR L
 521+ 8AD7 6F               LD L, A
 522+ 8AD8 C9               RET
 523+ 8AD9
 524+ 8AD9              ; ==============================================================================
 525+ 8AD9              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 526+ 8AD9              ; ==============================================================================
 527+ 8AD9              DrawDebugInfo:
 528+ 8AD9 3A AF 81         LD A, (CurrentScreenX)
 529+ 8ADC 1E 00            LD E, 0
 530+ 8ADE CD FB 8A         CALL .drawHexDigit
 531+ 8AE1
 532+ 8AE1 3E 2C            LD A, ','
 533+ 8AE3 1E 01            LD E, 1
 534+ 8AE5 CD 07 8B         CALL .drawChar
 535+ 8AE8
 536+ 8AE8 3A B0 81         LD A, (CurrentScreenY)
 537+ 8AEB 1E 02            LD E, 2
 538+ 8AED CD FB 8A         CALL .drawHexDigit
 539+ 8AF0
 540+ 8AF0 21 00 58         LD HL, ATTR_BASE
 541+ 8AF3 3E 47            LD A, WHITE | $40
 542+ 8AF5 77               LD (HL), A
 543+ 8AF6 23               INC HL
 544+ 8AF7 77               LD (HL), A
 545+ 8AF8 23               INC HL
 546+ 8AF9 77               LD (HL), A
 547+ 8AFA C9               RET
 548+ 8AFB
 549+ 8AFB              .drawHexDigit:
 550+ 8AFB E6 0F            AND $0F
 551+ 8AFD FE 0A            CP 10
 552+ 8AFF 38 04            JR C, .isNum
 553+ 8B01 C6 37            ADD A, 'A' - 10
 554+ 8B03 18 02            JR .drawChar
 555+ 8B05              .isNum:
 556+ 8B05 C6 30            ADD A, '0'
 557+ 8B07              .drawChar:
 558+ 8B07 6F               LD L, A
 559+ 8B08 26 00            LD H, 0
 560+ 8B0A 29               ADD HL, HL
 561+ 8B0B 29               ADD HL, HL
 562+ 8B0C 29               ADD HL, HL
 563+ 8B0D 01 00 3C         LD BC, $3C00
 564+ 8B10 09               ADD HL, BC
 565+ 8B11
 566+ 8B11 16 40            LD D, $40
 567+ 8B13 06 08            LD B, 8
 568+ 8B15              .charLoop:
 569+ 8B15 7E               LD A, (HL)
 570+ 8B16 12               LD (DE), A
 571+ 8B17 23               INC HL
 572+ 8B18 14               INC D
 573+ 8B19 10 FA            DJNZ .charLoop
 574+ 8B1B C9               RET
