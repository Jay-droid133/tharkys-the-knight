4722+ BC64              ; ==============================================================================
4723+ BC64              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4724+ BC64              ; ==============================================================================
4725+ BC64              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4726+ BC64              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4727+ BC64              ; ==============================================================================
4728+ BC64              KillAllActiveNasties:
4729+ BC64 DD 21 84 81      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4730+ BC68 06 04            LD B, NUM_NASTIES
4731+ BC6A              .kanLoop:
4732+ BC6A C5               PUSH BC
4733+ BC6B DD 7E 01         LD A, (IX+ENT_TYPE)
4734+ BC6E B7               OR A
4735+ BC6F 28 2B            JR Z, .kanSkip                  ; slot vacio
4736+ BC71 FE 03            CP TYPE_NASTY
4737+ BC73 20 27            JR NZ, .kanSkip                 ; no es nasty
4738+ BC75 DD 7E 02         LD A, (IX+ENT_STATE)
4739+ BC78 FE 03            CP STATE_DYING
4740+ BC7A 28 20            JR Z, .kanSkip
4741+ BC7C FE 04            CP STATE_SPAWNING
4742+ BC7E 28 1C            JR Z, .kanSkip
4743+ BC80                  ; Transicionar a STATE_DYING con puff
4744+ BC80 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4745+ BC84 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4746+ BC88 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4747+ BC8C DD 36 09 02      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4748+ BC90 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4749+ BC94 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4750+ BC98 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
4751+ BC9C              .kanSkip:
4752+ BC9C 11 10 00         LD DE, ENT_SIZE
4753+ BC9F DD 19            ADD IX, DE
4754+ BCA1 C1               POP BC
4755+ BCA2 10 C6            DJNZ .kanLoop
4756+ BCA4 C9               RET
4757+ BCA5
4758+ BCA5              ; ==============================================================================
4759+ BCA5              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
4760+ BCA5              ; ==============================================================================
4761+ BCA5              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
4762+ BCA5              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
4763+ BCA5              ; ==============================================================================
4764+ BCA5              KillAllActiveMonsters:
4765+ BCA5 AF               XOR A
4766+ BCA6 32 9F B5         LD (MonstersActive), A              ; No respawnear mas
4767+ BCA9 DD 21 24 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4768+ BCAD 06 06            LD B, NUM_MONSTERS
4769+ BCAF              .kamLoop:
