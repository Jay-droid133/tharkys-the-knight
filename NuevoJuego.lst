1188+ F5B3 32 72 82         LD (ChurchCutscenePhase), A
1189+ F5B6 AF               XOR A
1190+ F5B7 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1191+ F5BA C9               RET
1192+ F5BB
1193+ F5BB              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1194+ F5BB              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1195+ F5BB              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1196+ F5BB              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1197+ F5BB              ; Entre transiciones, solo incrementa frame counter.
1198+ F5BB              .ucsSmokePhase:
1199+ F5BB 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1200+ F5BE B7               OR A
1201+ F5BF 28 0E            JR Z, .ucsSmokeEntry
1202+ F5C1 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1203+ F5C3 28 16            JR Z, .ucsSmokeStep1
1204+ F5C5 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1205+ F5C7 28 1D            JR Z, .ucsSmokeStep2
1206+ F5C9 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1207+ F5CB 28 25            JR Z, .ucsSmokeEnd
1208+ F5CD 18 35            JR .ucsSmokeIncFrame
1209+ F5CF              .ucsSmokeEntry:
1210+ F5CF                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1211+ F5CF 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1212+ F5D2 CD 92 68         CALL DrawRemainsForType
1213+ F5D5                  ; Dibujar smoke[0] (XOR)
1214+ F5D5 AF               XOR A
1215+ F5D6 CD DD 67         CALL DrawSmokeFrameXor
1216+ F5D9 18 29            JR .ucsSmokeIncFrame
1217+ F5DB              .ucsSmokeStep1:
1218+ F5DB AF               XOR A
1219+ F5DC CD DD 67         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1220+ F5DF 3E 01            LD A, 1
1221+ F5E1 CD DD 67         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1222+ F5E4 18 1E            JR .ucsSmokeIncFrame
1223+ F5E6              .ucsSmokeStep2:
1224+ F5E6 3E 01            LD A, 1
1225+ F5E8 CD DD 67         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1226+ F5EB 3E 02            LD A, 2
1227+ F5ED CD DD 67         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1228+ F5F0 18 12            JR .ucsSmokeIncFrame
1229+ F5F2              .ucsSmokeEnd:
1230+ F5F2 3E 02            LD A, 2
1231+ F5F4 CD DD 67         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1232+ F5F7 CD FC 67         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1233+ F5FA 3E 04            LD A, 4
1234+ F5FC 32 72 82         LD (ChurchCutscenePhase), A
1235+ F5FF AF               XOR A
1236+ F600 32 9D 5F         LD (ChurchCutsceneFrame), A
1237+ F603 C9               RET
1238+ F604              .ucsSmokeIncFrame:
1239+ F604 21 9D 5F         LD HL, ChurchCutsceneFrame
1240+ F607 34               INC (HL)
1241+ F608 C9               RET
