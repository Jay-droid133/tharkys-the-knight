 494  EE6D                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ EE6D              ; ==============================================================================
   2+ EE6D              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EE6D              ; ==============================================================================
   4+ EE6D              ; CurrentObjective vive en variables.asm. Valor:
   5+ EE6D              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EE6D              ;   11    = todos los hitos completados (juego ganado)
   7+ EE6D              ;
   8+ EE6D              ; ----------------------------------------------------------------------------
   9+ EE6D              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EE6D              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EE6D              ;                       recoger el sprite cuyo behavior coincide.
  12+ EE6D              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EE6D              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EE6D              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EE6D              ;
  16+ EE6D              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EE6D              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EE6D              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EE6D              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EE6D              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EE6D              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EE6D              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EE6D              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EE6D              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EE6D              ;
  26+ EE6D              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EE6D              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EE6D              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EE6D              ;
  30+ EE6D              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre.
  31+ EE6D              ; Util para saltarse hitos durante test (incluido M#7 SPECIAL si quisieras
  32+ EE6D              ; saltarte la cinematica de captura entera, aunque ya avanza solo desde
  33+ EE6D              ; UpdatePostTrapPause.uptpKey al soltar el cheque).
  34+ EE6D              ; ==============================================================================
  35+ EE6D
  36+ EE6D              MILESTONE_TYPE_PICKUP   EQU 1
  37+ EE6D              MILESTONE_TYPE_TRIGGER  EQU 2
  38+ EE6D              MILESTONE_TYPE_SPECIAL  EQU 3
  39+ EE6D
  40+ EE6D              MilestoneTable:
  41+ EE6D 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EE6F 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EE71 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EE73 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EE75 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EE77 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EE79 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EE7B                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EE7B                                                      ;    el cheque, no por tecla M en runtime)
  50+ EE7B 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EE7D                                                      ;    ir a recogerlo tras drop de la
  52+ EE7D                                                      ;    cinematica de la iglesia)
  53+ EE7D 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EE7F 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EE81 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EE83
  57+ EE83              MilestoneResolveTable:
  58+ EE83 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EE85 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EE87 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EE89 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EE8B 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EE8D 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EE8F 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ EE91 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  66+ EE93 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  67+ EE95 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  68+ EE97 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  69+ EE99
  70+ EE99              ; ==============================================================================
  71+ EE99              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  72+ EE99              ; ==============================================================================
  73+ EE99              ; IN:  A = key id (1..6) recien recogida
  74+ EE99              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  75+ EE99              ; ==============================================================================
  76+ EE99              CheckMilestonePickup:
  77+ EE99 E5               PUSH HL
  78+ EE9A D5               PUSH DE
  79+ EE9B C5               PUSH BC
  80+ EE9C F5               PUSH AF
  81+ EE9D 47               LD B, A                             ; B = key id recibida
  82+ EE9E 3A B7 82         LD A, (CurrentObjective)
  83+ EEA1 FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  84+ EEA3 30 27            JR NC, .cmpDone                     ; sin hitos pendientes
  85+ EEA5 87               ADD A, A                            ; *2 (entry size)
  86+ EEA6 6F               LD L, A
  87+ EEA7 26 00            LD H, 0
  88+ EEA9 11 6D EE         LD DE, MilestoneTable
  89+ EEAC 19               ADD HL, DE
  90+ EEAD 7E               LD A, (HL)                          ; tipo
  91+ EEAE FE 01            CP MILESTONE_TYPE_PICKUP
  92+ EEB0 20 1A            JR NZ, .cmpDone
  93+ EEB2 23               INC HL
  94+ EEB3 7E               LD A, (HL)                          ; ref esperada
  95+ EEB4 B8               CP B
  96+ EEB5 20 15            JR NZ, .cmpDone
  97+ EEB7 3A B7 82         LD A, (CurrentObjective)
  98+ EEBA 3C               INC A
  99+ EEBB 32 B7 82         LD (CurrentObjective), A
 100+ EEBE CD 5F EF         CALL ResolveObjectiveScreen
 101+ EEC1 3E FF            LD A, $FF
 102+ EEC3 32 BA 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 103+ EEC6 CD B4 75         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
