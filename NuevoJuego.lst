 653+ EB63 26 40            LD H, $40
 654+ EB65 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 655+ EB67 06 08            LD B, 8
 656+ EB69 AF               XOR A
 657+ EB6A              .ccRow1:
