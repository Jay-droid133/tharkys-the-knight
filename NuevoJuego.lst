 139+ 9A64              .alignedLine:
 140+ 9A64 3A BB 9A         LD A, (.widthSave)
 141+ 9A67 47               LD B, A                     ; B = ancho en bytes
 142+ 9A68 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A69
 144+ 9A69              .alignedByte:
 145+ 9A69 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A6A AE               XOR (HL)
 147+ 9A6B 77               LD (HL), A
 148+ 9A6C 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A6D 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A6E 10 F9            DJNZ .alignedByte
 151+ 9A70
 152+ 9A70 E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A71 0D               DEC C
 154+ 9A72 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A73 CD BF 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A76 18 EC            JR .alignedLine
 157+ 9A78
 158+ 9A78                  ; ==================================================================
 159+ 9A78                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A78                  ; ==================================================================
 161+ 9A78                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A78              .shifted:
 163+ 9A78                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A78 3D               DEC A                       ; 0-6
 165+ 9A79 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A7A E6 0E            AND $0E
 167+ 9A7C C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A7E 32 BD 9A         LD (.tablePage), A
 169+ 9A81
 170+ 9A81                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A81 DD E5            PUSH IX
 172+ 9A83 D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A84 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A85
 175+ 9A85                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A85 3A BA 9A         LD A, (.posY)
 177+ 9A88 57               LD D, A
 178+ 9A89 3A B9 9A         LD A, (.posX)
 179+ 9A8C 5F               LD E, A
 180+ 9A8D CD 53 9D         CALL CalcPixelAddr          ; HL = dir VRAM
 181+ 9A90
 182+ 9A90 D1               POP DE                      ; DE = sprite data ptr restaurado
 183+ 9A91 3A BD 9A         LD A, (.tablePage)
 184+ 9A94 47               LD B, A                     ; B = pagina high part
 185+ 9A95                  ; Contadores en IX (libre: se convirtio a DE arriba)
 186+ 9A95                  ; IXH = height counter, IXL = width counter (reset cada linea)
 187+ 9A95 3A BC 9A         LD A, (.heightSave)
 188+ 9A98 DD 67            LD IXH, A
