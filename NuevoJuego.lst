 492+ A0A3
 493+ A0A3              ; ==============================================================================
 494+ A0A3              ; ProcessOneEnemy - Procesa un enemigo completo: erase + logic + draw
 495+ A0A3              ; ==============================================================================
 496+ A0A3              ; IX = entidad activa. Fiel al original: todo junto, sin separar fases.
 497+ A0A3              ; ==============================================================================
 498+ A0A3              ProcessOneEnemy:
 499+ A0A3                  ; --- Frozen monster gate (durante muerte del player) ---
 500+ A0A3                  ; Skip toda la AI/state dispatch para los monsters; .peCalcAndDraw refresca
 501+ A0A3                  ; el sprite con la nueva pose/posicion fijada por FreezeMonstersFacingCorpse
 502+ A0A3                  ; (primer frame: erase old + draw new; siguientes: skip por SPRITEID/POSX igual).
 503+ A0A3 3A F2 82         LD A, (MonstersFrozen)
 504+ A0A6 B7               OR A
 505+ A0A7 28 08            JR Z, .peDispatch
 506+ A0A9 DD 7E 01         LD A, (IX+ENT_TYPE)
 507+ A0AC FE 02            CP TYPE_MONSTER
 508+ A0AE CA 16 A1         JP Z, .peCalcAndDraw
 509+ A0B1              .peDispatch:
 510+ A0B1                  ; --- Dispatch segun estado ---
 511+ A0B1 DD 7E 02         LD A, (IX+ENT_STATE)
 512+ A0B4 FE 03            CP STATE_DYING
 513+ A0B6 CA 28 A3         JP Z, .peDying
 514+ A0B9 FE 04            CP STATE_SPAWNING
 515+ A0BB CA DD A3         JP Z, .peSpawning
 516+ A0BE FE 05            CP STATE_SCARED
 517+ A0C0 CA 05 A2         JP Z, .peScared
 518+ A0C3 FE 06            CP STATE_ATTACKING
 519+ A0C5 CA F8 A1         JP Z, .peAttacking
 520+ A0C8
 521+ A0C8                  ; === STATE_RUNNING ===
 522+ A0C8                  ; Auto-transicion: nasty/monster + ScareTimer activo → STATE_SCARED
 523+ A0C8 3A 0E B6         LD A, (ScareTimer)
 524+ A0CB B7               OR A
 525+ A0CC 28 1E            JR Z, .peRunning
 526+ A0CE DD 7E 01         LD A, (IX+ENT_TYPE)
 527+ A0D1 FE 03            CP TYPE_NASTY
 528+ A0D3 28 08            JR Z, .peDoScare
 529+ A0D5 FE 02            CP TYPE_MONSTER
 530+ A0D7 20 13            JR NZ, .peRunning
 531+ A0D9                  ; Monster: limpiar stun antes de asustar
 532+ A0D9 DD 36 0A 00      LD (IX+ENT_DIR), 0
 533+ A0DD              .peDoScare:
 534+ A0DD DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
 535+ A0E1 DD 36 06 00      LD (IX+ENT_DELTAX), 0           ; Forzar recalculo de direccion
 536+ A0E5 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 537+ A0E9 C3 05 A2         JP .peScared
 538+ A0EC              .peRunning:
 539+ A0EC DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 540+ A0F0 C2 9C A1         JP NZ, .peFresh
 541+ A0F3
 542+ A0F3                  ; --- Logica: AI + movimiento + animacion ---
 543+ A0F3 DD 7E 01         LD A, (IX+ENT_TYPE)
 544+ A0F6 FE 05            CP TYPE_DEATH
 545+ A0F8 28 14            JR Z, .peDeathAI
 546+ A0FA FE 02            CP TYPE_MONSTER
 547+ A0FC 20 15            JR NZ, .peNormalAI
 548+ A0FE AF               XOR A
 549+ A0FF 32 77 B3         LD (MonsterKbDespawn), A        ; Reset flag
 550+ A102 CD FF AD         CALL UpdateMonster
 551+ A105 3A 77 B3         LD A, (MonsterKbDespawn)
 552+ A108 B7               OR A
 553+ A109 C2 00 A3         JP NZ, .peScaredDespawn         ; Knockback offscreen → borrar y despawnear
 554+ A10C 18 08            JR .peCalcAndDraw
 555+ A10E              .peDeathAI:
 556+ A10E CD 1F C5         CALL UpdateDeath
 557+ A111 18 03            JR .peCalcAndDraw
 558+ A113              .peNormalAI:
 559+ A113 CD 3E AD         CALL UpdateEnemy
