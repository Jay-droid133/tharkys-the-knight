 875+ CE27              ; ==============================================================================
 876+ CE27              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 877+ CE27              ; ==============================================================================
 878+ CE27              ; Entrada: A = attr byte
 879+ CE27              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 880+ CE27              ; Preserva: HL, DE, BC, IX
 881+ CE27              ; ==============================================================================
 882+ CE27              ApplyTintSwap:
 883+ CE27 C5               PUSH BC
 884+ CE28 47               LD B, A                     ; B = attr original
 885+ CE29 3A 23 CE         LD A, (CurrentTintVar)
 886+ CE2C FE FF            CP $FF
 887+ CE2E 28 24            JR Z, .tintNoChange
 888+ CE30 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 889+ CE31 3A 24 CE         LD A, (CurrentTintPaper)
 890+ CE34 FE FF            CP $FF
 891+ CE36 28 1C            JR Z, .tintNoChange
 892+ CE38                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 893+ CE38                  ; Extraer paper del attr: bits 5-3
 894+ CE38 78               LD A, B
 895+ CE39 E6 38            AND $38                     ; A = 00PPP000
 896+ CE3B 0F               RRCA
 897+ CE3C 0F               RRCA
 898+ CE3D 0F               RRCA                        ; A = 00000PPP = paper actual
 899+ CE3E D5               PUSH DE
 900+ CE3F 57               LD D, A                     ; D = paper actual
 901+ CE40 3A 24 CE         LD A, (CurrentTintPaper)
 902+ CE43 BA               CP D                        ; paper actual == tintPaper?
 903+ CE44 D1               POP DE
 904+ CE45 20 0D            JR NZ, .tintNoChange
 905+ CE47                  ; Match: reemplazar paper bits con tintVar
 906+ CE47 78               LD A, B
 907+ CE48 E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 908+ CE4A D5               PUSH DE
 909+ CE4B 57               LD D, A
 910+ CE4C 79               LD A, C                     ; A = tintVar (0-7)
 911+ CE4D 07               RLCA
 912+ CE4E 07               RLCA
 913+ CE4F 07               RLCA                        ; A = 00PPP000
 914+ CE50 B2               OR D                        ; A = FBPPPIII
 915+ CE51 D1               POP DE
 916+ CE52 C1               POP BC
 917+ CE53 C9               RET
 918+ CE54              .tintNoChange:
 919+ CE54 78               LD A, B                     ; devolver sin cambio
 920+ CE55 C1               POP BC
 921+ CE56 C9               RET
