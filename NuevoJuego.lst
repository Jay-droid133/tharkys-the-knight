 560+ FBAB              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 561+ FBAB              .bcPhTurnToDoor:
 562+ FBAB CD F7 FD         CALL BankCutsceneDecTimer
 563+ FBAE C0               RET NZ
 564+ FBAF                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 565+ FBAF CD FD F9         CALL BankCutsceneSnapToDoor
 566+ FBB2 AF               XOR A
 567+ FBB3 32 CC 82         LD (BankCutsceneKnockIdx), A
 568+ FBB6 3E 01            LD A, 1
 569+ FBB8 32 CF 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 570+ FBBB AF               XOR A
 571+ FBBC 32 CB 82         LD (BankCutsceneSubState), A        ; HIT
 572+ FBBF 3E 04            LD A, BCS_T_KNOCK_HIT
 573+ FBC1 32 CA 82         LD (BankCutsceneTimer), A
 574+ FBC4 CD 76 FD         CALL BankCutsceneEmitKnockHit
 575+ FBC7 3E 08            LD A, BCP_KNOCKS_3
 576+ FBC9 32 C9 82         LD (BankCutscenePhase), A
 577+ FBCC C9               RET
