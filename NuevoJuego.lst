 397+ AA8D              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 398+ AA8D              ; ==============================================================================
 399+ AA8D              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 400+ AA8D              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 401+ AA8D              ;          DEFB attr_h, attr_w, attr_data
 402+ AA8D              ; ==============================================================================
 403+ AA8D              DrawBgGfxSprite:
 404+ AA8D DD 7E 00         LD A, (IX+0)                ; height_px
 405+ AA90 B7               OR A
