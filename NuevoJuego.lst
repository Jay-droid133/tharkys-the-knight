242+  8723              ; ==============================================================================
243+  8723              ; IsPointBlocked - Comprueba si un punto pixel esta bloqueado por un sprite solido
244+  8723              ; ==============================================================================
245+  8723              ; Estilo Sabre Wulf (rutina B873): itera la lista de sprites del room,
246+  8723              ; comprueba si el punto cae dentro del bounding box de algun sprite solido.
247+  8723              ;
248+  8723              ; Entrada: B = X pixel, C = Y pixel
249+  8723              ; Salida: Z = libre, NZ = bloqueado
250+  8723              ; Preserva: BC (punto), DE (para el caller)
251+  8723              ; ==============================================================================
252+  8723              IsPointBlocked:
253+  8723 D5               PUSH DE
254+  8724 2A 06 81         LD HL, (CurrentScreenAddr)
255+  8727              .loop:
256+  8727                  ; Leer DEFW sprite_ptr
257+  8727 5E               LD E, (HL)
258+  8728 23               INC HL
259+  8729 56               LD D, (HL)
260+  872A 23               INC HL
261+  872B                  ; Terminador?
262+  872B 7A               LD A, D
263+  872C B3               OR E
264+  872D 28 55            JR Z, .free
265+  872F                  ; Leer posicion
266+  872F 7E               LD A, (HL)
267+  8730 23               INC HL
268+  8731 32 87 87         LD (.sprX), A
269+  8734 7E               LD A, (HL)
270+  8735 23               INC HL
271+  8736 32 88 87         LD (.sprY), A
272+  8739 E5               PUSH HL                     ; Guardar puntero a siguiente entrada
273+  873A                  ; Cargar definicion del sprite desde DE
274+  873A EB               EX DE, HL
275+  873B 7E               LD A, (HL)                  ; width_chars
276+  873C 32 89 87         LD (.sprW), A
277+  873F 23               INC HL
278+  8740 7E               LD A, (HL)                  ; height_chars
279+  8741 32 8A 87         LD (.sprH), A
280+  8744 23               INC HL
281+  8745 23               INC HL                      ; saltar attr
282+  8746 7E               LD A, (HL)                  ; flags
283+  8747 CB 47            BIT 0, A
284+  8749 28 36            JR Z, .skip                 ; No es solido, siguiente
285+  874B
286+  874B                  ; === Comprobar X ===
287+  874B                  ; charCol = B / 8, comprobar sprX <= charCol < sprX + sprW
288+  874B 78               LD A, B
289+  874C 0F               RRCA
290+  874D 0F               RRCA
291+  874E 0F               RRCA
292+  874F E6 1F            AND $1F                     ; A = charCol
293+  8751 57               LD D, A                     ; D = charCol
294+  8752 3A 87 87         LD A, (.sprX)
295+  8755 5F               LD E, A                     ; E = sprX
296+  8756 7A               LD A, D                     ; A = charCol
297+  8757 93               SUB E                       ; A = charCol - sprX (carry si charCol < sprX)
298+  8758 38 27            JR C, .skip                 ; Fuera por la izquierda
299+  875A                  ; A = offset horizontal dentro del sprite
300+  875A 5F               LD E, A                     ; E = offset
301+  875B 3A 89 87         LD A, (.sprW)
302+  875E BB               CP E                        ; sprW - offset
303+  875F 28 20            JR Z, .skip                 ; En el borde derecho = fuera
304+  8761 38 1E            JR C, .skip                 ; offset > sprW = fuera
305+  8763
306+  8763                  ; === Comprobar Y ===
307+  8763                  ; charRow = C / 8, comprobar sprY <= charRow < sprY + sprH
308+  8763 79               LD A, C
309+  8764 0F               RRCA
310+  8765 0F               RRCA
311+  8766 0F               RRCA
312+  8767 E6 1F            AND $1F                     ; A = charRow
313+  8769 57               LD D, A                     ; D = charRow
314+  876A 3A 88 87         LD A, (.sprY)
315+  876D 5F               LD E, A
316+  876E 7A               LD A, D
317+  876F 93               SUB E                       ; A = charRow - sprY
318+  8770 38 0F            JR C, .skip                 ; Fuera por arriba
319+  8772 5F               LD E, A
320+  8773 3A 8A 87         LD A, (.sprH)
321+  8776 BB               CP E
322+  8777 28 08            JR Z, .skip                 ; En el borde inferior = fuera
323+  8779 38 06            JR C, .skip                 ; offset > sprH = fuera
324+  877B
325+  877B                  ; Punto dentro de sprite solido!
326+  877B E1               POP HL
327+  877C 3E 01            LD A, 1
328+  877E B7               OR A                        ; NZ = bloqueado
329+  877F D1               POP DE
330+  8780 C9               RET
331+  8781
332+  8781              .skip:
333+  8781 E1               POP HL
334+  8782 18 A3            JR .loop
335+  8784
336+  8784              .free:
337+  8784 AF               XOR A                       ; Z = libre
338+  8785 D1               POP DE
339+  8786 C9               RET
340+  8787
