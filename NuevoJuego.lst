 590+ D49D                  ; Numero de velocidad en columna 31
 591+ D49D 3A CE 8F         LD A, (CurrentEnemySpeed)
 592+ D4A0 C6 30            ADD A, '0'
 593+ D4A2 1E 1F            LD E, 31
 594+ D4A4 CD B0 D4         CALL DrawHudCharRow0
 595+ D4A7                  ; Atributos (bright white)
 596+ D4A7 3E 47            LD A, $47
