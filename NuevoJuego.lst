 457+ 9F87              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9F87              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9F87              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9F87              ; ---
 461+ 9F87 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9F97 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9F98 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9F99 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ A0CB 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ A0CC
 467+ A0CC              ; ==============================================================================
 468+ A0CC              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ A0CC              ; ==============================================================================
 470+ A0CC              ; Entrada: A = indice de entidad (0-16)
 471+ A0CC              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ A0CC              ; ==============================================================================
 473+ A0CC              SetAttrSlot:
 474+ A0CC 32 CB A0         LD (CurrentAttrSlot), A
 475+ A0CF                  ; Calcular offset: A * 18
 476+ A0CF 6F               LD L, A
 477+ A0D0 26 00            LD H, 0
 478+ A0D2 29               ADD HL, HL                  ; x2
 479+ A0D3 54               LD D, H
 480+ A0D4 5D               LD E, L                     ; DE = x2
 481+ A0D5 29               ADD HL, HL                  ; x4
 482+ A0D6 29               ADD HL, HL                  ; x8
 483+ A0D7 29               ADD HL, HL                  ; x16
 484+ A0D8 19               ADD HL, DE                  ; x18
 485+ A0D9 11 99 9F         LD DE, SavedAttrTable
 486+ A0DC 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ A0DD                  ; Copiar 18 bytes a EntitySavedAttr
 488+ A0DD 11 87 9F         LD DE, EntitySavedAttr
 489+ A0E0 01 12 00         LD BC, 18
 490+ A0E3 ED B0            LDIR
 491+ A0E5 C9               RET
 492+ A0E6
 493+ A0E6              ; ==============================================================================
 494+ A0E6              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ A0E6              ; ==============================================================================
 496+ A0E6              FlushAttrSlot:
 497+ A0E6 3A CB A0         LD A, (CurrentAttrSlot)
 498+ A0E9 6F               LD L, A
 499+ A0EA 26 00            LD H, 0
 500+ A0EC 29               ADD HL, HL                  ; x2
 501+ A0ED 54               LD D, H
 502+ A0EE 5D               LD E, L
 503+ A0EF 29               ADD HL, HL                  ; x4
 504+ A0F0 29               ADD HL, HL                  ; x8
 505+ A0F1 29               ADD HL, HL                  ; x16
 506+ A0F2 19               ADD HL, DE                  ; x18
 507+ A0F3 11 99 9F         LD DE, SavedAttrTable
 508+ A0F6 19               ADD HL, DE                  ; HL = destino en tabla
 509+ A0F7 EB               EX DE, HL                   ; DE = destino
 510+ A0F8 21 87 9F         LD HL, EntitySavedAttr      ; HL = fuente
 511+ A0FB 01 12 00         LD BC, 18
 512+ A0FE ED B0            LDIR
 513+ A100 C9               RET
 514+ A101
 515+ A101              ; ==============================================================================
 516+ A101              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ A101              ; ==============================================================================
 518+ A101              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ A101              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ A101              ; ==============================================================================
 521+ A101              CalcAttrAddr:
 522+ A101 7A               LD A, D
 523+ A102 0F               RRCA
 524+ A103 0F               RRCA
 525+ A104 0F               RRCA
 526+ A105 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ A107 6F               LD L, A
 528+ A108 26 00            LD H, 0
 529+ A10A 29               ADD HL, HL
 530+ A10B 29               ADD HL, HL
 531+ A10C 29               ADD HL, HL
 532+ A10D 29               ADD HL, HL
 533+ A10E 29               ADD HL, HL                  ; HL = fila * 32
 534+ A10F 7B               LD A, E
 535+ A110 0F               RRCA
 536+ A111 0F               RRCA
 537+ A112 0F               RRCA
 538+ A113 E6 1F            AND $1F                     ; X / 8 = columna
 539+ A115 B5               OR L
 540+ A116 6F               LD L, A
 541+ A117 01 00 58         LD BC, ATTR_BASE
 542+ A11A 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ A11B C9               RET
 544+ A11C
 545+ A11C              ; ==============================================================================
 546+ A11C              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ A11C              ; ==============================================================================
 548+ A11C              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ A11C              ; Salida: HL=direccion en VRAM
 550+ A11C              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ A11C              ; ==============================================================================
 552+ A11C              CalcPixelAddr:
 553+ A11C 7A               LD A, D
 554+ A11D E6 C0            AND $C0                     ; Y7 Y6
 555+ A11F 1F               RRA
 556+ A120 1F               RRA
 557+ A121 1F               RRA                         ; >> 3
 558+ A122 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ A124 67               LD H, A
 560+ A125
 561+ A125 7A               LD A, D
 562+ A126 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ A128 B4               OR H
 564+ A129 67               LD H, A
 565+ A12A
 566+ A12A 7A               LD A, D
 567+ A12B E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ A12D 87               ADD A, A
 569+ A12E 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ A12F 6F               LD L, A
 571+ A130
 572+ A130 7B               LD A, E
 573+ A131 1F               RRA
 574+ A132 1F               RRA
 575+ A133 1F               RRA
 576+ A134 E6 1F            AND $1F                     ; X / 8 = columna
 577+ A136 B5               OR L
 578+ A137 6F               LD L, A
 579+ A138 C9               RET
 580+ A139
 581+ A139              ; ==============================================================================
 582+ A139              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ A139              ; ==============================================================================
 584+ A139              DrawDebugInfo:
 585+ A139 3A 08 82         LD A, (CurrentScreenX)
 586+ A13C 1E 00            LD E, 0
 587+ A13E CD 5B A1         CALL .drawHexDigit
 588+ A141
 589+ A141 3E 2C            LD A, ','
 590+ A143 1E 01            LD E, 1
 591+ A145 CD 67 A1         CALL .drawChar
 592+ A148
 593+ A148 3A 09 82         LD A, (CurrentScreenY)
 594+ A14B 1E 02            LD E, 2
 595+ A14D CD 5B A1         CALL .drawHexDigit
 596+ A150
 597+ A150 21 00 58         LD HL, ATTR_BASE
 598+ A153 3E 47            LD A, WHITE | $40
 599+ A155 77               LD (HL), A
 600+ A156 23               INC HL
 601+ A157 77               LD (HL), A
 602+ A158 23               INC HL
 603+ A159 77               LD (HL), A
 604+ A15A C9               RET
 605+ A15B
 606+ A15B              .drawHexDigit:
 607+ A15B E6 0F            AND $0F
 608+ A15D FE 0A            CP 10
 609+ A15F 38 04            JR C, .isNum
 610+ A161 C6 37            ADD A, 'A' - 10
 611+ A163 18 02            JR .drawChar
 612+ A165              .isNum:
 613+ A165 C6 30            ADD A, '0'
 614+ A167              .drawChar:
 615+ A167 6F               LD L, A
 616+ A168 26 00            LD H, 0
 617+ A16A 29               ADD HL, HL
 618+ A16B 29               ADD HL, HL
 619+ A16C 29               ADD HL, HL
 620+ A16D 01 00 3C         LD BC, $3C00
 621+ A170 09               ADD HL, BC
 622+ A171
 623+ A171 16 40            LD D, $40
 624+ A173 06 08            LD B, 8
 625+ A175              .charLoop:
 626+ A175 7E               LD A, (HL)
 627+ A176 12               LD (DE), A
 628+ A177 23               INC HL
 629+ A178 14               INC D
 630+ A179 10 FA            DJNZ .charLoop
 631+ A17B C9               RET
