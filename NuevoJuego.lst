1393+ F596              ; ==============================================================================
1394+ F596              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1395+ F596              ; ==============================================================================
1396+ F596              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1397+ F596              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1398+ F596              ; ==============================================================================
1399+ F596              ChurchCutsceneToggleMonsterDir:
1400+ F596                  ; IX = trapped monster
1401+ F596 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1402+ F599 3C               INC A
1403+ F59A 6F               LD L, A
1404+ F59B 26 00            LD H, 0
1405+ F59D 29               ADD HL, HL
1406+ F59E 29               ADD HL, HL
1407+ F59F 29               ADD HL, HL
1408+ F5A0 29               ADD HL, HL
1409+ F5A1 11 A3 81         LD DE, EntityTable
1410+ F5A4 19               ADD HL, DE
1411+ F5A5 E5               PUSH HL
1412+ F5A6 DD E1            POP IX
1413+ F5A8                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1414+ F5A8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1415+ F5AB DD 96 08         SUB (IX+ENT_ANIMBASE)
1416+ F5AE EE 04            XOR 4
1417+ F5B0 47               LD B, A
1418+ F5B1 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
