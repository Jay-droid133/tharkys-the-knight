4133+ B5C5 FE 06            CP ANIM_FRAMES_PUFF             ; >= 6 → animacion terminada
4134+ B5C7 38 09            JR C, .dyFrameOk
4135+ B5C9                  ; Animacion puff terminada: desactivar entidad
4136+ B5C9                  ; (el erase del ultimo frame ya se hizo en ProcessOneEnemy.peDying)
4137+ B5C9 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4138+ B5CD DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
4139+ B5D1 C9               RET
