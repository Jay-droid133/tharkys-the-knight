 304+ DB1D              ; ==============================================================================
 305+ DB1D              ; LUT: nibble (4 bits abcd) → byte doblado (aabbccdd)
 306+ DB1D              ; ==============================================================================
 307+ DB1D              NibbleDoubleLUT:
 308+ DB1D 00               DEFB %00000000  ; 0000 → 00000000
 309+ DB1E 03               DEFB %00000011  ; 0001 → 00000011
 310+ DB1F 0C               DEFB %00001100  ; 0010 → 00001100
 311+ DB20 0F               DEFB %00001111  ; 0011 → 00001111
 312+ DB21 30               DEFB %00110000  ; 0100 → 00110000
 313+ DB22 33               DEFB %00110011  ; 0101 → 00110011
 314+ DB23 3C               DEFB %00111100  ; 0110 → 00111100
 315+ DB24 3F               DEFB %00111111  ; 0111 → 00111111
 316+ DB25 C0               DEFB %11000000  ; 1000 → 11000000
 317+ DB26 C3               DEFB %11000011  ; 1001 → 11000011
 318+ DB27 CC               DEFB %11001100  ; 1010 → 11001100
 319+ DB28 CF               DEFB %11001111  ; 1011 → 11001111
 320+ DB29 F0               DEFB %11110000  ; 1100 → 11110000
 321+ DB2A F3               DEFB %11110011  ; 1101 → 11110011
 322+ DB2B FC               DEFB %11111100  ; 1110 → 11111100
 323+ DB2C FF               DEFB %11111111  ; 1111 → 11111111
