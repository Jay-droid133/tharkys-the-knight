1214+ 8EB8              ; SchedulePendingErase - Agenda un erase pendiente para el siguiente frame
1215+ 8EB8              ; ==============================================================================
1216+ 8EB8              ; IX = entidad que necesita erase final. Guarda datos en PendingEraseSlots.
1217+ 8EB8              ; ==============================================================================
1218+ 8EB8              SchedulePendingErase:
1219+ 8EB8 3A 6C 81         LD A, (PendingEraseCount)
1220+ 8EBB FE 03            CP 3
1221+ 8EBD D0               RET NC                              ; Buffer lleno (no deberia pasar)
1222+ 8EBE                  ; Calcular posicion en buffer: count × 5
1223+ 8EBE 6F               LD L, A
1224+ 8EBF 26 00            LD H, 0
1225+ 8EC1 29               ADD HL, HL
1226+ 8EC2 29               ADD HL, HL
1227+ 8EC3 29               ADD HL, HL                          ; count × 8 (simplificado)
1228+ 8EC4                  ; Corregir: count × 5 = count × 4 + count
1229+ 8EC4 6F               LD L, A
1230+ 8EC5 26 00            LD H, 0
1231+ 8EC7 54               LD D, H
1232+ 8EC8 5D               LD E, L
1233+ 8EC9 29               ADD HL, HL
1234+ 8ECA 29               ADD HL, HL                          ; count × 4
1235+ 8ECB 19               ADD HL, DE                          ; count × 5
1236+ 8ECC 11 6D 81         LD DE, PendingEraseSlots
1237+ 8ECF 19               ADD HL, DE
1238+ 8ED0                  ; Guardar OLDSPRID, OLDX, OLDY + sprite addr
1239+ 8ED0 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1240+ 8ED3 77               LD (HL), A
1241+ 8ED4 23               INC HL
1242+ 8ED5 DD 7E 0C         LD A, (IX+ENT_OLDX)
1243+ 8ED8 77               LD (HL), A
1244+ 8ED9 23               INC HL
1245+ 8EDA DD 7E 0D         LD A, (IX+ENT_OLDY)
1246+ 8EDD 77               LD (HL), A
1247+ 8EDE 23               INC HL
1248+ 8EDF                  ; Resolver sprite addr y guardarla
1249+ 8EDF DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1250+ 8EE2 E5               PUSH HL
1251+ 8EE3 6F               LD L, A
1252+ 8EE4 26 00            LD H, 0
1253+ 8EE6 29               ADD HL, HL
1254+ 8EE7 11 98 AD         LD DE, SpriteFrameTable
1255+ 8EEA 19               ADD HL, DE
1256+ 8EEB 5E               LD E, (HL)
1257+ 8EEC 23               INC HL
1258+ 8EED 56               LD D, (HL)                          ; DE = sprite data addr
1259+ 8EEE E1               POP HL
1260+ 8EEF 73               LD (HL), E
1261+ 8EF0 23               INC HL
1262+ 8EF1 72               LD (HL), D
1263+ 8EF2                  ; Incrementar counter
1264+ 8EF2 3A 6C 81         LD A, (PendingEraseCount)
