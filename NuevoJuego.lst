2848+ B21C              .moKbClampYDone:
2849+ B21C 79               LD A, C
2850+ B21D              .moKbClampDone:
2851+ B21D                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
2852+ B21D                  ;
2853+ B21D                  ; Doble comportamiento:
2854+ B21D                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
2855+ B21D                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
2856+ B21D                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
2857+ B21D                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
2858+ B21D                  ;   y lo activa).
2859+ B21D                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
2860+ B21D                  ;   El monster queda en destino (memoria) hasta que el player visite.
2861+ B21D                  ;
2862+ B21D                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
2863+ B21D                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
2864+ B21D DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
2865+ B220 32 61 B2         LD (.moKbSavedDir), A
2866+ B223 3E 01            LD A, 1
2867+ B225 32 9E B5         LD (MonsterKbDespawn), A
2868+ B228                  ; Calcular slot (0-2) en E, D=0
2869+ B228 DD E5            PUSH IX
2870+ B22A E1               POP HL
2871+ B22B 11 24 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
2872+ B22E B7               OR A
2873+ B22F ED 52            SBC HL, DE
2874+ B231 CB 3D            SRL L
2875+ B233 CB 3D            SRL L
2876+ B235 CB 3D            SRL L
2877+ B237 CB 3D            SRL L
2878+ B239 5D               LD E, L
2879+ B23A 16 00            LD D, 0
2880+ B23C                  ; Clear MAI_FLAG_LEAVING
2881+ B23C 21 A0 90         LD HL, MonsterAiFlags
2882+ B23F 19               ADD HL, DE
2883+ B240 7E               LD A, (HL)
2884+ B241 E6 FD            AND ~MAI_FLAG_LEAVING & $FF
2885+ B243 77               LD (HL), A
2886+ B244                  ; MonsterRoomId[slot] = neighbor_id (destino)
2887+ B244 3A 61 B2         LD A, (.moKbSavedDir)
2888+ B247 CD F1 92         CALL MaiGetNeighborScreenId
2889+ B24A 21 94 90         LD HL, MonsterRoomId
2890+ B24D 19               ADD HL, DE
2891+ B24E 77               LD (HL), A
2892+ B24F                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
2893+ B24F 3A 61 B2         LD A, (.moKbSavedDir)
2894+ B252 CD 50 93         CALL MaiDirToEntrySide
2895+ B255 21 9A 90         LD HL, MonsterEntryBorder
2896+ B258 19               ADD HL, DE
2897+ B259 77               LD (HL), A
2898+ B25A                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
2899+ B25A 21 A0 B5         LD HL, MonsterReturnTimer
2900+ B25D 19               ADD HL, DE
2901+ B25E 36 19            LD (HL), MAI_LINGER_PUSHED
2902+ B260 C9               RET
2903+ B261
2904+ B261 00           .moKbSavedDir: DEFB 0
2905+ B262              .moStunStop:
2906+ B262 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2907+ B266 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2908+ B26A C3 F7 B3         JP .moAnimate
2909+ B26D
2910+ B26D              .moNormal:
2911+ B26D                  ; --- Escape de wall: si estamos dentro de un BG sprite, empujar fuera ---
2912+ B26D DD 7E 03         LD A, (IX+ENT_POSX)
2913+ B270 47               LD B, A
2914+ B271 DD 7E 04         LD A, (IX+ENT_POSY)
2915+ B274 4F               LD C, A
2916+ B275 CD 26 D1         CALL IsPointBlocked
2917+ B278 28 29            JR Z, .moNotInWall
