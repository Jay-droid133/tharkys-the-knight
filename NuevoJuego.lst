 584+ EB25              ; ==============================================================================
 585+ EB25              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 586+ EB25              ; ==============================================================================
 587+ EB25              ; IN: DE = ptr a 16 filas x 2 bytes
 588+ EB25              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 589+ EB25              ; Destruye: AF, B, HL.
 590+ EB25              ; ==============================================================================
 591+ EB25              DrawCompassSprite:
 592+ EB25                  ; Char row 0 (rows 0-7 del sprite)
 593+ EB25 26 40            LD H, $40
 594+ EB27 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 595+ EB29 06 08            LD B, 8
 596+ EB2B              .dcsRow0:
 597+ EB2B 1A               LD A, (DE)
 598+ EB2C 77               LD (HL), A
 599+ EB2D 13               INC DE
 600+ EB2E 23               INC HL
 601+ EB2F 1A               LD A, (DE)
 602+ EB30 77               LD (HL), A
 603+ EB31 13               INC DE
 604+ EB32 2B               DEC HL
 605+ EB33 24               INC H
 606+ EB34 10 F5            DJNZ .dcsRow0
 607+ EB36                  ; Char row 1 (rows 8-15 del sprite)
 608+ EB36 26 40            LD H, $40
 609+ EB38 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 610+ EB3A 06 08            LD B, 8
 611+ EB3C              .dcsRow1:
 612+ EB3C 1A               LD A, (DE)
 613+ EB3D 77               LD (HL), A
