 182  6C9E                  ; --- Bank cutscene: thunks slot 1 + body en bank 7 (M9) ---
 183  6C9E                  ; OBSERVACION CRITICA: estos thunks tienen que ir ANTES de magic_compass.asm
 184  6C9E                  ; (NO despues de music_irq) porque slot 1 esta apretado y meterlos al final
 185  6C9E                  ; deborda el slot a $8000+ (slot 2 = bank 2) -> crash al BASIC.
 186  6C9E                  ;
 187  6C9E                  ; Aqui empujan magic_compass.asm ~140 B hacia $7A00, pero gracias a la
 188  6C9E                  ; fusion de DrawBankDoorSprite_B7 dentro de DrawBgGfxSprite_B7 (ahorra 18 B)
 189  6C9E                  ; y al stripping de los thunks al minimo, magic_compass termina en ~$79F0,
 190  6C9E                  ; antes de la tabla IM2 ($7A00) -> BFS no cruza la zona reservada.
 191  6C9E                  INCLUDE "bank_cutscene_thunks.asm"
# file opened: bank_cutscene_thunks.asm
   1+ 6C9E              ; ==============================================================================
   2+ 6C9E              ; bank_cutscene_thunks.asm - Wrappers slot 1 para bank_cutscene en bank 7
   3+ 6C9E              ; ==============================================================================
   4+ 6C9E              ; bank_cutscene.asm vive en bank 7 (movido desde bank 0 para descongestionar el
   5+ 6C9E              ; main code). Este archivo expone los 2 entry points externos como thunks que
   6+ 6C9E              ; paginan bank 7 antes del body y restauran bank 0 al volver. Tambien proporciona
   7+ 6C9E              ; helpers _PageBank0 / _PageBank7 que el body bank 7 usa para envolver cada
   8+ 6C9E              ; CALL a una funcion en bank 0 (o en slot 1 que internamente llame a bank 0).
   9+ 6C9E              ;
  10+ 6C9E              ; Funciones externas que requieren el wrap pre+post (paginar bank 0 antes,
  11+ 6C9E              ; restaurar bank 7 despues):
  12+ 6C9E              ;   - DrawBgSpriteXOR, DrawBgGfxSprite, RedrawPickupByPtr, PlaySFX,
  13+ 6C9E              ;     CheckMilestoneTrigger    (todas en bank 0)
  14+ 6C9E              ;   - TownGateRedrawPlayer     (slot 1, pero llama internamente a RestoreOldAttr
  15+ 6C9E              ;                              que vive en bank 0)
  16+ 6C9E              ;
  17+ 6C9E              ; Funciones que requieren solo post-wrap (ya paginan bank 0 al final ellas mismas):
  18+ 6C9E              ;   - LoadBgSpriteToBuffer     (slot 1, deja bank 0 paginado al RET -> repaginar
  19+ 6C9E              ;                              bank 7 manualmente)
  20+ 6C9E              ;
  21+ 6C9E              ; Funciones que NO necesitan wrap (verificado por call graph):
  22+ 6C9E              ;   - KillAllActiveNasties, SnapPuffPos, CheckEnemyCollision  (bank 2 slot 2)
  23+ 6C9E              ;   - KillDeathIfActive -> StartMusic                          (bank 2 slot 2)
  24+ 6C9E              ;   - TownGateAllNastiesDeadCheck                              (slot 1, no calls)
  25+ 6C9E              ;   - AY_PlayKnockSoft/Loud/Beep                               (slot 1, no calls externos)
  26+ 6C9E              ;   - DrawBgSprite16XorAtPixel -> CalcPixelAddr/NextPixelLine  (bank 2 slot 2)
  27+ 6C9E              ;
  28+ 6C9E              ; Vive en slot 1 (always-visible). Patron similar a game_over_tomb_thunk.asm.
  29+ 6C9E              ;
  30+ 6C9E              ; CRITICO: el stack normal del juego vive en $FF58 (slot 3, bank 0 paginable).
  31+ 6C9E              ; Si los thunks paginan bank 7 en slot 3 sin tocar SP, el stack normal desaparece
  32+ 6C9E              ; bajo nuestros pies -> CALL/RET dentro del body bank 7 leen basura -> crash.
  33+ 6C9E              ; Solucion: los entry thunks (CheckBankTriggerBg, UpdateBankCutscene) hacen SP
  34+ 6C9E              ; swap a BankCutsceneAltStack (RAM always-visible en slot 1, zona $5BE0..$5C00
  35+ 6C9E              ; del printer buffer) durante toda la cutscene. Los _B7 thunks de funciones
  36+ 6C9E              ; externas heredan ese SP (no necesitan su propio swap).
  37+ 6C9E              ;
  38+ 6C9E              ; Sin DI en los page switches: MusicIrqHandler vive en slot 1, por convencion
  39+ 6C9E              ; project_irq_slot3_atomic no toca slot 3 -> IRQs corren normales durante los
  40+ 6C9E              ; page switches igual que en LoadBgSpriteToBuffer.
  41+ 6C9E              ; ==============================================================================
  42+ 6C9E
  43+ 6C9E              ; Alt stack: 64 B al final de slot 1 ($7FC0..$7FFF, hueco libre tras music_irq).
  44+ 6C9E              ; Vive en bank 5 always-visible, no toca otras zonas de RAM. Pico medido:
  45+ 6C9E              ; TownGateRedrawPlayer -> DrawSprite -> _DrawSpriteImpl + IRQ handler
  46+ 6C9E              ; concurrente puede superar 32 B; 64 B (32 niveles) da margen amplio.
  47+ 6C9E              BankCutsceneAltStackBase EQU $7FC0
  48+ 6C9E              BankCutsceneAltStackTop  EQU $8000       ; SP top: first PUSH escribe a $7FFE-$7FFF
  49+ 6C9E
  50+ 6C9E              ; ==============================================================================
  51+ 6C9E              ; _PageBank0 - Pagina bank 0 en slot 3. Preserva AF + BC + resto del caller.
  52+ 6C9E              ; ==============================================================================
  53+ 6C9E              ; Llamado por:
  54+ 6C9E              ;   - Entry thunks al final (devolver al gameplay normal).
  55+ 6C9E              ;   - Body bank 7 antes de cada CALL externo que toca bank 0.
  56+ 6C9E              ; Destruye: ningun reg (todo restaurado via PUSH/POP).
  57+ 6C9E              ; ==============================================================================
  58+ 6C9E              _PageBank0:
  59+ 6C9E F5               PUSH AF
  60+ 6C9F C5               PUSH BC
  61+ 6CA0 3A 8A 8D         LD A, (CurrentPaging)
  62+ 6CA3 E6 F8            AND $F8                              ; bank 0 = bits 0-2 a cero
  63+ 6CA5 32 8A 8D         LD (CurrentPaging), A
  64+ 6CA8 01 FD 7F         LD BC, $7FFD
  65+ 6CAB ED 79            OUT (C), A
  66+ 6CAD C1               POP BC
  67+ 6CAE F1               POP AF
  68+ 6CAF C9               RET
  69+ 6CB0
  70+ 6CB0              ; ==============================================================================
  71+ 6CB0              ; _PageBank7 - Pagina bank 7 en slot 3. Preserva AF + BC + resto del caller.
  72+ 6CB0              ; ==============================================================================
  73+ 6CB0              ; Llamado por:
  74+ 6CB0              ;   - Entry thunks al principio (para que el body bank 7 sea visible).
  75+ 6CB0              ;   - Body bank 7 despues de cada CALL externo (para retomar el flujo).
  76+ 6CB0              ; Destruye: ningun reg.
  77+ 6CB0              ; ==============================================================================
  78+ 6CB0              _PageBank7:
  79+ 6CB0 F5               PUSH AF
  80+ 6CB1 C5               PUSH BC
  81+ 6CB2 3A 8A 8D         LD A, (CurrentPaging)
  82+ 6CB5 E6 F8            AND $F8
  83+ 6CB7 F6 07            OR 7
  84+ 6CB9 32 8A 8D         LD (CurrentPaging), A
  85+ 6CBC 01 FD 7F         LD BC, $7FFD
  86+ 6CBF ED 79            OUT (C), A
  87+ 6CC1 C1               POP BC
  88+ 6CC2 F1               POP AF
  89+ 6CC3 C9               RET
  90+ 6CC4
  91+ 6CC4              ; ==============================================================================
  92+ 6CC4              ; CheckBankTriggerBg - Thunk de entry. Swap SP a alt_stack, pagina bank 7,
  93+ 6CC4              ; ejecuta body, restaura bank 0 + SP normal.
  94+ 6CC4              ; ==============================================================================
  95+ 6CC4              ; Llamado desde MainLoop cada frame. Body verifica si el player toca la
  96+ 6CC4              ; puerta del banco con el cheque y dispara la cutscene + avance de hito M9.
  97+ 6CC4              ;
  98+ 6CC4              ; CRITICO: stack normal vive en bank 0 (slot 3) -> desaparece al paginar bank 7.
  99+ 6CC4              ; Por eso swap SP a alt_stack ANTES del page switch.
 100+ 6CC4              ; ==============================================================================
 101+ 6CC4              CheckBankTriggerBg:
 102+ 6CC4 ED 73 D9 6C      LD (.savedSPCheck), SP                   ; save SP normal (en bank 0)
 103+ 6CC8 31 00 80         LD SP, BankCutsceneAltStackTop           ; SP -> alt_stack (slot 1 always-vis)
 104+ 6CCB CD B0 6C         CALL _PageBank7
 105+ 6CCE CD A3 DD         CALL CheckBankTriggerBgBody
 106+ 6CD1 CD 9E 6C         CALL _PageBank0                          ; bank 0 paginado -> SP normal accesible al restaurar
 107+ 6CD4 ED 7B D9 6C      LD SP, (.savedSPCheck)                   ; restore SP normal
 108+ 6CD8 C9               RET                                      ; vuelve al CALL del MainLoop
 109+ 6CD9 00 00        .savedSPCheck: DEFW 0
 110+ 6CDB
 111+ 6CDB              ; ==============================================================================
 112+ 6CDB              ; UpdateBankCutscene - Thunk de entry para el tick por frame de la cutscene.
 113+ 6CDB              ; ==============================================================================
 114+ 6CDB              ; Mismo patron SP swap que CheckBankTriggerBg. Llamado desde MainLoop cada
 115+ 6CDB              ; frame si BankCutscenePhase != 0.
 116+ 6CDB              ; ==============================================================================
 117+ 6CDB              UpdateBankCutscene:
 118+ 6CDB ED 73 F0 6C      LD (.savedSPUpdate), SP
 119+ 6CDF 31 00 80         LD SP, BankCutsceneAltStackTop
 120+ 6CE2 CD B0 6C         CALL _PageBank7
 121+ 6CE5 CD AC DE         CALL UpdateBankCutsceneBody
 122+ 6CE8 CD 9E 6C         CALL _PageBank0
 123+ 6CEB ED 7B F0 6C      LD SP, (.savedSPUpdate)
 124+ 6CEF C9               RET
 125+ 6CF0 00 00        .savedSPUpdate: DEFW 0
 126+ 6CF2
 127+ 6CF2              ; ==============================================================================
 128+ 6CF2              ; Entry thunks para town_gate_cutscene (body en bank 7)
 129+ 6CF2              ; ==============================================================================
 130+ 6CF2              ; Mutuamente exclusiva con bank_cutscene (M11 vs M9), comparte el alt_stack
 131+ 6CF2              ; (no pueden estar activas a la vez por el milestone gating en MainLoop).
 132+ 6CF2              ;
 133+ 6CF2              ; StartTownGateCutscene NO necesita su propio entry thunk — se llama solo
 134+ 6CF2              ; desde CheckTownGateTriggerBgBody (interno bank 7).
 135+ 6CF2              ; ==============================================================================
 136+ 6CF2              CheckTownGateTriggerBg:
 137+ 6CF2 ED 73 07 6D      LD (.savedSPCheckTG), SP
 138+ 6CF6 31 00 80         LD SP, BankCutsceneAltStackTop
 139+ 6CF9 CD B0 6C         CALL _PageBank7
 140+ 6CFC CD 8C E5         CALL CheckTownGateTriggerBgBody
 141+ 6CFF CD 9E 6C         CALL _PageBank0
 142+ 6D02 ED 7B 07 6D      LD SP, (.savedSPCheckTG)
 143+ 6D06 C9               RET
 144+ 6D07 00 00        .savedSPCheckTG: DEFW 0
 145+ 6D09
 146+ 6D09              UpdateTownGateCutscene:
 147+ 6D09 ED 73 1E 6D      LD (.savedSPUpdateTG), SP
 148+ 6D0D 31 00 80         LD SP, BankCutsceneAltStackTop
 149+ 6D10 CD B0 6C         CALL _PageBank7
 150+ 6D13 CD FA E5         CALL UpdateTownGateCutsceneBody
 151+ 6D16 CD 9E 6C         CALL _PageBank0
 152+ 6D19 ED 7B 1E 6D      LD SP, (.savedSPUpdateTG)
 153+ 6D1D C9               RET
 154+ 6D1E 00 00        .savedSPUpdateTG: DEFW 0
 155+ 6D20
 156+ 6D20              ; ==============================================================================
 157+ 6D20              ; External call thunks - usados desde el body bank 7 para llamar a rutinas
 158+ 6D20              ; que viven en bank 0 (o en slot 1 que internamente toca bank 0).
 159+ 6D20              ; ==============================================================================
 160+ 6D20              ; Patron: body bank 7 hace `CALL <Func>_B7`. El thunk pagina bank 0, llama a
 161+ 6D20              ; la funcion real, repagina bank 7, y RETurnea al body. Args en HL/BC/DE/A/IX
 162+ 6D20              ; quedan intactos (_PageBank0 / _PageBank7 preservan AF + BC via PUSH/POP).
 163+ 6D20              ;
 164+ 6D20              ; CRITICO: el body bank 7 NO puede llamar _PageBank0 directamente — al volver,
 165+ 6D20              ; slot 3 estaria en bank 0 y el RET aterrizaria en bank 0 (no en bank 7) =
 166+ 6D20              ; crash. Por eso cada wrap vive como thunk individual en slot 1 (always-vis).
 167+ 6D20              ; ==============================================================================
 168+ 6D20
 169+ 6D20              ; --- bank 0 callees (paginar bank 0 antes, restaurar bank 7 al RET) ---
 170+ 6D20
 171+ 6D20              DrawBgSpriteXOR_B7:
 172+ 6D20 CD 9E 6C         CALL _PageBank0
 173+ 6D23 CD 2A DC         CALL DrawBgSpriteXOR
 174+ 6D26 C3 B0 6C         JP _PageBank7
 175+ 6D29
 176+ 6D29              ; DrawBgGfxSprite_B7 - draw + flags. El unico caller del body bank 7 es
 177+ 6D29              ; BankCutsceneCloseDoorRestoreAttrs, que necesita BgSpriteIsHouse=0 y
 178+ 6D29              ; CurrentTintVar=$FF antes del draw. Esas vars viven en BANK 0, asi que
 179+ 6D29              ; se escriben aqui DENTRO del wrap pre-paginated. Antes era un thunk
 180+ 6D29              ; aparte (DrawBankDoorSprite_B7) pero combinar ahorra 18 B en slot 1 —
 181+ 6D29              ; critico para que magic_compass.asm no cruce $7A00 (im2 table).
 182+ 6D29              DrawBgGfxSprite_B7:
 183+ 6D29 CD 9E 6C         CALL _PageBank0
 184+ 6D2C AF               XOR A
 185+ 6D2D 32 FB E3         LD (BgSpriteIsHouse), A
 186+ 6D30 3E FF            LD A, $FF
 187+ 6D32 32 B5 D2         LD (CurrentTintVar), A
 188+ 6D35 CD AB D1         CALL DrawBgGfxSprite
 189+ 6D38 C3 B0 6C         JP _PageBank7
 190+ 6D3B
 191+ 6D3B              RedrawPickupByPtr_B7:
 192+ 6D3B CD 9E 6C         CALL _PageBank0
 193+ 6D3E CD 5B D8         CALL RedrawPickupByPtr
 194+ 6D41 C3 B0 6C         JP _PageBank7
 195+ 6D44
 196+ 6D44              PlaySFX_B7:                              ; HL = SFX data ptr (en bank 0)
 197+ 6D44 CD 9E 6C         CALL _PageBank0
 198+ 6D47 CD C5 F9         CALL PlaySFX
 199+ 6D4A C3 B0 6C         JP _PageBank7
 200+ 6D4D
 201+ 6D4D              CheckMilestoneTrigger_B7:                ; A = action id
 202+ 6D4D CD 9E 6C         CALL _PageBank0
 203+ 6D50 CD F7 EF         CALL CheckMilestoneTrigger
 204+ 6D53 C3 B0 6C         JP _PageBank7
 205+ 6D56
 206+ 6D56              ; --- slot 1 callee con dependencia bank 0 interna ---
 207+ 6D56
 208+ 6D56              TownGateRedrawPlayer_B7:
 209+ 6D56 CD 9E 6C         CALL _PageBank0
 210+ 6D59 CD F8 62         CALL TownGateRedrawPlayer            ; -> TownGateErasePlayer -> RestoreOldAttr (bank 0)
 211+ 6D5C C3 B0 6C         JP _PageBank7
 212+ 6D5F
 213+ 6D5F              ; --- slot 1 callee que deja bank 0 paginado al RET (solo post-wrap) ---
 214+ 6D5F
 215+ 6D5F              LoadBgSpriteToBuffer_B7:                 ; HL = sprite ptr, A = bank
 216+ 6D5F CD C9 67         CALL LoadBgSpriteToBuffer            ; ya pagina bank 3/4 internamente, deja bank 0 al RET
 217+ 6D62 C3 B0 6C         JP _PageBank7                        ; repaginar bank 7 (LoadBgSpriteToBuffer no lo hace)
 218+ 6D65
 219+ 6D65              ; --- slot 2 callees que internamente paginan bank 6 (sprite_data) y "restauran"
 220+ 6D65              ;     bank 0 al RET, no el bank original. Si los llamasemos crudamente desde
 221+ 6D65              ;     bank 7, slot 3 terminaria con bank 0 -> body bank 7 invisible -> crash.
 222+ 6D65              ;     KillAllActiveNasties -> SnapPuffPos -> GetSpriteDims (pagina bank 6).
 223+ 6D65              ;     KillDeathIfActive    -> StartMusic   (pagina bank 4). ---
 224+ 6D65
 225+ 6D65              KillAllActiveNasties_B7:
 226+ 6D65 CD 64 BA         CALL KillAllActiveNasties
 227+ 6D68 C3 B0 6C         JP _PageBank7                        ; restaura bank 7 (KillAll dejo bank 0)
 228+ 6D6B
 229+ 6D6B              KillDeathIfActive_B7:
 230+ 6D6B CD 77 62         CALL KillDeathIfActive
 231+ 6D6E C3 B0 6C         JP _PageBank7                        ; restaura bank 7 (StartMusic dejo bank 0)
 232+ 6D71
 233+ 6D71              ; ==============================================================================
 234+ 6D71              ; Thunks adicionales para town_gate_cutscene body (bank 7)
 235+ 6D71              ; ==============================================================================
 236+ 6D71              ; town_gate body llama tambien a las siguientes funciones bank 2 / bank 0.
 237+ 6D71              ; Mismo patron: paginate bank 0, CALL, repaginate bank 7.
 238+ 6D71              ;
 239+ 6D71              ; DrawSprite / GetSpriteAddr / GetOldSpriteAddr paginan bank 6 internamente
 240+ 6D71              ; y restauran bank 0 al RET -> wrap completo (page bank 0 antes, page bank 7
 241+ 6D71              ; despues).
 242+ 6D71              ;
 243+ 6D71              ; RestoreOldAttr / SetEntityAttr / CalcEntityAttrSize estan en bank 0 / bank 2
 244+ 6D71              ; pero no paginan slot 3 -> tecnicamente el wrap _PageBank0 antes seria
 245+ 6D71              ; suficiente sin necesidad de _PageBank7 despues. Aun asi por consistencia
 246+ 6D71              ; con el patron usamos wrap completo.
 247+ 6D71              ;
 248+ 6D71              ; StartMusic pagina bank 4 internamente y restaura bank 0 -> wrap completo.
 249+ 6D71              ; ==============================================================================
 250+ 6D71
 251+ 6D71              DrawSprite_B7:                           ; IX = sprite ptr, D = Y, E = X
 252+ 6D71 CD 9E 6C         CALL _PageBank0
 253+ 6D74 CD EF 99         CALL DrawSprite
 254+ 6D77 C3 B0 6C         JP _PageBank7
 255+ 6D7A
 256+ 6D7A              GetSpriteAddr_B7:                        ; IX = entity ptr, OUT: SpriteAddrTemp
 257+ 6D7A CD 9E 6C         CALL _PageBank0
 258+ 6D7D CD F2 A4         CALL GetSpriteAddr
 259+ 6D80 C3 B0 6C         JP _PageBank7
 260+ 6D83
 261+ 6D83              GetOldSpriteAddr_B7:                     ; IX = entity ptr, OUT: OldSprAddr
 262+ 6D83 CD 9E 6C         CALL _PageBank0
 263+ 6D86 CD 23 A5         CALL GetOldSpriteAddr
 264+ 6D89 C3 B0 6C         JP _PageBank7
 265+ 6D8C
 266+ 6D8C              RestoreOldAttr_B7:                       ; D = Y, E = X
 267+ 6D8C CD 9E 6C         CALL _PageBank0
 268+ 6D8F CD 5D D3         CALL RestoreOldAttr
 269+ 6D92 C3 B0 6C         JP _PageBank7
 270+ 6D95
 271+ 6D95              SetEntityAttr_B7:                        ; D = Y, E = X, A = attr
 272+ 6D95 CD 9E 6C         CALL _PageBank0
 273+ 6D98 CD DF 9A         CALL SetEntityAttr
 274+ 6D9B C3 B0 6C         JP _PageBank7
 275+ 6D9E
 276+ 6D9E              CalcEntityAttrSize_B7:                   ; IX = sprite ptr
 277+ 6D9E CD 9E 6C         CALL _PageBank0
 278+ 6DA1 CD 0C 9B         CALL CalcEntityAttrSize
 279+ 6DA4 C3 B0 6C         JP _PageBank7
 280+ 6DA7
 281+ 6DA7              StartMusic_B7:                           ; A = track arg
 282+ 6DA7 CD 9E 6C         CALL _PageBank0
 283+ 6DAA CD C2 99         CALL StartMusic
 284+ 6DAD C3 B0 6C         JP _PageBank7
 285+ 6DB0
 286+ 6DB0              ; TownGatePlayerSlide* viven en slot 1 (no se mueven a bank 7 porque paginan
 287+ 6DB0              ; bank 6 internamente — si fueran bank 7 el OUT haria desaparecer el codigo
 288+ 6DB0              ; bajo sus pies). Pero al volver al body bank 7 dejan slot 3 = bank 0 ->
 289+ 6DB0              ; necesitan post-wrap.
 290+ 6DB0              TownGatePlayerSlideErase_B7:
 291+ 6DB0 CD 69 63         CALL TownGatePlayerSlideErase
 292+ 6DB3 C3 B0 6C         JP _PageBank7
 293+ 6DB6
 294+ 6DB6              TownGatePlayerSlideDraw_B7:
 295+ 6DB6 CD 9F 63         CALL TownGatePlayerSlideDraw
 296+ 6DB9 C3 B0 6C         JP _PageBank7
 297+ 6DBC
 298+ 6DBC              ; DrawBgGfxSpriteBlackTint_B7 - draw con CurrentTintVar=0 + BgSpriteIsHouse=0.
 299+ 6DBC              ; Para town_gate: open door + "The End" sprites usan tint negro (ApplyTintSwap
 300+ 6DBC              ; reemplaza paper con 0 = black). Distinto de DrawBgGfxSprite_B7 que pone
 301+ 6DBC              ; tint=$FF (sin swap, attr preservado) para la puerta del banco.
 302+ 6DBC              DrawBgGfxSpriteBlackTint_B7:
