 420+ A058              ; ==============================================================================
 421+ A058              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A058              ; ==============================================================================
 423+ A058              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A058              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A058              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A058              ; ==============================================================================
 427+ A058              ProcessEnemies:
 428+ A058 3E 00            LD A, 0
 429+ A05A 32 A3 A0         LD (.peCount), A
 430+ A05D 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A05F
 432+ A05F              .peLoop:
 433+ A05F C5               PUSH BC
 434+ A060
 435+ A060                  ; Calcular IX desde EnemyStepIdx
 436+ A060 3A 05 83         LD A, (EnemyStepIdx)
 437+ A063 C6 01            ADD A, SLOT_MONSTER0
 438+ A065 6F               LD L, A
 439+ A066 26 00            LD H, 0
 440+ A068 29               ADD HL, HL
 441+ A069 29               ADD HL, HL
 442+ A06A 29               ADD HL, HL
 443+ A06B 29               ADD HL, HL                          ; × ENT_SIZE (16)
 444+ A06C 11 9E 81         LD DE, EntityTable
 445+ A06F 19               ADD HL, DE
 446+ A070 E5               PUSH HL
 447+ A071 DD E1            POP IX
 448+ A073
 449+ A073                  ; Avanzar indice round-robin
 450+ A073 3A 05 83         LD A, (EnemyStepIdx)
 451+ A076 3C               INC A
 452+ A077 FE 09            CP NUM_MONSTERS + NUM_NASTIES
 453+ A079 38 01            JR C, .peNoWrap
 454+ A07B AF               XOR A
 455+ A07C              .peNoWrap:
 456+ A07C 32 05 83         LD (EnemyStepIdx), A
