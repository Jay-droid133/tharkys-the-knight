 617+ 6B9F              ; ==============================================================================
 618+ 6B9F              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 619+ 6B9F              ; ==============================================================================
 620+ 6B9F              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 621+ 6B9F              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 622+ 6B9F              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 623+ 6B9F              ;   2. Leer charX/charY de la entry
 624+ 6B9F              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 625+ 6B9F              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 626+ 6B9F              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 627+ 6B9F              ;   6. ChurchDoorOpen = 0
 628+ 6B9F              ; ==============================================================================
 629+ 6B9F              CloseChurchDoor:
 630+ 6B9F                  ; SFX "chof" del cierre — distinto del creak (SFX_ChurchDoorOpen) que
 631+ 6B9F                  ; usa la misma puerta al ABRIR. ABRIR = creak (madera girando con esfuerzo);
 632+ 6B9F                  ; CERRAR = chof (impacto contra el marco). SFX_DoorClose compartido con la
 633+ 6B9F                  ; cinematica del banco (HAND_OUT + HAND_OPEN_IN). Suena ANTES del cambio visual.
 634+ 6B9F 21 74 F8         LD HL, SFX_DoorClose
 635+ 6BA2 CD 50 F7         CALL PlaySFX
 636+ 6BA5 11 24 DF         LD DE, BgGfx_old_church_door_open
 637+ 6BA8 CD 32 6C         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 638+ 6BAB 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 639+ 6BAD                  ; Leer charX (HL+4) y charY (HL+5) en BC
 640+ 6BAD E5               PUSH HL                                 ; save mapX ptr
 641+ 6BAE 01 04 00         LD BC, 4
 642+ 6BB1 09               ADD HL, BC
 643+ 6BB2 46               LD B, (HL)                              ; B = charX
 644+ 6BB3 23               INC HL
 645+ 6BB4 4E               LD C, (HL)                              ; C = charY
 646+ 6BB5 E1               POP HL                                  ; HL = mapX ptr
 647+ 6BB6                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 648+ 6BB6 E5               PUSH HL
 649+ 6BB7 C5               PUSH BC
 650+ 6BB8 21 24 DF         LD HL, BgGfx_old_church_door_open
 651+ 6BBB 3E 03            LD A, 3
 652+ 6BBD CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
 653+ 6BC0 C1               POP BC
 654+ 6BC1 C5               PUSH BC
 655+ 6BC2 DD 21 F5 86      LD IX, BgSpriteBuffer
 656+ 6BC6 CD DD DB         CALL DrawBgSpriteXOR                    ; borra
 657+ 6BC9 C1               POP BC
 658+ 6BCA E1               POP HL
 659+ 6BCB                  ; --- Patch ptr: open -> closed ---
 660+ 6BCB 23               INC HL
 660+ 6BCC 23             INC HL                         ; -> ptr_lo
 661+ 6BCD 3E 6B            LD A, LOW BgGfx_old_church_door_closed
 662+ 6BCF 77               LD (HL), A
 663+ 6BD0 23               INC HL
 664+ 6BD1 3E DE            LD A, HIGH BgGfx_old_church_door_closed
 665+ 6BD3 77               LD (HL), A
 666+ 6BD4                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 667+ 6BD4 C5               PUSH BC
 668+ 6BD5 21 6B DE         LD HL, BgGfx_old_church_door_closed
 669+ 6BD8 3E 03            LD A, 3
 670+ 6BDA CD C2 6C         CALL LoadBgSpriteToBuffer
 671+ 6BDD C1               POP BC
 672+ 6BDE C5               PUSH BC
 673+ 6BDF DD 21 F5 86      LD IX, BgSpriteBuffer
 674+ 6BE3 CD DD DB         CALL DrawBgSpriteXOR
 675+ 6BE6 C1               POP BC
 676+ 6BE7 DD 21 F5 86      LD IX, BgSpriteBuffer
 677+ 6BEB AF               XOR A
 678+ 6BEC 32 D5 E2         LD (BgSpriteIsHouse), A
 679+ 6BEF CD 22 DC         CALL DrawBgAttrOnly
 680+ 6BF2              .ccdFlag:
 681+ 6BF2 AF               XOR A
 682+ 6BF3 32 B1 82         LD (ChurchDoorOpen), A
 683+ 6BF6 C9               RET
 684+ 6BF7
 685+ 6BF7              ; ==============================================================================
 686+ 6BF7              ; RespawnChurchKeyAtAlt - patch PickupTable entry de church_key con coords AltN
 687+ 6BF7              ; ==============================================================================
 688+ 6BF7              ; Lee ChurchKeyAltSpawnIdx (1 o 2) y patchea con CHURCH_KEY_ALT[1|2]_* coords.
 689+ 6BF7              ; ==============================================================================
 690+ 6BF7              RespawnChurchKeyAtAlt:
 691+ 6BF7 3A C1 82         LD A, (ChurchKeyAltSpawnIdx)
 692+ 6BFA FE 01            CP 1
 693+ 6BFC 28 05            JR Z, .rcaAlt1
 694+ 6BFE FE 02            CP 2
 695+ 6C00 28 0B            JR Z, .rcaAlt2
 696+ 6C02 C9               RET                                     ; estado raro, no hacer nada
 697+ 6C03              .rcaAlt1:
 698+ 6C03 06 0F            LD B, CHURCH_KEY_ALT1_SCREEN_X
 699+ 6C05 0E 06            LD C, CHURCH_KEY_ALT1_SCREEN_Y
 700+ 6C07 16 1A            LD D, CHURCH_KEY_ALT1_CHAR_X
 701+ 6C09 3E 03            LD A, CHURCH_KEY_ALT1_CHAR_Y
 702+ 6C0B 18 08            JR .rcaPatch
 703+ 6C0D              .rcaAlt2:
 704+ 6C0D 06 0F            LD B, CHURCH_KEY_ALT2_SCREEN_X
 705+ 6C0F 0E 06            LD C, CHURCH_KEY_ALT2_SCREEN_Y
 706+ 6C11 16 04            LD D, CHURCH_KEY_ALT2_CHAR_X
 707+ 6C13 3E 03            LD A, CHURCH_KEY_ALT2_CHAR_Y
 708+ 6C15              .rcaPatch:
 709+ 6C15 32 31 6C         LD (.rcaCharY), A
 710+ 6C18 C5               PUSH BC                                 ; preservar B=mapX, C=mapY
 711+ 6C19 D5               PUSH DE                                 ; preservar D=charX
 712+ 6C1A 11 EB D7         LD DE, BgGfx_church_key
 713+ 6C1D CD 32 6C         CALL FindPickupEntryByPtr               ; HL = mapX byte
 714+ 6C20 D1               POP DE
 715+ 6C21 C1               POP BC
 716+ 6C22 20 0C            JR NZ, .rcaSkip
 717+ 6C24 70               LD (HL), B                              ; mapX = AltN_SCREEN_X
 718+ 6C25 23               INC HL
 719+ 6C26 71               LD (HL), C                              ; mapY = AltN_SCREEN_Y
 720+ 6C27 23               INC HL
 720+ 6C28 23             INC HL
 720+ 6C29 23             INC HL                ; skip ptr_lo, ptr_hi
 721+ 6C2A 72               LD (HL), D                              ; charX = AltN_CHAR_X
 722+ 6C2B 23               INC HL
 723+ 6C2C 3A 31 6C         LD A, (.rcaCharY)
 724+ 6C2F 77               LD (HL), A                              ; charY = AltN_CHAR_Y
 725+ 6C30              .rcaSkip:
 726+ 6C30 C9               RET
 727+ 6C31 00           .rcaCharY: DEFB 0
 728+ 6C32
 729+ 6C32              ; ==============================================================================
 730+ 6C32              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
 731+ 6C32              ; ==============================================================================
 732+ 6C32              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
 733+ 6C32              ; comparando ptr_lo/ptr_hi con DE.
 734+ 6C32              ; IN:  DE = ptr buscado.
 735+ 6C32              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
 736+ 6C32              ; Destruye: AF.
 737+ 6C32              ; ==============================================================================
 738+ 6C32              FindPickupEntryByPtr:
 739+ 6C32 21 23 DF         LD HL, PickupTable
 740+ 6C35              .fpeLoop:
 741+ 6C35 7E               LD A, (HL)
 742+ 6C36 FE FF            CP $FF
 743+ 6C38 28 18            JR Z, .fpeNotFound
 744+ 6C3A E5               PUSH HL
 745+ 6C3B 23               INC HL
 745+ 6C3C 23             INC HL                         ; -> ptr_lo
 746+ 6C3D 7E               LD A, (HL)
 747+ 6C3E BB               CP E
 748+ 6C3F 20 08            JR NZ, .fpeNoMatch
 749+ 6C41 23               INC HL
 750+ 6C42 7E               LD A, (HL)
 751+ 6C43 BA               CP D
 752+ 6C44 20 03            JR NZ, .fpeNoMatch
 753+ 6C46 E1               POP HL
 754+ 6C47 AF               XOR A                                   ; Z = encontrado
 755+ 6C48 C9               RET
 756+ 6C49              .fpeNoMatch:
 757+ 6C49 E1               POP HL
 758+ 6C4A C5               PUSH BC
 759+ 6C4B 01 07 00         LD BC, 7
 760+ 6C4E 09               ADD HL, BC
 761+ 6C4F C1               POP BC
 762+ 6C50 18 E3            JR .fpeLoop
 763+ 6C52              .fpeNotFound:
 764+ 6C52 F6 01            OR 1                                    ; NZ
 765+ 6C54 C9               RET
 766+ 6C55
# file closed: church_cutscene.asm
 138  6C55
 139  6C55                  ; --- Rutinas de paginacion (paging.asm) ---
 140  6C55                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 141  6C55                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 142  6C55                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 143  6C55                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 144  6C55                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 145  6C55                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 146  6C55                  ; criterio (siempre visible) pero contended.
 147  6C55                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 148  6C55                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 149  6C55                  ; el inner loop, asi que el overhead es invisible.
 150  6C55                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 6C55              ; ==============================================================================
   2+ 6C55              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6C55              ; ==============================================================================
   4+ 6C55              ; Port $7FFD (write-only):
   5+ 6C55              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6C55              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6C55              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6C55              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6C55              ;
  10+ 6C55              ; Bancos disponibles:
  11+ 6C55              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6C55              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6C55              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6C55              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6C55              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6C55              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6C55              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6C55              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6C55              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6C55              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6C55              ; ==============================================================================
  22+ 6C55
  23+ 6C55              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6C55              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6C55
  26+ 6C55              ; ==============================================================================
  27+ 6C55              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6C55              ; ==============================================================================
  29+ 6C55              ; Entrada: A = banco (0-7)
  30+ 6C55              ; Preserva: HL, DE, IX, IY
  31+ 6C55              ; Destruye: A, BC
  32+ 6C55              ; ==============================================================================
  33+ 6C55              PageBankSlot3:
  34+ 6C55 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6C57 47               LD B, A                     ; guardar banco nuevo
  36+ 6C58 3A 82 8D         LD A, (CurrentPaging)
  37+ 6C5B E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6C5D B0               OR B                        ; poner nuevo banco
  39+ 6C5E 32 82 8D         LD (CurrentPaging), A
  40+ 6C61 01 FD 7F         LD BC, $7FFD
  41+ 6C64 ED 79            OUT (C), A
  42+ 6C66 C9               RET
  43+ 6C67
  44+ 6C67              ; ==============================================================================
  45+ 6C67              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6C67              ; ==============================================================================
  47+ 6C67              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6C67              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6C67              ; ==============================================================================
  50+ 6C67              InitPaging:
  51+ 6C67 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6C69 32 82 8D         LD (CurrentPaging), A
  53+ 6C6C 01 FD 7F         LD BC, $7FFD
  54+ 6C6F ED 79            OUT (C), A
  55+ 6C71 C9               RET
  56+ 6C72
  57+ 6C72              ; ==============================================================================
  58+ 6C72              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6C72              ; ==============================================================================
  60+ 6C72              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6C72              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6C72              ;      Paginacion restaurada a bank 0.
  63+ 6C72              ; Destruye: A, BC, DE, HL
  64+ 6C72              ;
  65+ 6C72              ; Formato del room en FUENTE (variable-length):
  66+ 6C72              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6C72              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6C72              ;   terminador:                  DEFB $FF
  69+ 6C72              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6C72              ;
  71+ 6C72              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6C72              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6C72              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6C72              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6C72              ; ==============================================================================
  76+ 6C72              LoadRoomToBuffer:
  77+ 6C72                  ; El stack normal vive en slot 3 ($FF58). Mientras paginamos slot 3 al
  78+ 6C72                  ; bank de datos, el stack normal queda fisicamente "oculto" (pero intacto
  79+ 6C72                  ; en bank 0). Si una IRQ entra durante el LDIR, su PUSH PC iria al bank
  80+ 6C72                  ; de datos -> corrupcion del room data que estamos leyendo.
  81+ 6C72                  ;
  82+ 6C72                  ; Solucion: cambiar SP a un buffer alterno en slot 1 (siempre visible)
  83+ 6C72                  ; durante la copia. Asi las IRQs siguen procesandose normalmente y el
  84+ 6C72                  ; tick de musica no pierde frames durante DrawScreen / transiciones.
  85+ 6C72                  ;
  86+ 6C72                  ; INLINEAMOS el page-switch (sin CALL intermedios) porque al inicio el
  87+ 6C72                  ; SP aun apunta al stack normal con la PC del CALL pushed; un CALL aqui
  88+ 6C72                  ; usaria stack normal y no podriamos garantizar atomicidad.
  89+ 6C72 ED 73 C0 6C      LD (.lrbSavedSP), SP            ; salva SP normal (con PC + caller frame)
  90+ 6C76 31 CE 6D         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
  91+ 6C79                  ; --- Page bank 1 en slot 3 (inline, SIN DI) ---
  92+ 6C79 3A 82 8D         LD A, (CurrentPaging)
  93+ 6C7C E6 F8            AND $F8
  94+ 6C7E F6 01            OR 1
  95+ 6C80 32 82 8D         LD (CurrentPaging), A
  96+ 6C83 01 FD 7F         LD BC, $7FFD
  97+ 6C86 ED 79            OUT (C), A                      ; slot 3 = bank 1
  98+ 6C88                  ; --- Copy + decompress loop ---
  99+ 6C88                  ; HL = source (Room_Txx en bank 1, formato variable)
 100+ 6C88                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
 101+ 6C88 11 F5 85         LD DE, CurrentScreenBuffer
 102+ 6C8B              .lrbLoop:
 103+ 6C8B 7E               LD A, (HL)                      ; id
 104+ 6C8C 12               LD (DE), A
 105+ 6C8D 23               INC HL
 106+ 6C8E 13               INC DE
 107+ 6C8F FE FF            CP $FF                          ; terminador?
 108+ 6C91 28 1B            JR Z, .lrbDone
 109+ 6C93                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 110+ 6C93                  ; al buffer escribimos x limpio (AND $7F).
 111+ 6C93 7E               LD A, (HL)
 112+ 6C94 23               INC HL
 113+ 6C95 47               LD B, A                         ; B = x raw (con flag)
 114+ 6C96 E6 7F            AND $7F
 115+ 6C98 12               LD (DE), A                      ; buffer: x limpio 0-31
 116+ 6C99 13               INC DE
 117+ 6C9A                  ; Copiar y
 118+ 6C9A 7E               LD A, (HL)
 119+ 6C9B 12               LD (DE), A
 120+ 6C9C 23               INC HL
 121+ 6C9D 13               INC DE
 122+ 6C9E                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 123+ 6C9E CB 78            BIT 7, B
 124+ 6CA0 28 06            JR Z, .lrbNoTint
 125+ 6CA2 7E               LD A, (HL)                      ; v desde source
 126+ 6CA3 23               INC HL
 127+ 6CA4 12               LD (DE), A
 128+ 6CA5 13               INC DE
 129+ 6CA6 18 E3            JR .lrbLoop
 130+ 6CA8              .lrbNoTint:
 131+ 6CA8 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 132+ 6CAA 12               LD (DE), A
 133+ 6CAB 13               INC DE
 134+ 6CAC 18 DD            JR .lrbLoop
 135+ 6CAE              .lrbDone:
 136+ 6CAE                  ; --- Page bank 0 en slot 3 (inline) ---
 137+ 6CAE 3A 82 8D         LD A, (CurrentPaging)
 138+ 6CB1 E6 F8            AND $F8                         ; bank 0
 139+ 6CB3 32 82 8D         LD (CurrentPaging), A
 140+ 6CB6 01 FD 7F         LD BC, $7FFD
 141+ 6CB9 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack normal accesible
 142+ 6CBB ED 7B C0 6C      LD SP, (.lrbSavedSP)            ; restaurar SP al stack normal
 143+ 6CBF C9               RET
 144+ 6CC0
 145+ 6CC0 00 00        .lrbSavedSP: DEFW 0
 146+ 6CC2
 147+ 6CC2              ; ==============================================================================
 148+ 6CC2              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 149+ 6CC2              ; ==============================================================================
 150+ 6CC2              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 151+ 6CC2              ;      A  = bank (0-7) donde vive el sprite
 152+ 6CC2              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 153+ 6CC2              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 154+ 6CC2              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 155+ 6CC2              ;
 156+ 6CC2              ; Mismo patron que LoadRoomToBuffer: inline page switch + SP alterno (slot 1)
 157+ 6CC2              ; durante la copia. IRQs siguen procesandose normalmente -> tick de musica
 158+ 6CC2              ; no se desfasa durante DrawScreen. Sin DI/EI internos.
 159+ 6CC2              ;
 160+ 6CC2              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 161+ 6CC2              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 162+ 6CC2              ; ==============================================================================
 163+ 6CC2              LoadBgSpriteToBuffer:
 164+ 6CC2                  ; Mismo patron que LoadRoomToBuffer: SP -> alterno antes del page switch
 165+ 6CC2                  ; para que las IRQs durante la copia no corrompan el stack normal (que
 166+ 6CC2                  ; queda fisicamente "oculto" mientras slot 3 = bank de sprite).
 167+ 6CC2 32 54 6D         LD (.lbsBankSave), A
 168+ 6CC5                  ; Preservar BC del caller (DrawScreen usa B=x_char, C=y_char) ANTES de
 169+ 6CC5                  ; cambiar SP — el PUSH va al stack normal. El LD SP siguiente preserva
 170+ 6CC5                  ; ese frame; al restaurar SP el POP BC final lo recupera.
 171+ 6CC5 C5               PUSH BC
 172+ 6CC6 ED 73 55 6D      LD (.lbsSavedSP), SP            ; salva SP normal (con PC + BC pushed)
 173+ 6CCA 31 CE 6D         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
 174+ 6CCD                  ; Page bank deseado inline (SIN DI)
 175+ 6CCD 3A 82 8D         LD A, (CurrentPaging)
 176+ 6CD0 E6 F8            AND $F8
 177+ 6CD2 47               LD B, A                         ; B = paging limpio sin bank
 178+ 6CD3 3A 54 6D         LD A, (.lbsBankSave)
 179+ 6CD6 E6 07            AND $07                         ; safety: solo bits 0-2
 180+ 6CD8 B0               OR B                            ; merge bank en paging
 181+ 6CD9 32 82 8D         LD (CurrentPaging), A
 182+ 6CDC 01 FD 7F         LD BC, $7FFD
 183+ 6CDF ED 79            OUT (C), A
 184+ 6CE1                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 185+ 6CE1                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 186+ 6CE1                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 187+ 6CE1                  ; Si no → calcular bytes exactos y copiar byte a byte.
 188+ 6CE1 11 F5 86         LD DE, BgSpriteBuffer
 189+ 6CE4                  ; Copiar H (header byte 0)
 190+ 6CE4 7E               LD A, (HL)
 191+ 6CE5 12               LD (DE), A
 192+ 6CE6 32 52 6D         LD (.lbsHsave), A
 193+ 6CE9 23               INC HL
 194+ 6CEA 13               INC DE
 195+ 6CEB                  ; Copiar W|RLE (header byte 1)
 196+ 6CEB 7E               LD A, (HL)
 197+ 6CEC 12               LD (DE), A
 198+ 6CED 23               INC HL
 199+ 6CEE 13               INC DE
 200+ 6CEF CB 7F            BIT 7, A
 201+ 6CF1 20 47            JR NZ, .lbsRleFallback
 202+ 6CF3 E6 7F            AND $7F
 203+ 6CF5 32 53 6D         LD (.lbsWsave), A
 204+ 6CF8                  ; --- Copiar H filas de W bytes de pixeles ---
 205+ 6CF8 3A 52 6D         LD A, (.lbsHsave)
 206+ 6CFB B7               OR A
 207+ 6CFC 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 208+ 6CFE 47               LD B, A                         ; B = H (outer loop)
 209+ 6CFF              .lbsPixRow:
 210+ 6CFF 3A 53 6D         LD A, (.lbsWsave)
 211+ 6D02 B7               OR A
 212+ 6D03 28 08            JR Z, .lbsPixRowDone
 213+ 6D05 4F               LD C, A                         ; C = W (inner loop)
 214+ 6D06              .lbsPixCol:
 215+ 6D06 7E               LD A, (HL)
 216+ 6D07 12               LD (DE), A
 217+ 6D08 23               INC HL
 218+ 6D09 13               INC DE
 219+ 6D0A 0D               DEC C
 220+ 6D0B 20 F9            JR NZ, .lbsPixCol
 221+ 6D0D              .lbsPixRowDone:
 222+ 6D0D 10 F0            DJNZ .lbsPixRow
 223+ 6D0F              .lbsAfterPixels:
 224+ 6D0F                  ; --- Copiar 1 byte tint ---
 225+ 6D0F 7E               LD A, (HL)
 226+ 6D10 12               LD (DE), A
 227+ 6D11 23               INC HL
 228+ 6D12 13               INC DE
 229+ 6D13                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 230+ 6D13 7E               LD A, (HL)
 231+ 6D14 12               LD (DE), A
 232+ 6D15 32 52 6D         LD (.lbsHsave), A               ; reusar var
 233+ 6D18 23               INC HL
 234+ 6D19 13               INC DE
 235+ 6D1A 7E               LD A, (HL)
 236+ 6D1B 12               LD (DE), A
 237+ 6D1C 32 53 6D         LD (.lbsWsave), A
 238+ 6D1F 23               INC HL
 239+ 6D20 13               INC DE
 240+ 6D21 3A 52 6D         LD A, (.lbsHsave)
 241+ 6D24 B7               OR A
 242+ 6D25 28 18            JR Z, .lbsLoadDone              ; sin attrs
 243+ 6D27 47               LD B, A
 244+ 6D28              .lbsAttrRow:
 245+ 6D28 3A 53 6D         LD A, (.lbsWsave)
 246+ 6D2B B7               OR A
 247+ 6D2C 28 08            JR Z, .lbsAttrRowDone
 248+ 6D2E 4F               LD C, A
 249+ 6D2F              .lbsAttrCol:
 250+ 6D2F 7E               LD A, (HL)
 251+ 6D30 12               LD (DE), A
 252+ 6D31 23               INC HL
 253+ 6D32 13               INC DE
 254+ 6D33 0D               DEC C
 255+ 6D34 20 F9            JR NZ, .lbsAttrCol
 256+ 6D36              .lbsAttrRowDone:
 257+ 6D36 10 F0            DJNZ .lbsAttrRow
 258+ 6D38 18 05            JR .lbsLoadDone
 259+ 6D3A
 260+ 6D3A              .lbsRleFallback:
 261+ 6D3A                  ; Sprite RLE: tamaño desconocido sin parsear, copia BG_SPRITE_BUFFER_SIZE-2
 262+ 6D3A 01 3E 03         LD BC, BG_SPRITE_BUFFER_SIZE - 2
 263+ 6D3D ED B0            LDIR
 264+ 6D3F
 265+ 6D3F              .lbsLoadDone:
 266+ 6D3F                  ; Page bank 0 inline
 267+ 6D3F 3A 82 8D         LD A, (CurrentPaging)
 268+ 6D42 E6 F8            AND $F8
 269+ 6D44 32 82 8D         LD (CurrentPaging), A
 270+ 6D47 01 FD 7F         LD BC, $7FFD
 271+ 6D4A ED 79            OUT (C), A
 272+ 6D4C ED 7B 55 6D      LD SP, (.lbsSavedSP)            ; restaurar SP al stack normal
 273+ 6D50 C1               POP BC                          ; restaurar BC del caller (estaba en stack normal)
 274+ 6D51 C9               RET
 275+ 6D52
 276+ 6D52 00           .lbsHsave:    DEFB 0
 277+ 6D53 00           .lbsWsave:    DEFB 0
 278+ 6D54 00           .lbsBankSave: DEFB 0
 279+ 6D55 00 00        .lbsSavedSP:  DEFW 0
 280+ 6D57
 281+ 6D57              ; ==============================================================================
 282+ 6D57              ; LoadPlazaClockPixels - Copia los 32 B de pixel data del reloj de plaza a RAM fija
 283+ 6D57              ; ==============================================================================
 284+ 6D57              ; Se llama una vez al cargar pantalla cuando se detecta BgGfx_reloj_plaza.
 285+ 6D57              ; DrawPlazaClock lee PlazaClockPixels cada frame sin tocar paginacion.
 286+ 6D57              ; ==============================================================================
 287+ 6D57              LoadPlazaClockPixels:
 288+ 6D57                  ; Mismo patron que LoadRoomToBuffer/LoadBgSpriteToBuffer: SP alterno en
 289+ 6D57                  ; slot 1 durante la copia para no enmascarar IRQs.
 290+ 6D57 C5               PUSH BC
 291+ 6D58 ED 73 8C 6D      LD (.lpcpSavedSP), SP
 292+ 6D5C 31 CE 6D         LD SP, PagingAltStackTop
 293+ 6D5F                  ; Page bank 3 inline (SIN DI)
 294+ 6D5F 3A 82 8D         LD A, (CurrentPaging)
 295+ 6D62 E6 F8            AND $F8
 296+ 6D64 F6 03            OR 3
 297+ 6D66 32 82 8D         LD (CurrentPaging), A
 298+ 6D69 01 FD 7F         LD BC, $7FFD
 299+ 6D6C ED 79            OUT (C), A
 300+ 6D6E                  ; Copia 32 bytes (16 rows * 2 bytes) desde BgGfx_reloj_plaza+2
 301+ 6D6E 21 A7 CC         LD HL, BgGfx_reloj_plaza + 2
 302+ 6D71 11 35 8A         LD DE, PlazaClockPixels
 303+ 6D74 01 20 00         LD BC, 32
 304+ 6D77 ED B0            LDIR
 305+ 6D79                  ; Page bank 0 inline
 306+ 6D79 3A 82 8D         LD A, (CurrentPaging)
 307+ 6D7C E6 F8            AND $F8
 308+ 6D7E 32 82 8D         LD (CurrentPaging), A
 309+ 6D81 01 FD 7F         LD BC, $7FFD
 310+ 6D84 ED 79            OUT (C), A
 311+ 6D86 ED 7B 8C 6D      LD SP, (.lpcpSavedSP)
 312+ 6D8A C1               POP BC
 313+ 6D8B C9               RET
 314+ 6D8C
 315+ 6D8C 00 00        .lpcpSavedSP: DEFW 0
 316+ 6D8E
 317+ 6D8E              ; ==============================================================================
 318+ 6D8E              ; PagingAltStack - Stack alterno en slot 1 para Load*ToBuffer
 319+ 6D8E              ; ==============================================================================
 320+ 6D8E              ; Se usa cuando LoadRoomToBuffer / LoadBgSpriteToBuffer / LoadPlazaClockPixels
 321+ 6D8E              ; paginan slot 3 al bank de datos. Mientras dura la copia, SP apunta aqui en
 322+ 6D8E              ; vez de al stack normal (que vive en slot 3 = bank de datos en ese momento).
 323+ 6D8E              ; Asi una IRQ entrante hace PUSH PC al alterno (slot 1, bank fijo) y el
 324+ 6D8E              ; handler IRQ corre sin corromper los bytes del bank de datos que estamos
 325+ 6D8E              ; leyendo. Resultado: las transiciones de pantalla ya no enmascaran IRQs ->
 326+ 6D8E              ; el tick de musica a 25 Hz se mantiene exacto incluso durante DrawScreen.
 327+ 6D8E              ;
 328+ 6D8E              ; Tamano: 64 B = 32 niveles de PUSH. Pico real medido del handler IRQ:
 329+ 6D8E              ;   PUSH PC (IRQ accept) + 4 PUSHes handler + 5-6 PUSH PC anidados en la
 330+ 6D8E              ;   cadena AY_UpdatePlayerHit / upmiTickOnce->MusicAdvanceNote->AY_WriteRegSlot1
 331+ 6D8E              ;   + algun PUSH HL en .map2NoteA  ~=  22 B pico. 64 B = 3x margen.
 332+ 6D8E              ; ==============================================================================
 333+ 6D8E 00 00 00...  PagingAltStack: DEFS 64, 0
 334+ 6DCE              PagingAltStackTop EQU PagingAltStack + 64
 335+ 6DCE
# file closed: paging.asm
 151  6DCE
 152  6DCE                  ; --- Tumbas persistentes (tombstones.asm) ---
 153  6DCE                  ; TombStore + DrawTombstonesInRoom. Usan inline page switch como
 154  6DCE                  ; LoadBgSpriteToBuffer para acceder al storage en bank 7 ($E000+).
 155  6DCE                  ; Cold path: muerte del player + carga de pantalla. Coste invisible.
 156  6DCE                  INCLUDE "tombstones.asm"
# file opened: tombstones.asm
   1+ 6DCE              ; ==============================================================================
   2+ 6DCE              ; TOMBSTONES - Tumbas persistentes en el mundo donde el player muere
   3+ 6DCE              ; ==============================================================================
   4+ 6DCE              ; Storage: bank 7 a $E000, 800 bytes (200 entradas x 4 bytes cada una).
   5+ 6DCE              ; Layout por entrada: DEFB roomX, roomY, posX, posY  (todos 8-bit).
   6+ 6DCE              ; TombstoneCount (1 byte, 0..200) en bank 2 (variables.asm, siempre visible).
   7+ 6DCE              ;
   8+ 6DCE              ; Vive en slot 1 ($6000+) tras paging.asm: las rutinas hacen el page switch
   9+ 6DCE              ; siguiendo el patron de LoadBgSpriteToBuffer (DI durante la ventana, IFF
  10+ 6DCE              ; tracking via StartupComplete, no CALLs/PUSH/POP entre los OUT).
  11+ 6DCE              ;
  12+ 6DCE              ; Cold paths: TombStore se llama 1 vez por muerte; DrawTombstonesInRoom al
  13+ 6DCE              ; cargar pantalla. Coste invisible.
  14+ 6DCE              ; ==============================================================================
  15+ 6DCE
  16+ 6DCE              TOMBSTONE_MAX     EQU 200
  17+ 6DCE              TOMBSTONE_BYTES   EQU 4
  18+ 6DCE              TOMBSTONE_BANK    EQU 7
  19+ 6DCE              TOMBSTONE_ADDR    EQU $E000
  20+ 6DCE              SPRID_TOMBSTONE   EQU 252
  21+ 6DCE
  22+ 6DCE              ; ==============================================================================
  23+ 6DCE              ; TombStore - Anade una tumba en la sala/posicion actual del player muerto
  24+ 6DCE              ; ==============================================================================
  25+ 6DCE              ; Lee CurrentScreenX/Y + EntityTable[player].POSX/POSY. Si TombstoneCount<MAX,
  26+ 6DCE              ; escribe entry en bank 7 y bumpea el contador. No-op si tope alcanzado.
  27+ 6DCE              ; Destruye: A, BC, DE, HL.
  28+ 6DCE              ; ==============================================================================
  29+ 6DCE              TombStore:
  30+ 6DCE 3A F3 82         LD A, (TombstoneCount)
  31+ 6DD1 FE C8            CP TOMBSTONE_MAX
  32+ 6DD3 D0               RET NC                                  ; tope alcanzado
  33+ 6DD4
  34+ 6DD4                  ; HL = TOMBSTONE_ADDR + count * 4
  35+ 6DD4 26 00            LD H, 0
  36+ 6DD6 6F               LD L, A
  37+ 6DD7 29               ADD HL, HL                              ; *2
  38+ 6DD8 29               ADD HL, HL                              ; *4
  39+ 6DD9 11 00 E0         LD DE, TOMBSTONE_ADDR
  40+ 6DDC 19               ADD HL, DE                              ; HL = slot a escribir (bank 7)
  41+ 6DDD
  42+ 6DDD F3               DI
  43+ 6DDE                  ; --- Page bank 7 en slot 3 (inline; no CALL — stack vive en slot 3) ---
  44+ 6DDE 3A 82 8D         LD A, (CurrentPaging)
  45+ 6DE1 E6 F8            AND $F8
  46+ 6DE3 F6 07            OR TOMBSTONE_BANK
  47+ 6DE5 32 82 8D         LD (CurrentPaging), A
  48+ 6DE8 01 FD 7F         LD BC, $7FFD
  49+ 6DEB ED 79            OUT (C), A
  50+ 6DED
  51+ 6DED                  ; --- Escribir 4 bytes (sin PUSH/POP/CALL: stack vive en bank 7 ahora) ---
  52+ 6DED 3A 08 83         LD A, (CurrentScreenX)
  53+ 6DF0 77               LD (HL), A
  54+ 6DF1 23               INC HL
  55+ 6DF2 3A 09 83         LD A, (CurrentScreenY)
  56+ 6DF5 77               LD (HL), A
  57+ 6DF6 23               INC HL
  58+ 6DF7 3A 9E 81         LD A, (EntityTable + ENT_POSX)
  59+ 6DFA 77               LD (HL), A
  60+ 6DFB 23               INC HL
  61+ 6DFC 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  62+ 6DFF 77               LD (HL), A
  63+ 6E00
  64+ 6E00                  ; --- Page bank 0 ---
