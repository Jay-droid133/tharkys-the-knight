1155+ F5C6              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1156+ F5C6              .ucsShakeStatuePhase:
1157+ F5C6 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1158+ F5C9 FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1159+ F5CB 30 35            JR NC, .ucsShakeStatueDone
1160+ F5CD                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1161+ F5CD                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1162+ F5CD                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1163+ F5CD                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1164+ F5CD                  ;
1165+ F5CD                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1166+ F5CD                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1167+ F5CD ED 5F            LD A, R
1168+ F5CF E6 03            AND $03
1169+ F5D1 21 FE F5         LD HL, .ucsShakeJitterTable
1170+ F5D4 5F               LD E, A
1171+ F5D5 16 00            LD D, 0
1172+ F5D7 19               ADD HL, DE
1173+ F5D8 7E               LD A, (HL)
1174+ F5D9 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1175+ F5DA                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1176+ F5DA 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1177+ F5DD FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
