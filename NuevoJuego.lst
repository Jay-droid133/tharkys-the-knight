 441+ DF04              ; ---- Phase 17: WAIT_NASTIES ----
 442+ DF04              ; Espera a que terminen los puffs de nasties + death antes de entrar a LOCK.
 443+ DF04              ; ProcessEnemies + ProcessDeath se mantienen corriendo desde MainLoop
 444+ DF04              ; ramifica especial. Re-llama a KillAllActiveNasties cada frame para cazar
 445+ DF04              ; nasties que estaban en STATE_SPAWNING al disparar trigger.
 446+ DF04              ;
 447+ DF04              ; Transicion: cuando TownGateAllNastiesDeadCheck devuelve Z (todos los
 448+ DF04              ; slots NASTY = TYPE_NONE) → setup LOCK con timer + RET. Si tarda demasiado
 449+ DF04              ; (timeout BCS_T_PUFF_WAIT), tambien transiciona (safety net).
 450+ DF04              .bcPhWaitNasties:
 451+ DF04 CD 66 6D         CALL KillAllActiveNasties_B7           ; cazar spawnings recien terminados
 452+ DF07 CD 22 63         CALL TownGateAllNastiesDeadCheck    ; reusa label (slot 1 always-vis)
 453+ DF0A 28 04            JR Z, .bcWaitNastiesDone
 454+ DF0C CD 10 E2         CALL BankCutsceneDecTimer           ; safety timeout
 455+ DF0F C0               RET NZ
 456+ DF10              .bcWaitNastiesDone:
 457+ DF10 CD 1F DE         CALL BankCutsceneSnapToDoor         ; player se acerca a la puerta para LOCK + KNOCKS_1
 458+ DF13 3E 1E            LD A, BCS_T_LOCK
 459+ DF15 32 D2 82         LD (BankCutsceneTimer), A
 460+ DF18 3E 01            LD A, BCP_LOCK
 461+ DF1A 32 D1 82         LD (BankCutscenePhase), A
 462+ DF1D C9               RET
 463+ DF1E
 464+ DF1E              ; ---- Phase 1: lock + facing UP ----
 465+ DF1E              .bcPhLock:
 466+ DF1E CD 10 E2         CALL BankCutsceneDecTimer
 467+ DF21 C0               RET NZ
 468+ DF22                  ; Iniciar grupo 1: 3 toques (knock type SOFT).
 469+ DF22 AF               XOR A
 470+ DF23 32 D4 82         LD (BankCutsceneKnockIdx), A
 471+ DF26 32 D7 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 472+ DF29 3E 00            LD A, BCS_KNOCK_HIT
 473+ DF2B 32 D3 82         LD (BankCutsceneSubState), A
 474+ DF2E 3E 04            LD A, BCS_T_KNOCK_HIT
 475+ DF30 32 D2 82         LD (BankCutsceneTimer), A
 476+ DF33 CD 98 E1         CALL BankCutsceneEmitKnockHit       ; primer toque inmediato
 477+ DF36 3E 02            LD A, BCP_KNOCKS_1
 478+ DF38 32 D1 82         LD (BankCutscenePhase), A
 479+ DF3B C9               RET
 480+ DF3C
 481+ DF3C              ; ---- Phase 2: 3 toques (KNOCKS_1) ----
 482+ DF3C              ; Estructura comun para los 3 grupos: BankCutsceneTickKnockGroup hace
 483+ DF3C              ; el trabajo (tick timer + transicion HIT/GAP, increment KnockIdx).
 484+ DF3C              ; Devuelve A = 1 si grupo terminado, 0 si sigue.
 485+ DF3C              .bcPhKnocks1:
 486+ DF3C 3E 03            LD A, BCS_GROUP1_KNOCKS
 487+ DF3E CD 5D E1         CALL BankCutsceneTickKnockGroup
 488+ DF41 B7               OR A
 489+ DF42 C8               RET Z                               ; sigue
 490+ DF43                  ; grupo 1 terminado → retirarse a ORIG + wait
 491+ DF43 CD 45 DE         CALL BankCutsceneSnapToRetreat
 492+ DF46 3E 32            LD A, BCS_T_GROUP_WAIT
 493+ DF48 32 D2 82         LD (BankCutsceneTimer), A
 494+ DF4B 3E 03            LD A, BCP_WAIT_1
 495+ DF4D 32 D1 82         LD (BankCutscenePhase), A
 496+ DF50 C9               RET
 497+ DF51
 498+ DF51              ; ---- Phase 3: WAIT_1 (espera silenciosa) ----
 499+ DF51              .bcPhWait1:
 500+ DF51 CD 10 E2         CALL BankCutsceneDecTimer
 501+ DF54 C0               RET NZ
 502+ DF55                  ; Iniciar grupo 2: snap a DOOR + setup knock loop (type SOFT).
 503+ DF55 CD 1F DE         CALL BankCutsceneSnapToDoor
 504+ DF58 AF               XOR A
 505+ DF59 32 D4 82         LD (BankCutsceneKnockIdx), A
 506+ DF5C 32 D7 82         LD (BankCutsceneKnockType), A       ; 0 = soft
 507+ DF5F 3E 00            LD A, BCS_KNOCK_HIT
 508+ DF61 32 D3 82         LD (BankCutsceneSubState), A
 509+ DF64 3E 04            LD A, BCS_T_KNOCK_HIT
 510+ DF66 32 D2 82         LD (BankCutsceneTimer), A
 511+ DF69 CD 98 E1         CALL BankCutsceneEmitKnockHit
 512+ DF6C 3E 04            LD A, BCP_KNOCKS_2
 513+ DF6E 32 D1 82         LD (BankCutscenePhase), A
 514+ DF71 C9               RET
 515+ DF72
 516+ DF72              ; ---- Phase 4: 3 toques (KNOCKS_2) ----
 517+ DF72              .bcPhKnocks2:
 518+ DF72 3E 03            LD A, BCS_GROUP2_KNOCKS
 519+ DF74 CD 5D E1         CALL BankCutsceneTickKnockGroup
 520+ DF77 B7               OR A
 521+ DF78 C8               RET Z
 522+ DF79                  ; grupo 2 terminado → retirarse a ORIG + wait
 523+ DF79 CD 45 DE         CALL BankCutsceneSnapToRetreat
 524+ DF7C 3E 32            LD A, BCS_T_GROUP_WAIT
 525+ DF7E 32 D2 82         LD (BankCutsceneTimer), A
 526+ DF81 3E 05            LD A, BCP_WAIT_2
 527+ DF83 32 D1 82         LD (BankCutscenePhase), A
 528+ DF86 C9               RET
 529+ DF87
 530+ DF87              ; ---- Phase 5: WAIT_2 ----
 531+ DF87              .bcPhWait2:
 532+ DF87 CD 10 E2         CALL BankCutsceneDecTimer
 533+ DF8A C0               RET NZ
 534+ DF8B                  ; Player gira a S (cara camara).
 535+ DF8B DD 21 A3 81      LD IX, EntityTable
 536+ DF8F 3E 00            LD A, SPRID_IDLE                    ; idle = sprite mirando S
 537+ DF91 DD 77 00         LD (IX+ENT_SPRITEID), A
 538+ DF94 DD 77 08         LD (IX+ENT_ANIMBASE), A
 539+ DF97 AF               XOR A
 540+ DF98 DD 77 09         LD (IX+ENT_ANIMTIMER), A
 541+ DF9B CD 57 6D         CALL TownGateRedrawPlayer_B7
 542+ DF9E 3E 28            LD A, BCS_T_TURN_CAM
 543+ DFA0 32 D2 82         LD (BankCutsceneTimer), A
 544+ DFA3 3E 06            LD A, BCP_TURN_TO_CAM
 545+ DFA5 32 D1 82         LD (BankCutscenePhase), A
 546+ DFA8 C9               RET
 547+ DFA9
 548+ DFA9              ; ---- Phase 6: player mirando camara mid-cutscene ----
 549+ DFA9              .bcPhTurnToCam:
 550+ DFA9 CD 10 E2         CALL BankCutsceneDecTimer
 551+ DFAC C0               RET NZ
 552+ DFAD                  ; Player vuelve a N (cara puerta).
 553+ DFAD DD 21 A3 81      LD IX, EntityTable
 554+ DFB1 3E 0B            LD A, SPRID_WALK_N + 1              ; pose static walk-N
 555+ DFB3 DD 77 00         LD (IX+ENT_SPRITEID), A
 556+ DFB6 3E 0A            LD A, SPRID_WALK_N
 557+ DFB8 DD 77 08         LD (IX+ENT_ANIMBASE), A
 558+ DFBB AF               XOR A
 559+ DFBC DD 77 09         LD (IX+ENT_ANIMTIMER), A
 560+ DFBF CD 57 6D         CALL TownGateRedrawPlayer_B7
 561+ DFC2 3E 0A            LD A, BCS_T_TURN_BACK
 562+ DFC4 32 D2 82         LD (BankCutsceneTimer), A
 563+ DFC7 3E 07            LD A, BCP_TURN_TO_DOOR
 564+ DFC9 32 D1 82         LD (BankCutscenePhase), A
 565+ DFCC C9               RET
 566+ DFCD
 567+ DFCD              ; ---- Phase 7: transicion rapida de vuelta a N → arrancar grupo 3 ----
 568+ DFCD              .bcPhTurnToDoor:
 569+ DFCD CD 10 E2         CALL BankCutsceneDecTimer
 570+ DFD0 C0               RET NZ
 571+ DFD1                  ; Snap a DOOR (player se acerca otra vez para los 6 toques finales).
 572+ DFD1 CD 1F DE         CALL BankCutsceneSnapToDoor
 573+ DFD4 AF               XOR A
 574+ DFD5 32 D4 82         LD (BankCutsceneKnockIdx), A
 575+ DFD8 3E 01            LD A, 1
 576+ DFDA 32 D7 82         LD (BankCutsceneKnockType), A       ; 1 = loud (grupo 3 = 6 knocks)
 577+ DFDD AF               XOR A
 578+ DFDE 32 D3 82         LD (BankCutsceneSubState), A        ; HIT
 579+ DFE1 3E 04            LD A, BCS_T_KNOCK_HIT
 580+ DFE3 32 D2 82         LD (BankCutsceneTimer), A
 581+ DFE6 CD 98 E1         CALL BankCutsceneEmitKnockHit
 582+ DFE9 3E 08            LD A, BCP_KNOCKS_3
 583+ DFEB 32 D1 82         LD (BankCutscenePhase), A
 584+ DFEE C9               RET
