6906+ C57C 18 03            JR .udPost
6907+ C57E              .udSkip:
6908+ C57E CD FA C5         CALL DeathAnimate                   ; skip: solo animacion
6909+ C581              .udPost:
6910+ C581                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6911+ C581 3A 04 83         LD A, (DeathPrevX)
6912+ C584 DD BE 03         CP (IX+ENT_POSX)
6913+ C587 20 19            JR NZ, .udMoved
6914+ C589 3A 05 83         LD A, (DeathPrevY)
6915+ C58C DD BE 04         CP (IX+ENT_POSY)
6916+ C58F 20 11            JR NZ, .udMoved
6917+ C591                  ; No movio: incrementar BFS counter
6918+ C591 3A 06 83         LD A, (DeathStuckCounter)
6919+ C594 3C               INC A
6920+ C595 32 06 83         LD (DeathStuckCounter), A
6921+ C598 FE 06            CP DEATH_STUCK_THRESHOLD
6922+ C59A D8               RET C
6923+ C59B AF               XOR A
6924+ C59C 32 06 83         LD (DeathStuckCounter), A
6925+ C59F C3 66 C7         JP DeathBfsRescue
6926+ C5A2              .udMoved:
6927+ C5A2 AF               XOR A
6928+ C5A3 32 06 83         LD (DeathStuckCounter), A
6929+ C5A6 C9               RET
6930+ C5A7
6931+ C5A7              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6932+ C5A7              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6933+ C5A7              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6934+ C5A7              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6935+ C5A7              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6936+ C5A7              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6937+ C5A7              DeathGhostChase:
6938+ C5A7                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6939+ C5A7 3A A6 81         LD A, (EntityTable + ENT_POSX)
6940+ C5AA DD 96 03         SUB (IX+ENT_POSX)
6941+ C5AD 30 02            JR NC, .udgAbsDxOk
6942+ C5AF ED 44            NEG
6943+ C5B1              .udgAbsDxOk:
6944+ C5B1 47               LD B, A                             ; B = |dx|
6945+ C5B2 3A A7 81         LD A, (EntityTable + ENT_POSY)
6946+ C5B5 DD 96 04         SUB (IX+ENT_POSY)
6947+ C5B8 30 02            JR NC, .udgAbsDyOk
6948+ C5BA ED 44            NEG
6949+ C5BC              .udgAbsDyOk:
6950+ C5BC                  ; A = |dy|, B = |dx|
6951+ C5BC B8               CP B
6952+ C5BD 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6953+ C5BF
6954+ C5BF                  ; --- Eje X primario ---
6955+ C5BF AF               XOR A
6956+ C5C0 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6957+ C5C3 3A A6 81         LD A, (EntityTable + ENT_POSX)
6958+ C5C6 DD 96 03         SUB (IX+ENT_POSX)
6959+ C5C9 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6960+ C5CB 3E 04            LD A, DEATH_GHOST_SPEED
6961+ C5CD 30 02            JR NC, .udgXSet
6962+ C5CF 3E FC            LD A, -DEATH_GHOST_SPEED
6963+ C5D1              .udgXSet:
6964+ C5D1 DD 77 06         LD (IX+ENT_DELTAX), A
6965+ C5D4 DD 86 03         ADD A, (IX+ENT_POSX)
6966+ C5D7 DD 77 03         LD (IX+ENT_POSX), A
6967+ C5DA 18 1B            JR .udgAnim
6968+ C5DC
6969+ C5DC                  ; --- Eje Y primario ---
6970+ C5DC              .udgVertPrim:
6971+ C5DC AF               XOR A
6972+ C5DD DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6973+ C5E0 3A A7 81         LD A, (EntityTable + ENT_POSY)
6974+ C5E3 DD 96 04         SUB (IX+ENT_POSY)
6975+ C5E6 28 0F            JR Z, .udgAnim
6976+ C5E8 3E 04            LD A, DEATH_GHOST_SPEED
6977+ C5EA 30 02            JR NC, .udgYSet
6978+ C5EC 3E FC            LD A, -DEATH_GHOST_SPEED
6979+ C5EE              .udgYSet:
6980+ C5EE DD 77 07         LD (IX+ENT_DELTAY), A
6981+ C5F1 DD 86 04         ADD A, (IX+ENT_POSY)
6982+ C5F4 DD 77 04         LD (IX+ENT_POSY), A
6983+ C5F7              .udgAnim:
6984+ C5F7                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6985+ C5F7                  ; ser despawneada por una de tres condiciones externas:
6986+ C5F7                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6987+ C5F7                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6988+ C5F7                  ;   3. Player cambia de pantalla (screen_system reset)
6989+ C5F7                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6990+ C5F7                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6991+ C5F7                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6992+ C5F7 C3 FA C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6993+ C5FA
6994+ C5FA              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6995+ C5FA              ; Llamada por:
6996+ C5FA              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6997+ C5FA              ;   - UpdateDeath en frame skip (sin movimiento).
6998+ C5FA              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6999+ C5FA              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
7000+ C5FA              DeathAnimate:
7001+ C5FA DD 7E 06         LD A, (IX+ENT_DELTAX)
7002+ C5FD B7               OR A
7003+ C5FE 28 0A            JR Z, .daKeepDir
7004+ C600 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
7005+ C602 CB 7F            BIT 7, A
7006+ C604 28 0D            JR Z, .daDir
7007+ C606 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
7008+ C608 18 09            JR .daDir
7009+ C60A              .daKeepDir:
7010+ C60A DD 7E 00         LD A, (IX+ENT_SPRITEID)
7011+ C60D DD 96 08         SUB (IX+ENT_ANIMBASE)
7012+ C610 E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
7013+ C612 4F               LD C, A
7014+ C613              .daDir:
7015+ C613 DD 35 09         DEC (IX+ENT_ANIMTIMER)
7016+ C616 20 16            JR NZ, .daFrameSet
7017+ C618 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
7018+ C61C DD 7E 00         LD A, (IX+ENT_SPRITEID)
7019+ C61F 47               LD B, A
7020+ C620 DD 96 08         SUB (IX+ENT_ANIMBASE)
7021+ C623 E6 01            AND 1
7022+ C625 20 03            JR NZ, .daFrameDec
7023+ C627 04               INC B
7024+ C628 18 01            JR .daFrameStore
7025+ C62A              .daFrameDec:
7026+ C62A 05               DEC B
7027+ C62B              .daFrameStore:
7028+ C62B DD 70 00         LD (IX+ENT_SPRITEID), B
7029+ C62E              .daFrameSet:
7030+ C62E DD 7E 00         LD A, (IX+ENT_SPRITEID)
7031+ C631 DD 96 08         SUB (IX+ENT_ANIMBASE)
7032+ C634 E6 01            AND 1
7033+ C636 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
7034+ C639 81               ADD A, C
7035+ C63A DD 77 00         LD (IX+ENT_SPRITEID), A
7036+ C63D C9               RET
