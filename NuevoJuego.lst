1754+ 9C1F              .cwDoCheck:
1755+ 9C1F                  ; AABB con margen de 8px (1 celda) por cada lado:
1756+ 9C1F                  ; playerX < wellX+24 AND wellX-8 < playerX+16
1757+ 9C1F                  ; playerY < wellY+24 AND wellY-8 < playerY+21
1758+ 9C1F                  ; --- Check X ---
1759+ 9C1F 3A B6 8C         LD A, (WellPosX)
1760+ 9C22 C6 18            ADD A, 24                           ; C = wellX + 16 + 8 (wellRight + margen)
1761+ 9C24 4F               LD C, A
1762+ 9C25 3A A1 80         LD A, (EntityTable + ENT_POSX)      ; A = playerX
1763+ 9C28 B9               CP C                                ; playerX < wellRight+margen?
1764+ 9C29 30 39            JR NC, .cwNoOverlap                 ; no → fuera
1765+ 9C2B 3A A1 80         LD A, (EntityTable + ENT_POSX)
1766+ 9C2E C6 18            ADD A, 24                           ; C = playerX + 16 + 8 (playerRight + margen)
1767+ 9C30 4F               LD C, A
1768+ 9C31 3A B6 8C         LD A, (WellPosX)                    ; A = wellX
1769+ 9C34 B9               CP C                                ; wellX < playerRight+margen?
1770+ 9C35 30 2D            JR NC, .cwNoOverlap                 ; no → fuera
1771+ 9C37                  ; --- Check Y ---
1772+ 9C37 3A B7 8C         LD A, (WellPosY)
1773+ 9C3A C6 18            ADD A, 24                           ; C = wellY + 16 + 8
1774+ 9C3C 4F               LD C, A
1775+ 9C3D 3A A2 80         LD A, (EntityTable + ENT_POSY)      ; A = playerY
1776+ 9C40 B9               CP C                                ; playerY < wellBottom+margen?
1777+ 9C41 30 21            JR NC, .cwNoOverlap                 ; no → fuera
1778+ 9C43 3A A2 80         LD A, (EntityTable + ENT_POSY)
1779+ 9C46 C6 1D            ADD A, 29                           ; C = playerY + 21 + 8
1780+ 9C48 4F               LD C, A
1781+ 9C49 3A B7 8C         LD A, (WellPosY)                    ; A = wellY
1782+ 9C4C B9               CP C                                ; wellY < playerBottom+margen?
1783+ 9C4D 30 15            JR NC, .cwNoOverlap                 ; no → fuera
1784+ 9C4F                  ; --- Overlap! Recuperar salud y stamina ---
1785+ 9C4F 3E 10            LD A, HEALTH_MAX
