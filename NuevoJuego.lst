115+  836C              ; ==============================================================================
116+  836C              ; ProcessEntities - Loop principal per-entity (flicker-free)
117+  836C              ; ==============================================================================
118+  836C              ; Orden optimizado: update → attrs → XOR erase + XOR draw (back-to-back) → attrs
119+  836C              ; Los dos DrawSprite van seguidos para minimizar el gap visible al beam CRT.
120+  836C              ; ==============================================================================
121+  836C              ProcessEntities:
122+  836C DD 21 36 80      LD IX, EntityTable
123+  8370 3E 11            LD A, NUM_ENTITIES
124+  8372 32 1E 84         LD (.counter), A
125+  8375
126+  8375              .loop:
127+  8375 DD 7E 01         LD A, (IX+ENT_TYPE)
128+  8378 B7               OR A
129+  8379 CA 0A 84         JP Z, .skip                 ; Slot inactivo
130+  837C
131+  837C 3A 0A 81         LD A, (ScreenJustRedrawn)
132+  837F B7               OR A
133+  8380 20 7D            JR NZ, .freshDraw
134+  8382
135+  8382                  ; ==================================================================
136+  8382                  ; FRAME NORMAL: update → restore/save attrs → erase+draw → set attrs
137+  8382                  ; ==================================================================
138+  8382
139+  8382                  ; 1. Guardar estado anterior (pos + sprite)
140+  8382 DD 7E 03         LD A, (IX+ENT_POSX)
141+  8385 32 1F 84         LD (.oldX), A
142+  8388 DD 7E 04         LD A, (IX+ENT_POSY)
143+  838B 32 20 84         LD (.oldY), A
144+  838E DD 7E 00         LD A, (IX+ENT_SPRITEID)
145+  8391 32 21 84         LD (.oldSprID), A
146+  8394
147+  8394                  ; 2. Update (cambia pos y animacion)
148+  8394 DD 7E 01         LD A, (IX+ENT_TYPE)
149+  8397 FE 01            CP TYPE_PLAYER
150+  8399 CC 6B 84         CALL Z, UpdatePlayer
151+  839C
152+  839C                  ; 3. Buscar direccion del sprite VIEJO (para el erase)
153+  839C 3A 21 84         LD A, (.oldSprID)
154+  839F 6F               LD L, A
155+  83A0 26 00            LD H, 0
156+  83A2 29               ADD HL, HL
157+  83A3 11 67 8B         LD DE, SpriteFrameTable
158+  83A6 19               ADD HL, DE
159+  83A7 5E               LD E, (HL)
160+  83A8 23               INC HL
161+  83A9 56               LD D, (HL)
162+  83AA ED 53 22 84      LD (.oldSprAddr), DE
163+  83AE
164+  83AE                  ; 4. Buscar direccion del sprite NUEVO (para el draw)
165+  83AE CD 56 84         CALL GetSpriteAddr          ; SpriteAddrTemp = nuevo sprite
166+  83B1
167+  83B1                  ; 5. Restaurar attrs en posicion vieja
168+  83B1 3A 20 84         LD A, (.oldY)
169+  83B4 57               LD D, A
170+  83B5 3A 1F 84         LD A, (.oldX)
171+  83B8 5F               LD E, A
172+  83B9 CD 06 82         CALL RestoreEntityAttr
173+  83BC
174+  83BC                  ; 6. Guardar attrs en posicion nueva
175+  83BC DD 56 04         LD D, (IX+ENT_POSY)
176+  83BF DD 5E 03         LD E, (IX+ENT_POSX)
177+  83C2 DD E5            PUSH IX
178+  83C4 DD 2A 69 84      LD IX, (SpriteAddrTemp)
179+  83C8 CD C6 81         CALL SaveEntityAttr
180+  83CB DD E1            POP IX
181+  83CD
182+  83CD                  ; 7. Pintar atributo ANTES del draw (evita ventana con attrs de fondo)
183+  83CD DD 56 04         LD D, (IX+ENT_POSY)
184+  83D0 DD 5E 03         LD E, (IX+ENT_POSX)
185+  83D3 DD 7E 05         LD A, (IX+ENT_ATTR)
186+  83D6 CD A8 81         CALL SetEntityAttr
187+  83D9
188+  83D9                  ; ==================================================================
189+  83D9                  ; SECCION CRITICA: XOR erase + XOR draw SEGUIDOS (anti-flicker)
190+  83D9                  ; ==================================================================
191+  83D9
192+  83D9                  ; 8. XOR erase en posicion vieja con sprite viejo
193+  83D9 3A 20 84         LD A, (.oldY)
194+  83DC 57               LD D, A
195+  83DD 3A 1F 84         LD A, (.oldX)
196+  83E0 5F               LD E, A
197+  83E1 DD E5            PUSH IX
198+  83E3 DD 2A 22 84      LD IX, (.oldSprAddr)
199+  83E7 CD 0F 81         CALL DrawSprite
200+  83EA DD E1            POP IX
201+  83EC
202+  83EC                  ; 9. XOR draw en posicion nueva con sprite nuevo (INMEDIATO!)
203+  83EC DD 56 04         LD D, (IX+ENT_POSY)
204+  83EF DD 5E 03         LD E, (IX+ENT_POSX)
205+  83F2 DD E5            PUSH IX
206+  83F4 DD 2A 69 84      LD IX, (SpriteAddrTemp)
207+  83F8 CD 0F 81         CALL DrawSprite
208+  83FB DD E1            POP IX
209+  83FD 18 0B            JR .skip
210+  83FF
211+  83FF                  ; ==================================================================
212+  83FF                  ; PRIMER FRAME tras redibujar pantalla: solo update + draw
213+  83FF                  ; ==================================================================
214+  83FF              .freshDraw:
215+  83FF DD 7E 01         LD A, (IX+ENT_TYPE)
216+  8402 FE 01            CP TYPE_PLAYER
217+  8404 CC 6B 84         CALL Z, UpdatePlayer
218+  8407 CD 24 84         CALL DrawEntity
219+  840A
220+  840A              .skip:
221+  840A 11 0C 00         LD DE, ENT_SIZE
222+  840D DD 19            ADD IX, DE
223+  840F 3A 1E 84         LD A, (.counter)
224+  8412 3D               DEC A
225+  8413 32 1E 84         LD (.counter), A
226+  8416 C2 75 83         JP NZ, .loop
227+  8419
228+  8419                  ; Limpiar flag despues de procesar TODAS las entidades
229+  8419 AF               XOR A
230+  841A 32 0A 81         LD (ScreenJustRedrawn), A
231+  841D C9               RET
232+  841E
233+  841E 00           .counter:    DEFB 0
234+  841F 00           .oldX:       DEFB 0
235+  8420 00           .oldY:       DEFB 0
236+  8421 00           .oldSprID:   DEFB 0
237+  8422 00 00        .oldSprAddr: DEFW 0
238+  8424
239+  8424              ; ==============================================================================
240+  8424              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
241+  8424              ; ==============================================================================
242+  8424              ; Solo se usa en .freshDraw (primer frame tras transicion de pantalla).
243+  8424              ; IX = puntero a la entidad
244+  8424              ; ==============================================================================
245+  8424              DrawEntity:
246+  8424                  ; Guardar attrs del fondo ANTES de pintar
247+  8424 CD 56 84         CALL GetSpriteAddr
248+  8427 DD 56 04         LD D, (IX+ENT_POSY)
249+  842A DD 5E 03         LD E, (IX+ENT_POSX)
250+  842D DD E5            PUSH IX
251+  842F DD 2A 69 84      LD IX, (SpriteAddrTemp)
252+  8433 CD C6 81         CALL SaveEntityAttr
253+  8436 DD E1            POP IX
254+  8438
255+  8438                  ; Pintar atributo ANTES del draw (evita ventana con attrs de fondo)
256+  8438 DD 56 04         LD D, (IX+ENT_POSY)
257+  843B DD 5E 03         LD E, (IX+ENT_POSX)
258+  843E DD 7E 05         LD A, (IX+ENT_ATTR)
259+  8441 CD A8 81         CALL SetEntityAttr
260+  8444
261+  8444                  ; XOR draw del sprite (attrs ya correctos)
262+  8444 DD 56 04         LD D, (IX+ENT_POSY)
263+  8447 DD 5E 03         LD E, (IX+ENT_POSX)
264+  844A DD E5            PUSH IX
265+  844C DD 2A 69 84      LD IX, (SpriteAddrTemp)
266+  8450 CD 0F 81         CALL DrawSprite
267+  8453 DD E1            POP IX
268+  8455 C9               RET
269+  8456
270+  8456              ; ==============================================================================
271+  8456              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
272+  8456              ; ==============================================================================
273+  8456              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
274+  8456              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
275+  8456              ; ==============================================================================
276+  8456              GetSpriteAddr:
277+  8456 DD 7E 00         LD A, (IX+ENT_SPRITEID)
278+  8459 6F               LD L, A
279+  845A 26 00            LD H, 0
280+  845C 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
281+  845D 11 67 8B         LD DE, SpriteFrameTable
282+  8460 19               ADD HL, DE
283+  8461 5E               LD E, (HL)
284+  8462 23               INC HL
285+  8463 56               LD D, (HL)
286+  8464 ED 53 69 84      LD (SpriteAddrTemp), DE
287+  8468 C9               RET
288+  8469
289+  8469 00 00        SpriteAddrTemp: DEFW 0
290+  846B
291+  846B              ; ==============================================================================
292+  846B              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
293+  846B              ; ==============================================================================
294+  846B              ; IX = puntero a la entidad del player (slot 0)
295+  846B              ; ==============================================================================
296+  846B              UpdatePlayer:
297+  846B CD 75 84         CALL UpdatePlayerState
298+  846E CD BA 84         CALL UpdatePlayerMovement
299+  8471 CD 82 85         CALL UpdatePlayerAnimation
300+  8474 C9               RET
301+  8475
302+  8475              ; ==============================================================================
303+  8475              ; UpdatePlayerState - Determina estado y direccion desde input
304+  8475              ; ==============================================================================
305+  8475              UpdatePlayerState:
306+  8475 3A 02 81         LD A, (InputDirection)
307+  8478 47               LD B, A
308+  8479 3A 03 81         LD A, (InputFire)
309+  847C 4F               LD C, A
310+  847D
311+  847D                  ; Sin input → idle
312+  847D 78               LD A, B
313+  847E B1               OR C
314+  847F 20 0D            JR NZ, .notIdle
315+  8481 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
316+  8485                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
317+  8485 DD 7E 0A         LD A, (IX+ENT_DIR)
318+  8488 E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
319+  848A DD 77 0A         LD (IX+ENT_DIR), A
320+  848D C9               RET
321+  848E
322+  848E              .notIdle:
323+  848E                  ; Guardar direccion actual en bits 0-3
324+  848E DD 7E 0A         LD A, (IX+ENT_DIR)
325+  8491 E6 F0            AND $F0                     ; Mantener lastHDir
326+  8493 B0               OR B                        ; Añadir dir actual
327+  8494 DD 77 0A         LD (IX+ENT_DIR), A
328+  8497
329+  8497                  ; Actualizar lastHDir si hay componente E/W
330+  8497 78               LD A, B
331+  8498 E6 0C            AND DIR_E | DIR_W
332+  849A 28 0E            JR Z, .noHorizUpdate
333+  849C                  ; Guardar en bits 4-7
334+  849C 07               RLCA
335+  849D 07               RLCA
336+  849E 07               RLCA
337+  849F 07               RLCA                        ; Shift a bits 4-7
338+  84A0 4F               LD C, A                     ; C = lastHDir en bits 4-7
339+  84A1 DD 7E 0A         LD A, (IX+ENT_DIR)
340+  84A4 E6 0F            AND $0F                     ; Mantener dir actual
341+  84A6 B1               OR C                        ; Añadir lastHDir
342+  84A7 DD 77 0A         LD (IX+ENT_DIR), A
343+  84AA              .noHorizUpdate:
344+  84AA
345+  84AA                  ; Fighting o running?
346+  84AA 3A 03 81         LD A, (InputFire)
347+  84AD B7               OR A
348+  84AE 28 05            JR Z, .running
349+  84B0 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
350+  84B4 C9               RET
351+  84B5
352+  84B5              .running:
353+  84B5 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
354+  84B9 C9               RET
355+  84BA
356+  84BA              ; ==============================================================================
357+  84BA              ; UpdatePlayerMovement - Fiel a Sabre Wulf: mueve cada N frames
358+  84BA              ; ==============================================================================
359+  84BA              ; El original usa turns_per_player_move=2: el player se mueve cada 2 frames.
360+  84BA              ; Desplazamiento por turno: SPEED_RUN_X horizontal, SPEED_RUN_Y vertical.
361+  84BA              ; ==============================================================================
362+  84BA              UpdatePlayerMovement:
363+  84BA DD 7E 0A         LD A, (IX+ENT_DIR)
364+  84BD E6 0F            AND $0F                     ; Dir actual (bits 0-3)
365+  84BF C8               RET Z                       ; Sin movimiento
366+  84C0
367+  84C0                  ; Determinar velocidad segun estado
368+  84C0 DD 7E 02         LD A, (IX+ENT_STATE)
369+  84C3 FE 02            CP STATE_FIGHTING
370+  84C5 3E 02            LD A, SPEED_RUN
371+  84C7 20 02            JR NZ, .gotSpeed
372+  84C9 3E 02            LD A, SPEED_FIGHT
373+  84CB              .gotSpeed:
374+  84CB 32 4F 85         LD (.speed), A
375+  84CE
376+  84CE                  ; --- Movimiento horizontal (con colision) ---
377+  84CE DD 7E 03         LD A, (IX+ENT_POSX)
378+  84D1 32 50 85         LD (.savedX), A             ; Guardar X antes de mover
379+  84D4
380+  84D4 DD 7E 0A         LD A, (IX+ENT_DIR)
381+  84D7 CB 57            BIT 2, A                    ; DIR_E?
382+  84D9 28 11            JR Z, .noE
383+  84DB 3A 4F 85         LD A, (.speed)
384+  84DE 47               LD B, A
385+  84DF DD 7E 03         LD A, (IX+ENT_POSX)
386+  84E2 80               ADD A, B
387+  84E3 FE E8            CP SCREEN_MAX_X
388+  84E5 38 02            JR C, .clampE
389+  84E7 3E E8            LD A, SCREEN_MAX_X
390+  84E9              .clampE:
391+  84E9 DD 77 03         LD (IX+ENT_POSX), A
392+  84EC              .noE:
393+  84EC DD 7E 0A         LD A, (IX+ENT_DIR)
394+  84EF CB 5F            BIT 3, A                    ; DIR_W?
395+  84F1 28 10            JR Z, .noW
396+  84F3 DD 7E 03         LD A, (IX+ENT_POSX)
397+  84F6 47               LD B, A
398+  84F7 3A 4F 85         LD A, (.speed)
399+  84FA 4F               LD C, A
400+  84FB 78               LD A, B
401+  84FC 91               SUB C
402+  84FD 30 01            JR NC, .clampW
403+  84FF AF               XOR A                       ; Clamp a 0
404+  8500              .clampW:
405+  8500 DD 77 03         LD (IX+ENT_POSX), A
406+  8503              .noW:
407+  8503                  ; Check colision X
408+  8503 CD 52 85         CALL CheckEntityCollision
409+  8506 28 06            JR Z, .xOk
410+  8508 3A 50 85         LD A, (.savedX)
411+  850B DD 77 03         LD (IX+ENT_POSX), A        ; Revertir X
412+  850E              .xOk:
413+  850E
414+  850E                  ; --- Movimiento vertical (con colision) ---
415+  850E DD 7E 04         LD A, (IX+ENT_POSY)
416+  8511 32 51 85         LD (.savedY), A
417+  8514
418+  8514 DD 7E 0A         LD A, (IX+ENT_DIR)
419+  8517 CB 4F            BIT 1, A                    ; DIR_S?
420+  8519 28 11            JR Z, .noS
421+  851B 3A 4F 85         LD A, (.speed)
422+  851E 47               LD B, A
423+  851F DD 7E 04         LD A, (IX+ENT_POSY)
424+  8522 80               ADD A, B
425+  8523 FE A0            CP SCREEN_MAX_Y
426+  8525 38 02            JR C, .clampS
427+  8527 3E A0            LD A, SCREEN_MAX_Y
428+  8529              .clampS:
429+  8529 DD 77 04         LD (IX+ENT_POSY), A
430+  852C              .noS:
431+  852C DD 7E 0A         LD A, (IX+ENT_DIR)
432+  852F CB 47            BIT 0, A                    ; DIR_N?
433+  8531 28 10            JR Z, .noN
434+  8533 DD 7E 04         LD A, (IX+ENT_POSY)
435+  8536 47               LD B, A
436+  8537 3A 4F 85         LD A, (.speed)
437+  853A 4F               LD C, A
438+  853B 78               LD A, B
439+  853C 91               SUB C
440+  853D 30 01            JR NC, .clampN
441+  853F AF               XOR A
442+  8540              .clampN:
443+  8540 DD 77 04         LD (IX+ENT_POSY), A
444+  8543              .noN:
445+  8543                  ; Check colision Y
446+  8543 CD 52 85         CALL CheckEntityCollision
447+  8546 28 06            JR Z, .yOk
448+  8548 3A 51 85         LD A, (.savedY)
449+  854B DD 77 04         LD (IX+ENT_POSY), A        ; Revertir Y
450+  854E              .yOk:
451+  854E C9               RET
452+  854F
453+  854F 00           .speed:  DEFB 0
454+  8550 00           .savedX: DEFB 0
455+  8551 00           .savedY: DEFB 0
456+  8552
457+  8552              ; ==============================================================================
458+  8552              ; CheckEntityCollision - Colision de la entidad contra sprites de fondo
459+  8552              ; ==============================================================================
460+  8552              ; Comprueba 3 puntos del bounding box (como el original).
461+  8552              ; IX = entidad. Salida: Z=libre, NZ=colision.
462+  8552              ; ==============================================================================
463+  8552              CheckEntityCollision:
464+  8552                  ; Punto 1: centro-arriba (X+8, Y+2)
465+  8552 DD 7E 03         LD A, (IX+ENT_POSX)
466+  8555 C6 08            ADD A, 8
467+  8557 47               LD B, A
468+  8558 DD 7E 04         LD A, (IX+ENT_POSY)
469+  855B C6 02            ADD A, 2
470+  855D 4F               LD C, A
471+  855E CD 23 87         CALL IsPointBlocked
472+  8561 C0               RET NZ
473+  8562
474+  8562                  ; Punto 2: centro-abajo (X+8, Y+13)
475+  8562 DD 7E 03         LD A, (IX+ENT_POSX)
476+  8565 C6 08            ADD A, 8
477+  8567 47               LD B, A
478+  8568 DD 7E 04         LD A, (IX+ENT_POSY)
479+  856B C6 0D            ADD A, 13
480+  856D 4F               LD C, A
481+  856E CD 23 87         CALL IsPointBlocked
482+  8571 C0               RET NZ
483+  8572
484+  8572                  ; Punto 3: centro-centro (X+8, Y+8)
485+  8572 DD 7E 03         LD A, (IX+ENT_POSX)
486+  8575 C6 08            ADD A, 8
487+  8577 47               LD B, A
488+  8578 DD 7E 04         LD A, (IX+ENT_POSY)
489+  857B C6 08            ADD A, 8
490+  857D 4F               LD C, A
491+  857E CD 23 87         CALL IsPointBlocked
492+  8581 C9               RET                         ; Z/NZ del ultimo check
493+  8582
494+  8582              ; ==============================================================================
495+  8582              ; UpdatePlayerAnimation - Animacion por SpriteID
496+  8582              ; ==============================================================================
497+  8582              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
498+  8582              ; ==============================================================================
499+  8582              UpdatePlayerAnimation:
500+  8582                  ; Determinar animacion segun estado y direccion
501+  8582 DD 7E 02         LD A, (IX+ENT_STATE)
502+  8585 FE 02            CP STATE_FIGHTING
503+  8587 28 0C            JR Z, .animFight
504+  8589 FE 01            CP STATE_RUNNING
505+  858B 28 21            JR Z, .animRun
506+  858D
507+  858D                  ; --- IDLE ---
508+  858D 16 00            LD D, SPRID_IDLE
509+  858F 1E 02            LD E, ANIM_FRAMES_IDLE
510+  8591 0E 08            LD C, ANIM_DELAY_IDLE
511+  8593 18 3C            JR .applyAnim
512+  8595
513+  8595              .animFight:
514+  8595                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
515+  8595 DD 7E 0A         LD A, (IX+ENT_DIR)
516+  8598 0F               RRCA
517+  8599 0F               RRCA
518+  859A 0F               RRCA
519+  859B 0F               RRCA
520+  859C E6 0F            AND $0F                     ; lastHDir
521+  859E FE 08            CP DIR_W
522+  85A0 28 04            JR Z, .fightW
523+  85A2 16 0E            LD D, SPRID_FIGHT_E
524+  85A4 18 02            JR .fightSet
525+  85A6              .fightW:
526+  85A6 16 10            LD D, SPRID_FIGHT_W
527+  85A8              .fightSet:
528+  85A8 1E 02            LD E, ANIM_FRAMES_FIGHT
529+  85AA 0E 03            LD C, ANIM_DELAY_FIGHT
530+  85AC 18 23            JR .applyAnim
531+  85AE
532+  85AE              .animRun:
533+  85AE DD 7E 0A         LD A, (IX+ENT_DIR)
534+  85B1 E6 0F            AND $0F                     ; dir actual
535+  85B3                  ; Prioridad: E/W sobre N/S
536+  85B3 CB 57            BIT 2, A
537+  85B5 20 0C            JR NZ, .runE
538+  85B7 CB 5F            BIT 3, A
539+  85B9 20 0C            JR NZ, .runW
540+  85BB CB 47            BIT 0, A
541+  85BD 20 0C            JR NZ, .runN
542+  85BF 16 0B            LD D, SPRID_WALK_S
543+  85C1 18 0A            JR .runSet
544+  85C3              .runE:
545+  85C3 16 02            LD D, SPRID_WALK_E
546+  85C5 18 06            JR .runSet
547+  85C7              .runW:
548+  85C7 16 05            LD D, SPRID_WALK_W
549+  85C9 18 02            JR .runSet
550+  85CB              .runN:
551+  85CB 16 08            LD D, SPRID_WALK_N
552+  85CD              .runSet:
553+  85CD 1E 03            LD E, ANIM_FRAMES_WALK
554+  85CF 0E 04            LD C, ANIM_DELAY_RUN
555+  85D1
556+  85D1              .applyAnim:
557+  85D1                  ; D = nuevo AnimBase, E = num frames, C = delay
558+  85D1                  ; ¿Cambio de animacion?
559+  85D1 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
560+  85D4 BA               CP D
561+  85D5 28 0A            JR Z, .sameAnim
562+  85D7
563+  85D7                  ; Nueva animacion → reiniciar
564+  85D7 DD 72 08         LD (IX+ENT_ANIMBASE), D
565+  85DA DD 72 00         LD (IX+ENT_SPRITEID), D     ; Reset al primer frame
566+  85DD DD 71 09         LD (IX+ENT_ANIMTIMER), C
567+  85E0 C9               RET
568+  85E1
569+  85E1              .sameAnim:
570+  85E1                  ; Decrementar timer
571+  85E1 DD 35 09         DEC (IX+ENT_ANIMTIMER)
572+  85E4 C0               RET NZ
573+  85E5
574+  85E5                  ; Timer expirado → avanzar frame
575+  85E5 DD 71 09         LD (IX+ENT_ANIMTIMER), C    ; Reset timer
576+  85E8
577+  85E8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
578+  85EB 3C               INC A
579+  85EC                  ; ¿Fuera de rango?
580+  85EC 47               LD B, A                     ; B = nuevo SpriteID
581+  85ED 92               SUB D                       ; A = frame relativo (nuevo - animBase)
582+  85EE BB               CP E                        ; ¿>= num_frames?
583+  85EF 38 01            JR C, .frameOk
584+  85F1 42               LD B, D                     ; Reset al AnimBase
585+  85F2              .frameOk:
586+  85F2 DD 70 00         LD (IX+ENT_SPRITEID), B
587+  85F5 C9               RET
588+  85F6
