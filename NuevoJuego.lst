4117+ B5B6              ; UpdateDying - Avanza animacion puff (6 frames), luego programa erase pendiente
4118+ B5B6              ; ==============================================================================
4119+ B5B6              ; IX = entidad en STATE_DYING. ANIMBASE = SPRID_PUFF.
4120+ B5B6              ; Cuando el ultimo frame expira → programa erase pendiente + TYPE_NONE.
4121+ B5B6              ; El erase final se ejecutara en EraseDeadSprites del siguiente frame.
4122+ B5B6              ; ==============================================================================
4123+ B5B6              UpdateDying:
4124+ B5B6 DD 35 09         DEC (IX+ENT_ANIMTIMER)
4125+ B5B9 20 1D            JR NZ, .dyAnimDone
4126+ B5BB                  ; Timer expirado → avanzar frame
4127+ B5BB 3E 01            LD A, ANIM_DELAY_PUFF
4128+ B5BD DD 77 09         LD (IX+ENT_ANIMTIMER), A
