 682+ E5F4 3E 47            LD A, $47
 683+ E5F6 32 0B 58         LD (ATTR_BASE + 11), A
 684+ E5F9 32 0C 58         LD (ATTR_BASE + 12), A
 685+ E5FC C9               RET
