4912+ BDC7              ; ==============================================================================
4913+ BDC7              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
4914+ BDC7              ; ==============================================================================
4915+ BDC7              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
4916+ BDC7              ; ==============================================================================
4917+ BDC7
4918+ BDC7              ; ==============================================================================
4919+ BDC7              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
4920+ BDC7              ; ==============================================================================
4921+ BDC7              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
4922+ BDC7              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
4923+ BDC7              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4924+ BDC7              ; ==============================================================================
4925+ BDC7              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
4926+ BDC7              ; ==============================================================================
4927+ BDC7              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
4928+ BDC7              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
4929+ BDC7              ; No nudge, no border scan, no MonsterSave, no buffer restore.
4930+ BDC7              ; ==============================================================================
4931+ BDC7              MONSTERS_TO_SPAWN   EQU 3
4932+ BDC7              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
4933+ BDC7              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
4934+ BDC7
4935+ BDC7              ; ==============================================================================
4936+ BDC7              ; SpawnMonsters - Primera aparicion tras campanadas
4937+ BDC7              ; ==============================================================================
4938+ BDC7              SpawnMonsters:
4939+ BDC7 3A 01 B6         LD A, (MonstersActive)
4940+ BDCA B7               OR A
4941+ BDCB C0               RET NZ
4942+ BDCC                  ; Matar nasties activos antes de poblar slots de monster: liberar el
4943+ BDCC                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
4944+ BDCC CD C6 BC         CALL KillAllActiveNasties
4945+ BDCF 3E 01            LD A, 1
4946+ BDD1 32 01 B6         LD (MonstersActive), A
4947+ BDD4 CD 51 BE         CALL ShuffleMonsterTypes
4948+ BDD7 DD 21 D7 80      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
4949+ BDDB 06 03            LD B, MONSTERS_TO_SPAWN
4950+ BDDD 0E 00            LD C, 0
4951+ BDDF              .smLoop:
4952+ BDDF C5               PUSH BC
4953+ BDE0 DD 7E 01         LD A, (IX+ENT_TYPE)
4954+ BDE3 B7               OR A
4955+ BDE4 C2 40 BE         JP NZ, .smSkip
4956+ BDE7                  ; Asignar tipo y color
4957+ BDE7 79               LD A, C
4958+ BDE8 21 B5 BE         LD HL, MonsterTypeTable
4959+ BDEB 5F               LD E, A
4960+ BDEC 16 00            LD D, 0
4961+ BDEE 19               ADD HL, DE
4962+ BDEF 7E               LD A, (HL)
4963+ BDF0 DD 77 08         LD (IX+ENT_ANIMBASE), A
4964+ BDF3 79               LD A, C
4965+ BDF4 21 B8 BE         LD HL, MonsterColorTable
4966+ BDF7 5F               LD E, A
4967+ BDF8 16 00            LD D, 0
4968+ BDFA 19               ADD HL, DE
4969+ BDFB 7E               LD A, (HL)
4970+ BDFC DD 77 05         LD (IX+ENT_ATTR), A
4971+ BDFF                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
4972+ BDFF C5               PUSH BC
4973+ BE00 CD A1 93         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
4974+ BE03 B7               OR A
4975+ BE04 20 0E            JR NZ, .smFallbackPos
4976+ BE06 3A 5E 9C         LD A, (MaiSpawnX)
4977+ BE09 DD 77 03         LD (IX+ENT_POSX), A
4978+ BE0C 3A 5F 9C         LD A, (MaiSpawnY)
4979+ BE0F DD 77 04         LD (IX+ENT_POSY), A
4980+ BE12 18 0C            JR .smPosDone
4981+ BE14              .smFallbackPos:
4982+ BE14 3A 0E 82         LD A, (LastEntryPosX)
4983+ BE17 DD 77 03         LD (IX+ENT_POSX), A
4984+ BE1A 3A 0F 82         LD A, (LastEntryPosY)
4985+ BE1D DD 77 04         LD (IX+ENT_POSY), A
4986+ BE20              .smPosDone:
4987+ BE20 C1               POP BC
4988+ BE21                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
4989+ BE21 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
4990+ BE25 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
4991+ BE29 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
4992+ BE2D DD 36 06 00      LD (IX+ENT_DELTAX), 0
4993+ BE31 DD 36 07 00      LD (IX+ENT_DELTAY), 0
4994+ BE35                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
4995+ BE35                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
4996+ BE35                  ; lo empuje a un vecino (migracion por knockback).
4997+ BE35 CD 96 92         CALL MaiGetCurrentScreenId
4998+ BE38 21 47 90         LD HL, MonsterRoomId
4999+ BE3B 59               LD E, C
5000+ BE3C 16 00            LD D, 0
5001+ BE3E 19               ADD HL, DE
5002+ BE3F 77               LD (HL), A
5003+ BE40              .smSkip:
5004+ BE40 11 10 00         LD DE, ENT_SIZE
5005+ BE43 DD 19            ADD IX, DE
5006+ BE45 C1               POP BC
5007+ BE46 0C               INC C
5008+ BE47 05               DEC B
5009+ BE48 C2 DF BD         JP NZ, .smLoop
5010+ BE4B 3E 14            LD A, MONSTER_ENTRY_BASE
5011+ BE4D 32 98 BF         LD (TryRespawnMonsters.rmTimer), A
5012+ BE50 C9               RET
5013+ BE51
5014+ BE51              ; --- Barajar tablas tipo/color ---
5015+ BE51              ShuffleMonsterTypes:
5016+ BE51 ED 5F            LD A, R
5017+ BE53 E6 03            AND 3
5018+ BE55 C8               RET Z
5019+ BE56 FE 01            CP 1
5020+ BE58 28 21            JR Z, .shSwap01
5021+ BE5A FE 02            CP 2
5022+ BE5C 28 3A            JR Z, .shSwap12
5023+ BE5E 3A B5 BE         LD A, (MonsterTypeTable)
5024+ BE61 57               LD D, A
5025+ BE62 3A B7 BE         LD A, (MonsterTypeTable + 2)
5026+ BE65 32 B5 BE         LD (MonsterTypeTable), A
5027+ BE68 7A               LD A, D
5028+ BE69 32 B7 BE         LD (MonsterTypeTable + 2), A
5029+ BE6C 3A B8 BE         LD A, (MonsterColorTable)
5030+ BE6F 57               LD D, A
5031+ BE70 3A BA BE         LD A, (MonsterColorTable + 2)
5032+ BE73 32 B8 BE         LD (MonsterColorTable), A
5033+ BE76 7A               LD A, D
5034+ BE77 32 BA BE         LD (MonsterColorTable + 2), A
5035+ BE7A C9               RET
5036+ BE7B              .shSwap01:
5037+ BE7B 3A B5 BE         LD A, (MonsterTypeTable)
5038+ BE7E 57               LD D, A
5039+ BE7F 3A B6 BE         LD A, (MonsterTypeTable + 1)
5040+ BE82 32 B5 BE         LD (MonsterTypeTable), A
5041+ BE85 7A               LD A, D
5042+ BE86 32 B6 BE         LD (MonsterTypeTable + 1), A
5043+ BE89 3A B8 BE         LD A, (MonsterColorTable)
5044+ BE8C 57               LD D, A
5045+ BE8D 3A B9 BE         LD A, (MonsterColorTable + 1)
5046+ BE90 32 B8 BE         LD (MonsterColorTable), A
5047+ BE93 7A               LD A, D
5048+ BE94 32 B9 BE         LD (MonsterColorTable + 1), A
5049+ BE97 C9               RET
5050+ BE98              .shSwap12:
5051+ BE98 3A B6 BE         LD A, (MonsterTypeTable + 1)
5052+ BE9B 57               LD D, A
5053+ BE9C 3A B7 BE         LD A, (MonsterTypeTable + 2)
5054+ BE9F 32 B6 BE         LD (MonsterTypeTable + 1), A
5055+ BEA2 7A               LD A, D
5056+ BEA3 32 B7 BE         LD (MonsterTypeTable + 2), A
5057+ BEA6 3A B9 BE         LD A, (MonsterColorTable + 1)
5058+ BEA9 57               LD D, A
5059+ BEAA 3A BA BE         LD A, (MonsterColorTable + 2)
5060+ BEAD 32 B9 BE         LD (MonsterColorTable + 1), A
5061+ BEB0 7A               LD A, D
5062+ BEB1 32 BA BE         LD (MonsterColorTable + 2), A
5063+ BEB4 C9               RET
5064+ BEB5
5065+ BEB5              MonsterTypeTable:
5066+ BEB5 4C               DEFB SPRID_MONSTER_0
5067+ BEB6 54               DEFB SPRID_MONSTER_1
5068+ BEB7 5C               DEFB SPRID_MONSTER_2
5069+ BEB8              MonsterColorTable:
