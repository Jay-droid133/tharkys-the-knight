2161+ AAA4              ; CheckWellPickup - Recupera salud y stamina si el player pisa un pozo
2162+ AAA4              ; ==============================================================================
2163+ AAA4              CheckWellPickup:
2164+ AAA4 3A 57 8D         LD A, (WellActive)
2165+ AAA7 B7               OR A
2166+ AAA8 C8               RET Z                               ; No hay pozo en esta pantalla
2167+ AAA9                  ; Cooldown activo? No curar (pozo "agotado" visual en blanco)
2168+ AAA9 2A 5B 8D         LD HL, (WellCooldownTimer)
2169+ AAAC 7C               LD A, H
2170+ AAAD B5               OR L
2171+ AAAE C0               RET NZ                              ; timer > 0 → skip
2172+ AAAF                  ; Ya esta al maximo? No hacer nada
2173+ AAAF 3A 0C B3         LD A, (PlayerHealth)
2174+ AAB2 FE 10            CP HEALTH_MAX
2175+ AAB4 20 06            JR NZ, .cwDoCheck
