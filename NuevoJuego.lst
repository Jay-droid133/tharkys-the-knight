5534+ BE5F                  ; === AABB CUERPO (16px, sin espada) ===
5535+ BE5F                  ; playerBodyX = ENT_POSX siempre (cuerpo), playerBodyW = 16
5536+ BE5F DD 7E 03         LD A, (IX+ENT_POSX)
