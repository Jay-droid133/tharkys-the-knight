 935+ FC44              ; ==============================================================================
 936+ FC44              ; Sprites de la mano "No no" — 16x16 px (2x2 chars), 2 frames
 937+ FC44              ; ==============================================================================
 938+ FC44              ; Importado de References/nono01.aseprite via tools/import_smoke.py-style
 939+ FC44              ; pipeline. Formato compatible con DrawBgSprite16XorAtPixel:
 940+ FC44              ;   - Header 2B: height_px=16, width_bytes=2.
 941+ FC44              ;   - Pixel data 32B: 16 filas x 2 bytes, CPL'd (engine re-CPL al draw).
 942+ FC44              ;
 943+ FC44              ; Mismo bank que el cuerpo del cutscene (bank 0 default). Tamaño total 68 B.
 944+ FC44              ; Frame 0 = mano hacia un lado, Frame 1 = espejada → swap rápido = "no no".
 945+ FC44              ; ==============================================================================
 946+ FC44              BgGfx_BankHandFrame0:
 947+ FC44 10 02            DEFB 16, 2                              ; height_px, width_bytes
 948+ FC46 F9 FF F8 FF      DEFB $F9,$FF, $F8,$FF, $FC,$7F, $FE,$FF
 948+ FC4A FC 7F FE FF
 949+ FC4E F9 BF F8 9F      DEFB $F9,$BF, $F8,$9F, $E4,$8F, $E3,$CF
 949+ FC52 E4 8F E3 CF
 950+ FC56 F3 0F FC 1F      DEFB $F3,$0F, $FC,$1F, $F8,$1F, $FC,$3F
 950+ FC5A F8 1F FC 3F
 951+ FC5E FF FF F0 17      DEFB $FF,$FF, $F0,$17, $F0,$0F, $FF,$FF
 951+ FC62 F0 0F FF FF
 952+ FC66
 953+ FC66              BgGfx_BankHandFrame1:
 954+ FC66 10 02            DEFB 16, 2                              ; height_px, width_bytes
 955+ FC68 FF CF FF 8F      DEFB $FF,$CF, $FF,$8F, $FF,$1F, $F9,$BF
 955+ FC6C FF 1F F9 BF
 956+ FC70 F8 DF E4 9F      DEFB $F8,$DF, $E4,$9F, $E3,$8F, $F3,$CF
 956+ FC74 E3 8F F3 CF
 957+ FC78 FE 0F F0 1F      DEFB $FE,$0F, $F0,$1F, $F8,$3F, $F8,$7F
 957+ FC7C F8 3F F8 7F
 958+ FC80 FF FF E0 2F      DEFB $FF,$FF, $E0,$2F, $E0,$1F, $FF,$FF
 958+ FC84 E0 1F FF FF
