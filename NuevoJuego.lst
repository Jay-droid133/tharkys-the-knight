 138  675D
 139  675D                  ; --- Rutinas de paginacion (paging.asm) ---
 140  675D                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 141  675D                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 142  675D                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 143  675D                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 144  675D                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 145  675D                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 146  675D                  ; criterio (siempre visible) pero contended.
 147  675D                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 148  675D                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 149  675D                  ; el inner loop, asi que el overhead es invisible.
 150  675D                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 675D              ; ==============================================================================
   2+ 675D              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 675D              ; ==============================================================================
   4+ 675D              ; Port $7FFD (write-only):
   5+ 675D              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 675D              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 675D              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 675D              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 675D              ;
  10+ 675D              ; Bancos disponibles:
  11+ 675D              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 675D              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 675D              ;   Bank 1: libre para datos nuevos (contended)
  14+ 675D              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 675D              ;   Bank 3: libre para datos nuevos (contended)
  16+ 675D              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 675D              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 675D              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 675D              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 675D              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 675D              ; ==============================================================================
  22+ 675D
  23+ 675D              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 675D              ; para no machacarse a si mismas al cambiar de banco.
  25+ 675D
  26+ 675D              ; ==============================================================================
  27+ 675D              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 675D              ; ==============================================================================
  29+ 675D              ; Entrada: A = banco (0-7)
  30+ 675D              ; Preserva: HL, DE, IX, IY
  31+ 675D              ; Destruye: A, BC
  32+ 675D              ; ==============================================================================
  33+ 675D              PageBankSlot3:
  34+ 675D E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 675F 47               LD B, A                     ; guardar banco nuevo
  36+ 6760 3A 7B 8D         LD A, (CurrentPaging)
  37+ 6763 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6765 B0               OR B                        ; poner nuevo banco
  39+ 6766 32 7B 8D         LD (CurrentPaging), A
  40+ 6769 01 FD 7F         LD BC, $7FFD
  41+ 676C ED 79            OUT (C), A
  42+ 676E C9               RET
  43+ 676F
  44+ 676F              ; ==============================================================================
  45+ 676F              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 676F              ; ==============================================================================
  47+ 676F              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 676F              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 676F              ; ==============================================================================
  50+ 676F              InitPaging:
  51+ 676F 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6771 32 7B 8D         LD (CurrentPaging), A
  53+ 6774 01 FD 7F         LD BC, $7FFD
  54+ 6777 ED 79            OUT (C), A
  55+ 6779 C9               RET
  56+ 677A
  57+ 677A              ; ==============================================================================
  58+ 677A              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 677A              ; ==============================================================================
  60+ 677A              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 677A              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 677A              ;      Paginacion restaurada a bank 0.
  63+ 677A              ; Destruye: A, BC, DE, HL
  64+ 677A              ;
  65+ 677A              ; Formato del room en FUENTE (variable-length):
  66+ 677A              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 677A              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 677A              ;   terminador:                  DEFB $FF
  69+ 677A              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 677A              ;
  71+ 677A              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 677A              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 677A              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 677A              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 677A              ; ==============================================================================
  76+ 677A              LoadRoomToBuffer:
  77+ 677A                  ; El stack normal vive en slot 3 ($FF58). Mientras paginamos slot 3 al
  78+ 677A                  ; bank de datos, el stack normal queda fisicamente "oculto" (pero intacto
  79+ 677A                  ; en bank 0). Si una IRQ entra durante el LDIR, su PUSH PC iria al bank
  80+ 677A                  ; de datos -> corrupcion del room data que estamos leyendo.
  81+ 677A                  ;
  82+ 677A                  ; Solucion: cambiar SP a un buffer alterno en slot 1 (siempre visible)
  83+ 677A                  ; durante la copia. Asi las IRQs siguen procesandose normalmente y el
  84+ 677A                  ; tick de musica no pierde frames durante DrawScreen / transiciones.
  85+ 677A                  ;
  86+ 677A                  ; INLINEAMOS el page-switch (sin CALL intermedios) porque al inicio el
  87+ 677A                  ; SP aun apunta al stack normal con la PC del CALL pushed; un CALL aqui
  88+ 677A                  ; usaria stack normal y no podriamos garantizar atomicidad.
  89+ 677A ED 73 C8 67      LD (.lrbSavedSP), SP            ; salva SP normal (con PC + caller frame)
  90+ 677E 31 D6 68         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
  91+ 6781                  ; --- Page bank 1 en slot 3 (inline, SIN DI) ---
  92+ 6781 3A 7B 8D         LD A, (CurrentPaging)
  93+ 6784 E6 F8            AND $F8
  94+ 6786 F6 01            OR 1
  95+ 6788 32 7B 8D         LD (CurrentPaging), A
  96+ 678B 01 FD 7F         LD BC, $7FFD
  97+ 678E ED 79            OUT (C), A                      ; slot 3 = bank 1
  98+ 6790                  ; --- Copy + decompress loop ---
  99+ 6790                  ; HL = source (Room_Txx en bank 1, formato variable)
 100+ 6790                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
 101+ 6790 11 EE 85         LD DE, CurrentScreenBuffer
 102+ 6793              .lrbLoop:
 103+ 6793 7E               LD A, (HL)                      ; id
 104+ 6794 12               LD (DE), A
 105+ 6795 23               INC HL
 106+ 6796 13               INC DE
 107+ 6797 FE FF            CP $FF                          ; terminador?
 108+ 6799 28 1B            JR Z, .lrbDone
 109+ 679B                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 110+ 679B                  ; al buffer escribimos x limpio (AND $7F).
 111+ 679B 7E               LD A, (HL)
 112+ 679C 23               INC HL
 113+ 679D 47               LD B, A                         ; B = x raw (con flag)
 114+ 679E E6 7F            AND $7F
 115+ 67A0 12               LD (DE), A                      ; buffer: x limpio 0-31
 116+ 67A1 13               INC DE
 117+ 67A2                  ; Copiar y
 118+ 67A2 7E               LD A, (HL)
 119+ 67A3 12               LD (DE), A
 120+ 67A4 23               INC HL
 121+ 67A5 13               INC DE
 122+ 67A6                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 123+ 67A6 CB 78            BIT 7, B
 124+ 67A8 28 06            JR Z, .lrbNoTint
 125+ 67AA 7E               LD A, (HL)                      ; v desde source
 126+ 67AB 23               INC HL
 127+ 67AC 12               LD (DE), A
 128+ 67AD 13               INC DE
 129+ 67AE 18 E3            JR .lrbLoop
 130+ 67B0              .lrbNoTint:
 131+ 67B0 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 132+ 67B2 12               LD (DE), A
 133+ 67B3 13               INC DE
 134+ 67B4 18 DD            JR .lrbLoop
 135+ 67B6              .lrbDone:
 136+ 67B6                  ; --- Page bank 0 en slot 3 (inline) ---
 137+ 67B6 3A 7B 8D         LD A, (CurrentPaging)
 138+ 67B9 E6 F8            AND $F8                         ; bank 0
 139+ 67BB 32 7B 8D         LD (CurrentPaging), A
 140+ 67BE 01 FD 7F         LD BC, $7FFD
 141+ 67C1 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack normal accesible
 142+ 67C3 ED 7B C8 67      LD SP, (.lrbSavedSP)            ; restaurar SP al stack normal
 143+ 67C7 C9               RET
