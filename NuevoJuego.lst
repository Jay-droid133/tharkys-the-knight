4920+ BCCD              ; ==============================================================================
4921+ BCCD              ; KillAllActiveNasties - Todos los nasties activos pasan a STATE_DYING
4922+ BCCD              ; ==============================================================================
4923+ BCCD              ; Llamado al terminar la ultima campanada: los nasties que sigan vivos en
4924+ BCCD              ; pantalla mueren (puff anim). Ignora slots vacios, ya dying/spawning.
4925+ BCCD              ; ==============================================================================
4926+ BCCD              KillAllActiveNasties:
4927+ BCCD DD 21 0B 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
4928+ BCD1 06 04            LD B, NUM_NASTIES
4929+ BCD3              .kanLoop:
4930+ BCD3 C5               PUSH BC
4931+ BCD4 DD 7E 01         LD A, (IX+ENT_TYPE)
4932+ BCD7 B7               OR A
4933+ BCD8 28 26            JR Z, .kanSkip                  ; slot vacio
4934+ BCDA FE 03            CP TYPE_NASTY
4935+ BCDC 20 22            JR NZ, .kanSkip                 ; no es nasty
4936+ BCDE DD 7E 02         LD A, (IX+ENT_STATE)
4937+ BCE1 FE 03            CP STATE_DYING
4938+ BCE3 28 1B            JR Z, .kanSkip                  ; ya muriendo
4939+ BCE5                  ; SPAWNING no se skipea: peDying erasea OLDSPRID (= spawn frame actual)
4940+ BCE5                  ; y dibuja puff. La muerte del player debe limpiar nasties medio-spawneados.
4941+ BCE5                  ; Transicionar a STATE_DYING con puff (ENT_ATTR queda con el color
4942+ BCE5                  ; del nasty: peDying paintea el rect del puff con ese color)
4943+ BCE5 CD 09 BD         CALL SnapPuffPos                ; ajusta POSX/POSY a hueco 24x24 cercano
4944+ BCE8 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
4945+ BCEC DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
4946+ BCF0 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
4947+ BCF4 DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
4948+ BCF8 DD 36 06 00      LD (IX+ENT_DELTAX), 0
4949+ BCFC DD 36 07 00      LD (IX+ENT_DELTAY), 0
4950+ BD00              .kanSkip:
4951+ BD00 11 10 00         LD DE, ENT_SIZE
4952+ BD03 DD 19            ADD IX, DE
4953+ BD05 C1               POP BC
4954+ BD06 10 CB            DJNZ .kanLoop
4955+ BD08 C9               RET
4956+ BD09
4957+ BD09              ; ==============================================================================
4958+ BD09              ; SnapPuffPos - Ajusta POSX/POSY del nasty para que el puff 24x24 quepa en BG
4959+ BD09              ; ==============================================================================
4960+ BD09              ; Llamado al transicionar a STATE_DYING con puff (KillAllActiveNasties + sword
4961+ BD09              ; hit + player hit destructible). Si la posicion actual ya cabe 24x24, no
4962+ BD09              ; cambia nada. Si no, busca un hueco 24x24-clear en orden de distancia
4963+ BD09              ; creciente (Y arriba/abajo +/-8/+/-16, luego X laterales). Si nada cabe,
4964+ BD09              ; deja la posicion original (puff puede asomar levemente, raro).
4965+ BD09              ; IN:  IX = nasty entity.
4966+ BD09              ; OUT: IX+ENT_POSX/POSY pueden modificarse.
4967+ BD09              ; Destruye: AF, BC, DE, HL.
4968+ BD09              ; ==============================================================================
4969+ BD09              SnapPuffPos:
4970+ BD09 DD 7E 03         LD A, (IX+ENT_POSX)
4971+ BD0C 32 7F BD         LD (.sppOrigX), A
4972+ BD0F E6 F8            AND $F8
4973+ BD11 32 81 BD         LD (.sppBaseX), A                   ; base char-aligned X
4974+ BD14 DD 7E 04         LD A, (IX+ENT_POSY)
4975+ BD17 32 80 BD         LD (.sppOrigY), A
4976+ BD1A E6 F8            AND $F8
4977+ BD1C 32 82 BD         LD (.sppBaseY), A                   ; base char-aligned Y
4978+ BD1F
4979+ BD1F                  ; 1) Probar la posicion original (puede caber si las 4 char-rows estan libres)
4980+ BD1F CD 53 BD         CALL .sppCheckFit
4981+ BD22 C8               RET Z
4982+ BD23
4983+ BD23                  ; 2) Probar shifts desde la base char-aligned. Asi cada candidato cubre
4984+ BD23                  ;    exactamente 3x3 chars (no 4x4 por desalineamiento).
4985+ BD23 21 83 BD         LD HL, .sppShifts
4986+ BD26              .sppLoop:
4987+ BD26 7E               LD A, (HL)
4988+ BD27 23               INC HL
4989+ BD28 47               LD B, A                             ; dx (signed)
4990+ BD29 7E               LD A, (HL)
4991+ BD2A 23               INC HL
4992+ BD2B FE 80            CP $80
4993+ BD2D 28 17            JR Z, .sppFail                      ; sentinel
4994+ BD2F 4F               LD C, A                             ; dy (signed)
4995+ BD30
4996+ BD30 3A 81 BD         LD A, (.sppBaseX)
4997+ BD33 80               ADD A, B
4998+ BD34 DD 77 03         LD (IX+ENT_POSX), A
4999+ BD37 3A 82 BD         LD A, (.sppBaseY)
5000+ BD3A 81               ADD A, C
5001+ BD3B DD 77 04         LD (IX+ENT_POSY), A
5002+ BD3E
5003+ BD3E E5               PUSH HL
5004+ BD3F CD 53 BD         CALL .sppCheckFit
5005+ BD42 E1               POP HL
5006+ BD43 C8               RET Z                               ; encontrado
5007+ BD44 18 E0            JR .sppLoop
5008+ BD46
5009+ BD46              .sppFail:
5010+ BD46 3A 7F BD         LD A, (.sppOrigX)
5011+ BD49 DD 77 03         LD (IX+ENT_POSX), A
5012+ BD4C 3A 80 BD         LD A, (.sppOrigY)
5013+ BD4F DD 77 04         LD (IX+ENT_POSY), A
5014+ BD52 C9               RET
5015+ BD53
5016+ BD53              ; --- .sppCheckFit ---
5017+ BD53              ; Z si todas las celdas del bbox 24x24 en (POSX,POSY) son libres en
5018+ BD53              ; CollisionMap y dentro de pantalla; NZ si alguna bloqueada o fuera de bounds.
5019+ BD53              ; Reusa CheckEnemyCollision (que itera TODAS las celdas del bbox) seteando
5020+ BD53              ; temporalmente SPRITEID = SPRID_PUFF (24x24). Esto cubre tanto el caso
5021+ BD53              ; aligned (3x3 chars) como shifted (4x3 chars, overflow byte incluido).
5022+ BD53              .sppCheckFit:
5023+ BD53                  ; Bounds: POSX en [0..SCREEN_MAX_X-24], POSY en [SCREEN_MIN_Y..SCREEN_MAX_Y-24]
5024+ BD53 DD 7E 03         LD A, (IX+ENT_POSX)
5025+ BD56 FE D1            CP SCREEN_MAX_X - 23
5026+ BD58 30 21            JR NC, .sppOutOfBounds
5027+ BD5A DD 7E 04         LD A, (IX+ENT_POSY)
5028+ BD5D FE 10            CP SCREEN_MIN_Y
5029+ BD5F 38 1A            JR C, .sppOutOfBounds
5030+ BD61 FE 91            CP SCREEN_MAX_Y - 23
5031+ BD63 30 16            JR NC, .sppOutOfBounds
5032+ BD65                  ; Reusa CheckEnemyCollision con SPRID_PUFF (24x24) temporal
5033+ BD65 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5034+ BD68 32 7E BD         LD (.sppSpritIdSave), A
5035+ BD6B DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5036+ BD6F CD 5D B9         CALL CheckEnemyCollision            ; Z = libre, NZ = bloqueado
5037+ BD72 F5               PUSH AF
5038+ BD73 3A 7E BD         LD A, (.sppSpritIdSave)
5039+ BD76 DD 77 00         LD (IX+ENT_SPRITEID), A
5040+ BD79 F1               POP AF
5041+ BD7A C9               RET
5042+ BD7B              .sppOutOfBounds:
5043+ BD7B F6 01            OR 1                                ; NZ
5044+ BD7D C9               RET
5045+ BD7E
5046+ BD7E 00           .sppSpritIdSave: DEFB 0
5047+ BD7F
5048+ BD7F 00           .sppOrigX: DEFB 0
5049+ BD80 00           .sppOrigY: DEFB 0
5050+ BD81 00           .sppBaseX: DEFB 0
5051+ BD82 00           .sppBaseY: DEFB 0
5052+ BD83              .sppShifts:
5053+ BD83                  ; Pares (dx, dy) signed bytes, desde la base char-aligned.
5054+ BD83                  ; Distancia creciente. Sentinel: dy=$80.
5055+ BD83 00 00            DEFB 0,    0                        ; pura alineacion (orig redondeado a char)
5056+ BD85 00 F8            DEFB 0,   -8                        ; arriba 8
5057+ BD87 00 08            DEFB 0,    8                        ; abajo 8
5058+ BD89 F8 00            DEFB -8,   0                        ; izq 8
5059+ BD8B 08 00            DEFB 8,    0                        ; der 8
5060+ BD8D 00 F0            DEFB 0,  -16                        ; arriba 16
5061+ BD8F 00 10            DEFB 0,   16                        ; abajo 16
5062+ BD91 F8 F8            DEFB -8,  -8
5063+ BD93 08 F8            DEFB 8,   -8
5064+ BD95 F8 08            DEFB -8,   8
5065+ BD97 08 08            DEFB 8,    8
5066+ BD99 00 80            DEFB 0,  $80                        ; sentinel
5067+ BD9B
5068+ BD9B              ; ==============================================================================
5069+ BD9B              ; SilentKillDeath - Despawn instantaneo del entity TYPE_DEATH (slot 11) sin puff
5070+ BD9B              ; ==============================================================================
5071+ BD9B              ; Llamado al morir el player: la muerte desaparece a la vez que los nasties,
5072+ BD9B              ; pero sin animacion (los nasties hacen puff, ella no — el puff puede confundir
5073+ BD9B              ; con el efecto del player). Erasa el sprite, libera el slot y resetea
5074+ BD9B              ; DeathSpawned. No-op si la muerte no esta activa.
5075+ BD9B              ; ==============================================================================
5076+ BD9B              SilentKillDeath:
5077+ BD9B DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
5078+ BD9F DD 7E 01         LD A, (IX+ENT_TYPE)
5079+ BDA2 B7               OR A
5080+ BDA3 28 0A            JR Z, .skdResetTimer                ; ya inactiva, solo asegurar timer=0
5081+ BDA5 CD 9C C9         CALL EraseDeathSprite               ; quitar sprite + restaurar attrs
5082+ BDA8 AF               XOR A
5083+ BDA9 DD 77 01         LD (IX+ENT_TYPE), A
5084+ BDAC 32 FA 82         LD (DeathSpawned), A
5085+ BDAF              .skdResetTimer:
5086+ BDAF                  ; Resetear contador para que no respawnee inmediatamente. La gracia
5087+ BDAF                  ; correcta arranca cuando el player recupera el control (urb1LastBeat).
5088+ BDAF 21 00 00         LD HL, 0
5089+ BDB2 22 F7 82         LD (DeathScreenTimer), HL
5090+ BDB5                  ; OJO: NO hacemos stop de musica aqui. Esta rutina la llama
5091+ BDB5                  ; OnPlayerHealthDepleted DESPUES de AY_PlayPlayerDeath; un mute R9 ahora
5092+ BDB5                  ; mataria el sweep recien arrancado. Los callers que necesiten parar la
5093+ BDB5                  ; musica (TriggerChurchTrap) lo hacen explicitamente. Para el caso "Death
5094+ BDB5                  ; despawnea via puff" usar KillDeathIfActive (esa SI hace stop).
5095+ BDB5 C9               RET
5096+ BDB6
5097+ BDB6              ; ==============================================================================
5098+ BDB6              ; FreezeMonstersFacingCorpse - Para los monsters mirando al cadaver del player
5099+ BDB6              ; ==============================================================================
5100+ BDB6              ; Llamado desde OnPlayerHealthDepleted. Para cada monster activo (TYPE_MONSTER,
5101+ BDB6              ; no DYING ni SPAWNING):
5102+ BDB6              ;   - Set sprite a idle facing-corpse (R o L segun lado del cadaver)
5103+ BDB6              ;   - Si esta dentro de 16px (2 celdas) en X e Y del cadaver, retrocede 16px en
5104+ BDB6              ;     el eje dominante. Evita walls (CheckEnemyCollision) y otros monsters ya
5105+ BDB6              ;     posicionados (CheckMonsterOverlap). Si no cabe, prueba el otro eje.
5106+ BDB6              ;     Si tampoco, deja el monster donde estaba.
5107+ BDB6              ;   - Set DELTAX=DELTAY=0, DIR=0 (clear stun), STATE=STATE_IDLE
5108+ BDB6              ; Tras llamar, MonstersFrozen=1 -> ProcessOneEnemy gate skipea AI; al frame
5109+ BDB6              ; siguiente .peCalcAndDraw detecta cambio de SPRITEID/POSX y hace erase+draw.
5110+ BDB6              ; UnfreezeMonsters (en urb1LastBeat) limpia el flag al recuperar control.
5111+ BDB6              ; ==============================================================================
5112+ BDB6              FreezeMonstersFacingCorpse:
5113+ BDB6                  ; Snapshot de la posicion del cadaver (= player POSX/POSY al morir)
5114+ BDB6 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5115+ BDB9 32 F1 82         LD (CorpseX), A
5116+ BDBC 3A 9F 81         LD A, (EntityTable + ENT_POSY)
5117+ BDBF 32 F2 82         LD (CorpseY), A
5118+ BDC2                  ; Activar gate ANTES de iterar (asi cualquier ProcessOneEnemy concurrente
5119+ BDC2                  ; ya skipea; no aplica aqui pero por simetria)
5120+ BDC2 3E 01            LD A, 1
5121+ BDC4 32 F0 82         LD (MonstersFrozen), A
5122+ BDC7 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5123+ BDCB 06 06            LD B, NUM_MONSTERS
5124+ BDCD              .fmcLoop:
5125+ BDCD C5               PUSH BC
5126+ BDCE DD 7E 01         LD A, (IX+ENT_TYPE)
5127+ BDD1 FE 02            CP TYPE_MONSTER
5128+ BDD3 20 0E            JR NZ, .fmcNext
5129+ BDD5 DD 7E 02         LD A, (IX+ENT_STATE)
5130+ BDD8 FE 03            CP STATE_DYING
5131+ BDDA 28 07            JR Z, .fmcNext
5132+ BDDC FE 04            CP STATE_SPAWNING
5133+ BDDE 28 03            JR Z, .fmcNext
5134+ BDE0 CD EC BD         CALL FreezeOneMonster
5135+ BDE3              .fmcNext:
5136+ BDE3 C1               POP BC
5137+ BDE4 11 10 00         LD DE, ENT_SIZE
5138+ BDE7 DD 19            ADD IX, DE
5139+ BDE9 10 E2            DJNZ .fmcLoop
5140+ BDEB C9               RET
5141+ BDEC
5142+ BDEC              ; --- FreezeOneMonster ---
5143+ BDEC              ; IX = monster slot pointer.
5144+ BDEC              ; Ajusta facing/sprite, retrocede si esta cerca, deja al monster en idle parado.
5145+ BDEC              ; Nota: para monsters, ENT_DIR es el contador de stun (no lastHDir como en el
5146+ BDEC              ; player). La facing visual va sólo en SPRITEID (= ANIMBASE + 0 right / +4 left).
5147+ BDEC              FreezeOneMonster:
5148+ BDEC                  ; --- 1) Determinar facing y set SPRITEID a frame idle ---
5149+ BDEC                  ; CorpseX <= POSX -> corpse a la W del monster -> mirar W (left)
5150+ BDEC                  ; CorpseX  > POSX -> corpse a la E del monster -> mirar E (right)
5151+ BDEC DD 7E 03         LD A, (IX+ENT_POSX)
5152+ BDEF 47               LD B, A
5153+ BDF0 3A F1 82         LD A, (CorpseX)
5154+ BDF3 B8               CP B
5155+ BDF4 28 0C            JR Z, .fomFaceW                 ; tied: usar W por convencion
5156+ BDF6 38 0A            JR C, .fomFaceW                 ; corpseX < posX -> W
5157+ BDF8              .fomFaceE:
5158+ BDF8 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5159+ BDFB C6 00            ADD A, MONSTER_FRAMES_RIGHT     ; +0 = R0
5160+ BDFD DD 77 00         LD (IX+ENT_SPRITEID), A
5161+ BE00 18 08            JR .fomFaceDone
5162+ BE02              .fomFaceW:
5163+ BE02 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5164+ BE05 C6 04            ADD A, MONSTER_FRAMES_LEFT      ; +4 = L0
5165+ BE07 DD 77 00         LD (IX+ENT_SPRITEID), A
5166+ BE0A              .fomFaceDone:
5167+ BE0A
5168+ BE0A                  ; --- 2) Computar |dx| y |dy| ---
5169+ BE0A 3A F1 82         LD A, (CorpseX)
5170+ BE0D 4F               LD C, A
5171+ BE0E DD 7E 03         LD A, (IX+ENT_POSX)
5172+ BE11 91               SUB C                           ; A = posX - corpseX (signed)
5173+ BE12 30 02            JR NC, .fomDxPos
5174+ BE14 ED 44            NEG
5175+ BE16              .fomDxPos:
5176+ BE16 32 67 BE         LD (.fomAdx), A
5177+ BE19 3A F2 82         LD A, (CorpseY)
5178+ BE1C 4F               LD C, A
5179+ BE1D DD 7E 04         LD A, (IX+ENT_POSY)
5180+ BE20 91               SUB C
5181+ BE21 30 02            JR NC, .fomDyPos
5182+ BE23 ED 44            NEG
5183+ BE25              .fomDyPos:
5184+ BE25 32 68 BE         LD (.fomAdy), A
5185+ BE28
5186+ BE28                  ; --- 3) Si |dx|>=16 OR |dy|>=16 -> ya esta lejos, no retrocede ---
5187+ BE28 3A 67 BE         LD A, (.fomAdx)
5188+ BE2B FE 10            CP 16
5189+ BE2D D2 56 BE         JP NC, .fomFreeze
5190+ BE30 3A 68 BE         LD A, (.fomAdy)
5191+ BE33 FE 10            CP 16
5192+ BE35 D2 56 BE         JP NC, .fomFreeze
5193+ BE38
5194+ BE38                  ; --- 4) Backoff: eje dominante = mayor |delta|; tie -> X ---
5195+ BE38 3A 67 BE         LD A, (.fomAdx)
5196+ BE3B 47               LD B, A
5197+ BE3C 3A 68 BE         LD A, (.fomAdy)
5198+ BE3F B8               CP B                            ; A=|dy|, B=|dx|; CY si |dy|<|dx|
5199+ BE40 38 0C            JR C, .fomTryX
5200+ BE42 28 0A            JR Z, .fomTryX
5201+ BE44                  ; |dy| > |dx| -> intentar Y primero
5202+ BE44 CD 9C BE         CALL TryBackoffY
5203+ BE47 28 0D            JR Z, .fomFreeze                ; ok
5204+ BE49 CD 69 BE         CALL TryBackoffX
5205+ BE4C 18 08            JR .fomFreeze
5206+ BE4E              .fomTryX:
5207+ BE4E CD 69 BE         CALL TryBackoffX
5208+ BE51 28 03            JR Z, .fomFreeze
5209+ BE53 CD 9C BE         CALL TryBackoffY
5210+ BE56
5211+ BE56              .fomFreeze:
5212+ BE56                  ; Detener movimiento, clear stun (DIR=0), state IDLE.
5213+ BE56                  ; Facing ya esta en SPRITEID (= ANIMBASE+0 right o +4 left).
5214+ BE56 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5215+ BE5A DD 36 07 00      LD (IX+ENT_DELTAY), 0
5216+ BE5E DD 36 0A 00      LD (IX+ENT_DIR), 0
5217+ BE62 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5218+ BE66 C9               RET
5219+ BE67
5220+ BE67 00           .fomAdx: DEFB 0
5221+ BE68 00           .fomAdy: DEFB 0
5222+ BE69
5223+ BE69              ; --- TryBackoffX: intenta retroceder 16px en X. Z=ok, NZ=blocked ---
5224+ BE69              ; IX = monster slot. Si OK, POSX queda actualizada. Si blocked, restaura POSX.
5225+ BE69              TryBackoffX:
5226+ BE69 DD 7E 03         LD A, (IX+ENT_POSX)
5227+ BE6C 32 9B BE         LD (.tbxSavePos), A
5228+ BE6F 47               LD B, A
5229+ BE70 3A F1 82         LD A, (CorpseX)
5230+ BE73 B8               CP B                            ; A=corpseX, B=posX. CY si corpseX<posX -> push +16
5231+ BE74 DD 7E 03         LD A, (IX+ENT_POSX)
5232+ BE77 30 04            JR NC, .tbxNeg                  ; corpseX>=posX -> push -16
5233+ BE79 C6 10            ADD A, 16
5234+ BE7B 18 02            JR .tbxApply
5235+ BE7D              .tbxNeg:
5236+ BE7D D6 10            SUB 16
5237+ BE7F              .tbxApply:
5238+ BE7F                  ; Bounds check Y mantenido. Verificar X dentro de pantalla [0..SCREEN_MAX_X]
5239+ BE7F DD 77 03         LD (IX+ENT_POSX), A
5240+ BE82 FE E8            CP SCREEN_MAX_X
5241+ BE84 30 0C            JR NC, .tbxFail                 ; fuera por la derecha (incluye underflow >= SCREEN_MAX_X)
5242+ BE86 CD 5D B9         CALL CheckEnemyCollision
5243+ BE89 20 07            JR NZ, .tbxFail
5244+ BE8B CD D3 BE         CALL CheckMonsterOverlap
5245+ BE8E 20 02            JR NZ, .tbxFail
5246+ BE90 AF               XOR A                           ; Z = ok
5247+ BE91 C9               RET
5248+ BE92              .tbxFail:
5249+ BE92 3A 9B BE         LD A, (.tbxSavePos)
5250+ BE95 DD 77 03         LD (IX+ENT_POSX), A
5251+ BE98 F6 01            OR 1                            ; NZ
5252+ BE9A C9               RET
5253+ BE9B 00           .tbxSavePos: DEFB 0
5254+ BE9C
5255+ BE9C              ; --- TryBackoffY: intenta retroceder 16px en Y. Z=ok, NZ=blocked ---
5256+ BE9C              TryBackoffY:
5257+ BE9C DD 7E 04         LD A, (IX+ENT_POSY)
5258+ BE9F 32 D2 BE         LD (.tbySavePos), A
5259+ BEA2 47               LD B, A
5260+ BEA3 3A F2 82         LD A, (CorpseY)
5261+ BEA6 B8               CP B
5262+ BEA7 DD 7E 04         LD A, (IX+ENT_POSY)
5263+ BEAA 30 04            JR NC, .tbyNeg
5264+ BEAC C6 10            ADD A, 16
5265+ BEAE 18 02            JR .tbyApply
5266+ BEB0              .tbyNeg:
5267+ BEB0 D6 10            SUB 16
5268+ BEB2              .tbyApply:
5269+ BEB2 DD 77 04         LD (IX+ENT_POSY), A
5270+ BEB5 FE 10            CP SCREEN_MIN_Y
5271+ BEB7 38 10            JR C, .tbyFail
5272+ BEB9 FE A8            CP SCREEN_MAX_Y
5273+ BEBB 30 0C            JR NC, .tbyFail
5274+ BEBD CD 5D B9         CALL CheckEnemyCollision
5275+ BEC0 20 07            JR NZ, .tbyFail
5276+ BEC2 CD D3 BE         CALL CheckMonsterOverlap
5277+ BEC5 20 02            JR NZ, .tbyFail
5278+ BEC7 AF               XOR A
5279+ BEC8 C9               RET
5280+ BEC9              .tbyFail:
5281+ BEC9 3A D2 BE         LD A, (.tbySavePos)
5282+ BECC DD 77 04         LD (IX+ENT_POSY), A
5283+ BECF F6 01            OR 1
5284+ BED1 C9               RET
5285+ BED2 00           .tbySavePos: DEFB 0
5286+ BED3
5287+ BED3              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5288+ BED3              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5289+ BED3              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5290+ BED3              CheckMonsterOverlap:
5291+ BED3 C5               PUSH BC
5292+ BED4 FD E5            PUSH IY
5293+ BED6 FD 21 AB 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5294+ BEDA 06 06            LD B, NUM_MONSTERS
5295+ BEDC              .cmoLoop:
5296+ BEDC                  ; Skip self (IY == IX)
5297+ BEDC DD E5            PUSH IX
5298+ BEDE E1               POP HL
5299+ BEDF FD E5            PUSH IY
5300+ BEE1 D1               POP DE
5301+ BEE2 B7               OR A
5302+ BEE3 ED 52            SBC HL, DE
5303+ BEE5 28 3D            JR Z, .cmoNext                  ; same slot
5304+ BEE7
5305+ BEE7 FD 7E 01         LD A, (IY+ENT_TYPE)
5306+ BEEA FE 02            CP TYPE_MONSTER
5307+ BEEC 20 36            JR NZ, .cmoNext
5308+ BEEE
5309+ BEEE                  ; AABB overlap (rect 16x21 cada uno):
5310+ BEEE                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5311+ BEEE                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5312+ BEEE DD 7E 03         LD A, (IX+ENT_POSX)
5313+ BEF1 C6 10            ADD A, 16
5314+ BEF3 4F               LD C, A
5315+ BEF4 FD 7E 03         LD A, (IY+ENT_POSX)
5316+ BEF7 B9               CP C                            ; iy.x cmp ix.x+16
5317+ BEF8 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5318+ BEFA FD 7E 03         LD A, (IY+ENT_POSX)
5319+ BEFD C6 10            ADD A, 16
5320+ BEFF 4F               LD C, A
5321+ BF00 DD 7E 03         LD A, (IX+ENT_POSX)
5322+ BF03 B9               CP C
5323+ BF04 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5324+ BF06 DD 7E 04         LD A, (IX+ENT_POSY)
5325+ BF09 C6 15            ADD A, 21
5326+ BF0B 4F               LD C, A
5327+ BF0C FD 7E 04         LD A, (IY+ENT_POSY)
5328+ BF0F B9               CP C
5329+ BF10 30 12            JR NC, .cmoNext
5330+ BF12 FD 7E 04         LD A, (IY+ENT_POSY)
5331+ BF15 C6 15            ADD A, 21
5332+ BF17 4F               LD C, A
5333+ BF18 DD 7E 04         LD A, (IX+ENT_POSY)
5334+ BF1B B9               CP C
5335+ BF1C 30 06            JR NC, .cmoNext
5336+ BF1E                  ; Overlap en ambos ejes
5337+ BF1E FD E1            POP IY
5338+ BF20 C1               POP BC
5339+ BF21 F6 01            OR 1                            ; NZ
5340+ BF23 C9               RET
5341+ BF24              .cmoNext:
5342+ BF24 11 10 00         LD DE, ENT_SIZE
5343+ BF27 FD 19            ADD IY, DE
5344+ BF29 10 B1            DJNZ .cmoLoop
5345+ BF2B FD E1            POP IY
5346+ BF2D C1               POP BC
5347+ BF2E AF               XOR A                           ; Z = no overlap
5348+ BF2F C9               RET
5349+ BF30
5350+ BF30              ; ==============================================================================
5351+ BF30              ; KillAllActiveMonsters - Todos los monsters activos pasan a STATE_DYING
5352+ BF30              ; ==============================================================================
5353+ BF30              ; Llamado al entrar en A2 (amanecer tardio): los monsters que sigan vivos
5354+ BF30              ; mueren con puff. Tambien limpia MonstersActive para evitar respawn.
5355+ BF30              ; ==============================================================================
5356+ BF30              KillAllActiveMonsters:
5357+ BF30 AF               XOR A
5358+ BF31 32 F8 B5         LD (MonstersActive), A              ; No respawnear mas
5359+ BF34 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5360+ BF38 06 06            LD B, NUM_MONSTERS
5361+ BF3A              .kamLoop:
5362+ BF3A C5               PUSH BC
5363+ BF3B DD 7E 01         LD A, (IX+ENT_TYPE)
5364+ BF3E B7               OR A
5365+ BF3F 28 27            JR Z, .kamSkip                      ; slot vacio
5366+ BF41 FE 02            CP TYPE_MONSTER
5367+ BF43 20 23            JR NZ, .kamSkip                     ; no es monster
5368+ BF45 DD 7E 02         LD A, (IX+ENT_STATE)
5369+ BF48 FE 03            CP STATE_DYING
5370+ BF4A 28 1C            JR Z, .kamSkip
5371+ BF4C FE 04            CP STATE_SPAWNING
5372+ BF4E 28 18            JR Z, .kamSkip
5373+ BF50 DD 36 02 03      LD (IX+ENT_STATE), STATE_DYING
5374+ BF54 DD 36 08 40      LD (IX+ENT_ANIMBASE), SPRID_PUFF
5375+ BF58 DD 36 00 40      LD (IX+ENT_SPRITEID), SPRID_PUFF
5376+ BF5C DD 36 09 01      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_PUFF
5377+ BF60 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5378+ BF64 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5379+ BF68                  ; ENT_ATTR conservado: puff hereda color del monster
5380+ BF68              .kamSkip:
5381+ BF68 11 10 00         LD DE, ENT_SIZE
5382+ BF6B DD 19            ADD IX, DE
5383+ BF6D C1               POP BC
5384+ BF6E 10 CA            DJNZ .kamLoop
5385+ BF70 C9               RET
5386+ BF71
5387+ BF71              ; --- Tabla de tipos de nasty (SpriteID base) ---
5388+ BF71              ; --- Tablas de nasties por momento del dia ---
5389+ BF71              NUM_NASTY_TYPES EQU 4
5390+ BF71              DiurnalTypeTable:                       ; DY, C1, A2
5391+ BF71 30               DEFB SPRID_ENEMY_4          ; Eagle
5392+ BF72 20               DEFB SPRID_ENEMY_0          ; Spider
5393+ BF73 38               DEFB SPRID_ENEMY_6          ; Goat (placeholder)
5394+ BF74 2C               DEFB SPRID_ENEMY_3          ; Snake
5395+ BF75              CrepuscularTypeTable:                   ; C2, N1
5396+ BF75 34               DEFB SPRID_ENEMY_5          ; Rat
5397+ BF76 28               DEFB SPRID_ENEMY_2          ; Bat
5398+ BF77 24               DEFB SPRID_ENEMY_1          ; Scorpion
5399+ BF78 3C               DEFB SPRID_ENEMY_7          ; RabidCat (placeholder)
5400+ BF79
5401+ BF79              ; --- Colores por tipo de nasty (indexado por (SPRID - SPRID_ENEMY_0) / 4) ---
5402+ BF79              NastyColorTable:
5403+ BF79 42               DEFB RED | $40              ; Enemy 0: Spider - rojo
5404+ BF7A 43               DEFB MAGENTA | $40          ; Enemy 1: Scorpion - magenta
5405+ BF7B 42               DEFB RED | $40              ; Enemy 2: Bat - rojo
5406+ BF7C 44               DEFB GREEN | $40            ; Enemy 3: Snake - verde
5407+ BF7D 46               DEFB YELLOW | $40           ; Enemy 4: Eagle - amarillo
5408+ BF7E 45               DEFB CYAN | $40             ; Enemy 5: Rat - cyan
5409+ BF7F 45               DEFB CYAN | $40             ; Enemy 6: Goat - cyan
5410+ BF80 01               DEFB BLUE                   ; Enemy 7: RabidCat - azul oscuro
5411+ BF81
5412+ BF81              ; --- Tabla de comportamiento depredador ---
5413+ BF81              ; Indexado por (SPRID - SPRID_ENEMY_0) / 4
5414+ BF81              ; Bits 0-1: tipo (0=none, 1=arriba, 2=abajo, 3=horizontal)
5415+ BF81              ; Bits 2-3: ciclo minimo requerido (1=ciclo1, 2=ciclo2, 3=ciclo3)
5416+ BF81              PredatorTable:
5417+ BF81 00               DEFB PRED_NONE                              ; Enemy 0: Spider - no predador
5418+ BF82 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 1: Scorpion - abajo, ciclo 2
5419+ BF83 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 2: Bat - arriba, ciclo 1
5420+ BF84 0A               DEFB PRED_FROM_BELOW | (2 << 2)             ; Enemy 3: Snake - abajo, ciclo 2
5421+ BF85 05               DEFB PRED_FROM_ABOVE | (1 << 2)             ; Enemy 4: Eagle - arriba, ciclo 1
5422+ BF86 00               DEFB PRED_NONE                              ; Enemy 5: Rat - no predador
5423+ BF87 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 6: Goat - horizontal, ciclo 3
5424+ BF88 0F               DEFB PRED_HORIZONTAL | (3 << 2)             ; Enemy 7: RabidCat - horizontal, ciclo 3
5425+ BF89
5426+ BF89              ; --- Velocidad de ataque por ciclo (indexado por DayCycleCount, cap en 3) ---
5427+ BF89              PredatorSpeedTable:
5428+ BF89 02               DEFB 2                              ; Ciclo 0 (no deberia usarse)
5429+ BF8A 02               DEFB 2                              ; Ciclo 1: lento
5430+ BF8B 03               DEFB 3                              ; Ciclo 2: intermedio
5431+ BF8C 04               DEFB 4                              ; Ciclo 3+: rapido
5432+ BF8D
5433+ BF8D 01           DayCycleCount:  DEFB 1              ; Numero de ciclo actual (empieza en 1)
5434+ BF8E
5435+ BF8E 71 BF        CurrentNastyTable: DEFW DiurnalTypeTable
5436+ BF90
5437+ BF90              ; ==============================================================================
5438+ BF90              ; UpdateNastyTable - Selecciona tabla de nasties segun CurrentTimeOfDay
5439+ BF90              ; ==============================================================================
5440+ BF90              ; Fases 0(DY), 1(C1), 6(A2) → DiurnalTypeTable
5441+ BF90              ; Fases 2(C2), 3(N1), 4(N2), 5(A1) → CrepuscularTypeTable
5442+ BF90              ;   N2 y A1 originalmente sin spawn, pero cuando los 3 monsters estan
5443+ BF90              ;   atrapados TrySpawnNasty levanta el bloqueo y queremos nocturnos en
5444+ BF90              ;   pantalla, no diurnos.
5445+ BF90              ; ==============================================================================
5446+ BF90              UpdateNastyTable:
5447+ BF90 3A 0A E5         LD A, (CurrentTimeOfDay)
5448+ BF93 FE 02            CP 2
5449+ BF95 38 09            JR C, .diurnal              ; 0 (DY), 1 (C1) → diurnos
5450+ BF97 FE 06            CP 6
5451+ BF99 28 05            JR Z, .diurnal              ; 6 (A2) → diurnos
5452+ BF9B 21 75 BF         LD HL, CrepuscularTypeTable ; 2,3,4,5 → crepusculares
5453+ BF9E 18 03            JR .setTable
5454+ BFA0              .diurnal:
5455+ BFA0 21 71 BF         LD HL, DiurnalTypeTable
5456+ BFA3              .setTable:
5457+ BFA3 22 8E BF         LD (CurrentNastyTable), HL
5458+ BFA6 C9               RET
5459+ BFA7
5460+ BFA7              ; ==============================================================================
5461+ BFA7              ; ScareAllMonsters - Monsters huyen al amanecer (como nasties en campanadas)
5462+ BFA7              ; ==============================================================================
5463+ BFA7              ScareAllMonsters:
5464+ BFA7 AF               XOR A
5465+ BFA8 32 F8 B5         LD (MonstersActive), A              ; No respawnear mas
5466+ BFAB                  ; Limpiar MAI_FLAG_LEAVING + MAI_FLAG_SHAKE_SAVED en los 3 slots:
5467+ BFAB                  ; LEAVING → UpdateMonsterLeave elegira gap fresco. SHAKE_SAVED → la pausa
5468+ BFAB                  ; del amanecer capturara el orig POSX/POSY del primer frame.
5469+ BFAB 21 93 90         LD HL, MonsterAiFlags
5470+ BFAE 06 03            LD B, 3
5471+ BFB0              .samClearLoop:
5472+ BFB0 7E               LD A, (HL)
5473+ BFB1 E6 F5            AND ~(MAI_FLAG_LEAVING | MAI_FLAG_SHAKE_SAVED) & $FF
5474+ BFB3 77               LD (HL), A
5475+ BFB4 23               INC HL
5476+ BFB5 10 F9            DJNZ .samClearLoop
5477+ BFB7 3E 7D            LD A, SCARE_TIMER_DAWN
5478+ BFB9 32 8E B8         LD (ScareTimer), A
5479+ BFBC                  ; Transicion eager a STATE_SCARED para los 3 monsters activos. Sin esto el
5480+ BFBC                  ; round-robin de ProcessEnemies (2/frame) tarda hasta ~5 frames en mover
5481+ BFBC                  ; cada monster a STATE_SCARED, y durante ese gap el sprite aun esta en
5482+ BFBC                  ; STATE_RUNNING y haria daño al player aunque ya este temblando.
5483+ BFBC DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5484+ BFC0 06 06            LD B, NUM_MONSTERS
5485+ BFC2              .samStateLoop:
5486+ BFC2 DD 7E 01         LD A, (IX+ENT_TYPE)
5487+ BFC5 FE 02            CP TYPE_MONSTER
5488+ BFC7 20 1B            JR NZ, .samStateNext
5489+ BFC9 DD 7E 02         LD A, (IX+ENT_STATE)
5490+ BFCC FE 03            CP STATE_DYING
5491+ BFCE 28 14            JR Z, .samStateNext                 ; muriendo: no interferir
5492+ BFD0 FE 04            CP STATE_SPAWNING
5493+ BFD2 28 10            JR Z, .samStateNext
5494+ BFD4 DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5495+ BFD8 DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5496+ BFDC DD 36 06 00      LD (IX+ENT_DELTAX), 0
5497+ BFE0 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5498+ BFE4              .samStateNext:
5499+ BFE4 11 10 00         LD DE, ENT_SIZE
5500+ BFE7 DD 19            ADD IX, DE
5501+ BFE9 10 D7            DJNZ .samStateLoop
5502+ BFEB C9               RET
5503+ BFEC
5504+ BFEC              ; ==============================================================================
5505+ BFEC              ; SpawnMonsters - Invoca 3 monstruos placeholder en slots MONSTER0..+2
5506+ BFEC              ; ==============================================================================
5507+ BFEC              ; Llamado cuando el reloj llega a 00:30 (medianoche y media).
5508+ BFEC              ; ==============================================================================
5509+ BFEC
5510+ BFEC              ; ==============================================================================
5511+ BFEC              ; MONSTER SPAWN/REPOSITION SYSTEM (simplified, robust)
5512+ BFEC              ; ==============================================================================
5513+ BFEC              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player's entry position).
5514+ BFEC              ; This is the ONLY guaranteed safe position (player fits there, 16x21).
5515+ BFEC              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5516+ BFEC              ; ==============================================================================
5517+ BFEC              ; MONSTER SPAWN/REPOSITION SYSTEM (robust, simplified)
5518+ BFEC              ; ==============================================================================
5519+ BFEC              ; ALL monsters ALWAYS appear at LastEntryPosX/Y (player entry position).
5520+ BFEC              ; This is the ONLY guaranteed safe position (player fits 16x21 there).
5521+ BFEC              ; No nudge, no border scan, no MonsterSave, no buffer restore.
5522+ BFEC              ; ==============================================================================
5523+ BFEC              MONSTERS_TO_SPAWN   EQU 3
5524+ BFEC              MONSTER_ENTRY_BASE  EQU 20          ; Frames antes del primer monster (~0.8s a 25fps)
5525+ BFEC              MONSTER_ENTRY_GAP   EQU 20          ; Frames entre cada monster (~0.8s)
5526+ BFEC
5527+ BFEC              ; ==============================================================================
5528+ BFEC              ; SpawnMonsters - Primera aparicion tras campanadas
5529+ BFEC              ; ==============================================================================
5530+ BFEC              SpawnMonsters:
5531+ BFEC                  IF DEBUG_NO_ENEMIES
5532+ BFEC ~                RET
5533+ BFEC                  ENDIF
5534+ BFEC 3A F8 B5         LD A, (MonstersActive)
5535+ BFEF B7               OR A
5536+ BFF0 C0               RET NZ
5537+ BFF1                  ; Matar nasties activos antes de poblar slots de monster: liberar el
5538+ BFF1                  ; round-robin de ProcessEnemies (budget 2/frame) para los 3 monsters.
5539+ BFF1 CD CD BC         CALL KillAllActiveNasties
5540+ BFF4 3E 01            LD A, 1
5541+ BFF6 32 F8 B5         LD (MonstersActive), A
5542+ BFF9 CD 76 C0         CALL ShuffleMonsterTypes
5543+ BFFC DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5544+ C000 06 03            LD B, MONSTERS_TO_SPAWN
5545+ C002 0E 00            LD C, 0
5546+ C004              .smLoop:
5547+ C004 C5               PUSH BC
5548+ C005 DD 7E 01         LD A, (IX+ENT_TYPE)
5549+ C008 B7               OR A
5550+ C009 C2 65 C0         JP NZ, .smSkip
5551+ C00C                  ; Asignar tipo y color
5552+ C00C 79               LD A, C
5553+ C00D 21 DA C0         LD HL, MonsterTypeTable
5554+ C010 5F               LD E, A
5555+ C011 16 00            LD D, 0
5556+ C013 19               ADD HL, DE
5557+ C014 7E               LD A, (HL)
5558+ C015 DD 77 08         LD (IX+ENT_ANIMBASE), A
5559+ C018 79               LD A, C
5560+ C019 21 DD C0         LD HL, MonsterColorTable
5561+ C01C 5F               LD E, A
5562+ C01D 16 00            LD D, 0
5563+ C01F 19               ADD HL, DE
5564+ C020 7E               LD A, (HL)
5565+ C021 DD 77 05         LD (IX+ENT_ATTR), A
5566+ C024                  ; Posicion: Regla 1 — hueco aleatorio del screen, fallback LastEntryPos.
5567+ C024 C5               PUSH BC
5568+ C025 CD B8 92         CALL MaiPickRandomGap           ; A=0 ok, A=1 sin gaps
5569+ C028 B7               OR A
5570+ C029 20 0E            JR NZ, .smFallbackPos
5571+ C02B 3A C0 9A         LD A, (MaiSpawnX)
5572+ C02E DD 77 03         LD (IX+ENT_POSX), A
5573+ C031 3A C1 9A         LD A, (MaiSpawnY)
5574+ C034 DD 77 04         LD (IX+ENT_POSY), A
5575+ C037 18 0C            JR .smPosDone
5576+ C039              .smFallbackPos:
5577+ C039 3A 0E 83         LD A, (LastEntryPosX)
5578+ C03C DD 77 03         LD (IX+ENT_POSX), A
5579+ C03F 3A 0F 83         LD A, (LastEntryPosY)
5580+ C042 DD 77 04         LD (IX+ENT_POSY), A
5581+ C045              .smPosDone:
5582+ C045 C1               POP BC
5583+ C046                  ; TYPE_NONE + DIR!=0 (evita spawn animation en TryRespawnMonsters)
5584+ C046 DD 36 01 00      LD (IX+ENT_TYPE), TYPE_NONE
5585+ C04A DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
5586+ C04E DD 36 0A 01      LD (IX+ENT_DIR), DIR_N
5587+ C052 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5588+ C056 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5589+ C05A                  ; Memoria de ubicacion: MonsterRoomId[slot=C] = current screen_id.
5590+ C05A                  ; El monster "vive" aqui hasta que el player cambie de room (follow) o
5591+ C05A                  ; lo empuje a un vecino (migracion por knockback).
5592+ C05A CD AD 91         CALL MaiGetCurrentScreenId
5593+ C05D 21 87 90         LD HL, MonsterRoomId
5594+ C060 59               LD E, C
5595+ C061 16 00            LD D, 0
5596+ C063 19               ADD HL, DE
5597+ C064 77               LD (HL), A
5598+ C065              .smSkip:
5599+ C065 11 10 00         LD DE, ENT_SIZE
5600+ C068 DD 19            ADD IX, DE
5601+ C06A C1               POP BC
5602+ C06B 0C               INC C
5603+ C06C 05               DEC B
5604+ C06D C2 04 C0         JP NZ, .smLoop
5605+ C070 3E 14            LD A, MONSTER_ENTRY_BASE
5606+ C072 32 BD C1         LD (TryRespawnMonsters.rmTimer), A
5607+ C075 C9               RET
5608+ C076
5609+ C076              ; --- Barajar tablas tipo/color ---
5610+ C076              ShuffleMonsterTypes:
5611+ C076 ED 5F            LD A, R
5612+ C078 E6 03            AND 3
5613+ C07A C8               RET Z
5614+ C07B FE 01            CP 1
5615+ C07D 28 21            JR Z, .shSwap01
5616+ C07F FE 02            CP 2
5617+ C081 28 3A            JR Z, .shSwap12
5618+ C083 3A DA C0         LD A, (MonsterTypeTable)
5619+ C086 57               LD D, A
5620+ C087 3A DC C0         LD A, (MonsterTypeTable + 2)
5621+ C08A 32 DA C0         LD (MonsterTypeTable), A
5622+ C08D 7A               LD A, D
5623+ C08E 32 DC C0         LD (MonsterTypeTable + 2), A
5624+ C091 3A DD C0         LD A, (MonsterColorTable)
5625+ C094 57               LD D, A
5626+ C095 3A DF C0         LD A, (MonsterColorTable + 2)
5627+ C098 32 DD C0         LD (MonsterColorTable), A
5628+ C09B 7A               LD A, D
5629+ C09C 32 DF C0         LD (MonsterColorTable + 2), A
5630+ C09F C9               RET
5631+ C0A0              .shSwap01:
5632+ C0A0 3A DA C0         LD A, (MonsterTypeTable)
5633+ C0A3 57               LD D, A
5634+ C0A4 3A DB C0         LD A, (MonsterTypeTable + 1)
5635+ C0A7 32 DA C0         LD (MonsterTypeTable), A
5636+ C0AA 7A               LD A, D
5637+ C0AB 32 DB C0         LD (MonsterTypeTable + 1), A
5638+ C0AE 3A DD C0         LD A, (MonsterColorTable)
5639+ C0B1 57               LD D, A
5640+ C0B2 3A DE C0         LD A, (MonsterColorTable + 1)
5641+ C0B5 32 DD C0         LD (MonsterColorTable), A
5642+ C0B8 7A               LD A, D
5643+ C0B9 32 DE C0         LD (MonsterColorTable + 1), A
5644+ C0BC C9               RET
5645+ C0BD              .shSwap12:
5646+ C0BD 3A DB C0         LD A, (MonsterTypeTable + 1)
5647+ C0C0 57               LD D, A
5648+ C0C1 3A DC C0         LD A, (MonsterTypeTable + 2)
5649+ C0C4 32 DB C0         LD (MonsterTypeTable + 1), A
5650+ C0C7 7A               LD A, D
5651+ C0C8 32 DC C0         LD (MonsterTypeTable + 2), A
5652+ C0CB 3A DE C0         LD A, (MonsterColorTable + 1)
5653+ C0CE 57               LD D, A
5654+ C0CF 3A DF C0         LD A, (MonsterColorTable + 2)
5655+ C0D2 32 DE C0         LD (MonsterColorTable + 1), A
5656+ C0D5 7A               LD A, D
5657+ C0D6 32 DF C0         LD (MonsterColorTable + 2), A
5658+ C0D9 C9               RET
5659+ C0DA
5660+ C0DA              MonsterTypeTable:
5661+ C0DA 4C               DEFB SPRID_MONSTER_0
5662+ C0DB 54               DEFB SPRID_MONSTER_1
5663+ C0DC 5C               DEFB SPRID_MONSTER_2
5664+ C0DD              MonsterColorTable:
5665+ C0DD 44               DEFB $44                            ; Zombi: verde
5666+ C0DE 46               DEFB $46                            ; Skeleton: amarillo
5667+ C0DF 45               DEFB $45                            ; Ghost: cyan
5668+ C0E0
5669+ C0E0              ; ==============================================================================
5670+ C0E0              ; TryRespawnMonsters - Activa slots TYPE_NONE escalonadamente
5671+ C0E0              ; ==============================================================================
5672+ C0E0              TryRespawnMonsters:
5673+ C0E0                  IF DEBUG_NO_ENEMIES
5674+ C0E0 ~                RET
5675+ C0E0                  ENDIF
5676+ C0E0 3A 0A E5         LD A, (CurrentTimeOfDay)
5677+ C0E3 FE 03            CP 3
5678+ C0E5 28 05            JR Z, .rmNight
5679+ C0E7 FE 04            CP 4
5680+ C0E9 28 01            JR Z, .rmNight
5681+ C0EB C9               RET
5682+ C0EC              .rmNight:
5683+ C0EC 3A F8 B5         LD A, (MonstersActive)
5684+ C0EF B7               OR A
5685+ C0F0 C8               RET Z
5686+ C0F1 CD C1 C1         CALL .rmUpdateReturnTimers
5687+ C0F4 3A BD C1         LD A, (.rmTimer)
5688+ C0F7 B7               OR A
5689+ C0F8 28 05            JR Z, .rmCheckSlots
5690+ C0FA 3D               DEC A
5691+ C0FB 32 BD C1         LD (.rmTimer), A
5692+ C0FE C9               RET
5693+ C0FF              .rmCheckSlots:
5694+ C0FF DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5695+ C103 06 03            LD B, MONSTERS_TO_SPAWN
5696+ C105 0E 00            LD C, 0
5697+ C107              .rmLoop:
5698+ C107 C5               PUSH BC
5699+ C108 DD 7E 01         LD A, (IX+ENT_TYPE)
5700+ C10B B7               OR A
5701+ C10C C2 B1 C1         JP NZ, .rmSkip
5702+ C10F                  ; Skip si el TIPO de este slot esta atrapado en la iglesia (paso 7).
5703+ C10F                  ; MonsterTrappedFlags se indexa por type idx (no por slot), porque
5704+ C10F                  ; ShuffleMonsterTypes baraja la asignacion slot->tipo.
5705+ C10F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5706+ C112 B7               OR A
5707+ C113 20 09            JR NZ, .rmHasTypeForTrap
5708+ C115                  ; ANIMBASE no fijado todavia: leer tipo inicial de MonsterTypeTable[slot]
5709+ C115 79               LD A, C
5710+ C116 21 DA C0         LD HL, MonsterTypeTable
5711+ C119 5F               LD E, A
5712+ C11A 16 00            LD D, 0
5713+ C11C 19               ADD HL, DE
5714+ C11D 7E               LD A, (HL)
5715+ C11E              .rmHasTypeForTrap:
5716+ C11E D6 4C            SUB SPRID_MONSTER_0
5717+ C120 CB 3F            SRL A
5718+ C122 CB 3F            SRL A
5719+ C124 CB 3F            SRL A                               ; A = type idx 0..2
5720+ C126 21 BE C1         LD HL, .rmTrapBits
5721+ C129 5F               LD E, A
5722+ C12A 16 00            LD D, 0
5723+ C12C 19               ADD HL, DE
5724+ C12D 7E               LD A, (HL)
5725+ C12E 21 BE 82         LD HL, MonsterTrappedFlags
5726+ C131 A6               AND (HL)
5727+ C132 C2 B1 C1         JP NZ, .rmSkip
5728+ C135                  ; Memoria de ubicacion: solo activar si MonsterRoomId[slot] == current.
5729+ C135                  ; Monsters migrados a otros rooms (via knockback) quedan TYPE_NONE hasta
5730+ C135                  ; que el player visite su room.
5731+ C135 79               LD A, C
5732+ C136 6F               LD L, A
5733+ C137 26 00            LD H, 0
5734+ C139 11 87 90         LD DE, MonsterRoomId
5735+ C13C 19               ADD HL, DE
5736+ C13D 7E               LD A, (HL)
5737+ C13E 5F               LD E, A                             ; E = room_id del slot
5738+ C13F CD AD 91         CALL MaiGetCurrentScreenId          ; A = current screen_id
5739+ C142 BB               CP E
5740+ C143 C2 B1 C1         JP NZ, .rmSkip                      ; distinto room → skip
5741+ C146                  ; === Activar SIN tocar POSX/POSY ===
5742+ C146                  ; La posicion la fija quien puso TYPE_NONE en este slot:
5743+ C146                  ;   - SpawnMonsters: hueco aleatorio via MaiPickRandomGap
5744+ C146                  ;   - RepositionMonstersAtEntry: gap en entry side
5745+ C146                  ; Tipo: usar ANIMBASE existente, o tabla si es 0
5746+ C146 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5747+ C149 B7               OR A
5748+ C14A 20 18            JR NZ, .rmHasType
5749+ C14C 79               LD A, C
5750+ C14D 21 DA C0         LD HL, MonsterTypeTable
5751+ C150 5F               LD E, A
5752+ C151 16 00            LD D, 0
5753+ C153 19               ADD HL, DE
5754+ C154 7E               LD A, (HL)
5755+ C155 DD 77 08         LD (IX+ENT_ANIMBASE), A
5756+ C158 79               LD A, C
5757+ C159 21 DD C0         LD HL, MonsterColorTable
5758+ C15C 5F               LD E, A
5759+ C15D 16 00            LD D, 0
5760+ C15F 19               ADD HL, DE
5761+ C160 7E               LD A, (HL)
5762+ C161 DD 77 05         LD (IX+ENT_ATTR), A
5763+ C164              .rmHasType:
5764+ C164 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
5765+ C167 DD 36 01 02      LD (IX+ENT_TYPE), TYPE_MONSTER
5766+ C16B DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
5767+ C16F                  ; Facing
5768+ C16F 57               LD D, A
5769+ C170 3A 9E 81         LD A, (EntityTable + ENT_POSX)
5770+ C173 DD BE 03         CP (IX+ENT_POSX)
5771+ C176 30 05            JR NC, .rmFaceR
5772+ C178 7A               LD A, D
5773+ C179 C6 04            ADD A, MONSTER_FRAMES_LEFT
5774+ C17B 18 01            JR .rmFaceSet
5775+ C17D              .rmFaceR:
5776+ C17D 7A               LD A, D
5777+ C17E              .rmFaceSet:
5778+ C17E DD 77 00         LD (IX+ENT_SPRITEID), A
5779+ C181 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
5780+ C185 DD 36 0B 0B      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_SOLID) | (1 << ENTF_NEWSPAWN)
5781+ C189 DD 36 0A 00      LD (IX+ENT_DIR), 0
5782+ C18D DD 36 06 00      LD (IX+ENT_DELTAX), 0
5783+ C191 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5784+ C195 DD 7E 03         LD A, (IX+ENT_POSX)
5785+ C198 DD 77 0C         LD (IX+ENT_OLDX), A
5786+ C19B DD 77 0F         LD (IX+ENT_DRAWX), A
5787+ C19E DD 7E 04         LD A, (IX+ENT_POSY)
5788+ C1A1 DD 77 0D         LD (IX+ENT_OLDY), A
5789+ C1A4 DD 7E 00         LD A, (IX+ENT_SPRITEID)
5790+ C1A7 DD 77 0E         LD (IX+ENT_OLDSPRID), A
5791+ C1AA                  ; Solo UNO por frame
5792+ C1AA C1               POP BC
5793+ C1AB 3E 14            LD A, MONSTER_ENTRY_GAP
5794+ C1AD 32 BD C1         LD (.rmTimer), A
5795+ C1B0 C9               RET
5796+ C1B1              .rmSkip:
5797+ C1B1 11 10 00         LD DE, ENT_SIZE
5798+ C1B4 DD 19            ADD IX, DE
5799+ C1B6 C1               POP BC
5800+ C1B7 0C               INC C
5801+ C1B8 05               DEC B
5802+ C1B9 C2 07 C1         JP NZ, .rmLoop
5803+ C1BC C9               RET
5804+ C1BD
5805+ C1BD 00           .rmTimer: DEFB 0
5806+ C1BE 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5807+ C1C1
5808+ C1C1              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5809+ C1C1              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5810+ C1C1              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5811+ C1C1              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5812+ C1C1              ; empujado).
5813+ C1C1              .rmUpdateReturnTimers:
5814+ C1C1 21 F9 B5         LD HL, MonsterReturnTimer
5815+ C1C4 DD 21 AB 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5816+ C1C8 06 03            LD B, MONSTERS_TO_SPAWN
5817+ C1CA              .rmRtLoop:
5818+ C1CA 7E               LD A, (HL)
5819+ C1CB B7               OR A
5820+ C1CC CA A1 C2         JP Z, .rmRtNext
5821+ C1CF 3D               DEC A
5822+ C1D0 77               LD (HL), A
5823+ C1D1 C2 A1 C2         JP NZ, .rmRtNext
5824+ C1D4                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5825+ C1D4                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5826+ C1D4                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5827+ C1D4                  ; Calcular target coord: axis variable segun borde de salida.
5828+ C1D4                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5829+ C1D4 DD 7E 0A         LD A, (IX+ENT_DIR)
5830+ C1D7 FE 01            CP DIR_N
5831+ C1D9 28 11            JR Z, .rmRtSideN
5832+ C1DB FE 02            CP DIR_S
5833+ C1DD 28 1C            JR Z, .rmRtSideS
5834+ C1DF FE 04            CP DIR_E
5835+ C1E1 CA 1B C2         JP Z, .rmRtSideE
5836+ C1E4 FE 08            CP DIR_W
5837+ C1E6 CA 0A C2         JP Z, .rmRtSideW
5838+ C1E9 C3 78 C2         JP .rmRtFallback
5839+ C1EC              .rmRtSideN:
5840+ C1EC                  ; target coord = cx = POSX / 8
5841+ C1EC DD 7E 03         LD A, (IX+ENT_POSX)
5842+ C1EF 0F               RRCA
5843+ C1F0 0F               RRCA
5844+ C1F1 0F               RRCA
5845+ C1F2 E6 1F            AND $1F
5846+ C1F4 32 BF 9A         LD (MaiGapTargetCoord), A
5847+ C1F7 3E 00            LD A, MAI_SIDE_N
5848+ C1F9 18 2F            JR .rmRtPickGap
5849+ C1FB              .rmRtSideS:
5850+ C1FB DD 7E 03         LD A, (IX+ENT_POSX)
5851+ C1FE 0F               RRCA
5852+ C1FF 0F               RRCA
5853+ C200 0F               RRCA
5854+ C201 E6 1F            AND $1F
5855+ C203 32 BF 9A         LD (MaiGapTargetCoord), A
5856+ C206 3E 01            LD A, MAI_SIDE_S
5857+ C208 18 20            JR .rmRtPickGap
5858+ C20A              .rmRtSideW:
5859+ C20A                  ; target coord = cy = (POSY - 16) / 8
5860+ C20A DD 7E 04         LD A, (IX+ENT_POSY)
5861+ C20D D6 10            SUB SCREEN_MIN_Y
5862+ C20F 0F               RRCA
5863+ C210 0F               RRCA
5864+ C211 0F               RRCA
5865+ C212 E6 1F            AND $1F
5866+ C214 32 BF 9A         LD (MaiGapTargetCoord), A
5867+ C217 3E 02            LD A, MAI_SIDE_W
5868+ C219 18 0F            JR .rmRtPickGap
5869+ C21B              .rmRtSideE:
5870+ C21B DD 7E 04         LD A, (IX+ENT_POSY)
5871+ C21E D6 10            SUB SCREEN_MIN_Y
5872+ C220 0F               RRCA
5873+ C221 0F               RRCA
5874+ C222 0F               RRCA
5875+ C223 E6 1F            AND $1F
5876+ C225 32 BF 9A         LD (MaiGapTargetCoord), A
5877+ C228 3E 03            LD A, MAI_SIDE_E
5878+ C22A              .rmRtPickGap:
5879+ C22A                  ; MaiPickNearestGapOnSide destruye HL y BC (paginacion bank 6, loops
5880+ C22A                  ; internos). Preservamos HL (ptr a MonsterReturnTimer[slot]) y B
5881+ C22A                  ; (contador del outer loop) para que .rmRtNext pueda iterar bien.
5882+ C22A E5               PUSH HL
5883+ C22B C5               PUSH BC
5884+ C22C CD 67 94         CALL MaiPickNearestGapOnSide        ; elige gap del side mas cercano al target
5885+ C22F C1               POP BC
5886+ C230 E1               POP HL
5887+ C231 B7               OR A
5888+ C232 C2 78 C2         JP NZ, .rmRtFallback
5889+ C235                  ; Ajustar MaiSpawnX/Y con MAI_REENTRY_OFFSET hacia dentro. MaiPickRandomGapOnSide
5890+ C235                  ; usa MAI_ENTRY_OFFSET (=0) y deja el spawn al borde; aqui lo empujamos 2 chars.
5891+ C235 3A BB 9A         LD A, (MaiGapSide)
5892+ C238 FE 00            CP MAI_SIDE_N
5893+ C23A 28 12            JR Z, .rmRtAdjN
5894+ C23C FE 01            CP MAI_SIDE_S
5895+ C23E 28 18            JR Z, .rmRtAdjS
5896+ C240 FE 02            CP MAI_SIDE_W
5897+ C242 28 1E            JR Z, .rmRtAdjW
5898+ C244                  ; side E
5899+ C244 3A C0 9A         LD A, (MaiSpawnX)
5900+ C247 D6 10            SUB MAI_REENTRY_OFFSET
5901+ C249 32 C0 9A         LD (MaiSpawnX), A
5902+ C24C 18 1C            JR .rmRtApplyGap
5903+ C24E              .rmRtAdjN:
5904+ C24E 3A C1 9A         LD A, (MaiSpawnY)
5905+ C251 C6 10            ADD A, MAI_REENTRY_OFFSET
5906+ C253 32 C1 9A         LD (MaiSpawnY), A
5907+ C256 18 12            JR .rmRtApplyGap
5908+ C258              .rmRtAdjS:
5909+ C258 3A C1 9A         LD A, (MaiSpawnY)
5910+ C25B D6 10            SUB MAI_REENTRY_OFFSET
5911+ C25D 32 C1 9A         LD (MaiSpawnY), A
5912+ C260 18 08            JR .rmRtApplyGap
5913+ C262              .rmRtAdjW:
5914+ C262 3A C0 9A         LD A, (MaiSpawnX)
5915+ C265 C6 10            ADD A, MAI_REENTRY_OFFSET
5916+ C267 32 C0 9A         LD (MaiSpawnX), A
5917+ C26A              .rmRtApplyGap:
5918+ C26A 3A C0 9A         LD A, (MaiSpawnX)
5919+ C26D DD 77 03         LD (IX+ENT_POSX), A
5920+ C270 3A C1 9A         LD A, (MaiSpawnY)
5921+ C273 DD 77 04         LD (IX+ENT_POSY), A
5922+ C276 18 0C            JR .rmRtReturnDone
5923+ C278              .rmRtFallback:
5924+ C278                  ; Sin side valido (raro) o sin gaps en ese side → LastEntryPos
5925+ C278 3A 0E 83         LD A, (LastEntryPosX)
5926+ C27B DD 77 03         LD (IX+ENT_POSX), A
5927+ C27E 3A 0F 83         LD A, (LastEntryPosY)
5928+ C281 DD 77 04         LD (IX+ENT_POSY), A
5929+ C284              .rmRtReturnDone:
5930+ C284 DD 36 0A 01      LD (IX+ENT_DIR), DIR_N                  ; sentinel (!=0 para skip spawn anim)
5931+ C288 AF               XOR A
