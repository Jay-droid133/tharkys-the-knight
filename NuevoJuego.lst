3921+ A8B1              ; UpdateEnemySpeed - Actualiza velocidad base de nasties segun ciclo
3922+ A8B1              ; ==============================================================================
3923+ A8B1              UpdateEnemySpeed:
3924+ A8B1 3A 95 A9         LD A, (DayCycleCount)
3925+ A8B4 3D               DEC A                               ; 0-based index
3926+ A8B5 FE 0A            CP 10
3927+ A8B7 38 02            JR C, .uesOk
3928+ A8B9 3E 09            LD A, 9                             ; Cap en indice 9
3929+ A8BB              .uesOk:
3930+ A8BB F5               PUSH AF                             ; Guardar indice para tabla de anim
3931+ A8BC 21 DF A8         LD HL, EnemySpeedTable
3932+ A8BF 5F               LD E, A
3933+ A8C0 16 00            LD D, 0
3934+ A8C2 19               ADD HL, DE
3935+ A8C3 7E               LD A, (HL)                          ; A = velocidad × 2
3936+ A8C4                  ; Calcular velocidad real: A/2, redondeando arriba en frames impares
3937+ A8C4 CB 3F            SRL A                               ; A = velocidad / 2, carry = resto
3938+ A8C6 30 07            JR NC, .uesNoFrac                   ; Sin resto → velocidad exacta
3939+ A8C8                  ; Hay fraccion .5: alternar +1 en frames impares
3940+ A8C8 47               LD B, A                             ; B = parte entera
3941+ A8C9 3A 9C 80         LD A, (GameFrameCounter)
3942+ A8CC E6 01            AND 1                               ; 0 en par, 1 en impar
3943+ A8CE 80               ADD A, B                            ; Sumar 0 o 1
3944+ A8CF              .uesNoFrac:
3945+ A8CF 32 B3 8C         LD (CurrentEnemySpeed), A
3946+ A8D2                  ; Leer delay de animacion para este ciclo
3947+ A8D2 F1               POP AF                              ; A = indice 0-based
3948+ A8D3 21 E9 A8         LD HL, EnemyAnimDelayTable
3949+ A8D6 5F               LD E, A
3950+ A8D7 16 00            LD D, 0
3951+ A8D9 19               ADD HL, DE
3952+ A8DA 7E               LD A, (HL)
3953+ A8DB 32 B4 8C         LD (CurrentEnemyAnimDelay), A
3954+ A8DE C9               RET
3955+ A8DF
3956+ A8DF              ; Velocidad base nasties por ciclo (valor × 2 para soportar .5)
3957+ A8DF              ; Valor real: 2=1px, 3=1.5px, 4=2px, 5=2.5px, 6=3px
3958+ A8DF              EnemySpeedTable:
3959+ A8DF 02               DEFB 2                              ; Ciclo 1: 1px
