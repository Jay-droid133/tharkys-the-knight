 268+ 9AD5 47               LD B, A                     ; B = atributo (preservar)
 269+ 9AD6 3A CF 9B         LD A, (EntityAttrH)
 270+ 9AD9 4F               LD C, A                     ; C = filas
 271+ 9ADA              .rowLoop:
 272+ 9ADA                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9ADA E5               PUSH HL
 274+ 9ADB 7C               LD A, H
 275+ 9ADC FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9ADE 20 08            JR NZ, .rowNotHud
 277+ 9AE0 7D               LD A, L
 278+ 9AE1 FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AE3 30 03            JR NC, .rowNotHud
 280+ 9AE5                  ; Fila en HUD → saltar sin pintar
 281+ 9AE5 E1               POP HL
 282+ 9AE6 18 0B            JR .rowSkip
 283+ 9AE8              .rowNotHud:
 284+ 9AE8 E1               POP HL
 285+ 9AE9 3A CE 9B         LD A, (EntityAttrW)
 286+ 9AEC E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AED                  ; Pintar una fila
 288+ 9AED              .colLoop:
 289+ 9AED 70               LD (HL), B
 290+ 9AEE 23               INC HL
 291+ 9AEF 3D               DEC A
 292+ 9AF0 20 FB            JR NZ, .colLoop
 293+ 9AF2 E1               POP HL
