5688+ BF43 28 14            JR Z, .kbSetX
5689+ BF45 3E FC            LD A, -MONSTER_KB_SPEED
5690+ BF47 18 10            JR .kbSetX
5691+ BF49              .kbFromPos:
5692+ BF49                  ; Fallback: empujar segun posicion relativa al player
5693+ BF49 DD 7E 03         LD A, (IX+ENT_POSX)
5694+ BF4C 57               LD D, A
5695+ BF4D 3A B3 80         LD A, (EntityTable + ENT_POSX)
