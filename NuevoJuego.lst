 270+ EC61 DD 23            INC IX
 270+ EC63 DD 23          INC IX         ; saltar bytes 4-5 (decoración derecha)
 271+ EC65 C1               POP BC
 272+ EC66 E1               POP HL
 273+ EC67 24               INC H
 274+ EC68 0D               DEC C
 275+ EC69 20 E1            JR NZ, .fc22
 276+ EC6B
 277+ EC6B 26 40            LD H, $40
 278+ EC6D 2E 2F            LD L, $2F               ; col 15, scan 0, fila 1
 279+ EC6F 0E 08            LD C, 8
