4164+ BA05              ; ==============================================================================
4165+ BA05              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
4166+ BA05              ; ==============================================================================
4167+ BA05              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
4168+ BA05              ; ENT_DIR contiene el ANIMBASE real del enemigo.
4169+ BA05              ; Cuando el ultimo frame expira → restaura sprite real y activa movimiento.
4170+ BA05              ; ==============================================================================
4171+ BA05              UpdateSpawning:
4172+ BA05 DD 35 09         DEC (IX+ENT_ANIMTIMER)
4173+ BA08 20 39            JR NZ, .spAnimDone
4174+ BA0A                  ; Timer expirado → avanzar frame
4175+ BA0A 3E 01            LD A, ANIM_DELAY_SPAWN
4176+ BA0C DD 77 09         LD (IX+ENT_ANIMTIMER), A
4177+ BA0F DD 7E 00         LD A, (IX+ENT_SPRITEID)
