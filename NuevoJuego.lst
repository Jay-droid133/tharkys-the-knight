 180+ EC36              ; ==============================================================================
 181+ EC36              ; SetClockToPhaseHour
 182+ EC36              ; ==============================================================================
 183+ EC36              SetClockToPhaseHour:
 184+ EC36 21 55 EA         LD HL, PhaseStartHour
 185+ EC39 4F               LD C, A
 186+ EC3A 06 00            LD B, 0
 187+ EC3C 09               ADD HL, BC
 188+ EC3D 7E               LD A, (HL)
 189+ EC3E 32 52 EA         LD (GameHours), A
 190+ EC41 AF               XOR A
 191+ EC42 32 51 EA         LD (GameMinutes), A
 192+ EC45 32 50 EA         LD (GameSubMinute), A
 193+ EC48 C9               RET
