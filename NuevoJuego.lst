7568+ C91D 32 12 B3         LD (MonstersActive), A
7569+ C920 32 BE 82         LD (MonsterTrappedFlags), A
7570+ C923 32 FA 82         LD (DeathSpawned), A
7571+ C926 32 C8 82         LD (TownGatePhase), A
7572+ C929 32 C6 82         LD (ChurchCutscenePhase), A
7573+ C92C 32 28 E2         LD (CurrentTimeOfDay), A            ; fase 0 = DY
7574+ C92F 32 B6 82         LD (BellsTriggered), A
7575+ C932 32 BF 82         LD (NextChurchTrapStep), A
7576+ C935 32 C0 82         LD (StatueBlinkCounter), A
7577+ C938 32 C1 82         LD (ChurchKeyAltSpawnIdx), A
7578+ C93B 32 A8 C4         LD (PlayerHitTimer), A
7579+ C93E 32 F3 82         LD (TombstoneCount), A              ; Reset tumbas en game-restart fresh
7580+ C941 32 F4 82         LD (TombDrawPending), A
7581+ C944 32 E7 82         LD (DeathBorderPhase), A
7582+ C947 32 E8 82         LD (DeathBorderTimer), A
7583+ C94A 32 E9 82         LD (PlayerDeathAnimTimer), A
7584+ C94D 32 EA 82         LD (PlayerDeathAnimFrame), A
7585+ C950 32 EB 82         LD (PlayerRespawnPhase), A
7586+ C953 32 EC 82         LD (PlayerRespawnTimer), A
7587+ C956 32 ED 82         LD (PlayerRespawnBlinkTimer), A
7588+ C959 32 EF 82         LD (PlayerRespawnBeatIdx), A
