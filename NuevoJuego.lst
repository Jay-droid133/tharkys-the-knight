 287+ E5E0              ; ==============================================================================
 288+ E5E0              ; MUSIC DRIVER - Dispatcher entre tracks (canal B AY)
 289+ E5E0              ; ==============================================================================
 290+ E5E0              ; State + tablas + tick (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote)
 291+ E5E0              ; viven AHORA en code/music_irq.asm (slot 1, $6000-$7FFF, siempre visible).
 292+ E5E0              ; El IRQ handler debe poder leer ese codigo/datos sin paginar slot 3 — paginar
 293+ E5E0              ; dentro del IRQ rompe los PUSH/POP del propio handler (ver
 294+ E5E0              ; project_ay_thunk_stack_bug.md).
 295+ E5E0              ;
 296+ E5E0              ; Aqui solo queda StartMusicImpl (dispatcher one-shot al cambiar de track):
 297+ E5E0              ; corre en bank 4 (paged en slot 3 por su thunk) y referencia simbolos de
 298+ E5E0              ; slot 1 (TensionMusicTable, MusicLoop, etc.) que estan siempre visibles.
 299+ E5E0              ; Tail-jumpea a MusicAdvanceNote (slot 1) tras setear mixer/vol.
 300+ E5E0              ;
 301+ E5E0              ; Tracks (mismo formato; ver music_irq.asm para tablas):
 302+ E5E0              ;   0=Tension, 1=Sunrise, 2=EndGame (LOOP), 3=GameOver, 4=Death (LOOP)
 303+ E5E0              ;   $FF=STOP, $FE=restart, $FD=stop-if-loopable
 304+ E5E0              ; ==============================================================================
 305+ E5E0
 306+ E5E0              ; (state vars + tablas movidas a music_irq.asm — ver bloque
 307+ E5E0              ; "MUSIC DRIVER STATE + TABLES + TICK" alli.)
 308+ E5E0
 309+ E5E0              ; --- StartMusicImpl: dispatcher entre tracks. Lee track_id de MusicTrackArg ---
 310+ E5E0              ; Entrada: (MusicTrackArg) = 0..4 (track) o $FF (sentinel STOP). Track ids
 311+ E5E0              ; desconocidos no listados resultan en no-op (RET sin armar nada). Setup AY
 312+ E5E0              ; (mixer + vol) compartido. NO usar A como entrada: el thunk en bank 2 clobbea
 313+ E5E0              ; A al leer CurrentPaging antes del CALL (ver project_ay_thunk_stack_bug.md).
 314+ E5E0              StartMusicImpl:
 315+ E5E0 3A DF 99         LD A, (MusicTrackArg)
 316+ E5E3 FE FF            CP $FF
 317+ E5E5 28 5B            JR Z, .smStop                   ; sentinel: parar musica activa
 318+ E5E7 FE FE            CP $FE
 319+ E5E9 CA 6C E6         JP Z, .smRestart                ; sentinel: re-armar track actual desde
 320+ E5EC                                                  ; primera nota, PRESERVANDO MusicLoop y
 321+ E5EC                                                  ; MusicSpeedShift (utiles para enfasis
 322+ E5EC                                                  ; ej. "muerte se lanza" -> sigue loop +
 323+ E5EC                                                  ; aplica nuevo tempo desde nota 0).
 324+ E5EC FE FD            CP $FD
 325+ E5EE 28 4D            JR Z, .smStopIfLoopable         ; sentinel: parar solo si el track activo
 326+ E5F0                                                  ; es loopable. Usado por screen_system
 327+ E5F0                                                  ; al cambiar sala — corta DeathMusic (loopable,
 328+ E5F0                                                  ; ligada a Death entity) pero deja sonar
 329+ E5F0                                                  ; tension/sunrise (one-shot, music continua).
 330+ E5F0                  ; Default: track no-loopable + tempo normal (se sobrescriben abajo segun track)
 331+ E5F0 F5               PUSH AF
 332+ E5F1 AF               XOR A
 333+ E5F2 32 A8 7B         LD (MusicLoop), A
 334+ E5F5 32 E0 99         LD (MusicSpeedShift), A         ; nuevo arranque siempre a tempo normal
 335+ E5F8 F1               POP AF
 336+ E5F9                  ; --- Resolver tabla + modo polifonico segun track id ---
 337+ E5F9                  ; Tracks in-game (0/1/4) = poly2 (canal A+C, B reservado SFX).
 338+ E5F9                  ; Tracks game-end (2/3) = poly3 (A+B+C, sin SFX en escena).
 339+ E5F9 21 B0 7B         LD HL, TensionMusicTable
 340+ E5FC B7               OR A
 341+ E5FD 28 24            JR Z, .smArmPoly2
 342+ E5FF 21 CE 7B         LD HL, SunriseMusicTable
 343+ E602 3D               DEC A
 344+ E603 28 1E            JR Z, .smArmPoly2
 345+ E605 21 D2 7C         LD HL, EndGameMusicTable
 346+ E608 3D               DEC A
 347+ E609 28 1F            JR Z, .smArmPoly3Loop            ; track 2 = LOOPABLE
 348+ E60B 21 26 7D         LD HL, GameOverMusicTable
 349+ E60E 3D               DEC A
 350+ E60F 28 1E            JR Z, .smArmPoly3
 351+ E611 21 57 7D         LD HL, DeathMusicTable
 352+ E614 3D               DEC A
 353+ E615 28 07            JR Z, .smArmPoly2Loop            ; track 4 = LOOPABLE
 354+ E617 21 84 7D         LD HL, MonstersMusicTable
 355+ E61A 3D               DEC A
 356+ E61B 28 01            JR Z, .smArmPoly2Loop            ; track 5 = LOOPABLE (monster ambient)
 357+ E61D C9               RET                              ; track_id desconocido: no-op
 358+ E61E
 359+ E61E              .smArmPoly2Loop:
 360+ E61E 3E 01            LD A, 1
 361+ E620 32 A8 7B         LD (MusicLoop), A
 362+ E623                  ; fall-through
 363+ E623              .smArmPoly2:
 364+ E623 3E 02            LD A, 2
 365+ E625 32 A9 7B         LD (MusicMode), A
 366+ E628 18 0A            JR .smArmCommon
 367+ E62A
 368+ E62A              .smArmPoly3Loop:
 369+ E62A 3E 01            LD A, 1
 370+ E62C 32 A8 7B         LD (MusicLoop), A
 371+ E62F                  ; fall-through
 372+ E62F              .smArmPoly3:
 373+ E62F 3E 03            LD A, 3
 374+ E631 32 A9 7B         LD (MusicMode), A
 375+ E634                  ; fall-through
 376+ E634              .smArmCommon:
 377+ E634 22 A6 7B         LD (MusicTableStart), HL        ; guardar inicio de tabla para reentry en loop
 378+ E637 22 A3 7B         LD (MusicPtr), HL
 379+ E63A                  ; Mixer R7 vive en $38 (set por AY_Init) — los 3 tonos enable + ruidos off.
 380+ E63A                  ; El silencio de un canal se gestiona via vol=0 (en MusicAdvanceNote y en
 381+ E63A                  ; los SFX). No re-escribimos R7 aqui para no clobbear bell residual.
 382+ E63A C3 4F 7E         JP MusicAdvanceNote             ; tail-call: arma vol+period del primer nota
 383+ E63D
 384+ E63D              .smStopIfLoopable:
 385+ E63D                  ; Sentinel $FD: solo para si el track activo es loopable. Tracks one-shot
 386+ E63D                  ; (tension/sunrise/endgame) pasan de largo y siguen sonando.
 387+ E63D 3A A8 7B         LD A, (MusicLoop)
 388+ E640 B7               OR A
 389+ E641 C8               RET Z
 390+ E642                  ; fall-through al stop normal
 391+ E642              .smStop:
 392+ E642                  ; Sentinel $FF: silencio inmediato + clear flags. Reusable como cualquier
 393+ E642                  ; otro StartMusic call: `LD A, $FF : CALL StartMusic`.
 394+ E642 AF               XOR A
 395+ E643 32 A5 7B         LD (MusicTimer), A
 396+ E646 32 A8 7B         LD (MusicLoop), A
 397+ E649 32 E0 99         LD (MusicSpeedShift), A         ; reset tempo
 398+ E64C 67               LD H, A
 399+ E64D 6F               LD L, A
 400+ E64E 22 AA 7B         LD (MusicPeriodA), HL           ; clear periods → re-arm no escribe AY
 401+ E651 22 AC 7B         LD (MusicPeriodB), HL
 402+ E654 22 AE 7B         LD (MusicPeriodC), HL
 403+ E657                  ; Mute los 3 canales (poly2 usa A+C; poly3 usa A+B+C; vale para ambos).
 404+ E657 3E 08            LD A, 8
 405+ E659 1E 00            LD E, 0
 406+ E65B CD 9E E4         CALL AY_WriteReg                ; R8 = 0 (vol A)
 407+ E65E 3E 09            LD A, 9
 408+ E660 1E 00            LD E, 0
 409+ E662 CD 9E E4         CALL AY_WriteReg                ; R9 = 0 (vol B — solo era usado en poly3)
 410+ E665 3E 0A            LD A, 10
 411+ E667 1E 00            LD E, 0
 412+ E669 C3 9E E4         JP AY_WriteReg                  ; tail-call: R10 = 0 (vol C)
 413+ E66C
 414+ E66C              .smRestart:
 415+ E66C                  ; Sentinel $FE: re-armar track actual desde MusicTableStart sin tocar
 416+ E66C                  ; mixer/vol (ya estan seteados desde StartMusic previo) ni resetear
 417+ E66C                  ; MusicLoop / MusicSpeedShift. La primera nota suena este mismo frame
 418+ E66C                  ; (MusicAdvanceNote la carga). Util para sincronizar cambios de tempo
 419+ E66C                  ; con eventos del juego sin esperar al fin de la nota actual.
 420+ E66C 2A A6 7B         LD HL, (MusicTableStart)
 421+ E66F 22 A3 7B         LD (MusicPtr), HL
 422+ E672 C3 4F 7E         JP MusicAdvanceNote
 423+ E675
 424+ E675              ; (UpdateMusicTick / UpdateMusicImpl / MusicAdvanceNote movidos a music_irq.asm
 425+ E675              ; — slot 1, siempre visible, llamado desde el IRQ handler sin paginar.)
 426+ E675
