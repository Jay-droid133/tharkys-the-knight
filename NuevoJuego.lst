2725+ DA73              ; ==============================================================================
2726+ DA73              ; BuildPickupRectCache - Para cada pickup ACTIVO (no dormant) en la pantalla
2727+ DA73              ; actual, lee H/W del sprite header y guarda (charX, charY, charXEnd, charYEnd)
2728+ DA73              ; inclusivo en PickupRectCache. Llamada al final de DrawScreen y tras
2729+ DA73              ; RedrawPickupByPtr (cuando un pickup pasa de dormant->active).
2730+ DA73              ; Usado por RestoreOldAttr para AABB-check sin paginar bank cada frame.
2731+ DA73              ; Tambien resetea PickupAttrsDirty (DrawScreen acaba de pintar attrs frescos).
2732+ DA73              ; Destruye: AF, BC, DE, HL.
2733+ DA73              ; ==============================================================================
2734+ DA73              BuildPickupRectCache:
2735+ DA73 AF               XOR A
2736+ DA74 32 0D 83         LD (NumPickupsCached), A
2737+ DA77 32 0C 83         LD (PickupAttrsDirty), A    ; attrs frescos tras DrawScreen
2738+ DA7A 21 A8 DF         LD HL, PickupTable
