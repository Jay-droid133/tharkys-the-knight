 369+ E4B6              ; ==============================================================================
 370+ E4B6              ; .cmcpComputeNeighbor - Calcula V dado R y side, con bounds check
 371+ E4B6              ; ==============================================================================
 372+ E4B6              ; IN:  B = R sid, C = side (0=N,1=S,2=W,3=E)
 373+ E4B6              ; OUT: A = V sid (0..255) si valid; A = $FF si neighbor sale del mapa.
 374+ E4B6              ; Destruye: AF.
 375+ E4B6              ; ==============================================================================
 376+ E4B6              .cmcpComputeNeighbor:
 377+ E4B6 79               LD A, C
 378+ E4B7 B7               OR A
 379+ E4B8 20 08            JR NZ, .ccnNotN
 380+ E4BA                  ; N: V = R - 16, valid if R >= 16
 381+ E4BA 78               LD A, B
