 185+ 7203              ; ==============================================================================
 186+ 7203              ; GetMagicCompassAttr - Devuelve el byte de attr del HUD según blink + warning
 187+ 7203              ; ==============================================================================
 188+ 7203              ; Llamado desde DrawCompass cuando MagicCompassTimer > 0 y idx != 4. Decide
 189+ 7203              ; entre paper amarillo bright ($70) y paper amarillo no-bright ($30) según el
 190+ 7203              ; bit relevante de MagicCompassBlinkPhase. Frecuencia de blink:
 191+ 7203              ;   - normal:  bit 2 (toggle cada 4 frames de juego @ 25fps → ~3.1 Hz)
 192+ 7203              ;   - warning: bit 1 (toggle cada 2 frames → ~6.2 Hz, últimos 5 s)
 193+ 7203              ; OUT: A = attr byte ($70 ON / $30 OFF).
 194+ 7203              ; Destruye: AF, B.
 195+ 7203              ; ==============================================================================
 196+ 7203              GetMagicCompassAttr:
 197+ 7203 3A C0 5F         LD A, (MagicCompassTimer + 1)        ; H byte del timer
 198+ 7206 B7               OR A
 199+ 7207 20 0E            JR NZ, .gmcaNormal                   ; H>0 → no warning
 200+ 7209 3A BF 5F         LD A, (MagicCompassTimer)
 201+ 720C FE 7E            CP MAGIC_COMPASS_WARNING_FRAMES + 1
 202+ 720E 30 07            JR NC, .gmcaNormal
 203+ 7210                  ; Warning: usar bit 1 (toggle cada 2 frames)
 204+ 7210 3A C3 5F         LD A, (MagicCompassBlinkPhase)
 205+ 7213 E6 02            AND $02
 206+ 7215 18 05            JR .gmcaResolve
 207+ 7217              .gmcaNormal:
 208+ 7217 3A C3 5F         LD A, (MagicCompassBlinkPhase)
 209+ 721A E6 04            AND $04
 210+ 721C              .gmcaResolve:
 211+ 721C B7               OR A
 212+ 721D 28 03            JR Z, .gmcaOff
 213+ 721F 3E 70            LD A, MAGIC_COMPASS_ATTR_ON
 214+ 7221 C9               RET
 215+ 7222              .gmcaOff:
 216+ 7222 3E 30            LD A, MAGIC_COMPASS_ATTR_OFF
 217+ 7224 C9               RET
