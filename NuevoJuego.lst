3478+ 9FD0 D0               RET NC                              ; Buffer lleno (no deberia pasar)
3479+ 9FD1                  ; Calcular posicion en buffer: count × 5
3480+ 9FD1 6F               LD L, A
3481+ 9FD2 26 00            LD H, 0
3482+ 9FD4 29               ADD HL, HL
3483+ 9FD5 29               ADD HL, HL
3484+ 9FD6 29               ADD HL, HL                          ; count × 8 (simplificado)
3485+ 9FD7                  ; Corregir: count × 5 = count × 4 + count
3486+ 9FD7 6F               LD L, A
3487+ 9FD8 26 00            LD H, 0
3488+ 9FDA 54               LD D, H
3489+ 9FDB 5D               LD E, L
3490+ 9FDC 29               ADD HL, HL
3491+ 9FDD 29               ADD HL, HL                          ; count × 4
3492+ 9FDE 19               ADD HL, DE                          ; count × 5
3493+ 9FDF 11 A0 81         LD DE, PendingEraseSlots
3494+ 9FE2 19               ADD HL, DE
