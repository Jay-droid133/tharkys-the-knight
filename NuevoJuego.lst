 526+ DFD3              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 527+ DFD3              ; Usa font custom (DayHudFont) en vez de ROM font
 528+ DFD3              ; ==============================================================================
 529+ DFD3              DrawDayCycleHUD:
 530+ DFD3                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 531+ DFD3 21 91 E2         LD HL, DayHudFont + 0 * 8          ; 'D'
 532+ DFD6 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 533+ DFD9 CD 48 E0         CALL .drawChar
 534+ DFDC 21 99 E2         LD HL, DayHudFont + 1 * 8          ; 'A'
 535+ DFDF 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 536+ DFE2 CD 48 E0         CALL .drawChar
 537+ DFE5 21 A1 E2         LD HL, DayHudFont + 2 * 8          ; 'Y'
 538+ DFE8 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 539+ DFEB CD 48 E0         CALL .drawChar
 540+ DFEE                  ; Col 7 = espacio (limpiar)
 541+ DFEE 11 07 40         LD DE, $4007
 542+ DFF1 CD 51 E0         CALL .clearChar
 543+ DFF4
 544+ DFF4                  ; --- Digito decenas (col 8) ---
 545+ DFF4 3A 7D BD         LD A, (DayCycleCount)
 546+ DFF7 FE 0A            CP 10
 547+ DFF9 38 20            JR C, .singleDigit
 548+ DFFB                  ; Dos digitos: dividir A / 10
 549+ DFFB 06 00            LD B, 0
 550+ DFFD              .divLoop:
 551+ DFFD D6 0A            SUB 10
 552+ DFFF 04               INC B
 553+ E000 FE 0A            CP 10
 554+ E002 30 F9            JR NC, .divLoop
 555+ E004                  ; B = decenas, A = unidades
 556+ E004 F5               PUSH AF                             ; Guardar unidades
 557+ E005 78               LD A, B
 558+ E006 CD 3B E0         CALL .getDigitFont
 559+ E009 11 08 40         LD DE, $4008                        ; Col 8
 560+ E00C CD 48 E0         CALL .drawChar
 561+ E00F F1               POP AF                              ; Recuperar unidades
 562+ E010 CD 3B E0         CALL .getDigitFont
