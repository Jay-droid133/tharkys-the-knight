# file closed: bg_gfx_b.asm
 565  E592                  ; ay_sound.asm vive aqui (bank 4, no-contended). MainLoop entra via thunks
 566  E592                  ; en ay_sound_thunks.asm. ay_sound es self-contained: cero CALL/JP a
 567  E592                  ; rutinas externas, asi que NO hay cross-bank surface dentro del impl.
 568  E592                  INCLUDE "ay_sound.asm"
# file opened: ay_sound.asm
   1+ E592              ; ==============================================================================
   2+ E592              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E592              ; ==============================================================================
   4+ E592              ; Puertos:
   5+ E592              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E592              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E592              ;
   8+ E592              ; Registros AY:
   9+ E592              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E592              ;   R2/R3: tono canal B
  11+ E592              ;   R4/R5: tono canal C
  12+ E592              ;   R6:    period del ruido (5 bits)
  13+ E592              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E592              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E592              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E592              ;   R9:    volumen B
  17+ E592              ;   R10:   volumen C
  18+ E592              ;   R11/R12: period del envelope
  19+ E592              ;   R13:   forma del envelope (0-15)
  20+ E592              ; ==============================================================================
  21+ E592
  22+ E592              ; ==============================================================================
  23+ E592              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E592              ; ==============================================================================
  25+ E592              ; Entrada: A = registro (0-13), E = valor
  26+ E592              ; Destruye: BC, A
  27+ E592              ; ==============================================================================
  28+ E592              AY_WriteReg:
  29+ E592 01 FD FF         LD BC, $FFFD
  30+ E595 ED 79            OUT (C), A                  ; seleccionar registro
  31+ E597 01 FD BF         LD BC, $BFFD
  32+ E59A ED 59            OUT (C), E                  ; escribir valor
  33+ E59C C9               RET
  34+ E59D
  35+ E59D              ; ==============================================================================
  36+ E59D              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E59D              ; ==============================================================================
  38+ E59D              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E59D              ; ==============================================================================
  40+ E59D              AY_StopImpl:
  41+ E59D 3E 08            LD A, 8
  42+ E59F 1E 00            LD E, 0
  43+ E5A1 CD 92 E5         CALL AY_WriteReg
  44+ E5A4 3E 09            LD A, 9
  45+ E5A6 1E 00            LD E, 0
  46+ E5A8 CD 92 E5         CALL AY_WriteReg
  47+ E5AB 3E 0A            LD A, 10
  48+ E5AD 1E 00            LD E, 0
  49+ E5AF CD 92 E5         CALL AY_WriteReg
  50+ E5B2 C9               RET
  51+ E5B3
  52+ E5B3
  53+ E5B3              ; ==============================================================================
  54+ E5B3              ; AY_Init - Silencia todos los canales (volumen 0). Mixer = $38 (todos los
  55+ E5B3              ; tonos enable, ruidos off). El silencio se gestiona via volumen por canal:
  56+ E5B3              ; bell, music poly y SFX comparten el chip sin clobbear el mixer entre ellos.
  57+ E5B3              ; ==============================================================================
  58+ E5B3              AY_InitImpl:
  59+ E5B3 3E 07            LD A, 7                     ; mixer
  60+ E5B5 1E 38            LD E, $38                   ; tonos ABC on, ruidos off; muting via vol
  61+ E5B7 CD 92 E5         CALL AY_WriteReg
  62+ E5BA 3E 08            LD A, 8                     ; volumen A
  63+ E5BC 1E 00            LD E, 0
  64+ E5BE CD 92 E5         CALL AY_WriteReg
  65+ E5C1 3E 09            LD A, 9                     ; volumen B
  66+ E5C3 1E 00            LD E, 0
  67+ E5C5 CD 92 E5         CALL AY_WriteReg
  68+ E5C8 3E 0A            LD A, 10                    ; volumen C
  69+ E5CA 1E 00            LD E, 0
  70+ E5CC CD 92 E5         CALL AY_WriteReg
  71+ E5CF C9               RET
  72+ E5D0
  73+ E5D0              ; ==============================================================================
  74+ E5D0              ; AY_PlayBellChime - Toca una campanada de iglesia en el canal A
  75+ E5D0              ; ==============================================================================
  76+ E5D0              ; Tono grave + envelope decay. La CPU queda libre inmediatamente —
  77+ E5D0              ; el AY toca solo durante el decay.
  78+ E5D0              ; ==============================================================================
  79+ E5D0              ; Period para canal A: tono grave ~110Hz → period = 1750000/(16*110) ≈ 994 = $3E2
  80+ E5D0              ; ==============================================================================
  81+ E5D0              ; ==============================================================================
  82+ E5D0              ; Variables del decay manual de la campana — MOVIDAS a music_irq.asm (slot 1)
  83+ E5D0              ; para que el handler IRQ las pueda leer/escribir sin paginar slot 3 (regla
  84+ E5D0              ; project_irq_slot3_atomic). El tick del decay vive ahora en BellTickIrq
  85+ E5D0              ; (slot 1) y se llama desde MusicIrqHandler cada 25 Hz. Sin esto, durante
  86+ E5D0              ; DrawScreen / transiciones (varios frames sin MainLoop) el bell decay no
  87+ E5D0              ; se actualizaba -> "campanada se alarga / se apaga raro".
  88+ E5D0              ;
  89+ E5D0              ; AY_PlayBellChimeImpl (bank 4) sigue escribiendo a las vars sin cambios:
  90+ E5D0              ; slot 1 always-vis desde bank 4.
  91+ E5D0              ;
  92+ E5D0              ; Symbols importados desde music_irq.asm: BellVolL, BellVolC, BellVolR,
  93+ E5D0              ; BellDecayTimer, BELL_DECAY_RATE.
  94+ E5D0
  95+ E5D0              ; ==============================================================================
  96+ E5D0              ; AY_PlayBellChime - Inicia una campanada con volumen + pan estereo
  97+ E5D0              ; ==============================================================================
  98+ E5D0              ; Volumen total proporcional a la distancia Manhattan a la plaza.
  99+ E5D0              ; Pan: dx>0 plaza al este (mas C), dx<0 plaza al oeste (mas A), dx=0 centro (B).
 100+ E5D0              ; ==============================================================================
 101+ E5D0              AY_PlayBellChimeImpl:
 102+ E5D0                  ; --- Calcular dx (signed) y |dx|, |dy| respecto a la PLAZA del reloj ---
 103+ E5D0                  ; (No usar START_SCREEN_X/Y, que es el spawn del player y cambia con el
 104+ E5D0                  ; editor — el sonido espacial debe centrarse en la plaza real).
 105+ E5D0 3A 10 83         LD A, (CurrentScreenX)
 106+ E5D3 D6 08            SUB PLAZA_SCREEN_X          ; A = dx (signed: + player al este, - player al oeste)
 107+ E5D5 57               LD D, A                     ; D = dx signed (player - plaza)
 108+ E5D6 30 02            JR NC, .absDxOk
 109+ E5D8 ED 44            NEG
 110+ E5DA              .absDxOk:
 111+ E5DA 47               LD B, A                     ; B = |dx|
 112+ E5DB
 113+ E5DB 3A 11 83         LD A, (CurrentScreenY)
 114+ E5DE D6 09            SUB PLAZA_SCREEN_Y
 115+ E5E0 30 02            JR NC, .absDyOk
 116+ E5E2 ED 44            NEG
 117+ E5E4              .absDyOk:
 118+ E5E4 80               ADD A, B                    ; A = |dx| + |dy| = distancia Manhattan
 119+ E5E5
 120+ E5E5                  ; --- Volumenes por tramo: dom(inante) y far (canal opuesto al dom) ---
 121+ E5E5                  ;   dist 0..2  -> dom=15, far=12  (cerca: bell envolvente)
 122+ E5E5                  ;   dist 3..5  -> dom=13, far=10  (medio: direccional pero audible)
 123+ E5E5                  ;   dist 6+    -> dom=11, far= 8  (lejos: direccional, MIN audible)
 124+ E5E5                  ; Centro (canal B en stereo) = dom/2. En panCenter (dx=0) solo suena B.
 125+ E5E5 06 0B            LD B, 11                    ; default tramo lejano: dom
 126+ E5E7 0E 08            LD C, 8                     ;                       far (subido +3 desde 5)
 127+ E5E9 FE 06            CP 6
 128+ E5EB 30 0C            JR NC, .volTotalSet
 129+ E5ED 06 0D            LD B, 13                    ; tramo medio (subido +1 desde 12)
 130+ E5EF 0E 0A            LD C, 10                    ;             (subido +2 desde 8)
 131+ E5F1 FE 03            CP 3
 132+ E5F3 30 04            JR NC, .volTotalSet
 133+ E5F5 06 0F            LD B, 15                    ; tramo cercano (sin cambios)
 134+ E5F7 0E 0C            LD C, 12
 135+ E5F9              .volTotalSet:                   ; B = dom_vol, C = far_vol
 136+ E5F9
 137+ E5F9                  ; --- Reparto del volumen entre canales segun dx (D = player-plaza) ---
 138+ E5F9                  ; D > 0  → player al ESTE de plaza → plaza al oeste (canal A dominante)
 139+ E5F9                  ; D < 0  → player al OESTE de plaza → plaza al este (canal C dominante)
 140+ E5F9                  ; D == 0 → alineado X → solo canal B (centro)
 141+ E5F9 7A               LD A, D
 142+ E5FA B7               OR A
 143+ E5FB 28 21            JR Z, .panCenter
 144+ E5FD F2 0F E6         JP P, .panLeft              ; D > 0 (positivo): plaza al oeste
 145+ E600                  ; D < 0: plaza al este → canal C dominante
 146+ E600              .panRight:
 147+ E600 79               LD A, C
 148+ E601 32 80 7F         LD (BellVolL), A            ; canal A = far (lejano de plaza)
 149+ E604 78               LD A, B
 150+ E605 32 82 7F         LD (BellVolR), A            ; canal C = dom
 151+ E608 CB 3F            SRL A
 152+ E60A 32 81 7F         LD (BellVolC), A            ; canal B = dom/2
 153+ E60D 18 1A            JR .panDone
 154+ E60F
 155+ E60F              .panLeft:
 156+ E60F                  ; D > 0: plaza al oeste → canal A dominante
 157+ E60F 78               LD A, B
 158+ E610 32 80 7F         LD (BellVolL), A            ; canal A = dom
 159+ E613 CB 3F            SRL A
 160+ E615 32 81 7F         LD (BellVolC), A            ; canal B = dom/2
 161+ E618 79               LD A, C
 162+ E619 32 82 7F         LD (BellVolR), A            ; canal C = far
 163+ E61C 18 0B            JR .panDone
 164+ E61E
 165+ E61E              .panCenter:
 166+ E61E                  ; Alineado: solo canal B
 167+ E61E 78               LD A, B
 168+ E61F 32 81 7F         LD (BellVolC), A
 169+ E622 AF               XOR A
 170+ E623 32 80 7F         LD (BellVolL), A
 171+ E626 32 82 7F         LD (BellVolR), A
 172+ E629
 173+ E629              .panDone:
 174+ E629 3E 02            LD A, BELL_DECAY_RATE
 175+ E62B 32 83 7F         LD (BellDecayTimer), A
 176+ E62E
 177+ E62E                  ; --- Configurar tono en los 3 canales (period 600 = $0258 → ~180Hz) ---
 178+ E62E 3E 00            LD A, 0                     ; R0: tone A LSB
 179+ E630 1E 58            LD E, $58
 180+ E632 CD 92 E5         CALL AY_WriteReg
 181+ E635 3E 01            LD A, 1                     ; R1: tone A MSB
 182+ E637 1E 02            LD E, $02
 183+ E639 CD 92 E5         CALL AY_WriteReg
 184+ E63C 3E 02            LD A, 2                     ; R2: tone B LSB
 185+ E63E 1E 58            LD E, $58
 186+ E640 CD 92 E5         CALL AY_WriteReg
 187+ E643 3E 03            LD A, 3                     ; R3: tone B MSB
 188+ E645 1E 02            LD E, $02
 189+ E647 CD 92 E5         CALL AY_WriteReg
