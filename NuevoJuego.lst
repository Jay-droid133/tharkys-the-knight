# file closed: bank_cutscene_thunks.asm
 192  6DB4
 193  6DB4                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 194  6DB4                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 195  6DB4                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 196  6DB4                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 197  6DB4                  ;
 198  6DB4                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 199  6DB4                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 200  6DB4                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 201  6DB4                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 202  6DB4                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 203  6DB4                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 204  6DB4                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 6DB4              ; ==============================================================================
   2+ 6DB4              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 6DB4              ; ==============================================================================
   4+ 6DB4              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 6DB4              ; Mientras MagicCompassTimer>0:
   6+ 6DB4              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 6DB4              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 6DB4              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 6DB4              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 6DB4              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 6DB4              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 6DB4              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 6DB4              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 6DB4              ;
  15+ 6DB4              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 6DB4              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 6DB4              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 6DB4              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 6DB4              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 6DB4              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 6DB4              ;
  22+ 6DB4              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 6DB4              ; ==============================================================================
  24+ 6DB4
  25+ 6DB4              ; ==============================================================================
  26+ 6DB4              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 6DB4              ; ==============================================================================
  28+ 6DB4              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 6DB4              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 6DB4              ; Destruye: AF, HL.
  31+ 6DB4              ; ==============================================================================
  32+ 6DB4              ApplyMagicCompassBuff:
  33+ 6DB4 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 6DB7 22 BF 5F         LD (MagicCompassTimer), HL
  35+ 6DBA 3E 01            LD A, 1
  36+ 6DBC 32 C3 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 6DBF AF               XOR A
  38+ 6DC0 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 6DC3 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 6DC5 32 C5 5F         LD (MagicCompassTickCounter), A
  41+ 6DC8                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  42+ 6DC8                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  43+ 6DC8                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  44+ 6DC8                  ; el futuro se quiere reactivar.
  45+ 6DC8 3E FF            LD A, $FF
  46+ 6DCA 32 C6 5F         LD (MagicCompassJingleIdx), A
  47+ 6DCD                  ; SFX al recoger: sweep ascendente AY canal B. Lasting tiene PIN extra.
  48+ 6DCD 3A BE 82         LD A, (MagicCompassPermanent)
  49+ 6DD0 B7               OR A
  50+ 6DD1 C2 DB 6B         JP NZ, AY_PlayLastingPickup         ; lasting: sweep largo + PIN (~1.12s)
  51+ 6DD4 C3 D0 6B         JP AY_PlayCompassPickup             ; random: sweep corto (~640ms)
  52+ 6DD7
  53+ 6DD7              ; ==============================================================================
  54+ 6DD7              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  55+ 6DD7              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  56+ 6DD7              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  57+ 6DD7              ; ==============================================================================
  58+ 6DD7              ; Entry points:
  59+ 6DD7              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  60+ 6DD7              ;                           muerte / hito cumplido / llegar a sala destino,
  61+ 6DD7              ;                           sites que no saben si la brujula estaba activa.
  62+ 6DD7              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  63+ 6DD7              ;                           por el branch del timeout natural (Timer ya es 0
  64+ 6DD7              ;                           tras el DEC, asi que el check daria RET Z falso
  65+ 6DD7              ;                           positivo y se saltaria el cleanup).
  66+ 6DD7              ; ==============================================================================
  67+ 6DD7              CancelMagicCompass:
  68+ 6DD7 3A BE 82         LD A, (MagicCompassPermanent)
  69+ 6DDA B7               OR A
  70+ 6DDB C0               RET NZ                               ; lasting compass: nunca cancelar
  71+ 6DDC 3A BF 5F         LD A, (MagicCompassTimer)
  72+ 6DDF 47               LD B, A
  73+ 6DE0 3A C0 5F         LD A, (MagicCompassTimer + 1)
  74+ 6DE3 B0               OR B
  75+ 6DE4 C8               RET Z                                ; ya inactivo
  76+ 6DE5                  ; fall through al cleanup compartido
  77+ 6DE5              _DoCancelMagicCompass:
  78+ 6DE5 AF               XOR A
  79+ 6DE6 32 BF 5F         LD (MagicCompassTimer), A
  80+ 6DE9 32 C0 5F         LD (MagicCompassTimer + 1), A
  81+ 6DEC 32 C5 5F         LD (MagicCompassTickCounter), A
  82+ 6DEF 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  83+ 6DF2 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  84+ 6DF5 3E FF            LD A, $FF
  85+ 6DF7 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  86+ 6DFA 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  87+ 6DFD 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  88+ 6E00 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  89+ 6E03 32 B3 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  90+ 6E06                                                       ; frame: DrawCompass detecta $FF y
  91+ 6E06                                                       ; entra a .dcRedraw, sustituyendo el
  92+ 6E06                                                       ; sprite_compass_magic stale por la
  93+ 6E06                                                       ; brujula clasica (8 flechas + X).
  94+ 6E06 C9               RET
  95+ 6E07
  96+ 6E07              ; ==============================================================================
  97+ 6E07              ; RefreshMagicCompassForNewObjective - Recompute path tras avance de hito
  98+ 6E07              ; ==============================================================================
  99+ 6E07              ; Llamado desde CheckMilestonePickup/Trigger/DebugKey tras CancelMagicCompass.
 100+ 6E07              ;
 101+ 6E07              ; Caso normal (random pickup, no Permanent): CancelMagicCompass ya zappeo el
 102+ 6E07              ; timer a 0; aqui retornamos inmediatamente sin tocar nada (no-op).
 103+ 6E07              ;
 104+ 6E07              ; Caso lasting compass (Permanent=1): CancelMagicCompass retorno sin tocar el
 105+ 6E07              ; estado, asi que el timer sigue activo. El BFS anterior dejo MagicCompassPathDir
 106+ 6E07              ; en $FF (current_sid == target_sid en el momento del pickup), lo que hace que
 107+ 6E07              ; DrawCompass cayera en .dcMagicOff y renderizara la brujula clasica. Sin
 108+ 6E07              ; recompute aqui, la brujula clasica persistia hasta el siguiente cambio de
 109+ 6E07              ; sala (donde CheckScreenTransition llama a ForceComputeMagicCompassPath).
 110+ 6E07              ;
 111+ 6E07              ; Recompute sincrono = brujula magica vuelve a apuntar al NUEVO objetivo en el
 112+ 6E07              ; mismo frame del pickup. Coste: ~10K T-states (~14% del frame), una sola vez
 113+ 6E07              ; por avance de hito; gameplay normal no afectado.
 114+ 6E07              ;
 115+ 6E07              ; Destruye: AF, BC, DE, HL.
 116+ 6E07              ; ==============================================================================
 117+ 6E07              RefreshMagicCompassForNewObjective:
 118+ 6E07 3A BF 5F         LD A, (MagicCompassTimer)
 119+ 6E0A 47               LD B, A
 120+ 6E0B 3A C0 5F         LD A, (MagicCompassTimer + 1)
 121+ 6E0E B0               OR B
 122+ 6E0F C8               RET Z                                ; magic inactiva: no-op
 123+ 6E10 3E FF            LD A, $FF
 124+ 6E12 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache HUD
 125+ 6E15 C3 18 6E         JP ForceComputeMagicCompassPath      ; tail call: BFS sincrono al nuevo goal
 126+ 6E18
 127+ 6E18              ; ==============================================================================
 128+ 6E18              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
 129+ 6E18              ; ==============================================================================
 130+ 6E18              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
 131+ 6E18              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
 132+ 6E18              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
 133+ 6E18              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
 134+ 6E18              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
 135+ 6E18              ; direccion vieja (de la sala anterior).
 136+ 6E18              ;
 137+ 6E18              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 138+ 6E18              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 139+ 6E18              ; solo en transiciones — nunca en frames de gameplay normal.
 140+ 6E18              ;
 141+ 6E18              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 142+ 6E18              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 143+ 6E18              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 144+ 6E18              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 145+ 6E18              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 146+ 6E18              ;
 147+ 6E18              ; Destruye: AF, BC, DE, HL.
 148+ 6E18              ; ==============================================================================
 149+ 6E18              ForceComputeMagicCompassPath:
 150+ 6E18 AF               XOR A
 151+ 6E19 32 CD 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 152+ 6E1C              .fcmcpLoop:
 153+ 6E1C CD D7 6E         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 154+ 6E1F                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 155+ 6E1F 3A CD 5F         LD A, (MagicCompassBfsState)
 156+ 6E22 B7               OR A
