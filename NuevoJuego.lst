4355+ BA5A              ; ==============================================================================
4356+ BA5A              ; CountActiveNasties / CountActiveMonsters
4357+ BA5A              ; ==============================================================================
4358+ BA5A              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4359+ BA5A              ; Ambas usan _CountSlots internamente.
4360+ BA5A              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4361+ BA5A              ; ==============================================================================
4362+ BA5A              CountActiveNasties:
4363+ BA5A 21 BC 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4364+ BA5D 06 04            LD B, NUM_NASTIES
4365+ BA5F 18 05            JR _CountSlots
4366+ BA61
4367+ BA61              CountActiveMonsters:
4368+ BA61 21 5C 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4369+ BA64 06 06            LD B, NUM_MONSTERS
