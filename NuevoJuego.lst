 873+ 7552
 874+ 7552              ; ==============================================================================
 875+ 7552              ; Variantes random de health/stamina pickup
 876+ 7552              ; ==============================================================================
 877+ 7552              ; Cuando el roll selecciona health o stamina, .urpDoHealth/.urpDoStamina
 878+ 7552              ; eligen una variante visual al azar. Asi el random pickup tiene mas
 879+ 7552              ; variedad. El efecto (cura salud/stamina) es el mismo regardless de
 880+ 7552              ; variante — solo cambia el sprite que se ve.
 881+ 7552              ;
 882+ 7552              ; Formato tabla: DEFB count, ids... (1 byte por id)
 883+ 7552              ; Cada id se resuelve a sprite ptr via BgGfxPtrById en runtime.
 884+ 7552              ; ==============================================================================
 885+ 7552              ; --- Variants tables: DEFW de ptrs directos (no BgGfxPtrById lookup) ---
 886+ 7552              ; Razon: BgGfxPtrById[id] puede apuntar a versiones RLE-comprimidas por
 887+ 7552              ; compress_bg_rle.py, y DrawBgSpriteXOR no decodifica RLE -> rendering corrupto.
 888+ 7552              ; Las labels BgGfx_*_pickup* injectadas por inject_pickup_sprites.py SI son
 889+ 7552              ; raw, asi que usamos esos labels directamente.
 890+ 7552              HealthVariantPtrs:
 891+ 7552 04               DEFB 4                              ; 4 variantes (1 byte count)
 892+ 7553 EC F1            DEFW BgGfx_health_pickup            ; canonical (id 254 injected raw)
 893+ 7555 15 F2            DEFW BgGfx_health_pickup_72         ; variant id 72
 894+ 7557 3E F2            DEFW BgGfx_health_pickup_3          ; variant id 74 ("health pickup 3")
 895+ 7559 67 F2            DEFW BgGfx_health_pickup_4          ; variant id 75 ("health pickup 4")
 896+ 755B
 897+ 755B              StaminaVariantPtrs:
 898+ 755B 02               DEFB 2                              ; 2 variantes
 899+ 755C 91 E7            DEFW BgGfx_stamina_pickup           ; canonical (id 255)
 900+ 755E 90 F2            DEFW BgGfx_stamina_pickup_2         ; variant id 73
 901+ 7560
 902+ 7560              ; ==============================================================================
 903+ 7560              ; PickRandomVariantPtr - HL = tabla -> HL = sprite ptr de variante random
 904+ 7560              ; ==============================================================================
 905+ 7560              ; IN:  HL = ptr a tabla "DEFB count, id1, id2, ..."
 906+ 7560              ; OUT: HL = sprite ptr (via BgGfxPtrById lookup del id elegido)
 907+ 7560              ; Destruye: AF, BC, DE
 908+ 7560              ; ==============================================================================
 909+ 7560              PickRandomVariantPtr:
 910+ 7560 7E               LD A, (HL)                          ; A = count
 911+ 7561 47               LD B, A                             ; B = count
 912+ 7562 23               INC HL                              ; HL @ first DEFW
 913+ 7563                  ; --- pseudo-RNG: A = R mod count ---
 914+ 7563 ED 5F            LD A, R
 915+ 7565              .pvpModLoop:
 916+ 7565 90               SUB B
 917+ 7566 30 FD            JR NC, .pvpModLoop
 918+ 7568 80               ADD A, B                            ; A = R mod count (0..count-1)
 919+ 7569                  ; --- HL += A*2 (entradas son DEFW = 2 bytes) ---
 920+ 7569 87               ADD A, A                            ; A *= 2
 921+ 756A 5F               LD E, A
 922+ 756B 16 00            LD D, 0
 923+ 756D 19               ADD HL, DE                          ; HL @ entry elegida
 924+ 756E 7E               LD A, (HL)
 925+ 756F 23               INC HL
 926+ 7570 66               LD H, (HL)
 927+ 7571 6F               LD L, A                             ; HL = sprite ptr (directo, raw, injectado)
 928+ 7572 C9               RET
 929+ 7573
# file closed: random_pickups.asm
 166  7573
 167  7573                  ; --- Thunk de la cinemática Game Over (slot 1 always-visible) ---
 168  7573                  ; ~45 B. Wrapper que carga el sprite, pagina bank 7, llama al body en
 169  7573                  ; bank 7, restaura bank 0. El body (game_over_tomb.asm) vive en bank 7.
 170  7573                  ;
 171  7573                  ; Orden: lo dejamos aquí (antes de magic_compass.asm) por simetría histórica.
 172  7573                  ; Originalmente este orden era OBLIGATORIO porque el tail de magic_compass.asm
 173  7573                  ; (BfsQueue+Visited como DEFS, 224 B) se extendía hasta $7A3B y solapaba con
 174  7573                  ; la tabla IM 2 de music_irq.asm ($7A00..$7B00). Si el thunk iba detrás caía
 175  7573                  ; en zona pisada por la IM 2. Ese problema YA NO EXISTE — el BFS scratch
 176  7573                  ; ahora vive en $5B00..$5BDF (EQU, ver magic_compass.asm), pero el orden se
 177  7573                  ; mantiene por estabilidad.
 178  7573                  INCLUDE "game_over_tomb_thunk.asm"
# file opened: game_over_tomb_thunk.asm
   1+ 7573              ; ==============================================================================
   2+ 7573              ; GAME OVER TUMBA — THUNK (slot 1 always-visible, ~45 B)
   3+ 7573              ; ==============================================================================
   4+ 7573              ; Wrapper para llamar al body que vive en bank 7. El body por sí mismo no puede
   5+ 7573              ; llamar a LoadBgSpriteToBuffer (esa rutina restaura bank 0 al final → bank 7
   6+ 7573              ; desaparecería del slot 3 con el body ejecutándose → crash).
   7+ 7573              ;
   8+ 7573              ; Estrategia:
   9+ 7573              ;   1. Carga el sprite usando LoadBgSpriteToBuffer normalmente. Termina con
  10+ 7573              ;      bank 0 paginado en slot 3.
  11+ 7573              ;   2. Pagina bank 7 en slot 3 (el thunk vive en slot 1 always-visible →
  12+ 7573              ;      seguro hacer la conmutación aquí).
  13+ 7573              ;   3. CALL al body (en bank 7, ahora visible en slot 3).
  14+ 7573              ;   4. Body retorna → restauramos bank 0.
  15+ 7573              ;
  16+ 7573              ; Llamado por PaintGameOverScreen (en logic_game.asm, bank 0). PaintGameOverScreen
  17+ 7573              ; está en slot 3 = bank 0; tras LoadBgSpriteToBuffer y el round-trip a bank 7,
  18+ 7573              ; restauramos bank 0 antes del RET → caller sigue ejecutando bank 0 sin sorpresas.
  19+ 7573              ; ==============================================================================
  20+ 7573
  21+ 7573              DrawTombstone2xCentered:
  22+ 7573                  ; --- 1. Cargar sprite a BgSpriteBuffer (bank 4 in/out, restaura bank 0) ---
  23+ 7573 21 6C D9         LD HL, BgGfx_little_house_cemetery
