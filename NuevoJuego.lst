 557+ 6F17 ~
 558+ 6F17 ~                ; Match comp?
 559+ 6F17 ~                LD A, (.cmcpGapSideComp)
 560+ 6F17 ~                SRL A
 561+ 6F17 ~                SRL A                                ; A = comp (bits 2-3 → bits 0-1)
 562+ 6F17 ~                AND $03
 563+ 6F17 ~                LD C, A                              ; C = gap comp
 564+ 6F17 ~                LD A, (.cmcpRComp)
