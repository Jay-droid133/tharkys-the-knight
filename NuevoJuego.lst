1061+ A7A9              ; ==============================================================================
1062+ A7A9              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
1063+ A7A9              ; ==============================================================================
1064+ A7A9              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
1065+ A7A9              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
1066+ A7A9              ; ==============================================================================
1067+ A7A9              GetSpriteAddr:
1068+ A7A9                  ; Paging INLINE. No usar CALL PageBankSlot3 porque su RET leeria del
1069+ A7A9                  ; stack tras cambiar de banco (ver nota en DrawSprite en engine_graphics).
1070+ A7A9 3A 82 90         LD A, (CurrentPaging)
1071+ A7AC E6 F8            AND $F8
1072+ A7AE F6 06            OR 6
1073+ A7B0 32 82 90         LD (CurrentPaging), A
1074+ A7B3 01 FD 7F         LD BC, $7FFD
1075+ A7B6 ED 79            OUT (C), A                  ; bank 6 paginado
1076+ A7B8 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1077+ A7BB 6F               LD L, A
1078+ A7BC 26 00            LD H, 0
1079+ A7BE 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
1080+ A7BF 11 B7 E7         LD DE, SpriteFrameTable
1081+ A7C2 19               ADD HL, DE
1082+ A7C3 5E               LD E, (HL)
1083+ A7C4 23               INC HL
1084+ A7C5 56               LD D, (HL)
1085+ A7C6 ED 53 D8 A7      LD (SpriteAddrTemp), DE
1086+ A7CA 3A 82 90         LD A, (CurrentPaging)
1087+ A7CD E6 F8            AND $F8
1088+ A7CF 32 82 90         LD (CurrentPaging), A
1089+ A7D2 01 FD 7F         LD BC, $7FFD
1090+ A7D5 ED 79            OUT (C), A                  ; bank 0 de vuelta
1091+ A7D7 C9               RET
1092+ A7D8
1093+ A7D8 00 00        SpriteAddrTemp: DEFW 0
1094+ A7DA
1095+ A7DA              ; ==============================================================================
1096+ A7DA              ; GetOldSpriteAddr - Obtiene puntero al sprite OLD (frame anterior) de la entidad
1097+ A7DA              ; ==============================================================================
1098+ A7DA              ; Lee ENT_OLDSPRID de IX, busca en SpriteFrameTable.
1099+ A7DA              ; Salida:   DE = puntero al sprite data
1100+ A7DA              ;           OldSprAddr = mismo puntero (conveniencia para caller)
1101+ A7DA              ; Preserva: IX
1102+ A7DA              ; Destruye: A, HL
1103+ A7DA              ; ==============================================================================
1104+ A7DA              GetOldSpriteAddr:
1105+ A7DA                  ; Paging inline (ver GetSpriteAddr)
1106+ A7DA 3A 82 90         LD A, (CurrentPaging)
1107+ A7DD E6 F8            AND $F8
1108+ A7DF F6 06            OR 6
1109+ A7E1 32 82 90         LD (CurrentPaging), A
1110+ A7E4 01 FD 7F         LD BC, $7FFD
1111+ A7E7 ED 79            OUT (C), A
1112+ A7E9 DD 7E 0E         LD A, (IX+ENT_OLDSPRID)
1113+ A7EC 6F               LD L, A
1114+ A7ED 26 00            LD H, 0
1115+ A7EF 29               ADD HL, HL
1116+ A7F0 11 B7 E7         LD DE, SpriteFrameTable
1117+ A7F3 19               ADD HL, DE
1118+ A7F4 5E               LD E, (HL)
1119+ A7F5 23               INC HL
1120+ A7F6 56               LD D, (HL)
1121+ A7F7 ED 53 62 A7      LD (OldSprAddr), DE
1122+ A7FB 3A 82 90         LD A, (CurrentPaging)
1123+ A7FE E6 F8            AND $F8
1124+ A800 32 82 90         LD (CurrentPaging), A
1125+ A803 01 FD 7F         LD BC, $7FFD
1126+ A806 ED 79            OUT (C), A
1127+ A808 C9               RET
1128+ A809
1129+ A809              ; ==============================================================================
1130+ A809              ; GetSpriteDims - Lee dimensiones del sprite desde su cabecera
1131+ A809              ; ==============================================================================
1132+ A809              ; Entrada: A = SpriteID
1133+ A809              ; Salida:  B = ancho en pixels (width_bytes * 8), C = alto en pixels
1134+ A809              ; Destruye: A, DE, HL
1135+ A809              ; ==============================================================================
1136+ A809              GetSpriteDims:
1137+ A809                  ; Paging inline (ver GetSpriteAddr). B,C son outputs y LD BC los
1138+ A809                  ; destruye al re-paginar; guardamos en SavedB/SavedC (bank 2).
1139+ A809 6F               LD L, A                     ; L = SpriteID (save A antes de clobber)
1140+ A80A 26 00            LD H, 0
1141+ A80C 3A 82 90         LD A, (CurrentPaging)
1142+ A80F E6 F8            AND $F8
1143+ A811 F6 06            OR 6
1144+ A813 32 82 90         LD (CurrentPaging), A
1145+ A816 01 FD 7F         LD BC, $7FFD
1146+ A819 ED 79            OUT (C), A                  ; bank 6 paginado
1147+ A81B 29               ADD HL, HL
1148+ A81C 11 B7 E7         LD DE, SpriteFrameTable
1149+ A81F 19               ADD HL, DE
1150+ A820 5E               LD E, (HL)
1151+ A821 23               INC HL
1152+ A822 56               LD D, (HL)                  ; DE = ptr al sprite data
1153+ A823 1A               LD A, (DE)                  ; width_bytes
1154+ A824 87               ADD A, A
1155+ A825 87               ADD A, A
1156+ A826 87               ADD A, A                    ; × 8 = width_px
1157+ A827 47               LD B, A
1158+ A828 13               INC DE
1159+ A829 1A               LD A, (DE)                  ; height_px
1160+ A82A 4F               LD C, A
1161+ A82B                  ; Preservar B,C via memoria (bank 2) antes de clobber por LD BC
1162+ A82B 78               LD A, B
1163+ A82C 32 49 A8         LD (GsdSavedB), A
1164+ A82F 79               LD A, C
1165+ A830 32 4A A8         LD (GsdSavedC), A
1166+ A833 3A 82 90         LD A, (CurrentPaging)
1167+ A836 E6 F8            AND $F8
1168+ A838 32 82 90         LD (CurrentPaging), A
1169+ A83B 01 FD 7F         LD BC, $7FFD
1170+ A83E ED 79            OUT (C), A                  ; bank 0 de vuelta
1171+ A840 3A 49 A8         LD A, (GsdSavedB)
1172+ A843 47               LD B, A
1173+ A844 3A 4A A8         LD A, (GsdSavedC)
1174+ A847 4F               LD C, A
1175+ A848 C9               RET
1176+ A849
1177+ A849 00           GsdSavedB: DEFB 0
1178+ A84A 00           GsdSavedC: DEFB 0
1179+ A84B
1180+ A84B              ; ==============================================================================
1181+ A84B              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
1182+ A84B              ; ==============================================================================
1183+ A84B              ; IX = puntero a la entidad del player (slot 0)
1184+ A84B              ; ==============================================================================
1185+ A84B              UpdatePlayer:
1186+ A84B CD 73 A8         CALL UpdatePlayerState
1187+ A84E CD 8E A9         CALL UpdatePlayerMovement
1188+ A851 CD 07 AC         CALL UpdatePlayerAnimation
1189+ A854                  ; Phase 2 grace blink: PlayerRespawnTimer != 0 sólo durante phase 2 aquí
1190+ A854                  ; (phase 1 está gateado en ProcessPlayer; phase 0 → timer=0 → no-op).
1191+ A854                  ; Toggle SPRITEID a BLANK cada ~2 frames vía bit 1 del GameFrameCounter
1192+ A854                  ; (~6 Hz). UpdatePlayerAnimation acaba de fijar el frame normal; este
1193+ A854                  ; override solo lo sustituye en frames OFF, dejando la animación viva en
1194+ A854                  ; los ON. Slot 0 = player, ENT_SPRITEID=0 → escribir a (EntityTable).
1195+ A854                  ; ON frame: si SPRITEID quedó como BLANK del frame OFF anterior porque
1196+ A854                  ; la animación (idle, ANIM_DELAY=10) no tickeó este frame, restaurar a
1197+ A854                  ; ANIMBASE para que el ON se vea. Sin esto, vista frontal idle queda
1198+ A854                  ; invisible toda la gracia (caminando funciona porque ANIM_DELAY_RUN=2
1199+ A854                  ; tickea a tiempo y reescribe SPRITEID).
1200+ A854 3A EC 82         LD A, (PlayerRespawnTimer)
1201+ A857 B7               OR A
1202+ A858 C8               RET Z
1203+ A859 3A 98 81         LD A, (GameFrameCounter)
1204+ A85C E6 02            AND 2
1205+ A85E 28 0D            JR Z, .pblOffFrame
1206+ A860                  ; ON frame: validar SPRITEID — si está como BLANK, restaurar a ANIMBASE
1207+ A860 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1208+ A863 FE 74            CP SPRID_PLAYER_BLANK
1209+ A865 C0               RET NZ                              ; sprite válido (anim viva) → keep
1210+ A866 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1211+ A869 DD 77 00         LD (IX+ENT_SPRITEID), A             ; restaurar al frame base
1212+ A86C C9               RET
1213+ A86D              .pblOffFrame:
1214+ A86D 3E 74            LD A, SPRID_PLAYER_BLANK
1215+ A86F 32 9B 81         LD (EntityTable), A
1216+ A872 C9               RET
1217+ A873
1218+ A873              ; ==============================================================================
1219+ A873              ; UpdatePlayerState - Determina estado y direccion desde input
1220+ A873              ; ==============================================================================
1221+ A873              UpdatePlayerState:
1222+ A873 3A AB 82         LD A, (InputDirection)
1223+ A876 47               LD B, A
1224+ A877 3A AC 82         LD A, (InputFire)
1225+ A87A 4F               LD C, A
1226+ A87B
1227+ A87B                  ; Sin input → idle (salvo si ataque en curso)
1228+ A87B 78               LD A, B
1229+ A87C B1               OR C
1230+ A87D 20 17            JR NZ, .notIdle
1231+ A87F                  ; Comprobar si ataque sigue activo (gestionado por SwordMode dispatch)
1232+ A87F 3A ED B5         LD A, (AttackTimer)
1233+ A882 B7               OR A
1234+ A883 20 11            JR NZ, .notIdle             ; Ataque en curso → no poner idle, dejar al dispatch
1235+ A885 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
1236+ A889                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
1237+ A889 DD 7E 0A         LD A, (IX+ENT_DIR)
1238+ A88C E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
1239+ A88E DD 77 0A         LD (IX+ENT_DIR), A
1240+ A891                  ; Limpiar debounce de ataque (SPACE no pulsado = permitir siguiente)
1241+ A891 AF               XOR A
1242+ A892 32 EF B5         LD (AttackDebounce), A
1243+ A895 C9               RET
1244+ A896
1245+ A896              .notIdle:
1246+ A896                  ; Guardar direccion actual en bits 0-3
1247+ A896 DD 7E 0A         LD A, (IX+ENT_DIR)
1248+ A899 E6 F0            AND $F0                     ; Mantener lastHDir
1249+ A89B B0               OR B                        ; Añadir dir actual
1250+ A89C DD 77 0A         LD (IX+ENT_DIR), A
1251+ A89F
1252+ A89F                  ; Actualizar lastHDir si hay componente E/W (solo si no esta atacando)
1253+ A89F 3A ED B5         LD A, (AttackTimer)
1254+ A8A2 B7               OR A
1255+ A8A3 20 13            JR NZ, .noHorizUpdate       ; Atacando → congelar lastHDir
1256+ A8A5 78               LD A, B
1257+ A8A6 E6 0C            AND DIR_E | DIR_W
1258+ A8A8 28 0E            JR Z, .noHorizUpdate
1259+ A8AA                  ; Guardar en bits 4-7
1260+ A8AA 07               RLCA
1261+ A8AB 07               RLCA
1262+ A8AC 07               RLCA
1263+ A8AD 07               RLCA                        ; Shift a bits 4-7
1264+ A8AE 4F               LD C, A                     ; C = lastHDir en bits 4-7
1265+ A8AF DD 7E 0A         LD A, (IX+ENT_DIR)
1266+ A8B2 E6 0F            AND $0F                     ; Mantener dir actual
1267+ A8B4 B1               OR C                        ; Añadir lastHDir
1268+ A8B5 DD 77 0A         LD (IX+ENT_DIR), A
1269+ A8B8              .noHorizUpdate:
1270+ A8B8
1271+ A8B8                  ; --- Consumir/regenerar stamina ---
1272+ A8B8 CD 3A AD         CALL UpdateStamina
1273+ A8BB                  ; --- Auto-select sword mode segun stamina ---
1274+ A8BB CD 60 AD         CALL SelectSwordMode
1275+ A8BE                  ; --- Dispatch segun SwordMode ---
1276+ A8BE 3A F1 B5         LD A, (SwordMode)
1277+ A8C1 B7               OR A
1278+ A8C2 28 09            JR Z, .swordModeB
1279+ A8C4 FE 01            CP 1
1280+ A8C6 28 3F            JR Z, .swordModeC
1281+ A8C8 FE 02            CP 2
1282+ A8CA CA 30 A9         JP Z, .swordModeFree
1283+ A8CD
1284+ A8CD                  ; === MODO B: Cooldown fijo tras atacar ===
1285+ A8CD              .swordModeB:
1286+ A8CD 3A EE B5         LD A, (AttackCooldown)
1287+ A8D0 B7               OR A
1288+ A8D1 28 0D            JR Z, .bNoCooldown
1289+ A8D3 3D               DEC A
1290+ A8D4 32 EE B5         LD (AttackCooldown), A
1291+ A8D7 C2 7E A9         JP NZ, .running                     ; En cooldown: no puede atacar
1292+ A8DA                  ; Cooldown terminado: restaurar color blanco
