 157+ 9E7F              ; ==============================================================================
 158+ 9E7F              ; InitEntities - Inicializa la tabla de entidades
 159+ 9E7F              ; ==============================================================================
 160+ 9E7F              ; Limpia todos los slots y configura el slot 0 como player.
 161+ 9E7F              ; ==============================================================================
 162+ 9E7F              InitEntities:
 163+ 9E7F                  ; Limpiar toda la tabla a ceros
 164+ 9E7F 21 9D 81         LD HL, EntityTable
 165+ 9E82 11 9E 81         LD DE, EntityTable + 1
 166+ 9E85 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E88 AF               XOR A
 168+ 9E89 77               LD (HL), A
 169+ 9E8A ED B0            LDIR
 170+ 9E8C
 171+ 9E8C                  ; Limpiar tabla de atributos salvados
 172+ 9E8C 21 D9 9B         LD HL, SavedAttrTable
 173+ 9E8F 11 DA 9B         LD DE, SavedAttrTable + 1
 174+ 9E92 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E95 AF               XOR A
 176+ 9E96 77               LD (HL), A
 177+ 9E97 ED B0            LDIR
 178+ 9E99
 179+ 9E99                  ; Configurar slot 0: Player
 180+ 9E99 DD 21 9D 81      LD IX, EntityTable
 181+ 9E9D DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ 9EA1 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ 9EA5 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ 9EA9 DD 36 03 98      LD (IX+ENT_POSX), START_PLAYER_X
 185+ 9EAD DD 36 04 48      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ 9EB1 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ 9EB5 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ 9EB9 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ 9EBD DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ 9EC1 DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EC5 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9EC9 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ 9ECD DD 36 0C 98      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ 9ED1 DD 36 0D 48      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ 9ED5 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ 9ED9 DD 36 0F 98      LD (IX+ENT_DRAWX), START_PLAYER_X
 197+ 9EDD
 198+ 9EDD                  ; Resetear spawn timer (delay antes del primer nasty), round-robin y pending erase
 199+ 9EDD 3E 0C            LD A, SPAWN_INTERVAL
 200+ 9EDF 32 F7 82         LD (SpawnTimer), A
 201+ 9EE2 AF               XOR A
 202+ 9EE3 32 04 83         LD (EnemyStepIdx), A
 203+ 9EE6 32 7B 5F         LD (PendingEraseCount), A
 204+ 9EE9 C9               RET
 205+ 9EEA
 206+ 9EEA              ; ==============================================================================
 207+ 9EEA              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ 9EEA              ; ==============================================================================
 209+ 9EEA              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ 9EEA              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ 9EEA              ; que los pies parezcan hundirse en el suelo.
 212+ 9EEA              ; ==============================================================================
 213+ 9EEA              ComputePlayerDrawY:
 214+ 9EEA                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ 9EEA                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ 9EEA                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ 9EEA 3A 9D 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ 9EED D6 6E            SUB SPRID_PLAYER_DEATH
 219+ 9EEF FE 06            CP 6
 220+ 9EF1 30 09            JR NC, .cpdyNotDeath
 221+ 9EF3 3A A1 81         LD A, (EntityTable + ENT_POSY)
 222+ 9EF6 C6 05            ADD A, 5
 223+ 9EF8 32 DE 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ 9EFB C9               RET
 225+ 9EFC              .cpdyNotDeath:
 226+ 9EFC 3A A0 81         LD A, (EntityTable + ENT_POSX)
 227+ 9EFF C6 08            ADD A, 8                    ; center X del player
 228+ 9F01 47               LD B, A
 229+ 9F02 3A A1 81         LD A, (EntityTable + ENT_POSY)
 230+ 9F05 4F               LD C, A
 231+ 9F06 32 DE 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ 9F09 B7               OR A
 233+ 9F0A C8               RET Z
 234+ 9F0B 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ 9F0C CD B6 D5         CALL IsPointBlocked
 236+ 9F0F C8               RET Z                       ; libre → sin offset
 237+ 9F10 3A A1 81         LD A, (EntityTable + ENT_POSY)
 238+ 9F13 3C               INC A
 239+ 9F14 32 DE 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ 9F17 C9               RET
 241+ 9F18
 242+ 9F18              ; ==============================================================================
 243+ 9F18              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ 9F18              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ 9F18              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ 9F18              ; no parecer que se hunde en el techo.
 247+ 9F18              ; Preserva: IX. Destruye: AF, BC.
 248+ 9F18              ; ==============================================================================
 249+ 9F18              ComputeEnemyDrawY:
 250+ 9F18 DD 7E 04         LD A, (IX+ENT_POSY)
 251+ 9F1B 32 DF 82         LD (EnemyDrawY), A          ; default = POSY
 252+ 9F1E DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ 9F21 FE 02            CP TYPE_MONSTER
 254+ 9F23 C0               RET NZ                      ; no monster → sin offset
 255+ 9F24 DD 7E 03         LD A, (IX+ENT_POSX)
 256+ 9F27 C6 08            ADD A, 8                    ; center X
 257+ 9F29 47               LD B, A
 258+ 9F2A DD 7E 04         LD A, (IX+ENT_POSY)
 259+ 9F2D 4F               LD C, A
 260+ 9F2E B7               OR A
 261+ 9F2F C8               RET Z
 262+ 9F30 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ 9F31 CD B6 D5         CALL IsPointBlocked
 264+ 9F34 C8               RET Z                       ; libre → sin offset
 265+ 9F35 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ 9F38 3C               INC A
 267+ 9F39 32 DF 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ 9F3C C9               RET
 269+ 9F3D
 270+ 9F3D              ; ==============================================================================
 271+ 9F3D              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 272+ 9F3D              ; ==============================================================================
 273+ 9F3D              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 274+ 9F3D              ; ==============================================================================
 275+ 9F3D              ProcessPlayer:
 276+ 9F3D DD 21 9D 81      LD IX, EntityTable
 277+ 9F41
 278+ 9F41                  ; --- Fresh check ---
 279+ 9F41 3A 14 83         LD A, (ScreenJustRedrawn)
 280+ 9F44 B7               OR A
 281+ 9F45 C2 11 A0         JP NZ, .plFresh
 282+ 9F48 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 283+ 9F4C C2 11 A0         JP NZ, .plFresh
 284+ 9F4F
 285+ 9F4F                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 286+ 9F4F                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 287+ 9F4F                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 288+ 9F4F                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 289+ 9F4F                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 290+ 9F4F                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 291+ 9F4F                  ; y UpdatePlayerAnimation lo sobrescribiria.
 292+ 9F4F 3A E9 82         LD A, (DeathBorderPhase)
 293+ 9F52 B7               OR A
 294+ 9F53 20 0A            JR NZ, .plSkipUpdate
 295+ 9F55 3A ED 82         LD A, (PlayerRespawnPhase)
 296+ 9F58 FE 01            CP 1
 297+ 9F5A 28 03            JR Z, .plSkipUpdate
 298+ 9F5C CD 67 A5         CALL UpdatePlayer
 299+ 9F5F              .plSkipUpdate:
 300+ 9F5F CD 80 A4         CALL CalcDrawX
 301+ 9F62 CD EA 9E         CALL ComputePlayerDrawY
 302+ 9F65
 303+ 9F65                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 304+ 9F65 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 305+ 9F68 DD BE 0C         CP (IX+ENT_OLDX)
 306+ 9F6B 20 3C            JR NZ, .plDoErase
 307+ 9F6D 3A DE 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 308+ 9F70 DD BE 0D         CP (IX+ENT_OLDY)
 309+ 9F73 20 34            JR NZ, .plDoErase
 310+ 9F75 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 311+ 9F78 DD BE 0E         CP (IX+ENT_OLDSPRID)
 312+ 9F7B 20 2C            JR NZ, .plDoErase
 313+ 9F7D                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 314+ 9F7D 3A 1E C5         LD A, (PlayerHitTimer)
 315+ 9F80 B7               OR A
 316+ 9F81 20 01            JR NZ, .plRepaintAttr
 317+ 9F83 C9               RET                                 ; Nada cambio → skip todo
 318+ 9F84              .plRepaintAttr:
 319+ 9F84 3A DE 82         LD A, (PlayerDrawY)
 320+ 9F87 57               LD D, A
 321+ 9F88 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 322+ 9F8B 5F               LD E, A
 323+ 9F8C DD E5            PUSH IX
 324+ 9F8E CD C5 A4         CALL GetSpriteAddr
 325+ 9F91 DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 326+ 9F95 CD 06 9B         CALL CalcEntityAttrSize
 327+ 9F98 DD E1            POP IX
 328+ 9F9A 3A DE 82         LD A, (PlayerDrawY)
 329+ 9F9D 57               LD D, A
 330+ 9F9E DD 7E 0F         LD A, (IX+ENT_DRAWX)
 331+ 9FA1 5F               LD E, A
 332+ 9FA2 DD 7E 05         LD A, (IX+ENT_ATTR)
 333+ 9FA5 CD D9 9A         CALL SetEntityAttr
 334+ 9FA8 C9               RET
 335+ 9FA9
 336+ 9FA9              .plDoErase:
 337+ 9FA9                  ; --- Erase viejo ---
 338+ 9FA9 CD F6 A4         CALL GetOldSpriteAddr
 339+ 9FAC DD 56 0D         LD D, (IX+ENT_OLDY)                 ; OLDY ya incluye el +1 visual (se guarda así en plSaveOld)
 340+ 9FAF DD 7E 0C         LD A, (IX+ENT_OLDX)
 341+ 9FB2 5F               LD E, A
 342+ 9FB3 DD E5            PUSH IX
 343+ 9FB5 DD 2A 7E A4      LD IX, (OldSprAddr)
 344+ 9FB9 CD E9 99         CALL DrawSprite
 345+ 9FBC DD E1            POP IX
 346+ 9FBE                  ; Restaurar atributos del fondo en posicion vieja
 347+ 9FBE DD 56 0D         LD D, (IX+ENT_OLDY)
 348+ 9FC1 DD 5E 0C         LD E, (IX+ENT_OLDX)
 349+ 9FC4 CD 46 D3         CALL RestoreOldAttr
 350+ 9FC7                  ; --- Draw nuevo ---
 351+ 9FC7 CD C5 A4         CALL GetSpriteAddr
 352+ 9FCA 3A DE 82         LD A, (PlayerDrawY)
 353+ 9FCD 57               LD D, A
 354+ 9FCE DD 7E 0F         LD A, (IX+ENT_DRAWX)
 355+ 9FD1 5F               LD E, A
 356+ 9FD2 DD E5            PUSH IX
 357+ 9FD4 DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 358+ 9FD8 CD E9 99         CALL DrawSprite
 359+ 9FDB DD E1            POP IX
 360+ 9FDD
 361+ 9FDD                  ; Pintar attr
 362+ 9FDD 3A DE 82         LD A, (PlayerDrawY)
 363+ 9FE0 57               LD D, A
 364+ 9FE1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 365+ 9FE4 5F               LD E, A
 366+ 9FE5 DD E5            PUSH IX
 367+ 9FE7 DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 368+ 9FEB CD 06 9B         CALL CalcEntityAttrSize
 369+ 9FEE DD E1            POP IX
 370+ 9FF0 3A DE 82         LD A, (PlayerDrawY)
 371+ 9FF3 57               LD D, A
 372+ 9FF4 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 373+ 9FF7 5F               LD E, A
 374+ 9FF8 DD 7E 05         LD A, (IX+ENT_ATTR)
 375+ 9FFB CD D9 9A         CALL SetEntityAttr
 376+ 9FFE
 377+ 9FFE                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
 378+ 9FFE              .plSaveOld:
 379+ 9FFE DD 7E 0F         LD A, (IX+ENT_DRAWX)
 380+ A001 DD 77 0C         LD (IX+ENT_OLDX), A
 381+ A004 3A DE 82         LD A, (PlayerDrawY)
 382+ A007 DD 77 0D         LD (IX+ENT_OLDY), A
 383+ A00A DD 7E 00         LD A, (IX+ENT_SPRITEID)
 384+ A00D DD 77 0E         LD (IX+ENT_OLDSPRID), A
 385+ A010 C9               RET
 386+ A011
 387+ A011                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 388+ A011              .plFresh:
 389+ A011 DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 390+ A015 CD 67 A5         CALL UpdatePlayer
 391+ A018 CD 80 A4         CALL CalcDrawX
 392+ A01B CD EA 9E         CALL ComputePlayerDrawY
 393+ A01E CD C5 A4         CALL GetSpriteAddr
 394+ A021
 395+ A021 3A DE 82         LD A, (PlayerDrawY)
 396+ A024 57               LD D, A
 397+ A025 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 398+ A028 5F               LD E, A
 399+ A029 DD E5            PUSH IX
 400+ A02B DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 401+ A02F CD 06 9B         CALL CalcEntityAttrSize
 402+ A032 DD E1            POP IX
 403+ A034 3A DE 82         LD A, (PlayerDrawY)
 404+ A037 57               LD D, A
 405+ A038 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 406+ A03B 5F               LD E, A
 407+ A03C DD 7E 05         LD A, (IX+ENT_ATTR)
 408+ A03F CD D9 9A         CALL SetEntityAttr
 409+ A042
 410+ A042 3A DE 82         LD A, (PlayerDrawY)
 411+ A045 57               LD D, A
 412+ A046 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 413+ A049 5F               LD E, A
 414+ A04A DD E5            PUSH IX
 415+ A04C DD 2A F4 A4      LD IX, (SpriteAddrTemp)
 416+ A050 CD E9 99         CALL DrawSprite
 417+ A053 DD E1            POP IX
 418+ A055 18 A7            JR .plSaveOld
 419+ A057
 420+ A057              ; ==============================================================================
 421+ A057              ; ProcessEnemies - Round-robin: erase + logic + draw por entidad
 422+ A057              ; ==============================================================================
 423+ A057              ; Fiel a Sabre Wulf: cada entidad hace todo junto (erase viejo, AI, draw nuevo).
 424+ A057              ; Procesa hasta MAX_ENEMIES_PER_FRAME enemigos activos, continuando desde donde
 425+ A057              ; se quedo el frame anterior. Los no procesados no se mueven ni redibujan.
 426+ A057              ; ==============================================================================
 427+ A057              ProcessEnemies:
 428+ A057 3E 00            LD A, 0
 429+ A059 32 A2 A0         LD (.peCount), A
 430+ A05C 06 09            LD B, NUM_MONSTERS + NUM_NASTIES
 431+ A05E
 432+ A05E              .peLoop:
 433+ A05E C5               PUSH BC
 434+ A05F
 435+ A05F                  ; Calcular IX desde EnemyStepIdx
 436+ A05F 3A 04 83         LD A, (EnemyStepIdx)
 437+ A062 C6 01            ADD A, SLOT_MONSTER0
 438+ A064 6F               LD L, A
 439+ A065 26 00            LD H, 0
 440+ A067 29               ADD HL, HL
 441+ A068 29               ADD HL, HL
 442+ A069 29               ADD HL, HL
 443+ A06A 29               ADD HL, HL                          ; × ENT_SIZE (16)
 444+ A06B 11 9D 81         LD DE, EntityTable
 445+ A06E 19               ADD HL, DE
 446+ A06F E5               PUSH HL
 447+ A070 DD E1            POP IX
 448+ A072
 449+ A072                  ; Avanzar indice round-robin
 450+ A072 3A 04 83         LD A, (EnemyStepIdx)
 451+ A075 3C               INC A
 452+ A076 FE 09            CP NUM_MONSTERS + NUM_NASTIES
 453+ A078 38 01            JR C, .peNoWrap
 454+ A07A AF               XOR A
 455+ A07B              .peNoWrap:
 456+ A07B 32 04 83         LD (EnemyStepIdx), A
 457+ A07E
 458+ A07E                  ; Slot activo?
 459+ A07E DD 7E 01         LD A, (IX+ENT_TYPE)
 460+ A081 B7               OR A
 461+ A082 28 16            JR Z, .peSkip
 462+ A084
 463+ A084                  ; Checkear NEWSPAWN antes de procesar (se limpia dentro)
 464+ A084 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 465+ A088 F5               PUSH AF                             ; Guardar flags (Z=no fresh)
 466+ A089
 467+ A089                  ; Procesar esta entidad completa (erase + logic + draw)
 468+ A089 CD A3 A0         CALL ProcessOneEnemy
 469+ A08C
 470+ A08C                  ; NEWSPAWN no cuenta contra el budget (solo draw, sin erase = barato)
 471+ A08C F1               POP AF
 472+ A08D 20 0B            JR NZ, .peSkip                      ; Era fresh → no contar
 473+ A08F
 474+ A08F                  ; Budget check
 475+ A08F 3A A2 A0         LD A, (.peCount)
 476+ A092 3C               INC A
 477+ A093 32 A2 A0         LD (.peCount), A
 478+ A096 FE 02            CP MAX_ENEMIES_PER_FRAME
 479+ A098 30 06            JR NC, .peDone
 480+ A09A
 481+ A09A              .peSkip:
 482+ A09A C1               POP BC
 483+ A09B 05               DEC B
 484+ A09C C2 5E A0         JP NZ, .peLoop
 485+ A09F C9               RET
 486+ A0A0
 487+ A0A0              .peDone:
 488+ A0A0 C1               POP BC
