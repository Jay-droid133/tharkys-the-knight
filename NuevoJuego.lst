 440+ 6F17 ~                LD A, (.cmcpCurSid)
 441+ 6F17 ~                CP B
 442+ 6F17 ~                JP Z, .cmcpNoPath                    ; current==target → X blanca
 443+ 6F17 ~
 444+ 6F17 ~                ; --- Determinar player_current_comp via LastEntrySide ---
 445+ 6F17 ~                LD A, (LastEntrySide)
 446+ 6F17 ~                CP $FF
 447+ 6F17 ~                JR NZ, .cmcpHaveEntry
 448+ 6F17 ~                XOR A                                ; fallback: comp 0
