2035+ F1D4              ; ==============================================================================
2036+ F1D4              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
2037+ F1D4              ; ==============================================================================
2038+ F1D4              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
2039+ F1D4              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
2040+ F1D4              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
2041+ F1D4              ;   2. Leer charX/charY de la entry
2042+ F1D4              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
2043+ F1D4              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
2044+ F1D4              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
2045+ F1D4              ;   6. ChurchDoorOpen = 0
2046+ F1D4              ; ==============================================================================
2047+ F1D4              CloseChurchDoor:
2048+ F1D4                  ; SFX del cierre (mismo crujido que el SFX_ChurchDoorOpen, sirve para
2049+ F1D4                  ; ambos sentidos). Suena ANTES del cambio visual.
2050+ F1D4 21 0A FA         LD HL, SFX_ChurchDoorOpen
2051+ F1D7 CD 18 F9         CALL PlaySFX
2052+ F1DA 11 AD E2         LD DE, BgGfx_old_church_door_open
2053+ F1DD CD 67 F2         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
2054+ F1E0 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
2055+ F1E2                  ; Leer charX (HL+4) y charY (HL+5) en BC
2056+ F1E2 E5               PUSH HL                                 ; save mapX ptr
2057+ F1E3 01 04 00         LD BC, 4
2058+ F1E6 09               ADD HL, BC
2059+ F1E7 46               LD B, (HL)                              ; B = charX
2060+ F1E8 23               INC HL
2061+ F1E9 4E               LD C, (HL)                              ; C = charY
2062+ F1EA E1               POP HL                                  ; HL = mapX ptr
2063+ F1EB                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
2064+ F1EB E5               PUSH HL
2065+ F1EC C5               PUSH BC
2066+ F1ED 21 AD E2         LD HL, BgGfx_old_church_door_open
2067+ F1F0 3E 03            LD A, 3
2068+ F1F2 CD 0A 91         CALL LoadBgSpriteToBuffer               ; preserva BC
2069+ F1F5 C1               POP BC
2070+ F1F6 C5               PUSH BC
2071+ F1F7 DD 21 42 89      LD IX, BgSpriteBuffer
2072+ F1FB CD 62 D6         CALL DrawBgSpriteXOR                    ; borra
2073+ F1FE C1               POP BC
2074+ F1FF E1               POP HL
2075+ F200                  ; --- Patch ptr: open -> closed ---
2076+ F200 23               INC HL
2076+ F201 23             INC HL                         ; -> ptr_lo
2077+ F202 3E F4            LD A, LOW BgGfx_old_church_door_closed
2078+ F204 77               LD (HL), A
2079+ F205 23               INC HL
2080+ F206 3E E1            LD A, HIGH BgGfx_old_church_door_closed
2081+ F208 77               LD (HL), A
2082+ F209                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
2083+ F209 C5               PUSH BC
2084+ F20A 21 F4 E1         LD HL, BgGfx_old_church_door_closed
2085+ F20D 3E 03            LD A, 3
2086+ F20F CD 0A 91         CALL LoadBgSpriteToBuffer
2087+ F212 C1               POP BC
2088+ F213 C5               PUSH BC
2089+ F214 DD 21 42 89      LD IX, BgSpriteBuffer
2090+ F218 CD 62 D6         CALL DrawBgSpriteXOR
2091+ F21B C1               POP BC
2092+ F21C DD 21 42 89      LD IX, BgSpriteBuffer
2093+ F220 AF               XOR A
2094+ F221 32 07 DD         LD (BgSpriteIsHouse), A
2095+ F224 CD A7 D6         CALL DrawBgAttrOnly
2096+ F227              .ccdFlag:
2097+ F227 AF               XOR A
2098+ F228 32 2A 82         LD (ChurchDoorOpen), A
2099+ F22B C9               RET
