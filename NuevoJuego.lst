 101  6A0D
 102  6A0D                  ; --- Rutinas de paginacion (paging.asm) ---
 103  6A0D                  ; Movido a slot 1 (siempre visible) en vez de bank 2 para defender el
 104  6A0D                  ; presupuesto de bank 2 — bank 2 esta al 100% lleno y derramando a bank 0
 105  6A0D                  ; slot 3. paging.asm tiene que vivir en memoria siempre visible porque
 106  6A0D                  ; sus rutinas (LoadBgSpriteToBuffer, etc.) hacen el OUT de page switch:
 107  6A0D                  ; si vivieran en slot 3, la siguiente instruccion tras el OUT seria de
 108  6A0D                  ; otro bank → crash. Antes vivia en bank 2; ahora en slot 1, mismo
 109  6A0D                  ; criterio (siempre visible) pero contended.
 110  6A0D                  ; Coste runtime: ~5-10% mas lento durante zona activa de pantalla.
 111  6A0D                  ; Las rutinas se llaman en transiciones de sala / sprite loads, no en
 112  6A0D                  ; el inner loop, asi que el overhead es invisible.
 113  6A0D                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 6A0D              ; ==============================================================================
   2+ 6A0D              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 6A0D              ; ==============================================================================
   4+ 6A0D              ; Port $7FFD (write-only):
   5+ 6A0D              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 6A0D              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 6A0D              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 6A0D              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 6A0D              ;
  10+ 6A0D              ; Bancos disponibles:
  11+ 6A0D              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 6A0D              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 6A0D              ;   Bank 1: libre para datos nuevos (contended)
  14+ 6A0D              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 6A0D              ;   Bank 3: libre para datos nuevos (contended)
  16+ 6A0D              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 6A0D              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 6A0D              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 6A0D              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 6A0D              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 6A0D              ; ==============================================================================
  22+ 6A0D
  23+ 6A0D              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 6A0D              ; para no machacarse a si mismas al cambiar de banco.
  25+ 6A0D
  26+ 6A0D              ; ==============================================================================
  27+ 6A0D              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 6A0D              ; ==============================================================================
  29+ 6A0D              ; Entrada: A = banco (0-7)
  30+ 6A0D              ; Preserva: HL, DE, IX, IY
  31+ 6A0D              ; Destruye: A, BC
  32+ 6A0D              ; ==============================================================================
  33+ 6A0D              PageBankSlot3:
  34+ 6A0D E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 6A0F 47               LD B, A                     ; guardar banco nuevo
  36+ 6A10 3A D4 90         LD A, (CurrentPaging)
  37+ 6A13 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 6A15 B0               OR B                        ; poner nuevo banco
  39+ 6A16 32 D4 90         LD (CurrentPaging), A
  40+ 6A19 01 FD 7F         LD BC, $7FFD
  41+ 6A1C ED 79            OUT (C), A
  42+ 6A1E C9               RET
  43+ 6A1F
  44+ 6A1F              ; ==============================================================================
  45+ 6A1F              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 6A1F              ; ==============================================================================
  47+ 6A1F              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 6A1F              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 6A1F              ; ==============================================================================
  50+ 6A1F              InitPaging:
  51+ 6A1F 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 6A21 32 D4 90         LD (CurrentPaging), A
  53+ 6A24 01 FD 7F         LD BC, $7FFD
  54+ 6A27 ED 79            OUT (C), A
  55+ 6A29 C9               RET
  56+ 6A2A
  57+ 6A2A              ; ==============================================================================
  58+ 6A2A              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 6A2A              ; ==============================================================================
  60+ 6A2A              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 6A2A              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 6A2A              ;      Paginacion restaurada a bank 0.
  63+ 6A2A              ; Destruye: A, BC, DE, HL
  64+ 6A2A              ;
  65+ 6A2A              ; Formato del room en FUENTE (variable-length):
  66+ 6A2A              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 6A2A              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 6A2A              ;   terminador:                  DEFB $FF
  69+ 6A2A              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 6A2A              ;
  71+ 6A2A              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 6A2A              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 6A2A              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 6A2A              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 6A2A              ; ==============================================================================
  76+ 6A2A              LoadRoomToBuffer:
  77+ 6A2A                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 6A2A                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 6A2A                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 6A2A                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 6A2A                  ;
  82+ 6A2A                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 6A2A                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 6A2A                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 6A2A                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 6A2A F3               DI
  87+ 6A2B                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 6A2B 3A D4 90         LD A, (CurrentPaging)
  89+ 6A2E E6 F8            AND $F8
  90+ 6A30 F6 01            OR 1
  91+ 6A32 32 D4 90         LD (CurrentPaging), A
  92+ 6A35 01 FD 7F         LD BC, $7FFD
  93+ 6A38 ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 6A3A                  ; --- Copy + decompress loop ---
  95+ 6A3A                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 6A3A                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 6A3A 11 87 85         LD DE, CurrentScreenBuffer
  98+ 6A3D              .lrbLoop:
  99+ 6A3D 7E               LD A, (HL)                      ; id
 100+ 6A3E 12               LD (DE), A
 101+ 6A3F 23               INC HL
 102+ 6A40 13               INC DE
 103+ 6A41 FE FF            CP $FF                          ; terminador?
 104+ 6A43 28 1B            JR Z, .lrbDone
 105+ 6A45                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 6A45                  ; al buffer escribimos x limpio (AND $7F).
 107+ 6A45 7E               LD A, (HL)
 108+ 6A46 23               INC HL
 109+ 6A47 47               LD B, A                         ; B = x raw (con flag)
 110+ 6A48 E6 7F            AND $7F
 111+ 6A4A 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 6A4B 13               INC DE
 113+ 6A4C                  ; Copiar y
 114+ 6A4C 7E               LD A, (HL)
 115+ 6A4D 12               LD (DE), A
 116+ 6A4E 23               INC HL
 117+ 6A4F 13               INC DE
 118+ 6A50                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 6A50 CB 78            BIT 7, B
 120+ 6A52 28 06            JR Z, .lrbNoTint
 121+ 6A54 7E               LD A, (HL)                      ; v desde source
 122+ 6A55 23               INC HL
 123+ 6A56 12               LD (DE), A
 124+ 6A57 13               INC DE
 125+ 6A58 18 E3            JR .lrbLoop
 126+ 6A5A              .lrbNoTint:
 127+ 6A5A 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 6A5C 12               LD (DE), A
 129+ 6A5D 13               INC DE
 130+ 6A5E 18 DD            JR .lrbLoop
 131+ 6A60              .lrbDone:
 132+ 6A60                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 6A60 3A D4 90         LD A, (CurrentPaging)
 134+ 6A63 E6 F8            AND $F8                         ; bank 0
 135+ 6A65 32 D4 90         LD (CurrentPaging), A
 136+ 6A68 01 FD 7F         LD BC, $7FFD
 137+ 6A6B ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
