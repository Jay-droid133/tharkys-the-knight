# file closed: monster_ai.asm
 494  9860                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 495  9860                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 496  9860                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9860              ; ==============================================================================
   2+ 9860              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9860              ; ==============================================================================
   4+ 9860              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9860              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9860              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9860              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9860              ;
   9+ 9860              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9860              ; fallo en el intento previo):
  11+ 9860              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9860              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9860              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9860              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9860              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9860              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9860              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9860              ;
  19+ 9860              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9860              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9860              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9860              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9860              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9860              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9860              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9860              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9860              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9860              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9860              ; ==============================================================================
  30+ 9860
  31+ 9860              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9860              AY_Init:
  33+ 9860 F3               DI
  34+ 9861 3A 8A 8D         LD A, (CurrentPaging)
  35+ 9864 E6 F8            AND $F8
  36+ 9866 F6 04            OR 4
  37+ 9868 32 8A 8D         LD (CurrentPaging), A
  38+ 986B 01 FD 7F         LD BC, $7FFD
  39+ 986E ED 79            OUT (C), A
  40+ 9870 CD 7A E7         CALL AY_InitImpl
  41+ 9873 3A 8A 8D         LD A, (CurrentPaging)
  42+ 9876 E6 F8            AND $F8
  43+ 9878 32 8A 8D         LD (CurrentPaging), A
  44+ 987B 01 FD 7F         LD BC, $7FFD
  45+ 987E ED 79            OUT (C), A
  46+ 9880 3A A2 81         LD A, (StartupComplete)
  47+ 9883 B7               OR A
  48+ 9884 C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9885 FB               EI
  50+ 9886 C9               RET
