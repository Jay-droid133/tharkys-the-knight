 296+ 7277 77               LD (HL), A
 297+ 7278 21 07 60         LD HL, MagicCompassBfsHead
 298+ 727B 34               INC (HL)                             ; head=1, tail=0 → 1 entry
 299+ 727C
 300+ 727C                  ; visited[target] = 1
 301+ 727C 3A E4 73         LD A, (.cmcpTgtSid)
 302+ 727F CD A8 73         CALL .cmcpMarkVisited
 303+ 7282
 304+ 7282                  ; --- BFS loop ---
 305+ 7282              .cmcpLoop:
 306+ 7282                  ; queue empty?
 307+ 7282 3A 07 60         LD A, (MagicCompassBfsHead)
 308+ 7285 47               LD B, A
 309+ 7286 3A 08 60         LD A, (MagicCompassBfsTail)
 310+ 7289 B8               CP B
 311+ 728A CA 24 73         JP Z, .cmcpNoPath                    ; head == tail → vacía
 312+ 728D
 313+ 728D                  ; Pop: R = queue[tail]; tail = (tail+1) mod 64
 314+ 728D 5F               LD E, A
 315+ 728E 16 00            LD D, 0
 316+ 7290 21 C7 5F         LD HL, MagicCompassBfsQueue
 317+ 7293 19               ADD HL, DE
 318+ 7294 7E               LD A, (HL)                           ; A = R sid
 319+ 7295 32 E5 73         LD (.cmcpR), A
 320+ 7298 7B               LD A, E
 321+ 7299 3C               INC A
