 216+ 67A4              ; DrawSmokeFrameXor - XOR-dibuja un frame de humo en la posicion de la estatua
 217+ 67A4              ; ==============================================================================
 218+ 67A4              ; IN: A = frame idx (0..2)
 219+ 67A4              ; XOR-draw es reversible: la primera llamada con un frame lo dibuja, la
 220+ 67A4              ; segunda lo borra. Usado por la fase SMOKE de UpdateChurchCutscene.
 221+ 67A4              ; Posicion: ChurchCutsceneStatueOrigX/Y (top-left de la estatua original).
 222+ 67A4              ; Destruye: AF, BC, DE, HL, IX.
 223+ 67A4              ; ==============================================================================
 224+ 67A4              DrawSmokeFrameXor:
 225+ 67A4 87               ADD A, A                                ; *2 (entries de 2 bytes)
 226+ 67A5 6F               LD L, A
 227+ 67A6 26 00            LD H, 0
 228+ 67A8 11 9E 67         LD DE, SmokeFramePtrTable
 229+ 67AB 19               ADD HL, DE
 230+ 67AC 5E               LD E, (HL)
 231+ 67AD 23               INC HL
 232+ 67AE 56               LD D, (HL)                              ; DE = ptr al frame data (header+pixel)
 233+ 67AF                  ; Copiar 34 bytes (header 2 + pixel 32) a BgSpriteBuffer.
 234+ 67AF                  ; Source y destino accesibles sin paging (milestones bank 0,
 235+ 67AF                  ; BgSpriteBuffer en RAM principal).
 236+ 67AF EB               EX DE, HL                               ; HL = source
 237+ 67B0 11 7C 89         LD DE, BgSpriteBuffer
 238+ 67B3 01 22 00         LD BC, 34
 239+ 67B6 ED B0            LDIR
 240+ 67B8                  ; Pixel pos = (StatueOrigX, StatueOrigY) — top-left de la estatua original
 241+ 67B8 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
 242+ 67BB 57               LD D, A
 243+ 67BC 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
 244+ 67BF 5F               LD E, A
 245+ 67C0 C3 B6 68         JP DrawBgSprite16XorAtPixel
