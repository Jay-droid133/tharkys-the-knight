7117+ C6C3 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
7118+ C6C7                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
7119+ C6C7 AF               XOR A
7120+ C6C8 32 03 83         LD (DeathSubPixelAcc), A
