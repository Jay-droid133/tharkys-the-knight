# file opened: code/ay_sound_thunks.asm
   1+ 9B58              ; ==============================================================================
   2+ 9B58              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9B58              ; ==============================================================================
   4+ 9B58              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9B58              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9B58              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9B58              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9B58              ;
   9+ 9B58              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9B58              ; fallo en el intento previo):
  11+ 9B58              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9B58              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9B58              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9B58              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9B58              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9B58              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9B58              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9B58              ;
  19+ 9B58              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9B58              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9B58              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9B58              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9B58              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9B58              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9B58              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9B58              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9B58              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9B58              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9B58              ; ==============================================================================
  30+ 9B58
  31+ 9B58              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9B58              AY_Init:
  33+ 9B58 F3               DI
  34+ 9B59 3A 82 90         LD A, (CurrentPaging)
  35+ 9B5C E6 F8            AND $F8
  36+ 9B5E F6 04            OR 4
  37+ 9B60 32 82 90         LD (CurrentPaging), A
  38+ 9B63 01 FD 7F         LD BC, $7FFD
  39+ 9B66 ED 79            OUT (C), A
  40+ 9B68 CD BF E4         CALL AY_InitImpl
  41+ 9B6B 3A 82 90         LD A, (CurrentPaging)
  42+ 9B6E E6 F8            AND $F8
