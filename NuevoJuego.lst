 749+ F419 24               INC H
 750+ F41A 10 F9            DJNZ .ccRow1
 751+ F41C AF               XOR A                               ; attr 0 (negro/negro, invisible)
 752+ F41D 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 753+ F420 77               LD (HL), A
 754+ F421 23               INC HL
 755+ F422 77               LD (HL), A
 756+ F423 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 757+ F426 77               LD (HL), A
 758+ F427 23               INC HL
 759+ F428 77               LD (HL), A
 760+ F429 C9               RET
 761+ F42A
 762+ F42A              ; ==============================================================================
 763+ F42A              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 764+ F42A              ; ==============================================================================
 765+ F42A              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 766+ F42A              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 767+ F42A              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 768+ F42A              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 769+ F42A              ; monstruo cae alli con la puerta abierta:
 770+ F42A              ;   - Bit slot en MonsterTrappedFlags
 771+ F42A              ;   - Despawn del monstruo (puff)
 772+ F42A              ;   - Puerta se re-cierra (sprite + flag)
 773+ F42A              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 774+ F42A              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 775+ F42A              ;
 776+ F42A              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 777+ F42A              ; auto-generadas por el level editor segun la posicion de la puerta y los
 778+ F42A              ; markers AltKey1/AltKey2.
 779+ F42A              ; ==============================================================================
 780+ F42A
 781+ F42A              ; ==============================================================================
 782+ F42A              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 783+ F42A              ; ==============================================================================
 784+ F42A              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 785+ F42A              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 786+ F42A              ; Destruye: AF, BC.
 787+ F42A              ; ==============================================================================
 788+ F42A              CheckChurchTrap:
 789+ F42A                  ; --- Solo en pantalla de la iglesia ---
 790+ F42A 3A AE 82         LD A, (CurrentScreenX)
 791+ F42D FE 0F            CP CHURCH_TRAP_SCREEN_X
 792+ F42F 20 5D            JR NZ, .cctNoTrap
 793+ F431 3A AF 82         LD A, (CurrentScreenY)
 794+ F434 FE 06            CP CHURCH_TRAP_SCREEN_Y
 795+ F436 20 56            JR NZ, .cctNoTrap
 796+ F438                  ; --- Solo con la puerta abierta ---
 797+ F438 3A 61 82         LD A, (ChurchDoorOpen)
 798+ F43B B7               OR A
 799+ F43C 28 50            JR Z, .cctNoTrap
 800+ F43E                  ; --- Solo si el knockback es DIRECTO del player ---
 801+ F43E                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 802+ F43E                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 803+ F43E                  ; espada y se clear cuando se hereda kb por colision.
 804+ F43E DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 805+ F442 28 4A            JR Z, .cctNoTrap
 806+ F444                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 807+ F444                  ; (acepta sprites de 16, 21 o 24 px de alto)
 808+ F444 DD 7E 04         LD A, (IX+ENT_POSY)
 809+ F447 CB 3F            SRL A
 810+ F449 CB 3F            SRL A
 811+ F44B CB 3F            SRL A                                   ; A = top charY del monster
 812+ F44D 47               LD B, A
 813+ F44E 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 814+ F450 90               SUB B                                   ; A = trap_charY - mon_charY
 815+ F451 FE 03            CP 3
 816+ F453 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 817+ F455                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 818+ F455 DD 7E 03         LD A, (IX+ENT_POSX)
 819+ F458 CB 3F            SRL A
 820+ F45A CB 3F            SRL A
 821+ F45C CB 3F            SRL A
 822+ F45E 47               LD B, A                                 ; B = left charX del monster
 823+ F45F 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 824+ F461 3C               INC A                                   ; A = LO_X + 1
 825+ F462 90               SUB B                                   ; A = LO_X+1 - charX
 826+ F463 FE 03            CP 3
 827+ F465 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 828+ F467                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 829+ F467                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 830+ F467 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 831+ F46A D6 4C            SUB SPRID_MONSTER_0
 832+ F46C CB 3F            SRL A
 833+ F46E CB 3F            SRL A
 834+ F470 CB 3F            SRL A                                   ; A = type idx 0..2
 835+ F472 47               LD B, A
 836+ F473                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 837+ F473 3A 6F 82         LD A, (NextChurchTrapStep)
 838+ F476 FE 03            CP 3
 839+ F478 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 840+ F47A 21 90 F4         LD HL, ChurchTrapOrderTable
 841+ F47D 5F               LD E, A
 842+ F47E 16 00            LD D, 0
 843+ F480 19               ADD HL, DE
 844+ F481 7E               LD A, (HL)                              ; A = type esperado
 845+ F482 B8               CP B
 846+ F483 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 847+ F485                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 848+ F485 CD 28 F5         CALL TriggerChurchTrap
 849+ F488 3E 01            LD A, 1
 850+ F48A C9               RET
 851+ F48B              .cctBlockAsWall:
 852+ F48B                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 853+ F48B                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 854+ F48B 3E 02            LD A, 2
 855+ F48D C9               RET
 856+ F48E              .cctNoTrap:
 857+ F48E AF               XOR A
 858+ F48F C9               RET
 859+ F490
 860+ F490              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 861+ F490              ChurchTrapOrderTable:
 862+ F490 00 02 01         DEFB 0, 2, 1
 863+ F493
 864+ F493              ; ==============================================================================
 865+ F493              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 866+ F493              ; blanco brillante sobre paper negro ($47).
 867+ F493              ; ==============================================================================
 868+ F493              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 869+ F493              ; - No-op fuera de la sala de la iglesia.
 870+ F493              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 871+ F493              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 872+ F493              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 873+ F493              ;   aun no toca) conservan sus attrs originales del sprite.
 874+ F493              ; Destruye: AF, BC, DE, HL.
 875+ F493              ; ==============================================================================
 876+ F493              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 877+ F493              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 878+ F493              HighlightExpectedStatue:
 879+ F493 3E 47            LD A, $47
 880+ F495 18 00            JR PaintExpectedStatueAttr
 881+ F497
 882+ F497              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 883+ F497              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 884+ F497              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 885+ F497              PaintExpectedStatueAttr:
 886+ F497 32 01 F5         LD (.hesAttr), A
 887+ F49A                  ; --- Solo en la sala de la iglesia ---
 888+ F49A 3A AE 82         LD A, (CurrentScreenX)
 889+ F49D FE 0F            CP CHURCH_TRAP_SCREEN_X
 890+ F49F C0               RET NZ
 891+ F4A0 3A AF 82         LD A, (CurrentScreenY)
 892+ F4A3 FE 06            CP CHURCH_TRAP_SCREEN_Y
 893+ F4A5 C0               RET NZ
 894+ F4A6                  ; --- Solo tras abrir la iglesia 1a vez ---
 895+ F4A6                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 896+ F4A6                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 897+ F4A6                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 898+ F4A6                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 899+ F4A6                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 900+ F4A6 3A 62 82         LD A, (ChurchEverOpened)
 901+ F4A9 B7               OR A
 902+ F4AA C8               RET Z
 903+ F4AB                  ; --- Solo si quedan monstruos por atrapar ---
 904+ F4AB 3A 6F 82         LD A, (NextChurchTrapStep)
 905+ F4AE FE 03            CP 3
 906+ F4B0 D0               RET NC
 907+ F4B1                  ; --- Type esperado -> statue id ---
 908+ F4B1 21 90 F4         LD HL, ChurchTrapOrderTable
 909+ F4B4 5F               LD E, A
 910+ F4B5 16 00            LD D, 0
 911+ F4B7 19               ADD HL, DE
 912+ F4B8 7E               LD A, (HL)                              ; type idx esperado
 913+ F4B9 21 7C 67         LD HL, StatueIdTable
 914+ F4BC 5F               LD E, A
 915+ F4BD 16 00            LD D, 0
 916+ F4BF 19               ADD HL, DE
 917+ F4C0 7E               LD A, (HL)                              ; A = statue id
 918+ F4C1 B7               OR A
 919+ F4C2 C8               RET Z
 920+ F4C3 32 02 F5         LD (.hesTargetId), A
 921+ F4C6                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 922+ F4C6 2A B0 82         LD HL, (CurrentScreenAddr)
 923+ F4C9              .hesLoop:
 924+ F4C9 7E               LD A, (HL)
 925+ F4CA FE FF            CP $FF
 926+ F4CC C8               RET Z                                   ; estatua no en esta sala
 927+ F4CD 47               LD B, A
 928+ F4CE 3A 02 F5         LD A, (.hesTargetId)
 929+ F4D1 B8               CP B
 930+ F4D2 28 06            JR Z, .hesFound
 931+ F4D4 11 04 00         LD DE, 4
 932+ F4D7 19               ADD HL, DE
 933+ F4D8 18 EF            JR .hesLoop
 934+ F4DA              .hesFound:
 935+ F4DA 23               INC HL
 936+ F4DB 7E               LD A, (HL)                              ; charX
 937+ F4DC 47               LD B, A
 938+ F4DD 23               INC HL
 939+ F4DE 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 940+ F4DF C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 941+ F4E1 4F               LD C, A                                 ; C = charY (post-HUD)
 942+ F4E2                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 943+ F4E2 26 00            LD H, 0
 944+ F4E4 69               LD L, C
 945+ F4E5 29               ADD HL, HL
 946+ F4E6 29               ADD HL, HL
 947+ F4E7 29               ADD HL, HL
 948+ F4E8 29               ADD HL, HL
 949+ F4E9 29               ADD HL, HL                              ; HL = charY * 32
 950+ F4EA 58               LD E, B
 951+ F4EB 16 00            LD D, 0
 952+ F4ED 19               ADD HL, DE                              ; + charX
 953+ F4EE 11 00 58         LD DE, $5800
 954+ F4F1 19               ADD HL, DE                              ; HL = attr addr top-left
 955+ F4F2                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 956+ F4F2                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 957+ F4F2                  ; no hace falta sincronizar CleanAttrMap.
 958+ F4F2 3A 01 F5         LD A, (.hesAttr)
 959+ F4F5 06 03            LD B, 3                                 ; 3 filas de chars
 960+ F4F7              .hesRow:
 961+ F4F7 77               LD (HL), A
 962+ F4F8 23               INC HL
 963+ F4F9 77               LD (HL), A                              ; (charX+1)
 964+ F4FA 11 1F 00         LD DE, 31
 965+ F4FD 19               ADD HL, DE                              ; siguiente fila col 0
 966+ F4FE 10 F7            DJNZ .hesRow
 967+ F500 C9               RET
 968+ F501 00           .hesAttr:     DEFB 0
 969+ F502 00           .hesTargetId: DEFB 0
 970+ F503
 971+ F503              ; ==============================================================================
 972+ F503              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 973+ F503              ; ==============================================================================
 974+ F503              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 975+ F503              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 976+ F503              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 977+ F503              ; + ON final settle): 8 ciclos de ON-OFF en total.
 978+ F503              ; ==============================================================================
 979+ F503              STATUE_BLINK_FRAMES   EQU 32
 980+ F503
 981+ F503              StartStatueBlink:
 982+ F503                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 983+ F503                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 984+ F503                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 985+ F503                  ; (caso A), .cbtActChurchDoor (caso B).
 986+ F503 3E 20            LD A, STATUE_BLINK_FRAMES
 987+ F505 32 70 82         LD (StatueBlinkCounter), A
 988+ F508 C3 93 F4         JP HighlightExpectedStatue              ; initial ON paint
 989+ F50B
 990+ F50B              UpdateStatueBlink:
 991+ F50B                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 992+ F50B 3A 70 82         LD A, (StatueBlinkCounter)
 993+ F50E B7               OR A
 994+ F50F C8               RET Z
 995+ F510 3D               DEC A
 996+ F511 32 70 82         LD (StatueBlinkCounter), A
 997+ F514 20 03            JR NZ, .usbInProgress
 998+ F516                  ; Counter recien llego a 0: settle ON
 999+ F516 C3 93 F4         JP HighlightExpectedStatue
1000+ F519              .usbInProgress:
1001+ F519                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1002+ F519                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1003+ F519 CB 3F            SRL A
1004+ F51B E6 01            AND $01
1005+ F51D 28 05            JR Z, .usbOff
1006+ F51F 3E 47            LD A, $47
1007+ F521 C3 97 F4         JP PaintExpectedStatueAttr
1008+ F524              .usbOff:
1009+ F524 AF               XOR A
1010+ F525 C3 97 F4         JP PaintExpectedStatueAttr
1011+ F528
1012+ F528              ; ==============================================================================
1013+ F528              ; CUTSCENE - parametros ajustables
1014+ F528              ; ==============================================================================
1015+ F528              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1016+ F528              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1017+ F528              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1018+ F528              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1019+ F528
1020+ F528              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1021+ F528              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1022+ F528              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1023+ F528
1024+ F528              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1025+ F528              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1026+ F528              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1027+ F528              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1028+ F528              ;   tick 12 -> erase smoke[2], pasar a DONE
1029+ F528              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1030+ F528              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1031+ F528
1032+ F528              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1033+ F528              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1034+ F528              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1035+ F528              ; centrado dentro del vano de la puerta.
1036+ F528              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1037+ F528              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1038+ F528              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1039+ F528              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1040+ F528
1041+ F528              ; ==============================================================================
1042+ F528              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1043+ F528              ; ==============================================================================
1044+ F528              ; IN: IX = monster atrapado.
1045+ F528              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1046+ F528              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1047+ F528              ; en ApplyChurchTrapEffects al final del cutscene.
1048+ F528              ; ==============================================================================
1049+ F528              TriggerChurchTrap:
1050+ F528                  ; --- 1. Calcular slot 0..2 ---
1051+ F528 DD E5            PUSH IX
1052+ F52A E1               POP HL
1053+ F52B 11 5B 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1054+ F52E B7               OR A
1055+ F52F ED 52            SBC HL, DE
1056+ F531 CB 3D            SRL L
1057+ F533 CB 3D            SRL L
1058+ F535 CB 3D            SRL L
1059+ F537 CB 3D            SRL L                                   ; L = slot 0..2
1060+ F539 7D               LD A, L
1061+ F53A 32 9E 5F         LD (ChurchCutsceneSlot), A
1062+ F53D                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1063+ F53D DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1064+ F540 D6 4C            SUB SPRID_MONSTER_0
1065+ F542 CB 3F            SRL A
1066+ F544 CB 3F            SRL A
1067+ F546 CB 3F            SRL A                                   ; A = type idx
1068+ F548 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1069+ F54B                  ; --- 2. Mover monster al centro del vano ---
1070+ F54B 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1071+ F54D DD 77 03         LD (IX+ENT_POSX), A
1072+ F550 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1073+ F552 DD 77 04         LD (IX+ENT_POSY), A
1074+ F555 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1075+ F559 DD 36 07 00      LD (IX+ENT_DELTAY), 0
1076+ F55D DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1077+ F561                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1078+ F561                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1079+ F561                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1080+ F561                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1081+ F561                  ; temblor se vea con ink blanco brillante sobre paper negro.
1082+ F561 AF               XOR A
1083+ F562 32 70 82         LD (StatueBlinkCounter), A              ; parar blink
1084+ F565 DD E5            PUSH IX
