 281+ EEFA              ; ==============================================================================
 282+ EEFA              ; KeyIdToPtr - Convierte key id (1..6) en ptr al BgGfx via KeyLockTable
 283+ EEFA              ; ==============================================================================
 284+ EEFA              ; IN:  A = key id (1..6)
 285+ EEFA              ; OUT: DE = ptr
