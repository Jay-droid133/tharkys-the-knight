 147  720C                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 148  720C                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 149  720C                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 150  720C                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 151  720C                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 720C              ; ==============================================================================
   2+ 720C              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 720C              ; ==============================================================================
   4+ 720C              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 720C              ; Mientras MagicCompassTimer>0:
   6+ 720C              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 720C              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 720C              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 720C              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 720C              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 720C              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 720C              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 720C              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 720C              ;
  15+ 720C              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 720C              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 720C              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 720C              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 720C              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 720C              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 720C              ;
  22+ 720C              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 720C              ; ==============================================================================
  24+ 720C
  25+ 720C              ; ==============================================================================
  26+ 720C              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 720C              ; ==============================================================================
  28+ 720C              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 720C              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 720C              ; Destruye: AF, HL.
  31+ 720C              ; ==============================================================================
  32+ 720C              ApplyMagicCompassBuff:
  33+ 720C 21 EE 02         LD HL, MAGIC_COMPASS_FRAMES
  34+ 720F 22 C9 5F         LD (MagicCompassTimer), HL
  35+ 7212 3E 01            LD A, 1
  36+ 7214 32 CC 5F         LD (MagicCompassPathDirty), A       ; recalcular path en próximo update
  37+ 7217 AF               XOR A
  38+ 7218 32 CD 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  39+ 721B 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  40+ 721D 32 CE 5F         LD (MagicCompassTickCounter), A
  41+ 7220                  ; Arrancar jingle: idx=0, frames=1 → primera nota se dispara YA en update
  42+ 7220 AF               XOR A
  43+ 7221 32 CF 5F         LD (MagicCompassJingleIdx), A
  44+ 7224 3E 01            LD A, 1
  45+ 7226 32 D0 5F         LD (MagicCompassJingleFrames), A
  46+ 7229 C9               RET
  47+ 722A
  48+ 722A              ; ==============================================================================
  49+ 722A              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  50+ 722A              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  51+ 722A              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  52+ 722A              ; ==============================================================================
  53+ 722A              ; Entry points:
  54+ 722A              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  55+ 722A              ;                           muerte / hito cumplido / llegar a sala destino,
  56+ 722A              ;                           sites que no saben si la brujula estaba activa.
  57+ 722A              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  58+ 722A              ;                           por el branch del timeout natural (Timer ya es 0
  59+ 722A              ;                           tras el DEC, asi que el check daria RET Z falso
  60+ 722A              ;                           positivo y se saltaria el cleanup).
  61+ 722A              ; ==============================================================================
  62+ 722A              CancelMagicCompass:
  63+ 722A 3A C9 5F         LD A, (MagicCompassTimer)
  64+ 722D 47               LD B, A
  65+ 722E 3A CA 5F         LD A, (MagicCompassTimer + 1)
  66+ 7231 B0               OR B
  67+ 7232 C8               RET Z                                ; ya inactivo
  68+ 7233                  ; fall through al cleanup compartido
  69+ 7233              _DoCancelMagicCompass:
  70+ 7233 AF               XOR A
  71+ 7234 32 C9 5F         LD (MagicCompassTimer), A
  72+ 7237 32 CA 5F         LD (MagicCompassTimer + 1), A
  73+ 723A 32 CE 5F         LD (MagicCompassTickCounter), A
  74+ 723D 32 CD 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  75+ 7240 32 D6 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  76+ 7243 3E FF            LD A, $FF
  77+ 7245 32 CB 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  78+ 7248 32 D5 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  79+ 724B 32 CF 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  80+ 724E 32 6A 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
  81+ 7251                                                       ; frame: DrawCompass detecta $FF y
  82+ 7251                                                       ; entra a .dcRedraw, sustituyendo el
  83+ 7251                                                       ; sprite_compass_magic stale por la
  84+ 7251                                                       ; brujula clasica (8 flechas + X).
  85+ 7251 C9               RET
  86+ 7252
  87+ 7252              ; ==============================================================================
  88+ 7252              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
  89+ 7252              ; ==============================================================================
  90+ 7252              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
  91+ 7252              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
  92+ 7252              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
  93+ 7252              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
  94+ 7252              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
  95+ 7252              ; direccion vieja (de la sala anterior).
  96+ 7252              ;
  97+ 7252              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
  98+ 7252              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
  99+ 7252              ; solo en transiciones — nunca en frames de gameplay normal.
 100+ 7252              ;
 101+ 7252              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 102+ 7252              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 103+ 7252              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 104+ 7252              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 105+ 7252              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 106+ 7252              ;
 107+ 7252              ; Destruye: AF, BC, DE, HL.
 108+ 7252              ; ==============================================================================
 109+ 7252              ForceComputeMagicCompassPath:
 110+ 7252 AF               XOR A
 111+ 7253 32 D6 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 112+ 7256              .fcmcpLoop:
 113+ 7256 CD 71 73         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 114+ 7259                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 115+ 7259 3A D6 5F         LD A, (MagicCompassBfsState)
 116+ 725C B7               OR A
 117+ 725D 20 F7            JR NZ, .fcmcpLoop                    ; aun en progreso → otro chunk
 118+ 725F AF               XOR A
 119+ 7260 32 CC 5F         LD (MagicCompassPathDirty), A        ; ya recalculado, no necesita rerun
 120+ 7263                  ; Forzar tick INMEDIATO en la nueva sala: TickCounter=0 hace que
 121+ 7263                  ; UpdateMagicCompass dispare .umcTickFire en el siguiente frame, sin
 122+ 7263                  ; esperar a que el contador llegue a 0 de forma natural (que podia
 123+ 7263                  ; tardar hasta 50 frames = 1 segundo). El player ve flash + suena AY
 124+ 7263                  ; al instante de cruzar, con la flecha correcta.
 125+ 7263                  ; TickActiveFrames=0 mata cualquier flash residual del tick que estaba
 126+ 7263                  ; en curso en la sala anterior — evita 1-2 frames de bright apuntando
 127+ 7263                  ; a la dir vieja entre el cruce y el nuevo tick.
 128+ 7263 32 CE 5F         LD (MagicCompassTickCounter), A
 129+ 7266 32 CD 5F         LD (MagicCompassTickActiveFrames), A
 130+ 7269 C9               RET
