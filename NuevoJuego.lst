1253+ F4CD              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1254+ F4CD              .ucsLookPhase:
1255+ F4CD                  ; Frame counter (para detectar fin de fase)
1256+ F4CD 21 9D 5F         LD HL, ChurchCutsceneFrame
1257+ F4D0 34               INC (HL)
1258+ F4D1                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1259+ F4D1 21 A4 5F         LD HL, ChurchCutsceneLookCount
1260+ F4D4 35               DEC (HL)
1261+ F4D5 20 06            JR NZ, .ucsLookCheckEnd
1262+ F4D7 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1263+ F4D9 77               LD (HL), A
1264+ F4DA CD 96 F5         CALL ChurchCutsceneToggleMonsterDir
1265+ F4DD              .ucsLookCheckEnd:
