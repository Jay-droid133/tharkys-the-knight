 183+ D2BB              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 184+ D2BB              DrawSwordModeHUD:
 185+ D2BB 3A 5C B2         LD A, (SwordMode)
 186+ D2BE 21 EE D2         LD HL, .modeChars
 187+ D2C1 5F               LD E, A
 188+ D2C2 16 00            LD D, 0
 189+ D2C4 19               ADD HL, DE
 190+ D2C5 7E               LD A, (HL)                          ; A = ASCII del modo
 191+ D2C6                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 192+ D2C6 21 00 40         LD HL, $4000
 193+ D2C9                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 194+ D2C9 5F               LD E, A
 195+ D2CA 16 00            LD D, 0
 196+ D2CC 42               LD B, D                             ; B = 0
 197+ D2CD CB 23            SLA E
 197+ D2CF CB 12          RL D                        ; *2
 198+ D2D1 CB 23            SLA E
 198+ D2D3 CB 12          RL D                        ; *4
 199+ D2D5 CB 23            SLA E
 199+ D2D7 CB 12          RL D                        ; *8
 200+ D2D9 E5               PUSH HL
 201+ D2DA 21 00 3C         LD HL, $3C00
 202+ D2DD 19               ADD HL, DE                          ; HL = direccion del glyph
 203+ D2DE EB               EX DE, HL                           ; DE = glyph
 204+ D2DF E1               POP HL                              ; HL = VRAM
 205+ D2E0 06 08            LD B, 8
 206+ D2E2              .drawChar:
 207+ D2E2 1A               LD A, (DE)
 208+ D2E3 77               LD (HL), A
 209+ D2E4 13               INC DE
 210+ D2E5 24               INC H                               ; siguiente scan line
 211+ D2E6 10 FA            DJNZ .drawChar
 212+ D2E8                  ; Attr: fila 0, col 0 = $5800
 213+ D2E8 3E 47            LD A, $47                           ; blanco bright
 214+ D2EA 32 00 58         LD ($5800), A
 215+ D2ED C9               RET
 216+ D2EE
 217+ D2EE 43 46 53     .modeChars: DEFB "CFS"                 ; modo 0=C cooldown, 1=F fijo, 2=S stamina
 218+ D2F1
 219+ D2F1              ; --- DrawNoclipHUD: "NC" en fila 1 cols 30-31 cuando NoclipMode activo ---
 220+ D2F1              DrawNoclipHUD:
 221+ D2F1 3A C2 81         LD A, (NoclipMode)
 222+ D2F4 B7               OR A
 223+ D2F5 20 0E            JR NZ, .ncOn
 224+ D2F7 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 225+ D2F9 1E 1E            LD E, 30
 226+ D2FB CD EA D4         CALL DrawHudChar
 227+ D2FE 3E 20            LD A, 32
 228+ D300 1E 1F            LD E, 31
 229+ D302 C3 EA D4         JP DrawHudChar
 230+ D305              .ncOn:
 231+ D305 3E 4E            LD A, 'N'
 232+ D307 1E 1E            LD E, 30
 233+ D309 CD EA D4         CALL DrawHudChar
 234+ D30C 3E 43            LD A, 'C'
 235+ D30E 1E 1F            LD E, 31
 236+ D310 C3 EA D4         JP DrawHudChar
