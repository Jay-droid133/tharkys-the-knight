 232  C984                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
   1+ C984              ; ==============================================================================
   2+ C984              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ C984              ; ==============================================================================
   4+ C984              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ C984              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ C984              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ C984              ; ==============================================================================
   8+ C984
   9+ C984              ; ==============================================================================
  10+ C984              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ C984              ; ==============================================================================
  12+ C984              InitScreenSystem:
  13+ C984 3E 07            LD A, START_SCREEN_X
  14+ C986 32 08 82         LD (CurrentScreenX), A
  15+ C989 3E 0F            LD A, START_SCREEN_Y
  16+ C98B 32 09 82         LD (CurrentScreenY), A
  17+ C98E 3E 01            LD A, 1
  18+ C990 32 10 82         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ C993 AF               XOR A
  20+ C994 32 0C 82         LD (ScreenTransition), A
  21+ C997 CD 9B C9         CALL CalcScreenAddress
  22+ C99A C9               RET
  23+ C99B
  24+ C99B              ; ==============================================================================
  25+ C99B              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ C99B              ; ==============================================================================
  27+ C99B              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ C99B              ; ==============================================================================
  29+ C99B              CalcScreenAddress:
  30+ C99B 3A 09 82         LD A, (CurrentScreenY)
  31+ C99E 6F               LD L, A
  32+ C99F 26 00            LD H, 0
  33+ C9A1 29               ADD HL, HL                  ; x2
  34+ C9A2 29               ADD HL, HL                  ; x4
  35+ C9A3 29               ADD HL, HL                  ; x8
  36+ C9A4 29               ADD HL, HL                  ; x16
  37+ C9A5 3A 08 82         LD A, (CurrentScreenX)
  38+ C9A8 5F               LD E, A
  39+ C9A9 16 00            LD D, 0
  40+ C9AB 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ C9AC 11 D1 D8         LD DE, MapTable
  42+ C9AF 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ C9B0 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ C9B1                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ C9B1 6F               LD L, A
  46+ C9B2 26 00            LD H, 0
  47+ C9B4 29               ADD HL, HL                  ; index * 2
  48+ C9B5 11 9F D7         LD DE, RoomTable
  49+ C9B8 19               ADD HL, DE
  50+ C9B9 5E               LD E, (HL)
  51+ C9BA 23               INC HL
  52+ C9BB 56               LD D, (HL)                  ; DE = puntero a Room_Txx (en bank 1)
  53+ C9BC                  ; Copiar room data desde bank 1 al buffer en RAM fija
  54+ C9BC EB               EX DE, HL                   ; HL = Room_Txx ptr
  55+ C9BD CD 73 90         CALL LoadRoomToBuffer       ; pagina bank 1, copia, repagina bank 0
  56+ C9C0                  ; CurrentScreenAddr apunta al buffer, no al original en bank 1
  57+ C9C0 11 F5 84         LD DE, CurrentScreenBuffer
  58+ C9C3 ED 53 0A 82      LD (CurrentScreenAddr), DE
  59+ C9C7 C9               RET
  60+ C9C8
  61+ C9C8              ; ==============================================================================
  62+ C9C8              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  63+ C9C8              ; ==============================================================================
  64+ C9C8              ; Cada direccion solo se comprueba si el player esta ACTIVAMENTE pulsando
  65+ C9C8              ; esa direccion en el input. Asi nunca se dispara una transicion no intencionada
  66+ C9C8              ; por estar atrapado cerca del borde.
  67+ C9C8              ; ==============================================================================
  68+ C9C8              CheckScreenTransition:
  69+ C9C8 AF               XOR A
  70+ C9C9 32 0C 82         LD (ScreenTransition), A
  71+ C9CC
  72+ C9CC                  ; Cutscene final (M9): el player queda totalmente confinado mientras
  73+ C9CC                  ; TownGatePhase != 0. La fase 12 (slide-out) hace POSY >= SCREEN_MAX_Y
  74+ C9CC                  ; intencionadamente; sin este guard una S residual en InputDirection
  75+ C9CC                  ; dispararia transicion sur en plena animacion.
  76+ C9CC 3A EF 81         LD A, (TownGatePhase)
  77+ C9CF B7               OR A
  78+ C9D0 C0               RET NZ
  79+ C9D1
  80+ C9D1                  ; Mientras el reloj esta congelado (fase de captura en la iglesia), el
  81+ C9D1                  ; jugador queda confinado a la sala. Los monstruos NO pasan por aqui:
  82+ C9D1                  ; ellos usan MonsterRoomId + la AI para moverse entre salas, asi que
  83+ C9D1                  ; pueden entrar/salir libremente de la iglesia mientras el jugador no.
  84+ C9D1                  ; Si el jugador intenta salir por el sur (unica salida real), tocar
  85+ C9D1                  ; SFX_BlockedExit con debounce para que no parezca un bug.
  86+ C9D1 3A DF 81         LD A, (TimeFrozen)
  87+ C9D4 B7               OR A
  88+ C9D5 28 23            JR Z, .cstNotFrozen
  89+ C9D7 3A D7 81         LD A, (InputDirection)
  90+ C9DA CB 4F            BIT 1, A                    ; S
  91+ C9DC 28 17            JR Z, .cstClearBlockFlag
  92+ C9DE 3A CB 80         LD A, (EntityTable + ENT_POSY)
  93+ C9E1 FE A8            CP SCREEN_MAX_Y
  94+ C9E3 38 10            JR C, .cstClearBlockFlag    ; no en borde sur
  95+ C9E5                  ; Pulsando S y en borde sur: tocar SFX una vez por intento.
  96+ C9E5 3A E0 81         LD A, (BlockedExitSoundFlag)
  97+ C9E8 B7               OR A
  98+ C9E9 C0               RET NZ                      ; ya sonó, esperar release o move
  99+ C9EA 3E 01            LD A, 1
 100+ C9EC 32 E0 81         LD (BlockedExitSoundFlag), A
 101+ C9EF 21 08 F2         LD HL, SFX_BlockedExit
 102+ C9F2 C3 09 F1         JP PlaySFX                  ; tail call
 103+ C9F5              .cstClearBlockFlag:
 104+ C9F5 AF               XOR A
 105+ C9F6 32 E0 81         LD (BlockedExitSoundFlag), A
 106+ C9F9 C9               RET
 107+ C9FA              .cstNotFrozen:
 108+ C9FA                  ; Asegurar que el flag queda limpio cuando el reloj reanuda.
 109+ C9FA AF               XOR A
 110+ C9FB 32 E0 81         LD (BlockedExitSoundFlag), A
