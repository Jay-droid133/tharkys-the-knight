 577+ C3B9
 578+ C3B9                  ; Aplicar offset HUD: desplazar sprites BG 2 filas hacia abajo
 579+ C3B9 79               LD A, C
 580+ C3BA C6 02            ADD A, BG_Y_OFFSET
 581+ C3BC 4F               LD C, A
 582+ C3BD
 583+ C3BD                  ; Guardar posicion para la fase de atributos
 584+ C3BD 78               LD A, B
 585+ C3BE 32 AB C4         LD (.xChar), A
 586+ C3C1 79               LD A, C
 587+ C3C2 32 AC C4         LD (.yChar), A
