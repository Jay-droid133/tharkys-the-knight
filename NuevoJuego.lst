 617+ 6B9F              ; ==============================================================================
 618+ 6B9F              ; CloseChurchDoor - cierra la puerta: erase OPEN + draw CLOSED in-place
 619+ 6B9F              ; ==============================================================================
 620+ 6B9F              ; Estamos por definicion en la pantalla de la iglesia (la trampa solo dispara
 621+ 6B9F              ; aqui), asi que el redraw quirurgico siempre es valido. Pasos:
 622+ 6B9F              ;   1. FindPickupEntryByPtr(BgGfx_old_church_door_open) -> HL = mapX byte
 623+ 6B9F              ;   2. Leer charX/charY de la entry
 624+ 6B9F              ;   3. Cargar OPEN al BgSpriteBuffer + DrawBgSpriteXOR -> borra pixels open
 625+ 6B9F              ;   4. Patch ptr de la entry a BgGfx_old_church_door_closed
 626+ 6B9F              ;   5. Cargar CLOSED + DrawBgSpriteXOR + DrawBgAttrOnly -> dibuja closed
 627+ 6B9F              ;   6. ChurchDoorOpen = 0
 628+ 6B9F              ; ==============================================================================
 629+ 6B9F              CloseChurchDoor:
 630+ 6B9F                  ; SFX "chof" del cierre — distinto del creak (SFX_ChurchDoorOpen) que
 631+ 6B9F                  ; usa la misma puerta al ABRIR. ABRIR = creak (madera girando con esfuerzo);
 632+ 6B9F                  ; CERRAR = chof (impacto contra el marco). SFX_DoorClose compartido con la
 633+ 6B9F                  ; cinematica del banco (HAND_OUT + HAND_OPEN_IN). Suena ANTES del cambio visual.
 634+ 6B9F 21 B1 F9         LD HL, SFX_DoorClose
 635+ 6BA2 CD 8D F8         CALL PlaySFX
 636+ 6BA5 11 2C DF         LD DE, BgGfx_old_church_door_open
 637+ 6BA8 CD 32 6C         CALL FindPickupEntryByPtr               ; HL = mapX byte si Z
 638+ 6BAB 20 45            JR NZ, .ccdFlag                         ; entry no encontrada -> solo flag
 639+ 6BAD                  ; Leer charX (HL+4) y charY (HL+5) en BC
 640+ 6BAD E5               PUSH HL                                 ; save mapX ptr
 641+ 6BAE 01 04 00         LD BC, 4
 642+ 6BB1 09               ADD HL, BC
 643+ 6BB2 46               LD B, (HL)                              ; B = charX
 644+ 6BB3 23               INC HL
 645+ 6BB4 4E               LD C, (HL)                              ; C = charY
 646+ 6BB5 E1               POP HL                                  ; HL = mapX ptr
 647+ 6BB6                  ; --- Erase OPEN sprite: cargar al buffer + XOR redraw ---
 648+ 6BB6 E5               PUSH HL
 649+ 6BB7 C5               PUSH BC
 650+ 6BB8 21 2C DF         LD HL, BgGfx_old_church_door_open
 651+ 6BBB 3E 03            LD A, 3
 652+ 6BBD CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
 653+ 6BC0 C1               POP BC
 654+ 6BC1 C5               PUSH BC
 655+ 6BC2 DD 21 F8 86      LD IX, BgSpriteBuffer
 656+ 6BC6 CD E0 DB         CALL DrawBgSpriteXOR                    ; borra
 657+ 6BC9 C1               POP BC
 658+ 6BCA E1               POP HL
 659+ 6BCB                  ; --- Patch ptr: open -> closed ---
 660+ 6BCB 23               INC HL
 660+ 6BCC 23             INC HL                         ; -> ptr_lo
 661+ 6BCD 3E 73            LD A, LOW BgGfx_old_church_door_closed
 662+ 6BCF 77               LD (HL), A
 663+ 6BD0 23               INC HL
 664+ 6BD1 3E DE            LD A, HIGH BgGfx_old_church_door_closed
 665+ 6BD3 77               LD (HL), A
 666+ 6BD4                  ; --- Draw CLOSED: cargar + XOR redraw + attrs ---
 667+ 6BD4 C5               PUSH BC
 668+ 6BD5 21 73 DE         LD HL, BgGfx_old_church_door_closed
 669+ 6BD8 3E 03            LD A, 3
 670+ 6BDA CD C2 6C         CALL LoadBgSpriteToBuffer
 671+ 6BDD C1               POP BC
 672+ 6BDE C5               PUSH BC
 673+ 6BDF DD 21 F8 86      LD IX, BgSpriteBuffer
 674+ 6BE3 CD E0 DB         CALL DrawBgSpriteXOR
 675+ 6BE6 C1               POP BC
 676+ 6BE7 DD 21 F8 86      LD IX, BgSpriteBuffer
 677+ 6BEB AF               XOR A
 678+ 6BEC 32 D8 E2         LD (BgSpriteIsHouse), A
 679+ 6BEF CD 25 DC         CALL DrawBgAttrOnly
 680+ 6BF2              .ccdFlag:
 681+ 6BF2 AF               XOR A
 682+ 6BF3 32 B4 82         LD (ChurchDoorOpen), A
 683+ 6BF6 C9               RET
 684+ 6BF7
 685+ 6BF7              ; ==============================================================================
 686+ 6BF7              ; RespawnChurchKeyAtAlt - patch PickupTable entry de church_key con coords AltN
 687+ 6BF7              ; ==============================================================================
 688+ 6BF7              ; Lee ChurchKeyAltSpawnIdx (1 o 2) y patchea con CHURCH_KEY_ALT[1|2]_* coords.
 689+ 6BF7              ; ==============================================================================
 690+ 6BF7              RespawnChurchKeyAtAlt:
 691+ 6BF7 3A C4 82         LD A, (ChurchKeyAltSpawnIdx)
 692+ 6BFA FE 01            CP 1
 693+ 6BFC 28 05            JR Z, .rcaAlt1
 694+ 6BFE FE 02            CP 2
 695+ 6C00 28 0B            JR Z, .rcaAlt2
 696+ 6C02 C9               RET                                     ; estado raro, no hacer nada
 697+ 6C03              .rcaAlt1:
 698+ 6C03 06 0F            LD B, CHURCH_KEY_ALT1_SCREEN_X
 699+ 6C05 0E 06            LD C, CHURCH_KEY_ALT1_SCREEN_Y
 700+ 6C07 16 1A            LD D, CHURCH_KEY_ALT1_CHAR_X
 701+ 6C09 3E 03            LD A, CHURCH_KEY_ALT1_CHAR_Y
 702+ 6C0B 18 08            JR .rcaPatch
 703+ 6C0D              .rcaAlt2:
 704+ 6C0D 06 0F            LD B, CHURCH_KEY_ALT2_SCREEN_X
 705+ 6C0F 0E 06            LD C, CHURCH_KEY_ALT2_SCREEN_Y
 706+ 6C11 16 04            LD D, CHURCH_KEY_ALT2_CHAR_X
 707+ 6C13 3E 03            LD A, CHURCH_KEY_ALT2_CHAR_Y
 708+ 6C15              .rcaPatch:
 709+ 6C15 32 31 6C         LD (.rcaCharY), A
 710+ 6C18 C5               PUSH BC                                 ; preservar B=mapX, C=mapY
 711+ 6C19 D5               PUSH DE                                 ; preservar D=charX
 712+ 6C1A 11 F3 D7         LD DE, BgGfx_church_key
 713+ 6C1D CD 32 6C         CALL FindPickupEntryByPtr               ; HL = mapX byte
 714+ 6C20 D1               POP DE
 715+ 6C21 C1               POP BC
 716+ 6C22 20 0C            JR NZ, .rcaSkip
 717+ 6C24 70               LD (HL), B                              ; mapX = AltN_SCREEN_X
 718+ 6C25 23               INC HL
 719+ 6C26 71               LD (HL), C                              ; mapY = AltN_SCREEN_Y
 720+ 6C27 23               INC HL
 720+ 6C28 23             INC HL
 720+ 6C29 23             INC HL                ; skip ptr_lo, ptr_hi
 721+ 6C2A 72               LD (HL), D                              ; charX = AltN_CHAR_X
 722+ 6C2B 23               INC HL
 723+ 6C2C 3A 31 6C         LD A, (.rcaCharY)
 724+ 6C2F 77               LD (HL), A                              ; charY = AltN_CHAR_Y
 725+ 6C30              .rcaSkip:
 726+ 6C30 C9               RET
 727+ 6C31 00           .rcaCharY: DEFB 0
 728+ 6C32
 729+ 6C32              ; ==============================================================================
 730+ 6C32              ; FindPickupEntryByPtr - busca entry en PickupTable por sprite ptr
 731+ 6C32              ; ==============================================================================
 732+ 6C32              ; Recorre TODAS las entries (active = mapX != $FE, inactive = mapX == $FE),
 733+ 6C32              ; comparando ptr_lo/ptr_hi con DE.
 734+ 6C32              ; IN:  DE = ptr buscado.
 735+ 6C32              ; OUT: HL = puntero al byte mapX de la entry. Z si encontrado, NZ si no.
 736+ 6C32              ; Destruye: AF.
 737+ 6C32              ; ==============================================================================
 738+ 6C32              FindPickupEntryByPtr:
 739+ 6C32 21 26 DF         LD HL, PickupTable
 740+ 6C35              .fpeLoop:
 741+ 6C35 7E               LD A, (HL)
 742+ 6C36 FE FF            CP $FF
 743+ 6C38 28 18            JR Z, .fpeNotFound
 744+ 6C3A E5               PUSH HL
 745+ 6C3B 23               INC HL
 745+ 6C3C 23             INC HL                         ; -> ptr_lo
 746+ 6C3D 7E               LD A, (HL)
 747+ 6C3E BB               CP E
 748+ 6C3F 20 08            JR NZ, .fpeNoMatch
 749+ 6C41 23               INC HL
 750+ 6C42 7E               LD A, (HL)
 751+ 6C43 BA               CP D
 752+ 6C44 20 03            JR NZ, .fpeNoMatch
 753+ 6C46 E1               POP HL
 754+ 6C47 AF               XOR A                                   ; Z = encontrado
 755+ 6C48 C9               RET
 756+ 6C49              .fpeNoMatch:
 757+ 6C49 E1               POP HL
 758+ 6C4A C5               PUSH BC
 759+ 6C4B 01 07 00         LD BC, 7
 760+ 6C4E 09               ADD HL, BC
 761+ 6C4F C1               POP BC
 762+ 6C50 18 E3            JR .fpeLoop
 763+ 6C52              .fpeNotFound:
 764+ 6C52 F6 01            OR 1                                    ; NZ
 765+ 6C54 C9               RET
 766+ 6C55
