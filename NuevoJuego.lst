  52+ 9884              ; --- AY_UpdateBell: cada frame ---
  53+ 9884              ; SP alterno (slot 1) durante el page switch para no enmascarar IRQs. DI corto
  54+ 9884              ; SOLO alrededor del Impl (que hace varios OUTs AY que deben ser atomicos
  55+ 9884              ; respecto al handler IRQ que tambien escribe AY). Ver project_paging_alt_stack.
  56+ 9884              AY_UpdateBell:
  57+ 9884 ED 73 B1 98      LD (.aubSavedSP), SP
  58+ 9888 31 D6 68         LD SP, PagingAltStackTop
  59+ 988B 3A 87 8D         LD A, (CurrentPaging)
  60+ 988E E6 F8            AND $F8
  61+ 9890 F6 04            OR 4
  62+ 9892 32 87 8D         LD (CurrentPaging), A
  63+ 9895 01 FD 7F         LD BC, $7FFD
  64+ 9898 ED 79            OUT (C), A                      ; slot 3 = bank 4 (sin DI; SP alterno)
  65+ 989A F3               DI                              ; cierra ventana antes de los OUTs AY del Impl
  66+ 989B CD 81 E5         CALL AY_UpdateBellImpl
  67+ 989E FB               EI
  68+ 989F 3A 87 8D         LD A, (CurrentPaging)
  69+ 98A2 E6 F8            AND $F8
  70+ 98A4 32 87 8D         LD (CurrentPaging), A
  71+ 98A7 01 FD 7F         LD BC, $7FFD
  72+ 98AA ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98AC ED 7B B1 98      LD SP, (.aubSavedSP)
  74+ 98B0 C9               RET
  75+ 98B1 00 00        .aubSavedSP: DEFW 0
  76+ 98B3
  77+ 98B3              ; --- UpdateMusic: cada frame (driver tabular generico, content-agnostic) ---
