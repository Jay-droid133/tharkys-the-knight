4818+ BC4B                  ; Si signos coinciden con la ultima nasty spawneada, voltear DELTAY.
4819+ BC4B                  ; Sin esto, R cercanos en frames consecutivos producen direcciones
4820+ BC4B                  ; identicas y las nasties van en paralelo solapadas.
4821+ BC4B DD 7E 06         LD A, (IX+ENT_DELTAX)
4822+ BC4E E6 80            AND $80                             ; bit 7 = signo X
4823+ BC50 47               LD B, A
4824+ BC51 DD 7E 07         LD A, (IX+ENT_DELTAY)
4825+ BC54 E6 80            AND $80                             ; bit 7 = signo Y
4826+ BC56 0F               RRCA                                ; mover a bit 6 para diferenciarlo de B
4827+ BC57 B0               OR B                                ; A = signX(7) | signY(6)
4828+ BC58 47               LD B, A
4829+ BC59 3A F6 82         LD A, (LastSpawnDirSigns)
4830+ BC5C B8               CP B
