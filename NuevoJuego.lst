 642+ E876              ; ==============================================================================
 643+ E876              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 644+ E876              ; ==============================================================================
 645+ E876              ; Llamar cada frame desde el main loop.
 646+ E876              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 647+ E876              ; ==============================================================================
 648+ E876              DrawPlazaClock:
 649+ E876 3A 34 90         LD A, (PlazaClockActive)
 650+ E879 B7               OR A
 651+ E87A C8               RET Z
 652+ E87B
 653+ E87B                  ; --- Calcular posicion actual de las agujas ---
 654+ E87B 3A DD E3         LD A, (GameHours)
 655+ E87E FE 0C            CP 12
 656+ E880 38 02            JR C, .pCalcHourOk
 657+ E882 D6 0C            SUB 12
 658+ E884              .pCalcHourOk:
 659+ E884 57               LD D, A                     ; D = display hour (0-11)
 660+ E885 3A DC E3         LD A, (GameMinutes)
 661+ E888 1E 00            LD E, 0
 662+ E88A              .pCalcDiv5:
 663+ E88A FE 05            CP 5
 664+ E88C 38 05            JR C, .pCalcMinOk
 665+ E88E D6 05            SUB 5
 666+ E890 1C               INC E
 667+ E891 18 F7            JR .pCalcDiv5
 668+ E893              .pCalcMinOk:
 669+ E893                  ; D = hour pos (0-11), E = minute pos (0-11)
 670+ E893
 671+ E893                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 672+ E893 3A E7 E8         LD A, (PlazaLastHour)
 673+ E896 BA               CP D
 674+ E897 20 05            JR NZ, .pNeedsRedraw
 675+ E899 3A E8 E8         LD A, (PlazaLastMin)
 676+ E89C BB               CP E
 677+ E89D C8               RET Z                       ; sin cambio → no redibujar
 678+ E89E
 679+ E89E              .pNeedsRedraw:
 680+ E89E 7A               LD A, D
 681+ E89F 32 E7 E8         LD (PlazaLastHour), A
 682+ E8A2 7B               LD A, E
 683+ E8A3 32 E8 E8         LD (PlazaLastMin), A
 684+ E8A6
 685+ E8A6                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 686+ E8A6                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 687+ E8A6 DD 21 0A 8D      LD IX, PlazaClockPixels
 688+ E8AA FD 21 37 90      LD IY, PlazaScanAddrs
 689+ E8AE 06 10            LD B, 16
 690+ E8B0              .faceRow:
 691+ E8B0 FD 6E 00         LD L, (IY+0)
 692+ E8B3 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 693+ E8B6 DD 7E 00         LD A, (IX+0)
 694+ E8B9 2F               CPL                         ; des-invertir (dato CPL'd)
 695+ E8BA 77               LD (HL), A                  ; byte izquierdo
 696+ E8BB 23               INC HL
 697+ E8BC DD 7E 01         LD A, (IX+1)
 698+ E8BF 2F               CPL
 699+ E8C0 77               LD (HL), A                  ; byte derecho
 700+ E8C1 DD 23            INC IX
 701+ E8C3 DD 23            INC IX
 702+ E8C5 FD 23            INC IY
 703+ E8C7 FD 23            INC IY
 704+ E8C9 10 E5            DJNZ .faceRow
 705+ E8CB
 706+ E8CB                  ; --- Aguja de horas ---
 707+ E8CB 3A E7 E8         LD A, (PlazaLastHour)
 708+ E8CE 21 D9 E4         LD HL, HourHandPtrs
 709+ E8D1 CD E9 E8         CALL DrawPlazaHandLine
 710+ E8D4
 711+ E8D4                  ; --- Aguja de minutos ---
 712+ E8D4 3A E8 E8         LD A, (PlazaLastMin)
 713+ E8D7 21 F5 E3         LD HL, MinHandPtrs
 714+ E8DA CD E9 E8         CALL DrawPlazaHandLine
 715+ E8DD
 716+ E8DD                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 717+ E8DD 21 45 90         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 718+ E8E0 7E               LD A, (HL)
 719+ E8E1 23               INC HL
 720+ E8E2 66               LD H, (HL)
 721+ E8E3 6F               LD L, A                     ; HL = dir VRAM scan line 7
 722+ E8E4 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 723+ E8E6 C9               RET
 724+ E8E7
 725+ E8E7              ; Variables locales reloj plaza
 726+ E8E7 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 727+ E8E8 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 728+ E8E9
 729+ E8E9              ; ==============================================================================
 730+ E8E9              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 731+ E8E9              ; ==============================================================================
 732+ E8E9              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 733+ E8E9              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 734+ E8E9              ; a posiciones relativas y las busca en PlazaScanAddrs.
 735+ E8E9              ; ==============================================================================
 736+ E8E9              DrawPlazaHandLine:
 737+ E8E9                  ; Indexar en tabla de punteros
 738+ E8E9 87               ADD A, A
 739+ E8EA 4F               LD C, A
 740+ E8EB 06 00            LD B, 0
 741+ E8ED 09               ADD HL, BC
 742+ E8EE 7E               LD A, (HL)
 743+ E8EF 23               INC HL
 744+ E8F0 66               LD H, (HL)
 745+ E8F1 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 746+ E8F2
 747+ E8F2              .pxLoop:
 748+ E8F2 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 749+ E8F3 B7               OR A
 750+ E8F4 C8               RET Z
 751+ E8F5
 752+ E8F5                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 753+ E8F5 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 754+ E8F6 23               INC HL
 755+ E8F7 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 756+ E8F8 23               INC HL
 757+ E8F9 56               LD D, (HL)                  ; D = mask
 758+ E8FA 23               INC HL
 759+ E8FB E5               PUSH HL                     ; guardar puntero a siguiente entrada
 760+ E8FC
 761+ E8FC                  ; --- Calcular scanLine (0-15) ---
 762+ E8FC 78               LD A, B
 763+ E8FD E6 07            AND $07                     ; scan dentro del char row (0-7)
 764+ E8FF CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 765+ E901 28 02            JR Z, .pxIsTop
 766+ E903 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 767+ E905              .pxIsTop:
 768+ E905                  ; A = scanLine (0-15)
 769+ E905
 770+ E905                  ; --- Calcular colOffset (0 o 1) ---
 771+ E905 5F               LD E, A                     ; E = scanLine (guardar)
 772+ E906 79               LD A, C
 773+ E907 E6 1F            AND $1F                     ; extraer columna
 774+ E909 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 775+ E90B 4F               LD C, A                     ; C = colOffset
 776+ E90C
 777+ E90C                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 778+ E90C 7B               LD A, E                     ; A = scanLine
 779+ E90D 87               ADD A, A                    ; *2 (word index)
 780+ E90E 21 37 90         LD HL, PlazaScanAddrs
 781+ E911 85               ADD A, L
 782+ E912 6F               LD L, A
 783+ E913 30 01            JR NC, .pxNC
 784+ E915 24               INC H
 785+ E916              .pxNC:
 786+ E916 7E               LD A, (HL)
 787+ E917 23               INC HL
 788+ E918 66               LD H, (HL)
 789+ E919 81               ADD A, C                    ; sumar colOffset
 790+ E91A 6F               LD L, A                     ; HL = dir VRAM destino
 791+ E91B
 792+ E91B                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 793+ E91B 7A               LD A, D
 794+ E91C 2F               CPL
 795+ E91D A6               AND (HL)
 796+ E91E 77               LD (HL), A
 797+ E91F
 798+ E91F E1               POP HL                      ; restaurar puntero datos
 799+ E920 18 D0            JR .pxLoop
