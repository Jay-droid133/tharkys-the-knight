5450+ BD0A DD 21 B3 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5451+ BD0E 06 06            LD B, NUM_MONSTERS
5452+ BD10              .kamLoop:
5453+ BD10 C5               PUSH BC
5454+ BD11 DD 7E 01         LD A, (IX+ENT_TYPE)
