6660+ C86D              ; ==============================================================================
6661+ C86D              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6662+ C86D              ; ==============================================================================
6663+ C86D              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6664+ C86D              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6665+ C86D              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6666+ C86D              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6667+ C86D              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6668+ C86D              ; main.asm; aqui no hace falta guard adicional).
6669+ C86D              ; ==============================================================================
6670+ C86D
6671+ C86D              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6672+ C86D              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6673+ C86D              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6674+ C86D              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6675+ C86D              ;
6676+ C86D              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6677+ C86D              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6678+ C86D              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6679+ C86D              ;
6680+ C86D              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6681+ C86D              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6682+ C86D              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6683+ C86D              ; en vez de 8 + orientacion invertida).
6684+ C86D              UpdateDeath:
6685+ C86D                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6686+ C86D                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6687+ C86D                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6688+ C86D                  ; progreso real, no solo quedar inmovil. ---
6689+ C86D 2A 86 82         LD HL, (DeathGhostStuckTimer)
6690+ C870 23               INC HL
6691+ C871 22 86 82         LD (DeathGhostStuckTimer), HL
6692+ C874 7C               LD A, H
6693+ C875 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6694+ C877 38 0C            JR C, .udGhostCheckDone
6695+ C879 20 05            JR NZ, .udGhostOn
6696+ C87B 7D               LD A, L
6697+ C87C FE 7D            CP (DEATH_GHOST_FRAMES) & $FF
6698+ C87E 38 05            JR C, .udGhostCheckDone
6699+ C880              .udGhostOn:
6700+ C880 3E 01            LD A, 1
6701+ C882 32 88 82         LD (DeathGhostMode), A
6702+ C885              .udGhostCheckDone:
6703+ C885
6704+ C885                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6705+ C885 3A 88 82         LD A, (DeathGhostMode)
6706+ C888 B7               OR A
6707+ C889 C2 D0 C8         JP NZ, DeathGhostChase
6708+ C88C
6709+ C88C                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6710+ C88C DD 7E 03         LD A, (IX+ENT_POSX)
6711+ C88F 32 83 82         LD (DeathPrevX), A
6712+ C892 DD 7E 04         LD A, (IX+ENT_POSY)
6713+ C895 32 84 82         LD (DeathPrevY), A
6714+ C898                  ; Sub-pixel acc 1/2
6715+ C898 3A 82 82         LD A, (DeathSubPixelAcc)
6716+ C89B EE 01            XOR 1
6717+ C89D 32 82 82         LD (DeathSubPixelAcc), A
6718+ C8A0 28 05            JR Z, .udSkip
6719+ C8A2 CD 74 B1         CALL UpdateMonster                  ; activo: chase + move + animate
6720+ C8A5 18 03            JR .udPost
6721+ C8A7              .udSkip:
6722+ C8A7 CD 35 C9         CALL DeathAnimate                   ; skip: solo animacion
6723+ C8AA              .udPost:
6724+ C8AA                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6725+ C8AA 3A 83 82         LD A, (DeathPrevX)
6726+ C8AD DD BE 03         CP (IX+ENT_POSX)
6727+ C8B0 20 19            JR NZ, .udMoved
6728+ C8B2 3A 84 82         LD A, (DeathPrevY)
6729+ C8B5 DD BE 04         CP (IX+ENT_POSY)
6730+ C8B8 20 11            JR NZ, .udMoved
6731+ C8BA                  ; No movio: incrementar BFS counter
6732+ C8BA 3A 85 82         LD A, (DeathStuckCounter)
6733+ C8BD 3C               INC A
6734+ C8BE 32 85 82         LD (DeathStuckCounter), A
6735+ C8C1 FE 06            CP DEATH_STUCK_THRESHOLD
6736+ C8C3 D8               RET C
6737+ C8C4 AF               XOR A
6738+ C8C5 32 85 82         LD (DeathStuckCounter), A
6739+ C8C8 C3 B2 CA         JP DeathBfsRescue
6740+ C8CB              .udMoved:
6741+ C8CB AF               XOR A
6742+ C8CC 32 85 82         LD (DeathStuckCounter), A
6743+ C8CF C9               RET
6744+ C8D0
6745+ C8D0              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6746+ C8D0              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6747+ C8D0              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6748+ C8D0              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6749+ C8D0              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6750+ C8D0              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6751+ C8D0              DeathGhostChase:
6752+ C8D0                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6753+ C8D0 3A 39 81         LD A, (EntityTable + ENT_POSX)
6754+ C8D3 DD 96 03         SUB (IX+ENT_POSX)
6755+ C8D6 30 02            JR NC, .udgAbsDxOk
6756+ C8D8 ED 44            NEG
6757+ C8DA              .udgAbsDxOk:
6758+ C8DA 47               LD B, A                             ; B = |dx|
6759+ C8DB 3A 3A 81         LD A, (EntityTable + ENT_POSY)
6760+ C8DE DD 96 04         SUB (IX+ENT_POSY)
6761+ C8E1 30 02            JR NC, .udgAbsDyOk
6762+ C8E3 ED 44            NEG
6763+ C8E5              .udgAbsDyOk:
6764+ C8E5                  ; A = |dy|, B = |dx|
6765+ C8E5 B8               CP B
6766+ C8E6 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6767+ C8E8
6768+ C8E8                  ; --- Eje X primario ---
6769+ C8E8 AF               XOR A
6770+ C8E9 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6771+ C8EC 3A 39 81         LD A, (EntityTable + ENT_POSX)
6772+ C8EF DD 96 03         SUB (IX+ENT_POSX)
6773+ C8F2 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6774+ C8F4 3E 04            LD A, DEATH_GHOST_SPEED
6775+ C8F6 30 02            JR NC, .udgXSet
6776+ C8F8 3E FC            LD A, -DEATH_GHOST_SPEED
6777+ C8FA              .udgXSet:
6778+ C8FA DD 77 06         LD (IX+ENT_DELTAX), A
6779+ C8FD DD 86 03         ADD A, (IX+ENT_POSX)
6780+ C900 DD 77 03         LD (IX+ENT_POSX), A
6781+ C903 18 1B            JR .udgAnim
6782+ C905
6783+ C905                  ; --- Eje Y primario ---
6784+ C905              .udgVertPrim:
6785+ C905 AF               XOR A
6786+ C906 DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6787+ C909 3A 3A 81         LD A, (EntityTable + ENT_POSY)
6788+ C90C DD 96 04         SUB (IX+ENT_POSY)
6789+ C90F 28 0F            JR Z, .udgAnim
6790+ C911 3E 04            LD A, DEATH_GHOST_SPEED
6791+ C913 30 02            JR NC, .udgYSet
6792+ C915 3E FC            LD A, -DEATH_GHOST_SPEED
6793+ C917              .udgYSet:
6794+ C917 DD 77 07         LD (IX+ENT_DELTAY), A
6795+ C91A DD 86 04         ADD A, (IX+ENT_POSY)
6796+ C91D DD 77 04         LD (IX+ENT_POSY), A
6797+ C920              .udgAnim:
6798+ C920                  ; Check de salida: si el bbox de Death no overlapea con wall (free space),
6799+ C920                  ; exit ghost mode + reset timers para que AI normal reanude. Si aun en wall,
6800+ C920                  ; persistir ghost (next frame seguira moviendo).
6801+ C920 CD 44 BA         CALL CheckEnemyCollision            ; Z = free, NZ = blocked
6802+ C923 20 0D            JR NZ, .udgInWall
6803+ C925 AF               XOR A
6804+ C926 32 88 82         LD (DeathGhostMode), A
6805+ C929 32 85 82         LD (DeathStuckCounter), A
6806+ C92C 21 00 00         LD HL, 0
6807+ C92F 22 86 82         LD (DeathGhostStuckTimer), HL
6808+ C932              .udgInWall:
6809+ C932 C3 35 C9         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6810+ C935
6811+ C935              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6812+ C935              ; Llamada por:
6813+ C935              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6814+ C935              ;   - UpdateDeath en frame skip (sin movimiento).
6815+ C935              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6816+ C935              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6817+ C935              DeathAnimate:
6818+ C935 DD 7E 06         LD A, (IX+ENT_DELTAX)
6819+ C938 B7               OR A
6820+ C939 28 0A            JR Z, .daKeepDir
6821+ C93B 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6822+ C93D CB 7F            BIT 7, A
6823+ C93F 28 0D            JR Z, .daDir
6824+ C941 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6825+ C943 18 09            JR .daDir
6826+ C945              .daKeepDir:
6827+ C945 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6828+ C948 DD 96 08         SUB (IX+ENT_ANIMBASE)
6829+ C94B E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6830+ C94D 4F               LD C, A
6831+ C94E              .daDir:
6832+ C94E DD 35 09         DEC (IX+ENT_ANIMTIMER)
6833+ C951 20 16            JR NZ, .daFrameSet
6834+ C953 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6835+ C957 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6836+ C95A 47               LD B, A
6837+ C95B DD 96 08         SUB (IX+ENT_ANIMBASE)
6838+ C95E E6 01            AND 1
6839+ C960 20 03            JR NZ, .daFrameDec
6840+ C962 04               INC B
6841+ C963 18 01            JR .daFrameStore
6842+ C965              .daFrameDec:
6843+ C965 05               DEC B
6844+ C966              .daFrameStore:
6845+ C966 DD 70 00         LD (IX+ENT_SPRITEID), B
6846+ C969              .daFrameSet:
6847+ C969 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6848+ C96C DD 96 08         SUB (IX+ENT_ANIMBASE)
6849+ C96F E6 01            AND 1
6850+ C971 DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6851+ C974 81               ADD A, C
6852+ C975 DD 77 00         LD (IX+ENT_SPRITEID), A
6853+ C978 C9               RET
6854+ C979
6855+ C979              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6856+ C979              ; Si FindFarthestZoneCell no halla candidato, no spawnea (deja DeathSpawned=0
6857+ C979              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6858+ C979              ; timer >= DEATH_SPAWN_FRAMES).
6859+ C979              SpawnDeath:
6860+ C979                  ; Recomputar FlowField desde la posicion ACTUAL del player. Sin esto,
6861+ C979                  ; usariamos el FlowField de DrawScreen (player en pos de entrada): si
6862+ C979                  ; el player camino durante los 10s del timer, "la celda mas lejana"
6863+ C979                  ; es justo donde esta ahora (= opuesta a la entrada) y la muerte
6864+ C979                  ; spawneaba encima.
6865+ C979 CD DD 90         CALL MaiComputeFlowField
6866+ C97C                  ; Primary: celda reachable mas lejana con BFS dist >= DEATH_MIN_SPAWN_DIST
6867+ C97C CD 79 97         CALL FindFarthestZoneCell
6868+ C97F 20 04            JR NZ, .sdHaveCell
6869+ C981                  ; Fallback: cul-de-sac sin reachable a min-dist. Cualquier celda libre
6870+ C981                  ; lo mas lejana posible (Manhattan). Si es inalcanzable por walls, ghost
6871+ C981                  ; mode (15s) hara el resto.
6872+ C981 CD 34 98         CALL FindFarthestAnyFreeCell
6873+ C984 C8               RET Z                               ; sin candidato en absoluto: no spawn
6874+ C985              .sdHaveCell:
6875+ C985                  ; B = cx, C = cy
6876+ C985 DD 21 E6 81      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6877+ C989                  ; POSX = cx * 8
6878+ C989 78               LD A, B
6879+ C98A 87               ADD A, A
6880+ C98B 87               ADD A, A
6881+ C98C 87               ADD A, A
6882+ C98D DD 77 03         LD (IX+ENT_POSX), A
6883+ C990 DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
6884+ C993                  ; POSY = cy * 8 + SCREEN_MIN_Y
6885+ C993 79               LD A, C
6886+ C994 87               ADD A, A
6887+ C995 87               ADD A, A
6888+ C996 87               ADD A, A
6889+ C997 C6 10            ADD A, SCREEN_MIN_Y
6890+ C999 DD 77 04         LD (IX+ENT_POSY), A
6891+ C99C DD 77 0D         LD (IX+ENT_OLDY), A
6892+ C99F                  ; Tipo / estado / sprite
6893+ C99F DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
6894+ C9A3 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
6895+ C9A7 DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
6896+ C9AB DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
6897+ C9AF DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
6898+ C9B3 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6899+ C9B7 DD 36 06 00      LD (IX+ENT_DELTAX), 0
6900+ C9BB DD 36 07 00      LD (IX+ENT_DELTAY), 0
6901+ C9BF DD 36 0A 00      LD (IX+ENT_DIR), 0
6902+ C9C3                  ; Color: blanco brillante sobre negro (espectral)
6903+ C9C3 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
6904+ C9C7                  ; Flags: visible + newspawn (no destructible: la muerte es invulnerable)
6905+ C9C7 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
6906+ C9CB                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
6907+ C9CB AF               XOR A
6908+ C9CC 32 82 82         LD (DeathSubPixelAcc), A
6909+ C9CF 32 85 82         LD (DeathStuckCounter), A
6910+ C9D2 32 88 82         LD (DeathGhostMode), A
6911+ C9D5 21 00 00         LD HL, 0
6912+ C9D8 22 86 82         LD (DeathGhostStuckTimer), HL
6913+ C9DB                  ; Marcar como spawneada
6914+ C9DB 3E 01            LD A, 1
6915+ C9DD 32 81 82         LD (DeathSpawned), A
6916+ C9E0 C9               RET
