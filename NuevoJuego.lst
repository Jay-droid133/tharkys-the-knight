3591+ B646              ; ==============================================================================
3592+ B646              ; UpdateNastyFlee - Huida con colision, evasion del player y backtracking
3593+ B646              ; ==============================================================================
3594+ B646              ; IX = entidad nasty en STATE_SCARED.
3595+ B646              ; Persistencia: continua en la direccion actual si sigue pasable.
3596+ B646              ; Si bloqueado: recalcula con 4 candidatos (hacia bordes + opuestos).
3597+ B646              ; Prioridad: pasable+sin_player > pasable > no moverse.
3598+ B646              ; Si llega al borde, pone NastyFleeDespawn=1 para que ProcessOneEnemy lo borre.
3599+ B646              ; ==============================================================================
3600+ B646              UpdateNastyFlee:
3601+ B646                  ; --- Posicion del player ---
3602+ B646 3A 42 81         LD A, (EntityTable + ENT_POSX)
3603+ B649 32 C3 B8         LD (.flPX), A
3604+ B64C 3A 43 81         LD A, (EntityTable + ENT_POSY)
3605+ B64F 32 C4 B8         LD (.flPY), A
3606+ B652
3607+ B652                  ; --- Persistencia: intentar continuar en la direccion actual ---
3608+ B652 DD 56 06         LD D, (IX+ENT_DELTAX)
3609+ B655 DD 5E 07         LD E, (IX+ENT_DELTAY)
3610+ B658 7A               LD A, D
3611+ B659 B3               OR E
3612+ B65A 28 06            JR Z, .flRecalc                 ; Sin direccion → recalcular
3613+ B65C CD F3 B7         CALL .flTryPassable
3614+ B65F CA 7D B7         JP Z, .flApply                  ; Sigue pasable → continuar
3615+ B662
3616+ B662              .flRecalc:
3617+ B662                  ; --- Borde horizontal mas cercano ---
