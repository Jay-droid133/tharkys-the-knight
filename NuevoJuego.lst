 609+ E70F 29               ADD HL, HL
 610+ E710 29               ADD HL, HL                          ; HL = indice * 8
 611+ E711 01 5F E9         LD BC, DayHudFont
 612+ E714 09               ADD HL, BC
 613+ E715 C9               RET
