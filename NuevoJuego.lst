 211  7FCF
 212  7FCF                  ; ==========================================================================
 213  7FCF                  ; ORG $8000 - codigo principal (no-contended)
 214  7FCF                  ; ==========================================================================
 215  7FCF                  ORG ORIGIN_ADDRESS
 216  8000
 217  8000              ; ==============================================================================
 218  8000              ; MAIN LOOP - Fiel a Sabre Wulf (round-robin per-entity)
 219  8000              ; ==============================================================================
 220  8000              ; El original NO separa render de logica. Cada entidad hace todo junto:
 221  8000              ;   erase viejo → AI/movimiento → draw nuevo
 222  8000              ; Player: siempre se procesa completo cada frame (tras HALT).
 223  8000              ; Enemigos: round-robin, MAX_ENEMIES_PER_FRAME por frame. Los no procesados
 224  8000              ; no se mueven NI se redibujan → sin flicker por desfase render/logica.
 225  8000              ; ==============================================================================
 226  8000              MainLoop:
 227  8000                  ; --- Marcar inicio de frame (referencia para sync al final) ---
 228  8000 3A 78 5C         LD A, ($5C78)               ; SYS_FRAMES low byte (50Hz, ISR IM1)
 229  8003 47               LD B, A                     ; B = tick actual
 230  8004
 231  8004                  ; --- Catchup wall-clock: cuantos game frames (25fps) han pasado desde el
 232  8004                  ; iter anterior? `.frameStart` aun tiene el tick del iter previo. Si una
 233  8004                  ; transicion de pantalla tardo 4 ticks (= 2 frames), avanzamos 2 frames
 234  8004                  ; en MusicTimer/BellDecayTimer en vez de 1, preservando ritmo.
 235  8004 78               LD A, B
 236  8005 21 9A 81         LD HL, .frameStart
 237  8008 96               SUB (HL)                    ; A = elapsed = now - last (8-bit wrap OK)
 238  8009 70               LD (HL), B                  ; .frameStart = now (para frameSync de este iter)
 239  800A 21 E5 99         LD HL, TickRemainder
 240  800D 86               ADD A, (HL)                 ; A = elapsed + remainder pendiente
 241  800E 4F               LD C, A
 242  800F E6 01            AND $01
 243  8011 77               LD (HL), A                  ; new remainder = total mod 2
 244  8012 CB 39            SRL C                       ; C = total / 2 = game frames
 245  8014 79               LD A, C
 246  8015 32 E4 99         LD (FramesElapsed), A
 247  8018
 248  8018                  ; === DEATH BORDER FLASH + ANIM PLAYER: tick por frame, incluso en GameOver ===
 249  8018 CD 92 CB         CALL UpdateDeathBorder
 250  801B CD 63 CB         CALL UpdateDeathAnim
 251  801E                  ; Music tick: ahora vive en MusicIrqHandler (slot 1, cada 2 IRQs = 25 Hz).
 252  801E                  ; Auditoria de concurrencia AY confirmada: todos los AY writes desde
 253  801E                  ; MainLoop estan envueltos en DI/EI (ay_sound_thunks + sfx_player_hit_ay).
 254  801E                  ; UpdateMusicImpl sigue vivo como catchup-fallback no llamado por defecto.
 255  801E
 256  801E                  ; === GAME OVER: pantalla estatica, no gameplay ni HUD ===
 257  801E 3A E2 82         LD A, (GameOver)
 258  8021 B7               OR A
 259  8022 28 23            JR Z, .notGameOver
 260  8024 FE 02            CP 2
 261  8026 30 0B            JR NC, .gameOverWaitInput   ; ya pintado, esperar SPACE
 262  8028                  ; GameOver==1: pintar pantalla esta vez y bumpear a 2
 263  8028 CD ED CB         CALL PaintGameOverScreen
 264  802B 3E 02            LD A, 2
 265  802D 32 E2 82         LD (GameOver), A
 266  8030 C3 8A 81         JP .frameSync
 267  8033              .gameOverWaitInput:
 268  8033 CD 29 CC         CALL UpdateGameOverAnim     ; Death moonwalkea por la pantalla negra
 269  8036 01 FE 7F         LD BC, $7FFE                ; fila SPACE-SS-M-N-B
