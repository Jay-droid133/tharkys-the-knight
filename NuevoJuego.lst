 539+ E52E              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E52E              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E52E              ; ==============================================================================
 542+ E52E              DrawDayCycleHUD:
 543+ E52E                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E52E 21 EC E7         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E531 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E534 CD A3 E5         CALL .drawChar
 547+ E537 21 F4 E7         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E53A 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E53D CD A3 E5         CALL .drawChar
 550+ E540 21 FC E7         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E543 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E546 CD A3 E5         CALL .drawChar
 553+ E549                  ; Col 7 = espacio (limpiar)
 554+ E549 11 07 40         LD DE, $4007
 555+ E54C CD AC E5         CALL .clearChar
