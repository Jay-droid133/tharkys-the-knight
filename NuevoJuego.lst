 238+ 6AEC 28 18            JR Z, .lbsLoadDone              ; sin attrs
 239+ 6AEE 47               LD B, A
 240+ 6AEF              .lbsAttrRow:
 241+ 6AEF 3A 1D 6B         LD A, (.lbsWsave)
 242+ 6AF2 B7               OR A
 243+ 6AF3 28 08            JR Z, .lbsAttrRowDone
 244+ 6AF5 4F               LD C, A
 245+ 6AF6              .lbsAttrCol:
 246+ 6AF6 7E               LD A, (HL)
