 285+ E702              ; ---- Phase WALK_TO_ANCHOR: player camina autonomo en 2 fases ----
 286+ E702              ; Fase 1: movimiento vertical hasta alinear Y con TGCS_WALK_TARGET_Y
 287+ E702              ;         (sprite WALK_N o WALK_S segun direccion).
 288+ E702              ; Fase 2: movimiento horizontal hasta alinear X con TGCS_WALK_TARGET_X
 289+ E702              ;         (sprite WALK_E o WALK_W segun direccion).
 290+ E702              ; Al llegar (ambos ejes alineados): pose static WALK_N+1 + transicion a LOCK.
 291+ E702              ; Toggle frame anim 0/1 cada TGCS_WALK_ANIM_PERIOD frames.
 292+ E702              .tgPhWalkToAnchor:
 293+ E702 DD 21 A3 81      LD IX, EntityTable
 294+ E706                  ; --- Fase 1: Y ---
 295+ E706 DD 7E 04         LD A, (IX+ENT_POSY)
 296+ E709 FE 50            CP TGCS_WALK_TARGET_Y
 297+ E70B 28 1C            JR Z, .tgwtaTryX                    ; Y aligned, pasar a fase 2
 298+ E70D 38 0D            JR C, .tgwtaMoveS                   ; cur_Y < target → S (Y++)
 299+ E70F                  ; cur_Y > target → N (Y--)
 300+ E70F DD 35 04         DEC (IX+ENT_POSY)
 301+ E712 DD 7E 04         LD A, (IX+ENT_POSY)
 302+ E715 32 E4 82         LD (PlayerDrawY), A
 303+ E718 06 0A            LD B, SPRID_WALK_N
 304+ E71A 18 2F            JR .tgwtaApplyAnim
 305+ E71C              .tgwtaMoveS:
