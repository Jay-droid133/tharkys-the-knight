7397+ C83D 2A 6D 5F         LD HL, (DBfsQTail)
7398+ C840 3A 78 5F         LD A, (DBfsTryCx)
7399+ C843 77               LD (HL), A
7400+ C844 23               INC HL
7401+ C845 3A 79 5F         LD A, (DBfsTryCy)
7402+ C848 77               LD (HL), A
7403+ C849 23               INC HL
7404+ C84A 78               LD A, B
7405+ C84B 77               LD (HL), A
7406+ C84C 23               INC HL
7407+ C84D 3A 77 5F         LD A, (DBfsCurDepth)
7408+ C850 3C               INC A
7409+ C851 77               LD (HL), A
