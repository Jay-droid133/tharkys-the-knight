1243+ AFC9              ; ==============================================================================
1244+ AFC9              ; Llamar DESPUES de que el player haya sido borrado (XOR erase) y ANTES de
1245+ AFC9              ; que se dibuje de nuevo en su nueva posicion.
1246+ AFC9              ; ==============================================================================
1247+ AFC9              ; ==============================================================================
1248+ AFC9              ; DrawBgSpriteXOR - Dibuja un BG sprite con XOR (para pickups)
1249+ AFC9              ; ==============================================================================
1250+ AFC9              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
1251+ AFC9              ; Solo dibuja pixeles con XOR (sin atributos).
1252+ AFC9              ; Llamar dos veces en la misma posicion = borrado limpio.
1253+ AFC9              ; ==============================================================================
1254+ AFC9              DrawBgSpriteXOR:
1255+ AFC9 DD 7E 00         LD A, (IX+0)                ; height_px
1256+ AFCC B7               OR A
1257+ AFCD C8               RET Z
1258+ AFCE 32 0A B0         LD (.xhCnt), A
1259+ AFD1 DD 7E 01         LD A, (IX+1)                ; width_bytes
1260+ AFD4 32 0B B0         LD (.xwVal), A
