# file opened: code/bank_cutscene.asm
   1+ F826              ; ==============================================================================
   2+ F826              ; bank_cutscene.asm - Cutscene del banco (M9 propuesto)
   3+ F826              ; ==============================================================================
   4+ F826              ; ESTADO: DRAFT — este archivo NO esta INCLUDE'd en main.asm. Cero impacto
   5+ F826              ; en el binario hasta wire-up.
   6+ F826              ;
   7+ F826              ; Placement decidido (verificado con tools/memory_map.py): **bank 0**
   8+ F826              ; (slot 3 default). Razones:
   9+ F826              ;   - Slot 1 (bank 5) tiene 294 B libres — no cabe.
  10+ F826              ;   - Bank 2 (slot 2) tiene 2 B libres — full.
  11+ F826              ;   - Bank 0 tiene 1404 B libres → margen ~150-400 B tras meter el cuerpo.
  12+ F826              ;   - Todos los helpers que llama el cutscene son: bank 0 (no cross-bank),
  13+ F826              ;     slot 1 always-vis, o slot 2 always-vis → CERO thunks necesarios.
  14+ F826              ;
  15+ F826              ; INCLUDE va entre sound.asm y PAGE 1 en main.asm (zona bank 0 default).
  16+ F826              ;
  17+ F826              ; Diseno doc: docs/bank_cutscene.md.
  18+ F826              ;
  19+ F826              ; Disparada al chocar contra la puerta del banco (sprite Bank id 39, en
  20+ F826              ; sala (8,8)) llevando el cheque (BankCheck id 44, key id 7).
  21+ F826              ;
  22+ F826              ; Phase machine indexada por BankCutscenePhase. Cuando != 0, MainLoop salta
  23+ F826              ; el bloque normal de gameplay y llama UpdateBankCutscene cada frame.
  24+ F826              ;
  25+ F826              ; Esquema de fases:
  26+ F826              ;   0  IDLE              no en cutscene
  27+ F826              ;   1  LOCK              snap player a anchor, facing N, pausa breve
  28+ F826              ;   2  KNOCKS_1          3 toques (sub-state HIT/GAP)
  29+ F826              ;   3  WAIT_1            espera silenciosa tras grupo 1
  30+ F826              ;   4  KNOCKS_2          3 toques mas
  31+ F826              ;   5  WAIT_2            espera tras grupo 2
  32+ F826              ;   6  TURN_TO_CAM       player gira a S (cara camara)
  33+ F826              ;   7  TURN_TO_DOOR      player vuelve a N
  34+ F826              ;   8  KNOCKS_3          6 toques
  35+ F826              ;   9  WAIT_3            pausa antes de aparecer la mano
  36+ F826              ;  10  PRE_HAND          hold corto; la puerta NO se abre (mano sale por la
  37+ F826              ;                        rendija de la puerta cerrada)
  38+ F826              ;  11  HAND_IN           aparece mano (frame 0) sobre la puerta cerrada
  39+ F826              ;  12  HAND_NO_NO        anim swaps frame 0/1, BCS_NO_SWAPS_TOTAL veces
  40+ F826              ;  13  HAND_OUT          erase mano
  41+ F826              ;  14  KEY_DROP          BankKeySpawned=1 + RedrawPickupByPtr
  42+ F826              ;  15  PLAYER_TURN_CAM   player mira a camara un instante
  43+ F826              ;  16  DONE              sentinel; setear phase=IDLE devuelve control
  44+ F826              ;  17  WAIT_NASTIES      pre-LOCK: nasties + death animan puff antes de LOCK
  45+ F826              ;                        (mismo patron que TGP_WAIT_NASTIES de town_gate;
  46+ F826              ;                        MainLoop ramifica especial para mantener
  47+ F826              ;                        ProcessEnemies + ProcessDeath corriendo).
  48+ F826              ;
  49+ F826              ; NOTA visual: la mano se dibuja con XOR sobre la puerta cerrada del banco.
  50+ F826              ; Hereda los attrs de la facade (no pinta los suyos), asi que XOR self-cancel
  51+ F826              ; en HAND_OUT deja la facade intacta. Por eso el draft inline +
  52+ F826              ; DrawBgSprite16XorAtPixel es el match exacto: cero gestion de attrs.
  53+ F826              ;
  54+ F826              ; Patron de placement: bank 0 (slot 3 default). Helpers en bank 0 (mismo
  55+ F826              ; bank, sin thunks), slot 1 (always-vis), slot 2 (always-vis). Las CALLs a
  56+ F826              ; LoadBgSpriteToBuffer (slot 1) restauran bank 0 al volver via su patron
  57+ F826              ; estandar — el body en bank 0 reaparece tras el RET sin problemas.
  58+ F826              ; ==============================================================================
  59+ F826
  60+ F826              ; ==============================================================================
  61+ F826              ; Phase enum
  62+ F826              ; ==============================================================================
  63+ F826              BCP_IDLE                EQU 0
