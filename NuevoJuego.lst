 188  90A3                  INCLUDE "paging.asm"
# file opened: paging.asm
   1+ 90A3              ; ==============================================================================
   2+ 90A3              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 90A3              ; ==============================================================================
   4+ 90A3              ; Port $7FFD (write-only):
   5+ 90A3              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 90A3              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 90A3              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 90A3              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 90A3              ;
  10+ 90A3              ; Bancos disponibles:
  11+ 90A3              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 90A3              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 90A3              ;   Bank 1: libre para datos nuevos (contended)
  14+ 90A3              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 90A3              ;   Bank 3: libre para datos nuevos (contended)
  16+ 90A3              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 90A3              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 90A3              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 90A3              ;   Bank 7: bg_gfx_c.asm (variantes forest). Antes reservado para shadow
  20+ 90A3              ;           screen — se renuncio porque el juego no usa double-buffering.
  21+ 90A3              ; ==============================================================================
  22+ 90A3
  23+ 90A3              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  24+ 90A3              ; para no machacarse a si mismas al cambiar de banco.
  25+ 90A3
  26+ 90A3              ; ==============================================================================
  27+ 90A3              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  28+ 90A3              ; ==============================================================================
  29+ 90A3              ; Entrada: A = banco (0-7)
  30+ 90A3              ; Preserva: HL, DE, IX, IY
  31+ 90A3              ; Destruye: A, BC
  32+ 90A3              ; ==============================================================================
  33+ 90A3              PageBankSlot3:
  34+ 90A3 E6 07            AND $07                     ; asegurar solo bits 0-2
  35+ 90A5 47               LD B, A                     ; guardar banco nuevo
  36+ 90A6 3A 8F 90         LD A, (CurrentPaging)
  37+ 90A9 E6 F8            AND $F8                     ; limpiar bits de banco
  38+ 90AB B0               OR B                        ; poner nuevo banco
  39+ 90AC 32 8F 90         LD (CurrentPaging), A
  40+ 90AF 01 FD 7F         LD BC, $7FFD
  41+ 90B2 ED 79            OUT (C), A
  42+ 90B4 C9               RET
  43+ 90B5
  44+ 90B5              ; ==============================================================================
  45+ 90B5              ; InitPaging - Estado inicial de paginacion al arrancar
  46+ 90B5              ; ==============================================================================
  47+ 90B5              ; Llamar en el startup antes de cualquier acceso paginado.
  48+ 90B5              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  49+ 90B5              ; ==============================================================================
  50+ 90B5              InitPaging:
  51+ 90B5 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  52+ 90B7 32 8F 90         LD (CurrentPaging), A
  53+ 90BA 01 FD 7F         LD BC, $7FFD
  54+ 90BD ED 79            OUT (C), A
  55+ 90BF C9               RET
  56+ 90C0
  57+ 90C0              ; ==============================================================================
  58+ 90C0              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  59+ 90C0              ; ==============================================================================
  60+ 90C0              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  61+ 90C0              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $FF).
  62+ 90C0              ;      Paginacion restaurada a bank 0.
  63+ 90C0              ; Destruye: A, BC, DE, HL
  64+ 90C0              ;
  65+ 90C0              ; Formato del room en FUENTE (variable-length):
  66+ 90C0              ;   sin tint (98% de casos, 3B): DEFB id, x, y
  67+ 90C0              ;   con tint (4B):               DEFB id, x|$80, y, v
  68+ 90C0              ;   terminador:                  DEFB $FF
  69+ 90C0              ; x nativo va 0-31 (5 bits); bit 7 libre para el flag "hay v siguiente".
  70+ 90C0              ;
  71+ 90C0              ; Formato en CurrentScreenBuffer tras esta rutina (FIJO 4B):
  72+ 90C0              ;   DEFB id, x (limpio 0-31), y, v  (v=$FF si no habia tint)
  73+ 90C0              ; Asi los 3 iteradores de runtime (DrawScreen, RemapScreenAttrs,
  74+ 90C0              ; CollisionMap) siguen leyendo 4B fijos sin cambios.
  75+ 90C0              ; ==============================================================================
  76+ 90C0              LoadRoomToBuffer:
  77+ 90C0                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  78+ 90C0                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  79+ 90C0                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  80+ 90C0                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  81+ 90C0                  ;
  82+ 90C0                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  83+ 90C0                  ; ni interrupciones (DI). Solo LDs al buffer.
  84+ 90C0                  ; IFF tracking: usamos StartupComplete (RAM) en vez de LD A,I/P-V para
  85+ 90C0                  ; evitar el race del Z80 (IRQ durante LD A,I -> P/V mal -> EI saltado).
  86+ 90C0 F3               DI
  87+ 90C1                  ; --- Page bank 1 en slot 3 (inline) ---
  88+ 90C1 3A 8F 90         LD A, (CurrentPaging)
  89+ 90C4 E6 F8            AND $F8
  90+ 90C6 F6 01            OR 1
  91+ 90C8 32 8F 90         LD (CurrentPaging), A
  92+ 90CB 01 FD 7F         LD BC, $7FFD
  93+ 90CE ED 79            OUT (C), A                      ; slot 3 = bank 1
  94+ 90D0                  ; --- Copy + decompress loop ---
  95+ 90D0                  ; HL = source (Room_Txx en bank 1, formato variable)
  96+ 90D0                  ; DE = dest (CurrentScreenBuffer, formato fijo 4B)
  97+ 90D0 11 42 85         LD DE, CurrentScreenBuffer
  98+ 90D3              .lrbLoop:
  99+ 90D3 7E               LD A, (HL)                      ; id
 100+ 90D4 12               LD (DE), A
 101+ 90D5 23               INC HL
 102+ 90D6 13               INC DE
 103+ 90D7 FE FF            CP $FF                          ; terminador?
 104+ 90D9 28 1B            JR Z, .lrbDone
 105+ 90DB                  ; Leer x (puede tener bit 7 = flag tint). B guarda el raw para test,
 106+ 90DB                  ; al buffer escribimos x limpio (AND $7F).
 107+ 90DB 7E               LD A, (HL)
 108+ 90DC 23               INC HL
 109+ 90DD 47               LD B, A                         ; B = x raw (con flag)
 110+ 90DE E6 7F            AND $7F
 111+ 90E0 12               LD (DE), A                      ; buffer: x limpio 0-31
 112+ 90E1 13               INC DE
 113+ 90E2                  ; Copiar y
 114+ 90E2 7E               LD A, (HL)
 115+ 90E3 12               LD (DE), A
 116+ 90E4 23               INC HL
 117+ 90E5 13               INC DE
 118+ 90E6                  ; v: si bit 7 de x estaba set, leer v de source; si no, escribir $FF.
 119+ 90E6 CB 78            BIT 7, B
 120+ 90E8 28 06            JR Z, .lrbNoTint
 121+ 90EA 7E               LD A, (HL)                      ; v desde source
 122+ 90EB 23               INC HL
 123+ 90EC 12               LD (DE), A
 124+ 90ED 13               INC DE
 125+ 90EE 18 E3            JR .lrbLoop
 126+ 90F0              .lrbNoTint:
 127+ 90F0 3E FF            LD A, $FF                       ; sin tint: buffer escribe $FF
 128+ 90F2 12               LD (DE), A
 129+ 90F3 13               INC DE
 130+ 90F4 18 DD            JR .lrbLoop
 131+ 90F6              .lrbDone:
 132+ 90F6                  ; --- Page bank 0 en slot 3 (inline) ---
 133+ 90F6 3A 8F 90         LD A, (CurrentPaging)
 134+ 90F9 E6 F8            AND $F8                         ; bank 0
 135+ 90FB 32 8F 90         LD (CurrentPaging), A
 136+ 90FE 01 FD 7F         LD BC, $7FFD
 137+ 9101 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 138+ 9103                  ; Restaurar interrupciones si Inicio ya termino
 139+ 9103 3A 13 81         LD A, (StartupComplete)
