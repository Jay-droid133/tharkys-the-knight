 147+ F188              ; Ruido percusivo seguido de tono descendente
 148+ F188              SFX_EnemyDeath:
 149+ F188 32 0A 00 01      DEFB 50, 10, 0, 1          ; rafaga de ruido (percusion)
 150+ F18C 1E 0F 02 00      DEFB 30, 15, 2, 0          ; tono descendente (explosion)
 151+ F190 14 08 00 01      DEFB 20, 8, 0, 1           ; cola de ruido
 152+ F194 00               DEFB 0                      ; fin
