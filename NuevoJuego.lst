  94+ 6E7E              ; GetRoulettePtrByIdx - dado RouletteIdx, devuelve HL = ptr al sprite actual
  95+ 6E7E              ; ==============================================================================
  96+ 6E7E              ; IN:  A = RouletteIdx (0..ROULETTE_ORDER_LEN-1)
  97+ 6E7E              ; OUT: HL = BgGfx ptr al sprite del tipo activo
  98+ 6E7E              ; ==============================================================================
  99+ 6E7E              GetRoulettePtrByIdx:
 100+ 6E7E 21 67 6E         LD HL, RouletteOrder
 101+ 6E81 5F               LD E, A
 102+ 6E82 16 00            LD D, 0
 103+ 6E84 19               ADD HL, DE
 104+ 6E85 7E               LD A, (HL)                              ; A = type id (1..5)
 105+ 6E86 3D               DEC A                                   ; idx 0-based para tabla ptrs
 106+ 6E87 26 00            LD H, 0
 107+ 6E89 6F               LD L, A
 108+ 6E8A 29               ADD HL, HL                              ; idx*2 (entries de 2 bytes)
 109+ 6E8B 11 70 6E         LD DE, RouletteTypePtrs
 110+ 6E8E 19               ADD HL, DE
 111+ 6E8F 5E               LD E, (HL)
 112+ 6E90 23               INC HL
 113+ 6E91 56               LD D, (HL)
 114+ 6E92 EB               EX DE, HL                               ; HL = ptr
 115+ 6E93 C9               RET
