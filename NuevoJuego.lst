 180+ EC8F              ; ==============================================================================
 181+ EC8F              ; SetClockToPhaseHour
 182+ EC8F              ; ==============================================================================
 183+ EC8F              SetClockToPhaseHour:
 184+ EC8F 21 AE EA         LD HL, PhaseStartHour
 185+ EC92 4F               LD C, A
 186+ EC93 06 00            LD B, 0
 187+ EC95 09               ADD HL, BC
 188+ EC96 7E               LD A, (HL)
 189+ EC97 32 AB EA         LD (GameHours), A
 190+ EC9A AF               XOR A
 191+ EC9B 32 AA EA         LD (GameMinutes), A
 192+ EC9E 32 A9 EA         LD (GameSubMinute), A
 193+ ECA1 C9               RET
 194+ ECA2
 195+ ECA2              ; ==============================================================================
 196+ ECA2              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ ECA2              ; ==============================================================================
 198+ ECA2              DrawClockHUD:
 199+ ECA2                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ ECA2                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ ECA2                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ ECA2                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ ECA2                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ ECA2                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ ECA2 3A BB 82         LD A, (TimeFrozen)
 206+ ECA5 FE 01            CP 1
 207+ ECA7 20 07            JR NZ, .clkDrawNormal
 208+ ECA9 3A A0 81         LD A, (GameFrameCounter)
 209+ ECAC E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ ECAE 28 2D            JR Z, .clkBlinkOff
 211+ ECB0              .clkDrawNormal:
 212+ ECB0 CD EB EC         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ ECB3
 214+ ECB3                  ; --- Aguja de horas ---
 215+ ECB3 3A AB EA         LD A, (GameHours)
 216+ ECB6 FE 0C            CP 12
 217+ ECB8 38 02            JR C, .hourOk
 218+ ECBA D6 0C            SUB 12
 219+ ECBC              .hourOk:
 220+ ECBC 21 A7 EB         LD HL, HourHandPtrs
 221+ ECBF CD C1 EE         CALL DrawHandLine
