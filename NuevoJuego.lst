3029+ AFCB                  ; Monster empujado fuera: memoria de ubicacion + timer de regreso.
3030+ AFCB                  ;
3031+ AFCB                  ; Doble comportamiento:
3032+ AFCB                  ; - Si el player PERMANECE en este room: al expirar el timer, el monster
3033+ AFCB                  ;   vuelve por el mismo borde (Regla 4 clasica, via .rmUpdateReturnTimers).
3034+ AFCB                  ; - Si el player CRUZA al room destino antes del timer: el monster ya
3035+ AFCB                  ;   esta alli (RepositionMonstersAtEntry .reInNew path cancela el timer
3036+ AFCB                  ;   y lo activa).
3037+ AFCB                  ; - Si el player cruza a OTRO room distinto: .reSkip cancela el timer.
3038+ AFCB                  ;   El monster queda en destino (memoria) hasta que el player visite.
3039+ AFCB                  ;
3040+ AFCB                  ; Registros: ENT_DIR = exit DIR, MonsterRoomId = destino, MonsterEntryBorder
3041+ AFCB                  ; = MAI_SIDE opuesto, MonsterReturnTimer[slot] = LINGER, despawn = 1.
3042+ AFCB DD 77 0A         LD (IX+ENT_DIR), A                  ; A = DIR_N/S/E/W
3043+ AFCE 32 0F B0         LD (.moKbSavedDir), A
3044+ AFD1 3E 01            LD A, 1
3045+ AFD3 32 5A B3         LD (MonsterKbDespawn), A
3046+ AFD6                  ; Calcular slot (0-2) en E, D=0
3047+ AFD6 DD E5            PUSH IX
3048+ AFD8 E1               POP HL
3049+ AFD9 11 AE 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
3050+ AFDC B7               OR A
3051+ AFDD ED 52            SBC HL, DE
3052+ AFDF CB 3D            SRL L
3053+ AFE1 CB 3D            SRL L
3054+ AFE3 CB 3D            SRL L
3055+ AFE5 CB 3D            SRL L
3056+ AFE7 5D               LD E, L
3057+ AFE8 16 00            LD D, 0
3058+ AFEA                  ; Clear MAI_FLAG_LEAVING
3059+ AFEA 21 96 8D         LD HL, MonsterAiFlags
3060+ AFED 19               ADD HL, DE
3061+ AFEE 7E               LD A, (HL)
3062+ AFEF E6 FD            AND ~MAI_FLAG_LEAVING & $FF
3063+ AFF1 77               LD (HL), A
3064+ AFF2                  ; MonsterRoomId[slot] = neighbor_id (destino)
3065+ AFF2 3A 0F B0         LD A, (.moKbSavedDir)
3066+ AFF5 CD BE 8E         CALL MaiGetNeighborScreenId
3067+ AFF8 21 8A 8D         LD HL, MonsterRoomId
3068+ AFFB 19               ADD HL, DE
3069+ AFFC 77               LD (HL), A
3070+ AFFD                  ; MonsterEntryBorder[slot] = MAI_SIDE opuesto
3071+ AFFD 3A 0F B0         LD A, (.moKbSavedDir)
3072+ B000 CD 1D 8F         CALL MaiDirToEntrySide
3073+ B003 21 90 8D         LD HL, MonsterEntryBorder
3074+ B006 19               ADD HL, DE
3075+ B007 77               LD (HL), A
3076+ B008                  ; MonsterReturnTimer[slot] = LINGER_PUSHED (para regreso si player se queda)
3077+ B008 21 5C B3         LD HL, MonsterReturnTimer
3078+ B00B 19               ADD HL, DE
3079+ B00C 36 19            LD (HL), MAI_LINGER_PUSHED
3080+ B00E C9               RET
