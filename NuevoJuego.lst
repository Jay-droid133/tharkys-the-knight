 967+ 9206              ; MaiGetEntrySide
 968+ 9206              ; ==============================================================================
 969+ 9206              ; Traduce ScreenTransition (direccion en la que se movio el player al cruzar
 970+ 9206              ; el borde) al side de ENTRADA en el nuevo room (el borde opuesto).
 971+ 9206              ;
 972+ 9206              ;   DIR_N (player fue al norte) → SIDE_S (entro por el sur del nuevo room)
 973+ 9206              ;   DIR_S → SIDE_N
 974+ 9206              ;   DIR_E → SIDE_W
 975+ 9206              ;   DIR_W → SIDE_E
 976+ 9206              ;
 977+ 9206              ; OUT: A = MAI_SIDE_N/S/W/E o $FF si no hay transicion activa.
 978+ 9206              ; ==============================================================================
 979+ 9206              MaiGetEntrySide:
 980+ 9206 3A 0C 83         LD A, (ScreenTransition)
 981+ 9209 FE 01            CP DIR_N
 982+ 920B 28 12            JR Z, .mesSideS
 983+ 920D FE 02            CP DIR_S
 984+ 920F 28 0B            JR Z, .mesSideN
