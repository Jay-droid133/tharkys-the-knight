# file opened: code/sound.asm
   1+ F642              ; ==============================================================================
   2+ F642              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F642              ; ==============================================================================
   4+ F642              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F642              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F642              ;
   7+ F642              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F642              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F642              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F642              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F642              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F642              ; ==============================================================================
  13+ F642
  14+ F642              ; ==============================================================================
  15+ F642              ; PlaySFX - Reproduce un efecto de sonido
  16+ F642              ; ==============================================================================
  17+ F642              ; Entrada: HL = puntero a datos del efecto
  18+ F642              ; Modifica: AF, BC, DE, HL
  19+ F642              ; ==============================================================================
  20+ F642              PlaySFX:
  21+ F642 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F643 3A 86 8D         LD A, (CurrentBorderColor)
  23+ F646 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F648 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F649
  26+ F649              .nextStep:
  27+ F649 7E               LD A, (HL)                  ; Leer duration
  28+ F64A B7               OR A
  29+ F64B 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F64D
  31+ F64D 47               LD B, A                     ; B = duration (bucle externo)
  32+ F64E 23               INC HL
  33+ F64F 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F650 23               INC HL
  35+ F651 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F652 23               INC HL
  37+ F653 7E               LD A, (HL)                  ; A = flags
  38+ F654 23               INC HL
  39+ F655 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F656 CB 47            BIT 0, A
  41+ F658 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F65A
  43+ F65A              ; --- Bucle de tono normal ---
  44+ F65A              .toneLoop:
  45+ F65A                  ; Semi-periodo HIGH
  46+ F65A 7B               LD A, E
  47+ F65B F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F65D D3 FE            OUT ($FE), A
  49+ F65F 79               LD A, C                     ; A = pitch actual
  50+ F660              .toneDelayHi:
  51+ F660 3D               DEC A
  52+ F661 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F663
  54+ F663                  ; Semi-periodo LOW
  55+ F663 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F664 D3 FE            OUT ($FE), A
  57+ F666 79               LD A, C
  58+ F667              .toneDelayLo:
  59+ F667 3D               DEC A
  60+ F668 20 FD            JR NZ, .toneDelayLo
  61+ F66A
  62+ F66A                  ; Aplicar pitch sweep
  63+ F66A 79               LD A, C
  64+ F66B 82               ADD A, D                    ; pitch += pitchDelta
  65+ F66C 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F66E FA 76 F6         JP M, .toneClamp            ; evitar pitch negativo
  67+ F671 4F               LD C, A
  68+ F672              .toneAfterClamp:
  69+ F672 10 E6            DJNZ .toneLoop
  70+ F674 18 30            JR .stepDone
  71+ F676
  72+ F676              .toneClamp:
  73+ F676 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F678 18 F8            JR .toneAfterClamp
  75+ F67A
  76+ F67A              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F67A              .noiseLoop:
  78+ F67A                  ; Semi-periodo HIGH con ruido
  79+ F67A 7B               LD A, E
  80+ F67B F6 10            OR $10
  81+ F67D D3 FE            OUT ($FE), A
  82+ F67F ED 5F            LD A, R                     ; R register como PRNG
  83+ F681 A9               XOR C                       ; mezclar con pitch base
  84+ F682 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F684 F6 01            OR $01                      ; minimo 1
  86+ F686              .noiseDelayHi:
  87+ F686 3D               DEC A
  88+ F687 20 FD            JR NZ, .noiseDelayHi
  89+ F689
  90+ F689                  ; Semi-periodo LOW
  91+ F689 7B               LD A, E
  92+ F68A D3 FE            OUT ($FE), A
  93+ F68C ED 5F            LD A, R
  94+ F68E A9               XOR C
  95+ F68F E6 1F            AND $1F
  96+ F691 F6 01            OR $01
  97+ F693              .noiseDelayLo:
  98+ F693 3D               DEC A
  99+ F694 20 FD            JR NZ, .noiseDelayLo
 100+ F696
 101+ F696                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F696 79               LD A, C
 103+ F697 82               ADD A, D
 104+ F698 28 08            JR Z, .noiseClamp
 105+ F69A FA A2 F6         JP M, .noiseClamp
 106+ F69D 4F               LD C, A
 107+ F69E              .noiseAfterClamp:
 108+ F69E 10 DA            DJNZ .noiseLoop
 109+ F6A0 18 04            JR .stepDone
 110+ F6A2
 111+ F6A2              .noiseClamp:
 112+ F6A2 0E 01            LD C, 1
 113+ F6A4 18 F8            JR .noiseAfterClamp
 114+ F6A6
 115+ F6A6              .stepDone:
 116+ F6A6 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F6A7 18 A0            JR .nextStep
 118+ F6A9
 119+ F6A9              .done:
 120+ F6A9 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F6AA D3 FE            OUT ($FE), A
 122+ F6AC FB               EI
 123+ F6AD C9               RET
