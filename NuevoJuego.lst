5710+ BF64 CB 4A            BIT 1, D                        ; DIR_S
5711+ BF66 28 02            JR Z, .kbNoDown
5712+ BF68 3E 04            LD A, MONSTER_KB_SPEED
5713+ BF6A              .kbNoDown:
5714+ BF6A CB 42            BIT 0, D                        ; DIR_N
5715+ BF6C 28 14            JR Z, .kbSetY
5716+ BF6E 3E FC            LD A, -MONSTER_KB_SPEED
