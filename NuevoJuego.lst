 188+ FD38              ; smDrawConnectedBorder - sprite 8x8 borde azul oscuro con lados abiertos
 189+ FD38              ; Input: B=col (0..15), C=row (0..15)
 190+ FD38              ; Flags de conexion desde MinimapConnTable[C*16+B]:
 191+ FD38              ;   bit3=N  bit2=S  bit1=W  bit0=E  (1=abierto)
 192+ FD38              ; Destruye A, D, E. PUSH/POP BC, DE, HL.
 193+ FD38              ; ------------------------------------------------------------------------------
 194+ FD38              smDrawConnectedBorder:
 195+ FD38 E5               PUSH HL
 196+ FD39 C5               PUSH BC
