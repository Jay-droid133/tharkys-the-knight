 261+ 9134              .lbsLoadDone:
 262+ 9134                  ; Page bank 0 inline
 263+ 9134 3A 42 90         LD A, (CurrentPaging)
 264+ 9137 E6 F8            AND $F8
 265+ 9139 32 42 90         LD (CurrentPaging), A
 266+ 913C 01 FD 7F         LD BC, $7FFD
 267+ 913F ED 79            OUT (C), A
 268+ 9141                  ; Restaurar interrupciones si Inicio ya termino
 269+ 9141 3A C6 80         LD A, (StartupComplete)
 270+ 9144 B7               OR A
 271+ 9145 28 01            JR Z, .lbsbNoEI                 ; aun en Inicio -> dejar DI
 272+ 9147 FB               EI
 273+ 9148              .lbsbNoEI:
 274+ 9148 C1               POP BC                          ; restaurar BC del caller
 275+ 9149 C9               RET
 276+ 914A
 277+ 914A 00           .lbsHsave:    DEFB 0
 278+ 914B 00           .lbsWsave:    DEFB 0
 279+ 914C 00           .lbsBankSave: DEFB 0
