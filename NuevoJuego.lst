  90  AE20                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ AE20              ; ==============================================================================
   2+ AE20              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ AE20              ; ==============================================================================
   4+ AE20              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ AE20              ; Para cada shift S:
   6+ AE20              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ AE20              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ AE20              ;
   9+ AE20              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ AE20              ;
  11+ AE20              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ AE20              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ AE20              ;
  14+ AE20              ; Calculo de B desde X%8:
  15+ AE20              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / OR SHIFT_TABLE_BASE
  16+ AE20              ; ==============================================================================
  17+ AE20
  18+ AE20 00 00 00...      ALIGN 4096
  19+ B000              ShiftTables:
  20+ B000                  LUA ALLPASS
  21+ B000 ~                for shift = 1, 7 do
  22+ B000 ~                    -- High part: byte >> shift
  23+ B000 ~                    for i = 0, 255 do
  24+ B000 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ B000 ~                    end
  26+ B000 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ B000 ~                    for i = 0, 255 do
  28+ B000 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ B000 ~                    end
  30+ B000 ~                end
